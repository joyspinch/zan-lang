                            : e.op == TK.LessEq() ? 0x0E
                            : e.op == TK.Greater() ? 0x0F : 0x0D;
                    X3(0x0F, 0x90 | xcc, 0xC0);          // setcc al
                    X3(0x0F, 0xB6, 0xF8);                // movzx edi, al
                } else {
                    E4(0x7100001F);                      // cmp w0, #0
                    if (e.op == TK.Less()) { CsetCondX0(11); }          // cset x0, lt
                    else if (e.op == TK.LessEq()) { CsetCondX0(13); }   // cset x0, le
                    else if (e.op == TK.Greater()) { E4(0x9A9FD7E0); }  // cset x0, gt
                    else { E4(0x9A9FB7E0); }                            // cset x0, ge
                }
            } else if (IsDblExpr(e.a) || IsDblExpr(e.b)) {
                // double arithmetic/comparison: values travel as i64 bit
                // patterns in x0; the op materialises d-regs, coercing int
                // operands with scvtf. Comparisons are the ordered ones (a
                // NaN input always answers false, true only for !=).
                if (tgt86 == 1) {
                    // SSE twin: a in xmm1, b in xmm0 (bit patterns ride
                    // rsi/rdi until movq materialises them). Ordered
                    // compares come from comisd + setcc with the parity
                    // bit folded in for eq/ne; NaN answers false except
                    // !=. fmod keeps the true FP ABI (xmm0/xmm1) and
                    // returns in xmm0, so its call bypasses the rax tail.
                    GenExpr(e.a);
                    XPushV0();
                    GenExpr(e.b);
                    XPopV(1);                      // rdi = b, rsi = a
                    if (IsDblExpr(e.b)) { X3(0x66, 0x48, 0x0F); X2(0x6E, 0xC7); }   // movq xmm0, rdi
                    else { X3(0xF2, 0x48, 0x0F); X2(0x2A, 0xC7); }                  // cvtsi2sd xmm0, rdi
                    if (IsDblExpr(e.a)) { X3(0x66, 0x48, 0x0F); X2(0x6E, 0xCE); }   // movq xmm1, rsi
                    else { X3(0xF2, 0x48, 0x0F); X2(0x2A, 0xCE); }                  // cvtsi2sd xmm1, rsi
                    int op = e.op;
                    if (op == TK.Plus()) {
                        X2(0xF2, 0x0F); X2(0x58, 0xC8);   // addsd xmm1, xmm0
                    } else if (op == TK.Minus()) {
                        X2(0xF2, 0x0F); X2(0x5C, 0xC8);   // subsd xmm1, xmm0
                    } else if (op == TK.Star()) {
                        X2(0xF2, 0x0F); X2(0x59, 0xC8);   // mulsd xmm1, xmm0
                    } else if (op == TK.Slash()) {
                        X2(0xF2, 0x0F); X2(0x5E, 0xC8);   // divsd xmm1, xmm0 (IEEE, no guard)
                    } else if (op == TK.Percent()) {
                        // C# `%` keeps the dividend's sign (C fmod). SysV:
                        // xmm0 = a, xmm1 = b, result xmm0 -- no rax tail.
                        X3(0x66, 0x0F, 0x28); X1(0xC1);          // movapd xmm0, xmm1
                        X1(0xE8);                                // call _fmod
                        fixups.Add(new Fixup(txt.Count - 1, 4, 0, 0, "_fmod"));
                        X4(0);
                        X3(0x66, 0x48, 0x0F); X2(0x7E, 0xC7);    // movq rdi, xmm0
                        return;
                    } else if (op == TK.Less()) {
                        X3(0x66, 0x0F, 0x2F); X1(0xC1);          // comisd xmm0, xmm1
                        XSetV0cc(0x97);                          // seta (b>a ordered <=> a<b)
                        return;
                    } else if (op == TK.Greater()) {
                        X3(0x66, 0x0F, 0x2F); X1(0xC8);          // comisd xmm1, xmm0
                        XSetV0cc(0x97);                          // seta
                        return;
                    } else if (op == TK.LessEq()) {
                        X3(0x66, 0x0F, 0x2F); X1(0xC1);          // comisd xmm0, xmm1
                        XSetV0cc(0x93);                          // setae (b>=a <=> a<=b)
                        return;
                    } else if (op == TK.GreaterEq()) {
                        X3(0x66, 0x0F, 0x2F); X1(0xC8);          // comisd xmm1, xmm0
                        XSetV0cc(0x93);                          // setae
                        return;
                    } else if (op == TK.EqEq()) {
                        // eq = ZF set AND parity clear (unordered is ZF=PF=1)
                        X3(0x66, 0x0F, 0x2F); X1(0xC8);          // comisd xmm1, xmm0
                        X3(0x0F, 0x94, 0xC0);                    // sete al
                        X3(0x0F, 0x9B, 0xC2);                    // setnp dl
                        X2(0x22, 0xC2);                          // and al, dl
                        X3(0x48, 0x0F, 0xB6); X1(0xF8);          // movzx rdi, al
                        return;
                    } else if (op == TK.BangEq()) {
                        // ne = not-equal OR unordered (parity set)
                        X3(0x66, 0x0F, 0x2F); X1(0xC8);          // comisd xmm1, xmm0
                        X3(0x0F, 0x95, 0xC0);                    // setne al
                        X3(0x0F, 0x9A, 0xC2);                    // setp dl
                        X2(0x08, 0xD0);                          // or al, dl
                        X3(0x48, 0x0F, 0xB6); X1(0xF8);          // movzx rdi, al
                        return;
                    } else {
                        diags.Error("ngen: unsupported double operator " + op, e.line, e.col);
                        return;
                    }
                    X3(0x66, 0x48, 0x0F); X2(0x7E, 0xCF);        // movq rdi, xmm1
                    return;
                }
                GenExpr(e.a);
                XPushV0();                      // str x0, [sp, #-16]!
                GenExpr(e.b);
                XPopV(1);                      // ldr x1, [sp], #16
                int op = e.op;
                if (IsDblExpr(e.a)) { if (tgt86 == 1) { X3(0x66, 0x48, 0x0F); X2(0x6E, 0xC6); } else { E4(0x9E670020); } }  // fmov d0, x1 (movq xmm0, rsi)
                else { if (tgt86 == 1) { X4(0x2A0F48F2); X1(0xC6); } else { E4(0x9E620020); } }                 // scvtf d0, x1 (cvtsi2sd xmm0, rsi)
                if (IsDblExpr(e.b)) { if (tgt86 == 1) { X3(0x66, 0x48, 0x0F); X2(0x6E, 0xCF); } else { E4(0x9E670001); } }  // fmov d1, x0 (movq xmm1, rdi)
                else { if (tgt86 == 1) { X4(0x2A0F48F2); X1(0xCF); } else { E4(0x9E620001); } }                 // scvtf d1, x0 (cvtsi2sd xmm1, rdi)
                if (op == TK.Plus()) {
                    if (tgt86 == 1) { X4(0xC1580FF2); } else { E4(0x1E602820); }                  // fadd d0, d1, d0
                    if (tgt86 == 1) { X3(0x66, 0x48, 0x0F); X2(0x7E, 0xC7); } else { E4(0x9E660000); }                  // fmov x0, d0
                } else if (op == TK.Minus()) {
                    if (tgt86 == 1) { X4(0xC15C0FF2); } else { E4(0x1E613800); }                  // fsub d0, d0, d1
                    if (tgt86 == 1) { X3(0x66, 0x48, 0x0F); X2(0x7E, 0xC7); } else { E4(0x9E660000); }
                } else if (op == TK.Star()) {
                    if (tgt86 == 1) { X4(0xC1590FF2); } else { E4(0x1E600820); }                  // fmul d0, d1, d0
                    if (tgt86 == 1) { X3(0x66, 0x48, 0x0F); X2(0x7E, 0xC7); } else { E4(0x9E660000); }
                } else if (op == TK.Slash()) {
                    if (tgt86 == 1) { X4(0xC15E0FF2); } else { E4(0x1E611800); }                  // fdiv d0, d0, d1 (IEEE: no guard, like gen0)
                    if (tgt86 == 1) { X3(0x66, 0x48, 0x0F); X2(0x7E, 0xC7); } else { E4(0x9E660000); }
                } else if (op == TK.Percent()) {
                    // C# `%` on doubles keeps the dividend's sign (C fmod):
                    // the oracle lowers to LLVM frem, which the ARM64
                    // backend realizes as a libm fmod call
                    BLExtern("_fmod");
                    if (tgt86 == 1) { X3(0x66, 0x48, 0x0F); X2(0x7E, 0xC7); } else { E4(0x9E660000); }                  // fmov x0, d0
                } else if (op == TK.Less()) {
                    if (tgt86 == 1) { X3(0x66, 0x0F, 0x2F); X1(0xC1); } else { E4(0x1E612000); }                  // fcmp d0, d1
                    if (tgt86 == 1) { X3(0x0F, 0x92, 0xC0); X3(0x48, 0x0F, 0xB6); X1(0xF8); } else { E4(0x9A9F57E0); }                  // cset x0, mi
                } else if (op == TK.Greater()) {
                    if (tgt86 == 1) { X3(0x66, 0x0F, 0x2F); X1(0xC1); } else { E4(0x1E612000); }                  // fcmp d0, d1
                    if (tgt86 == 1) { X3(0x0F, 0x97, 0xC0); X3(0x48, 0x0F, 0xB6); X1(0xF8); } else { E4(0x9A9FD7E0); }                  // cset x0, gt
                } else if (op == TK.LessEq()) {
                    if (tgt86 == 1) { X3(0x66, 0x0F, 0x2F); X1(0xC8); } else { E4(0x1E602020); }                  // fcmp d1, d0 (swapped: a<=b <=> b>=a)
                    if (tgt86 == 1) { X3(0x0F, 0x93, 0xC0); X3(0x48, 0x0F, 0xB6); X1(0xF8); } else { E4(0x9A9FB7E0); }                  // cset x0, ge
                } else if (op == TK.GreaterEq()) {
                    if (tgt86 == 1) { X3(0x66, 0x0F, 0x2F); X1(0xC1); } else { E4(0x1E612000); }                  // fcmp d0, d1
                    if (tgt86 == 1) { X3(0x0F, 0x93, 0xC0); X3(0x48, 0x0F, 0xB6); X1(0xF8); } else { E4(0x9A9FB7E0); }                  // cset x0, ge
                } else if (op == TK.EqEq()) {
                    int set0 = NL();
                    int done2 = NL();
                    if (tgt86 == 1) { X3(0x66, 0x0F, 0x2F); X1(0xC8); } else { E4(0x1E602020); }                  // fcmp d1, d0
                    if (tgt86 == 1) { X2(0x0F, 0x8A); fixups.Add(new Fixup(txt.Count - 2, 1, set0, 6, null)); X4(0); } else { EmitBcond(6, set0); }   // b.vs -> unordered: false (comisd = parity)
                    if (tgt86 == 1) { X3(0x0F, 0x94, 0xC0); X3(0x48, 0x0F, 0xB6); X1(0xF8); } else { E4(0x9A9F17E0); }                  // cset x0, eq
                    EmitB(done2);
                    Mark(set0);
                    LoadImm(0, 0);
                    Mark(done2);
                } else if (op == TK.BangEq()) {
                    int set1 = NL();
                    int done3 = NL();
                    if (tgt86 == 1) { X3(0x66, 0x0F, 0x2F); X1(0xC8); } else { E4(0x1E602020); }                  // fcmp d1, d0
                    if (tgt86 == 1) { X2(0x0F, 0x8A); fixups.Add(new Fixup(txt.Count - 2, 1, set1, 6, null)); X4(0); } else { EmitBcond(6, set1); }   // b.vs -> unordered: true (comisd = parity)
                    if (tgt86 == 1) { X3(0x0F, 0x95, 0xC0); X3(0x48, 0x0F, 0xB6); X1(0xF8); } else { E4(0x9A9F07E0); }                  // cset x0, ne
                    EmitB(done3);
                    Mark(set1);
                    LoadImm(0, 1);
                    Mark(done3);
                } else {
                    diags.Error("ngen: unsupported double operator " + op, e.line, e.col);
                }
            } else {
                GenExpr(e.a);
                if (tgt86 == 1) { XPushV0(); } else { XPushV0(); }   // str x0, [sp, #-16]!
                GenExpr(e.b);
                if (tgt86 == 1) { XPopV(1); } else { PopV(1); }    // ldr x1, [sp], #16
                int op = e.op;
                if (tgt86 == 1) { X86IntBinop(e, op); }
                else if (IsUlongExpr(e.a) || IsUlongExpr(e.b)
                        || (Int32Kind(e.a) == 2 && Int32Kind(e.b) == 2)) {
                    // unsigned 64-bit: add/sub/mul keep the full i64 result
                    // (gen0's uint reads are 64-bit; the declared-width slot
                    // store truncates), division drops the MIN/-1 fold,
                    // comparisons go unsigned, and >> is logical
                    if (tgt86 == 1) { XFailClosed("ulong operators", curLine, curCol); return; }
                    bool bothU = Int32Kind(e.a) == 2 && Int32Kind(e.b) == 2;
                    if (op == TK.Plus()) {
                        AddRR(0, 1, 0);                  // add x0, x1, x0
                    } else if (op == TK.Minus()) {
                        SubRR(0, 1, 0);                  // sub x0, x1, x0
                    } else if (op == TK.Star()) {
                        MaddRR(0, 1, 0, 31);                  // mul x0, x1, x0
                    } else if (op == TK.Slash() || op == TK.Percent()) {
                        int bad = NL();
                        int cont = NL();
                        CbzReg(0, bad);
                        EmitB(cont);
                        Mark(bad);
                        XPushR(1);                  // str x1, [sp, #-16]! (keep dividend)
                        LoadSymRef("l_.str." + guardFileIdx, 0);
                        LoadImm(1, curLine);
                        LoadImm(2, curCol);
                        if (op == TK.Slash()) { LoadSymRef("l_.str." + guardDivIdx, 3); }
                        else { LoadSymRef("l_.str." + guardModIdx, 3); }
                        BLInternal("_zan_rt_guard_fail3");
                        XPopV(1);                  // ldr x1, [sp], #16
                        LoadImm(0, 1);                   // safe divisor
                        Mark(cont);
                        if (op == TK.Slash()) {
                            E4(0x9AC00820);              // udiv x0, x1, x0
                        } else {
                            E4(0x9AC00824);              // udiv x4, x1, x0
                            E4(0x9B008480);              // msub x0, x4, x0, x1
                        }
                    } else if (op == TK.Less()) {
                        CmpRR(1, 0);                  // cmp x1, x0
                        CsetCondX0(3);                  // cset x0, lo
                    } else if (op == TK.Greater()) {
                        CmpRR(1, 0);
                        E4(0x9A9F97E0);                  // cset x0, hi
                    } else if (op == TK.LessEq()) {
                        CmpRR(1, 0);
                        E4(0x9A9F87E0);                  // cset x0, ls
                    } else if (op == TK.GreaterEq()) {
                        CmpRR(1, 0);
                        E4(0x9A9F37E0);                  // cset x0, hs
                    } else if (op == TK.EqEq()) {
                        CmpRR(1, 0);
                        if (tgt86 == 1) { X3(0x0F, 0x94, 0xC0); X3(0x48, 0x0F, 0xB6); X1(0xF8); } else { E4(0x9A9F17E0); }                  // cset x0, eq
                    } else if (op == TK.BangEq()) {
                        CmpRR(1, 0);
                        if (tgt86 == 1) { X3(0x0F, 0x95, 0xC0); X3(0x48, 0x0F, 0xB6); X1(0xF8); } else { E4(0x9A9F07E0); }                  // cset x0, ne
                    } else if (op == TK.LessLess()) {
                        if (bothU) { E4(0x92401000); }   // and x0, x0, #31
                        E4(0x9AC02020);                  // lslv x0, x1, x0
                    } else if (op == TK.GreaterGreater()) {
                        if (bothU) { E4(0x92401000); }   // and x0, x0, #31
                        E4(0x9AC02420);                  // lsrv x0, x1, x0
                    } else if (op == TK.GreaterGreaterGreater()) {
                        if (bothU) { E4(0x92401000); }   // and x0, x0, #31
                        E4(0x9AC02420);                  // lsrv x0, x1, x0
                    } else if (op == TK.Amp()) {
                        E4(0x8A000020);                  // and x0, x1, x0
                    } else if (op == TK.Pipe()) {
                        E4(0xAA000020);                  // orr x0, x1, x0
                    } else if (op == TK.Caret()) {
                        E4(0xCA000020);                  // eor x0, x1, x0
                    } else {
                        diags.Error("ngen: unsupported ulong operator " + op, e.line, e.col);
                    }
                } else if (op == TK.Plus()) {
                    AddRR(0, 1, 0);                      // add x0, x1, x0
                    if (Int32Kind(e.a) == 1 && Int32Kind(e.b) == 1) { Wrap32(1); }
                } else if (op == TK.Minus()) {
                    SubRR(0, 1, 0);                      // sub x0, x1, x0
                    if (Int32Kind(e.a) == 1 && Int32Kind(e.b) == 1) { Wrap32(1); }
                } else if (op == TK.Star()) {
                    MaddRR(0, 1, 0, 31);                      // mul x0, x1, x0
                    if (Int32Kind(e.a) == 1 && Int32Kind(e.b) == 1) { Wrap32(1); }
                } else if (op == TK.Slash() || op == TK.Percent()) {
                    // divide/modulo: x1 = dividend, x0 = divisor. A zero
                    // divisor reports through zan_rt_guard_fail3 -- the same
                    // C-runtime guard the IR backend links -- and continues
                    // with divisor 1; INT_MIN / -1 also divides by 1 to
                    // avoid the SIGFPE trap, mirroring gen0's select guard.
                    int bad = NL();
                    int cont = NL();
                    int safe = NL();
                    CbzReg(0, bad);
                    EmitB(cont);
                    Mark(bad);
                    XPushR(1);                      // str x1, [sp, #-16]! (keep dividend across the call)
                    LoadSymRef("l_.str." + guardFileIdx, 0);
                    LoadImm(1, curLine);
                    LoadImm(2, curCol);
                    if (op == TK.Slash()) { LoadSymRef("l_.str." + guardDivIdx, 3); }
                    else { LoadSymRef("l_.str." + guardModIdx, 3); }
                    BLInternal("_zan_rt_guard_fail3");
                    XPopV(1);                      // ldr x1, [sp], #16 (own push; cont must not pop)
                    LoadImm(0, 1);                       // safe divisor
                    Mark(cont);
                    LoadImm(2, 0x8000000000000000);      // i64 min
                    LoadImm(3, -1);
                    if (tgt86 == 1) { Xop(0x39, 7, 1); } else { E4(0xEB03001F); }                      // cmp x0, x3
                    EmitBcond(1, safe);                  // b.ne safe
                    CmpRR(1, 2);                      // cmp x1, x2
                    EmitBcond(1, safe);
                    LoadImm(0, 1);
                    Mark(safe);
                    if (op == TK.Slash()) {
                        E4(0x9AC00C20);                  // sdiv x0, x1, x0
                        // the 64-bit quotient of INT_MIN / -1 is +2^31;
                        // int semantics wrap it back to INT_MIN
                        if (Int32Kind(e.a) == 1 && Int32Kind(e.b) == 1) { Wrap32(1); }
                    } else {
                        E4(0x9AC00C24);                  // sdiv x4, x1, x0
                        E4(0x9B008480);                  // msub x0, x4, x0, x1
                    }
                } else if (op == TK.Less()) {
                    CmpRR(1, 0);                      // cmp x1, x0
                    CsetCondX0(11);                      // cset x0, lt
                } else if (op == TK.Greater()) {
                    CmpRR(1, 0);                      // cmp x1, x0
                    if (tgt86 == 1) { X3(0x0F, 0x97, 0xC0); X3(0x48, 0x0F, 0xB6); X1(0xF8); } else { E4(0x9A9FD7E0); }                      // cset x0, gt
                } else if (op == TK.LessEq()) {
                    CmpRR(1, 0);                      // cmp x1, x0
                    CsetCondX0(13);                      // cset x0, le
                } else if (op == TK.GreaterEq()) {
                    CmpRR(1, 0);                      // cmp x1, x0
                    if (tgt86 == 1) { X3(0x0F, 0x93, 0xC0); X3(0x48, 0x0F, 0xB6); X1(0xF8); } else { E4(0x9A9FB7E0); }                      // cset x0, ge
                } else if (op == TK.EqEq()) {
                    CmpRR(1, 0);                      // cmp x1, x0
                    if (tgt86 == 1) { X3(0x0F, 0x94, 0xC0); X3(0x48, 0x0F, 0xB6); X1(0xF8); } else { E4(0x9A9F17E0); }                      // cset x0, eq
                } else if (op == TK.BangEq()) {
                    CmpRR(1, 0);                      // cmp x1, x0
                    if (tgt86 == 1) { X3(0x0F, 0x95, 0xC0); X3(0x48, 0x0F, 0xB6); X1(0xF8); } else { E4(0x9A9F07E0); }                      // cset x0, ne
                } else if (op == TK.LessLess()) {
                    // shifts compute at 64 bits; only the count masks, by the
                    // left operand's DECLARED width (a bare literal declares
                    // int), and an int target narrows the result at the store
                    if (ShiftMask32(e.a)) { E4(0x92401000); }   // and x0, x0, #31
                    E4(0x9AC02020);                      // lslv x0, x1, x0
                } else if (op == TK.GreaterGreater()) {
                    if (ShiftMask32(e.a)) { E4(0x92401000); }   // and x0, x0, #31
                    E4(0x9AC02820);                      // asrv x0, x1, x0
                } else if (op == TK.GreaterGreaterGreater()) {
                    // always logical; the 64-bit result stays untruncated
                    // here -- an int target narrows it at the store
                    if (ShiftMask32(e.a)) { E4(0x92401000); }   // and x0, x0, #31
                    E4(0x9AC02420);                      // lsrv x0, x1, x0
                } else if (op == TK.Amp()) {
                    E4(0x8A000020);                      // and x0, x1, x0
                } else if (op == TK.Pipe()) {
                    E4(0xAA000020);                      // orr x0, x1, x0
                } else if (op == TK.Caret()) {
                    E4(0xCA000020);                      // eor x0, x1, x0
                } else {
                    diags.Error("ngen: unsupported operator " + op, e.line, e.col);
                }
            }
        } else if (k == AK.Unary()) {
            GenExpr(e.a);
            if (e.op == TK.Minus()) {
                if (IsDblExpr(e.a)) {
                    if (tgt86 == 1) {
                        // fneg = flip the double's sign bit; the value rides
                        // as i64 bits in rdi, so an integer xor is exact
                        // (r11 is the lane's scratch, dead across an operand)
                        X2(0x49, 0xBB); X4(0); X4(0x80000000);      // movabs r11, 0x8000...0 (10B: opcode+imm64)
                        X3(0x4C, 0x31, 0xDF);                       // xor rdi, r11 (REX.R -> r11)
                    } else {
                        if (tgt86 == 1) { X3(0x66, 0x48, 0x0F); X2(0x6E, 0xC7); } else { E4(0x9E670000); }                  // fmov d0, x0
                        E4(0x1E614000);                  // fneg d0, d0
                        if (tgt86 == 1) { X3(0x66, 0x48, 0x0F); X2(0x7E, 0xC7); } else { E4(0x9E660000); }                  // fmov x0, d0
                    }
                } else {
                    if (tgt86 == 1) { X3(0x48, 0xF7, 0xDF); }   // neg rdi, rdi
                    else { E4(0xCB0003E0); }                  // neg x0, x0 (sub x0, xzr, x0)
                    // only a 32-bit-domain signed operand wraps at the neg
                    // (uint reads are 64-bit; literals are 64-bit)
                    if (Int32Kind(e.a) == 1) { Wrap32(1); }
                }
            } else if (e.op == TK.Bang()) {
                // logical not on every operand shape: `!x` is (x == 0),
                // matching the IR's icmp eq 0 (irgen_expr) -- this is what
                // makes `!d.ContainsKey(k)` behave on an int-shaped 0/1
                // predicate
                if (tgt86 == 1) {
                    X3(0x48, 0x85, 0xFF);                // test rdi, rdi
                    X3(0x0F, 0x94, 0xC0);                // sete al
                    X3(0x48, 0x0F, 0xB6); X1(0xF8);      // movzx rdi, al
                } else {
                    E4(0xF100001F);                      // cmp x0, #0
                    if (tgt86 == 1) { X3(0x0F, 0x94, 0xC0); X3(0x48, 0x0F, 0xB6); X1(0xF8); } else { E4(0x9A9F17E0); }                      // cset x0, eq
                }
            } else if (e.op == TK.Tilde()) {
                // source-level `~`: the C# bitwise complement
                if (tgt86 == 1) { X3(0x48, 0xF7, 0xD7); }   // not rdi, rdi
                else { E4(0xAA2003E0); }                      // orn x0, xzr, x0 (mvn)
            } else if (e.op == TK.PlusPlus() || e.op == TK.MinusMinus()) {
                // prefix ++/--: yield the NEW value
                GenIncDec(e.a, e.op == TK.PlusPlus(), true);
            }
            // unary plus is a no-op on the bit pattern
        } else if (k == AK.CastExpr() && e.type != null) {
            if (TryGenConversionCastNg(e)) { return; }
            // numeric casts: int<->ulong share the slot bits; to/from
            // double converts via scvtf/fcvtzs (like gen0's fptosi/sitofp)
            string ty = e.type.sval;
            bool toDbl = IsDblTy(ty);
            bool fromDbl = IsDblExpr(e.b);
            if (toDbl && !fromDbl) {
                GenExpr(e.b);
                if (tgt86 == 1) {
                    X2(0xF2, 0x0F); X2(0x2A, 0xC7);   // cvtsi2sd xmm0, rdi
                    X3(0x66, 0x48, 0x0F); X2(0x7E, 0xC7);   // movq rdi, xmm0
                } else {
                    if (tgt86 == 1) { X4(0x2A0F48F2); X1(0xC7); } else { E4(0x9E620000); }                      // scvtf d0, x0
                    if (tgt86 == 1) { X3(0x66, 0x48, 0x0F); X2(0x7E, 0xC7); } else { E4(0x9E660000); }                      // fmov x0, d0
                }
            } else if (!toDbl && fromDbl) {
                GenExpr(e.b);
                if (tgt86 == 1) {
                    X3(0x66, 0x48, 0x0F); X2(0x6E, 0xC7);   // movq xmm0, rdi (bits)
                    X2(0xF2, 0x48); X2(0x0F, 0x2C); X1(0xF8);   // cvttsd2si rdi, xmm0
                } else {
                    if (tgt86 == 1) { X3(0x66, 0x48, 0x0F); X2(0x6E, 0xC7); } else { E4(0x9E670000); }                      // fmov d0, x0
                    E4(0x9E780000);                      // fcvtzs x0, d0
                }
                if (ty == "int") { Sxtw0(); } // wrap the saturated i64 down to i32
            } else {
                // a static method group casts to its raw code address (the
                // oracle's native method-group value), not a delegate pair
                int rawMg = StaticGroupCastIdxNg(e);
                if (rawMg >= 0) { LoadSymRef(MethSymNg(methCls[rawMg], methNodes[rawMg]), 0); }
                else { GenExpr(e.b); }               // int<->ulong (and dbl->dbl): bits unchanged
                // (DelegateTy)nintExpr: a runtime-resolved address becomes a
                // bare code pointer (the oracle's `(WndProc)addr`, its
                // int->ptr cast). Bit 0 tags "call directly with the declared
                // signature, no env"; interned delegate pairs are even, so
                // the invoke branch never confuses the two shapes.
                if (IsDelegateTyNg(TypeFullName(e.type)) && !IsDelegateTyNg(StaticTyOf(e.b))) {
                    if (tgt86 == 1) { X2(0x48, 0x83); X2(0xCF, 0x01); }   // or rdi, 1
                    else { E4(0xB2400000); }         // orr x0, x0, #1
                }
                // narrow casts wrap at the declared width, like gen0's
                // truncating integer conversions
                // 批38:x86 臂补齐——这族全是 0-槽(rdi)就地变换,编码对齐
                // 1380/1386 已验证的 movsx 族;mov edi,edi 是 32 位自拷贝,
                // 写回时清高 32(零扩展语义,=arm64 ubfm)
                if (ty == "int") { Sxtw0(); }             // sbfm #31 / movsxd rdi, edi
                else if (ty == "uint") { if (tgt86 == 1) { X2(0x89, 0xFF); } else { E4(0xD3407C00); } }       // ubfm #31 / mov edi, edi
                // modrm 必须 FF(rm=111 → di/dil,值在 v0=rdi):1380 处的
                // F8(rm=000 → ax)在那站是良性的——XCallSeq 收尾 mov rdi, rax
                // 让 ax==di;这里值只在 rdi,照抄就会扩展出垃圾低 16 位
                else if (ty == "short") { if (tgt86 == 1) { X3(0x48, 0x0F, 0xBF); X1(0xFF); } else { E4(0x93403C00); } }      // sbfm #15 / movsx rdi, di
                else if (ty == "ushort" || ty == "char") { if (tgt86 == 1) { X3(0x0F, 0xB7, 0xFF); } else { E4(0xD3403C00); } }  // ubfm #15 / movzx edi, di
                else if (ty == "sbyte") { if (tgt86 == 1) { X3(0x48, 0x0F, 0xBE); X1(0xFF); } else { E4(0x93401C00); } }      // sbfm #7 / movsx rdi, dil
                else if (ty == "byte") { if (tgt86 == 1) { X1(0x40); X3(0x0F, 0xB6, 0xFF); } else { E4(0xD3401C00); } }   // ubfm #7 / movzx edi, dil (dil 需 REX)
            }
        } else if (k == AK.Index()) {
            if (IsStrExpr(e.a)) {
                // char access: bounds-checked byte load (gen0 reports the
                // same guard message and continues with index 0); a null
                // base reports too and answers 0 like the zeroed scratch
                GenExpr(e.a);
                XPushV0();                      // push s
                GenExpr(e.b);
                XPopV(1);                      // pop s -> x1 (x0 = idx)
                int bad = NL();
                int ldok = NL();
                int done = NL();
                int nulls = NL();
                CbzReg(1, nulls);                    // null base
                EmitB(ldok);
                Mark(nulls);
                LoadSymRef("l_.str." + guardFileIdx, 0);
                LoadImm(1, e.line);
                LoadImm(2, e.col);
                LoadSymRef("l_.str." + guardStrNull, 3);
                BLInternal("_zan_rt_guard_fail3");
                LoadImm(0, 0);
                EmitB(done);
                Mark(ldok);
                SubImm(2, 1, 8);                      // sub x2, x1, #8
                LdrU(2, 2, 0);                       // ldr x2, [x2]
                Uxtw32(2, 2);                        // ubfm x2, x2, #0, #31 (len)
                if (tgt86 == 1) { Xop(0x39, 7, 2); } else { E4(0xEB02001F); }                      // cmp x0, x2
                EmitBcond(10, bad);                  // b.ge bad
                if (tgt86 == 1) { X3(0x48, 0x83, 0xFF); X1(0x00); } else { E4(0xEB1F001F); }                      // cmp x0, xzr
                EmitBcond(11, bad);                  // b.lt bad
                if (tgt86 == 1) { X3(0x0F, 0xB6, 0x3C); X1(0x3E); } else { E4(0x38606820); } // ldrb w0, [x1, x0] = movzx edi,[rsi+rdi] (v0 home rdi)
                EmitB(done);
                Mark(bad);
                XPushR(1);                      // keep s across the call
                LoadSymRef("l_.str." + guardFileIdx, 0);
                LoadImm(1, e.line);
                LoadImm(2, e.col);
                LoadSymRef("l_.str." + guardStrIdx, 3);
                BLInternal("_zan_rt_guard_fail3");
                XPopV(1);                      // pop s
                LoadImm(0, 0);                       // safe index
                Mark(done);
            } else if (e.a != null && ArrContainerTy(e.a) != null && e.kids.Count > 0) {
                // rectangular element get (B8): per-dim bounds then a
                // row-major flat index; dims at arr+8d, data at arr+8*rank
                int nsub = 1 + e.kids.Count;
                string ct = ArrContainerTy(e.a);
                MdPrologueNg(e);
                MdFlatNg(e, nsub, e.line, e.col);
                AddImm(19, 19, 8 * nsub);          // data base = arr + 8*rank
                EmitArrElemLoad(ArrElemSize(ct), ArrElemName(ct), 19, 9, 0);
            } else if (ArrContainerTy(e.a) != null) {
                // array element get: len = i64 at arr-16; a bad index reports
                // and continues with index 0 (gen0 parity). int[] stores i32.
                int esz = ArrElemSize(ArrContainerTy(e.a));
                GenExpr(e.a);
                XPushV0();                      // push arr
                GenExpr(e.b);
                XPopV(1);                      // pop arr -> x1 (x0 = idx)
                if (tgt86 == 1) { LdrU(2, 1, -16); } else { E4(0xF85F0022); }   // ldur x2, [x1, #-16] (len) = mov rdx,[rsi-16]
                int bad = NL();
                int cont = NL();
                StringCmp(0, 2);                     // cmp x0, x2
                EmitBcond(10, bad);                  // b.ge bad
                StringCmp(0, 31);                    // cmp x0, xzr
                EmitBcond(11, bad);                  // b.lt bad
                EmitB(cont);
                Mark(bad);
                XPushR(1);                      // keep arr (guard clobbers x1)
                XPushV0();                      // keep idx
                LoadSymRef("l_.str." + guardFileIdx, 0);
                LoadImm(1, e.line);
                LoadImm(2, e.col);
                LoadSymRef("l_.str." + guardArrIdx, 3);
                BLInternal("_zan_rt_guard_fail3");
                XPopV(0);                      // pop idx
                XPopV(1);                      // pop arr
                LoadImm(0, 0);
                Mark(cont);
                EmitArrElemLoad(esz, ArrElemName(ArrContainerTy(e.a)), 1, 0, 0);
            } else if (e.a != null && e.a.kind == AK.NewExpr() && IsSpanNew(e.a)) {
                // Span<T> element get: deref the view's {base, len} box,
                // bounds-checked like an array
                int sesz = SpanElemSize(e.a);
                string sel = SpanElemTy(e.a);
                GenExpr(e.a);                        // box -> x0
                XPushV0();                      // push box
                GenExpr(e.b);                        // idx -> x0
                SpanBoxDeref();                      // x1 = base, x2 = len
                SpanIdxGuard(e.line, e.col, 0);
                EmitSpanElemLoad(sel, sesz);
            } else if (SpanContainerTy(e.a) != null) {
                // local/field Span<T> element get: deref the view's
                // {base, len} box, bounds-checked like an array
                string sct = SpanContainerTy(e.a);
                GenExpr(e.a);                        // box -> x0
                XPushV0();                      // push box
                GenExpr(e.b);                        // idx -> x0
                SpanBoxDeref();                      // x1 = base, x2 = len
                SpanIdxGuard(e.line, e.col, 0);
                EmitSpanElemLoad(SpanTyElem(sct), SpanTyElemSize(sct));
            } else if (ExprCls(e.a) == "Dict") {
                DictCheckOperand(e.a, e.b, true);
                // d[key] get: _zan_rt_dict_get returns 0 for a missing key
                // (zero-value semantics, gen0 parity); a struct value reads
                // out as a fresh copy so mutations never write through
                GenExpr(e.a);                        // dict -> x0
                XPushV0();                      // push dict
                GenExpr(e.b);                        // key -> x0
                MovRR(1, 0);                         // x1 = key
                XPopV(0);                      // pop dict -> x0
                BLInternal("_zan_rt_dict_get");
                int skipGc = NL();
                CbzReg(0, skipGc);                   // missing key: stay 0
                GenCloneIfStruct(e);
                Mark(skipGc);
            } else if (ExprCls(e.a) == "List" || IsDictViewAccess(e.a)) {
                // element get: data = obj+16, count = obj+0, 8-byte slots
                // (a Dictionary Keys/Values snapshot view indexes the same
                // way -- the member read already lowers to the snapshot list)
                GenExpr(e.a);
                XPushV0();                      // push obj
                GenExpr(e.b);
                XPopV(1);                      // pop obj -> x1 (x0 = idx)
                LdrU(2, 1, 0);                       // count
                LdrU(3, 1, 16);                      // data
                int bad = NL();
                int cont = NL();
                if (tgt86 == 1) { Xop(0x39, 7, 2); } else { E4(0xEB02001F); }                      // cmp x0, x2
                EmitBcond(10, bad);                  // b.ge bad
                if (tgt86 == 1) { X3(0x48, 0x83, 0xFF); X1(0x00); } else { E4(0xEB1F001F); }                      // cmp x0, xzr
                EmitBcond(11, bad);                  // b.lt bad
                EmitB(cont);
                Mark(bad);
                XPushR(3);                      // keep data (guard clobbers x3)
                XPushV0();                      // keep idx
                LoadSymRef("l_.str." + guardFileIdx, 0);
                LoadImm(1, e.line);
                LoadImm(2, e.col);
                LoadSymRef("l_.str." + guardListIdx, 3);
                BLInternal("_zan_rt_guard_fail3");
                XPopV(0);                      // pop idx
                XPopV(3);                      // pop data
                LoadImm(0, 0);
                Mark(cont);
                int gEnd = NL();
                CbzReg(3, gEnd);                     // empty list: backing is null
                if (tgt86 == 1) { X3(0x48, 0x8B, 0x3C); X1(0xF9); } else { E4(0xF8607860); } // ldr x0,[x3,x0,lsl#3] = mov rdi,[rcx+rdi*8] (v0 home rdi)
                Mark(gEnd);                          // null backing reads as zero
            } else if (OpIndexFit(ExprCls(e.a), "op_index", e.b, null) != null) {
                // class instance with an indexer: `obj[i]` lowers to the
                // op_index instance-method protocol (x0 receiver, x1 index);
                // overloads are picked by the index argument's type
                string oc = ExprCls(e.a);
                Node om = OpIndexFit(oc, "op_index", e.b, null);
                GenExpr(e.a);
                XPushV0();                      // push receiver
                GenExpr(e.b);
                MovRR(1, 0);                         // x1 = index
                XPopV(0);                      // pop receiver -> x0
                BLInternal(MethSymNg(oc, om));
            } else {
                diags.Error("ngen: unsupported index target", e.line, e.col);
            }
        } else if (k == AK.Assignment()) {
            string tgtTy = AssignTargetTy(e.a);
            if (tgtTy != null && tgtTy == "float") { tgtTy = "double"; }
            if (e.op != TK.Eq() && e.op != TK.QQEq()) {
                // compound assignment reads the target through the ordinary
                // Binary path (which knows ints, doubles, ulongs and string
                // concat) and stores through the same chain as `=`
                int bop2 = CompoundBinOp(e.op);
                if (bop2 == 0) {
                    diags.Error("ngen: unsupported compound assignment operator", e.line, e.col);
                    return;
                }
                Node bin2 = new Node(AK.Binary());
                bin2.op = bop2;
                bin2.line = e.line;
                bin2.col = e.col;
                bin2.a = e.a;
                bin2.b = e.b;
                GenExpr(bin2);
                if (tgtTy == "double" && !IsDblExpr(bin2)) { ConvI2D(); }
                else if (tgtTy == "float") {
                    // packed float[] slots take single bits; 8-byte float
                    // slots (locals, lists, fields) keep the widened double
                    if (e.a != null && e.a.kind == AK.Index() && ArrContainerTy(e.a.a) != null) { NarrowF32Bits(); }
                    else { NarrowF32(); }
                }
                else if (tgtTy == "int" && !IsDblExpr(bin2) && !IsStrExpr(bin2)) { Sxtw0(); }   // sxtw x0, w0
                else if (tgtTy == "uint" && !IsDblExpr(bin2) && !IsStrExpr(bin2)) { E4(0xD3407C00); }  // ubfm: zero-extend low 32
            } else if (TryGenBindingValue(e.b, tgtTy)) {
                // Binding<T> sugar: x0 already holds the fresh binding object
            } else {
                GenConversionValueNg(e.b, tgtTy);
            }
            if (TryGenStringStore(e.a)) { return; }
            if (e.a != null && e.a.kind == AK.Index() && ArrContainerTy(e.a.a) != null
                    && ArrElemName(ArrContainerTy(e.a.a)) == "float") {
                NarrowF32Bits();                     // packed float slots hold single bits
            }
            if (e.a != null && e.a.kind == AK.Ident()) {
                int li = LocalIdx(e.a.sval);
                if (li < 0) {
                    // implicit field store inside instance methods
                    Fld fld = CurField(e.a.sval);
                    if (fld != null) {
                        Cls nxc = ExpandedStructOf(fld);
                        if (nxc != null) {
                            // 批43:整体值存储 = 载荷拷贝进 this 的扁平区域
                            XPushV0();              // src box
                            LoadLocal(LocalIdx("this"), 0);
                            if (fld.off <= 4095) { AddImm(0, 0, fld.off); }
                            else { LoadImm(16, fld.off); AddRR(0, 0, 16); }
                            XPopV(1);
                            LoadImm(2, nxc.size);
                            BLExtern("_memcpy");
                            return;
                        }
                        XPushV0();                  // str x0, [sp, #-16]! (value)
                        LoadLocal(LocalIdx("this"), 0);  // receiver -> x0
                        XPopV(1);                        // ldr x1, [sp], #16 (value)
                        StoreFieldNg(1, 0, fld);             // str x1, [x0, #off]
                        return;
                    }
                    // static field store through its data-global slot
                    string ssym = FindStaticSym(curCls, e.a.sval);
                    if (ssym != null) {
                        LoadSymRef(ssym, 9);
                        StrU(0, 9, 0);
                        return;
                    }
                    // bare property store: the desugared set_Name accessor
                    // (instance: x0 = receiver, x1 = value; static: the
                    // value is the first parameter, so it stays in x0)
                    Node bs = AccessorInChain(curCls, "set_" + e.a.sval);
                    if (bs != null) {
                        if (HasMod(bs, MOD.Static())) {
                            // value already in x0
                        } else {
                            XPushV0();              // push value
                            LoadLocal(LocalIdx("this"), 0);
                            XPopV(1);              // x1 = value
                        }
                        BLInternal(MethSymNg(accOwnerCls, bs));
                        return;
                    }
                    // oracle parity: a plain `ident = expr` to an undeclared
                    // name is a silent dead store -- the RHS still evaluated
                    // above (Control's paneMin/paneMax, InputOtp's
                    // completeArmed init); explicit this., compound writes
                    // and reads all still error
                    return;
                }
                if (locRef[li]) {
                    LoadLocal(li, 1);                        // address in the slot
                    StrU(0, 1, 0);                           // store through it
                    return;
                }
                StoreLocalVal(li, 0);
            } else if (e.a != null && e.a.kind == AK.Index() && e.a.kids.Count > 0
                    && ArrContainerTy(e.a.a) != null) {
                // rectangular element set: the value rides the stack while
                // the subscripts bounds-check (same rule as the get)
                int nsub = 1 + e.a.kids.Count;
                int esz = ArrElemSize(ArrContainerTy(e.a.a));
                XPushV0();                      // push value
                MdPrologueNg(e.a);
                MdFlatNg(e.a, nsub, e.line, e.col);
                XPopV(2);                      // pop value -> x2
                AddImm(1, 19, 8 * nsub);             // x1 = data
                if (esz == 4) {
                    E4(0x8B090821);                  // add x1, x1, x9, lsl #2
                } else if (esz == 8) {
                    E4(0x8B090C21);                  // add x1, x1, x9, lsl #3
                } else {
                    E4(0x8B090021);                  // add x1, x1, x9
                }
                if (esz == 1) {
                    E4(0x39000022);                  // strb w2, [x1]
                } else if (esz == 2) {
                    E4(0x79000022);                  // strh w2, [x1]
                } else if (esz == 4) {
                    E4(0xB9000022);                  // str w2, [x1]
                } else {
                    E4(0xF9000022);                  // str x2, [x1]
                }
            } else if (e.a != null && e.a.kind == AK.Index() && ArrContainerTy(e.a.a) != null) {
                // array element set: same bounds rule as the get; the value
                // and index survive the guard call on the stack
                int esz = ArrElemSize(ArrContainerTy(e.a.a));
                XPushV0();                      // push value
                GenExpr(e.a.a);
                XPushV0();                      // push arr
                GenExpr(e.a.b);                      // x0 = idx
                XPopV(1);                      // pop arr -> x1
                XPopV(2);                      // pop value -> x2
                if (tgt86 == 1) { LdrU(3, 1, -16); } else { E4(0xF85F0023); }   // ldur x3, [x1, #-16] (len) = mov rcx,[rsi-16]
                int bad = NL();
                int cont = NL();
                StringCmp(0, 3);                     // cmp x0, x3
                EmitBcond(10, bad);                  // b.ge bad
                StringCmp(0, 31);                    // cmp x0, xzr
                EmitBcond(11, bad);                  // b.lt bad
                EmitB(cont);
                Mark(bad);
                XPushR(1);                      // keep arr (guard clobbers x1)
                XPushV0();                      // keep idx
                XPushR(2);                      // keep value
                LoadSymRef("l_.str." + guardFileIdx, 0);
                LoadImm(1, e.line);
                LoadImm(2, e.col);
                LoadSymRef("l_.str." + guardArrIdx, 3);
                BLInternal("_zan_rt_guard_fail3");
                XPopV(2);                      // pop value
                XPopV(0);                      // pop idx
                XPopV(1);                      // pop arr
                LoadImm(0, 0);
                Mark(cont);
                if (esz == 1) {
                    if (tgt86 == 1) { X3(0x88, 0x14, 0x3E); } else { E4(0x38206822); }   // strb w2, [x1, x0] = mov [rsi+rdi], dl
                } else if (esz == 2) {
                    // strh 寄存器形式必须 S=1(lsl #1):0x…6822 是 S=0 无缩放,
                    // 下标没乘 2(d[1] 落在字节 1);x86 臂的 rdi*2 一直是对的
                    if (tgt86 == 1) { X3(0x66, 0x89, 0x14); X1(0x7E); } else { E4(0x78207822); }   // strh w2, [x1, x0, lsl #1] = mov [rsi+rdi*2], dx
                } else if (esz == 4) {
                    if (tgt86 == 1) { X3(0x89, 0x14, 0xBE); } else { E4(0xB8207822); }   // str w2, [x1, x0, lsl #2] = mov [rsi+rdi*4], edx (SIB 0xBE = idx rdi)
                } else {
                    if (tgt86 == 1) { X3(0x48, 0x89, 0x14); X1(0xFE); } else { E4(0xF8207822); }   // str x2, [x1, x0, lsl #3] = mov [rsi+rdi*8], rdx
                }
            } else if (e.a != null && e.a.kind == AK.Index() && e.a.a != null
                    && e.a.a.kind == AK.NewExpr() && IsSpanNew(e.a.a)) {
                // Span<T> element set: the value survives on the stack while
                // the view's {base, len} box derefs; same bounds rule as the
                // get
                string sel = SpanElemTy(e.a.a);
                int sesz = SpanElemSize(e.a.a);
                XPushV0();                      // push value
                GenExpr(e.a.a);                      // box -> x0
                XPushV0();                      // push box
                GenExpr(e.a.b);                      // idx -> x0
                SpanBoxDeref();                      // x1 = base, x2 = len
                XPopV(3);                      // pop value -> x3
                SpanIdxGuard(e.line, e.col, 3);
                EmitSpanElemStore(sel, sesz);
            } else if (e.a != null && e.a.kind == AK.Index() && SpanContainerTy(e.a.a) != null) {
                // local/field Span<T> element set: the value survives on the
                // stack while the view's {base, len} box derefs; same bounds
                // rule as the get
                string sct2 = SpanContainerTy(e.a.a);
                XPushV0();                      // push value
                GenExpr(e.a.a);                      // box -> x0
                XPushV0();                      // push box
                GenExpr(e.a.b);                      // idx -> x0
                SpanBoxDeref();                      // x1 = base, x2 = len
                XPopV(3);                      // pop value -> x3
                SpanIdxGuard(e.line, e.col, 3);
                EmitSpanElemStore(SpanTyElem(sct2), SpanTyElemSize(sct2));
            } else if (e.a != null && e.a.kind == AK.Index() && ExprCls(e.a.a) == "Dict") {
                DictCheckOperand(e.a.a, e.a.b, true);
                DictCheckOperand(e.a.a, e.b, false);
                // d[key] = v: value survives on the stack while the dict and
                // key evaluate; _zan_rt_dict_set inserts or updates
                GenCloneIfStruct(e.b);               // struct values: fresh box
                XPushV0();                      // push value
                GenExpr(e.a.a);                      // dict -> x0
                XPushV0();                      // push dict
                GenExpr(e.a.b);                      // key -> x0
                MovRR(1, 0);                         // x1 = key
                XPopV(0);                      // pop dict -> x0
                XPopV(2);                      // pop value -> x2
                BLInternal("_zan_rt_dict_set");
            } else if (e.a != null && e.a.kind == AK.Index() && ExprCls(e.a.a) == "List") {
                // element set: bounds check like the get, then store into
                // the 8-byte slot (value preserved across the guard call);
                // List<int> narrows a long-valued literal to int32 first
                bool lint = ElemTyOf(e.a) == "int";
                XPushV0();                      // push value
                GenExpr(e.a.a);
                XPushV0();                      // push obj
                GenExpr(e.a.b);                      // x0 = idx
                XPopV(1);                      // pop obj -> x1
                XPopV(2);                      // pop value -> x2
                if (lint) { if (tgt86 == 1) { X3(0x48, 0x63, 0xD2); } else { E4(0x93407C42); } }        // sxtw x2, w2
                LdrU(3, 1, 0);                       // count
                LdrU(4, 1, 16);                      // data
                int bad = NL();
                int cont = NL();
                if (tgt86 == 1) { Xop(0x39, 7, 1); } else { E4(0xEB03001F); }                      // cmp x0, x3
                EmitBcond(10, bad);                  // b.ge bad
                if (tgt86 == 1) { X3(0x48, 0x83, 0xFF); X1(0x00); } else { E4(0xEB1F001F); }                      // cmp x0, xzr
                EmitBcond(11, bad);                  // b.lt bad
                EmitB(cont);
                Mark(bad);
                XPushR(4);                      // keep data (guard clobbers x4)
                XPushV0();                      // keep idx
                XPushR(2);                      // keep value
                LoadSymRef("l_.str." + guardFileIdx, 0);
                LoadImm(1, e.line);
                LoadImm(2, e.col);
                LoadSymRef("l_.str." + guardListIdx, 3);
                BLInternal("_zan_rt_guard_fail3");
                XPopV(2);                      // pop value
                XPopV(0);                      // pop idx
                XPopV(4);                      // pop data
                LoadImm(0, 0);
                Mark(cont);
                int sEnd = NL();
                CbzReg(4, sEnd);                     // empty list: backing is null, drop the store
                if (tgt86 == 1) { X3(0x49, 0x89, 0x14); X1(0xF8); } else { E4(0xF8207882); } // str x2,[x4,x0,lsl#3] = mov [r8+rdi*8],rdx (v2 home rdx)
                Mark(sEnd);
            } else if (e.a != null && e.a.kind == AK.Index()
                    && OpIndexFit(ExprCls(e.a.a), "op_index_set", e.a.b, e.b) != null) {
                // indexer set: obj[i] = v (or += v -- the read half went
                // through the ordinary Index path above). The value was
                // evaluated into x0 at the top; lower to the op_index_set
                // protocol: x0 receiver, x1 index, x2 value. Overloads are
                // picked by the index and value argument types.
                string oc = ExprCls(e.a.a);
                Node osm = OpIndexFit(oc, "op_index_set", e.a.b, e.b);
                XPushV0();                      // push value
                GenExpr(e.a.a);                      // receiver -> x0
                XPushV0();                      // push receiver
                GenExpr(e.a.b);                      // index -> x0
                MovRR(1, 0);                         // x1 = index
                XPopV(0);                      // pop receiver -> x0
                XPopV(2);                      // pop value -> x2
                BLInternal(MethSymNg(oc, osm));
            } else if (e.a != null && e.a.kind == AK.MemberAccess()) {
                // class-qualified static write: Program.starting = v
                // (the value was already evaluated into x0 at the top).
                // The receiver must NAME a class: a plain local (`bb.title
                // = v`, `this.w = ""`) is an instance-field write even when
                // another class declares a static of the same name --
                // FindStaticSym's by-name fallback would otherwise steal
                // the store into that static's global slot
                if (e.a.a != null && e.a.a.kind == AK.Ident() && LocalIdx(e.a.a.sval) < 0
                        && FindClass(e.a.a.sval) != null) {
                    string ssym = FindStaticSym(QualifiedCls(e.a.a.sval, e.a.sval2), e.a.sval);
                    if (ssym != null) {
                        XPushV0();                  // push value across LoadSymRef
                        LoadSymRef(ssym, 1);             // x1 = &slot
                        XPopV(0);                  // pop value -> x0
                        StrU(0, 1, 0);
                        return;
                    }
                }
                Fld f = FieldOf(e.a);
                if (f == null) {
                    // property setter fallback: obj.Prop = v / Cls.Prop = v
                    // dispatches to the desugared set_Prop accessor
                    Node sm2 = null;
                    string sc2 = null;
                    if (e.a.a != null && e.a.a.kind == AK.Ident() && LocalIdx(e.a.a.sval) < 0
                            && FindClass(e.a.a.sval) != null) {
                        sm2 = AccessorInChain(e.a.a.sval, "set_" + e.a.sval);
                    }
                    if (sm2 == null) {
                        sc2 = ExprCls(e.a.a);
                        sm2 = sc2 != null ? AccessorInChain(sc2, "set_" + e.a.sval) : null;
                    }
                    if (sm2 != null) {
                        string targetCls = accOwnerCls;
                        if (HasMod(sm2, MOD.Static())) {
                            // value already in x0 (first parameter)
                        } else {
                            XPushV0();              // push value
                            GenExpr(e.a.a);              // receiver -> x0
                            XPopV(1);                   // x1 = value
                        }
                        BLInternal(MethSymNg(targetCls, sm2));
                        return;
                    }
                    diags.Error("ngen: unknown field '" + e.a.sval + "'", e.line, e.col);
                    return;
                }
                Cls nxc = ExpandedStructOf(f);
                if (nxc != null) {
                    // 批43:整体值存储 = 载荷拷贝(源箱 → 扁平区域),
                    // 源箱本身保持共享无扰;区域基址经链偏移算术直达,
                    // 深链(o.i.j = q)不物化中间箱
                    XPushV0();                      // src box
                    GenNestedRegionAddr(e.a.a);     // x0 = region base
                    XPopV(1);                       // x1 = src
                    LoadImm(2, nxc.size);
                    BLExtern("_memcpy");
                    return;
                }
                XPushV0();                          // str x0, [sp, #-16]! (value)
                if (e.a.a != null && ChainIsExpanded(e.a.a)) {
                    GenNestedRegionAddr(e.a.a);     // 批43:链偏移算术,不物化
                } else {
                    GenExpr(e.a.a);                 // receiver -> x0
                }
                XPopV(1);                           // ldr x1, [sp], #16 (value)
                StoreFieldNg(1, 0, f);                       // str x1, [x0, #off]
            } else {
                diags.Error("ngen: unsupported assignment target", e.line, e.col);
            }
        } else if (k == AK.NewExpr()) {
            GenNew(e);
        } else if (k == AK.IsExpr()) {
            GenIs(e);
        } else if (k == AK.AsExpr()) {
            GenAs(e);
        } else if (k == AK.Call()) {
            GenCall(e);
        } else if (k == AK.Conditional()) {
            // c ? a : b -- truthiness is the 0/1 bool convention
            int elseL = NL();
            int endL = NL();
            GenExpr(e.a);
            EmitCBZ(0, elseL);
            GenExpr(e.b);
            if (IsDblExpr(e) && !IsDblExpr(e.b)) { ConvI2D(); }
            EmitB(endL);
            Mark(elseL);
            GenExpr(e.c);
            if (IsDblExpr(e) && !IsDblExpr(e.c)) { ConvI2D(); }
            Mark(endL);
        } else if (k == AK.SwitchExpr()) {
            GenSwitchExpr(e);
        } else if (k == AK.TupleExpr()) {
            GenTupleNg(e);
        } else if (k == AK.PostfixUnary()) {
            // x++ / x--: yield the OLD value, then store old +/- 1; any
            // place (local, ref local, field, static, element) goes through
            // its address so the target evaluates exactly once
            GenIncDec(e.a, e.op == TK.PlusPlus(), false);
        } else if (k == AK.WithExpr()) {
            // `recv with { f = v, ... }`: a memberwise copy of recv with the
            // named fields overwritten (record copy); the copy is a fresh
            // object even for classes
            string wtn = StaticTyOf(e.a);
            Cls wc = wtn != null ? SpecClsOf(wtn) : null;
            if (wc == null) {
                diags.Error("ngen: 'with' receiver has no record type", e.line, e.col);
                LoadImm(0, 0);
            } else {
                GenExpr(e.a);
                XPushV0();                      // push src
                LoadImm(0, wc.size + 16);
                LoadImm(1, 0);
                BLInternal("_zan_rt_alloc");
                XPopV(1);                           // pop src -> x1
                LoadImm(2, wc.size + 16);
                SubImm(0, 0, 8);
                SubImm(1, 1, 8);
                BLExtern("_memcpy");
                AddImm(0, 0, 8);                     // x0 = the copy
                XPushV0();                      // hold the copy
                int wi = 0;
                while (wi < e.kids.Count) {
                    Node wasg = e.kids[wi];
                    Fld wf = wasg.a != null ? FindField(wc, wasg.a.sval) : null;
                    if (wf == null) {
                        diags.Error("ngen: unknown field '" + wasg.a.sval + "' in with expression", wasg.line, wasg.col);
                    } else {
                        GenExpr(wasg.b);
                        GenCloneIfStruct(wasg.b);
                        Cls wxc = ExpandedStructOf(wf);
                        if (wxc != null) {
                            // 批49:展开字段整体值存储(与赋值路径同一载荷
                            // memcpy;目标是新鲜拷贝,区域基 = 拷贝+off)
                            XPushV0();                          // save src box
                            if (tgt86 == 1) { XopRMem(0x8B, 6, 4, 16); }  // mov rsi,[rsp+16] (copy)
                            else { E4(0xF84103E1); }     // ldur x1, [sp, #16] (copy)
                            MovRR(0, 1);
                            AddImm(0, 0, wf.off);               // dest = copy + off
                            XPopV(1);                           // src box
                            LoadImm(2, wxc.size);
                            BLExtern("_memcpy");
                        } else {
                            if (IsDblTy(wf.ty) && !IsDblExpr(wasg.b)) { ConvI2D(); }
                            if (tgt86 == 1) { XopRMem(0x8B, 6, 4, 0); }  // mov rsi,[rsp] (peek copy)
                            else { E4(0xF84003E1); }     // ldur x1, [sp] (peek copy)
                            StoreFieldNg(0, 1, wf);
                        }
                    }
                    wi = wi + 1;
                }
                XPopV(0);                      // pop copy -> x0
            }
        } else if (k == AK.CallInit()) {
            // 工厂调用延续初始化器：先降调用本身，结果（同一个对象）
            // 压栈应用成员写，原样返回——不做记录式拷贝。
            string fcls = CallRetTy(e.a);
            if (fcls == null || FindClass(fcls) == null) {
                diags.Error("ngen: factory-call initializer on unknown type", e.line, e.col);
                LoadImm(0, 0);
            } else {
                GenExpr(e.a);
                XPushV0();                      // push obj
                GenInitItems(fcls, e, 0);
                XPopV(0);                      // pop obj -> x0
            }
        } else if (k == AK.OutArg()) {
            // an out/ref argument evaluated in expression position yields
            // its storage ADDRESS (gen0's emit_expr of a ref arg)
            GenRefArg(e);
        } else {
            diags.Error("ngen: unsupported expression kind " + k, e.line, e.col);
        }
    }

    void GenNew(Node e) {
        if (TryGenDelegateNew(e)) { return; }
        if (TryGenHostNew(e)) { return; }
        string cls = e.type != null ? e.type.sval : null;
        if (cls == "List") { GenListNew(e); return; }
        if (cls == "Dict" || cls == "Dictionary") { GenDictNew(e); return; }
        if (cls == "Span") {
            // the view's {base, len} pair lands in this site's private
            // frame box (batch 12): [box]=base, [box+8]=len; indexing
            // derefs the box. No heap allocation, no per-call leak.
            GenExpr(e.kids[0]);                      // base -> x0
            XPushV0();                          // push base
            GenExpr(e.kids[1]);                      // len -> x0
            XPushV0();                          // push len
            SpanSiteBox(e);                          // x0 = frame box
            XPopV(2);                          // pop len -> x2
            XPopV(1);                          // pop base -> x1
            StrU(1, 0, 0);                           // [box] = base
            StrU(2, 0, 8);                           // [box+8] = len
            return;
        }
        if (e.ival == 1) {
            string etn = TypeFullName(e.type);
            int dims = e.sval2 != null && e.sval2 != "" ? (int)Convert.ToInt64(e.sval2) : 1;
            if (dims > 1) {
                GenMdArrNew(e, dims);
                return;
            }
            // the element of `new T[a][b]` is itself an array (8-byte refs):
            // the size reads from T plus ALL ranks, sized + trailing
            int Jesz = ArrElemSize(etn + ArrSuffix(e.op + 1));
            if (e.kids.Count > 0) {
                // array initializer: `new T[] { a, b, c }` (an explicit size,
                // if any, must equal the element count)
                GenArrInit(e, Jesz);
                return;
            }
            GenArrNew(e.b, Jesz);
            return;
        }
        Cls c = cls != null ? SpecClsOf(TypeFullName(e.type)) : null;
        if (c == null) {
            diags.Error("ngen: unknown class in 'new' expression", e.line, e.col);
            LoadImm(0, 0);
            return;
        }
        // allocate: x0 = size + 16 (header), x1 = descriptor (0: no dtor)
        LoadImm(0, c.size + 16);
        LoadImm(1, 0);
        BLInternal("_zan_rt_alloc");
        // stamp the runtime class site into the upper half of obj-8 (the
        // descriptor slot, 0 for plain news) so `x is T` can identify the
        // object's class later
        RtLdur(1, 0, -8);                                // ldur x1, [x0, #-8]
        if (tgt86 == 1) {
            // same descriptor stamp: desc |= site << 16 (v1=rsi, v2=rdx)
            XLoadImm(2, (long)c.site << 32);   // arm64 臂 movz hw=2 = lsl #32(旧注释 #16 有误)
            Xop(0x09, 6, 2);                             // or rsi, rdx
        } else {
            E4((int)(0xD2C00000 | (((long)c.site) << 5) | 2)); // movz x2, #site, lsl #16
            E4(0xAA020021);                              // orr x1, x1, x2
        }
        RtStur(1, 0, -8);                                // stur x1, [x0, #-8]
        if (c.poly == 1) {
            // polymorphic: stamp the class's (lazily built) vtable at obj+0
            XPushV0();                              // push obj
            LoadSymRef(DGlobalSym("vt." + cls), 9);      // x9 = &slot
            LdrU(1, 9, 0);                               // x1 = table (0 before init)
            int vtDone = NL();
            CbnzReg(1, vtDone);
            BLInternal("_vtinit_" + cls);                // x0 = table
            MovRR(1, 0);                                 // x1 = table
            Mark(vtDone);
            XPopV(0);                              // pop obj -> x0
            StrU(1, 0, 0);                               // obj->vptr = table
        }
        XPushV0();                                  // str x0, [sp, #-16]! (obj)
        // ctor arguments: for a brace object initializer (`new C(a) { X = v }`)
        // the first e.op kids are the paren args and the rest are field
        // initializers; otherwise every kid is an argument. Provided args
        // first, trailing defaults filled in; a class without any ctor
        // allocates bare (no call).
        Node callN = e;
        if (e.ival == 2) {
            Node tmp = new Node(AK.Call());
            tmp.line = e.line;
            tmp.col = e.col;
            int ai = 0;
            while (ai < e.op && ai < e.kids.Count) { tmp.Add(e.kids[ai]); ai = ai + 1; }
            callN = tmp;
        }
        // the instantiation substitutes open ctor parameter types both in
        // overload scoring (ArgParamScore) and at delegate registration
        // (PushCallArgs snapshots it)
        string instNg = TypeFullName(e.type);
        pendingCtorInstNg = instNg != null && instNg.IndexOf("<") > 0 ? instNg : null;
        int cix = FitCtorIdx(cls, callN, false, null);
        // `new C { X = v }` over a type whose ctors all take arguments: the
        // brace-only initializer lowers to a bare allocation plus its member
        // writes -- the reference's form (cs_b18_init; real C# demands a
        // parameterless ctor, the reference does not). Only a brace-only
        // initializer qualifies: a plain `new C()` still reports.
        bool braceOnly = e.ival == 2 && e.op == 0 && e.kids.Count > 0;
        string ctorSym = null;
        if (cix >= 0) {
            ctorSym = CtorSymNg(cls, methNodes[cix]);
            // a generic-class instantiation needs its OWN ctor body: the
            // open ctor is a template compiled with erasure, so any
            // type-sensitive lowering inside it degrades to the reference
            // form (a `new Dict<T, int>()` keeps the key-kind bits clear
            // and int-key instantiations strcmp their keys)
            string inst = TypeFullName(e.type);
            if (inst != null && inst.IndexOf("<") > 0) {
                Cls gc = FindClass(cls);
                if (gc != null && gc.tps.Count > 0) {
                    ctorSym = InstCtorSpecNg(inst, cls, gc, cix);
                }
            }
        }
        int pushed;
        if (cix >= 0) {
            pushed = PushCallArgs(methNodes[cix], callN);
            pendingCtorInstNg = null;
        } else if (CtorCountNg(cls) > 0 && !braceOnly) {
            pendingCtorInstNg = null;
            diags.Error("ngen: no constructor of '" + cls + "' takes "
                + callN.kids.Count + " argument(s)", e.line, e.col);
            return;
        } else {
            pendingCtorInstNg = null;
            pushed = 0;
        }
        int r = pushed;
        while (r >= 1) { XPopV(XArgVOf(r)); r = r - 1; } // ldr xr, [sp], #16 (args reversed; x86 v16/v17→真家)
        XPopV(0);                                  // ldr x0, [sp], #16 (obj)
        XPushV0();                                  // str x0, [sp, #-16]! (keep obj across the void ctor)
        if (ctorSym != null) {
            BLInternal(ctorSym);
        }
        // field initializers store through the object still on the stack
        if (e.ival == 2) { GenInitItems(cls, e, e.op); }
        XPopV(0);                                  // ldr x0, [sp], #16 (obj)
    }

    // 对象初始化器的成员写序列（GenNew 与 CallInit 共用）：对象压在栈
    // 上，从 kids[from] 起逐项应用——`member = { a, b }` 集合收养、
    // 属性走 set_ 访问器、字段直接存。每项结束时对象回到栈顶。
    void GenInitItems(string cls, Node e, int from) {
        int bi = from;
        while (bi < e.kids.Count) {
            Node it = e.kids[bi];
            if (it.kind == AK.Assignment() && it.a != null && it.a.kind == AK.Ident()
                    && it.b != null && it.b.kind == AK.NewExpr() && it.b.ival == 2
                    && it.b.type == null) {
                // `member = { a, b }`: C# member collection initializer
                GenMemberCollInit(cls, it);
            } else if (it.kind == AK.Assignment() && it.a != null && it.a.kind == AK.Ident()) {
                Fld initFld = FindField(FindClass(cls), it.a.sval);
                if (initFld == null && AccessorInChain(cls, "set_" + it.a.sval) != null) {
                    // property setter dispatch: an initializer item on a
                    // property calls the desugared set_Prop accessor
                    // exactly like an ordinary assignment
                    Node initSet = AccessorInChain(cls, "set_" + it.a.sval);
                    string initTy = (initSet != null && initSet.type != null) ? TypeFullName(initSet.type) : null;
                    if (initTy == null || !TryGenBindingValue(it.b, initTy)) {
                        GenExpr(it.b);
                    }
                    if (initTy != null && IsDblTy(initTy) && !IsDblExpr(it.b)) { ConvI2D(); }
                    if (initTy == "float") { NarrowF32(); }
                    MovRR(1, 0);                     // x1 = value
                    LdrU(0, 31, 0);                  // x0 = obj (peek: the call
                    BLInternal(MethSymNg(accOwnerCls, initSet));   // clobbers x0)
                    // obj stays the stack top for the next item
                } else if (initFld == null) {
                    diags.Error("ngen: unknown field '" + it.a.sval + "' in initializer", it.line, it.col);
                } else {
                    if (!TryGenBindingValue(it.b, initFld.ty)) {
                        GenExpr(it.b);
                    }
                    if (IsDblTy(initFld.ty) && !IsDblExpr(it.b)) { ConvI2D(); }
                    if (initFld.ty == "float") { NarrowF32(); }
                    Cls initNxc = ExpandedStructOf(initFld);
                    if (initNxc != null) {
                        // 批43:整体值初始化 = 载荷拷贝进扁平区域
                        // (x0 = src 箱,栈顶 = obj)
                        XPushV0();                  // push src
                        XPopV(2);                   // x2 = src
                        XPopV(0);                   // x0 = obj (dst base)
                        if (initFld.off <= 4095) { AddImm(0, 0, initFld.off); }
                        else { LoadImm(16, initFld.off); AddRR(0, 0, 16); }
                        MovRR(1, 2);                // x1 = src
                        LoadImm(2, initNxc.size);   // x2 = n
                        BLExtern("_memcpy");
                        XPushV0();                  // push obj back for the next item
                    } else {
                        XPushV0();                  // push value
                        XPopV(1);                   // pop value -> x1 (top)
                        XPopV(0);                   // pop obj -> x0
                        StoreFieldNg(1, 0, initFld);     // obj->field = value
                        XPushV0();                  // push obj back for the next item
                    }
                }
            } else {
                diags.Error("ngen: unsupported object initializer item", it.line, it.col);
            }
            bi = bi + 1;
        }
    }

    // `member = { a, b }` inside an object initializer: read the member once
    // off the object still on the stack (field load or getter-only property),
    // then Add every item into it -- C# semantics: existing content survives
    // and instances never share the collection. Dict members take flat
    // key/value pairs.
    void GenMemberCollInit(string cls, Node it) {
        Cls fc = FindClass(cls);
        Fld f = fc != null ? FindField(fc, it.a.sval) : null;
        string getterSym = null;
        string mty = null;
        if (f != null) {
            mty = f.ty;
        } else {
            Node g = fc != null ? AccessorInChain(cls, "get_" + it.a.sval) : null;
            if (g == null) {
                diags.Error("ngen: unknown member '" + it.a.sval
                    + "' in collection initializer", it.line, it.col);
                int di = 0;
                while (di < it.b.kids.Count) { GenExpr(it.b.kids[di]); di = di + 1; }
                return;
            }
            getterSym = MethSymNg(accOwnerCls, g);
            mty = TypeFullName(g.type);
        }
        bool dict = mty != null && mty.IndexOf("Dict<") == 0;
        // 门面集合（既不是 List 也不是 Dict 的类类型，如
        // ControlChildren——Add 是 owner.With(c) 的收养门面）：逐项调用
        // 它的 Add 方法，而不是把元素裸追加进对象内部布局（那会写穿
        // 非列表对象）。oracle irgen 的成员集合初始化同样逐个调 Add。
        string facadeAddSym = null;
        if (!dict && mty != null && mty.IndexOf("List<") != 0 && mty != "List") {
            Node am = AccessorInChain(mty, "Add");
            if (am != null && ParamCount(am) == 1) {
                facadeAddSym = MethSymNg(accOwnerCls, am);
            }
        }
        // strip the declared generic: List<E> -> E, Dict<K,V> -> K / V
        string args2 = "";
        if (mty != null) {
            int lt = mty.IndexOf("<");
            if (lt > 0 && mty.Length - 1 > lt) {
                args2 = mty.Substring(lt + 1, mty.Length - lt - 2);
            }
        }
        string keyTy = args2;
        string valTy = args2;
        if (dict) {
            int comma = args2.IndexOf(",");
            if (comma > 0) {
                keyTy = args2.Substring(0, comma);
                valTy = args2.Substring(comma + 1, args2.Length - comma - 1);
            }
        } else {
            valTy = args2;
        }
        // the member's collection reference, once: x0 = obj (peek) -> x0 = coll
        E4(0xF84003E0);                                  // ldur x0, [sp] (obj)
        if (f != null) {
            LdrU(0, 0, f.off);
        } else {
            BLInternal(getterSym);                       // x0 = coll
        }
        XPushV0();                                  // push coll (obj beneath)
        int ii = 0;
        while (ii < it.b.kids.Count) {
            if (dict) {
                if (ii + 1 >= it.b.kids.Count) {
                    diags.Error("ngen: dictionary initializer needs key/value pairs", it.line, it.col);
                    break;
                }
                GenExpr(it.b.kids[ii + 1]);              // value -> x0
                CoerceCollElem(valTy, it.b.kids[ii + 1]);
                XPushV0();                          // push value
                GenExpr(it.b.kids[ii]);                  // key -> x0
                CoerceCollElem(keyTy, it.b.kids[ii]);
                XPushV0();                          // push key
                // pushes are 16-byte cells (str x0, [sp, #-0x10]!): the
                // stack is now [sp]=key, [sp+16]=value, [sp+32]=coll, with
                // the peeked obj still beneath
                RtLdur(0, 31, 32);                       // x0 = coll
                XPushV0();                          // push dict
                RtDictSet3();                            // pops dict, key, value
                ii = ii + 2;
            } else {
                GenExpr(it.b.kids[ii]);                  // item -> x0
                CoerceCollElem(valTy, it.b.kids[ii]);
                GenCloneIfStruct(it.b.kids[ii]);
                MovRR(1, 0);                             // x1 = item
                LdrU(0, 31, 0);                          // x0 = coll (peek)
                if (facadeAddSym != null) {
                    BLInternal(facadeAddSym);            // facade.Add(item)
                } else {
                    ListAppendRaw();
                }
                ii = ii + 1;
            }
        }
        AddSPImm(16, true);                              // pop coll (obj back on top)
    }

    // element coercion at a collection-initializer boundary, mirroring the
    // inline List.Add rules (int slots widen, float slots round on the way in)
    void CoerceCollElem(string ety, Node arg) {
        if (ety == "double" && !IsDblExpr(arg)) { ConvI2D(); }
        else if (ety == "int" && !IsDblExpr(arg) && !IsStrExpr(arg)) {
            Sxtw0();                              // sxtw x0, w0
        } else if (ety == "float" && !IsStrExpr(arg)) {
            NarrowF32();
        }
    }

    // `new T[] { a, b, c }`: allocate with the element count, then store each
    // initializer expression at its slot (no bounds check -- the count is
    // static). The array stays on the stack across element evaluation.
    void GenArrInit(Node e, int esz) {
        int n = e.kids.Count;
        Node cnt = new Node(AK.IntLit());
        cnt.ival = n;
        GenArrNew(cnt, esz);
        bool f32 = esz == 4 && ArrElemName(TypeFullName(e.type) + "[]") == "float";
        string ieln = TypeFullName(e.type);              // declared element type
        XPushV0();                                  // push arr
        int k = 0;
        while (k < n) {
            GenExpr(e.kids[k]);                          // x0 = element value
            if (IsNulTy(ieln) && !IsNulExpr(e.kids[k])) {
                GenNulWrap(IsDblTy(NulPayOf(ieln)));     // payload -> cell
            }
            if (f32) { NarrowF32Bits(); }
            XPopV(1);                              // pop arr -> x1
            if (tgt86 == 1) {
                // 批38:初始化器下标是编译期常量——基址 r10 加常量位移
                // 后走 EmitArrElemStore/EmitSpanElemStore 同族存储形式
                // (4D/45 89 1A、66 45 89 1A、45 88 1A,批37b/38 双探针验证)
                XGetV(0, 11);                          // r11 = value
                XGetV(1, 10);                          // r10 = arr
                int disp = k * esz;
                if (disp < 128 && disp > -128) { X3(0x4D, 0x8D, 0x52); X1(disp); }   // lea r10, [r10+disp8]
                else { X3(0x4D, 0x8D, 0x92); X4(disp); }                             // lea r10, [r10+disp32]
                if (esz == 8) { X3(0x4D, 0x89, 0x1A); }                // mov [r10], r11
                else if (esz == 4) { X3(0x45, 0x89, 0x1A); }           // mov [r10], r11d
                else if (esz == 2) { X3(0x66, 0x45, 0x89); X1(0x1A); } // mov [r10], r11w
                else { X3(0x45, 0x88, 0x1A); }                         // mov [r10], r11b
            } else {
                E4((int)(0xD2800000 | (((long)k) << 5) | 2)); // movz x2, #k
                if (esz == 1) {
                    E4(0x38226820);                      // strb w0, [x1, x2] (S=0:汇编器对质形,批38)
                } else if (esz == 2) {
                    E4(0x78227820);                      // strh w0, [x1, x2, lsl #1]
                } else if (esz == 4) {
                    E4(0xB8227820);                      // str w0, [x1, x2, lsl #2]
                } else {
                    E4(0xF8227820);                      // str x0, [x1, x2, lsl #3]
                }
            }
            XPushR(1);                              // push arr back
            k = k + 1;
        }
        XPopV(0);                                  // pop arr -> x0
    }

    // rectangular multidim alloc (B8), the reference zan_mdarray_alloc:
    // each dim evaluates once (a negative one reports and keeps its value),
    // the total product folds on wrap ("array allocation overflow"), then
    // calloc(32 + 8*rank + total*esz) with rc=1, RCMAGIC, count=total and
    // rank in the site slot; dims[d] land at arr+8d, data at arr+8*rank.
    // `new int[2,2] { ... }` row-major items store right after.
    void GenMdArrNew(Node e, int rank) {
        string ety = TypeFullName(e.type);
        int esz = ArrElemSize(ety + "[]");
        if (rank > 4) {
            diags.Error("ngen: rectangular arrays above rank 4 are not supported by the native backend", e.line, e.col);
            LoadImm(0, 0);
            return;
        }
        // dims in callee-saved x19..x22, evaluated in source order (x19 is
        // statement scratch; x20-x25 are free across GenExpr here)
        int di = 0;
        while (di < rank) {
            Node dn = di == 0 ? e.b : e.kids[di - 1];
            if (dn == null) { LoadImm(0, 0); } else { GenExpr(dn); }
            if (tgt86 == 1) { X3(0x48, 0x83, 0xFF); X1(0x00); } else { E4(0xEB1F001F); }                              // cmp x0, xzr
            int okneg = NL();
            EmitBcond(10, okneg);                        // b.ge okneg
            LoadSymRef("l_.str." + guardFileIdx, 0);
            LoadImm(1, curLine);
            LoadImm(2, curCol);
            LoadSymRef("l_.str." + guardArrNeg, 3);
            BLInternal("_zan_rt_guard_fail3");
            LoadImm(0, 0);                               // safe dim
            Mark(okneg);
            MovRR(19 + di, 0);
            di = di + 1;
        }
        // total = product of dims; a negative product means the multiply
        // wrapped ("array allocation overflow", folded to 0)
        LoadImm(9, 1);
        di = 0;
        while (di < rank) {
            MovRR(0, 19 + di);
            E4(0x9B007D29);                              // mul x9, x9, x0
            di = di + 1;
        }
        E4(0xEB1F013F);                                  // cmp x9, xzr
        int okt = NL();
        EmitBcond(10, okt);
        LoadSymRef("l_.str." + guardFileIdx, 0);
        LoadImm(1, curLine);
        LoadImm(2, curCol);
        LoadSymRef("l_.str." + guardArrOvf, 3);
        BLInternal("_zan_rt_guard_fail3");
        LoadImm(9, 0);
        Mark(okt);
        MovRR(23, 9);                                    // x23 = total (count)
        if (esz == 4) {
            E4(0xD37EF529);                              // lsl x9, x9, #2
        } else if (esz == 8) {
            E4(0xD37DF129);                              // lsl x9, x9, #3
        } else if (esz == 2) {
            E4(0xD37FF929);                              // lsl x9, x9, #1
        }
        // wrapped bytes fold to the bare header, as in the reference
        E4(0xEB1F013F);                                  // cmp x9, xzr
        int okb = NL();
        EmitBcond(10, okb);
        LoadSymRef("l_.str." + guardFileIdx, 0);
        LoadImm(1, curLine);
        LoadImm(2, curCol);
        LoadSymRef("l_.str." + guardArrOvf, 3);
        BLInternal("_zan_rt_guard_fail3");
        LoadImm(9, 32 + 8 * rank);
        Mark(okb);
        E4(0x91000000 | ((32 + 8 * rank) << 10) | (9 << 5) | 9); // add x9, x9, #hdr
        MovRR(24, 9);                                    // x24 = bytes
        MovRR(0, 24);
        LoadImm(1, 1);
        BLExtern("_calloc");                             // x0 = raw
        MovRR(25, 0);                                    // x25 = raw
        int okalloc = NL();
        CbnzReg(0, okalloc);
        LoadSymRef("l_.str." + guardFileIdx, 0);
        LoadImm(1, curLine);
        LoadImm(2, curCol);
        LoadSymRef("l_.str." + guardArrFail, 3);
        BLInternal("_zan_rt_guard_fail3");
        Mark(okalloc);
        MovRR(0, 25);
        LoadImm(2, 1);
        StrU(2, 0, 0);                                   // raw->rc = 1
        LoadImm(2, 25404552263127619);
        StrU(2, 0, 8);                                   // raw->rcmagic
        StrU(23, 0, 16);                                 // raw->count = total
        LoadImm(2, rank);
        StrU(2, 0, 24);                                  // site slot = rank
        di = 0;
        while (di < rank) {
            StrU(19 + di, 0, 32 + 8 * di);               // dims[di] (arr+8*di)
            di = di + 1;
        }
        E4(0x91000000 | (32 << 10));                     // add x0, x0, #32 (arr; dims live at arr+8*d)
        // row-major initializer items, if any: each `{ ... }` kid is a row
        int it = rank - 1;
        if (it < e.kids.Count) {
            bool f32 = esz == 4 && ety == "float";
            bool dbl = esz == 8 && ety == "double";
            XPushV0();                              // push arr
            int k = 0;
            while (it < e.kids.Count) {
                Node row = e.kids[it];
                int ri = 0;
                while (ri < row.kids.Count) {
                    Node itm = row.kids[ri];
                    GenExpr(itm);
                    if (dbl && !IsDblExpr(itm)) { ConvI2D(); }
                    if (f32) { NarrowF32Bits(); }
                    XPopV(1);                      // pop arr -> x1
                    int off = 8 * rank + k * esz;
                    if (esz == 8) {
                        StrU(0, 1, off);
                    } else if (esz == 4) {
                        E4(0xB9000000 | ((off / 4) << 10) | (1 << 5));   // str w0, [x1, #off] (imm scaled)
                    } else if (esz == 1) {
                        E4(0x39000000 | (off << 10) | (1 << 5));         // strb w0
                    } else {
                        E4(0x79000000 | ((off / 2) << 10) | (1 << 5));   // strh w0 (imm scaled)
                    }
                    XPushR(1);                      // push arr back
                    k = k + 1;
                    ri = ri + 1;
                }
                it = it + 1;
            }
            XPopV(0);                              // pop arr -> x0
        }
    }

    // a literal node for a primitive-type constant read (`int.MaxValue`),
    // or null when `mem` is not one
    // does this member access name a compiler-lowered primitive constant
    // (int.MaxValue, double.NaN, ...)? Returns the primitive's own name, so
    // callers get both the existence check and the rendering type
    string PrimitiveConstRecvTy(Node mem) {
        if (mem == null || mem.a == null || mem.a.kind != AK.Ident()) { return null; }
        string recv = mem.a.sval;
        if (recv != "int" && recv != "long" && recv != "short" && recv != "ushort"
                && recv != "byte" && recv != "sbyte" && recv != "uint"
                && recv != "ulong" && recv != "char" && recv != "float"
                && recv != "double") { return null; }
        string s = mem.sval;
        if (s == "MaxValue" || s == "MinValue" || s == "Epsilon" || s == "NaN"
                || s == "PositiveInfinity" || s == "NegativeInfinity") { return recv; }
        return null;
    }

    Node PrimitiveConstLit(Node mem) {
        if (mem == null || mem.a == null || mem.a.kind != AK.Ident()) { return null; }
        string recv = mem.a.sval;
        // host math constants fold like primitive constants (no storage);
        // a user-declared Math member keeps its own identity
        if (recv == "Math" && (mem.sval == "PI" || mem.sval == "E")
                && FindStaticTy("Math", mem.sval) == null) {
            return FloatLitNg(mem.sval == "PI" ? "3.141592653589793" : "2.718281828459045");
        }
        if (PrimitiveConstRecvTy(mem) == null) { return null; }
        string s = mem.sval;
        if (recv == "int") {
            if (s == "MaxValue") { return IntLitNg(2147483647); }
            return IntLitNg(0 - 2147483648);
        }
        if (recv == "long") {
            if (s == "MaxValue") { return IntLitNg(9223372036854775807); }
            return IntLitNg(-9223372036854775807 - 1);
        }
        // the narrow unsigned kinds fold as positive i64 words, which the
        // signed renderer prints identically; only ulong.MaxValue sets the
        // high bit, so it types ulong and rides the unsigned renderer
        if (recv == "uint") {
            if (s == "MaxValue") { return IntLitNg(4294967295); }
            return IntLitNg(0);
        }
        if (recv == "ulong") {
            if (s == "MaxValue") { return IntLitNg(-1); }
            return IntLitNg(0);
        }
        if (recv == "short") {
            if (s == "MaxValue") { return IntLitNg(32767); }
            return IntLitNg(0 - 32768);
        }
        if (recv == "ushort") {
            if (s == "MaxValue") { return IntLitNg(65535); }
            return IntLitNg(0);
        }
        if (recv == "byte") {
            if (s == "MaxValue") { return IntLitNg(255); }
            return IntLitNg(0);
        }
        if (recv == "sbyte") {
            if (s == "MaxValue") { return IntLitNg(127); }
            return IntLitNg(0 - 128);
        }
        if (recv == "char") {
            Node c = new Node(AK.CharLit());
            c.ival = s == "MaxValue" ? 65535 : 0;
            return c;
        }
        if (recv == "float") {
            // float constants widen to the double that exactly holds them,
            // printing through the double path (gen0's widening render)
            if (s == "MaxValue") { return FloatLitNg("3.4028234663852886e38"); }
            if (s == "MinValue") { return FloatLitNg("-3.4028234663852886e38"); }
            if (s == "Epsilon") { return FloatLitNg("1.401298464324817e-45"); }
            if (s == "NaN") { return FloatLitNg("nan"); }
            if (s == "PositiveInfinity") { return FloatLitNg("inf"); }
            return FloatLitNg("-inf");
        }
        if (s == "MaxValue") { return FloatLitNg("1.7976931348623157e308"); }
        if (s == "MinValue") { return FloatLitNg("-1.7976931348623157e308"); }
        if (s == "Epsilon") { return FloatLitNg("2.2250738585072014e-308"); }
        if (s == "NaN") { return FloatLitNg("nan"); }
        if (s == "PositiveInfinity") { return FloatLitNg("inf"); }
        return FloatLitNg("-inf");
    }

    Node IntLitNg(long v) {
        Node n = new Node(AK.IntLit());
        n.ival = v;
        return n;
    }

    Node FloatLitNg(string txt) {
        Node n = new Node(AK.FloatLit());
        n.sval = txt;
        return n;
    }

    void GenFieldLoad(Node mem) {
        Fld f = FieldOf(mem);
        if (f == null) {
            // span view member: Length reads the boxed view length
            if (mem.sval == "Length" && SpanContainerTy(mem.a) != null) {
                GenExpr(mem.a);                      // box -> x0
                LdrU(0, 0, 8);                       // x0 = [box+8]
                return;
            }
            // primitive-type constants: int.MaxValue / long.MinValue /
            // double.MaxValue ... fold to literals (no runtime storage)
            Node pcl = PrimitiveConstLit(mem);
            if (pcl != null) { GenExpr(pcl); return; }
            // qualified static read: ClsName.field
            if (mem.a != null && mem.a.kind == AK.Ident()) {
                string ssym = FindStaticSym(QualifiedCls(mem.a.sval, mem.sval2), mem.sval);
                if (ssym != null) {
                    LoadSymRef(ssym, 0);
                    LdrU(0, 0, 0);
                    return;
                }
            }
            // qualified static property read: ClsName.Prop -> get_Prop()
            if (mem.a != null && mem.a.kind == AK.Ident() && LocalIdx(mem.a.sval) < 0
                    && FindClass(mem.a.sval) != null) {
                Node sg = AccessorInChain(mem.a.sval, "get_" + mem.sval);
                if (sg != null && HasMod(sg, MOD.Static())) {
                    LoadImm(0, 0);
                    BLInternal(MethSymNg(accOwnerCls, sg));
                    return;
                }
            }
            // property getter fallback: `obj.Prop` with no backing field
            // names the desugared get_Prop accessor
            string gc = ExprCls(mem.a);
            Node gm = gc != null ? AccessorInChain(gc, "get_" + mem.sval) : null;
            if (gm != null) {
                string targetCls = accOwnerCls;
                GenExpr(mem.a);
                BLInternal(MethSymNg(targetCls, gm));
                return;
            }
            diags.Error("ngen: unknown field '" + mem.sval + "'", mem.line, mem.col);
            LoadImm(0, 0);
            return;
        }
        GenExpr(mem.a);                                  // receiver -> x0
        Cls nxc = ExpandedStructOf(f);
        if (nxc != null) {
            // 批43:struct 值字段的读取 = 物化新箱(载荷从扁平区域拷贝),
            // 后续成员写永不穿透回父对象;null 接收者保持旧软零语义
            // (跳过物化,x0 = null 原样传递)
            if (mem.a.kind != AK.ThisExpr()) {
                int gEnd = NL();
                CbzReg(0, gEnd);
                MaterializeNestedBox(nxc, f);
                Mark(gEnd);
            } else {
                MaterializeNestedBox(nxc, f);
            }
            return;
        }
        if (mem.a.kind != AK.ThisExpr()) {
            // null receiver fails soft with a zero field value (gen0
            // parity: `t.name` on a null reference reports and reads null)
            int gEnd = NL();
            CbzReg(0, gEnd);
            LoadFieldNg(0, 0, f);                        // ldr x0, [x0, #off]
            Mark(gEnd);
            // fallthrough leaves x0 = 0 when the receiver was null
        } else {
            LoadFieldNg(0, 0, f);                        // ldr x0, [x0, #off]
        }
    }

    // static type name of an expression when it denotes a user class, else null
    string ExprCls(Node e) {
        if (e == null) { return null; }
        if (e.kind == AK.ThisExpr() || (e.kind == AK.Ident() && e.sval == "this")) { return curCls; }
        if (e.kind == AK.BaseExpr() || (e.kind == AK.Ident() && e.sval == "base")) {
            Cls bc = FindClass(curCls);
            return bc != null ? bc.baseName : null;
        }
        if (e.kind == AK.NewExpr()) { return e.type != null ? e.type.sval : null; }
        if (e.kind == AK.CastExpr() && e.type != null) { return ClassTyOf(e.type.sval); }
        if (e.kind == AK.AsExpr() && e.type != null) { return ClassTyOf(e.type.sval); }
        if (e.kind == AK.AwaitExpr()) { return ClassTyOf(AsyncAwaitElemTyNg(e.a)); }
        if (e.kind == AK.Index()) { return ClassTyOf(ElemTyOf(e)); }
        if (e.kind == AK.Call() && e.a != null) {
            // method results carry a class identity when the method's
            // declared return type names one (ChartOption.Create().x)
            return ClassTyOf(CallRetTy(e));
        }
        if (e.kind == AK.Ident()) {
            return ClassTyOf(NamedSlotTy(e.sval));
        }
        if (e.kind == AK.MemberAccess()) {
            // field chains resolve to the field's declared class
            // (`x.next.n` needs ExprCls of `x.next`)
            Fld mf = FieldOf(e);
            if (mf != null) { return ClassTyOf(mf.ty); }
            // qualified static field chains: `Store.items.Count` types the
            // receiver from the static field's declared type. A static
            // PROPERTY read (Encoding.UTF8) finds no field here and falls
            // through to the accessor typing below.
            if (e.a != null && e.a.kind == AK.Ident() && LocalIdx(e.a.sval) < 0
                    && FindClass(e.a.sval) != null) {
                string qst = FindStaticTy(QualifiedCls(e.a.sval, e.sval2), e.sval);
                if (qst != null) { return ClassTyOf(qst); }
            }
            // property getter member (`obj.Prop` with no backing field):
            // the accessor's declared return types the chain
            // (`b.Tags.Count` needs ExprCls(b.Tags) == "List")
            return ClassTyOf(PropGetterTy(e));
        }
        return null;
    }

    // element type name of an index expression ("l[i]" with l declared as
    // "List<Pt>" or "Pt[]"), or null. Struct elements resolve too: values
    // clone at every storage boundary now, so slots hold independent
    // objects and member access goes through the element pointer.
    string ElemTyOf(Node e) {
        if (e == null || e.a == null) { return null; }
        string el = null;
        if (ArrContainerTy(e.a) != null) {
            string at = ArrContainerTy(e.a);
            if (at != null && at.Length > 2) { el = ArrElemName(at); }
        } else if (ExprCls(e.a) == "List") {
            string ct = StaticTyOf(e.a);
            if (ct != null && ct.Length > 5 && ct.Substring(0, 5) == "List<"
                    && ct.Substring(ct.Length - 1, 1) == ">") {
                el = ct.Substring(5, ct.Length - 6);
            }
        } else if (ExprCls(e.a) == "Dict") {
            // Dictionary<string, V>[key] yields the value type
            string ct = StaticTyOf(e.a);
            if (ct != null && IsDictTyName(ct)
                    && ct.Substring(ct.Length - 1, 1) == ">") {
                string inner = ct.Substring(ct.IndexOf("<") + 1, ct.Length - ct.IndexOf("<") - 2);
                int comma = inner.IndexOf(",");
                el = comma >= 0 ? inner.Substring(comma + 1) : null;
            }
        } else if (IsDictViewAccess(e.a)) {
            // d.Keys[i] / d.Values[i]: the snapshot's element is the slot type
            el = DictSlotTy(e.a.a, e.a.sval == "Keys");
        }
        if (el == null) {
            // an indexer's element type is the op_index method's declared
            // return type (fit against the index expression for overloads)
            Node om = OpIndexFit(ExprCls(e.a), "op_index", e.b, null);
            if (om != null && om.type != null) { el = TypeFullName(om.type); }
        }
        if (el == null) { return null; }
        return el;
    }

    // "Dictionary<..."/"Dict<...": the builtin dict under either spelling
    bool IsDictTyName(string t) {
        return t != null && (t.IndexOf("Dictionary<") == 0 || t.IndexOf("Dict<") == 0);
    }

    // `d.Keys` / `d.Values` on a Dictionary expression: the snapshot-view
    // access that indexes and counts exactly like a List
    bool IsDictViewAccess(Node a) {
        return a != null && a.kind == AK.MemberAccess()
                && (a.sval == "Keys" || a.sval == "Values")
                && a.a != null && ExprCls(a.a) == "Dict";
    }

    // normalize a declared type name to its class identity ("List<string>"
    // behaves as its open type; primitive arrays carry none), else null
    string ClassTyOf(string t) {
        if (t == null || t == "" || IsNulTy(t) || t == "int" || t == "string" || t == "bool"
                || t == "void" || t == "char" || t == "double" || t == "long"
                || t == "ulong") { return null; }
        if (t.Length > 5 && t.Substring(0, 5) == "List<") { return "List"; }
        if (IsDictTyName(t)) { return "Dict"; }
        if (IsArrTy(t) && (t == "int[]" || t == "long[]" || t == "ulong[]"
                || t == "double[]" || t == "string[]" || t == "bool[]"
                || t == "char[]")) { return null; }
        // generics are erased: `GBox<bool>` names the open class `GBox`
        int lt = t.IndexOf("<");
        if (lt > 0) {
            string open = t.Substring(0, lt);
            if (FindClass(open) != null) { return open; }
        }
        return t;
    }

    // binary operator behind a compound assignment (+= -> +, ...), or 0
    int CompoundBinOp(int k2) {
        if (k2 == TK.PlusEq()) { return TK.Plus(); }
        if (k2 == TK.MinusEq()) { return TK.Minus(); }
        if (k2 == TK.StarEq()) { return TK.Star(); }
        if (k2 == TK.SlashEq()) { return TK.Slash(); }
        if (k2 == TK.PercentEq()) { return TK.Percent(); }
        if (k2 == TK.AmpEq()) { return TK.Amp(); }
        if (k2 == TK.PipeEq()) { return TK.Pipe(); }
        if (k2 == TK.CaretEq()) { return TK.Caret(); }
        if (k2 == TK.LessLessEq()) { return TK.LessLess(); }
        if (k2 == TK.GreaterGreaterEq()) { return TK.GreaterGreater(); }
        if (k2 == TK.GreaterGreaterGreaterEq()) { return TK.GreaterGreaterGreater(); }
        return 0;
    }

    // x is T / x is null. With single inheritance the receiver's static type
    // decides statically whenever the target is equal to or a base of it
    // (any instance of the receiver is then also a T, so only null fails).
    // When the receiver's type is a strict base of T the object's runtime
    // class has to be consulted via the site stamped by 'new'; unrelated
    // static types answer false, like gen0.
    // switch expression: `scrutinee switch { pat => result, ... }`. The
    // scrutinee evaluates exactly once and stays pushed on the machine
    // stack; every arm peeks at it through [sp], so a failed pattern or a
    // failed `when` guard falls through to later arms with the value
    // intact. The winning arm's result lands in x0, then the scrutinee pop
    // discards into x1. Type-pattern bindings are pre-stamped frame slots
    // (StampPatternBindings); the store peeks so the next arm can re-bind
    // the same scrutinee when a guard fails.
    void GenSwitchExpr(Node e) {
        GenExpr(e.a);                                    // x0 = scrutinee
        XPushV0();                                  // push scrutinee
        int endL = NL();
        string sst = StaticTyOf(e.a);
        int i = 0;
        while (i < e.kids.Count) {
            Node arm = e.kids[i];
            int nextL = NL();
            if (arm.a == null && arm.ival == 0) {
                // `_` discard: matches unconditionally
            } else if (arm.ival == 1) {
                LdrU(0, 31, 0);                          // x0 = scrutinee (peek)
                EmitTypeTestNg(arm.type != null ? arm.type.sval : null, sst);
                EmitCBZ(0, nextL);                       // no match: next arm
                if (arm.sval != null) {
                    int li = LocalIdx(arm.sval);
                    if (li >= 0) {
                        LdrU(1, 31, 0);                  // x1 = scrutinee
                        StoreLocal(li, 1);               // bind
                    }
                }
            } else if (arm.a != null && arm.a.kind == AK.NullLit()) {
                LdrU(1, 31, 0);                          // x1 = scrutinee
                E4(0xEB1F003F);                          // cmp x1, xzr
                EmitCbnz(1, nextL);                      // non-null: next arm
            } else if (arm.op == TK.Less() || arm.op == TK.Greater()
                    || arm.op == TK.LessEq() || arm.op == TK.GreaterEq()) {
                LdrU(1, 31, 0);                          // x1 = scrutinee
                GenExpr(arm.a);                          // x0 = bound
                CmpRR(1, 0);                          // cmp x1, x0
                int skip = 11;
                if (arm.op == TK.Less()) { skip = 10; }          // b.ge
                else if (arm.op == TK.Greater()) { skip = 13; }  // b.le
                else if (arm.op == TK.LessEq()) { skip = 12; }   // b.gt
                EmitBcond(skip, nextL);
            } else if (arm.a != null) {
                LdrU(1, 31, 0);                          // x1 = scrutinee
                GenExpr(arm.a);                          // x0 = constant
                CmpRR(1, 0);                          // cmp x1, x0
                EmitBcond(1, nextL);                     // b.ne: next arm
            }
            if (arm.c != null) {
                GenExpr(arm.c);                          // `when` guard
                EmitCBZ(0, nextL);                       // false: next arm
            }
            GenExpr(arm.b);                              // x0 = arm result
            if (IsDblExpr(e) && !IsDblExpr(arm.b)) { ConvI2D(); }
            XPopV(1);                              // pop scrutinee -> x1
            EmitB(endL);
            Mark(nextL);
            i = i + 1;
        }
        // no discard arm and nothing matched: the zero fallback (a null
        // string for string results), like the zero initializer
        XPopV(1);                                  // pop scrutinee -> x1
        LoadImm(0, 0);
        Mark(endL);
    }

    // tuple literal: alloc the synthesized layout and store each element
    // (clone semantics match a field write -- strings share, structs copy)
    void GenTupleNg(Node e) {
        string mangled = TupleExprMangledNg(e);
        EnsureTupleClsNg(mangled, TupleClsElemTysOfNg(mangled, e));
        int n2 = e.kids.Count;
        LoadImm(0, n2 * 8 + 16);
        LoadImm(1, 0);
        BLInternal("_zan_rt_alloc");                     // x0 = zeroed payload
        XPushV0();                                  // hold the payload
        int i = 0;
        while (i < e.kids.Count) {
            GenExpr(e.kids[i]);                          // x0 = element
            GenCloneIfStruct(e.kids[i]);
            LdrU(1, 31, 0);                              // x1 = payload (peek;
                                                         //  element eval pushes
                                                         //  are balanced)
            StrU(0, 1, 8 * i);                           // ItemN = element
            i = i + 1;
        }
        XPopV(0);                                  // pop payload -> x0
    }

    // the element types a registered tuple class was built with, computed
    // from the literal when the class lookup loses the race (both paths
    // mangle identically, so this only fires on inference-order edges)
    List<string> TupleClsElemTysOfNg(string mangled, Node lit) {
        Cls c = FindClass(mangled);
        if (c != null) {
            List<string> fs = new List<string>();
            int i = 0;
            while (i < c.flds.Count) { fs.Add(c.flds[i].ty); i = i + 1; }
            return fs;
        }
        List<string> etys = new List<string>();
        int j = 0;
        while (j < lit.kids.Count) { etys.Add(TupleElemTyNg(lit.kids[j])); j = j + 1; }
        return etys;
    }

    // deconstruction: `var (a, b) = rhs;` / `(int x, int y) = rhs;` -- the
    // rhs evaluates once to the tuple payload; slot i loads into the
    // pre-stamped binding local
    void GenDeconNg(Node s) {
        GenExpr(s.b);                                    // x0 = tuple payload
        XPushV0();                                  // hold it
        int i = 0;
        while (i < s.kids.Count) {
            Node p = s.kids[i];
            // slot by DECL NODE: the statement's env snapshot predates the
            // bound locals, so the name chain is trimmed back here
            int li = p.sval != null ? DeclSlotNg(p) : -1;
            if (li >= 0) {
                LdrU(0, 31, 0);                          // x0 = payload (peek)
                LdrU(2, 0, 8 * i);                       // x2 = element i
                StoreLocal(li, 2);
            }
            i = i + 1;
        }
        XPopV(1);                                  // pop payload -> x1
    }

    // the Task / Task<T> shape of an expression's static type, else null
    string TaskTyOfNg(Node e) {
        string t = StaticTyOf(e);
        if (t != null && (t == "Task" || t.IndexOf("Task<") == 0)) { return t; }
        return null;
    }

    // t.IsCompleted / t.Result property reads on a Task-typed value -- the
    // same semantics as the call forms: the null frame of an inline-run
    // Task.Run body is already done with result 0; Result pumps the driver
    // until the frame completes, rethrows a captured exception, and reads
    // frame+32
    void GenTaskMemberRead(Node e) {
        GenExpr(e.a);                                    // x0 = frame handle
        int tnull = NL();
        int tend = NL();
        if (e.sval == "IsCompleted") {
            CbzReg(0, tnull);
            LdrU(0, 0, 8);                               // frame.done
            if (tgt86 == 1) { X3(0x48, 0x83, 0xFF); X1(0x00); } else { E4(0xEB1F001F); }                              // cmp x0, xzr
            if (tgt86 == 1) { X3(0x0F, 0x95, 0xC0); X3(0x48, 0x0F, 0xB6); X1(0xF8); } else { E4(0x9A9F07E0); }                              // cset x0, ne
            EmitB(tend);
            Mark(tnull);
            LoadImm(0, 1);                               // null frame: done
            Mark(tend);
            return;
        }
        CbzReg(0, tnull);
        XPushV0();                                  // frame stays live
        AddImm(0, 0, 8);                                 // x0 = &frame.done
        LoadImm(1, 1);                                   // mode 1: quiesce
        BLInternal("_zan_co_sched_run_until");
        PopV(9);                                  // x9 = frame
        AsyncSubExcCheckNg();                            // Result rethrows
        LdrU(0, 9, 32);                                  // frame.result
        EmitB(tend);
        Mark(tnull);
        LoadImm(0, 0);                                   // null frame: inline-run body, no result
        Mark(tend);
    }

    // the type test half of `x is T` with the value already in x0: x0 <- 1
    // when it is a T, 0 otherwise. GenSwitchExpr peeks its pushed scrutinee
    // through here so arms share GenIs's exact matching rule (gen0's rule:
    // same-or-base statics answer non-null, strict downcasts and object/
    // interface sources consult the runtime site, and a heap string in the
    // slot carries the "ZANS" obj-8 tag the site walk never matches).
    void EmitTypeTestNg(string tt, string st) {
        if (tt == "string") {
            // string targets are decided by the header tag, not a site
            if (st == "string") {
                if (tgt86 == 1) { X3(0x48, 0x83, 0xFF); X1(0x00); } else { E4(0xEB1F001F); }                          // cmp x0, xzr
                if (tgt86 == 1) { X3(0x0F, 0x95, 0xC0); X3(0x48, 0x0F, 0xB6); X1(0xF8); } else { E4(0x9A9F07E0); }                          // cset x0, ne
            } else if (st == "object") {
                // the slot may hold a heap string: tag == "ZANS" answers it
                int noL = NL();
                int endL = NL();
                CbzReg(0, noL);                          // null -> false
                RtLdur(1, 0, -8);                        // ldur x1, [x0, #-8]
                LsrImm64(1, 32);                          // lsr x1, x1, #32
                LoadImm(2, 1514229331);                  // 0x5A414E53 "ZANS"
                CmpRR(1, 2);                          // cmp x1, x2
                if (tgt86 == 1) { X3(0x0F, 0x94, 0xC0); X3(0x48, 0x0F, 0xB6); X1(0xF8); } else { E4(0x9A9F17E0); }                          // cset x0, eq
                EmitB(endL);
                Mark(noL);
                LoadImm(0, 0);
                Mark(endL);
            } else {
                LoadImm(0, 0);                           // value type / unknown
            }
            return;
        }
        Cls tc = FindClass(tt);
        if (tc == null) {
            // non-class target: strings and value types are decided by the
            // static types alone
            if (tt == "string" && st == "string") {
                if (tgt86 == 1) { X3(0x48, 0x83, 0xFF); X1(0x00); } else { E4(0xEB1F001F); }                          // cmp x0, xzr
                if (tgt86 == 1) { X3(0x0F, 0x95, 0xC0); X3(0x48, 0x0F, 0xB6); X1(0xF8); } else { E4(0x9A9F07E0); }                          // cset x0, ne
            } else if (st != null && st == tt) {
                LoadImm(0, 1);                           // same value type: always
            } else {
                LoadImm(0, 0);
            }
            return;
        }
        string sc = ClassTyOf(st);
        if (sc == null) {
            // a string can never hold a class instance; anything else with
            // no class identity cannot either
            LoadImm(0, 0);
            return;
        }
        if (st == "object") {
            // object-typed source: identity is unknown statically, always
            // consult the runtime site (gen0 rule)
            GenIsSite(tc);
            return;
        }
        if (sc == tt || DerivesFrom(sc, tt)) {
            if (tgt86 == 1) { X3(0x48, 0x83, 0xFF); X1(0x00); } else { E4(0xEB1F001F); }                              // cmp x0, xzr
            if (tgt86 == 1) { X3(0x0F, 0x95, 0xC0); X3(0x48, 0x0F, 0xB6); X1(0xF8); } else { E4(0x9A9F07E0); }                              // cset x0, ne
            return;
        }
        if (DerivesFrom(tt, sc)) {
            GenIsSite(tc);
            return;
        }
        LoadImm(0, 0);
    }

    void GenIs(Node e) {
        if (e.type == null) {                            // `x is null`
            GenExpr(e.a);
            if (tgt86 == 1) { X3(0x48, 0x83, 0xFF); X1(0x00); } else { E4(0xEB1F001F); }                              // cmp x0, xzr
            if (e.op == 1) {
                if (tgt86 == 1) { X3(0x0F, 0x95, 0xC0); X3(0x48, 0x0F, 0xB6); X1(0xF8); } else { E4(0x9A9F07E0); }                          // `is not null`: cset ne
            } else {
                if (tgt86 == 1) { X3(0x0F, 0x94, 0xC0); X3(0x48, 0x0F, 0xB6); X1(0xF8); } else { E4(0x9A9F17E0); }                          // `is null`: cset eq
            }
            return;
        }
        // the FULL pattern name: a bare sval is just the head ("List", or
        // "int" with the nullable `?` parked in op), which could never match
        // the receiver's rendered static type ("List<int?>", "int?")
        string tt = TypeFullName(e.type);
        string st = StaticTyOf(e.a);
        if (e.sval != null) {
            // `x is T v`: evaluate once and hold the value across the test;
            // a match stores it into the pre-stamped binding slot. Storing
            // unconditionally is observably the same as storing on match
            // only: reads are guarded by this very test (definite
            // assignment), so the junk slot is never observed on a miss.
            GenExpr(e.a);
            XPushV0();                              // push v
            LdrU(0, 31, 0);                              // x0 = v (peek)
            EmitTypeTestNg(tt, st);
            int li = LocalIdx(e.sval);
            XPopV(1);                              // pop v -> x1
            if (li >= 0) { StoreLocal(li, 1); }
        } else {
            GenExpr(e.a);                                // x0 = receiver
            EmitTypeTestNg(tt, st);
        }
        if (e.op == 1) {                                 // `is not`: negate
            E4(0xF100001F);                              // cmp x0, #0
            if (tgt86 == 1) { X3(0x0F, 0x94, 0xC0); X3(0x48, 0x0F, 0xB6); X1(0xF8); } else { E4(0x9A9F17E0); }                              // cset x0, eq
        }
    }

    // x as T -- like gen0: upcasts/identity, unrelated static types and
    // non-class targets pass the value through; a downcast consults the
    // runtime class site and yields null on failure
    void GenAs(Node e) {
        string tt = e.type != null ? e.type.sval : null;
        string st = StaticTyOf(e.a);
        Cls tc = tt != null ? FindClass(tt) : null;
        if (tt == null || tc == null || st == null) { GenExpr(e.a); return; }
        string sc = ClassTyOf(st);
        if (sc == null) { GenExpr(e.a); return; }
        if (st != "object") {
            if (sc == tt || DerivesFrom(sc, tt)) { GenExpr(e.a); return; }
            if (!DerivesFrom(tt, sc)) { GenExpr(e.a); return; }
        }
        // downcast: keep the value on the stack across the site test
        GenExpr(e.a);
        XPushV0();                                  // push v
        LdrU(0, 31, 0);                                  // x0 = v
        GenIsSite(tc);                                   // x0 = 0/1
        int failL = NL();
        int endL = NL();
        CbzReg(0, failL);
        XPopV(0);                                  // pop v -> x0
        EmitB(endL);
        Mark(failL);
        XPopV(0);                                  // pop v (discard)
        LoadImm(0, 0);                                   // null
        Mark(endL);
    }

    // runtime site check for `x is T` with the object in x0: extract the
    // site from obj-8's upper half and compare against T's site set (T and
    // every class deriving from it)
    void GenIsSite(Cls c) {
        int zeroL = NL();
        int foundL = NL();
        int endL = NL();
        CbzReg(0, zeroL);                                // null -> false
        RtLdur(1, 0, -8);                                // ldur x1, [x0, #-8]
        LsrImm64(1, 32);                                  // lsr x1, x1, #32 (site)
        int i = 0;
        while (i < classes.Count) {
            Cls cc = classes[i];
            if (cc.site > 0 && DerivesFrom(cc.name, c.name)) {
                LoadImm(2, cc.site);
                CmpRR(1, 2);                          // cmp x1, x2
                EmitBcond(0, foundL);                    // b.eq
            }
            i = i + 1;
        }
        Mark(zeroL);
        LoadImm(0, 0);
        EmitB(endL);
        Mark(foundL);
        LoadImm(0, 1);
        Mark(endL);
    }

    // declared static type name of an expression (before class identity
    // normalization), or null when nothing is known
    string StaticTyOf(Node e) {
        // Depth guard: cyclic type chains bottom out as unknown instead of
        // recursing forever. Fluent chains are typed WITHOUT memoization:
        // position keys mislabel sub-nodes sharing an expression start, and
        // the chain walkers reuse already-computed receiver types instead.
        if (stTyDepth > 256) { return null; }
        stTyDepth = stTyDepth + 1;
        string r = StaticTyOfInner(e);
        stTyDepth = stTyDepth - 1;
        return r;
    }

    string StaticTyOfInner(Node e) {
        if (e == null) { return null; }
        if (HostIsLength(e)) { return "int"; }
        if (e.kind == AK.ThisExpr() || (e.kind == AK.Ident() && e.sval == "this")) {
            // a specialization's `this` carries the instantiation type
            string tt = NamedSlotTy("this");
            return tt != null && tt != "" ? tt : curCls;
        }
        if (e.kind == AK.BaseExpr() || (e.kind == AK.Ident() && e.sval == "base")) {
            Cls bc = FindClass(curCls);
            return bc != null ? bc.baseName : null;
        }
        if (e.kind == AK.NewExpr()) {
            if (e.type == null) { return null; }
            if (e.ival != 1) { return TypeFullName(e.type); }
            return TypeFullName(e.type) + ArrSuffix(1 + e.op);
        }
        if (e.kind == AK.CastExpr() && e.type != null) { return e.type.sval; }
        if (e.kind == AK.AsExpr() && e.type != null) { return e.type.sval; }
        if (e.kind == AK.AwaitExpr()) { return AsyncAwaitElemTyNg(e.a); }
        if (e.kind == AK.TupleExpr()) { return TupleExprMangledNg(e); }
        if (e.kind == AK.MemberAccess() && (e.sval == "IsCompleted" || e.sval == "Result")) {
            string tt2 = StaticTyOf(e.a);
            if (tt2 != null && (tt2 == "Task" || tt2.IndexOf("Task<") == 0)) {
                if (e.sval == "IsCompleted") { return "int"; }
                int lt2 = tt2.IndexOf("<");
                if (lt2 > 0) { return tt2.Substring(lt2 + 1, tt2.Length - lt2 - 2); }
                return "int";
            }
        }
        if (e.kind == AK.MemberAccess()) {
            string rmt = ReflMemberTy(e);
            if (rmt != null) { return rmt; }
        }
        if (e.kind == AK.Ident()) { return NamedSlotTy(e.sval); }
        if (e.kind == AK.Call()) {
            // `a?.M(...)` (callee marker ival==1): a value return lifts to
            // T? like the member form, so the decl/assignment boundary
            // never boxes the already-boxed cell twice
            if (e.a != null && e.a.kind == AK.MemberAccess() && e.a.ival == 1) {
                e.a.ival = 0;
                string crt = CallRetTy(e);
                e.a.ival = 1;
                if (crt != null && IsNulableValueTy(crt)) { return crt + "?"; }
                return crt;
            }
            return CallRetTy(e);
        }
        if (e.kind == AK.MemberAccess()) {
            // null-conditional `a?.m` (parser marker ival==1): a value-typed
            // member result lifts to T? exactly like the oracle's
            // null_cond_result_type; references stay raw
            if (e.ival == 1) {
                e.ival = 0;
                string qmt = StaticTyOfInner(e);
                e.ival = 1;
                if (qmt != null && IsNulableValueTy(qmt)) { return qmt + "?"; }
                return qmt;
            }
            // primitive-type constants type as their primitive
            // (double.MaxValue prints as a double)
            if (PrimitiveConstLit(e) != null) {
                if (e.a.sval == "double" || e.a.sval == "float" || e.a.sval == "Math") { return "double"; }
                if (e.a.sval == "long") { return "long"; }
                if (e.a.sval == "ulong") { return "ulong"; }
                if (e.a.sval == "char") { return "char"; }
                return "int";
            }
            if ((e.sval == "Keys" || e.sval == "Values") && ExprCls(e.a) == "Dict") {
                return "List<" + DictSlotTy(e.a, e.sval == "Keys") + ">";
            }
            // span view member: Length is the boxed view length
            if (e.sval == "Length" && SpanContainerTy(e.a) != null) { return "int"; }
            // nullable payload members: HasValue is bool, Value the payload
            if (e.sval == "HasValue" || e.sval == "Value") {
                string nrt = e.a != null ? StaticTyOf(e.a) : null;
                if (nrt != null && IsNulTy(nrt)) {
                    if (e.sval == "HasValue") { return "bool"; }
                    if (e.sval == "Value") { return NulPayOf(nrt); }
                }
            }
            // EnumType.Member constants carry their enum identity
            if (e.a != null && e.a.kind == AK.Ident() && FindEnum(e.a.sval) >= 0) { return e.a.sval; }
            Fld f = FieldOf(e);
            if (f != null) { return f.ty; }
            // qualified static field read: ClsName.field carries the
            // field's declared type (Store.items.Count)
            if (e.a != null && e.a.kind == AK.Ident() && LocalIdx(e.a.sval) < 0
                    && FindClass(e.a.sval) != null) {
                string qst = FindStaticTy(QualifiedCls(e.a.sval, e.sval2), e.sval);
                if (qst != null) { return qst; }
            }
            return PropGetterTy(e);
        }
        if (e.kind == AK.Index()) { return ElemTyOf(e); }
        return null;
    }

    // declared type of an instance property read (obj.Prop with no backing
    // field): resolve the desugared get_Prop accessor in the receiver's
    // class chain and substitute generic arguments
    // (KeyValuePair<string,int>.Key -> string). Only Ident/this receivers
    // are typed -- cheap slot lookups; chaining into deeper expressions
    // would re-walk fluent prefixes from every StaticTyOf query.
    string PropGetterTy(Node mem) {
        if (mem == null || mem.kind != AK.MemberAccess()) { return null; }
        if (mem.a == null) { return null; }
        // ClsName.Prop: the desugared static getter carries the declared type
        // (Encoding.UTF8 types as Encoding)
        if (mem.a.kind == AK.Ident() && LocalIdx(mem.a.sval) < 0 && FindClass(mem.a.sval) != null) {
            Node sg = AccessorInChain(mem.a.sval, "get_" + mem.sval);
            if (sg != null && sg.type != null && HasMod(sg, MOD.Static())) { return TypeFullName(sg.type); }
        }
        string recvTy = StaticTyOf(mem.a);
        if (recvTy == null) { return null; }
        string cn = ClassTyOf(recvTy);
        if (cn == null) { return null; }
        Node gm = AccessorInChain(cn, "get_" + mem.sval);
        if (gm == null || gm.type == null) { return null; }
        string rty = TypeFullName(gm.type);
        int lt = recvTy.IndexOf("<");
        Cls rc = FindClass(cn);
        if (lt <= 0 || rc == null || rc.tps.Count == 0) { return rty; }
        List<string> targs = SplitTyArgs(recvTy.Substring(lt + 1, recvTy.Length - lt - 2));
        return SubstTy(rty, rc.tps, targs);
    }

    // map an interpolation format specifier to a printf pattern, mirroring
    // gen0's interp_format_to_printf exactly (the conformance suite pins the
    // mapping); "" means the default rendering
    string FormatSpecToPrintf(string spec, bool isUlong) {
        if (spec == null || spec.Length == 0) { return ""; }
        string code = spec.Substring(0, 1);
        int digits = 0;
        int i = 1;
        while (i < spec.Length) {
            int d = spec[i] - 48;
            if (d >= 0 && d <= 9) { digits = digits * 10 + d; }
            i = i + 1;
        }
        if (code == "D" || code == "d") {
            // decimal, zero-padded to `digits`
            if (isUlong) { return digits <= 0 ? "" : "%0" + Convert.ToString(digits) + "llu"; }
            return digits <= 0 ? "" : "%0" + Convert.ToString(digits) + "lld";
        }
        if (code == "X" || code == "x") {
            // hex (upper/lower), zero-padded to `digits`
            return digits <= 0 ? "" : "%0" + Convert.ToString(digits) + "llX";
        }
        if (code == "F" || code == "f") { return "%." + Convert.ToString(digits) + "lf"; }
        if (code == "E" || code == "e") { return "%." + Convert.ToString(digits) + "E"; }
        if (code == "G" || code == "g") {
            // general: default is the shortest round-trip render; a digit
            // count means significant digits ({v:G3} -> %.3g)
            return digits > 0 ? "%." + Convert.ToString(digits) + "g" : "";
        }
        if (code == "0" || code == "#") {
            // custom numeric: 0 = required digit, # = optional
            int ipad = 0;
            int frac = 0;
            bool afterDot = false;
            bool haveDot = false;
            i = 0;
            while (i < spec.Length) {
                string ch = spec.Substring(i, 1);
                if (ch == ".") { afterDot = true; haveDot = true; }
                else if (ch == "0" || ch == "#") {
                    if (afterDot) { frac = frac + 1; }
                    else if (ch == "0") { ipad = ipad + 1; }
                }
                i = i + 1;
            }
            if (haveDot) { return "%." + Convert.ToString(frac) + "lf"; }
            if (ipad > 0) {
                string u = isUlong ? "llu" : "lld";
                return "%0" + Convert.ToString(ipad) + u;
            }
            return "";
        }
        return "";                             // unrecognized: default format
    }

    // does the mapped printf pattern render as a double (fixed/scientific
    // spec on an integer widens it first, like C#)?
    bool SpecWantsDouble(string spec) {
        if (spec == null || spec.Length == 0) { return false; }
        string code = spec.Substring(0, 1);
        if (code == "F" || code == "f" || code == "E" || code == "e") { return true; }
        if (code == "0" || code == "#") {
            int i = 0;
            while (i < spec.Length) {
                if (spec.Substring(i, 1) == ".") { return true; }
                i = i + 1;
            }
        }
        return false;
    }

    // scalar x.ToString("spec"): the compiler-mapped printf render (the
    // lexer splice turns an interpolation hole `{v:D4}` into
    // `v.ToString("D4")`). bool/string/char ignore the spec like gen0;
    // int-family receivers widen to double for fixed/scientific patterns.
    void GenScalarToStringFmt(Node e, Node recv, string spec) {
        string sty = ScalarToStringTy(recv);
        if (sty == "bool") {
            GenExpr(recv);
            int fls = NL();
            int doneb = NL();
            CbzReg(0, fls);
            LoadStr(InternStr("true"), 0);
            EmitB(doneb);
            Mark(fls);
            LoadStr(InternStr("false"), 0);
            Mark(doneb);
            return;
        }
        if (sty == "string") { GenExpr(recv); return; }
        if (sty == "char") {
            GenExpr(recv);
            BLInternal("_zan_rt_chrstr");
            return;
        }
        // gen0's is_float rule: a double receiver ignores decimal/hex
        // padding specs (D/X) and renders with the default path
        string c0 = spec != null && spec.Length > 0 ? spec.Substring(0, 1) : "";
        bool dblNoFmt = sty == "double"
            && (c0 == "D" || c0 == "d" || c0 == "X" || c0 == "x");
        string pf = dblNoFmt ? "" : FormatSpecToPrintf(spec, sty == "ulong");
        if (pf == "") {
            // default rendering: the plain paths
            if (sty == "double") {
                GenExpr(recv);
                BLInternal("_zan_rt_dbl2str");
            } else if (sty == "ulong") {
                GenExpr(recv);
                BLInternal("_zan_rt_uint2str");
            } else {
                GenExpr(recv);
                BLInternal("_zan_rt_int2str");
            }
            return;
        }
        GenExpr(recv);
        // gen0 widens an integer receiver to double for fixed/scientific
        // patterns (its SIToFP sees the same signed bits scvtf does)
        if (SpecWantsDouble(spec) && (sty == "int" || sty == "ulong")) { ConvI2D(); }
        LoadStr(InternStr(pf), 1);
        BLInternal("_zan_rt_fmt");
    }

    // the struct class when the expression is struct-typed, else null
    Cls StructOf(Node e) {
        string t = StaticTyOf(e);
        if (t == null) { return null; }
        // 批47:实例化泛型 struct 优先取替换视图 —— 擦除(FindClass→开
        // 模板)叶类型擦成 "T1/T2",等值的 double 叶会丢 IEEE 语义
        // (fmov/fcmp 走不上);视图给回精确叶型。批49:按需建视图,
        // struct 实参形状也入视图;递归/基类/虚形状落回擦除,箱语义照旧。
        if (t.IndexOf("<") > 0) {
            Cls vc = StructInstViewOf(t);
            if (vc != null) { return vc; }
        }
        Cls c = FindClass(t);
        return c != null && c.isStruct == 1 ? c : null;
    }

    // 批47:实例化泛型 struct 的代码生成端回退 —— 只认布局期已批准并
    // 缓存的替换视图。布局期拒掉的形状(递归、基类/虚、显式布局)在
    // 箱语义下照旧合法,这里静默回退 null。
    Cls StructInstViewCached(string ty) {
        if (instViewKeys == null) { return null; }
        int vi = IndexOfStrNg(instViewKeys, ty);
        return vi >= 0 ? instViewVals[vi] : null;
    }

    // 批49:按需建视图 —— 布局二遍只为类字段里出现的实例化建视图;
    // 只在方法签名/体里出现的实例化(new Pair<Pt,long>(...))在此补建,
    // 守卫(基类/虚/显式布局/递归)与布局期同一套,建不成回 null。
    Cls StructInstViewOf(string ty) {
        if (ty == null) { return null; }
        int lt = ty.IndexOf("<");
        if (lt <= 0 || ty.Substring(ty.Length - 1, 1) != ">") { return null; }
        Cls vc = StructInstViewCached(ty);
        if (vc != null) { return vc; }
        List<string> stack = new List<string>();
        return StructExpandTy(ty, stack);
    }

    // 批49:类型全名的特化解析 —— 实例化泛型 struct 优先替换视图
    // (箱载荷 = 特化布局),其余照旧擦除解析。所有 struct 箱分配点
    // (声明/new/克隆/with)经此取形状,与 FieldOfInst 视图优先对表。
    Cls SpecClsOf(string ty) {
        if (ty == null || ty == "") { return null; }
        if (ty.IndexOf("<") > 0) {
            Cls vc = StructInstViewOf(ty);
            if (vc != null) { return vc; }
        }
        return FindClass(ty);
    }

    // the shared struct type when BOTH operands are the same struct, else
    // null (guards field-wise ==/!= emission)
    // null coalescing only lowers when the left operand's null really is 0:
    // reference shapes (string, class/interface, array, List/Dict/Task)
    bool QQRefShapeNg(Node a) {
        if (a == null) { return false; }
        if (IsStrExpr(a)) { return true; }
        string t = StaticTyOf(a);
        if (t == null) { return false; }
        if (ClassTyOf(t) != null) { return true; }
        return t == "object" || t == "ptr"
            || (t.Length > 2 && t.Substring(t.Length - 2, 2) == "[]")
            || t.IndexOf("List<") == 0 || IsDictTyName(t)
            || t.IndexOf("Task") == 0;
    }

    Cls StructEqPair(Node a, Node b) {
        Cls sa = StructOf(a);
        if (sa == null) { return null; }
        Cls sb = StructOf(b);
        if (sb == null || sb != sa) { return null; }
        return sa;
    }

    // struct value semantics: when expression e is struct-typed, replace x0
    // with a fresh copy of the object (gen0 keeps structs inline with value
    // semantics; ngen models them as heap objects, so every slot a struct
    // lands in -- assignment, initialization, argument, return -- copies).
    // The clone duplicates the descriptor word (class site) and all fields.
    void GenCloneIfStruct(Node e) {
        string t = StaticTyOf(e);
        Cls c = t != null ? SpecClsOf(t) : null;
        if (c == null || c.isStruct != 1) { return; }
        GenCloneStructCls(c);
    }

    // x0 = fresh heap copy of the struct box in x0 (the box pointer travels
    // with a 16-byte header; the clone duplicates header + payload)
    void GenCloneStructCls(Cls c) {
        XPushV0();                          // push src BEFORE x0 is reused
        LoadImm(0, c.size + 16);
        LoadImm(1, 0);
        BLInternal("_zan_rt_alloc");             // x0 = dst
        XPopV(1);                          // pop src -> x1
        LoadImm(2, c.size + 16);
        SubImm(0, 0, 8);                         // dst - 8 (descriptor)
        SubImm(1, 1, 8);                         // src - 8
        BLExtern("_memcpy");
        AddImm(0, 0, 8);                         // x0 = dst
    }

    // ---- 批43:嵌套 struct 值字段(扁平展开)----
    // the concrete struct a field's flattened region holds, else null
    // (批47:expCls 是布局期落下的单一真源 —— 实例化泛型字段的替换视图
    // 只在这里可达,按 ty 串 FindClass 对带 < 的名字必 null)
    Cls ExpandedStructOf(Fld f) {
        if (f == null || f.expanded != true) { return null; }
        if (f.expCls != null) { return f.expCls; }
        return FindClass(f.ty);
    }

    // is every link of this member chain an expanded struct value field
    // (so the chain is offset arithmetic into the root's payload, never a
    // dereference)? An Ident naming an expanded instance field counts as a
    // one-link chain through `this`; a local/static/call root with an
    // expanded first link is fine -- offsets apply to the evaluated value
    bool ChainIsExpanded(Node prefix) {
        Node cur = prefix;
        while (cur != null && cur.kind == AK.MemberAccess()) {
            Fld cf = FieldOf(cur);
            if (cf == null || ExpandedStructOf(cf) == null) { return false; }
            cur = cur.a;
        }
        if (cur == null) { return false; }
        if (cur.kind == AK.Ident()) {
            if (LocalIdx(cur.sval) >= 0) { return true; }
            if (FindStaticSym(curCls, cur.sval) != null) { return true; }
            Fld rf = CurField(cur.sval);
            return rf != null && ExpandedStructOf(rf) != null;
        }
        return true;
    }

    // x0 = the absolute payload base of a nested struct value region: the
    // root receiver evaluates once, then every expanded link adds its
    // offset -- no dereference, no copy (stores and addresses land in the
    // parent's own payload). Call only when ChainIsExpanded(prefix).
    void GenNestedRegionAddr(Node prefix) {
        List<Node> links = new List<Node>();
        Node cur = prefix;
        while (cur != null && cur.kind == AK.MemberAccess()) {
            links.Add(cur);
            cur = cur.a;
        }
        GenExpr(cur);
        int k = links.Count - 1;                 // outermost link first
        while (k >= 0) {
            Fld cf = FieldOf(links[k]);
            if (cf != null) {
                if (cf.off <= 4095) { AddImm(0, 0, cf.off); }
                else { LoadImm(16, cf.off); AddRR(0, 0, 16); }
            }
            k = k - 1;
        }
    }

    // x0 = receiver (already null-guarded by the caller) -> x0 = a fresh
    // box whose payload is the receiver's flattened sub-struct region.
    // Value reads materialize a copy so later member writes can never
    // reach back into the parent.
    void MaterializeNestedBox(Cls nc, Fld f) {
        XPushV0();                              // hold recv
        LoadImm(0, nc.size + 16);
        LoadImm(1, 0);
        BLInternal("_zan_rt_alloc");             // x0 = box
        XPopV(1);                              // x1 = recv
        XPushV0();                              // hold box
        if (f.off <= 4095) { AddImm(1, 1, f.off); }
        else { LoadImm(16, f.off); AddRR(1, 1, 16); }
        LoadImm(2, nc.size);
        BLExtern("_memcpy");                    // memcpy(dst=box, src=recv+off, n)
        XPopV(0);                              // x0 = box
    }

    // 批43:flatten a struct's value fields into leaf slots (absolute
    // offsets, width-8 synthetic Flds) for field-wise equality and array
    // Contains; non-expanded fields (class/string/array boxes and legacy
    // slots) come through as single slots -- exactly the pre-批43
    // behavior for those shapes
    void FlatValueFields(Cls c, List<Fld> outF, int baseOff, List<string> stack) {
        if (IndexOfStrNg(stack, c.name) >= 0) { return; }
        List<string> ns = new List<string>();
        int si = 0;
        while (si < stack.Count) { ns.Add(stack[si]); si = si + 1; }
        ns.Add(c.name);
        int k = 0;
        while (k < c.flds.Count) {
            Fld f = c.flds[k];
            Cls nc = ExpandedStructOf(f);
            if (nc != null) { FlatValueFields(nc, outF, baseOff + f.off, ns); }
            else { outF.Add(new Fld(f.name, baseOff + f.off, f.ty)); }
            k = k + 1;
        }
    }

    // ---- generic method monomorphization ----
    // A generic method's body is per-instantiation: calls that carry explicit
    // type arguments get a specialized copy (type parameters substituted with
    // the concrete classes) under a mangled name, and the call site is
    // rewritten to that name. Worklist order handles nested generic calls
    // inside specialized bodies.

    bool HasTypeParams(Node m) {
        int i = 0;
        while (i < m.kids.Count) {
            if (m.kids[i].kind == AK.TypeParam()) { return true; }
            i = i + 1;
        }
        return false;
    }

    Node CloneNode(Node n) {
        if (n == null) { return null; }
        Node c = new Node(n.kind);
        c.sval = n.sval;
        c.sval2 = n.sval2;
        c.ival = n.ival;
        c.op = n.op;
        c.mods = n.mods;
        c.layoutExplicit = n.layoutExplicit;
        c.fieldOffset = n.fieldOffset;
        c.line = n.line;
        c.col = n.col;
        c.type = CloneNode(n.type);
        c.a = CloneNode(n.a);
        c.b = CloneNode(n.b);
        c.c = CloneNode(n.c);
        c.d = CloneNode(n.d);
        int i = 0;
        while (i < n.kids.Count) { c.Add(CloneNode(n.kids[i])); i = i + 1; }
        return c;
    }

    // rewrite type-parameter names inside type references of a cloned body
    void SubstTypeNode(Node n, List<string> tps, List<string> args) {
        if (n == null) { return; }
        if (n.kind == AK.TypeRef() && n.sval != null) {
            int pi = IndexOfStrNg(tps, n.sval);
            if (pi >= 0 && pi < args.Count) { n.sval = args[pi]; }
        }
        SubstTypeNode(n.type, tps, args);
        SubstTypeNode(n.a, tps, args);
        SubstTypeNode(n.b, tps, args);
        SubstTypeNode(n.c, tps, args);
        SubstTypeNode(n.d, tps, args);
        if (n.kind == AK.MemberAccess() && n.sval2 != null && n.sval2 != ""
                && n.a != null && n.a.kind == AK.Ident()) {
            // class-qualified static access inside a spec body: rewrite
            // `Stat<T>.s` to the concrete instantiation `Stat<double>.s`
            string s2 = n.sval2;
            int i = 0;
            while (i < tps.Count && i < args.Count) {
                s2 = s2.Replace("__" + tps[i], "__" + args[i])
                      .Replace(tps[i] + "__", args[i] + "__");
                if (s2 == tps[i]) { s2 = args[i]; }
                i = i + 1;
            }
            n.a.sval = n.a.sval + "<" + Undunder(s2) + ">";
            n.sval2 = null;
            RegisterInstCls(n.a.sval);
        }
        int i2 = 0;
        while (i2 < n.kids.Count) { SubstTypeNode(n.kids[i2], tps, args); i2 = i2 + 1; }
    }

    List<string> specMeth;  // mangled names of registered specializations
    List<string> instCls;   // instantiated generic classes in use ("Stat<int>")
    List<string> ctorSpecKey;  // per-instantiation ctor specs built ("Inst$di")
    List<string> ctorSpecSym;  // emit symbol of the matching ctor spec

    // find the generic method declaration for a call name: an instance or
    // static method with type parameters; first match wins
    // is this a concrete type name (class, enum, primitive, container of
    // those)? open type parameters like "T" resolve to nothing
    bool KnownTyName(string t) {
        if (t == null || t == "") { return false; }
        if (IsArrTy(t)) { return KnownTyName(t.Substring(0, t.Length - 2)); }
        int lt = t.IndexOf("<");
        if (lt > 0) {
            if (t.Substring(t.Length - 1, 1) != ">") { return false; }
            List<string> inner = SplitTyArgs(t.Substring(lt + 1, t.Length - lt - 2));
            int i = 0;
            while (i < inner.Count) {
                if (!KnownTyName(inner[i])) { return false; }
                i = i + 1;
            }
            t = t.Substring(0, lt);
        }
        if (t == "int" || t == "long" || t == "ulong" || t == "double"
                || t == "bool" || t == "char" || t == "string" || t == "object"
                || t == "byte" || t == "sbyte" || t == "short" || t == "ushort"
                || t == "uint" || t == "float" || t == "nint") { return true; }
        if (t == "List") { return true; }
        return FindClass(t) != null;
    }

    List<string> DeclTps(Node m) {
        List<string> tps = new List<string>();
        int k = 0;
        while (k < m.kids.Count) {
            if (m.kids[k].kind == AK.TypeParam()) { tps.Add(m.kids[k].sval); }
            k = k + 1;
        }
        return tps;
    }

    // resolve name+type-args to a specialization: register the mangled copy
    // on first use and rewrite the call site's callee to the mangled name.
    // Open type parameters as arguments mean the call lives in an
    // unspecialized template body -- skip; the template's own
    // specialization re-scans with concrete args. `di` is the declaration
    // to instantiate, scoped by the caller (the receiver's own chain, or
    // the global bare-name rule for extension methods) so a same-named
    // method in an unrelated class is never hijacked.
    // how many same-name GENERIC declarations exist: an overload family
    // whose members differ only in parameter types (KeySelector vs
    // StrKeySelector selectors) needs distinct spec symbols
    int GenericOverloadCountNg(string name) {
        List<int> cs = MethCandsName(name);
        if (cs == null) { return 0; }
        int n = 0;
        int i = 0;
        while (i < cs.Count) {
            if (methStat[cs[i]] != 2 && methStat[cs[i]] != 3 && HasTypeParams(methNodes[cs[i]])) { n = n + 1; }
            i = i + 1;
        }
        return n;
    }

    // symbol-safe tag of a (substituted) type text for spec-name suffixes
    string TySymTagNg(string t) {
        if (t == null) { return ""; }
        return t.Replace("<", ".").Replace(">", "").Replace(",", ".").Replace(" ", "");
    }

    void SpecRegister(string name, List<string> args, Node callNode, int di) {
        if (IndexOfStrNg(specMeth, name) >= 0) {
            if (callNode.a != null) { callNode.a.sval = name; callNode.a.b = null; }
            return;
        }
        int dollar = name.IndexOf("$");
        if (dollar >= 0) {
            name = name.Substring(0, dollar);
        }
        bool open = false;
        int oi = 0;
        while (oi < args.Count) {
            if (!KnownTyName(args[oi])) { open = true; }
            oi = oi + 1;
        }
        if (open || di < 0) { return; }
        Node decl = methNodes[di];
        // the call may sit on an instantiated generic receiver
        // (`ps.Pair<int>(3)` with ps: Pool<string>): carry that
        // instantiation on the spec so its `this`-relative field types
        // resolve (CurField reads sval2) and its declared locals substitute
        // (CurDeclTyNg). A bare call inside a scanned spec body inherits
        // the body's own receiver instantiation (`Wrap<U>(x)` inside
        // Pool<string>.Chain<U>): the open template saw no receiver -- but
        // only when the declaration belongs to that very class, so a
        // bare-name match in an unrelated class (extension methods) never
        // reads this class's type arguments into its body. The
        // instantiation joins the spec NAME: the method's own type
        // arguments alone collide across class instantiations
        // (Pool<string>.Wrap<int> and Pool<int>.Wrap<int> are different
        // coroutines) and the first registered body would win every call
        // site.
        string rt = null;
        bool instOwned = false;
        if (callNode.a != null && callNode.a.kind == AK.MemberAccess()
                && callNode.a.a != null) {
            rt = StaticTyOf(callNode.a.a);
            instOwned = true;
        } else if (specScanMeth != null && specScanMeth.sval2 != null
                && specScanMeth.sval2 != "") {
            rt = specScanMeth.sval2;
            if (rt.IndexOf("<") > 0) { instOwned = methCls[di] == rt.Substring(0, rt.IndexOf("<")); }
        }
        string instTag = null;
        if (rt != null && instOwned && rt.IndexOf("<") > 0
                && FindClass(rt.Substring(0, rt.IndexOf("<"))) != null) {
            instTag = TySymTagNg(rt);
        } else { rt = null; }
        string mangled = name + "$";
        int mj = 0;
        while (mj < args.Count) {
            if (mj > 0) { mangled = mangled + "__"; }
            mangled = mangled + args[mj];
            mj = mj + 1;
        }
        if (instTag != null) { mangled = mangled + "$" + instTag; }
        // same-named generic overloads must not share one spec symbol:
        // the first registered body would win every call site regardless
        // of which overload each site resolved to
        if (GenericOverloadCountNg(name) > 1) {
            mangled = mangled + "_o";
            List<string> dtps = DeclTps(decl);
            int pk = 0;
            while (pk < decl.kids.Count) {
                Node pp = decl.kids[pk];
                if (pp.kind == AK.Param() && pp.type != null) {
                    string ptx = TypeFullName(pp.type);
                    if (ptx != null) { mangled = mangled + TySymTagNg(SubstTy(ptx, dtps, args)); }
                }
                pk = pk + 1;
            }
        }
        if (MethCandsClsName(methCls[di], mangled) == null) {
            List<string> tps = DeclTps(decl);
            Node spec = CloneNode(decl);
            if (spec == null) { spec = new Node(decl.kind); }
            int nk = 0;
            while (nk < spec.kids.Count) {
                if (spec.kids[nk].kind == AK.TypeParam()) { spec.kids.RemoveAt(nk); }
                else { nk = nk + 1; }
            }
            spec.sval = mangled;
            SubstTypeNode(spec, tps, args);
            if (instTag != null) {
                spec.sval2 = rt;
                RegisterInstCls(rt);
            }
            AddMethNg(spec, methCls[di], methStat[di]);
            if (IndexOfStrNg(specMeth, mangled) < 0) { specMeth.Add(mangled); }
        }
        callNode.a.sval = mangled;
        callNode.a.b = null;
    }

    // "__"-joined type-arg string back to comma form ("int__double" -> "int,double")
    string Undunder(string s) {
        return s.Replace("__", ",");
    }

    // class-qualified name including instantiation args when present
    // ("Stat" + "int" -> "Stat<int>")
    string QualifiedCls(string cls, string sval2) {
        if (sval2 != null && sval2 != "") { return cls + "<" + Undunder(sval2) + ">"; }
        return cls;
    }

    void RegisterInstCls(string instName) {
        if (IndexOfStrNg(instCls, instName) < 0) { instCls.Add(instName); }
    }

    // specialize method methName of the instantiated generic class instName
    // ("Pool<Conn>") for the class's type parameters, rewriting the call site
    void SpecRegisterClass(string instName, string methName, bool isStatic, Node callNode) {
        if (IndexOfStrNg(specMeth, methName) >= 0) {
            if (callNode.a != null) { callNode.a.sval = methName; }
            return;
        }
        int dollar = methName.IndexOf("$");
        if (dollar >= 0) {
            methName = methName.Substring(0, dollar);
        }
        int lt = instName.IndexOf("<");
        if (lt <= 0) { return; }
        string open = instName.Substring(0, lt);
        Cls c = FindClass(open);
        if (c == null || c.tps.Count == 0) { return; }
        int wantStat = isStatic ? 1 : 0;
        // Rank the original overload set BEFORE rewriting the callee. A
        // generic receiver can still select an inherited non-generic method
        // (Box<T>.Add(Item<T>) versus Node.Add(Node)). Specializing the first
        // name match hides the base overload from later call resolution.
        List<int> cands = new List<int>();
        string owner = open;
        while (owner != null) {
            List<int> cs = MethCandsClsName(owner, methName);
            if (cs != null) {
                int i = 0;
                while (i < cs.Count) {
                    if (methStat[cs[i]] == wantStat && !HasTypeParams(methNodes[cs[i]])) { cands.Add(cs[i]); }
                    i = i + 1;
                }
            }
            Cls oc = FindClass(owner);
            owner = oc != null ? oc.baseName : null;
        }
        int di = FitPickIdx(cands, callNode);
        if (di < 0 || methCls[di] != open) { return; }
        // Include the declaring class and selected declaration: overloads
        // and same-named methods in other classes must not share a cache key.
        string mangled = methName + "$" + instName + "$" + di;
        if (IndexOfStrNg(specMeth, mangled) >= 0) {
            if (callNode.a != null) { callNode.a.sval = mangled; }
            return;
        }
        List<string> args = SplitTyArgs(instName.Substring(lt + 1, instName.Length - lt - 2));
        Node spec = CloneNode(methNodes[di]);
        if (spec == null) { spec = new Node(methNodes[di].kind); }
        spec.sval = mangled;
        if (!isStatic) { spec.sval2 = instName; }   // spec's `this` type
        SubstTypeNode(spec, c.tps, args);
        AddMethNg(spec, open, wantStat);         // dispatch walks the open name
        specMeth.Add(mangled);
        if (callNode.a != null) { callNode.a.sval = mangled; }
    }

    // emit symbol of a per-instantiation ctor spec: the instantiation
    // keeps the class unique; multi-ctor classes append the substituted
    // param tags exactly like CtorSymNg (an empty tag run stays "__")
    string CtorSpecSymOf(string instName, string cls, Node spec) {
        string sym = "_" + instName + "_ctor";
        if (CtorCountNg(cls) > 1) {
            sym = sym + "__";
            int pk = 0;
            while (pk < spec.kids.Count) {
                Node p = spec.kids[pk];
                if (p.kind == AK.Param()) { sym = sym + "_" + TypeTagNg(p.type); }
                pk = pk + 1;
            }
        }
        return sym;
    }

    // open class name of an instantiation ("Transfer<string>" -> "Transfer")
    string QualifiedClsNameNg(string instName) {
        int lt = instName.IndexOf("<");
        return lt > 0 ? instName.Substring(0, lt) : instName;
    }

    // per-instantiation ctor specialization. Generic-class ctors are
    // templates too: the open ctor is compiled once with erasure, so any
    // type-sensitive lowering inside it degrades to the reference form and
    // value-type instantiations misbehave at runtime. Mirror
    // SpecRegisterClass for stat-2 methods: clone+substitute per
    // instantiation, emit under a per-instantiation symbol.
    string InstCtorSpecNg(string instName, string cls, Cls c, int cix) {
        string key = instName + "$" + cix;
        int hit = IndexOfStrNg(ctorSpecKey, key);
        if (hit >= 0) { return ctorSpecSym[hit]; }
        int lt = instName.IndexOf("<");
        List<string> args = SplitTyArgs(instName.Substring(lt + 1, instName.Length - lt - 2));
        bool open = false;
        int oi = 0;
        while (oi < args.Count) {
            if (!KnownTyName(args[oi])) { open = true; }
            oi = oi + 1;
        }
        string sym = CtorSymNg(cls, methNodes[cix]);
        if (!open) {
            Node spec = CloneNode(methNodes[cix]);
            if (spec == null) { spec = new Node(methNodes[cix].kind); }
            int nk = 0;
            while (nk < spec.kids.Count) {
                if (spec.kids[nk].kind == AK.TypeParam()) { spec.kids.RemoveAt(nk); }
                else { nk = nk + 1; }
            }
            spec.sval = instName;    // unique "class name" per instantiation
            spec.sval2 = instName;   // spec's `this` type: field types substitute
            SubstTypeNode(spec, c.tps, args);
            sym = CtorSpecSymOf(instName, cls, spec);
            AddMethNg(spec, cls, 2);   // dispatch walks the open name
            ctorSpecKey.Add(key);
            ctorSpecSym.Add(sym);
        }
        return sym;
    }

    int FindGenericDecl(string name) {
        List<int> cs = MethCandsName(name);
        if (cs == null) { return -1; }
        int i = 0;
        while (i < cs.Count) {
            int mi = cs[i];
            if (methStat[mi] != 2 && methStat[mi] != 3 && HasTypeParams(methNodes[mi])) { return mi; }
            i = i + 1;
        }
        return -1;
    }

    // strip an instantiation suffix ("Pool<Conn>" -> "Pool") for table walks
    string OpenClsNameNg(string t) {
        if (t == null) { return null; }
        int lt = t.IndexOf("<");
        return lt > 0 ? t.Substring(0, lt) : t;
    }

    // the class a call's receiver scopes resolution to: explicit receivers
    // use their static type, bare calls the enclosing class (an instance
    // body via `this`, a static body directly)
    string SpecRecvClsNg(Node call) {
        if (call.a.kind == AK.MemberAccess() && call.a.a != null) {
            string rc = StaticTyOf(call.a.a);
            if (rc == null) { rc = ExtRecvLitTy(call.a.a); }
            if (rc == null && call.a.a.kind == AK.Ident()
                    && FindClass(call.a.a.sval) != null) {
                return call.a.a.sval;    // class-qualified static call
            }
            return OpenClsNameNg(rc);
        }
        if (call.a.kind == AK.Ident()) { return curCls; }
        return null;
    }

    // first generic declaration of `name` on the receiver's class chain --
    // normal scoping: the receiver, not the global bare name, selects the
    // overload set. -1 when the chain declares no generic of that name.
    int OwnedGenericDeclNg(Node call, string name) {
        string rc = SpecRecvClsNg(call);
        while (rc != null) {
            List<int> cs = MethCandsClsName(rc, name);
            if (cs != null) {
                int i = 0;
                while (i < cs.Count) {
                    int mi = cs[i];
                    if (methStat[mi] != 2 && methStat[mi] != 3 && HasTypeParams(methNodes[mi])) { return mi; }
                    i = i + 1;
                }
            }
            Cls oc = FindClass(rc);
            rc = oc != null ? oc.baseName : null;
        }
        return -1;
    }

    // does the receiver's class chain declare `name` at all (any overload)?
    bool ReceiverHasNameNg(Node call, string name) {
        string rc = SpecRecvClsNg(call);
        while (rc != null) {
            List<int> cs = MethCandsClsName(rc, name);
            if (cs != null && cs.Count > 0) { return true; }
            Cls oc = FindClass(rc);
            rc = oc != null ? oc.baseName : null;
        }
        return false;
    }

    // the receiver-scoped generic decl of `name` whose parameter count
    // accepts the call's written arguments. Same-name generic OVERLOADS
    // differ in arity -- Enumerable.Contains<T> has (this, T) and
    // (this, T, EqualityComparer<T>) -- and the first match must not win
    // blindly. The extension's `this` slot counts ONLY in instance form
    // (`xs.Contains<T>(x)`): class-qualified (`Enumerable.Contains<T>(xs, x)`)
    // and bare calls pass every parameter 1:1.
    int OwnedGenericDeclArityNg(Node n, string name, int argc) {
        bool extForm = n.a != null && n.a.kind == AK.MemberAccess()
            && !(n.a.a != null && n.a.a.kind == AK.Ident() && FindClass(n.a.a.sval) != null);
        string rc = SpecRecvClsNg(n);
        while (rc != null) {
            List<int> cs = MethCandsClsName(rc, name);
            if (cs != null) {
                int i = 0;
                while (i < cs.Count) {
                    int mi = cs[i];
                    if (methStat[mi] != 2 && methStat[mi] != 3 && HasTypeParams(methNodes[mi])) {
                        int extra = extForm && methNodes[mi].ival == 1 && methStat[mi] == 1 ? 1 : 0;
                        if (ParamCount(methNodes[mi]) == argc + extra) { return mi; }
                    }
                    i = i + 1;
                }
            }
            Cls oc = FindClass(rc);
            rc = oc != null ? oc.baseName : null;
        }
        return -1;
    }

    int inferDi;       // planned decl for the next inference registration
    List<string> inferArgs; // planned inferred type arguments (per decl tp)

    string uniTp;    // the single type parameter being inferred
    string uniBind;  // its first binding, or null

    // one structural unification step against the inferred type parameter
    // (gen0's unify_method_tp): a bare type parameter binds (first binding
    // wins); array/nullable shapes unwrap, then type arguments unify
    // POSITIONALLY -- gen0 never compares generic head names, so a
    // delegate-typed argument (`Conv<int,int>` for a `Selector<T,R>`
    // parameter) binds through its argument list
    void UnifyMethodTp(string dp, string at) {
        if (dp == null || at == null || uniBind != null) { return; }
        if (dp == uniTp) { uniBind = at; return; }
        while (dp.Length > 2 && at.Length > 2
                && dp.Substring(dp.Length - 2, 2) == "[]"
                && at.Substring(at.Length - 2, 2) == "[]") {
            dp = dp.Substring(0, dp.Length - 2);
            at = at.Substring(0, at.Length - 2);
        }
        if (dp.Length > 1 && at.Length > 1
                && dp.Substring(dp.Length - 1, 1) == "?"
                && at.Substring(at.Length - 1, 1) == "?") {
            dp = dp.Substring(0, dp.Length - 1);
            at = at.Substring(0, at.Length - 1);
        }
        int lt = dp.IndexOf("<");
        int la = at.IndexOf("<");
        if (lt <= 0 || la <= 0) { return; }
        if (at.Substring(at.Length - 1, 1) != ">") { return; }
        List<string> dargs = SplitTyArgs(dp.Substring(lt + 1, dp.Length - lt - 2));
        List<string> aargs = SplitTyArgs(at.Substring(la + 1, at.Length - la - 2));
        int i = 0;
        while (i < dargs.Count && i < aargs.Count) {
            UnifyMethodTp(dargs[i], aargs[i]);
            i = i + 1;
        }
    }

    // the inline List<T> ops: names + arities the runtime helpers cover;
    // everything else on a List receiver falls through to extension and
    // spec dispatch
    bool ListOpKnown(string name, int argc) {
        if (name == "Insert") { return argc == 2; }
        if (name == "Add" || name == "Contains" || name == "Remove"
                || name == "RemoveAt" || name == "IndexOf" || name == "AddRange") { return argc == 1; }
        if (name == "Clear" || name == "Reverse" || name == "ToArray") { return argc == 0; }
        if (name == "Reserve") { return argc == 1; }
        return false;
    }

    // the inline Dictionary ops
    bool DictOpKnown(string name, int argc) {
        if (name == "Add" || name == "TryGetValue") { return argc == 2; }
        if (name == "ContainsKey" || name == "Remove") { return argc == 1; }
        if (name == "Clear") { return argc == 0; }
        return false;
    }

    // does ty (after unwrapping array/nullable shells) name tp, possibly
    // nested inside type arguments?
    bool TyMentionsTp(string ty, string tp) {
        if (ty == null) { return false; }
        while (ty.Length > 2 && ty.Substring(ty.Length - 2, 2) == "[]") {
            ty = ty.Substring(0, ty.Length - 2);
        }
        if (ty.Length > 1 && ty.Substring(ty.Length - 1, 1) == "?") {
            ty = ty.Substring(0, ty.Length - 1);
        }
        if (ty == tp) { return true; }
        int lt = ty.IndexOf("<");
        if (lt <= 0) { return false; }
        List<string> args = SplitTyArgs(ty.Substring(lt + 1, ty.Length - lt - 2));
        int i = 0;
        while (i < args.Count) {
            if (TyMentionsTp(args[i], tp)) { return true; }
            i = i + 1;
        }
        return false;
    }

    bool TyMentionsAnyTp(string ty, List<string> tps) {
        if (ty == null) { return false; }
        int i = 0;
        while (i < tps.Count) {
            if (TyMentionsTp(ty, tps[i])) { return true; }
            i = i + 1;
        }
        return false;
    }

    // multi-type-parameter unification (gen0's unify_method_tp): a bare
    // type parameter binds its argument (first binding wins); array/nullable
    // shapes unwrap, then type arguments unify positionally (head names are
    // never compared)
    void UnifyTps(string dp, string at, List<string> tps, List<string> bind) {
        if (dp == null || at == null) { return; }
        int ix = IndexOfStrNg(tps, dp);
        if (ix >= 0) {
            if (bind[ix] == null) { bind[ix] = at; }
            return;
        }
        while (dp.Length > 2 && at.Length > 2
                && dp.Substring(dp.Length - 2, 2) == "[]"
                && at.Substring(at.Length - 2, 2) == "[]") {
            dp = dp.Substring(0, dp.Length - 2);
            at = at.Substring(0, at.Length - 2);
        }
        if (dp.Length > 1 && at.Length > 1
                && dp.Substring(dp.Length - 1, 1) == "?"
                && at.Substring(at.Length - 1, 1) == "?") {
            dp = dp.Substring(0, dp.Length - 1);
            at = at.Substring(0, at.Length - 1);
        }
        int lt = dp.IndexOf("<");
        int la = at.IndexOf("<");
        if (lt <= 0 || la <= 0) { return; }
        if (at.Substring(at.Length - 1, 1) != ">") { return; }
        List<string> dargs = SplitTyArgs(dp.Substring(lt + 1, dp.Length - lt - 2));
        List<string> aargs = SplitTyArgs(at.Substring(la + 1, at.Length - la - 2));
        int i = 0;
        while (i < dargs.Count && i < aargs.Count) {
            UnifyTps(dargs[i], aargs[i], tps, bind);
            i = i + 1;
        }
    }

    // rough expression families for lambda-arg overload scoring: gen0
    // prefers the delegate whose return type matches the lambda body
    // exactly over one needing a conversion (int selector vs double)
    int LamFamNg(Node body) {
        if (body == null) { return 0; }
        if (IsStrExpr(body)) { return 2; }
        if (IsDblExpr(body)) { return 3; }
        return 1;
    }

    int RetFamNg(string rt) {
        if (rt == null) { return 0; }
        if (rt == "string") { return 2; }
        if (rt == "double" || rt == "float") { return 3; }
        if (rt == "int" || rt == "long" || rt == "ulong" || rt == "uint"
                || rt == "short" || rt == "ushort" || rt == "byte"
                || rt == "sbyte" || rt == "char" || rt == "bool" || rt == "nint") { return 1; }
        return 0;
    }

    // lambda body's static type with the parameter typed from the
    // candidate delegate's first parameter (`u => u.name` reads string
    // only once `u` is User): push a temp local for the parameter, probe,
    // pop it. Neither scan site has the lambda's parameter in scope -- the
    // spec pre-pass walks bodies with a light locals table and call
    // resolution runs before GenLambda registers anything.
    string LambdaBodyTyNg(Node ae, string p0ty) {
        Node body = ae.a;
        if (body == null || ae.d != null || p0ty == null || p0ty == "") { return null; }
        Node p = null;
        int i = 0;
        while (i < ae.kids.Count) {
            if (ae.kids[i].kind == AK.Param()) { p = ae.kids[i]; }
            i = i + 1;
        }
        if (p == null || p.sval == null) { return null; }
        int savedN = nloc;
        int savedHead = locHead;
        AddLoc(p.sval, p0ty, false);
        string ty = StaticTyOf(body);
        nloc = savedN;
        locHead = savedHead;
        locName.RemoveAt(locName.Count - 1);
        locTy.RemoveAt(locTy.Count - 1);
        locOff.RemoveAt(locOff.Count - 1);
        locRef.RemoveAt(locRef.Count - 1);
        locDecl.RemoveAt(locDecl.Count - 1);
        locPrev.RemoveAt(locPrev.Count - 1);
        locOpaq.RemoveAt(locOpaq.Count - 1);
        locBoxed.RemoveAt(locBoxed.Count - 1);
        return ty;
    }

    int LamFamForNg(Node ae, string dlgTy) {
        List<string> ps = DelegateArgsNg(dlgTy);
        string p0 = ps != null && ps.Count > 0 ? ps[0] : null;
        string ty = LambdaBodyTyNg(ae, p0);
        if (ty != null) { return RetFamNg(ty); }
        return LamFamNg(ae.a);
    }

    // does the method-group argument `ae` (a bare identifier naming a
    // static method) fit delegate type sj: same parameter count and
    // matching return family -- loose ranking evidence, not a binding
    bool MethodGroupFitNg(Node ae, string sj) {
        if (ae == null || ae.kind != AK.Ident() || ae.sval == null) { return false; }
        List<int> cs = MethCandsName(ae.sval);
        if (cs == null) { return false; }
        List<string> dps = DelegateArgsNg(sj);
        int want = dps != null ? dps.Count : 0;
        int rf = RetFamNg(DelegateRetNg(sj));
        int i = 0;
        while (i < cs.Count) {
            int mi = cs[i];
            if (methStat[mi] == 1 && ParamCount(methNodes[mi]) == want
                    && RetFamNg(TypeFullName(methNodes[mi].type)) == rf) { return true; }
            i = i + 1;
        }
        return false;
    }

    int shapeMi;          // best shaped-extension candidate of the last scan
    List<string> shapeBind;
    int shapeScore;

    // scan same-name `this`-receiver generic statics for one whose shaped
    // receiver (`this List<T>`) unifies with rt and whose type parameters
    // bind completely from the receiver and the written arguments; the
    // best-scoring candidate lands in shapeMi/shapeBind/shapeScore. No
    // mutation -- both the dispatch rewrite and the ret-type lookup read
    // the same scan.
    void ScanShapedExtNg(string rt, string name, List<Node> args) {
        shapeMi = -1;
        shapeBind = null;
        shapeScore = -1;
        List<int> cs = MethCandsName(name);
        if (cs == null) { return; }
        List<string> argTys = new List<string>();
        int ai0 = 0;
        while (ai0 < args.Count) {
            Node ae0 = args[ai0];
            string at0 = null;
            if (ae0 != null && ae0.kind != AK.Lambda()) {
                at0 = StaticTyOf(ae0);
                if (at0 == null) { at0 = ArgNaturalTyNg(ae0); }
            }
            argTys.Add(at0);
            ai0 = ai0 + 1;
        }
        int i = 0;
        while (i < cs.Count) {
            int mi = cs[i];
            Node m = methNodes[mi];
            List<string> tps = DeclTps(m);
            if (methStat[mi] == 1 && m.ival == 1 && tps.Count > 0 && m.kids.Count > 0) {
                Node p0 = ParamAt(m, 0);
                string pt = p0 != null && p0.type != null ? TypeFullName(p0.type) : null;
                // bare `this T` receivers belong to the plain extension path
                if (pt != null && IndexOfStrNg(tps, pt) < 0 && TyMentionsAnyTp(pt, tps)) {
                    List<string> bind = new List<string>();
                    int bi = 0;
                    while (bi < tps.Count) { bind.Add(null); bi = bi + 1; }
                    UnifyTps(pt, rt, tps, bind);
                    int pc = ParamCount(m);
                    int j = 1;
                    while (j < pc) {
                        int ai = j - 1;
                        if (ai < args.Count) {
                            Node ae = args[ai];
                            string at2 = ai < argTys.Count ? argTys[ai] : null;
                            string dp2 = null;
                            Node pp = ParamAt(m, j);
                            if (pp != null && pp.type != null) { dp2 = TypeFullName(pp.type); }
                            if (dp2 != null) {
                                if (at2 != null) {
                                    UnifyTps(dp2, at2, tps, bind);
                                } else if (ae != null && ae.kind == AK.Lambda()) {
                                    // a lambda pins the delegate's parameter
                                    // positions from its explicit annotations
                                    // and the return position from its typed
                                    // body (Select<T,R>: R = body type)
                                    LambdaBindNg(ae, dp2, tps, bind);
                                }
                            }
                        }
                        j = j + 1;
                    }
                    bool full = true;
                    int bi2 = 0;
                    while (bi2 < bind.Count) {
                        if (bind[bi2] == null || !KnownTyName(bind[bi2])) { full = false; }
                        bi2 = bi2 + 1;
                    }
                    if (full) {
                        int score = SubstTy(pt, tps, bind) == rt ? 8 : 0;
                        int j2 = 1;
                        while (j2 < pc) {
                            int ai2 = j2 - 1;
                            if (ai2 < args.Count) {
                                Node ae2 = args[ai2];
                                Node pp2 = ParamAt(m, j2);
                                if (ae2 != null && pp2 != null && pp2.type != null) {
                                    string sj = SubstTy(TypeFullName(pp2.type), tps, bind);
                                    if (ae2.kind == AK.Lambda()) {
                                        int rf = RetFamNg(DelegateRetNg(sj));
                                        if (rf != 0 && ae2.d == null && ae2.a != null
                                                && rf == LamFamForNg(ae2, sj)) {
                                            score = score + 4;
                                        }
                                    } else {
                                        string atj = ai2 < argTys.Count ? argTys[ai2] : null;
                                        if (atj != null && atj == sj) { score = score + 8; }
                                        else if (MethodGroupFitNg(ae2, sj)) { score = score + 4; }
                                    }
                                }
                            }
                            j2 = j2 + 1;
                        }
                        if (score > shapeScore) {
                            shapeScore = score;
                            shapeMi = mi;
                            shapeBind = bind;
                        }
                    }
                }
            }
            i = i + 1;
        }
    }

    // return type of an instance-form extension call (`xs.Sum()`) without
    // mutating the call node: the receiver's static type against same-name
    // `this` statics -- exact receiver-type fit first, then shaped generic
    // receivers unified (the receiver binds declared parameter 0)
    string ExtRetTyNg(Node e) {
        return ExtRetTyWithRecvNg(e, null);
    }

    string ExtRetTyWithRecvNg(Node e, string knownRt) {
        if (e == null || e.a == null || e.a.kind != AK.MemberAccess()
                || e.a.a == null) { return null; }
        if (extRetDepth > 128) { return null; }
        extRetDepth = extRetDepth + 1;
        string rt = knownRt != null ? knownRt : ExtRecvTy(e.a.a);
        if (rt == null) {
            extRetDepth = extRetDepth - 1;
            return null;
        }
        string name = e.a.sval;
        List<int> cs = MethCandsName(name);
        if (cs != null) {
            int i = 0;
            while (i < cs.Count) {
                int mi = cs[i];
                Node m = methNodes[mi];
                if (methStat[mi] == 1 && m.ival == 1 && m.kids.Count > 0
                        && ParamCount(m) == e.kids.Count + 1) {
                    Node p0 = ParamAt(m, 0);
                    string pt = p0 != null && p0.type != null ? TypeFullName(p0.type) : null;
                    if (pt != null && pt == rt) {
                        extRetDepth = extRetDepth - 1;
                        return TypeFullName(m.type);
                    }
                }
                i = i + 1;
            }
        }
        ScanShapedExtNg(rt, name, e.kids);
        if (shapeMi >= 0) {
            Node m = methNodes[shapeMi];
            string res = SubstTy(TypeFullName(m.type), DeclTps(m), shapeBind);
            extRetDepth = extRetDepth - 1;
            return res;
        }
        extRetDepth = extRetDepth - 1;
        return null;
    }

    // dispatch twin of the scan: register the best shaped candidate, insert
    // the receiver into the argument list and rewrite the callee
    int ResolveShapedExtNg(Node recv, string name, Node callNode) {
        string rt = ExtRecvTy(recv);
        if (rt == null) { return -1; }
        ScanShapedExtNg(rt, name, callNode.kids);
        if (shapeMi < 0) { return -1; }
        callNode.kids.Insert(0, recv);
        SpecRegister(name, shapeBind, callNode, shapeMi);
        Node ci = new Node(AK.Ident());
        ci.sval = methCls[shapeMi];
        ci.line = callNode.line;
        ci.col = callNode.col;
        Node ma2 = new Node(AK.MemberAccess());
        ma2.a = ci;
        ma2.sval = callNode.a.sval;      // mangled by SpecRegister
        ma2.line = callNode.line;
        ma2.col = callNode.col;
        callNode.a = ma2;
        int spx = FindMethByNameNg(ma2.sval);
        return spx >= 0 ? spx : shapeMi;
    }

    // does a same-name NON-generic overload that fits the written argument
    // count live in the scope the inference would draw from? gen0 ranks the
    // whole overload set before inferring type args, so `SumNum(src)` picks
    // the non-generic `SumNum(this List<double>)` over inferring the generic
    // one (whose extra key-selector parameter then arity-mismatches)
    // does decl m's parameter types agree with the call's written argument
    // types wherever an argument's static type is known (a known type that
    // disagrees disqualifies the overload; unknown types prove nothing)
    bool DeclParamsMatchArgs(Node m, List<string> argTys) {
        int k = 0;
        while (k < argTys.Count && k < ParamCount(m)) {
            string at = argTys[k];
            Node pp = ParamAt(m, k);
            if (at != null && pp != null && pp.type != null) {
                string dp = TypeFullName(pp.type);
                if (dp != null && dp != at && dp != "object") { return false; }
            }
            k = k + 1;
        }
        return true;
    }

    bool NonGenericOverloadFits(Node n, bool owned) {
        List<int> cands = new List<int>();
        if (owned) {
            string rc = SpecRecvClsNg(n);
            while (rc != null) {
                List<int> cs = MethCandsClsName(rc, n.a.sval);
                if (cs != null) {
                    int i = 0;
                    while (i < cs.Count) {
                        if (methStat[cs[i]] != 2 && methStat[cs[i]] != 3
                                && !HasTypeParams(methNodes[cs[i]])) { cands.Add(cs[i]); }
                        i = i + 1;
                    }
                }
                Cls oc = FindClass(rc);
                rc = oc != null ? oc.baseName : null;
            }
        } else {
            List<int> gs = MethCandsName(n.a.sval);
            if (gs != null) {
                int i = 0;
                while (i < gs.Count) {
                    if (methStat[gs[i]] != 2 && methStat[gs[i]] != 3
                            && !HasTypeParams(methNodes[gs[i]])) { cands.Add(gs[i]); }
                    i = i + 1;
                }
            }
        }
        if (cands.Count == 0) { return false; }
        List<string> argTys = new List<string>();
        int ki = 0;
        while (ki < n.kids.Count) {
            string at = StaticTyOf(n.kids[ki]);
            if (at == null) { at = ExtRecvTy(n.kids[ki]); }
            argTys.Add(at);
            ki = ki + 1;
        }
        int want = n.kids.Count;
        int i2 = 0;
        while (i2 < cands.Count) {
            Node m = methNodes[cands[i2]];
            if (ParamCount(m) == want && DeclParamsMatchArgs(m, argTys)) { return true; }
            i2 = i2 + 1;
        }
        // instance-form extension: the receiver occupies the first slot, so
        // a `this T` static with one more parameter than written arguments
        // fits when its receiver type matches (ResolveExtNg's filter)
        if (!owned && n.a.kind == AK.MemberAccess() && n.a.a != null
                && !(n.a.a.kind == AK.Ident() && FindClass(n.a.a.sval) != null)) {
            string rt = ExtRecvTy(n.a.a);
            if (rt != null) {
                int i3 = 0;
                while (i3 < cands.Count) {
                    Node m2 = methNodes[cands[i3]];
                    if (methStat[cands[i3]] == 1 && m2.ival == 1
                            && ParamCount(m2) == want + 1) {
                        Node p0 = ParamAt(m2, 0);
                        string pt = p0 != null && p0.type != null ? TypeFullName(p0.type) : null;
                        if (pt == rt) { return true; }
                    }
                    i3 = i3 + 1;
                }
            }
        }
        return false;
    }

    // plan an un-annotated generic call: the receiver's own scope must
    // declare a single-type-param generic of that name (extension
    // inference keeps the global rule when the chain names nothing) and
    // the type parameters bind by unifying each declared parameter type
    // against its actual argument type (gen0's infer_method_tp_bindings
    // would bind an extension's receiver as parameter 0, but a pre-pass
    // registration has no way to pass the receiver -- instance-form
    // extensions are left to the dispatchers below). Returns false when
    // nothing can be registered, so the caller's else-if chain keeps
    // falling through to the instantiated-class branches.
    // gen0's lambda second pass: the delegate parameter `dp`
    // ("Selector<T,R>") pins its PARAMETER positions from the lambda's
    // explicit annotations and its RETURN position from the typed body
    // (the lambda's parameters are temporarily in scope for the probe).
    // `tps`/`bind` are the method's type parameters and partial bindings.
    void LambdaBindNg(Node ae, string dp, List<string> tps, List<string> bind) {
        if (ae == null || ae.kind != AK.Lambda() || ae.a == null || ae.d != null
                || dp == null || dp.IndexOf("<") <= 0) { return; }
        int lt = dp.IndexOf("<");
        Node dd = layoutBinder.FindDelegate(dp.Substring(0, lt));
        if (dd == null || dd.type == null) { return; }
        List<string> dtps = DeclTps(dd);
        List<string> dargs = SplitTyArgs(dp.Substring(lt + 1, dp.Length - lt - 2));
        List<string> dpt = new List<string>();
        int kd = 0;
        while (kd < dd.kids.Count) {
            if (dd.kids[kd].kind == AK.Param() && dd.kids[kd].type != null) {
                dpt.Add(TypeFullName(dd.kids[kd].type));
            }
            kd = kd + 1;
        }
        if (dpt.Count == 0) { return; }
        List<Node> lps = new List<Node>();
        int li = 0;
        while (li < ae.kids.Count) {
            if (ae.kids[li].kind == AK.Param()) { lps.Add(ae.kids[li]); }
            li = li + 1;
        }
        if (lps.Count != dpt.Count) { return; }
        int savedN = nloc;
        int savedHead = locHead;
        bool known = true;
        int pi = 0;
        while (pi < lps.Count) {
            Node lp = lps[pi];
            string conc = SubstTy(SubstTy(dpt[pi], dtps, dargs), tps, bind);
            if (lp.type != null && lp.type.sval != null && lp.type.sval != "var") {
                string ann = TypeFullName(lp.type);
                if (ann != null) {
                    UnifyTps(dpt[pi], ann, tps, bind);
                    conc = ann;
                }
            }
            if (conc == null || !KnownTyName(conc)) { known = false; }
            if (lp.sval != null) { AddLoc(lp.sval, conc, false); }
            pi = pi + 1;
        }
        if (known) {
            string bt = StaticTyOf(ae.a);
            // arithmetic / comparison bodies have no StaticTyOf arm; the
            // wider inferrer names them (Select<T,R>: R = `n * 2` -> int)
            if (bt == null) { bt = InferExprTyNg(ae.a); }
            if (bt != null && KnownTyName(bt)) {
                string rt2 = TypeFullName(dd.type);
                // the delegate's return may name the DELEGATE's own type
                // parameters (Selector's R); map them through the delegate
                // type arguments first (Selector<T, V> on a method whose
                // parameter is named V) -- the parameter side above already
                // substitutes dargs, the return side must too, or the
                // unify lands outside the method's tp list and V never
                // binds
                string rt3 = SubstTy(rt2, dtps, dargs);
                if (rt3 != null) { UnifyTps(rt3, bt, tps, bind); }
            }
        }
        int pop = lps.Count;
        nloc = savedN;
        locHead = savedHead;
        while (pop > 0) {
            locName.RemoveAt(locName.Count - 1);
            locTy.RemoveAt(locTy.Count - 1);
            locOff.RemoveAt(locOff.Count - 1);
            locRef.RemoveAt(locRef.Count - 1);
            locDecl.RemoveAt(locDecl.Count - 1);
            locPrev.RemoveAt(locPrev.Count - 1);
            locOpaq.RemoveAt(locOpaq.Count - 1);
            locBoxed.RemoveAt(locBoxed.Count - 1);
            pop = pop - 1;
        }
    }

    bool TryPlanInferenceSpecNg(Node n) {
        // the same-name generic overload set, receiver chain first. The
        // oracle ranks the whole set before inferring; taking the first
        // same-name generic hijacks delegate-typed overload families
        List<int> cands = new List<int>();
        string rc = SpecRecvClsNg(n);
        bool inScope = false;
        while (rc != null) {
            List<int> cs = MethCandsClsName(rc, n.a.sval);
            if (cs != null) {
                int i = 0;
                while (i < cs.Count) {
                    int mi = cs[i];
                    if (methStat[mi] != 2 && methStat[mi] != 3 && HasTypeParams(methNodes[mi])) {
                        cands.Add(mi);
                        inScope = true;
                    }
                    i = i + 1;
                }
            }
            Cls oc = FindClass(rc);
            rc = oc != null ? oc.baseName : null;
        }
        if (!inScope && n.a.kind == AK.MemberAccess() && !ReceiverHasNameNg(n, n.a.sval)) {
            List<int> gs = MethCandsName(n.a.sval);
            if (gs != null) {
                int i = 0;
                while (i < gs.Count) {
                    int mi = gs[i];
                    if (methStat[mi] != 2 && methStat[mi] != 3 && HasTypeParams(methNodes[mi])) { cands.Add(mi); }
                    i = i + 1;
                }
            }
        }
        if (cands.Count == 0) { return false; }
        if (NonGenericOverloadFits(n, inScope)) { return false; }
        // class-qualified statics (`Enumerable.SumNum(src)`) pass every
        // written argument to declared parameters 1:1. A genuine
        // instance-form extension (`xs.Sum()`) must not register here: the
        // dispatch's extension path inserts the receiver into the argument
        // list, a pre-pass registration cannot, so the spec would
        // arity-mismatch against its own shaped `this` parameter
        bool classQual = n.a.kind == AK.MemberAccess() && n.a.a != null
            && n.a.a.kind == AK.Ident() && FindClass(n.a.a.sval) != null;
        List<string> inferArgTys = new List<string>();
        int ki2 = 0;
        while (ki2 < n.kids.Count) {
            Node ae2 = n.kids[ki2];
            string at2 = null;
            if (ae2 != null) {
                at2 = StaticTyOf(ae2);
                if (at2 == null) { at2 = ExtRecvTy(ae2); }
                if (at2 == null) { at2 = ArgNaturalTyNg(ae2); }
            }
            inferArgTys.Add(at2);
            ki2 = ki2 + 1;
        }
        int bestDi = -1;
        List<string> bestBind = null;
        int bestScore = -1;
        int ci = 0;
        while (ci < cands.Count) {
            int udi = cands[ci];
            Node gd = methNodes[udi];
            List<string> tps0 = DeclTps(gd);
            if (tps0.Count >= 1) {
                bool instExt = gd.ival == 1 && n.a.kind == AK.MemberAccess() && !classQual;
                if (!instExt) {
                    List<string> bind = new List<string>();
                    int bi = 0;
                    while (bi < tps0.Count) { bind.Add(null); bi = bi + 1; }
                    int pc = ParamCount(gd);
                    int j = 0;
                    while (j < pc) {
                        Node ae = null;
                        if (j < n.kids.Count) { ae = n.kids[j]; }
                        if (ae != null) {
                            string at = j < inferArgTys.Count ? inferArgTys[j] : null;
                            string dp = null;
                            Node pp = ParamAt(gd, j);
                            if (pp != null && pp.type != null) { dp = TypeFullName(pp.type); }
                            if (dp != null) {
                                if (at != null) {
                                    UnifyTps(dp, at, tps0, bind);
                                } else {
                                    LambdaBindNg(ae, dp, tps0, bind);
                                }
                            }
                        }
                        j = j + 1;
                    }
                    bool full = true;
                    int fi = 0;
                    while (fi < bind.Count) {
                        if (bind[fi] == null || !KnownTyName(bind[fi])) { full = false; }
                        fi = fi + 1;
                    }
                    if (full) {
                        int score = InferCandScoreNg(n, gd, bind, inferArgTys);
                        if (score > bestScore) { bestScore = score; bestDi = udi; bestBind = bind; }
                    }
                }
            }
            ci = ci + 1;
        }
        if (bestDi < 0) { return false; }
        inferDi = bestDi;
        inferArgs = bestBind;
        return true;
    }

    // natural type of an argument the light scan cannot type: literals
    // carry their C# natural type (Aggregate's `100` seed pins A=int)
    string ArgNaturalTyNg(Node ae) {
        if (ae == null) { return null; }
        if (ae.kind == AK.IntLit()) { return "int"; }
        if (ae.kind == AK.FloatLit()) { return "double"; }
        if (ae.kind == AK.StringLit()) { return "string"; }
        if (ae.kind == AK.CharLit()) { return "char"; }
        if (ae.kind == AK.BoolLit()) { return "bool"; }
        return null;
    }

    // substitution quality of a fully-bound inference candidate: exact
    // argument/parameter matches dominate, lambda delegate-return family
    // matches break ties (gen0 prefers the selector whose return type the
    // lambda body actually produces)
    int InferCandScoreNg(Node n, Node gd, List<string> bind, List<string> argTys) {
        int score = 0;
        List<string> tps = DeclTps(gd);
        int pc = ParamCount(gd);
        int j = 0;
        while (j < pc) {
            Node ae = null;
            if (j < n.kids.Count) { ae = n.kids[j]; }
            Node pp = ParamAt(gd, j);
            if (ae != null && pp != null && pp.type != null) {
                string sj = SubstTy(TypeFullName(pp.type), tps, bind);
                if (ae.kind == AK.Lambda()) {
                    int rf = RetFamNg(DelegateRetNg(sj));
                    if (rf != 0 && ae.d == null && ae.a != null && rf == LamFamForNg(ae, sj)) { score = score + 4; }
                } else {
                    string atj = j < argTys.Count ? argTys[j] : null;
                    if (atj != null && atj == sj) { score = score + 8; }
                    else if (MethodGroupFitNg(ae, sj)) { score = score + 4; }
                }
            }
            j = j + 1;
        }
        return score;
    }

    void CollectSpecs(Node n) {
        if (n == null) { return; }
        int saved = EnterEnvNg(n);
        CollectSpecsInEnvNg(n);
        locHead = saved;
    }

    void CollectSpecsInEnvNg(Node n) {
        if (n.kind == AK.MemberAccess() && n.sval2 != null && n.sval2 != ""
                && n.a != null && n.a.kind == AK.Ident()
                && KnownTyName(Undunder(n.sval2))) {
            // class-qualified static access through a concrete
            // instantiation: remember it so its statics get materialized
            RegisterInstCls(n.a.sval + "<" + Undunder(n.sval2) + ">");
        }
        if (n.kind == AK.Call() && n.a != null
                && (n.a.kind == AK.Ident() || n.a.kind == AK.MemberAccess())
                && n.d != null && n.d.kind == AK.TypeRef()
                && n.d.sval == "__typeargs") {
            string name = n.a.sval;
            List<string> args = new List<string>();
            // the parser parked the explicit instantiation on the call's d
            // slot as a TypeRef list
            int i = 0;
            while (i < n.d.kids.Count) {
                args.Add(TypeFullName(n.d.kids[i]));
                i = i + 1;
            }
            // the receiver scopes the overload set: instantiate the generic
            // the receiver's own chain declares. Only when the chain names
            // nothing does the global bare-name rule apply (extension
            // methods: db.Query<T> lives in another class) -- a same-named
            // method in an unrelated class (Com.Get vs Control.Get<T>) must
            // never be hijacked by the bare-name match.
            int odi = OwnedGenericDeclArityNg(n, name, n.kids.Count);
            if (odi < 0 && !ReceiverHasNameNg(n, name)) {
                bool extForm2 = n.a != null && n.a.kind == AK.MemberAccess()
                    && !(n.a.a != null && n.a.a.kind == AK.Ident()
                        && FindClass(n.a.a.sval) != null);
                List<int> gcs = MethCandsName(name);
                if (gcs != null) {
                    int gi = 0;
                    while (gi < gcs.Count) {
                        int gmi = gcs[gi];
                        if (methStat[gmi] != 2 && methStat[gmi] != 3 && HasTypeParams(methNodes[gmi])) {
                            int extra = extForm2 && methNodes[gmi].ival == 1 && methStat[gmi] == 1 ? 1 : 0;
                            if (ParamCount(methNodes[gmi]) == n.kids.Count + extra) { odi = gmi; break; }
                        }
                        gi = gi + 1;
                    }
                }
            }
            SpecRegister(name, args, n, odi);
        } else if (n.kind == AK.Call() && n.a != null
                && (n.a.kind == AK.Ident() || n.a.kind == AK.MemberAccess())
                && n.d == null
                && n.kids.Count > 0
                && TryPlanInferenceSpecNg(n)) {
            // un-annotated call: infer the type parameters from the
            // arguments (gen0's inference) -- but only when the receiver's
            // own scope declares a generic of that name; a same-named
            // non-generic (JsonValue.Get(key), Com.Get) resolves normally,
            // and calls that infer nothing must FALL THROUGH to the
            // instantiated-class branches below.
            SpecRegister(n.a.sval, inferArgs, n, inferDi);
        } else if (n.a != null && n.a.kind == AK.MemberAccess() && n.a.a != null
                && n.a.a.kind == AK.Ident() && n.a.sval2 != null && n.a.sval2 != "") {
            // qualified static call on an instantiated generic class:
            // Stat<double>.F() -- specialize F for this instantiation
            string cinst = n.a.a.sval + "<" + Undunder(n.a.sval2) + ">";
            RegisterInstCls(cinst);
            SpecRegisterClass(cinst, n.a.sval, true, n);
        } else if (n.a != null && n.a.kind == AK.MemberAccess() && n.a.a != null
                && n.d == null) {
            // instance call on an instantiated generic receiver:
            // pc.Describe() with pc typed Pool<Conn>
            string rc = StaticTyOf(n.a.a);
            if (rc != null && rc.IndexOf("<") > 0) {
                Cls oc = FindClass(rc);
                if (oc != null && oc.tps.Count > 0) {
                    RegisterInstCls(rc);
                    SpecRegisterClass(rc, n.a.sval, false, n);
                }
            }
        }
        CollectSpecs(n.a);
        CollectSpecs(n.b);
        CollectSpecs(n.c);
        CollectSpecs(n.d);
        int ki = 0;
        while (ki < n.kids.Count) { CollectSpecs(n.kids[ki]); ki = ki + 1; }
    }

    void RunSpecPipeline() {
        // process the worklist: each appended spec's body is scanned for
        // further explicit-generic calls until fixpoint. A light locals
        // table (params + declarations) backs StaticTyOf during the scan,
        // so inference can read a call argument's type.
        int processed = 0;
        while (processed < methNodes.Count) {
            Node m = methNodes[processed];
            if (methStat[processed] != 3) {
                bool inst = methStat[processed] == 0 || methStat[processed] == 2;
                curCls = methCls[processed];
                specScanMeth = m;
                InitLocalsNg();
                if (inst) {
                    string thisTy = m.sval2 != null && m.sval2 != "" ? m.sval2 : curCls;
                    AddLoc("this", thisTy, false);
                }
                int pi = 0;
                while (pi < m.kids.Count) {
                    if (m.kids[pi].kind == AK.Param()) {
                        AddLoc(m.kids[pi].sval, TypeFullName(m.kids[pi].type), m.kids[pi].ival == 1);
                        if (locTy[nloc - 1] == "string") { locOpaq[nloc - 1] = 1; }
                    }
                    pi = pi + 1;
                }
                ReserveLocals(m.d);
                CollectSpecs(m);
            }
            processed = processed + 1;
        }
        specScanMeth = null;     // emission-time registrations must not see
                                 // a stale scan context
    }

    // ---- enums ----
    void CollectEnums(Node unit) {
        enName = new List<string>();
        enOff = new List<int>();
        enCnt = new List<int>();
        enMem = new List<string>();
        enVal = new List<long>();
        int i = 0;
        while (i < unit.kids.Count) {
            Node dcl = unit.kids[i];
            if (dcl.kind == AK.EnumDecl()) {
                enName.Add(dcl.sval);
                enOff.Add(enMem.Count);
                int cnt = 0;
                long val = 0;
                int k = 0;
                while (k < dcl.kids.Count) {
                    Node m = dcl.kids[k];
                    if (m.sval != null && m.sval != "") {
                        // an explicit `= n` (int literal, possibly negated)
                        // resets the running counter, like gen0's fold
                        if (m.a != null && m.a.kind == AK.IntLit()) { val = m.a.ival; }
                        else if (m.a != null && m.a.kind == AK.Unary()
                                && m.a.op == TK.Minus() && m.a.a != null
                                && m.a.a.kind == AK.IntLit()) { val = -m.a.a.ival; }
                        enMem.Add(m.sval);
                        enVal.Add(val);
                        cnt = cnt + 1;
                        val = val + 1;
                    }
                    k = k + 1;
                }
                enCnt.Add(cnt);
            }
            i = i + 1;
        }
    }

    int FindEnum(string n) {
        int i = 0;
        while (i < enName.Count) { if (enName[i] == n) { return i; } i = i + 1; }
        return -1;
    }

    // flat index of member `mem` of enum `en`, or -1
    int FindEnumMemIdx(string en, string mem) {
        int ei = FindEnum(en);
        if (ei < 0) { return -1; }
        int i = 0;
        while (i < enCnt[ei]) {
            if (enMem[enOff[ei] + i] == mem) { return enOff[ei] + i; }
            i = i + 1;
        }
        return -1;
    }

    // the enum type an expression's static type names, or null
    string EnumTyOf(Node e) {
        if (e == null) { return null; }
        string t = StaticTyOf(e);
        if (t != null && FindEnum(t) >= 0) { return t; }
        return null;
    }

    // enum x.ToString(): the name of the first member whose constant equals
    // the value (declaration order wins duplicates, like gen0); an unmatched
    // value formats as its number
    void GenEnumToString(Node recv, string et) {
        int ei = FindEnum(et);
        GenExpr(recv);
        XPushV0();                                  // push v
        int numL = NL();
        int joinL = NL();
        int cnt = enCnt[ei];
        int[] hits = new int[cnt];
        int i = 0;
        while (i < cnt) {
            hits[i] = NL();
            LdrU(1, 31, 0);                              // x1 = [sp] (peek v)
            LoadImm(2, enVal[enOff[ei] + i]);
            CmpRR(1, 2);                              // cmp x1, x2
            EmitBcond(0, hits[i]);                       // b.eq
            i = i + 1;
        }
        XPopV(0);                                  // pop v -> x0
        BLInternal("_zan_rt_int2str");                   // numeric fallback
        EmitB(joinL);
        i = 0;
        while (i < cnt) {
            Mark(hits[i]);
            XPopV(0);                              // pop v (discard)
            LoadStr(InternStr(enMem[enOff[ei] + i]), 0);
            EmitB(joinL);
            i = i + 1;
        }
        Mark(joinL);
    }

    // EnumType.TryParse(text, out value): a case-sensitive probe over the
    // declaration-order member names, like gen0 -- a hit stores the member
    // constant through the out address and yields 1, a miss stores
    // default(T) and yields 0
    void GenEnumTryParse(Node e) {
        string en = e.a.a.sval;
        int ei = FindEnum(en);
        GenRefArg(e.kids[1]);                            // x0 = out address
        XPushV0();                                  // push addr
        GenExpr(e.kids[0]);                              // x0 = text
        XPushV0();                                  // push text (strcmp0
                                                        // clobbers x0-x17, so
                                                        // every probe peeks)
        int cnt = enCnt[ei];
        int miss = NL();
        int join = NL();
        int[] hits = new int[cnt];
        int i = 0;
        while (i < cnt) {
            hits[i] = NL();
            E4(0xF84003E1);                              // ldur x1, [sp] (text)
            LoadStr(InternStr(enMem[enOff[ei] + i]), 0);
            BLInternal("_zan_rt_strcmp0");               // w0 = 0 iff equal
            E4(0x7100001F);                              // cmp w0, #0
            EmitBcond(0, hits[i]);                       // b.eq hit
            i = i + 1;
        }
        XPopV(0);                                  // pop text (discard)
        XPopV(1);                                  // pop addr -> x1
        StrU(31, 1, 0);                                  // str xzr, [x1] (default)
        LoadImm(0, 0);
        EmitB(join);
        i = 0;
        while (i < cnt) {
            Mark(hits[i]);
            XPopV(0);                              // pop text (discard)
            XPopV(1);                              // pop addr -> x1
            LoadImm(2, enVal[enOff[ei] + i]);
            StrU(2, 1, 0);                               // member constant
            LoadImm(0, 1);
            EmitB(join);
            i = i + 1;
        }
        Mark(join);
    }

    // true when sub's base chain reaches anc (equal counts)
    bool DerivesFrom(string sub, string anc) {
        if (sub == null || anc == null) { return false; }
        string cur = sub;
        while (cur != null) {
            if (cur == anc) { return true; }
            Cls cc = FindClass(cur);
            if (cc == null) { return false; }
            cur = cc.baseName;
        }
        return false;
    }

    // declared type of a local, field or static of that name (locals shadow
    // fields shadow statics, matching the binder's lookup order). A local
    // declared in a closed sibling block still types by name (the oracle
    // binder's method-flat table): ChartViewPolar reads `p.radiusInner`
    // after the loop that declared `p` has closed.
    string NamedSlotTy(string name) {
        int li = LocalIdx(name);
        if (li >= 0) { return locTy[li]; }
        Fld f = CurField(name);
        if (f != null) { return f.ty; }
        string st = FindStaticTy(curCls, name);
        if (st != null) { return st; }
        int di = DeclaredLocIdxNg(name);
        return di >= 0 ? locTy[di] : null;
    }

    // the latest method-wide slot declaring `name`: the reserve walk adds
    // declarations in program order, so the last index wins
    int DeclaredLocIdxNg(string name) {
        int i = nloc - 1;
        while (i >= 0) {
            if (locName[i] == name) { return i; }
            i = i - 1;
        }
        return -1;
    }

    string TypeFullName(Node t) {
        if (t == null) { return ""; }
        // tuple ref: sval already carries the mangled "__Tuple_<elems>"
        // class name; the element types ride in kids for layout only
        if (t.op == 2) { return t.sval + ArrSuffix(t.ival); }
        string n = t.sval;
        if (t.kids != null && t.kids.Count > 0) {
            n = n + "<";
            int i = 0;
            while (i < t.kids.Count) {
                if (i > 0) { n = n + ","; }
                n = n + TypeFullName(t.kids[i]);
                i = i + 1;
            }
            n = n + ">";
        }
        // `T?` marks a nullable VALUE payload (primitive, enum, struct): the
        // question rides the payload name ahead of any array suffix.
        // Reference types erase it -- a null reference needs no wrapper
        // (the oracle's `int[]?` is equally a no-op).
        if (t.op == 1 && IsNulableValueTy(n)) { n = n + "?"; }
        // multidim rank: sval2 counts the commas of the level that carried
        // them ("int[,]" 1, "int[,,]" 2, "int[][,]" 1 from the inner level)
        // -- the comma suffix renders on the final level
        if (t.ival > 0 && t.sval2 != null && t.sval2 != "") {
            int commas = (int)Convert.ToInt64(t.sval2);
            string suf = "[";
            int ci = 0;
            while (ci < commas) { suf = suf + ","; ci = ci + 1; }
            return n + ArrSuffix(t.ival - 1) + suf + "]";
        }
        return n + ArrSuffix(t.ival);
    }

    // array-type helpers ("int[]" style declared types). The outermost
    // bracket group decides the shape: it holds nothing (jagged "[]") or
    // commas only (rectangular "[,]", "[,,]")
    bool IsArrTy(string t) {
        if (t == null || t.Length < 2) { return false; }
        if (t.Substring(t.Length - 1, 1) != "]") { return false; }
        int i = t.Length - 2;
        while (i >= 0) {
            string c = t.Substring(i, 1);
            if (c == "[") { return true; }
            if (c != ",") { return false; }
            i = i - 1;
        }
        return false;
    }
    // rank of the outermost level ("int[]" 1, "int[,]" 2, "int[,,]" 3);
    // non-array types answer 1
    int ArrRankOf(string t) {
        if (!IsArrTy(t)) { return 1; }
        int i = t.Length - 2;
        int commas = 0;
        while (i >= 0 && t.Substring(i, 1) != "[") { commas = commas + 1; i = i - 1; }
        return commas + 1;
    }
    bool IsArrExpr(Node e) {
        if (e == null) { return false; }
        string act = ArrContainerTy(e);
        if (act != null) { return true; }
        if (e.kind == AK.Ident()) {
            int li = LocalIdx(e.sval);
            if (li >= 0) { return IsArrTy(locTy[li]); }
            Fld f = CurField(e.sval);
            return f != null && IsArrTy(f.ty);
        }
        if (e.kind == AK.NewExpr()) {
            return e.ival == 1;
        }
        return false;
    }
    // n copies of the array suffix ("[][]" for 2)
    string ArrSuffix(int n2) {
        string s2 = "";
        int i = 0;
        while (i < n2) { s2 = s2 + "[]"; i = i + 1; }
        return s2;
    }

    // allocated array type of a `new T[...]` node: one sized rank (dims
    // count rides in sval2 -- "new int[2,3]" is "int[,]") plus one suffix
    // per trailing rank-only bracket ("new int[3][]" is "int[][]")
    string NewArrTyOf(Node e) {
        string n = TypeFullName(e.type);
        int dims = e.sval2 != null && e.sval2 != "" ? (int)Convert.ToInt64(e.sval2) : 1;
        if (dims > 1) {
            string suf = "[";
            int ci = 1;
            while (ci < dims) { suf = suf + ","; ci = ci + 1; }
            n = n + suf + "]";
        } else {
            n = n + "[]";
        }
        return n + ArrSuffix(e.op);
    }

    string ArrTyOf(Node e) {
        string act = ArrContainerTy(e);
        if (act != null) { return act; }
        if (e.kind == AK.Ident()) {
            int li = LocalIdx(e.sval);
            if (li >= 0 && IsArrTy(locTy[li])) { return locTy[li]; }
            Fld f = CurField(e.sval);
            if (f != null && IsArrTy(f.ty)) { return f.ty; }
            return "int[]";
        }
        if (e.kind == AK.NewExpr() && e.type != null && e.ival == 1) {
            return NewArrTyOf(e);
        }
        return "int[]";
    }

    // declared array type of an expression usable as an element container:
    // a local, an instance field (implicit this or through a receiver), a
    // static field (of the current class or class-qualified), `new T[]`,
    // a cast/as to an array type, a nested element read of an
    // array-of-arrays, or a call returning an array. Unlike ArrTyOf this
    // never guesses -- null means "not a known array".
    string ArrContainerTy(Node e) {
        if (e == null) { return null; }
        if (e.kind == AK.Ident()) {
            int li = LocalIdx(e.sval);
            if (li >= 0 && IsArrTy(locTy[li])) { return locTy[li]; }
            Fld f = CurField(e.sval);
            if (f != null && IsArrTy(f.ty)) { return f.ty; }
            string st = FindStaticTy(curCls, e.sval);
            if (st != null && IsArrTy(st)) { return st; }
            return null;
        }
        if (e.kind == AK.NewExpr() && e.type != null && e.ival == 1) {
            return NewArrTyOf(e);
        }
        if (e.kind == AK.CastExpr() && e.type != null) {
            string ct = TypeFullName(e.type);
            if (IsArrTy(ct)) { return ct; }
            return null;
        }
        if (e.kind == AK.AsExpr() && e.type != null) {
            string at2 = TypeFullName(e.type);
            if (IsArrTy(at2)) { return at2; }
            return null;
        }
        if (e.kind == AK.MemberAccess()) {
            Fld f = FieldOf(e);
            if (f != null && IsArrTy(f.ty)) { return f.ty; }
            if (e.a != null && e.a.kind == AK.Ident() && FindClass(e.a.sval) != null) {
                string st = FindStaticTy(QualifiedCls(e.a.sval, e.a.sval2), e.sval);
                if (st != null && IsArrTy(st)) { return st; }
            }
            return null;
        }
        if (e.kind == AK.Index()) {
            string et = ElemTyOf(e);
            if (et != null && IsArrTy(et)) { return et; }
            return null;
        }
        if (e.kind == AK.Call()) {
            string rt = CallRetTy(e);
            if (IsArrTy(rt)) { return rt; }
            return null;
        }
        if (e.kind == AK.AwaitExpr()) {
            string at = AsyncAwaitElemTyNg(e.a);
            if (IsArrTy(at)) { return at; }
            return null;
        }
        return null;
    }
    int ArrElemSize(string t) {
        string el = ArrElemName(t);
        if (el == "int" || el == "uint" || el == "float" || el == "char") { return 4; }
        if (el == "short" || el == "ushort") { return 2; }
        if (el == "byte" || el == "sbyte" || el == "bool") { return 1; }
        return 8;
    }

    // element type name of an array type: strips the outermost bracket
    // group ("byte[]" -> "byte", "int[,]" -> "int", "int[][,]" -> "int[]")
    string ArrElemName(string t) {
        if (t == null || t.Length < 3) { return ""; }
        if (IsArrTy(t)) {
            int i = t.Length - 2;
            while (i >= 0 && t.Substring(i, 1) != "[") { i = i - 1; }
            if (i > 0) { return t.Substring(0, i); }
        }
        return t.Substring(0, t.Length - 2);
    }

    // base-2 log of the element size (1->0, 2->1, 4->2, 8->3): the lsl
    // shift used in scaled register addressing
    int ArrElemShift(int esz) {
        if (esz == 2) { return 1; }
        if (esz == 4) { return 2; }
        if (esz == 8) { return 3; }
        return 0;
    }

    // ---- rectangular multidim arrays (B8) ----
    // one subscript's bounds check: `reg` holds the index, x1 the dim; a
    // bad index reports the array guard and continues with 0 (gen0 parity)
    void MdBoundNg(int reg, int line, int col) {
        int bad = NL();
        int cont = NL();
        CmpRR(reg, 1);                                   // cmp reg, x1 (dim)
        EmitBcond(10, bad);                              // b.ge bad
        CmpRR(reg, 31);                                  // cmp reg, xzr
        EmitBcond(11, bad);                              // b.lt bad
        EmitB(cont);
        Mark(bad);
        XPushR(reg);                            // keep index
        LoadSymRef("l_.str." + guardFileIdx, 0);
        LoadImm(1, line);
        LoadImm(2, col);
        LoadSymRef("l_.str." + guardArrIdx, 3);
        BLInternal("_zan_rt_guard_fail3");
        XPopV(reg);                            // pop index
        LoadImm(reg, 0);
        Mark(cont);
    }

    // element-access prologue: the array lands in x19 (callee-saved in the
    // C ABI, untouched by the internal helpers) and the subscripts are
    // pushed in reverse so i0 pops first
    void MdPrologueNg(Node idx) {
        GenExpr(idx.a);                                  // arr -> x0
        MovRR(19, 0);
        int si = idx.kids.Count;
        while (si >= 1) {
            GenExpr(idx.kids[si - 1]);
            XPushV0();
            si = si - 1;
        }
        GenExpr(idx.b);                                  // i0 last (top)
        XPushV0();
    }

    // row-major flat index: pops every subscript and folds
    // ((i0*D1 + i1)*D2 + ...) into x9, each against its own dim
    void MdFlatNg(Node idx, int nsub, int line, int col) {
        XPopV(0);                                  // pop i0 -> x0
        LdrU(1, 19, 0);                                  // dims[0]
        MovRR(9, 0);
        MdBoundNg(9, line, col);
        int d = 1;
        while (d < nsub) {
            XPopV(0);                              // pop i_d -> x0
            LdrU(1, 19, 8 * d);                          // dims[d]
            MdBoundNg(0, line, col);
            LdrU(1, 19, 8 * d);                          // (guard clobbers x1)
            E4(0x9B017D29);                              // mul x9, x9, x1
            E4(0x8B000129);                              // add x9, x9, x0
            d = d + 1;
        }
    }

    // element load with the reference compiler's packed layout and value
    // extension rules: x1 = array data, x0 = index -> x0 = element.
    // byte/bool zero-extend, sbyte/short sign-extend, ushort/uint/char
    // zero-extend, int sign-extends; long/ulong/double load full words.
    void EmitArrElemLoad(int esz, string el, int arrReg, int idxReg, int dstReg) {
        if (tgt86 == 1) {
            // 基址->r10、下标->r11(纯暂存),装进 dst 的家;dst 是槽位时
            // 装进 r10(r10 同时是被寻址基址,装入即消费,无第三寄存器
            // 需求,不碰任何 v 的家)。SIB = (s<<6)|0x1A(idx 域 011 经 REX.X
            // 落 r11,base 域 010 经 REX.B 落 r10;写成 000 会落在 r8)。
            XGetV(arrReg, 10);
            XGetV(idxReg, 11);
            int d = XMapReal(dstReg);
            if (d < 0) {
                // 槽位目的:先落 r10 再 XSetV;modrm reg=010(r10),REX.R=1
                if (esz == 1) {
                    if (el == "sbyte") { X3(0x4F, 0x0F, 0xBE); X2(0x14, 0x1A); }   // movsx r10, byte [r10+r11]
                    else { X3(0x47, 0x0F, 0xB6); X2(0x14, 0x1A); }                 // movzx r10d, byte [r10+r11]
                } else if (esz == 2) {
                    if (el == "short") { X3(0x4F, 0x0F, 0xBF); X2(0x14, 0x5A); }   // movsx r10, word [r10+r11*2]
                    else { X3(0x47, 0x0F, 0xB7); X2(0x14, 0x5A); }                 // movzx r10d, word [r10+r11*2]
                } else if (esz == 4) {
                    if (el == "float") {
                        X3(0xF3, 0x43, 0x0F); X3(0x10, 0x04, 0x9A);                // movss xmm0, [r10+r11*4]
                        X3(0xF3, 0x0F, 0x5A); X1(0xC0);                            // cvtss2sd xmm0, xmm0
                        X3(0x66, 0x49, 0x0F); X2(0x7E, 0xC2);                      // movq r10, xmm0
                    } else if (el == "int") { X3(0x4F, 0x63, 0x14); X1(0x9A); }    // movsxd r10, dword [r10+r11*4]
                    else { X3(0x47, 0x8B, 0x14); X1(0x9A); }                       // mov r10d, [r10+r11*4] (零扩展)
                } else { X3(0x4F, 0x8B, 0x14); X1(0xDA); }                         // mov r10, [r10+r11*8]
                XSetV(dstReg, 10);
                return;
            }
            int dm = 0x04 | ((d & 7) << 3);              // mod=00 reg=dst rm=SIB
            int rx = (d >> 3) & 1;                       // REX.R:dst 编码 >=8
            if (esz == 1) {
                if (el == "sbyte") { X3(0x4B | (rx << 2), 0x0F, 0xBE); X2(dm, 0x1A); }   // movsx rd, byte [r10+r11]
                else { X3(0x43 | (rx << 2), 0x0F, 0xB6); X2(dm, 0x1A); }                 // movzx rd, byte [r10+r11]
            } else if (esz == 2) {
                if (el == "short") { X3(0x4B | (rx << 2), 0x0F, 0xBF); X2(dm, 0x5A); }   // movsx rd, word [r10+r11*2]
                else { X3(0x43 | (rx << 2), 0x0F, 0xB7); X2(dm, 0x5A); }                 // movzx rd, word [r10+r11*2]
            } else if (esz == 4) {
                if (el == "float") {
                    X3(0xF3, 0x43, 0x0F); X3(0x10, 0x04, 0x9A);                    // movss xmm0, [r10+r11*4]
                    X3(0xF3, 0x0F, 0x5A); X1(0xC0);                                // cvtss2sd xmm0, xmm0
                    X3(0x66, 0x48 | rx, 0x0F); X2(0x7E, 0xC0 | (d & 7));           // movq rd, xmm0
                } else if (el == "int") { X3(0x4B | (rx << 2), 0x63, dm); X1(0x9A); }      // movsxd rd, dword [r10+r11*4]
                else { X3(0x43 | (rx << 2), 0x8B, dm); X1(0x9A); }                 // mov rd, [r10+r11*4] (零扩展)
            } else { X3(0x4B | (rx << 2), 0x8B, dm); X1(0xDA); }                   // mov rd, [r10+r11*8]
            return;
        }
        if (esz == 1) {
            if (el == "sbyte") {
                // 寄存器形式 bit21 必须=1:0x38C0… 缺位,编码落进 LDTRSB
                // 立即数类(实际发成 ldtrsb w,[x,#imm]);byte 一条本来就对。
                // 批37b:opc 位再修——0x38E0… 是 ldrsb **w**t(符号扩展止步
                // 32,高 32 清零,负值读回 4294967289 一类);ldrsb xt 的
                // opc=10。汇编器对质定案:0x38A07820=ldrsh x0、0x38E07820
                // =ldrsh w0(otool -tvV 把 xt 形也显示成 w 寄存器,别信显示)。
                E4(0x38A06800 | (idxReg << 16) | (arrReg << 5) | dstReg);  // ldrsb xd, [xn, xi]
            } else {
                E4(0x38606800 | (idxReg << 16) | (arrReg << 5) | dstReg);  // ldrb wd, [xn, xi]
            }
        } else if (esz == 2) {
            if (el == "short") {
                // bit21 + S=1 双修:0x78C0… 落 LDTRSH 类且无缩放,发成
                // ldtrsh w0,[x1,#6](t7 探针当场抓获)。
                // 批37b:0x78E0… 是 ldrsh wt(W 形)——负 short 数组读回
                // 全错;xt 形 opc=10,汇编器 0x78A07820 铁证。
                E4(0x78A07800 | (idxReg << 16) | (arrReg << 5) | dstReg);  // ldrsh xd, [xn, xi, lsl #1]
            } else {
                // ldrh 原本是合法编码但 S=0 无缩放,与 x86 的 [r+r*2] 分歧
                E4(0x78607800 | (idxReg << 16) | (arrReg << 5) | dstReg);  // ldrh wd, [xn, xi, lsl #1]
            }
        } else if (esz == 4) {
            if (el == "int") {
                E4(0xB8A07800 | (idxReg << 16) | (arrReg << 5) | dstReg);  // ldrsw xd, [xn, xi, lsl #2]
            } else if (el == "float") {
                // widen on the way out: single bits in the packed slot
                // (x16 is scratch: register 31 would be the zero register)
                E4(0xB8607800 | (idxReg << 16) | (arrReg << 5) | 16);  // ldr w16, [xn, xi, lsl #2]
                E4(0x1E27021F);                                        // fmov s31, w16
                E4(0x1E22C3FF);                                        // fcvt d31, s31
                E4(0x9E6603E0 | dstReg);                               // fmov xd, d31
            } else {
                E4(0xB8607800 | (idxReg << 16) | (arrReg << 5) | dstReg);  // ldr wd (uint/char bits)
            }
        } else {
            E4(0xF8607800 | (idxReg << 16) | (arrReg << 5) | dstReg);      // ldr xd, [xn, xi, lsl #3]
        }
    }

    // [arr base + idx * esz] = src (8-byte slots): the store twin of
    // EmitArrElemLoad. x86 stages the SCALED ADDRESS into r10 (lea with
    // r10+r11 SIB), then the value into r11 -- no third scratch register
    // is ever needed and no live v-home is clobbered (batch 32, the
    // dlg-intern face's copy loop was the first customer).
    void EmitArrElemStore(int esz, string el, int arrReg, int idxReg, int srcReg) {
        if (esz != 8 && esz != 4 && esz != 2 && esz != 1) { XFailClosed("unknown element store", curLine, curCol); return; }
        if (tgt86 == 1) {
            XGetV(arrReg, 10);
            XGetV(idxReg, 11);
            if (esz == 8) { X4(0xDA148D4F); }      // lea r10, [r10 + r11*8]
            else if (esz == 4) { X4(0x9A148D4F); } // lea r10, [r10 + r11*4]
            else if (esz == 2) { X4(0x5A148D4F); } // lea r10, [r10 + r11*2]
            else { X4(0x1A148D4F); }               // lea r10, [r10 + r11] (rm=100+SIB:1A 是 SIB,modrm 恒 14)
            XGetV(srcReg, 11);
            // REX 必须 4D(W|R|B):49 的 reg=011 无 R 位解码成 rbx——值全
            // 落 rbx,intern 槽保持零页,同 REX 族第五课(值在 reg 域 ≥r8
            // 必须 R 位)。32 位形式 R 不带 W = 45。窄宽沿用 EmitSpanElemStore
            // 批37b 校正过的 0x45(R|B) 族(esz2 加 0x66 前缀):r11b/r11w 取
            // 值寄存器低 8/16 位——窄整在寄存器模型里恒为 64 位符号扩展,
            // 截断到元素宽即存储语义(arm64 strb/strh 同理取 Ws 低位)。
            if (esz == 8) { X3(0x4D, 0x89, 0x1A); }                // mov [r10], r11
            else if (esz == 4) { X3(0x45, 0x89, 0x1A); }           // mov [r10], r11d
            else if (esz == 2) { X3(0x66, 0x45, 0x89); X1(0x1A); } // mov [r10], r11w
            else { X3(0x45, 0x88, 0x1A); }                         // mov [r10], r11b
            return;
        }
        // strb/strh 寄存器形基座已用汇编器对质(批38:as 逐条复核,
        // strb=0x38206800 / strh=0x78207800,与 5283 语句存储臂一致)
        if (esz == 8) { E4(0xF8207800 | (idxReg << 16) | (arrReg << 5) | srcReg); }        // str xs, [xn, xi, lsl #3]
        else if (esz == 4) { E4(0xB8207800 | (idxReg << 16) | (arrReg << 5) | srcReg); }   // str ws, [xn, xi, lsl #2]
        else if (esz == 2) { E4(0x78207800 | (idxReg << 16) | (arrReg << 5) | srcReg); }   // strh ws, [xn, xi, lsl #1]
        else { E4(0x38206800 | (idxReg << 16) | (arrReg << 5) | srcReg); }                 // strb ws, [xn, xi]
    }

    // byte[].ToStr() / ToStr(start, len) with the reference compiler's
    // PACKED byte layout (1 byte per element, probe-verified): the snapshot
    // host lowering walks 8-byte slots, so this call is claimed here and
    // routed to the packed reader below instead of _zan_ext_arr_slice_str.
    bool TryGenPackedSlice(Node e) {
        if (e == null || e.kind != AK.Call() || e.a == null
                || e.a.kind != AK.MemberAccess()) { return false; }
        string name = e.a.sval;
        Node r = e.a.a;
        int n = e.kids.Count;
        if (!((n == 0 || n == 2) && name == "ToStr" && ExtIsBytes(r)
                && !UserDefinesClsMember(null, "ToStr"))) { return false; }
        GenExpr(r);
        ExtPush(0);                              // arr
        if (n == 2) {
            GenExpr(e.kids[0]);
            ExtPush(0);
            GenExpr(e.kids[1]);
            ExtPush(0);
        } else {
            ExtCountOf(0, 9);                    // whole-array length
            LoadImm(0, 0);                       // start
            ExtPush(0);
            ExtPush(9);                          // len (top -> x2)
        }
        // stack (top down): len, start, arr
        ExtPop(2); ExtPop(1); ExtPop(0);
        BLInternal("_zan_packed_slice_str");
        return true;
    }

    // x0 = arr, x1 = start, x2 = len -> stamped string copy of the packed
    // bytes at arr[start..start+len). Same clamps as the host lowering:
    // start<0 -> 0, start>count -> count, len<0 -> 0, tail truncates.
    void HostEmitPackedSlice() {
        HostBegin("_zan_packed_slice_str");
        HostSave(0, 0);
        HostSave(1, 1);
        HostSave(2, 2);
        HostLoad(0, 0);
        ExtCountOf(0, 9);                        // x9 = count
        HostLoad(1, 1);
        ExtCmpImm(1, 0);
        int sPos = NL();
        EmitBcond(10, sPos);
        LoadImm(1, 0);
        Mark(sPos);
        HostCmp(1, 9);
        int sIn = NL();
        EmitBcond(9, sIn);
        ExtMov(1, 9);
        Mark(sIn);
        HostLoad(2, 2);
        ExtCmpImm(2, 0);
        int lPos = NL();
        EmitBcond(10, lPos);
        LoadImm(2, 0);
        Mark(lPos);
        ExtSubRR(9, 9, 1);                       // avail = count - start
        HostCmp(2, 9);
        int lIn = NL();
        EmitBcond(9, lIn);
        ExtMov(2, 9);
        Mark(lIn);
        HostSave(1, 1);                          // clamped start
        HostSave(2, 2);                          // clamped len
        HostLoad(0, 2);
        AddImm(0, 0, 1);
        BLExtern("_malloc");
        HostNonzero(0, "ext.pslice.malloc");
        HostSave(0, 3);                          // out
        ExtMov(10, 0);                           // out cursor
        HostLoad(11, 2);                         // remaining
        HostLoad(12, 0);                         // arr
        HostLoad(13, 1);                         // start
        AddRR(12, 12, 13);                       // packed: cursor = arr + start
        int slDone = NL();
        int slLoop = NL();
        Mark(slLoop);
        CbzReg(11, slDone);
        ExtLdrbImm(14, 12, 0);                   // ldrb w14, [x12]
        ExtStrbImm(14, 10, 0);
        AddImm(10, 10, 1);
        AddImm(12, 12, 1);                       // one byte per element
        AddImm(11, 11, -1);
        EmitB(slLoop);
        Mark(slDone);
        ExtStrbImm(31, 10, 0);                   // NUL
        HostLoad(0, 3);
        HostLoad(1, 2);
        BLInternal("_zan_host_copy");            // stamps + NUL
        HostSave(0, 4);
        HostLoad(0, 3);
        BLExtern("_free");
        HostLoad(0, 4);
        HostEnd();
    }

    Fld FieldOf(Node mem) {
        // keep the receiver's instantiation args (Box<double>) -- ClassTyOf
        // would strip them before the type-parameter substitution runs
        string cls = StaticTyOf(mem.a);
        if (cls == null) { return null; }
        return FieldOfInst(cls, mem.sval);
    }

    // field of the instantiated class: the declared field type comes back
    // with the receiver's concrete generic arguments substituted
    // ("List<T>" on Box<double> reads as "List<double>")
    Fld FieldOfInst(string cls, string name) {
        int lt = cls.IndexOf("<");
        string open = lt > 0 ? cls.Substring(0, lt) : cls;
        List<string> args = lt > 0
            ? SplitTyArgs(cls.Substring(lt + 1, cls.Length - lt - 2))
            : new List<string>();
        Cls c = FindClass(open);
        if (c == null) { return null; }
        // 批49:闭实例替换视图优先 —— 视图 Fld(替换 ty、off、expanded/
        // expCls)是特化布局与形状的单一真源(箱分配/克隆/构造体一律按
        // 视图落位);无视图(递归、基类/虚形状)回落开模板擦除槽
        if (c.tps.Count > 0 && args.Count == c.tps.Count) {
            Cls vc = StructInstViewOf(cls);
            if (vc != null) {
                Fld vf = FindField(vc, name);
                if (vf != null) { return vf; }
            }
        }
        Fld f = FindField(c, name);
        if (f == null || c.tps.Count == 0 || args.Count == 0) { return f; }
        Fld nf = new Fld(f.name, f.off, SubstTy(f.ty, c.tps, args), f.width, f.explicitLayout);
        nf.expanded = f.expanded;
        nf.expCls = f.expCls;                    // 批47:开模板字段恒为槽,随形状带过
        return nf;
    }

    // field of the class being emitted (implicit `this` references). A
    // specialization's `this` carries the instantiation (meth.sval2, e.g.
    // "Pool<string>"), so a field declared with the class's type parameter
    // ("T item") resolves through it: `item.ToString()` in Pair$int sees a
    // string field, not an unresolvable "T"
    Fld CurField(string name) {
        // pre-emission inference sweeps (tuple sweep inside
        // CollectClasses) run before any method body sets curCls
        Cls c = curCls != null ? FindClass(curCls) : null;
        Fld f = FindField(c, name);
        if (f == null || c == null || c.tps.Count == 0) { return f; }
        if (curMeth == null || curMeth.sval2 == null || curMeth.sval2 == "") { return f; }
        return FieldOfInst(curMeth.sval2, name);
    }

    // does ty name a type parameter of the class being emitted? Open
    // generic bodies emit before any instantiation fixes the parameter,
    // so type params stand for erased words (delegate signatures, dict
    // slots); concrete instantiations take the spec pipeline
    bool IsTypeParamErasedNg(string ty) {
        if (ty == null || curCls == null) { return false; }
        Cls c = FindClass(curCls);
        if (c == null) { return false; }
        int i = 0;
        while (i < c.tps.Count) { if (c.tps[i] == ty) { return true; } i = i + 1; }
        return false;
    }

    // One RAW byte as a fresh 1-byte string (strings are byte sequences).
    // Convert.ToString((char)b) is honest UTF-8 since the chrstr rewrite (b >= 0x80 renders multi-byte),
    // but the escape decoder needs literal-POOL bytes, not an encoded code
    // point: slice a fresh 1-byte string and overwrite the byte (string
    // index-write truncates to u8, native_string_ops semantics).
    string RawByteStr(int b) {
        string t = Convert.ToString((char)b);
        string s = t.Substring(0, 1);
        s[0] = b;
        return s;
    }

    // UTF-8 encoding of a code point as a byte string
    string CharBytesNg(int cp) {
        if (cp < 0x80) { return RawByteStr(cp); }
        if (cp < 0x800) {
            return RawByteStr(0xC0 + cp / 64) + RawByteStr(0x80 + cp % 64);
        }
        if (cp < 0x10000) {
            return RawByteStr(0xE0 + cp / 4096) + RawByteStr(0x80 + (cp / 64) % 64)
                + RawByteStr(0x80 + cp % 64);
        }
        return RawByteStr(0xF0 + cp / 262144) + RawByteStr(0x80 + (cp / 4096) % 64)
            + RawByteStr(0x80 + (cp / 64) % 64) + RawByteStr(0x80 + cp % 64);
    }

    bool IsHexDigNg(int c) {
        if (c >= 48 && c <= 57) { return true; }
        if (c >= 97 && c <= 102) { return true; }
        if (c >= 65 && c <= 70) { return true; }
        return false;
    }

    int HexValNg(int c) {
        if (c >= 48 && c <= 57) { return c - 48; }
        if (c >= 97 && c <= 102) { return c - 97 + 10; }
        return c - 65 + 10;
    }

    string DecodeLiteralNg(string raw) {
        string result = "";
        int i = 0;
        while (i < raw.Length) {
            string c = raw.Substring(i, 1);
            if ((int)raw[i] == 92 && i + 1 < raw.Length) {
                i = i + 1;
                int next = (int)raw[i];
                c = raw.Substring(i, 1);
                if (next == 110) { c = "\n"; }
                else if (next == 116) { c = "\t"; }
                else if (next == 114) { c = "\r"; }
                else if (next == 48) { c = "\0"; }
                else if (next == 120 || next == 88) {
                    // \xH[HH..]: greedy 1..4 hex digits (C# rule)
                    int hv = 0;
                    int cnt = 0;
                    i = i + 1;
                    while (cnt < 4 && i < raw.Length && IsHexDigNg((int)raw[i])) {
                        hv = hv * 16 + HexValNg((int)raw[i]);
                        i = i + 1;
                        cnt = cnt + 1;
                    }
                    c = CharBytesNg(hv);
                    result = result + c;
                    continue;
                }
                else if (next == 117 || next == 85) {
                    // \uHHHH / \UHHHHHHHH: fixed-width hex code point
                    int width = next == 117 ? 4 : 8;
                    int hv2 = 0;
                    int cnt2 = 0;
                    i = i + 1;
                    while (cnt2 < width && i < raw.Length && IsHexDigNg((int)raw[i])) {
                        hv2 = hv2 * 16 + HexValNg((int)raw[i]);
                        i = i + 1;
                        cnt2 = cnt2 + 1;
                    }
                    c = CharBytesNg(hv2);
                    result = result + c;
                    continue;
                }
            }
            result = result + c;
            i = i + 1;
        }
        return result;
    }

    // Whether a string-typed expression's NUL terminator is a reliable bound
    // for the substring window check (mirrors the C host's
    // expr_has_reliable_string_bounds): only string literals and plain local
    // identifiers of string type qualify. Everything else -- string
    // parameters, extern call results and raw FFI buffers kept in `string`
    // slots (the stdlib slices `struct dirent*` byte by byte) -- may carry
    // bytes past the first NUL or lack a length header entirely, so a
    // header-backed window check would reject in-range reads; those slice
    // raw.
    bool IsBoundedStrExpr(Node e) {
        if (e == null) { return false; }
        if (e.kind == AK.StringLit()) { return true; }
        if (e.kind == AK.Ident()) {
            int li = LocalIdx(e.sval);
            return li >= 0 && locTy[li] == "string" && locOpaq[li] == 0;
        }
        return false;
    }

    // does this expression evaluate to a string? (local type / field type /
    // string literal / concatenation / method with a string return type)
    bool IsStrExpr(Node e) {
        if (e == null) { return false; }
        if (e.kind == AK.AwaitExpr()) { return AsyncAwaitElemTyNg(e.a) == "string"; }
        if (e.kind == AK.Call() && HostCallRetTy(e) == "string") { return true; }
        if (e.kind == AK.StringLit()) { return true; }
        // (string)e keeps riding the heap string bits; without this a
        // cast-typed arg reaches WriteLine's int renderer and prints the
        // pointer (the reference prints the text)
        if (e.kind == AK.CastExpr() && e.type != null) {
            return e.type.sval == "string" || TypeFullName(e.type) == "string";
        }
        if (e.kind == AK.Binary()) {
            if (e.op == TK.QQ()) { return IsStrExpr(e.a) || IsStrExpr(e.b); }
            return e.op == TK.Plus() && (IsStrExpr(e.a) || IsStrExpr(e.b));
        }
        // both arms strings: the conditional yields a heap string either way
        if (e.kind == AK.Conditional()) { return IsStrExpr(e.b) && IsStrExpr(e.c); }
        // every arm's result a heap string: the switch yields a string
        // whichever arm wins (a missing discard falls to the null string)
        if (e.kind == AK.SwitchExpr()) {
            int i = 0;
            while (i < e.kids.Count) {
                if (!IsStrExpr(e.kids[i].b)) { return false; }
                i = i + 1;
            }
            return e.kids.Count > 0;
        }
        if (e.kind == AK.MemberAccess()) {
            string rmt = ReflMemberTy(e);
            if (rmt != null) { return rmt == "string"; }
            Fld f = FieldOf(e);
            if (f != null && f.ty == "string") { return true; }
            // class-qualified static field (`Registry.tag`); the receiver
            // must NAME a class -- a plain local (`blog.score`) is an
            // instance read even when another class declares a same-named
            // static, and FindStaticTy's by-name fallback would otherwise
            // mislabel it (kv.Key may still be an instance property read)
            if (e.a != null && e.a.kind == AK.Ident() && LocalIdx(e.a.sval) < 0
                    && FindClass(e.a.sval) != null) {
                string st2 = FindStaticTy(QualifiedCls(e.a.sval, e.a.sval2), e.sval);
                if (st2 != null) { return st2 == "string"; }
            }
            return PropGetterTy(e) == "string";
        }
        if (e.kind == AK.Ident()) {
            int li = LocalIdx(e.sval);
            if (li >= 0) { return locTy[li] == "string"; }
            Fld f = CurField(e.sval);
            if (f != null && f.ty == "string") { return true; }
            return FindStaticTy(curCls, e.sval) == "string";
        }
        if (e.kind == AK.Index()) {
            // instantiated generic containers carry string elements
            // (List<string> read through Box<string>.values)
            return ElemTyOf(e) == "string";
        }
        if (e.kind == AK.Call() && e.a != null) {
            if (e.a.kind == AK.MemberAccess()) {
                // string.Join(sep, List<string>) yields a heap string;
                // Substring too; any other member call falls through to
                // the user-method return type below
                if (e.a.sval == "Substring") { return true; }
                Node rj = e.a.a;
                if (rj != null && rj.kind == AK.Ident() && rj.sval == "string" && e.a.sval == "Join") { return true; }
                // Convert.ToString(x) yields a heap string
                if (rj != null && rj.kind == AK.Ident() && rj.sval == "Convert"
                        && e.a.sval == "ToString" && e.kids.Count == 1
                        && !UserDefinesClsMember("Convert", "ToString")) { return true; }
                // scalar x.ToString("spec"): the printf-render intrinsic
                // (spliced from interpolation holes) yields a heap string
                if (e.a.sval == "ToString" && e.kids.Count == 1
                        && e.kids[0] != null && e.kids[0].kind == AK.StringLit()
                        && ScalarToStringTy(e.a.a) != null) { return true; }
            }
            return CallRetTy(e) == "string";
        }
        // List<string> element reads yield heap strings (string indexing
        // yields a char codepoint -- see IsCharExpr, not a string)
        if (e.kind == AK.Index()) { return IsStrListOf(e.a); }
        return false;
    }

    // does this expression denote a List<string> (element reads are strings)?
    // does this expression evaluate to a List<double>/double[]? (element
    // reads are double bit patterns either way)
    bool IsDblListOf(Node e) {
        if (e == null) { return false; }
        if (e.kind == AK.Ident()) {
            int li = LocalIdx(e.sval);
            if (li < 0) { return false; }
            return IsDblListTy(locTy[li]);
        }
        if (e.kind == AK.MemberAccess()) {
            Fld f = FieldOf(e);
            return f != null && IsDblListTy(f.ty);
        }
        if (e.kind == AK.NewExpr()) {
            return e.type != null && IsDblListTy(TypeFullName(e.type) + (e.ival == 1 ? "[]" : ""));
        }
        return false;
    }

    bool IsDblListTy(string t) {
        return t == "List<double>" || t == "List<float>" || t == "double[]" || t == "float[]";
    }

    bool IsStrListOf(Node e) {
        if (e == null) { return false; }
        if (e.kind == AK.Ident()) {
            int li = LocalIdx(e.sval);
            if (li >= 0) { return locTy[li] == "List<string>" || locTy[li] == "string[]"; }
            Fld f = CurField(e.sval);
            return f != null && (f.ty == "List<string>" || f.ty == "string[]");
        }
        if (e.kind == AK.NewExpr()) {
            return e.type != null
                && (TypeFullName(e.type) == "List<string>"
                    || (e.ival == 1 && TypeFullName(e.type) + "[]" == "string[]"));
        }
        return false;
    }

    // does this expression evaluate to a double? (float literal / double
    // typed local or field / double-returning method / double arithmetic)
    // declared floating type: `float` rides the same f64 registers and
    // conversions as `double` (ngen keeps one floating representation)
    bool IsDblTy(string t) { return t == "double" || t == "float"; }

    bool IsDblExpr(Node e) {
        if (e == null) { return false; }
        if (e.kind == AK.AwaitExpr()) {
            string at2 = AsyncAwaitElemTyNg(e.a);
            return at2 == "double" || at2 == "float";
        }
        if (e.kind == AK.Conditional()) { return IsDblExpr(e.b) || IsDblExpr(e.c); }
        if (e.kind == AK.SwitchExpr()) {
            int i = 0;
            while (i < e.kids.Count) {
                if (IsDblExpr(e.kids[i].b)) { return true; }
                i = i + 1;
            }
            return false;
        }
        if (e.kind == AK.FloatLit()) { return true; }
        if (e.kind == AK.Unary() && e.op == TK.Minus()) { return IsDblExpr(e.a); }
        if (e.kind == AK.Binary()) {
            int op = e.op;
            if (op == TK.QQ()) {
                // a coalesce over a floating payload yields a double
                return IsDblExpr(e.b)
                    || (IsNulTy(StaticTyOf(e.a)) && IsDblTy(NulPayOf(StaticTyOf(e.a))));
            }
            if (op == TK.Plus() || op == TK.Minus() || op == TK.Star() || op == TK.Slash()) {
                return IsDblExpr(e.a) || IsDblExpr(e.b);
            }
            return false;
        }
        if (e.kind == AK.CastExpr() && e.type != null) { return IsDblTy(e.type.sval); }
        if (e.kind == AK.Index()) {
            if (ExprCls(e.a) == "Dict") { return IsDblTy(ElemTyOf(e)); }
            if (IsArrExpr(e.a)) {
                string at3 = ArrTyOf(e.a);
                return at3 == "double[]" || at3 == "float[]";
            }
            // a List's own element type (ElemTyOf resolves chains:
            // PolarStackTops' `tops[si][i]` reads List<List<double>>)
            if (ExprCls(e.a) == "List") { return IsDblTy(ElemTyOf(e)); }
            // Span<double>/Span<float> views carry their payload as FP bit
            // patterns (EmitSpanElemLoad shapes them so). Without this the
            // read types as integer and any double-domain consumer
            // re-converts the bits with scvtf -- the shared_table
            // float-column read corruption.
            string sct = SpanContainerTy(e.a);
            if (sct != null) { return IsDblTy(SpanTyElem(sct)); }
            return IsDblListOf(e.a);
        }
        if (e.kind == AK.MemberAccess()) {
            Fld f = FieldOf(e);
            if (f != null) { return IsDblTy(f.ty); }
            string pt = PropGetterTy(e);
            if (pt != null && pt != "") { return IsDblTy(pt); }
            // qualified static reads (Store.d, double.MaxValue) type
            // through StaticTyOf
            return IsDblTy(StaticTyOf(e));
        }
        if (e.kind == AK.Ident()) {
            int li = LocalIdx(e.sval);
            if (li >= 0) { return IsDblTy(locTy[li]); }
            Fld f = CurField(e.sval);
            if (f != null && IsDblTy(f.ty)) { return true; }
            return IsDblTy(FindStaticTy(curCls, e.sval));
        }
        if (e.kind == AK.Call() && e.a != null) {
            if (e.a.kind == AK.MemberAccess()) {
                Node rm = e.a.a;
                // Convert.ToDouble(x) is always double (gen0 lowerings)
                if (rm != null && rm.kind == AK.Ident() && rm.sval == "Convert"
                        && e.a.sval == "ToDouble" && e.kids.Count == 1) { return true; }
                // double.Parse(s) is always double
                if (rm != null && rm.kind == AK.Ident() && e.a.sval == "Parse"
                        && e.kids.Count == 1
                        && (rm.sval == "double" || rm.sval == "float"
                            || rm.sval == "Double" || rm.sval == "Single")) { return true; }
                // Math library calls: Sqrt/Floor/Ceiling/Pow/Sin/Cos/Tan/
                // Log/Exp/Round are always double; Abs/Max/Min are double
                // when any argument is
                if (rm != null && rm.kind == AK.Ident() && rm.sval == "Math") {
                    string mn = e.a.sval;
                    if (mn == "Sqrt" || mn == "Floor" || mn == "Ceiling" || mn == "Pow"
                            || mn == "Sin" || mn == "Cos" || mn == "Tan"
                            || mn == "Log" || mn == "Exp" || mn == "Round"
                            || mn == "Atan" || mn == "Asin" || mn == "Acos" || mn == "Atan2") { return true; }
                    if (mn == "Abs" && e.kids.Count == 1) { return IsDblExpr(e.kids[0]); }
                    if ((mn == "Max" || mn == "Min") && e.kids.Count == 2) {
                        return IsDblExpr(e.kids[0]) || IsDblExpr(e.kids[1]);
                    }
                }
            }
            return IsDblTy(CallRetTy(e));
        }
        return false;
    }

    // does this expression evaluate to a char? (char literals, string
    // indexing, char-typed locals/fields/statics -- rendering goes through
    // zan_rt_chrstr)
    bool IsCharExpr(Node e) {
        if (e == null) { return false; }
        if (e.kind == AK.AwaitExpr()) { return AsyncAwaitElemTyNg(e.a) == "char"; }
        if (e.kind == AK.CharLit()) { return true; }
        if (e.kind == AK.Index()) { return IsStrExpr(e.a); }
        if (e.kind == AK.CastExpr() && e.type != null) { return e.type.sval == "char"; }
        if (e.kind == AK.MemberAccess()) {
            if (PrimitiveConstRecvTy(e) == "char") { return true; }
            Fld f = FieldOf(e);
            return f != null && f.ty == "char";
        }
        if (e.kind == AK.Ident()) {
            int li = LocalIdx(e.sval);
            if (li >= 0) { return locTy[li] == "char"; }
            Fld f = CurField(e.sval);
            if (f != null && f.ty == "char") { return true; }
            return FindStaticTy(curCls, e.sval) == "char";
        }
        if (e.kind == AK.Call() && e.a != null) { return CallRetTy(e) == "char"; }
        return false;
    }

    // does this expression evaluate to a ulong? (ulong typed locals,
    // fields and method results; arithmetic carrying a ulong operand --
    // ulong is the only integer type whose slot can set the high bit)
    bool IsUlongExpr(Node e) {
        if (e == null) { return false; }
        if (e.kind == AK.AwaitExpr()) { return AsyncAwaitElemTyNg(e.a) == "ulong"; }
        if (e.kind == AK.IntLit()) {
            // a UL/lu-suffixed literal types as ulong (gen0's checker)
            return e.suffix - (e.suffix / 4) * 4 == 3;
        }
        if (e.kind == AK.Binary()) {
            int op = e.op;
            if (op == TK.Plus() || op == TK.Minus() || op == TK.Star()
                    || op == TK.Slash() || op == TK.Percent()
                    || op == TK.LessLess() || op == TK.GreaterGreater()
                    || op == TK.GreaterGreaterGreater()) {
                return IsUlongExpr(e.a) || IsUlongExpr(e.b);
            }
            return false;
        }
        if (e.kind == AK.CastExpr() && e.type != null) {
            return e.type.sval == "ulong" && !IsDblExpr(e.b);
        }
        if (e.kind == AK.MemberAccess()) {
            if (PrimitiveConstRecvTy(e) == "ulong") { return true; }
            Fld f = FieldOf(e);
            return f != null && f.ty == "ulong";
        }
        if (e.kind == AK.Ident()) {
            int li = LocalIdx(e.sval);
            if (li >= 0) { return locTy[li] == "ulong"; }
            Fld f = CurField(e.sval);
            if (f != null && f.ty == "ulong") { return true; }
            return FindStaticTy(curCls, e.sval) == "ulong";
        }
        if (e.kind == AK.Call() && e.a != null) {
            return CallRetTy(e) == "ulong";
        }
        return false;
    }

    // 32-bit-ness of an integer expression: 1 = signed int, 2 = unsigned
    // uint, 0 = long/ulong/unknown (leave 64-bit arithmetic alone). gen0
    // wraps int/uint arithmetic at the declared width.
    int Int32Kind(Node e) {
        if (e == null) { return 0; }
        if (e.kind == AK.IntLit()) {
            // literals emit as 64-bit values in gen0: `a * 3` reconciles the
            // i32 local up to i64 and never wraps, while `a + b` (two i32
            // locals) wraps at the operation. Only a shift's declared-width
            // count masking still treats a bare literal as int (ShiftMask32).
            return 0;
        }
        if (e.kind == AK.Unary() && e.op == TK.Minus()) { return Int32Kind(e.a); }
        if (e.kind == AK.Binary()) {
            int op = e.op;
            if (op == TK.Plus() || op == TK.Minus() || op == TK.Star()
                    || op == TK.Slash() || op == TK.Percent()) {
                int ka = Int32Kind(e.a);
                int kb = Int32Kind(e.b);
                if (ka == 2 && kb == 2) { return 2; }
                if (ka == 1 && kb == 1) { return 1; }
                return 0;
            }
            return 0;
        }
        if (e.kind == AK.CastExpr() && e.type != null) {
            if (e.type.sval == "int") { return 1; }
            if (e.type.sval == "uint") { return 2; }
            return 0;
        }
        if (e.kind == AK.MemberAccess()) {
            Fld f = FieldOf(e);
            if (f != null && f.ty == "int") { return 1; }
            if (f != null && f.ty == "uint") { return 2; }
            return 0;
        }
        if (e.kind == AK.Ident()) {
            // the local wins over a same-named field: PieLayout declares
            // both an `int total` field and (in Of) a `long total` local,
            // and letting the field answer made `total + s.Value(di)`
            // classify as int32 and Wrap32 the 64-bit sum
            int li = LocalIdx(e.sval);
            if (li >= 0) {
                if (locTy[li] == "int") { return 1; }
                if (locTy[li] == "uint") { return 2; }
                return 0;
            }
            string t = null;
            Fld f = CurField(e.sval);
            if (f != null) { t = f.ty; }
            if (t == null) { t = FindStaticTy(curCls, e.sval); }
            if (t == "int") { return 1; }
            if (t == "uint") { return 2; }
            return 0;
        }
        if (e.kind == AK.Call() && e.a != null) {
            string rt = CallRetTy(e);
            if (rt == "int") { return 1; }
            if (rt == "uint") { return 2; }
            return 0;
        }
        return 0;
    }

    // truncate x0 to its 32-bit slot width: signed re-extends the sign,
    // unsigned fills with zeros (gen0's declared-width arithmetic)
    void Wrap32(int kind) {
        if (tgt86 == 1) {
            if (kind == 1) { X3(0x48, 0x63, 0xFF); }     // movsxd rdi, edi
            else { X2(0x89, 0xFF); }                     // mov edi, edi (zero-extends to 64)
            return;
        }
        if (kind == 1) { Sxtw0(); }           // sbfm x0, x0, #0, #31
        else if (kind == 2) { E4(0xD3407C00); }      // ubfm x0, x0, #0, #31
    }

    // does this shift's LEFT operand declare a <=32-bit width? gen0 masks
    // the count by the declared width (a bare literal declares int; only
    // an L/UL suffix declares long), regardless of its 64-bit register form
    bool ShiftMask32(Node e) {
        if (e == null) { return false; }
        if (e.kind == AK.IntLit()) {
            int sfx = e.suffix - (e.suffix / 4) * 4;   // 1 = L, 3 = UL
            return sfx != 1 && sfx != 3;
        }
        return Int32Kind(e) != 0;
    }

    // ---- nullable value types (`int?`, `double?`, `T?` over enum/struct) ----
    // a nullable value is an 8-byte heap cell: the pointer IS the value, 0
    // is null, and the payload rides at [cell]. This mirrors gen0's
    // {payload, i1} struct observably: HasValue is ptr != 0, .Value guards
    // on null before loading, and lifted operators branch on the nulls
    // BEFORE any arithmetic (so `b / 0` with b null never divides).
    // Reference-type `?` erases at TypeFullName and never reaches here.

    // does the type NAME denote a nullable value?
    bool IsNulTy(string t) {
        return t != null && t.Length > 1 && t.Substring(t.Length - 1, 1) == "?";
    }
    string NulPayOf(string t) {
        return IsNulTy(t) ? t.Substring(0, t.Length - 1) : null;
    }
    // does this payload type name accept a `?`?
    bool IsNulableValueTy(string t) {
        if (t == "bool" || t == "byte" || t == "sbyte" || t == "short"
                || t == "ushort" || t == "int" || t == "uint" || t == "long"
                || t == "ulong" || t == "nint" || t == "nuint"
                || t == "char" || t == "float" || t == "double") { return true; }
        if (FindEnum(t) >= 0) { return true; }
        Cls sc = FindClass(t);
        return sc != null && sc.isStruct == 1;
    }

    // sizeof(T): the mapped store width (oracle map_type: i1/i8 -> 1,
    // i16 -> 2, i32/f32 -> 4, i64/f64 -> 8; char maps to i64)
    int SizeOfTyName(string t) {
        if (t == "bool" || t == "byte" || t == "sbyte") { return 1; }
        if (t == "short" || t == "ushort") { return 2; }
        if (t == "int" || t == "uint" || t == "float") { return 4; }
        return 8;
    }
    // does this expression carry a nullable value (or the null literal,
    // which rides as the null cell)?
    bool IsNulExpr(Node e) {
        if (e == null) { return false; }
        if (e.kind == AK.NullLit()) { return true; }
        if (IsNulTy(StaticTyOf(e))) { return true; }
        if (e.kind == AK.Binary()) {
            if (e.op == TK.QQ()) { return IsNulExpr(e.b); }
            if (e.op == TK.Plus() || e.op == TK.Minus() || e.op == TK.Star()
                    || e.op == TK.Slash() || e.op == TK.Percent()) {
                return IsNulExpr(e.a) || IsNulExpr(e.b);
            }
        }
        return false;
    }

    // box a payload into a fresh nullable cell; x0 leaves holding the cell.
    // The payload ALWAYS rides x0 as its bit pattern (the internal value
    // model); dbl names the payload kind only, nothing reads d0 here. No
    // caller may rely on GenExpr leaving a value in d0: since FloatLit
    // became a compile-time immediate it only sets x0.
    void GenNulWrap(bool dbl) {
        XPushV0();                              // push payload
        LoadImm(0, 8);
        LoadImm(1, 0);
        BLInternal("_zan_rt_alloc");                 // x0 = zeroed cell
        XPopV(1);                              // x1 = payload
        StrU(1, 0, 0);                               // cell->payload
    }

    // string form of a nullable value for concat/Write: null renders ""
    // (gen0 prints the empty string), a payload renders per its kind
    void GenNulToStr(Node e) {
        string pay = NulPayOf(StaticTyOf(e));
        GenExpr(e);                                  // x0 = cell
        int isnul = NL();
        int fin = NL();
        CbzReg(0, isnul);                            // null: the empty string
        LdrU(0, 0, 0);                               // payload
        if (pay != null && IsDblTy(pay)) { BLInternal("_zan_rt_dbl2str"); }
        else if (pay == "char") { BLInternal("_zan_rt_chrstr"); }
        else if (pay == "ulong") { BLInternal("_zan_rt_uint2str"); }
        else { BLInternal("_zan_rt_int2str"); }
        EmitB(fin);
        Mark(isnul);
        LoadStr(InternStr(""), 0);
        Mark(fin);
    }

    // `x.HasValue` / `x.Value` on a nullable value
    void GenNulMemberRead(Node e) {
        GenExpr(e.a);                                // x0 = cell
        if (e.sval == "HasValue") {
            int no = NL();
            int fin = NL();
            CbzReg(0, no);
            LoadImm(0, 1);
            EmitB(fin);
            Mark(no);
            LoadImm(0, 0);
            Mark(fin);
            return;
        }
        int ok = NL();
        CbnzReg(0, ok);
        LoadSymRef("l_.str." + guardFileIdx, 0);
        LoadImm(1, curLine);
        LoadImm(2, curCol);
        LoadSymRef("l_.str." + guardNulVal, 3);
        BLInternal("_zan_rt_guard_fail3");
        LoadImm(0, 0);
        Mark(ok);
        LdrU(0, 0, 0);                               // payload
        if (IsDblTy(NulPayOf(StaticTyOf(e.a)))) { if (tgt86 == 1) { X3(0x66, 0x48, 0x0F); X2(0x6E, 0xC7); } else { E4(0x9E670000); } }   // fmov d0, x0
    }

    // a builtin binary op with a nullable VALUE operand: lifted semantics.
    // String operands stay on the concat/strcmp paths.
    bool IsLiftedNulBinary(Node e) {
        int op = e.op;
        if (op == TK.Plus() || op == TK.Minus() || op == TK.Star()
                || op == TK.Slash() || op == TK.Percent()
                || op == TK.Less() || op == TK.Greater()
                || op == TK.LessEq() || op == TK.GreaterEq()
                || op == TK.EqEq() || op == TK.BangEq()) {
            if (IsStrExpr(e.a) || IsStrExpr(e.b)) { return false; }
            return (e.a != null && IsNulTy(StaticTyOf(e.a)))
                || (e.b != null && IsNulTy(StaticTyOf(e.b)));
        }
        return false;
    }

    // lifted operator over nullables: either side may be null; arithmetic
    // yields null without running (so `b / 0` with b null never divides),
    // == answers both-null as equal, relational answers false. Arithmetic
    // wraps its result into a fresh cell.
    void GenLiftedNulBinary(Node e) {
        int op = e.op;
        bool arith = op == TK.Plus() || op == TK.Minus() || op == TK.Star()
            || op == TK.Slash() || op == TK.Percent();
        string pay = NulPayOf(StaticTyOf(e.a));
        if (pay == null) { pay = NulPayOf(StaticTyOf(e.b)); }
        bool dbl = IsDblTy(pay);
        GenExpr(e.a);
        if (!IsNulExpr(e.a)) { GenNulWrap(IsDblExpr(e.a)); }    // payload -> cell
        XPushV0();                              // push left cell
        GenExpr(e.b);
        if (!IsNulExpr(e.b)) { GenNulWrap(IsDblExpr(e.b)); }
        XPopV(1);                              // x1 = left, x0 = right
        int done = NL();
        int lnn = NL();
        int rnn = NL();
        CbnzReg(1, lnn);
        // left null: == true, everything else null/false
        if (op == TK.EqEq()) { LoadImm(0, 1); } else { LoadImm(0, 0); }
        EmitB(done);
        Mark(lnn);
        CbnzReg(0, rnn);
        // right null: != true, the rest false
        if (op == TK.BangEq()) { LoadImm(0, 1); } else { LoadImm(0, 0); }
        EmitB(done);
        Mark(rnn);
        // both non-null: apply the operator to the payloads
            if (dbl) {
                LdrU(2, 1, 0);                           // left payload bits
                LdrU(3, 0, 0);                           // right payload bits
                // movq xmm0, rdx / movq xmm1, rcx:每条 movq 都要完整的
                // 66 48 0F 6E /r 前缀——首版两条共用一个 X3,第二条只剩
                // 6E C9,解码成 outsb+leave,leave 拆掉 rbp 后全函数的
                // [rbp-…] 局部寻址全烂(批46 float_shapes 提升加法
                // 退野跳转实)
                if (tgt86 == 1) { X3(0x66, 0x48, 0x0F); X2(0x6E, 0xC2); X3(0x66, 0x48, 0x0F); X2(0x6E, 0xC9); } else { E4(0x9E670040); E4(0x9E670061); }                          // fmov d0, x2 / d1, x3
            if (op == TK.Plus()) {
                if (tgt86 == 1) { X4(0xC1580FF2); } else { E4(0x1E602820); }                      // fadd d0, d1, d0
            } else if (op == TK.Minus()) {
                E4(0x1E603820);                      // fsub d0, d1, d0
            } else if (op == TK.Star()) {
                E4(0x1E604820);                      // fmul d0, d1, d0
            } else if (op == TK.Slash()) {
                E4(0x1E605820);                      // fdiv d0, d1, d0
            } else if (op == TK.Less()) {
                // x86:comisd xmm1, xmm0 + seta——b>a 有序 ⇔ a<b;NaN
                // (ZF=CF=1) 落 seta=0,与 fcmp+cset lt 的 NaN→false 对齐。
                // 首版 comisd xmm0, xmm1 + seta 算的是 a>b——四条关系
                // 运算两两并轨(a<b 印 ge,批46 float_shapes 实证)。
                if (tgt86 == 1) { X3(0x66, 0x0F, 0x2F); X1(0xC8); XSetV0cc(0x97); } else { E4(0x1E612000); E4(0x9A9FA7E0); }                      // comisd xmm1, xmm0 + seta(b>a ⇔ a<b)
            } else if (op == TK.Greater()) {
                if (tgt86 == 1) { X3(0x66, 0x0F, 0x2F); X1(0xC1); } else { E4(0x1E612000); }
                if (tgt86 == 1) { X3(0x0F, 0x97, 0xC0); X3(0x48, 0x0F, 0xB6); X1(0xF8); } else { E4(0x9A9FD7E0); }                      // cset x0, gt
            } else if (op == TK.LessEq()) {
                // comisd xmm1, xmm0 + setae:b>=a 有序 ⇔ a<=b,NaN→0。
                // 首版不换操作数,算成 a>=b(与 GreaterEq 并轨)。
                if (tgt86 == 1) { X3(0x66, 0x0F, 0x2F); X1(0xC8); XSetV0cc(0x93); } else { E4(0x1E612000); E4(0x9A9FC7E0); }                      // comisd xmm1, xmm0 + setae(b>=a ⇔ a<=b,NaN→0)
            } else if (op == TK.GreaterEq()) {
                if (tgt86 == 1) { X3(0x66, 0x0F, 0x2F); X1(0xC1); } else { E4(0x1E612000); }
                if (tgt86 == 1) { X3(0x0F, 0x93, 0xC0); X3(0x48, 0x0F, 0xB6); X1(0xF8); } else { E4(0x9A9FB7E0); }                      // cset x0, ge
            } else if (op == TK.EqEq()) {
                if (tgt86 == 1) { X3(0x66, 0x0F, 0x2F); X1(0xC8); } else { E4(0x1E602020); }
                if (tgt86 == 1) { X3(0x0F, 0x94, 0xC0); X3(0x48, 0x0F, 0xB6); X1(0xF8); } else { E4(0x9A9F17E0); }                      // cset x0, eq
            } else if (op == TK.BangEq()) {
                if (tgt86 == 1) { X3(0x66, 0x0F, 0x2F); X1(0xC8); } else { E4(0x1E602020); }
                if (tgt86 == 1) { X3(0x0F, 0x95, 0xC0); X3(0x48, 0x0F, 0xB6); X1(0xF8); } else { E4(0x9A9F07E0); }                      // cset x0, ne
            }
            if (arith) {
                if (tgt86 == 1) { X3(0x66, 0x48, 0x0F); X2(0x7E, 0xC7); } else { E4(0x9E660000); }                      // fmov x0, d0
                GenNulWrap(true);
            }
        } else {
            LdrU(1, 1, 0);                           // left payload -> x1
            LdrU(0, 0, 0);                           // right payload -> x0
            if (op == TK.Plus()) {
                AddRR(0, 1, 0);                      // add x0, x1, x0
                if (pay == "int") { Wrap32(1); }
            } else if (op == TK.Minus()) {
                SubRR(0, 1, 0);                      // sub x0, x1, x0
                if (pay == "int") { Wrap32(1); }
            } else if (op == TK.Star()) {
                MaddRR(0, 1, 0, 31);                      // mul x0, x1, x0
                if (pay == "int") { Wrap32(1); }
            } else if (op == TK.Slash() || op == TK.Percent()) {
                // the lifted divide keeps the ordinary guards; a null
                // operand never reaches this point
                int bad = NL();
                int cont = NL();
                int safe = NL();
                CbzReg(0, bad);
                EmitB(cont);
                Mark(bad);
                XPushR(1);                      // keep dividend
                LoadSymRef("l_.str." + guardFileIdx, 0);
                LoadImm(1, curLine);
                LoadImm(2, curCol);
                if (op == TK.Slash()) { LoadSymRef("l_.str." + guardDivIdx, 3); }
                else { LoadSymRef("l_.str." + guardModIdx, 3); }
                BLInternal("_zan_rt_guard_fail3");
                XPopV(1);
                LoadImm(0, 1);                       // safe divisor
                Mark(cont);
                LoadImm(2, 0x8000000000000000);
                LoadImm(3, -1);
                if (tgt86 == 1) { Xop(0x39, 7, 1); } else { E4(0xEB03001F); }                      // cmp x0, x3
                EmitBcond(1, safe);
                CmpRR(1, 2);                      // cmp x1, x2
                EmitBcond(1, safe);
                LoadImm(0, 1);
                Mark(safe);
                if (op == TK.Slash()) {
                    E4(0x9AC00C20);                  // sdiv x0, x1, x0
                    if (pay == "int") { Wrap32(1); }
                } else {
                    E4(0x9AC00C24);                  // sdiv x4, x1, x0
                    E4(0x9B008480);                  // msub x0, x4, x0, x1
                }
            } else if (op == TK.Less()) {
                CmpRR(1, 0);                      // cmp x1, x0
                CsetCondX0(11);                      // cset x0, lt
            } else if (op == TK.Greater()) {
                CmpRR(1, 0);
                if (tgt86 == 1) { X3(0x0F, 0x97, 0xC0); X3(0x48, 0x0F, 0xB6); X1(0xF8); } else { E4(0x9A9FD7E0); }                      // cset x0, gt
            } else if (op == TK.LessEq()) {
                CmpRR(1, 0);
                CsetCondX0(13);                      // cset x0, le
            } else if (op == TK.GreaterEq()) {
                CmpRR(1, 0);
                if (tgt86 == 1) { X3(0x0F, 0x93, 0xC0); X3(0x48, 0x0F, 0xB6); X1(0xF8); } else { E4(0x9A9FB7E0); }                      // cset x0, ge
            } else if (op == TK.EqEq()) {
                CmpRR(1, 0);
                if (tgt86 == 1) { X3(0x0F, 0x94, 0xC0); X3(0x48, 0x0F, 0xB6); X1(0xF8); } else { E4(0x9A9F17E0); }                      // cset x0, eq
            } else if (op == TK.BangEq()) {
                CmpRR(1, 0);
                if (tgt86 == 1) { X3(0x0F, 0x95, 0xC0); X3(0x48, 0x0F, 0xB6); X1(0xF8); } else { E4(0x9A9F07E0); }                      // cset x0, ne
            } else {
                LoadImm(0, 0);
            }
            if (arith) { GenNulWrap(false); }
        }
        Mark(done);
    }

    // does this expression evaluate to a bool? (comparisons / bool locals,
    // fields and method results -- WriteLine renders those true/false)
    bool IsBoolExpr(Node e) {
        if (e == null) { return false; }
        if (e.kind == AK.AwaitExpr()) { return AsyncAwaitElemTyNg(e.a) == "bool"; }
        if (e.kind == AK.BoolLit()) { return true; }
        if (e.kind == AK.Binary()) {
            int op = e.op;
            return op == TK.Less() || op == TK.Greater() || op == TK.LessEq()
                || op == TK.GreaterEq() || op == TK.EqEq() || op == TK.BangEq()
                || op == TK.AmpAmp() || op == TK.PipePipe();
        }
        if (e.kind == AK.Unary()) { return e.op == TK.Bang(); }
        if (e.kind == AK.MemberAccess()) {
            string rmt = ReflMemberTy(e);
            if (rmt != null) { return rmt == "bool"; }
            if (e.sval == "HasValue" && e.a != null && IsNulTy(StaticTyOf(e.a))) { return true; }
            Fld f = FieldOf(e);
            if (f != null) { return f.ty == "bool"; }
            return PropGetterTy(e) == "bool";
        }
        if (e.kind == AK.Ident()) {
            int li = LocalIdx(e.sval);
            if (li >= 0) { return locTy[li] == "bool"; }
            Fld f = CurField(e.sval);
            if (f != null && f.ty == "bool") { return true; }
            return FindStaticTy(curCls, e.sval) == "bool";
        }
        if (e.kind == AK.Call() && e.a != null) {
            // string.IsNullOrEmpty(s): gen0's inference fails on the
            // extension-method-in-static form, so WriteLine renders its
            // 0/1 result numerically instead of true/false
            if (e.a.kind == AK.MemberAccess() && e.a.sval == "IsNullOrEmpty"
                    && e.kids.Count == 1 && e.a.a != null
                    && e.a.a.kind == AK.Ident()
                    && (e.a.a.sval == "string" || e.a.a.sval == "String")) {
                return false;
            }
            // gen0 lowers STRING Contains to a 0/1 int probe, so WriteLine
            // renders it numerically (log_rolling_file golden prints 0/1,
            // not true/false); List.Contains keeps its declared bool and
            // renders true/false
            if (e.a.kind == AK.MemberAccess() && e.a.sval != null
                    && e.a.a != null && IsStrExpr(e.a.a)) {
                string cn9 = e.a.sval;
                int d9 = cn9.IndexOf("$");
                if (d9 > 0) { cn9 = cn9.Substring(0, d9); }
                if (cn9 == "Contains") { return false; }
            }
            return CallRetTy(e) == "bool";
        }
        return false;
    }

    string MethRetTy(string name) {
        List<int> cs = MethCandsName(name);
        if (cs == null) { return ""; }
        int i = 0;
        while (i < cs.Count) {
            // TypeFullName keeps the array suffix and generic argument;
            // type.sval alone would turn a `byte[]` return into "byte"
            if (methNodes[cs[i]].type != null) { return TypeFullName(methNodes[cs[i]].type); }
            i = i + 1;
        }
        return "";
    }

    // declared return type of a call with the receiver's type arguments
    // substituted for the declaring class's type parameters: with
    // `Box<string> b`, `b.At(i)` reads as `string`, not the bare `T`
    // (gen0 instantiates generics; ngen substitutes textually). Falls
    // back to the raw declared type whenever either side is unknown.
    // type of a call's callee VALUE, typing the receiver chain once; mirrors
    // StaticTyOfInner's MemberAccess arm for member callees. CallRetTy needs
    // both the callee's type (delegate dispatch) and the receiver's class
    // (generic SubstTy tail); typing each independently re-walks a fluent
    // chain's prefix per level and turns a 12-call chain into an
    // exponential number of walks (DownloadJob.SnapshotPolicy hang).
    string CalleeTyOf(Node cc) {
        if (cc == null) { return null; }
        if (cc.kind != AK.MemberAccess()) { return StaticTyOf(cc); }
        if ((cc.sval == "Keys" || cc.sval == "Values") && ExprCls(cc.a) == "Dict") {
            return "List<" + DictSlotTy(cc.a, cc.sval == "Keys") + ">";
        }
        if (cc.a != null && cc.a.kind == AK.Ident() && FindEnum(cc.a.sval) >= 0) { return cc.a.sval; }
        Fld f = FieldOf(cc);
        return f != null ? f.ty : null;
    }

    string CallRetTy(Node e) {
        string dty = DelegateCallRetTy(e);
        if (dty != null) { return dty; }
        string rct = ReflCallRetTy(e);
        if (rct != null) { return rct; }
        Node cc = DelegateCalleeNg(e);
        if (cc == null) { cc = e.a; }
        string recvTy = null;
        string valTy = null;
        if (cc != null && cc.kind == AK.MemberAccess() && cc.a != null) {
            // one walk down the receiver chain; FieldOf's substitution is
            // applied directly so the chain is not re-typed
            recvTy = StaticTyOf(cc.a);
            if (recvTy != null) {
                Fld cf = FieldOfInst(recvTy, cc.sval);
                if (cf != null) { valTy = cf.ty; }
            }
        } else {
            valTy = StaticTyOf(cc);
        }
        if (valTy != null && IsDelegateTyNg(valTy)) { return DelegateRetNg(valTy); }
        // `E(args)` on a class instance dispatches the class's static
        // op_call protocol (the emitter rewrites to Cls.op_call(E, args)
        // and resolves by fit). The type model must answer with the SAME
        // overload's declared return -- resolving the bare call by name
        // finds nothing (the receiver is a local, not a class), consumers
        // see "no type", and WriteLine prints the returned string pointer
        // as an integer
        if (valTy != null && e.a == cc && FindClass(valTy) != null
                && e.kids != null && OpStaticSym(valTy, "op_call") != null) {
            Node oma = new Node(AK.MemberAccess());
            Node otn = new Node(AK.Ident());
            otn.sval = valTy;
            oma.a = otn;
            oma.sval = "op_call";
            Node osyn = new Node(AK.Call());
            osyn.a = oma;
            osyn.Add(cc);
            int oki = 0;
            while (oki < e.kids.Count) { osyn.Add(e.kids[oki]); oki = oki + 1; }
            int oidx = ResolveStaticNg(osyn);
            if (oidx >= 0 && methNodes[oidx].type != null) {
                return TypeFullName(methNodes[oidx].type);
            }
        }
        // instance op_call: `E(args)` is E.op_call(args); answer the same
        // overload's declared return so consumers see the real type
        if (valTy != null && e.a == cc && FindClass(valTy) != null
                && cc != null && cc.kind == AK.Ident() && LocalIdx(cc.sval) >= 0) {
            List<int> occ = new List<int>();
            InstanceCands(valTy, "op_call", occ);
            if (occ.Count > 0) {
                int ocPick = FitPickIdx(occ, e);
                if (ocPick >= 0 && methNodes[ocPick].type != null) {
                    return TypeFullName(methNodes[ocPick].type);
                }
            }
        }
        string ht = HostCallRetTy(e);
        if (ht != null) { return ht; }
        // Task.Spawn/Task.Run(<async call>) yields the coroutine handle as a
        // long (Task has no stdlib class the type model could consult)
        if (e.a != null && e.a.kind == AK.MemberAccess() && e.a.a != null
                && e.a.a.kind == AK.Ident() && e.a.a.sval == "Task"
                && (e.a.sval == "Spawn" || e.a.sval == "Run")
                && e.kids != null && e.kids.Count == 1) {
            return "long";
        }
        string st = StringCallRetTy(e);
        if (st != null) { return st; }
        // builtin ToString renders a string although no user method
        // declares it: enum receivers do a member-name lookup and scalar
        // receivers go through the shared renderers (GenCall's builtin
        // branches run before user dispatch, so the type model must agree
        // -- otherwise consumers like WriteLine see "no type" and print
        // the returned pointer as an integer)
        if (e.a != null && e.a.kind == AK.MemberAccess() && e.a.sval == "ToString"
                && e.kids != null && e.kids.Count == 0 && e.a.a != null
                && (EnumTyOf(e.a.a) != null || ScalarToStringTy(e.a.a) != null)) {
            return "string";
        }
        if (e.a != null && e.a.kind == AK.MemberAccess() && e.a.sval == "TryParse"
                && e.kids != null && e.kids.Count == 2 && e.a.a != null
                && e.a.a.kind == AK.Ident() && FindEnum(e.a.a.sval) >= 0) {
            return "bool";
        }
        // Dictionary Remove the runtime lowers directly; the reference types
        // it bool (prints true/false) while ContainsKey/TryGetValue stay int
        // (prints 0/1). Keep the model exact. The callee may carry a generic
        // spec suffix ("Remove$string"), so compare the bare name.
        if (e.a != null && e.a.kind == AK.MemberAccess() && e.a.sval != null
                && e.kids != null && e.kids.Count == 1) {
            string rname = e.a.sval;
            int rd = rname.IndexOf("$");
            if (rd > 0) { rname = rname.Substring(0, rd); }
            // name check BEFORE ExprCls: typing the receiver here re-walks
            // fluent-chain prefixes and compounds per level
            if (rname == "Remove" && e.a.a != null && ExprCls(e.a.a) == "Dict") { return "bool"; }
        }
        // File.Exists the runtime answers with a 0/1 bool (feeds `!`/if directly)
        if (e.a != null && e.a.kind == AK.MemberAccess() && e.a.sval == "Exists"
                && e.a.a != null && e.a.a.kind == AK.Ident() && e.a.a.sval == "File"
                && e.kids != null && e.kids.Count == 1) {
            return "bool";
        }
        int staticIdx = ResolveStaticNg(e);
        if (staticIdx < 0 && e.a != null && e.a.kind == AK.Ident() && LocalIdx("this") >= 0) {
            List<int> inst = new List<int>();
            InstanceCands(curCls, e.a.sval, inst);
            if (inst.Count > 0) {
                int ii = inst.Count == 1 ? inst[0] : FitPickIdx(inst, e);
                if (ii >= 0) { return TypeFullName(methNodes[ii].type); }
            }
            // curCls's own statics (incl. inherited) outrank the global name
            // table: same-named methods across classes are common once the
            // real stdlib compiles (jsongen.GenClass vs irgen.GenClass)
            string wcls = curCls;
            while (wcls != null && staticIdx < 0) {
                List<int> wc2 = MethCandsClsName(wcls, e.a.sval);
                if (wc2 != null) {
                    int wi = 0;
                    while (wi < wc2.Count) {
                        if (methStat[wc2[wi]] == 1) { staticIdx = wc2[wi]; break; }
                        wi = wi + 1;
                    }
                }
                Cls wc = FindClass(wcls);
                wcls = wc != null ? wc.baseName : null;
            }
        }
        string rty = null;
        string rcv = null;
        if (staticIdx >= 0) {
            rty = TypeFullName(methNodes[staticIdx].type);
        } else if (e.a != null && e.a.kind == AK.MemberAccess() && e.a.a != null) {
            // the receiver's class chain outranks the global name table:
            // same-named methods across classes are common (SignalString.Get
            // vs SignalInt.Get) and the global pick is arbitrary
            rcv = recvTy != null ? recvTy : StaticTyOf(e.a.a);
            if (rcv != null && !IsDelegateTyNg(rcv)) {
                string w2 = rcv;
                int lt9 = w2.IndexOf("<");
                if (lt9 > 0) { w2 = w2.Substring(0, lt9); }
                List<int> ic = new List<int>();
                while (w2 != null && ic.Count == 0) {
                    InstanceCands(w2, e.a.sval, ic);
                    if (ic.Count == 0) {
                        Cls c9 = FindClass(w2);
                        w2 = c9 != null ? c9.baseName : null;
                        if (w2 != null) {
                            int lt = w2.IndexOf("<");
                            if (lt > 0 && w2.Substring(w2.Length - 1, 1) == ">") {
                                w2 = w2.Substring(0, lt);
                            }
                        }
                    }
                }
                int pick9 = ic.Count == 1 ? ic[0] : (ic.Count > 1 ? FitPickIdx(ic, e) : -1);
                if (pick9 >= 0) { rty = TypeFullName(methNodes[pick9].type); }
            }
        }
        if (rty == null || rty == "") {
            // instance-form extension calls (`xs.Sum()`) resolve through the
            // extension machinery, not the receiver's (builtin) member table
            // or the global name fallback -- gen0 types them from the
            // resolved overload's declared return type
            string ert = ExtRetTyWithRecvNg(e, rcv);
            if (ert != null && ert != "") { rty = ert; }
        }
        if (rty == null || rty == "") { rty = MethRetTy(e.a != null ? e.a.sval : null); }
        if (rty == null || rty == "") { return rty; }
        if (e.a == null || e.a.kind != AK.MemberAccess() || e.a.a == null) { return rty; }
        // recvTy (typed above, cc == e.a here) IS StaticTyOf(e.a.a): re-typing
        // it re-walks fluent-chain prefixes at every level, compounding
        // exponentially (DownloadJob.SnapshotPolicy hang). Only the
        // .Invoke-stripped shape needs a fresh type.
        string recv = recvTy;
        if (recv == null && e.a.sval == "Invoke") { recv = StaticTyOf(e.a.a); }
        if (recv == null) { return rty; }
        int lt = recv.IndexOf("<");
        if (lt <= 0 || recv.Substring(recv.Length - 1, 1) != ">") { return rty; }
        Cls rc = FindClass(recv.Substring(0, lt));
        if (rc == null || rc.tps.Count == 0) { return rty; }
        List<string> targs = SplitTyArgs(recv.Substring(lt + 1, recv.Length - lt - 2));
        return SubstTy(rty, rc.tps, targs);
    }

    // top-level comma split of a generic argument list ("Node, Box<Node>")
    List<string> SplitTyArgs(string s) {
        List<string> parts = new List<string>();
        string cur = "";
        int depth = 0;
        int i = 0;
        while (i < s.Length) {
            string ch = s.Substring(i, 1);
            if (ch == "<") { depth = depth + 1; }
            else if (ch == ">") { depth = depth - 1; }
            if (ch == "," && depth == 0) { parts.Add(cur); cur = ""; }
            else { cur = cur + ch; }
            i = i + 1;
        }
        if (cur != "") { parts.Add(cur); }
        return parts;
    }

    // rewrite type-parameter names inside a declared type string: bare
    // `T`, `T[]` and `Head<A, T>` forms all substitute
    string SubstTy(string t, List<string> ps, List<string> as2) {
        if (t == null || t == "") { return t; }
        if (ps == null || as2 == null) { return t; }
        if (IsArrTy(t)) { return SubstTy(t.Substring(0, t.Length - 2), ps, as2) + "[]"; }
        int lt = t.IndexOf("<");
        if (lt > 0 && t.Substring(t.Length - 1, 1) == ">") {
            string head = t.Substring(0, lt);
            List<string> kids = SplitTyArgs(t.Substring(lt + 1, t.Length - lt - 2));
            string res = SubstTy(head, ps, as2) + "<";
            int i = 0;
            while (i < kids.Count) {
                if (i > 0) { res = res + ","; }
                res = res + SubstTy(kids[i], ps, as2);
                i = i + 1;
            }
            return res + ">";
        }
        int pi = IndexOfStrNg(ps, t);
        if (pi >= 0) { return as2[pi]; }
        return t;
    }

    // dispatch a binary operator to a static op_* overload declared on
    // either operand's class (mirrors irgen's TryOpOverload): the call goes
    // through the ordinary static-call machinery, so overload fit, argument
    // narrowing and double conversion all behave like a written-out call.
    // Returns false when no overload applies and the builtin paths must run.
    bool TryOpOverloadNg(Node e) {
        if (IsStrExpr(e.a) || IsStrExpr(e.b)) { return false; }
        // comparisons against the null literal stay reference compares, so
        // an op_eq body can null-check without recursing into itself
        // (gen0 irgen's null_cmp rule)
        if ((e.a != null && e.a.kind == AK.NullLit())
                || (e.b != null && e.b.kind == AK.NullLit())) { return false; }
        string mn = OpMethodNameNg(e.op);
        if (mn == "") { return false; }
        string owner = null;
        string ca = ExprCls(e.a);
        if (ca != null && OpOverloadExists(ca, mn)) { owner = ca; }
        if (owner == null) {
            string cb = ExprCls(e.b);
            if (cb != null && OpOverloadExists(cb, mn)) { owner = cb; }
        }
        // gen0 semantics: only the exact op_* dispatches; `!=`/`==` without
        // their own overload fall back to reference comparison (the builtin
        // path), NOT to the negation of the paired operator
        if (owner == null) { return false; }
        Node callN = new Node(AK.Call());
        Node tgt = new Node(AK.Ident());
        tgt.line = e.line;
        tgt.col = e.col;
        tgt.sval = mn;
        callN.a = tgt;
        callN.line = e.line;
        callN.col = e.col;
        callN.kids.Add(e.a);
        callN.kids.Add(e.b);
        GenCall(callN);
        return true;
    }

    // operator token -> op_* overload method name ("" when not overloadeable)
    string OpMethodNameNg(int op) {
        if (op == TK.Plus()) { return "op_add"; }
        if (op == TK.Minus()) { return "op_sub"; }
        if (op == TK.Star()) { return "op_mul"; }
        if (op == TK.Slash()) { return "op_div"; }
        if (op == TK.Percent()) { return "op_mod"; }
        if (op == TK.EqEq()) { return "op_eq"; }
        if (op == TK.BangEq()) { return "op_neq"; }
        if (op == TK.Less()) { return "op_lt"; }
        if (op == TK.Greater()) { return "op_gt"; }
        if (op == TK.LessEq()) { return "op_le"; }
        if (op == TK.GreaterEq()) { return "op_ge"; }
        return "";
    }

    // does this class (or any base) declare a member with that name?
    bool OpOverloadExists(string cls, string name) {
        string c2 = cls;
        while (c2 != null) {
            if (UserDefinesClsMember(c2, name)) { return true; }
            Cls cc = FindClass(c2);
            c2 = cc != null ? cc.baseName : null;
        }
        return false;
    }

    // symbol of a static op_* method declared on cls, or null
    string OpStaticSym(string cls, string name) {
        List<int> cs = MethCandsClsName(cls, name);
        if (cs == null) { return null; }
        int i = 0;
        while (i < cs.Count) {
            if (methStat[cs[i]] == 1) {
                return MethSymNg(cls, methNodes[cs[i]]);
            }
            i = i + 1;
        }
        return null;
    }

    // shared IndexOf/Contains loop: value equality per element kind --
    // strings by strcmp, structs by their op_eq (when declared) else
    // field-wise, primitives by register compare (gen0 parity)
    void GenListFind(Node recv, Node arg, bool wantIndex) {
        GenListSearch(recv, arg, wantIndex, false);
    }

    void GenListSearch(Node recv, Node arg, bool wantIndex, bool remove) {
        int save = 19;
        while (save <= 23) { XPushR(save); save = save + 1; }
        GenExpr(recv);
        XPushV0();                          // push list
        GenExpr(arg);
        XPopV(1);                                // pop list -> x1 (x0 = value)
        MovRR(19, 1);                            // x19 = list
        MovRR(22, 0);                            // x22 = value
        LdrU(20, 19, 0);                         // x20 = count
        LdrU(21, 19, 16);                        // x21 = data
        if (tgt86 == 1) { LoadImm(23, 0); } else { E4(0xD2800017); }    // movz x23, #0 (i)
        Cls es = StructOf(arg);
        string eqSym = es != null ? OpStaticSym(es.name, "op_eq") : null;
        int lp = NL();
        int nof = NL();
        int yes = NL();
        int done = NL();
        Mark(lp);
        if (tgt86 == 1) { XGetV(23, 10); XGetV(20, 11); X3(0x4D, 0x39, 0xDA); } else { E4(0xEB1402FF); }   // cmp r10(i), r11(count)
        EmitBcond(10, nof);                      // b.ge nof
        EmitArrElemLoad(8, "long", 21, 23, 0);   // ldr x0, [x21, x23, lsl #3]
        if (IsStrExpr(arg)) {
            MovRR(1, 22);
            BLExtern("_strcmp");
            if (tgt86 == 1) { X3(0x83, 0xF8, 0x00); } else { E4(0x7100001F); }   // cmp eax, #0 (strcmp 返回在 eax)
            EmitBcond(0, yes);                   // b.eq
        } else if (eqSym != null) {
            MovRR(1, 22);
            BLInternal(eqSym);                   // bool op_eq(elem, value)
            EmitCbnz(0, yes);                    // non-zero -> hit
        } else if (es != null) {
            // field-wise: every slot must match (批43:扁平叶比较)
            int fail = NL();
            List<Fld> flatCt = new List<Fld>();
            FlatValueFields(es, flatCt, 0, new List<string>());
            int fi = 0;
            while (fi < flatCt.Count) {
                LoadFieldNg(2, 0, flatCt[fi]);
                LoadFieldNg(3, 22, flatCt[fi]);
                if (tgt86 == 1) { Xop(0x39, 1, 2); } else { E4(0xEB03005F); }    // cmp x3, x2
                EmitBcond(1, fail);              // b.ne
                fi = fi + 1;
            }
            EmitB(yes);
            Mark(fail);
        } else {
            if (tgt86 == 1) { XGetV(22, 11); X3(0x4C, 0x39, 0xDF); } else { E4(0xEB16001F); }   // cmp x0, x22
            EmitBcond(0, yes);                   // b.eq
        }
        AddImm(23, 23, 1);
        EmitB(lp);
        Mark(nof);
        if (wantIndex) { LoadImm(0, -1); } else { LoadImm(0, 0); }
        EmitB(done);
        Mark(yes);
        if (remove) {
            MovRR(0, 19);
            MovRR(1, 23);
            BLInternal("_zan_rt_list_removeat");
            LoadImm(0, 1);
        } else if (wantIndex) { MovRR(0, 23); } else { LoadImm(0, 1); }
        Mark(done);
        save = 23;
        while (save >= 19) { XPopV(save); save = save - 1; }
    }

    // nearest instance implementation of `name` strictly above curCls in the
    // base chain (base-call semantics: curCls's own overrides are skipped,
    // abstract declarations do not terminate the walk)
    int ResolveBaseImplNg(string name, Node call) {
        Cls mine = curCls != null ? FindClass(curCls) : null;
        string cur = mine != null ? mine.baseName : null;
        while (cur != null) {
            Cls cc = FindClass(cur);
            string cn = cc != null ? cc.name : cur;
            List<int> cands = new List<int>();
            List<int> cc2 = MethCandsClsName(cn, name);
            if (cc2 != null) {
                int q = 0;
                while (q < cc2.Count) {
                    if (methStat[cc2[q]] != 1) { cands.Add(cc2[q]); }
                    q = q + 1;
                }
            }
            int pick = cands.Count > 0 ? FitPickIdx(cands, call) : -1;
            if (pick >= 0 && !HasMod(methNodes[pick], MOD.Abstract())) { return pick; }
            cur = cc != null ? cc.baseName : null;
        }
        return -1;
    }

    void GenCall(Node e) {
        // Task.Spawn(<async call>) / Task.Run(<async call>) in a value
        // position: detach the coroutine, yield its handle (the statement
        // form is PrepareAsyncStmtNg's job and runs before this for ExprStmt)
        if (TryGenTaskSpawnValueNg(e)) { return; }
        // the pre-pass scans original bodies only; a call inside a
        // specialization body (the template's `SumNum<T>` after T bound to
        // int) would otherwise resolve to the OPEN generic template, whose
        // symbol is never emitted. The pre-pass's specMeth dedup makes the
        // second pass safe on original bodies.
        if (e.a != null && (e.a.kind == AK.Ident() || e.a.kind == AK.MemberAccess())) {
            CollectSpecsInEnvNg(e);
        }
        if (e.a != null && e.a.kind == AK.MemberAccess() && e.a.ival == 1) {
            // null-conditional call `a?.M(args)`: the receiver is tested
            // once; a null yields the null of the result type (a value
            // return wraps on the taken path). The ordinary call re-reads
            // the receiver -- fine for the suite's local receivers.
            Node qcal = e.a;
            string qrt = CallRetTy(e);
            GenExpr(qcal.a);                             // x0 = receiver
            int cqnull = NL();
            int cqfin = NL();
            CbzReg(0, cqnull);
            qcal.ival = 0;                               // ordinary call
            GenCall(e);
            qcal.ival = 1;
            if (qrt != null && IsNulableValueTy(qrt)) { GenNulWrap(IsDblTy(qrt)); }
            EmitB(cqfin);
            Mark(cqnull);
            LoadImm(0, 0);
            Mark(cqfin);
            return;
        }
        if (TryGenDelegateCall(e)) { return; }
        if (e.a != null && e.a.kind == AK.Ident() && e.a.sval == "sizeof"
                && e.kids.Count == 1) {
            // sizeof(T): the mapped type's store width (the oracle's
            // LLVMSizeOf -- char rides the i64 spelling, so 8); unknown
            // shapes answer the word size
            Node stk = e.kids[0];
            string stn = stk != null ? (stk.type != null ? TypeFullName(stk.type) : stk.sval) : "";
            LoadImm(0, SizeOfTyName(stn));
            return;
        }
        if (TryGenPackedSlice(e)) { return; }
        if (TryGenHostCall(e)) { return; }
        if (TryGenStringCall(e)) { return; }
        if (TryGenReflCall(e)) { return; }
        Node callee = e.a;
        if (callee != null && callee.kind == AK.MemberAccess()) {
            Node recv = callee.a;
            // nullable.GetValueOrDefault([fallback]): the payload when the
            // cell is set, else the fallback (0 / default(T))
            if (callee.sval == "GetValueOrDefault" && recv != null
                    && IsNulTy(StaticTyOf(recv))) {
                string gpay = NulPayOf(StaticTyOf(recv));
                GenExpr(recv);                           // x0 = cell
                int gnull = NL();
                int gend = NL();
                CbzReg(0, gnull);
                LdrU(0, 0, 0);                           // has: the payload
                if (IsDblTy(gpay)) { if (tgt86 == 1) { X3(0x66, 0x48, 0x0F); X2(0x6E, 0xC7); } else { E4(0x9E670000); } }   // fmov d0, x0
                EmitB(gend);
                Mark(gnull);
                if (e.kids.Count == 1) {
                    GenExpr(e.kids[0]);                  // null: the fallback
                    if (IsDblTy(gpay) && !IsDblExpr(e.kids[0])) { ConvI2D(); }
                } else {
                    LoadImm(0, 0);
                    if (IsDblTy(gpay)) { if (tgt86 == 1) { X3(0x66, 0x48, 0x0F); X2(0x6E, 0xC7); } else { E4(0x9E670000); } }   // fmov d0, x0
                }
                Mark(gend);
                return;
            }
            // Task-value members: t.Wait() pumps the driver until the frame
            // completes (and rethrows a captured exception, like Task.Wait);
            // t.Result waits and reads frame+32; t.IsCompleted answers the
            // done word. The null frame (an inline-run Task.Run body) is
            // already done with no result.
            if (recv != null) {
                string rtt = StaticTyOf(recv);
                if (rtt != null && (rtt == "Task" || rtt.IndexOf("Task<") == 0)
                        && (callee.sval == "Wait" || callee.sval == "Result"
                            || callee.sval == "IsCompleted")) {
                    GenExpr(recv);                       // x0 = frame handle
                    int tnull = NL();
                    int tend = NL();
                    if (callee.sval == "IsCompleted") {
                        CbzReg(0, tnull);
                        LdrU(0, 0, 8);                   // frame.done
                        if (tgt86 == 1) { X3(0x48, 0x83, 0xFF); X1(0x00); } else { E4(0xEB1F001F); }                  // cmp x0, xzr
                        if (tgt86 == 1) { X3(0x0F, 0x95, 0xC0); X3(0x48, 0x0F, 0xB6); X1(0xF8); } else { E4(0x9A9F07E0); }                  // cset x0, ne
                        EmitB(tend);
                        Mark(tnull);
                        LoadImm(0, 1);                   // null frame: done
                        Mark(tend);
                        return;
                    }
                    CbzReg(0, tnull);
                    XPushV0();                      // hold frame (receiver
                                                         //  must evaluate once)
                    AddImm(0, 0, 8);                     // x0 = &frame.done
                    LoadImm(1, 1);                       // mode 1: quiesce
                    BLInternal("_zan_co_sched_run_until");
                    PopV(9);                      // x9 = frame
                    if (callee.sval == "Result") {
                        AsyncSubExcCheckNg();            // Wait/Result rethrow
                        LdrU(0, 9, 32);                  // frame.result
                    }
                    EmitB(tend);
                    Mark(tnull);
                    LoadImm(0, 0);                       // null frame: inline-run
                                                         //  body, done, no result
                    Mark(tend);
                    return;
                }
            }
            // rect.GetLength(d): the dim lives at arr + 8*d in the mdarray
            // header (the rank>1 shape only)
            if (recv != null && callee.sval == "GetLength" && e.kids.Count == 1
                    && ArrContainerTy(recv) != null
                    && ArrRankOf(ArrContainerTy(recv)) > 1) {
                GenExpr(recv);                           // x0 = arr
                XPushV0();
                GenExpr(e.kids[0]);                      // x0 = dim
                XPopV(1);                          // pop arr -> x1
                E4(0xF8607820);                          // ldr x0, [x1, x0, lsl #3]
                return;
            }
            // arr.AsSpan([start[,len]]) / span.Slice(start[,len]): build the
            // boxed {base, len} view (see GenSpanView)
            if (recv != null && callee.sval == "AsSpan" && e.kids.Count <= 2
                    && ArrContainerTy(recv) != null) {
                GenSpanView(e, recv, ArrContainerTy(recv), false);
                return;
            }
            if (recv != null && callee.sval == "Slice" && e.kids.Count >= 1
                    && e.kids.Count <= 2 && SpanContainerTy(recv) != null) {
                GenSpanView(e, recv, SpanContainerTy(recv), true);
                return;
            }
            // base.Method(args): invoke the nearest implementation above
            // curCls directly (nonvirtual) with `this` as the receiver
            if (recv != null && (recv.kind == AK.BaseExpr() || (recv.kind == AK.Ident() && recv.sval == "base"))) {
                int bi2 = ResolveBaseImplNg(callee.sval, e);
                if (bi2 >= 0) {
                    GenExpr(new Node(AK.ThisExpr()));
                    XPushV0();                          // str x0, [sp, #-16]!
                    int pushed2 = PushCallArgs(methNodes[bi2], e);
                    int r2 = pushed2;
                    if (tgt86 == 1) {
                        while (r2 >= 1) {
                            if (r2 < 6) {
                                XopRMem(0x8B, XMapReal(r2), 4, 16 * (pushed2 - r2));
                            } else {
                                XopRMem(0x8B, 10, 4, 16 * (pushed2 - r2));
                                XSetV(XArgVOf(r2), 10);
                            }
                            r2 = r2 - 1;
                        }
                        XopRMem(0x8B, XMapReal(0), 4, 16 * pushed2);
                        XAddRsp(16 * (pushed2 + 1));
                        xStackArgs = pushed2 > 5 ? pushed2 - 5 : 0;
                    } else {
                        while (r2 >= 1) { XPopV(r2); r2 = r2 - 1; }
                        XPopV(0);                          // ldr x0, [sp], #16 (this)
                    }
                    BLInternal(MethSymNg(methCls[bi2], methNodes[bi2]));
                    return;
                }
            }
            if (recv != null && recv.kind == AK.Ident() && recv.sval == "Console"
                    && callee.sval == "WriteLine" && e.kids.Count == 1) {
                // own runtime core: print_int(i64) / println(str)
                if (IsStrExpr(e.kids[0])) {
                    GenExpr(e.kids[0]);
                    BLInternal("_zan_rt_println");
                } else if (IsCharExpr(e.kids[0])) {
                    GenExpr(e.kids[0]);
                    BLInternal("_zan_rt_chrstr");
                    BLInternal("_zan_rt_println");
                } else if (IsBoolExpr(e.kids[0])) {
                    // gen0 prints bools as true/false (select of literals)
                    GenExpr(e.kids[0]);
                    int fls = NL();
                    int doneb = NL();
                    CbzReg(0, fls);
                    LoadStr(InternStr("true"), 0);
                    EmitB(doneb);
                    Mark(fls);
                    LoadStr(InternStr("false"), 0);
                    Mark(doneb);
                    BLInternal("_zan_rt_println");
                } else if (IsDblExpr(e.kids[0])) {
                    GenExpr(e.kids[0]);
                    if (tgt86 != 1) { E4(0x9E670000); }  // fmov d0, x0 (x86 keeps the bits in rdi)
                    BLExtern("_zan_rt_print_double");
                } else if (IsUlongExpr(e.kids[0])) {
                    GenExpr(e.kids[0]);
                    BLInternal("_zan_rt_print_uint");
                } else if (IsNulExpr(e.kids[0])
                        && NulPayOf(StaticTyOf(e.kids[0])) != null) {
                    // a nullable value prints its payload, or an empty line
                    // when null (gen0's Nullable.ToString())
                    Node w0 = e.kids[0];
                    string wpay = NulPayOf(StaticTyOf(w0));
                    GenExpr(w0);                         // x0 = cell
                    int wnull = NL();
                    int wend = NL();
                    CbzReg(0, wnull);                    // null: empty line
                    LdrU(0, 0, 0);                       // payload
                    if (IsDblTy(wpay)) {
                        if (tgt86 != 1) { E4(0x9E670000); }   // fmov d0, x0 (x86 keeps the bits in rdi)
                        BLExtern("_zan_rt_print_double");
                    } else if (wpay == "char") {
                        BLInternal("_zan_rt_chrstr");
                        BLInternal("_zan_rt_println");
                    } else if (wpay == "ulong") {
                        BLInternal("_zan_rt_print_uint");
                    } else {
                        BLInternal("_zan_rt_print_int");
                    }
                    EmitB(wend);
                    Mark(wnull);
                    LoadStr(InternStr(""), 0);
                    BLInternal("_zan_rt_println");
                    Mark(wend);
                } else {
                    GenExpr(e.kids[0]);
                    BLInternal("_zan_rt_print_int");
                }
                return;
            }
            // Console.WriteLine() with no arguments prints just the newline
            if (recv != null && recv.kind == AK.Ident() && recv.sval == "Console"
                    && callee.sval == "WriteLine" && e.kids.Count == 0) {
                LoadStr(InternStr(""), 0);
                BLInternal("_zan_rt_println");
                return;
            }
            // Console.Write: no newline; gen0 routes every argument type
            // through its string form and printf("%s", s)
            if (recv != null && recv.kind == AK.Ident() && recv.sval == "Console"
                    && callee.sval == "Write" && e.kids.Count == 1) {
                Node arg = e.kids[0];
                if (IsStrExpr(arg)) { GenExpr(arg); }
                else if (IsCharExpr(arg)) {
                    GenExpr(arg); BLInternal("_zan_rt_chrstr");
                } else if (IsBoolExpr(arg)) {
                    GenExpr(arg);
                    int fls = NL();
                    int doneb = NL();
                    CbzReg(0, fls);
                    LoadStr(InternStr("true"), 0);
                    EmitB(doneb);
                    Mark(fls);
                    LoadStr(InternStr("false"), 0);
                    Mark(doneb);
                } else if (IsDblExpr(arg)) {
                    GenExpr(arg); BLInternal("_zan_rt_dbl2str");
                } else if (IsUlongExpr(arg)) {
                    GenExpr(arg); BLInternal("_zan_rt_uint2str");
                } else if (IsNulExpr(arg) && NulPayOf(StaticTyOf(arg)) != null) {
                    GenNulToStr(arg);                    // null renders ""
                } else {
                    GenExpr(arg); BLInternal("_zan_rt_int2str");
                }
                XPushV0();                      // push s (stack variadic)
                if (EnvTargetElf() == 1 || tgt86 == 1) {
                    LdrU(1, 31, 0);                  // 寄存器变参:SysV 第 2 参在 rsi
                                                     // (elf 臂同为寄存器变参 r1);
                                                     // arm64-darwin 变参在栈上,push 即可
                }
                LoadSymRef("l_.str." + fmtwIdx, 0);  // x0 = "%s"
                BLExtern("_printf");
                if (EnvTargetElf() == 0) {
                    AddSPImm(16, true);              // drop the Darwin stack slot
                }
                return;
            }
            // Math static methods. Integer forms: Abs is a negate and
            // Max/Min are a csel over a signed compare (gen0 lowers them
            // the same way for i64). Double forms call libm with the value
            // in d0 (Pow takes d0 + d1) and come back as the bit pattern
            // in x0.
            if (recv != null && recv.kind == AK.Ident() && recv.sval == "Math"
                    && !UserDefinesClsMember("Math", callee.sval)) {
                string mn = callee.sval;
                if (mn == "Abs" && e.kids.Count == 1) {
                    GenExpr(e.kids[0]);
                    if (IsDblExpr(e.kids[0])) {
                        DblLibm1("_fabs");
                    } else if (tgt86 == 1) { X3(0x48, 0xF7, 0xDF); }    // neg rdi
                    else {
                        E4(0xCB0003E0);                  // neg x0, x0
                    }
                    return;
                }
                if ((mn == "Max" || mn == "Min") && e.kids.Count == 2) {
                    if (IsDblExpr(e.kids[0]) || IsDblExpr(e.kids[1])) {
                        // both arguments move to d0/d1 only after BOTH are
                        // evaluated: GenExpr may call strtod (returning in
                        // d0) for lazy double literals, which would clobber
                        // a value parked in d0 early
                        GenExpr(e.kids[0]);
                        XPushV0();                  // push a
                        GenExpr(e.kids[1]);
                        XPopV(1);                        // pop a -> x1 (x0 = b)
                        if (tgt86 == 1) {
                            X3(0x66, 0x48, 0x0F); X2(0x6E, 0xCF);           // movq xmm1, rdi
                        } else { E4(0x9E670001); }       // fmov d1, x0
                        if (!IsDblExpr(e.kids[1])) {
                            if (tgt86 == 1) { X4(0x2A0F48F2); X1(0xCE); }   // cvtsi2sd xmm1, rsi
                            else { E4(0x9E620022); }     // scvtf d1, x1
                        }
                        MovRR(0, 1);                     // mov x0, x1
                        if (tgt86 == 1) {
                            X3(0x66, 0x48, 0x0F); X2(0x6E, 0xC7);           // movq xmm0, rdi
                        } else { E4(0x9E670000); }       // fmov d0, x0
                        if (!IsDblExpr(e.kids[0])) {
                            if (tgt86 == 1) { X4(0x2A0F48F2); X1(0xCF); }   // cvtsi2sd xmm0, rdi
                            else { E4(0x9E620020); }     // scvtf d0, x0
                        }
                        if (mn == "Max") { BLExtern("_fmax"); } else { BLExtern("_fmin"); }
                        if (tgt86 == 1) {
                            X3(0x66, 0x48, 0x0F); X2(0x7E, 0xC7);           // movq rdi, xmm0
                        } else { E4(0x9E660000); }       // fmov x0, d0
                    } else {
                        GenExpr(e.kids[0]);
                        XPushV0();                  // push a
                        GenExpr(e.kids[1]);
                        XPopV(1);                        // pop a -> x1 (x0 = b)
                        if (tgt86 == 1) {
                            Xop(0x39, 7, 6);             // cmp b, a (rdi-rsi; 编码 6=rsi, 1 是 rcx)
                            if (mn == "Max") { X4(0xFE4E0F48); }    // cmovle rdi, rsi (b<=a 取 a)
                            else { X4(0xFE4D0F48); }                // cmovge rdi, rsi (b>=a 取 a)
                        } else {
                            CmpRR(0, 1);              // cmp x0, x1
                            if (mn == "Max") { E4(0x9A81C000); } // csel x0, x0, x1, gt
                            else { E4(0x9A81B000); }         // csel x0, x0, x1, lt
                        }
                    }
                    return;
                }
                if (mn == "Sqrt" && e.kids.Count == 1) {
                    GenExpr(e.kids[0]);
                    DblLibm1("_sqrt");
                    return;
                }
                if (mn == "Floor" && e.kids.Count == 1) {
                    GenExpr(e.kids[0]);
                    DblLibm1("_floor");
                    return;
                }
                if (mn == "Ceiling" && e.kids.Count == 1) {
                    GenExpr(e.kids[0]);
                    DblLibm1("_ceil");
                    return;
                }
                // gen0 routes Sin/Cos/Tan/Log/Exp to libm (double -> double),
                // coercing integer arguments with sitofp
                if ((mn == "Sin" || mn == "Cos" || mn == "Tan" || mn == "Log" || mn == "Exp"
                        || mn == "Atan" || mn == "Asin" || mn == "Acos")
                        && e.kids.Count == 1) {
                    GenExpr(e.kids[0]);
                    if (!IsDblExpr(e.kids[0])) {
                        if (tgt86 == 1) { X4(0x2A0F48F2); X1(0xC7); } else { E4(0x9E620000); }                  // scvtf d0, x0
                        if (tgt86 == 1) { X3(0x66, 0x48, 0x0F); X2(0x7E, 0xC7); } else { E4(0x9E660000); }                  // fmov x0, d0
                    }
                    string lf = "_sin";
                    if (mn == "Cos") { lf = "_cos"; } else if (mn == "Tan") { lf = "_tan"; }
                    else if (mn == "Log") { lf = "_log"; } else if (mn == "Exp") { lf = "_exp"; }
                    else if (mn == "Atan") { lf = "_atan"; } else if (mn == "Asin") { lf = "_asin"; }
                    else if (mn == "Acos") { lf = "_acos"; }
                    DblLibm1(lf);
                    return;
                }
                // Math.Round(x[, digits]): round(x * 10^d) / 10^d via libm
                // round/pow (integer arguments coerce with sitofp, like gen0).
                // No value may sit in a d-reg across a GenExpr call (lazy
                // double literals return theirs in d0), so both operands are
                // spilled first; the scale lives in callee-saved x19 across
                // the round call since the divide needs it again (x is the
                // deepest stack slot, so a second spill copy would bury it).
                if (mn == "Round" && (e.kids.Count == 1 || e.kids.Count == 2)) {
                    GenExpr(e.kids[0]);
                    if (!IsDblExpr(e.kids[0])) {
                        if (tgt86 == 1) { X4(0x2A0F48F2); X1(0xC7); } else { E4(0x9E620000); }                  // scvtf d0, x0
                        if (tgt86 == 1) { X3(0x66, 0x48, 0x0F); X2(0x7E, 0xC7); } else { E4(0x9E660000); }                  // fmov x0, d0
                    }
                    if (e.kids.Count == 1) {
                        DblLibm1("_round");
                        return;
                    }
                    XPushV0();                      // push x (bits)
                    GenExpr(e.kids[1]);
                    if (!IsDblExpr(e.kids[1])) {
                        if (tgt86 == 1) { X4(0x2A0F48F2); X1(0xC7); } else { E4(0x9E620000); }                  // scvtf d0, x0
                        if (tgt86 == 1) { X3(0x66, 0x48, 0x0F); X2(0x7E, 0xC7); } else { E4(0x9E660000); }                  // fmov x0, d0
                    }
                    XPushV0();                      // push digits (bits)
                    LoadImm(0, 4621819117588971520);     // 10.0 IEEE bits
                    XPopV(1);                      // pop digits -> x1 (x0 = 10.0)
                    if (tgt86 == 1) { X3(0x66, 0x48, 0x0F); X2(0x6E, 0xC7); } else { E4(0x9E670000); }                      // fmov d0, x0
                    if (tgt86 == 1) { X3(0x66, 0x48, 0x0F); X2(0x6E, 0xCE); } else { E4(0x9E670021); }                      // fmov d1, x1
                    BLExtern("_pow");
                    if (tgt86 == 1) { X3(0x66, 0x48, 0x0F); X2(0x7E, 0xC7); } else { E4(0x9E660000); }                      // fmov x0, d0 (scale)
                    MovRR(19, 0);                        // x19 = scale (call-preserved)
                    XPopV(0);                      // pop x -> x0
                    if (tgt86 == 1) { X3(0x66, 0x48, 0x0F); X2(0x6E, 0xC7); } else { E4(0x9E670000); }                      // fmov d0, x0 (d0 = x)
                    if (tgt86 == 1) { XGetV(19, 10); X3(0x66, 0x49, 0x0F); X2(0x6E, 0xCA); } else { E4(0x9E670261); }                      // fmov d1, x19 (d1 = scale)
                    if (tgt86 == 1) { X4(0xC1590FF2); } else { E4(0x1E600820); }                      // fmul d0, d1, d0 (x * scale)
                    if (tgt86 == 1) { X3(0x66, 0x48, 0x0F); X2(0x7E, 0xC7); } else { E4(0x9E660000); }                      // fmov x0, d0
                    DblLibm1("_round");                  // round(x * scale)
                    if (tgt86 == 1) { X3(0x66, 0x48, 0x0F); X2(0x6E, 0xC7); } else { E4(0x9E670000); }                      // fmov d0, x0 (rounded)
                    if (tgt86 == 1) { XGetV(19, 10); X3(0x66, 0x49, 0x0F); X2(0x6E, 0xCA); } else { E4(0x9E670261); }                      // fmov d1, x19 (scale)
                    if (tgt86 == 1) { X4(0xC15E0FF2); } else { E4(0x1E611800); }                      // fdiv d0, d0, d1
                    if (tgt86 == 1) { X3(0x66, 0x48, 0x0F); X2(0x7E, 0xC7); } else { E4(0x9E660000); }                      // fmov x0, d0
                    return;
                }
                if (mn == "Pow" && e.kids.Count == 2) {
                    // same ordering discipline as the double Max/Min path:
                    // no value may sit in d0 across a GenExpr call
                    GenExpr(e.kids[0]);
                    XPushV0();                      // push a
                    GenExpr(e.kids[1]);
                    XPopV(1);                      // pop a -> x1 (x0 = b)
                    if (tgt86 == 1) { X3(0x66, 0x48, 0x0F); X2(0x6E, 0xCF); } else { E4(0x9E670001); }                      // fmov d1, x0
                    MovRR(0, 1);                      // mov x0, x1
                    if (tgt86 == 1) { X3(0x66, 0x48, 0x0F); X2(0x6E, 0xC7); } else { E4(0x9E670000); }                      // fmov d0, x0
                    BLExtern("_pow");
                    if (tgt86 == 1) { X3(0x66, 0x48, 0x0F); X2(0x7E, 0xC7); } else { E4(0x9E660000); }                      // fmov x0, d0
                    return;
                }
                if (mn == "Atan2" && e.kids.Count == 2) {
                    GenExpr(e.kids[0]);
                    if (!IsDblExpr(e.kids[0])) {
                        if (tgt86 == 1) { X4(0x2A0F48F2); X1(0xC7); } else { E4(0x9E620000); }                  // scvtf d0, x0
                        if (tgt86 == 1) { X3(0x66, 0x48, 0x0F); X2(0x7E, 0xC7); } else { E4(0x9E660000); }                  // fmov x0, d0
                    }
                    XPushV0();                      // push y
                    GenExpr(e.kids[1]);
                    if (!IsDblExpr(e.kids[1])) {
                        if (tgt86 == 1) { X4(0x2A0F48F2); X1(0xC7); } else { E4(0x9E620000); }                  // scvtf d0, x0
                        if (tgt86 == 1) { X3(0x66, 0x48, 0x0F); X2(0x7E, 0xC7); } else { E4(0x9E660000); }                  // fmov x0, d0
                    }
                    XPopV(1);                      // pop y -> x1 (x0 = x)
                    if (tgt86 == 1) { X3(0x66, 0x48, 0x0F); X2(0x6E, 0xCF); } else { E4(0x9E670001); }                      // fmov d1, x0 (x)
                    MovRR(0, 1);                      // mov x0, x1
                    if (tgt86 == 1) { X3(0x66, 0x48, 0x0F); X2(0x6E, 0xC7); } else { E4(0x9E670000); }                      // fmov d0, x0 (y)
                    BLExtern("_atan2");
                    if (tgt86 == 1) { X3(0x66, 0x48, 0x0F); X2(0x7E, 0xC7); } else { E4(0x9E660000); }                      // fmov x0, d0
                    return;
                }
            }
            // string.Join(sep, List<string>): gen0 runs two passes over the
            // list -- one strlen pass for the total size, one copy pass --
            // and mirrors that here (joining a string[] crashes gen0's own
            // runtime, so the List form is the only shape to match).
            if (recv != null && recv.kind == AK.Ident() && recv.sval == "string"
                    && callee.sval == "Join" && e.kids.Count == 2) {
                GenExpr(e.kids[1]);                      // list
                XPushV0();                          // push list
                GenExpr(e.kids[0]);                      // sep
                XPopV(1);                                // pop list -> x1 (x0 = sep)
                BLInternal("_zan_rt_strjoin");
                return;
            }
            // String.CompareOrdinal(a, b) -> strcmp: byte-wise ordinal
            // compare of two NUL-terminated strings in one libc call
            // (gen0 irgen_call.c); the receiver spells either "String" or
            // the lowercase keyword form
            if (recv != null && recv.kind == AK.Ident()
                    && (recv.sval == "string" || recv.sval == "String")
                    && callee.sval == "CompareOrdinal" && e.kids.Count == 2) {
                GenExpr(e.kids[0]);                      // a
                XPushV0();                          // push a
                GenExpr(e.kids[1]);                      // b
                XPushV0();                          // push b
                XPopV(1);                          // pop b -> x1
                XPopV(0);                          // pop a -> x0
                BLExtern("_strcmp");
                Sxtw0();                          // sxtw x0, w0
                return;
            }
            // Task.IsDone(handle): the spawned frame's done flag at +8
            // (ngen_async completion stores 1 there when the body finishes)
            if (recv != null && recv.kind == AK.Ident() && recv.sval == "Task"
                    && callee.sval == "IsDone" && e.kids.Count == 1) {
                GenExpr(e.kids[0]);                      // frame handle
                LdrU(0, 0, 8);                           // x0 = frame[1] (done)
                return;
            }
            // Task.Cancel(handle): mark the frame -- and, down the child
            // chain, whatever it is transitively suspended on -- cancelled;
            // each marked frame completes early at its next $resume entry
            // (get_co_cancel_fn, irgen_call.c:698)
            if (recv != null && recv.kind == AK.Ident() && recv.sval == "Task"
                    && callee.sval == "Cancel" && e.kids.Count == 1) {
                EnsureAsyncRuntimeNg();
                GenExpr(e.kids[0]);                      // frame handle
                BLInternal("_zan_ng_co_cancel");
                LoadImm(0, 0);
                return;
            }
            // Task.IsCancellationRequested(): inside an async body the
            // frame's own cancel slot; 0 anywhere else (irgen_call.c:726)
            if (recv != null && recv.kind == AK.Ident() && recv.sval == "Task"
                    && callee.sval == "IsCancellationRequested"
                    && e.kids.Count == 0) {
                if (inAsyncNg) {
                    LoadLocal(asyncFrameLocal, 1);
                    LdrU(0, 1, 56);
                } else {
                    LoadImm(0, 0);
                }
                return;
            }
            // Task.Spawn(asyncCall) / Task.Run(asyncCall) in value position:
            // emit the callee ramp, detach (awaiter = reap marker, no pump --
            // the body first runs at the next one), yield the frame handle
            // (irgen_call.c:621; only statement-level spawns that discard it
            // take PrepareAsyncStmtNg's path)
            if (recv != null && recv.kind == AK.Ident() && recv.sval == "Task"
                    && (callee.sval == "Spawn" || callee.sval == "Run")
                    && e.kids.Count == 1) {
                Node spt = e.kids[0];
                int spm = AsyncResolveCallNg(spt);
                if (spm >= 0) {
                    if (HasTypeParams(methNodes[spm])) {
                        diags.Error("ngen: a spawned generic async call is not supported by the native backend", e.line, e.col);
                        LoadImm(0, 0);
                        return;
                    }
                    EnsureAsyncRuntimeNg();
                    EmitAsyncCallNg(spm, spm, spt);      // x0 = sub frame
                    MovRR(9, 0);
                    StrU(9, 9, 16);                      // sub.awaiter = sub (reap marker)
                    LoadSymRef("_zan_co_reap", 1);
                    StrU(1, 9, 24);                      // sub.awaiter_step = reap
                    XPushR(9);                      // hold sub across ready
                    LdrU(1, 9, 40);                      // sub own_resume
                    MovRR(0, 9);
                    BLInternal("_zan_co_ready");
                    XPopV(0);                      // x0 = sub (the handle)
                    return;
                }
