                    if (e.op == TK.EqEq()) { E4(0x9A9F17E0); }   // cset x0, eq
                    else { E4(0x9A9F07E0); }                     // cset x0, ne
                }
            } else if (IsStrExpr(e.a) && IsStrExpr(e.b)
                    && (e.op == TK.Less() || e.op == TK.LessEq()
                     || e.op == TK.Greater() || e.op == TK.GreaterEq())) {
                // relational string comparison: strcmp order, not pool
                // addresses (gen0 parity); null sorts before every string
                GenExpr(e.a);
                XPushV0();                      // push a
                GenExpr(e.b);
                if (tgt86 == 1) {
                    XPopV(1);                            // pop a -> v1
                    X3(0x49, 0x89, 0xFA);                // mov r10, rdi (b)
                    XMov(7, 6);                          // mov rdi, rsi (a)
                    X3(0x4C, 0x89, 0xD6);                // mov rsi, r10 (b)
