            // when the program declares its own Convert member).
            if (recv != null && recv.kind == AK.Ident() && recv.sval == "Convert") {
                string mn = callee.sval;
                if (e.kids.Count == 1 && !UserDefinesClsMember("Convert", mn)) {
                    Node arg = e.kids[0];
