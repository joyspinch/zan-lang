            // the lowercase keyword form
            if (recv != null && recv.kind == AK.Ident()
                    && (recv.sval == "string" || recv.sval == "String")
                    && callee.sval == "CompareOrdinal" && e.kids.Count == 2) {
                GenExpr(e.kids[0]);                      // a
                XPushV0();                          // push a
                GenExpr(e.kids[1]);                      // b
                XPushV0();                          // push b
                XPopV(1);                          // pop b -> x1
                XPopV(0);                          // pop a -> x0
                BLExtern("_strcmp");
                Sxtw0();                          // sxtw x0, w0
                return;
            }
            // Task.IsDone(handle): the spawned frame's done flag at +8
            // (ngen_async completion stores 1 there when the body finishes)
            if (recv != null && recv.kind == AK.Ident() && recv.sval == "Task"
                    && callee.sval == "IsDone" && e.kids.Count == 1) {
                GenExpr(e.kids[0]);                      // frame handle
                LdrU(0, 0, 8);                           // x0 = frame[1] (done)
                return;
            }
            // Task.Cancel(handle): mark the frame -- and, down the child
            // chain, whatever it is transitively suspended on -- cancelled;
            // each marked frame completes early at its next $resume entry
            // (get_co_cancel_fn, irgen_call.c:698)
            if (recv != null && recv.kind == AK.Ident() && recv.sval == "Task"
                    && callee.sval == "Cancel" && e.kids.Count == 1) {
                EnsureAsyncRuntimeNg();
                GenExpr(e.kids[0]);                      // frame handle
                BLInternal("_zan_ng_co_cancel");
                LoadImm(0, 0);
                return;
            }
            // Task.IsCancellationRequested(): inside an async body the
            // frame's own cancel slot; 0 anywhere else (irgen_call.c:726)
            if (recv != null && recv.kind == AK.Ident() && recv.sval == "Task"
                    && callee.sval == "IsCancellationRequested"
                    && e.kids.Count == 0) {
                if (inAsyncNg) {
                    LoadLocal(asyncFrameLocal, 1);
                    LdrU(0, 1, 56);
                } else {
                    LoadImm(0, 0);
                }
                return;
            }
            // Task.Spawn(asyncCall) / Task.Run(asyncCall) in value position:
            // emit the callee ramp, detach (awaiter = reap marker, no pump --
            // the body first runs at the next one), yield the frame handle
            // (irgen_call.c:621; only statement-level spawns that discard it
            // take PrepareAsyncStmtNg's path)
            if (recv != null && recv.kind == AK.Ident() && recv.sval == "Task"
                    && (callee.sval == "Spawn" || callee.sval == "Run")
                    && e.kids.Count == 1) {
                Node spt = e.kids[0];
                int spm = AsyncResolveCallNg(spt);
                if (spm >= 0) {
                    if (HasTypeParams(methNodes[spm])) {
                        diags.Error("ngen: a spawned generic async call is not supported by the native backend", e.line, e.col);
                        LoadImm(0, 0);
                        return;
                    }
                    EnsureAsyncRuntimeNg();
                    EmitAsyncCallNg(spm, spm, spt);      // x0 = sub frame
                    MovRR(9, 0);
                    StrU(9, 9, 16);                      // sub.awaiter = sub (reap marker)
                    LoadSymRef("_zan_co_reap", 1);
                    StrU(1, 9, 24);                      // sub.awaiter_step = reap
                    XPushR(9);                      // hold sub across ready
                    LdrU(1, 9, 40);                      // sub own_resume
                    MovRR(0, 9);
                    BLInternal("_zan_co_ready");
                    XPopV(0);                      // x0 = sub (the handle)
                    return;
                }
                // a delegate-shaped argument (a lambda, an anonymous
                // delegate, an Action/Func variable) runs to completion
                // INLINE -- the cooperative model: Run returns only after
                // the body finishes, so Wait/IsCompleted read an
                // already-done task. The handle is the null frame.
                Node scall = new Node(AK.Call());
                scall.a = spt;
                scall.line = e.line; scall.col = e.col;
                if (TryGenDelegateCall(scall)) {
                    LoadImm(0, 0);
                    return;
                }
                if (spt.kind == AK.Lambda()) {
                    string ldt = StaticTyOf(spt);
                    PrepareDelegateValue(spt, ldt != null && IsDelegateTyNg(ldt) ? ldt : "Action");
                    if (TryGenDelegateExpr(spt)) {       // x0 = delegate value
                        int dlive = NL();
                        EmitCbnz(0, dlive);
                        LoadImm(0, 1);
                        BLExtern("_exit");               // null invocation fails closed
                        Mark(dlive);
                        LdrU(9, 0, 0);
                        LdrU(0, 0, 8);
                        E4(0xD63F0120);                  // blr x9
                        LoadImm(0, 0);                   // null frame: done
                        return;
                    }
                }
                // not an async call: fall through so the normal call path
                // fires its own diagnostic, like the reference
            }
            // Console.ReadLine: gen0 allocates a 1024-byte string, NUL-
            // terminates it up front, fgets()s into it keeping the trailing
            // newline, and yields the buffer regardless of the fgets result
            // (an EOF reads back as the empty string).
            if (recv != null && recv.kind == AK.Ident() && recv.sval == "Console"
                    && !UserDefinesClsMember("Console", callee.sval)
                    && callee.sval == "ReadLine" && e.kids.Count == 0) {
                LoadImm(0, 1024);
                BLInternal("_zan_rt_str_alloc");         // x0 = buf
                XPushV0();                          // push buf
                Strb0(0);                                // buf[0] = NUL
                // the Mach-O symbol is the C name plus one underscore
                // (LLVM adds it automatically for @__stdinp)
                LoadSymRefGOT("___stdinp", 2);
                LdrU(2, 2, 0);                           // x2 = stdin
                LdrU(0, 31, 0);                          // x0 = buf
                LoadImm(1, 1024);
                BLExtern("_fgets");
                LdrU(0, 31, 0);                          // x0 = buf
                BLExtern("_strlen");                    // x0 = strlen(buf)
                LoadImm(10, 0x5A414E5300000000);
                AddRR(9, 0, 10);                        // x9 = 0x5A414E5300000000 | len
                LdrU(10, 31, 0);                        // x10 = buf
                SubImm(10, 10, 8);
                StrU(9, 10, 0);                         // str x9, [buf-8]
                XPopV(0);                          // pop buf -> x0
                return;
            }
