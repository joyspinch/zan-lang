            if (recv != null && recv.kind == AK.Ident() && callee.sval == "Parse"
                    && e.kids.Count == 1) {
                string rn = recv.sval;
                bool intRecv = rn == "int" || rn == "long" || rn == "Int32" || rn == "Int64";
                bool dblRecv = rn == "double" || rn == "float" || rn == "Double" || rn == "Single";
                if (intRecv || dblRecv) {
