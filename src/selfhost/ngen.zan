                            GenExpr(arg);                // int slots are i64 already
                        }
                        return;
                    }
                    if (mn == "ToDouble") {
                        if (IsStrExpr(arg)) {
                            GenExpr(arg);
                            LoadImm(1, 0);               // endptr = NULL
                            BLInternal("_zan_rt_dbl_parse");
                            if (tgt86 == 1) {
                                X3(0x66, 0x48, 0x0F); X2(0x7E, 0xC7);   // movq rdi, xmm0
                            } else {
                                if (tgt86 == 1) { X3(0x66, 0x48, 0x0F); X2(0x7E, 0xC7); } else { E4(0x9E660000); }              // fmov x0, d0
                            }
                        } else if (IsDblExpr(arg)) {
                            GenExpr(arg);                // bits unchanged
                        } else {
                            GenExpr(arg);
                            if (tgt86 == 1) {
                                X2(0xF2, 0x0F); X2(0x2A, 0xC7);   // cvtsi2sd xmm0, rdi
                                X3(0x66, 0x48, 0x0F); X2(0x7E, 0xC7);   // movq rdi, xmm0
                            } else {
                                if (tgt86 == 1) { X4(0x2A0F48F2); X1(0xC7); } else { E4(0x9E620000); }              // scvtf d0, x0
                                if (tgt86 == 1) { X3(0x66, 0x48, 0x0F); X2(0x7E, 0xC7); } else { E4(0x9E660000); }              // fmov x0, d0
                            }
                        }
