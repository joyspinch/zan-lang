using System;
using System.Collections.Generic;
namespace Zan;

// Ngen: native backend slice (M1). Emits arm64 machine code directly from the
// bound AST — no LLVM IR text, no clang. The object container (Mach-O) lives
// in ngen_macho.zan.
//
// Instruction words are stored as 32-bit two's-complement ints: Zan hex
// literals above 0x7FFFFFFF wrap, but the bit pattern survives the wrap and
// byte extraction takes the low 32 bits.
//
// Kernel subset: static methods, int params/locals/returns, int literals,
// `+ - * <`, if/while, plain calls (recursion ok), Console.WriteLine(int).
// Anything else is a compile error, not a silent fallback.

// Open-addressed string -> insertion-ordered bucket index over the method
// tables. Our builtin Dictionary is a linear walk (_zan_rt_dict_index), so
// it cannot speed up the very scans it appears in; this table gives O(1)
// key probes. Buckets chain in append order, so iteration inside a bucket
// matches the old flat table scan exactly.
// 缺口四 a: compile-time decimal -> IEEE-754 bits for float literals.
// The emitter calls libc strtod in its own process (the P/Invoke stub
// hands the result bits back in x0 under the internal value model),
// parks them in a raw 8-byte buffer, and re-reads them as an i64
// immediate. Replaces the lazy `dbl.N` __DATA slot: only the first
// object of a link ever ran its static initialization, so every later
// object's slots stayed zero and the lazy conversion fired on a null
// literal-text pointer (the batch-8 float-value crashes).
public class NgenDblEnv {
    [DllImport("crt", EntryPoint="strtod")] public static extern double StrToD(string s, long endp);
    [DllImport("crt", EntryPoint="malloc")] public static extern nint Alloc(int size);
    [DllImport("crt", EntryPoint="free")] public static extern void Free(nint p);
}

public class MethIndex {
    List<string> keys;
    List<int> head;
    List<int> tail;
    List<int> entVal;
    List<int> entNext;
    List<int> slots;

    public MethIndex() {
        keys = new List<string>();
        head = new List<int>();
        tail = new List<int>();
        entVal = new List<int>();
        entNext = new List<int>();
        slots = new List<int>();
        int i = 0;
        while (i < 4096) { slots.Add(-1); i = i + 1; }
    }

    int HashOf(string s) {
        int h = 17;
        int i = 0;
        while (i < s.Length) { h = h * 31 + (int)s[i] + 1; i = i + 1; }
        if (h < 0) { h = 0 - h; }
        if (h < 0) { h = 0; }
        return h;
    }

    // find-or-insert the key id
    int KeyId(string k) {
        int n = slots.Count;
        int j = HashOf(k) % n;
        while (slots[j] >= 0) {
            if (keys[slots[j]] == k) { return slots[j]; }
            j = j + 1;
            if (j == n) { j = 0; }
        }
        int id = keys.Count;
        keys.Add(k);
        head.Add(-1);
        tail.Add(-1);
        slots[j] = id;
        if (keys.Count * 2 >= n) { Rehash(); }
        return id;
    }

    void Rehash() {
        List<string> oldKeys = keys;
        slots = new List<int>();
        int n = oldKeys.Count * 8 + 1;
        int i = 0;
        while (i < n) { slots.Add(-1); i = i + 1; }
        int q = 0;
        while (q < oldKeys.Count) {
            int j = HashOf(oldKeys[q]) % n;
            while (slots[j] >= 0) { j = j + 1; if (j == n) { j = 0; } }
            slots[j] = q;
            q = q + 1;
        }
    }

    public void Add(string k, int v) {
        int id = KeyId(k);
        int e = entVal.Count;
        entVal.Add(v);
        entNext.Add(-1);
        if (tail[id] < 0) { head[id] = e; } else { entNext[tail[id]] = e; }
        tail[id] = e;
    }

    // method indices for k in insertion order, or null on miss
    public List<int> Get(string k) {
        int n = slots.Count;
        int j = HashOf(k) % n;
        while (slots[j] >= 0) {
            if (keys[slots[j]] == k) {
                List<int> r = new List<int>();
                int e = head[slots[j]];
                while (e >= 0) { r.Add(entVal[e]); e = entNext[e]; }
                return r;
            }
            j = j + 1;
            if (j == n) { j = 0; }
        }
        return null;
    }
}

public class Fixup {
    public int pos;    // text offset of the patched instruction
    public int kind;   // 0=B 1=CBZ 2=Bcond 3=BL-internal 4=BL-extern 5=TBZ/TBNZ
    public int lbl;    // label id (kinds 0-2)
    public int cond;   // cond code (kind 2)
    public string sym; // target symbol (kinds 3-4)
    public Fixup(int p, int k, int l, int c, string s) {
        pos = p; kind = k; lbl = l; cond = c; sym = s;
    }
}

public class StrRef {
    public int adrpPos;  // text offset of the adrp instruction
    public int addPos;   // text offset of the add/ldr instruction
    public string sym;   // target symbol name (l_.str.N / l_.g.NAME / __stdinp)
    public int got;      // 1: adrp + ldr through the homemade __nl_symbol_ptr
                         //    slot (dylib data symbols)
    public StrRef(int a, int b, string s) { adrpPos = a; addPos = b; sym = s; got = 0; }
}

public class Sym {
    public string name;  // link-time symbol name (underscore prefixed)
    public int pos;      // text offset of the definition
    public Sym(string n, int p) { name = n; pos = p; }
}

partial class Ngen {
    Diags diags;

    List<int> txt;          // __text bytes
    List<Sym> syms;         // defined symbols (one per method)
    List<Fixup> fixups;     // branch/call fixups
    List<StrRef> strRefs;   // string address references (adrp+add pairs)
    List<string> strs;      // __cstring entries
    List<int> lblPos;       // label id -> text pos (-1 while open)
    List<int> brkL;         // innermost-enclosing-loop break targets
    List<Node> finBodies;   // enclosing try/finally bodies, innermost last
    List<int> finInHandler; // 1 once that try's frame is conceptually disarmed
    List<int> ehStack;      // try frames open in this activation (compile time)
    List<bool> brkLoop;     // brkL[i] belongs to a loop (vs a switch)
    List<int> brkFinBase;   // finallys base for each break target
    List<int> cntFinBase;   // finallys base at each loop's continue point
    int finCur = -1;        // index of the finally body being emitted right now
    List<int> finActive;    // indices of finally bodies currently being emitted
    int lockSeq = 0;        // unique temp names for lowered lock statements
    List<int> cntL;         // innermost-enclosing-loop continue targets
    List<string> gotoNames; // label names seen in the method being emitted
    List<int> gotoIds;      // label id per name (created on first reference)
    bool curHasTry;         // method being emitted contains a try anywhere
    int ehTopLocal;         // #ehtop: mirror of the runtime EH top
    int ehBaseLocal;        // #ehbase: top at the outermost open try's arm
    int ehBrkLocal;         // #ehbrk: top at loop entry (break/continue disarm)
    List<Node> clauseExcNodes; // catch clauses, in reserve order: a bare
                               // `throw;` rethrows the innermost open
                               // clause's OWN exception, not the mutable
                               // in-flight global (a nested try inside the
                               // clause body overwrites the global)
    List<int> clauseExcSlots;  // frame slot per clause holding its exception
    List<int> clauseExcOpen;   // slots of the clauses whose bodies are being
                               // emitted, innermost last
    int ctmpSeq;            // hidden single-eval temps for compound assigns
    bool dbgEh = false;     // temporary: trace EH arm (7M+depth) and rethrow
                            // (8M+runtime top) through zan_rt_print_int

    string curCls;
    int stTyDepth;          // StaticTyOf recursion guard: cyclic static-type
                            // chains bottom out as unknown, never hang
    int extRetDepth;        // ExtRetTy recursion guard
    List<string> locName;   // locals of the method being emitted
    List<string> locTy;     // declared type name per local ("" for this/params of unknown)
    List<int> locOff;       // frame offset (bytes from sp)
    List<bool> locRef;      // by-ref slots (out/ref params): the slot holds an address
    List<int> locBoxed;     // lambda-written slots: the slot holds a shared heap
                            // cell (A33-2b), reads and writes go through it
    List<Node> spanSites;   // view-construction sites (batch 12): each owns a
                            // private 16-byte frame box for its {base,len} pair
    List<int> spanSiteOff;  // frame offset of each site's box (parallel list)
    List<string> boxNames;  // names any nested lambda assigns (per method)
    List<string> boxCaptured; // names any nested lambda reads (per method)
    List<string> boxOuterWrote; // names the method body itself assigns
    List<int> boxParamSlots; // param frame slots boxed this method (prologue
                             // wraps the incoming value in a shared cell)
    List<int> paramSlotsNg;  // frame slots of the method's own parameters, in
                             // declaration order (boxable capture targets)
    List<Node> patStamped;  // pattern nodes whose bindings were pre-stamped
    List<int> locOpaq;      // string slot holding an extern-call result: no
                            // length header, no trusted NUL bound (the stdlib
                            // slices readdir's struct dirent* byte by byte)
    // A persistent lexical environment is a chain of declaration slots.
    // Every AST node records its visible chain before emission, so sibling
    // scopes and re-emitted finally bodies never borrow one another's types.
    List<Node> locDecl;
    List<int> locPrev;
    List<Node> envNodes;
    List<int> envHeads;
    int locHead = -1;
    int nloc;
    int frame;
    int nlabel;
    int curLine;
    int curCol;
    int guardDivIdx;
    int guardModIdx;
    int guardFileIdx;
    int guardStrIdx;
    int guardSubIdx;
    int guardListIdx;
    int guardArrIdx;
    int guardSpanIdx;
    int guardArrNeg;
    int guardArrOvf;
    int guardArrFail;
    int guardArrNull;
    int guardStrNull;
    int guardNulVal;
    string srcFile;
    // baked embed resources (embedres parity): when a carried module's data
    // pack ships in the stdlib, the pack is interned into __cstring and the
    // zan_embed_* read API is defined in this object so the program serves
    // its own table (the shipped crt-transition stub answers 0 / NULL)
    int embedDataIdx = -1;
    int embedNameIdx = -1;
    int embedEmptyIdx = -1;
    int embedDataLen = 0;
    public static string StdlibRoot;   // set by main.zan before codegen

    List<Node> methNodes;
    List<string> methCls;
    List<int> methStat;     // 0 = instance, 1 = static, 2 = ctor
    // incremental indexes over methNodes. Big inputs (Chart/Gui families)
    // made every call-site resolution walk the whole method table
    // (O(sites x methods)); lookups now touch only same-shape candidates.
    // Buckets append in table order, so iteration inside a bucket matches
    // the old flat scan exactly. Everything goes through AddMethNg so an
    // append can never bypass the indexes.
    MethIndex mIdxClsName;   // cls | name -> indices
    MethIndex mIdxName;      // name -> indices
    MethIndex mIdxCls;       // cls -> indices
    string mainCls;
    string designMainCls;
    bool mainAsync;     // Main is async: the shim ramps + pumps instead of calling it
    Node curMeth;           // method being emitted (spec sval2 = this type)
    int curThreadEntryNg;   // current method is [ThreadEntry]: x19-x28 saved
    int tentFrame;          // its total sp reservation (frame + 96 save bytes)
    Node specScanMeth;      // method RunSpecPipeline is scanning: a bare
                            // generic call inside a scanned spec body
                            // inherits the body's receiver instantiation
                            // (curMeth is emission-only, null during the scan)

    List<string> enName;    // enum type name per declaration
    List<int> enOff;        // start index into the flat member arrays
    List<int> enCnt;        // member count
    List<string> enMem;     // flat member names
    List<long> enVal;       // flat member constants (C# running counter)

    public Ngen(Binder b, Diags d, string file) {
        diags = d;
        layoutBinder = b;
        srcFile = file;
        tgt86 = EnvTargetX86();
        txt = new List<int>();
        syms = new List<Sym>();
        fixups = new List<Fixup>();
        strRefs = new List<StrRef>();
        strs = new List<string>();
        lblPos = new List<int>();
        brkL = new List<int>();
        finBodies = new List<Node>();
        finInHandler = new List<int>();
        finActive = new List<int>();
        cntL = new List<int>();
        gotoNames = new List<string>();
        gotoIds = new List<int>();
        ehStack = new List<int>();
        clauseExcNodes = new List<Node>();
        clauseExcSlots = new List<int>();
        clauseExcOpen = new List<int>();
        brkLoop = new List<bool>();
        brkFinBase = new List<int>();
        cntFinBase = new List<int>();
        methNodes = new List<Node>();
        methCls = new List<string>();
        methStat = new List<int>();
        mIdxClsName = new MethIndex();
        mIdxName = new MethIndex();
        mIdxCls = new MethIndex();
        specMeth = new List<string>();
        instCls = new List<string>();
        ctorSpecKey = new List<string>();
        ctorSpecSym = new List<string>();
        nlabel = 0;
    }

    // single mutation point for the method tables so the indexes can never
    // fall behind the flat lists
    void AddMethNg(Node m, string cls, int stat) {
        methNodes.Add(m);
        methCls.Add(cls);
        methStat.Add(stat);
        int i = methNodes.Count - 1;
        mIdxClsName.Add(cls + "|" + m.sval, i);
        mIdxName.Add(m.sval, i);
        mIdxCls.Add(cls, i);
    }

    List<int> MethCandsClsName(string cls, string name) {
        if (cls != null) {
            int lt = cls.IndexOf("<");
            if (lt > 0 && cls.Substring(cls.Length - 1, 1) == ">") {
                cls = cls.Substring(0, lt);
            }
        }
        return mIdxClsName.Get(cls + "|" + name);
    }

    List<int> MethCandsName(string name) {
        return mIdxName.Get(name);
    }

    List<int> MethCandsCls(string cls) {
        if (cls != null) {
            int lt = cls.IndexOf("<");
            if (lt > 0 && cls.Substring(cls.Length - 1, 1) == ">") {
                cls = cls.Substring(0, lt);
            }
        }
        return mIdxCls.Get(cls);
    }

    // ---- entry: returns the object file bytes ----
    public List<int> Gen(Node unit) {
        int i = 0;
        while (i < unit.kids.Count) {
            Node dcl = unit.kids[i];
            if (dcl.kind == AK.ClassDecl() || dcl.kind == AK.StructDecl()) { CollectMethods(dcl); }
            i = i + 1;
        }
        CollectClasses(unit);
        CollectEnums(unit);
        RunSpecPipeline();
        MaterializeInstStatics();
        // one lazy vtable slot per polymorphic class (the table itself is
        // built by _vtinit_<Cls> at first `new`)
        int ci = 0;
        while (ci < classes.Count) {
            if (classes[ci].poly == 1) {
                dglbs.Add(new DGlob("vt." + classes[ci].name, 8, dataLen));
                dataLen = dataLen + 8;
            }
            ci = ci + 1;
        }
        EmitRtCore();
        guardDivIdx = InternStr("division by zero\n");
        guardModIdx = InternStr("division by zero (modulo)\n");
        // gen0 bakes guard sites with the source path shortened to its
        // last two components ("selfhost/kernel10.zan")
        string gfile = srcFile;
        int lastSlash = -1;
        int prevSlash = -1;
        int si = srcFile.IndexOf("/");
        while (si >= 0) { prevSlash = lastSlash; lastSlash = si; si = srcFile.IndexOf("/", si + 1); }
        if (lastSlash >= 0 && prevSlash >= 0) {
            gfile = srcFile.Substring(prevSlash + 1, srcFile.Length - prevSlash - 1);
        }
        guardFileIdx = InternStr(gfile);
        guardStrIdx = InternStr("string index out of bounds\n");
        guardSubIdx = InternStr("substring index out of bounds\n");
        guardListIdx = InternStr("list index out of bounds\n");
        guardArrIdx = InternStr("array index out of bounds\n");
        guardSpanIdx = InternStr("span range out of bounds\n");
        guardArrNeg = InternStr("negative array length\n");
        guardArrOvf = InternStr("array allocation overflow\n");
        guardArrFail = InternStr("array allocation failed\n");
        guardArrNull = InternStr("null reference where an array is required (.Length)\n");
        guardStrNull = InternStr("null reference where a string is required\n");
        guardNulVal = InternStr("Nullable object must have a value\n");
        embedEmptyIdx = InternStr("");
        // gen0 auto-bakes (main.c): a program carrying the Pinyin module
        // gets the stdlib pinyin table as resource "text/pinyin.txt", and
        // its own zan_embed_* definitions make File.EmbedExists/EmbedRead
        // find it with nothing beside the exe
        if (StdlibRoot != null && StdlibRoot.Length > 0 && FindClass("Pinyin") != null) {
            string pk = StdlibRoot + "/System/Text/data/pinyin.txt";
            if (File.Exists(pk)) {
                string packed = File.ReadAllText(pk);
                embedNameIdx = InternStr("text/pinyin.txt");
                embedDataIdx = InternStr(packed);
                embedDataLen = packed.Length;
                dglbs.Add(new DGlob("embed.gtbl", 8, dataLen));
                dataLen = dataLen + 8;
                dglbs.Add(new DGlob("embed.gcnt", 8, dataLen));
                dataLen = dataLen + 8;
            }
        }
        if ((mainCls == null || mainCls == "") && (designMainCls != null && designMainCls != "")) {
            mainCls = designMainCls;
        }
        if (mainCls != null && mainCls != "") {
            if (embedDataIdx >= 0) { EmitEmbedApiNg(); }
            EmitMainShim();
        }
        int mi = 0;
        while (mi < methNodes.Count) {
            // batch 12: a view cannot be RETURNED -- the site's frame box
            // dies at return and the caller would hold a dangling address.
            // (Parameters are fine: a caller frame outlives any synchronous
            // callee, so the pass-down box stays valid for the whole call --
            // runtime_core's sched256/sched512 pass views this way.)
            Node sm = methNodes[mi];
            if (sm.type != null && SpanTyNg(TypeFullName(sm.type))) {
                diags.Error("ngen: a Span view cannot be a return type (its frame box dies at return); return the backing array and build a local view", 0, 0);
            }
            // generic declarations are templates: only their
            // specializations carry bodies (RunSpecPipeline built them)
            if (!HasTypeParams(methNodes[mi]) && !HasMod(methNodes[mi], MOD.Extern())) {
                // ngen_async hook D: an async method emits its ramp + $resume
                // state machine instead of an ordinary body
                if (IsAsync(methNodes[mi])) {
                    EmitAsyncMethodNg(methCls[mi], methNodes[mi], mi);
                } else {
                    EmitMethod(methCls[mi], methNodes[mi], mi);
                }
            }
            mi = mi + 1;
        }
        ci = 0;
        while (ci < classes.Count) {
            // batch 12: no Span fields (the C# ref-struct rule) -- a view
            // stored in an object would outlive its method's frame
            int fsi = 0;
            while (fsi < classes[ci].flds.Count) {
                if (SpanTyNg(classes[ci].flds[fsi].ty)) {
                    diags.Error("ngen: a Span view cannot be a field (ref-struct shape); keep views in locals", 0, 0);
                }
                fsi = fsi + 1;
            }
            if (classes[ci].poly == 1) { EmitVtInit(classes[ci]); }
            ci = ci + 1;
        }
        // batch 12: no Span-typed statics either (C# CS8345: a ref struct
        // cannot be a field). The old heap-box representation made them
        // merely immortal; frame boxes would make them dangling, and the
        // ref-struct shape is the language rule either way. The 缺口二
        // read/write capability retires with this diagnostic; the codebase
        // never used it (runtime_core's 静态只存块指针 style predates it).
        int sfi = 0;
        while (sfi < sfTy.Count) {
            if (SpanTyNg(sfTy[sfi])) {
                diags.Error("ngen: a Span view cannot be a static field (ref-struct shape); store the backing block and build a local view at each use", 0, 0);
            }
            sfi = sfi + 1;
        }
        if (tgt86 == 1) {
            // batch 32: delegate thunks join the x86 tail (the invoke path
            // was batch-32-washed and every delegate creation interns
            // through _zan_dlg_intern, so the thunks must emit here or the
            // symbol fails to resolve). The string pool is data-only and
            // required by every literal reference; batch 19 adds the EH
            // class-name lookup the uncaught tail and typed catch dispatch
            // need. 批41:packed byte 切片(_zan_packed_slice_str)全原语
            // 已双车道化(唯一的裸 E4 ldrb 换 ExtLdrbImm),stdlib 字符串
            // 排序在 x86 车道不再链接失败;binding 访问器与反射仍不发射
            // ——需要它们的程序按批32 诚实策略链接期报缺,不跑外来字节。
            EmitDelegateThunks();
            while (mi < methNodes.Count) {
                if (!HasTypeParams(methNodes[mi]) && !HasMod(methNodes[mi], MOD.Extern())) {
                    if (IsAsync(methNodes[mi])) {
                        EmitAsyncMethodNg(methCls[mi], methNodes[mi], mi);
                    } else {
                        EmitMethod(methCls[mi], methNodes[mi], mi);
                    }
                }
                mi = mi + 1;
            }
            EmitClsNameFn();
            HostEmitPackedSlice();
            RtEmitStrpool();
            Patch();
            return BuildMachO();
        }
        EmitDelegateThunks();
        EmitBindingAccessors();
        while (mi < methNodes.Count) {
            if (!HasTypeParams(methNodes[mi]) && !HasMod(methNodes[mi], MOD.Extern())) {
                if (IsAsync(methNodes[mi])) {
                    EmitAsyncMethodNg(methCls[mi], methNodes[mi], mi);
                } else {
                    EmitMethod(methCls[mi], methNodes[mi], mi);
                }
            }
            mi = mi + 1;
        }
        HostEmitPackedSlice();
        EmitClsNameFn();
        EmitReflApi();
        RtEmitStrpool();
        Patch();
        return BuildMachO();
    }

    void CollectMethods(Node cls) {
        int i = 0;
        bool hasCtor = false;
        while (i < cls.kids.Count) {
            Node m = cls.kids[i];
            if (m.kind == AK.MethodDecl()) {
                // ngen_async hook E: async methods join the signature tables
                // (their ramps are call targets); an async Main is driven by
                // the entry shim (hook F) instead of a direct call
                if (HasMod(m, MOD.Extern())) { CheckExternNg(m); }
                if (m.sval == "Main" && HasMod(m, MOD.Static()) && !HasMod(m, MOD.Extern())) {
                    mainCls = cls.sval;
                    mainAsync = IsAsync(m);
                } else if (m.sval == "__DesignMain" && HasMod(m, MOD.Static()) && !HasMod(m, MOD.Extern())) {
                    designMainCls = cls.sval;
                }
                AddMethNg(m, cls.sval, HasMod(m, MOD.Static()) ? 1 : 0);
            }
            if (m.kind == AK.CtorDecl()) {
                // `static T()` is a type initializer (methStat 3), not a
                // constructor: it takes no `this`, is never selected by
                // `new T(...)`, and runs once at program entry in
                // declaration order (gen0 parity)
                if (!HasMod(m, MOD.Static())) { hasCtor = true; }
                AddMethNg(m, cls.sval, HasMod(m, MOD.Static()) ? 3 : 2);
            }
            i = i + 1;
        }
        // a class with no declared ctors gets the synthesized parameterless
        // one, which is what runs its instance field initializers (and the
        // base chain) when `new T()` finds it
        if (!hasCtor) {
            Node dc = new Node(AK.CtorDecl());
            dc.mods = HasMod(cls, MOD.Static()) ? MOD.Static() : 0;
            AddMethNg(dc, cls.sval, 2);
        }
    }

    bool HasMod(Node m, int flag) { return (m.mods / flag) - ((m.mods / flag) / 2) * 2 == 1; }
    bool IsAsync(Node m) { return HasMod(m, MOD.Async()); }

    // Same raw C name as Irgen.ExternName; Mach-O adds exactly one '_'.
    string ExternSymNg(Node m) {
        return "_" + (m.sval2 != null && m.sval2 != "" ? m.sval2 : m.sval);
    }

    // Types an extern can take or return, matched to the oracle zanc ABI as
    // probed from its arm64 codegen: integer-class values (pointers, nint,
    // narrow ints) pass in x/w registers; float/double take the independent
    // v0-v7 fp registers (AAPCS64: ldexp(3.5, 3) emits fmov d0 + mov w0);
    // arrays pass their data pointer exactly like strings (element 0 sits at
    // the array value itself, length at value-16).
    bool ExternTyNg(string t) {
        if (t == "string" || t == "int" || t == "long") { return true; }
        if (t == "nint" || t == "UIntPtr" || t == "ulong" || t == "uint") { return true; }
        if (t == "short" || t == "ushort" || t == "byte" || t == "sbyte"
                || t == "char" || t == "bool") { return true; }
        if (t == "float" || t == "double") { return true; }
        // delegates pass as their closure value: a pointer to the
        // {thunk, env} block, an ordinary integer-class word
        if (IsDelegateTyNg(t)) { return true; }
        return IsArrTy(t);
    }

    bool ExternFpTy(string t) { return t == "float" || t == "double"; }

    // Span<T> raw-memory view (binder builtin generic; gen0
    // irgen_expr.c emit_struct_elem_ptr span path): `new Span<T>(base, len)`
    // holds a raw pointer and element i sits at base + i*esz, bounds-checked
    // against the view length. A view VALUE is a {base, len} pair. Batch 12:
    // every construction materializes the pair in a private 16-byte FRAME
    // box (one per construction site, reserved in the prologue) instead of
    // the old malloc'd heap box, and a store into a declared Span local
    // copies the pair (value semantics -- the C# ref-struct shape: no
    // fields, no captures, no heap escape, no per-call leak).
    bool IsSpanNew(Node e) {
        return e != null && e.kind == AK.NewExpr() && e.type != null
            && e.type.sval == "Span" && e.kids != null && e.kids.Count == 2;
    }

    // the generation-side dispatch for a view-construction expression. Must
    // mirror GenNew's Span branch and the two GenSpanView call guards in
    // GenCall (recv = the member-access receiver) exactly, or a site's box
    // lookup desyncs from its reserved slot. The collector runs BEFORE
    // codegen opens any scope, so a local receiver resolves through the
    // whole slot table (NamedSlotTy), not the scope chain: over-collecting
    // a site only wastes a slot, missing one is a hard error at generation.
    bool SpanViewSite(Node e) {
        if (e == null) { return false; }
        if (IsSpanNew(e)) { return true; }
        if (e.kind != AK.Call() || e.a == null
                || e.a.kind != AK.MemberAccess()) { return false; }
        Node rv = e.a.a;
        if (rv == null) { return false; }
        bool isAs = e.a.sval == "AsSpan" && e.kids.Count <= 2;
        bool isSl = e.a.sval == "Slice" && e.kids.Count >= 1
            && e.kids.Count <= 2;
        if (!isAs && !isSl) { return false; }
        if (rv.kind == AK.Ident()) {
            string nt = NamedSlotTy(rv.sval);
            if (nt != null) {
                if (isAs && IsArrTy(nt)) { return true; }
                if (isSl && nt.IndexOf("Span<") == 0) { return true; }
                return false;
            }
        }
        if (isAs && ArrContainerTy(rv) != null) { return true; }
        if (isSl && SpanContainerTy(rv) != null) { return true; }
        return false;
    }

    // pre-order collection of the method's view-construction sites. Lambda
    // bodies are separate frames: the delegate prologue runs its own
    // collection pass over the body.
    void CollectSpanViews(Node n) {
        if (n == null || n.kind == AK.Lambda()) { return; }
        if (SpanViewSite(n)) { spanSites.Add(n); spanSiteOff.Add(0); }
        int i = 0;
        while (i < n.kids.Count) { CollectSpanViews(n.kids[i]); i = i + 1; }
        CollectSpanViews(n.a); CollectSpanViews(n.b);
        CollectSpanViews(n.c); CollectSpanViews(n.d);
    }

    // reserve one 16-byte frame box per collected site; called after every
    // named local and the EH slots are in, before the frame size commits
    void ReserveSpanBoxes() {
        int i = 0;
        while (i < spanSites.Count) {
            AddLoc(".spansite" + i, "long", false);
            spanSiteOff[i] = locOff[nloc - 1];
            i = i + 1;
        }
    }

    // x0 = the construction site's private frame box
    void SpanSiteBox(Node e) {
        int si = 0;
        while (si < spanSites.Count) {
            if (spanSites[si] == e) { break; }
            si = si + 1;
        }
        if (si >= spanSites.Count) {
            diags.Error("ngen: span view site missing from the frame map", curLine, curCol);
            LoadImm(0, 0);
            return;
        }
        LoadImm(0, LocFpOff(spanSiteOff[si]));
        AddRR(0, 29, 0);
    }

    bool SpanTyNg(string t) {
        return t != null && t.IndexOf("Span<") == 0;
    }

    string SpanElemTy(Node sn) {
        if (sn.type != null && sn.type.kids != null && sn.type.kids.Count > 0) {
            return TypeFullName(sn.type.kids[0]);
        }
        return "long";
    }

    int SpanElemSize(Node sn) {
        string el = SpanElemTy(sn);
        if (el == "byte" || el == "sbyte") { return 1; }
        if (el == "short" || el == "ushort" || el == "char") { return 2; }
        if (el == "int" || el == "uint" || el == "float") { return 4; }
        return 8;
    }

    // element type/size of a declared "Span<T>" type-name string
    string SpanTyElem(string st) {
        int p = st.IndexOf("<");
        if (p < 0) { return "long"; }
        return st.Substring(p + 1, st.Length - p - 2);
    }
    int SpanTyElemSize(string st) {
        string el = SpanTyElem(st);
        if (el == "byte" || el == "sbyte") { return 1; }
        if (el == "short" || el == "ushort" || el == "char") { return 2; }
        if (el == "int" || el == "uint" || el == "float") { return 4; }
        return 8;
    }

    // declared Span<T> type of a plain local, field or static used as an
    // indexing target (`Span<byte> sp; sp[i]`), or null. The view's value is
    // a boxed {base, len} pair (the oracle's 2-field struct, one 16-byte
    // allocation per view -- views are short-lived, leak-by-design like the
    // interned delegates), so accesses through these views bounds-check like
    // arrays. Statics (bare and class-qualified) mirror ArrContainerTy.
    string SpanContainerTy(Node e) {
        if (e == null) { return null; }
        if (e.kind == AK.Ident()) {
            int li = LocalIdx(e.sval);
            if (li >= 0 && locTy[li] != null && locTy[li].IndexOf("Span<") == 0) { return locTy[li]; }
            Fld f = CurField(e.sval);
            if (f != null && f.ty != null && f.ty.IndexOf("Span<") == 0) { return f.ty; }
            string st = FindStaticTy(curCls, e.sval);
            if (st != null && st.IndexOf("Span<") == 0) { return st; }
            return null;
        }
        if (e.kind == AK.MemberAccess()) {
            Fld f = FieldOf(e);
            if (f != null && f.ty != null && f.ty.IndexOf("Span<") == 0) { return f.ty; }
            // class-qualified static view (`Va2c.sview[0]`): the receiver
            // must NAME a class, the same guard as the static write path --
            // a plain local receiver (`bb.view`) is an instance field
            if (e.a != null && e.a.kind == AK.Ident() && LocalIdx(e.a.sval) < 0
                    && FindClass(e.a.sval) != null) {
                string sq = FindStaticTy(QualifiedCls(e.a.sval, e.a.sval2), e.sval);
                if (sq != null && sq.IndexOf("Span<") == 0) { return sq; }
            }
        }
        return null;
    }

    // x0 = element at [x1 base + x0 idx * esz], shaped to the internal value
    // convention (narrow ints extended, float/double as bit patterns)
    void EmitSpanElemLoad(string el, int esz) {
        if (tgt86 == 1) {
            // base v1 -> r10, idx v0 -> r11, result lands in r10 then v0
            // (the EmitArrElemLoad slot-dst byte forms, batch 34)
            XGetV(1, 10); XGetV(0, 11);
            if (el == "byte") { X3(0x47, 0x0F, 0xB6); X2(0x14, 0x1A); }        // movzx r10d, byte [r10+r11]
            else if (el == "sbyte") { X3(0x4F, 0x0F, 0xBE); X2(0x14, 0x1A); }  // movsx r10, byte [r10+r11]
            else if (el == "short") { X3(0x4F, 0x0F, 0xBF); X2(0x14, 0x5A); }  // movsx r10, word [r10+r11*2]
            else if (el == "ushort" || el == "char") { X3(0x47, 0x0F, 0xB7); X2(0x14, 0x5A); }   // movzx r10d, word [r10+r11*2]
            else if (el == "int") { X3(0x4F, 0x63, 0x14); X1(0x9A); }          // movsxd r10, dword [r10+r11*4]
            else if (el == "uint") { X3(0x47, 0x8B, 0x14); X1(0x9A); }         // mov r10d, [r10+r11*4]
            else if (el == "float") {
                X3(0xF3, 0x43, 0x0F); X3(0x10, 0x04, 0x9A);                    // movss xmm0, [r10+r11*4]
                X3(0xF3, 0x0F, 0x5A); X1(0xC0);                                // cvtss2sd xmm0, xmm0
                X3(0x66, 0x49, 0x0F); X2(0x7E, 0xC2);                          // movq r10, xmm0
            } else if (el == "double") {
                X3(0x4F, 0x8B, 0x14); X1(0xDA);                                // mov r10, [r10+r11*8]
            } else if (esz == 4) { X3(0x4F, 0x63, 0x14); X1(0x9A); }
            else { X3(0x4F, 0x8B, 0x14); X1(0xDA); }                           // mov r10, [r10+r11*8]
            XSetV(0, 10);
            return;
        }
        if (el == "byte") { E4(0x38606820); return; }          // ldrb w0, [x1, x0]
        if (el == "sbyte") { E4(0x38A06820); return; }         // ldrsb x0, [x1, x0]
        if (el == "short") { E4(0x78A07820); return; }         // ldrsh x0, [x1, x0, lsl #1]
        if (el == "ushort" || el == "char") { E4(0x78607820); return; }    // ldrh w0, [x1, x0, lsl #1]
        if (el == "int") { E4(0xB8A07820); return; }           // ldrsw x0, [x1, x0, lsl #2]
        if (el == "uint") { E4(0xB8607820); return; }          // ldr w0, [x1, x0, lsl #2]
        if (el == "float") {
            E4(0xBC607820);                                    // ldr s0, [x1, x0, lsl #2]
            E4(0x1E22C000);                                    // fcvt d0, s0
            if (tgt86 == 1) { X3(0x66, 0x48, 0x0F); X2(0x7E, 0xC7); } else { E4(0x9E660000); }                                    // fmov x0, d0
            return;
        }
        if (el == "double") {
            E4(0xFC607820);                                    // ldr d0, [x1, x0, lsl #3]
            if (tgt86 == 1) { X3(0x66, 0x48, 0x0F); X2(0x7E, 0xC7); } else { E4(0x9E660000); }                                    // fmov x0, d0
            return;
        }
        if (esz == 4) { E4(0xB8A07820); return; }
        E4(0xF8607820);                                        // ldr x0, [x1, x0, lsl #3]
    }

    // [x1 base + x0 idx * esz] = x3 (value register), shaped from the
    // internal value convention
    void EmitSpanElemStore(string el, int esz) {
        if (tgt86 == 1) {
            // 值 -> r11、基址 -> r10、下标 -> rdx(v0 的真寄存器),lea 定址
            // 后单指令存储;float 先在 xmm0 收窄再落 r11 (batch 34)
            XGetV(1, 10);
            XGetV(0, 2);
            if (esz == 1) { X4(0x12148D4D); }                      // lea r10, [r10 + rdx*1]
            else if (esz == 2) { X4(0x52148D4D); }                 // lea r10, [r10 + rdx*2]
            else if (esz == 4) { X4(0x92148D4D); }                 // lea r10, [r10 + rdx*4]
            else { X4(0xD2148D4D); }                               // lea r10, [r10 + rdx*8]
            if (el == "float") {
                XGetV(3, 10);
                X3(0x66, 0x48, 0x0F); X2(0x6E, 0xC2);              // movq xmm0, rdx
                X3(0xF2, 0x0F, 0x5A); X1(0xC0);                    // cvtsd2ss xmm0, xmm0
                X3(0x66, 0x0F, 0x7E); X1(0xC2);                    // movd edx, xmm0
                X1(0x89); X1(0x12);                                // mov [r10], edx
                return;
            }
            XGetV(3, 11);
            if (esz == 1) { X3(0x45, 0x88, 0x1A); }                // mov [r10], r11b(rm=r10 需 B)
            else if (esz == 2) { X3(0x66, 0x45, 0x89); X1(0x1A); } // mov [r10], r11w(批37b:0x44 缺 B——rm=010 解码成 rdx,写错址)
            else if (esz == 4) { X3(0x45, 0x89, 0x1A); }           // mov [r10], r11d
            else { X3(0x4D, 0x89, 0x1A); }                         // mov [r10], r11
            return;
        }
        if (el == "byte" || el == "sbyte") { E4(0x38206823); return; }     // strb w3, [x1, x0]
        if (el == "short" || el == "ushort" || el == "char") { E4(0x78207823); return; }   // strh w3, [x1, x0, lsl #1]
        if (el == "int" || el == "uint") { E4(0xB8207823); return; }       // str w3, [x1, x0, lsl #2]
        if (el == "float") {
            E4(0x9E670064);                                    // fmov d4, x3
            E4(0x1E624084);                                    // fcvt s4, d4
            E4(0xBC207824);                                    // str s4, [x1, x0, lsl #2]
            return;
        }
        if (el == "double") {
            E4(0x9E670064);                                    // fmov d4, x3
            E4(0xFC207824);                                    // str d4, [x1, x0, lsl #3]
            return;
        }
        if (esz == 4) { E4(0xB8207823); return; }
        E4(0xF8207823);                                        // str x3, [x1, x0, lsl #3]
    }

    // span index bounds guard: x0 = idx, x1 = base, x2 = len on entry.
    // `keep` names one more live register (0 = none, e.g. the value of an
    // element store) that rides the stack beneath idx. On the good path
    // nothing changes; on the bad path the site reports and the access
    // answers 0 / stores nothing (soft runtime, like the array guard).
    void SpanIdxGuard(int line, int col, int keep) {
        int sbad = NL();
        int scont = NL();
        if (tgt86 == 1) { Xop(0x39, 7, 2); } else { E4(0xEB02001F); }                          // cmp x0, x2
        EmitBcond(10, sbad);                     // b.ge bad
        if (tgt86 == 1) { X3(0x48, 0x83, 0xFF); X1(0x00); } else { E4(0xEB1F001F); }                          // cmp x0, xzr
        EmitBcond(11, sbad);                     // b.lt bad
        EmitB(scont);
        Mark(sbad);
        XPushR(1);                          // keep base (guard clobbers x1)
        XPushV0();                          // keep idx
        if (keep > 0) { XPushR(keep); } // keep the live value
        LoadSymRef("l_.str." + guardFileIdx, 0);
        LoadImm(1, line);
        LoadImm(2, col);
        LoadSymRef("l_.str." + guardArrIdx, 3);
        BLInternal("_zan_rt_guard_fail3");
        if (keep > 0) { XPopV(keep); }
        XPopV(0);                          // pop idx
        XPopV(1);                          // pop base
        LoadImm(0, 0);
        Mark(scont);
    }

    // pop the view box, load base/len: entry [sp] = box, x0 = idx; exit
    // x1 = base, x2 = len, x0 = idx (the box is dropped -- leak-by-design)
    void SpanBoxDeref() {
        XPopV(1);                          // pop box -> x1
        LdrU(2, 1, 8);                           // x2 = len
        LdrU(1, 1, 0);                           // x1 = base
    }

    // arr.AsSpan([start[,len]]) / span.Slice(start[,len]): build the boxed
    // {base, len} view over an array (AsSpan) or an existing view (Slice).
    // The oracle's window check + safe clamp (irgen_generics.c): a negative
    // start/window, a start past the end, or a window past the remaining
    // elements reports "span range out of bounds" and folds to the EMPTY
    // view (start 0, len 0). x0 = this site's private frame box on return
    // (batch 12: a frame slot, not a heap allocation).
    void GenSpanView(Node e, Node recv, string contTy, bool isSlice) {
        int esz = isSlice ? SpanTyElemSize(contTy) : ArrElemSize(contTy);
        GenExpr(recv);                           // x0 = arr (element ptr) / box
        XPushV0();                          // push src
        XPopV(1);                          // pop src -> x1
        if (isSlice) {
            LdrU(2, 1, 8);                       // x2 = srclen
            LdrU(1, 1, 0);                       // x1 = srcbase
        } else {
            // an array value already points at its first element
            if (tgt86 == 1) { XMemV(1, 2, 1, -16); } else { E4(0xF85F0022); }   // x2 = srclen ([arr-16])
        }
        XPushR(1);                          // push srcbase
        XPushR(2);                          // push srclen (batch 34: was raw)
        if (e.kids.Count >= 1) { GenExpr(e.kids[0]); } else { LoadImm(0, 0); }
        XPushV0();                          // push start
        if (e.kids.Count >= 2) {
            GenExpr(e.kids[1]);                  // x0 = window
        } else {
            // window = srclen - start: peek the pushed operands in place
            // ([sp]=start, [sp+16]=srclen) so the push count stays 4
            LdrU(2, 31, 16);                     // x2 = srclen
            LdrU(3, 31, 0);                      // x3 = start
            StringSub(2, 2, 3);                      // sub x2, x2, x3
            MovRR(0, 2);                         // x0 = window
        }
        XPushV0();                          // push window
        // stack now: [sp]=window, [sp+16]=start, [sp+32]=srclen, [sp+48]=srcbase
        XPopV(0);                          // pop window -> x0
        XPopV(1);                          // pop start -> x1
        XPopV(2);                          // pop srclen -> x2
        XPopV(3);                          // pop srcbase -> x3
        int vbad = NL();
        int vok = NL();
        StringCmp(1, 2);                         // cmp x1, x2
        EmitBcond(12, vbad);                     // b.gt bad (start > srclen)
        if (tgt86 == 1) { X3(0x48, 0x83, 0xFF); X1(0x00); } else { E4(0xEB1F001F); }                          // cmp x0, xzr
        EmitBcond(11, vbad);                     // b.lt bad (window < 0)
        StringSub(4, 2, 1);                      // sub x4, x2, x1 (remaining)
        StringCmp(0, 4);                         // cmp x0, x4
        EmitBcond(12, vbad);                     // b.gt bad (window > remaining)
        StringCmp(1, 31);                        // cmp x1, xzr
        EmitBcond(11, vbad);                     // b.lt bad (start < 0)
        EmitB(vok);
        Mark(vbad);
        // soft path: report, then the empty view (start 0, window 0)
        XPushR(3);                          // keep srcbase
        LoadSymRef("l_.str." + guardFileIdx, 0);
        LoadImm(1, e.line);
        LoadImm(2, e.col);
        LoadSymRef("l_.str." + guardSpanIdx, 3);
        BLInternal("_zan_rt_guard_fail3");
        XPopV(3);                          // pop srcbase -> x3
        LoadImm(1, 0);                           // start = 0
        LoadImm(0, 0);                           // window = 0
        Mark(vok);
        // x0 = window, x1 = start, x3 = srcbase
        LoadImm(5, esz);
        MulRR(6, 1, 5);                          // mul x6, x1, x5 (start*esz)
        AddRR(4, 3, 6);                          // add x4, x3, x6 (newbase)
        XPushV0();                          // keep window
        XPushR(4);                          // keep newbase
        SpanSiteBox(e);                          // x0 = frame box (batch 12)
        XPopV(1);                          // pop newbase -> x1
        XPopV(2);                          // pop window -> x2
        StrU(1, 0, 0);                           // [box] = base
        StrU(2, 0, 8);                           // [box+8] = len
    }

    void CheckExternNg(Node m) {
        if (!HasMod(m, MOD.Static()) || HasTypeParams(m)) {
            diags.Error("ngen: extern requires a non-generic static method '" + m.sval + "'", m.line, m.col);
        }
        string rt = TypeFullName(m.type);
        if (rt != "void" && !ExternTyNg(rt)) {
            diags.Error("ngen: unsupported extern return ABI '" + rt + "' in '" + m.sval
                + "' (supported: void, string, byte[]/arrays-as-pointers, int/long/nint, narrow ints, float/double)", m.line, m.col);
        }
        int pc = ParamCount(m);
        if (pc > 24) { diags.Error("ngen: extern ABI supports at most 24 arguments in '" + m.sval + "'", m.line, m.col); }
        int i = 0;
        while (i < pc) {
            Node p = ParamAt(m, i);
            if (p == null) { return; }
            string pt = TypeFullName(p.type);
            // ref/out (p.ival) and params (p.op) pass through the existing
            // PushCallArgs machinery: GenRefArg hands the storage address,
            // the variadic tail is bundled into a packed array whose value
            // is the data pointer
            if (!ExternTyNg(pt)) {
                diags.Error("ngen: unsupported extern parameter ABI '" + pt + "' in '" + m.sval
                    + "' (supported: by-value scalars incl. nint/float/double, arrays as data pointers, ref/out, params)", m.line, m.col);
            }
            i = i + 1;
        }
    }

    // Mirror of PushCallArgs' push order: one entry per stack slot left by
    // the push phase, tagged with the extern parameter type that value was
    // converted to (that type -- not the argument expression's type -- picks
    // the AAPCS64 register class). The variadic tail contributes a single
    // bundle-array slot, matching the net stack shape.
    List<string> ExternArgClassTys(Node m, Node e) {
        List<string> res = new List<string>();
        if (e == null || e.a == null) { return res; }
        int pc = ParamCount(m);
        Node lastP = pc > 0 ? ParamAt(m, pc - 1) : null;
        bool variadic = lastP != null && lastP.op == 1;
        int fixedc = variadic ? pc - 1 : pc;
        int prov = e.kids.Count;
        List<Node> ak = e.kids;
        bool hasNamed = false;
        int k = 0;
        while (k < prov) {
            if (e.kids[k].sval2 != null && e.kids[k].sval2 != "") { hasNamed = true; }
            k = k + 1;
        }
        if (hasNamed) {
            int slots = pc > prov ? pc : prov;
            int[] slot = new int[slots];
            bool[] usedName = new bool[prov];
            k = 0;
            while (k < slots) { slot[k] = -1; k = k + 1; }
            k = 0;
            while (k < prov) {
                string an = e.kids[k].sval2;
                if (an == null || an == "") { k = k + 1; continue; }
                int found = -1;
                int j = 0;
                while (j < pc) {
                    Node pp = ParamAt(m, j);
                    if (pp != null && pp.sval == an) { found = j; break; }
                    j = j + 1;
                }
                if (found >= 0 && slot[found] < 0) {
                    slot[found] = k;
                    usedName[k] = true;
                }
                k = k + 1;
            }
            int j2 = 0;
            k = 0;
            while (k < prov) {
                if (usedName[k]) { k = k + 1; continue; }
                while (j2 < pc && slot[j2] >= 0) { j2 = j2 + 1; }
                if (j2 >= pc) { break; }
                slot[j2] = k;
                j2 = j2 + 1;
                k = k + 1;
            }
            bool dense = true;
            k = 0;
            while (k < prov) {
                if (slot[k] < 0 || slot[k] >= prov) { dense = false; break; }
                k = k + 1;
            }
            if (dense) {
                ak = new List<Node>();
                k = 0;
                while (k < prov) {
                    ak.Add(e.kids[slot[k]]);
                    k = k + 1;
                }
            }
        }
        if (variadic && prov == pc && IsArrValExpr(ak[prov - 1])) {
            int i = 0;
            while (i < prov) {
                Node pp = ParamAt(m, i);
                res.Add(pp != null && pp.type != null ? TypeFullName(pp.type) : "");
                i = i + 1;
            }
            return res;
        }
        int n = 0;
        while (n < prov && n < fixedc) {
            Node pp = ParamAt(m, n);
            res.Add(pp != null && pp.type != null ? TypeFullName(pp.type) : "");
            n = n + 1;
        }
        while (n < fixedc) {
            Node pp = ParamAt(m, n);
            res.Add(pp != null && pp.type != null ? TypeFullName(pp.type) : "");
            n = n + 1;
        }
        // [DllImport(Variadic = true)]: only the fixed prefix rides the push
        // phase (the ... tail goes to the stack varargs area that
        // CallStaticNg fills), so the class list ends at the fixed params
        if (variadic) {
            res.Add(TypeFullName(lastP.type));           // the bundle array
        }
        return res;
    }

    // the NativeMemory.Sha256 intrinsic: zan_sha256(data, len, out32) into
    // an sp scratch block, then the oracle's string shape — str_alloc(33),
    // memcpy of the 32 raw digest bytes, header stamped len=32 — so the
    // caller owns an ARC string exactly like any other produced string
    void EmitSha256CallNg(Node e) {
        // batch 34: the gate is gone -- _zan_sha256 is zan-emitted on both
        // lanes, and the csel/mov/orr raws became primitives
        GenExpr(e.kids[0]);                          // x0 = data ptr (nint)
        AddSPImm(48, false);                         // sub sp, sp, #48
        StrU(0, 31, 0);                              // sp[0] = data
        GenExpr(e.kids[1]);                          // x0 = len
        StringCmp(0, 31);                            // cmp x0, #0
        int clamp = NL();
        int done = NL();
        EmitBcond(11, clamp);                        // b.lt -> clamp
        MovRR(2, 0);
        EmitB(done);
        Mark(clamp);
        LoadImm(2, 0);
        Mark(done);
        LdrU(0, 31, 0);                              // x0 = data
        MovRR(1, 2);                                 // x1 = clamped len
        AddImm(2, 31, 16);                           // x2 = sp+16 (out32)
        BLExtern("_zan_sha256");                     // FIPS 180-4 digest
        LoadImm(0, 33);                              // 32 bytes + NUL
        BLInternal("_zan_rt_str_alloc");             // x0 = buf
        AddImm(1, 31, 16);                           // x1 = sp+16
        LoadImm(2, 32);
        BLExtern("_memcpy");                         // returns buf
        LoadImm(1, 0x5A414E5300000000);
        LoadImm(2, 32);
        OrrRR(1, 1, 2);                              // orr x1, x1, x2
        SubImm(0, 0, 8);
        StrU(1, 0, 0);                               // stamp [buf-8] len=32
        AddSPImm(48, true);                          // add sp, sp, #48
        AddImm(0, 0, 8);                             // x0 = buf
    }

    void CallStaticNg(int mi, Node e) {
        Node m = methNodes[mi];
        bool ext = HasMod(m, MOD.Extern());
        // the [DllImport] Sha256 decl only types the call: like the oracle
        // (irgen_expr.c emit_native_memory_call) the compiler lowers it as
        // an intrinsic producing an owned 32-raw-byte string
        if (m.sval == "Sha256" && methCls[mi] == "NativeMemory"
                && e.kids.Count == 2) {
            EmitSha256CallNg(e);
            return;
        }
        List<string> ats = ext ? ExternArgClassTys(m, e) : null;
        // a delegate-typed parameter of a generic-class static method arrives
        // open; the receiver's static type (an instance or extension
        // receiver) supplies the substitution source
        pendingCtorInstNg = e.a != null ? StaticTyOf(e.a) : null;
        int pushed = PushCallArgs(m, e);
        pendingCtorInstNg = null;
        // AAPCS64 allocation (extern only): the first eight integer-class
        // slots land in x0..x7 by their position among integer args; the
        // first eight float/double slots in d/s0..7 by their position among
        // fp args (moved over through scratch x10; floats narrow through
        // d31 so fcvt reads a dead temp). Quota-exhausted slots go to the
        // callee's packed stack-arg area: the reservation is made below the
        // pushes first (8-byte stride, argument order, padded so sp stays
        // 16-aligned), then every slot is read back by OFFSET from sp --
        // pops would walk into the reservation -- into its register or dest
        // slot. The caller reclaims reservation + push slots with one add
        // after the call.
        int[] ireg = null;
        int[] freg = null;
        int[] sidx = null;
        int[] tireg = null;
        int[] tfreg = null;
        int[] tsidx = null;
        int sres = 0;
        int vres = 0;
        int ntail = 0;
        int csTot = 0;
        bool dllVar = false;
        bool elfVar = false;
        if (ext) {
            ireg = new int[pushed];
            freg = new int[pushed];
            sidx = new int[pushed];
            int ci = 0;
            int cf = 0;
            int cs = 0;
            int pi = 0;
            while (pi < pushed) {
                string at = ats != null && pi < ats.Count ? ats[pi] : "";
                if (ExternFpTy(at)) {
                    if (cf < 8) { ireg[pi] = -1; freg[pi] = cf; cf = cf + 1; }
                    else { ireg[pi] = -2; sidx[pi] = cs; cs = cs + 1; }
                } else {
                    if (ci < 8) { ireg[pi] = ci; ci = ci + 1; }
                    else { ireg[pi] = -2; sidx[pi] = cs; cs = cs + 1; }
                }
                pi = pi + 1;
            }
            // [DllImport(Variadic = true)]: the two arms64 ABIs disagree on
            // where the ... tail goes. Apple arm64 passes every variadic
            // argument on the stack, right above any fixed stack-class args;
            // aarch64-linux instead allocates each tail by its natural class,
            // continuing the ordinary integer/fp register sequences and the
            // packed overflow area (clang oracle: fmt->x0, int varargs
            // w1,w2, double d0). Either way the tail values stage into
            // ntail(+pad) slots above the fixed dest slots: Apple leaves
            // them there as the ABI varargs area, ELF reads them back into
            // their destinations after the fixed readback.
            dllVar = m != null && HasMod(m, MOD.Variadic());
            ntail = dllVar ? (e != null ? e.kids.Count : 0) - pushed : 0;
            if (ntail < 0) { ntail = 0; }
            elfVar = dllVar && ntail > 0 && EnvTargetElf() == 1;
            if (ntail > 0) {
                tireg = new int[ntail];
                tfreg = new int[ntail];
                tsidx = new int[ntail];
            }
            int vk0 = 0;
            while (vk0 < ntail) {
                Node ae = e.kids[pushed + vk0];
                string tt = ae.kind == AK.OutArg() ? "" : StaticTyOf(ae);
                if (!elfVar) {
                    tireg[vk0] = -3;                     // Apple: tail is a stack arg
                } else if (IsDblExpr(ae) || tt == "float") {
                    // fp class: doubles as-is, floats as the doubles the C
                    // default promotions guarantee
                    if (cf < 8) { tireg[vk0] = -1; tfreg[vk0] = cf; cf = cf + 1; }
                    else { tireg[vk0] = -2; tsidx[vk0] = cs; cs = cs + 1; }
                } else if (ci < 8) {
                    tireg[vk0] = ci; ci = ci + 1;
                } else {
                    tireg[vk0] = -2; tsidx[vk0] = cs; cs = cs + 1;
                }
                vk0 = vk0 + 1;
            }
            sres = cs + (cs % 2);
            csTot = cs;
            vres = dllVar ? ntail + (ntail % 2) : 0;
            if (tgt86 != 1 && sres + vres > 0) {
                AddSPImm(8 * (sres + vres), false);      // sub sp, reserved (arm64 Apple va_list area; x86 tails push)
            }
        }
        if (ext && dllVar && ntail > 0) {
            // the ... tail: evaluate in order into the slots right above the
            // fixed dest slots. On Apple those slots ARE the ABI varargs
            // area (starting at sp above any fixed stack-class args); on
            // ELF they are staging for the post-readback move below. Each
            // value carries the C default promotions (float widens to
            // double, ints/pointers pass as i64). This must run BEFORE the
            // register readback -- GenExpr targets x0 and would clobber the
            // values being read back; the readback loads by absolute
            // offset, so the push slots are undisturbed.
            int vk = 0;
            while (vk < ntail) {
                Node ae = e.kids[pushed + vk];
                if (ae.kind == AK.OutArg()) {
                    GenRefArg(ae);
                } else {
                    GenExpr(ae);
                    GenCloneIfStruct(ae);
                    if (!IsDblExpr(ae) && !IsStrExpr(ae) && StaticTyOf(ae) == "float") {
                        if (tgt86 == 1) {
                            // batch 37: the shapes this branch catches hold
                            // SINGLE bits in rdi (the model keeps double
                            // bits everywhere else, so plain float idents
                            // skip it) -- re-read the low dword as single
                            // and widen to the promoted double the ABI wants
                            X3(0x66, 0x48, 0x0F); X2(0x6E, 0xC7);   // movq xmm0, rdi
                            X3(0xF3, 0x0F, 0x5A); X1(0xC0);         // cvtss2sd xmm0, xmm0
                            X3(0x66, 0x48, 0x0F); X2(0x7E, 0xC7);   // movq rdi, xmm0
                        } else {
                            E4(0x1E624000);                  // fcvt d0, s0
                            E4(0x9E660000);                  // fmov x0, d0
                        }
                    }
                }
                // Apple va_list starts just above the named stack args --
                // cs slots, NOT the 16-alignment-padded sres: an odd fixed
                // overflow count would otherwise shift every tail by 8.
                // ELF keeps staging at 8*sres, clear of its overflow dest
                // slots; the post-readback below does the ABI move.
                if (tgt86 == 1) { XPushV0(); } else {   // batch 33: x86 tails ride the push stream
                StrU(0, 31, 8 * (elfVar ? sres : csTot) + 8 * vk);   // [sp + off] = vararg k
                }
                vk = vk + 1;
            }
        }
        int r = pushed - 1;
        int xTot = pushed;
        int[] xCls = null;        // batch 37: 0 = integer class, 1 = fp class
        int[] xClsIdx = null;     // reg-class cursor (GPR / xmm), -1 = stack
        int[] xSPos = null;       // packed stack position in argument order
        if (tgt86 == 1 && ext) {
            // batch 37: the SysV SSE dual-cursor arm (replaces the batch 33
            // integer carve-out and its fail-closed). Integer-class args
            // fill rdi..r9 by their position among integer args (quota 6);
            // float/double args land in xmm0..7 by their position among fp
            // args (quota 8). The push slots hold double bits (the model
            // keeps every register float widened), so the readback movq's
            // the quad into the xmm and narrows only declared float params
            // (cvtsd2ss) -- a variadic tail keeps its promoted double, the
            // C default promotions already widened it. Quota-exhausted
            // slots of both classes share one packed stack area in
            // argument order (8-byte stride; XCallSeq stages it from the
            // v(6+k) homes). Variadic tails ride the push stream (no
            // Apple va_list area on x86), so the readback covers
            // pushed+ntail slots. out/ref params carry an address:
            // integer class whatever their declared type.
            xTot = pushed + ntail;
            xCls = new int[xTot];
            xClsIdx = new int[xTot];
            xSPos = new int[xTot];
            int xci = 0;
            int xcf = 0;
            int xcs = 0;
            int ta = 0;
            while (ta < xTot) {
                bool xfp;
                if (ta < pushed) {
                    Node xpa = ParamAt(m, ta);
                    xfp = (xpa == null || xpa.ival == 0) && ta < ats.Count
                        && ExternFpTy(ats[ta]);
                } else {
                    Node xae = e.kids[ta];
                    xfp = xae.kind != AK.OutArg()
                        && (IsDblExpr(xae) || StaticTyOf(xae) == "float");
                }
                if (xfp) {
                    if (xcf < 8) { xCls[ta] = 1; xClsIdx[ta] = xcf; xcf = xcf + 1; }
                    else { xCls[ta] = 1; xClsIdx[ta] = -1; xSPos[ta] = xcs; xcs = xcs + 1; }
                } else {
                    if (xci < 6) { xCls[ta] = 0; xClsIdx[ta] = xci; xci = xci + 1; }
                    else { xCls[ta] = 0; xClsIdx[ta] = -1; xSPos[ta] = xcs; xcs = xcs + 1; }
                }
                ta = ta + 1;
            }
            xStackArgs = xcs;
            xVecArgs = xcf;
            r = xTot - 1;
        }
        while (r >= 0) {
            if (tgt86 == 1 && ext) {
                // SysV readback, batch 37 class-aware: argument r sits at
                // [rsp + 16*(xTot-1-r)] (pushed in order, 16-byte steps).
                // Reg-class integer args go straight into their GPR; fp
                // args movq the quad (double bits) into xmm_vi and narrow
                // declared floats; stack-class args home into v(6+k) for
                // the call shim to stage (batch 33: any arity).
                int xoff = 16 * (xTot - 1 - r);
                if (xCls[r] == 0 && xClsIdx[r] >= 0) {
                    XopRMem(0x8B, XMapReal(xClsIdx[r]), 4, xoff);
                } else {
                    XopRMem(0x8B, 10, 4, xoff);            // mov r10, [rsp+off]
                    if (xClsIdx[r] >= 0) {
                        // movq xmm_vi, r10:REX 必须带 W(0x49 = W1 R0 X0
                        // B1)——W 缺了就解码成 movd(32 位装载,xmm 高半
                        // 清零),1.5 = 0x3FF8000000000000 低 dword 恒 0,
                        // printf %.1f 打 0.0(批46 首查我把它"修"成 0x43
                        // 反而引入此坑,llvm lldb 停 printf 现场 xmm0=0 定案)。
                        X1(0x66); X1(0x49); X2(0x0F, 0x6E);
                        X1(0xC0 | (xClsIdx[r] << 3) | 2);  // movq xmm_vi, r10
                        if (r < pushed && ats[r] == "float") {
                            X3(0xF2, 0x0F, 0x5A);
                            X1(0xC0 | (xClsIdx[r] << 3) | xClsIdx[r]);   // cvtsd2ss
                        }
                    } else {
                        // 批39:栈类 float 槽按 SysV eightbyte 打包 = 低
                        // 4 字节 float。批37 首版把加宽 double 位型整 8
                        // 字节落槽——double 8.5 = 0x4021_0000_0000_0000,
                        // 低 4 字节恒 0.0f(SumFI10 探针 = 42 现形)。
                        // movd 窄化回 r10(高位零填),XCallSeq movq 落槽
                        // 后低 4 字节即 C 调用约定要的 float 位型;变参尾
                        // 保持提升 double,不窄。
                        if (r < pushed && ats[r] == "float") {
                            // 首版 66 45 0F 6E 缺 REX.W 解码成 movd(32 位
                            // 装载,double 位型只剩低 dword=0)——REX 0x4D
                            // 才是 movq;movd 回写 7E 不带 W 是故意的。
                            X3(0x66, 0x4D, 0x0F); X1(0x6E); X1(0xFA);  // movq xmm15, r10
                            X3(0xF2, 0x45, 0x0F); X1(0x5A); X1(0xFF);  // cvtsd2ss xmm15, xmm15
                            X3(0x66, 0x45, 0x0F); X1(0x7E); X1(0xFA);  // movd r10d, xmm15(高位零填)
                        }
                        XSetV(XArgVOf(6 + xSPos[r]), 10);       // stack class: v(6+k) home
                    }
                }
            } else if (tgt86 == 1) {
                // SysV readback (internal calls): argument r sits at
                // [rsp + 16*(xTot-1-r)] (pushed in order, 16-byte steps).
                // Args 0..5 into their SysV registers, 6+ into the spill
                // homes the call shim stages (batch 33: any arity).
                if (r < 6) {
                    XopRMem(0x8B, XMapReal(r), 4, 16 * (xTot - 1 - r));
                } else {
                    XopRMem(0x8B, 10, 4, 16 * (xTot - 1 - r));
                    XSetV(XArgVOf(r), 10);
                }
            } else if (!ext) {
                XPopV(r);                      // pop xr, keep sp 16-aligned
            } else if (sres + vres > 0) {
                int off = 8 * (sres + vres) + 16 * (pushed - 1 - r);   // slot r: arg r was pushed r-th from the bottom
                if (ireg[r] == -2) {
                    LdrU(10, 31, off);                   // ldr x10, [sp, #src]
                    if (ats[r] == "float") {
                        E4(0x9E670150);                  // fmov d16, x10
                        E4(0x1E624211);                  // fcvt s17, d16
                        // 批39:Rn 域(bits9-5)不可省——首版漏 (31<<5),
                        // 解码成 str s17,[x0](x0 恰是首个整参值,SumFI10
                        // 探针 SEGV addr=0xa 定案)。
                        E4(0xBD000000 | (31 << 5) | ((8 * sidx[r] / 4) << 10) | 17);   // str s17, [sp, #dst]
                    } else {
                        StrU(10, 31, 8 * sidx[r]);       // str x10, [sp, #dst]
                    }
                } else if (ireg[r] == -1) {
                    LdrU(10, 31, off);                   // ldr x10, [sp, #src]
                    if (ats[r] == "double") {
                        E4(0x9E670000 | (10 << 5) | freg[r]);    // fmov dN, x10
                    } else {
                        E4(0x9E670000 | (10 << 5) | 31);         // fmov d31, x10
                        E4(0x1E624000 | (31 << 5) | freg[r]);    // fcvt sN, d31
                    }
                } else {
                    LdrU(ireg[r], 31, off);              // ldr xN, [sp, #src]
                }
            } else if (ireg[r] == -1) {
                E4(0xF84107E0 | 10);                     // pop scratch x10
                if (ats[r] == "double") {
                    E4(0x9E670000 | (10 << 5) | freg[r]);    // fmov dN, x10
                } else {
                    E4(0x9E670000 | (10 << 5) | 31);         // fmov d31, x10
                    E4(0x1E624000 | (31 << 5) | freg[r]);    // fcvt sN, d31
                }
            } else {
                E4(0xF84107E0 | ireg[r]);                // pop xr, keep sp 16-aligned
            }
            r = r - 1;
        }
        if (ext && elfVar) {
            // ELF variadic readback: each tail moves staging -> destination.
            // Register-class tails fill x/d slots continuing the fixed
            // sequences; overflow tails copy into their packed stack slot.
            // Doubles keep all 8 bits; no single-precision narrowing -- the
            // C default promotions already widened every float tail.
            int vk2 = ntail - 1;
            while (vk2 >= 0) {
                if (tireg[vk2] == -2) {
                    LdrU(10, 31, 8 * sres + 8 * vk2);
                    StrU(10, 31, 8 * tsidx[vk2]);    // staging -> overflow slot
                } else if (tireg[vk2] == -1) {
                    LdrU(10, 31, 8 * sres + 8 * vk2);
                    E4(0x9E670000 | (10 << 5) | tfreg[vk2]);   // fmov dN, x10
                } else if (tireg[vk2] >= 0) {
                    LdrU(tireg[vk2], 31, 8 * sres + 8 * vk2);
                }
                vk2 = vk2 - 1;
            }
        }
        if (tgt86 == 1 && !ext) {
            XAddRsp(16 * pushed);              // reclaim the push slots
            xStackArgs = pushed > 6 ? pushed - 6 : 0;
        }
        if (!ext) {
            BLInternal(MethSymNg(methCls[mi], m));
            return;
        }
        // Native strings/arrays already point at their bytes; nint/long carry
        // the full pointer/integer width. C int arguments use the low wN.
        BLExtern(ExternSymNg(m));
        if (tgt86 == 1) {
            XAddRsp(16 * xTot);                // batch 33: reclaim the push stream
        } else if (sres + vres > 0) {
            AddSPImm(8 * (sres + vres) + 16 * pushed, true);   // caller cleans dest + pushes
        }
        string rt = TypeFullName(m.type);
        // the stdlib decl says int, but the oracle lowers this call as an
        // intrinsic returning the full i64 CRC -- no sext may narrow it
        // (conformance native_memory compares it against 3421780262)
        if (m.sval == "Crc32" && methCls[mi] == "NativeMemory") { rt = "long"; }
        if (rt == "int") {
            Sxtw0();                              // sxtw x0, w0 (e.g. EOF == -1)
        } else if (rt == "short") {
            if (tgt86 == 1) { X3(0x48, 0x0F, 0xBF); X1(0xF8); } else { E4(0x93403C00); }   // sxth x0, w0 / movsx rdi, di
        } else if (rt == "ushort" || rt == "char") {
            if (tgt86 == 1) { X3(0x48, 0x0F, 0xB7); X1(0xF8); } else { E4(0x53003C00); }   // uxth w0, w0 / movzx rdi, di
        } else if (rt == "uint" || rt == "bool" || rt == "byte") {
            if (tgt86 == 1) { X2(0x89, 0xFF); } else { E4(0x2A0003E0); }   // mov w0, w0 / mov edi, edi
        } else if (rt == "sbyte") {
            if (tgt86 == 1) { X3(0x48, 0x0F, 0xBE); X1(0xF8); } else { E4(0x93401C00); }   // sxtb x0, w0 / movsx rdi, dil
        } else if (rt == "float") {
            if (tgt86 == 1) {
                // batch 37: C returned a single in xmm0's low dword -- the
                // model wants the widened double bits in rdi. (The old
                // line here emitted the arm64 fcvt word into the x86
                // stream: dead while the batch 33 fail-closed stood, and
                // wrong the moment it fell.)
                X3(0xF3, 0x0F, 0x5A); X1(0xC0);            // cvtss2sd xmm0, xmm0
                X3(0x66, 0x48, 0x0F); X2(0x7E, 0xC7);      // movq rdi, xmm0
            } else {
                E4(0x1E22C000);                            // fcvt d0, s0
                E4(0x9E660000);                            // fmov x0, d0
            }
        } else if (rt == "double") {
            if (tgt86 == 1) { X3(0x66, 0x48, 0x0F); X2(0x7E, 0xC7); } else { E4(0x9E660000); }                              // fmov x0, d0
        }
        if (ExternSymNg(m) == "_free" && e != null && e.kids.Count == 1) {
            GenInvalidateFreedStringNg(e.kids[0]);
        }
    }

    // a call to libc free() consumes its string argument: the reference nulls
    // the source reference afterwards (irgen_builtins.c
    // emit_invalidate_freed_string), so a following `== null` check agrees
    void GenInvalidateFreedStringNg(Node arg) {
        if (arg == null) { return; }
        if (arg.kind == AK.Ident()) {
            int li = LocalIdx(arg.sval);
            if (li >= 0) {
                if (locTy[li] != "string") { return; }
                LoadImm(0, 0);
                if (locRef[li]) {
                    LoadLocal(li, 1);
                    StrU(0, 1, 0);                       // store through the ref
                } else {
                    StoreLocalVal(li, 0);
                }
                return;
            }
            Fld fld = CurField(arg.sval);
            if (fld != null) {
                if (fld.ty != "string" || LocalIdx("this") < 0) { return; }
                LoadLocal(LocalIdx("this"), 0);          // receiver -> x0
                LoadImm(1, 0);                           // null -> x1
                StoreFieldNg(1, 0, fld);
                return;
            }
            string ssym = FindStaticSym(curCls, arg.sval);
            if (ssym != null) {
                if (FindStaticTy(curCls, arg.sval) != "string") { return; }
                LoadSymRef(ssym, 9);
                LoadImm(0, 0);
                StrU(0, 9, 0);
            }
            return;
        }
        if (arg.kind == AK.MemberAccess() && arg.a != null) {
            Fld fld = FieldOf(arg);
            if (fld == null || fld.ty != "string") { return; }
            GenExpr(arg.a);                              // receiver -> x0
            LoadImm(1, 0);                               // null -> x1
            StoreFieldNg(1, 0, fld);                     // str x1, [x0]
        }
    }

    Node FindStatic(string name) {
        List<int> cs = MethCandsName(name);
        if (cs == null) { return null; }
        int i = 0;
        while (i < cs.Count) {
            if (methStat[cs[i]] == 1) { return methNodes[cs[i]]; }
            i = i + 1;
        }
        return null;
    }

    // find an instance method by name (first match across classes)
    int FindInstanceIdx(string name) {
        List<int> cs = MethCandsName(name);
        if (cs == null) { return -1; }
        int i = 0;
        while (i < cs.Count) {
            if (methStat[cs[i]] == 0) { return cs[i]; }
            i = i + 1;
        }
        return -1;
    }

    bool IsVirtualMod(Node m) { return HasMod(m, MOD.Virtual()) || HasMod(m, MOD.Override()); }
    // what occupies a vtable slot: virtual, override, or an abstract
    // declaration (interfaces are all-abstract classes)
    bool IsSlotMod(Node m) { return IsVirtualMod(m) || HasMod(m, MOD.Abstract()); }

    int IndexOfStrNg(List<string> xs, string s) {
        int i = 0;
        while (i < xs.Count) { if (xs[i] == s) { return i; } i = i + 1; }
        return -1;
    }

    int MethodCountNg(string cls, string name) {
        int n = 0;
        List<int> cs = MethCandsClsName(cls, name);
        if (cs == null) { return 0; }
        int i = 0;
        while (i < cs.Count) {
            if (methStat[cs[i]] != 2) { n = n + 1; }
            i = i + 1;
        }
        return n;
    }

    // exported symbol for a method (static or instance). With a single
    // declaration the historical `_Cls_name` stands; with overloads the
    // parameter tags are appended so two methods cannot collide (mirrors
    // CtorSymNg). 缺口四: this plain name now carries the C-ABI export
    // shim; the compiled body lives one "__body" suffix away, and every
    // internal reference (BLInternal calls, vtable slots, delegate and
    // method-group loads, reflection thunks, async ramps) resolves to the
    // body through MethSymNg below.
    string MethExportSymNg(string cls, Node m) {
        string cs = ConversionSymNg(cls, m);
        if (cs != null) { return cs; }
        if (m.sval2 != null && m.sval2 != "" && m.sval2.IndexOf("<") < 0) { return "_" + m.sval2; }
        if (MethodCountNg(cls, m.sval) <= 1) { return "_" + cls + "_" + m.sval; }
        string s = "_" + cls + "_" + m.sval + "__";
        int i = 0;
        while (i < m.kids.Count) {
            Node p = m.kids[i];
            if (p.kind == AK.Param()) { s = s + "_" + TypeTagNg(p.type); }
            i = i + 1;
        }
        return s;
    }

    // symbol of the compiled body of a method: MethExportSymNg plus the
    // "__body" suffix. Constructed only here so registration and every
    // reference stay in lockstep.
    string MethSymNg(string cls, Node m) {
        return MethExportSymNg(cls, m) + "__body";
    }

    // vtable slot key of a method declaration: name + parameter type tags.
    // Overloads occupy distinct slots (C# matches overrides by signature),
    // so a virtual dispatch through one overload can never land in another
    string SlotKeyNg(Node m) {
        string s = m.sval;
        int i = 0;
        while (i < m.kids.Count) {
            Node p = m.kids[i];
            if (p.kind == AK.Param()) { s = s + "_" + TypeTagNg(p.type); }
            i = i + 1;
        }
        return s;
    }

    // is a slot-key tag an OPEN type parameter: a bare identifier that
    // resolves to no declared type or primitive ("T" in Box<T>.Put(T, T)).
    // Under erasure one shared body serves every instantiation, so such a
    // tag accepts any word tag the implementation declares.
    bool ErasedTagNg(string tag) {
        if (tag == null || tag.Length == 0) { return false; }
        if (tag.IndexOf("[") >= 0) { return false; }
        int dot = tag.IndexOf(".");
        string head = dot > 0 ? tag.Substring(0, dot) : tag;
        if (head == "int" || head == "long" || head == "ulong" || head == "double"
                || head == "bool" || head == "char" || head == "string"
                || head == "object" || head == "byte" || head == "sbyte"
                || head == "short" || head == "ushort" || head == "uint"
                || head == "float" || head == "nint" || head == "void") { return false; }
        return FindClass(head) == null;
    }

    // does a method occupy a slot key: exact key equality, or a generic
    // base's erased key ("Put_T_T") matching a concrete implementation
    // ("Put_int_int") tag-for-tag with open tags as wildcards
    bool SlotKeyMatchNg(Node m, string key) {
        string mk = SlotKeyNg(m);
        if (mk == key) { return true; }
        int un = mk.IndexOf("_");
        int uk = key.IndexOf("_");
        if (un <= 0 || uk <= 0) { return false; }
        if (mk.Substring(0, un) != key.Substring(0, uk)) { return false; }
        int i = un + 1;
        int j = uk + 1;
        while (i < mk.Length || j < key.Length) {
            int e1 = mk.IndexOf("_", i); if (e1 < 0) { e1 = mk.Length; }
            int e2 = key.IndexOf("_", j); if (e2 < 0) { e2 = key.Length; }
            string t1 = mk.Substring(i, e1 - i);
            string t2 = key.Substring(j, e2 - j);
            if (t1 != t2 && !ErasedTagNg(t2)) { return false; }
            if (e1 == mk.Length && e2 == key.Length) { return true; }
            if (e1 == mk.Length || e2 == key.Length) { return false; }
            i = e1 + 1;
            j = e2 + 1;
        }
        return true;
    }

    // virtual-slot keys of cls, base classes first; a derived
    // re-declaration of an inherited virtual keeps the base slot
    void CollectVSlotsNg(string cls, List<string> slots) {
        Cls c = FindClass(cls);
        if (c != null && c.baseName != null) { CollectVSlotsNg(c.baseName, slots); }
        List<int> mine = MethCandsCls(cls);
        if (mine == null) { return; }
        int i = 0;
        while (i < mine.Count) {
            int mi = mine[i];
            if (methStat[mi] == 0 && IsSlotMod(methNodes[mi])
                    && IndexOfStrNg(slots, SlotKeyNg(methNodes[mi])) < 0) { slots.Add(SlotKeyNg(methNodes[mi])); }
            i = i + 1;
        }
    }

    // slot index of method decl m in the receiver's static class's vtable,
    // or -1 when the call is not virtual
    int VSlotOf(string rc, Node m) {
        List<string> slots = new List<string>();
        CollectVSlotsNg(rc, slots);
        return IndexOfStrNg(slots, SlotKeyNg(m));
    }

    // instance-method candidates for a call on receiver class rc, derived
    // class first (shadowing picks the most-derived declaration)
    void InstanceCands(string rc, string name, List<int> outIdx) {
        string cur = rc;
        while (cur != null) {
            List<int> cs = MethCandsClsName(cur, name);
            if (cs != null) {
                int i = 0;
                while (i < cs.Count) {
                    if (methStat[cs[i]] == 0) { outIdx.Add(cs[i]); }
                    i = i + 1;
                }
            }
            Cls cc = FindClass(cur);
            cur = cc != null ? cc.baseName : null;
        }
    }

    // extension-method dispatch: `recv.Name(args)` with no instance or
    // static-through-instance match names a static method whose first
    // parameter is `this T` with T the receiver's static type (declared by
    // fn.ival == 1 in ParseParams). Candidates are ranked by temporarily
    // letting the receiver occupy the first argument slot, so the remaining
    // arguments score against parameters 1.. exactly like FitPickIdx.
    // Returns the chosen method index without mutating callNode, or -1.
    int ResolveExtNg(Node recv, string name, Node callNode) {
        string rt = ExtRecvTy(recv);
        if (rt == null) { return -1; }
        List<int> cands = new List<int>();
        List<int> nc = MethCandsName(name);
        if (nc != null) {
            int i = 0;
            while (i < nc.Count) {
                int mi = nc[i];
                Node m = methNodes[mi];
                if (methStat[mi] == 1 && m.ival == 1 && m.kids.Count > 0) {
                    Node p0 = ParamAt(m, 0);
                    string pt = p0 != null && p0.type != null ? TypeFullName(p0.type) : null;
                    if (pt == rt || (pt != null && IndexOfStrNg(DeclTps(m), pt) >= 0)) { cands.Add(mi); }
                }
                i = i + 1;
            }
        }
        if (cands.Count == 0) { return -1; }
        callNode.kids.Insert(0, recv);
        int pick = FitPickIdx(cands, callNode);
        callNode.kids.RemoveAt(0);
        return pick;
    }

    // static type name of an extension-method receiver: StaticTyOf plus the
    // literal shapes it does not cover ("hey".Shout(), (3).Twice())
    string ExtRecvTy(Node e) {
        if (e == null) { return null; }
        string t = StaticTyOf(e);
        if (t != null) { return t; }
        return ExtRecvLitTy(e);
    }

    string ExtRecvLitTy(Node e) {
        if (e == null) { return null; }
        if (e.kind == AK.IntLit()) {
            if (e.suffix == 2 || e.suffix == 3) { return "ulong"; }
            if (e.suffix == 1) { return "long"; }
            return "int";
        }
        if (e.kind == AK.StringLit()) { return "string"; }
        if (e.kind == AK.FloatLit()) { return "double"; }
        if (e.kind == AK.BoolLit()) { return "bool"; }
        if (e.kind == AK.CharLit()) { return "char"; }
        return null;
    }

    // the op_index / op_index_set instance method of cls (its base chain),
    // or null -- the indexer protocol obj[i] dispatches through
    Node OpIndexMethod(string cls) { return OpMethodInChain(cls, "op_index"); }
    Node OpIndexSetMethod(string cls) { return OpMethodInChain(cls, "op_index_set"); }
    Node OpMethodInChain(string cls, string name) {
        string cur = cls;
        while (cur != null) {
            Node m = FindInstanceInCls(cur, name);
            if (m != null) { return m; }
            Cls cc = FindClass(cur);
            cur = cc != null ? cc.baseName : null;
        }
        return null;
    }

    // first method of any kind whose declared name matches, or -1
    // (specialization lookups by mangled name)
    int FindMethByNameNg(string name) {
        List<int> cs = MethCandsName(name);
        return cs != null && cs.Count > 0 ? cs[0] : -1;
    }

    // property-accessor lookup: `name` (get_X / set_X) in cls's base chain,
    // statics and instance methods both qualify; the declaring class lands
    // in accOwnerCls so the symbol mangles against the right class
    string accOwnerCls;
    Node AccessorInChain(string cls, string name) {
        string cur = cls;
        while (cur != null) {
            List<int> cs = MethCandsClsName(cur, name);
            if (cs != null) {
                int i = 0;
                while (i < cs.Count) {
                    int st = methStat[cs[i]];
                    if (st == 0 || st == 1) {
                        accOwnerCls = cur;
                        return methNodes[cs[i]];
                    }
                    i = i + 1;
                }
            }
            Cls cc = FindClass(cur);
            cur = cc != null ? cc.baseName : null;
        }
        return null;
    }

    // among a class's op_index / op_index_set overloads, the one whose index
    // (and, for setters, value) parameters best fit the operand types, or
    // null -- indexer overloads are distinguished by their parameter types
    Node OpIndexFit(string cls, string name, Node idxExpr, Node valExpr) {
        Node best = null;
        int bestScore = -2000000000;
        string cur = cls;
        while (cur != null) {
            List<int> cs = MethCandsClsName(cur, name);
            if (cs != null) {
                int i = 0;
                while (i < cs.Count) {
                    int mi = cs[i];
                    if (methStat[mi] == 0 || methStat[mi] == 1) {
                        Node m = methNodes[mi];
                        // the indexer protocol takes both spellings: an
                        // instance op_index(idx[, val]) and a static
                        // op_index(self, idx[, val]) -- the register layout
                        // is identical either way (x0 receiver, x1 index,
                        // x2 value), only the parameter offset shifts
                        int ioff = 0;
                        if (methStat[mi] == 1) {
                            Node sp = ParamAt(m, 0);
                            if (sp == null || sp.type == null
                                    || TypeFullName(sp.type) != cur) { i = i + 1; continue; }
                            ioff = 1;
                        }
                        Node ip = ParamAt(m, ioff);
                        if (ip == null || ip.type == null) { i = i + 1; continue; }
                        int s1 = ArgParamScore(idxExpr, TypeFullName(ip.type));
                        if (s1 <= -100) { i = i + 1; continue; }
                        int score = s1;
                        if (valExpr != null) {
                            Node vp = ParamAt(m, ioff + 1);
                            if (vp == null || vp.type == null) { i = i + 1; continue; }
                            int s2 = ArgParamScore(valExpr, TypeFullName(vp.type));
                            if (s2 <= -100) { i = i + 1; continue; }
                            score = score + s2;
                        }
                        if (score > bestScore) { bestScore = score; best = m; }
                    }
                    i = i + 1;
                }
            }
            Cls cc = FindClass(cur);
            cur = cc != null ? cc.baseName : null;
        }
        return best;
    }

    string VSlotImplCls(string cls, string key) {
        string cur = cls;
        while (cur != null) {
            List<int> cs = MethCandsCls(cur);
            if (cs != null) {
                int i = 0;
                while (i < cs.Count) {
                    // an abstract declaration does not implement its own slot;
                    // the search continues down the chain to the concrete body
                    if (methStat[cs[i]] == 0 && SlotKeyMatchNg(methNodes[cs[i]], key)
                            && !HasMod(methNodes[cs[i]], MOD.Abstract())) { return cur; }
                    i = i + 1;
                }
            }
            Cls cc = FindClass(cur);
            cur = cc != null ? cc.baseName : null;
        }
        return null;
    }

    Node FindInstanceInCls(string cls, string name) {
        List<int> cs = MethCandsClsName(cls, name);
        if (cs == null) { return null; }
        int i = 0;
        while (i < cs.Count) {
            if (methStat[cs[i]] == 0) { return methNodes[cs[i]]; }
            i = i + 1;
        }
        return null;
    }

    // the concrete instance declaration occupying a signature-keyed slot
    Node FindInstanceInClsKey(string cls, string key) {
        List<int> cs = MethCandsCls(cls);
        if (cs == null) { return null; }
        int i = 0;
        while (i < cs.Count) {
            if (methStat[cs[i]] == 0 && SlotKeyMatchNg(methNodes[cs[i]], key)) { return methNodes[cs[i]]; }
            i = i + 1;
        }
        return null;
    }

    // does method m admit a call with argc arguments: the exact arity, a
    // `params` tail covering the rest, or trailing default parameters
    // filling the gap (gen0's method_accepts_arity)
    bool MethodAcceptsArity(Node m, int argc) {
        int pc = ParamCount(m);
        Node lastP = pc > 0 ? ParamAt(m, pc - 1) : null;
        bool variadic = lastP != null && lastP.op == 1;
        if (variadic) { return argc >= pc - 1; }
        // [DllImport(Variadic = true)]: the declared parameters are the fixed
        // prefix of a C varargs callee -- every argument beyond them is
        // well-formed (printf(fmt, ...))
        if (HasMod(m, MOD.Variadic())) { return argc >= pc; }
        if (argc == pc) { return true; }
        if (argc > pc) { return false; }
        int j = argc;
        while (j < pc) {
            Node p = ParamAt(m, j);
            if (p == null || p.b == null) { return false; }
            j = j + 1;
        }
        return true;
    }

    // overload resolution among candidate method indices: exact-arity
    // candidates outrank default-filled ones, each scored by
    // argument/parameter type agreement (same shape as FitCtorIdx)
    int FitPickIdx(List<int> cands, Node callNode) {
        int argc = callNode.kids.Count;
        int exact = -1; int exactScore = -2000000000;
        int filled = -1; int filledScore = -2000000000;
        int i = 0;
        while (i < cands.Count) {
            Node m = methNodes[cands[i]];
            if (MethodAcceptsArity(m, argc)) {
                int pc = ParamCount(m);
                int score = 0;
                bool compatible = true;
                int j = 0;
                while (j < argc && compatible) {
                    if (j < pc) {
                        Node p = ParamAt(m, j);
                        string pt = p != null && p.type != null ? TypeFullName(p.type) : null;
                        if (p != null && p.op == 1 && IsArrTy(pt)) {
                            // the params tail takes every remaining argument
                            // as an element, so it is ranked against the
                            // element type -- comparing an element with the
                            // array type would disqualify the only candidate
                            // that can take the call (Calc.Sum(1, 2, 3),
                            // gen0's method_args_score). The bundle handed
                            // over whole stays exact.
                            string et = pt.Substring(0, pt.Length - 2);
                            while (j < argc) {
                                Node ta = callNode.kids[j];
                                string tat = StaticTyOf(ta);
                                if (tat != null && tat == pt) {
                                    score = score + 8;
                                } else {
                                    int es = ArgParamScore(ta, et);
                                    if (es <= -100) { compatible = false; }
                                    score = score + es;
                                }
                                j = j + 1;
                            }
                        } else {
                            int s = ArgParamScore(callNode.kids[j], pt);
                            if (s <= -100) { compatible = false; }
                            score = score + s;
                        }
                    }
                    j = j + 1;
                }
                if (compatible) {
                    if (pc == argc) {
                        if (score > exactScore) { exactScore = score; exact = cands[i]; }
                    } else {
                        if (score > filledScore) { filledScore = score; filled = cands[i]; }
                    }
                }
            }
            i = i + 1;
        }
        if (exact >= 0) { return exact; }
        return filled;
    }

    // Shared by call emission and return-type inference, so an extern's
    // signature cannot be replaced by an unrelated same-named method.
    int ResolveStaticNg(Node e) {
        if (e.a == null) { return -1; }
        Node callee = e.a;
        string cls = curCls;
        bool bare = callee.kind == AK.Ident();
        if (!bare) {
            if (callee.kind != AK.MemberAccess() || callee.a == null) { return -1; }
            // namespace-qualified static call `Ns.Sub.Cls.Method(args)`:
            // the receiver is a pure dotted identifier path whose LAST
            // segment names the class (types register by simple name, so
            // the namespace prefix is decoration). The head must not be a
            // local, so genuine instance chains (`a.b.Method()`) fall
            // through to the instance handlers (irgen_call.c:4878).
            if (callee.a.kind == AK.MemberAccess()) {
                Node head = callee.a;
                while (head.kind == AK.MemberAccess()) { head = head.a; }
                if (head.kind != AK.Ident() || LocalIdx(head.sval) >= 0
                        || FindClass(callee.a.sval) == null) { return -1; }
                cls = callee.a.sval;
            } else if (callee.a.kind != AK.Ident()
                    || FindClass(callee.a.sval) == null) { return -1; }
            else { cls = callee.a.sval; }
        }
        List<int> cands = new List<int>();
        while (cls != null) {
            List<int> cs = MethCandsClsName(cls, callee.sval);
            if (cs != null) {
                int i = 0;
                while (i < cs.Count) {
                    if (methStat[cs[i]] == 1) { cands.Add(cs[i]); }
                    i = i + 1;
                }
            }
            Cls c = FindClass(cls);
            cls = c != null ? c.baseName : null;
        }
        if (bare && cands.Count == 0) {
            // An implicit this member outranks the legacy global-static
            // fallback (Lexer.Ident must not resolve to TK.Ident).
            if (LocalIdx("this") >= 0) {
                List<int> inst = new List<int>();
                InstanceCands(curCls, callee.sval, inst);
                if (inst.Count > 0) { return -1; }
            }
            List<int> gs = MethCandsName(callee.sval);
            if (gs != null) {
                int i = 0;
                while (i < gs.Count) {
                    if (methStat[gs[i]] == 1) { cands.Add(gs[i]); }
                    i = i + 1;
                }
            }
        }
        if (cands.Count == 0) { return -1; }
        int pick = cands.Count == 1 ? cands[0] : FitPickIdx(cands, e);
        return pick >= 0 ? pick : cands[0];
    }

    // find a static method declared by exactly this class (Class.Method()
    // form -- FindStaticIdx only matches by bare name)
    int FindStaticInCls(string cls, string name) {
        List<int> cs = MethCandsClsName(cls, name);
        if (cs == null) { return -1; }
        int i = 0;
        while (i < cs.Count) {
            if (methStat[cs[i]] == 1) { return cs[i]; }
            i = i + 1;
        }
        return -1;
    }

    // does the named class declare a constructor?
    bool ClassHasCtor(string cls) {
        List<int> mine = MethCandsCls(cls);
        if (mine == null) { return false; }
        int i = 0;
        while (i < mine.Count) {
            if (methStat[mine[i]] == 2) { return true; }
            i = i + 1;
        }
        return false;
    }

    // does the program itself declare a member of that class with this
    // name? (gen0 steps its built-ins aside per member, so defining one
    // Convert or Math method does not disable the others)
    bool UserDefinesClsMember(string cls, string name) {
        return MethCandsClsName(cls, name) != null;
    }

    // which scalar flavour does this expression carry, for x.ToString()
    // rendering (null = not a scalar: leave the call to method dispatch)?
    string ScalarToStringTy(Node e) {
        if (e == null) { return null; }
        if (e.kind == AK.IntLit()) { return "int"; }
        if (IsBoolExpr(e)) { return "bool"; }
        if (IsStrExpr(e)) { return "string"; }
        if (IsCharExpr(e)) { return "char"; }
        if (IsDblExpr(e)) { return "double"; }
        if (IsUlongExpr(e)) { return "ulong"; }
        if (e.kind == AK.CastExpr() && e.type != null) {
            // gen0 renders uint/ushort signed too (only ulong goes unsigned)
            string t = e.type.sval;
            if (t == "double" || t == "float") { return "double"; }
            if (t == "ulong") { return "ulong"; }
            if (t == "int" || t == "long" || t == "short" || t == "byte"
                    || t == "sbyte" || t == "uint" || t == "ushort") { return "int"; }
            return null;
        }
        if (e.kind == AK.Ident()) {
            int li = LocalIdx(e.sval);
            if (li >= 0) {
                string t = locTy[li];
                if (t == "int" || t == "long" || t == "short" || t == "byte"
                        || t == "sbyte" || t == "uint" || t == "ushort") { return "int"; }
                return null;
            }
            Fld f = CurField(e.sval);
            if (f != null && (f.ty == "int" || f.ty == "long"
                    || f.ty == "short" || f.ty == "byte")) { return "int"; }
            string st = FindStaticTy(curCls, e.sval);
            if (st == "int" || st == "long") { return "int"; }
            return null;
        }
        if (e.kind == AK.Call() && e.a != null) {
            string rt = CallRetTy(e);
            if (rt == "int" || rt == "long" || rt == "short" || rt == "byte") { return "int"; }
        }
        if (e.kind == AK.MemberAccess()) {
            Fld f = FieldOf(e);
            if (f != null && (f.ty == "int" || f.ty == "long"
                    || f.ty == "short" || f.ty == "byte")) { return "int"; }
        }
        // computed scalar shapes (parenthesized arithmetic, shifts, unary):
        // the bool/double/ulong probes above already classified their kinds,
        // so what remains of these operators renders through the int renderer
        if (e.kind == AK.Binary()) {
            int op = e.op;
            if (op == TK.Plus() || op == TK.Minus() || op == TK.Star()
                    || op == TK.Slash() || op == TK.Percent()
                    || op == TK.LessLess() || op == TK.GreaterGreater()
                    || op == TK.GreaterGreaterGreater()) { return "int"; }
        }
        if (e.kind == AK.Unary() && e.op == TK.Minus()) { return "int"; }
        return null;
    }

    // ---- method emission ----
    void EmitMainShim() {
        syms.Add(new Sym("_main", FnPad()));
        if (tgt86 == 1) {
            X1(0x55);                                    // push rbp (frame for the calls below)
            X3(0x48, 0x89, 0xE5);                        // mov rbp, rsp
        } else {
        E4(0xA9BF7BFD);                                  // stp x29, x30, [sp, #-16]! (save lr: bl below clobbers it)
        }
        EmitHostEntryArgs();
        BLInternal("_zan_rt_strpool_init");              // transition stub: literals are static __data blobs now, this body is empty
        if (embedDataIdx >= 0) { EmitEmbedRegisterCall(); }
        // static field initializers run before Main, in declaration order,
        // then each `static T()` type initializer in declaration order (gen0
        // parity: entry-time runs give the same observable order for a
        // single-file program and avoid a per-type guard on static access)
        int si2 = 0;
        while (si2 < sfInitCls.Count) {
            curCls = sfInitCls[si2];
            Cls initClass = FindClass(curCls);
            bool openGeneric = initClass != null && initClass.tps.Count > 0 && curCls.IndexOf("<") < 0;
            if (!openGeneric) {
                GenExpr(sfInitExpr[si2]);
                // narrow a long-valued literal into a declared int static
                string ity = si2 < sfInitTy.Count ? sfInitTy[si2] : null;
                if (ity == "int" && !IsDblExpr(sfInitExpr[si2]) && !IsStrExpr(sfInitExpr[si2])) {
                    if (tgt86 == 1) {
                        X3(0x48, 0x63, 0xFF);            // movsxd rdi, edi
                    } else {
                        Sxtw0();                  // sxtw x0, w0
                    }
                }
                if (ity == "float") { NarrowF32(); }
                LoadSymRef(sfInitSym[si2], 9);
                StrU(0, 9, 0);
            }
            si2 = si2 + 1;
        }
        int ci3 = 0;
        while (ci3 < methStat.Count) {
            if (methStat[ci3] == 3) { BLInternal("_" + methCls[ci3] + "_cctor"); }
            ci3 = ci3 + 1;
        }
        if ((mainCls == null || mainCls == "") && (designMainCls != null && designMainCls != "")) {
            mainCls = designMainCls;
        }
        curCls = mainCls;
        int mainIdx = FindStaticInCls(mainCls, "Main");
        string mainName = "Main";
        if (mainIdx < 0) {
            mainIdx = FindStaticInCls(mainCls, "__DesignMain");
            if (mainIdx >= 0) { mainName = "__DesignMain"; }
        }
        if (mainIdx >= 0 && ParamCount(methNodes[mainIdx]) == 1) {
            Node p = ParamAt(methNodes[mainIdx], 0);
            if (p != null && p.type != null && TypeFullName(p.type) == "string[]") { EmitMainArgsNg(); }
        }
        if (mainAsync && mainIdx >= 0) {
            // ngen_async hook F: async Main runs through the shim's pump
            EmitAsyncMainDriveNg(mainIdx);               // x0 = exit code
        } else {
            BLInternal("_" + mainCls + "_" + mainName);
            // Main's int return IS the process exit status (oracle parity:
            // `static int Main() { return 7; }` exits 7); void Main and the
            // no-Main-shape leave a defined 0
            if (mainIdx < 0 || TypeFullName(methNodes[mainIdx].type) == "void") {
                if (tgt86 == 1) { XLoadImm(0, 0); } else {
                E4(0xD2800000);                          // movz x0, #0
                }
            }
        }
        if (tgt86 == 1) {
            XEpilogue();                                 // leave; ret
        } else {
        E4(0xA8C17BFD);                                  // ldp x29, x30, [sp], #16
        E4(0xD65F03C0);                                  // ret
        }
        // ngen_async hook F precondition: the CPS runtime (co_ready /
        // co_sched_run_until / the gate helpers) must exist before any body
        // that can root-drive an await -- a sync Main doing `await X()`
        // inside a try hits EnsureAsyncRuntimeNg mid-body, and the lazy
        // emission splices the primitives right there: the body continues
        // after the blob while the pre-blob half falls through into
        // _zan_co_ready. Emitting it here, after the shim's ret where no
        // control reaches by fall-through, keeps every later call site a
        // pure symbol reference. Async-free programs skip the blob: its
        // co/io primitives would otherwise become undefined references on
        // the bare ELF runtime (crossboot).
        if (ProgramCanAwaitNg()) { EnsureAsyncRuntimeNg(); }
    }

    // startup registration of the baked resource table: one 24-byte
    // zan_embed_ent {name*, data*, len} malloc'd for the process lifetime
    // (leak-by-design, like gen0's static data object), handed to the
    // embed registry before any static initializer can touch Pinyin
    void EmitEmbedRegisterCall() {
        LoadImm(0, 24);
        BLExtern("_malloc");                         // x0 = entry
        MovRR(4, 0);                                 // x4 = entry
        LoadSymRef("l_.str." + embedNameIdx, 1);
        StrU(1, 4, 0);
        LoadSymRef("l_.str." + embedDataIdx, 1);
        StrU(1, 4, 8);
        LoadImm(1, embedDataLen);
        StrU(1, 4, 16);
        MovRR(0, 4);                                 // x0 = tbl
        LoadImm(1, 1);                               // x1 = count
        BLInternal("_zan_embed_register");
    }

    // the embed read API, defined in this object (embedres parity): the
    // program's definitions win the link against the shipped crt-transition
    // stubs, whose table is always empty and whose read returns NULL instead
    // of "". Registry slot layout follows src/runtime/zan_embed_api.c.
    void EmitEmbedApiNg() {
        // void zan_embed_register(const void* tbl, long long n) -- leaf
        syms.Add(new Sym("_zan_embed_register", FnPad()));
        LoadSymRef(DGlobalSym("embed.gtbl"), 2);
        StrU(0, 2, 0);
        LoadSymRef(DGlobalSym("embed.gcnt"), 2);
        StrU(1, 2, 0);
        E4(0xD65F03C0);                              // ret
        // const void* zan_embed_find(const char* name): linear scan of the
        // registered table, strcmp per entry; x19 keeps the needle across
        // the libc call
        syms.Add(new Sym("_zan_embed_find", FnPad()));
        E4(0xA9BE7BFD);                              // stp x29, x30, [sp, #-32]!
        E4(0x910003FD);                              // mov x29, sp
        E4(0xA90153F3);                              // stp x19, x20, [sp, #16]
        MovRR(19, 0);                                // x19 = needle
        LoadSymRef(DGlobalSym("embed.gtbl"), 20);
        LdrU(20, 20, 0);                             // x20 = tbl
        LoadSymRef(DGlobalSym("embed.gcnt"), 0);
        LdrU(0, 0, 0);                               // x0 = n
        LoadImm(1, 24);
        E4(0x9B010000);                              // mul x0, x0, x1
        E4(0x8B000294);                              // add x20, x20, x0 (end)
        LoadSymRef(DGlobalSym("embed.gtbl"), 21);
        LdrU(21, 21, 0);                             // x21 = cursor
        int loopL = NL();
        int hitL = NL();
        int missL = NL();
        int doneL = NL();
        Mark(loopL);
        E4(0xEB1402BF);                              // cmp x21, x20
        EmitBcond(2, missL);                         // b.hs miss
        LdrU(8, 21, 0);                              // x8 = entry->name
        CbzReg(8, loopL);                            // null name: skip
        MovRR(0, 8);
        MovRR(1, 19);
        BLExtern("_strcmp");
        CbzReg(0, hitL);                             // equal: hit
        AddImm(21, 21, 24);
        EmitB(loopL);
        Mark(hitL);
        MovRR(0, 21);                                // x0 = entry
        EmitB(doneL);
        Mark(missL);
        LoadImm(0, 0);
        Mark(doneL);
        E4(0xA94153F3);                              // ldp x19, x20, [sp, #16]
        E4(0xA8C27BFD);                              // ldp x29, x30, [sp], #32
        E4(0xD65F03C0);                              // ret
        // int zan_embed_has(const char* name)
        syms.Add(new Sym("_zan_embed_has", FnPad()));
        E4(0xA9BF7BFD);                              // stp x29, x30, [sp, #-16]!
        BLInternal("_zan_embed_find");
        if (tgt86 == 1) { X3(0x48, 0x83, 0xFF); X1(0x00); } else { E4(0xEB1F001F); }                              // cmp x0, xzr
        E4(0x1A9F07E0);                              // cset w0, ne
        E4(0xA8C17BFD);                              // ldp x29, x30, [sp], #16
        E4(0xD65F03C0);                              // ret
        // const char* zan_embed_read(const char* name): NUL-terminated
        // payload; "" (not NULL) when absent, like gen0
        syms.Add(new Sym("_zan_embed_read", FnPad()));
        E4(0xA9BF7BFD);
        BLInternal("_zan_embed_find");
        int gotR = NL();
        int noneR = NL();
        CbzReg(0, noneR);
        LdrU(0, 0, 8);                               // x0 = entry->data
        EmitB(gotR);
        Mark(noneR);
        LoadSymRef("l_.str." + embedEmptyIdx, 0);    // ""
        Mark(gotR);
        E4(0xA8C17BFD);
        E4(0xD65F03C0);
        // const void* zan_embed_bytes(const char* name, int* outLen)
        syms.Add(new Sym("_zan_embed_bytes", FnPad()));
        E4(0xA9BE7BFD);                              // stp x29, x30, [sp, #-32]!
        E4(0x910003FD);                              // mov x29, sp
        E4(0xA90153F3);                              // stp x19, x20, [sp, #16]
        MovRR(19, 1);                                // x19 = outLen
        BLInternal("_zan_embed_find");
        int bSkipW = NL();
        int bSkipN = NL();
        int bNone = NL();
        int bDone = NL();
        CbzReg(0, bNone);
        LdrU(8, 0, 16);                              // x8 = entry->len
        CbzReg(19, bSkipW);
        E4(0xB9000268);                              // str w8, [x19]
        Mark(bSkipW);
        LdrU(0, 0, 8);                               // x0 = entry->data
        EmitB(bDone);
        Mark(bNone);
        CbzReg(19, bSkipN);
        E4(0xB900027F);                              // str wzr, [x19]
        Mark(bSkipN);
        LoadImm(0, 0);
        Mark(bDone);
        E4(0xA94153F3);                              // ldp x19, x20, [sp, #16]
        E4(0xA8C27BFD);                              // ldp x29, x30, [sp], #32
        E4(0xD65F03C0);                              // ret
    }

    // Materialize Main(string[] args), excluding argv[0]. Use the ordinary
    // array header and owning host string copies, not the borrowed C argv.
    void EmitMainArgsNg() {
        Node env = new Node(AK.Ident()); env.sval = "Environment";
        Node member = new Node(AK.MemberAccess()); member.a = env; member.sval = "ArgCount";
        Node count = new Node(AK.Call()); count.a = member;
        GenArrNew(count, 8);
        XPushV0();                              // stack[16] = array
        LoadImm(0, 0);
        XPushV0();                              // stack[0] = index
        int loop = NL(); int done = NL();
        Mark(loop);
        LdrU(9, 31, 16);
        SubImm(10, 9, 16); LdrU(10, 10, 0);         // array count
        LdrU(0, 31, 0);
        E4(0xEB0A001F);                              // cmp x0, x10
        EmitBcond(10, done);                         // b.ge done
        BLInternal("_zan_host_argat");              // owning string copy
        LdrU(9, 31, 16); LdrU(10, 31, 0);
        E4(0xF82A7920);                              // str x0, [x9, x10, lsl #3]
        AddImm(10, 10, 1); StrU(10, 31, 0);
        EmitB(loop);
        Mark(done);
        AddSPImm(16, true);
        XPopV(0);                              // array -> first Main argument
    }

    // 批39:x86 导出垫片通用臂(np>6)。SysV 双游标(整数 GPR×6 +
    // SSE xmm×8)溢出即栈——栈槽按参序逐个排布(整/双 8 字节,float
    // 4 字节);x86 体内模型 = 6 个 GPR 槽 + 调用点 [rsp+8k] 起的 8
    // 字节栈槽区。臂做四件事:xmm 浮点原位展宽(cvtss2sd,调用方的
    // xmm 出口即死)→ 整参降序压实(dest 恒 ≥ 源,批36 同一证明)→
    // 栈源装 staging(源在 rbp 之上、staging 在 rsp 之下,零重叠;
    // float 栈槽 movss/cvtss2sd/movq 4→8 展宽)→ 寄存器浮点落位
    // (槽 <6 直落家 GPR,≥6 落 staging)。裸 E8 调用(staging 已由
    // 本臂自管,area 公式与 XCallSeq 一致,调用点 16 对齐)。
    void EmitX86ExportGeneralArm(string cls, Node m, int[] kind, int np, string rt, Cls retC, string[] pts) {
        bool retHid = retC != null && AggRetHidden(retC);
        // 批42:隐返缓冲占 rdi——C 整参源寄存器右移一位(参数 0 在
        // rsi),浮点走 xmm 不受影响,栈参不动;缓冲 stash 进尾槽。
        int g86 = retHid ? 1 : 0;
        int xx86 = 0;
        int sb86 = 0;
        int[] sCls = new int[np];
        int[] sN = new int[np];
        int q86 = 0;
        while (q86 < np) {
            if (kind[q86] != 0) {
                if (xx86 < 8) { sCls[q86] = 1; sN[q86] = xx86; xx86 = xx86 + 1; }
                // SysV 栈区按 eightbyte 打包:每个栈参独占 8 字节槽
                // (float 只用低 4 字节)。首版 float 走 +4,后面跟着的
                // 栈参会整体错位——SumFI10 探针(9 float + 1 int)定案。
                else if (kind[q86] == 2) { sCls[q86] = 3; sN[q86] = sb86; sb86 = sb86 + 8; }
                else { sCls[q86] = 4; sN[q86] = sb86; sb86 = sb86 + 8; }
            } else {
                if (g86 < 6) { sCls[q86] = 0; sN[q86] = g86; g86 = g86 + 1; }
                else { sCls[q86] = 2; sN[q86] = sb86; sb86 = sb86 + 8; }
            }
            q86 = q86 + 1;
        }
        X1(0x55);                                    // push rbp
        X3(0x48, 0x89, 0xE5);                        // mov rbp, rsp
        int nst86 = np - 6;
        if (nst86 < 0) { nst86 = 0; }
        // 8*nst86 舍入到 16;本臂也被 !ok 侧 np≤8 的数组/Span 标量形状
        // 复用,那时 nst86≤0(无栈槽)——负 imm 会让 sub rsp,-16 变
        // add rsp,16 砸栈,必须归零。
        // 批42:隐返缓冲 stash 槽——rdi 既是 C 源又被 permute 覆写(decl
        // 槽 0 的家正是 rdi),体返回后须从 staging 还原缓冲回拷字段。
        int retSlot86 = -1;
        if (retHid) { retSlot86 = nst86; nst86 = nst86 + 1; }
        int area86 = nst86 > 0 ? 16 * ((nst86 + 1) / 2) : 0;
        XSubRsp(area86);                             // staging 区 + 16 对齐
        if (retHid) { XopMemR(0x89, 7, 4, 8 * retSlot86); }      // mov [rsp+8retSlot],rdi
        q86 = 0;
        while (q86 < np) {                           // xmm float 原位展宽
            if (sCls[q86] == 1 && kind[q86] == 2) { X3(0xF3, 0x0F, 0x5A); X1(0xC0 | (sN[q86] << 3) | sN[q86]); }
            q86 = q86 + 1;
        }
        // 整参落位(降序,先于一切浮点落位——batch 36 证明:浮点的
        // decl 家 GPR 可能正是后序整参的 SysV 压实源,浮点先行必毁源)。
        // 两类:SysV-GPR 整参(sCls 0)——decl<6 搬进 decl 家 GPR,
        // decl≥6 的体内家是栈槽 8*(decl-6),必须 XMovGG 进 r10 再落栈
        // (首版 XMapReal(decl) 对 decl 9 给出 rax=v9 返回值槽,SumFI10
        // 现形);SysV-栈 整参(sCls 2)从 rbp+16+off 读进栈槽。
        // 批42:隐返整参链 source=dest+1,方向与 float 混排(dest≥
        // source)相反——降序先 rdx←rcx 再 rsi←rdx,读到的是 param2
        // 的值(MakeBig 90=30+30+30 现形)。隐返升序、常规降序,各自
        // 永不覆写未读源。
        int k86 = retHid ? 0 : np - 1;
        while (k86 >= 0 && k86 < np) {
            if (sCls[k86] == 0) {
                if (k86 < 6) {
                    // 批45:寄存器整参入口规范化(见 ShimWidenOf)——寄存
                    // 器 32 位写硬件零扩,负 int 非 sxtw 规范形;无符号零扩
                    // 形同参同寄存器也要发(纯零扩非空转)。
                    int w45 = ShimWidenOf(pts[k86]);
                    if (w45 == 1) { Xmovsxd(XMapReal(k86), XMapReal(sN[k86])); }
                    else if (w45 == 2) { Xmov32(XMapReal(k86), XMapReal(sN[k86])); }
                    else if (k86 != sN[k86]) { XMovGG(XMapReal(k86), XMapReal(sN[k86])); }
                } else {
                    XMovGG(10, XMapReal(sN[k86]));             // mov r10, r_sN
                    XopMemR(0x89, 10, 4, 8 * (k86 - 6));       // mov [rsp+8k], r10
                }
            }
            k86 = k86 + (retHid ? 1 : -1);
        }
        q86 = 0;
        while (q86 < np) {                           // 栈源 → staging
            // 本臂自带且仅有一层 prologue:push rbp 后 rbp = entry-8,
            // 调用者栈参首字节在 entry+8 = rbp+16。批 39 首版写 8+off,
            // 叠上 ok 路径的双重 prologue 读到的是保存的 rbp/返回地址。
            // 批45:栈整参槽只定义低 32 位(高 4 字节阴影垃圾),按类型
            // 读低 32 符号/零展宽。
            if (sCls[q86] == 2) {
                int w45 = ShimWidenOf(pts[q86]);
                int d45 = 16 + sN[q86];
                if (w45 == 1) {
                    if (d45 < 128 && d45 > -128) { X3(0x4C, 0x63, 0x55); X1(d45); }
                    else { X3(0x4C, 0x63, 0x95); X4(d45); }    // movsxd r10,[rbp+d]
                } else if (w45 == 2) {
                    if (d45 < 128 && d45 > -128) { X3(0x44, 0x8B, 0x55); X1(d45); }
                    else { X3(0x44, 0x8B, 0x95); X4(d45); }    // mov r10d,[rbp+d]
                } else { XopRMem(0x8B, 10, 5, d45); }
                // 批48:落位按体内家路由——家在 decl<6 寄存器(隐返第 6
                // 参家 = r9)经 r10 全宽搬家(展宽已在装 r10 时完成,64
                // 位搬家保持规范形);家在栈槽(decl≥6)直落。家寄存器无
                // 源覆写险:寄存器源整参链已在整参落位轮搬完,本轮栈源
                // 只写不读。
                if (q86 < 6) { XMovGG(XMapReal(q86), 10); }
                else { XopMemR(0x89, 10, 4, 8 * (q86 - 6)); }   // mov [rsp+8k], r10
            } else if (sCls[q86] == 4) {
                XopRMem(0x8B, 10, 5, 16 + sN[q86]);            // mov r10, [rbp+16+off]
                XopMemR(0x89, 10, 4, 8 * (q86 - 6));           // mov [rsp+8k], r10
            } else if (sCls[q86] == 3) {
                // movss xmm15, [rbp+16+off](reg=111+R → xmm15)→
                // cvtss2sd xmm15, xmm15(F3 0F 5A,展宽;F2 是反向的
                // cvtsd2ss,把 4 字节槽读成 double 再窄化 = 垃圾)→
                // movq r10, xmm15(66 4D 0F 7E,xmm→GPR;6E 反向)
                X3(0xF3, 0x44, 0x0F); X1(0x10);
                int d86 = 16 + sN[q86];
                if (d86 < 128 && d86 > -128) { X1(0x7D); X1(d86); } else { X1(0x9D); X4(d86); }
                X3(0xF3, 0x45, 0x0F); X1(0x5A); X1(0xFF);
                X2(0x66, 0x4D); X2(0x0F, 0x7E); X1(0xFA);
                XopMemR(0x89, 10, 4, 8 * (q86 - 6));
            }
            q86 = q86 + 1;
        }
        q86 = 0;
        while (q86 < np) {                           // 寄存器浮点落位
            if (sCls[q86] == 1) {
                if (q86 < 6) {
                    int hd86 = XMapReal(q86);
                    X1(0x66); X1(0x48 | (hd86 >> 3)); X1(0x0F); X1(0x7E);
                    X1(0xC0 | (sN[q86] << 3) | (hd86 & 7));        // movq r_home, xv
                } else {
                    // 0F 7E = xmm→GPR(方向在操作码里:6E 是 GPR→xmm,
                    // 用反了会把实参 xmm 毁成 r10 旧值——otool 实证
                    // movq %r10,%xmm6 后 staging 全是垃圾)。
                    X2(0x66, 0x49); X2(0x0F, 0x7E); X1(0xC0 | (sN[q86] << 3) | 2);   // movq r10, xv
                    XopMemR(0x89, 10, 4, 8 * (q86 - 6));
                }
            }
            q86 = q86 + 1;
        }
        X1(0xE8);                                    // call body(裸调用)
        fixups.Add(new Fixup(txt.Count - 1, 3, 0, 0, MethSymNg(cls, m)));
        X4(0);
        if (retC != null) {
            // 批42:聚合返回尾(同 AggArm):隐返先出 staging 还原缓冲,
            // 值返回重组进 C 返回寄存器;标量返回转换跳过。
            if (retHid) { XopRMem(0x8B, 11, 4, 8 * retSlot86); } // mov r11,[rsp+8retSlot]
            XAddRsp(area86);
            if (retHid) { XEmitAggRetHidden(retC); }
            else { XEmitAggRetPack(retC); }
            // 裸 leave;ret——XEpilogue 自带 mov rax,rdi(体内返回约定
            // v0→rax),会把重组好的 rax 毁成 rdi 残值(MakePt 探针现形:
            // p.x = 堆指针低位)
            X1(0xC9); X1(0xC3);                          // leave; ret
            return;
        }
        XAddRsp(area86);
        XMov(7, 0);                                  // mov rdi, rax(v0 = 结果)
        if (rt == "double") {
            X3(0x66, 0x48, 0x0F); X2(0x6E, 0xC7);    // movq xmm0, rdi
        } else if (rt == "float") {
            X3(0x66, 0x48, 0x0F); X2(0x6E, 0xCF);    // movq xmm1, rdi
            X3(0xF2, 0x0F, 0x5A); X1(0xC1);          // cvtsd2ss xmm0, xmm1
        }
        XEpilogue();                                 // leave; ret
    }

    // 批39: arm64 np>8 标量导出通用排列臂(AAPCS64 → 体内槽)。体内模型
    // 把每个 decl 参数按序放 x0..x9+（浮点 = 加宽 double 位型），而
    // AAPCS64 给整数类 x0-x7、浮点类 v0-v7 各自压实，第 9+ 参落
    // [entry_sp+8j] 栈槽（float 只占低 4 字节）——E4 直通必错（批39
    // 探针 SumI9=-95509744、Mix10=21 定案）。排列与批33 np≤8 SSE 垫片
    // 同序:整参降序(rank→decl 家)先行,浮点升序后落——浮点的 decl 家
    // x 槽可能是后序整参的源,浮点先行必毁源。溢出整参/浮参从栈槽直装
    // x_decl/fcvt,无 staging 区(体内不用栈传参,与 x86 通用臂异构)。
    void EmitArm64ExportGeneralArm(string cls, Node m, int[] kind, int np, string rt, Cls retC, string[] pts) {
        // 批42:隐返缓冲在 x8(独立寄存器,不占 x0-x7/v0-v7,传参不移
        // 位);x8 非 callee-saved,体调用会毁——栈上 stash 16 字节暂存,
        // 溢出参数的栈槽读取相应上移。
        bool retHid = retC != null && AggRetHidden(retC);
        int stashA = retHid ? 16 : 0;
        int xa86 = 0;
        int va86 = 0;
        int ja86 = 0;
        int[] xClsA = new int[np];
        int[] xNA = new int[np];
        int qa = 0;
        while (qa < np) {
            if (kind[qa] != 0) {
                if (va86 < 8) { xClsA[qa] = 1; xNA[qa] = va86; va86 = va86 + 1; }
                else if (kind[qa] == 2) { int sa = (ja86 + 3) & ~3; xClsA[qa] = 3; xNA[qa] = sa; ja86 = sa + 4; }
                else { int sa = (ja86 + 7) & ~7; xClsA[qa] = 3; xNA[qa] = sa; ja86 = sa + 8; }
            } else {
                if (xa86 < 8) { xClsA[qa] = 0; xNA[qa] = xa86; xa86 = xa86 + 1; }
                else {
                    // 批50:栈参 NSAA 字节模型 —— 落位按自然对齐、推进按自
                    // 然尺寸:窄整 4 对齐 4 推进(Apple clang 反汇编:两栈
                    // 整参 str w,[x8] 后 [x8,#4] 紧排)、float 同 4,8 字节
                    // 类 8 对齐 8 推进。首版序数×8 把第 2 个起的栈窄参读进
                    // +4 阴影(SumI10/Pick10 拿到 ASLR 垃圾现形)
                    int w = CStackW(pts[qa]);
                    int sa = (ja86 + 7) & ~7;
                    if (w != 8) { sa = (ja86 + 3) & ~3; }
                    xClsA[qa] = 2; xNA[qa] = sa; ja86 = sa + w;
                }
            }
            qa = qa + 1;
        }
        E4(0xA9BF7BFD);                                  // stp x29, x30, [sp, #-16]!
        if (retHid) {
            AddSPImm(16, false);
            StrU(8, 31, 0);                              // str x8,[sp](C 隐返缓冲)
        }
        qa = np - 1;
        while (qa >= 0) {                                // 寄存器整参降序归位
            // 批45:入口规范化(见 ShimWidenOf)——sxtw/零扩后归位。
            if (xClsA[qa] == 0) {
                int w45 = ShimWidenOf(pts[qa]);
                if (w45 == 1) { E4(0x93407C00 | (xNA[qa] << 5) | qa); }        // sxtw x_qa, w_src(SBFM #0,#31=93407C00;93401C00 是 SXTB 低字节,≥128 值必碎)
                else if (w45 == 2) { E4(0x2A0003E0 | (xNA[qa] << 16) | qa); }  // mov w_qa, w_src(零扩)
                else if (qa != xNA[qa]) { MovRR(qa, xNA[qa]); }
            }
            qa = qa - 1;
        }
        qa = 0;
        while (qa < np) {                                // 溢出整参:栈槽 → x_decl
            // 批45:栈整参槽只定义低 32 位(高半阴影垃圾),按类型
            // ldrsw/ldr w 展宽。
            if (xClsA[qa] == 2) {
                int w45 = ShimWidenOf(pts[qa]);
                int o45 = 16 + stashA + xNA[qa];
                if (w45 == 1) { E4(0xB9800000 | ((o45 / 4) << 10) | (31 << 5) | qa); }        // ldrsw x_qa
                else if (w45 == 2) { E4(0xB9400000 | ((o45 / 4) << 10) | (31 << 5) | qa); }   // ldr w_qa(零扩)
                else { LdrU(qa, 31, o45); }
            }
            qa = qa + 1;
        }
        qa = 0;
        while (qa < np) {                                // 浮点升序落 decl 家
            if (xClsA[qa] == 1) {
                if (kind[qa] == 1) {
                    E4(0x9E660000 | (xNA[qa] << 5) | qa);        // fmov x_q, d_vi
                } else {
                    E4(0x1E22C000 | (xNA[qa] << 5) | 16);        // fcvt d16, s_vi
                    E4(0x9E660000 | (16 << 5) | qa);             // fmov x_q, d16
                }
            } else if (xClsA[qa] == 3) {
                // 栈槽 float 4 对齐 4 推进、只定义低 4 字节(AAPCS64 NSAA):
                // ldr s16 → fcvt;double 8 对齐 8 推进: ldr d16。
                if (kind[qa] == 2) {
                    E4(0xBD400000 | (31 << 5) | (((16 + stashA + xNA[qa]) / 4) << 10) | 16);   // ldr s16, [sp, #off]
                    E4(0x1E22C210);                              // fcvt d16, s16(1E22=d←s 展宽;1E62 是反向)
                } else {
                    E4(0xFD400000 | (31 << 5) | (((16 + stashA + xNA[qa]) / 8) << 10) | 16);   // ldr d16, [sp, #off]
                }
                E4(0x9E660000 | (16 << 5) | qa);                 // fmov x_q, d16
            }
            qa = qa + 1;
        }
        BLInternal(MethSymNg(cls, m));
        if (retC != null) {
            // 批42:聚合返回尾(同 AggArm):隐返 x9 还原缓冲回拷,值返
            // 回重组 x0/x1 或 v 寄存器;标量返回转换跳过。
            if (retHid) { LdrU(9, 31, 0); AEmitAggRetHidden(retC); }
            else { AEmitAggRetPack(retC); }
        } else if (rt == "double") {
            E4(0x9E670000);                              // fmov d0, x0
        } else if (rt == "float") {
            E4(0x9E670010);                              // fmov d16, x0
            E4(0x1E624200);                              // fcvt s0, d16
        }
        if (retHid) { AddSPImm(16, true); }
        E4(0xA8C17BFD);                                  // ldp x29, x30, [sp], #16
        E4(0xD65F03C0);                                  // ret
    }

    // ---- 批41:聚合导出参数 ----
    // C 可传字段宽(0 = 不接:窄基元/嵌套 struct)。窄整在 C 侧的半
    // eightbyte 提取与 char 宽度歧义属另一形状;嵌套 struct 是值内联,
    // 递归布局另批。引用(string/object/数组/类)是 8 字节指针位——
    // 与整类 eightbyte 逐位同形,直收(struct_arc_lifetime 电池件定案:
    // 旧码静默直通吃的就是这个形状,诚实臂必须同权收下而非拒译)。
    int CAggFieldW(string ty) {
        if (ty == "byte" || ty == "sbyte" || ty == "bool") { return 1; }
        if (ty == "short" || ty == "ushort" || ty == "char") { return 2; }
        if (ty == "int" || ty == "uint" || ty == "float") { return 4; }
        if (ty == "long" || ty == "ulong" || ty == "double") { return 8; }
        if (ty == "string" || ty == "object" || ty.EndsWith("[]")) { return 8; }
        Cls rc = FindClass(ty);
        if (rc != null && rc.isStruct != 1) { return 8; }
        return 0;
    }

    bool AggFieldsOk(Cls c) {
        if (c.explicitLayout || (c.baseName != null && c.baseName.Length > 0) || c.poly == 1) { return false; }
        int n = AggCLeaves(c);
        int i = 0;
        while (i < n) {
            if (CAggFieldW(aggLeaves[i].ty) == 0) { return false; }
            i = i + 1;
        }
        return true;
    }

    // ---- 批44:聚合叶模型(CAggLayout 的递归化)----
    // aggLeaves = 扁平叶(批43 FlatValueFields 递归展开;合成 Fld 的
    // off = zan 载荷绝对偏移,ty = 叶类型),aggCFo/aggCFw = C 自然布局
    // 偏移/宽度,aggCSize = C 收尾字节数。垫片全部存取改按叶:入口
    // 寄存器 → staging → zan 对象按叶 off 落位;返回尾按叶从 zan 对象
    // 读出重组成 C 寄存器/缓冲。非展开 struct 叶(开放泛型等遗留槽)
    // CAggFieldW = 0 → AggFieldsOk 拒译(fail-closed 保持)。
    List<Fld> aggLeaves;
    int[] aggCFo;
    int[] aggCFw;
    int aggCSize;
    int AggCLeaves(Cls c) {
        aggLeaves = new List<Fld>();
        FlatValueFields(c, aggLeaves, 0, new List<string>());
        int n = aggLeaves.Count;
        aggCFo = new int[n];
        aggCFw = new int[n];
        int co = 0;
        int maxa = 1;
        int i = 0;
        while (i < n) {
            int w = CAggFieldW(aggLeaves[i].ty);
            if (w == 0) { w = 8; }               // 拒译路径上仍给合法布局(AggFieldsOk 已挡)
            co = (co + w - 1) / w * w;
            aggCFo[i] = co;
            aggCFw[i] = w;
            co = co + w;
            if (w > maxa) { maxa = w; }
            i = i + 1;
        }
        aggCSize = (co + maxa - 1) / maxa * maxa;
        return n;
    }

    bool AggRetHidden(Cls rc) {                  // >16B 返回走 memory:C 调用方递隐藏缓冲
        AggCLeaves(rc);
        return aggCSize > 16;
    }

    // ---- 批42:聚合导出返回重组尾 ----
    // 体内调用返回堆对象指针(字段 = 8 字节槽,float 字段存双精度位
    // 型),尾把字段改写成 C 返回寄存器/隐藏缓冲。x86 ≤16B:逐 C
    // eightbyte 累进 rcx——4B int mov r10d 零宽读,4B float movsd→
    // cvtsd2ss→movd 回窄取 C 位型,8B 直搬;整类半依序落 rax/rdx,
    // 纯浮半落 xmm0/xmm1(clang 对质:Mix{double;long} = rax 整半 +
    // xmm0 浮半,与声明位置无关)。>16B:r11 = C 调用方隐藏缓冲,字
    // 段按 C 布局回拷(4B 字段精确写 4 字节——尾随 padding 只有 4B,
    // 8B 写会踩调用方缓冲),rax = 缓冲。
    void XAggRetFieldLoad(Cls rc, int fi) {      // rax=对象,叶 fi → r10
        string ft = aggLeaves[fi].ty;
        int zo = aggLeaves[fi].off;
        if (CAggFieldW(ft) == 8) {
            XopRMem(0x8B, 10, 0, zo);                        // mov r10,[rax+off]
        } else if (ft == "float") {
            // movsd xmm1,[rax+off] → cvtsd2ss(体内双精度位型回窄)→
            // movd r10d,xmm1(R|R+B=0x41;0x4D 的 W 位是 64 位 movq 形)
            X3(0xF2, 0x0F, 0x10);
            if (zo < 128) { X1(0x48); X1(zo); } else { X1(0x88); X4(zo); }
            X3(0xF2, 0x0F, 0x5A); X1(0xC9);
            X2(0x66, 0x41); X2(0x0F, 0x7E); X1(0xCA);
        } else if (CAggFieldW(ft) == 1) {
            // movzx r10d, byte [rax+zo]
            X3(0x44, 0x0F, 0xB6);
            if (zo < 128) { X1(0x50); X1(zo); } else { X1(0x90); X4(zo); }
        } else if (CAggFieldW(ft) == 2) {
            // movzx r10d, word [rax+zo]
            X3(0x44, 0x0F, 0xB7);
            if (zo < 128) { X1(0x50); X1(zo); } else { X1(0x90); X4(zo); }
        } else {
            // mov r10d,[rax+off](REX.B=0x44 零宽读;8B 载入会把体内
            // 符号扩位带进高半,or 上第二字段即污染)
            X2(0x44, 0x8B);
            if (zo < 128) { X1(0x50); X1(zo); } else { X1(0x90); X4(zo); }
        }
    }
    void XEmitAggRetPack(Cls rc) {               // rax=对象 → rax/rdx/xmm0/xmm1
        int nf = AggCLeaves(rc);
        int nceb = aggCSize > 8 ? 2 : 1;
        // 累加器 rcx(e0)/r11(e1),返回寄存器最后才写——rax 既是 e0 的
        // 整类目的地又是字段载入基址,首版在 e1 读取前就写 rax,把基址
        // 毁成字段值(e1 载入 [rax+8] 落进垃圾页)。
        bool e0sse = false;
        bool e1sse = false;
        int ic = 0;
        int sc = 0;
        int e = 0;
        while (e < nceb) {
            bool fp = false;
            bool ix = false;
            int fi = 0;
            while (fi < nf) {
                if (aggCFo[fi] / 8 == e) {
                    string ft = aggLeaves[fi].ty;
                    if (ft == "float" || ft == "double") { fp = true; }
                    else { ix = true; }
                }
                fi = fi + 1;
            }
            if (e == 0) { X3(0x48, 0x31, 0xC9); }            // xor rcx,rcx
            else { X3(0x4D, 0x31, 0xDB); }                   // xor r11,r11
            fi = 0;
            while (fi < nf) {
                if (aggCFo[fi] / 8 == e) {
                    XAggRetFieldLoad(rc, fi);
                    int shift = (aggCFo[fi] & 7) * 8;
                    if (shift != 0) {
                        X3(0x49, 0xC1, 0xE2); X1(shift);        // shl r10, imm8
                        if (e == 0) { Xop(0x09, 1, 10); }    // or rcx,r10
                        else { Xop(0x09, 11, 10); }          // or r11,r10
                    } else {
                        if (e == 0) { XMov(1, 10); }         // mov rcx,r10
                        else { XMov(11, 10); }               // mov r11,r10
                    }
                }
                fi = fi + 1;
            }
            if (fp && !ix) { if (e == 0) { e0sse = true; } else { e1sse = true; } }
            e = e + 1;
        }
        // SysV 双游标独立计数:整类 eightbyte 依序 rax/rdx,纯浮依序
        // xmm0/xmm1——与 e 的整体序号无关(Mix: e0=SSE→xmm0,
        // e1=INT→rax;首版按 e 位置硬编码,e1 落了 rdx)
        e = 0;
        while (e < nceb) {
            bool sse = e == 0 ? e0sse : e1sse;
            if (sse) {
                // movq xmm_sc, (rcx|r11)(6E = GPR→xmm;7E 反向毁源;r11 源
                // 要 REX.B=1 但 REX.R 必须为 0——首版 0x4C 把 R 也置位,
                // 目的地落成 xmm8/xmm9,e1 半从未进 xmm0/xmm1)
                if (sc == 0) {
                    if (e == 0) { X2(0x66, 0x48); X2(0x0F, 0x6E); X1(0xC1); }
                    else { X2(0x66, 0x49); X2(0x0F, 0x6E); X1(0xC3); }
                } else {
                    if (e == 0) { X2(0x66, 0x48); X2(0x0F, 0x6E); X1(0xC9); }
                    else { X2(0x66, 0x49); X2(0x0F, 0x6E); X1(0xCB); }
                }
                sc = sc + 1;
            } else {
                if (ic == 0) {
                    if (e == 0) { XMov(0, 1); }              // mov rax,rcx
                    else { XMov(0, 11); }                    // mov rax,r11
                } else {
                    if (e == 0) { XMov(2, 1); }              // mov rdx,rcx
                    else { XMov(2, 11); }                    // mov rdx,r11
                }
                ic = ic + 1;
            }
            e = e + 1;
        }
    }
    void XEmitAggRetHidden(Cls rc) {             // r11=缓冲, rax=对象 → 回拷 + rax=缓冲
        int nf = AggCLeaves(rc);
        int fi = 0;
        while (fi < nf) {
            XAggRetFieldLoad(rc, fi);
            // mov [r11+off], r10 / mov dword [r11+off], r10d / mov word / mov byte
            if (CAggFieldW(aggLeaves[fi].ty) == 8) {
                X2(0x4D, 0x89);
                if (aggCFo[fi] < 128) { X1(0x53); X1(aggCFo[fi]); } else { X1(0x93); X4(aggCFo[fi]); }
            } else if (CAggFieldW(aggLeaves[fi].ty) == 1) {
                X2(0x41, 0x88);
                if (aggCFo[fi] < 128) { X1(0x53); X1(aggCFo[fi]); } else { X1(0x93); X4(aggCFo[fi]); }
            } else if (CAggFieldW(aggLeaves[fi].ty) == 2) {
                X1(0x66); X2(0x41, 0x89);
                if (aggCFo[fi] < 128) { X1(0x53); X1(aggCFo[fi]); } else { X1(0x93); X4(aggCFo[fi]); }
            } else {
                X2(0x45, 0x89);
                if (aggCFo[fi] < 128) { X1(0x53); X1(aggCFo[fi]); } else { X1(0x93); X4(aggCFo[fi]); }
            }
            fi = fi + 1;
        }
        XMov(0, 11);                                             // mov rax,r11
    }
    // arm64 ≤16B:HFA(同型 float×n/double×n,n≤4)成员逐个落 v 寄存器
    // (体内 double 位型 fcvt 回窄成 s;double 直 ldr d_i);非 HFA 位包
    // x0/x1——4B int ldr w 零宽,4B float fmov w,s(1E26 = V→GPR;
    // 27 是反向)落位,高半 orr lsl #32(0xAA000000|Rm<<16|imm6<<10|
    // Rn<<5|Rd,clang -O2 对质),8B 直 ldr x_e。>16B:x9 = C 隐藏缓冲,
    // 字段按 C 布局回拷(4B 精确 4 字节),x0 = 缓冲。
    void AAggRetFieldLoad(Cls rc, int fi) {      // x0=对象,叶 fi → x10/w10
        string ft = aggLeaves[fi].ty;
        int zo = aggLeaves[fi].off;
        if (CAggFieldW(ft) == 8) { LdrU(10, 0, zo); }
        else if (ft == "float") {
            // ldr d16 是 SIMD 形,LdrU 只发 GPR 形(首版 rt=16 落成
            // ldr x16,fcvt 读的是陈旧 d16——MakeFp 4.5=2.25+2.25 现形)
            E4(0xFD400000 | ((zo / 8) << 10) | 16);              // ldr d16,[x0,#zo]
            E4(0x1E624210);                                      // fcvt s16,d16
            E4(0x1E260000 | (16 << 5) | 10);                     // fmov w10,s16
        } else if (CAggFieldW(ft) == 1) {
            E4(0x39400000 | (zo << 10) | 10);                   // ldrb w10, [x0, #zo]
        } else if (CAggFieldW(ft) == 2) {
            E4(0x79400000 | ((zo / 2) << 10) | 10);             // ldrh w10, [x0, #zo]
        } else {
            E4(0xB9400000 | ((zo / 4) << 10) | 10);              // ldr w10,[x0,#zo]
        }
    }
    void AEmitAggRetPack(Cls rc) {               // x0=对象 → x0/x1 或 v0..v3
        int nf = AggCLeaves(rc);
        bool hfaF = nf > 0;
        bool hfaD = nf > 0;
        int fi = 0;
        while (fi < nf) {
            if (aggCFw[fi] != 4 || aggLeaves[fi].ty != "float") { hfaF = false; }
            if (aggCFw[fi] != 8 || aggLeaves[fi].ty != "double") { hfaD = false; }
            fi = fi + 1;
        }
        if ((hfaF || hfaD) && nf <= 4 && aggCSize <= 16) {
            fi = 0;
            while (fi < nf) {
                int zo = aggLeaves[fi].off;
                if (hfaF) {
                    E4(0xFD400000 | ((zo / 8) << 10) | 16);      // ldr d16,[x0,#zo]
                    E4(0x1E624000 | (16 << 5) | fi);             // fcvt s_fi,d16
                } else {
                    E4(0xFD400000 | ((zo / 8) << 10) | fi);      // ldr d_fi,[x0,#zo]
                }
                fi = fi + 1;
            }
            return;
        }
        // 累加器 x10(e0)/x11(e1)、高半暂存 x12,返回寄存器最后才写——
        // x0 既是 e0 的目的地又是字段载入基址,首版 ldr w0,[x0,#0] 把
        // 基址毁成字段值,后半载入直接落垃圾页(lldb 定格 addr=0x7)。
        int e = 0;
        while (e < (aggCSize > 8 ? 2 : 1)) {
            int acc = e == 0 ? 10 : 11;
            fi = 0;
            while (fi < nf) {
                if (aggCFo[fi] / 8 == e) {
                    string ft = aggLeaves[fi].ty;
                    int zo = aggLeaves[fi].off;
                    int shift = (aggCFo[fi] & 7) * 8;
                    // 对象侧一律叶绝对偏移 zo;C 偏移 aggCFo 只定半位
                    if (CAggFieldW(ft) == 8) { LdrU(acc, 0, zo); }       // ldr x_acc,[x0,#zo]
                    else if (ft == "float") {
                        E4(0xFD400000 | ((zo / 8) << 10) | 16);          // ldr d16,[x0,#zo]
                        E4(0x1E624210);                                  // fcvt s16,d16
                        if (shift == 0) { E4(0x1E260000 | (16 << 5) | acc); }     // fmov w_acc,s16
                        else {
                            E4(0x1E260000 | (16 << 5) | 12);             // fmov w12,s16
                            E4(0xAA000000 | (12 << 16) | (shift << 10) | (acc << 5) | acc);
                        }
                    } else {
                        int reg = shift == 0 ? acc : 12;
                        if (CAggFieldW(ft) == 1) {
                            E4(0x39400000 | (zo << 10) | reg);
                        } else if (CAggFieldW(ft) == 2) {
                            E4(0x79400000 | ((zo / 2) << 10) | reg);
                        } else {
                            E4(0xB9400000 | ((zo / 4) << 10) | reg);
                        }
                        if (shift > 0) {
                            E4(0xAA000000 | (12 << 16) | (shift << 10) | (acc << 5) | acc);
                        }
                    }
                }
                fi = fi + 1;
            }
            e = e + 1;
        }
        MovRR(0, 10);                                            // mov x0,x10
        if (aggCSize > 8) { MovRR(1, 11); }                      // mov x1,x11
    }
    void AEmitAggRetHidden(Cls rc) {             // x9=缓冲, x0=对象 → 回拷 + x0=缓冲
        int nf = AggCLeaves(rc);
        int fi = 0;
        while (fi < nf) {
            string ft = aggLeaves[fi].ty;
            int zo = aggLeaves[fi].off;
            if (CAggFieldW(ft) == 8) { LdrU(10, 0, zo); StrU(10, 9, aggCFo[fi]); }
            else if (ft == "float") {
                E4(0xFD400000 | ((zo / 8) << 10) | 16);          // ldr d16,[x0,#zo]
                E4(0x1E624210);
                E4(0xBD000000 | ((aggCFo[fi] / 4) << 10) | (9 << 5) | 16);   // str s16,[x9,#off]
            } else if (CAggFieldW(ft) == 1) {
                E4(0x39400000 | (zo << 10) | 10);
                E4(0x39000000 | (aggCFo[fi] << 10) | (9 << 5) | 10);
            } else if (CAggFieldW(ft) == 2) {
                E4(0x79400000 | ((zo / 2) << 10) | 10);
                E4(0x79000000 | ((aggCFo[fi] / 2) << 10) | (9 << 5) | 10);
            } else {
                E4(0xB9400000 | ((zo / 4) << 10) | 10);                      // ldr w10,[x0,#zo]
                E4(0xB9000000 | ((aggCFo[fi] / 4) << 10) | (9 << 5) | 10);   // str w10,[x9,#off]
            }
            fi = fi + 1;
        }
        MovRR(0, 9);                                             // mov x0,x9
    }

    // 批41:x86 聚合参数导出臂。SysV 按参数序做 eightbyte 独立分类
    // (混类 eightbyte = INTEGER——t4/S4 探针:rdi 高半抱 float 位型;
    // 纯浮 eightbyte = SSE;>16B 整体 MEMORY 落栈,r+ 不消耗)。三段:
    // ①全部入口位型(标量+聚合 eightbyte,浮点成员展宽 double)装进
    // 本臂栈 staging;②逐聚合 _zan_rt_alloc(size+16)+desc 戳+字段
    // 落位(与 `new` 同款:alloc 已零,不需要 ctor),对象指针回存
    // staging(alloc 毁 caller-saved,home 落位必须最后);③统一落
    // decl 家(k<6 GPR / k≥6 栈槽),裸 E8 调 __body。
    // 批42:聚合返回并入同臂——值返回重组 rax/rdx/xmm0/xmm1;>16B
    // 隐返 C 缓冲递在 rdi,整参源寄存器右移一位(g86 从 1 起),栈参
    // 不动,缓冲先进 staging(MakeBig2/BumpBig clang 对质定案)。
    void EmitX86ExportAggArm(string cls, Node m, int[] kind, int np, string rt, List<Cls> agList, int[] agIdx, Cls retC, string[] pts) {
        bool retHid = retC != null && AggRetHidden(retC);
        int g86 = retHid ? 1 : 0;
        int xx86 = 0;
        int sb86 = 0;
        int[] sCls = new int[np];
        int[] sN = new int[np];
        int[] e0C = new int[np];
        int[] e0N = new int[np];
        int[] e1C = new int[np];
        int[] e1N = new int[np];
        int[] slot = new int[np];
        int units = 0;
        int q86 = 0;
        while (q86 < np) {
            if (agIdx[q86] >= 0) {
                Cls ac = agList[agIdx[q86]];
                int nf = AggCLeaves(ac);
                if (aggCSize > 16) {
                    sCls[q86] = 5; sN[q86] = sb86; sb86 = sb86 + (aggCSize + 7) / 8 * 8;
                    e0C[q86] = 5; e0N[q86] = sN[q86];
                } else {
                    int nceb = aggCSize > 8 ? 2 : 1;
                    int e = 0;
                    while (e < nceb) {
                        bool fp = false;
                        bool ix = false;
                        int fi = 0;
                        while (fi < nf) {
                            if (aggCFo[fi] / 8 == e) {
                                string ft = aggLeaves[fi].ty;
                                if (ft == "float" || ft == "double") { fp = true; }
                                else { ix = true; }
                            }
                            fi = fi + 1;
                        }
                        // SysV 类合并:纯浮 = SSE,否则 INTEGER(混类含整即整)
                        int ec = fp && !ix ? 1 : 0;
                        int en = 0;
                        if (ec == 0) {
                            if (g86 < 6) { en = g86; g86 = g86 + 1; }
                            else { ec = 2; en = sb86; sb86 = sb86 + 8; }
                        } else {
                            if (xx86 < 8) { en = xx86; xx86 = xx86 + 1; }
                            else { ec = 2; en = sb86; sb86 = sb86 + 8; }
                        }
                        if (e == 0) { e0C[q86] = ec; e0N[q86] = en; }
                        else { e1C[q86] = ec; e1N[q86] = en; }
                        fi = 0;
                        e = e + 1;
                    }
                    sCls[q86] = 0; sN[q86] = 0;
                }
                slot[q86] = units; units = units + nf + 1;
            } else {
                if (kind[q86] != 0) {
                    if (xx86 < 8) { sCls[q86] = 1; sN[q86] = xx86; xx86 = xx86 + 1; }
                    else if (kind[q86] == 2) { sCls[q86] = 3; sN[q86] = sb86; sb86 = sb86 + 8; }
                    else { sCls[q86] = 4; sN[q86] = sb86; sb86 = sb86 + 8; }
                } else {
                    if (g86 < 6) { sCls[q86] = 0; sN[q86] = g86; g86 = g86 + 1; }
                    else { sCls[q86] = 2; sN[q86] = sb86; sb86 = sb86 + 8; }
                }
                slot[q86] = units; units = units + 1;
            }
            q86 = q86 + 1;
        }
        int retSlot86 = -1;
        if (retHid) { retSlot86 = units; units = units + 1; }
        int area86 = units > 0 ? 16 * ((units + 1) / 2) : 0;
        X1(0x55);                                    // push rbp
        X3(0x48, 0x89, 0xE5);                        // mov rbp, rsp
        XSubRsp(area86);
        if (retHid) { XopMemR(0x89, 7, 4, 8 * retSlot86); }      // mov [rsp+8retSlot],rdi(C 隐返缓冲,permute 前抢存)
        q86 = 0;
        while (q86 < np) {                           // ① 入口位型 → staging
            if (agIdx[q86] >= 0) {
                Cls ac = agList[agIdx[q86]];
                int nf = AggCLeaves(ac);
                int fi = 0;
                while (fi < nf) {
                    // MEMORY(>16B)整体落栈且 e0/e1 只记第 0 个
                    // eightbyte——e≥2 的字段直取 [rbp+16+sN+8B 基];首版
                    // 落进 e1C 的默认整类,把字段 1/2 读成 %rdi
                    int ec;
                    int en;
                    if (sCls[q86] == 5) {
                        ec = 2;
                        en = sN[q86] + (aggCFo[fi] & ~7);
                    } else {
                        int e = aggCFo[fi] / 8;
                        ec = e == 0 ? e0C[q86] : e1C[q86];
                        en = e == 0 ? e0N[q86] : e1N[q86];
                    }
                    if (ec == 0) { XMovGG(10, XMapReal(en)); }
                    else if (ec == 1) { X2(0x66, 0x49); X2(0x0F, 0x7E); X1(0xC0 | (en << 3) | 2); }   // movq r10, xmm_en
                    else { XopRMem(0x8B, 10, 5, 16 + en); }
                    if ((aggCFo[fi] & 7) != 0) { X3(0x49, 0xC1, 0xEA); X1(32); }   // shr r10, 32(REX 0x49:B 位——0x48 解码成 shr %rdx)
                    string ft = aggLeaves[fi].ty;
                    if (ft == "int") { X3(0x4D, 0x63, 0xD2); }                 // movsxd r10, r10d
                    else if (ft == "float") {
                        // movd xmm15, r10d(R|R+B=0x45)→ cvtss2sd xmm15,
                        // xmm15(R=1→0x45;首版 0x44 落 xmm7)→ movq r10,
                        // xmm15(W+R+B=0x4D;首版 0x49 读成 xmm7)
                        X3(0x66, 0x45, 0x0F); X1(0x6E); X1(0xFA);
                        X3(0xF3, 0x45, 0x0F); X1(0x5A); X1(0xFF);
                        X3(0x66, 0x4D, 0x0F); X1(0x7E); X1(0xFA);
                    }
                    XopMemR(0x89, 10, 4, 8 * (slot[q86] + fi));
                    fi = fi + 1;
                }
            } else if (kind[q86] == 0) {
                // 批45:整参规范化(见 ShimWidenOf)——寄存器/栈源都按
                // 类型展宽;栈 4 字节槽高半是阴影垃圾,8 字节直读必毒。
                int w45 = ShimWidenOf(pts[q86]);
                if (sCls[q86] == 0) {
                    if (w45 == 1) { Xmovsxd(10, XMapReal(sN[q86])); }
                    else if (w45 == 2) { Xmov32(10, XMapReal(sN[q86])); }
                    else { XMovGG(10, XMapReal(sN[q86])); }
                } else {
                    int d45 = 16 + sN[q86];
                    if (w45 == 1) {
                        if (d45 < 128 && d45 > -128) { X3(0x4C, 0x63, 0x55); X1(d45); }
                        else { X3(0x4C, 0x63, 0x95); X4(d45); }   // movsxd r10,[rbp+d]
                    } else if (w45 == 2) {
                        if (d45 < 128 && d45 > -128) { X3(0x44, 0x8B, 0x55); X1(d45); }
                        else { X3(0x44, 0x8B, 0x95); X4(d45); }   // mov r10d,[rbp+d]
                    } else { XopRMem(0x8B, 10, 5, d45); }
                }
                XopMemR(0x89, 10, 4, 8 * slot[q86]);
            } else if (kind[q86] == 1) {
                if (sCls[q86] == 1) { X2(0x66, 0x49); X2(0x0F, 0x7E); X1(0xC0 | (sN[q86] << 3) | 2); }
                else { XopRMem(0x8B, 10, 5, 16 + sN[q86]); }
                XopMemR(0x89, 10, 4, 8 * slot[q86]);
            } else {
                if (sCls[q86] == 1) {
                    X3(0xF3, 0x0F, 0x5A); X1(0xC0 | (sN[q86] << 3) | sN[q86]);   // cvtss2sd 原位
                    X2(0x66, 0x49); X2(0x0F, 0x7E); X1(0xC0 | (sN[q86] << 3) | 2);
                } else {
                    X3(0xF3, 0x44, 0x0F); X1(0x10);                    // movss xmm15, [rbp+16+off]
                    int d86 = 16 + sN[q86];
                    if (d86 < 128 && d86 > -128) { X1(0x7D); X1(d86); } else { X1(0x9D); X4(d86); }
                    X3(0xF3, 0x45, 0x0F); X1(0x5A); X1(0xFF);
                    X2(0x66, 0x4D); X2(0x0F, 0x7E); X1(0xFA);
                }
                XopMemR(0x89, 10, 4, 8 * slot[q86]);
            }
            q86 = q86 + 1;
        }
        q86 = 0;
        while (q86 < np) {                           // ② 物化 zan 对象
            if (agIdx[q86] >= 0) {
                Cls ac = agList[agIdx[q86]];
                int nf = AggCLeaves(ac);
                LoadImm(0, ac.size + 16);
                LoadImm(1, 0);
                BLInternal("_zan_rt_alloc");
                RtLdur(1, 0, -8);
                XLoadImm(2, (long)ac.site << 32);
                Xop(0x09, 6, 2);                         // or rsi, rdx
                RtStur(1, 0, -8);
                int fi = 0;
                while (fi < nf) {
                    XopRMem(0x8B, 10, 4, 8 * (slot[q86] + fi));
                    XopMemR(0x89, 10, 0, aggLeaves[fi].off);
                    fi = fi + 1;
                }
                XMov(10, 0);
                XopMemR(0x89, 10, 4, 8 * (slot[q86] + nf));
            }
            q86 = q86 + 1;
        }
        // ③ 统一落 decl 家:寄存器家升序先读——np>6 时栈参家就写在
        // [rsp+0..],正是 staging 头几个槽;首版降序先写栈家,把参数 0
        // 的 obj 槽覆写掉,rdi 读回 s9(体内当指针解必炸)
        int k86 = 0;
        while (k86 < np && k86 < 6) {
            int sb2 = agIdx[k86] >= 0 ? AggCLeaves(agList[agIdx[k86]]) : 0;
            XopRMem(0x8B, 10, 4, 8 * (slot[k86] + sb2));
            XMovGG(XMapReal(k86), 10);
            k86 = k86 + 1;
        }
        while (k86 < np) {
            int sb2 = agIdx[k86] >= 0 ? AggCLeaves(agList[agIdx[k86]]) : 0;
            XopRMem(0x8B, 10, 4, 8 * (slot[k86] + sb2));
            XopMemR(0x89, 10, 4, 8 * (k86 - 6));
            k86 = k86 + 1;
        }
        X1(0xE8);                                    // call __body(裸调用)
        fixups.Add(new Fixup(txt.Count - 1, 3, 0, 0, MethSymNg(cls, m)));
        X4(0);
        if (retC != null) {
            // 批42:聚合返回尾。隐返缓冲先出 staging(XAddRsp 撤销 sp 基)
            // 再回拷字段;值返回重组进 C 返回寄存器。标量返回转换不再适用。
            if (retHid) { XopRMem(0x8B, 11, 4, 8 * retSlot86); } // mov r11,[rsp+8retSlot]
            XAddRsp(area86);
            if (retHid) { XEmitAggRetHidden(retC); }
            else { XEmitAggRetPack(retC); }
            X1(0xC9); X1(0xC3);                          // leave; ret(裸,XEpilogue 的 mov rax,rdi 会毁结果)
            return;
        }
        XAddRsp(area86);
        XMov(7, 0);                                  // mov rdi, rax
        if (rt == "double") {
            X3(0x66, 0x48, 0x0F); X2(0x6E, 0xC7);    // movq xmm0, rdi
        } else if (rt == "float") {
            X3(0x66, 0x48, 0x0F); X2(0x6E, 0xCF);    // movq xmm1, rdi
            X3(0xF2, 0x0F, 0x5A); X1(0xC1);          // cvtsd2ss xmm0, xmm1
        }
        XEpilogue();
    }

    // 批41:arm64 聚合参数导出臂。Apple AAPCS64 变体(clang 探针定案):
    // HFA(同型 float×n / double×n,n≤4)逐员落 v 寄存器(fcvt 展宽);
    // 其余 ≤16B 按 8 字节半**全走 x 寄存器位包**——double 半的位型也在
    // x(t3 探针 fmov d0,x0 对质,非标准 AAPCS64 的 v 寄存器分派);
    // >16B 复制体地址走 x 寄存器(t5 ldp [x0])。装不下整体落栈。三段
    // 同 x86 臂:staging 先行 → alloc+desc 戳+落位 → 统一 LdrU 落 decl 家。
    // 批42:聚合返回并入同臂——≤16B 值返回 HFA 逐员落 v / 非 HFA 位包
    // x0/x1;>16B 隐返 C 缓冲递在 x8(独立寄存器,不占 x0-x7 槽,传参
    // 寄存器不移位)。x8 非 callee-saved,先进 staging 暂存。
    void EmitArm64ExportAggArm(string cls, Node m, int[] kind, int np, string rt, List<Cls> agList, int[] agIdx, Cls retC, string[] pts) {
        bool retHid = retC != null && AggRetHidden(retC);
        int xa86 = 0;
        int va86 = 0;
        int ja86 = 0;
        int[] xClsA = new int[np];                   // 0 x半位包 / 1 HFA v / 2 栈 / 3 栈浮点 / 5 MEM指针
        int[] xNA = new int[np];
        int[] slot = new int[np];
        int units = 0;
        int q86 = 0;
        while (q86 < np) {
            if (agIdx[q86] >= 0) {
                Cls ac = agList[agIdx[q86]];
                int nf = AggCLeaves(ac);
                bool hfaF = nf > 0;
                bool hfaD = nf > 0;
                int fi = 0;
                while (fi < nf) {
                    if (aggCFw[fi] != 4 || aggLeaves[fi].ty != "float") { hfaF = false; }
                    if (aggCFw[fi] != 8 || aggLeaves[fi].ty != "double") { hfaD = false; }
                    fi = fi + 1;
                }
                bool hfa = (hfaF || hfaD) && nf <= 4 && aggCSize <= 16;
                if (hfa) {
                    int w86 = hfaF ? 4 : 8;
                    if (va86 + nf <= 8) { xClsA[q86] = 1; xNA[q86] = va86; va86 = va86 + nf; }
                    else {
                        // NSAA 模型:栈偏移一律字节计,落位按自然对齐(float
                        // HFA 4、double HFA 8 —— 探针定案:窄参后 float HFA
                        // 落 +4 紧排)、推进按 nf*w86。首版标量按"槽"加 1、
                        // 聚合按字节加,混排栈参必然错位
                        int sa = (ja86 + 7) & ~7;
                        if (w86 == 4) { sa = (ja86 + 3) & ~3; }
                        xClsA[q86] = 2; xNA[q86] = sa; ja86 = sa + nf * w86;
                    }
                } else if (aggCSize > 16) {
                    if (xa86 < 8) { xClsA[q86] = 5; xNA[q86] = xa86; xa86 = xa86 + 1; }
                    else { int sa = (ja86 + 7) & ~7; xClsA[q86] = 2; xNA[q86] = sa; ja86 = sa + 8; }
                } else {
                    int nh = aggCSize > 8 ? 2 : 1;
                    if (xa86 + nh <= 8) { xClsA[q86] = 0; xNA[q86] = xa86; xa86 = xa86 + nh; }
                    else {
                        // 批50:NSAA:落位按复合自然对齐(含 8 宽叶 → 8,全
                        // 窄叶 → 4),推进 = 尺寸舍到 8(探针:12B 结构落
                        // +0、推进 16,尾随窄参在 +16)。首版 8*nh 对全窄叶
                        // 复合(如 12B 全 int)过对齐,窄参后必错位
                        int ca = 4;
                        int ci = 0;
                        while (ci < nf) { if (aggCFw[ci] == 8) { ca = 8; } ci = ci + 1; }
                        int sa = (ja86 + 7) & ~7;
                        if (ca == 4) { sa = (ja86 + 3) & ~3; }
                        xClsA[q86] = 2; xNA[q86] = sa; ja86 = sa + ((aggCSize + 7) & ~7);
                    }
                }
                slot[q86] = units; units = units + nf + 1;
            } else {
                if (kind[q86] != 0) {
                    if (va86 < 8) { xClsA[q86] = 1; xNA[q86] = va86; va86 = va86 + 1; }
                    else if (kind[q86] == 2) { int sa = (ja86 + 3) & ~3; xClsA[q86] = 3; xNA[q86] = sa; ja86 = sa + 4; }
                    else { int sa = (ja86 + 7) & ~7; xClsA[q86] = 3; xNA[q86] = sa; ja86 = sa + 8; }
                } else {
                    if (xa86 < 8) { xClsA[q86] = 0; xNA[q86] = xa86; xa86 = xa86 + 1; }
                    else {
                        // 批50:同 GeneralArm —— 栈参 NSAA 字节模型(窄整/
                        // float 4 对齐 4 推进,8 字节类 8 对齐 8 推进),非
                        // 序数×8
                        int w = CStackW(pts[q86]);
                        int sa = (ja86 + 7) & ~7;
                        if (w != 8) { sa = (ja86 + 3) & ~3; }
                        xClsA[q86] = 2; xNA[q86] = sa; ja86 = sa + w;
                    }
                }
                slot[q86] = units; units = units + 1;
            }
            q86 = q86 + 1;
        }
        int retSlotA = -1;
        if (retHid) { retSlotA = units; units = units + 1; }
        int areaA = units > 0 ? 16 * ((units + 1) / 2) : 0;
        E4(0xA9BF7BFD);                              // stp x29, x30, [sp, #-16]!
        E4(0x910003FD);                              // mov x29, sp —— 栈参基址(entry-16)
        if (areaA != 0) { AddSPImm(areaA, false); }
        if (retHid) { StrU(8, 31, 8 * retSlotA); }   // str x8,[sp,#8retSlot](C 隐返缓冲)
        q86 = 0;
        while (q86 < np) {                           // ① 入口位型 → staging
            if (agIdx[q86] >= 0) {
                Cls ac = agList[agIdx[q86]];
                int nf = AggCLeaves(ac);
                int fi = 0;
                int mi = 0;
                if (xClsA[q86] == 5) {
                    // MEMORY:指针只 stage 一次到对象槽(pass ② 同位读回,
                    // 用完即被 obj 指针覆写);字段本身不过 staging
                    MovRR(10, xNA[q86]);
                    StrU(10, 31, 8 * (slot[q86] + nf));
                    fi = nf;
                }
                while (fi < nf) {
                    int e = aggCFo[fi] / 8;
                    string ft = aggLeaves[fi].ty;
                    if (xClsA[q86] == 0) {
                        int xe = xNA[q86] + e;
                        if (aggCFw[fi] == 8) { MovRR(10, xe); }
                        else {
                            // 半在寄存器里:低位 mov w10, wxe(零扩);高位
                            // lsr x10, xxe, #32(immr=32=100000→D360FC00;
                            // 首版 D342FC00 的 immr=2,把位型移成垃圾)——
                            // 位包半绝不能当内存地址
                            if ((aggCFo[fi] & 7) == 0) { E4(0x2A0003E0 | (xe << 16) | 10); }   // mov w10, wxe
                            else { E4(0xD360FC00 | (xe << 5) | 10); }                      // lsr x10, xe, #32
                            if (ft == "int") { E4(0x93407D4A); }          // sxtw x10, w10
                            else if (ft == "float") {
                                E4(0x1E270000 | (10 << 5) | 16);          // fmov s16, w10
                                E4(0x1E22C210);                           // fcvt d16, s16
                                E4(0x9E660000 | (16 << 5) | 10);          // fmov x10, d16
                            }
                        }
                    } else if (xClsA[q86] == 1) {
                        int vr = xNA[q86] + mi;
                        if (ft == "float") {
                            E4(0x1E22C000 | (vr << 5) | 16);              // fcvt d16, s_vi
                            E4(0x9E660000 | (16 << 5) | 10);
                        } else {
                            E4(0x9E660000 | (vr << 5) | 10);              // fmov x10, d_vi
                        }
                        mi = mi + 1;
                    } else if (xClsA[q86] == 5) {
                        MovRR(10, xNA[q86]);                              // 复制体地址
                    } else {
                        // 栈上聚合:基址 x29(=entry-16,sp 已被 staging
                        // 区压低;首版用 sp 基读进的是自己 staging 的垃圾)
                        int so86 = 16 + xNA[q86] + aggCFo[fi];
                        if (aggCFw[fi] == 8) { LdrU(10, 29, so86); }
                        else {
                            E4(0xB9400000 | ((so86 / 4) << 10) | (29 << 5) | 10);   // ldr w10, [x29, #off]
                            if (ft == "int") { E4(0x93407D4A); }   // sxtw x10, w10
                            else if (ft == "float") {
                                E4(0xBD400000 | (29 << 5) | ((so86 / 4) << 10) | 16);   // ldr s16, [x29, #off]
                                E4(0x1E22C210);
                                E4(0x9E660000 | (16 << 5) | 10);
                            }
                        }
                    }
                    StrU(10, 31, 8 * (slot[q86] + fi));
                    fi = fi + 1;
                }
            } else if (kind[q86] == 0) {
                // 批45:整参规范化(见 ShimWidenOf)——栈 4 字节槽高半
                // 是阴影垃圾,8 字节直读必毒;寄存器 32 位写硬件零扩。
                int w45 = ShimWidenOf(pts[q86]);
                if (xClsA[q86] == 0) {
                    if (w45 == 1) { E4(0x93407C00 | (xNA[q86] << 5) | 10); }      // sxtw x10, w_src
                    else if (w45 == 2) { E4(0x2A0003E0 | (xNA[q86] << 16) | 10); }
                    else { MovRR(10, xNA[q86]); }
                } else {
                    int o45 = 16 + xNA[q86];
                    if (w45 == 1) { E4(0xB9800000 | ((o45 / 4) << 10) | (29 << 5) | 10); }        // ldrsw x10,[x29,#o]
                    else if (w45 == 2) { E4(0xB9400000 | ((o45 / 4) << 10) | (29 << 5) | 10); }   // ldr w10(零扩)
                    else { LdrU(10, 29, o45); }               // x29 基,xNA 字节偏移
                }
                StrU(10, 31, 8 * slot[q86]);
            } else if (kind[q86] == 1) {
                if (xClsA[q86] == 1) { E4(0x9E660000 | (xNA[q86] << 5) | 10); }
                else {
                    E4(0xFD400000 | (29 << 5) | (((16 + xNA[q86]) / 8) << 10) | 16);   // ldr d16, [x29, #off](double 8 对齐 8 推进)
                    E4(0x9E660000 | (16 << 5) | 10);
                }
                StrU(10, 31, 8 * slot[q86]);
            } else {
                if (xClsA[q86] == 1) {
                    E4(0x1E22C000 | (xNA[q86] << 5) | 16);
                    E4(0x9E660000 | (16 << 5) | 10);
                } else {
                    E4(0xBD400000 | (29 << 5) | (((16 + xNA[q86]) / 4) << 10) | 16);   // ldr s16, [x29, #off]
                    E4(0x1E22C210);
                    E4(0x9E660000 | (16 << 5) | 10);
                }
                StrU(10, 31, 8 * slot[q86]);
            }
            q86 = q86 + 1;
        }
        q86 = 0;
        while (q86 < np) {                           // ② 物化 zan 对象
            if (agIdx[q86] >= 0) {
                Cls ac = agList[agIdx[q86]];
                int nf = AggCLeaves(ac);
                if (xClsA[q86] == 5) {
                    // MEMORY:经 staging 的复制体地址逐叶搬
                    LoadImm(0, ac.size + 16);
                    LoadImm(1, 0);
                    BLInternal("_zan_rt_alloc");
                    RtLdur(1, 0, -8);
                    E4(0xD2C00000 | (ac.site << 5) | 2);          // movz x2, #site, lsl #16
                    E4(0xAA020021);                               // orr x1, x1, x2
                    RtStur(1, 0, -8);
                    // 指针在 alloc 之后才取:x9 是临时寄存器,_zan_rt_alloc
                    // 不保证保留(首版先 ldr 后 bl,x9 被覆写成 0x103,ldr
                    // [x9] 必炸——lldb 帧定格在这一条上)
                    LdrU(9, 31, 8 * (slot[q86] + nf));
                    int fi = 0;
                    while (fi < nf) {
                        if (aggCFw[fi] == 8) { LdrU(10, 9, aggCFo[fi]); }
                        else {
                            E4(0xB9400000 | ((aggCFo[fi] / 4) << 10) | (9 << 5) | 10);   // ldr w10, [x9, #co]
                            if (aggLeaves[fi].ty == "int") { E4(0x93407D4A); }   // sxtw x10, w10
                            else if (aggLeaves[fi].ty == "float") {
                                E4(0x1E270000 | (10 << 5) | 16);
                                E4(0x1E22C210);
                                E4(0x9E660000 | (16 << 5) | 10);
                            }
                        }
                        StrU(10, 0, aggLeaves[fi].off);
                        fi = fi + 1;
                    }
                } else {
                    LoadImm(0, ac.size + 16);
                    LoadImm(1, 0);
                    BLInternal("_zan_rt_alloc");
                    RtLdur(1, 0, -8);
                    E4(0xD2C00000 | (ac.site << 5) | 2);
                    E4(0xAA020021);
                    RtStur(1, 0, -8);
                    int fi = 0;
                    while (fi < nf) {
                        LdrU(10, 31, 8 * (slot[q86] + fi));
                        StrU(10, 0, aggLeaves[fi].off);
                        fi = fi + 1;
                    }
                }
                MovRR(10, 0);
                StrU(10, 31, 8 * (slot[q86] + nf));
            }
            q86 = q86 + 1;
        }
        q86 = 0;
        while (q86 < np) {                           // ③ 统一落 decl 家
            int sb2 = agIdx[q86] >= 0 ? AggCLeaves(agList[agIdx[q86]]) : 0;
            LdrU(q86, 31, 8 * (slot[q86] + sb2));
            q86 = q86 + 1;
        }
        BLInternal(MethSymNg(cls, m));
        if (retC != null) {
            // 批42:聚合返回尾。隐返:先从 staging 还原缓冲(x9)再回拷;
            // 值返回:HFA 逐员落 v / 非 HFA 位包 x0/x1。
            if (retHid) { LdrU(9, 31, 8 * retSlotA); AEmitAggRetHidden(retC); }
            else { AEmitAggRetPack(retC); }
        } else if (rt == "double") {
            E4(0x9E670000);                          // fmov d0, x0
        } else if (rt == "float") {
            E4(0x9E670010);                          // fmov d16, x0
            E4(0x1E624200);                          // fcvt s0, d16
        }
        if (areaA != 0) { AddSPImm(areaA, true); }
        E4(0xA8C17BFD);                              // ldp x29, x30, [sp], #16
        E4(0xD65F03C0);                              // ret
    }

    // 缺口四: C-ABI export shim in front of a method body. AAPCS64 hands
    // float/double arguments over in v0-v7 and reads the result back from
    // s0/d0; the internal value model carries every scalar as its bit
    // pattern in x0-x7 and returns bits in x0. The shim permutes incoming
    // registers, calls the body, and converts the result back. x86 lane
    // (批36/39):np≤6 走 SSE 简易臂,np>6 或 np>8 带浮点走通用 staging
    // 臂(EmitX86ExportGeneralArm);纯整超定签名走恒等形。arm64(批39
    // 诚实化):np≤8 走 fmov/fcvt 垫片,np>8 / 聚合 fail-closed——旧
    // 直通分支对浮点与纯整都是静默错(探针定案),退役。Leaf code: no frame.
    void EmitExportShimNg(string cls, Node m, bool inst) {
        string rt = m.type != null ? TypeFullName(m.type) : "void";
        if (rt == null || rt.Length == 0) { rt = "void"; }
        int npc = 0;
        int i = 0;
        while (i < m.kids.Count) {
            if (m.kids[i].kind == AK.Param()) { npc = npc + 1; }
            i = i + 1;
        }
        int np = npc + (inst ? 1 : 0);
        // 批50:arm64 导出信封 = 参数寄存器 x0..x15。x16/x17 是代码生成
        // 永不分派的专用 scratch(体序幕 StoreLocal 远偏移寻址即用它),
        // x18 平台保留 —— 首版垫片把 np 个参数全量 stage 进
        // x0..x_{np-1},np≥17 时第 17 个参数住在 x16,进体即被寻址暂存
        // 踩掉(DeepMix18 探针:参数 16 读成暂存地址位型,和值碎)。
        // >16 参数需"寄存器 + 栈溢出家"约定,另批;x86 泼溅栈家无此限
        // (11 参探针绿)。
        if (tgt86 != 1 && np > 16) {
            diags.Error("ngen: an export with more than 16 parameters (incl. this) is fail-closed on arm64 (x16/x17 are call scratch, x18 platform-reserved; the stack-overflow convention is a later batch)", m.line, m.col);
            return;
        }
        // kind per internal slot: 0 integer-like (or this / array ptr),
        // 1 double, 2 float —— 批39 起无条件填表:!ok 侧的 x86 通用臂
        // (np>8 浮点/双参、纯整 7/8+ 参)必须读到全表——ok 在 np>8 时
        // 直接为假,惰性填表会留全零(浮点被当整类 staging,必错)。
        int[] kind = new int[np];
        // 批45:参型表(与 kind 同序;this 槽保持 "long" = 64 位直收)。
        // 四个排列臂 + OK 路径的整参规范化按它选展宽形。
        string[] pts = new string[np];
        i = 0;
        while (i < np) { pts[i] = "long"; i = i + 1; }
        // 批41:聚合参数探测(isStruct==1 且普通布局)。聚合走专用
        // AggArm;引用/数组/Span 形状保持既有面。
        List<Cls> agList = new List<Cls>();
        int[] agIdx = new int[np];
        i = 0;
        while (i < np) { agIdx[i] = -1; i = i + 1; }
        i = 0;
        int slot = inst ? 1 : 0;
        while (i < m.kids.Count) {
            Node p = m.kids[i];
            if (p.kind == AK.Param()) {
                string pt = TypeFullName(p.type);
                if (pt == "double") { kind[slot] = 1; }
                else if (pt == "float") { kind[slot] = 2; }
                if (pt != null && pt.Length > 0) { pts[slot] = pt; }
                Cls ac = FindClass(pt);
                // 批47:闭实例泛型 struct("Pair<int,long>")解析成替换
                // 视图再进聚合校验 —— 擦除落到的开模板叶是 "T1/T2",
                // CAggFieldW=0 会把可导出的形状误拒;视图给回替换叶
                // (int/long=4/8)。批49:按需建视图(struct 实参形状
                // 现在可批);递归/基类/虚形状仍落开模板 → 恒拒。
                if (ac != null && ac.tps.Count > 0 && pt != null && pt.IndexOf("<") > 0) {
                    Cls vc = StructInstViewOf(pt);
                    if (vc != null) { ac = vc; }
                }
                // 批44:全部 struct 形状(含显式布局)都收进聚合校验——
                // 首版显式布局参数绕过 agIdx 落通用臂,把 C 值参当指针
                // staging(体内解引必炸,fail-explosive 而非 fail-closed);
                // AggFieldsOk 对显式布局/基类/多态/不支持叶统一拒译。
                if (ac != null && ac.isStruct == 1) { agIdx[slot] = agList.Count; agList.Add(ac); }
                slot = slot + 1;
            }
            i = i + 1;
        }
        // 批42:聚合返回探测。struct 返回类型走重组尾(≤16B 值返回 /
        // >16B 隐藏缓冲);class/数组返回保持 E9/E4 指针形直通(内呼
        // 返回堆指针 ABI,指针形状逐位同构)。显式布局/基类/多态/不
        // 支持字段一律 aggRet 收进校验,由 AggFieldsOk 拒译——不能因
        // "特殊布局"绕回直通,那是静默错字节。
        // 批47:闭实例泛型 struct 返回同参数侧——视图优先(替换叶给
        // CAggFieldW 真 宽),未批形状落回开模板恒拒。
        Cls retC = FindClass(rt);
        if (retC != null && retC.tps.Count > 0 && rt != null && rt.IndexOf("<") > 0) {
            Cls vc = StructInstViewOf(rt);
            if (vc != null) { retC = vc; }
        }
        bool aggRet = retC != null && retC.isStruct == 1;
        bool aggRetHid = false;
        if (aggRet) {
            AggCLeaves(retC);
            aggRetHid = aggCSize > 16;
        }
        bool ok = np <= 8 && (rt == "void" || ShimIntLikeTy(rt)
            || rt == "float" || rt == "double");
        if (ok) {
            i = 0;
            slot = inst ? 1 : 0;
            while (ok && i < m.kids.Count) {
                Node p = m.kids[i];
                if (p.kind == AK.Param()) {
                    string pt = TypeFullName(p.type);
                    if (pt == "double") { }
                    else if (pt == "float") { }
                    else if (!ShimIntLikeTy(pt)) { ok = false; }
                    slot = slot + 1;
                }
                i = i + 1;
            }
        }
        if (!ok) {
            if (tgt86 == 1) {
                // 批39:!ok 标量签名(np>8 纯整/浮点、数组/Span 参 np≤8)
                // 一律走通用 staging 臂——恒等直通对浮点必错(xmm 位型
                // vs 体内 GPR 槽),纯整 7/8+ 参不 staging 体内读垃圾;
                // 数组/Span 形状由臂内 nst≤0 零区退化为诚实跳板。
                // 批41/42:真 struct 形状(参数/返回)走聚合重组臂,
                // class/数组形状走通用臂或 E9 直通,无一静默错。
                int q9 = 0;
                bool hasAgg86 = false;
                while (q9 < np) {
                    if (agIdx[q9] >= 0) {
                        hasAgg86 = true;
                        if (AggFieldsOk(agList[agIdx[q9]]) == false) {
                            XFailClosed("aggregate export parameter with unsupported field type", m.line, m.col);
                            return;
                        }
                    }
                    q9 = q9 + 1;
                }
                if (aggRet && AggFieldsOk(retC) == false) {
                    XFailClosed("aggregate export return with unsupported field type", m.line, m.col);
                    return;
                }
                if (hasAgg86) {
                    // 批41:struct 值参走专用臂(SysV eightbyte 分类 + zan
                    // 对象重组);批42:聚合返回尾并入同臂——≤16B 值返
                    // 回重组,>16B 隐返 rdi 缓冲 + 整参源寄存器右移一位。
                    // 批50:指针形返回(数组/类/List)放行 —— 归一化同
                    // arm64 侧:类返回 retC 归 null,标量尾 mov rdi,rax
                    // 直通,与 np≤8 E9 直通同一约定(参数侧批41 已同权)。
                    EmitX86ExportAggArm(cls, m, kind, np, rt, agList, agIdx, aggRet ? retC : null, pts);
                    return;
                }
                if (aggRet) {
                    // 批42:标量参数 + 聚合返回走通用 staging 臂。批48:
                    // 容量闸撤除——隐返(rdi 归缓冲)时 C 整参源右移一位,
                    // 第 6 参起源在调用者栈,栈源落位按体内家路由(家
                    // 寄存器经 r10 全宽搬家 / 家栈槽直落)后任意整参数
                    // 都有家;批42 首版硬写 [rsp+8*(q86-6)],q86=5 时
                    // [rsp-8] 踩调用者栈帧(nI>5 闸护的正是这个真雷),
                    // 值返 nI>6 形状本就正确(纯保守闸),一并开放。
                    EmitX86ExportGeneralArm(cls, m, kind, np, rt, retC, pts);
                    return;
                }
                // 批41:类参(List<T> 等)是数组/Span 同形的指针参——批41
                // 起与数组一并走通用 staging 臂(标量重排 + 返回转换齐备),
                // 旧"exports with aggregate signatures"对类参的 fail-closed
                // 退役(arm64 侧批39 已同权);真 struct 形状已在上面进
                // AggArm,无一静默错。批50:此段 np≤6(np>6 已被顶部通用
                // 臂分流),np>8 检查是死码,撤;指针形返回保持 E9 直通
                // (体内返回约定 v0→rax,位型原样)。
                if (!(rt == "void" || ShimIntLikeTy(rt) || rt == "float" || rt == "double")) {
                    X1(0xE9);                                // jmp rel32 -> body
                    fixups.Add(new Fixup(txt.Count - 1, 3, 0, 0, MethSymNg(cls, m)));
                    X4(0);
                    return;
                }
                EmitX86ExportGeneralArm(cls, m, kind, np, rt, null, pts);
                return;
            } else {
                int q11 = 0;
                bool hasAggA = false;
                while (q11 < np) {
                    if (agIdx[q11] >= 0) {
                        hasAggA = true;
                        if (AggFieldsOk(agList[agIdx[q11]]) == false) {
                            diags.Error("ngen: aggregate export parameter with unsupported field type is fail-closed", m.line, m.col);
                            return;
                        }
                    }
                    q11 = q11 + 1;
                }
                if (aggRet && AggFieldsOk(retC) == false) {
                    diags.Error("ngen: aggregate export return with unsupported field type is fail-closed", m.line, m.col);
                    return;
                }
                if (hasAggA) {
                    // 批41:struct 值参走专用臂(AAPCS64 Apple 变体分类 +
                    // zan 对象重组);批42:聚合返回尾并入同臂——≤16B 值
                    // 返回 HFA/位包重组,>16B 隐返 x8 缓冲(传参不移位)。
                    // 批50:指针形返回(数组/类/List)放行 —— 归一化
                    // retC 只在真聚合(aggRet)时传入:类返回的 FindClass
                    // 结果非空但 isStruct=0,原样传会让臂尾误走打包支
                    // (ldr 字段 0 当返回值,MkBoxWith 探针现形),null
                    // 则返回尾默认直通(x0 位型原样),与 np≤8 全整直通
                    // 跳板同一约定(参数侧批45 已同权)。
                    EmitArm64ExportAggArm(cls, m, kind, np, rt, agList, agIdx, aggRet ? retC : null, pts);
                    return;
                }
                if (np > 8) {
                    // 批39 诚实化:np>8 的 arm64 直通对浮点(位型落 v 寄
                    // 存器 vs 体内 x 槽)与溢出参(栈 vs 体内 x8+ 寄存器)
                    // 都是静默错——批39 探针 Mix10=21、SumI9=-95509744
                    // 定案。标量形状走通用排列臂。
                    // 批45:类/数组/Span 参与聚合返回解禁。类参 = kind 0
                    // 指针位型,与 int 同权过排列臂(cl10 探针双车道
                    // EXACT);聚合返回走 retC 尾——隐返 x8 stash 不移位、
                    // 值返 x0/x1/v 同理(fr9 探针双车道 EXACT)。struct
                    // 值参已在上面进 AggArm(arm64 内呼约定全参按序走
                    // x 寄存器,③ 落位与 np 无关,sp9 探针双车道 EXACT;
                    // x86 才需要 k≥6 溢出栈通道,已备)。批50:数组/类
                    // 返回同权放行——指针形返回 = x0 位型直通(与 np≤8
                    // 直通跳板同约定),通用臂尾默认分支即通道,批39
                    // "重组尾未探"保守闸退役(mk10 探针双车道 EXACT)。
                    Cls rcA = null;
                    if (aggRet) { rcA = retC; }
                    EmitArm64ExportGeneralArm(cls, m, kind, np, rt, rcA, pts);
                    return;
                }
                if (aggRet) {
                    // 批42:标量参数 + 聚合返回走通用排列臂(≤8 参,x8 隐
                    // 返缓冲不移位;值返回重组 x0/x1 或 v 寄存器)。
                    EmitArm64ExportGeneralArm(cls, m, kind, np, rt, retC, pts);
                    return;
                }
                // np≤8 的非聚合指针形状(数组/Span 参):直通跳板是批33
                // 以来的 oracle 行为,内呼按构造正确,保留(聚合返回批42
                // 起进重组臂,不再直通)。批45:仅全整类(指针)形状可直
                // 通——AAPCS64 浮点落 v 寄存器、体内读 x 槽,E4 跳板绕过
                // 排列即静默错(UseFH(2.5)=0 探针定案);带浮点走通用排
                // 列臂。
                int q14 = 0;
                bool allInt14 = true;
                while (q14 < np) { if (kind[q14] != 0) { allInt14 = false; } q14 = q14 + 1; }
                if (!allInt14) {
                    EmitArm64ExportGeneralArm(cls, m, kind, np, rt, null, pts);
                    return;
                }
                E4(0x14000001);                          // b <next insn> = body
                return;
            }
        }
        if (tgt86 == 1) {
            int nF86 = 0;
            int q86 = 0;
            while (q86 < np) { if (kind[q86] != 0) { nF86 = nF86 + 1; } q86 = q86 + 1; }
            if (np > 6) {
                // 批39:np>6(x86 体内寄存器槽只有 6 个)全走通用
                // staging 臂——纯整 7/8 参旧码不 staging 直接调用,体内
                // 栈槽读垃圾;浮点 np>6 旧码 fail-closed。必须在垫片
                // prologue 之前调用:该臂自带唯一一层 push rbp/mov,
                // 叠加会双重 prologue(rbp=entry-16,栈参源位移错位)。
                EmitX86ExportGeneralArm(cls, m, kind, np, rt, null, pts);
                return;
            }
            // 批 36:SSE 臂。SysV 把第 vi 个 float/double 参数交在 xmm_vi
            // (独立于整数游标、按声明序),体内模型要的是"双精度位型落
            // GPR 槽"(arm64 侧 fmov/fcvt 同义,见下)。带浮点时整参不再
            // 恒等:SysV 第 k 个整参在 GPR k(压实),体内读 GPR declidx
            // (垫开)——降序搬移的 Dest 下标只增,永不覆写未用源(与
            // arm64 同一证明)。
            X1(0x55);                                    // push rbp
            X3(0x48, 0x89, 0xE5);                        // mov rbp, rsp
            // 批45:寄存器整参入口规范化(见 ShimWidenOf)。纯整签名
            // 无排列(恒等),负 int 以硬件零扩形直通非规范;浮混签名在
            // 压实排列之前先原位展宽 SysV 整源,排列读到的即是规范值。
            int nI45 = 0;
            int q45 = 0;
            while (q45 < np) { if (kind[q45] == 0) { nI45 = nI45 + 1; } q45 = q45 + 1; }
            int[] ip45 = new int[nI45];
            int f45 = 0;
            q45 = 0;
            while (q45 < np) { if (kind[q45] == 0) { ip45[f45] = q45; f45 = f45 + 1; } q45 = q45 + 1; }
            int j45 = 0;
            while (j45 < nI45) {
                int w45 = ShimWidenOf(pts[ip45[j45]]);
                if (w45 == 1) { Xmovsxd(XMapReal(j45), XMapReal(j45)); }
                else if (w45 == 2) { Xmov32(XMapReal(j45), XMapReal(j45)); }
                j45 = j45 + 1;
            }
            if (nF86 != 0) {
                // 整参降序搬移:SysV 压实位 -> 体内垫开位。GPR 编号一律过
                // XMapReal——槽 k 的家是 v_k 的家(rdi/rsi/rdx/rcx/r8/r9 =
                // 编码 7/6/2/1/8/9),裸槽号 0 是 rax、5 是 rbp(首版正栽
                // 在这:movq 进了 rax,permute 写了 rbp 砸栈框)。
                int nI86 = np - nF86;
                int[] intPos86 = new int[nI86];
                int fill86 = 0;
                q86 = 0;
                while (q86 < np) {
                    if (kind[q86] == 0) { intPos86[fill86] = q86; fill86 = fill86 + 1; }
                    q86 = q86 + 1;
                }
                int k86 = nI86 - 1;
                while (k86 >= 0) {
                    if (intPos86[k86] != k86) { XMovGG(XMapReal(intPos86[k86]), XMapReal(k86)); }
                    k86 = k86 - 1;
                }
                // 浮点升序:SS 先 cvtss2sd 原位展宽(caller 的 xmm 出口
                // 即死,可原地),再 movq 位型进家 GPR。槽必 < 6(上闸)。
                int vi86 = 0;
                q86 = 0;
                while (q86 < np) {
                    if (kind[q86] == 1 || kind[q86] == 2) {
                        if (kind[q86] == 2) {
                            X3(0xF3, 0x0F, 0x5A);
                            X1(0xC0 | (vi86 << 3) | vi86);   // cvtss2sd xv, xv
                        }
                        int hd86 = XMapReal(q86);
                        X1(0x66); X1(0x48 | (hd86 >> 3)); X1(0x0F); X1(0x7E);
                        X1(0xC0 | (vi86 << 3) | (hd86 & 7)); // movq r_home, xv
                        vi86 = vi86 + 1;
                    }
                    q86 = q86 + 1;
                }
            }
            BLInternal(MethSymNg(cls, m));
            if (rt == "double") {
                // the body leaves the value as bit patterns in rdi; the
                // SysV C caller reads it from xmm0
                X3(0x66, 0x48, 0x0F); X2(0x6E, 0xC7);    // movq xmm0, rdi
            } else if (rt == "float") {
                // 批 36:体内 float 返回 = 双精度位型(rdi,v0 的家)——
                // movq 进 xmm1 再 cvtsd2ss 成 C 调用方的 s0
                X3(0x66, 0x48, 0x0F); X2(0x6E, 0xCF);    // movq xmm1, rdi
                X3(0xF2, 0x0F, 0x5A); X1(0xC1);          // cvtsd2ss xmm0, xmm1
            }
            XEpilogue();                                 // leave; ret
            return;
        }
        // the bl below clobbers lr: save the caller's return address and
        // the frame chain around the whole shim (same shape EmitMainShim
        // uses in front of its bl)
        E4(0xA9BF7BFD);                                  // stp x29, x30, [sp, #-16]!
        // integer slots, descending source order: the destination index of
        // the k-th integer slot only grows with k (float slots push it up),
        // so a descending walk never overwrites a source it still needs
        int nInt = 0;
        int q = 0;
        while (q < np) { if (kind[q] == 0) { nInt = nInt + 1; } q = q + 1; }
        int[] intPos = new int[nInt];
        int fill = 0;
        q = 0;
        while (q < np) {
            if (kind[q] == 0) { intPos[fill] = q; fill = fill + 1; }
            q = q + 1;
        }
        int k = nInt - 1;
        while (k >= 0) {
            // 批45:入口规范化(见 ShimWidenOf)——纯整签名无排列,负
            // int 以硬件零扩形直通;原位展宽后再压实排列(降序,目的
            // 地下标只增,永不覆写未读源)。
            int w45 = ShimWidenOf(pts[intPos[k]]);
            if (w45 == 1) { E4(0x93407C00 | (k << 5) | k); }          // sxtw x_k, w_k(SBFM #0,#31)
            else if (w45 == 2) { E4(0x2A0003E0 | (k << 16) | k); }    // mov w_k, w_k(零扩)
            if (intPos[k] != k) { MovRR(intPos[k], k); }  // mov x_dst, x_k
            k = k - 1;
        }
        // float/double slots, ascending; the v-register cursor counts them
        // in declaration order, exactly how AAPCS64 assigned v0-v7.
        // 0x9E66.. = fmov xd, vn (SIMD -> general), 0x9E67.. = fmov vd, xn
        int vi = 0;
        q = 0;
        while (q < np) {
            if (kind[q] == 1) {
                E4(0x9E660000 | (vi << 5) | q);          // fmov x_q, d_vi
                vi = vi + 1;
            } else if (kind[q] == 2) {
                E4(0x1E22C000 | (vi << 5) | 16);         // fcvt d16, s_vi
                E4(0x9E660000 | (16 << 5) | q);          // fmov x_q, d16
                vi = vi + 1;
            }
            q = q + 1;
        }
        BLInternal(MethSymNg(cls, m));
        if (rt == "double") {
            if (tgt86 == 1) { X3(0x66, 0x48, 0x0F); X2(0x6E, 0xC7); } else { E4(0x9E670000); }                              // fmov d0, x0
        } else if (rt == "float") {
            E4(0x9E670010);                              // fmov d16, x0
            E4(0x1E624200);                              // fcvt s0, d16
        }
        E4(0xA8C17BFD);                                  // ldp x29, x30, [sp], #16
        E4(0xD65F03C0);                                  // ret
    }

    // scalar kinds that ride x slots unchanged in both the internal value
    // model and AAPCS64 (references are raw pointers; out/ref parameters
    // arrive as addresses). Anything aggregate falls back to the
    // passthrough branch above.
    bool ShimIntLikeTy(string t) {
        return t == "int" || t == "long" || t == "nint" || t == "uint"
            || t == "ulong" || t == "nuint" || t == "byte" || t == "sbyte"
            || t == "short" || t == "ushort" || t == "char" || t == "bool"
            || t == "string" || t == "object";
    }

    // 批45:C-ABI 整参规范化类。0 = 64 位位型直收(long/ulong/nint/
    // nuint/string/object/类/数组),1 = 低 32 位符号展宽(sbyte/short/
    // int),2 = 低 32 位零展宽(byte/ushort/char/uint/bool)。C 栈槽对
    // 4 字节整参只定义低 32 位(高 4 字节是阴影垃圾——栈参 8 字节直读
    // 把 +k·2^32 拖进体内,Big3+8int 探针定案);寄存器 32 位写由硬件
    // 零扩,负 int 同样非规范(RetI(-9)=4294967287 探针)。体内 int
    // 不变式 = 槽值恒为 sxtw 过的 64 位,裸 int→long 强转按恒等拷贝,
    // 靠垫片入口规范化维持。
    int ShimWidenOf(string t) {
        if (t == "sbyte" || t == "short" || t == "int") { return 1; }
        if (t == "byte" || t == "ushort" || t == "char" || t == "uint" || t == "bool") { return 2; }
        return 0;
    }

    // 批50:C 栈参宽度(AAPCS64 NSAA)—— 窄基元/float 自然尺寸 4 字节,
    // 8 字节类(long/ulong/nint/nuint/double/引用/类)各占 8。反汇编定案
    // (Apple clang -O0):两栈整参 str w,[x8] 后 [x8,#4] 紧排 —— arm64
    // 栈参按自然对齐/尺寸排布,与 SysV x86 的"栈参槽一律舍入 8 字节"
    // 不同步(x86 臂 8 步距恒对;arm64 序数×8 把第 2 个起的栈窄参读进
    // +4 阴影,SumI10/Pick10 ASLR 垃圾现形)。
    int CStackW(string ty) {
        if (ty == "long" || ty == "ulong" || ty == "nint" || ty == "nuint" || ty == "double" || ty == "TypeInfo") { return 8; }
        if (ty == "string" || ty == "object" || ty.EndsWith("[]")) { return 8; }
        Cls rc = FindClass(ty);
        if (rc != null && rc.isStruct != 1) { return 8; }
        return 4;
    }

    // 批50:x86 的 v16/v17 物理映射 = r10/r11(专用 scratch)。参数装载与
    // staging 都拿 r10 当搬运寄存器,轮到 v16 位时 XGetV(16,10) 恒等空
    // 转,而 r10 已被上一槽覆盖(S17 探针:第 17 参读到第 16 参的值,
    // x86 内呼 ≥17 参/实例 ≥16 参现形)。调用参数位统一改道 v19/v20
    // 真家(XVSlot 8/9),staging 端按位换号;arm64 恒等(信封闸已把
    // 参数寄存器封在 x0..x15)。
    int XArgVOf(int v) {
        if (tgt86 != 1) { return v; }
        if (v == 16) { return 19; }
        if (v == 17) { return 20; }
        return v;
    }

    void EmitMethod(string cls, Node m, int mi) {
        curCls = cls;
        curMeth = m;
        gotoNames.Clear();
        gotoIds.Clear();
        bool inst = methStat[mi] == 0 || methStat[mi] == 2;
        if (methStat[mi] == 2) {
            // a per-instantiation ctor spec emits under its own symbol
            // (the open class's _Cls_ctor symbol would collide); the tag
            // shape must match what InstCtorSpecNg emitted at call sites
            syms.Add(new Sym(m.sval2 != null && m.sval2 != ""
                ? CtorSpecSymOf(m.sval, cls, m) : CtorSymNg(cls, m), FnPad()));
        } else if (methStat[mi] == 3) {
            syms.Add(new Sym("_" + cls + "_cctor", FnPad()));
        } else {
            // 缺口四: the export shim is emitted first and owns the plain
            // exported name; the body follows under the "__body" symbol
            // every internal reference resolves to. Ctors/cctors keep the
            // historical single-symbol layout (internal-only callers).
            string ex = MethExportSymNg(cls, m);
            int shimAt = FnPad();
            EmitExportShimNg(cls, m, inst);
            syms.Add(new Sym(ex, shimAt));
            syms.Add(new Sym(MethSymNg(cls, m), FnPad()));
        }
        InitLocalsNg();
        // late-synthesized specializations may carry tuple types the
        // program sweep never saw; registration is idempotent
        TupleSweepMethodNg(m);
        // instance methods and ctors take `this` as their first argument;
        // a specialization of a generic-class method types `this` as the
        // instantiation ("Pool<Conn>") so field types substitute
        if (inst) {
            AddLoc("this", m.sval2 != null && m.sval2 != "" ? m.sval2 : cls, false);
        }
        // params get frame slots; the prologue stores x0.. into them in order.
        // An out/ref parameter's slot holds the caller's storage ADDRESS
        // (gen0's byref protocol): reads and writes go through it
        int pi = 0;
        while (pi < m.kids.Count) {
            Node p = m.kids[pi];
            if (p.kind == AK.Param()) {
                AddLoc(p.sval, TypeFullName(p.type), p.ival == 1);
                if (locTy[nloc - 1] == "string") { locOpaq[nloc - 1] = 1; }
                paramSlotsNg.Add(nloc - 1);
            }
            pi = pi + 1;
        }
        ReserveLocals(m.d);
        BoxLambdaWrittenLocalsNg(m.d);
        curHasTry = HasTry(m.d);
        if (curHasTry) {
            // EH bookkeeping locals: the top mirror, the outermost open
            // try's arm base, and the loop-entry top for break/continue
            AddLoc("#ehtop", "int", false);
            AddLoc("#ehbase", "int", false);
            AddLoc("#ehbrk", "int", false);
            ehTopLocal = nloc - 3;
            ehBaseLocal = nloc - 2;
            ehBrkLocal = nloc - 1;
        }
        CollectSpanViews(m.d);
        ReserveSpanBoxes();
        frame = 16 * nloc;
        // [ThreadEntry]: POSIX calls this body directly from libpthread's
        // start routine, which keeps its own state in callee-saved x19-x28
        // (Zan bodies use x19-x25 as working registers). Extend the frame by
        // six pair slots and store the registers below the locals -- locals
        // are x29-relative, so the body is untouched. Restore happens in
        // Epilogue, which every return path funnels through.
        curThreadEntryNg = HasMod(m, MOD.ThreadEntry()) ? 1 : 0;
        if (curThreadEntryNg == 1 && HasMod(m, MOD.Async())) {
            // an async body's state machine emits nested runtime helpers
            // that share Epilogue; a thread entry must stay synchronous
            diags.Error("ngen: [ThreadEntry] cannot be combined with async", m.line, m.col);
            curThreadEntryNg = 0;
        }
        tentFrame = frame;
        if (curThreadEntryNg == 1) {
            tentFrame = frame + 96;
            if (tgt86 != 1 && tentFrame > 504) {
                diags.Error("ngen: [ThreadEntry] frame exceeds the ldp/stp immediate range", m.line, m.col);
            }
        }
        if (tgt86 == 1) {
            // 批 35:闸拆除。arm64 的工作寄存器 x19-x25 落在被调者保存
            // 区,线程入口须成对保存;SysV x86 的工作集是 rax,rcx,rdx,
            // rsi,rdi,r8-r11 + 泼溅槽,rbx/r12-r15 全程不碰(批 35 清完
            // 七处坏编码后全对象扫描仅剩 timer 线程的平衡 push/pop 对),
            // libpthread 放在被调者保存寄存器里的线程状态天然无恙——
            // 序言/收尾零改动即可当线程入口
            XPrologue(frame);                            // push rbp; mov rbp,rsp; sub rsp, frame+160
        } else {
            E4(0xA9BF7BFD);                              // stp x29, x30, [sp, #-16]!
            E4(0x910003FD);                              // mov x29, sp
            if (tentFrame > 0) { AddSPImm(tentFrame, false); }        // sub sp, sp, #frame
            if (curThreadEntryNg == 1) {
                E4(0xA90053F3);                          // stp x19, x20, [sp]
                E4(0xA9015BF5);                          // stp x21, x22, [sp, #16]
                E4(0xA90263F7);                          // stp x23, x24, [sp, #32]
                E4(0xA9036BF9);                          // stp x25, x26, [sp, #48]
                E4(0xA90473FB);                          // stp x27, x28, [sp, #64]
            }
        }
        pi = 0;
        int argReg = 0;
        if (inst) {
            StoreLocal(0, 0);        // this
            argReg = 1;
        }
        while (pi < m.kids.Count) {
            Node p = m.kids[pi];
            if (p.kind == AK.Param()) {
                if (tgt86 == 1) {
                    // SysV: args 0-5 arrive in the mapped registers; args
                    // 6+ sit on the stack above the return address at
                    // [rbp+16+8k] -- the exact mirror of the caller shim's
                    // [rsp+8k] staging (batch 33: any arity, no cap)
                    if (argReg >= 6) {
                        XopRMem(0x8B, 10, 5, 16 + 8 * (argReg - 6));
                        XSetV(argReg, 10);
                        // 注意 StoreLocal 的源是 v 号不是寄存器号——arm64 的
                        // v10 就是 x10,x86 的 v10 是泼溅槽(陈旧内容);
                        // 值已经在 argReg 自己的家,从家入槽
                        StoreLocal(argReg, argReg);
                    } else {
                        StoreLocal(argReg, argReg);
                    }
                } else {
                    StoreLocal(argReg, argReg);
                }
                // a captured-and-rebound parameter shares its value through a
                // heap cell: the slot becomes the cell, the incoming argument
                // its payload (the same wrap shape a T? value uses)
                if (boxParamSlots.Contains(argReg)) {
                    LoadLocal(argReg, 0);
                    GenNulWrap(false);
                    StoreLocal(argReg, 0);
                }
                argReg = argReg + 1;
            }
            pi = pi + 1;
        }
        // batch 12: normalize Span parameters to the uniform pair-in-slot
        // representation. The incoming word is the CALLER's frame box
        // address (a caller frame outlives any synchronous callee); copying
        // the {base,len} pair into the callee's own slot makes the parameter
        // a by-value view, exactly C#'s ref-struct argument semantics. All
        // incoming registers are already stored, so x0-x3 are free here.
        // A ref/out Span parameter has no by-value shape to normalize --
        // rejected loudly rather than silently aliased.
        int psp = 0;
        while (psp < paramSlotsNg.Count) {
            int pli = paramSlotsNg[psp];
            if (SpanTyNg(locTy[pli])) {
                if (locRef[pli]) {
                    diags.Error("ngen: a ref/out parameter cannot be a Span view (its frame box is by-value); pass the array and build a local view", 0, 0);
                } else {
                    LoadLocal(pli, 0);                       // x0 = caller box
                    LdrU(1, 0, 0);
                    LdrU(2, 0, 8);
                    LoadImm(3, LocFpOff(locOff[pli]));
                    AddRR(3, 29, 3);
                    StrU(1, 3, 0);
                    StrU(2, 3, 8);
                }
            }
            psp = psp + 1;
        }
        if (curHasTry) {
            BLInternal("_zan_rt_eh_state");              // x0 = state
            LdrU(1, 0, 0);                               // top at entry
            StoreLocal(ehTopLocal, 1);                   // start the mirror
        }
        // ctor initializer chaining (gen0 parity). `: this(args)` runs
        // another ctor of the same class first (it owns the base chain) and
        // is mutually exclusive with base chaining; otherwise `: base(args)`
        // explicitly, or the parameterless base ctor implicitly -- base
        // fields are a layout prefix, so the base ctor runs on `this`
        // before the body
        if (methStat[mi] == 2 && m.c != null) {
            int tix = FitCtorIdx(cls, m.c, false, m);
            if (tix >= 0) {
                // same-class chaining on a generic spec: the spec this-type
                // ("Pool<Conn>") supplies the substitution source
                pendingCtorInstNg = m.sval2 != null && m.sval2 != "" ? m.sval2 : cls;
                int tpushed = PushCallArgs(methNodes[tix], m.c);
                pendingCtorInstNg = null;
                int tr = tpushed;
                while (tr >= 1) { XPopV(tr); tr = tr - 1; } // args reversed
                LoadLocal(0, 0);                                 // this -> x0
                BLInternal(CtorSymNg(cls, methNodes[tix]));
            } else {
                diags.Error("ngen: no matching 'this' constructor with "
                    + m.c.kids.Count + " argument(s)", m.line, m.col);
            }
        } else if (methStat[mi] == 2) {
            Cls c = FindClass(cls);
            if (c != null && c.baseName != null) {
                int bix;
                Node zerocall = new Node(AK.Call());
                if (m.b != null) {
                    bix = FitCtorIdx(c.baseName, m.b, false, null);
                } else {
                    bix = FitCtorIdx(c.baseName, zerocall, true, null);
                }
                if (bix >= 0) {
                    int bpushed;
                    if (m.b != null) {
                        bpushed = PushCallArgs(methNodes[bix], m.b);
                    } else {
                        bpushed = 0;
                    }
                    int br = bpushed;
                    while (br >= 1) { XPopV(br); br = br - 1; } // args reversed
                    LoadLocal(0, 0);                             // this -> x0
                    BLInternal(CtorSymNg(c.baseName, methNodes[bix]));
                }
            }
        }
        // instance field initializers run after the base chain and before
        // the body, once per ctor (a `: this(...)` delegator lets the
        // chain target run them, so it skips its own)
        if (methStat[mi] == 2 && m.c == null) {
            // a per-instantiation ctor spec substitutes T in field
            // initializers too -- they lower through the same open nodes
            // (a `new Dict<T, int>()` initializer must specialize as well)
            bool specCtor = m.sval2 != null && m.sval2 != "";
            Cls sc = specCtor ? FindClass(cls) : null;
            List<string> sargs = null;
            if (specCtor) {
                int slt = m.sval2.IndexOf("<");
                sargs = SplitTyArgs(m.sval2.Substring(slt + 1, m.sval2.Length - slt - 2));
            }
            int fi2 = 0;
            while (fi2 < ifInitCls.Count) {
                if (ifInitCls[fi2] == cls) {
                    Fld initFld = FindField(FindClass(cls), ifInitName[fi2]);
                    string fty = initFld != null ? initFld.ty : null;
                    Node iex = ifInitExpr[fi2];
                    if (specCtor) {
                        fty = SubstTy(fty, sc.tps, sargs);
                        iex = CloneNode(iex);
                        if (iex != null) { SubstTypeNode(iex, sc.tps, sargs); }
                    }
                    GenExpr(iex);
                    if (IsDblTy(fty) && !IsDblExpr(iex)) {
                        ConvI2D();
                    } else if (fty == "int" && !IsDblExpr(iex) && !IsStrExpr(iex)) {
                        Sxtw0();                  // sxtw x0, w0 (long literal -> int)
                    }
                    XPushV0();                          // push value
                    LoadLocal(0, 0);                         // this -> x0
                    XPopV(1);                                // pop value -> x1
                    StoreFieldNg(1, 0, initFld);
                }
                fi2 = fi2 + 1;
            }
        }
        // [AtomicCas]/[AtomicLoad]/[AtomicStore]/[StaticAddr]: the Zan body
        // is a placeholder -- the emission IS the implementation. These are
        // the runtime's atomic/synchronization nexus: casal/ldar/stlr give
        // the C oracle's __atomic SEQ_CST semantics on the same instructions
        // clang emits, and the data-global address lets runtime code point
        // OSAtomic/pthread primitives at static cells (spin locks, once
        // gates) that plain static loads/stores cannot address.
        if (HasMod(m, MOD.AtomicCas())) {
            LoadLocal(0, 0);                                 // x0 = cell
            LoadLocal(1, 1);                                 // x1 = expected
            LoadLocal(2, 2);                                 // x2 = desired
            if (tgt86 == 1) {
                // casal x1, x2, [x0] == lock cmpxchg [rdi], rdx with the
                // expected preloaded into rax and the witnessed old landing
                // in v0 (arm64 leaves it in x1; x86 leaves it in rax)
                XMov(0, 6);                                  // mov rax, rsi (expected; XMov takes REAL regs -- v1 is r6)
                X1(0xF0); X1(0x48); X2(0x0F, 0xB1); X1(0x17);   // lock cmpxchg qword [rdi], rdx
                XMov(7, 0);                                  // mov rdi, rax (witnessed old -> v0)
            } else {
                E4(0xC8E1FC02);                                  // casal x1, x2, [x0]
                MovRR(0, 1);                                  // mov x0, x1 (witnessed old)
            }
            Epilogue();
            curThreadEntryNg = 0;
            tentFrame = 0;
            return;
        }
        if (HasMod(m, MOD.AtomicLoad())) {
            LoadLocal(0, 0);                                 // x0 = cell
            if (tgt86 == 1) {
                // ldar x0,[x0]: SEQ_CST acquire-load on x86 is a plain
                // mov -- every load already orders acquire per TSO
                XopRMem(0x8B, 7, 7, 0);                      // mov rdi, [rdi]
            } else {
                E4(0xC8DFFC00);                                  // ldar x0, [x0]
            }
            Epilogue();
            curThreadEntryNg = 0;
            tentFrame = 0;
            return;
        }
        if (HasMod(m, MOD.AtomicStore())) {
            LoadLocal(0, 0);                                 // x0 = cell
            LoadLocal(1, 1);                                 // x1 = value
            if (tgt86 == 1) {
                // stlr x1,[x0]: release-store is a plain mov under TSO;
                // clang emits the same plain store for seq_cst stores
                XopMemR(0x89, 6, 7, 0);                      // mov [rdi], rsi
            } else {
                E4(0xC89FFC01);                                  // stlr x1, [x0]
            }
            Epilogue();
            curThreadEntryNg = 0;
            tentFrame = 0;
            return;
        }
        if (HasMod(m, MOD.StaticAddr())) {
            string sasym = FindStaticSym(curCls, m.attrStaticAddr);
            if (sasym == null) {
                diags.Error("ngen: [StaticAddr] target '" + m.attrStaticAddr
                    + "' is not a static field of this class", m.line, m.col);
            } else {
                LoadSymRef(sasym, 0);                        // adrp x0, sym@PAGE + add
            }
            Epilogue();
            curThreadEntryNg = 0;
            tentFrame = 0;
            return;
        }
        if (m.d != null) { GenStmt(m.d); }
        if (tgt86 == 1) { XLoadImm(0, 0); } else {
        E4(0xD2800000);                                  // movz x0, #0 (fallthrough)
        }
        Epilogue();
        curThreadEntryNg = 0;
        tentFrame = 0;
    }

    // does this statement subtree contain a try anywhere (clauses chain
    // through their .b slot)?
    bool HasTry(Node n) {
        if (n == null) { return false; }
        if (n.kind == AK.TryStmt()) { return true; }
        // lock lowers to try/finally at emission: its EH bookkeeping slots
        // and the state-top mirror must be reserved exactly like a try's
        if (n.kind == AK.LockStmt()) { return true; }
        if (n.kind == AK.CatchClause()) {
            Node cc = n;
            while (cc != null) {
                if (HasTry(cc.a)) { return true; }
                cc = cc.b;
            }
            return false;
        }
        int i = 0;
        while (i < n.kids.Count) { if (HasTry(n.kids[i])) { return true; } i = i + 1; }
        return HasTry(n.a) || HasTry(n.b) || HasTry(n.c) || HasTry(n.d);
    }

    void InitLocalsNg() {
        locName = new List<string>(); locTy = new List<string>();
        locOff = new List<int>(); locRef = new List<bool>();
        locDecl = new List<Node>(); locPrev = new List<int>();
        locOpaq = new List<int>();
        locBoxed = new List<int>();
        boxNames = new List<string>();
        spanSites = new List<Node>(); spanSiteOff = new List<int>();
        paramSlotsNg = new List<int>();
        envNodes = new List<Node>(); envHeads = new List<int>();
        patStamped = new List<Node>();
        locHead = -1; nloc = 0;
    }

    // pattern-binding pre-pass: switch-expression type patterns (`Shape s
    // =>`) and `is`-type bindings (`x is Animal a`) name a hidden local the
    // arm code stores the (cast) scrutinee into. Like the compound-assign
    // temps, the slots must exist before codegen -- the frame size is fixed
    // at the prologue -- so ReserveLocals stamps them up front. Unconditional
    // AddLoc gives C# shadowing (a binding hides an outer same-name local
    // head-first); patStamped keeps the recursive walk from double-adding.
    void StampPatternBindings(Node n) {
        if (n == null) { return; }
        if (n.kind == AK.SwitchExpr() && !patStamped.Contains(n)) {
            patStamped.Add(n);
            int i = 0;
            while (i < n.kids.Count) {
                Node arm = n.kids[i];
                if (arm != null && arm.ival == 1 && arm.sval != null) {
                    AddLoc(arm.sval, arm.type != null ? TypeFullName(arm.type) : "object", false);
                }
                i = i + 1;
            }
        } else if (n.kind == AK.IsExpr() && !patStamped.Contains(n)) {
            patStamped.Add(n);
            if (n.sval != null) {
                AddLoc(n.sval, n.type != null ? TypeFullName(n.type) : "object", false);
            }
        } else if (n.kind == AK.SwitchCase() && !patStamped.Contains(n)) {
            // statement switch: `case T x [when g]:` (the parser leaves
            // sval unset when no binding is named; `case null:` has no type)
            patStamped.Add(n);
            if (n.ival == 1 && n.type != null && n.sval != null && n.sval != "") {
                AddLoc(n.sval, TypeFullName(n.type), false);
            }
        }
        StampPatternBindings(n.a);
        StampPatternBindings(n.b);
        StampPatternBindings(n.c);
        StampPatternBindings(n.d);
        if (n.kids != null) {
            int i = 0;
            while (i < n.kids.Count) { StampPatternBindings(n.kids[i]); i = i + 1; }
        }
    }

    // ---- tuples: `(T1, T2)` values are the synthesized __Tuple_<elems>
    // classes (parser mangles the name into the type ref's sval). ngen
    // registers the layout on demand -- Item1..N fields at 8-byte strides,
    // boxed like any class instance -- so .ItemN reads resolve through the
    // ordinary field path and the literal allocates and stores by field.
    // Unlike gen0's LLVM struct values these are heap pointers, but the
    // observable behavior (construction, member reads, deconstruction)
    // matches as long as nobody mutates through two aliases of one tuple.

    // the parser's SanTy: alphanumerics kept, '[' -> A, '?' -> q, every
    // other non-alphanumeric collapses to one underscore
    string SanTyNg(string s) {
        string r = "";
        int i = 0;
        while (i < s.Length) {
            int c = s[i];
            if ((c >= 97 && c <= 122) || (c >= 65 && c <= 90) || (c >= 48 && c <= 57)) { r = r + Convert.ToString((char)c); }
            else if (c == 91) { r = r + "A"; }
            else if (c == 63) { r = r + "q"; }
            else if (r.Length > 0 && r.Substring(r.Length - 1, 1) != "_") { r = r + "_"; }
            i = i + 1;
        }
        while (r.Length > 0 && r.Substring(r.Length - 1, 1) == "_") { r = r.Substring(0, r.Length - 1); }
        return r;
    }

    string TupleMangleNg(List<string> etys) {
        string r = "__Tuple_";
        int i = 0;
        while (i < etys.Count) {
            if (i > 0) { r = r + "_"; }
            r = r + SanTyNg(etys[i]);
            i = i + 1;
        }
        return r;
    }

    // static element type of a tuple literal's element expression
    string TupleElemTyNg(Node e) {
        string t = e != null ? InferExprTyNg(e) : null;
        return t != null && t != "" ? t : "object";
    }

    // mangled name of a tuple literal, memoized onto the node (StaticTyOf
    // asks repeatedly and the element inference is not free)
    string TupleExprMangledNg(Node e) {
        if (e.sval2 != null && e.sval2 != "") { return e.sval2; }
        List<string> etys = new List<string>();
        int i = 0;
        while (i < e.kids.Count) { etys.Add(TupleElemTyNg(e.kids[i])); i = i + 1; }
        e.sval2 = TupleMangleNg(etys);
        return e.sval2;
    }

    void EnsureTupleClsNg(string name, List<string> etys) {
        if (FindClass(name) != null) { return; }
        Cls c = new Cls(name);
        int i = 0;
        while (i < etys.Count) {
            c.flds.Add(new Fld("Item" + Convert.ToString(i + 1), i * 8, etys[i]));
            i = i + 1;
        }
        c.size = etys.Count * 8;
        RegCls(c);
    }

    void TupleSweepTyNg(Node t) {
        if (t == null) { return; }
        if (t.op == 2 && t.sval != null && t.sval.IndexOf("__Tuple_") == 0) {
            List<string> etys = new List<string>();
            int i = 0;
            while (i < t.kids.Count) { etys.Add(TypeFullName(t.kids[i])); i = i + 1; }
            EnsureTupleClsNg(t.sval, etys);
            return;
        }
        TupleSweepTyNg(t.a);
        int k = 0;
        if (t.kids != null) {
            while (k < t.kids.Count) { TupleSweepTyNg(t.kids[k]); k = k + 1; }
        }
    }

    void TupleSweepNg(Node n) {
        if (n == null) { return; }
        if (n.kind == AK.TupleExpr()) {
            List<string> etys = new List<string>();
            int i = 0;
            while (i < n.kids.Count) { etys.Add(TupleElemTyNg(n.kids[i])); i = i + 1; }
            EnsureTupleClsNg(TupleMangleNg(etys), etys);
        }
        TupleSweepNg(n.a);
        TupleSweepNg(n.b);
        TupleSweepNg(n.c);
        TupleSweepNg(n.d);
        if (n.kids != null) {
            int i = 0;
            while (i < n.kids.Count) { TupleSweepNg(n.kids[i]); i = i + 1; }
        }
    }

    // whole method: return type, parameter types and body. Runs at the
    // program sweep (so cross-method order never matters -- Main may read
    // GetPair().Item2 before GetPair's body is ever emitted) and again per
    // method for later-synthesized specializations.
    void TupleSweepMethodNg(Node m) {
        if (m == null) { return; }
        TupleSweepTyNg(m.type);
        int pi = 0;
        while (pi < m.kids.Count) {
            if (m.kids[pi].kind == AK.Param()) { TupleSweepTyNg(m.kids[pi].type); }
            pi = pi + 1;
        }
        TupleSweepNg(m.d);
    }

    // deconstruction element type: the declared per-target type, else the
    // rhs tuple's registered field type (the program sweep guarantees the
    // class exists by the time any method body is emitted)
    string TupleDeconElemTyNg(Node rhs, int i) {
        if (rhs != null && rhs.kind == AK.TupleExpr() && i < rhs.kids.Count) {
            return TupleElemTyNg(rhs.kids[i]);
        }
        string rt = rhs != null ? InferExprTyNg(rhs) : null;
        if (rt != null && rt.IndexOf("__Tuple_") == 0) {
            Cls c = FindClass(rt);
            if (c != null && i < c.flds.Count) { return c.flds[i].ty; }
        }
        return "object";
    }

    // declared types inside a specialization body: a local or param declared
    // with the CLASS's type parameter ("T keep = item;") burns the parameter
    // name into locTy at decl time, and every type-keyed lowering (ToString
    // dispatch, string/bool/double probes, scalar classification) then sees
    // an unresolvable "T" and falls into name-match dispatch. Field reads
    // resolve lazily through CurField/sval2, and CallRetTy substitutes
    // member-call returns -- declared locals need the same substitution.
    // Open template bodies (no sval2) keep the erased parameter.
    string CurDeclTyNg(string ty) {
        if (ty == null || curMeth == null || curMeth.sval2 == null
                || curMeth.sval2 == "") { return ty; }
        int lt = curMeth.sval2.IndexOf("<");
        if (lt <= 0) { return ty; }
        Cls c = FindClass(curMeth.sval2.Substring(0, lt));
        if (c == null || c.tps.Count == 0) { return ty; }
        List<string> args = SplitTyArgs(curMeth.sval2.Substring(lt + 1, curMeth.sval2.Length - lt - 2));
        if (args.Count != c.tps.Count) { return ty; }
        return SubstTy(ty, c.tps, args);
    }

    // Frame allocation and visibility are separate. Leaving a lexical scope
    // restores its chain head, never its allocated storage.
    void AddLoc(string name, string ty, bool isRef) {
        ty = CurDeclTyNg(ty);
        locName.Add(name); locTy.Add(ty); locOff.Add(16 * nloc);
        locRef.Add(isRef); locDecl.Add(null); locPrev.Add(locHead);
        locOpaq.Add(0);
        locBoxed.Add(0);
        locHead = nloc; nloc = nloc + 1;
    }

    // ---- lambda-written locals (A33-2b) ---------------------------------
    // C# captures variables, not value snapshots: a lambda that assigns an
    // enclosing local writes *that* local, and the declaring method sees the
    // write when the delegate returns. Such a local is boxed: its frame slot
    // holds a shared heap cell, every access on either side goes through the
    // cell, and the delegate env carries the cell pointer instead of a copy.
    // The oracle boxes EVERY capture (an outer write between delegate
    // creation and invocation is the only read-side difference); here only
    // lambda-written locals box, so the snapshot path every passing lambda
    // test exercises stays byte-identical.
    void BoxLambdaWrittenLocalsNg(Node body) {
        boxNames = new List<string>();
        boxCaptured = new List<string>();
        boxOuterWrote = new List<string>();
        BoxWritesNg(body, new List<string>(), false, 0);
        // a captured variable the method itself rebinds must box even though
        // no lambda writes it: the delegate must observe the rebinding, and
        // a value snapshot would keep reporting the pre-rebind word
        boxParamSlots = new List<int>();
        int li = 0;
        while (li < locDecl.Count) {
            Node d = locDecl[li];
            bool captured = IndexOf(boxCaptured, locName[li]) >= 0;
            bool rebound = IndexOf(boxOuterWrote, locName[li]) >= 0;
            // plain VarDecl slots only: foreach/catch/for-var decls register
            // other node kinds (or none) and their per-iteration stores write
            // the slot directly; params are handled below through their
            // recorded frame slots
            if (d != null && d.kind == AK.VarDecl() && locRef[li] == false
                    && (IndexOf(boxNames, locName[li]) >= 0 || (captured && rebound))) {
                locBoxed[li] = 1;
            }
            li = li + 1;
        }
        int ps = 0;
        while (ps < paramSlotsNg.Count) {
            int li2 = (int)paramSlotsNg[ps];
            if (locRef[li2] == false
                    && IndexOf(boxCaptured, locName[li2]) >= 0
                    && IndexOf(boxOuterWrote, locName[li2]) >= 0) {
                locBoxed[li2] = 1;
                boxParamSlots.Add(li2);
            }
            ps = ps + 1;
        }
    }

    // Collect the names any lambda at depth > 0 assigns. Same shadowing
    // discipline as DelegateCapturesNg: lambda params, block/for/foreach
    // declarations shadow outer names, so writes to them never box an
    // outer local. `out`/`ref` arguments are deliberately not treated as
    // writes: a boxed local's slot holds the cell, and taking its address
    // would hand the callee the cell pointer instead of storage.
    void BoxWritesNg(Node n, List<string> bound, bool write, int depth) {
        if (n == null) { return; }
        int k = n.kind;
        if (k == AK.Ident()) {
            // name match against the WHOLE slot table, not LocalIdx: the
            // scope chain has been rolled back to the method top by the time
            // this pre-pass runs, so block-scoped locals are unreachable
            // through it. Over-matching a same-named local is harmless --
            // boxing a never-captured local changes no observable behavior.
            if (depth > 0 && write && IndexOf(bound, n.sval) < 0
                    && IndexOf(locName, n.sval) >= 0 && IndexOf(boxNames, n.sval) < 0) {
                if (SpanTyNg(NamedSlotTy(n.sval))) {
                    diags.Error("ngen: a lambda cannot capture a Span view (ref-struct shape); rebuild the view inside the lambda", n.line, n.col);
                }
                boxNames.Add(n.sval);
            }
            // reads at depth > 0 make the name a capture candidate; a depth-0
            // write marks a method-body rebind. Captured + rebound is the
            // C# closure shape (the variable is one cell), so the pair boxes
            // even though no lambda ever assigns it.
            if (depth > 0 && IndexOf(bound, n.sval) < 0
                    && IndexOf(locName, n.sval) >= 0 && IndexOf(boxCaptured, n.sval) < 0) {
                if (SpanTyNg(NamedSlotTy(n.sval))) {
                    diags.Error("ngen: a lambda cannot capture a Span view (ref-struct shape); rebuild the view inside the lambda", n.line, n.col);
                }
                boxCaptured.Add(n.sval);
            }
            if (depth == 0 && write && IndexOf(bound, n.sval) < 0
                    && IndexOf(locName, n.sval) >= 0 && IndexOf(boxOuterWrote, n.sval) < 0) {
                boxOuterWrote.Add(n.sval);
            }
            return;
        }
        if (k == AK.ThisExpr() || k == AK.BaseExpr()) { return; }
        if (k == AK.Lambda()) {
            List<string> inner = DelegateNamesCopyNg(bound); int i = 0;
            while (i < n.kids.Count) { inner.Add(n.kids[i].sval); i = i + 1; }
            BoxWritesNg(n.a, inner, false, depth + 1);
            BoxWritesNg(n.d, inner, false, depth + 1);
            return;
        }
        if (k == AK.Block()) {
            List<string> inner = DelegateNamesCopyNg(bound); int i = 0;
            while (i < n.kids.Count) {
                Node s = n.kids[i]; BoxWritesNg(s, inner, false, depth);
                // depth 0 walks the METHOD body: its locals are the capture
                // targets, never shadowing names (adding them made every
                // lambda treat the enclosing locals as bound)
                if (depth > 0 && s.kind == AK.VarDecl()) { inner.Add(s.sval); }
                i = i + 1;
            }
            return;
        }
        if (k == AK.ForStmt()) {
            List<string> inner = DelegateNamesCopyNg(bound);
            BoxWritesNg(n.a, inner, false, depth);
            if (depth > 0 && n.a != null && n.a.kind == AK.VarDecl()) { inner.Add(n.a.sval); }
            BoxWritesNg(n.b, inner, false, depth);
            BoxWritesNg(n.c, inner, false, depth);
            BoxWritesNg(n.d, inner, false, depth);
            return;
        }
        if (k == AK.ForeachStmt()) {
            BoxWritesNg(n.b, bound, false, depth);
            List<string> inner = DelegateNamesCopyNg(bound);
            if (depth > 0) { inner.Add(n.sval); }
            BoxWritesNg(n.c, inner, false, depth);
            return;
        }
        if (k == AK.Assignment()) {
            BoxWritesNg(n.a, bound, true, depth);
            BoxWritesNg(n.b, bound, false, depth);
            return;
        }
        if (k == AK.PostfixUnary()) {
            BoxWritesNg(n.a, bound, true, depth);
            return;
        }
        BoxWritesNg(n.a, bound, write, depth);
        BoxWritesNg(n.b, bound, false, depth);
        BoxWritesNg(n.c, bound, false, depth);
        BoxWritesNg(n.d, bound, false, depth);
        int j = 0;
        while (j < n.kids.Count) { BoxWritesNg(n.kids[j], bound, false, depth); j = j + 1; }
    }

    bool LocBoxedNg(int li) {
        return li >= 0 && li < locBoxed.Count && locBoxed[li] != 0;
    }

    // the local's VALUE: a boxed slot dereferences its cell; a Span local's
    // value IS its own frame box (the slot holds the {base,len} pair), so
    // the box address is x29 + slot offset (batch 12)
    void LoadLocalVal(int li, int reg) {
        if (SpanTyNg(locTy[li])) {
            LoadImm(reg, LocFpOff(locOff[li]));
            AddRR(reg, 29, reg);
            return;
        }
        LoadLocal(li, reg);
        if (LocBoxedNg(li)) { LdrU(reg, reg, 0); }
    }

    // write the local's VALUE: a boxed slot stores through its cell; a Span
    // local takes a PAIR COPY from the source box (value semantics -- the
    // written view never aliases the source slot; x16/x17 are scratch)
    void StoreLocalVal(int li, int reg) {
        if (SpanTyNg(locTy[li])) {
            if (tgt86 == 1) {
                // v16/v17 的家就是 r10/r11 = 双子层的暂存寄存器,AddRR 一过
                // 即被冲(arm64 的 x16/x17 是永不分派的专用 scratch,x86 无
                // 此待遇)。基址/长度先入 push 流,算完槽址再取回。
                LdrU(16, reg, 0);                    // src base
                LdrU(17, reg, 8);                    // src len
                XPushR(16); XPushR(17);
                LoadImm(reg, LocFpOff(locOff[li]));
                AddRR(reg, 29, reg);                 // reg = the slot
                XPopV(17); XPopV(16);
                StrU(16, reg, 0);
                StrU(17, reg, 8);
                return;
            }
            LdrU(16, reg, 0);                        // src base
            LdrU(17, reg, 8);                        // src len
            LoadImm(reg, LocFpOff(locOff[li]));
            AddRR(reg, 29, reg);
            StrU(16, reg, 0);
            StrU(17, reg, 8);
            return;
        }
        if (LocBoxedNg(li)) {
            int scr = reg == 9 ? 10 : 9;
            LoadLocal(li, scr);                      // x_scr = cell
            StrU(reg, scr, 0);                       // cell->value
            return;
        }
        StoreLocal(li, reg);
    }

    // a declaration's initializing store: a boxed local allocates its shared
    // cell here (x0 = value on entry) and keeps the cell pointer in the slot;
    // a Span local pair-copies the source box into its frame slot
    void StoreDeclValNg(Node d) {
        int li = DeclSlotNg(d);
        if (SpanTyNg(locTy[li])) {
            XPushV0();                          // push src box
            XPopV(1);                          // x1 = src box
            LoadImm(0, LocFpOff(locOff[li]));
            AddRR(0, 29, 0);                         // x0 = the slot
            LdrU(2, 1, 0);
            LdrU(3, 1, 8);
            StrU(2, 0, 0);
            StrU(3, 0, 8);
            return;
        }
        if (LocBoxedNg(li)) {
            XPushV0();                          // push value
            LoadImm(0, 8);
            LoadImm(1, 0);
            BLInternal("_zan_rt_alloc");             // x0 = zeroed 8-byte cell
            XPopV(1);                          // x1 = value
            StrU(1, 0, 0);                           // cell->value
            StoreLocal(li, 0);                       // slot = cell
            return;
        }
        StoreLocal(li, 0);
    }

    // `T x;` without an initializer: only a boxed local needs anything (its
    // cell must exist before any lambda can run); _zan_rt_alloc zeroes, so
    // the cell's value starts at default(T)'s word pattern. A Span local
    // zeroes its frame box: base=0/len=0 routes any early index into the
    // bounds guard's soft path instead of a wild deref (batch 12)
    void StoreDeclZeroCellNg(Node d) {
        int li = DeclSlotNg(d);
        if (SpanTyNg(locTy[li])) {
            LoadImm(0, 0);
            StoreLocal(li, 0);                       // base = 0
            LoadImm(1, LocFpOff(locOff[li]));
            AddRR(1, 29, 1);
            StrU(0, 1, 8);                           // len = 0 (slot slack word)
            return;
        }
        if (!LocBoxedNg(li)) { return; }
        LoadImm(0, 8);
        LoadImm(1, 0);
        BLInternal("_zan_rt_alloc");
        StoreLocal(li, 0);
    }

    // A string slot declared with an extern-call initializer carries a raw
    // host buffer: no stamped length header and bytes possibly past the
    // first NUL. Marked at the declaration only, like the C host's
    // call_targets_extern + local->opaque_string pair; reassignment never
    // clears the flag.
    void MarkOpaqIfExtern(string name, Node init) {
        if (init == null) { return; }
        int li = LocalIdx(name);
        if (li >= 0 && locTy[li] == "string" && CallTargetsExtern(init)) {
            locOpaq[li] = 1;
        }
    }

    // does this call expression directly invoke an extern-declared method?
    bool CallTargetsExtern(Node e) {
        if (e == null || e.kind != AK.Call()) { return false; }
        Node callee = e.a;
        if (callee == null) { return false; }
        string cls = null;
        string name = callee.sval;
        bool bare = callee.kind == AK.Ident();
        if (bare) {
            cls = curCls;
        } else if (callee.kind == AK.MemberAccess() && callee.a != null
                && callee.a.kind == AK.Ident() && FindClass(callee.a.sval) != null) {
            cls = callee.a.sval;
        } else {
            return false;
        }
        int found = 0;
        while (cls != null && found == 0) {
            List<int> cs = MethCandsClsName(cls, name);
            if (cs != null) {
                int i = 0;
                while (i < cs.Count) {
                    if (methStat[cs[i]] == 1 && HasMod(methNodes[cs[i]], MOD.Extern())) { found = 1; break; }
                    i = i + 1;
                }
            }
            if (found == 0) {
                Cls c = FindClass(cls);
                cls = c != null ? c.baseName : null;
            }
        }
        if (found == 0 && bare) {
            // legacy global-static fallback for bare names
            List<int> gs = MethCandsName(name);
            if (gs != null) {
                int i = 0;
                while (i < gs.Count) {
                    if (methStat[gs[i]] == 1 && HasMod(methNodes[gs[i]], MOD.Extern())) { found = 1; break; }
                    i = i + 1;
                }
            }
        }
        return found == 1;
    }

    void AddDeclNg(Node n, string name, string ty) {
        AddLoc(name, ty, false);
        locDecl[nloc - 1] = n;
    }

    int DeclSlotNg(Node n) {
        int i = 0;
        while (i < locDecl.Count) {
            if (locDecl[i] == n) { return i; }
            i = i + 1;
        }
        return -1;
    }

    void RecordEnvNg(Node n) {
        envNodes.Add(n); envHeads.Add(locHead);
    }

    int EnterEnvNg(Node n) {
        int saved = locHead;
        if (envNodes == null) { return saved; }
        int i = envNodes.Count - 1;
        while (i >= 0) {
            if (envNodes[i] == n) { locHead = envHeads[i]; return saved; }
            i = i - 1;
        }
        return saved; // synthesized expression inherits its call site's scope
    }

    // Walk expressions left-to-right: an out declaration activates its own
    // slot for following arguments and statements, not an unrelated namesake.
    void ReserveOutDecls(Node n) {
        if (n == null) { return; }
        if (n.kind == AK.OutArg() && n.type != null && n.sval != null && n.sval != "") {
            AddDeclNg(n, n.sval, TypeFullName(n.type));
        }
        RecordEnvNg(n);
        ReserveOutDecls(n.a); ReserveOutDecls(n.b);
        ReserveOutDecls(n.c); ReserveOutDecls(n.d);
        int i = 0;
        while (i < n.kids.Count) { ReserveOutDecls(n.kids[i]); i = i + 1; }
    }

    void ReserveScopedNg(Node n) {
        int saved = locHead;
        ReserveLocals(n);
        locHead = saved;
    }

    // `var` declarations carry no declared type; infer the slot type from the
    // initializer (or the foreach collection) exactly where the reference
    // compiler's checker does. Returns the declared name unchanged otherwise.
    string InferDeclTyNg(Node s) {
        string decl = s.type != null ? TypeFullName(s.type) : null;
        if (decl != null && decl != "") { return decl; }
        // the parser represents `var` as a null type node
        if (s.b == null) {
            diags.Error("ngen: 'var' declaration '" + s.sval + "' needs an initializer", s.line, s.col);
            return "int";
        }
        string inf = InferExprTyNg(s.b);
        if (inf == null || inf == "") {
            diags.Error("ngen: cannot infer the type of 'var' declaration '" + s.sval + "'", s.line, s.col);
            return "int";
        }
        return inf;
    }

    string InferForeachTyNg(Node s) {
        string decl = s.type != null ? TypeFullName(s.type) : null;
        if (decl != "var" && decl != null && decl != "") { return decl; }
        string el = null;
        string at = ArrContainerTy(s.b);
        if (at != null && at.Length > 2) { el = at.Substring(0, at.Length - 2); }
        else {
            string ct = StaticTyOf(s.b);
            if (ct != null && ct.IndexOf("List<") == 0 && ct.Substring(ct.Length - 1, 1) == ">") {
                el = ct.Substring(5, ct.Length - 6);
            }
        }
        if (el == null) {
            diags.Error("ngen: cannot infer the item type of the foreach collection", s.line, s.col);
            return "int";
        }
        return el;
    }

    string InferExprTyNg(Node e) {
        if (e == null) { return null; }
        int k = e.kind;
        if (k == AK.StringLit()) { return "string"; }
        if (k == AK.CharLit()) { return "char"; }
        if (k == AK.IntLit()) { return "int"; }
        if (k == AK.BoolLit()) { return "bool"; }
        if (k == AK.FloatLit()) { return "double"; }
        if (k == AK.NullLit()) { return "object"; }
        if (k == AK.NewExpr()) {
            if (e.type == null) { return null; }
            return e.ival == 1 ? NewArrTyOf(e) : TypeFullName(e.type);
        }
        if (k == AK.CastExpr() || k == AK.AsExpr()) { return e.type != null ? TypeFullName(e.type) : null; }
        if (k == AK.Call()) { return CallRetTy(e); }
        if (k == AK.Ident()) { return NamedSlotTy(e.sval); }
        if (k == AK.Index()) { return ElemTyOf(e); }
        if (k == AK.MemberAccess()) {
            Fld f = FieldOf(e);
            return f != null ? f.ty : StaticTyOf(e);
        }
        if (k == AK.Conditional()) {
            string a = InferExprTyNg(e.b);
            return a != null ? a : InferExprTyNg(e.c);
        }
        if (k == AK.SwitchExpr()) {
            int i = 0;
            while (i < e.kids.Count) {
                string at = InferExprTyNg(e.kids[i].b);
                if (at != null) { return at; }
                i = i + 1;
            }
            return null;
        }
        if (k == AK.TupleExpr()) { return TupleExprMangledNg(e); }
        if (k == AK.Binary() && e.op == TK.QQ()) {
            string qa = InferExprTyNg(e.a);
            return qa != null ? qa : InferExprTyNg(e.b);
        }
        if (k == AK.Binary() && e.op == TK.Plus()) {
            string la = InferExprTyNg(e.a);
            string lb = InferExprTyNg(e.b);
            if (la == "string" || lb == "string") { return "string"; }
            return la != null ? la : lb;
        }
        if (IsDblExpr(e)) { return "double"; }
        // ngen_async hook C: `await F()` yields F's element type
        if (k == AK.AwaitExpr()) { return AsyncAwaitElemTyNg(e.a); }
        // integer arithmetic keeps the wider operand kind -- `statusInterval
        // * 1000` in Task.Delay(ms) is long, not unknown (the checker
        // already validated the operands; this only names the result)
        if (k == AK.Binary() && (e.op == TK.Minus() || e.op == TK.Star()
                || e.op == TK.Slash() || e.op == TK.Percent()
                || e.op == TK.Amp() || e.op == TK.Pipe() || e.op == TK.Caret())) {
            string la = InferExprTyNg(e.a);
            string lb = InferExprTyNg(e.b);
            if (la == "long" || la == "ulong" || lb == "long" || lb == "ulong") { return "long"; }
            return la != null ? la : lb;
        }
        // relational / equality / logical results are bool -- an untyped
        // lambda body like `n > 3` (a Selector's R position) only types here
        if (k == AK.Binary() && (e.op == TK.EqEq() || e.op == TK.BangEq()
                || e.op == TK.Less() || e.op == TK.Greater()
                || e.op == TK.LessEq() || e.op == TK.GreaterEq()
                || e.op == TK.AmpAmp() || e.op == TK.PipePipe())) {
            return "bool";
        }
        return null;
    }

    void ReserveLocals(Node s) {
        if (s == null) { return; }
        // switch-expression / is-type pattern bindings are frame slots like
        // the compound-assign temps: the frame size is fixed at the
        // prologue, so they must be stamped before any codegen sees them
        StampPatternBindings(s);
        // compound-assign single-eval temps join the scope BEFORE the env
        // snapshot, so the statement's codegen pass can resolve them
        if (s.kind == AK.ExprStmt()) { StampCompoundTemps(s.a); }
        RecordEnvNg(s);
        int k = s.kind;
        if (k == AK.Block()) {
            int saved = locHead;
            int i = 0;
            while (i < s.kids.Count) { ReserveLocals(s.kids[i]); i = i + 1; }
            locHead = saved;
        } else if (k == AK.VarDecl()) {
            ReserveOutDecls(s.b);
            AddDeclNg(s, s.sval, InferDeclTyNg(s));
            MarkOpaqIfExtern(s.sval, s.b);
            int di = 0;
            while (di < s.kids.Count) {
                Node d = s.kids[di];
                ReserveOutDecls(d.b);
                AddDeclNg(d, d.sval, InferDeclTyNg(d));
                MarkOpaqIfExtern(d.sval, d.b);
                di = di + 1;
            }
        } else if (k == AK.DeconDecl()) {
            // `var (a, b) = rhs;` binds one local per element; the element
            // type is the declared one, else the rhs tuple's field type
            int i = 0;
            while (i < s.kids.Count) {
                Node p = s.kids[i];
                string ty = p.type != null ? TypeFullName(p.type)
                        : TupleDeconElemTyNg(s.b, i);
                AddDeclNg(p, p.sval, ty);
                i = i + 1;
            }
        } else if (k == AK.IfStmt()) {
            int saved = locHead;
            ReserveOutDecls(s.a);
            ReserveScopedNg(s.b); ReserveScopedNg(s.c);
            locHead = saved;
        } else if (k == AK.WhileStmt()) {
            int saved = locHead;
            ReserveOutDecls(s.a); ReserveScopedNg(s.b);
            locHead = saved;
        } else if (k == AK.DoWhileStmt()) {
            int saved = locHead;
            ReserveOutDecls(s.a); ReserveScopedNg(s.b);
            locHead = saved;
        } else if (k == AK.ForStmt()) {
            int saved = locHead;
            ReserveLocals(s.a); ReserveOutDecls(s.b);
            ReserveScopedNg(s.d); ReserveOutDecls(s.c);
            locHead = saved;
        } else if (k == AK.ForeachStmt()) {
            int saved = locHead;
            ReserveOutDecls(s.b);
            AddDeclNg(s, s.sval, InferForeachTyNg(s));
            AddLoc("#fei", "int", false);
            ReserveScopedNg(s.c);
            locHead = saved;
        } else if (k == AK.TryStmt()) {
            ReserveScopedNg(s.a);
            // one frame slot per catch clause holds that clause's OWN
            // exception while its body runs: a bare `throw;` inside must
            // rethrow it even after a nested try in the body overwrote the
            // in-flight global (the reference's kept-exception rule)
            s.ival = clauseExcNodes.Count;
            Node cc = s.b;
            while (cc != null) {
                int saved = locHead;
                RecordEnvNg(cc);
                if (cc.sval != null && cc.sval != "") {
                    AddDeclNg(cc, cc.sval, cc.type != null ? TypeFullName(cc.type) : "string");
                }
                clauseExcNodes.Add(cc);
                clauseExcSlots.Add(nloc);
                AddLoc("#ehcx", "int", false);
                ReserveScopedNg(cc.a);
                locHead = saved;
                cc = cc.b;
            }
            ReserveScopedNg(s.c);
        } else if (k == AK.LockStmt()) {
            // the lock's temp lives in the frame: allocate the slot NOW
            // (ReserveLocals runs before the frame size freezes and before
            // the #ehtop/#ehbase/#ehbrk slots are appended) and stash the
            // decl node in s.c for the emission pass
            ReserveOutDecls(s.a);
            Node d = new Node(AK.VarDecl());
            d.sval = "$lock" + lockSeq;
            lockSeq = lockSeq + 1;
            d.b = s.a;
            AddDeclNg(d, d.sval, InferExprTyNg(s.a));
            s.c = d;
            int saved = locHead;
            ReserveScopedNg(s.b);
            locHead = saved;
        } else if (k == AK.SwitchStmt()) {
            int saved = locHead;
            ReserveOutDecls(s.a);
            int i = 0;
            while (i < s.kids.Count) {
                ReserveOutDecls(s.kids[i].a);
                ReserveScopedNg(s.kids[i].b);
                i = i + 1;
            }
            locHead = saved;
        } else if (k == AK.ExprStmt()) {
            ReserveOutDecls(s.a);
        } else {
            ReserveOutDecls(s.a); ReserveOutDecls(s.b);
            ReserveOutDecls(s.c); ReserveOutDecls(s.d);
        }
    }

    // a compound assignment whose target is an element/field place gets its
    // container and index pre-evaluated into hidden slots so the read and
    // the store see one evaluation each (`box.data[Next()] += 5` must call
    // Next() once); the stamped names ride on the statement's sval2
    void StampCompoundTemps(Node e) {
        if (e == null || e.kind != AK.Assignment()) { return; }
        if (e.op == TK.Eq() || e.op == TK.QQEq()) { return; }
        Node t = e.a;
        if (t == null) { return; }
        int seq = ctmpSeq;
        if (t.kind == AK.Index()) {
            string ct = InferExprTyNg(t.a);
            if (ct == null || ct == "") { return; }
            string cn = "#ca" + seq;
            string inm = "#cb" + seq;
            ctmpSeq = seq + 1;
            AddLoc(cn, ct, false);
            AddLoc(inm, "int", false);
            e.sval2 = cn + "|" + inm;
        } else if (t.kind == AK.MemberAccess()) {
            string ct = InferExprTyNg(t.a);
            if (ct == null || ct == "") { return; }
            string cn = "#ca" + seq;
            ctmpSeq = seq + 1;
            // 批43:expanded 容器链的中转槽持"区域基址"(箱形指针值,
            // 非引用槽)—— 复合读改写经它落回父对象自身载荷;其余容器
            // 持求值结果
            AddLoc(cn, ct, false);
            e.sval2 = cn;
        }
    }

    // evaluate the compound-assign container and index exactly once into
    // their pre-reserved hidden slots (order: container, then index)
    void GenCompoundTemps(Node e) {
        Node t = e.a;
        string tns = e.sval2;
        int bar = tns.IndexOf("|");
        string cn = bar > 0 ? tns.Substring(0, bar) : tns;
        if (t.kind == AK.MemberAccess() && t.a != null && ChainIsExpanded(t.a)) {
            GenNestedRegionAddr(t.a);            // 批43:x0 = region base
        } else {
            GenExpr(t.a);
        }
        StoreLocal(LocalIdx(cn), 0);
        if (t.kind == AK.Index()) {
            GenExpr(t.b);
            StoreLocal(LocalIdx(tns.Substring(bar + 1)), 0);
        }
    }

    // the codegen twin of StampCompoundTemps: rewrite the compound assign
    // into one whose target reads the hidden slots (each evaluated once)
    Node FlatCompoundAssign(Node e) {
        if (e == null || e.kind != AK.Assignment()) { return null; }
        if (e.op == TK.Eq() || e.op == TK.QQEq()) { return null; }
        string tns = e.sval2;
        if (tns == null || tns == "") { return null; }
        Node t = e.a;
        int bar = tns.IndexOf("|");
        string cn = bar > 0 ? tns.Substring(0, bar) : tns;
        Node cident = new Node(AK.Ident());
        cident.sval = cn;
        Node nt = null;
        if (t.kind == AK.Index() && bar > 0) {
            Node iident = new Node(AK.Ident());
            iident.sval = tns.Substring(bar + 1);
            Node ni = new Node(AK.Index());
            ni.a = cident; ni.b = iident;
            nt = ni;
        } else if (t.kind == AK.MemberAccess()) {
            Node nm = new Node(AK.MemberAccess());
            nm.a = cident; nm.sval = t.sval;
            nt = nm;
        }
        if (nt == null) { return null; }
        Node flat = new Node(AK.Assignment());
        flat.op = e.op; flat.a = nt; flat.b = e.b;
        flat.line = e.line; flat.col = e.col;
        return flat;
    }

    int LocalIdx(string name) {
        int i = locHead;
        while (i >= 0) {
            if (locName[i] == name) { return i; }
            i = locPrev[i];
        }
        return -1;
    }

    void Epilogue() {
        if (tgt86 == 1) { XEpilogue(); return; }
        if (curThreadEntryNg == 1) {
            // [ThreadEntry]: reload x19-x28 from the slots below the locals.
            // sp resets from x29 first (a return from inside a switch/loop
            // can leave temporaries pushed); the slots sit at
            // [x29 - tentFrame, x29 - tentFrame + 96).
            E4(0x910003BF);                              // mov sp, x29
            int pr = 0;
            while (pr < 6) {
                int off = -tentFrame + pr * 16;
                int imm7 = (off / 8) & 127;
                int rt = 19 + pr * 2;
                E4(0xA9400000 | (imm7 << 15) | (31 << 5) | rt | ((rt + 1) << 10));
                pr = pr + 1;
            }
            E4(0xA8C17BFD);                              // ldp x29, x30, [sp], #16
            E4(0xD65F03C0);                              // ret
            return;
        }
        // reset sp from the frame pointer first: a `return` from inside a
        // switch/loop construct can leave its stack temporaries (e.g. the
        // switch discriminant) still pushed, and `add sp, sp, #frame` alone
        // would make the ldp below read x29/x30 from the wrong slot
        E4(0x910003BF);                                  // mov sp, x29
        E4(0xA8C17BFD);                                  // ldp x29, x30, [sp], #16
        E4(0xD65F03C0);                                  // ret
    }

    // ---- statements ----
    // label id for `goto name` / `name:`: ids are created on first
    // reference (forward gotos included) and reset per method
    int GotoLabelId(string name) {
        int i = gotoNames.Count - 1;
        while (i >= 0) {
            if (gotoNames[i] == name) { return gotoIds[i]; }
            i = i - 1;
        }
        int id = NL();
        gotoNames.Add(name);
        gotoIds.Add(id);
        return id;
    }

    void GenStmt(Node s) {
        if (s == null) { return; }
        int saved = EnterEnvNg(s);
        GenStmtInEnvNg(s);
        locHead = saved;
    }

    void GenStmtInEnvNg(Node s) {
        PrepareDelegateStmt(s);
        if (s.line > 0) { curLine = s.line; curCol = s.col; }
        // ngen_async hook B: a discarded async call statement detaches
        if (PrepareAsyncStmtNg(s)) { return; }
        int k = s.kind;
        if (k == AK.Block()) {
            int i = 0;
            while (i < s.kids.Count) { GenStmt(s.kids[i]); i = i + 1; }
        } else if (k == AK.VarDecl()) {
            if (s.b != null) {
                string vt = s.type != null ? TypeFullName(s.type) : null;
                if (vt == null || vt == "") { vt = InferExprTyNg(s.b); }   // silent: ReserveLocals already diagnosed
                if (!TryGenBindingValue(s.b, vt)) { GenConversionValueNg(s.b, vt); }
                StoreDeclValNg(s);
            }
            int dsi = 0;
            while (dsi < s.kids.Count) {
                Node d = s.kids[dsi];
                if (d.b != null) {
                    string dvt = d.type != null ? TypeFullName(d.type) : null;
                    if (dvt == null || dvt == "") { dvt = InferExprTyNg(d.b); }
                    if (!TryGenBindingValue(d.b, dvt)) { GenConversionValueNg(d.b, dvt); }
                    StoreDeclValNg(d);
                }
                dsi = dsi + 1;
            }
            if (s.b == null) {
                // `S x;` with S a struct: a fresh zero-filled value (gen0
                // zero-inits inline storage); a boxed word local still needs
                // its cell from the declaration point on; other types start
                // unassigned. A BOXED struct wraps the fresh value in the
                // shared cell -- later field writes go through it.
                Cls dc = s.type != null ? SpecClsOf(TypeFullName(s.type)) : null;
                if (dc != null && dc.isStruct == 1) {
                    int dslot = DeclSlotNg(s);
                    LoadImm(0, dc.size + 16);
                    LoadImm(1, 0);
                    BLInternal("_zan_rt_alloc");             // x0 = zeroed struct
                    if (LocBoxedNg(dslot)) {
                        XPushV0();                      // push struct
                        LoadImm(0, 8);
                        LoadImm(1, 0);
                        BLInternal("_zan_rt_alloc");         // x0 = cell
                        XPopV(1);                      // x1 = struct
                        StrU(1, 0, 0);                       // cell->struct
                    }
                    StoreLocal(dslot, 0);
                } else {
                    StoreDeclZeroCellNg(s);
                }
            }
        } else if (k == AK.ExprStmt()) {
            Node flat = FlatCompoundAssign(s.a);
            if (flat != null) { GenCompoundTemps(s.a); }
            GenExpr(flat != null ? flat : s.a);
        } else if (k == AK.LabelStmt()) {
            Mark(GotoLabelId(s.sval));
        } else if (k == AK.GotoStmt()) {
            EmitB(GotoLabelId(s.sval));
        } else if (k == AK.DeconDecl()) {
            GenDeconNg(s);
        } else if (k == AK.ReturnStmt()) {
            if (s.a != null) {
                GenConversionValueNg(s.a, curMeth != null ? TypeFullName(curMeth.type) : null);
            }
            XPushV0();                          // hold the result value
            EmitPendingFins(false);                  // C# runs every finally
            EhDisarmBase();                          // and disarms what they leave
            XPopV(0);
            Epilogue();
        } else if (k == AK.IfStmt()) {
            int els = NL(); int end = NL();
            GenExpr(s.a);
            EmitCBZ(0, els);
            GenStmt(s.b);
            EmitB(end);
            Mark(els);
            if (s.c != null) { GenStmt(s.c); }
            Mark(end);
        } else if (k == AK.SwitchStmt()) {
            GenSwitchStmt(s);
        } else if (k == AK.WhileStmt()) {
            int top = NL(); int outL = NL(); int cnt = NL();
            brkL.Add(outL); cntL.Add(cnt);
            brkLoop.Add(true); brkFinBase.Add(finBodies.Count);
            cntFinBase.Add(finBodies.Count);
            if (curHasTry) { LoadLocal(ehTopLocal, 0); StoreLocal(ehBrkLocal, 0); }
            Mark(top);
            GenExpr(s.a);
            EmitCBZ(0, outL);
            GenStmt(s.b);
            Mark(cnt);
            EmitB(top);
            Mark(outL);
            brkL.RemoveAt(brkL.Count - 1);
            cntL.RemoveAt(cntL.Count - 1);
            brkLoop.RemoveAt(brkLoop.Count - 1);
            brkFinBase.RemoveAt(brkFinBase.Count - 1);
            cntFinBase.RemoveAt(cntFinBase.Count - 1);
        } else if (k == AK.DoWhileStmt()) {
            // do body while (cond);: the continue point is the condition,
            // like the reference lowering (body -> cond -> branch)
            int top = NL(); int outL = NL(); int cnt = NL();
            brkL.Add(outL); cntL.Add(cnt);
            brkLoop.Add(true); brkFinBase.Add(finBodies.Count);
            cntFinBase.Add(finBodies.Count);
            if (curHasTry) { LoadLocal(ehTopLocal, 0); StoreLocal(ehBrkLocal, 0); }
            Mark(top);
            GenStmt(s.b);
            Mark(cnt);
            GenExpr(s.a);
            EmitCBZ(0, outL);
            EmitB(top);
            Mark(outL);
            brkL.RemoveAt(brkL.Count - 1);
            cntL.RemoveAt(cntL.Count - 1);
            brkLoop.RemoveAt(brkLoop.Count - 1);
            brkFinBase.RemoveAt(brkFinBase.Count - 1);
            cntFinBase.RemoveAt(cntFinBase.Count - 1);
        } else if (k == AK.ForStmt()) {
            // for (init; cond; step) body: init runs once, cond guards the
            // top, step runs at the continue point before looping back
            if (s.a != null) { GenStmt(s.a); }
            int top = NL(); int outL = NL(); int cnt = NL();
            brkL.Add(outL); cntL.Add(cnt);
            brkLoop.Add(true); brkFinBase.Add(finBodies.Count);
            cntFinBase.Add(finBodies.Count);
            if (curHasTry) { LoadLocal(ehTopLocal, 0); StoreLocal(ehBrkLocal, 0); }
            Mark(top);
            if (s.b != null) {
                GenExpr(s.b);
                EmitCBZ(0, outL);
            }
            GenStmt(s.d);
            Mark(cnt);
            if (s.c != null) { GenExpr(s.c); }
            EmitB(top);
            Mark(outL);
            brkL.RemoveAt(brkL.Count - 1);
            cntL.RemoveAt(cntL.Count - 1);
            brkLoop.RemoveAt(brkLoop.Count - 1);
            brkFinBase.RemoveAt(brkFinBase.Count - 1);
            cntFinBase.RemoveAt(cntFinBase.Count - 1);
        } else if (k == AK.ForeachStmt()) {
            GenForeach(s);
        } else if (k == AK.BreakStmt()) {
            if (brkL.Count == 0) {
                diags.Error("ngen: break outside loop", s.line, s.col);
            } else {
                EmitPendingFinsFrom(brkFinBase[brkFinBase.Count - 1], false);
                // a loop break also leaves every try opened inside the loop;
                // a switch break does not leave any try by itself
                if (brkLoop[brkLoop.Count - 1]) { EhDisarmLoop(); }
                EmitB(brkL[brkL.Count - 1]);
            }
        } else if (k == AK.ContinueStmt()) {
            if (cntL.Count == 0) {
                diags.Error("ngen: continue outside loop", s.line, s.col);
            } else {
                EmitPendingFinsFrom(cntFinBase[cntFinBase.Count - 1], false);
                EhDisarmLoop();
                EmitB(cntL[cntL.Count - 1]);
            }
        } else if (k == AK.TryStmt()) {
            GenTry(s);
        } else if (k == AK.LockStmt()) {
            GenLockStmt(s);
        } else if (k == AK.MonitorExitStmt()) {
            LoadLocal(DeclSlotNg(s.a), 0);
            BLExtern("_zan_monitor_exit");
        } else if (k == AK.ThrowStmt()) {
            GenThrow(s);
        } else {
            diags.Error("ngen: unsupported statement kind " + k, s.line, s.col);
        }
    }

    // foreach (T x in coll) body: collection re-evaluated each iteration
    // into a stack slot, hidden index local drives the bounds; arrays use
    // their -16 length header, lists the count field
    // ---- foreach over a user GetEnumerator protocol -------------------------
    // A collection class exposing a 0-arg GetEnumerator() drives the loop
    // through MoveNext()/Current instead of the legacy List layout (count@0,
    // data@16); Current works both as a 0-arg method and as a get_ accessor.

    int FeProtoMethodUp(string cls, string name, int wantPc) {
        string cur = cls;
        while (cur != null) {
            List<int> ms = MethCandsClsName(cur, name);
            if (ms != null) {
                int i = 0;
                while (i < ms.Count) {
                    if (methStat[ms[i]] != 2 && ParamCount(methNodes[ms[i]]) == wantPc) { return ms[i]; }
                    i = i + 1;
                }
            }
            Cls c = FindClass(cur);
            cur = c != null ? c.baseName : null;
        }
        return -1;
    }

    int FeProtoEnumMi(Node coll) {
        string ct = StaticTyOf(coll);
        if (ct == null || ct == "List" || ct == "Dict" || ct == "string") { return -1; }
        if (ct.IndexOf("<") > 0) { return -1; }
        Cls c = FindClass(ct);
        if (c == null || c.isStruct == 1) { return -1; }
        return FeProtoMethodUp(c.name, "GetEnumerator", 0);
    }

    int FeProtoCurMi(string enumCls) {
        int mi = FeProtoMethodUp(enumCls, "Current", 0);
        if (mi >= 0) { return mi; }
        return FeProtoMethodUp(enumCls, "get_Current", 0);
    }

    void GenForeach(Node s) {
        Node coll = s.b;
        int protoMi = FeProtoEnumMi(coll);
        if (protoMi >= 0) {
            string ec = methNodes[protoMi].type != null ? TypeFullName(methNodes[protoMi].type) : null;
            int mvMi = ec != null ? FeProtoMethodUp(ec, "MoveNext", 0) : -1;
            int cuMi = ec != null ? FeProtoCurMi(ec) : -1;
            int elemVar = DeclSlotNg(s);
            int top = NL(); int outL = NL(); int cnt = NL();
            int popOut = NL();
            brkL.Add(outL); cntL.Add(cnt);
            brkLoop.Add(true); brkFinBase.Add(finBodies.Count);
            cntFinBase.Add(finBodies.Count);
            if (curHasTry) { LoadLocal(ehTopLocal, 0); StoreLocal(ehBrkLocal, 0); }
            GenExpr(coll);
            BLInternal(MethSymNg(methCls[protoMi], methNodes[protoMi]));   // x0 = enumerator
            XPushV0();                          // push e (lives across the body)
            Mark(top);
            LdrU(0, 31, 0);
            BLInternal(MethSymNg(methCls[mvMi], methNodes[mvMi]));         // x0 = MoveNext
            CbzReg(0, popOut);
            LdrU(0, 31, 0);
            BLInternal(MethSymNg(methCls[cuMi], methNodes[cuMi]));         // x0 = element
            StoreLocal(elemVar, 0);
            GenStmt(s.c);
            Mark(cnt);
            EmitB(top);
            Mark(popOut);
            XPopV(0);                          // pop e
            EmitB(outL);
            Mark(outL);
            brkL.RemoveAt(brkL.Count - 1);
            cntL.RemoveAt(cntL.Count - 1);
            brkLoop.RemoveAt(brkLoop.Count - 1);
            brkFinBase.RemoveAt(brkFinBase.Count - 1);
            cntFinBase.RemoveAt(cntFinBase.Count - 1);
            return;
        }
        bool isArr = IsArrExpr(coll);
        // strings iterate as chars: the length header and byte loads
        bool isStr = !isArr && IsStrExpr(coll);
        int esz = isArr ? ArrElemSize(ArrTyOf(coll)) : 8;
        int elemVar = DeclSlotNg(s);
        int idxVar = elemVar + 1; // this foreach's reserved hidden index
        int top = NL(); int outL = NL(); int cnt = NL();
        brkL.Add(outL); cntL.Add(cnt);
        brkLoop.Add(true); brkFinBase.Add(finBodies.Count);
        cntFinBase.Add(finBodies.Count);
        if (curHasTry) { LoadLocal(ehTopLocal, 0); StoreLocal(ehBrkLocal, 0); }
        LoadImm(0, 0);
        StoreLocal(idxVar, 0);
        Mark(top);
        GenExpr(coll);
        XPushV0();                              // push coll
        if (isArr) {
            if (tgt86 == 1) { LdrU(2, 0, -16); } else { E4(0xF85F0002); }   // ldur x2, [x0, #-16] (len)
        } else if (isStr) {
            if (tgt86 == 1) {
                SubImm(2, 0, 8);                     // header: [s-8] 的高 32 位是 ZANS 魔数
                LdrU(2, 2, 0);
                X2(0x89, 0xD2);                      // mov edx,edx:32 位装回 rdx 即截掉魔数
            } else {
                E4(0xD1002002);                      // sub x2, x0, #8
                E4(0xF9400042);                      // ldr x2, [x2]
                E4(0xD3407C42);                      // ubfm x2, x2, #0, #31
            }
        } else {
            LdrU(2, 0, 0);                           // x2 = count
        }
        LoadLocal(idxVar, 0);                        // x0 = i (coll now only on the stack)
        if (tgt86 == 1) { Xop(0x39, 7, 2); } else { E4(0xEB02001F); }    // cmp i, len
        int popOut = NL();
        EmitBcond(10, popOut);                       // b.ge popOut (coll still pushed)
        if (isArr) {
            XPopV(2);                                // pop coll -> x2/rdx
            EmitArrElemLoad(esz, ArrElemName(ArrTyOf(coll)), 2, 0, 0);
        } else if (isStr) {
            XPopV(2);                                // pop coll -> x2/rdx
            if (tgt86 == 1) { X2(0x0F, 0xB6); X2(0x3C, 0x3A); } else { E4(0x38606840); }   // ldrb w0, [x2, x0]
        } else {
            LdrU(3, 31, 0);                          // x3 = coll (stack slot)
            LdrU(3, 3, 16);                          // x3 = data
            if (tgt86 == 1) { X3(0x48, 0x8B, 0x3C); X1(0xF9); } else { E4(0xF8607860); }   // ldr x0, [x3, x0, lsl #3]
            XPopV(2);                                // pop coll (discard)
        }
        StoreLocal(elemVar, 0);
        GenStmt(s.c);
        Mark(cnt);
        LoadLocal(idxVar, 0);
        AddImm(0, 0, 1);
        StoreLocal(idxVar, 0);
        EmitB(top);
        Mark(popOut);
        XPopV(2);                                    // pop coll (discard)
        EmitB(outL);
        Mark(outL);
        brkL.RemoveAt(brkL.Count - 1);
        cntL.RemoveAt(cntL.Count - 1);
        brkLoop.RemoveAt(brkLoop.Count - 1);
        brkFinBase.RemoveAt(brkFinBase.Count - 1);
        cntFinBase.RemoveAt(cntFinBase.Count - 1);
    }

    // ---- expressions: result in x0 ----
    // switch (disc) { case C: ... default: ... }: a compare chain like
    // gen0's constant lowering (the selfhost parser only produces constant
    // cases). The discriminant stays at [sp] for the whole statement; every
    // case body and the default arm end at the shared exit, where it is
    // popped. `break` inside a case targets the switch exit, not an
    // enclosing loop; `continue` keeps targeting the loop.
    // linear pattern switch: the scrutinee evaluates once and stays pushed;
    // each case in source order peeks at it, tests its pattern, binds, and
    // evaluates its `when` guard -- a match falls into the body. Bindings
    // are pre-stamped frame slots (StampPatternBindings); a miss peeks the
    // next case's test with the value intact.
    void GenPatternSwitchStmt(Node s) {
        int endL = NL();
        GenExpr(s.a);                                    // x0 = discriminant
        XPushV0();                                  // push discriminant
        string sst = StaticTyOf(s.a);
        brkL.Add(endL);
        brkLoop.Add(false); brkFinBase.Add(finBodies.Count);
        int i = 0;
        while (i < s.kids.Count) {
            Node c = s.kids[i];
            int nextL = NL();
            if (c.ival == 1 && c.type != null) {
                LdrU(0, 31, 0);                          // x0 = discriminant
                EmitTypeTestNg(TypeFullName(c.type), sst);
                EmitCBZ(0, nextL);                       // no match: next case
                if (c.sval != null && c.sval != "") {
                    int li = LocalIdx(c.sval);
                    if (li >= 0) {
                        LdrU(1, 31, 0);                  // x1 = discriminant
                        StoreLocal(li, 1);               // bind
                    }
                }
            } else if (c.ival == 1) {                    // `case null:`
                LdrU(1, 31, 0);                          // x1 = discriminant
                E4(0xEB1F003F);                          // cmp x1, xzr
                EmitCbnz(1, nextL);                      // non-null: next case
            } else if (c.a != null) {
                if (IsStrExpr(s.a)) {
                    GenExpr(c.a);                        // x0 = case label
                    LdrU(1, 31, 0);                      // x1 = discriminant
                    BLExtern("_strcmp");
                    if (tgt86 == 1) { X3(0x48, 0x83, 0xFF); X1(0x00); } else { E4(0xEB1F001F); }                      // cmp x0, xzr
                    EmitCbnz(0, nextL);                  // unequal: next case
                } else {
                    GenExpr(c.a);                        // x0 = case label
                    XPushV0();                      // push label
                    LdrU(1, 31, 16);                     // x1 = discriminant
                    XPopV(0);                      // pop label -> x0
                    CmpRR(0, 1);                      // cmp x0, x1
                    EmitBcond(1, nextL);                 // b.ne: next case
                }
            }
            // c.a == null && c.ival == 0 is `default:`: matches always
            if (c.c != null) {
                GenExpr(c.c);                            // `when` guard
                EmitCBZ(0, nextL);                       // false: next case
            }
            GenStmt(c.b);
            if (c.b == null || c.b.kids.Count > 0) { EmitB(endL); }
            Mark(nextL);
            i = i + 1;
        }
        brkL.RemoveAt(brkL.Count - 1);
        brkLoop.RemoveAt(brkLoop.Count - 1);
        brkFinBase.RemoveAt(brkFinBase.Count - 1);
        Mark(endL);
        XPopV(0);                                  // pop discriminant
    }

    void GenSwitchStmt(Node s) {
        // a pattern case (`case T x [when g]:`, `case null:`) forces the
        // linear form: tests run in source order, the first match takes its
        // body. Plain constant switches keep the jump-chain form below.
        int i = 0;
        while (i < s.kids.Count) {
            if (s.kids[i].ival == 1) { GenPatternSwitchStmt(s); return; }
            i = i + 1;
        }
        int endL = NL();
        int defL = NL();
        GenExpr(s.a);
        XPushV0();                                  // push discriminant
        int nc = s.kids.Count;
        int[] bodies = new int[nc];
        int defIdx = -1;
        i = 0;
        while (i < nc) {
            Node c = s.kids[i];
            if (c.a == null) { defIdx = i; i = i + 1; continue; }
            bodies[i] = NL();
            if (IsStrExpr(s.a)) {
                GenExpr(c.a);                            // x0 = case label
                LdrU(1, 31, 0);                          // x1 = discriminant
                BLExtern("_strcmp");
                if (tgt86 == 1) { X3(0x48, 0x83, 0xFF); X1(0x00); } else { E4(0xEB1F001F); }                          // cmp x0, xzr
            } else {
                GenExpr(c.a);                            // x0 = case label
                XPushV0();                          // push label
                LdrU(1, 31, 16);                         // x1 = discriminant
                XPopV(0);                          // pop label -> x0
                CmpRR(0, 1);                          // cmp x0, x1
            }
            EmitBcond(0, bodies[i]);                     // b.eq body
            i = i + 1;
        }
        EmitB(defIdx >= 0 ? defL : endL);
        brkL.Add(endL);
        brkLoop.Add(false); brkFinBase.Add(finBodies.Count);
        i = 0;
        while (i < nc) {
            Node c = s.kids[i];
            if (c.a == null) { i = i + 1; continue; }
            Mark(bodies[i]);
            GenStmt(c.b);
            // an empty case body falls through to the next case (C# rule);
            // only a body that emitted code needs the jump to the exit
            if (c.b == null || c.b.kids.Count > 0) { EmitB(endL); }
            i = i + 1;
        }
        if (defIdx >= 0) {
            Mark(defL);
            GenStmt(s.kids[defIdx].b);
            EmitB(endL);
        }
        brkL.RemoveAt(brkL.Count - 1);
        brkLoop.RemoveAt(brkLoop.Count - 1);
        brkFinBase.RemoveAt(brkFinBase.Count - 1);
        Mark(endL);
        XPopV(0);                                  // pop discriminant
    }

    void GenExpr(Node e) {
        int saved = EnterEnvNg(e);
        GenExprInEnvNg(e);
        locHead = saved;
    }

    // 缺口四 a: strtod in the emitter's own process, then a raw-memory
    // roundtrip turns the double (bits in x0 per the internal value
    // model) into the i64 immediate LoadImm emits directly.
    long DblBitsOf(string txt) {
        nint buf = NgenDblEnv.Alloc(8);
        Span<double> dv = new Span<double>(buf, 1);
        dv[0] = NgenDblEnv.StrToD(txt, 0);
        Span<long> lv = new Span<long>(buf, 1);
        long bits = lv[0];
        NgenDblEnv.Free(buf);
        return bits;
    }

    void GenExprInEnvNg(Node e) {
        // ngen_async hook A: `await <async call>` (root drive; diagnosed
        // inside an async body, where only statement-head awaits suspend)
        if (TryGenAwaitExprNg(e)) { return; }
        if (TryGenDelegateExpr(e)) { return; }
        if (TryGenStringRead(e)) { return; }
        int k = e.kind;
        if (k == AK.IntLit()) {
            // gen0's int-literal rule: an unsuffixed radix-2/8/16 literal in
            // the uint range types as int, so its runtime value is the
            // int-domain (two's-complement) one
            long v = e.ival;
            int sfx = e.suffix - (e.suffix / 4) * 4;
            int rad = e.suffix >= 16 ? 16 : (e.suffix >= 8 ? 8 : 0);
            if (sfx == 0 && rad != 0 && v > 2147483647 && v <= 4294967295) {
                v = v - 4294967296;
            }
            LoadImm(0, v);
        } else if (k == AK.NullLit()) {
            LoadImm(0, 0);
        } else if (k == AK.StringLit()) {
            if (IsTypeofNode(e)) { ReflLoadTypeofRec(e); }
            else { LoadStr(InternStr(DecodeLiteralNg(e.sval)), 0); }
        } else if (k == AK.BoolLit()) {
            LoadImm(0, e.ival);
        } else if (k == AK.CharLit()) {
            // a char is its codepoint in the value slot (rendering decides
            // string vs decimal per context, like gen0)
            LoadImm(0, e.ival);
        } else if (k == AK.FloatLit()) {
            // 缺口四 a: IEEE bits resolved at compile time and emitted as
            // a movz/movk immediate. The previous lazy `dbl.N` __DATA
            // slot (strtod on first load) only worked in the first object
            // of a link; later objects' slots stayed zero and the
            // conversion fired on a null literal-text pointer.
            LoadImm(0, DblBitsOf(e.sval));
        } else if (k == AK.ThisExpr() || k == AK.BaseExpr()) {
            LoadLocal(LocalIdx("this"), 0);
        } else if (k == AK.Ident()) {
            int li = LocalIdx(e.sval);
            if (li < 0) {
                // implicit field reference inside instance methods
                Fld fld = CurField(e.sval);
                if (fld != null) {
                    LoadLocal(LocalIdx("this"), 0);
                    Cls nxc = ExpandedStructOf(fld);
                    if (nxc != null) { MaterializeNestedBox(nxc, fld); }
                    else { LoadFieldNg(0, 0, fld); }
                    return;
                }
                // static field: the value lives in a data-global slot
                string ssym = FindStaticSym(curCls, e.sval);
                if (ssym != null) {
                    LoadSymRef(ssym, 0);
                    LdrU(0, 0, 0);
                    return;
                }
                // bare property read: the desugared get_Name accessor
                // (static tried first, then instance through `this`)
                Node bg = AccessorInChain(curCls, "get_" + e.sval);
                if (bg != null) {
                    if (HasMod(bg, MOD.Static())) {
                        LoadImm(0, 0);
                    } else {
                        LoadLocal(LocalIdx("this"), 0);
                    }
                    BLInternal(MethSymNg(accOwnerCls, bg));
                    return;
                }
                // out-of-block local read: the name still types method-wide
                // (NamedSlotTy), but the scoped slot lookup misses -- the
                // oracle's irgen falls back to constant 0 here, so field
                // reads on the null receiver guard to 0 (qa34 probe parity)
                if (DeclaredLocIdxNg(e.sval) >= 0) { LoadImm(0, 0); return; }
                diags.Error("ngen: unknown identifier '" + e.sval + "'", e.line, e.col);
                LoadImm(0, 0);
                return;
            }
            if (locRef[li]) {
                LoadLocal(li, 1);                            // slot holds an address
                LdrU(0, 1, 0);                               // read through it
                return;
            }
            LoadLocalVal(li, 0);
        } else if (k == AK.MemberAccess()) {
            if (e.ival == 1) {
                // null-conditional `a?.m`: the receiver is tested once and
                // a null short-circuits to the null of the result type; a
                // value-typed member result wraps into its cell on the
                // taken path (the reference spelling re-reads the receiver,
                // which the suite's pure receivers make unobservable)
                string qmt = StaticTyOf(e);
                string qpay = IsNulTy(qmt) ? NulPayOf(qmt) : null;
                GenExpr(e.a);                            // x0 = receiver
                int qnull = NL();
                int qfin = NL();
                CbzReg(0, qnull);
                e.ival = 0;                              // ordinary member read
                GenExpr(e);
                e.ival = 1;
                if (qpay != null) { GenNulWrap(IsDblTy(qpay)); }
                EmitB(qfin);
                Mark(qnull);
                LoadImm(0, 0);
                Mark(qfin);
                return;
            }
            if (TryGenHostMember(e)) { return; }
            if ((e.sval == "HasValue" || e.sval == "Value") && e.a != null
                    && IsNulTy(StaticTyOf(e.a))) {
                GenNulMemberRead(e);                     // nullable payload read
                return;
            }
            if (e.sval == "Count" && ExprCls(e.a) == "List") { GenListCount(e.a); }
            else if (e.sval == "Count" && ExprCls(e.a) == "Dict") { GenExpr(e.a); LdrU(0, 0, 0); }
            else if (e.sval == "Count" && IsDictViewAccess(e.a)) {
                GenListCount(e.a);                       // d.Keys.Count / d.Values.Count
            }
            else if ((e.sval == "Keys" || e.sval == "Values") && ExprCls(e.a) == "Dict") {
                // snapshot list: _zan_rt_dict_keys / _dict_values build a
                // List whose slots alias the dict's own keys/values
                GenExpr(e.a);
                BLInternal(e.sval == "Keys" ? "_zan_rt_dict_keys" : "_zan_rt_dict_values");
            }
            else if ((e.sval == "Length" || e.sval == "Count") && ArrContainerTy(e.a) != null) {
                // gen0: null report (reads the zeroed scratch afterwards),
                // length is the i64 count at arr-16; .Count is aliased to
                // .Length so a params bundle answers the List spelling too
                GenExpr(e.a);
                int badn = NL();
                int contn = NL();
                int donen = NL();
                CbzReg(0, badn);
                EmitB(contn);
                Mark(badn);
                LoadSymRef("l_.str." + guardFileIdx, 0);
                LoadImm(1, curLine);
                LoadImm(2, curCol);
                LoadSymRef("l_.str." + guardArrNull, 3);
                BLInternal("_zan_rt_guard_fail3");
                LoadImm(0, 0);
                EmitB(donen);
                Mark(contn);
                if (tgt86 == 1) { LdrU(0, 0, -16); } else { E4(0xF85F0000); }   // ldur x0, [x0, #-16] = mov rdi,[rdi-16]
                Mark(donen);
            }
            else if (e.sval == "Length" && IsStrExpr(e.a)) {
                // gen0 probes the SNAZ header: length lives in the low 32
                // bits of the i64 at s-8; a null string reports and answers 0
                GenExpr(e.a);
                int bads = NL();
                int conts = NL();
                int dones = NL();
                CbzReg(0, bads);
                EmitB(conts);
                Mark(bads);
                LoadSymRef("l_.str." + guardFileIdx, 0);
                LoadImm(1, curLine);
                LoadImm(2, curCol);
                LoadSymRef("l_.str." + guardStrNull, 3);
                BLInternal("_zan_rt_guard_fail3");
                LoadImm(0, 0);
                EmitB(dones);
                Mark(conts);
                E4(0xD1002009);                      // sub x9, x0, #8
                E4(0xF9400120);                      // ldr x0, [x9]
                E4(0xD3407C00);                      // ubfm x0, x0, #0, #31
                Mark(dones);
            }
            else if (e.a != null && e.a.kind == AK.Ident()
                    && FindEnumMemIdx(e.a.sval, e.sval) >= 0) {
                // EnumType.Member constant
                LoadImm(0, enVal[FindEnumMemIdx(e.a.sval, e.sval)]);
            }
            else if ((e.sval == "IsCompleted" || e.sval == "Result")
                    && TaskTyOfNg(e.a) != null) {
                GenTaskMemberRead(e);                    // property-style read
            }
            else if (GenReflPropRead(e)) {               // TypeInfo surface
            }
            else { GenFieldLoad(e); }
        } else if (k == AK.Binary() && e.op == TK.AmpAmp()) {
            // short-circuit AND: the right operand runs only when the left
            // is truthy; result normalises to 0/1
            int falsL = NL();
            int endL = NL();
            GenExpr(e.a);
            CbzReg(0, falsL);
            GenExpr(e.b);
            EmitB(endL);
            Mark(falsL);
            LoadImm(0, 0);
            Mark(endL);
        } else if (k == AK.Binary() && e.op == TK.PipePipe()) {
            int trueL = NL();
            int endL = NL();
            GenExpr(e.a);
            EmitCbnz(0, trueL);
            GenExpr(e.b);
            EmitB(endL);
            Mark(trueL);
            LoadImm(0, 1);
            Mark(endL);
        } else if (k == AK.Binary()) {
            if (TryOpOverloadNg(e)) {
                // the overload call left its result (value or object) in x0
            } else if (TryGenConversionBinaryNg(e)) {
            } else if (e.op == TK.QQ() && IsNulExpr(e.a)) {
                // nullable-value coalescing: the left side is a cell; the
                // result is a payload exactly when the right side is one
                int useB = NL();
                int doneQ = NL();
                bool resDbl = IsDblTy(NulPayOf(StaticTyOf(e.a)));
                GenExpr(e.a);
                CbzReg(0, useB);
                if (!IsNulExpr(e.b)) {
                    LdrU(0, 0, 0);                       // payload out of the cell
                    if (resDbl) { if (tgt86 == 1) { X3(0x66, 0x48, 0x0F); X2(0x6E, 0xC7); } else { E4(0x9E670000); } }      // fmov d0, x0
                } else if (resDbl && IsDblTy(NulPayOf(StaticTyOf(e.b)))) {
                    LdrU(0, 0, 0);                       // both cells: unwrap left
                    if (tgt86 == 1) { X3(0x66, 0x48, 0x0F); X2(0x6E, 0xC7); } else { E4(0x9E670000); }                      // fmov d0, x0
                }
                EmitB(doneQ);
                Mark(useB);
                GenExpr(e.b);
                if (IsNulExpr(e.b) && IsDblTy(NulPayOf(StaticTyOf(e.b)))) {
                    if (tgt86 == 1) { X3(0x66, 0x48, 0x0F); X2(0x6E, 0xC7); } else { E4(0x9E670000); }                      // fmov d0, x0 (cell -> payload)
                }
                Mark(doneQ);
            } else if (IsLiftedNulBinary(e)) {
                GenLiftedNulBinary(e);
            } else if (e.op == TK.QQ() && QQRefShapeNg(e.a) && !IsDblExpr(e.b)) {
                // null coalescing on reference shapes: a != null ? a : b
                int useB = NL();
                int doneQQ = NL();
                GenExpr(e.a);
                EmitCBZ(0, useB);
                EmitB(doneQQ);
                Mark(useB);
                GenExpr(e.b);
                Mark(doneQQ);
            } else if ((e.op == TK.EqEq() || e.op == TK.BangEq())
                    && StructEqPair(e.a, e.b) != null) {
                // struct equality without an overload: field-wise value
                // compare (gen0's aggregate equality; a pointer compare
                // would answer false for equal copies). Batch 32: the x86
                // arm rides the same helpers (LdrU/StringCmp/XSetV0cc)
                // with the two fmovs per-field for the double case.
                Cls sa = StructEqPair(e.a, e.b);
                if (sa != null) {
                    GenExpr(e.a);
                    XPushV0();                  // push a
                    GenExpr(e.b);
                    MovRR(1, 0);                     // x1 = b (a peeked below)
                    int neq = NL();
                    int doneq = NL();
                    // 批43:field-wise 对比走扁平叶(嵌套值字段的载荷
                    // 逐槽比较),合成 width-8 槽 Fld
                    List<Fld> flatEq = new List<Fld>();
                    FlatValueFields(sa, flatEq, 0, new List<string>());
                    int fi = 0;
                    while (fi < flatEq.Count) {
                        LoadFieldNg(2, 1, flatEq[fi]);     // b.f
                        LdrU(3, 31, 0);                  // a (batch 32: was raw ldur)
                        LoadFieldNg(3, 3, flatEq[fi]);     // a.f
                        if (IsDblTy(flatEq[fi].ty)) {
                            // floating fields compare with IEEE semantics:
                            // an unordered pair (NaN) counts as unequal, like
                            // the scalar == lowering
                            if (tgt86 == 1) { X3(0x66, 0x48, 0x0F); X2(0x6E, 0xC1); } else { E4(0x9E670060); }              // fmov d0, x3 / movq xmm0, rcx
                            if (tgt86 == 1) { X3(0x66, 0x48, 0x0F); X2(0x6E, 0xCA); } else { E4(0x9E670041); }              // fmov d1, x2 / movq xmm1, rdx
                            if (tgt86 == 1) { X3(0x66, 0x0F, 0x2F); X1(0xC8); } else { E4(0x1E602020); }              // fcmp d1, d0
                            EmitBcond(6, neq);           // b.vs -> unequal
                            EmitBcond(1, neq);           // b.ne -> unequal
                        } else {
                            StringCmp(3, 2);             // cmp x3, x2
                            EmitBcond(1, neq);           // b.ne
                        }
                        fi = fi + 1;
                    }
                    LoadImm(0, 1);
                    EmitB(doneq);
                    Mark(neq);
                    LoadImm(0, 0);
                    Mark(doneq);
                    AddSPImm(16, true);                  // drop a
                    if (e.op == TK.BangEq()) {
                        ExtCmpImm(0, 0);                 // cmp x0, #0 (batch 32: was raw 32-bit cmp)
                        if (tgt86 == 1) { X3(0x0F, 0x94, 0xC0); X3(0x48, 0x0F, 0xB6); X1(0xF8); } else { E4(0x9A9F17E0); }                  // cset x0, eq (1 = equal)
                    }
                }
            } else if (e.op == TK.Plus() && (IsStrExpr(e.a) || IsStrExpr(e.b))) {
                // string concatenation: non-string operands convert through
                // zan_rt_int2str (gen0 prints them with "%lld"), then
                // lhs -> x0, rhs -> x1, zan_rt_strcat2(lhs, rhs)
                if (IsNulExpr(e.a) && NulPayOf(StaticTyOf(e.a)) != null) {
                    GenNulToStr(e.a);                    // null renders ""
                } else {
                    GenExpr(e.a);
                    if (!IsStrExpr(e.a)) {
                        if (IsDblExpr(e.a)) { BLInternal("_zan_rt_dbl2str"); }
                        else if (IsCharExpr(e.a)) { BLInternal("_zan_rt_chrstr"); }
                        else if (IsUlongExpr(e.a)) { BLInternal("_zan_rt_uint2str"); }
                        else { BLInternal("_zan_rt_int2str"); }
                    }
                }
                XPushV0();                          // str x0, [sp, #-16]!
                if (IsNulExpr(e.b) && NulPayOf(StaticTyOf(e.b)) != null) {
                    GenNulToStr(e.b);                    // null renders ""
                } else {
                    GenExpr(e.b);
                    if (!IsStrExpr(e.b)) {
                        if (IsDblExpr(e.b)) { BLInternal("_zan_rt_dbl2str"); }
                        else if (IsCharExpr(e.b)) { BLInternal("_zan_rt_chrstr"); }
                        else if (IsUlongExpr(e.b)) { BLInternal("_zan_rt_uint2str"); }
                        else { BLInternal("_zan_rt_int2str"); }
                    }
                }
                if (tgt86 == 1) {
                    XPopV(1);                          // lhs -> v1 (rsi)
                    X3(0x49, 0x89, 0xFA);              // mov r10, rdi (rhs)
                    XMov(7, 6);                        // mov rdi, rsi (lhs)
                    X3(0x4C, 0x89, 0xD6);              // mov rsi, r10 (rhs)
                } else {
                    XPopV(1);                    // ldr x1, [sp], #16 (lhs)
                    E4(0xAA0003E9);                    // mov x9, x0
                    MovRR(0, 1);                    // mov x0, x1
                    E4(0xAA0903E1);                    // mov x1, x9
                }
                BLInternal("_zan_rt_strcat2");
            } else if (IsStrExpr(e.a) && IsStrExpr(e.b)
                    && (e.op == TK.EqEq() || e.op == TK.BangEq())) {
                // lexicographic equality via strcmp (gen0 parity)
                GenExpr(e.a);
                XPushV0();                      // push a
                GenExpr(e.b);
                if (tgt86 == 1) { XPopV(1); }             // pop a -> v1 (rsi)
                else { PopV(1); }                  // pop a -> x1 (x0 = b)
                BLInternal("_zan_rt_strcmp0");       // w0 = 0 iff equal
                if (tgt86 == 1) {
                    X3(0x48, 0x85, 0xFF);                // test rdi, rdi
                    X3(0x0F, 0x90 | (e.op == TK.EqEq() ? 4 : 5), 0xC0);  // sete/setne al
                    X3(0x0F, 0xB6, 0xF8);                // movzx edi, al
                } else {
