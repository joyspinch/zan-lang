                // delegate, an Action/Func variable) runs to completion
                // INLINE -- the cooperative model: Run returns only after
                // the body finishes, so Wait/IsCompleted read an
                // already-done task. The handle is the null frame.
                Node scall = new Node(AK.Call());
                scall.a = spt;
                scall.line = e.line; scall.col = e.col;
                if (TryGenDelegateCall(scall)) {
                    LoadImm(0, 0);
                    return;
                }
                if (spt.kind == AK.Lambda()) {
                    string ldt = StaticTyOf(spt);
                    PrepareDelegateValue(spt, ldt != null && IsDelegateTyNg(ldt) ? ldt : "Action");
                    if (TryGenDelegateExpr(spt)) {       // x0 = delegate value
                        int dlive = NL();
                        EmitCbnz(0, dlive);
                        LoadImm(0, 1);
                        BLExtern("_exit");               // null invocation fails closed
                        Mark(dlive);
                        LdrU(9, 0, 0);
                        LdrU(0, 0, 8);
                        E4(0xD63F0120);                  // blr x9
                        LoadImm(0, 0);                   // null frame: done
                        return;
                    }
