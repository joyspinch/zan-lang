            // ToDouble with one argument inline (stepping aside per member
            // when the program declares its own Convert member).
            if (recv != null && recv.kind == AK.Ident() && recv.sval == "Convert") {
                string mn = callee.sval;
                if (e.kids.Count == 1 && !UserDefinesClsMember("Convert", mn)) {
                    Node arg = e.kids[0];
                    if (mn == "ToString") {
                        // gen0's ordering: string -> owned copy, char ->
                        // the character, double -> shortest-round-trip
                        // text, ulong unsigned decimal, rest signed
                        if (IsStrExpr(arg)) {
                            GenExpr(arg);
                            XPushV0();              // push s
                            LoadStr(InternStr(""), 0);   // x0 = ""
                            XPopV(1);              // pop -> x1 (x0="", x1=s)
                            BLInternal("_zan_rt_strcat2");
                        } else if (IsCharExpr(arg)) {
                            GenExpr(arg);
                            BLInternal("_zan_rt_chrstr");
                        } else if (IsDblExpr(arg)) {
                            GenExpr(arg);
                            BLInternal("_zan_rt_dbl2str");
                        } else if (IsUlongExpr(arg)) {
                            GenExpr(arg);
                            BLInternal("_zan_rt_uint2str");
                        } else {
                            GenExpr(arg);
                            BLInternal("_zan_rt_int2str");
                        }
                        return;
                    }
                    if (mn == "ToInt32" || mn == "ToInt64" || mn == "ToInt") {
                        if (IsStrExpr(arg)) {
                            // strtoll(s, NULL, 10): full signed 64-bit
                            GenExpr(arg);
                            XPushV0();              // push s
                            LoadImm(1, 0);               // endptr = NULL
                            LoadImm(2, 10);
                            XPopV(0);              // pop -> x0 = s
                            BLExtern("_strtoll");
                        } else if (IsDblExpr(arg)) {
                            GenExpr(arg);
                            // C# Convert.ToInt* rounds to even; the host rints
                            // before the truncating conversion (TASKS.md A513)
                            if (tgt86 == 1) {
                                X3(0x66, 0x48, 0x0F); X2(0x6E, 0xC7);   // movq xmm0, rdi
                                BLExtern("_rint");
                                X3(0x66, 0x48, 0x0F); X2(0x7E, 0xC7);   // movq rdi, xmm0
                                X2(0xF2, 0x48); X2(0x0F, 0x2C); X1(0xF8);   // cvttsd2si rdi, xmm0
                            } else {
                                E4(0x9E670000);              // fmov d0, x0
                                BLExtern("_rint");
                                E4(0x9E660000);              // fmov x0, d0
                                E4(0x9E780000);              // fcvtzs x0, d0
                            }
                        } else {
                            GenExpr(arg);                // int slots are i64 already
                        }
                        return;
                    }
                    if (mn == "ToDouble") {
                        if (IsStrExpr(arg)) {
                            GenExpr(arg);
                            LoadImm(1, 0);               // endptr = NULL
                            BLInternal("_zan_rt_dbl_parse");
                            if (tgt86 == 1) {
                                X3(0x66, 0x48, 0x0F); X2(0x7E, 0xC7);   // movq rdi, xmm0
                            } else {
                                if (tgt86 == 1) { X3(0x66, 0x48, 0x0F); X2(0x7E, 0xC7); } else { E4(0x9E660000); }              // fmov x0, d0
                            }
                        } else if (IsDblExpr(arg)) {
                            GenExpr(arg);                // bits unchanged
                        } else {
                            GenExpr(arg);
                            if (tgt86 == 1) {
                                X2(0xF2, 0x0F); X2(0x2A, 0xC7);   // cvtsi2sd xmm0, rdi
                                X3(0x66, 0x48, 0x0F); X2(0x7E, 0xC7);   // movq rdi, xmm0
                            } else {
                                if (tgt86 == 1) { X4(0x2A0F48F2); X1(0xC7); } else { E4(0x9E620000); }              // scvtf d0, x0
                                if (tgt86 == 1) { X3(0x66, 0x48, 0x0F); X2(0x7E, 0xC7); } else { E4(0x9E660000); }              // fmov x0, d0
                            }
                        }
                        return;
                    }
                }
            }
            // File built-ins on the raw libc surface: string literals are
            // NUL-terminated heap text, so fopen/remove/access take them
            // directly. WriteAllText holds the FILE* in x20 (callee-saved
            // across the libc calls) and skips the write when fopen failed.
            if (recv != null && recv.kind == AK.Ident() && recv.sval == "File"
                    && !UserDefinesClsMember("File", callee.sval)) {
                if (callee.sval == "Exists" && e.kids.Count == 1) {
                    GenExpr(e.kids[0]);                  // path
                    LoadImm(1, 0);                       // F_OK
                    BLExtern("_access");
                    E4(0xF100001F);                      // cmp x0, #0
                    if (tgt86 == 1) { X3(0x0F, 0x95, 0xC0); X3(0x48, 0x0F, 0xB6); X1(0xF8); } else { E4(0x9A9F07E0); }                      // cset x0, eq
                    return;
                }
                if (callee.sval == "Delete" && e.kids.Count == 1) {
                    GenExpr(e.kids[0]);                  // path
                    BLExtern("_remove");
                    LoadImm(0, 0);                       // void call yields 0
                    return;
                }
                if (callee.sval == "WriteAllText" && e.kids.Count == 2) {
                    GenExpr(e.kids[0]);                  // path
                    XPushV0();                      // [sp] = path
                    GenExpr(e.kids[1]);                  // content
                    XPushV0();                      // [sp] = content, [sp+16] = path
                    LdrU(0, 31, 16);                     // path
                    LoadStr(InternStr("w"), 1);          // mode "w"
                    BLExtern("_fopen");
                    MovRR(20, 0);                      // mov x20, x0 (FILE*)
                    int hasf = NL(); int skipw2 = NL();
                    CbzReg(20, skipw2);                  // fopen failed: no write
                    Mark(hasf);
                    LdrU(0, 31, 0);                      // content
                    BLExtern("_strlen");
                    MovRR(2, 0);                      // mov x2, x0 (len)
                    LdrU(0, 31, 0);                      // content
                    LoadImm(1, 1);                       // size = 1
                    MovRR(3, 20);                      // mov x3, x20 (stream)
                    BLExtern("_fwrite");
                    MovRR(0, 20);                      // mov x0, x20
                    BLExtern("_fclose");
                    if (tgt86 == 1) { X2(0x48, 0x83); X2(0xC4, 0x20); } else { E4(0x910083FF); }                      // add sp, sp, #32
                    int donew2 = NL();
                    EmitB(donew2);
                    Mark(skipw2);
                    if (tgt86 == 1) { X2(0x48, 0x83); X2(0xC4, 0x20); } else { E4(0x910083FF); }                      // add sp, sp, #32 (fopen failed)
                    Mark(donew2);
                    LoadImm(0, 0);
                    return;
                }
            }
            // string.IsNullOrEmpty(s): a null pointer or a zero length
            // answers true (strings carry the length at ptr-8)
            if (recv != null && recv.kind == AK.Ident() && recv.sval == "string"
                    && callee.sval == "IsNullOrEmpty" && e.kids.Count == 1) {
                GenExpr(e.kids[0]);                  // s -> x0
                int emp = NL();
                int nonempty = NL();
                int doneIsne = NL();
                CbzReg(0, emp);                      // null -> empty
                if (tgt86 == 1) { LdrU(9, 0, -8); } else { E4(0xF85F8009); }   // ldur x9, [x0, #-8] (len)
                StringCmp(9, 31);                    // cmp x9, xzr
                EmitBcond(1, nonempty);              // b.ne: non-empty
                LoadImm(0, 1);                       // zero length -> true
                EmitB(doneIsne);
                Mark(nonempty);
                LoadImm(0, 0);                       // non-empty -> false
                EmitB(doneIsne);
                Mark(emp);
                LoadImm(0, 1);                       // null -> true
                Mark(doneIsne);
                return;
            }
            // X.Parse(s) for the numeric primitive types: gen0 fronts
            // strtoll for the integer forms and zan_rt_dbl_parse (strtod
            // with NaN/Infinity spellings) for the floating forms
            if (recv != null && recv.kind == AK.Ident() && callee.sval == "Parse"
                    && e.kids.Count == 1) {
                string rn = recv.sval;
                bool intRecv = rn == "int" || rn == "long" || rn == "Int32" || rn == "Int64";
                bool dblRecv = rn == "double" || rn == "float" || rn == "Double" || rn == "Single";
                if (intRecv || dblRecv) {
                    GenExpr(e.kids[0]);
                    if (intRecv) {
                        XPushV0();                  // push s
                        LoadImm(1, 0);                   // endptr = NULL
                        LoadImm(2, 10);
                        XPopV(0);                  // pop -> x0 = s
                        BLExtern("_strtoll");
                    } else {
                        LoadImm(1, 0);                   // endptr = NULL
                        BLInternal("_zan_rt_dbl_parse");
                        if (tgt86 == 1) { X3(0x66, 0x48, 0x0F); X2(0x7E, 0xC7); } else { E4(0x9E660000); }                  // fmov x0, d0
                    }
                    return;
                }
            }
            // double.TryParse(text, out v): _zan_rt_dbl_parse (strtod with
            // the NaN/Infinity spellings) through a real endptr; success is
            // endptr != text, and the parsed bits land in the out slot
            if (recv != null && recv.kind == AK.Ident()
                    && (recv.sval == "double" || recv.sval == "float")
                    && callee.sval == "TryParse" && e.kids.Count == 2) {
                GenRefArg(e.kids[1]);                    // x0 = out address
                XPushV0();                          // push addr
                GenExpr(e.kids[0]);                      // x0 = text
                XPushV0();                          // push text
                if (tgt86 == 1) { X2(0x48, 0x83); X2(0xEC, 0x10); } else { E4(0xD10043FF); }                          // sub sp, sp, #16 (endptr)
                LdrU(0, 31, 16);                         // text
                if (tgt86 == 1) { X2(0x48, 0x89); X1(0xE6); } else { E4(0x910003E1); }                          // add x1, sp, #0
                BLInternal("_zan_rt_dbl_parse");         // d0 = value
                if (tgt86 == 1) { X3(0x66, 0x48, 0x0F); X2(0x7E, 0xC7); } else { E4(0x9E660000); }                          // fmov x0, d0
                LdrU(1, 31, 32);                         // addr (above text + endptr)
                StrU(0, 1, 0);                           // *addr = parsed bits
                LdrU(1, 31, 0);                          // endptr
                LdrU(2, 31, 16);                         // text
                CmpRR(1, 2);                          // cmp x1, x2
                if (tgt86 == 1) { X3(0x0F, 0x95, 0xC0); X3(0x48, 0x0F, 0xB6); X1(0xF8); } else { E4(0x9A9F07E0); }                          // cset x0, ne (ok)
                if (tgt86 == 1) { X2(0x48, 0x83); X2(0xC4, 0x10); } else { E4(0x910043FF); }                          // add sp, sp, #16
                XPopV(0);                          // pop text
                XPopV(0);                          // pop addr
                return;
            }
            // scalar x.ToString("spec"): the printf-mapped render (spliced
            // from interpolation holes); non-scalar receivers dispatch to
            // user methods instead
            if (callee.sval == "ToString" && e.kids.Count == 1
                    && e.kids[0] != null && e.kids[0].kind == AK.StringLit()
                    && ScalarToStringTy(recv) != null) {
                GenScalarToStringFmt(e, recv, e.kids[0].sval);
                return;
            }
            // EnumType.TryParse(text, out value): compiler-lowered probe of
            // the declaration-order member names (gen0 parity), storing the
            // member constant through the out address
            if (callee.sval == "TryParse" && e.kids.Count == 2
                    && recv != null && recv.kind == AK.Ident()
                    && FindEnum(recv.sval) >= 0) {
                GenEnumTryParse(e);
                return;
            }
            // enum x.ToString(): member-name lookup with numeric fallback,
            // like gen0 (run before the scalar paths, which would render the
            // raw number)
            if (callee.sval == "ToString" && e.kids.Count == 0) {
                string et = EnumTyOf(recv);
                if (et != null) {
                    GenEnumToString(recv, et);
                    return;
                }
            }
            // scalar x.ToString(): gen0 routes these through the same
            // renderers as Console.Write (class receivers dispatch instead,
            // which ScalarToStringTy's null answer leaves to the fallthrough)
            if (callee.sval == "ToString" && e.kids.Count == 0
                    && ScalarToStringTy(recv) != null) {
                string sty = ScalarToStringTy(recv);
                if (sty == "bool") {
                    GenExpr(recv);
                    int fls = NL();
                    int doneb = NL();
                    CbzReg(0, fls);
                    LoadStr(InternStr("true"), 0);
                    EmitB(doneb);
                    Mark(fls);
                    LoadStr(InternStr("false"), 0);
                    Mark(doneb);
                } else if (sty == "string") {
                    GenExpr(recv);
                    XPushV0();                      // push s
                    LoadStr(InternStr(""), 0);           // x0 = ""
                    XPopV(1);                      // pop -> x1 (owned copy)
                    BLInternal("_zan_rt_strcat2");
                } else if (sty == "char") {
                    GenExpr(recv);
                    BLInternal("_zan_rt_chrstr");
                } else if (sty == "double") {
                    GenExpr(recv);
                    BLInternal("_zan_rt_dbl2str");
                } else if (sty == "ulong") {
                    GenExpr(recv);
                    BLInternal("_zan_rt_uint2str");
                } else {
                    GenExpr(recv);
                    BLInternal("_zan_rt_int2str");
                }
                return;
            }
            // generic-spec registration rewrites the callee to its mangled
            // spec name ("Remove$string"); the inline List/Dict lowering
            // recognizes bare operation names, so strip the instantiation
            // suffix ONLY for ops the inline lowering covers -- anything
            // else keeps its spec name for the spec/extension dispatchers
            if (recv != null && callee.sval != null) {
                int dlr = callee.sval.IndexOf("$");
                if (dlr > 0) {
                    string lcls = ExprCls(recv);
                    string bare = callee.sval.Substring(0, dlr);
                    if (lcls == "List" && ListOpKnown(bare, e.kids.Count)) {
                        callee.sval = bare;
                    } else if (lcls == "Dict" && DictOpKnown(bare, e.kids.Count)) {
                        callee.sval = bare;
                    }
                }
            }
            // List<T> built-ins (gen0-compatible inline sequences)
            if (ExprCls(recv) == "List") {
                if (callee.sval == "Add" && e.kids.Count == 1) {
                    GenListAdd(recv, e.kids[0]);
                    return;
                }
                if (callee.sval == "Clear" && e.kids.Count == 0) {
                    GenExpr(recv);
                    if (tgt86 == 1) { StrU(31, 0, 0); } else { E4(0xF900001F); }   // str xzr, [x0] (count = 0)
                    return;
                }
                if (callee.sval == "Contains" && e.kids.Count == 1) {
                    GenListFind(recv, e.kids[0], false);
                    return;
                }
                if (callee.sval == "Remove" && e.kids.Count == 1) {
                    GenListSearch(recv, e.kids[0], false, true);
                    return;
                }
                if (callee.sval == "RemoveAt" && e.kids.Count == 1) {
                    GenExpr(recv);
                    XPushV0();                  // push list
                    GenExpr(e.kids[0]);
                    MovRR(2, 0);                     // x2 = idx
                    XPopV(0);                  // pop list -> x0
                    MovRR(1, 2);                     // x1 = idx
                    BLInternal("_zan_rt_list_removeat");
                    return;
                }
                if (callee.sval == "Insert" && e.kids.Count == 2) {
                    GenExpr(recv);
                    XPushV0();                  // push list
                    GenExpr(e.kids[0]);              // idx
                    XPushV0();
                    GenExpr(e.kids[1]);              // value -> x0
                    MovRR(2, 0);                     // x2 = value
                    XPopV(1);                  // pop idx -> x1
                    XPopV(0);                  // pop list -> x0
                    BLInternal("_zan_rt_list_insert");
                    return;
                }
                if (callee.sval == "Reverse" && e.kids.Count == 0) {
                    GenExpr(recv);
                    BLInternal("_zan_rt_list_reverse");
                    return;
                }
                if (callee.sval == "Reserve" && e.kids.Count == 1) {
                    // pre-grow the backing buffer: no observable change
                    // beyond later Adds skipping a realloc
                    GenExpr(recv);
                    XPushV0();                  // push list
                    GenExpr(e.kids[0]);              // want -> x0
                    MovRR(1, 0);                     // x1 = want
                    XPopV(0);                  // pop list -> x0
                    BLInternal("_zan_rt_list_reserve");
                    return;
                }
                if (callee.sval == "IndexOf" && e.kids.Count == 1) {
                    GenListFind(recv, e.kids[0], true);
                    return;
                }
                if (callee.sval == "AddRange" && e.kids.Count == 1) {
                    GenExpr(recv);
                    XPushV0();                  // push dst
                    GenExpr(e.kids[0]);
                    MovRR(2, 0);                     // x2 = src
                    XPopV(0);                  // pop dst -> x0
                    MovRR(1, 2);                     // x1 = src
                    BLInternal("_zan_rt_list_addrange");
                    return;
                }
                if (callee.sval == "ToArray" && e.kids.Count == 0) {
                    GenExpr(recv);
                    // the result packs the STATIC element size (what arr[i]
                    // will read): float repacks into a real float[],
                    // long/double/string/object stay 8-wide, int/uint/char
                    // pack 4, short 2, bool/byte 1 -- the runtime face must
                    // match or the reads interleave with zeros
                    string rt = StaticTyOf(recv);
                    if (rt == "List<float>") { BLInternal("_zan_rt_list_toarray_f32"); return; }
                    string lel = (rt != null && rt.Length >= 6) ? rt.Substring(5, rt.Length - 6) : "object";
                    int aesz = ArrElemSize(lel + "[]");
                    if (aesz == 8) { BLInternal("_zan_rt_list_toarray"); }
                    else if (aesz == 4) { BLInternal("_zan_rt_list_toarray4"); }
                    else if (aesz == 2) { BLInternal("_zan_rt_list_toarray2"); }
                    else { BLInternal("_zan_rt_list_toarray1"); }
