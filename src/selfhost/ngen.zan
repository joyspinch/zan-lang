                        // the character, double -> shortest-round-trip
                        // text, ulong unsigned decimal, rest signed
                        if (IsStrExpr(arg)) {
                            GenExpr(arg);
                            XPushV0();              // push s
                            LoadStr(InternStr(""), 0);   // x0 = ""
                            XPopV(1);              // pop -> x1 (x0="", x1=s)
                            BLInternal("_zan_rt_strcat2");
                        } else if (IsCharExpr(arg)) {
                            GenExpr(arg);
                            BLInternal("_zan_rt_chrstr");
                        } else if (IsDblExpr(arg)) {
                            GenExpr(arg);
                            BLInternal("_zan_rt_dbl2str");
                        } else if (IsUlongExpr(arg)) {
                            GenExpr(arg);
                            BLInternal("_zan_rt_uint2str");
                        } else {
                            GenExpr(arg);
                            BLInternal("_zan_rt_int2str");
                        }
                        return;
                    }
                    if (mn == "ToInt32" || mn == "ToInt64" || mn == "ToInt") {
                        if (IsStrExpr(arg)) {
                            // strtoll(s, NULL, 10): full signed 64-bit
                            GenExpr(arg);
                            XPushV0();              // push s
                            LoadImm(1, 0);               // endptr = NULL
                            LoadImm(2, 10);
                            XPopV(0);              // pop -> x0 = s
                            BLExtern("_strtoll");
                        } else if (IsDblExpr(arg)) {
                            GenExpr(arg);
                            if (tgt86 == 1) {
                                X3(0x66, 0x48, 0x0F); X2(0x6E, 0xC7);   // movq xmm0, rdi
                                X2(0xF2, 0x48); X2(0x0F, 0x2C); X1(0xF8);   // cvttsd2si rdi, xmm0
                            } else {
                                if (tgt86 == 1) { X3(0x66, 0x48, 0x0F); X2(0x6E, 0xC7); } else { E4(0x9E670000); }              // fmov d0, x0
                                E4(0x9E780000);              // fcvtzs x0, d0
                            }
