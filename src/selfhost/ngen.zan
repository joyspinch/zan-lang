            // and mirrors that here (joining a string[] crashes gen0's own
            // runtime, so the List form is the only shape to match).
            if (recv != null && recv.kind == AK.Ident() && recv.sval == "string"
                    && callee.sval == "Join" && e.kids.Count == 2) {
                GenExpr(e.kids[1]);                      // list
                XPushV0();                          // push list
                GenExpr(e.kids[0]);                      // sep
                XPopV(1);                                // pop list -> x1 (x0 = sep)
                BLInternal("_zan_rt_strjoin");
                return;
            }
