                // extension dispatchers (Enumerable.Sum(this List<double>)
                // resolves by receiver fit; gen0's member lookup answers the
                // same way)
            }
            // Dictionary<string, T> built-ins on a dict receiver: set/add,
            // contains/remove/query/clear route to the runtime helpers.
            // Unknown operations fall through to the extension dispatchers,
            // so the gate checks the op name before any emission
            if (ExprCls(recv) == "Dict" && DictOpKnown(callee.sval, e.kids.Count)) {
                if (!DictCheckType(recv)) { return; }
                if (e.kids.Count > 0) { DictCheckOperand(recv, e.kids[0], true); }
                if (callee.sval == "Add" && e.kids.Count == 2) {
                    DictCheckOperand(recv, e.kids[1], false);
                    // dict.Add(key, value): receiver under the args so a
                    // nested call inside any operand cannot clobber the
                    // dict; value pushes first, then key, then the dict
                    GenExpr(e.kids[1]);              // value -> x0
                    GenCloneIfStruct(e.kids[1]);     // struct values: fresh box
                    XPushV0();                  // push value
                    GenExpr(e.kids[0]);              // key -> x0
                    XPushV0();                  // push key
                    GenExpr(recv);                   // dict -> x0
                    XPushV0();                  // push dict
                    RtDictSet3();
                    return;
                }
                if (callee.sval == "ContainsKey" && e.kids.Count == 1) {
                    GenExpr(recv);
                    XPushV0();                  // push dict
                    GenExpr(e.kids[0]);              // key -> x0
                    MovRR(1, 0);                     // x1 = key
                    XPopV(0);                  // pop dict -> x0
                    BLInternal("_zan_rt_dict_contains");
                    return;
                }
                if (callee.sval == "Remove" && e.kids.Count == 1) {
                    GenExpr(recv);
                    XPushV0();                  // push dict
                    GenExpr(e.kids[0]);              // key -> x0
                    MovRR(1, 0);                     // x1 = key
                    XPopV(0);                  // pop dict -> x0
                    BLInternal("_zan_rt_dict_remove");
                    return;
                }
