                    XPushV0();                      // push a
                    GenExpr(e.kids[1]);
                    XPopV(1);                      // pop a -> x1 (x0 = b)
                    if (tgt86 == 1) { X3(0x66, 0x48, 0x0F); X2(0x6E, 0xCF); } else { E4(0x9E670001); }                      // fmov d1, x0
                    MovRR(0, 1);                      // mov x0, x1
                    if (tgt86 == 1) { X3(0x66, 0x48, 0x0F); X2(0x6E, 0xC7); } else { E4(0x9E670000); }                      // fmov d0, x0
                    BLExtern("_pow");
                    if (tgt86 == 1) { X3(0x66, 0x48, 0x0F); X2(0x7E, 0xC7); } else { E4(0x9E660000); }                      // fmov x0, d0
                    return;
                }
                if (mn == "Atan2" && e.kids.Count == 2) {
                    GenExpr(e.kids[0]);
                    if (!IsDblExpr(e.kids[0])) {
                        if (tgt86 == 1) { X4(0x2A0F48F2); X1(0xC7); } else { E4(0x9E620000); }                  // scvtf d0, x0
                        if (tgt86 == 1) { X3(0x66, 0x48, 0x0F); X2(0x7E, 0xC7); } else { E4(0x9E660000); }                  // fmov x0, d0
                    }
                    XPushV0();                      // push y
                    GenExpr(e.kids[1]);
                    if (!IsDblExpr(e.kids[1])) {
                        if (tgt86 == 1) { X4(0x2A0F48F2); X1(0xC7); } else { E4(0x9E620000); }                  // scvtf d0, x0
                        if (tgt86 == 1) { X3(0x66, 0x48, 0x0F); X2(0x7E, 0xC7); } else { E4(0x9E660000); }                  // fmov x0, d0
                    }
                    XPopV(1);                      // pop y -> x1 (x0 = x)
                    if (tgt86 == 1) { X3(0x66, 0x48, 0x0F); X2(0x6E, 0xCF); } else { E4(0x9E670001); }                      // fmov d1, x0 (x)
                    MovRR(0, 1);                      // mov x0, x1
                    if (tgt86 == 1) { X3(0x66, 0x48, 0x0F); X2(0x6E, 0xC7); } else { E4(0x9E670000); }                      // fmov d0, x0 (y)
                    BLExtern("_atan2");
                    if (tgt86 == 1) { X3(0x66, 0x48, 0x0F); X2(0x7E, 0xC7); } else { E4(0x9E660000); }                      // fmov x0, d0
