                    CbzReg(20, skipw2);                  // fopen failed: no write
                    Mark(hasf);
                    LdrU(0, 31, 0);                      // content
                    BLExtern("_strlen");
                    MovRR(2, 0);                      // mov x2, x0 (len)
                    LdrU(0, 31, 0);                      // content
                    LoadImm(1, 1);                       // size = 1
                    MovRR(3, 20);                      // mov x3, x20 (stream)
                    BLExtern("_fwrite");
                    MovRR(0, 20);                      // mov x0, x20
                    BLExtern("_fclose");
                    if (tgt86 == 1) { X2(0x48, 0x83); X2(0xC4, 0x20); } else { E4(0x910083FF); }                      // add sp, sp, #32
                    int donew2 = NL();
                    EmitB(donew2);
                    Mark(skipw2);
                    if (tgt86 == 1) { X2(0x48, 0x83); X2(0xC4, 0x20); } else { E4(0x910083FF); }                      // add sp, sp, #32 (fopen failed)
