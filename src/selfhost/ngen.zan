using System;
using System.Collections.Generic;
namespace Zan;

// Ngen: native backend slice (M1). Emits arm64 machine code directly from the
// bound AST — no LLVM IR text, no clang. The object container (Mach-O) lives
// in ngen_macho.zan.
//
// Instruction words are stored as 32-bit two's-complement ints: Zan hex
// literals above 0x7FFFFFFF wrap, but the bit pattern survives the wrap and
// byte extraction takes the low 32 bits.
//
// Kernel subset: static methods, int params/locals/returns, int literals,
// `+ - * <`, if/while, plain calls (recursion ok), Console.WriteLine(int).
// Anything else is a compile error, not a silent fallback.

// Open-addressed string -> insertion-ordered bucket index over the method
// tables. Our builtin Dictionary is a linear walk (_zan_rt_dict_index), so
// it cannot speed up the very scans it appears in; this table gives O(1)
// key probes. Buckets chain in append order, so iteration inside a bucket
// matches the old flat table scan exactly.
// 缺口四 a: compile-time decimal -> IEEE-754 bits for float literals.
// The emitter calls libc strtod in its own process (the P/Invoke stub
// hands the result bits back in x0 under the internal value model),
// parks them in a raw 8-byte buffer, and re-reads them as an i64
// immediate. Replaces the lazy `dbl.N` __DATA slot: only the first
// object of a link ever ran its static initialization, so every later
// object's slots stayed zero and the lazy conversion fired on a null
// literal-text pointer (the batch-8 float-value crashes).
public class NgenDblEnv {
    [DllImport("crt", EntryPoint="strtod")] public static extern double StrToD(string s, long endp);
    [DllImport("crt", EntryPoint="malloc")] public static extern nint Alloc(int size);
    [DllImport("crt", EntryPoint="free")] public static extern void Free(nint p);
}

public class MethIndex {
    List<string> keys;
    List<int> head;
    List<int> tail;
    List<int> entVal;
    List<int> entNext;
    List<int> slots;

    public MethIndex() {
        keys = new List<string>();
        head = new List<int>();
        tail = new List<int>();
        entVal = new List<int>();
        entNext = new List<int>();
        slots = new List<int>();
        int i = 0;
        while (i < 4096) { slots.Add(-1); i = i + 1; }
    }

    int HashOf(string s) {
        int h = 17;
        int i = 0;
        while (i < s.Length) { h = h * 31 + (int)s[i] + 1; i = i + 1; }
        if (h < 0) { h = 0 - h; }
        if (h < 0) { h = 0; }
        return h;
    }

    // find-or-insert the key id
    int KeyId(string k) {
        int n = slots.Count;
        int j = HashOf(k) % n;
        while (slots[j] >= 0) {
            if (keys[slots[j]] == k) { return slots[j]; }
            j = j + 1;
            if (j == n) { j = 0; }
        }
        int id = keys.Count;
        keys.Add(k);
        head.Add(-1);
        tail.Add(-1);
        slots[j] = id;
        if (keys.Count * 2 >= n) { Rehash(); }
        return id;
    }

    void Rehash() {
        List<string> oldKeys = keys;
        slots = new List<int>();
        int n = oldKeys.Count * 8 + 1;
        int i = 0;
        while (i < n) { slots.Add(-1); i = i + 1; }
        int q = 0;
        while (q < oldKeys.Count) {
            int j = HashOf(oldKeys[q]) % n;
            while (slots[j] >= 0) { j = j + 1; if (j == n) { j = 0; } }
            slots[j] = q;
            q = q + 1;
        }
    }

    public void Add(string k, int v) {
        int id = KeyId(k);
        int e = entVal.Count;
        entVal.Add(v);
        entNext.Add(-1);
        if (tail[id] < 0) { head[id] = e; } else { entNext[tail[id]] = e; }
        tail[id] = e;
    }

    // method indices for k in insertion order, or null on miss
    public List<int> Get(string k) {
        int n = slots.Count;
        int j = HashOf(k) % n;
        while (slots[j] >= 0) {
            if (keys[slots[j]] == k) {
                List<int> r = new List<int>();
                int e = head[slots[j]];
                while (e >= 0) { r.Add(entVal[e]); e = entNext[e]; }
                return r;
            }
            j = j + 1;
            if (j == n) { j = 0; }
        }
        return null;
    }
}

public class Fixup {
    public int pos;    // text offset of the patched instruction
    public int kind;   // 0=B 1=CBZ 2=Bcond 3=BL-internal 4=BL-extern 5=TBZ/TBNZ
    public int lbl;    // label id (kinds 0-2)
    public int cond;   // cond code (kind 2)
    public string sym; // target symbol (kinds 3-4)
    public Fixup(int p, int k, int l, int c, string s) {
        pos = p; kind = k; lbl = l; cond = c; sym = s;
    }
}

public class StrRef {
    public int adrpPos;  // text offset of the adrp instruction
    public int addPos;   // text offset of the add/ldr instruction
    public string sym;   // target symbol name (l_.str.N / l_.g.NAME / __stdinp)
    public int got;      // 1: adrp + ldr through the homemade __nl_symbol_ptr
                         //    slot (dylib data symbols)
    public StrRef(int a, int b, string s) { adrpPos = a; addPos = b; sym = s; got = 0; }
}

public class Sym {
    public string name;  // link-time symbol name (underscore prefixed)
    public int pos;      // text offset of the definition
    public Sym(string n, int p) { name = n; pos = p; }
}

partial class Ngen {
    Diags diags;

    List<int> txt;          // __text bytes
    List<Sym> syms;         // defined symbols (one per method)
    List<Fixup> fixups;     // branch/call fixups
    List<StrRef> strRefs;   // string address references (adrp+add pairs)
    List<string> strs;      // __cstring entries
    List<int> lblPos;       // label id -> text pos (-1 while open)
    List<int> brkL;         // innermost-enclosing-loop break targets
    List<Node> finBodies;   // enclosing try/finally bodies, innermost last
    List<int> finInHandler; // 1 once that try's frame is conceptually disarmed
    List<int> ehStack;      // try frames open in this activation (compile time)
    List<bool> brkLoop;     // brkL[i] belongs to a loop (vs a switch)
    List<int> brkFinBase;   // finallys base for each break target
    List<int> cntFinBase;   // finallys base at each loop's continue point
    int finCur = -1;        // index of the finally body being emitted right now
    List<int> finActive;    // indices of finally bodies currently being emitted
    int lockSeq = 0;        // unique temp names for lowered lock statements
    List<int> cntL;         // innermost-enclosing-loop continue targets
    List<string> gotoNames; // label names seen in the method being emitted
    List<int> gotoIds;      // label id per name (created on first reference)
    bool curHasTry;         // method being emitted contains a try anywhere
    int ehTopLocal;         // #ehtop: mirror of the runtime EH top
    int ehBaseLocal;        // #ehbase: top at the outermost open try's arm
    int ehBrkLocal;         // #ehbrk: top at loop entry (break/continue disarm)
    List<Node> clauseExcNodes; // catch clauses, in reserve order: a bare
                               // `throw;` rethrows the innermost open
                               // clause's OWN exception, not the mutable
                               // in-flight global (a nested try inside the
                               // clause body overwrites the global)
    List<int> clauseExcSlots;  // frame slot per clause holding its exception
    List<int> clauseExcOpen;   // slots of the clauses whose bodies are being
                               // emitted, innermost last
    int ctmpSeq;            // hidden single-eval temps for compound assigns
    bool dbgEh = false;     // temporary: trace EH arm (7M+depth) and rethrow
                            // (8M+runtime top) through zan_rt_print_int

    string curCls;
    int stTyDepth;          // StaticTyOf recursion guard: cyclic static-type
                            // chains bottom out as unknown, never hang
    int extRetDepth;        // ExtRetTy recursion guard
    List<string> locName;   // locals of the method being emitted
    List<string> locTy;     // declared type name per local ("" for this/params of unknown)
    List<int> locOff;       // frame offset (bytes from sp)
    List<bool> locRef;      // by-ref slots (out/ref params): the slot holds an address
    List<int> locBoxed;     // lambda-written slots: the slot holds a shared heap
                            // cell (A33-2b), reads and writes go through it
    List<Node> spanSites;   // view-construction sites (batch 12): each owns a
                            // private 16-byte frame box for its {base,len} pair
    List<int> spanSiteOff;  // frame offset of each site's box (parallel list)
    List<string> boxNames;  // names any nested lambda assigns (per method)
    List<string> boxCaptured; // names any nested lambda reads (per method)
    List<string> boxOuterWrote; // names the method body itself assigns
    List<int> boxParamSlots; // param frame slots boxed this method (prologue
                             // wraps the incoming value in a shared cell)
    List<int> paramSlotsNg;  // frame slots of the method's own parameters, in
                             // declaration order (boxable capture targets)
    List<Node> patStamped;  // pattern nodes whose bindings were pre-stamped
    List<int> locOpaq;      // string slot holding an extern-call result: no
                            // length header, no trusted NUL bound (the stdlib
                            // slices readdir's struct dirent* byte by byte)
    // A persistent lexical environment is a chain of declaration slots.
    // Every AST node records its visible chain before emission, so sibling
    // scopes and re-emitted finally bodies never borrow one another's types.
    List<Node> locDecl;
    List<int> locPrev;
    List<Node> envNodes;
    List<int> envHeads;
    int locHead = -1;
    int nloc;
    int frame;
    int nlabel;
    int curLine;
    int curCol;
    int guardDivIdx;
    int guardModIdx;
    int guardFileIdx;
    int guardStrIdx;
    int guardSubIdx;
    int guardListIdx;
    int guardArrIdx;
    int guardSpanIdx;
    int guardArrNeg;
    int guardArrOvf;
    int guardArrFail;
    int guardArrNull;
    int guardStrNull;
    int guardNulVal;
    string srcFile;
    // baked embed resources (embedres parity): when a carried module's data
    // pack ships in the stdlib, the pack is interned into __cstring and the
    // zan_embed_* read API is defined in this object so the program serves
    // its own table (the shipped crt-transition stub answers 0 / NULL)
    int embedDataIdx = -1;
    int embedNameIdx = -1;
    int embedEmptyIdx = -1;
    int embedDataLen = 0;
    public static string StdlibRoot;   // set by main.zan before codegen

    List<Node> methNodes;
    List<string> methCls;
    List<int> methStat;     // 0 = instance, 1 = static, 2 = ctor
    // incremental indexes over methNodes. Big inputs (Chart/Gui families)
    // made every call-site resolution walk the whole method table
    // (O(sites x methods)); lookups now touch only same-shape candidates.
    // Buckets append in table order, so iteration inside a bucket matches
    // the old flat scan exactly. Everything goes through AddMethNg so an
    // append can never bypass the indexes.
    MethIndex mIdxClsName;   // cls | name -> indices
    MethIndex mIdxName;      // name -> indices
    MethIndex mIdxCls;       // cls -> indices
    string mainCls;
    string designMainCls;
    bool mainAsync;     // Main is async: the shim ramps + pumps instead of calling it
    Node curMeth;           // method being emitted (spec sval2 = this type)
    int curThreadEntryNg;   // current method is [ThreadEntry]: x19-x28 saved
    int tentFrame;          // its total sp reservation (frame + 96 save bytes)
    Node specScanMeth;      // method RunSpecPipeline is scanning: a bare
                            // generic call inside a scanned spec body
                            // inherits the body's receiver instantiation
                            // (curMeth is emission-only, null during the scan)

    List<string> enName;    // enum type name per declaration
    List<int> enOff;        // start index into the flat member arrays
    List<int> enCnt;        // member count
    List<string> enMem;     // flat member names
    List<long> enVal;       // flat member constants (C# running counter)

    public Ngen(Binder b, Diags d, string file) {
        diags = d;
        layoutBinder = b;
        srcFile = file;
        tgt86 = EnvTargetX86();
        txt = new List<int>();
        syms = new List<Sym>();
        fixups = new List<Fixup>();
        strRefs = new List<StrRef>();
        strs = new List<string>();
        lblPos = new List<int>();
        brkL = new List<int>();
        finBodies = new List<Node>();
        finInHandler = new List<int>();
        finActive = new List<int>();
        cntL = new List<int>();
        gotoNames = new List<string>();
        gotoIds = new List<int>();
        ehStack = new List<int>();
        clauseExcNodes = new List<Node>();
        clauseExcSlots = new List<int>();
        clauseExcOpen = new List<int>();
        brkLoop = new List<bool>();
        brkFinBase = new List<int>();
        cntFinBase = new List<int>();
        methNodes = new List<Node>();
        methCls = new List<string>();
        methStat = new List<int>();
        mIdxClsName = new MethIndex();
        mIdxName = new MethIndex();
        mIdxCls = new MethIndex();
        specMeth = new List<string>();
        instCls = new List<string>();
        ctorSpecKey = new List<string>();
        ctorSpecSym = new List<string>();
        nlabel = 0;
    }

    // single mutation point for the method tables so the indexes can never
    // fall behind the flat lists
    void AddMethNg(Node m, string cls, int stat) {
        methNodes.Add(m);
        methCls.Add(cls);
        methStat.Add(stat);
        int i = methNodes.Count - 1;
        mIdxClsName.Add(cls + "|" + m.sval, i);
        mIdxName.Add(m.sval, i);
        mIdxCls.Add(cls, i);
    }

    List<int> MethCandsClsName(string cls, string name) {
        if (cls != null) {
            int lt = cls.IndexOf("<");
            if (lt > 0 && cls.Substring(cls.Length - 1, 1) == ">") {
                cls = cls.Substring(0, lt);
            }
        }
        return mIdxClsName.Get(cls + "|" + name);
    }

    List<int> MethCandsName(string name) {
        return mIdxName.Get(name);
    }

    List<int> MethCandsCls(string cls) {
        if (cls != null) {
            int lt = cls.IndexOf("<");
            if (lt > 0 && cls.Substring(cls.Length - 1, 1) == ">") {
                cls = cls.Substring(0, lt);
            }
        }
        return mIdxCls.Get(cls);
    }

    // ---- entry: returns the object file bytes ----
    public List<int> Gen(Node unit) {
        int i = 0;
        while (i < unit.kids.Count) {
            Node dcl = unit.kids[i];
            if (dcl.kind == AK.ClassDecl() || dcl.kind == AK.StructDecl()) { CollectMethods(dcl); }
            i = i + 1;
        }
        CollectClasses(unit);
        CollectEnums(unit);
        RunSpecPipeline();
        MaterializeInstStatics();
        // one lazy vtable slot per polymorphic class (the table itself is
        // built by _vtinit_<Cls> at first `new`)
        int ci = 0;
        while (ci < classes.Count) {
            if (classes[ci].poly == 1) {
                dglbs.Add(new DGlob("vt." + classes[ci].name, 8, dataLen));
                dataLen = dataLen + 8;
            }
            ci = ci + 1;
        }
        EmitRtCore();
        guardDivIdx = InternStr("division by zero\n");
        guardModIdx = InternStr("division by zero (modulo)\n");
        // gen0 bakes guard sites with the source path shortened to its
        // last two components ("selfhost/kernel10.zan")
        string gfile = srcFile;
        int lastSlash = -1;
        int prevSlash = -1;
        int si = srcFile.IndexOf("/");
        while (si >= 0) { prevSlash = lastSlash; lastSlash = si; si = srcFile.IndexOf("/", si + 1); }
        if (lastSlash >= 0 && prevSlash >= 0) {
            gfile = srcFile.Substring(prevSlash + 1, srcFile.Length - prevSlash - 1);
        }
        guardFileIdx = InternStr(gfile);
        guardStrIdx = InternStr("string index out of bounds\n");
        guardSubIdx = InternStr("substring index out of bounds\n");
        guardListIdx = InternStr("list index out of bounds\n");
        guardArrIdx = InternStr("array index out of bounds\n");
        guardSpanIdx = InternStr("span range out of bounds\n");
        guardArrNeg = InternStr("negative array length\n");
        guardArrOvf = InternStr("array allocation overflow\n");
        guardArrFail = InternStr("array allocation failed\n");
        guardArrNull = InternStr("null reference where an array is required (.Length)\n");
        guardStrNull = InternStr("null reference where a string is required\n");
        guardNulVal = InternStr("Nullable object must have a value\n");
        embedEmptyIdx = InternStr("");
        // gen0 auto-bakes (main.c): a program carrying the Pinyin module
        // gets the stdlib pinyin table as resource "text/pinyin.txt", and
        // its own zan_embed_* definitions make File.EmbedExists/EmbedRead
        // find it with nothing beside the exe
        if (StdlibRoot != null && StdlibRoot.Length > 0 && FindClass("Pinyin") != null) {
            string pk = StdlibRoot + "/System/Text/data/pinyin.txt";
            if (File.Exists(pk)) {
                string packed = File.ReadAllText(pk);
                embedNameIdx = InternStr("text/pinyin.txt");
                embedDataIdx = InternStr(packed);
                embedDataLen = packed.Length;
                dglbs.Add(new DGlob("embed.gtbl", 8, dataLen));
                dataLen = dataLen + 8;
                dglbs.Add(new DGlob("embed.gcnt", 8, dataLen));
                dataLen = dataLen + 8;
            }
        }
        if ((mainCls == null || mainCls == "") && (designMainCls != null && designMainCls != "")) {
            mainCls = designMainCls;
        }
        if (mainCls != null && mainCls != "") {
            if (embedDataIdx >= 0) { EmitEmbedApiNg(); }
            EmitMainShim();
        }
        int mi = 0;
        while (mi < methNodes.Count) {
            // batch 12: a view cannot be RETURNED -- the site's frame box
            // dies at return and the caller would hold a dangling address.
            // (Parameters are fine: a caller frame outlives any synchronous
            // callee, so the pass-down box stays valid for the whole call --
            // runtime_core's sched256/sched512 pass views this way.)
            Node sm = methNodes[mi];
            if (sm.type != null && SpanTyNg(TypeFullName(sm.type))) {
                diags.Error("ngen: a Span view cannot be a return type (its frame box dies at return); return the backing array and build a local view", 0, 0);
            }
            // generic declarations are templates: only their
            // specializations carry bodies (RunSpecPipeline built them)
            if (!HasTypeParams(methNodes[mi]) && !HasMod(methNodes[mi], MOD.Extern())) {
                // ngen_async hook D: an async method emits its ramp + $resume
                // state machine instead of an ordinary body
                if (IsAsync(methNodes[mi])) {
                    EmitAsyncMethodNg(methCls[mi], methNodes[mi], mi);
                } else {
                    EmitMethod(methCls[mi], methNodes[mi], mi);
                }
            }
            mi = mi + 1;
        }
        ci = 0;
        while (ci < classes.Count) {
            // batch 12: no Span fields (the C# ref-struct rule) -- a view
            // stored in an object would outlive its method's frame
            int fsi = 0;
            while (fsi < classes[ci].flds.Count) {
                if (SpanTyNg(classes[ci].flds[fsi].ty)) {
                    diags.Error("ngen: a Span view cannot be a field (ref-struct shape); keep views in locals", 0, 0);
                }
                fsi = fsi + 1;
            }
            if (classes[ci].poly == 1) { EmitVtInit(classes[ci]); }
            ci = ci + 1;
        }
        // batch 12: no Span-typed statics either (C# CS8345: a ref struct
        // cannot be a field). The old heap-box representation made them
        // merely immortal; frame boxes would make them dangling, and the
        // ref-struct shape is the language rule either way. The 缺口二
        // read/write capability retires with this diagnostic; the codebase
        // never used it (runtime_core's 静态只存块指针 style predates it).
        int sfi = 0;
        while (sfi < sfTy.Count) {
            if (SpanTyNg(sfTy[sfi])) {
                diags.Error("ngen: a Span view cannot be a static field (ref-struct shape); store the backing block and build a local view at each use", 0, 0);
            }
            sfi = sfi + 1;
        }
        if (tgt86 == 1) {
            // batch 32: delegate thunks join the x86 tail (the invoke path
            // was batch-32-washed and every delegate creation interns
            // through _zan_dlg_intern, so the thunks must emit here or the
            // symbol fails to resolve). The string pool is data-only and
            // required by every literal reference; batch 19 adds the EH
            // class-name lookup the uncaught tail and typed catch dispatch
            // need. 批41:packed byte 切片(_zan_packed_slice_str)全原语
            // 已双车道化(唯一的裸 E4 ldrb 换 ExtLdrbImm),stdlib 字符串
            // 排序在 x86 车道不再链接失败;binding 访问器与反射仍不发射
            // ——需要它们的程序按批32 诚实策略链接期报缺,不跑外来字节。
            EmitDelegateThunks();
            while (mi < methNodes.Count) {
                if (!HasTypeParams(methNodes[mi]) && !HasMod(methNodes[mi], MOD.Extern())) {
                    if (IsAsync(methNodes[mi])) {
                        EmitAsyncMethodNg(methCls[mi], methNodes[mi], mi);
                    } else {
                        EmitMethod(methCls[mi], methNodes[mi], mi);
                    }
                }
                mi = mi + 1;
            }
            EmitClsNameFn();
            HostEmitPackedSlice();
            RtEmitStrpool();
            Patch();
            return BuildMachO();
        }
        EmitDelegateThunks();
        EmitBindingAccessors();
        while (mi < methNodes.Count) {
            if (!HasTypeParams(methNodes[mi]) && !HasMod(methNodes[mi], MOD.Extern())) {
                if (IsAsync(methNodes[mi])) {
                    EmitAsyncMethodNg(methCls[mi], methNodes[mi], mi);
                } else {
                    EmitMethod(methCls[mi], methNodes[mi], mi);
                }
            }
            mi = mi + 1;
        }
        HostEmitPackedSlice();
        EmitClsNameFn();
        EmitReflApi();
        RtEmitStrpool();
        Patch();
        return BuildMachO();
    }

    void CollectMethods(Node cls) {
        int i = 0;
        bool hasCtor = false;
        while (i < cls.kids.Count) {
            Node m = cls.kids[i];
            if (m.kind == AK.MethodDecl()) {
                // ngen_async hook E: async methods join the signature tables
                // (their ramps are call targets); an async Main is driven by
                // the entry shim (hook F) instead of a direct call
                if (HasMod(m, MOD.Extern())) { CheckExternNg(m); }
                if (m.sval == "Main" && HasMod(m, MOD.Static()) && !HasMod(m, MOD.Extern())) {
                    mainCls = cls.sval;
                    mainAsync = IsAsync(m);
                } else if (m.sval == "__DesignMain" && HasMod(m, MOD.Static()) && !HasMod(m, MOD.Extern())) {
                    designMainCls = cls.sval;
                }
                AddMethNg(m, cls.sval, HasMod(m, MOD.Static()) ? 1 : 0);
            }
            if (m.kind == AK.CtorDecl()) {
                // `static T()` is a type initializer (methStat 3), not a
                // constructor: it takes no `this`, is never selected by
                // `new T(...)`, and runs once at program entry in
                // declaration order (gen0 parity)
                if (!HasMod(m, MOD.Static())) { hasCtor = true; }
                AddMethNg(m, cls.sval, HasMod(m, MOD.Static()) ? 3 : 2);
            }
            i = i + 1;
        }
        // a class with no declared ctors gets the synthesized parameterless
        // one, which is what runs its instance field initializers (and the
        // base chain) when `new T()` finds it
        if (!hasCtor) {
            Node dc = new Node(AK.CtorDecl());
            dc.mods = HasMod(cls, MOD.Static()) ? MOD.Static() : 0;
            AddMethNg(dc, cls.sval, 2);
        }
    }

    bool HasMod(Node m, int flag) { return (m.mods / flag) - ((m.mods / flag) / 2) * 2 == 1; }
    bool IsAsync(Node m) { return HasMod(m, MOD.Async()); }

    // Same raw C name as Irgen.ExternName; Mach-O adds exactly one '_'.
    string ExternSymNg(Node m) {
        return "_" + (m.sval2 != null && m.sval2 != "" ? m.sval2 : m.sval);
    }

    // Types an extern can take or return, matched to the oracle zanc ABI as
    // probed from its arm64 codegen: integer-class values (pointers, nint,
    // narrow ints) pass in x/w registers; float/double take the independent
    // v0-v7 fp registers (AAPCS64: ldexp(3.5, 3) emits fmov d0 + mov w0);
    // arrays pass their data pointer exactly like strings (element 0 sits at
    // the array value itself, length at value-16).
    bool ExternTyNg(string t) {
        if (t == "string" || t == "int" || t == "long") { return true; }
        if (t == "nint" || t == "UIntPtr" || t == "ulong" || t == "uint") { return true; }
        if (t == "short" || t == "ushort" || t == "byte" || t == "sbyte"
                || t == "char" || t == "bool") { return true; }
        if (t == "float" || t == "double") { return true; }
        // delegates pass as their closure value: a pointer to the
        // {thunk, env} block, an ordinary integer-class word
        if (IsDelegateTyNg(t)) { return true; }
        return IsArrTy(t);
    }

    bool ExternFpTy(string t) { return t == "float" || t == "double"; }

    // Span<T> raw-memory view (binder builtin generic; gen0
    // irgen_expr.c emit_struct_elem_ptr span path): `new Span<T>(base, len)`
    // holds a raw pointer and element i sits at base + i*esz, bounds-checked
    // against the view length. A view VALUE is a {base, len} pair. Batch 12:
    // every construction materializes the pair in a private 16-byte FRAME
    // box (one per construction site, reserved in the prologue) instead of
    // the old malloc'd heap box, and a store into a declared Span local
    // copies the pair (value semantics -- the C# ref-struct shape: no
    // fields, no captures, no heap escape, no per-call leak).
    bool IsSpanNew(Node e) {
        return e != null && e.kind == AK.NewExpr() && e.type != null
            && e.type.sval == "Span" && e.kids != null && e.kids.Count == 2;
    }

    // the generation-side dispatch for a view-construction expression. Must
    // mirror GenNew's Span branch and the two GenSpanView call guards in
    // GenCall (recv = the member-access receiver) exactly, or a site's box
    // lookup desyncs from its reserved slot. The collector runs BEFORE
    // codegen opens any scope, so a local receiver resolves through the
    // whole slot table (NamedSlotTy), not the scope chain: over-collecting
    // a site only wastes a slot, missing one is a hard error at generation.
    bool SpanViewSite(Node e) {
        if (e == null) { return false; }
        if (IsSpanNew(e)) { return true; }
        if (e.kind != AK.Call() || e.a == null
                || e.a.kind != AK.MemberAccess()) { return false; }
        Node rv = e.a.a;
        if (rv == null) { return false; }
        bool isAs = e.a.sval == "AsSpan" && e.kids.Count <= 2;
        bool isSl = e.a.sval == "Slice" && e.kids.Count >= 1
            && e.kids.Count <= 2;
        if (!isAs && !isSl) { return false; }
        if (rv.kind == AK.Ident()) {
            string nt = NamedSlotTy(rv.sval);
            if (nt != null) {
                if (isAs && IsArrTy(nt)) { return true; }
                if (isSl && nt.IndexOf("Span<") == 0) { return true; }
                return false;
            }
        }
        if (isAs && ArrContainerTy(rv) != null) { return true; }
        if (isSl && SpanContainerTy(rv) != null) { return true; }
        return false;
    }

    // pre-order collection of the method's view-construction sites. Lambda
    // bodies are separate frames: the delegate prologue runs its own
    // collection pass over the body.
    void CollectSpanViews(Node n) {
        if (n == null || n.kind == AK.Lambda()) { return; }
        if (SpanViewSite(n)) { spanSites.Add(n); spanSiteOff.Add(0); }
        int i = 0;
        while (i < n.kids.Count) { CollectSpanViews(n.kids[i]); i = i + 1; }
        CollectSpanViews(n.a); CollectSpanViews(n.b);
        CollectSpanViews(n.c); CollectSpanViews(n.d);
    }

    // reserve one 16-byte frame box per collected site; called after every
    // named local and the EH slots are in, before the frame size commits
    void ReserveSpanBoxes() {
        int i = 0;
        while (i < spanSites.Count) {
            AddLoc(".spansite" + i, "long", false);
            spanSiteOff[i] = locOff[nloc - 1];
            i = i + 1;
        }
    }

    // x0 = the construction site's private frame box
    void SpanSiteBox(Node e) {
        int si = 0;
        while (si < spanSites.Count) {
            if (spanSites[si] == e) { break; }
            si = si + 1;
        }
        if (si >= spanSites.Count) {
            diags.Error("ngen: span view site missing from the frame map", curLine, curCol);
            LoadImm(0, 0);
            return;
        }
        LoadImm(0, LocFpOff(spanSiteOff[si]));
        AddRR(0, 29, 0);
    }

    bool SpanTyNg(string t) {
        return t != null && t.IndexOf("Span<") == 0;
    }

    string SpanElemTy(Node sn) {
        if (sn.type != null && sn.type.kids != null && sn.type.kids.Count > 0) {
            return TypeFullName(sn.type.kids[0]);
        }
        return "long";
    }

    int SpanElemSize(Node sn) {
        string el = SpanElemTy(sn);
        if (el == "byte" || el == "sbyte") { return 1; }
        if (el == "short" || el == "ushort" || el == "char") { return 2; }
        if (el == "int" || el == "uint" || el == "float") { return 4; }
        return 8;
    }

    // element type/size of a declared "Span<T>" type-name string
    string SpanTyElem(string st) {
        int p = st.IndexOf("<");
        if (p < 0) { return "long"; }
        return st.Substring(p + 1, st.Length - p - 2);
    }
    int SpanTyElemSize(string st) {
        string el = SpanTyElem(st);
        if (el == "byte" || el == "sbyte") { return 1; }
        if (el == "short" || el == "ushort" || el == "char") { return 2; }
        if (el == "int" || el == "uint" || el == "float") { return 4; }
        return 8;
    }

    // declared Span<T> type of a plain local, field or static used as an
    // indexing target (`Span<byte> sp; sp[i]`), or null. The view's value is
    // a boxed {base, len} pair (the oracle's 2-field struct, one 16-byte
    // allocation per view -- views are short-lived, leak-by-design like the
    // interned delegates), so accesses through these views bounds-check like
    // arrays. Statics (bare and class-qualified) mirror ArrContainerTy.
    string SpanContainerTy(Node e) {
        if (e == null) { return null; }
        if (e.kind == AK.Ident()) {
            int li = LocalIdx(e.sval);
            if (li >= 0 && locTy[li] != null && locTy[li].IndexOf("Span<") == 0) { return locTy[li]; }
            Fld f = CurField(e.sval);
            if (f != null && f.ty != null && f.ty.IndexOf("Span<") == 0) { return f.ty; }
            string st = FindStaticTy(curCls, e.sval);
            if (st != null && st.IndexOf("Span<") == 0) { return st; }
            return null;
        }
        if (e.kind == AK.MemberAccess()) {
            Fld f = FieldOf(e);
            if (f != null && f.ty != null && f.ty.IndexOf("Span<") == 0) { return f.ty; }
            // class-qualified static view (`Va2c.sview[0]`): the receiver
            // must NAME a class, the same guard as the static write path --
            // a plain local receiver (`bb.view`) is an instance field
            if (e.a != null && e.a.kind == AK.Ident() && LocalIdx(e.a.sval) < 0
                    && FindClass(e.a.sval) != null) {
                string sq = FindStaticTy(QualifiedCls(e.a.sval, e.a.sval2), e.sval);
                if (sq != null && sq.IndexOf("Span<") == 0) { return sq; }
            }
        }
        return null;
    }

    // x0 = element at [x1 base + x0 idx * esz], shaped to the internal value
    // convention (narrow ints extended, float/double as bit patterns)
    void EmitSpanElemLoad(string el, int esz) {
        if (tgt86 == 1) {
            // base v1 -> r10, idx v0 -> r11, result lands in r10 then v0
            // (the EmitArrElemLoad slot-dst byte forms, batch 34)
            XGetV(1, 10); XGetV(0, 11);
            if (el == "byte") { X3(0x47, 0x0F, 0xB6); X2(0x14, 0x1A); }        // movzx r10d, byte [r10+r11]
            else if (el == "sbyte") { X3(0x4F, 0x0F, 0xBE); X2(0x14, 0x1A); }  // movsx r10, byte [r10+r11]
            else if (el == "short") { X3(0x4F, 0x0F, 0xBF); X2(0x14, 0x5A); }  // movsx r10, word [r10+r11*2]
            else if (el == "ushort" || el == "char") { X3(0x47, 0x0F, 0xB7); X2(0x14, 0x5A); }   // movzx r10d, word [r10+r11*2]
            else if (el == "int") { X3(0x4F, 0x63, 0x14); X1(0x9A); }          // movsxd r10, dword [r10+r11*4]
            else if (el == "uint") { X3(0x47, 0x8B, 0x14); X1(0x9A); }         // mov r10d, [r10+r11*4]
            else if (el == "float") {
                X3(0xF3, 0x43, 0x0F); X3(0x10, 0x04, 0x9A);                    // movss xmm0, [r10+r11*4]
                X3(0xF3, 0x0F, 0x5A); X1(0xC0);                                // cvtss2sd xmm0, xmm0
                X3(0x66, 0x49, 0x0F); X2(0x7E, 0xC2);                          // movq r10, xmm0
            } else if (el == "double") {
                X3(0x4F, 0x8B, 0x14); X1(0xDA);                                // mov r10, [r10+r11*8]
            } else if (esz == 4) { X3(0x4F, 0x63, 0x14); X1(0x9A); }
            else { X3(0x4F, 0x8B, 0x14); X1(0xDA); }                           // mov r10, [r10+r11*8]
            XSetV(0, 10);
            return;
        }
        if (el == "byte") { E4(0x38606820); return; }          // ldrb w0, [x1, x0]
        if (el == "sbyte") { E4(0x38A06820); return; }         // ldrsb x0, [x1, x0]
        if (el == "short") { E4(0x78A07820); return; }         // ldrsh x0, [x1, x0, lsl #1]
        if (el == "ushort" || el == "char") { E4(0x78607820); return; }    // ldrh w0, [x1, x0, lsl #1]
        if (el == "int") { E4(0xB8A07820); return; }           // ldrsw x0, [x1, x0, lsl #2]
        if (el == "uint") { E4(0xB8607820); return; }          // ldr w0, [x1, x0, lsl #2]
        if (el == "float") {
            E4(0xBC607820);                                    // ldr s0, [x1, x0, lsl #2]
            E4(0x1E22C000);                                    // fcvt d0, s0
            if (tgt86 == 1) { X3(0x66, 0x48, 0x0F); X2(0x7E, 0xC7); } else { E4(0x9E660000); }                                    // fmov x0, d0
            return;
        }
        if (el == "double") {
            E4(0xFC607820);                                    // ldr d0, [x1, x0, lsl #3]
            if (tgt86 == 1) { X3(0x66, 0x48, 0x0F); X2(0x7E, 0xC7); } else { E4(0x9E660000); }                                    // fmov x0, d0
            return;
        }
        if (esz == 4) { E4(0xB8A07820); return; }
        E4(0xF8607820);                                        // ldr x0, [x1, x0, lsl #3]
    }

    // [x1 base + x0 idx * esz] = x3 (value register), shaped from the
    // internal value convention
    void EmitSpanElemStore(string el, int esz) {
        if (tgt86 == 1) {
            // 值 -> r11、基址 -> r10、下标 -> rdx(v0 的真寄存器),lea 定址
            // 后单指令存储;float 先在 xmm0 收窄再落 r11 (batch 34)
            XGetV(1, 10);
            XGetV(0, 2);
            if (esz == 1) { X4(0x12148D4D); }                      // lea r10, [r10 + rdx*1]
            else if (esz == 2) { X4(0x52148D4D); }                 // lea r10, [r10 + rdx*2]
            else if (esz == 4) { X4(0x92148D4D); }                 // lea r10, [r10 + rdx*4]
            else { X4(0xD2148D4D); }                               // lea r10, [r10 + rdx*8]
            if (el == "float") {
                XGetV(3, 10);
                X3(0x66, 0x48, 0x0F); X2(0x6E, 0xC2);              // movq xmm0, rdx
                X3(0xF2, 0x0F, 0x5A); X1(0xC0);                    // cvtsd2ss xmm0, xmm0
                X3(0x66, 0x0F, 0x7E); X1(0xC2);                    // movd edx, xmm0
                X1(0x89); X1(0x12);                                // mov [r10], edx
                return;
            }
            XGetV(3, 11);
            if (esz == 1) { X3(0x45, 0x88, 0x1A); }                // mov [r10], r11b(rm=r10 需 B)
            else if (esz == 2) { X3(0x66, 0x45, 0x89); X1(0x1A); } // mov [r10], r11w(批37b:0x44 缺 B——rm=010 解码成 rdx,写错址)
            else if (esz == 4) { X3(0x45, 0x89, 0x1A); }           // mov [r10], r11d
            else { X3(0x4D, 0x89, 0x1A); }                         // mov [r10], r11
            return;
        }
        if (el == "byte" || el == "sbyte") { E4(0x38206823); return; }     // strb w3, [x1, x0]
        if (el == "short" || el == "ushort" || el == "char") { E4(0x78207823); return; }   // strh w3, [x1, x0, lsl #1]
        if (el == "int" || el == "uint") { E4(0xB8207823); return; }       // str w3, [x1, x0, lsl #2]
        if (el == "float") {
            E4(0x9E670064);                                    // fmov d4, x3
            E4(0x1E624084);                                    // fcvt s4, d4
            E4(0xBC207824);                                    // str s4, [x1, x0, lsl #2]
            return;
        }
        if (el == "double") {
            E4(0x9E670064);                                    // fmov d4, x3
            E4(0xFC207824);                                    // str d4, [x1, x0, lsl #3]
            return;
        }
        if (esz == 4) { E4(0xB8207823); return; }
        E4(0xF8207823);                                        // str x3, [x1, x0, lsl #3]
    }

    // span index bounds guard: x0 = idx, x1 = base, x2 = len on entry.
    // `keep` names one more live register (0 = none, e.g. the value of an
    // element store) that rides the stack beneath idx. On the good path
    // nothing changes; on the bad path the site reports and the access
    // answers 0 / stores nothing (soft runtime, like the array guard).
    void SpanIdxGuard(int line, int col, int keep) {
        int sbad = NL();
        int scont = NL();
        if (tgt86 == 1) { Xop(0x39, 7, 2); } else { E4(0xEB02001F); }                          // cmp x0, x2
        EmitBcond(10, sbad);                     // b.ge bad
        if (tgt86 == 1) { X3(0x48, 0x83, 0xFF); X1(0x00); } else { E4(0xEB1F001F); }                          // cmp x0, xzr
        EmitBcond(11, sbad);                     // b.lt bad
        EmitB(scont);
        Mark(sbad);
        XPushR(1);                          // keep base (guard clobbers x1)
        XPushV0();                          // keep idx
        if (keep > 0) { XPushR(keep); } // keep the live value
        LoadSymRef("l_.str." + guardFileIdx, 0);
        LoadImm(1, line);
        LoadImm(2, col);
        LoadSymRef("l_.str." + guardArrIdx, 3);
        BLInternal("_zan_rt_guard_fail3");
        if (keep > 0) { XPopV(keep); }
        XPopV(0);                          // pop idx
        XPopV(1);                          // pop base
        LoadImm(0, 0);
        Mark(scont);
    }

    // pop the view box, load base/len: entry [sp] = box, x0 = idx; exit
    // x1 = base, x2 = len, x0 = idx (the box is dropped -- leak-by-design)
    void SpanBoxDeref() {
        XPopV(1);                          // pop box -> x1
        LdrU(2, 1, 8);                           // x2 = len
        LdrU(1, 1, 0);                           // x1 = base
    }

    // arr.AsSpan([start[,len]]) / span.Slice(start[,len]): build the boxed
    // {base, len} view over an array (AsSpan) or an existing view (Slice).
    // The oracle's window check + safe clamp (irgen_generics.c): a negative
    // start/window, a start past the end, or a window past the remaining
    // elements reports "span range out of bounds" and folds to the EMPTY
    // view (start 0, len 0). x0 = this site's private frame box on return
    // (batch 12: a frame slot, not a heap allocation).
    void GenSpanView(Node e, Node recv, string contTy, bool isSlice) {
        int esz = isSlice ? SpanTyElemSize(contTy) : ArrElemSize(contTy);
        GenExpr(recv);                           // x0 = arr (element ptr) / box
        XPushV0();                          // push src
        XPopV(1);                          // pop src -> x1
        if (isSlice) {
            LdrU(2, 1, 8);                       // x2 = srclen
            LdrU(1, 1, 0);                       // x1 = srcbase
        } else {
            // an array value already points at its first element
            if (tgt86 == 1) { XMemV(1, 2, 1, -16); } else { E4(0xF85F0022); }   // x2 = srclen ([arr-16])
        }
        XPushR(1);                          // push srcbase
        XPushR(2);                          // push srclen (batch 34: was raw)
        if (e.kids.Count >= 1) { GenExpr(e.kids[0]); } else { LoadImm(0, 0); }
        XPushV0();                          // push start
        if (e.kids.Count >= 2) {
            GenExpr(e.kids[1]);                  // x0 = window
        } else {
            // window = srclen - start: peek the pushed operands in place
            // ([sp]=start, [sp+16]=srclen) so the push count stays 4
            LdrU(2, 31, 16);                     // x2 = srclen
            LdrU(3, 31, 0);                      // x3 = start
            StringSub(2, 2, 3);                      // sub x2, x2, x3
            MovRR(0, 2);                         // x0 = window
        }
        XPushV0();                          // push window
        // stack now: [sp]=window, [sp+16]=start, [sp+32]=srclen, [sp+48]=srcbase
        XPopV(0);                          // pop window -> x0
        XPopV(1);                          // pop start -> x1
        XPopV(2);                          // pop srclen -> x2
        XPopV(3);                          // pop srcbase -> x3
        int vbad = NL();
        int vok = NL();
        StringCmp(1, 2);                         // cmp x1, x2
        EmitBcond(12, vbad);                     // b.gt bad (start > srclen)
        if (tgt86 == 1) { X3(0x48, 0x83, 0xFF); X1(0x00); } else { E4(0xEB1F001F); }                          // cmp x0, xzr
        EmitBcond(11, vbad);                     // b.lt bad (window < 0)
        StringSub(4, 2, 1);                      // sub x4, x2, x1 (remaining)
        StringCmp(0, 4);                         // cmp x0, x4
        EmitBcond(12, vbad);                     // b.gt bad (window > remaining)
        StringCmp(1, 31);                        // cmp x1, xzr
        EmitBcond(11, vbad);                     // b.lt bad (start < 0)
        EmitB(vok);
        Mark(vbad);
        // soft path: report, then the empty view (start 0, window 0)
        XPushR(3);                          // keep srcbase
        LoadSymRef("l_.str." + guardFileIdx, 0);
        LoadImm(1, e.line);
        LoadImm(2, e.col);
        LoadSymRef("l_.str." + guardSpanIdx, 3);
        BLInternal("_zan_rt_guard_fail3");
        XPopV(3);                          // pop srcbase -> x3
        LoadImm(1, 0);                           // start = 0
        LoadImm(0, 0);                           // window = 0
        Mark(vok);
        // x0 = window, x1 = start, x3 = srcbase
        LoadImm(5, esz);
        MulRR(6, 1, 5);                          // mul x6, x1, x5 (start*esz)
        AddRR(4, 3, 6);                          // add x4, x3, x6 (newbase)
        XPushV0();                          // keep window
        XPushR(4);                          // keep newbase
        SpanSiteBox(e);                          // x0 = frame box (batch 12)
        XPopV(1);                          // pop newbase -> x1
        XPopV(2);                          // pop window -> x2
        StrU(1, 0, 0);                           // [box] = base
        StrU(2, 0, 8);                           // [box+8] = len
    }

    void CheckExternNg(Node m) {
        if (!HasMod(m, MOD.Static()) || HasTypeParams(m)) {
            diags.Error("ngen: extern requires a non-generic static method '" + m.sval + "'", m.line, m.col);
        }
        string rt = TypeFullName(m.type);
        if (rt != "void" && !ExternTyNg(rt)) {
            diags.Error("ngen: unsupported extern return ABI '" + rt + "' in '" + m.sval
                + "' (supported: void, string, byte[]/arrays-as-pointers, int/long/nint, narrow ints, float/double)", m.line, m.col);
        }
        int pc = ParamCount(m);
        if (pc > 24) { diags.Error("ngen: extern ABI supports at most 24 arguments in '" + m.sval + "'", m.line, m.col); }
        int i = 0;
        while (i < pc) {
            Node p = ParamAt(m, i);
            if (p == null) { return; }
            string pt = TypeFullName(p.type);
            // ref/out (p.ival) and params (p.op) pass through the existing
            // PushCallArgs machinery: GenRefArg hands the storage address,
            // the variadic tail is bundled into a packed array whose value
            // is the data pointer
            if (!ExternTyNg(pt)) {
                diags.Error("ngen: unsupported extern parameter ABI '" + pt + "' in '" + m.sval
                    + "' (supported: by-value scalars incl. nint/float/double, arrays as data pointers, ref/out, params)", m.line, m.col);
            }
            i = i + 1;
        }
    }

    // Mirror of PushCallArgs' push order: one entry per stack slot left by
    // the push phase, tagged with the extern parameter type that value was
    // converted to (that type -- not the argument expression's type -- picks
    // the AAPCS64 register class). The variadic tail contributes a single
    // bundle-array slot, matching the net stack shape.
    List<string> ExternArgClassTys(Node m, Node e) {
        List<string> res = new List<string>();
        if (e == null || e.a == null) { return res; }
        int pc = ParamCount(m);
        Node lastP = pc > 0 ? ParamAt(m, pc - 1) : null;
        bool variadic = lastP != null && lastP.op == 1;
        int fixedc = variadic ? pc - 1 : pc;
        int prov = e.kids.Count;
        List<Node> ak = e.kids;
        bool hasNamed = false;
        int k = 0;
        while (k < prov) {
            if (e.kids[k].argName != null && e.kids[k].argName != "") { hasNamed = true; }
            k = k + 1;
        }
        if (hasNamed) {
            int slots = pc > prov ? pc : prov;
            int[] slot = new int[slots];
            bool[] usedName = new bool[prov];
            k = 0;
            while (k < slots) { slot[k] = -1; k = k + 1; }
            k = 0;
            while (k < prov) {
                string an = e.kids[k].argName;
                if (an == null || an == "") { k = k + 1; continue; }
                int found = -1;
                int j = 0;
                while (j < pc) {
                    Node pp = ParamAt(m, j);
                    if (pp != null && pp.sval == an) { found = j; break; }
                    j = j + 1;
                }
                if (found >= 0 && slot[found] < 0) {
                    slot[found] = k;
                    usedName[k] = true;
                }
                k = k + 1;
            }
            int j2 = 0;
            k = 0;
            while (k < prov) {
                if (usedName[k]) { k = k + 1; continue; }
                while (j2 < pc && slot[j2] >= 0) { j2 = j2 + 1; }
                if (j2 >= pc) { break; }
                slot[j2] = k;
                j2 = j2 + 1;
                k = k + 1;
            }
            bool dense = true;
            k = 0;
            while (k < prov) {
                if (slot[k] < 0 || slot[k] >= prov) { dense = false; break; }
                k = k + 1;
            }
            if (dense) {
                ak = new List<Node>();
                k = 0;
                while (k < prov) {
                    ak.Add(e.kids[slot[k]]);
                    k = k + 1;
                }
            }
        }
        if (variadic && prov == pc && IsArrValExpr(ak[prov - 1])) {
            int i = 0;
            while (i < prov) {
                Node pp = ParamAt(m, i);
                res.Add(pp != null && pp.type != null ? TypeFullName(pp.type) : "");
                i = i + 1;
            }
            return res;
        }
        int n = 0;
        while (n < prov && n < fixedc) {
            Node pp = ParamAt(m, n);
            res.Add(pp != null && pp.type != null ? TypeFullName(pp.type) : "");
            n = n + 1;
        }
        while (n < fixedc) {
            Node pp = ParamAt(m, n);
            res.Add(pp != null && pp.type != null ? TypeFullName(pp.type) : "");
            n = n + 1;
        }
        // [DllImport(Variadic = true)]: only the fixed prefix rides the push
        // phase (the ... tail goes to the stack varargs area that
        // CallStaticNg fills), so the class list ends at the fixed params
        if (variadic) {
            res.Add(TypeFullName(lastP.type));           // the bundle array
        }
        return res;
    }

    // the NativeMemory.Sha256 intrinsic: zan_sha256(data, len, out32) into
    // an sp scratch block, then the oracle's string shape — str_alloc(33),
    // memcpy of the 32 raw digest bytes, header stamped len=32 — so the
    // caller owns an ARC string exactly like any other produced string
    void EmitSha256CallNg(Node e) {
        // batch 34: the gate is gone -- _zan_sha256 is zan-emitted on both
        // lanes, and the csel/mov/orr raws became primitives
        GenExpr(e.kids[0]);                          // x0 = data ptr (nint)
        AddSPImm(48, false);                         // sub sp, sp, #48
        StrU(0, 31, 0);                              // sp[0] = data
        GenExpr(e.kids[1]);                          // x0 = len
        StringCmp(0, 31);                            // cmp x0, #0
        int clamp = NL();
        int done = NL();
        EmitBcond(11, clamp);                        // b.lt -> clamp
        MovRR(2, 0);
        EmitB(done);
        Mark(clamp);
        LoadImm(2, 0);
        Mark(done);
        LdrU(0, 31, 0);                              // x0 = data
        MovRR(1, 2);                                 // x1 = clamped len
        AddImm(2, 31, 16);                           // x2 = sp+16 (out32)
        BLExtern("_zan_sha256");                     // FIPS 180-4 digest
        LoadImm(0, 33);                              // 32 bytes + NUL
        BLInternal("_zan_rt_str_alloc");             // x0 = buf
        AddImm(1, 31, 16);                           // x1 = sp+16
        LoadImm(2, 32);
        BLExtern("_memcpy");                         // returns buf
        LoadImm(1, 0x5A414E5300000000);
        LoadImm(2, 32);
        OrrRR(1, 1, 2);                              // orr x1, x1, x2
        SubImm(0, 0, 8);
        StrU(1, 0, 0);                               // stamp [buf-8] len=32
        AddSPImm(48, true);                          // add sp, sp, #48
        AddImm(0, 0, 8);                             // x0 = buf
    }

    void CallStaticNg(int mi, Node e) {
        Node m = methNodes[mi];
        bool ext = HasMod(m, MOD.Extern());
        // the [DllImport] Sha256 decl only types the call: like the oracle
        // (irgen_expr.c emit_native_memory_call) the compiler lowers it as
        // an intrinsic producing an owned 32-raw-byte string
        if (m.sval == "Sha256" && methCls[mi] == "NativeMemory"
                && e.kids.Count == 2) {
            EmitSha256CallNg(e);
            return;
        }
        List<string> ats = ext ? ExternArgClassTys(m, e) : null;
        // a delegate-typed parameter of a generic-class static method arrives
        // open; the receiver's static type (an instance or extension
        // receiver) supplies the substitution source
        pendingCtorInstNg = e.a != null ? StaticTyOf(e.a) : null;
        int pushed = PushCallArgs(m, e);
        pendingCtorInstNg = null;
        // AAPCS64 allocation (extern only): the first eight integer-class
        // slots land in x0..x7 by their position among integer args; the
        // first eight float/double slots in d/s0..7 by their position among
        // fp args (moved over through scratch x10; floats narrow through
        // d31 so fcvt reads a dead temp). Quota-exhausted slots go to the
        // callee's packed stack-arg area: the reservation is made below the
        // pushes first (8-byte stride, argument order, padded so sp stays
        // 16-aligned), then every slot is read back by OFFSET from sp --
        // pops would walk into the reservation -- into its register or dest
        // slot. The caller reclaims reservation + push slots with one add
        // after the call.
        int[] ireg = null;
        int[] freg = null;
        int[] sidx = null;
        int[] tireg = null;
        int[] tfreg = null;
        int[] tsidx = null;
        int sres = 0;
        int vres = 0;
        int ntail = 0;
        int csTot = 0;
        bool dllVar = false;
        bool elfVar = false;
        if (ext) {
            ireg = new int[pushed];
            freg = new int[pushed];
            sidx = new int[pushed];
            int ci = 0;
            int cf = 0;
            int cs = 0;
            int pi = 0;
            while (pi < pushed) {
                string at = ats != null && pi < ats.Count ? ats[pi] : "";
                if (ExternFpTy(at)) {
                    if (cf < 8) { ireg[pi] = -1; freg[pi] = cf; cf = cf + 1; }
                    else { ireg[pi] = -2; sidx[pi] = cs; cs = cs + 1; }
                } else {
                    if (ci < 8) { ireg[pi] = ci; ci = ci + 1; }
                    else { ireg[pi] = -2; sidx[pi] = cs; cs = cs + 1; }
                }
                pi = pi + 1;
            }
            // [DllImport(Variadic = true)]: the two arms64 ABIs disagree on
            // where the ... tail goes. Apple arm64 passes every variadic
            // argument on the stack, right above any fixed stack-class args;
            // aarch64-linux instead allocates each tail by its natural class,
            // continuing the ordinary integer/fp register sequences and the
            // packed overflow area (clang oracle: fmt->x0, int varargs
            // w1,w2, double d0). Either way the tail values stage into
            // ntail(+pad) slots above the fixed dest slots: Apple leaves
            // them there as the ABI varargs area, ELF reads them back into
            // their destinations after the fixed readback.
            dllVar = m != null && HasMod(m, MOD.Variadic());
            ntail = dllVar ? (e != null ? e.kids.Count : 0) - pushed : 0;
            if (ntail < 0) { ntail = 0; }
            elfVar = dllVar && ntail > 0 && EnvTargetElf() == 1;
            if (ntail > 0) {
                tireg = new int[ntail];
                tfreg = new int[ntail];
                tsidx = new int[ntail];
            }
            int vk0 = 0;
            while (vk0 < ntail) {
                Node ae = e.kids[pushed + vk0];
                string tt = ae.kind == AK.OutArg() ? "" : StaticTyOf(ae);
                if (!elfVar) {
                    tireg[vk0] = -3;                     // Apple: tail is a stack arg
                } else if (IsDblExpr(ae) || tt == "float") {
                    // fp class: doubles as-is, floats as the doubles the C
                    // default promotions guarantee
                    if (cf < 8) { tireg[vk0] = -1; tfreg[vk0] = cf; cf = cf + 1; }
                    else { tireg[vk0] = -2; tsidx[vk0] = cs; cs = cs + 1; }
                } else if (ci < 8) {
                    tireg[vk0] = ci; ci = ci + 1;
                } else {
                    tireg[vk0] = -2; tsidx[vk0] = cs; cs = cs + 1;
                }
                vk0 = vk0 + 1;
            }
            sres = cs + (cs % 2);
            csTot = cs;
            vres = dllVar ? ntail + (ntail % 2) : 0;
            if (tgt86 != 1 && sres + vres > 0) {
                AddSPImm(8 * (sres + vres), false);      // sub sp, reserved (arm64 Apple va_list area; x86 tails push)
            }
        }
        if (ext && dllVar && ntail > 0) {
            // the ... tail: evaluate in order into the slots right above the
            // fixed dest slots. On Apple those slots ARE the ABI varargs
            // area (starting at sp above any fixed stack-class args); on
            // ELF they are staging for the post-readback move below. Each
            // value carries the C default promotions (float widens to
            // double, ints/pointers pass as i64). This must run BEFORE the
            // register readback -- GenExpr targets x0 and would clobber the
            // values being read back; the readback loads by absolute
            // offset, so the push slots are undisturbed.
            int vk = 0;
            while (vk < ntail) {
                Node ae = e.kids[pushed + vk];
                if (ae.kind == AK.OutArg()) {
                    GenRefArg(ae);
                } else {
                    GenExpr(ae);
                    GenCloneIfStruct(ae);
                    if (!IsDblExpr(ae) && !IsStrExpr(ae) && StaticTyOf(ae) == "float") {
                        if (tgt86 == 1) {
                            // batch 37: the shapes this branch catches hold
                            // SINGLE bits in rdi (the model keeps double
                            // bits everywhere else, so plain float idents
                            // skip it) -- re-read the low dword as single
                            // and widen to the promoted double the ABI wants
                            X3(0x66, 0x48, 0x0F); X2(0x6E, 0xC7);   // movq xmm0, rdi
                            X3(0xF3, 0x0F, 0x5A); X1(0xC0);         // cvtss2sd xmm0, xmm0
                            X3(0x66, 0x48, 0x0F); X2(0x7E, 0xC7);   // movq rdi, xmm0
                        } else {
                            E4(0x1E624000);                  // fcvt d0, s0
                            E4(0x9E660000);                  // fmov x0, d0
                        }
                    }
                }
                // Apple va_list starts just above the named stack args --
                // cs slots, NOT the 16-alignment-padded sres: an odd fixed
                // overflow count would otherwise shift every tail by 8.
                // ELF keeps staging at 8*sres, clear of its overflow dest
                // slots; the post-readback below does the ABI move.
                if (tgt86 == 1) { XPushV0(); } else {   // batch 33: x86 tails ride the push stream
                StrU(0, 31, 8 * (elfVar ? sres : csTot) + 8 * vk);   // [sp + off] = vararg k
                }
                vk = vk + 1;
            }
        }
        int r = pushed - 1;
        int xTot = pushed;
        int[] xCls = null;        // batch 37: 0 = integer class, 1 = fp class
        int[] xClsIdx = null;     // reg-class cursor (GPR / xmm), -1 = stack
        int[] xSPos = null;       // packed stack position in argument order
        if (tgt86 == 1 && ext) {
            // batch 37: the SysV SSE dual-cursor arm (replaces the batch 33
            // integer carve-out and its fail-closed). Integer-class args
            // fill rdi..r9 by their position among integer args (quota 6);
            // float/double args land in xmm0..7 by their position among fp
            // args (quota 8). The push slots hold double bits (the model
            // keeps every register float widened), so the readback movq's
            // the quad into the xmm and narrows only declared float params
            // (cvtsd2ss) -- a variadic tail keeps its promoted double, the
            // C default promotions already widened it. Quota-exhausted
            // slots of both classes share one packed stack area in
            // argument order (8-byte stride; XCallSeq stages it from the
            // v(6+k) homes). Variadic tails ride the push stream (no
            // Apple va_list area on x86), so the readback covers
            // pushed+ntail slots. out/ref params carry an address:
            // integer class whatever their declared type.
            xTot = pushed + ntail;
            xCls = new int[xTot];
            xClsIdx = new int[xTot];
            xSPos = new int[xTot];
            int xci = 0;
            int xcf = 0;
            int xcs = 0;
            int ta = 0;
            while (ta < xTot) {
                bool xfp;
                if (ta < pushed) {
                    Node xpa = ParamAt(m, ta);
                    xfp = (xpa == null || xpa.ival == 0) && ta < ats.Count
                        && ExternFpTy(ats[ta]);
                } else {
                    Node xae = e.kids[ta];
                    xfp = xae.kind != AK.OutArg()
                        && (IsDblExpr(xae) || StaticTyOf(xae) == "float");
                }
                if (xfp) {
                    if (xcf < 8) { xCls[ta] = 1; xClsIdx[ta] = xcf; xcf = xcf + 1; }
                    else { xCls[ta] = 1; xClsIdx[ta] = -1; xSPos[ta] = xcs; xcs = xcs + 1; }
                } else {
                    if (xci < 6) { xCls[ta] = 0; xClsIdx[ta] = xci; xci = xci + 1; }
                    else { xCls[ta] = 0; xClsIdx[ta] = -1; xSPos[ta] = xcs; xcs = xcs + 1; }
                }
                ta = ta + 1;
            }
            xStackArgs = xcs;
            xVecArgs = xcf;
            r = xTot - 1;
        }
        int armOvfArea = 0;
        if (tgt86 != 1 && !ext && pushed > 16) {
            int novf = pushed - 16;
            armOvfArea = 16 * ((novf + 1) / 2);
            AddSPImm(armOvfArea, false);
            int k = 0;
            while (k < pushed) {
                int off = armOvfArea + 16 * (pushed - 1 - k);
                if (k < 16) {
                    LdrU(k, 31, off);
                } else {
                    LdrU(10, 31, off);
                    StrU(10, 31, 8 * (k - 16));
                }
                k = k + 1;
            }
        }
        while (r >= 0) {
            if (tgt86 == 1 && ext) {
                // SysV readback, batch 37 class-aware: argument r sits at
                // [rsp + 16*(xTot-1-r)] (pushed in order, 16-byte steps).
                // Reg-class integer args go straight into their GPR; fp
                // args movq the quad (double bits) into xmm_vi and narrow
                // declared floats; stack-class args home into v(6+k) for
                // the call shim to stage (batch 33: any arity).
                int xoff = 16 * (xTot - 1 - r);
                if (xCls[r] == 0 && xClsIdx[r] >= 0) {
                    XopRMem(0x8B, XMapReal(xClsIdx[r]), 4, xoff);
                } else {
                    XopRMem(0x8B, 10, 4, xoff);            // mov r10, [rsp+off]
                    if (xClsIdx[r] >= 0) {
                        // movq xmm_vi, r10:REX 必须带 W(0x49 = W1 R0 X0
                        // B1)——W 缺了就解码成 movd(32 位装载,xmm 高半
                        // 清零),1.5 = 0x3FF8000000000000 低 dword 恒 0,
                        // printf %.1f 打 0.0(批46 首查我把它"修"成 0x43
                        // 反而引入此坑,llvm lldb 停 printf 现场 xmm0=0 定案)。
                        X1(0x66); X1(0x49); X2(0x0F, 0x6E);
                        X1(0xC0 | (xClsIdx[r] << 3) | 2);  // movq xmm_vi, r10
                        if (r < pushed && ats[r] == "float") {
                            X3(0xF2, 0x0F, 0x5A);
                            X1(0xC0 | (xClsIdx[r] << 3) | xClsIdx[r]);   // cvtsd2ss
                        }
                    } else {
                        // 批39:栈类 float 槽按 SysV eightbyte 打包 = 低
                        // 4 字节 float。批37 首版把加宽 double 位型整 8
                        // 字节落槽——double 8.5 = 0x4021_0000_0000_0000,
                        // 低 4 字节恒 0.0f(SumFI10 探针 = 42 现形)。
                        // movd 窄化回 r10(高位零填),XCallSeq movq 落槽
                        // 后低 4 字节即 C 调用约定要的 float 位型;变参尾
                        // 保持提升 double,不窄。
                        if (r < pushed && ats[r] == "float") {
                            // 首版 66 45 0F 6E 缺 REX.W 解码成 movd(32 位
                            // 装载,double 位型只剩低 dword=0)——REX 0x4D
                            // 才是 movq;movd 回写 7E 不带 W 是故意的。
                            X3(0x66, 0x4D, 0x0F); X1(0x6E); X1(0xFA);  // movq xmm15, r10
                            X3(0xF2, 0x45, 0x0F); X1(0x5A); X1(0xFF);  // cvtsd2ss xmm15, xmm15
                            X3(0x66, 0x45, 0x0F); X1(0x7E); X1(0xFA);  // movd r10d, xmm15(高位零填)
                        }
                        XSetV(XArgVOf(6 + xSPos[r]), 10);       // stack class: v(6+k) home
                    }
                }
            } else if (tgt86 == 1) {
                // SysV readback (internal calls): argument r sits at
                // [rsp + 16*(xTot-1-r)] (pushed in order, 16-byte steps).
                // Args 0..5 into their SysV registers, 6+ into the spill
                // homes the call shim stages (batch 33: any arity).
                if (r < 6) {
                    XopRMem(0x8B, XMapReal(r), 4, 16 * (xTot - 1 - r));
                } else {
                    XopRMem(0x8B, 10, 4, 16 * (xTot - 1 - r));
                    XSetV(XArgVOf(r), 10);
                }
            } else if (!ext) {
                if (armOvfArea == 0) {
                    XPopV(r);                      // pop xr, keep sp 16-aligned
                }
            } else if (sres + vres > 0) {
                int off = 8 * (sres + vres) + 16 * (pushed - 1 - r);   // slot r: arg r was pushed r-th from the bottom
                if (ireg[r] == -2) {
                    LdrU(10, 31, off);                   // ldr x10, [sp, #src]
                    if (ats[r] == "float") {
                        E4(0x9E670150);                  // fmov d16, x10
                        E4(0x1E624211);                  // fcvt s17, d16
                        // 批39:Rn 域(bits9-5)不可省——首版漏 (31<<5),
                        // 解码成 str s17,[x0](x0 恰是首个整参值,SumFI10
                        // 探针 SEGV addr=0xa 定案)。
                        E4(0xBD000000 | (31 << 5) | ((8 * sidx[r] / 4) << 10) | 17);   // str s17, [sp, #dst]
                    } else {
                        StrU(10, 31, 8 * sidx[r]);       // str x10, [sp, #dst]
                    }
                } else if (ireg[r] == -1) {
                    LdrU(10, 31, off);                   // ldr x10, [sp, #src]
                    if (ats[r] == "double") {
                        E4(0x9E670000 | (10 << 5) | freg[r]);    // fmov dN, x10
                    } else {
                        E4(0x9E670000 | (10 << 5) | 31);         // fmov d31, x10
                        E4(0x1E624000 | (31 << 5) | freg[r]);    // fcvt sN, d31
                    }
                } else {
                    LdrU(ireg[r], 31, off);              // ldr xN, [sp, #src]
                }
            } else if (ireg[r] == -1) {
                E4(0xF84107E0 | 10);                     // pop scratch x10
                if (ats[r] == "double") {
                    E4(0x9E670000 | (10 << 5) | freg[r]);    // fmov dN, x10
                } else {
                    E4(0x9E670000 | (10 << 5) | 31);         // fmov d31, x10
                    E4(0x1E624000 | (31 << 5) | freg[r]);    // fcvt sN, d31
                }
            } else {
                E4(0xF84107E0 | ireg[r]);                // pop xr, keep sp 16-aligned
            }
            r = r - 1;
        }
        if (ext && elfVar) {
            // ELF variadic readback: each tail moves staging -> destination.
            // Register-class tails fill x/d slots continuing the fixed
            // sequences; overflow tails copy into their packed stack slot.
            // Doubles keep all 8 bits; no single-precision narrowing -- the
            // C default promotions already widened every float tail.
            int vk2 = ntail - 1;
            while (vk2 >= 0) {
                if (tireg[vk2] == -2) {
                    LdrU(10, 31, 8 * sres + 8 * vk2);
                    StrU(10, 31, 8 * tsidx[vk2]);    // staging -> overflow slot
                } else if (tireg[vk2] == -1) {
                    LdrU(10, 31, 8 * sres + 8 * vk2);
                    E4(0x9E670000 | (10 << 5) | tfreg[vk2]);   // fmov dN, x10
                } else if (tireg[vk2] >= 0) {
                    LdrU(tireg[vk2], 31, 8 * sres + 8 * vk2);
                }
                vk2 = vk2 - 1;
            }
        }
        if (tgt86 == 1 && !ext) {
            XAddRsp(16 * pushed);              // reclaim the push slots
            xStackArgs = pushed > 6 ? pushed - 6 : 0;
        }
        if (!ext) {
            BLInternal(MethSymNg(methCls[mi], m));
            if (armOvfArea > 0) {
                AddSPImm(armOvfArea + 16 * pushed, true);
            }
            return;
        }
        // Native strings/arrays already point at their bytes; nint/long carry
        // the full pointer/integer width. C int arguments use the low wN.
        BLExtern(ExternSymNg(m));
        if (tgt86 == 1) {
            XAddRsp(16 * xTot);                // batch 33: reclaim the push stream
        } else if (sres + vres > 0) {
            AddSPImm(8 * (sres + vres) + 16 * pushed, true);   // caller cleans dest + pushes
        }
        string rt = TypeFullName(m.type);
        // the stdlib decl says int, but the oracle lowers this call as an
        // intrinsic returning the full i64 CRC -- no sext may narrow it
        // (conformance native_memory compares it against 3421780262)
        if (m.sval == "Crc32" && methCls[mi] == "NativeMemory") { rt = "long"; }
        if (rt == "int") {
            Sxtw0();                              // sxtw x0, w0 (e.g. EOF == -1)
        } else if (rt == "short") {
            if (tgt86 == 1) { X3(0x48, 0x0F, 0xBF); X1(0xF8); } else { E4(0x93403C00); }   // sxth x0, w0 / movsx rdi, di
        } else if (rt == "ushort" || rt == "char") {
            if (tgt86 == 1) { X3(0x48, 0x0F, 0xB7); X1(0xF8); } else { E4(0x53003C00); }   // uxth w0, w0 / movzx rdi, di
        } else if (rt == "uint" || rt == "bool" || rt == "byte") {
            if (tgt86 == 1) { X2(0x89, 0xFF); } else { E4(0x2A0003E0); }   // mov w0, w0 / mov edi, edi
        } else if (rt == "sbyte") {
            if (tgt86 == 1) { X3(0x48, 0x0F, 0xBE); X1(0xF8); } else { E4(0x93401C00); }   // sxtb x0, w0 / movsx rdi, dil
        } else if (rt == "float") {
            if (tgt86 == 1) {
                // batch 37: C returned a single in xmm0's low dword -- the
                // model wants the widened double bits in rdi. (The old
                // line here emitted the arm64 fcvt word into the x86
                // stream: dead while the batch 33 fail-closed stood, and
                // wrong the moment it fell.)
                X3(0xF3, 0x0F, 0x5A); X1(0xC0);            // cvtss2sd xmm0, xmm0
                X3(0x66, 0x48, 0x0F); X2(0x7E, 0xC7);      // movq rdi, xmm0
            } else {
                E4(0x1E22C000);                            // fcvt d0, s0
                E4(0x9E660000);                            // fmov x0, d0
            }
        } else if (rt == "double") {
            if (tgt86 == 1) { X3(0x66, 0x48, 0x0F); X2(0x7E, 0xC7); } else { E4(0x9E660000); }                              // fmov x0, d0
        }
        if (ExternSymNg(m) == "_free" && e != null && e.kids.Count == 1) {
            GenInvalidateFreedStringNg(e.kids[0]);
        }
    }

    // a call to libc free() consumes its string argument: the reference nulls
    // the source reference afterwards (irgen_builtins.c
    // emit_invalidate_freed_string), so a following `== null` check agrees
    void GenInvalidateFreedStringNg(Node arg) {
        if (arg == null) { return; }
        if (arg.kind == AK.Ident()) {
            int li = LocalIdx(arg.sval);
            if (li >= 0) {
                if (locTy[li] != "string") { return; }
                LoadImm(0, 0);
                if (locRef[li]) {
                    LoadLocal(li, 1);
                    StrU(0, 1, 0);                       // store through the ref
                } else {
                    StoreLocalVal(li, 0);
                }
                return;
            }
            Fld fld = CurField(arg.sval);
            if (fld != null) {
                if (fld.ty != "string" || LocalIdx("this") < 0) { return; }
                LoadLocal(LocalIdx("this"), 0);          // receiver -> x0
                LoadImm(1, 0);                           // null -> x1
                StoreFieldNg(1, 0, fld);
                return;
            }
            string ssym = FindStaticSym(curCls, arg.sval);
            if (ssym != null) {
                if (FindStaticTy(curCls, arg.sval) != "string") { return; }
                LoadSymRef(ssym, 9);
                LoadImm(0, 0);
                StrU(0, 9, 0);
            }
            return;
        }
        if (arg.kind == AK.MemberAccess() && arg.a != null) {
            Fld fld = FieldOf(arg);
            if (fld == null || fld.ty != "string") { return; }
            GenExpr(arg.a);                              // receiver -> x0
            LoadImm(1, 0);                               // null -> x1
            StoreFieldNg(1, 0, fld);                     // str x1, [x0]
        }
    }

    Node FindStatic(string name) {
        List<int> cs = MethCandsName(name);
        if (cs == null) { return null; }
        int i = 0;
        while (i < cs.Count) {
            if (methStat[cs[i]] == 1) { return methNodes[cs[i]]; }
            i = i + 1;
        }
        return null;
    }

    // find an instance method by name (first match across classes)
    int FindInstanceIdx(string name) {
        List<int> cs = MethCandsName(name);
        if (cs == null) { return -1; }
        int i = 0;
        while (i < cs.Count) {
            if (methStat[cs[i]] == 0) { return cs[i]; }
            i = i + 1;
        }
        return -1;
    }

    bool IsVirtualMod(Node m) { return HasMod(m, MOD.Virtual()) || HasMod(m, MOD.Override()); }
    // what occupies a vtable slot: virtual, override, or an abstract
    // declaration (interfaces are all-abstract classes)
    bool IsSlotMod(Node m) { return IsVirtualMod(m) || HasMod(m, MOD.Abstract()); }

    int IndexOfStrNg(List<string> xs, string s) {
        int i = 0;
        while (i < xs.Count) { if (xs[i] == s) { return i; } i = i + 1; }
        return -1;
    }

    int MethodCountNg(string cls, string name) {
        int n = 0;
        List<int> cs = MethCandsClsName(cls, name);
        if (cs == null) { return 0; }
        int i = 0;
        while (i < cs.Count) {
            if (methStat[cs[i]] != 2) { n = n + 1; }
            i = i + 1;
        }
        return n;
    }

    // exported symbol for a method (static or instance). With a single
    // declaration the historical `_Cls_name` stands; with overloads the
    // parameter tags are appended so two methods cannot collide (mirrors
    // CtorSymNg). 缺口四: this plain name now carries the C-ABI export
    // shim; the compiled body lives one "__body" suffix away, and every
    // internal reference (BLInternal calls, vtable slots, delegate and
    // method-group loads, reflection thunks, async ramps) resolves to the
    // body through MethSymNg below.
    string MethExportSymNg(string cls, Node m) {
        string cs = ConversionSymNg(cls, m);
        if (cs != null) { return cs; }
        if (m.sval2 != null && m.sval2 != "" && m.sval2.IndexOf("<") < 0) { return "_" + m.sval2; }
        if (MethodCountNg(cls, m.sval) <= 1) { return "_" + cls + "_" + m.sval; }
        string s = "_" + cls + "_" + m.sval + "__";
        int i = 0;
        while (i < m.kids.Count) {
            Node p = m.kids[i];
            if (p.kind == AK.Param()) { s = s + "_" + TypeTagNg(p.type); }
            i = i + 1;
        }
        return s;
    }

    // symbol of the compiled body of a method: MethExportSymNg plus the
    // "__body" suffix. Constructed only here so registration and every
    // reference stay in lockstep.
    string MethSymNg(string cls, Node m) {
        return MethExportSymNg(cls, m) + "__body";
    }

    // vtable slot key of a method declaration: name + parameter type tags.
    // Overloads occupy distinct slots (C# matches overrides by signature),
    // so a virtual dispatch through one overload can never land in another
    string SlotKeyNg(Node m) {
        string s = m.sval;
        int i = 0;
        while (i < m.kids.Count) {
            Node p = m.kids[i];
            if (p.kind == AK.Param()) { s = s + "_" + TypeTagNg(p.type); }
            i = i + 1;
        }
        return s;
    }

    // is a slot-key tag an OPEN type parameter: a bare identifier that
    // resolves to no declared type or primitive ("T" in Box<T>.Put(T, T)).
    // Under erasure one shared body serves every instantiation, so such a
    // tag accepts any word tag the implementation declares.
    bool ErasedTagNg(string tag) {
        if (tag == null || tag.Length == 0) { return false; }
        if (tag.IndexOf("[") >= 0) { return false; }
        int dot = tag.IndexOf(".");
        string head = dot > 0 ? tag.Substring(0, dot) : tag;
        if (head == "int" || head == "long" || head == "ulong" || head == "double"
                || head == "bool" || head == "char" || head == "string"
                || head == "object" || head == "byte" || head == "sbyte"
                || head == "short" || head == "ushort" || head == "uint"
                || head == "float" || head == "nint" || head == "void") { return false; }
        return FindClass(head) == null;
    }

    // does a method occupy a slot key: exact key equality, or a generic
    // base's erased key ("Put_T_T") matching a concrete implementation
    // ("Put_int_int") tag-for-tag with open tags as wildcards
    bool SlotKeyMatchNg(Node m, string key) {
        string mk = SlotKeyNg(m);
        if (mk == key) { return true; }
        int un = mk.IndexOf("_");
        int uk = key.IndexOf("_");
        if (un <= 0 || uk <= 0) { return false; }
        if (mk.Substring(0, un) != key.Substring(0, uk)) { return false; }
        int i = un + 1;
        int j = uk + 1;
        while (i < mk.Length || j < key.Length) {
            int e1 = mk.IndexOf("_", i); if (e1 < 0) { e1 = mk.Length; }
            int e2 = key.IndexOf("_", j); if (e2 < 0) { e2 = key.Length; }
            string t1 = mk.Substring(i, e1 - i);
            string t2 = key.Substring(j, e2 - j);
            if (t1 != t2 && !ErasedTagNg(t2)) { return false; }
            if (e1 == mk.Length && e2 == key.Length) { return true; }
            if (e1 == mk.Length || e2 == key.Length) { return false; }
            i = e1 + 1;
            j = e2 + 1;
        }
        return true;
    }

    // virtual-slot keys of cls, base classes first; a derived
    // re-declaration of an inherited virtual keeps the base slot
    void CollectVSlotsNg(string cls, List<string> slots) {
        Cls c = FindClass(cls);
        if (c != null && c.baseName != null) { CollectVSlotsNg(c.baseName, slots); }
        List<int> mine = MethCandsCls(cls);
        if (mine == null) { return; }
        int i = 0;
        while (i < mine.Count) {
            int mi = mine[i];
            if (methStat[mi] == 0 && IsSlotMod(methNodes[mi])
                    && IndexOfStrNg(slots, SlotKeyNg(methNodes[mi])) < 0) { slots.Add(SlotKeyNg(methNodes[mi])); }
            i = i + 1;
        }
    }

    // slot index of method decl m in the receiver's static class's vtable,
    // or -1 when the call is not virtual
    int VSlotOf(string rc, Node m) {
        List<string> slots = new List<string>();
        CollectVSlotsNg(rc, slots);
        return IndexOfStrNg(slots, SlotKeyNg(m));
    }

    // instance-method candidates for a call on receiver class rc, derived
    // class first (shadowing picks the most-derived declaration)
    void InstanceCands(string rc, string name, List<int> outIdx) {
        string cur = rc;
        while (cur != null) {
            List<int> cs = MethCandsClsName(cur, name);
            if (cs != null) {
                int i = 0;
                while (i < cs.Count) {
                    if (methStat[cs[i]] == 0) { outIdx.Add(cs[i]); }
                    i = i + 1;
                }
            }
            Cls cc = FindClass(cur);
            cur = cc != null ? cc.baseName : null;
        }
    }

    // extension-method dispatch: `recv.Name(args)` with no instance or
    // static-through-instance match names a static method whose first
    // parameter is `this T` with T the receiver's static type (declared by
    // fn.ival == 1 in ParseParams). Candidates are ranked by temporarily
    // letting the receiver occupy the first argument slot, so the remaining
    // arguments score against parameters 1.. exactly like FitPickIdx.
    // Returns the chosen method index without mutating callNode, or -1.
    int ResolveExtNg(Node recv, string name, Node callNode) {
        string rt = ExtRecvTy(recv);
        if (rt == null) { return -1; }
        List<int> cands = new List<int>();
        List<int> nc = MethCandsName(name);
        if (nc != null) {
            int i = 0;
            while (i < nc.Count) {
                int mi = nc[i];
                Node m = methNodes[mi];
                if (methStat[mi] == 1 && m.ival == 1 && m.kids.Count > 0) {
                    Node p0 = ParamAt(m, 0);
                    string pt = p0 != null && p0.type != null ? TypeFullName(p0.type) : null;
                    if (pt == rt || (pt != null && IndexOfStrNg(DeclTps(m), pt) >= 0)) { cands.Add(mi); }
                }
                i = i + 1;
            }
        }
        if (cands.Count == 0) { return -1; }
        callNode.kids.Insert(0, recv);
        int pick = FitPickIdx(cands, callNode);
        callNode.kids.RemoveAt(0);
        return pick;
    }

    // static type name of an extension-method receiver: StaticTyOf plus the
    // literal shapes it does not cover ("hey".Shout(), (3).Twice())
    string ExtRecvTy(Node e) {
        if (e == null) { return null; }
        string t = StaticTyOf(e);
        if (t != null) { return t; }
        return ExtRecvLitTy(e);
    }

    string ExtRecvLitTy(Node e) {
        if (e == null) { return null; }
        if (e.kind == AK.IntLit()) {
            if (e.suffix == 2 || e.suffix == 3) { return "ulong"; }
            if (e.suffix == 1) { return "long"; }
            return "int";
        }
        if (e.kind == AK.StringLit()) { return "string"; }
        if (e.kind == AK.FloatLit()) { return "double"; }
        if (e.kind == AK.BoolLit()) { return "bool"; }
        if (e.kind == AK.CharLit()) { return "char"; }
        return null;
    }

    // the op_index / op_index_set instance method of cls (its base chain),
    // or null -- the indexer protocol obj[i] dispatches through
    Node OpIndexMethod(string cls) { return OpMethodInChain(cls, "op_index"); }
    Node OpIndexSetMethod(string cls) { return OpMethodInChain(cls, "op_index_set"); }
    Node OpMethodInChain(string cls, string name) {
        string cur = cls;
        while (cur != null) {
            Node m = FindInstanceInCls(cur, name);
            if (m != null) { return m; }
            Cls cc = FindClass(cur);
            cur = cc != null ? cc.baseName : null;
        }
        return null;
    }

    // first method of any kind whose declared name matches, or -1
    // (specialization lookups by mangled name)
    int FindMethByNameNg(string name) {
        List<int> cs = MethCandsName(name);
        return cs != null && cs.Count > 0 ? cs[0] : -1;
    }

    // property-accessor lookup: `name` (get_X / set_X) in cls's base chain,
    // statics and instance methods both qualify; the declaring class lands
    // in accOwnerCls so the symbol mangles against the right class
    string accOwnerCls;
    Node AccessorInChain(string cls, string name) {
        string cur = cls;
        while (cur != null) {
            List<int> cs = MethCandsClsName(cur, name);
            if (cs != null) {
                int i = 0;
                while (i < cs.Count) {
                    int st = methStat[cs[i]];
                    if (st == 0 || st == 1) {
                        accOwnerCls = cur;
                        return methNodes[cs[i]];
                    }
                    i = i + 1;
                }
            }
            Cls cc = FindClass(cur);
            cur = cc != null ? cc.baseName : null;
        }
        return null;
    }

    // among a class's op_index / op_index_set overloads, the one whose index
    // (and, for setters, value) parameters best fit the operand types, or
    // null -- indexer overloads are distinguished by their parameter types
    Node OpIndexFit(string cls, string name, Node idxExpr, Node valExpr) {
        Node best = null;
        int bestScore = -2000000000;
        string cur = cls;
        while (cur != null) {
            List<int> cs = MethCandsClsName(cur, name);
            if (cs != null) {
                int i = 0;
                while (i < cs.Count) {
                    int mi = cs[i];
                    if (methStat[mi] == 0 || methStat[mi] == 1) {
                        Node m = methNodes[mi];
                        // the indexer protocol takes both spellings: an
                        // instance op_index(idx[, val]) and a static
                        // op_index(self, idx[, val]) -- the register layout
                        // is identical either way (x0 receiver, x1 index,
                        // x2 value), only the parameter offset shifts
                        int ioff = 0;
                        if (methStat[mi] == 1) {
                            Node sp = ParamAt(m, 0);
                            if (sp == null || sp.type == null
                                    || TypeFullName(sp.type) != cur) { i = i + 1; continue; }
                            ioff = 1;
                        }
                        Node ip = ParamAt(m, ioff);
                        if (ip == null || ip.type == null) { i = i + 1; continue; }
                        int s1 = ArgParamScore(idxExpr, TypeFullName(ip.type));
                        if (s1 <= -100) { i = i + 1; continue; }
                        int score = s1;
                        if (valExpr != null) {
                            Node vp = ParamAt(m, ioff + 1);
                            if (vp == null || vp.type == null) { i = i + 1; continue; }
                            int s2 = ArgParamScore(valExpr, TypeFullName(vp.type));
                            if (s2 <= -100) { i = i + 1; continue; }
                            score = score + s2;
                        }
                        if (score > bestScore) { bestScore = score; best = m; }
                    }
                    i = i + 1;
                }
            }
            Cls cc = FindClass(cur);
            cur = cc != null ? cc.baseName : null;
        }
        return best;
    }

    string VSlotImplCls(string cls, string key) {
        string cur = cls;
        while (cur != null) {
            List<int> cs = MethCandsCls(cur);
            if (cs != null) {
                int i = 0;
                while (i < cs.Count) {
                    // an abstract declaration does not implement its own slot;
                    // the search continues down the chain to the concrete body
                    if (methStat[cs[i]] == 0 && SlotKeyMatchNg(methNodes[cs[i]], key)
                            && !HasMod(methNodes[cs[i]], MOD.Abstract())) { return cur; }
                    i = i + 1;
                }
            }
            Cls cc = FindClass(cur);
            cur = cc != null ? cc.baseName : null;
        }
        return null;
    }

    Node FindInstanceInCls(string cls, string name) {
        List<int> cs = MethCandsClsName(cls, name);
        if (cs == null) { return null; }
        int i = 0;
        while (i < cs.Count) {
            if (methStat[cs[i]] == 0) { return methNodes[cs[i]]; }
            i = i + 1;
        }
        return null;
    }

    // the concrete instance declaration occupying a signature-keyed slot
    Node FindInstanceInClsKey(string cls, string key) {
        List<int> cs = MethCandsCls(cls);
        if (cs == null) { return null; }
        int i = 0;
        while (i < cs.Count) {
            if (methStat[cs[i]] == 0 && SlotKeyMatchNg(methNodes[cs[i]], key)) { return methNodes[cs[i]]; }
            i = i + 1;
        }
        return null;
    }

    // does method m admit a call with argc arguments: the exact arity, a
    // `params` tail covering the rest, or trailing default parameters
    // filling the gap (gen0's method_accepts_arity)
    bool MethodAcceptsArity(Node m, int argc) {
        int pc = ParamCount(m);
        Node lastP = pc > 0 ? ParamAt(m, pc - 1) : null;
        bool variadic = lastP != null && lastP.op == 1;
        if (variadic) { return argc >= pc - 1; }
        // [DllImport(Variadic = true)]: the declared parameters are the fixed
        // prefix of a C varargs callee -- every argument beyond them is
        // well-formed (printf(fmt, ...))
        if (HasMod(m, MOD.Variadic())) { return argc >= pc; }
        if (argc == pc) { return true; }
        if (argc > pc) { return false; }
        int j = argc;
        while (j < pc) {
            Node p = ParamAt(m, j);
            if (p == null || p.b == null) { return false; }
            j = j + 1;
        }
        return true;
    }

    // overload resolution among candidate method indices: exact-arity
    // candidates outrank default-filled ones, each scored by
    // argument/parameter type agreement (same shape as FitCtorIdx)
    int FitPickIdx(List<int> cands, Node callNode) {
        int argc = callNode.kids.Count;
        int exact = -1; int exactScore = -2000000000;
        int filled = -1; int filledScore = -2000000000;
        int i = 0;
        while (i < cands.Count) {
            Node m = methNodes[cands[i]];
            if (MethodAcceptsArity(m, argc)) {
                int pc = ParamCount(m);
                int score = 0;
                bool compatible = true;
                int j = 0;
                while (j < argc && compatible) {
                    if (j < pc) {
                        Node p = ParamAt(m, j);
                        string pt = p != null && p.type != null ? TypeFullName(p.type) : null;
                        if (p != null && p.op == 1 && IsArrTy(pt)) {
                            // the params tail takes every remaining argument
                            // as an element, so it is ranked against the
                            // element type -- comparing an element with the
                            // array type would disqualify the only candidate
                            // that can take the call (Calc.Sum(1, 2, 3),
                            // gen0's method_args_score). The bundle handed
                            // over whole stays exact.
                            string et = pt.Substring(0, pt.Length - 2);
                            while (j < argc) {
                                Node ta = callNode.kids[j];
                                string tat = StaticTyOf(ta);
                                if (tat != null && tat == pt) {
                                    score = score + 8;
                                } else {
                                    int es = ArgParamScore(ta, et);
                                    if (es <= -100) { compatible = false; }
                                    score = score + es;
                                }
                                j = j + 1;
                            }
                        } else {
                            int s = ArgParamScore(callNode.kids[j], pt);
                            if (s <= -100) { compatible = false; }
                            score = score + s;
                        }
                    }
                    j = j + 1;
                }
                if (compatible) {
                    if (pc == argc) {
                        if (score > exactScore) { exactScore = score; exact = cands[i]; }
                    } else {
                        if (score > filledScore) { filledScore = score; filled = cands[i]; }
                    }
                }
            }
            i = i + 1;
        }
        if (exact >= 0) { return exact; }
        return filled;
    }

    // Shared by call emission and return-type inference, so an extern's
    // signature cannot be replaced by an unrelated same-named method.
    int ResolveStaticNg(Node e) {
        if (e.a == null) { return -1; }
        Node callee = e.a;
        string cls = curCls;
        bool bare = callee.kind == AK.Ident();
        if (!bare) {
            if (callee.kind != AK.MemberAccess() || callee.a == null) { return -1; }
            // namespace-qualified static call `Ns.Sub.Cls.Method(args)`:
            // the receiver is a pure dotted identifier path whose LAST
            // segment names the class (types register by simple name, so
            // the namespace prefix is decoration). The head must not be a
            // local, so genuine instance chains (`a.b.Method()`) fall
            // through to the instance handlers (irgen_call.c:4878).
            if (callee.a.kind == AK.MemberAccess()) {
                Node head = callee.a;
                while (head.kind == AK.MemberAccess()) { head = head.a; }
                if (head.kind != AK.Ident() || LocalIdx(head.sval) >= 0
                        || FindClass(callee.a.sval) == null) { return -1; }
                cls = callee.a.sval;
            } else if (callee.a.kind != AK.Ident()
                    || FindClass(callee.a.sval) == null) { return -1; }
            else { cls = callee.a.sval; }
        }
        List<int> cands = new List<int>();
        while (cls != null) {
            List<int> cs = MethCandsClsName(cls, callee.sval);
            if (cs != null) {
                int i = 0;
                while (i < cs.Count) {
                    if (methStat[cs[i]] == 1) { cands.Add(cs[i]); }
                    i = i + 1;
                }
            }
            Cls c = FindClass(cls);
            cls = c != null ? c.baseName : null;
        }
        if (bare && cands.Count == 0) {
            // An implicit this member outranks the legacy global-static
            // fallback (Lexer.Ident must not resolve to TK.Ident).
            if (LocalIdx("this") >= 0) {
                List<int> inst = new List<int>();
                InstanceCands(curCls, callee.sval, inst);
                if (inst.Count > 0) { return -1; }
            }
            List<int> gs = MethCandsName(callee.sval);
            if (gs != null) {
                int i = 0;
                while (i < gs.Count) {
                    if (methStat[gs[i]] == 1) { cands.Add(gs[i]); }
                    i = i + 1;
                }
            }
        }
        if (cands.Count == 0) { return -1; }
        int pick = cands.Count == 1 ? cands[0] : FitPickIdx(cands, e);
        return pick >= 0 ? pick : cands[0];
    }

    // find a static method declared by exactly this class (Class.Method()
    // form -- FindStaticIdx only matches by bare name)
    int FindStaticInCls(string cls, string name) {
        List<int> cs = MethCandsClsName(cls, name);
        if (cs == null) { return -1; }
        int i = 0;
        while (i < cs.Count) {
            if (methStat[cs[i]] == 1) { return cs[i]; }
            i = i + 1;
        }
        return -1;
    }

    // does the named class declare a constructor?
    bool ClassHasCtor(string cls) {
        List<int> mine = MethCandsCls(cls);
        if (mine == null) { return false; }
        int i = 0;
        while (i < mine.Count) {
            if (methStat[mine[i]] == 2) { return true; }
            i = i + 1;
        }
        return false;
    }

    // does the program itself declare a member of that class with this
    // name? (gen0 steps its built-ins aside per member, so defining one
    // Convert or Math method does not disable the others)
    bool UserDefinesClsMember(string cls, string name) {
        return MethCandsClsName(cls, name) != null;
    }

    // which scalar flavour does this expression carry, for x.ToString()
    // rendering (null = not a scalar: leave the call to method dispatch)?
    string ScalarToStringTy(Node e) {
        if (e == null) { return null; }
        if (e.kind == AK.IntLit()) { return "int"; }
        if (IsBoolExpr(e)) { return "bool"; }
        if (IsStrExpr(e)) { return "string"; }
        if (IsCharExpr(e)) { return "char"; }
        if (IsDblExpr(e)) { return "double"; }
        if (IsUlongExpr(e)) { return "ulong"; }
        if (e.kind == AK.CastExpr() && e.type != null) {
            // gen0 renders uint/ushort signed too (only ulong goes unsigned)
            string t = e.type.sval;
            if (t == "double" || t == "float") { return "double"; }
            if (t == "ulong") { return "ulong"; }
            if (t == "int" || t == "long" || t == "short" || t == "byte"
                    || t == "sbyte" || t == "uint" || t == "ushort") { return "int"; }
            return null;
        }
        if (e.kind == AK.Ident()) {
            int li = LocalIdx(e.sval);
            if (li >= 0) {
                string t = locTy[li];
                if (t == "int" || t == "long" || t == "short" || t == "byte"
                        || t == "sbyte" || t == "uint" || t == "ushort") { return "int"; }
                return null;
            }
            Fld f = CurField(e.sval);
            if (f != null && (f.ty == "int" || f.ty == "long"
                    || f.ty == "short" || f.ty == "byte")) { return "int"; }
            string st = FindStaticTy(curCls, e.sval);
            if (st == "int" || st == "long") { return "int"; }
            return null;
        }
        if (e.kind == AK.Call() && e.a != null) {
            string rt = CallRetTy(e);
            if (rt == "int" || rt == "long" || rt == "short" || rt == "byte") { return "int"; }
        }
        if (e.kind == AK.MemberAccess()) {
            Fld f = FieldOf(e);
            if (f != null && (f.ty == "int" || f.ty == "long"
                    || f.ty == "short" || f.ty == "byte")) { return "int"; }
        }
        // computed scalar shapes (parenthesized arithmetic, shifts, unary):
        // the bool/double/ulong probes above already classified their kinds,
        // so what remains of these operators renders through the int renderer
        if (e.kind == AK.Binary()) {
            int op = e.op;
            if (op == TK.Plus() || op == TK.Minus() || op == TK.Star()
                    || op == TK.Slash() || op == TK.Percent()
                    || op == TK.LessLess() || op == TK.GreaterGreater()
                    || op == TK.GreaterGreaterGreater()) { return "int"; }
        }
        if (e.kind == AK.Unary() && e.op == TK.Minus()) { return "int"; }
        return null;
    }

    // ---- expressions: result in x0 ----
    // switch (disc) { case C: ... default: ... }: a compare chain like
    // gen0's constant lowering (the selfhost parser only produces constant
    // cases). The discriminant stays at [sp] for the whole statement; every
    // case body and the default arm end at the shared exit, where it is
    // popped. `break` inside a case targets the switch exit, not an
    // enclosing loop; `continue` keeps targeting the loop.
    // linear pattern switch: the scrutinee evaluates once and stays pushed;
    // each case in source order peeks at it, tests its pattern, binds, and
    // evaluates its `when` guard -- a match falls into the body. Bindings
    // are pre-stamped frame slots (StampPatternBindings); a miss peeks the
    // next case's test with the value intact.
    void GenPatternSwitchStmt(Node s) {
        int endL = NL();
        GenExpr(s.a);                                    // x0 = discriminant
        XPushV0();                                  // push discriminant
        string sst = StaticTyOf(s.a);
        brkL.Add(endL);
        brkLoop.Add(false); brkFinBase.Add(finBodies.Count);
        int i = 0;
        while (i < s.kids.Count) {
            Node c = s.kids[i];
            int nextL = NL();
            if (c.ival == 1 && c.type != null) {
                LdrU(0, 31, 0);                          // x0 = discriminant
                EmitTypeTestNg(TypeFullName(c.type), sst);
                EmitCBZ(0, nextL);                       // no match: next case
                if (c.sval != null && c.sval != "") {
                    int li = LocalIdx(c.sval);
                    if (li >= 0) {
                        LdrU(1, 31, 0);                  // x1 = discriminant
                        StoreLocal(li, 1);               // bind
                    }
                }
            } else if (c.ival == 1) {                    // `case null:`
                LdrU(1, 31, 0);                          // x1 = discriminant
                E4(0xEB1F003F);                          // cmp x1, xzr
                EmitCbnz(1, nextL);                      // non-null: next case
            } else if (c.a != null) {
                if (IsStrExpr(s.a)) {
                    GenExpr(c.a);                        // x0 = case label
                    LdrU(1, 31, 0);                      // x1 = discriminant
                    BLExtern("_strcmp");
                    if (tgt86 == 1) { X3(0x48, 0x83, 0xFF); X1(0x00); } else { E4(0xEB1F001F); }                      // cmp x0, xzr
                    EmitCbnz(0, nextL);                  // unequal: next case
                } else {
                    GenExpr(c.a);                        // x0 = case label
                    XPushV0();                      // push label
                    LdrU(1, 31, 16);                     // x1 = discriminant
                    XPopV(0);                      // pop label -> x0
                    CmpRR(0, 1);                      // cmp x0, x1
                    EmitBcond(1, nextL);                 // b.ne: next case
                }
            }
            // c.a == null && c.ival == 0 is `default:`: matches always
            if (c.c != null) {
                GenExpr(c.c);                            // `when` guard
                EmitCBZ(0, nextL);                       // false: next case
            }
            GenStmt(c.b);
            if (c.b == null || c.b.kids.Count > 0) { EmitB(endL); }
            Mark(nextL);
            i = i + 1;
        }
        brkL.RemoveAt(brkL.Count - 1);
        brkLoop.RemoveAt(brkLoop.Count - 1);
        brkFinBase.RemoveAt(brkFinBase.Count - 1);
        Mark(endL);
        XPopV(0);                                  // pop discriminant
    }

    void GenSwitchStmt(Node s) {
        // a pattern case (`case T x [when g]:`, `case null:`) forces the
        // linear form: tests run in source order, the first match takes its
        // body. Plain constant switches keep the jump-chain form below.
        int i = 0;
        while (i < s.kids.Count) {
            if (s.kids[i].ival == 1) { GenPatternSwitchStmt(s); return; }
            i = i + 1;
        }
        int endL = NL();
        int defL = NL();
        GenExpr(s.a);
        XPushV0();                                  // push discriminant
        int nc = s.kids.Count;
        int[] bodies = new int[nc];
        int defIdx = -1;
        i = 0;
        while (i < nc) {
            Node c = s.kids[i];
            if (c.a == null) { defIdx = i; i = i + 1; continue; }
            bodies[i] = NL();
            if (IsStrExpr(s.a)) {
                GenExpr(c.a);                            // x0 = case label
                LdrU(1, 31, 0);                          // x1 = discriminant
                BLExtern("_strcmp");
                if (tgt86 == 1) { X3(0x48, 0x83, 0xFF); X1(0x00); } else { E4(0xEB1F001F); }                          // cmp x0, xzr
            } else {
                GenExpr(c.a);                            // x0 = case label
                XPushV0();                          // push label
                LdrU(1, 31, 16);                         // x1 = discriminant
                XPopV(0);                          // pop label -> x0
                CmpRR(0, 1);                          // cmp x0, x1
            }
            EmitBcond(0, bodies[i]);                     // b.eq body
            i = i + 1;
        }
        EmitB(defIdx >= 0 ? defL : endL);
        brkL.Add(endL);
        brkLoop.Add(false); brkFinBase.Add(finBodies.Count);
        i = 0;
        while (i < nc) {
            Node c = s.kids[i];
            if (c.a == null) { i = i + 1; continue; }
            Mark(bodies[i]);
            GenStmt(c.b);
            // an empty case body falls through to the next case (C# rule);
            // only a body that emitted code needs the jump to the exit
            if (c.b == null || c.b.kids.Count > 0) { EmitB(endL); }
            i = i + 1;
        }
        if (defIdx >= 0) {
            Mark(defL);
            GenStmt(s.kids[defIdx].b);
            EmitB(endL);
        }
        brkL.RemoveAt(brkL.Count - 1);
        brkLoop.RemoveAt(brkLoop.Count - 1);
        brkFinBase.RemoveAt(brkFinBase.Count - 1);
        Mark(endL);
        XPopV(0);                                  // pop discriminant
    }

    void GenExpr(Node e) {
        int saved = EnterEnvNg(e);
        GenExprInEnvNg(e);
        locHead = saved;
    }

    // 缺口四 a: strtod in the emitter's own process, then a raw-memory
    // roundtrip turns the double (bits in x0 per the internal value
    // model) into the i64 immediate LoadImm emits directly.
    long DblBitsOf(string txt) {
        nint buf = NgenDblEnv.Alloc(8);
        Span<double> dv = new Span<double>(buf, 1);
        dv[0] = NgenDblEnv.StrToD(txt, 0);
        Span<long> lv = new Span<long>(buf, 1);
        long bits = lv[0];
        NgenDblEnv.Free(buf);
        return bits;
    }

    void GenExprInEnvNg(Node e) {
        // ngen_async hook A: `await <async call>` (root drive; diagnosed
        // inside an async body, where only statement-head awaits suspend)
        if (TryGenAwaitExprNg(e)) { return; }
        if (TryGenDelegateExpr(e)) { return; }
        if (TryGenStringRead(e)) { return; }
        int k = e.kind;
        if (k == AK.IntLit()) {
            // gen0's int-literal rule: an unsuffixed radix-2/8/16 literal in
            // the uint range types as int, so its runtime value is the
            // int-domain (two's-complement) one
            long v = e.ival;
            int sfx = e.suffix - (e.suffix / 4) * 4;
            int rad = e.suffix >= 16 ? 16 : (e.suffix >= 8 ? 8 : 0);
            if (sfx == 0 && rad != 0 && v > 2147483647 && v <= 4294967295) {
                v = v - 4294967296;
            }
            LoadImm(0, v);
        } else if (k == AK.NullLit()) {
            LoadImm(0, 0);
        } else if (k == AK.StringLit()) {
            if (IsTypeofNode(e)) { ReflLoadTypeofRec(e); }
            else { LoadStr(InternStr(DecodeLiteralNg(e.sval)), 0); }
        } else if (k == AK.BoolLit()) {
            LoadImm(0, e.ival);
        } else if (k == AK.CharLit()) {
            // a char is its codepoint in the value slot (rendering decides
            // string vs decimal per context, like gen0)
            LoadImm(0, e.ival);
        } else if (k == AK.FloatLit()) {
            // 缺口四 a: IEEE bits resolved at compile time and emitted as
            // a movz/movk immediate. The previous lazy `dbl.N` __DATA
            // slot (strtod on first load) only worked in the first object
            // of a link; later objects' slots stayed zero and the
            // conversion fired on a null literal-text pointer.
            LoadImm(0, DblBitsOf(e.sval));
        } else if (k == AK.ThisExpr() || k == AK.BaseExpr()) {
            LoadLocal(LocalIdx("this"), 0);
        } else if (k == AK.Ident()) {
            int li = LocalIdx(e.sval);
            if (li < 0) {
                // implicit field reference inside instance methods
                Fld fld = CurField(e.sval);
                if (fld != null) {
                    LoadLocal(LocalIdx("this"), 0);
                    Cls nxc = ExpandedStructOf(fld);
                    if (nxc != null) { MaterializeNestedBox(nxc, fld); }
                    else { LoadFieldNg(0, 0, fld); }
                    return;
                }
                // static field: the value lives in a data-global slot
                string ssym = FindStaticSym(curCls, e.sval);
                if (ssym != null) {
                    LoadSymRef(ssym, 0);
                    LdrU(0, 0, 0);
                    return;
                }
                // bare property read: the desugared get_Name accessor
                // (static tried first, then instance through `this`)
                Node bg = AccessorInChain(curCls, "get_" + e.sval);
                if (bg != null) {
                    if (HasMod(bg, MOD.Static())) {
                        LoadImm(0, 0);
                    } else {
                        LoadLocal(LocalIdx("this"), 0);
                    }
                    BLInternal(MethSymNg(accOwnerCls, bg));
                    return;
                }
                // out-of-block local read: the name still types method-wide
                // (NamedSlotTy), but the scoped slot lookup misses -- the
                // oracle's irgen falls back to constant 0 here, so field
                // reads on the null receiver guard to 0 (qa34 probe parity)
                if (DeclaredLocIdxNg(e.sval) >= 0) { LoadImm(0, 0); return; }
                diags.Error("ngen: unknown identifier '" + e.sval + "'", e.line, e.col);
                LoadImm(0, 0);
                return;
            }
            if (locRef[li]) {
                LoadRefLocal(li);
                return;
            }
            LoadLocalVal(li, 0);
        } else if (k == AK.MemberAccess()) {
            if (e.ival == 1) {
                // null-conditional `a?.m`: the receiver is tested once and
                // a null short-circuits to the null of the result type; a
                // value-typed member result wraps into its cell on the
                // taken path (the reference spelling re-reads the receiver,
                // which the suite's pure receivers make unobservable)
                string qmt = StaticTyOf(e);
                string qpay = IsNulTy(qmt) ? NulPayOf(qmt) : null;
                GenExpr(e.a);                            // x0 = receiver
                int qnull = NL();
                int qfin = NL();
                CbzReg(0, qnull);
                e.ival = 0;                              // ordinary member read
                GenExpr(e);
                e.ival = 1;
                if (qpay != null) { GenNulWrap(IsDblTy(qpay)); }
                EmitB(qfin);
                Mark(qnull);
                LoadImm(0, 0);
                Mark(qfin);
                return;
            }
            if (TryGenHostMember(e)) { return; }
            if ((e.sval == "HasValue" || e.sval == "Value") && e.a != null
                    && IsNulTy(StaticTyOf(e.a))) {
                GenNulMemberRead(e);                     // nullable payload read
                return;
            }
            if (e.sval == "Count" && ExprCls(e.a) == "List") { GenListCount(e.a); }
            else if (e.sval == "Count" && ExprCls(e.a) == "Dict") { GenExpr(e.a); LdrU(0, 0, 0); }
            else if (e.sval == "Count" && IsDictViewAccess(e.a)) {
                GenListCount(e.a);                       // d.Keys.Count / d.Values.Count
            }
            else if ((e.sval == "Keys" || e.sval == "Values") && ExprCls(e.a) == "Dict") {
                // snapshot list: _zan_rt_dict_keys / _dict_values build a
                // List whose slots alias the dict's own keys/values
                GenExpr(e.a);
                BLInternal(e.sval == "Keys" ? "_zan_rt_dict_keys" : "_zan_rt_dict_values");
            }
            else if ((e.sval == "Length" || e.sval == "Count") && ArrContainerTy(e.a) != null) {
                // gen0: null report (reads the zeroed scratch afterwards),
                // length is the i64 count at arr-16; .Count is aliased to
                // .Length so a params bundle answers the List spelling too
                GenExpr(e.a);
                int badn = NL();
                int contn = NL();
                int donen = NL();
                CbzReg(0, badn);
                EmitB(contn);
                Mark(badn);
                LoadSymRef("l_.str." + guardFileIdx, 0);
                LoadImm(1, curLine);
                LoadImm(2, curCol);
                LoadSymRef("l_.str." + guardArrNull, 3);
                BLInternal("_zan_rt_guard_fail3");
                LoadImm(0, 0);
                EmitB(donen);
                Mark(contn);
                if (tgt86 == 1) { LdrU(0, 0, -16); } else { E4(0xF85F0000); }   // ldur x0, [x0, #-16] = mov rdi,[rdi-16]
                Mark(donen);
            }
            else if (e.sval == "Length" && IsStrExpr(e.a)) {
                // gen0 probes the SNAZ header: length lives in the low 32
                // bits of the i64 at s-8; a null string reports and answers 0
                GenExpr(e.a);
                int bads = NL();
                int conts = NL();
                int dones = NL();
                CbzReg(0, bads);
                EmitB(conts);
                Mark(bads);
                LoadSymRef("l_.str." + guardFileIdx, 0);
                LoadImm(1, curLine);
                LoadImm(2, curCol);
                LoadSymRef("l_.str." + guardStrNull, 3);
                BLInternal("_zan_rt_guard_fail3");
                LoadImm(0, 0);
                EmitB(dones);
                Mark(conts);
                E4(0xD1002009);                      // sub x9, x0, #8
                E4(0xF9400120);                      // ldr x0, [x9]
                E4(0xD3407C00);                      // ubfm x0, x0, #0, #31
                Mark(dones);
            }
            else if (e.a != null && e.a.kind == AK.Ident()
                    && FindEnumMemIdx(e.a.sval, e.sval) >= 0) {
                // EnumType.Member constant
                LoadImm(0, enVal[FindEnumMemIdx(e.a.sval, e.sval)]);
            }
            else if ((e.sval == "IsCompleted" || e.sval == "Result")
                    && TaskTyOfNg(e.a) != null) {
                GenTaskMemberRead(e);                    // property-style read
            }
            else if (GenReflPropRead(e)) {               // TypeInfo surface
            }
            else { GenFieldLoad(e); }
        } else if (k == AK.Binary() && e.op == TK.AmpAmp()) {
            // short-circuit AND: the right operand runs only when the left
            // is truthy; result normalises to 0/1
            int falsL = NL();
            int endL = NL();
            GenExpr(e.a);
            CbzReg(0, falsL);
            GenExpr(e.b);
            EmitB(endL);
            Mark(falsL);
            LoadImm(0, 0);
            Mark(endL);
        } else if (k == AK.Binary() && e.op == TK.PipePipe()) {
            int trueL = NL();
            int endL = NL();
            GenExpr(e.a);
            EmitCbnz(0, trueL);
            GenExpr(e.b);
            EmitB(endL);
            Mark(trueL);
            LoadImm(0, 1);
            Mark(endL);
        } else if (k == AK.Binary()) {
            if (TryOpOverloadNg(e)) {
                // the overload call left its result (value or object) in x0
            } else if (TryGenConversionBinaryNg(e)) {
            } else if (e.op == TK.QQ() && IsNulExpr(e.a)) {
                // nullable-value coalescing: the left side is a cell; the
                // result is a payload exactly when the right side is one
                int useB = NL();
                int doneQ = NL();
                bool resDbl = IsDblTy(NulPayOf(StaticTyOf(e.a)));
                GenExpr(e.a);
                CbzReg(0, useB);
                if (!IsNulExpr(e.b)) {
                    LdrU(0, 0, 0);                       // payload out of the cell
                    if (resDbl) { if (tgt86 == 1) { X3(0x66, 0x48, 0x0F); X2(0x6E, 0xC7); } else { E4(0x9E670000); } }      // fmov d0, x0
                } else if (resDbl && IsDblTy(NulPayOf(StaticTyOf(e.b)))) {
                    LdrU(0, 0, 0);                       // both cells: unwrap left
                    if (tgt86 == 1) { X3(0x66, 0x48, 0x0F); X2(0x6E, 0xC7); } else { E4(0x9E670000); }                      // fmov d0, x0
                }
                EmitB(doneQ);
                Mark(useB);
                GenExpr(e.b);
                if (IsNulExpr(e.b) && IsDblTy(NulPayOf(StaticTyOf(e.b)))) {
                    if (tgt86 == 1) { X3(0x66, 0x48, 0x0F); X2(0x6E, 0xC7); } else { E4(0x9E670000); }                      // fmov d0, x0 (cell -> payload)
                }
                Mark(doneQ);
            } else if (IsLiftedNulBinary(e)) {
                GenLiftedNulBinary(e);
            } else if (e.op == TK.QQ() && QQRefShapeNg(e.a) && !IsDblExpr(e.b)) {
                // null coalescing on reference shapes: a != null ? a : b
                int useB = NL();
                int doneQQ = NL();
                GenExpr(e.a);
                EmitCBZ(0, useB);
                EmitB(doneQQ);
                Mark(useB);
                GenExpr(e.b);
                Mark(doneQQ);
            } else if ((e.op == TK.EqEq() || e.op == TK.BangEq())
                    && StructEqPair(e.a, e.b) != null) {
                // struct equality without an overload: field-wise value
                // compare (gen0's aggregate equality; a pointer compare
                // would answer false for equal copies). Batch 32: the x86
                // arm rides the same helpers (LdrU/StringCmp/XSetV0cc)
                // with the two fmovs per-field for the double case.
                Cls sa = StructEqPair(e.a, e.b);
                if (sa != null) {
                    GenExpr(e.a);
                    XPushV0();                  // push a
                    GenExpr(e.b);
                    MovRR(1, 0);                     // x1 = b (a peeked below)
                    int neq = NL();
                    int doneq = NL();
                    // 批43:field-wise 对比走扁平叶(嵌套值字段的载荷
                    // 逐槽比较),合成 width-8 槽 Fld
                    List<Fld> flatEq = new List<Fld>();
                    FlatValueFields(sa, flatEq, 0, new List<string>());
                    int fi = 0;
                    while (fi < flatEq.Count) {
                        LoadFieldNg(2, 1, flatEq[fi]);     // b.f
                        LdrU(3, 31, 0);                  // a (batch 32: was raw ldur)
                        LoadFieldNg(3, 3, flatEq[fi]);     // a.f
                        if (IsDblTy(flatEq[fi].ty)) {
                            // floating fields compare with IEEE semantics:
                            // an unordered pair (NaN) counts as unequal, like
                            // the scalar == lowering
                            if (tgt86 == 1) { X3(0x66, 0x48, 0x0F); X2(0x6E, 0xC1); } else { E4(0x9E670060); }              // fmov d0, x3 / movq xmm0, rcx
                            if (tgt86 == 1) { X3(0x66, 0x48, 0x0F); X2(0x6E, 0xCA); } else { E4(0x9E670041); }              // fmov d1, x2 / movq xmm1, rdx
                            if (tgt86 == 1) { X3(0x66, 0x0F, 0x2F); X1(0xC8); } else { E4(0x1E602020); }              // fcmp d1, d0
                            EmitBcond(6, neq);           // b.vs -> unequal
                            EmitBcond(1, neq);           // b.ne -> unequal
                        } else {
                            StringCmp(3, 2);             // cmp x3, x2
                            EmitBcond(1, neq);           // b.ne
                        }
                        fi = fi + 1;
                    }
                    LoadImm(0, 1);
                    EmitB(doneq);
                    Mark(neq);
                    LoadImm(0, 0);
                    Mark(doneq);
                    AddSPImm(16, true);                  // drop a
                    if (e.op == TK.BangEq()) {
                        ExtCmpImm(0, 0);                 // cmp x0, #0 (batch 32: was raw 32-bit cmp)
                        if (tgt86 == 1) { X3(0x0F, 0x94, 0xC0); X3(0x48, 0x0F, 0xB6); X1(0xF8); } else { E4(0x9A9F17E0); }                  // cset x0, eq (1 = equal)
                    }
                }
            } else if (e.op == TK.Plus() && (IsStrExpr(e.a) || IsStrExpr(e.b))) {
                // string concatenation: non-string operands convert through
                // zan_rt_int2str (gen0 prints them with "%lld"), then
                // lhs -> x0, rhs -> x1, zan_rt_strcat2(lhs, rhs)
                if (IsNulExpr(e.a) && NulPayOf(StaticTyOf(e.a)) != null) {
                    GenNulToStr(e.a);                    // null renders ""
                } else {
                    GenExpr(e.a);
                    if (!IsStrExpr(e.a)) {
                        if (IsDblExpr(e.a)) { BLInternal("_zan_rt_dbl2str"); }
                        else if (IsCharExpr(e.a)) { BLInternal("_zan_rt_chrstr"); }
                        else if (IsUlongExpr(e.a)) { BLInternal("_zan_rt_uint2str"); }
                        else { BLInternal("_zan_rt_int2str"); }
                    }
                }
                XPushV0();                          // str x0, [sp, #-16]!
                if (IsNulExpr(e.b) && NulPayOf(StaticTyOf(e.b)) != null) {
                    GenNulToStr(e.b);                    // null renders ""
                } else {
                    GenExpr(e.b);
                    if (!IsStrExpr(e.b)) {
                        if (IsDblExpr(e.b)) { BLInternal("_zan_rt_dbl2str"); }
                        else if (IsCharExpr(e.b)) { BLInternal("_zan_rt_chrstr"); }
                        else if (IsUlongExpr(e.b)) { BLInternal("_zan_rt_uint2str"); }
                        else { BLInternal("_zan_rt_int2str"); }
                    }
                }
                if (tgt86 == 1) {
                    XPopV(1);                          // lhs -> v1 (rsi)
                    X3(0x49, 0x89, 0xFA);              // mov r10, rdi (rhs)
                    XMov(7, 6);                        // mov rdi, rsi (lhs)
                    X3(0x4C, 0x89, 0xD6);              // mov rsi, r10 (rhs)
                } else {
                    XPopV(1);                    // ldr x1, [sp], #16 (lhs)
                    E4(0xAA0003E9);                    // mov x9, x0
                    MovRR(0, 1);                    // mov x0, x1
                    E4(0xAA0903E1);                    // mov x1, x9
                }
                BLInternal("_zan_rt_strcat2");
            } else if (IsStrExpr(e.a) && IsStrExpr(e.b)
                    && (e.op == TK.EqEq() || e.op == TK.BangEq())) {
                // lexicographic equality via strcmp (gen0 parity)
                GenExpr(e.a);
                XPushV0();                      // push a
                GenExpr(e.b);
                if (tgt86 == 1) { XPopV(1); }             // pop a -> v1 (rsi)
                else { PopV(1); }                  // pop a -> x1 (x0 = b)
                BLInternal("_zan_rt_strcmp0");       // w0 = 0 iff equal
                if (tgt86 == 1) {
                    X3(0x48, 0x85, 0xFF);                // test rdi, rdi
                    X3(0x0F, 0x90 | (e.op == TK.EqEq() ? 4 : 5), 0xC0);  // sete/setne al
                    X3(0x0F, 0xB6, 0xF8);                // movzx edi, al
                } else {
                    E4(0x7100001F);                      // cmp w0, #0
                    if (e.op == TK.EqEq()) { E4(0x9A9F17E0); }   // cset x0, eq
                    else { E4(0x9A9F07E0); }                     // cset x0, ne
                }
            } else if (IsStrExpr(e.a) && IsStrExpr(e.b)
                    && (e.op == TK.Less() || e.op == TK.LessEq()
                     || e.op == TK.Greater() || e.op == TK.GreaterEq())) {
                // relational string comparison: strcmp order, not pool
                // addresses (gen0 parity); null sorts before every string
                GenExpr(e.a);
                XPushV0();                      // push a
                GenExpr(e.b);
                if (tgt86 == 1) {
                    XPopV(1);                            // pop a -> v1
                    X3(0x49, 0x89, 0xFA);                // mov r10, rdi (b)
                    XMov(7, 6);                          // mov rdi, rsi (a)
                    X3(0x4C, 0x89, 0xD6);                // mov rsi, r10 (b)
                } else {
                    XPopV(1);                      // pop a -> x1 (x0 = b)
                    E4(0xAA0003E9);                      // mov x9, x0
                    MovRR(0, 1);                      // mov x0, x1
                    E4(0xAA0903E1);                      // mov x1, x9
                }
                BLInternal("_zan_rt_strcmp0");       // w0 = strcmp(a, b)
                if (tgt86 == 1) {
                    X3(0x48, 0x85, 0xFF);                // test rdi, rdi
                    int xcc = e.op == TK.Less() ? 0x0C
                            : e.op == TK.LessEq() ? 0x0E
                            : e.op == TK.Greater() ? 0x0F : 0x0D;
                    X3(0x0F, 0x90 | xcc, 0xC0);          // setcc al
                    X3(0x0F, 0xB6, 0xF8);                // movzx edi, al
                } else {
                    E4(0x7100001F);                      // cmp w0, #0
                    if (e.op == TK.Less()) { CsetCondX0(11); }          // cset x0, lt
                    else if (e.op == TK.LessEq()) { CsetCondX0(13); }   // cset x0, le
                    else if (e.op == TK.Greater()) { E4(0x9A9FD7E0); }  // cset x0, gt
                    else { E4(0x9A9FB7E0); }                            // cset x0, ge
                }
            } else if (IsDblExpr(e.a) || IsDblExpr(e.b)) {
                // double arithmetic/comparison: values travel as i64 bit
                // patterns in x0; the op materialises d-regs, coercing int
                // operands with scvtf. Comparisons are the ordered ones (a
                // NaN input always answers false, true only for !=).
                if (tgt86 == 1) {
                    // SSE twin: a in xmm1, b in xmm0 (bit patterns ride
                    // rsi/rdi until movq materialises them). Ordered
                    // compares come from comisd + setcc with the parity
                    // bit folded in for eq/ne; NaN answers false except
                    // !=. fmod keeps the true FP ABI (xmm0/xmm1) and
                    // returns in xmm0, so its call bypasses the rax tail.
                    GenExpr(e.a);
                    XPushV0();
                    GenExpr(e.b);
                    XPopV(1);                      // rdi = b, rsi = a
                    if (IsDblExpr(e.b)) { X3(0x66, 0x48, 0x0F); X2(0x6E, 0xC7); }   // movq xmm0, rdi
                    else { X3(0xF2, 0x48, 0x0F); X2(0x2A, 0xC7); }                  // cvtsi2sd xmm0, rdi
                    if (IsDblExpr(e.a)) { X3(0x66, 0x48, 0x0F); X2(0x6E, 0xCE); }   // movq xmm1, rsi
                    else { X3(0xF2, 0x48, 0x0F); X2(0x2A, 0xCE); }                  // cvtsi2sd xmm1, rsi
                    int op = e.op;
                    if (op == TK.Plus()) {
                        X2(0xF2, 0x0F); X2(0x58, 0xC8);   // addsd xmm1, xmm0
                    } else if (op == TK.Minus()) {
                        X2(0xF2, 0x0F); X2(0x5C, 0xC8);   // subsd xmm1, xmm0
                    } else if (op == TK.Star()) {
                        X2(0xF2, 0x0F); X2(0x59, 0xC8);   // mulsd xmm1, xmm0
                    } else if (op == TK.Slash()) {
                        X2(0xF2, 0x0F); X2(0x5E, 0xC8);   // divsd xmm1, xmm0 (IEEE, no guard)
                    } else if (op == TK.Percent()) {
                        // C# `%` keeps the dividend's sign (C fmod). SysV:
                        // xmm0 = a, xmm1 = b, result xmm0 -- no rax tail.
                        X3(0x66, 0x0F, 0x28); X1(0xC1);          // movapd xmm0, xmm1
                        X1(0xE8);                                // call _fmod
                        fixups.Add(new Fixup(txt.Count - 1, 4, 0, 0, "_fmod"));
                        X4(0);
                        X3(0x66, 0x48, 0x0F); X2(0x7E, 0xC7);    // movq rdi, xmm0
                        return;
                    } else if (op == TK.Less()) {
                        X3(0x66, 0x0F, 0x2F); X1(0xC1);          // comisd xmm0, xmm1
                        XSetV0cc(0x97);                          // seta (b>a ordered <=> a<b)
                        return;
                    } else if (op == TK.Greater()) {
                        X3(0x66, 0x0F, 0x2F); X1(0xC8);          // comisd xmm1, xmm0
                        XSetV0cc(0x97);                          // seta
                        return;
                    } else if (op == TK.LessEq()) {
                        X3(0x66, 0x0F, 0x2F); X1(0xC1);          // comisd xmm0, xmm1
                        XSetV0cc(0x93);                          // setae (b>=a <=> a<=b)
                        return;
                    } else if (op == TK.GreaterEq()) {
                        X3(0x66, 0x0F, 0x2F); X1(0xC8);          // comisd xmm1, xmm0
                        XSetV0cc(0x93);                          // setae
                        return;
                    } else if (op == TK.EqEq()) {
                        // eq = ZF set AND parity clear (unordered is ZF=PF=1)
                        X3(0x66, 0x0F, 0x2F); X1(0xC8);          // comisd xmm1, xmm0
                        X3(0x0F, 0x94, 0xC0);                    // sete al
                        X3(0x0F, 0x9B, 0xC2);                    // setnp dl
                        X2(0x22, 0xC2);                          // and al, dl
                        X3(0x48, 0x0F, 0xB6); X1(0xF8);          // movzx rdi, al
                        return;
                    } else if (op == TK.BangEq()) {
                        // ne = not-equal OR unordered (parity set)
                        X3(0x66, 0x0F, 0x2F); X1(0xC8);          // comisd xmm1, xmm0
                        X3(0x0F, 0x95, 0xC0);                    // setne al
                        X3(0x0F, 0x9A, 0xC2);                    // setp dl
                        X2(0x08, 0xD0);                          // or al, dl
                        X3(0x48, 0x0F, 0xB6); X1(0xF8);          // movzx rdi, al
                        return;
                    } else {
                        diags.Error("ngen: unsupported double operator " + op, e.line, e.col);
                        return;
                    }
                    X3(0x66, 0x48, 0x0F); X2(0x7E, 0xCF);        // movq rdi, xmm1
                    return;
                }
                GenExpr(e.a);
                XPushV0();                      // str x0, [sp, #-16]!
                GenExpr(e.b);
                XPopV(1);                      // ldr x1, [sp], #16
                int op = e.op;
                if (IsDblExpr(e.a)) { if (tgt86 == 1) { X3(0x66, 0x48, 0x0F); X2(0x6E, 0xC6); } else { E4(0x9E670020); } }  // fmov d0, x1 (movq xmm0, rsi)
                else { if (tgt86 == 1) { X4(0x2A0F48F2); X1(0xC6); } else { E4(0x9E620020); } }                 // scvtf d0, x1 (cvtsi2sd xmm0, rsi)
                if (IsDblExpr(e.b)) { if (tgt86 == 1) { X3(0x66, 0x48, 0x0F); X2(0x6E, 0xCF); } else { E4(0x9E670001); } }  // fmov d1, x0 (movq xmm1, rdi)
                else { if (tgt86 == 1) { X4(0x2A0F48F2); X1(0xCF); } else { E4(0x9E620001); } }                 // scvtf d1, x0 (cvtsi2sd xmm1, rdi)
                if (op == TK.Plus()) {
                    if (tgt86 == 1) { X4(0xC1580FF2); } else { E4(0x1E602820); }                  // fadd d0, d1, d0
                    if (tgt86 == 1) { X3(0x66, 0x48, 0x0F); X2(0x7E, 0xC7); } else { E4(0x9E660000); }                  // fmov x0, d0
                } else if (op == TK.Minus()) {
                    if (tgt86 == 1) { X4(0xC15C0FF2); } else { E4(0x1E613800); }                  // fsub d0, d0, d1
                    if (tgt86 == 1) { X3(0x66, 0x48, 0x0F); X2(0x7E, 0xC7); } else { E4(0x9E660000); }
                } else if (op == TK.Star()) {
                    if (tgt86 == 1) { X4(0xC1590FF2); } else { E4(0x1E600820); }                  // fmul d0, d1, d0
                    if (tgt86 == 1) { X3(0x66, 0x48, 0x0F); X2(0x7E, 0xC7); } else { E4(0x9E660000); }
                } else if (op == TK.Slash()) {
                    if (tgt86 == 1) { X4(0xC15E0FF2); } else { E4(0x1E611800); }                  // fdiv d0, d0, d1 (IEEE: no guard, like gen0)
                    if (tgt86 == 1) { X3(0x66, 0x48, 0x0F); X2(0x7E, 0xC7); } else { E4(0x9E660000); }
                } else if (op == TK.Percent()) {
                    // C# `%` on doubles keeps the dividend's sign (C fmod):
                    // the oracle lowers to LLVM frem, which the ARM64
                    // backend realizes as a libm fmod call
                    BLExtern("_fmod");
                    if (tgt86 == 1) { X3(0x66, 0x48, 0x0F); X2(0x7E, 0xC7); } else { E4(0x9E660000); }                  // fmov x0, d0
                } else if (op == TK.Less()) {
                    if (tgt86 == 1) { X3(0x66, 0x0F, 0x2F); X1(0xC1); } else { E4(0x1E612000); }                  // fcmp d0, d1
                    if (tgt86 == 1) { X3(0x0F, 0x92, 0xC0); X3(0x48, 0x0F, 0xB6); X1(0xF8); } else { E4(0x9A9F57E0); }                  // cset x0, mi
                } else if (op == TK.Greater()) {
                    if (tgt86 == 1) { X3(0x66, 0x0F, 0x2F); X1(0xC1); } else { E4(0x1E612000); }                  // fcmp d0, d1
                    if (tgt86 == 1) { X3(0x0F, 0x97, 0xC0); X3(0x48, 0x0F, 0xB6); X1(0xF8); } else { E4(0x9A9FD7E0); }                  // cset x0, gt
                } else if (op == TK.LessEq()) {
                    if (tgt86 == 1) { X3(0x66, 0x0F, 0x2F); X1(0xC8); } else { E4(0x1E602020); }                  // fcmp d1, d0 (swapped: a<=b <=> b>=a)
                    if (tgt86 == 1) { X3(0x0F, 0x93, 0xC0); X3(0x48, 0x0F, 0xB6); X1(0xF8); } else { E4(0x9A9FB7E0); }                  // cset x0, ge
                } else if (op == TK.GreaterEq()) {
                    if (tgt86 == 1) { X3(0x66, 0x0F, 0x2F); X1(0xC1); } else { E4(0x1E612000); }                  // fcmp d0, d1
                    if (tgt86 == 1) { X3(0x0F, 0x93, 0xC0); X3(0x48, 0x0F, 0xB6); X1(0xF8); } else { E4(0x9A9FB7E0); }                  // cset x0, ge
                } else if (op == TK.EqEq()) {
                    int set0 = NL();
                    int done2 = NL();
                    if (tgt86 == 1) { X3(0x66, 0x0F, 0x2F); X1(0xC8); } else { E4(0x1E602020); }                  // fcmp d1, d0
                    if (tgt86 == 1) { X2(0x0F, 0x8A); fixups.Add(new Fixup(txt.Count - 2, 1, set0, 6, null)); X4(0); } else { EmitBcond(6, set0); }   // b.vs -> unordered: false (comisd = parity)
                    if (tgt86 == 1) { X3(0x0F, 0x94, 0xC0); X3(0x48, 0x0F, 0xB6); X1(0xF8); } else { E4(0x9A9F17E0); }                  // cset x0, eq
                    EmitB(done2);
                    Mark(set0);
                    LoadImm(0, 0);
                    Mark(done2);
                } else if (op == TK.BangEq()) {
                    int set1 = NL();
                    int done3 = NL();
                    if (tgt86 == 1) { X3(0x66, 0x0F, 0x2F); X1(0xC8); } else { E4(0x1E602020); }                  // fcmp d1, d0
                    if (tgt86 == 1) { X2(0x0F, 0x8A); fixups.Add(new Fixup(txt.Count - 2, 1, set1, 6, null)); X4(0); } else { EmitBcond(6, set1); }   // b.vs -> unordered: true (comisd = parity)
                    if (tgt86 == 1) { X3(0x0F, 0x95, 0xC0); X3(0x48, 0x0F, 0xB6); X1(0xF8); } else { E4(0x9A9F07E0); }                  // cset x0, ne
                    EmitB(done3);
                    Mark(set1);
                    LoadImm(0, 1);
                    Mark(done3);
                } else {
                    diags.Error("ngen: unsupported double operator " + op, e.line, e.col);
                }
            } else {
                GenExpr(e.a);
                if (tgt86 == 1) { XPushV0(); } else { XPushV0(); }   // str x0, [sp, #-16]!
                GenExpr(e.b);
                if (tgt86 == 1) { XPopV(1); } else { PopV(1); }    // ldr x1, [sp], #16
                int op = e.op;
                if (tgt86 == 1) { X86IntBinop(e, op); }
                else if (IsUlongExpr(e.a) || IsUlongExpr(e.b)
                        || (Int32Kind(e.a) == 2 && Int32Kind(e.b) == 2)) {
                    // unsigned 64-bit: add/sub/mul keep the full i64 result
                    // (gen0's uint reads are 64-bit; the declared-width slot
                    // store truncates), division drops the MIN/-1 fold,
                    // comparisons go unsigned, and >> is logical
                    if (tgt86 == 1) { XFailClosed("ulong operators", curLine, curCol); return; }
                    bool bothU = Int32Kind(e.a) == 2 && Int32Kind(e.b) == 2;
                    if (op == TK.Plus()) {
                        AddRR(0, 1, 0);                  // add x0, x1, x0
                    } else if (op == TK.Minus()) {
                        SubRR(0, 1, 0);                  // sub x0, x1, x0
                    } else if (op == TK.Star()) {
                        MaddRR(0, 1, 0, 31);                  // mul x0, x1, x0
                    } else if (op == TK.Slash() || op == TK.Percent()) {
                        int bad = NL();
                        int cont = NL();
                        CbzReg(0, bad);
                        EmitB(cont);
                        Mark(bad);
                        XPushR(1);                  // str x1, [sp, #-16]! (keep dividend)
                        LoadSymRef("l_.str." + guardFileIdx, 0);
                        LoadImm(1, curLine);
                        LoadImm(2, curCol);
                        if (op == TK.Slash()) { LoadSymRef("l_.str." + guardDivIdx, 3); }
                        else { LoadSymRef("l_.str." + guardModIdx, 3); }
                        BLInternal("_zan_rt_guard_fail3");
                        XPopV(1);                  // ldr x1, [sp], #16
                        LoadImm(0, 1);                   // safe divisor
                        Mark(cont);
                        if (op == TK.Slash()) {
                            E4(0x9AC00820);              // udiv x0, x1, x0
                        } else {
                            E4(0x9AC00824);              // udiv x4, x1, x0
                            E4(0x9B008480);              // msub x0, x4, x0, x1
                        }
                    } else if (op == TK.Less()) {
                        CmpRR(1, 0);                  // cmp x1, x0
                        CsetCondX0(3);                  // cset x0, lo
                    } else if (op == TK.Greater()) {
                        CmpRR(1, 0);
                        E4(0x9A9F97E0);                  // cset x0, hi
                    } else if (op == TK.LessEq()) {
                        CmpRR(1, 0);
                        E4(0x9A9F87E0);                  // cset x0, ls
                    } else if (op == TK.GreaterEq()) {
                        CmpRR(1, 0);
                        E4(0x9A9F37E0);                  // cset x0, hs
                    } else if (op == TK.EqEq()) {
                        CmpRR(1, 0);
                        if (tgt86 == 1) { X3(0x0F, 0x94, 0xC0); X3(0x48, 0x0F, 0xB6); X1(0xF8); } else { E4(0x9A9F17E0); }                  // cset x0, eq
                    } else if (op == TK.BangEq()) {
                        CmpRR(1, 0);
                        if (tgt86 == 1) { X3(0x0F, 0x95, 0xC0); X3(0x48, 0x0F, 0xB6); X1(0xF8); } else { E4(0x9A9F07E0); }                  // cset x0, ne
                    } else if (op == TK.LessLess()) {
                        if (bothU) { E4(0x92401000); }   // and x0, x0, #31
                        E4(0x9AC02020);                  // lslv x0, x1, x0
                    } else if (op == TK.GreaterGreater()) {
                        if (bothU) { E4(0x92401000); }   // and x0, x0, #31
                        E4(0x9AC02420);                  // lsrv x0, x1, x0
                    } else if (op == TK.GreaterGreaterGreater()) {
                        if (bothU) { E4(0x92401000); }   // and x0, x0, #31
                        E4(0x9AC02420);                  // lsrv x0, x1, x0
                    } else if (op == TK.Amp()) {
                        E4(0x8A000020);                  // and x0, x1, x0
                    } else if (op == TK.Pipe()) {
                        E4(0xAA000020);                  // orr x0, x1, x0
                    } else if (op == TK.Caret()) {
                        E4(0xCA000020);                  // eor x0, x1, x0
                    } else {
                        diags.Error("ngen: unsupported ulong operator " + op, e.line, e.col);
                    }
                } else if (op == TK.Plus()) {
                    AddRR(0, 1, 0);                      // add x0, x1, x0
                    if (Int32Kind(e.a) == 1 && Int32Kind(e.b) == 1) { Wrap32(1); }
                } else if (op == TK.Minus()) {
                    SubRR(0, 1, 0);                      // sub x0, x1, x0
                    if (Int32Kind(e.a) == 1 && Int32Kind(e.b) == 1) { Wrap32(1); }
                } else if (op == TK.Star()) {
                    MaddRR(0, 1, 0, 31);                      // mul x0, x1, x0
                    if (Int32Kind(e.a) == 1 && Int32Kind(e.b) == 1) { Wrap32(1); }
                } else if (op == TK.Slash() || op == TK.Percent()) {
                    // divide/modulo: x1 = dividend, x0 = divisor. A zero
                    // divisor reports through zan_rt_guard_fail3 -- the same
                    // C-runtime guard the IR backend links -- and continues
                    // with divisor 1; INT_MIN / -1 also divides by 1 to
                    // avoid the SIGFPE trap, mirroring gen0's select guard.
                    int bad = NL();
                    int cont = NL();
                    int safe = NL();
                    CbzReg(0, bad);
                    EmitB(cont);
                    Mark(bad);
                    XPushR(1);                      // str x1, [sp, #-16]! (keep dividend across the call)
                    LoadSymRef("l_.str." + guardFileIdx, 0);
                    LoadImm(1, curLine);
                    LoadImm(2, curCol);
                    if (op == TK.Slash()) { LoadSymRef("l_.str." + guardDivIdx, 3); }
                    else { LoadSymRef("l_.str." + guardModIdx, 3); }
                    BLInternal("_zan_rt_guard_fail3");
                    XPopV(1);                      // ldr x1, [sp], #16 (own push; cont must not pop)
                    LoadImm(0, 1);                       // safe divisor
                    Mark(cont);
                    LoadImm(2, 0x8000000000000000);      // i64 min
                    LoadImm(3, -1);
                    if (tgt86 == 1) { Xop(0x39, 7, 1); } else { E4(0xEB03001F); }                      // cmp x0, x3
                    EmitBcond(1, safe);                  // b.ne safe
                    CmpRR(1, 2);                      // cmp x1, x2
                    EmitBcond(1, safe);
                    LoadImm(0, 1);
                    Mark(safe);
                    if (op == TK.Slash()) {
                        E4(0x9AC00C20);                  // sdiv x0, x1, x0
                        // the 64-bit quotient of INT_MIN / -1 is +2^31;
                        // int semantics wrap it back to INT_MIN
                        if (Int32Kind(e.a) == 1 && Int32Kind(e.b) == 1) { Wrap32(1); }
                    } else {
                        E4(0x9AC00C24);                  // sdiv x4, x1, x0
                        E4(0x9B008480);                  // msub x0, x4, x0, x1
                    }
                } else if (op == TK.Less()) {
                    CmpRR(1, 0);                      // cmp x1, x0
                    CsetCondX0(11);                      // cset x0, lt
                } else if (op == TK.Greater()) {
                    CmpRR(1, 0);                      // cmp x1, x0
                    if (tgt86 == 1) { X3(0x0F, 0x97, 0xC0); X3(0x48, 0x0F, 0xB6); X1(0xF8); } else { E4(0x9A9FD7E0); }                      // cset x0, gt
                } else if (op == TK.LessEq()) {
                    CmpRR(1, 0);                      // cmp x1, x0
                    CsetCondX0(13);                      // cset x0, le
                } else if (op == TK.GreaterEq()) {
                    CmpRR(1, 0);                      // cmp x1, x0
                    if (tgt86 == 1) { X3(0x0F, 0x93, 0xC0); X3(0x48, 0x0F, 0xB6); X1(0xF8); } else { E4(0x9A9FB7E0); }                      // cset x0, ge
                } else if (op == TK.EqEq()) {
                    CmpRR(1, 0);                      // cmp x1, x0
                    if (tgt86 == 1) { X3(0x0F, 0x94, 0xC0); X3(0x48, 0x0F, 0xB6); X1(0xF8); } else { E4(0x9A9F17E0); }                      // cset x0, eq
                } else if (op == TK.BangEq()) {
                    CmpRR(1, 0);                      // cmp x1, x0
                    if (tgt86 == 1) { X3(0x0F, 0x95, 0xC0); X3(0x48, 0x0F, 0xB6); X1(0xF8); } else { E4(0x9A9F07E0); }                      // cset x0, ne
                } else if (op == TK.LessLess()) {
                    // shifts compute at 64 bits; only the count masks, by the
                    // left operand's DECLARED width (a bare literal declares
                    // int), and an int target narrows the result at the store
                    if (ShiftMask32(e.a)) { E4(0x92401000); }   // and x0, x0, #31
                    E4(0x9AC02020);                      // lslv x0, x1, x0
                } else if (op == TK.GreaterGreater()) {
                    if (ShiftMask32(e.a)) { E4(0x92401000); }   // and x0, x0, #31
                    E4(0x9AC02820);                      // asrv x0, x1, x0
                } else if (op == TK.GreaterGreaterGreater()) {
                    // always logical; the 64-bit result stays untruncated
                    // here -- an int target narrows it at the store
                    if (ShiftMask32(e.a)) { E4(0x92401000); }   // and x0, x0, #31
                    E4(0x9AC02420);                      // lsrv x0, x1, x0
                } else if (op == TK.Amp()) {
                    E4(0x8A000020);                      // and x0, x1, x0
                } else if (op == TK.Pipe()) {
                    E4(0xAA000020);                      // orr x0, x1, x0
                } else if (op == TK.Caret()) {
                    E4(0xCA000020);                      // eor x0, x1, x0
                } else {
                    diags.Error("ngen: unsupported operator " + op, e.line, e.col);
                }
            }
        } else if (k == AK.Unary()) {
            GenExpr(e.a);
            if (e.op == TK.Minus()) {
                if (IsDblExpr(e.a)) {
                    if (tgt86 == 1) {
                        // fneg = flip the double's sign bit; the value rides
                        // as i64 bits in rdi, so an integer xor is exact
                        // (r11 is the lane's scratch, dead across an operand)
                        X2(0x49, 0xBB); X4(0); X4(0x80000000);      // movabs r11, 0x8000...0 (10B: opcode+imm64)
                        X3(0x4C, 0x31, 0xDF);                       // xor rdi, r11 (REX.R -> r11)
                    } else {
                        if (tgt86 == 1) { X3(0x66, 0x48, 0x0F); X2(0x6E, 0xC7); } else { E4(0x9E670000); }                  // fmov d0, x0
                        E4(0x1E614000);                  // fneg d0, d0
                        if (tgt86 == 1) { X3(0x66, 0x48, 0x0F); X2(0x7E, 0xC7); } else { E4(0x9E660000); }                  // fmov x0, d0
                    }
                } else {
                    if (tgt86 == 1) { X3(0x48, 0xF7, 0xDF); }   // neg rdi, rdi
                    else { E4(0xCB0003E0); }                  // neg x0, x0 (sub x0, xzr, x0)
                    // only a 32-bit-domain signed operand wraps at the neg
                    // (uint reads are 64-bit; literals are 64-bit)
                    if (Int32Kind(e.a) == 1) { Wrap32(1); }
                }
            } else if (e.op == TK.Bang()) {
                // logical not on every operand shape: `!x` is (x == 0),
                // matching the IR's icmp eq 0 (irgen_expr) -- this is what
                // makes `!d.ContainsKey(k)` behave on an int-shaped 0/1
                // predicate
                if (tgt86 == 1) {
                    X3(0x48, 0x85, 0xFF);                // test rdi, rdi
                    X3(0x0F, 0x94, 0xC0);                // sete al
                    X3(0x48, 0x0F, 0xB6); X1(0xF8);      // movzx rdi, al
                } else {
                    E4(0xF100001F);                      // cmp x0, #0
                    if (tgt86 == 1) { X3(0x0F, 0x94, 0xC0); X3(0x48, 0x0F, 0xB6); X1(0xF8); } else { E4(0x9A9F17E0); }                      // cset x0, eq
                }
            } else if (e.op == TK.Tilde()) {
                // source-level `~`: the C# bitwise complement
                if (tgt86 == 1) { X3(0x48, 0xF7, 0xD7); }   // not rdi, rdi
                else { E4(0xAA2003E0); }                      // orn x0, xzr, x0 (mvn)
            } else if (e.op == TK.PlusPlus() || e.op == TK.MinusMinus()) {
                // prefix ++/--: yield the NEW value
                GenIncDec(e.a, e.op == TK.PlusPlus(), true);
            }
            // unary plus is a no-op on the bit pattern
        } else if (k == AK.CastExpr() && e.type != null) {
            if (TryGenConversionCastNg(e)) { return; }
            // numeric casts: int<->ulong share the slot bits; to/from
            // double converts via scvtf/fcvtzs (like gen0's fptosi/sitofp)
            string ty = e.type.sval;
            bool toDbl = IsDblTy(ty);
            bool fromDbl = IsDblExpr(e.b);
            if (toDbl && !fromDbl) {
                GenExpr(e.b);
                if (tgt86 == 1) {
                    X2(0xF2, 0x0F); X2(0x2A, 0xC7);   // cvtsi2sd xmm0, rdi
                    X3(0x66, 0x48, 0x0F); X2(0x7E, 0xC7);   // movq rdi, xmm0
                } else {
                    if (tgt86 == 1) { X4(0x2A0F48F2); X1(0xC7); } else { E4(0x9E620000); }                      // scvtf d0, x0
                    if (tgt86 == 1) { X3(0x66, 0x48, 0x0F); X2(0x7E, 0xC7); } else { E4(0x9E660000); }                      // fmov x0, d0
                }
            } else if (!toDbl && fromDbl) {
                GenExpr(e.b);
                if (tgt86 == 1) {
                    X3(0x66, 0x48, 0x0F); X2(0x6E, 0xC7);   // movq xmm0, rdi (bits)
                    X2(0xF2, 0x48); X2(0x0F, 0x2C); X1(0xF8);   // cvttsd2si rdi, xmm0
                } else {
                    if (tgt86 == 1) { X3(0x66, 0x48, 0x0F); X2(0x6E, 0xC7); } else { E4(0x9E670000); }                      // fmov d0, x0
                    E4(0x9E780000);                      // fcvtzs x0, d0
                }
                if (ty == "int") { Sxtw0(); } // wrap the saturated i64 down to i32
            } else {
                // a static method group casts to its raw code address (the
                // oracle's native method-group value), not a delegate pair
                int rawMg = StaticGroupCastIdxNg(e);
                if (rawMg >= 0) { LoadSymRef(MethSymNg(methCls[rawMg], methNodes[rawMg]), 0); }
                else { GenExpr(e.b); }               // int<->ulong (and dbl->dbl): bits unchanged
                // (DelegateTy)nintExpr: a runtime-resolved address becomes a
                // bare code pointer (the oracle's `(WndProc)addr`, its
                // int->ptr cast). Bit 0 tags "call directly with the declared
                // signature, no env"; interned delegate pairs are even, so
                // the invoke branch never confuses the two shapes.
                if (IsDelegateTyNg(TypeFullName(e.type)) && !IsDelegateTyNg(StaticTyOf(e.b))) {
                    if (tgt86 == 1) { X2(0x48, 0x83); X2(0xCF, 0x01); }   // or rdi, 1
                    else { E4(0xB2400000); }         // orr x0, x0, #1
                }
                // narrow casts wrap at the declared width, like gen0's
                // truncating integer conversions
                // 批38:x86 臂补齐——这族全是 0-槽(rdi)就地变换,编码对齐
                // 1380/1386 已验证的 movsx 族;mov edi,edi 是 32 位自拷贝,
                // 写回时清高 32(零扩展语义,=arm64 ubfm)
                if (ty == "int") { Sxtw0(); }             // sbfm #31 / movsxd rdi, edi
                else if (ty == "uint") { if (tgt86 == 1) { X2(0x89, 0xFF); } else { E4(0xD3407C00); } }       // ubfm #31 / mov edi, edi
                // modrm 必须 FF(rm=111 → di/dil,值在 v0=rdi):1380 处的
                // F8(rm=000 → ax)在那站是良性的——XCallSeq 收尾 mov rdi, rax
                // 让 ax==di;这里值只在 rdi,照抄就会扩展出垃圾低 16 位
                else if (ty == "short") { if (tgt86 == 1) { X3(0x48, 0x0F, 0xBF); X1(0xFF); } else { E4(0x93403C00); } }      // sbfm #15 / movsx rdi, di
                else if (ty == "ushort" || ty == "char") { if (tgt86 == 1) { X3(0x0F, 0xB7, 0xFF); } else { E4(0xD3403C00); } }  // ubfm #15 / movzx edi, di
                else if (ty == "sbyte") { if (tgt86 == 1) { X3(0x48, 0x0F, 0xBE); X1(0xFF); } else { E4(0x93401C00); } }      // sbfm #7 / movsx rdi, dil
                else if (ty == "byte") { if (tgt86 == 1) { X1(0x40); X3(0x0F, 0xB6, 0xFF); } else { E4(0xD3401C00); } }   // ubfm #7 / movzx edi, dil (dil 需 REX)
            }
        } else if (k == AK.Index()) {
            if (IsStrExpr(e.a)) {
                // char access: bounds-checked byte load (gen0 reports the
                // same guard message and continues with index 0); a null
                // base reports too and answers 0 like the zeroed scratch
                GenExpr(e.a);
                XPushV0();                      // push s
                GenExpr(e.b);
                XPopV(1);                      // pop s -> x1 (x0 = idx)
                int bad = NL();
                int ldok = NL();
                int done = NL();
                int nulls = NL();
                CbzReg(1, nulls);                    // null base
                EmitB(ldok);
                Mark(nulls);
                LoadSymRef("l_.str." + guardFileIdx, 0);
                LoadImm(1, e.line);
                LoadImm(2, e.col);
                LoadSymRef("l_.str." + guardStrNull, 3);
                BLInternal("_zan_rt_guard_fail3");
                LoadImm(0, 0);
                EmitB(done);
                Mark(ldok);
                SubImm(2, 1, 8);                      // sub x2, x1, #8
                LdrU(2, 2, 0);                       // ldr x2, [x2]
                Uxtw32(2, 2);                        // ubfm x2, x2, #0, #31 (len)
                if (tgt86 == 1) { Xop(0x39, 7, 2); } else { E4(0xEB02001F); }                      // cmp x0, x2
                EmitBcond(10, bad);                  // b.ge bad
                if (tgt86 == 1) { X3(0x48, 0x83, 0xFF); X1(0x00); } else { E4(0xEB1F001F); }                      // cmp x0, xzr
                EmitBcond(11, bad);                  // b.lt bad
                if (tgt86 == 1) { X3(0x0F, 0xB6, 0x3C); X1(0x3E); } else { E4(0x38606820); } // ldrb w0, [x1, x0] = movzx edi,[rsi+rdi] (v0 home rdi)
                EmitB(done);
                Mark(bad);
                XPushR(1);                      // keep s across the call
                LoadSymRef("l_.str." + guardFileIdx, 0);
                LoadImm(1, e.line);
                LoadImm(2, e.col);
                LoadSymRef("l_.str." + guardStrIdx, 3);
                BLInternal("_zan_rt_guard_fail3");
                XPopV(1);                      // pop s
                LoadImm(0, 0);                       // safe index
                Mark(done);
            } else if (e.a != null && ArrContainerTy(e.a) != null && e.kids.Count > 0) {
                // rectangular element get (B8): per-dim bounds then a
                // row-major flat index; dims at arr+8d, data at arr+8*rank
                int nsub = 1 + e.kids.Count;
                string ct = ArrContainerTy(e.a);
                MdPrologueNg(e);
                MdFlatNg(e, nsub, e.line, e.col);
                AddImm(19, 19, 8 * nsub);          // data base = arr + 8*rank
                EmitArrElemLoad(ArrElemSize(ct), ArrElemName(ct), 19, 9, 0);
            } else if (ArrContainerTy(e.a) != null) {
                // array element get: len = i64 at arr-16; a bad index reports
                // and continues with index 0 (gen0 parity). int[] stores i32.
                int esz = ArrElemSize(ArrContainerTy(e.a));
                GenExpr(e.a);
                XPushV0();                      // push arr
                GenExpr(e.b);
                XPopV(1);                      // pop arr -> x1 (x0 = idx)
                if (tgt86 == 1) { LdrU(2, 1, -16); } else { E4(0xF85F0022); }   // ldur x2, [x1, #-16] (len) = mov rdx,[rsi-16]
                int bad = NL();
                int cont = NL();
                StringCmp(0, 2);                     // cmp x0, x2
                EmitBcond(10, bad);                  // b.ge bad
                StringCmp(0, 31);                    // cmp x0, xzr
                EmitBcond(11, bad);                  // b.lt bad
                EmitB(cont);
                Mark(bad);
                XPushR(1);                      // keep arr (guard clobbers x1)
                XPushV0();                      // keep idx
                LoadSymRef("l_.str." + guardFileIdx, 0);
                LoadImm(1, e.line);
                LoadImm(2, e.col);
                LoadSymRef("l_.str." + guardArrIdx, 3);
                BLInternal("_zan_rt_guard_fail3");
                XPopV(0);                      // pop idx
                XPopV(1);                      // pop arr
                LoadImm(0, 0);
                Mark(cont);
                EmitArrElemLoad(esz, ArrElemName(ArrContainerTy(e.a)), 1, 0, 0);
            } else if (e.a != null && e.a.kind == AK.NewExpr() && IsSpanNew(e.a)) {
                // Span<T> element get: deref the view's {base, len} box,
                // bounds-checked like an array
                int sesz = SpanElemSize(e.a);
                string sel = SpanElemTy(e.a);
                GenExpr(e.a);                        // box -> x0
                XPushV0();                      // push box
                GenExpr(e.b);                        // idx -> x0
                SpanBoxDeref();                      // x1 = base, x2 = len
                SpanIdxGuard(e.line, e.col, 0);
                EmitSpanElemLoad(sel, sesz);
            } else if (SpanContainerTy(e.a) != null) {
                // local/field Span<T> element get: deref the view's
                // {base, len} box, bounds-checked like an array
                string sct = SpanContainerTy(e.a);
                GenExpr(e.a);                        // box -> x0
                XPushV0();                      // push box
                GenExpr(e.b);                        // idx -> x0
                SpanBoxDeref();                      // x1 = base, x2 = len
                SpanIdxGuard(e.line, e.col, 0);
                EmitSpanElemLoad(SpanTyElem(sct), SpanTyElemSize(sct));
            } else if (ExprCls(e.a) == "Dict") {
                DictCheckOperand(e.a, e.b, true);
                // d[key] get: _zan_rt_dict_get returns 0 for a missing key
                // (zero-value semantics, gen0 parity); a struct value reads
                // out as a fresh copy so mutations never write through
                GenExpr(e.a);                        // dict -> x0
                XPushV0();                      // push dict
                GenExpr(e.b);                        // key -> x0
                MovRR(1, 0);                         // x1 = key
                XPopV(0);                      // pop dict -> x0
                BLInternal("_zan_rt_dict_get");
                int skipGc = NL();
                CbzReg(0, skipGc);                   // missing key: stay 0
                GenCloneIfStruct(e);
                Mark(skipGc);
            } else if (ExprCls(e.a) == "List" || IsDictViewAccess(e.a)) {
                // element get: data = obj+16, count = obj+0, 8-byte slots
                // (a Dictionary Keys/Values snapshot view indexes the same
                // way -- the member read already lowers to the snapshot list)
                GenExpr(e.a);
                XPushV0();                      // push obj
                GenExpr(e.b);
                XPopV(1);                      // pop obj -> x1 (x0 = idx)
                LdrU(2, 1, 0);                       // count
                LdrU(3, 1, 16);                      // data
                int bad = NL();
                int cont = NL();
                if (tgt86 == 1) { Xop(0x39, 7, 2); } else { E4(0xEB02001F); }                      // cmp x0, x2
                EmitBcond(10, bad);                  // b.ge bad
                if (tgt86 == 1) { X3(0x48, 0x83, 0xFF); X1(0x00); } else { E4(0xEB1F001F); }                      // cmp x0, xzr
                EmitBcond(11, bad);                  // b.lt bad
                EmitB(cont);
                Mark(bad);
                XPushR(3);                      // keep data (guard clobbers x3)
                XPushV0();                      // keep idx
                LoadSymRef("l_.str." + guardFileIdx, 0);
                LoadImm(1, e.line);
                LoadImm(2, e.col);
                LoadSymRef("l_.str." + guardListIdx, 3);
                BLInternal("_zan_rt_guard_fail3");
                XPopV(0);                      // pop idx
                XPopV(3);                      // pop data
                LoadImm(0, 0);
                Mark(cont);
                int gEnd = NL();
                CbzReg(3, gEnd);                     // empty list: backing is null
                if (tgt86 == 1) { X3(0x48, 0x8B, 0x3C); X1(0xF9); } else { E4(0xF8607860); } // ldr x0,[x3,x0,lsl#3] = mov rdi,[rcx+rdi*8] (v0 home rdi)
                Mark(gEnd);                          // null backing reads as zero
            } else if (OpIndexFit(ExprCls(e.a), "op_index", e.b, null) != null) {
                // class instance with an indexer: `obj[i]` lowers to the
                // op_index instance-method protocol (x0 receiver, x1 index);
                // overloads are picked by the index argument's type
                string oc = ExprCls(e.a);
                Node om = OpIndexFit(oc, "op_index", e.b, null);
                GenExpr(e.a);
                XPushV0();                      // push receiver
                GenExpr(e.b);
                MovRR(1, 0);                         // x1 = index
                XPopV(0);                      // pop receiver -> x0
                BLInternal(MethSymNg(oc, om));
            } else {
                diags.Error("ngen: unsupported index target", e.line, e.col);
            }
        } else if (k == AK.Assignment()) {
            string tgtTy = AssignTargetTy(e.a);
            if (tgtTy != null && tgtTy == "float") { tgtTy = "double"; }
            if (e.op != TK.Eq() && e.op != TK.QQEq()) {
                // compound assignment reads the target through the ordinary
                // Binary path (which knows ints, doubles, ulongs and string
                // concat) and stores through the same chain as `=`
                int bop2 = CompoundBinOp(e.op);
                if (bop2 == 0) {
                    diags.Error("ngen: unsupported compound assignment operator", e.line, e.col);
                    return;
                }
                Node bin2 = new Node(AK.Binary());
                bin2.op = bop2;
                bin2.line = e.line;
                bin2.col = e.col;
                bin2.a = e.a;
                bin2.b = e.b;
                GenExpr(bin2);
                if (tgtTy == "double" && !IsDblExpr(bin2)) { ConvI2D(); }
                else if (tgtTy == "float") {
                    // packed float[] slots take single bits; 8-byte float
                    // slots (locals, lists, fields) keep the widened double
                    if (e.a != null && e.a.kind == AK.Index() && ArrContainerTy(e.a.a) != null) { NarrowF32Bits(); }
                    else { NarrowF32(); }
                }
                else if (tgtTy == "int" && !IsDblExpr(bin2) && !IsStrExpr(bin2)) { Sxtw0(); }   // sxtw x0, w0
                else if (tgtTy == "uint" && !IsDblExpr(bin2) && !IsStrExpr(bin2)) { E4(0xD3407C00); }  // ubfm: zero-extend low 32
            } else if (TryGenBindingValue(e.b, tgtTy)) {
                // Binding<T> sugar: x0 already holds the fresh binding object
            } else {
                GenConversionValueNg(e.b, tgtTy);
            }
            if (TryGenStringStore(e.a)) { return; }
            if (e.a != null && e.a.kind == AK.Index() && ArrContainerTy(e.a.a) != null
                    && ArrElemName(ArrContainerTy(e.a.a)) == "float") {
                NarrowF32Bits();                     // packed float slots hold single bits
            }
            if (e.a != null && e.a.kind == AK.Ident()) {
                int li = LocalIdx(e.a.sval);
                if (li < 0) {
                    // implicit field store inside instance methods
                    Fld fld = CurField(e.a.sval);
                    if (fld != null) {
                        Cls nxc = ExpandedStructOf(fld);
                        if (nxc != null) {
                            // 批43:整体值存储 = 载荷拷贝进 this 的扁平区域
                            XPushV0();              // src box
                            LoadLocal(LocalIdx("this"), 0);
                            if (fld.off <= 4095) { AddImm(0, 0, fld.off); }
                            else { LoadImm(16, fld.off); AddRR(0, 0, 16); }
                            XPopV(1);
                            LoadImm(2, nxc.size);
                            BLExtern("_memcpy");
                            return;
                        }
                        XPushV0();                  // str x0, [sp, #-16]! (value)
                        LoadLocal(LocalIdx("this"), 0);  // receiver -> x0
                        XPopV(1);                        // ldr x1, [sp], #16 (value)
                        StoreFieldNg(1, 0, fld);             // str x1, [x0, #off]
                        return;
                    }
                    // static field store through its data-global slot
                    string ssym = FindStaticSym(curCls, e.a.sval);
                    if (ssym != null) {
                        LoadSymRef(ssym, 9);
                        StrU(0, 9, 0);
                        return;
                    }
                    // bare property store: the desugared set_Name accessor
                    // (instance: x0 = receiver, x1 = value; static: the
                    // value is the first parameter, so it stays in x0)
                    Node bs = AccessorInChain(curCls, "set_" + e.a.sval);
                    if (bs != null) {
                        if (HasMod(bs, MOD.Static())) {
                            // value already in x0
                        } else {
                            XPushV0();              // push value
                            LoadLocal(LocalIdx("this"), 0);
                            XPopV(1);              // x1 = value
                        }
                        BLInternal(MethSymNg(accOwnerCls, bs));
                        return;
                    }
                    // oracle parity: a plain `ident = expr` to an undeclared
                    // name is a silent dead store -- the RHS still evaluated
                    // above (Control's paneMin/paneMax, InputOtp's
                    // completeArmed init); explicit this., compound writes
                    // and reads all still error
                    return;
                }
                if (locRef[li]) {
                    StoreRefLocal(li);
                    return;
                }
                StoreLocalVal(li, 0);
            } else if (e.a != null && e.a.kind == AK.Index() && e.a.kids.Count > 0
                    && ArrContainerTy(e.a.a) != null) {
                // rectangular element set: the value rides the stack while
                // the subscripts bounds-check (same rule as the get)
                int nsub = 1 + e.a.kids.Count;
                int esz = ArrElemSize(ArrContainerTy(e.a.a));
                XPushV0();                      // push value
                MdPrologueNg(e.a);
                MdFlatNg(e.a, nsub, e.line, e.col);
                XPopV(2);                      // pop value -> x2
                AddImm(1, 19, 8 * nsub);             // x1 = data
                if (esz == 4) {
                    E4(0x8B090821);                  // add x1, x1, x9, lsl #2
                } else if (esz == 8) {
                    E4(0x8B090C21);                  // add x1, x1, x9, lsl #3
                } else {
                    E4(0x8B090021);                  // add x1, x1, x9
                }
                if (esz == 1) {
                    E4(0x39000022);                  // strb w2, [x1]
                } else if (esz == 2) {
                    E4(0x79000022);                  // strh w2, [x1]
                } else if (esz == 4) {
                    E4(0xB9000022);                  // str w2, [x1]
                } else {
                    E4(0xF9000022);                  // str x2, [x1]
                }
            } else if (e.a != null && e.a.kind == AK.Index() && ArrContainerTy(e.a.a) != null) {
                // array element set: same bounds rule as the get; the value
                // and index survive the guard call on the stack
                int esz = ArrElemSize(ArrContainerTy(e.a.a));
                XPushV0();                      // push value
                GenExpr(e.a.a);
                XPushV0();                      // push arr
                GenExpr(e.a.b);                      // x0 = idx
                XPopV(1);                      // pop arr -> x1
                XPopV(2);                      // pop value -> x2
                if (tgt86 == 1) { LdrU(3, 1, -16); } else { E4(0xF85F0023); }   // ldur x3, [x1, #-16] (len) = mov rcx,[rsi-16]
                int bad = NL();
                int cont = NL();
                StringCmp(0, 3);                     // cmp x0, x3
                EmitBcond(10, bad);                  // b.ge bad
                StringCmp(0, 31);                    // cmp x0, xzr
                EmitBcond(11, bad);                  // b.lt bad
                EmitB(cont);
                Mark(bad);
                XPushR(1);                      // keep arr (guard clobbers x1)
                XPushV0();                      // keep idx
                XPushR(2);                      // keep value
                LoadSymRef("l_.str." + guardFileIdx, 0);
                LoadImm(1, e.line);
                LoadImm(2, e.col);
                LoadSymRef("l_.str." + guardArrIdx, 3);
                BLInternal("_zan_rt_guard_fail3");
                XPopV(2);                      // pop value
                XPopV(0);                      // pop idx
                XPopV(1);                      // pop arr
                LoadImm(0, 0);
                Mark(cont);
                if (esz == 1) {
                    if (tgt86 == 1) { X3(0x88, 0x14, 0x3E); } else { E4(0x38206822); }   // strb w2, [x1, x0] = mov [rsi+rdi], dl
                } else if (esz == 2) {
                    // strh 寄存器形式必须 S=1(lsl #1):0x…6822 是 S=0 无缩放,
                    // 下标没乘 2(d[1] 落在字节 1);x86 臂的 rdi*2 一直是对的
                    if (tgt86 == 1) { X3(0x66, 0x89, 0x14); X1(0x7E); } else { E4(0x78207822); }   // strh w2, [x1, x0, lsl #1] = mov [rsi+rdi*2], dx
                } else if (esz == 4) {
                    if (tgt86 == 1) { X3(0x89, 0x14, 0xBE); } else { E4(0xB8207822); }   // str w2, [x1, x0, lsl #2] = mov [rsi+rdi*4], edx (SIB 0xBE = idx rdi)
                } else {
                    if (tgt86 == 1) { X3(0x48, 0x89, 0x14); X1(0xFE); } else { E4(0xF8207822); }   // str x2, [x1, x0, lsl #3] = mov [rsi+rdi*8], rdx
                }
            } else if (e.a != null && e.a.kind == AK.Index() && e.a.a != null
                    && e.a.a.kind == AK.NewExpr() && IsSpanNew(e.a.a)) {
                // Span<T> element set: the value survives on the stack while
                // the view's {base, len} box derefs; same bounds rule as the
                // get
                string sel = SpanElemTy(e.a.a);
                int sesz = SpanElemSize(e.a.a);
                XPushV0();                      // push value
                GenExpr(e.a.a);                      // box -> x0
                XPushV0();                      // push box
                GenExpr(e.a.b);                      // idx -> x0
                SpanBoxDeref();                      // x1 = base, x2 = len
                XPopV(3);                      // pop value -> x3
                SpanIdxGuard(e.line, e.col, 3);
                EmitSpanElemStore(sel, sesz);
            } else if (e.a != null && e.a.kind == AK.Index() && SpanContainerTy(e.a.a) != null) {
                // local/field Span<T> element set: the value survives on the
                // stack while the view's {base, len} box derefs; same bounds
                // rule as the get
                string sct2 = SpanContainerTy(e.a.a);
                XPushV0();                      // push value
                GenExpr(e.a.a);                      // box -> x0
                XPushV0();                      // push box
                GenExpr(e.a.b);                      // idx -> x0
                SpanBoxDeref();                      // x1 = base, x2 = len
                XPopV(3);                      // pop value -> x3
                SpanIdxGuard(e.line, e.col, 3);
                EmitSpanElemStore(SpanTyElem(sct2), SpanTyElemSize(sct2));
            } else if (e.a != null && e.a.kind == AK.Index() && ExprCls(e.a.a) == "Dict") {
                DictCheckOperand(e.a.a, e.a.b, true);
                DictCheckOperand(e.a.a, e.b, false);
                // d[key] = v: value survives on the stack while the dict and
                // key evaluate; _zan_rt_dict_set inserts or updates
                GenCloneIfStruct(e.b);               // struct values: fresh box
                XPushV0();                      // push value
                GenExpr(e.a.a);                      // dict -> x0
                XPushV0();                      // push dict
                GenExpr(e.a.b);                      // key -> x0
                MovRR(1, 0);                         // x1 = key
                XPopV(0);                      // pop dict -> x0
                XPopV(2);                      // pop value -> x2
                BLInternal("_zan_rt_dict_set");
            } else if (e.a != null && e.a.kind == AK.Index() && ExprCls(e.a.a) == "List") {
                // element set: bounds check like the get, then store into
                // the 8-byte slot (value preserved across the guard call);
                // List<int> narrows a long-valued literal to int32 first
                bool lint = ElemTyOf(e.a) == "int";
                XPushV0();                      // push value
                GenExpr(e.a.a);
                XPushV0();                      // push obj
                GenExpr(e.a.b);                      // x0 = idx
                XPopV(1);                      // pop obj -> x1
                XPopV(2);                      // pop value -> x2
                if (lint) { if (tgt86 == 1) { X3(0x48, 0x63, 0xD2); } else { E4(0x93407C42); } }        // sxtw x2, w2
                LdrU(3, 1, 0);                       // count
                LdrU(4, 1, 16);                      // data
                int bad = NL();
                int cont = NL();
                if (tgt86 == 1) { Xop(0x39, 7, 1); } else { E4(0xEB03001F); }                      // cmp x0, x3
                EmitBcond(10, bad);                  // b.ge bad
                if (tgt86 == 1) { X3(0x48, 0x83, 0xFF); X1(0x00); } else { E4(0xEB1F001F); }                      // cmp x0, xzr
                EmitBcond(11, bad);                  // b.lt bad
                EmitB(cont);
                Mark(bad);
                XPushR(4);                      // keep data (guard clobbers x4)
                XPushV0();                      // keep idx
                XPushR(2);                      // keep value
                LoadSymRef("l_.str." + guardFileIdx, 0);
                LoadImm(1, e.line);
                LoadImm(2, e.col);
                LoadSymRef("l_.str." + guardListIdx, 3);
                BLInternal("_zan_rt_guard_fail3");
                XPopV(2);                      // pop value
                XPopV(0);                      // pop idx
                XPopV(4);                      // pop data
                LoadImm(0, 0);
                Mark(cont);
                int sEnd = NL();
                CbzReg(4, sEnd);                     // empty list: backing is null, drop the store
                if (tgt86 == 1) { X3(0x49, 0x89, 0x14); X1(0xF8); } else { E4(0xF8207882); } // str x2,[x4,x0,lsl#3] = mov [r8+rdi*8],rdx (v2 home rdx)
                Mark(sEnd);
            } else if (e.a != null && e.a.kind == AK.Index()
                    && OpIndexFit(ExprCls(e.a.a), "op_index_set", e.a.b, e.b) != null) {
                // indexer set: obj[i] = v (or += v -- the read half went
                // through the ordinary Index path above). The value was
                // evaluated into x0 at the top; lower to the op_index_set
                // protocol: x0 receiver, x1 index, x2 value. Overloads are
                // picked by the index and value argument types.
                string oc = ExprCls(e.a.a);
                Node osm = OpIndexFit(oc, "op_index_set", e.a.b, e.b);
                XPushV0();                      // push value
                GenExpr(e.a.a);                      // receiver -> x0
                XPushV0();                      // push receiver
                GenExpr(e.a.b);                      // index -> x0
                MovRR(1, 0);                         // x1 = index
                XPopV(0);                      // pop receiver -> x0
                XPopV(2);                      // pop value -> x2
                BLInternal(MethSymNg(oc, osm));
            } else if (e.a != null && e.a.kind == AK.MemberAccess()) {
                // class-qualified static write: Program.starting = v
                // (the value was already evaluated into x0 at the top).
                // The receiver must NAME a class: a plain local (`bb.title
                // = v`, `this.w = ""`) is an instance-field write even when
                // another class declares a static of the same name --
                // FindStaticSym's by-name fallback would otherwise steal
                // the store into that static's global slot
                if (e.a.a != null && e.a.a.kind == AK.Ident() && LocalIdx(e.a.a.sval) < 0
                        && FindClass(e.a.a.sval) != null) {
                    string ssym = FindStaticSym(QualifiedCls(e.a.a.sval, e.a.sval2), e.a.sval);
                    if (ssym != null) {
                        XPushV0();                  // push value across LoadSymRef
                        LoadSymRef(ssym, 1);             // x1 = &slot
                        XPopV(0);                  // pop value -> x0
                        StrU(0, 1, 0);
                        return;
                    }
                }
                Fld f = FieldOf(e.a);
                if (f == null) {
                    // property setter fallback: obj.Prop = v / Cls.Prop = v
                    // dispatches to the desugared set_Prop accessor
                    Node sm2 = null;
                    string sc2 = null;
                    if (e.a.a != null && e.a.a.kind == AK.Ident() && LocalIdx(e.a.a.sval) < 0
                            && FindClass(e.a.a.sval) != null) {
                        sm2 = AccessorInChain(e.a.a.sval, "set_" + e.a.sval);
                    }
                    if (sm2 == null) {
                        sc2 = ExprCls(e.a.a);
                        sm2 = sc2 != null ? AccessorInChain(sc2, "set_" + e.a.sval) : null;
                    }
                    if (sm2 != null) {
                        string targetCls = accOwnerCls;
                        if (HasMod(sm2, MOD.Static())) {
                            // value already in x0 (first parameter)
                        } else {
                            XPushV0();              // push value
                            GenExpr(e.a.a);              // receiver -> x0
                            XPopV(1);                   // x1 = value
                        }
                        BLInternal(MethSymNg(targetCls, sm2));
                        return;
                    }
                    diags.Error("ngen: unknown field '" + e.a.sval + "'", e.line, e.col);
                    return;
                }
                Cls nxc = ExpandedStructOf(f);
                if (nxc != null) {
                    // 批43:整体值存储 = 载荷拷贝(源箱 → 扁平区域),
                    // 源箱本身保持共享无扰;区域基址经链偏移算术直达,
                    // 深链(o.i.j = q)不物化中间箱
                    XPushV0();                      // src box
                    GenNestedRegionAddr(e.a.a);     // x0 = region base
                    XPopV(1);                       // x1 = src
                    LoadImm(2, nxc.size);
                    BLExtern("_memcpy");
                    return;
                }
                XPushV0();                          // str x0, [sp, #-16]! (value)
                if (e.a.a != null && ChainIsExpanded(e.a.a)) {
                    GenNestedRegionAddr(e.a.a);     // 批43:链偏移算术,不物化
                } else {
                    GenExpr(e.a.a);                 // receiver -> x0
                }
                XPopV(1);                           // ldr x1, [sp], #16 (value)
                StoreFieldNg(1, 0, f);                       // str x1, [x0, #off]
            } else {
                diags.Error("ngen: unsupported assignment target", e.line, e.col);
            }
        } else if (k == AK.NewExpr()) {
            GenNew(e);
        } else if (k == AK.IsExpr()) {
            GenIs(e);
        } else if (k == AK.AsExpr()) {
            GenAs(e);
        } else if (k == AK.Call()) {
            GenCall(e);
        } else if (k == AK.Conditional()) {
            // c ? a : b -- truthiness is the 0/1 bool convention
            int elseL = NL();
            int endL = NL();
            GenExpr(e.a);
            EmitCBZ(0, elseL);
            GenExpr(e.b);
            if (IsDblExpr(e) && !IsDblExpr(e.b)) { ConvI2D(); }
            EmitB(endL);
            Mark(elseL);
            GenExpr(e.c);
            if (IsDblExpr(e) && !IsDblExpr(e.c)) { ConvI2D(); }
            Mark(endL);
        } else if (k == AK.SwitchExpr()) {
            GenSwitchExpr(e);
        } else if (k == AK.TupleExpr()) {
            GenTupleNg(e);
        } else if (k == AK.PostfixUnary()) {
            if (e.op == TK.Bang()) {
                GenExpr(e.a);
            } else {
                // x++ / x--: yield the OLD value, then store old +/- 1; any
                // place (local, ref local, field, static, element) goes through
                // its address so the target evaluates exactly once
                GenIncDec(e.a, e.op == TK.PlusPlus(), false);
            }
        } else if (k == AK.WithExpr()) {
            // `recv with { f = v, ... }`: a memberwise copy of recv with the
            // named fields overwritten (record copy); the copy is a fresh
            // object even for classes
            string wtn = StaticTyOf(e.a);
            Cls wc = wtn != null ? SpecClsOf(wtn) : null;
            if (wc == null) {
                diags.Error("ngen: 'with' receiver has no record type", e.line, e.col);
                LoadImm(0, 0);
            } else {
                GenExpr(e.a);
                XPushV0();                      // push src
                LoadImm(0, wc.size + 16);
                LoadImm(1, 0);
                BLInternal("_zan_rt_alloc");
                XPopV(1);                           // pop src -> x1
                LoadImm(2, wc.size + 16);
                SubImm(0, 0, 8);
                SubImm(1, 1, 8);
                BLExtern("_memcpy");
                AddImm(0, 0, 8);                     // x0 = the copy
                XPushV0();                      // hold the copy
                int wi = 0;
                while (wi < e.kids.Count) {
                    Node wasg = e.kids[wi];
                    Fld wf = wasg.a != null ? FindField(wc, wasg.a.sval) : null;
                    if (wf == null) {
                        diags.Error("ngen: unknown field '" + wasg.a.sval + "' in with expression", wasg.line, wasg.col);
                    } else {
                        GenExpr(wasg.b);
                        GenCloneIfStruct(wasg.b);
                        Cls wxc = ExpandedStructOf(wf);
                        if (wxc != null) {
                            // 批49:展开字段整体值存储(与赋值路径同一载荷
                            // memcpy;目标是新鲜拷贝,区域基 = 拷贝+off)
                            XPushV0();                          // save src box
                            if (tgt86 == 1) { XopRMem(0x8B, 6, 4, 16); }  // mov rsi,[rsp+16] (copy)
                            else { E4(0xF84103E1); }     // ldur x1, [sp, #16] (copy)
                            MovRR(0, 1);
                            AddImm(0, 0, wf.off);               // dest = copy + off
                            XPopV(1);                           // src box
                            LoadImm(2, wxc.size);
                            BLExtern("_memcpy");
                        } else {
                            if (IsDblTy(wf.ty) && !IsDblExpr(wasg.b)) { ConvI2D(); }
                            if (tgt86 == 1) { XopRMem(0x8B, 6, 4, 0); }  // mov rsi,[rsp] (peek copy)
                            else { E4(0xF84003E1); }     // ldur x1, [sp] (peek copy)
                            StoreFieldNg(0, 1, wf);
                        }
                    }
                    wi = wi + 1;
                }
                XPopV(0);                      // pop copy -> x0
            }
        } else if (k == AK.CallInit()) {
            // 工厂调用延续初始化器：先降调用本身，结果（同一个对象）
            // 压栈应用成员写，原样返回——不做记录式拷贝。
            string fcls = CallRetTy(e.a);
            if (fcls == null || FindClass(fcls) == null) {
                diags.Error("ngen: factory-call initializer on unknown type", e.line, e.col);
                LoadImm(0, 0);
            } else {
                GenExpr(e.a);
                XPushV0();                      // push obj
                GenInitItems(fcls, e, 0);
                XPopV(0);                      // pop obj -> x0
            }
        } else if (k == AK.OutArg()) {
            // an out/ref argument evaluated in expression position yields
            // its storage ADDRESS (gen0's emit_expr of a ref arg)
            GenRefArg(e);
        } else {
            diags.Error("ngen: unsupported expression kind " + k, e.line, e.col);
        }
    }

    void GenNew(Node e) {
        if (TryGenDelegateNew(e)) { return; }
        if (TryGenHostNew(e)) { return; }
        string cls = e.type != null ? e.type.sval : null;
        if (cls == "List") { GenListNew(e); return; }
        if (cls == "Dict" || cls == "Dictionary") { GenDictNew(e); return; }
        if (cls == "Span") {
            // the view's {base, len} pair lands in this site's private
            // frame box (batch 12): [box]=base, [box+8]=len; indexing
            // derefs the box. No heap allocation, no per-call leak.
            GenExpr(e.kids[0]);                      // base -> x0
            XPushV0();                          // push base
            GenExpr(e.kids[1]);                      // len -> x0
            XPushV0();                          // push len
            SpanSiteBox(e);                          // x0 = frame box
            XPopV(2);                          // pop len -> x2
            XPopV(1);                          // pop base -> x1
            StrU(1, 0, 0);                           // [box] = base
            StrU(2, 0, 8);                           // [box+8] = len
            return;
        }
        if (e.ival == 1) {
            string etn = TypeFullName(e.type);
            int dims = e.sval2 != null && e.sval2 != "" ? (int)Convert.ToInt64(e.sval2) : 1;
            if (dims > 1) {
                GenMdArrNew(e, dims);
                return;
            }
            // the element of `new T[a][b]` is itself an array (8-byte refs):
            // the size reads from T plus ALL ranks, sized + trailing
            int Jesz = ArrElemSize(etn + ArrSuffix(e.op + 1));
            if (e.kids.Count > 0) {
                // array initializer: `new T[] { a, b, c }` (an explicit size,
                // if any, must equal the element count)
                GenArrInit(e, Jesz);
                return;
            }
            GenArrNew(e.b, Jesz);
            return;
        }
        Cls c = cls != null ? SpecClsOf(TypeFullName(e.type)) : null;
        if (c == null) {
            diags.Error("ngen: unknown class in 'new' expression", e.line, e.col);
            LoadImm(0, 0);
            return;
        }
        // allocate: x0 = size + 16 (header), x1 = descriptor (0: no dtor)
        LoadImm(0, c.size + 16);
        LoadImm(1, 0);
        BLInternal("_zan_rt_alloc");
        // stamp the runtime class site into the upper half of obj-8 (the
        // descriptor slot, 0 for plain news) so `x is T` can identify the
        // object's class later
        RtLdur(1, 0, -8);                                // ldur x1, [x0, #-8]
        if (tgt86 == 1) {
            // same descriptor stamp: desc |= site << 16 (v1=rsi, v2=rdx)
            XLoadImm(2, (long)c.site << 32);   // arm64 臂 movz hw=2 = lsl #32(旧注释 #16 有误)
            Xop(0x09, 6, 2);                             // or rsi, rdx
        } else {
            E4((int)(0xD2C00000 | (((long)c.site) << 5) | 2)); // movz x2, #site, lsl #16
            E4(0xAA020021);                              // orr x1, x1, x2
        }
        RtStur(1, 0, -8);                                // stur x1, [x0, #-8]
        if (c.poly == 1) {
            // polymorphic: stamp the class's (lazily built) vtable at obj+0
            XPushV0();                              // push obj
            LoadSymRef(DGlobalSym("vt." + cls), 9);      // x9 = &slot
            LdrU(1, 9, 0);                               // x1 = table (0 before init)
            int vtDone = NL();
            CbnzReg(1, vtDone);
            BLInternal("_vtinit_" + cls);                // x0 = table
            MovRR(1, 0);                                 // x1 = table
            Mark(vtDone);
            XPopV(0);                              // pop obj -> x0
            StrU(1, 0, 0);                               // obj->vptr = table
        }
        XPushV0();                                  // str x0, [sp, #-16]! (obj)
        // ctor arguments: for a brace object initializer (`new C(a) { X = v }`)
        // the first e.op kids are the paren args and the rest are field
        // initializers; otherwise every kid is an argument. Provided args
        // first, trailing defaults filled in; a class without any ctor
        // allocates bare (no call).
        Node callN = e;
        if (e.ival == 2) {
            Node tmp = new Node(AK.Call());
            tmp.line = e.line;
            tmp.col = e.col;
            int ai = 0;
            while (ai < e.op && ai < e.kids.Count) { tmp.Add(e.kids[ai]); ai = ai + 1; }
            callN = tmp;
        }
        // the instantiation substitutes open ctor parameter types both in
        // overload scoring (ArgParamScore) and at delegate registration
        // (PushCallArgs snapshots it)
        string instNg = TypeFullName(e.type);
        pendingCtorInstNg = instNg != null && instNg.IndexOf("<") > 0 ? instNg : null;
        int cix = FitCtorIdx(cls, callN, false, null);
        // `new C { X = v }` over a type whose ctors all take arguments: the
        // brace-only initializer lowers to a bare allocation plus its member
        // writes -- the reference's form (cs_b18_init; real C# demands a
        // parameterless ctor, the reference does not). Only a brace-only
        // initializer qualifies: a plain `new C()` still reports.
        bool braceOnly = e.ival == 2 && e.op == 0 && e.kids.Count > 0;
        string ctorSym = null;
        if (cix >= 0) {
            ctorSym = CtorSymNg(cls, methNodes[cix]);
            // a generic-class instantiation needs its OWN ctor body: the
            // open ctor is a template compiled with erasure, so any
            // type-sensitive lowering inside it degrades to the reference
            // form (a `new Dict<T, int>()` keeps the key-kind bits clear
            // and int-key instantiations strcmp their keys)
            string inst = TypeFullName(e.type);
            if (inst != null && inst.IndexOf("<") > 0) {
                Cls gc = FindClass(cls);
                if (gc != null && gc.tps.Count > 0) {
                    ctorSym = InstCtorSpecNg(inst, cls, gc, cix);
                }
            }
        }
        int pushed;
        if (cix >= 0) {
            pushed = PushCallArgs(methNodes[cix], callN);
            pendingCtorInstNg = null;
        } else if (CtorCountNg(cls) > 0 && !braceOnly) {
            pendingCtorInstNg = null;
            diags.Error("ngen: no constructor of '" + cls + "' takes "
                + callN.kids.Count + " argument(s)", e.line, e.col);
            return;
        } else {
            pendingCtorInstNg = null;
            pushed = 0;
        }
        int r = pushed;
        int armOvfArea = 0;
        int envc = pushed + 1;
        if (tgt86 != 1 && envc > 16) {
            int novf = envc - 16;
            armOvfArea = 16 * ((novf + 1) / 2);
            AddSPImm(armOvfArea, false);
            LdrU(0, 31, armOvfArea + 16 * pushed);
            int k = 1;
            while (k <= pushed) {
                int off = armOvfArea + 16 * (pushed - k);
                if (k < 16) {
                    LdrU(k, 31, off);
                } else {
                    LdrU(10, 31, off);
                    StrU(10, 31, 8 * (k - 16));
                }
                k = k + 1;
            }
            XPushV0();
            if (ctorSym != null) {
                BLInternal(ctorSym);
            }
            XPopV(0);
            AddSPImm(armOvfArea + 16 * (pushed + 1), true);
            XPushV0();
        } else {
            while (r >= 1) { XPopV(XArgVOf(r)); r = r - 1; } // ldr xr, [sp], #16 (args reversed; x86 v16/v17→真家)
            XPopV(0);                                  // ldr x0, [sp], #16 (obj)
            XPushV0();                                  // str x0, [sp, #-16]! (keep obj across the void ctor)
            if (ctorSym != null) {
                BLInternal(ctorSym);
            }
        }
        // field initializers store through the object still on the stack
        if (e.ival == 2) { GenInitItems(cls, e, e.op); }
        XPopV(0);                                  // ldr x0, [sp], #16 (obj)
    }

    // 对象初始化器的成员写序列（GenNew 与 CallInit 共用）：对象压在栈
    // 上，从 kids[from] 起逐项应用——`member = { a, b }` 集合收养、
    // 属性走 set_ 访问器、字段直接存。每项结束时对象回到栈顶。
    void GenInitItems(string cls, Node e, int from) {
        int bi = from;
        while (bi < e.kids.Count) {
            Node it = e.kids[bi];
            if (it.kind == AK.Assignment() && it.a != null && it.a.kind == AK.Ident()
                    && it.b != null && it.b.kind == AK.NewExpr() && it.b.ival == 2
                    && it.b.type == null) {
                // `member = { a, b }`: C# member collection initializer
                GenMemberCollInit(cls, it);
            } else if (it.kind == AK.Assignment() && it.a != null && it.a.kind == AK.Ident()) {
                Fld initFld = FindField(FindClass(cls), it.a.sval);
                if (initFld == null && AccessorInChain(cls, "set_" + it.a.sval) != null) {
                    // property setter dispatch: an initializer item on a
                    // property calls the desugared set_Prop accessor
                    // exactly like an ordinary assignment
                    Node initSet = AccessorInChain(cls, "set_" + it.a.sval);
                    string initTy = (initSet != null && initSet.type != null) ? TypeFullName(initSet.type) : null;
                    if (initTy == null || !TryGenBindingValue(it.b, initTy)) {
                        GenExpr(it.b);
                    }
                    if (initTy != null && IsDblTy(initTy) && !IsDblExpr(it.b)) { ConvI2D(); }
                    if (initTy == "float") { NarrowF32(); }
                    MovRR(1, 0);                     // x1 = value
                    LdrU(0, 31, 0);                  // x0 = obj (peek: the call
                    BLInternal(MethSymNg(accOwnerCls, initSet));   // clobbers x0)
                    // obj stays the stack top for the next item
                } else if (initFld == null) {
                    diags.Error("ngen: unknown field '" + it.a.sval + "' in initializer", it.line, it.col);
                } else {
                    if (!TryGenBindingValue(it.b, initFld.ty)) {
                        GenExpr(it.b);
                    }
                    if (IsDblTy(initFld.ty) && !IsDblExpr(it.b)) { ConvI2D(); }
                    if (initFld.ty == "float") { NarrowF32(); }
                    Cls initNxc = ExpandedStructOf(initFld);
                    if (initNxc != null) {
                        // 批43:整体值初始化 = 载荷拷贝进扁平区域
                        // (x0 = src 箱,栈顶 = obj)
                        XPushV0();                  // push src
                        XPopV(2);                   // x2 = src
                        XPopV(0);                   // x0 = obj (dst base)
                        if (initFld.off <= 4095) { AddImm(0, 0, initFld.off); }
                        else { LoadImm(16, initFld.off); AddRR(0, 0, 16); }
                        MovRR(1, 2);                // x1 = src
                        LoadImm(2, initNxc.size);   // x2 = n
                        BLExtern("_memcpy");
                        XPushV0();                  // push obj back for the next item
                    } else {
                        XPushV0();                  // push value
                        XPopV(1);                   // pop value -> x1 (top)
                        XPopV(0);                   // pop obj -> x0
                        StoreFieldNg(1, 0, initFld);     // obj->field = value
                        XPushV0();                  // push obj back for the next item
                    }
                }
            } else {
                diags.Error("ngen: unsupported object initializer item", it.line, it.col);
            }
            bi = bi + 1;
        }
    }

    // `member = { a, b }` inside an object initializer: read the member once
    // off the object still on the stack (field load or getter-only property),
    // then Add every item into it -- C# semantics: existing content survives
    // and instances never share the collection. Dict members take flat
    // key/value pairs.
    void GenMemberCollInit(string cls, Node it) {
        Cls fc = FindClass(cls);
        Fld f = fc != null ? FindField(fc, it.a.sval) : null;
        string getterSym = null;
        string mty = null;
        if (f != null) {
            mty = f.ty;
        } else {
            Node g = fc != null ? AccessorInChain(cls, "get_" + it.a.sval) : null;
            if (g == null) {
                diags.Error("ngen: unknown member '" + it.a.sval
                    + "' in collection initializer", it.line, it.col);
                int di = 0;
                while (di < it.b.kids.Count) { GenExpr(it.b.kids[di]); di = di + 1; }
                return;
            }
            getterSym = MethSymNg(accOwnerCls, g);
            mty = TypeFullName(g.type);
        }
        bool dict = mty != null && mty.IndexOf("Dict<") == 0;
        // 门面集合（既不是 List 也不是 Dict 的类类型，如
        // ControlChildren——Add 是 owner.With(c) 的收养门面）：逐项调用
        // 它的 Add 方法，而不是把元素裸追加进对象内部布局（那会写穿
        // 非列表对象）。oracle irgen 的成员集合初始化同样逐个调 Add。
        string facadeAddSym = null;
        if (!dict && mty != null && mty.IndexOf("List<") != 0 && mty != "List") {
            Node am = AccessorInChain(mty, "Add");
            if (am != null && ParamCount(am) == 1) {
                facadeAddSym = MethSymNg(accOwnerCls, am);
            }
        }
        // strip the declared generic: List<E> -> E, Dict<K,V> -> K / V
        string args2 = "";
        if (mty != null) {
            int lt = mty.IndexOf("<");
            if (lt > 0 && mty.Length - 1 > lt) {
                args2 = mty.Substring(lt + 1, mty.Length - lt - 2);
            }
        }
        string keyTy = args2;
        string valTy = args2;
        if (dict) {
            int comma = args2.IndexOf(",");
            if (comma > 0) {
                keyTy = args2.Substring(0, comma);
                valTy = args2.Substring(comma + 1, args2.Length - comma - 1);
            }
        } else {
            valTy = args2;
        }
        // the member's collection reference, once: x0 = obj (peek) -> x0 = coll
        E4(0xF84003E0);                                  // ldur x0, [sp] (obj)
        if (f != null) {
            LdrU(0, 0, f.off);
        } else {
            BLInternal(getterSym);                       // x0 = coll
        }
        XPushV0();                                  // push coll (obj beneath)
        int ii = 0;
        while (ii < it.b.kids.Count) {
            if (dict) {
                if (ii + 1 >= it.b.kids.Count) {
                    diags.Error("ngen: dictionary initializer needs key/value pairs", it.line, it.col);
                    break;
                }
                GenExpr(it.b.kids[ii + 1]);              // value -> x0
                CoerceCollElem(valTy, it.b.kids[ii + 1]);
                XPushV0();                          // push value
                GenExpr(it.b.kids[ii]);                  // key -> x0
                CoerceCollElem(keyTy, it.b.kids[ii]);
                XPushV0();                          // push key
                // pushes are 16-byte cells (str x0, [sp, #-0x10]!): the
                // stack is now [sp]=key, [sp+16]=value, [sp+32]=coll, with
                // the peeked obj still beneath
                RtLdur(0, 31, 32);                       // x0 = coll
                XPushV0();                          // push dict
                RtDictSet3();                            // pops dict, key, value
                ii = ii + 2;
            } else {
                GenExpr(it.b.kids[ii]);                  // item -> x0
                CoerceCollElem(valTy, it.b.kids[ii]);
                GenCloneIfStruct(it.b.kids[ii]);
                MovRR(1, 0);                             // x1 = item
                LdrU(0, 31, 0);                          // x0 = coll (peek)
                if (facadeAddSym != null) {
                    BLInternal(facadeAddSym);            // facade.Add(item)
                } else {
                    ListAppendRaw();
                }
                ii = ii + 1;
            }
        }
        AddSPImm(16, true);                              // pop coll (obj back on top)
    }

    // element coercion at a collection-initializer boundary, mirroring the
    // inline List.Add rules (int slots widen, float slots round on the way in)
    void CoerceCollElem(string ety, Node arg) {
        if (ety == "double" && !IsDblExpr(arg)) { ConvI2D(); }
        else if (ety == "int" && !IsDblExpr(arg) && !IsStrExpr(arg)) {
            Sxtw0();                              // sxtw x0, w0
        } else if (ety == "float" && !IsStrExpr(arg)) {
            NarrowF32();
        }
    }

    // `new T[] { a, b, c }`: allocate with the element count, then store each
    // initializer expression at its slot (no bounds check -- the count is
    // static). The array stays on the stack across element evaluation.
    void GenArrInit(Node e, int esz) {
        int n = e.kids.Count;
        Node cnt = new Node(AK.IntLit());
        cnt.ival = n;
        GenArrNew(cnt, esz);
        bool f32 = esz == 4 && ArrElemName(TypeFullName(e.type) + "[]") == "float";
        string ieln = TypeFullName(e.type);              // declared element type
        XPushV0();                                  // push arr
        int k = 0;
        while (k < n) {
            GenExpr(e.kids[k]);                          // x0 = element value
            if (IsNulTy(ieln) && !IsNulExpr(e.kids[k])) {
                GenNulWrap(IsDblTy(NulPayOf(ieln)));     // payload -> cell
            }
            if (f32) { NarrowF32Bits(); }
            XPopV(1);                              // pop arr -> x1
            if (tgt86 == 1) {
                // 批38:初始化器下标是编译期常量——基址 r10 加常量位移
                // 后走 EmitArrElemStore/EmitSpanElemStore 同族存储形式
                // (4D/45 89 1A、66 45 89 1A、45 88 1A,批37b/38 双探针验证)
                XGetV(0, 11);                          // r11 = value
                XGetV(1, 10);                          // r10 = arr
                int disp = k * esz;
                if (disp < 128 && disp > -128) { X3(0x4D, 0x8D, 0x52); X1(disp); }   // lea r10, [r10+disp8]
                else { X3(0x4D, 0x8D, 0x92); X4(disp); }                             // lea r10, [r10+disp32]
                if (esz == 8) { X3(0x4D, 0x89, 0x1A); }                // mov [r10], r11
                else if (esz == 4) { X3(0x45, 0x89, 0x1A); }           // mov [r10], r11d
                else if (esz == 2) { X3(0x66, 0x45, 0x89); X1(0x1A); } // mov [r10], r11w
                else { X3(0x45, 0x88, 0x1A); }                         // mov [r10], r11b
            } else {
                E4((int)(0xD2800000 | (((long)k) << 5) | 2)); // movz x2, #k
                if (esz == 1) {
                    E4(0x38226820);                      // strb w0, [x1, x2] (S=0:汇编器对质形,批38)
                } else if (esz == 2) {
                    E4(0x78227820);                      // strh w0, [x1, x2, lsl #1]
                } else if (esz == 4) {
                    E4(0xB8227820);                      // str w0, [x1, x2, lsl #2]
                } else {
                    E4(0xF8227820);                      // str x0, [x1, x2, lsl #3]
                }
            }
            XPushR(1);                              // push arr back
            k = k + 1;
        }
        XPopV(0);                                  // pop arr -> x0
    }

    // rectangular multidim alloc (B8), the reference zan_mdarray_alloc:
    // each dim evaluates once (a negative one reports and keeps its value),
    // the total product folds on wrap ("array allocation overflow"), then
    // calloc(32 + 8*rank + total*esz) with rc=1, RCMAGIC, count=total and
    // rank in the site slot; dims[d] land at arr+8d, data at arr+8*rank.
    // `new int[2,2] { ... }` row-major items store right after.
    void GenMdArrNew(Node e, int rank) {
        string ety = TypeFullName(e.type);
        int esz = ArrElemSize(ety + "[]");
        int di = 0;
        while (di < rank) {
            Node dn = di == 0 ? e.b : e.kids[di - 1];
            if (dn == null) { LoadImm(0, 0); } else { GenExpr(dn); }
            if (tgt86 == 1) { X3(0x48, 0x83, 0xFF); X1(0x00); } else { E4(0xEB1F001F); }                              // cmp x0, xzr
            int okneg = NL();
            EmitBcond(10, okneg);                        // b.ge okneg
            LoadSymRef("l_.str." + guardFileIdx, 0);
            LoadImm(1, curLine);
            LoadImm(2, curCol);
            LoadSymRef("l_.str." + guardArrNeg, 3);
            BLInternal("_zan_rt_guard_fail3");
            LoadImm(0, 0);                               // safe dim
            Mark(okneg);
            XPushV0();
            di = di + 1;
        }
        // total = product of dims; a negative product means the multiply
        // wrapped ("array allocation overflow", folded to 0)
        LoadImm(9, 1);
        di = 0;
        while (di < rank) {
            LdrU(0, 31, 16 * (rank - 1 - di));
            E4(0x9B007D29);                              // mul x9, x9, x0
            di = di + 1;
        }
        E4(0xEB1F013F);                                  // cmp x9, xzr
        int okt = NL();
        EmitBcond(10, okt);
        LoadSymRef("l_.str." + guardFileIdx, 0);
        LoadImm(1, curLine);
        LoadImm(2, curCol);
        LoadSymRef("l_.str." + guardArrOvf, 3);
        BLInternal("_zan_rt_guard_fail3");
        LoadImm(9, 0);
        Mark(okt);
        MovRR(23, 9);                                    // x23 = total (count)
        if (esz == 4) {
            E4(0xD37EF529);                              // lsl x9, x9, #2
        } else if (esz == 8) {
            E4(0xD37DF129);                              // lsl x9, x9, #3
        } else if (esz == 2) {
            E4(0xD37FF929);                              // lsl x9, x9, #1
        }
        // wrapped bytes fold to the bare header, as in the reference
        E4(0xEB1F013F);                                  // cmp x9, xzr
        int okb = NL();
        EmitBcond(10, okb);
        LoadSymRef("l_.str." + guardFileIdx, 0);
        LoadImm(1, curLine);
        LoadImm(2, curCol);
        LoadSymRef("l_.str." + guardArrOvf, 3);
        BLInternal("_zan_rt_guard_fail3");
        LoadImm(9, 32 + 8 * rank);
        Mark(okb);
        E4(0x91000000 | ((32 + 8 * rank) << 10) | (9 << 5) | 9); // add x9, x9, #hdr
        MovRR(24, 9);                                    // x24 = bytes
        MovRR(0, 24);
        LoadImm(1, 1);
        BLExtern("_calloc");                             // x0 = raw
        MovRR(25, 0);                                    // x25 = raw
        int okalloc = NL();
        CbnzReg(0, okalloc);
        LoadSymRef("l_.str." + guardFileIdx, 0);
        LoadImm(1, curLine);
        LoadImm(2, curCol);
        LoadSymRef("l_.str." + guardArrFail, 3);
        BLInternal("_zan_rt_guard_fail3");
        Mark(okalloc);
        MovRR(0, 25);
        LoadImm(2, 1);
        StrU(2, 0, 0);                                   // raw->rc = 1
        LoadImm(2, 25404552263127619);
        StrU(2, 0, 8);                                   // raw->rcmagic
        StrU(23, 0, 16);                                 // raw->count = total
        LoadImm(2, rank);
        StrU(2, 0, 24);                                  // site slot = rank
        di = 0;
        while (di < rank) {
            LdrU(2, 31, 16 * (rank - 1 - di));
            StrU(2, 0, 32 + 8 * di);               // dims[di] (arr+8*di)
            di = di + 1;
        }
        AddSPImm(16 * rank, true);
        AddImm(0, 0, 32);                     // add x0, x0, #32 (arr; dims live at arr+8*d)
        // row-major initializer items, if any: each `{ ... }` kid is a row
        int it = rank - 1;
        if (it < e.kids.Count) {
            bool f32 = esz == 4 && ety == "float";
            bool dbl = esz == 8 && ety == "double";
            XPushV0();                              // push arr
            int k = 0;
            while (it < e.kids.Count) {
                Node row = e.kids[it];
                int ri = 0;
                while (ri < row.kids.Count) {
                    Node itm = row.kids[ri];
                    GenExpr(itm);
                    if (dbl && !IsDblExpr(itm)) { ConvI2D(); }
                    if (f32) { NarrowF32Bits(); }
                    XPopV(1);                      // pop arr -> x1
                    int off = 8 * rank + k * esz;
                    if (esz == 8) {
                        StrU(0, 1, off);
                    } else if (esz == 4) {
                        E4(0xB9000000 | ((off / 4) << 10) | (1 << 5));   // str w0, [x1, #off] (imm scaled)
                    } else if (esz == 1) {
                        E4(0x39000000 | (off << 10) | (1 << 5));         // strb w0
                    } else {
                        E4(0x79000000 | ((off / 2) << 10) | (1 << 5));   // strh w0 (imm scaled)
                    }
                    XPushR(1);                      // push arr back
                    k = k + 1;
                    ri = ri + 1;
                }
                it = it + 1;
            }
            XPopV(0);                              // pop arr -> x0
        }
    }

    // a literal node for a primitive-type constant read (`int.MaxValue`),
    // or null when `mem` is not one
    // does this member access name a compiler-lowered primitive constant
    // (int.MaxValue, double.NaN, ...)? Returns the primitive's own name, so
    // callers get both the existence check and the rendering type
    string PrimitiveConstRecvTy(Node mem) {
        if (mem == null || mem.a == null || mem.a.kind != AK.Ident()) { return null; }
        string recv = mem.a.sval;
        if (recv != "int" && recv != "long" && recv != "short" && recv != "ushort"
                && recv != "byte" && recv != "sbyte" && recv != "uint"
                && recv != "ulong" && recv != "char" && recv != "float"
                && recv != "double") { return null; }
        string s = mem.sval;
        if (s == "MaxValue" || s == "MinValue" || s == "Epsilon" || s == "NaN"
                || s == "PositiveInfinity" || s == "NegativeInfinity") { return recv; }
        return null;
    }

    Node PrimitiveConstLit(Node mem) {
        if (mem == null || mem.a == null || mem.a.kind != AK.Ident()) { return null; }
        string recv = mem.a.sval;
        // host math constants fold like primitive constants (no storage);
        // a user-declared Math member keeps its own identity
        if (recv == "Math" && (mem.sval == "PI" || mem.sval == "E")
                && FindStaticTy("Math", mem.sval) == null) {
            return FloatLitNg(mem.sval == "PI" ? "3.141592653589793" : "2.718281828459045");
        }
        if (PrimitiveConstRecvTy(mem) == null) { return null; }
        string s = mem.sval;
        if (recv == "int") {
            if (s == "MaxValue") { return IntLitNg(2147483647); }
            return IntLitNg(0 - 2147483648);
        }
        if (recv == "long") {
            if (s == "MaxValue") { return IntLitNg(9223372036854775807); }
            return IntLitNg(-9223372036854775807 - 1);
        }
        // the narrow unsigned kinds fold as positive i64 words, which the
        // signed renderer prints identically; only ulong.MaxValue sets the
        // high bit, so it types ulong and rides the unsigned renderer
        if (recv == "uint") {
            if (s == "MaxValue") { return IntLitNg(4294967295); }
            return IntLitNg(0);
        }
        if (recv == "ulong") {
            if (s == "MaxValue") { return IntLitNg(-1); }
            return IntLitNg(0);
        }
        if (recv == "short") {
            if (s == "MaxValue") { return IntLitNg(32767); }
            return IntLitNg(0 - 32768);
        }
        if (recv == "ushort") {
            if (s == "MaxValue") { return IntLitNg(65535); }
            return IntLitNg(0);
        }
        if (recv == "byte") {
            if (s == "MaxValue") { return IntLitNg(255); }
            return IntLitNg(0);
        }
        if (recv == "sbyte") {
            if (s == "MaxValue") { return IntLitNg(127); }
            return IntLitNg(0 - 128);
        }
        if (recv == "char") {
            Node c = new Node(AK.CharLit());
            c.ival = s == "MaxValue" ? 65535 : 0;
            return c;
        }
        if (recv == "float") {
            // float constants widen to the double that exactly holds them,
            // printing through the double path (gen0's widening render)
            if (s == "MaxValue") { return FloatLitNg("3.4028234663852886e38"); }
            if (s == "MinValue") { return FloatLitNg("-3.4028234663852886e38"); }
            if (s == "Epsilon") { return FloatLitNg("1.401298464324817e-45"); }
            if (s == "NaN") { return FloatLitNg("nan"); }
            if (s == "PositiveInfinity") { return FloatLitNg("inf"); }
            return FloatLitNg("-inf");
        }
        if (s == "MaxValue") { return FloatLitNg("1.7976931348623157e308"); }
        if (s == "MinValue") { return FloatLitNg("-1.7976931348623157e308"); }
        if (s == "Epsilon") { return FloatLitNg("2.2250738585072014e-308"); }
        if (s == "NaN") { return FloatLitNg("nan"); }
        if (s == "PositiveInfinity") { return FloatLitNg("inf"); }
        return FloatLitNg("-inf");
    }

    Node IntLitNg(long v) {
        Node n = new Node(AK.IntLit());
        n.ival = v;
        return n;
    }

    Node FloatLitNg(string txt) {
        Node n = new Node(AK.FloatLit());
        n.sval = txt;
        return n;
    }

    void GenFieldLoad(Node mem) {
        Fld f = FieldOf(mem);
        if (f == null) {
            // span view member: Length reads the boxed view length
            if (mem.sval == "Length" && SpanContainerTy(mem.a) != null) {
                GenExpr(mem.a);                      // box -> x0
                LdrU(0, 0, 8);                       // x0 = [box+8]
                return;
            }
            // primitive-type constants: int.MaxValue / long.MinValue /
            // double.MaxValue ... fold to literals (no runtime storage)
            Node pcl = PrimitiveConstLit(mem);
            if (pcl != null) { GenExpr(pcl); return; }
            // qualified static read: ClsName.field
            if (mem.a != null && mem.a.kind == AK.Ident()) {
                string ssym = FindStaticSym(QualifiedCls(mem.a.sval, mem.sval2), mem.sval);
                if (ssym != null) {
                    LoadSymRef(ssym, 0);
                    LdrU(0, 0, 0);
                    return;
                }
            }
            // qualified static property read: ClsName.Prop -> get_Prop()
            if (mem.a != null && mem.a.kind == AK.Ident() && LocalIdx(mem.a.sval) < 0
                    && FindClass(mem.a.sval) != null) {
                Node sg = AccessorInChain(mem.a.sval, "get_" + mem.sval);
                if (sg != null && HasMod(sg, MOD.Static())) {
                    LoadImm(0, 0);
                    BLInternal(MethSymNg(accOwnerCls, sg));
                    return;
                }
            }
            // property getter fallback: `obj.Prop` with no backing field
            // names the desugared get_Prop accessor
            string gc = ExprCls(mem.a);
            Node gm = gc != null ? AccessorInChain(gc, "get_" + mem.sval) : null;
            if (gm != null) {
                string targetCls = accOwnerCls;
                GenExpr(mem.a);
                BLInternal(MethSymNg(targetCls, gm));
                return;
            }
            diags.Error("ngen: unknown field '" + mem.sval + "'", mem.line, mem.col);
            LoadImm(0, 0);
            return;
        }
        GenExpr(mem.a);                                  // receiver -> x0
        Cls nxc = ExpandedStructOf(f);
        if (nxc != null) {
            // 批43:struct 值字段的读取 = 物化新箱(载荷从扁平区域拷贝),
            // 后续成员写永不穿透回父对象;null 接收者保持旧软零语义
            // (跳过物化,x0 = null 原样传递)
            if (mem.a.kind != AK.ThisExpr()) {
                int gEnd = NL();
                CbzReg(0, gEnd);
                MaterializeNestedBox(nxc, f);
                Mark(gEnd);
            } else {
                MaterializeNestedBox(nxc, f);
            }
            return;
        }
        if (mem.a.kind != AK.ThisExpr()) {
            // null receiver fails soft with a zero field value (gen0
            // parity: `t.name` on a null reference reports and reads null)
            int gEnd = NL();
            CbzReg(0, gEnd);
            LoadFieldNg(0, 0, f);                        // ldr x0, [x0, #off]
            Mark(gEnd);
            // fallthrough leaves x0 = 0 when the receiver was null
        } else {
            LoadFieldNg(0, 0, f);                        // ldr x0, [x0, #off]
        }
    }

    // static type name of an expression when it denotes a user class, else null
    string ExprCls(Node e) {
        if (e == null) { return null; }
        if (e.kind == AK.ThisExpr() || (e.kind == AK.Ident() && e.sval == "this")) { return curCls; }
        if (e.kind == AK.BaseExpr() || (e.kind == AK.Ident() && e.sval == "base")) {
            Cls bc = FindClass(curCls);
            return bc != null ? bc.baseName : null;
        }
        if (e.kind == AK.NewExpr()) { return e.type != null ? e.type.sval : null; }
        if (e.kind == AK.CastExpr() && e.type != null) { return ClassTyOf(e.type.sval); }
        if (e.kind == AK.AsExpr() && e.type != null) { return ClassTyOf(e.type.sval); }
        if (e.kind == AK.AwaitExpr()) { return ClassTyOf(AsyncAwaitElemTyNg(e.a)); }
        if (e.kind == AK.Index()) { return ClassTyOf(ElemTyOf(e)); }
        if (e.kind == AK.Call() && e.a != null) {
            // method results carry a class identity when the method's
            // declared return type names one (ChartOption.Create().x)
            return ClassTyOf(CallRetTy(e));
        }
        if (e.kind == AK.Ident()) {
            return ClassTyOf(NamedSlotTy(e.sval));
        }
        if (e.kind == AK.MemberAccess()) {
            // field chains resolve to the field's declared class
            // (`x.next.n` needs ExprCls of `x.next`)
            Fld mf = FieldOf(e);
            if (mf != null) { return ClassTyOf(mf.ty); }
            // qualified static field chains: `Store.items.Count` types the
            // receiver from the static field's declared type. A static
            // PROPERTY read (Encoding.UTF8) finds no field here and falls
            // through to the accessor typing below.
            if (e.a != null && e.a.kind == AK.Ident() && LocalIdx(e.a.sval) < 0
                    && FindClass(e.a.sval) != null) {
                string qst = FindStaticTy(QualifiedCls(e.a.sval, e.sval2), e.sval);
                if (qst != null) { return ClassTyOf(qst); }
            }
            // property getter member (`obj.Prop` with no backing field):
            // the accessor's declared return types the chain
            // (`b.Tags.Count` needs ExprCls(b.Tags) == "List")
            return ClassTyOf(PropGetterTy(e));
        }
        return null;
    }

    // element type name of an index expression ("l[i]" with l declared as
    // "List<Pt>" or "Pt[]"), or null. Struct elements resolve too: values
    // clone at every storage boundary now, so slots hold independent
    // objects and member access goes through the element pointer.
    string ElemTyOf(Node e) {
        if (e == null || e.a == null) { return null; }
        string el = null;
        if (ArrContainerTy(e.a) != null) {
            string at = ArrContainerTy(e.a);
            if (at != null && at.Length > 2) { el = ArrElemName(at); }
        } else if (ExprCls(e.a) == "List") {
            string ct = StaticTyOf(e.a);
            if (ct != null && ct.Length > 5 && ct.Substring(0, 5) == "List<"
                    && ct.Substring(ct.Length - 1, 1) == ">") {
                el = ct.Substring(5, ct.Length - 6);
            }
        } else if (ExprCls(e.a) == "Dict") {
            // Dictionary<string, V>[key] yields the value type
            string ct = StaticTyOf(e.a);
            if (ct != null && IsDictTyName(ct)
                    && ct.Substring(ct.Length - 1, 1) == ">") {
                string inner = ct.Substring(ct.IndexOf("<") + 1, ct.Length - ct.IndexOf("<") - 2);
                int comma = inner.IndexOf(",");
                el = comma >= 0 ? inner.Substring(comma + 1) : null;
            }
        } else if (IsDictViewAccess(e.a)) {
            // d.Keys[i] / d.Values[i]: the snapshot's element is the slot type
            el = DictSlotTy(e.a.a, e.a.sval == "Keys");
        }
        if (el == null) {
            // an indexer's element type is the op_index method's declared
            // return type (fit against the index expression for overloads)
            Node om = OpIndexFit(ExprCls(e.a), "op_index", e.b, null);
            if (om != null && om.type != null) { el = TypeFullName(om.type); }
        }
        if (el == null) { return null; }
        return el;
    }

    // "Dictionary<..."/"Dict<...": the builtin dict under either spelling
    bool IsDictTyName(string t) {
        return t != null && (t.IndexOf("Dictionary<") == 0 || t.IndexOf("Dict<") == 0);
    }

    // `d.Keys` / `d.Values` on a Dictionary expression: the snapshot-view
    // access that indexes and counts exactly like a List
    bool IsDictViewAccess(Node a) {
        return a != null && a.kind == AK.MemberAccess()
                && (a.sval == "Keys" || a.sval == "Values")
                && a.a != null && ExprCls(a.a) == "Dict";
    }

    // normalize a declared type name to its class identity ("List<string>"
    // behaves as its open type; primitive arrays carry none), else null
    string ClassTyOf(string t) {
        if (t == null || t == "" || IsNulTy(t) || t == "int" || t == "string" || t == "bool"
                || t == "void" || t == "char" || t == "double" || t == "long"
                || t == "ulong") { return null; }
        if (t.Length > 5 && t.Substring(0, 5) == "List<") { return "List"; }
        if (IsDictTyName(t)) { return "Dict"; }
        if (IsArrTy(t) && (t == "int[]" || t == "long[]" || t == "ulong[]"
                || t == "double[]" || t == "string[]" || t == "bool[]"
                || t == "char[]")) { return null; }
        // generics are erased: `GBox<bool>` names the open class `GBox`
        int lt = t.IndexOf("<");
        if (lt > 0) {
            string open = t.Substring(0, lt);
            if (FindClass(open) != null) { return open; }
        }
        return t;
    }

    // binary operator behind a compound assignment (+= -> +, ...), or 0
    int CompoundBinOp(int k2) {
        if (k2 == TK.PlusEq()) { return TK.Plus(); }
        if (k2 == TK.MinusEq()) { return TK.Minus(); }
        if (k2 == TK.StarEq()) { return TK.Star(); }
        if (k2 == TK.SlashEq()) { return TK.Slash(); }
        if (k2 == TK.PercentEq()) { return TK.Percent(); }
        if (k2 == TK.AmpEq()) { return TK.Amp(); }
        if (k2 == TK.PipeEq()) { return TK.Pipe(); }
        if (k2 == TK.CaretEq()) { return TK.Caret(); }
        if (k2 == TK.LessLessEq()) { return TK.LessLess(); }
        if (k2 == TK.GreaterGreaterEq()) { return TK.GreaterGreater(); }
        if (k2 == TK.GreaterGreaterGreaterEq()) { return TK.GreaterGreaterGreater(); }
        return 0;
    }

    // x is T / x is null. With single inheritance the receiver's static type
    // decides statically whenever the target is equal to or a base of it
    // (any instance of the receiver is then also a T, so only null fails).
    // When the receiver's type is a strict base of T the object's runtime
    // class has to be consulted via the site stamped by 'new'; unrelated
    // static types answer false, like gen0.
    // switch expression: `scrutinee switch { pat => result, ... }`. The
    // scrutinee evaluates exactly once and stays pushed on the machine
    // stack; every arm peeks at it through [sp], so a failed pattern or a
    // failed `when` guard falls through to later arms with the value
    // intact. The winning arm's result lands in x0, then the scrutinee pop
    // discards into x1. Type-pattern bindings are pre-stamped frame slots
    // (StampPatternBindings); the store peeks so the next arm can re-bind
    // the same scrutinee when a guard fails.
    void GenSwitchExpr(Node e) {
        GenExpr(e.a);                                    // x0 = scrutinee
        XPushV0();                                  // push scrutinee
        int endL = NL();
        string sst = StaticTyOf(e.a);
        int i = 0;
        while (i < e.kids.Count) {
            Node arm = e.kids[i];
            int nextL = NL();
            if (arm.a == null && arm.ival == 0) {
                // `_` discard: matches unconditionally
            } else if (arm.ival == 1) {
                LdrU(0, 31, 0);                          // x0 = scrutinee (peek)
                EmitTypeTestNg(arm.type != null ? arm.type.sval : null, sst);
                EmitCBZ(0, nextL);                       // no match: next arm
                if (arm.sval != null) {
                    int li = LocalIdx(arm.sval);
                    if (li >= 0) {
                        LdrU(1, 31, 0);                  // x1 = scrutinee
                        StoreLocal(li, 1);               // bind
                    }
                }
            } else if (arm.a != null && arm.a.kind == AK.NullLit()) {
                LdrU(1, 31, 0);                          // x1 = scrutinee
                E4(0xEB1F003F);                          // cmp x1, xzr
                EmitCbnz(1, nextL);                      // non-null: next arm
            } else if (arm.op == TK.Less() || arm.op == TK.Greater()
                    || arm.op == TK.LessEq() || arm.op == TK.GreaterEq()) {
                LdrU(1, 31, 0);                          // x1 = scrutinee
                GenExpr(arm.a);                          // x0 = bound
                CmpRR(1, 0);                          // cmp x1, x0
                int skip = 11;
                if (arm.op == TK.Less()) { skip = 10; }          // b.ge
                else if (arm.op == TK.Greater()) { skip = 13; }  // b.le
                else if (arm.op == TK.LessEq()) { skip = 12; }   // b.gt
                EmitBcond(skip, nextL);
            } else if (arm.a != null) {
                LdrU(1, 31, 0);                          // x1 = scrutinee
                GenExpr(arm.a);                          // x0 = constant
                CmpRR(1, 0);                          // cmp x1, x0
                EmitBcond(1, nextL);                     // b.ne: next arm
            }
            if (arm.c != null) {
                GenExpr(arm.c);                          // `when` guard
                EmitCBZ(0, nextL);                       // false: next arm
            }
            GenExpr(arm.b);                              // x0 = arm result
            if (IsDblExpr(e) && !IsDblExpr(arm.b)) { ConvI2D(); }
            XPopV(1);                              // pop scrutinee -> x1
            EmitB(endL);
            Mark(nextL);
            i = i + 1;
        }
        // no discard arm and nothing matched: the zero fallback (a null
        // string for string results), like the zero initializer
        XPopV(1);                                  // pop scrutinee -> x1
        LoadImm(0, 0);
        Mark(endL);
    }

    // tuple literal: alloc the synthesized layout and store each element
    // (clone semantics match a field write -- strings share, structs copy)
    void GenTupleNg(Node e) {
        string mangled = TupleExprMangledNg(e);
        EnsureTupleClsNg(mangled, TupleClsElemTysOfNg(mangled, e));
        int n2 = e.kids.Count;
        LoadImm(0, n2 * 8 + 16);
        LoadImm(1, 0);
        BLInternal("_zan_rt_alloc");                     // x0 = zeroed payload
        XPushV0();                                  // hold the payload
        int i = 0;
        while (i < e.kids.Count) {
            GenExpr(e.kids[i]);                          // x0 = element
            GenCloneIfStruct(e.kids[i]);
            LdrU(1, 31, 0);                              // x1 = payload (peek;
                                                         //  element eval pushes
                                                         //  are balanced)
            StrU(0, 1, 8 * i);                           // ItemN = element
            i = i + 1;
        }
        XPopV(0);                                  // pop payload -> x0
    }

    // the element types a registered tuple class was built with, computed
    // from the literal when the class lookup loses the race (both paths
    // mangle identically, so this only fires on inference-order edges)
    List<string> TupleClsElemTysOfNg(string mangled, Node lit) {
        Cls c = FindClass(mangled);
        if (c != null) {
            List<string> fs = new List<string>();
            int i = 0;
            while (i < c.flds.Count) { fs.Add(c.flds[i].ty); i = i + 1; }
            return fs;
        }
        List<string> etys = new List<string>();
        int j = 0;
        while (j < lit.kids.Count) { etys.Add(TupleElemTyNg(lit.kids[j])); j = j + 1; }
        return etys;
    }

    // deconstruction: `var (a, b) = rhs;` / `(int x, int y) = rhs;` -- the
    // rhs evaluates once to the tuple payload; slot i loads into the
    // pre-stamped binding local
    void GenDeconNg(Node s) {
        GenExpr(s.b);                                    // x0 = tuple payload
        XPushV0();                                  // hold it
        int i = 0;
        while (i < s.kids.Count) {
            Node p = s.kids[i];
            // slot by DECL NODE: the statement's env snapshot predates the
            // bound locals, so the name chain is trimmed back here
            int li = p.sval != null ? DeclSlotNg(p) : -1;
            if (li >= 0) {
                LdrU(0, 31, 0);                          // x0 = payload (peek)
                LdrU(2, 0, 8 * i);                       // x2 = element i
                StoreLocal(li, 2);
            }
            i = i + 1;
        }
        XPopV(1);                                  // pop payload -> x1
    }

    // the Task / Task<T> shape of an expression's static type, else null
    string TaskTyOfNg(Node e) {
        string t = StaticTyOf(e);
        if (t != null && (t == "Task" || t.IndexOf("Task<") == 0)) { return t; }
        return null;
    }

    // t.IsCompleted / t.Result property reads on a Task-typed value -- the
    // same semantics as the call forms: the null frame of an inline-run
    // Task.Run body is already done with result 0; Result pumps the driver
    // until the frame completes, rethrows a captured exception, and reads
    // frame+32
    void GenTaskMemberRead(Node e) {
        GenExpr(e.a);                                    // x0 = frame handle
        int tnull = NL();
        int tend = NL();
        if (e.sval == "IsCompleted") {
            CbzReg(0, tnull);
            LdrU(0, 0, 8);                               // frame.done
            if (tgt86 == 1) { X3(0x48, 0x83, 0xFF); X1(0x00); } else { E4(0xEB1F001F); }                              // cmp x0, xzr
            if (tgt86 == 1) { X3(0x0F, 0x95, 0xC0); X3(0x48, 0x0F, 0xB6); X1(0xF8); } else { E4(0x9A9F07E0); }                              // cset x0, ne
            EmitB(tend);
            Mark(tnull);
            LoadImm(0, 1);                               // null frame: done
            Mark(tend);
            return;
        }
        CbzReg(0, tnull);
        XPushV0();                                  // frame stays live
        AddImm(0, 0, 8);                                 // x0 = &frame.done
        LoadImm(1, 1);                                   // mode 1: quiesce
        BLInternal("_zan_co_sched_run_until");
        PopV(9);                                  // x9 = frame
        AsyncSubExcCheckNg();                            // Result rethrows
        LdrU(0, 9, 32);                                  // frame.result
        EmitB(tend);
        Mark(tnull);
        LoadImm(0, 0);                                   // null frame: inline-run body, no result
        Mark(tend);
    }

    // the type test half of `x is T` with the value already in x0: x0 <- 1
    // when it is a T, 0 otherwise. GenSwitchExpr peeks its pushed scrutinee
    // through here so arms share GenIs's exact matching rule (gen0's rule:
    // same-or-base statics answer non-null, strict downcasts and object/
    // interface sources consult the runtime site, and a heap string in the
    // slot carries the "ZANS" obj-8 tag the site walk never matches).
    void GenCall(Node e) {
        // Task.Spawn(<async call>) / Task.Run(<async call>) in a value
        // position: detach the coroutine, yield its handle (the statement
        // form is PrepareAsyncStmtNg's job and runs before this for ExprStmt)
        if (TryGenTaskSpawnValueNg(e)) { return; }
        // the pre-pass scans original bodies only; a call inside a
        // specialization body (the template's `SumNum<T>` after T bound to
        // int) would otherwise resolve to the OPEN generic template, whose
        // symbol is never emitted. The pre-pass's specMeth dedup makes the
        // second pass safe on original bodies.
        if (e.a != null && (e.a.kind == AK.Ident() || e.a.kind == AK.MemberAccess())) {
            CollectSpecsInEnvNg(e);
        }
        if (e.a != null && e.a.kind == AK.MemberAccess() && e.a.ival == 1) {
            // null-conditional call `a?.M(args)`: the receiver is tested
            // once; a null yields the null of the result type (a value
            // return wraps on the taken path). The ordinary call re-reads
            // the receiver -- fine for the suite's local receivers.
            Node qcal = e.a;
            string qrt = CallRetTy(e);
            GenExpr(qcal.a);                             // x0 = receiver
            int cqnull = NL();
            int cqfin = NL();
            CbzReg(0, cqnull);
            qcal.ival = 0;                               // ordinary call
            GenCall(e);
            qcal.ival = 1;
            if (qrt != null && IsNulableValueTy(qrt)) { GenNulWrap(IsDblTy(qrt)); }
            EmitB(cqfin);
            Mark(cqnull);
            LoadImm(0, 0);
            Mark(cqfin);
            return;
        }
        if (TryGenDelegateCall(e)) { return; }
        if (e.a != null && e.a.kind == AK.Ident() && e.a.sval == "sizeof"
                && e.kids.Count == 1) {
            // sizeof(T): the mapped type's store width (the oracle's
            // LLVMSizeOf -- char rides the i64 spelling, so 8); unknown
            // shapes answer the word size
            Node stk = e.kids[0];
            string stn = stk != null ? (stk.type != null ? TypeFullName(stk.type) : stk.sval) : "";
            LoadImm(0, SizeOfTyName(stn));
            return;
        }
        if (TryGenPackedSlice(e)) { return; }
        if (TryGenHostCall(e)) { return; }
        if (TryGenStringCall(e)) { return; }
        if (TryGenReflCall(e)) { return; }
        Node callee = e.a;
        if (callee != null && callee.kind == AK.MemberAccess()) {
            Node recv = callee.a;
            // nullable.GetValueOrDefault([fallback]): the payload when the
            // cell is set, else the fallback (0 / default(T))
            if (callee.sval == "GetValueOrDefault" && recv != null
                    && IsNulTy(StaticTyOf(recv))) {
                string gpay = NulPayOf(StaticTyOf(recv));
                GenExpr(recv);                           // x0 = cell
                int gnull = NL();
                int gend = NL();
                CbzReg(0, gnull);
                LdrU(0, 0, 0);                           // has: the payload
                if (IsDblTy(gpay)) { if (tgt86 == 1) { X3(0x66, 0x48, 0x0F); X2(0x6E, 0xC7); } else { E4(0x9E670000); } }   // fmov d0, x0
                EmitB(gend);
                Mark(gnull);
                if (e.kids.Count == 1) {
                    GenExpr(e.kids[0]);                  // null: the fallback
                    if (IsDblTy(gpay) && !IsDblExpr(e.kids[0])) { ConvI2D(); }
                } else {
                    LoadImm(0, 0);
                    if (IsDblTy(gpay)) { if (tgt86 == 1) { X3(0x66, 0x48, 0x0F); X2(0x6E, 0xC7); } else { E4(0x9E670000); } }   // fmov d0, x0
                }
                Mark(gend);
                return;
            }
            // Task-value members: t.Wait() pumps the driver until the frame
            // completes (and rethrows a captured exception, like Task.Wait);
            // t.Result waits and reads frame+32; t.IsCompleted answers the
            // done word. The null frame (an inline-run Task.Run body) is
            // already done with no result.
            if (recv != null) {
                string rtt = StaticTyOf(recv);
                if (rtt != null && (rtt == "Task" || rtt.IndexOf("Task<") == 0)
                        && (callee.sval == "Wait" || callee.sval == "Result"
                            || callee.sval == "IsCompleted")) {
                    GenExpr(recv);                       // x0 = frame handle
                    int tnull = NL();
                    int tend = NL();
                    if (callee.sval == "IsCompleted") {
                        CbzReg(0, tnull);
                        LdrU(0, 0, 8);                   // frame.done
                        if (tgt86 == 1) { X3(0x48, 0x83, 0xFF); X1(0x00); } else { E4(0xEB1F001F); }                  // cmp x0, xzr
                        if (tgt86 == 1) { X3(0x0F, 0x95, 0xC0); X3(0x48, 0x0F, 0xB6); X1(0xF8); } else { E4(0x9A9F07E0); }                  // cset x0, ne
                        EmitB(tend);
                        Mark(tnull);
                        LoadImm(0, 1);                   // null frame: done
                        Mark(tend);
                        return;
                    }
                    CbzReg(0, tnull);
                    XPushV0();                      // hold frame (receiver
                                                         //  must evaluate once)
                    AddImm(0, 0, 8);                     // x0 = &frame.done
                    LoadImm(1, 1);                       // mode 1: quiesce
                    BLInternal("_zan_co_sched_run_until");
                    PopV(9);                      // x9 = frame
                    if (callee.sval == "Result") {
                        AsyncSubExcCheckNg();            // Wait/Result rethrow
                        LdrU(0, 9, 32);                  // frame.result
                    }
                    EmitB(tend);
                    Mark(tnull);
                    LoadImm(0, 0);                       // null frame: inline-run
                                                         //  body, done, no result
                    Mark(tend);
                    return;
                }
            }
            // rect.GetLength(d): the dim lives at arr + 8*d in the mdarray
            // header (the rank>1 shape only)
            if (recv != null && callee.sval == "GetLength" && e.kids.Count == 1
                    && ArrContainerTy(recv) != null
                    && ArrRankOf(ArrContainerTy(recv)) > 1) {
                GenExpr(recv);                           // x0 = arr
                XPushV0();
                GenExpr(e.kids[0]);                      // x0 = dim
                XPopV(1);                          // pop arr -> x1
                E4(0xF8607820);                          // ldr x0, [x1, x0, lsl #3]
                return;
            }
            // arr.AsSpan([start[,len]]) / span.Slice(start[,len]): build the
            // boxed {base, len} view (see GenSpanView)
            if (recv != null && callee.sval == "AsSpan" && e.kids.Count <= 2
                    && ArrContainerTy(recv) != null) {
                GenSpanView(e, recv, ArrContainerTy(recv), false);
                return;
            }
            if (recv != null && callee.sval == "Slice" && e.kids.Count >= 1
                    && e.kids.Count <= 2 && SpanContainerTy(recv) != null) {
                GenSpanView(e, recv, SpanContainerTy(recv), true);
                return;
            }
            // base.Method(args): invoke the nearest implementation above
            // curCls directly (nonvirtual) with `this` as the receiver
            if (recv != null && (recv.kind == AK.BaseExpr() || (recv.kind == AK.Ident() && recv.sval == "base"))) {
                int bi2 = ResolveBaseImplNg(callee.sval, e);
                if (bi2 >= 0) {
                    GenExpr(new Node(AK.ThisExpr()));
                    XPushV0();                          // str x0, [sp, #-16]!
                    int pushed2 = PushCallArgs(methNodes[bi2], e);
                    int r2 = pushed2;
                    int armOvfArea2 = 0;
                    if (tgt86 == 1) {
                        while (r2 >= 1) {
                            if (r2 < 6) {
                                XopRMem(0x8B, XMapReal(r2), 4, 16 * (pushed2 - r2));
                            } else {
                                XopRMem(0x8B, 10, 4, 16 * (pushed2 - r2));
                                XSetV(XArgVOf(r2), 10);
                            }
                            r2 = r2 - 1;
                        }
                        XopRMem(0x8B, XMapReal(0), 4, 16 * pushed2);
                        XAddRsp(16 * (pushed2 + 1));
                        xStackArgs = pushed2 > 5 ? pushed2 - 5 : 0;
                    } else if (pushed2 + 1 > 16) {
                        int novf2 = pushed2 + 1 - 16;
                        armOvfArea2 = 16 * ((novf2 + 1) / 2);
                        AddSPImm(armOvfArea2, false);
                        LdrU(0, 31, armOvfArea2 + 16 * pushed2);
                        int k = 1;
                        while (k <= pushed2) {
                            int off = armOvfArea2 + 16 * (pushed2 - k);
                            if (k < 16) { LdrU(k, 31, off); }
                            else { LdrU(10, 31, off); StrU(10, 31, 8 * (k - 16)); }
                            k = k + 1;
                        }
                    } else {
                        while (r2 >= 1) { XPopV(r2); r2 = r2 - 1; }
                        XPopV(0);                          // ldr x0, [sp], #16 (this)
                    }
                    BLInternal(MethSymNg(methCls[bi2], methNodes[bi2]));
                    if (armOvfArea2 > 0) { AddSPImm(armOvfArea2 + 16 * (pushed2 + 1), true); }
                    return;
                }
            }
            if (recv != null && recv.kind == AK.Ident() && recv.sval == "Console"
                    && !UserDefinesClsMember("Console", callee.sval)
                    && callee.sval == "WriteLine" && e.kids.Count == 1) {
                // own runtime core: print_int(i64) / println(str)
                if (IsStrExpr(e.kids[0])) {
                    GenExpr(e.kids[0]);
                    BLInternal("_zan_rt_println");
                } else if (IsCharExpr(e.kids[0])) {
                    GenExpr(e.kids[0]);
                    BLInternal("_zan_rt_chrstr");
                    BLInternal("_zan_rt_println");
                } else if (IsBoolExpr(e.kids[0])) {
                    // gen0 prints bools as true/false (select of literals)
                    GenExpr(e.kids[0]);
                    int fls = NL();
                    int doneb = NL();
                    CbzReg(0, fls);
                    LoadStr(InternStr("true"), 0);
                    EmitB(doneb);
                    Mark(fls);
                    LoadStr(InternStr("false"), 0);
                    Mark(doneb);
                    BLInternal("_zan_rt_println");
                } else if (IsDblExpr(e.kids[0])) {
                    GenExpr(e.kids[0]);
                    if (tgt86 != 1) { E4(0x9E670000); }  // fmov d0, x0 (x86 keeps the bits in rdi)
                    BLExtern("_zan_rt_print_double");
                } else if (IsUlongExpr(e.kids[0])) {
                    GenExpr(e.kids[0]);
                    BLInternal("_zan_rt_print_uint");
                } else if (IsNulExpr(e.kids[0])
                        && NulPayOf(StaticTyOf(e.kids[0])) != null) {
                    // a nullable value prints its payload, or an empty line
                    // when null (gen0's Nullable.ToString())
                    Node w0 = e.kids[0];
                    string wpay = NulPayOf(StaticTyOf(w0));
                    GenExpr(w0);                         // x0 = cell
                    int wnull = NL();
                    int wend = NL();
                    CbzReg(0, wnull);                    // null: empty line
                    LdrU(0, 0, 0);                       // payload
                    if (IsDblTy(wpay)) {
                        if (tgt86 != 1) { E4(0x9E670000); }   // fmov d0, x0 (x86 keeps the bits in rdi)
                        BLExtern("_zan_rt_print_double");
                    } else if (wpay == "char") {
                        BLInternal("_zan_rt_chrstr");
                        BLInternal("_zan_rt_println");
                    } else if (wpay == "ulong") {
                        BLInternal("_zan_rt_print_uint");
                    } else {
                        BLInternal("_zan_rt_print_int");
                    }
                    EmitB(wend);
                    Mark(wnull);
                    LoadStr(InternStr(""), 0);
                    BLInternal("_zan_rt_println");
                    Mark(wend);
                } else {
                    GenExpr(e.kids[0]);
                    BLInternal("_zan_rt_print_int");
                }
                return;
            }
            // Console.WriteLine() with no arguments prints just the newline
            if (recv != null && recv.kind == AK.Ident() && recv.sval == "Console"
                    && !UserDefinesClsMember("Console", callee.sval)
                    && callee.sval == "WriteLine" && e.kids.Count == 0) {
                LoadStr(InternStr(""), 0);
                BLInternal("_zan_rt_println");
                return;
            }
            // Console.Write: no newline; gen0 routes every argument type
            // through its string form and printf("%s", s)
            if (recv != null && recv.kind == AK.Ident() && recv.sval == "Console"
                    && !UserDefinesClsMember("Console", callee.sval)
                    && callee.sval == "Write" && e.kids.Count == 1) {
                Node arg = e.kids[0];
                if (IsStrExpr(arg)) { GenExpr(arg); }
                else if (IsCharExpr(arg)) {
                    GenExpr(arg); BLInternal("_zan_rt_chrstr");
                } else if (IsBoolExpr(arg)) {
                    GenExpr(arg);
                    int fls = NL();
                    int doneb = NL();
                    CbzReg(0, fls);
                    LoadStr(InternStr("true"), 0);
                    EmitB(doneb);
                    Mark(fls);
                    LoadStr(InternStr("false"), 0);
                    Mark(doneb);
                } else if (IsDblExpr(arg)) {
                    GenExpr(arg); BLInternal("_zan_rt_dbl2str");
                } else if (IsUlongExpr(arg)) {
                    GenExpr(arg); BLInternal("_zan_rt_uint2str");
                } else if (IsNulExpr(arg) && NulPayOf(StaticTyOf(arg)) != null) {
                    GenNulToStr(arg);                    // null renders ""
                } else {
                    GenExpr(arg); BLInternal("_zan_rt_int2str");
                }
                XPushV0();                      // push s (stack variadic)
                if (EnvTargetElf() == 1 || tgt86 == 1) {
                    LdrU(1, 31, 0);                  // 寄存器变参:SysV 第 2 参在 rsi
                                                     // (elf 臂同为寄存器变参 r1);
                                                     // arm64-darwin 变参在栈上,push 即可
                }
                LoadSymRef("l_.str." + fmtwIdx, 0);  // x0 = "%s"
                BLExtern("_printf");
                if (EnvTargetElf() == 0) {
                    AddSPImm(16, true);              // drop the Darwin stack slot
                }
                return;
            }
            // Math static methods. Integer forms: Abs is a negate and
            // Max/Min are a csel over a signed compare (gen0 lowers them
            // the same way for i64). Double forms call libm with the value
            // in d0 (Pow takes d0 + d1) and come back as the bit pattern
            // in x0.
            if (recv != null && recv.kind == AK.Ident() && recv.sval == "Math"
                    && !UserDefinesClsMember("Math", callee.sval)) {
                string mn = callee.sval;
                if (mn == "Abs" && e.kids.Count == 1) {
                    GenExpr(e.kids[0]);
                    if (IsDblExpr(e.kids[0])) {
                        DblLibm1("_fabs");
                    } else if (tgt86 == 1) { X3(0x48, 0xF7, 0xDF); }    // neg rdi
                    else {
                        E4(0xCB0003E0);                  // neg x0, x0
                    }
                    return;
                }
                if ((mn == "Max" || mn == "Min") && e.kids.Count == 2) {
                    if (IsDblExpr(e.kids[0]) || IsDblExpr(e.kids[1])) {
                        // both arguments move to d0/d1 only after BOTH are
                        // evaluated: GenExpr may call strtod (returning in
                        // d0) for lazy double literals, which would clobber
                        // a value parked in d0 early
                        GenExpr(e.kids[0]);
                        XPushV0();                  // push a
                        GenExpr(e.kids[1]);
                        XPopV(1);                        // pop a -> x1 (x0 = b)
                        if (tgt86 == 1) {
                            X3(0x66, 0x48, 0x0F); X2(0x6E, 0xCF);           // movq xmm1, rdi
                        } else { E4(0x9E670001); }       // fmov d1, x0
                        if (!IsDblExpr(e.kids[1])) {
                            if (tgt86 == 1) { X4(0x2A0F48F2); X1(0xCE); }   // cvtsi2sd xmm1, rsi
                            else { E4(0x9E620022); }     // scvtf d1, x1
                        }
                        MovRR(0, 1);                     // mov x0, x1
                        if (tgt86 == 1) {
                            X3(0x66, 0x48, 0x0F); X2(0x6E, 0xC7);           // movq xmm0, rdi
                        } else { E4(0x9E670000); }       // fmov d0, x0
                        if (!IsDblExpr(e.kids[0])) {
                            if (tgt86 == 1) { X4(0x2A0F48F2); X1(0xCF); }   // cvtsi2sd xmm0, rdi
                            else { E4(0x9E620020); }     // scvtf d0, x0
                        }
                        if (mn == "Max") { BLExtern("_fmax"); } else { BLExtern("_fmin"); }
                        if (tgt86 == 1) {
                            X3(0x66, 0x48, 0x0F); X2(0x7E, 0xC7);           // movq rdi, xmm0
                        } else { E4(0x9E660000); }       // fmov x0, d0
                    } else {
                        GenExpr(e.kids[0]);
                        XPushV0();                  // push a
                        GenExpr(e.kids[1]);
                        XPopV(1);                        // pop a -> x1 (x0 = b)
                        if (tgt86 == 1) {
                            Xop(0x39, 7, 6);             // cmp b, a (rdi-rsi; 编码 6=rsi, 1 是 rcx)
                            if (mn == "Max") { X4(0xFE4E0F48); }    // cmovle rdi, rsi (b<=a 取 a)
                            else { X4(0xFE4D0F48); }                // cmovge rdi, rsi (b>=a 取 a)
                        } else {
                            CmpRR(0, 1);              // cmp x0, x1
                            if (mn == "Max") { E4(0x9A81C000); } // csel x0, x0, x1, gt
                            else { E4(0x9A81B000); }         // csel x0, x0, x1, lt
                        }
                    }
                    return;
                }
                if (mn == "Sqrt" && e.kids.Count == 1) {
                    GenExpr(e.kids[0]);
                    DblLibm1("_sqrt");
                    return;
                }
                if (mn == "Floor" && e.kids.Count == 1) {
                    GenExpr(e.kids[0]);
                    DblLibm1("_floor");
                    return;
                }
                if (mn == "Ceiling" && e.kids.Count == 1) {
                    GenExpr(e.kids[0]);
                    DblLibm1("_ceil");
                    return;
                }
                // gen0 routes Sin/Cos/Tan/Log/Exp to libm (double -> double),
                // coercing integer arguments with sitofp
                if ((mn == "Sin" || mn == "Cos" || mn == "Tan" || mn == "Log" || mn == "Exp"
                        || mn == "Atan" || mn == "Asin" || mn == "Acos")
                        && e.kids.Count == 1) {
                    GenExpr(e.kids[0]);
                    if (!IsDblExpr(e.kids[0])) {
                        if (tgt86 == 1) { X4(0x2A0F48F2); X1(0xC7); } else { E4(0x9E620000); }                  // scvtf d0, x0
                        if (tgt86 == 1) { X3(0x66, 0x48, 0x0F); X2(0x7E, 0xC7); } else { E4(0x9E660000); }                  // fmov x0, d0
                    }
                    string lf = "_sin";
                    if (mn == "Cos") { lf = "_cos"; } else if (mn == "Tan") { lf = "_tan"; }
                    else if (mn == "Log") { lf = "_log"; } else if (mn == "Exp") { lf = "_exp"; }
                    else if (mn == "Atan") { lf = "_atan"; } else if (mn == "Asin") { lf = "_asin"; }
                    else if (mn == "Acos") { lf = "_acos"; }
                    DblLibm1(lf);
                    return;
                }
                // Math.Round(x[, digits]): rint(x * 10^d) / 10^d via libm
                // rint/pow (integer arguments coerce with sitofp, like gen0).
                // C# rounds to even (banker's) -- libm rint does that under the
                // default FP mode, libm round is away-from-zero (TASKS.md
                // A513).
                // No value may sit in a d-reg across a GenExpr call (lazy
                // double literals return theirs in d0), so both operands are
                // spilled first; the scale lives in callee-saved x19 across
                // the rint call since the divide needs it again (x is the
                // deepest stack slot, so a second spill copy would bury it).
                if (mn == "Round" && (e.kids.Count == 1 || e.kids.Count == 2)) {
                    GenExpr(e.kids[0]);
                    if (!IsDblExpr(e.kids[0])) {
                        if (tgt86 == 1) { X4(0x2A0F48F2); X1(0xC7); } else { E4(0x9E620000); }                  // scvtf d0, x0
                        if (tgt86 == 1) { X3(0x66, 0x48, 0x0F); X2(0x7E, 0xC7); } else { E4(0x9E660000); }                  // fmov x0, d0
                    }
                    if (e.kids.Count == 1) {
                        DblLibm1("_rint");
                        return;
                    }
                    XPushV0();                      // push x (bits)
                    GenExpr(e.kids[1]);
                    if (!IsDblExpr(e.kids[1])) {
                        if (tgt86 == 1) { X4(0x2A0F48F2); X1(0xC7); } else { E4(0x9E620000); }                  // scvtf d0, x0
                        if (tgt86 == 1) { X3(0x66, 0x48, 0x0F); X2(0x7E, 0xC7); } else { E4(0x9E660000); }                  // fmov x0, d0
                    }
                    XPushV0();                      // push digits (bits)
                    LoadImm(0, 4621819117588971520);     // 10.0 IEEE bits
                    XPopV(1);                      // pop digits -> x1 (x0 = 10.0)
                    if (tgt86 == 1) { X3(0x66, 0x48, 0x0F); X2(0x6E, 0xC7); } else { E4(0x9E670000); }                      // fmov d0, x0
                    if (tgt86 == 1) { X3(0x66, 0x48, 0x0F); X2(0x6E, 0xCE); } else { E4(0x9E670021); }                      // fmov d1, x1
                    BLExtern("_pow");
                    if (tgt86 == 1) { X3(0x66, 0x48, 0x0F); X2(0x7E, 0xC7); } else { E4(0x9E660000); }                      // fmov x0, d0 (scale)
                    MovRR(19, 0);                        // x19 = scale (call-preserved)
                    XPopV(0);                      // pop x -> x0
                    if (tgt86 == 1) { X3(0x66, 0x48, 0x0F); X2(0x6E, 0xC7); } else { E4(0x9E670000); }                      // fmov d0, x0 (d0 = x)
                    if (tgt86 == 1) { XGetV(19, 10); X3(0x66, 0x49, 0x0F); X2(0x6E, 0xCA); } else { E4(0x9E670261); }                      // fmov d1, x19 (d1 = scale)
                    if (tgt86 == 1) { X4(0xC1590FF2); } else { E4(0x1E600820); }                      // fmul d0, d1, d0 (x * scale)
                    if (tgt86 == 1) { X3(0x66, 0x48, 0x0F); X2(0x7E, 0xC7); } else { E4(0x9E660000); }                      // fmov x0, d0
                    DblLibm1("_rint");                  // rint(x * scale)
                    if (tgt86 == 1) { X3(0x66, 0x48, 0x0F); X2(0x6E, 0xC7); } else { E4(0x9E670000); }                      // fmov d0, x0 (rounded)
                    if (tgt86 == 1) { XGetV(19, 10); X3(0x66, 0x49, 0x0F); X2(0x6E, 0xCA); } else { E4(0x9E670261); }                      // fmov d1, x19 (scale)
                    if (tgt86 == 1) { X4(0xC15E0FF2); } else { E4(0x1E611800); }                      // fdiv d0, d0, d1
                    if (tgt86 == 1) { X3(0x66, 0x48, 0x0F); X2(0x7E, 0xC7); } else { E4(0x9E660000); }                      // fmov x0, d0
                    return;
