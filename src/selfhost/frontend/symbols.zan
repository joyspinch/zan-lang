using System.Text;

namespace Zan;

public class SymbolIndex {
    // The unit is the declaration tree returned by Parser.ParseMetadata.
    public static string Export(Node unit) {
        StringBuilder text = new StringBuilder();
        text.Append("# zan-symbols 1\n");
        AppendBuiltins(text);
        if (unit != null && unit.kind == AK.CompUnit()) {
            for (int i = 0; i < unit.kids.Count; i = i + 1) {
                Node decl = unit.kids[i];
                if (decl != null) { AppendType(text, decl); }
            }
        }
        return text.ToString();
    }

    static void AppendType(StringBuilder text, Node decl) {
        string kind;
        if (decl.kind == AK.ClassDecl()) {
            kind = (decl.mods & MOD.Iface()) != 0 ? "interface" : "class";
        } else if (decl.kind == AK.StructDecl()) {
            kind = "struct";
        } else if (decl.kind == AK.EnumDecl()) {
            kind = "enum";
        } else {
            return;
        }

        text.Append("T\t");
        text.Append(kind);
        text.Append("\t");
        text.Append(decl.nsName == null ? "" : decl.nsName);
        text.Append("\t");
        text.Append(decl.sval);
        text.Append("\t");
        if (decl.kind != AK.EnumDecl()) {
            AppendTypeName(text, decl.type);
            if (decl.interfaceRefs != null) {
                for (int i = 0; i < decl.interfaceRefs.Count; i = i + 1) {
                    if (decl.type != null || i > 0) { text.Append(","); }
                    AppendTypeName(text, decl.interfaceRefs[i]);
                }
            }
        }
        text.Append("\n");

        for (int i = 0; i < decl.kids.Count; i = i + 1) {
            Node member = decl.kids[i];
            if (member != null) { AppendMember(text, decl.sval, member); }
        }
    }

    static void AppendMember(StringBuilder text, string owner, Node member) {
        int kind = member.kind;
        string name = member.sval;
        string memberKind;
        bool isStatic = (member.mods & MOD.Static()) != 0;
        if (kind == AK.MethodDecl()) {
            memberKind = "M";
        } else if (kind == AK.CtorDecl()) {
            memberKind = "C";
            name = owner;
            isStatic = false;
        } else if (kind == AK.FieldDecl() || kind == AK.PropertyDecl()) {
            memberKind = kind == AK.PropertyDecl() ? "P" : "F";
            if ((member.mods & MOD.Event()) != 0) { memberKind = "E"; }
        } else if (kind == AK.EnumMember()) {
            memberKind = "F";
            isStatic = true;
        } else {
            return;
        }

        text.Append("M\t");
        text.Append(owner);
        text.Append("\t");
        text.Append(name);
        text.Append("\t");
        text.Append(memberKind);
        text.Append(isStatic ? "\t1\t" : "\t0\t");
        if (kind == AK.MethodDecl() || kind == AK.CtorDecl()) {
            AppendMethodSignature(text, member);
            if (kind == AK.MethodDecl()) {
                text.Append(IsExternDeclaration(member) ? "\tx" : "\t");
            }
        } else {
            if (kind == AK.EnumMember()) { text.Append(owner); }
            else { AppendTypeName(text, member.type); }
            text.Append(" ");
            text.Append(name);
        }
        text.Append("\n");
    }

    static bool IsExternDeclaration(Node method) {
        if (method.d != null) { return false; }
        if ((method.mods & MOD.Extern()) != 0) { return true; }
        if (method.attributes == null) { return false; }
        // C recognizes DllImport on any bodyless method with a positional library string.
        for (int i = 0; i < method.attributes.Count; i = i + 1) {
            Node attr = method.attributes[i];
            int dot = attr.sval.LastIndexOf(".");
            if (attr.sval.Substring(dot + 1) != "DllImport") { continue; }
            for (int j = 0; j < attr.kids.Count; j = j + 1) {
                Node arg = attr.kids[j];
                if (arg.kind == AK.StringLit() && arg.b == null) { return true; }
            }
        }
        return false;
    }

    static void AppendMethodSignature(StringBuilder text, Node method) {
        if (method.type == null) { text.Append("void"); }
        else { AppendTypeName(text, method.type); }
        text.Append(" ");
        text.Append(method.sval);
        text.Append("(");
        bool first = true;
        for (int i = 0; i < method.kids.Count; i = i + 1) {
            Node param = method.kids[i];
            if (param.kind != AK.Param()) { continue; }
            if (!first) { text.Append(", "); }
            if (first && method.ival == 1) { text.Append("this "); }
            if (param.ival == 1) { text.Append("ref "); }
            else if (param.ival == 2) { text.Append("out "); }
            AppendTypeName(text, param.type);
            text.Append(" ");
            text.Append(param.sval);
            first = false;
        }
        text.Append(")");
    }

    static void AppendTypeName(StringBuilder text, Node type) {
        // Version 1 renders type references and qualified names. The Zan
        // parser stores the latter as dotted type names and marks tuples with op 2.
        if (type == null || type.kind != AK.TypeRef() || type.op == 2) { return; }
        text.Append(type.sval);
        // C symbols.c renders only the outer array wrapper.
        if (type.ival > 0) {
            text.Append("[]");
        } else if (type.kids.Count > 0) {
            text.Append("<");
            for (int i = 0; i < type.kids.Count; i = i + 1) {
                if (i > 0) { text.Append(", "); }
                AppendTypeName(text, type.kids[i]);
            }
            text.Append(">");
        }
        if (type.op == 1) { text.Append("?"); }
    }

