using System;
using System.Collections.Generic;
namespace Zan;

public partial class Checker {
    // ---- expression typer (null == unknown) ----
    Node InferType(Node e) {
        infCount = infCount + 1;
        if (e == null) { return null; }
        int k = e.kind;
        if (k == AK.IntLit()) { return MkType(IntLitTypeName(e)); }
        if (k == AK.FloatLit()) { return MkType(FloatLitTypeName(e)); }
        if (k == AK.StringLit()) {
            if (e.b != null) { return MkType("TypeInfo"); }
            return MkType("string");
        }
        if (k == AK.CharLit()) { return MkType("char"); }
        if (k == AK.BoolLit()) { return MkType("bool"); }
        if (k == AK.NullLit()) { return null; }
        if (k == AK.ThisExpr()) { if (curClass != null) { return MkType(curClass.sval); } return null; }
        if (k == AK.Ident()) {
            int si = ScopeIdx(e.sval);
            if (si >= 0) { return scopeType[si]; }
            Node f = FieldUp(curClass, e.sval);
            if (f != null) { return f.type; }
            // a bare property name reads through its getter accessor
            Node g = MethodUp(curClass, "get_" + e.sval);
            if (g != null) { return g.type; }
            return null;
        }
        if (k == AK.CastExpr()) { return e.type; }
        if (k == AK.AsExpr()) { return e.type; }
        if (k == AK.Lambda()) {
            if (e.type != null) { return e.type; }
            if (IsTreeLambda(e)) { return e.kids[0].type; }
            if (e.a != null) { return InferType(e.a); }
            return null;
        }
        if (k == AK.AwaitExpr()) { return InferType(e.a); }
        if (k == AK.NewExpr()) { return e.type; }
        if (k == AK.CallInit()) { return InferType(e.a); }
        if (k == AK.IsExpr()) { return MkType("bool"); }
        if (k == AK.QueryExpr()) {
            Node srcT = InferType(e.a);
            Node elem = null;
            if (srcT != null && srcT.sval == "List" && srcT.kids.Count > 0) { elem = srcT.kids[0]; }
            int qm = ScopeMark();
            ScopeAdd(e.sval, elem);
            Node sel = InferType(e.b);
            ScopeTrim(qm);
            if (sel == null) { sel = elem; }
            Node lst = MkType("List");
            lst.Add(sel);
            return lst;
        }
        if (k == AK.Unary()) {
            if (e.op == TK.Bang()) { return MkType("bool"); }
            return InferType(e.a);
        }
        if (k == AK.PostfixUnary()) {
            Node t = InferType(e.a);
            if (e.op == TK.Bang() && t != null && t.op == 1) {
                Node nonNull = MkType(t.sval);
                nonNull.op = 0;
                nonNull.kids = t.kids;
                nonNull.ival = t.ival;
                return nonNull;
            }
            return t;
        }
        if (k == AK.Binary()) {
            int op = e.op;
            if (op == TK.EqEq() || op == TK.BangEq() || op == TK.Less() || op == TK.Greater()
                || op == TK.LessEq() || op == TK.GreaterEq() || op == TK.AmpAmp() || op == TK.PipePipe()) {
                return MkType("bool");
            }
            // A536 家族（宿主 emit_null_coalesce 同口径）：T? ?? T 的结果是
            // 负载类型 T（右支非可空则解包）；T? ?? T? 与 T ?? T 维持左支。
            // 曾无 QQ 分支——InferType 返回左支 int?，`int y = x ?? 5;` 被
            // assignability 当场拒收（宿主 p07_nullable 一线）。
            if (op == TK.QQ()) {
                Node lt = InferType(e.a);
                Node rt = InferType(e.b);
                if (lt == null) { return rt; }
                if (rt == null) { return lt; }
                if (lt.op == 1) {
                    if (rt.op == 1) { return lt; }
                    if (IsValueType(lt)) {
                        // T? ?? T → 负载形态：给发射端钉标记（binary 节点 ival
                        // 其余未用），发射走解箱 phi。
                        e.ival = 1;
                    }
                    Node res = MkType(lt.sval);
                    res.ival = lt.ival;
                    int k2 = 0;
                    while (k2 < lt.kids.Count) { res.kids.Add(lt.kids[k2]); k2 = k2 + 1; }
                    return res;
                }
                return lt;
            }
            Node lt = InferType(e.a);
            Node rt = InferType(e.b);
            if (IsStr(lt) || IsStr(rt)) { return MkType("string"); }
            if (lt != null) { return lt; }
            return rt;
        }
        if (k == AK.Conditional()) {
            // `c ? a : b` -- the type of the whole expression is what the
            // two arms agree on. Without this branch the arms came out as
            // "unknown" (null), so the enclosing expression took the LEFT
            // operand's type: `off + (c ? "#s" : "#g")` typed as `int` and
            // the checker rejected the program with "cannot convert 'int'
            // to 'string' in initializer".
            return MergeConditionalTypes(InferType(e.b), InferType(e.c));
        }
        if (k == AK.Index()) {
            Node ot = InferType(e.a);
            if (ot != null) {
                // an array is indexed first: `List<string>[]` yields
                // `List<string>`, not the list's own element type -- the
                // array rank (ival) decides, the element name does not.
                if (ot.ival >= 1) {
                    // the subscripts must match the rank of the group: the
                    // C host's "rank-%d array indexed with %d indices"
                    int rk = Node.ArrRankAt(ot.arrRanks, 0);
                    int given = 1 + e.kids.Count;
                    if (given != rk) {
                        diags.Error("rank-" + rk + " array indexed with "
                            + given + " indices", e.line, e.col);
                    }
                    Node el = MkType(ot.sval); el.kids = ot.kids;
                    el.ival = ot.ival - 1;
                    // the element of a `T?[]` is nullable: the flag rides on
                    // the array type
                    el.op = ot.op;
                    // the inner ranks travel down: the element of `int[,]`
                    // is `int`, the element of `int[][,]` is `int[,]`
                    el.arrRanks = Node.ArrRankDrop(ot.arrRanks);
                    return el;
                }
                if (ot.sval == "List" && ot.kids.Count > 0) { return ot.kids[0]; }
                if (ot.sval == "Span" && ot.kids.Count > 0) { return ot.kids[0]; }
                if (ot.sval == "string") { return MkType("char"); }
            }
            return null;
        }
        if (k == AK.MemberAccess()) {
            Node ot = InferType(e.a);
            if (ot != null && ot.op == 1) {
                if (e.sval == "HasValue") { return MkType("bool"); }
                if (e.sval == "Value") {
                    Node ut = MkType(ot.sval);
                    ut.kids = ot.kids;
                    return ut;
                }
            }
            if (ot != null && ot.sval == "string" && e.sval == "Length") { return MkType("int"); }
            if (ot != null && (ot.sval == "List" || ot.sval == "Dict" || ot.sval == "Dictionary" || ot.sval == "StringBuilder") && (e.sval == "Count" || e.sval == "Length")) { return MkType("int"); }
            if (ot != null && ot.ival > 0 && e.sval == "Length") { return MkType("int"); }
            if (ot != null && ot.sval == "TypeInfo") {
                string mn = e.sval;
                if (mn == "Name" || mn == "Kind" || mn == "TableName" || mn == "FullName") { return MkType("string"); }
                if (mn == "FieldCount" || mn == "MethodCount" || mn == "ConstructorCount" || mn == "TypeArgCount") { return MkType("int"); }
                if (mn == "IsArray" || mn == "IsNullable" || mn == "IsInterface" || mn == "IsGeneric") { return MkType("bool"); }
                if (mn == "ElementType") { return MkType("TypeInfo"); }
            }
            Node cls = ClassOf(ot);
            if (cls != null) {
                Node f = FieldUp(cls, e.sval);
                if (f != null) { return LiftNullCondType(e, f.type); }
                Node g = MethodUp(cls, "get_" + e.sval);
                if (g != null) { return LiftNullCondType(e, g.type); }
            }
            // recv.<Entity> table accessor: the lookup missed, so the member
            // node may degrade in place into the synthesized new expression
            if (ot != null && TryEntityAccessor(e, ot)) { return e.type; }
            return null;
        }
        if (k == AK.Call()) {
            Node callee = e.a;
            if (callee != null && callee.kind == AK.Ident()) {
                if (callee.sval == "sizeof") { return MkType("int"); }
                Node m = MethodUpCall(curClass, callee.sval, e);
                if (m != null) { return m.type; }
                return null;
            }
            if (callee != null && callee.kind == AK.MemberAccess()) {
                if (callee.sval == "GetType") { return MkType("TypeInfo"); }
                string cm = callee.sval;
                if (cm == "HasField" || cm == "HasMethod" || cm == "SetFieldInt" || cm == "SetFieldLong"
                    || cm == "SetFieldBool" || cm == "SetFieldDouble" || cm == "SetFieldString" || cm == "SetFieldObject"
                    || cm == "Invoke") {
                    return MkType("bool");
                }
                if (cm == "GetFieldInt" || cm == "InvokeInt") { return MkType("int"); }
                if (cm == "GetFieldLong" || cm == "InvokeLong") { return MkType("long"); }
                if (cm == "GetFieldDouble" || cm == "InvokeDouble") { return MkType("double"); }
                if (cm == "GetFieldBool") { return MkType("bool"); }
                if (cm == "GetFieldString" || cm == "InvokeString") { return MkType("string"); }
                if (cm == "GetFieldObject" || cm == "InvokeObject") { return MkType("object"); }
                Node ot = InferType(callee.a);
                if (callee.sval == "ToString" && e.kids.Count == 0) { return MkType("string"); }
                if (callee.sval == "Equals" && e.kids.Count == 1) { return MkType("bool"); }
                if (callee.sval == "GetHashCode" && e.kids.Count == 0) { return MkType("int"); }
                if (ot != null && ot.sval == "string") {
                    string sm = callee.sval;
                    if (sm == "Substring" || sm == "Trim" || sm == "ToUpper" || sm == "ToLower"
                        || sm == "Replace" || sm == "ToString") {
                        return MkType("string");
                    }
                    if (sm == "IndexOf" || sm == "LastIndexOf") { return MkType("int"); }
                    if (sm == "Contains" || sm == "StartsWith" || sm == "EndsWith" || sm == "Equals") { return MkType("bool"); }
                }
                if (ot != null && ot.sval == "StringBuilder") {
                    if (callee.sval == "ToString") { return MkType("string"); }
                    if (callee.sval == "Append" || callee.sval == "AppendLine" || callee.sval == "Clear") { return ot; }
                    if (callee.sval == "Length") { return MkType("int"); }
                }
                if (ot != null && ot.sval == "TypeInfo") {
                    string sm = callee.sval;
                    if (sm == "GetFieldName" || sm == "GetFieldType" || sm == "GetFieldCustomName" || sm == "GetFieldDefault"
                        || sm == "GetMethodName" || sm == "GetMethodReturnType" || sm == "GetMethodParamType"
                        || sm == "GetCtorParamType"
                        || sm == "GetCustomAttributes" || sm == "GetAttrs"
                        || sm == "GetFieldCustomAttributes" || sm == "GetFieldAttrs"
                        || sm == "GetMethodCustomAttributes" || sm == "GetMethodAttrs") {
                        return MkType("string");
                    }
                    if (sm == "GetMemberValue") { return MkType("long"); }
                    if (sm == "GetMethodParamCount" || sm == "GetCtorParamCount") { return MkType("int"); }
                    if (sm == "IsFieldIgnored" || sm == "IsFieldRequired" || sm == "IsFieldPk"
                        || sm == "IsFieldIdentity"
                        || sm == "HasField" || sm == "HasMethod" || sm == "IsMethodStatic") {
                        return MkType("bool");
                    }
                    if (sm == "GetFieldTypeInfo" || sm == "GetTypeArg") { return MkType("TypeInfo"); }
                    if (sm == "CreateInstance") { return MkType("object"); }
                }
                if (callee.a != null && callee.a.kind == AK.Ident()) {
                    string cname = callee.a.sval;
                    string mname = callee.sval;
                    if (cname == "String" || cname == "string") {
                        if (mname == "Format" || mname == "Join" || mname == "Concat") { return MkType("string"); }
                        if (mname == "IsNullOrEmpty" || mname == "IsNullOrWhiteSpace") { return MkType("bool"); }
                        if (mname == "Compare" || mname == "CompareOrdinal") { return MkType("int"); }
                    }
                    if (cname == "Convert" && (mname == "ToString" || mname == "ToBase64String")) {
                        return MkType("string");
                    }
                    if (cname == "Convert" && (mname == "ToInt32" || mname == "ToInt64")) {
                        return MkType("int");
                    }
                    if (cname == "File" && (mname == "ReadAllText" || mname == "ReadFile")) {
                        return MkType("string");
                    }
                    if (cname == "File" && mname == "Exists") { return MkType("bool"); }
                    if (cname == "Directory" && mname == "Exists") { return MkType("bool"); }
                    if (cname == "Path") {
                        if (mname == "GetExtension" || mname == "GetFileName" || mname == "GetDirectoryName" || mname == "Combine") {
                            return MkType("string");
                        }
                    }
                }
                if (ot != null && ot.op == 1 && callee.sval == "GetValueOrDefault") {
                    Node ut = MkType(ot.sval);
                    ut.kids = ot.kids;
                    return ut;
                }
                Node cls = ClassOf(ot);
                if (cls != null) {
                    Node m = MethodUpCall(cls, callee.sval, e);
                    if (m != null) {
                        Node ret = SubstTypeParams(m.type, cls, ot);
                        ret = SubstMethodTypeParams(ret, m, e);
                        return LiftNullCondType(e, ret);
                    }
                }
                // `Task.Run(...)` / `Task.Spawn(...)`: the handle's shape
                // follows the argument (the C host's task_run_result_type).
                Node tr = TaskCallType(e);
                if (tr != null) { return tr; }
                return null;
            }
            return null;
        }
        if (k == AK.SwitchExpr()) {
            if (e.kids.Count > 0) { return InferType(e.kids[0].b); }
            return null;
        }
        if (k == AK.WithExpr()) {
            return InferType(e.a);
        }
        return null;
    }

    bool IsStr(Node t) { return t != null && t.sval == "string"; }

    // ---- the type of a conditional expression ----
    //
    // The C host merges the two arms (src/compiler/checker.c:1201,
    // merge_conditional_types) and, when they have nothing in common,
    // reports
    //   cannot apply '?:' operator to operands of type 'X' and 'Y':
    //   neither converts to the other and they share no common type
    // The self-host's type model is coarse, so the merge stays
    // PERMISSIVE: an arm pair it cannot merge yields the UNKNOWN type
    // (null) and no diagnostic. Rejecting code the host accepts would
    // break the self-hosting fixed point, and the self-host cannot name
    // the host's operand types faithfully anyway (the difference is
    // recorded in TASKS.md, A500).
    Node MergeConditionalTypes(Node a, Node b) {
        if (a == null) { return b; }
        if (b == null) { return a; }
        // a type parameter is replaced by the concrete type at the
        // instantiation -- the host keeps the parameter's side
        if (binder.IsTypeParam(a.sval) || binder.IsTypeParam(b.sval)) { return a; }
        // the same shape: the same name, the same type arguments, the same
        // nullable flag, the same array rank
        if (SameTypeShape(a, b)) { return a; }
        // two numeric arms promote to the wider one
        if (IsMergeNumeric(a) && IsMergeNumeric(b)) { return PromoteNumericType(a, b); }
        // two reference arms: the common base type, or nothing
        if (IsMergeRef(a) && IsMergeRef(b)) {
            Node common = CommonBaseType(a, b);
            if (common != null) { return common; }
            return null;
        }
        // an enum arm: the host keeps the enum side
        if (PrimCat(a.sval) == 6 || PrimCat(b.sval) == 6) { return a; }
        return null;
    }

    // The same shape: the name, the type arguments, the nullable flag and
    // the array rank all match. The host compares the type kinds and the
    // names (checker_type_equal); the self-host has no type kinds, so the
    // name stands in for the kind.
    bool SameTypeShape(Node a, Node b) {
        if (a == null || b == null) { return false; }
        if (a.sval != b.sval) { return false; }
        if (a.op != b.op) { return false; }
        if (a.ival != b.ival) { return false; }
        if (a.kids.Count != b.kids.Count) { return false; }
        int i = 0;
        while (i < a.kids.Count) {
            if (!SameTypeShape(a.kids[i], b.kids[i])) { return false; }
            i = i + 1;
        }
        return true;
    }

    // A numeric arm: a primitive number or a char, and NOT nullable (the
    // host promotes the arms' value kinds; a nullable arm is a different
    // type and the host does not promote it).
    bool IsMergeNumeric(Node t) {
        if (t == null) { return false; }
        if (t.op != 0) { return false; }
        if (t.ival >= 1) { return false; }
        return IsNumericTypeName(t.sval);
    }

    // The host's promote_numeric (src/compiler/checker.c:1066): the ladder
    // is double > float > ulong > long > int. Everything else (byte, short,
    // uint, char, nint) falls to int. A decimal arm wins over an integral
    // arm; a decimal mixed with a float or a double is an error in the
    // host, which the self-host cannot express -- it stays unknown.
    Node PromoteNumericType(Node a, Node b) {
        string an = a.sval;
        string bn = b.sval;
        if (an == "decimal" || bn == "decimal") {
            if (an == "decimal" && bn == "decimal") { return MkType("decimal"); }
            string other = an;
            if (an == "decimal") { other = bn; }
            if (other == "float" || other == "double") { return null; }
            return MkType("decimal");
        }
        if (an == "double" || bn == "double") { return MkType("double"); }
        if (an == "float" || bn == "float") { return MkType("float"); }
        if (an == "ulong" || bn == "ulong") { return MkType("ulong"); }
        if (an == "long" || bn == "long") { return MkType("long"); }
        return MkType("int");
    }

    // A reference-typed arm: the host's checker_type_is_ref
    // (src/compiler/checker.c:1190) covers object, interface, string,
    // class, array, delegate and task -- a struct is a VALUE type and is
    // not one of them.
    bool IsMergeRef(Node t) {
        if (t == null) { return false; }
        if (t.ival >= 1) { return true; }        // an array
        string n = t.sval;
        if (n == "string" || n == "object") { return true; }
        if (IsTaskTy(t)) { return true; }
        if (binder.IsDelegateName(n)) { return true; }
        Node d = binder.FindType(n);
        if (d != null && d.kind == AK.ClassDecl()) { return true; }
        return false;
    }

    // The common base of two reference arms: the host walks the base chain
    // (merge_conditional_types: `b is-a a` -> a, `a is-a b` -> b, then the
    // first base of `a` that `b` derives from).
    Node CommonBaseType(Node a, Node b) {
        if (DerivesFromName(b.sval, a.sval)) { return a; }
        if (DerivesFromName(a.sval, b.sval)) { return b; }
        string cur = a.sval;
        int guard = 0;
        while (guard < 64) {
            Node d = binder.FindType(cur);
            if (d == null) { return null; }
            string baseName = d.sval2;
            if (baseName == "" || baseName == cur) { return null; }
            Node bt = binder.FindType(baseName);
            if (bt == null) { return null; }
            if (DerivesFromName(b.sval, baseName)) { return bt; }
            cur = baseName;
            guard = guard + 1;
        }
        return null;
    }

    // Does the type named `sub` derive from the type named `sup`? The host
    // walks the base chain AND the interface list (checker_type_derives_
    // from); the self-host has the base chain only (a class declaration's
    // sval2 holds the base name).
    bool DerivesFromName(string sub, string sup) {
        if (sub == sup) { return true; }
        string cur = sub;
        int guard = 0;
        while (guard < 64) {
            Node d = binder.FindType(cur);
            if (d == null) { return false; }
            string baseName = d.sval2;
            if (baseName == "" || baseName == cur) { return false; }
            if (baseName == sup) { return true; }
            cur = baseName;
            guard = guard + 1;
        }
        return false;
    }

    // The literal's own type follows its suffix: `5` is an int, `5L` a long,
    // `5u` a uint, `5UL` a ulong, `0x1FL` a long (the parser folds the radix
    // into the same field -- 16 for hex, 8 for binary -- so the type suffix
    // is `suffix % 8`), `5.0f` a float, `5.0m` a decimal. The C host types
    // them the same way (checker.c: AST_INT_LITERAL / AST_FLOAT_LITERAL ->
    // lit_suffix), and the diagnostics name the type -- `bool b = 5L;` says
    // "cannot convert 'long' to 'bool'", not "'int'".
    string IntLitTypeName(Node e) {
        return e.IntLitTypeName();
    }
    string FloatLitTypeName(Node e) {
        if (e.suffix == 1) { return "float"; }
        if (e.suffix == 2) { return "decimal"; }
        return "double";
    }

    // The result type of `Task.Run(...)` / `Task.Spawn(...)`, mirroring the C
    // host's task_run_result_type (src/compiler/checker.c):
    //
    //   Task.Spawn(...)         -> Task    (a detached frame carries no result)
    //   Task.Run(lambda/Action) -> Task    (an action frame carries no result)
    //   Task.Run(<void call>)   -> Task
    //   Task.Run(<call>)        -> Task<T> (T = the call's result type)
    //
    // The distinction is not cosmetic: the action frame is released by the
    // completion path, so reading it as a result handle releases it twice.
    Node TaskCallType(Node call) {
        Node callee = call.a;
        if (callee == null || callee.kind != AK.MemberAccess()) { return null; }
        if (callee.a == null || callee.a.kind != AK.Ident()) { return null; }
        if (callee.a.sval != "Task") { return null; }
        string mname = callee.sval;
        if (mname != "Run" && mname != "Spawn") { return null; }
        if (call.kids.Count != 1) { return null; }
        Node arg = call.kids[0];
        if (arg == null) { return null; }
        if (mname == "Spawn") { return MkTaskType(null); }
        if (arg.kind == AK.Lambda()) { return MkTaskType(null); }
        Node at = InferType(arg);
        if (at == null) { return null; }        // unknown argument: stay permissive
        if (binder.IsDelegateName(at.sval)) { return MkTaskType(null); }
        if (at.sval == "void") { return MkTaskType(null); }
        if (IsTaskTy(at)) {
            if (at.kids.Count == 1) { return MkTaskType(at.kids[0]); }
            return MkTaskType(null);
        }
        return MkTaskType(at);
    }

    // The C host rejects a handle that carries no result where a Task<T> is
    // expected (src/compiler/checker.c: checker_check_assignable): the action
    // frame would be released twice -- once by the completion path, once by
    // the reader -- and the double free aborts the process. The self-hosted
    // checker applies the same rule wherever a value flows into a typed slot.
    void CheckTaskNoResult(Node target, Node value, string what, int line, int col) {
        if (!IsTaskTy(target) || !IsTaskTy(value)) { return; }
        if (target.kids.Count != 1 || value.kids.Count != 0) { return; }
        diags.Error("cannot convert '" + TaskTyName(value) + "' to '" + TaskTyName(target)
            + "' in " + what + ": a task started from a lambda/Action carries no result; "
            + "declare 'Task' (not 'Task<T>') and await it or join with Task.WhenAll/JoinWait", line, col);
    }

    // A Task-shaped slot only accepts a task handle. The C host rejects a
    // raw value with "cannot convert 'double' to 'Task<double>' in initializer:
    // no implicit conversion" -- the target keeps its type argument: the host
    // names the slot the user actually wrote (A463 made the host render the
    // type's shape, so the bare 'Task' is gone). A null is fine: a null
    // handle is still a handle.
    void CheckTaskOnlyHandle(Node target, Node value, string what, int line, int col) {
        if (!IsTaskTy(target)) { return; }
        if (value == null) { return; }
        if (IsTaskTy(value)) { return; }   // a handle; the no-result case has its own message
        diags.Error("cannot convert '" + TyDisplay(value) + "' to '" + TyDisplay(target)
            + "' in " + what + ": no implicit conversion", line, col);
    }

    // ---- the general assignability check ----
    // The C host (src/compiler/checker.c, checker_check_assignable) rejects a
    // value that cannot land in the target slot with
    //   cannot convert 'X' to 'Y' in <what>: no implicit conversion
    // The self-host's type model is coarse, so the rule stays narrow: it
    // fires only when the target is a known primitive and the value is a
    // known primitive, an enum or a class instance. A type parameter, a
    // generic instantiation, an unknown name or a user-defined target is
    // never judged -- the host resolves those through the class hierarchy or
    // the instantiation, which the self-host does not model.
    //
    // Categories: 0 other/unknown, 1 integral, 2 floating, 3 bool,
    // 4 string, 5 char, 6 enum, 7 class instance, 8 decimal.
    // `decimal` is a category of its own: the host does not mix it with the
    // floating types in either direction ("cannot convert 'decimal' to
    // 'int'", "cannot convert 'double' to 'decimal'"), and a `decimal` slot
    // takes an integral value. Since A487 the parser preserves the `decimal`
    // TYPE name (the payload still lowers as a double), so the category is
    // reachable from both the value side (`5.0m`) and the target side.
    int PrimCat(string n) {
        if (n == "") { return 0; }
        if (n == "int" || n == "long" || n == "byte" || n == "short" ||
            n == "uint" || n == "ulong" || n == "ushort" || n == "sbyte" ||
            n == "nint") { return 1; }
        if (n == "float" || n == "double") { return 2; }
        if (n == "bool") { return 3; }
        if (n == "string") { return 4; }
        if (n == "char") { return 5; }
        if (n == "decimal") { return 8; }
        Node d = binder.FindType(n);
        if (d != null) {
            if (d.kind == AK.EnumDecl()) { return 6; }
            if (d.kind == AK.ClassDecl() || d.kind == AK.StructDecl() ||
                d.kind == AK.DelegateDecl()) { return 7; }
        }
        return 0;
    }

    // A user-defined implicit conversion: the value's class declares
    // `implicit operator T` (the parser lowers it to a method `op_implicit`
    // whose result type is T and whose parameter is the source type). The
    // C host applies such a conversion in an assignment, an argument, a
    // return and a cast -- so `double d = feet;` is legal.
    bool HasImplicitConv(Node valueTy, string target) {
        if (valueTy == null || target == "") { return false; }
        Node c = binder.FindType(valueTy.sval);
        int cg = 0;
        while (c != null) {
            int i = 0;
            while (i < c.kids.Count) {
                Node m = c.kids[i];
                if (m.kind == AK.MethodDecl() && m.sval == "op_implicit"
                    && m.type != null && m.type.sval == target) {
                    Node p = ParamAtNode(m, 0);
                    if (p == null || p.type == null || p.type.sval == valueTy.sval) {
                        return true;
                    }
                }
                i = i + 1;
            }
            c = binder.FindType(c.sval2);
            cg = cg + 1;
            if (cg > 512) { c = null; }
        }
        return false;
    }
    // ---- narrowing conversions ----
    //
    // The C host judges narrowing BEFORE the general assignability check
    // (src/compiler/checker.c, `checker_check_assignable`) and words it
    // differently:
    //   narrowing conversion from 'double' to 'int' in initializer needs an
    //   explicit cast (C# rules)
    // Two shapes reach it:
    //   * a float/double value in an integral slot -- a char or an enum slot
    //     counts as integral (`Color c = 5.0;` narrows);
    //   * an integral CONSTANT that does not fit the target's range
    //     (`byte b = 300;` is refused, `byte b = 200;` is not).
    // A nullable slot never narrows in the host (`int? x = 5.0;` is quiet)
    // and a value that is not a constant never narrows either
    // (`byte b = someLong;` is quiet).

    // An integral literal, optionally under a unary minus.
    bool IsConstIntExpr(Node e) {
        if (e == null) { return false; }
        if (e.kind == AK.IntLit()) { return true; }
        if (e.kind == AK.Unary() && e.op == TK.Minus() && e.a != null) {
            return e.a.kind == AK.IntLit();
        }
        return false;
    }

    long ConstIntExpr(Node e) {
        if (e.kind == AK.IntLit()) { return e.ival; }
        return 0 - e.a.ival;
    }

    // The signed 64-bit minimum as a bit pattern (0x8000000000000000 read as
    // a signed integer). The literal cannot be written out (it does not fit a
    // signed literal), so it is computed.
    long Int64MinBits() { return 0 - 9223372036854775807L - 1L; }

    // The integral range of a type name, the host's `integral_range`
    // (src/compiler/checker.c). A type that is not integral (or an unknown
    // name) is reported as "no range" -- the host then treats the conversion
    // as safe.
    bool IsIntegralType(string tn) {
        if (tn == "sbyte" || tn == "byte" || tn == "short" || tn == "ushort" ||
            tn == "char" || tn == "int" || tn == "uint" || tn == "long" ||
            tn == "nint" || tn == "ulong") { return true; }
        // an enum is an int in the host's range table
        Node d = binder.FindType(tn);
        if (d != null && d.kind == AK.EnumDecl()) { return true; }
        return false;
    }
    long IntegralMin(string tn) {
        if (tn == "sbyte") { return -128; }
        if (tn == "byte") { return 0; }
        if (tn == "short") { return -32768; }
        if (tn == "ushort") { return 0; }
        if (tn == "char") { return 0; }
        if (tn == "int") { return -2147483648L; }
        if (tn == "uint") { return 0; }
        if (tn == "long" || tn == "nint") { return Int64MinBits(); }
        if (tn == "ulong") { return 0; }
        return -2147483648L;    // an enum
    }
    long IntegralMax(string tn) {
        if (tn == "sbyte") { return 127; }
        if (tn == "byte") { return 255; }
        if (tn == "short") { return 32767; }
        if (tn == "ushort") { return 65535; }
        if (tn == "char") { return 65535; }
        if (tn == "int") { return 2147483647L; }
        if (tn == "uint") { return 4294967295L; }
        if (tn == "long" || tn == "nint") { return 9223372036854775807L; }
        if (tn == "ulong") { return 9223372036854775807L; }
        return 2147483647L;    // an enum
    }
    bool IntegralUnsigned(string tn) {
        if (tn == "byte" || tn == "ushort" || tn == "char" || tn == "uint" ||
            tn == "ulong") { return true; }
        return false;
    }

    // The host's `integral_conversion_is_safe`: the value type's own range
    // must fit the target's range, or -- for a constant -- the constant
    // itself must. `expr` is the value expression (the host needs it to
    // tell an int literal from a folded expression).
    bool IntegralConvSafe(string tn, string vn, Node expr, long constant) {
        if (!IsIntegralType(tn) || !IsIntegralType(vn)) { return true; }
        long tmin = IntegralMin(tn); long tmax = IntegralMax(tn);
        bool tu = IntegralUnsigned(tn);
        long vmin = IntegralMin(vn); long vmax = IntegralMax(vn);
        bool vu = IntegralUnsigned(vn);
        if ((!vu || tu) && vmin >= tmin && vmax <= tmax) { return true; }
        // an unsigned value in a signed slot: only a non-negative constant
        // that fits the target is safe
        if (vu && !tu) {
            // the host's one exception: -(0x8000000000000000) is the signed
            // 64-bit minimum and lands in a signed slot
            if (expr != null && expr.kind == AK.Unary() && expr.op == TK.Minus() &&
                expr.a != null && expr.a.kind == AK.IntLit() &&
                expr.a.ival == Int64MinBits()) {
                return constant >= tmin;
            }
            if (constant < 0) { return false; }
            if (expr != null && expr.kind == AK.IntLit()) { return expr.ival <= tmax; }
            return constant <= tmax;
        }
        if (constant < tmin) { return false; }
        if (tu) {
            if (constant < 0) { return false; }
            return constant <= tmax;
        }
        return constant <= tmax;
    }

    void CheckNarrowing(Node target, Node valueExpr, Node valueTy,
                        string what, int line, int col) {
        if (target == null || valueExpr == null) { return; }
        if (target.ival >= 1) { return; }        // array target
        if (target.op == 1) { return; }           // nullable slot: the host does not narrow there
        string tn = target.sval;
        if (tn == "" || tn == "var") { return; }
        if (binder.IsTypeParam(tn)) { return; }
        int tcat = PrimCat(tn);
        if (tcat != 1 && tcat != 5 && tcat != 6) { return; }  // integral / char / enum
        if (valueTy == null) { return; }
        string vn = valueTy.sval;
        int vcat = PrimCat(vn);
        if (vcat == 2) {
            // a float value in an integral slot
            diags.Error("[E2022] narrowing conversion from '" + vn + "' to '" + tn
                + "' in " + what + " needs an explicit cast (C# rules)", line, col);
            return;
        }
        // an integral value in an integral slot
        if (vcat != 1 && vcat != 5 && vcat != 6) { return; }
        // a native handle only lands in a long or a nint slot
        if (vn == "nint" && tn != "long" && tn != "nint") {
            diags.Error("[E2022] narrowing conversion from '" + vn + "' to '" + tn
                + "' in " + what + " needs an explicit cast (C# rules)", line, col);
            return;
        }
        // a ulong slot takes any int literal
        if (tn == "ulong" && valueExpr.kind == AK.IntLit()) { return; }
        if (!IsConstIntExpr(valueExpr)) { return; }
        if (IntegralConvSafe(tn, vn, valueExpr, ConstIntExpr(valueExpr))) { return; }
        // an integral constant that does not fit the target's range
        diags.Error("[E2022] narrowing conversion from '" + vn + "' to '" + tn
            + "' in " + what + " needs an explicit cast (C# rules)", line, col);
    }

    // `valueNull` marks a null literal: the C host types it as `object`, so
    // that is the name its diagnostics print.
    void CheckAssignable(Node target, Node valueTy, bool valueNull,
                         string what, int line, int col) {
        if (target == null || target.ival >= 1) { return; }  // array target
        string tn = target.sval;
        if (tn == "" || tn == "var") { return; }
        if (binder.IsTypeParam(tn)) { return; }
        int tcat = PrimCat(tn);
        bool tnull = (target.op == 1);
        // The names the host prints: a nullable keeps its '?' (A463).
        string tdisp = tnull ? tn + "?" : tn;
        if (valueNull) {
            // null lands in a nullable slot or in a reference type (`string s = null;`
            // is legal in the host) -- nowhere else
            if (tcat == 4 || tnull || tcat == 0 || tcat == 7) { return; }
            diags.Error("cannot convert 'object' to '" + tdisp + "' in " + what
                + ": no implicit conversion", line, col);
            return;
        }
        if (valueTy == null || valueTy.ival >= 1) { return; }   // unknown / array
        string vn = valueTy.sval;
        if (vn == "" || vn == "var") { return; }
        if (binder.IsTypeParam(vn)) { return; }
        int vcat = PrimCat(vn);
        // a user-defined implicit conversion makes the assignment legal:
        // `double d = feet;` where Feet declares `implicit operator double`
        bool vnull = (valueTy.op == 1);
        string vdisp = vnull ? vn + "?" : vn;
        if (vnull && !tnull) {
            // a nullable value only lands in a nullable slot
            diags.Error("cannot convert '" + vdisp + "' to '" + tdisp + "' in " + what
                + ": no implicit conversion", line, col);
            return;
        }
        // only a primitive target or an enum target (tcat == 6, A486) is judged:
        // a user target (a class, a struct) is resolved by the host through the
        // class hierarchy, which the self-host does not model
        if (tcat == 0 || tcat == 7 || vcat == 0 || vcat == 7) { return; }
        if (!vnull && HasImplicitConv(valueTy, tn)) { return; }
        bool ok = false;
        if (tnull) {
            if (vnull) {
                // a nullable slot takes a nullable value of the same element
                // type (`int? <- int?` yes, `int? <- double?` no)
                ok = (vcat == tcat);
            } else if (tcat == 1 || tcat == 2) {
                // a nullable numeric slot takes a numeric value; A487: a
                // `decimal` value only lands in a `decimal?` slot (the host
                // does not mix decimal with the floating types)
                ok = (vcat == 1 || vcat == 2 || vcat == 5 || vcat == 6);
            } else if (tcat == 3) { ok = (vcat == 3); }
            else if (tcat == 4) { ok = (vcat == 4); }
            else if (tcat == 5) { ok = (vcat == 5 || vcat == 1 || vcat == 6); }
            else if (tcat == 6) { ok = (vcat == 1 || vcat == 5 || vcat == 6); }
            else if (tcat == 8) { ok = (vcat == 1 || vcat == 5 || vcat == 8); }
        } else {
            if ((tcat == 1 || tcat == 5 || tcat == 6) && vcat == 2) {
                // a float value in an integral/enum slot is the host's *narrowing*
                // rule (`narrowing conversion from 'double' to 'int' ...`),
                // which `CheckNarrowing` reports -- here the pair is simply
                // not convertible
                ok = true;
            }
            else if (tcat == 1) { ok = (vcat == 1 || vcat == 5 || vcat == 6 || vcat == 2); }
            else if (tcat == 2) {
                // A487: a float slot takes a float, a double, an integral or a
                // char value -- NOT a decimal. The host keeps decimal apart
                // from the floating types in both directions (`double d =
                // 5.0m;` is refused), and the parser now preserves the
                // `decimal` type name so the pair is visible here.
                ok = (vcat == 1 || vcat == 2 || vcat == 5 || vcat == 6);
            }
            else if (tcat == 3) { ok = (vcat == 3); }
            else if (tcat == 4) { ok = (vcat == 4); }
            else if (tcat == 5) { ok = (vcat == 5 || vcat == 1 || vcat == 6 || vcat == 2); }
            else if (tcat == 6) { ok = (vcat == 1 || vcat == 5 || vcat == 6); }
            else if (tcat == 8) {
                // a decimal slot takes an integral or a char value, or another
                // decimal (`decimal d = 5.0;` is refused -- the host does not
                // convert a double to a decimal implicitly)
                ok = (vcat == 1 || vcat == 5 || vcat == 8);
            }
        }
        if (ok) { return; }
        diags.Error("cannot convert '" + vdisp + "' to '" + tdisp + "' in " + what
            + ": no implicit conversion", line, col);
    }

    // ---- unary operators: the operand has to be arithmetic ----
    // The C host (src/compiler/checker.c AST_UNARY) rejects every operand
    // that is neither numeric nor a class/struct with "cannot apply unary
    // '-' to 'string'". The self-host lowers a unary minus as
    // `sub i64 0, <v>` -- on a string pointer that is invalid IR, and on
    // `~` it takes the compiler down with it (0xC0000005).
    // The two name sets mirror the host's type_is_numeric / type_is_integral
    // (char counts as arithmetic here, exactly as in the host's binary
    // promotion). Only *primitive* operands are judged: a user type, a type
    // parameter or an unknown name may still be arithmetic after
    // substitution, and reporting on it would be a guess.
    bool IsNumericTypeName(string n) {
        return n == "int" || n == "long" || n == "byte" || n == "short" ||
               n == "sbyte" || n == "ushort" || n == "uint" || n == "ulong" ||
               n == "float" || n == "double" || n == "decimal" || n == "nint" ||
               n == "char";
    }
    bool IsIntegralTypeName(string n) {
        return n == "int" || n == "long" || n == "byte" || n == "short" ||
               n == "sbyte" || n == "ushort" || n == "uint" || n == "ulong" ||
               n == "nint";
    }
    void CheckUnaryOperand(Node n) {
        Node t = InferType(n.a);
        if (t == null) { return; }
        string ty = t.sval;
        if (ty == "" || ty == "var") { return; }
        int line = n.line;
        int col = n.col;
        if (line == 0 && n.a != null) { line = n.a.line; col = n.a.col; }
        // `!` takes a bool -- the same rule the C host's binary `&&` / `||`
        // apply ("both operands must be bool"). The host used to accept any
        // operand here, so `!someString` silently became "compare the
        // pointer with 0".
        //
        // Unlike `-` / `+` / `~` this check is NOT limited to primitive
        // names: `!` has no operator-overload path (the host has no
        // `operator !`), so a class instance is just as wrong as a string
        // and must be reported. `bool?` is wrong too -- the host's binary
        // `&&` / `||` reject a nullable bool as well, so a nullable bool
        // in a boolean context is an error on both sides. The nullable
        // flag rides on the type node's op (1 = `T?`).
        if (n.op == TK.Bang()) {
            if (ty == "bool" && t.op != 1) { return; }
            if (binder.IsTypeParam(ty)) { return; }   // resolved at instantiation
            diags.Error("[E2049] cannot apply unary '!' to '" + ty
                + "': the operand must be a bool", line, col);
            return;
        }
        if (!binder.IsPrimitive(ty)) { return; }   // user type / type param / unknown
        string sign = "";
        bool integral = false;
        if (n.op == TK.Minus()) { sign = "-"; }
        else if (n.op == TK.Plus()) { sign = "+"; }
        else if (n.op == TK.Tilde()) { sign = "~"; integral = true; }
        else { return; }
        if (integral) { if (IsIntegralTypeName(ty)) { return; } }
        else { if (IsNumericTypeName(ty)) { return; } }
            diags.Error("[E2019] cannot apply unary '" + sign + "' to '" + ty + "'", line, col);
    }

    // The number of type arguments a built-in generic takes, mirroring the
    // C host's binder (src/compiler/binder.c): List, Span, ReadOnlySpan and
    // Task take one, Dict and Dictionary take two. -1 = not a built-in
    // generic (the host accepts any argument count for those silently).
    int BuiltinGenericArity(string name) {
        if (name == "List") { return 1; }
        if (name == "Span") { return 1; }
        if (name == "ReadOnlySpan") { return 1; }
        if (name == "Task") { return 1; }
        if (name == "Dict") { return 2; }
        if (name == "Dictionary") { return 2; }
        return -1;
    }

    // The number of type parameters a declared class/struct/enum declares
    // (its own type parameters, not its methods').
    int DeclTypeParamCount(Node decl) {
        if (decl == null) { return 0; }
        int n = 0;
        int i = 0;
        while (i < decl.kids.Count) {
            if (decl.kids[i].kind == AK.TypeParam()) { n = n + 1; }
            i = i + 1;
        }
        return n;
    }

    // Resolve one type reference the way the C host's binder does
    // (src/compiler/binder.c: binder_resolve_type): find the base type,
    // check the type-argument count, then resolve each argument. The
    // diagnostics are collected instead of emitted so the caller can decide
    // how often each one is reported -- the host resolves a method
    // signature's types twice (the binder, then the checker in the method's
    // own scope) and so reports a bad signature type twice.
    List<Diag> TypeDiags(Node t) {
        List<Diag> res = new List<Diag>();
        if (t == null) { return res; }
        string name = t.sval;
        bool ok = binder.IsPrimitive(name);
        if (!ok) { ok = binder.IsBuiltinGeneric(name); }
        if (!ok) { ok = binder.IsBuiltinClass(name); }
        if (!ok) { ok = binder.IsTypeParam(name); }
        if (!ok) { ok = binder.IsDelegateName(name); }
        if (!ok) { ok = binder.FindType(name) != null; }
        if (!ok) {
            // the host stops here: an unresolved base type is not resolved
            // any further, so its type arguments are never looked at
            res.Add(new Diag("undefined type '" + name + "'", t.line, t.col, false));
            return res;
        }
        // 符号声明优先于内建回退表：只要符号表存在定义，严格以其实际声明的泛型形参数量为准
        int expected = -1;
        bool plain = false;
        Node decl = binder.FindType(name);
        if (decl != null) {
            if (decl.kind == AK.EnumDecl()) { plain = true; expected = 0; }
            else { expected = DeclTypeParamCount(decl); }
        } else if (binder.IsBuiltinClass(name)) {
            plain = true;
            expected = 0;
        } else {
            Node ddel = binder.FindDelegate(name);
            // Func and Action are built-in delegate types in the C host
            // (src/compiler/binder.c resolves them before the scope
            // lookup, so the stdlib's own declaration is shadowed): the
            // host accepts any argument count for them.
            if (ddel != null && name != "Func" && name != "Action") {
                expected = DeclTypeParamCount(ddel);
                if (expected == 0) { plain = true; }
            }
        }
        if (expected < 0) {
            expected = BuiltinGenericArity(name);
        }
        if (t.kids.Count > 0) {
            if (plain) {
                res.Add(new Diag("the non-generic type '" + name
                    + "' cannot be used with type arguments", t.line, t.col, false));
                return res;
            }
            if (expected >= 0 && t.kids.Count != expected) {
                res.Add(new Diag("using the generic type '" + name + "' requires "
                    + expected + " type arguments (got " + t.kids.Count + ")",
                    t.line, t.col, false));
                return res;
            }
        }
        int i = 0;
        while (i < t.kids.Count) {
            List<Diag> sub = TypeDiags(t.kids[i]);
            int j = 0;
            while (j < sub.Count) { res.Add(sub[j]); j = j + 1; }
            i = i + 1;
        }
        return res;
    }

    // Report a type reference's diagnostics once.
    void CheckType(Node t) {
        List<Diag> ds = TypeDiags(t);
        int i = 0;
        while (i < ds.Count) { diags.Add(ds[i]); i = i + 1; }
    }

    // Report a method signature's type diagnostics twice: the C host
    // resolves a method's return and parameter types in the binder and then
    // again in the checker (each in its own scope), so a bad signature type
    // is reported by both passes. The self-hosted checker mirrors that.
    void CheckSignatureType(Node t) {
        List<Diag> ds = TypeDiags(t);
        int i = 0;
        while (i < ds.Count) { diags.Add(ds[i]); i = i + 1; }
        i = 0;
        while (i < ds.Count) { diags.Add(ds[i]); i = i + 1; }
    }

}
