using System;
using System.Collections.Generic;
namespace Zan;

// Binder: collects top-level type declarations into a symbol table and
// resolves type/field/method names. Mirrors src/compiler/binder.c for the
// bootstrap subset. Uses linear lookup over declaration lists (no dependency
// on Dictionary, which gen0 does not fully support).
// A probe result is ephemeral. Only the target signature belongs on the AST.
public class MethodGroupBinding {
    public Node method;
    public Node ownerType;
    public int score;
    public MethodGroupBinding() { method = null; ownerType = null; score = -1; }
}

public class Binder {
    public List<string> TypeParams(Node owner) {
        List<string> r = new List<string>();
        if (owner == null) { return r; }
        int i = 0;
        while (i < owner.kids.Count) {
            if (owner.kids[i].kind == AK.TypeParam()) { r.Add(owner.kids[i].sval); }
            i = i + 1;
        }
        return r;
    }

    public Node CopyType(Node t) {
        if (t == null) { return null; }
        Node r = new Node(t.kind);
        r.sval = t.sval; r.sval2 = t.sval2; r.op = t.op; r.ival = t.ival;
        r.arrRanks = t.arrRanks; r.elemNullable = t.elemNullable; r.mods = t.mods; r.line = t.line; r.col = t.col;
        int i = 0;
        while (i < t.kids.Count) { r.Add(CopyType(t.kids[i])); i = i + 1; }
        return r;
    }

    public Node SubstType(Node t, List<string> names, List<Node> reps) {
        if (t == null) { return null; }
        int i = 0;
        while (i < names.Count && i < reps.Count) {
            if (t.sval == names[i] && t.kids.Count == 0) {
                Node r = CopyType(reps[i]);
                if (r == null) { return null; }
                if (t.ival > 0) {
                    string outerRanks = t.arrRanks;
                    if (outerRanks == "") { outerRanks = "1"; }
                    if (r.ival > 0) {
                        string innerRanks = r.arrRanks;
                        if (innerRanks == "") { innerRanks = "1"; }
                        r.arrRanks = outerRanks + "," + innerRanks;
                    } else { r.arrRanks = outerRanks; }
                    r.ival = r.ival + t.ival;
                    if (t.elemNullable || (r.ival == t.ival && r.op == 1)) { r.elemNullable = true; }
                }
                if (t.op == 1) { r.op = 1; }
                return r;
            }
            i = i + 1;
        }
        Node n = CopyType(t);
        n.kids = new List<Node>();
        i = 0;
        while (i < t.kids.Count) { n.Add(SubstType(t.kids[i], names, reps)); i = i + 1; }
        return n;
    }

    public Node SubstOwner(Node t, Node owner) {
        if (owner == null) { return t; }
        List<string> names = TypeParams(FindType(owner.sval));
        if (names.Count == 0 || names.Count != owner.kids.Count) { return t; }
        return SubstType(t, names, owner.kids);
    }

    public Node BaseType(Node owner) {
        if (owner == null) { return null; }
        Node cls = FindType(owner.sval);
        if (cls == null || cls.sval2 == "") { return null; }
        if (cls.type != null) { return SubstOwner(cls.type, owner); }
        Node r = new Node(AK.TypeRef()); r.sval = cls.sval2; return r;
    }

    public Node MemberType(Node receiver, string name) {
        Node owner = receiver;
        int depth = 0;
        while (owner != null && depth < 64) {
            Node cls = FindType(owner.sval);
            if (cls == null) { return null; }
            Node f = FindField(cls, name);
            if (f != null) { return SubstOwner(f.type, owner); }
            Node g = FindMethod(cls, "get_" + name);
            if (g != null) { return SubstOwner(g.type, owner); }
            owner = BaseType(owner); depth = depth + 1;
        }
        return null;
    }

    public List<Node> DelegateParams(Node ty) {
        List<Node> r = new List<Node>();
        if (ty == null) { return r; }
        // Func/Action are builtin delegate families the C host resolves
        // before any scope lookup, so the stdlib's Action<T> declaration is
        // shadowed at every arity (see the arity note in checker_type.zan).
        // Letting that declaration answer for a bare `Action` would lend its
        // unsubstituted T to the parameter list; params come from the
        // use-site type args alone.
        Node d = (ty.sval != "Func" && ty.sval != "Action") ? FindDelegate(ty.sval) : null;
        if (d != null) {
            int i = 0;
            while (i < d.kids.Count) {
                Node p = d.kids[i];
                if (p.kind == AK.Param()) { r.Add(SubstType(p.type, TypeParams(d), ty.kids)); }
                i = i + 1;
            }
            return r;
        }
        int count = ty.kids.Count;
        if (ty.sval == "Func" && count > 0) { count = count - 1; }
        int i = 0;
        while (i < count) { r.Add(ty.kids[i]); i = i + 1; }
        return r;
    }

    public Node DelegateRet(Node ty) {
        // Same builtin shadowing as DelegateParams: Func/Action signatures
        // are synthesized from the use-site type args, never from the
        // stdlib's own generic declaration.
        Node d = ty != null && ty.sval != "Func" && ty.sval != "Action"
            ? FindDelegate(ty.sval) : null;
        if (d != null && d.type != null) { return SubstType(d.type, TypeParams(d), ty.kids); }
        if (ty != null && ty.sval == "Func" && ty.kids.Count > 0) { return ty.kids[ty.kids.Count - 1]; }
        Node r = new Node(AK.TypeRef()); r.sval = "void"; return r;
    }

    public bool SameType(Node a, Node b) { return SameTypeAt(a, b, 0); }

    bool SameTypeAt(Node a, Node b, int depth) {
        if (a == null || b == null || depth > 64) { return false; }
        if (a == b) { return true; }
        if (a.sval != b.sval && a.ival == 0 && b.ival == 0 && IsDelegateName(a.sval) && IsDelegateName(b.sval)) {
            if (DelegateIsAsync(a.sval) != DelegateIsAsync(b.sval)) { return false; }
            List<Node> ap = DelegateParams(a); List<Node> bp = DelegateParams(b);
            if (ap.Count != bp.Count || !SameTypeAt(DelegateRet(a), DelegateRet(b), depth + 1)) { return false; }
            int j = 0;
            while (j < ap.Count) { if (!SameTypeAt(ap[j], bp[j], depth + 1)) { return false; } j = j + 1; }
            return true;
        }
        if (a.sval != b.sval || a.op != b.op || a.ival != b.ival
            || a.arrRanks != b.arrRanks || a.kids.Count != b.kids.Count) { return false; }
        int i = 0;
        while (i < a.kids.Count) {
            if (!SameTypeAt(a.kids[i], b.kids[i], depth + 1)) { return false; }
            i = i + 1;
        }
        return true;
    }

    bool MethodGroupRefType(Node t) {
        if (t == null || t.op == 1) { return false; }
        if (t.ival > 0 || t.sval == "object" || t.sval == "string" || t.sval == "Task" || IsDelegateName(t.sval)) { return true; }
        Node cls = FindType(t.sval);
        return cls != null && cls.kind == AK.ClassDecl();
    }

    // Reference variance only: no numeric adaptation or boxing in the thunk.
    bool MethodGroupConversion(Node to, Node from) {
        if (to == null || from == null) { return false; }
        if (SameType(to, from)) { return true; }
        if (!MethodGroupRefType(to) || !MethodGroupRefType(from)) { return false; }
        if (to.sval == "object" && to.ival == 0) { return true; }
        if (to.ival > 0 || from.ival > 0) { return false; }
        Node cur = from;
        int depth = 0;
        while (cur != null && depth < 64) {
            if (SameType(to, cur)) { return true; }
            Node cls = FindType(cur.sval);
            if (cls == null) { return false; }
            int i = 0;
            while (i < cls.interfaces.Count) {
                if (to.kids.Count == 0 && cls.interfaces[i] == to.sval) { return true; }
                i = i + 1;
            }
            cur = BaseType(cur); depth = depth + 1;
        }
        return false;
    }

    int MethodGroupScore(Node m, Node owner, Node target) {
        if (TypeParams(m).Count != 0 || ((m.mods & MOD.Async()) != 0) != DelegateIsAsync(target.sval)) { return -1; }
        List<Node> dp = DelegateParams(target);
        int pidx = 0; int score = 4; int i = 0;
        while (i < m.kids.Count) {
            Node p = m.kids[i];
            if (p.kind == AK.Param()) {
                if (p.ival == 1 || pidx >= dp.Count) { return -1; }
                Node pt = SubstOwner(p.type, owner);
                if (!MethodGroupConversion(pt, dp[pidx])) { return -1; }
                score = score + (SameType(pt, dp[pidx]) ? 4 : 1);
                pidx = pidx + 1;
            }
            i = i + 1;
        }
        if (pidx != dp.Count) { return -1; }
        Node rt = SubstOwner(m.type, owner);
        Node dr = DelegateRet(target);
        if (dr.sval == "void") { return rt == null || rt.sval == "void" ? score : -1; }
        return MethodGroupConversion(dr, rt) ? score : -1;
    }

    public bool HasMethodGroup(Node receiver, string name) {
        Node owner = receiver; bool found = false; int depth = 0;
        while (owner != null && depth < 64) {
            Node cls = FindType(owner.sval);
            if (cls == null) { break; }
            if (FindField(cls, name) != null || FindMethod(cls, "get_" + name) != null) { return false; }
            if (FindMethod(cls, name) != null) { found = true; }
            owner = BaseType(owner); depth = depth + 1;
        }
        return found;
    }

    // form: 0 implicit with this, 1 type/static, 2 value/instance.
    public MethodGroupBinding ResolveMethodGroup(Node receiver, string name, int form, Node target) {
        MethodGroupBinding r = new MethodGroupBinding();
        if (receiver == null || target == null || !IsDelegateName(target.sval)) { return r; }
        Node dd = FindDelegate(target.sval);
        int i = 0;
        if (dd != null) {
            while (i < dd.kids.Count) {
                if (dd.kids[i].kind == AK.Param() && dd.kids[i].ival == 1) { return r; }
                i = i + 1;
            }
        }
        Node owner = receiver; int depth = 0; int bestDepth = -1; bool ambiguous = false;
        while (owner != null && depth < 64) {
            Node cls = FindType(owner.sval);
            if (cls == null) { break; }
            if (FindField(cls, name) != null || FindMethod(cls, "get_" + name) != null) { return new MethodGroupBinding(); }
            i = 0;
            while (i < cls.kids.Count) {
                Node m = cls.kids[i];
                if (m.kind == AK.MethodDecl() && m.sval == name) {
                    bool stat = (m.mods & MOD.Static()) != 0;
                    if ((form != 1 || stat) && (form != 2 || !stat)) {
                        int score = MethodGroupScore(m, owner, target);
                        if (score >= 0 && score > r.score) {
                            r.method = m; r.ownerType = owner; r.score = score; bestDepth = depth; ambiguous = false;
                        } else if (score >= 0 && score == r.score && depth == bestDepth && m != r.method) { ambiguous = true; }
                    }
                }
                i = i + 1;
            }
            owner = BaseType(owner); depth = depth + 1;
        }
        return ambiguous ? new MethodGroupBinding() : r;
    }

    public List<Node> types;   // class/struct/enum decls across all units
    public Dictionary<string, Node> typeMap; // O(1) hash index for FindType
    public List<string> tparams; // generic type-parameter names across all units
    public List<string> delegates; // named delegate types (lowered as closures)
    public List<Node> delegDecls;  // their declaration nodes (params + return type)

    public Binder() {
        types = new List<Node>();
        typeMap = new Dictionary<string, Node>();
        tparams = new List<string>();
        delegates = new List<string>();
        delegDecls = new List<Node>();
    }

    // Register every type declaration in a compilation unit.
    public void Bind(Node unit) {
        if (typeMap == null) { typeMap = new Dictionary<string, Node>(); }
        int i = 0;
        while (i < unit.kids.Count) {
            Node d = unit.kids[i];
            if (d.kind == AK.ClassDecl() || d.kind == AK.StructDecl() || d.kind == AK.EnumDecl()) {
                types.Add(d);
                if (d.sval != null && !typeMap.ContainsKey(d.sval)) {
                    typeMap[d.sval] = d;
                }
                int j = 0;
                while (j < d.kids.Count) {
                    Node dm = d.kids[j];
                    if (dm.declaringType == null) { dm.declaringType = d.sval; }
                    if (dm.kind == AK.TypeParam()) { tparams.Add(dm.sval); }
                    else if (dm.kind == AK.DelegateDecl()) {
                        delegates.Add(dm.sval);
                        delegDecls.Add(dm);
                        if (d.sval != null && d.sval != "") {
                            delegates.Add(d.sval + "." + dm.sval);
                            delegDecls.Add(dm);
                        }
                    }
                    else {
                        int k = 0;
                        while (k < dm.kids.Count) {
                            if (dm.kids[k].kind == AK.TypeParam()) { tparams.Add(dm.kids[k].sval); }
                            k = k + 1;
                        }
                    }
                    j = j + 1;
                }
            } else if (d.kind == AK.DelegateDecl()) {
                delegates.Add(d.sval);
                delegDecls.Add(d);
            }
            i = i + 1;
        }
    }

    public Node FindDelegate(string name) {
        int i = 0;
        while (i < delegDecls.Count) {
            if (delegDecls[i].sval == name || (i < delegates.Count && delegates[i] == name)) { return delegDecls[i]; }
            i = i + 1;
        }
        return null;
    }

    public bool IsDelegateName(string name) {
        if (name == "Func") { return true; }
        if (name == "Action") { return true; }
        int i = 0;
        while (i < delegates.Count) { if (delegates[i] == name) { return true; } i = i + 1; }
        return false;
    }

    public bool DelegateIsAsync(string name) {
        Node d = FindDelegate(name);
        if (d != null) {
            return (d.mods / 2048) - ((d.mods / 2048) / 2) * 2 == 1;
        }
        return false;
    }

    public bool IsTypeParam(string name) {
        int i = 0;
        while (i < tparams.Count) { if (tparams[i] == name) { return true; } i = i + 1; }
        return false;
    }

    public Node FindType(string name) {
        if (typeMap != null && typeMap.ContainsKey(name)) {
            return typeMap[name];
        }
        return null;
    }

    public bool IsPrimitive(string name) {
        if (name == "int") { return true; }
        if (name == "long") { return true; }
        if (name == "bool") { return true; }
        if (name == "string") { return true; }
        if (name == "char") { return true; }
        if (name == "double") { return true; }
        if (name == "float") { return true; }
        if (name == "void") { return true; }
        if (name == "object") { return true; }
        if (name == "nint") { return true; }
        if (name == "byte") { return true; }
        if (name == "short") { return true; }
        if (name == "uint") { return true; }
        if (name == "ulong") { return true; }
        if (name == "ushort") { return true; }
        if (name == "sbyte") { return true; }
        if (name == "decimal") { return true; }
        if (name == "var") { return true; }
        return false;
    }

    // Container generics recognised by the backend.
    public bool IsBuiltinGeneric(string name) {
        if (name == "List") { return true; }
        if (name == "Dictionary") { return true; }
        if (name == "Dict") { return true; }
        if (name == "Span") { return true; }
        if (name == "ReadOnlySpan") { return true; }
        if (name == "Func") { return true; }
        if (name == "Action") { return true; }
        if (name == "Tuple") { return true; }
        if (name == "Task") { return true; }
        return false;
    }

    // Builtin non-generic system classes recognised by the backend.
    public bool IsBuiltinClass(string name) {
        if (name == "StringBuilder") { return true; }
        if (name == "TypeInfo") { return true; }
        if (name == "Exception") { return true; }
        if (name == "InvalidCastException") { return true; }
        if (name == "FormatException") { return true; }
        if (name == "OverflowException") { return true; }
        if (name == "IndexOutOfRangeException") { return true; }
        if (name == "DivideByZeroException") { return true; }
        if (name == "NullReferenceException") { return true; }
        return false;
    }

    public Node FindField(Node cls, string name) {
        if (cls == null) { return null; }
        int i = 0;
        while (i < cls.kids.Count) {
            Node m = cls.kids[i];
            if (m.kind == AK.FieldDecl() && m.sval == name) { return m; }
            i = i + 1;
        }
        return null;
    }

    public Node FindMethod(Node cls, string name) {
        if (cls == null) { return null; }
        int i = 0;
        while (i < cls.kids.Count) {
            Node m = cls.kids[i];
            if (m.kind == AK.MethodDecl() && m.sval == name) { return m; }
            i = i + 1;
        }
        return null;
    }

    Node FirstParam(Node m) {
        int i = 0;
        while (i < m.kids.Count) { if (m.kids[i].kind == AK.Param()) { return m.kids[i]; } i = i + 1; }
        return null;
    }

    public bool IsMethodTypeParam(Node m, string tpName) {
        if (m == null || tpName == null || tpName == "") { return false; }
        int k = 0;
        while (k < m.kids.Count) {
            Node kd = m.kids[k];
            if (kd.kind == AK.TypeParam() && kd.sval == tpName) { return true; }
            k = k + 1;
        }
        return false;
    }

    // Subtyping / compatibility check: is targetTy assignable from fromTy?
    // Checks exact equality, universal object, base class inheritance chains,
    // and implemented interfaces.
    public bool IsAssignableFrom(string targetTy, string fromTy) {
        if (targetTy == null || fromTy == null) { return false; }
        if (targetTy == fromTy) { return true; }
        if (targetTy == "object" || targetTy == "System.Object") { return true; }

        string baseTarget = targetTy;
        int tlt = targetTy.IndexOf("<");
        if (tlt > 0) { baseTarget = targetTy.Substring(0, tlt); }

        string baseFrom = fromTy;
        int flt = fromTy.IndexOf("<");
        if (flt > 0) { baseFrom = fromTy.Substring(0, flt); }

        if (baseTarget == baseFrom) {
            if (targetTy == fromTy) { return true; }
            // 同名泛型的实参兼容：有形参方差位的用户声明按方向校验
            // （B-ID63 镜像 C11 checker 的接口/委托方差转换）；无方差
            // 信息（内建容器/未声明形状）保持名字级口径放行。
            if (tlt > 0 && flt > 0) { return VariantArgsCompatible(targetTy, fromTy); }
            return true;
        }

        // Builtin collection interfaces
        if (baseTarget == "IEnumerable" || baseTarget == "IReadOnlyList" ||
            baseTarget == "IReadOnlyCollection" ||
            baseTarget == "IList" || baseTarget == "ICollection") {
            if (baseFrom == "List" || fromTy.EndsWith("[]")) { return true; }
        }
        if (baseTarget == "IDictionary" || baseTarget == "IReadOnlyDictionary") {
            if (baseFrom == "Dictionary" || baseFrom == "Dict") { return true; }
        }

        string curName = baseFrom;
        int depth = 0;
        while (curName != "" && depth < 64) {
            depth = depth + 1;
            Node decl = FindType(curName);
            if (decl == null) { break; }

            // Check implemented interfaces
            if (decl.interfaces != null) {
                int i = 0;
                while (i < decl.interfaces.Count) {
                    string ifn = decl.interfaces[i];
                    int ilt = ifn.IndexOf("<");
                    string baseIfn = ilt > 0 ? ifn.Substring(0, ilt) : ifn;
                    if (baseIfn == baseTarget || IsAssignableFrom(targetTy, ifn)) { return true; }
                    i = i + 1;
                }
            }

            // Move to base class
            if (decl.sval2 != null && decl.sval2 != "") {
                string bname = decl.sval2;
                int blt = bname.IndexOf("<");
                string baseB = blt > 0 ? bname.Substring(0, blt) : bname;
                if (baseB == baseTarget || IsAssignableFrom(targetTy, bname)) { return true; }
                curName = baseB;
            } else {
                break;
            }
        }
        return false;
    }

    // 同名泛型基的实参兼容校验：取出声明形参的方差位（ival：1=out 协变
    // / -1=in 逆变 / 0=不变），对两侧实参逐位判定——协变位要求
    // from 实参可赋给 target 实参（Dog -> Animal），逆变位反向
    // （B-ID63，镜像 C11 checker.c 的接口方差分支）。声明查不到
    // （内建容器/命名空间限定的形状）时放行，保持旧口径。
    public bool VariantArgsCompatible(string targetTy, string fromTy) {
        Node decl = FindType(BaseTypeName(targetTy));
        if (decl == null) { return true; }
        List<long> vars = new List<long>();
        int i = 0;
        while (i < decl.kids.Count) {
            Node kd = decl.kids[i];
            if (kd.kind == AK.TypeParam()) { vars.Add(kd.ival); }
            i = i + 1;
        }
        if (vars.Count == 0) { return true; }
        // 无任何方差声明的接口保持旧口径放行（与 C11 checker_variant_args_ok
        // 同规：只在显式 out/in 上收紧）。
        bool anyVariance = false;
        int vi = 0;
        while (vi < vars.Count) { if (vars[vi] != 0) { anyVariance = true; break; } vi = vi + 1; }
        if (!anyVariance) { return true; }
        List<string> targs = SplitTypeArgs(targetTy);
        List<string> fargs = SplitTypeArgs(fromTy);
        if (targs.Count != vars.Count || fargs.Count != vars.Count) { return false; }
        int k = 0;
        while (k < vars.Count) {
            if (targs[k] == fargs[k]) { k = k + 1; continue; }
            if (vars[k] == 1) {
                if (!IsAssignableFrom(targs[k], fargs[k])) { return false; }
            } else if (vars[k] == -1) {
                if (!IsAssignableFrom(fargs[k], targs[k])) { return false; }
            } else {
                return false;
            }
            k = k + 1;
        }
        return true;
    }

    // "IBox<Dog>" -> "IBox"；无 '<' 原样返回。
    string BaseTypeName(string ty) {
        int lt = ty.IndexOf("<");
        if (lt > 0) { return ty.Substring(0, lt); }
        return ty;
    }

    // Split only top-level commas. Generic arguments and rectangular array
    // ranks can both contain commas within a single argument.
    List<string> SplitTypeArgs(string ty) {
        List<string> r = new List<string>();
        int lt = ty.IndexOf("<");
        int gt = ty.LastIndexOf(">");
        if (lt < 0 || gt < 0 || gt <= lt) { return r; }
        string body = ty.Substring(lt + 1, gt - lt - 1);
        int depth = 0;
        int start = 0;
        int i = 0;
        while (i < body.Length) {
            char c = body[i];
            if (c == '<' || c == '[') { depth = depth + 1; }
            else if (c == '>' || c == ']') { depth = depth - 1; }
            else if (c == ',' && depth == 0) {
                r.Add(body.Substring(start, i - start));
                start = i + 1;
            }
            i = i + 1;
        }
        r.Add(body.Substring(start, body.Length - start));
        return r;
    }

    public bool MatchReceiver(Node m, Node p0, string recvTy) {
        if (p0 == null || p0.type == null) { return false; }
        string pty = p0.type.sval;
        if (pty == recvTy) { return true; }
        if (IsMethodTypeParam(m, pty)) { return true; }
        if (IsAssignableFrom(pty, recvTy)) { return true; }
        return false;
    }

    // Find an extension method `name` (static, marked with a `this` receiver of
    // type recvTy) anywhere in the program. ownerOut receives its class name.
    public Node FindExtension(string recvTy, string name, List<string> ownerOut) {
        int i = 0;
        while (i < types.Count) {
            Node cls = types[i];
            int j = 0;
            while (j < cls.kids.Count) {
                Node m = cls.kids[j];
                if (m.kind == AK.MethodDecl() && m.sval == name && m.ival == 1) {
                    Node p0 = FirstParam(m);
                    if (MatchReceiver(m, p0, recvTy)) {
                        ownerOut.Add(cls.sval);
                        return m;
                    }
                }
                j = j + 1;
            }
            i = i + 1;
        }
        return null;
    }

    // All extension-method overloads named `name` for receiver type `recvTy`.
    public void FindExtensionAll(string recvTy, string name, List<Node> ms, List<string> owners) {
        int i = 0;
        while (i < types.Count) {
            Node cls = types[i];
            int j = 0;
            while (j < cls.kids.Count) {
                Node m = cls.kids[j];
                if (m.kind == AK.MethodDecl() && m.sval == name && m.ival == 1) {
                    Node p0 = FirstParam(m);
                    if (MatchReceiver(m, p0, recvTy)) {
                        ms.Add(m);
                        owners.Add(cls.sval);
                    }
                }
                j = j + 1;
            }
            i = i + 1;
        }
    }

    // A static constructor (`static C() { ... }`) is not an instance
    // constructor: it never takes part in `new C(...)` overload resolution.
    bool IsStaticCtor(Node c) {
        int f = MOD.Static();
        return (c.mods / f) - ((c.mods / f) / 2) * 2 == 1;
    }

    public Node FindCtor(Node cls) {
        if (cls == null) { return null; }
        int i = 0;
        while (i < cls.kids.Count) {
            // a static constructor is not an instance constructor: it never
            // takes part in `new C(...)` overload resolution
            if (cls.kids[i].kind == AK.CtorDecl() && !IsStaticCtor(cls.kids[i])) { return cls.kids[i]; }
            i = i + 1;
        }
        return null;
    }

    // First constructor whose parameter count matches argc (overload
    // resolution by arity, mirroring the C host's find_ctor).
    public Node FindCtorArity(Node cls, int argc) {
        if (cls == null) { return null; }
        int i = 0;
        while (i < cls.kids.Count) {
            Node c = cls.kids[i];
            if (c.kind == AK.CtorDecl() && !IsStaticCtor(c)) {
                int n = 0; int j = 0;
                while (j < c.kids.Count) {
                    if (c.kids[j].kind == AK.Param()) { n = n + 1; }
                    j = j + 1;
                }
                if (n == argc) { return c; }
            }
            i = i + 1;
        }
        return null;
    }
}
