using System;
using System.Collections.Generic;
namespace Zan;

public partial class Parser {

    // main.zan knows where each input file starts in the concatenated source
    // (1-based line numbers); with it the parser can give every declaration
    // its own file's namespace and usings instead of the stream-wide last one
    public void SetFileBounds(List<int> fs) { fileStarts = fs; curFile = -1; }

    int FileIdxOfLine(int line) {
        if (fileStarts == null) { return 0; }
        int i = fileStarts.Count - 1;
        while (i >= 0) { if (fileStarts[i] <= line) { return i; } i = i - 1; }
        return 0;
    }

    // at a file boundary: drop the previous file's namespace and usings
    void SyncFile() {
        if (fileStarts == null) { return; }
        int fi = FileIdxOfLine(K() != TK.Eof() ? Cur().line : (toks.Count > 0 ? toks[toks.Count - 1].line : 0));
        if (fi != curFile) {
            curFile = fi;
            curNs = "";
            curFileUsings = new List<string>();
        }
    }

    List<string> SnapshotUsings() {
        List<string> u = new List<string>();
        int i = 0;
        while (i < curFileUsings.Count) { u.Add(curFileUsings[i]); i = i + 1; }
        return u;
    }

    bool HasModBit(int mods, int bit) { return (mods / bit) - ((mods / bit) / 2) * 2 == 1; }

    string AttrSymbol(Node expr, bool allowUnion) {
        if (expr.kind == AK.Ident()) { return expr.sval; }
        if (expr.kind == AK.MemberAccess() && expr.ival == 0) {
            string owner = AttrSymbol(expr.a, false);
            if (owner != "") { return owner + "." + expr.sval; }
        }
        if (allowUnion && expr.kind == AK.Binary() && expr.op == TK.Pipe()) {
            string left = AttrSymbol(expr.a, true);
            string right = AttrSymbol(expr.b, true);
            if (left != "" && right != "") { return left + "|" + right; }
        }
        return "";
    }

    string AttrText(string value, int size) {
        return Convert.ToString(size) + ":" + value;
    }

    string ParseAttributeArgument(string key, out string legacyValue, Node attribute) {
        int start = pos;
        Node expr = ParseExpr();
        if (attribute != null) {
            if (key != "") {
                Node named = new Node(AK.Assignment());
                named.op = TK.Eq();
                named.a = new Node(AK.Ident());
                named.a.sval = key;
                named.b = expr;
                attribute.Add(named);
            } else { attribute.Add(expr); }
        }
        string kind = "X";
        string value = "";
        int size = 0;
        if (expr.kind == AK.StringLit() && expr.b == null) {
            kind = "S";
            value = expr.sval;
            size = StrEsc.DecodeBytes(value).Count;
        } else {
            if (expr.kind == AK.BoolLit()) {
                kind = "B";
                value = expr.ival != 0 ? "true" : "false";
            } else if (expr.kind == AK.IntLit()) {
                kind = "I";
                value = Convert.ToString(expr.ival);
            } else if (expr.kind == AK.FloatLit()) {
                kind = "F";
                value = expr.sval;
            } else {
                value = AttrSymbol(expr, true);
                if (value != "") { kind = "E"; }
            }
            size = value.Length;
        }
        legacyValue = value;
        if (kind == "X") {
            // Preserve the old token text for arguments outside the supported kinds.
            for (int i = start; i < pos; i = i + 1) { legacyValue = legacyValue + toks[i].text; }
        }
        return kind + AttrText(key, key.Length) + AttrText(value, size) + ";";
    }

    // Attributes: [DllImport("lib")] / [DllImport("lib", EntryPoint="n")] /
    // [StructLayout(...)] / [FieldOffset(...)] ... formatted into attrBlob.
    void ParseAttrs() {
        attrDll = false;
        attrIntrinsic = false;
        attrEntry = "";
        attrVariadic = false;
        attrThreadEntry = false;
        attrAtomicCas = false;
        attrAtomicLoad = false;
        attrAtomicStore = false;
        attrStaticAddr = "";
        attrLayoutExplicit = false;
        attrFieldOffset = -1;
        attrBlob = "";
        attrDeclaredData = "";
        parsedAttributes = metadataMode && At(TK.LBracket()) ? new List<Node>() : null;
        while (At(TK.LBracket())) {
            Next(); // [
            while (!At(TK.RBracket()) && !At(TK.Eof())) {
                if (At(TK.LBrace()) || At(TK.RBrace()) || At(TK.Semicolon()) || IsDeclStarter(K())) {
                    break;
                }
                if (!At(TK.Ident())) {
                    RecordUnexpected();
                    Next();
                    continue;
                }
                string aname = Next().text;
                while (Eat(TK.Dot())) {
                    if (At(TK.Ident())) { aname = Next().text; }
                }
                Node attribute = null;
                if (metadataMode) {
                    attribute = new Node(AK.Ident());
                    attribute.sval = aname;
                    parsedAttributes.Add(attribute);
                }
                attrDeclaredData = attrDeclaredData + "A" + AttrText(aname, aname.Length);
                string aShort = aname;
                if (aShort.Length > 9 && aShort.EndsWith("Attribute")) {
                    aShort = aShort.Substring(0, aShort.Length - 9);
                }
                if (aname == "DllImport") { attrDll = true; }
                else if (aname == "Intrinsic" || aname == "IntrinsicAttribute") { attrIntrinsic = true; }
                else if (aname == "ThreadEntry") { attrThreadEntry = true; }
                else if (aname == "AtomicCas") { attrAtomicCas = true; }
                else if (aname == "AtomicLoad") { attrAtomicLoad = true; }
                else if (aname == "AtomicStore") { attrAtomicStore = true; }


                if (Eat(TK.LParen())) {
                    bool hasArgs = false;
                    while (!At(TK.RParen()) && !At(TK.Eof())) {
                        hasArgs = true;
                        if (At(TK.Ident()) && K1() == TK.Eq()) {
                            string k = Next().text;
                            Next(); // =
                            string v;
                            attrDeclaredData = attrDeclaredData + ParseAttributeArgument(k, out v, attribute);
                            attrBlob = attrBlob + aShort + "." + k + "=" + v + ";";
                            if (aname == "DllImport") {
                                if (k == "EntryPoint") { attrEntry = v; }
                                else if (k == "Variadic" && v == "true") { attrVariadic = true; }
                            }
                        } else {
                            string v;
                            attrDeclaredData = attrDeclaredData + ParseAttributeArgument("", out v, attribute);
                            attrBlob = attrBlob + aShort + "=" + v + ";";
                            if (aname == "StaticAddr") { attrStaticAddr = v; }
                            else if (aname == "StructLayout" && v == "LayoutKind.Explicit") { attrLayoutExplicit = true; }
                            else if (aname == "FieldOffset") {
                                attrFieldOffset = Convert.ToInt32(v);
                            }
                        }
                        if (!Eat(TK.Comma())) { break; }
                    }
                    if (!hasArgs) {
                        attrBlob = attrBlob + aShort + "=true;";
                    }
                    Expect(TK.RParen());
                } else {
                    attrBlob = attrBlob + aShort + "=true;";
                }
                Eat(TK.Comma());
            }
            Expect(TK.RBracket());
        }
    }

    // All token access is end-of-input safe: once pos runs off the end we keep
    // returning the trailing Eof token so a truncated or malformed source can
    // never index past the token list (which used to be an access violation).
    Token Cur() { if (pos < toks.Count) { return toks[pos]; } return toks[toks.Count - 1]; }
    int K() { if (pos < toks.Count) { return toks[pos].kind; } return TK.Eof(); }
    int K1() { if (pos + 1 < toks.Count) { return toks[pos + 1].kind; } return TK.Eof(); }
    // True when the current and next tokens are physically adjacent (no gap),
    // used to recognise ">>" from two ">" tokens without breaking "List<List<int>>".
    bool AdjNext() {
        if (pos + 1 >= toks.Count) { return false; }
        Token a = toks[pos];
        Token b = toks[pos + 1];
        return b.line == a.line && b.col == a.col + 1;
    }
    int K2() { if (pos + 2 < toks.Count) { return toks[pos + 2].kind; } return TK.Eof(); }
    int K3() { if (pos + 3 < toks.Count) { return toks[pos + 3].kind; } return TK.Eof(); }
    // Recognize qualified and generic named types before a cast operand.
    // Only empty/comma rank groups belong to a type. The operand-start
    // restriction keeps `(x) + y` and `(a[i])` as grouped expressions.
    bool IsNamedCast() {
        if (K() != TK.LParen() || K1() != TK.Ident()) { return false; }
        int i = pos + 2;
        while (i + 1 < toks.Count && toks[i].kind == TK.Dot() && toks[i + 1].kind == TK.Ident()) {
            i = i + 2;
        }
        if (i < toks.Count && toks[i].kind == TK.Less()) {
            int depth = 1;
            i = i + 1;
            while (i < toks.Count && depth > 0) {
                int token = toks[i].kind;
                if (token == TK.Less()) { depth = depth + 1; }
                else if (token == TK.Greater()) { depth = depth - 1; }
                else if (token == TK.Eof() || token == TK.Semicolon() || token == TK.LBrace()
                         || token == TK.RBrace()) { return false; }
                i = i + 1;
            }
        }
        while (i < toks.Count && toks[i].kind == TK.LBracket()) {
            i = i + 1;
            while (i < toks.Count && toks[i].kind == TK.Comma()) { i = i + 1; }
            if (i >= toks.Count || toks[i].kind != TK.RBracket()) { return false; }
            i = i + 1;
        }
        if (i < toks.Count && toks[i].kind == TK.Question()) { i = i + 1; }
        if (i + 1 >= toks.Count || toks[i].kind != TK.RParen()) { return false; }
        int k = toks[i + 1].kind;
        if (k == TK.Ident()) { return true; }
        if (k == TK.IntLit()) { return true; }
        if (k == TK.FloatLit()) { return true; }
        if (k == TK.StringLit()) { return true; }
        if (k == TK.CharLit()) { return true; }
        if (k == TK.This()) { return true; }
        if (k == TK.New()) { return true; }
        if (k == TK.LParen()) { return true; }
        if (k == TK.Null()) { return true; }
        if (k == TK.True()) { return true; }
        if (k == TK.False()) { return true; }
        return false;
    }
    // adjacency between the tokens at pos+i and pos+i+1.
    bool AdjAt(int i) {
        if (pos + i + 1 >= toks.Count) { return false; }
        Token a = toks[pos + i];
        Token b = toks[pos + i + 1];
        return b.line == a.line && b.col == a.col + 1;
    }
    // ">>=": three adjacent ">" ">" "=" tokens (kept out of the lexer so nested
    // generics like List<List<int>> still parse).
    bool IsShrEq() {
        return At(TK.Greater()) && K1() == TK.GreaterEq() && AdjAt(0);
    }
    // ">>>": three adjacent ">" tokens; ">>>=" keeps the ">=" shape so the
    // two stay disjoint (kept out of the lexer for nested generics, like >>)
    bool IsUshr() {
        return At(TK.Greater()) && K1() == TK.Greater() && K2() == TK.Greater()
                && AdjAt(0) && AdjAt(1);
    }
    bool IsUshrEq() {
        return At(TK.Greater()) && K1() == TK.Greater() && K2() == TK.GreaterEq()
                && AdjAt(0) && AdjAt(1);
    }
    Token Next() { Token t = Cur(); if (pos < toks.Count) { pos = pos + 1; } return t; }
    bool At(int k) { return K() == k; }
    bool Eat(int k) { if (K() == k) { pos = pos + 1; return true; } return false; }
    // Suppress cascading syntax errors at the same token position (panic mode):
    // only the first mismatch at a given token is reported until pos advances.
    void RecordUnexpected() {
        if (pos == lastErrPos) { return; }
        Token c = Cur();
        if (K() == TK.Eof()) { diags.Error("syntax error: unexpected end of file", c.line, c.col); }
        else {
            string what = c.text;
            if (what == "") { what = TK.Lexeme(c.kind); }
            if (what == "") { diags.Error("syntax error: unexpected token", c.line, c.col); }
            else { diags.Error("syntax error: unexpected '" + what + "'", c.line, c.col); }
        }
        lastErrPos = pos;
    }

    bool IsClosingDelim(int k) {
        return k == TK.RBrace() || k == TK.RParen() || k == TK.RBracket()
            || k == TK.Semicolon() || k == TK.Comma() || k == TK.Eof();
    }

    // Delimiters that are virtually inserted on mismatch without consuming the
    // lookahead token (Roslyn/Clang missing-token recovery, B-ID190).
    bool IsVirtualDelim(int k) {
        return k == TK.Semicolon() || k == TK.RParen() || k == TK.RBracket()
            || k == TK.RBrace() || k == TK.Greater();
    }

    bool IsDeclStarter(int k) {
        if (k == TK.Public() || k == TK.Private() || k == TK.Protected()
                || k == TK.Static() || k == TK.Abstract() || k == TK.Virtual()
                || k == TK.Override() || k == TK.Sealed() || k == TK.Readonly()
                || k == TK.Const() || k == TK.Async()
                || k == TK.Class() || k == TK.Struct() || k == TK.Interface()
                || k == TK.Enum() || k == TK.Namespace() || k == TK.Using()) {
            return true;
        }
        if (k == TK.Ident()) {
            string s = Cur().text;
            if (s == "partial" || s == "internal" || s == "record"
                    || s == "delegate" || s == "extern" || s == "event"
                    || s == "weak" || s == "implicit" || s == "explicit") {
                return true;
            }
        }
        return false;
    }

    bool IsStmtStarter(int k) {
        if (k == TK.If() || k == TK.While() || k == TK.Do() || k == TK.For()
                || k == TK.Foreach() || k == TK.Return() || k == TK.Switch()
                || k == TK.Break() || k == TK.Continue() || k == TK.Try()
                || k == TK.Catch() || k == TK.Finally() || k == TK.Throw()
                || k == TK.Var() || k == TK.Using() || k == TK.LBrace()
                || k == TK.RBrace() || k == TK.Case() || k == TK.Default()) {
            return true;
        }
        return IsTypeKeyword(k);
    }

    bool CanStartType(int k) {
        return IsTypeKeyword(k) || k == TK.Ident() || k == TK.LParen();
    }

    bool IsTopTypeKeyword(int k) {
        return k == TK.Class() || k == TK.Struct() || k == TK.Interface()
            || k == TK.Enum() || k == TK.Namespace() || k == TK.Using();
    }

    void SkipBalancedBraces() {
        if (!At(TK.LBrace())) { return; }
        int depth = 0;
        while (!At(TK.Eof())) {
            if (depth > 0 && IsTopTypeKeyword(K())) { return; }
            if (At(TK.LBrace())) { depth = depth + 1; Next(); }
            else if (At(TK.RBrace())) {
                depth = depth - 1;
                Next();
                if (depth <= 0) { return; }
            } else { Next(); }
        }
    }

    // Re-synchronise inside a statement block: always advances at least one
    // token (except at `}` / EOF) and stops at the next statement boundary.
    void SynchronizeStmt() {
        if (At(TK.Eof()) || At(TK.RBrace())) { return; }
        if (Eat(TK.Semicolon())) { return; }
        Next();
        while (!At(TK.Eof()) && !At(TK.RBrace())) {
            if (Eat(TK.Semicolon())) { return; }
            if (IsStmtStarter(K()) || IsDeclStarter(K())) { return; }
            Next();
        }
    }

    // Re-synchronise inside a class/struct/interface body: skip malformed
    // tokens (including any balanced `{ ... }` body) until the next member
    // starter, `;`, `}`, or EOF.
    void SynchronizeMember() {
        if (At(TK.Eof()) || At(TK.RBrace())) { return; }
        if (Eat(TK.Semicolon())) { return; }
        if (At(TK.LBrace())) { SkipBalancedBraces(); return; }
        Next();
        while (!At(TK.Eof()) && !At(TK.RBrace())) {
            if (Eat(TK.Semicolon())) { return; }
            if (At(TK.LBrace())) { SkipBalancedBraces(); return; }
            if (IsDeclStarter(K()) || At(TK.LBracket()) || At(TK.Tilde())) { return; }
            Next();
        }
    }

    // Re-synchronise at top-level or namespace scope. Does not skip nested
    // braces blindly so unbalanced `{` before a declaration never swallows the
    // rest of the file. When stopAtRBrace is true, leaves `}` for an enclosing
    // `namespace { ... }` loop to consume.
    void SynchronizeTopLevel(bool stopAtRBrace) {
        if (At(TK.Eof())) { return; }
        if (At(TK.RBrace())) {
            if (!stopAtRBrace) { Next(); }
            return;
        }
        if (Eat(TK.Semicolon())) { return; }
        Next();
        while (!At(TK.Eof())) {
            if (Eat(TK.Semicolon())) { return; }
            if (At(TK.RBrace()) || IsDeclStarter(K()) || At(TK.LBracket())) { return; }
            Next();
        }
    }

    // On mismatch: record a diagnostic and recover without swallowing
    // structural boundaries (closing delimiters, `{`, or next statement/decl).
    void Expect(int k) {
        if (Eat(k)) { return; }
        RecordUnexpected();
        if (IsVirtualDelim(k)) { return; }
        int ck = K();
        if (ck == TK.Eof() || IsClosingDelim(ck) || ck == TK.LBrace()
                || IsDeclStarter(ck) || IsStmtStarter(ck)) {
            return;
        }
        pos = pos + 1;
    }

    bool IsTypeKeyword(int k) {
        if (k == TK.Int()) { return true; }
        if (k == TK.Long()) { return true; }
        if (k == TK.Bool()) { return true; }
        if (k == TK.String()) { return true; }
        if (k == TK.Char()) { return true; }
        if (k == TK.Double()) { return true; }
        if (k == TK.Float()) { return true; }
        if (k == TK.Void()) { return true; }
        if (k == TK.Object()) { return true; }
        if (k == TK.Byte()) { return true; }
        if (k == TK.Short()) { return true; }
        if (k == TK.Uint()) { return true; }
        if (k == TK.Ulong()) { return true; }
        if (k == TK.Ushort()) { return true; }
        if (k == TK.Sbyte()) { return true; }
        if (k == TK.Decimal()) { return true; }
        if (k == TK.Nint()) { return true; }
        return false;
    }

    string TypeKeywordName(int k) {
        if (k == TK.Int()) { return "int"; }
        if (k == TK.Long()) { return "long"; }
        if (k == TK.Bool()) { return "bool"; }
        if (k == TK.String()) { return "string"; }
        if (k == TK.Char()) { return "char"; }
        if (k == TK.Double()) { return "double"; }
        if (k == TK.Float()) { return "float"; }
        if (k == TK.Void()) { return "void"; }
        if (k == TK.Object()) { return "object"; }
        if (k == TK.Byte()) { return "byte"; }
        if (k == TK.Short()) { return "short"; }
        if (k == TK.Uint()) { return "uint"; }
        if (k == TK.Ulong()) { return "ulong"; }
        if (k == TK.Ushort()) { return "ushort"; }
        if (k == TK.Sbyte()) { return "sbyte"; }
        // A487: decimal 保留自己的类型名（checker 的 decimal 判定臂——二元
        // 混算、字面量 suffix、赋值/实参转换守卫——靠名字分流；宿主
        // decimal 与 double 互不隐式转换）。发射仍是 double：irgen 的
        // MapType 把 "decimal" 映射成 "double"，载荷与调用面不变。
        if (k == TK.Decimal()) { return "decimal"; }
        if (k == TK.Nint()) { return "nint"; }
        return "int";
    }

    // identifier-safe fragment of a type display name, for tuple class
    // names: "__Tuple_" + join(SanTy(elem), "_")
    string SanTy(string s) {
        string r = "";
        int i = 0;
        while (i < s.Length) {
            int c = s[i];
            if ((c >= 97 && c <= 122) || (c >= 65 && c <= 90) || (c >= 48 && c <= 57)) { r = r + Convert.ToString((char)c); }
            else if (c == 91) { r = r + "A"; }
            else if (c == 63) { r = r + "q"; }
            else if (r.Length > 0 && r.Substring(r.Length - 1, 1) != "_") { r = r + "_"; }
            i = i + 1;
        }
        while (r.Length > 0 && r.Substring(r.Length - 1, 1) == "_") { r = r.Substring(0, r.Length - 1); }
        return r;
    }

    // ---- types ----
    Node ParseType() {
        Node t = new Node(AK.TypeRef());
        int k = K();
        // the type's own position: a diagnostic about the type (an unknown
        // type, a wrong type-argument count) points at the type name, the way
        // the C host's binder points at the type ref's loc
        t.line = Cur().line; t.col = Cur().col;
        // tuple type:  ( T1, T2, ... ) -- lowered to a synthesized
        // __Tuple_<elements> class (ngen TupleSweep emits the class); the
        // element types ride in kids, op==2 marks the tuple ref so
        // TypeFullName renders the mangled name only
        if (k == TK.LParen()) {
            int save = pos;
            Next();
            Node e0 = ParseType();
            if (At(TK.Ident())) { Next(); }
            if (At(TK.Comma())) {
                t.op = 2;
                t.sval = "Tuple";
                t.Add(e0);
                while (Eat(TK.Comma())) {
                    Node et = ParseType();
                    if (At(TK.Ident())) { Next(); }
                    t.Add(et);
                }
                Expect(TK.RParen());
            } else {
                // `(T)` is just T
                pos = save;
                Next();
                t = ParseType();
                Expect(TK.RParen());
                return t;
            }
        }
        else if (IsTypeKeyword(k)) { t.sval = TypeKeywordName(k); Next(); }
        else if (k == TK.Ident()) { t.sval = Next().text; }
        else {
            RecordUnexpected();
            t.sval = "int";
            if (!IsClosingDelim(k) && k != TK.LBrace() && !IsDeclStarter(k) && !IsStmtStarter(k)) {
                Next();
            }
        }
        // namespace-qualified name:  Ns.Outer.Inner
        while (At(TK.Dot())) {
            Next();
            if (At(TK.Ident())) { t.sval = t.sval + "." + Next().text; }
            else { RecordUnexpected(); break; }
        }
        // generic args:  Name < T (, T)* >
        if (At(TK.Less())) {
            Next();
            if (!At(TK.Greater()) && !At(TK.RBrace()) && !At(TK.LBrace())
                    && !At(TK.Semicolon()) && !At(TK.RParen()) && !At(TK.Eof())) {
                t.a = ParseType();
                t.Add(t.a);
                while (Eat(TK.Comma())) {
                    if (At(TK.Greater()) || At(TK.RBrace()) || At(TK.LBrace())
                            || At(TK.Semicolon()) || At(TK.RParen()) || At(TK.Eof())) {
                        break;
                    }
                    t.Add(ParseType());
                }
            }
            Expect(TK.Greater());
        }
        // nullable
        if (At(TK.Question())) { Next(); t.op = t.op == 2 ? 2 : 1; t.elemNullable = true; }
        // array; ival counts the levels (int[][] keeps 2) so element
        // types and layout survive past one dimension. `[,]` (multidim)
        // keeps ival + 1 as well; a comma count rides in sval2.
        while (At(TK.LBracket())) {
            Next();
            int commas = 0;
            while (!At(TK.RBracket()) && !At(TK.Semicolon()) && !At(TK.RBrace())
                    && !At(TK.LBrace()) && !At(TK.RParen()) && !At(TK.Eof())) {
                if (At(TK.Comma())) { commas = commas + 1; }
                Next();
            }
            Expect(TK.RBracket());
            t.ival = t.ival + 1;
            // The RANK LIST: one entry per bracket group, outer to inner --
            // "2" for `int[,]`, "1,2" for `int[][,]`. The rank travels with
            // the type so the shape survives past the binder (the C host
            // keeps the same information as a nested type with a per-level
            // array_rank).
            string rk = Convert.ToString(commas + 1);
            t.arrRanks = (t.arrRanks == null || t.arrRanks == "") ? rk : t.arrRanks + "," + rk;
            // sval2 keeps its old meaning: the comma count of the rank
            // specifier (the native backend renders the type name from it)
            if (commas > 0) { t.sval2 = Convert.ToString(commas + (t.sval2 != null && t.sval2 != "" ? (int)Convert.ToInt64(t.sval2) : 0)); }
        }
        if (At(TK.Question())) { Next(); t.op = t.op == 2 ? 2 : 1; }
        return t;
    }

    // Scan past a type without building it (for decl lookahead).
    // Sets skipNullable when the scanned type carries a nullable marker (`?`).
    void SkipType() {
        skipNullable = false;
        if (At(TK.LParen())) {
            // tuple type: skip the balanced paren group
            Next();
            int pd = 1;
            while (pd > 0 && !At(TK.Eof())) {
                if (At(TK.LParen())) { pd = pd + 1; }
                else if (At(TK.RParen())) { pd = pd - 1; }
                Next();
            }
        } else if (IsTypeKeyword(K())) { Next(); }
        else if (At(TK.Ident())) { Next(); }
        else { return; }
        while (At(TK.Dot())) {
            Next();
            if (At(TK.Ident())) { Next(); }
            else { return; }
        }
        if (At(TK.Less())) {
            int depth = 0;
            Next(); depth = 1;
            while (depth > 0 && !At(TK.Eof())) {
                if (At(TK.Semicolon()) || At(TK.LBrace()) || At(TK.RBrace())) { return; }
                if (At(TK.Less())) { depth = depth + 1; }
                else if (At(TK.Greater())) { depth = depth - 1; }
                Next();
            }
        }
        if (At(TK.Question())) { Next(); skipNullable = true; }
        while (At(TK.LBracket())) {
            Next();
            while (!At(TK.RBracket()) && !At(TK.Semicolon()) && !At(TK.LBrace())
                    && !At(TK.RBrace()) && !At(TK.Eof())) { Next(); }
            if (At(TK.RBracket())) { Next(); }
        }
        if (At(TK.Question())) { Next(); skipNullable = true; }
    }

    // A declaration's name must be followed by `;` or `=`. A **nullable** type
    // (`T? x`) needs that extra check: the `?` may really be a ternary
    // operator, and then the statement is an expression (`flag ? a : b`),
    // not a declaration. The C host draws the same line in its lookahead
    // (see src/compiler/parser.c, looks_like_var_decl).
    bool DeclNameFollowed() {
        int save = pos;
        Next();                      // the name itself
        bool ok = At(TK.Semicolon()) || At(TK.Eq());
        pos = save;
        return ok;
    }

    bool IsDeclStart() {
        int k = K();
        if (k == TK.Var()) { return true; }
        if (k == TK.LParen()) {
            // `(int, int) pt` / `(int x, ...) =`: a tuple-typed declaration
            int save = pos;
            SkipType();
            bool ok = (K() == TK.Ident());
            pos = save;
            return ok;
        }
        if (IsTypeKeyword(k)) {
            // `int x` declares, but `int.Parse(s)` is an expression
            // statement: require an identifier after the (possibly
            // generic/qualified/array-suffixed) type before claiming a decl
            int save = pos;
            SkipType();
            bool ok = (K() == TK.Ident());
            if (ok && skipNullable) { ok = DeclNameFollowed(); }
            pos = save;
            return ok;
        }
        if (k == TK.Ident()) {
            int save = pos;
            SkipType();
            bool ok = (K() == TK.Ident());
            if (ok && skipNullable) { ok = DeclNameFollowed(); }
            pos = save;
            return ok;
        }
        return false;
    }

    // ---- modifiers ----
    int ParseMods() {
        int m = 0;
        while (true) {
            int k = K();
            if (k == TK.Public()) { m = m + MOD.Public(); Next(); }
            else if (k == TK.Private()) { m = m + MOD.Private(); Next(); }
            else if (k == TK.Protected()) { m = m + MOD.Protected(); Next(); }
            else if (k == TK.Static()) { m = m + MOD.Static(); Next(); }
            else if (k == TK.Virtual()) { m = m + MOD.Virtual(); Next(); }
            else if (k == TK.Override()) { m = m + MOD.Override(); Next(); }
            else if (k == TK.Abstract()) { m = m + MOD.Abstract(); Next(); }
            else if (k == TK.Readonly()) { m = m + MOD.Readonly(); Next(); }
            else if (k == TK.Async()) { m = m + MOD.Async(); Next(); }
            else if (k == TK.Ident() && Cur().text == "extern") { m = m + MOD.Extern(); Next(); }
            else if (k == TK.Ident() && Cur().text == "internal") { m = m + MOD.Internal(); Next(); } // B-ID83
            else if (k == TK.Ident() && Cur().text == "weak") { m = m + MOD.Weak(); Next(); }
            else if (k == TK.Ident() && Cur().text == "partial") { m = m + MOD.Partial(); Next(); }
            else if (k == TK.Sealed()) { m = m | MOD.Sealed(); Next(); }
            else if (k == TK.Const()) { Next(); m = m | MOD.Static(); } // const aliases static; `static const` must not double the bit (16+16==32==Virtual)
            else if (k == TK.Ref() && (K1() == TK.Struct() || K1() == TK.Readonly()
                || (K1() == TK.Ident() && pos + 1 < toks.Count && toks[pos + 1].text == "partial"))) { Next(); }
            else { return m; }
        }
    }

    // Parse one source to its own EOF before assembling a workspace unit.
    public Node ParseSourceDecls() {
        Node unit = new Node(AK.CompUnit());
        while (!At(TK.Eof())) {
            int posBefore = pos;
            int k = K();
            if (k == TK.Using()) { unit.Add(ParseUsing()); }
            else if (k == TK.Namespace()) { ParseNamespace(unit); }
            else { Node d = ParseTypeDecl(); if (d != null) { unit.Add(d); } }
            if (pos == posBefore && !At(TK.Eof())) {
                RecordUnexpected();
                SynchronizeTopLevel(false);
            }
        }
        return unit;
    }

    void PrepareDeclarations(Node unit) {
        MergePartials(unit);
        FlattenNested(unit);
        CheckDuplicateTypes(unit);
    }

    public Node ParseDeclsOnly() {
        Node unit = ParseSourceDecls();
        PrepareDeclarations(unit);
        return unit;
    }

    public void ResolveWorkspace(Node unit) {
        workspaceNames = true;
        PrepareDeclarations(unit);
        QualifyTypes(unit);
        workspaceNames = false;
    }

    bool metadataMode;
    List<Node> parsedAttributes;

    public Node ParseMetadata(out List<string> originalNames) {
        metadataMode = true;
        Node unit = ParseDeclsOnly();
        originalNames = new List<string>();
        for (int i = 0; i < unit.kids.Count; i = i + 1) {
            Node decl = unit.kids[i];
            originalNames.Add(IsTypeDeclaration(decl) ? NestedPrefix(decl) + decl.sval : decl.sval);
        }
        QualifyTypes(unit);
        return unit;
    }

    // ---- top level ----
    public Node ParseUnit() {
        Node unit = ParseDeclsOnly();
        // synthesized declarations join before namespace resolution, after
        // every input (and pulled-in package) is parsed -- the host's window
        SynthControlCatalog(unit);
        QualifyTypes(unit);
        DesugarEvents(unit);
        DesugarIterators(unit);
        StripTypeArgs(unit);
        return unit;
    }

    // Explicit call type args (`__typeargs` containers captured in
    // ParsePostfix) are erased before binding: drop them here so downstream
    // passes never see a TypeRef in an expression slot.
    Node ParseCallTypeArg() {
        Node t = ParseType();
        while (Eat(TK.Dot())) {
            if (At(TK.Ident())) { t.sval = Next().text; }
        }
        return t;
    }
}
