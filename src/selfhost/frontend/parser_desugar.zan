using System;
using System.Collections.Generic;
namespace Zan;

public partial class Parser {

    int iterSynthCounter;

    // Lazy iterator state-machine desugaring (mirrors C host iter_desugar_method
    // in src/compiler/parser/parser_type_decl.c): a static `IEnumerable<T>`
    // method containing `yield` synthesizes a `__Iter_<name>_<id>` class
    // implementing `IEnumerator<T>, IEnumerable<T>`, hoisting params and locals
    // to fields and rewriting each `yield return v` to
    // `{ __cur = v; __state = N; return true; RN: }`.
    void DesugarIterators(Node unit) {
        int origCount = unit.kids.Count;
        int di = 0;
        while (di < origCount) {
            Node d = unit.kids[di];
            if (d.kind == AK.ClassDecl() || d.kind == AK.StructDecl()) {
                int mi = 0;
                while (mi < d.kids.Count) {
                    Node m = d.kids[mi];
                    if (m.kind == AK.MethodDecl() && m.d != null && StmtHasYield(m.d)) {
                        if (m.type != null && m.type.sval == "IEnumerable" && m.type.kids.Count == 1
                                && HasModBit(m.mods, MOD.Static())) {
                            DesugarLazyIterator(unit, d, m);
                        } else {
                            DesugarYieldMethod(m);
                        }
                    }
                    mi = mi + 1;
                }
            }
            di = di + 1;
        }
    }

    Node IterTypeRef(string name, int line, int col) {
        Node t = new Node(AK.TypeRef());
        t.sval = name; t.line = line; t.col = col;
        return t;
    }

    Node IterIdent(string name, int line, int col) {
        Node n = new Node(AK.Ident());
        n.sval = name; n.line = line; n.col = col;
        return n;
    }

    Node IterBool(bool v, int line, int col) {
        Node n = new Node(AK.BoolLit());
        n.ival = v ? 1 : 0; n.line = line; n.col = col;
        return n;
    }

    Node IterInt(long v, int line, int col) {
        Node n = new Node(AK.IntLit());
        n.ival = v; n.line = line; n.col = col;
        return n;
    }

    Node IterAssign(Node lhs, Node rhs, int line, int col) {
        Node n = new Node(AK.Assignment());
        n.op = TK.Eq(); n.a = lhs; n.b = rhs; n.line = line; n.col = col;
        return n;
    }

    Node IterMember(Node obj, string name, int line, int col) {
        Node n = new Node(AK.MemberAccess());
        n.a = obj; n.sval = name; n.line = line; n.col = col;
        return n;
    }

    void IterAddField(Node cls, string name, Node ftype, int line, int col) {
        Node f = new Node(AK.FieldDecl());
        f.sval = name; f.type = ftype; f.mods = 0; f.line = line; f.col = col;
        cls.Add(f);
    }

    bool IterEncHasMember(Node enc, string name) {
        int i = 0;
        while (i < enc.kids.Count) {
            Node mm = enc.kids[i];
            if ((mm.kind == AK.MethodDecl() || mm.kind == AK.FieldDecl() || mm.kind == AK.PropertyDecl())
                    && mm.sval == name) {
                return true;
            }
            i = i + 1;
        }
        return false;
    }

    void IterFixExpr(Node e, Node enc, List<string> hoisted) {
        if (e == null) { return; }
        int k = e.kind;
        if (k == AK.Ident()) {
            if (e.sval != "" && !ContainsStr(hoisted, e.sval) && IterEncHasMember(enc, e.sval)) {
                string nm = e.sval;
                e.kind = AK.MemberAccess();
                e.a = IterIdent(enc.sval, e.line, e.col);
                e.sval = nm;
            }
            return;
        }
        if (k == AK.Binary() || k == AK.Assignment() || k == AK.Index()) {
            IterFixExpr(e.a, enc, hoisted);
            IterFixExpr(e.b, enc, hoisted);
            return;
        }
        if (k == AK.Unary() || k == AK.PostfixUnary() || k == AK.MemberAccess()
                || k == AK.CastExpr() || k == AK.IsExpr() || k == AK.AsExpr() || k == AK.AwaitExpr()) {
            IterFixExpr(e.a, enc, hoisted);
            return;
        }
        if (k == AK.Call()) {
            IterFixExpr(e.a, enc, hoisted);
            int i = 0;
            while (i < e.kids.Count) { IterFixExpr(e.kids[i], enc, hoisted); i = i + 1; }
            return;
        }
        if (k == AK.Conditional()) {
            IterFixExpr(e.a, enc, hoisted);
            IterFixExpr(e.b, enc, hoisted);
            IterFixExpr(e.c, enc, hoisted);
            return;
        }
        if (k == AK.NewExpr() || k == AK.TupleExpr()) {
            int i = 0;
            while (i < e.kids.Count) { IterFixExpr(e.kids[i], enc, hoisted); i = i + 1; }
            return;
        }
        if (k == AK.CallInit()) {
            IterFixExpr(e.a, enc, hoisted);
            int i = 0;
            while (i < e.kids.Count) { IterFixExpr(e.kids[i], enc, hoisted); i = i + 1; }
            return;
        }
    }

    void IterHoistVarDecl(Node s, Node cls, List<string> hoisted) {
        string name = s.sval;
        if (!ContainsStr(hoisted, name)) {
            hoisted.Add(name);
            Node ft = s.type != null ? s.type : IterTypeRef("int", s.line, s.col);
            IterAddField(cls, name, ft, s.line, s.col);
        }
        if (s.b != null) {
            Node asg = IterAssign(IterIdent(name, s.line, s.col), s.b, s.line, s.col);
            s.kind = AK.ExprStmt();
            s.a = asg;
            s.b = null;
            s.type = null;
            s.sval = "";
        } else {
            s.kind = AK.Block();
            s.a = null;
            s.b = null;
            s.type = null;
            s.sval = "";
            s.kids = new List<Node>();
        }
    }

    int IterRewriteStmt(Node s, Node cls, Node enc, List<string> hoisted, int nextState) {
        if (s == null) { return nextState; }
        int k = s.kind;
        if (k == AK.YieldStmt()) {
            int ln = s.line; int cl = s.col;
            if (s.a != null) {
                IterFixExpr(s.a, enc, hoisted);
                int st = nextState + 1;
                Node e1 = new Node(AK.ExprStmt()); e1.line = ln; e1.col = cl;
                e1.a = IterAssign(IterIdent("__cur", ln, cl), s.a, ln, cl);
                Node e2 = new Node(AK.ExprStmt()); e2.line = ln; e2.col = cl;
                e2.a = IterAssign(IterIdent("__state", ln, cl), IterInt(st, ln, cl), ln, cl);
                Node rt = new Node(AK.ReturnStmt()); rt.line = ln; rt.col = cl;
                rt.a = IterBool(true, ln, cl);
                Node lb = new Node(AK.LabelStmt()); lb.line = ln; lb.col = cl;
                lb.sval = "R" + st;
                s.kind = AK.Block();
                s.a = null;
                s.kids = new List<Node>();
                s.Add(e1);
                s.Add(e2);
                s.Add(rt);
                s.Add(lb);
                return st;
            }
            s.kind = AK.ReturnStmt();
            s.a = IterBool(false, ln, cl);
            return nextState;
        }
        if (k == AK.Block()) {
            int i = 0;
            while (i < s.kids.Count) {
                nextState = IterRewriteStmt(s.kids[i], cls, enc, hoisted, nextState);
                i = i + 1;
            }
            return nextState;
        }
        if (k == AK.ExprStmt() || k == AK.ReturnStmt() || k == AK.ThrowStmt()) {
            IterFixExpr(s.a, enc, hoisted);
            return nextState;
        }
        if (k == AK.IfStmt()) {
            IterFixExpr(s.a, enc, hoisted);
            nextState = IterRewriteStmt(s.b, cls, enc, hoisted, nextState);
            nextState = IterRewriteStmt(s.c, cls, enc, hoisted, nextState);
            return nextState;
        }
        if (k == AK.WhileStmt() || k == AK.DoWhileStmt() || k == AK.LockStmt()) {
            IterFixExpr(s.a, enc, hoisted);
            return IterRewriteStmt(s.b, cls, enc, hoisted, nextState);
        }
        if (k == AK.ForStmt()) {
            if (s.a != null) {
                if (s.a.kind == AK.VarDecl()) {
                    IterFixExpr(s.a.b, enc, hoisted);
                    IterHoistVarDecl(s.a, cls, hoisted);
                } else if (s.a.kind == AK.ExprStmt()) {
                    IterFixExpr(s.a.a, enc, hoisted);
                } else {
                    IterFixExpr(s.a, enc, hoisted);
                }
            }
            IterFixExpr(s.b, enc, hoisted);
            IterFixExpr(s.c, enc, hoisted);
            return IterRewriteStmt(s.d, cls, enc, hoisted, nextState);
        }
        if (k == AK.ForeachStmt()) {
            IterFixExpr(s.b, enc, hoisted);
            return IterRewriteStmt(s.c, cls, enc, hoisted, nextState);
        }
        if (k == AK.SwitchStmt()) {
            IterFixExpr(s.a, enc, hoisted);
            int i = 0;
            while (i < s.kids.Count) {
                nextState = IterRewriteStmt(s.kids[i].b, cls, enc, hoisted, nextState);
                i = i + 1;
            }
            return nextState;
        }
        if (k == AK.VarDecl()) {
            IterFixExpr(s.b, enc, hoisted);
            IterHoistVarDecl(s, cls, hoisted);
            return nextState;
        }
        if (k == AK.TryStmt()) {
            nextState = IterRewriteStmt(s.a, cls, enc, hoisted, nextState);
            if (s.c != null) { nextState = IterRewriteStmt(s.c, cls, enc, hoisted, nextState); }
            return nextState;
        }
        return nextState;
    }

    void DesugarLazyIterator(Node unit, Node enc, Node m) {
        Node rt = m.type;
        Node elemTy = rt.kids[0];
        int ln = m.line; int cl = m.col;

        string clsName = "__Iter_" + m.sval + "_" + iterSynthCounter;
        iterSynthCounter = iterSynthCounter + 1;

        Node cls = new Node(AK.ClassDecl());
        cls.sval = clsName;
        cls.mods = 0;
        cls.line = ln; cls.col = cl;

        Node ibase = IterTypeRef("IEnumerator", ln, cl);
        ibase.Add(elemTy);
        ibase.a = elemTy;
        cls.sval2 = "IEnumerator";
        cls.type = ibase;

        Node ebase = IterTypeRef("IEnumerable", ln, cl);
        ebase.Add(elemTy);
        ebase.a = elemTy;
        cls.interfaces.Add("IEnumerable");
        cls.interfaceRefs = new List<Node>();
        cls.interfaceRefs.Add(ebase);

        IterAddField(cls, "__state", IterTypeRef("int", ln, cl), ln, cl);
        IterAddField(cls, "__cur", elemTy, ln, cl);

        List<string> hoisted = new List<string>();
        Node ctor = new Node(AK.CtorDecl());
        ctor.sval = clsName;
        ctor.mods = MOD.Public();
        ctor.line = ln; ctor.col = cl;
        Node cbody = new Node(AK.Block());
        cbody.line = ln; cbody.col = cl;
        ctor.d = cbody;

        Node nw = new Node(AK.NewExpr());
        nw.type = IterTypeRef(clsName, ln, cl);
        nw.line = ln; nw.col = cl;

        int pi = 0;
        while (pi < m.kids.Count) {
            Node pm = m.kids[pi];
            if (pm.kind == AK.Param()) {
                IterAddField(cls, pm.sval, pm.type, ln, cl);
                Node np = new Node(AK.Param());
                np.sval = pm.sval; np.type = pm.type; np.line = ln; np.col = cl;
                ctor.Add(np);
                Node asStmt = new Node(AK.ExprStmt()); asStmt.line = ln; asStmt.col = cl;
                Node th = new Node(AK.ThisExpr()); th.line = ln; th.col = cl;
                asStmt.a = IterAssign(IterMember(th, pm.sval, ln, cl), IterIdent(pm.sval, ln, cl), ln, cl);
                cbody.Add(asStmt);
                hoisted.Add(pm.sval);
                nw.Add(IterIdent(pm.sval, ln, cl));
            }
            pi = pi + 1;
        }
        cls.Add(ctor);

        int maxState = IterRewriteStmt(m.d, cls, enc, hoisted, 0);

        Node mb = new Node(AK.Block());
        mb.line = ln; mb.col = cl;
        int st = 1;
        while (st <= maxState) {
            Node eq = new Node(AK.Binary());
            eq.op = TK.EqEq(); eq.line = ln; eq.col = cl;
            eq.a = IterIdent("__state", ln, cl);
            eq.b = IterInt(st, ln, cl);
            Node gt = new Node(AK.GotoStmt());
            gt.sval = "R" + st; gt.line = ln; gt.col = cl;
            Node tb = new Node(AK.Block()); tb.line = ln; tb.col = cl;
            tb.Add(gt);
            Node ifs = new Node(AK.IfStmt()); ifs.line = ln; ifs.col = cl;
            ifs.a = eq; ifs.b = tb; ifs.c = null;
            mb.Add(ifs);
            st = st + 1;
        }
        int bi = 0;
        while (bi < m.d.kids.Count) {
            mb.Add(m.d.kids[bi]);
            bi = bi + 1;
        }
        Node rf = new Node(AK.ReturnStmt()); rf.line = ln; rf.col = cl;
        rf.a = IterBool(false, ln, cl);
        mb.Add(rf);

        Node mn = new Node(AK.MethodDecl());
        mn.sval = "MoveNext";
        mn.type = IterTypeRef("bool", ln, cl);
        mn.mods = MOD.Public();
        mn.d = mb;
        mn.line = ln; mn.col = cl;
        cls.Add(mn);

        Node cb = new Node(AK.Block()); cb.line = ln; cb.col = cl;
        Node cr = new Node(AK.ReturnStmt()); cr.line = ln; cr.col = cl;
        cr.a = IterIdent("__cur", ln, cl);
        cb.Add(cr);
        Node cu = new Node(AK.MethodDecl());
        cu.sval = "Current";
        cu.type = elemTy;
        cu.mods = MOD.Public();
        cu.d = cb;
        cu.line = ln; cu.col = cl;
        cls.Add(cu);

        Node gret = IterTypeRef("IEnumerator", ln, cl);
        gret.Add(elemTy);
        gret.a = elemTy;
        Node gb = new Node(AK.Block()); gb.line = ln; gb.col = cl;
        Node gr = new Node(AK.ReturnStmt()); gr.line = ln; gr.col = cl;
        Node th2 = new Node(AK.ThisExpr()); th2.line = ln; th2.col = cl;
        gr.a = th2;
        gb.Add(gr);
        Node ge = new Node(AK.MethodDecl());
        ge.sval = "GetEnumerator";
        ge.type = gret;
        ge.mods = MOD.Public();
        ge.d = gb;
        ge.line = ln; ge.col = cl;
        cls.Add(ge);

        Node nb = new Node(AK.Block()); nb.line = ln; nb.col = cl;
        Node nret = new Node(AK.ReturnStmt()); nret.line = ln; nret.col = cl;
        nret.a = nw;
        nb.Add(nret);
        m.d = nb;

        unit.Add(cls);
    }

    bool StmtHasYield(Node s) {
        if (s == null) { return false; }
        if (s.kind == AK.YieldStmt()) { return true; }
        if (StmtHasYield(s.a)) { return true; }
        if (StmtHasYield(s.b)) { return true; }
        if (StmtHasYield(s.c)) { return true; }
        if (StmtHasYield(s.d)) { return true; }
        int i = 0;
        while (i < s.kids.Count) { if (StmtHasYield(s.kids[i])) { return true; } i = i + 1; }
        return false;
    }

    Node YieldIdent() {
        Node id = new Node(AK.Ident());
        id.sval = "__yield";
        return id;
    }

    Node RewriteYieldOne(Node s) {
        if (s == null) { return null; }
        if (s.kind == AK.YieldStmt()) {
            if (s.a != null) {
                Node mem = new Node(AK.MemberAccess());
                mem.a = YieldIdent(); mem.sval = "Add"; mem.line = s.line; mem.col = s.col;
                Node call = new Node(AK.Call());
                call.a = mem; call.Add(s.a); call.line = s.line; call.col = s.col;
                Node es = new Node(AK.ExprStmt());
                es.a = call; es.line = s.line; es.col = s.col;
                return es;
            }
            Node ret = new Node(AK.ReturnStmt());
            ret.a = YieldIdent(); ret.line = s.line; ret.col = s.col;
            return ret;
        }
        RewriteYields(s);
        return s;
    }

    void RewriteYields(Node s) {
        if (s == null) { return; }
        int k = s.kind;
        if (k == AK.Block()) {
            int i = 0;
            while (i < s.kids.Count) { s.kids[i] = RewriteYieldOne(s.kids[i]); i = i + 1; }
        } else if (k == AK.IfStmt()) {
            s.b = RewriteYieldOne(s.b);
            s.c = RewriteYieldOne(s.c);
        } else if (k == AK.WhileStmt()) {
            s.b = RewriteYieldOne(s.b);
        } else if (k == AK.DoWhileStmt()) {
            s.b = RewriteYieldOne(s.b);
        } else if (k == AK.ForStmt()) {
            s.d = RewriteYieldOne(s.d);
        } else if (k == AK.ForeachStmt()) {
            s.c = RewriteYieldOne(s.c);
        } else if (k == AK.TryStmt()) {
            s.a = RewriteYieldOne(s.a);
            if (s.b != null) { s.b.a = RewriteYieldOne(s.b.a); }
            s.c = RewriteYieldOne(s.c);
        } else if (k == AK.SwitchStmt()) {
            int i = 0;
            while (i < s.kids.Count) { Node c = s.kids[i]; c.b = RewriteYieldOne(c.b); i = i + 1; }
        }
    }

    void DesugarYieldMethod(Node m) {
        Node body = m.d;
        if (!StmtHasYield(body)) { return; }
        Node rt = m.type;
        if (rt == null) { return; }
        // rewrite IEnumerable<T> / List<T> return type to List<T>
        rt.sval = "List";
        // build accumulator initializer: new List<T>()
        Node lt = new Node(AK.TypeRef());
        lt.sval = "List";
        int i = 0;
        while (i < rt.kids.Count) { lt.Add(rt.kids[i]); i = i + 1; }
        if (lt.kids.Count > 0) { lt.a = lt.kids[0]; }
        Node nw = new Node(AK.NewExpr());
        nw.type = lt;
        Node decl = new Node(AK.VarDecl());
        decl.sval = "__yield";
        decl.type = null;
        decl.b = nw;
        RewriteYields(body);
        Node ret = new Node(AK.ReturnStmt());
        ret.a = YieldIdent();
        List<Node> old = body.kids;
        List<Node> nk = new List<Node>();
        nk.Add(decl);
        int j = 0;
        while (j < old.Count) { nk.Add(old[j]); j = j + 1; }
        nk.Add(ret);
        body.kids = nk;
    }

    bool ContainsStr(List<string> xs, string s) {
        int i = 0;
        while (i < xs.Count) { if (xs[i] == s) { return true; } i = i + 1; }
        return false;
    }

    Node FindDelegate(Node unit, string name) {
        int i = 0;
        while (i < unit.kids.Count) {
            Node d = unit.kids[i];
            if (d.kind == AK.DelegateDecl() && d.sval == name) { return d; }
            i = i + 1;
        }
        return null;
    }

    // `event D E;` fields lower to a generated multicast holder class
    // `__Event_D` backed by a List<D>; its op_add/op_sub drive the `E += h` /
    // `E -= h` compound-assignment desugar, E.Invoke(..) raises the event and
    // E.Count() reports the handler count. Mirrors the C host desugar_events.
    void DesugarEvents(Node unit) {
        List<string> gen = new List<string>();
        int origCount = unit.kids.Count;
        int di = 0;
        while (di < origCount) {
            Node d = unit.kids[di];
            if (d.kind == AK.ClassDecl() || d.kind == AK.StructDecl()) {
                int mi = 0;
                while (mi < d.kids.Count) {
                    Node m = d.kids[mi];
                    if (m.kind == AK.FieldDecl() && HasModBit(m.mods, MOD.Event()) && m.type != null) {
                        string dn = m.type.sval;
                        Node ddecl = FindDelegate(unit, dn);
                        if (ddecl != null) {
                            string hn = "__Event_" + dn;
                            if (!ContainsStr(gen, hn)) {
                                GenEventHolder(unit, ddecl, dn, hn);
                                gen.Add(hn);
                            }
                            m.type.sval = hn;
                        }
                    }
                    mi = mi + 1;
                }
            }
            di = di + 1;
        }
    }

    void GenEventHolder(Node unit, Node ddecl, string dn, string hn) {        string s = "class " + hn + " {\n";
        s = s + "    List<" + dn + "> hs;\n";
        s = s + "    static " + hn + " op_add(" + hn + " self, " + dn + " h) {\n";
        s = s + "        " + hn + " r = self;\n";
        s = s + "        if (r == null) { r = new " + hn + "(); r.hs = new List<" + dn + ">(); }\n";
        s = s + "        r.hs.Add(h);\n";
        s = s + "        return r;\n";
        s = s + "    }\n";
        s = s + "    static " + hn + " op_sub(" + hn + " self, " + dn + " h) {\n";
        s = s + "        if (self == null) { return self; }\n";
        s = s + "        int i = self.hs.Count - 1;\n";
        s = s + "        while (i >= 0) {\n";
        s = s + "            if (self.hs[i] == h) { self.hs.RemoveAt(i); return self; }\n";
        s = s + "            i = i - 1;\n";
        s = s + "        }\n";
        s = s + "        return self;\n";
        s = s + "    }\n";
        s = s + "    int Count() { return hs.Count; }\n";
        s = s + "    void Invoke(";
        int i = 0;
        while (i < ddecl.kids.Count) {
            Node p = ddecl.kids[i];
            if (p.kind == AK.Param()) {
                if (i > 0) { s = s + ", "; }
                s = s + TypeName(p.type) + " a" + i;
            }
            i = i + 1;
        }
        s = s + ") {\n";
        s = s + "        int i = 0;\n";
        s = s + "        while (i < hs.Count) {\n";
        s = s + "            " + dn + " d = hs[i];\n";
        s = s + "            d(";
        i = 0;
        while (i < ddecl.kids.Count) {
            Node p = ddecl.kids[i];
            if (p.kind == AK.Param()) {
                if (i > 0) { s = s + ", "; }
                s = s + "a" + i;
            }
            i = i + 1;
        }
        s = s + ");\n";
        s = s + "            i = i + 1;\n";
        s = s + "        }\n";
        s = s + "    }\n";
        // `E(args)` raises the event, as in C#. The holder is null until the
        // first subscription, and a call with no subscribers does nothing --
        // the `E?.Invoke(...)` shape C# code writes by hand.
        s = s + "    static void op_call(" + hn + " self";
        int np = 0;
        int pi = 0;
        while (pi < ddecl.kids.Count) {
            Node p = ddecl.kids[pi];
            if (p.kind == AK.Param()) {
                if (np > 0) { s = s + ", "; }
                s = s + ", " + TypeName(p.type) + " a" + np;
                np = np + 1;
            }
            pi = pi + 1;
        }
        s = s + ") {\n";
        s = s + "        if (self == null) { return; }\n";
        s = s + "        self.Invoke(";
        int ai = 0;
        while (ai < np) {
            if (ai > 0) { s = s + ", "; }
            s = s + "a" + ai;
            ai = ai + 1;
        }
        s = s + ");\n";
        s = s + "    }\n";
        s = s + "}\n";
        Lexer lx = new Lexer(s);
        List<Token> gt = lx.Run();
        Parser gp = new Parser(gt, diags);
        Node gu = gp.ParseUnit();
        int j = 0;
        while (j < gu.kids.Count) { unit.Add(gu.kids[j]); j = j + 1; }
    }

    bool CanMergeParts(Node first, Node part) {
        if (first.kind != part.kind || !HasModBit(first.mods, MOD.Partial())
                || !HasModBit(part.mods, MOD.Partial())
                || (first.mods & MOD.Iface()) != (part.mods & MOD.Iface())) {
            return false;
        }
        int i = 0;
        while (i < first.kids.Count && first.kids[i].kind == AK.TypeParam()) {
            if (i >= part.kids.Count || part.kids[i].kind != AK.TypeParam()
                    || first.kids[i].sval != part.kids[i].sval) {
                return false;
            }
            i = i + 1;
        }
        return i >= part.kids.Count || part.kids[i].kind != AK.TypeParam();
    }

    // Merge siblings before hoisting so each nested type has its canonical
    // owner, including when its declarations come from different owner parts.
    void MergePartials(Node owner) {
        List<Node> merged = new List<Node>();
        Dictionary<string, Node> parts = new Dictionary<string, Node>();
        int di = 0;
        while (di < owner.kids.Count) {
            Node d = owner.kids[di];
            Node first = null;
            if (d.kind == AK.ClassDecl() || d.kind == AK.StructDecl()) {
                string full = FullTypeName(d);
                if (parts.ContainsKey(full)) {
                    Node candidate = parts[full];
                    if (CanMergeParts(candidate, d)) { first = candidate; }
                } else {
                    parts[full] = d;
                }
            }
            if (first != null) {
                int mi = 0;
                while (mi < d.kids.Count) {
                    Node km = d.kids[mi];
                    if (km.kind != AK.TypeParam()) {
                        if (km.nsUsings == null) {
                            km.nsName = d.nsName != null ? d.nsName : "";
                            km.nsUsings = d.nsUsings;
                        }
                        first.Add(km);
                    }
                    mi = mi + 1;
                }
                if (first.sval2 == "" && d.sval2 != "") {
                    first.sval2 = d.sval2;
                    first.type = d.type;
                    first.baseLine = d.baseLine;
                    first.baseCol = d.baseCol;
                } else if (d.type != null) {
                    AppendPartialBase(first, d.type);
                }
                if (d.interfaceRefs != null) {
                    for (int bi = 0; bi < d.interfaceRefs.Count; bi = bi + 1) {
                        AppendPartialBase(first, d.interfaceRefs[bi]);
                    }
                }
                first.mods = first.mods | (d.mods & MOD.Sealed());
                if (metadataMode) {
                    if (first.partialLines == null) { first.partialLines = new List<int>(); }
                    first.partialLines.Add(d.line);
                }
            } else {
                merged.Add(d);
            }
            di = di + 1;
        }
        owner.kids = merged;
        for (int i = 0; i < merged.Count; i = i + 1) {
            Node d = merged[i];
            if (d.kind == AK.ClassDecl() || d.kind == AK.StructDecl()) { MergePartials(d); }
        }
    }

    void AppendPartialBase(Node decl, Node baseType) {
        if (decl.interfaceRefs == null) {
            decl.interfaceRefs = new List<Node>();
            decl.interfaces = new List<string>();
        }
        decl.interfaceRefs.Add(baseType);
        decl.interfaces.Add(baseType.sval);
    }

    void CheckDuplicateTypes(Node unit) {
        Dictionary<string, bool> seen = new Dictionary<string, bool>();
        for (int i = 0; i < unit.kids.Count; i = i + 1) {
            Node d = unit.kids[i];
            if (!IsTypeDeclaration(d) || d.sval == "") { continue; }
            string full = FullTypeName(d);
            if (seen.ContainsKey(full)) {
                diags.Error("[E1010] duplicate type declaration '" + full + "'", d.line, d.col);
            } else {
                seen[full] = true;
            }
        }
    }

    // Nested type declarations lift to the unit top level under their simple
    // name (mirrors the C host's zan_parser_flatten_nested_types): the binder
    // and ngen see flat type tables only. Recursion lifts deeper nesting
    // first, member lists keep their order, and hoisted types land after
    // their enclosing class like the C host.
    void FlattenNested(Node unit) {
        int di = 0;
        while (di < unit.kids.Count) {
            Node d = unit.kids[di];
            if (d.kind == AK.ClassDecl() || d.kind == AK.StructDecl()
                    || d.kind == AK.EnumDecl()) {
                HoistNested(unit, d);
            }
            di = di + 1;
        }
    }

    int HoistNested(Node unit, Node typeNode) {
        int hoisted = 0;
        int mi = 0;
        while (mi < typeNode.kids.Count) {
            Node mem = typeNode.kids[mi];
            if (mem.kind == AK.ClassDecl() || mem.kind == AK.StructDecl()
                    || mem.kind == AK.EnumDecl() || mem.kind == AK.DelegateDecl()) {
                // Keep the source context stamped before partials merged.
                mem.a = typeNode;
                hoisted = hoisted + HoistNested(unit, mem);
                unit.Add(mem);
                hoisted = hoisted + 1;
                int k = mi;
                while (k < typeNode.kids.Count - 1) {
                    typeNode.kids[k] = typeNode.kids[k + 1];
                    k = k + 1;
                }
                typeNode.kids.RemoveAt(typeNode.kids.Count - 1);
            } else {
                mi = mi + 1;
            }
        }
        return hoisted;
    }
}
