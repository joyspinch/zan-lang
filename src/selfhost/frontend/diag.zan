using System;
using System.Collections.Generic;
using System.Text;
namespace Zan;

// One diagnostic message with source position. `warn` selects the severity
// (true = warning, false = error); the driver applies the warning policy.
public class Diag {
    public string msg;
    public int line;
    public int col;
    public bool warn;
    public Diag(string m, int ln, int c, bool w) { msg = m; line = ln; col = c; warn = w; }
}

// Diagnostic sink shared across compiler phases.
public class Diags {
    public List<Diag> items;
    List<string> files;
    List<int> fileStarts;
    public Diags() { items = new List<Diag>(); files = null; fileStarts = null; }
    public void Error(string m, int line, int col) { items.Add(new Diag(m, line, col, false)); }
    public void Warning(string m, int line, int col) { items.Add(new Diag(m, line, col, true)); }
    public void ErrorCode(int code, string m, int line, int col) {
        items.Add(new Diag(DiagCodes.FormatError(code, m), line, col, false));
    }
    public void WarningCode(int code, string m, int line, int col) {
        items.Add(new Diag(DiagCodes.FormatWarning(code, m), line, col, true));
    }
    // Adopt a diagnostic that was built elsewhere (the checker collects the
    // type-resolution diagnostics before deciding how often to report them).
    public void Add(Diag d) { items.Add(d); }
    public int Count() { return items.Count; }
    public bool HasWarnings() {
        int i = 0;
        while (i < items.Count) {
            if (items[i].warn) { return true; }
            i = i + 1;
        }
        return false;
    }
    public bool HasErrors() {
        int i = 0;
        while (i < items.Count) {
            if (!items[i].warn) { return true; }
            i = i + 1;
        }
        return false;
    }

    // Registers the source files that were concatenated into the translation
    // unit: `names[i]` starts at 1-based global line `starts[i]`. Lets Report
    // print "file:line:col" with per-file line numbers.
    public void SetFiles(List<string> names, List<int> starts) {
        files = names;
        fileStarts = starts;
    }

    // The source file a global line belongs to ("" when the unit has no file
    // registry). The runtime guard reports use the same position the
    // compiler diagnostics print.
    public string FileOfLine(int line) {
        if (files == null || fileStarts == null || fileStarts.Count == 0) { return ""; }
        int fi = 0;
        int k = 1;
        while (k < fileStarts.Count) {
            if (fileStarts[k] <= line) { fi = k; }
            k = k + 1;
        }
        return files[fi];
    }

    // The 1-based line number inside the file a global line belongs to.
    public int LineInFile(int line) {
        if (files == null || fileStarts == null || fileStarts.Count == 0) { return line; }
        int fi = 0;
        int k = 1;
        while (k < fileStarts.Count) {
            if (fileStarts[k] <= line) { fi = k; }
            k = k + 1;
        }
        return line - fileStarts[fi] + 1;
    }

    string Esc() {
        string e = "" + " ";
        e[0] = 27;
        return e;
    }

    string PadLeft(string s, int w) {
        string r = s;
        while (r.Length < w) { r = " " + r; }
        return r;
    }

    // Selfhost diagnostics currently carry their optional code in the text
    // prefix. Split it at the wire boundary so text and LSP keep their wording.
    static int CodePrefixLength(string message) {
        if (message.Length < 8 || message[0] != '[' || (message[1] != 'E' && message[1] != 'W')) { return 0; }
        int i = 2;
        while (i < message.Length && message[i] >= '0' && message[i] <= '9') { i = i + 1; }
        if (i >= 6 && i + 1 < message.Length && message[i] == ']' && message[i + 1] == ' ') { return i + 2; }
        return 0;
    }

    static void AppendJsonString(StringBuilder json, string text) {
        if (text == null) { json.Append("null"); return; }
        json.Append("\"");
        int start = 0;
        int i = 0;
        while (i < text.Length) {
            if ((text[i] & 255) < 128) {
                i = i + 1;
                continue;
            }
            int width = (int)(Encoding.DecodeCodePointFast(text, i) >> 32);
            if (width == 1) {
                // The decoder consumes one byte per malformed sequence step.
                Encoding.JsonEscapeTo(json, text.Substring(start, i - start));
                json.Append("\\ufffd");
                start = i + 1;
            }
            i = i + width;
        }
        Encoding.JsonEscapeTo(json, start == 0 ? text : text.Substring(start, text.Length - start));
        json.Append("\"");
    }

    void ReportJson(Diag entry, bool denyWarnings) {
        string file = entry.line > 0 ? FileOfLine(entry.line) : "";
        int line = entry.line > 0 ? LineInFile(entry.line) : 0;
        int col = entry.col > 0 ? entry.col : 0;
        int prefix = CodePrefixLength(entry.msg);
        StringBuilder json = new StringBuilder();
        json.Append("{\"format\":\"zan-diagnostic-v1\",\"severity\":\"");
        json.Append(entry.warn && !denyWarnings ? "warning" : "error");
        json.Append("\",\"file\":");
        AppendJsonString(json, file == "" ? null : file);
        json.Append(",\"line\":" + line + ",\"col\":" + col + ",\"code\":");
        AppendJsonString(json, prefix == 0 ? null : entry.msg.Substring(1, prefix - 3));
        json.Append(",\"message\":");
        AppendJsonString(json, prefix == 0 ? entry.msg : entry.msg.Substring(prefix));
        json.Append("}");
        Console.ErrorWriteLine(json.ToString());
    }

    // Print entries at index >= start so each phase can flush its own.
    public void Report(string src, int start, bool jsonl, bool denyWarnings) {
        if (jsonl) {
            for (int i = start; i < items.Count; i = i + 1) { ReportJson(items[i], denyWarnings); }
            return;
        }
        // Text reports keep the colored severity, source gutter and caret.
        string red = Esc() + "[31m";
        string yel = Esc() + "[33m";
        string rst = Esc() + "[0m";
        int j = start;
        while (j < items.Count) {
            Diag e = items[j];
            int shown = e.line;
            string loc = "";
            if (files != null && fileStarts != null && fileStarts.Count > 0) {
                int fi = 0;
                int k = 1;
                while (k < fileStarts.Count) {
                    if (fileStarts[k] <= e.line) { fi = k; }
                    k = k + 1;
                }
                shown = e.line - fileStarts[fi] + 1;
                loc = files[fi] + ":";
            }
            if (e.warn) {
                Console.WriteLine(loc + shown + ":" + e.col + ": " + yel + "warning" + rst + ": " + e.msg);
            } else {
                Console.WriteLine(loc + shown + ":" + e.col + ": " + red + "error" + rst + ": " + e.msg);
            }
            string ln = LineOf(src, e.line);
            if (ln.Length > 0) {
                Console.WriteLine(PadLeft("" + shown, 5) + " | " + ln);
                string car = "";
                int k2 = 1;
                while (k2 < e.col) { car = car + " "; k2 = k2 + 1; }
                Console.WriteLine("      | " + car + (e.warn ? yel : red) + "^" + rst);
            }
            j = j + 1;
        }
    }

    // Prints the closing "N error(s), M warning(s)" summary line.
    public void Summary() {
        int errs = 0;
        int warns = 0;
        int i = 0;
        while (i < items.Count) {
            if (items[i].warn) { warns = warns + 1; } else { errs = errs + 1; }
            i = i + 1;
        }
        Console.WriteLine("");
        Console.WriteLine("" + errs + " error(s), " + warns + " warning(s)");
    }

    // Extract the 1-based source line (without its trailing newline / CR).
    // A line-offset table is built once per source text so N diagnostics cost
    // N short extracts instead of N full-text scans.
    List<int> lineOffs;
    string lineSrc;

    void BuildLineOffs(string src) {
        lineOffs = new List<int>();
        lineSrc = src;
        lineOffs.Add(0);
        int i = 0;
        while (i < src.Length) {
            if ((int)src[i] == 10) { lineOffs.Add(i + 1); }
            i = i + 1;
        }
    }

    string LineOf(string src, int line) {
        if (lineOffs == null || lineSrc != src) { BuildLineOffs(src); }
        // out-of-range lines keep the old scan's semantics: a line before 1
        // resolves to the text start, a line past EOF to the last newline's
        // successor (i.e. an empty tail when the text ends with '\n')
        int start = 0;
        if (line > 1) {
            if (line <= lineOffs.Count) { start = lineOffs[line - 1]; }
            else { start = lineOffs[lineOffs.Count - 1]; }
        }
        int end = start;
        while (end < src.Length && (int)src[end] != 10) { end = end + 1; }
        if (end > start && (int)src[end - 1] == 13) { end = end - 1; }
        return src.Substring(start, end - start);
    }
}
