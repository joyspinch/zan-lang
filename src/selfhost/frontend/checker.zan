using System;
using System.Collections.Generic;
namespace Zan;

// Checker: semantic pass over the bound AST. Beyond resolving every type
// reference (primitive, builtin generic, type parameter or declared type) it
// walks method/constructor bodies with a typed lexical scope and a light
// expression typer so that it can reject the illegal programs that the
// resolution-only pass used to wave through:
//   * local variables, parameters and other bindings are tracked with types;
//   * identifiers used in value positions must resolve to a local, parameter,
//     field/method of the enclosing type, a known type or an enum member;
//   * a member access / call on a value of a *known* user type must name a
//     real field, method or property of that type (walking base classes);
//   * a call must pass an argument count some overload accepts;
//   * `return` must carry a value in a non-void method and must not in a void
//     one; a static method may not use `this` or an instance field;
//   * break/continue may only appear inside a loop or switch;
//   * a parameter name may not be declared twice in one signature.
//
// The typer is deliberately conservative: when it cannot determine a type it
// yields null and the dependent check is skipped, so standard-library calls
// (Console, File, Math, ...) whose receiver types the bootstrap binder does
// not track are never mis-flagged. Mirrors src/compiler/checker.c for the
// bootstrap subset while being strictly more thorough.
public partial class Checker {
    public Binder binder;
    public Diags diags;

    Node curClass;              // type declaration whose body is being checked
    Node curMethodNode;
    Node curRet;                // return type of the current method (null=void)
    Node curTargetType;         // expected type of the expression being checked (delegate etc.)
    bool curStatic;             // is the current method static
    int infCount;
    int loopDepth;              // enclosing loop/switch nesting
    int catchDepth;             // enclosing catch-clause nesting (a bare `throw;`
                                // is only valid inside a catch block)
    List<string> scopeName;     // value names currently in scope
    List<Node> scopeType;       // parallel declared/inferred types (may be null)
    List<Node> accReported;     // accessor nodes whose E2095 already fired
                                // (InferType re-runs on one node many times)
    public int inCallArgs;

    public Checker(Binder b, Diags d) {
        binder = b; diags = d; curClass = null; curMethodNode = null; curRet = null; curTargetType = null;
        curStatic = false; loopDepth = 0; catchDepth = 0;
        scopeName = new List<string>(); scopeType = new List<Node>();
        accReported = null;
        inCallArgs = 0;
    }

    public bool IsTreeLambda(Node n) {
        if (n == null || n.kind != AK.Lambda()) { return false; }
        if (n.kids.Count != 1) { return false; }
        if (n.d != null) { return false; }
        Node p0 = n.kids[0];
        if (p0 == null || p0.kind != AK.Param() || p0.type == null) { return false; }
        string ts = p0.type.sval;
        if (ts == "ExprNode" || ts == "System.Linq.ExprNode") { return true; }
        if (ts == "Expr" || ts == "System.Linq.Expr") { return true; }
        if (ts.StartsWith("Expr<") || ts.StartsWith("System.Linq.Expr<")) { return true; }
        return false;
    }

    Node MkType(string name) { Node t = new Node(AK.TypeRef()); t.sval = name; return t; }
    bool HasMod(Node m, int flag) { return (m.mods / flag) - ((m.mods / flag) / 2) * 2 == 1; }

    // ---- B-ID83: `internal` visibility, mirroring the C host (checker.c
    // access_member_allowed / report_inaccessible). An internal member is
    // reachable only from its own module, and a module is the first two
    // namespace segments: `Acc.Inner` vs `Acc.Other` are different modules,
    // `Zan.Web.Core` vs `Zan.Web.Security` are the same one. The diagnostic
    // quotes the declaring namespace in full -- same wording as the host's
    // E2004, so a reject case can pin both compilers to one sentence.
    string ModuleOf(string ns) {
        int dots = 0;
        int i = 0;
        while (i < ns.Length) {
            int ch = (int)ns[i];
            if (ch == 46) { dots = dots + 1; if (dots == 2) { return ns.Substring(0, i); } }
            i = i + 1;
        }
        return ns;
    }
    // The class along `cls`'s base chain that declares `name` (field, method
    // or property accessor); null when nobody does.
    Node OwnerUp(Node cls, string name) {
        Node c = cls;
        int cg = 0;
        while (c != null) {
            if (binder.FindField(c, name) != null || binder.FindMethod(c, name) != null || binder.FindMethod(c, "get_" + name) != null) { return c; }
            c = binder.FindType(c.sval2);
            cg = cg + 1;
            if (cg > 512) { c = null; }
        }
        return null;
    }
    void CheckInternalAccess(Node cls, string name, Node at) {
        if (cls == null || curClass == null) { return; }
        Node owner = OwnerUp(cls, name);
        if (owner == null || owner == curClass) { return; }
        Node m = binder.FindField(owner, name);
        if (m == null) { m = binder.FindMethod(owner, name); }
        if (m == null) { m = binder.FindMethod(owner, "get_" + name); }
        if (m == null || !HasMod(m, MOD.Internal())) { return; }
        string ons = owner.nsName != null ? owner.nsName : "";
        string cns = curClass.nsName != null ? curClass.nsName : "";
        if (ModuleOf(ons) == ModuleOf(cns)) { return; }
        string from = cns != "" ? cns : curClass.sval;
        diags.Error("'" + owner.sval + "." + name + "' is internal to '" + ons + "' and cannot be accessed from '" + from + "'", at.line, at.col);
    }
    // Receiver written as a bare type name (`Core.Tag()` / `Core.count`): the
    // checker cannot infer it as a value, so resolve it as a type for the
    // visibility check only -- member existence on static receivers stays
    // with irgen (unresolved call), exactly as before.
    Node StaticRecv(Node a) {
        if (a == null || a.kind != AK.Ident() || curClass == null) { return null; }
        if (ScopeHas(a.sval) || FieldUp(curClass, a.sval) != null || MethodUp(curClass, "get_" + a.sval) != null) { return null; }
        Node sc = binder.FindType(a.sval);
        if (sc != null && (sc.kind == AK.ClassDecl() || sc.kind == AK.StructDecl())) { return sc; }
        return null;
    }

    // ---- Task / Task<T>: the C host's builtin task handle (TYPE_TASK) ----
    // A bare `Task` is a handle that carries NO result (the frame is released
    // by the completion path), `Task<T>` a handle that carries one (the
    // reader releases it). The host models both with one builtin type
    // (binder.c: zan_binder_make_task_type); the self-hosted checker has to
    // know the same names, or every Task-typed declaration is rejected with
    // the bogus "unknown type 'Task'".
    Node MkTaskType(Node elem) {
        Node t = MkType("Task");
        if (elem != null) { t.Add(elem); t.a = elem; }
        return t;
    }
    bool IsTaskTy(Node t) { return t != null && t.sval == "Task"; }
    // The element type of a Task-shaped return: `Task<T>` -> T, a bare `Task`
    // -> void (no result).
    Node TaskElemTy(Node t) {
        if (!IsTaskTy(t)) { return t; }
        if (t.kids.Count == 1) { return t.kids[0]; }
        return MkType("void");
    }
    string TaskTyName(Node t) {
        if (!IsTaskTy(t)) { return "?"; }
        if (t.kids.Count == 0) { return "Task"; }
        return "Task<" + t.kids[0].sval + ">";
    }

    // The name the C host prints for a type. The shape comes along: a
    // nullable is 'T?' (A463 -- the host renders the type's shape in every
    // diagnostic, so 'bool?' is never reported as 'bool') and a Task-shaped
    // type keeps its type argument ('Task<double>').
    string TyDisplay(Node t) {
        if (t == null) { return "?"; }
        if (IsTaskTy(t)) { return TaskTyName(t); }
        if (t.op == 1) { return t.sval + "?"; }
        return t.sval;
    }

    // ---- lexical scope ----
    int ScopeMark() { return scopeName.Count; }
    void ScopeTrim(int to) {
        List<string> nn = new List<string>();
        List<Node> nt = new List<Node>();
        int i = 0;
        while (i < to) { nn.Add(scopeName[i]); nt.Add(scopeType[i]); i = i + 1; }
        scopeName = nn; scopeType = nt;
    }
    void ScopeAdd(string name, Node ty) {
        if (name != "") { scopeName.Add(name); scopeType.Add(ty); }
    }
    int ScopeIdx(string name) {
        int i = scopeName.Count - 1;
        while (i >= 0) { if (scopeName[i] == name) { return i; } i = i - 1; }
        return -1;
    }
    bool ScopeHas(string name) { return ScopeIdx(name) >= 0; }

    // ---- type-directed lookup, walking base classes ----
    Node FieldUp(Node cls, string name) {
        Node c = cls;
        int cg = 0;
        while (c != null) {
            Node f = binder.FindField(c, name);
            if (f != null) { return f; }
            if (c.interfaces != null) {
                int ii = 0;
                while (ii < c.interfaces.Count) {
                    string iname = c.interfaces[ii];
                    int ilt = iname.IndexOf("<");
                    string baseIf = ilt > 0 ? iname.Substring(0, ilt) : iname;
                    Node iface = binder.FindType(baseIf);
                    if (iface != null) {
                        Node ifld = FieldUp(iface, name);
                        if (ifld != null) { return ifld; }
                    }
                    ii = ii + 1;
                }
            }
            c = binder.FindType(c.sval2);
            cg = cg + 1;
            if (cg > 512) { c = null; }
        }
        return null;
    }
    Node MethodUp(Node cls, string name) {
        Node c = cls;
        int cg = 0;
        while (c != null) {
            Node m = binder.FindMethod(c, name);
            if (m != null) { return m; }
            if (c.interfaces != null) {
                int ii = 0;
                while (ii < c.interfaces.Count) {
                    string iname = c.interfaces[ii];
                    int ilt = iname.IndexOf("<");
                    string baseIf = ilt > 0 ? iname.Substring(0, ilt) : iname;
                    Node iface = binder.FindType(baseIf);
                    if (iface != null) {
                        Node im = MethodUp(iface, name);
                        if (im != null) { return im; }
                    }
                    ii = ii + 1;
                }
            }
            c = binder.FindType(c.sval2);
            cg = cg + 1;
            if (cg > 512) { c = null; }
        }
        return null;
    }
    // A field, method or property accessor named `name`, up the base chain.
    bool HasMember(Node cls, string name) {
        if (FieldUp(cls, name) != null) { return true; }
        if (MethodUp(cls, name) != null) { return true; }
        if (MethodUp(cls, "get_" + name) != null) { return true; }
        if (MethodUp(cls, "set_" + name) != null) { return true; }
        if (name == "ToString" || name == "Equals" || name == "GetHashCode") { return true; }
        return false;
    }

    // An extension method `name` whose `this` receiver matches type `tyName`.
    bool HasExt(string tyName, string name) {
        List<string> owner = new List<string>();
        return binder.FindExtension(tyName, name, owner) != null;
    }

    bool AcceptsExtArgc(string tyName, string name, int argc) {
        List<Node> extMs = new List<Node>();
        List<string> extOwners = new List<string>();
        binder.FindExtensionAll(tyName, name, extMs, extOwners);
        int i = 0;
        while (i < extMs.Count) {
            if (AcceptsArgcOf(extMs[i], argc)) { return true; }
            i = i + 1;
        }
        return false;
    }

    // The user class/struct declaration a type refers to, or null.
    Node ClassOf(Node t) {
        if (t == null) { return null; }
        // an array type carries the ELEMENT's name with the rank in `ival`:
        // the element's members are not the array's members (`pts.Length` is
        // the array's own, `pts.Foo` is not `Point`'s either)
        if (t.ival >= 1) { return null; }
        Node d = binder.FindType(t.sval);
        if (d != null && (d.kind == AK.ClassDecl() || d.kind == AK.StructDecl())) { return d; }
        if (t.sval == "Exception" || t.sval == "InvalidCastException"
            || t.sval == "FormatException" || t.sval == "OverflowException"
            || t.sval == "IndexOutOfRangeException" || t.sval == "DivideByZeroException"
            || t.sval == "NullReferenceException") {
            Node syn = new Node(AK.ClassDecl());
            syn.sval = t.sval;
            if (t.sval != "Exception") { syn.sval2 = "Exception"; }
            return syn;
        }
        return null;
    }

    // ---- typed data access: recv.<Entity> ("tables as properties") ----
    //
    // Mirror of the C host's checker_try_entity_accessor family
    // (checker.c ~5258, B-ID63 selfhost half): a [Table] class turns
    // `recv.<Entity>` into a plain member access whose lookup misses, and
    // the checker then degrades the member node IN PLACE into a new
    // expression -- `new <Entity>Dao(conn)` when the Dao has a single
    // connection-assignable constructor parameter, otherwise
    // `new BaseRepository<Entity>(ZanSql.FromConnection(conn))` (the one
    // construction seam between the compiler and Zan.Data). Call position
    // needs no separate hook: `db.User.Read(id)` checks its callee's
    // object through InferType in VALUE position, so the inner access is
    // rewritten there and `.Read` binds on the synthesized repository.

    int ParamCountOf(Node m) {
        int n = 0;
        int i = 0;
        while (i < m.kids.Count) { if (m.kids[i].kind == AK.Param()) { n = n + 1; } i = i + 1; }
        return n;
    }
    Node FirstParamOf(Node m) {
        int i = 0;
        while (i < m.kids.Count) { if (m.kids[i].kind == AK.Param()) { return m.kids[i]; } i = i + 1; }
        return null;
    }
    Node NthParamType(Node m, int idx) {
        if (m == null) { return null; }
        if (m.ival == 1) { idx = idx + 1; }
        int cur = 0;
        int i = 0;
        while (i < m.kids.Count) {
            if (m.kids[i].kind == AK.Param()) {
                if (cur == idx) { return m.kids[i].type; }
                cur = cur + 1;
            }
            i = i + 1;
        }
        return null;
    }

    Node CopyTypeNode(Node t) {
        if (t == null) { return null; }
        Node n = new Node(t.kind);
        n.sval = t.sval; n.op = t.op; n.ival = t.ival; n.sval2 = t.sval2;
        n.line = t.line; n.col = t.col; n.mods = t.mods;
        int i = 0;
        while (i < t.kids.Count) { n.Add(CopyTypeNode(t.kids[i])); i = i + 1; }
        return n;
    }

    Node SubstType(Node t, List<string> names, List<Node> reps) {
        if (t == null) { return null; }
        if (t.ival >= 1) {
            Node el = new Node(AK.TypeRef());
            el.sval = t.sval;
            Node se = SubstType(el, names, reps);
            if (se == null) { return t; }
            Node r = CopyTypeNode(se);
            r.ival = t.ival;
            return r;
        }
        if (t.kids.Count == 0) {
            int i = 0;
            while (i < names.Count) {
                if (names[i] == t.sval) { return CopyTypeNode(reps[i]); }
                i = i + 1;
            }
            return t;
        }
        Node n = CopyTypeNode(t);
        n.kids = new List<Node>();
        int ki = 0;
        while (ki < t.kids.Count) {
            n.kids.Add(SubstType(t.kids[ki], names, reps));
            ki = ki + 1;
        }
        return n;
    }

    Node SubstTypeParams(Node t, Node cls, Node ot) {
        if (t == null || cls == null || ot == null || ot.kids.Count == 0) { return t; }
        List<string> names = new List<string>();
        List<Node> reps = new List<Node>();
        int pi = 0;
        int i = 0;
        while (i < cls.kids.Count) {
            if (cls.kids[i].kind == AK.TypeParam()) {
                if (pi < ot.kids.Count) {
                    names.Add(cls.kids[i].sval);
                    reps.Add(ot.kids[pi]);
                    pi = pi + 1;
                }
            }
            i = i + 1;
        }
        if (names.Count == 0) { return t; }
        return SubstType(t, names, reps);
    }

    Node SubstMethodTypeParams(Node t, Node m, Node call) {
        if (t == null || m == null || call == null || call.d == null) { return t; }
        if (call.d.kind != AK.TypeRef() || call.d.sval != "__typeargs") { return t; }
        List<string> names = new List<string>();
        List<Node> reps = new List<Node>();
        int pi = 0;
        int i = 0;
        while (i < m.kids.Count) {
            if (m.kids[i].kind == AK.TypeParam()) {
                if (pi < call.d.kids.Count) {
                    names.Add(m.kids[i].sval);
                    reps.Add(call.d.kids[pi]);
                    pi = pi + 1;
                }
            }
            i = i + 1;
        }
        if (names.Count == 0) { return t; }
        return SubstType(t, names, reps);
    }
    bool AccAlreadyReported(Node n) {
        if (accReported == null) { return false; }
        int i = 0;
        while (i < accReported.Count) { if (accReported[i] == n) { return true; } i = i + 1; }
        return false;
    }

    // a [Table] entity class under `name` (leading upper case, bounded
    // length -- the host's checker_is_table_entity guards)
    bool IsTableEntity(string name) {
        if (name == null || name.Length == 0 || name.Length > 100) { return false; }
        if (name[0] < 'A' || name[0] > 'Z') { return false; }
        Node d = binder.FindType(name);
        if (d == null || (d.kind != AK.ClassDecl() && d.kind != AK.StructDecl())) { return false; }
        return d.attrTable;
    }

    // a value of this type may flow into a connection slot: it IS (or
    // implements) IDbConnection/IDbExecutor (the host's checker_recv_is_conn)
    bool RecvIsConn(Node t) {
        if (t == null || t.sval == null || t.sval == "") { return false; }
        if (t.sval == "IDbConnection" || t.sval == "IDbExecutor") { return true; }
        return binder.IsAssignableFrom("IDbConnection", t.sval)
            || binder.IsAssignableFrom("IDbExecutor", t.sval);
    }

    // a connection value fits the constructor parameter (interface params
    // judge by implementation -- the host's checker_conn_fits_param)
    bool ConnFitsParam(string connTy, string paramTy) {
        if (connTy == null || paramTy == null) { return false; }
        if (connTy == paramTy) { return true; }
        return binder.IsAssignableFrom(paramTy, connTy);
    }

    // in-place degradation: the member node becomes a new expression.
    // Member access and new_expr share the one node's fields -- everything
    // needed from the member side is taken BEFORE the kind flip (the
    // host's checker_emit_accessor_new).
    void EmitAccessorNew(Node n, Node ty, Node arg) {
        n.kind = AK.NewExpr();
        n.type = ty;
        n.b = null;
        n.kids = new List<Node>();
        n.Add(arg);
        n.ival = 0;
        n.op = 1;          // paren-arg count, same convention as the parser
        n.sval2 = "";
        n.d = null;
        n.arrRanks = "";
    }

    // the synthesis itself. Returns true when the accessor applies: the
    // node was rewritten (or the host's E2095 was reported). False = not
    // an accessor; the caller reports its own no-member diagnostic.
    bool TryEntityAccessor(Node n, Node ot) {
        if (n == null || n.kind != AK.MemberAccess() || n.a == null) { return false; }
        if (!IsTableEntity(n.sval)) { return false; }
        // ② the receiver must yield a connection: itself (or implements)
        // IDbConnection/IDbExecutor, or its class declares a zero-arg
        // __Conn() whose return is connection-assignable
        Node connNode = null;
        string connTy = null;
        if (RecvIsConn(ot)) {
            connNode = n.a;
            connTy = ot.sval;
        } else {
            Node cls = ClassOf(ot);
            Node cm = cls != null ? MethodUp(cls, "__Conn") : null;
            if (cm != null && cm.type != null && ParamCountOf(cm) == 0 && RecvIsConn(cm.type)) {
                Node mc = new Node(AK.MemberAccess());
                mc.a = n.a;
                mc.sval = "__Conn";
                mc.line = n.line; mc.col = n.col;
                Node call = new Node(AK.Call());
                call.a = mc;
                call.line = n.line; call.col = n.col;
                connNode = call;
                connTy = cm.type.sval;
            }
        }
        if (connNode == null) { return false; }

        // ③ <Entity>Dao declared with a single connection-assignable
        // constructor parameter: use it. The synthesized call is compiler
        // trusted code -- no access check, same treatment as the host.
        string daoName = n.sval + "Dao";
        Node dao = binder.FindType(daoName);
        if (dao != null && (dao.kind == AK.ClassDecl() || dao.kind == AK.StructDecl())) {
            Node ctor = binder.FindCtorArity(dao, 1);
            if (ctor != null) {
                Node p0 = FirstParamOf(ctor);
                if (p0 != null && p0.type != null && ConnFitsParam(connTy, p0.type.sval)) {
                    EmitAccessorNew(n, MkType(daoName), connNode);
                    return true;
                }
            }
            // the host's E2095, fired once per node: InferType re-runs on
            // the same node many times, and an unrewritten member node
            // would re-enter the synthesis forever
            if (!AccAlreadyReported(n)) {
                diags.Error("'" + n.sval + "' accessor needs a single-parameter constructor on '"
                    + daoName + "' taking the connection", n.line, n.col);
                if (accReported == null) { accReported = new List<Node>(); }
                accReported.Add(n);
            }
            return true;
        }

        // fallback: BaseRepository<Entity>(ZanSql.FromConnection(conn))
        Node baseCls = binder.FindType("BaseRepository");
        if (baseCls == null
                || (baseCls.kind != AK.ClassDecl() && baseCls.kind != AK.StructDecl())) {
            return false;
        }
        Node zid = new Node(AK.Ident());
        zid.sval = "ZanSql";
        zid.line = n.line; zid.col = n.col;
        Node zc = new Node(AK.MemberAccess());
        zc.a = zid;
        zc.sval = "FromConnection";
        zc.line = n.line; zc.col = n.col;
        Node zcall = new Node(AK.Call());
        zcall.a = zc;
        zcall.line = n.line; zcall.col = n.col;
        zcall.Add(connNode);
        Node bt = MkType("BaseRepository");
        bt.Add(MkType(n.sval));
        EmitAccessorNew(n, bt, zcall);
        return true;
    }

    // new Meta[] { Meta.For<E1>(), ... }: the synthesized second argument
    // of a zero-arg SyncStructureAll(Async) (the host's
    // checker_synthesize_table_array; same synthetic shape as
    // ZanSql.FromConnection, plus explicit type args on the calls)
    Node SynthTableArray(Node at) {
        Node arr = new Node(AK.NewExpr());
        arr.ival = 1;
        arr.type = MkType("Meta");
        arr.arrRanks = "1";
        arr.line = at.line; arr.col = at.col;
        int i = 0;
        while (i < binder.types.Count) {
            Node d = binder.types[i];
            if ((d.kind == AK.ClassDecl() || d.kind == AK.StructDecl()) && d.attrTable) {
                Node zid = new Node(AK.Ident());
                zid.sval = "Meta";
                zid.line = at.line; zid.col = at.col;
                Node mc = new Node(AK.MemberAccess());
                mc.a = zid;
                mc.sval = "For";
                mc.line = at.line; mc.col = at.col;
                Node call = new Node(AK.Call());
                call.a = mc;
                call.line = at.line; call.col = at.col;
                Node ta = MkType("__typeargs");
                ta.Add(MkType(d.sval));
                call.d = ta;
                arr.Add(call);
            }
            i = i + 1;
        }
        return arr;
    }

    bool IsEnumMember(string name) {
        int i = 0;
        while (i < binder.types.Count) {
            Node t = binder.types[i];
            if (t.kind == AK.EnumDecl()) {
                int j = 0;
                while (j < t.kids.Count) {
                    Node m = t.kids[j];
                    if (m.kind == AK.EnumMember() && m.sval == name) { return true; }
                    j = j + 1;
                }
            }
            i = i + 1;
        }
        return false;
    }

    bool KnownValue(string name) {
        if (name == "") { return true; }
        if (name == "value") { return true; }
        if (ScopeHas(name)) { return true; }
        // a bare name may be a field, a method or a property (the parser
        // desugars a property into get_Name / set_Name accessors): the C
        // host resolves all three against the enclosing type
        if (HasMember(curClass, name)) { return true; }
        if (binder.IsPrimitive(name)) { return true; }
        if (binder.IsBuiltinGeneric(name)) { return true; }
        if (binder.IsBuiltinClass(name)) { return true; }
        if (binder.IsTypeParam(name)) { return true; }
        if (binder.FindType(name) != null) { return true; }
        if (IsEnumMember(name)) { return true; }
        return false;
    }

    bool IsOpenGenericScope() {
        if (curClass != null) {
            int i = 0;
            while (i < curClass.kids.Count) {
                if (curClass.kids[i].kind == AK.TypeParam()) { return true; }
                i = i + 1;
            }
        }
        if (curMethodNode != null) {
            int j = 0;
            while (j < curMethodNode.kids.Count) {
                if (curMethodNode.kids[j].kind == AK.TypeParam()) { return true; }
                j = j + 1;
            }
        }
        return false;
    }

    // ---- overload arity ----
    // The overload of `name` a call reaches. The candidates are the whole
    // class chain; the C host resolves an overload by the argument types
    // (the backend scores the candidates the same way -- irgen_stmt.zan's
    // ScoreCand), so the checker has to pick the same one: the argument
    // COUNT alone cannot tell `Description()` from `Description(string)`,
    // and it cannot tell `OnMessage(MessageHandler)` from
    // `OnMessage(string)` either -- only the argument type can.
    Node MethodUpCall(Node cls, string name, Node call) {
        if (cls == null) { return null; }
        List<Node> cands = new List<Node>();
        Node c = cls;
        int cg4 = 0;
        while (c != null) {
            int i = 0;
            while (i < c.kids.Count) {
                Node m = c.kids[i];
                if (m.kind == AK.MethodDecl() && m.sval == name) { cands.Add(m); }
                i = i + 1;
            }
            c = binder.FindType(c.sval2);
            cg4 = cg4 + 1;
            if (cg4 > 512) { c = null; }
        }
        int argc = 0;
        if (call != null) { argc = call.kids.Count; }
        List<Node> fit = new List<Node>();
        int i = 0;
        while (i < cands.Count) {
            if (AcceptsArgcOf(cands[i], argc)) { fit.Add(cands[i]); }
            i = i + 1;
        }
        if (fit.Count > 0) {
            if (fit.Count == 1) { return fit[0]; }
            Node pick = fit[0];
            int best = CallScore(fit[0], call);
            i = 1;
            while (i < fit.Count) {
                int s = CallScore(fit[i], call);
                if (s > best) { best = s; pick = fit[i]; }
                i = i + 1;
            }
            return pick;
        }
        if (cls.interfaces != null) {
            int ii = 0;
            while (ii < cls.interfaces.Count) {
                string iname = cls.interfaces[ii];
                int ilt = iname.IndexOf("<");
                string baseIf = ilt > 0 ? iname.Substring(0, ilt) : iname;
                Node iface = binder.FindType(baseIf);
                if (iface != null) {
                    Node im = MethodUpCall(iface, name, call);
                    if (im != null && AcceptsArgcOf(im, argc)) { return im; }
                }
                ii = ii + 1;
            }
        }
        List<Node> extMs = new List<Node>();
        List<string> extOwners = new List<string>();
        binder.FindExtensionAll(cls.sval, name, extMs, extOwners);
        int ei = 0;
        while (ei < extMs.Count) {
            if (AcceptsArgcOf(extMs[ei], argc)) { fit.Add(extMs[ei]); }
            ei = ei + 1;
        }
        if (fit.Count > 0) {
            if (fit.Count == 1) { return fit[0]; }
            Node pick = fit[0];
            int best = CallScore(fit[0], call);
            int k = 1;
            while (k < fit.Count) {
                int s = CallScore(fit[k], call);
                if (s > best) { best = s; pick = fit[k]; }
                k = k + 1;
            }
            return pick;
        }
        if (cands.Count > 0) { return cands[0]; }
        return null;
    }
    // How well the candidate's parameter types match the call's arguments:
    // +4 for an exact type match, -1 for a known mismatch (an implicit
    // conversion may still apply, so a mismatch only ranks the candidate
    // lower). Unknown types are neutral.
    int CallScore(Node cand, Node call) {
        if (cand == null || call == null) { return 0; }
        int score = 0;
        int a = 0;
        while (a < call.kids.Count) {
            Node p = ParamAtNode(cand, a);
            if (p == null) { break; }
            Node pty = p.type;
            Node arg = call.kids[a];
            if (arg != null && arg.kind == AK.Lambda()) {
                if (IsTreeLambda(arg)) {
                    if (pty != null && (pty.sval == "ExprNode" || pty.sval == "System.Linq.ExprNode"
                        || pty.sval == "Expr" || pty.sval == "System.Linq.Expr"
                        || pty.sval.StartsWith("Expr<") || pty.sval.StartsWith("System.Linq.Expr<"))) {
                        score = score + 12;
                    } else if (pty != null && (pty.sval.StartsWith("Func") || pty.sval.StartsWith("Action") || binder.IsDelegateName(pty.sval))) {
                        score = score - 20;
                    }
                    a = a + 1;
                    continue;
                }
                if (pty != null && (pty.sval.StartsWith("Func") || pty.sval.StartsWith("Action")
                    || pty.sval.StartsWith("Predicate") || binder.IsDelegateName(pty.sval))) {
                    score = score + 8;
                    if (pty.sval == "Func" && pty.kids.Count > 0 && arg.a != null) {
                        Node retType = pty.kids[pty.kids.Count - 1];
                        Node lrt = InferType(arg.a);
                        if (lrt != null && lrt.sval == retType.sval) { score = score + 4; }
                    }
                } else if (pty != null && (pty.sval == "ExprNode" || pty.sval.StartsWith("Expr"))) {
                    score = score + 2;
                } else if (pty != null && (pty.sval == "string" || PrimCat(pty.sval) != 0)) {
                    score = score - 10;
                }
            } else {
                Node aty = InferType(arg);
                if (pty != null && aty != null && pty.sval != "" && aty.sval != "") {
                    if (pty.sval == aty.sval) { score = score + 4; }
                    else {
                        int pc2 = PrimCat(pty.sval);
                        int ac2 = PrimCat(aty.sval);
                        if (pc2 != 0 && ac2 != 0 && pc2 != ac2) { score = score - 1; }
                    }
                }
            }
            a = a + 1;
        }
        return score;
    }
    // The n-th parameter of a method declaration.
    Node ParamAtNode(Node m, int idx) {
        int n = 0;
        int i = 0;
        while (i < m.kids.Count) {
            if (m.kids[i].kind == AK.Param()) {
                if (n == idx) { return m.kids[i]; }
                n = n + 1;
            }
            i = i + 1;
        }
        return null;
    }
    // Does this one method take `argc` positional arguments? A `params` tail
    // takes the arguments the fixed parameters do not.
    bool AcceptsArgcOf(Node m, int argc) {
        int tot = 0; int req = 0; int j = 0;
        Node lastP = null;
        while (j < m.kids.Count) {
            if (m.kids[j].kind == AK.Param()) {
                tot = tot + 1;
                if (m.kids[j].b == null) { req = req + 1; }
                lastP = m.kids[j];
            }
            j = j + 1;
        }
        if (m.ival == 1) {
            tot = tot - 1;
            req = req - 1;
            if (req < 0) { req = 0; }
        }
        if (argc >= req && argc <= tot) { return true; }
        if (lastP != null && lastP.op == 1 && argc >= req - 1) { return true; }
        if ((m.mods & MOD.Variadic()) != 0 && argc >= req) { return true; }
        return false;
    }
    // True if some method named `name` (up the base chain) can accept `argc`
    // positional arguments, or if any candidate is an extension method (whose
    // receiver shifts the count) -- in which case we do not second-guess it.
    bool AcceptsArgc(Node cls, string name, int argc) {
        Node c = cls;
        int cg3 = 0;
        while (c != null) {
            int i = 0;
            while (i < c.kids.Count) {
                Node m = c.kids[i];
                if (m.kind == AK.MethodDecl() && m.sval == name) {
                    if (m.ival == 1) { return true; }
                    int tot = 0; int req = 0;
                    Node lastP = null;
                    int j = 0;
                    while (j < m.kids.Count) {
                        if (m.kids[j].kind == AK.Param()) {
                            tot = tot + 1;
                            if (m.kids[j].b == null) { req = req + 1; }
                            lastP = m.kids[j];
                        }
                        j = j + 1;
                    }
                    if (argc >= req && argc <= tot) { return true; }
                    // `params T[]` tail accepts any argc >= fixed params
                    if (lastP != null && lastP.op == 1 && argc >= req - 1) { return true; }
                    if ((m.mods & MOD.Variadic()) != 0 && argc >= req) { return true; }
                }
                i = i + 1;
            }
            if (c.interfaces != null) {
                int ii = 0;
                while (ii < c.interfaces.Count) {
                    string iname = c.interfaces[ii];
                    int ilt = iname.IndexOf("<");
                    string baseIf = ilt > 0 ? iname.Substring(0, ilt) : iname;
                    Node iface = binder.FindType(baseIf);
                    if (iface != null && AcceptsArgc(iface, name, argc)) {
                        return true;
                    }
                    ii = ii + 1;
                }
            }
            c = binder.FindType(c.sval2);
            cg3 = cg3 + 1;
            if (cg3 > 512) { c = null; }
        }
        return false;
    }

    bool IsValueType(Node t) {
        if (t == null) { return false; }
        string n = t.sval;
        int pc = PrimCat(n);
        if ((pc >= 1 && pc <= 3) || pc == 5 || pc == 6 || pc == 8) { return true; }
        Node d = binder.FindType(n);
        return d != null && (d.kind == AK.StructDecl() || d.kind == AK.EnumDecl());
    }

    Node LiftNullCondType(Node e, Node t) {
        if (t == null || t.op == 1) { return t; }
        Node m = null;
        if (e.kind == AK.MemberAccess()) { m = e; }
        else if (e.kind == AK.Call() && e.a != null && e.a.kind == AK.MemberAccess()) { m = e.a; }
        if (m == null || m.ival != 1) { return t; }
        if (!IsValueType(t)) { return t; }
        Node nt = MkType(t.sval);
        nt.op = 1;
        nt.ival = t.ival;
        nt.kids = t.kids;
        return nt;
    }

    public void Check(Node unit) {
        int i = 0;
        while (i < unit.kids.Count) {
            Node d = unit.kids[i];
            if (d.kind == AK.ClassDecl() || d.kind == AK.StructDecl()) { CheckClass(d); }
            i = i + 1;
        }
    }

    void CheckClass(Node cls) {
        curClass = cls;
        if (cls.sval2 != "") {
            if (binder.FindType(cls.sval2) == null) {
                diags.Error("undefined base type '" + cls.sval2 + "'", cls.baseLine, cls.baseCol);
            }
        }
        if (cls.interfaces != null) {
            int ii = 0;
            while (ii < cls.interfaces.Count) {
                string iname = cls.interfaces[ii];
                int ilt = iname.IndexOf("<");
                string baseIf = ilt > 0 ? iname.Substring(0, ilt) : iname;
                if (baseIf != "" && binder.FindType(baseIf) == null && !binder.IsBuiltinGeneric(baseIf)) {
                    diags.Error("undefined base type '" + iname + "'", cls.line, cls.col);
                }
                ii = ii + 1;
            }
        }
        int i = 0;
        while (i < cls.kids.Count) {
            Node m = cls.kids[i];
            if (m.kind == AK.FieldDecl()) { CheckType(m.type); }
            else if (m.kind == AK.MethodDecl()) { CheckMethod(m, false); }
            else if (m.kind == AK.CtorDecl()) { CheckMethod(m, true); }
            i = i + 1;
        }
        curClass = null;
    }

    void CheckMethod(Node m, bool ctor) {
        curMethodNode = m;
        if (m.type != null) { CheckSignatureType(m.type); }
        scopeName = new List<string>(); scopeType = new List<Node>();
        loopDepth = 0;
        catchDepth = 0;
        // An async method with a Task-shaped return type returns its RESULT,
        // not a handle: the C host's parser rewrites `async Task<T>` to `T`
        // and `async Task` to `void` (desugar_async_task_method) before the
        // checker runs, so the body is checked against the element type.
        Node bodyRet = m.type;
        if (!ctor && HasMod(m, MOD.Async()) && IsTaskTy(bodyRet)) {
            bodyRet = TaskElemTy(bodyRet);
        }
        curRet = bodyRet;
        curStatic = !ctor && HasMod(m, MOD.Static());
        int i = 0;
        while (i < m.kids.Count) {
            Node p = m.kids[i];
            if (p.kind == AK.Param()) {
                CheckSignatureType(p.type);
                if (ScopeHas(p.sval)) {
                    diags.Error("duplicate parameter '" + p.sval + "'", p.line, p.col);
                }
                ScopeAdd(p.sval, p.type);
            }
            i = i + 1;
        }
        CheckStmt(m.d);
        CheckAwaits(m);
        curMethodNode = null;
        // The C host has no "not all code paths return a value" diagnostic:
        // a method whose body falls through is legal there (the body may end
        // in a `lock`/`fixed`/`using` block the checker does not model, and
        // the irgen emits the default return for the fall-through path).
        // Reporting it here made the self-host refuse programs the host
        // accepts -- the host is the spec, so the check is gone.
    }

    // ---- await placement ----
    // An `await` inside a lambda is not lowered: the lambda is a separate
    // function, and in an async method the await would run the cooperative
    // scheduler from inside a running coroutine (reentrant scheduler). The
    // self-hosted backend has no async-lambda form, so report it.
    //
    // Note: an `await` in a *synchronous* method is fine -- the C host accepts
    // it too (the awaited coroutine is driven to completion by the scheduler
    // the self-hosted backend runs at that point). Only the *operand* has to
    // be a coroutine frame; that is checked where the await is lowered.
    void CheckAwaits(Node m) {
        if (m.d == null) { return; }
        if (!HasMod(m, MOD.Async())) { return; }
        Node lam = FindAwaitInLambda(m.d);
        if (lam != null) {
            diags.Error("'await' inside a lambda is not supported: " +
                "a lambda is not a coroutine", lam.line, lam.col);
        }
    }

    // the first `await` anywhere in the expression tree
    Node FindAwaitDeep(Node n) {
        if (n == null) { return null; }
        if (n.kind == AK.AwaitExpr()) { return n; }
        Node r = FindAwaitDeep(n.a); if (r != null) { return r; }
        r = FindAwaitDeep(n.b); if (r != null) { return r; }
        r = FindAwaitDeep(n.c); if (r != null) { return r; }
        r = FindAwaitDeep(n.d); if (r != null) { return r; }
        int i = 0;
        while (i < n.kids.Count) { r = FindAwaitDeep(n.kids[i]); if (r != null) { return r; } i = i + 1; }
        return null;
    }

    // the first `await` that sits inside a lambda (a lambda never has a frame)
    Node FindAwaitInLambda(Node n) {
        if (n == null) { return null; }
        if (n.kind == AK.AwaitExpr()) { return null; }
        if (n.kind == AK.Lambda()) {
            Node r = FindAwaitDeep(n.a); if (r != null) { return r; }
            r = FindAwaitDeep(n.d); if (r != null) { return r; }
            return null;
        }
        Node r = FindAwaitInLambda(n.a); if (r != null) { return r; }
        r = FindAwaitInLambda(n.b); if (r != null) { return r; }
        r = FindAwaitInLambda(n.c); if (r != null) { return r; }
        r = FindAwaitInLambda(n.d); if (r != null) { return r; }
        int i = 0;
        while (i < n.kids.Count) { r = FindAwaitInLambda(n.kids[i]); if (r != null) { return r; } i = i + 1; }
        return null;
    }

    // ---- statements ----
    void CheckStmt(Node n) {
        if (n == null) { return; }
        int k = n.kind;
        if (k == AK.Block()) {
            int mark = ScopeMark();
            int i = 0;
            while (i < n.kids.Count) { CheckStmt(n.kids[i]); i = i + 1; }
            ScopeTrim(mark);
            return;
        }
        if (k == AK.VarDecl()) {
            CheckType(n.type);
            Node prevTarget = curTargetType;
            curTargetType = n.type;
            if (n.type != null && binder.DelegateIsAsync(n.type.sval) && n.b != null && n.b.kind == AK.Lambda()) {
                diags.Error("[E3104] cannot convert a lambda to async delegate '" + n.type.sval
                    + "': a lambda is not a coroutine; assign an async method group instead", n.b.line, n.b.col);
            }
            CheckExpr(n.b);
            curTargetType = prevTarget;
            if (n.type != null) {
                // the C host points at the *type* of the declaration when it
                // reports a conversion failure there
                Node vt = InferType(n.b);
                CheckTaskNoResult(n.type, vt, "initializer", n.type.line, n.type.col);
                CheckTaskOnlyHandle(n.type, vt, "initializer", n.type.line, n.type.col);
                CheckNarrowing(n.type, n.b, vt, "initializer", n.type.line, n.type.col);
                CheckAssignable(n.type, vt, n.b != null && n.b.kind == AK.NullLit(),
                    "initializer", n.type.line, n.type.col);
            }
            Node ty = n.type;
            if (ty == null) { ty = InferType(n.b); }
            // annotate the AST with the inferred `var` type: the async
            // prescan snapshots slot types from the AST before the body is
            // emitted, so a `var d = 1.5` frame slot was int-typed while the
            // value is a double -- `store i64 1.5` and clang refused it
            if (n.type == null && ty != null) { n.type = ty; }
            ScopeAdd(n.sval, ty);
            int di = 0;
            while (di < n.kids.Count) {
                Node d = n.kids[di];
                Node prevDTarget = curTargetType;
                curTargetType = d.type;
                CheckExpr(d.b);
                curTargetType = prevDTarget;
                if (d.type != null) {
                    Node dv = InferType(d.b);
                    CheckTaskNoResult(d.type, dv, "initializer", d.type.line, d.type.col);
                    CheckTaskOnlyHandle(d.type, dv, "initializer", d.type.line, d.type.col);
                    CheckNarrowing(d.type, d.b, dv, "initializer", d.type.line, d.type.col);
                    CheckAssignable(d.type, dv, d.b != null && d.b.kind == AK.NullLit(),
                        "initializer", d.type.line, d.type.col);
                }
                Node dty = d.type;
                if (dty == null) { dty = InferType(d.b); }
                if (d.type == null && dty != null) { d.type = dty; }
                ScopeAdd(d.sval, dty);
                di = di + 1;
            }
            return;
        }
        if (k == AK.DeconDecl()) {
            CheckExpr(n.b);
            int i = 0;
            while (i < n.kids.Count) {
                Node p = n.kids[i];
                CheckType(p.type);
                ScopeAdd(p.sval, p.type);
                i = i + 1;
            }
            return;
        }
        if (k == AK.GotoStmt() || k == AK.LabelStmt()) { return; }
        if (k == AK.ExprStmt()) { CheckExpr(n.a); return; }
        if (k == AK.ReturnStmt()) {
            Node prevRetTarget = curTargetType;
            curTargetType = curRet;
            CheckExpr(n.a);
            curTargetType = prevRetTarget;
            // The C host has NEITHER "cannot return a value from a void method"
            // NOR "must return a value" (grep src/compiler: no such
            // diagnostic). `static void Main() { ...; return 0; }` is a
            // program the host compiles and runs; the self-host checker
            // used to refuse it, so the check is gone -- the host is the
            // spec.
            if (n.a != null && curRet != null) {
                Node rv = InferType(n.a);
                CheckTaskNoResult(curRet, rv, "return statement", n.line, n.col);
                CheckTaskOnlyHandle(curRet, rv, "return statement", n.line, n.col);
                CheckNarrowing(curRet, n.a, rv, "return statement", n.line, n.col);
                CheckAssignable(curRet, rv, n.a.kind == AK.NullLit(),
                    "return statement", n.line, n.col);
            }
            return;
        }
        if (k == AK.ThrowStmt()) {
            if (n.a == null) {
                // a bare `throw;` re-raises the exception the enclosing catch
                // clause caught -- outside a catch block it is an error (the
                // C host refuses it with the very same wording)
                if (catchDepth == 0) {
                    diags.Error("[E3086] a rethrow (`throw;`) is only valid inside a catch block",
                        n.line, n.col);
                }
                return;
            }
            CheckExpr(n.a);
            return;
        }
        if (k == AK.IfStmt()) {
            // A522-③ 自举半边：条件位置出现赋值（if (x = 1)）按宿主同口径
            // 编译期拒绝——赋值无布尔值，C# CS0029 硬错。
            if (n.a != null && n.a.kind == AK.Assignment()) {
                diags.Error("[E2073] assignment used as a condition (did you mean '=='? "
                    + "assignment (=) has no boolean value", n.a.line, n.a.col);
            }
            CheckExpr(n.a);
            int m1 = ScopeMark(); CheckStmt(n.b); ScopeTrim(m1);
            int m2 = ScopeMark(); CheckStmt(n.c); ScopeTrim(m2);
            return;
        }
        if (k == AK.WhileStmt()) {
            if (n.a != null && n.a.kind == AK.Assignment()) {
                diags.Error("[E2073] assignment used as a condition (did you mean '=='? "
                    + "assignment (=) has no boolean value", n.a.line, n.a.col);
            }
            CheckExpr(n.a);
            loopDepth = loopDepth + 1;
            int m = ScopeMark(); CheckStmt(n.b); ScopeTrim(m);
            loopDepth = loopDepth - 1;
            return;
        }
        if (k == AK.DoWhileStmt()) {
            loopDepth = loopDepth + 1;
            int m = ScopeMark(); CheckStmt(n.b); ScopeTrim(m);
            loopDepth = loopDepth - 1;
            if (n.a != null && n.a.kind == AK.Assignment()) {
                diags.Error("[E2073] assignment used as a condition (did you mean '=='? "
                    + "assignment (=) has no boolean value", n.a.line, n.a.col);
            }
            CheckExpr(n.a);
            return;
        }
        if (k == AK.ForStmt()) {
            int mark = ScopeMark();
            CheckStmt(n.a);
            CheckExpr(n.b);
            CheckExpr(n.c);
            loopDepth = loopDepth + 1;
            CheckStmt(n.d);
            loopDepth = loopDepth - 1;
            ScopeTrim(mark);
            return;
        }
        if (k == AK.ForeachStmt()) {
            int mark = ScopeMark();
            CheckType(n.type);
            CheckExpr(n.b);
            Node et = n.type;
            if (et == null) {
                Node ct = InferType(n.b);
                if (ct != null && ct.sval == "List" && ct.kids.Count > 0) { et = ct.kids[0]; }
            }
            ScopeAdd(n.sval, et);
            loopDepth = loopDepth + 1;
            CheckStmt(n.c);
            loopDepth = loopDepth - 1;
            ScopeTrim(mark);
            return;
        }
        if (k == AK.BreakStmt() || k == AK.ContinueStmt()) {
            if (loopDepth == 0) {
                diags.Error("break/continue outside of loop or switch", n.line, n.col);
            }
            return;
        }
        if (k == AK.SwitchStmt()) {
            CheckExpr(n.a);
            loopDepth = loopDepth + 1;
            int i = 0;
            while (i < n.kids.Count) {
                Node c = n.kids[i];
                // A pattern case (`case T x [when g]:`, `case null:`) binds x in
                // the case's own scope: the guard and the body both see it.
                // A constant case carries its label in `a`.
                int m = ScopeMark();
                if (c.ival == 1) {
                    if (c.type != null) { CheckType(c.type); }
                    if (c.sval != null && c.sval != "") { ScopeAdd(c.sval, c.type); }
                    CheckExpr(c.c);
                } else {
                    CheckExpr(c.a);
                }
                CheckStmt(c.b);
                ScopeTrim(m);
                i = i + 1;
            }
            loopDepth = loopDepth - 1;
            return;
        }
        if (k == AK.TryStmt()) {
            int m1 = ScopeMark(); CheckStmt(n.a); ScopeTrim(m1);
            Node cc = n.b;
            while (cc != null) {
                CheckType(cc.type);
                int m2 = ScopeMark();
                ScopeAdd(cc.sval, cc.type);
                catchDepth = catchDepth + 1;
                CheckStmt(cc.a);
                catchDepth = catchDepth - 1;
                ScopeTrim(m2);
                cc = cc.b;
            }
            int m3 = ScopeMark(); CheckStmt(n.c); ScopeTrim(m3);
            return;
        }
    }

    // ---- expressions ----
    // The object of a member access / callee of a call is not flagged as an
    // undefined identifier: it may name a stdlib type or namespace.
    void CheckObj(Node n) {
        if (n == null) { return; }
        if (n.kind == AK.Ident()) { return; }
        CheckExpr(n);
    }

    bool TypeParamHasNew(string name) {
        if (curMethodNode != null) {
            int i = 0;
            while (i < curMethodNode.kids.Count) {
                Node k = curMethodNode.kids[i];
                if (k.kind == AK.TypeParam() && k.sval == name && k.ival == 1) { return true; }
                i = i + 1;
            }
        }
        if (curClass != null) {
            int i = 0;
            while (i < curClass.kids.Count) {
                Node k = curClass.kids[i];
                if (k.kind == AK.TypeParam() && k.sval == name && k.ival == 1) { return true; }
                i = i + 1;
            }
        }
        return false;
    }

}
