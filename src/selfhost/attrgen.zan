using System;
using System.Collections.Generic;
namespace Zan;

// __AttrRoutes synthesis — native port of the oracle's System.Compiler.GenRoute
// (stdlib System/Compiler/GenRoute.zan): scan controller-shaped classes in the
// unit and synthesize one async HttpContext trampoline per public action plus
// one app.Map(...) registration chain carrying method/path/name/metadata and
// parameter documentation, all inside a generated __AttrRoutes class spliced
// into the unit before QualifyTypes.
//
// Deliberate differences from the oracle: route metadata arrives through the
// parser's attrWeb capture (name=constant attribute arguments evaluated at
// parse time), so attribute classes declared in the unit contribute no
// property defaults and positional attribute arguments are not mapped through
// ctor assigns — no test surface uses either. Input-call discovery walks the
// action body AST instead of genmeta's call list. Emitted text matches the
// oracle otherwise.
public class AttrGen {
    Diags diags;
    List<Node> classes;        // unit classes/structs in declaration order
    List<string> cnames;

    // attrWeb unpack slots for the declaration being inspected
    string dRoute;
    string dVerb;
    string dDesc;
    string dFlags;
    List<string> dOpts;
    List<string> dMeta;

    // merged route metadata (prop -> kind/sval; kind 0 int 1 bool 2 str 3 enum)
    List<int> MetaKind;
    List<string> MetaVal;
    List<string> MetaOrder;

    // parameter docs for the action being registered
    List<string> PName;
    List<string> PType;
    List<bool> PRequired;
    List<string> PDef;
    List<string> PDesc;
    List<string> PWhere;

    // reader description (GenRoute.ReaderFor outputs)
    string RType;
    bool RRequired;
    bool RHasDefault;
    bool RHasLabel;
    string RWhere;

    Dict<string, string> routeKeys;

    public AttrGen() {
        classes = new List<Node>();
        cnames = new List<string>();
        routeKeys = new Dict<string, string>();
    }

    // entry: scan all controllers, synthesize __AttrRoutes; "" when the unit
    // declares no routes
    public string Run(Node unit, Diags d) {
        diags = d;
        classes = new List<Node>();
        cnames = new List<string>();
        routeKeys = new Dict<string, string>();
        int i = 0;
        while (i < unit.kids.Count) {
            Node k = unit.kids[i];
            if (k.kind == AK.ClassDecl() || k.kind == AK.StructDecl()) {
                classes.Add(k);
                cnames.Add(k.sval);
            }
            i = i + 1;
        }
        StringBuilder handlers = new StringBuilder();
        StringBuilder reg = new StringBuilder();
        int nroutes = 0;
        i = 0;
        while (i < classes.Count) {
            Node cls = classes[i];
            if (IsController(cls)) {
                nroutes = nroutes + GenController(cls, handlers, reg);
            }
            i = i + 1;
        }
        if (nroutes == 0) { return ""; }
        StringBuilder out0 = new StringBuilder();
        out0.Append("class __AttrRoutes {\n");
        out0.Append(handlers.ToString());
        out0.Append("    static void Register(WebApp app) {\n");
        out0.Append(reg.ToString());
        out0.Append("    }\n}\n");
        return out0.ToString();
    }

    /* ---- string helpers ---- */

    // escape into a Zan string literal body (rg_put_qstr: backslash, quote,
    // LF, CR, TAB escaped; everything else verbatim)
    string Esc(string s) {
        StringBuilder b = new StringBuilder();
        int n = s.Length;
        for (int i = 0; i < n; i = i + 1) {
            string ch = s.Substring(i, 1);
            if (ch == "\\") { b.Append("\\\\"); }
            else if (ch == "\"") { b.Append("\\\""); }
            else if (ch == "\n") { b.Append("\\n"); }
            else if (ch == "\r") { b.Append("\\r"); }
            else if (ch == "\t") { b.Append("\\t"); }
            else { b.Append(ch); }
        }
        return b.ToString();
    }

    // decode a raw string-literal token text (lexer keeps escapes intact)
    string DecodeStr(string t) {
        return StrEsc.DecodeText(t);
    }

    string Lower(string s) {
        string UP = "ABCDEFGHIJKLMNOPQRSTUVWXYZ";
        string LO = "abcdefghijklmnopqrstuvwxyz";
        StringBuilder b = new StringBuilder();
        int n = s.Length;
        for (int i = 0; i < n; i = i + 1) {
            string ch = s.Substring(i, 1);
            int at = UP.IndexOf(ch);
            if (at >= 0) { b.Append(LO.Substring(at, 1)); }
            else { b.Append(ch); }
        }
        return b.ToString();
    }

    string SanName(string s) {
        StringBuilder b = new StringBuilder();
        int i = 0;
        while (i < s.Length) {
            string ch = s.Substring(i, 1);
            if (ch == ".") { b.Append("_"); }
            else { b.Append(ch); }
            i = i + 1;
        }
        return b.ToString();
    }

    int Atoi(string s) {
        int v = 0;
        int i = 0;
        bool neg = false;
        if (s.Length > 0 && s.Substring(0, 1) == "-") { neg = true; i = 1; }
        while (i < s.Length) {
            int c = s[i] & 255;
            if (c < 48 || c > 57) { break; }
            v = v * 10 + (c - 48);
            i = i + 1;
        }
        if (neg) { v = 0 - v; }
        return v;
    }

    double AtoD(string s) {
        double v = 0.0;
        int i = 0;
        bool neg = false;
        if (s.Length > 0 && s.Substring(0, 1) == "-") { neg = true; i = 1; }
        while (i < s.Length) {
            int c = s[i] & 255;
            if (c < 48 || c > 57) { break; }
            v = v * 10 + (c - 48);
            i = i + 1;
        }
        if (i < s.Length && s.Substring(i, 1) == ".") {
            i = i + 1;
            double frac = 1.0;
            while (i < s.Length) {
                int c2 = s[i] & 255;
                if (c2 < 48 || c2 > 57) { break; }
                frac = frac / 10.0;
                v = v + (c2 - 48) * frac;
                i = i + 1;
            }
        }
        if (neg) { v = 0.0 - v; }
        return v;
    }

    bool Sw(string s, string pre) {
        return s.Length >= pre.Length && s.Substring(0, pre.Length) == pre;
    }

    bool Ew(string s, string suf) {
        return s.Length >= suf.Length && s.Substring(s.Length - suf.Length) == suf;
    }

    static bool ModHas(int mods, int bit) {
        return (mods & bit) != 0;
    }

    // split s on a single-character separator (the stdlib String has no
    // Split; empty segments kept so callers can tell "" fields apart)
    List<string> Splitter(string s, string sep) {
        List<string> out0 = new List<string>();
        string cur = "";
        int i = 0;
        while (i < s.Length) {
            string ch = s.Substring(i, 1);
            if (ch == sep) {
                out0.Add(cur);
                cur = "";
            } else {
                cur = cur + ch;
            }
            i = i + 1;
        }
        out0.Add(cur);
        return out0;
    }

    /* ---- attrWeb unpacking ---- */

    // split one decl's packed attrWeb into the d* slots
    void Unpack(string packed) {
        dRoute = "";
        dVerb = "";
        dDesc = "";
        dFlags = "";
        dOpts = new List<string>();
        dMeta = new List<string>();
        if (packed == null || packed.Length == 0) { return; }
        List<string> f = Splitter(packed, "\n");
        if (f.Count > 0) { dRoute = f[0]; }
        if (f.Count > 1) { dVerb = f[1]; }
        if (f.Count > 2) { dDesc = f[2]; }
        if (f.Count > 3) { dFlags = f[3]; }
        if (f.Count > 4 && f[4].Length > 0) { dOpts = Splitter(f[4], ";"); }
        if (f.Count > 5 && f[5].Length > 0) { dMeta = Splitter(f[5], ";"); }
    }

    bool FlagsHave(string packed, string flag) {
        Unpack(packed);
        return dFlags.IndexOf(flag) >= 0;
    }

    /* ---- controller/action recognition ---- */

    // controller shape: name ends Controller, derives Controller/ApiController
    // (first base; the flat base list only keeps one in this parser), or
    // carries [Route]/[ApiController]
    bool IsController(Node cls) {
        string nm = cls.sval;
        if (Ew(nm, "Controller")) { return true; }
        if (cls.sval2 == "Controller" || cls.sval2 == "ApiController") { return true; }
        if (FlagsHave(cls.attrWeb, "A")) { return true; }
        Unpack(cls.attrWeb);
        return dRoute.Length > 0;
    }

    // module = the part of the declaring file's namespace after its first dot
    string ControllerModule(Node cls) {
        string ns = cls.nsName != null ? cls.nsName : "";
        int dot = ns.IndexOf(".");
        if (dot >= 0) { return ns.Substring(dot + 1); }
        return "";
    }

    // controller token = class name without the Controller suffix, lowercased
    string ControllerToken(string nm) {
        if (Ew(nm, "Controller")) {
            nm = nm.Substring(0, nm.Length - 10);
        }
        return Lower(nm);
    }

    // convention-based class route prefix when [Route] is absent
    string DefaultClassRoute(Node cls) {
        Unpack(cls.attrWeb);
        string explicitRoute = dRoute;
        if (explicitRoute.Length > 0) { return explicitRoute; }

        string ns = cls.nsName != null ? cls.nsName : "";
        List<string> segs = new List<string>();
        int start = 0;
        int nslen = ns.Length;
        int segIdx = 0;
        for (int i = 0; i <= nslen; i = i + 1) {
            if (i == nslen || (ns[i] & 255) == 46) {
                if (i > start) {
                    string seg = Lower(ns.Substring(start, i - start));
                    bool root = segIdx == 0;
                    segIdx = segIdx + 1;
                    if (!root && seg != "app" && seg != "application" &&
                        seg != "controller" && seg != "controllers" &&
                        seg != "src" && seg != "source" &&
                        seg != "packages" && seg != "package" &&
                        seg != "zan" && seg != "mvc" && seg != "web") {
                        segs.Add(seg);
                    }
                }
                start = i + 1;
            }
        }

        string tok = ControllerToken(cls.sval);
        if (segs.Count > 0) {
            string lastSeg = segs[segs.Count - 1];
            if (tok == lastSeg) { tok = ""; }
            else if (tok.StartsWith(lastSeg) && tok.Length > lastSeg.Length) {
                tok = tok.Substring(lastSeg.Length);
            }
        }
        if (tok == "department") { tok = "dept"; }
        else if (tok == "operationlog") { tok = "log"; }

        StringBuilder route = new StringBuilder();
        for (int si = 0; si < segs.Count; si = si + 1) {
            route.Append("/");
            route.Append(segs[si]);
        }
        if (tok.Length > 0) {
            route.Append("/");
            route.Append(tok);
        }
        if (route.Length == 0) { route.Append("/"); }
        return route.ToString();
    }

    /* ---- path assembly ---- */

    // merge class/method route templates, substitute [controller]/[action],
    // normalize slashes; a method template without a leading / and no
    // [action] gains an [action] segment
    string BuildPath(string clsTpl, string mTpl, string ctrlTok,
                     string actionTok) {
        string tpl;
        if (Sw(mTpl, "/")) {
            tpl = mTpl;
        } else if (mTpl.Length > 0) {
            if (clsTpl.Length > 0) { tpl = clsTpl + "/" + mTpl; }
            else { tpl = mTpl; }
        } else {
            if (actionTok == "index") {
                if (Ew(clsTpl, "/[action]")) {
                    tpl = clsTpl.Substring(0, clsTpl.Length - 9);
                } else if (clsTpl.IndexOf("[action]") >= 0) {
                    tpl = clsTpl;
                } else {
                    tpl = clsTpl.Length > 0 ? clsTpl : "/";
                }
            } else if (clsTpl.IndexOf("[action]") >= 0) {
                tpl = clsTpl;
            } else {
                tpl = clsTpl.Length > 0 ? clsTpl + "/[action]" : "/[action]";
            }
        }
        if (tpl.IndexOf("[action]") < 0 && !Sw(mTpl, "/") && actionTok != "index") {
            if (Ew(tpl, "/")) { tpl = tpl + "[action]"; }
            else { tpl = tpl + "/[action]"; }
        }
        StringBuilder sub = new StringBuilder();
        int i = 0;
        int n = tpl.Length;
        while (i < n) {
            if (n - i >= 12 && tpl.Substring(i, 12) == "[controller]") {
                sub.Append(ctrlTok);
                i = i + 12;
            } else if (n - i >= 8 && tpl.Substring(i, 8) == "[action]") {
                sub.Append(actionTok);
                i = i + 8;
            } else {
                sub.Append(tpl.Substring(i, 1));
                i = i + 1;
            }
        }
        StringBuilder out0 = new StringBuilder();
        out0.Append("/");
        bool prevSlash = true;
        string s = sub.ToString();
        for (int j = 0; j < s.Length; j = j + 1) {
            string ch = s.Substring(j, 1);
            if (ch == "/") {
                if (prevSlash) { continue; }
                out0.Append(ch);
                prevSlash = true;
            } else {
                out0.Append(ch);
                prevSlash = false;
            }
        }
        string r = out0.ToString();
        while (r.Length > 1 && Ew(r, "/")) {
            r = r.Substring(0, r.Length - 1);
        }
        return r;
    }

    /* ---- metadata merge ---- */

    void MetaSet(string key, int kind, string val, bool onlyAbsent) {
        int at = MetaIndexOf(key);
        if (at >= 0) {
            if (onlyAbsent) { return; }
            MV[at] = val;
            MK[at] = kind;
            return;
        }
        MK.Add(kind);
        MV.Add(val);
        MO.Add(key);
    }

    List<int> MK;
    List<string> MV;
    List<string> MO;

    int MetaIndexOf(string key) {
        int i = 0;
        while (i < MO.Count) {
            if (MO[i] == key) { return i; }
            i = i + 1;
        }
        return -1;
    }

    int MetaGetKind(string key) {
        int at = MetaIndexOf(key);
        return at >= 0 ? MK[at] : -1;
    }

    string MetaGetVal(string key) {
        int at = MetaIndexOf(key);
        return at >= 0 ? MV[at] : "";
    }

    /* ---- request-parameter discovery ---- */

    // reader name -> (type, required, has_default, has_label, where)
    bool ReaderFor(string name) {
        RRequired = false;
        RHasDefault = false;
        RHasLabel = false;
        RWhere = "query";
        if (name == "In") { RType = "string"; return true; }
        if (name == "InText") { RType = "string"; return true; }
        if (name == "InRaw") { RType = "string"; return true; }
        if (name == "InInt") { RType = "int"; RHasDefault = true; return true; }
        if (name == "InLong") { RType = "long"; RHasDefault = true; return true; }
        if (name == "InDouble") { RType = "number"; RHasDefault = true; return true; }
        if (name == "InBool") { RType = "bool"; RHasDefault = true; return true; }
        if (name == "HasIn") { RType = "bool"; return true; }
        if (name == "Need") { RType = "string"; RRequired = true; RHasLabel = true; return true; }
        if (name == "NeedText") { RType = "string"; RRequired = true; RHasLabel = true; return true; }
        if (name == "NeedInt") { RType = "int"; RRequired = true; RHasLabel = true; return true; }
        if (name == "NeedLong") { RType = "long"; RRequired = true; RHasLabel = true; return true; }
        if (name == "NeedDouble") { RType = "number"; RRequired = true; RHasLabel = true; return true; }
        if (name == "Param") { RType = "string"; RRequired = true; RWhere = "path"; return true; }
        return false;
    }

    // literal argument verbatim; non-literals (dynamic defaults are code, not
    // documentation) give ""
    string Literal(Node e) {
        if (e == null) { return ""; }
        if (e.kind == AK.Unary() && e.op == TK.Minus() && e.a != null) {
            Node o = e.a;
            if (o.kind == AK.IntLit()) { return Convert.ToString(0 - o.ival); }
            if (o.kind == AK.FloatLit()) { return "-" + o.sval; }
            return "";
        }
        if (e.kind == AK.IntLit()) { return Convert.ToString(e.ival); }
        if (e.kind == AK.FloatLit()) { return e.sval; }
        if (e.kind == AK.BoolLit()) { return e.ival != 0 ? "true" : "false"; }
        if (e.kind == AK.StringLit()) { return DecodeStr(e.sval); }
        return "";
    }

    // record one input call's parameter; a second read of the same name merges
    // into the stronger declaration (required / concrete type / first default
    // and description), past 64 parameters silently dropped
    void ParamsAdd(Node call) {
        if (PName.Count >= 64) { return; }
        if (call.kids.Count < 1) { return; }
        Node a0 = call.kids[0];
        if (a0.kind != AK.StringLit()) { return; }
        string nm = DecodeStr(a0.sval);
        if (nm.Length == 0) { return; }
        int i = 0;
        while (i < PName.Count) {
            if (PName[i] == nm) {
                if (RRequired) { PRequired[i] = true; }
                if (RHasLabel && call.kids.Count >= 2 && PDesc[i].Length == 0) {
                    PDesc[i] = Literal(call.kids[1]);
                }
                if (RHasDefault && call.kids.Count >= 2 && PDef[i].Length == 0) {
                    PDef[i] = Literal(call.kids[1]);
                }
                if (PType[i] == "string") { PType[i] = RType; }
                return;
            }
            i = i + 1;
        }
        PName.Add(nm);
        PType.Add(RType);
        PRequired.Add(RRequired);
        PWhere.Add(RWhere);
        if (call.kids.Count >= 2) {
            PDef.Add(RHasDefault ? Literal(call.kids[1]) : "");
            PDesc.Add(RHasLabel ? Literal(call.kids[1]) : "");
        } else {
            PDef.Add("");
            PDesc.Add("");
        }
    }

    bool PNameSeen(string nm) {
        int i = 0;
        while (i < PName.Count) {
            if (PName[i] == nm) { return true; }
            i = i + 1;
        }
        return false;
    }

    // register one optional parameter (query source; existing name skipped)
    void ParamAddOne(string nm, string ty, string desc, string def) {
        if (PName.Count >= 64) { return; }
        if (PNameSeen(nm)) { return; }
        PName.Add(nm);
        PType.Add(ty);
        PRequired.Add(false);
        PDef.Add(def);
        PDesc.Add(desc);
        PWhere.Add("query");
    }

    // this.Paged(defOrder, defLimit) reads the five parameters every list
    // screen shares (Controller.Paged -> ListQuery.From); expand the single
    // call site here, explicit reads of the same names winning
    void ParamsAddPaged(Node call) {
        string def_order = "";
        string def_limit = "";
        if (call.kids.Count >= 1) { def_order = Literal(call.kids[0]); }
        if (call.kids.Count >= 2) { def_limit = Literal(call.kids[1]); }
        ParamAddOne("page", "int", "页码，从 1 开始", "1");
        ParamAddOne("limit", "int", "每页条数", def_limit);
        ParamAddOne("order", "string", "排序字段", def_order);
        ParamAddOne("dir", "string", "排序方向：desc 或 asc", "desc");
        ParamAddOne("kw", "string", "搜索关键词", "");
    }

    // visit one call site: receiver must be the controller itself or its
    // HttpContext (this / ctx / c / this.Ctx()), then readers and Paged feed
    // the doc table
    void VisitCall(Node call) {
        Node callee = call.a;
        if (callee == null) { return; }
        string name = "";
        bool ok = false;
        if (callee.kind == AK.MemberAccess()) {
            name = callee.sval;
            Node r = callee.a;
            if (r != null && r.kind == AK.ThisExpr()) { ok = true; }
            else if (r != null && r.kind == AK.Ident()
                    && (r.sval == "ctx" || r.sval == "c")) { ok = true; }
            else if (r != null && r.kind == AK.Call() && r.a != null
                    && r.a.kind == AK.MemberAccess() && r.a.sval == "Ctx") { ok = true; }
        } else if (callee.kind == AK.Ident()) {
            // implicit this
            name = callee.sval;
            ok = true;
        }
        if (!ok) { return; }
        if (ReaderFor(name)) {
            ParamsAdd(call);
        } else if (name == "Paged") {
            ParamsAddPaged(call);
        }
    }

    // walk a subtree, visiting every call site (arguments included)
    void WalkNode(Node n) {
        if (n == null) { return; }
        if (n.kind == AK.Call()) { VisitCall(n); }
        WalkNode(n.a);
        WalkNode(n.b);
        WalkNode(n.c);
        WalkNode(n.d);
        int i = 0;
        while (i < n.kids.Count) {
            WalkNode(n.kids[i]);
            i = i + 1;
        }
    }

    // route path segments are parameters too, even when the action never
    // reads them ("{id:int}" -> id/int/path)
    void ParamsFromPath(string path) {
        int n = path.Length;
        int i = 0;
        while (i < n) {
            if (path.Substring(i, 1) != "{") { i = i + 1; continue; }
            int e = path.IndexOf("}", i);
            if (e < 0) { return; }
            string nm = path.Substring(i + 1, e - i - 1);
            string ty = "string";
            int colon = nm.IndexOf(":");
            if (colon >= 0) {
                string rest = nm.Substring(colon + 1);
                nm = nm.Substring(0, colon);
                if (rest == "int") { ty = "int"; }
                else if (rest == "long") { ty = "long"; }
            }
            bool seen = false;
            int j = 0;
            while (j < PName.Count) {
                if (PName[j] == nm) {
                    PWhere[j] = "path";
                    PRequired[j] = true;
                    seen = true;
                }
                j = j + 1;
            }
            if (!seen && PName.Count < 64) {
                PName.Add(nm);
                PType.Add(ty);
                PRequired.Add(true);
                PDef.Add("");
                PDesc.Add("");
                PWhere.Add("path");
            }
            i = e;
        }
    }

    // emit the doc table as the registration chain's .Param(...) sequence
    void EmitParams(StringBuilder out0) {
        int i = 0;
        while (i < PName.Count) {
            out0.Append("\n            .Param(\"");
            out0.Append(Esc(PName[i]));
            out0.Append("\", \"");
            out0.Append(PType[i]);
            out0.Append("\", ");
            if (PRequired[i]) { out0.Append("true"); }
            else { out0.Append("false"); }
            out0.Append(", \"");
            out0.Append(Esc(PDef[i]));
            out0.Append("\", \"");
            out0.Append(Esc(PDesc[i]));
            out0.Append("\", \"");
            out0.Append(PWhere[i]);
            out0.Append("\")");
            i = i + 1;
        }
    }

    /* ---- fluent metadata output ---- */

    // route metadata as fluent calls (Title/Auth/Menu/Lock/Upload/Limit/Meta)
    void EmitFluent(StringBuilder out0, string title) {
        if (title.Length > 0) {
            out0.Append(".Title(\"");
            out0.Append(Esc(title));
            out0.Append("\")");
        }
        if (MetaGetKind("Authorization") == 3) {
            string av = MetaGetVal("Authorization");
            if (av == "Login") { out0.Append(".Login()"); }
            else if (av == "Grant") { out0.Append(".Auth()"); }
            else if (av == "ApiAuth") { out0.Append(".Auth()"); }
        }
        if (MetaGetKind("IsMenu") == 1 && MetaGetVal("IsMenu") == "true") {
            out0.Append(".Menu()");
        }
        if (MetaGetKind("Lock") == 2 && MetaGetVal("Lock").Length > 0) {
            out0.Append(".Lock(\"");
            out0.Append(Esc(MetaGetVal("Lock")));
            out0.Append("\")");
        }
        if (MetaGetKind("Upload") == 1 && MetaGetVal("Upload") == "true") {
            out0.Append(".Upload()");
        }
        if (MetaGetKind("ApiMax") == 0 && Atoi(MetaGetVal("ApiMax")) < 1000) {
            if (MetaGetKind("RateBy") == 2) {
                string scope = MetaGetVal("RateBy");
                if (scope == "uid" || scope == "ip") {
                    out0.Append(".LimitBy(");
                    out0.Append(MetaGetVal("ApiMax"));
                    out0.Append(", \"");
                    out0.Append(Esc(scope));
                    out0.Append("\")");
                } else {
                    out0.Append(".Limit(");
                    out0.Append(MetaGetVal("ApiMax"));
                    out0.Append(")");
                }
            } else {
                out0.Append(".Limit(");
                out0.Append(MetaGetVal("ApiMax"));
                out0.Append(")");
            }
        }
        int i = 0;
        while (i < MO.Count) {
            out0.Append(".Meta(\"");
            out0.Append(Esc(MO[i]));
            out0.Append("\", \"");
            out0.Append(Esc(MV[i]));
            out0.Append("\")");
            i = i + 1;
        }
    }

    /* ---- signature binding ---- */

    bool BindableType(string t) {
        return t == "string" || t == "int" || t == "long" ||
               t == "double" || t == "bool";
    }

    bool BindableParams(List<Node> ps) {
        int i = 0;
        while (i < ps.Count) {
            string t = ParamTy(ps[i]);
            if (!BindableType(t) && FormClassOf(t) == null) { return false; }
            i = i + 1;
        }
        return true;
    }

    string ParamTy(Node p) {
        return p.type != null && p.type.sval != null ? p.type.sval : "";
    }

    // the form class a parameter type names: known in this unit, a class, and
    // constructible without arguments (explicit parameterless ctor, or none
    // declared at all)
    Node FormClassOf(string t) {
        int ci = -1;
        int i = 0;
        while (i < cnames.Count) {
            if (cnames[i] == t) { ci = i; break; }
            i = i + 1;
        }
        if (ci < 0) { return null; }
        Node cls = classes[ci];
        if (cls.kind != AK.ClassDecl()) { return null; }
        bool hasCtor = false;
        int mi = 0;
        while (mi < cls.kids.Count) {
            Node m = cls.kids[mi];
            if (m.kind == AK.CtorDecl()) {
                hasCtor = true;
                int np = 0;
                int pi = 0;
                while (pi < m.kids.Count) {
                    if (m.kids[pi].kind == AK.Param()) { np = np + 1; }
                    pi = pi + 1;
                }
                if (np == 0) { return cls; }
            }
            mi = mi + 1;
        }
        if (!hasCtor) { return cls; }
        return null;
    }

    // [Opt("page=1","kw=")]: optional signature parameter name -> default
    List<string> OptNames;
    List<string> OptVals;

    void OptArgs(Node m) {
        OptNames = new List<string>();
        OptVals = new List<string>();
        Unpack(m.attrWeb);
        int i = 0;
        while (i < dOpts.Count) {
            string a = dOpts[i];
            int eq = a.IndexOf("=");
            string nm = eq >= 0 ? a.Substring(0, eq) : a;
            string dv = eq >= 0 ? a.Substring(eq + 1) : "";
            if (!OptNames.Contains(nm)) {
                OptNames.Add(nm);
                OptVals.Add(dv);
            }
            i = i + 1;
        }
    }

    bool OptHas(string nm) {
        return OptNames.Contains(nm);
    }

    string OptVal(string nm) {
        int at = OptNames.IndexOf(nm);
        return at >= 0 ? OptVals[at] : "";
    }

    // In* read expression: string via In, the rest with a typed default
    string InCall(string t, string label, string def) {
        if (t == "int") {
            return "__c.InInt(\"" + label + "\", " +
                   Convert.ToString(Atoi(def)) + ")";
        }
        if (t == "long") {
            return "__c.InLong(\"" + label + "\", " +
                   Convert.ToString(Atoi(def)) + ")";
        }
        if (t == "double") {
            return "__c.InDouble(\"" + label + "\", " +
                   Convert.ToString(AtoD(def)) + ")";
        }
        if (t == "bool") {
            return "__c.InBool(\"" + label + "\", " +
                   (def == "true" ? "true" : "false") + ")";
        }
        return "__c.In(\"" + label + "\")";
    }

    // an optional parameter's binding statement: under [Opt("page=1")],
    // `int page` becomes `int page = __c.InInt("page", 1);` -- missing reads
    // the default instead of answering 400
    string OptBindLine(string t, string n, string def) {
        string label = Esc(n);
        string line = t + " " + n + " = " + InCall(t, label, def) + ";";
        if (t == "string" && def.Length > 0) {
            line = line + " if (" + n + ".Length == 0) { " + n + " = \"" +
                   Esc(def) + "\"; }";
        }
        return line;
    }

    // one binding statement: `long id = __c.NeedLong("id", "id");`. Required
    // semantics: missing and malformed both throw ApiError(400), answered
    // uniformly by the trampoline
    string BindLine(string t, string n) {
        string label = Esc(n);
        if (t == "int") {
            return "int " + n + " = __c.NeedInt(\"" + label + "\", \"" +
                   label + "\");";
        }
        if (t == "long") {
            return "long " + n + " = __c.NeedLong(\"" + label + "\", \"" +
                   label + "\");";
        }
        if (t == "double") {
            return "double " + n + " = __c.NeedDouble(\"" + label + "\", \"" +
                   label + "\");";
        }
        if (t == "bool") {
            return "bool " + n + " = __c.NeedBool(\"" + label + "\", \"" +
                   label + "\");";
        }
        return "string " + n + " = __c.Need(\"" + label + "\", \"" +
               label + "\");";
    }

    /* ---- controller generation ---- */

    // generate one controller's routes; returns the route count
    int GenController(Node cls, StringBuilder handlers, StringBuilder reg) {
        string cname = cls.sval;
        string ctrltok = ControllerToken(cname);
        string cmod = ControllerModule(cls);
        string cact = cmod.Length > 0 ? cmod + "." + cname : cname;
        string ns = cls.nsName != null ? cls.nsName : "";
        string fullCls = ns.Length > 0 ? ns + "." + cname : cname;
        string clsTpl = DefaultClassRoute(cls);
        Unpack(cls.attrWeb);
        string clsDesc = dDesc;
        bool clsTx = dFlags.IndexOf("T") >= 0;
        bool apiController = dFlags.IndexOf("A") >= 0;
        int nroutes = 0;
        int mi = 0;
        while (mi < cls.kids.Count) {
            Node m = cls.kids[mi];
            mi = mi + 1;
            if (m.kind != AK.MethodDecl()) { continue; }
            Unpack(m.attrWeb);
            if (dFlags.IndexOf("N") >= 0) { continue; }
            bool tagged = dRoute.Length > 0 || dVerb.Length > 0;
            if (!tagged && !apiController) { continue; }
            if (ModHas(m.mods, MOD.Private()) || ModHas(m.mods, MOD.Protected())) {
                continue;
            }

            // supported shapes: 0 parameters, a single HttpContext parameter,
            // or an instance action with an all-bindable signature
            // (string/int/long/double/bool, or a form-bindable class) -- the
            // trampoline binds those from the request
            List<Node> ps = new List<Node>();
            int pi = 0;
            while (pi < m.kids.Count) {
                if (m.kids[pi].kind == AK.Param()) { ps.Add(m.kids[pi]); }
                pi = pi + 1;
            }
            int np = ps.Count;
            bool ctxParam = false;
            if (np == 1 && ParamTy(ps[0]) == "HttpContext") { ctxParam = true; }
            bool isStatic = ModHas(m.mods, MOD.Static());
            bool bindable = np > 0 && !ctxParam && !isStatic && BindableParams(ps);
            if (np != 0 && !ctxParam && !bindable) { continue; }

            string mname = m.sval;
            string actiontok = Lower(mname);
            string verb = dVerb.Length > 0 ? dVerb : "GET";
            string mTpl = dRoute;
            string path = BuildPath(clsTpl, mTpl, ctrltok, actiontok);

            // three-layer metadata merge: class -> method (method wins)
            MK = new List<int>();
            MV = new List<string>();
            MO = new List<string>();
            ApplyMetaList(cls.attrWeb);
            ApplyMetaList(m.attrWeb);
            Unpack(m.attrWeb);
            string mDesc = dDesc;
            string title = mDesc.Length > 0 ? mDesc : clsDesc;

            bool isAsync = ModHas(m.mods, MOD.Async());
            string hname = "__h_" + SanName(fullCls) + "_" + mname;
            string aw = isAsync ? "await " : "";
            string arg = ctxParam ? "ctx" : "";
            bool tx = !isStatic && (dFlags.IndexOf("T") >= 0 || clsTx);
            OptArgs(m);
            List<string> bindLines = new List<string>();
            List<string> docName = new List<string>();
            List<string> docType = new List<string>();
            List<bool> docReq = new List<bool>();
            List<string> docDef = new List<string>();
            List<string> docWhere = new List<string>();
            if (bindable) {
                arg = "";
                int ppi = 0;
                while (ppi < np) {
                    string pt = ParamTy(ps[ppi]);
                    string pn = ps[ppi].sval;
                    if (ppi > 0) { arg = arg + ", "; }
                    arg = arg + pn;
                    Node fcls = FormClassOf(pt);
                    if (fcls != null) {
                        bindLines.Add("                " + pt + " " + pn +
                                      " = new " + pt + "();\n");
                        int fi = 0;
                        while (fi < fcls.kids.Count) {
                            Node fld = fcls.kids[fi];
                            if (fld.kind == AK.FieldDecl()) {
                                string ft = ParamTy(fld);
                                string fn = fld.sval;
                                if (BindableType(ft)) {
                                    string flabel = Esc(fn);
                                    bindLines.Add("                if (__c.HasIn(\""
                                        + flabel + "\")) { " + pn + "." + fn
                                        + " = " + InCall(ft, flabel, "")
                                        + "; }\n");
                                    docName.Add(fn);
                                    docType.Add(ft);
                                    docReq.Add(false);
                                    docDef.Add("");
                                    docWhere.Add("form");
                                }
                            }
                            fi = fi + 1;
                        }
                        ppi = ppi + 1;
                        continue;
                    }
                    if (OptHas(pn)) {
                        string def = OptVal(pn);
                        bindLines.Add("                " +
                            OptBindLine(pt, pn, def) + "\n");
                        docName.Add(pn);
                        docType.Add(pt);
                        docReq.Add(false);
                        docDef.Add(def);
                        docWhere.Add("query");
                        ppi = ppi + 1;
                        continue;
                    }
                    docName.Add(pn);
                    docType.Add(pt);
                    docReq.Add(true);
                    docDef.Add("");
                    docWhere.Add("query");
                    bindLines.Add("                " +
                                  BindLine(pt, pn) + "\n");
                    ppi = ppi + 1;
                }
            }

            // trampoline: async to satisfy the async HttpHandler delegate
            // (WebApp.Dispatch awaits it) so actions can await I/O without
            // blocking the connection coroutine
            handlers.Append("    static async void " + hname +
                            "(HttpContext ctx) {\n");
            if (isStatic) {
                handlers.Append("        try {\n");
                handlers.Append("            " + aw + fullCls + "." + mname +
                                "(" + arg + ");\n");
                handlers.Append("        } catch (ApiError __e) {\n");
                handlers.Append("            ctx.Status(__e.Status(), ApiError.Reason(__e.Status()));\n");
                handlers.Append("            ctx.Api(__e.Code(), __e.Message, \"null\");\n");
                handlers.Append("        }\n");
            } else {
                handlers.Append("        " + fullCls + " __c = new " + fullCls +
                                "();\n");
                handlers.Append("        __c.__Bind(ctx);\n");
                // view key = action name: one controller half, so view and
                // permission never fork
                handlers.Append("        __c.__SetView(\"" + cact + "." +
                                mname + "\");\n");
                // required parameters abort by throwing ApiError, caught
                // here so `this.Need(...)` reads as an expression; [Tx]
                // actions wrap in a transaction scope
                handlers.Append("        if (await __c.__BeforeAsync()) {\n");
                if (tx) {
                    handlers.Append("            bool __tx = false;\n");
                }
                handlers.Append("            try {\n");
                if (tx) {
                    handlers.Append("                __tx = await __c.__TxBegin();\n");
                    handlers.Append("                if (!__tx) { throw new ApiError(503, \"0503\", \"服务不可用\"); }\n");
                }
                int bi = 0;
                while (bi < bindLines.Count) {
                    handlers.Append(bindLines[bi]);
                    bi = bi + 1;
                }
                handlers.Append("                " + aw + "__c." + mname +
                                "(" + arg + ");\n");
                if (tx) {
                    handlers.Append("                await __c.__TxCommit();\n");
                }
                handlers.Append("            } catch (ApiError __e) {\n");
                if (tx) {
                    handlers.Append("                if (__tx) { await __c.__TxRollback(); }\n");
                }
                handlers.Append("                ctx.Status(__e.Status(), ApiError.Reason(__e.Status()));\n");
                handlers.Append("                ctx.Api(__e.Code(), __e.Message, \"null\");\n");
                if (tx) {
                    handlers.Append("            } catch (Exception __x) {\n");
                    handlers.Append("                if (__tx) { await __c.__TxRollback(); }\n");
                    handlers.Append("                throw __x;\n");
                }
                handlers.Append("            }\n");
                handlers.Append("            await __c.__AfterAsync();\n");
                handlers.Append("        }\n");
            }
            handlers.Append("    }\n");

            // registration
            string rkey = verb + " " + path;
            if (!routeKeys.ContainsKey(rkey)) {
                routeKeys.Add(rkey, cact);
                reg.Append("        app.Map(\"" + verb + "\", \"");
                reg.Append(Esc(path));
                reg.Append("\", __AttrRoutes." + hname + ")\n            .Named(\"");
                reg.Append(Esc(cact));
                reg.Append(".");
                reg.Append(Esc(mname));
                reg.Append("\")");
                EmitFluent(reg, title);
                PName = new List<string>();
                PType = new List<string>();
                PRequired = new List<bool>();
                PDef = new List<string>();
                PDesc = new List<string>();
                PWhere = new List<string>();
                // signature-bound parameters seed the doc table first (required
                // primitives as query source, [Opt] with defaults, class
                // parameters' primitive fields as optional form source);
                // ScanCalls/ParamsFromPath then merge same-name entries
                int si = 0;
                while (si < docName.Count) {
                    PName.Add(docName[si]);
                    PType.Add(docType[si]);
                    PRequired.Add(docReq[si]);
                    PDef.Add(docDef[si]);
                    PDesc.Add("");
                    PWhere.Add(docWhere[si]);
                    si = si + 1;
                }
                WalkNode(m.d);
                ParamsFromPath(path);
                EmitParams(reg);
                reg.Append(";\n");
            }
            if (actiontok == "index" && mTpl.Length == 0 && path != clsTpl + "/index") {
                string akey = verb + " " + clsTpl + "/index";
                if (!routeKeys.ContainsKey(akey)) {
                    routeKeys.Add(akey, cact);
                    reg.Append("        app.Map(\"" + verb + "\", \"");
                    reg.Append(Esc(clsTpl + "/index"));
                    reg.Append("\", __AttrRoutes." + hname + ")\n            .Named(\"");
                    reg.Append(Esc(cact));
                    reg.Append(".");
                    reg.Append(Esc(mname));
                    reg.Append("\")");
                    StringBuilder aliasFluent = new StringBuilder();
                    EmitFluent(aliasFluent, title);
                    string afl = aliasFluent.ToString();
                    int ami = afl.IndexOf(".Menu()");
                    if (ami >= 0) {
                        afl = afl.Substring(0, ami) + afl.Substring(ami + 7);
                    }
                    reg.Append(afl);
                    reg.Append(";\n");
                }
            }
            nroutes = nroutes + 1;
        }
        return nroutes;
    }

    // one declaration's metadata records, applied in order: each record's
    // attribute class contributes its property/ctor defaults first (absent
    // keys only), then the usage arguments override
    void ApplyMetaList(string packed) {
        Unpack(packed);
        int i = 0;
        while (i < dMeta.Count) {
            string rec = dMeta[i];
            int at = rec.IndexOf("@");
            if (at > 0) {
                ApplyAttrUnit(rec.Substring(0, at));
                rec = rec.Substring(at + 1);
            }
            int c1 = rec.IndexOf(":");
            int eq = rec.IndexOf("=");
            if (c1 > 0 && eq > c1) {
                int kind = Atoi(rec.Substring(0, c1));
                string name = rec.Substring(c1 + 1, eq - c1 - 1);
                string val = rec.Substring(eq + 1);
                MetaSet(name, kind, val, false);
            }
            i = i + 1;
        }
    }

    /* ---- attribute-class defaults (GenRoute.ApplyAttr) ---- */

    List<string> PmParam;   // ctor param name -> assigned property name
    List<string> PmProp;

    // the attribute class a usage names: unit class by name or name+
    // "Attribute"; must be a class
    Node AttrClassOf(string name) {
        int i = 0;
        while (i < cnames.Count) {
            if (cnames[i] == name || cnames[i] == name + "Attribute") {
                Node cls = classes[i];
                if (cls.kind == AK.ClassDecl()) { return cls; }
                return null;
            }
            i = i + 1;
        }
        return null;
    }

    // compile-time constant attribute-class expressions; sets ev2Kind/ev2Val
    int ev2Kind;
    string ev2Val;

    bool EvalNode(Node e) {
        ev2Val = "";
        ev2Kind = -1;
        if (e == null) { return false; }
        if (e.kind == AK.IntLit()) { ev2Kind = 0; ev2Val = Convert.ToString(e.ival); return true; }
        if (e.kind == AK.BoolLit()) { ev2Kind = 1; ev2Val = e.ival != 0 ? "true" : "false"; return true; }
        if (e.kind == AK.StringLit()) { ev2Kind = 2; ev2Val = DecodeStr(e.sval); return true; }
        if (e.kind == AK.Ident()) { ev2Kind = 3; ev2Val = e.sval; return true; }
        if (e.kind == AK.MemberAccess() && e.a != null && e.a.kind == AK.Ident()) {
            ev2Kind = 3;
            ev2Val = e.sval;
            return true;
        }
        if (e.kind == AK.Unary() && e.op == TK.Minus() && e.a != null
                && e.a.kind == AK.IntLit()) {
            ev2Kind = 0;
            string sv = Convert.ToString(e.a.ival);
            ev2Val = sv != "0" ? "-" + sv : "0";
            return true;
        }
        if (e.kind == AK.Binary() && e.op == TK.Pipe() && e.a != null && e.b != null) {
            if (!EvalNode(e.a)) { return false; }
            if (ev2Kind != 3) { return false; }
            string left = ev2Val;
            if (!EvalNode(e.b)) { return false; }
            if (ev2Kind != 3) { return false; }
            ev2Kind = 3;
            ev2Val = left + "|" + ev2Val;
            return true;
        }
        return false;
    }

    string PmapProp(string param) {
        int i = 0;
        while (i < PmParam.Count) {
            if (PmParam[i] == param) { return PmProp[i]; }
            i = i + 1;
        }
        return "";
    }

    // collect the ctor body's `this.Prop = param;` assignments
    void AssignScan(Node n) {
        if (n == null) { return; }
        if (n.kind == AK.Assignment() && n.a != null && n.b != null
                && n.a.kind == AK.MemberAccess() && n.a.a != null
                && n.a.a.kind == AK.ThisExpr() && n.b.kind == AK.Ident()) {
            PmParam.Add(n.b.sval);
            PmProp.Add(n.a.sval);
        }
        AssignScan(n.a);
        AssignScan(n.b);
        AssignScan(n.c);
        AssignScan(n.d);
        int i = 0;
        while (i < n.kids.Count) {
            AssignScan(n.kids[i]);
            i = i + 1;
        }
    }

    // apply one attribute usage: its class's property initializers and ctor
    // parameter defaults (mapped through the ctor's property assignments)
    // first, absent keys only
    void ApplyAttrUnit(string attrName) {
        Node cls = AttrClassOf(attrName);
        if (cls == null) { return; }
        PmParam = new List<string>();
        PmProp = new List<string>();
        Node ctor = null;
        int mi = 0;
        while (mi < cls.kids.Count) {
            Node m = cls.kids[mi];
            if (m.kind == AK.CtorDecl()) { ctor = m; break; }
            mi = mi + 1;
        }
        if (ctor != null) { AssignScan(ctor.d); }
        // property/field initializers, declaration order
        mi = 0;
        while (mi < cls.kids.Count) {
            Node f = cls.kids[mi];
            if (f.kind == AK.FieldDecl() && f.b != null && EvalNode(f.b)) {
                MetaSet(f.sval, ev2Kind, ev2Val, true);
            }
            mi = mi + 1;
        }
        // ctor parameter defaults, mapped through the assignments
        if (ctor != null) {
            int pi = 0;
            while (pi < ctor.kids.Count) {
                Node p = ctor.kids[pi];
                if (p.kind == AK.Param() && p.b != null) {
                    string prop = PmapProp(p.sval);
                    if (prop.Length > 0 && EvalNode(p.b)) {
                        MetaSet(prop, ev2Kind, ev2Val, true);
                    }
                }
                pi = pi + 1;
            }
        }
    }
}
