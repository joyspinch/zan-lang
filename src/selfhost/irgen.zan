using System;
using System.Collections.Generic;
namespace Zan;

// A generated value: its LLVM operand text plus the source type node it has.
public class ExprVal {
    public string op;
    public Node ty;
    // true when the value is the FRAME POINTER of an async call (the ramp
    // allocates the frame; the body runs from $resume). The call site hands
    // such a frame to the scheduler when the call is a fire-and-forget
    // statement.
    public bool asyncCall;
    public ExprVal(string o, Node t) { op = o; ty = t; }
}

// IR backend: lowers the bound AST to LLVM IR text. Mirrors src/compiler/
// irgen.c for the bootstrap subset. Integer/bool/char/enum are i64; string is
// i8*; class/struct instances are heap objects referenced by %Name*; List<T>
// is a growable i64-slot runtime array referenced by i8* (pointer elements are
// stored via ptrtoint / read back via inttoptr).
partial class Irgen {
    public Binder binder;
    // The gen1 IR is compiled and run on the same host as this compiler, so
    // OS-specific runtime shims (console code page, timers, sleep) follow the
    // host platform: a drive-letter ExeDir means Windows, else POSIX.
    public bool hostWin;
    public Diags diags;
    public StringBuilder head;
    public StringBuilder body;
    public int tmp;
    public int lbl;
    public int strn;
    public bool term;
    public string curClass;
    public string curRet;
    public Node curRetTy;      // the current method's declared return type
    public bool curHasThis;
    public List<string> locName;
    public List<Node> locType;
    public List<string> locReg;
    // closure capture: a local a closure may capture lives in a heap cell
    // (locBox), and a per-iteration variable (for/foreach) is snapshotted
    // into a fresh cell per capture (locIter). locCell is the cell address.
    public List<bool> locBox;
    public List<bool> locIter;
    public List<string> locCell;
    // a by-ref (`ref`/`out`) parameter: the local's register is the ADDRESS
    // of the caller's storage, so reads/writes go through it and the
    // reference stays the caller's (the callee never releases it)
    public List<bool> locRef;
    // names a closure inside the current function may capture: a local with
    // one of these names has to live in a cell
    public List<string> capNames;
    public int locSeq;
    // the user-defined conversion operator found by the last lookup: the
    // declaring class (its symbol names the definition) and whether the
    // last ApplyUserConv actually applied one
    public string convOwner;
    public bool convApplied;
    public int qdotSeq;
    public string curLbl;
    public int brkTarget;
    public int contTarget;
    public List<string> tparamNames;
    // the class whose scope the types being mapped are written in. A method's
    // OWN declared types live in the DECLARING class's scope, where a type
    // parameter shadows a user type of the same name; "" means "the class
    // being emitted".
    public string typeScopeCls;
    // the method declaration being emitted: its own type parameters (and
    // their constraints) shadow the class's, so the constraint lookup is
    // scope-correct
    public Node curMethodNode;
    // the receiver's STATIC type in the method being emitted. For a
    // specialized clone of a generic class it carries the concrete type
    // arguments (`Pool<string>`), so a field read resolves the real value
    // type; for an ordinary method it is the class itself.
    public Node curThisTy;
    // method-level monomorphization: specialized clones pending emission
    public List<Node> specMs;
    public List<Node> specClss;
    public List<string> specSyms;
    // the try statements we are lexically inside of, innermost last. Each
    // entry carries the try's finally body (null when it has none) and
    // whether its EH frame is still pushed. A `return` (or a break/continue)
    // that leaves the try region must run the finally bodies on this stack --
    // the C host does, and skipping them leaves a lock held (a
    // `try { return x; } finally { Unlock(); }` would deadlock the next
    // Lock forever).
    public List<Node> finBodies;
    public List<int> finLive;
    public List<int> finActive;
    // the type binding of the last class-level specialization (the indexer
    // and property paths use it to map the clone's own types)
    public List<string> csNames;
    public List<Node> csReps;
    // the finally-stack depth at the entry of the innermost loop: a
    // break/continue runs only the finallys opened inside that loop
    public int brkFinBase;
    public int contFinBase;
    // the receiver's static type of each specialized clone (the concrete
    // instantiation of the class, when the clone specializes a generic class)
    public List<Node> specThis;
    // the instantiations of generic classes the program uses: the class name
    // and the container of its concrete type arguments. A generic class's
    // static storage exists PER INSTANTIATION (the C host mangles the static
    // names with the instantiation suffix), so the backend has to know every
    // instantiation before it emits the globals and the static initializers.
    public List<string> instClasses;
    public List<Node> instConts;
    public List<string> instKeys;
    // the class instantiation of the method being emitted: a specialized clone
    // of a generic class (`Stat<int>`) carries its concrete type arguments, so
    // a bare static field inside it names that instantiation's own storage
    public List<Node> curInstArgs;
    public string curInstCls;
    public StringBuilder deferred; // hoisted lambda function definitions
    public StringBuilder entryAllocas; // per-function allocas hoisted to entry
    public bool eaActive;
    public int lamCount;
    public List<string> stmtTemps;
    public List<Node> stmtTempTypes;
    public int loopScopeBase;
    public List<string> externDecls; // extern C symbols already `declare`d
    public bool curAsync;
    public string curResumeSym;
    public int curSubBase;
    public int curAwaitSeq;
    public bool usesAsync;
    public bool usesDirList;
    public bool usesStrOps; // Trim/ToUpper/ToLower/Replace/LastIndexOf helpers
    public bool conSlots; // Console.ForegroundColor/BackgroundColor slots emitted
    List<string> mgTargets; // method-group thunks already emitted
    public List<string> asyncSlotReg;
    public List<Node> asyncSlotTy;
    public List<int> asyncSlotIdx;
    // indexes (into lnames) of the locals of the current async method that a
    // closure captured: they live in a heap cell, so the cleanup function has
    // to release the value INSIDE the cell, not the cell pointer
    public List<int> asyncBoxIdx;
    public int asyncForeachBase;   // first frame slot of the foreach loop temps
    public int asyncForeachNext;   // next foreach temp slot to hand out
    public bool curAsyncThis;
    public int curAsyncThisSlot;
    public Node curAsyncThisTy;
    public List<string> gotoNames; // per-function goto label name -> id
    public List<int> gotoIds;
    public bool crcEmitted; // NativeMemory.Crc32 helper+table emitted once
    public bool crc32cEmitted; // NativeMemory.Crc32C helpers+table emitted once
    public List<string> tidNames; // classes whose @__tid_X global was emitted

    public Irgen(Binder b, Diags d) {
        binder = b; diags = d;
        head = new StringBuilder(); body = new StringBuilder();
        deferred = new StringBuilder(); lamCount = 0;
        entryAllocas = new StringBuilder(); eaActive = false;
        tmp = 0; lbl = 0; strn = 0; term = false;
        curClass = ""; curRet = "void"; curHasThis = false;
        curRetTy = null;
        locName = new List<string>();
        locType = new List<Node>();
        locReg = new List<string>();
        locBox = new List<bool>();
        locIter = new List<bool>();
        locCell = new List<string>();
        locRef = new List<bool>();
        capNames = new List<string>();
        locSeq = 0;
        qdotSeq = 0;
        curAsync = false; usesAsync = false; usesDirList = false; usesStrOps = false;
        mgTargets = new List<string>();
        curLbl = "entry";
        brkTarget = 0; contTarget = 0;
        tparamNames = new List<string>();
        typeScopeCls = "";
        curMethodNode = null;
        curThisTy = null;
        specMs = new List<Node>();
        specClss = new List<Node>();
        specThis = new List<Node>();
        specSyms = new List<string>();
        instClasses = new List<string>();
        instConts = new List<Node>();
        instKeys = new List<string>();
        curInstArgs = new List<Node>();
        curInstCls = "";
        finBodies = new List<Node>();
        finLive = new List<int>();
        finActive = new List<int>();
        csNames = new List<string>();
        csReps = new List<Node>();
        brkFinBase = 0;
        contFinBase = 0;
        stmtTemps = new List<string>();
        stmtTempTypes = new List<Node>();
        loopScopeBase = 0;
        externDecls = new List<string>();
        crcEmitted = false;
        crc32cEmitted = false;
        tidNames = new List<string>();
    }

    // The raw C-ABI symbol an extern (DllImport) method binds to: the
    // EntryPoint override when given (stored in sval2), else the method name.
    string ExternName(Node m) {
        if (m.sval2 != "") { return m.sval2; }
        return m.sval;
    }

    // Pre-register the C symbols already `declare`d in the module header so a
    // [DllImport] of e.g. calloc/malloc does not emit a duplicate declaration.
    void SeedExternBuiltins() {
        externDecls.Add("printf"); externDecls.Add("malloc"); externDecls.Add("calloc");
        externDecls.Add("realloc"); externDecls.Add("free"); externDecls.Add("strlen");
        externDecls.Add("strcmp"); externDecls.Add("strcpy"); externDecls.Add("strcat");
        externDecls.Add("memcpy"); externDecls.Add("snprintf"); externDecls.Add("fopen");
        externDecls.Add("memmove"); externDecls.Add("memset"); externDecls.Add("memcmp");
        externDecls.Add("fseek"); externDecls.Add("ftell"); externDecls.Add("fread");
        externDecls.Add("fwrite"); externDecls.Add("fclose"); externDecls.Add("_setjmp");
        externDecls.Add("longjmp"); externDecls.Add("exit"); externDecls.Add("atoi");
    }

    bool ExternSeen(string name) {
        int i = 0;
        while (i < externDecls.Count) {
            if (externDecls[i] == name) { return true; }
            i = i + 1;
        }
        return false;
    }

    // Emit `declare <ret> @<sym>(<params>)` for a [DllImport] extern method,
    // deduplicated against builtins and prior declarations. Calls route to the
    // raw symbol via MethodSym.
    void DeclareExtern(Node cls, Node m) {
        string sym = ExternName(m);
        // NativeMemory hardware helpers live in the C runtime under zan_hw_*
        // (matches the C host's symbol routing); inline-lowered methods are
        // filtered out by the caller before we get here
        if (cls.sval == "NativeMemory") { sym = "zan_hw_" + sym; }
        if (ExternSeen(sym)) { return; }
        externDecls.Add(sym);
        string rt = MapType(m.type);
        string sig = "declare " + rt + " @" + sym + "(";
        int first = 1;
        int i = 0;
        while (i < m.kids.Count) {
            Node p = m.kids[i];
            if (p.kind == AK.Param()) {
                if (first == 0) { sig = sig + ", "; }
                sig = sig + MapType(p.type);
                first = 0;
            }
            i = i + 1;
        }
        sig = sig + ")";
        H(sig);
    }

    string NT() { tmp = tmp + 1; return "%t" + tmp; }
    // entry 槽位名（ARC 临时值溢出用）：%z 前缀，EmitTempReleases 据此
    // 区分“寄存器值”与“槽位值”。
    string NTS() { tmp = tmp + 1; return "%z" + tmp; }
    int NL() { lbl = lbl + 1; return lbl; }
    void L(string s) { body.Append(s); body.Append("\n"); }
    // Emit an alloca into the function's entry block when a hoist buffer is
    // active, so locals declared inside loop bodies reuse one stack slot per
    // call instead of growing the stack every iteration at -O0.
    void EA(string reg, string lt) {
        if (eaActive) { entryAllocas.Append("  " + reg + " = alloca " + lt + "\n"); }
        else { L("  " + reg + " = alloca " + lt); }
    }
    void H(string s) { head.Append(s); head.Append("\n"); }
    void Label(int n) { body.Append("L" + n + ":\n"); term = false; curLbl = "L" + n; }

    Node MkType(string name) { Node t = new Node(AK.TypeRef()); t.sval = name; return t; }

    // ---- type mapping ----
    // ---- generics (type erasure) ----
    // A type is "erased" if its name is a generic type parameter of some class;
    // all such types are lowered to i64 slots (pointers packed via ptrtoint).
    // An ARRAY whose element type is a parameter is NOT erased: the array
    // itself travels as its element-slot pointer (i64*) -- the element type
    // is what gets erased, not the array. Treating `T[]` as erased made the
    // field store pack it into an i64 slot while the field load read an
    // i64* -- the two ends disagreed and the array pointer was lost.
    bool IsErasedType(Node t) {
        if (t == null) { return false; }
        if (t.ival >= 1) { return false; }
        if (!IsTypeParamName(t.sval)) { return false; }
        // A type parameter shadows a user type of the same name -- but only
        // inside the scope that DECLARES it. `class T` next to `Binding<T>`:
        // inside Binding's body `T` is the parameter, everywhere else it is
        // the user class. Erasing it everywhere turned the user class into an
        // i64 slot and the program stored a pointer into it.
        string scope = typeScopeCls;
        if (scope == "") { scope = curClass; }
        if (IsTypeParamOf(scope, t.sval)) { return true; }
        if (curMethodNode != null && IsTypeParamOf(curMethodNode, t.sval)) { return true; }
        // a user type with that name: outside the declaring scope the name
        // refers to the user type, not to the parameter
        if (binder.FindType(t.sval) != null) { return false; }
        return true;
    }

    // is the name a type parameter of that class (or of that method)?
    bool IsTypeParamOf(Node owner, string name) {
        if (owner == null) { return false; }
        int i = 0;
        while (i < owner.kids.Count) {
            Node k = owner.kids[i];
            if (k.kind == AK.TypeParam() && k.sval == name) { return true; }
            i = i + 1;
        }
        return false;
    }

    bool IsTypeParamOf(string clsName, string name) {
        if (clsName == "") { return false; }
        return IsTypeParamOf(binder.FindType(clsName), name);
    }

    // is the name a type parameter somewhere in the program?
    bool IsTypeParamName(string name) {
        int i = 0;
        while (i < tparamNames.Count) { if (tparamNames[i] == name) { return true; } i = i + 1; }
        return false;
    }

    // Map a type that was written in ANOTHER class's scope (a method's own
    // declared types): there a type parameter shadows a user type of the
    // same name, so the erasure decision must use that class's scope.
    string MapTypeDecl(Node t, string declCls) {
        string saved = typeScopeCls;
        typeScopeCls = declCls;
        string r = MapType(t);
        typeScopeCls = saved;
        return r;
    }

    // the same, for the erasure test
    bool IsErasedTypeDecl(Node t, string declCls) {
        string saved = typeScopeCls;
        typeScopeCls = declCls;
        bool r = IsErasedType(t);
        typeScopeCls = saved;
        return r;
    }

    List<string> TParams(Node cls) {
        List<string> r = new List<string>();
        if (cls == null) { return r; }
        int i = 0;
        while (i < cls.kids.Count) {
            if (cls.kids[i].kind == AK.TypeParam()) { r.Add(cls.kids[i].sval); }
            i = i + 1;
        }
        return r;
    }

    // resolve an erased type to the concrete argument supplied by a receiver's
    // static type (e.g. T in Box<int> -> int); returns t itself when unresolved.
    Node ConcreteTP(Node t, Node recvTy) {
        if (!IsErasedType(t)) { return t; }
        if (recvTy == null) { return t; }
        Node cls = binder.FindType(recvTy.sval);
        List<string> tps = TParams(cls);
        int i = 0;
        while (i < tps.Count) {
            if (tps[i] == t.sval) {
                if (i < recvTy.kids.Count) { return recvTy.kids[i]; }
                return t;
            }
            i = i + 1;
        }
        return t;
    }

    bool IsNullable(Node t) { return t != null && t.op == 1; }

    bool IsPrimValue(Node t) {
        if (t == null) { return false; }
        string n = t.sval;
        return n == "int" || n == "long" || n == "bool" || n == "char" || n == "byte" || n == "short" || n == "double" || n == "float" || n == "uint" || n == "ulong" || n == "ushort" || n == "sbyte" || n == "nint";
    }

    bool IsNullableValue(Node t) { return IsNullable(t) && IsPrimValue(t); }

    string UnderLL(Node t) {
        if (t.sval == "double" || t.sval == "float") { return "double"; }
        return "i64";
    }

    // box a value into a heap slot, returning the i8* handle (null = no value)
    string BoxVal(ExprVal v, Node ty) {
        string ult = UnderLL(ty);
        string raw = NT();
        L("  " + raw + " = call i8* @malloc(i64 8)");
        string p = NT();
        L("  " + p + " = bitcast i8* " + raw + " to " + ult + "*");
        L("  store " + ult + " " + Coerce(v, ult) + ", " + ult + "* " + p);
        return raw;
    }

    // operand to store into a nullable value-type slot (i8*)
    string BoxFor(ExprVal v, Node ty) {
        if (v.op == "null") { return "null"; }
        if (IsNullableValue(v.ty)) { return v.op; }
        return BoxVal(v, ty);
    }

    // ---- NativeMemory intrinsics (mirror src/compiler/irgen.c) ----
    // A raw address may be an i64 (nint) or already an i8* / pointer type (such as string).
    // addr(base,off) yields an i8* at base+off.
    string NmAddr(ExprVal v, string off) {
        string vt = MapType(v.ty);
        string p = v.op;
        if (vt == "i64") {
            p = NT();
            L("  " + p + " = inttoptr i64 " + v.op + " to i8*");
        } else if (vt != "i8*") {
            p = NT();
            L("  " + p + " = bitcast " + vt + " " + v.op + " to i8*");
        }
        if (off == "0") { return p; }
        string a = NT();
        L("  " + a + " = getelementptr i8, i8* " + p + ", i64 " + off);
        return a;
    }

    // Emit the self-contained CRC32 (IEEE 802.3, reflected poly 0xEDB88320)
    // helper and its compile-time-computed 256-entry table, once per module.
    void EmitCrc32Helper() {
        if (crcEmitted) { return; }
        crcEmitted = true;
        string tab = "";
        int i = 0;
        while (i < 256) {
            // the reflected polynomial and every intermediate word are unsigned
            // 32-bit quantities, so the lane is a long (int is signed 32-bit).
            long c = i;
            int k = 0;
            while (k < 8) {
                if ((c & 1) != 0) { c = 3988292384 ^ (c >> 1); }
                else { c = c >> 1; }
                k = k + 1;
            }
            if (i > 0) { tab = tab + ", "; }
            tab = tab + "i32 " + c;
            i = i + 1;
        }
        H("@__zan_crc32_table = private unnamed_addr constant [256 x i32] [" + tab + "]");
        H("define internal i64 @__zan_nm_crc32(i8* %data, i64 %len) {");
        H("entry:");
        H("  br label %loop");
        H("loop:");
        H("  %i = phi i64 [ 0, %entry ], [ %ni, %body ]");
        H("  %crc = phi i32 [ -1, %entry ], [ %nc, %body ]");
        H("  %inr = icmp slt i64 %i, %len");
        H("  br i1 %inr, label %body, label %done");
        H("body:");
        H("  %bp = getelementptr i8, i8* %data, i64 %i");
        H("  %b = load i8, i8* %bp");
        H("  %b32 = zext i8 %b to i32");
        H("  %x = xor i32 %crc, %b32");
        H("  %ti = and i32 %x, 255");
        H("  %ti64 = zext i32 %ti to i64");
        H("  %ep = getelementptr [256 x i32], [256 x i32]* @__zan_crc32_table, i64 0, i64 %ti64");
        H("  %te = load i32, i32* %ep");
        H("  %sh = lshr i32 %crc, 8");
        H("  %nc = xor i32 %te, %sh");
        H("  %ni = add i64 %i, 1");
        H("  br label %loop");
        H("done:");
        H("  %fin = xor i32 %crc, -1");
        H("  %fin64 = zext i32 %fin to i64");
        H("  ret i64 %fin64");
        H("}");
    }

    // Lower a NativeMemory.<Method>(...) call inline, mirroring the C host.
    // Returns null when the call is not a recognised intrinsic.
    ExprVal GenNativeMemory(Node callee, Node e) {
        string m = callee.sval;
        int argc = e.kids.Count;
        if (m == "Alloc" && argc == 1) {
            ExprVal sz = GenExpr(e.kids[0]);
            string p = NT();
            L("  " + p + " = call i8* @calloc(i64 " + sz.op + ", i64 1)");
            string a = NT();
            L("  " + a + " = ptrtoint i8* " + p + " to i64");
            return new ExprVal(a, MkType("nint"));
        }
        if (m == "Free" && argc == 1) {
            ExprVal p = GenExpr(e.kids[0]);
            string fp = NT();
            L("  " + fp + " = inttoptr i64 " + p.op + " to i8*");
            L("  call void @free(i8* " + fp + ")");
            return new ExprVal("0", MkType("void"));
        }
        if (m == "Copy" && argc == 3) {
            ExprVal dst = GenExpr(e.kids[0]);
            ExprVal src = GenExpr(e.kids[1]);
            ExprVal n = GenExpr(e.kids[2]);
            string dp = NmAddr(dst, "0");
            string spp = NmAddr(src, "0");
            L("  call i8* @memmove(i8* " + dp + ", i8* " + spp + ", i64 " + n.op + ")");
            return new ExprVal("0", MkType("void"));
        }
        if (m == "Fill" && argc == 3) {
            ExprVal p = GenExpr(e.kids[0]);
            ExprVal v = GenExpr(e.kids[1]);
            ExprVal n = GenExpr(e.kids[2]);
            string dp = NmAddr(p, "0");
            string vb = NT();
            L("  " + vb + " = trunc i64 " + v.op + " to i32");
            L("  call i8* @memset(i8* " + dp + ", i32 " + vb + ", i64 " + n.op + ")");
            return new ExprVal("0", MkType("void"));
        }
        if (m == "Compare" && argc == 3) {
            ExprVal a = GenExpr(e.kids[0]);
            ExprVal b = GenExpr(e.kids[1]);
            ExprVal n = GenExpr(e.kids[2]);
            string ap = NmAddr(a, "0");
            string bp = NmAddr(b, "0");
            string r = NT();
            L("  " + r + " = call i32 @memcmp(i8* " + ap + ", i8* " + bp + ", i64 " + n.op + ")");
            string r64 = NT();
            L("  " + r64 + " = sext i32 " + r + " to i64");
            return new ExprVal(r64, MkType("int"));
        }
        if (m == "GetString" && argc == 3) {
            ExprVal p = GenExpr(e.kids[0]);
            ExprVal off = GenExpr(e.kids[1]);
            ExprVal len = GenExpr(e.kids[2]);
            string s = NT();
            L("  " + s + " = call i8* @zstr_new(i64 " + len.op + ")");
            string src = NmAddr(p, off.op);
            L("  call i8* @memcpy(i8* " + s + ", i8* " + src + ", i64 " + len.op + ")");
            return new ExprVal(s, MkType("string"));
        }
        if (m == "PutString" && argc == 4) {
            ExprVal p = GenExpr(e.kids[0]);
            ExprVal off = GenExpr(e.kids[1]);
            ExprVal s = GenExpr(e.kids[2]);
            ExprVal len = GenExpr(e.kids[3]);
            string dp = NmAddr(p, off.op);
            L("  call i8* @memcpy(i8* " + dp + ", i8* " + s.op + ", i64 " + len.op + ")");
            return new ExprVal("0", MkType("void"));
        }
        if (m == "Crc32" && argc == 2) {
            EmitCrc32Helper();
            ExprVal p = GenExpr(e.kids[0]);
            ExprVal len = GenExpr(e.kids[1]);
            string dp = NmAddr(p, "0");
            string r = NT();
            L("  " + r + " = call i64 @__zan_nm_crc32(i8* " + dp + ", i64 " + len.op + ")");
            return new ExprVal(r, MkType("int"));
        }
        if (m == "Crc32C" && argc == 2) {
            EmitCrc32CHelper();
            ExprVal p = GenExpr(e.kids[0]);
            ExprVal len = GenExpr(e.kids[1]);
            string dp = NmAddr(p, "0");
            string r = NT();
            L("  " + r + " = call i64 @__zan_nm_crc32c(i8* " + dp + ", i64 " + len.op + ")");
            return new ExprVal(r, MkType("int"));
        }
        if (m == "Crc32CUpdate" && argc == 3) {
            EmitCrc32CHelper();
            ExprVal crc = GenExpr(e.kids[0]);
            ExprVal p = GenExpr(e.kids[1]);
            ExprVal len = GenExpr(e.kids[2]);
            string dp = NmAddr(p, "0");
            string r = NT();
            L("  " + r + " = call i64 @__zan_nm_crc32c_update(i64 " + crc.op + ", i8* " + dp + ", i64 " + len.op + ")");
            return new ExprVal(r, MkType("int"));
        }
        if (m == "Find" && argc == 4) {
            // Find(p, off, b, n): memchr over the window; -1 when absent
            ExprVal p = GenExpr(e.kids[0]);
            ExprVal off = GenExpr(e.kids[1]);
            ExprVal b = GenExpr(e.kids[2]);
            ExprVal n = GenExpr(e.kids[3]);
            if (!ExternSeen("memchr")) { externDecls.Add("memchr"); H("declare i8* @memchr(i8*, i32, i64)"); }
            string bp = NT();
            L("  " + bp + " = trunc i64 " + b.op + " to i32");
            string hit = NT();
            L("  " + hit + " = call i8* @memchr(i8* " + NmAddr(p, off.op) + ", i32 " + bp + ", i64 " + n.op + ")");
            string isnull = NT();
            L("  " + isnull + " = icmp eq i8* " + hit + ", null");
            string at = NT();
            L("  " + at + " = ptrtoint i8* " + hit + " to i64");
            string base0 = NT();
            L("  " + base0 + " = ptrtoint i8* " + NmAddr(p, "0") + " to i64");
            // the hit offset is measured from the base pointer, not from the
            // window start: the C host returns at - p, so the window offset
            // is already inside `rel` (it is part of the memchr address).
            string rel = NT();
            L("  " + rel + " = sub i64 " + at + ", " + base0);
            string r = NT();
            L("  " + r + " = select i1 " + isnull + ", i64 -1, i64 " + rel);
            return new ExprVal(r, MkType("int"));
        }
        if (m == "FindNotAnyOf" && argc == 4) {
            // FindNotAnyOf(p, off, rejectSet, n): the offset of the first byte
            // that is NOT in the reject set; -1 when the whole window is made
            // of rejected bytes (the C host's strcspn lowering).
            ExprVal p = GenExpr(e.kids[0]);
            ExprVal off = GenExpr(e.kids[1]);
            ExprVal setv = GenExpr(e.kids[2]);
            ExprVal n = GenExpr(e.kids[3]);
            if (!ExternSeen("strcspn")) { externDecls.Add("strcspn"); H("declare i64 @strcspn(i8*, i8*)"); }
            string run = NT();
            L("  " + run + " = call i64 @strcspn(i8* " + NmAddr(p, off.op) + ", i8* " + setv.op + ")");
            string clean = NT();
            L("  " + clean + " = icmp uge i64 " + run + ", " + n.op);
            string r = NT();
            L("  " + r + " = select i1 " + clean + ", i64 -1, i64 " + run);
            return new ExprVal(r, MkType("int"));
        }
        if (m == "ScanNotAnyOf" && argc == 4) {
            // ScanNotAnyOf(p, off, acceptSet, n): the length of the leading run
            // of bytes that ARE in the accept set, capped at n.
            ExprVal p = GenExpr(e.kids[0]);
            ExprVal off = GenExpr(e.kids[1]);
            ExprVal setv = GenExpr(e.kids[2]);
            ExprVal n = GenExpr(e.kids[3]);
            if (!ExternSeen("strspn")) { externDecls.Add("strspn"); H("declare i64 @strspn(i8*, i8*)"); }
            string run = NT();
            L("  " + run + " = call i64 @strspn(i8* " + NmAddr(p, off.op) + ", i8* " + setv.op + ")");
            string over = NT();
            L("  " + over + " = icmp ugt i64 " + run + ", " + n.op);
            string r = NT();
            L("  " + r + " = select i1 " + over + ", i64 " + n.op + ", i64 " + run);
            return new ExprVal(r, MkType("int"));
        }
        if (m == "Base64Encode" && argc == 2) {
            // Base64Encode(ptr, size) -> heap string (length = ((len+2)/3)*4 + 1)
            ExprVal p = GenExpr(e.kids[0]);
            ExprVal len = GenExpr(e.kids[1]);
            if (!ExternSeen("zan_hw_base64_encode")) {
                externDecls.Add("zan_hw_base64_encode");
                H("declare i64 @zan_hw_base64_encode(i8*, i64, i8*)");
            }
            string sp = NT();
            L("  " + sp + " = add i64 " + len.op + ", 2");
            string d3 = NT();
            L("  " + d3 + " = sdiv i64 " + sp + ", 3");
            string m4 = NT();
            L("  " + m4 + " = mul i64 " + d3 + ", 4");
            string cap = NT();
            L("  " + cap + " = add i64 " + m4 + ", 1");
            string s = NT();
            L("  " + s + " = call i8* @malloc(i64 " + cap + ")");
            string w = NT();
            L("  " + w + " = call i64 @zan_hw_base64_encode(i8* " + NmAddr(p, "0") + ", i64 " + len.op + ", i8* " + s + ")");
            string m = NT();
            L("  " + m + " = call i8* @zstr_new(i64 " + w + ")");
            L("  call i8* @memcpy(i8* " + m + ", i8* " + s + ", i64 " + w + ")");
            return new ExprVal(m, MkType("string"));
        }
        if (m == "Base64Decode" && argc == 3) {
            // Base64Decode(dst, src, size) -> written bytes
            ExprVal dst = GenExpr(e.kids[0]);
            ExprVal src = GenExpr(e.kids[1]);
            ExprVal size = GenExpr(e.kids[2]);
            if (!ExternSeen("zan_hw_base64_decode")) {
                externDecls.Add("zan_hw_base64_decode");
                H("declare i64 @zan_hw_base64_decode(i8*, i64, i8*)");
            }
            string w = NT();
            L("  " + w + " = call i64 @zan_hw_base64_decode(i8* " + NmAddr(src, "0") + ", i64 " + size.op + ", i8* " + NmAddr(dst, "0") + ")");
            return new ExprVal(w, MkType("int"));
        }
        return null;
    }

    // Self-contained CRC32C (Castagnoli, reflected poly 0x82F63B78) helpers,
    // mirroring the C host's __zan_nm_crc32c / __zan_nm_crc32c_update.
    void EmitCrc32CHelper() {
        if (crc32cEmitted) { return; }
        crc32cEmitted = true;
        string tab = "";
        int i = 0;
        while (i < 256) {
            long c = i;
            int k = 0;
            while (k < 8) {
                if ((c & 1) != 0) { c = -2040169354 ^ (c >> 1); }
                else { c = c >> 1; }
                k = k + 1;
            }
            if (i > 0) { tab = tab + ", "; }
            tab = tab + "i32 " + c;
            i = i + 1;
        }
        H("@__zan_crc32c_table = private unnamed_addr constant [256 x i32] [" + tab + "]");
        H("define internal i64 @__zan_crc32c_scan(i32 %crc, i8* %data, i64 %len) {");
        H("entry:");
        H("  br label %loop");
        H("loop:");
        H("  %i = phi i64 [ 0, %entry ], [ %ni, %body ]");
        H("  %c = phi i32 [ %crc, %entry ], [ %nc, %body ]");
        H("  %inr = icmp slt i64 %i, %len");
        H("  br i1 %inr, label %body, label %done");
        H("body:");
        H("  %bp = getelementptr i8, i8* %data, i64 %i");
        H("  %b = load i8, i8* %bp");
        H("  %b32 = zext i8 %b to i32");
        H("  %x = xor i32 %c, %b32");
        H("  %ti = and i32 %x, 255");
        H("  %ti64 = zext i32 %ti to i64");
        H("  %ep = getelementptr [256 x i32], [256 x i32]* @__zan_crc32c_table, i64 0, i64 %ti64");
        H("  %te = load i32, i32* %ep");
        H("  %sh = lshr i32 %c, 8");
        H("  %nc = xor i32 %te, %sh");
        H("  %ni = add i64 %i, 1");
        H("  br label %loop");
        H("done:");
        H("  %fin = xor i32 %c, -1");
        H("  %fin64 = zext i32 %fin to i64");
        H("  ret i64 %fin64");
        H("}");
        H("define internal i64 @__zan_nm_crc32c(i8* %data, i64 %len) {");
        H("  %r = call i64 @__zan_crc32c_scan(i32 -1, i8* %data, i64 %len)");
        H("  ret i64 %r");
        H("}");
        H("define internal i64 @__zan_nm_crc32c_update(i64 %seed, i8* %data, i64 %len) {");
        H("entry:");
        H("  %s32 = trunc i64 %seed to i32");
        H("  %inv = xor i32 %s32, -1");
        H("  %r = call i64 @__zan_crc32c_scan(i32 %inv, i8* %data, i64 %len)");
        H("  ret i64 %r");
        H("}");
    }

    // ---- hardware SIMD + bit builtins (mirror the C host's emit_vector128_call
    // and the BitOperations intrinsics). A Vector128/256 value is a first-class
    // LLVM vector (<2 x i64> / <4 x i64>); memory-facing helpers materialise it
    // from unaligned i8* loads/stores. Returns null when the call is not a
    // recognised builtin so the ordinary static-call path handles it.
    string VecBytePtr(ExprVal a) { return NmAddr(a, "0"); }

    // Load N bytes from an address (arg 0, optionally arg 1 = byte offset or
    // element offset) into a <N/8 x i64> vector.
    ExprVal VecLoad(Node e, int bits) {
        string vt = "<" + (bits / 64) + " x i64>";
        ExprVal vb = GenExpr(e.kids[0]);
        string off = "0";
        if (e.kids.Count == 2) {
            ExprVal o = GenExpr(e.kids[1]);
            // byte[]/float[] + int: the offset is an element index; scale to bytes
            bool isArr = vb.ty != null && vb.ty.ival >= 1;
            if (isArr) {
                string scaled = NT();
                L("  " + scaled + " = mul i64 " + o.op + ", 8");
                off = scaled;
            } else {
                off = o.op;
            }
        }
        string bp = VecBytePtr(vb);
        string p = NT();
        if (off == "0") {
            L("  " + p + " = bitcast i8* " + bp + " to " + vt + "*");
        } else {
            string ap = NT();
            L("  " + ap + " = getelementptr i8, i8* " + bp + ", i64 " + off);
            L("  " + p + " = bitcast i8* " + ap + " to " + vt + "*");
        }
        string v = NT();
        L("  " + v + " = load " + vt + ", " + vt + "* " + p);
        Node rt = MkType(bits == 128 ? "Vector128" : "Vector256");
        return new ExprVal(v, rt);
    }

    // bitwise/arithmetic vector op over two vector operands
    ExprVal VecBinOp(Node e, string op, string resTy) {
        ExprVal a = GenExpr(e.kids[0]);
        ExprVal b = GenExpr(e.kids[1]);
        string at = MapType(a.ty);
        string r = NT();
        L("  " + r + " = " + op + " " + at + " " + a.op + ", " + b.op);
        return new ExprVal(r, MkType(resTy));
    }

    // broadcast a scalar into all lanes of a <N x i64> vector
    ExprVal VecCreate(Node e, int bits) {
        ExprVal a = GenExpr(e.kids[0]);
        string vt = "<" + (bits / 64) + " x i64>";
        string wide = a.op;
        if (a.ty != null && a.ty.sval == "int") {
            // sign-extend int -> i64 so the broadcast is exact per lane
            string sx = NT();
            L("  " + sx + " = shl i64 " + a.op + ", 32");
            string sx2 = NT();
            L("  " + sx2 + " = ashr i64 " + sx + ", 32");
            wide = sx2;
        }
        string r = NT();
        L("  " + r + " = insertelement " + vt + " undef, i64 " + wide + ", i32 0");
        int lane = 1;
        while (lane < bits / 64) {
            string r2 = NT();
            L("  " + r2 + " = insertelement " + vt + " " + r + ", i64 " + wide + ", i32 " + lane);
            r = r2;
            lane = lane + 1;
        }
        return new ExprVal(r, MkType(bits == 128 ? "Vector128" : "Vector256"));
    }

    // declare an LLVM intrinsic: sig carries only the parameter types ("i64, i1"),
    // ret is the return type — emitted as `declare <ret> @name(<sig>)`
    void EnsureIntrinsic(string name, string ret, string sig) {
        if (ExternSeen(name)) { return; }
        externDecls.Add(name);
        H("declare " + ret + " @" + name + "(" + sig + ")");
    }

    // AES round function on two <2 x i64> operands (bitcast through <16 x i8>
    // for the aesni intrinsics; xor-with-key for the "last" variants as the C
    // host does). With xorKey the second operand is the round key and the
    // intrinsic runs on the value alone, then XORs the key into the result.
    ExprVal VecAesOp(Node e, string intrin, bool notUsed) {
        ExprVal a = GenExpr(e.kids[0]);
        ExprVal k = GenExpr(e.kids[1]);
        string vt = "<2 x i64>";
        string v8 = "<16 x i8>";
        EnsureIntrinsic(intrin, v8, v8 + ", " + v8);
        string a8 = NT();
        L("  " + a8 + " = bitcast " + vt + " " + a.op + " to " + v8);
        string z = NT();
        L("  " + z + " = zeroinitializer");
        string z8 = NT();
        L("  " + z8 + " = bitcast " + vt + " " + z + " to " + v8);
        string r8 = NT();
        L("  " + r8 + " = call " + v8 + " @" + intrin + "(" + v8 + " " + a8 + ", " + v8 + " " + z8 + ")");
        string r64 = NT();
        L("  " + r64 + " = bitcast " + v8 + " " + r8 + " to " + vt);
        string r = NT();
        L("  " + r + " = xor " + vt + " " + r64 + ", " + k.op);
        return new ExprVal(r, MkType("Vector128"));
    }

    // Dispatch a static call on a builtin type to its inline lowering.
    // Returns null when the method is not a recognised builtin (caller falls
    // through to the ordinary static-call path).
    ExprVal GenBuiltinStatic(string cls, string m, Node e) {
        int argc = e.kids.Count;
        if (cls == "Vector128" || cls == "Vector256") {
            int bits = cls == "Vector128" ? 128 : 256;
            string rty = bits == 128 ? "Vector128" : "Vector256";
            if (m == "Load" && (argc == 1 || argc == 2)) { return VecLoad(e, bits); }
            if (m == "LoadVector128" && argc == 1) { return VecLoad(e, bits); }
            if (m == "Store" && (argc == 2 || argc == 3)) {
                ExprVal dst = GenExpr(e.kids[0]);
                ExprVal v = GenExpr(e.kids[argc - 1]);
                string vt = MapType(v.ty);
                if (argc == 3) {
                    ExprVal o = GenExpr(e.kids[1]);
                    bool isArr = dst.ty != null && dst.ty.ival >= 1;
                    string off = o.op;
                    if (isArr) {
                        string scaled = NT();
                        L("  " + scaled + " = mul i64 " + o.op + ", 8");
                        off = scaled;
                    }
                    string bp = VecBytePtr(dst);
                    string ap = NT();
                    L("  " + ap + " = getelementptr i8, i8* " + bp + ", i64 " + off);
                    string p = NT();
                    L("  " + p + " = bitcast i8* " + ap + " to " + vt + "*");
                    L("  store " + vt + " " + v.op + ", " + vt + "* " + p);
                } else {
                    string dbp = VecBytePtr(dst);
                    string p = NT();
                    L("  " + p + " = bitcast i8* " + dbp + " to " + vt + "*");
                    L("  store " + vt + " " + v.op + ", " + vt + "* " + p);
                }
                return new ExprVal("0", MkType("void"));
            }
            if (m == "Create" && argc == 1) { return VecCreate(e, bits); }
            if (m == "Zero" && argc == 0) {
                return new ExprVal("zeroinitializer", MkType(rty));
            }
            if (m == "AllBitsSet" && argc == 0) {
                string vt = "<" + (bits / 64) + " x i64>";
                string ones = NT();
                L("  " + ones + " = insertelement " + vt + " undef, i64 -1, i32 0");
                int lane = 1;
                while (lane < bits / 64) {
                    string r2 = NT();
                    L("  " + r2 + " = insertelement " + vt + " " + ones + ", i64 -1, i32 " + lane);
                    ones = r2;
                    lane = lane + 1;
                }
                return new ExprVal(ones, MkType(rty));
            }
            // element-wise bitwise / arithmetic (i64 lanes)
            if (m == "And" && argc == 2) { return VecBinOp(e, "and", rty); }
            if (m == "Or" && argc == 2) { return VecBinOp(e, "or", rty); }
            if (m == "Xor" && argc == 2) { return VecBinOp(e, "xor", rty); }
            if (m == "AndNot" && argc == 2) {
                // ~a & b via xor with all-ones then and (mirror C host semantics)
                ExprVal a = GenExpr(e.kids[0]);
                ExprVal b = GenExpr(e.kids[1]);
                string vt = "<" + (bits / 64) + " x i64>";
                string ones = NT();
                L("  " + ones + " = insertelement " + vt + " undef, i64 -1, i32 0");
                int lane = 1;
                while (lane < bits / 64) {
                    string r2 = NT();
                    L("  " + r2 + " = insertelement " + vt + " " + ones + ", i64 -1, i32 " + lane);
                    ones = r2;
                    lane = lane + 1;
                }
                string na = NT();
                L("  " + na + " = xor " + vt + " " + a.op + ", " + ones);
                string r = NT();
                L("  " + r + " = and " + vt + " " + na + ", " + b.op);
                return new ExprVal(r, MkType(rty));
            }
            if (m == "Add" && argc == 2) { return VecBinOp(e, "add", rty); }
            if (m == "Subtract" && argc == 2) { return VecBinOp(e, "sub", rty); }
            if (m == "Multiply" && argc == 2) { return VecBinOp(e, "mul", rty); }
            if ((m == "AddSaturate" || m == "SubtractSaturate") && argc == 2) {
                // per-lane saturating add/sub (the intrinsic exists in LLVM 9+;
                // stdlib byte paths use u8 lanes packed into i64 lanes)
                ExprVal a = GenExpr(e.kids[0]);
                ExprVal b = GenExpr(e.kids[1]);
                string vt = "<" + (bits / 64) + " x i64>";
                string opn = m == "AddSaturate" ? "llvm.uadd.sat" : "llvm.usub.sat";
                string full = opn + ".v" + (bits / 64) + "i64";
                if (!ExternSeen(full)) { externDecls.Add(full); H("declare " + vt + " @" + full + "(" + vt + ", " + vt + ")"); }
                string fn = NT();
                L("  " + fn + " = call " + vt + " @" + opn + ".v" + (bits / 64) + "i64(" + vt + " " + a.op + ", " + vt + " " + b.op + ")");
                return new ExprVal(fn, MkType(rty));
            }
            if ((m == "Equals" || m == "CompareEqual") && argc == 2) {
                ExprVal a = GenExpr(e.kids[0]);
                ExprVal b = GenExpr(e.kids[1]);
                string vt = "<" + (bits / 64) + " x i64>";
                string c = NT();
                L("  " + c + " = icmp eq " + vt + " " + a.op + ", " + b.op);
                string r = NT();
                L("  " + r + " = sext <" + vt.Substring(1, vt.IndexOf(" x")) + " x i1> " + c + " to " + vt);
                return new ExprVal(r, MkType(rty));
            }
            if (m == "GreaterThan" && argc == 2) {
                ExprVal a = GenExpr(e.kids[0]);
                ExprVal b = GenExpr(e.kids[1]);
                string vt = "<" + (bits / 64) + " x i64>";
                string c = NT();
                L("  " + c + " = icmp sgt " + vt + " " + a.op + ", " + b.op);
                string r = NT();
                L("  " + r + " = sext <" + vt.Substring(1, vt.IndexOf(" x")) + " x i1> " + c + " to " + vt);
                return new ExprVal(r, MkType(rty));
            }
            if (m == "LessThan" && argc == 2) {
                ExprVal a = GenExpr(e.kids[0]);
                ExprVal b = GenExpr(e.kids[1]);
                string vt = "<" + (bits / 64) + " x i64>";
                string c = NT();
                L("  " + c + " = icmp slt " + vt + " " + a.op + ", " + b.op);
                string r = NT();
                L("  " + r + " = sext <" + vt.Substring(1, vt.IndexOf(" x")) + " x i1> " + c + " to " + vt);
                return new ExprVal(r, MkType(rty));
            }
            if (m == "ExtractMostSignificantBits" && argc == 1) {
                // per-64-lane MSB gather: i64 lanes only need bit 63 of each
                ExprVal a = GenExpr(e.kids[0]);
                string vt = "<" + (bits / 64) + " x i64>";
                string l0 = NT();
                L("  " + l0 + " = extractelement " + vt + " " + a.op + ", i32 0");
                string s0 = NT();
                L("  " + s0 + " = lshr i64 " + l0 + ", 63");
                string acc = s0;
                int lane = 1;
                while (lane < bits / 64) {
                    string lv = NT();
                    L("  " + lv + " = extractelement " + vt + " " + a.op + ", i32 " + lane);
                    string sv = NT();
                    L("  " + sv + " = lshr i64 " + lv + ", 63");
                    string sh = NT();
                    L("  " + sh + " = shl i64 " + sv + ", " + lane);
                    string orv = NT();
                    L("  " + orv + " = or i64 " + acc + ", " + sh);
                    acc = orv;
                    lane = lane + 1;
                }
                string t32 = NT();
                L("  " + t32 + " = and i64 " + acc + ", 4294967295");
                string r = NT();
                L("  " + r + " = shl i64 " + t32 + ", 32");
                string r2 = NT();
                L("  " + r2 + " = ashr i64 " + r + ", 32");
                return new ExprVal(r2, MkType("int"));
            }
            if (m == "MoveMask" && argc == 1) { return VecExtractMsb(e, bits); }
        }
        // Sse2 shares the Vector128 shapes (the C host routes Sse2.* through
        // emit_vector128_call as well)
        if (cls == "Sse2") {
            string vt = "<2 x i64>";
            if (m == "LoadVector128" && argc == 1) {
                ExprVal vb = GenExpr(e.kids[0]);
                string bp = VecBytePtr(vb);
                string p = NT();
                L("  " + p + " = bitcast i8* " + bp + " to " + vt + "*");
                string v = NT();
                L("  " + v + " = load " + vt + ", " + vt + "* " + p);
                return new ExprVal(v, MkType("Vector128"));
            }
            if (m == "Store" && argc == 2) {
                ExprVal dst = GenExpr(e.kids[0]);
                ExprVal v = GenExpr(e.kids[1]);
                string dbp = VecBytePtr(dst);
                string p = NT();
                L("  " + p + " = bitcast i8* " + dbp + " to " + vt + "*");
                L("  store " + vt + " " + v.op + ", " + vt + "* " + p);
                return new ExprVal("0", MkType("void"));
            }
            if (m == "And" && argc == 2) { return VecBinOp(e, "and", "Vector128"); }
            if (m == "Or" && argc == 2) { return VecBinOp(e, "or", "Vector128"); }
            if (m == "Xor" && argc == 2) { return VecBinOp(e, "xor", "Vector128"); }
            if (m == "CompareEqual" && argc == 2) {
                ExprVal a = GenExpr(e.kids[0]);
                ExprVal b = GenExpr(e.kids[1]);
                string c = NT();
                L("  " + c + " = icmp eq " + vt + " " + a.op + ", " + b.op);
                string r = NT();
                L("  " + r + " = sext <" + vt.Substring(1, vt.IndexOf(" x")) + " x i1> " + c + " to " + vt);
                return new ExprVal(r, MkType("Vector128"));
            }
            if (m == "MoveMask" && argc == 1) { return VecExtractMsb(e, 128); }
        }
        // AES-NI round intrinsics (the C host's emit_aes_call)
        if (cls == "Aes") {
            string vt = "<2 x i64>";
            string v8 = "<16 x i8>";
            if (m == "Encrypt" && argc == 2) { return VecAesOp(e, "llvm.x86.aesni.aesenc", false); }
            if (m == "EncryptLast" && argc == 2) { return VecAesOp(e, "llvm.x86.aesni.aesenclast", false); }
            if (m == "Decrypt" && argc == 2) { return VecAesOp(e, "llvm.x86.aesni.aesdec", false); }
            if (m == "DecryptLast" && argc == 2) { return VecAesOp(e, "llvm.x86.aesni.aesdeclast", false); }
            if (m == "InverseMixColumns" && argc == 1) {
                ExprVal a = GenExpr(e.kids[0]);
                EnsureIntrinsic("llvm.x86.aesni.aesimc", vt, vt);
                string r = NT();
                L("  " + r + " = call " + vt + " @llvm.x86.aesni.aesimc(" + vt + " " + a.op + ")");
                return new ExprVal(r, MkType("Vector128"));
            }
            if (m == "KeygenAssist" && argc == 2) {
                ExprVal a = GenExpr(e.kids[0]);
                ExprVal rcon = GenExpr(e.kids[1]);
                EnsureIntrinsic("llvm.x86.aesni.aeskeygenassist", vt, vt + ", i8");
                string r8 = NT();
                L("  " + r8 + " = trunc i64 " + rcon.op + " to i8");
                string r = NT();
                L("  " + r + " = call " + vt + " @llvm.x86.aesni.aeskeygenassist(" + vt + " " + a.op + ", i8 " + r8 + ")");
                return new ExprVal(r, MkType("Vector128"));
            }
        }
        if (cls == "BitOperations") {
            if ((m == "PopCount" || m == "Popcount") && argc == 1) {
                ExprVal a = GenExpr(e.kids[0]);
                EnsureIntrinsic("llvm.ctpop.i64", "i64", "i64");
                string r = NT();
                L("  " + r + " = call i64 @llvm.ctpop.i64(i64 " + a.op + ")");
                return new ExprVal(r, MkType("int"));
            }
            if (m == "LeadingZeroCount" && argc == 1) {
                ExprVal a = GenExpr(e.kids[0]);
                EnsureIntrinsic("llvm.ctlz.i64", "i64", "i64, i1");
                string r = NT();
                L("  " + r + " = call i64 @llvm.ctlz.i64(i64 " + a.op + ", i1 false)");
                string r2 = NT();
                L("  " + r2 + " = and i64 " + r + ", 4294967295");
                string r3 = NT();
                L("  " + r3 + " = shl i64 " + r2 + ", 32");
                string r4 = NT();
                L("  " + r4 + " = ashr i64 " + r3 + ", 32");
                return new ExprVal(r4, MkType("int"));
            }
            if (m == "TrailingZeroCount" && argc == 1) {
                ExprVal a = GenExpr(e.kids[0]);
                EnsureIntrinsic("llvm.cttz.i64", "i64", "i64, i1");
                string r = NT();
                L("  " + r + " = call i64 @llvm.cttz.i64(i64 " + a.op + ", i1 false)");
                string r2 = NT();
                L("  " + r2 + " = and i64 " + r + ", 4294967295");
                string r3 = NT();
                L("  " + r3 + " = shl i64 " + r2 + ", 32");
                string r4 = NT();
                L("  " + r4 + " = ashr i64 " + r3 + ", 32");
                return new ExprVal(r4, MkType("int"));
            }
            if (m == "RotateLeft" && argc == 2) {
                ExprVal a = GenExpr(e.kids[0]);
                ExprVal n = GenExpr(e.kids[1]);
                EnsureIntrinsic("llvm.fshl.i64", "i64", "i64, i64, i64");
                string r = NT();
                L("  " + r + " = call i64 @llvm.fshl.i64(i64 " + a.op + ", i64 " + a.op + ", i64 " + n.op + ")");
                return new ExprVal(r, MkType("int"));
            }
            if (m == "RotateRight" && argc == 2) {
                ExprVal a = GenExpr(e.kids[0]);
                ExprVal n = GenExpr(e.kids[1]);
                EnsureIntrinsic("llvm.fshr.i64", "i64", "i64, i64, i64");
                string r = NT();
                L("  " + r + " = call i64 @llvm.fshr.i64(i64 " + a.op + ", i64 " + a.op + ", i64 " + n.op + ")");
                return new ExprVal(r, MkType("int"));
            }
            if (m == "IsPow2" && argc == 1) {
                ExprVal a = GenExpr(e.kids[0]);
                string nz = NT();
                L("  " + nz + " = icmp ne i64 " + a.op + ", 0");
                string m1 = NT();
                L("  " + m1 + " = sub i64 " + a.op + ", 1");
                string p2 = NT();
                L("  " + p2 + " = icmp eq i64 " + a.op + ", " + m1);
                string r = NT();
                L("  " + r + " = and i1 " + nz + ", " + p2);
                string r64 = NT();
                L("  " + r64 + " = zext i1 " + r + " to i64");
                return new ExprVal(r64, MkType("bool"));
            }
            if ((m == "Log2" || m == "Log2Floor") && argc == 1) {
                ExprVal a = GenExpr(e.kids[0]);
                EnsureIntrinsic("llvm.ctlz.i64", "i64", "i64, i1");
                string lz = NT();
                L("  " + lz + " = call i64 @llvm.ctlz.i64(i64 " + a.op + ", i1 false)");
                string r = NT();
                L("  " + r + " = sub i64 63, " + lz);
                return new ExprVal(r, MkType("int"));
            }
        }
        return null;
    }

    // byte-granular pmovmskb equivalent for the byte paths: gather the MSB of
    // each of the 16/32 bytes into an int (mirrors llvm.x86.pmovmskb semantics
    // portably across non-x86 targets, as the C host does).
    ExprVal VecExtractMsb(Node e, int bits) {
        ExprVal a = GenExpr(e.kids[0]);
        string vt = "<" + (bits / 64) + " x i64>";
        int lanes = bits / 64;
        string acc = "0";
        int byteIdx = 0;
        while (byteIdx < bits / 8) {
            int lane = byteIdx / 8;
            int shift = (byteIdx % 8) * 8;
            string lv = NT();
            L("  " + lv + " = extractelement " + vt + " " + a.op + ", i32 " + lane);
            string bv = NT();
            L("  " + bv + " = lshr i64 " + lv + ", " + (shift + 7));
            string bb = NT();
            L("  " + bb + " = and i64 " + bv + ", 1");
            string sb = NT();
            L("  " + sb + " = shl i64 " + bb + ", " + byteIdx);
            string orv = NT();
            L("  " + orv + " = or i64 " + acc + ", " + sb);
            acc = orv;
            byteIdx = byteIdx + 1;
        }
        string t32 = NT();
        L("  " + t32 + " = and i64 " + acc + ", 4294967295");
        string r = NT();
        L("  " + r + " = shl i64 " + t32 + ", 32");
        string r2 = NT();
        L("  " + r2 + " = ashr i64 " + r + ", 32");
        return new ExprVal(r2, MkType("int"));
    }

    string MapType(Node t) {
        if (t == null) { return "void"; }
        string n = t.sval;
        if (IsNullableValue(t)) { return "i8*"; }
        // an array travels as its element-slot pointer (i64*), even when the
        // element type is a generic parameter: the array check has to come
        // BEFORE the erasure check, or `T[]` would be lowered to a bare i64
        // slot and the data pointer would not fit.
        if (t.ival >= 1) { return "i64*"; }
        if (IsErasedType(t)) { return "i64"; }
        if (n == "void") { return "void"; }
        if (n == "string") { return "i8*"; }
        if (n == "double" || n == "float") { return "double"; }
        if (n == "int" || n == "long" || n == "bool" || n == "char" || n == "byte" || n == "short" || n == "uint" || n == "ulong" || n == "ushort" || n == "sbyte" || n == "nint") { return "i64"; }
        if (n == "object" || n == "var") { return "i8*"; }
        if (n == "List" || n == "Dictionary" || n == "Dict") { return "i8*"; }
        if (n == "StringBuilder") { return "i8*"; }
        // hardware vectors travel as first-class LLVM vector values (the C
        // host's ABI); they are never heap objects
        if (n == "Vector128") { return "<2 x i64>"; }
        if (n == "Vector256") { return "<4 x i64>"; }
        // Span<T> is a non-owning view; the host carries { base, len } but the
        // selfhost backend has no aggregate values, so a span travels as its
        // base address (spans are never bounds-checked).
        if (n == "Span") { return "i64"; }
        // A task handle travels as the coroutine frame pointer: an async call
        // hands back the frame (the `__task` pseudo-type of the call site), so
        // a Task-typed slot is a pointer, not an integer.
        if (n == "Task" && binder.FindType(n) == null) { return "i8*"; }
        Node d = binder.FindType(n);
        if (d != null) {
            if (d.kind == AK.EnumDecl()) { return "i64"; }
            return "%" + n + "*";
        }
        return "i8*";
    }

    bool IsPtrType(Node t) {
        string m = MapType(t);
        if (m == "i8*") { return true; }
        int L2 = m.Length;
        if (L2 > 0 && m.Substring(L2 - 1, 1) == "*") { return true; }
        return false;
    }

    bool IsListType(Node t) {
        if (t == null) { return false; }
        if (t.sval == "List") { return true; }
        return false;
    }

    bool IsSbType(Node t) {
        if (t == null) { return false; }
        if (t.sval == "StringBuilder") { return true; }
        return false;
    }

    bool IsSpanType(Node t) {
        if (t == null) { return false; }
        if (t.ival >= 1) { return false; }
        if (t.sval == "Span") { return true; }
        return false;
    }

    Node SpanElem(Node t) {
        if (t != null && t.kids.Count > 0) { return t.kids[0]; }
        return MkType("int");
    }

    // LLVM integer type of one span element (its storage width, not the i64
    // every scalar travels in).
    string SpanIty(Node el) {
        string n = "int";
        if (el != null) { n = el.sval; }
        if (n == "byte" || n == "sbyte" || n == "bool") { return "i8"; }
        if (n == "short" || n == "ushort") { return "i16"; }
        if (n == "int" || n == "uint") { return "i32"; }
        if (n == "double") { return "double"; }
        if (n == "float") { return "float"; }
        return "i64";
    }

    // Whether loading a span element widens without sign extension.
    bool SpanZext(Node el) {
        string n = "int";
        if (el != null) { n = el.sval; }
        if (n == "byte" || n == "bool" || n == "char") { return true; }
        if (n == "ushort" || n == "uint" || n == "ulong") { return true; }
        return false;
    }

    // i8*/i16*/i32*/i64* to the span's element at `idx`.
    string SpanElemPtr(string baseOp, string idxOp, string ity) {
        string bp = NT();
        L("  " + bp + " = inttoptr i64 " + baseOp + " to " + ity + "*");
        string ep = NT();
        L("  " + ep + " = getelementptr " + ity + ", " + ity + "* " + bp + ", i64 " + idxOp);
        return ep;
    }

    bool IsDictType(Node t) {
        if (t == null) { return false; }
        if (t.sval == "Dictionary") { return true; }
        if (t.sval == "Dict") { return true; }
        return false;
    }

    Node DictVal(Node t) {
        if (t != null && t.kids.Count > 1) { return t.kids[1]; }
        return MkType("int");
    }

    Node ListElem(Node t) {
        if (t != null && t.kids.Count > 0) { return t.kids[0]; }
        return MkType("int");
    }

    // class decl referenced by a class-pointer type, or null
    Node ClassOf(Node t) {
        if (t == null) { return null; }
        Node d = binder.FindType(t.sval);
        if (d != null && (d.kind == AK.ClassDecl() || d.kind == AK.StructDecl())) { return d; }
        return null;
    }

    // per-class type descriptor: the global's address is the type identity
    // and its value links to the base class's descriptor (chain walk for
    // catch-clause matching; see GenTry).
    void EmitTid(Node d) {
        Node bt = BaseClassOf(d);
        if (bt != null) {
            H("@__tid_" + d.sval + " = global i8* bitcast (i8** @__tid_" + bt.sval + " to i8*)");
        } else {
            H("@__tid_" + d.sval + " = global i8* null");
        }
        tidNames.Add(d.sval);
    }

    // The built-in containers are heap objects too, so they carry a class id
    // and the runtime type test can tell a List from a Dict -- the C host can.
    // The tid global of a container has no source declaration, so it is
    // emitted here (a user class of the same name takes precedence).
    string ContainerTidName(string ty) {
        if (ty == "List") { return "List"; }
        if (ty == "Dict" || ty == "Dictionary") { return "Dict"; }
        if (ty == "StringBuilder") { return "StringBuilder"; }
        return "";
    }

    // true when `ty` names one of the built-in containers (and no user class
    // took the name)
    bool IsContainerType(string ty) {
        string tn = ContainerTidName(ty);
        if (tn == "") { return false; }
        return binder.FindType(tn) == null;
    }

    // the class-id argument of a container allocation: the address of the
    // container's tid global
    string ContainerCid(string ty) {
        if (!IsContainerType(ty)) { return "null"; }
        return "i8* bitcast (i8** @__tid_" + ContainerTidName(ty) + " to i8*)";
    }

    void EmitContainerTids() {
        List<string> cs = new List<string>();
        cs.Add("List"); cs.Add("Dict"); cs.Add("StringBuilder");
        int i = 0;
        while (i < cs.Count) {
            string cn = cs[i];
            if (binder.FindType(cn) == null) {
                H("@__tid_" + cn + " = global i8* null");
            }
            i = i + 1;
        }
    }

    // `new object()`: a bare heap object with no fields. It only needs a
    // destructor -- the ARC runtime frees the storage.
    void EmitObjectRuntime() {
        H("define void @__zan_object_dtor(i8* %p) {");
        H("  ret void");
        H("}");
    }

    // ---- inheritance / virtual dispatch helpers ----
    Node BaseClassOf(Node cls) {
        if (cls == null) { return null; }
        if (cls.sval2 == "") { return null; }
        return binder.FindType(cls.sval2);
    }

    bool HasMod(Node m, int flag) { return (m.mods / flag) - ((m.mods / flag) / 2) * 2 == 1; }
    bool IsVirtual(Node m) { return HasMod(m, MOD.Virtual()); }
    bool IsOverride(Node m) { return HasMod(m, MOD.Override()); }
    bool IsAbstract(Node m) { return HasMod(m, MOD.Abstract()); }
    // introduces a fresh vtable slot: virtual or abstract, but not an override
    bool IsVSlotIntro(Node m) { return (IsVirtual(m) || IsAbstract(m)) && !IsOverride(m); }

    // A class is polymorphic if it or any ancestor declares a virtual/abstract/
    // override method; such classes carry a vtable pointer in field slot 0.
    // Interfaces are modelled as abstract classes and are polymorphic too.
    bool IsPolyClass(Node cls) {
        if (cls == null) { return false; }
        int i = 0;
        while (i < cls.kids.Count) {
            Node m = cls.kids[i];
            if (m.kind == AK.MethodDecl() && (IsVirtual(m) || IsOverride(m) || IsAbstract(m))) { return true; }
            i = i + 1;
        }
        return IsPolyClass(BaseClassOf(cls));
    }

    // field slot offset: 1 when a vtable pointer occupies slot 0.
    //
    // 类**一律**留这个槽（结构体是值类型，没有）：继承链上只要有一处
    // 偏移不一致，字段就会错位——以前 vptr 槽只在"本类或祖先多态"时才留，
    // 于是 Base（无接口无虚方法）与 Derived : Base, IFace（有 vptr）
    // 给同一个字段两套下标，基类构造器把字段写进了派生对象的 vptr 槽。
    int FieldBase(Node cls) {
        if (cls == null) { return 0; }
        if (cls.kind == AK.StructDecl()) { return 0; }
        return 1;
    }

    // weak fields are non-owning back-references: never retained or released.
    bool WeakTy(Node t) { if (t == null) { return false; } int b = t.mods / 1024; return b - (b / 2) * 2 == 1; }

    // ordered fields, base classes first (layout-compatible with base pointers)
    void CollectFields(Node cls, List<string> names, List<Node> types) {
        if (cls == null) { return; }
        CollectFields(BaseClassOf(cls), names, types);
        int i = 0;
        while (i < cls.kids.Count) {
            Node m = cls.kids[i];
            if (m.kind == AK.FieldDecl() && !IsStatic(m)) { names.Add(m.sval); types.Add(m.type); }
            i = i + 1;
        }
    }

    // ---- static class fields: backed by internal module globals ----
    Node FindStaticField(Node cls, string name) {
        Node c = cls;
        while (c != null) {
            int i = 0;
            while (i < c.kids.Count) {
                Node m = c.kids[i];
                if (m.kind == AK.FieldDecl() && IsStatic(m) && m.sval == name) { return m; }
                i = i + 1;
            }
            c = BaseClassOf(c);
        }
        return null;
    }
    string StaticFieldOwner(Node cls, string name) {
        Node c = cls;
        while (c != null) {
            int i = 0;
            while (i < c.kids.Count) {
                Node m = c.kids[i];
                if (m.kind == AK.FieldDecl() && IsStatic(m) && m.sval == name) { return c.sval; }
                i = i + 1;
            }
            c = BaseClassOf(c);
        }
        return "";
    }
    // ---- generic class instantiations ----
    // The type arguments of a generic-qualified member access (`Stat<int>.s`):
    // the parser keeps them on the access's `d` slot.
    List<Node> InstArgsOf(Node access) {
        if (access == null || access.d == null) { return null; }
        if (access.d.kind != AK.TypeRef() || access.d.sval != "__typeargs") { return null; }
        return access.d.kids;
    }

    // The same, but only when the class is generic and every argument is
    // concrete: an open instantiation (`Stat<T>`) has no own storage.
    List<Node> ConcreteInstArgs(Node access, string clsName) {
        List<Node> a = InstArgsOf(access);
        if (a == null || a.Count == 0) { return null; }
        Node cls = binder.FindType(clsName);
        if (cls == null) { return null; }
        List<string> tps = TParams(cls);
        if (tps.Count == 0 || a.Count != tps.Count) { return null; }
        int i = 0;
        while (i < a.Count) {
            if (a[i] == null || MentionsTypeParam(a[i])) { return null; }
            i = i + 1;
        }
        return a;
    }

    // The suffix that tells one instantiation's storage from another's
    // (`int`, `double`, `string__int`, ...).
    string InstTag(List<Node> args) {
        if (args == null || args.Count == 0) { return ""; }
        string s = "";
        int i = 0;
        while (i < args.Count) {
            if (i > 0) { s = s + "__"; }
            s = s + TypeTag(args[i]);
            i = i + 1;
        }
        return s;
    }

    // The global that holds a static field. A generic class's static field has
    // one global per instantiation (the C host mangles the name with the
    // instantiation suffix); an ordinary class has exactly one.
    string StaticGlobal(string owner, string name, List<Node> args) {
        string g = "@__zan_sf_" + owner;
        string tag = InstTag(args);
        if (tag != "") { g = g + "_" + tag; }
        return g + "_" + name;
    }

    // The type of an instantiation (`Stat<int>`): the class name with the
    // concrete type arguments.
    Node InstType(string clsName, List<Node> args) {
        Node t = new Node(AK.TypeRef());
        t.sval = clsName;
        int i = 0;
        while (i < args.Count) { t.Add(args[i]); i = i + 1; }
        return t;
    }

    // Every instantiation of a generic class the program uses. The C host does
    // the same before emitting (`discover_generic_insts`): a generic class's
    // static storage exists per instantiation, so the backend has to know them
    // all before it emits the globals and the static initializers.
    void DiscoverInsts(Node unit) {
        CollectInsts(unit);
    }

    void CollectInsts(Node n) {
        if (n == null) { return; }
        if (n.kind == AK.TypeRef()) {
            if (n.sval != "__typeargs" && n.kids.Count > 0) { AddInst(n.sval, n.kids); }
        }
        if (n.kind == AK.MemberAccess() && n.a != null && n.a.kind == AK.Ident()) {
            List<Node> a = ConcreteInstArgs(n, n.a.sval);
            if (a != null) { AddInst(n.a.sval, a); }
        }
        CollectInsts(n.a); CollectInsts(n.b); CollectInsts(n.c); CollectInsts(n.d);
        CollectInsts(n.type);
        int i = 0;
        while (i < n.kids.Count) { CollectInsts(n.kids[i]); i = i + 1; }
    }

    void AddInst(string clsName, List<Node> args) {
        Node cls = binder.FindType(clsName);
        if (cls == null) { return; }
        List<string> tps = TParams(cls);
        if (tps.Count == 0 || args.Count != tps.Count) { return; }
        int i = 0;
        while (i < args.Count) {
            if (args[i] == null || MentionsTypeParam(args[i])) { return; }
            i = i + 1;
        }
        string key = clsName + "|" + InstTag(args);
        if (IndexOfStr(instKeys, key) >= 0) { return; }
        instKeys.Add(key);
        instClasses.Add(clsName);
        Node cont = new Node(AK.TypeRef());
        cont.sval = "__typeargs";
        int j = 0;
        while (j < args.Count) { cont.Add(args[j]); j = j + 1; }
        instConts.Add(cont);
    }

    // The instantiation that applies to a static field of `owner` accessed
    // without an explicit qualifier (inside the class): the current
    // instantiation when the owner is the class being specialized.
    List<Node> CurInstFor(string owner) {
        if (curInstCls == "" || curInstCls != owner) { return null; }
        if (curInstArgs == null || curInstArgs.Count == 0) { return null; }
        return curInstArgs;
    }

    ExprVal LoadStaticField(Node cls, string name, List<Node> args) {
        string owner = StaticFieldOwner(cls, name);
        Node sf = FindStaticField(cls, name);
        if (sf == null) { throw new Exception("unknown static field " + owner + "." + name); }
        Node fty = sf.type;
        // the field's type is written in the OWNING class's scope
        string savedScope = typeScopeCls;
        typeScopeCls = owner;
        // the storage shape does NOT depend on the instantiation: the C host
        // keeps the field's DECLARED type for every variant (`map_type(
        // fsym->type)`) and mangles only the NAME
        string lt = MapType(fty);
        string g = StaticGlobal(owner, name, args);
        string t = NT();
        L("  " + t + " = load " + lt + ", " + lt + "* " + g);
        typeScopeCls = savedScope;
        return new ExprVal(t, fty);
    }
    void StoreStaticField(Node cls, string name, ExprVal v, List<Node> args) {
        string owner = StaticFieldOwner(cls, name);
        Node sf = FindStaticField(cls, name);
        if (sf == null) { throw new Exception("unknown static field " + owner + "." + name); }
        Node fty = sf.type;
        // the field's type is written in the OWNING class's scope
        string savedScope = typeScopeCls;
        typeScopeCls = owner;
        string lt = MapType(fty);
        string g = StaticGlobal(owner, name, args);
        if (IsNullableValue(fty)) {
            L("  store i8* " + BoxFor(v, fty) + ", i8** " + g);
            typeScopeCls = savedScope;
            return;
        }
        if (ArcManaged(fty)) {
            string old = NT();
            L("  " + old + " = load " + lt + ", " + lt + "* " + g);
            string sv = Coerce(v, lt);
            L("  store " + lt + " " + sv + ", " + lt + "* " + g);
            EmitArcRetain(sv, fty);
            EmitArcRelease(old, fty);
            typeScopeCls = savedScope;
            return;
        }
        string sv = Coerce(v, lt);
        L("  store " + lt + " " + sv + ", " + lt + "* " + g);
        EmitArcRetainStore(sv, fty, v.ty);
        typeScopeCls = savedScope;
    }
    // Emit an internal global for each static field declared in `cls`.
    void EmitStaticGlobals(Node cls) {
        int i = 0;
        while (i < cls.kids.Count) {
            Node m = cls.kids[i];
            if (m.kind == AK.FieldDecl() && IsStatic(m)) {
                // the field's type is written in THIS class's scope
                string savedScope = typeScopeCls;
                typeScopeCls = cls.sval;
                string lt = MapType(m.type);
                typeScopeCls = savedScope;
                H("@__zan_sf_" + cls.sval + "_" + m.sval + " = internal global " + lt + " zeroinitializer");
                // a generic class's static field has ONE global per
                // instantiation: the storage is not shared (`Stat<int>.s`
                // and `Stat<double>.s` are different cells)
                int k = 0;
                while (k < instClasses.Count) {
                    if (instClasses[k] == cls.sval) {
                        List<Node> args = instConts[k].kids;
                        string sc2 = typeScopeCls;
                        typeScopeCls = cls.sval;
                        string lt2 = MapType(m.type);
                        typeScopeCls = sc2;
                        H(StaticGlobal(cls.sval, m.sval, args)
                          + " = internal global " + lt2 + " zeroinitializer");
                    }
                    k = k + 1;
                }
            }
            i = i + 1;
        }
    }
    // Run static-field initializers once at program entry (mirrors var-decl init).
    void EmitStaticInits(Node unit) {
        int i = 0;
        while (i < unit.kids.Count) {
            Node d = unit.kids[i];
            if (d.kind == AK.ClassDecl() || d.kind == AK.StructDecl()) {
                curClass = d.sval; curHasThis = false;
                locName = new List<string>(); locType = new List<Node>(); locReg = new List<string>();
                // a generic class's static storage is per instantiation: the
                // erased cell never exists (the C host emits the variants
                // only), so the initializers run once per instantiation
                if (TParams(d).Count == 0) { EmitStaticFieldInits(d, null); }
                int k = 0;
                while (k < instClasses.Count) {
                    if (instClasses[k] == d.sval) {
                        EmitStaticFieldInits(d, instConts[k].kids);
                    }
                    k = k + 1;
                }
                // the class's static constructor runs after its static field
                // initializers (the C host's order)
                int j = 0;
                while (j < d.kids.Count) {
                    Node cm = d.kids[j];
                    if (cm.kind == AK.CtorDecl() && IsStatic(cm)) {
                        L("  call void @" + StaticCtorSym(d.sval) + "()");
                    }
                    j = j + 1;
                }
            }
            i = i + 1;
        }
    }

    // The static field initializers of a class: for the erased storage, or for
    // one instantiation's own cells.
    void EmitStaticFieldInits(Node d, List<Node> args) {
        List<Node> sargs = curInstArgs; string scls = curInstCls;
        curInstArgs = args; curInstCls = d.sval;
        int j = 0;
        while (j < d.kids.Count) {
            Node m = d.kids[j];
            if (m.kind == AK.FieldDecl() && IsStatic(m) && m.b != null) {
                ExprVal iv = GenExpr(m.b);
                Node fty = m.type;
                string savedScope = typeScopeCls;
                typeScopeCls = d.sval;
                string lt = MapType(fty);
                typeScopeCls = savedScope;
                string g = StaticGlobal(d.sval, m.sval, args);
                if (IsNullableValue(fty)) {
                    L("  store i8* " + BoxFor(iv, fty) + ", i8** " + g);
                } else {
                    string sv = Coerce(iv, lt);
                    L("  store " + lt + " " + sv + ", " + lt + "* " + g);
                    EmitArcRetainStore(sv, fty, iv.ty);
                }
            }
            j = j + 1;
        }
        curInstArgs = sargs; curInstCls = scls;
    }

    // The number of instance fields the class chain below `cls` contributes
    // to its layout (the base fields come first).
    int BaseFieldCount(Node cls) {
        if (cls == null) { return 0; }
        List<string> names = new List<string>();
        List<Node> types = new List<Node>();
        CollectFields(cls, names, types);
        return names.Count;
    }

    // The position of `name` in the flattened field layout of `cls` (base
    // fields first). The **most derived** declaration wins: a derived field
    // hides a base field of the same name, and both keep their own slot.
    int FieldPos(Node cls, string name) {
        if (cls == null) { return -1; }
        int bcount = BaseFieldCount(BaseClassOf(cls));
        int seen = 0;
        int i = 0;
        while (i < cls.kids.Count) {
            Node m = cls.kids[i];
            if (m.kind == AK.FieldDecl() && !IsStatic(m)) {
                if (m.sval == name) { return bcount + seen; }
                seen = seen + 1;
            }
            i = i + 1;
        }
        return FieldPos(BaseClassOf(cls), name);
    }

    int FieldIndex(Node cls, string name) {
        if (cls == null) { return -1; }
        int p = FieldPos(cls, name);
        if (p < 0) { return -1; }
        return FieldBase(cls) + p;
    }

    // The type of the most derived declaration of the field `name`: a derived
    // field may hide a base field of the same name with a different type.
    Node FieldType(Node cls, string name) {
        if (cls == null) { return null; }
        int i = 0;
        while (i < cls.kids.Count) {
            Node m = cls.kids[i];
            if (m.kind == AK.FieldDecl() && !IsStatic(m) && m.sval == name) { return m.type; }
            i = i + 1;
        }
        return FieldType(BaseClassOf(cls), name);
    }

    // ---- locals ----
    string AddLocal(string name, Node ty) {
        locSeq = locSeq + 1;
        string r = "%v." + name + "." + locSeq;
        locName.Add(name); locType.Add(ty); locReg.Add(r);
        locBox.Add(false); locIter.Add(false); locCell.Add(""); locRef.Add(false);
        return r;
    }
    string RegOf(string name) { int i = LocalIdx(name); if (i < 0) { return "%v." + name; } return locReg[i]; }
    int LocalIdx(string name) {
        int i = locName.Count - 1;
        while (i >= 0) { if (locName[i] == name) { return i; } i = i - 1; }
        return -1;
    }

    // byte size of a lowered type: a capture cell holds exactly one value
    int TypeSizeBytes(string lt) {
        if (lt == "i1" || lt == "i8") { return 1; }
        if (lt == "i16") { return 2; }
        if (lt == "i32" || lt == "float") { return 4; }
        if (lt == "<2 x i64>") { return 16; }
        if (lt == "<4 x i64>") { return 32; }
        return 8;
    }

    // A local a closure captures has to live in a heap cell: the closure
    // keeps the cell, so a write to the local after the capture stays
    // visible inside the closure (C# semantics). The local's register
    // becomes the cell's payload pointer, so every read and write goes
    // through the cell. Returns the local's new register.
    string BoxLocal(int li) {
        Node ty = locType[li];
        string lt = MapType(ty);
        string cell = NT();
        L("  " + cell + " = call i8* @malloc(i64 " + TypeSizeBytes(lt) + ")");
        string p = NT();
        L("  " + p + " = bitcast i8* " + cell + " to " + lt + "*");
        locReg[li] = p;
        locBox[li] = true;
        locCell[li] = cell;
        return p;
    }

    // a local whose name shows up inside a lambda of this function may be
    // captured by a closure: it has to live in a cell
    bool ShouldBox(string name) { return Contains(capNames, name); }

    // ---- string helpers ----
    string HEXD(int d) { return "0123456789ABCDEF".Substring(d, 1); }
    string Hex2(int b) { int hi = b / 16; int lo = b - hi * 16; return HEXD(hi) + HEXD(lo); }

    // eight little-endian bytes of a 64-bit value, as the escaped text an
    // LLVM c"..." constant needs
    string HexI64LE(long v) {
        string s = "";
        int i = 0;
        while (i < 8) {
            int b = (int)(v % 256);
            s = s + "\\" + Hex2(b);
            v = v / 256;
            i = i + 1;
        }
        return s;
    }

    List<int> DecodeStr(string raw) {
        List<int> r = new List<int>();
        int i = 0;
        while (i < raw.Length) {
            int c = (int)raw[i];
            if (c == 92 && i + 1 < raw.Length) {
                int nx = (int)raw[i + 1];
                int dv = nx;
                if (nx == 110) { dv = 10; }
                else if (nx == 116) { dv = 9; }
                else if (nx == 114) { dv = 13; }
                else if (nx == 48) { dv = 0; }
                r.Add(dv);
                i = i + 2;
            } else {
                r.Add(c);
                i = i + 1;
            }
        }
        return r;
    }

    ExprVal GenStr(string raw) {
        List<int> bytes = DecodeStr(raw);
        string bodytxt = "";
        int i = 0;
        while (i < bytes.Count) { bodytxt = bodytxt + "\\" + Hex2(bytes[i]); i = i + 1; }
        bodytxt = bodytxt + "\\00";
        int blen = bytes.Count + 1;
        // managed string header in front of the payload: [i64 cid][i64 len]
        // [i64 magic] -- the same 24-byte shape as an object header, so the
        // runtime type test can read the class-id slot of any heap value
        string hdr = HexI64LE(0) + HexI64LE(bytes.Count) + "\\54\\53\\4E\\5A\\00\\00\\00\\00";
        strn = strn + 1;
        string g = "@.s" + strn;
        int tlen = 24 + blen;
        H(g + " = private unnamed_addr constant [" + tlen + " x i8] c\"" + hdr + bodytxt + "\"");
        string t = NT();
        L("  " + t + " = getelementptr inbounds [" + tlen + " x i8], [" + tlen + " x i8]* " + g + ", i64 0, i64 24");
        return new ExprVal(t, MkType("string"));
    }

    void CollectTParams(Node unit) {
        int i = 0;
        while (i < unit.kids.Count) {
            Node d = unit.kids[i];
            if (d.kind == AK.ClassDecl() || d.kind == AK.StructDecl()) {
                int j = 0;
                while (j < d.kids.Count) {
                    Node dm = d.kids[j];
                    if (dm.kind == AK.TypeParam()) { tparamNames.Add(dm.sval); }
                    else {
                        int k = 0;
                        while (k < dm.kids.Count) {
                            if (dm.kids[k].kind == AK.TypeParam()) { tparamNames.Add(dm.kids[k].sval); }
                            k = k + 1;
                        }
                    }
                    j = j + 1;
                }
            }
            i = i + 1;
        }
    }

    // ---- driver ----
    public string Gen(Node unit) {
        string exeDir = Environment.ExeDir();
        hostWin = exeDir.Length >= 2 && exeDir.Substring(1, 1) == ":";
        CollectTParams(unit);
        H("declare i32 @printf(i8*, ...)");
        H("declare i8* @malloc(i64)");
        H("declare i8* @calloc(i64, i64)");
        H("declare i8* @realloc(i8*, i64)");
        H("declare void @free(i8*)");
        H("declare i64 @strlen(i8*)");
        H("declare i32 @strcmp(i8*, i8*)");
        H("declare i8* @strcpy(i8*, i8*)");
        H("declare i8* @strcat(i8*, i8*)");
        H("declare i8* @memcpy(i8*, i8*, i64)");
        H("declare i8* @memmove(i8*, i8*, i64)");
        H("declare i8* @memset(i8*, i32, i64)");
        H("declare i32 @memcmp(i8*, i8*, i64)");
        H("declare i32 @snprintf(i8*, i64, i8*, ...)");
        H("declare i8* @fopen(i8*, i8*)");
        H("declare i32 @fseek(i8*, i64, i32)");
        H("declare i64 @ftell(i8*)");
        H("declare i64 @fread(i8*, i64, i64, i8*)");
        H("declare i64 @fwrite(i8*, i64, i64, i8*)");
        H("declare i32 @fclose(i8*)");
        H("declare i32 @_setjmp(i8*, i8*)");
        if (hostWin) {
            H("declare i32 @SetConsoleOutputCP(i32)");
            H("declare i32 @SetConsoleCP(i32)");
        }
        H("declare void @longjmp(i8*, i32)");
        H("declare i8* @llvm.frameaddress.p0(i32)");
        H("declare void @exit(i32)");
        H("declare i64 @atoi(i8*)");
        SeedExternBuiltins();
        H("@__exc_sp = global i64 0");
        H("@__exc_stack = global [64 x i8*] zeroinitializer");
        H("@__exc_val = global i8* null");
        H("@__exc_tid = global i8* null");
        // align 32: MSVC's _setjmp stores XMM state with movaps, which faults
        // on a default-8-aligned global buffer
        H("@__exc_bufs = global [64 x [32 x i64]] zeroinitializer, align 32");
        H("@__zan_argc = global i32 0");
        H("@__zan_argv = global i8** null");
        H("@.mode_rb = private unnamed_addr constant [3 x i8] c\"rb\\00\"");
        // 写模式必须是 "wb"（二进制）：文本模式在 Windows 上会把每个 LF
        // 翻成 CRLF，自举编译器写出的 .ll 因此与 C 宿主写出的不一致，
        // 固定点 gen2==g3 永远不成立（与 stdlib File.WriteAllText 一致）。
        H("@.mode_wb = private unnamed_addr constant [3 x i8] c\"wb\\00\"");
        H("@.fmt.nl = private unnamed_addr constant [6 x i8] c\"%lld\\0A\\00\"");
        H("@.fmt.nn = private unnamed_addr constant [5 x i8] c\"%lld\\00\"");
        H("@.fmt.snl = private unnamed_addr constant [4 x i8] c\"%s\\0A\\00\"");
        H("@.fmt.sn = private unnamed_addr constant [3 x i8] c\"%s\\00\"");
        H("@.fmt.gnl = private unnamed_addr constant [4 x i8] c\"%g\\0A\\00\"");
        H("@.fmt.gn = private unnamed_addr constant [3 x i8] c\"%g\\00\"");
        H("@.fmt.unl = private unnamed_addr constant [6 x i8] c\"%llu\\0A\\00\"");
        H("@.fmt.unn = private unnamed_addr constant [5 x i8] c\"%llu\\00\"");
        // Console.Clear / ResetColor: the ANSI escapes the C host emits
        // (irgen_call.c: "\033[2J\033[H" and "\033[0m").
        H("@.esc.clear = private unnamed_addr constant [8 x i8] c\"\\1B[2J\\1B[H\\00\"");
        H("@.esc.reset = private unnamed_addr constant [5 x i8] c\"\\1B[0m\\00\"");
        H("@.msg.unhandled = private unnamed_addr constant [25 x i8] c\"Unhandled exception: %s\\0A\\00\"");
        H("@.msg.exnil = private unnamed_addr constant [13 x i8] c\"(no message)\\00\"");
        H("@.msg.rderr = private unnamed_addr constant [18 x i8] c\"cannot read file\\0A\\00\"");
        H("@.msg.wrerr = private unnamed_addr constant [19 x i8] c\"cannot write file\\0A\\00\"");
        // a zero page: a null string reads from it instead of crashing (the
        // C host switches a null base to a scratch page and keeps running)
        H("@.zeropage = private unnamed_addr constant [16 x i8] zeroinitializer");
        EmitArcRuntime();
        EmitListRuntime();
        EmitSbRuntime();
        EmitStrRuntime();
        EmitDictRuntime();
        EmitStrcmp0();
        // the built-in containers carry a class id, so the runtime type test
        // can recognise them
        EmitContainerTids();
        EmitObjectRuntime();
        // the instantiations of the generic classes the program uses: a
        // generic class's static storage exists per instantiation, so they
        // have to be known before the globals and the static initializers
        // are emitted
        DiscoverInsts(unit);
        // struct type decls first
        int i = 0;
        while (i < unit.kids.Count) {
            Node d = unit.kids[i];
            if (d.kind == AK.ClassDecl() || d.kind == AK.StructDecl()) {
                if (d.sval != "Vector128" && d.sval != "Vector256") { EmitStruct(d); EmitStaticGlobals(d); EmitTid(d); }
            }
            i = i + 1;
        }
        // vtables for polymorphic classes
        i = 0;
        while (i < unit.kids.Count) {
            Node d = unit.kids[i];
            if ((d.kind == AK.ClassDecl() || d.kind == AK.StructDecl()) && IsPolyClass(d) && !HasMod(d, MOD.Abstract())) { EmitVtable(d); }
            i = i + 1;
        }
        // per-class destructors (release ARC-managed fields)
        i = 0;
        while (i < unit.kids.Count) {
            Node d = unit.kids[i];
            if ((d.kind == AK.ClassDecl() || d.kind == AK.StructDecl())
                && d.sval != "Vector128" && d.sval != "Vector256") { EmitClassDtor(d); }
            i = i + 1;
        }
        // function bodies
        i = 0;
        while (i < unit.kids.Count) {
            Node d = unit.kids[i];
            if (d.kind == AK.ClassDecl() || d.kind == AK.StructDecl()) { GenClass(d); }
            i = i + 1;
        }
        GenMainWrapper(unit);
        // emit queued generic-method specializations (a specialized body may
        // queue further specializations, so drain until the list stops growing)
        int sp = 0;
        while (sp < specMs.Count) {
            // the clone's receiver carries the concrete type arguments of the
            // class it specializes (`Pool<string>`), so a field read inside it
            // resolves the real value type
            Node pthis = curThisTy;
            List<Node> pargs = curInstArgs; string pcls = curInstCls;
            curThisTy = specThis[sp];
            // the clone's class instantiation: its static storage is the one
            // of that instantiation (`Stat<int>.s` is not `Stat<double>.s`)
            curInstArgs = new List<Node>(); curInstCls = "";
            if (curThisTy != null && curThisTy.kids.Count > 0) {
                curInstArgs = curThisTy.kids;
                curInstCls = curThisTy.sval;
            }
            GenMethod(specClss[sp], specMs[sp], false);
            curThisTy = pthis;
            curInstArgs = pargs; curInstCls = pcls;
            sp = sp + 1;
        }
        // The coroutine runtime is emitted unconditionally, not only when the
        // program awaits something: the C runtime object the program links
        // against references zan_co_ready (zan_io_recv_co), so the symbol has
        // to exist even for a program that never suspends. The definitions
        // are weak -- a runtime that provides the real ones wins -- but they
        // have to form a coherent set on their own: the self-host's frame
        // layout is its own (see TASKS A385), so the self-host's own
        // scheduler has to drive it.
        EmitAsyncRuntime();
        if (usesDirList) { EmitDirRuntime(); }
        if (usesStrOps) { EmitStrOpsRuntime(); }
        return head.ToString() + body.ToString() + deferred.ToString();
    }

    void EmitStruct(Node cls) {
        // hardware vectors are first-class LLVM vector values: no named type,
        // no heap layout, no dtor
        if (cls.sval == "Vector128" || cls.sval == "Vector256") { return; }
        List<string> names = new List<string>();
        List<Node> types = new List<Node>();
        CollectFields(cls, names, types);
        string s = "%" + cls.sval + " = type { ";
        int cnt = 0;
        // 类一律留 vptr 槽（见 FieldBase）：继承链上的字段偏移必须一致。
        if (cls.kind != AK.StructDecl()) { s = s + "i8*"; cnt = 1; }
        int i = 0;
        while (i < types.Count) {
            if (cnt > 0) { s = s + ", "; }
            // the field's type is written in THIS class's scope: a type
            // parameter of the class erases there (a user type of the same
            // name does not)
            string savedScope = typeScopeCls;
            typeScopeCls = cls.sval;
            s = s + MapType(types[i]);
            typeScopeCls = savedScope;
            cnt = cnt + 1;
            i = i + 1;
        }
        if (cnt == 0) { s = s + "i64"; }
        s = s + " }";
        H(s);
    }

    void EmitListRuntime() {
        EmitListRuntimeCore();
        EmitListRuntimeOps();
    }

    /// %zlist type + dtor/reverse/new.
    void EmitListRuntimeCore() {
        H("%zlist = type { i64, i64, i64*, i64 }");
        H("define void @zlist_dtor(i8* %p) {");
        H("entry:");
        H("  %l = bitcast i8* %p to %zlist*");
        H("  %optr = getelementptr %zlist, %zlist* %l, i32 0, i32 3");
        H("  %owns = load i64, i64* %optr");
        H("  %noown = icmp eq i64 %owns, 0");
        H("  br i1 %noown, label %freedata, label %loopinit");
        H("loopinit:");
        H("  %cptr = getelementptr %zlist, %zlist* %l, i32 0, i32 0");
        H("  %count = load i64, i64* %cptr");
        H("  %dptr = getelementptr %zlist, %zlist* %l, i32 0, i32 2");
        H("  %data = load i64*, i64** %dptr");
        H("  %ia = alloca i64");
        H("  store i64 0, i64* %ia");
        H("  br label %cond");
        H("cond:");
        H("  %i = load i64, i64* %ia");
        H("  %done = icmp sge i64 %i, %count");
        H("  br i1 %done, label %freedata, label %body");
        H("body:");
        H("  %slot = getelementptr i64, i64* %data, i64 %i");
        H("  %ev = load i64, i64* %slot");
        H("  %ep = inttoptr i64 %ev to i8*");
        H("  call void @zrelease(i8* %ep)");
        H("  %ni = add i64 %i, 1");
        H("  store i64 %ni, i64* %ia");
        H("  br label %cond");
        H("freedata:");
        H("  %dptr2 = getelementptr %zlist, %zlist* %l, i32 0, i32 2");
        H("  %data2 = load i64*, i64** %dptr2");
        H("  %datai8 = bitcast i64* %data2 to i8*");
        H("  call void @free(i8* %datai8)");
        H("  ret void");
        H("}");
        H("define void @zlist_reverse(i8* %p) {");
        H("entry:");
        H("  %l = bitcast i8* %p to %zlist*");
        H("  %cptr = getelementptr %zlist, %zlist* %l, i32 0, i32 0");
        H("  %count = load i64, i64* %cptr");
        H("  %dptr = getelementptr %zlist, %zlist* %l, i32 0, i32 2");
        H("  %data = load i64*, i64** %dptr");
        H("  %lo = alloca i64");
        H("  store i64 0, i64* %lo");
        H("  %hi = alloca i64");
        H("  %h0 = sub i64 %count, 1");
        H("  store i64 %h0, i64* %hi");
        H("  br label %cond");
        H("cond:");
        H("  %lv = load i64, i64* %lo");
        H("  %hv = load i64, i64* %hi");
        H("  %c = icmp slt i64 %lv, %hv");
        H("  br i1 %c, label %body, label %done");
        H("body:");
        H("  %ls = getelementptr i64, i64* %data, i64 %lv");
        H("  %hs = getelementptr i64, i64* %data, i64 %hv");
        H("  %a = load i64, i64* %ls");
        H("  %b = load i64, i64* %hs");
        H("  store i64 %b, i64* %ls");
        H("  store i64 %a, i64* %hs");
        H("  %l1 = add i64 %lv, 1");
        H("  store i64 %l1, i64* %lo");
        H("  %h1 = sub i64 %hv, 1");
        H("  store i64 %h1, i64* %hi");
        H("  br label %cond");
        H("done:");
        H("  ret void");
        H("}");
        H("define i8* @zlist_new(i64 %owns) {");
        H("  %p = call i8* @zalloc(i64 32, i8* bitcast (void (i8*)* @zlist_dtor to i8*), " + ContainerCid("List") + ")");
        H("  %l = bitcast i8* %p to %zlist*");
        H("  %c = getelementptr %zlist, %zlist* %l, i32 0, i32 0");
        H("  store i64 0, i64* %c");
        H("  %cap = getelementptr %zlist, %zlist* %l, i32 0, i32 1");
        H("  store i64 0, i64* %cap");
        H("  %d = getelementptr %zlist, %zlist* %l, i32 0, i32 2");
        H("  store i64* null, i64** %d");
        H("  %op = getelementptr %zlist, %zlist* %l, i32 0, i32 3");
        H("  store i64 %owns, i64* %op");
        H("  ret i8* %p");
        H("}");
    }

    /// zlist add/get/set/count/removeat/clear.
    void EmitListRuntimeOps() {
        H("define void @zlist_add(i8* %p, i64 %v) {");
        H("entry:");
        H("  %l = bitcast i8* %p to %zlist*");
        H("  %cptr = getelementptr %zlist, %zlist* %l, i32 0, i32 0");
        H("  %count = load i64, i64* %cptr");
        H("  %capptr = getelementptr %zlist, %zlist* %l, i32 0, i32 1");
        H("  %cap = load i64, i64* %capptr");
        H("  %full = icmp sge i64 %count, %cap");
        H("  br i1 %full, label %grow, label %st");
        H("grow:");
        H("  %nc0 = mul i64 %cap, 2");
        H("  %isz = icmp eq i64 %nc0, 0");
        H("  %nc = select i1 %isz, i64 4, i64 %nc0");
        H("  %dptr = getelementptr %zlist, %zlist* %l, i32 0, i32 2");
        H("  %olddata = load i64*, i64** %dptr");
        H("  %oldi8 = bitcast i64* %olddata to i8*");
        H("  %bytes = mul i64 %nc, 8");
        H("  %newi8 = call i8* @realloc(i8* %oldi8, i64 %bytes)");
        H("  %newdata = bitcast i8* %newi8 to i64*");
        H("  store i64* %newdata, i64** %dptr");
        H("  store i64 %nc, i64* %capptr");
        H("  br label %st");
        H("st:");
        H("  %dptr2 = getelementptr %zlist, %zlist* %l, i32 0, i32 2");
        H("  %data = load i64*, i64** %dptr2");
        H("  %slot = getelementptr i64, i64* %data, i64 %count");
        H("  store i64 %v, i64* %slot");
        H("  %ncount = add i64 %count, 1");
        H("  store i64 %ncount, i64* %cptr");
        H("  %optr = getelementptr %zlist, %zlist* %l, i32 0, i32 3");
        H("  %owns = load i64, i64* %optr");
        H("  %doret = icmp ne i64 %owns, 0");
        H("  br i1 %doret, label %doretain, label %done");
        H("doretain:");
        H("  %vp = inttoptr i64 %v to i8*");
        H("  call void @zretain(i8* %vp)");
        H("  br label %done");
        H("done:");
        H("  ret void");
        H("}");
        H("define i64 @zlist_get(i8* %p, i64 %i) {");
        H("  %l = bitcast i8* %p to %zlist*");
        H("  %dptr = getelementptr %zlist, %zlist* %l, i32 0, i32 2");
        H("  %data = load i64*, i64** %dptr");
        H("  %slot = getelementptr i64, i64* %data, i64 %i");
        H("  %v = load i64, i64* %slot");
        H("  ret i64 %v");
        H("}");
        H("define void @zlist_set(i8* %p, i64 %i, i64 %v) {");
        H("entry:");
        H("  %l = bitcast i8* %p to %zlist*");
        H("  %dptr = getelementptr %zlist, %zlist* %l, i32 0, i32 2");
        H("  %data = load i64*, i64** %dptr");
        H("  %slot = getelementptr i64, i64* %data, i64 %i");
        H("  %old = load i64, i64* %slot");
        H("  store i64 %v, i64* %slot");
        H("  %optr = getelementptr %zlist, %zlist* %l, i32 0, i32 3");
        H("  %owns = load i64, i64* %optr");
        H("  %doarc = icmp ne i64 %owns, 0");
        H("  br i1 %doarc, label %arc, label %done");
        H("arc:");
        H("  %nvp = inttoptr i64 %v to i8*");
        H("  call void @zretain(i8* %nvp)");
        H("  %ovp = inttoptr i64 %old to i8*");
        H("  call void @zrelease(i8* %ovp)");
        H("  br label %done");
        H("done:");
        H("  ret void");
        H("}");
        H("define i64 @zlist_count(i8* %p) {");
        H("  %l = bitcast i8* %p to %zlist*");
        H("  %cptr = getelementptr %zlist, %zlist* %l, i32 0, i32 0");
        H("  %c = load i64, i64* %cptr");
        H("  ret i64 %c");
        H("}");
        // `new List<T>(src)`: copy the source list's elements into the new
        // list. The elements are added through zlist_add, so a list that owns
        // its elements retains the copies (the C host's list_copy lowering
        // retains them the same way).
        H("define void @zlist_copy(i8* %dp, i8* %sp) {");
        H("entry:");
        H("  %sl = bitcast i8* %sp to %zlist*");
        H("  %scptr = getelementptr %zlist, %zlist* %sl, i32 0, i32 0");
        H("  %count = load i64, i64* %scptr");
        H("  %sdptr = getelementptr %zlist, %zlist* %sl, i32 0, i32 2");
        H("  %sdata = load i64*, i64** %sdptr");
        H("  %ia = alloca i64");
        H("  store i64 0, i64* %ia");
        H("  br label %cond");
        H("cond:");
        H("  %iv = load i64, i64* %ia");
        H("  %more = icmp slt i64 %iv, %count");
        H("  br i1 %more, label %body, label %done");
        H("body:");
        H("  %sslot = getelementptr i64, i64* %sdata, i64 %iv");
        H("  %v = load i64, i64* %sslot");
        H("  call void @zlist_add(i8* %dp, i64 %v)");
        H("  %ni = add i64 %iv, 1");
        H("  store i64 %ni, i64* %ia");
        H("  br label %cond");
        H("done:");
        H("  ret void");
        H("}");
        H("define void @zlist_removeat(i8* %p, i64 %i) {");
        H("entry:");
        H("  %l = bitcast i8* %p to %zlist*");
        H("  %cptr = getelementptr %zlist, %zlist* %l, i32 0, i32 0");
        H("  %count = load i64, i64* %cptr");
        H("  %dptr = getelementptr %zlist, %zlist* %l, i32 0, i32 2");
        H("  %data = load i64*, i64** %dptr");
        H("  %optr = getelementptr %zlist, %zlist* %l, i32 0, i32 3");
        H("  %owns = load i64, i64* %optr");
        H("  %doarc = icmp ne i64 %owns, 0");
        H("  br i1 %doarc, label %rel, label %shiftinit");
        H("rel:");
        H("  %vp = getelementptr i64, i64* %data, i64 %i");
        H("  %vv = load i64, i64* %vp");
        H("  %vo = inttoptr i64 %vv to i8*");
        H("  call void @zrelease(i8* %vo)");
        H("  br label %shiftinit");
        H("shiftinit:");
        H("  %ja = alloca i64");
        H("  store i64 %i, i64* %ja");
        H("  br label %cond");
        H("cond:");
        H("  %j = load i64, i64* %ja");
        H("  %jn = add i64 %j, 1");
        H("  %done = icmp sge i64 %jn, %count");
        H("  br i1 %done, label %fin, label %shift");
        H("shift:");
        H("  %sp = getelementptr i64, i64* %data, i64 %jn");
        H("  %sv = load i64, i64* %sp");
        H("  %dp = getelementptr i64, i64* %data, i64 %j");
        H("  store i64 %sv, i64* %dp");
        H("  store i64 %jn, i64* %ja");
        H("  br label %cond");
        H("fin:");
        H("  %nc = sub i64 %count, 1");
        H("  store i64 %nc, i64* %cptr");
        H("  ret void");
        H("}");
        H("define void @zlist_clear(i8* %p) {");
        H("entry:");
        H("  %l = bitcast i8* %p to %zlist*");
        H("  %cptr = getelementptr %zlist, %zlist* %l, i32 0, i32 0");
        H("  %count = load i64, i64* %cptr");
        H("  %dptr = getelementptr %zlist, %zlist* %l, i32 0, i32 2");
        H("  %data = load i64*, i64** %dptr");
        H("  %optr = getelementptr %zlist, %zlist* %l, i32 0, i32 3");
        H("  %owns = load i64, i64* %optr");
        H("  %doarc = icmp ne i64 %owns, 0");
        H("  %ja = alloca i64");
        H("  store i64 0, i64* %ja");
        H("  br i1 %doarc, label %cond, label %fin");
        H("cond:");
        H("  %j = load i64, i64* %ja");
        H("  %done = icmp sge i64 %j, %count");
        H("  br i1 %done, label %fin, label %rel");
        H("rel:");
        H("  %sp = getelementptr i64, i64* %data, i64 %j");
        H("  %sv = load i64, i64* %sp");
        H("  %so = inttoptr i64 %sv to i8*");
        H("  call void @zrelease(i8* %so)");
        H("  %jn = add i64 %j, 1");
        H("  store i64 %jn, i64* %ja");
        H("  br label %cond");
        H("fin:");
        H("  store i64 0, i64* %cptr");
        H("  ret void");
        H("}");
        // zlist_reserve: make room for n elements up front (the C host's
        // List<T>.Reserve). A no-op when the capacity is already big enough;
        // otherwise the capacity becomes exactly n, like the C host.
        H("define void @zlist_reserve(i8* %p, i64 %n) {");
        H("entry:");
        H("  %l = bitcast i8* %p to %zlist*");
        H("  %capptr = getelementptr %zlist, %zlist* %l, i32 0, i32 1");
        H("  %cap = load i64, i64* %capptr");
        H("  %enough = icmp sge i64 %cap, %n");
        H("  br i1 %enough, label %done, label %grow");
        H("grow:");
        H("  %dptr = getelementptr %zlist, %zlist* %l, i32 0, i32 2");
        H("  %olddata = load i64*, i64** %dptr");
        H("  %oldi8 = bitcast i64* %olddata to i8*");
        H("  %bytes = mul i64 %n, 8");
        H("  %newi8 = call i8* @realloc(i8* %oldi8, i64 %bytes)");
        H("  %newdata = bitcast i8* %newi8 to i64*");
        H("  store i64* %newdata, i64** %dptr");
        H("  store i64 %n, i64* %capptr");
        H("  br label %done");
        H("done:");
        H("  ret void");
        H("}");
        // zlist_addrange: append every element of the source list. The count
        // is read once, so appending a list to itself copies the elements it
        // had when the call started (the C host reads the count the same way).
        H("define void @zlist_addrange(i8* %d, i8* %s) {");
        H("entry:");
        H("  %n = call i64 @zlist_count(i8* %s)");
        H("  %ia = alloca i64");
        H("  store i64 0, i64* %ia");
        H("  br label %cond");
        H("cond:");
        H("  %i = load i64, i64* %ia");
        H("  %done = icmp uge i64 %i, %n");
        H("  br i1 %done, label %fin, label %body");
        H("body:");
        H("  %v = call i64 @zlist_get(i8* %s, i64 %i)");
        H("  call void @zlist_add(i8* %d, i64 %v)");
        H("  %ni = add i64 %i, 1");
        H("  store i64 %ni, i64* %ia");
        H("  br label %cond");
        H("fin:");
        H("  ret void");
        H("}");
        // zlist_insert: shift the elements from the end down to the insert
        // point, then put the new value there.
        H("define void @zlist_insert(i8* %p, i64 %idx, i64 %v) {");
        H("entry:");
        H("  %l = bitcast i8* %p to %zlist*");
        H("  %cptr = getelementptr %zlist, %zlist* %l, i32 0, i32 0");
        H("  %count = load i64, i64* %cptr");
        H("  %capptr = getelementptr %zlist, %zlist* %l, i32 0, i32 1");
        H("  %cap = load i64, i64* %capptr");
        H("  %full = icmp sge i64 %count, %cap");
        H("  br i1 %full, label %grow, label %st");
        H("grow:");
        H("  %nc0 = mul i64 %cap, 2");
        H("  %isz = icmp eq i64 %nc0, 0");
        H("  %nc = select i1 %isz, i64 4, i64 %nc0");
        H("  %dptr = getelementptr %zlist, %zlist* %l, i32 0, i32 2");
        H("  %olddata = load i64*, i64** %dptr");
        H("  %oldi8 = bitcast i64* %olddata to i8*");
        H("  %bytes = mul i64 %nc, 8");
        H("  %newi8 = call i8* @realloc(i8* %oldi8, i64 %bytes)");
        H("  %newdata = bitcast i8* %newi8 to i64*");
        H("  store i64* %newdata, i64** %dptr");
        H("  store i64 %nc, i64* %capptr");
        H("  br label %st");
        H("st:");
        H("  %dptr2 = getelementptr %zlist, %zlist* %l, i32 0, i32 2");
        H("  %data = load i64*, i64** %dptr2");
        H("  %ja = alloca i64");
        H("  %j0 = sub i64 %count, 1");
        H("  store i64 %j0, i64* %ja");
        H("  br label %shcond");
        H("shcond:");
        H("  %j = load i64, i64* %ja");
        H("  %c = icmp slt i64 %j, %idx");
        H("  br i1 %c, label %shdone, label %shbody");
        H("shbody:");
        H("  %jn = add i64 %j, 1");
        H("  %sp = getelementptr i64, i64* %data, i64 %j");
        H("  %sv = load i64, i64* %sp");
        H("  %dp = getelementptr i64, i64* %data, i64 %jn");
        H("  store i64 %sv, i64* %dp");
        H("  %jp = sub i64 %j, 1");
        H("  store i64 %jp, i64* %ja");
        H("  br label %shcond");
        H("shdone:");
        // the element that sat at the insert point was moved one slot up by
        // the shift, so nothing is dropped here: the list keeps exactly one
        // reference per slot. Only the new value has to be retained.
        H("  %slot = getelementptr i64, i64* %data, i64 %idx");
        H("  store i64 %v, i64* %slot");
        H("  %ncount = add i64 %count, 1");
        H("  store i64 %ncount, i64* %cptr");
        H("  %optr = getelementptr %zlist, %zlist* %l, i32 0, i32 3");
        H("  %owns = load i64, i64* %optr");
        H("  %doret = icmp ne i64 %owns, 0");
        H("  br i1 %doret, label %doretain, label %done");
        H("doretain:");
        H("  %vp = inttoptr i64 %v to i8*");
        H("  call void @zretain(i8* %vp)");
        H("  br label %done");
        H("done:");
        H("  ret void");
        H("}");
    }

    // ARC: every heap object carries a hidden 8-byte refcount header that lives
    // immediately BEFORE the pointer handed out, so object field layout, vtable
    // slot 0 and container internals are all unchanged. zalloc initialises the
    // count to 1; zretain/zrelease adjust it; zrelease frees at count 0.
    void EmitArcRuntime() {
        // header layout, 24 bytes before the object pointer: [ i8* class id ]
        // [ i64 refcount ] [ i8* destructor ]. zalloc records all three;
        // zrelease at count 0 runs the destructor (which releases members /
        // frees internal buffers) then frees. The class id is the address of
        // the class's tid global -- the runtime type test compares it against
        // the tid of every class that derives from the tested type, so an
        // `object` slot can be asked "which class is this?" at runtime.
        H("define i8* @zalloc(i64 %n, i8* %dtor, i8* %cid) {");
        H("  %tot = add i64 %n, 24");
        H("  %raw = call i8* @calloc(i64 1, i64 %tot)");
        H("  %cp = getelementptr i8, i8* %raw, i64 0");
        H("  %cs = bitcast i8* %cp to i8**");
        H("  store i8* %cid, i8** %cs");
        H("  %rp = getelementptr i8, i8* %raw, i64 8");
        H("  %rc = bitcast i8* %rp to i64*");
        H("  store i64 1, i64* %rc");
        H("  %ds0 = getelementptr i8, i8* %raw, i64 16");
        H("  %ds = bitcast i8* %ds0 to i8**");
        H("  store i8* %dtor, i8** %ds");
        H("  %obj = getelementptr i8, i8* %raw, i64 24");
        H("  ret i8* %obj");
        H("}");
        H("define void @zretain(i8* %p) {");
        H("entry:");
        H("  %isnull = icmp eq i8* %p, null");
        H("  br i1 %isnull, label %done, label %go");
        H("go:");
        H("  %hdr = getelementptr i8, i8* %p, i64 -16");
        H("  %rc = bitcast i8* %hdr to i64*");
        H("  %c = load i64, i64* %rc");
        H("  %nc = add i64 %c, 1");
        H("  store i64 %nc, i64* %rc");
        H("  br label %done");
        H("done:");
        H("  ret void");
        H("}");
        H("define void @zrelease(i8* %p) {");
        H("entry:");
        H("  %isnull = icmp eq i8* %p, null");
        H("  br i1 %isnull, label %done, label %go");
        H("go:");
        H("  %hdr = getelementptr i8, i8* %p, i64 -16");
        H("  %rc = bitcast i8* %hdr to i64*");
        H("  %c = load i64, i64* %rc");
        H("  %nc = sub i64 %c, 1");
        H("  store i64 %nc, i64* %rc");
        H("  %dead = icmp sle i64 %nc, 0");
        H("  br i1 %dead, label %dofree, label %done");
        H("dofree:");
        H("  %ds0 = getelementptr i8, i8* %p, i64 -8");
        H("  %ds = bitcast i8* %ds0 to i8**");
        H("  %dtor = load i8*, i8** %ds");
        H("  %hasd = icmp ne i8* %dtor, null");
        H("  br i1 %hasd, label %rund, label %fr");
        H("rund:");
        H("  %fn = bitcast i8* %dtor to void (i8*)*");
        H("  call void %fn(i8* %p)");
        H("  br label %fr");
        H("fr:");
        // the block starts 24 bytes before the object pointer
        H("  %base = getelementptr i8, i8* %p, i64 -24");
        H("  call void @free(i8* %base)");
        H("  br label %done");
        H("done:");
        H("  ret void");
        H("}");
        // The runtime class identity: the class id stored in the object
        // header. Null-safe -- a null object has no class.
        H("define i8* @__zan_class_id(i8* %obj) {");
        H("entry:");
        H("  %isnull = icmp eq i8* %obj, null");
        H("  br i1 %isnull, label %none, label %read");
        H("none:");
        H("  ret i8* null");
        H("read:");
        H("  %cp = getelementptr i8, i8* %obj, i64 -24");
        H("  %cs = bitcast i8* %cp to i8**");
        H("  %cid = load i8*, i8** %cs");
        H("  ret i8* %cid");
        H("}");
        // Is the object a managed string? The string header keeps a magic word
        // right before the payload; a class instance has a destructor pointer
        // there instead. Null-safe.
        H("define i64 @__zan_is_string(i8* %obj) {");
        H("entry:");
        H("  %isnull = icmp eq i8* %obj, null");
        H("  br i1 %isnull, label %no, label %read");
        H("no:");
        H("  ret i64 0");
        H("read:");
        H("  %wp = getelementptr i8, i8* %obj, i64 -8");
        H("  %wq = bitcast i8* %wp to i64*");
        H("  %w = load i64, i64* %wq");
        H("  %eq = icmp eq i64 %w, 1515082580");
        H("  %z = zext i1 %eq to i64");
        H("  ret i64 %z");
        H("}");
    }

    // is `t` a heap object carrying an ARC header (class/struct instance or one
    // of the built-in containers routed through zalloc)? Strings, primitives,
    // erased generic slots and nullable value boxes are not ARC-managed.
    bool ArcManaged(Node t) {
        if (t == null) { return false; }
        if (IsErasedType(t)) { return false; }
        if (IsNullableValue(t)) { return false; }
        if (t.ival >= 1) { return false; }
        string n = t.sval;
        // hardware vectors are first-class values, not ARC-managed heap objects
        if (n == "Vector128" || n == "Vector256") { return false; }
        if (n == "List" || n == "Dictionary" || n == "Dict" || n == "StringBuilder") { return true; }
        Node d = binder.FindType(n);
        if (d != null && (d.kind == AK.ClassDecl() || d.kind == AK.StructDecl())) { return true; }
        return false;
    }

    void EmitArcRetain(string val, Node ty) {
        if (!ArcManaged(ty)) { return; }
        string lt = MapType(ty);
        if (lt == "i8*") {
            L("  call void @zretain(i8* " + val + ")");
        } else {
            string t = NT();
            L("  " + t + " = bitcast " + lt + " " + val + " to i8*");
            L("  call void @zretain(i8* " + t + ")");
        }
    }

    // Retain a value that is stored into a slot.  An ARC-managed slot type
    // retains as usual.  A slot that is *not* ARC-managed (an `object` slot)
    // still owns the reference it holds -- its static type just says nothing
    // about what that is -- so a class instance stored there is retained by
    // the *value's* type.  A string has no refcount and must not be retained
    // (its header carries the length, not a count).
    void EmitArcRetainStore(string val, Node slotTy, Node valTy) {
        if (ArcManaged(slotTy)) { EmitArcRetain(val, slotTy); return; }
        if (valTy == null || !ArcManaged(valTy)) { return; }
        if (MapType(slotTy) != "i8*") { return; }
        EmitArcRetain(val, valTy);
    }

    void EmitArcRelease(string val, Node ty) {
        if (!ArcManaged(ty)) { return; }
        string lt = MapType(ty);
        if (lt == "i8*") {
            L("  call void @zrelease(i8* " + val + ")");
        } else {
            string t = NT();
            L("  " + t + " = bitcast " + lt + " " + val + " to i8*");
            L("  call void @zrelease(i8* " + t + ")");
        }
    }

    void EmitLocalReleases() {
        int i = 0;
        while (i < locName.Count) {
            // a by-ref parameter's reference belongs to the CALLER's slot:
            // releasing it here would drop the caller's own reference
            if (i < locRef.Count && locRef[i]) { i = i + 1; continue; }
            if (ArcManaged(locType[i])) {
                string lt = MapType(locType[i]);
                string t = NT();
                L("  " + t + " = load " + lt + ", " + lt + "* " + locReg[i]);
                EmitArcRelease(t, locType[i]);
            }
            i = i + 1;
        }
    }

    void AddTemp(string op, Node ty) {
        if (!ArcManaged(ty)) { return; }
        // ARC 临时值的释放点固定在语句末尾，而它可能生成在某个分支里
        // （三元、if 分支、循环体）。直接拿寄存器值去释放，会在合并块
        // 里违反支配关系（LLVM: "Instruction does not dominate all uses"）。
        // 与 C 宿主 emit_entry_alloca 同法：分支内生成的临时值落一个
        // entry 槽位，释放时再 load 出来；分支没走时槽位是 null，
        // zrelease(null) 是空操作。
        if (eaActive && curLbl != "entry") {
            string lt = MapType(ty);
            string reg = NTS();
            entryAllocas.Append("  " + reg + " = alloca " + lt + "\n");
            entryAllocas.Append("  store " + lt + " null, " + lt + "* " + reg + "\n");
            L("  store " + lt + " " + op + ", " + lt + "* " + reg);
            stmtTemps.Add(reg);
            stmtTempTypes.Add(ty);
            return;
        }
        stmtTemps.Add(op);
        stmtTempTypes.Add(ty);
    }

    void EmitTempReleases() {
        int i = 0;
        while (i < stmtTemps.Count) {
            string op = stmtTemps[i];
            if (op.Length > 1 && op[1] == 122) {
                // entry 槽位（%z 前缀）：load 出值再释放
                string lt = MapType(stmtTempTypes[i]);
                string v = NT();
                L("  " + v + " = load " + lt + ", " + lt + "* " + op);
                EmitArcRelease(v, stmtTempTypes[i]);
            } else {
                EmitArcRelease(op, stmtTempTypes[i]);
            }
            i = i + 1;
        }
        stmtTemps = new List<string>();
        stmtTempTypes = new List<Node>();
    }

    void ReleaseLocalsFrom(int from) {
        int i = from;
        while (i < locName.Count) {
            // __qdot temps hold a borrowed `?.` receiver: not owned, never released
            if (locName[i].Length >= 6 && locName[i].Substring(0, 6) == "__qdot") { i = i + 1; continue; }
            // a by-ref parameter's reference belongs to the CALLER's slot
            if (i < locRef.Count && locRef[i]) { i = i + 1; continue; }
            if (ArcManaged(locType[i])) {
                string lt = MapType(locType[i]);
                string t = NT();
                if (curAsync && locBox[i]) {
                    // the local lives in a heap cell: the register holds the
                    // CELL pointer, the cell holds the value -- release the
                    // value, not the cell
                    string c = NT();
                    L("  " + c + " = load i8*, i8** " + locReg[i]);
                    string p = NT();
                    L("  " + p + " = bitcast i8* " + c + " to " + lt + "*");
                    L("  " + t + " = load " + lt + ", " + lt + "* " + p);
                    EmitArcRelease(t, locType[i]);
                } else {
                    L("  " + t + " = load " + lt + ", " + lt + "* " + locReg[i]);
                    EmitArcRelease(t, locType[i]);
                }
            }
            i = i + 1;
        }
    }

    void TrimLocals(int to) {
        List<string> nn = new List<string>();
        List<Node> nt = new List<Node>();
        List<string> nr = new List<string>();
        List<bool> nb = new List<bool>();
        List<bool> ni = new List<bool>();
        List<string> nc = new List<string>();
        List<bool> nref = new List<bool>();
        int i = 0;
        while (i < to) {
            nn.Add(locName[i]); nt.Add(locType[i]); nr.Add(locReg[i]);
            nb.Add(locBox[i]); ni.Add(locIter[i]); nc.Add(locCell[i]);
            if (i < locRef.Count) { nref.Add(locRef[i]); } else { nref.Add(false); }
            i = i + 1;
        }
        locName = nn; locType = nt; locReg = nr;
        locBox = nb; locIter = ni; locCell = nc; locRef = nref;
    }

    // per-class destructor: release every ARC-managed field, then return (the
    // object storage itself is freed by zrelease after this runs).
    void EmitClassDtor(Node cls) {
        string cn = cls.sval;
        H("define void @" + cn + "_dtor(i8* %p) {");
        H("  %o = bitcast i8* %p to %" + cn + "*");
        List<string> names = new List<string>();
        List<Node> types = new List<Node>();
        CollectFields(cls, names, types);
        int fb = FieldBase(cls);
        int i = 0;
        int seq = 0;
        // the field types are written in THIS class's scope: a type parameter
        // of the class erases there (an i64 slot, not an ARC-managed
        // pointer -- releasing it would corrupt the slot)
        string savedScope = typeScopeCls;
        typeScopeCls = cls.sval;
        while (i < names.Count) {
            if (ArcManaged(types[i]) && !WeakTy(types[i])) {
                int idx = fb + i;
                string lt = MapType(types[i]);
                string fp = "%f" + seq;
                string fv = "%v" + seq;
                H("  " + fp + " = getelementptr %" + cn + ", %" + cn + "* %o, i32 0, i32 " + idx);
                H("  " + fv + " = load " + lt + ", " + lt + "* " + fp);
                if (lt == "i8*") {
                    H("  call void @zrelease(i8* " + fv + ")");
                } else {
                    string fc = "%c" + seq;
                    H("  " + fc + " = bitcast " + lt + " " + fv + " to i8*");
                    H("  call void @zrelease(i8* " + fc + ")");
                }
                seq = seq + 1;
            }
            i = i + 1;
        }
        typeScopeCls = savedScope;
        H("  ret void");
        H("}");
    }

    // ---- managed strings ----
    // A string value points at the payload of a block with a 16-byte header:
    //   [ i64 len ][ i64 magic ][ bytes... ][ NUL ]
    // The payload stays NUL-terminated, so a string is still a valid C string
    // for the runtime (printf and friends) and the ABI towards the C host is
    // unchanged -- but the length is exact and an embedded NUL no longer
    // truncates the value.
    //
    // The magic guards the header: every string the backend hands out comes
    // from zstr_new / zstr_of / a literal, and a value that does not carry
    // the magic is a bug -- zstr_len aborts instead of returning a length
    // read out of unrelated memory.
    void EmitStrRuntime() {
        if (!ExternSeen("abort")) { externDecls.Add("abort"); H("declare void @abort()"); }
        H("define void @zstr_bad() {");
        H("entry:");
        H("  call void @abort()");
        H("  ret void");
        H("}");
        H("define i8* @zstr_new(i64 %len) {");
        H("entry:");
        H("  %tot = add i64 %len, 25");
        H("  %raw = call i8* @malloc(i64 %tot)");
        // the class-id slot makes the string header the same size as an object
        // header, so reading it is always in bounds
        H("  %cp = getelementptr i8, i8* %raw, i64 0");
        H("  %cs = bitcast i8* %cp to i8**");
        H("  store i8* null, i8** %cs");
        H("  %hp = getelementptr i8, i8* %raw, i64 8");
        H("  store i64 %len, i64* %hp");
        H("  %mp = getelementptr i8, i8* %raw, i64 16");
        H("  store i64 1515082580, i64* %mp");
        H("  %p = getelementptr i8, i8* %raw, i64 24");
        H("  %endp = getelementptr i8, i8* %p, i64 %len");
        H("  store i8 0, i8* %endp");
        H("  ret i8* %p");
        H("}");
        H("define i64 @zstr_len(i8* %p) {");
        H("entry:");
        // a null string is a soft runtime error in the C host: it reports and
        // answers 0 (the program keeps running). The self-host has no
        // runtime report channel here, so it answers 0 as well.
        H("  %isnull = icmp eq i8* %p, null");
        H("  br i1 %isnull, label %nullstr, label %probe");
        H("nullstr:");
        H("  ret i64 0");
        H("probe:");
        H("  %mp = getelementptr i8, i8* %p, i64 -8");
        H("  %m = load i64, i64* %mp");
        H("  %ok = icmp eq i64 %m, 1515082580");
        H("  br i1 %ok, label %good, label %bad");
        H("good:");
        H("  %lp = getelementptr i8, i8* %p, i64 -16");
        H("  %len = load i64, i64* %lp");
        H("  ret i64 %len");
        H("bad:");
        H("  call void @zstr_bad()");
        H("  ret i64 0");
        H("}");
        // The C-visible length: the offset of the first NUL byte, i.e. what a
        // C string operation (strlen / strstr / printf) sees.  The C host keeps
        // the exact length for Length / indexing / concatenation but truncates
        // its search and transform methods at the first NUL, so the
        // self-hosted backend has to split the two as well (A390).
        // %p must be the base of a managed string; the magic check keeps a
        // bogus pointer fail-closed instead of silently measuring garbage.
        H("define i64 @zstr_clen(i8* %p) {");
        H("entry:");
        H("  %mp = getelementptr i8, i8* %p, i64 -8");
        H("  %m = load i64, i64* %mp");
        H("  %ok = icmp eq i64 %m, 1515082580");
        H("  br i1 %ok, label %good, label %bad");
        H("good:");
        H("  %n = call i64 @strlen(i8* %p)");
        H("  ret i64 %n");
        H("bad:");
        H("  call void @zstr_bad()");
        H("  ret i64 0");
        H("}");
        H("define i8* @zstr_dup(i8* %p) {");
        H("entry:");
        H("  %len = call i64 @zstr_len(i8* %p)");
        H("  %q = call i8* @zstr_new(i64 %len)");
        H("  call i8* @memcpy(i8* %q, i8* %p, i64 %len)");
        H("  ret i8* %q");
        H("}");
        H("define i8* @zstr_of(i8* %c) {");
        H("entry:");
        H("  %n = call i64 @strlen(i8* %c)");
        H("  %q = call i8* @zstr_new(i64 %n)");
        H("  call i8* @memcpy(i8* %q, i8* %c, i64 %n)");
        H("  ret i8* %q");
        H("}");
    }

    // StringBuilder: growable byte buffer { count, cap, i8* data }. Append is
    // amortised O(1) (capacity doubling); ToString materialises one string.
    void EmitSbRuntime() {
        H("%zsb = type { i64, i64, i8* }");
        H("define void @zsb_dtor(i8* %p) {");
        H("  %b = bitcast i8* %p to %zsb*");
        H("  %dptr = getelementptr %zsb, %zsb* %b, i32 0, i32 2");
        H("  %data = load i8*, i8** %dptr");
        H("  call void @free(i8* %data)");
        H("  ret void");
        H("}");
        H("define i8* @zsb_new() {");
        H("  %p = call i8* @zalloc(i64 24, i8* bitcast (void (i8*)* @zsb_dtor to i8*), " + ContainerCid("StringBuilder") + ")");
        H("  %b = bitcast i8* %p to %zsb*");
        H("  %c = getelementptr %zsb, %zsb* %b, i32 0, i32 0");
        H("  store i64 0, i64* %c");
        H("  %cap = getelementptr %zsb, %zsb* %b, i32 0, i32 1");
        H("  store i64 0, i64* %cap");
        H("  %d = getelementptr %zsb, %zsb* %b, i32 0, i32 2");
        H("  store i8* null, i8** %d");
        H("  ret i8* %p");
        H("}");
        H("define void @zsb_append(i8* %p, i8* %s) {");
        H("entry:");
        H("  %b = bitcast i8* %p to %zsb*");
        H("  %slen = call i64 @zstr_len(i8* %s)");
        H("  %cptr = getelementptr %zsb, %zsb* %b, i32 0, i32 0");
        H("  %count = load i64, i64* %cptr");
        H("  %capptr = getelementptr %zsb, %zsb* %b, i32 0, i32 1");
        H("  %cap = load i64, i64* %capptr");
        H("  %need = add i64 %count, %slen");
        H("  %full = icmp sgt i64 %need, %cap");
        H("  br i1 %full, label %grow, label %st");
        H("grow:");
        H("  %nc0 = mul i64 %cap, 2");
        H("  %small = icmp slt i64 %nc0, %need");
        H("  %nc = select i1 %small, i64 %need, i64 %nc0");
        H("  %dptr = getelementptr %zsb, %zsb* %b, i32 0, i32 2");
        H("  %olddata = load i8*, i8** %dptr");
        H("  %newdata = call i8* @realloc(i8* %olddata, i64 %nc)");
        H("  store i8* %newdata, i8** %dptr");
        H("  store i64 %nc, i64* %capptr");
        H("  br label %st");
        H("st:");
        H("  %dptr2 = getelementptr %zsb, %zsb* %b, i32 0, i32 2");
        H("  %data = load i8*, i8** %dptr2");
        H("  %dest = getelementptr i8, i8* %data, i64 %count");
        H("  call i8* @memcpy(i8* %dest, i8* %s, i64 %slen)");
        H("  %ncount = add i64 %count, %slen");
        H("  store i64 %ncount, i64* %cptr");
        H("  ret void");
        H("}");
        H("define i8* @zsb_tostring(i8* %p) {");
        H("  %b = bitcast i8* %p to %zsb*");
        H("  %cptr = getelementptr %zsb, %zsb* %b, i32 0, i32 0");
        H("  %count = load i64, i64* %cptr");
        H("  %dptr = getelementptr %zsb, %zsb* %b, i32 0, i32 2");
        H("  %data = load i8*, i8** %dptr");
        H("  %buf = call i8* @zstr_new(i64 %count)");
        H("  call i8* @memcpy(i8* %buf, i8* %data, i64 %count)");
        H("  ret i8* %buf");
        H("}");
    }

    // String helpers needing loops: LastIndexOf, Replace, Trim, ToUpper/ToLower.
    // Emitted only when a program uses one of them (usesStrOps).
    void EmitStrOpsRuntime() {
        EmitStrOpsSearch();
        EmitStrOpsTransform();
        EmitStrOpsSplitJoin();
    }

    /// zstr_lastidx / zstr_replace.
    void EmitStrOpsSearch() {
        if (!ExternSeen("strstr")) { externDecls.Add("strstr"); H("declare i8* @strstr(i8*, i8*)"); }
        if (!ExternSeen("strncmp")) { externDecls.Add("strncmp"); H("declare i32 @strncmp(i8*, i8*, i64)"); }
        H("define i64 @zstr_lastidx(i8* %s, i8* %sub) {");
        H("entry:");
        H("  %best = alloca i64");
        H("  store i64 -1, i64* %best");
        H("  %i = alloca i64");
        H("  store i64 0, i64* %i");
        H("  %ls = call i64 @zstr_clen(i8* %s)");
        H("  %lsub = call i64 @zstr_clen(i8* %sub)");
        H("  %end = sub i64 %ls, %lsub");
        H("  br label %loop");
        H("loop:");
        H("  %iv = load i64, i64* %i");
        H("  %cond = icmp sle i64 %iv, %end");
        H("  br i1 %cond, label %bdy, label %done");
        H("bdy:");
        H("  %p = getelementptr i8, i8* %s, i64 %iv");
        H("  %c = call i32 @strncmp(i8* %p, i8* %sub, i64 %lsub)");
        H("  %hit = icmp eq i32 %c, 0");
        H("  br i1 %hit, label %sethit, label %next");
        H("sethit:");
        H("  store i64 %iv, i64* %best");
        H("  br label %next");
        H("next:");
        H("  %iv1 = add i64 %iv, 1");
        H("  store i64 %iv1, i64* %i");
        H("  br label %loop");
        H("done:");
        H("  %r = load i64, i64* %best");
        H("  ret i64 %r");
        H("}");
        H("define i8* @zstr_replace(i8* %s, i8* %from, i8* %to) {");
        H("entry:");
        H("  %lf = call i64 @zstr_clen(i8* %from)");
        H("  %lt = call i64 @zstr_clen(i8* %to)");
        H("  %ls = call i64 @zstr_clen(i8* %s)");
        H("  %g0 = mul i64 %ls, %lt");
        H("  %g1 = add i64 %g0, %ls");
        H("  %g2 = add i64 %g1, %lt");
        H("  %cap = add i64 %g2, 1");
        H("  %buf = call i8* @malloc(i64 %cap)");
        H("  %cur = alloca i8*");
        H("  store i8* %s, i8** %cur");
        H("  %out = alloca i64");
        H("  store i64 0, i64* %out");
        H("  %fempty = icmp eq i64 %lf, 0");
        H("  br i1 %fempty, label %rest, label %loop");
        H("loop:");
        H("  %c = load i8*, i8** %cur");
        H("  %hit = call i8* @strstr(i8* %c, i8* %from)");
        H("  %miss = icmp eq i8* %hit, null");
        H("  br i1 %miss, label %rest, label %copyseg");
        H("copyseg:");
        H("  %ov = load i64, i64* %out");
        H("  %hi = ptrtoint i8* %hit to i64");
        H("  %ci = ptrtoint i8* %c to i64");
        H("  %seg = sub i64 %hi, %ci");
        H("  %dst = getelementptr i8, i8* %buf, i64 %ov");
        H("  call i8* @memcpy(i8* %dst, i8* %c, i64 %seg)");
        H("  %ov1 = add i64 %ov, %seg");
        H("  %dst2 = getelementptr i8, i8* %buf, i64 %ov1");
        H("  call i8* @memcpy(i8* %dst2, i8* %to, i64 %lt)");
        H("  %ov2 = add i64 %ov1, %lt");
        H("  store i64 %ov2, i64* %out");
        H("  %ncur = getelementptr i8, i8* %hit, i64 %lf");
        H("  store i8* %ncur, i8** %cur");
        H("  br label %loop");
        H("rest:");
        H("  %rc = load i8*, i8** %cur");
        // the tail pointer points into the payload, not at a string base, so
        // it has no header -- measure it as a C string
        H("  %rl = call i64 @strlen(i8* %rc)");
        H("  %rov = load i64, i64* %out");
        H("  %rdst = getelementptr i8, i8* %buf, i64 %rov");
        H("  call i8* @memcpy(i8* %rdst, i8* %rc, i64 %rl)");
        H("  %rov1 = add i64 %rov, %rl");
        H("  store i64 %rov1, i64* %out");
        H("  %fin = call i8* @zstr_new(i64 %rov1)");
        H("  call i8* @memcpy(i8* %fin, i8* %buf, i64 %rov1)");
        H("  ret i8* %fin");
        H("}");
    }

    /// zstr_trim / zstr_case / zstr_split.
    void EmitStrOpsTransform() {
        H("define i8* @zstr_trim(i8* %s) {");
        H("entry:");
        H("  %n = call i64 @zstr_clen(i8* %s)");
        H("  %b = alloca i64");
        H("  store i64 0, i64* %b");
        H("  %e = alloca i64");
        H("  store i64 %n, i64* %e");
        H("  br label %l1");
        H("l1:");
        H("  %bv = load i64, i64* %b");
        H("  %c1 = icmp slt i64 %bv, %n");
        H("  br i1 %c1, label %l1chk, label %l2");
        H("l1chk:");
        H("  %p1 = getelementptr i8, i8* %s, i64 %bv");
        H("  %ch1 = load i8, i8* %p1");
        H("  %sp1 = icmp eq i8 %ch1, 32");
        H("  %tb1 = icmp eq i8 %ch1, 9");
        H("  %cr1 = icmp eq i8 %ch1, 13");
        H("  %nl1 = icmp eq i8 %ch1, 10");
        H("  %w1a = or i1 %sp1, %tb1");
        H("  %w1b = or i1 %cr1, %nl1");
        H("  %w1 = or i1 %w1a, %w1b");
        H("  br i1 %w1, label %l1inc, label %l2");
        H("l1inc:");
        H("  %bv1 = add i64 %bv, 1");
        H("  store i64 %bv1, i64* %b");
        H("  br label %l1");
        H("l2:");
        H("  %ev = load i64, i64* %e");
        H("  %bv2 = load i64, i64* %b");
        H("  %c2 = icmp sgt i64 %ev, %bv2");
        H("  br i1 %c2, label %l2chk, label %fin");
        H("l2chk:");
        H("  %em1 = sub i64 %ev, 1");
        H("  %p2 = getelementptr i8, i8* %s, i64 %em1");
        H("  %ch2 = load i8, i8* %p2");
        H("  %sp2 = icmp eq i8 %ch2, 32");
        H("  %tb2 = icmp eq i8 %ch2, 9");
        H("  %cr2 = icmp eq i8 %ch2, 13");
        H("  %nl2 = icmp eq i8 %ch2, 10");
        H("  %w2a = or i1 %sp2, %tb2");
        H("  %w2b = or i1 %cr2, %nl2");
        H("  %w2 = or i1 %w2a, %w2b");
        H("  br i1 %w2, label %l2dec, label %fin");
        H("l2dec:");
        H("  store i64 %em1, i64* %e");
        H("  br label %l2");
        H("fin:");
        H("  %bv3 = load i64, i64* %b");
        H("  %ev3 = load i64, i64* %e");
        H("  %len = sub i64 %ev3, %bv3");
        H("  %buf = call i8* @zstr_new(i64 %len)");
        H("  %srcp = getelementptr i8, i8* %s, i64 %bv3");
        H("  call i8* @memcpy(i8* %buf, i8* %srcp, i64 %len)");
        H("  ret i8* %buf");
        H("}");
        H("define i8* @zstr_case(i8* %s, i64 %up) {");
        H("entry:");
        H("  %n = call i64 @zstr_clen(i8* %s)");
        H("  %buf = call i8* @zstr_new(i64 %n)");
        H("  %i = alloca i64");
        H("  store i64 0, i64* %i");
        H("  %isup = icmp ne i64 %up, 0");
        H("  br label %loop");
        H("loop:");
        H("  %iv = load i64, i64* %i");
        H("  %cond = icmp slt i64 %iv, %n");
        H("  br i1 %cond, label %bdy, label %done");
        H("bdy:");
        H("  %p = getelementptr i8, i8* %s, i64 %iv");
        H("  %c = load i8, i8* %p");
        H("  %gea = icmp sge i8 %c, 97");
        H("  %lez = icmp sle i8 %c, 122");
        H("  %islow = and i1 %gea, %lez");
        H("  %cup = sub i8 %c, 32");
        H("  %vup = select i1 %islow, i8 %cup, i8 %c");
        H("  %geA = icmp sge i8 %c, 65");
        H("  %leZ = icmp sle i8 %c, 90");
        H("  %isupc = and i1 %geA, %leZ");
        H("  %cdn = add i8 %c, 32");
        H("  %vdn = select i1 %isupc, i8 %cdn, i8 %c");
        H("  %v = select i1 %isup, i8 %vup, i8 %vdn");
        H("  %dp = getelementptr i8, i8* %buf, i64 %iv");
        H("  store i8 %v, i8* %dp");
        H("  %iv1 = add i64 %iv, 1");
        H("  store i64 %iv1, i64* %i");
        H("  br label %loop");
        H("done:");
        H("  ret i8* %buf");
        H("}");
        H("define i8* @zstr_split(i8* %s, i8* %sep) {");
        H("entry:");
        H("  %lsep = call i64 @zstr_clen(i8* %sep)");
        H("  %lst = call i8* @zlist_new(i64 0)");
        H("  %cur = alloca i8*");
        H("  store i8* %s, i8** %cur");
        H("  %empty = icmp eq i64 %lsep, 0");
        H("  br i1 %empty, label %last, label %loop");
        H("loop:");
        H("  %c = load i8*, i8** %cur");
        H("  %hit = call i8* @strstr(i8* %c, i8* %sep)");
        H("  %miss = icmp eq i8* %hit, null");
        H("  br i1 %miss, label %last, label %seg");
        H("seg:");
        H("  %hi = ptrtoint i8* %hit to i64");
        H("  %ci = ptrtoint i8* %c to i64");
        H("  %n = sub i64 %hi, %ci");
        H("  %buf = call i8* @zstr_new(i64 %n)");
        H("  call i8* @memcpy(i8* %buf, i8* %c, i64 %n)");
        H("  %bi = ptrtoint i8* %buf to i64");
        H("  call void @zlist_add(i8* %lst, i64 %bi)");
        H("  %ncur = getelementptr i8, i8* %hit, i64 %lsep");
        H("  store i8* %ncur, i8** %cur");
        H("  br label %loop");
        H("last:");
        H("  %lc = load i8*, i8** %cur");
        H("  %n2 = call i64 @strlen(i8* %lc)");
        H("  %buf2 = call i8* @zstr_new(i64 %n2)");
        H("  call i8* @memcpy(i8* %buf2, i8* %lc, i64 %n2)");
        H("  %bi2 = ptrtoint i8* %buf2 to i64");
        H("  call void @zlist_add(i8* %lst, i64 %bi2)");
        H("  ret i8* %lst");
        H("}");
    }

    /// zstr_join / zstr_isempty.
    void EmitStrOpsSplitJoin() {
        H("define i8* @zstr_join(i8* %sep, i8* %lst) {");
        H("entry:");
        H("  %n = call i64 @zlist_count(i8* %lst)");
        H("  %lsep = call i64 @zstr_clen(i8* %sep)");
        H("  %tot = alloca i64");
        H("  store i64 0, i64* %tot");
        H("  %i = alloca i64");
        H("  store i64 0, i64* %i");
        H("  br label %mcond");
        H("mcond:");
        H("  %iv = load i64, i64* %i");
        H("  %mdone = icmp sge i64 %iv, %n");
        H("  br i1 %mdone, label %alloc, label %mbody");
        H("mbody:");
        H("  %sl = call i64 @zlist_get(i8* %lst, i64 %iv)");
        H("  %sp = inttoptr i64 %sl to i8*");
        H("  %l = call i64 @zstr_clen(i8* %sp)");
        H("  %t0 = load i64, i64* %tot");
        H("  %t1 = add i64 %t0, %l");
        H("  %t2 = add i64 %t1, %lsep");
        H("  store i64 %t2, i64* %tot");
        H("  %ni = add i64 %iv, 1");
        H("  store i64 %ni, i64* %i");
        H("  br label %mcond");
        H("alloc:");
        H("  %tv = load i64, i64* %tot");
        H("  %bsz = add i64 %tv, 1");
        H("  %buf = call i8* @malloc(i64 %bsz)");
        H("  store i64 0, i64* %i");
        H("  %out = alloca i64");
        H("  store i64 0, i64* %out");
        H("  br label %ccond");
        H("ccond:");
        H("  %iv2 = load i64, i64* %i");
        H("  %cdone = icmp sge i64 %iv2, %n");
        H("  br i1 %cdone, label %fin, label %cbody");
        H("cbody:");
        H("  %first = icmp eq i64 %iv2, 0");
        H("  br i1 %first, label %citem, label %csep");
        H("csep:");
        H("  %ov = load i64, i64* %out");
        H("  %dst = getelementptr i8, i8* %buf, i64 %ov");
        H("  call i8* @memcpy(i8* %dst, i8* %sep, i64 %lsep)");
        H("  %ov1 = add i64 %ov, %lsep");
        H("  store i64 %ov1, i64* %out");
        H("  br label %citem");
        H("citem:");
        H("  %sl2 = call i64 @zlist_get(i8* %lst, i64 %iv2)");
        H("  %sp2 = inttoptr i64 %sl2 to i8*");
        H("  %l2 = call i64 @zstr_clen(i8* %sp2)");
        H("  %ov2 = load i64, i64* %out");
        H("  %dst2 = getelementptr i8, i8* %buf, i64 %ov2");
        H("  call i8* @memcpy(i8* %dst2, i8* %sp2, i64 %l2)");
        H("  %ov3 = add i64 %ov2, %l2");
        H("  store i64 %ov3, i64* %out");
        H("  %ni2 = add i64 %iv2, 1");
        H("  store i64 %ni2, i64* %i");
        H("  br label %ccond");
        H("fin:");
        H("  %ovf = load i64, i64* %out");
        H("  %finbuf = call i8* @zstr_new(i64 %ovf)");
        H("  call i8* @memcpy(i8* %finbuf, i8* %buf, i64 %ovf)");
        H("  ret i8* %finbuf");
        H("}");
        H("define i64 @zstr_isempty(i8* %s) {");
        H("entry:");
        H("  %isn = icmp eq i8* %s, null");
        H("  br i1 %isn, label %yes, label %chk");
        H("chk:");
        H("  %c = load i8, i8* %s");
        H("  %z = icmp eq i8 %c, 0");
        H("  br i1 %z, label %yes, label %no");
        H("yes:");
        H("  ret i64 1");
        H("no:");
        H("  ret i64 0");
        H("}");
    }

    // Dictionary<string,V>: growable parallel arrays { count, cap, i8** keys,
    // i64* values } with linear-scan lookup. Set updates in place on an existing
    // key, otherwise appends (capacity doubling). Keys are strings (strcmp).
    void EmitDictRuntime() {
        EmitDictRuntimeCore();
        EmitDictRuntimeMutate();
        EmitDictRuntimeQuery();
    }

    /// %zdict type + dtor/new/keys/values/index.
    void EmitDictRuntimeCore() {
        H("%zdict = type { i64, i64, i8**, i64*, i64 }");
        H("define void @zdict_dtor(i8* %p) {");
        H("entry:");
        H("  %d = bitcast i8* %p to %zdict*");
        H("  %optr = getelementptr %zdict, %zdict* %d, i32 0, i32 4");
        H("  %owns = load i64, i64* %optr");
        H("  %noown = icmp eq i64 %owns, 0");
        H("  br i1 %noown, label %freearrs, label %loopinit");
        H("loopinit:");
        H("  %cptr = getelementptr %zdict, %zdict* %d, i32 0, i32 0");
        H("  %count = load i64, i64* %cptr");
        H("  %vptr = getelementptr %zdict, %zdict* %d, i32 0, i32 3");
        H("  %vals = load i64*, i64** %vptr");
        H("  %ia = alloca i64");
        H("  store i64 0, i64* %ia");
        H("  br label %cond");
        H("cond:");
        H("  %i = load i64, i64* %ia");
        H("  %done = icmp sge i64 %i, %count");
        H("  br i1 %done, label %freearrs, label %body");
        H("body:");
        H("  %slot = getelementptr i64, i64* %vals, i64 %i");
        H("  %ev = load i64, i64* %slot");
        H("  %ep = inttoptr i64 %ev to i8*");
        H("  call void @zrelease(i8* %ep)");
        H("  %ni = add i64 %i, 1");
        H("  store i64 %ni, i64* %ia");
        H("  br label %cond");
        H("freearrs:");
        H("  %kptr = getelementptr %zdict, %zdict* %d, i32 0, i32 2");
        H("  %keys = load i8**, i8*** %kptr");
        H("  %keysi8 = bitcast i8** %keys to i8*");
        H("  call void @free(i8* %keysi8)");
        H("  %vptr2 = getelementptr %zdict, %zdict* %d, i32 0, i32 3");
        H("  %vals2 = load i64*, i64** %vptr2");
        H("  %valsi8 = bitcast i64* %vals2 to i8*");
        H("  call void @free(i8* %valsi8)");
        H("  ret void");
        H("}");
        H("define i8* @zdict_new(i64 %owns) {");
        H("  %p = call i8* @zalloc(i64 40, i8* bitcast (void (i8*)* @zdict_dtor to i8*), " + ContainerCid("Dict") + ")");
        H("  %d = bitcast i8* %p to %zdict*");
        H("  %c = getelementptr %zdict, %zdict* %d, i32 0, i32 0");
        H("  store i64 0, i64* %c");
        H("  %cap = getelementptr %zdict, %zdict* %d, i32 0, i32 1");
        H("  store i64 0, i64* %cap");
        H("  %k = getelementptr %zdict, %zdict* %d, i32 0, i32 2");
        H("  store i8** null, i8*** %k");
        H("  %v = getelementptr %zdict, %zdict* %d, i32 0, i32 3");
        H("  store i64* null, i64** %v");
        H("  %op = getelementptr %zdict, %zdict* %d, i32 0, i32 4");
        H("  store i64 %owns, i64* %op");
        H("  ret i8* %p");
        H("}");
        H("define i8* @zdict_keys(i8* %p) {");
        H("entry:");
        H("  %d = bitcast i8* %p to %zdict*");
        H("  %cptr = getelementptr %zdict, %zdict* %d, i32 0, i32 0");
        H("  %count = load i64, i64* %cptr");
        H("  %kptr = getelementptr %zdict, %zdict* %d, i32 0, i32 2");
        H("  %keys = load i8**, i8*** %kptr");
        H("  %out = call i8* @zlist_new(i64 0)");
        H("  %ia = alloca i64");
        H("  store i64 0, i64* %ia");
        H("  br label %cond");
        H("cond:");
        H("  %i = load i64, i64* %ia");
        H("  %more = icmp slt i64 %i, %count");
        H("  br i1 %more, label %body, label %done");
        H("body:");
        H("  %ks = getelementptr i8*, i8** %keys, i64 %i");
        H("  %k = load i8*, i8** %ks");
        H("  %kv = ptrtoint i8* %k to i64");
        H("  call void @zlist_add(i8* %out, i64 %kv)");
        H("  %i1 = add i64 %i, 1");
        H("  store i64 %i1, i64* %ia");
        H("  br label %cond");
        H("done:");
        H("  ret i8* %out");
        H("}");
        H("define i8* @zdict_values(i8* %p) {");
        H("entry:");
        H("  %d = bitcast i8* %p to %zdict*");
        H("  %cptr = getelementptr %zdict, %zdict* %d, i32 0, i32 0");
        H("  %count = load i64, i64* %cptr");
        H("  %vptr = getelementptr %zdict, %zdict* %d, i32 0, i32 3");
        H("  %vals = load i64*, i64** %vptr");
        H("  %out = call i8* @zlist_new(i64 0)");
        H("  %ia = alloca i64");
        H("  store i64 0, i64* %ia");
        H("  br label %cond");
        H("cond:");
        H("  %i = load i64, i64* %ia");
        H("  %more = icmp slt i64 %i, %count");
        H("  br i1 %more, label %body, label %done");
        H("body:");
        H("  %vs = getelementptr i64, i64* %vals, i64 %i");
        H("  %v = load i64, i64* %vs");
        H("  call void @zlist_add(i8* %out, i64 %v)");
        H("  %i1 = add i64 %i, 1");
        H("  store i64 %i1, i64* %ia");
        H("  br label %cond");
        H("done:");
        H("  ret i8* %out");
        H("}");
        H("define i64 @zdict_index(i8* %p, i8* %key) {");
        H("entry:");
        H("  %d = bitcast i8* %p to %zdict*");
        H("  %cptr = getelementptr %zdict, %zdict* %d, i32 0, i32 0");
        H("  %count = load i64, i64* %cptr");
        H("  %kptr = getelementptr %zdict, %zdict* %d, i32 0, i32 2");
        H("  %keys = load i8**, i8*** %kptr");
        H("  %ia = alloca i64");
        H("  store i64 0, i64* %ia");
        H("  br label %cond");
        H("cond:");
        H("  %i = load i64, i64* %ia");
        H("  %done = icmp sge i64 %i, %count");
        H("  br i1 %done, label %notfound, label %body");
        H("body:");
        H("  %slot = getelementptr i8*, i8** %keys, i64 %i");
        H("  %kk = load i8*, i8** %slot");
        H("  %cmp = call i32 @__zan_strcmp0(i8* %kk, i8* %key)");
        H("  %eq = icmp eq i32 %cmp, 0");
        H("  br i1 %eq, label %found, label %next");
        H("found:");
        H("  ret i64 %i");
        H("next:");
        H("  %ni = add i64 %i, 1");
        H("  store i64 %ni, i64* %ia");
        H("  br label %cond");
        H("notfound:");
        H("  ret i64 -1");
        H("}");
    }

    /// zdict_set / zdict_get (insert-or-update + lookup).
    void EmitDictRuntimeMutate() {
        H("define void @zdict_set(i8* %p, i8* %key, i64 %val) {");
        H("entry:");
        H("  %idx = call i64 @zdict_index(i8* %p, i8* %key)");
        H("  %exists = icmp sge i64 %idx, 0");
        H("  br i1 %exists, label %update, label %insert");
        H("update:");
        H("  %du = bitcast i8* %p to %zdict*");
        H("  %vpu = getelementptr %zdict, %zdict* %du, i32 0, i32 3");
        H("  %valsu = load i64*, i64** %vpu");
        H("  %su = getelementptr i64, i64* %valsu, i64 %idx");
        H("  %oldval = load i64, i64* %su");
        H("  store i64 %val, i64* %su");
        H("  %opu = getelementptr %zdict, %zdict* %du, i32 0, i32 4");
        H("  %ownsu = load i64, i64* %opu");
        H("  %doarcu = icmp ne i64 %ownsu, 0");
        H("  br i1 %doarcu, label %arcu, label %doneu");
        H("arcu:");
        H("  %nvpu = inttoptr i64 %val to i8*");
        H("  call void @zretain(i8* %nvpu)");
        H("  %ovpu = inttoptr i64 %oldval to i8*");
        H("  call void @zrelease(i8* %ovpu)");
        H("  br label %doneu");
        H("doneu:");
        H("  ret void");
        H("insert:");
        H("  %d = bitcast i8* %p to %zdict*");
        H("  %cptr = getelementptr %zdict, %zdict* %d, i32 0, i32 0");
        H("  %count = load i64, i64* %cptr");
        H("  %capptr = getelementptr %zdict, %zdict* %d, i32 0, i32 1");
        H("  %cap = load i64, i64* %capptr");
        H("  %full = icmp sge i64 %count, %cap");
        H("  br i1 %full, label %grow, label %st");
        H("grow:");
        H("  %nc0 = mul i64 %cap, 2");
        H("  %isz = icmp eq i64 %nc0, 0");
        H("  %nc = select i1 %isz, i64 4, i64 %nc0");
        H("  %kptr = getelementptr %zdict, %zdict* %d, i32 0, i32 2");
        H("  %oldk = load i8**, i8*** %kptr");
        H("  %oldki8 = bitcast i8** %oldk to i8*");
        H("  %kbytes = mul i64 %nc, 8");
        H("  %newki8 = call i8* @realloc(i8* %oldki8, i64 %kbytes)");
        H("  %newk = bitcast i8* %newki8 to i8**");
        H("  store i8** %newk, i8*** %kptr");
        H("  %vptr = getelementptr %zdict, %zdict* %d, i32 0, i32 3");
        H("  %oldv = load i64*, i64** %vptr");
        H("  %oldvi8 = bitcast i64* %oldv to i8*");
        H("  %vbytes = mul i64 %nc, 8");
        H("  %newvi8 = call i8* @realloc(i8* %oldvi8, i64 %vbytes)");
        H("  %newv = bitcast i8* %newvi8 to i64*");
        H("  store i64* %newv, i64** %vptr");
        H("  store i64 %nc, i64* %capptr");
        H("  br label %st");
        H("st:");
        H("  %kptr2 = getelementptr %zdict, %zdict* %d, i32 0, i32 2");
        H("  %keys = load i8**, i8*** %kptr2");
        H("  %kslot = getelementptr i8*, i8** %keys, i64 %count");
        H("  store i8* %key, i8** %kslot");
        H("  %vptr2 = getelementptr %zdict, %zdict* %d, i32 0, i32 3");
        H("  %vals = load i64*, i64** %vptr2");
        H("  %vslot = getelementptr i64, i64* %vals, i64 %count");
        H("  store i64 %val, i64* %vslot");
        H("  %ncount = add i64 %count, 1");
        H("  store i64 %ncount, i64* %cptr");
        H("  %opi = getelementptr %zdict, %zdict* %d, i32 0, i32 4");
        H("  %ownsi = load i64, i64* %opi");
        H("  %doarci = icmp ne i64 %ownsi, 0");
        H("  br i1 %doarci, label %arci, label %donei");
        H("arci:");
        H("  %nvpi = inttoptr i64 %val to i8*");
        H("  call void @zretain(i8* %nvpi)");
        H("  br label %donei");
        H("donei:");
        H("  ret void");
        H("}");
        H("define i64 @zdict_get(i8* %p, i8* %key) {");
        H("entry:");
        H("  %idx = call i64 @zdict_index(i8* %p, i8* %key)");
        H("  %nf = icmp slt i64 %idx, 0");
        H("  br i1 %nf, label %ret0, label %load");
        H("ret0:");
        H("  ret i64 0");
        H("load:");
        H("  %d = bitcast i8* %p to %zdict*");
        H("  %vptr = getelementptr %zdict, %zdict* %d, i32 0, i32 3");
        H("  %vals = load i64*, i64** %vptr");
        H("  %slot = getelementptr i64, i64* %vals, i64 %idx");
        H("  %v = load i64, i64* %slot");
        H("  ret i64 %v");
        H("}");
    }

    /// zdict_contains / zdict_remove / zdict_count.
    void EmitDictRuntimeQuery() {
        H("define i64 @zdict_contains(i8* %p, i8* %key) {");
        H("  %idx = call i64 @zdict_index(i8* %p, i8* %key)");
        H("  %ge = icmp sge i64 %idx, 0");
        H("  %r = zext i1 %ge to i64");
        H("  ret i64 %r");
        H("}");
        H("define i64 @zdict_remove(i8* %p, i8* %key) {");
        H("entry:");
        H("  %idx = call i64 @zdict_index(i8* %p, i8* %key)");
        H("  %nf = icmp slt i64 %idx, 0");
        H("  br i1 %nf, label %ret0, label %doit");
        H("ret0:");
        H("  ret i64 0");
        H("doit:");
        H("  %d = bitcast i8* %p to %zdict*");
        H("  %cptr = getelementptr %zdict, %zdict* %d, i32 0, i32 0");
        H("  %count = load i64, i64* %cptr");
        H("  %kptr = getelementptr %zdict, %zdict* %d, i32 0, i32 2");
        H("  %keys = load i8**, i8*** %kptr");
        H("  %vptr = getelementptr %zdict, %zdict* %d, i32 0, i32 3");
        H("  %vals = load i64*, i64** %vptr");
        H("  %optr = getelementptr %zdict, %zdict* %d, i32 0, i32 4");
        H("  %owns = load i64, i64* %optr");
        H("  %doarc = icmp ne i64 %owns, 0");
        H("  br i1 %doarc, label %arc, label %shiftinit");
        H("arc:");
        H("  %vs = getelementptr i64, i64* %vals, i64 %idx");
        H("  %ov = load i64, i64* %vs");
        H("  %op = inttoptr i64 %ov to i8*");
        H("  call void @zrelease(i8* %op)");
        H("  br label %shiftinit");
        H("shiftinit:");
        H("  %ia = alloca i64");
        H("  store i64 %idx, i64* %ia");
        H("  %last = sub i64 %count, 1");
        H("  br label %cond");
        H("cond:");
        H("  %i = load i64, i64* %ia");
        H("  %done = icmp sge i64 %i, %last");
        H("  br i1 %done, label %fin, label %body");
        H("body:");
        H("  %i1 = add i64 %i, 1");
        H("  %ks = getelementptr i8*, i8** %keys, i64 %i1");
        H("  %kv = load i8*, i8** %ks");
        H("  %kd = getelementptr i8*, i8** %keys, i64 %i");
        H("  store i8* %kv, i8** %kd");
        H("  %vss = getelementptr i64, i64* %vals, i64 %i1");
        H("  %vv = load i64, i64* %vss");
        H("  %vd = getelementptr i64, i64* %vals, i64 %i");
        H("  store i64 %vv, i64* %vd");
        H("  store i64 %i1, i64* %ia");
        H("  br label %cond");
        H("fin:");
        H("  store i64 %last, i64* %cptr");
        H("  ret i64 1");
        H("}");
        H("define i64 @zdict_count(i8* %p) {");
        H("  %d = bitcast i8* %p to %zdict*");
        H("  %cptr = getelementptr %zdict, %zdict* %d, i32 0, i32 0");
        H("  %c = load i64, i64* %cptr");
        H("  ret i64 %c");
        H("}");
        H("define void @zdict_clear(i8* %p) {");
        H("  %d = bitcast i8* %p to %zdict*");
        H("  %cptr = getelementptr %zdict, %zdict* %d, i32 0, i32 0");
        H("  %count = load i64, i64* %cptr");
        H("  %vptr = getelementptr %zdict, %zdict* %d, i32 0, i32 3");
        H("  %vals = load i64*, i64** %vptr");
        H("  %optr = getelementptr %zdict, %zdict* %d, i32 0, i32 4");
        H("  %owns = load i64, i64* %optr");
        H("  %owned = icmp ne i64 %owns, 0");
        H("  br i1 %owned, label %loop, label %done");
        H("loop:");
        H("  %i = alloca i64");
        H("  store i64 0, i64* %i");
        H("  br label %lc");
        H("lc:");
        H("  %iv = load i64, i64* %i");
        H("  %more = icmp slt i64 %iv, %count");
        H("  br i1 %more, label %lb, label %done");
        H("lb:");
        H("  %vp = getelementptr i64, i64* %vals, i64 %iv");
        H("  %vv = load i64, i64* %vp");
        H("  %obj = inttoptr i64 %vv to i8*");
        H("  call void @zrelease(i8* %obj)");
        H("  %next = add i64 %iv, 1");
        H("  store i64 %next, i64* %i");
        H("  br label %lc");
        H("done:");
        H("  store i64 0, i64* %cptr");
        H("  ret void");
        H("}");
    }

    void EmitStrcmp0() {
        H("define internal i32 @__zan_strcmp0(i8* %a, i8* %b) {");
        H("entry:");
        H("  %p_eq = icmp eq i8* %a, %b");
        H("  br i1 %p_eq, label %ret_zero, label %chk_a");
        H("chk_a:");
        H("  %a_null = icmp eq i8* %a, null");
        H("  br i1 %a_null, label %ret_neg, label %chk_b");
        H("chk_b:");
        H("  %b_null = icmp eq i8* %b, null");
        H("  br i1 %b_null, label %ret_pos, label %do_cmp");
        H("do_cmp:");
        // length-aware compare: the strings may carry embedded NUL bytes
        H("  %la = call i64 @zstr_len(i8* %a)");
        H("  %lb = call i64 @zstr_len(i8* %b)");
        H("  %minlt = icmp ult i64 %la, %lb");
        H("  %min = select i1 %minlt, i64 %la, i64 %lb");
        H("  %c = call i32 @memcmp(i8* %a, i8* %b, i64 %min)");
        H("  %neq = icmp ne i32 %c, 0");
        H("  br i1 %neq, label %ret_c, label %lencmp");
        H("ret_c:");
        H("  ret i32 %c");
        H("lencmp:");
        H("  %lt_a = icmp slt i64 %la, %lb");
        H("  br i1 %lt_a, label %ret_neg, label %chk_len2");
        H("chk_len2:");
        H("  %lt_b = icmp sgt i64 %la, %lb");
        H("  br i1 %lt_b, label %ret_pos, label %ret_zero");
        H("ret_zero:");
        H("  ret i32 0");
        H("ret_neg:");
        H("  ret i32 -1");
        H("ret_pos:");
        H("  ret i32 1");
        H("}");
    }

    void GenClass(Node cls) {
        curClass = cls.sval;
        int i = 0;
        while (i < cls.kids.Count) {
            Node m = cls.kids[i];
            if (m.kind == AK.MethodDecl()) {
                // abstract/interface methods have no body: no function is emitted
                if (HasMod(m, MOD.Extern())) {
                    // builtin-lowered externs (Vector128/256 hardware SIMD,
                    // BitOperations bit twiddling) get no declaration: their
                    // call sites are lowered inline and nothing references
                    // the raw symbol. NativeMemory keeps declarations only
                    // for methods GenNativeMemory does not lower (they route
                    // to zan_hw_* in the C runtime).
                    bool lowered = false;
                    if (cls.sval == "Vector128" || cls.sval == "Vector256" || cls.sval == "BitOperations"
                        || cls.sval == "Sse2" || cls.sval == "Aes") {
                        lowered = true;
                    } else if (cls.sval == "NativeMemory") {
                        string nm = ExternName(m);
                        if (nm == "Alloc" || nm == "Free" || nm == "Copy" || nm == "Fill"
                            || nm == "Compare" || nm == "GetString" || nm == "PutString"
                            || nm == "Crc32" || nm == "Crc32C" || nm == "Crc32CUpdate"
                            || nm == "Find" || nm == "Base64Encode" || nm == "Base64Decode") {
                            lowered = true;
                        }
                    }
                    if (!lowered) { DeclareExtern(cls, m); }
                }
                else if (!IsAbstract(m)) { GenMethod(cls, m, false); }
            }
            else if (m.kind == AK.CtorDecl()) {
                // a static constructor is not an instance constructor: it has
                // no receiver and runs once at program entry
                if (IsStatic(m)) { GenStaticCtor(cls, m); }
                else { GenCtor(cls, m); }
            }
            i = i + 1;
        }
        // A class whose inheritance chain declares instance field initializers
        // gets a helper function that runs them. It is called from the
        // allocation site when no constructor matches, and from a derived
        // constructor when the base constructor was not called (the base
        // constructor would have run them itself).
        if (HasChainFieldInits(cls)) { GenFieldInitsFn(cls); }
    }

    // True when `cls` or one of its base classes declares an instance field
    // initializer: the initializers of the whole chain run together, the base
    // class ones first (C# order).
    bool HasChainFieldInits(Node cls) {
        if (cls == null) { return false; }
        if (HasChainFieldInits(BaseClassOf(cls))) { return true; }
        int i = 0;
        while (i < cls.kids.Count) {
            Node m = cls.kids[i];
            if (m.kind == AK.FieldDecl() && !IsStatic(m) && m.b != null) { return true; }
            i = i + 1;
        }
        return false;
    }

    // The LLVM symbol of the field initializer helper of `cls`.
    string FieldInitsSym(Node cls) { return "__zan_finits_" + cls.sval; }

    // The instance field initializers of `cls` (declaration order): C# runs
    // them at the start of the constructor, before the constructor body.
    void EmitFieldInits(Node cls, string thisOp) {
        if (cls == null) { return; }
        int i = 0;
        while (i < cls.kids.Count) {
            Node m = cls.kids[i];
            if (m.kind == AK.FieldDecl() && !IsStatic(m) && m.b != null) {
                ExprVal v = null;
                // a Binding<T> field takes a fresh Binding object (the C
                // host's emit_binding_value)
                if (IsBindingTy(m.type)) { v = GenBindingValue(m.b, m.type); }
                if (v == null) { v = GenExpr(m.b); }
                StoreField(thisOp, cls.sval, m.sval, v);
            }
            i = i + 1;
        }
    }

    // The instance field initializers of the whole inheritance chain, root
    // first (C# order): the base class initializers run before the derived
    // ones. `thisOp` points at the most derived object; it is bitcast to the
    // layout of every base class on the way down (the base fields are the
    // layout prefix of the derived struct).
    void EmitChainFieldInits(Node cls, string thisOp, string thisTy) {
        if (cls == null) { return; }
        Node b = BaseClassOf(cls);
        if (b != null) {
            string bop = thisOp;
            if (b.sval != thisTy) {
                bop = NT();
                L("  " + bop + " = bitcast %" + thisTy + "* " + thisOp + " to %" + b.sval + "*");
            }
            EmitChainFieldInits(b, bop, b.sval);
        }
        EmitFieldInits(cls, thisOp);
    }

    bool IsStatic(Node m) { return (m.mods / MOD.Static()) - ((m.mods / MOD.Static()) / 2) * 2 == 1; }

    void StartFn() {
        tmp = 0; lbl = 0; term = false;
        curLbl = "entry";
        locName = new List<string>();
        locType = new List<Node>();
        locReg = new List<string>();
        locBox = new List<bool>();
        locIter = new List<bool>();
        locCell = new List<string>();
        locRef = new List<bool>();
        capNames = new List<string>();
        locSeq = 0;
        stmtTemps = new List<string>();
        stmtTempTypes = new List<Node>();
        loopScopeBase = 0;
        gotoNames = new List<string>();
        gotoIds = new List<int>();
    }

    // Resolve a goto label name to a stable per-function label id, allocating
    // one on first use so forward references (goto before label) work.
    int LabelId(string name) {
        int i = 0;
        while (i < gotoNames.Count) {
            if (gotoNames[i] == name) { return gotoIds[i]; }
            i = i + 1;
        }
        int id = NL();
        gotoNames.Add(name);
        gotoIds.Add(id);
        return id;
    }

    bool IsAsync(Node m) {
        int b = m.mods / 2048;
        return b - (b / 2) * 2 == 1;
    }
}
