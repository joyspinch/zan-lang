using System;
using System.Collections.Generic;
namespace Zan;

partial class Ngen {

    // ---- Hook F target: the entry shim's async Main drive ----
    // Ramps the async Main, readies the frame against its own $resume, pumps
    // the queue until the frame completes, propagates an escaping exception
    // (empty handler stack: the runtime exits 1), and leaves the result in x0
    // for `async int Main` exit codes (void/Task exits 0).
    void EmitAsyncMainDriveNg(int mainIdx) {
        Node m = methNodes[mainIdx];
        int overRt = NL();
        EmitB(overRt);                               // jump over the runtime blob:
        EnsureAsyncRuntimeNg();                      // it is emitted at the shim's
                                                     // fall-through position, so the
                                                     // shim must not run into it
        Mark(overRt);
        BLInternal(MethSymNg(methCls[mainIdx], m));  // x0 = the Main frame (ramp)
        MovRR(9, 0);
        XPushR(9);                              // hold frame
        LoadSymRef(AsyncResumeSymNg(mainIdx), 1);    // x1 = $resume
        MovRR(0, 9);
        BLInternal("_zan_co_ready");                 // ready(frame, resume)
        XPopV(9);                              // x9 = frame
        MovRR(0, 9);
        AddImm(0, 0, 8);                             // x0 = &frame[1] (done)
        XPushR(9);                              // hold frame across the pump
        LoadImm(1, 0);                               // mode 0: preempt on done
        BLInternal("_zan_co_sched_run_until");
        XPopV(9);                              // x9 = frame
        LdrU(2, 9, 48);                              // frame[6] (exc)
        int noExc = NL();
        CbzReg(2, noExc);
        XPushR(2);                              // hold exc across call
        BLInternal("_zan_rt_eh_state");
        MovRR(1, 0);
        XPopV(2);                              // x2 = exception
        StrU(2, 1, 8);                               // state->exc = exc
        EhRethrowNg();                               // unwinds to exit(1)
        Mark(noExc);
        LdrU(0, 9, 32);                              // x0 = frame[4] (result)
        string el = AsyncElemTyOfMethod(m);
        if (el == "int") {
            Sxtw0();                          // sxtw x0, w0
        } else if (el != "long") {
            LoadImm(0, 0);                           // void/Task/other: exit 0
        }
    }

    // ---- Hook D target: full emission of one async method ----
    void EmitAsyncMethodNg(string cls, Node m, int mi) {
        EnsureAsyncRuntimeNg();
        curCls = cls;
        curMeth = m;
        curLine = m.line;
        curCol = m.col;
        gotoNames.Clear();
        gotoIds.Clear();
        bool inst = methStat[mi] == 0;
        if (m.sval == "Main" && !IsAsync(m)) {
            diags.Error("ngen: 'Main' must be static (the entry shim calls it directly)", m.line, m.col);
        }
        if (HasTypeParams(m)) {
            return;
        }
        // virtual/abstract async methods emit like any other: the ramp keeps
        // the original signature, so a vtable/interface slot holds it and a
        // dispatched call yields the frame handle the awaiter drives
        int nArgs = inst ? ParamCount(m) + 1 : ParamCount(m);
        string rampSym = MethSymNg(cls, m);
        asyncResumeSym = rampSym + "$resume";
        asyncFeNodes = new List<Node>();
        asyncSwNodes = new List<Node>();
        asyncTryNodes = new List<Node>();
        AsyncScanCtrlNodesNg(m.d, asyncFeNodes, asyncSwNodes, asyncTryNodes);
        int nAwaits = CountAsyncSuspendsNg(m.d);
        if (asyncTryNodes.Count > 0) {
            nAwaits = nAwaits + asyncTryNodes.Count * 8 + 16;
        }
        asyncGotoNames = new List<string>();
        asyncGotoFinDepths = new List<int>();
        asyncGotoTryDepths = new List<int>();
        AsyncScanGotoLabelsNg(m.d, 0, 0);
        int gi = 0;
        while (gi < asyncGotoNames.Count) {
            string gname = asyncGotoNames[gi];
            bool exists = false;
            int ej = 0;
            while (ej < gotoNames.Count) {
                if (gotoNames[ej] == gname) { exists = true; break; }
                ej = ej + 1;
            }
            if (!exists) {
                gotoNames.Add(gname);
                gotoIds.Add(NL());
            }
            gi = gi + 1;
        }

        AsyncDeclareSlotsNg(cls, m, inst);
        // saved-set size: user locals + ctrl scratches + #atryret + #atryexc + #afinret + #afinexc
        // (heap mirror count and ramp size); #aframe/#aehtop0 live above it, unsaved
        int nSlots = nloc - 2;
        asyncFeBase = nSlots - asyncFeNodes.Count - asyncSwNodes.Count - 2 * asyncTryNodes.Count - 2;
        asyncSwBase = asyncFeBase + asyncFeNodes.Count;
        asyncTryRetBase = asyncSwBase + asyncSwNodes.Count;
        asyncTryExcBase = asyncTryRetBase + asyncTryNodes.Count;
        asyncFinRetLocal = asyncTryExcBase + asyncTryNodes.Count;
        asyncFinExcLocal = asyncFinRetLocal + 1;

        // heap-frame map (words): [0..8] header (state/done/awaiter/
        // awaiter_step/result/own_resume/exc/cancel/child), then the saved
        // local mirror, then one slot per await's sub handle. The child word
        // is what Task.Cancel's walk follows: a frame awaiting a sub records
        // it there, so cancelling a parent marks everything it is
        // transitively suspended on.

        // ---- ramp: <Cls>_<name>(args...) -> frame ----
        syms.Add(new Sym(rampSym, FnPad()));
        RtPrologue();
        // spill the incoming arguments first: loading the alloc size into x0
        // and calling _zan_rt_alloc would otherwise clobber them (every push
        // is 16 bytes, so sp stays 16-aligned for any argument count)
        int ar = nArgs;
        while (ar > 0) {
            ar = ar - 1;
            if (tgt86 == 1 && ar >= 6) {
                // x86 SysV 第 7+ 参在调用方 XCallSeq 押的栈上,callee 视角
                // [rbp+16+8*(ar-6)]——与普通方法序言(ngen.zan EmitMethod
                // 的 incoming 栈参装载)同一契约。v6/v7 在 x86 不是实参
                // 寄存器,XPushR(ar) 会去泼溅家读上个函数的陈值:异步
                // 方法第 7+ 参一律变垃圾,HttpServer.ServeFramedCore 的
                // watch/client 就这么烂掉,HttpDeadline.Touch 透过垃圾
                // token 指针把 monotonic 截止写进隔壁刚分配的 TcpClient
                // 的 sock(批46 服务端响应 fd 涂写根因;arm64 x6/x7 是
                // 实参寄存器,一直没露馅)。
                XSubRsp(16);
                XopRMem(0x8B, 10, 5, 16 + 8 * (ar - 6));   // mov r10,[rbp+…]
                XopMemR(0x89, 10, 4, 0);                   // mov [rsp], r10
            } else {
                XPushR(ar);                   // push x(nArgs-1)..x0
            }
        }
        LoadImm(0, (9 + nSlots + nAwaits) * 8);
        LoadImm(1, 0);
        BLInternal("_zan_rt_alloc");                 // zeroed heap frame
        MovRR(9, 0);
        LoadSymRef(asyncResumeSym, 0);
        StrU(0, 9, 40);                              // frame[5] = own_resume
        ar = 0;
        while (ar < nArgs) {
            XPopV(10);                     // pop into scratch x10 (x9 holds frame!)
            StrU(10, 9, 72 + 8 * ar);                // frame[9+i] = arg i
            ar = ar + 1;
        }
        MovRR(0, 9);                                 // the ramp returns the frame
        Epilogue();

        // ---- $resume(frame): prologue, trampoline, dispatch, body ----
        syms.Add(new Sym(asyncResumeSym, FnPad()));
        AsyncDeclareSlotsNg(cls, m, inst);
        asyncFrameLocal = nloc - 2;
        asyncEhtopLocal = nloc - 1;
        asyncSaveCount = nloc - 2;
        asyncSubBase = 9 + (nloc - 2);
        asyncSubNext = 0;
        asyncNextState = 1;
        asyncResumeLbls = new List<int>();
        hoistNodes = new List<Node>();
        hoistSlots = new List<int>();
        asyncTryCatchLs = new List<int>();
        asyncTryFinLs = new List<int>();
        asyncOpenTryNodes = new List<Node>();
        asyncBrkTryBase = new List<int>();
        asyncCntTryBase = new List<int>();
        finCur = -1;
        finActive = new List<int>();
        int lw = 0;
        while (lw < nAwaits) { asyncResumeLbls.Add(NL()); lw = lw + 1; }
        curHasTry = false;
        frame = 16 * nloc;
        // x86 必须走 XPrologue:它把泼溅基 xFrame 布到本函数局部区之下。
        // 手搓 push rbp/mov rbp,rsp 时 xFrame 还是上一个函数的旧值,泼溅
        // 槽落进本帧局部区,恰好盖住 #aframe/#aehtop——字符串 magic 检查
        // 的比较暂存把 -1 写进 #aframe,完成序言拿它当帧指针,
        // frame[4]=result 写到 [-1+0x20] 段错误(批46 http_framing 根因)。
        if (tgt86 == 1) { XPrologue(frame); } else { E4(0xA9BF7BFD); E4(0x910003FD); }
        if (tgt86 != 1 && frame > 0) { AddSPImm(frame, false); }
        StoreLocal(asyncFrameLocal, 0);              // x0 = frame

        // cancellation (irgen_async.c's emit_async_cancel_check, hoisted to
        // the one boundary every state passes through): a marked frame never
        // runs body code again -- it completes early through the normal
        // completion protocol (done = 1, state = -1, wake the awaiter),
        // exactly once; later wakeups (its own delay timer still pending, a
        // stray re-ready) just return. Nothing here can throw, so the check
        // sits before the setjmp arm; a suspended frame's buffers are
        // disarmed anyway. This is what makes a spawn cancelled before the
        // scheduler ever steps it never start at all.
        LoadLocal(asyncFrameLocal, 9);
        LdrU(10, 9, 56);                             // cancel flag
        int uncancelled = NL();
        CbzReg(10, uncancelled);
        LdrU(10, 9, 8);                              // done
        int alreadyDone = NL();
        CbnzReg(10, alreadyDone);
        MovRR(1, 9);
        LoadImm(0, 1);
        StrU(0, 1, 8);                               // done = 1
        LoadImm(0, -1);
        StrU(0, 1, 0);                               // state = -1
        LdrU(2, 1, 16);                              // awaiter
        int noAwC = NL();
        CbzReg(2, noAwC);
        LdrU(3, 1, 24);                              // awaiter_step
        MovRR(0, 2);
        MovRR(1, 3);
        BLInternal("_zan_co_ready");
        Mark(noAwC);
        Epilogue();
        Mark(alreadyDone);
        Epilogue();
        Mark(uncancelled);

        // one setjmp trampoline per $resume invocation (irgen_async.c:1300):
        // armed at entry, disarmed on every exit path
        int catchL = NL();
        int badStateL = NL();
        BLInternal("_zan_rt_eh_state");              // x0 = state
        LdrU(1, 0, 0);                               // top
        StoreLocal(asyncEhtopLocal, 1);              // pre-arm top
        LoadImm(3, 1024);
        MaddRR(2, 1, 3, 31);                              // mul x2, x1, x3
        AddRR(2, 0, 2);
        AddImm(2, 2, 16);                            // &bufs[top]
        AddImm(1, 1, 1);
        StrU(1, 0, 0);                               // state->top = top + 1
        MovRR(0, 2);
        BLExtern("_setjmp");                         // 0 direct / 1 thrown
        EmitCbnz(0, catchL);
        BLInternal("_zan_rt_eh_state");              // stamp the buf as live
        LoadLocal(asyncEhtopLocal, 1);               // (GenTry's liveness
        LoadImm(3, 1024);                            // contract: arming fp +
        MaddRR(2, 1, 3, 31);                              // magic, checked by the
        AddRR(2, 0, 2);                              // rethrow path)
        AddImm(2, 2, 16);
        MovRR(3, 29);                              // mov x3, x29
        StrU(3, 2, 1008);
        LoadImm(3, 1514933314);                      // "ZANB"
        StrU(3, 2, 1016);

        // dispatch on state (0 = body start, k = resume after await k,
        // anything else = a done/stray frame: just return)
        LoadLocal(asyncFrameLocal, 9);
        LdrU(9, 9, 0);                               // x9 = state
        int dk = 1;
        while (dk <= nAwaits) {
            LoadImm(10, dk);
            CmpRR(9, 10);                            // cmp x9, x10
            EmitBcond(0, asyncResumeLbls[dk - 1]);
            dk = dk + 1;
        }
        CmpRR(9, 31);                       // cmp x9, xzr
        EmitBcond(1, badStateL);

        // state 0: pull this/params out of the frame (locals start zeroed)
        LoadLocal(asyncFrameLocal, 1);
        int ri = 0;
        while (ri < nArgs) { LdrU(0, 1, 72 + 8 * ri); StoreLocal(ri, 0); ri = ri + 1; }

        inAsyncNg = true;
        GenAsyncStmtNg(m.d);
        inAsyncNg = false;
        LoadImm(0, 0);
        EmitAsyncCompleteNg();                       // fell off the end: void

        Mark(badStateL);
        AsyncEhUnarmNg();
        Epilogue();

        // thrown path: park the exception in frame[6], complete as void
        Mark(catchL);
        BLInternal("_zan_rt_eh_state");
        MovRR(1, 0);
        LdrU(2, 1, 8);                               // state->exc
        LoadLocal(asyncFrameLocal, 3);
        StrU(2, 3, 48);                              // frame[6] = exc
        // B-ID79 镜像: 父协程异常退出级联取消子协程
        LdrU(0, 3, 64);                              // frame[8] = child
        BLInternal("_zan_ng_co_cancel");
        LoadImm(0, 0);
        EmitAsyncCompleteNg();

        int mk = 0;
        while (mk < asyncResumeLbls.Count) {
            if (lblPos[asyncResumeLbls[mk]] < 0) {
                // a reserved state no await ever armed (the finally copy count
                // over-approximates exit paths): an unreachable stub keeps the
                // image well-formed. State k is only ever stored by the await
                // emission that marks its label, so nothing lands here.
                Mark(asyncResumeLbls[mk]);
                Epilogue();
            }
            mk = mk + 1;
        }
        asyncResumeLbls = null;
    }

    // disarm the trampoline: the runtime top goes back to the pre-arm value
    void AsyncEhUnarmNg() {
        BLInternal("_zan_rt_eh_state");
        MovRR(1, 0);
        LoadLocal(asyncEhtopLocal, 0);
        StrU(0, 1, 0);
    }

    // completion epilogue (irgen_async.c:162-233): result -> frame[4],
    // done = 1, state = -1, wake the awaiter if one is registered. x0 = result.
    void EmitAsyncCompleteNg() {
        LoadLocal(asyncFrameLocal, 1);
        StrU(0, 1, 32);                              // frame[4] = result
        LoadImm(0, 1);
        StrU(0, 1, 8);                               // frame[1] = done
        LoadImm(0, -1);
        StrU(0, 1, 0);                               // frame[0] = -1
        LdrU(2, 1, 16);                              // awaiter
        int noAw = NL();
        EmitCBZ(2, noAw);
        LdrU(3, 1, 24);                              // awaiter_step
        MovRR(0, 2);
        MovRR(1, 3);
        BLInternal("_zan_co_ready");
        Mark(noAw);
        AsyncEhUnarmNg();
        Epilogue();
    }

    // save/restore every named slot around a suspension. System slots
    // (#aframe, #aehtop0) are excluded: #aframe is reloaded at $resume entry
    // and #aehtop0 is restamped there, so restoring them from the frame would
    // rewind the live trampoline's own bookkeeping.
    void SaveSlotsNg() {
        LoadLocal(asyncFrameLocal, 1);
        int i = 0;
        while (i < asyncSaveCount) {
            LoadLocal(i, 0);
            StrU(0, 1, 72 + 8 * i);                  // heap 9+i mirrors stack i
            i = i + 1;
        }
    }

    void ReloadSlotsNg() {
        LoadLocal(asyncFrameLocal, 1);
        int i = 0;
        while (i < asyncSaveCount) {
            LdrU(0, 1, 72 + 8 * i);
            StoreLocal(i, 0);
            i = i + 1;
        }
    }

    // store x0 into an assignment target (store half of the Assignment arm)
    void AsyncStoreNg(Node tgt, Node asg) {
        if (tgt.kind == AK.Ident()) {
            int li = LocalIdx(tgt.sval);
            if (li >= 0) {
                if (locRef[li]) {
                    LoadLocal(li, 1);
                    StrU(0, 1, 0);                   // store through the ref
                } else {
                    StoreLocalVal(li, 0);
                }
                return;
            }
            Fld fld = CurField(tgt.sval);
            if (fld != null) {
                PushV(0);                      // push value
                LoadLocal(LocalIdx("this"), 0);
                PopV(1);
                StoreFieldNg(1, 0, fld);
                return;
            }
            string ssym = FindStaticSym(curCls, tgt.sval);
            if (ssym != null) {
                LoadSymRef(ssym, 9);
                StrU(0, 9, 0);
                return;
            }
            diags.Error("ngen: unknown identifier '" + tgt.sval + "'", asg.line, asg.col);
            return;
        }
        if (tgt.kind == AK.MemberAccess() && tgt.a != null && tgt.a.kind == AK.Ident()) {
            string msym = FindStaticSym(QualifiedCls(tgt.a.sval, tgt.sval2), tgt.sval);
            if (msym != null) {
                PushV(0);                      // push value
                LoadSymRef(msym, 1);
                PopV(0);
                StrU(0, 1, 0);
                return;
            }
        }
        if (tgt.kind == AK.MemberAccess() && tgt.a != null) {
            // instance field store, receiver any expression: `this.tls`,
            // `conn.buf`, chains. StaticTyOf knows ThisExpr (the current
            // class, instantiation via curMeth.sval2) so FieldOf resolves
            // the same field the non-await assignment arm would.
            Fld f = FieldOf(tgt);
            if (f != null) {
                PushV(0);                      // push value
                GenExpr(tgt.a);                      // receiver -> x0
                PopV(1);
                StoreFieldNg(1, 0, f);
                return;
            }
        }
        if (tgt.kind == AK.Index() && tgt.a != null && ArrContainerTy(tgt.a) != null) {
            // array element store: same bounds rule and evaluation order as
            // the non-await arm -- the await result is on the stack while
            // container and index re-evaluate from reloaded slots
            int esz = ArrElemSize(ArrContainerTy(tgt.a));
            PushV(0);                          // push value
            GenExpr(tgt.a);
            PushV(0);                          // push arr
            GenExpr(tgt.b);                          // x0 = idx
            PopV(1);                          // pop arr -> x1
            PopV(2);                          // pop value -> x2
            if (tgt86 == 1) { LdrU(3, 1, -16); } else { E4(0xF85F0023); }   // ldur x3, [x1, #-16] (len)
            int bad = NL();
            int cont = NL();
            E4(0xEB03001F);                          // cmp x0, x3
            EmitBcond(10, bad);                      // b.ge bad
            CmpRR(0, 31);                          // cmp x0, xzr
            EmitBcond(11, bad);                      // b.lt bad
            EmitB(cont);
            Mark(bad);
            PushV(1);                          // keep arr (guard clobbers x1)
            PushV(0);                          // keep idx
            PushV(2);                          // keep value
            LoadSymRef("l_.str." + guardFileIdx, 0);
            LoadImm(1, asg.line);
            LoadImm(2, asg.col);
            LoadSymRef("l_.str." + guardArrIdx, 3);
            BLInternal("_zan_rt_guard_fail3");
            PopV(2);                          // pop value
            PopV(0);                          // pop idx
            PopV(1);                          // pop arr
            LoadImm(0, 0);
            Mark(cont);
            if (esz == 1) {
                E4(0x38206822);                      // strb w2, [x1, x0]
            } else if (esz == 2) {
                E4(0x78206822);                      // strh w2, [x1, x0]
            } else if (esz == 4) {
                E4(0xB8207822);                      // str w2, [x1, x0, lsl #2]
            } else {
                E4(0xF8207822);                      // str x2, [x1, x0, lsl #3]
            }
            return;
        }
        diags.Error("ngen: unsupported assignment target in an async method", asg.line, asg.col);
    }
}
