using System;
using System.Collections.Generic;
namespace Zan;

partial class Ngen {

    void CheckExternNg(Node m) {
        if (!HasMod(m, MOD.Static()) || HasTypeParams(m)) {
            diags.Error("ngen: extern requires a non-generic static method '" + m.sval + "'", m.line, m.col);
        }
        string rt = TypeFullName(m.type);
        if (rt != "void" && !ExternTyNg(rt)) {
            diags.Error("ngen: unsupported extern return ABI '" + rt + "' in '" + m.sval
                + "' (supported: void, string, byte[]/arrays-as-pointers, int/long/nint, narrow ints, float/double)", m.line, m.col);
        }
        int pc = ParamCount(m);
        if (pc > 24) { diags.Error("ngen: extern ABI supports at most 24 arguments in '" + m.sval + "'", m.line, m.col); }
        int i = 0;
        while (i < pc) {
            Node p = ParamAt(m, i);
            if (p == null) { return; }
            string pt = TypeFullName(p.type);
            // ref/out (p.ival) and params (p.op) pass through the existing
            // PushCallArgs machinery: GenRefArg hands the storage address,
            // the variadic tail is bundled into a packed array whose value
            // is the data pointer
            if (!ExternTyNg(pt)) {
                diags.Error("ngen: unsupported extern parameter ABI '" + pt + "' in '" + m.sval
                    + "' (supported: by-value scalars incl. nint/float/double, arrays as data pointers, ref/out, params)", m.line, m.col);
            }
            i = i + 1;
        }
    }

    // Mirror of PushCallArgs' push order: one entry per stack slot left by
    // the push phase, tagged with the extern parameter type that value was
    // converted to (that type -- not the argument expression's type -- picks
    // the AAPCS64 register class). The variadic tail contributes a single
    // bundle-array slot, matching the net stack shape.
    List<string> ExternArgClassTys(Node m, Node e) {
        List<string> res = new List<string>();
        if (e == null || e.a == null) { return res; }
        int pc = ParamCount(m);
        Node lastP = pc > 0 ? ParamAt(m, pc - 1) : null;
        bool variadic = lastP != null && lastP.op == 1;
        int fixedc = variadic ? pc - 1 : pc;
        int prov = e.kids.Count;
        List<Node> ak = e.kids;
        bool hasNamed = false;
        int k = 0;
        while (k < prov) {
            if (e.kids[k].argName != null && e.kids[k].argName != "") { hasNamed = true; }
            k = k + 1;
        }
        if (hasNamed) {
            int slots = pc > prov ? pc : prov;
            int[] slot = new int[slots];
            bool[] usedName = new bool[prov];
            k = 0;
            while (k < slots) { slot[k] = -1; k = k + 1; }
            k = 0;
            while (k < prov) {
                string an = e.kids[k].argName;
                if (an == null || an == "") { k = k + 1; continue; }
                int found = -1;
                int j = 0;
                while (j < pc) {
                    Node pp = ParamAt(m, j);
                    if (pp != null && pp.sval == an) { found = j; break; }
                    j = j + 1;
                }
                if (found >= 0 && slot[found] < 0) {
                    slot[found] = k;
                    usedName[k] = true;
                }
                k = k + 1;
            }
            int j2 = 0;
            k = 0;
            while (k < prov) {
                if (usedName[k]) { k = k + 1; continue; }
                while (j2 < pc && slot[j2] >= 0) { j2 = j2 + 1; }
                if (j2 >= pc) { break; }
                slot[j2] = k;
                j2 = j2 + 1;
                k = k + 1;
            }
            bool dense = true;
            k = 0;
            while (k < prov) {
                if (slot[k] < 0 || slot[k] >= prov) { dense = false; break; }
                k = k + 1;
            }
            if (dense) {
                ak = new List<Node>();
                k = 0;
                while (k < prov) {
                    ak.Add(e.kids[slot[k]]);
                    k = k + 1;
                }
            }
        }
        if (variadic && prov == pc && IsArrValExpr(ak[prov - 1])) {
            int i = 0;
            while (i < prov) {
                Node pp = ParamAt(m, i);
                res.Add(pp != null && pp.type != null ? TypeFullName(pp.type) : "");
                i = i + 1;
            }
            return res;
        }
        int n = 0;
        while (n < prov && n < fixedc) {
            Node pp = ParamAt(m, n);
            res.Add(pp != null && pp.type != null ? TypeFullName(pp.type) : "");
            n = n + 1;
        }
        while (n < fixedc) {
            Node pp = ParamAt(m, n);
            res.Add(pp != null && pp.type != null ? TypeFullName(pp.type) : "");
            n = n + 1;
        }
        // [DllImport(Variadic = true)]: only the fixed prefix rides the push
        // phase (the ... tail goes to the stack varargs area that
        // CallStaticNg fills), so the class list ends at the fixed params
        if (variadic) {
            res.Add(TypeFullName(lastP.type));           // the bundle array
        }
        return res;
    }

    // the NativeMemory.Sha256 intrinsic: zan_sha256(data, len, out32) into
    // an sp scratch block, then the oracle's string shape — str_alloc(33),
    // memcpy of the 32 raw digest bytes, header stamped len=32 — so the
    // caller owns an ARC string exactly like any other produced string
    void EmitSha256CallNg(Node e) {
        // batch 34: the gate is gone -- _zan_sha256 is zan-emitted on both
        // lanes, and the csel/mov/orr raws became primitives
        GenExpr(e.kids[0]);                          // x0 = data ptr (nint)
        AddSPImm(48, false);                         // sub sp, sp, #48
        StrU(0, 31, 0);                              // sp[0] = data
        GenExpr(e.kids[1]);                          // x0 = len
        StringCmp(0, 31);                            // cmp x0, #0
        int clamp = NL();
        int done = NL();
        EmitBcond(11, clamp);                        // b.lt -> clamp
        MovRR(2, 0);
        EmitB(done);
        Mark(clamp);
        LoadImm(2, 0);
        Mark(done);
        LdrU(0, 31, 0);                              // x0 = data
        MovRR(1, 2);                                 // x1 = clamped len
        AddImm(2, 31, 16);                           // x2 = sp+16 (out32)
        BLExtern("_zan_sha256");                     // FIPS 180-4 digest
        LoadImm(0, 33);                              // 32 bytes + NUL
        BLInternal("_zan_rt_str_alloc");             // x0 = buf
        AddImm(1, 31, 16);                           // x1 = sp+16
        LoadImm(2, 32);
        BLExtern("_memcpy");                         // returns buf
        LoadImm(1, 0x5A414E5300000000);
        LoadImm(2, 32);
        OrrRR(1, 1, 2);                              // orr x1, x1, x2
        SubImm(0, 0, 8);
        StrU(1, 0, 0);                               // stamp [buf-8] len=32
        AddSPImm(48, true);                          // add sp, sp, #48
        AddImm(0, 0, 8);                             // x0 = buf
    }

    void CallStaticNg(int mi, Node e) {
        Node m = methNodes[mi];
        bool ext = HasMod(m, MOD.Extern());
        // the [DllImport] Sha256 decl only types the call: like the oracle
        // (irgen_expr.c emit_native_memory_call) the compiler lowers it as
        // an intrinsic producing an owned 32-raw-byte string
        if (m.sval == "Sha256" && methCls[mi] == "NativeMemory"
                && e.kids.Count == 2) {
            EmitSha256CallNg(e);
            return;
        }
        List<string> ats = ext ? ExternArgClassTys(m, e) : null;
        // a delegate-typed parameter of a generic-class static method arrives
        // open; the receiver's static type (an instance or extension
        // receiver) supplies the substitution source
        pendingCtorInstNg = e.a != null ? StaticTyOf(e.a) : null;
        int pushed = PushCallArgs(m, e);
        pendingCtorInstNg = null;
        // AAPCS64 allocation (extern only): the first eight integer-class
        // slots land in x0..x7 by their position among integer args; the
        // first eight float/double slots in d/s0..7 by their position among
        // fp args (moved over through scratch x10; floats narrow through
        // d31 so fcvt reads a dead temp). Quota-exhausted slots go to the
        // callee's packed stack-arg area: the reservation is made below the
        // pushes first (8-byte stride, argument order, padded so sp stays
        // 16-aligned), then every slot is read back by OFFSET from sp --
        // pops would walk into the reservation -- into its register or dest
        // slot. The caller reclaims reservation + push slots with one add
        // after the call.
        int[] ireg = null;
        int[] freg = null;
        int[] sidx = null;
        int[] tireg = null;
        int[] tfreg = null;
        int[] tsidx = null;
        int sres = 0;
        int vres = 0;
        int ntail = 0;
        int csTot = 0;
        bool dllVar = false;
        bool elfVar = false;
        if (ext) {
            ireg = new int[pushed];
            freg = new int[pushed];
            sidx = new int[pushed];
            int ci = 0;
            int cf = 0;
            int cs = 0;
            int pi = 0;
            while (pi < pushed) {
                string at = ats != null && pi < ats.Count ? ats[pi] : "";
                if (ExternFpTy(at)) {
                    if (cf < 8) { ireg[pi] = -1; freg[pi] = cf; cf = cf + 1; }
                    else { ireg[pi] = -2; sidx[pi] = cs; cs = cs + 1; }
                } else {
                    if (ci < 8) { ireg[pi] = ci; ci = ci + 1; }
                    else { ireg[pi] = -2; sidx[pi] = cs; cs = cs + 1; }
                }
                pi = pi + 1;
            }
            // [DllImport(Variadic = true)]: the two arms64 ABIs disagree on
            // where the ... tail goes. Apple arm64 passes every variadic
            // argument on the stack, right above any fixed stack-class args;
            // aarch64-linux instead allocates each tail by its natural class,
            // continuing the ordinary integer/fp register sequences and the
            // packed overflow area (clang oracle: fmt->x0, int varargs
            // w1,w2, double d0). Either way the tail values stage into
            // ntail(+pad) slots above the fixed dest slots: Apple leaves
            // them there as the ABI varargs area, ELF reads them back into
            // their destinations after the fixed readback.
            dllVar = m != null && HasMod(m, MOD.Variadic());
            ntail = dllVar ? (e != null ? e.kids.Count : 0) - pushed : 0;
            if (ntail < 0) { ntail = 0; }
            elfVar = dllVar && ntail > 0 && EnvTargetElf() == 1;
            if (ntail > 0) {
                tireg = new int[ntail];
                tfreg = new int[ntail];
                tsidx = new int[ntail];
            }
            int vk0 = 0;
            while (vk0 < ntail) {
                Node ae = e.kids[pushed + vk0];
                string tt = ae.kind == AK.OutArg() ? "" : StaticTyOf(ae);
                if (!elfVar) {
                    tireg[vk0] = -3;                     // Apple: tail is a stack arg
                } else if (IsDblExpr(ae) || tt == "float") {
                    // fp class: doubles as-is, floats as the doubles the C
                    // default promotions guarantee
                    if (cf < 8) { tireg[vk0] = -1; tfreg[vk0] = cf; cf = cf + 1; }
                    else { tireg[vk0] = -2; tsidx[vk0] = cs; cs = cs + 1; }
                } else if (ci < 8) {
                    tireg[vk0] = ci; ci = ci + 1;
                } else {
                    tireg[vk0] = -2; tsidx[vk0] = cs; cs = cs + 1;
                }
                vk0 = vk0 + 1;
            }
            sres = cs + (cs % 2);
            csTot = cs;
            vres = dllVar ? ntail + (ntail % 2) : 0;
            if (tgt86 != 1 && sres + vres > 0) {
                AddSPImm(8 * (sres + vres), false);      // sub sp, reserved (arm64 Apple va_list area; x86 tails push)
            }
        }
        if (ext && dllVar && ntail > 0) {
            // the ... tail: evaluate in order into the slots right above the
            // fixed dest slots. On Apple those slots ARE the ABI varargs
            // area (starting at sp above any fixed stack-class args); on
            // ELF they are staging for the post-readback move below. Each
            // value carries the C default promotions (float widens to
            // double, ints/pointers pass as i64). This must run BEFORE the
            // register readback -- GenExpr targets x0 and would clobber the
            // values being read back; the readback loads by absolute
            // offset, so the push slots are undisturbed.
            int vk = 0;
            while (vk < ntail) {
                Node ae = e.kids[pushed + vk];
                if (ae.kind == AK.OutArg()) {
                    GenRefArg(ae);
                } else {
                    GenExpr(ae);
                    GenCloneIfStruct(ae);
                    if (!IsDblExpr(ae) && !IsStrExpr(ae) && StaticTyOf(ae) == "float") {
                        if (tgt86 == 1) {
                            // batch 37: the shapes this branch catches hold
                            // SINGLE bits in rdi (the model keeps double
                            // bits everywhere else, so plain float idents
                            // skip it) -- re-read the low dword as single
                            // and widen to the promoted double the ABI wants
                            X3(0x66, 0x48, 0x0F); X2(0x6E, 0xC7);   // movq xmm0, rdi
                            X3(0xF3, 0x0F, 0x5A); X1(0xC0);         // cvtss2sd xmm0, xmm0
                            X3(0x66, 0x48, 0x0F); X2(0x7E, 0xC7);   // movq rdi, xmm0
                        } else {
                            E4(0x1E624000);                  // fcvt d0, s0
                            E4(0x9E660000);                  // fmov x0, d0
                        }
                    }
                }
                // Apple va_list starts just above the named stack args --
                // cs slots, NOT the 16-alignment-padded sres: an odd fixed
                // overflow count would otherwise shift every tail by 8.
                // ELF keeps staging at 8*sres, clear of its overflow dest
                // slots; the post-readback below does the ABI move.
                if (tgt86 == 1) { XPushV0(); } else {   // batch 33: x86 tails ride the push stream
                StrU(0, 31, 8 * (elfVar ? sres : csTot) + 8 * vk);   // [sp + off] = vararg k
                }
                vk = vk + 1;
            }
        }
        int r = pushed - 1;
        int xTot = pushed;
        int[] xCls = null;        // batch 37: 0 = integer class, 1 = fp class
        int[] xClsIdx = null;     // reg-class cursor (GPR / xmm), -1 = stack
        int[] xSPos = null;       // packed stack position in argument order
        if (tgt86 == 1 && ext) {
            // batch 37: the SysV SSE dual-cursor arm (replaces the batch 33
            // integer carve-out and its fail-closed). Integer-class args
            // fill rdi..r9 by their position among integer args (quota 6);
            // float/double args land in xmm0..7 by their position among fp
            // args (quota 8). The push slots hold double bits (the model
            // keeps every register float widened), so the readback movq's
            // the quad into the xmm and narrows only declared float params
            // (cvtsd2ss) -- a variadic tail keeps its promoted double, the
            // C default promotions already widened it. Quota-exhausted
            // slots of both classes share one packed stack area in
            // argument order (8-byte stride; XCallSeq stages it from the
            // v(6+k) homes). Variadic tails ride the push stream (no
            // Apple va_list area on x86), so the readback covers
            // pushed+ntail slots. out/ref params carry an address:
            // integer class whatever their declared type.
            xTot = pushed + ntail;
            xCls = new int[xTot];
            xClsIdx = new int[xTot];
            xSPos = new int[xTot];
            int xci = 0;
            int xcf = 0;
            int xcs = 0;
            int ta = 0;
            while (ta < xTot) {
                bool xfp;
                if (ta < pushed) {
                    Node xpa = ParamAt(m, ta);
                    xfp = (xpa == null || xpa.ival == 0) && ta < ats.Count
                        && ExternFpTy(ats[ta]);
                } else {
                    Node xae = e.kids[ta];
                    xfp = xae.kind != AK.OutArg()
                        && (IsDblExpr(xae) || StaticTyOf(xae) == "float");
                }
                if (xfp) {
                    if (xcf < 8) { xCls[ta] = 1; xClsIdx[ta] = xcf; xcf = xcf + 1; }
                    else { xCls[ta] = 1; xClsIdx[ta] = -1; xSPos[ta] = xcs; xcs = xcs + 1; }
                } else {
                    if (xci < 6) { xCls[ta] = 0; xClsIdx[ta] = xci; xci = xci + 1; }
                    else { xCls[ta] = 0; xClsIdx[ta] = -1; xSPos[ta] = xcs; xcs = xcs + 1; }
                }
                ta = ta + 1;
            }
            xStackArgs = xcs;
            xVecArgs = xcf;
            r = xTot - 1;
        }
        int armOvfArea = 0;
        if (tgt86 != 1 && !ext && pushed > 16) {
            int novf = pushed - 16;
            armOvfArea = 16 * ((novf + 1) / 2);
            AddSPImm(armOvfArea, false);
            int k = 0;
            while (k < pushed) {
                int off = armOvfArea + 16 * (pushed - 1 - k);
                if (k < 16) {
                    LdrU(k, 31, off);
                } else {
                    LdrU(10, 31, off);
                    StrU(10, 31, 8 * (k - 16));
                }
                k = k + 1;
            }
        }
        while (r >= 0) {
            if (tgt86 == 1 && ext) {
                // SysV readback, batch 37 class-aware: argument r sits at
                // [rsp + 16*(xTot-1-r)] (pushed in order, 16-byte steps).
                // Reg-class integer args go straight into their GPR; fp
                // args movq the quad (double bits) into xmm_vi and narrow
                // declared floats; stack-class args home into v(6+k) for
                // the call shim to stage (batch 33: any arity).
                int xoff = 16 * (xTot - 1 - r);
                if (xCls[r] == 0 && xClsIdx[r] >= 0) {
                    XopRMem(0x8B, XMapReal(xClsIdx[r]), 4, xoff);
                } else {
                    XopRMem(0x8B, 10, 4, xoff);            // mov r10, [rsp+off]
                    if (xClsIdx[r] >= 0) {
                        // movq xmm_vi, r10:REX 必须带 W(0x49 = W1 R0 X0
                        // B1)——W 缺了就解码成 movd(32 位装载,xmm 高半
                        // 清零),1.5 = 0x3FF8000000000000 低 dword 恒 0,
                        // printf %.1f 打 0.0(批46 首查我把它"修"成 0x43
                        // 反而引入此坑,llvm lldb 停 printf 现场 xmm0=0 定案)。
                        X1(0x66); X1(0x49); X2(0x0F, 0x6E);
                        X1(0xC0 | (xClsIdx[r] << 3) | 2);  // movq xmm_vi, r10
                        if (r < pushed && ats[r] == "float") {
                            X3(0xF2, 0x0F, 0x5A);
                            X1(0xC0 | (xClsIdx[r] << 3) | xClsIdx[r]);   // cvtsd2ss
                        }
                    } else {
                        // 批39:栈类 float 槽按 SysV eightbyte 打包 = 低
                        // 4 字节 float。批37 首版把加宽 double 位型整 8
                        // 字节落槽——double 8.5 = 0x4021_0000_0000_0000,
                        // 低 4 字节恒 0.0f(SumFI10 探针 = 42 现形)。
                        // movd 窄化回 r10(高位零填),XCallSeq movq 落槽
                        // 后低 4 字节即 C 调用约定要的 float 位型;变参尾
                        // 保持提升 double,不窄。
                        if (r < pushed && ats[r] == "float") {
                            // 首版 66 45 0F 6E 缺 REX.W 解码成 movd(32 位
                            // 装载,double 位型只剩低 dword=0)——REX 0x4D
                            // 才是 movq;movd 回写 7E 不带 W 是故意的。
                            X3(0x66, 0x4D, 0x0F); X1(0x6E); X1(0xFA);  // movq xmm15, r10
                            X3(0xF2, 0x45, 0x0F); X1(0x5A); X1(0xFF);  // cvtsd2ss xmm15, xmm15
                            X3(0x66, 0x45, 0x0F); X1(0x7E); X1(0xFA);  // movd r10d, xmm15(高位零填)
                        }
                        XSetV(XArgVOf(6 + xSPos[r]), 10);       // stack class: v(6+k) home
                    }
                }
            } else if (tgt86 == 1) {
                // SysV readback (internal calls): argument r sits at
                // [rsp + 16*(xTot-1-r)] (pushed in order, 16-byte steps).
                // Args 0..5 into their SysV registers, 6+ into the spill
                // homes the call shim stages (batch 33: any arity).
                if (r < 6) {
                    XopRMem(0x8B, XMapReal(r), 4, 16 * (xTot - 1 - r));
                } else {
                    XopRMem(0x8B, 10, 4, 16 * (xTot - 1 - r));
                    XSetV(XArgVOf(r), 10);
                }
            } else if (!ext) {
                if (armOvfArea == 0) {
                    XPopV(r);                      // pop xr, keep sp 16-aligned
                }
            } else if (sres + vres > 0) {
                int off = 8 * (sres + vres) + 16 * (pushed - 1 - r);   // slot r: arg r was pushed r-th from the bottom
                if (ireg[r] == -2) {
                    LdrU(10, 31, off);                   // ldr x10, [sp, #src]
                    if (ats[r] == "float") {
                        E4(0x9E670150);                  // fmov d16, x10
                        E4(0x1E624211);                  // fcvt s17, d16
                        // 批39:Rn 域(bits9-5)不可省——首版漏 (31<<5),
                        // 解码成 str s17,[x0](x0 恰是首个整参值,SumFI10
                        // 探针 SEGV addr=0xa 定案)。
                        E4(0xBD000000 | (31 << 5) | ((8 * sidx[r] / 4) << 10) | 17);   // str s17, [sp, #dst]
                    } else {
                        StrU(10, 31, 8 * sidx[r]);       // str x10, [sp, #dst]
                    }
                } else if (ireg[r] == -1) {
                    LdrU(10, 31, off);                   // ldr x10, [sp, #src]
                    if (ats[r] == "double") {
                        E4(0x9E670000 | (10 << 5) | freg[r]);    // fmov dN, x10
                    } else {
                        E4(0x9E670000 | (10 << 5) | 31);         // fmov d31, x10
                        E4(0x1E624000 | (31 << 5) | freg[r]);    // fcvt sN, d31
                    }
                } else {
                    LdrU(ireg[r], 31, off);              // ldr xN, [sp, #src]
                }
            } else if (ireg[r] == -1) {
                E4(0xF84107E0 | 10);                     // pop scratch x10
                if (ats[r] == "double") {
                    E4(0x9E670000 | (10 << 5) | freg[r]);    // fmov dN, x10
                } else {
                    E4(0x9E670000 | (10 << 5) | 31);         // fmov d31, x10
                    E4(0x1E624000 | (31 << 5) | freg[r]);    // fcvt sN, d31
                }
            } else {
                E4(0xF84107E0 | ireg[r]);                // pop xr, keep sp 16-aligned
            }
            r = r - 1;
        }
        if (ext && elfVar) {
            // ELF variadic readback: each tail moves staging -> destination.
            // Register-class tails fill x/d slots continuing the fixed
            // sequences; overflow tails copy into their packed stack slot.
            // Doubles keep all 8 bits; no single-precision narrowing -- the
            // C default promotions already widened every float tail.
            int vk2 = ntail - 1;
            while (vk2 >= 0) {
                if (tireg[vk2] == -2) {
                    LdrU(10, 31, 8 * sres + 8 * vk2);
                    StrU(10, 31, 8 * tsidx[vk2]);    // staging -> overflow slot
                } else if (tireg[vk2] == -1) {
                    LdrU(10, 31, 8 * sres + 8 * vk2);
                    E4(0x9E670000 | (10 << 5) | tfreg[vk2]);   // fmov dN, x10
                } else if (tireg[vk2] >= 0) {
                    LdrU(tireg[vk2], 31, 8 * sres + 8 * vk2);
                }
                vk2 = vk2 - 1;
            }
        }
        if (tgt86 == 1 && !ext) {
            XAddRsp(16 * pushed);              // reclaim the push slots
            xStackArgs = pushed > 6 ? pushed - 6 : 0;
        }
        if (!ext) {
            BLInternal(MethSymNg(methCls[mi], m));
            if (armOvfArea > 0) {
                AddSPImm(armOvfArea + 16 * pushed, true);
            }
            return;
        }
        // Native strings/arrays already point at their bytes; nint/long carry
        // the full pointer/integer width. C int arguments use the low wN.
        BLExtern(ExternSymNg(m));
        if (tgt86 == 1) {
            XAddRsp(16 * xTot);                // batch 33: reclaim the push stream
        } else if (sres + vres > 0) {
            AddSPImm(8 * (sres + vres) + 16 * pushed, true);   // caller cleans dest + pushes
        }
        string rt = TypeFullName(m.type);
        // the stdlib decl says int, but the oracle lowers this call as an
        // intrinsic returning the full i64 CRC -- no sext may narrow it
        // (conformance native_memory compares it against 3421780262)
        if (m.sval == "Crc32" && methCls[mi] == "NativeMemory") { rt = "long"; }
        if (rt == "int") {
            Sxtw0();                              // sxtw x0, w0 (e.g. EOF == -1)
        } else if (rt == "short") {
            if (tgt86 == 1) { X3(0x48, 0x0F, 0xBF); X1(0xF8); } else { E4(0x93403C00); }   // sxth x0, w0 / movsx rdi, di
        } else if (rt == "ushort" || rt == "char") {
            if (tgt86 == 1) { X3(0x48, 0x0F, 0xB7); X1(0xF8); } else { E4(0x53003C00); }   // uxth w0, w0 / movzx rdi, di
        } else if (rt == "uint" || rt == "bool" || rt == "byte") {
            if (tgt86 == 1) { X2(0x89, 0xFF); } else { E4(0x2A0003E0); }   // mov w0, w0 / mov edi, edi
        } else if (rt == "sbyte") {
            if (tgt86 == 1) { X3(0x48, 0x0F, 0xBE); X1(0xF8); } else { E4(0x93401C00); }   // sxtb x0, w0 / movsx rdi, dil
        } else if (rt == "float") {
            if (tgt86 == 1) {
                // batch 37: C returned a single in xmm0's low dword -- the
                // model wants the widened double bits in rdi. (The old
                // line here emitted the arm64 fcvt word into the x86
                // stream: dead while the batch 33 fail-closed stood, and
                // wrong the moment it fell.)
                X3(0xF3, 0x0F, 0x5A); X1(0xC0);            // cvtss2sd xmm0, xmm0
                X3(0x66, 0x48, 0x0F); X2(0x7E, 0xC7);      // movq rdi, xmm0
            } else {
                E4(0x1E22C000);                            // fcvt d0, s0
                E4(0x9E660000);                            // fmov x0, d0
            }
        } else if (rt == "double") {
            if (tgt86 == 1) { X3(0x66, 0x48, 0x0F); X2(0x7E, 0xC7); } else { E4(0x9E660000); }                              // fmov x0, d0
        }
        if (ExternSymNg(m) == "_free" && e != null && e.kids.Count == 1) {
            GenInvalidateFreedStringNg(e.kids[0]);
        }
    }

    // a call to libc free() consumes its string argument: the reference nulls
    // the source reference afterwards (irgen_builtins.c
    // emit_invalidate_freed_string), so a following `== null` check agrees
    void GenInvalidateFreedStringNg(Node arg) {
        if (arg == null) { return; }
        if (arg.kind == AK.Ident()) {
            int li = LocalIdx(arg.sval);
            if (li >= 0) {
                if (locTy[li] != "string") { return; }
                LoadImm(0, 0);
                if (locRef[li]) {
                    LoadLocal(li, 1);
                    StrU(0, 1, 0);                       // store through the ref
                } else {
                    StoreLocalVal(li, 0);
                }
                return;
            }
            Fld fld = CurField(arg.sval);
            if (fld != null) {
                if (fld.ty != "string" || LocalIdx("this") < 0) { return; }
                LoadLocal(LocalIdx("this"), 0);          // receiver -> x0
                LoadImm(1, 0);                           // null -> x1
                StoreFieldNg(1, 0, fld);
                return;
            }
            string ssym = FindStaticSym(curCls, arg.sval);
            if (ssym != null) {
                if (FindStaticTy(curCls, arg.sval) != "string") { return; }
                LoadSymRef(ssym, 9);
                LoadImm(0, 0);
                StrU(0, 9, 0);
            }
            return;
        }
        if (arg.kind == AK.MemberAccess() && arg.a != null) {
            Fld fld = FieldOf(arg);
            if (fld == null || fld.ty != "string") { return; }
            GenExpr(arg.a);                              // receiver -> x0
            LoadImm(1, 0);                               // null -> x1
            StoreFieldNg(1, 0, fld);                     // str x1, [x0]
        }
    }
}
