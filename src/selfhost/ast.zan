using System;
using System.Collections.Generic;
namespace Zan;

// AST node kinds. Mirrors src/compiler/ast.h. Plain int constants.
public class AK {
    static int CompUnit() { return 1; }
    static int UsingDecl() { return 2; }
    static int NamespaceDecl() { return 3; }
    static int ClassDecl() { return 4; }
    static int StructDecl() { return 5; }
    static int EnumDecl() { return 6; }
    static int FieldDecl() { return 7; }
    static int MethodDecl() { return 8; }
    static int CtorDecl() { return 9; }
    static int Param() { return 10; }
    static int Block() { return 11; }
    static int VarDecl() { return 12; }
    static int ExprStmt() { return 13; }
    static int ReturnStmt() { return 14; }
    static int IfStmt() { return 15; }
    static int WhileStmt() { return 16; }
    static int ForStmt() { return 17; }
    static int ForeachStmt() { return 18; }
    static int BreakStmt() { return 19; }
    static int ContinueStmt() { return 20; }
    static int SwitchStmt() { return 21; }
    static int SwitchCase() { return 22; }
    static int TryStmt() { return 23; }
    static int ThrowStmt() { return 24; }
    static int CatchClause() { return 25; }
    static int TypeParam() { return 26; }
    static int DelegateDecl() { return 27; }
    static int IntLit() { return 30; }
    static int FloatLit() { return 31; }
    static int StringLit() { return 32; }
    static int CharLit() { return 33; }
    static int BoolLit() { return 34; }
    static int NullLit() { return 35; }
    static int Ident() { return 36; }
    static int Binary() { return 37; }
    static int Unary() { return 38; }
    static int Call() { return 39; }
    static int MemberAccess() { return 40; }
    static int Index() { return 41; }
    static int Assignment() { return 42; }
    static int NewExpr() { return 43; }
    static int CastExpr() { return 44; }
    static int ThisExpr() { return 45; }
    static int Conditional() { return 46; }
    static int PostfixUnary() { return 47; }
    static int Lambda() { return 48; }
    static int SwitchExpr() { return 49; }
    static int TypeRef() { return 50; }
    static int EnumMember() { return 51; }
    static int TupleExpr() { return 52; }
    static int DeconDecl() { return 53; }
    static int IsExpr() { return 54; }
    static int AwaitExpr() { return 55; }
    static int YieldStmt() { return 56; }
    static int QueryExpr() { return 57; }
    static int LabelStmt() { return 58; }
    static int GotoStmt() { return 59; }
    static int OutArg() { return 60; }
    static int AsExpr() { return 61; }
    static int WithExpr() { return 62; }
    static int DoWhileStmt() { return 63; }
    static int LockStmt() { return 64; }
    static int MonitorExitStmt() { return 65; }
    // 工厂调用延续初始化器 `Panel.Row() { X = v, Items = { a } }`：a 是
    // 刚解析完的调用，kids 是成员写（oracle parse_postfix 的 call_init）
    static int CallInit() { return 66; }
    static int BaseExpr() { return 67; }
}

// Modifier bit flags (subset of ast.h MOD_*).
public class MOD {
    static int Public() { return 1; }
    static int Private() { return 2; }
    static int Protected() { return 4; }
    static int Static() { return 16; }
    static int Virtual() { return 32; }
    static int Override() { return 64; }
    static int Abstract() { return 128; }
    static int Extern() { return 256; }
    static int Readonly() { return 512; }
    static int Weak() { return 1024; }
    static int Async() { return 2048; }
    static int Partial() { return 4096; }
    static int Event() { return 8192; }
    static int Unsafe() { return 16384; }
    static int Variadic() { return 65536; }   // [DllImport(Variadic = true)] extern
    static int Iface() { return 262144; }     // parser marker: declared via `interface` (reflection kind)
    static int ThreadEntry() { return 524288; } // [ThreadEntry]: pthread-safe entry (x19-x28 saves)
    static int AtomicCas() { return 1048576; }   // [AtomicCas]: body -> casal (witnessed compare-exchange)
    static int StaticAddr() { return 2097152; }  // [StaticAddr("fld")]: body -> adrp+add of the data global
    static int AtomicLoad() { return 4194304; }  // [AtomicLoad]: body -> ldar (seq_cst load)
    static int AtomicStore() { return 8388608; } // [AtomicStore]: body -> stlr (seq_cst store)
}

// String-literal escape decoding. One implementation of the C host's
// lexer_escape_seq (src/compiler/lexer.c): \n \r \t \\ \" \' \0, plus
// \xNN (1..4 hex digits) and \uNNNN (exactly 4) as code points encoded as
// UTF-8. The lexer keeps the raw token text; every consumer decodes it
// through here so the runtime strings, the attribute literals and the
// compile-time metadata all agree.
public class StrEsc {
    // the decoded literal as UTF-8 bytes
    public static List<int> DecodeBytes(string raw) {
        List<int> r = new List<int>();
        int i = 0;
        while (i < raw.Length) {
            int c = (int)raw[i];
            if (c == 92 && i + 1 < raw.Length) {
                int nx = (int)raw[i + 1];
                if (nx == 110) { r.Add(10); i = i + 2; continue; }
                if (nx == 116) { r.Add(9); i = i + 2; continue; }
                if (nx == 114) { r.Add(13); i = i + 2; continue; }
                if (nx == 92) { r.Add(92); i = i + 2; continue; }
                if (nx == 34) { r.Add(34); i = i + 2; continue; }
                if (nx == 39) { r.Add(39); i = i + 2; continue; }
                if (nx == 48) { r.Add(0); i = i + 2; continue; }
                if (nx == 120 || nx == 117) {
                    // \x takes 1..4 hex digits, \u exactly 4
                    int val = 0;
                    int got = 0;
                    int j = i + 2;
                    while (j < raw.Length && got < 4) {
                        int h = HexVal((int)raw[j]);
                        if (h < 0) { break; }
                        val = val * 16 + h;
                        got = got + 1;
                        j = j + 1;
                    }
                    bool ok = got > 0;
                    if (nx == 117 && got != 4) { ok = false; }
                    // a surrogate code point is not a scalar value
                    if (ok && val >= 55296 && val <= 57343) { ok = false; }
                    if (ok) {
                        AddUtf8(r, val);
                        i = j;
                        continue;
                    }
                    // the host rejects these; keep the letter and carry on
                    if (nx == 117 && got == 4) { r.Add(nx); i = j; continue; }
                    r.Add(nx);
                    i = i + 2;
                    continue;
                }
                r.Add(nx);
                i = i + 2;
                continue;
            }
            r.Add(c);
            i = i + 1;
        }
        return r;
    }

    // the decoded literal as text
    public static string DecodeText(string raw) {
        List<int> b = DecodeBytes(raw);
        string s = "";
        int i = 0;
        while (i < b.Count) { s = s + ((char)b[i]); i = i + 1; }
        return s;
    }

    // encode a code point as UTF-8 (the host's zan_utf8_encode)
    static void AddUtf8(List<int> r, int cp) {
        if (cp < 128) { r.Add(cp); return; }
        if (cp < 2048) {
            r.Add(192 + (cp >> 6));
            r.Add(128 + (cp & 63));
            return;
        }
        if (cp < 65536) {
            r.Add(224 + (cp >> 12));
            r.Add(128 + ((cp >> 6) & 63));
            r.Add(128 + (cp & 63));
            return;
        }
        r.Add(240 + (cp >> 18));
        r.Add(128 + ((cp >> 12) & 63));
        r.Add(128 + ((cp >> 6) & 63));
        r.Add(128 + (cp & 63));
    }

    static int HexVal(int c) {
        if (c >= 48 && c <= 57) { return c - 48; }
        if (c >= 97 && c <= 102) { return c - 97 + 10; }
        if (c >= 65 && c <= 70) { return c - 65 + 10; }
        return -1;
    }
}

// Tagged AST node. A single class with generic child slots (a..d), a child
// list (kids), a type slot, and scalar payloads. This uniform representation
// keeps the host requirements to what gen0 already supports (no inheritance
// or virtual dispatch).
public class Node {
    public int kind;
    public int op;        // operator token kind for Binary/Unary/Assignment
    public long ival;     // int/char/bool literal value
    public int suffix;    // int-literal suffix (0=none 1=L 2=U 3=UL); radix
                          // folds into the same field (8 = binary, 16 = hex,
                          // 24 = octal) -- the type suffix is `suffix % 8`
    public string sval;   // name / string literal / member name
    public string sval2;  // secondary name (e.g. base class)
    public string argName; // named-argument label (e.g. foo(argName: value))
    // The RANK LIST of an array shape: one entry per bracket group, outer to
    // inner -- "2" for `int[,]`, "1,2" for `int[][,]`.  It rides on the TYPE
    // node and on the NEW expression that creates the array.  It cannot live
    // in `sval2`: on an expression node `sval2` marks a NAMED argument (so
    // `Hash(new byte[0], 0)` would read its first argument as a named one),
    // and on a type node the native backend reads it as the comma count of
    // the rank specifier.
    public string arrRanks;
    public Node a;
    public Node b;
    public Node c;
    public Node d;
    public Node type;     // associated type-ref (var/field/param/method/cast/new)
    public List<Node> kids;
    public int mods;
    public int line;
    public int col;
    // position of a class/struct's base-type name (0 = no base type): a
    // diagnostic about the base points at the base name, the way the C
    // host's binder points at the base ref's loc
    public int baseLine;
    public int baseCol;
    public bool layoutExplicit;
    public int fieldOffset;
    public string nsName;        // declaring file's namespace (nsresolve stamp)
    public List<string> nsUsings; // declaring file's using directives
    public string attrStaticAddr; // [StaticAddr("fld")] on a method: data-global symbol to take the address of
    public List<string> interfaces; // interfaces implemented by class/interface

    public Node(int k) {
        kind = k; op = 0; ival = 0; sval = ""; sval2 = ""; argName = ""; arrRanks = "";
        a = null; b = null; c = null; d = null; type = null;
        kids = new List<Node>(); mods = 0; line = 0; col = 0;
        baseLine = 0; baseCol = 0;
        layoutExplicit = false; fieldOffset = -1;
        nsName = ""; nsUsings = null;
        attrStaticAddr = "";
        interfaces = new List<string>();
    }

    public void Add(Node n) { kids.Add(n); }

    // ---- int-literal helpers ----
    //
    // The parser folds the radix into the same field as the type suffix
    // (8 = binary, 16 = hex), so the type suffix is `suffix % 8` and the
    // radix is `suffix >= 8`. The C host keeps them apart (lit_suffix /
    // lit_radix) and both matter:
    //
    //   * the TYPE of a radix-2/8/16 literal in the uint range is an int
    //     (checker.c: AST_INT_LITERAL -> lit_radix), so `int x = 0xFFFFFFFF;`
    //     is legal -- and the VALUE is the int-domain one (-1), because the
    //     host emits the literal as an int (irgen_expr.c).
    //   * a decimal literal in the same range is a long, so `int x =
    //     4294967295;` is a narrowing error.
    public int LitTypeSuffix() { return suffix % 8; }
    public int LitRadix() {
        if (suffix >= 24) { return 8; }
        if (suffix >= 16) { return 16; }
        if (suffix >= 8) { return 2; }
        return 10;
    }
    // The literal's runtime value: an unsuffixed radix literal in the uint
    // range is an int, so its value is the int-domain (two's-complement) one.
    public long IntLitValue() {
        long v = ival;
        if (LitTypeSuffix() == 0 && LitRadix() != 10 && v > 2147483647L && v <= 4294967295L) {
            v = v - 4294967296L;
        }
        return v;
    }
    // The literal's own type (the host's checker.c, AST_INT_LITERAL ->
    // lit_suffix / lit_radix): the suffix decides it, then the radix -- an
    // unsuffixed radix-2/8/16 literal in the uint range is an int (its value
    // is the int-domain one), a decimal literal out of int32 is a long.
    public string IntLitTypeName() {
        int sfx = LitTypeSuffix();
        if (sfx == 1) { return "long"; }
        if (sfx == 2) {
            if (ival < 0 || ival > 4294967295L) { return "ulong"; }
            return "uint";
        }
        if (sfx == 3) { return "ulong"; }
        if (sfx == 0 && LitRadix() != 10 && ival >= 0 && ival <= 4294967295L) { return "int"; }
        if (sfx == 0 && (ival > 2147483647L || ival < -2147483648L)) { return "long"; }
        return "int";
    }

    // ---- rectangular arrays ----
    //
    // An array type carries its RANK LIST in `arrRanks`: one entry per
    // bracket group, outer to inner -- "2" for `int[,]`, "1,2" for
    // `int[][,]`.
    // The C host models the same shape as a nested type with a per-level
    // array_rank (`int[,]` is ONE type of rank 2; `int[][,]` is an array of
    // `int[,]`), so the list plays the role of that nesting: dropping the
    // first entry yields the element type.
    //
    // An empty list means a single rank-1 group -- the plain `T[]`.
    public static int ArrRankCount(string lst) {
        // an empty list is ONE plain rank-1 group (the shape a synthesized
        // array node carries when nothing said otherwise)
        if (lst == null || lst == "") { return 1; }
        int n = 1;
        int i = 0;
        while (i < lst.Length) {
            if (lst[i] == ',') { n = n + 1; }
            i = i + 1;
        }
        return n;
    }
    // The rank of the i-th bracket group (0 = the outermost).
    public static int ArrRankAt(string lst, int i) {
        if (lst == null || lst == "") { return 1; }
        int idx = 0;
        int start = 0;
        int p = 0;
        while (p <= lst.Length) {
            if (p == lst.Length || lst[p] == ',') {
                if (idx == i) {
                    string e = lst.Substring(start, p - start);
                    if (e == "") { return 1; }
                    return (int)Convert.ToInt64(e);
                }
                idx = idx + 1;
                start = p + 1;
            }
            p = p + 1;
        }
        return 1;
    }
    // The rank list of the ELEMENT type: the outermost group is dropped.
    public static string ArrRankDrop(string lst) {
        if (lst == null || lst == "") { return ""; }
        int p = 0;
        while (p < lst.Length && lst[p] != ',') { p = p + 1; }
        if (p >= lst.Length) { return ""; }
        return lst.Substring(p + 1);
    }
}
