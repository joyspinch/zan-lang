using System;
using System.Collections.Generic;
namespace Zan;

// Checker: semantic pass over the bound AST. Beyond resolving every type
// reference (primitive, builtin generic, type parameter or declared type) it
// walks method/constructor bodies with a typed lexical scope and a light
// expression typer so that it can reject the illegal programs that the
// resolution-only pass used to wave through:
//   * local variables, parameters and other bindings are tracked with types;
//   * identifiers used in value positions must resolve to a local, parameter,
//     field/method of the enclosing type, a known type or an enum member;
//   * a member access / call on a value of a *known* user type must name a
//     real field, method or property of that type (walking base classes);
//   * a call must pass an argument count some overload accepts;
//   * `return` must carry a value in a non-void method and must not in a void
//     one; a static method may not use `this` or an instance field;
//   * break/continue may only appear inside a loop or switch;
//   * a parameter name may not be declared twice in one signature.
//
// The typer is deliberately conservative: when it cannot determine a type it
// yields null and the dependent check is skipped, so standard-library calls
// (Console, File, Math, ...) whose receiver types the bootstrap binder does
// not track are never mis-flagged. Mirrors src/compiler/checker.c for the
// bootstrap subset while being strictly more thorough.
public class Checker {
    public Binder binder;
    public Diags diags;

    Node curClass;              // type declaration whose body is being checked
    Node curRet;                // return type of the current method (null=void)
    bool curStatic;             // is the current method static
    int infCount;
    int loopDepth;              // enclosing loop/switch nesting
    List<string> scopeName;     // value names currently in scope
    List<Node> scopeType;       // parallel declared/inferred types (may be null)

    public Checker(Binder b, Diags d) {
        binder = b; diags = d; curClass = null; curRet = null;
        curStatic = false; loopDepth = 0;
        scopeName = new List<string>(); scopeType = new List<Node>();
    }

    Node MkType(string name) { Node t = new Node(AK.TypeRef()); t.sval = name; return t; }
    bool HasMod(Node m, int flag) { return (m.mods / flag) - ((m.mods / flag) / 2) * 2 == 1; }

    // ---- Task / Task<T>: the C host's builtin task handle (TYPE_TASK) ----
    // A bare `Task` is a handle that carries NO result (the frame is released
    // by the completion path), `Task<T>` a handle that carries one (the
    // reader releases it). The host models both with one builtin type
    // (binder.c: zan_binder_make_task_type); the self-hosted checker has to
    // know the same names, or every Task-typed declaration is rejected with
    // the bogus "unknown type 'Task'".
    Node MkTaskType(Node elem) {
        Node t = MkType("Task");
        if (elem != null) { t.Add(elem); t.a = elem; }
        return t;
    }
    bool IsTaskTy(Node t) { return t != null && t.sval == "Task"; }
    // The element type of a Task-shaped return: `Task<T>` -> T, a bare `Task`
    // -> void (no result).
    Node TaskElemTy(Node t) {
        if (!IsTaskTy(t)) { return t; }
        if (t.kids.Count == 1) { return t.kids[0]; }
        return MkType("void");
    }
    string TaskTyName(Node t) {
        if (!IsTaskTy(t)) { return "?"; }
        if (t.kids.Count == 0) { return "Task"; }
        return "Task<" + t.kids[0].sval + ">";
    }

    // ---- lexical scope ----
    int ScopeMark() { return scopeName.Count; }
    void ScopeTrim(int to) {
        List<string> nn = new List<string>();
        List<Node> nt = new List<Node>();
        int i = 0;
        while (i < to) { nn.Add(scopeName[i]); nt.Add(scopeType[i]); i = i + 1; }
        scopeName = nn; scopeType = nt;
    }
    void ScopeAdd(string name, Node ty) {
        if (name != "") { scopeName.Add(name); scopeType.Add(ty); }
    }
    int ScopeIdx(string name) {
        int i = scopeName.Count - 1;
        while (i >= 0) { if (scopeName[i] == name) { return i; } i = i - 1; }
        return -1;
    }
    bool ScopeHas(string name) { return ScopeIdx(name) >= 0; }

    // ---- type-directed lookup, walking base classes ----
    Node FieldUp(Node cls, string name) {
        Node c = cls;
        int cg = 0;
        while (c != null) {
            Node f = binder.FindField(c, name);
            if (f != null) { return f; }
            c = binder.FindType(c.sval2);
            cg = cg + 1;
            if (cg > 512) { c = null; }
        }
        return null;
    }
    Node MethodUp(Node cls, string name) {
        Node c = cls;
        int cg = 0;
        while (c != null) {
            Node m = binder.FindMethod(c, name);
            if (m != null) { return m; }
            c = binder.FindType(c.sval2);
            cg = cg + 1;
            if (cg > 512) { c = null; }
        }
        return null;
    }
    // A field, method or property accessor named `name`, up the base chain.
    bool HasMember(Node cls, string name) {
        if (FieldUp(cls, name) != null) { return true; }
        if (MethodUp(cls, name) != null) { return true; }
        if (MethodUp(cls, "get_" + name) != null) { return true; }
        if (MethodUp(cls, "set_" + name) != null) { return true; }
        return false;
    }

    // An extension method `name` whose `this` receiver matches type `tyName`.
    bool HasExt(string tyName, string name) {
        List<string> owner = new List<string>();
        return binder.FindExtension(tyName, name, owner) != null;
    }

    // The user class/struct declaration a type refers to, or null.
    Node ClassOf(Node t) {
        if (t == null) { return null; }
        Node d = binder.FindType(t.sval);
        if (d != null && (d.kind == AK.ClassDecl() || d.kind == AK.StructDecl())) { return d; }
        return null;
    }

    bool IsEnumMember(string name) {
        int i = 0;
        while (i < binder.types.Count) {
            Node t = binder.types[i];
            if (t.kind == AK.EnumDecl()) {
                int j = 0;
                while (j < t.kids.Count) {
                    Node m = t.kids[j];
                    if (m.kind == AK.EnumMember() && m.sval == name) { return true; }
                    j = j + 1;
                }
            }
            i = i + 1;
        }
        return false;
    }

    bool KnownValue(string name) {
        if (name == "") { return true; }
        if (name == "value") { return true; }
        if (ScopeHas(name)) { return true; }
        // a bare name may be a field, a method or a property (the parser
        // desugars a property into get_Name / set_Name accessors): the C
        // host resolves all three against the enclosing type
        if (HasMember(curClass, name)) { return true; }
        if (binder.IsPrimitive(name)) { return true; }
        if (binder.IsBuiltinGeneric(name)) { return true; }
        if (binder.IsTypeParam(name)) { return true; }
        if (binder.FindType(name) != null) { return true; }
        if (IsEnumMember(name)) { return true; }
        return false;
    }

    // ---- overload arity ----
    // True if some method named `name` (up the base chain) can accept `argc`
    // positional arguments, or if any candidate is an extension method (whose
    // receiver shifts the count) -- in which case we do not second-guess it.
    bool AcceptsArgc(Node cls, string name, int argc) {
        Node c = cls;
        int cg3 = 0;
        while (c != null) {
            int i = 0;
            while (i < c.kids.Count) {
                Node m = c.kids[i];
                if (m.kind == AK.MethodDecl() && m.sval == name) {
                    if (m.ival == 1) { return true; }
                    int tot = 0; int req = 0;
                    Node lastP = null;
                    int j = 0;
                    while (j < m.kids.Count) {
                        if (m.kids[j].kind == AK.Param()) {
                            tot = tot + 1;
                            if (m.kids[j].b == null) { req = req + 1; }
                            lastP = m.kids[j];
                        }
                        j = j + 1;
                    }
                    if (argc >= req && argc <= tot) { return true; }
                    // `params T[]` tail accepts any argc >= fixed params
                    if (lastP != null && lastP.op == 1 && argc >= req - 1) { return true; }
                }
                i = i + 1;
            }
            c = binder.FindType(c.sval2);
            cg3 = cg3 + 1;
            if (cg3 > 512) { c = null; }
        }
        return false;
    }

    // ---- expression typer (null == unknown) ----
    Node InferType(Node e) {
        infCount = infCount + 1;
        if (e == null) { return null; }
        int k = e.kind;
        if (k == AK.IntLit()) { return MkType("int"); }
        if (k == AK.FloatLit()) { return MkType("double"); }
        if (k == AK.StringLit()) { return MkType("string"); }
        if (k == AK.CharLit()) { return MkType("char"); }
        if (k == AK.BoolLit()) { return MkType("bool"); }
        if (k == AK.NullLit()) { return null; }
        if (k == AK.ThisExpr()) { if (curClass != null) { return MkType(curClass.sval); } return null; }
        if (k == AK.Ident()) {
            int si = ScopeIdx(e.sval);
            if (si >= 0) { return scopeType[si]; }
            Node f = FieldUp(curClass, e.sval);
            if (f != null) { return f.type; }
            // a bare property name reads through its getter accessor
            Node g = MethodUp(curClass, "get_" + e.sval);
            if (g != null) { return g.type; }
            return null;
        }
        if (k == AK.CastExpr()) { return e.type; }
        if (k == AK.AwaitExpr()) { return InferType(e.a); }
        if (k == AK.NewExpr()) { return e.type; }
        if (k == AK.CallInit()) { return InferType(e.a); }
        if (k == AK.IsExpr()) { return MkType("bool"); }
        if (k == AK.QueryExpr()) {
            Node srcT = InferType(e.a);
            Node elem = null;
            if (srcT != null && srcT.sval == "List" && srcT.kids.Count > 0) { elem = srcT.kids[0]; }
            int qm = ScopeMark();
            ScopeAdd(e.sval, elem);
            Node sel = InferType(e.b);
            ScopeTrim(qm);
            if (sel == null) { sel = elem; }
            Node lst = MkType("List");
            lst.Add(sel);
            return lst;
        }
        if (k == AK.Unary()) {
            if (e.op == TK.Bang()) { return MkType("bool"); }
            return InferType(e.a);
        }
        if (k == AK.PostfixUnary()) { return InferType(e.a); }
        if (k == AK.Binary()) {
            int op = e.op;
            if (op == TK.EqEq() || op == TK.BangEq() || op == TK.Less() || op == TK.Greater()
                || op == TK.LessEq() || op == TK.GreaterEq() || op == TK.AmpAmp() || op == TK.PipePipe()) {
                return MkType("bool");
            }
            Node lt = InferType(e.a);
            Node rt = InferType(e.b);
            if (IsStr(lt) || IsStr(rt)) { return MkType("string"); }
            if (lt != null) { return lt; }
            return rt;
        }
        if (k == AK.Index()) {
            Node ot = InferType(e.a);
            if (ot != null) {
                if (ot.sval == "List" && ot.kids.Count > 0) { return ot.kids[0]; }
                if (ot.sval == "Span" && ot.kids.Count > 0) { return ot.kids[0]; }
                if (ot.sval == "string") { return MkType("char"); }
                if (ot.ival == 1) { Node el = MkType(ot.sval); el.kids = ot.kids; return el; }
            }
            return null;
        }
        if (k == AK.MemberAccess()) {
            Node ot = InferType(e.a);
            Node cls = ClassOf(ot);
            if (cls != null) {
                Node f = FieldUp(cls, e.sval);
                if (f != null) { return f.type; }
                Node g = MethodUp(cls, "get_" + e.sval);
                if (g != null) { return g.type; }
            }
            return null;
        }
        if (k == AK.Call()) {
            Node callee = e.a;
            if (callee != null && callee.kind == AK.Ident()) {
                Node m = MethodUp(curClass, callee.sval);
                if (m != null) { return m.type; }
                return null;
            }
            if (callee != null && callee.kind == AK.MemberAccess()) {
                Node ot = InferType(callee.a);
                Node cls = ClassOf(ot);
                if (cls != null) {
                    Node m = MethodUp(cls, callee.sval);
                    if (m != null) { return m.type; }
                }
                // `Task.Run(...)` / `Task.Spawn(...)`: the handle's shape
                // follows the argument (the C host's task_run_result_type).
                Node tr = TaskCallType(e);
                if (tr != null) { return tr; }
                return null;
            }
            return null;
        }
        if (k == AK.SwitchExpr()) {
            if (e.kids.Count > 0) { return InferType(e.kids[0].b); }
            return null;
        }
        return null;
    }

    bool IsStr(Node t) { return t != null && t.sval == "string"; }

    // The result type of `Task.Run(...)` / `Task.Spawn(...)`, mirroring the C
    // host's task_run_result_type (src/compiler/checker.c):
    //
    //   Task.Spawn(...)         -> Task    (a detached frame carries no result)
    //   Task.Run(lambda/Action) -> Task    (an action frame carries no result)
    //   Task.Run(<void call>)   -> Task
    //   Task.Run(<call>)        -> Task<T> (T = the call's result type)
    //
    // The distinction is not cosmetic: the action frame is released by the
    // completion path, so reading it as a result handle releases it twice.
    Node TaskCallType(Node call) {
        Node callee = call.a;
        if (callee == null || callee.kind != AK.MemberAccess()) { return null; }
        if (callee.a == null || callee.a.kind != AK.Ident()) { return null; }
        if (callee.a.sval != "Task") { return null; }
        string mname = callee.sval;
        if (mname != "Run" && mname != "Spawn") { return null; }
        if (call.kids.Count != 1) { return null; }
        Node arg = call.kids[0];
        if (arg == null) { return null; }
        if (mname == "Spawn") { return MkTaskType(null); }
        if (arg.kind == AK.Lambda()) { return MkTaskType(null); }
        Node at = InferType(arg);
        if (at == null) { return null; }        // unknown argument: stay permissive
        if (binder.IsDelegateName(at.sval)) { return MkTaskType(null); }
        if (at.sval == "void") { return MkTaskType(null); }
        if (IsTaskTy(at)) {
            if (at.kids.Count == 1) { return MkTaskType(at.kids[0]); }
            return MkTaskType(null);
        }
        return MkTaskType(at);
    }

    // The C host rejects a handle that carries no result where a Task<T> is
    // expected (src/compiler/checker.c: checker_check_assignable): the action
    // frame would be released twice -- once by the completion path, once by
    // the reader -- and the double free aborts the process. The self-hosted
    // checker applies the same rule wherever a value flows into a typed slot.
    void CheckTaskNoResult(Node target, Node value, string what, int line, int col) {
        if (!IsTaskTy(target) || !IsTaskTy(value)) { return; }
        if (target.kids.Count != 1 || value.kids.Count != 0) { return; }
        diags.Error("cannot convert '" + TaskTyName(value) + "' to '" + TaskTyName(target)
            + "' in " + what + ": a task started from a lambda/Action carries no result; "
            + "declare 'Task' (not 'Task<T>') and wait with .Wait()", line, col);
    }

    // A Task-shaped slot only accepts a task handle. The C host rejects a
    // raw value with "cannot convert 'double' to 'Task' in initializer: no
    // implicit conversion" -- the target is spelled 'Task', without the type
    // arguments (the host's assignability check compares against the task
    // type itself, not against "Task<T>"). A null is fine: a null handle is
    // still a handle.
    void CheckTaskOnlyHandle(Node target, Node value, string what, int line, int col) {
        if (!IsTaskTy(target)) { return; }
        if (value == null) { return; }
        if (IsTaskTy(value)) { return; }   // a handle; the no-result case has its own message
        diags.Error("cannot convert '" + value.sval + "' to 'Task' in " + what
            + ": no implicit conversion", line, col);
    }

    // The number of type arguments a built-in generic takes, mirroring the
    // C host's binder (src/compiler/binder.c): List, Span, ReadOnlySpan and
    // Task take one, Dict and Dictionary take two. -1 = not a built-in
    // generic (the host accepts any argument count for those silently).
    int BuiltinGenericArity(string name) {
        if (name == "List") { return 1; }
        if (name == "Span") { return 1; }
        if (name == "ReadOnlySpan") { return 1; }
        if (name == "Task") { return 1; }
        if (name == "Dict") { return 2; }
        if (name == "Dictionary") { return 2; }
        return -1;
    }

    // The number of type parameters a declared class/struct/enum declares
    // (its own type parameters, not its methods').
    int DeclTypeParamCount(Node decl) {
        if (decl == null) { return 0; }
        int n = 0;
        int i = 0;
        while (i < decl.kids.Count) {
            if (decl.kids[i].kind == AK.TypeParam()) { n = n + 1; }
            i = i + 1;
        }
        return n;
    }

    // Resolve one type reference the way the C host's binder does
    // (src/compiler/binder.c: binder_resolve_type): find the base type,
    // check the type-argument count, then resolve each argument. The
    // diagnostics are collected instead of emitted so the caller can decide
    // how often each one is reported -- the host resolves a method
    // signature's types twice (the binder, then the checker in the method's
    // own scope) and so reports a bad signature type twice.
    List<Diag> TypeDiags(Node t) {
        List<Diag> res = new List<Diag>();
        if (t == null) { return res; }
        string name = t.sval;
        bool ok = binder.IsPrimitive(name);
        if (!ok) { ok = binder.IsBuiltinGeneric(name); }
        if (!ok) { ok = binder.IsTypeParam(name); }
        if (!ok) { ok = binder.IsDelegateName(name); }
        if (!ok) { ok = name == "TypeInfo"; }   // builtin reflection handle
        if (!ok) { ok = name == "Task"; }        // builtin task handle (Task / Task<T>)
        if (!ok) { ok = binder.FindType(name) != null; }
        if (!ok) {
            // the host stops here: an unresolved base type is not resolved
            // any further, so its type arguments are never looked at
            res.Add(new Diag("undefined type '" + name + "'", t.line, t.col, false));
            return res;
        }
        // The type-argument count. The C host distinguishes three cases: a
        // built-in generic (List/Span/ReadOnlySpan/Task take one argument,
        // Dict/Dictionary take two), a declared class/struct/interface (as
        // many arguments as it declares type parameters) and anything else
        // that carries a declaration (an enum, a named delegate -- "the
        // non-generic type 'X' cannot be used with type arguments").
        int expected = BuiltinGenericArity(name);
        bool plain = false;
        if (expected < 0) {
            Node decl = binder.FindType(name);
            if (decl != null) {
                if (decl.kind == AK.EnumDecl()) { plain = true; expected = 0; }
                else { expected = DeclTypeParamCount(decl); }
            } else {
                Node ddel = binder.FindDelegate(name);
                // Func and Action are built-in delegate types in the C host
                // (src/compiler/binder.c resolves them before the scope
                // lookup, so the stdlib's own declaration is shadowed): the
                // host accepts any argument count for them.
                if (ddel != null && name != "Func" && name != "Action") {
                    expected = DeclTypeParamCount(ddel);
                    if (expected == 0) { plain = true; }
                }
            }
        }
        if (t.kids.Count > 0) {
            if (plain) {
                res.Add(new Diag("the non-generic type '" + name
                    + "' cannot be used with type arguments", t.line, t.col, false));
                return res;
            }
            if (expected >= 0 && t.kids.Count != expected) {
                res.Add(new Diag("using the generic type '" + name + "' requires "
                    + expected + " type arguments (got " + t.kids.Count + ")",
                    t.line, t.col, false));
                return res;
            }
        }
        int i = 0;
        while (i < t.kids.Count) {
            List<Diag> sub = TypeDiags(t.kids[i]);
            int j = 0;
            while (j < sub.Count) { res.Add(sub[j]); j = j + 1; }
            i = i + 1;
        }
        return res;
    }

    // Report a type reference's diagnostics once.
    void CheckType(Node t) {
        List<Diag> ds = TypeDiags(t);
        int i = 0;
        while (i < ds.Count) { diags.Add(ds[i]); i = i + 1; }
    }

    // Report a method signature's type diagnostics twice: the C host
    // resolves a method's return and parameter types in the binder and then
    // again in the checker (each in its own scope), so a bad signature type
    // is reported by both passes. The self-hosted checker mirrors that.
    void CheckSignatureType(Node t) {
        List<Diag> ds = TypeDiags(t);
        int i = 0;
        while (i < ds.Count) { diags.Add(ds[i]); i = i + 1; }
        i = 0;
        while (i < ds.Count) { diags.Add(ds[i]); i = i + 1; }
    }

    public void Check(Node unit) {
        int i = 0;
        while (i < unit.kids.Count) {
            Node d = unit.kids[i];
            if (d.kind == AK.ClassDecl() || d.kind == AK.StructDecl()) { CheckClass(d); }
            i = i + 1;
        }
    }

    void CheckClass(Node cls) {
        curClass = cls;
        if (cls.sval2 != "") {
            if (binder.FindType(cls.sval2) == null) {
                diags.Error("undefined base type '" + cls.sval2 + "'", cls.baseLine, cls.baseCol);
            }
        }
        int i = 0;
        while (i < cls.kids.Count) {
            Node m = cls.kids[i];
            if (m.kind == AK.FieldDecl()) { CheckType(m.type); }
            else if (m.kind == AK.MethodDecl()) { CheckMethod(m, false); }
            else if (m.kind == AK.CtorDecl()) { CheckMethod(m, true); }
            i = i + 1;
        }
        curClass = null;
    }

    void CheckMethod(Node m, bool ctor) {
        if (m.type != null) { CheckSignatureType(m.type); }
        scopeName = new List<string>(); scopeType = new List<Node>();
        loopDepth = 0;
        // An async method with a Task-shaped return type returns its RESULT,
        // not a handle: the C host's parser rewrites `async Task<T>` to `T`
        // and `async Task` to `void` (desugar_async_task_method) before the
        // checker runs, so the body is checked against the element type.
        Node bodyRet = m.type;
        if (!ctor && HasMod(m, MOD.Async()) && IsTaskTy(bodyRet)) {
            bodyRet = TaskElemTy(bodyRet);
        }
        curRet = bodyRet;
        curStatic = !ctor && HasMod(m, MOD.Static());
        int i = 0;
        while (i < m.kids.Count) {
            Node p = m.kids[i];
            if (p.kind == AK.Param()) {
                CheckSignatureType(p.type);
                if (ScopeHas(p.sval)) {
                    diags.Error("duplicate parameter '" + p.sval + "'", p.line, p.col);
                }
                ScopeAdd(p.sval, p.type);
            }
            i = i + 1;
        }
        CheckStmt(m.d);
        CheckAwaits(m);
        // The C host has no "not all code paths return a value" diagnostic:
        // a method whose body falls through is legal there (the body may end
        // in a `lock`/`fixed`/`using` block the checker does not model, and
        // the irgen emits the default return for the fall-through path).
        // Reporting it here made the self-host refuse programs the host
        // accepts -- the host is the spec, so the check is gone.
    }

    // ---- await placement ----
    // An `await` inside a lambda is not lowered: the lambda is a separate
    // function, and in an async method the await would run the cooperative
    // scheduler from inside a running coroutine (reentrant scheduler). The
    // self-hosted backend has no async-lambda form, so report it.
    //
    // Note: an `await` in a *synchronous* method is fine -- the C host accepts
    // it too (the awaited coroutine is driven to completion by the scheduler
    // the self-hosted backend runs at that point). Only the *operand* has to
    // be a coroutine frame; that is checked where the await is lowered.
    void CheckAwaits(Node m) {
        if (m.d == null) { return; }
        if (!HasMod(m, MOD.Async())) { return; }
        Node lam = FindAwaitInLambda(m.d);
        if (lam != null) {
            diags.Error("'await' inside a lambda is not lowered by the self-hosted compiler " +
                "(a lambda is not a coroutine)", lam.line, lam.col);
        }
    }

    // the first `await` anywhere in the expression tree
    Node FindAwaitDeep(Node n) {
        if (n == null) { return null; }
        if (n.kind == AK.AwaitExpr()) { return n; }
        Node r = FindAwaitDeep(n.a); if (r != null) { return r; }
        r = FindAwaitDeep(n.b); if (r != null) { return r; }
        r = FindAwaitDeep(n.c); if (r != null) { return r; }
        r = FindAwaitDeep(n.d); if (r != null) { return r; }
        int i = 0;
        while (i < n.kids.Count) { r = FindAwaitDeep(n.kids[i]); if (r != null) { return r; } i = i + 1; }
        return null;
    }

    // the first `await` that sits inside a lambda (a lambda never has a frame)
    Node FindAwaitInLambda(Node n) {
        if (n == null) { return null; }
        if (n.kind == AK.AwaitExpr()) { return null; }
        if (n.kind == AK.Lambda()) {
            Node r = FindAwaitDeep(n.a); if (r != null) { return r; }
            r = FindAwaitDeep(n.d); if (r != null) { return r; }
            return null;
        }
        Node r = FindAwaitInLambda(n.a); if (r != null) { return r; }
        r = FindAwaitInLambda(n.b); if (r != null) { return r; }
        r = FindAwaitInLambda(n.c); if (r != null) { return r; }
        r = FindAwaitInLambda(n.d); if (r != null) { return r; }
        int i = 0;
        while (i < n.kids.Count) { r = FindAwaitInLambda(n.kids[i]); if (r != null) { return r; } i = i + 1; }
        return null;
    }

    // ---- statements ----
    void CheckStmt(Node n) {
        if (n == null) { return; }
        int k = n.kind;
        if (k == AK.Block()) {
            int mark = ScopeMark();
            int i = 0;
            while (i < n.kids.Count) { CheckStmt(n.kids[i]); i = i + 1; }
            ScopeTrim(mark);
            return;
        }
        if (k == AK.VarDecl()) {
            CheckType(n.type);
            CheckExpr(n.b);
            if (n.type != null) {
                // the C host points at the *type* of the declaration when it
                // reports a conversion failure there
                Node vt = InferType(n.b);
                CheckTaskNoResult(n.type, vt, "initializer", n.type.line, n.type.col);
                CheckTaskOnlyHandle(n.type, vt, "initializer", n.type.line, n.type.col);
            }
            Node ty = n.type;
            if (ty == null) { ty = InferType(n.b); }
            ScopeAdd(n.sval, ty);
            int di = 0;
            while (di < n.kids.Count) {
                Node d = n.kids[di];
                CheckExpr(d.b);
                if (d.type != null) {
                    Node dv = InferType(d.b);
                    CheckTaskNoResult(d.type, dv, "initializer", d.type.line, d.type.col);
                    CheckTaskOnlyHandle(d.type, dv, "initializer", d.type.line, d.type.col);
                }
                Node dty = d.type;
                if (dty == null) { dty = InferType(d.b); }
                ScopeAdd(d.sval, dty);
                di = di + 1;
            }
            return;
        }
        if (k == AK.DeconDecl()) {
            CheckExpr(n.b);
            int i = 0;
            while (i < n.kids.Count) {
                Node p = n.kids[i];
                CheckType(p.type);
                ScopeAdd(p.sval, p.type);
                i = i + 1;
            }
            return;
        }
        if (k == AK.GotoStmt() || k == AK.LabelStmt()) { return; }
        if (k == AK.ExprStmt()) { CheckExpr(n.a); return; }
        if (k == AK.ReturnStmt()) {
            CheckExpr(n.a);
            // The C host has NEITHER "cannot return a value from a void method"
            // NOR "must return a value" (grep src/compiler: no such
            // diagnostic). `static void Main() { ...; return 0; }` is a
            // program the host compiles and runs; the self-host checker
            // used to refuse it, so the check is gone -- the host is the
            // spec.
            if (n.a != null && curRet != null) {
                Node rv = InferType(n.a);
                CheckTaskNoResult(curRet, rv, "return statement", n.line, n.col);
                CheckTaskOnlyHandle(curRet, rv, "return statement", n.line, n.col);
            }
            return;
        }
        if (k == AK.ThrowStmt()) { CheckExpr(n.a); return; }
        if (k == AK.IfStmt()) {
            CheckExpr(n.a);
            int m1 = ScopeMark(); CheckStmt(n.b); ScopeTrim(m1);
            int m2 = ScopeMark(); CheckStmt(n.c); ScopeTrim(m2);
            return;
        }
        if (k == AK.WhileStmt()) {
            CheckExpr(n.a);
            loopDepth = loopDepth + 1;
            int m = ScopeMark(); CheckStmt(n.b); ScopeTrim(m);
            loopDepth = loopDepth - 1;
            return;
        }
        if (k == AK.DoWhileStmt()) {
            loopDepth = loopDepth + 1;
            int m = ScopeMark(); CheckStmt(n.b); ScopeTrim(m);
            loopDepth = loopDepth - 1;
            CheckExpr(n.a);
            return;
        }
        if (k == AK.ForStmt()) {
            int mark = ScopeMark();
            CheckStmt(n.a);
            CheckExpr(n.b);
            CheckExpr(n.c);
            loopDepth = loopDepth + 1;
            CheckStmt(n.d);
            loopDepth = loopDepth - 1;
            ScopeTrim(mark);
            return;
        }
        if (k == AK.ForeachStmt()) {
            int mark = ScopeMark();
            CheckType(n.type);
            CheckExpr(n.b);
            Node et = n.type;
            if (et == null) {
                Node ct = InferType(n.b);
                if (ct != null && ct.sval == "List" && ct.kids.Count > 0) { et = ct.kids[0]; }
            }
            ScopeAdd(n.sval, et);
            loopDepth = loopDepth + 1;
            CheckStmt(n.c);
            loopDepth = loopDepth - 1;
            ScopeTrim(mark);
            return;
        }
        if (k == AK.BreakStmt() || k == AK.ContinueStmt()) {
            if (loopDepth == 0) {
                diags.Error("break/continue outside of loop or switch", n.line, n.col);
            }
            return;
        }
        if (k == AK.SwitchStmt()) {
            CheckExpr(n.a);
            loopDepth = loopDepth + 1;
            int i = 0;
            while (i < n.kids.Count) {
                Node c = n.kids[i];
                // A pattern case (`case T x [when g]:`, `case null:`) binds x in
                // the case's own scope: the guard and the body both see it.
                // A constant case carries its label in `a`.
                int m = ScopeMark();
                if (c.ival == 1) {
                    if (c.type != null) { CheckType(c.type); }
                    if (c.sval != null && c.sval != "") { ScopeAdd(c.sval, c.type); }
                    CheckExpr(c.c);
                } else {
                    CheckExpr(c.a);
                }
                CheckStmt(c.b);
                ScopeTrim(m);
                i = i + 1;
            }
            loopDepth = loopDepth - 1;
            return;
        }
        if (k == AK.TryStmt()) {
            int m1 = ScopeMark(); CheckStmt(n.a); ScopeTrim(m1);
            Node cc = n.b;
            while (cc != null) {
                CheckType(cc.type);
                int m2 = ScopeMark();
                ScopeAdd(cc.sval, cc.type);
                CheckStmt(cc.a);
                ScopeTrim(m2);
                cc = cc.b;
            }
            int m3 = ScopeMark(); CheckStmt(n.c); ScopeTrim(m3);
            return;
        }
    }

    // ---- expressions ----
    // The object of a member access / callee of a call is not flagged as an
    // undefined identifier: it may name a stdlib type or namespace.
    void CheckObj(Node n) {
        if (n == null) { return; }
        if (n.kind == AK.Ident()) { return; }
        CheckExpr(n);
    }

    void CheckExpr(Node n) {
        if (n == null) { return; }
        int k = n.kind;
        if (k == AK.Ident()) {
            if (!KnownValue(n.sval)) {
                diags.Error("undefined identifier '" + n.sval + "'", n.line, n.col);
            } else if (curStatic && !ScopeHas(n.sval)) {
                Node f = FieldUp(curClass, n.sval);
                if (f != null && !HasMod(f, MOD.Static())) {
                    diags.Error("cannot access instance field '" + n.sval + "' from a static method", n.line, n.col);
                }
            }
            return;
        }
        if (k == AK.ThisExpr()) {
            if (curStatic) { diags.Error("'this' cannot be used in a static method", n.line, n.col); }
            return;
        }
        if (k == AK.MemberAccess()) { CheckMember(n); return; }
        if (k == AK.Call()) { CheckCall(n); return; }
        if (k == AK.OutArg()) {
            // `ref x` place form: check the referenced expression
            if (n.a != null) { CheckExpr(n.a); return; }
            // `out T name` declares a new local visible after the call
            if (n.type != null) { ScopeAdd(n.sval, n.type); }
            else if (!KnownValue(n.sval)) {
                diags.Error("undefined identifier '" + n.sval + "'", n.line, n.col);
            }
            return;
        }
        if (k == AK.Binary() || k == AK.Assignment()) {
            CheckExpr(n.a); CheckExpr(n.b);
            if (k == AK.Assignment()) {
                CheckTaskNoResult(InferType(n.a), InferType(n.b), "assignment", n.line, n.col);
            }
            return;
        }
        if (k == AK.Unary() || k == AK.PostfixUnary()) { CheckExpr(n.a); return; }
        if (k == AK.Index()) { CheckExpr(n.a); CheckExpr(n.b); return; }
        if (k == AK.CallInit()) { CheckCallInitItems(n); return; }
        if (k == AK.NewExpr()) {
            // anonymous new has no type node: it only appears inside db
            // query lambdas, which the dbgen rewrite replaces before this
            // walk; anything surviving to here is a user error
            if (n.type == null) {
                diags.Error("anonymous types are only supported in database query lambdas", n.line, n.col);
                return;
            }
            CheckType(n.type);
            CheckExpr(n.b);
            int i = 0;
            while (i < n.kids.Count) {
                Node it = n.kids[i];
                // object initializer `Field = v`: the lhs names a field of the
                // new type, not a local, so only the value is checked here.
                if (n.ival == 2 && it.kind == AK.Assignment()) {
                    CheckExpr(it.b);
                } else {
                    CheckExpr(it);
                }
                i = i + 1;
            }
            return;
        }
        if (k == AK.CastExpr()) { CheckType(n.type); CheckExpr(n.b); return; }
        if (k == AK.IsExpr()) {
            CheckExpr(n.a);
            CheckType(n.type);
            ScopeAdd(n.sval, n.type);
            return;
        }
        if (k == AK.Conditional()) { CheckExpr(n.a); CheckExpr(n.b); CheckExpr(n.c); return; }
        if (k == AK.QueryExpr()) {
            CheckExpr(n.a);
            int mark = ScopeMark();
            Node et = null;
            Node ct = InferType(n.a);
            if (ct != null && ct.sval == "List" && ct.kids.Count > 0) { et = ct.kids[0]; }
            ScopeAdd(n.sval, et);
            int i = 0;
            while (i < n.kids.Count) { CheckExpr(n.kids[i]); i = i + 1; }
            CheckExpr(n.b);
            ScopeTrim(mark);
            return;
        }
        if (k == AK.Lambda()) {
            int mark = ScopeMark();
            int i = 0;
            while (i < n.kids.Count) {
                Node p = n.kids[i];
                if (p.kind == AK.Param()) { ScopeAdd(p.sval, p.type); }
                i = i + 1;
            }
            // A lambda returns ITS OWN value, not the enclosing method's: the
            // return type of a lambda is not known here (the self-hosted
            // checker does not type a lambda from its context), so the
            // `return` statements inside its body are not policed against the
            // enclosing method.
            Node saveRet = curRet;
            curRet = null;
            CheckExpr(n.a);
            CheckStmt(n.d);
            curRet = saveRet;
            ScopeTrim(mark);
            return;
        }
        if (k == AK.SwitchExpr()) {
            CheckExpr(n.a);
            int i = 0;
            while (i < n.kids.Count) {
                Node arm = n.kids[i];
                // Pattern arm (`T x when g => v`): the binding is in scope for
                // the guard and the result expression.
                int m = ScopeMark();
                if (arm.ival == 1) {
                    if (arm.type != null) { CheckType(arm.type); }
                    if (arm.sval != null && arm.sval != "") { ScopeAdd(arm.sval, arm.type); }
                    CheckExpr(arm.c);
                } else {
                    CheckExpr(arm.a);
                }
                CheckExpr(arm.b);
                ScopeTrim(m);
                i = i + 1;
            }
            return;
        }
        if (k == AK.TupleExpr()) {
            int i = 0;
            while (i < n.kids.Count) { CheckExpr(n.kids[i]); i = i + 1; }
            return;
        }
    }

    // The reflection instance surface lowers to generated helpers (ngen),
    // not user members -- accepted on any receiver, like the oracle.
    bool IsReflInstName(string n) {
        if (n == "GetType" || n == "HasField" || n == "HasMethod") { return true; }
        if (n == "GetFieldInt" || n == "GetFieldLong" || n == "GetFieldBool"
                || n == "GetFieldDouble" || n == "GetFieldString") { return true; }
        if (n == "SetFieldInt" || n == "SetFieldLong" || n == "SetFieldBool"
                || n == "SetFieldDouble" || n == "SetFieldString") { return true; }
        if (n == "Invoke" || n == "InvokeInt" || n == "InvokeLong"
                || n == "InvokeDouble" || n == "InvokeString") { return true; }
        return false;
    }

    void CheckMember(Node n) {
        CheckObj(n.a);
        Node ot = InferType(n.a);
        Node cls = ClassOf(ot);
        if (cls != null && !HasMember(cls, n.sval) && !HasExt(cls.sval, n.sval)) {
            if (!IsReflInstName(n.sval)) {
                diags.Error("type '" + cls.sval + "' has no member '" + n.sval + "'", n.line, n.col);
            }
        }
    }

    void CheckCall(Node n) {
        Node callee = n.a;
        bool hasNamed = false;
        int i = 0;
        while (i < n.kids.Count) {
            if (n.kids[i].sval2 != "") { hasNamed = true; }
            CheckExpr(n.kids[i]);
            i = i + 1;
        }
        int argc = n.kids.Count;
        if (callee != null && callee.kind == AK.Ident()) {
            // bare call: resolve against the enclosing type's methods
            Node cands = MethodUp(curClass, callee.sval);
            if (cands != null && !hasNamed && !AcceptsArgc(curClass, callee.sval, argc)) {
                diags.Error("no overload of '" + callee.sval + "' takes " + argc + " argument(s)", n.line, n.col);
            }
            if (!hasNamed) { CheckTaskArgs(cands, n); }
            return;
        }
        if (callee != null && callee.kind == AK.MemberAccess()) {
            CheckObj(callee.a);
            Node ot = InferType(callee.a);
            Node cls = ClassOf(ot);
            if (cls != null) {
                if (!HasMember(cls, callee.sval) && !HasExt(cls.sval, callee.sval)) {
                    if (!IsReflInstName(callee.sval)) {
                        diags.Error("type '" + cls.sval + "' has no member '" + callee.sval + "'", n.line, n.col);
                    }
                } else if (MethodUp(cls, callee.sval) != null && !hasNamed && !AcceptsArgc(cls, callee.sval, argc)) {
                    diags.Error("no overload of '" + callee.sval + "' takes " + argc + " argument(s)", n.line, n.col);
                }
                if (!hasNamed) { CheckTaskArgs(MethodUp(cls, callee.sval), n); }
            }
            return;
        }
        CheckObj(callee);
    }

    // A no-result handle passed where a Task<T> is expected: the same rule as
    // on the declaration side (the host compares the argument with the formal
    // parameter type). The parameter list must match the argument count --
    // the self-hosted checker resolves overloads by name, so a different
    // overload may be the intended one.
    void CheckTaskArgs(Node m, Node call) {
        if (m == null) { return; }
        int np = 0;
        int i = 0;
        while (i < m.kids.Count) {
            if (m.kids[i].kind == AK.Param()) { np = np + 1; }
            i = i + 1;
        }
        if (np != call.kids.Count) { return; }
        int j = 0;
        i = 0;
        while (i < m.kids.Count) {
            Node p = m.kids[i];
            if (p.kind == AK.Param()) {
                Node a = call.kids[j];
                if (a != null) {
                    CheckTaskNoResult(p.type, InferType(a), "argument", a.line, a.col);
                }
                j = j + 1;
            }
            i = i + 1;
        }
    }
    // 工厂调用延续初始化器的成员写（独立方法：CheckExpr 已在每方法的
    // 局部槽预算边缘，不再往里长）：调用本身照常查，成员写只查右值
    // （lhs 是返回对象的成员名，不是局部量）。
    void CheckCallInitItems(Node n) {
        CheckExpr(n.a);
        int i = 0;
        while (i < n.kids.Count) {
            Node it = n.kids[i];
            if (it.kind == AK.Assignment()) { CheckExpr(it.b); } else { CheckExpr(it); }
            i = i + 1;
        }
    }
}
