            string dI64 = NT(); L("  " + dI64 + " = sitofp i64 " + vI64 + " to double");
            L("  store double " + dI64 + ", double* " + resSlot);
            L("  br label %L" + ldone);
            Label(ldec16d);
            string pDec16d = NT(); L("  " + pDec16d + " = bitcast i8* " + fp + " to " + DecimalLL() + "*");
            string vDec16d = NT(); L("  " + vDec16d + " = load " + DecimalLL() + ", " + DecimalLL() + "* " + pDec16d);
            L("  store double " + DecimalNumber(new ExprVal(vDec16d, MkType("decimal")), true) + ", double* " + resSlot);
            L("  br label %L" + ldone);
            Label(lni17d);
            string pp17d = NT(); L("  " + pp17d + " = bitcast i8* " + fp + " to i8**");
            string bx17d = NT(); L("  " + bx17d + " = load i8*, i8** " + pp17d);
            string nn17d = NT(); L("  " + nn17d + " = icmp ne i8* " + bx17d + ", null");
            int lni17dr = NL();
            L("  br i1 " + nn17d + ", label %L" + lni17dr + ", label %L" + ldone);
            Label(lni17dr);
            string bp17d = NT(); L("  " + bp17d + " = bitcast i8* " + bx17d + " to i64*");
            string bv17d = NT(); L("  " + bv17d + " = load i64, i64* " + bp17d);
            string dv17d = NT(); L("  " + dv17d + " = sitofp i64 " + bv17d + " to double");
            L("  store double " + dv17d + ", double* " + resSlot);
            L("  br label %L" + ldone);
            Label(lnd18d);
            string pp18d = NT(); L("  " + pp18d + " = bitcast i8* " + fp + " to i8**");
            string bx18d = NT(); L("  " + bx18d + " = load i8*, i8** " + pp18d);
            string nn18d = NT(); L("  " + nn18d + " = icmp ne i8* " + bx18d + ", null");
            int lnd18dr = NL();
            L("  br i1 " + nn18d + ", label %L" + lnd18dr + ", label %L" + ldone);
            Label(lnd18dr);
            string bp18d = NT(); L("  " + bp18d + " = bitcast i8* " + bx18d + " to double*");
            string bv18d = NT(); L("  " + bv18d + " = load double, double* " + bp18d);
            L("  store double " + bv18d + ", double* " + resSlot);
            L("  br label %L" + ldone);
            Label(lnm19d);
            string pp19d = NT(); L("  " + pp19d + " = bitcast i8* " + fp + " to i8**");
            string bx19d = NT(); L("  " + bx19d + " = load i8*, i8** " + pp19d);
            string nn19d = NT(); L("  " + nn19d + " = icmp ne i8* " + bx19d + ", null");
            int lnm19dr = NL();
            L("  br i1 " + nn19d + ", label %L" + lnm19dr + ", label %L" + ldone);
            Label(lnm19dr);
            string bp19d = NT(); L("  " + bp19d + " = bitcast i8* " + bx19d + " to " + DecimalLL() + "*");
            string bv19d = NT(); L("  " + bv19d + " = load " + DecimalLL() + ", " + DecimalLL() + "* " + bp19d);
            L("  store double " + DecimalNumber(new ExprVal(bv19d, MkType("decimal")), true) + ", double* " + resSlot);
            L("  br label %L" + ldone);
            Label(ldone);
            L("  br label %L" + lend);
            Label(lend);
            string ret = NT(); L("  " + ret + " = load double, double* " + resSlot);
            return new ExprVal(ret, MkType("double"));
        }

        if (opName == "GetFieldObject") {
            if (resSlot == "") {
                resSlot = NT();
                L("  " + resSlot + " = alloca i8*");
                L("  store i8* null, i8** " + resSlot);
            }
            int lget = NL();
            int lload = NL();
            int lstruct = NL();
            int lend = propDoneLbl >= 0 ? propDoneLbl : NL();
            L("  br i1 " + hit + ", label %L" + lget + ", label %L" + lend);
            Label(lget);
            string fkind_p = NT(); L("  " + fkind_p + " = getelementptr inbounds i8, i8* " + slotP + ", i64 16");
            string fkind_i64 = NT(); L("  " + fkind_i64 + " = bitcast i8* " + fkind_p + " to i64*");
            string fkind = NT(); L("  " + fkind + " = load i64, i64* " + fkind_i64);
            L("  switch i64 " + fkind + ", label %L" + lend + " [");
            L("    i64 " + ReflFkOf("string") + ", label %L" + lload);
            L("    i64 " + ReflFkOf("object") + ", label %L" + lload);
            L("    i64 20, label %L" + lstruct);
            L("    i64 21, label %L" + lstruct);
            L("  ]");
            Label(lload);
            string foff_p = NT(); L("  " + foff_p + " = getelementptr inbounds i8, i8* " + slotP + ", i64 24");
            string foff_i64 = NT(); L("  " + foff_i64 + " = bitcast i8* " + foff_p + " to i64*");
            string foff = NT(); L("  " + foff + " = load i64, i64* " + foff_i64);
            string fp = NT(); L("  " + fp + " = getelementptr inbounds i8, i8* " + rop + ", i64 " + foff);
            string sp = NT(); L("  " + sp + " = bitcast i8* " + fp + " to i8**");
            string val = NT(); L("  " + val + " = load i8*, i8** " + sp);
            EmitArcRetainObject(val);
            L("  store i8* " + val + ", i8** " + resSlot);
            L("  br label %L" + lend);
            Label(lstruct);
            string foff_ps = NT(); L("  " + foff_ps + " = getelementptr inbounds i8, i8* " + slotP + ", i64 24");
            string foff_i64s = NT(); L("  " + foff_i64s + " = bitcast i8* " + foff_ps + " to i64*");
            string foffs = NT(); L("  " + foffs + " = load i64, i64* " + foff_i64s);
            string fps = NT(); L("  " + fps + " = getelementptr inbounds i8, i8* " + rop + ", i64 " + foffs);
            string sps = NT(); L("  " + sps + " = bitcast i8* " + fps + " to i8**");
            string vals = NT(); L("  " + vals + " = load i8*, i8** " + sps);
            string valsnn = NT(); L("  " + valsnn + " = icmp ne i8* " + vals + ", null");
            int lclone = NL();
            L("  br i1 " + valsnn + ", label %L" + lclone + ", label %L" + lend);
            Label(lclone);
            string ftiP = NT(); L("  " + ftiP + " = getelementptr inbounds i8, i8* " + slotP + ", i64 56");
            string ftiPP = NT(); L("  " + ftiPP + " = bitcast i8* " + ftiP + " to i8**");
            string fti = NT(); L("  " + fti + " = load i8*, i8** " + ftiPP);
            string clRaw = NT(); L("  " + clRaw + " = getelementptr i8, i8* " + fti + ", i64 -144");
            string clSlot = NT(); L("  " + clSlot + " = bitcast i8* " + clRaw + " to i8* (i8*)**");
            string clFn = NT(); L("  " + clFn + " = load i8* (i8*)*, i8* (i8*)** " + clSlot);
            string clVal = NT(); L("  " + clVal + " = call i8* " + clFn + "(i8* " + vals + ")");
            L("  store i8* " + clVal + ", i8** " + resSlot);
            L("  br label %L" + lend);
            Label(lend);
            string ret = NT(); L("  " + ret + " = load i8*, i8** " + resSlot);
            Node objTy = MkType("object");
            AddTemp(ret, objTy);
            return new ExprVal(ret, objTy);
        }

        return new ExprVal("null", MkType("object"));
    }

}
