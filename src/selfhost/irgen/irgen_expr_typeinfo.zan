using System;
using System.Collections.Generic;
namespace Zan;

partial class Irgen {
    ExprVal EmitTypeInfoMethod(ExprVal recv, string mname, Node e) {
        if (mname == "GetFieldAttributeData" || mname == "GetMethodAttributeData") {
            bool method = mname == "GetMethodAttributeData";
            string countOffset = method ? "-80" : "-32";
            string tableOffset = method ? "-88" : "-40";
            string dataOffset = method ? "64" : "32";
            ExprVal index = e.kids.Count > 0 ? GenExpr(e.kids[0]) : new ExprVal("0", MkType("int"));
            string idx = ToI64(index);
            string countSlot = NT();
            string countPtr = NT();
            string count = NT();
            string valid = NT();
            int check = NL();
            int load = NL();
            int empty = NL();
            int done = NL();
            string missing = NT();
            L("  " + missing + " = icmp eq i8* " + recv.op + ", null");
            L("  br i1 " + missing + ", label %L" + empty + ", label %L" + check);
            Label(check);
            L("  " + countSlot + " = getelementptr inbounds i8, i8* " + recv.op + ", i64 " + countOffset);
            L("  " + countPtr + " = bitcast i8* " + countSlot + " to i64*");
            L("  " + count + " = load i64, i64* " + countPtr);
            L("  " + valid + " = icmp ult i64 " + idx + ", " + count);
            L("  br i1 " + valid + ", label %L" + load + ", label %L" + empty);
            Label(load);
            string fieldsSlot = NT();
            string fieldsPtr = NT();
            string fields = NT();
            string rowOffset = NT();
            string attrOffset = NT();
            string attrSlot = NT();
            string attrPtr = NT();
            string attrs = NT();
            L("  " + fieldsSlot + " = getelementptr inbounds i8, i8* " + recv.op + ", i64 " + tableOffset);
            L("  " + fieldsPtr + " = bitcast i8* " + fieldsSlot + " to i8**");
            L("  " + fields + " = load i8*, i8** " + fieldsPtr);
            L("  " + rowOffset + " = mul i64 " + idx + ", 72");
            L("  " + attrOffset + " = add i64 " + rowOffset + ", " + dataOffset);
            L("  " + attrSlot + " = getelementptr inbounds i8, i8* " + fields + ", i64 " + attrOffset);
            L("  " + attrPtr + " = bitcast i8* " + attrSlot + " to i8**");
            L("  " + attrs + " = load i8*, i8** " + attrPtr);
            L("  br label %L" + done);
            Label(empty);
            L("  br label %L" + done);
            Label(done);
            string result = NT();
            L("  " + result + " = phi i8* [ " + attrs + ", %L" + load + " ], [ " + GenConstStr("") + ", %L" + empty + " ]");
            return new ExprVal(result, MkType("string"));
        }
        if (mname == "GetFieldName" || mname == "GetFieldType"
        || mname == "GetFieldTypeInfo" || mname == "GetMemberValue"
        || mname == "GetFieldCustomAttributes" || mname == "GetFieldAttrs") {
            ExprVal idxVal = e.kids.Count > 0 ? GenExpr(e.kids[0]) : new ExprVal("0", MkType("int"));
            string idx64 = ToI64(idxVal);
            int lcheck = NL();
            int lload = NL();
            int lempty = NL();
            int ldone = NL();
            string isNull = NT();
            L("  " + isNull + " = icmp eq i8* " + recv.op + ", null");
            L("  br i1 " + isNull + ", label %L" + lempty + ", label %L" + lcheck);
            Label(lcheck);
            string fcp = NT();
            L("  " + fcp + " = getelementptr inbounds i8, i8* " + recv.op + ", i64 -32");
            string fcp_p = NT();
            L("  " + fcp_p + " = bitcast i8* " + fcp + " to i64*");
            string fcnt = NT();
            L("  " + fcnt + " = load i64, i64* " + fcp_p);
            string fp = NT();
            L("  " + fp + " = getelementptr inbounds i8, i8* " + recv.op + ", i64 -40");
            string fp_ptr = NT();
            L("  " + fp_ptr + " = bitcast i8* " + fp + " to i8**");
            string fbase = NT();
            L("  " + fbase + " = load i8*, i8** " + fp_ptr);
            string inBounds = NT();
            L("  " + inBounds + " = icmp ult i64 " + idx64 + ", " + fcnt);
            string hasBase = NT();
            L("  " + hasBase + " = icmp ne i8* " + fbase + ", null");
            string ok = NT();
            L("  " + ok + " = and i1 " + inBounds + ", " + hasBase);
            L("  br i1 " + ok + ", label %L" + lload + ", label %L" + lempty);
            Label(lload);
            string fo = NT();
            L("  " + fo + " = mul i64 " + idx64 + ", 72");
            string f_slot = NT();
            L("  " + f_slot + " = getelementptr inbounds i8, i8* " + fbase + ", i64 " + fo);

            if (mname == "GetMemberValue") {
                string mv_gep = NT();
                L("  " + mv_gep + " = getelementptr inbounds i8, i8* " + f_slot + ", i64 24");
                string mv_p = NT();
                L("  " + mv_p + " = bitcast i8* " + mv_gep + " to i64*");
                string mv = NT();
                L("  " + mv + " = load i64, i64* " + mv_p);
                L("  br label %L" + ldone);
                Label(lempty);
                L("  br label %L" + ldone);
                Label(ldone);
                string res = NT();
                L("  " + res + " = phi i64 [ " + mv + ", %L" + lload + " ], [ 0, %L" + lempty + " ]");
                return new ExprVal(res, MkType("long"));
            }
            string loaded = NT();
            if (mname == "GetFieldName") {
                string nm_p = NT();
                L("  " + nm_p + " = bitcast i8* " + f_slot + " to i8**");
                L("  " + loaded + " = load i8*, i8** " + nm_p);
            } else if (mname == "GetFieldType") {
                string tp_gep = NT();
                L("  " + tp_gep + " = getelementptr inbounds i8, i8* " + f_slot + ", i64 8");
                string tp_p = NT();
                L("  " + tp_p + " = bitcast i8* " + tp_gep + " to i8**");
                L("  " + loaded + " = load i8*, i8** " + tp_p);
            } else if (mname == "GetFieldTypeInfo") {
                string ti_gep = NT();
                L("  " + ti_gep + " = getelementptr inbounds i8, i8* " + f_slot + ", i64 56");
                string ti_p = NT();
                L("  " + ti_p + " = bitcast i8* " + ti_gep + " to i8**");
                L("  " + loaded + " = load i8*, i8** " + ti_p);
            } else {
                string fa_gep = NT();
                L("  " + fa_gep + " = getelementptr inbounds i8, i8* " + f_slot + ", i64 64");
                string fa_p = NT();
                L("  " + fa_p + " = bitcast i8* " + fa_gep + " to i8**");
                L("  " + loaded + " = load i8*, i8** " + fa_p);
            }
            L("  br label %L" + ldone);
            Label(lempty);
            L("  br label %L" + ldone);
            Label(ldone);
            string dflt = mname == "GetFieldTypeInfo" ? "null" : GenConstStr("");
            string resPtr = NT();
            L("  " + resPtr + " = phi i8* [ " + loaded + ", %L" + lload + " ], [ " + dflt + ", %L" + lempty + " ]");
            return new ExprVal(resPtr, MkType(mname == "GetFieldTypeInfo" ? "TypeInfo" : "string"));
        }
        if (mname == "GetCustomAttributes" || mname == "GetAttrs" || mname == "GetDeclaredAttributeData") {
            int attrOffset = mname == "GetDeclaredAttributeData" ? -96 : -104;
            string ap = NT();
            L("  " + ap + " = getelementptr inbounds i8, i8* " + recv.op + ", i64 " + attrOffset);
            string ap_ptr = NT();
            L("  " + ap_ptr + " = bitcast i8* " + ap + " to i8**");
            string av = NT();
            L("  " + av + " = load i8*, i8** " + ap_ptr);
            return new ExprVal(av, MkType("string"));
        }
        if (mname == "GetTypeArg") {
            ExprVal idxVal = e.kids.Count > 0 ? GenExpr(e.kids[0]) : new ExprVal("0", MkType("int"));
            string idx64 = ToI64(idxVal);
            int lnull = NL();
            int lload = NL();
            int lend = NL();
            string isNull = NT();
            L("  " + isNull + " = icmp eq i8* " + recv.op + ", null");
            L("  br i1 " + isNull + ", label %L" + lnull + ", label %L" + lload);
            Label(lload);
            string tap = NT();
            L("  " + tap + " = getelementptr inbounds i8, i8* " + recv.op + ", i64 -48");
            string tap_ptr = NT();
            L("  " + tap_ptr + " = bitcast i8* " + tap + " to i8***");
            string tav = NT();
            L("  " + tav + " = load i8**, i8*** " + tap_ptr);
            string isTaNull = NT();
            L("  " + isTaNull + " = icmp eq i8** " + tav + ", null");
            int lok = NL();
            L("  br i1 " + isTaNull + ", label %L" + lnull + ", label %L" + lok);
            Label(lok);
            string item_p = NT();
            L("  " + item_p + " = getelementptr inbounds i8*, i8** " + tav + ", i64 " + idx64);
            string targ = NT();
            L("  " + targ + " = load i8*, i8** " + item_p);
            L("  br label %L" + lend);
            Label(lnull);
            L("  br label %L" + lend);
            Label(lend);
            string resPhi = NT();
            L("  " + resPhi + " = phi i8* [ " + targ + ", %L" + lok + " ], [ null, %L" + lnull + " ]");
            return new ExprVal(resPhi, MkType("TypeInfo"));
        }
        if (mname == "CreateInstance") {
            int lend = NL();
            string resSlot = NT();
            L("  " + resSlot + " = alloca i8*");
            L("  store i8* null, i8** " + resSlot);

            int lstart = NL();
            string isNull = NT();
            L("  " + isNull + " = icmp eq i8* " + recv.op + ", null");
            L("  br i1 " + isNull + ", label %L" + lend + ", label %L" + lstart);
            Label(lstart);

            if (e.kids.Count == 0) {
                string list = NT();
                L("  " + list + " = call i8* @zlist_reflection_new(i8* " + recv.op + ")");
                string made = NT();
                L("  " + made + " = icmp ne i8* " + list + ", null");
                int llist = NL();
                int lclass = NL();
                L("  br i1 " + made + ", label %L" + llist + ", label %L" + lclass);
                Label(llist);
                L("  store i8* " + list + ", i8** " + resSlot);
                L("  br label %L" + lend);
                Label(lclass);
            }

            List<ExprVal> ctorArgVals = new List<ExprVal>();
            int eai = 0;
            while (eai < e.kids.Count) {
                ctorArgVals.Add(GenExpr(e.kids[eai]));
                eai = eai + 1;
            }

            int ci = 0;
            while (ci < tidNames.Count) {
                string cn = tidNames[ci];
                Node cls = binder.FindType(cn);
                if (cls != null && ((cls.kind == AK.ClassDecl() && !HasMod(cls, MOD.Abstract()))
                    || (cls.kind == AK.StructDecl() && !cls.layoutExplicit))) {
                    Node pctor = null;
                    int cki = 0;
                    while (cki < cls.kids.Count) {
                        Node cm = cls.kids[cki];
                        if (cm.kind == AK.CtorDecl() && !HasMod(cm, MOD.Static()) && MethodAcceptsCall(cls, cm, e)) {
                            pctor = cm;
                            break;
                        }
                        cki = cki + 1;
                    }
                    if (e.kids.Count > 0 && pctor == null) {
                        ci = ci + 1;
                        continue;
                    }
                    int lmatch = NL();
                    int lnext = NL();
                    string cnStr = GenStr(cn).op;
                    string eq = NT();
                    L("  " + eq + " = call i32 @strcmp(i8* " + recv.op + ", i8* " + cnStr + ")");
                    string isMatch = NT();
                    L("  " + isMatch + " = icmp eq i32 " + eq + ", 0");
                    if (TParams(cls).Count > 0) {
                        if (!ExternSeen("strncmp")) {
                            externDecls.Add("strncmp");
                            H("declare i32 @strncmp(i8*, i8*, i64)");
                        }
                        string prefStr = GenStr(cn + "<").op;
                        string peq = NT();
                        L("  " + peq + " = call i32 @strncmp(i8* " + recv.op + ", i8* " + prefStr + ", i64 " + (cn.Length + 1) + ")");
                        string isPref = NT();
                        L("  " + isPref + " = icmp eq i32 " + peq + ", 0");
                        string anyM = NT();
                        L("  " + anyM + " = or i1 " + isMatch + ", " + isPref);
                        isMatch = anyM;
                    }
                    L("  br i1 " + isMatch + ", label %L" + lmatch + ", label %L" + lnext);
                    Label(lmatch);
                    string szp = NT();
                    L("  " + szp + " = getelementptr %" + cn + ", %" + cn + "* null, i32 1");
                    string szi = NT();
                    L("  " + szi + " = ptrtoint %" + cn + "* " + szp + " to i64");
                    string raw = NT();
                    L("  " + raw + " = call i8* @zalloc(i64 " + szi + ", i8* bitcast (void (i8*)* @" + cn + "_dtor to i8*), i8* bitcast (i8** @__tid_" + cn + " to i8*))");
                    string obj = NT();
                    L("  " + obj + " = bitcast i8* " + raw + " to %" + cn + "*");
                    InitNestedFields(obj, cls);
                    if (cls.kind == AK.ClassDecl() && IsPolyClass(cls)) {
                        List<string> vslots = new List<string>();
                        CollectVSlots(cls, vslots);
                        string vtp0 = NT();
                        L("  " + vtp0 + " = getelementptr %" + cn + ", %" + cn + "* " + obj + ", i32 0, i32 0");
                        L("  store i8* bitcast ([" + vslots.Count + " x i8*]* @" + cn + "_vtable to i8*), i8** " + vtp0);
                    }
                    string objGuard = "";
                    string objLt = "%" + cn + "*";
                    if (eaActive) {
                        objGuard = NTS();
                        entryAllocas.Append("  " + objGuard + " = alloca " + objLt + "\n");
                        entryAllocas.Append("  store " + objLt + " null, " + objLt + "* " + objGuard + "\n");
                        L("  store " + objLt + " " + obj + ", " + objLt + "* " + objGuard);
                        ArmLocalSlot(objGuard, MkType(cn), false);
                    }
                    if (pctor != null) {
                        List<string> cargs = new List<string>();
                        cargs.Add("%" + cn + "* " + obj);
                        int cai = 0;
                        int cpi = 0;
                        while (cpi < pctor.kids.Count && cai < ctorArgVals.Count) {
                            if (pctor.kids[cpi].kind == AK.Param()) {
                                Node pty = pctor.kids[cpi].type;
                                string pt = MapType(pty);
                                string cv = CallArg(ctorArgVals[cai], pty, false);
                                cargs.Add(pt + " " + cv);
                                cai = cai + 1;
                            }
                            cpi = cpi + 1;
                        }
                        string csym = CtorSym(cn, pctor);
                        StringBuilder callb = new StringBuilder();
                        callb.Append("  call void @" + csym + "(");
                        int cj = 0;
                        while (cj < cargs.Count) {
                            if (cj > 0) { callb.Append(", "); }
                            callb.Append(cargs[cj]);
                            cj = cj + 1;
                        }
                        callb.Append(")");
                        callb.Append(StaticReflectMarker(MkType(cn), csym));
                        L(callb.ToString());
                    } else if (HasChainFieldInits(cls)) {
                        string fsym = FieldInitsSym(cls);
                        L("  call void @" + fsym + "(%" + cn + "* " + obj + ")" + StaticReflectMarker(MkType(cn), fsym));
                    } else {
                        L("  ; zan.rdispatch " + StaticReflectRecord(MkType(cn), ""));
                    }
                    if (objGuard != "") {
                        RetireLocalSlot(objGuard, objLt);
                        L("  store " + objLt + " null, " + objLt + "* " + objGuard);
                    }
                    L("  store i8* " + raw + ", i8** " + resSlot);
                    L("  br label %L" + lend);
                    Label(lnext);
                }
                ci = ci + 1;
            }
            L("  br label %L" + lend);
            Label(lend);
            string ret = NT();
            L("  " + ret + " = load i8*, i8** " + resSlot);
            Node resultType = MkType("object");
            AddTemp(ret, resultType);
            return new ExprVal(ret, resultType);
        }
        if (mname == "HasField") {
            ExprVal nmVal = e.kids.Count > 0 ? GenExpr(e.kids[0]) : new ExprVal("null", MkType("string"));
            string fp = NT();
            L("  " + fp + " = getelementptr inbounds i8, i8* " + recv.op + ", i64 -40");
            string fp_ptr = NT();
            L("  " + fp_ptr + " = bitcast i8* " + fp + " to i8**");
            string fbase = NT();
            L("  " + fbase + " = load i8*, i8** " + fp_ptr);
            string fcp = NT();
            L("  " + fcp + " = getelementptr inbounds i8, i8* " + recv.op + ", i64 -32");
            string fcp_i64 = NT();
            L("  " + fcp_i64 + " = bitcast i8* " + fcp + " to i64*");
            string fcnt = NT();
            L("  " + fcnt + " = load i64, i64* " + fcp_i64);

            int headLbl = NL();
            int bodyLbl = NL();
            int stepLbl = NL();
            int matchLbl = NL();
            int endLbl = NL();
            string idxSlot = NT();
            L("  " + idxSlot + " = alloca i64");
            L("  store i64 0, i64* " + idxSlot);
            L("  br label %L" + headLbl);
            Label(headLbl);
            string curIdx = NT();
            L("  " + curIdx + " = load i64, i64* " + idxSlot);
            string cond = NT();
            L("  " + cond + " = icmp slt i64 " + curIdx + ", " + fcnt);
            L("  br i1 " + cond + ", label %L" + bodyLbl + ", label %L" + endLbl);
            Label(bodyLbl);
            string curOff = NT();
            L("  " + curOff + " = mul i64 " + curIdx + ", 72");
            string slotP = NT();
            L("  " + slotP + " = getelementptr inbounds i8, i8* " + fbase + ", i64 " + curOff);
            string fnP = NT();
            L("  " + fnP + " = bitcast i8* " + slotP + " to i8**");
            string fldName = NT();
            L("  " + fldName + " = load i8*, i8** " + fnP);
            string eq = NT();
            L("  " + eq + " = call i32 @strcmp(i8* " + fldName + ", i8* " + nmVal.op + ")");
            string isMatch = NT();
            L("  " + isMatch + " = icmp eq i32 " + eq + ", 0");
            L("  br i1 " + isMatch + ", label %L" + matchLbl + ", label %L" + stepLbl);
            Label(stepLbl);
            string nextIdx = NT();
            L("  " + nextIdx + " = add i64 " + curIdx + ", 1");
            L("  store i64 " + nextIdx + ", i64* " + idxSlot);
            L("  br label %L" + headLbl);
            Label(matchLbl);
            L("  br label %L" + endLbl);
            Label(endLbl);
            string phi = NT();
            L("  " + phi + " = phi i1 [ 1, %L" + matchLbl + " ], [ 0, %L" + headLbl + " ]");
            string z = NT();
            L("  " + z + " = zext i1 " + phi + " to i64");
            return new ExprVal(z, MkType("bool"));
        }
        if (mname == "FindField") {
            ExprVal nmVal = e.kids.Count > 0 ? GenExpr(e.kids[0]) : new ExprVal("null", MkType("string"));
            string idx = NT();
            L("  " + idx + " = call i64 @__zan_refl_field_find_idx(i8* " + recv.op + ", i8* " + nmVal.op + ")");
            return new ExprVal(idx, MkType("int"));
        }
        if (mname == "FindMethod") {
            ExprVal nmVal = e.kids.Count > 0 ? GenExpr(e.kids[0]) : new ExprVal("null", MkType("string"));
            string idx = NT();
            L("  " + idx + " = call i64 @__zan_refl_method_find_idx(i8* " + recv.op + ", i8* " + nmVal.op + ")");
            return new ExprVal(idx, MkType("int"));
        }
        if (mname == "GetMethodName" || mname == "GetMethodReturnType"
        || mname == "GetMethodParamCount" || mname == "IsMethodStatic"
        || mname == "GetMethodCustomAttributes" || mname == "GetMethodAttrs") {
            ExprVal idxVal = e.kids.Count > 0 ? GenExpr(e.kids[0]) : new ExprVal("0", MkType("int"));
            string idx64 = ToI64(idxVal);
            int lcheck = NL();
            int lload = NL();
            int lempty = NL();
            int ldone = NL();
            string isNull = NT();
            L("  " + isNull + " = icmp eq i8* " + recv.op + ", null");
            L("  br i1 " + isNull + ", label %L" + lempty + ", label %L" + lcheck);
            Label(lcheck);
            string mcp = NT();
            L("  " + mcp + " = getelementptr inbounds i8, i8* " + recv.op + ", i64 -80");
            string mcp_p = NT();
            L("  " + mcp_p + " = bitcast i8* " + mcp + " to i64*");
            string mcnt = NT();
            L("  " + mcnt + " = load i64, i64* " + mcp_p);
            string mp = NT();
            L("  " + mp + " = getelementptr inbounds i8, i8* " + recv.op + ", i64 -88");
            string mp_ptr = NT();
            L("  " + mp_ptr + " = bitcast i8* " + mp + " to i8**");
            string mbase = NT();
            L("  " + mbase + " = load i8*, i8** " + mp_ptr);
            string inBounds = NT();
            L("  " + inBounds + " = icmp ult i64 " + idx64 + ", " + mcnt);
            string hasBase = NT();
            L("  " + hasBase + " = icmp ne i8* " + mbase + ", null");
            string ok = NT();
            L("  " + ok + " = and i1 " + inBounds + ", " + hasBase);
            L("  br i1 " + ok + ", label %L" + lload + ", label %L" + lempty);
            Label(lload);
            string mo = NT();
            L("  " + mo + " = mul i64 " + idx64 + ", 72");
            string m_slot = NT();
            L("  " + m_slot + " = getelementptr inbounds i8, i8* " + mbase + ", i64 " + mo);

            if (mname == "GetMethodParamCount" || mname == "IsMethodStatic") {
                string iv = NT();
                if (mname == "GetMethodParamCount") {
                    string pc_gep = NT();
                    L("  " + pc_gep + " = getelementptr inbounds i8, i8* " + m_slot + ", i64 24");
                    string pc_p = NT();
                    L("  " + pc_p + " = bitcast i8* " + pc_gep + " to i64*");
                    L("  " + iv + " = load i64, i64* " + pc_p);
                } else {
                    string fl_gep = NT();
                    L("  " + fl_gep + " = getelementptr inbounds i8, i8* " + m_slot + ", i64 48");
                    string fl_p = NT();
                    L("  " + fl_p + " = bitcast i8* " + fl_gep + " to i64*");
                    string fl = NT();
                    L("  " + fl + " = load i64, i64* " + fl_p);
                    string isSt = NT();
                    L("  " + isSt + " = and i64 " + fl + ", 1");
                    string cmp = NT();
                    L("  " + cmp + " = icmp ne i64 " + isSt + ", 0");
                    L("  " + iv + " = zext i1 " + cmp + " to i64");
                }
                L("  br label %L" + ldone);
                Label(lempty);
                L("  br label %L" + ldone);
                Label(ldone);
                string resI = NT();
                L("  " + resI + " = phi i64 [ " + iv + ", %L" + lload + " ], [ 0, %L" + lempty + " ]");
                return new ExprVal(resI, MkType(mname == "IsMethodStatic" ? "bool" : "int"));
            }
            string loaded = NT();
            if (mname == "GetMethodName") {
                string nm_p = NT();
                L("  " + nm_p + " = bitcast i8* " + m_slot + " to i8**");
                L("  " + loaded + " = load i8*, i8** " + nm_p);
            } else if (mname == "GetMethodReturnType") {
                string rt_gep = NT();
                L("  " + rt_gep + " = getelementptr inbounds i8, i8* " + m_slot + ", i64 8");
                string rt_p = NT();
                L("  " + rt_p + " = bitcast i8* " + rt_gep + " to i8**");
                L("  " + loaded + " = load i8*, i8** " + rt_p);
            } else {
                string ma_gep = NT();
                L("  " + ma_gep + " = getelementptr inbounds i8, i8* " + m_slot + ", i64 56");
                string ma_p = NT();
                L("  " + ma_p + " = bitcast i8* " + ma_gep + " to i8**");
                L("  " + loaded + " = load i8*, i8** " + ma_p);
            }
            L("  br label %L" + ldone);
            Label(lempty);
            L("  br label %L" + ldone);
            Label(ldone);
            string resS = NT();
            L("  " + resS + " = phi i8* [ " + loaded + ", %L" + lload + " ], [ " + GenConstStr("") + ", %L" + lempty + " ]");
            return new ExprVal(resS, MkType("string"));
        }
        if (mname == "GetMethodParamType") {
            ExprVal idxVal = e.kids.Count > 0 ? GenExpr(e.kids[0]) : new ExprVal("0", MkType("int"));
            ExprVal pidxVal = e.kids.Count > 1 ? GenExpr(e.kids[1]) : new ExprVal("0", MkType("int"));
            string idx64 = ToI64(idxVal);
            string pidx64 = ToI64(pidxVal);
            int lcheck = NL();
            int lslot = NL();
            int lload = NL();
            int lempty = NL();
            int ldone = NL();
            string isNull = NT();
            L("  " + isNull + " = icmp eq i8* " + recv.op + ", null");
            L("  br i1 " + isNull + ", label %L" + lempty + ", label %L" + lcheck);
            Label(lcheck);
            string mcp = NT();
            L("  " + mcp + " = getelementptr inbounds i8, i8* " + recv.op + ", i64 -80");
            string mcp_p = NT();
            L("  " + mcp_p + " = bitcast i8* " + mcp + " to i64*");
            string mcnt = NT();
            L("  " + mcnt + " = load i64, i64* " + mcp_p);
            string mp = NT();
            L("  " + mp + " = getelementptr inbounds i8, i8* " + recv.op + ", i64 -88");
            string mp_ptr = NT();
            L("  " + mp_ptr + " = bitcast i8* " + mp + " to i8**");
            string mbase = NT();
            L("  " + mbase + " = load i8*, i8** " + mp_ptr);
            string mInB = NT();
            L("  " + mInB + " = icmp ult i64 " + idx64 + ", " + mcnt);
            string hasBase = NT();
            L("  " + hasBase + " = icmp ne i8* " + mbase + ", null");
            string ok1 = NT();
            L("  " + ok1 + " = and i1 " + mInB + ", " + hasBase);
            L("  br i1 " + ok1 + ", label %L" + lslot + ", label %L" + lempty);
            Label(lslot);
            string mo = NT();
            L("  " + mo + " = mul i64 " + idx64 + ", 72");
            string m_slot = NT();
            L("  " + m_slot + " = getelementptr inbounds i8, i8* " + mbase + ", i64 " + mo);
            string pc_gep = NT();
            L("  " + pc_gep + " = getelementptr inbounds i8, i8* " + m_slot + ", i64 24");
            string pc_p = NT();
            L("  " + pc_p + " = bitcast i8* " + pc_gep + " to i64*");
            string pcnt = NT();
            L("  " + pcnt + " = load i64, i64* " + pc_p);
            string pt_gep = NT();
            L("  " + pt_gep + " = getelementptr inbounds i8, i8* " + m_slot + ", i64 32");
            string pt_ptr = NT();
            L("  " + pt_ptr + " = bitcast i8* " + pt_gep + " to i8***");
            string pt_arr = NT();
            L("  " + pt_arr + " = load i8**, i8*** " + pt_ptr);
            string pInB = NT();
            L("  " + pInB + " = icmp ult i64 " + pidx64 + ", " + pcnt);
            string hasPt = NT();
            L("  " + hasPt + " = icmp ne i8** " + pt_arr + ", null");
            string ok2 = NT();
            L("  " + ok2 + " = and i1 " + pInB + ", " + hasPt);
            L("  br i1 " + ok2 + ", label %L" + lload + ", label %L" + lempty);
            Label(lload);
            string item_p = NT();
            L("  " + item_p + " = getelementptr inbounds i8*, i8** " + pt_arr + ", i64 " + pidx64);
            string item = NT();
            L("  " + item + " = load i8*, i8** " + item_p);
            L("  br label %L" + ldone);
            Label(lempty);
            L("  br label %L" + ldone);
            Label(ldone);
            string resPt = NT();
            L("  " + resPt + " = phi i8* [ " + item + ", %L" + lload + " ], [ " + GenConstStr("") + ", %L" + lempty + " ]");
            return new ExprVal(resPt, MkType("string"));
        }
        if (mname == "HasMethod") {
            ExprVal nmVal = e.kids.Count > 0 ? GenExpr(e.kids[0]) : new ExprVal("null", MkType("string"));
            string mp = NT();
            L("  " + mp + " = getelementptr inbounds i8, i8* " + recv.op + ", i64 -88");
            string mp_ptr = NT();
            L("  " + mp_ptr + " = bitcast i8* " + mp + " to i8**");
            string mbase = NT();
            L("  " + mbase + " = load i8*, i8** " + mp_ptr);
            string mcp = NT();
            L("  " + mcp + " = getelementptr inbounds i8, i8* " + recv.op + ", i64 -80");
            string mcp_i64 = NT();
            L("  " + mcp_i64 + " = bitcast i8* " + mcp + " to i64*");
            string mcnt = NT();
            L("  " + mcnt + " = load i64, i64* " + mcp_i64);

            int headLbl = NL();
            int bodyLbl = NL();
            int stepLbl = NL();
            int matchLbl = NL();
            int endLbl = NL();
            string idxSlot = NT();
            L("  " + idxSlot + " = alloca i64");
            L("  store i64 0, i64* " + idxSlot);
            L("  br label %L" + headLbl);
            Label(headLbl);
            string curIdx = NT();
            L("  " + curIdx + " = load i64, i64* " + idxSlot);
            string cond = NT();
            L("  " + cond + " = icmp slt i64 " + curIdx + ", " + mcnt);
            L("  br i1 " + cond + ", label %L" + bodyLbl + ", label %L" + endLbl);
            Label(bodyLbl);
            string curOff = NT();
            L("  " + curOff + " = mul i64 " + curIdx + ", 72");
            string slotP = NT();
            L("  " + slotP + " = getelementptr inbounds i8, i8* " + mbase + ", i64 " + curOff);
            string mnP = NT();
            L("  " + mnP + " = bitcast i8* " + slotP + " to i8**");
            string curMethName = NT();
            L("  " + curMethName + " = load i8*, i8** " + mnP);
            string eq = NT();
            L("  " + eq + " = call i32 @strcmp(i8* " + curMethName + ", i8* " + nmVal.op + ")");
            string isMatch = NT();
            L("  " + isMatch + " = icmp eq i32 " + eq + ", 0");
            L("  br i1 " + isMatch + ", label %L" + matchLbl + ", label %L" + stepLbl);
            Label(stepLbl);
            string nextIdx = NT();
            L("  " + nextIdx + " = add i64 " + curIdx + ", 1");
            L("  store i64 " + nextIdx + ", i64* " + idxSlot);
            L("  br label %L" + headLbl);
            Label(matchLbl);
            L("  br label %L" + endLbl);
            Label(endLbl);
            string phi = NT();
            L("  " + phi + " = phi i1 [ 1, %L" + matchLbl + " ], [ 0, %L" + headLbl + " ]");
            string z = NT();
            L("  " + z + " = zext i1 " + phi + " to i64");
            return new ExprVal(z, MkType("bool"));
        }
        if (mname == "GetCtorParamCount") {
            ExprVal idxVal = e.kids.Count > 0 ? GenExpr(e.kids[0]) : new ExprVal("0", MkType("int"));
            string idx64 = ToI64(idxVal);
            int lcheck = NL();
            int lload = NL();
            int lempty = NL();
            int ldone = NL();
            string isNull = NT();
            L("  " + isNull + " = icmp eq i8* " + recv.op + ", null");
            L("  br i1 " + isNull + ", label %L" + lempty + ", label %L" + lcheck);
            Label(lcheck);
            string ccp = NT();
            L("  " + ccp + " = getelementptr inbounds i8, i8* " + recv.op + ", i64 -64");
            string ccp_p = NT();
            L("  " + ccp_p + " = bitcast i8* " + ccp + " to i64*");
            string ccnt = NT();
            L("  " + ccnt + " = load i64, i64* " + ccp_p);
            string cp = NT();
            L("  " + cp + " = getelementptr inbounds i8, i8* " + recv.op + ", i64 -72");
            string cp_ptr = NT();
            L("  " + cp_ptr + " = bitcast i8* " + cp + " to i8**");
            string cbase = NT();
            L("  " + cbase + " = load i8*, i8** " + cp_ptr);
            string inB = NT();
            L("  " + inB + " = icmp ult i64 " + idx64 + ", " + ccnt);
            string hasB = NT();
            L("  " + hasB + " = icmp ne i8* " + cbase + ", null");
            string ok = NT();
            L("  " + ok + " = and i1 " + inB + ", " + hasB);
            L("  br i1 " + ok + ", label %L" + lload + ", label %L" + lempty);
            Label(lload);
            string co = NT();
            L("  " + co + " = mul i64 " + idx64 + ", 56");
            string c_slot = NT();
            L("  " + c_slot + " = getelementptr inbounds i8, i8* " + cbase + ", i64 " + co);
            string pc_gep = NT();
            L("  " + pc_gep + " = getelementptr inbounds i8, i8* " + c_slot + ", i64 24");
            string pc_p = NT();
            L("  " + pc_p + " = bitcast i8* " + pc_gep + " to i64*");
            string pc = NT();
            L("  " + pc + " = load i64, i64* " + pc_p);
            L("  br label %L" + ldone);
            Label(lempty);
            L("  br label %L" + ldone);
            Label(ldone);
            string resPc = NT();
            L("  " + resPc + " = phi i64 [ " + pc + ", %L" + lload + " ], [ 0, %L" + lempty + " ]");
            return new ExprVal(resPc, MkType("int"));
        }
        if (mname == "GetCtorParamType") {
            ExprVal idxVal = e.kids.Count > 0 ? GenExpr(e.kids[0]) : new ExprVal("0", MkType("int"));
            ExprVal pidxVal = e.kids.Count > 1 ? GenExpr(e.kids[1]) : new ExprVal("0", MkType("int"));
            string idx64 = ToI64(idxVal);
            string pidx64 = ToI64(pidxVal);
            int lcheck = NL();
            int lslot = NL();
            int lload = NL();
            int lempty = NL();
            int ldone = NL();
            string isNull = NT();
            L("  " + isNull + " = icmp eq i8* " + recv.op + ", null");
            L("  br i1 " + isNull + ", label %L" + lempty + ", label %L" + lcheck);
            Label(lcheck);
            string ccp = NT();
            L("  " + ccp + " = getelementptr inbounds i8, i8* " + recv.op + ", i64 -64");
            string ccp_p = NT();
            L("  " + ccp_p + " = bitcast i8* " + ccp + " to i64*");
            string ccnt = NT();
            L("  " + ccnt + " = load i64, i64* " + ccp_p);
            string cp = NT();
            L("  " + cp + " = getelementptr inbounds i8, i8* " + recv.op + ", i64 -72");
            string cp_ptr = NT();
            L("  " + cp_ptr + " = bitcast i8* " + cp + " to i8**");
            string cbase = NT();
            L("  " + cbase + " = load i8*, i8** " + cp_ptr);
            string cInB = NT();
            L("  " + cInB + " = icmp ult i64 " + idx64 + ", " + ccnt);
            string hasB = NT();
            L("  " + hasB + " = icmp ne i8* " + cbase + ", null");
            string ok1 = NT();
            L("  " + ok1 + " = and i1 " + cInB + ", " + hasB);
            L("  br i1 " + ok1 + ", label %L" + lslot + ", label %L" + lempty);
            Label(lslot);
            string co = NT();
            L("  " + co + " = mul i64 " + idx64 + ", 56");
            string c_slot = NT();
            L("  " + c_slot + " = getelementptr inbounds i8, i8* " + cbase + ", i64 " + co);
            string pc_gep = NT();
            L("  " + pc_gep + " = getelementptr inbounds i8, i8* " + c_slot + ", i64 24");
            string pc_p = NT();
            L("  " + pc_p + " = bitcast i8* " + pc_gep + " to i64*");
            string pcnt = NT();
            L("  " + pcnt + " = load i64, i64* " + pc_p);
            string pt_gep = NT();
            L("  " + pt_gep + " = getelementptr inbounds i8, i8* " + c_slot + ", i64 32");
            string pt_ptr = NT();
            L("  " + pt_ptr + " = bitcast i8* " + pt_gep + " to i8***");
            string pt_arr = NT();
            L("  " + pt_arr + " = load i8**, i8*** " + pt_ptr);
            string pInB = NT();
            L("  " + pInB + " = icmp ult i64 " + pidx64 + ", " + pcnt);
            string hasPt = NT();
            L("  " + hasPt + " = icmp ne i8** " + pt_arr + ", null");
            string ok2 = NT();
            L("  " + ok2 + " = and i1 " + pInB + ", " + hasPt);
            L("  br i1 " + ok2 + ", label %L" + lload + ", label %L" + lempty);
            Label(lload);
            string item_p = NT();
            L("  " + item_p + " = getelementptr inbounds i8*, i8** " + pt_arr + ", i64 " + pidx64);
            string item = NT();
            L("  " + item + " = load i8*, i8** " + item_p);
            L("  br label %L" + ldone);
            Label(lempty);
            L("  br label %L" + ldone);
            Label(ldone);
            string resPt = NT();
            L("  " + resPt + " = phi i8* [ " + item + ", %L" + lload + " ], [ " + GenConstStr("") + ", %L" + lempty + " ]");
            return new ExprVal(resPt, MkType("string"));
        }
        if (mname == "GetStaticFieldInt" || mname == "GetStaticFieldLong"
        || mname == "GetStaticFieldDouble" || mname == "GetStaticFieldBool"
        || mname == "GetStaticFieldString" || mname == "GetStaticFieldObject"
        || mname == "SetStaticFieldInt" || mname == "SetStaticFieldLong"
        || mname == "SetStaticFieldDouble" || mname == "SetStaticFieldBool"
        || mname == "SetStaticFieldString" || mname == "SetStaticFieldObject") {
            return EmitTypeInfoStaticField(recv, mname, e);
        }
        if (mname == "InvokeStatic" || mname == "InvokeStaticInt" || mname == "InvokeStaticLong"
        || mname == "InvokeStaticDouble" || mname == "InvokeStaticString"
        || mname == "InvokeStaticObject" || mname == "InvokeStaticTask") {
            return EmitTypeInfoStaticInvoke(recv, mname, e);
        }
        diags.Error("TypeInfo method '" + mname + "' is not supported by the self-hosted compiler yet", e.line, e.col);
        return new ExprVal("null", MkType("object"));
    }

    // Unbox a Nullable<prim/decimal> (i8* box pointer) into either double or i64 (0 / 0.0 when null).
    string EmitUnboxNullableNumber(ExprVal value, bool floating, Node call) {
        string ult = UnderLL(value.ty);
        string rt = floating ? "double" : "i64";
        string zval = floating ? "0.0" : "0";
        string slot = NT();
        L("  " + slot + " = alloca " + rt);
        L("  store " + rt + " " + zval + ", " + rt + "* " + slot);
        int lread = NL();
        int ldone = NL();
        string isNn = NT();
        L("  " + isNn + " = icmp ne i8* " + value.op + ", null");
        L("  br i1 " + isNn + ", label %L" + lread + ", label %L" + ldone);
        Label(lread);
        string bp = NT();
        L("  " + bp + " = bitcast i8* " + value.op + " to " + ult + "*");
        string raw = NT();
        L("  " + raw + " = load " + ult + ", " + ult + "* " + bp);
        if (ult == DecimalLL()) {
            string num = DecimalNumber(new ExprVal(raw, MkType("decimal")), floating);
            L("  store " + rt + " " + num + ", " + rt + "* " + slot);
        } else if (ult == "double") {
            if (floating) {
                L("  store double " + raw + ", double* " + slot);
            } else {
                L("  store i64 " + EmitFptosiGuarded(call, raw) + ", i64* " + slot);
            }
        } else {
            if (floating) {
                string dv = NT();
                L("  " + dv + " = sitofp i64 " + raw + " to double");
                L("  store double " + dv + ", double* " + slot);
            } else {
                L("  store i64 " + raw + ", i64* " + slot);
            }
        }
        L("  br label %L" + ldone);
        Label(ldone);
        string outv = NT();
        L("  " + outv + " = load " + rt + ", " + rt + "* " + slot);
        return outv;
    }

    void CollectStaticFieldsOf(Node cls, string filterName, List<Node> outFields) {
        Node c = cls;
        List<string> seen = new List<string>();
        while (c != null) {
            int i = 0;
            while (i < c.kids.Count) {
                Node m = c.kids[i];
                if (m.kind == AK.FieldDecl() && HasMod(m, MOD.Static())
                    && (filterName == "" || m.sval == filterName)
                    && IndexOfStr(seen, m.sval) < 0) {
                    seen.Add(m.sval);
                    outFields.Add(m);
                }
                i = i + 1;
            }
            c = BaseClassOf(c);
        }
    }

    void CollectStaticMethodsOf(Node cls, string filterName, Node invCall, string mname, List<Node> outMethods) {
        Node c = cls;
        while (c != null) {
            int i = 0;
            while (i < c.kids.Count) {
                Node m = c.kids[i];
                if (m.kind == AK.MethodDecl() && HasMod(m, MOD.Static())
                    && (filterName == "" || m.sval == filterName)
                    && MethodAcceptsCall(cls, m, invCall)
                    && (mname != "InvokeStaticTask" || HasMod(m, MOD.Async()))) {
                    outMethods.Add(m);
                }
                i = i + 1;
            }
            c = BaseClassOf(c);
        }
    }

    ExprVal EmitTypeInfoStaticField(ExprVal recv, string mname, Node e) {
        bool isSet = mname.StartsWith("SetStaticField");
        string fldName = e.kids.Count > 0 && e.kids[0].kind == AK.StringLit() ? e.kids[0].sval : "";
        ExprVal nmVal = e.kids.Count > 0 ? GenExpr(e.kids[0]) : new ExprVal("null", MkType("string"));
        string nmPtr = Coerce(nmVal, "i8*");
        ExprVal valArg = (isSet && e.kids.Count > 1) ? GenExpr(e.kids[1]) : new ExprVal("0", MkType("int"));

        string retTyLL = "i64";
        string dfltVal = "0";
        if (mname == "GetStaticFieldDouble") { retTyLL = "double"; dfltVal = "0.0"; }
        else if (mname == "GetStaticFieldString") { retTyLL = "i8*"; dfltVal = GenStr("").op; }
        else if (mname == "GetStaticFieldObject") { retTyLL = "i8*"; dfltVal = "null"; }

        string resSlot = NT();
        L("  " + resSlot + " = alloca " + retTyLL);
        L("  store " + retTyLL + " " + dfltVal + ", " + retTyLL + "* " + resSlot);

        int lend = NL();
        int lstart = NL();
        string tiNn = NT();
        L("  " + tiNn + " = icmp ne i8* " + recv.op + ", null");
        string nmNn = NT();
        L("  " + nmNn + " = icmp ne i8* " + nmPtr + ", null");
        string bothNn = NT();
        L("  " + bothNn + " = and i1 " + tiNn + ", " + nmNn);
        L("  br i1 " + bothNn + ", label %L" + lstart + ", label %L" + lend);
        Label(lstart);

        int ci = 0;
        while (ci < tidNames.Count) {
            string cn = tidNames[ci];
            Node cls = binder.FindType(cn);
            if (cls != null && (cls.kind == AK.ClassDecl() || cls.kind == AK.StructDecl()) && TParams(cls).Count == 0) {
                List<Node> sfs = new List<Node>();
                CollectStaticFieldsOf(cls, fldName, sfs);
                if (sfs.Count > 0) {
                    int lcmatch = NL();
                    int lcnext = NL();
                    string cnStr = GenStr(cn).op;
                    string eq = NT();
                    L("  " + eq + " = call i32 @strcmp(i8* " + recv.op + ", i8* " + cnStr + ")");
                    string isEq = NT();
                    L("  " + isEq + " = icmp eq i32 " + eq + ", 0");
                    L("  br i1 " + isEq + ", label %L" + lcmatch + ", label %L" + lcnext);
                    Label(lcmatch);
                    int sfi = 0;
                    while (sfi < sfs.Count) {
                        Node sf = sfs[sfi];
                        int lfmatch = NL();
                        int lfnext = NL();
                        if (fldName != "") {
                            L("  br label %L" + lfmatch);
                        } else {
                            string flit = RawCString(sf.sval);
                            string feq = NT();
                            L("  " + feq + " = call i32 @strcmp(i8* " + nmPtr + ", i8* " + flit + ")");
                            string isFeq = NT();
                            L("  " + isFeq + " = icmp eq i32 " + feq + ", 0");
                            L("  br i1 " + isFeq + ", label %L" + lfmatch + ", label %L" + lfnext);
                        }
                        Label(lfmatch);
                        List<string> sTemps = stmtTemps;
                        List<string> sVals = stmtTempValues;
                        List<string> sOwners = stmtTempOwners;
                        List<Node> sTypes = stmtTempTypes;
                        List<List<string>> sArm = callArmStack;
                        List<Dictionary<string, bool>> sArmSets = callArmSets;
                        List<List<string>> sArmPend = callArmPending;
                        List<StringBuilder> sArmFn = callArmFn;
                        bool sHasPend = hasPendingCallArm;
                        stmtTemps = new List<string>();
                        stmtTempValues = new List<string>();
                        stmtTempOwners = new List<string>();
                        stmtTempTypes = new List<Node>();
                        callArmStack = null;
                        callArmSets = null;
                        callArmPending = null;
                        callArmFn = null;
                        hasPendingCallArm = false;
                        EnterCallArm();

                        Node fty = sf.type;
                        if (!isSet) {
                            ExprVal fv = LoadStaticField(cls, sf.sval, null);
                            if (mname == "GetStaticFieldString") {
                                if (IsStr(fv.ty)) {
                                    string sp = Coerce(fv, "i8*");
                                    EmitArcRetain(sp, MkType("string"));
                                    L("  store i8* " + sp + ", i8** " + resSlot);
                                }
                            } else if (mname == "GetStaticFieldObject") {
                                if (IsStructTy(fv.ty) && !IsExplicitLayoutStruct(fv.ty)) {
                                    ExprVal cp = CopyStructValue(fv);
                                    L("  store i8* " + Coerce(cp, "i8*") + ", i8** " + resSlot);
                                } else if (IsNullableStruct(fv.ty) && !IsExplicitLayoutStruct(fv.ty)) {
                                    string cloneSym = EnsureStructCloneHelper(binder.FindType(fv.ty.sval));
                                    string rawFv = Coerce(fv, "i8*");
                                    string cloned = NT();
                                    L("  " + cloned + " = call i8* " + cloneSym + "(i8* " + rawFv + ")");
                                    L("  store i8* " + cloned + ", i8** " + resSlot);
                                } else if (fv.ty != null && (IsPtrLL(MapType(fv.ty)) || IsStr(fv.ty))) {
                                    string sp = Coerce(fv, "i8*");
                                    EmitArcRetainObject(sp);
                                    L("  store i8* " + sp + ", i8** " + resSlot);
                                }
                            } else if (mname == "GetStaticFieldDouble") {
                                if (IsDecimal(fv.ty)) {
                                    L("  store double " + DecimalNumber(fv, true) + ", double* " + resSlot);
                                } else if (IsNullableValue(fv.ty)) {
                                    L("  store double " + EmitUnboxNullableNumber(fv, true, e) + ", double* " + resSlot);
                                } else {
                                    string ft = MapType(fv.ty);
                                    if (ft == "double" || ft == "float" || ft == "i1" || ft == "i8" || ft == "i16" || ft == "i32" || ft == "i64") {
                                        L("  store double " + Coerce(fv, "double") + ", double* " + resSlot);
                                    }
                                }
                            } else {
                                string iv = "0";
                                if (IsDecimal(fv.ty)) {
                                    iv = DecimalNumber(fv, false);
                                } else if (IsNullableValue(fv.ty)) {
                                    iv = EmitUnboxNullableNumber(fv, false, e);
                                } else {
                                    string ft = MapType(fv.ty);
                                    if (ft == "double" || ft == "float") {
                                        string dv = fv.op;
                                        if (ft == "float") { dv = NT(); L("  " + dv + " = fpext float " + fv.op + " to double"); }
                                        iv = EmitFptosiGuarded(e, dv);
                                    } else if (ft == "i1" || ft == "i8" || ft == "i16" || ft == "i32" || ft == "i64") {
                                        iv = ToI64(fv);
                                    }
                                }
                                if (mname == "GetStaticFieldBool") {
                                    string nz = NT(); L("  " + nz + " = icmp ne i64 " + iv + ", 0");
                                    string bz = NT(); L("  " + bz + " = zext i1 " + nz + " to i64");
                                    L("  store i64 " + bz + ", i64* " + resSlot);
                                } else {
                                    L("  store i64 " + iv + ", i64* " + resSlot);
                                }
                            }
                        } else {
                            // SetStaticField*
                            string ft = MapType(fty);
                            if (IsStructTy(fty) && !IsExplicitLayoutStruct(fty)) {
                                if (mname == "SetStaticFieldObject" && !IsDecimal(valArg.ty) && !IsNullableValue(valArg.ty)
                                    && (valArg.ty == null || IsPtrLL(MapType(valArg.ty)))) {
                                    string vraw = Coerce(valArg, "i8*");
                                    string nn = NT(); L("  " + nn + " = icmp ne i8* " + vraw + ", null");
                                    int lchk = NL(); int lcopy = NL(); int lskip = NL();
                                    L("  br i1 " + nn + ", label %L" + lchk + ", label %L" + lskip);
                                    Label(lchk);
                                    string ok = EmitClassIdTest(new ExprVal(vraw, MkType("object")), fty.sval);
                                    L("  br i1 " + ok + ", label %L" + lcopy + ", label %L" + lskip);
                                    Label(lcopy);
                                    string typed = NT(); L("  " + typed + " = bitcast i8* " + vraw + " to " + ft);
                                    ExprVal cp = StructCopyTemp(new ExprVal(typed, fty), fty);
                                    StoreStaticField(cls, sf.sval, cp, null);
                                    L("  store i64 1, i64* " + resSlot);
                                    L("  br label %L" + lskip);
                                    Label(lskip);
                                }
                            } else if (IsNullableStruct(fty) && !IsExplicitLayoutStruct(fty)) {
                                if (mname == "SetStaticFieldObject" && !IsDecimal(valArg.ty) && !IsNullableValue(valArg.ty)
                                    && (valArg.ty == null || IsPtrLL(MapType(valArg.ty)))) {
                                    string vraw = Coerce(valArg, "i8*");
                                    string isNil = NT(); L("  " + isNil + " = icmp eq i8* " + vraw + ", null");
                                    int lnil = NL(); int lchk = NL(); int lcopy = NL(); int lskip = NL();
                                    L("  br i1 " + isNil + ", label %L" + lnil + ", label %L" + lchk);
                                    Label(lnil);
                                    StoreStaticField(cls, sf.sval, new ExprVal("null", fty), null);
                                    L("  store i64 1, i64* " + resSlot);
                                    L("  br label %L" + lskip);
                                    Label(lchk);
                                    string ok = EmitClassIdTest(new ExprVal(vraw, MkType("object")), fty.sval);
                                    L("  br i1 " + ok + ", label %L" + lcopy + ", label %L" + lskip);
                                    Label(lcopy);
                                    string typed = NT(); L("  " + typed + " = bitcast i8* " + vraw + " to " + ft);
                                    ExprVal cp = StructCopyTemp(new ExprVal(typed, MkType(fty.sval)), fty);
                                    StoreStaticField(cls, sf.sval, new ExprVal(cp.op, fty), null);
                                    L("  store i64 1, i64* " + resSlot);
                                    L("  br label %L" + lskip);
                                    Label(lskip);
                                }
                            } else if (IsDecimal(fty)) {
                                if (IsDecimal(valArg.ty) || mname == "SetStaticFieldDouble" || mname == "SetStaticFieldInt" || mname == "SetStaticFieldLong") {
                                    StoreStaticField(cls, sf.sval, ToDecimal(valArg), null);
                                    L("  store i64 1, i64* " + resSlot);
                                }
                            } else if (IsNullableValue(fty)) {
                                string ult = UnderLL(fty);
                                if (mname == "SetStaticFieldObject") {
                                    if (valArg.op == "null") {
                                        StoreStaticField(cls, sf.sval, new ExprVal("null", fty), null);
                                        L("  store i64 1, i64* " + resSlot);
                                    } else if (IsNullableValue(valArg.ty) && UnderLL(valArg.ty) == ult) {
                                        StoreStaticField(cls, sf.sval, valArg, null);
                                        L("  store i64 1, i64* " + resSlot);
                                    } else if (IsDecimal(valArg.ty) && ult == DecimalLL()) {
                                        StoreStaticField(cls, sf.sval, valArg, null);
                                        L("  store i64 1, i64* " + resSlot);
                                    } else if (valArg.ty != null && IsPtrLL(MapType(valArg.ty))) {
                                        string vraw = Coerce(valArg, "i8*");
                                        string isNil = NT(); L("  " + isNil + " = icmp eq i8* " + vraw + ", null");
                                        int lnil = NL(); int lskip = NL();
                                        L("  br i1 " + isNil + ", label %L" + lnil + ", label %L" + lskip);
                                        Label(lnil);
                                        StoreStaticField(cls, sf.sval, new ExprVal("null", fty), null);
                                        L("  store i64 1, i64* " + resSlot);
                                        L("  br label %L" + lskip);
                                        Label(lskip);
                                    }
                                } else if (ult == DecimalLL() && (mname == "SetStaticFieldDouble" || mname == "SetStaticFieldInt" || mname == "SetStaticFieldLong")) {
                                    StoreStaticField(cls, sf.sval, ToDecimal(valArg), null);
                                    L("  store i64 1, i64* " + resSlot);
                                } else if (ult == "double" && (mname == "SetStaticFieldDouble" || mname == "SetStaticFieldInt" || mname == "SetStaticFieldLong")) {
                                    StoreStaticField(cls, sf.sval, new ExprVal(Coerce(valArg, "double"), MkType("double")), null);
                                    L("  store i64 1, i64* " + resSlot);
                                } else if (ult == "i64" && (mname == "SetStaticFieldInt" || mname == "SetStaticFieldLong" || mname == "SetStaticFieldBool")) {
                                    StoreStaticField(cls, sf.sval, new ExprVal(ToI64(valArg), MkType("long")), null);
                                    L("  store i64 1, i64* " + resSlot);
                                }
                            } else if ((mname == "SetStaticFieldString" && (IsStr(fty) || fty.sval == "object"))
                                || (mname == "SetStaticFieldObject" && IsPtrLL(ft) && !IsDecimal(valArg.ty))) {
                                StoreStaticField(cls, sf.sval, valArg, null);
                                L("  store i64 1, i64* " + resSlot);
                            } else if (mname == "SetStaticFieldDouble" && (ft == "double" || ft == "float")) {
                                StoreStaticField(cls, sf.sval, valArg, null);
                                L("  store i64 1, i64* " + resSlot);
                            } else if ((mname == "SetStaticFieldInt" || mname == "SetStaticFieldLong" || mname == "SetStaticFieldBool")
                                && (ft == "i1" || ft == "i8" || ft == "i16" || ft == "i32" || ft == "i64")) {
                                StoreStaticField(cls, sf.sval, valArg, null);
                                L("  store i64 1, i64* " + resSlot);
                            }
                        }

                        LeaveCallArm();
                        EmitTempReleases();
                        stmtTemps = sTemps;
                        stmtTempValues = sVals;
                        stmtTempOwners = sOwners;
                        stmtTempTypes = sTypes;
                        callArmStack = sArm;
                        callArmSets = sArmSets;
                        callArmPending = sArmPend;
                        callArmFn = sArmFn;
                        hasPendingCallArm = sHasPend;
                        L("  br label %L" + lend);
                        Label(lfnext);
                        sfi = sfi + 1;
                    }
                    L("  br label %L" + lend);
                    Label(lcnext);
                }
            }
            ci = ci + 1;
        }
        L("  br label %L" + lend);
        Label(lend);
        string retVal = NT();
        L("  " + retVal + " = load " + retTyLL + ", " + retTyLL + "* " + resSlot);
        if (isSet || mname == "GetStaticFieldBool") { return new ExprVal(retVal, MkType("bool")); }
        if (mname == "GetStaticFieldInt") { return new ExprVal(retVal, MkType("int")); }
        if (mname == "GetStaticFieldLong") { return new ExprVal(retVal, MkType("long")); }
        if (mname == "GetStaticFieldDouble") { return new ExprVal(retVal, MkType("double")); }
        Node resTy = MkType(mname == "GetStaticFieldString" ? "string" : "object");
        AddTemp(retVal, resTy);
        return new ExprVal(retVal, resTy);
    }

    ExprVal EmitTypeInfoStaticInvoke(ExprVal recv, string mname, Node e) {
        string methName = e.kids.Count > 0 && e.kids[0].kind == AK.StringLit() ? e.kids[0].sval : "";
        ExprVal nmVal = e.kids.Count > 0 ? GenExpr(e.kids[0]) : new ExprVal("null", MkType("string"));
        string nmPtr = Coerce(nmVal, "i8*");
        Node invCall = new Node(AK.Call());
        invCall.line = e.line;
        invCall.col = e.col;
        int ki = 1;
        while (ki < e.kids.Count) {
            invCall.Add(e.kids[ki]);
            ki = ki + 1;
        }

        string retTyLL = mname == "InvokeStaticDouble" ? "double"
            : ((mname == "InvokeStaticString" || mname == "InvokeStaticObject") ? "i8*" : "i64");
        string dfltVal = mname == "InvokeStaticDouble" ? "0.0"
            : (mname == "InvokeStaticString" ? GenStr("").op : (mname == "InvokeStaticObject" ? "null" : "0"));
        string resSlot = NT();
        L("  " + resSlot + " = alloca " + retTyLL);
        L("  store " + retTyLL + " " + dfltVal + ", " + retTyLL + "* " + resSlot);

        int lend = NL();
        int lstart = NL();
        string tiNn = NT(); L("  " + tiNn + " = icmp ne i8* " + recv.op + ", null");
        string nmNn = NT(); L("  " + nmNn + " = icmp ne i8* " + nmPtr + ", null");
        string bothNn = NT(); L("  " + bothNn + " = and i1 " + tiNn + ", " + nmNn);
        L("  br i1 " + bothNn + ", label %L" + lstart + ", label %L" + lend);
        Label(lstart);

        int ci = 0;
        while (ci < tidNames.Count) {
            string cn = tidNames[ci];
            Node cls = binder.FindType(cn);
            if (cls != null && (cls.kind == AK.ClassDecl() || cls.kind == AK.StructDecl()) && TParams(cls).Count == 0) {
                List<Node> sms = new List<Node>();
                CollectStaticMethodsOf(cls, methName, invCall, mname, sms);
                if (sms.Count > 0) {
                    int lcmatch = NL();
                    int lcnext = NL();
                    string cnStr = GenStr(cn).op;
                    string eq = NT();
                    L("  " + eq + " = call i32 @strcmp(i8* " + recv.op + ", i8* " + cnStr + ")");
                    string isEq = NT();
                    L("  " + isEq + " = icmp eq i32 " + eq + ", 0");
                    L("  br i1 " + isEq + ", label %L" + lcmatch + ", label %L" + lcnext);
                    Label(lcmatch);
                    int smi = 0;
                    while (smi < sms.Count) {
                        Node sm = sms[smi];
                        int lmmatch = NL();
                        int lmnext = NL();
                        if (methName != "") {
                            L("  br label %L" + lmmatch);
                        } else {
                            string mlit = RawCString(sm.sval);
                            string meq = NT();
                            L("  " + meq + " = call i32 @strcmp(i8* " + nmPtr + ", i8* " + mlit + ")");
                            string isMeq = NT();
                            L("  " + isMeq + " = icmp eq i32 " + meq + ", 0");
                            L("  br i1 " + isMeq + ", label %L" + lmmatch + ", label %L" + lmnext);
                        }
                        Label(lmmatch);
                        List<string> sTemps = stmtTemps;
                        List<string> sVals = stmtTempValues;
                        List<string> sOwners = stmtTempOwners;
                        List<Node> sTypes = stmtTempTypes;
                        List<List<string>> sArm = callArmStack;
                        List<Dictionary<string, bool>> sArmSets = callArmSets;
                        List<List<string>> sArmPend = callArmPending;
                        List<StringBuilder> sArmFn = callArmFn;
                        bool sHasPend = hasPendingCallArm;
                        stmtTemps = new List<string>();
                        stmtTempValues = new List<string>();
                        stmtTempOwners = new List<string>();
                        stmtTempTypes = new List<Node>();
                        callArmStack = null;
                        callArmSets = null;
                        callArmPending = null;
                        callArmFn = null;
                        hasPendingCallArm = false;
                        EnterCallArm();
                        ExprVal cres = EmitStaticCall(cn, sm.sval, invCall);
                        EmitReflectInvokeStore(mname, cres, e, resSlot, retTyLL);
                        LeaveCallArm();
                        EmitTempReleases();
                        stmtTemps = sTemps;
                        stmtTempValues = sVals;
                        stmtTempOwners = sOwners;
                        stmtTempTypes = sTypes;
                        callArmStack = sArm;
                        callArmSets = sArmSets;
                        callArmPending = sArmPend;
                        callArmFn = sArmFn;
                        hasPendingCallArm = sHasPend;
                        L("  br label %L" + lend);
                        Label(lmnext);
                        smi = smi + 1;
                    }
                    L("  br label %L" + lend);
                    Label(lcnext);
                }
            }
            ci = ci + 1;
        }
        L("  br label %L" + lend);
        Label(lend);
        string retVal = NT();
        L("  " + retVal + " = load " + retTyLL + ", " + retTyLL + "* " + resSlot);
        if (mname == "InvokeStatic") { return new ExprVal(retVal, MkType("bool")); }
        if (mname == "InvokeStaticInt") { return new ExprVal(retVal, MkType("int")); }
        if (mname == "InvokeStaticLong" || mname == "InvokeStaticTask") { return new ExprVal(retVal, MkType("long")); }
        if (mname == "InvokeStaticDouble") { return new ExprVal(retVal, MkType("double")); }
        Node resTy = MkType(mname == "InvokeStaticString" ? "string" : "object");
        AddTemp(retVal, resTy);
        return new ExprVal(retVal, resTy);
    }

    Node SubstParamForClass(Node cls, Node m, Node pt) {
        if (cls == null || m == null || pt == null) { return pt; }
        Node cur = MkType(cls.sval);
        int depth = 0;
        while (cur != null && depth < 64) {
            Node c = binder.FindType(cur.sval);
            if (c == null) { break; }
            int i = 0;
            while (i < c.kids.Count) {
                if (c.kids[i] == m) {
                    return binder.SubstOwner(pt, cur);
                }
                i = i + 1;
            }
            cur = binder.BaseType(cur);
            depth = depth + 1;
        }
        return pt;
    }

    bool MethodAcceptsCall(Node ownerCls, Node m, Node invCall) {
        if (m == null || invCall == null) { return false; }
        if (m.kind == AK.MethodDecl() && TParams(m).Count > 0) { return false; }
        int argc = invCall.kids.Count;
        if (!AcceptsArity(m, argc)) { return false; }
        string ownerName = ownerCls != null ? ownerCls.sval : "";
        int i = 0;
        while (i < argc) {
            if (IsRefParam(m, i)) { return false; }
            Node pt = SubstParamForClass(ownerCls, m, ParamTypeNode(m, i));
            Node arg = invCall.kids[i];
            if (pt != null && arg != null) {
                // An open generic argument does not change the outer parameter type.
                bool bareTypeParam = pt.ival == 0 && pt.kids.Count == 0 && MentionsTypeParam(pt);
                if (arg.kind == AK.NullLit() && !bareTypeParam && !IsPtrLL(MapTypeDecl(pt, ownerName))) {
                    return false;
                }
                Node atn = ArgTypeNode(arg);
                if (atn != null && atn.sval != null && atn.sval != "") {
                    // `object` (i8*) cannot implicitly unbox to value types (primitives, enums, value structs).
                    if (atn.sval == "object" && atn.ival == 0 && !bareTypeParam
                        && !IsPtrLL(MapTypeDecl(pt, ownerName))) {
                        return false;
                    }
                    // Array rank mismatch (unless either side is `object` or a bare type param).
                    if (atn.ival != pt.ival && !bareTypeParam
                        && !(pt.sval == "object" && pt.ival == 0)
                        && !(atn.sval == "object" && atn.ival == 0)) {
                        return false;
                    }
                    // Delegate parameter requires a delegate or object argument.
                    if (IsDelegate(pt) && !bareTypeParam && atn.sval != "object" && !IsDelegate(atn)) {
                        return false;
                    }
                    // `string` is a reference type even though binder.IsPrimitive("string") is true:
                    // never match a numeric/bool argument against a string parameter or vice versa.
                    if (atn.ival == 0 && pt.ival == 0 && pt.sval != "object" && atn.sval != "object" && !bareTypeParam
                        && ((atn.sval == "string") != (pt.sval == "string"))) {
                        return false;
                    }
                    if (binder.IsPrimitive(atn.sval) && atn.ival == 0
                        && (pt.ival > 0 || (!binder.IsPrimitive(pt.sval)
                            && pt.sval != "object" && !bareTypeParam))) {
                        return false;
                    }
                    // Custom class cannot convert to primitive
                    if (!binder.IsPrimitive(atn.sval) && binder.IsPrimitive(pt.sval)
                    && atn.sval != "object" && !MentionsTypeParam(pt)) {
                        return false;
                    }
                    // Unrelated concrete classes/structs cannot convert to each other
                    if (!binder.IsPrimitive(atn.sval) && !binder.IsPrimitive(pt.sval)
                        && atn.sval != "object" && pt.sval != "object" && !bareTypeParam
                        && atn.ival == 0 && pt.ival == 0
                        && !binder.IsAssignableFrom(pt.sval, atn.sval)) {
                        return false;
                    }
                }
            }
            i = i + 1;
        }
        return true;
    }

    bool ClassHasMethodWithCall(Node cls, string name, Node invCall) {
        Node c = cls;
        while (c != null) {
            int i = 0;
            while (i < c.kids.Count) {
                Node m = c.kids[i];
                if (m.kind == AK.MethodDecl() && m.sval == name && MethodAcceptsCall(cls, m, invCall)) {
                    return true;
                }
                i = i + 1;
            }
            c = BaseClassOf(c);
        }
        return false;
    }

    string CoerceReflectInvokeNumber(ExprVal value, string member, Node call) {
        bool isDouble = member == "InvokeDouble" || member == "InvokeStaticDouble";
        if (IsDecimal(value.ty)) {
            string dnum = DecimalNumber(value, isDouble);
            return isDouble ? dnum : NarrowReflectInvokeInt(dnum, member);
        }
        if (IsNullableValue(value.ty)) {
            string nnum = EmitUnboxNullableNumber(value, isDouble, call);
            return isDouble ? nnum : NarrowReflectInvokeInt(nnum, member);
        }
        string source = MapType(value.ty);
        if (source == "double") {
            if (isDouble) { return value.op; }
            return NarrowReflectInvokeInt(EmitFptosiGuarded(call, value.op), member);
        }

        // Reflection transports reference results as pointer bits in a numeric slot.
        string slot = "0";
        if (IsPtrLL(source)) { slot = Coerce(value, "i64"); }
        else if (source == "i1") { slot = ToI64(value.op, source); }
        else if (source == "i64" || source == "i32" || source == "i16" || source == "i8") {
            slot = ToI64(value);
        }
        if (isDouble) {
            return Coerce(new ExprVal(slot, MkType("long")), "double");
        }
        return NarrowReflectInvokeInt(slot, member);
    }

    string NarrowReflectInvokeInt(string slot, string member) {
        if ((member != "InvokeInt" && member != "InvokeStaticInt") || slot == "0") { return slot; }
        string narrowed = FromI64(slot, "i32");
        string widened = NT();
        L("  " + widened + " = sext i32 " + narrowed + " to i64");
        return widened;
    }

    void EmitListReflectionCall(string list, string member, string invoke, Node call, string result) {
        if (member == "Count") {
            if (invoke == "Invoke") {
                L("  store i64 1, i64* " + result);
            } else if (invoke == "InvokeInt" || invoke == "InvokeLong" || invoke == "InvokeDouble") {
                string count = NT();
                L("  " + count + " = call i64 @zlist_count(i8* " + list + ")");
                string ll = invoke == "InvokeDouble" ? "double" : "i64";
                string value = CoerceReflectInvokeNumber(new ExprVal(count, MkType("int")), invoke, call);
                L("  store " + ll + " " + value + ", " + ll + "* " + result);
            }
            return;
        }

        ExprVal arg = GenExpr(call.kids[0]);
        if (member == "Add") {
            int source = arg.op == "null" ? 4 : ListReflectionSlotKind(arg.ty);
            if (source == 0 || IsDelegate(arg.ty)) { return; }
            string added = NT();
            string value = arg.op == "null" ? "0" : ToSlot(arg, arg.ty);
            L("  " + added + " = call i64 @zlist_reflection_add(i8* " + list + ", i64 " + value + ", i64 " + source + ")");
            L("  store i64 " + added + ", i64* " + result);
            return;
        }
        if (ListReflectionSlotKind(arg.ty) != 1) { return; }
        string index = ToI64(arg);
        string count = NT();
        string kind = NT();
        string bounds = NT();
        string supported = NT();
        string valid = NT();
        L("  " + count + " = call i64 @zlist_count(i8* " + list + ")");
        L("  " + kind + " = call i64 @zlist_reflection_kind(i8* " + list + ")");
        L("  " + bounds + " = icmp ult i64 " + index + ", " + count);
        if (invoke == "InvokeString") {
            L("  " + supported + " = icmp eq i64 " + kind + ", 3");
        } else if (invoke == "InvokeObject") {
            string is3 = NT(); L("  " + is3 + " = icmp eq i64 " + kind + ", 3");
            string is4 = NT(); L("  " + is4 + " = icmp eq i64 " + kind + ", 4");
            string is5 = NT(); L("  " + is5 + " = icmp eq i64 " + kind + ", 5");
            string is10 = NT(); L("  " + is10 + " = icmp eq i64 " + kind + ", 10");
            string o1 = NT(); L("  " + o1 + " = or i1 " + is3 + ", " + is4);
            string o2 = NT(); L("  " + o2 + " = or i1 " + is5 + ", " + is10);
            L("  " + supported + " = or i1 " + o1 + ", " + o2);
        } else if (invoke == "InvokeDouble") {
            string is2 = NT(); L("  " + is2 + " = icmp eq i64 " + kind + ", 2");
            string is6 = NT(); L("  " + is6 + " = icmp eq i64 " + kind + ", 6");
            string is8 = NT(); L("  " + is8 + " = icmp eq i64 " + kind + ", 8");
            string is9 = NT(); L("  " + is9 + " = icmp eq i64 " + kind + ", 9");
            string o1 = NT(); L("  " + o1 + " = or i1 " + is2 + ", " + is6);
            string o2 = NT(); L("  " + o2 + " = or i1 " + is8 + ", " + is9);
            L("  " + supported + " = or i1 " + o1 + ", " + o2);
        } else if (invoke == "Invoke") {
            L("  " + supported + " = icmp ne i64 " + kind + ", 0");
        } else {
            string is1 = NT(); L("  " + is1 + " = icmp eq i64 " + kind + ", 1");
            string is6 = NT(); L("  " + is6 + " = icmp eq i64 " + kind + ", 6");
            string is7 = NT(); L("  " + is7 + " = icmp eq i64 " + kind + ", 7");
            string o1 = NT(); L("  " + o1 + " = or i1 " + is1 + ", " + is6);
            L("  " + supported + " = or i1 " + o1 + ", " + is7);
        }
        L("  " + valid + " = and i1 " + bounds + ", " + supported);
        int read = NL(); int done = NL();
        L("  br i1 " + valid + ", label %L" + read + ", label %L" + done);
        Label(read);
        if (invoke == "Invoke") {
            L("  store i64 1, i64* " + result);
        } else {
            string bits = NT();
            L("  " + bits + " = call i64 @zlist_get(i8* " + list + ", i64 " + index + ")");
            if (invoke == "InvokeString") {
                string value = NT();
                L("  " + value + " = inttoptr i64 " + bits + " to i8*");
                EmitArcRetainObject(value);
                L("  store i8* " + value + ", i8** " + result);
            } else if (invoke == "InvokeObject") {
                string value = NT();
                L("  " + value + " = inttoptr i64 " + bits + " to i8*");
                string isSt5 = NT(); L("  " + isSt5 + " = icmp eq i64 " + kind + ", 5");
                string isSt10 = NT(); L("  " + isSt10 + " = icmp eq i64 " + kind + ", 10");
                string isSt = NT(); L("  " + isSt + " = or i1 " + isSt5 + ", " + isSt10);
                int lclone = NL(); int lret = NL();
                L("  br i1 " + isSt + ", label %L" + lclone + ", label %L" + lret);
                Label(lclone);
                string cl = NT();
                L("  " + cl + " = call i8* @zlist_reflection_clone(i8* " + list + ", i8* " + value + ")");
                L("  store i8* " + cl + ", i8** " + result);
                L("  br label %L" + done);
                Label(lret);
                EmitArcRetainObject(value);
                L("  store i8* " + value + ", i8** " + result);
            } else if (invoke == "InvokeDouble") {
                int ldbl2 = NL(); int ldec6 = NL(); int lnd8 = NL(); int lnd9 = NL();
                L("  switch i64 " + kind + ", label %L" + done + " [");
                L("    i64 2, label %L" + ldbl2);
                L("    i64 6, label %L" + ldec6);
                L("    i64 8, label %L" + lnd8);
                L("    i64 9, label %L" + lnd9);
                L("  ]");
                Label(ldbl2);
                string vd = NT(); L("  " + vd + " = bitcast i64 " + bits + " to double");
                L("  store double " + vd + ", double* " + result);
                L("  br label %L" + done);
                Label(ldec6);
                ExprVal decv = DecimalUnboxSlot(bits);
                L("  store double " + DecimalNumber(decv, true) + ", double* " + result);
                L("  br label %L" + done);
                Label(lnd8);
                string nn8 = NT(); L("  " + nn8 + " = icmp ne i64 " + bits + ", 0");
                int lnd8r = NL();
                L("  br i1 " + nn8 + ", label %L" + lnd8r + ", label %L" + done);
                Label(lnd8r);
                string p8 = NT(); L("  " + p8 + " = inttoptr i64 " + bits + " to double*");
                string v8 = NT(); L("  " + v8 + " = load double, double* " + p8);
                L("  store double " + v8 + ", double* " + result);
                L("  br label %L" + done);
                Label(lnd9);
                string nn9 = NT(); L("  " + nn9 + " = icmp ne i64 " + bits + ", 0");
                int lnd9r = NL();
                L("  br i1 " + nn9 + ", label %L" + lnd9r + ", label %L" + done);
                Label(lnd9r);
                ExprVal decv9 = DecimalUnboxSlot(bits);
                L("  store double " + DecimalNumber(decv9, true) + ", double* " + result);
            } else {
                int li1 = NL(); int ldec6i = NL(); int lni7 = NL();
                L("  switch i64 " + kind + ", label %L" + done + " [");
                L("    i64 1, label %L" + li1);
                L("    i64 6, label %L" + ldec6i);
                L("    i64 7, label %L" + lni7);
                L("  ]");
                Label(li1);
                string vi1 = NarrowReflectInvokeInt(bits, invoke);
                L("  store i64 " + vi1 + ", i64* " + result);
                L("  br label %L" + done);
                Label(ldec6i);
                ExprVal decvi = DecimalUnboxSlot(bits);
                string vdi = NarrowReflectInvokeInt(DecimalNumber(decvi, false), invoke);
                L("  store i64 " + vdi + ", i64* " + result);
                L("  br label %L" + done);
                Label(lni7);
                string nn7 = NT(); L("  " + nn7 + " = icmp ne i64 " + bits + ", 0");
                int lni7r = NL();
                L("  br i1 " + nn7 + ", label %L" + lni7r + ", label %L" + done);
                Label(lni7r);
                string p7 = NT(); L("  " + p7 + " = inttoptr i64 " + bits + " to i64*");
                string v7 = NT(); L("  " + v7 + " = load i64, i64* " + p7);
                string vn7 = NarrowReflectInvokeInt(v7, invoke);
                L("  store i64 " + vn7 + ", i64* " + result);
            }
        }
        L("  br label %L" + done);
        Label(done);
    }

    string EmitReflectInvokeTaskResult(ExprVal cres) {
        if (cres != null && cres.asyncCall) {
            usesAsync = true;
            string handle = TaskRegister(cres.op);
            EmitTaskReadyFrame(cres, true);
            string tok = NT();
            L("  " + tok + " = ptrtoint i8* " + handle + " to i64");
            return tok;
        }
        return "0";
    }

    void EmitReflectInvokeStore(string mname, ExprVal cres, Node e, string resSlot, string retTyLL) {
        if (mname == "InvokeTask" || mname == "InvokeStaticTask") {
            L("  store i64 " + EmitReflectInvokeTaskResult(cres) + ", i64* " + resSlot);
        } else if (mname == "Invoke" || mname == "InvokeStatic") {
            L("  store i64 1, i64* " + resSlot);
        } else if (mname == "InvokeInt" || mname == "InvokeLong" || mname == "InvokeDouble"
            || mname == "InvokeStaticInt" || mname == "InvokeStaticLong" || mname == "InvokeStaticDouble") {
            string number = CoerceReflectInvokeNumber(cres, mname, e);
            L("  store " + retTyLL + " " + number + ", " + retTyLL + "* " + resSlot);
        } else if (mname == "InvokeString" || mname == "InvokeStaticString") {
            if (IsStr(cres.ty)) {
                string sptr = Coerce(cres, "i8*");
                EmitArcRetain(sptr, MkType("string"));
                L("  store i8* " + sptr + ", i8** " + resSlot);
            }
        } else if (mname == "InvokeObject" || mname == "InvokeStaticObject") {
            if (cres.ty != null && (IsPtrLL(MapType(cres.ty)) || IsStr(cres.ty))) {
                string sptr = Coerce(cres, "i8*");
                EmitArcRetainObject(sptr);
                L("  store i8* " + sptr + ", i8** " + resSlot);
            }
        }
    }

    bool ReflectPropSetterMatches(Node cls, string propName, string opName) {
        if (cls == null) { return false; }
        Node m = FindMethodUp(cls, "set_" + propName);
        if (m == null || HasMod(m, MOD.Static())) { return false; }
        string owner = DeclOwnerOf(cls, m);
        Node pty = ParamTypeNode(m, 0);
        if (pty == null) { return false; }
        string pt = MapTypeDecl(pty, owner);
        if (opName == "SetFieldString") {
            return IsStr(pty) || pty.sval == "object";
        }
        if (opName == "SetFieldObject") {
            return IsPtrLL(pt) || IsDecimal(pty);
        }
        if (opName == "SetFieldDouble") {
            return pt == "double" || pt == "float" || pt == "i64" || pt == "i32" || pt == "i16" || pt == "i8"
                || IsDecimal(pty) || IsNullableValue(pty);
        }
        if (opName == "SetFieldInt" || opName == "SetFieldLong") {
            return pt == "i64" || pt == "i32" || pt == "i16" || pt == "i8" || pt == "double" || pt == "float"
                || IsDecimal(pty) || IsNullableValue(pty);
        }
        if (opName == "SetFieldBool") {
            return pt == "i1" || pt == "i64" || pt == "i32" || pt == "i16" || pt == "i8"
                || IsNullableValue(pty);
        }
        return false;
    }

    void EmitReflectPropSetterCall(ExprVal castRecv, string cand, string propName, ExprVal valArg, string opName, Node callNode) {
        Node cls = binder.FindType(cand);
        if (!ReflectPropSetterMatches(cls, propName, opName)) { return; }
        Node m = FindMethodUp(cls, "set_" + propName);
        string owner = DeclOwnerOf(cls, m);
        string sym = MethodSym(owner, m);
        Node pty = ParamTypeNode(m, 0);
        if (IsDecimal(valArg.ty) && !IsDecimal(pty) && !(IsNullableValue(pty) && UnderLL(pty) == DecimalLL())) { return; }
        string pt = MapTypeDecl(pty, owner);
        string vt = MapType(valArg.ty);
        string av = "";
        if (IsDecimal(pty)) {
            av = ToDecimal(valArg).op;
        } else if (IsNullableValue(pty)) {
            if (valArg.op == "null") {
                av = "null";
            } else if (IsNullableValue(valArg.ty)) {
                av = valArg.op;
            } else if (IsPtrLL(vt)) {
                av = "null";
            } else {
                av = BoxFor(valArg, pty);
            }
        } else if (pt == "double") {
            if (vt == "double") {
                av = valArg.op;
            } else if (vt == "float") {
                av = NT();
                L("  " + av + " = fpext float " + valArg.op + " to double");
            } else {
                string iv = ToI64(valArg);
                av = NT();
                L("  " + av + " = sitofp i64 " + iv + " to double");
            }
        } else if (pt == "float") {
            if (vt == "float") {
                av = valArg.op;
            } else if (vt == "double") {
                av = NT();
                L("  " + av + " = fptrunc double " + valArg.op + " to float");
            } else {
                string iv = ToI64(valArg);
                av = NT();
                L("  " + av + " = sitofp i64 " + iv + " to float");
            }
        } else if (pt == "i1") {
            string iv = ToI64(valArg);
            av = NT();
            L("  " + av + " = icmp ne i64 " + iv + ", 0");
        } else if (pt == "i64" || pt == "i32" || pt == "i16" || pt == "i8") {
            if (vt == "double" || vt == "float") {
                string fv = valArg.op;
                if (vt == "float") {
                    fv = NT();
                    L("  " + fv + " = fpext float " + valArg.op + " to double");
                }
                av = FromI64(EmitFptosiGuarded(callNode, fv), pt);
            } else {
                av = FromI64(ToI64(valArg), pt);
            }
        } else {
            av = CallArg(valArg, pty, false);
        }
        string thisOp = castRecv.op;
        if (owner != cand) {
            string bc = NT();
            L("  " + bc + " = bitcast %" + cand + "* " + castRecv.op + " to %" + owner + "*");
            thisOp = bc;
        }
        L("  call void @" + sym + "(%" + owner + "* " + thisOp + ", " + pt + " " + av + ")");
    }

    void EmitReflectPropGetterStore(string opName, ExprVal cres, Node e, string resSlot) {
        if (opName == "GetFieldString") {
            if (IsStr(cres.ty)) {
                string sptr = Coerce(cres, "i8*");
                EmitArcRetain(sptr, MkType("string"));
                L("  store i8* " + sptr + ", i8** " + resSlot);
            }
        } else if (opName == "GetFieldObject") {
            if (IsStructTy(cres.ty) && !IsExplicitLayoutStruct(cres.ty)) {
                ExprVal cp = CopyStructValue(cres);
                L("  store i8* " + Coerce(cp, "i8*") + ", i8** " + resSlot);
            } else if (IsNullableStruct(cres.ty) && !IsExplicitLayoutStruct(cres.ty)) {
                string cloneSym = EnsureStructCloneHelper(binder.FindType(cres.ty.sval));
                string cloned = NT();
                L("  " + cloned + " = call i8* " + cloneSym + "(i8* " + Coerce(cres, "i8*") + ")");
                L("  store i8* " + cloned + ", i8** " + resSlot);
            } else if (cres.ty != null && (IsPtrLL(MapType(cres.ty)) || IsStr(cres.ty))) {
                string sptr = Coerce(cres, "i8*");
                EmitArcRetainObject(sptr);
                L("  store i8* " + sptr + ", i8** " + resSlot);
            }
        } else if (opName == "GetFieldDouble") {
            if (IsDecimal(cres.ty)) {
                L("  store double " + DecimalNumber(cres, true) + ", double* " + resSlot);
            } else if (IsNullableValue(cres.ty)) {
                L("  store double " + EmitUnboxNullableNumber(cres, true, e) + ", double* " + resSlot);
            } else {
                string dt = MapType(cres.ty);
                if (dt == "double" || dt == "float" || dt == "i1" || dt == "i8" || dt == "i16" || dt == "i32" || dt == "i64") {
                    string sd = Coerce(cres, "double");
                    L("  store double " + sd + ", double* " + resSlot);
                }
            }
        } else {
            string iv = "0";
            if (IsDecimal(cres.ty)) {
                iv = DecimalNumber(cres, false);
            } else if (IsNullableValue(cres.ty)) {
                iv = EmitUnboxNullableNumber(cres, false, e);
            } else {
                string t = MapType(cres.ty);
                if (t == "double" || t == "float") {
                    string fv2 = cres.op;
                    if (t == "float") {
                        fv2 = NT();
                        L("  " + fv2 + " = fpext float " + cres.op + " to double");
                    }
                    iv = EmitFptosiGuarded(e, fv2);
                } else if (t == "i1" || t == "i8" || t == "i16" || t == "i32" || t == "i64") {
                    iv = ToI64(cres);
                }
            }
            L("  store i64 " + iv + ", i64* " + resSlot);
        }
    }

    ExprVal EmitReflInstCall(ExprVal recv, string mname, Node e) {
        if (mname == "HasMethod") {
            string methName = e.kids.Count > 0 && e.kids[0].kind == AK.StringLit() ? e.kids[0].sval : "";
            Node cls0 = ClassOf(recv.ty);
            if (cls0 != null && cls0.sval != "object" && methName != "") {
                return new ExprVal(FindMethodUp(cls0, methName) != null ? "1" : "0", MkType("bool"));
            }
            ExprVal ti = EmitGetType(recv);
            return EmitTypeInfoMethod(ti, "HasMethod", e);
        }

        bool isInvokeAt = mname == "InvokeAt" || mname == "InvokeIntAt" || mname == "InvokeLongAt"
            || mname == "InvokeDoubleAt" || mname == "InvokeStringAt" || mname == "InvokeObjectAt" || mname == "InvokeTaskAt";
        if (isInvokeAt || mname == "Invoke" || mname == "InvokeInt" || mname == "InvokeLong"
        || mname == "InvokeDouble" || mname == "InvokeString" || mname == "InvokeObject" || mname == "InvokeTask") {
            if (isInvokeAt) {
                if (mname == "InvokeAt") { mname = "Invoke"; }
                else if (mname == "InvokeIntAt") { mname = "InvokeInt"; }
                else if (mname == "InvokeLongAt") { mname = "InvokeLong"; }
                else if (mname == "InvokeDoubleAt") { mname = "InvokeDouble"; }
                else if (mname == "InvokeStringAt") { mname = "InvokeString"; }
                else if (mname == "InvokeObjectAt") { mname = "InvokeObject"; }
                else if (mname == "InvokeTaskAt") { mname = "InvokeTask"; }
            }
            string methName = !isInvokeAt && e.kids.Count > 0 && e.kids[0].kind == AK.StringLit() ? e.kids[0].sval : "";
            Node invCall = new Node(AK.Call());
            invCall.line = e.line;
            invCall.col = e.col;
            int ki = 1;
            while (ki < e.kids.Count) {
                invCall.Add(e.kids[ki]);
                ki = ki + 1;
            }

            Node cls0 = ClassOf(recv.ty);
            bool cls0HasSub = false;
            if (cls0 != null && cls0.sval != "object") {
                int sbi = 0;
                while (sbi < tidNames.Count) {
                    string scn = tidNames[sbi];
                    if (scn != cls0.sval && IsSubclassName(scn, cls0.sval)) {
                        cls0HasSub = true;
                        break;
                    }
                    sbi = sbi + 1;
                }
            }
            if (cls0 != null && cls0.sval != "object" && !cls0HasSub && methName != "") {
                Node meth = FindMethodUp(cls0, methName);
                if (meth == null || (mname == "InvokeTask" && !HasMod(meth, MOD.Async()))) {
                    if (mname == "Invoke") { return new ExprVal("0", MkType("bool")); }
                    if (mname == "InvokeInt") { return new ExprVal("0", MkType("int")); }
                    if (mname == "InvokeLong" || mname == "InvokeTask") { return new ExprVal("0", MkType("long")); }
                    if (mname == "InvokeDouble") { return new ExprVal("0.0", MkType("double")); }
                    if (mname == "InvokeString") { return GenStr(""); }
                    if (mname == "InvokeObject") { return new ExprVal("null", MkType("object")); }
                }
                ExprVal cres = EmitInstanceCallAs(recv, cls0.sval, methName, invCall, false);
                if (mname == "InvokeTask") {
                    return new ExprVal(EmitReflectInvokeTaskResult(cres), MkType("long"));
                }
                if (mname == "Invoke") {
                    return new ExprVal("1", MkType("bool"));
                }
                if (mname == "InvokeInt" || mname == "InvokeLong" || mname == "InvokeDouble") {
                    string number = CoerceReflectInvokeNumber(cres, mname, e);
                    string typeName = mname == "InvokeInt" ? "int" : (mname == "InvokeLong" ? "long" : "double");
                    return new ExprVal(number, MkType(typeName));
                }
                if (mname == "InvokeString") {
                    if (IsStr(cres.ty)) { return cres; }
                    return GenStr("");
                }
                if (mname == "InvokeObject") {
                    if (cres.ty != null && (IsPtrLL(MapType(cres.ty)) || IsStr(cres.ty))) {
                        string sp = Coerce(cres, "i8*");
                        return new ExprVal(sp, MkType("object"));
                    }
                    return new ExprVal("null", MkType("object"));
                }
            }

            // Computed method name on a leaf statically typed class receiver: dispatch by strcmp over its method hierarchy.
            if (cls0 != null && cls0.sval != "object" && !cls0HasSub && methName == "" && e.kids.Count > 0) {
                List<Node> allM = new List<Node>();
                List<string> seenM = new List<string>();
                CollectClassMethods(cls0, allM, seenM);
                List<string> matchNames = new List<string>();
                int ami = 0;
                while (ami < allM.Count) {
                    Node am = allM[ami];
                    if (!HasMod(am, MOD.Static()) && MethodAcceptsCall(cls0, am, invCall)
                        && (mname != "InvokeTask" || HasMod(am, MOD.Async()))) {
                        matchNames.Add(am.sval);
                    }
                    ami = ami + 1;
                }
                string nmPtr = "null";
                if (isInvokeAt) {
                    ExprVal idxVal = GenExpr(e.kids[0]);
                    string idx64 = ToI64(idxVal);
                    ExprVal rti = EmitGetType(recv);
                    nmPtr = NT();
                    L("  " + nmPtr + " = call i8* @__zan_refl_method_name_at(i8* " + rti.op + ", i64 " + idx64 + ")");
                } else {
                    ExprVal nmVal = GenExpr(e.kids[0]);
                    nmPtr = Coerce(nmVal, "i8*");
                }
                if (matchNames.Count > 0) {
                    string retTyLL = mname == "InvokeDouble" ? "double" : ((mname == "InvokeString" || mname == "InvokeObject") ? "i8*" : "i64");
                    string dfltVal = (mname == "InvokeDouble") ? "0.0" : ((mname == "InvokeString") ? GenStr("").op : ((mname == "InvokeObject") ? "null" : "0"));
                    string resSlot = NT();
                    EA(resSlot, retTyLL);
                    L("  store " + retTyLL + " " + dfltVal + ", " + retTyLL + "* " + resSlot);
                    int lend = NL();
                    int lchk = NL();
                    string nonNullNm = NT();
                    L("  " + nonNullNm + " = icmp ne i8* " + nmPtr + ", null");
                    L("  br i1 " + nonNullNm + ", label %L" + lchk + ", label %L" + lend);
                    Label(lchk);
                    int mni = 0;
                    while (mni < matchNames.Count) {
                        string cnm = matchNames[mni];
                        int lmatch = NL();
                        int lnext = NL();
                        string lit = RawCString(cnm);
                        string eq = NT();
                        L("  " + eq + " = call i32 @strcmp(i8* " + nmPtr + ", i8* " + lit + ")");
                        string isEq = NT();
                        L("  " + isEq + " = icmp eq i32 " + eq + ", 0");
                        L("  br i1 " + isEq + ", label %L" + lmatch + ", label %L" + lnext);
                        Label(lmatch);
                        List<string> sTemps = stmtTemps;
                        List<string> sVals = stmtTempValues;
                        List<string> sOwners = stmtTempOwners;
                        List<Node> sTypes = stmtTempTypes;
                        List<List<string>> sArm = callArmStack;
                        List<Dictionary<string, bool>> sArmSets = callArmSets;
                        List<List<string>> sArmPend = callArmPending;
                        List<StringBuilder> sArmFn = callArmFn;
                        bool sHasPend = hasPendingCallArm;
                        stmtTemps = new List<string>();
                        stmtTempValues = new List<string>();
                        stmtTempOwners = new List<string>();
                        stmtTempTypes = new List<Node>();
                        callArmStack = null;
                        callArmSets = null;
                        callArmPending = null;
                        callArmFn = null;
                        hasPendingCallArm = false;
                        EnterCallArm();
                        ExprVal cres = EmitInstanceCallAs(recv, cls0.sval, cnm, invCall, false);
                        EmitReflectInvokeStore(mname, cres, e, resSlot, retTyLL);
                        LeaveCallArm();
                        EmitTempReleases();
                        stmtTemps = sTemps;
                        stmtTempValues = sVals;
                        stmtTempOwners = sOwners;
                        stmtTempTypes = sTypes;
                        callArmStack = sArm;
                        callArmSets = sArmSets;
                        callArmPending = sArmPend;
                        callArmFn = sArmFn;
                        hasPendingCallArm = sHasPend;
                        L("  br label %L" + lend);
                        Label(lnext);
                        mni = mni + 1;
                    }
                    L("  br label %L" + lend);
                    Label(lend);
                    string retVal = NT();
                    L("  " + retVal + " = load " + retTyLL + ", " + retTyLL + "* " + resSlot);
                    if (mname == "Invoke") { return new ExprVal(retVal, MkType("bool")); }
                    if (mname == "InvokeInt") { return new ExprVal(retVal, MkType("int")); }
                    if (mname == "InvokeLong" || mname == "InvokeTask") { return new ExprVal(retVal, MkType("long")); }
                    if (mname == "InvokeDouble") { return new ExprVal(retVal, MkType("double")); }
                    Node resultType = MkType(mname == "InvokeString" ? "string" : "object");
                    AddTemp(retVal, resultType);
                    return new ExprVal(retVal, resultType);
                }
            }

            // Fallback for object / polymorphic receiver: dispatch through candidate classes in tidNames
            if (methName != "") {
                List<string> cands = new List<string>();
                int tii = 0;
                while (tii < tidNames.Count) {
                    string cn = tidNames[tii];
                    if (cls0 != null && cls0.sval != "object" && cn != cls0.sval && !IsSubclassName(cn, cls0.sval)) {
                        tii = tii + 1;
                        continue;
                    }
                    Node cdecl = binder.FindType(cn);
                    if (cdecl != null && ClassHasMethodWithCall(cdecl, methName, invCall)) {
                        if (mname != "InvokeTask" || (FindMethodUp(cdecl, methName) != null && HasMod(FindMethodUp(cdecl, methName), MOD.Async()))) {
                            cands.Add(cn);
                        }
                    }
                    tii = tii + 1;
                }
                bool isListMeth = (cls0 == null || cls0.sval == "object") && mname != "InvokeTask" && IsContainerType("List") && (
                    (methName == "Count" && invCall.kids.Count == 0)
                    || ((methName == "Get" || methName == "At" || (methName == "Add" && mname == "Invoke"))
                        && invCall.kids.Count == 1));
                if (cands.Count > 0 || isListMeth) {
                    string retTyLL = mname == "InvokeDouble" ? "double" : ((mname == "InvokeString" || mname == "InvokeObject") ? "i8*" : "i64");
                    string dfltVal = (mname == "InvokeDouble") ? "0.0" : ((mname == "InvokeString") ? GenStr("").op : ((mname == "InvokeObject") ? "null" : "0"));
                    string resSlot = NT();
                    EA(resSlot, retTyLL);
                    L("  store " + retTyLL + " " + dfltVal + ", " + retTyLL + "* " + resSlot);

                    string cid = NT();
                    string rawRecv = Coerce(recv, "i8*");
                    L("  " + cid + " = call i8* @__zan_class_id(i8* " + rawRecv + ")");
                    int lend = NL();

                    if (isListMeth) {
                        int lmatchList = NL();
                        int lnextList = NL();
                        string eqList = NT();
                        L("  " + eqList + " = icmp eq i8* " + cid + ", bitcast (i8** @__tid_List to i8*)");
                        L("  br i1 " + eqList + ", label %L" + lmatchList + ", label %L" + lnextList);
                        Label(lmatchList);
                        List<string> slTemps = stmtTemps;
                        List<string> slVals = stmtTempValues;
                        List<string> slOwners = stmtTempOwners;
                        List<Node> slTypes = stmtTempTypes;
                        List<List<string>> slArm = callArmStack;
                        List<Dictionary<string, bool>> slArmSets = callArmSets;
                        List<List<string>> slArmPend = callArmPending;
                        List<StringBuilder> slArmFn = callArmFn;
                        bool slHasPend = hasPendingCallArm;
                        stmtTemps = new List<string>();
                        stmtTempValues = new List<string>();
                        stmtTempOwners = new List<string>();
                        stmtTempTypes = new List<Node>();
                        callArmStack = null;
                        callArmSets = null;
                        callArmPending = null;
                        callArmFn = null;
                        hasPendingCallArm = false;
                        EnterCallArm();
                        string held = HoldCallReceiver(recv);
                        EmitListReflectionCall(rawRecv, methName, mname, invCall, resSlot);
                        DropCallReceiver(held, recv.ty);
                        LeaveCallArm();
                        EmitTempReleases();
                        stmtTemps = slTemps;
                        stmtTempValues = slVals;
                        stmtTempOwners = slOwners;
                        stmtTempTypes = slTypes;
                        callArmStack = slArm;
                        callArmSets = slArmSets;
                        callArmPending = slArmPend;
                        callArmFn = slArmFn;
                        hasPendingCallArm = slHasPend;
                        L("  br label %L" + lend);
                        Label(lnextList);
                    }

                    int ci = 0;
                    while (ci < cands.Count) {
                        string cand = cands[ci];
                        int lmatch = NL();
                        int lnext = NL();
                        string eq = NT();
                        L("  " + eq + " = icmp eq i8* " + cid + ", bitcast (i8** @__tid_" + cand + " to i8*)");
                        L("  br i1 " + eq + ", label %L" + lmatch + ", label %L" + lnext);
                        Label(lmatch);
                        List<string> sTemps = stmtTemps;
                        List<string> sVals = stmtTempValues;
                        List<string> sOwners = stmtTempOwners;
                        List<Node> sTypes = stmtTempTypes;
                        List<List<string>> sArm = callArmStack;
                        List<Dictionary<string, bool>> sArmSets = callArmSets;
                        List<List<string>> sArmPend = callArmPending;
                        List<StringBuilder> sArmFn = callArmFn;
                        bool sHasPend = hasPendingCallArm;
                        stmtTemps = new List<string>();
                        stmtTempValues = new List<string>();
                        stmtTempOwners = new List<string>();
                        stmtTempTypes = new List<Node>();
                        callArmStack = null;
                        callArmSets = null;
                        callArmPending = null;
                        callArmFn = null;
                        hasPendingCallArm = false;
                        EnterCallArm();
                        string castRecvOp = NT();
                        L("  " + castRecvOp + " = bitcast i8* " + rawRecv + " to %" + cand + "*");
                        ExprVal castRecv = new ExprVal(castRecvOp, MkType(cand));
                        ExprVal cres = EmitInstanceCallAs(castRecv, cand, methName, invCall, false);
                        EmitReflectInvokeStore(mname, cres, e, resSlot, retTyLL);
                        LeaveCallArm();
                        EmitTempReleases();
                        stmtTemps = sTemps;
                        stmtTempValues = sVals;
                        stmtTempOwners = sOwners;
                        stmtTempTypes = sTypes;
                        callArmStack = sArm;
                        callArmSets = sArmSets;
                        callArmPending = sArmPend;
                        callArmFn = sArmFn;
                        hasPendingCallArm = sHasPend;
                        L("  br label %L" + lend);
                        Label(lnext);
                        ci = ci + 1;
                    }
                    L("  br label %L" + lend);
                    Label(lend);
                    string retVal = NT();
                    L("  " + retVal + " = load " + retTyLL + ", " + retTyLL + "* " + resSlot);
                    if (mname == "Invoke") { return new ExprVal(retVal, MkType("bool")); }
                    if (mname == "InvokeInt") { return new ExprVal(retVal, MkType("int")); }
                    if (mname == "InvokeLong" || mname == "InvokeTask") { return new ExprVal(retVal, MkType("long")); }
                    if (mname == "InvokeDouble") { return new ExprVal(retVal, MkType("double")); }
                    if (mname == "InvokeString" || mname == "InvokeObject") {
                        Node resultType = MkType(mname == "InvokeString" ? "string" : "object");
                        AddTemp(retVal, resultType);
                        return new ExprVal(retVal, resultType);
                    }
                }
            } else if (e.kids.Count > 0) {
                // Computed method name (or Invoke*At method index) on an object / polymorphic receiver:
                // resolve method name, then dispatch by class id (including List<T>) and strcmp over matching methods.
                string nmPtr = "null";
                if (isInvokeAt) {
                    ExprVal idxVal = GenExpr(e.kids[0]);
                    string idx64 = ToI64(idxVal);
                    ExprVal rti = EmitGetType(recv);
                    nmPtr = NT();
                    L("  " + nmPtr + " = call i8* @__zan_refl_method_name_at(i8* " + rti.op + ", i64 " + idx64 + ")");
                } else {
                    ExprVal nmVal = GenExpr(e.kids[0]);
                    nmPtr = Coerce(nmVal, "i8*");
                }
                List<string> dynCands = new List<string>();
                int tii = 0;
                while (tii < tidNames.Count) {
                    string cn = tidNames[tii];
                    if (cls0 != null && cls0.sval != "object" && cn != cls0.sval && !IsSubclassName(cn, cls0.sval)) {
                        tii = tii + 1;
                        continue;
                    }
                    Node cdecl = binder.FindType(cn);
                    if (cdecl != null && (cdecl.kind == AK.ClassDecl() || (cdecl.kind == AK.StructDecl() && !cdecl.layoutExplicit))) {
                        List<Node> allM = new List<Node>();
                        List<string> seenM = new List<string>();
                        CollectClassMethods(cdecl, allM, seenM);
                        bool hasAny = false;
                        int ami = 0;
                        while (ami < allM.Count) {
                            Node am = allM[ami];
                            if (!HasMod(am, MOD.Static()) && MethodAcceptsCall(cdecl, am, invCall)
                                && (mname != "InvokeTask" || HasMod(am, MOD.Async()))) {
                                hasAny = true;
                                break;
                            }
                            ami = ami + 1;
                        }
                        if (hasAny) { dynCands.Add(cn); }
                    }
                    tii = tii + 1;
                }
                bool canDynList = (cls0 == null || cls0.sval == "object") && mname != "InvokeTask" && IsContainerType("List")
                    && (invCall.kids.Count == 0 || invCall.kids.Count == 1);
                if (dynCands.Count > 0 || canDynList) {
                    string retTyLL = mname == "InvokeDouble" ? "double" : ((mname == "InvokeString" || mname == "InvokeObject") ? "i8*" : "i64");
                    string dfltVal = (mname == "InvokeDouble") ? "0.0" : ((mname == "InvokeString") ? GenStr("").op : ((mname == "InvokeObject") ? "null" : "0"));
                    string resSlot = NT();
                    EA(resSlot, retTyLL);
                    L("  store " + retTyLL + " " + dfltVal + ", " + retTyLL + "* " + resSlot);
                    int lend = NL();
                    int lchk = NL();
                    string rawRecv = Coerce(recv, "i8*");
                    string nnNm = NT(); L("  " + nnNm + " = icmp ne i8* " + nmPtr + ", null");
                    string nnRv = NT(); L("  " + nnRv + " = icmp ne i8* " + rawRecv + ", null");
                    string bothNn = NT(); L("  " + bothNn + " = and i1 " + nnNm + ", " + nnRv);
                    L("  br i1 " + bothNn + ", label %L" + lchk + ", label %L" + lend);
                    Label(lchk);
                    string cid = NT();
                    L("  " + cid + " = call i8* @__zan_class_id(i8* " + rawRecv + ")");
                    if (canDynList) {
                        int lmatchList = NL();
                        int lnextList = NL();
                        string eqList = NT();
                        L("  " + eqList + " = icmp eq i8* " + cid + ", bitcast (i8** @__tid_List to i8*)");
                        L("  br i1 " + eqList + ", label %L" + lmatchList + ", label %L" + lnextList);
                        Label(lmatchList);
                        List<string> listMeths = new List<string>();
                        if (invCall.kids.Count == 0) {
                            listMeths.Add("Count");
                        } else {
                            listMeths.Add("Get");
                            listMeths.Add("At");
                            if (mname == "Invoke") { listMeths.Add("Add"); }
                        }
                        int lmi = 0;
                        while (lmi < listMeths.Count) {
                            string lm = listMeths[lmi];
                            int lmmatch = NL();
                            int lmnext = NL();
                            string lit = RawCString(lm);
                            string eqm = NT();
                            L("  " + eqm + " = call i32 @strcmp(i8* " + nmPtr + ", i8* " + lit + ")");
                            string isEqm = NT();
                            L("  " + isEqm + " = icmp eq i32 " + eqm + ", 0");
                            L("  br i1 " + isEqm + ", label %L" + lmmatch + ", label %L" + lmnext);
                            Label(lmmatch);
                            List<string> sTemps = stmtTemps;
                            List<string> sVals = stmtTempValues;
                            List<string> sOwners = stmtTempOwners;
                            List<Node> sTypes = stmtTempTypes;
                            List<List<string>> sArm = callArmStack;
                            List<Dictionary<string, bool>> sArmSets = callArmSets;
                            List<List<string>> sArmPend = callArmPending;
                            List<StringBuilder> sArmFn = callArmFn;
                            bool sHasPend = hasPendingCallArm;
                            stmtTemps = new List<string>();
                            stmtTempValues = new List<string>();
                            stmtTempOwners = new List<string>();
                            stmtTempTypes = new List<Node>();
                            callArmStack = null;
                            callArmSets = null;
                            callArmPending = null;
                            callArmFn = null;
                            hasPendingCallArm = false;
                            EnterCallArm();
                            string held = HoldCallReceiver(recv);
                            EmitListReflectionCall(rawRecv, lm, mname, invCall, resSlot);
                            DropCallReceiver(held, recv.ty);
                            LeaveCallArm();
                            EmitTempReleases();
                            stmtTemps = sTemps;
                            stmtTempValues = sVals;
                            stmtTempOwners = sOwners;
                            stmtTempTypes = sTypes;
                            callArmStack = sArm;
                            callArmSets = sArmSets;
                            callArmPending = sArmPend;
                            callArmFn = sArmFn;
                            hasPendingCallArm = sHasPend;
                            L("  br label %L" + lend);
                            Label(lmnext);
                            lmi = lmi + 1;
                        }
                        L("  br label %L" + lend);
                        Label(lnextList);
                    }
                    int ci = 0;
                    while (ci < dynCands.Count) {
                        string cand = dynCands[ci];
                        Node cdecl = binder.FindType(cand);
                        int lcmatch = NL();
                        int lcnext = NL();
                        string eqc = NT();
                        L("  " + eqc + " = icmp eq i8* " + cid + ", bitcast (i8** @__tid_" + cand + " to i8*)");
                        L("  br i1 " + eqc + ", label %L" + lcmatch + ", label %L" + lcnext);
                        Label(lcmatch);
                        string castRecvOp = NT();
                        L("  " + castRecvOp + " = bitcast i8* " + rawRecv + " to %" + cand + "*");
                        ExprVal castRecv = new ExprVal(castRecvOp, MkType(cand));
                        List<Node> allM = new List<Node>();
                        List<string> seenM = new List<string>();
                        CollectClassMethods(cdecl, allM, seenM);
                        int ami = 0;
                        while (ami < allM.Count) {
                            Node am = allM[ami];
                            if (!HasMod(am, MOD.Static()) && MethodAcceptsCall(cdecl, am, invCall)
                                && (mname != "InvokeTask" || HasMod(am, MOD.Async()))) {
                                int lmmatch = NL();
                                int lmnext = NL();
                                string lit = RawCString(am.sval);
                                string eqm = NT();
                                L("  " + eqm + " = call i32 @strcmp(i8* " + nmPtr + ", i8* " + lit + ")");
                                string isEqm = NT();
                                L("  " + isEqm + " = icmp eq i32 " + eqm + ", 0");
                                L("  br i1 " + isEqm + ", label %L" + lmmatch + ", label %L" + lmnext);
                                Label(lmmatch);
                                List<string> sTemps = stmtTemps;
                                List<string> sVals = stmtTempValues;
                                List<string> sOwners = stmtTempOwners;
                                List<Node> sTypes = stmtTempTypes;
                                List<List<string>> sArm = callArmStack;
                                List<Dictionary<string, bool>> sArmSets = callArmSets;
                                List<List<string>> sArmPend = callArmPending;
                                List<StringBuilder> sArmFn = callArmFn;
                                bool sHasPend = hasPendingCallArm;
                                stmtTemps = new List<string>();
                                stmtTempValues = new List<string>();
                                stmtTempOwners = new List<string>();
                                stmtTempTypes = new List<Node>();
                                callArmStack = null;
                                callArmSets = null;
                                callArmPending = null;
                                callArmFn = null;
                                hasPendingCallArm = false;
                                EnterCallArm();
                                ExprVal cres = EmitInstanceCallAs(castRecv, cand, am.sval, invCall, false);
                                EmitReflectInvokeStore(mname, cres, e, resSlot, retTyLL);
                                LeaveCallArm();
                                EmitTempReleases();
                                stmtTemps = sTemps;
                                stmtTempValues = sVals;
                                stmtTempOwners = sOwners;
                                stmtTempTypes = sTypes;
                                callArmStack = sArm;
                                callArmSets = sArmSets;
                                callArmPending = sArmPend;
                                callArmFn = sArmFn;
                                hasPendingCallArm = sHasPend;
                                L("  br label %L" + lend);
                                Label(lmnext);
                            }
                            ami = ami + 1;
                        }
                        L("  br label %L" + lend);
                        Label(lcnext);
                        ci = ci + 1;
                    }
                    L("  br label %L" + lend);
                    Label(lend);
                    string retVal = NT();
                    L("  " + retVal + " = load " + retTyLL + ", " + retTyLL + "* " + resSlot);
                    if (mname == "Invoke") { return new ExprVal(retVal, MkType("bool")); }
                    if (mname == "InvokeInt") { return new ExprVal(retVal, MkType("int")); }
                    if (mname == "InvokeLong" || mname == "InvokeTask") { return new ExprVal(retVal, MkType("long")); }
                    if (mname == "InvokeDouble") { return new ExprVal(retVal, MkType("double")); }
                    Node resultType = MkType(mname == "InvokeString" ? "string" : "object");
                    AddTemp(retVal, resultType);
                    return new ExprVal(retVal, resultType);
                }
            }
            if (mname == "Invoke") { return new ExprVal("0", MkType("bool")); }
            if (mname == "InvokeInt") { return new ExprVal("0", MkType("int")); }
            if (mname == "InvokeLong" || mname == "InvokeTask") { return new ExprVal("0", MkType("long")); }
            if (mname == "InvokeDouble") { return new ExprVal("0.0", MkType("double")); }
            if (mname == "InvokeObject") { return new ExprVal("null", MkType("object")); }
            return GenStr("");
        }

        string fldName = "";
        if (e.kids.Count > 0 && e.kids[0].kind == AK.StringLit()) {
            fldName = e.kids[0].sval;
        }
        Node cls = ClassOf(recv.ty);
        if (cls != null && fldName != "") {
            int fi = FieldIndex(cls, fldName);
            if (mname == "HasField") {
                if (fi >= 0 || FindMethodUp(cls, "get_" + fldName) != null || FindMethodUp(cls, "set_" + fldName) != null) {
                    return new ExprVal("1", MkType("bool"));
                }
                return new ExprVal("0", MkType("bool"));
            }
            if (fi >= 0) {
                if (mname == "SetFieldString" || mname == "SetFieldInt" || mname == "SetFieldLong"
                || mname == "SetFieldDouble" || mname == "SetFieldBool" || mname == "SetFieldObject") {
                    ExprVal valArg = e.kids.Count > 1 ? GenExpr(e.kids[1]) : new ExprVal("0", MkType("int"));
                    StoreField(recv.op, cls.sval, fldName, valArg);
                    return new ExprVal("1", MkType("bool"));
                }
                ExprVal fv = LoadField(recv.op, cls, fldName);
                if (mname == "GetFieldString") {
                    if (fv.ty != null && fv.ty.sval == "string") { return fv; }
                    return GenStr("");
                }
                if (mname == "GetFieldInt" || mname == "GetFieldLong") {
                    if (IsDecimal(fv.ty)) {
                        return new ExprVal(DecimalNumber(fv, false), MkType(mname == "GetFieldInt" ? "int" : "long"));
                    }
                    if (IsNullableValue(fv.ty)) {
                        return new ExprVal(EmitUnboxNullableNumber(fv, false, e), MkType(mname == "GetFieldInt" ? "int" : "long"));
                    }
                    string t = MapType(fv.ty);
                    if (t == "i64") { return new ExprVal(fv.op, MkType(mname == "GetFieldInt" ? "int" : "long")); }
                    if (t == "i32") {
                        string ex = NT();
                        L("  " + ex + " = sext i32 " + fv.op + " to i64");
                        return new ExprVal(ex, MkType(mname == "GetFieldInt" ? "int" : "long"));
                    }
                    if (t == "double" || t == "float") {
                        string fv2 = fv.op;
                        if (t == "float") {
                            fv2 = NT();
                            L("  " + fv2 + " = fpext float " + fv.op + " to double");
                        }
                        // B-ID180：fp 字段越界 poison 收口，镜像 C 宿主
                        // irgen_reflect.c refl_ld/GetFieldInt 通道。
                        return new ExprVal(EmitFptosiGuarded(e, fv2), MkType(mname == "GetFieldInt" ? "int" : "long"));
                    }
                    return new ExprVal("0", MkType(mname == "GetFieldInt" ? "int" : "long"));
                }
                if (mname == "GetFieldDouble") {
                    if (IsDecimal(fv.ty)) {
                        return new ExprVal(DecimalNumber(fv, true), MkType("double"));
                    }
                    if (IsNullableValue(fv.ty)) {
                        return new ExprVal(EmitUnboxNullableNumber(fv, true, e), MkType("double"));
                    }
                    string t = MapType(fv.ty);
                    if (t == "double") { return fv; }
                    if (t == "float") {
                        string ex = NT();
                        L("  " + ex + " = fpext float " + fv.op + " to double");
                        return new ExprVal(ex, MkType("double"));
                    }
                    if (t == "i32" || t == "i64") {
                        string ex = NT();
                        L("  " + ex + " = sitofp " + t + " " + fv.op + " to double");
                        return new ExprVal(ex, MkType("double"));
                    }
                    return new ExprVal("0.0", MkType("double"));
                }
                if (mname == "GetFieldBool") {
                    if (IsNullableValue(fv.ty)) {
                        string nv = EmitUnboxNullableNumber(fv, false, e);
                        string nz = NT(); L("  " + nz + " = icmp ne i64 " + nv + ", 0");
                        string z = NT(); L("  " + z + " = zext i1 " + nz + " to i64");
                        return new ExprVal(z, MkType("bool"));
                    }
                    string t = MapType(fv.ty);
                    if (t == "i1") {
                        string z = NT();
                        L("  " + z + " = zext i1 " + fv.op + " to i64");
                        return new ExprVal(z, MkType("bool"));
                    }
                    if (t == "i64" || t == "i32" || t == "i16" || t == "i8") {
                        string nz = NT();
                        L("  " + nz + " = icmp ne " + t + " " + fv.op + ", 0");
                        string z = NT();
                        L("  " + z + " = zext i1 " + nz + " to i64");
                        return new ExprVal(z, MkType("bool"));
                    }
                    return new ExprVal("0", MkType("bool"));
                }
                if (mname == "GetFieldObject") {
                    if (IsStructTy(fv.ty) && !IsExplicitLayoutStruct(fv.ty)) {
                        ExprVal cp = StructCopyTemp(fv, fv.ty);
                        return new ExprVal(Coerce(cp, "i8*"), MkType("object"));
                    }
                    if (IsNullableStruct(fv.ty) && !IsExplicitLayoutStruct(fv.ty)) {
                        string cloneSym = EnsureStructCloneHelper(binder.FindType(fv.ty.sval));
                        string cloned = NT();
                        L("  " + cloned + " = call i8* " + cloneSym + "(i8* " + Coerce(fv, "i8*") + ")");
                        AddTemp(cloned, MkType("object"));
                        return new ExprVal(cloned, MkType("object"));
                    }
                    if (fv.ty != null && (IsPtrLL(MapType(fv.ty)) || IsStr(fv.ty))) {
                        return new ExprVal(Coerce(fv, "i8*"), MkType("object"));
                    }
                    return new ExprVal("null", MkType("object"));
                }
            } else {
                if (mname == "SetFieldString" || mname == "SetFieldInt" || mname == "SetFieldLong"
                || mname == "SetFieldDouble" || mname == "SetFieldBool" || mname == "SetFieldObject") {
                    if (ReflectPropSetterMatches(cls, fldName, mname)) {
                        ExprVal valArg = e.kids.Count > 1 ? GenExpr(e.kids[1]) : new ExprVal("0", MkType("int"));
                        EmitReflectPropSetterCall(recv, cls.sval, fldName, valArg, mname, e);
                        return new ExprVal("1", MkType("bool"));
                    }
                }
                if (mname.StartsWith("GetField")) {
                    Node gm = FindMethodUp(cls, "get_" + fldName);
                    if (gm != null) {
                        Node getCall = new Node(AK.Call());
                        getCall.line = e.line;
                        getCall.col = e.col;
                        ExprVal cres = EmitInstanceCallAs(recv, cls.sval, "get_" + fldName, getCall, false);
                        if (mname == "GetFieldString") {
                            if (cres.ty != null && cres.ty.sval == "string") { return cres; }
                            return GenStr("");
                        }
                        if (mname == "GetFieldInt" || mname == "GetFieldLong") {
                            return new ExprVal(ToI64(cres), MkType(mname == "GetFieldInt" ? "int" : "long"));
                        }
                        if (mname == "GetFieldDouble") {
                            string sd = Coerce(cres, "double");
                            return new ExprVal(sd, MkType("double"));
                        }
                        if (mname == "GetFieldBool") {
                            string s64 = Coerce(cres, "i64");
                            return new ExprVal(s64, MkType("bool"));
                        }
                        if (mname == "GetFieldObject") {
                            if (cres.ty != null && (IsPtrLL(MapType(cres.ty)) || IsStr(cres.ty))) {
                                return new ExprVal(Coerce(cres, "i8*"), MkType("object"));
                            }
                            return new ExprVal("null", MkType("object"));
                        }
                    }
                }
            }
        }
        // Dynamic reflection fallback using property accessors + TypeInfo & @__zan_refl_field_find / @__zan_refl_field_at
        bool isAt = mname.EndsWith("At");
        string opName = isAt ? mname.Substring(0, mname.Length - 2) : mname;
        ExprVal objRecv = IsErasedType(recv.ty) ? new ExprVal(Coerce(recv, "i8*"), MkType("object")) : recv;
        string rop = Coerce(objRecv, "i8*");
        ExprVal nmOrIdxVal = e.kids.Count > 0
            ? GenExpr(e.kids[0])
            : new ExprVal(isAt ? "-1" : "null", MkType(isAt ? "int" : "string"));
        ExprVal vVal = (opName.StartsWith("SetField") && e.kids.Count > 1) ? GenExpr(e.kids[1]) : new ExprVal("0", MkType("int"));

        bool isSetOp = opName == "SetFieldString" || opName == "SetFieldInt" || opName == "SetFieldLong"
            || opName == "SetFieldDouble" || opName == "SetFieldBool" || opName == "SetFieldObject";
        bool isGetOp = opName == "GetFieldString" || opName == "GetFieldInt" || opName == "GetFieldLong"
            || opName == "GetFieldDouble" || opName == "GetFieldBool" || opName == "GetFieldObject";

        // Dynamic property dispatch (get_*/set_*) before field-offset lookup.
        string resSlot = "";
        int propDoneLbl = -1;
        if (!isAt && (opName == "HasField" || isSetOp || isGetOp)) {
            List<string> propCands = new List<string>();
            int tii = 0;
            while (tii < tidNames.Count) {
                string cn = tidNames[tii];
                Node cdecl = binder.FindType(cn);
                if (cdecl != null && (cdecl.kind == AK.ClassDecl() || (cdecl.kind == AK.StructDecl() && !cdecl.layoutExplicit))) {
                    bool keep = false;
                    if (fldName != "") {
                        if (isSetOp) { keep = ReflectPropSetterMatches(cdecl, fldName, opName); }
                        else if (isGetOp) { keep = FindMethodUp(cdecl, "get_" + fldName) != null; }
                        else { keep = FindMethodUp(cdecl, "get_" + fldName) != null || FindMethodUp(cdecl, "set_" + fldName) != null; }
                    } else {
                        List<string> pnames = new List<string>();
                        if (isSetOp) {
                            List<string> allSet = new List<string>();
                            CollectClassProps(cdecl, allSet, true);
                            int si = 0;
                            while (si < allSet.Count) {
                                if (ReflectPropSetterMatches(cdecl, allSet[si], opName)) { pnames.Add(allSet[si]); }
                                si = si + 1;
                            }
                        }
                        else if (isGetOp) { CollectClassProps(cdecl, pnames, false); }
                        else { CollectClassProps(cdecl, pnames, false); CollectClassProps(cdecl, pnames, true); }
                        keep = pnames.Count > 0;
                    }
                    if (keep) { propCands.Add(cn); }
                }
                tii = tii + 1;
            }
            if (propCands.Count > 0) {
                propDoneLbl = NL();
                if (isSetOp || opName == "HasField") {
                    resSlot = NT();
                    L("  " + resSlot + " = alloca i64");
                    L("  store i64 0, i64* " + resSlot);
                } else if (opName == "GetFieldString") {
                    resSlot = NT();
                    L("  " + resSlot + " = alloca i8*");
                    L("  store i8* " + GenStr("").op + ", i8** " + resSlot);
                } else if (opName == "GetFieldObject") {
                    resSlot = NT();
                    L("  " + resSlot + " = alloca i8*");
                    L("  store i8* null, i8** " + resSlot);
                } else if (opName == "GetFieldDouble") {
                    resSlot = NT();
                    L("  " + resSlot + " = alloca double");
                    L("  store double 0.0, double* " + resSlot);
                } else {
                    resSlot = NT();
                    L("  " + resSlot + " = alloca i64");
                    L("  store i64 0, i64* " + resSlot);
                }
                int lpropCheck = NL();
                int lpropMiss = NL();
                string nmPtr = Coerce(nmOrIdxVal, "i8*");
                string nnR = NT(); L("  " + nnR + " = icmp ne i8* " + rop + ", null");
                string nnN = NT(); L("  " + nnN + " = icmp ne i8* " + nmPtr + ", null");
                string canProp = NT(); L("  " + canProp + " = and i1 " + nnR + ", " + nnN);
                L("  br i1 " + canProp + ", label %L" + lpropCheck + ", label %L" + lpropMiss);
                Label(lpropCheck);
                string pcid = NT();
                L("  " + pcid + " = call i8* @__zan_class_id(i8* " + rop + ")");
                int pci = 0;
                while (pci < propCands.Count) {
                    string cand = propCands[pci];
                    Node cdecl = binder.FindType(cand);
                    int lcmatch = NL();
                    int lcnext = NL();
                    string eqc = NT();
                    L("  " + eqc + " = icmp eq i8* " + pcid + ", bitcast (i8** @__tid_" + cand + " to i8*)");
                    L("  br i1 " + eqc + ", label %L" + lcmatch + ", label %L" + lcnext);
                    Label(lcmatch);
                    string castRecvOp = NT();
                    L("  " + castRecvOp + " = bitcast i8* " + rop + " to %" + cand + "*");
                    ExprVal castRecv = new ExprVal(castRecvOp, MkType(cand));
                    List<string> pnames = new List<string>();
                    if (fldName != "") {
                        pnames.Add(fldName);
                    } else {
                        if (isSetOp) {
                            List<string> allSet = new List<string>();
                            CollectClassProps(cdecl, allSet, true);
                            int si = 0;
                            while (si < allSet.Count) {
                                if (ReflectPropSetterMatches(cdecl, allSet[si], opName)) { pnames.Add(allSet[si]); }
                                si = si + 1;
                            }
                        }
                        else if (isGetOp) { CollectClassProps(cdecl, pnames, false); }
                        else { CollectClassProps(cdecl, pnames, false); CollectClassProps(cdecl, pnames, true); }
                    }
                    int pni = 0;
                    while (pni < pnames.Count) {
                        string pn = pnames[pni];
                        int lpmatch = NL();
                        int lpnext = NL();
                        if (fldName != "") {
                            L("  br label %L" + lpmatch);
                        } else {
                            string lit = RawCString(pn);
                            string eqp = NT();
                            L("  " + eqp + " = call i32 @strcmp(i8* " + nmPtr + ", i8* " + lit + ")");
                            string isEqp = NT();
                            L("  " + isEqp + " = icmp eq i32 " + eqp + ", 0");
                            L("  br i1 " + isEqp + ", label %L" + lpmatch + ", label %L" + lpnext);
                        }
                        Label(lpmatch);
                        List<string> sTemps = stmtTemps;
                        List<string> sVals = stmtTempValues;
                        List<string> sOwners = stmtTempOwners;
                        List<Node> sTypes = stmtTempTypes;
                        List<List<string>> sArm = callArmStack;
                        List<Dictionary<string, bool>> sArmSets = callArmSets;
                        List<List<string>> sArmPend = callArmPending;
                        List<StringBuilder> sArmFn = callArmFn;
                        bool sHasPend = hasPendingCallArm;
                        stmtTemps = new List<string>();
                        stmtTempValues = new List<string>();
                        stmtTempOwners = new List<string>();
                        stmtTempTypes = new List<Node>();
                        callArmStack = null;
                        callArmSets = null;
                        callArmPending = null;
                        callArmFn = null;
                        hasPendingCallArm = false;
                        EnterCallArm();
                        if (opName == "HasField") {
                            L("  store i64 1, i64* " + resSlot);
                        } else if (isSetOp) {
                            EmitReflectPropSetterCall(castRecv, cand, pn, vVal, opName, e);
                            L("  store i64 1, i64* " + resSlot);
                        } else {
                            Node getCall = new Node(AK.Call());
                            getCall.line = e.line;
                            getCall.col = e.col;
                            ExprVal cres = EmitInstanceCallAs(castRecv, cand, "get_" + pn, getCall, false);
                            EmitReflectPropGetterStore(opName, cres, e, resSlot);
                        }
                        LeaveCallArm();
                        EmitTempReleases();
                        stmtTemps = sTemps;
                        stmtTempValues = sVals;
                        stmtTempOwners = sOwners;
                        stmtTempTypes = sTypes;
                        callArmStack = sArm;
                        callArmSets = sArmSets;
                        callArmPending = sArmPend;
                        callArmFn = sArmFn;
                        hasPendingCallArm = sHasPend;
                        L("  br label %L" + propDoneLbl);
                        Label(lpnext);
                        pni = pni + 1;
                    }
                    L("  br label %L" + lpropMiss);
                    Label(lcnext);
                    pci = pci + 1;
                }
                L("  br label %L" + lpropMiss);
                Label(lpropMiss);
            }
        }

        ExprVal ti = EmitGetType(objRecv);
        string slotP = NT();
        if (isAt) {
            string idx64 = ToI64(nmOrIdxVal);
            L("  " + slotP + " = call i8* @__zan_refl_field_at(i8* " + ti.op + ", i64 " + idx64 + ")");
        } else {
            L("  " + slotP + " = call i8* @__zan_refl_field_find(i8* " + ti.op + ", i8* " + nmOrIdxVal.op + ")");
        }
        string slotNn = NT();
        L("  " + slotNn + " = icmp ne i8* " + slotP + ", null");

        if (opName == "HasField") {
            string z = NT();
            L("  " + z + " = zext i1 " + slotNn + " to i64");
            if (propDoneLbl >= 0) {
                L("  store i64 " + z + ", i64* " + resSlot);
                L("  br label %L" + propDoneLbl);
                Label(propDoneLbl);
                string retH = NT();
                L("  " + retH + " = load i64, i64* " + resSlot);
                return new ExprVal(retH, MkType("bool"));
            }
            return new ExprVal(z, MkType("bool"));
        }

        string recvNn = NT();
        L("  " + recvNn + " = icmp ne i8* " + rop + ", null");
        string hit = NT();
        L("  " + hit + " = and i1 " + slotNn + ", " + recvNn);

        if (isSetOp) {
            string okSlot = "";
            if (opName == "SetFieldString" || opName == "SetFieldObject") {
                okSlot = NT();
                L("  " + okSlot + " = alloca i64");
                L("  store i64 0, i64* " + okSlot);
            }
            int lset = NL();
            int lend = NL();
            L("  br i1 " + hit + ", label %L" + lset + ", label %L" + lend);
            Label(lset);
            string foff_p = NT();
            L("  " + foff_p + " = getelementptr inbounds i8, i8* " + slotP + ", i64 24");
            string foff_i64 = NT();
            L("  " + foff_i64 + " = bitcast i8* " + foff_p + " to i64*");
            string foff = NT();
            L("  " + foff + " = load i64, i64* " + foff_i64);

            string fkind_p = NT();
            L("  " + fkind_p + " = getelementptr inbounds i8, i8* " + slotP + ", i64 16");
            string fkind_i64 = NT();
            L("  " + fkind_i64 + " = bitcast i8* " + fkind_p + " to i64*");
            string fkind = NT();
            L("  " + fkind + " = load i64, i64* " + fkind_i64);

            string fp = NT();
            L("  " + fp + " = getelementptr inbounds i8, i8* " + rop + ", i64 " + foff);

            if (opName == "SetFieldString" || opName == "SetFieldObject") {
                if (IsDecimal(vVal.ty)) {
                    int ldec = NL(); int lndec = NL();
                    L("  switch i64 " + fkind + ", label %L" + lend + " [");
                    L("    i64 16, label %L" + ldec);
                    L("    i64 19, label %L" + lndec);
                    L("  ]");
                    Label(ldec);
                    string dp = NT(); L("  " + dp + " = bitcast i8* " + fp + " to " + DecimalLL() + "*");
                    L("  store " + DecimalLL() + " " + vVal.op + ", " + DecimalLL() + "* " + dp);
                    L("  store i64 1, i64* " + okSlot);
                    L("  br label %L" + lend);
                    Label(lndec);
                    string b16 = NT(); L("  " + b16 + " = call i8* @zalloc(i64 16, i8* null, i8* null)");
                    string b16p = NT(); L("  " + b16p + " = bitcast i8* " + b16 + " to " + DecimalLL() + "*");
                    L("  store " + DecimalLL() + " " + vVal.op + ", " + DecimalLL() + "* " + b16p);
                    string sp19 = NT(); L("  " + sp19 + " = bitcast i8* " + fp + " to i8**");
                    string old19 = NT(); L("  " + old19 + " = load i8*, i8** " + sp19);
                    L("  store i8* " + b16 + ", i8** " + sp19);
                    EmitArcRelease(old19, MkType("object"));
                    L("  store i64 1, i64* " + okSlot);
                    L("  br label %L" + lend);
                } else if (IsNullableValue(vVal.ty)) {
                    string ult = UnderLL(vVal.ty);
                    int matchFk = ult == DecimalLL() ? 19 : (ult == "double" ? 18 : 17);
                    int lnb = NL();
                    L("  switch i64 " + fkind + ", label %L" + lend + " [");
                    L("    i64 " + matchFk + ", label %L" + lnb);
                    L("  ]");
                    Label(lnb);
                    string spn = NT(); L("  " + spn + " = bitcast i8* " + fp + " to i8**");
                    string oldn = NT(); L("  " + oldn + " = load i8*, i8** " + spn);
                    EmitArcRetain(vVal.op, MkType("object"));
                    L("  store i8* " + vVal.op + ", i8** " + spn);
                    EmitArcRelease(oldn, MkType("object"));
                    L("  store i64 1, i64* " + okSlot);
                    L("  br label %L" + lend);
                } else {
                    string valOp = Coerce(vVal, "i8*");
                    int lstore = NL();
                    int lnullPrim = NL();
                    int lstruct = NL();
                    int lnstruct = NL();
                    L("  switch i64 " + fkind + ", label %L" + lend + " [");
                    L("    i64 " + ReflFkOf("string") + ", label %L" + lstore);
                    L("    i64 " + ReflFkOf("object") + ", label %L" + lstore);
                    L("    i64 17, label %L" + lnullPrim);
                    L("    i64 18, label %L" + lnullPrim);
                    L("    i64 19, label %L" + lnullPrim);
                    L("    i64 20, label %L" + lstruct);
                    L("    i64 21, label %L" + lnstruct);
                    L("  ]");
                    Label(lstore);
                    string sp = NT();
                    L("  " + sp + " = bitcast i8* " + fp + " to i8**");
                    string old = NT();
                    L("  " + old + " = load i8*, i8** " + sp);
                    Node refTy = MkType("object");
                    EmitArcRetain(valOp, refTy);
                    L("  store i8* " + valOp + ", i8** " + sp);
                    EmitArcRelease(old, refTy);
                    L("  store i64 1, i64* " + okSlot);
                    L("  br label %L" + lend);

                    Label(lnullPrim);
                    string npNil = NT(); L("  " + npNil + " = icmp eq i8* " + valOp + ", null");
                    int lnpSet = NL();
                    L("  br i1 " + npNil + ", label %L" + lnpSet + ", label %L" + lend);
                    Label(lnpSet);
                    string spnp = NT(); L("  " + spnp + " = bitcast i8* " + fp + " to i8**");
                    string oldnp = NT(); L("  " + oldnp + " = load i8*, i8** " + spnp);
                    L("  store i8* null, i8** " + spnp);
                    EmitArcRelease(oldnp, MkType("object"));
                    L("  store i64 1, i64* " + okSlot);
                    L("  br label %L" + lend);

                    Label(lnstruct);
                    string nsNil = NT(); L("  " + nsNil + " = icmp eq i8* " + valOp + ", null");
                    L("  br i1 " + nsNil + ", label %L" + lnpSet + ", label %L" + lstruct);

                    Label(lstruct);
                    string stNn = NT(); L("  " + stNn + " = icmp ne i8* " + valOp + ", null");
                    int lstFti = NL();
                    L("  br i1 " + stNn + ", label %L" + lstFti + ", label %L" + lend);
                    Label(lstFti);
                    string ftiP = NT(); L("  " + ftiP + " = getelementptr inbounds i8, i8* " + slotP + ", i64 56");
                    string ftiPP = NT(); L("  " + ftiPP + " = bitcast i8* " + ftiP + " to i8**");
                    string fti = NT(); L("  " + fti + " = load i8*, i8** " + ftiPP);
                    string ftiNn = NT(); L("  " + ftiNn + " = icmp ne i8* " + fti + ", null");
                    int lstAcc = NL();
                    L("  br i1 " + ftiNn + ", label %L" + lstAcc + ", label %L" + lend);
                    Label(lstAcc);
                    string accRaw = NT(); L("  " + accRaw + " = getelementptr i8, i8* " + fti + ", i64 -120");
                    string accSlot = NT(); L("  " + accSlot + " = bitcast i8* " + accRaw + " to i1 (i8*)**");
                    string accFn = NT(); L("  " + accFn + " = load i1 (i8*)*, i1 (i8*)** " + accSlot);
                    string accNn = NT(); L("  " + accNn + " = icmp ne i1 (i8*)* " + accFn + ", null");
                    int lstCallAcc = NL();
                    L("  br i1 " + accNn + ", label %L" + lstCallAcc + ", label %L" + lend);
                    Label(lstCallAcc);
                    string accOk = NT(); L("  " + accOk + " = call i1 " + accFn + "(i8* " + valOp + ")");
                    int lstClone = NL();
                    L("  br i1 " + accOk + ", label %L" + lstClone + ", label %L" + lend);
                    Label(lstClone);
                    string clRaw = NT(); L("  " + clRaw + " = getelementptr i8, i8* " + fti + ", i64 -144");
                    string clSlot = NT(); L("  " + clSlot + " = bitcast i8* " + clRaw + " to i8* (i8*)**");
                    string clFn = NT(); L("  " + clFn + " = load i8* (i8*)*, i8* (i8*)** " + clSlot);
                    string clVal = NT(); L("  " + clVal + " = call i8* " + clFn + "(i8* " + valOp + ")");
                    string sps = NT(); L("  " + sps + " = bitcast i8* " + fp + " to i8**");
                    string olds = NT(); L("  " + olds + " = load i8*, i8** " + sps);
                    L("  store i8* " + clVal + ", i8** " + sps);
                    EmitArcRelease(olds, MkType("object"));
                    L("  store i64 1, i64* " + okSlot);
                    L("  br label %L" + lend);
                }
                Label(lend);
                string result = NT();
                L("  " + result + " = load i64, i64* " + okSlot);
                if (propDoneLbl >= 0) {
                    L("  store i64 " + result + ", i64* " + resSlot);
                    L("  br label %L" + propDoneLbl);
                    Label(propDoneLbl);
                    string retS = NT();
                    L("  " + retS + " = load i64, i64* " + resSlot);
                    return new ExprVal(retS, MkType("bool"));
                }
                return new ExprVal(result, MkType("bool"));
            }
            if (opName == "SetFieldBool") {
                string val64 = ToI64(vVal);
                string val1 = NT();
                L("  " + val1 + " = icmp ne i64 " + val64 + ", 0");
                int lnb = NL(); int lrawb = NL(); int ldoneb = NL();
                string isNb = NT(); L("  " + isNb + " = icmp eq i64 " + fkind + ", 17");
                L("  br i1 " + isNb + ", label %L" + lnb + ", label %L" + lrawb);
                Label(lnb);
                string bz64 = NT(); L("  " + bz64 + " = zext i1 " + val1 + " to i64");
                string bb8 = NT(); L("  " + bb8 + " = call i8* @zalloc(i64 8, i8* null, i8* null)");
                string bb8p = NT(); L("  " + bb8p + " = bitcast i8* " + bb8 + " to i64*");
                L("  store i64 " + bz64 + ", i64* " + bb8p);
                string fpb = NT(); L("  " + fpb + " = bitcast i8* " + fp + " to i8**");
                string oldb = NT(); L("  " + oldb + " = load i8*, i8** " + fpb);
                L("  store i8* " + bb8 + ", i8** " + fpb);
                EmitArcRelease(oldb, MkType("object"));
                L("  br label %L" + ldoneb);
                Label(lrawb);
                string val8 = NT();
                L("  " + val8 + " = zext i1 " + val1 + " to i8");
                L("  store i8 " + val8 + ", i8* " + fp);
                L("  br label %L" + ldoneb);
                Label(ldoneb);
            } else if (opName == "SetFieldInt" || opName == "SetFieldLong") {
                string val64 = ToI64(vVal);
                int l1 = NL();
                int l2 = NL();
                int l4 = NL();
                int l8 = NL();
                int ldec = NL();
                int lni17 = NL();
                int lnd18 = NL();
                int lnm19 = NL();
                int ldone = NL();
                string is1 = NT(); L("  " + is1 + " = icmp eq i64 " + fkind + ", 1");
                string isByte = NT(); L("  " + isByte + " = icmp eq i64 " + fkind + ", 3");
                string isSbyte = NT(); L("  " + isSbyte + " = icmp eq i64 " + fkind + ", 2");
                string is1a = NT(); L("  " + is1a + " = or i1 " + is1 + ", " + isByte);
                string is1Tot = NT(); L("  " + is1Tot + " = or i1 " + is1a + ", " + isSbyte);
                L("  br i1 " + is1Tot + ", label %L" + l1 + ", label %L" + l2);

                Label(l1);
                string val8 = NT(); L("  " + val8 + " = trunc i64 " + val64 + " to i8");
                L("  store i8 " + val8 + ", i8* " + fp);
                L("  br label %L" + ldone);

                Label(l2);
                string isShort = NT(); L("  " + isShort + " = icmp eq i64 " + fkind + ", 4");
                string isUshort = NT(); L("  " + isUshort + " = icmp eq i64 " + fkind + ", 5");
                string is2Tot = NT(); L("  " + is2Tot + " = or i1 " + isShort + ", " + isUshort);
                int l2body = NL();
                L("  br i1 " + is2Tot + ", label %L" + l2body + ", label %L" + l4);

                Label(l2body);
                string val16 = NT(); L("  " + val16 + " = trunc i64 " + val64 + " to i16");
                string p16 = NT(); L("  " + p16 + " = bitcast i8* " + fp + " to i16*");
                L("  store i16 " + val16 + ", i16* " + p16);
                L("  br label %L" + ldone);

                Label(l4);
                string isInt = NT(); L("  " + isInt + " = icmp eq i64 " + fkind + ", 6");
                string isUint = NT(); L("  " + isUint + " = icmp eq i64 " + fkind + ", 7");
                string is4Tot = NT(); L("  " + is4Tot + " = or i1 " + isInt + ", " + isUint);
                int l4body = NL();
                L("  br i1 " + is4Tot + ", label %L" + l4body + ", label %L" + l8);

                Label(l4body);
                string val32 = NT(); L("  " + val32 + " = trunc i64 " + val64 + " to i32");
                string p32 = NT(); L("  " + p32 + " = bitcast i8* " + fp + " to i32*");
                L("  store i32 " + val32 + ", i32* " + p32);
                L("  br label %L" + ldone);

                Label(l8);
                int l8raw = NL();
                L("  switch i64 " + fkind + ", label %L" + l8raw + " [");
                L("    i64 16, label %L" + ldec);
                L("    i64 17, label %L" + lni17);
                L("    i64 18, label %L" + lnd18);
                L("    i64 19, label %L" + lnm19);
                L("  ]");
                Label(ldec);
                ExprVal dv16 = ToDecimal(new ExprVal(val64, MkType("long")));
                string dp16 = NT(); L("  " + dp16 + " = bitcast i8* " + fp + " to " + DecimalLL() + "*");
                L("  store " + DecimalLL() + " " + dv16.op + ", " + DecimalLL() + "* " + dp16);
                L("  br label %L" + ldone);
                Label(lni17);
                string bx17 = NT(); L("  " + bx17 + " = call i8* @zalloc(i64 8, i8* null, i8* null)");
                string bx17p = NT(); L("  " + bx17p + " = bitcast i8* " + bx17 + " to i64*");
                L("  store i64 " + val64 + ", i64* " + bx17p);
                string fp17 = NT(); L("  " + fp17 + " = bitcast i8* " + fp + " to i8**");
                string old17 = NT(); L("  " + old17 + " = load i8*, i8** " + fp17);
                L("  store i8* " + bx17 + ", i8** " + fp17);
                EmitArcRelease(old17, MkType("object"));
                L("  br label %L" + ldone);
                Label(lnd18);
                string fd18 = NT(); L("  " + fd18 + " = sitofp i64 " + val64 + " to double");
                string bx18 = NT(); L("  " + bx18 + " = call i8* @zalloc(i64 8, i8* null, i8* null)");
                string bx18p = NT(); L("  " + bx18p + " = bitcast i8* " + bx18 + " to double*");
                L("  store double " + fd18 + ", double* " + bx18p);
                string fp18 = NT(); L("  " + fp18 + " = bitcast i8* " + fp + " to i8**");
                string old18 = NT(); L("  " + old18 + " = load i8*, i8** " + fp18);
                L("  store i8* " + bx18 + ", i8** " + fp18);
                EmitArcRelease(old18, MkType("object"));
                L("  br label %L" + ldone);
                Label(lnm19);
                ExprVal dv19 = ToDecimal(new ExprVal(val64, MkType("long")));
                string bx19 = NT(); L("  " + bx19 + " = call i8* @zalloc(i64 16, i8* null, i8* null)");
                string bx19p = NT(); L("  " + bx19p + " = bitcast i8* " + bx19 + " to " + DecimalLL() + "*");
                L("  store " + DecimalLL() + " " + dv19.op + ", " + DecimalLL() + "* " + bx19p);
                string fp19 = NT(); L("  " + fp19 + " = bitcast i8* " + fp + " to i8**");
