using System;
using System.Collections.Generic;
namespace Zan;

partial class Irgen {
    ExprVal EmitTypeInfoMethod(ExprVal recv, string mname, Node e) {
        if (mname == "GetFieldName" || mname == "GetFieldType" || mname == "GetFieldCustomName"
            || mname == "GetFieldDefault" || mname == "GetFieldTypeInfo" || mname == "GetMemberValue"
            || mname == "IsFieldIgnored" || mname == "IsFieldRequired" || mname == "IsFieldPk"
            || mname == "IsFieldIdentity"
            || mname == "GetFieldCustomAttributes" || mname == "GetFieldAttrs") {
            ExprVal idxVal = e.kids.Count > 0 ? GenExpr(e.kids[0]) : new ExprVal("0", MkType("int"));
            string idx64 = ToI64(idxVal);
            string fp = NT();
            L("  " + fp + " = getelementptr inbounds i8, i8* " + recv.op + ", i64 -40");
            string fp_ptr = NT();
            L("  " + fp_ptr + " = bitcast i8* " + fp + " to i8**");
            string fbase = NT();
            L("  " + fbase + " = load i8*, i8** " + fp_ptr);
            string fo = NT();
            L("  " + fo + " = mul i64 " + idx64 + ", 72");
            string f_slot = NT();
            L("  " + f_slot + " = getelementptr inbounds i8, i8* " + fbase + ", i64 " + fo);

            if (mname == "GetFieldName") {
                string nm_p = NT();
                L("  " + nm_p + " = bitcast i8* " + f_slot + " to i8**");
                string nm = NT();
                L("  " + nm + " = load i8*, i8** " + nm_p);
                return new ExprVal(nm, MkType("string"));
            }
            if (mname == "GetFieldType") {
                string tp_gep = NT();
                L("  " + tp_gep + " = getelementptr inbounds i8, i8* " + f_slot + ", i64 8");
                string tp_p = NT();
                L("  " + tp_p + " = bitcast i8* " + tp_gep + " to i8**");
                string tp = NT();
                L("  " + tp + " = load i8*, i8** " + tp_p);
                return new ExprVal(tp, MkType("string"));
            }
            if (mname == "GetMemberValue") {
                string mv_gep = NT();
                L("  " + mv_gep + " = getelementptr inbounds i8, i8* " + f_slot + ", i64 24");
                string mv_p = NT();
                L("  " + mv_p + " = bitcast i8* " + mv_gep + " to i64*");
                string mv = NT();
                L("  " + mv + " = load i64, i64* " + mv_p);
                return new ExprVal(mv, MkType("long"));
            }
            if (mname == "GetFieldCustomName") {
                string cn_gep = NT();
                L("  " + cn_gep + " = getelementptr inbounds i8, i8* " + f_slot + ", i64 32");
                string cn_p = NT();
                L("  " + cn_p + " = bitcast i8* " + cn_gep + " to i8**");
                string cn = NT();
                L("  " + cn + " = load i8*, i8** " + cn_p);
                return new ExprVal(cn, MkType("string"));
            }
            if (mname == "IsFieldIgnored" || mname == "IsFieldRequired" || mname == "IsFieldPk"
                || mname == "IsFieldIdentity") {
                string flg_gep = NT();
                L("  " + flg_gep + " = getelementptr inbounds i8, i8* " + f_slot + ", i64 40");
                string flg_p = NT();
                L("  " + flg_p + " = bitcast i8* " + flg_gep + " to i64*");
                string flgv = NT();
                L("  " + flgv + " = load i64, i64* " + flg_p);
                long bit = mname == "IsFieldIgnored" ? 1
                    : (mname == "IsFieldRequired" ? 2
                    : (mname == "IsFieldPk" ? 4 : 8));
                string msk = NT();
                L("  " + msk + " = and i64 " + flgv + ", " + bit);
                string res = NT();
                L("  " + res + " = icmp ne i64 " + msk + ", 0");
                string z = NT();
                L("  " + z + " = zext i1 " + res + " to i64");
                return new ExprVal(z, MkType("bool"));
            }
            if (mname == "GetFieldDefault") {
                string df_gep = NT();
                L("  " + df_gep + " = getelementptr inbounds i8, i8* " + f_slot + ", i64 48");
                string df_p = NT();
                L("  " + df_p + " = bitcast i8* " + df_gep + " to i8**");
                string df = NT();
                L("  " + df + " = load i8*, i8** " + df_p);
                return new ExprVal(df, MkType("string"));
            }
            if (mname == "GetFieldTypeInfo") {
                string ti_gep = NT();
                L("  " + ti_gep + " = getelementptr inbounds i8, i8* " + f_slot + ", i64 56");
                string ti_p = NT();
                L("  " + ti_p + " = bitcast i8* " + ti_gep + " to i8**");
                string ti = NT();
                L("  " + ti + " = load i8*, i8** " + ti_p);
                return new ExprVal(ti, MkType("TypeInfo"));
            }
            if (mname == "GetFieldCustomAttributes" || mname == "GetFieldAttrs") {
                string fa_gep = NT();
                L("  " + fa_gep + " = getelementptr inbounds i8, i8* " + f_slot + ", i64 64");
                string fa_p = NT();
                L("  " + fa_p + " = bitcast i8* " + fa_gep + " to i8**");
                string fa = NT();
                L("  " + fa + " = load i8*, i8** " + fa_p);
                return new ExprVal(fa, MkType("string"));
            }
        }
        if (mname == "GetCustomAttributes" || mname == "GetAttrs") {
            string ap = NT();
            L("  " + ap + " = getelementptr inbounds i8, i8* " + recv.op + ", i64 -104");
            string ap_ptr = NT();
            L("  " + ap_ptr + " = bitcast i8* " + ap + " to i8**");
            string av = NT();
            L("  " + av + " = load i8*, i8** " + ap_ptr);
            return new ExprVal(av, MkType("string"));
        }
        if (mname == "GetTypeArg") {
            ExprVal idxVal = e.kids.Count > 0 ? GenExpr(e.kids[0]) : new ExprVal("0", MkType("int"));
            string idx64 = ToI64(idxVal);
            int lnull = NL();
            int lload = NL();
            int lend = NL();
            string isNull = NT();
            L("  " + isNull + " = icmp eq i8* " + recv.op + ", null");
            L("  br i1 " + isNull + ", label %L" + lnull + ", label %L" + lload);
            Label(lload);
            string tap = NT();
            L("  " + tap + " = getelementptr inbounds i8, i8* " + recv.op + ", i64 -48");
            string tap_ptr = NT();
            L("  " + tap_ptr + " = bitcast i8* " + tap + " to i8***");
            string tav = NT();
            L("  " + tav + " = load i8**, i8*** " + tap_ptr);
            string isTaNull = NT();
            L("  " + isTaNull + " = icmp eq i8** " + tav + ", null");
            int lok = NL();
            L("  br i1 " + isTaNull + ", label %L" + lnull + ", label %L" + lok);
            Label(lok);
            string item_p = NT();
            L("  " + item_p + " = getelementptr inbounds i8*, i8** " + tav + ", i64 " + idx64);
            string targ = NT();
            L("  " + targ + " = load i8*, i8** " + item_p);
            L("  br label %L" + lend);
            Label(lnull);
            L("  br label %L" + lend);
            Label(lend);
            string resPhi = NT();
            L("  " + resPhi + " = phi i8* [ " + targ + ", %L" + lok + " ], [ null, %L" + lnull + " ]");
            return new ExprVal(resPhi, MkType("TypeInfo"));
        }
        if (mname == "CreateInstance") {
            int lend = NL();
            string resSlot = NT();
            L("  " + resSlot + " = alloca i8*");
            string dfltObj = NT();
            L("  " + dfltObj + " = call i8* @zalloc(i64 8, i8* bitcast (void (i8*)* @__zan_object_dtor to i8*), i8* null)");
            L("  store i8* " + dfltObj + ", i8** " + resSlot);

            int lstart = NL();
            string isNull = NT();
            L("  " + isNull + " = icmp eq i8* " + recv.op + ", null");
            L("  br i1 " + isNull + ", label %L" + lend + ", label %L" + lstart);
            Label(lstart);

            int ci = 0;
            while (ci < tidNames.Count) {
                string cn = tidNames[ci];
                Node cls = binder.FindType(cn);
                if (cls != null && cls.kind == AK.ClassDecl() && !HasMod(cls, MOD.Abstract())) {
                    int lmatch = NL();
                    int lnext = NL();
                    string cnStr = GenStr(cn).op;
                    string eq = NT();
                    L("  " + eq + " = call i32 @strcmp(i8* " + recv.op + ", i8* " + cnStr + ")");
                    string isMatch = NT();
                    L("  " + isMatch + " = icmp eq i32 " + eq + ", 0");
                    L("  br i1 " + isMatch + ", label %L" + lmatch + ", label %L" + lnext);
                    Label(lmatch);

                    string szp = NT();
                    L("  " + szp + " = getelementptr %" + cn + ", %" + cn + "* null, i32 1");
                    string szi = NT();
                    L("  " + szi + " = ptrtoint %" + cn + "* " + szp + " to i64");
                    string raw = NT();
                    L("  " + raw + " = call i8* @zalloc(i64 " + szi + ", i8* bitcast (void (i8*)* @" + cn + "_dtor to i8*), i8* bitcast (i8** @__tid_" + cn + " to i8*))");
                    string obj = NT();
                    L("  " + obj + " = bitcast i8* " + raw + " to %" + cn + "*");
                    InitNestedFields(obj, cls);
                    if (IsPolyClass(cls)) {
                        List<string> vslots = new List<string>();
                        CollectVSlots(cls, vslots);
                        string vtp0 = NT();
                        L("  " + vtp0 + " = getelementptr %" + cn + ", %" + cn + "* " + obj + ", i32 0, i32 0");
                        L("  store i8* bitcast ([" + vslots.Count + " x i8*]* @" + cn + "_vtable to i8*), i8** " + vtp0);
                    }
                    Node pctor = binder.FindCtorArity(cls, e.kids.Count);
                    if (pctor != null) {
                        List<string> cargs = new List<string>();
                        cargs.Add("%" + cn + "* " + obj);
                        int cai = 0;
                        int cpi = 0;
                        while (cpi < pctor.kids.Count && cai < e.kids.Count) {
                            if (pctor.kids[cpi].kind == AK.Param()) {
                                ExprVal av = GenExpr(e.kids[cai]);
                                string pt = MapType(pctor.kids[cpi].type);
                                string cv = Coerce(av, pt);
                                cargs.Add(pt + " " + cv);
                                cai = cai + 1;
                            }
                            cpi = cpi + 1;
                        }
                        StringBuilder callb = new StringBuilder();
                        callb.Append("  call void @" + CtorSym(cn, pctor) + "(");
                        int cj = 0;
                        while (cj < cargs.Count) {
                            if (cj > 0) { callb.Append(", "); }
                            callb.Append(cargs[cj]);
                            cj = cj + 1;
                        }
                        callb.Append(")");
                        L(callb.ToString());
                    } else if (HasChainFieldInits(cls)) {
                        L("  call void @" + FieldInitsSym(cls) + "(%" + cn + "* " + obj + ")");
                    }
                    L("  store i8* " + raw + ", i8** " + resSlot);
                    L("  br label %L" + lend);
                    Label(lnext);
                }
                ci = ci + 1;
            }
            L("  br label %L" + lend);
            Label(lend);
            string ret = NT();
            L("  " + ret + " = load i8*, i8** " + resSlot);
            return new ExprVal(ret, MkType("object"));
        }
        if (mname == "HasField") {
            ExprVal nmVal = e.kids.Count > 0 ? GenExpr(e.kids[0]) : new ExprVal("null", MkType("string"));
            string fp = NT();
            L("  " + fp + " = getelementptr inbounds i8, i8* " + recv.op + ", i64 -40");
            string fp_ptr = NT();
            L("  " + fp_ptr + " = bitcast i8* " + fp + " to i8**");
            string fbase = NT();
            L("  " + fbase + " = load i8*, i8** " + fp_ptr);
            string fcp = NT();
            L("  " + fcp + " = getelementptr inbounds i8, i8* " + recv.op + ", i64 -32");
            string fcp_i64 = NT();
            L("  " + fcp_i64 + " = bitcast i8* " + fcp + " to i64*");
            string fcnt = NT();
            L("  " + fcnt + " = load i64, i64* " + fcp_i64);

            int headLbl = NL();
            int bodyLbl = NL();
            int stepLbl = NL();
            int matchLbl = NL();
            int endLbl = NL();
            string idxSlot = NT();
            L("  " + idxSlot + " = alloca i64");
            L("  store i64 0, i64* " + idxSlot);
            L("  br label %L" + headLbl);
            Label(headLbl);
            string curIdx = NT();
            L("  " + curIdx + " = load i64, i64* " + idxSlot);
            string cond = NT();
            L("  " + cond + " = icmp slt i64 " + curIdx + ", " + fcnt);
            L("  br i1 " + cond + ", label %L" + bodyLbl + ", label %L" + endLbl);
            Label(bodyLbl);
            string curOff = NT();
            L("  " + curOff + " = mul i64 " + curIdx + ", 72");
            string slotP = NT();
            L("  " + slotP + " = getelementptr inbounds i8, i8* " + fbase + ", i64 " + curOff);
            string fnP = NT();
            L("  " + fnP + " = bitcast i8* " + slotP + " to i8**");
            string fldName = NT();
            L("  " + fldName + " = load i8*, i8** " + fnP);
            string eq = NT();
            L("  " + eq + " = call i32 @strcmp(i8* " + fldName + ", i8* " + nmVal.op + ")");
            string isMatch = NT();
            L("  " + isMatch + " = icmp eq i32 " + eq + ", 0");
            L("  br i1 " + isMatch + ", label %L" + matchLbl + ", label %L" + stepLbl);
            Label(stepLbl);
            string nextIdx = NT();
            L("  " + nextIdx + " = add i64 " + curIdx + ", 1");
            L("  store i64 " + nextIdx + ", i64* " + idxSlot);
            L("  br label %L" + headLbl);
            Label(matchLbl);
            L("  br label %L" + endLbl);
            Label(endLbl);
            string phi = NT();
            L("  " + phi + " = phi i1 [ 1, %L" + matchLbl + " ], [ 0, %L" + headLbl + " ]");
            string z = NT();
            L("  " + z + " = zext i1 " + phi + " to i64");
            return new ExprVal(z, MkType("bool"));
        }
        if (mname == "GetMethodName" || mname == "GetMethodReturnType"
            || mname == "GetMethodParamCount" || mname == "IsMethodStatic"
            || mname == "GetMethodCustomAttributes" || mname == "GetMethodAttrs") {
            ExprVal idxVal = e.kids.Count > 0 ? GenExpr(e.kids[0]) : new ExprVal("0", MkType("int"));
            string idx64 = ToI64(idxVal);
            string mp = NT();
            L("  " + mp + " = getelementptr inbounds i8, i8* " + recv.op + ", i64 -88");
            string mp_ptr = NT();
            L("  " + mp_ptr + " = bitcast i8* " + mp + " to i8**");
            string mbase = NT();
            L("  " + mbase + " = load i8*, i8** " + mp_ptr);
            string mo = NT();
            L("  " + mo + " = mul i64 " + idx64 + ", 64");
            string m_slot = NT();
            L("  " + m_slot + " = getelementptr inbounds i8, i8* " + mbase + ", i64 " + mo);

            if (mname == "GetMethodName") {
                string nm_p = NT();
                L("  " + nm_p + " = bitcast i8* " + m_slot + " to i8**");
                string nm = NT();
                L("  " + nm + " = load i8*, i8** " + nm_p);
                return new ExprVal(nm, MkType("string"));
            }
            if (mname == "GetMethodReturnType") {
                string rt_gep = NT();
                L("  " + rt_gep + " = getelementptr inbounds i8, i8* " + m_slot + ", i64 8");
                string rt_p = NT();
                L("  " + rt_p + " = bitcast i8* " + rt_gep + " to i8**");
                string rt = NT();
                L("  " + rt + " = load i8*, i8** " + rt_p);
                return new ExprVal(rt, MkType("string"));
            }
            if (mname == "GetMethodParamCount") {
                string pc_gep = NT();
                L("  " + pc_gep + " = getelementptr inbounds i8, i8* " + m_slot + ", i64 24");
                string pc_p = NT();
                L("  " + pc_p + " = bitcast i8* " + pc_gep + " to i64*");
                string pc = NT();
                L("  " + pc + " = load i64, i64* " + pc_p);
                return new ExprVal(pc, MkType("int"));
            }
            if (mname == "IsMethodStatic") {
                string fl_gep = NT();
                L("  " + fl_gep + " = getelementptr inbounds i8, i8* " + m_slot + ", i64 48");
                string fl_p = NT();
                L("  " + fl_p + " = bitcast i8* " + fl_gep + " to i64*");
                string fl = NT();
                L("  " + fl + " = load i64, i64* " + fl_p);
                string isSt = NT();
                L("  " + isSt + " = and i64 " + fl + ", 1");
                string cmp = NT();
                L("  " + cmp + " = icmp ne i64 " + isSt + ", 0");
                string z = NT();
                L("  " + z + " = zext i1 " + cmp + " to i64");
                return new ExprVal(z, MkType("bool"));
            }
            if (mname == "GetMethodCustomAttributes" || mname == "GetMethodAttrs") {
                string ma_gep = NT();
                L("  " + ma_gep + " = getelementptr inbounds i8, i8* " + m_slot + ", i64 56");
                string ma_p = NT();
                L("  " + ma_p + " = bitcast i8* " + ma_gep + " to i8**");
                string ma = NT();
                L("  " + ma + " = load i8*, i8** " + ma_p);
                return new ExprVal(ma, MkType("string"));
            }
        }
        if (mname == "GetMethodParamType") {
            ExprVal idxVal = e.kids.Count > 0 ? GenExpr(e.kids[0]) : new ExprVal("0", MkType("int"));
            ExprVal pidxVal = e.kids.Count > 1 ? GenExpr(e.kids[1]) : new ExprVal("0", MkType("int"));
            string idx64 = ToI64(idxVal);
            string pidx64 = ToI64(pidxVal);
            string mp = NT();
            L("  " + mp + " = getelementptr inbounds i8, i8* " + recv.op + ", i64 -88");
            string mp_ptr = NT();
            L("  " + mp_ptr + " = bitcast i8* " + mp + " to i8**");
            string mbase = NT();
            L("  " + mbase + " = load i8*, i8** " + mp_ptr);
            string mo = NT();
            L("  " + mo + " = mul i64 " + idx64 + ", 64");
            string m_slot = NT();
            L("  " + m_slot + " = getelementptr inbounds i8, i8* " + mbase + ", i64 " + mo);
            string pt_gep = NT();
            L("  " + pt_gep + " = getelementptr inbounds i8, i8* " + m_slot + ", i64 32");
            string pt_ptr = NT();
            L("  " + pt_ptr + " = bitcast i8* " + pt_gep + " to i8***");
            string pt_arr = NT();
            L("  " + pt_arr + " = load i8**, i8*** " + pt_ptr);
            string item_p = NT();
            L("  " + item_p + " = getelementptr inbounds i8*, i8** " + pt_arr + ", i64 " + pidx64);
            string item = NT();
            L("  " + item + " = load i8*, i8** " + item_p);
            return new ExprVal(item, MkType("string"));
        }
        if (mname == "HasMethod") {
            ExprVal nmVal = e.kids.Count > 0 ? GenExpr(e.kids[0]) : new ExprVal("null", MkType("string"));
            string mp = NT();
            L("  " + mp + " = getelementptr inbounds i8, i8* " + recv.op + ", i64 -88");
            string mp_ptr = NT();
            L("  " + mp_ptr + " = bitcast i8* " + mp + " to i8**");
            string mbase = NT();
            L("  " + mbase + " = load i8*, i8** " + mp_ptr);
            string mcp = NT();
            L("  " + mcp + " = getelementptr inbounds i8, i8* " + recv.op + ", i64 -80");
            string mcp_i64 = NT();
            L("  " + mcp_i64 + " = bitcast i8* " + mcp + " to i64*");
            string mcnt = NT();
            L("  " + mcnt + " = load i64, i64* " + mcp_i64);

            int headLbl = NL();
            int bodyLbl = NL();
            int stepLbl = NL();
            int matchLbl = NL();
            int endLbl = NL();
            string idxSlot = NT();
            L("  " + idxSlot + " = alloca i64");
            L("  store i64 0, i64* " + idxSlot);
            L("  br label %L" + headLbl);
            Label(headLbl);
            string curIdx = NT();
            L("  " + curIdx + " = load i64, i64* " + idxSlot);
            string cond = NT();
            L("  " + cond + " = icmp slt i64 " + curIdx + ", " + mcnt);
            L("  br i1 " + cond + ", label %L" + bodyLbl + ", label %L" + endLbl);
            Label(bodyLbl);
            string curOff = NT();
            L("  " + curOff + " = mul i64 " + curIdx + ", 64");
            string slotP = NT();
            L("  " + slotP + " = getelementptr inbounds i8, i8* " + mbase + ", i64 " + curOff);
            string mnP = NT();
            L("  " + mnP + " = bitcast i8* " + slotP + " to i8**");
            string curMethName = NT();
            L("  " + curMethName + " = load i8*, i8** " + mnP);
            string eq = NT();
            L("  " + eq + " = call i32 @strcmp(i8* " + curMethName + ", i8* " + nmVal.op + ")");
            string isMatch = NT();
            L("  " + isMatch + " = icmp eq i32 " + eq + ", 0");
            L("  br i1 " + isMatch + ", label %L" + matchLbl + ", label %L" + stepLbl);
            Label(stepLbl);
            string nextIdx = NT();
            L("  " + nextIdx + " = add i64 " + curIdx + ", 1");
            L("  store i64 " + nextIdx + ", i64* " + idxSlot);
            L("  br label %L" + headLbl);
            Label(matchLbl);
            L("  br label %L" + endLbl);
            Label(endLbl);
            string phi = NT();
            L("  " + phi + " = phi i1 [ 1, %L" + matchLbl + " ], [ 0, %L" + headLbl + " ]");
            string z = NT();
            L("  " + z + " = zext i1 " + phi + " to i64");
            return new ExprVal(z, MkType("bool"));
        }
        if (mname == "GetCtorParamCount") {
            ExprVal idxVal = e.kids.Count > 0 ? GenExpr(e.kids[0]) : new ExprVal("0", MkType("int"));
            string idx64 = ToI64(idxVal);
            string cp = NT();
            L("  " + cp + " = getelementptr inbounds i8, i8* " + recv.op + ", i64 -72");
            string cp_ptr = NT();
            L("  " + cp_ptr + " = bitcast i8* " + cp + " to i8**");
            string cbase = NT();
            L("  " + cbase + " = load i8*, i8** " + cp_ptr);
            string co = NT();
            L("  " + co + " = mul i64 " + idx64 + ", 56");
            string c_slot = NT();
            L("  " + c_slot + " = getelementptr inbounds i8, i8* " + cbase + ", i64 " + co);
            string pc_gep = NT();
            L("  " + pc_gep + " = getelementptr inbounds i8, i8* " + c_slot + ", i64 24");
            string pc_p = NT();
            L("  " + pc_p + " = bitcast i8* " + pc_gep + " to i64*");
            string pc = NT();
            L("  " + pc + " = load i64, i64* " + pc_p);
            return new ExprVal(pc, MkType("int"));
        }
        if (mname == "GetCtorParamType") {
            ExprVal idxVal = e.kids.Count > 0 ? GenExpr(e.kids[0]) : new ExprVal("0", MkType("int"));
            ExprVal pidxVal = e.kids.Count > 1 ? GenExpr(e.kids[1]) : new ExprVal("0", MkType("int"));
            string idx64 = ToI64(idxVal);
            string pidx64 = ToI64(pidxVal);
            string cp = NT();
            L("  " + cp + " = getelementptr inbounds i8, i8* " + recv.op + ", i64 -72");
            string cp_ptr = NT();
            L("  " + cp_ptr + " = bitcast i8* " + cp + " to i8**");
            string cbase = NT();
            L("  " + cbase + " = load i8*, i8** " + cp_ptr);
            string co = NT();
            L("  " + co + " = mul i64 " + idx64 + ", 56");
            string c_slot = NT();
            L("  " + c_slot + " = getelementptr inbounds i8, i8* " + cbase + ", i64 " + co);
            string pt_gep = NT();
            L("  " + pt_gep + " = getelementptr inbounds i8, i8* " + c_slot + ", i64 32");
            string pt_ptr = NT();
            L("  " + pt_ptr + " = bitcast i8* " + pt_gep + " to i8***");
            string pt_arr = NT();
            L("  " + pt_arr + " = load i8**, i8*** " + pt_ptr);
            string item_p = NT();
            L("  " + item_p + " = getelementptr inbounds i8*, i8** " + pt_arr + ", i64 " + pidx64);
            string item = NT();
            L("  " + item + " = load i8*, i8** " + item_p);
            return new ExprVal(item, MkType("string"));
        }
        diags.Error("TypeInfo method '" + mname + "' is not supported by the self-hosted compiler yet", e.line, e.col);
        return new ExprVal("null", MkType("object"));
    }

    bool MethodAcceptsCall(Node m, Node invCall) {
        if (m == null || invCall == null) { return false; }
        int argc = invCall.kids.Count;
        if (!AcceptsArity(m, argc)) { return false; }
        int i = 0;
        while (i < argc) {
            Node pt = ParamTypeNode(m, i);
            Node arg = invCall.kids[i];
            if (pt != null && arg != null) {
                Node atn = ArgTypeNode(arg);
                if (atn != null && atn.sval != null && atn.sval != "") {
                    // Primitive cannot convert to custom struct/class (unless object or generic)
                    if (binder.IsPrimitive(atn.sval) && !binder.IsPrimitive(pt.sval)
                        && pt.sval != "object" && !MentionsTypeParam(pt)) {
                        return false;
                    }
                    // Custom class cannot convert to primitive
                    if (!binder.IsPrimitive(atn.sval) && binder.IsPrimitive(pt.sval)
                        && atn.sval != "object" && !MentionsTypeParam(pt)) {
                        return false;
                    }
                }
            }
            i = i + 1;
        }
        return true;
    }

    bool ClassHasMethodWithCall(Node cls, string name, Node invCall) {
        Node c = cls;
        while (c != null) {
            int i = 0;
            while (i < c.kids.Count) {
                Node m = c.kids[i];
                if (m.kind == AK.MethodDecl() && m.sval == name && MethodAcceptsCall(m, invCall)) {
                    return true;
                }
                i = i + 1;
            }
            c = BaseClassOf(c);
        }
        return false;
    }

    ExprVal EmitReflInstCall(ExprVal recv, string mname, Node e) {
        if (mname == "HasMethod") {
            string methName = e.kids.Count > 0 && e.kids[0].kind == AK.StringLit() ? e.kids[0].sval : "";
            Node cls0 = ClassOf(recv.ty);
            if (cls0 != null && cls0.sval != "object" && methName != "") {
                return new ExprVal(FindMethodUp(cls0, methName) != null ? "1" : "0", MkType("bool"));
            }
            ExprVal ti = EmitGetType(recv);
            return EmitTypeInfoMethod(ti, "HasMethod", e);
        }

        if (mname == "Invoke" || mname == "InvokeInt" || mname == "InvokeLong"
            || mname == "InvokeDouble" || mname == "InvokeString" || mname == "InvokeObject") {
            string methName = e.kids.Count > 0 && e.kids[0].kind == AK.StringLit() ? e.kids[0].sval : "";
            Node invCall = new Node(AK.Call());
            invCall.line = e.line;
            invCall.col = e.col;
            int ki = 1;
            while (ki < e.kids.Count) {
                invCall.Add(e.kids[ki]);
                ki = ki + 1;
            }

            Node cls0 = ClassOf(recv.ty);
            if (cls0 != null && cls0.sval != "object" && methName != "") {
                Node meth = FindMethodUp(cls0, methName);
                if (meth == null) {
                    if (mname == "Invoke") { return new ExprVal("0", MkType("bool")); }
                    if (mname == "InvokeInt") { return new ExprVal("0", MkType("int")); }
                    if (mname == "InvokeLong") { return new ExprVal("0", MkType("long")); }
                    if (mname == "InvokeDouble") { return new ExprVal("0.0", MkType("double")); }
                    if (mname == "InvokeString") { return GenStr(""); }
                    if (mname == "InvokeObject") { return new ExprVal("null", MkType("object")); }
                }
                ExprVal cres = EmitInstanceCallAs(recv, cls0.sval, methName, invCall, false);
                if (mname == "Invoke") {
                    return new ExprVal("1", MkType("bool"));
                }
                if (mname == "InvokeInt") {
                    return new ExprVal(ToI64(cres), MkType("int"));
                }
                if (mname == "InvokeLong") {
                    string s64 = Coerce(cres, "i64");
                    return new ExprVal(s64, MkType("long"));
                }
                if (mname == "InvokeDouble") {
                    string sd = Coerce(cres, "double");
                    return new ExprVal(sd, MkType("double"));
                }
                if (mname == "InvokeString") {
                    return cres;
                }
                if (mname == "InvokeObject") {
                    string sp = Coerce(cres, "i8*");
                    return new ExprVal(sp, MkType("object"));
                }
            }

            // Fallback for object / dynamic receiver: dispatch through candidate classes in tidNames
            if (methName != "") {
                List<string> cands = new List<string>();
                int tii = 0;
                while (tii < tidNames.Count) {
                    string cn = tidNames[tii];
                    Node cdecl = binder.FindType(cn);
                    if (cdecl != null && ClassHasMethodWithCall(cdecl, methName, invCall)) {
                        cands.Add(cn);
                    }
                    tii = tii + 1;
                }
                if (cands.Count > 0) {
                    string retTyLL = mname == "Invoke" ? "i64" : (mname == "InvokeInt" ? "i64" : (mname == "InvokeLong" ? "i64" : (mname == "InvokeDouble" ? "double" : "i8*")));
                    string dfltVal = (mname == "InvokeDouble") ? "0.0" : ((mname == "InvokeString") ? GenStr("").op : ((mname == "InvokeObject") ? "null" : "0"));
                    string resSlot = NT();
                    L("  " + resSlot + " = alloca " + retTyLL);
                    L("  store " + retTyLL + " " + dfltVal + ", " + retTyLL + "* " + resSlot);

                    string cid = NT();
                    L("  " + cid + " = call i8* @__zan_class_id(i8* " + recv.op + ")");
                    int lend = NL();

                    int ci = 0;
                    while (ci < cands.Count) {
                        string cand = cands[ci];
                        int lmatch = NL();
                        int lnext = NL();
                        string eq = NT();
                        L("  " + eq + " = icmp eq i8* " + cid + ", bitcast (i8** @__tid_" + cand + " to i8*)");
                        L("  br i1 " + eq + ", label %L" + lmatch + ", label %L" + lnext);
                        Label(lmatch);
                        string castRecvOp = NT();
                        L("  " + castRecvOp + " = bitcast i8* " + recv.op + " to %" + cand + "*");
                        ExprVal castRecv = new ExprVal(castRecvOp, MkType(cand));
                        ExprVal cres = EmitInstanceCallAs(castRecv, cand, methName, invCall, false);
                        if (mname == "Invoke") {
                            L("  store i64 1, i64* " + resSlot);
                        } else if (mname == "InvokeInt") {
                            L("  store i64 " + ToI64(cres) + ", i64* " + resSlot);
                        } else if (mname == "InvokeLong") {
                            string s64 = Coerce(cres, "i64");
                            L("  store i64 " + s64 + ", i64* " + resSlot);
                        } else if (mname == "InvokeDouble") {
                            string sd = Coerce(cres, "double");
                            L("  store double " + sd + ", double* " + resSlot);
                        } else if (mname == "InvokeString" || mname == "InvokeObject") {
                            string sptr = Coerce(cres, "i8*");
                            L("  store i8* " + sptr + ", i8** " + resSlot);
                        }
                        L("  br label %L" + lend);
                        Label(lnext);
                        ci = ci + 1;
                    }
                    L("  br label %L" + lend);
                    Label(lend);
                    string retVal = NT();
                    L("  " + retVal + " = load " + retTyLL + ", " + retTyLL + "* " + resSlot);
                    if (mname == "Invoke") { return new ExprVal(retVal, MkType("bool")); }
                    if (mname == "InvokeInt") { return new ExprVal(retVal, MkType("int")); }
                    if (mname == "InvokeLong") { return new ExprVal(retVal, MkType("long")); }
                    if (mname == "InvokeDouble") { return new ExprVal(retVal, MkType("double")); }
                    if (mname == "InvokeString") { return new ExprVal(retVal, MkType("string")); }
                    if (mname == "InvokeObject") { return new ExprVal(retVal, MkType("object")); }
                }
            }
            if (mname == "Invoke") { return new ExprVal("0", MkType("bool")); }
            if (mname == "InvokeInt") { return new ExprVal("0", MkType("int")); }
            if (mname == "InvokeLong") { return new ExprVal("0", MkType("long")); }
            if (mname == "InvokeDouble") { return new ExprVal("0.0", MkType("double")); }
            if (mname == "InvokeObject") { return new ExprVal("null", MkType("object")); }
            return GenStr("");
        }

        string fldName = "";
        if (e.kids.Count > 0 && e.kids[0].kind == AK.StringLit()) {
            fldName = e.kids[0].sval;
        }
        Node cls = ClassOf(recv.ty);
        if (cls != null && fldName != "") {
            int fi = FieldIndex(cls, fldName);
            if (mname == "HasField") {
                if (fi >= 0 || FindMethodUp(cls, "get_" + fldName) != null || FindMethodUp(cls, "set_" + fldName) != null) {
                    return new ExprVal("1", MkType("bool"));
                }
                return new ExprVal("0", MkType("bool"));
            }
            if (fi >= 0) {
                if (mname == "SetFieldString" || mname == "SetFieldInt" || mname == "SetFieldLong"
                    || mname == "SetFieldDouble" || mname == "SetFieldBool" || mname == "SetFieldObject") {
                    ExprVal valArg = e.kids.Count > 1 ? GenExpr(e.kids[1]) : new ExprVal("0", MkType("int"));
                    StoreField(recv.op, cls.sval, fldName, valArg);
                    return new ExprVal("1", MkType("bool"));
                }
                ExprVal fv = LoadField(recv.op, cls, fldName);
                if (mname == "GetFieldString") {
                    if (fv.ty != null && fv.ty.sval == "string") { return fv; }
                    return GenStr("");
                }
                if (mname == "GetFieldInt" || mname == "GetFieldLong") {
                    string t = MapType(fv.ty);
                    if (t == "i64") { return new ExprVal(fv.op, MkType(mname == "GetFieldInt" ? "int" : "long")); }
                    if (t == "i32") {
                        string ex = NT();
                        L("  " + ex + " = sext i32 " + fv.op + " to i64");
                        return new ExprVal(ex, MkType(mname == "GetFieldInt" ? "int" : "long"));
                    }
                    if (t == "double" || t == "float") {
                        string fv2 = fv.op;
                        if (t == "float") {
                            fv2 = NT();
                            L("  " + fv2 + " = fpext float " + fv.op + " to double");
                        }
                        // B-ID180：fp 字段越界 poison 收口，镜像 C 宿主
                        // irgen_reflect.c refl_ld/GetFieldInt 通道。
                        return new ExprVal(EmitFptosiGuarded(e, fv2), MkType(mname == "GetFieldInt" ? "int" : "long"));
                    }
                    return new ExprVal("0", MkType(mname == "GetFieldInt" ? "int" : "long"));
                }
                if (mname == "GetFieldDouble") {
                    string t = MapType(fv.ty);
                    if (t == "double") { return fv; }
                    if (t == "float") {
                        string ex = NT();
                        L("  " + ex + " = fpext float " + fv.op + " to double");
                        return new ExprVal(ex, MkType("double"));
                    }
                    if (t == "i32" || t == "i64") {
                        string ex = NT();
                        L("  " + ex + " = sitofp " + t + " " + fv.op + " to double");
                        return new ExprVal(ex, MkType("double"));
                    }
                    return new ExprVal("0.0", MkType("double"));
                }
                if (mname == "GetFieldBool") {
                    string t = MapType(fv.ty);
                    if (t == "i1") {
                        string z = NT();
                        L("  " + z + " = zext i1 " + fv.op + " to i64");
                        return new ExprVal(z, MkType("bool"));
                    }
                    return new ExprVal("0", MkType("bool"));
                }
                if (mname == "GetFieldObject") {
                    return new ExprVal(fv.op, MkType("object"));
                }
            } else {
                if (mname == "SetFieldString" || mname == "SetFieldInt" || mname == "SetFieldLong"
                    || mname == "SetFieldDouble" || mname == "SetFieldBool" || mname == "SetFieldObject") {
                    Node sm = FindMethodUp(cls, "set_" + fldName);
                    if (sm != null) {
                        Node setCall = new Node(AK.Call());
                        setCall.line = e.line;
                        setCall.col = e.col;
                        if (e.kids.Count > 1) {
                            setCall.Add(e.kids[1]);
                        }
                        EmitInstanceCallAs(recv, cls.sval, "set_" + fldName, setCall, false);
                        return new ExprVal("1", MkType("bool"));
                    }
                }
                if (mname.StartsWith("GetField")) {
                    Node gm = FindMethodUp(cls, "get_" + fldName);
                    if (gm != null) {
                        Node getCall = new Node(AK.Call());
                        getCall.line = e.line;
                        getCall.col = e.col;
                        ExprVal cres = EmitInstanceCallAs(recv, cls.sval, "get_" + fldName, getCall, false);
                        if (mname == "GetFieldString") {
                            if (cres.ty != null && cres.ty.sval == "string") { return cres; }
                            return GenStr("");
                        }
                        if (mname == "GetFieldInt" || mname == "GetFieldLong") {
                            return new ExprVal(ToI64(cres), MkType(mname == "GetFieldInt" ? "int" : "long"));
                        }
                        if (mname == "GetFieldDouble") {
                            string sd = Coerce(cres, "double");
                            return new ExprVal(sd, MkType("double"));
                        }
                        if (mname == "GetFieldBool") {
                            string s64 = Coerce(cres, "i64");
                            return new ExprVal(s64, MkType("bool"));
                        }
                        if (mname == "GetFieldObject") {
                            return new ExprVal(cres.op, MkType("object"));
                        }
                    }
                }
            }
        }
        // Dynamic reflection fallback using TypeInfo & @__zan_refl_field_find
        ExprVal nmVal = e.kids.Count > 0 ? GenExpr(e.kids[0]) : new ExprVal("null", MkType("string"));
        ExprVal vVal = (mname.StartsWith("SetField") && e.kids.Count > 1) ? GenExpr(e.kids[1]) : new ExprVal("0", MkType("int"));
        ExprVal ti = EmitGetType(recv);
        string slotP = NT();
        L("  " + slotP + " = call i8* @__zan_refl_field_find(i8* " + ti.op + ", i8* " + nmVal.op + ")");
        string hit = NT();
        L("  " + hit + " = icmp ne i8* " + slotP + ", null");

        if (mname == "HasField") {
            string z = NT();
            L("  " + z + " = zext i1 " + hit + " to i64");
            return new ExprVal(z, MkType("bool"));
        }

        if (mname == "SetFieldString" || mname == "SetFieldInt" || mname == "SetFieldLong"
            || mname == "SetFieldDouble" || mname == "SetFieldBool" || mname == "SetFieldObject") {
            int lset = NL();
            int lend = NL();
            L("  br i1 " + hit + ", label %L" + lset + ", label %L" + lend);
            Label(lset);
            string foff_p = NT();
            L("  " + foff_p + " = getelementptr inbounds i8, i8* " + slotP + ", i64 24");
            string foff_i64 = NT();
            L("  " + foff_i64 + " = bitcast i8* " + foff_p + " to i64*");
            string foff = NT();
            L("  " + foff + " = load i64, i64* " + foff_i64);

            string fkind_p = NT();
            L("  " + fkind_p + " = getelementptr inbounds i8, i8* " + slotP + ", i64 16");
            string fkind_i64 = NT();
            L("  " + fkind_i64 + " = bitcast i8* " + fkind_p + " to i64*");
            string fkind = NT();
            L("  " + fkind + " = load i64, i64* " + fkind_i64);

            string rop = NT();
            L("  " + rop + " = bitcast " + MapType(recv.ty) + " " + recv.op + " to i8*");
            string fp = NT();
            L("  " + fp + " = getelementptr inbounds i8, i8* " + rop + ", i64 " + foff);

            if (mname == "SetFieldString") {
                string sp = NT();
                L("  " + sp + " = bitcast i8* " + fp + " to i8**");
                string valOp = NT();
                L("  " + valOp + " = bitcast " + MapType(vVal.ty) + " " + vVal.op + " to i8*");
                L("  store i8* " + valOp + ", i8** " + sp);
            } else if (mname == "SetFieldObject") {
                string sp = NT();
                L("  " + sp + " = bitcast i8* " + fp + " to i8**");
                string valOp = NT();
                L("  " + valOp + " = bitcast " + MapType(vVal.ty) + " " + vVal.op + " to i8*");
                L("  store i8* " + valOp + ", i8** " + sp);
                L("  call void @zretain(i8* " + valOp + ")");
            } else if (mname == "SetFieldBool") {
                string val1 = NT();
                L("  " + val1 + " = icmp ne i64 " + vVal.op + ", 0");
                string val8 = NT();
                L("  " + val8 + " = zext i1 " + val1 + " to i8");
                L("  store i8 " + val8 + ", i8* " + fp);
            } else if (mname == "SetFieldInt" || mname == "SetFieldLong") {
                int l1 = NL();
                int l2 = NL();
                int l4 = NL();
                int l8 = NL();
                int ldone = NL();
                string is1 = NT(); L("  " + is1 + " = icmp eq i64 " + fkind + ", 1");
                string isByte = NT(); L("  " + isByte + " = icmp eq i64 " + fkind + ", 3");
                string isSbyte = NT(); L("  " + isSbyte + " = icmp eq i64 " + fkind + ", 2");
                string is1a = NT(); L("  " + is1a + " = or i1 " + is1 + ", " + isByte);
                string is1Tot = NT(); L("  " + is1Tot + " = or i1 " + is1a + ", " + isSbyte);
                L("  br i1 " + is1Tot + ", label %L" + l1 + ", label %L" + l2);

                Label(l1);
                string val8 = NT(); L("  " + val8 + " = trunc i64 " + vVal.op + " to i8");
                L("  store i8 " + val8 + ", i8* " + fp);
                L("  br label %L" + ldone);

                Label(l2);
                string isShort = NT(); L("  " + isShort + " = icmp eq i64 " + fkind + ", 4");
                string isUshort = NT(); L("  " + isUshort + " = icmp eq i64 " + fkind + ", 5");
                string is2Tot = NT(); L("  " + is2Tot + " = or i1 " + isShort + ", " + isUshort);
                int l2body = NL();
                L("  br i1 " + is2Tot + ", label %L" + l2body + ", label %L" + l4);

                Label(l2body);
                string val16 = NT(); L("  " + val16 + " = trunc i64 " + vVal.op + " to i16");
                string p16 = NT(); L("  " + p16 + " = bitcast i8* " + fp + " to i16*");
                L("  store i16 " + val16 + ", i16* " + p16);
                L("  br label %L" + ldone);

                Label(l4);
                string isInt = NT(); L("  " + isInt + " = icmp eq i64 " + fkind + ", 6");
                string isUint = NT(); L("  " + isUint + " = icmp eq i64 " + fkind + ", 7");
                string isEnum = NT(); L("  " + isEnum + " = icmp eq i64 " + fkind + ", 11");
                string is4a = NT(); L("  " + is4a + " = or i1 " + isInt + ", " + isUint);
                string is4Tot = NT(); L("  " + is4Tot + " = or i1 " + is4a + ", " + isEnum);
                int l4body = NL();
                L("  br i1 " + is4Tot + ", label %L" + l4body + ", label %L" + l8);

                Label(l4body);
                string val32 = NT(); L("  " + val32 + " = trunc i64 " + vVal.op + " to i32");
                string p32 = NT(); L("  " + p32 + " = bitcast i8* " + fp + " to i32*");
                L("  store i32 " + val32 + ", i32* " + p32);
                L("  br label %L" + ldone);

                Label(l8);
                string p64 = NT(); L("  " + p64 + " = bitcast i8* " + fp + " to i64*");
                L("  store i64 " + vVal.op + ", i64* " + p64);
                L("  br label %L" + ldone);

                Label(ldone);
            } else if (mname == "SetFieldDouble") {
                int lflt = NL();
                int ldbl = NL();
                int ldone = NL();
                string isFlt = NT(); L("  " + isFlt + " = icmp eq i64 " + fkind + ", 12");
                L("  br i1 " + isFlt + ", label %L" + lflt + ", label %L" + ldbl);
                Label(lflt);
                string valF = NT(); L("  " + valF + " = fptrunc double " + vVal.op + " to float");
                string pF = NT(); L("  " + pF + " = bitcast i8* " + fp + " to float*");
                L("  store float " + valF + ", float* " + pF);
                L("  br label %L" + ldone);
                Label(ldbl);
                string pD = NT(); L("  " + pD + " = bitcast i8* " + fp + " to double*");
                L("  store double " + vVal.op + ", double* " + pD);
                L("  br label %L" + ldone);
                Label(ldone);
            }
            L("  br label %L" + lend);
            Label(lend);
            string retZ = NT();
            L("  " + retZ + " = zext i1 " + hit + " to i64");
            return new ExprVal(retZ, MkType("bool"));
        }

        string resSlot = NT();
        if (mname == "GetFieldString") {
            L("  " + resSlot + " = alloca i8*");
            L("  store i8* " + GenStr("").op + ", i8** " + resSlot);
            int lget = NL();
            int lend = NL();
            L("  br i1 " + hit + ", label %L" + lget + ", label %L" + lend);
            Label(lget);
            string foff_p = NT(); L("  " + foff_p + " = getelementptr inbounds i8, i8* " + slotP + ", i64 24");
            string foff_i64 = NT(); L("  " + foff_i64 + " = bitcast i8* " + foff_p + " to i64*");
            string foff = NT(); L("  " + foff + " = load i64, i64* " + foff_i64);
            string rop = NT(); L("  " + rop + " = bitcast " + MapType(recv.ty) + " " + recv.op + " to i8*");
            string fp = NT(); L("  " + fp + " = getelementptr inbounds i8, i8* " + rop + ", i64 " + foff);
            string sp = NT(); L("  " + sp + " = bitcast i8* " + fp + " to i8**");
            string val = NT(); L("  " + val + " = load i8*, i8** " + sp);
            L("  store i8* " + val + ", i8** " + resSlot);
            L("  br label %L" + lend);
            Label(lend);
            string ret = NT(); L("  " + ret + " = load i8*, i8** " + resSlot);
            return new ExprVal(ret, MkType("string"));
        }

        if (mname == "GetFieldInt" || mname == "GetFieldLong" || mname == "GetFieldBool") {
            L("  " + resSlot + " = alloca i64");
            L("  store i64 0, i64* " + resSlot);
            int lget = NL();
            int lend = NL();
            L("  br i1 " + hit + ", label %L" + lget + ", label %L" + lend);
            Label(lget);
            string foff_p = NT(); L("  " + foff_p + " = getelementptr inbounds i8, i8* " + slotP + ", i64 24");
            string foff_i64 = NT(); L("  " + foff_i64 + " = bitcast i8* " + foff_p + " to i64*");
            string foff = NT(); L("  " + foff + " = load i64, i64* " + foff_i64);
            string fkind_p = NT(); L("  " + fkind_p + " = getelementptr inbounds i8, i8* " + slotP + ", i64 16");
            string fkind_i64 = NT(); L("  " + fkind_i64 + " = bitcast i8* " + fkind_p + " to i64*");
            string fkind = NT(); L("  " + fkind + " = load i64, i64* " + fkind_i64);

            string rop = NT(); L("  " + rop + " = bitcast " + MapType(recv.ty) + " " + recv.op + " to i8*");
            string fp = NT(); L("  " + fp + " = getelementptr inbounds i8, i8* " + rop + ", i64 " + foff);

            int l1 = NL();
            int l2 = NL();
            int l4 = NL();
            int l8 = NL();
            int ldone = NL();

            string is1 = NT(); L("  " + is1 + " = icmp eq i64 " + fkind + ", 1");
            string isByte = NT(); L("  " + isByte + " = icmp eq i64 " + fkind + ", 3");
            string isSbyte = NT(); L("  " + isSbyte + " = icmp eq i64 " + fkind + ", 2");
            string is1a = NT(); L("  " + is1a + " = or i1 " + is1 + ", " + isByte);
            string is1Tot = NT(); L("  " + is1Tot + " = or i1 " + is1a + ", " + isSbyte);
            L("  br i1 " + is1Tot + ", label %L" + l1 + ", label %L" + l2);

            Label(l1);
            string v8 = NT(); L("  " + v8 + " = load i8, i8* " + fp);
            int lsb = NL(); int lub = NL();
            L("  br i1 " + isSbyte + ", label %L" + lsb + ", label %L" + lub);
            Label(lsb);
            string ex_sb = NT(); L("  " + ex_sb + " = sext i8 " + v8 + " to i64");
            L("  store i64 " + ex_sb + ", i64* " + resSlot);
            L("  br label %L" + ldone);
            Label(lub);
            string ex_ub = NT(); L("  " + ex_ub + " = zext i8 " + v8 + " to i64");
            L("  store i64 " + ex_ub + ", i64* " + resSlot);
            L("  br label %L" + ldone);

            Label(l2);
            string isShort = NT(); L("  " + isShort + " = icmp eq i64 " + fkind + ", 4");
            string isUshort = NT(); L("  " + isUshort + " = icmp eq i64 " + fkind + ", 5");
            string is2Tot = NT(); L("  " + is2Tot + " = or i1 " + isShort + ", " + isUshort);
            int l2body = NL();
            L("  br i1 " + is2Tot + ", label %L" + l2body + ", label %L" + l4);

            Label(l2body);
            string p16 = NT(); L("  " + p16 + " = bitcast i8* " + fp + " to i16*");
            string v16 = NT(); L("  " + v16 + " = load i16, i16* " + p16);
            int lsh = NL(); int lush = NL();
            L("  br i1 " + isShort + ", label %L" + lsh + ", label %L" + lush);
            Label(lsh);
            string ex_sh = NT(); L("  " + ex_sh + " = sext i16 " + v16 + " to i64");
            L("  store i64 " + ex_sh + ", i64* " + resSlot);
            L("  br label %L" + ldone);
            Label(lush);
            string ex_ush = NT(); L("  " + ex_ush + " = zext i16 " + v16 + " to i64");
            L("  store i64 " + ex_ush + ", i64* " + resSlot);
            L("  br label %L" + ldone);

            Label(l4);
            string isInt = NT(); L("  " + isInt + " = icmp eq i64 " + fkind + ", 6");
            string isUint = NT(); L("  " + isUint + " = icmp eq i64 " + fkind + ", 7");
            string isEnum = NT(); L("  " + isEnum + " = icmp eq i64 " + fkind + ", 11");
            string is4a = NT(); L("  " + is4a + " = or i1 " + isInt + ", " + isUint);
            string is4Tot = NT(); L("  " + is4Tot + " = or i1 " + is4a + ", " + isEnum);
            int l4body = NL();
            L("  br i1 " + is4Tot + ", label %L" + l4body + ", label %L" + l8);

            Label(l4body);
            string p32 = NT(); L("  " + p32 + " = bitcast i8* " + fp + " to i32*");
            string v32 = NT(); L("  " + v32 + " = load i32, i32* " + p32);
            int lin = NL(); int luin = NL();
            string isSigned32 = NT(); L("  " + isSigned32 + " = or i1 " + isInt + ", " + isEnum);
            L("  br i1 " + isSigned32 + ", label %L" + lin + ", label %L" + luin);
            Label(lin);
            string ex_in = NT(); L("  " + ex_in + " = sext i32 " + v32 + " to i64");
            L("  store i64 " + ex_in + ", i64* " + resSlot);
            L("  br label %L" + ldone);
            Label(luin);
            string ex_uin = NT(); L("  " + ex_uin + " = zext i32 " + v32 + " to i64");
            L("  store i64 " + ex_uin + ", i64* " + resSlot);
            L("  br label %L" + ldone);

            Label(l8);
            string p64 = NT(); L("  " + p64 + " = bitcast i8* " + fp + " to i64*");
            string v64 = NT(); L("  " + v64 + " = load i64, i64* " + p64);
            L("  store i64 " + v64 + ", i64* " + resSlot);
            L("  br label %L" + ldone);

            Label(ldone);
            L("  br label %L" + lend);
            Label(lend);
            string ret = NT(); L("  " + ret + " = load i64, i64* " + resSlot);
            if (mname == "GetFieldBool") {
                string bcmp = NT(); L("  " + bcmp + " = icmp ne i64 " + ret + ", 0");
                string bz = NT(); L("  " + bz + " = zext i1 " + bcmp + " to i64");
                return new ExprVal(bz, MkType("bool"));
            }
            return new ExprVal(ret, MkType(mname == "GetFieldLong" ? "long" : "int"));
        }

        if (mname == "GetFieldDouble") {
            L("  " + resSlot + " = alloca double");
            L("  store double 0.0, double* " + resSlot);
            int lget = NL();
            int lend = NL();
            L("  br i1 " + hit + ", label %L" + lget + ", label %L" + lend);
            Label(lget);
            string foff_p = NT(); L("  " + foff_p + " = getelementptr inbounds i8, i8* " + slotP + ", i64 24");
            string foff_i64 = NT(); L("  " + foff_i64 + " = bitcast i8* " + foff_p + " to i64*");
            string foff = NT(); L("  " + foff + " = load i64, i64* " + foff_i64);
            string fkind_p = NT(); L("  " + fkind_p + " = getelementptr inbounds i8, i8* " + slotP + ", i64 16");
            string fkind_i64 = NT(); L("  " + fkind_i64 + " = bitcast i8* " + fkind_p + " to i64*");
            string fkind = NT(); L("  " + fkind + " = load i64, i64* " + fkind_i64);

            string rop = NT(); L("  " + rop + " = bitcast " + MapType(recv.ty) + " " + recv.op + " to i8*");
            string fp = NT(); L("  " + fp + " = getelementptr inbounds i8, i8* " + rop + ", i64 " + foff);

            int lflt = NL(); int ldbl = NL(); int ldone = NL();
            string isFlt = NT(); L("  " + isFlt + " = icmp eq i64 " + fkind + ", 12");
            L("  br i1 " + isFlt + ", label %L" + lflt + ", label %L" + ldbl);
            Label(lflt);
            string pFlt = NT(); L("  " + pFlt + " = bitcast i8* " + fp + " to float*");
            string vFlt = NT(); L("  " + vFlt + " = load float, float* " + pFlt);
            string exFlt = NT(); L("  " + exFlt + " = fpext float " + vFlt + " to double");
            L("  store double " + exFlt + ", double* " + resSlot);
            L("  br label %L" + ldone);
            Label(ldbl);
            string pDbl = NT(); L("  " + pDbl + " = bitcast i8* " + fp + " to double*");
            string vDbl = NT(); L("  " + vDbl + " = load double, double* " + pDbl);
            L("  store double " + vDbl + ", double* " + resSlot);
            L("  br label %L" + ldone);
            Label(ldone);
            L("  br label %L" + lend);
            Label(lend);
            string ret = NT(); L("  " + ret + " = load double, double* " + resSlot);
            return new ExprVal(ret, MkType("double"));
        }

        if (mname == "GetFieldObject") {
            L("  " + resSlot + " = alloca i8*");
            L("  store i8* null, i8** " + resSlot);
            int lget = NL();
            int lend = NL();
            L("  br i1 " + hit + ", label %L" + lget + ", label %L" + lend);
            Label(lget);
            string foff_p = NT(); L("  " + foff_p + " = getelementptr inbounds i8, i8* " + slotP + ", i64 24");
            string foff_i64 = NT(); L("  " + foff_i64 + " = bitcast i8* " + foff_p + " to i64*");
            string foff = NT(); L("  " + foff + " = load i64, i64* " + foff_i64);
            string rop = NT(); L("  " + rop + " = bitcast " + MapType(recv.ty) + " " + recv.op + " to i8*");
            string fp = NT(); L("  " + fp + " = getelementptr inbounds i8, i8* " + rop + ", i64 " + foff);
            string sp = NT(); L("  " + sp + " = bitcast i8* " + fp + " to i8**");
            string val = NT(); L("  " + val + " = load i8*, i8** " + sp);
            L("  store i8* " + val + ", i8** " + resSlot);
            L("  br label %L" + lend);
            Label(lend);
            string ret = NT(); L("  " + ret + " = load i8*, i8** " + resSlot);
            return new ExprVal(ret, MkType("object"));
        }

        return new ExprVal("null", MkType("object"));
    }

}
