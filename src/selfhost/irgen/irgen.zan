using System;
using System.Collections.Generic;
using System.Diagnostics;
namespace Zan;

// A generated value: its LLVM operand text plus the source type node it has.
public class ExprVal {
    public string op;
    public Node ty;
    // The width in bits of the value's CARRIER -- the C host's LLVM storage
    // width -- when it differs from the type-level width of `ty`. 0 means
    // "take the width from `ty`". An arithmetic RESULT needs this: the host
    // computes `int a; a * 3` in 64 bits (the literal is an i64) while the
    // expression's type stays `int`, and the parent operation must see the
    // 64-bit carrier, not the 32-bit type.
    public int wbits;
    // true when the value is the FRAME POINTER of an async call (the ramp
    // allocates the frame; the body runs from $resume). The call site hands
    // such a frame to the scheduler when the call is a fire-and-forget
    // statement.
    public bool asyncCall;
    // Statement-temp registry slot owning this exact produced value, or empty.
    public string ownerTemp;
    public ExprVal(string o, Node t) { op = o; ty = t; }
}

// A reachable extern declaration and its emitted linker symbol.
public class NativeImport {
    public string symbol;
    public Node method;

    public NativeImport(string symbol, Node method) {
        this.symbol = symbol;
        this.method = method;
    }
}

// IR backend: lowers the bound AST to LLVM IR text. Mirrors src/compiler/
// irgen.c for the bootstrap subset. Integer/bool/char/enum are i64; string is
// i8*; class/struct instances are heap objects referenced by %Name*; List<T>
// is a growable i64-slot runtime array referenced by i8* (pointer elements are
// stored via ptrtoint / read back via inttoptr).
partial class Irgen {
    public Binder binder;
    // The gen1 IR is compiled and run on the same host as this compiler, so
    // OS-specific runtime shims (console code page, timers, sleep) follow the
    // host platform: a drive-letter ExeDir means Windows, else POSIX.
    public bool hostWin;
    public Diags diags;
    public StringBuilder head;
    public StringBuilder body;
    StringBuilder rawStringGlobals;
    public int tmp;
    public int lbl;
    public int strn;
    // folded static-array globals (G8 round 1): module-level unique names
    public int starrn;
    // library output (--emit-lib): skip whole-module dead-code pruning, a
    // lib's exported API is referenced from outside the module
    public bool libOut;
    // the strcasecmp weak shim is emitted at most once
    public bool strcasecmpDone;
    // B-ID180：GuardDivisor 的 unsafe 谓词（零除或 MIN/-1），供调用方在
    // sdiv/srem 之后把商归一化为 0（C 宿主 irgen_expr_ops.c 的
    // divz.res / remz.res select——自举端曾漏商替换，零除得被除数本身、
    // MIN/-1 得 MIN，与宿主商 0 口径不一致）。
    public string divUnsafe;
    // the printf pattern globals for the interpolated-string format
    // specifiers (one per distinct pattern)
    public int fmtSeq;
    public bool term;
    public string curClass;
    public string curRet;
    public Node curRetTy;      // the current method's declared return type
    public bool curHasThis;
    public List<string> locName;
    public List<Node> locType;
    public List<string> locReg;
    // closure capture: a local a closure may capture lives in a heap cell
    // (locBox), and a per-iteration variable (for/foreach) is snapshotted
    // into a fresh cell per capture (locIter). locCell is the cell address.
    public List<bool> locBox;
    public List<bool> locIter;
    public List<string> locCell;
    // a by-ref (`ref`/`out`) parameter: the local's register is the ADDRESS
    // of the caller's storage, so reads/writes go through it and the
    // reference stays the caller's (the callee never releases it)
    public List<bool> locRef;
    public List<bool> locOpaque;
    // names a closure inside the current function may capture: a local with
    // one of these names has to live in a cell
    public List<string> capNames;
    public int locSeq;
    // the user-defined conversion operator found by the last lookup: the
    // declaring class (its symbol names the definition) and whether the
    // last ApplyUserConv actually applied one
    public string convOwner;
    public bool convApplied;
    public int qdotSeq;
    public string curLbl;
    public int brkTarget;
    public int contTarget;
    public List<string> tparamNames;
    // the class whose scope the types being mapped are written in. A method's
    // OWN declared types live in the DECLARING class's scope, where a type
    // parameter shadows a user type of the same name; "" means "the class
    // being emitted".
    public string typeScopeCls;
    // the method declaration being emitted: its own type parameters (and
    // their constraints) shadow the class's, so the constraint lookup is
    // scope-correct
    public Node curMethodNode;
    // the receiver's STATIC type in the method being emitted. For a
    // specialized clone of a generic class it carries the concrete type
    // arguments (`Pool<string>`), so a field read resolves the real value
    // type; for an ordinary method it is the class itself.
    public Node curThisTy;
    // method-level monomorphization: specialized clones pending emission
    public List<Node> specMs;
    public List<Node> specClss;
    public List<string> specSyms;
    // the try statements we are lexically inside of, innermost last. Each
    // entry carries the try's finally body (null when it has none) and
    // whether its EH frame is still pushed. A `return` (or a break/continue)
    // that leaves the try region must run the finally bodies on this stack --
    // the C host does, and skipping them leaves a lock held (a
    // `try { return x; } finally { Unlock(); }` would deadlock the next
    // Lock forever).
    public string syncPendingReturn;
    public SyncFlowContext syncFlow;
    public List<Node> finBodies;
    public List<int> finLive;
    public List<int> finActive;
    public List<string> finMonSlot;
    // the exception value/tid each enclosing catch clause caught: a bare
    // `throw;` re-raises the innermost one (a nested try inside the clause
    // body overwrites the in-flight globals)
    public List<string> catchExcVal;
    public List<string> catchExcTid;
    public List<string> catchExcOwner;
    public List<string> pendingExcOwner;
    // the type binding of the last class-level specialization (the indexer
    // and property paths use it to map the clone's own types)
    public List<string> csNames;
    public List<Node> csReps;
    // the finally-stack depth at the entry of the innermost loop: a
    // break/continue runs only the finallys opened inside that loop
    public int brkFinBase;
    public int contFinBase;
    // the receiver's static type of each specialized clone (the concrete
    // instantiation of the class, when the clone specializes a generic class)
    public List<Node> specThis;
    // class-level monomorphization of CONSTRUCTORS: a generic class'
    // constructor is shared by every instantiation, so the collections it
    // creates would not know their element type (a list of objects would not
    // own them). The C host specializes the constructor per instantiation
    // (src/compiler/irgen_expr.c: find_generic_ctor); these are the pending
    // specialized constructors.
    public List<Node> specCtors;
    public List<Node> specCtorCls;
    public List<Node> specCtorThis;
    public List<string> specCtorSyms;
    // B-ID216: class-level monomorphization of the FIELD-INITIALIZER helper.
    // A generic class with an implicit parameterless constructor runs its
    // `new T[n]` initializers through the shared helper, which allocates the
    // array with the ERASED element type: the descriptor's accept predicate
    // is generated for the open parameter and rejects every reference-element
    // store ("array element type mismatch"), and ARC never retains. Like the
    // constructor, the helper is specialized per instantiation; these are the
    // pending specialized helpers.
    public List<Node> specFinits;
    public List<Node> specFinitCls;
    public List<Node> specFinitThis;
    public List<string> specFinitSyms;
    // B-ID218: per-instantiation VTABLES of the generic classes. A generic
    // class's virtual methods share ONE declaration-form vtable whose slots
    // point at the erased bodies -- an override body reading its type
    // parameter (`o is T`) folds to a constant, and every instantiation
    // answers it the same way. An instantiation whose virtual bodies mention
    // the type parameters gets its own table (slots pointing at the
    // specialized clones, mirroring the ctor/finit specialization); these
    // are the pending per-instantiation tables.
    public List<Node> specVtCls;
    public List<Node> specVtArgs;
    public List<string> specVtSyms;
    List<ClosedInterfaceDispatch> closedInterfaceDispatches = new List<ClosedInterfaceDispatch>();
    // the symbol of the constructor being emitted ("" = the shared one)
    public string curCtorSym;
    // the instantiations of generic classes the program uses: the class name
    // and the container of its concrete type arguments. A generic class's
    // static storage exists PER INSTANTIATION (the C host mangles the static
    // names with the instantiation suffix), so the backend has to know every
    // instantiation before it emits the globals and the static initializers.
    public List<string> instClasses;
    public List<Node> instConts;
    public List<string> instKeys;
    public List<string> declaredStaticGlobals;
    // Startup demand is separate from metadata/code retention. Entries are
    // declaration owners paired with concrete class arguments, never open T.
    public List<Node> sinitTypes;
    public List<string> sinitSyms;
    public List<Node> sinitDispatchTypes;
    public List<Node> sinitDispatchMethods;
    public List<string> sinitDispatchTargets;
    public List<string> sinitDispatchTables;
    public List<int> sinitDispatchSlots;
    public List<string> sinitVtableTargets;
    public List<string> sinitExportRoots;
    public List<string> moduleInitSyms;
    public int nativeLibraryDependencyLine;
    // the class instantiation of the method being emitted: a specialized clone
    // of a generic class (`Stat<int>`) carries its concrete type arguments, so
    // a bare static field inside it names that instantiation's own storage
    public List<Node> curInstArgs;
    public string curInstCls;
    public StringBuilder deferred; // hoisted lambda function definitions
    public StringBuilder entryAllocas; // per-function allocas hoisted to entry
    public bool eaActive;
    public int lamCount;
    public List<string> stmtTemps;
    // GenIf sets it while its condition is generated: a pattern variable
    // declared there owns its value (GenIs) and dies with the if statement.
    public bool ifCondOwnsPattern;
    public List<int> ifCondPatternLocs;
    public List<string> stmtTempValues;
    public List<string> stmtTempOwners;
    public List<Node> stmtTempTypes;
    public int loopScopeBase;
    public List<string> externDecls; // extern C symbols already `declare`d
    public bool collectNativeImports;
    Dictionary<string, Node> nativeExterns;
    public List<NativeImport> liveNativeExterns;
    public List<string> liveNativeDefinitions;
    public bool curAsync;
    public string curResumeSym;
    public int curSubBase;
    public int curAwaitSeq;
    public bool usesAsync;
    public bool usesDirList;
    public bool usesStrOps; // Trim/ToUpper/ToLower/Replace/LastIndexOf helpers
    public bool conSlots; // Console.ForegroundColor/BackgroundColor slots emitted
    List<string> mgTargets; // method-group thunks already emitted
    public List<string> asyncSlotReg;
    public List<Node> asyncSlotTy;
    public List<int> asyncSlotIdx;
    public int asyncExceptionBase;
    public int asyncOwnerMarkBase;
    public int asyncPendingBase;
    public int asyncPendingHandlerBase;
    public int asyncPendingFinallyBase;
    public List<int> asyncCatchEntries;
    public int asyncExceptionDepth;
    public List<Node> asyncCatchBindings;
    public List<string> asyncLocalRegs;
    public List<bool> asyncLocalBox;
    public List<Node> asyncLocalTypes;
    // indexes (into lnames) of the locals of the current async method that a
    // closure captured: they live in a heap cell, so the cleanup function has
    // to release the value INSIDE the cell, not the cell pointer
    public List<int> asyncBoxIdx;
    public int asyncForeachBase;   // first frame slot of the foreach loop temps
    public int asyncForeachNext;   // next foreach temp slot to hand out
    public bool curAsyncThis;
    public int curAsyncThisSlot;
    public Node curAsyncThisTy;
    // B-ID64 镜像：当前 async 方法的结果元素类型（Task<T> 的 T）。完成尾声
    // 判自等待者（fire-and-forget）时按它释放槽 6 的无人认领结果载荷。
    public Node curAsyncRetElem;
    // The catch labels of the try blocks that enclose the point being
    // generated (async methods only). A suspension inside a try body kills
    // the invocation that armed the handler, so the handler has to be armed
    // again on every resume -- the list says which catch each re-armed
    // handler belongs to.
    public List<int> asyncTryLbl;
    // The alloca that holds the exception-stack depth the current resume
    // invocation started at: the handlers this invocation arms live above
    // it, and the depth is restored to it when the invocation suspends.
    public string asyncEhDepth;
    // The landing block of the coroutine's trampoline handler: an exception
    // that no try block of the coroutine catches leaves the coroutine
    // through the frame there.
    public int asyncTrampLbl;
    public List<string> gotoNames; // per-function goto label name -> id
    public List<int> gotoIds;
    public List<string> finLocalLabels; // labels defined inside inlined finally bodies
    public int finLabelScope;
    public int finLabelSeq;
    public bool crc32cEmitted; // CRC32C instruction fallback table emitted once
    public bool copy2dEmitted; // NativeMemory.Copy2D helper emitted once
    public List<string> tidNames; // classes whose @__tid_X global was emitted
    public List<string> reflMetaNames;
    public List<string> reflMetaGvs;
    public int reflMetaSeq;

    public Irgen(Binder b, Diags d) {
        binder = b; diags = d;
        reflMetaNames = new List<string>();
        reflMetaGvs = new List<string>();
        reflMetaSeq = 0;
        gotoNames = new List<string>();
        gotoIds = new List<int>();
        finLocalLabels = new List<string>();
        finLabelScope = 0;
        finLabelSeq = 0;
        head = new StringBuilder(); body = new StringBuilder();
        rawStringGlobals = new StringBuilder();
        deferred = new StringBuilder(); lamCount = 0;
        entryAllocas = new StringBuilder(); eaActive = false;
        tmp = 0; lbl = 0; strn = 0; term = false;
        curClass = ""; curRet = "void"; curHasThis = false;
        curRetTy = null;
        locName = new List<string>();
        locType = new List<Node>();
        locReg = new List<string>();
        locBox = new List<bool>();
        locIter = new List<bool>();
        locCell = new List<string>();
        locRef = new List<bool>();
        locOpaque = new List<bool>();
        capNames = new List<string>();
        locSeq = 0;
        qdotSeq = 0;
        curAsync = false; usesAsync = false; usesDirList = false; usesStrOps = false;
        gcProbeUsed = false;
        gcTyCids = new List<string>();
        gcTyNames = new List<string>();
        gcTyWalks = new List<string>();
        mgTargets = new List<string>();
        curLbl = "entry";
        brkTarget = 0; contTarget = 0;
        tparamNames = new List<string>();
        typeScopeCls = "";
        curMethodNode = null;
        curThisTy = null;
        specMs = new List<Node>();
        specClss = new List<Node>();
        specThis = new List<Node>();
        specSyms = new List<string>();
        specCtors = new List<Node>();
        specCtorCls = new List<Node>();
        specCtorThis = new List<Node>();
        specCtorSyms = new List<string>();
        specFinits = new List<Node>();
        specFinitCls = new List<Node>();
        specFinitThis = new List<Node>();
        specFinitSyms = new List<string>();
        specVtCls = new List<Node>();
        specVtArgs = new List<Node>();
        specVtSyms = new List<string>();
        curCtorSym = "";
        instClasses = new List<string>();
        instConts = new List<Node>();
        instKeys = new List<string>();
        declaredStaticGlobals = new List<string>();
        sinitTypes = new List<Node>();
        sinitSyms = new List<string>();
        sinitDispatchTypes = new List<Node>();
        sinitDispatchMethods = new List<Node>();
        sinitDispatchTargets = new List<string>();
        sinitDispatchTables = new List<string>();
        sinitDispatchSlots = new List<int>();
        sinitVtableTargets = new List<string>();
        sinitExportRoots = new List<string>();
        moduleInitSyms = new List<string>();
        curInstArgs = new List<Node>();
        curInstCls = "";
        finBodies = new List<Node>();
        finLive = new List<int>();
        finActive = new List<int>();
        finMonSlot = new List<string>();
        catchExcVal = new List<string>();
        catchExcTid = new List<string>();
        catchExcOwner = new List<string>();
        pendingExcOwner = new List<string>();
        csNames = new List<string>();
        csReps = new List<Node>();
        brkFinBase = 0;
        contFinBase = 0;
        stmtTemps = new List<string>();
        stmtTempValues = new List<string>();
        stmtTempOwners = new List<string>();
        stmtTempTypes = new List<Node>();
        loopScopeBase = 0;
        externDecls = new List<string>();
        nativeExterns = new Dictionary<string, Node>();
        liveNativeExterns = new List<NativeImport>();
        liveNativeDefinitions = new List<string>();
        crc32cEmitted = false;
        tidNames = new List<string>();
        asyncLocalRegs = new List<string>();
        asyncLocalBox = new List<bool>();
        asyncLocalTypes = new List<Node>();
    }

    // The raw C-ABI symbol an extern (DllImport) method binds to: the
    // EntryPoint override when given (stored in sval2), else the method name.
    string ExternName(Node m) {
        if (m.sval2 != "") { return m.sval2; }
        return m.sval;
    }

    // Pre-register the C symbols already `declare`d in the module header so a
    // [DllImport] of e.g. calloc/malloc does not emit a duplicate declaration.
    void SeedExternBuiltins() {
        externDecls.Add("printf"); externDecls.Add("malloc"); externDecls.Add("calloc");
        externDecls.Add("realloc"); externDecls.Add("free"); externDecls.Add("strlen");
        externDecls.Add("strcmp"); externDecls.Add("strcpy"); externDecls.Add("strcat");
        externDecls.Add("memcpy"); externDecls.Add("snprintf"); externDecls.Add("fopen");
        externDecls.Add("memmove"); externDecls.Add("memset"); externDecls.Add("memcmp");
        externDecls.Add("fseek"); externDecls.Add("ftell"); externDecls.Add("fread");
        externDecls.Add("fwrite"); externDecls.Add("fclose"); externDecls.Add("_setjmp");
        externDecls.Add("longjmp"); externDecls.Add("exit"); externDecls.Add("atoi");
        if (hostWin) { externDecls.Add("zan_utf8_argv"); }
    }

    bool ExternSeen(string name) {
        int i = 0;
        while (i < externDecls.Count) {
            if (externDecls[i] == name) { return true; }
            i = i + 1;
        }
        return false;
    }

    // Emit `declare <ret> @<sym>(<params>)` for a [DllImport] extern method,
    // deduplicated against builtins and prior declarations. Calls route to the
    // raw symbol via MethodSym.
    string ExternParamType(Node p, bool variadic) {
        if (p.ival == 1) { return MapType(p.type) + "*"; }
        return variadic ? MapFieldType(p.type) : MapType(p.type);
    }

    void DeclareExtern(Node cls, Node m) {
        string sym = MethodSym(cls.sval, m);
        if (sym.StartsWith("__zan_decimal_")) { DeclareDecimalExtern(sym, m); return; }
        if (ExternSeen(sym)) { return; }
        externDecls.Add(sym);
        if (collectNativeImports && m.attrDeclaredData != "") { nativeExterns[sym] = m; }
        string rt = ((m.mods & MOD.Variadic()) != 0) ? MapFieldType(m.type) : MapType(m.type);
        string sig = "declare " + rt + " @" + sym + "(";
        int first = 1;
        int i = 0;
        while (i < m.kids.Count) {
            Node p = m.kids[i];
            if (p.kind == AK.Param()) {
                if (first == 0) { sig = sig + ", "; }
                sig = sig + ExternParamType(p, HasMod(m, MOD.Variadic()));
                first = 0;
            }
            i = i + 1;
        }
        if ((m.mods & MOD.Variadic()) != 0) {
            if (first == 0) { sig = sig + ", "; }
            sig = sig + "...";
        }
        sig = sig + ")";
        H(sig);
    }

    string NT() { tmp = tmp + 1; return "%t" + tmp; }
    // entry 槽位名（ARC 临时值溢出用）：%z 前缀，EmitTempReleases 据此
    // 区分“寄存器值”与“槽位值”。
    string NTS() { tmp = tmp + 1; return "%z" + tmp; }
    int NL() { lbl = lbl + 1; return lbl; }
    void L(string s) {
        if (debugBody != null && body == debugBody && s.StartsWith("  ") && !s.StartsWith("  ;")
            && !s.StartsWith("    ") && !s.EndsWith(" [")) {
            // LLVM comments must follow the instruction's debug attachment.
            int dispatch = s.IndexOf(" ; zan.dispatch ");
            if (dispatch >= 0) {
                body.Append(s.Substring(0, dispatch));
                body.Append(", !dbg " + debugLocation);
                body.Append(s.Substring(dispatch));
            } else {
                body.Append(s);
                body.Append(", !dbg " + debugLocation);
            }
        } else {
            body.Append(s);
        }
        body.Append("\n");
    }
    // Emit an alloca into the function's entry block when a hoist buffer is
    // active, so locals declared inside loop bodies reuse one stack slot per
    // call instead of growing the stack every iteration at -O0.
    void EA(string reg, string lt) {
        if (eaActive) { entryAllocas.Append("  " + reg + " = alloca " + lt + "\n"); }
        else { L("  " + reg + " = alloca " + lt); }
        ArmMaterializedLocal(reg, lt);
    }
    void H(string s) { head.Append(s); head.Append("\n"); }
    void Label(int n) { body.Append("L" + n + ":\n"); term = false; curLbl = "L" + n; }

    Node MkType(string name) { Node t = new Node(AK.TypeRef()); t.sval = name; return t; }

    // ---- type mapping ----
    // ---- generics (type erasure) ----
    // A type is "erased" if its name is a generic type parameter of some class;
    // all such types are lowered to i64 slots (pointers packed via ptrtoint).
    // An ARRAY whose element type is a parameter is NOT erased: the array
    // itself travels as its element-slot pointer (i64*) -- the element type
    // is what gets erased, not the array. Treating `T[]` as erased made the
    // field store pack it into an i64 slot while the field load read an
    // i64* -- the two ends disagreed and the array pointer was lost.
    bool IsErasedType(Node t) {
        if (t == null) { return false; }
        if (t.ival >= 1) { return false; }
        if (!IsTypeParamName(t.sval)) { return false; }
        // A type parameter shadows a user type of the same name -- but only
        // inside the scope that DECLARES it. `class T` next to `Binding<T>`:
        // inside Binding's body `T` is the parameter, everywhere else it is
        // the user class. Erasing it everywhere turned the user class into an
        // i64 slot and the program stored a pointer into it.
        string scope = typeScopeCls;
        if (scope == "") { scope = curClass; }
        if (IsTypeParamOf(scope, t.sval)) { return true; }
        if (curMethodNode != null && IsTypeParamOf(curMethodNode, t.sval)) { return true; }
        // a user type with that name: outside the declaring scope the name
        // refers to the user type, not to the parameter
        if (binder.FindType(t.sval) != null) { return false; }
        return true;
    }

    // is the name a type parameter of that class (or of that method)?
    bool IsTypeParamOf(Node owner, string name) {
        if (owner == null) { return false; }
        int i = 0;
        while (i < owner.kids.Count) {
            Node k = owner.kids[i];
            if (k.kind == AK.TypeParam() && k.sval == name) { return true; }
            i = i + 1;
        }
        return false;
    }

    bool IsTypeParamOf(string clsName, string name) {
        if (clsName == "") { return false; }
        return IsTypeParamOf(binder.FindType(clsName), name);
    }

    // is the name a type parameter somewhere in the program?
    bool IsTypeParamName(string name) {
        int i = 0;
        while (i < tparamNames.Count) { if (tparamNames[i] == name) { return true; } i = i + 1; }
        return false;
    }

    // Map a type that was written in ANOTHER class's scope (a method's own
    // declared types): there a type parameter shadows a user type of the
    // same name, so the erasure decision must use that class's scope.
    string MapTypeDecl(Node t, string declCls) {
        string saved = typeScopeCls;
        typeScopeCls = declCls;
        string r = MapType(t);
        typeScopeCls = saved;
        return r;
    }

    // the same, for the erasure test
    bool IsErasedTypeDecl(Node t, string declCls) {
        string saved = typeScopeCls;
        typeScopeCls = declCls;
        bool r = IsErasedType(t);
        typeScopeCls = saved;
        return r;
    }

    List<string> TParams(Node cls) {
        List<string> r = new List<string>();
        if (cls == null) { return r; }
        int i = 0;
        while (i < cls.kids.Count) {
            if (cls.kids[i].kind == AK.TypeParam()) { r.Add(cls.kids[i].sval); }
            i = i + 1;
        }
        return r;
    }

    // resolve an erased type to the concrete argument supplied by a receiver's
    // static type (e.g. T in Box<int> -> int); returns t itself when unresolved.
    Node ConcreteTP(Node t, Node recvTy) {
        if (!IsErasedType(t)) { return t; }
        if (recvTy == null) { return t; }
        Node cls = binder.FindType(recvTy.sval);
        List<string> tps = TParams(cls);
        int i = 0;
        while (i < tps.Count) {
            if (tps[i] == t.sval) {
                if (i < recvTy.kids.Count) { return recvTy.kids[i]; }
                return t;
            }
            i = i + 1;
        }
        return t;
    }

    bool IsNullable(Node t) { return t != null && t.op == 1; }

    bool IsPrimValue(Node t) {
        if (t != null && t.sval == "decimal") { return true; }
        if (t == null) { return false; }
        string n = t.sval;
        if (n == "int" || n == "long" || n == "bool" || n == "char" || n == "byte" || n == "short" || n == "double" || n == "float" || n == "uint" || n == "ulong" || n == "ushort" || n == "sbyte" || n == "nint") {
            return true;
        }
        Node d = binder.FindType(n);
        return d != null && d.kind == AK.EnumDecl();
    }

    bool IsNullableValue(Node t) { return t != null && t.ival == 0 && IsNullable(t) && IsPrimValue(t); }

    string UnderLL(Node t) {
        if (t.sval == "decimal") { return DecimalLL(); }
        if (t.sval == "double" || t.sval == "float") { return "double"; }
        return "i64";
    }

    // box a value into a heap slot, returning the i8* handle (null = no value)
    string BoxVal(ExprVal v, Node ty) {
        string ult = UnderLL(ty);
        string raw = NT();
        L("  " + raw + " = call i8* @zalloc(i64 " + TypeSizeBytes(ult) + ", i8* null, i8* null)");
        string p = NT();
        L("  " + p + " = bitcast i8* " + raw + " to " + ult + "*");
        L("  store " + ult + " " + Coerce(v, ult) + ", " + ult + "* " + p);
        return raw;
    }

    // operand to store into a nullable value-type slot (i8*)
    string BoxFor(ExprVal v, Node ty) {
        if (v.op == "null") { return "null"; }
        if (IsNullableValue(v.ty)) { return v.op; }
        string boxed = BoxVal(v, ty);
        AddTemp(boxed, ty);
        return boxed;
    }

    // A slot owns a reference independently of the expression temporary.
    // Retain before releasing the old value, including self-assignment.
    void StoreNullable(string place, ExprVal value, Node ty, bool replace) {
        string boxed = BoxFor(value, ty);
        EmitArcRetain(boxed, ty);
        string old = "";
        if (replace) {
            old = NT();
            L("  " + old + " = load i8*, i8** " + place);
        }
        L("  store i8* " + boxed + ", i8** " + place);
        if (replace) { EmitArcRelease(old, ty); }
    }

    // errno 访问器按宿主取名（对齐 C 宿主 emit_errno_preset）：gen1 产出的
    // IR 在构建它的同一宿主上链接；Mac 上一律 `_errno` 会让 gen2 链接失败。
    static string ErrnoSym() {
        #if WINDOWS
        return "_errno";
        #elif MACOS
        return "__error";
        #else
        return "__errno_location";
        #endif
    }

    // POSIX stdio stream globals (fd 0 stdin / 2 stderr): Darwin's libc
    // exports them as __stdinp / __stderrp, glibc/musl as stdin / stderr
    // (the C host's builtin_sys.c picks the same names). Windows reaches
    // them through __acrt_iob_func instead, so callers branch on hostWin
    // first. Declares the global on first use and returns "@name".
    string PosixStdStream(int fd) {
        string name = fd == 0 ? "stdin" : "stderr";
        #if MACOS
        name = fd == 0 ? "__stdinp" : "__stderrp";
        #endif
        if (!ExternSeen(name)) {
            externDecls.Add(name);
            H("@" + name + " = external global i8*");
        }
        return "@" + name;
    }

    // ---- driver ----
    public string Gen(Node unit, bool reportTime = false, bool debug = false) {
        long phaseStart = reportTime ? Stopwatch.GetMicroseconds() : 0;
        string exeDir = Environment.ExeDir();
        hostWin = exeDir.Length >= 2 && exeDir.Substring(1, 1) == ":";
        if (debug) { StartDebugModule(); }
        CollectTParams(unit);
        H("declare i32 @printf(i8*, ...)");
        H("declare i8* @malloc(i64)");
        H("declare i8* @calloc(i64, i64)");
        H("declare i8* @realloc(i8*, i64)");
        H("declare void @free(i8*)");
        H("declare i64 @strlen(i8*)");
        H("declare i32 @strcmp(i8*, i8*)");
        H("declare i8* @strcpy(i8*, i8*)");
        H("declare i8* @strcat(i8*, i8*)");
        H("declare i8* @memcpy(i8*, i8*, i64)");
        H("declare i8* @memmove(i8*, i8*, i64)");
        H("declare i8* @memset(i8*, i32, i64)");
        H("declare i32 @memcmp(i8*, i8*, i64)");
        H("declare i32 @snprintf(i8*, i64, i8*, ...)");
        H("declare i8* @fopen(i8*, i8*)");
        H("declare i32 @fseek(i8*, i64, i32)");
        H("declare i64 @ftell(i8*)");
        H("declare i64 @fread(i8*, i64, i64, i8*)");
        H("declare i64 @fwrite(i8*, i64, i64, i8*)");
        H("declare i32 @fclose(i8*)");
        H("declare i32 @_setjmp(i8*, i8*) #0");
        // returns_twice: a longjmp comes back into the setjmp call, so the
        // values that live across it have to be spilled -- without the
        // attribute LLVM keeps them in caller-saved registers and the
        // catch path reads whatever the longjmp left there.
        H("attributes #0 = { returns_twice }");
        if (hostWin) {
            H("declare i32 @SetConsoleOutputCP(i32)");
            H("declare i32 @SetConsoleCP(i32)");
            H("declare i32 @zan_utf8_argv(i32*, i8***)");
        }
        H("declare void @longjmp(i8*, i32)");
        H("declare i8* @llvm.frameaddress.p0(i32)");
        H("declare void @exit(i32)");
        H("declare i64 @atoi(i8*)");
        SeedExternBuiltins();
        // B-ID211: decide once, before any emission, whether the GC probe
        // runtime (and the allocation-tracking hooks in zalloc/zrelease and
        // the zstr pair) are needed. EmitGcProbeRuntime supplies the definitions
        // for these symbols.
        gcProbeUsed = AstUsesGcProbe(unit);
        if (gcProbeUsed) {
            externDecls.Add("zan_gc_detect_cycles");
            externDecls.Add("zan_gc_write_heap_snapshot");
            externDecls.Add("zan_rt_heap_diagnostics_enable");
            externDecls.Add("zan_rt_heap_mutator_enter");
            externDecls.Add("zan_rt_heap_mutator_leave");
        }
        EmitSyncPendingRuntime();
        EmitExceptionPayloadRuntime();
        // A native worker may enter a lock while another thread has armed
        // handlers. The dispatch, watermarks and jmp_bufs belong to the thread.
        H("@__exc_sp = thread_local global i64 0");
        // B-ID199 round4: the handler frame store used to be three fixed
        // [64]-slot globals with no bounds check -- nesting >=65 frames
        // (deep_try_finally_nesting) wrote out of bounds and corrupted
        // adjacent globals (64/65 ran "fine", 100 died at teardown, 300
        // mid-run; the C host dropped its static nesting cap via landingpad
        // EH in B-ID74). The frames now live in heap arrays that
        // @__exc_grow doubles on demand. @__exc_stack is retired: every
        // writer stored &bufs[depth] (the main root handler's alloca was
        // unified into the same shape), and the single reader (the unwind
        // landing) re-derives the frame from the depth, so the address is
        // always computable from @__exc_sp and nothing caches stale
        // pointers across a growth. Frames are never freed back -- the
        // arrays stay at the peak depth, like any growable stack.
        H("@__exc_cap = thread_local global i64 0");
        H("@__exc_bufs = thread_local global i8* null");
        H("@__exc_val = thread_local global i8* null");
        H("@__exc_tid = thread_local global i8* null");
        H("@__zan_argc = global i32 0");
        H("@__zan_argv = global i8** null");
        H("@.mode_rb = private unnamed_addr constant [3 x i8] c\"rb\\00\"");
        // 写模式必须是 "wb"（二进制）：文本模式在 Windows 上会把每个 LF
        // 翻成 CRLF，自举编译器写出的 .ll 因此与 C 宿主写出的不一致，
        // 固定点 gen2==g3 永远不成立（与 stdlib File.WriteAllText 一致）。
        H("@.mode_wb = private unnamed_addr constant [3 x i8] c\"wb\\00\"");
        H("@.fmt.nl = private unnamed_addr constant [6 x i8] c\"%lld\\0A\\00\"");
        H("@.fmt.nn = private unnamed_addr constant [5 x i8] c\"%lld\\00\"");
        H("@.fmt.snl = private unnamed_addr constant [4 x i8] c\"%s\\0A\\00\"");
        H("@.fmt.sn = private unnamed_addr constant [3 x i8] c\"%s\\00\"");
        H("@.fmt.gnl = private unnamed_addr constant [4 x i8] c\"%g\\0A\\00\"");
        H("@.fmt.gn = private unnamed_addr constant [3 x i8] c\"%g\\00\"");
        H("@.fmt.unl = private unnamed_addr constant [6 x i8] c\"%llu\\0A\\00\"");
        H("@.fmt.unn = private unnamed_addr constant [5 x i8] c\"%llu\\00\"");
        // Console.Clear / ResetColor: the ANSI escapes the C host emits
        // (irgen_call.c: "\033[2J\033[H" and "\033[0m").
        H("@.esc.clear = private unnamed_addr constant [8 x i8] c\"\\1B[2J\\1B[H\\00\"");
        H("@.esc.reset = private unnamed_addr constant [5 x i8] c\"\\1B[0m\\00\"");
        H("@.msg.unhandled = private unnamed_addr constant [25 x i8] c\"Unhandled exception: %s\\0A\\00\"");
        H("@.msg.exnil = private unnamed_addr constant [13 x i8] c\"(no message)\\00\"");
        H("@.msg.rderr = private unnamed_addr constant [18 x i8] c\"cannot read file\\0A\\00\"");
        H("@.msg.wrerr = private unnamed_addr constant [19 x i8] c\"cannot write file\\0A\\00\"");
        // a zero page: a null string reads from it instead of crashing (the
        // C host switches a null base to a scratch page and keeps running)
        H("@.zeropage = private unnamed_addr constant [16 x i8] zeroinitializer");
        EmitArcDiagnostics();
        EmitArcRuntime();
        EmitWeakRuntime();
        EmitListRuntime();
        EmitSbRuntime();
        EmitStrRuntime();
        EmitArrLenRuntime();
        EmitDictRuntime();
        EmitStrcmp0();
        // the built-in containers carry a class id, so the runtime type test
        // can recognise them
        EmitContainerTids();
        EmitObjectRuntime();
        // the instantiations of the generic classes the program uses: a
        // generic class's static storage exists per instantiation, so they
        // have to be known before the globals and the static initializers
        // are emitted
        DiscoverInsts(unit);
        SeedStaticInitTypes(unit);
        // struct type decls first
        int i = 0;
        while (i < unit.kids.Count) {
            Node d = unit.kids[i];
            if (d.kind == AK.ClassDecl() || d.kind == AK.StructDecl()) {
                if (d.sval != "Vector128" && d.sval != "Vector256") { EmitStruct(d); EmitStaticGlobals(d); EmitTid(d); }
            }
            i = i + 1;
        }
        // vtables for polymorphic classes
        i = 0;
        while (i < unit.kids.Count) {
            Node d = unit.kids[i];
            if ((d.kind == AK.ClassDecl() || d.kind == AK.StructDecl()) && IsPolyClass(d) && !HasMod(d, MOD.Abstract())) { EmitVtable(d); }
            i = i + 1;
        }
        // per-class destructors (release ARC-managed fields)
        i = 0;
        while (i < unit.kids.Count) {
            Node d = unit.kids[i];
            if ((d.kind == AK.ClassDecl() || d.kind == AK.StructDecl())
            && d.sval != "Vector128" && d.sval != "Vector256") { EmitClassDtor(d); GcProbeNoteClass(d); }
            i = i + 1;
        }
        // per-struct default-instance constructor and array fill: a struct
        // instance is a heap object here, so an array of struct elements
        // needs one instance per slot
        i = 0;
        while (i < unit.kids.Count) {
            Node d = unit.kids[i];
            if (d.kind == AK.StructDecl()
            && d.sval != "Vector128" && d.sval != "Vector256") {
                EmitStructNewObj(d);
                EmitStructArrInit(d);
            }
            i = i + 1;
        }
        phaseStart = Program.ReportPhase(reportTime, "IR declarations", phaseStart);
        // function bodies
        i = 0;
        while (i < unit.kids.Count) {
            Node d = unit.kids[i];
            if (d.kind == AK.ClassDecl() || d.kind == AK.StructDecl()) { GenClass(d); }
            i = i + 1;
        }
        GenMainWrapper(unit);
        phaseStart = Program.ReportPhase(reportTime, "IR method bodies", phaseStart);
        // emit queued generic-method specializations (a specialized body may
        // queue further specializations, so drain until the list stops growing)
        int sp = 0;
        int cp = 0;
        int fp = 0;
        int vp = 0;
        int si = 0;
        bool pendingInterfaceDispatch = closedInterfaceDispatches.Count > 0;
        while (sp < specMs.Count || cp < specCtors.Count || fp < specFinitSyms.Count
        || vp < specVtSyms.Count || si < sinitTypes.Count || pendingInterfaceDispatch) {
            while (si < sinitTypes.Count) {
                GenStaticInit(sinitTypes[si], sinitSyms[si]);
                si = si + 1;
            }
            while (sp < specMs.Count) {
                // the clone's receiver carries the concrete type arguments of the
                // class it specializes (`Pool<string>`), so a field read inside it
                // resolves the real value type
                Node pthis = curThisTy;
                List<Node> pargs = curInstArgs; string pcls = curInstCls;
                curThisTy = specThis[sp];
                // the clone's class instantiation: its static storage is the one
                // of that instantiation (`Stat<int>.s` is not `Stat<double>.s`)
                curInstArgs = new List<Node>(); curInstCls = "";
                if (curThisTy != null && curThisTy.kids.Count > 0) {
                    curInstArgs = curThisTy.kids;
                    curInstCls = curThisTy.sval;
                }
                GenMethod(specClss[sp], specMs[sp], false);
                curThisTy = pthis;
                curInstArgs = pargs; curInstCls = pcls;
                sp = sp + 1;
            }
            // the specialized constructors of the generic classes: same shape as
            // the method clones -- the receiver carries the concrete type
            // arguments, so the collections the constructor creates know their
            // element type
            while (cp < specCtors.Count) {
                Node pthis = curThisTy;
                List<Node> pargs = curInstArgs; string pcls = curInstCls;
                string psym = curCtorSym;
                curThisTy = specCtorThis[cp];
                curInstArgs = new List<Node>(); curInstCls = "";
                if (curThisTy != null && curThisTy.kids.Count > 0) {
                    curInstArgs = curThisTy.kids;
                    curInstCls = curThisTy.sval;
                }
                curCtorSym = specCtorSyms[cp];
                GenCtor(specCtorCls[cp], specCtors[cp]);
                curCtorSym = psym;
                curThisTy = pthis;
                curInstArgs = pargs; curInstCls = pcls;
                cp = cp + 1;
            }
            // the specialized field-initializer helpers of the generic classes
            // (B-ID216): emitted with the instantiation bound, so `new T[n]` in a
            // field initializer builds the array descriptor for the real element
            // type. The shared helper erases it: the accept predicate generated
            // for the open parameter rejects every reference-element store.
            while (fp < specFinitSyms.Count) {
                Node pthis = curThisTy;
                List<Node> pargs = curInstArgs; string pcls = curInstCls;
                curThisTy = specFinitThis[fp];
                curInstArgs = new List<Node>(); curInstCls = "";
                if (curThisTy != null && curThisTy.kids.Count > 0) {
                    curInstArgs = curThisTy.kids;
                    curInstCls = specFinitCls[fp].sval;
                }
                GenFieldInitsFnAs(specFinits[fp], specFinitSyms[fp]);
                curThisTy = pthis;
                curInstArgs = pargs; curInstCls = pcls;
                fp = fp + 1;
            }
            // B-ID218: the per-instantiation vtables queued by SpecVtableSym. A
            // slot whose implementing body mentions the class's type parameters
            // queues its specialized clone here, so the sp loop above picks it
            // up in the same pass -- the table can safely reference it.
            while (vp < specVtSyms.Count) {
                EmitVtableAs(specVtCls[vp], specVtArgs[vp], specVtSyms[vp]);
                vp = vp + 1;
            }
            // Interface targets can queue more concrete bodies, and those
            // bodies can allocate further implementors. Close both queues
            // before emitting the final dispatch helpers.
            QueueClosedInterfaceTargets();
            pendingInterfaceDispatch = false;
        }
        EmitClosedInterfaceDispatches();
        phaseStart = Program.ReportPhase(reportTime, "IR specializations", phaseStart);
        // The coroutine runtime is emitted unconditionally, not only when the
        // program awaits something: the C runtime object the program links
        // against references zan_co_ready (zan_io_recv_co), so the symbol has
        // to exist even for a program that never suspends. The definitions
        // are weak -- a runtime that provides the real ones wins -- but they
        // have to form a coherent set on their own: the self-host's frame
        // layout is its own (see TASKS A385), so the self-host's own
        // scheduler has to drive it.
        EmitAsyncRuntime();
        if (usesDirList) { EmitDirRuntime(); }
        if (usesStrOps) { EmitStrOpsRuntime(); }
        // B-ID211: the GC probe runtime (registry + detect + snapshot) lands
        // after the bodies, so the pre-scan flag is final and every class
        // the program declares has already contributed its table entry.
        EmitGcProbeRuntime();
        head.Append(rawStringGlobals.ToString());
        head.Append(body.ToString());
        head.Append(deferred.ToString());
        // G8 round 2: whole-module dead-code pruning -- the stdlib
        // demand-pull ships whole files of never-called user code; walk the
        // final module for reachability from the entry points and global
        // initializers. Native library exports also seed the traversal.
        string moduleText = ResolveStaticInits(head.ToString());
        phaseStart = Program.ReportPhase(reportTime, "IR static initialization", phaseStart);
        if (!libOut || collectNativeImports) {
            moduleText = PruneDeadCode(moduleText);
            Program.ReportPhase(reportTime, "IR pruning", phaseStart);
        }
        if (debug) { moduleText = moduleText + debugMetadata.ToString(); }
        return moduleText;
    }

    void EmitStruct(Node cls) {
        // hardware vectors are first-class LLVM vector values: no named type,
        // no heap layout, no dtor
        if (cls.sval == "Vector128" || cls.sval == "Vector256") { return; }
        if (cls.kind == AK.StructDecl() && cls.layoutExplicit) {
            int sz = ExplicitStructBytes(cls);
            H("%" + cls.sval + " = type { [" + sz + " x i8] }");
            return;
        }
        List<string> names = new List<string>();
        List<Node> types = new List<Node>();
        CollectFields(cls, names, types);
        string s = "%" + cls.sval + " = type { ";
        int cnt = 0;
        // 类一律留 vptr 槽（见 FieldBase）：继承链上的字段偏移必须一致。
        if (cls.kind != AK.StructDecl()) { s = s + "i8*"; cnt = 1; }
        int i = 0;
        while (i < types.Count) {
            if (cnt > 0) { s = s + ", "; }
            // the field's type is written in THIS class's scope: a type
            // parameter of the class erases there (a user type of the same
            // name does not)
            string savedScope = typeScopeCls;
            typeScopeCls = cls.sval;
            if (cls.kind == AK.StructDecl()) {
                s = s + MapFieldType(types[i]);
            } else {
                s = s + MapType(types[i]);
            }
            typeScopeCls = savedScope;
            cnt = cnt + 1;
            i = i + 1;
        }
        if (cnt == 0) { s = s + "i64"; }
        s = s + " }";
        H(s);
    }

    void GenClass(Node cls) {
        curClass = cls.sval;
        int i = 0;
        while (i < cls.kids.Count) {
            Node m = cls.kids[i];
            if (m.kind == AK.MethodDecl()) {
                // abstract/interface methods have no body: no function is emitted
                if (HasMod(m, MOD.Extern())) {
                    // builtin-lowered externs (Vector128/256 hardware SIMD,
                    // BitOperations bit twiddling) get no declaration: their
                    // call sites are lowered inline and nothing references
                    // the raw symbol. NativeMemory declares ordinary externs
                    // using their explicit entry points.
                    bool lowered = false;
                    if (MatchBuiltinClass(cls.sval, "Vector128") || MatchBuiltinClass(cls.sval, "Vector256") || MatchBuiltinClass(cls.sval, "BitOperations")
                    || MatchBuiltinClass(cls.sval, "Sse2") || MatchBuiltinClass(cls.sval, "Sse42") || MatchBuiltinClass(cls.sval, "Aes")) {
                        lowered = true;
                    } else if (MatchBuiltinClass(cls.sval, "NativeMemory")) {
                        string nm = ExternName(m);
                        if (nm == "Alloc" || nm == "Free" || nm == "Copy" || nm == "Copy2D" || nm == "Fill"
                        || nm == "Compare" || nm == "GetString" || nm == "PutString" || nm == "Find") {
                            lowered = true;
                        }
                    }
                    if (!lowered) { DeclareExtern(cls, m); }
                }
                else if (!IsAbstract(m)) { GenMethod(cls, m, false); }
            }
            else if (m.kind == AK.CtorDecl()) {
                // a static constructor is not an instance constructor: it has
                // no receiver and runs once at program entry
                if (!IsStatic(m)) { GenCtor(cls, m); }
            }
            i = i + 1;
        }
        // A class whose inheritance chain declares instance field initializers
        // gets a helper function that runs them. It is called from the
        // allocation site when no constructor matches, and from a derived
        // constructor when the base constructor was not called (the base
        // constructor would have run them itself).
        if (HasChainFieldInits(cls)) { GenFieldInitsFn(cls); }
    }

    // True when `cls` or one of its base classes declares an instance field
    // initializer: the initializers of the whole chain run together, the base
    // class ones first (C# order).
    bool HasChainFieldInits(Node cls) {
        if (cls == null) { return false; }
        if (HasChainFieldInits(BaseClassOf(cls))) { return true; }
        int i = 0;
        while (i < cls.kids.Count) {
            Node m = cls.kids[i];
            if (m.kind == AK.FieldDecl() && !IsStatic(m) && m.b != null) { return true; }
            i = i + 1;
        }
        return false;
    }

    // The LLVM symbol of the field initializer helper of `cls`.
    string FieldInitsSym(Node cls) { return "__zan_finits_" + cls.sval; }

    // The instance field initializers of `cls` (declaration order): C# runs
    // them at the start of the constructor, before the constructor body.
    void EmitFieldInits(Node cls, string thisOp) {
        if (cls == null) { return; }
        int i = 0;
        while (i < cls.kids.Count) {
            Node m = cls.kids[i];
            if (m.kind == AK.FieldDecl() && !IsStatic(m) && m.b != null) {
                // each initializer is a statement of its own: the store
                // retains, and the initializer's owned temporaries (the
                // `new H()` itself) are released after it -- they were never
                // released, so every `public H State = new H();` leaked one
                // reference (list_removeat_owned_receiver)
                List<string> svT = stmtTemps; List<string> svTV = stmtTempValues;
                List<string> svTO = stmtTempOwners; List<Node> svTT = stmtTempTypes;
                stmtTemps = new List<string>(); stmtTempValues = new List<string>();
                stmtTempOwners = new List<string>(); stmtTempTypes = new List<Node>();
                ExprVal v = null;
                // a Binding<T> field takes a fresh Binding object (the C
                // host's emit_binding_value)
                if (IsBindingTy(m.type)) { v = GenBindingValue(m.b, m.type); }
                if (v == null) { v = GenExpr(m.b); }
                StoreField(thisOp, cls.sval, m.sval, v);
                EmitTempReleases();
                stmtTemps = svT; stmtTempValues = svTV; stmtTempOwners = svTO; stmtTempTypes = svTT;
            }
            i = i + 1;
        }
    }

    // The instance field initializers of the whole inheritance chain, root
    // first (C# order): the base class initializers run before the derived
    // ones. `thisOp` points at the most derived object; it is bitcast to the
    // layout of every base class on the way down (the base fields are the
    // layout prefix of the derived struct).
    void EmitChainFieldInits(Node cls, string thisOp, string thisTy) {
        if (cls == null) { return; }
        Node b = BaseClassOf(cls);
        if (b != null) {
            string bop = thisOp;
            if (b.sval != thisTy) {
                bop = NT();
                L("  " + bop + " = bitcast %" + thisTy + "* " + thisOp + " to %" + b.sval + "*");
            }
            EmitChainFieldInits(b, bop, b.sval);
        }
        EmitFieldInits(cls, thisOp);
    }

    bool IsStatic(Node m) { return (m.mods / MOD.Static()) - ((m.mods / MOD.Static()) / 2) * 2 == 1; }

    void StartFn() {
        tmp = 0; lbl = 0; term = false;
        syncPendingReturn = "";
        syncFlow = new SyncFlowContext();
        catchExcOwner = new List<string>();
        pendingExcOwner = new List<string>();
        curLbl = "entry";
        locName = new List<string>();
        locType = new List<Node>();
        locReg = new List<string>();
        locBox = new List<bool>();
        locIter = new List<bool>();
        locCell = new List<string>();
        locRef = new List<bool>();
        locOpaque = new List<bool>();
        capNames = new List<string>();
        locSeq = 0;
        stmtTemps = new List<string>();
        stmtTempValues = new List<string>();
        stmtTempOwners = new List<string>();
        stmtTempTypes = new List<Node>();
        loopScopeBase = 0;
        gotoNames = new List<string>();
        gotoIds = new List<int>();
        finLocalLabels = new List<string>();
        finLabelScope = 0;
        finLabelSeq = 0;
        finMonSlot = new List<string>();
    }

    void ScanFlowLabels(Node body) {
        List<Node> jumps = new List<Node>();
        CollectFlowLabels(body, null, null, jumps);
        int i = 0;
        while (i < jumps.Count) {
            Node jump = jumps[i];
            int label = FlowLabelIndex(jump);
            if (label >= 0) {
                Node region = syncFlow.labelRegions[label];
                if (region != null && !FlowContains(region, jump)) {
                    diags.Error("goto '" + jump.sval + "' jumps into a try/catch/finally or lock block", jump.line, jump.col);
                }
            }
            i = i + 1;
        }
    }

    void CollectFlowLabels(Node s, Node region, Node owner, List<Node> jumps) {
        if (s == null || s.kind == AK.Lambda()) { return; }
        if (s.kind == AK.LabelStmt()) {
            syncFlow.labels.Add(s);
            syncFlow.labelRegions.Add(region);
            syncFlow.labelOwners.Add(owner);
        } else if (s.kind == AK.GotoStmt()) {
            jumps.Add(s);
        } else if (s.kind == AK.TryStmt()) {
            CollectFlowLabels(s.a, s.a, owner, jumps);
            Node clause = s.b;
            while (clause != null) {
                CollectFlowLabels(clause.a, clause.a, owner, jumps);
                clause = clause.b;
            }
            CollectFlowLabels(s.c, s.c, s.c, jumps);
            return;
        } else if (s.kind == AK.LockStmt()) {
            CollectFlowLabels(s.b, s.b, owner, jumps);
            return;
        }
        int i = 0;
        while (i < s.kids.Count) {
            CollectFlowLabels(s.kids[i], region, owner, jumps);
            i = i + 1;
        }
        CollectFlowLabels(s.a, region, owner, jumps);
        CollectFlowLabels(s.b, region, owner, jumps);
        CollectFlowLabels(s.c, region, owner, jumps);
        CollectFlowLabels(s.d, region, owner, jumps);
    }

    int FlowLabelIndex(Node site) {
        int candidate = -1;
        int inaccessible = -1;
        Node candidateOwner = null;
        int i = 0;
        while (i < syncFlow.labels.Count) {
            Node label = syncFlow.labels[i];
            if (label == site) { return i; }
            if (site.kind == AK.GotoStmt() && label.sval == site.sval) {
                Node owner = syncFlow.labelOwners[i];
                if (owner != null && !FlowContains(owner, site)) {
                    inaccessible = i;
                } else if (candidate < 0 || (owner != candidateOwner && owner != null
                    && (candidateOwner == null || FlowContains(candidateOwner, owner)))) {
                    candidate = i;
                    candidateOwner = owner;
                }
            }
            i = i + 1;
        }
        // Keep an inaccessible match so the scan can diagnose the protected entry.
        return candidate >= 0 ? candidate : inaccessible;
    }

    void CollectLabels(Node s, List<string> list) {
        if (s == null || s.kind == AK.Lambda()) { return; }
        if (s.kind == AK.LabelStmt()) {
            if (IndexOfStr(list, s.sval) < 0) { list.Add(s.sval); }
        }
        int i = 0;
        while (i < s.kids.Count) { CollectLabels(s.kids[i], list); i = i + 1; }
        CollectLabels(s.a, list);
        CollectLabels(s.b, list);
        CollectLabels(s.c, list);
        CollectLabels(s.d, list);
    }

    // Resolve a goto label name to a stable per-function label id, allocating
    // one on first use so forward references (goto before label) work.
    int LabelId(string name, int labelIndex) {
        Node owner = labelIndex >= 0 ? syncFlow.labelOwners[labelIndex] : null;
        int scope = syncFlow.cloneBodies.Count - 1;
        while (scope >= 0) {
            if (syncFlow.cloneBodies[scope] == owner) {
                name = name + "$f" + syncFlow.cloneIds[scope];
                break;
            }
            scope = scope - 1;
        }
        int i = 0;
        while (i < gotoNames.Count) {
            if (gotoNames[i] == name) { return gotoIds[i]; }
            i = i + 1;
        }
        int id = NL();
        gotoNames.Add(name);
        gotoIds.Add(id);
        return id;
    }

    bool IsAsync(Node m) {
        int b = m.mods / 2048;
        return b - (b / 2) * 2 == 1;
    }
}

// Emission state belongs to one native function, including hoisted lambdas.
public class SyncFlowContext {
    public Node breakScope;
    public Node continueScope;
    public List<string> definedGotoLabels = new List<string>();
    public List<int> definedGotoLocalCounts = new List<int>();
    public List<Node> pendingGotoNodes = new List<Node>();
    public List<int> pendingGotoIds = new List<int>();
    public List<int> pendingGotoLocals = new List<int>();
    public List<int> pendingGotoOwned = new List<int>();
    public List<Node> localScopes = new List<Node>();
    public List<int> localScopeStarts = new List<int>();
    public List<Node> catchScopes = new List<Node>();
    public List<int> catchLocals = new List<int>();
    public List<FinallyContext> scopes = new List<FinallyContext>();
    public List<Node> labels = new List<Node>();
    public List<Node> labelRegions = new List<Node>();
    public List<Node> labelOwners = new List<Node>();
    public int rethrowBase;
    public int rethrowCatch;
    public List<string> records = new List<string>();
    public List<int> boundaries = new List<int>();
    public List<Node> cloneBodies = new List<Node>();
    public List<int> cloneIds = new List<int>();
}
