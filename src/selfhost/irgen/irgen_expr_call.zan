using System;
using System.Collections.Generic;
namespace Zan;

partial class Irgen {
    // ---- calls ----
    ExprVal GenCall(Node e) {
        Node callee = e.a;
        // Environment / File builtins: ClassName.Method(...)
        if (callee.kind == AK.MemberAccess() && callee.a != null && callee.a.kind == AK.Ident()) {
            string cn = callee.a.sval;
            string mn = callee.sval;
            // Run/Spawn routing is decided once by the checker. Use that
            // decision for the entire Task branch, including its reject tail;
            // a shadowed user call must reach ordinary member dispatch.
            bool builtinTask = cn == "Task";
            if (mn == "Run" || mn == "Spawn") { builtinTask = builtinTask && callee.isIntrinsic; }
            else { builtinTask = builtinTask && (e.resolvedSym == null || e.isIntrinsic); }
            if (builtinTask && (mn == "Run" || mn == "Spawn") && e.kids.Count == 1) {
                return EmitTaskRunCall(e, mn == "Spawn");
            }
            if (builtinTask && mn == "IsDone" && e.kids.Count == 1) {
                return EmitTaskIsDone(e);
            }
            if (builtinTask && mn == "Cancel" && e.kids.Count == 1) {
                return EmitTaskCancel(e);
            }
            if (builtinTask && mn == "Release" && e.kids.Count == 1) {
                ExprVal h = GenExpr(e.kids[0]);
                string handle = h.op;
                if (MapType(h.ty) == "i64") {
                    handle = NT(); L("  " + handle + " = inttoptr i64 " + h.op + " to i8*");
                }
                EmitTaskRelease(handle);
                return new ExprVal("0", MkType("void"));
            }
            if (builtinTask && mn == "Yield" && e.kids.Count == 0) {
                return new ExprVal("0", MkType("int"));
            }
            if (builtinTask && mn == "IsCancellationRequested" && e.kids.Count == 0) {
                if (curAsync) {
                    string cfl = NT();
                    L("  " + cfl + " = load i64, i64* " + FrameGep("%ff", 10));
                    string cfc = NT();
                    L("  " + cfc + " = icmp ne i64 " + cfl + ", 0");
                    string cfc32 = NT();
                    L("  " + cfc32 + " = zext i1 " + cfc + " to i32");
                    string cfc64 = NT();
                    L("  " + cfc64 + " = zext i32 " + cfc32 + " to i64");
                    return new ExprVal(cfc64, MkType("int"));
                }
                return new ExprVal("0", MkType("int"));
            }
            if (builtinTask && mn == "JoinNew" && e.kids.Count == 2) {
                ExprVal a0 = GenExpr(e.kids[0]);
                ExprVal a1 = GenExpr(e.kids[1]);
                string a0_32 = NT(); L("  " + a0_32 + " = trunc i64 " + a0.op + " to i32");
                string a1_32 = NT(); L("  " + a1_32 + " = trunc i64 " + a1.op + " to i32");
                string r = NT();
                L("  " + r + " = call i64 @zan_join_new(i32 " + a0_32 + ", i32 " + a1_32 + ")");
                return new ExprVal(r, MkType("long"));
            }
            if (builtinTask && mn == "JoinBind" && e.kids.Count == 3) {
                ExprVal a0 = GenExpr(e.kids[0]);
                ExprVal a1 = GenExpr(e.kids[1]);
                ExprVal a2 = GenExpr(e.kids[2]);
                string fp;
                if (MapType(a1.ty) == "i64") {
                    fp = NT(); L("  " + fp + " = inttoptr i64 " + a1.op + " to i8*");
                } else {
                    fp = a1.op;
                }
                string token = TaskTokenBits(fp);
                string frame = NT(); L("  " + frame + " = call i8* @zan_task_acquire(i64 " + token + ", i32 0)");
                string a2_32 = NT(); L("  " + a2_32 + " = trunc i64 " + a2.op + " to i32");
                string r = NT();
                L("  " + r + " = call i32 @zan_join_bind(i64 " + a0.op + ", i8* " + frame + ", i32 " + a2_32 + ")");
                L("  call void @zan_task_unpin(i8* " + frame + ")");
                string r64 = NT();
                L("  " + r64 + " = zext i32 " + r + " to i64");
                return new ExprVal(r64, MkType("int"));
            }
            if (builtinTask && mn == "JoinCancel" && e.kids.Count == 1) {
                ExprVal a0 = GenExpr(e.kids[0]);
                L("  call void @zan_join_cancel(i64 " + a0.op + ")");
                return new ExprVal("0", MkType("void"));
            }
            if (builtinTask && mn == "JoinWait" && e.kids.Count == 1) {
                return new ExprVal("2", MkType("int"));
            }
            if (builtinTask && mn == "Delay" && e.kids.Count == 1) {
                ExprVal a = GenExpr(e.kids[0]);
                string ms = ToI64(a.op, MapType(a.ty));
                if (!ExternSeen("zan_co_sync_sleep")) {
                    externDecls.Add("zan_co_sync_sleep");
                    H("declare void @zan_co_sync_sleep(i64)");
                }
                L("  call void @zan_co_sync_sleep(i64 " + ms + ")");
                return new ExprVal("0", MkType("int"));
            }
            if (builtinTask) {
                diags.Error("call to 'Task." + mn + "' is not supported by the self-hosted "
                    + "compiler yet", e.line, e.col);
                return new ExprVal("0", MkType("int"));
            }
            // Cpu.CpuFeature(id): the C host lowers it to its internal
            // __zan_cpu_feature() (src/compiler/irgen_expr.c:1488-1493).
            // On a native build that helper reports no feature at all, so
            // the call answers 0 -- the same value the Has* properties
            // report.
            if (cn == "Cpu" && mn == "CpuFeature" && e.kids.Count == 1) {
                return new ExprVal("0", MkType("int"));
            }
            if (cn == "Environment" && mn == "ArgCount") {
                string a = NT(); L("  " + a + " = load i32, i32* @__zan_argc");
                string a64 = NT(); L("  " + a64 + " = sext i32 " + a + " to i64");
                string r = NT(); L("  " + r + " = sub i64 " + a64 + ", 1");
                return new ExprVal(r, MkType("int"));
            }
            if (cn == "Environment" && mn == "ArgAt") {
                ExprVal idx = GenExpr(e.kids[0]);
                string i1 = NT(); L("  " + i1 + " = add i64 " + idx.op + ", 1");
                string av = NT(); L("  " + av + " = load i8**, i8*** @__zan_argv");
                string sp = NT(); L("  " + sp + " = getelementptr i8*, i8** " + av + ", i64 " + i1);
                string r = NT(); L("  " + r + " = load i8*, i8** " + sp);
                return new ExprVal(WrapManaged(r), MkType("string"));
            }
            if (cn == "File" && mn == "ReadAllText") {
                ExprVal path = GenExpr(e.kids[0]);
                string rb = NT(); L("  " + rb + " = getelementptr inbounds [3 x i8], [3 x i8]* @.mode_rb, i64 0, i64 0");
                string fp = NT(); L("  " + fp + " = call i8* @fopen(i8* " + path.op + ", i8* " + rb + ")");
                EmitFopenCheck(fp, "@.msg.rderr", 18);
                string se0 = NT(); L("  " + se0 + " = call i32 @fseek(i8* " + fp + ", i64 0, i32 2)");
                string se0c = NT(); L("  " + se0c + " = icmp ne i32 " + se0 + ", 0"); EmitAbortIf(se0c, "@.msg.rderr", 18);
                string sz = NT(); L("  " + sz + " = call i64 @ftell(i8* " + fp + ")");
                string szc = NT(); L("  " + szc + " = icmp slt i64 " + sz + ", 0"); EmitAbortIf(szc, "@.msg.rderr", 18);
                string se1 = NT(); L("  " + se1 + " = call i32 @fseek(i8* " + fp + ", i64 0, i32 0)");
                string se1c = NT(); L("  " + se1c + " = icmp ne i32 " + se1 + ", 0"); EmitAbortIf(se1c, "@.msg.rderr", 18);
                string bsz = NT(); L("  " + bsz + " = add i64 " + sz + ", 1");
                string buf = NT(); L("  " + buf + " = call i8* @malloc(i64 " + bsz + ")");
                string bufc = NT(); L("  " + bufc + " = icmp eq i8* " + buf + ", null"); EmitAbortIf(bufc, "@.msg.rderr", 18);
                string got = NT(); L("  " + got + " = call i64 @fread(i8* " + buf + ", i64 1, i64 " + sz + ", i8* " + fp + ")");
                string gotc = NT(); L("  " + gotc + " = icmp ne i64 " + got + ", " + sz); EmitAbortIf(gotc, "@.msg.rderr", 18);
                string ep = NT(); L("  " + ep + " = getelementptr i8, i8* " + buf + ", i64 " + sz);
                L("  store i8 0, i8* " + ep);
                string rc = NT(); L("  " + rc + " = call i32 @fclose(i8* " + fp + ")");
                string rcc = NT(); L("  " + rcc + " = icmp ne i32 " + rc + ", 0"); EmitAbortIf(rcc, "@.msg.rderr", 18);
                string managed = WrapManaged(buf);
                L("  call void @free(i8* " + buf + ")");
                return new ExprVal(managed, MkType("string"));
            }
            if (cn == "File" && mn == "Exists") {
                ExprVal path = GenExpr(e.kids[0]);
                string rb = NT(); L("  " + rb + " = getelementptr inbounds [3 x i8], [3 x i8]* @.mode_rb, i64 0, i64 0");
                string fp = NT(); L("  " + fp + " = call i8* @fopen(i8* " + path.op + ", i8* " + rb + ")");
                string ok = NT(); L("  " + ok + " = icmp ne i8* " + fp + ", null");
                int lcl = NL(); int lend2 = NL();
                string okx = NT(); L("  " + okx + " = zext i1 " + ok + " to i64");
                L("  br i1 " + ok + ", label %L" + lcl + ", label %L" + lend2);
                Label(lcl);
                string fc = NT(); L("  " + fc + " = call i32 @fclose(i8* " + fp + ")");
                L("  br label %L" + lend2);
                Label(lend2);
                return new ExprVal(okx, MkType("bool"));
            }
            if (cn == "Environment" && mn == "ExeDir") {
                usesDirList = true;
                string t = NT(); L("  " + t + " = call i8* @zan_exe_dir()");
                string managed = WrapManaged(t);
                L("  call void @free(i8* " + t + ")");
                return new ExprVal(managed, MkType("string"));
            }
            if (cn == "Directory" && mn == "ListNames") {
                usesDirList = true;
                ExprVal pat = GenExpr(e.kids[0]);
                string t = NT(); L("  " + t + " = call i8* @zan_dir_list(i8* " + pat.op + ")");
                string managed = WrapManaged(t);
                L("  call void @free(i8* " + t + ")");
                return new ExprVal(managed, MkType("string"));
            }
            if (cn == "File" && mn == "WriteAllText") {
                ExprVal path = GenExpr(e.kids[0]);
                ExprVal content = GenExpr(e.kids[1]);
                string wb = NT(); L("  " + wb + " = getelementptr inbounds [3 x i8], [3 x i8]* @.mode_wb, i64 0, i64 0");
                string fp = NT(); L("  " + fp + " = call i8* @fopen(i8* " + path.op + ", i8* " + wb + ")");
                EmitFopenCheck(fp, "@.msg.wrerr", 19);
                string ln = StrLen(content.op);
                string wr = NT(); L("  " + wr + " = call i64 @fwrite(i8* " + content.op + ", i64 1, i64 " + ln + ", i8* " + fp + ")");
                string wrc = NT(); L("  " + wrc + " = icmp ne i64 " + wr + ", " + ln); EmitAbortIf(wrc, "@.msg.wrerr", 19);
                string wrcl = NT(); L("  " + wrcl + " = call i32 @fclose(i8* " + fp + ")");
                string wrclc = NT(); L("  " + wrclc + " = icmp ne i32 " + wrcl + ", 0"); EmitAbortIf(wrclc, "@.msg.wrerr", 19);
                return new ExprVal("0", MkType("void"));
            }
        }
        // Console.* -- every member is lowered the way the C host lowers it
        // (src/compiler/irgen_call.c). The old code had ONE catch-all that
        // treated every Console member as "print the first argument", so
        // Console.Clear() printed "0", Console.ReadLine() printed "0" and
        // returned garbage -- the program got wrong answers without a word.
        if (callee.kind == AK.MemberAccess() && callee.a != null && callee.a.kind == AK.Ident()
            && callee.a.sval == "Console" && LocalIdx("Console") < 0 && binder.FindType("Console") == null) {
            ExprVal cv = GenConsoleCall(callee.sval, e);
            if (cv != null) { return cv; }
        }
        // Convert.ToString(x) -> heap string via snprintf; Convert.ToInt32(s) -> atoi
        bool isConvertBuiltin = (callee.sval == "ToString" || callee.sval == "ToDouble"
            || callee.sval == "ToInt32" || callee.sval == "ToInt" || callee.sval == "ToInt64")
            && e.kids.Count == 1;
        if (callee.kind == AK.MemberAccess() && callee.a != null && callee.a.kind == AK.Ident()
            && callee.a.sval == "Convert" && isConvertBuiltin) {
            if (callee.sval == "ToString" && e.kids.Count == 1) {
                ExprVal a = GenExpr(e.kids[0]);
                // The C host only accepts values that really have a string form
                // (src/compiler/irgen_call.c, type_is_textual_or_numeric): a
                // class instance / array / delegate / struct does not -- its
                // pointer read as a C string walks off into the image and
                // prints whatever it finds there. The host reports it; the
                // self-host used to print the ADDRESS (an information leak
                // and a useless answer), so the rule is mirrored here.
                string bad = ConvertToStringBadType(a.ty);
                if (bad != "") {
                    diags.Error("[E3060] Convert.ToString: cannot convert '" + bad
                        + "' to a string -- call .ToString() on the value instead",
                        e.kids[0].line, e.kids[0].col);
                    return new ExprVal("0", MkType("string"));
                }
                string s;
                if (IsStr(a.ty)) { s = a.op; }
                else if (IsNullableValue(a.ty)) { s = ToCStr(a); }
                else if (MapType(a.ty) == "i8*") {
                    // object 实参：宿主指针分支（irgen_call.c:2274，pointer-kind
                    // → strlen+memcpy）把指针当 C 字符串——对象装着字符串时打印
                    // 内容（两侧一直一致的「指针拷贝」语义）。曾掉进 itoa 分支、
                    // 指针被当 i64 喂 snprintf（无效 IR）。收在 Convert.ToString
                    // 位点内，不动 ToCStr 的其它 15 个调用点（拼接/插值对 object
                    // 在宿主是 type_is_concatable 拒绝的，不走到这里）。
                    //
                    // A444 安全栏（与宿主同形，irgen_call.c 用
                    // zan_obj_slot_is_string）：object 负载可能是类实例——原先
                    // 拿 strlen 量对象指针 → 越界读 + 内存信息泄露。自举串头
                    // 24 字节：[-24]=cid（字符串为 null，类实例是类 tid 地址）、
                    // [-16]=len、[-8]=magic 0x5A4E5354（GenStr 字面量与
                    // zstr_new 动态串同形，zstr_len 已用同一 magic 判别）。
                    // 非字符串/null → 软运行时错（与解析家族同形，strict 模式
                    // exit 70）+ 空串兜底，不再读对象指针。
                    string isn2 = NT();
                    L("  " + isn2 + " = icmp eq i8* " + a.op + ", null");
                    int lnull = NL(); int lprobe = NL(); int lmerge = NL();
                    L("  br i1 " + isn2 + ", label %L" + lnull + ", label %L" + lprobe);
                    Label(lnull);
                    L("  br label %L" + lmerge);
                    Label(lprobe);
                    string hp = NT();
                    L("  " + hp + " = bitcast i8* " + a.op + " to i64*");
                    string cp2 = NT();
                    L("  " + cp2 + " = getelementptr i64, i64* " + hp + ", i64 -3");
                    string cv2 = NT();
                    L("  " + cv2 + " = load i64, i64* " + cp2);
                    string mp2 = NT();
                    L("  " + mp2 + " = getelementptr i64, i64* " + hp + ", i64 -1");
                    string mv2 = NT();
                    L("  " + mv2 + " = load i64, i64* " + mp2);
                    string cok = NT();
                    L("  " + cok + " = icmp eq i64 " + cv2 + ", 0");
                    string mok = NT();
                    L("  " + mok + " = icmp eq i64 " + mv2 + ", 1515082580");
                    string sok = NT();
                    L("  " + sok + " = and i1 " + cok + ", " + mok);
                    L("  br label %L" + lmerge);
                    Label(lmerge);
                    string pred = NT();
                    L("  " + pred + " = phi i1 [ 0, %L" + lnull + " ], [ " + sok + ", %L" + lprobe + " ]");
                    string badv = NT();
                    L("  " + badv + " = xor i1 " + pred + ", 1");
                    EmitRuntimeCheckIf(e.kids[0], badv,
                        "Convert.ToString: object holds a non-string value -- "
                        + "call .ToString() on the concrete value instead");
                    string empty2 = RawCString("");
                    string safe2 = NT();
                    L("  " + safe2 + " = select i1 " + pred + ", i8* " + a.op + ", i8* " + empty2);
                    string n2 = NT();
                    L("  " + n2 + " = call i64 @strlen(i8* " + safe2 + ")");
                    string b2 = NT();
                    L("  " + b2 + " = add i64 " + n2 + ", 1");
                    string bf2 = NT();
                    L("  " + bf2 + " = call i8* @malloc(i64 " + b2 + ")");
                    L("  call i8* @memcpy(i8* " + bf2 + ", i8* " + safe2 + ", i64 " + b2 + ")");
                    s = WrapManaged(bf2);
                    L("  call void @free(i8* " + bf2 + ")");
                }
                else { s = ToCStr(a); }
                return new ExprVal(s, MkType("string"));
            }
            if (callee.sval == "ToDouble" && e.kids.Count == 1) {
                ExprVal a = GenExpr(e.kids[0]);
                // The C host refuses a class instance / struct / array /
                // delegate (irgen_call.c type_is_textual_or_numeric): the
                // pointer would be read as a C string, which walks off into
                // the image. The self-host used to sitofp that pointer --
                // invalid IR, and the program the host refuses compiled here.
                string bad = ConvertNumberBadType(a.ty);
                if (bad != "") {
                    diags.Error("Convert.ToDouble: cannot convert '" + bad
                        + "' to a number -- pass a string or a numeric value",
                        e.line, e.col);
                    return new ExprVal("0.0", MkType("double"));
                }
                return new ExprVal(ConvertDoubleOperand(e, a), MkType("double"));
            }
            if ((callee.sval == "ToInt32" || callee.sval == "ToInt" ||
                 callee.sval == "ToInt64") && e.kids.Count == 1) {
                // the C host (irgen_call.c:1937) parses the text with strtoll,
                // truncates a float towards zero and keeps an integer as it
                // is. The 32-bit narrowing is NOT part of the call: it
                // happens where the value enters a typed location (an int
                // slot is an i32), so the value travels as an i64 here.
                ExprVal a = GenExpr(e.kids[0]);
                string rt = "int";
                if (callee.sval == "ToInt64") { rt = "long"; }
                string bad = ConvertNumberBadType(a.ty);
                if (bad != "") {
                    diags.Error("Convert." + callee.sval + ": cannot convert '" + bad
                        + "' to a number -- pass a string or a numeric value",
                        e.line, e.col);
                    return new ExprVal("0", MkType(rt));
                }
                return new ExprVal(ConvertIntOperand(e, a, callee.sval == "ToInt64"), MkType(rt));
            }
        }
        // int/long.Parse(s), double/float.Parse(s) and matching
        // TryParse(s, out v) -> strtoll/strtod (mirrors the C host)
        if (callee.kind == AK.MemberAccess() && callee.a != null && callee.a.kind == AK.Ident()
            && LocalIdx(callee.a.sval) < 0) {
            string prn = callee.a.sval;
            bool intRecv = prn == "int" || prn == "long" || prn == "Int32" || prn == "Int64";
            bool dblRecv = prn == "double" || prn == "float" || prn == "Double" || prn == "Single";
            bool boolRecv = prn == "bool" || prn == "Boolean";
            // EnumType.TryParse(text, out value): the member-name probe (the
            // host lowers it in irgen_call.c -- a case-sensitive strcmp over
            // the members in declaration order)
            Node en = EnumDeclOf(prn);
            if (en != null && callee.sval == "TryParse" && e.kids.Count == 2) {
                return EmitEnumTryParse(e, en);
            }
            // char 的静态类（镜像 C11 irgen_call_builtins.c A525）：谓词走
            // <ctype.h>（ASCII 口径）；ToUpper/ToLower 在 C11 走烙表
            // @__zan_case_map，自宿主无烙表通道，重写到 stdlib
            // UnicodeCase.CaseToUpper/CaseToLower（charcase_table.h 同源
            // 数据，语义一致）。stdlib 未随载（程序没 pull System.Text）
            // 时退 libc 口径——ASCII 域两口径相同，仅非 ASCII 有偏差。
            // 注意：重写路径必须先换节点再 GenExpr，参数只求值一次。
            bool charRecv = prn == "char" || prn == "Char";
            if (charRecv && e.kids.Count == 1) {
                string cm = callee.sval;
                if (cm == "ToUpper" || cm == "ToLower") {
                    bool cup = cm == "ToUpper";
                    if (binder.FindType("UnicodeCase") != null) {
                        // CaseToUpper/CaseToLower 是单参（方向由函数名区分）：
                        // kids[0] 保持原码点参数不动——曾往 kids[0] 塞方向
                        // flag(1/0)，原参数被丢弃，char.ToUpper 恒返回 1，
                        // 拖垮 UnicodeCase.ToUpper(string) 的逐码点循环
                        // （unicode_normalization_casefold 红的根因）。
                        callee.a.sval = "UnicodeCase";
                        callee.sval = cup ? "CaseToUpper" : "CaseToLower";
                        return GenExpr(e);
                    }
                    ExprVal ca = GenExpr(e.kids[0]);
                    string cp32 = CharToI32(ca);
                    string lf = cup ? "toupper" : "tolower";
                    if (!ExternSeen(lf)) { externDecls.Add(lf); H("declare i32 @" + lf + "(i32)"); }
                    string mr = NT();
                    L("  " + mr + " = call i32 @" + lf + "(i32 " + cp32 + ")");
                    return new ExprVal(mr, MkType("int"));
                }
                if (cm == "IsDigit" || cm == "IsLetter" || cm == "IsLetterOrDigit"
                        || cm == "IsUpper" || cm == "IsLower" || cm == "IsWhiteSpace") {
                    ExprVal ca = GenExpr(e.kids[0]);
                    string cp32 = CharToI32(ca);
                    string lf = cm == "IsDigit" ? "isdigit" : cm == "IsLetter" ? "isalpha"
                        : cm == "IsLetterOrDigit" ? "isalnum" : cm == "IsUpper" ? "isupper"
                        : cm == "IsLower" ? "islower" : "isspace";
                    if (!ExternSeen(lf)) { externDecls.Add(lf); H("declare i32 @" + lf + "(i32)"); }
                    string pr = NT();
                    L("  " + pr + " = call i32 @" + lf + "(i32 " + cp32 + ")");
                    string nz = NT();
                    L("  " + nz + " = icmp ne i32 " + pr + ", 0");
                    return new ExprVal(nz, MkType("bool"));
                }
            }
            if (boolRecv && callee.sval == "Parse" && e.kids.Count == 1) {
                ExprVal a = GenExpr(e.kids[0]);
                EmitStrcasecmpShim();
                string s_safe = ParseStrGuard(e, a.op);
                string s_true = RawCString("true");
                string s_false = RawCString("false");
                string st = NT(); L("  " + st + " = call i32 @strcasecmp(i8* " + s_safe + ", i8* " + s_true + ")");
                string sf = NT(); L("  " + sf + " = call i32 @strcasecmp(i8* " + s_safe + ", i8* " + s_false + ")");
                string is_t = NT(); L("  " + is_t + " = icmp eq i32 " + st + ", 0");
                string is_f = NT(); L("  " + is_f + " = icmp eq i32 " + sf + ", 0");
