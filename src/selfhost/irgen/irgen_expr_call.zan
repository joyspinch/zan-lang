                Label(lend);
                string r = NT();
                L("  " + r + " = phi " + ult + " [ " + v + ", %" + bthen + " ], [ " + dflt + ", %" + belse + " ]");
                return new ExprVal(r, uty);
            }
            // Task 句柄上的成员：Wait / Result / IsCompleted
            if (recv.ty != null && recv.ty.sval == "Task") {
                return EmitTaskMemberCall(recv, mname, e);
            }
            // builtin in-place List.Reverse wins over the copying extension
            if (IsListType(recv.ty) && mname == "Reverse" && e.kids.Count == 0) {
                L("  call void @zlist_reverse(i8* " + recv.op + ")");
                return new ExprVal("0", MkType("void"));
            }
            // string-method intrinsics win over same-named extensions: the
            // C host's call pipeline lowers these before any user-visible
            // method resolution, so s.Equals(',') packs the char argument
            // instead of binding the 3-arg Unicode Equals extension with a
            // raw pointer (B-ID109)
            if (IsStr(recv.ty) && HandlesStrMethod(mname, e.kids.Count)) {
                return EmitStrMethod(recv, mname, e);
            }
            // extension methods: only eligible if the receiver's nominal type
            // does NOT already own an applicable instance method or delegate field
            // of the same name (C# spec §12.8.9.2: instance methods shadow extensions).
            Node instCls = ClassOf(recv.ty);
            bool hasInst = instCls != null && (ResolveMethodUp(instCls, mname, e, false) != null
                || (FieldType(instCls, mname) != null && IsDelegate(FieldType(instCls, mname))));
            if (!hasInst) {
                List<Node> extMs = new List<Node>();
                List<string> extOwners = new List<string>();
                binder.FindExtensionAll(recv.ty.sval, mname, extMs, extOwners);
                if (extMs.Count > 0) {
                    int pick = PickExtension(extMs, recv.ty, e);
                    return EmitExtensionCall(recv, extOwners[pick], extMs[pick], e);
                }
            }
            // string methods
            if (IsStr(recv.ty)) { return EmitStrMethod(recv, mname, e); }
            // list methods
            if (IsListType(recv.ty)) { return EmitListMethod(recv, mname, e); }
            // dictionary methods
            if (IsDictType(recv.ty)) { return EmitDictMethod(recv, mname, e); }
            // string-builder methods
            if (IsSbType(recv.ty)) { return EmitSbMethod(recv, mname, e); }
            // array methods: GetLength on a rectangular array (the C host's
            // irgen_call.c reads the dimension out of the array's header)
            if (mname == "GetLength" && ArrRankOf(recv.ty) > 1) {
                return EmitGetLength(recv, e);
            }
            if (mname == "GetType" && e.kids.Count == 0) {
                return EmitGetType(recv);
            }
            // TypeInfo methods
            if (recv.ty != null && recv.ty.sval == "TypeInfo") {
                return EmitTypeInfoMethod(recv, mname, e);
            }
            if (mname == "HasField" || mname == "GetFieldString" || mname == "GetFieldInt" || mname == "GetFieldLong"
                || mname == "GetFieldDouble" || mname == "GetFieldBool" || mname == "GetFieldObject"
                || mname == "SetFieldString" || mname == "SetFieldInt" || mname == "SetFieldLong"
                || mname == "SetFieldDouble" || mname == "SetFieldBool" || mname == "SetFieldObject"
                || mname == "HasMethod" || mname == "Invoke" || mname == "InvokeInt" || mname == "InvokeLong"
                || mname == "InvokeDouble" || mname == "InvokeString" || mname == "InvokeObject") {
                Node testCls = ClassOf(recv.ty);
                if (testCls == null || FindMethodUp(testCls, mname) == null) {
                    return EmitReflInstCall(recv, mname, e);
                }
            }
            // instance method
            Node cls = ClassOf(recv.ty);
            if (cls != null) {
                // delegate-typed field invoked as obj.f(args)
                if (FindMethodUp(cls, mname) == null) {
                    Node fdty = FieldType(cls, mname);
                    if (fdty != null) {
                        if (IsDelegate(fdty)) {
                            return EmitDelegateCall(callee, fdty, e);
                        }
                        Node fcls = ClassOf(fdty);
                        if (fcls != null) {
                            if (FindStaticOpCall(fcls) != null) {
                                Node ma = new Node(AK.MemberAccess());
                                Node tn = new Node(AK.Ident());
                                tn.sval = fcls.sval;
                                ma.a = tn; ma.sval = "op_call";
                                ma.line = e.line; ma.col = e.col;
                                Node call = new Node(AK.Call());
                                call.a = ma; call.line = e.line; call.col = e.col;
                                call.Add(callee);
                                int ki = 0;
                                while (ki < e.kids.Count) { call.Add(e.kids[ki]); ki = ki + 1; }
                                return GenCall(call);
                            }
                            if (FindMethodUp(fcls, "op_call") != null) {
                                Node ma = new Node(AK.MemberAccess());
                                ma.a = callee; ma.sval = "op_call";
                                ma.line = e.line; ma.col = e.col;
                                Node call = new Node(AK.Call());
                                call.a = ma; call.line = e.line; call.col = e.col;
                                int ki = 0;
                                while (ki < e.kids.Count) { call.Add(e.kids[ki]); ki = ki + 1; }
                                return GenCall(call);
                            }
                        }
                    }
                    bool isOpenGen2 = IsErasedType(recv.ty) || curInstCls != "";
                    if (!isOpenGen2) {
                        Node cc = binder.FindType(curClass);
                        if (cc != null && TParams(cc).Count > 0) { isOpenGen2 = true; }
                        if (curMethodNode != null && TParams(curMethodNode).Count > 0) { isOpenGen2 = true; }
                    }
                    if (isOpenGen2) {
                        string msg = "call '" + mname + "' has no runtime body: resolvable only after generic specialization; instantiate the template via a derived class (default value returned)";
                        string text = "<unknown>:" + e.line + ":" + e.col + ": runtime error: " + msg + "\n\n";
                        string tsoft = RawCString(text);
                        if (!ExternSeen("zan_rt_soft_note")) {
                            externDecls.Add("zan_rt_soft_note");
                            H("declare void @zan_rt_soft_note(i8*)");
                        }
                        L("  call void @zan_rt_soft_note(i8* " + tsoft + ")");
                        Node retT = e.type != null ? e.type : (recv.ty != null ? recv.ty : MkType("int"));
                        return new ExprVal("0", retT);
                    }
                }
                // A507 自举半边：null 接收者的实例方法调用曾一路进方法体读
                // 字段 SIGSEGV 且无任何诊断。与宿主 irgen_call.c 局部变量快
                // 速路径同口径：软诊断（点名接收者位置）+ 软基址 scratch——
                // 字段读落在 scratch 上返零值，程序继续（--strict-runtime
                // 下 exit 70）。
                string rt0 = MapType(recv.ty);
                if (IsPtrLL(rt0)) {
                    string rn = NT();
                    L("  " + rn + " = icmp eq " + rt0 + " " + recv.op + ", null");
                    string rnm = obj != null && obj.kind == AK.Ident() && obj.sval != ""
                        ? obj.sval : mname;
                    EmitRuntimeCheckIf(e, rn,
                        "null reference: receiver '" + rnm + "' is null");
                    if (!ExternSeen("__zan_soft_scratch")) {
                        externDecls.Add("__zan_soft_scratch");
                        H("@__zan_soft_scratch = internal global [64 x i8] zeroinitializer");
                    }
                    string sb = NT();
                    L("  " + sb + " = getelementptr inbounds [64 x i8], [64 x i8]* @__zan_soft_scratch, i64 0, i64 0");
                    string sel = NT();
                    L("  " + sel + " = select i1 " + rn + ", i8* " + sb + ", i8* " + recv.op);
                    recv = new ExprVal(sel, recv.ty);
                }
                return EmitInstanceCall(recv, cls.sval, mname, e);
            }
            if (mname == "ToString" || mname == "Equals" || mname == "GetHashCode") {
                return EmitObjectFamilyCall(recv, mname, e);
            }
            if (recv.ty != null && recv.ty.ival >= 1 && (mname == "AsSpan" || mname == "AsReadOnlySpan")) {
                Node el = ArrElemOf(recv.ty);
                string ity = SpanIty(el);
                string bp = NT();
                L("  " + bp + " = bitcast i64* " + recv.op + " to " + ity + "*");
                string ep = bp;
                string lenOp = NT();
                L("  " + lenOp + " = call i64 @zarr_len(i64* " + recv.op + ")");
                if (e.kids.Count >= 1) {
                    ExprVal st = GenExpr(e.kids[0]);
                    string p = NT();
                    L("  " + p + " = getelementptr " + ity + ", " + ity + "* " + bp + ", i64 " + st.op);
                    ep = p;
                    string rem = NT();
                    L("  " + rem + " = sub i64 " + lenOp + ", " + st.op);
                    lenOp = rem;
                }
                if (e.kids.Count >= 2) {
                    ExprVal cnt = GenExpr(e.kids[1]);
                    lenOp = cnt.op;
                }
                string baseI8 = NT();
                L("  " + baseI8 + " = bitcast " + ity + "* " + ep + " to i8*");
                string iv0 = NT();
                L("  " + iv0 + " = insertvalue { i8*, i64 } undef, i8* " + baseI8 + ", 0");
                string iv1 = NT();
                L("  " + iv1 + " = insertvalue { i8*, i64 } " + iv0 + ", i64 " + lenOp + ", 1");
                Node spType = MkType(mname == "AsReadOnlySpan" ? "ReadOnlySpan" : "Span");
                spType.kids.Add(el);
                return new ExprVal(iv1, spType);
            }
            if (IsSpanType(recv.ty) && (mname == "Slice" || mname == "AsSpan" || mname == "AsReadOnlySpan")) {
                Node el = SpanElem(recv.ty);
                string ity = SpanIty(el);
                string oldBase = NT();
                L("  " + oldBase + " = extractvalue { i8*, i64 } " + recv.op + ", 0");
                string oldLen = NT();
                L("  " + oldLen + " = extractvalue { i8*, i64 } " + recv.op + ", 1");
                string bp = NT();
                L("  " + bp + " = bitcast i8* " + oldBase + " to " + ity + "*");
                string ep = bp;
                string lenOp = oldLen;
                if (e.kids.Count >= 1) {
                    ExprVal st = GenExpr(e.kids[0]);
                    string p = NT();
                    L("  " + p + " = getelementptr " + ity + ", " + ity + "* " + bp + ", i64 " + st.op);
                    ep = p;
                    string rem = NT();
                    L("  " + rem + " = sub i64 " + lenOp + ", " + st.op);
                    lenOp = rem;
                }
                if (e.kids.Count >= 2) {
                    ExprVal cnt = GenExpr(e.kids[1]);
                    lenOp = cnt.op;
                }
                string baseI8 = NT();
                L("  " + baseI8 + " = bitcast " + ity + "* " + ep + " to i8*");
                string iv0 = NT();
                L("  " + iv0 + " = insertvalue { i8*, i64 } undef, i8* " + baseI8 + ", 0");
                string iv1 = NT();
                L("  " + iv1 + " = insertvalue { i8*, i64 } " + iv0 + ", i64 " + lenOp + ", 1");
                Node spType = recv.ty;
                if (mname == "AsReadOnlySpan" && recv.ty.sval == "Span") {
                    spType = MkType("ReadOnlySpan");
                    spType.kids.Add(el);
                }
                return new ExprVal(iv1, spType);
            }
            // The receiver's type is not one the self-host can call methods
            // on. Fail closed: a silent 0 would hand the program wrong
            // answers without a word.
            //
            // A RECEIVER WHOSE TYPE IS A TYPE PARAMETER is the exception:
            // the C host is silent there too -- the generic body is a
            // template, and the real call happens in the monomorphized body
            // where the type argument is concrete.
            //
            // With a CONSTRAINT (`where T : IConn`) the template still knows
            // what the receiver offers: the call goes through the
            // constraint's member table -- an interface method is a virtual
            // call, a class method a direct one.
            if (IsErasedType(recv.ty)) {
                Node ct = TypeParamConstraint(recv.ty.sval);
                if (ct != null) {
                    Node ccls = ClassOf(ct);
                    if (ccls != null && FindMethodUp(ccls, mname) != null) {
                        ExprVal r = FromSlot(recv.op, ct);
                        if (HasMod(ccls, MOD.Iface())) {
                            return EmitInterfaceCall(r, ccls, mname, FindMethodUp(ccls, mname), e);
                        }
                        return EmitInstanceCall(r, ct.sval, mname, e);
                    }
                }
            }
            bool isOpenGen = IsErasedType(recv.ty) || curInstCls != "";
            if (!isOpenGen) {
                Node cc = binder.FindType(curClass);
                if (cc != null && TParams(cc).Count > 0) { isOpenGen = true; }
                if (curMethodNode != null && TParams(curMethodNode).Count > 0) { isOpenGen = true; }
            }
            if (isOpenGen) {
                string msg = "call '" + mname + "' has no runtime body: resolvable only after generic specialization; instantiate the template via a derived class (default value returned)";
                string text = "<unknown>:" + e.line + ":" + e.col + ": runtime error: " + msg + "\n\n";
                string tsoft = RawCString(text);
                if (!ExternSeen("zan_rt_soft_note")) {
                    externDecls.Add("zan_rt_soft_note");
                    H("declare void @zan_rt_soft_note(i8*)");
                }
                L("  call void @zan_rt_soft_note(i8* " + tsoft + ")");
                return new ExprVal("0", recv.ty != null ? recv.ty : MkType("int"));
            }
            diags.Error("call to '" + CallLabel(obj, mname)
                + "' is not supported by the self-hosted compiler yet", e.line, e.col);
            return new ExprVal("0", MkType("int"));
        }
        // bare call
        if (callee.kind == AK.Ident()) {
            string name = callee.sval;
            if (name == "sizeof" && e.kids.Count == 1) {
                Node stk = e.kids[0];
                string stn = "";
                if (stk != null) {
                    if (stk.type != null) { stn = stk.type.sval; }
                    else { stn = stk.sval; }
                }
                int sz = 8;
                if (stn == "bool" || stn == "byte" || stn == "sbyte") { sz = 1; }
                else if (stn == "short" || stn == "ushort") { sz = 2; }
                else if (stn == "int" || stn == "uint" || stn == "float") { sz = 4; }
                else {
                    Node sd = binder.FindType(stn);
                    if (sd != null && sd.kind == AK.StructDecl()) {
                        string t1 = NT();
                        L("  " + t1 + " = getelementptr %" + stn + ", %" + stn + "* null, i32 1");
                        string t2 = NT();
                        L("  " + t2 + " = ptrtoint %" + stn + "* " + t1 + " to i64");
                        return new ExprVal(t2, MkType("int"));
                    }
                }
                return new ExprVal("" + sz, MkType("int"));
            }
            // delegate invocation: a local of Func/Action type
            int dli = LocalIdx(name);
            if (dli >= 0 && IsDelegate(locType[dli])) {
                return EmitDelegateCall(callee, locType[dli], e);
            }
            // the invoked-object protocol: `E(args)` on a class-typed local
            if (dli >= 0) {
                ExprVal oc = TryGenOpCall(callee, e);
                if (oc != null) { return oc; }
            }
            // a STATIC delegate field of this class, invoked without a
            // qualifier (`cloneTree(root)` where `cloneTree` is a static
            // field): the field is a module global, not a method -- without
            // this the call went to a method symbol that does not exist
            // (`@App_cloneTree`), and the link failed.
            Node scls2 = binder.FindType(curClass);
            if (scls2 != null && FindMethodUp(scls2, name) == null) {
                Node sfd = FindStaticField(scls2, name);
                if (sfd != null && sfd.type != null && IsDelegate(sfd.type)) {
                    return EmitDelegateCall(callee, sfd.type, e);
                }
            }
            if (curHasThis) {
                Node cls = binder.FindType(curClass);
                Node bm = FindMethodUp(cls, name);
                if (bm != null && !IsStatic(bm)) {
                    ExprVal recv = new ExprVal("%this", CurThisTy());
                    return EmitInstanceCall(recv, curClass, name, e);
                }
                // delegate-typed field invoked without `this.`
                if (bm == null) {
                    Node fdty2 = FieldType(cls, name);
                    if (fdty2 != null) {
                        if (IsDelegate(fdty2)) {
                            return EmitDelegateCall(callee, fdty2, e);
                        }
                        Node fcls2 = ClassOf(fdty2);
                        if (fcls2 != null && (FindStaticOpCall(fcls2) != null || FindMethodUp(fcls2, "op_call") != null)) {
                            Node thisExpr = new Node(AK.ThisExpr());
                            Node ma = new Node(AK.MemberAccess());
                            ma.a = thisExpr; ma.sval = name;
                            ma.line = e.line; ma.col = e.col;
                            Node call = new Node(AK.Call());
                            call.a = ma; call.line = e.line; call.col = e.col;
                            int ki = 0;
                            while (ki < e.kids.Count) { call.Add(e.kids[ki]); ki = ki + 1; }
                            return GenCall(call);
                        }
                    }
                }
            }
            return EmitStaticCall(curClass, name, e);
        }
        // A call whose callee is neither a member access nor a plain name:
        // the only shape that lowers is a delegate-typed expression
        // (`filters[f](item)`) -- and the invoked-object protocol on a
        // class-typed expression (`Make()(5)`), which dispatches the
        // class's op_call with the expression as the receiver.
        {
            Node cty = ArgTypeNode(callee);
            Node ccls = ClassOf(cty);
            if (ccls != null) {
                if (FindStaticOpCall(ccls) != null) {
                    // Cls.op_call(<expr>, args...)
                    Node ma = new Node(AK.MemberAccess());
                    Node tn = new Node(AK.Ident());
                    tn.sval = ccls.sval;
                    ma.a = tn; ma.sval = "op_call";
                    ma.line = e.line; ma.col = e.col;
                    Node call = new Node(AK.Call());
                    call.a = ma; call.line = e.line; call.col = e.col;
                    call.Add(callee);
                    int i = 0;
                    while (i < e.kids.Count) { call.Add(e.kids[i]); i = i + 1; }
                    return GenCall(call);
                }
                if (FindMethodUp(ccls, "op_call") != null) {
                    // <expr>.op_call(args...)
                    Node ma = new Node(AK.MemberAccess());
                    ma.a = callee; ma.sval = "op_call";
                    ma.line = e.line; ma.col = e.col;
                    Node call = new Node(AK.Call());
                    call.a = ma; call.line = e.line; call.col = e.col;
                    int i = 0;
                    while (i < e.kids.Count) { call.Add(e.kids[i]); i = i + 1; }
                    return GenCall(call);
                }
            }
        }
        ExprVal clo = GenExpr(callee);
        if (clo.ty != null && IsDelegate(clo.ty)) {
            return EmitDelegateCallVal(clo, clo.ty, e);
        }
        diags.Error("call expression is not supported by the self-hosted compiler yet", e.line, e.col);
        return new ExprVal("0", MkType("int"));
    }

}
