using System;
using System.Collections.Generic;
namespace Zan;

partial class Irgen {
    // ---- static class fields: backed by internal module globals ----
    Node FindStaticField(Node cls, string name) {
        Node c = cls;
        while (c != null) {
            int i = 0;
            while (i < c.kids.Count) {
                Node m = c.kids[i];
                if (m.kind == AK.FieldDecl() && IsStatic(m) && m.sval == name) { return m; }
                i = i + 1;
            }
            c = BaseClassOf(c);
        }
        return null;
    }
    string StaticFieldOwner(Node cls, string name) {
        Node c = cls;
        while (c != null) {
            int i = 0;
            while (i < c.kids.Count) {
                Node m = c.kids[i];
                if (m.kind == AK.FieldDecl() && IsStatic(m) && m.sval == name) { return c.sval; }
                i = i + 1;
            }
            c = BaseClassOf(c);
        }
        return "";
    }
    // ---- generic class instantiations ----
    // The type arguments of a generic-qualified member access (`Stat<int>.s`):
    // the parser keeps them on the access's `d` slot.
    List<Node> InstArgsOf(Node access) {
        if (access == null || access.d == null) { return null; }
        if (access.d.kind != AK.TypeRef() || access.d.sval != "__typeargs") { return null; }
        return access.d.kids;
    }

    // The same, but only when the class is generic and every argument is
    // concrete: an open instantiation (`Stat<T>`) has no own storage.
    List<Node> ConcreteInstArgs(Node access, string clsName) {
        List<Node> a = InstArgsOf(access);
        if (a == null || a.Count == 0) { return null; }
        Node cls = binder.FindType(clsName);
        if (cls == null) { return null; }
        List<string> tps = TParams(cls);
        if (tps.Count == 0 || a.Count != tps.Count) { return null; }
        int i = 0;
        while (i < a.Count) {
            if (a[i] == null || MentionsTypeParam(a[i])) { return null; }
            i = i + 1;
        }
        return a;
    }

    // The suffix that tells one instantiation's storage from another's
    // (`int`, `double`, `string__int`, ...).
    string InstTag(List<Node> args) {
        if (args == null || args.Count == 0) { return ""; }
        string s = "";
        int i = 0;
        while (i < args.Count) {
            if (i > 0) { s = s + "__"; }
            s = s + TypeTag(args[i]);
            i = i + 1;
        }
        return s;
    }

    // The global that holds a static field. A generic class's static field has
    // one global per instantiation (the C host mangles the name with the
    // instantiation suffix); an ordinary class has exactly one.
    string StaticGlobal(string owner, string name, List<Node> args) {
        string g = "@__zan_sf_" + owner;
        string tag = InstTag(args);
        if (tag != "") { g = g + "_" + tag; }
        return g + "_" + name;
    }

    // The type of an instantiation (`Stat<int>`): the class name with the
    // concrete type arguments.
    Node InstType(string clsName, List<Node> args) {
        Node t = new Node(AK.TypeRef());
        t.sval = clsName;
        int i = 0;
        while (i < args.Count) { t.Add(args[i]); i = i + 1; }
        return t;
    }

    // Every instantiation of a generic class the program uses. The C host does
    // the same before emitting (`discover_generic_insts`): a generic class's
    // static storage exists per instantiation, so the backend has to know them
    // all before it emits the globals and the static initializers.
    void DiscoverInsts(Node unit) {
        CollectInsts(unit);
    }

    void CollectInsts(Node n) {
        if (n == null) { return; }
        if (n.kind == AK.TypeRef()) {
            if (n.sval != "__typeargs" && n.kids.Count > 0) { AddInst(n.sval, n.kids); }
        }
        if (n.kind == AK.MemberAccess() && n.a != null && n.a.kind == AK.Ident()) {
            List<Node> a = ConcreteInstArgs(n, n.a.sval);
            if (a != null) { AddInst(n.a.sval, a); }
        }
        CollectInsts(n.a); CollectInsts(n.b); CollectInsts(n.c); CollectInsts(n.d);
        CollectInsts(n.type);
        int i = 0;
        while (i < n.kids.Count) { CollectInsts(n.kids[i]); i = i + 1; }
    }

    void AddInst(string clsName, List<Node> args) {
        Node cls = binder.FindType(clsName);
        if (cls == null) { return; }
        List<string> tps = TParams(cls);
        if (tps.Count == 0 || args.Count != tps.Count) { return; }
        int i = 0;
        while (i < args.Count) {
            if (args[i] == null || MentionsTypeParam(args[i])) { return; }
            i = i + 1;
        }
        string key = clsName + "|" + InstTag(args);
        if (IndexOfStr(instKeys, key) >= 0) { return; }
        instKeys.Add(key);
        instClasses.Add(clsName);
        Node cont = new Node(AK.TypeRef());
        cont.sval = "__typeargs";
        int j = 0;
        while (j < args.Count) { cont.Add(args[j]); j = j + 1; }
        instConts.Add(cont);
    }

    // The instantiation that applies to a static field of `owner` accessed
    // without an explicit qualifier (inside the class): the current
    // instantiation when the owner is the class being specialized.
    List<Node> CurInstFor(string owner) {
        if (curInstCls == "" || curInstCls != owner) { return null; }
        if (curInstArgs == null || curInstArgs.Count == 0) { return null; }
        return curInstArgs;
    }

    void EnsureStaticGlobal(string owner, string name, List<Node> args, string lt) {
        string g = StaticGlobal(owner, name, args);
        if (IndexOfStr(declaredStaticGlobals, g) >= 0) { return; }
        declaredStaticGlobals.Add(g);
        H(g + " = internal global " + lt + " zeroinitializer");
    }

    ExprVal LoadStaticField(Node cls, string name, List<Node> args) {
        string owner = StaticFieldOwner(cls, name);
        Node sf = FindStaticField(cls, name);
        if (sf == null) { throw new Exception("unknown static field " + owner + "." + name); }
        Node fty = sf.type;
        // the field's type is written in the OWNING class's scope
        string savedScope = typeScopeCls;
        typeScopeCls = owner;
        // the storage shape does NOT depend on the instantiation: the C host
        // keeps the field's DECLARED type for every variant (`map_type(
        // fsym->type)`) and mangles only the NAME
        string lt = MapType(fty);
        EnsureStaticGlobal(owner, name, args, lt);
        string g = StaticGlobal(owner, name, args);
        string t = NT();
        L("  " + t + " = load " + lt + ", " + lt + "* " + g);
        typeScopeCls = savedScope;
        return new ExprVal(t, fty);
    }
    void StoreStaticField(Node cls, string name, ExprVal v, List<Node> args) {
        string owner = StaticFieldOwner(cls, name);
        Node sf = FindStaticField(cls, name);
        if (sf == null) { throw new Exception("unknown static field " + owner + "." + name); }
        Node fty = sf.type;
        // the field's type is written in the OWNING class's scope
        string savedScope = typeScopeCls;
        typeScopeCls = owner;
        string lt = MapType(fty);
        EnsureStaticGlobal(owner, name, args, lt);
        string g = StaticGlobal(owner, name, args);
        if (IsNullableValue(fty)) {
            L("  store i8* " + BoxFor(v, fty) + ", i8** " + g);
            typeScopeCls = savedScope;
            return;
        }
        if (ArcManaged(fty)) {
            string old = NT();
            L("  " + old + " = load " + lt + ", " + lt + "* " + g);
            string sv = Coerce(v, lt);
            L("  store " + lt + " " + sv + ", " + lt + "* " + g);
            EmitArcRetain(sv, fty);
            EmitArcRelease(old, fty);
            typeScopeCls = savedScope;
            return;
        }
        string sv = Coerce(v, lt);
        L("  store " + lt + " " + sv + ", " + lt + "* " + g);
        EmitArcRetainStore(sv, fty, v.ty);
        typeScopeCls = savedScope;
    }
    // Emit an internal global for each static field declared in `cls`.
    void EmitStaticGlobals(Node cls) {
        int i = 0;
        while (i < cls.kids.Count) {
            Node m = cls.kids[i];
            if (m.kind == AK.FieldDecl() && IsStatic(m)) {
                // the field's type is written in THIS class's scope
                string savedScope = typeScopeCls;
                typeScopeCls = cls.sval;
                string lt = MapType(m.type);
                typeScopeCls = savedScope;
                string baseG = "@__zan_sf_" + cls.sval + "_" + m.sval;
                if (IndexOfStr(declaredStaticGlobals, baseG) < 0) {
                    declaredStaticGlobals.Add(baseG);
                    H(baseG + " = internal global " + lt + " zeroinitializer");
                }
                // a generic class's static field has ONE global per
                // instantiation: the storage is not shared (`Stat<int>.s`
                // and `Stat<double>.s` are different cells)
                int k = 0;
                while (k < instClasses.Count) {
                    if (instClasses[k] == cls.sval) {
                        List<Node> args = instConts[k].kids;
                        string sc2 = typeScopeCls;
                        typeScopeCls = cls.sval;
                        string lt2 = MapType(m.type);
                        typeScopeCls = sc2;
                        EnsureStaticGlobal(cls.sval, m.sval, args, lt2);
                    }
                    k = k + 1;
                }
            }
            i = i + 1;
        }
    }

    int SinitTypeIndex(Node unit, string name) {
        if (name == null || name == "") { return -1; }
        int i = 0;
        while (i < unit.kids.Count) {
            Node d = unit.kids[i];
            if ((d.kind == AK.ClassDecl() || d.kind == AK.StructDecl()) && d.sval == name) {
                return i;
            }
            i = i + 1;
        }
        return -1;
    }

    void SinitScan(Node unit, int self, Node n, List<int> dep, int nTypes, int depth) {
        if (n == null || depth > 64) { return; }
        if (n.kind == AK.Ident()) {
            int j = SinitTypeIndex(unit, n.sval);
            if (j >= 0 && j != self) { dep[self * nTypes + j] = 1; }
            return;
        }
        if (n.kind == AK.TypeRef()) {
            int j = SinitTypeIndex(unit, n.sval);
            if (j >= 0 && j != self) { dep[self * nTypes + j] = 1; }
        }
        SinitScan(unit, self, n.a, dep, nTypes, depth + 1);
        SinitScan(unit, self, n.b, dep, nTypes, depth + 1);
        SinitScan(unit, self, n.c, dep, nTypes, depth + 1);
        SinitScan(unit, self, n.d, dep, nTypes, depth + 1);
        SinitScan(unit, self, n.type, dep, nTypes, depth + 1);
        int ki = 0;
        while (ki < n.kids.Count) {
            SinitScan(unit, self, n.kids[ki], dep, nTypes, depth + 1);
            ki = ki + 1;
        }
    }

    void SinitVisit(int i, int nTypes, List<int> dep, List<int> color, List<int> order) {
        if (color[i] != 0) { return; }
        color[i] = 1;
        int j = 0;
        while (j < nTypes) {
            if (dep[i * nTypes + j] != 0 && color[j] != 1) {
                SinitVisit(j, nTypes, dep, color, order);
            }
            j = j + 1;
        }
        color[i] = 2;
        order.Add(i);
    }

    List<int> SinitComputeOrder(Node unit) {
        int n = unit.kids.Count;
        List<int> order = new List<int>();
        if (n <= 0) { return order; }
        List<int> dep = new List<int>();
        List<int> color = new List<int>();
        int total = n * n;
        int idx = 0;
        while (idx < total) { dep.Add(0); idx = idx + 1; }
        idx = 0;
        while (idx < n) { color.Add(0); idx = idx + 1; }

        int i = 0;
        while (i < n) {
            Node d = unit.kids[i];
            if (d.kind == AK.ClassDecl() || d.kind == AK.StructDecl()) {
                int mi = 0;
                while (mi < d.kids.Count) {
                    Node m = d.kids[mi];
                    if (m.kind == AK.FieldDecl() && IsStatic(m) && m.b != null) {
                        SinitScan(unit, i, m.b, dep, n, 0);
                    } else if (m.kind == AK.CtorDecl() && IsStatic(m) && m.d != null) {
                        SinitScan(unit, i, m.d, dep, n, 0);
                    }
                    mi = mi + 1;
                }
            }
            i = i + 1;
        }

        i = 0;
        while (i < n) {
            SinitVisit(i, n, dep, color, order);
            i = i + 1;
        }

        i = 0;
        while (i < n) {
            bool seen = false;
            int k = 0;
            while (k < order.Count) {
                if (order[k] == i) { seen = true; break; }
                k = k + 1;
            }
            if (!seen) { order.Add(i); }
            i = i + 1;
        }
        return order;
    }

    // Run static-field initializers once at program entry (mirrors var-decl init).
    // B-ID92: 按依赖拓扑序发射（对齐 C11 emit_static_init_order），被依赖的类型先初始化。
    void EmitStaticInits(Node unit) {
        List<int> order = SinitComputeOrder(unit);
        int oi = 0;
        while (oi < order.Count) {
            Node d = unit.kids[order[oi]];
            if (d.kind == AK.ClassDecl() || d.kind == AK.StructDecl()) {
                curClass = d.sval; curHasThis = false;
                locName = new List<string>(); locType = new List<Node>(); locReg = new List<string>();
                locOpaque = new List<bool>();
                // a generic class's static storage is per instantiation: the
                // erased cell never exists (the C host emits the variants
                // only), so the initializers run once per instantiation
                if (TParams(d).Count == 0) { EmitStaticFieldInits(d, null); }
                int k = 0;
                while (k < instClasses.Count) {
                    if (instClasses[k] == d.sval) {
                        EmitStaticFieldInits(d, instConts[k].kids);
                    }
                    k = k + 1;
                }
                // the class's static constructor runs after its static field
                // initializers (the C host's order)
                int j = 0;
                while (j < d.kids.Count) {
                    Node cm = d.kids[j];
                    if (cm.kind == AK.CtorDecl() && IsStatic(cm)) {
                        L("  call void @" + StaticCtorSym(d.sval) + "()");
                    }
                    j = j + 1;
                }
            }
            oi = oi + 1;
        }
    }

    // The static field initializers of a class: for the erased storage, or for
    // one instantiation's own cells.
    void EmitStaticFieldInits(Node d, List<Node> args) {
        List<Node> sargs = curInstArgs; string scls = curInstCls;
        curInstArgs = args; curInstCls = d.sval;
        int j = 0;
        while (j < d.kids.Count) {
            Node m = d.kids[j];
            if (m.kind == AK.FieldDecl() && IsStatic(m) && m.b != null) {
                if (FoldStaticArrayInit(d, m, args)) { j = j + 1; continue; }
                ExprVal iv = GenExpr(m.b);
                Node fty = m.type;
                string savedScope = typeScopeCls;
                typeScopeCls = d.sval;
                string lt = MapType(fty);
                typeScopeCls = savedScope;
                string g = StaticGlobal(d.sval, m.sval, args);
                if (IsNullableValue(fty)) {
                    L("  store i8* " + BoxFor(iv, fty) + ", i8** " + g);
                } else {
                    // a float field carries single precision: the host stores
                    // an f32
                    if (IsFloatTy(fty) && iv != null && iv.ty != null && IsDbl(iv.ty)) {
                        iv = new ExprVal(F32Round(iv.op), iv.ty);
                    }
                    string sv = Coerce(iv, lt);
                    L("  store " + lt + " " + sv + ", " + lt + "* " + g);
                    EmitArcRetainStore(sv, fty, iv.ty);
                }
            }
            else if (m.kind == AK.FieldDecl() && IsStatic(m)) {
                // a static field without an initializer: the C host gives a
                // struct field a default instance, here a struct instance is
                // a heap object, so the cell needs one of its own
                Node fty = m.type;
                string savedScope = typeScopeCls;
                typeScopeCls = d.sval;
                string lt = MapType(fty);
                typeScopeCls = savedScope;
                if (IsStructTy(fty)) {
                    string g = StaticGlobal(d.sval, m.sval, args);
                    string o = NT();
                    L("  " + o + " = call i8* @" + fty.sval + "_newobj()");
                    string op = NT();
                    L("  " + op + " = bitcast i8* " + o + " to " + lt);
                    L("  store " + lt + " " + op + ", " + lt + "* " + g);
                }
            }
            j = j + 1;
        }
        curInstArgs = sargs; curInstCls = scls;
    }

    // A static field whose initializer is `new T[] { ... }` with an
    // all-constant element list folds into one internal global. The
    // per-element GEP+store expansion of a 1400-entry stdlib table turned
    // main into tens of thousands of lines (G8 round 1) -- the same bytes
    // as a global initializer cost none. The global keeps the runtime
    // bundle layout ([i64 pad][i64 len][elements...], the field slot
    // pointing at the element base, GEP index 2) so reads, writes and
    // runtime type tests see the same shape; it is `global` and not
    // `constant` because the array is mutable at runtime. Only 8-byte
    // integer-ish slots fold: a double element needs its IEEE bits, a
    // byte[] is byte-packed, string/class/nullable elements are pointers
    // or boxed slots -- all stay on the GenNew expansion path.
    bool FoldStaticArrayInit(Node d, Node m, List<Node> args) {
        Node b = m.b;
        if (b == null || b.kind != AK.NewExpr() || b.ival != 1 || b.b != null) { return false; }
        string rkl = b.arrRanks;
        if (rkl == null) { rkl = ""; }
        if (Node.ArrRankCount(rkl) != 1) { return false; }
        Node ty = m.type;
        if (ty == null) { return false; }
        // the same type-node derivation GenNew uses, so the element
        // nullable flag and the rank travel identically
        Node at = MkType(ty.sval); at.ival = 1; at.op = ty.op; at.kids = ty.kids; at.arrRanks = rkl;
        Node et = ArrElemOf(at);
        if (et == null || IsNullableValue(et) || IsStructTy(et) || IsFloatTy(et)) { return false; }
        if (et.sval == "byte" || et.sval == "sbyte") { return false; }
        if (MapType(et) != "i64") { return false; }
        int n = b.kids.Count;
        string vals = "";
        int i = 0;
        while (i < n) {
            Node el = b.kids[i];
            if (!IsConstSlotElem(el)) { return false; }
            if (i > 0) { vals = vals + ", "; }
            vals = vals + "i64 " + ConstSlotElemText(el);
            i = i + 1;
        }
        starrn = starrn + 1;
        string g = "@.starr" + starrn;
        H(g + " = internal global [" + (n + 2) + " x i64] [i64 0, i64 " + n + (n > 0 ? ", " + vals : "") + "]");
        string p = NT();
        L("  " + p + " = getelementptr inbounds [" + (n + 2) + " x i64], [" + (n + 2) + " x i64]* " + g + ", i64 0, i64 2");
        L("  store i64* " + p + ", i64** " + StaticGlobal(d.sval, m.sval, args));
        return true;
    }

    bool IsConstSlotElem(Node e) {
        if (e == null) { return false; }
        int k = e.kind;
        if (k == AK.BoolLit() || k == AK.CharLit()) { return true; }
        return IsConstInt(e);
    }

    string ConstSlotElemText(Node e) {
        int k = e.kind;
        if (k == AK.BoolLit() || k == AK.CharLit()) { return "" + e.ival; }
        return "" + EvalConstInt(e);
    }

}
