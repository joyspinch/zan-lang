using System;
using System.Collections.Generic;
namespace Zan;

partial class Irgen {
    // ---- static class fields: backed by internal module globals ----
    Node FindStaticField(Node cls, string name) {
        Node c = cls;
        while (c != null) {
            int i = 0;
            while (i < c.kids.Count) {
                Node m = c.kids[i];
                if (m.kind == AK.FieldDecl() && IsStatic(m) && m.sval == name) { return m; }
                i = i + 1;
            }
            c = BaseClassOf(c);
        }
        return null;
    }
    string StaticFieldOwner(Node cls, string name) {
        Node c = cls;
        while (c != null) {
            int i = 0;
            while (i < c.kids.Count) {
                Node m = c.kids[i];
                if (m.kind == AK.FieldDecl() && IsStatic(m) && m.sval == name) { return c.sval; }
                i = i + 1;
            }
            c = BaseClassOf(c);
        }
        return "";
    }
    // ---- generic class instantiations ----
    // The type arguments of a generic-qualified member access (`Stat<int>.s`):
    // the parser keeps them on the access's `d` slot.
    List<Node> InstArgsOf(Node access) {
        if (access == null || access.d == null) { return null; }
        if (access.d.kind != AK.TypeRef() || access.d.sval != "__typeargs") { return null; }
        return access.d.kids;
    }

    // The same, but only when the class is generic and every argument is
    // concrete: an open instantiation (`Stat<T>`) has no own storage.
    List<Node> ConcreteInstArgs(Node access, string clsName) {
        List<Node> a = InstArgsOf(access);
        if (a == null || a.Count == 0) { return null; }
        Node cls = binder.FindType(clsName);
        if (cls == null) { return null; }
        List<string> tps = TParams(cls);
        if (tps.Count == 0 || a.Count != tps.Count) { return null; }
        int i = 0;
        while (i < a.Count) {
            if (a[i] == null || MentionsTypeParam(a[i])) { return null; }
            i = i + 1;
        }
        return a;
    }

    // The suffix that tells one instantiation's storage from another's
    // (`int`, `double`, `string__int`, ...).
    string InstTag(List<Node> args) {
        if (args == null || args.Count == 0) { return ""; }
        string s = "";
        int i = 0;
        while (i < args.Count) {
            if (i > 0) { s = s + "__"; }
            s = s + TypeTag(args[i]);
            i = i + 1;
        }
        return s;
    }

    // The global that holds a static field. A generic class's static field has
    // one global per instantiation (the C host mangles the name with the
    // instantiation suffix); an ordinary class has exactly one.
    string StaticGlobal(string owner, string name, List<Node> args) {
        string g = "@__zan_sf_" + owner;
        string tag = InstTag(args);
        if (tag != "") { g = g + "_" + tag; }
        return g + "_" + name;
    }

    // The type of an instantiation (`Stat<int>`): the class name with the
    // concrete type arguments.
    Node InstType(string clsName, List<Node> args) {
        Node t = new Node(AK.TypeRef());
        t.sval = clsName;
        int i = 0;
        while (i < args.Count) { t.Add(args[i]); i = i + 1; }
        return t;
    }

    // Every instantiation of a generic class the program uses. The C host does
    // the same before emitting (`discover_generic_insts`): a generic class's
    // static storage exists per instantiation, so the backend has to know them
    // all before it emits the globals and the static initializers.
    void DiscoverInsts(Node unit) {
        CollectInsts(unit);
    }

    void CollectInsts(Node n) {
        if (n == null) { return; }
        if (n.kind == AK.TypeRef()) {
            if (n.sval != "__typeargs" && n.kids.Count > 0) { AddInst(n.sval, n.kids); }
        }
        if (n.kind == AK.MemberAccess() && n.a != null && n.a.kind == AK.Ident()) {
            List<Node> a = ConcreteInstArgs(n, n.a.sval);
            if (a != null) { AddInst(n.a.sval, a); }
        }
        CollectInsts(n.a); CollectInsts(n.b); CollectInsts(n.c); CollectInsts(n.d);
        CollectInsts(n.type);
        int i = 0;
        while (i < n.kids.Count) { CollectInsts(n.kids[i]); i = i + 1; }
    }

    void AddInst(string clsName, List<Node> args) {
        Node cls = binder.FindType(clsName);
        if (cls == null) { return; }
        List<string> tps = TParams(cls);
        if (tps.Count == 0 || args.Count != tps.Count) { return; }
        int i = 0;
        while (i < args.Count) {
            if (args[i] == null || MentionsTypeParam(args[i])) { return; }
            i = i + 1;
        }
        string key = clsName + "|" + InstTag(args);
        if (IndexOfStr(instKeys, key) >= 0) { return; }
        instKeys.Add(key);
        instClasses.Add(clsName);
        Node cont = new Node(AK.TypeRef());
        cont.sval = "__typeargs";
        int j = 0;
        while (j < args.Count) { cont.Add(args[j]); j = j + 1; }
        instConts.Add(cont);
    }

    // The instantiation that applies to a static field of `owner` accessed
    // without an explicit qualifier (inside the class): the current
    // instantiation when the owner is the class being specialized.
    List<Node> CurInstFor(string owner) {
        if (curInstCls == "" || curInstCls != owner) { return null; }
        if (curInstArgs == null || curInstArgs.Count == 0) { return null; }
        return curInstArgs;
    }

    void EnsureStaticGlobal(string owner, string name, List<Node> args, string lt) {
        string g = StaticGlobal(owner, name, args);
        if (IndexOfStr(declaredStaticGlobals, g) >= 0) { return; }
        declaredStaticGlobals.Add(g);
        H(g + " = internal global " + lt + " zeroinitializer");
    }

    ExprVal LoadStaticField(Node cls, string name, List<Node> args) {
        string owner = StaticFieldOwner(cls, name);
        Node sf = FindStaticField(cls, name);
        if (sf == null) { throw new Exception("unknown static field " + owner + "." + name); }
        Node fty = sf.type;
        // the field's type is written in the OWNING class's scope
        string savedScope = typeScopeCls;
        typeScopeCls = owner;
        // the storage shape does NOT depend on the instantiation: the C host
        // keeps the field's DECLARED type for every variant (`map_type(
        // fsym->type)`) and mangles only the NAME
        string lt = MapType(fty);
        DemandStaticType(owner, args);
        EnsureStaticGlobal(owner, name, args, lt);
        string g = StaticGlobal(owner, name, args);
        string t = NT();
        L("  " + t + " = load " + lt + ", " + lt + "* " + g);
        typeScopeCls = savedScope;
        return new ExprVal(t, fty);
    }
    void StoreStaticField(Node cls, string name, ExprVal v, List<Node> args) {
        string owner = StaticFieldOwner(cls, name);
        Node sf = FindStaticField(cls, name);
        if (sf == null) { throw new Exception("unknown static field " + owner + "." + name); }
        Node fty = sf.type;
        // the field's type is written in the OWNING class's scope
        string savedScope = typeScopeCls;
        typeScopeCls = owner;
        string lt = MapType(fty);
        DemandStaticType(owner, args);
        EnsureStaticGlobal(owner, name, args, lt);
        string g = StaticGlobal(owner, name, args);
        if (IsNullableValue(fty)) {
            StoreNullable(g, v, fty, true);
            typeScopeCls = savedScope;
            return;
        }
        if (ArcManaged(fty) || (fty != null && fty.ival >= 1)) {
            string old = NT();
            L("  " + old + " = load " + lt + ", " + lt + "* " + g);
            string sv = Coerce(v, lt);
            L("  store " + lt + " " + sv + ", " + lt + "* " + g);
            EmitArcRetain(sv, fty);
            EmitArcRelease(old, fty);
            typeScopeCls = savedScope;
            return;
        }
        string sv = Coerce(v, lt);
        L("  store " + lt + " " + sv + ", " + lt + "* " + g);
        EmitArcRetainStore(sv, fty, v.ty);
        typeScopeCls = savedScope;
    }
    // Emit an internal global for each static field declared in `cls`.
    void EmitStaticGlobals(Node cls) {
        int i = 0;
        while (i < cls.kids.Count) {
            Node m = cls.kids[i];
            if (m.kind == AK.FieldDecl() && IsStatic(m)) {
                // the field's type is written in THIS class's scope
                string savedScope = typeScopeCls;
                typeScopeCls = cls.sval;
                string lt = MapType(m.type);
                typeScopeCls = savedScope;
                string baseG = "@__zan_sf_" + cls.sval + "_" + m.sval;
                if (IndexOfStr(declaredStaticGlobals, baseG) < 0) {
                    declaredStaticGlobals.Add(baseG);
                    H(baseG + " = internal global " + lt + " zeroinitializer");
                }
                // a generic class's static field has ONE global per
                // instantiation: the storage is not shared (`Stat<int>.s`
                // and `Stat<double>.s` are different cells)
                int k = 0;
                while (k < instClasses.Count) {
                    if (instClasses[k] == cls.sval) {
                        List<Node> args = instConts[k].kids;
                        string sc2 = typeScopeCls;
                        typeScopeCls = cls.sval;
                        string lt2 = MapType(m.type);
                        typeScopeCls = sc2;
                        EnsureStaticGlobal(cls.sval, m.sval, args, lt2);
                    }
                    k = k + 1;
                }
            }
            i = i + 1;
        }
    }

    // A demand marker is a compiler-only comment in its actual function. It
    // survives deferred/lambda emission without maintaining a second call
    // resolver. ResolveStaticInits consumes and removes it before returning IR.
    int StaticInitType(string owner, List<Node> args) {
        Node cls = binder.FindType(owner);
        if (cls == null || HasMod(cls, MOD.Iface())) { return -1; }
        if (cls.kind != AK.ClassDecl() && cls.kind != AK.StructDecl()) { return -1; }
        List<string> tps = TParams(cls);
        if (tps.Count > 0) {
            if (args == null || args.Count != tps.Count) { return -1; }
            int ai = 0;
            while (ai < args.Count) {
                if (args[ai] == null || MentionsTypeParam(args[ai])) { return -1; }
                ai = ai + 1;
            }
            AddInst(owner, args);
        } else { args = new List<Node>(); }
        string sym = "__zan_sinit_" + owner;
        string tag = InstTag(args);
        if (tag != "") { sym = sym + "__SPI_" + tag; }
        int at = IndexOfStr(sinitSyms, sym);
        if (at >= 0) { return at; }
        sinitSyms.Add(sym);
        sinitTypes.Add(InstType(owner, args));
        return sinitTypes.Count - 1;
    }

    void DemandStaticType(string owner, List<Node> args) {
        int at = StaticInitType(owner, args);
        if (at >= 0) { L("  ; zan.sinit @" + sinitSyms[at]); }
    }

    void NoteStaticExport(Node cls, Node m, string sym) {
        if (libOut && !HasMod(m, MOD.Private()) && TParams(cls).Count == 0
        && TParams(m).Count == 0 && IndexOfStr(sinitExportRoots, sym) < 0) {
            sinitExportRoots.Add(sym);
            if (!IsStatic(m)) { DemandNewType(MkType(cls.sval)); }
            int i = 0;
            while (i < m.kids.Count) {
                if (m.kids[i].kind == AK.Param()) { DemandExternalType(m.kids[i].type); }
                i = i + 1;
            }
        }
    }

    void DemandNewType(Node ty) {
        if (ty == null || ty.ival != 0) { return; }
        int at = StaticInitType(ty.sval, ty.kids);
        if (at >= 0) { L("  ; zan.new @" + sinitSyms[at]); }
    }

    void DemandExternalType(Node ty) {
        if (ty == null || ty.ival != 0 || IsErasedType(ty)) { return; }
        Node declared = binder.FindType(ty.sval);
        if (declared == null && ty.sval != "object") { return; }
        int i = 0;
        while (i < sinitTypes.Count) {
            Node candidate = binder.FindType(sinitTypes[i].sval);
            if (candidate != null && !HasMod(candidate, MOD.Abstract())
            && (ty.sval == "object" || binder.IsAssignableFrom(ty.sval, candidate.sval))) {
                L("  ; zan.new @" + sinitSyms[i]);
            }
            i = i + 1;
        }
    }

    string StaticDispatchMarker(Node cls, Node method, string target, Node instance = null) {
        int at = sinitDispatchTypes.Count;
        sinitDispatchTypes.Add(instance == null ? MkType(cls.sval) : instance);
        sinitDispatchMethods.Add(method);
        sinitDispatchTargets.Add(target);
        return " ; zan.dispatch " + at;
    }

    // Record each actual vtable slot target, including ABI adapters and
    // specialized bodies. The table itself is metadata, never a startup root.
    void NoteStaticVtable(string table, int slot, string target) {
        sinitDispatchTables.Add(table);
        sinitDispatchSlots.Add(slot);
        sinitVtableTargets.Add(target);
    }

    void SeedStaticInitTypes(Node unit) {
        int i = 0;
        while (i < unit.kids.Count) {
            Node cls = unit.kids[i];
            if (cls.kind == AK.ClassDecl() || cls.kind == AK.StructDecl()) {
                if (TParams(cls).Count == 0) { StaticInitType(cls.sval, null); }
            }
            i = i + 1;
        }
        i = 0;
        while (i < instClasses.Count) {
            StaticInitType(instClasses[i], instConts[i].kids);
            i = i + 1;
        }
    }

    void GenStaticInit(Node instTy, string sym) {
        Node cls = binder.FindType(instTy.sval);
        if (cls == null) { return; }
        Node d = cls;
        List<string> tps = TParams(cls);
        if (tps.Count > 0) {
            d = CloneSubst(cls, tps, instTy.kids);
            int fi = 0;
            while (fi < cls.kids.Count) {
                if (cls.kids[fi].kind == AK.FieldDecl()) {
                    // Only the initializer is specialized. Static storage
                    // keeps the declaration-form ABI used by field accesses.
                    d.kids[fi].type = cls.kids[fi].type;
                }
                fi = fi + 1;
            }
        }
        Node savedThis = curThisTy;
        List<Node> savedArgs = curInstArgs;
        string savedCls = curInstCls;
        curThisTy = instTy; curInstArgs = instTy.kids; curInstCls = cls.sval;
        // Discoveries made by a specialized body can arrive after the first
        // global-emission pass. Declare storage before generating its writes.
        int j = 0;
        while (j < cls.kids.Count) {
            Node f = cls.kids[j];
            if (f.kind == AK.FieldDecl() && IsStatic(f)) {
                string scope = typeScopeCls;
                typeScopeCls = cls.sval;
                EnsureStaticGlobal(cls.sval, f.sval, instTy.kids, MapType(f.type));
                typeScopeCls = scope;
            }
            j = j + 1;
        }
        StartFn();
        curClass = cls.sval; curHasThis = false; curRet = "void"; curRetTy = MkType("void");
        L("define internal void @" + sym + "() {");
        L("entry:");
        StringBuilder obody = body; StringBuilder oea = entryAllocas; bool oact = eaActive;
        body = new StringBuilder(); entryAllocas = new StringBuilder(); eaActive = true;
        EmitStaticFieldInits(d, instTy.kids);
        j = 0;
        while (j < d.kids.Count) {
            Node cm = d.kids[j];
            if (cm.kind == AK.CtorDecl() && IsStatic(cm)) {
                L("  call void @" + sym + "_cctor()");
            }
            j = j + 1;
        }
        EmitTempReleases();
        if (!term) { ReleaseLocalsFrom(0); L("  ret void"); }
        L("}");
        obody.Append(entryAllocas.ToString()); obody.Append(body.ToString());
        body = obody; entryAllocas = oea; eaActive = oact;
        j = 0;
        while (j < d.kids.Count) {
            Node cm = d.kids[j];
            if (cm.kind == AK.CtorDecl() && IsStatic(cm)) {
                GenStaticCtorAs(d, cm, sym + "_cctor");
            }
            j = j + 1;
        }
        curThisTy = savedThis; curInstArgs = savedArgs; curInstCls = savedCls;
    }

    void EmitStaticInits(Node unit) {
        L("  call void @__zan_static_init()");
    }

    // Build the execution graph from emitted functions only. Unlike code
    // retention, globals (type metadata, vtables, descriptors) are not roots.
    // A function pointer produced by live code remains an executable edge.
    string ResolveStaticInits(string modText) {
        List<int> starts = new List<int>();
        List<int> ends = new List<int>();
        List<Node> refs = new List<Node>();
        List<Node> dispatch = new List<Node>();
        List<Node> news = new List<Node>();
        Dictionary<string, int> defs = new Dictionary<string, int>();
        int pos = 0;
        int current = -1;
        while (pos < modText.Length) {
            int nl = modText.IndexOf("\n", pos);
            if (nl < 0) { nl = modText.Length; }
            string line = modText.Substring(pos, nl - pos);
            if (line.StartsWith("define ")) {
                current = refs.Count;
                defs[HeadSymbol(line)] = current;
                starts.Add(pos); ends.Add(modText.Length);
                refs.Add(new Node(AK.TypeRef()));
                dispatch.Add(new Node(AK.TypeRef()));
                news.Add(new Node(AK.TypeRef()));
            } else if (current >= 0 && line == "}") {
                ends[current] = nl;
                current = -1;
            } else if (current >= 0) {
                int dm = line.IndexOf(" ; zan.dispatch ");
                if (dm >= 0) {
                    Node d = new Node(AK.TypeRef());
                    d.ival = int.Parse(line.Substring(dm + 16));
                    dispatch[current].Add(d);
                } else {
                    List<string> names = new List<string>();
                    CollectHeadRefs(line, names);
                    int ni = 0;
                    while (ni < names.Count) {
                        refs[current].Add(MkType(names[ni]));
                        ni = ni + 1;
                    }
                    if (line.StartsWith("  ; zan.new @")) {
                        int nt = IndexOfStr(sinitSyms, HeadSymbol(line));
                        if (nt >= 0) {
                            Node n = new Node(AK.TypeRef()); n.ival = nt;
                            news[current].Add(n);
                        }
                    }
                }
            }
            pos = nl + 1;
        }
        List<int> roots = new List<int>();
        if (defs.ContainsKey("main")) { roots.Add(defs["main"]); }
        int i = 0;
        while (i < sinitExportRoots.Count) {
            if (defs.ContainsKey(sinitExportRoots[i])) { roots.Add(defs[sinitExportRoots[i]]); }
            i = i + 1;
        }
        // Keep compiler-discovered order deterministic. References inside
        // unused initialization functions never become roots of this walk.
        List<int> liveNew = new List<int>();
        i = 0;
        while (i < sinitTypes.Count) { liveNew.Add(0); i = i + 1; }
        List<int> live = StaticReach(roots, refs, dispatch, news, defs, liveNew);
        List<int> colors = new List<int>();
        List<int> order = new List<int>();
        i = 0;
        while (i < sinitTypes.Count) { colors.Add(0); i = i + 1; }
        i = 0;
        while (i < sinitSyms.Count) {
            if (defs.ContainsKey(sinitSyms[i]) && live[defs[sinitSyms[i]]] != 0) {
                StaticInitVisit(i, refs, dispatch, news, defs, colors, order, liveNew, live);
            }
            i = i + 1;
        }
        StringBuilder result = new StringBuilder();
        // Do not leave demand markers in the final text: the existing prune
        // pass must not mistake startup demand for runtime call references.
        pos = 0;
        int di = 0;
        while (pos < modText.Length) {
            if (di < starts.Count && pos == starts[di]) {
                string block = modText.Substring(starts[di], ends[di] - starts[di]);
                string sym = HeadSymbol(block);
                bool initBody = sym.StartsWith("__zan_sinit_");
                if (initBody && live[di] == 0) {
                    pos = ends[di] + 1; di = di + 1;
                    continue;
                }
                di = di + 1;
            }
            int nl = modText.IndexOf("\n", pos);
            if (nl < 0) { nl = modText.Length; }
            string line = modText.Substring(pos, nl - pos);
            if (!line.StartsWith("  ; zan.sinit @") && !line.StartsWith("  ; zan.new @")) {
                int dm = line.IndexOf(" ; zan.dispatch ");
                if (dm >= 0) { line = line.Substring(0, dm); }
                result.Append(line); result.Append("\n");
            }
            pos = nl + 1;
        }
        result.Append("define internal void @__zan_static_init() {\nentry:\n");
        i = 0;
        while (i < order.Count) {
            result.Append("  call void @" + sinitSyms[order[i]] + "()\n");
            i = i + 1;
        }
        result.Append("  ret void\n}\n");
        if (libOut) {
            result.Append("@llvm.global_ctors = appending global [1 x { i32, void ()*, i8* }] [{ i32, void ()*, i8* } { i32 65535, void ()* @__zan_static_init, i8* null }]\n");
        }
        return result.ToString();
    }

    List<int> StaticReach(List<int> roots, List<Node> refs, List<Node> dispatch,
    List<Node> news, Dictionary<string, int> defs, List<int> knownNew) {
        List<int> seen = new List<int>();
        List<int> made = knownNew;
        List<int> queue = new List<int>();
        int i = 0;
        while (i < refs.Count) { seen.Add(0); i = i + 1; }
        i = 0;
        while (i < roots.Count) { StaticEnqueue(roots[i], seen, queue); i = i + 1; }
        int qi = 0;
        bool changed = true;
        while (changed) {
            changed = false;
            while (qi < queue.Count) {
                int fi = queue[qi]; qi = qi + 1;
                int ri = 0;
                while (ri < refs[fi].kids.Count) {
                    string refSym = refs[fi].kids[ri].sval;
                    if (defs.ContainsKey(refSym)) { StaticEnqueue(defs[refSym], seen, queue); }
                    ri = ri + 1;
                }
                ri = 0;
                while (ri < news[fi].kids.Count) {
                    made[news[fi].kids[ri].ival] = 1;
                    ri = ri + 1;
                }
                changed = true;
            }
            // An indirect call is an edge only for types that can exist. A
            // metadata-only derived class must not run its override's effects.
            i = 0;
            while (i < queue.Count) {
                int fi = queue[i]; int dj = 0;
                while (dj < dispatch[fi].kids.Count) {
                    int dc = dispatch[fi].kids[dj].ival;
                    Node recvTy = sinitDispatchTypes[dc];
                    string directTarget = sinitDispatchTargets[dc];
                    int ti = 0;
                    while (ti < made.Count) {
                        if (made[ti] != 0) {
                            Node instTy = sinitTypes[ti];
                            Node cls = binder.FindType(instTy.sval);
                            bool matches = directTarget == ""
                                ? binder.IsAssignableFrom(recvTy.sval, instTy.sval)
                                : binder.SameType(recvTy, instTy);
                            if (cls != null && matches) {
                                string target = directTarget;
                                if (target == "") { target = StaticVtableTarget(cls, instTy, sinitDispatchMethods[dc]); }
                                if (defs.ContainsKey(target)) { StaticEnqueue(defs[target], seen, queue); }
                            }
                        }
                        ti = ti + 1;
                    }
                    dj = dj + 1;
                }
                i = i + 1;
            }
            if (qi < queue.Count) { changed = true; }
        }
        return seen;
    }

    void StaticEnqueue(int at, List<int> seen, List<int> queue) {
        if (seen[at] == 0) { seen[at] = 1; queue.Add(at); }
    }

    string StaticVtableTarget(Node cls, Node instTy, Node method) {
        int slot = VSlotIndexM(cls, method);
        if (slot < 0) { return ""; }
        string table = cls.sval + "_vtable";
        int vi = 0;
        while (vi < specVtSyms.Count) {
            if (specVtCls[vi].sval == cls.sval
            && InstTag(specVtArgs[vi].kids) == InstTag(instTy.kids)) {
                table = specVtSyms[vi]; break;
            }
            vi = vi + 1;
        }
        vi = 0;
        while (vi < sinitDispatchTables.Count) {
            if (sinitDispatchTables[vi] == table && sinitDispatchSlots[vi] == slot) {
                return sinitVtableTargets[vi];
            }
            vi = vi + 1;
        }
        return "";
    }

    void StaticInitVisit(int at, List<Node> refs, List<Node> dispatch, List<Node> news,
    Dictionary<string, int> defs, List<int> colors, List<int> order,
    List<int> liveNew, List<int> live) {
        if (colors[at] != 0) { return; }
        colors[at] = 1;
        List<int> roots = new List<int>(); roots.Add(defs[sinitSyms[at]]);
        List<int> made = new List<int>();
        int i = 0;
        while (i < liveNew.Count) { made.Add(liveNew[i]); i = i + 1; }
        List<int> deps = StaticReach(roots, refs, dispatch, news, defs, made);
        i = 0;
        while (i < sinitTypes.Count) {
            if (i != at && colors[i] != 1 && defs.ContainsKey(sinitSyms[i])
            && live[defs[sinitSyms[i]]] != 0 && deps[defs[sinitSyms[i]]] != 0) {
                StaticInitVisit(i, refs, dispatch, news, defs, colors, order, liveNew, live);
            }
            i = i + 1;
        }
        colors[at] = 2; order.Add(at);
    }

    // The static field initializers of a class: for the erased storage, or for
    // one instantiation's own cells.
    void EmitStaticFieldInits(Node d, List<Node> args) {
        List<Node> sargs = curInstArgs; string scls = curInstCls;
        curInstArgs = args; curInstCls = d.sval;
        int j = 0;
        while (j < d.kids.Count) {
            Node m = d.kids[j];
            if (m.kind == AK.FieldDecl() && IsStatic(m) && m.b != null) {
                if (FoldStaticArrayInit(d, m, args)) { j = j + 1; continue; }
                List<string> savedTemps = stmtTemps;
                List<Node> savedTempTypes = stmtTempTypes;
                stmtTemps = new List<string>(); stmtTempTypes = new List<Node>();
                ExprVal iv = GenExpr(m.b);
                Node fty = m.type;
                string savedScope = typeScopeCls;
                typeScopeCls = d.sval;
                string lt = MapType(fty);
                typeScopeCls = savedScope;
                string g = StaticGlobal(d.sval, m.sval, args);
                if (IsNullableValue(fty)) {
                    StoreNullable(g, iv, fty, false);
                } else {
                    // a float field carries single precision: the host stores
                    // an f32
                    if (IsFloatTy(fty) && iv != null && iv.ty != null && IsDbl(iv.ty)) {
                        iv = new ExprVal(F32Round(iv.op), iv.ty);
                    }
                    string sv = Coerce(iv, lt);
                    L("  store " + lt + " " + sv + ", " + lt + "* " + g);
                    EmitArcRetainStore(sv, fty, iv.ty);
                }
                EmitTempReleases();
                stmtTemps = savedTemps; stmtTempTypes = savedTempTypes;
            }
            else if (m.kind == AK.FieldDecl() && IsStatic(m)) {
                // a static field without an initializer: the C host gives a
                // struct field a default instance, here a struct instance is
                // a heap object, so the cell needs one of its own
                Node fty = m.type;
                string savedScope = typeScopeCls;
                typeScopeCls = d.sval;
                string lt = MapType(fty);
                typeScopeCls = savedScope;
                if (IsStructTy(fty)) {
                    string g = StaticGlobal(d.sval, m.sval, args);
                    string o = NT();
                    L("  " + o + " = call i8* @" + fty.sval + "_newobj()");
                    string op = NT();
                    L("  " + op + " = bitcast i8* " + o + " to " + lt);
                    L("  store " + lt + " " + op + ", " + lt + "* " + g);
                }
            }
            j = j + 1;
        }
        curInstArgs = sargs; curInstCls = scls;
    }

    // A static field whose initializer is `new T[] { ... }` with an
    // all-constant element list folds into one internal global. The
    // per-element GEP+store expansion of a 1400-entry stdlib table turned
    // main into tens of thousands of lines (G8 round 1) -- the same bytes
    // as a global initializer cost none. The global keeps the runtime
    // bundle layout ([i64 pad][i64 len][elements...], the field slot
    // pointing at the element base, GEP index 2) so reads, writes and
    // runtime type tests see the same shape; it is `global` and not
    // `constant` because the array is mutable at runtime. Only 8-byte
    // integer-ish slots fold: a double element needs its IEEE bits, a
    // byte[] is byte-packed, string/class/nullable elements are pointers
    // or boxed slots -- all stay on the GenNew expansion path.
    bool FoldStaticArrayInit(Node d, Node m, List<Node> args) {
        Node b = m.b;
        if (b == null || b.kind != AK.NewExpr() || b.ival != 1 || b.b != null) { return false; }
        string rkl = b.arrRanks;
        if (rkl == null) { rkl = ""; }
        if (Node.ArrRankCount(rkl) != 1) { return false; }
        Node ty = m.type;
        if (ty == null) { return false; }
        // the same type-node derivation GenNew uses, so the element
        // nullable flag and the rank travel identically
        Node at = MkType(ty.sval); at.ival = 1; at.op = ty.op; at.kids = ty.kids; at.arrRanks = rkl;
        Node et = ArrElemOf(at);
        if (et == null || IsNullableValue(et) || IsStructTy(et) || IsFloatTy(et)) { return false; }
        if (et.sval == "byte" || et.sval == "sbyte") { return false; }
        if (MapType(et) != "i64") { return false; }
        int n = b.kids.Count;
        string vals = "";
        int i = 0;
        while (i < n) {
            Node el = b.kids[i];
            if (!IsConstSlotElem(el)) { return false; }
            if (i > 0) { vals = vals + ", "; }
            vals = vals + "i64 " + ConstSlotElemText(el);
            i = i + 1;
        }
        starrn = starrn + 1;
        string g = "@.starr" + starrn;
        string desc = ArrayDescriptor(at);
        H(g + " = internal global [" + (n + 3) + " x i64] [i64 add (i64 ptrtoint (i64* " + desc + " to i64), i64 1), i64 -1, i64 " + n + (n > 0 ? ", " + vals : "") + "]");
        string p = NT();
        L("  " + p + " = getelementptr inbounds [" + (n + 3) + " x i64], [" + (n + 3) + " x i64]* " + g + ", i64 0, i64 3");
        L("  store i64* " + p + ", i64** " + StaticGlobal(d.sval, m.sval, args));
        return true;
    }

    bool IsConstSlotElem(Node e) {
        if (e == null) { return false; }
        int k = e.kind;
        if (k == AK.BoolLit() || k == AK.CharLit()) { return true; }
        return IsConstInt(e);
    }

    string ConstSlotElemText(Node e) {
        int k = e.kind;
        if (k == AK.BoolLit() || k == AK.CharLit()) { return "" + e.ival; }
        return "" + EvalConstInt(e);
    }

}
