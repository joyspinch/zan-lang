using System;
using System.Collections.Generic;
namespace Zan;

class StaticInitFunction {
    public int start;
    public int end;
    public bool initBody;
    public List<string> refs;
    public List<int> dispatch;
    public List<int> rdispatch;
    public List<int> news;
    public List<int> refls;
    public List<int> edges;

    public StaticInitFunction(int start, int end, bool initBody) {
        this.start = start;
        this.end = end;
        this.initBody = initBody;
        refs = new List<string>();
        dispatch = new List<int>();
        rdispatch = new List<int>();
        news = new List<int>();
        refls = new List<int>();
    }
}

partial class Irgen {
    // ---- static class fields: backed by internal module globals ----
    Node FindStaticField(Node cls, string name) {
        Node c = cls;
        while (c != null) {
            int i = 0;
            while (i < c.kids.Count) {
                Node m = c.kids[i];
                if (m.kind == AK.FieldDecl() && IsStatic(m) && m.sval == name) { return m; }
                i = i + 1;
            }
            c = BaseClassOf(c);
        }
        return null;
    }
    string StaticFieldOwner(Node cls, string name) {
        Node c = cls;
        while (c != null) {
            int i = 0;
            while (i < c.kids.Count) {
                Node m = c.kids[i];
                if (m.kind == AK.FieldDecl() && IsStatic(m) && m.sval == name) { return c.sval; }
                i = i + 1;
            }
            c = BaseClassOf(c);
        }
        return "";
    }
    // ---- generic class instantiations ----
    // The type arguments of a generic-qualified member access (`Stat<int>.s`):
    // the parser keeps them on the access's `d` slot.
    List<Node> InstArgsOf(Node access) {
        if (access == null || access.d == null) { return null; }
        if (access.d.kind != AK.TypeRef() || access.d.sval != "__typeargs") { return null; }
        return access.d.kids;
    }

    // The same, but only when the class is generic and every argument is
    // concrete: an open instantiation (`Stat<T>`) has no own storage.
    List<Node> ConcreteInstArgs(Node access, string clsName) {
        List<Node> a = InstArgsOf(access);
        if (a == null || a.Count == 0) { return null; }
        Node cls = binder.FindType(clsName);
        if (cls == null) { return null; }
        List<string> tps = TParams(cls);
        if (tps.Count == 0 || a.Count != tps.Count) { return null; }
        int i = 0;
        while (i < a.Count) {
            if (a[i] == null || MentionsTypeParam(a[i])) { return null; }
            i = i + 1;
        }
        return a;
    }

    // The suffix that tells one instantiation's storage from another's
    // (`int`, `double`, `string__int`, ...).
    string InstTag(List<Node> args) {
        if (args == null || args.Count == 0) { return ""; }
        string s = "";
        int i = 0;
        while (i < args.Count) {
            if (i > 0) { s = s + "__"; }
            s = s + TypeTag(args[i]);
            i = i + 1;
        }
        return s;
    }

    // The global that holds a static field. A generic class's static field has
    // one global per instantiation (the C host mangles the name with the
    // instantiation suffix); an ordinary class has exactly one.
    string StaticGlobal(string owner, string name, List<Node> args) {
        string g = "@__zan_sf_" + owner;
        string tag = InstTag(args);
        if (tag != "") { g = g + "_" + tag; }
        return g + "_" + name;
    }

    // The type of an instantiation (`Stat<int>`): the class name with the
    // concrete type arguments.
    Node InstType(string clsName, List<Node> args) {
        Node t = new Node(AK.TypeRef());
        t.sval = clsName;
        int i = 0;
        while (i < args.Count) { t.Add(args[i]); i = i + 1; }
        return t;
    }

    // Every instantiation of a generic class the program uses. The C host does
    // the same before emitting (`discover_generic_insts`): a generic class's
    // static storage exists per instantiation, so the backend has to know them
    // all before it emits the globals and the static initializers.
    void DiscoverInsts(Node unit) {
        CollectInsts(unit);
    }

    void CollectInsts(Node n) {
        if (n == null) { return; }
        if (n.kind == AK.TypeRef()) {
            if (n.sval != "__typeargs" && n.kids.Count > 0) { AddInst(n.sval, n.kids); }
        }
        if (n.kind == AK.MemberAccess() && n.a != null && n.a.kind == AK.Ident()) {
            List<Node> a = ConcreteInstArgs(n, n.a.sval);
            if (a != null) { AddInst(n.a.sval, a); }
        }
        CollectInsts(n.a); CollectInsts(n.b); CollectInsts(n.c); CollectInsts(n.d);
        CollectInsts(n.type);
        int i = 0;
        while (i < n.kids.Count) { CollectInsts(n.kids[i]); i = i + 1; }
    }

    void AddInst(string clsName, List<Node> args) {
        Node cls = binder.FindType(clsName);
        if (cls == null) { return; }
        List<string> tps = TParams(cls);
        if (tps.Count == 0 || args.Count != tps.Count) { return; }
        int i = 0;
        while (i < args.Count) {
            if (args[i] == null || MentionsTypeParam(args[i])) { return; }
            i = i + 1;
        }
        string key = clsName + "|" + InstTag(args);
        if (IndexOfStr(instKeys, key) >= 0) { return; }
        instKeys.Add(key);
        instClasses.Add(clsName);
        Node cont = new Node(AK.TypeRef());
        cont.sval = "__typeargs";
        int j = 0;
        while (j < args.Count) { cont.Add(args[j]); j = j + 1; }
        instConts.Add(cont);
    }

    // The instantiation that applies to a static field of `owner` accessed
    // without an explicit qualifier (inside the class): the current
    // instantiation when the owner is the class being specialized.
    List<Node> CurInstFor(string owner) {
        if (curInstCls == "" || curInstCls != owner) { return null; }
        if (curInstArgs == null || curInstArgs.Count == 0) { return null; }
        return curInstArgs;
    }

    void EnsureStaticGlobal(string owner, string name, List<Node> args, string lt) {
        string g = StaticGlobal(owner, name, args);
        if (IndexOfStr(declaredStaticGlobals, g) >= 0) { return; }
        declaredStaticGlobals.Add(g);
        H(g + " = internal global " + lt + " zeroinitializer");
    }

    Node SubstStaticFieldType(string owner, Node fty, List<Node> args) {
        if (fty == null || args == null || args.Count == 0) { return fty; }
        Node ocls = binder.FindType(owner);
        if (ocls == null) { return fty; }
        List<string> tps = TParams(ocls);
        if (tps.Count == 0 || tps.Count != args.Count) { return fty; }
        return SubstTP(fty, tps, args);
    }

    ExprVal LoadStaticField(Node cls, string name, List<Node> args) {
        string owner = StaticFieldOwner(cls, name);
        Node sf = FindStaticField(cls, name);
        if (sf == null) { throw new Exception("unknown static field " + owner + "." + name); }
        Node fty = sf.type;
        Node vty = SubstStaticFieldType(owner, fty, args);
        bool erased = IsErasedTypeDecl(fty, owner);
        // the field's type is written in the OWNING class's scope
        string savedScope = typeScopeCls;
        typeScopeCls = owner;
        // the storage shape does NOT depend on the instantiation: the C host
        // keeps the field's DECLARED type for every variant (`map_type(
        // fsym->type)`) and mangles only the NAME
        string lt = MapType(fty);
        DemandStaticType(owner, args);
        EnsureStaticGlobal(owner, name, args, lt);
        string g = StaticGlobal(owner, name, args);
        string t = NT();
        L("  " + t + " = load " + lt + ", " + lt + "* " + g);
        typeScopeCls = savedScope;
        if (erased) { return FromSlot(t, vty); }
        return new ExprVal(t, vty);
    }
    void StoreStaticField(Node cls, string name, ExprVal v, List<Node> args) {
        string owner = StaticFieldOwner(cls, name);
        Node sf = FindStaticField(cls, name);
        if (sf == null) { throw new Exception("unknown static field " + owner + "." + name); }
        Node fty = sf.type;
        Node vty = SubstStaticFieldType(owner, fty, args);
        bool erased = IsErasedTypeDecl(fty, owner);
        // the field's type is written in the OWNING class's scope
        string savedScope = typeScopeCls;
        typeScopeCls = owner;
        string lt = MapType(fty);
        DemandStaticType(owner, args);
        EnsureStaticGlobal(owner, name, args, lt);
        string g = StaticGlobal(owner, name, args);
        if (erased) {
            typeScopeCls = savedScope;
            string sv = ToSlot(v, vty);
            if (ArcManaged(vty) || (vty != null && vty.ival >= 1)) {
                string old = NT();
                L("  " + old + " = load i64, i64* " + g);
                string newVal = Coerce(v, MapType(vty));
                EmitArcRetain(newVal, vty);
                L("  store i64 " + sv + ", i64* " + g);
                ExprVal oldUnpacked = FromSlot(old, vty);
                EmitArcRelease(oldUnpacked.op, vty);
            } else {
                L("  store i64 " + sv + ", i64* " + g);
            }
            return;
        }
        if (IsNullableValue(fty)) {
            StoreNullable(g, v, fty, true);
            typeScopeCls = savedScope;
            return;
        }
        if (ArcManaged(fty) || (fty != null && fty.ival >= 1)) {
            string old = NT();
            L("  " + old + " = load " + lt + ", " + lt + "* " + g);
            string sv = Coerce(v, lt);
            L("  store " + lt + " " + sv + ", " + lt + "* " + g);
            EmitArcRetain(sv, fty);
            EmitArcRelease(old, fty);
            typeScopeCls = savedScope;
            return;
        }
        string sv = Coerce(v, lt);
        L("  store " + lt + " " + sv + ", " + lt + "* " + g);
        EmitArcRetainStore(sv, fty, v.ty);
        typeScopeCls = savedScope;
    }
    // Emit an internal global for each static field declared in `cls`.
    void EmitStaticGlobals(Node cls) {
        int i = 0;
        while (i < cls.kids.Count) {
            Node m = cls.kids[i];
            if (m.kind == AK.FieldDecl() && IsStatic(m)) {
                // the field's type is written in THIS class's scope
                string savedScope = typeScopeCls;
                typeScopeCls = cls.sval;
                string lt = MapType(m.type);
                typeScopeCls = savedScope;
                string baseG = "@__zan_sf_" + cls.sval + "_" + m.sval;
                if (IndexOfStr(declaredStaticGlobals, baseG) < 0) {
                    declaredStaticGlobals.Add(baseG);
                    H(baseG + " = internal global " + lt + " zeroinitializer");
                }
                // a generic class's static field has ONE global per
                // instantiation: the storage is not shared (`Stat<int>.s`
                // and `Stat<double>.s` are different cells)
                int k = 0;
                while (k < instClasses.Count) {
                    if (instClasses[k] == cls.sval) {
                        List<Node> args = instConts[k].kids;
                        string sc2 = typeScopeCls;
                        typeScopeCls = cls.sval;
                        string lt2 = MapType(m.type);
                        typeScopeCls = sc2;
                        EnsureStaticGlobal(cls.sval, m.sval, args, lt2);
                    }
                    k = k + 1;
                }
            }
            i = i + 1;
        }
    }

    // A demand marker is a compiler-only comment in its actual function. It
    // survives deferred/lambda emission without maintaining a second call
    // resolver. ResolveStaticInits consumes and removes it before returning IR.
    int StaticInitType(string owner, List<Node> args) {
        Node cls = binder.FindType(owner);
        if (cls == null || HasMod(cls, MOD.Iface())) { return -1; }
        if (cls.kind != AK.ClassDecl() && cls.kind != AK.StructDecl()) { return -1; }
        List<string> tps = TParams(cls);
        if (tps.Count > 0) {
            if (args == null || args.Count != tps.Count) { return -1; }
            int ai = 0;
            while (ai < args.Count) {
                if (args[ai] == null || MentionsTypeParam(args[ai])) { return -1; }
                ai = ai + 1;
            }
            AddInst(owner, args);
        } else { args = new List<Node>(); }
        string sym = "__zan_sinit_" + owner;
        string tag = InstTag(args);
        if (tag != "") { sym = sym + "__SPI_" + tag; }
        int at = IndexOfStr(sinitSyms, sym);
        if (at >= 0) { return at; }
        sinitSyms.Add(sym);
        sinitTypes.Add(InstType(owner, args));
        return sinitTypes.Count - 1;
    }

    void DemandStaticType(string owner, List<Node> args) {
        int at = StaticInitType(owner, args);
        if (at >= 0) { L("  ; zan.sinit @" + sinitSyms[at]); }
    }

    bool HasModuleInitializerAttr(Node m) {
        if (m == null) { return false; }
        if (m.attrBlob != null && m.attrBlob != "") {
            if (m.attrBlob.IndexOf("ModuleInitializer=") == 0
                || m.attrBlob.IndexOf(";ModuleInitializer=") >= 0) {
                return true;
            }
        }
        if (m.attributes == null) { return false; }
        int i = 0;
        while (i < m.attributes.Count) {
            Node attr = m.attributes[i];
            if (attr != null && attr.sval != null) {
                int dot = attr.sval.LastIndexOf(".");
                string tail = dot >= 0 ? attr.sval.Substring(dot + 1) : attr.sval;
                if (tail == "ModuleInitializer" || tail == "ModuleInitializerAttribute") {
                    return true;
                }
            }
            i = i + 1;
        }
        return false;
    }

    void NoteStaticExport(Node cls, Node m, string sym) {
        if (HasModuleInitializerAttr(m) && IsStatic(m) && TParams(cls).Count == 0
            && TParams(m).Count == 0 && curInstArgs.Count == 0
            && IndexOfStr(moduleInitSyms, sym) < 0) {
            bool hasParams = false;
            int pi = 0;
            while (pi < m.kids.Count) {
                if (m.kids[pi].kind == AK.Param()) { hasParams = true; break; }
                pi = pi + 1;
            }
            if (!hasParams && (m.type == null || m.type.sval == "void")) {
                moduleInitSyms.Add(sym);
            }
        }
        if (!libOut || HasMod(m, MOD.Private()) || TParams(cls).Count != 0
            || TParams(m).Count != 0 || IndexOfStr(sinitExportRoots, sym) >= 0) { return; }
        if (nativeLibraryDependencyLine > 0 && (m.line >= nativeLibraryDependencyLine
            || (!HasMod(m, MOD.Public()) && m.kind != AK.CtorDecl()))) { return; }
        sinitExportRoots.Add(sym);
        if (!IsStatic(m)) { DemandNewType(MkType(cls.sval)); }
        for (int i = 0; i < m.kids.Count; i++) {
            if (m.kids[i].kind == AK.Param()) { DemandExternalType(m.kids[i].type); }
        }
    }

    void DemandNewType(Node ty) {
        if (ty == null || ty.ival != 0) { return; }
        int at = StaticInitType(ty.sval, ty.kids);
        if (at >= 0) { L("  ; zan.new @" + sinitSyms[at]); }
    }

    void DemandReflectType(Node ty) {
        if (ty == null || ty.ival != 0) { return; }
        int at = StaticInitType(ty.sval, ty.kids);
        if (at >= 0) { L("  ; zan.refl @" + sinitSyms[at]); }
    }

    int StaticReflectRecord(Node ty, string target) {
        int at = sinitReflectTypes.Count;
        sinitReflectTypes.Add(ty);
        sinitReflectTargets.Add(target);
        return at;
    }

    string StaticReflectMarker(Node ty, string target) {
        return " ; zan.rdispatch " + StaticReflectRecord(ty, target);
    }

    void DemandExternalType(Node ty) {
        if (ty == null || ty.ival != 0 || IsErasedType(ty)) { return; }
        Node declared = binder.FindType(ty.sval);
        if (declared == null && ty.sval != "object") { return; }
        int i = 0;
        while (i < sinitTypes.Count) {
            Node candidate = binder.FindType(sinitTypes[i].sval);
            if (candidate != null && !HasMod(candidate, MOD.Abstract())
            && (ty.sval == "object" || binder.IsAssignableFrom(ty.sval, candidate.sval))) {
                L("  ; zan.new @" + sinitSyms[i]);
            }
            i = i + 1;
        }
    }

    string StaticDispatchMarker(Node cls, Node method, string target, Node instance = null) {
        int at = sinitDispatchTypes.Count;
        sinitDispatchTypes.Add(instance == null ? MkType(cls.sval) : instance);
        sinitDispatchMethods.Add(method);
        sinitDispatchTargets.Add(target);
        return " ; zan.dispatch " + at;
    }

    // Record each actual vtable slot target, including ABI adapters and
    // specialized bodies. The table itself is metadata, never a startup root.
    void NoteStaticVtable(string table, int slot, string target) {
        sinitDispatchTables.Add(table);
        sinitDispatchSlots.Add(slot);
        sinitVtableTargets.Add(target);
    }

    void SeedStaticInitTypes(Node unit) {
        EmitEmbedResources();
        int i = 0;
        while (i < unit.kids.Count) {
            Node cls = unit.kids[i];
            if (cls.kind == AK.ClassDecl() || cls.kind == AK.StructDecl()) {
                if (TParams(cls).Count == 0) { StaticInitType(cls.sval, null); }
            }
            i = i + 1;
        }
        i = 0;
        while (i < instClasses.Count) {
            StaticInitType(instClasses[i], instConts[i].kids);
            i = i + 1;
        }
    }

    void GenStaticInit(Node instTy, string sym) {
        Node cls = binder.FindType(instTy.sval);
        if (cls == null) { return; }
        Node d = cls;
        List<string> tps = TParams(cls);
        if (tps.Count > 0) {
            d = CloneSubst(cls, tps, instTy.kids);
            int fi = 0;
            while (fi < cls.kids.Count) {
                if (cls.kids[fi].kind == AK.FieldDecl()) {
                    // Only the initializer is specialized. Static storage
                    // keeps the declaration-form ABI used by field accesses.
                    d.kids[fi].type = cls.kids[fi].type;
                }
                fi = fi + 1;
            }
        }
        Node savedThis = curThisTy;
        List<Node> savedArgs = curInstArgs;
        string savedCls = curInstCls;
        curThisTy = instTy; curInstArgs = instTy.kids; curInstCls = cls.sval;
        // Discoveries made by a specialized body can arrive after the first
        // global-emission pass. Declare storage before generating its writes.
        int j = 0;
        while (j < cls.kids.Count) {
            Node f = cls.kids[j];
            if (f.kind == AK.FieldDecl() && IsStatic(f)) {
                string scope = typeScopeCls;
                typeScopeCls = cls.sval;
                EnsureStaticGlobal(cls.sval, f.sval, instTy.kids, MapType(f.type));
                typeScopeCls = scope;
            }
            j = j + 1;
        }
        StartFn();
        curClass = cls.sval; curHasThis = false; curRet = "void"; curRetTy = MkType("void");
        L("define internal void @" + sym + "() {");
        L("entry:");
        StringBuilder obody = body; StringBuilder oea = entryAllocas; bool oact = eaActive;
        body = new StringBuilder(); entryAllocas = new StringBuilder(); eaActive = true;
        EmitStaticFieldInits(d, instTy.kids);
        j = 0;
        while (j < d.kids.Count) {
            Node cm = d.kids[j];
            if (cm.kind == AK.CtorDecl() && IsStatic(cm)) {
                L("  call void @" + sym + "_cctor()");
            }
            j = j + 1;
        }
        EmitTempReleases();
        if (!term) { ReleaseLocalsFrom(0); L("  ret void"); }
        L("}");
        obody.Append(entryAllocas.ToString()); obody.Append(body.ToString());
        body = obody; entryAllocas = oea; eaActive = oact;
        j = 0;
        while (j < d.kids.Count) {
            Node cm = d.kids[j];
            if (cm.kind == AK.CtorDecl() && IsStatic(cm)) {
                GenStaticCtorAs(d, cm, sym + "_cctor");
            }
            j = j + 1;
        }
        if (checkLeaks && !libOut) { GenStaticCleanup(cls, instTy, sym); }
        curThisTy = savedThis; curInstArgs = savedArgs; curInstCls = savedCls;
    }

    void GenStaticCleanup(Node cls, Node inst, string initSym) {
        StartFn();
        string scope = typeScopeCls;
        typeScopeCls = cls.sval;
        L("define internal void @" + StaticCleanupSymbol(initSym) + "() {");
        L("entry:");
        int i = cls.kids.Count - 1;
        while (i >= 0) {
            Node field = cls.kids[i];
            if (field.kind == AK.FieldDecl() && IsStatic(field)
                && (ArcManaged(field.type) || field.type.ival >= 1)) {
                string ty = MapType(field.type);
                string global = StaticGlobal(cls.sval, field.sval, inst.kids);
                string value = NT();
                L("  " + value + " = load " + ty + ", " + ty + "* " + global);
                L("  store " + ty + " null, " + ty + "* " + global);
                EmitArcRelease(value, field.type);
            }
            i = i - 1;
        }
        L("  ret void");
        L("}");
        typeScopeCls = scope;
    }

    string StaticCleanupSymbol(string initSym) { return "zarc_drop_" + initSym; }

    void EmitStaticInits(Node unit) {
        L("  call void @__zan_static_init()");
    }

    // Build the execution graph from emitted functions only. Unlike code
    // retention, globals (type metadata, vtables, descriptors) are not roots.
    // A function pointer produced by live code remains an executable edge.
    string ResolveStaticInits(string modText) {
        List<StaticInitFunction> functions = new List<StaticInitFunction>();
        Dictionary<string, int> defs = new Dictionary<string, int>();
        Dictionary<string, int> typeIds = new Dictionary<string, int>();
        int i = 0;
        while (i < sinitSyms.Count) { typeIds[sinitSyms[i]] = i; i = i + 1; }
        int pos = 0;
        StaticInitFunction current = null;
        while (pos < modText.Length) {
            int nl = modText.IndexOf("\n", pos);
            if (nl < 0) { nl = modText.Length; }
            string line = modText.Substring(pos, nl - pos);
            if (line.StartsWith("define ")) {
                string sym = HeadSymbol(line);
                defs[sym] = functions.Count;
                current = new StaticInitFunction(pos, modText.Length, sym.StartsWith("__zan_sinit_"));
                functions.Add(current);
            } else if (current != null && line == "}") {
                current.end = nl;
                current = null;
            } else if (current != null) {
                int dm = line.IndexOf(" ; zan.dispatch ");
                if (dm >= 0) {
                    current.dispatch.Add(int.Parse(line.Substring(dm + 16)));
                } else {
                    int rm = line.IndexOf(" ; zan.rdispatch ");
                    if (rm >= 0) {
                        current.rdispatch.Add(int.Parse(line.Substring(rm + 17)));
                    } else if (line.StartsWith("  ; zan.rdispatch ")) {
                        current.rdispatch.Add(int.Parse(line.Substring(18)));
                    } else if (line.StartsWith("  ; zan.refl @")) {
                        string sym = HeadSymbol(line);
                        if (typeIds.ContainsKey(sym)) { current.refls.Add(typeIds[sym]); }
                    } else {
                        CollectHeadRefs(line, current.refs);
                        if (line.StartsWith("  ; zan.new @")) {
                            string sym = HeadSymbol(line);
                            if (typeIds.ContainsKey(sym)) { current.news.Add(typeIds[sym]); }
                        }
                    }
                }
            }
            pos = nl + 1;
        }
        int[] live = new int[functions.Count];
        List<int> queue = new List<int>();
        if (defs.ContainsKey("main")) { StaticEnqueue(defs["main"], live, queue, 1); }
        i = 0;
        while (i < sinitExportRoots.Count) {
            string sym = sinitExportRoots[i];
            if (defs.ContainsKey(sym)) { StaticEnqueue(defs[sym], live, queue, 1); }
            i = i + 1;
        }
        i = 0;
        while (i < moduleInitSyms.Count) {
            string sym = moduleInitSyms[i];
            if (defs.ContainsKey(sym)) { StaticEnqueue(defs[sym], live, queue, 1); }
            i = i + 1;
        }
        StaticReach(functions, defs, live, queue);

        // The global fixed point has resolved every dispatch edge that any
        // live initializer can take. Every type allocated along such a path
        // is already in the global allocation set.
        int[] initDefs = new int[sinitSyms.Count];
        List<int> liveInits = new List<int>();
        i = 0;
        while (i < sinitSyms.Count) {
            string sym = sinitSyms[i];
            if (defs.ContainsKey(sym)) {
                int fi = defs[sym];
                if (live[fi] != 0) { initDefs[i] = fi; liveInits.Add(i); }
            }
            i = i + 1;
        }
        int[] seen = new int[functions.Count];
        int[] colors = new int[sinitSyms.Count];
        List<int> order = new List<int>();
        i = 0;
        while (i < liveInits.Count) {
            StaticInitVisit(liveInits[i], functions, initDefs, liveInits, colors, order, seen, queue);
            i = i + 1;
        }
        StringBuilder result = new StringBuilder();
        // Do not leave demand markers in the final text: the existing prune
        // pass must not mistake startup demand for runtime call references.
        pos = 0;
        int di = 0;
        int nextDef = functions.Count > 0 ? functions[0].start : modText.Length;
        while (pos < modText.Length) {
            if (pos == nextDef) {
                StaticInitFunction fn = functions[di];
                bool drop = fn.initBody && live[di] == 0;
                di = di + 1;
                nextDef = di < functions.Count ? functions[di].start : modText.Length;
                if (drop) { pos = fn.end + 1; continue; }
            }
            int nl = modText.IndexOf("\n", pos);
            if (nl < 0) { nl = modText.Length; }
            string line = modText.Substring(pos, nl - pos);
            if (!line.StartsWith("  ; zan.sinit @") && !line.StartsWith("  ; zan.new @")
            && !line.StartsWith("  ; zan.refl @") && !line.StartsWith("  ; zan.rdispatch ")) {
                int dm = line.IndexOf(" ; zan.dispatch ");
                if (dm >= 0) { line = line.Substring(0, dm); }
                int rm = line.IndexOf(" ; zan.rdispatch ");
                if (rm >= 0) { line = line.Substring(0, rm); }
                result.Append(line); result.Append("\n");
            }
            pos = nl + 1;
        }
        result.Append("define internal void @__zan_static_init() {\nentry:\n");
        AppendEmbedRegistration(result);
        i = 0;
        while (i < order.Count) {
            result.Append("  call void @" + sinitSyms[order[i]] + "()\n");
            i = i + 1;
        }
        i = 0;
        while (i < moduleInitSyms.Count) {
            if (defs.ContainsKey(moduleInitSyms[i])) {
                result.Append("  call void @" + moduleInitSyms[i] + "()\n");
            }
            i = i + 1;
        }
        result.Append("  ret void\n}\n");
        if (checkLeaks && !libOut) {
            result.Append("define internal void @zarc_drop_statics() {\nentry:\n");
            i = order.Count - 1;
            while (i >= 0) {
                result.Append("  call void @" + StaticCleanupSymbol(sinitSyms[order[i]]) + "()\n");
                i = i - 1;
            }
            result.Append("  ret void\n}\n");
        }
        if (libOut) {
            result.Append("@llvm.global_ctors = appending global [1 x { i32, void ()*, i8* }] [{ i32, void ()*, i8* } { i32 65535, void ()* @__zan_static_init, i8* null }]\n");
        }
        return result.ToString();
    }

    void StaticReach(List<StaticInitFunction> functions, Dictionary<string, int> defs,
    int[] live, List<int> queue) {
        // Preserve the first match in both metadata lists, even if the
        // chosen table has no entry or the slot target has no definition.
        Dictionary<string, string> specializedTables = new Dictionary<string, string>();
        int i = 0;
        while (i < specVtSyms.Count) {
            string key = specVtCls[i].sval + "|" + InstTag(specVtArgs[i].kids);
            if (!specializedTables.ContainsKey(key)) { specializedTables[key] = specVtSyms[i]; }
            i = i + 1;
        }
        Dictionary<string, int> slots = new Dictionary<string, int>();
        i = 0;
        while (i < sinitDispatchTables.Count) {
            string key = sinitDispatchTables[i] + "|" + sinitDispatchSlots[i];
            string sym = sinitVtableTargets[i];
            if (!slots.ContainsKey(key)) { slots[key] = defs.ContainsKey(sym) ? defs[sym] : -1; }
            i = i + 1;
        }

        int[] made = new int[sinitTypes.Count];
        int[] refl = new int[sinitTypes.Count];
        Node[] classes = new Node[sinitTypes.Count];
        string[] tables = new string[sinitTypes.Count];
        List<int> madeTypes = new List<int>();
        List<int> reflTypes = new List<int>();
        List<int> callers = new List<int>();
        List<int> rcallers = new List<int>();
        Dictionary<string, int> typeIdsByName = new Dictionary<string, int>();
        i = 0;
        while (i < sinitTypes.Count) {
            if (sinitTypes[i].kids.Count == 0 && !typeIdsByName.ContainsKey(sinitTypes[i].sval)) {
                typeIdsByName[sinitTypes[i].sval] = i;
            }
            i = i + 1;
        }
        int[] edgeMarks = new int[functions.Count];
        int matchedTypes = 0;
        int matchedRefl = 0;
        int qi = 0;
        while (qi < queue.Count || matchedTypes < madeTypes.Count || matchedRefl < reflTypes.Count) {
            int priorCallers = callers.Count;
            int priorRCallers = rcallers.Count;
            while (qi < queue.Count) {
                int fi = queue[qi]; qi = qi + 1;
                StaticInitFunction fn = functions[fi];
                fn.edges = new List<int>();
                int ri = 0;
                while (ri < fn.refs.Count) {
                    string sym = fn.refs[ri];
                    if (defs.ContainsKey(sym)) {
                        StaticReachEdge(defs[sym], fi, fn.edges, edgeMarks, live, queue);
                    }
                    ri = ri + 1;
                }
                fn.refs = null;
                ri = 0;
                while (ri < fn.news.Count) {
                    int ti = fn.news[ri];
                    if (made[ti] == 0) {
                        made[ti] = 1;
                        madeTypes.Add(ti);
                        Node instTy = sinitTypes[ti];
                        Node cls = binder.FindType(instTy.sval);
                        classes[ti] = cls;
                        if (cls != null) {
                            string key = cls.sval + "|" + InstTag(instTy.kids);
                            tables[ti] = specializedTables.ContainsKey(key) ? specializedTables[key] : cls.sval + "_vtable";
                        }
                    }
                    StaticMarkRefl(ti, refl, reflTypes, typeIdsByName);
                    ri = ri + 1;
                }
                fn.news = null;
                ri = 0;
                while (ri < fn.refls.Count) {
                    StaticMarkRefl(fn.refls[ri], refl, reflTypes, typeIdsByName);
                    ri = ri + 1;
                }
                fn.refls = null;
                if (fn.dispatch.Count > 0) { callers.Add(fi); }
                if (fn.rdispatch.Count > 0) { rcallers.Add(fi); }
            }

            // Reflective CreateInstance only activates types whose TypeInfo is
            // reachable in the live graph.
            i = matchedRefl == reflTypes.Count ? priorRCallers : 0;
            while (i < rcallers.Count) {
                int fi = rcallers[i];
                StaticInitFunction fn = functions[fi];
                int firstRefl = i < priorRCallers ? matchedRefl : 0;
                int ri = 0;
                while (ri < fn.edges.Count) { edgeMarks[fn.edges[ri]] = fi + 1; ri = ri + 1; }
                int dj = 0;
                while (dj < fn.rdispatch.Count) {
                    int rd = fn.rdispatch[dj]; dj = dj + 1;
                    Node rty = sinitReflectTypes[rd];
                    string rtarget = sinitReflectTargets[rd];
                    int rdef = (rtarget != "" && defs.ContainsKey(rtarget)) ? defs[rtarget] : -1;
                    int mi = firstRefl;
                    while (mi < reflTypes.Count) {
                        int ti = reflTypes[mi]; mi = mi + 1;
                        if (!binder.SameType(rty, sinitTypes[ti])) { continue; }
                        if (defs.ContainsKey(sinitSyms[ti])) {
                            StaticReachEdge(defs[sinitSyms[ti]], fi, fn.edges, edgeMarks, live, queue);
                        }
                        if (rdef >= 0) {
                            StaticReachEdge(rdef, fi, fn.edges, edgeMarks, live, queue);
                        }
                        if (made[ti] == 0) {
                            made[ti] = 1;
                            madeTypes.Add(ti);
                            Node instTy = sinitTypes[ti];
                            Node cls = binder.FindType(instTy.sval);
                            classes[ti] = cls;
                            if (cls != null) {
                                string key = cls.sval + "|" + InstTag(instTy.kids);
                                tables[ti] = specializedTables.ContainsKey(key) ? specializedTables[key] : cls.sval + "_vtable";
                            }
                        }
                    }
                }
                i = i + 1;
            }
            matchedRefl = reflTypes.Count;

            // Each live dispatch sees each allocated type once. Old callers
            // only need the new types. New callers start with all made types.
            i = matchedTypes == madeTypes.Count ? priorCallers : 0;
            while (i < callers.Count) {
                int fi = callers[i];
                StaticInitFunction fn = functions[fi];
                int firstType = i < priorCallers ? matchedTypes : 0;
                // Reuse one set of marks to keep unique targets per caller.
                int ri = 0;
                while (ri < fn.edges.Count) { edgeMarks[fn.edges[ri]] = fi + 1; ri = ri + 1; }
                int dj = 0;
                while (dj < fn.dispatch.Count) {
                    int dc = fn.dispatch[dj]; dj = dj + 1;
                    Node recvTy = sinitDispatchTypes[dc];
                    string directTarget = sinitDispatchTargets[dc];
                    int directDef = -1;
                    if (directTarget != "") {
                        if (!defs.ContainsKey(directTarget)) { continue; }
                        directDef = defs[directTarget];
                    }
                    int mi = firstType;
                    while (mi < madeTypes.Count) {
                        int ti = madeTypes[mi]; mi = mi + 1;
                        Node cls = classes[ti];
                        if (cls == null) { continue; }
                        Node instTy = sinitTypes[ti];
                        int target = -1;
                        if (directDef >= 0) {
                            if (binder.SameType(recvTy, instTy)) { target = directDef; }
                        } else if (binder.IsAssignableFrom(recvTy.sval, instTy.sval)) {
                            target = StaticVtableTarget(cls, sinitDispatchMethods[dc], tables[ti], slots);
                        }
                        if (target >= 0) { StaticReachEdge(target, fi, fn.edges, edgeMarks, live, queue); }
                    }
                }
                i = i + 1;
            }
            matchedTypes = madeTypes.Count;
        }
    }

    void StaticMarkRefl(int ti, int[] refl, List<int> reflTypes, Dictionary<string, int> typeIdsByName) {
        if (refl[ti] != 0) { return; }
        refl[ti] = 1;
        reflTypes.Add(ti);
        Node cls = binder.FindType(sinitTypes[ti].sval);
        if (cls == null) { return; }
        int fi = 0;
        while (fi < cls.kids.Count) {
            Node f = cls.kids[fi];
            if (f.kind == AK.FieldDecl() && f.type != null && f.type.ival == 0
            && typeIdsByName.ContainsKey(f.type.sval)) {
                int fti = typeIdsByName[f.type.sval];
                if (refl[fti] == 0) { StaticMarkRefl(fti, refl, reflTypes, typeIdsByName); }
            }
            fi = fi + 1;
        }
    }

    void StaticReachEdge(int target, int caller, List<int> edges, int[] edgeMarks,
    int[] live, List<int> queue) {
        int stamp = caller + 1;
        if (edgeMarks[target] == stamp) { return; }
        edgeMarks[target] = stamp;
        edges.Add(target);
        StaticEnqueue(target, live, queue, 1);
    }

    void StaticEnqueue(int at, int[] seen, List<int> queue, int stamp) {
        if (seen[at] != stamp) { seen[at] = stamp; queue.Add(at); }
    }

    int StaticVtableTarget(Node cls, Node method, string table, Dictionary<string, int> slots) {
        int slot = VSlotIndexM(cls, method);
        if (slot < 0) { return -1; }
        string key = table + "|" + slot;
        return slots.ContainsKey(key) ? slots[key] : -1;
    }

    void StaticInitVisit(int at, List<StaticInitFunction> functions, int[] initDefs,
    List<int> liveInits, int[] colors, List<int> order, int[] seen, List<int> queue) {
        if (colors[at] != 0) { return; }
        colors[at] = 1;
        int root = initDefs[at];
        if (functions[root].edges.Count > 0) {
            int stamp = at + 1;
            queue.Clear();
            StaticEnqueue(root, seen, queue, stamp);
            int qi = 0;
            while (qi < queue.Count) {
                List<int> edges = functions[queue[qi]].edges;
                qi = qi + 1;
                int ei = 0;
                while (ei < edges.Count) {
                    StaticEnqueue(edges[ei], seen, queue, stamp);
                    ei = ei + 1;
                }
            }
            // Capture dependencies before recursive visits reuse the marks.
            // Enumerating by initializer index preserves the original order.
            List<int> deps = new List<int>();
            int i = 0;
            while (i < liveInits.Count) {
                int dep = liveInits[i];
                if (colors[dep] == 0 && seen[initDefs[dep]] == stamp) { deps.Add(dep); }
                i = i + 1;
            }
            i = 0;
            while (i < deps.Count) {
                StaticInitVisit(deps[i], functions, initDefs, liveInits, colors, order, seen, queue);
                i = i + 1;
            }
        }
        colors[at] = 2; order.Add(at);
    }

    // The static field initializers of a class: for the erased storage, or for
    // one instantiation's own cells.
    void EmitStaticFieldInits(Node d, List<Node> args) {
        List<Node> sargs = curInstArgs; string scls = curInstCls;
        curInstArgs = args; curInstCls = d.sval;
        int j = 0;
        while (j < d.kids.Count) {
            Node m = d.kids[j];
            if (m.kind == AK.FieldDecl() && IsStatic(m) && m.b != null) {
                if (FoldStaticArrayInit(d, m, args)) { j = j + 1; continue; }
                List<string> savedTemps = stmtTemps;
                List<Node> savedTempTypes = stmtTempTypes;
                stmtTemps = new List<string>(); stmtTempTypes = new List<Node>();
                ExprVal iv = GenExpr(m.b);
                Node fty = m.type;
                string savedScope = typeScopeCls;
                typeScopeCls = d.sval;
                string lt = MapType(fty);
                typeScopeCls = savedScope;
                string g = StaticGlobal(d.sval, m.sval, args);
                if (IsNullableValue(fty)) {
                    StoreNullable(g, iv, fty, false);
                } else {
                    // a float field carries single precision: the host stores
                    // an f32
                    if (IsFloatTy(fty) && iv != null && iv.ty != null && IsDbl(iv.ty)) {
                        iv = new ExprVal(F32Round(iv.op), iv.ty);
                    }
                    string sv = Coerce(iv, lt);
                    L("  store " + lt + " " + sv + ", " + lt + "* " + g);
                    EmitArcRetainStore(sv, fty, iv.ty);
                }
                EmitTempReleases();
                stmtTemps = savedTemps; stmtTempTypes = savedTempTypes;
            }
            else if (m.kind == AK.FieldDecl() && IsStatic(m)) {
                // a static field without an initializer: the C host gives a
                // struct field a default instance, here a struct instance is
                // a heap object, so the cell needs one of its own
                Node fty = m.type;
                string savedScope = typeScopeCls;
                typeScopeCls = d.sval;
                string lt = MapType(fty);
                typeScopeCls = savedScope;
                if (IsStructTy(fty)) {
                    string g = StaticGlobal(d.sval, m.sval, args);
                    string o = NT();
                    L("  " + o + " = call i8* @" + fty.sval + "_newobj()");
                    string op = NT();
                    L("  " + op + " = bitcast i8* " + o + " to " + lt);
                    L("  store " + lt + " " + op + ", " + lt + "* " + g);
                }
            }
            j = j + 1;
        }
        curInstArgs = sargs; curInstCls = scls;
    }

    // Fold integral array initializers into a mutable global with the
    // runtime descriptor, immortal reference count, length and typed data.
    bool FoldStaticArrayInit(Node d, Node m, List<Node> args) {
        Node b = m.b;
        if (b == null || b.kind != AK.NewExpr() || b.ival != 1 || b.b != null) { return false; }
        string rkl = b.arrRanks;
        if (rkl == null) { rkl = ""; }
        if (Node.ArrRankCount(rkl) != 1) { return false; }
        Node ty = m.type;
        if (ty == null) { return false; }
        // the same type-node derivation GenNew uses, so the element
        // nullable flag and the rank travel identically
        Node at = MkType(ty.sval); at.ival = 1; at.op = ty.op; at.elemNullable = ty.elemNullable; at.kids = ty.kids; at.arrRanks = rkl;
        Node et = ArrElemOf(at);
        if (et == null || IsNullableValue(et) || IsStructTy(et) || IsFloatTy(et)) { return false; }
        if (MapType(et) != "i64" || IsErasedType(et)) { return false; }
        string storage = ArrayStorage(et);
        int n = b.kids.Count;
        StringBuilder values = new StringBuilder();
        int i = 0;
        while (i < n) {
            Node el = b.kids[i];
            if (!IsConstSlotElem(el)) { return false; }
            if (i > 0) { values.Append(", "); }
            string literal = ConstSlotElemText(el);
            if (storage != "i64") { literal = "trunc (i64 " + literal + " to " + storage + ")"; }
            values.Append(storage + " " + literal);
            i = i + 1;
        }
        starrn = starrn + 1;
        string g = "@.starr" + starrn;
        string desc = ArrayDescriptor(at);
        string data = "[" + n + " x " + storage + "]";
        string array = "{ [4 x i64], " + data + " }";
        H(g + " = internal global " + array + " { [4 x i64] [i64 25404552263127619, i64 add (i64 ptrtoint (i64* "
            + desc + " to i64), i64 1), i64 -1, i64 " + n + "], " + data + " [" + values.ToString() + "] }");
        string place = NT();
        L("  " + place + " = getelementptr inbounds " + array + ", " + array + "* " + g + ", i32 0, i32 1, i64 0");
        string p = place;
        if (storage != "i64") {
            p = NT();
            L("  " + p + " = bitcast " + storage + "* " + place + " to i64*");
        }
        L("  store i64* " + p + ", i64** " + StaticGlobal(d.sval, m.sval, args));
        return true;
    }

    bool IsConstSlotElem(Node e) {
        if (e == null) { return false; }
        int k = e.kind;
        if (k == AK.BoolLit() || k == AK.CharLit()) { return true; }
        return IsConstInt(e);
    }

    string ConstSlotElemText(Node e) {
        int k = e.kind;
        if (k == AK.BoolLit() || k == AK.CharLit()) { return "" + e.ival; }
        return "" + EvalConstInt(e);
    }

}
