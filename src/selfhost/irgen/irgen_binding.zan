using System;
namespace Zan;

// Binding<T> assignment sugar for the IR backend (mirrors the C host's
// emit_binding_value): assigning a non-Binding expression to a
// Binding<T>-typed slot wraps it in a fresh Binding object instead of
// storing a raw T where the slot's readers expect {target, getter, setter,
// live, constVal, version}. A writable instance field or property on a
// borrowed receiver builds a live binding. Other expressions build a
// snapshot. `b = null` clears the binding and an existing binding is shared.
//
// The accessors use the delegate invoke ABI: the env pointer first, then
// the target and (for a setter) the value.
partial class Irgen {
    List<string> bindAccKeys;
    List<string> bindAccFns;

    void InitBinding() {
        if (bindAccKeys != null) { return; }
        bindAccKeys = new List<string>();
        bindAccFns = new List<string>();
    }

    // Is this a Binding<T> instantiation?
    bool IsBindingTy(Node t) {
        if (t == null) { return false; }
        if (t.sval != "Binding" && t.sval != "System.Binding") { return false; }
        return t.kids.Count == 1;
    }

    // Binding.target: a non-owning slot (never retained or released)
    bool BindingTargetField(Node cls, string field) {
        return cls != null && (cls.sval == "Binding" || cls.sval == "System.Binding") && field == "target";
    }

    // The element type T of a Binding<T>.
    Node BindingElemTy(Node t) {
        if (t == null || t.kids.Count == 0) { return null; }
        return t.kids[0];
    }

    // The Binding class declaration (null when the program has no Binding).
    Node BindingClass() {
        Node cls = binder.FindType("Binding");
        if (cls == null || cls.nsName != "System") { cls = binder.FindType("System_Binding"); }
        return cls != null && cls.nsName == "System" ? cls : null;
    }

    bool IsBorrowedBindingField(Node owner, string name) {
        return name == "target" && owner != null && owner == BindingClass();
    }

    int BorrowedBindingFieldSlot(Node cls) {
        Node binding = BindingClass();
        if (binding == null) { return -1; }
        for (Node owner = cls; owner != null; owner = BaseClassOf(owner)) {
            if (owner == binding) { return FieldPos(binding, "target"); }
        }
        return -1;
    }

    void CheckBorrowedBindingValue(Node owner, string name, Node value) {
        if (IsBorrowedBindingField(owner, name) && YieldsOwnedTemp(value)) {
            diags.Error("[E3105] Binding.target is non-owning and cannot reference an owned "
                + "temporary; keep the target in an owning local or field", value.line, value.col);
        }
    }

    // The LLVM type of a Binding field: the erased type parameter travels in
    // an i64 slot, everything else in its own type.
    string BindingFieldLt(Node bcls, string name) {
        Node t = FieldType(bcls, name);
        if (t == null) { return "i64"; }
        List<string> tps = TParams(bcls);
        int i = 0;
        while (i < tps.Count) { if (tps[i] == t.sval) { return "i64"; } i = i + 1; }
        return MapType(t);
    }

    // The static type of an assignment target: a local, a field of the
    // enclosing class or a field of the receiver's class.
    Node SlotTypeOf(Node lhs) {
        if (lhs == null) { return null; }
        if (lhs.kind == AK.Ident()) {
            int li = LocalIdx(lhs.sval);
            if (li >= 0) { return locType[li]; }
            if (curClass != "") {
                Node cls = binder.FindType(curClass);
                if (cls != null) { return FieldType(cls, lhs.sval); }
            }
            return null;
        }
        if (lhs.kind == AK.MemberAccess()) {
            Node cls = ClassOf(ArgTypeNode(lhs.a));
            if (cls != null) { return FieldType(cls, lhs.sval); }
            return null;
        }
        return null;
    }

    // Does this expression materialize an object that dies at statement end?
    // A live binding's target is a NON-OWNING reference (cycle avoidance),
    // so a receiver that yields an owned temp would dangle once the
    // statement ends -- such a binding degrades to a const snapshot (the C
    // host's owned-receiver check).
    bool YieldsOwnedTemp(Node e) {
        if (e == null) { return false; }
        int k = e.kind;
        if (k == AK.Call() || k == AK.NewExpr() || k == AK.WithExpr()
                || k == AK.AwaitExpr() || k == AK.CallInit()) { return true; }
        if (k == AK.Conditional()) {
            return YieldsOwnedTemp(e.b) || YieldsOwnedTemp(e.c);
        }
        if (k == AK.Index()) {
            if (YieldsOwnedTemp(e.a)) { return true; }
            Node oc = ClassOf(ArgTypeNode(e.a));
            if (oc != null && FindMethodUp(oc, "op_index") != null) { return true; }
            return false;
        }
        if (k == AK.CastExpr()) { return YieldsOwnedTemp(e.b); }
        if (k == AK.MemberAccess() && e.a != null) {
            if (e.ival == 1 || YieldsOwnedTemp(e.a)) { return true; }
            Node ot = e.a.kind == AK.BaseExpr() ? binder.BaseType(CurThisTy()) : ArgTypeNode(e.a);
            return BindingReadsProperty(ClassOf(ot), e.sval);
        }
        if (k == AK.Ident() && LocalIdx(e.sval) < 0) {
            return BindingReadsProperty(binder.FindType(curClass), e.sval);
        }
        return false;
    }

    bool BindingReadsProperty(Node cls, string name) {
        return FieldIndex(cls, name) < 0 && FindMethodUp(cls, "get_" + name) != null;
    }

    // Build the Binding object for `rhs` when the slot's type is
    // Binding<T>. Null when the plain store applies (a null literal clears
    // the slot, a Binding-typed right-hand side is shared as it is).
    ExprVal GenBindingValue(Node rhs, Node slotTy) {
        if (rhs == null || !IsBindingTy(slotTy) || rhs.kind == AK.NullLit()) { return null; }
        if (IsBindingTy(ArgTypeNode(rhs))) { return null; }
        Node bcls = BindingClass();
        if (bcls == null) { return null; }
        Node src = rhs;
        if (rhs.kind == AK.Ident() && LocalIdx(rhs.sval) < 0 && curHasThis) {
            Node own = binder.FindType(curClass);
            Node getter = FindMethodUp(own, "get_" + rhs.sval);
            if (FieldIndex(own, rhs.sval) >= 0 || (getter != null && !IsStatic(getter))) {
                src = new Node(AK.MemberAccess());
                src.a = new Node(AK.ThisExpr());
                src.sval = rhs.sval;
                src.line = rhs.line; src.col = rhs.col;
            }
        }
        Node elem = BindingElemTy(slotTy);
        if (src.kind == AK.MemberAccess() && src.a != null && src.ival == 0) {
            bool direct = src.a.kind == AK.BaseExpr();
            Node recvTy = direct ? binder.BaseType(CurThisTy()) : ArgTypeNode(src.a);
            Node cls = ClassOf(recvTy);
            if (cls != null && IsPtrLL(MapType(recvTy)) && !YieldsOwnedTemp(src.a)) {
                Node fieldOwner = BindingFieldOwner(cls, src.sval);
                Node valueTy = null;
                if (fieldOwner != null) {
                    Node field = binder.FindField(fieldOwner, src.sval);
                    if (!HasMod(field, MOD.Readonly()) && !field.autoNoSet && !IsBorrowedBindingField(fieldOwner, src.sval)) {
                        valueTy = binder.MemberType(recvTy, src.sval);
                    }
                } else {
                    Node getter = FindMethodUp(cls, "get_" + src.sval);
                    Node setter = FindMethodUp(cls, "set_" + src.sval);
                    if (getter != null && setter != null && !IsStatic(getter) && !IsStatic(setter)
                    && !HasMod(setter, MOD.Readonly())
                    && MethodParamCount(getter) == 0 && MethodParamCount(setter) == 1
                    && setter.type.sval == "void" && !IsRefParam(setter, 0)
                    && binder.SameType(getter.type, ParamTypeNode(setter, 0))
                    && DeclOwnerOf(cls, getter) == DeclOwnerOf(cls, setter)) {
                        valueTy = ConcreteRetTy(getter, recvTy);
                    }
                }
                if (valueTy != null && TypeTag(valueTy) == TypeTag(elem)) {
                    return GenLiveBinding(src, recvTy, elem, fieldOwner, direct, bcls);
                }
            }
            if (direct && cls != null) {
                ExprVal recv = BindingBaseReceiver(recvTy);
                ExprVal value;
                if (FieldIndex(cls, src.sval) >= 0) { value = LoadField(recv.op, recvTy, src.sval); }
                else { value = EmitInstanceCallAs(recv, cls.sval, "get_" + src.sval, new Node(AK.Call()), true); }
                return GenConstBinding(value, elem, bcls);
            }
        }
        return GenConstBinding(GenExpr(src), elem, bcls);
    }

    Node BindingFieldOwner(Node cls, string name) {
        Node c = cls;
        while (c != null) {
            Node field = binder.FindField(c, name);
            if (field != null && !IsStatic(field)) { return c; }
            c = BaseClassOf(c);
        }
        return null;
    }

    ExprVal BindingBaseReceiver(Node recvTy) {
        string op = Coerce(new ExprVal("%this", CurThisTy()), MapType(recvTy));
        return new ExprVal(op, recvTy);
    }

    // The target is borrowed so a model can own its own binding.
    ExprVal GenLiveBinding(Node src, Node recvTy, Node elem, Node fieldOwner, bool direct, Node bcls) {
        ExprVal recv = direct ? BindingBaseReceiver(recvTy) : GenExpr(src.a);
        ExprVal obj = NewBindingObject(bcls);
        StoreBindingField(obj, bcls, "target", ToI8Ptr(recv.op, MapType(recv.ty)));
        string gfn = BindingAccFn(recvTy, elem, src.sval, fieldOwner, direct, false);
        string sfn = BindingAccFn(recvTy, elem, src.sval, fieldOwner, direct, true);
        string et = MapType(elem);
        StoreBindingField(obj, bcls, "getter", AccDelegate(gfn, et + " (i8*, i8*)*"));
        StoreBindingField(obj, bcls, "setter", AccDelegate(sfn, "void (i8*, i8*, " + et + ")*"));
        StoreBindingField(obj, bcls, "live", "1");
        return obj;
    }

    // A const binding: the value itself, the live flag stays 0.
    ExprVal GenConstBinding(ExprVal v, Node elem, Node bcls) {
        ExprVal obj = NewBindingObject(bcls);
        // a managed value in the erased slot: the binding holds its own
        // reference (the slot is a plain i64, nothing else would)
        if (ArcManaged(v.ty) || v.ty.ival >= 1) { EmitArcRetain(v.op, v.ty); }
        StoreBindingField(obj, bcls, "constVal", ToSlot(v, elem));
        return obj;
    }

    // A fresh Binding object (the class's own layout, zeroed by zalloc).
    ExprVal NewBindingObject(Node bcls) {
        Node bt = new Node(AK.TypeRef());
        bt.sval = bcls.sval;
        Node ne = new Node(AK.NewExpr());
        ne.type = bt;
        return GenNew(ne);
    }

    // Store a value into one of the Binding object's fields.
    void StoreBindingField(ExprVal obj, Node bcls, string name, string val) {
        int idx = FieldIndex(bcls, name);
        string lt = BindingFieldLt(bcls, name);
        string p = NT();
        L("  " + p + " = getelementptr %" + bcls.sval + ", %" + bcls.sval + "* " + obj.op + ", i32 0, i32 " + idx);
        L("  store " + lt + " " + val + ", " + lt + "* " + p);
    }

    // The delegate closure around an accessor function: { fn, env } with an
    // empty env slot (the accessor reads the field off the target).
    string AccDelegate(string fn, string fnType) {
        // The fresh Binding getter/setter field consumes the initial +1.
        // No statement temporary owns this reference.
        string clo = OwnedAlloc(16, "@zclosure_dtor");
        string clop = NT();
        L("  " + clop + " = bitcast i8* " + clo + " to i8**");
        string fni8 = NT();
        // the function type is NOT parenthesized here: a parenthesized
        // function type is only a typed value in an argument position
        L("  " + fni8 + " = bitcast " + fnType + " @" + fn + " to i8*");
        L("  store i8* " + fni8 + ", i8** " + clop);
        string clop1 = NT();
        L("  " + clop1 + " = getelementptr i8*, i8** " + clop + ", i64 1");
        L("  store i8* null, i8** " + clop1);
        return TagClosure(clo);
    }

    string BindingAccFn(Node recvTy, Node elem, string name, Node fieldOwner, bool direct, bool isSet) {
        InitBinding();
        // Generic instantiations can share a layout but have different call
        // signatures. `base.P` also needs its own direct-dispatch thunk.
        string key = TypeTag(recvTy) + "#" + name + "#" + TypeTag(elem) + "#" + MapType(elem)
            + (direct ? "#base" : "#normal") + (isSet ? "#s" : "#g");
        int i = 0;
        while (i < bindAccKeys.Count) {
            if (bindAccKeys[i] == key) { return bindAccFns[i]; }
            i = i + 1;
        }
        string fn = "__zbind_" + (isSet ? "set" : "get") + "_" + bindAccKeys.Count;
        bindAccKeys.Add(key);
        bindAccFns.Add(fn);
        EmitBindingAcc(recvTy, elem, name, fieldOwner, direct, isSet, fn);
        return fn;
    }

    void EmitBindingAcc(Node recvTy, Node elem, string name, Node fieldOwner, bool direct, bool isSet, string fn) {
        string et = MapType(elem);
        StringBuilder savedBody = body;
        StringBuilder savedAllocas = entryAllocas; bool savedEaActive = eaActive;
        int savedTmp = tmp; int savedLbl = lbl; bool savedTerm = term; string savedCurLbl = curLbl;
        List<string> savedTemps = stmtTemps; List<Node> savedTempTypes = stmtTempTypes;
        List<string> savedTempValues = stmtTempValues; List<string> savedTempOwners = stmtTempOwners;
        body = new StringBuilder(); entryAllocas = new StringBuilder(); eaActive = true;
        stmtTemps = new List<string>(); stmtTempTypes = new List<Node>();
        stmtTempValues = new List<string>(); stmtTempOwners = new List<string>();
        tmp = 0; lbl = 0; term = false; curLbl = "entry";

        string obj = NT();
        L("  " + obj + " = bitcast i8* %target to " + MapType(recvTy));
        ExprVal recv = new ExprVal(obj, recvTy);
        ExprVal value;
        if (fieldOwner != null) { value = EmitBindingFieldAcc(recv, elem, fieldOwner, name, isSet); }
        else { value = EmitBindingPropertyAcc(recv, elem, name, direct, isSet); }
        if (isSet) {
            EmitTempReleases();
            L("  ret void");
        } else {
            TransferTempOwner(value);
            string op = Coerce(value, et);
            EmitTempReleases();
            L("  ret " + et + " " + op);
        }
        L("}");
        if (isSet) { deferred.Append("define void @" + fn + "(i8* %env, i8* %target, " + et + " %v) {\n"); }
        else { deferred.Append("define " + et + " @" + fn + "(i8* %env, i8* %target) {\n"); }
        deferred.Append("entry:\n");
        deferred.Append(entryAllocas.ToString());
        deferred.Append(body.ToString());

        body = savedBody; entryAllocas = savedAllocas; eaActive = savedEaActive;
        tmp = savedTmp; lbl = savedLbl; term = savedTerm; curLbl = savedCurLbl;
        stmtTemps = savedTemps; stmtTempTypes = savedTempTypes;
        stmtTempValues = savedTempValues; stmtTempOwners = savedTempOwners;
    }

    ExprVal EmitBindingPropertyAcc(ExprVal recv, Node elem, string name, bool direct, bool isSet) {
        Node call = new Node(AK.Call());
        if (!isSet) {
            // Dispatch borrows the target; the getter result already owns its reference.
            ExprVal value = EmitInstanceCallCore(recv, recv.ty.sval, "get_" + name, call, direct);
            // An inherited virtual getter can still carry its base's erased
            // type in the call result. The binding element has the substitution.
            if (IsErasedType(value.ty) && MapType(elem) != "i64") { return FromSlot(value.op, elem); }
            return value;
        }
        // Give the ordinary call path a typed local for the borrowed setter
        // parameter. Its storage is private to this thunk.
        int mark = locName.Count;
        int savedLocSeq = locSeq;
        Node arg = new Node(AK.Ident());
        arg.sval = "binding$value";
        string slot = AddLocal(arg.sval, elem);
        string et = MapType(elem);
        L("  " + slot + " = alloca " + et);
        L("  store " + et + " %v, " + et + "* " + slot);
        call.Add(arg);
        EmitInstanceCallCore(recv, recv.ty.sval, "set_" + name, call, direct);
        TrimLocals(mark);
        locSeq = savedLocSeq;
        return null;
    }

    ExprVal EmitBindingFieldAcc(ExprVal recv, Node elem, Node owner, string name, bool isSet) {
        Node cls = ClassOf(recv.ty);
        Node field = binder.FindField(owner, name);
        if (field == null) { throw new Exception("Binding field '" + name + "' is missing from '" + owner.sval + "'"); }
        if (!IsErasedTypeDecl(field.type, owner.sval)) {
            if (isSet) {
                StoreField(recv.op, cls.sval, field.sval, new ExprVal("%v", elem));
                return null;
            }
            ExprVal value = LoadField(recv.op, recv.ty, field.sval);
            EmitArcRetain(value.op, elem);
            return value;
        }

        string ptr = NT();
        L("  " + ptr + " = getelementptr %" + cls.sval + ", %" + cls.sval + "* "
            + recv.op + ", i32 0, i32 " + FieldIndex(cls, field.sval));
        if (isSet && WeakTy(field.type)) {
            EmitWeakStore(ptr, ToSlot(new ExprVal("%v", elem), elem));
            return null;
        }
        string raw = NT();
        L("  " + raw + " = load i64, i64* " + ptr);
        ExprVal current = FromSlot(raw, elem);
        if (isSet) {
            EmitArcRetain("%v", elem);
            L("  store i64 " + ToSlot(new ExprVal("%v", elem), elem) + ", i64* " + ptr);
            EmitArcRelease(current.op, elem);
            return null;
        }
        EmitArcRetain(current.op, elem);
        return current;
    }

    // A pointer value as the i8* the object-typed slots use.
    string ToI8Ptr(string v, string vt) {
        if (vt == "i8*") { return v; }
        string t = NT();
        L("  " + t + " = bitcast " + vt + " " + v + " to i8*");
        return t;
    }
}
