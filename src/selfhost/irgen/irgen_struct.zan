using System;
using System.Collections.Generic;
namespace Zan;

// Irgen part: struct value semantics.
//
// This backend has no aggregate values: a struct instance is a heap object
// (%Name*) and every mention of it is a pointer. The C host passes structs by
// value, so every place where the host copies a struct has to copy it here
// too:
//   - assignment to a variable or to a field
//   - passing an argument
//   - storing into a container element (List / Dictionary / array)
// A struct-typed field holds a pointer to a nested instance, so the copy is
// deep for struct fields and shallow (retain) for class fields -- the same
// split the host's by-value copy makes.
partial class Irgen {
    // true when `t` names a non-nullable struct type (an instance is a heap object here)
    bool IsStructTy(Node t) {
        if (t == null) { return false; }
        if (t.ival >= 1) { return false; }
        if (IsNullable(t)) { return false; }
        if (IsErasedType(t)) { return false; }
        // the hardware vectors are declared as structs but are first-class
        // values here: they have no heap layout and no instance to copy
        if (t.sval == "Vector128" || t.sval == "Vector256") { return false; }
        Node d = binder.FindType(t.sval);
        if (d == null) { return false; }
        return d.kind == AK.StructDecl();
    }

    bool IsNullableStruct(Node t) {
        if (t == null) { return false; }
        if (t.ival >= 1) { return false; }
        if (!IsNullable(t)) { return false; }
        if (IsErasedType(t)) { return false; }
        if (t.sval == "Vector128" || t.sval == "Vector256") { return false; }
        Node d = binder.FindType(t.sval);
        if (d == null) { return false; }
        return d.kind == AK.StructDecl();
    }

    bool IsExplicitLayoutStruct(Node t) {
        if (t == null || t.ival >= 1 || IsErasedType(t)) { return false; }
        Node d = binder.FindType(t.sval);
        return d != null && d.kind == AK.StructDecl() && d.layoutExplicit;
    }

    // Build the `__SPI_<tags>` suffix for a concrete generic struct instantiation,
    // or `""` when the type is not a fully concrete generic instantiation.
    string ConcreteStructSpecSuffix(Node decl, Node instTy) {
        if (decl == null || instTy == null) { return ""; }
        List<string> tps = TParams(decl);
        if (tps.Count == 0 || instTy.kids.Count != tps.Count) { return ""; }
        StringBuilder sb = new StringBuilder();
        sb.Append("__SPI");
        int i = 0;
        while (i < instTy.kids.Count) {
            if (instTy.kids[i] == null || MentionsTypeParam(instTy.kids[i])) { return ""; }
            sb.Append("_");
            sb.Append(TypeTag(instTy.kids[i]));
            i = i + 1;
        }
        return sb.ToString();
    }

    // True when a concrete generic struct instantiation needs specialized
    // allocation/copy helpers (specialized dtor or nested struct fields).
    bool StructInstNeedsSpec(Node decl, Node instTy) {
        if (decl == null || decl.kind != AK.StructDecl() || decl.layoutExplicit) { return false; }
        if (ConcreteStructSpecSuffix(decl, instTy) == "") { return false; }
        if (SpecDtorSym(decl, instTy) != decl.sval + "_dtor") { return true; }
        List<Node> effTypes = new List<Node>();
        CollectFieldEffTypes(decl, instTy, effTypes);
        int i = 0;
        while (i < effTypes.Count) {
            if (IsStructTy(effTypes[i])) { return true; }
            i = i + 1;
        }
        return false;
    }

    // Lazily emit `@<cn>[__SPI_<tags>]_clone(i8* %src) -> i8*` for reflection value-copy semantics.
    string EnsureStructCloneHelper(Node decl, Node instTy = null) {
        if (decl == null || decl.kind != AK.StructDecl() || decl.layoutExplicit) { return "null"; }
        string cn = decl.sval;
        Node effInst = StructInstNeedsSpec(decl, instTy) ? instTy : null;
        string suffix = effInst != null ? ConcreteStructSpecSuffix(decl, effInst) : "";
        string key = cn + suffix;
        string sym = "@" + key + "_clone";
        if (structCloneEmitted.ContainsKey(key)) { return sym; }
        structCloneEmitted[key] = true;
        StringBuilder saved = body;
        int st = tmp; int sl = lbl; string sc = curLbl; bool se = eaActive;
        body = new StringBuilder(); tmp = 0; lbl = 0; curLbl = "entry"; eaActive = false;
        L("define internal i8* " + sym + "(i8* %src) {");
        L("entry:");
        string isNull = NT();
        L("  " + isNull + " = icmp eq i8* %src, null");
        int lcopy = NL();
        int lnil = NL();
        L("  br i1 " + isNull + ", label %L" + lnil + ", label %L" + lcopy);
        Label(lnil);
        L("  ret i8* null");
        Label(lcopy);
        string srcTyped = NT();
        L("  " + srcTyped + " = bitcast i8* %src to %" + cn + "*");
        string dst = AllocStructObj(cn, effInst);
        InitNestedFields(dst, decl, effInst);
        CopyStructInto(dst, srcTyped, decl, effInst);
        string res = NT();
        L("  " + res + " = bitcast %" + cn + "* " + dst + " to i8*");
        L("  ret i8* " + res);
        L("}");
        string text = body.ToString();
        body = saved; tmp = st; lbl = sl; curLbl = sc; eaActive = se;
        deferred.Append(text);
        return sym;
    }

    // does a value of type `slotTy` have to be copied when it is stored into
    // a slot of that type? An erased slot (a type parameter) takes the copy
    // only when the value's own type says so.
    bool NeedsStructCopy(Node slotTy, ExprVal v) {
        if (IsStructTy(slotTy)) { return true; }
        if (slotTy != null && IsErasedType(slotTy) && v != null) { return IsStructTy(v.ty); }
        return false;
    }

    // allocate a zeroed struct instance; returns the object pointer
    string AllocStructObj(string cn, Node instTy = null) {
        string dtorSym = cn + "_dtor";
        Node decl = binder.FindType(cn);
        if (decl != null && instTy != null) { dtorSym = SpecDtorSym(decl, instTy); }
        string szp = NT();
        L("  " + szp + " = getelementptr %" + cn + ", %" + cn + "* null, i32 1");
        string szi = NT();
        L("  " + szi + " = ptrtoint %" + cn + "* " + szp + " to i64");
        string raw = NT();
        L("  " + raw + " = call i8* @zalloc(i64 " + szi + ", i8* bitcast (void (i8*)* @" + dtorSym + " to i8*), i8* bitcast (i8** @__tid_" + cn + " to i8*))");
        string obj = NT();
        L("  " + obj + " = bitcast i8* " + raw + " to %" + cn + "*");
        return obj;
    }

    int FieldStorageBytes(Node fty) {
        string lt = MapFieldType(fty);
        if (lt == "i8") { return 1; }
        if (lt == "i16") { return 2; }
        if (lt == "i32" || lt == "float") { return 4; }
        if (lt == DecimalLL()) { return 16; }
        return 8;
    }

    int FieldByteOffset(Node cls, string name) {
        if (cls == null) { return 0; }
        int i = 0;
        while (i < cls.kids.Count) {
            Node k = cls.kids[i];
            if (k.kind == AK.FieldDecl() && k.sval == name) {
                if (k.fieldOffset >= 0) { return k.fieldOffset; }
                return 0;
            }
            i = i + 1;
        }
        return 0;
    }

    int ExplicitStructBytes(Node cls) {
        int maxEnd = 1;
        if (cls == null) { return maxEnd; }
        string savedScope = typeScopeCls;
        typeScopeCls = cls.sval;
        int i = 0;
        while (i < cls.kids.Count) {
            Node k = cls.kids[i];
            if (k.kind == AK.FieldDecl() && !IsStatic(k)) {
                int off = k.fieldOffset >= 0 ? k.fieldOffset : 0;
                int end = off + FieldStorageBytes(k.type);
                if (end > maxEnd) { maxEnd = end; }
            }
            i = i + 1;
        }
        typeScopeCls = savedScope;
        return maxEnd;
    }

    string EmitFieldPtr(Node cls, string clsName, string objOp, string field, string ft) {
        if (cls != null && cls.kind == AK.StructDecl() && cls.layoutExplicit) {
            int off = FieldByteOffset(cls, field);
            string raw = NT();
            L("  " + raw + " = bitcast %" + clsName + "* " + objOp + " to i8*");
            string bp = raw;
            if (off > 0) {
                bp = NT();
                L("  " + bp + " = getelementptr i8, i8* " + raw + ", i64 " + off);
            }
            string fp = NT();
            L("  " + fp + " = bitcast i8* " + bp + " to " + ft + "*");
            return fp;
        }
        int idx = FieldIndex(cls, field);
        string p = NT();
        L("  " + p + " = getelementptr %" + clsName + ", %" + clsName + "* " + objOp + ", i32 0, i32 " + idx);
        return p;
    }

    // A struct-typed field holds a pointer to a nested instance. Every
    // instance therefore needs its nested instances allocated (zeroed) --
    // otherwise writing a nested field dereferences a null pointer.
    void InitNestedFields(string obj, Node decl, Node instTy = null) {
        if (decl == null) { return; }
        if (decl.kind == AK.StructDecl() && decl.layoutExplicit) { return; }
        List<string> names = new List<string>();
        List<Node> types = new List<Node>();
        CollectFields(decl, names, types);
        Node rootTy = instTy != null ? instTy : MkType(decl.sval);
        List<Node> effTypes = new List<Node>();
        CollectFieldEffTypes(decl, rootTy, effTypes);
        int fb = FieldBase(decl);
        int i = 0;
        while (i < types.Count) {
            Node rawTy = types[i];
            Node fty = (i < effTypes.Count && effTypes[i] != null) ? effTypes[i] : rawTy;
            string physLt = decl.kind == AK.StructDecl() ? MapFieldTypeDecl(rawTy, decl.sval) : MapTypeDecl(rawTy, decl.sval);
            bool erasedSlot = (physLt == "i64") && rawTy != null && IsErasedTypeDecl(rawTy, decl.sval);
            if (IsStructTy(fty)) {
                string cn = fty.sval;
                string sub = AllocStructObj(cn, fty);
                string lt = MapType(fty);
                string p = NT();
                L("  " + p + " = getelementptr %" + decl.sval + ", %" + decl.sval + "* " + obj + ", i32 0, i32 " + (fb + i));
                if (erasedSlot) {
                    string iv = NT();
                    L("  " + iv + " = ptrtoint " + lt + " " + sub + " to i64");
                    L("  store i64 " + iv + ", i64* " + p);
                } else {
                    L("  store " + lt + " " + sub + ", " + lt + "* " + p);
                }
                Node ndecl = binder.FindType(cn);
                InitNestedFields(sub, ndecl, fty);
            }
            i = i + 1;
        }
    }

    // Specialized `@<cn>__SPI_<tags>_newobj()` for concrete generic struct
    // instantiations whose dtor or nested struct fields depend on type args.
    string SpecStructNewObjSym(Node decl, Node instTy) {
        if (decl == null) { return ""; }
        string cn = decl.sval;
        if (!StructInstNeedsSpec(decl, instTy)) { return "@" + cn + "_newobj"; }
        string suffix = ConcreteStructSpecSuffix(decl, instTy);
        string sym = "@" + cn + suffix + "_newobj";
        string key = "newobj:" + sym;
        if (structCloneEmitted.ContainsKey(key)) { return sym; }
        structCloneEmitted[key] = true;
        StringBuilder saved = body;
        int st = tmp; int sl = lbl; string sc = curLbl; bool se = eaActive;
        body = new StringBuilder(); tmp = 0; lbl = 0; curLbl = "entry"; eaActive = false;
        L("define internal i8* " + sym + "() {");
        L("entry:");
        string obj = AllocStructObj(cn, instTy);
        InitNestedFields(obj, decl, instTy);
        string raw = NT();
        L("  " + raw + " = bitcast %" + cn + "* " + obj + " to i8*");
        L("  ret i8* " + raw);
        L("}");
        string text = body.ToString();
        body = saved; tmp = st; lbl = sl; curLbl = sc; eaActive = se;
        deferred.Append(text);
        return sym;
    }

    // Specialized `@<cn>__SPI_<tags>_initarr(i64* %arr, i64 %n)` for arrays
    // of concrete generic structs.
    string SpecStructInitArrSym(Node decl, Node instTy) {
        if (decl == null) { return ""; }
        string cn = decl.sval;
        string newObjSym = SpecStructNewObjSym(decl, instTy);
        if (newObjSym == "@" + cn + "_newobj") { return "@" + cn + "_initarr"; }
        string suffix = ConcreteStructSpecSuffix(decl, instTy);
        string sym = "@" + cn + suffix + "_initarr";
        string key = "initarr:" + sym;
        if (structCloneEmitted.ContainsKey(key)) { return sym; }
        structCloneEmitted[key] = true;
        StringBuilder sb = new StringBuilder();
        sb.Append("define internal void " + sym + "(i64* %arr, i64 %n) {\n");
        sb.Append("entry:\n");
        sb.Append("  br label %loop\n");
        sb.Append("loop:\n");
        sb.Append("  %i = phi i64 [ 0, %entry ], [ %i2, %body ]\n");
        sb.Append("  %c = icmp ult i64 %i, %n\n");
        sb.Append("  br i1 %c, label %body, label %done\n");
        sb.Append("body:\n");
        sb.Append("  %slot = getelementptr i64, i64* %arr, i64 %i\n");
        sb.Append("  %obj = call i8* " + newObjSym + "()\n");
        sb.Append("  %pi = ptrtoint i8* %obj to i64\n");
        sb.Append("  store i64 %pi, i64* %slot\n");
        sb.Append("  %i2 = add i64 %i, 1\n");
        sb.Append("  br label %loop\n");
        sb.Append("done:\n");
        sb.Append("  ret void\n");
        sb.Append("}\n");
        deferred.Append(sb.ToString());
        return sym;
    }

    // A struct instance constructor: a zeroed instance whose struct-typed
    // fields get their own nested instances (the same shape AllocStructObj
    // builds, but as a module-level function so the array fill can call it).
    void EmitStructNewObj(Node decl) {
        string cn = decl.sval;
        H("define i8* @" + cn + "_newobj() {");
        H("  %szp = getelementptr %" + cn + ", %" + cn + "* null, i32 1");
        H("  %szi = ptrtoint %" + cn + "* %szp to i64");
        H("  %raw = call i8* @zalloc(i64 %szi, i8* bitcast (void (i8*)* @" + cn + "_dtor to i8*), i8* bitcast (i8** @__tid_" + cn + " to i8*))");
        H("  %obj = bitcast i8* %raw to %" + cn + "*");
        if (decl.kind == AK.StructDecl() && decl.layoutExplicit) {
            H("  ret i8* %raw");
            H("}");
            return;
        }
        List<string> names = new List<string>();
        List<Node> types = new List<Node>();
        CollectFields(decl, names, types);
        int fb = FieldBase(decl);
        int i = 0;
        int seq = 0;
        while (i < types.Count) {
            Node fty = types[i];
            if (IsStructTy(fty)) {
                string slt = MapType(fty);
                string newSym = SpecStructNewObjSym(binder.FindType(fty.sval), fty);
                H("  %nf" + seq + " = getelementptr %" + cn + ", %" + cn + "* %obj, i32 0, i32 " + (fb + i));
                H("  %ns" + seq + " = call i8* " + newSym + "()");
                H("  %nb" + seq + " = bitcast i8* %ns" + seq + " to " + slt);
                H("  store " + slt + " %nb" + seq + ", " + slt + "* %nf" + seq);
                seq = seq + 1;
            }
            i = i + 1;
        }
        H("  ret i8* %raw");
        H("}");
    }

    // Fill the slots of an array whose element type is a struct with default
    // instances. The C host keeps a struct element inline in the array, so
    // its zeroed array already holds `n` default instances; here a struct
    // instance is a heap object, so every slot needs an instance of its own
    // (a null slot would fault on the first field access).
    void EmitStructArrInit(Node decl) {
        string cn = decl.sval;
        H("define void @" + cn + "_initarr(i64* %arr, i64 %n) {");
        H("entry:");
        H("  br label %loop");
        H("loop:");
        H("  %i = phi i64 [ 0, %entry ], [ %i2, %body ]");
        H("  %c = icmp ult i64 %i, %n");
        H("  br i1 %c, label %body, label %done");
        H("body:");
        H("  %slot = getelementptr i64, i64* %arr, i64 %i");
        H("  %obj = call i8* @" + cn + "_newobj()");
        H("  %pi = ptrtoint i8* %obj to i64");
        H("  store i64 %pi, i64* %slot");
        H("  %i2 = add i64 %i, 1");
        H("  br label %loop");
        H("done:");
        H("  ret void");
        H("}");
    }

    // Copy the contents of the struct instance `src` into the instance `dst`.
    // Class fields are shared with the source (the copy retains them), struct
    // fields are copied recursively.
    void CopyStructInto(string dst, string src, Node decl, Node instTy = null) {
        if (decl == null) { return; }
        if (decl.kind == AK.StructDecl() && decl.layoutExplicit) {
            string cn0 = decl.sval;
            int sz = ExplicitStructBytes(decl);
            string d8 = NT();
            L("  " + d8 + " = bitcast %" + cn0 + "* " + dst + " to i8*");
            string s8 = NT();
            L("  " + s8 + " = bitcast %" + cn0 + "* " + src + " to i8*");
            L("  call i8* @memcpy(i8* " + d8 + ", i8* " + s8 + ", i64 " + sz + ")");
            return;
        }
        List<string> names = new List<string>();
        List<Node> types = new List<Node>();
        CollectFields(decl, names, types);
        Node rootTy = instTy != null ? instTy : MkType(decl.sval);
        List<Node> effTypes = new List<Node>();
        CollectFieldEffTypes(decl, rootTy, effTypes);
        string cn = decl.sval;
        int fb = FieldBase(decl);
        int i = 0;
        while (i < types.Count) {
            Node rawTy = types[i];
            Node fty = (i < effTypes.Count && effTypes[i] != null) ? effTypes[i] : rawTy;
            string physLt = decl.kind == AK.StructDecl() ? MapFieldTypeDecl(rawTy, cn) : MapTypeDecl(rawTy, cn);
            bool erasedSlot = (physLt == "i64") && rawTy != null && IsErasedTypeDecl(rawTy, cn);
            int idx = fb + i;
            string sp = NT();
            L("  " + sp + " = getelementptr %" + cn + ", %" + cn + "* " + src + ", i32 0, i32 " + idx);
            string dp = NT();
            L("  " + dp + " = getelementptr %" + cn + ", %" + cn + "* " + dst + ", i32 0, i32 " + idx);
            if (IsStructTy(fty)) {
                string slt = MapType(fty);
                string sv = NT();
                string dv = NT();
                if (erasedSlot) {
                    string sraw = NT();
                    L("  " + sraw + " = load i64, i64* " + sp);
                    L("  " + sv + " = inttoptr i64 " + sraw + " to " + slt);
                    string draw = NT();
                    L("  " + draw + " = load i64, i64* " + dp);
                    L("  " + dv + " = inttoptr i64 " + draw + " to " + slt);
                } else {
                    L("  " + sv + " = load " + slt + ", " + slt + "* " + sp);
                    L("  " + dv + " = load " + slt + ", " + slt + "* " + dp);
                }
                // A null source field has nothing to copy: read the (zeroed)
                // destination instead. That keeps the copy branch-free -- a
                // branch here would have to duplicate the nested copy.
                string isnull = NT();
                L("  " + isnull + " = icmp eq " + slt + " " + sv + ", null");
                string safe = NT();
                L("  " + safe + " = select i1 " + isnull + ", " + slt + " " + dv + ", " + slt + " " + sv);
                Node ndecl = binder.FindType(fty.sval);
                CopyStructInto(dv, safe, ndecl, fty);
            } else {
                string sv = NT();
                L("  " + sv + " = load " + physLt + ", " + physLt + "* " + sp);
                L("  store " + physLt + " " + sv + ", " + physLt + "* " + dp);
                // a class field is shared with the source: the copy holds a
                // reference of its own
                if (fty != null && !IsErasedType(fty) && (ArcManaged(fty) || fty.ival >= 1) && !WeakTy(fty)) {
                    string rval = sv;
                    if (erasedSlot) {
                        rval = FromSlot(sv, fty).op;
                    }
                    EmitArcRetain(rval, fty);
                }
            }
            i = i + 1;
        }
    }

    // Copy a struct value: a fresh instance carrying the same contents.
    ExprVal CopyStructValue(ExprVal v) {
        if (!IsStructTy(v.ty)) { return v; }
        string cn = v.ty.sval;
        Node decl = binder.FindType(cn);
        if (decl == null) { return v; }
        string dst = AllocStructObj(cn, v.ty);
        InitNestedFields(dst, decl, v.ty);
        if (v.op != "null") { CopyStructInto(dst, v.op, decl, v.ty); }
        return new ExprVal(dst, v.ty);
    }

    // A value that is stored into a slot the caller keeps: the copy is a
    // temporary -- the slot's own retain keeps it alive until the end of the
    // statement, the temporary release drops that extra reference.
    ExprVal StructCopyTemp(ExprVal v, Node slotTy) {
        ExprVal c = CopyStructValue(v);
        Node t = slotTy;
        if (t == null || IsErasedType(t)) { t = v.ty; }
        AddTemp(c.op, t);
        return c;
    }

    // A value that is stored into a container element: container mutators
    // (zlist_add/set/insert, zdict_set) retain ARC-owned elements (structs have
    // ownership kind 1), so the fresh copy must be registered as a statement
    // temporary to drop the extra creation reference once stored.
    string StructElemSlot(ExprVal v, Node elemTy) {
        if (IsStructTy(elemTy)) {
            ExprVal c = StructCopyTemp(v, elemTy);
            return ToSlot(c, elemTy);
        }
        // a float element carries single precision: the host stores an f32
        if (IsFloatTy(elemTy) && v != null && v.ty != null && IsDbl(v.ty)) {
            return ToSlot(new ExprVal(F32Round(v.op), v.ty), elemTy);
        }
        return ToSlot(v, elemTy);
    }
}
