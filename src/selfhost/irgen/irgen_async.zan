using System;
using System.Collections.Generic;
namespace Zan;

partial class Irgen {
    Node AsyncElemTyOf(Node rt) {
        if (rt == null) { return null; }
        if (rt.sval != "Task") { return rt; }
        if (rt.kids.Count == 1) { return rt.kids[0]; }
        return MkType("void");
    }

    // Lower `await <callExpr>`; returns the awaited result (+1 owned if ARC).
    ExprVal EmitAwait(Node callExpr) {
        if (!curAsync && callExpr != null && callExpr.a != null && callExpr.a.kind == AK.MemberAccess()
            && callExpr.a.a != null && callExpr.a.a.sval == "Task") {
            string mn = callExpr.a.sval;
            if (mn == "Delay" && callExpr.kids.Count == 1) {
                string ms = ArgI64(callExpr.kids[0]);
                if (!ExternSeen("zan_co_sync_sleep")) {
                    externDecls.Add("zan_co_sync_sleep");
                    H("declare void @zan_co_sync_sleep(i64)");
                }
                L("  call void @zan_co_sync_sleep(i64 " + ms + ")");
                return new ExprVal("0", MkType("int"));
            }
            if (mn == "Yield" && callExpr.kids.Count == 0) {
                return new ExprVal("0", MkType("int"));
            }
        }
        if (curAsync && IsSocketIntrinsic(callExpr)) { return EmitSocketIntrinsic(callExpr); }
        ExprVal sub = GenExpr(callExpr);
        // The awaited operand has to be a coroutine frame: the lowering reads
        // the frame's slot 9 (the resume entry) and hands the frame to the
        // scheduler. An operand that is not a frame (an unknown call, a task
        // handle, a plain value) has no such slot -- reading it produced
        // `bitcast i8* 0 to i64*` and clang rejected the IR outright. Report
        // it instead of emitting broken IR.
        //
        // The C host has THREE shapes (src/compiler/irgen_expr.c:
        // emit_expr_await_expr): a coroutine frame (the awaited call started
        // one), a TASK HANDLE (poll the task until it is done, then take
        // its result), and anything else -- the value passes through
        // unchanged (the host's function ends with `return sub`).
        // `await sqlite3_step(stmt)` (a plain int call) is that third shape:
        // the host awaits nothing and hands the value on.
        if (!sub.asyncCall) {
            if (sub.ty != null && sub.ty.sval == "Task") {
                return EmitAwaitTaskHandle(sub);
            }
            return sub;
        }
        // The ramp retained its arguments into its frame. Consume argument
        // temporaries before suspension; stack temp slots cannot survive it.
        EmitTempReleases();
        Node resTy = MkType("int");
        if (sub.ty != null && sub.ty.a != null) { resTy = sub.ty.a; }
        // A Task-shaped return (`async Task<T>`) carries the RESULT, not a
        // handle: the awaited value has the element type. The C host's
        // parser rewrites the declared return type the same way
        // (desugar_async_task_method); without the unwrap the awaited value
        // was typed as the handle -- the inttoptr/ptrtoint round trip kept
        // the bits for pointers and integers, but a double result came out as
        // a pointer and the store into the double slot was invalid IR
        // (clang: "'%t8' defined with type 'ptr' but expected 'double'").
        resTy = AsyncElemTyOf(resTy);
        string subv = sub.op;
        string subh = NT();
        L("  " + subh + " = bitcast i8* " + subv + " to i64*");
        string orp = FrameGep(subh, 9);
        string ori = NT(); L("  " + ori + " = load i64, i64* " + orp);
        string orfn = NT(); L("  " + orfn + " = inttoptr i64 " + ori + " to void(i8*)*");
        if (curAsync) {
            int seq = curAwaitSeq; curAwaitSeq = curAwaitSeq + 1;
            int st = seq + 1;
            string ssp = FrameGep("%ff", curSubBase);
            string subi = NT(); L("  " + subi + " = ptrtoint i8* " + subv + " to i64");
            L("  store i64 " + subi + ", i64* " + ssp);
            L("  call void @zan_task_child(i8* %fp, i8* " + subv + ")");
            string selfi = NT(); L("  " + selfi + " = ptrtoint i8* %fp to i64");
            string awp = FrameGep(subh, 4);
            L("  store i64 " + selfi + ", i64* " + awp);
            string stepi = NT(); L("  " + stepi + " = ptrtoint void(i8*)* @" + curResumeSym + " to i64");
            string awsp = FrameGep(subh, 5);
            L("  store i64 " + stepi + ", i64* " + awsp);
            L("  call void @zan_co_ready(i8* " + subv + ", void(i8*)* " + orfn + ")");
            EmitAsyncSaveSlots();
            string stp = FrameGep("%ff", 2);
            L("  store i64 " + st + ", i64* " + stp);
            EmitAsyncSuspend();
            L("  ret void");
            L("resume_" + st + ":");
            term = false; curLbl = "resume_" + st;
            EmitAsyncReloadSlots();
            EmitAsyncRearm();
            string ssp2 = FrameGep("%ff", curSubBase);
            string subi2 = NT(); L("  " + subi2 + " = load i64, i64* " + ssp2);
            string subh2 = NT(); L("  " + subh2 + " = inttoptr i64 " + subi2 + " to i64*");
            string fv = NT(); L("  " + fv + " = inttoptr i64 " + subi2 + " to i8*");
            L("  store i64 0, i64* " + ssp2);
            L("  call void @zan_task_child(i8* %fp, i8* null)");
            // the awaited coroutine may have failed: its exception is
            // re-thrown HERE, in the awaiter's own context, where the
            // awaiter's try blocks are armed again.
            EmitAwaitCheckExc(subh2);
            string lt = MapType(resTy);
            if (lt == "void") {
                L("  call void @zexc_frame_free(i8* " + fv + ")");
                return new ExprVal("0", MkType("int"));
            }
            string rp = FrameGep(subh2, 6);
            string resi = NT(); L("  " + resi + " = load i64, i64* " + rp);
            string rvv;
            if (IsDecimal(resTy)) { rvv = DecimalResultLoad(subh2).op; }
            else { rvv = FromI64(resi, lt); }
            L("  call void @zexc_frame_free(i8* " + fv + ")");
            return new ExprVal(rvv, resTy);
        }
        string donep = FrameGep(subh, 3);
        string donepi32 = NT();
        L("  " + donepi32 + " = bitcast i64* " + donep + " to i32*");
        L("  call void @zan_co_ready(i8* " + subv + ", void(i8*)* " + orfn + ")");
        L("  call void @zan_co_sched_run_until(i32* " + donepi32 + ")");
        // the awaited coroutine may have failed: re-throw its exception here
        EmitAwaitCheckExc(subh);
        string lt2 = MapType(resTy);
        if (lt2 == "void") {
            L("  call void @zexc_frame_free(i8* " + subv + ")");
            return new ExprVal("0", MkType("int"));
        }
        string rp2 = FrameGep(subh, 6);
        string resi2 = NT(); L("  " + resi2 + " = load i64, i64* " + rp2);
        string rvv2;
        if (IsDecimal(resTy)) { rvv2 = DecimalResultLoad(subh).op; }
        else { rvv2 = FromI64(resi2, lt2); }
        L("  call void @zexc_frame_free(i8* " + subv + ")");
        return new ExprVal(rvv2, resTy);
    }
    // The awaited coroutine may have failed: it left its exception in the
    // frame. Re-throw it HERE, in the awaiter's own context, so the
    // awaiter's try blocks can catch it (the C host does the same,
    // irgen_async.c: emit_async_check_sub_exc).
    void EmitAwaitCheckExc(string subh) {
        string errorRaw = NT(); string errorRecord = NT();
        L("  " + errorRaw + " = getelementptr i64, i64* " + subh + ", i64 14");
        L("  " + errorRecord + " = bitcast i64* " + errorRaw + " to %zan.exception*");
        string activeSlot = FrameGep(subh, 17);
        string active = NT(); L("  " + active + " = load i64, i64* " + activeSlot);
        string excp = FrameGep(subh, 11);
        string excv = NT(); L("  " + excv + " = load i64, i64* " + excp);
        string hasx = NT(); L("  " + hasx + " = icmp ne i64 " + active + ", 0");
        int lx = NL(); int lok = NL();
        L("  br i1 " + hasx + ", label %L" + lx + ", label %L" + lok);
        Label(lx);
        string exp = NT(); L("  " + exp + " = inttoptr i64 " + excv + " to i8*");
        L("  store i8* " + exp + ", i8** @__exc_val");
        string tidp = FrameGep(subh, 12);
        string tidv = NT(); L("  " + tidv + " = load i64, i64* " + tidp);
        string tidp2 = NT(); L("  " + tidp2 + " = inttoptr i64 " + tidv + " to i8*");
        L("  store i8* " + tidp2 + ", i8** @__exc_tid");
        L("  call void @zexc_take(%zan.exception* @zexc_dispatch, %zan.exception* " + errorRecord + ")");
        L("  store i64 0, i64* " + excp);
        L("  store i64 0, i64* " + tidp);
        RestoreExceptionDispatch();
        string consumedFrame = NT();
        L("  " + consumedFrame + " = bitcast i64* " + subh + " to i8*");
        L("  call void @zexc_frame_free(i8* " + consumedFrame + ")");
        EmitRaise();
        Label(lok);
    }
    // An await that does not suspend does not need a resume state: the value
    // is already available synchronously and passes through directly.
    void EmitAwaitNoSuspend() { }

    // `await <task handle>`: the handle is a frame pointer -- pump the
    // cooperative scheduler until the frame is done, then take its result
    // (the frame is reaped by the reader, the same protocol as `t.Result`).
    // The C host polls the task's completion field and reads its result
    // (irgen_expr.c: the task-struct branch of emit_expr_await_expr).
    ExprVal EmitAwaitTaskHandle(ExprVal sub) {
        Node resTy = MkType("void");
        if (sub.ty != null && sub.ty.kids.Count > 0) { resTy = AsyncElemTyOf(sub.ty.kids[0]); }
        string fp = sub.op;
        if (MapType(sub.ty) == "i64") {
            string p = NT();
            L("  " + p + " = inttoptr i64 " + fp + " to i8*");
            fp = p;
        }
        if (MapType(resTy) == "void") {
            EmitTaskWait(fp);
            return new ExprVal("0", MkType("void"));
        }
        return EmitTaskMemberCall(new ExprVal(fp, sub.ty), "Result", sub.ty);
    }

    // Release the frame's owned refs (params + locals via ReleaseLocalsFrom, and
    // the receiver which is not tracked as a local). Call exactly once per exit.
    void EmitAsyncEpilogue() {
        ReleaseLocalsFrom(0);
        if (curAsyncThis && curAsyncThisTy != null) {
            EmitArcRelease("%this", curAsyncThisTy);
        }
    }
    // Discard an owned result only when its pending return is abandoned.
    // Normal completion transfers it to the awaiter. Clear before releasing;
    // callers provide the declared type even in a separate $cleanup function.
    void EmitAsyncResultRelease(Node retTy) {
        if (retTy == null || !ArcManaged(retTy)) { return; }
        string slot = FrameGep("%ff", 6);
        string bits = NT(); L("  " + bits + " = load i64, i64* " + slot);
        L("  store i64 0, i64* " + slot);
        EmitArcRelease(FromI64(bits, MapType(retTy)), retTy);
    }
    // Terminal completion: write result, mark done, wake the awaiter, return.
    // Caller must have already run EmitAsyncEpilogue and ensured a +1 result.
    void EmitAsyncComplete(string resi) {
        string rp = FrameGep("%ff", 6);
        L("  store i64 " + resi + ", i64* " + rp);
        string dp = FrameGep("%ff", 3);
        L("  store i64 1, i64* " + dp);
        string sp = FrameGep("%ff", 2);
        L("  store i64 -1, i64* " + sp);
        string awp = FrameGep("%ff", 4);
        string awi = NT(); L("  " + awi + " = load i64, i64* " + awp);
        // B-ID64 镜像：自等待者（Task.Spawn 写 AWAITER=自身）即 fire-and-forget
        // 帧——结果载荷永不经帧读取，唤醒 reap 前按元素类型释放槽 6 并清槽。
        // 与宿主 emit_async_complete_epilogue 的 co.orphan 分支同口径。
        if (curAsyncRetElem != null && ArcManaged(curAsyncRetElem)) {
            string selfi = NT(); L("  " + selfi + " = ptrtoint i8* %fp to i64");
            string isself = NT(); L("  " + isself + " = icmp eq i64 " + awi + ", " + selfi);
            int lor = NL(); int lgo = NL();
            L("  br i1 " + isself + ", label %L" + lor + ", label %L" + lgo);
            Label(lor);
            EmitAsyncResultRelease(curAsyncRetElem);
            L("  br label %L" + lgo);
            Label(lgo);
        }
        string aw = NT(); L("  " + aw + " = inttoptr i64 " + awi + " to i8*");
        string has = NT(); L("  " + has + " = icmp ne i8* " + aw + ", null");
        int lw = NL(); int lr = NL();
        L("  br i1 " + has + ", label %L" + lw + ", label %L" + lr);
        Label(lw);
        string asp = FrameGep("%ff", 5);
        string asi = NT(); L("  " + asi + " = load i64, i64* " + asp);
        string asfn = NT(); L("  " + asfn + " = inttoptr i64 " + asi + " to void(i8*)*");
        L("  call void @zan_co_ready(i8* " + aw + ", void(i8*)* " + asfn + ")");
        L("  br label %L" + lr);
        Label(lr);
        L("  call void @zexc_unwind(i8* null)");
        L("  store i64 0, i64* " + FrameGep("%ff", 18));
        string ownerParentBits = NT();
        L("  " + ownerParentBits + " = load i64, i64* " + FrameGep("%ff", 19));
        string ownerParent = FromI64(ownerParentBits, "i8*");
        L("  store i8* " + ownerParent + ", i8** @zexc_owners");
        // Completion ends this invocation just like suspension: its trampoline
        // must never remain armed after the resume function returns.
        string handlerDepth = NT();
        L("  " + handlerDepth + " = load i64, i64* " + asyncEhDepth);
        L("  store i64 " + handlerDepth + ", i64* @__exc_sp");
        L("  ret void");
        term = true;
    }
    void GenAsyncReturn(Node s) {
        if (s.a != null) {
            ExprVal v = GenExpr(s.a);
            if (curRetTy != null && curRetTy.sval != "void") {
                v = ApplyUserConv(curRetTy, v, false);
                if (!convApplied) { v = StrSlotConv(curRetTy, v); }
                v = NarrowToDeclared(v, curRetTy);
                string declLt = MapType(curRetTy);
                string crv = IsNullableValue(curRetTy) ? BoxFor(v, curRetTy) : Coerce(v, declLt);
                v = new ExprVal(crv, curRetTy);
            }
            string lt = MapType(v.ty);
            string rv = v.op;
            if (!IsConstOperand(rv)) {
                EmitArcRetain(rv, v.ty);
                if (v.ty != null && v.ty.ival >= 1) {
                    EmitArrayRetain(rv, lt, v.ty);
                }
            }
            // Retain the replacement first, including when it aliases the old result.
            EmitAsyncResultRelease(curAsyncRetElem);
            // store the return value into the frame result slot (slot 6) BEFORE
            // running finally blocks: a finally body may suspend (e.g. await
            // Task.Yield()) and resume in a new invocation where SSA registers
            // are dead, and an inner return in a finally will cleanly overwrite it.
            string rp = FrameGep("%ff", 6);
            if (IsDecimal(v.ty)) { DecimalResultStore("%ff", v); }
            else { L("  store i64 " + ToI64(rv, lt) + ", i64* " + rp); }
            EmitTempReleases();
            // the finallys of the try statements this return leaves run
            // BEFORE the locals are released: they may use them (and they
            // release what the try held -- a lock, a file handle).
            EmitExitFins(0);
            if (term) { return; }
            EmitAsyncEpilogue();
            string rpAfter = FrameGep("%ff", 6);
            string resi = NT();
            L("  " + resi + " = load i64, i64* " + rpAfter);
            EmitAsyncComplete(resi);
        } else {
            EmitAsyncResultRelease(curAsyncRetElem);
            EmitExitFins(0);
            if (term) { return; }
            EmitAsyncEpilogue();
            EmitAsyncComplete("0");
        }
    }
    void GenAwaitStmt(Node s) {
        int k = s.kind;
        if (k == AK.VarDecl()) {
            Node aw = s.b;
            ExprVal res = EmitAwait(aw.a);
            Node ty = s.type; if (ty == null) { ty = res.ty; }
            string lt = MapType(ty);
            string reg;
            bool isBx = false;
            if (curAsync) {
                int slot = (int)s.ival;
                if (slot >= 0 && slot < asyncLocalRegs.Count) {
                    reg = asyncLocalRegs[slot];
                    isBx = asyncLocalBox[slot];
                } else {
                    reg = AddLocal(s.sval, ty);
                    L("  " + reg + " = alloca " + lt);
                }
            } else {
                reg = AddLocal(s.sval, ty);
                L("  " + reg + " = alloca " + lt);
            }
            string sv = Coerce(res, lt);
            if (curAsync && isBx) {
                string cell = OwnedCell(ty); string payload = NT();
                L("  " + payload + " = bitcast i8* " + cell + " to " + lt + "*");
                L("  store " + lt + " " + sv + ", " + lt + "* " + payload);
                L("  store i8* " + cell + ", i8** " + reg);
            } else {
                L("  store " + lt + " " + sv + ", " + lt + "* " + reg);
            }
            if (curAsync) {
                locName.Add(s.sval);
                locType.Add(ty);
                locReg.Add(reg);
                locBox.Add(isBx);
                locIter.Add(false);
                locCell.Add("");
                locRef.Add(false);
                locOpaque.Add(false);
                ArmAsyncLocal(reg, ty, isBx);
            }
            // await result is already +1 owned; transfer ownership (no retain).
            // Its destination is armed before any remaining operand cleanup.
            TransferAwaitTemp(res);
            EmitTempReleases();
            return;
        }
        if (k == AK.ReturnStmt()) {
            ExprVal res = EmitAwait(s.a.a);
            if (curAsync) {
                // await result already +1; transfer as the coroutine result.
                if (curRetTy != null && curRetTy.sval != "void") {
                    res = ApplyUserConv(curRetTy, res, false);
                    if (!convApplied) { res = StrSlotConv(curRetTy, res); }
                    res = NarrowToDeclared(res, curRetTy);
                    string declLt = MapType(curRetTy);
                    string crv = Coerce(res, declLt);
                    res = new ExprVal(crv, curRetTy);
                }
                string lt = MapType(res.ty);
                EmitAsyncEpilogue();
                if (IsDecimal(res.ty)) {
                    DecimalResultStore("%ff", res);
                    string low = NT();
                    L("  " + low + " = load i64, i64* " + FrameGep("%ff", 6));
                    EmitAsyncComplete(low);
                } else { EmitAsyncComplete(ToI64(res.op, lt)); }
            } else {
                ReleaseLocalsFrom(0);
                if (curRet == "void") { L("  ret void"); }
                else {
                    ExprVal src = ApplyUserConv(curRetTy, res, false);
                    if (!convApplied) { src = StrSlotConv(curRetTy, res); }
                    L("  ret " + curRet + " " + Coerce(src, curRet));
                }
                term = true;
            }
            return;
        }
        Node e = s.a;
        if (e.kind == AK.AwaitExpr()) {
            ExprVal r0 = EmitAwait(e.a);
            EmitArcRelease(r0.op, r0.ty);
            return;
        }
        ExprVal r2 = EmitAwait(e.b.a);
        StoreTo(e.a, r2);
        // StoreTo retains the stored value; the await result was already +1,
        // so drop the extra reference to keep the count balanced.
        EmitArcRelease(r2.op, r2.ty);
    }
    void PrescanAsyncLocals(Node s, List<string> names, List<Node> types) {
        if (s == null) { return; }
        if (s.kind == AK.Lambda()) { return; }
        if (s.kind == AK.VarDecl() || (s.kind == AK.CatchClause() && s.sval != "" && s.type != null)) {
            s.ival = names.Count;
            names.Add(s.sval);
            Node ty = s.type; if (ty == null) { ty = MkType("int"); }
            types.Add(ty);
        }
        if (s.kind == AK.IsExpr() && s.sval != null && s.sval.Length > 0) {
            s.ival = names.Count;
            names.Add(s.sval);
            Node ty = s.type; if (ty == null) { ty = MkType("object"); }
            types.Add(ty);
        }
        int i = 0;
        while (i < s.kids.Count) { PrescanAsyncLocals(s.kids[i], names, types); i = i + 1; }
        PrescanAsyncLocals(s.a, names, types);
        PrescanAsyncLocals(s.b, names, types);
        PrescanAsyncLocals(s.c, names, types);
        PrescanAsyncLocals(s.d, names, types);
    }
    int CountAwaits(Node s) {
        if (s == null) { return 0; }
        int n = 0;
        if (s.kind == AK.AwaitExpr()) { n = 1; }
        int i = 0;
        while (i < s.kids.Count) { n = n + CountAwaits(s.kids[i]); i = i + 1; }
        n = n + CountAwaits(s.a) + CountAwaits(s.b) + CountAwaits(s.c) + CountAwaits(s.d);
        return n;
    }
    // Count the foreach statements of an async body (four frame slots each).
    int CountAsyncForeach(Node s) {
        if (s == null) { return 0; }
        int n = 0;
        if (s.kind == AK.ForeachStmt()) { n = 1; }
        int i = 0;
        while (i < s.kids.Count) { n = n + CountAsyncForeach(s.kids[i]); i = i + 1; }
        n = n + CountAsyncForeach(s.a) + CountAsyncForeach(s.b)
              + CountAsyncForeach(s.c) + CountAsyncForeach(s.d);
        return n;
    }
    // Hand every foreach its frame slots: s.ival = the collection slot, the
    // loop counter uses the next one, the element variable the one after,
    // and the A521 count snapshot the one after that.
    void AssignAsyncForeachSlots(Node s) {
        if (s == null) { return; }
        if (s.kind == AK.ForeachStmt()) {
            s.ival = asyncForeachBase + asyncForeachNext;
            asyncForeachNext = asyncForeachNext + 5;
        }
        int i = 0;
        while (i < s.kids.Count) { AssignAsyncForeachSlots(s.kids[i]); i = i + 1; }
        AssignAsyncForeachSlots(s.a);
        AssignAsyncForeachSlots(s.b);
        AssignAsyncForeachSlots(s.c);
        AssignAsyncForeachSlots(s.d);
    }
    void GenAsyncMethod(Node cls, Node m) {
        bool stat = IsStatic(m);
        int thisExtra = 0; if (!stat) { thisExtra = 1; }
        List<string> pn = new List<string>();
        List<Node> pt = new List<Node>();
        List<int> pr = new List<int>();
        int i = 0;
        while (i < m.kids.Count) {
            Node p = m.kids[i];
            if (p.kind == AK.Param()) {
                pn.Add(p.sval); pt.Add(p.type);
                pr.Add(p.ival);
            }
            i = i + 1;
        }
        List<string> lnames = new List<string>();
        List<Node> ltypes = new List<Node>();
        if (m.d != null) { PrescanAsyncLocals(m.d, lnames, ltypes); }
        int awaitCount = 0; if (m.d != null) { awaitCount = CountAwaits(m.d); }
        int header = 20; // 13 decimal; 14..17 error record; 18 owner chain; 19 invocation parent
        // 0=sched 1=sched_step 2=state 3=done 4=awaiter 5=awaiter_step
        // 6=result 7=cleanup 8=hcount 9=own_resume 10=cancel
        // 11=exc_val 12=exc_tid (the exception the coroutine carries out)
        int thisSlot = header;
        int paramBase = header + thisExtra;
        int localBase = paramBase + DecimalSlotOffset(pt, pn.Count);
        int subBase = localBase + DecimalSlotOffset(ltypes, lnames.Count);
        // Every foreach in the body needs four frame slots: the collection,
        // the loop counter, the element variable and the A521 count
        // snapshot. All four are stack
        // allocas (or plain expression values) in the ordinary lowering, and
        // a stack alloca is re-created on every resume -- the loop would
        // restart from zero (or read an uninitialized slot) after an await
        // inside the body. The frame is heap memory, so it survives the
        // suspension.
        int feCount = 0; if (m.d != null) { feCount = CountAsyncForeach(m.d); }
        int subSlots = 1;
        asyncExceptionBase = subBase + subSlots + feCount * 5;
        asyncExceptionDepth = 0;
        asyncCatchBindings = new List<Node>();
        // A catch snapshot and an outgoing propagation snapshot can both be
        // active at each nested try. Clones reuse slots after their scope ends.
        asyncOwnerMarkBase = asyncExceptionBase + 6 * (AsyncExceptionNesting(m.d) + 1);
        int nfields = asyncOwnerMarkBase + 2 * (AsyncExceptionNesting(m.d) + 1);
        asyncForeachBase = subBase + subSlots;
        asyncForeachNext = 0;
        if (m.d != null) { AssignAsyncForeachSlots(m.d); }
        usesAsync = true;
        string sym = MethodSym(cls.sval, m);
        string resumeSym = sym + "$resume";
        Node thisTy = MkType(cls.sval);
        int j = 0;
        // B-ID64：结果元素类型（Task<T> 的 T）供完成尾声的孤儿载荷释放用。
        curAsyncRetElem = AsyncElemTyOf(m.type);
        if (curAsyncRetElem != null && curAsyncRetElem.sval == "void") {
            curAsyncRetElem = null;
        }

        // ---- ramp: allocate frame, capture (retain) receiver+params, return ----
        StartFn();
        curClass = cls.sval;
        curHasThis = false;
        string sig = "define i8* @" + sym + "(";
        int np = 0;
        if (!stat) { sig = sig + "%" + cls.sval + "* %this"; np = 1; }
        j = 0;
        while (j < pn.Count) {
            if (np > 0) { sig = sig + ", "; }
            if (pr[j] == 1) {
                sig = sig + MapType(pt[j]) + "* %p" + j;
            } else {
                sig = sig + MapType(pt[j]) + " %p" + j;
            }
            np = np + 1;
            j = j + 1;
        }
        L(sig + ") {");
        L("entry:");
        string raw = NT();
        L("  " + raw + " = call i8* @__zan_co_frame_alloc(i64 " + (nfields * 8) + ")");
        L("  %ff = bitcast i8* " + raw + " to i64*");
        int h = 0;
        // Zero the whole frame so every owning (RC) local slot starts null:
        // the completion epilogue releases locals that the executed path may
        // never have assigned, and sub-task slots are read on resume.
        while (h < nfields) { L("  store i64 0, i64* " + FrameGep("%ff", h)); h = h + 1; }
        string orp = FrameGep("%ff", 9);
        string ori = NT(); L("  " + ori + " = ptrtoint void(i8*)* @" + resumeSym + " to i64");
        L("  store i64 " + ori + ", i64* " + orp);
        string clp = FrameGep("%ff", 7);
        string cli = NT(); L("  " + cli + " = ptrtoint void(i8*)* @" + sym + "$cleanup to i64");
        L("  store i64 " + cli + ", i64* " + clp);
        TaskFrameConfig(raw);
        TaskDiscardConfig(raw, AsyncElemTyOf(m.type));
        if (!stat) {
            string ti = ToI64("%this", MapType(thisTy));
            L("  store i64 " + ti + ", i64* " + FrameGep("%ff", thisSlot));
            EmitArcRetain("%this", thisTy);
        }
        j = 0;
        while (j < pn.Count) {
            string lt = MapType(pt[j]);
            if (pr[j] == 1) {
                string vi = NT();
                L("  " + vi + " = ptrtoint " + lt + "* %p" + j + " to i64");
                L("  store i64 " + vi + ", i64* " + FrameGep("%ff", paramBase + DecimalSlotOffset(pt, j)));
            } else {
                if (IsDecimal(pt[j])) {
                    DecimalFrameStore("%ff", paramBase + DecimalSlotOffset(pt, j), "%p" + j);
                    j = j + 1;
                    continue;
                }
                string vi = ToI64("%p" + j, lt);
                L("  store i64 " + vi + ", i64* " + FrameGep("%ff", paramBase + DecimalSlotOffset(pt, j)));
                EmitArcRetain("%p" + j, pt[j]);
            }
            j = j + 1;
        }
        L("  ret i8* " + raw);
        L("}");

        // ---- resume: dispatch on state, run body, spill/reload across await ----
        StartFn();
        PreScanLabelDepths(m.d, 0);
        curClass = cls.sval;
        curHasThis = !stat;
        curRet = "void";
        if (curAsyncRetElem != null) {
            curRetTy = curAsyncRetElem;
        } else {
            curRetTy = MkType("void");
        }
        curAsync = true;
        curAwaitSeq = 0;
        curResumeSym = resumeSym;
        curSubBase = subBase;
        curAsyncThis = !stat;
        curAsyncThisSlot = thisSlot;
        curAsyncThisTy = thisTy;
        asyncSlotReg = new List<string>();
        asyncDirectLocals = new List<string>();
        asyncSlotTy = new List<Node>();
        asyncSlotIdx = new List<int>();
        asyncBoxIdx = new List<int>();
        // A closure in this method may capture the method's locals: the names
        // it mentions have to live in a cell. Collected here because StartFn
        // resets the capture set.
        CollectCapturedNames(m.d, capNames);
        L("define void @" + resumeSym + "(i8* %fp) {");
        L("entry:");
        // Every alloca of the resume function must live in the entry block:
        // the function is re-entered on every resume, and an alloca in a
        // block that is not re-executed never allocates its stack slot (a
        // store into it would corrupt the stack).
        StringBuilder obody = body; StringBuilder oea = entryAllocas; bool oact = eaActive;
        body = new StringBuilder(); entryAllocas = new StringBuilder(); eaActive = true;
        L("  %ff = bitcast i8* %fp to i64*");
        if (!stat) {
            // receiver is immutable across the coroutine: load once, dominates all.
            string tr = NT();
            L("  " + tr + " = load i64, i64* " + FrameGep("%ff", thisSlot));
            L("  %this = inttoptr i64 " + tr + " to %" + cls.sval + "*");
        }
        j = 0;
        while (j < pn.Count) {
            string lt = MapType(pt[j]);
            if (pr[j] == 1) {
                string tr = NT();
                L("  " + tr + " = load i64, i64* " + FrameGep("%ff", paramBase + DecimalSlotOffset(pt, j)));
                string reg = NT();
                L("  " + reg + " = inttoptr i64 " + tr + " to " + lt + "*");
                locName.Add(pn[j]); locType.Add(pt[j]); locReg.Add(reg);
                locBox.Add(false); locIter.Add(false); locCell.Add(""); locRef.Add(true);
            } else {
                string reg = AddLocal(pn[j], pt[j]);
                MaterializeAsyncLocal(reg, lt, paramBase + DecimalSlotOffset(pt, j));
                asyncSlotReg.Add(reg); asyncSlotTy.Add(pt[j]); asyncSlotIdx.Add(paramBase + DecimalSlotOffset(pt, j));
            }
            j = j + 1;
        }
        asyncLocalRegs = new List<string>();
        asyncLocalBox = new List<bool>();
        asyncLocalTypes = new List<Node>();
        j = 0;
        while (j < lnames.Count) {
            string lt = MapType(ltypes[j]);
            string reg = "%v.async." + j;
            bool bx = ShouldBox(lnames[j]);
            if (bx) {
                // Captured by a closure: the local lives in a heap cell and the
                // spill slot keeps the *cell pointer* across a suspension (the
                // resume function is a fresh call with a fresh stack, so the
                // cell -- not the value -- is what has to survive).
                MaterializeAsyncLocal(reg, "i8*", localBase + DecimalSlotOffset(ltypes, j));
                asyncBoxIdx.Add(j);
                asyncSlotReg.Add(reg); asyncSlotTy.Add(MkType("string")); asyncSlotIdx.Add(localBase + DecimalSlotOffset(ltypes, j));
            } else {
                MaterializeAsyncLocal(reg, lt, localBase + DecimalSlotOffset(ltypes, j));
                asyncSlotReg.Add(reg); asyncSlotTy.Add(ltypes[j]); asyncSlotIdx.Add(localBase + DecimalSlotOffset(ltypes, j));
            }
            asyncLocalRegs.Add(reg);
            asyncLocalBox.Add(bx);
            asyncLocalTypes.Add(ltypes[j]);
            j = j + 1;
        }
        // The coroutine's trampoline handler: it catches what no try block
        // of the coroutine catches and lets the exception leave through the
        // frame (the awaiter re-throws it in its own context).
        asyncTryLbl = new List<int>();
        EmitAsyncEhPrologue();
        string st = NT();
        L("  " + st + " = load i64, i64* " + FrameGep("%ff", 2));
        // A CANCELLED frame aborts at its next resume: the C host sets the
        // frame's cancel flag (irgen_call.c: get_co_cancel_fn) and the resume
        // path checks it before running the body (irgen_async.c:
        // emit_async_cancel_check). The flag lives in the frame's slot 10.
        string cfl = NT();
        L("  " + cfl + " = load i64, i64* " + FrameGep("%ff", 10));
        string cfc = NT();
        L("  " + cfc + " = icmp ne i64 " + cfl + ", 0");
        int lCancel = NL();
        L("  br i1 " + cfc + ", label %L" + lCancel + ", label %co.dispatch");
        L("co.start:");
        term = false; curLbl = "co.start";
        ArmAsyncParameters();
        EmitAsyncReloadSlots();
        if (m.d != null) { GenStmt(m.d); }
        if (!term) { EmitAsyncEpilogue(); EmitAsyncComplete("0"); }
        L("co.dispatch:");
        term = false; curLbl = "co.dispatch";
        string sw = "  switch i64 " + st + ", label %co.start [ i64 0, label %co.start";
        int a2 = 1;
        while (a2 <= curAwaitSeq) { sw = sw + " i64 " + a2 + ", label %resume_" + a2; a2 = a2 + 1; }
        L(sw + " ]");
        // the trampoline's landing: the exception leaves the coroutine
        // through the frame -- the awaiter reads it and re-throws it in its
        // own context, where its own try blocks can catch it.
        Label(asyncTrampLbl);
        {
            string ev = NT(); L("  " + ev + " = load i8*, i8** @__exc_val");
            string evi = NT(); L("  " + evi + " = ptrtoint i8* " + ev + " to i64");
            L("  store i64 " + evi + ", i64* " + FrameGep("%ff", 11));
            string et = NT(); L("  " + et + " = load i8*, i8** @__exc_tid");
            string eti = NT(); L("  " + eti + " = ptrtoint i8* " + et + " to i64");
            L("  store i64 " + eti + ", i64* " + FrameGep("%ff", 12));
            string errorRaw = NT(); string errorRecord = NT();
            L("  " + errorRaw + " = getelementptr i64, i64* %ff, i64 14");
            L("  " + errorRecord + " = bitcast i64* " + errorRaw + " to %zan.exception*");
            L("  call void @zexc_take(%zan.exception* " + errorRecord + ", %zan.exception* @zexc_dispatch)");
            L("  store i8* null, i8** @__exc_val");
            L("  store i8* null, i8** @__exc_tid");
            EmitAsyncResultRelease(curAsyncRetElem);
            EmitAsyncEpilogue();
            EmitAsyncComplete("0");
        }
        // the cancelled path: the body does not run -- the frame releases what
        // it owns, marks itself done and wakes its awaiter. The frame itself
        // is NOT freed here: the awaiter reads the result and frees it.
        Label(lCancel);
        EmitAsyncResultRelease(curAsyncRetElem);
        EmitAsyncFrameRelease(!stat, thisTy, thisSlot, pn, pt, pr, paramBase, lnames, ltypes, localBase, false);
        EmitAsyncComplete("0");
        L("}");
        obody.Append(entryAllocas.ToString());
        obody.Append(body.ToString());
        body = obody; entryAllocas = oea; eaActive = oact;
        Node cleanupRetTy = curAsyncRetElem;
        curAsync = false;
        curAsyncThis = false;
        curAsyncThisTy = null;
        curAsyncRetElem = null;

        // ---- cleanup: release every owned rc slot from the heap frame and
        // free it. Called by @__zan_async_unwind when an exception longjmps
        // past this suspended frame (slots are saved at every suspension and
        // async throw, so the frame is authoritative).
        StartFn();
        L("define internal void @" + sym + "$cleanup(i8* %fp) {");
        L("entry:");
        L("  %ff = bitcast i8* %fp to i64*");
        EmitAsyncResultRelease(cleanupRetTy);
        EmitAsyncFrameRelease(!stat, thisTy, thisSlot, pn, pt, pr, paramBase, lnames, ltypes, localBase, true);
        L("  ret void");
        L("}");
    }

    // Release the values a frame owns (the receiver, the params and the
    // locals), reading them from the frame's slots -- the frame is the
    // authority across a suspension. `freeFrame` also releases the frame
    // itself: the cleanup function does, the cancelled path does not (its
    // awaiter still reads the result and frees the frame).
    void EmitAsyncFrameRelease(bool hasThis, Node thisTy, int thisSlot, List<string> pn, List<Node> pt, List<int> pr,
        int paramBase, List<string> lnames, List<Node> ltypes, int localBase, bool freeFrame) {
        if (hasThis && thisTy != null && ArcManaged(thisTy)) {
            string ctp = FrameGep("%ff", thisSlot);
            string cti = NT(); L("  " + cti + " = load i64, i64* " + ctp);
            L("  store i64 0, i64* " + ctp);
            EmitArcRelease(FromI64(cti, MapType(thisTy)), thisTy);
        }
        int j = 0;
        while (j < pn.Count) {
            if (pr[j] == 0 && (ArcManaged(pt[j]) || pt[j].ival >= 1)) {
                string cpp = FrameGep("%ff", paramBase + DecimalSlotOffset(pt, j));
                string cpi = NT(); L("  " + cpi + " = load i64, i64* " + cpp);
                L("  store i64 0, i64* " + cpp);
                EmitArcRelease(FromI64(cpi, MapType(pt[j])), pt[j]);
            }
            j = j + 1;
        }
        j = 0;
        while (j < lnames.Count) {
            if (ContainsInt(asyncBoxIdx, j)) {
                string spill = FrameGep("%ff", localBase + DecimalSlotOffset(ltypes, j));
                string celli = NT();
                L("  " + celli + " = load i64, i64* " + spill);
                L("  store i64 0, i64* " + spill);
                string cell = NT();
                L("  " + cell + " = inttoptr i64 " + celli + " to i8*");
                EmitCellRelease(cell);
            } else if (ArcManaged(ltypes[j]) || ltypes[j].ival >= 1) {
                string clp2 = FrameGep("%ff", localBase + DecimalSlotOffset(ltypes, j));
                string cli2 = NT(); L("  " + cli2 + " = load i64, i64* " + clp2);
                L("  store i64 0, i64* " + clp2);
                EmitArcRelease(FromI64(cli2, MapType(ltypes[j])), ltypes[j]);
            }
            j = j + 1;
        }
        if (freeFrame) { L("  call void @zexc_frame_free(i8* %fp)"); }
    }
    // Directory listing + exe-path helpers (Windows host). @zan_dir_list
    // returns the file names matching a glob pattern joined by '\n' (empty
    // string when the directory is missing); @zan_exe_dir returns the
    // directory containing the running executable.
}
