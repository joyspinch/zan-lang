using System;
using System.Collections.Generic;
namespace Zan;

partial class Irgen {
    // ---- indexing (string char / list element / array) ----
    ExprVal GenIndex(Node e, bool asPlace = false, bool hold = false) {
        ExprVal obj = GenExpr(e.a);
        if (hold && obj.ty != null && obj.ty.ival >= 1) { HoldArrayPlace(obj); }
        ExprVal idx = GenExpr(e.b);
        if (IsStr(obj.ty)) {
            // B-ID182：镜像 C 宿主 emit_string_elem_guard + emit_index_bounds_check
            // （irgen_generics.c:1883 / irgen_expr_access.c:1275）。旧实现零页
            // select + 裸 GEP：null 无报告无抛、越界读越界内存（真实 OOB read，
            // 探针 _scratch/nullprobe：宿主 try 内抛 NRE / IndexOutOfRange，
            // 自举端 no-throw）。① null 守卫（try 内抛 NullReferenceException，
            // try 外 soft 报告后落零页）；② len 越界守卫（负或 >= len → try 内
            // 抛 IndexOutOfRangeException，try 外 soft 报告 + 索引钳 0——宿主
            // 越界读返回 0 号字符，此口径双端一致）。
            string isn = NT();
            L("  " + isn + " = icmp eq i8* " + obj.op + ", null");
            EmitRuntimeCheckIf(e, isn,
            "null reference where a string/byte buffer is required (element access)");
            string zp = NT();
            L("  " + zp + " = getelementptr inbounds [16 x i8], [16 x i8]* @.zeropage, i64 0, i64 0");
            string bstr = NT();
            L("  " + bstr + " = select i1 " + isn + ", i8* " + zp + ", i8* " + obj.op);
            string sidx = NT();
            L("  " + sidx + " = select i1 " + isn + ", i64 0, i64 " + idx.op);
            bool isOpaque = false;
            if (e.a != null && e.a.kind == AK.Ident()) {
                int li = LocalIdx(e.a.sval);
                if (li >= 0 && li < locOpaque.Count && locOpaque[li]) {
                    isOpaque = true;
                }
            }
            string oob = "";
            if (isOpaque) {
                // Opaque string（来自 extern 调用如 calloc/malloc，无托管上界）：
                // 对齐 C 宿主（irgen_expr_access.c:1275 / expr_has_reliable_string_bounds）
                // 与写端（irgen_expr_assign.zan:309）：只检查 null/负数索引，不检查上界。
                string neg = NT();
                L("  " + neg + " = icmp slt i64 " + sidx + ", 0");
                oob = neg;
            } else {
                string ln = NT();
                L("  " + ln + " = call i64 @zstr_len(i8* " + obj.op + ")");
                string neg = NT();
                L("  " + neg + " = icmp slt i64 " + sidx + ", 0");
                string ge = NT();
                L("  " + ge + " = icmp sge i64 " + sidx + ", " + ln);
                string o = NT();
                L("  " + o + " = or i1 " + neg + ", " + ge);
                oob = o;
            }
            EmitRuntimeCheckIf(e, oob, "string index out of bounds");
            string safe = NT();
            L("  " + safe + " = select i1 " + oob + ", i64 0, i64 " + sidx);
            string p = NT();
            L("  " + p + " = getelementptr i8, i8* " + bstr + ", i64 " + safe);
            string ch = NT();
            L("  " + ch + " = load i8, i8* " + p);
            string z = NT();
            L("  " + z + " = zext i8 " + ch + " to i64");
            return new ExprVal(z, MkType("char"));
        }
        if (IsListType(obj.ty)) {
            string lnull = NT();
            L("  " + lnull + " = icmp eq i8* " + obj.op + ", null");
            EmitRuntimeCheckIf(e, lnull, "null reference where a List is required");
            int lchk = NL(); int ldo = NL(); int ldone = NL();
            string curB0 = curLbl;
            L("  br i1 " + lnull + ", label %L" + ldone + ", label %L" + lchk);
            Label(lchk);
            string lc = NT();
            L("  " + lc + " = call i64 @zlist_count(i8* " + obj.op + ")");
            string lneg = NT();
            L("  " + lneg + " = icmp slt i64 " + idx.op + ", 0");
            string lge = NT();
            L("  " + lge + " = icmp sge i64 " + idx.op + ", " + lc);
            string loob = NT();
            L("  " + loob + " = or i1 " + lneg + ", " + lge);
            EmitRuntimeCheckIf(e, loob, "list index out of bounds");
            string curB1 = curLbl;
            L("  br i1 " + loob + ", label %L" + ldone + ", label %L" + ldo);
            Label(ldo);
            string val = NT();
            L("  " + val + " = call i64 @zlist_get(i8* " + obj.op + ", i64 " + idx.op + ")");
            L("  br label %L" + ldone);
            Label(ldone);
            string slot = NT();
            L("  " + slot + " = phi i64 [ 0, %" + curB0 + " ], [ 0, %" + curB1 + " ], [ " + val + ", %L" + ldo + " ]");
            return FromSlot(slot, ListElem(obj.ty));
        }
        if (IsSpanType(obj.ty)) {
            Node el = SpanElem(obj.ty);
            string ity = SpanIty(el);
            string slen = NT();
            L("  " + slen + " = extractvalue { i8*, i64 } " + obj.op + ", 1");
            string soob = NT();
            L("  " + soob + " = icmp uge i64 " + idx.op + ", " + slen);
            EmitRuntimeCheckIf(e, soob, "span index out of bounds");
            string rty = MapType(el);
            int ldo = NL(); int lbad = NL(); int ldone = NL();
            L("  br i1 " + soob + ", label %L" + lbad + ", label %L" + ldo);
            Label(ldo);
            string ep = SpanElemPtr(obj.op, idx.op, ity);
            string loaded = "";
            if (IsStructTy(el)) {
                string dst = AllocStructObj(el.sval);
                InitNestedFields(dst, binder.FindType(el.sval));
                string dv = NT();
                L("  " + dv + " = load " + ity + ", " + ity + "* " + ep + ", align 1");
                L("  store " + ity + " " + dv + ", " + ity + "* " + dst);
                loaded = dst;
            } else {
                string v0 = NT();
                // align 1: a span may view a raw address (protocol framing, FFI
                // structs) whose elements are not naturally aligned.
                L("  " + v0 + " = load " + ity + ", " + ity + "* " + ep + ", align 1");
                if (ity == "double" || ity == "float") {
                    if (ity == "float") {
                        string w = NT();
                        L("  " + w + " = fpext float " + v0 + " to double");
                        loaded = w;
                    } else {
                        loaded = v0;
                    }
                } else if (ity == "i64" || IsDecimal(el)) {
                    loaded = v0;
                } else {
                    string w = NT();
                    string ext = "sext";
                    if (SpanZext(el)) { ext = "zext"; }
                    L("  " + w + " = " + ext + " " + ity + " " + v0 + " to i64");
                    loaded = w;
                }
            }
            string doLbl = curLbl;
            L("  br label %L" + ldone);
            Label(lbad);
            string zval = "0";
            if (rty == "double" || rty == "float") { zval = "0.0"; }
            else if (IsPtrLL(rty)) { zval = "null"; }
            else if (rty.StartsWith("{") || rty.StartsWith("%") || rty.StartsWith("<")) { zval = "zeroinitializer"; }
            if (IsStructTy(el)) {
                string zdst = AllocStructObj(el.sval);
                InitNestedFields(zdst, binder.FindType(el.sval));
                zval = zdst;
            }
            string badLbl = curLbl;
            L("  br label %L" + ldone);
            Label(ldone);
            string res = NT();
            L("  " + res + " = phi " + rty + " [ " + loaded + ", %" + doLbl + " ], [ " + zval + ", %" + badLbl + " ]");
            return new ExprVal(res, el);
        }
        if (IsDictType(obj.ty)) {
            string slot = NT();
            L("  " + slot + " = call i64 @zdict_get(i8* " + obj.op + ", i8* " + DictKeyOp(idx, obj.ty) + ", i64 " + DictKeyStrFlag(obj.ty) + ")");
            // A missing key is a runtime error, not a silent default: the C
            // host reports "Dict key not found in indexer read" through the
            // soft channel and hands back the zero value (TASKS.md A508).
            // TryGetValue is the correct exit for a may-miss lookup and does
            // not report; only the indexer read does.
            string hit = NT();
            L("  " + hit + " = call i64 @zdict_contains(i8* " + obj.op + ", i8* " + DictKeyOp(idx, obj.ty) + ", i64 " + DictKeyStrFlag(obj.ty) + ")");
            string missv = NT();
            L("  " + missv + " = icmp eq i64 " + hit + ", 0");
            int lmiss = NL(); int ldone = NL();
            L("  br i1 " + missv + ", label %L" + lmiss + ", label %L" + ldone);
            Label(lmiss);
            EmitSoftRuntimeError(e, "Dict key not found in indexer read");
            L("  br label %L" + ldone);
            Label(ldone);
            return FromSlot(slot, DictVal(obj.ty));
        }
        // A user class indexer: the parser desugars `this[int i]` into an
        // `op_index` method (and `op_index_set` for the setter). Call it --
        // treating the object as an array read a slot out of the object
        // header and answered with a garbage pointer (and the setter wrote
        // into the header: the class id / refcount!).
        // An array of user types (`Vec[]`) carries the element name in sval
        // and the levels in ival -- it must stay on the array path.
        Node ocls = null;
        if (obj.ty != null && obj.ty.ival == 0) { ocls = ClassOf(obj.ty); }
        if (ocls != null) {
            Node m = SelectIndexer(ocls, "op_index", OperandType(e.b, idx), null);
            if (m != null) { return EmitIndexCall(obj, m, idx); }
            diags.Error("indexing a value of type '" + obj.ty.sval
            + "' is not supported by the self-hosted compiler yet", e.line, e.col);
            return new ExprVal("0", MkType("int"));
        }
        Node element = ArrElemOf(obj.ty);
        if (element == null) { element = MkType("int"); }
        string storage = ArrayStorage(element);
        string bad;
        string place = CheckedArrayPlace(e, obj, idx.op, storage, hold && storage.StartsWith("%"), out bad);
        ExprVal value = LoadArrayElement(place, element, storage);
        if (!asPlace && storage.StartsWith("%")) {
            value = CopyStructValue(value);
            AddTemp(value.op, element);
        }
        return value;
    }

    ExprVal GenPlaceReceiver(Node e, bool hold = false) {
        if (e != null && e.kind == AK.Index()) { return GenIndex(e, true, hold); }
        if (e != null && e.kind == AK.Ident()) { return GenIdent(e, true); }
        return GenExpr(e);
    }

    // ---- new ----
    ExprVal GenNew(Node e) {
        Node ty = e.type;
        if (ty == null) {
            int i = 0;
            while (i < e.kids.Count) {
                Node it = e.kids[i];
                if (it.kind == AK.Assignment()) { GenExpr(it.b); }
                else { GenExpr(it); }
                i = i + 1;
            }
            return new ExprVal("null", MkType("object"));
        }
        if (e.ival != 1 && IsSpanType(ty)) {
            string baseOp = "null";
            string lenOp = "0";
            if (e.kids.Count > 0) {
                ExprVal b = GenExpr(e.kids[0]);
                string bty = MapType(b.ty);
                if (bty == "i64" || bty == "i32" || bty == "i16" || bty == "i8") {
                    string bp = NT();
                    L("  " + bp + " = inttoptr " + bty + " " + b.op + " to i8*");
                    baseOp = bp;
                } else if (bty != "i8*") {
                    string bp = NT();
                    L("  " + bp + " = bitcast " + bty + " " + b.op + " to i8*");
                    baseOp = bp;
                } else {
                    baseOp = b.op;
                }
            }
            if (e.kids.Count > 1) {
                ExprVal l = GenExpr(e.kids[1]);
                lenOp = l.op;
            }
            string iv0 = NT();
            L("  " + iv0 + " = insertvalue { i8*, i64 } undef, i8* " + baseOp + ", 0");
            string iv1 = NT();
            L("  " + iv1 + " = insertvalue { i8*, i64 } " + iv0 + ", i64 " + lenOp + ", 1");
            return new ExprVal(iv1, ty);
        }
        if (e.ival == 1) {
            // array new: T[n] as i64* (the elements follow the i64 length
            // header; a byte-sized element type takes one byte per element)
            // The RANK LIST of the created array (the parser records it):
            // the dims group's rank first, then the trailing groups. The
            // rank decides the shape: a rank of 1 is the plain array, a
            // higher rank is a rectangular one.
            string rkl = e.arrRanks;
            if (rkl == null) { rkl = ""; }
            int rank = Node.ArrRankAt(rkl, 0);
            int ndimkids = rank - 1;
            int nitems = e.kids.Count - ndimkids;
            if (nitems < 0) { nitems = 0; }
            bool init = nitems > 0;
            // the array type of the result: the element name with the rank
            // (the declared type of `new T[n]` does not carry the rank yet)
            // the element's NULLABLE flag rides along: `new int?[3]` is an
            // array of nullable ints, not a nullable array of ints
            // the rank list rides along too: it is what tells the codegen
            // that the array is rectangular (and how many dimensions it has)
            // B-ID216：开放类级类型参数先按当前实例化替后，再进数组描述符。
            // `new T[2]` 在 HolderS<string> 的克隆体里必须按 string 建描述符：
            // 描述符的接受谓词按元素类型生成，开放 T 不命中任何谓词分支、
            // accept 恒 false——任何引用型元素存储都被 zarr_store_compatible
            // 拒掉（"array element type mismatch" 鸣叫 + 槽保持 null 读回）。
            // 存/读两端（LoadField 的 SubstRecvTy）早已替后，只有 alloc 端漏。
            Node ety = ty;
            if (curInstCls != "" && curInstCls == curClass
            && curInstArgs != null && curInstArgs.Count > 0) {
                Node icls = binder.FindType(curInstCls);
                if (icls != null) { ety = SubstTP(ty, TParams(icls), curInstArgs); }
            }
            Node at = MkType(ety.sval); at.ival = Node.ArrRankCount(rkl); at.op = ety.op;
            at.kids = ety.kids;
            at.arrRanks = rkl;
            Node elemTy = ArrElemOf(at);
            if (rank > 1) {
                // a rectangular array: the header carries the dimensions
                return GenMdArrNew(e, at, elemTy, rank, ndimkids, nitems);
            }
            ExprVal nsz = new ExprVal("0", MkType("int"));
            if (e.b != null) { nsz = GenExpr(e.b); }
            else if (init) {
                // array initializer `new T[] { a, b, c }`: the element count
                // is the number of initializer expressions
                nsz = new ExprVal("" + nitems, MkType("int"));
            }
            string arr = ArrayAllocate(at, nsz.op);
            string storage = ArrayStorage(elemTy);
            if (init) {
                int jn = 0;
                while (jn < e.kids.Count) {
                    InitArrayElement(arr, "" + jn, elemTy, storage, GenExpr(e.kids[jn]));
                    jn = jn + 1;
                }
            } else if (storage == "i64" && IsStructTy(elemTy)) {
                L("  call void @" + elemTy.sval + "_initarr(i64* " + arr + ", i64 " + nsz.op + ")");
            }
            Node at2 = at;
            AddTemp(arr, at2);
            return new ExprVal(arr, at2);
        }
        if (IsListType(ty)) {
            string t = NT();
            int ownership = ListSlotOwnership(ListElem(ty));
            string meta = ListTypeMetadata(ty);
            L("  " + t + " = call i8* @zlist_new_typed(i64 " + ownership + ", i8* " + meta + ")");
            if (e.ival == 2) {
                // collection initializer: append each item
                int j = 0;
                while (j < e.kids.Count) {
                    ExprVal iv = GenExpr(e.kids[j]);
                    string sv = StructElemSlot(iv, ListElem(ty));
                    L("  call void @zlist_add(i8* " + t + ", i64 " + sv + ")");
                    j = j + 1;
                }
            }
            else if (e.kids.Count == 1) {
                // `new List<T>(src)`: a list argument is the copy constructor,
                // a 1D array argument copies each element into the new list,
                // and any other argument is a single-item collection initializer.
                ExprVal sv = GenExpr(e.kids[0]);
                Node le = ListElem(ty);
                if (IsListType(sv.ty)) {
                    L("  call void @zlist_copy(i8* " + t + ", i8* " + sv.op + ")");
                }
                else if (sv.ty != null && sv.ty.ival >= 1 && ArrRankOf(sv.ty) == 1
                         && (le == null || sv.ty.ival == le.ival + 1)) {
                    Node arrElem = ArrElemOf(sv.ty);
                    if (arrElem == null) { arrElem = le != null ? le : MkType("int"); }
                    string astorage = ArrayStorage(arrElem);
                    string isn = NT();
                    L("  " + isn + " = icmp eq i64* " + sv.op + ", null");
                    int lskip = NL(); int linit = NL(); int lcond = NL(); int lbody = NL();
                    L("  br i1 " + isn + ", label %L" + lskip + ", label %L" + linit);
                    Label(linit);
                    string alen = NT();
                    L("  " + alen + " = call i64 @zarr_len(i64* " + sv.op + ")");
                    string aidx = NT();
                    EA(aidx, "i64");
                    L("  store i64 0, i64* " + aidx);
                    L("  br label %L" + lcond);
                    Label(lcond);
                    string curi = NT();
                    L("  " + curi + " = load i64, i64* " + aidx);
                    string more = NT();
                    L("  " + more + " = icmp slt i64 " + curi + ", " + alen);
                    L("  br i1 " + more + ", label %L" + lbody + ", label %L" + lskip);
                    Label(lbody);
                    string aplace = ArrayPlace(sv.op, curi, astorage);
                    ExprVal aval = LoadArrayElement(aplace, arrElem, astorage);
                    string aslot = StructElemSlot(aval, le);
                    L("  call void @zlist_add(i8* " + t + ", i64 " + aslot + ")");
                    string nexti = NT();
                    L("  " + nexti + " = add i64 " + curi + ", 1");
                    L("  store i64 " + nexti + ", i64* " + aidx);
                    L("  br label %L" + lcond);
                    Label(lskip);
                }
                else {
                    string ss = StructElemSlot(sv, le);
                    L("  call void @zlist_add(i8* " + t + ", i64 " + ss + ")");
                }
            }
            else if (e.kids.Count > 1) {
                // `new List<T>(a, b, c)`: the items of a collection initializer
                int j = 0;
                while (j < e.kids.Count) {
                    ExprVal iv = GenExpr(e.kids[j]);
                    string sv = StructElemSlot(iv, ListElem(ty));
                    L("  call void @zlist_add(i8* " + t + ", i64 " + sv + ")");
                    j = j + 1;
                }
            }
            AddTemp(t, ty);
            return new ExprVal(t, ty);
        }
        if (IsDictType(ty)) {
            string t = NT();
            string ow = "" + ListSlotOwnership(DictVal(ty));
            string meta = DictTypeMetadata(ty);
            L("  " + t + " = call i8* @zdict_new_typed(i64 " + ow + ", i8* " + meta + ")");
            if (e.ival == 2) {
                // collection initializer: each item is a key/value pair.
                int j = 0;
                while (j < e.kids.Count) {
                    Node item = e.kids[j];
                    if (item.kids.Count >= 2) {
                        ExprVal key = GenExpr(item.kids[0]);
                        ExprVal val = GenExpr(item.kids[1]);
                        string sv = StructElemSlot(val, DictVal(ty));
                        L("  call void @zdict_set(i8* " + t + ", i8* " + DictKeyOp(key, ty) + ", i64 " + sv + ", i64 " + DictKeyStrFlag(ty) + ")");
                    }
                    j = j + 1;
                }
            }
            AddTemp(t, ty);
            return new ExprVal(t, ty);
        }
        if (IsSbType(ty)) {
            string t = NT();
            L("  " + t + " = call i8* @zsb_new()");
            AddTemp(t, ty);
            return new ExprVal(t, ty);
        }
        // object
        string cn = ty.sval;
        // hardware vectors are first-class values: `new Vector128()` /
        // `new Vector256()` yields zeroinitializer and the field stores that
        // follow (V0..V3 = 0 / -1) fold into the value via the ordinary
        // constant paths — no heap allocation, no dtor
        if (cn == "Vector128" || cn == "Vector256") {
            return new ExprVal("zeroinitializer", ty);
        }
        if (cn == "object") {
            // `new object()`: a bare heap object with no fields (the C host's
            // builtin object class). It is a real instance -- `o != null` holds.
            string oraw = NT();
            L("  " + oraw + " = call i8* @zalloc(i64 8, i8* bitcast (void (i8*)* @__zan_object_dtor to i8*), i8* null)");
            AddTemp(oraw, ty);
            return new ExprVal(oraw, ty);
        }
        Node cls = binder.FindType(cn);
        if (cls == null) {
            if (IsErasedType(ty)) { return new ExprVal("0", ty); }
            return new ExprVal("null", ty);
        }
        DemandNewType(ty);
        string szp = NT();
        L("  " + szp + " = getelementptr %" + cn + ", %" + cn + "* null, i32 1");
        string szi = NT();
        L("  " + szi + " = ptrtoint %" + cn + "* " + szp + " to i64");
        string raw = NT();
        L("  " + raw + " = call i8* @zalloc(i64 " + szi + ", i8* bitcast (void (i8*)* @" + cn + "_dtor to i8*), i8* bitcast (i8** @__tid_" + cn + " to i8*))");
        string obj = NT();
        L("  " + obj + " = bitcast i8* " + raw + " to %" + cn + "*");
        // a struct-typed field points at a nested instance: allocate it
        InitNestedFields(obj, cls);
        // a struct has NO vtable slot (FieldBase: value types keep slot 0
        // for their first field) -- an interface-implementing struct used
        // to get the vtable pointer written over its first field
        if (IsPolyClass(cls) && cls.kind != AK.StructDecl()) {
            List<string> vslots = new List<string>();
            CollectVSlots(cls, vslots);
            // B-ID218: an instantiation whose virtual bodies mention the type
            // parameters dispatches through its own vtable -- the shared one
            // points at the erased bodies (`o is T` folds to constant false)
            string vtSym = SpecVtableSym(cls, ty);
            if (vtSym == "") { vtSym = cn + "_vtable"; }
            string vtp0 = NT();
            L("  " + vtp0 + " = getelementptr %" + cn + ", %" + cn + "* " + obj + ", i32 0, i32 0");
            L("  store i8* bitcast ([" + vslots.Count + " x i8*]* @" + vtSym + " to i8*), i8** " + vtp0);
        }
        // The constructor: with an object initializer (ival == 2) the kids are
        // `Field = value` pairs, not ctor args, so only a parameterless ctor
        // is invoked and the field stores follow. Otherwise the arguments
        // pick the overload (arity fit plus argument-type score; defaults
        // fill omitted trailing args). When no constructor matches, the
        // instance field initializers run at the allocation site -- that is
        // what the implicit parameterless constructor of the C host does.
        if (e.ival == 2) {
            Node pctor = binder.FindCtorArity(cls, 0);
            if (pctor != null) {
                L("  call void @" + CtorSym(cn, pctor) + "(%" + cn + "* " + obj + ")");
            }
            else if (HasChainFieldInits(cls)) {
                // B-ID216: a generic instantiation runs the specialized
                // helper -- the shared one erases `new T[n]` and the array
                // descriptor ends up rejecting every reference-element store
                L("  call void @" + SpecFieldInitsSym(cls.sval, ty) + "(%" + cn + "* " + obj + ")");
            }
        }
        else {
            Node ctor = ResolveCtor(cls, e);
            if (ctor != null) {
                List<Node> cargs = OrderArgs(ctor, e);
                // A generic class's constructor sees the CONCRETE type
                // arguments: a delegate-typed parameter (`LabelOf<T>`) must
                // carry them, or the lambda handed in gets an erased
                // parameter type and its body silently does nothing.
                List<string> ctps = TParams(cls);
                bool ctorSpec = (ctps.Count > 0 && ty != null && ty.ival == 0
                && ty.kids.Count == ctps.Count);
                string args = "%" + cn + "* " + obj;
                int i = 0;
                while (i < cargs.Count) {
                    Node pty = CtorParamType(ctor, i);
                    // The argument is INFERRED with the concrete type (a
                    // delegate-typed parameter carries the class's type
                    // arguments, so a lambda gets a real parameter type),
                    // but the CALL keeps the erased shape: the constructor
                    // body is shared, so it takes the value in a slot.
                    Node epty = pty;
                    if (ctorSpec) { epty = SubstTP(pty, ctps, ty.kids); }
                    // The CALL matches the constructor that actually runs: a
                    // specialized constructor takes the CONCRETE parameter
                    // types (the C host's find_generic_ctor), the shared one
                    // the erased shapes.
                    Node cty = pty;
                    if (ctorSpec) { cty = epty; }
                    if (IsRefParam(ctor, i) && cargs[i] != null
                    && cargs[i].kind == AK.OutArg()) {
                        string addr;
                        if (cargs[i].type != null) { addr = NewOutLocal(cargs[i]); }
                        else { addr = RefPlacePtr(cargs[i].a, cty); }
                        args = args + ", " + MapType(cty) + "* " + addr;
                        i = i + 1;
                        continue;
                    }
                    ExprVal av = GenArgExpr(cargs[i], epty);
                    args = args + ", " + MapType(cty) + " " + CallArg(av, cty, false);
                    i = i + 1;
                }
                string ctorSym = CtorSym(cn, ctor);
                if (ctorSpec) { ctorSym = SpecCtorSym(cn, ctor, ty); }
                L("  call void @" + ctorSym + "(" + args + ")");
            }
            else {
                int argc = e.kids.Count;
                // The C host's checker accepts the call when a constructor's
                // arity range covers the arguments; its code generator matches
                // the parameter count exactly. A `params` array is the one
                // case the checker lets through and the code generator
                // refuses.
                bool checkerOk = false;
                int i = 0;
                while (i < cls.kids.Count) {
                    if (cls.kids[i].kind == AK.CtorDecl() && !IsStatic(cls.kids[i])
                    && CtorArityFits(cls.kids[i], argc)) { checkerOk = true; }
                    i = i + 1;
                }
                // A STRUCT always has an implicit parameterless constructor:
                // the C host's checker skips the constructor check for struct
                // types altogether (`type->kind != TYPE_CLASS` ->
                // return, src/compiler/checker.c: check_ctor_available), so
                // `new Matrix4x4()` -- a struct whose only constructor takes
                // 16 floats -- is legal there and yields a zeroed instance.
                // Only a CLASS has the "no implicit parameterless one" rule.
                if (cls.kind == AK.StructDecl()) {
                    checkerOk = false;
                }
                else if (checkerOk) {
                    diags.Error("[E2017] no constructor of '" + cn + "' accepts " + argc
                    + (argc == 1 ? " argument" : " arguments"), e.line, e.col);
                }
                else if (binder.FindCtor(cls) != null) {
                    diags.Error("[E2018] no constructor of '" + cn + "' takes " + argc
                    + " argument(s); a class that declares constructors has no implicit parameterless one",
                    e.line, e.col);
                }
                else if (argc > 0) {
                    diags.Error("[E2017] no constructor of '" + cn + "' accepts " + argc
                    + " arguments", e.line, e.col);
                }
                Node bcls = BaseClassOf(cls);
                Node bctor = null;
                Node bctorCls = null;
                Node curBase = bcls;
                while (curBase != null) {
                    bctor = binder.FindCtorArity(curBase, 0);
                    if (bctor != null) {
                        bctorCls = curBase;
                        break;
                    }
                    if (binder.FindCtor(curBase) != null) {
                        break;
                    }
                    curBase = BaseClassOf(curBase);
                }
                if (bctor != null && bctorCls != null) {
                    Node c = cls;
                    while (c != null && c != bctorCls) {
                        string cop = obj;
                        if (c.sval != cn) {
                            cop = NT();
                            L("  " + cop + " = bitcast %" + cn + "* " + obj + " to %" + c.sval + "*");
                        }
                        EmitFieldInits(c, cop);
                        c = BaseClassOf(c);
                    }
                    string bthis = obj;
                    if (bctorCls.sval != cn) {
                        bthis = NT();
                        L("  " + bthis + " = bitcast %" + cn + "* " + obj + " to %" + bctorCls.sval + "*");
                    }
                    L("  call void @" + CtorSym(bctorCls.sval, bctor) + "(%" + bctorCls.sval + "* " + bthis + ")");
                } else if (HasChainFieldInits(cls)) {
                    // B-ID216: specialized helper for a generic instantiation
                    // (see the object-initializer branch above)
                    L("  call void @" + SpecFieldInitsSym(cls.sval, ty) + "(%" + cn + "* " + obj + ")");
                }
            }
        }
        // object initializer: store each `Field = value` into the instance
        if (e.ival == 2) { ApplyObjInit(e, obj, ty, cls, cn); }
        // preserve generic type arguments (ty may carry <...>) for the result
        AddTemp(obj, ty);
        return new ExprVal(obj, ty);
    }

    // The `{ Field = value, Coll = { items } }` items of an initializer,
    // applied to the object `obj` (type `ty`, class `cls` named `cn`) --
    // shared by `new T { ... }` and the factory continuation
    // `T.Make() { ... }` (CallInit).
    void ApplyObjInit(Node e, string obj, Node ty, Node cls, string cn) {
        int j = 0;
        while (j < e.kids.Count) {
            Node it = e.kids[j];
            if (it.kind == AK.Assignment() && it.a != null
            && it.a.kind == AK.Ident()) {
                if (it.b != null && it.b.kind == AK.NewExpr() && it.b.ival == 2
                && it.b.type == null) {
                    ExprVal collObj = null;
                    if (FindMethodUp(cls, "get_" + it.a.sval) != null) {
                        collObj = EmitInstanceCall(new ExprVal(obj, ty), cn, "get_" + it.a.sval, new Node(AK.Call()));
                    } else {
                        collObj = LoadField(obj, ty, it.a.sval);
                    }
                    if (collObj != null && collObj.ty != null) {
                        Node ccls = ClassOf(collObj.ty);
                        int k = 0;
                        while (k < it.b.kids.Count) {
                            if (IsListType(collObj.ty)) {
                                ExprVal itemVal = GenExpr(it.b.kids[k]);
                                string sv = StructElemSlot(itemVal, ListElem(collObj.ty));
                                L("  call void @zlist_add(i8* " + collObj.op + ", i64 " + sv + ")");
                            } else if (IsDictType(collObj.ty)) {
                                Node pair = it.b.kids[k];
                                if (pair.kids.Count >= 2) {
                                    ExprVal key = GenExpr(pair.kids[0]);
                                    ExprVal val = GenExpr(pair.kids[1]);
                                    string sv = StructElemSlot(val, DictVal(collObj.ty));
                                    L("  call void @zdict_set(i8* " + collObj.op + ", i8* " + DictKeyOp(key, collObj.ty) + ", i64 " + sv + ", i64 " + DictKeyStrFlag(collObj.ty) + ")");
                                } else if (k + 1 < it.b.kids.Count) {
                                    ExprVal key = GenExpr(it.b.kids[k]);
                                    ExprVal val = GenExpr(it.b.kids[k + 1]);
                                    string sv = StructElemSlot(val, DictVal(collObj.ty));
                                    L("  call void @zdict_set(i8* " + collObj.op + ", i8* " + DictKeyOp(key, collObj.ty) + ", i64 " + sv + ", i64 " + DictKeyStrFlag(collObj.ty) + ")");
                                    k = k + 1;
                                }
                            } else if (ccls != null && FindMethodUp(ccls, "Add") != null) {
                                Node callN = new Node(AK.Call());
                                callN.Add(it.b.kids[k]);
                                EmitInstanceCall(collObj, collObj.ty.sval, "Add", callN);
                            }
                            k = k + 1;
                        }
                    }
                    j = j + 1;
                    continue;
                }
                // A Binding-typed field takes a fresh Binding object, not
                // the raw value (the C host's emit_binding_value): the
                // initializer's value replaces the one the constructor put
                // into the slot.
                Node fty0 = FieldType(cls, it.a.sval);
                if (it.a.sval == "target") {
                    CheckBorrowedBindingValue(BindingFieldOwner(cls, it.a.sval), it.a.sval, it.b);
                }
                ExprVal fv = null;
                if (fty0 != null && IsBindingTy(fty0)) {
                    fv = GenBindingValue(it.b, fty0);
                }
                if (fv == null) { fv = GenExpr(it.b); }
                // A property in the initializer goes through its setter:
                // `new A { Mixed = 50 }` calls `set_Mixed(50)`. Storing it
                // as a field wrote into a field slot that does not exist
                // (index -1 -> invalid IR).
                if (EmitPropSet(obj, ty, it.a.sval, fv)) { j = j + 1; continue; }
                StoreField(obj, cn, it.a.sval, fv);
            }
            j = j + 1;
        }
    }

    // `Factory() { Field = v, Coll = { ... } }`: the call's result receives
    // the initializer (the host's construct_new factory path) -- every item
    // acts on the ONE evaluated object.
    ExprVal GenCallInit(Node e) {
        ExprVal r = GenExpr(e.a);
        Node cls = ClassOf(r.ty);
        if (cls == null || r.ty == null) {
            diags.Error("[E3022] object initializer can only continue a call that returns a class instance", e.line, e.col);
            return r;
        }
        string cn = cls.sval;
        // a fresh alias of the object: the call result is a statement temp,
        // and a receiver that IS a temp is handed over (and released) by the
        // member calls the items make -- `new T { }` registers its object
        // only after the items, so it never meets this
        string obj = NT();
        L("  " + obj + " = bitcast " + MapType(r.ty) + " " + r.op + " to %" + cn + "*");
        ApplyObjInit(e, obj, r.ty, cls, cn);
        return r;
    }

    int CtorParamCount(Node ctor) {
        int n = 0; int i = 0;
        while (i < ctor.kids.Count) {
            if (ctor.kids[i].kind == AK.Param()) { n = n + 1; }
            i = i + 1;
        }
        return n;
    }

    Node CtorParamType(Node ctor, int argIdx) {
        int seen = 0; int i = 0;
        while (i < ctor.kids.Count) {
            if (ctor.kids[i].kind == AK.Param()) {
                if (seen == argIdx) { return ctor.kids[i].type; }
                seen = seen + 1;
            }
            i = i + 1;
        }
        return MkType("int");
    }

    void EmitExceptionThrow(string tidName, string msg) {
        string raw = NT();
        L("  " + raw + " = call i8* @zalloc(i64 24, i8* bitcast (void (i8*)* @__zan_object_dtor to i8*), i8* bitcast (i8** @__tid_" + tidName + " to i8*))");
        string objArr = NT();
        L("  " + objArr + " = bitcast i8* " + raw + " to i8**");
        string f0 = NT();
        L("  " + f0 + " = getelementptr i8*, i8** " + objArr + ", i64 0");
        L("  store i8* null, i8** " + f0);
        ExprVal ms = GenStr(msg);
        string f1 = NT();
        L("  " + f1 + " = getelementptr i8*, i8** " + objArr + ", i64 1");
        L("  store i8* " + ms.op + ", i8** " + f1);
        string f2 = NT();
        L("  " + f2 + " = getelementptr i8*, i8** " + objArr + ", i64 2");
        L("  store i8* null, i8** " + f2);
        L("  store i8* bitcast (i8** @__tid_" + tidName + " to i8*), i8** @__exc_tid");
        L("  store i8* " + raw + ", i8** @__exc_val");
        L("  call void @zexc_publish(i8* " + raw + ", i8* bitcast (i8** @__tid_" + tidName + " to i8*), i64 1, i64 1)");
        EmitRaise();
    }

    void EmitCastThrow(string msg) {
        EmitExceptionThrow("InvalidCastException", msg);
    }

}
