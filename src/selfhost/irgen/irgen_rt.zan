using System;
using System.Collections.Generic;
namespace Zan;

partial class Irgen {
    void EmitListRuntime() {
        EmitListRuntimeCore();
        EmitListRuntimeOps();
        EmitListReflectionRuntime();
    }

    /// %zlist type + dtor/reverse/new.
    void EmitListRuntimeCore() {
        // Keep the count, capacity, slots, and ownership offsets stable.
        H("%zlist = type { i64, i64, i64*, i64, i8* }");
        H("define void @zlist_dtor(i8* %p) {");
        H("entry:");
        H("  %l = bitcast i8* %p to %zlist*");
        H("  %optr = getelementptr %zlist, %zlist* %l, i32 0, i32 3");
        H("  %owns = load i64, i64* %optr");
        H("  %noown = icmp eq i64 %owns, 0");
        H("  br i1 %noown, label %freedata, label %loopinit");
        H("loopinit:");
        H("  %cptr = getelementptr %zlist, %zlist* %l, i32 0, i32 0");
        H("  %count = load i64, i64* %cptr");
        H("  %dptr = getelementptr %zlist, %zlist* %l, i32 0, i32 2");
        H("  %data = load i64*, i64** %dptr");
        H("  %ia = alloca i64");
        H("  store i64 0, i64* %ia");
        H("  br label %cond");
        H("cond:");
        H("  %i = load i64, i64* %ia");
        H("  %done = icmp sge i64 %i, %count");
        H("  br i1 %done, label %freedata, label %body");
        H("body:");
        H("  %slot = getelementptr i64, i64* %data, i64 %i");
        H("  %ev = load i64, i64* %slot");
        H("  %ep = inttoptr i64 %ev to i8*");
        H("  call void @zslot_release(i8* %ep, i64 %owns)");
        H("  %ni = add i64 %i, 1");
        H("  store i64 %ni, i64* %ia");
        H("  br label %cond");
        H("freedata:");
        H("  %dptr2 = getelementptr %zlist, %zlist* %l, i32 0, i32 2");
        H("  %data2 = load i64*, i64** %dptr2");
        H("  %datai8 = bitcast i64* %data2 to i8*");
        H("  call void @free(i8* %datai8)");
        H("  ret void");
        H("}");
        H("define void @zlist_reverse(i8* %p) {");
        H("entry:");
        H("  %l = bitcast i8* %p to %zlist*");
        H("  %cptr = getelementptr %zlist, %zlist* %l, i32 0, i32 0");
        H("  %count = load i64, i64* %cptr");
        H("  %dptr = getelementptr %zlist, %zlist* %l, i32 0, i32 2");
        H("  %data = load i64*, i64** %dptr");
        H("  %lo = alloca i64");
        H("  store i64 0, i64* %lo");
        H("  %hi = alloca i64");
        H("  %h0 = sub i64 %count, 1");
        H("  store i64 %h0, i64* %hi");
        H("  br label %cond");
        H("cond:");
        H("  %lv = load i64, i64* %lo");
        H("  %hv = load i64, i64* %hi");
        H("  %c = icmp slt i64 %lv, %hv");
        H("  br i1 %c, label %body, label %done");
        H("body:");
        H("  %ls = getelementptr i64, i64* %data, i64 %lv");
        H("  %hs = getelementptr i64, i64* %data, i64 %hv");
        H("  %a = load i64, i64* %ls");
        H("  %b = load i64, i64* %hs");
        H("  store i64 %b, i64* %ls");
        H("  store i64 %a, i64* %hs");
        H("  %l1 = add i64 %lv, 1");
        H("  store i64 %l1, i64* %lo");
        H("  %h1 = sub i64 %hv, 1");
        H("  store i64 %h1, i64* %hi");
        H("  br label %cond");
        H("done:");
        H("  ret void");
        H("}");
        H("define i8* @zlist_new(i64 %owns) {");
        H("  %p = call i8* @zlist_new_typed(i64 %owns, i8* null)");
        H("  ret i8* %p");
        H("}");
        H("define i8* @zlist_new_typed(i64 %owns, i8* %meta) {");
        H("  %p = call i8* @zalloc(i64 40, i8* bitcast (void (i8*)* @zlist_dtor to i8*), " + ContainerCid("List") + ")");
        H("  %l = bitcast i8* %p to %zlist*");
        H("  %c = getelementptr %zlist, %zlist* %l, i32 0, i32 0");
        H("  store i64 0, i64* %c");
        H("  %cap = getelementptr %zlist, %zlist* %l, i32 0, i32 1");
        H("  store i64 0, i64* %cap");
        H("  %d = getelementptr %zlist, %zlist* %l, i32 0, i32 2");
        H("  store i64* null, i64** %d");
        H("  %op = getelementptr %zlist, %zlist* %l, i32 0, i32 3");
        H("  store i64 %owns, i64* %op");
        H("  %type = getelementptr %zlist, %zlist* %l, i32 0, i32 4");
        H("  store i8* %meta, i8** %type");
        H("  ret i8* %p");
        H("}");
    }

    void EmitListReflectionRuntime() {
        H("define internal i8* @zlist_typeinfo(i8* %p) {");
        H("  %l = bitcast i8* %p to %zlist*");
        H("  %slot = getelementptr %zlist, %zlist* %l, i32 0, i32 4");
        H("  %meta = load i8*, i8** %slot");
        H("  ret i8* %meta");
        H("}");
        H("define internal i1 @zlist_matches_type(i8* %p, i8* %meta) {");
        H("  %cid = call i8* @__zan_class_id(i8* %p)");
        string listCid = IsContainerType("List") ? "bitcast (i8** @__tid_List to i8*)" : "null";
        H("  %list = icmp eq i8* %cid, " + listCid);
        H("  br i1 %list, label %check, label %miss");
        H("check:");
        H("  %actual = call i8* @zlist_typeinfo(i8* %p)");
        H("  %same = icmp eq i8* %actual, %meta");
        H("  ret i1 %same");
        H("miss:");
        H("  ret i1 false");
        H("}");
        H("define internal i64 @zlist_reflection_kind(i8* %p) {");
        H("  %meta = call i8* @zlist_typeinfo(i8* %p)");
        H("  %missing = icmp eq i8* %meta, null");
        H("  br i1 %missing, label %miss, label %read");
        H("read:");
        H("  %raw = getelementptr i8, i8* %meta, i64 -136");
        H("  %slot = bitcast i8* %raw to i64*");
        H("  %kind = load i64, i64* %slot");
        H("  ret i64 %kind");
        H("miss:");
        H("  ret i64 0");
        H("}");
        H("define internal i8* @zlist_reflection_new(i8* %meta) {");
        H("  %raw = getelementptr i8, i8* %meta, i64 -128");
        H("  %slot = bitcast i8* %raw to i64*");
        H("  %owns = load i64, i64* %slot");
        H("  %valid = icmp sge i64 %owns, 0");
        H("  br i1 %valid, label %make, label %miss");
        H("make:");
        H("  %list = call i8* @zlist_new_typed(i64 %owns, i8* %meta)");
        H("  ret i8* %list");
        H("miss:");
        H("  ret i8* null");
        H("}");
        H("define internal i64 @zlist_reflection_add(i8* %p, i64 %value, i64 %source) {");
        H("  %kind = call i64 @zlist_reflection_kind(i8* %p)");
        H("  %ref = icmp uge i64 %kind, 3");
        H("  br i1 %ref, label %reference, label %scalar");
        H("scalar:");
        H("  %supported = icmp ne i64 %kind, 0");
        H("  %same = icmp eq i64 %kind, %source");
        H("  %valid = and i1 %supported, %same");
        H("  br i1 %valid, label %add, label %miss");
        H("reference:");
        H("  %source_ref = icmp uge i64 %source, 3");
        H("  br i1 %source_ref, label %check_null, label %miss");
        H("check_null:");
        H("  %nil = icmp eq i64 %value, 0");
        H("  br i1 %nil, label %add, label %check_ref");
        H("check_ref:");
        H("  %meta = call i8* @zlist_typeinfo(i8* %p)");
        H("  %raw = getelementptr i8, i8* %meta, i64 -120");
        H("  %slot = bitcast i8* %raw to i1 (i8*)**");
        H("  %accepts = load i1 (i8*)*, i1 (i8*)** %slot");
        H("  %ptr = inttoptr i64 %value to i8*");
        H("  %ok = call i1 %accepts(i8* %ptr)");
        H("  br i1 %ok, label %add, label %miss");
        H("add:");
        H("  call void @zlist_add(i8* %p, i64 %value)");
        H("  ret i64 1");
        H("miss:");
        H("  ret i64 0");
        H("}");
    }

    /// zlist add/get/set/count/removeat/clear.
    void EmitListRuntimeOps() {
        H("define void @zlist_add(i8* %p, i64 %v) {");
        H("entry:");
        H("  %l = bitcast i8* %p to %zlist*");
        H("  %cptr = getelementptr %zlist, %zlist* %l, i32 0, i32 0");
        H("  %count = load i64, i64* %cptr");
        H("  %capptr = getelementptr %zlist, %zlist* %l, i32 0, i32 1");
        H("  %cap = load i64, i64* %capptr");
        H("  %full = icmp sge i64 %count, %cap");
        H("  br i1 %full, label %grow, label %st");
        H("grow:");
        H("  %nc0 = mul i64 %cap, 2");
        H("  %isz = icmp eq i64 %nc0, 0");
        H("  %nc = select i1 %isz, i64 4, i64 %nc0");
        H("  %dptr = getelementptr %zlist, %zlist* %l, i32 0, i32 2");
        H("  %olddata = load i64*, i64** %dptr");
        H("  %oldi8 = bitcast i64* %olddata to i8*");
        H("  %bytes = mul i64 %nc, 8");
        H("  %newi8 = call i8* @realloc(i8* %oldi8, i64 %bytes)");
        H("  %newdata = bitcast i8* %newi8 to i64*");
        H("  store i64* %newdata, i64** %dptr");
        H("  store i64 %nc, i64* %capptr");
        H("  br label %st");
        H("st:");
        H("  %dptr2 = getelementptr %zlist, %zlist* %l, i32 0, i32 2");
        H("  %data = load i64*, i64** %dptr2");
        H("  %slot = getelementptr i64, i64* %data, i64 %count");
        H("  store i64 %v, i64* %slot");
        H("  %ncount = add i64 %count, 1");
        H("  store i64 %ncount, i64* %cptr");
        H("  %optr = getelementptr %zlist, %zlist* %l, i32 0, i32 3");
        H("  %owns = load i64, i64* %optr");
        H("  %doret = icmp ne i64 %owns, 0");
        H("  br i1 %doret, label %doretain, label %done");
        H("doretain:");
        H("  %vp = inttoptr i64 %v to i8*");
        H("  call void @zslot_retain(i8* %vp, i64 %owns)");
        H("  br label %done");
        H("done:");
        H("  ret void");
        H("}");
        H("define i64 @zlist_get(i8* %p, i64 %i) {");
        H("  %l = bitcast i8* %p to %zlist*");
        H("  %dptr = getelementptr %zlist, %zlist* %l, i32 0, i32 2");
        H("  %data = load i64*, i64** %dptr");
        H("  %slot = getelementptr i64, i64* %data, i64 %i");
        H("  %v = load i64, i64* %slot");
        H("  ret i64 %v");
        H("}");
        H("define void @zlist_set(i8* %p, i64 %i, i64 %v) {");
        H("entry:");
        H("  %l = bitcast i8* %p to %zlist*");
        H("  %dptr = getelementptr %zlist, %zlist* %l, i32 0, i32 2");
        H("  %data = load i64*, i64** %dptr");
        H("  %slot = getelementptr i64, i64* %data, i64 %i");
        H("  %old = load i64, i64* %slot");
        H("  store i64 %v, i64* %slot");
        H("  %optr = getelementptr %zlist, %zlist* %l, i32 0, i32 3");
        H("  %owns = load i64, i64* %optr");
        H("  %doarc = icmp ne i64 %owns, 0");
        H("  br i1 %doarc, label %arc, label %done");
        H("arc:");
        H("  %nvp = inttoptr i64 %v to i8*");
        H("  call void @zslot_retain(i8* %nvp, i64 %owns)");
        H("  %ovp = inttoptr i64 %old to i8*");
        H("  call void @zslot_release(i8* %ovp, i64 %owns)");
        H("  br label %done");
        H("done:");
        H("  ret void");
        H("}");
        H("define i64 @zlist_count(i8* %p) {");
        H("  %l = bitcast i8* %p to %zlist*");
        H("  %cptr = getelementptr %zlist, %zlist* %l, i32 0, i32 0");
        H("  %c = load i64, i64* %cptr");
        H("  ret i64 %c");
        H("}");
        // `new List<T>(src)`: copy the source list's elements into the new
        // list. The elements are added through zlist_add, so a list that owns
        // its elements retains the copies (the C host's list_copy lowering
        // retains them the same way).
        H("define void @zlist_copy(i8* %dp, i8* %sp) {");
        H("entry:");
        H("  %sl = bitcast i8* %sp to %zlist*");
        H("  %scptr = getelementptr %zlist, %zlist* %sl, i32 0, i32 0");
        H("  %count = load i64, i64* %scptr");
        H("  %sdptr = getelementptr %zlist, %zlist* %sl, i32 0, i32 2");
        H("  %sdata = load i64*, i64** %sdptr");
        H("  %ia = alloca i64");
        H("  store i64 0, i64* %ia");
        H("  br label %cond");
        H("cond:");
        H("  %iv = load i64, i64* %ia");
        H("  %more = icmp slt i64 %iv, %count");
        H("  br i1 %more, label %body, label %done");
        H("body:");
        H("  %sslot = getelementptr i64, i64* %sdata, i64 %iv");
        H("  %v = load i64, i64* %sslot");
        H("  call void @zlist_add(i8* %dp, i64 %v)");
        H("  %ni = add i64 %iv, 1");
        H("  store i64 %ni, i64* %ia");
        H("  br label %cond");
        H("done:");
        H("  ret void");
        H("}");
        H("define void @zlist_removeat(i8* %p, i64 %i) {");
        H("entry:");
        H("  %l = bitcast i8* %p to %zlist*");
        H("  %cptr = getelementptr %zlist, %zlist* %l, i32 0, i32 0");
        H("  %count = load i64, i64* %cptr");
        H("  %dptr = getelementptr %zlist, %zlist* %l, i32 0, i32 2");
        H("  %data = load i64*, i64** %dptr");
        H("  %optr = getelementptr %zlist, %zlist* %l, i32 0, i32 3");
        H("  %owns = load i64, i64* %optr");
        H("  %doarc = icmp ne i64 %owns, 0");
        H("  br i1 %doarc, label %rel, label %shiftinit");
        H("rel:");
        H("  %vp = getelementptr i64, i64* %data, i64 %i");
        H("  %vv = load i64, i64* %vp");
        H("  %vo = inttoptr i64 %vv to i8*");
        H("  call void @zslot_release(i8* %vo, i64 %owns)");
        H("  br label %shiftinit");
        H("shiftinit:");
        H("  %ja = alloca i64");
        H("  store i64 %i, i64* %ja");
        H("  br label %cond");
        H("cond:");
        H("  %j = load i64, i64* %ja");
        H("  %jn = add i64 %j, 1");
        H("  %done = icmp sge i64 %jn, %count");
        H("  br i1 %done, label %fin, label %shift");
        H("shift:");
        H("  %sp = getelementptr i64, i64* %data, i64 %jn");
        H("  %sv = load i64, i64* %sp");
        H("  %dp = getelementptr i64, i64* %data, i64 %j");
        H("  store i64 %sv, i64* %dp");
        H("  store i64 %jn, i64* %ja");
        H("  br label %cond");
        H("fin:");
        H("  %nc = sub i64 %count, 1");
        H("  store i64 %nc, i64* %cptr");
        H("  ret void");
        H("}");
        H("define void @zlist_clear(i8* %p) {");
        H("entry:");
        H("  %l = bitcast i8* %p to %zlist*");
        H("  %cptr = getelementptr %zlist, %zlist* %l, i32 0, i32 0");
        H("  %count = load i64, i64* %cptr");
        H("  %dptr = getelementptr %zlist, %zlist* %l, i32 0, i32 2");
        H("  %data = load i64*, i64** %dptr");
        H("  %optr = getelementptr %zlist, %zlist* %l, i32 0, i32 3");
        H("  %owns = load i64, i64* %optr");
        H("  %doarc = icmp ne i64 %owns, 0");
        H("  %ja = alloca i64");
        H("  store i64 0, i64* %ja");
        H("  br i1 %doarc, label %cond, label %fin");
        H("cond:");
        H("  %j = load i64, i64* %ja");
        H("  %done = icmp sge i64 %j, %count");
        H("  br i1 %done, label %fin, label %rel");
        H("rel:");
        H("  %sp = getelementptr i64, i64* %data, i64 %j");
        H("  %sv = load i64, i64* %sp");
        H("  %so = inttoptr i64 %sv to i8*");
        H("  call void @zslot_release(i8* %so, i64 %owns)");
        H("  %jn = add i64 %j, 1");
        H("  store i64 %jn, i64* %ja");
        H("  br label %cond");
        H("fin:");
        H("  store i64 0, i64* %cptr");
        H("  ret void");
        H("}");
        // zlist_reserve: make room for n elements up front (the C host's
        // List<T>.Reserve). A no-op when the capacity is already big enough;
        // otherwise the capacity becomes exactly n, like the C host.
        H("define void @zlist_reserve(i8* %p, i64 %n) {");
        H("entry:");
        H("  %l = bitcast i8* %p to %zlist*");
        H("  %capptr = getelementptr %zlist, %zlist* %l, i32 0, i32 1");
        H("  %cap = load i64, i64* %capptr");
        H("  %enough = icmp sge i64 %cap, %n");
        H("  br i1 %enough, label %done, label %grow");
        H("grow:");
        H("  %dptr = getelementptr %zlist, %zlist* %l, i32 0, i32 2");
        H("  %olddata = load i64*, i64** %dptr");
        H("  %oldi8 = bitcast i64* %olddata to i8*");
        H("  %bytes = mul i64 %n, 8");
        H("  %newi8 = call i8* @realloc(i8* %oldi8, i64 %bytes)");
        H("  %newdata = bitcast i8* %newi8 to i64*");
        H("  store i64* %newdata, i64** %dptr");
        H("  store i64 %n, i64* %capptr");
        H("  br label %done");
        H("done:");
        H("  ret void");
        H("}");
        // zlist_addrange: append every element of the source list. The count
        // is read once, so appending a list to itself copies the elements it
        // had when the call started (the C host reads the count the same way).
        H("define void @zlist_addrange(i8* %d, i8* %s) {");
        H("entry:");
        // a null source adds nothing (the host's AddRange guard)
        H("  %ia = alloca i64");
        H("  %snull = icmp eq i8* %s, null");
        H("  br i1 %snull, label %nosrc, label %go");
        H("nosrc:");
        H("  ret void");
        H("go:");
        H("  %n = call i64 @zlist_count(i8* %s)");
        H("  store i64 0, i64* %ia");
        H("  br label %cond");
        H("cond:");
        H("  %i = load i64, i64* %ia");
        H("  %done = icmp uge i64 %i, %n");
        H("  br i1 %done, label %fin, label %body");
        H("body:");
        H("  %v = call i64 @zlist_get(i8* %s, i64 %i)");
        H("  call void @zlist_add(i8* %d, i64 %v)");
        H("  %ni = add i64 %i, 1");
        H("  store i64 %ni, i64* %ia");
        H("  br label %cond");
        H("fin:");
        H("  ret void");
        H("}");
        // zlist_insert: shift the elements from the end down to the insert
        // point, then put the new value there.
        H("define void @zlist_insert(i8* %p, i64 %idx, i64 %v) {");
        H("entry:");
        H("  %l = bitcast i8* %p to %zlist*");
        H("  %cptr = getelementptr %zlist, %zlist* %l, i32 0, i32 0");
        H("  %count = load i64, i64* %cptr");
        H("  %capptr = getelementptr %zlist, %zlist* %l, i32 0, i32 1");
        H("  %cap = load i64, i64* %capptr");
        H("  %full = icmp sge i64 %count, %cap");
        H("  br i1 %full, label %grow, label %st");
        H("grow:");
        H("  %nc0 = mul i64 %cap, 2");
        H("  %isz = icmp eq i64 %nc0, 0");
        H("  %nc = select i1 %isz, i64 4, i64 %nc0");
        H("  %dptr = getelementptr %zlist, %zlist* %l, i32 0, i32 2");
        H("  %olddata = load i64*, i64** %dptr");
        H("  %oldi8 = bitcast i64* %olddata to i8*");
        H("  %bytes = mul i64 %nc, 8");
        H("  %newi8 = call i8* @realloc(i8* %oldi8, i64 %bytes)");
        H("  %newdata = bitcast i8* %newi8 to i64*");
        H("  store i64* %newdata, i64** %dptr");
        H("  store i64 %nc, i64* %capptr");
        H("  br label %st");
        H("st:");
        H("  %dptr2 = getelementptr %zlist, %zlist* %l, i32 0, i32 2");
        H("  %data = load i64*, i64** %dptr2");
        H("  %ja = alloca i64");
        H("  %j0 = sub i64 %count, 1");
        H("  store i64 %j0, i64* %ja");
        H("  br label %shcond");
        H("shcond:");
        H("  %j = load i64, i64* %ja");
        H("  %c = icmp slt i64 %j, %idx");
        H("  br i1 %c, label %shdone, label %shbody");
        H("shbody:");
        H("  %jn = add i64 %j, 1");
        H("  %sp = getelementptr i64, i64* %data, i64 %j");
        H("  %sv = load i64, i64* %sp");
        H("  %dp = getelementptr i64, i64* %data, i64 %jn");
        H("  store i64 %sv, i64* %dp");
        H("  %jp = sub i64 %j, 1");
        H("  store i64 %jp, i64* %ja");
        H("  br label %shcond");
        H("shdone:");
        // the element that sat at the insert point was moved one slot up by
        // the shift, so nothing is dropped here: the list keeps exactly one
        // reference per slot. Only the new value has to be retained.
        H("  %slot = getelementptr i64, i64* %data, i64 %idx");
        H("  store i64 %v, i64* %slot");
        H("  %ncount = add i64 %count, 1");
        H("  store i64 %ncount, i64* %cptr");
        H("  %optr = getelementptr %zlist, %zlist* %l, i32 0, i32 3");
        H("  %owns = load i64, i64* %optr");
        H("  %doret = icmp ne i64 %owns, 0");
        H("  br i1 %doret, label %doretain, label %done");
        H("doretain:");
        H("  %vp = inttoptr i64 %v to i8*");
        H("  call void @zslot_retain(i8* %vp, i64 %owns)");
        H("  br label %done");
        H("done:");
        H("  ret void");
        H("}");
    }

    // ARC: every heap object carries a hidden 8-byte refcount header that lives
    // immediately BEFORE the pointer handed out, so object field layout, vtable
    // slot 0 and container internals are all unchanged. zalloc initialises the
    // count to 1; zretain/zrelease adjust it; zrelease frees at count 0.
    void EmitDictRuntime() {
        EmitDictRuntimeCore();
        EmitDictRuntimeMutate();
        EmitDictRuntimeQuery();
    }

    /// %zdict type + dtor/new/keys/values/index.
    void EmitDictRuntimeCore() {
        // The appended flag owns string keys independently of value ownership.
        // Non-string keys remain opaque tokens; existing field offsets are stable.
        // Fields 6-7 hold an optional open-addressed hash index (slot = key index + 1,
        // 0 = empty; power-of-two capacity, 0 = not built) built once count >= 8 so
        // large dicts stay O(1). Field 8 holds the closed Dictionary<K,V> TypeInfo
        // pointer for runtime `is`/`as` identity checks. Offsets 0..5 are unchanged.
        H("%zdict = type { i64, i64, i8**, i64*, i64, i64, i64*, i64, i8* }");
        H("define void @zdict_dtor(i8* %p) {");
        H("entry:");
        H("  call void @zdict_clear(i8* %p)");
        H("  %d = bitcast i8* %p to %zdict*");
        H("  %kptr = getelementptr %zdict, %zdict* %d, i32 0, i32 2");
        H("  %keys = load i8**, i8*** %kptr");
        H("  %keysi8 = bitcast i8** %keys to i8*");
        H("  call void @free(i8* %keysi8)");
        H("  %vptr2 = getelementptr %zdict, %zdict* %d, i32 0, i32 3");
        H("  %vals2 = load i64*, i64** %vptr2");
        H("  %valsi8 = bitcast i64* %vals2 to i8*");
        H("  call void @free(i8* %valsi8)");
        H("  ret void");
        H("}");
        H("define i8* @zdict_new(i64 %owns) {");
        H("  %p = call i8* @zdict_new_typed(i64 %owns, i8* null)");
        H("  ret i8* %p");
        H("}");
        H("define i8* @zdict_new_typed(i64 %owns, i8* %meta) {");
        H("  %p = call i8* @zalloc(i64 72, i8* bitcast (void (i8*)* @zdict_dtor to i8*), " + ContainerCid("Dict") + ")");
        H("  %d = bitcast i8* %p to %zdict*");
        H("  %c = getelementptr %zdict, %zdict* %d, i32 0, i32 0");
        H("  store i64 0, i64* %c");
        H("  %cap = getelementptr %zdict, %zdict* %d, i32 0, i32 1");
        H("  store i64 0, i64* %cap");
        H("  %k = getelementptr %zdict, %zdict* %d, i32 0, i32 2");
        H("  store i8** null, i8*** %k");
        H("  %v = getelementptr %zdict, %zdict* %d, i32 0, i32 3");
        H("  store i64* null, i64** %v");
        H("  %op = getelementptr %zdict, %zdict* %d, i32 0, i32 4");
        H("  store i64 %owns, i64* %op");
        H("  %kp = getelementptr %zdict, %zdict* %d, i32 0, i32 5");
        H("  store i64 0, i64* %kp");
        H("  %htp = getelementptr %zdict, %zdict* %d, i32 0, i32 6");
        H("  store i64* null, i64** %htp");
        H("  %hcp = getelementptr %zdict, %zdict* %d, i32 0, i32 7");
        H("  store i64 0, i64* %hcp");
        H("  %mp = getelementptr %zdict, %zdict* %d, i32 0, i32 8");
        H("  store i8* %meta, i8** %mp");
        H("  ret i8* %p");
        H("}");
        H("define internal i8* @zdict_typeinfo(i8* %p) {");
        H("  %d = bitcast i8* %p to %zdict*");
        H("  %slot = getelementptr %zdict, %zdict* %d, i32 0, i32 8");
        H("  %meta = load i8*, i8** %slot");
        H("  ret i8* %meta");
        H("}");
        H("define internal i1 @zdict_matches_type(i8* %p, i8* %meta) {");
        H("  %cid = call i8* @__zan_class_id(i8* %p)");
        H("  %isdict = icmp eq i8* %cid, bitcast (i8** @__tid_Dict to i8*)");
        H("  br i1 %isdict, label %check, label %miss");
        H("check:");
        H("  %actual = call i8* @zdict_typeinfo(i8* %p)");
        H("  %same = icmp eq i8* %actual, %meta");
        H("  ret i1 %same");
        H("miss:");
        H("  ret i1 false");
        H("}");
        H("define i8* @zdict_keys(i8* %p, i64 %string_keys, i8* %meta) {");
        H("entry:");
        H("  %d = bitcast i8* %p to %zdict*");
        H("  %cptr = getelementptr %zdict, %zdict* %d, i32 0, i32 0");
        H("  %count = load i64, i64* %cptr");
        H("  %kptr = getelementptr %zdict, %zdict* %d, i32 0, i32 2");
        H("  %keys = load i8**, i8*** %kptr");
        H("  %isstrk = icmp ne i64 %string_keys, 0");
        H("  %kowns = select i1 %isstrk, i64 4, i64 0");
        H("  %out = call i8* @zlist_new_typed(i64 %kowns, i8* %meta)");
        H("  %ia = alloca i64");
        H("  store i64 0, i64* %ia");
        H("  br label %cond");
        H("cond:");
        H("  %i = load i64, i64* %ia");
        H("  %more = icmp slt i64 %i, %count");
        H("  br i1 %more, label %body, label %done");
        H("body:");
        H("  %ks = getelementptr i8*, i8** %keys, i64 %i");
        H("  %k = load i8*, i8** %ks");
        H("  %kv = ptrtoint i8* %k to i64");
        H("  call void @zlist_add(i8* %out, i64 %kv)");
        H("  %i1 = add i64 %i, 1");
        H("  store i64 %i1, i64* %ia");
        H("  br label %cond");
        H("done:");
        H("  ret i8* %out");
        H("}");
        H("define i8* @zdict_values(i8* %p, i8* %meta) {");
        H("entry:");
        H("  %d = bitcast i8* %p to %zdict*");
        H("  %cptr = getelementptr %zdict, %zdict* %d, i32 0, i32 0");
        H("  %count = load i64, i64* %cptr");
        H("  %vptr = getelementptr %zdict, %zdict* %d, i32 0, i32 3");
        H("  %vals = load i64*, i64** %vptr");
        H("  %optr = getelementptr %zdict, %zdict* %d, i32 0, i32 4");
        H("  %owns = load i64, i64* %optr");
        H("  %out = call i8* @zlist_new_typed(i64 %owns, i8* %meta)");
        H("  %ia = alloca i64");
        H("  store i64 0, i64* %ia");
        H("  br label %cond");
        H("cond:");
        H("  %i = load i64, i64* %ia");
        H("  %more = icmp slt i64 %i, %count");
        H("  br i1 %more, label %body, label %done");
        H("body:");
        H("  %vs = getelementptr i64, i64* %vals, i64 %i");
        H("  %v = load i64, i64* %vs");
        H("  call void @zlist_add(i8* %out, i64 %v)");
        H("  %i1 = add i64 %i, 1");
        H("  store i64 %i1, i64* %ia");
        H("  br label %cond");
        H("done:");
        H("  ret i8* %out");
        H("}");
        // key equality: raw keys by identity, string keys by content
        H("define i1 @zdict_keyeq(i8* %kk, i8* %key, i64 %is_str) {");
        H("entry:");
        H("  %pteq = icmp eq i8* %kk, %key");
        H("  br i1 %pteq, label %yes, label %chk");
        H("chk:");
        H("  %raw = icmp eq i64 %is_str, 0");
        H("  %kknull = icmp eq i8* %kk, null");
        H("  %keynull = icmp eq i8* %key, null");
        H("  %anynull = or i1 %kknull, %keynull");
        H("  %skip = or i1 %raw, %anynull");
        H("  br i1 %skip, label %no, label %chars");
        H("chars:");
        H("  %c1 = load i8, i8* %kk");
        H("  %c2 = load i8, i8* %key");
        H("  %ce = icmp eq i8 %c1, %c2");
        H("  br i1 %ce, label %call, label %no");
        H("call:");
        H("  %cmp = call i32 @__zan_strcmp0(i8* %kk, i8* %key)");
        H("  %eq = icmp eq i32 %cmp, 0");
        H("  ret i1 %eq");
        H("yes:");
        H("  ret i1 1");
        H("no:");
        H("  ret i1 0");
        H("}");
        // FNV-1a over a string key's zstr_len bytes (consistent with @__zan_strcmp0,
        // including embedded NULs); a raw key's bits are mixed
        H("define i64 @zdict_hash(i8* %key, i64 %is_str) {");
        H("entry:");
        H("  %raw = icmp eq i64 %is_str, 0");
        H("  br i1 %raw, label %rawh, label %strchk");
        H("rawh:");
        H("  %h0 = ptrtoint i8* %key to i64");
        H("  %s1 = lshr i64 %h0, 33");
        H("  %h1 = xor i64 %h0, %s1");
        H("  %h2 = mul i64 %h1, -49064778989728563");
        H("  %s2 = lshr i64 %h2, 33");
        H("  %h3 = xor i64 %h2, %s2");
        H("  ret i64 %h3");
        H("strchk:");
        H("  %isnull = icmp eq i8* %key, null");
        H("  br i1 %isnull, label %zero, label %strh");
        H("zero:");
        H("  ret i64 0");
        H("strh:");
        H("  %len = call i64 @zstr_len(i8* %key)");
        H("  br label %loop");
        H("loop:");
        H("  %i = phi i64 [ 0, %strh ], [ %in, %step ]");
        H("  %h = phi i64 [ -3750763034362895579, %strh ], [ %hn, %step ]");
        H("  %more = icmp slt i64 %i, %len");
        H("  br i1 %more, label %step, label %out");
        H("step:");
        H("  %cp = getelementptr i8, i8* %key, i64 %i");
        H("  %c = load i8, i8* %cp");
        H("  %cz = zext i8 %c to i64");
        H("  %hx = xor i64 %h, %cz");
        H("  %hn = mul i64 %hx, 1099511628211");
        H("  %in = add i64 %i, 1");
        H("  br label %loop");
        H("out:");
        H("  ret i64 %h");
        H("}");
        // (re)build the index at capacity %ncap from the key array
        H("define void @zdict_rehash(i8* %p, i64 %ncap) {");
        H("entry:");
        H("  %d = bitcast i8* %p to %zdict*");
        H("  %htp = getelementptr %zdict, %zdict* %d, i32 0, i32 6");
        H("  %old = load i64*, i64** %htp");
        H("  %oldi8 = bitcast i64* %old to i8*");
        H("  call void @free(i8* %oldi8)");
        H("  %raw = call i8* @calloc(i64 %ncap, i64 8)");
        H("  %tab = bitcast i8* %raw to i64*");
        H("  store i64* %tab, i64** %htp");
        H("  %hcp = getelementptr %zdict, %zdict* %d, i32 0, i32 7");
        H("  store i64 %ncap, i64* %hcp");
        H("  %cptr = getelementptr %zdict, %zdict* %d, i32 0, i32 0");
        H("  %count = load i64, i64* %cptr");
        H("  %i0 = icmp sgt i64 %count, 0");
        H("  br i1 %i0, label %loop, label %done");
        H("loop:");
        H("  %i = phi i64 [ 0, %entry ], [ %in, %loop ]");
        H("  call void @zdict_hidx_put(i8* %p, i64 %i)");
        H("  %in = add i64 %i, 1");
        H("  %more = icmp slt i64 %in, %count");
        H("  br i1 %more, label %loop, label %done");
        H("done:");
        H("  ret void");
        H("}");
        // place key index %idx into the (non-full) index
        H("define void @zdict_hidx_put(i8* %p, i64 %idx) {");
        H("entry:");
        H("  %d = bitcast i8* %p to %zdict*");
        H("  %kptr = getelementptr %zdict, %zdict* %d, i32 0, i32 2");
        H("  %keys = load i8**, i8*** %kptr");
        H("  %ks = getelementptr i8*, i8** %keys, i64 %idx");
        H("  %key = load i8*, i8** %ks");
        H("  %kop = getelementptr %zdict, %zdict* %d, i32 0, i32 5");
        H("  %iss = load i64, i64* %kop");
        H("  %h = call i64 @zdict_hash(i8* %key, i64 %iss)");
        H("  %htp = getelementptr %zdict, %zdict* %d, i32 0, i32 6");
        H("  %tab = load i64*, i64** %htp");
        H("  %hcp = getelementptr %zdict, %zdict* %d, i32 0, i32 7");
        H("  %cap = load i64, i64* %hcp");
        H("  %mask = sub i64 %cap, 1");
        H("  %j0 = and i64 %h, %mask");
        H("  br label %probe");
        H("probe:");
        H("  %j = phi i64 [ %j0, %entry ], [ %jn, %busy ]");
        H("  %sp = getelementptr i64, i64* %tab, i64 %j");
        H("  %sv = load i64, i64* %sp");
        H("  %empty = icmp eq i64 %sv, 0");
        H("  br i1 %empty, label %put, label %busy");
        H("busy:");
        H("  %j1 = add i64 %j, 1");
        H("  %jn = and i64 %j1, %mask");
        H("  br label %probe");
        H("put:");
        H("  %v1 = add i64 %idx, 1");
        H("  store i64 %v1, i64* %sp");
        H("  ret void");
        H("}");
        // after appending key index %idx (count already includes it): build
        // the index at 8 keys, grow it at half load, else just place the key
        H("define void @zdict_hidx_added(i8* %p, i64 %idx) {");
        H("entry:");
        H("  %d = bitcast i8* %p to %zdict*");
        H("  %hcp = getelementptr %zdict, %zdict* %d, i32 0, i32 7");
        H("  %cap = load i64, i64* %hcp");
        H("  %n = add i64 %idx, 1");
        H("  %none = icmp eq i64 %cap, 0");
        H("  br i1 %none, label %maybe, label %have");
        H("maybe:");
        H("  %big = icmp sge i64 %n, 8");
        H("  br i1 %big, label %build, label %done");
        H("build:");
        H("  call void @zdict_rehash(i8* %p, i64 32)");
        H("  ret void");
        H("have:");
        H("  %n2 = mul i64 %n, 2");
        H("  %full = icmp sgt i64 %n2, %cap");
        H("  br i1 %full, label %grow, label %put");
        H("grow:");
        H("  %nc = mul i64 %cap, 2");
        H("  call void @zdict_rehash(i8* %p, i64 %nc)");
        H("  ret void");
        H("put:");
        H("  call void @zdict_hidx_put(i8* %p, i64 %idx)");
        H("  ret void");
        H("done:");
        H("  ret void");
        H("}");
        H("define i64 @zdict_index(i8* %p, i8* %key, i64 %is_str) {");
        H("entry:");
        H("  %isnull = icmp eq i8* %p, null");
        H("  br i1 %isnull, label %notfound, label %nonnull");
        H("nonnull:");
        H("  %d = bitcast i8* %p to %zdict*");
        H("  %cptr = getelementptr %zdict, %zdict* %d, i32 0, i32 0");
        H("  %count = load i64, i64* %cptr");
        H("  %kptr = getelementptr %zdict, %zdict* %d, i32 0, i32 2");
        H("  %keys = load i8**, i8*** %kptr");
        H("  %hcp = getelementptr %zdict, %zdict* %d, i32 0, i32 7");
        H("  %cap = load i64, i64* %hcp");
        H("  %hashed = icmp sgt i64 %cap, 0");
        H("  br i1 %hashed, label %hstart, label %lstart");
        H("hstart:");
        H("  %htp = getelementptr %zdict, %zdict* %d, i32 0, i32 6");
        H("  %tab = load i64*, i64** %htp");
        H("  %mask = sub i64 %cap, 1");
        H("  %h = call i64 @zdict_hash(i8* %key, i64 %is_str)");
        H("  %j0 = and i64 %h, %mask");
        H("  br label %hprobe");
        H("hprobe:");
        H("  %j = phi i64 [ %j0, %hstart ], [ %jn, %hnext ]");
        H("  %sp = getelementptr i64, i64* %tab, i64 %j");
        H("  %sv = load i64, i64* %sp");
        H("  %empty = icmp eq i64 %sv, 0");
        H("  br i1 %empty, label %notfound, label %hcmp");
        H("hcmp:");
        H("  %hi = sub i64 %sv, 1");
        H("  %hs = getelementptr i8*, i8** %keys, i64 %hi");
        H("  %hk = load i8*, i8** %hs");
        H("  %heq = call i1 @zdict_keyeq(i8* %hk, i8* %key, i64 %is_str)");
        H("  br i1 %heq, label %hfound, label %hnext");
        H("hfound:");
        H("  ret i64 %hi");
        H("hnext:");
        H("  %j1 = add i64 %j, 1");
        H("  %jn = and i64 %j1, %mask");
        H("  br label %hprobe");
        H("lstart:");
        H("  %any = icmp sgt i64 %count, 0");
        H("  br i1 %any, label %body, label %notfound");
        H("body:");
        H("  %i = phi i64 [ 0, %lstart ], [ %ni, %next ]");
        H("  %slot = getelementptr i8*, i8** %keys, i64 %i");
        H("  %kk = load i8*, i8** %slot");
        H("  %eq = call i1 @zdict_keyeq(i8* %kk, i8* %key, i64 %is_str)");
        H("  br i1 %eq, label %found, label %next");
        H("found:");
        H("  ret i64 %i");
        H("next:");
        H("  %ni = add i64 %i, 1");
        H("  %more = icmp slt i64 %ni, %count");
        H("  br i1 %more, label %body, label %notfound");
        H("notfound:");
        H("  ret i64 -1");
        H("}");
    }

    /// zdict_set / zdict_get (insert-or-update + lookup).
    void EmitDictRuntimeMutate() {
        H("define void @zdict_set(i8* %p, i8* %key, i64 %val, i64 %is_str) {");
        H("entry:");
        H("  %isnull = icmp eq i8* %p, null");
        H("  br i1 %isnull, label %doneu, label %nonnull");
        H("nonnull:");
        H("  %idx = call i64 @zdict_index(i8* %p, i8* %key, i64 %is_str)");
        H("  %exists = icmp sge i64 %idx, 0");
        H("  br i1 %exists, label %update, label %insert");
        H("update:");
        H("  %du = bitcast i8* %p to %zdict*");
        H("  %vpu = getelementptr %zdict, %zdict* %du, i32 0, i32 3");
        H("  %valsu = load i64*, i64** %vpu");
        H("  %su = getelementptr i64, i64* %valsu, i64 %idx");
        H("  %oldval = load i64, i64* %su");
        H("  store i64 %val, i64* %su");
        H("  %opu = getelementptr %zdict, %zdict* %du, i32 0, i32 4");
        H("  %ownsu = load i64, i64* %opu");
        H("  %doarcu = icmp ne i64 %ownsu, 0");
        H("  br i1 %doarcu, label %arcu, label %doneu");
        H("arcu:");
        H("  %nvpu = inttoptr i64 %val to i8*");
        H("  call void @zslot_retain(i8* %nvpu, i64 %ownsu)");
        H("  %ovpu = inttoptr i64 %oldval to i8*");
        H("  call void @zslot_release(i8* %ovpu, i64 %ownsu)");
        H("  br label %doneu");
        H("doneu:");
        H("  ret void");
        H("insert:");
        H("  %d = bitcast i8* %p to %zdict*");
        H("  %cptr = getelementptr %zdict, %zdict* %d, i32 0, i32 0");
        H("  %count = load i64, i64* %cptr");
        H("  %capptr = getelementptr %zdict, %zdict* %d, i32 0, i32 1");
        H("  %cap = load i64, i64* %capptr");
        H("  %full = icmp sge i64 %count, %cap");
        H("  br i1 %full, label %grow, label %st");
        H("grow:");
        H("  %nc0 = mul i64 %cap, 2");
        H("  %isz = icmp eq i64 %nc0, 0");
        H("  %nc = select i1 %isz, i64 4, i64 %nc0");
        H("  %kptr = getelementptr %zdict, %zdict* %d, i32 0, i32 2");
        H("  %oldk = load i8**, i8*** %kptr");
        H("  %oldki8 = bitcast i8** %oldk to i8*");
        H("  %kbytes = mul i64 %nc, 8");
        H("  %newki8 = call i8* @realloc(i8* %oldki8, i64 %kbytes)");
        H("  %newk = bitcast i8* %newki8 to i8**");
        H("  store i8** %newk, i8*** %kptr");
        H("  %vptr = getelementptr %zdict, %zdict* %d, i32 0, i32 3");
        H("  %oldv = load i64*, i64** %vptr");
        H("  %oldvi8 = bitcast i64* %oldv to i8*");
        H("  %vbytes = mul i64 %nc, 8");
        H("  %newvi8 = call i8* @realloc(i8* %oldvi8, i64 %vbytes)");
        H("  %newv = bitcast i8* %newvi8 to i64*");
        H("  store i64* %newv, i64** %vptr");
        H("  store i64 %nc, i64* %capptr");
        H("  br label %st");
        H("st:");
        H("  %kptr2 = getelementptr %zdict, %zdict* %d, i32 0, i32 2");
        H("  %keys = load i8**, i8*** %kptr2");
        H("  %kslot = getelementptr i8*, i8** %keys, i64 %count");
        H("  store i8* %key, i8** %kslot");
        H("  %koptr = getelementptr %zdict, %zdict* %d, i32 0, i32 5");
        H("  store i64 %is_str, i64* %koptr");
        H("  %ownkey = icmp ne i64 %is_str, 0");
        H("  br i1 %ownkey, label %retainkey, label %storeval");
        H("retainkey:");
        H("  call void @zstr_slot_retain(i8* %key)");
        H("  br label %storeval");
        H("storeval:");
        H("  %vptr2 = getelementptr %zdict, %zdict* %d, i32 0, i32 3");
        H("  %vals = load i64*, i64** %vptr2");
        H("  %vslot = getelementptr i64, i64* %vals, i64 %count");
        H("  store i64 %val, i64* %vslot");
        H("  %ncount = add i64 %count, 1");
        H("  store i64 %ncount, i64* %cptr");
        H("  call void @zdict_hidx_added(i8* %p, i64 %count)");
        H("  %opi = getelementptr %zdict, %zdict* %d, i32 0, i32 4");
        H("  %ownsi = load i64, i64* %opi");
        H("  %doarci = icmp ne i64 %ownsi, 0");
        H("  br i1 %doarci, label %arci, label %donei");
        H("arci:");
        H("  %nvpi = inttoptr i64 %val to i8*");
        H("  call void @zslot_retain(i8* %nvpi, i64 %ownsi)");
        H("  br label %donei");
        H("donei:");
        H("  ret void");
        H("}");
        H("define i64 @zdict_get(i8* %p, i8* %key, i64 %is_str) {");
        H("entry:");
        H("  %idx = call i64 @zdict_index(i8* %p, i8* %key, i64 %is_str)");
        H("  %nf = icmp slt i64 %idx, 0");
        H("  br i1 %nf, label %ret0, label %load");
        H("ret0:");
        H("  ret i64 0");
        H("load:");
        H("  %d = bitcast i8* %p to %zdict*");
        H("  %vptr = getelementptr %zdict, %zdict* %d, i32 0, i32 3");
        H("  %vals = load i64*, i64** %vptr");
        H("  %slot = getelementptr i64, i64* %vals, i64 %idx");
        H("  %v = load i64, i64* %slot");
        H("  ret i64 %v");
        H("}");
    }

    /// zdict_contains / zdict_remove / zdict_count.
    void EmitDictRuntimeQuery() {
        H("define i64 @zdict_contains(i8* %p, i8* %key, i64 %is_str) {");
        H("  %idx = call i64 @zdict_index(i8* %p, i8* %key, i64 %is_str)");
        H("  %ge = icmp sge i64 %idx, 0");
        H("  %r = zext i1 %ge to i64");
        H("  ret i64 %r");
        H("}");
        H("define i64 @zdict_remove(i8* %p, i8* %key, i64 %is_str) {");
        H("entry:");
        H("  %idx = call i64 @zdict_index(i8* %p, i8* %key, i64 %is_str)");
        H("  %nf = icmp slt i64 %idx, 0");
        H("  br i1 %nf, label %ret0, label %doit");
        H("ret0:");
        H("  ret i64 0");
        H("doit:");
        H("  %d = bitcast i8* %p to %zdict*");
        H("  %cptr = getelementptr %zdict, %zdict* %d, i32 0, i32 0");
        H("  %count = load i64, i64* %cptr");
        H("  %kptr = getelementptr %zdict, %zdict* %d, i32 0, i32 2");
        H("  %keys = load i8**, i8*** %kptr");
        H("  %vptr = getelementptr %zdict, %zdict* %d, i32 0, i32 3");
        H("  %vals = load i64*, i64** %vptr");
        H("  %koptr = getelementptr %zdict, %zdict* %d, i32 0, i32 5");
        H("  %keyowns = load i64, i64* %koptr");
        H("  %ownkey = icmp ne i64 %keyowns, 0");
        H("  br i1 %ownkey, label %releasekey, label %value");
        H("releasekey:");
        H("  %kslot = getelementptr i8*, i8** %keys, i64 %idx");
        H("  %oldkey = load i8*, i8** %kslot");
        H("  call void @zstr_slot_release(i8* %oldkey)");
        H("  br label %value");
        H("value:");
        H("  %optr = getelementptr %zdict, %zdict* %d, i32 0, i32 4");
        H("  %owns = load i64, i64* %optr");
        H("  %doarc = icmp ne i64 %owns, 0");
        H("  br i1 %doarc, label %arc, label %shiftinit");
        H("arc:");
        H("  %vs = getelementptr i64, i64* %vals, i64 %idx");
        H("  %ov = load i64, i64* %vs");
        H("  %op = inttoptr i64 %ov to i8*");
        H("  call void @zslot_release(i8* %op, i64 %owns)");
        H("  br label %shiftinit");
        H("shiftinit:");
        H("  %ia = alloca i64");
        H("  store i64 %idx, i64* %ia");
        H("  %last = sub i64 %count, 1");
        H("  br label %cond");
        H("cond:");
        H("  %i = load i64, i64* %ia");
        H("  %done = icmp sge i64 %i, %last");
        H("  br i1 %done, label %fin, label %body");
        H("body:");
        H("  %i1 = add i64 %i, 1");
        H("  %ks = getelementptr i8*, i8** %keys, i64 %i1");
        H("  %kv = load i8*, i8** %ks");
        H("  %kd = getelementptr i8*, i8** %keys, i64 %i");
        H("  store i8* %kv, i8** %kd");
        H("  %vss = getelementptr i64, i64* %vals, i64 %i1");
        H("  %vv = load i64, i64* %vss");
        H("  %vd = getelementptr i64, i64* %vals, i64 %i");
        H("  store i64 %vv, i64* %vd");
        H("  store i64 %i1, i64* %ia");
        H("  br label %cond");
        H("fin:");
        H("  store i64 %last, i64* %cptr");
        // the compaction moved every later key down one slot: drop or rebuild
        H("  %rbcp = getelementptr %zdict, %zdict* %d, i32 0, i32 7");
        H("  %rbcap = load i64, i64* %rbcp");
        H("  %rhasb = icmp sgt i64 %rbcap, 0");
        H("  br i1 %rhasb, label %rfixb, label %rret1");
        H("rfixb:");
        H("  %rsmall = icmp sle i64 %last, 8");
        H("  br i1 %rsmall, label %rdropb, label %rrehashb");
        H("rdropb:");
        H("  %rbp = getelementptr %zdict, %zdict* %d, i32 0, i32 6");
        H("  %roldb = load i64*, i64** %rbp");
        H("  %roldbi8 = bitcast i64* %roldb to i8*");
        H("  call void @free(i8* %roldbi8)");
        H("  store i64* null, i64** %rbp");
        H("  store i64 0, i64* %rbcp");
        H("  br label %rret1");
        H("rrehashb:");
        H("  call void @zdict_rehash(i8* %p, i64 %rbcap)");
        H("  br label %rret1");
        H("rret1:");
        H("  ret i64 1");
        H("}");
        H("define i64 @zdict_count(i8* %p) {");
        H("entry:");
        H("  %isnull = icmp eq i8* %p, null");
        H("  br i1 %isnull, label %ret0, label %nonnull");
        H("ret0:");
        H("  ret i64 0");
        H("nonnull:");
        H("  %d = bitcast i8* %p to %zdict*");
        H("  %cptr = getelementptr %zdict, %zdict* %d, i32 0, i32 0");
        H("  %c = load i64, i64* %cptr");
        H("  ret i64 %c");
        H("}");
        H("define void @zdict_clear(i8* %p) {");
        H("entry:");
        H("  %isnull = icmp eq i8* %p, null");
        H("  br i1 %isnull, label %ret, label %nonnull");
        H("ret:");
        H("  ret void");
        H("nonnull:");
        H("  %d = bitcast i8* %p to %zdict*");
        H("  %cptr = getelementptr %zdict, %zdict* %d, i32 0, i32 0");
        H("  %count = load i64, i64* %cptr");
        H("  %kptr = getelementptr %zdict, %zdict* %d, i32 0, i32 2");
        H("  %keys = load i8**, i8*** %kptr");
        H("  %vptr = getelementptr %zdict, %zdict* %d, i32 0, i32 3");
        H("  %vals = load i64*, i64** %vptr");
        H("  %optr = getelementptr %zdict, %zdict* %d, i32 0, i32 4");
        H("  %owns = load i64, i64* %optr");
        H("  %owned = icmp ne i64 %owns, 0");
        H("  %koptr = getelementptr %zdict, %zdict* %d, i32 0, i32 5");
        H("  %keyowns = load i64, i64* %koptr");
        H("  %ownkey = icmp ne i64 %keyowns, 0");
        H("  %anyowned = or i1 %owned, %ownkey");
        H("  br i1 %anyowned, label %loop, label %done");
        H("loop:");
        H("  br label %lc");
        H("lc:");
        H("  %iv = phi i64 [ 0, %loop ], [ %next, %advance ]");
        H("  %more = icmp slt i64 %iv, %count");
        H("  br i1 %more, label %lb, label %done");
        H("lb:");
        H("  br i1 %ownkey, label %releasekey, label %value");
        H("releasekey:");
        H("  %kp = getelementptr i8*, i8** %keys, i64 %iv");
        H("  %key = load i8*, i8** %kp");
        H("  call void @zstr_slot_release(i8* %key)");
        H("  br label %value");
        H("value:");
        H("  br i1 %owned, label %releaseval, label %advance");
        H("releaseval:");
        H("  %vp = getelementptr i64, i64* %vals, i64 %iv");
        H("  %vv = load i64, i64* %vp");
        H("  %obj = inttoptr i64 %vv to i8*");
        H("  call void @zslot_release(i8* %obj, i64 %owns)");
        H("  br label %advance");
        H("advance:");
        H("  %next = add i64 %iv, 1");
        H("  br label %lc");
        H("done:");
        H("  store i64 0, i64* %cptr");
        H("  %chtp = getelementptr %zdict, %zdict* %d, i32 0, i32 6");
        H("  %ctab = load i64*, i64** %chtp");
        H("  %ctabi8 = bitcast i64* %ctab to i8*");
        H("  call void @free(i8* %ctabi8)");
        H("  store i64* null, i64** %chtp");
        H("  %chcp = getelementptr %zdict, %zdict* %d, i32 0, i32 7");
        H("  store i64 0, i64* %chcp");
        H("  ret void");
        H("}");
    }

    void EmitStrcmp0() {
        H("define internal i32 @__zan_strcmp0(i8* %a, i8* %b) {");
        H("entry:");
        H("  %p_eq = icmp eq i8* %a, %b");
        H("  br i1 %p_eq, label %ret_zero, label %lengths");
        H("lengths:");
        // A null operand has empty content. Explicit null comparisons use
        // pointer identity in GenBinary and never call this helper.
        H("  %la = call i64 @zstr_len(i8* %a)");
        H("  %lb = call i64 @zstr_len(i8* %b)");
        H("  %minlt = icmp ult i64 %la, %lb");
        H("  %min = select i1 %minlt, i64 %la, i64 %lb");
        H("  %empty = icmp eq i64 %min, 0");
        H("  br i1 %empty, label %lencmp, label %do_cmp");
        H("do_cmp:");
        H("  %c = call i32 @memcmp(i8* %a, i8* %b, i64 %min)");
        H("  %neq = icmp ne i32 %c, 0");
        H("  br i1 %neq, label %ret_c, label %lencmp");
        H("ret_c:");
        H("  ret i32 %c");
        H("lencmp:");
        H("  %lt_a = icmp slt i64 %la, %lb");
        H("  br i1 %lt_a, label %ret_neg, label %chk_len2");
        H("chk_len2:");
        H("  %lt_b = icmp sgt i64 %la, %lb");
        H("  br i1 %lt_b, label %ret_pos, label %ret_zero");
        H("ret_zero:");
        H("  ret i32 0");
        H("ret_neg:");
        H("  ret i32 -1");
        H("ret_pos:");
        H("  ret i32 1");
        H("}");
    }

    // A case-insensitive ASCII string compare for bool.Parse and friends.
    // POSIX strcasecmp does not exist in the MSVC CRT, so a gen1-built
    // program linked with clang + MSVC CRT failed with LNK2019; the C host
    // gets away with the raw extern because its shipped runtime objects
    // are MinGW builds. The shim is `weak`: a CRT that provides the real
    // one wins, otherwise this ASCII-only loop answers. Equality is exact;
    // the returned difference is that of the lowercased bytes (the call
    // sites only consume the zero/non-zero distinction).
    void EmitStrcasecmpShim() {
        if (strcasecmpDone) { return; }
        strcasecmpDone = true;
        H("define weak i32 @strcasecmp(i8* %a, i8* %b) {");
        H("entry:");
        H("  br label %loop");
        H("loop:");
        H("  %i = phi i64 [ 0, %entry ], [ %ni, %cont ]");
        H("  %pa = getelementptr i8, i8* %a, i64 %i");
        H("  %pb = getelementptr i8, i8* %b, i64 %i");
        H("  %ca = load i8, i8* %pa");
        H("  %cb = load i8, i8* %pb");
        H("  %caw = zext i8 %ca to i32");
        H("  %cbw = zext i8 %cb to i32");
        H("  %aa = icmp uge i32 %caw, 65");
        H("  %az = icmp ule i32 %caw, 90");
        H("  %aup = and i1 %aa, %az");
        H("  %al = or i32 %caw, 32");
        H("  %la = select i1 %aup, i32 %al, i32 %caw");
        H("  %ba = icmp uge i32 %cbw, 65");
        H("  %bz = icmp ule i32 %cbw, 90");
        H("  %bup = and i1 %ba, %bz");
        H("  %bl = or i32 %cbw, 32");
        H("  %lb = select i1 %bup, i32 %bl, i32 %cbw");
        H("  %same = icmp eq i32 %la, %lb");
        H("  br i1 %same, label %chk, label %diff");
        H("chk:");
        H("  %done = icmp eq i32 %la, 0");
        H("  br i1 %done, label %ret0, label %cont");
        H("diff:");
        H("  %d = sub i32 %la, %lb");
        H("  ret i32 %d");
        H("cont:");
        H("  %ni = add i64 %i, 1");
        H("  br label %loop");
        H("ret0:");
        H("  ret i32 0");
        H("}");
    }

}
