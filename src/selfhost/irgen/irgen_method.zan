using System;
using System.Collections.Generic;
namespace Zan;

partial class Irgen {
    void GenMethod(Node cls, Node m, bool ctor) {
        // hardware vectors: every static body (Zero/AllBitsSet getters etc.)
        // is lowered at the call site by GenBuiltinStatic — no function bodies
        if (cls != null && (cls.sval == "Vector128" || cls.sval == "Vector256")) { return; }
        NormalizeAwaits(cls, m);
        Node prevMethod = curMethodNode;
        curMethodNode = m;
        if (IsAsync(m)) { GenAsyncMethod(cls, m); curMethodNode = prevMethod; return; }
        StartFn();
        ScanFlowLabels(m.d);
        // a closure in this method may capture the method's locals: the names
        // it mentions have to live in a cell
        CollectCapturedNames(m.d, capNames);
        curClass = cls.sval;
        curRet = MapType(m.type);
        curRetTy = m.type;
        bool stat = IsStatic(m);
        curHasThis = !stat;
        string sym = MethodSym(cls.sval, m);
        string sig = "define " + curRet + " @" + sym + "(";
        int np = 0;
        if (!stat) {
            sig = sig + "%" + cls.sval + "* %this";
            np = 1;
        }
        List<Node> parameters = new List<Node>();
        int i = 0;
        while (i < m.kids.Count) {
            Node p = m.kids[i];
            if (p.kind == AK.Param()) { parameters.Add(p); }
            i = i + 1;
        }
        int j = 0;
        while (j < parameters.Count) {
            Node p = parameters[j];
            if (np > 0) { sig = sig + ", "; }
            if (p.ival == 1) { sig = sig + MapType(p.type) + "* %ref.p" + j; }
            else { sig = sig + MapType(p.type) + " %p" + j; }
            np = np + 1;
            j = j + 1;
        }
        string debugFn = StartDebugFunction(m, sym);
        L(sig + ")" + debugFn + " {");
        L("entry:");
        DemandStaticType(cls.sval, CurInstFor(cls.sval));
        NoteStaticExport(cls, m, sym);
        StringBuilder obody = body; StringBuilder oea = entryAllocas; bool oact = eaActive;
        body = new StringBuilder(); entryAllocas = new StringBuilder(); eaActive = true;
        if (debugFn != "") { debugBody = body; }
        EmitSyncParameters(m, parameters);
        if (m.d != null) { GenStmt(m.d); }
        if (!term) {
            ReleaseLocalsFrom(0);
            if (curRet == "void") { L("  ret void"); }
            else { L("  ret " + curRet + " " + ZeroConst(curRet)); }
        }
        L("}");
        debugBody = null;
        obody.Append(entryAllocas.ToString());
        obody.Append(body.ToString());
        body = obody; entryAllocas = oea; eaActive = oact;
        curMethodNode = prevMethod;
    }

    void EmitSyncParameters(Node method, List<Node> parameters) {
        if (debugBody != null && curHasThis) {
            DebugVariable(method, "this", MkType(curClass), "%" + curClass + "*", "%this", 1, false);
        }
        int j = 0;
        while (j < parameters.Count) {
            Node p = parameters[j];
            string lt = MapType(p.type);
            string incoming = "%p" + j;
            string slot = incoming;
            if (p.ival == 1) {
                slot = "%ref.p" + j;
                locName.Add(p.sval); locType.Add(p.type); locReg.Add(slot);
                locBox.Add(false); locIter.Add(false); locCell.Add(""); locRef.Add(true);
            } else {
                slot = AddLocal(p.sval, p.type);
                bool borrowed = false;
                if (ShouldBox(p.sval)) { slot = BoxLocal(locName.Count - 1); }
                else {
                    borrowed = BorrowedStrParam(p.type, p.sval, method.d);
                    if (borrowed) { locRef[locName.Count - 1] = true; }
                    EA(slot, lt);
                }
                L("  store " + lt + " " + incoming + ", " + lt + "* " + slot);
                if (!borrowed) { EmitArcRetain(incoming, p.type); }
            }
            if (debugBody != null) {
                DebugVariable(p, p.sval, p.type, lt, slot, j + (curHasThis ? 2 : 1), true);
            }
            j = j + 1;
        }
    }

    void GenCtor(Node cls, Node m) {
        StartFn();
        ScanFlowLabels(m.d);
        // a closure in this constructor may capture its locals
        CollectCapturedNames(m.d, capNames);
        curClass = cls.sval;
        curRet = "void";
        curHasThis = true;
        // a constructor declares no type parameters of its own: the class's
        // apply, so the scope for the constraint lookup is the class
        Node prevMethod = curMethodNode;
        curMethodNode = m;
        string ctorSym = curCtorSym;
        if (ctorSym == "") { ctorSym = CtorSym(cls.sval, m); }
        string sig = "define void @" + ctorSym + "(%" + cls.sval + "* %this";
        List<Node> parameters = new List<Node>();
        int i = 0;
        while (i < m.kids.Count) {
            Node p = m.kids[i];
            if (p.kind == AK.Param()) { parameters.Add(p); }
            i = i + 1;
        }
        int j = 0;
        while (j < parameters.Count) {
            Node p = parameters[j];
            if (p.ival == 1) { sig = sig + ", " + MapType(p.type) + "* %ref.p" + j; }
            else { sig = sig + ", " + MapType(p.type) + " %p" + j; }
            j = j + 1;
        }
        string debugFn = StartDebugFunction(m, ctorSym);
        L(sig + ")" + debugFn + " {");
        L("entry:");
        DemandStaticType(cls.sval, CurInstFor(cls.sval));
        StringBuilder obody = body; StringBuilder oea = entryAllocas; bool oact = eaActive;
        body = new StringBuilder(); entryAllocas = new StringBuilder(); eaActive = true;
        if (debugFn != "") { debugBody = body; }
        EmitSyncParameters(m, parameters);
        // Constructor chaining and the field initializers (C# order):
        //   * `: this(...)` hands the whole job to the target constructor of
        //     the same class: it runs the field initializers and the base
        //     chain, so this constructor runs neither;
        //   * otherwise the base constructor runs first (it runs the base
        //     class' own field initializers), then this class' field
        //     initializers, then the constructor body. When no base
        //     constructor is called the base chain's field initializers run
        //     here instead -- before this class' own.
        if (m.c != null) {
            Node thisTarget = ResolveCtorEx(cls, m.c, m);
            if (thisTarget != null) {
                string targs = "%" + cls.sval + "* %this";
                List<Node> cargs = OrderArgs(thisTarget, m.c);
                int k = 0;
                while (k < cargs.Count) {
                    Node tpty = InstCtorParamType(thisTarget, k);
                    ExprVal av = GenArgExpr(cargs[k], tpty);
                    targs = targs + ", " + MapType(tpty) + " " + CallArg(av, tpty, false);
                    k = k + 1;
                }
                L("  call void @" + CtorCallSym(cls.sval, thisTarget) + "(" + targs + ")");
            } else {
                diags.Error("no matching this constructor with "
                + m.c.kids.Count + " argument(s)", m.line, m.col);
            }
        } else {
            // C# order (A516, mirrored from the host's irgen_emit.c ctor
            // prologue): this class' field initializers run BEFORE the base
            // constructor chain -- a virtual call from a base constructor
            // then reads the derived inline field (42, was 0). The base
            // constructor's own prologue runs the ancestors' initializers.
            EmitFieldInits(cls, "%this");
            Node bcls = BaseClassOf(cls);
            bool baseCalled = false;
            if (bcls != null) {
                // `: base(args)` picks the base constructor by its arguments;
                // without it the parameterless one is taken
                Node bctor = null;
                if (m.b != null) {
                    bctor = ResolveCtor(bcls, m.b);
                    if (bctor == null) {
                        diags.Error("no matching base constructor with "
                        + m.b.kids.Count + " argument(s)", m.line, m.col);
                    }
                } else {
                    bctor = binder.FindCtorArity(bcls, 0);
                }
                if (bctor != null) {
                    string bthis = NT();
                    L("  " + bthis + " = bitcast %" + cls.sval + "* %this to %" + bcls.sval + "*");
                    string bargs = "%" + bcls.sval + "* " + bthis;
                    if (m.b != null) {
                        List<Node> bargsList = OrderArgs(bctor, m.b);
                        int k = 0;
                        while (k < bargsList.Count) {
                            Node bpty = CtorParamType(bctor, k);
                            ExprVal av = GenArgExpr(bargsList[k], bpty);
                            bargs = bargs + ", " + MapType(bpty) + " " + CallArg(av, bpty, false);
                            k = k + 1;
                        }
                    }
                    L("  call void @" + CtorSym(bcls.sval, bctor) + "(" + bargs + ")");
                    baseCalled = true;
                }
            }
            if (!baseCalled && bcls != null && HasChainFieldInits(bcls)) {
                // no base constructor ran: the base chain's field
                // initializers run here, after this class' own (the same
                // d-init -> b-init fallback order the C host's prologue has)
                string bthis = NT();
                L("  " + bthis + " = bitcast %" + cls.sval + "* %this to %" + bcls.sval + "*");
                L("  call void @" + FieldInitsSym(bcls) + "(%" + bcls.sval + "* " + bthis + ")");
            }
        }
        if (m.d != null) { GenStmt(m.d); }
        if (!term) {
            ReleaseLocalsFrom(0);
            L("  ret void");
        }
        L("}");
        debugBody = null;
        obody.Append(entryAllocas.ToString());
        obody.Append(body.ToString());
        body = obody; entryAllocas = oea; eaActive = oact;
        curMethodNode = prevMethod;
    }

    // A static constructor: `static C() { ... }`. It has no receiver and it
    // runs once at program entry, after the class's static field
    // initializers (the C host's order: the field initializers of a class
    // run before that class's static constructor).
    void GenStaticCtor(Node cls, Node m) {
        GenStaticCtorAs(cls, m, StaticCtorSym(cls.sval));
    }

    void GenStaticCtorAs(Node cls, Node m, string sym) {
        StartFn();
        ScanFlowLabels(m.d);
        CollectCapturedNames(m.d, capNames);
        curClass = cls.sval;
        curRet = "void";
        curHasThis = false;
        curRetTy = MkType("void");
        Node prevMethod = curMethodNode;
        curMethodNode = m;
        string debugFn = StartDebugFunction(m, sym);
        L("define internal void @" + sym + "()" + debugFn + " {");
        L("entry:");
        StringBuilder obody = body; StringBuilder oea = entryAllocas; bool oact = eaActive;
        body = new StringBuilder(); entryAllocas = new StringBuilder(); eaActive = true;
        if (debugFn != "") { debugBody = body; }
        if (m.d != null) { GenStmt(m.d); }
        if (!term) {
            ReleaseLocalsFrom(0);
            L("  ret void");
        }
        L("}");
        debugBody = null;
        obody.Append(entryAllocas.ToString());
        obody.Append(body.ToString());
        body = obody; entryAllocas = oea; eaActive = oact;
        curMethodNode = prevMethod;
    }

    // The field initializer helper of `cls`: it runs the instance field
    // initializers of the whole inheritance chain, root first. It stands in
    // for the implicit parameterless constructor: the allocation site calls
    // it when no constructor matches, and a derived constructor calls the
    // base class' helper when the base constructor was not called.
    void GenFieldInitsFn(Node cls) { GenFieldInitsFnAs(cls, FieldInitsSym(cls)); }

    // `sym` overrides the shared symbol: the specialized helper of a generic
    // class (B-ID216) emits under its instantiation-mangled name with the
    // instantiation bound by the drain loop, so the descriptors its
    // initializers build are the concrete ones.
    void GenFieldInitsFnAs(Node cls, string sym) {
        StartFn();
        curClass = cls.sval;
        curRet = "void";
        curHasThis = true;
        L("define void @" + sym + "(%" + cls.sval + "* %this) {");
        L("entry:");
        StringBuilder obody = body; StringBuilder oea = entryAllocas; bool oact = eaActive;
        body = new StringBuilder(); entryAllocas = new StringBuilder(); eaActive = true;
        EmitChainFieldInits(cls, "%this", cls.sval);
        if (!term) { L("  ret void"); }
        L("}");
        obody.Append(entryAllocas.ToString());
        obody.Append(body.ToString());
        body = obody; entryAllocas = oea; eaActive = oact;
    }

    // Emit: if `cond` (an i1) holds, print `msg` and exit(1) -- never falling
    // through with an invalid result. Shared by every I/O return-value check.
    void EmitAbortIf(string cond, string msg, int len) {
        int lf = NL(); int lk = NL();
        L("  br i1 " + cond + ", label %L" + lf + ", label %L" + lk);
        Label(lf);
        string em = NT(); L("  " + em + " = getelementptr inbounds [" + len + " x i8], [" + len + " x i8]* " + msg + ", i64 0, i64 0");
        L("  call i32 (i8*, ...) @printf(i8* " + em + ")");
        L("  call void @exit(i32 1)");
        L("  unreachable");
        Label(lk);
    }

    void EmitFopenCheck(string fp, string msg, int len) {
        string np = NT(); L("  " + np + " = icmp eq i8* " + fp + ", null");
        EmitAbortIf(np, msg, len);
    }

    void GenMainWrapper(Node unit) {
        string owner = "";
        Node mainMeth = null;
        Node mainOwner = null;
        int i = 0;
        while (i < unit.kids.Count) {
            Node d = unit.kids[i];
            if (d.kind == AK.ClassDecl() || d.kind == AK.StructDecl()) {
                Node mm = binder.FindMethod(d, "Main");
                if (mm != null) { owner = d.sval; mainMeth = mm; mainOwner = d; }
            }
            i = i + 1;
        }
        if (mainMeth == null || mainOwner == null) { return; }
        // Validate source types, not just MapType: long/bool also map to i64,
        // but are not legal entry results. Async Task<T> carries T in slot 6.
        bool asyncMain = IsAsync(mainMeth);
        Node resultTy = mainMeth.type;
        bool valid = IsStatic(mainMeth) && mainMeth.d != null && resultTy != null;
        if (asyncMain && resultTy != null && resultTy.sval == "Task") {
            if (resultTy.ival != 0 || resultTy.op != 0 || resultTy.kids.Count > 1) { valid = false; }
            resultTy = AsyncElemTyOf(resultTy);
        }
        if (resultTy == null) { valid = false; }
        else if (resultTy.ival != 0 || resultTy.op != 0 || resultTy.kids.Count != 0
        || (resultTy.sval != "void" && resultTy.sval != "int")) { valid = false; }
        Node argsTy = null;
        int paramCount = 0;
        i = 0;
        while (i < mainMeth.kids.Count) {
            Node p = mainMeth.kids[i];
            if (p.kind == AK.TypeParam()) { valid = false; }
            if (p.kind == AK.Param()) {
                paramCount = paramCount + 1;
                argsTy = p.type;
                if (p.ival != 0 || argsTy == null) { valid = false; }
                else if (argsTy.sval != "string" || argsTy.ival != 1
                || ArrRankOf(argsTy) != 1 || argsTy.kids.Count != 0) { valid = false; }
            }
            i = i + 1;
        }
        i = 0;
        while (i < mainOwner.kids.Count) {
            if (mainOwner.kids[i].kind == AK.TypeParam()) { valid = false; }
            i = i + 1;
        }
        if (paramCount > 1) { valid = false; }
        if (!valid) {
            diags.Error("entry point 'Main' must be a non-generic static method returning void or int (or async Task/Task<int>), with no parameters or one string[] parameter passed by value", mainMeth.line, mainMeth.col);
            return;
        }
        string mainSym = MethodSym(owner, mainMeth);
        L("define i32 @main(i32 %argc, i8** %argv) {");
        L("entry:");
        StringBuilder obody = body; StringBuilder oea = entryAllocas; bool oact = eaActive;
        body = new StringBuilder(); entryAllocas = new StringBuilder(); eaActive = true;
        // This synthetic wrapper has no StartFn/locals-table lifetime. Give
        // its one owner an explicit entry slot, independent of method locals.
        string argsOwner = "";
        if (argsTy != null) {
            argsOwner = NT();
            L("  " + argsOwner + " = alloca i64*");
            L("  store i64* null, i64** " + argsOwner);
        }
        string mainArgc = "%argc";
        string mainArgv = "%argv";
        if (hostWin) {
            string argcSlot = NT(); string argvSlot = NT();
            L("  " + argcSlot + " = alloca i32");
            L("  " + argvSlot + " = alloca i8**");
            L("  store i32 %argc, i32* " + argcSlot);
            L("  store i8** %argv, i8*** " + argvSlot);
            L("  call i32 @zan_utf8_argv(i32* " + argcSlot + ", i8*** " + argvSlot + ")");
            mainArgc = NT(); mainArgv = NT();
            L("  " + mainArgc + " = load i32, i32* " + argcSlot);
            L("  " + mainArgv + " = load i8**, i8*** " + argvSlot);
        }
        L("  store i32 " + mainArgc + ", i32* @__zan_argc");
        L("  store i8** " + mainArgv + ", i8*** @__zan_argv");
        // Match C host stdout buffering (emit_main.c): delegate to runtime
        // zan_rt_stdout_setup (unbuffered/line-buffered for pipes/TTYs, block-
        // buffered for files) with a weak fallback to setvbuf.
        if (!ExternSeen("zan_rt_stdout_setup")) {
            externDecls.Add("zan_rt_stdout_setup");
            if (!ExternSeen("setvbuf")) {
                externDecls.Add("setvbuf");
                H("declare i32 @setvbuf(i8*, i8*, i32, i64)");
            }
            H("define weak void @zan_rt_stdout_setup(i8* %f, i32 %mode, i64 %sz) {");
            H("entry:");
            H("  call i32 @setvbuf(i8* %f, i8* null, i32 %mode, i64 %sz)");
            H("  ret void");
            H("}");
        }
        string outPtr = NT();
        if (hostWin) {
            if (!ExternSeen("__acrt_iob_func")) {
                externDecls.Add("__acrt_iob_func");
                H("declare i8* @__acrt_iob_func(i32)");
            }
            L("  " + outPtr + " = call i8* @__acrt_iob_func(i32 1)");
            L("  call void @zan_rt_stdout_setup(i8* " + outPtr + ", i32 4, i64 0)");
        } else {
            string sg = PosixStdStream(1);
            L("  " + outPtr + " = load i8*, i8** " + sg);
            L("  call void @zan_rt_stdout_setup(i8* " + outPtr + ", i32 1, i64 4096)");
        }
        // Programs emit UTF-8 bytes; switch the Windows console to code page
        // 65001 so CJK/accented output renders instead of mojibake. Redirected
        // output (pipe/file) keeps its raw UTF-8 bytes.
        if (hostWin) {
            L("  call i32 @SetConsoleOutputCP(i32 65001)");
            L("  call i32 @SetConsoleCP(i32 65001)");
        }
        // The linked scheduler installs its own ready hook for timer wakeups.
        // With the differential runtime the weak init selects the fallback;
        // the shipped runtime provides the strong init and worker scheduler.
        L("  call void @zan_co_sched_init()");
        if (checkLeaks) { L("  call i32 @atexit(void ()* @zarc_report_leaks)"); }
        // Install a root exception handler so an uncaught throw prints a
        // message and exits 1 instead of longjmp-ing through an empty stack.
        // B-ID199 round4: this used to setjmp into a local alloca recorded
        // in @__exc_stack -- the one writer that broke the "stack entry ==
        // &bufs[depth]" invariant and blocked retiring @__exc_stack when
        // the frame store went heap-backed. It now arms the shared heap
        // frame like every other push, so the frame address stays
        // derivable from the depth alone.
        string rsp = NT(); L("  " + rsp + " = load i64, i64* @__exc_sp");
        string rneed = NT(); L("  " + rneed + " = add i64 " + rsp + ", 1");
        L("  call void @__exc_grow(i64 " + rneed + ")");
        string rbp = EmitFrameBuf(rsp);
        EmitPendingHandlerMark(rsp);
        string rsp1 = NT(); L("  " + rsp1 + " = add i64 " + rsp + ", 1");
        L("  store i64 " + rsp1 + ", i64* @__exc_sp");
        string rr = NT(); L("  " + rr + " = call i32 @_setjmp(i8* " + rbp + ", i8* null)");
        string rc = NT(); L("  " + rc + " = icmp ne i32 " + rr + ", 0");
        int lbody = NL(); int lcatch = NL();
        L("  br i1 " + rc + ", label %L" + lcatch + ", label %L" + lbody);
        Label(lbody);
        // Arm AFTER the root handler's watermark: an uncaught throw unwinds
        // this owner through zexc_owners, including a partially filled array.
        if (argsTy != null) { ArmLocalSlot(argsOwner, argsTy, false); }
        if (!libOut) { EmitStaticInits(unit); }
        string mainArgs = "";
        if (argsTy != null) {
            string argc64 = NT(); string rawCount = NT(); string hasArgs = NT(); string count = NT();
            L("  " + argc64 + " = sext i32 " + mainArgc + " to i64");
            L("  " + rawCount + " = sub i64 " + argc64 + ", 1");
            L("  " + hasArgs + " = icmp sgt i64 " + rawCount + ", 0");
            L("  " + count + " = select i1 " + hasArgs + ", i64 " + rawCount + ", i64 0");
            string args = ArrayAllocate(argsTy, count);
            L("  store i64* " + args + ", i64** " + argsOwner);
            string pred = curLbl;
            int loop = NL(); int fill = NL(); int done = NL();
            string index = NT(); string next = NT();
            L("  br label %L" + loop);
            Label(loop);
            L("  " + index + " = phi i64 [ 0, %" + pred + " ], [ " + next + ", %L" + fill + " ]");
            string more = NT(); L("  " + more + " = icmp slt i64 " + index + ", " + count);
            L("  br i1 " + more + ", label %L" + fill + ", label %L" + done);
            Label(fill);
            string argIndex = NT(); L("  " + argIndex + " = add i64 " + index + ", 1");
            string argSlot = NT(); L("  " + argSlot + " = getelementptr i8*, i8** " + mainArgv + ", i64 " + argIndex);
            string rawArg = NT(); L("  " + rawArg + " = load i8*, i8** " + argSlot);
            string managed = NT(); L("  " + managed + " = call i8* @zstr_of(i8* " + rawArg + ")");
            // zstr_of creates +1; transfer it to this zeroed element slot.
            string bits = NT(); L("  " + bits + " = ptrtoint i8* " + managed + " to i64");
            string elemSlot = NT(); L("  " + elemSlot + " = getelementptr i64, i64* " + args + ", i64 " + index);
            L("  store i64 " + bits + ", i64* " + elemSlot);
            L("  " + next + " = add i64 " + index + ", 1");
            L("  br label %L" + loop);
            Label(done);
            mainArgs = "i64* " + args;
        }
        string exitCode = "0";
        if (asyncMain) {
            // The ramp retains its parameters. Keep the wrapper's own array
            // reference through the pump as well, including exceptional exit.
            string fr = NT(); L("  " + fr + " = call i8* @" + mainSym + "(" + mainArgs + ")");
            string rs = NT(); L("  " + rs + " = ptrtoint void(i8*)* @" + mainSym + "$resume to i64");
            string rf = NT(); L("  " + rf + " = inttoptr i64 " + rs + " to void(i8*)*");
            L("  call void @zan_co_ready(i8* " + fr + ", void(i8*)* " + rf + ")");
            L("  call void @zan_co_sched_run()");
            string mainHeader = NT(); L("  " + mainHeader + " = bitcast i8* " + fr + " to i64*");
            EmitAwaitCheckExc(mainHeader);
            if (resultTy.sval == "int") {
                // Read the result before releasing the completed frame.
                string rp = FrameGep(mainHeader, 6);
                string ri = NT(); L("  " + ri + " = load i64, i64* " + rp);
                exitCode = NT(); L("  " + exitCode + " = trunc i64 " + ri + " to i32");
            }
            L("  call void @zexc_frame_free(i8* " + fr + ")");
        } else if (resultTy.sval == "int") {
            string result = NT(); L("  " + result + " = call i64 @" + mainSym + "(" + mainArgs + ")");
            exitCode = NT(); L("  " + exitCode + " = trunc i64 " + result + " to i32");
        } else {
            L("  call void @" + mainSym + "(" + mainArgs + ")");
        }
        if (argsTy != null) {
            RetireLocalSlot(argsOwner, "i64*");
            string args = NT(); L("  " + args + " = load i64*, i64** " + argsOwner);
            L("  store i64* null, i64** " + argsOwner);
            EmitArcRelease(args, argsTy);
        }
        if (checkLeaks && !libOut) { L("  call void @zarc_drop_statics()"); }
        L("  ret i32 " + exitCode);
        Label(lcatch);
        string mp = NT(); L("  " + mp + " = getelementptr inbounds [25 x i8], [25 x i8]* @.msg.unhandled, i64 0, i64 0");
        string xv = NT(); L("  " + xv + " = load i8*, i8** @__exc_val");
        string xn = NT(); L("  " + xn + " = icmp eq i8* " + xv + ", null");
        int lmsg_null = NL();
        int lmsg_ok = NL();
        int lmsg_done = NL();
        L("  br i1 " + xn + ", label %L" + lmsg_null + ", label %L" + lmsg_ok);
        Label(lmsg_ok);
        string xvp = NT(); L("  " + xvp + " = bitcast i8* " + xv + " to i8**");
        string mslot = NT(); L("  " + mslot + " = getelementptr i8*, i8** " + xvp + ", i64 1");
        string mval = NT(); L("  " + mval + " = load i8*, i8** " + mslot);
        string mn = NT(); L("  " + mn + " = icmp eq i8* " + mval + ", null");
        string mx = NT(); L("  " + mx + " = select i1 " + mn + ", i8* getelementptr inbounds ([13 x i8], [13 x i8]* @.msg.exnil, i64 0, i64 0), i8* " + mval);
        L("  br label %L" + lmsg_done);
        Label(lmsg_null);
        string mnil = NT(); L("  " + mnil + " = getelementptr inbounds [13 x i8], [13 x i8]* @.msg.exnil, i64 0, i64 0");
        L("  br label %L" + lmsg_done);
        Label(lmsg_done);
        string xm = NT(); L("  " + xm + " = phi i8* [ " + mx + ", %L" + lmsg_ok + " ], [ " + mnil + ", %L" + lmsg_null + " ]");
        L("  call i32 (i8*, ...) @printf(i8* " + mp + ", i8* " + xm + ")");
        L("  call void @zexc_drop(%zan.exception* @zexc_dispatch)");
        if (checkLeaks && !libOut) { L("  call void @zarc_drop_statics()"); }
        L("  ret i32 1");
        L("}");
        obody.Append(entryAllocas.ToString());
        obody.Append(body.ToString());
        body = obody; entryAllocas = oea; eaActive = oact;
    }

    // A string parameter the body never writes: borrowed for the call.
    bool BorrowedStrParam(Node ty, string name, Node body) {
        if (ty == null || ty.ival != 0 || !IsStr(ty) || body == null) { return false; }
        return !WritesName(body, name);
    }

    // Does the subtree assign `name` (plain or compound assignment, or a
    // ref/out argument)? Conservative: any write anywhere counts, including
    // one to a shadowing local of the same name.
    bool WritesName(Node n, string name) {
        if (n == null) { return false; }
        if ((n.kind == AK.Assignment() || n.kind == AK.OutArg()) && n.a != null
            && n.a.kind == AK.Ident() && n.a.sval == name) { return true; }
        if (WritesName(n.a, name) || WritesName(n.b, name) || WritesName(n.c, name) || WritesName(n.d, name)) { return true; }
        if (n.kids != null) {
            int i = 0;
            while (i < n.kids.Count) {
                if (WritesName(n.kids[i], name)) { return true; }
                i = i + 1;
            }
        }
        return false;
    }
}
