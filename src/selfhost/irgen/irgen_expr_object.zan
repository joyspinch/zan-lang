using System;
using System.Collections.Generic;
namespace Zan;

partial class Irgen {
    // A558: System.Object fallback family (ToString/Equals/GetHashCode)
    ExprVal EmitObjectFamilyCall(ExprVal recv, string name, Node e) {
        string rty = MapType(recv.ty);
        string recvRaw = NT();
        if (rty == "i8*") {
            recvRaw = recv.op;
        } else {
            L("  " + recvRaw + " = bitcast " + rty + " " + recv.op + " to i8*");
        }

        Node retTy = MkType("string");
        string rt = "i8*";
        int wantArgs = 0;
        if (name == "Equals") {
            retTy = MkType("bool");
            rt = "i64";
            wantArgs = 1;
        } else if (name == "GetHashCode") {
            retTy = MkType("int");
            rt = "i64";
            wantArgs = 0;
        }

        ExprVal argVal = null;
        string argRaw = "";
        if (wantArgs == 1 && e.kids.Count > 0) {
            argVal = GenExpr(e.kids[0]);
            string aty = MapType(argVal.ty);
            if (aty == "i8*") {
                argRaw = argVal.op;
            } else {
                argRaw = NT();
                L("  " + argRaw + " = bitcast " + aty + " " + argVal.op + " to i8*");
            }
        }

        // Fast path for static concrete classes with no override:
        if (recv.ty != null && recv.ty.sval != "object" && recv.ty.sval != "") {
            Node scls = binder.FindType(recv.ty.sval);
            if (scls != null && (scls.kind == AK.ClassDecl() || scls.kind == AK.StructDecl())) {
                Node sm = ResolveMethodUp(scls, name, e, false);
                if (sm == null) {
                    if (name == "ToString") {
                        ExprVal ns = GenStr(scls.sval);
                        return ns;
                    }
                    if (name == "Equals") {
                        string eq = NT();
                        L("  " + eq + " = icmp eq i8* " + recvRaw + ", " + argRaw);
                        string eq64 = NT();
                        L("  " + eq64 + " = zext i1 " + eq + " to i64");
                        return new ExprVal(eq64, retTy);
                    }
                    if (name == "GetHashCode") {
                        string pi = NT();
                        L("  " + pi + " = ptrtoint i8* " + recvRaw + " to i64");
                        string sh = NT();
                        L("  " + sh + " = lshr i64 " + pi + ", 4");
                        string mix = NT();
                        L("  " + mix + " = mul i64 " + sh + ", 2654435769");
                        return new ExprVal(mix, retTy);
                    }
                }
            }
        }

        // Dynamic dispatch for object receivers: collect candidates that implement/override `name`
        List<Node> cands = new List<Node>();
        List<Node> candMeths = new List<Node>();
        List<string> candImpls = new List<string>();
        int ti = 0;
        while (ti < binder.types.Count) {
            Node c = binder.types[ti];
            bool isCls = (c.kind == AK.ClassDecl() || c.kind == AK.StructDecl());
            if (isCls && !HasMod(c, MOD.Abstract()) && !HasMod(c, MOD.Iface()) && IsPolyClass(c)) {
                Node im = FindMethodUp(c, name);
                if (im != null && !IsAbstract(im) && (im.mods & MOD.Static()) == 0) {
                    int pcount = 0;
                    int pi = 0;
                    while (pi < im.kids.Count) {
                        if (im.kids[pi].kind == AK.Param()) { pcount = pcount + 1; }
                        pi = pi + 1;
                    }
                    if (pcount == wantArgs) {
                        string impl = DeclOwnerOf(c, im);
                        if (impl == "") { impl = c.sval; }
                        cands.Add(c);
                        candMeths.Add(im);
                        candImpls.Add(impl);
                    }
                }
            }
            ti = ti + 1;
        }

        string resSlot = NT();
        EA(resSlot, rt);
        int lend = NL();
        int ldef = NL();

        if (cands.Count > 0) {
            string tagp = NT();
            L("  " + tagp + " = bitcast i8* " + recvRaw + " to i8**");
            string tag = NT();
            L("  " + tag + " = load i8*, i8** " + tagp);

            int ci = 0;
            while (ci < cands.Count) {
                Node candCls = cands[ci];
                Node candMeth = candMeths[ci];
                string impl = candImpls[ci];
                List<string> vslots = new List<string>();
                CollectVSlots(candCls, vslots);

                int lmatch = NL();
                int lnext = NL();
                string cmp = NT();
                L("  " + cmp + " = icmp eq i8* " + tag + ", bitcast ([" + vslots.Count + " x i8*]* @" + candCls.sval + "_vtable to i8*)");
                L("  br i1 " + cmp + ", label %L" + lmatch + ", label %L" + lnext);
                Label(lmatch);

                string thisPtr = NT();
                L("  " + thisPtr + " = bitcast i8* " + recvRaw + " to %" + impl + "*");
                string callArgs = "%" + impl + "* " + thisPtr;
                if (wantArgs == 1) {
                    Node paramTy = null;
                    int pidx = 0;
                    while (pidx < candMeth.kids.Count) {
                        if (candMeth.kids[pidx].kind == AK.Param()) { paramTy = candMeth.kids[pidx].type; break; }
                        pidx = pidx + 1;
                    }
                    string pty = (paramTy != null) ? MapType(paramTy) : "i8*";
                    string aPtr = argRaw;
                    if (pty != "i8*") {
                        aPtr = NT();
                        L("  " + aPtr + " = bitcast i8* " + argRaw + " to " + pty);
                    }
                    callArgs = callArgs + ", " + pty + " " + aPtr;
                }

                string callRes = NT();
                string mty = MapType(candMeth.type);
                L("  " + callRes + " = call " + mty + " @" + MethodSym(impl, candMeth) + "(" + callArgs + ")");
                if (mty != rt) {
                    if (rt == "i64" && mty == "i1") {
                        string z64 = NT();
                        L("  " + z64 + " = zext i1 " + callRes + " to i64");
                        callRes = z64;
                    } else if (rt == "i64" && mty == "i32") {
                        string s64 = NT();
                        L("  " + s64 + " = sext i32 " + callRes + " to i64");
                        callRes = s64;
                    }
                }
                L("  store " + rt + " " + callRes + ", " + rt + "* " + resSlot);
                L("  br label %L" + lend);
                Label(lnext);
                ci = ci + 1;
            }
        }

        L("  br label %L" + ldef);
        Label(ldef);

        if (name == "Equals") {
            string eq = NT();
            L("  " + eq + " = icmp eq i8* " + recvRaw + ", " + argRaw);
            string eq64 = NT();
            L("  " + eq64 + " = zext i1 " + eq + " to i64");
            L("  store i64 " + eq64 + ", i64* " + resSlot);
        } else if (name == "GetHashCode") {
            string pi = NT();
            L("  " + pi + " = ptrtoint i8* " + recvRaw + " to i64");
            string sh = NT();
            L("  " + sh + " = lshr i64 " + pi + ", 4");
            string mix = NT();
            L("  " + mix + " = mul i64 " + sh + ", 2654435769");
            L("  store i64 " + mix + ", i64* " + resSlot);
        } else if (name == "ToString") {
            string cid = NT();
            L("  " + cid + " = call i8* @__zan_class_id(i8* " + recvRaw + ")");
            int di = 0;
            int ldone = NL();
            while (di < tidNames.Count) {
                string cn = tidNames[di];
                int lhit = NL();
                int lmiss = NL();
                string cmp = NT();
                L("  " + cmp + " = icmp eq i8* " + cid + ", bitcast (i8** @__tid_" + cn + " to i8*)");
                L("  br i1 " + cmp + ", label %L" + lhit + ", label %L" + lmiss);
                Label(lhit);
                ExprVal sval = GenStr(cn);
                L("  store i8* " + sval.op + ", i8** " + resSlot);
                L("  br label %L" + ldone);
                Label(lmiss);
                di = di + 1;
            }
            ExprVal defObj = GenStr("object");
            L("  store i8* " + defObj.op + ", i8** " + resSlot);
            L("  br label %L" + ldone);
            Label(ldone);
        }

        L("  br label %L" + lend);
        Label(lend);
        string finalVal = NT();
        L("  " + finalVal + " = load " + rt + ", " + rt + "* " + resSlot);
        if (name == "ToString") {
            AddTemp(finalVal, retTy);
        }
        return new ExprVal(finalVal, retTy);
    }
}
