using System;
using System.Collections.Generic;
namespace Zan;

partial class Irgen {
    void EmitDirRuntime() {
        if (!ExternSeen("zan_exe_dir_into")) { externDecls.Add("zan_exe_dir_into"); H("declare i64 @zan_exe_dir_into(i8*, i64)"); }
        if (!ExternSeen("zan_dir_list_into")) { externDecls.Add("zan_dir_list_into"); H("declare i64 @zan_dir_list_into(i8*, i8*, i64)"); }
        H("define i8* @zan_exe_dir() {");
        H("entry:");
        H("  %buf = call i8* @malloc(i64 1024)");
        H("  %n = call i64 @zan_exe_dir_into(i8* %buf, i64 1024)");
        H("  ret i8* %buf");
        H("}");
        H("define i8* @zan_dir_list(i8* %pat) {");
        H("entry:");
        H("  %buf = call i8* @malloc(i64 65536)");
        H("  %n = call i64 @zan_dir_list_into(i8* %pat, i8* %buf, i64 65536)");
        H("  ret i8* %buf");
        H("}");
    }
    void EmitAsyncRuntime() {
        EmitAsyncUnwindClock();
        EmitAsyncPumpReady();
        EmitAsyncSchedRun();
    }

    /// Coroutine unwinder, IO/gate co declares, and the monotonic clock
    /// (__zan_co_now_ms + zan_io_pump_timeout, platform-branched).
    void EmitAsyncUnwindClock() {
        // Exception unwinder for suspended coroutines: a throw longjmps
        // straight to its handler, skipping suspended CPS frames in between.
        // Walk the awaiter chain from the throwing frame calling each frame's
        // cleanup (releases owned slots + frees the frame), stopping at the
        // first frame with an armed try handler (hcount > 0) -- the handler
        // resumes inside it.
        H("define internal void @__zan_async_unwind(i8* %self) {");
        H("entry:");
        H("  %cur.a = alloca i8*");
        H("  store i8* %self, i8** %cur.a");
        H("  br label %head");
        H("head:");
        H("  %cur = load i8*, i8** %cur.a");
        H("  %nn = icmp ne i8* %cur, null");
        H("  br i1 %nn, label %body, label %done");
        H("body:");
        H("  %hf = bitcast i8* %cur to i64*");
        H("  %hcp = getelementptr i64, i64* %hf, i64 8");
        H("  %hc = load i64, i64* %hcp");
        H("  %armed = icmp sgt i64 %hc, 0");
        H("  br i1 %armed, label %done, label %clean");
        H("clean:");
        H("  %awp = getelementptr i64, i64* %hf, i64 4");
        H("  %awi = load i64, i64* %awp");
        H("  %aw = inttoptr i64 %awi to i8*");
        H("  %det = icmp eq i8* %aw, %cur");
        H("  %nxt = select i1 %det, i8* null, i8* %aw");
        H("  %clp = getelementptr i64, i64* %hf, i64 7");
        H("  %cli = load i64, i64* %clp");
        H("  %cl = inttoptr i64 %cli to void(i8*)*");
        H("  %has = icmp ne void(i8*)* %cl, null");
        H("  br i1 %has, label %docall, label %next");
        H("docall:");
        H("  call void %cl(i8* %cur)");
        H("  br label %next");
        H("next:");
        H("  store i8* %nxt, i8** %cur.a");
        H("  br label %head");
        H("done:");
        H("  ret void");
        H("}");
        // EmitAsyncSchedRun defines this module's weak scheduler below;
        // LLVM textual IR must not also contain a declaration of that symbol.
        H("declare void @zan_task_frame_config(i8*, i32*, i32*)");
        H("declare void @zan_task_child(i8*, i8*)");
        H("declare void @zan_task_cancel(i64)");
        H("declare i64 @zan_task_register(i8*, i32*)");
        H("declare i32 @zan_task_isdone(i64)");
        H("declare i8* @zan_task_acquire(i64, i32)");
        H("declare void @zan_task_unpin(i8*)");
        H("declare void @zan_task_discard_config(i8*, void(i8*)*)");
        H("declare void @zan_task_discard(i8*)");
        H("declare void @zan_task_retire(i8*, void(i8*)*)");
        H("declare i64 @zan_join_new(i32, i32)");
        H("declare i32 @zan_join_bind(i64, i8*, i32)");
        H("declare void @zan_join_cancel(i64)");
        H("declare void @zan_io_wait_co(i64, i32, i8*, void(i8*)*)");
        H("declare void @zan_gate_park(i64, i8*, void(i8*)*)");
        H("declare void @zan_gate_park_ticket(i64, i64, i8*, void(i8*)*)");
        H("declare void @zan_io_recv_co(i64, i8*, i32, i8*, void(i8*)*, i64*)");
        H("declare void @zan_io_recv_to_co(i64, i8*, i32, i64, i8*, void(i8*)*, i64*)");
        H("declare void @zan_io_accept_co(i64, i8*, void(i8*)*, i64*)");
        H("declare void @zan_io_resolve_sa_co(i8*, i32, i8*, i32, i8*, void(i8*)*, i32*)");
        H("declare void @zan_io_resolve_co(i8*, i8*, void(i8*)*, i32*)");
        if (hostWin) {
            if (!ExternSeen("GetTickCount64")) { externDecls.Add("GetTickCount64"); H("declare i64 @GetTickCount64()"); }
            if (!ExternSeen("Sleep")) { externDecls.Add("Sleep"); H("declare void @Sleep(i64)"); }
        } else {
            if (!ExternSeen("gettimeofday")) { externDecls.Add("gettimeofday"); H("declare i32 @gettimeofday(i8*, i8*)"); }
            if (!ExternSeen("usleep")) { externDecls.Add("usleep"); H("declare i32 @usleep(i32)"); }
        }
        H("%co_node = type { i8*, i8*, i8* }");
        H("%co_timer = type { i8*, i64, i8*, i8* }");
        H("@co_head = global i8* null");
        H("@co_tail = global i8* null");
        H("@co_timers = global i8* null");
        if (hostWin) {
            H("define internal i64 @__zan_co_now_ms() {");
            H("entry:");
            H("  %n = call i64 @GetTickCount64()");
            H("  ret i64 %n");
            H("}");
            H("define weak i32 @zan_io_pump_timeout(i64 %timeout) {");
            H("entry:");
            H("  %pos = icmp sgt i64 %timeout, 0");
            H("  br i1 %pos, label %sleep, label %ret");
            H("sleep:");
            H("  call void @Sleep(i64 %timeout)");
            H("  br label %ret");
            H("ret:");
            H("  ret i32 0");
            H("}");
        } else {
            H("define internal i64 @__zan_co_now_ms() {");
            H("entry:");
            H("  %tv = alloca [2 x i64]");
            H("  %tvp = bitcast [2 x i64]* %tv to i8*");
            H("  call i32 @gettimeofday(i8* %tvp, i8* null)");
            H("  %secp = getelementptr [2 x i64], [2 x i64]* %tv, i64 0, i64 0");
            H("  %usecp = getelementptr [2 x i64], [2 x i64]* %tv, i64 0, i64 1");
            H("  %sec = load i64, i64* %secp");
            H("  %usec = load i64, i64* %usecp");
            H("  %ms1 = mul i64 %sec, 1000");
            H("  %ms2 = sdiv i64 %usec, 1000");
            H("  %n = add i64 %ms1, %ms2");
            H("  ret i64 %n");
            H("}");
            H("define weak i32 @zan_io_pump_timeout(i64 %timeout) {");
            H("entry:");
            H("  %pos = icmp sgt i64 %timeout, 0");
            H("  br i1 %pos, label %sleep, label %ret");
            H("sleep:");
            H("  %us64 = mul i64 %timeout, 1000");
            H("  %us = trunc i64 %us64 to i32");
            H("  call i32 @usleep(i32 %us)");
            H("  br label %ret");
            H("ret:");
            H("  ret i32 0");
            H("}");
        }
    }

    /// zan_io_pump / zan_co_sched_init / __zan_co_reap / zan_co_ready /
    /// zan_co_delay.
    ///
    /// 这里的协程调度器是「回退实现」：与 C 宿主的 zan_runtime_fallback
    /// 同法，必须用 weak 链接——链接了 C 运行时（rt_io.o/rt_co.o 提供同名
    /// 强符号）时由运行时那份生效，未链接运行时时用自带这份。否则两边
    /// 同时定义会 LNK2005。
    void EmitAsyncPumpReady() {
        H("define weak i32 @zan_io_pump() {");
        H("entry:");
        H("  %w = call i32 @zan_io_pump_timeout(i64 -1)");
        H("  ret i32 %w");
        H("}");
        H("define weak void @zan_co_sched_init() {");
        H("entry:");
        H("  store i8* null, i8** @co_head");
        H("  store i8* null, i8** @co_tail");
        H("  store i8* null, i8** @co_timers");
        H("  ret void");
        H("}");
        H("define internal void @__zan_co_reap(i8* %f) {");
        H("entry:");
        H("  call void @zexc_frame_free(i8* %f)");
        H("  ret void");
        H("}");
        // Releasing a coroutine frame goes through the runtime's protocol:
        // the shipped runtime marks the frame dead (CO_DEAD) before freeing
        // it, so its scheduler never touches a freed frame header. The weak
        // fallback (no shipped runtime linked) frees it directly.
        H("define internal void @zexc_frame_free(i8* %p) {");
        H("entry:");
        H("  %f = bitcast i8* %p to i64*");
        H("  %ep = getelementptr i64, i64* %f, i64 14");
        H("  %error = bitcast i64* %ep to %zan.exception*");
        H("  call void @zexc_drop(%zan.exception* %error)");
        H("  %saved = load i8*, i8** @zexc_owners");
        H("  %op = getelementptr i64, i64* %f, i64 18");
        H("  %ob = load i64, i64* %op");
        H("  store i64 0, i64* %op");
        H("  %owner = inttoptr i64 %ob to i8*");
        H("  store i8* %owner, i8** @zexc_owners");
        H("  call void @zexc_unwind(i8* null)");
        H("  store i8* %saved, i8** @zexc_owners");
        H("  call void @__zan_co_frame_free(i8* %p)");
        H("  ret void");
        H("}");
        H("define weak i8* @__zan_co_frame_alloc(i64 %size) {");
        H("entry:");
        H("  %p = call i8* @calloc(i64 1, i64 %size)");
        H("  ret i8* %p");
        H("}");
        H("define weak void @__zan_co_frame_free(i8* %p) {");
        H("entry:");
        H("  call void @zan_task_retire(i8* %p, void(i8*)* @free)");
        H("  ret void");
        H("}");
        H("define weak void @zan_co_ready(i8* %frame, void(i8*)* %step) {");
        H("entry:");
        H("  %n = call i8* @malloc(i64 24)");
        H("  %np = bitcast i8* %n to %co_node*");
        H("  %nx = getelementptr %co_node, %co_node* %np, i32 0, i32 0");
        H("  store i8* null, i8** %nx");
        H("  %frp = getelementptr %co_node, %co_node* %np, i32 0, i32 1");
        H("  store i8* %frame, i8** %frp");
        H("  %stp = getelementptr %co_node, %co_node* %np, i32 0, i32 2");
        H("  %si = bitcast void(i8*)* %step to i8*");
        H("  store i8* %si, i8** %stp");
        H("  %tail = load i8*, i8** @co_tail");
        H("  %isempty = icmp eq i8* %tail, null");
        H("  br i1 %isempty, label %sethead, label %appendtail");
        H("sethead:");
        H("  store i8* %n, i8** @co_head");
        H("  store i8* %n, i8** @co_tail");
        H("  ret void");
        H("appendtail:");
        H("  %tp = bitcast i8* %tail to %co_node*");
        H("  %tnx = getelementptr %co_node, %co_node* %tp, i32 0, i32 0");
        H("  store i8* %n, i8** %tnx");
        H("  store i8* %n, i8** @co_tail");
        H("  ret void");
        H("}");
        H("define weak void @zan_co_ready_batch(i8* %tasks, i64 %count) {");
        H("entry:");
        H("  %cmp = icmp ule i64 %count, 0");
        H("  br i1 %cmp, label %done, label %loop");
        H("loop:");
        H("  %i = phi i64 [ 0, %entry ], [ %next, %body ]");
        H("  %done_check = icmp ult i64 %i, %count");
        H("  br i1 %done_check, label %body, label %done");
        H("body:");
        H("  %off_bytes = mul i64 %i, 16");
        H("  %task_ptr = getelementptr i8, i8* %tasks, i64 %off_bytes");
        H("  %task_i8p = bitcast i8* %task_ptr to i8**");
        H("  %frame = load i8*, i8** %task_i8p");
        H("  %step_slot = getelementptr i8*, i8** %task_i8p, i64 1");
        H("  %step_i8 = load i8*, i8** %step_slot");
        H("  %step = bitcast i8* %step_i8 to void (i8*)*");
        H("  call void @zan_co_ready(i8* %frame, void (i8*)* %step)");
        H("  %next = add i64 %i, 1");
        H("  br label %loop");
        H("done:");
        H("  ret void");
        H("}");
        H("define weak void @zan_co_delay(i64 %ms, i8* %frame, void(i8*)* %step) {");
        H("entry:");
        H("  %raw = call i8* @malloc(i64 32)");
        H("  %tn = bitcast i8* %raw to %co_timer*");
        H("  %old = load i8*, i8** @co_timers");
        H("  %tnp = getelementptr %co_timer, %co_timer* %tn, i32 0, i32 0");
        H("  store i8* %old, i8** %tnp");
        H("  %now = call i64 @__zan_co_now_ms()");
        H("  %pos = icmp sgt i64 %ms, 0");
        H("  %delay = select i1 %pos, i64 %ms, i64 0");
        H("  %deadline = add i64 %now, %delay");
        H("  %tdp = getelementptr %co_timer, %co_timer* %tn, i32 0, i32 1");
        H("  store i64 %deadline, i64* %tdp");
        H("  %tfp = getelementptr %co_timer, %co_timer* %tn, i32 0, i32 2");
        H("  store i8* %frame, i8** %tfp");
        H("  %tsp = getelementptr %co_timer, %co_timer* %tn, i32 0, i32 3");
        H("  %si = bitcast void(i8*)* %step to i8*");
        H("  store i8* %si, i8** %tsp");
        H("  store i8* %raw, i8** @co_timers");
        H("  ret void");
        H("}");
    }

    /// The cooperative scheduler main loop (zan_co_sched_run / zan_co_sched_run_until).
    void EmitAsyncSchedRun() {
        H("define weak void @zan_co_sched_run_until(i32* %done) {");
        H("entry:");
        H("  %a.best = alloca i8*");
        H("  %a.bestprev = alloca i8*");
        H("  %a.cur = alloca i8*");
        H("  %a.curprev = alloca i8*");
        H("  br label %loop");
        H("loop:");
        H("  %dchk = icmp ne i32* %done, null");
        H("  br i1 %dchk, label %dtest, label %qcheck");
        H("dtest:");
        H("  %dv = load i32, i32* %done");
        H("  %disd = icmp ne i32 %dv, 0");
        H("  br i1 %disd, label %exit, label %qcheck");
        H("qcheck:");
        H("  %head = load i8*, i8** @co_head");
        H("  %qe = icmp eq i8* %head, null");
        H("  br i1 %qe, label %timers, label %body");
        H("body:");
        H("  %hp = bitcast i8* %head to %co_node*");
        H("  %frpb = getelementptr %co_node, %co_node* %hp, i32 0, i32 1");
        H("  %fr = load i8*, i8** %frpb");
        H("  %stpb = getelementptr %co_node, %co_node* %hp, i32 0, i32 2");
        H("  %sti8 = load i8*, i8** %stpb");
        H("  %nxpb = getelementptr %co_node, %co_node* %hp, i32 0, i32 0");
        H("  %nx = load i8*, i8** %nxpb");
        H("  store i8* %nx, i8** @co_head");
        H("  %islast = icmp eq i8* %nx, null");
        H("  br i1 %islast, label %last, label %after");
        H("last:");
        H("  store i8* null, i8** @co_tail");
        H("  br label %after");
        H("after:");
        H("  call void @free(i8* %head)");
        H("  %stfn = bitcast i8* %sti8 to void(i8*)*");
        H("  call void %stfn(i8* %fr)");
        H("  br label %loop");
        H("timers:");
        H("  %dchk2 = icmp ne i32* %done, null");
        H("  br i1 %dchk2, label %dtest2, label %tcheck");
        H("dtest2:");
        H("  %dv2 = load i32, i32* %done");
        H("  %disd2 = icmp ne i32 %dv2, 0");
        H("  br i1 %disd2, label %exit, label %tcheck");
        H("tcheck:");
        H("  %t0 = load i8*, i8** @co_timers");
        H("  %te = icmp eq i8* %t0, null");
        H("  br i1 %te, label %iopump, label %scansetup");
        H("scansetup:");
        H("  store i8* %t0, i8** %a.best");
        H("  store i8* null, i8** %a.bestprev");
        H("  %t0p = bitcast i8* %t0 to %co_timer*");
        H("  %t0np = getelementptr %co_timer, %co_timer* %t0p, i32 0, i32 0");
        H("  %t0next = load i8*, i8** %t0np");
        H("  store i8* %t0next, i8** %a.cur");
        H("  store i8* %t0, i8** %a.curprev");
        H("  br label %scancond");
        H("scancond:");
        H("  %cur = load i8*, i8** %a.cur");
        H("  %curnull = icmp eq i8* %cur, null");
        H("  br i1 %curnull, label %scandone, label %scanbody");
        H("scanbody:");
        H("  %curb = load i8*, i8** %a.cur");
        H("  %bestb = load i8*, i8** %a.best");
        H("  %curbp = bitcast i8* %curb to %co_timer*");
        H("  %bestbp = bitcast i8* %bestb to %co_timer*");
        H("  %curduep = getelementptr %co_timer, %co_timer* %curbp, i32 0, i32 1");
        H("  %curdue = load i64, i64* %curduep");
        H("  %bestduep = getelementptr %co_timer, %co_timer* %bestbp, i32 0, i32 1");
        H("  %bestdue = load i64, i64* %bestduep");
        H("  %dlt = icmp ult i64 %curdue, %bestdue");
        H("  br i1 %dlt, label %scantake, label %scannext");
        H("scantake:");
        H("  %curt = load i8*, i8** %a.cur");
        H("  %curprevt = load i8*, i8** %a.curprev");
        H("  store i8* %curt, i8** %a.best");
        H("  store i8* %curprevt, i8** %a.bestprev");
        H("  br label %scannext");
        H("scannext:");
        H("  %curn = load i8*, i8** %a.cur");
        H("  store i8* %curn, i8** %a.curprev");
        H("  %curnp = bitcast i8* %curn to %co_timer*");
        H("  %curnextp = getelementptr %co_timer, %co_timer* %curnp, i32 0, i32 0");
        H("  %curnextv = load i8*, i8** %curnextp");
        H("  store i8* %curnextv, i8** %a.cur");
        H("  br label %scancond");
        H("scandone:");
        H("  %best = load i8*, i8** %a.best");
        H("  %bestprev = load i8*, i8** %a.bestprev");
        H("  %bestp = bitcast i8* %best to %co_timer*");
        H("  %bestduep2 = getelementptr %co_timer, %co_timer* %bestp, i32 0, i32 1");
        H("  %bestdued = load i64, i64* %bestduep2");
        H("  %nowd = call i64 @__zan_co_now_ms()");
        H("  %duenow = icmp sle i64 %bestdued, %nowd");
        H("  br i1 %duenow, label %timerdue, label %timerwait");
        H("timerwait:");
        H("  %remaining = sub i64 %bestdued, %nowd");
        H("  call i32 @zan_io_pump_timeout(i64 %remaining)");
        H("  br label %loop");
        H("timerdue:");
        H("  %bestp2 = bitcast i8* %best to %co_timer*");
        H("  %bestnextp = getelementptr %co_timer, %co_timer* %bestp2, i32 0, i32 0");
        H("  %bestnextv = load i8*, i8** %bestnextp");
        H("  %bpnull = icmp eq i8* %bestprev, null");
        H("  br i1 %bpnull, label %unlinkhead, label %unlinkmid");
        H("unlinkhead:");
        H("  store i8* %bestnextv, i8** @co_timers");
        H("  br label %afterunlink");
        H("unlinkmid:");
        H("  %bestprevp = bitcast i8* %bestprev to %co_timer*");
        H("  %bpnextp = getelementptr %co_timer, %co_timer* %bestprevp, i32 0, i32 0");
        H("  store i8* %bestnextv, i8** %bpnextp");
        H("  br label %afterunlink");
        H("afterunlink:");
        H("  %bestp3 = bitcast i8* %best to %co_timer*");
        H("  %bframep = getelementptr %co_timer, %co_timer* %bestp3, i32 0, i32 2");
        H("  %bframe = load i8*, i8** %bframep");
        H("  %bstepp = getelementptr %co_timer, %co_timer* %bestp3, i32 0, i32 3");
        H("  %bstepi8 = load i8*, i8** %bstepp");
        H("  %bstepfn = bitcast i8* %bstepi8 to void(i8*)*");
        H("  call void @zan_co_ready(i8* %bframe, void(i8*)* %bstepfn)");
        H("  call void @free(i8* %best)");
        H("  br label %loop");
        H("iopump:");
        H("  %woke = call i32 @zan_io_pump()");
        H("  %iomore = icmp sgt i32 %woke, 0");
        H("  br i1 %iomore, label %loop, label %exit");
        H("exit:");
        H("  ret void");
        H("}");
        H("define weak void @zan_co_sched_run() {");
        H("entry:");
        H("  call void @zan_co_sched_run_until(i32* null)");
        H("  ret void");
        H("}");
    }

    // ===== Task 句柄的内建族（Task.Run / Spawn / Wait / Result / IsCompleted）=====
    //
    // 自举把任务句柄族降级到**自己**的帧布局上（文件头的扁平 i64 帧）：句柄
    // 就是帧指针，done 标志在槽 3，结果在槽 6。宿主做的是同一件事，只是帧头
    // 布局不同（src/compiler/irgen_expr_core.c 的 emit_task_member：先跑
    // test/pump 循环等完成，再读结果并回收）——两边一致的是**可观察行为**，
    // 不是字节。
    //
    // 句柄以 i8*（帧指针）流动：`long h = task` 用 ptrtoint 打包，
    // `Task.IsDone(h)` 用 inttoptr 拆包——与宿主对 i64 句柄的往返一致。

    // 帧的 i64* 视图
    string TaskFrameHeader(string fp) {
        string p = NT();
        L("  " + p + " = bitcast i8* " + fp + " to i64*");
        return p;
    }

    // 等帧跑完：泵协作调度器直到 done 标志置位（宿主的 tk.test/tk.pump 循环）
    void EmitTaskWait(string fp) {
        string token = TaskTokenBits(fp);
        int lt = NL(); int lw = NL(); int ld = NL();
        L("  br label %L" + lt);
        term = true;
        Label(lt);
        string dn = NT(); L("  " + dn + " = call i32 @zan_task_isdone(i64 " + token + ")");
        string c = NT(); L("  " + c + " = icmp ne i32 " + dn + ", 0");
        L("  br i1 " + c + ", label %L" + ld + ", label %L" + lw);
        Label(lw);
        L("  call void @zan_co_sched_run()");
        L("  br label %L" + lt);
        Label(ld);
    }

    // 帧的 done 标志（i64 的 0/1）
    string TaskTokenBits(string handle) {
        string token = NT(); L("  " + token + " = ptrtoint i8* " + handle + " to i64");
        return token;
    }
    string TaskDoneValue(string fp) {
        string token = TaskTokenBits(fp);
        string dn = NT(); L("  " + dn + " = call i32 @zan_task_isdone(i64 " + token + ")");
        string r = NT(); L("  " + r + " = zext i32 " + dn + " to i64");
        return r;
    }
    void TaskFrameConfig(string frame) {
        string header = TaskFrameHeader(frame);
        string done = NT();
        L("  " + done + " = bitcast i64* " + FrameGep(header, 3) + " to i32*");
        string cancel = NT();
        L("  " + cancel + " = bitcast i64* " + FrameGep(header, 10) + " to i32*");
        L("  call void @zan_task_frame_config(i8* " + frame + ", i32* " + done + ", i32* " + cancel + ")");
    }
    string TaskRegister(string frame) {
        TaskFrameConfig(frame);
        string header = TaskFrameHeader(frame);
        string done = NT();
        L("  " + done + " = bitcast i64* " + FrameGep(header, 3) + " to i32*");
        string token = NT(); L("  " + token + " = call i64 @zan_task_register(i8* " + frame + ", i32* " + done + ")");
        string handle = NT(); L("  " + handle + " = inttoptr i64 " + token + " to i8*");
        return handle;
    }
    string TaskDiscardThunk(Node elem) {
        string name = "@ztask_discard_" + ownedDtorSeq;
        ownedDtorSeq = ownedDtorSeq + 1;
        StringBuilder saved = body;
        int st = tmp; int sl = lbl; string sc = curLbl; bool se = eaActive;
        body = new StringBuilder(); tmp = 0; lbl = 0; curLbl = "entry"; eaActive = false;
        L("define internal void " + name + "(i8* %frame) {");
        L("entry:");
        if (elem != null && (ArcManaged(elem) || elem.ival >= 1)) {
            string header = TaskFrameHeader("%frame");
            string slot = FrameGep(header, 6);
            string bits = NT(); L("  " + bits + " = load i64, i64* " + slot);
            L("  store i64 0, i64* " + slot);
            EmitArcRelease(FromI64(bits, MapType(elem)), elem);
        }
        L("  call void @zexc_frame_free(i8* %frame)");
        L("  ret void"); L("}");
        deferred.Append(body.ToString());
        body = saved; tmp = st; lbl = sl; curLbl = sc; eaActive = se;
        return name;
    }
    void TaskDiscardConfig(string frame, Node elem) {
        string thunk = TaskDiscardThunk(elem);
        L("  call void @zan_task_discard_config(i8* " + frame + ", void(i8*)* " + thunk + ")");
    }
    void EmitTaskRelease(string handle) {
        EmitTaskWait(handle);
        string frame = TaskConsume(handle);
        string present = NT(); L("  " + present + " = icmp ne i8* " + frame + ", null");
        int drop = NL(); int done = NL();
        L("  br i1 " + present + ", label %L" + drop + ", label %L" + done);
        Label(drop);
        L("  call void @zan_task_discard(i8* " + frame + ")");
        L("  call void @zan_task_unpin(i8* " + frame + ")");
        L("  br label %L" + done);
        Label(done);
    }
    string TaskConsume(string handle) {
        string token = TaskTokenBits(handle);
        string frame = NT(); L("  " + frame + " = call i8* @zan_task_acquire(i64 " + token + ", i32 1)");
        return frame;
    }

    // lambda 体里有没有带值的 return（宿主: lambda_body_has_value_return）
    bool TaskLambdaHasValueReturn(Node n) {
        if (n == null) { return false; }
        if (n.kind == AK.ReturnStmt()) { return n.a != null; }
        if (n.kind == AK.Lambda()) { return false; }
        if (TaskLambdaHasValueReturn(n.a) || TaskLambdaHasValueReturn(n.b)
            || TaskLambdaHasValueReturn(n.c) || TaskLambdaHasValueReturn(n.d)) { return true; }
        int i = 0;
        while (i < n.kids.Count) {
            if (TaskLambdaHasValueReturn(n.kids[i])) { return true; }
            i = i + 1;
        }
        return false;
    }

    // action 帧的 step 函数：跑委托，然后置 done。按调用点各生成一份（像
    // lambda 那样），因为委托的函数类型只有调用点知道。宿主用的是一份共享
    // 的 step（它的委托形状被固定成 Action），这里按调用点特化，行为一致。
    string EmitTaskActionStep() {
        int id = lamCount; lamCount = lamCount + 1;
        string fname = "@__task_action_step_" + id;
        // 保存外层函数的状态
        List<string> savedFinLabels = finLocalLabels;
        int savedFinScope = finLabelScope; int savedFinSeq = finLabelSeq;
        finLocalLabels = new List<string>(); finLabelScope = 0; finLabelSeq = 0;
        SyncFlowContext savedSyncFlow = syncFlow;
        syncFlow = new SyncFlowContext();
        List<string> savedGotoNames = gotoNames; List<int> savedGotoIds = gotoIds;
        gotoNames = new List<string>(); gotoIds = new List<int>();
        string sPendingReturn = syncPendingReturn;
        syncPendingReturn = "";
        StringBuilder savedBody = body;
        int sTmp = tmp; int sLbl = lbl; bool sTerm = term; string sCurLbl = curLbl;
        string sRet = curRet; Node sRetTy = curRetTy; string sClass = curClass; bool sHasThis = curHasThis;
        List<string> sLocName = locName; List<Node> sLocType = locType;
        List<string> sLocReg = locReg; int sLocSeq = locSeq;
        List<bool> sLocRef = locRef;
        List<bool> sLocBox = locBox; List<bool> sLocIter = locIter; List<string> sLocCell = locCell;
        List<string> sCapNames = capNames;
        int sBrk = brkTarget; int sCont = contTarget; int sLoopScope = loopScopeBase;
        List<string> svT = stmtTemps; List<Node> svTT = stmtTempTypes;
        List<Node> sFinBodies = finBodies;
        List<int> sFinLive = finLive;
        List<int> sFinActive = finActive;
        List<string> sFinMonSlot = finMonSlot;
        List<string> sCatchExcVal = catchExcVal;
        List<string> sCatchExcTid = catchExcTid;
        List<string> sCatchOwner = catchExcOwner; List<string> sPendingOwner = pendingExcOwner;
        List<string> sTempValues = stmtTempValues; List<string> sTempOwners = stmtTempOwners;
        List<int> sCatchFinDepth = catchFinDepth;
        List<string> sLabelFinNames = labelFinNames;
        List<int> sLabelFinDepths = labelFinDepths;
        int sBrkFinBase = brkFinBase;
        int sContFinBase = contFinBase;
        StringBuilder sEa = entryAllocas; bool sEaAct = eaActive;
        bool sAsync = curAsync;
        body = new StringBuilder();
        entryAllocas = new StringBuilder(); eaActive = true;
        tmp = 0; lbl = 0; term = false; curLbl = "entry"; curAsync = false;
        locName = new List<string>(); locType = new List<Node>(); locReg = new List<string>(); locSeq = 0;
        locBox = new List<bool>(); locIter = new List<bool>(); locCell = new List<string>();
        locRef = new List<bool>();
        capNames = new List<string>();
        finBodies = new List<Node>();
        finLive = new List<int>();
        finActive = new List<int>();
        finMonSlot = new List<string>();
        catchFinDepth = new List<int>();
        catchExcVal = new List<string>();
        catchExcTid = new List<string>();
        catchExcOwner = new List<string>(); pendingExcOwner = new List<string>();
        stmtTempValues = new List<string>(); stmtTempOwners = new List<string>();
        labelFinNames = new List<string>();
        labelFinDepths = new List<int>();
        brkFinBase = 0;
        contFinBase = 0;
        curRet = "void"; curRetTy = MkType("void"); curClass = ""; curHasThis = false;
        brkTarget = 0; contTarget = 0;
        stmtTemps = new List<string>(); stmtTempTypes = new List<Node>();

        // Action ownership is separate from the standard slot 10 cancel flag.
        string fph = NT(); L("  " + fph + " = bitcast i8* %fp to i64*");
        // Catch only to release the frame owner, then propagate the same exception.
        string depth = NT(); EA(depth, "i64");
        string failed = NT(); EA(failed, "i1");
        string exSlot = NT(); EA(exSlot, "i8*");
        string tidSlot = NT(); EA(tidSlot, "i8*");
        string bridgeSlot = NT(); EA(bridgeSlot, "i8*");
        L("  store i1 false, i1* " + failed);
        string initialDepth = NT(); L("  " + initialDepth + " = load i64, i64* @__exc_sp");
        L("  store i64 " + initialDepth + ", i64* " + depth);
        string room = NT(); L("  " + room + " = icmp ult i64 " + initialDepth + ", 64");
        int lArm = NL(); int lOverflow = NL();
        L("  br i1 " + room + ", label %L" + lArm + ", label %L" + lOverflow);
        Label(lOverflow);
        L("  call void @ztask_action_release(i8* %fp)");
        L("  call void @exit(i32 70)");
        L("  unreachable");
        Label(lArm);
        string buffer = NT(); L("  " + buffer + " = getelementptr [64 x [32 x i64]], [64 x [32 x i64]]* @__exc_bufs, i64 0, i64 " + initialDepth);
        string bufferPtr = NT(); L("  " + bufferPtr + " = bitcast [32 x i64]* " + buffer + " to i8*");
        string handler = NT(); L("  " + handler + " = getelementptr [64 x i8*], [64 x i8*]* @__exc_stack, i64 0, i64 " + initialDepth);
        L("  store i8* " + bufferPtr + ", i8** " + handler);
        EmitPendingHandlerMark(initialDepth);
        string armedDepth = NT(); L("  " + armedDepth + " = add i64 " + initialDepth + ", 1");
        L("  store i64 " + armedDepth + ", i64* @__exc_sp");
        string caught = NT(); L("  " + caught + " = call i32 @_setjmp(i8* " + bufferPtr + ", i8* null)");
        string exceptional = NT(); L("  " + exceptional + " = icmp ne i32 " + caught + ", 0");
        int lCatch = NL(); int lCheck = NL();
        L("  br i1 " + exceptional + ", label %L" + lCatch + ", label %L" + lCheck);
        Label(lCheck);
        string cancel = NT(); L("  " + cancel + " = load i64, i64* " + FrameGep(fph, 10));
        string cancelled = NT(); L("  " + cancelled + " = icmp ne i64 " + cancel + ", 0");
        int lRun = NL(); int lFin = NL();
        L("  br i1 " + cancelled + ", label %L" + lFin + ", label %L" + lRun);
        Label(lRun);
        string dlgi = NT(); L("  " + dlgi + " = load i64, i64* " + FrameGep(fph, 20));
        string dlg = NT(); L("  " + dlg + " = inttoptr i64 " + dlgi + " to i8*");
        L("  call void @zan_backend_delegate_invoke(i8* " + dlg + ")");
        L("  br label %L" + lFin);
        Label(lCatch);
        L("  store i1 true, i1* " + failed);
        string exception = NT(); L("  " + exception + " = load i8*, i8** @__exc_val");
        string exceptionTid = NT(); L("  " + exceptionTid + " = load i8*, i8** @__exc_tid");
        string bridgeOwner = NT();
        L("  " + bridgeOwner + " = call %zan.exception* @zexc_push()");
        string bridgeRaw = NT(); L("  " + bridgeRaw + " = bitcast %zan.exception* " + bridgeOwner + " to i8*");
        L("  store i8* " + bridgeRaw + ", i8** " + bridgeSlot);
        L("  store i8* " + exception + ", i8** " + exSlot);
        L("  store i8* " + exceptionTid + ", i8** " + tidSlot);
        L("  br label %L" + lFin);
        Label(lFin);
        string oldDepth = NT(); L("  " + oldDepth + " = load i64, i64* " + depth);
        L("  store i64 " + oldDepth + ", i64* @__exc_sp");
        L("  call void @ztask_action_release(i8* %fp)");
        // done = 1，state = -1
        string dp = FrameGep(fph, 3);
        L("  store i64 1, i64* " + dp);
        string sp = FrameGep(fph, 2);
        L("  store i64 -1, i64* " + sp);
        // 唤醒等待者（槽 4/5）——与 EmitAsyncComplete 同一套协议
        string awp = FrameGep(fph, 4);
        string awi = NT(); L("  " + awi + " = load i64, i64* " + awp);
        string aw = NT(); L("  " + aw + " = inttoptr i64 " + awi + " to i8*");
        string has = NT(); L("  " + has + " = icmp ne i8* " + aw + ", null");
        int lw = NL(); int lr = NL();
        L("  br i1 " + has + ", label %L" + lw + ", label %L" + lr);
        Label(lw);
        string asp = FrameGep(fph, 5);
        string asi = NT(); L("  " + asi + " = load i64, i64* " + asp);
        string asfn = NT(); L("  " + asfn + " = inttoptr i64 " + asi + " to void(i8*)*");
        L("  call void @zan_co_ready(i8* " + aw + ", void(i8*)* " + asfn + ")");
        L("  br label %L" + lr);
        Label(lr);
        string didFail = NT(); L("  " + didFail + " = load i1, i1* " + failed);
        int lRaise = NL(); int lReturn = NL();
        L("  br i1 " + didFail + ", label %L" + lRaise + ", label %L" + lReturn);
        Label(lRaise);
        string savedException = NT(); L("  " + savedException + " = load i8*, i8** " + exSlot);
        string savedTid = NT(); L("  " + savedTid + " = load i8*, i8** " + tidSlot);
        L("  store i8* " + savedException + ", i8** @__exc_val");
        L("  store i8* " + savedTid + ", i8** @__exc_tid");
        string restoredBridge = LoadExceptionOwner(bridgeSlot);
        L("  call void @zexc_take(%zan.exception* @zexc_dispatch, %zan.exception* " + restoredBridge + ")");
        L("  call void @zexc_pop(%zan.exception* " + restoredBridge + ")");
        RestoreExceptionDispatch();
        L("  call void @zexc_frame_free(i8* %fp)");
        EmitRaise();
        Label(lReturn);
        L("  call void @zexc_frame_free(i8* %fp)");
        L("  ret void");

        deferred.Append("define internal void " + fname + "(i8* %fp) {\n");
        deferred.Append("entry:\n");
        deferred.Append(entryAllocas.ToString());
        deferred.Append(body.ToString());
        deferred.Append("}\n");

        // 恢复外层函数的状态
        syncPendingReturn = sPendingReturn;
        syncFlow = savedSyncFlow;
        finLocalLabels = savedFinLabels;
        finLabelScope = savedFinScope; finLabelSeq = savedFinSeq;
        gotoNames = savedGotoNames; gotoIds = savedGotoIds;
        body = savedBody;
        tmp = sTmp; lbl = sLbl; term = sTerm; curLbl = sCurLbl;
        curRet = sRet; curRetTy = sRetTy; curClass = sClass; curHasThis = sHasThis;
        locName = sLocName; locType = sLocType; locReg = sLocReg; locSeq = sLocSeq;
        locBox = sLocBox; locIter = sLocIter; locCell = sLocCell; locRef = sLocRef; capNames = sCapNames;
        brkTarget = sBrk; contTarget = sCont; loopScopeBase = sLoopScope;
        stmtTemps = svT; stmtTempTypes = svTT;
        finBodies = sFinBodies; finLive = sFinLive; finActive = sFinActive;
        finMonSlot = sFinMonSlot;
        catchExcVal = sCatchExcVal; catchExcTid = sCatchExcTid;
        catchExcOwner = sCatchOwner; pendingExcOwner = sPendingOwner;
        stmtTempValues = sTempValues; stmtTempOwners = sTempOwners;
        catchFinDepth = sCatchFinDepth;
        labelFinNames = sLabelFinNames;
        labelFinDepths = sLabelFinDepths;
        brkFinBase = sBrkFinBase; contFinBase = sContFinBase;
        entryAllocas = sEa; eaActive = sEaAct;
        curAsync = sAsync;
        return fname;
    }

    // Action frame: slots 0..12 are the standard header; slot 13 owns the delegate.
    // 帧不释放：宿主靠运行时的活跃帧登记表回收，自举没有那个登记表，而
    // 句柄在任务完成后还要能读 done 标志（IsCompleted）——提前释放就是
    // 读已释放内存。代价是每个 action 帧保留 112 字节（不是 ARC 对象，
    // 泄漏检查看不见）。
    ExprVal EmitTaskActionFrame(ExprVal dlg) {
        string raw = NT();
        L("  " + raw + " = call i8* @__zan_co_frame_alloc(i64 168)");
        string fph = NT(); L("  " + fph + " = bitcast i8* " + raw + " to i64*");
        int i = 0;
        while (i < 21) {
            L("  store i64 0, i64* " + FrameGep(fph, i));
            i = i + 1;
        }
        L("  call void @zdelegate_retain(i8* " + dlg.op + ")");
        string cleanup = NT();
        L("  " + cleanup + " = ptrtoint void(i8*)* @ztask_action_release to i64");
        L("  store i64 " + cleanup + ", i64* " + FrameGep(fph, 7));
        string dlgp = FrameGep(fph, 20);
        string dlgv = NT(); L("  " + dlgv + " = ptrtoint i8* " + dlg.op + " to i64");
        L("  store i64 " + dlgv + ", i64* " + dlgp);
        string step = EmitTaskActionStep();
        TaskDiscardConfig(raw, null);
        string handle = TaskRegister(raw);
        L("  call void @zan_co_ready(i8* " + raw + ", void(i8*)* " + step + ")");
        return new ExprVal(handle, MkType("Task"));
    }

    // 把一个 async 调用的帧交给调度器。selfReap=true 时帧自己回收自己
    // （宿主: emit_detach_async_call 把 AWAITER 设成自己、AWAITER_STEP 设成
    // 回收函数）；Task.Run 的带结果形态不设——结果由读者（.Result）取走。
    void EmitTaskReadyFrame(ExprVal sub, bool selfReap) {
        string subv = sub.op;
        string fph = NT(); L("  " + fph + " = bitcast i8* " + subv + " to i64*");
        if (selfReap) {
            string selfi = NT(); L("  " + selfi + " = ptrtoint i8* " + subv + " to i64");
            L("  store i64 " + selfi + ", i64* " + FrameGep(fph, 4));
            string reapi = NT(); L("  " + reapi + " = ptrtoint void(i8*)* @__zan_co_reap to i64");
            L("  store i64 " + reapi + ", i64* " + FrameGep(fph, 5));
        }
        // 帧的槽 9 是自己的 resume 入口（ramp 写的）
        string orp = FrameGep(fph, 9);
        string ori = NT(); L("  " + ori + " = load i64, i64* " + orp);
        string orfn = NT(); L("  " + orfn + " = inttoptr i64 " + ori + " to void(i8*)*");
        L("  call void @zan_co_ready(i8* " + subv + ", void(i8*)* " + orfn + ")");
    }

    // Task.Run(arg) / Task.Spawn(arg)
    ExprVal EmitTaskRunCall(Node e, bool spawn) {
        usesAsync = true;
        Node arg = e.kids[0];
        // 委托形态：宿主把 lambda 固定成 Action 形状（无参、无结果），自举
        // 同样把 lambda 的返回类型按 void 处理。
        bool isLam = (arg.kind == AK.Lambda());
        Node savedTy = null;
        if (isLam) {
            if (arg.kids.Count != 0 || TaskLambdaHasValueReturn(arg.d)
                || TaskLambdaHasValueReturn(arg.a)) {
                diags.Error("[E3052] Task.Run delegate must be a parameterless void body (an Action); " +
                    "pass an async call for results", arg.line, arg.col);
                return new ExprVal("0", MkType("int"));
            }
            savedTy = arg.type;
            arg.type = MkType("void");
        }
        ExprVal av;
        Node bound = arg.resolvedSym;
        if ((arg.kind == AK.Ident() || arg.kind == AK.MemberAccess())
                && bound != null && bound.kind == AK.MethodDecl()) {
            // The checker is the only Action overload selector. Never repeat
            // a name-only lookup here (Run(int) may precede Run()).
            string owner = DeclOwnerOf(null, bound);
            Node cls = binder.FindType(owner);
            if (cls == null) {
                diags.Error("bound Task Action has no declaring owner", arg.line, arg.col);
                return new ExprVal("0", MkType("int"));
            }
            if (HasMod(bound, MOD.Static())) {
                av = EmitMethodGroup(owner, cls, bound);
            } else {
                ExprVal recv;
                if (arg.kind == AK.MemberAccess()) { recv = GenExpr(arg.a); }
                else { recv = new ExprVal("%this", MkType(curClass)); }
                av = EmitInstanceMethodGroup(recv, cls, bound);
            }
        } else {
            // Unbound method groups are diagnosed by the checker; delegate
            // variables/fields and async calls still use normal expression IR.
            av = GenExpr(arg);
        }
        if (isLam && savedTy != null) { arg.type = savedTy; }
        // 委托形态：没有结果的任务
        if (av.ty != null && IsDelegate(av.ty)) {
            if (DelegParams(av.ty).Count != 0) {
                diags.Error("[E3053] Task.Run delegate must take no parameters", arg.line, arg.col);
                return new ExprVal("0", MkType("int"));
            }
            Node rt = DelegRet(av.ty);
            if (rt == null || rt.sval != "void") {
                diags.Error("[E3052] Task.Run delegate must be a parameterless void body (an Action); " +
                    "pass an async call for results", arg.line, arg.col);
                return new ExprVal("0", MkType("int"));
            }
            return EmitTaskActionFrame(av);
        }
        // async 调用形态：调用的帧就是任务帧
        if (!av.asyncCall) {
            diags.Error("call to '" + (spawn ? "Task.Spawn" : "Task.Run")
                + "' is not supported by the self-hosted compiler yet", e.line, e.col);
            return new ExprVal("0", MkType("int"));
        }
        string handle = TaskRegister(av.op);
        Node resultType = null;
        if (av.ty != null && av.ty.a != null) { resultType = AsyncElemTyOf(av.ty.a); }
        bool selfReap = spawn || resultType == null || resultType.sval == "void";
        EmitTaskReadyFrame(av, selfReap);
        Node hty = MkType("Task");
        if (!spawn && av.ty != null && av.ty.a != null) {
            Node elem = AsyncElemTyOf(av.ty.a);
            if (elem != null && elem.sval != "void") { hty.Add(elem); }
        }
        return new ExprVal(handle, hty);
    }

    // 句柄上的成员：Wait / Result / IsCompleted
    ExprVal EmitTaskMemberCall(ExprVal recv, string mname, Node e) {
        string fp = recv.op;
        if (mname == "Wait") {
            EmitTaskWait(fp);
            return new ExprVal("0", MkType("void"));
        }
        if (mname == "Release") {
            EmitTaskRelease(fp);
            return new ExprVal("0", MkType("void"));
        }
        if (mname == "IsCompleted") {
            return new ExprVal(TaskDoneValue(fp), MkType("int"));
        }
        if (mname == "Result") {
            Node elem = null;
            if (recv.ty != null && recv.ty.kids.Count == 1) { elem = recv.ty.kids[0]; }
            if (elem == null) {
                diags.Error("[E3012] Task.Result requires a Task<T> value", e.line, e.col);
                return new ExprVal("0", MkType("int"));
            }
            EmitTaskWait(fp);
            string frame = TaskConsume(fp);
            string missing = NT(); L("  " + missing + " = icmp eq i8* " + frame + ", null");
            int bad = NL(); int good = NL();
            L("  br i1 " + missing + ", label %L" + bad + ", label %L" + good);
            Label(bad); L("  call void @abort()"); L("  unreachable");
            Label(good);
            L("  call void @zan_task_unpin(i8* " + frame + ")");
            string fph = TaskFrameHeader(frame);
            EmitAwaitCheckExc(fph);
            string rp = FrameGep(fph, 6);
            string resi = NT(); L("  " + resi + " = load i64, i64* " + rp);
            // Copy both decimal words before the consuming read frees the frame.
            string rvv;
            if (IsDecimal(elem)) { rvv = DecimalResultLoad(fph).op; }
            else { rvv = FromI64(resi, MapType(elem)); }
            // 帧由读者回收（宿主: co_reap）
            L("  store i64 0, i64* " + rp);
            L("  call void @zexc_frame_free(i8* " + frame + ")");
            AddTemp(rvv, elem);
            return new ExprVal(rvv, elem);
        }
        diags.Error("member '" + mname + "' of type 'Task' is not supported by the self-hosted "
            + "compiler yet", e.line, e.col);
        return new ExprVal("0", MkType("int"));
    }

    // Task.Cancel(handle): mark the frame cancelled. The frame aborts at its
    // next resume (the C host sets the frame's cancel flag and the resume
    // path checks it -- irgen_call.c: get_co_cancel_fn, irgen_async.c:
    // emit_async_cancel_check). The handle IS the frame pointer.
    ExprVal EmitTaskCancel(Node e) {
        ExprVal h = GenExpr(e.kids[0]);
        string fp;
        if (MapType(h.ty) == "i64") {
            fp = NT(); L("  " + fp + " = inttoptr i64 " + h.op + " to i8*");
        } else {
            fp = h.op;
        }
        string token = TaskTokenBits(fp);
        L("  call void @zan_task_cancel(i64 " + token + ")");
        return new ExprVal("0", MkType("void"));
    }

    // Task.IsDone(handle)：裸句柄是否已经跑完（槽 3 done 标志是否置位）。
    // 若未完成则主动 pump 一次协同调度器，防止 `while (Task.IsDone(h) == 0) {}` 紧循环饥饿。
    ExprVal EmitTaskIsDone(Node e) {
        ExprVal h = GenExpr(e.kids[0]);
        string fp;
        if (MapType(h.ty) == "i64") {
            fp = NT(); L("  " + fp + " = inttoptr i64 " + h.op + " to i8*");
        } else {
            fp = h.op;
        }
        string token = TaskTokenBits(fp);
        string dn = NT(); L("  " + dn + " = call i32 @zan_task_isdone(i64 " + token + ")");
        string c = NT(); L("  " + c + " = icmp ne i32 " + dn + ", 0");
        string lentry = curLbl;
        int ldone = NL(); int lcont = NL();
        L("  br i1 " + c + ", label %L" + ldone + ", label %L" + lcont);
        Label(lcont);
        L("  call void @zan_co_sched_run()");
        string dn2 = NT(); L("  " + dn2 + " = call i32 @zan_task_isdone(i64 " + token + ")");
        string c2 = NT(); L("  " + c2 + " = icmp ne i32 " + dn2 + ", 0");
        L("  br label %L" + ldone);
        Label(ldone);
        string cphi = NT();
        L("  " + cphi + " = phi i1 [ true, %" + lentry + " ], [ " + c2 + ", %L" + lcont + " ]");
        string r = NT(); L("  " + r + " = zext i1 " + cphi + " to i64");
        return new ExprVal(r, MkType("int"));
    }

}
