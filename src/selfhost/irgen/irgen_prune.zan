using System;
using System.Collections.Generic;
namespace Zan;

partial class Irgen {
    // ---- whole-module dead-code pruning (G8 round 2) ----
    //
    // The stdlib demand-pull hands the emitter whole files, so a program
    // that touches one Encoding helper shipped Encoding_Sha1, four
    // QuickSort variants and the full Base64/Unicode machinery it never
    // calls -- the `arithmetic` case was 52k lines of prelude for a main of
    // 62. The shim-only prune barely helped (469 lines); the mass is user
    // code. So the pass runs over the WHOLE module text:
    //
    // roots = every @symbol on a line that is not inside a `define` block
    //         (global initializers -- vtables and function-pointer tables
    //         are data, so their targets stay reachable -- plus declares
    //         and attributes) + the `main` entry the linker references
    //         externally + the weak coroutine set the linked C runtime
    //         references from outside the module;
    // kept  = the transitive closure over define blocks' internal @refs.
    //
    // Every call edge in LLVM IR is a textual `@name`, so a missed edge is
    // impossible to lose silently: the link fails loudly with LNK2019
    // instead of misbehaving. Dropped blocks are ones nothing can call.
    //
    // Order matters for determinism: this runs after all emission (including
    // the deferred generic specializations) and before the module text is
    // returned, so two successive self-compiles see the same input and stay
    // a fixed point.

    string PruneDeadCode(string modText) {
        // slice into lines (index/length pairs, no copying)
        List<int> lineStart = new List<int>();
        List<int> lineLen = new List<int>();
        int pos = 0;
        while (pos <= modText.Length) {
            int nl = modText.IndexOf("\n", pos);
            if (nl < 0) {
                lineStart.Add(pos);
                lineLen.Add(modText.Length - pos);
                break;
            }
            lineStart.Add(pos);
            lineLen.Add(nl - pos);
            pos = nl + 1;
        }
        int lnCount = lineLen.Count;

        // walk the lines, slicing out the `define` blocks (a block runs from
        // its define line through its closing '}' at column 0)
        List<int> defStart = new List<int>();
        List<int> defEnd = new List<int>();
        MethIndex defs = new MethIndex();
        List<int> reached = new List<int>();
        int i = 0;
        while (i < lnCount) {
            string ln = modText.Substring(lineStart[i], lineLen[i]);
            if (ln.StartsWith("define ")) {
                int st = i;
                string nm = HeadSymbol(ln);
                while (i < lnCount) {
                    string bl = modText.Substring(lineStart[i], lineLen[i]);
                    if (bl == "}") { break; }
                    i = i + 1;
                }
                defs.Add(nm, defStart.Count);
                defStart.Add(st);
                defEnd.Add(i);
                reached.Add(0);
            }
            i = i + 1;
        }
        if (defStart.Count == 0) { return modText; }

        // Collect roots from outside the function bodies, then add the
        // entry and the hooks referenced by the linked runtime.
        List<int> pending = new List<int>();
        List<string> names = new List<string>();
        i = 0;
        int defRun = 0;
        while (i < lnCount) {
            if (defRun < defStart.Count && defStart[defRun] == i) {
                i = defEnd[defRun] + 1;
                defRun = defRun + 1;
                continue;
            }
            string line = modText.Substring(lineStart[i], lineLen[i]);
            if (!line.StartsWith("declare ")) {
                CollectHeadRefs(line, names);
                QueueDefinitions(names, defs, reached, pending);
            }
            i = i + 1;
        }
        names.Add("main");
        for (int export = 0; export < sinitExportRoots.Count; export++) {
            names.Add(sinitExportRoots[export]);
        }
        names.Add("zan_co_ready"); names.Add("zan_co_ready_batch"); names.Add("zan_co_sched_init");
        names.Add("zan_co_sched_run"); names.Add("zan_co_sched_run_until"); names.Add("zan_co_delay");
        names.Add("zan_io_pump"); names.Add("zan_io_pump_timeout");
        names.Add("__zan_async_unwind"); names.Add("__zan_co_frame_free");
        names.Add("__zan_co_reap");
        names.Add("zan_backend_delegate_retain"); names.Add("zan_backend_delegate_release");
        names.Add("zan_backend_delegate_invoke"); names.Add("zarr_owner");
        QueueDefinitions(names, defs, reached, pending);

        int wi = 0;
        while (wi < pending.Count) {
            int bi = pending[wi];
            wi = wi + 1;
            int from = lineStart[defStart[bi]];
            int to = lineStart[defEnd[bi]] + lineLen[defEnd[bi]];
            CollectHeadRefs(modText.Substring(from, to - from), names);
            QueueDefinitions(names, defs, reached, pending);
        }

        // rebuild the module: skip define blocks that stayed unreachable
        StringBuilder result = new StringBuilder();
        i = 0;
        int defIdx = 0;
        while (i < lnCount) {
            if (defIdx < defStart.Count && defStart[defIdx] == i) {
                if (reached[defIdx] == 0) {
                    // drop the whole block: fast-forward past its closing '}'
                    i = defEnd[defIdx] + 1;
                    defIdx = defIdx + 1;
                    continue;
                }
                defIdx = defIdx + 1;
            }
            result.Append(modText.Substring(lineStart[i], lineLen[i]));
            result.Append("\n");
            i = i + 1;
        }
        return result.ToString();
    }

    void QueueDefinitions(List<string> names, MethIndex defs, List<int> reached, List<int> pending) {
        int i = 0;
        while (i < names.Count) {
            int bi = defs.First(names[i]);
            if (bi >= 0 && reached[bi] == 0) {
                reached[bi] = 1;
                pending.Add(bi);
                if (collectNativeImports) { liveNativeDefinitions.Add(names[i]); }
            } else if (bi < 0 && collectNativeImports && nativeExterns.ContainsKey(names[i])) {
                liveNativeExterns.Add(new NativeImport(names[i], nativeExterns[names[i]]));
                nativeExterns.Remove(names[i]);
            }
            i = i + 1;
        }
        names.Clear();
    }

    // the symbol name of a `define ... @name(...)` line
    string HeadSymbol(string line) {
        int at = line.IndexOf("@");
        if (at < 0) { return ""; }
        int j = at + 1;
        while (j < line.Length) {
            int c = (int)line[j];
            bool ok = (c >= 97 && c <= 122) || (c >= 65 && c <= 90) || (c >= 48 && c <= 57) || c == 95 || c == 46 || c == 36;
            if (!ok) { break; }
            j = j + 1;
        }
        return line.Substring(at + 1, j - at - 1);
    }

    // Every @symbol mentioned in the text, in order.
    void CollectHeadRefs(string text, List<string> into) {
        int i = 0;
        while (i < text.Length) {
            if ((int)text[i] == 64) { // '@'
                int j = i + 1;
                while (j < text.Length) {
                    int c = (int)text[j];
                    bool ok = (c >= 97 && c <= 122) || (c >= 65 && c <= 90) || (c >= 48 && c <= 57) || c == 95 || c == 46 || c == 36;
                    if (!ok) { break; }
                    j = j + 1;
                }
                if (j > i + 1) { into.Add(text.Substring(i + 1, j - i - 1)); }
                i = j;
            } else {
                i = i + 1;
            }
        }
    }
}
