using System;
using System.IO;
using System.Diagnostics;
using System.Collections.Generic;

// zan-check：S5（docs/ZAN_STANDARD.md §1）的原生命令——一条命令跑完，输出单份
// JSON 报告。用 Zan 写、随工具链发布，不依赖 Python。
//
//   zan-check <入口.zan|目录...> [--zanc <路径>] [--timeout <秒>] [--no-run] [--no-ui] [--no-replay]
//             [--zanc-arg <参数>]... [--out <report.json>] [-- 程序参数...]
//
// 步骤（失败步骤之后依赖它的步骤记 skipped，报告照样完整）：
//   compile  zanc <输入> --auto-stdlib --check-leaks --diag=json：诊断原样收进报告
//            （JSON Lines，含 fix-it 与 end），summary 的 errors/warnings 计数；
//   leaks    运行产物（带超时），解析退出时的泄漏报告（S10/S13）：残留数、按站点
//            计数、孤儿环路径、判定口径 strict / early-exit；有泄漏、退出码非 0、
//            超时即失败；
//   ui       S22 布局不变量：在输入里找 `class X : Form` 且同目录有 X.html 的窗体，生成
//            检查程序（Gui.Testing.UiCheck）离屏装配每个窗体，100%/150%/200% DPI 各排
//            一帧，再各做一遍伪本地化（文本拉长 40%）；真实尺寸下的问题判失败，伪本地化
//            的问题作为告警计数（预示译文变长后的截断）。没有窗体时 skipped；--no-ui 跳过；
//   replay   S26/S27 回放即回归：在输入目录与其上一级找 replays/*.replay，按文件里的
//            `sim <类型名>` 生成检查程序，Game.Foundation.Replay.Verify 逐校验点重放并每帧查
//            [Invariant] 规则；仿真类若有 `public static int Bot(DeterministicRandom, int)`，
//            再用它做机器人模糊（3 个种子 × 2000 帧，查规则违反与崩溃）。分叉、规则违反、
//            崩溃即失败。没有回放文件也没有机器人时 skipped；--no-replay 跳过。
// 退出码：0 没有失败步骤（skipped 不算失败）；1 有失败；2 参数问题。
public class ZanCheck {
    static string Esc(string s) {
        if (s == null) { return ""; }
        return s.Replace("\\", "\\\\").Replace("\"", "\\\"").Replace("\n", "\\n")
                .Replace("\r", "\\r").Replace("\t", "\\t");
    }

    static string Str(string s) {
        return "\"" + ZanCheck.Esc(s) + "\"";
    }

    // "key":N —— 从一行 JSON 里取整数字段（summary 行用；不引入 JSON 库）
    static int IntField(string line, string key) {
        string pat = "\"" + key + "\":";
        int at = line.IndexOf(pat);
        if (at < 0) { return 0; }
        int i = at + pat.Length;
        int j = i;
        while (j < line.Length && line.Substring(j, 1) >= "0" && line.Substring(j, 1) <= "9") {
            j = j + 1;
        }
        if (j == i) { return 0; }
        return line.Substring(i, j - i).ToInt32();
    }

    static string StrList(List<string> items, int tail) {
        int from = items.Count > tail ? items.Count - tail : 0;
        string s = "[";
        for (int i = from; i < items.Count; i = i + 1) {
            if (i > from) { s = s + ","; }
            s = s + ZanCheck.Str(items[i]);
        }
        return s + "]";
    }

    static string Skipped(string name, string reason) {
        return "{\"name\":" + ZanCheck.Str(name) + ",\"status\":\"skipped\",\"reason\":"
            + ZanCheck.Str(reason) + "}";
    }

    // compile 步：返回步骤 JSON，ok 经 outOk 带出
    static string Compile(string zanc, List<string> inputs, List<string> extra, string exe,
                          out bool ok) {
        List<string> args = new List<string>();
        for (int i = 0; i < inputs.Count; i = i + 1) { args.Add(inputs[i]); }
        args.Add("--auto-stdlib");
        args.Add("--check-leaks");
        args.Add("--diag=json");
        args.Add("-o");
        args.Add(exe);
        for (int i = 0; i < extra.Count; i = i + 1) { args.Add(extra[i]); }
        ProcessResult r = Process.CaptureSafe(zanc, args, 600000);
        string diags = "";
        int ndiag = 0;
        int errors = 0;
        int warnings = 0;
        bool haveSummary = false;
        List<string> other = new List<string>();
        List<string> lines = r.lines != null ? r.lines : new List<string>();
        for (int i = 0; i < lines.Count; i = i + 1) {
            string l = lines[i].Trim();
            if (l.StartsWith("{\"kind\":\"diagnostic\"")) {
                if (ndiag > 0) { diags = diags + ","; }
                diags = diags + l;
                ndiag = ndiag + 1;
                if (!haveSummary) {
                    if (l.Contains("\"severity\":\"error\"")) { errors = errors + 1; }
                    if (l.Contains("\"severity\":\"warning\"")) { warnings = warnings + 1; }
                }
            } else if (l.StartsWith("{\"kind\":\"summary\"")) {
                errors = ZanCheck.IntField(l, "errors");
                warnings = ZanCheck.IntField(l, "warnings");
                haveSummary = true;
            } else if (l != "") {
                other.Add(l);
            }
        }
        ok = r.exitCode == 0 && File.Exists(exe);
        string s = "{\"name\":\"compile\",\"status\":" + (ok ? "\"pass\"" : "\"fail\"")
            + ",\"exit_code\":" + Convert.ToString(r.exitCode)
            + ",\"errors\":" + Convert.ToString(errors)
            + ",\"warnings\":" + Convert.ToString(warnings)
            + ",\"diagnostics\":[" + diags + "]";
        if (!ok && other.Count > 0) {
            s = s + ",\"other_output\":" + ZanCheck.StrList(other, 20);
        }
        return s + "}";
    }

    // leaks 步：运行产物并解析退出报告
    static string Leaks(string exe, List<string> progArgs, int timeoutMs, out bool ok) {
        Environment.SetEnvironmentVariable("ZAN_LEAK_LOG", "");   // 只要 stdout 里的报告
        long t0 = Stopwatch.GetMilliseconds();
        ProcessResult r = Process.CaptureSafe(exe, progArgs, timeoutMs);
        long elapsed = Stopwatch.GetMilliseconds() - t0;
        if (r.exitCode == 0 - 1 && elapsed >= timeoutMs - 50) {
            ok = false;
            return "{\"name\":\"leaks\",\"status\":\"fail\",\"reason\":"
                + ZanCheck.Str("program did not exit within "
                               + Convert.ToString(timeoutMs / 1000)
                               + "s (pass --timeout or --no-run)") + "}";
        }
        List<string> lines = r.lines != null ? r.lines : new List<string>();
        int head = -1;
        for (int i = 0; i < lines.Count; i = i + 1) {
            if (lines[i].StartsWith("zan: memory leak detected:")) { head = i; break; }
        }
        string s = "{\"name\":\"leaks\",\"exit_code\":" + Convert.ToString(r.exitCode);
        bool leaked = head >= 0;
        if (leaked) {
            string h = lines[head];
            string count = "null";
            int at = h.IndexOf("detected: ");
            if (at >= 0) {
                int i = at + 10;
                int j = i;
                while (j < h.Length && h.Substring(j, 1) >= "0" && h.Substring(j, 1) <= "9") {
                    j = j + 1;
                }
                if (j > i) { count = h.Substring(i, j - i); }
            }
            string mode = h.Contains("unreachable cycles at exit") ? "early-exit" : "strict";
            string sites = "";
            string cycles = "";
            int nsite = 0;
            int ncyc = 0;
            for (int k = head + 1; k < lines.Count; k = k + 1) {
                string l = lines[k].Trim();
                int ob = l.IndexOf(" object(s) leaked, allocated at ");
                if (ob > 0) {
                    if (nsite > 0) { sites = sites + ","; }
                    sites = sites + "{\"count\":" + l.Substring(0, ob) + ",\"site\":"
                        + ZanCheck.Str(l.Substring(ob + 32, l.Length - ob - 32)) + "}";
                    nsite = nsite + 1;
                } else if (l.StartsWith("cycle: ")) {
                    if (ncyc > 0) { cycles = cycles + ","; }
                    cycles = cycles + ZanCheck.Str(l.Substring(7, l.Length - 7));
                    ncyc = ncyc + 1;
                }
            }
            s = s + ",\"leaked\":" + count + ",\"mode\":" + ZanCheck.Str(mode)
                + ",\"header\":" + ZanCheck.Str(h)
                + ",\"sites\":[" + sites + "],\"cycles\":[" + cycles + "]";
        } else {
            s = s + ",\"leaked\":0";
        }
        ok = !leaked && r.exitCode == 0;
        if (r.exitCode != 0) {
            s = s + ",\"output_tail\":" + ZanCheck.StrList(lines, 20);
        }
        return s + ",\"status\":" + (ok ? "\"pass\"" : "\"fail\"") + "}";
    }

    // ---- ui 步（S22）----

    // 输入里的窗体：(类名, 命名空间, 标记路径)，类声明形如 `[partial] class X : Form`
    static void FindForms(List<string> inputs, List<string> names, List<string> nss,
                          List<string> htmls) {
        List<string> files = new List<string>();
        for (int i = 0; i < inputs.Count; i = i + 1) {
            string p = inputs[i];
            if (Directory.Exists(p)) {
                List<string> fs = Directory.GetFiles(p, "*.zan", true);
                for (int k = 0; k < fs.Count; k = k + 1) { files.Add(fs[k]); }
            } else if (p.EndsWith(".zan")) {
                files.Add(p);
            }
        }
        for (int i = 0; i < files.Count; i = i + 1) {
            string text = File.ReadAllText(files[i]);
            // 自己装载标记的窗体（Form.Create + Html.Load / HtmlDocs.Read，处理器经
            // binder.Handle 按名登记）不走声明式装配，new X() 装不出它的界面
            if (text.Contains("Html.Load(") || text.Contains("HtmlDocs.Read(")) { continue; }
            List<string> lines = text.Replace("\r", "").Split("\n");
            string ns = "";
            for (int k = 0; k < lines.Count; k = k + 1) {
                string l = lines[k].Trim();
                if (l.StartsWith("namespace ")) {
                    ns = l.Substring(10, l.Length - 10).Replace(";", "").Replace("{", "").Trim();
                }
                int at = l.IndexOf("class ");
                int colon = l.IndexOf(":");
                if (at < 0 || colon < at) { continue; }
                string after = l.Substring(colon + 1, l.Length - colon - 1).Trim();
                if (!(after == "Form" || after.StartsWith("Form ") || after.StartsWith("Form{")
                      || after.StartsWith("Form,"))) {
                    continue;
                }
                string name = l.Substring(at + 6, colon - at - 6).Trim();
                if (name == "" || name.Contains(" ") || name.Contains("<")) { continue; }
                string html = Path.Combine(Path.GetDirectoryName(files[i]), name + ".html");
                if (File.Exists(html) && !names.Contains(name)) {
                    names.Add(name);
                    nss.Add(ns);
                    htmls.Add(html);
                }
            }
        }
    }

    static string Ui(string zanc, List<string> inputs, List<string> extra, string work,
                     string exeSuffix, int timeoutMs, out bool ok) {
        List<string> names = new List<string>();
        List<string> nss = new List<string>();
        List<string> htmls = new List<string>();
        ZanCheck.FindForms(inputs, names, nss, htmls);
        ok = true;
        if (names.Count == 0) {
            return ZanCheck.Skipped("ui", "no Form with a matching .html found in the inputs");
        }
        string src = "using System;\nusing Gui;\nusing Gui.Testing;\n";
        for (int i = 0; i < nss.Count; i = i + 1) {
            if (nss[i] != "") { src = src + "using " + nss[i] + ";\n"; }
        }
        src = src + "public class ZanCheckUiHarness {\n"
            + "    static void One(string form, Form f, int scale, bool pseudo) {\n"
            + "        string j = UiCheck.Json(form, UiCheck.Run(f, scale, pseudo));\n"
            + "        Console.WriteLine(\"ZANUI {\\\"scale\\\":\" + Convert.ToString(scale)"
            + " + \",\\\"pseudo\\\":\" + (pseudo ? \"true\" : \"false\") + \",\" + j.Substring(1, j.Length - 1));\n"
            + "    }\n"
            + "    public static void Main() {\n"
            + "        int[] scales = new int[] { 100, 150, 200 };\n"
            + "        for (int i = 0; i < scales.Length; i = i + 1) {\n";
        for (int i = 0; i < names.Count; i = i + 1) {
            src = src + "            One(\"" + names[i] + "\", new " + names[i] + "(), scales[i], false);\n"
                + "            One(\"" + names[i] + "\", new " + names[i] + "(), scales[i], true);\n";
        }
        src = src + "        }\n    }\n}\n";
        string harness = Path.Combine(work, "ZanCheckUiHarness.zan");
        File.WriteAllText(harness, src);
        string exe = Path.Combine(work, "ui" + exeSuffix);
        List<string> args = new List<string>();
        args.Add(harness);   // 第一个 Main 是入口：检查程序排在用户源文件之前
        for (int i = 0; i < inputs.Count; i = i + 1) { args.Add(inputs[i]); }
        for (int i = 0; i < htmls.Count; i = i + 1) { args.Add("--embed"); args.Add(htmls[i]); }
        args.Add("--auto-stdlib");
        args.Add("-o");
        args.Add(exe);
        for (int i = 0; i < extra.Count; i = i + 1) { args.Add(extra[i]); }
        ProcessResult cr = Process.CaptureSafe(zanc, args, 600000);
        if (cr.exitCode != 0 || !File.Exists(exe)) {
            ok = false;
            List<string> cl = cr.lines != null ? cr.lines : new List<string>();
            return "{\"name\":\"ui\",\"status\":\"fail\",\"reason\":\"ui check program did not compile\","
                + "\"forms\":" + ZanCheck.StrList(names, names.Count)
                + ",\"output_tail\":" + ZanCheck.StrList(cl, 20) + "}";
        }
        ProcessResult r = Process.CaptureSafe(exe, new List<string>(), timeoutMs);
        List<string> lines = r.lines != null ? r.lines : new List<string>();
        string checks = "";
        int nchecks = 0;
        int issues = 0;
        int pseudoIssues = 0;
        for (int i = 0; i < lines.Count; i = i + 1) {
            string l = lines[i].Trim();
            if (!l.StartsWith("ZANUI ")) { continue; }
            string obj = l.Substring(6, l.Length - 6);
            if (nchecks > 0) { checks = checks + ","; }
            checks = checks + obj;
            nchecks = nchecks + 1;
            int n = obj.Split("\"kind\":").Count - 1;
            if (obj.Contains("\"pseudo\":true")) { pseudoIssues = pseudoIssues + n; }
            else { issues = issues + n; }
        }
        ok = r.exitCode == 0 && issues == 0 && nchecks == names.Count * 6;
        string st = "{\"name\":\"ui\",\"status\":" + (ok ? "\"pass\"" : "\"fail\"")
            + ",\"forms\":" + ZanCheck.StrList(names, names.Count)
            + ",\"issues\":" + Convert.ToString(issues)
            + ",\"pseudo_issues\":" + Convert.ToString(pseudoIssues)
            + ",\"checks\":[" + checks + "]";
        if (r.exitCode != 0 || nchecks != names.Count * 6) {
            st = st + ",\"exit_code\":" + Convert.ToString(r.exitCode)
                + ",\"output_tail\":" + ZanCheck.StrList(lines, 20);
        }
        return st + "}";
    }

    // 输入目录与其上一级的 replays/*.replay（工程布局：<工程>/src + <工程>/replays）
    static List<string> FindReplays(List<string> inputs) {
        List<string> dirs = new List<string>();
        for (int i = 0; i < inputs.Count; i = i + 1) {
            string p = Path.GetFullPath(inputs[i]);
            string d = Directory.Exists(p) ? p : Path.GetDirectoryName(p);
            string up = Path.GetDirectoryName(d);
            string[] cands = new string[] { Path.Combine(d, "replays"), Path.Combine(up, "replays") };
            for (int k = 0; k < cands.Length; k = k + 1) {
                if (Directory.Exists(cands[k]) && !dirs.Contains(cands[k])) { dirs.Add(cands[k]); }
            }
        }
        List<string> files = new List<string>();
        for (int i = 0; i < dirs.Count; i = i + 1) {
            List<string> fs = Directory.GetFiles(dirs[i], "*.replay", false);
            fs.Sort();
            for (int k = 0; k < fs.Count; k = k + 1) { files.Add(fs[k]); }
        }
        return files;
    }

    // 输入源里找类 name 的命名空间与它是否带机器人（static int Bot(DeterministicRandom, int)）；
    // 找不到类返回 false
    static bool FindSim(List<string> inputs, string name, out string ns, out bool bot) {
        ns = "";
        bot = false;
        List<string> files = new List<string>();
        for (int i = 0; i < inputs.Count; i = i + 1) {
            if (Directory.Exists(inputs[i])) {
                List<string> fs = Directory.GetFiles(inputs[i], "*.zan", true);
                for (int k = 0; k < fs.Count; k = k + 1) { files.Add(fs[k]); }
            } else if (inputs[i].EndsWith(".zan")) { files.Add(inputs[i]); }
        }
        for (int i = 0; i < files.Count; i = i + 1) {
            string text = File.ReadAllText(files[i]);
            List<string> lines = text.Replace("\r", "").Split("\n");
            string cur = "";
            bool found = false;
            for (int k = 0; k < lines.Count; k = k + 1) {
                string l = lines[k].Trim();
                if (l.StartsWith("namespace ")) {
                    cur = l.Substring(10, l.Length - 10).Replace(";", "").Replace("{", "").Trim();
                }
                if (!found && (l.Contains("class " + name + " ") || l.Contains("class " + name + ":")
                               || l.EndsWith("class " + name))) {
                    found = true;
                    ns = cur;
                }
            }
            if (found) {
                bot = text.Contains("static int Bot(DeterministicRandom");
                return true;
            }
        }
        return false;
    }

    static string Replays(string zanc, List<string> inputs, List<string> extra, string work,
                          string exeSuffix, int timeoutMs, out bool ok) {
        ok = true;
        List<string> files = ZanCheck.FindReplays(inputs);
        List<string> sims = new List<string>();
        List<string> nss = new List<string>();
        List<bool> bots = new List<bool>();
        string missing = "";
        for (int i = 0; i < files.Count; i = i + 1) {
            string sim = "";
            List<string> lines = File.ReadAllText(files[i]).Replace("\r", "").Split("\n");
            for (int k = 0; k < lines.Count && k < 8; k = k + 1) {
                if (lines[k].StartsWith("sim ")) { sim = lines[k].Substring(4, lines[k].Length - 4).Trim(); }
            }
            if (sims.Contains(sim)) { continue; }
            string ns = "";
            bool bot = false;
            if (sim == "" || !ZanCheck.FindSim(inputs, sim, out ns, out bot)) {
                missing = missing + (missing != "" ? ", " : "") + Path.GetFileName(files[i])
                    + (sim == "" ? " (no 'sim' line)" : " (sim class '" + sim + "' not in the inputs)");
                continue;
            }
            sims.Add(sim);
            nss.Add(ns);
            bots.Add(bot);
        }
        if (missing != "") {
            ok = false;
            return "{\"name\":\"replay\",\"status\":\"fail\",\"reason\":"
                + ZanCheck.Str("replay files name unknown sims: " + missing) + "}";
        }
        if (files.Count == 0) {
            return ZanCheck.Skipped("replay", "no replays/*.replay next to the inputs");
        }
        string src = "using System;\nusing Game.Foundation;\n";
        for (int i = 0; i < nss.Count; i = i + 1) {
            if (nss[i] != "") { src = src + "using " + nss[i] + ";\n"; }
        }
        src = src + "public class ZanCheckReplayHarness {\n"
            + "    static string Esc(string s) { return s.Replace(\"\\\\\", \"\\\\\\\\\").Replace(\"\\\"\", \"\\\\\\\"\").Replace(\"\\n\", \" \"); }\n"
            + "    static void Emit(string what, string sim, string file, long seed, ReplayResult r) {\n"
            + "        Console.WriteLine(\"ZANREPLAY {\\\"kind\\\":\\\"\" + what + \"\\\",\\\"sim\\\":\\\"\" + sim"
            + " + \"\\\",\\\"file\\\":\\\"\" + Esc(file) + \"\\\",\\\"seed\\\":\" + Convert.ToString(seed)"
            + " + \",\\\"ok\\\":\" + (r.ok ? \"true\" : \"false\") + \",\\\"frame\\\":\" + Convert.ToString(r.frame)"
            + " + \",\\\"result\\\":\\\"\" + Esc(r.Describe()) + \"\\\"}\");\n"
            + "    }\n"
            + "    public static void Main() {\n";
        for (int i = 0; i < files.Count; i = i + 1) {
            string sim = "";
            List<string> lines = File.ReadAllText(files[i]).Replace("\r", "").Split("\n");
            for (int k = 0; k < lines.Count && k < 8; k = k + 1) {
                if (lines[k].StartsWith("sim ")) { sim = lines[k].Substring(4, lines[k].Length - 4).Trim(); }
            }
            string path = files[i].Replace("\\", "/");
            src = src + "        { ReplayLog log = ReplayLog.Load(\"" + ZanCheck.Esc(path) + "\");\n"
                + "          Emit(\"replay\", \"" + sim + "\", \"" + ZanCheck.Esc(path) + "\", log.seed, Replay.Verify(new "
                + sim + "(), log)); }\n";
        }
        int fuzzRuns = 0;
        for (int i = 0; i < sims.Count; i = i + 1) {
            if (!bots[i]) { continue; }
            for (int seed = 1; seed <= 3; seed = seed + 1) {
                src = src + "        Emit(\"fuzz\", \"" + sims[i] + "\", \"\", " + Convert.ToString(seed)
                    + ", Replay.Fuzz(new " + sims[i] + "(), \"" + sims[i] + "\", " + Convert.ToString(seed)
                    + ", 2000, " + sims[i] + ".Bot, 0));\n";
                fuzzRuns = fuzzRuns + 1;
            }
        }
        src = src + "    }\n}\n";
        string harness = Path.Combine(work, "ZanCheckReplayHarness.zan");
        File.WriteAllText(harness, src);
        string exe = Path.Combine(work, "replay" + exeSuffix);
        List<string> args = new List<string>();
        args.Add(harness);   // 第一个 Main 是入口
        for (int i = 0; i < inputs.Count; i = i + 1) { args.Add(inputs[i]); }
        args.Add("--auto-stdlib");
        args.Add("-o");
        args.Add(exe);
        for (int i = 0; i < extra.Count; i = i + 1) { args.Add(extra[i]); }
        ProcessResult cr = Process.CaptureSafe(zanc, args, 600000);
        if (cr.exitCode != 0 || !File.Exists(exe)) {
            ok = false;
            List<string> cl = cr.lines != null ? cr.lines : new List<string>();
            return "{\"name\":\"replay\",\"status\":\"fail\",\"reason\":\"replay check program did not compile\","
                + "\"output_tail\":" + ZanCheck.StrList(cl, 20) + "}";
        }
        ProcessResult r = Process.CaptureSafe(exe, new List<string>(), timeoutMs);
        List<string> out2 = r.lines != null ? r.lines : new List<string>();
        string runs = "";
        int n = 0;
        int failed = 0;
        for (int i = 0; i < out2.Count; i = i + 1) {
            string l = out2[i].Trim();
            if (!l.StartsWith("ZANREPLAY ")) { continue; }
            string obj = l.Substring(10, l.Length - 10);
            runs = runs + (n > 0 ? "," : "") + obj;
            n = n + 1;
            if (!obj.Contains("\"ok\":true")) { failed = failed + 1; }
        }
        int want = files.Count + fuzzRuns;
        ok = r.exitCode == 0 && failed == 0 && n == want;
        string st = "{\"name\":\"replay\",\"status\":" + (ok ? "\"pass\"" : "\"fail\"")
            + ",\"replays\":" + Convert.ToString(files.Count) + ",\"fuzz\":" + Convert.ToString(fuzzRuns)
            + ",\"failed\":" + Convert.ToString(failed) + ",\"runs\":[" + runs + "]";
        if (r.exitCode != 0 || n != want) {
            st = st + ",\"exit_code\":" + Convert.ToString(r.exitCode)
                + ",\"output_tail\":" + ZanCheck.StrList(out2, 20);
        }
        return st + "}";
    }

    static void Usage() {
        Console.WriteLine("usage: zan-check <entry.zan|dir...> [--zanc <path>] [--timeout <seconds>]");
        Console.WriteLine("                 [--no-run] [--no-ui] [--no-replay] [--zanc-arg <arg>]...");
        Console.WriteLine("                 [--out <report.json>]");
        Console.WriteLine("                 [-- program args...]");
    }

    static int Main() {
        List<string> inputs = new List<string>();
        List<string> extra = new List<string>();
        List<string> progArgs = new List<string>();
        string zanc = "";
        string outPath = "";
        int timeoutSec = 60;
        bool noRun = false;
        bool noUi = false;
        bool noReplay = false;
        int i = 0;
        bool rest = false;
        while (i < Environment.ArgCount()) {
            string a = Environment.ArgAt(i);
            i = i + 1;
            if (rest) { progArgs.Add(a); continue; }
            if (a == "--") { rest = true; }
            else if (a == "--no-run") { noRun = true; }
            else if (a == "--no-ui") { noUi = true; }
            else if (a == "--no-replay") { noReplay = true; }
            else if (a == "--help" || a == "-h") { ZanCheck.Usage(); return 0; }
            else if ((a == "--zanc" || a == "--timeout" || a == "--zanc-arg" || a == "--out")
                     && i >= Environment.ArgCount()) {
                Console.WriteLine("error: " + a + " needs a value");
                return 2;
            }
            else if (a == "--zanc") { zanc = Environment.ArgAt(i); i = i + 1; }
            else if (a == "--timeout") { timeoutSec = Environment.ArgAt(i).ToInt32(); i = i + 1; }
            else if (a == "--zanc-arg") { extra.Add(Environment.ArgAt(i)); i = i + 1; }
            else if (a == "--out") { outPath = Environment.ArgAt(i); i = i + 1; }
            else if (a.StartsWith("--")) {
                Console.WriteLine("error: unknown option " + a);
                return 2;
            }
            else { inputs.Add(a); }
        }
        if (inputs.Count == 0) {
            ZanCheck.Usage();
            return 2;
        }
        if (timeoutSec <= 0) { timeoutSec = 60; }
        string exeSuffix = "";
        #if WINDOWS
        exeSuffix = ".exe";
        #endif
        if (zanc == "") {
            // 缺省用与 zan-check 同目录的 zanc（工具链布局），其次 PATH 上的 zanc
            string sibling = Path.Combine(ProcessHost.AppDir(), "zanc" + exeSuffix);
            zanc = File.Exists(sibling) ? sibling : "zanc";
        }

        string work = Path.Combine(Path.GetTempPath(),
            "zan-check-" + Convert.ToString(Stopwatch.GetMilliseconds()));
        Directory.CreateDirectory(work);
        string exe = Path.Combine(work, "app" + exeSuffix);

        bool compiled = false;
        string steps = ZanCheck.Compile(zanc, inputs, extra, exe, out compiled);
        bool ok = compiled;
        if (!compiled) {
            steps = steps + "," + ZanCheck.Skipped("leaks", "compile failed");
        } else if (noRun) {
            steps = steps + "," + ZanCheck.Skipped("leaks", "--no-run");
        } else {
            bool leaksOk = false;
            steps = steps + "," + ZanCheck.Leaks(exe, progArgs, timeoutSec * 1000, out leaksOk);
            ok = ok && leaksOk;
        }
        if (!compiled) {
            steps = steps + "," + ZanCheck.Skipped("ui", "compile failed");
        } else if (noUi) {
            steps = steps + "," + ZanCheck.Skipped("ui", "--no-ui");
        } else {
            bool uiOk = true;
            steps = steps + "," + ZanCheck.Ui(zanc, inputs, extra, work, exeSuffix,
                                              timeoutSec * 1000 * 4, out uiOk);
            ok = ok && uiOk;
        }
        if (!compiled) {
            steps = steps + "," + ZanCheck.Skipped("replay", "compile failed");
        } else if (noReplay) {
            steps = steps + "," + ZanCheck.Skipped("replay", "--no-replay");
        } else {
            bool replayOk = true;
            steps = steps + "," + ZanCheck.Replays(zanc, inputs, extra, work, exeSuffix,
                                                   timeoutSec * 1000 * 4, out replayOk);
            ok = ok && replayOk;
        }

        string report = "{\"version\":1,\"ok\":" + (ok ? "true" : "false")
            + ",\"inputs\":" + ZanCheck.StrList(inputs, inputs.Count)
            + ",\"steps\":[" + steps + "]}";
        Console.WriteLine(report);
        if (outPath != "") { File.WriteAllText(outPath, report + "\n"); }
        Directory.DeleteRecursive(work);
        return ok ? 0 : 1;
    }
}
