using System;

namespace Fmt;

/// The Zan code formatter: re-indents a .zan file with four spaces per brace
/// level, strips trailing whitespace, collapses runs of blank lines to one and
/// guarantees a final newline. It is deliberately line-based -- it never
/// reflows or re-spaces the code inside a line -- so formatting a file can
/// only ever change leading and trailing whitespace.
///
///   zanfmt <file.zan>            format in place
///   zanfmt --check <file.zan>    exit 1 if the file is not formatted
///   zanfmt --stdout <file.zan>   write the formatted text to stdout
class Program {
    static int IndentSize() { return 4; }

    static bool IsSpace(string ch) {
        return ch == " " || ch == "\t" || ch == "\r";
    }

    static string TrimTrailing(string line) {
        int n = line.Length;
        while (n > 0 && Program.IsSpace(line.Substring(n - 1, 1))) {
            n = n - 1;
        }
        return line.Substring(0, n);
    }

    static string StripLeading(string line) {
        int i = 0;
        while (i < line.Length) {
            string ch = line.Substring(i, 1);
            if (ch != " " && ch != "\t") { break; }
            i = i + 1;
        }
        return line.Substring(i, line.Length - i);
    }

    static string Spaces(int count) {
        StringBuilder sb = new StringBuilder();
        int i = 0;
        while (i < count) {
            sb.Append(" ");
            i = i + 1;
        }
        return sb.ToString();
    }

    static string Format(string src) {
        List<string> lines = src.Split("\n");
        StringBuilder res = new StringBuilder();
        int indent = 0;
        int blanks = 0;
        int i = 0;
        int lineCount = lines.Count;
        // A trailing newline yields one empty trailing element, which is the
        // end of the last line rather than a line of its own.
        if (lineCount > 0 && lines[lineCount - 1] == "") { lineCount = lineCount - 1; }
        while (i < lineCount) {
            string line = Program.TrimTrailing(lines[i]);
            i = i + 1;
            string content = Program.StripLeading(line);
            if (content.Length == 0) {
                blanks = blanks + 1;
                if (blanks <= 1) { res.Append("\n"); }
                continue;
            }
            blanks = 0;
            if (content.StartsWith("}")) {
                indent = indent - 1;
                if (indent < 0) { indent = 0; }
            }
            res.Append(Program.Spaces(indent * Program.IndentSize()));
            res.Append(content);
            res.Append("\n");
            if (content.EndsWith("{")) { indent = indent + 1; }
        }
        return res.ToString();
    }

    static void PrintUsage() {
        Console.WriteLine("Zan Code Formatter (zanfmt)");
        Console.WriteLine("");
        Console.WriteLine("Usage:");
        Console.WriteLine("  zanfmt <file.zan>              Format file in-place");
        Console.WriteLine("  zanfmt --check <file.zan>      Check formatting (exit 1 if changes needed)");
        Console.WriteLine("  zanfmt --stdout <file.zan>     Print formatted to stdout");
        Console.WriteLine("  zanfmt --help                  Show this help");
    }

    static int Main() {
        bool check = false;
        bool toStdout = false;
        string path = "";
        int i = 0;
        while (i < Environment.ArgCount()) {
            string arg = Environment.ArgAt(i);
            i = i + 1;
            if (arg == "--check") { check = true; }
            else if (arg == "--stdout") { toStdout = true; }
            else if (arg == "--help" || arg == "-h") {
                Program.PrintUsage();
                return 0;
            }
            else { path = arg; }
        }

        if (Environment.ArgCount() == 0) {
            Program.PrintUsage();
            return 0;
        }
        if (path == "") {
            Console.WriteLine("error: no file specified");
            return 1;
        }
        if (!File.Exists(path)) {
            Console.WriteLine($"error: cannot read '{path}'");
            return 1;
        }

        string src = File.ReadAllText(path);
        string formatted = Program.Format(src);

        if (check) {
            // The formatter emits "\n" and the file writer supplies the
            // platform line ending, so line-ending style is not what --check
            // is about.
            if (formatted == src.Replace("\r\n", "\n")) {
                Console.WriteLine($"{path}: ok");
                return 0;
            }
            Console.WriteLine($"{path}: needs formatting");
            return 1;
        }

        if (toStdout) {
            Console.Write(formatted);
            return 0;
        }

        File.WriteAllText(path, formatted);
        Console.WriteLine($"Formatted: {path}");
        return 0;
    }
}
