using System;

namespace Fmt;

public class ZanFmt {
    static int IndentSize() { return 4; }
    static int MaxIndent() { return 256; }
    static string Spaces32() { return "                                "; }

    static bool IsSpaceByte(int c) {
        return c == 32 || c == 9 || c == 13;
    }

    static string TrimTrailing(string line) {
        if (line == null) { return ""; }
        int n = line.Length;
        while (n > 0 && ZanFmt.IsSpaceByte(line[n - 1] & 255)) {
            n = n - 1;
        }
        if (n == line.Length) { return line; }
        return line.Substring(0, n);
    }

    static string StripLeading(string line) {
        if (line == null) { return ""; }
        int i = 0;
        while (i < line.Length) {
            int ch = line[i] & 255;
            if (ch != 32 && ch != 9) { break; }
            i = i + 1;
        }
        if (i == 0) { return line; }
        return line.Substring(i, line.Length - i);
    }

    static void AppendSpaces(StringBuilder sb, int count) {
        if (count <= 0) { return; }
        int maxSpaces = ZanFmt.MaxIndent() * ZanFmt.IndentSize();
        if (count > maxSpaces) { count = maxSpaces; }
        string chunk = ZanFmt.Spaces32();
        while (count >= 32) {
            sb.Append(chunk);
            count = count - 32;
        }
        if (count > 0) {
            sb.Append(chunk.Substring(0, count));
        }
    }

    static string Spaces(int count) {
        if (count <= 0) { return ""; }
        int maxSpaces = ZanFmt.MaxIndent() * ZanFmt.IndentSize();
        if (count > maxSpaces) { count = maxSpaces; }
        if (count <= 32) {
            return ZanFmt.Spaces32().Substring(0, count);
        }
        StringBuilder sb = new StringBuilder();
        ZanFmt.AppendSpaces(sb, count);
        return sb.ToString();
    }

    static string Format(string src) {
        if (src == null) { return ""; }
        string normalized = src.Replace("\r\n", "\n");
        List<string> lines = normalized.Split("\n");
        StringBuilder res = new StringBuilder();
        int indent = 0;
        int blanks = 0;
        int i = 0;
        int lineCount = lines.Count;
        if (lineCount > 0 && lines[lineCount - 1] == "") { lineCount = lineCount - 1; }
        while (i < lineCount) {
            string line = ZanFmt.TrimTrailing(lines[i]);
            i = i + 1;
            string content = ZanFmt.StripLeading(line);
            if (content.Length == 0) {
                blanks = blanks + 1;
                if (blanks <= 1) { res.Append("\n"); }
                continue;
            }
            blanks = 0;
            if (content.StartsWith("}")) {
                indent = indent - 1;
                if (indent < 0) { indent = 0; }
            }
            int effIndent = indent > ZanFmt.MaxIndent() ? ZanFmt.MaxIndent() : indent;
            ZanFmt.AppendSpaces(res, effIndent * ZanFmt.IndentSize());
            res.Append(content);
            res.Append("\n");
            if (content.EndsWith("{")) {
                if (indent < ZanFmt.MaxIndent()) { indent = indent + 1; }
            }
        }
        return res.ToString();
    }

    static void PrintUsage() {
        Console.WriteLine("Zan Code Formatter (zanfmt)");
        Console.WriteLine("");
        Console.WriteLine("Usage:");
        Console.WriteLine("  zanfmt <file.zan>              Format file in-place");
        Console.WriteLine("  zanfmt --check <file.zan>      Check formatting (exit 1 if changes needed)");
        Console.WriteLine("  zanfmt --stdout <file.zan>     Print formatted to stdout");
        Console.WriteLine("  zanfmt --help                  Show this help");
    }

    static int Main() {
        bool check = false;
        bool toStdout = false;
        string path = "";
        int i = 0;
        while (i < Environment.ArgCount()) {
            string arg = Environment.ArgAt(i);
            i = i + 1;
            if (arg == "--check") { check = true; }
            else if (arg == "--stdout") { toStdout = true; }
            else if (arg == "--help" || arg == "-h") {
                ZanFmt.PrintUsage();
                return 0;
            }
            else { path = arg; }
        }

        if (Environment.ArgCount() == 0) {
            ZanFmt.PrintUsage();
            return 0;
        }
        if (path == "") {
            Console.WriteLine("error: no file specified");
            return 1;
        }
        if (!File.Exists(path)) {
            Console.WriteLine($"error: cannot read '{path}'");
            return 1;
        }

        string src = File.ReadAllText(path);
        string formatted = ZanFmt.Format(src);

        if (check) {
            if (formatted == src.Replace("\r\n", "\n")) {
                Console.WriteLine($"{path}: ok");
                return 0;
            }
            Console.WriteLine($"{path}: needs formatting");
            return 1;
        }

        if (toStdout) {
            Console.Write(formatted);
            return 0;
        }

        File.WriteAllText(path, formatted);
        Console.WriteLine($"Formatted: {path}");
        return 0;
    }
}
