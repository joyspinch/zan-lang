    internal static extern int PosixCondInit(nint cv, nint attr);

    [DllImport("crt", EntryPoint = "pthread_cond_destroy")]
    internal static extern int PosixCondDestroy(nint cv);

    [DllImport("crt", EntryPoint = "pthread_cond_signal")]
    internal static extern int PosixCondSignal(nint cv);

    [DllImport("crt", EntryPoint = "pthread_cond_broadcast")]
    internal static extern int PosixCondBroadcast(nint cv);

    [DllImport("crt", EntryPoint = "pthread_cond_timedwait")]
    internal static extern int PosixCondTimedWait(nint cv, nint mx, nint ts);

    [DllImport("crt", EntryPoint = "pthread_key_create")]
    internal static extern int PosixKeyCreate(nint keyOut, nint dtor);

#if MACOS
    [DllImport("crt", EntryPoint = "pthread_getspecific")]
    internal static extern nint PosixGetSpecific(ulong key);

    [DllImport("crt", EntryPoint = "pthread_setspecific")]
    internal static extern int PosixSetSpecific(ulong key, nint val);
#else
    [DllImport("crt", EntryPoint = "pthread_getspecific")]
    internal static extern nint PosixGetSpecific(uint key);

    [DllImport("crt", EntryPoint = "pthread_setspecific")]
    internal static extern int PosixSetSpecific(uint key, nint val);
#endif
#endif

    // ---- Cross-platform helpers ----
    internal static long NowMs() {
#if WINDOWS
        return (long)WinGetTickCount64();
#else
        IoBuf16 ts = new IoBuf16();
        PosixClockGetTime(IoConst.CLOCK_MONOTONIC, NativeMemory.AddressOf(ref ts));
        long sec = NativeMemory.AsRef<long>(NativeMemory.AddressOf(ref ts));
        long nsec = NativeMemory.AsRef<long>((NativeMemory.AddressOf(ref ts)) + (nint)(8L));
        return sec * 1000L + nsec / 1000000L;
#endif
    }

    internal static void SleepMs(long ms) {
        if (ms <= 0L) return;
        if (ms > 0x7FFFFFFFL) ms = 0x7FFFFFFFL;
#if WINDOWS
        WinSleep((uint)ms);
#else
        IoBuf16 ts = new IoBuf16();
        nint p = NativeMemory.AddressOf(ref ts);
        NativeMemory.AsRef<long>(p) = ms / 1000L;
        NativeMemory.AsRef<long>((p) + (nint)(8L)) = (ms % 1000L) * 1000000L;
        PosixNanosleep(p, (nint)0);
#endif
    }

    internal static void YieldCpu() {
#if WINDOWS
        WinSwitchToThread();
#else
        PosixSchedYield();
#endif
    }

    internal static ulong CurrentTid() {
#if WINDOWS
        return (ulong)WinGetCurrentThreadId();
#else
        return PosixThreadSelf();
#endif
    }

    // Cross-platform mutex (40 bytes fits both Win64 CRITICAL_SECTION=40 and Linux pthread_mutex_t=40)
    internal static void MutexInit(nint m) {
#if WINDOWS
        WinInitCs(m);
#else
        PosixMutexInit(m, (nint)0);
#endif
    }

    internal static void MutexDestroy(nint m) {
#if WINDOWS
        WinDeleteCs(m);
#else
        PosixMutexDestroy(m);
#endif
    }

    internal static void MutexLock(nint m) {
#if WINDOWS
        WinEnterCs(m);
#else
        PosixMutexLock(m);
#endif
    }

    internal static int MutexTryLock(nint m) {
#if WINDOWS
        return WinTryEnterCs(m) != 0 ? 1 : 0;
#else
        return PosixMutexTryLock(m) == 0 ? 1 : 0;
#endif
    }

    internal static void MutexUnlock(nint m) {
#if WINDOWS
        WinLeaveCs(m);
#else
        PosixMutexUnlock(m);
#endif
    }

    // Endian helpers (little-endian x86_64)
    internal static ushort Htons(ushort v) {
        return (ushort)(((v & 0xFFU) << 8) | ((v >> 8) & 0xFFU));
    }

    internal static uint Ntohl(uint v) {
        return ((v & 0x000000FFU) << 24) |
               ((v & 0x0000FF00U) << 8) |
               ((v & 0x00FF0000U) >> 8) |
               ((v & 0xFF000000U) >> 24);
    }

    // Division-free deterministic shard hash (0..n-1) and wrap helper
    internal static int ShardHash(ulong key, int n) {
        if (n <= 1) return 0;
        uint h = (uint)(((key >> 2) ^ (key >> 18)) * 2654435761UL);
        return (int)(((ulong)h * (ulong)(uint)n) >> 32);
    }

    internal static int FastModSmall(int val, int n) {
        if (n <= 1) return 0;
        int v = val;
        if (v < 0) v = 0;
        while (v >= n) v -= n;
        return v;
    }

    // Decimal int32 -> NUL-terminated ASCII (no snprintf dependency)
    internal static void FormatInt32(int v, nint buf, int cap) {
        if (buf == (nint)0 || cap <= 1) return;
        int pos = 0;
        uint uv = 0U;
        if (v < 0) {
            NativeMemory.AsRef<byte>((buf) + (nint)((long)pos)) = 45; // '-'
            pos++;
            uv = (uint)(0L - (long)v);
        } else {
            uv = (uint)v;
        }
        IoBuf16 tmp = new IoBuf16();
        nint tp = NativeMemory.AddressOf(ref tmp);
        int tn = 0;
        if (uv == 0U) {
            NativeMemory.AsRef<byte>(tp) = 48;
            tn = 1;
        } else {
            while (uv > 0U && tn < 15) {
                uint q = uv / 10U;
                uint r = uv - q * 10U;
                NativeMemory.AsRef<byte>((tp) + (nint)((long)tn)) = (byte)(48U + r);
                tn++;
                uv = q;
            }
        }
        while (tn > 0 && pos < cap - 1) {
            tn--;
            NativeMemory.AsRef<byte>((buf) + (nint)((long)pos)) = NativeMemory.AsRef<byte>((tp) + (nint)((long)tn));
            pos++;
        }
        NativeMemory.AsRef<byte>((buf) + (nint)((long)pos)) = 0;
    }

    // ---- Zero-ThreadStatic per-thread IoTls via FLS / pthread_key ----
    static int s_tlsState = 0;
#if MACOS
    static ulong s_tlsKey = 0UL;
#else
    static uint s_tlsKey = 0xFFFFFFFFU;
#endif

    [Export("__zan_io_tls_dtor")]
    [Visibility("hidden")]
    static void TlsDestructor(nint p) {
        if (p == (nint)0) return;
#if WINDOWS && ZAN_CO_DRIVER
        int opCnt = NativeMemory.AsRef<int>((p) + (nint)(IoConst.TLS_OP_CNT));
        for (int i = 0; i < opCnt; i++) {
            nint op = NativeMemory.AsRef<nint>((p) + (nint)(IoConst.TLS_OP_ITEMS + (long)i * 8L));
            if (op != (nint)0) CFree(op);
        }
#endif
#if ZAN_CO_DRIVER
        for (int c = 0; c < IoConst.ZAN_CO_FRAME_CLASSES; c++) {
            ulong cnt = NativeMemory.AsRef<ulong>((p) + (nint)(IoConst.TLS_FRM_CNT + (long)c * 8L));
            long baseOff = IoConst.TLS_FRM_ITEMS + (long)c * (long)IoConst.ZAN_CO_FRAME_POOL_CAP * 8L;
            for (ulong i = 0UL; i < cnt && i < (ulong)IoConst.ZAN_CO_FRAME_POOL_CAP; i++) {
                nint fp = NativeMemory.AsRef<nint>((p) + (nint)(baseOff + (long)i * 8L));
                if (fp != (nint)0) CFree(fp);
            }
        }
#endif
        CFree(p);
    }

    static bool EnsureTlsKey() {
        int st = Atomic.Load(ref s_tlsState, MemoryOrder.Acquire);
        if (st == 2) return true;
        if (st == 3) return false;
        if (Atomic.CompareExchange(ref s_tlsState, 0, 1, MemoryOrder.AcqRel, MemoryOrder.Acquire) == 0) {
            bool ok = false;
#if WINDOWS
            uint k = WinFlsAlloc(NativeMemory.FunctionPointer(TlsDestructor));
            if (k != IoConst.FLS_OUT_OF_INDEXES) {
                s_tlsKey = k;
                ok = true;
            }
#elif MACOS
            ulong k = 0UL;
            if (PosixKeyCreate(NativeMemory.AddressOf(ref k), NativeMemory.FunctionPointer(TlsDestructor)) == 0) {
                s_tlsKey = k;
                ok = true;
            }
#else
            uint k = 0U;
            if (PosixKeyCreate(NativeMemory.AddressOf(ref k), NativeMemory.FunctionPointer(TlsDestructor)) == 0) {
                s_tlsKey = k;
                ok = true;
            }
#endif
            Atomic.Store(ref s_tlsState, ok ? 2 : 3, MemoryOrder.Release);
            return ok;
        }
        while (Atomic.Load(ref s_tlsState, MemoryOrder.Acquire) == 1) {
            YieldCpu();
        }
        return Atomic.Load(ref s_tlsState, MemoryOrder.Acquire) == 2;
    }

    internal static nint GetTls(bool create) {
        if (!EnsureTlsKey()) return (nint)0;
#if WINDOWS
        nint p = WinFlsGetValue(s_tlsKey);
#else
        nint p = PosixGetSpecific(s_tlsKey);
#endif
        if (p != (nint)0 || !create) return p;
        p = CCalloc(1UL, IoConst.TLS_SIZE);
        if (p == (nint)0) return (nint)0;
        NativeMemory.AsRef<int>((p) + (nint)(IoConst.TLS_FAST_BUDGET)) = IoConst.ZAN_IO_FAST_BURST;
#if WINDOWS
        if (WinFlsSetValue(s_tlsKey, p) == 0) {
            CFree(p);
            return (nint)0;
        }
#else
        if (PosixSetSpecific(s_tlsKey, p) != 0) {
            CFree(p);
            return (nint)0;
        }
#endif
        return p;
    }

    internal static nint GetTlsIpBuf() {
        nint tls = GetTls(true);
        return tls != (nint)0 ? tls + (nint)IoConst.TLS_IP_BUF : (nint)0;
    }

    // ---- Exported utilities & socket helpers ----
    [Export("zan_cpu_count")]
    public static int CpuCount() {
#if WINDOWS
        IoBuf48 si = new IoBuf48();
        nint p = NativeMemory.AddressOf(ref si);
        WinGetSystemInfo(p);
        uint n = NativeMemory.AsRef<uint>((p) + (nint)(32L));
        return n > 0U ? (int)n : 1;
#else
        long n = PosixSysconf(IoConst.SC_NPROCESSORS_ONLN);
        return n > 0L ? (int)n : 1;
#endif
    }

    [Export("zan_rt_eprint_line")]
    public static void RtEprintLine(nint text) {
#if WINDOWS
        nint err = WinAcrtIobFunc(2U);
        if (text != (nint)0 && NativeMemory.AsRef<byte>(text) != 0) {
            CFputs(text, err);
        }
        CFputc(13, err);
        CFputc(10, err);
        CFflush(err);
#else
        if (text != (nint)0 && NativeMemory.AsRef<byte>(text) != 0) {
            ulong n = CStrLen(text);
            if (n > 0UL) {
                long wr = PosixWrite(2, text, n);
                _ = wr;
            }
        }
        byte nl = 10;
        long wr2 = PosixWrite(2, NativeMemory.AddressOf(ref nl), 1UL);
        _ = wr2;
#endif
    }

#if WINDOWS
    internal static int s_socketCleanupRequested = 0;
#endif

    [Export("zan_io_socket_cleanup")]
    public static void SocketCleanup() {
#if WINDOWS
#if ZAN_CO_DRIVER
        Atomic.FetchAdd(ref s_socketCleanupRequested, 1, MemoryOrder.AcqRel);
#else
        WsaCleanup();
#endif
#endif
    }

    [Export("zan_io_set_nonblocking")]
    public static int SetNonblocking(nint fd) {
#if WINDOWS
        uint mode = 1U;
        return WsaIoctlSocket((ulong)fd, IoConst.FIONBIO, NativeMemory.AddressOf(ref mode));
#else
        int flags = PosixFcntl2((int)fd, IoConst.F_GETFL);
        if (flags < 0) return -1;
        return PosixFcntl3((int)fd, IoConst.F_SETFL, flags | IoConst.O_NONBLOCK);
#endif
    }

    [Export("zan_io_socket_send")]
    public static long SocketSend(nint fd, nint buf, long len, int flags) {
        if (len <= 0L) return len == 0L ? 0L : -2L;
        if (len > 0x7FFFFFFFL) len = 0x7FFFFFFFL;
#if WINDOWS
        for (;;) {
            int sr = SockSend((ulong)fd, buf, (int)len, flags);
            if (sr != -1) return (long)sr;
            int e = WsaGetLastError();
            if (e == IoConst.WSAEWOULDBLOCK) return -1L;
            if (e == IoConst.WSAEINTR) continue;
            return -2L;
        }
#else
        int fl = flags | IoConst.MSG_NOSIGNAL;
        for (;;) {
            long r = SockSend((int)fd, buf, (ulong)len, fl);
            if (r >= 0L) return r;
            int e = GetErrno();
            if (e == IoConst.EAGAIN || e == IoConst.EWOULDBLOCK) return -1L;
            if (e == IoConst.EINTR) continue;
            return -2L;
        }
#endif
    }

    [Export("zan_io_socket_recv")]
    public static long SocketRecv(nint fd, nint buf, long len, int flags) {
        if (len < 0L) return -2L;
        if (len > 0x7FFFFFFFL) len = 0x7FFFFFFFL;
#if WINDOWS
        for (;;) {
            int rr = SockRecv((ulong)fd, buf, (int)len, flags);
            if (rr != -1) return (long)rr;
            int e = WsaGetLastError();
            if (e == IoConst.WSAEWOULDBLOCK) return -1L;
            if (e == IoConst.WSAEINTR) continue;
            return -2L;
        }
#else
        for (;;) {
            long r = SockRecv((int)fd, buf, (ulong)len, flags);
            if (r >= 0L) return r;
            int e = GetErrno();
            if (e == IoConst.EAGAIN || e == IoConst.EWOULDBLOCK) return -1L;
            if (e == IoConst.EINTR) continue;
            return -2L;
        }
#endif
    }

    [Export("zan_io_socket_alive")]
    public static int SocketAlive(nint fd) {
#if WINDOWS
        if ((ulong)fd == 0xFFFFFFFFFFFFFFFFUL) return 0;
        int type = 0;
        int tlen = 4;
        return SockGetOpt((ulong)fd, IoConst.SOL_SOCKET, IoConst.SO_TYPE,
                          NativeMemory.AddressOf(ref type), NativeMemory.AddressOf(ref tlen)) == 0 ? 1 : 0;
#else
        if ((long)fd < 0L) return 0;
        return PosixFcntl2((int)fd, IoConst.F_GETFD) != -1 ? 1 : 0;
#endif
    }

    // fd_set helpers:
    // Win64 fd_set (520B): uint fd_count@0, ulong fd_array[64]@8
    // Linux fd_set (128B): ulong fds_bits[16]@0
    static void FdSetSingle(nint fdset, nint fd) {
#if WINDOWS
        NativeMemory.AsRef<uint>(fdset) = 1U;
        NativeMemory.AsRef<ulong>((fdset) + (nint)(8L)) = (ulong)fd;
#else
        CMemset(fdset, 0, 128UL);
        int s = (int)fd;
        if (s >= 0 && s < IoConst.FD_SETSIZE) {
            long wordIdx = (long)(s >> 6);
            int bit = s & 63;
            NativeMemory.AsRef<ulong>((fdset) + (nint)(wordIdx * 8L)) = (1UL << bit);
        }
#endif
    }

    static bool FdIsSetSingle(nint fdset, nint fd) {
#if WINDOWS
        uint cnt = NativeMemory.AsRef<uint>(fdset);
        return cnt > 0U && NativeMemory.AsRef<ulong>((fdset) + (nint)(8L)) == (ulong)fd;
#else
        int s = (int)fd;
        if (s < 0 || s >= IoConst.FD_SETSIZE) return false;
        long wordIdx = (long)(s >> 6);
        int bit = s & 63;
        return (NativeMemory.AsRef<ulong>((fdset) + (nint)(wordIdx * 8L)) & (1UL << bit)) != 0UL;
#endif
    }

    [Export("zan_io_socket_ready")]
    public static int SocketReady(nint fd, int writeReady) {
#if WINDOWS
        if ((ulong)fd == 0xFFFFFFFFFFFFFFFFUL) return -1;
        IoBuf16 fds = new IoBuf16();
        nint fp = NativeMemory.AddressOf(ref fds);
        FdSetSingle(fp, fd);
        ulong tv = 0UL; // {0, 0} (8 bytes on Win64)
        return SockSelect(0,
                          writeReady != 0 ? (nint)0 : fp,
                          writeReady != 0 ? fp : (nint)0,
                          (nint)0, NativeMemory.AddressOf(ref tv));
#else
        if ((long)fd < 0L || (long)fd >= (long)IoConst.FD_SETSIZE) return -1;
        IoBuf128 fds = new IoBuf128();
        nint fp = NativeMemory.AddressOf(ref fds);
        FdSetSingle(fp, fd);
        IoBuf16 tv = new IoBuf16(); // {0, 0} (16 bytes on Linux x86_64)
        return SockSelect((int)fd + 1,
                          writeReady != 0 ? (nint)0 : fp,
                          writeReady != 0 ? fp : (nint)0,
                          (nint)0, NativeMemory.AddressOf(ref tv));
#endif
    }

    [Export("zan_io_connect_status")]
    public static int ConnectStatus(nint fd) {
        int err = 0;
        int elen = 4;
#if WINDOWS
        if ((ulong)fd == 0xFFFFFFFFFFFFFFFFUL) return -1;
        IoBuf16 wfds = new IoBuf16();
        IoBuf16 efds = new IoBuf16();
        nint wp = NativeMemory.AddressOf(ref wfds);
        nint ep = NativeMemory.AddressOf(ref efds);
        FdSetSingle(wp, fd);
        FdSetSingle(ep, fd);
        ulong tv = 0UL;
        if (SockSelect(0, (nint)0, wp, ep, NativeMemory.AddressOf(ref tv)) < 0) return -1;
        if (FdIsSetSingle(ep, fd)) {
            if (SockGetOpt((ulong)fd, IoConst.SOL_SOCKET, IoConst.SO_ERROR,
                           NativeMemory.AddressOf(ref err), NativeMemory.AddressOf(ref elen)) != 0) return -1;
            return err != 0 ? err : -1;
        }
        if (FdIsSetSingle(wp, fd)) {
            if (SockGetOpt((ulong)fd, IoConst.SOL_SOCKET, IoConst.SO_ERROR,
                           NativeMemory.AddressOf(ref err), NativeMemory.AddressOf(ref elen)) != 0) return -1;
            return err;
        }
        return -2;
#else
        if ((long)fd < 0L || (long)fd >= (long)IoConst.FD_SETSIZE) return -1;
        IoBuf128 wfds = new IoBuf128();
        IoBuf128 efds = new IoBuf128();
        nint wp = NativeMemory.AddressOf(ref wfds);
        nint ep = NativeMemory.AddressOf(ref efds);
        FdSetSingle(wp, fd);
        FdSetSingle(ep, fd);
        IoBuf16 tv = new IoBuf16();
        if (SockSelect((int)fd + 1, (nint)0, wp, ep, NativeMemory.AddressOf(ref tv)) < 0) return -1;
        uint ulen = 4U;
        if (FdIsSetSingle(ep, fd)) {
            if (SockGetOpt((int)fd, IoConst.SOL_SOCKET, IoConst.SO_ERROR,
                           NativeMemory.AddressOf(ref err), NativeMemory.AddressOf(ref ulen)) != 0) return -1;
            return err != 0 ? err : -1;
        }
        if (FdIsSetSingle(wp, fd)) {
            if (SockGetOpt((int)fd, IoConst.SOL_SOCKET, IoConst.SO_ERROR,
                           NativeMemory.AddressOf(ref err), NativeMemory.AddressOf(ref ulen)) != 0) return -1;
            return err;
        }
        return -2;
#endif
    }

    [Export("zan_io_connect_sa_start")]
    public static int ConnectSaStart(nint fd, nint sa, int salen) {
        if (sa == (nint)0 || IoAddr.SockaddrFamily(sa, salen) == 0) return -1;
        if (SetNonblocking(fd) != 0) return -1;
#if WINDOWS
        int r = SockConnect((ulong)fd, sa, salen);
        if (r == 0) return 0;
        int e = WsaGetLastError();
        if (e == IoConst.WSAEINPROGRESS || e == IoConst.WSAEWOULDBLOCK || e == IoConst.WSAEALREADY) return -2;
        return e > 0 ? e : -1;
#else
        int r = SockConnect((int)fd, sa, (uint)salen);
        if (r == 0) return 0;
        int e = GetErrno();
        if (e == IoConst.EINPROGRESS || e == IoConst.EWOULDBLOCK || e == IoConst.EALREADY) return -2;
        return e > 0 ? e : -1;
#endif
    }

    [Export("zan_io_connect_sa")]
    public static long ConnectSa(nint fd, nint sa, int salen, int timeoutMs) {
        int r = ConnectSaStart(fd, sa, salen);
        if (r == 0 || r != -2) return (long)r;
#if WINDOWS
        IoBuf16 wfds = new IoBuf16();
        IoBuf16 efds = new IoBuf16();
        nint wp = NativeMemory.AddressOf(ref wfds);
        nint ep = NativeMemory.AddressOf(ref efds);
        FdSetSingle(wp, fd);
        FdSetSingle(ep, fd);
        ulong tv = 0UL;
        nint ptv = (nint)0;
        if (timeoutMs >= 0) {
            nint tvp = NativeMemory.AddressOf(ref tv);
            NativeMemory.AsRef<int>(tvp) = timeoutMs / 1000;
            NativeMemory.AsRef<int>((tvp) + (nint)(4L)) = (timeoutMs % 1000) * 1000;
            ptv = tvp;
        }
        if (SockSelect(0, (nint)0, wp, ep, ptv) <= 0) return -3L;
        int err = 0;
        int elen = 4;
        if (SockGetOpt((ulong)fd, IoConst.SOL_SOCKET, IoConst.SO_ERROR,
                       NativeMemory.AddressOf(ref err), NativeMemory.AddressOf(ref elen)) != 0) return -1L;
        return (long)err;
#else
        if ((long)fd < 0L || (long)fd >= (long)IoConst.FD_SETSIZE) return -1L;
        IoBuf128 wfds = new IoBuf128();
        IoBuf128 efds = new IoBuf128();
        nint wp = NativeMemory.AddressOf(ref wfds);
        nint ep = NativeMemory.AddressOf(ref efds);
        FdSetSingle(wp, fd);
        FdSetSingle(ep, fd);
        IoBuf16 tv = new IoBuf16();
        nint ptv = (nint)0;
        if (timeoutMs >= 0) {
            nint tvp = NativeMemory.AddressOf(ref tv);
            NativeMemory.AsRef<long>(tvp) = (long)(timeoutMs / 1000);
            NativeMemory.AsRef<long>((tvp) + (nint)(8L)) = (long)((timeoutMs % 1000) * 1000);
            ptv = tvp;
        }
        int sr = 0;
        for (;;) {
            sr = SockSelect((int)fd + 1, (nint)0, wp, ep, ptv);
            if (sr >= 0 || GetErrno() != IoConst.EINTR) break;
        }
        if (sr <= 0) return sr == 0 ? -3L : -1L;
        int err = 0;
        uint elen = 4U;
        if (SockGetOpt((int)fd, IoConst.SOL_SOCKET, IoConst.SO_ERROR,
                       NativeMemory.AddressOf(ref err), NativeMemory.AddressOf(ref elen)) != 0) return -1L;
        return (long)err;
#endif
    }
}
