    [DllImport("crt", EntryPoint = "zan_co_quantum_ms")]
    internal static extern long CoQuantumMs();

    [DllImport("crt", EntryPoint = "zan_task_frame_allocator")]
    internal static extern void TaskFrameAllocator(nint frame, nint releaseFn);

    [DllImport("crt", EntryPoint = "zan_task_retire")]
    internal static extern void TaskRetire(nint frame, nint releaseFn);

    [DllImport("crt", EntryPoint = "zan_task_run_profiled")]
    internal static extern void TaskRunProfiled(nint frame, nint step);

    [DllImport("crt", EntryPoint = "zan_timer_delay")]
    internal static extern void TimerDelay(long ms, nint frame, nint step);

    [DllImport("crt", EntryPoint = "zan_timer_dispatch_due")]
    internal static extern void TimerDispatchDue();

    [DllImport("crt", EntryPoint = "zan_timer_pending")]
