static class IoPlat {
    // ---- Runtime imports ----
    [DllImport("crt", EntryPoint = "zan_rt_fatal")]
    internal static extern void RtFatal(nint cat, nint msg);

    [DllImport("crt", EntryPoint = "zan_co_precise_us")]
    internal static extern long CoPreciseUs();

    [DllImport("crt", EntryPoint = "zan_timer_after_ctx")]
