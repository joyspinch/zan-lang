// rt_io_plat.zan: Platform FFI, opaque stack buffers, cross-platform locks,
// zero-ThreadStatic FLS/pthread_key TLS, socket helpers, cpu_count, eprint.
// 100% pure Zan, zero assembly.

namespace Zan.Runtime.Io;

struct IoBuf16 { public ulong A; public ulong B; }
struct IoBuf32 { public IoBuf16 A; public IoBuf16 B; }
struct IoBuf48 { public IoBuf32 A; public IoBuf16 B; }
struct IoBuf64 { public IoBuf32 A; public IoBuf32 B; }
struct IoBuf128 { public IoBuf64 A; public IoBuf64 B; }
struct IoBuf256 { public IoBuf128 A; public IoBuf128 B; }
struct IoBuf512 { public IoBuf256 A; public IoBuf256 B; }
struct IoBuf1024 { public IoBuf512 A; public IoBuf512 B; }
struct IoBuf2048 { public IoBuf1024 A; public IoBuf1024 B; }
struct IoBuf4096 { public IoBuf2048 A; public IoBuf2048 B; }

