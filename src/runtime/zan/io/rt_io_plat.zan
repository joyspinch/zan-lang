    [DllImport("crt", EntryPoint = "zan_timer_set_ready_hook")]
    internal static extern void TimerSetReadyHook(nint hookFn);
#else
    [DllImport("crt", EntryPoint = "zan_co_ready")]
    internal static extern void ExtCoReady(nint frame, nint step);
#endif

    internal static void WakeCo(nint frame, nint step) {
#if ZAN_CO_DRIVER
        IoSched.CoReady(frame, step);
#else
        ExtCoReady(frame, step);
#endif
    }

