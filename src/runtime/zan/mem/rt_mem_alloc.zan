    }

    [Export("__wrap_realloc")]
    [Visibility("hidden")]
    public static nint ExportWrapRealloc(nint p, ulong n) {
        return WrapReallocImpl(p, n);
    }
#endif

    static nint WrapCallocImpl(ulong n, ulong m) {
        ulong total = n * m;
        if (n != 0UL && total / n != m) return (nint)0;
        if (total <= ZAN_MEM_MAX_SMALL) {
            nint p = SmallAlloc((total != 0UL) ? total : 1UL);
            if (p != (nint)0) {
                CMemset(p, 0, total);
                return p;
            }
        }
        return RealCalloc(n, m);
    }

    static nint WrapReallocImpl(nint p, ulong n) {
        if (p == (nint)0) return WrapMallocImpl(n);
        if (n == 0UL) {
            WrapFreeImpl(p);
            return (nint)0;
        }
        if (!OwnsPtr(p)) return RealRealloc(p, n);
        int cls = BlockClass(p);
        if (cls < 0) {
            FatalBlock(1, p);
            return (nint)0;
        }
        if (Atomic.LoadAt<ulong>(CookieAddr(p, cls), MemoryOrder.Acquire) == ComputeCookie(p)) {
            FatalBlock(2, p);
            return (nint)0;
        }
        ulong old = ClassSize(cls);
        if (IsStrCls(cls)) {
            old += ZAN_MEM_STR_SKEW;
            nint np = WrapMallocImpl(n);
            if (np == (nint)0) return (nint)0;
            CMemcpy(np, p, (n < old) ? n : old);
            WrapFreeImpl(p);
            return np;
        }
        if (n <= old) return p;
        nint np2 = WrapMallocImpl(n);
        if (np2 == (nint)0) return (nint)0;
        CMemcpy(np2, p, old);
        WrapFreeImpl(p);
        return np2;
    }

#if MACOS
    // Apple libmalloc zone registration: lets libc free()/realloc()/malloc_size()
    // recognize and route Zan-owned slab pointers back into zan_mem_*.
    static InlineArray<16, nint> s_macZoneIntrospect; // 128B malloc_introspection_t
    static InlineArray<20, nint> s_macZone;           // 160B malloc_zone_t (version 9)
    static int s_macZoneState = 0;                    // 0=uninit, 1=initing, 2=ready

    static ulong MacBlockSize(nint p) {
        if (p == (nint)0 || !OwnsPtr(p)) return 0UL;
        int cls = BlockClass(p);
        if (cls < 0) return 0UL;
        if (Atomic.LoadAt<ulong>(CookieAddr(p, cls), MemoryOrder.Acquire) == ComputeCookie(p)) return 0UL;
        return ClassSize(cls) + (IsStrCls(cls) ? ZAN_MEM_STR_SKEW : 0UL);
    }

    [Export("__zan_zz_size")] [Visibility("hidden")]
    static ulong ZzSize(nint z, nint p) => MacBlockSize(p);

    [Export("__zan_zz_malloc")] [Visibility("hidden")]
    static nint ZzMalloc(nint z, ulong n) => WrapMallocImpl(n);

    [Export("__zan_zz_calloc")] [Visibility("hidden")]
    static nint ZzCalloc(nint z, ulong n, ulong m) => WrapCallocImpl(n, m);

    [Export("__zan_zz_valloc")] [Visibility("hidden")]
    static nint ZzValloc(nint z, ulong n) => MacValloc(n);

    [Export("__zan_zz_free")] [Visibility("hidden")]
    static void ZzFree(nint z, nint p) { WrapFreeImpl(p); }

    [Export("__zan_zz_free_definite")] [Visibility("hidden")]
    static void ZzFreeDefinite(nint z, nint p, ulong n) { WrapFreeImpl(p); }

    [Export("__zan_zz_realloc")] [Visibility("hidden")]
    static nint ZzRealloc(nint z, nint p, ulong n) => WrapReallocImpl(p, n);

    [Export("__zan_zz_memalign")] [Visibility("hidden")]
    static nint ZzMemalign(nint z, ulong align, ulong n) {
        nint p = (nint)0;
        return MacPosixMemalign(NativeMemory.AddressOf(ref p), align, n) == 0 ? p : (nint)0;
    }

    [Export("__zan_zz_destroy")] [Visibility("hidden")]
    static void ZzDestroy(nint z) { }

    [Export("__zan_zz_enumerator")] [Visibility("hidden")]
    static int ZzEnumerator(uint task, nint ctx, uint type, ulong zone, nint reader, nint recorder) => 0;

    [Export("__zan_zz_good_size")] [Visibility("hidden")]
    static ulong ZzGoodSize(nint z, ulong n) {
        if (n == 0UL) n = 1UL;
        if (n > ZAN_MEM_MAX_SMALL) return n;
        if (Atomic.Load(ref s_classReady, MemoryOrder.Acquire) == 0) EnsureClasses();
        int cls = (int)NativeMemory.At<byte>(NativeMemory.AddressOf(ref s_sizeClass), (long)n);
        return ClassSize(cls);
    }

    [Export("__zan_zz_check")] [Visibility("hidden")]
    static int ZzCheck(nint z) => 1;

    [Export("__zan_zz_print")] [Visibility("hidden")]
    static void ZzPrint(nint z, int verbose) { }

    [Export("__zan_zz_log")] [Visibility("hidden")]
    static void ZzLog(nint z, nint addr) { }

    [Export("__zan_zz_force_lock")] [Visibility("hidden")]
    static void ZzForceLock(nint z) { MemLock(); }

    [Export("__zan_zz_force_unlock")] [Visibility("hidden")]
    static void ZzForceUnlock(nint z) { MemUnlock(); }

    [Export("__zan_zz_reinit_lock")] [Visibility("hidden")]
    static void ZzReinitLock(nint z) { Atomic.Store(ref s_slabLock, 0, MemoryOrder.Release); }

    [Export("__zan_zz_statistics")] [Visibility("hidden")]
    static void ZzStatistics(nint z, nint stPtr) {
        if (stPtr == (nint)0) return;
        CMemset(stPtr, 0, 32UL);
        ulong slabs = Atomic.Load(ref s_slabCount, MemoryOrder.Relaxed);
        NativeMemory.AsRef<ulong>(stPtr + (nint)24) = slabs * ZAN_MEM_SLAB;
    }

    [Export("__zan_zz_locked")] [Visibility("hidden")]
    static int ZzLocked(nint z) => Atomic.Load(ref s_slabLock, MemoryOrder.Relaxed) != 0 ? 1 : 0;

    static void MacZoneRegister() {
        int st = Atomic.Load(ref s_macZoneState, MemoryOrder.Acquire);
        if (st == 2) return;
        if (st == 0 && Atomic.CompareExchangeBool(ref s_macZoneState, 0, 1, MemoryOrder.AcqRel, MemoryOrder.Acquire)) {
            nint ip = NativeMemory.AddressOf(ref s_macZoneIntrospect);
            CMemset(ip, 0, 128UL);
            NativeMemory.AsRef<nint>(ip + (nint)0) = NativeMemory.FunctionPointer(ZzEnumerator);
            NativeMemory.AsRef<nint>(ip + (nint)8) = NativeMemory.FunctionPointer(ZzGoodSize);
            NativeMemory.AsRef<nint>(ip + (nint)16) = NativeMemory.FunctionPointer(ZzCheck);
            NativeMemory.AsRef<nint>(ip + (nint)24) = NativeMemory.FunctionPointer(ZzPrint);
            NativeMemory.AsRef<nint>(ip + (nint)32) = NativeMemory.FunctionPointer(ZzLog);
            NativeMemory.AsRef<nint>(ip + (nint)40) = NativeMemory.FunctionPointer(ZzForceLock);
            NativeMemory.AsRef<nint>(ip + (nint)48) = NativeMemory.FunctionPointer(ZzForceUnlock);
            NativeMemory.AsRef<nint>(ip + (nint)56) = NativeMemory.FunctionPointer(ZzStatistics);
            NativeMemory.AsRef<nint>(ip + (nint)64) = NativeMemory.FunctionPointer(ZzLocked);
            NativeMemory.AsRef<nint>(ip + (nint)104) = NativeMemory.FunctionPointer(ZzReinitLock);

            nint zp = NativeMemory.AddressOf(ref s_macZone);
            CMemset(zp, 0, 160UL);
            NativeMemory.AsRef<nint>(zp + (nint)16) = NativeMemory.FunctionPointer(ZzSize);
            NativeMemory.AsRef<nint>(zp + (nint)24) = NativeMemory.FunctionPointer(ZzMalloc);
            NativeMemory.AsRef<nint>(zp + (nint)32) = NativeMemory.FunctionPointer(ZzCalloc);
            NativeMemory.AsRef<nint>(zp + (nint)40) = NativeMemory.FunctionPointer(ZzValloc);
            NativeMemory.AsRef<nint>(zp + (nint)48) = NativeMemory.FunctionPointer(ZzFree);
            NativeMemory.AsRef<nint>(zp + (nint)56) = NativeMemory.FunctionPointer(ZzRealloc);
            NativeMemory.AsRef<nint>(zp + (nint)64) = NativeMemory.FunctionPointer(ZzDestroy);
            NativeMemory.AsRef<nint>(zp + (nint)72) = (nint)"zan_mem";
            NativeMemory.AsRef<nint>(zp + (nint)96) = ip;
            NativeMemory.AsRef<uint>(zp + (nint)104) = 9U;
            NativeMemory.AsRef<nint>(zp + (nint)112) = NativeMemory.FunctionPointer(ZzMemalign);
            NativeMemory.AsRef<nint>(zp + (nint)120) = NativeMemory.FunctionPointer(ZzFreeDefinite);

            MacMallocZoneRegister(zp);
            Atomic.Store(ref s_macZoneState, 2, MemoryOrder.Release);
            return;
        }
        while (Atomic.Load(ref s_macZoneState, MemoryOrder.Acquire) == 1) {
            Atomic.Pause();
        }
    }
#endif

