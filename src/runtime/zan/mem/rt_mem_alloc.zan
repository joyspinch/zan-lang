    [Export("zan_mem_str_malloc")]
    [Visibility("hidden")]
    public static nint ExportStrMalloc(ulong n) {
        if (n <= ZAN_MEM_STR_MAX) {
            if (Atomic.Load(ref s_classReady, MemoryOrder.Acquire) == 0) EnsureClasses();
            ulong k = (n <= ZAN_MEM_STR_MIN) ? ZAN_MEM_STR_MIN : ((n + 7UL) & ~7UL);
            nint p = SmallCls(ZAN_MEM_STR_CLS0 + (int)((k - ZAN_MEM_STR_MIN) / 8UL));
            if (p != (nint)0) return p;
        }
        return WrapMallocImpl(n + ZAN_MEM_STR_SKEW);
    }

    [Export("zan_mem_obj_malloc")]
    [Visibility("hidden")]
    public static nint ExportObjMalloc(ulong n) {
        if (n <= ZAN_MEM_OBJ_MAX && (n & 15UL) == 8UL) {
            if (Atomic.Load(ref s_classReady, MemoryOrder.Acquire) == 0) EnsureClasses();
            nint p = SmallCls(ZAN_MEM_OBJ_CLS0 + (int)(n >> 4) - 1);
            if (p != (nint)0) return p;
        }
        return WrapMallocImpl(n);
    }

#if MACOS
    [Export("zan_mem_free")]
    [Visibility("hidden")]
    public static void ExportWrapFree(nint p) {
        WrapFreeImpl(p);
    }

    [Export("zan_mem_calloc")]
    [Visibility("hidden")]
