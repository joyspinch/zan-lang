    [DllImport("crt", EntryPoint = "fread")]
    static extern long CFread(nint ptr, long size, long nmemb, nint stream);

    [DllImport("crt", EntryPoint = "fwrite")]
    static extern long CFwrite(nint ptr, long size, long nmemb, nint stream);

    [DllImport("crt", EntryPoint = "fflush")]
