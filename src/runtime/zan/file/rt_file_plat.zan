#else
    const long PLAT_LOCK_INVALID = -1L;

    [DllImport("crt", EntryPoint = "pthread_key_create")]
    static extern int PosixKeyCreate(nint keyPtr, nint dtor);

#if MACOS
    [DllImport("crt", EntryPoint = "pthread_getspecific")]
