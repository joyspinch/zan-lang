    [DllImport("kernel32", EntryPoint = "GetFileType")]
    static extern uint WinGetFileType(nint handle);

    [DllImport("kernel32", EntryPoint = "GetFileInformationByHandle")]
    static extern int WinGetFileInformationByHandle(nint handle, nint infoPtr);

    [DllImport("kernel32", EntryPoint = "FlushFileBuffers")]
    static extern int WinFlushFileBuffers(nint handle);

    [DllImport("kernel32", EntryPoint = "GetFileAttributesExW")]
    static extern int WinGetFileAttributesExW(nint fileName, int infoLevelId, nint infoPtr);

    [DllImport("kernel32", EntryPoint = "GetFileAttributesW")]
    static extern uint WinGetFileAttributesW(nint fileName);

    [DllImport("kernel32", EntryPoint = "SetFileAttributesW")]
    static extern int WinSetFileAttributesW(nint fileName, uint attrs);

    [DllImport("kernel32", EntryPoint = "SetFileTime")]
