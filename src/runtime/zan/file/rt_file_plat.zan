    [DllImport("crt", EntryPoint = "write")]
    static extern long CWriteFd(int fd, nint buf, long count);

#if MACOS
    [DllImport("crt", EntryPoint = "_NSGetExecutablePath")]
    static extern int MacGetExecutablePath(nint buf, nint bufSizePtr);
#elif LINUX
    [DllImport("crt", EntryPoint = "readlink")]
    static extern long CReadlink(nint path, nint buf, long cap);
#endif
