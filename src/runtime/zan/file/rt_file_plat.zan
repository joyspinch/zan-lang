using System;
using System.Threading;

// Pure-Zan file metadata, stream-handle table, and cross-process file lock runtime.
// Replaces target zanrt_file.obj (src/runtime/rt_file.c + file/rt_file_win.c + file/rt_file_posix.c).
// Compiled directly by `zanc -c -O2 --no-runtime-checks` into zanrt_file.obj/.o.

struct PathBuf4096 {
    public InlineArray<4096, byte> Data;
}

struct FileHandleSlot {
    public nint Fp;
    public uint Gen;
    public int Open;
    public int InUse;
    public nint Dying;
}

struct FileLockSlot {
    public long LockVal;
    public int Used;
    public uint Gen;
}

struct FileLockTable32 {
    public InlineArray<32, FileLockSlot> Slots;
}

#if WINDOWS
struct WinFileTime {
    public uint LowDateTime;
    public uint HighDateTime;
}

struct Win32FileAttributeData {
    public uint FileAttributes;
    public WinFileTime CreationTime;
    public WinFileTime LastAccessTime;
    public WinFileTime LastWriteTime;
    public uint FileSizeHigh;
    public uint FileSizeLow;
}

struct WinByHandleFileInfo {
    public uint FileAttributes;
    public WinFileTime CreationTime;
    public WinFileTime LastAccessTime;
    public WinFileTime LastWriteTime;
    public uint VolumeSerialNumber;
    public uint FileSizeHigh;
    public uint FileSizeLow;
    public uint NumberOfLinks;
    public uint FileIndexHigh;
    public uint FileIndexLow;
}
#else
struct PosixStatBuf {
    public InlineArray<144, byte> Data;
}

struct PosixTimespec2 {
    public long Sec0;
    public long Nsec0;
    public long Sec1;
    public long Nsec1;
}
#endif

partial class ZanFileRuntime {
