    const uint CP_UTF8 = 65001U;
    const uint MB_ERR_INVALID_CHARS = 8U;
    const uint GENERIC_WRITE = 0x40000000U;
    const uint FILE_WRITE_ATTRIBUTES = 0x0100U;
    const uint FILE_SHARE_READ = 1U;
    const uint FILE_SHARE_WRITE = 2U;
    const uint FILE_SHARE_DELETE = 4U;
    const uint OPEN_EXISTING = 3U;
    const uint OPEN_ALWAYS = 4U;
    const uint FILE_ATTRIBUTE_READONLY = 0x1U;
    const uint FILE_ATTRIBUTE_HIDDEN = 0x2U;
    const uint FILE_ATTRIBUTE_DIRECTORY = 0x10U;
    const uint FILE_ATTRIBUTE_NORMAL = 0x80U;
    const uint FILE_ATTRIBUTE_REPARSE_POINT = 0x400U;
    const uint FILE_FLAG_BACKUP_SEMANTICS = 0x02000000U;
    const uint FILE_FLAG_OPEN_REPARSE_POINT = 0x00200000U;
    const uint INVALID_FILE_ATTRIBUTES = 0xFFFFFFFFU;
    const uint FILE_TYPE_DISK = 1U;
    const uint MOVEFILE_REPLACE_EXISTING = 1U;
    const uint STD_ERROR_HANDLE = 0xFFFFFFF4U;
    const long PLAT_LOCK_INVALID = 0L;

