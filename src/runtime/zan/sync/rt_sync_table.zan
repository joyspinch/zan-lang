// rt_sync_table.zan: Cross-process shared-memory table core, CAS spinlock with
// dead-PID recovery, min-expiry heap, slot probing, lifecycle, edit_ints, and
// rate/lease policy entry points.
// Replaces rt_sync_table.c, rt_sync_table_life.c, and rt_sync_table_compat.c in 100% pure Zan.

namespace Zan.Runtime.Sync;

static class ShmTblOff {
    internal const ulong MAGIC = 0x5A414E54424C3031UL;
    internal const uint VERSION = 5U;
    internal const uint MAX_COLUMNS = 64U;
    internal const ulong COLUMN_NAME = 32UL;
    internal const uint MAX_KEY = 1024U;
    internal const uint MAX_STRING = 1048576U;
    internal const ulong MAX_CAPACITY = 1UL << 30;
    internal const uint COL_INT = 1U;
    internal const uint COL_STRING = 2U;
    internal const uint COL_FLOAT = 3U;
    internal const uint SLOT_EMPTY = 0U;
    internal const uint SLOT_USED = 1U;
    internal const uint SLOT_TOMBSTONE = 2U;
    internal const ulong SLOT_PREFIX = 32UL;
    internal const ulong SHARED_STRING_PAD = 32UL;
    internal const ulong PURGE_MAX_BATCH = 64UL;
    internal const long PURGE_MIN_INTERVAL_MS = 16L;

    internal const uint LOCK_HELD_BIT = 0x80000000U;
    internal const uint LOCK_PID_MASK = 0x7FFFFFFFU;

    // zan_shared_column (48 bytes)
    internal const long COL_SIZE = 48L;
    internal const long COL_TYPE = 0L;
    internal const long COL_LEN = 4L;
    internal const long COL_OFFSET = 8L;
    internal const long COL_NAME = 16L;

    // zan_shared_header (64 + 64*48 = 3136 bytes, already 8-byte aligned)
    internal const ulong HDR_SIZE = 3136UL;
    internal const long H_MAGIC = 0L;
    internal const long H_VERSION = 8L;
    internal const long H_READY = 12L;
    internal const long H_TOTAL_SIZE = 16L;
    internal const long H_CAPACITY = 24L;
    internal const long H_COUNT = 32L;
    internal const long H_EXPIRY_COUNT = 40L;
    internal const long H_KEY_SIZE = 48L;
    internal const long H_ROW_STRIDE = 52L;
    internal const long H_COLUMN_COUNT = 56L;
    internal const long H_STRUCT_LOCK = 60L;
    internal const long H_COLUMNS = 64L;

    // zan_shared_table handle struct (3472 bytes):
    //   0: nint Header
    //   8: Header Snap (3136 bytes -> 8..3143)
    // 3144: ulong MappedSize
    // 3152: char MapName[256] (3152..3407)
    // 3408: int Anonymous
    // 3412: int Attached
    // 3416: Win64: nint Mapping | POSIX: int Fd @ 3416, int LocalMutexReady @ 3420, pthread_mutex_t @ 3424 (up to 64B on macOS)
    internal const ulong TBL_SIZE = 3488UL;
    internal const long T_HEADER = 0L;
    internal const long T_SNAP = 8L;
    internal const long T_MAPPED_SIZE = 3144L;
    internal const long T_MAP_NAME = 3152L;
    internal const long T_ANONYMOUS = 3408L;
    internal const long T_ATTACHED = 3412L;
    internal const long T_MAPPING = 3416L;
    internal const long T_FD = 3416L;
    internal const long T_LOCAL_MX_READY = 3420L;
    internal const long T_LOCAL_MX = 3424L;

    // Row prefix offsets:
    //  0: uint State
    //  4: uint LockWord
    //  8: ulong Hash
    // 16: long ExpiresAt
    // 24: ulong HeapIndex (1-based; 0 = not in heap)
    // 32: char Key[key_size]
    internal const long R_STATE = 0L;
    internal const long R_LOCK = 4L;
    internal const long R_HASH = 8L;
    internal const long R_EXPIRES = 16L;
    internal const long R_HEAP_IDX = 24L;
    internal const long R_KEY = 32L;

    internal const int STAT_RESERVED = 0;
    internal const int STAT_RESIDENT = 1;
    internal const int STAT_CAPACITY = 2;
    internal const int STAT_COUNT = 3;
    internal const int STAT_ROW_STRIDE = 4;
    internal const int STAT_KEY_SIZE = 5;
    internal const int STAT_COLUMNS = 6;

    internal const int EDIT_KEEP = 0;
    internal const int EDIT_WRITE = 1;
    internal const int EDIT_DELETE = 2;
}

static partial class RtSyncTable {
    // ---- Per-thread 1 MiB shared-string buffer with 32-byte zero prefix ----
    static int s_strKeyState = 0; // 0 none, 1 creating, 2 ready, 3 failed
#if WINDOWS
    static uint s_strFls = 0xFFFFFFFFU;
#elif MACOS
    static ulong s_strKey = 0UL;
#else
    static uint s_strKey = 0U;
#endif
    static long s_lastPurgeAttemptMs = 0L;
#if WINDOWS
    static nint s_queryWsExFn = (nint)0;
    static int s_queryWsExResolved = 0;
#else
    static uint s_anonSeq = 0U;
#endif

    [Export("__zan_sync_shared_str_dtor")]
    [Visibility("hidden")]
    static void SharedStringDtor(nint buf) {
        if (buf != (nint)0) SyncPlat.CFree(buf);
    }

    static void EnsureSharedStringKey() {
        int st = Atomic.Load(ref s_strKeyState, MemoryOrder.Acquire);
        if (st == 2) return;
        if (st == 3) SyncPlat.RtFatal((nint)"oom", (nint)"sync: shared-string TLS init failed");
        if (Atomic.CompareExchange(ref s_strKeyState, 0, 1, MemoryOrder.AcqRel, MemoryOrder.Acquire) == 0) {
#if WINDOWS
            s_strFls = SyncPlat.WinFlsAlloc(NativeMemory.FunctionPointer(SharedStringDtor));
            bool ok = s_strFls != SyncPlat.FLS_OUT_OF_INDEXES;
#else
            bool ok = SyncPlat.PosixKeyCreate(NativeMemory.AddressOf(ref s_strKey),
                                              NativeMemory.FunctionPointer(SharedStringDtor)) == 0;
#endif
            Atomic.Store(ref s_strKeyState, ok ? 2 : 3, MemoryOrder.Release);
            if (!ok) SyncPlat.RtFatal((nint)"oom", (nint)"sync: shared-string TLS init failed");
        } else {
            while (Atomic.Load(ref s_strKeyState, MemoryOrder.Acquire) == 1) {
                SyncPlat.OsYield();
            }
            if (Atomic.Load(ref s_strKeyState, MemoryOrder.Acquire) != 2) {
                SyncPlat.RtFatal((nint)"oom", (nint)"sync: shared-string TLS init failed");
            }
        }
    }

    internal static nint GetSharedStringBuf() {
        EnsureSharedStringKey();
#if WINDOWS
        nint buf = SyncPlat.WinFlsGetValue(s_strFls);
        if (buf == (nint)0) {
            buf = SyncPlat.CCalloc(ShmTblOff.SHARED_STRING_PAD + (ulong)ShmTblOff.MAX_STRING + 1UL, 1UL);
            if (buf == (nint)0) SyncPlat.RtFatal((nint)"oom", (nint)"sync: shared-string buffer");
            if (SyncPlat.WinFlsSetValue(s_strFls, buf) == 0) {
                SyncPlat.CFree(buf);
                SyncPlat.RtFatal((nint)"oom", (nint)"sync: shared-string TLS set failed");
            }
        }
        return buf + (nint)ShmTblOff.SHARED_STRING_PAD;
#else
        nint buf = SyncPlat.PosixGetSpecific(s_strKey);
        if (buf == (nint)0) {
            buf = SyncPlat.CCalloc(ShmTblOff.SHARED_STRING_PAD + (ulong)ShmTblOff.MAX_STRING + 1UL, 1UL);
            if (buf == (nint)0) SyncPlat.RtFatal((nint)"oom", (nint)"sync: shared-string buffer");
            if (SyncPlat.PosixSetSpecific(s_strKey, buf) != 0) {
                SyncPlat.CFree(buf);
                SyncPlat.RtFatal((nint)"oom", (nint)"sync: shared-string TLS set failed");
            }
        }
        return buf + (nint)ShmTblOff.SHARED_STRING_PAD;
#endif
    }

    // ---- Helpers ----

    internal static ulong Align8(ulong v) { return (v + 7UL) & ~7UL; }

    internal static ulong HashBytes(nint value) {
        ulong hash = 1469598103934665603UL;
        if (value != (nint)0) {
            long i = 0L;
            while (true) {
                byte b = NativeMemory.At<byte>(value, i);
                if (b == (byte)0) break;
                hash ^= (ulong)b;
                hash *= 1099511628211UL;
                i++;
            }
        }
        return hash != 0UL ? hash : 1UL;
    }

    static ulong RoundCapacity(ulong cap) {
        ulong r = 1UL;
        while (r < cap && r < ShmTblOff.MAX_CAPACITY) r <<= 1;
        return r;
    }

    static bool ColumnNameValid(nint name, ulong len) {
        if (len == 0UL || len >= ShmTblOff.COLUMN_NAME) return false;
        for (ulong i = 0UL; i < len; i++) {
            byte ch = NativeMemory.At<byte>(name, (long)i);
            bool ok = (ch >= (byte)97 && ch <= (byte)122) ||
                      (ch >= (byte)65 && ch <= (byte)90) ||
                      (ch >= (byte)48 && ch <= (byte)57) ||
                      ch == (byte)95;
            if (!ok) return false;
        }
        return true;
    }

    static bool ParseSchema(nint schema, uint keySize, nint colsOut, out uint colCountOut, out uint rowStrideOut) {
        colCountOut = 0U;
        rowStrideOut = 0U;
        if (schema == (nint)0 || NativeMemory.Read<byte>(schema) == (byte)0) return false;
        nint p = schema;
        uint count = 0U;
        ulong offset = Align8(ShmTblOff.SLOT_PREFIX + (ulong)keySize);

        while (NativeMemory.Read<byte>(p) != (byte)0) {
            if (count >= ShmTblOff.MAX_COLUMNS) return false;
            byte tag = NativeMemory.Read<byte>(p);
            uint colType = 0U;
            uint colSize = 0U;
            if (tag == (byte)105) { // 'i'
                colType = ShmTblOff.COL_INT;
                colSize = 8U;
                p = p + (nint)1;
                if (NativeMemory.Read<byte>(p) != (byte)58) return false; // ':'
                p = p + (nint)1;
            } else if (tag == (byte)102) { // 'f'
                colType = ShmTblOff.COL_FLOAT;
                colSize = 8U;
                p = p + (nint)1;
                if (NativeMemory.Read<byte>(p) != (byte)58) return false;
                p = p + (nint)1;
            } else if (tag == (byte)115) { // 's'
                colType = ShmTblOff.COL_STRING;
                p = p + (nint)1;
                if (NativeMemory.Read<byte>(p) != (byte)58) return false;
                p = p + (nint)1;
                nint endPtr = (nint)0;
                ulong parsed = SyncPlat.CStrToUL(p, NativeMemory.AddressOf(ref endPtr), 10);
                if (endPtr == p || endPtr == (nint)0 || NativeMemory.Read<byte>(endPtr) != (byte)58 ||
                    parsed == 0UL || parsed > (ulong)ShmTblOff.MAX_STRING) {
                    return false;
                }
                colSize = (uint)parsed + 1U;
                p = endPtr + (nint)1;
            } else {
                return false;
            }

            nint nameStart = p;
            while (NativeMemory.Read<byte>(p) != (byte)0 && NativeMemory.Read<byte>(p) != (byte)59) { // ';'
                p = p + (nint)1;
            }
            ulong nameLen = (ulong)((long)p - (long)nameStart);
            if (NativeMemory.Read<byte>(p) != (byte)59 || !ColumnNameValid(nameStart, nameLen)) return false;

            for (uint i = 0U; i < count; i++) {
                nint existing = colsOut + (nint)((long)i * ShmTblOff.COL_SIZE + ShmTblOff.COL_NAME);
                if (SyncPlat.CStrLen(existing) == nameLen && SyncPlat.CMemcmp(existing, nameStart, nameLen) == 0) {
                    return false;
                }
            }

            if (colType == ShmTblOff.COL_INT || colType == ShmTblOff.COL_FLOAT) {
                offset = Align8(offset);
            }
            nint col = colsOut + (nint)((long)count * ShmTblOff.COL_SIZE);
            NativeMemory.Write<uint>(col + (nint)ShmTblOff.COL_TYPE, colType);
            NativeMemory.Write<uint>(col + (nint)ShmTblOff.COL_LEN, colSize);
            NativeMemory.Write<uint>(col + (nint)ShmTblOff.COL_OFFSET, (uint)offset);
            NativeMemory.Write<uint>(col + (nint)12, 0U);
            SyncPlat.CMemcpy(col + (nint)ShmTblOff.COL_NAME, nameStart, nameLen);
            NativeMemory.At<byte>(col + (nint)ShmTblOff.COL_NAME, (long)nameLen) = (byte)0;
            offset += (ulong)colSize;
            count++;
            p = p + (nint)1;
        }

        offset = Align8(offset);
        if (offset > 0xFFFFFFFFUL) return false;
        colCountOut = count;
        rowStrideOut = (uint)offset;
        return count > 0U;
    }

    static void MakeNames(nint name, nint mapNameBuf) {
        ulong hash = HashBytes(name);
#if WINDOWS
        ulong pos = SyncPlat.BufAppendCStr(mapNameBuf, 256UL, 0UL, (nint)"Local\\zan_table_");
        SyncPlat.BufAppendHex16Lower(mapNameBuf, 256UL, pos, hash);
#else
        ulong pos = SyncPlat.BufAppendCStr(mapNameBuf, 256UL, 0UL, (nint)"/tmp/zan_table_");
        pos = SyncPlat.BufAppendU64(mapNameBuf, 256UL, pos, (ulong)SyncPlat.PosixGetuid());
        pos = SyncPlat.BufAppendChar(mapNameBuf, 256UL, pos, (byte)95); // '_'
        pos = SyncPlat.BufAppendHex16Lower(mapNameBuf, 256UL, pos, hash);
        SyncPlat.BufAppendCStr(mapNameBuf, 256UL, pos, (nint)".shm");
#endif
    }

    // ---- CAS spinlock with dead-PID recovery ----

    static bool PidAlive(uint pid) {
        if (pid == 0U) return false;
#if WINDOWS
        nint h = SyncPlat.WinOpenProcess(SyncPlat.PROCESS_QUERY_LIMITED_INFORMATION | SyncPlat.SYNCHRONIZE, 0, pid);
        if (h == (nint)0) return SyncPlat.WinGetLastError() == SyncPlat.ERROR_ACCESS_DENIED;
        bool alive = SyncPlat.WinWaitForSingleObject(h, 0U) != SyncPlat.WAIT_OBJECT_0;
        SyncPlat.WinCloseHandle(h);
        return alive;
#else
        return SyncPlat.PosixKill((int)pid, 0) == 0 || SyncPlat.GetErrno() == SyncPlat.EPERM;
#endif
    }

    internal static void LockWordAcquire(nint wordPtr) {
#if WINDOWS
        uint myPid = SyncPlat.WinGetCurrentProcessId();
#else
        uint myPid = (uint)SyncPlat.PosixGetpid();
#endif
        uint mine = ShmTblOff.LOCK_HELD_BIT | (myPid & ShmTblOff.LOCK_PID_MASK);
        uint spin = 0U;
        while (true) {
            if (Atomic.CompareExchangeAt<uint>(wordPtr, 0U, mine, MemoryOrder.Acquire, MemoryOrder.Relaxed) == 0U) {
                return;
            }
            if (spin < 64U) {
                // short spin
            } else if (spin < 4096U || (spin & 1023U) != 0U) {
                SyncPlat.OsYield();
            } else {
                uint held = Atomic.LoadAt<uint>(wordPtr, MemoryOrder.Relaxed);
                uint hpid = held & ShmTblOff.LOCK_PID_MASK;
                if ((held & ShmTblOff.LOCK_HELD_BIT) != 0U && hpid != 0U && !PidAlive(hpid)) {
                    uint now = Atomic.LoadAt<uint>(wordPtr, MemoryOrder.Acquire);
                    if (now == held && !PidAlive(hpid)) {
                        Atomic.CompareExchangeAt<uint>(wordPtr, held, 0U, MemoryOrder.Release, MemoryOrder.Relaxed);
                    }
                }
                SyncPlat.OsYield();
            }
            spin++;
        }
    }

    internal static void LockWordRelease(nint wordPtr) {
        Atomic.StoreAt<uint>(wordPtr, 0U, MemoryOrder.Release);
    }

    internal static void StructLock(nint header) { LockWordAcquire(header + (nint)ShmTblOff.H_STRUCT_LOCK); }
    internal static void StructUnlock(nint header) { LockWordRelease(header + (nint)ShmTblOff.H_STRUCT_LOCK); }
    internal static void RowLock(nint row) { LockWordAcquire(row + (nint)ShmTblOff.R_LOCK); }
    internal static void RowUnlock(nint row) { LockWordRelease(row + (nint)ShmTblOff.R_LOCK); }

    internal static uint LoadState(nint row) { return Atomic.LoadAt<uint>(row + (nint)ShmTblOff.R_STATE, MemoryOrder.Acquire); }
    internal static void PublishState(nint row, uint st) { Atomic.StoreAt<uint>(row + (nint)ShmTblOff.R_STATE, st, MemoryOrder.Release); }

    internal static nint FindColumn(nint table, nint colName, uint colType) {
        if (table == (nint)0 || colName == (nint)0) return (nint)0;
        nint snap = table + (nint)ShmTblOff.T_SNAP;
        uint cnt = NativeMemory.Read<uint>(snap + (nint)ShmTblOff.H_COLUMN_COUNT);
        nint cols = snap + (nint)ShmTblOff.H_COLUMNS;
        for (uint i = 0U; i < cnt; i++) {
            nint col = cols + (nint)((long)i * ShmTblOff.COL_SIZE);
            if (NativeMemory.Read<uint>(col + (nint)ShmTblOff.COL_TYPE) == colType &&
                SyncPlat.CStrCmp(col + (nint)ShmTblOff.COL_NAME, colName) == 0) {
                return col;
            }
        }
        return (nint)0;
    }

    internal static nint RowAt(nint header, ulong index) {
        ulong stride = (ulong)NativeMemory.Read<uint>(header + (nint)ShmTblOff.H_ROW_STRIDE);
        return header + (nint)(ShmTblOff.HDR_SIZE + index * stride);
    }

    static ulong RowSlot(nint header, nint row) {
        ulong stride = (ulong)NativeMemory.Read<uint>(header + (nint)ShmTblOff.H_ROW_STRIDE);
        if (stride == 0UL) return 0UL;
        ulong off = (ulong)((long)row - (long)(header + (nint)ShmTblOff.HDR_SIZE));
        return off / stride;
    }

    static nint ExpiryHeap(nint header) {
        ulong cap = NativeMemory.Read<ulong>(header + (nint)ShmTblOff.H_CAPACITY);
        ulong stride = (ulong)NativeMemory.Read<uint>(header + (nint)ShmTblOff.H_ROW_STRIDE);
        return header + (nint)(ShmTblOff.HDR_SIZE + cap * stride);
    }

    internal static bool RowRevalidate(nint row, ulong hash, nint key, uint keySize) {
        if (LoadState(row) != ShmTblOff.SLOT_USED) return false;
        if (NativeMemory.Read<ulong>(row + (nint)ShmTblOff.R_HASH) != hash) return false;
        if (key != (nint)0 && SyncPlat.CStrNCmp(row + (nint)ShmTblOff.R_KEY, key, (ulong)keySize) != 0) return false;
        return true;
    }

    // ---- Min-expiry heap ----

    static void ExpirySwap(nint header, ulong a, ulong b) {
        nint heap = ExpiryHeap(header);
        ulong slotA = NativeMemory.At<ulong>(heap, (long)a);
        ulong slotB = NativeMemory.At<ulong>(heap, (long)b);
        NativeMemory.At<ulong>(heap, (long)a) = slotB;
        NativeMemory.At<ulong>(heap, (long)b) = slotA;
        NativeMemory.Write<ulong>(RowAt(header, slotB) + (nint)ShmTblOff.R_HEAP_IDX, a + 1UL);
        NativeMemory.Write<ulong>(RowAt(header, slotA) + (nint)ShmTblOff.R_HEAP_IDX, b + 1UL);
    }

    static void ExpiryUp(nint header, ulong index) {
        nint heap = ExpiryHeap(header);
        while (index > 0UL) {
            ulong parent = (index - 1UL) / 2UL;
            long exp = NativeMemory.Read<long>(RowAt(header, NativeMemory.At<ulong>(heap, (long)index)) + (nint)ShmTblOff.R_EXPIRES);
            long pexp = NativeMemory.Read<long>(RowAt(header, NativeMemory.At<ulong>(heap, (long)parent)) + (nint)ShmTblOff.R_EXPIRES);
            if (exp >= pexp) break;
            ExpirySwap(header, index, parent);
            index = parent;
        }
    }

    static void ExpiryDown(nint header, ulong index) {
        nint heap = ExpiryHeap(header);
        ulong expCnt = NativeMemory.Read<ulong>(header + (nint)ShmTblOff.H_EXPIRY_COUNT);
        while (true) {
            ulong left = index * 2UL + 1UL;
            if (left >= expCnt) break;
            ulong right = left + 1UL;
            ulong smallest = left;
            long leftExp = NativeMemory.Read<long>(RowAt(header, NativeMemory.At<ulong>(heap, (long)left)) + (nint)ShmTblOff.R_EXPIRES);
            long smallExp = leftExp;
            if (right < expCnt) {
                long rightExp = NativeMemory.Read<long>(RowAt(header, NativeMemory.At<ulong>(heap, (long)right)) + (nint)ShmTblOff.R_EXPIRES);
                if (rightExp < leftExp) {
                    smallest = right;
                    smallExp = rightExp;
                }
            }
            long curExp = NativeMemory.Read<long>(RowAt(header, NativeMemory.At<ulong>(heap, (long)index)) + (nint)ShmTblOff.R_EXPIRES);
            if (curExp <= smallExp) break;
            ExpirySwap(header, index, smallest);
            index = smallest;
        }
    }

    static void ExpiryRemove(nint header, nint row) {
        ulong encoded = NativeMemory.Read<ulong>(row + (nint)ShmTblOff.R_HEAP_IDX);
        ulong expCnt = NativeMemory.Read<ulong>(header + (nint)ShmTblOff.H_EXPIRY_COUNT);
        if (encoded == 0UL || encoded > expCnt) return;
        ulong index = encoded - 1UL;
        nint heap = ExpiryHeap(header);
        ulong last = expCnt - 1UL;
        NativeMemory.Write<ulong>(header + (nint)ShmTblOff.H_EXPIRY_COUNT, last);
        NativeMemory.Write<ulong>(row + (nint)ShmTblOff.R_HEAP_IDX, 0UL);
        NativeMemory.Write<long>(row + (nint)ShmTblOff.R_EXPIRES, 0L);
        if (index == last) return;
        ulong movedSlot = NativeMemory.At<ulong>(heap, (long)last);
        NativeMemory.At<ulong>(heap, (long)index) = movedSlot;
        NativeMemory.Write<ulong>(RowAt(header, movedSlot) + (nint)ShmTblOff.R_HEAP_IDX, index + 1UL);
        if (index > 0UL &&
            NativeMemory.Read<long>(RowAt(header, movedSlot) + (nint)ShmTblOff.R_EXPIRES) <
            NativeMemory.Read<long>(RowAt(header, NativeMemory.At<ulong>(heap, (long)((index - 1UL) / 2UL))) + (nint)ShmTblOff.R_EXPIRES)) {
            ExpiryUp(header, index);
        } else {
            ExpiryDown(header, index);
        }
    }

    static void ExpirySet(nint header, ulong slot, nint row, long expiresAt) {
        ulong encoded = NativeMemory.Read<ulong>(row + (nint)ShmTblOff.R_HEAP_IDX);
        NativeMemory.Write<long>(row + (nint)ShmTblOff.R_EXPIRES, expiresAt);
        if (expiresAt <= 0L) {
            if (encoded != 0UL) ExpiryRemove(header, row);
            return;
        }
        if (encoded == 0UL) {
            ulong index = NativeMemory.Read<ulong>(header + (nint)ShmTblOff.H_EXPIRY_COUNT);
            NativeMemory.Write<ulong>(header + (nint)ShmTblOff.H_EXPIRY_COUNT, index + 1UL);
            NativeMemory.At<ulong>(ExpiryHeap(header), (long)index) = slot;
            NativeMemory.Write<ulong>(row + (nint)ShmTblOff.R_HEAP_IDX, index + 1UL);
            ExpiryUp(header, index);
            return;
        }
        ulong idx = encoded - 1UL;
        ExpiryUp(header, idx);
        encoded = NativeMemory.Read<ulong>(row + (nint)ShmTblOff.R_HEAP_IDX);
        ExpiryDown(header, encoded - 1UL);
    }

    internal static void DeleteRowLocked(nint header, nint row) {
        ExpiryRemove(header, row);
        ulong stride = (ulong)NativeMemory.Read<uint>(header + (nint)ShmTblOff.H_ROW_STRIDE);
        SyncPlat.CMemset(row + (nint)8, 0, stride - 8UL);
        PublishState(row, ShmTblOff.SLOT_TOMBSTONE);
        ulong cnt = NativeMemory.Read<ulong>(header + (nint)ShmTblOff.H_COUNT);
        NativeMemory.Write<ulong>(header + (nint)ShmTblOff.H_COUNT, cnt - 1UL);
    }

    internal static void PurgeExpiredLocked(nint header, long nowMs, ulong maxBatch) {
        nint heap = ExpiryHeap(header);
        ulong batch = 0UL;
        while (NativeMemory.Read<ulong>(header + (nint)ShmTblOff.H_EXPIRY_COUNT) > 0UL && batch < maxBatch) {
            nint row = RowAt(header, NativeMemory.At<ulong>(heap, 0L));
            if (NativeMemory.Read<long>(row + (nint)ShmTblOff.R_EXPIRES) > nowMs) break;
            RowLock(row);
            DeleteRowLocked(header, row);
            RowUnlock(row);
            batch++;
        }
    }

    internal static void PurgeExpired(nint header) {
        if (Atomic.LoadAt<ulong>(header + (nint)ShmTblOff.H_EXPIRY_COUNT, MemoryOrder.Relaxed) == 0UL) return;
        long nowMs = SyncPlat.TimeEpochMs();
        long last = Atomic.Load(ref s_lastPurgeAttemptMs, MemoryOrder.Relaxed);
        if (last > nowMs - ShmTblOff.PURGE_MIN_INTERVAL_MS && last <= nowMs) return;
        Atomic.Store(ref s_lastPurgeAttemptMs, nowMs, MemoryOrder.Relaxed);
        nint heap = ExpiryHeap(header);
        ulong top = Atomic.LoadAt<ulong>(heap, MemoryOrder.Relaxed);
        if (top >= NativeMemory.Read<ulong>(header + (nint)ShmTblOff.H_CAPACITY)) return;
        nint row = RowAt(header, top);
        if (NativeMemory.Read<long>(row + (nint)ShmTblOff.R_EXPIRES) > nowMs) return;
        StructLock(header);
        PurgeExpiredLocked(header, nowMs, ShmTblOff.PURGE_MAX_BATCH);
        StructUnlock(header);
    }

    // ---- Slot lookup & publish ----

    static nint FindKeySlot(nint header, nint key, ulong hash, bool insert) {
        ulong cap = NativeMemory.Read<ulong>(header + (nint)ShmTblOff.H_CAPACITY);
        ulong cnt = NativeMemory.Read<ulong>(header + (nint)ShmTblOff.H_COUNT);
        if (insert && cnt >= cap - cap / 8UL) return (nint)0;

        uint keySize = NativeMemory.Read<uint>(header + (nint)ShmTblOff.H_KEY_SIZE);
        nint firstTomb = (nint)0;
        for (ulong probe = 0UL; probe < cap; probe++) {
            ulong index = (hash + probe) & (cap - 1UL);
            nint row = RowAt(header, index);
            uint st = LoadState(row);
            if (st == ShmTblOff.SLOT_USED) {
                if (NativeMemory.Read<ulong>(row + (nint)ShmTblOff.R_HASH) == hash &&
                    SyncPlat.CStrNCmp(row + (nint)ShmTblOff.R_KEY, key, (ulong)keySize) == 0) {
                    return row;
                }
                continue;
            }
            if (st == ShmTblOff.SLOT_TOMBSTONE) {
                if (firstTomb == (nint)0) firstTomb = row;
                continue;
            }
            if (!insert) return (nint)0;
            return firstTomb != (nint)0 ? firstTomb : row;
        }
        return insert ? firstTomb : (nint)0;
    }

    static void PublishKeyRow(nint header, nint row, nint key, ulong keyLen, ulong hash) {
        uint keySize = NativeMemory.Read<uint>(header + (nint)ShmTblOff.H_KEY_SIZE);
        NativeMemory.Write<ulong>(row + (nint)ShmTblOff.R_HASH, hash);
        SyncPlat.CMemcpy(row + (nint)ShmTblOff.R_KEY, key, keyLen);
        if (keyLen < (ulong)keySize) {
            NativeMemory.At<byte>(row + (nint)ShmTblOff.R_KEY, (long)keyLen) = (byte)0;
        }
        PublishState(row, ShmTblOff.SLOT_USED);
        ulong cnt = NativeMemory.Read<ulong>(header + (nint)ShmTblOff.H_COUNT);
        NativeMemory.Write<ulong>(header + (nint)ShmTblOff.H_COUNT, cnt + 1UL);
    }

    static nint FindRow(nint header, nint key, bool create) {
        uint keySize = NativeMemory.Read<uint>(header + (nint)ShmTblOff.H_KEY_SIZE);
        ulong keyLen = SyncPlat.StrNLen(key, (ulong)keySize + 1UL);
        if (keyLen == 0UL || keyLen > (ulong)keySize) return (nint)0;
        ulong hash = HashBytes(key);
        nint row = FindKeySlot(header, key, hash, create);
        if (create && row != (nint)0 && LoadState(row) != ShmTblOff.SLOT_USED) {
            PublishKeyRow(header, row, key, keyLen, hash);
        }
        return row;
    }

    internal static nint RowFor(nint header, nint key, bool create) {
        PurgeExpired(header);
        nint row = FindRow(header, key, false);
        if (row != (nint)0 || !create) return row;
        StructLock(header);
        row = FindRow(header, key, true);
        StructUnlock(header);
        return row;
    }

    internal static nint FindRowHash(nint header, ulong hash, bool create) {
        ulong cap = NativeMemory.Read<ulong>(header + (nint)ShmTblOff.H_CAPACITY);
        ulong cnt = NativeMemory.Read<ulong>(header + (nint)ShmTblOff.H_COUNT);
        if (create && cnt >= cap - cap / 8UL) return (nint)0;
        if (hash == 0UL) hash = 1UL;
        ulong firstTomb = 0xFFFFFFFFFFFFFFFFUL;
        for (ulong probe = 0UL; probe < cap; probe++) {
            ulong index = (hash + probe) & (cap - 1UL);
            nint row = RowAt(header, index);
            uint st = LoadState(row);
            if (st == ShmTblOff.SLOT_USED) {
                if (NativeMemory.Read<ulong>(row + (nint)ShmTblOff.R_HASH) == hash) return row;
                continue;
            }
            if (st == ShmTblOff.SLOT_TOMBSTONE) {
                if (firstTomb == 0xFFFFFFFFFFFFFFFFUL) firstTomb = index;
                continue;
            }
            if (!create) return (nint)0;
            if (firstTomb != 0xFFFFFFFFFFFFFFFFUL) row = RowAt(header, firstTomb);
            NativeMemory.Write<ulong>(row + (nint)ShmTblOff.R_HASH, hash);
            PublishState(row, ShmTblOff.SLOT_USED);
            NativeMemory.Write<ulong>(header + (nint)ShmTblOff.H_COUNT, cnt + 1UL);
            return row;
        }
        if (create && firstTomb != 0xFFFFFFFFFFFFFFFFUL) {
            nint row = RowAt(header, firstTomb);
            NativeMemory.Write<ulong>(row + (nint)ShmTblOff.R_HASH, hash);
            PublishState(row, ShmTblOff.SLOT_USED);
            NativeMemory.Write<ulong>(header + (nint)ShmTblOff.H_COUNT, cnt + 1UL);
            return row;
        }
        return (nint)0;
    }

    internal static nint RowForHash(nint header, ulong hash, bool create) {
        PurgeExpired(header);
        nint row = FindRowHash(header, hash, false);
        if (row != (nint)0 || !create) return row;
        StructLock(header);
        row = FindRowHash(header, hash, true);
        StructUnlock(header);
        return row;
    }

}
