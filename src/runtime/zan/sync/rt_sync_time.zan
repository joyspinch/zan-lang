// rt_sync_time.zan: High-precision monotonic clock & stopwatch primitives.
// Replaces src/runtime/sync/rt_sync_time.c in 100% pure Zan.

namespace Zan.Runtime.Sync;

static class RtSyncTime {
#if WINDOWS
    static long s_qpcFreq = 0L;

    static long QpcFreq() {
        long f = Atomic.Load(ref s_qpcFreq, MemoryOrder.Relaxed);
        if (f == 0L) {
            long lf = 0L;
            SyncPlat.WinQueryPerformanceFrequency(NativeMemory.AddressOf(ref lf));
            f = lf;
            Atomic.Store(ref s_qpcFreq, f, MemoryOrder.Relaxed);
        }
        return f;
    }
#endif

    [Export("zan_monotonic_us")]
    public static long MonotonicUs() {
#if WINDOWS
        long f = QpcFreq();
        long now = 0L;
        SyncPlat.WinQueryPerformanceCounter(NativeMemory.AddressOf(ref now));
        if (f == 10000000L) return now / 10L;
        if (f <= 0L) return 0L;
        return (now / f) * 1000000L + ((now % f) * 1000000L) / f;
#else
        SyncBuf16 ts = new SyncBuf16();
        nint tp = NativeMemory.AddressOf(ref ts);
        SyncPlat.PosixClockGettime(SyncPlat.CLOCK_MONOTONIC, tp);
        long sec = NativeMemory.Read<long>(tp);
        long nsec = NativeMemory.Read<long>(tp + (nint)8);
        return sec * 1000000L + nsec / 1000L;
#endif
    }

    [Export("zan_monotonic_ns")]
    public static long MonotonicNs() {
#if WINDOWS
        long f = QpcFreq();
        long now = 0L;
        SyncPlat.WinQueryPerformanceCounter(NativeMemory.AddressOf(ref now));
        if (f == 10000000L) return now * 100L;
        if (f <= 0L) return 0L;
        return (now / f) * 1000000000L + ((now % f) * 1000000000L) / f;
#else
        SyncBuf16 ts = new SyncBuf16();
        nint tp = NativeMemory.AddressOf(ref ts);
        SyncPlat.PosixClockGettime(SyncPlat.CLOCK_MONOTONIC, tp);
        long sec = NativeMemory.Read<long>(tp);
        long nsec = NativeMemory.Read<long>(tp + (nint)8);
        return sec * 1000000000L + nsec;
#endif
    }

    [Export("zan_stopwatch_ticks")]
    public static long StopwatchTicks() {
#if WINDOWS
        long now = 0L;
        SyncPlat.WinQueryPerformanceCounter(NativeMemory.AddressOf(ref now));
        return now;
#else
        return MonotonicNs();
#endif
    }

    [Export("zan_stopwatch_frequency")]
    public static long StopwatchFrequency() {
#if WINDOWS
        return QpcFreq();
#else
        return 1000000000L;
#endif
    }

    [Export("zan_monotonic_ticks")]
    public static long MonotonicTicks() {
        return StopwatchTicks();
    }

    [Export("zan_monotonic_frequency")]
    public static long MonotonicFrequency() {
        return StopwatchFrequency();
    }
}
