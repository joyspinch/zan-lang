    [Export("zan_shared_table_get_float")]
    public static double GetFloat(long handle, nint key, nint colName) {
        nint table = (nint)handle;
        if (table == (nint)0) return 0.0;
        nint col = RtSyncTable.FindColumn(table, colName, ShmTblOff.COL_FLOAT);
        nint hdr = NativeMemory.Read<nint>(table + (nint)ShmTblOff.T_HEADER);
        nint row = col != (nint)0 ? RtSyncTable.RowFor(hdr, key, false) : (nint)0;
        if (row == (nint)0) return 0.0;
        RtSyncTable.RowLock(row);
        uint keySize = NativeMemory.Read<uint>(table + (nint)ShmTblOff.T_SNAP + (nint)ShmTblOff.H_KEY_SIZE);
        if (!RtSyncTable.RowRevalidate(row, RtSyncTable.HashBytes(key), key, keySize)) {
            RtSyncTable.RowUnlock(row);
            return 0.0;
        }
        uint off = NativeMemory.Read<uint>(col + (nint)ShmTblOff.COL_OFFSET);
        double val = NativeMemory.Read<double>(row + (nint)off);
        RtSyncTable.RowUnlock(row);
        return val;
    }

    [Export("zan_shared_table_set_string")]
    public static int SetString(long handle, nint key, nint colName, nint value) {
        nint table = (nint)handle;
        if (table == (nint)0 || value == (nint)0) return 0;
        nint col = RtSyncTable.FindColumn(table, colName, ShmTblOff.COL_STRING);
        ulong valLen = col != (nint)0 ? SyncPlat.CStrLen(value) : 0UL;
        uint colSize = col != (nint)0 ? NativeMemory.Read<uint>(col + (nint)ShmTblOff.COL_LEN) : 0U;
        nint hdr = NativeMemory.Read<nint>(table + (nint)ShmTblOff.T_HEADER);
        nint row = (col != (nint)0 && valLen < (ulong)colSize) ? RtSyncTable.RowFor(hdr, key, true) : (nint)0;
        if (row == (nint)0) return 0;
        RtSyncTable.RowLock(row);
        uint keySize = NativeMemory.Read<uint>(table + (nint)ShmTblOff.T_SNAP + (nint)ShmTblOff.H_KEY_SIZE);
        if (!RtSyncTable.RowRevalidate(row, RtSyncTable.HashBytes(key), key, keySize)) {
            RtSyncTable.RowUnlock(row);
            return 0;
        }
        uint off = NativeMemory.Read<uint>(col + (nint)ShmTblOff.COL_OFFSET);
        nint dst = row + (nint)off;
        SyncPlat.CMemcpy(dst, value, valLen);
        NativeMemory.At<byte>(dst, (long)valLen) = (byte)0;
        RtSyncTable.RowUnlock(row);
        return 1;
    }

    [Export("zan_shared_table_get_string")]
    public static nint GetString(long handle, nint key, nint colName) {
        nint table = (nint)handle;
        nint result = RtSyncTable.GetSharedStringBuf();
        NativeMemory.Write<byte>(result, (byte)0);
        if (table == (nint)0) return result;
        nint col = RtSyncTable.FindColumn(table, colName, ShmTblOff.COL_STRING);
        nint hdr = NativeMemory.Read<nint>(table + (nint)ShmTblOff.T_HEADER);
        nint row = col != (nint)0 ? RtSyncTable.RowFor(hdr, key, false) : (nint)0;
        if (row == (nint)0) return result;
        RtSyncTable.RowLock(row);
        uint keySize = NativeMemory.Read<uint>(table + (nint)ShmTblOff.T_SNAP + (nint)ShmTblOff.H_KEY_SIZE);
        if (RtSyncTable.RowRevalidate(row, RtSyncTable.HashBytes(key), key, keySize)) {
            uint colSize = NativeMemory.Read<uint>(col + (nint)ShmTblOff.COL_LEN);
            uint off = NativeMemory.Read<uint>(col + (nint)ShmTblOff.COL_OFFSET);
            ulong maxLen = (ulong)(colSize - 1U);
            ulong len = SyncPlat.StrNLen(row + (nint)off, maxLen);
            SyncPlat.CMemcpy(result, row + (nint)off, len);
            NativeMemory.At<byte>(result, (long)len) = (byte)0;
        }
        RtSyncTable.RowUnlock(row);
        return result;
    }

    [Export("zan_shared_table_increment")]
    public static long Increment(long handle, nint key, nint colName, long delta) {
        nint table = (nint)handle;
        if (table == (nint)0) return 0L;
        nint col = RtSyncTable.FindColumn(table, colName, ShmTblOff.COL_INT);
        nint hdr = NativeMemory.Read<nint>(table + (nint)ShmTblOff.T_HEADER);
        nint row = col != (nint)0 ? RtSyncTable.RowFor(hdr, key, true) : (nint)0;
        if (row == (nint)0) return 0L;
        RtSyncTable.RowLock(row);
        uint keySize = NativeMemory.Read<uint>(table + (nint)ShmTblOff.T_SNAP + (nint)ShmTblOff.H_KEY_SIZE);
        if (!RtSyncTable.RowRevalidate(row, RtSyncTable.HashBytes(key), key, keySize)) {
            RtSyncTable.RowUnlock(row);
            return 0L;
        }
        uint off = NativeMemory.Read<uint>(col + (nint)ShmTblOff.COL_OFFSET);
        long val = NativeMemory.Read<long>(row + (nint)off) + delta;
        NativeMemory.Write<long>(row + (nint)off, val);
        RtSyncTable.RowUnlock(row);
        return val;
    }

    [Export("zan_shared_table_hash")]
    public static long TableHash(nint value) {
        return (long)RtSyncTable.HashBytes(value);
    }

    [Export("zan_shared_table_set_int_at")]
    public static int SetIntAt(long handle, long keyHash, nint colName, long value) {
        nint table = (nint)handle;
        if (table == (nint)0) return 0;
        nint col = RtSyncTable.FindColumn(table, colName, ShmTblOff.COL_INT);
        nint hdr = NativeMemory.Read<nint>(table + (nint)ShmTblOff.T_HEADER);
        nint row = col != (nint)0 ? RtSyncTable.RowForHash(hdr, (ulong)keyHash, true) : (nint)0;
        if (row == (nint)0) return 0;
        RtSyncTable.RowLock(row);
        if (!RtSyncTable.RowRevalidate(row, (ulong)keyHash, (nint)0, 0U)) {
            RtSyncTable.RowUnlock(row);
            return 0;
        }
        uint off = NativeMemory.Read<uint>(col + (nint)ShmTblOff.COL_OFFSET);
        NativeMemory.Write<long>(row + (nint)off, value);
        RtSyncTable.RowUnlock(row);
        return 1;
    }

