        uint off = NativeMemory.Read<uint>(col + (nint)ShmTblOff.COL_OFFSET);
        long val = NativeMemory.Read<long>(row + (nint)off) + delta;
        NativeMemory.Write<long>(row + (nint)off, val);
        RtSyncTable.RowUnlock(row);
        return val;
    }

    [Export("zan_shared_table_extreme_at")]
    public static long ExtremeAt(long handle, long keyHash, nint colName, long value, long keepLarger) {
        nint table = (nint)handle;
        if (table == (nint)0) return 0L;
        nint col = RtSyncTable.FindColumn(table, colName, ShmTblOff.COL_INT);
        nint hdr = NativeMemory.Read<nint>(table + (nint)ShmTblOff.T_HEADER);
        nint row = col != (nint)0 ? RtSyncTable.RowForHash(hdr, (ulong)keyHash, true) : (nint)0;
        if (row == (nint)0) return 0L;
        RtSyncTable.RowLock(row);
        if (!RtSyncTable.RowRevalidate(row, (ulong)keyHash, (nint)0, 0U)) {
            RtSyncTable.RowUnlock(row);
            return 0L;
        }
        uint off = NativeMemory.Read<uint>(col + (nint)ShmTblOff.COL_OFFSET);
        long stored = NativeMemory.Read<long>(row + (nint)off);
        bool replace = keepLarger != 0L ? (value > stored) : (stored == 0L || value < stored);
        if (replace) {
            NativeMemory.Write<long>(row + (nint)off, value);
            stored = value;
        }
        RtSyncTable.RowUnlock(row);
        return stored;
    }

    [Export("zan_shared_table_set_string_at")]
    public static int SetStringAt(long handle, long keyHash, nint colName, nint value) {
        nint table = (nint)handle;
        if (table == (nint)0 || value == (nint)0) return 0;
        nint col = RtSyncTable.FindColumn(table, colName, ShmTblOff.COL_STRING);
        ulong valLen = col != (nint)0 ? SyncPlat.CStrLen(value) : 0UL;
        uint colSize = col != (nint)0 ? NativeMemory.Read<uint>(col + (nint)ShmTblOff.COL_LEN) : 0U;
        nint hdr = NativeMemory.Read<nint>(table + (nint)ShmTblOff.T_HEADER);
        nint row = (col != (nint)0 && valLen < (ulong)colSize) ? RtSyncTable.RowForHash(hdr, (ulong)keyHash, true) : (nint)0;
        if (row == (nint)0) return 0;
        RtSyncTable.RowLock(row);
        if (!RtSyncTable.RowRevalidate(row, (ulong)keyHash, (nint)0, 0U)) {
            RtSyncTable.RowUnlock(row);
            return 0;
        }
        uint off = NativeMemory.Read<uint>(col + (nint)ShmTblOff.COL_OFFSET);
        nint dst = row + (nint)off;
        SyncPlat.CMemcpy(dst, value, valLen);
        NativeMemory.At<byte>(dst, (long)valLen) = (byte)0;
        RtSyncTable.RowUnlock(row);
        return 1;
    }

    [Export("zan_shared_table_get_string_at")]
    public static nint GetStringAt(long handle, long keyHash, nint colName) {
        nint table = (nint)handle;
        nint result = RtSyncTable.GetSharedStringBuf();
        NativeMemory.Write<byte>(result, (byte)0);
        if (table == (nint)0) return result;
        nint col = RtSyncTable.FindColumn(table, colName, ShmTblOff.COL_STRING);
        nint hdr = NativeMemory.Read<nint>(table + (nint)ShmTblOff.T_HEADER);
        nint row = col != (nint)0 ? RtSyncTable.RowForHash(hdr, (ulong)keyHash, false) : (nint)0;
        if (row == (nint)0) return result;
        RtSyncTable.RowLock(row);
        if (RtSyncTable.RowRevalidate(row, (ulong)keyHash, (nint)0, 0U)) {
            uint colSize = NativeMemory.Read<uint>(col + (nint)ShmTblOff.COL_LEN);
            uint off = NativeMemory.Read<uint>(col + (nint)ShmTblOff.COL_OFFSET);
            ulong maxLen = (ulong)(colSize - 1U);
            ulong len = SyncPlat.StrNLen(row + (nint)off, maxLen);
            SyncPlat.CMemcpy(result, row + (nint)off, len);
            NativeMemory.At<byte>(result, (long)len) = (byte)0;
        }
        RtSyncTable.RowUnlock(row);
        return result;
    }

    [Export("zan_shared_table_match_at")]
    public static int MatchAt(long handle, long keyHash, nint colName, nint text) {
        nint table = (nint)handle;
        if (table == (nint)0 || text == (nint)0) return 0;
        nint col = RtSyncTable.FindColumn(table, colName, ShmTblOff.COL_STRING);
        nint hdr = NativeMemory.Read<nint>(table + (nint)ShmTblOff.T_HEADER);
        nint row = col != (nint)0 ? RtSyncTable.FindRowHash(hdr, (ulong)keyHash, false) : (nint)0;
        if (row == (nint)0) return 0;
        RtSyncTable.RowLock(row);
        int eq = 0;
        if (RtSyncTable.RowRevalidate(row, (ulong)keyHash, (nint)0, 0U)) {
            uint colSize = NativeMemory.Read<uint>(col + (nint)ShmTblOff.COL_LEN);
            uint off = NativeMemory.Read<uint>(col + (nint)ShmTblOff.COL_OFFSET);
            eq = SyncPlat.CStrNCmp(row + (nint)off, text, (ulong)colSize) == 0 ? 1 : 0;
        }
        RtSyncTable.RowUnlock(row);
        return eq;
    }

    [Export("zan_shared_table_exists_at")]
    public static int ExistsAt(long handle, long keyHash) {
        nint table = (nint)handle;
        if (table == (nint)0) return 0;
        nint hdr = NativeMemory.Read<nint>(table + (nint)ShmTblOff.T_HEADER);
        RtSyncTable.PurgeExpired(hdr);
        return RtSyncTable.FindRowHash(hdr, (ulong)keyHash, false) != (nint)0 ? 1 : 0;
    }

    [Export("zan_shared_table_delete_at")]
    public static int DeleteAt(long handle, long keyHash) {
        nint table = (nint)handle;
        if (table == (nint)0) return 0;
        nint hdr = NativeMemory.Read<nint>(table + (nint)ShmTblOff.T_HEADER);
        RtSyncTable.StructLock(hdr);
        RtSyncTable.PurgeExpiredLocked(hdr, SyncPlat.TimeEpochMs(), ShmTblOff.PURGE_MAX_BATCH);
        nint row = RtSyncTable.FindRowHash(hdr, (ulong)keyHash, false);
        if (row != (nint)0) {
            RtSyncTable.RowLock(row);
            RtSyncTable.DeleteRowLocked(hdr, row);
            RtSyncTable.RowUnlock(row);
        }
        RtSyncTable.StructUnlock(hdr);
        return row != (nint)0 ? 1 : 0;
    }
}
