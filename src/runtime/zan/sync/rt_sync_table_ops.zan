// rt_sync_table_ops.zan: Typed column accessors and hash-keyed fast-path
// operations for zan_shared_table.
// Replaces src/runtime/sync/rt_sync_table_ops.c in 100% pure Zan.

namespace Zan.Runtime.Sync;

static class RtSyncTableOps {
    [Export("zan_shared_table_set_int")]
    public static int SetInt(long handle, nint key, nint colName, long value) {
        nint table = (nint)handle;
        if (table == (nint)0) return 0;
        nint col = RtSyncTable.FindColumn(table, colName, ShmTblOff.COL_INT);
        nint hdr = NativeMemory.Read<nint>(table + (nint)ShmTblOff.T_HEADER);
        nint row = col != (nint)0 ? RtSyncTable.RowFor(hdr, key, true) : (nint)0;
        if (row == (nint)0) return 0;
        RtSyncTable.RowLock(row);
        uint keySize = NativeMemory.Read<uint>(table + (nint)ShmTblOff.T_SNAP + (nint)ShmTblOff.H_KEY_SIZE);
        if (!RtSyncTable.RowRevalidate(row, RtSyncTable.HashBytes(key), key, keySize)) {
            RtSyncTable.RowUnlock(row);
            return 0;
        }
        uint off = NativeMemory.Read<uint>(col + (nint)ShmTblOff.COL_OFFSET);
        NativeMemory.Write<long>(row + (nint)off, value);
        RtSyncTable.RowUnlock(row);
        return 1;
    }

    [Export("zan_shared_table_get_int")]
    public static long GetInt(long handle, nint key, nint colName) {
        nint table = (nint)handle;
        if (table == (nint)0) return 0L;
        nint col = RtSyncTable.FindColumn(table, colName, ShmTblOff.COL_INT);
        nint hdr = NativeMemory.Read<nint>(table + (nint)ShmTblOff.T_HEADER);
        nint row = col != (nint)0 ? RtSyncTable.RowFor(hdr, key, false) : (nint)0;
        if (row == (nint)0) return 0L;
        RtSyncTable.RowLock(row);
        uint keySize = NativeMemory.Read<uint>(table + (nint)ShmTblOff.T_SNAP + (nint)ShmTblOff.H_KEY_SIZE);
        if (!RtSyncTable.RowRevalidate(row, RtSyncTable.HashBytes(key), key, keySize)) {
            RtSyncTable.RowUnlock(row);
            return 0L;
        }
        uint off = NativeMemory.Read<uint>(col + (nint)ShmTblOff.COL_OFFSET);
        long val = NativeMemory.Read<long>(row + (nint)off);
        RtSyncTable.RowUnlock(row);
        return val;
    }

    [Export("zan_shared_table_try_get_int")]
    public static int TryGetInt(long handle, nint key, nint colName, nint outValue) {
        nint table = (nint)handle;
        if (table == (nint)0 || outValue == (nint)0) return 0;
        nint col = RtSyncTable.FindColumn(table, colName, ShmTblOff.COL_INT);
        nint hdr = NativeMemory.Read<nint>(table + (nint)ShmTblOff.T_HEADER);
        nint row = col != (nint)0 ? RtSyncTable.RowFor(hdr, key, false) : (nint)0;
        if (row == (nint)0) return 0;
        RtSyncTable.RowLock(row);
        uint keySize = NativeMemory.Read<uint>(table + (nint)ShmTblOff.T_SNAP + (nint)ShmTblOff.H_KEY_SIZE);
        if (!RtSyncTable.RowRevalidate(row, RtSyncTable.HashBytes(key), key, keySize)) {
            RtSyncTable.RowUnlock(row);
            return 0;
        }
        uint off = NativeMemory.Read<uint>(col + (nint)ShmTblOff.COL_OFFSET);
        NativeMemory.Write<long>(outValue, NativeMemory.Read<long>(row + (nint)off));
        RtSyncTable.RowUnlock(row);
        return 1;
    }

