    // ---- Buffer formatting helpers ----
    internal static ulong StrNLen(nint s, ulong maxLen) {
        if (s == (nint)0) return 0UL;
        ulong n = 0UL;
        while (n < maxLen && NativeMemory.At<byte>(s, (long)n) != (byte)0) {
            n++;
        }
        return n;
    }

    internal static ulong BufAppendBytes(nint buf, ulong cap, ulong pos, nint src, ulong len) {
        if (cap == 0UL || pos >= cap - 1UL) return pos;
        ulong avail = cap - 1UL - pos;
        ulong copy = len < avail ? len : avail;
        if (copy > 0UL) {
            CMemcpy(buf + (nint)pos, src, copy);
            pos += copy;
        }
        NativeMemory.At<byte>(buf, (long)pos) = (byte)0;
        return pos;
    }

    internal static ulong BufAppendCStr(nint buf, ulong cap, ulong pos, nint s) {
        if (s == (nint)0) return pos;
        return BufAppendBytes(buf, cap, pos, s, CStrLen(s));
    }

    internal static ulong BufAppendChar(nint buf, ulong cap, ulong pos, byte ch) {
        if (cap == 0UL || pos >= cap - 1UL) return pos;
        NativeMemory.At<byte>(buf, (long)pos) = ch;
        pos++;
        NativeMemory.At<byte>(buf, (long)pos) = (byte)0;
        return pos;
    }

    internal static ulong BufAppendU64(nint buf, ulong cap, ulong pos, ulong v) {
        SyncBuf32 tmp = new SyncBuf32();
        nint tp = NativeMemory.AddressOf(ref tmp);
        int idx = 0;
        if (v == 0UL) {
            NativeMemory.At<byte>(tp, 0L) = (byte)48;
            idx = 1;
        } else {
            while (v > 0UL && idx < 30) {
                NativeMemory.At<byte>(tp, (long)idx) = (byte)(48UL + (v % 10UL));
                v /= 10UL;
                idx++;
            }
        }
        for (int i = idx - 1; i >= 0; i--) {
            pos = BufAppendChar(buf, cap, pos, NativeMemory.At<byte>(tp, (long)i));
        }
        return pos;
    }

    internal static ulong BufAppendI64(nint buf, ulong cap, ulong pos, long v) {
        if (v < 0L) {
            pos = BufAppendChar(buf, cap, pos, (byte)45);
            ulong uv = (ulong)(-(v + 1L)) + 1UL;
            return BufAppendU64(buf, cap, pos, uv);
        }
        return BufAppendU64(buf, cap, pos, (ulong)v);
    }

    internal static ulong BufAppendHex16Lower(nint buf, ulong cap, ulong pos, ulong v) {
        for (int shift = 60; shift >= 0; shift -= 4) {
            uint nib = (uint)((v >> shift) & 0xFUL);
            byte ch = nib < 10U ? (byte)(48U + nib) : (byte)(87U + nib);
            pos = BufAppendChar(buf, cap, pos, ch);
        }
        return pos;
    }

    internal static ulong BufAppendHex2Upper(nint buf, ulong cap, ulong pos, byte b) {
        uint hi = (uint)((b >> 4) & 0xF);
        uint lo = (uint)(b & 0xF);
        pos = BufAppendChar(buf, cap, pos, hi < 10U ? (byte)(48U + hi) : (byte)(55U + hi));
        pos = BufAppendChar(buf, cap, pos, lo < 10U ? (byte)(48U + lo) : (byte)(55U + lo));
        return pos;
    }

    internal static nint StrDup(nint s) {
        if (s == (nint)0) return (nint)0;
        ulong n = CStrLen(s);
        nint dup = CMalloc(n + 1UL);
        if (dup == (nint)0) return (nint)0;
        CMemcpy(dup, s, n + 1UL);
        return dup;
    }

