    internal static void WriteStderrBytes(nint buf, ulong len) {
        if (len == 0UL) return;
        nint err = WinAcrtIobFunc(2U);
        if (err != (nint)0) {
            CFwrite(buf, 1UL, len, err);
            CFflush(err);
        }
    }

    internal static nint Utf8ToWideAlloc(nint utf8) {
        if (utf8 == (nint)0) return (nint)0;
        int wlen = WinMultiByteToWideChar(CP_UTF8, 0U, utf8, -1, (nint)0, 0);
        if (wlen <= 0) return (nint)0;
        nint wbuf = CCalloc((ulong)wlen, 2UL);
        if (wbuf == (nint)0) return (nint)0;
        WinMultiByteToWideChar(CP_UTF8, 0U, utf8, -1, wbuf, wlen);
        return wbuf;
    }

    internal static void OsYield() { WinSwitchToThread(); }
    internal static void MutexLock(nint m) { WinAcquireSrw(m); }
    internal static void MutexUnlock(nint m) { WinReleaseSrw(m); }
