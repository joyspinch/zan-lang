// rt_sync_plat.zan: Platform FFI, opaque buffers, cross-platform locks/CVs,
// string/hex helpers, and runtime hooks for zanrt_sync.
// 100% pure Zan, zero assembly.

namespace Zan.Runtime.Sync;

struct SyncBuf16 { public ulong A; public ulong B; }
struct SyncBuf24 { public ulong A; public ulong B; public ulong C; }
struct SyncBuf32 { public SyncBuf16 A; public SyncBuf16 B; }
struct SyncBuf48 { public SyncBuf32 A; public SyncBuf16 B; }
struct SyncBuf64 { public SyncBuf32 A; public SyncBuf32 B; }
struct SyncBuf128 { public SyncBuf64 A; public SyncBuf64 B; }
struct SyncBuf160 { public SyncBuf128 A; public SyncBuf32 B; }
struct SyncBuf256 { public SyncBuf128 A; public SyncBuf128 B; }
struct SyncBuf320 { public SyncBuf256 A; public SyncBuf64 B; }
struct SyncBuf512 { public SyncBuf256 A; public SyncBuf256 B; }
struct SyncBuf1024 { public SyncBuf512 A; public SyncBuf512 B; }
struct SyncBuf2048 { public SyncBuf1024 A; public SyncBuf1024 B; }
struct SyncBuf4096 { public SyncBuf2048 A; public SyncBuf2048 B; }

// Monitor bucket: 64B on Win64/Linux-x64/macOS; 72B on Linux-arm64 (48B pthread_mutex_t)
struct SyncMonBucket {
    public ulong W0;
    public ulong W1;
    public ulong W2;
    public ulong W3;
    public ulong W4;
#if !WINDOWS && !MACOS && ARM64
    public ulong W5;
#endif
    public nint Head;
    public nint FreeList;
    public uint FreeCount;
    public uint Pad;
}

struct SyncMonBuckets4 {
    public SyncMonBucket B0;
    public SyncMonBucket B1;
    public SyncMonBucket B2;
    public SyncMonBucket B3;
}

struct SyncMonBuckets16 {
    public SyncMonBuckets4 G0;
    public SyncMonBuckets4 G1;
    public SyncMonBuckets4 G2;
    public SyncMonBuckets4 G3;
}

struct SyncMonBuckets64 {
    public SyncMonBuckets16 G0;
    public SyncMonBuckets16 G1;
    public SyncMonBuckets16 G2;
    public SyncMonBuckets16 G3;
}

struct SyncMonBuckets256 {
    public SyncMonBuckets64 G0;
    public SyncMonBuckets64 G1;
    public SyncMonBuckets64 G2;
    public SyncMonBuckets64 G3;
}

