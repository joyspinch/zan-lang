    internal static void WriteStderrBytes(nint buf, ulong len) {
        if (len == 0UL) return;
        ulong off = 0UL;
        while (off < len) {
            long w = PosixWrite(2, buf + (nint)off, len - off);
            if (w <= 0L) break;
            off += (ulong)w;
        }
    }

    internal static void OsYield() { PosixSchedYield(); }
#if MACOS
    // Standalone zero-initialized locks (Monitor buckets, dispatch ring)
    internal static void MutexLock(nint m) { MacUnfairLock(m); }
    internal static void MutexUnlock(nint m) { MacUnfairUnlock(m); }
#else
    internal static void MutexLock(nint m) { PosixMutexLock(m); }
    internal static void MutexUnlock(nint m) { PosixMutexUnlock(m); }
#endif
#endif
