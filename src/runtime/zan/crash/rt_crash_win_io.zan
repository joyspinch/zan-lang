// rt_crash.zan -- Pure-Zan (zero-assembly) crash reporter & thread-level recovery runtime.
// Replaces src/runtime/rt_crash.c + crash/rt_crash_win_{io,sym,guard}.c + crash/rt_crash_posix.c.
//
// Exports exact C ABI defined in src/runtime/rt_crash.h:
//   void zan__crash_install(void);
//   int  zan__guard_call(void (*fn)(void *), void *arg);
//   long zan__guard_recovered_count(void);
// Plus [ModuleInitializer] (internal __zan_static_init -> llvm.global_ctors) for automatic startup install.
//
// Discipline:
//   - 100% pure Zan, zero assembly, zero heap allocation, zero CRT stdio locks.
//   - Windows: Win32 HANDLE + stack-buffer formatting + frozen extended-length UTF-16 log paths +
//     1 MiB rotation + VEH + SetUnhandledExceptionFilter + RtlCaptureContext recovery (no setjmp/asm).
//   - Linux: async-signal-safe write(fd) + sigaltstack(64 KiB) + sigaction (glibc & musl layout aware) +
//     UTC civil-date formatter + ucontext_t x64 frame-pointer walk + dladdr.

using System;
using System.Runtime.CompilerServices;
using System.Runtime.InteropServices;
using System.Threading;

namespace ZanCrashRuntime {

#if WINDOWS
    // Fixed stack/static buffers (zero heap allocation)
    struct Buf16   { public InlineArray<16, byte> Data; }
    struct Buf32   { public InlineArray<32, byte> Data; }
    struct Buf64   { public InlineArray<64, byte> Data; }
    struct Buf128  { public InlineArray<128, byte> Data; }
    struct Buf260  { public InlineArray<260, byte> Data; }
    struct Buf1024 { public InlineArray<1024, byte> Data; }
    struct Buf2048 { public InlineArray<2048, byte> Data; }
    struct Buf3200 { public InlineArray<3200, byte> Data; }
    struct Buf4096 { public InlineArray<4096, byte> Data; }
    struct Buf8192 { public InlineArray<8192, byte> Data; }
    struct WBuf32   { public InlineArray<32, ushort> Data; }
    struct WBuf4096 { public InlineArray<4096, ushort> Data; }
    struct CtxBuf1248 { public InlineArray<1248, byte> Data; }
    struct ErBuf152 { public InlineArray<152, byte> Data; }
    struct PtrBuf62 { public InlineArray<62, nint> Data; }
    struct PtrBuf64 { public InlineArray<64, nint> Data; }
    struct UlongBuf24 { public InlineArray<24, ulong> Data; }

    struct ThreadSlot {
        public int Tid;
        public int Ready;
        public int Busy;
        public int Pad;
        public nint Top;
    }

    struct SlotTable64 {
        public InlineArray<64, ThreadSlot> Slots;
    }

    struct GuardFrame {
        public CtxBuf1248 SavedCtxBuf;
        public nint SavedCtxPtr;
        public nint Prev;
        public int Armed;
        public int Resumed;
        public ErBuf152 FaultEr;
        public CtxBuf1248 FaultCtxBuf;
        public nint FaultCtxPtr;
        public PtrBuf62 Bt;
        public uint Btn;
        public int Have;
    }

    // Stack-buffered lock-free writer (never uses CRT stdio locks or heap)
    struct LineWriter {
        public nint Handle;
        public Buf1024 Buf;
        public int Pos;
    }

    static partial class CrashRt {
        const int ZAN_CRASH_PATH_CAP = 4096;
        const int ZAN_GUARD_SLOTS = 64;
        const int ZAN_GUARD_LOG_FULL = 20;
        const int ZAN_GUARD_LOG_EVERY = 100;
        const long ZAN_CRASH_LOG_MAX_BYTES = 1048576L;
        const ulong WIN64_CTX_SIZE = 1232UL;
        const ulong WIN64_ER_SIZE = 152UL;

        // Win32 constants (verified against x86_64-w64-windows-gnu headers)
        const int EXCEPTION_CONTINUE_EXECUTION = -1;
        const int EXCEPTION_CONTINUE_SEARCH = 0;
        const int EXCEPTION_EXECUTE_HANDLER = 1;

        const uint FILE_APPEND_DATA = 0x00000004U;
        const uint GENERIC_READ = 0x80000000U;
        const uint GENERIC_WRITE = 0x40000000U;
        const uint FILE_SHARE_READ = 0x00000001U;
        const uint FILE_SHARE_WRITE = 0x00000002U;
        const uint FILE_SHARE_DELETE = 0x00000004U;
        const uint CREATE_NEW = 1U;
        const uint OPEN_EXISTING = 3U;
        const uint OPEN_ALWAYS = 4U;
        const uint FILE_ATTRIBUTE_DIRECTORY = 0x00000010U;
        const uint FILE_ATTRIBUTE_NORMAL = 0x00000080U;
        const uint FILE_ATTRIBUTE_TEMPORARY = 0x00000100U;
        const uint INVALID_FILE_ATTRIBUTES = 0xFFFFFFFFU;
        const uint ERROR_ALREADY_EXISTS = 183U;
        const uint CP_UTF8 = 65001U;
        const uint MB_ERR_INVALID_CHARS = 8U;
        const uint WC_ERR_INVALID_CHARS = 0x80U;
        const uint GMHEX_PIN = 0x1U;
        const uint GMHEX_UNCHANGED_REFCOUNT = 0x2U;
        const uint GMHEX_FROM_ADDRESS = 0x4U;
        const uint MEM_COMMIT = 0x1000U;
        const uint PAGE_NOACCESS = 0x1U;
        const uint PAGE_GUARD = 0x100U;
        const uint STARTF_USESTDHANDLES = 0x100U;
        const uint CREATE_NO_WINDOW = 0x08000000U;

        const uint EX_ACCESS_VIOLATION = 0xC0000005U;
        const uint EX_IN_PAGE_ERROR = 0xC0000006U;
        const uint EX_ARRAY_BOUNDS = 0xC000008CU;
        const uint EX_DATATYPE_MISALIGN = 0x80000002U;
        const uint EX_ILLEGAL_INSTR = 0xC000001DU;
        const uint EX_PRIV_INSTR = 0xC0000096U;
        const uint EX_INT_DIV_ZERO = 0xC0000094U;
        const uint EX_INT_OVERFLOW = 0xC0000095U;
        const uint EX_FLT_DIV_ZERO = 0xC000008EU;
        const uint EX_FLT_INVALID_OP = 0xC0000090U;
        const uint EX_STACK_OVERFLOW = 0xC00000FDU;
        const uint EX_HEAP_CORRUPTION = 0xC0000374U;
        const uint EX_FAIL_FAST = 0xC0000409U;

