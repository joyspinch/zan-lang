        [DllImport("kernel32", EntryPoint = "SetThreadStackGuarantee")]
        static extern int WinSetThreadStackGuarantee(nint stackSizeInBytes);

        [DllImport("kernel32", EntryPoint = "RtlCaptureContext")]
        static extern void WinRtlCaptureContext(nint ctx);

        [DllImport("kernel32", EntryPoint = "RtlCaptureStackBackTrace")]
        static extern ushort WinCaptureBackTrace(uint framesToSkip, uint framesToCapture, nint backTrace, nint hash);

        [DllImport("kernel32", EntryPoint = "GetCurrentProcessId")]
        static extern uint WinGetCurrentProcessId();

        [DllImport("kernel32", EntryPoint = "GetCurrentThreadId")]
        static extern uint WinGetCurrentThreadId();

        [DllImport("kernel32", EntryPoint = "GetLocalTime")]
        static extern void WinGetLocalTime(nint st);

        [DllImport("kernel32", EntryPoint = "GetTickCount64")]
        static extern ulong WinGetTickCount64();

        [DllImport("kernel32", EntryPoint = "QueryPerformanceCounter")]
        static extern int WinQueryPerformanceCounter(nint lpCount);

        [DllImport("kernel32", EntryPoint = "GetModuleHandleA")]
        static extern nint WinGetModuleHandleA(nint name);

        [DllImport("kernel32", EntryPoint = "GetModuleHandleW")]
        static extern nint WinGetModuleHandleW(nint name);

        [DllImport("kernel32", EntryPoint = "GetModuleHandleExA")]
        static extern int WinGetModuleHandleExA(uint flags, nint name, nint outMod);

        [DllImport("kernel32", EntryPoint = "GetModuleFileNameA")]
        static extern uint WinGetModuleFileNameA(nint mod, nint buf, uint size);

        [DllImport("kernel32", EntryPoint = "GetEnvironmentVariableW")]
        static extern uint WinGetEnvW(nint name, nint buf, uint size);

        [DllImport("kernel32", EntryPoint = "GetTempPathW")]
        static extern uint WinGetTempPathW(uint bufLen, nint buf);

        [DllImport("kernel32", EntryPoint = "GetFullPathNameW")]
        static extern uint WinGetFullPathNameW(nint fileName, uint bufLen, nint buf, nint filePart);

        [DllImport("kernel32", EntryPoint = "CreateDirectoryW")]
        static extern int WinCreateDirectoryW(nint path, nint sa);

        [DllImport("kernel32", EntryPoint = "GetLastError")]
