// rt_timer_plat.zan: Shared platform bindings, synchronization, C-string/stack
// formatting helpers, ABI constants, and B-ID98 OOM injection gate for zanrt_timer.
// 100% pure Zan, zero inline assembly, zero ARC heap allocation.

namespace Zan.Runtime.Timer;

// ---- Fixed-size unmanaged stack/static storage structs ----

struct Buf32 {
    public ulong W0; public ulong W1; public ulong W2; public ulong W3;
}

struct Buf48 {
    public ulong W0; public ulong W1; public ulong W2;
    public ulong W3; public ulong W4; public ulong W5;
}

struct Buf64 {
    public ulong W0; public ulong W1; public ulong W2; public ulong W3;
    public ulong W4; public ulong W5; public ulong W6; public ulong W7;
}

struct Buf160 {
    public Buf64 A; public Buf64 B; public Buf32 C;
}

struct Buf256 {
    public Buf64 A; public Buf64 B; public Buf64 C; public Buf64 D;
}

struct Buf512 {
    public Buf256 A; public Buf256 B;
}

struct Buf1408 {
    public Buf512 A; public Buf512 B; public Buf256 C; public Buf64 D; public Buf64 E;
}

struct Buf4096 {
    public Buf512 A; public Buf512 B; public Buf512 C; public Buf512 D;
    public Buf512 E; public Buf512 F; public Buf512 G; public Buf512 H;
}

// 4128 + 8 + 4096 = 8232 bytes -> use 8256 bytes (aligned to 16 via ulong fields)
struct SoftScratchStore {
    public Buf4096 A;
    public Buf4096 B;
    public Buf64 C;
}

// Platform mutex storage: 8B SRWLOCK on Windows; 64B on POSIX (40B Linux x64 / 48B Linux arm64 / 4B os_unfair_lock on macOS)
#if WINDOWS
struct OsMutex {
    public nint Lock;
}
#else
struct OsMutex {
    public ulong W0; public ulong W1; public ulong W2; public ulong W3;
    public ulong W4; public ulong W5; public ulong W6; public ulong W7;
}
#endif

// Unified per-thread TLS block for zanrt_timer (FLS / pthread_key, zero _tls_index)
struct TimerTls {
    public nint SoftScratch;
    public nint ProfileSlice;
    public ulong HeapMutatorDepth;
    public ulong ThreadAllocBytes;
    public int DispatchOwned;
    public int SoftScratchExiting;
}

