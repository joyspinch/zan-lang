    internal static void OsYield() { WinSwitchToThread(); }

    internal static void WriteStderrBytes(nint buf, ulong len) {
        if (len == 0UL) return;
        nint err = StderrFile();
        if (err != (nint)0) {
            CFwrite(buf, 1UL, len, err);
            CFflush(err);
        }
    }

    internal static void WriteStdoutBytes(nint buf, ulong len) {
        if (len == 0UL) return;
        nint outF = StdoutFile();
        if (outF != (nint)0) {
            CFwrite(buf, 1UL, len, outF);
        }
    }

    internal static void FlushStdout() {
        nint outF = StdoutFile();
        if (outF != (nint)0) CFflush(outF);
    }
