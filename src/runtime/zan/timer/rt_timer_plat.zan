    static nint s_winRandSFn = (nint)0;

    internal static int WinRandS(nint outUint) {
        nint fn = Atomic.Load(ref s_winRandSFn, MemoryOrder.Acquire);
        if (fn == (nint)0) {
            nint mod = WinGetModuleHandleA((nint)"ucrtbase.dll");
            if (mod == (nint)0) mod = WinGetModuleHandleA((nint)"msvcrt.dll");
            if (mod == (nint)0) mod = WinLoadLibraryA((nint)"msvcrt.dll");
            if (mod != (nint)0) fn = WinGetProcAddress(mod, (nint)"rand_s");
            if (fn == (nint)0) fn = (nint)1;
            Atomic.Store(ref s_winRandSFn, fn, MemoryOrder.Release);
        }
        if (fn == (nint)1) return -1;
        return NativeMemory.InvokeWithCC<int>("c", fn, outUint);
    }

