    internal static void WriteStderrBytes(nint buf, ulong len) {
        if (len == 0UL) return;
        ulong off = 0UL;
        while (off < len) {
            long w = PosixWrite(2, buf + (nint)off, len - off);
            if (w <= 0L) break;
            off += (ulong)w;
        }
    }

    internal static void WriteStdoutBytes(nint buf, ulong len) {
        if (len == 0UL) return;
        CFflush((nint)0);
        ulong off = 0UL;
        while (off < len) {
            long w = PosixWrite(1, buf + (nint)off, len - off);
            if (w <= 0L) break;
            off += (ulong)w;
        }
    }

    internal static void FlushStdout() {
        CFflush((nint)0);
    }
#endif

    // ---- Shared global timer mutex ----
    static OsMutex s_timerLock;

    internal static void TimerLock() {
        MutexLock(NativeMemory.AddressOf(ref s_timerLock));
    }

    internal static void TimerUnlock() {
        MutexUnlock(NativeMemory.AddressOf(ref s_timerLock));
    }

    // ---- Unified per-thread TLS block (FLS / pthread_key, zero _tls_index) ----
    static int s_tlsKeyState = 0; // 0=uninit, 1=initing, 2=ready, 3=failed
#if WINDOWS
    static uint s_tlsFls = 0xFFFFFFFFU;
#elif MACOS
    static ulong s_tlsKey = 0UL;
#else
    static uint s_tlsKey = 0U;
#endif

    [Export("__zan_timer_tls_exit")]
    [Visibility("hidden")]
    static void TimerTlsExit(nint p) {
        if (p == (nint)0) return;
        ref TimerTls tls = ref NativeMemory.AsRef<TimerTls>(p);
        nint scratch = tls.SoftScratch;
        tls.SoftScratch = (nint)0;
        tls.SoftScratchExiting = 1;
        if (scratch != (nint)0) {
            RtTimerDiag.SoftRelease(scratch);
        }
        CFree(p);
    }

    static bool TimerTlsKeyReady() {
        int st = Atomic.Load(ref s_tlsKeyState, MemoryOrder.Acquire);
        if (st == 2) return true;
        if (st == 3) return false;
        if (st == 0 && Atomic.CompareExchangeBool(ref s_tlsKeyState, 0, 1, MemoryOrder.AcqRel, MemoryOrder.Acquire)) {
#if WINDOWS
            uint idx = WinFlsAlloc(NativeMemory.FunctionPointer(TimerTlsExit));
            s_tlsFls = idx;
            st = (idx != FLS_OUT_OF_INDEXES) ? 2 : 3;
#else
            bool ok = PosixKeyCreate(NativeMemory.AddressOf(ref s_tlsKey), NativeMemory.FunctionPointer(TimerTlsExit)) == 0;
            st = ok ? 2 : 3;
#endif
            Atomic.Store(ref s_tlsKeyState, st, MemoryOrder.Release);
            return st == 2;
        }
        while ((st = Atomic.Load(ref s_tlsKeyState, MemoryOrder.Acquire)) == 1) {
            Atomic.Pause();
        }
        return st == 2;
    }

    internal static nint TimerTlsPeek() {
        if (Atomic.Load(ref s_tlsKeyState, MemoryOrder.Acquire) != 2) return (nint)0;
#if WINDOWS
        return WinFlsGetValue(s_tlsFls);
#else
        return PosixGetSpecific(s_tlsKey);
#endif
    }

    internal static nint TimerTlsGet() {
        nint p = TimerTlsPeek();
        if (p != (nint)0) return p;
        if (!TimerTlsKeyReady()) return (nint)0;
#if WINDOWS
        p = WinFlsGetValue(s_tlsFls);
#else
        p = PosixGetSpecific(s_tlsKey);
#endif
        if (p != (nint)0) return p;
        p = CCalloc(1UL, (ulong)sizeof(TimerTls));
        if (p == (nint)0) return (nint)0;
#if WINDOWS
        if (WinFlsSetValue(s_tlsFls, p) == 0) {
            CFree(p);
            return (nint)0;
        }
#else
        if (PosixSetSpecific(s_tlsKey, p) != 0) {
            CFree(p);
            return (nint)0;
        }
#endif
        return p;
    }

    // ---- TTAS spinlock helpers (zero inline asm) ----
    internal static void SpinLockWord(nint lockPtr) {
        int spins = 0;
        while (true) {
            if (Atomic.LoadAt<int>(lockPtr, MemoryOrder.Relaxed) == 0 &&
                Atomic.ExchangeAt<int>(lockPtr, 1, MemoryOrder.Acquire) == 0) {
                return;
            }
            spins++;
            if (spins >= 64) {
                OsYield();
            }
        }
    }

    internal static void SpinUnlockWord(nint lockPtr) {
        Atomic.StoreAt<int>(lockPtr, 0, MemoryOrder.Release);
    }

    // ---- Pure-Zan C string helpers ----

    internal static ulong CStrLen(nint s) {
        if (s == (nint)0) return 0UL;
        ulong n = 0UL;
        while (NativeMemory.At<byte>(s, (long)n) != (byte)0) n++;
        return n;
    }

    internal static int CStrCmp(nint a, nint b) {
        if (a == b) return 0;
        if (a == (nint)0) return -1;
        if (b == (nint)0) return 1;
        long i = 0L;
        while (true) {
            byte ca = NativeMemory.At<byte>(a, i);
            byte cb = NativeMemory.At<byte>(b, i);
            if (ca != cb) return (int)ca - (int)cb;
            if (ca == (byte)0) return 0;
            i++;
        }
    }

    internal static nint CStrChr(nint s, byte ch) {
        if (s == (nint)0) return (nint)0;
        long i = 0L;
        while (true) {
            byte c = NativeMemory.At<byte>(s, i);
            if (c == ch) return s + (nint)i;
            if (c == (byte)0) return (nint)0;
            i++;
        }
    }

    internal static nint CStrRChr(nint s, byte ch) {
        if (s == (nint)0) return (nint)0;
        nint last = (nint)0;
        long i = 0L;
        while (true) {
            byte c = NativeMemory.At<byte>(s, i);
            if (c == ch) last = s + (nint)i;
            if (c == (byte)0) return last;
            i++;
        }
    }

    internal static nint CStrStr(nint haystack, nint needle) {
        if (haystack == (nint)0 || needle == (nint)0) return (nint)0;
        byte n0 = NativeMemory.At<byte>(needle, 0L);
        if (n0 == (byte)0) return haystack;
        long i = 0L;
        while (true) {
            byte c = NativeMemory.At<byte>(haystack, i);
            if (c == (byte)0) return (nint)0;
            if (c == n0) {
                long j = 1L;
                while (true) {
                    byte nj = NativeMemory.At<byte>(needle, j);
                    if (nj == (byte)0) return haystack + (nint)i;
                    byte hj = NativeMemory.At<byte>(haystack, i + j);
                    if (hj != nj) break;
                    j++;
                }
            }
            i++;
        }
    }

    internal static ulong CStrCspnByte(nint s, byte reject) {
        if (s == (nint)0) return 0UL;
        ulong i = 0UL;
        while (true) {
            byte c = NativeMemory.At<byte>(s, (long)i);
            if (c == (byte)0 || c == reject) return i;
            i++;
        }
    }

    internal static int ParseAsciiInt(nint s) {
        if (s == (nint)0) return 0;
        long i = 0L;
        while (true) {
            byte c = NativeMemory.At<byte>(s, i);
            if (c == (byte)32 || c == (byte)9 || c == (byte)10 || c == (byte)13) i++;
            else break;
        }
        bool neg = false;
        byte sign = NativeMemory.At<byte>(s, i);
        if (sign == (byte)45) { neg = true; i++; }
        else if (sign == (byte)43) { i++; }
        long val = 0L;
        while (true) {
            byte c = NativeMemory.At<byte>(s, i);
            if (c < (byte)48 || c > (byte)57) break;
            val = val * 10L + (long)(c - (byte)48);
            i++;
        }
        return neg ? (int)(-val) : (int)val;
    }

    // ---- Stack C-string buffer builder (always NUL-terminates within cap) ----

    internal static ulong BufAppendChar(nint buf, ulong cap, ulong pos, byte ch) {
        if (cap == 0UL) return 0UL;
        if (pos + 1UL < cap) {
            NativeMemory.At<byte>(buf, (long)pos) = ch;
            pos++;
        }
        NativeMemory.At<byte>(buf, (long)pos) = (byte)0;
        return pos;
    }

    internal static ulong BufAppendBytes(nint buf, ulong cap, ulong pos, nint src, ulong len) {
        if (cap == 0UL || src == (nint)0 || len == 0UL) return pos;
        ulong avail = (pos + 1UL < cap) ? (cap - 1UL - pos) : 0UL;
        ulong n = (len < avail) ? len : avail;
        if (n > 0UL) {
            CMemcpy(buf + (nint)pos, src, n);
            pos += n;
        }
        NativeMemory.At<byte>(buf, (long)pos) = (byte)0;
        return pos;
    }

    internal static ulong BufAppendCStr(nint buf, ulong cap, ulong pos, nint s) {
        if (s == (nint)0) return pos;
        return BufAppendBytes(buf, cap, pos, s, CStrLen(s));
    }

    internal static ulong BufAppendU64(nint buf, ulong cap, ulong pos, ulong v) {
        Buf32 tmp = new Buf32();
        nint tp = NativeMemory.AddressOf(ref tmp);
        long k = 0L;
        if (v == 0UL) {
            NativeMemory.At<byte>(tp, 0L) = (byte)48;
            k = 1L;
        } else {
            while (v > 0UL) {
                NativeMemory.At<byte>(tp, k) = (byte)(48UL + (v % 10UL));
                v /= 10UL;
                k++;
            }
        }
        while (k > 0L) {
            k--;
            pos = BufAppendChar(buf, cap, pos, NativeMemory.At<byte>(tp, k));
        }
        return pos;
    }

    internal static ulong BufAppendI64(nint buf, ulong cap, ulong pos, long v) {
        if (v < 0L) {
            pos = BufAppendChar(buf, cap, pos, (byte)45);
            ulong uv = (ulong)(-(v + 1L)) + 1UL;
            return BufAppendU64(buf, cap, pos, uv);
        }
        return BufAppendU64(buf, cap, pos, (ulong)v);
    }

    internal static ulong BufAppendU64ZeroPad(nint buf, ulong cap, ulong pos, ulong v, int width) {
        Buf32 tmp = new Buf32();
        nint tp = NativeMemory.AddressOf(ref tmp);
        int k = 0;
        if (v == 0UL) {
            NativeMemory.At<byte>(tp, 0L) = (byte)48;
            k = 1;
        } else {
            while (v > 0UL) {
                NativeMemory.At<byte>(tp, (long)k) = (byte)(48UL + (v % 10UL));
                v /= 10UL;
                k++;
            }
        }
        while (k < width) {
            pos = BufAppendChar(buf, cap, pos, (byte)48);
            width--;
        }
        while (k > 0) {
            k--;
            pos = BufAppendChar(buf, cap, pos, NativeMemory.At<byte>(tp, (long)k));
        }
        return pos;
    }

    internal static ulong BufAppendHexPtr(nint buf, ulong cap, ulong pos, ulong v) {
        pos = BufAppendChar(buf, cap, pos, (byte)48);  // '0'
        pos = BufAppendChar(buf, cap, pos, (byte)120); // 'x'
        Buf32 tmp = new Buf32();
        nint tp = NativeMemory.AddressOf(ref tmp);
        int k = 0;
        if (v == 0UL) {
            NativeMemory.At<byte>(tp, 0L) = (byte)48;
            k = 1;
        } else {
            while (v > 0UL) {
                ulong d = v & 15UL;
                byte ch = (d < 10UL) ? (byte)(48UL + d) : (byte)(97UL + (d - 10UL));
                NativeMemory.At<byte>(tp, (long)k) = ch;
                v >>= 4;
                k++;
            }
        }
        while (k > 0) {
            k--;
            pos = BufAppendChar(buf, cap, pos, NativeMemory.At<byte>(tp, (long)k));
        }
        return pos;
    }

    internal static ulong BufAppendPaddedLeft(nint buf, ulong cap, ulong pos, nint s, int width) {
        ulong slen = CStrLen(s);
        pos = BufAppendBytes(buf, cap, pos, s, slen);
        int pad = width - (int)slen;
        while (pad > 0) {
            pos = BufAppendChar(buf, cap, pos, (byte)32);
            pad--;
        }
        return pos;
    }

    internal static ulong BufAppendPaddedRightU64(nint buf, ulong cap, ulong pos, ulong v, int width) {
        Buf32 num = new Buf32();
        nint np = NativeMemory.AddressOf(ref num);
        NativeMemory.At<byte>(np, 0L) = (byte)0;
        ulong nlen = BufAppendU64(np, 32UL, 0UL, v);
        int pad = width - (int)nlen;
        while (pad > 0) {
            pos = BufAppendChar(buf, cap, pos, (byte)32);
            pad--;
        }
        return BufAppendBytes(buf, cap, pos, np, nlen);
    }

    internal static ulong BufAppendPaddedRightCStr(nint buf, ulong cap, ulong pos, nint s, int width) {
        ulong slen = CStrLen(s);
        int pad = width - (int)slen;
        while (pad > 0) {
            pos = BufAppendChar(buf, cap, pos, (byte)32);
            pad--;
        }
        return BufAppendBytes(buf, cap, pos, s, slen);
    }

    // ---- B-ID98 OOM injection gate (rt_oom.h) ----

    const int OOM_MAX_SITES = 8;

    struct OomSite {
        public nint Site;
        public int Remaining;
        public int Pad;
    }

    struct OomTable {
        public OomSite S0; public OomSite S1; public OomSite S2; public OomSite S3;
        public OomSite S4; public OomSite S5; public OomSite S6; public OomSite S7;
    }

    static OomTable s_oomSites;
    static int s_oomSiteCount = -1;
    static int s_oomInitLock = 0;

    static void OomEnvParse() {
        nint e = CGetenv((nint)"ZAN_OOM_INJECT_SITE");
        int count = 0;
        if (e == (nint)0 || NativeMemory.At<byte>(e, 0L) == (byte)0) {
            Atomic.Store(ref s_oomSiteCount, 0, MemoryOrder.Release);
            return;
        }
        Buf256 buf = new Buf256();
        nint bp = NativeMemory.AddressOf(ref buf);
        ulong n = CStrLen(e);
        if (n >= 256UL) n = 255UL;
        CMemcpy(bp, e, n);
        NativeMemory.At<byte>(bp, (long)n) = (byte)0;

        nint sitesBase = NativeMemory.AddressOf(ref s_oomSites);
        long pos = 0L;
        while (NativeMemory.At<byte>(bp, pos) != (byte)0 && count < OOM_MAX_SITES) {
            while (NativeMemory.At<byte>(bp, pos) == (byte)44) pos++; // ','
            if (NativeMemory.At<byte>(bp, pos) == (byte)0) break;
            long segStart = pos;
            while (NativeMemory.At<byte>(bp, pos) != (byte)0 && NativeMemory.At<byte>(bp, pos) != (byte)44) pos++;
            if (NativeMemory.At<byte>(bp, pos) != (byte)0) {
                NativeMemory.At<byte>(bp, pos) = (byte)0;
                pos++;
            }
            nint seg = bp + (nint)segStart;
            nint colon = CStrChr(seg, (byte)58); // ':'
            int k = 1;
            if (colon != (nint)0) {
                NativeMemory.Write<byte>(colon, (byte)0);
                k = ParseAsciiInt(colon + (nint)1);
                if (k < 0) k = 0;
            }
            if (NativeMemory.At<byte>(seg, 0L) != (byte)0) {
                ulong slen = CStrLen(seg);
                nint copy = CMalloc(slen + 1UL);
                if (copy != (nint)0) {
                    CMemcpy(copy, seg, slen + 1UL);
                    nint slot = sitesBase + (nint)((long)count * 16L);
                    NativeMemory.Write<nint>(slot, copy);
                    NativeMemory.Write<int>(slot + (nint)8, k);
                    count++;
                }
            }
        }
        Atomic.Store(ref s_oomSiteCount, count, MemoryOrder.Release);
    }

    internal static bool OomHit(nint site) {
        int cnt = Atomic.Load(ref s_oomSiteCount, MemoryOrder.Acquire);
        if (cnt < 0) {
            SpinLockWord(NativeMemory.AddressOf(ref s_oomInitLock));
            if (Atomic.Load(ref s_oomSiteCount, MemoryOrder.Relaxed) < 0) {
                OomEnvParse();
            }
            SpinUnlockWord(NativeMemory.AddressOf(ref s_oomInitLock));
            cnt = Atomic.Load(ref s_oomSiteCount, MemoryOrder.Acquire);
        }
        if (cnt <= 0) return false;
        nint sitesBase = NativeMemory.AddressOf(ref s_oomSites);
        for (int i = 0; i < cnt; i++) {
            nint slot = sitesBase + (nint)((long)i * 16L);
            int rem = NativeMemory.Read<int>(slot + (nint)8);
            if (rem > 0 && CStrCmp(NativeMemory.Read<nint>(slot), site) == 0) {
                NativeMemory.Write<int>(slot + (nint)8, rem - 1);
                return true;
            }
        }
        return false;
    }

    internal static nint OomCalloc(nint site, ulong count, ulong sz) {
        if (OomHit(site)) return (nint)0;
        return CCalloc(count, sz);
    }

    // ---- 64-bit leading zero count (portable, zero asm) ----
    internal static int Clz64(ulong x) {
        if (x == 0UL) return 64;
        int n = 0;
        if ((x & 0xFFFFFFFF00000000UL) == 0UL) { n += 32; x <<= 32; }
        if ((x & 0xFFFF000000000000UL) == 0UL) { n += 16; x <<= 16; }
        if ((x & 0xFF00000000000000UL) == 0UL) { n += 8; x <<= 8; }
        if ((x & 0xF000000000000000UL) == 0UL) { n += 4; x <<= 4; }
        if ((x & 0xC000000000000000UL) == 0UL) { n += 2; x <<= 2; }
        if ((x & 0x8000000000000000UL) == 0UL) { n += 1; }
        return n;
    }
}
