    internal const long STR_HDR_SIZE = 12L;
    internal const long RC_OFF = -8L;
    internal const long HDR_WORD_OFF = -8L;
    internal const long STR_LEN_OFF = -12L;

    internal const uint OBJ_TW_MARK = 0x40000000U;
    internal const uint OBJ_TW_PAD16 = 0x20000000U;
    internal const uint OBJ_TW_SITE_MASK = 0x1FFFFFFFU;
    internal const ulong OBJ_STACK_FLAG = 0x8000000000000000UL;

    internal const ulong STRING_TAG = 0x5A414E53UL;      // "ZANS"
    internal const uint STR_LEN_UNKNOWN = 0x54524D47U;   // "TRMG"

    internal const ulong ARRAY_MAGIC = 0x5A414E4152524159UL;    // "ZANARRAY"
    internal const ulong ARRAY_RC_MAGIC = 0x5A414E41525243UL;   // "ZANARRC"
    internal const long ARR_HDR_SIZE = 32L;
    internal const long ARR_COUNT_OFF = -16L;
    internal const long ARR_RC_OFF = -32L;

    internal const long SOFT_ARR_SPAN = 4064L;
    internal const long SOFT_PREFIX_SIZE = 4128L; // 32 + 4064 + 32

    internal const ulong CLOSURE_TAG = 1UL;

    internal const ulong SIZE_MAX_U64 = 0xFFFFFFFFFFFFFFFFUL;
    internal const long LLONG_MAX_I64 = 0x7FFFFFFFFFFFFFFFL;
}

