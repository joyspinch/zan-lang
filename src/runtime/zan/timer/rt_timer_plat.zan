    internal static nint StdoutFile() => WinAcrtIobFunc(1U);
    internal static nint StderrFile() => WinAcrtIobFunc(2U);
    internal static nint ErrnoPtr() => WinErrnoPtr();

    internal static void MutexInit(nint m) {
        NativeMemory.Write<nint>(m, (nint)0);
    }
    internal static void MutexLock(nint m) { WinAcquireSrw(m); }
    internal static bool MutexTryLock(nint m) => WinTryAcquireSrw(m) != (byte)0;
    internal static void MutexUnlock(nint m) { WinReleaseSrw(m); }

    internal static ulong TimerSelfTid() => (ulong)WinGetCurrentThreadId();
