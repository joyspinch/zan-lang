// rt_timer_misc.zan: Async executor config, Clinger/Lemire fast IEEE-754 parse
// & shortest round-trip float/double formatting, allocation stats, weak slab
// fallbacks, and SipHash-1-3 salted dictionary key hashing.
// Replaces src/runtime/timer/rt_timer_misc.c in 100% pure Zan.

namespace Zan.Runtime.Timer;

static class RtTimerMisc {
    // ---- Async executor config ----
    static int s_cfgWorkers = 0;
    static int s_cfgIoShards = 0;
    static int s_cfgSyncFast = -1;

    [Export("zan_async_set_workers")]
    public static void AsyncSetWorkers(int n) {
        Atomic.Store(ref s_cfgWorkers, n > 0 ? n : 0, MemoryOrder.Release);
    }

    [Export("zan_async_set_io_shards")]
    public static void AsyncSetIoShards(int n) {
        Atomic.Store(ref s_cfgIoShards, n > 0 ? n : 0, MemoryOrder.Release);
    }

    [Export("zan_async_set_sync_fast")]
    public static void AsyncSetSyncFast(int on) {
        Atomic.Store(ref s_cfgSyncFast, on != 0 ? 1 : 0, MemoryOrder.Release);
    }

    [Export("zan_async_cfg_workers")]
    public static int AsyncCfgWorkers() => Atomic.Load(ref s_cfgWorkers, MemoryOrder.Acquire);

    [Export("zan_async_cfg_io_shards")]
    public static int AsyncCfgIoShards() => Atomic.Load(ref s_cfgIoShards, MemoryOrder.Acquire);

    [Export("zan_async_cfg_sync_fast")]
    public static int AsyncCfgSyncFast() => Atomic.Load(ref s_cfgSyncFast, MemoryOrder.Acquire);

    // ---- Heap allocation counters (A464) ----
    static long s_totalAllocBytes = 0L;

    [Export("zan_rt_alloc_add")]
    public static void AllocAdd(long bytes) {
        if (bytes <= 0L) return;
        RtTimerTask.AddThreadAllocBytes((ulong)bytes);
        Atomic.FetchAdd(ref s_totalAllocBytes, bytes, MemoryOrder.Relaxed);
    }

    [Export("zan_rt_alloc_bytes_thread")]
    public static long AllocBytesThread() => (long)RtTimerTask.GetThreadAllocBytes();

    [Export("zan_rt_alloc_bytes_total")]
    public static long AllocBytesTotal() => Atomic.Load(ref s_totalAllocBytes, MemoryOrder.Relaxed);

    // ---- Weak fallbacks for --no-fast-alloc builds ----
    [Export("zan_mem_slabs")]
    [Weak]
    public static ulong MemSlabs() => 0UL;

    [Export("zan_mem_trim")]
    [Weak]
    public static ulong MemTrim() => 0UL;

    // ---- SipHash-1-3 with OS entropy salt (B-ID80) ----
    static ulong s_hashSaltK0 = 0UL;
    static ulong s_hashSaltK1 = 0UL;
    static ulong s_hashSaltReady = 0UL;
    static int s_hashSaltLock = 0;

    static ulong Rotl64(ulong x, int b) => (x << b) | (x >> (64 - b));

    static ulong SipHash13(nint data, ulong len, ulong k0, ulong k1) {
        ulong v0 = k0 ^ 0x736F6D6570736575UL;
        ulong v1 = k1 ^ 0x646F72616E646F6DUL;
        ulong v2 = k0 ^ 0x6C7967656E657261UL;
        ulong v3 = k1 ^ 0x7465646279746573UL;

        nint p = data;
        ulong left = len;
        while (left >= 8UL) {
            ulong m = NativeMemory.Read<ulong>(p);
            v3 ^= m;
            // 1 compression round
            v0 += v1; v1 = Rotl64(v1, 13); v1 ^= v0; v0 = Rotl64(v0, 32);
            v2 += v3; v3 = Rotl64(v3, 16); v3 ^= v2;
            v0 += v3; v3 = Rotl64(v3, 21); v3 ^= v0;
            v2 += v1; v1 = Rotl64(v1, 17); v1 ^= v2; v2 = Rotl64(v2, 32);
            v0 ^= m;
            p += (nint)8;
            left -= 8UL;
        }

        ulong b = len << 56;
        if (left >= 7UL) b |= ((ulong)NativeMemory.At<byte>(p, 6L)) << 48;
        if (left >= 6UL) b |= ((ulong)NativeMemory.At<byte>(p, 5L)) << 40;
        if (left >= 5UL) b |= ((ulong)NativeMemory.At<byte>(p, 4L)) << 32;
        if (left >= 4UL) b |= ((ulong)NativeMemory.At<byte>(p, 3L)) << 24;
        if (left >= 3UL) b |= ((ulong)NativeMemory.At<byte>(p, 2L)) << 16;
        if (left >= 2UL) b |= ((ulong)NativeMemory.At<byte>(p, 1L)) << 8;
        if (left >= 1UL) b |= (ulong)NativeMemory.At<byte>(p, 0L);

        v3 ^= b;
        // 1 compression round
        v0 += v1; v1 = Rotl64(v1, 13); v1 ^= v0; v0 = Rotl64(v0, 32);
        v2 += v3; v3 = Rotl64(v3, 16); v3 ^= v2;
        v0 += v3; v3 = Rotl64(v3, 21); v3 ^= v0;
        v2 += v1; v1 = Rotl64(v1, 17); v1 ^= v2; v2 = Rotl64(v2, 32);
        v0 ^= b;

        v2 ^= 0xFFUL;
        // 3 finalization rounds
        for (int r = 0; r < 3; r++) {
            v0 += v1; v1 = Rotl64(v1, 13); v1 ^= v0; v0 = Rotl64(v0, 32);
            v2 += v3; v3 = Rotl64(v3, 16); v3 ^= v2;
            v0 += v3; v3 = Rotl64(v3, 21); v3 ^= v0;
            v2 += v1; v1 = Rotl64(v1, 17); v1 ^= v2; v2 = Rotl64(v2, 32);
        }
        return v0 ^ v1 ^ v2 ^ v3;
    }

    static ulong DictStrLenFast(nint s) {
        if ((((ulong)s) & 4080UL) != 0UL) {
            ulong hdr = NativeMemory.Read<ulong>(s + (nint)RtAbi.HDR_WORD_OFF);
            if ((hdr >> 32) == RtAbi.STRING_TAG) {
                uint cached = NativeMemory.Read<uint>(s + (nint)RtAbi.STR_LEN_OFF);
                if (cached != RtAbi.STR_LEN_UNKNOWN) return (ulong)cached;
            }
        }
        return RtPlat.CStrLen(s);
    }

    static void HashSaltFill() {
#if WINDOWS
        uint r0 = 0U;
        uint r1 = 0U;
        if (RtPlat.WinRandS(NativeMemory.AddressOf(ref r0)) == 0 &&
            RtPlat.WinRandS(NativeMemory.AddressOf(ref r1)) == 0) {
            s_hashSaltK0 = ((ulong)r0 << 32) | (ulong)r1;
            if (RtPlat.WinRandS(NativeMemory.AddressOf(ref r0)) == 0 &&
                RtPlat.WinRandS(NativeMemory.AddressOf(ref r1)) == 0) {
                s_hashSaltK1 = ((ulong)r0 << 32) | (ulong)r1;
            } else {
                s_hashSaltK1 = (ulong)NativeMemory.FunctionPointer(DictHash);
            }
            return;
        }
        long pc = 0L;
        RtPlat.WinQueryPerformanceCounter(NativeMemory.AddressOf(ref pc));
        s_hashSaltK0 = (ulong)pc ^ (((ulong)NativeMemory.AddressOf(ref pc)) << 17);
        s_hashSaltK1 = (ulong)NativeMemory.FunctionPointer(DictHash) ^ (((ulong)RtPlat.WinGetCurrentProcessId()) << 32);
#elif MACOS
        Buf32 keys = new Buf32();
        nint kp = NativeMemory.AddressOf(ref keys);
        RtPlat.MacArc4RandomBuf(kp, 16UL);
        s_hashSaltK0 = NativeMemory.Read<ulong>(kp);
        s_hashSaltK1 = NativeMemory.Read<ulong>(kp + (nint)8);
#else
        Buf32 keys = new Buf32();
        nint kp = NativeMemory.AddressOf(ref keys);
        nint fnSys = NativeMemory.FunctionPointer(RtPlat.PosixSyscall);
        long gotSys = NativeMemory.InvokeVariadic<long>(fnSys, 1, RtPlat.SYS_GETRANDOM, kp, 16UL, 0UL);
        if (gotSys == 16L) {
            s_hashSaltK0 = NativeMemory.Read<ulong>(kp);
            s_hashSaltK1 = NativeMemory.Read<ulong>(kp + (nint)8);
            return;
        }
        nint f = RtPlat.CFopen((nint)"/dev/urandom", (nint)"rb");
        if (f != (nint)0) {
            ulong got = RtPlat.CFread(kp, 1UL, 16UL, f);
            RtPlat.CFclose(f);
            if (got == 16UL) {
                s_hashSaltK0 = NativeMemory.Read<ulong>(kp);
                s_hashSaltK1 = NativeMemory.Read<ulong>(kp + (nint)8);
                return;
            }
        }
        Buf32 ts = new Buf32();
        nint tp = NativeMemory.AddressOf(ref ts);
        RtPlat.PosixClockGettime(RtPlat.CLOCK_MONOTONIC, tp);
        long nsec = NativeMemory.Read<long>(tp + (nint)8);
        s_hashSaltK0 = (((ulong)nsec) << 32) ^ (ulong)kp;
        s_hashSaltK1 = (((ulong)RtPlat.PosixGetpid()) << 47) ^ (ulong)NativeMemory.FunctionPointer(DictHash);
#endif
    }

    static void HashSaltInitSlow() {
        RtPlat.SpinLockWord(NativeMemory.AddressOf(ref s_hashSaltLock));
        if (Atomic.Load(ref s_hashSaltReady, MemoryOrder.Relaxed) == 0UL) {
            HashSaltFill();
            Atomic.Store(ref s_hashSaltReady, 1UL, MemoryOrder.Release);
        }
        RtPlat.SpinUnlockWord(NativeMemory.AddressOf(ref s_hashSaltLock));
    }

    [Export("__zan_dict_hash")]
    public static long DictHash(nint key, long isStr) {
        if (key == (nint)0) return 0L;
        if (Atomic.Load(ref s_hashSaltReady, MemoryOrder.Acquire) == 0UL) {
            HashSaltInitSlow();
        }
        ulong k0 = s_hashSaltK0;
        ulong k1 = s_hashSaltK1;
        if (isStr != 0L) {
            return (long)SipHash13(key, DictStrLenFast(key), k0, k1);
        }
        nint kv = key;
        return (long)SipHash13(NativeMemory.AddressOf(ref kv), 8UL, k0, k1);
    }
}
