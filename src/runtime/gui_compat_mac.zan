namespace Gui.Backend;

using System;

public class zan_gui {
    static long s_seq = 1L;

    [DllImport("zan_gui", EntryPoint = "zan_gui_font_height")]
    static extern int zan_gui_font_height(int fontSize);

    [DllImport("zan_gui", EntryPoint = "zan_gui_draw_text")]
    static extern void zan_gui_draw_text(int surfaceId, int x, int y, string text, int color, int fontSize);

    [DllImport("zan_gui", EntryPoint = "zan_gui_draw_polyline")]
    static extern void zan_gui_draw_polyline(int surfaceId, nint pts, int n, int color, int thickness);

    [DllImport("zan_gui", EntryPoint = "zan_gui_inject_event")]
    static extern int zan_gui_inject_event(nint hwnd, int kind, int x, int y, int button, int keycode, int mods);

    [DllImport("zan_gui", EntryPoint = "zan_gui_wake")]
    static extern int zan_gui_wake();

    public static long event_seq() {
        long r = s_seq;
        s_seq = s_seq + 1L;
        return r;
    }

    public static int event_flag() {
        return 0;
    }

    public static void present_full() {
    }

    public static int font_ascent(int fontSize) {
        if (fontSize <= 0) { return 0; }
        int h = zan_gui_font_height(fontSize);
        if (h <= 0) { h = fontSize; }
        return (h * 4 + 2) / 5;
    }

    public static void draw_text_bold(int surfaceId, int x, int y, string text, int color, int fontSize) {
        zan_gui_draw_text(surfaceId, x, y, text, color, fontSize);
    }

    public static void draw_polybatch(int surfaceId, nint pts, nint counts, int nPaths, int color, int thickness) {
        if (pts == (nint)0 || counts == (nint)0 || nPaths < 1) { return; }
        Span<int> cntSpan = new Span<int>(counts, nPaths);
        int off = 0;
        for (int p = 0; p < nPaths; p = p + 1) {
            int n = cntSpan[p];
            if (n >= 2) {
                nint ptsOff = pts + (nint)(off * 4);
                zan_gui_draw_polyline(surfaceId, ptsOff, n, color, thickness);
            }
            off = off + n * 2;
        }
    }
}

class ZanGuiCompatMacApp {
    public static void Main() {
    }
}
