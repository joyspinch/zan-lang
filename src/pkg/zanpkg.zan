using System;
using System.Diagnostics;

namespace Pkg;

/// The Zan package manager CLI.
///
///   zanpkg init [name]              Create a new project
///   zanpkg add <name> <source>      Add a dependency
///   zanpkg remove <name>            Remove a dependency
///   zanpkg build [--publish]        Build the project
///   zanpkg publish                  Build an optimized release binary
///   zanpkg info                     Show package info
///
/// The manifest is read with a deliberately small hand-rolled reader rather
/// than the compiler's package.c, so the tool does not drag in the compiler
/// (and LLVM) just to learn an entry point and a list of source directories.
class Program {
    static bool Windows() {
#if WINDOWS
        return true;
#else
        return false;
#endif
    }

    static string Sep() {
        if (Program.Windows()) { return "\\"; }
        return "/";
    }

    static string TrimLeft(string s) {
        int i = 0;
        while (i < s.Length) {
            string ch = s.Substring(i, 1);
            if (ch != " " && ch != "\t") { break; }
            i = i + 1;
        }
        return s.Substring(i, s.Length - i);
    }

    static string Trim(string s) {
        s = Program.TrimLeft(s);
        int n = s.Length;
        while (n > 0) {
            string ch = s.Substring(n - 1, 1);
            if (ch != " " && ch != "\t" && ch != "\r") { break; }
            n = n - 1;
        }
        return s.Substring(0, n);
    }

    /// The text inside the first pair of double quotes, or "" when the line
    /// has no opening quote.
    static string Quoted(string s) {
        int open = s.IndexOf("\"");
        if (open < 0) { return ""; }
        string rest = s.Substring(open + 1, s.Length - open - 1);
        int close = rest.IndexOf("\"");
        if (close < 0) { return rest; }
        return rest.Substring(0, close);
    }

    static List<string> ManifestLines() {
        if (!File.Exists("zan.pkg")) { return new List<string>(); }
        return File.ReadAllText("zan.pkg").Replace("\r\n", "\n").Split("\n");
    }

    static void CmdInit(List<string> args) {
        string name = "myproject";
        if (args.Count > 0) { name = args[0]; }

        if (File.Exists("zan.pkg")) {
            Console.WriteLine("error: zan.pkg already exists");
            return;
        }

        StringBuilder m = new StringBuilder();
        m.Append("# Zan Package Manifest\n");
        m.Append($"name = \"{name}\"\n");
        m.Append("version = \"0.1.0\"\n");
        m.Append("description = \"\"\n");
        m.Append("author = \"\"\n");
        m.Append("license = \"MIT\"\n");
        m.Append("entry = \"src/Program.zan\"\n");
        m.Append("\n");
        m.Append("[sources]\n");
        m.Append("\"src\"\n");
        m.Append("\n");
        m.Append("[dependencies]\n");
        m.Append("# name = \"source@version\"\n");
        File.WriteAllText("zan.pkg", m.ToString());

        Directory.CreateDirectory("src");
        string entry = $"src{Program.Sep()}Program.zan";
        if (!File.Exists(entry)) {
            StringBuilder p = new StringBuilder();
            p.Append("using System;\n\n");
            p.Append("class Program {\n");
            p.Append("    static void Main() {\n");
            p.Append($"        Console.WriteLine(\"Hello from {name}!\");\n");
            p.Append("    }\n");
            p.Append("}\n");
            File.WriteAllText(entry, p.ToString());
        }

        Console.WriteLine($"Created zan.pkg for '{name}'");
        Console.WriteLine("  src/Program.zan  (entry point)");
        Console.WriteLine("");
        Console.WriteLine("Run 'zanpkg build' to compile.");
    }

    static void CmdAdd(List<string> args) {
        if (args.Count < 2) {
            Console.WriteLine("usage: zanpkg add <name> <source[@version]>");
            return;
        }
        if (!File.Exists("zan.pkg")) {
            Console.WriteLine("error: no zan.pkg found. Run 'zanpkg init' first.");
            return;
        }
        string name = args[0];
        string source = args[1];
        File.AppendAllText("zan.pkg", $"{name} = \"{source}\"\n");
        Console.WriteLine($"Added dependency: {name} = \"{source}\"");
    }

    static void CmdRemove(List<string> args) {
        if (args.Count < 1) {
            Console.WriteLine("usage: zanpkg remove <name>");
            return;
        }
        if (!File.Exists("zan.pkg")) {
            Console.WriteLine("error: no zan.pkg found.");
            return;
        }
        string name = args[0];
        List<string> lines = Program.ManifestLines();
        StringBuilder kept = new StringBuilder();
        bool removed = false;
        int i = 0;
        // A trailing newline yields an empty final element that is the end of
        // the last line, not a line of its own.
        int count = lines.Count;
        if (count > 0 && lines[count - 1] == "") { count = count - 1; }
        while (i < count) {
            string line = lines[i];
            i = i + 1;
            if (line.StartsWith($"{name} ") || line.StartsWith($"{name}=")) {
                removed = true;
                continue;
            }
            kept.Append(line);
            kept.Append("\n");
        }
        File.WriteAllText("zan.pkg", kept.ToString());

        if (removed) { Console.WriteLine($"Removed dependency: {name}"); }
        else { Console.WriteLine($"Dependency '{name}' not found in zan.pkg"); }
    }

    /// Every .zan file under `dir`, recursively, skipping dotted entries.
    /// Directory.ListNames takes a glob and answers newline-joined names.
    static void CollectZan(string dir, List<string> files) {
        if (!Directory.Exists(dir)) { return; }
        List<string> names = Directory.ListNames($"{dir}{Program.Sep()}*").Split("\n");
        int i = 0;
        while (i < names.Count) {
            string name = names[i];
            i = i + 1;
            if (name == "" || name.StartsWith(".")) { continue; }
            string path = $"{dir}{Program.Sep()}{name}";
            if (Directory.Exists(path)) {
                Program.CollectZan(path, files);
            } else if (name.EndsWith(".zan")) {
                files.Add(path);
            }
        }
    }

    static void CmdBuild(List<string> args) {
        if (!File.Exists("zan.pkg")) {
            Console.WriteLine("error: no zan.pkg found. Run 'zanpkg init' first.");
            return;
        }

        string entry = "src/Program.zan";
        string name = "output";
        List<string> sourceDirs = new List<string>();
        bool inSources = false;

        List<string> lines = Program.ManifestLines();
        int i = 0;
        while (i < lines.Count) {
            string line = Program.TrimLeft(lines[i]);
            i = i + 1;
            if (line == "" || line.StartsWith("#")) { continue; }
            if (line.StartsWith("[")) {
                inSources = line.StartsWith("[sources]");
                continue;
            }
            if (inSources) {
                string dir = Program.Quoted(line);
                if (dir != "") { sourceDirs.Add(dir); }
                continue;
            }
            int eq = line.IndexOf("=");
            if (eq < 0) { continue; }
            string key = Program.Trim(line.Substring(0, eq));
            string val = Program.Trim(line.Substring(eq + 1, line.Length - eq - 1));
            string quoted = Program.Quoted(val);
            if (quoted != "") { val = quoted; }
            if (key == "entry") { entry = val; }
            if (key == "name") { name = val; }
        }

        List<string> files = new List<string>();
        if (sourceDirs.Count == 0) {
            Program.CollectZan("src", files);
        } else {
            int d = 0;
            while (d < sourceDirs.Count) {
                Program.CollectZan(sourceDirs[d], files);
                d = d + 1;
            }
        }
        if (files.Count == 0) { files.Add(entry); }

        StringBuilder cmd = new StringBuilder();
        if (Program.Windows()) { cmd.Append("zanc.exe --auto-stdlib"); }
        else { cmd.Append("zanc --auto-stdlib"); }
        int f = 0;
        while (f < files.Count) {
            cmd.Append($" \"{files[f]}\"");
            f = f + 1;
        }

        bool publish = false;
        int a = 0;
        while (a < args.Count) {
            if (args[a] == "--publish") { publish = true; }
            a = a + 1;
        }
        if (publish) { cmd.Append(" --publish"); }

        Directory.CreateDirectory("build");
        if (Program.Windows()) { cmd.Append($" -o build\\{name}.exe"); }
        else { cmd.Append($" -o build/{name}"); }

        Console.WriteLine($"Building {name} ({files.Count} files)...");
        int rc = Process.Run(cmd.ToString());
        if (rc == 0) { Console.WriteLine("Build successful!"); }
        else { Console.WriteLine($"Build failed (exit code {rc})"); }
    }

    static void CmdInfo() {
        if (!File.Exists("zan.pkg")) {
            Console.WriteLine("No zan.pkg found in current directory.");
            return;
        }
        Console.WriteLine("Package info:");
        List<string> lines = Program.ManifestLines();
        int i = 0;
        int count = lines.Count;
        if (count > 0 && lines[count - 1] == "") { count = count - 1; }
        while (i < count) {
            string line = Program.TrimLeft(lines[i]);
            i = i + 1;
            if (line == "" || line.StartsWith("#")) { continue; }
            Console.WriteLine($"  {line}");
        }
    }

    static void PrintUsage() {
        Console.WriteLine("Zan Package Manager (zanpkg)");
        Console.WriteLine("");
        Console.WriteLine("Usage:");
        Console.WriteLine("  zanpkg init [name]              Create a new project");
        Console.WriteLine("  zanpkg add <name> <source>      Add a dependency");
        Console.WriteLine("  zanpkg remove <name>            Remove a dependency");
        Console.WriteLine("  zanpkg build [--publish]        Build the project");
        Console.WriteLine("  zanpkg info                     Show package info");
        Console.WriteLine("  zanpkg help                     Show this help");
    }

    static int Main() {
        if (Environment.ArgCount() == 0) {
            Program.PrintUsage();
            return 0;
        }

        string command = Environment.ArgAt(0);
        List<string> args = new List<string>();
        int i = 1;
        while (i < Environment.ArgCount()) {
            args.Add(Environment.ArgAt(i));
            i = i + 1;
        }

        if (command == "init") { Program.CmdInit(args); }
        else if (command == "add") { Program.CmdAdd(args); }
        else if (command == "remove") { Program.CmdRemove(args); }
        else if (command == "build") { Program.CmdBuild(args); }
        else if (command == "publish") {
            List<string> publishArgs = new List<string>();
            publishArgs.Add("--publish");
            Program.CmdBuild(publishArgs);
        }
        else if (command == "info") { Program.CmdInfo(); }
        else if (command == "help" || command == "--help") { Program.PrintUsage(); }
        else {
            Console.WriteLine($"Unknown command: {command}");
            Program.PrintUsage();
            return 1;
        }
        return 0;
    }
}
