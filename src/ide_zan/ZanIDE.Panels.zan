using System;
using System.IO;
using System.Diagnostics;
using System.Json;
using Gui;
using Gui.Widget;
using Gui.Component;
using Game.Scene;

// ---- AI profile / chat-completion entities -------------------------------
// The OpenAI-compatible /chat/completions request body is declared as classes
// and serialized with Json.Serialize<T>. `limits` and `max_tokens` stay
// JsonValue because they are optional: null serializes to JSON null, which
// compatible endpoints treat as "unset" exactly like the old conditional
// field. ai_profiles.json stays JsonValue too: its "base" key is a reserved
// word in Zan (no DTO field can carry that name without changing the format).

class AiChatMsgDoc {
    string role;
    string content;
}

class AiStreamOptionsDoc {
    bool include_usage;
}

class AiChatBodyDoc {
    string model;
    bool stream;
    AiStreamOptionsDoc stream_options;
    List<AiChatMsgDoc> messages;
    JsonValue max_tokens;   // set only when the enabled model has a cap
}

/// ZanIDE part: settings persistence, the parsed error list, the AI
/// assistant plumbing (profiles / requests / chat transcripts), the git
/// panel and integrated-terminal helpers.
partial class ZanIDE {
    // ================================================================
    // Settings persistence (window + panel sizes)
    // ================================================================

    static string CfgPath() { return ZanIDE.UserConfigDir() + "/config.cfg"; }

    static bool IsDigit(string ch) {
        return ch == "0" || ch == "1" || ch == "2" || ch == "3" || ch == "4"
            || ch == "5" || ch == "6" || ch == "7" || ch == "8" || ch == "9";
    }

    /// Finds the first index of `sub` in `s`, or -1.
    static int StrFind(string s, string sub) {
        if (sub.Length == 0) { return 0; }
        if (sub.Length > s.Length) { return -1; }
        int n = s.Length - sub.Length;
        for (int i = 0; i <= n; i = i + 1) {
            if (s.Substring(i, sub.Length) == sub) { return i; }
        }
        return -1;
    }

    /// The file name portion of a path (after the last '/' or '\').
    static string BaseName(string p) {
        int best = -1;
        for (int i = 0; i < p.Length; i = i + 1) {
            string ch = p.Substring(i, 1);
            if (ch == "/" || ch == "\\") { best = i; }
        }
        if (best >= 0 && best + 1 <= p.Length) { return p.Substring(best + 1, p.Length - best - 1); }
        return p;
    }

    /// Reads an integer "key=NNN" from a settings blob, or `def` when absent.
    static int CfgInt(string cfg, string key, int def) {
        int idx = ZanIDE.StrFind(cfg, key + "=");
        if (idx < 0) { return def; }
        int p = idx + key.Length + 1;
        string num = "";
        while (p < cfg.Length) {
            string ch = cfg.Substring(p, 1);
            if (ZanIDE.IsDigit(ch)) { num = num + ch; p = p + 1; } else { break; }
        }
        if (num.Length == 0) { return def; }
        return ZanIDE.ParseInt(num);
    }

    /// A string setting from the ";"-separated config text (up to the next ";").
    static string CfgStr(string cfg, string key, string def) {
        int idx = ZanIDE.StrFind(cfg, key + "=");
        if (idx < 0) { return def; }
        int p = idx + key.Length + 1;
        string val = "";
        while (p < cfg.Length) {
            string ch = cfg.Substring(p, 1);
            if (ch == ";") { break; }
            val = val + ch;
            p = p + 1;
        }
        return val;
    }

    /// Clamps a restored dimension into a sane range.
    static int CfgClamp(int v, int lo, int hi) {
        if (v < lo) { return lo; }
        if (v > hi) { return hi; }
        return v;
    }

    /// Window/panel sizes and app preferences. Which panels are open, where
    /// they are docked and which tab of a group is active live in dock.cfg
    /// (DockHost.SaveLayout), not here. `skin` is the pack NAME: indices shift
    /// whenever a skin folder is added or removed, so they are never persisted.
    static void SaveSettings(int treeW, int botH, int winW, int winH, int autoRun, string skin, int rightW, int opacity, string wallpaper, int wallOpacity) {
        string s = "treeW=" + Convert.ToString(treeW)
            + ";bottomH=" + Convert.ToString(botH)
            + ";winW=" + Convert.ToString(winW)
            + ";winH=" + Convert.ToString(winH)
            + ";autoRun=" + Convert.ToString(autoRun)
            + ";skin=" + skin
            + ";rightW=" + Convert.ToString(rightW)
            + ";opacity=" + Convert.ToString(opacity)
            + ";wallOpacity=" + Convert.ToString(wallOpacity)
            + ";wallpaper=" + wallpaper + ";";
        Directory.CreateDirectoryRecursive(ZanIDE.UserConfigDir());
        File.WriteAllText(ZanIDE.CfgPath(), s);
    }

    /// Index of the open tab whose file name matches `base`, or -1.
    static int FindTabByBase(List<TabRecord> tabs, string bn) {
        for (int i = 0; i < tabs.Count; i = i + 1) {
            if (ZanIDE.BaseName(tabs[i].path) == bn) { return i; }
        }
        return -1;
    }

    // ================================================================
    // Error list (parsed from build/run output) + tabbed bottom panel
    // ================================================================

    /// Scans the log for compiler/linker diagnostics of the form
    /// `...<file>.zan:<line>[:col]: ... message`.
    static void ParseErrorList(List<string> log, List<DiagnosticRecord> records) {
        for (int i = 0; i < log.Count; i = i + 1) {
            string ln = log[i];
            int idx = ZanIDE.StrFind(ln, ".zan:");
            if (idx >= 0) {
                // path: from first non-prefix char up to and including ".zan"
                int ps = 0;
                while (ps < ln.Length) {
                    string pc = ln.Substring(ps, 1);
                    if (pc == " " || pc == ">" || pc == "\t") { ps = ps + 1; } else { break; }
                }
                string path = ln.Substring(ps, (idx + 4) - ps);
                int p = idx + 5;
                string num = "";
                while (p < ln.Length) {
                    string ch = ln.Substring(p, 1);
                    if (ZanIDE.IsDigit(ch)) { num = num + ch; p = p + 1; } else { break; }
                }
                if (num.Length > 0) {
                    string msg = ln;
                    int me = ZanIDE.StrFind(ln, "error");
                    if (me < 0) { me = ZanIDE.StrFind(ln, "warning"); }
                    if (me >= 0) { msg = ln.Substring(me, ln.Length - me); }
                    records.Add(new DiagnosticRecord(path, num, msg));
                }
            }
        }
    }

    static string DiagnosticName(string msg) {
        int first = ZanIDE.StrFind(msg, "'");
        if (first < 0) { return ""; }
        int rest = first + 1;
        int secondRel = ZanIDE.StrFind(
            msg.Substring(rest, msg.Length - rest), "'");
        if (secondRel < 0) { return ""; }
        return msg.Substring(rest, secondRel);
    }

    static string SuggestedUsing(string msg) {
        string name = ZanIDE.DiagnosticName(msg);
        string widgets = "|Avatar|Badge|Breadcrumb|Button|Card|Carousel|Chart|"
            + "Checkbox|CodeEditor|Collapse|DataTable|Dialog|Divider|Drawer|Dropdown|"
            + "Ellipsis|Empty|FilePicker|FloatButton|Input|Label|ListView|"
            + "Menu|Message|Modal|Notification|PageHeader|Pagination|Panel|PivotTable|"
            + "Popconfirm|Popover|Progress|Radio|Rate|Result|Ribbon|Scrollbar|"
            + "Skeleton|Slider|Spin|Split|Statistic|Steps|Switch|Table|Tabs|"
            + "Tag|Timeline|Tooltip|TreeView|Typography|Wizard|";
        string gui = "|App|Canvas|Theme|Window|Rect|Color|SignalBool|SignalInt|"
            + "SignalString|HitRegion|TreeNode|Icon|Clipboard|Ui|Stack|Text|Point|"
            + "Size|FlexStyle|FocusManager|";
        string io = "|File|Directory|Path|";
        string system = "|Console|Convert|List|StringBuilder|";
        string text = "|Encoding|";
        string threading = "|Thread|Mutex|Semaphore|Stopwatch|Channel|AtomicInt|";
        string http = "|HttpClient|HttpRequest|HttpResponse|HttpServer|HttpRouter|";
        string sockets = "|Socket|TcpClient|UdpClient|TcpListener|AsyncSocket|";
        string net = "|Dns|IPAddress|";
        string json = "|JsonParser|JsonBuilder|";
        string drawing = "|Graphics|Bitmap|Font|Rectangle|";
        string crypto = "|Sha1|Sha256|Sha512|Md5|Hmac|Aes|AesGcm|Rsa|Base64|Hex|"
            + "RandomNumberGenerator|BigInt|";
        string data = "|DbConnection|DbResult|";
        if (name != "" && ZanIDE.Has(widgets, "|" + name + "|")) {
            return "Gui.Widget";
        }
        if (name != "" && ZanIDE.Has(gui, "|" + name + "|")) {
            return "Gui";
        }
        if (name != "" && ZanIDE.Has(io, "|" + name + "|")) {
            return "System.IO";
        }
        if (name != "" && ZanIDE.Has(system, "|" + name + "|")) {
            return "System";
        }
        if (name != "" && ZanIDE.Has(text, "|" + name + "|")) {
            return "System.Text";
        }
        if (name != "" && ZanIDE.Has(threading, "|" + name + "|")) {
            return "System.Threading";
        }
        if (name != "" && ZanIDE.Has(http, "|" + name + "|")) {
            return "System.Net.Http";
        }
        if (name != "" && ZanIDE.Has(sockets, "|" + name + "|")) {
            return "System.Net.Sockets";
        }
        if (name != "" && ZanIDE.Has(net, "|" + name + "|")) {
            return "System.Net";
        }
        if (name != "" && ZanIDE.Has(json, "|" + name + "|")) {
            return "System.Json";
        }
        if (name != "" && ZanIDE.Has(drawing, "|" + name + "|")) {
            return "System.Drawing";
        }
        if (name != "" && ZanIDE.Has(crypto, "|" + name + "|")) {
            return "System.Security.Cryptography";
        }
        if (name != "" && ZanIDE.Has(data, "|" + name + "|")) {
            return "System.Data";
        }
        if (name == "Process") { return "System.Diagnostics"; }
        return "";
    }

    static void AddUsing(
        CodeEditor editor,
        List<string> bodies,
        SignalInt active,
        string importNs,
        List<string> log
    ) {
        string line = "using " + importNs + ";";
        string text = editor.GetText();
        if (ZanIDE.Has(text, line)) {
            log.Add("> " + line + " is already present.");
            return;
        }
        text = line + "\n" + text;
        editor.LoadText(text);
        int a = active.Get();
        if (a >= 0 && a < bodies.Count) { bodies[a] = text; }
        editor.SetCompilerDiagnostics(new List<Diagnostic>());
        log.Add("> Added " + line);
    }

    /// The Output panel's "Clear" button rect, right-aligned in the tab strip.
    /// Shared by the renderer (draw) and the caller (hit-test) so they agree.
    static Rect OutClearRect(App app, Rect orr) {
        int tabH = app.theme.heightMedium;
        int bw = app.Scale(52);
        int bh = tabH - app.Scale(8);
        int bx = orr.x + orr.width - bw - app.Scale(8);
        int by = orr.y + app.Scale(4);
        return new Rect(bx, by, bw, bh);
    }

    /// The Output panel's filter box rect, left of the Clear button.
    static Rect OutFilterRect(App app, Rect orr) {
        int tabH = app.theme.heightMedium;
        Rect cb = ZanIDE.OutClearRect(app, orr);
        int fw = app.Scale(160);
        int fh = tabH - app.Scale(8);
        int fx = cb.x - fw - app.Scale(6);
        int fy = orr.y + app.Scale(4);
        return new Rect(fx, fy, fw, fh);
    }

    // ================================================================
    // Right side panel: AI assistant + integrated terminal
    // ================================================================

    /// Optional AI settings file (`key = value` lines: key / base / model).
    /// Environment variables OPENAI_API_KEY / OPENAI_BASE_URL / OPENAI_MODEL
    /// are the fallback so the panel works with a plain OpenAI-compatible setup.
    static string AiCfgPath() { return ZanIDE.UserConfigDir() + "/ai.cfg"; }

    /// Abandons the request in flight: the panel stops reading its sink, so
    /// a worker that is still streaming (a stop pressed mid-answer, a request
    /// superseded by the next question) can never land a late chunk or a late
    /// error in the next answer.
    static void AiCancelRequest() {
        AiNet.Abandon();
    }

    static void DeleteIfExists(string path) {
        if (File.Exists(path)) { File.Delete(path); }
    }

    /// Reads `key = value` from `content` (same line format as zan.proj).
    static string KvField(string content, string key) {
        List<string> ls = CodeEditor.SplitLines(content);
        for (int i = 0; i < ls.Count; i = i + 1) {
            string tr = ZanIDE.TrimLeadSpaces(ls[i]);
            if (tr.Length >= key.Length && tr.Substring(0, key.Length) == key) {
                string rest = ZanIDE.TrimLeadSpaces(tr.Substring(key.Length, tr.Length - key.Length));
                if (rest.Length > 0 && rest.Substring(0, 1) == "=") {
                    string val = ZanIDE.TrimLeadSpaces(rest.Substring(1, rest.Length - 1));
                    int e = val.Length;
                    while (e > 0) {
                        string ch = val.Substring(e - 1, 1);
                        if (ch == " " || ch == "\t" || ch == "\r" || ch == "\n") { e = e - 1; }
                        else { break; }
                    }
                    return val.Substring(0, e);
                }
            }
        }
        return "";
    }

    /// An AI setting: ai.cfg first, then the environment, then `def`.
    static string AiSetting(string key, string envName, string def) {
        if (File.Exists(ZanIDE.AiCfgPath())) {
            string v = ZanIDE.KvField(File.ReadAllText(ZanIDE.AiCfgPath()), key);
            if (v != "") { return v; }
        }
        string e = getenv(envName);
        if (e != null && e != "") { return e; }
        return def;
    }

    // ---- AI provider profiles (ai_profiles.json) ----
    // {"active": 0, "profiles": [{"name", "base", "key", "model",
    //   "models": [], "limits": {"<model id>": {"ctx": 128000, "out": 4096}},
    //   "roles": {"<role id>": "<model id>"}}]}
    // `roles` maps a team member to the model it runs on under this provider;
    // an absent member falls back to "model".
    // `limits` holds each model's configured context length and maximum output
    // length (both in tokens); a missing / zero entry means "use the default".
    static string AiProfilesPath() { return ZanIDE.UserConfigDir() + "/ai_profiles.json"; }
    static string AiModelsRespPath() { return ZanIDE.WindowCacheDir() + "/ai_models.json"; }
    static string AiModelsDonePath() { return ZanIDE.WindowCacheDir() + "/ai_models_done.txt"; }

    /// Loads AI provider profiles and returns the active index. Falls back to a
    /// single profile synthesized from legacy ai.cfg / environment settings.
    static int AiProfilesLoad(List<AiProfile> profiles) {
        int active = 0;
        if (File.Exists(ZanIDE.AiProfilesPath())) {
            JsonValue v = JsonValue.ParseLenient(File.ReadAllText(ZanIDE.AiProfilesPath()));
            if (v != null) {
                active = v.Int("active", 0);
                JsonValue ps = v.Get("profiles");
                if (ps != null && ps.IsArray()) {
                    for (int i = 0; i < ps.Count(); i = i + 1) {
                        JsonValue p = ps.At(i);
                        string modelList = "";
                        JsonValue ms = p.Get("models");
                        if (ms != null && ms.IsArray()) {
                            for (int j = 0; j < ms.Count(); j = j + 1) {
                                string mid = ms.At(j).AsString("");
                                if (mid != "") {
                                    if (modelList != "") { modelList = modelList + ";"; }
                                    modelList = modelList + mid;
                                }
                            }
                        }
                        string limitMap = "{}";
                        JsonValue lim = p.Get("limits");
                        if (lim != null && lim.IsObject()) { limitMap = lim.ToJson(); }
                        string roleMap = "{}";
                        JsonValue rls = p.Get("roles");
                        if (rls != null && rls.IsObject()) { roleMap = rls.ToJson(); }
                        AiProfile loaded = AiProfile.Create(
                            p.Str("name", "AI " + Convert.ToString(i + 1)),
                            p.Str("base", ""), p.Str("key", ""),
                            p.Str("model", ""), modelList, limitMap);
                        loaded.roles = roleMap;
                        profiles.Add(loaded);
                    }
                }
            }
        }
        if (profiles.Count == 0) {
            profiles.Add(AiProfile.Create(ZanIDE.T("Default", "默认"),
                ZanIDE.AiSetting("base", "OPENAI_BASE_URL", "https://api.openai.com/v1"),
                ZanIDE.AiSetting("key", "OPENAI_API_KEY", ""),
                ZanIDE.AiSetting("model", "OPENAI_MODEL", "gpt-4o-mini"), "", "{}"));
            active = 0;
        }
        if (active < 0 || active >= profiles.Count) { active = 0; }
        return active;
    }

    static void AiProfilesSave(int active, List<AiProfile> profiles) {
        JsonValue arr = JsonValue.NewArray();
        for (int i = 0; i < profiles.Count; i = i + 1) {
            AiProfile profile = profiles[i];
            JsonValue o = JsonValue.NewObject();
            o.Put("name", JsonValue.NewStr(profile.name));
            o.Put("base", JsonValue.NewStr(profile.baseUrl));
            o.Put("key", JsonValue.NewStr(profile.key));
            o.Put("model", JsonValue.NewStr(profile.model));
            JsonValue ms = JsonValue.NewArray();
            List<string> models = ZanIDE.SplitList(profile.models);
            for (int j = 0; j < models.Count; j = j + 1) {
                ms.Append(JsonValue.NewStr(models[j]));
            }
            o.Put("models", ms);
            string limitMap = profile.limits;
            if (limitMap == "") { limitMap = "{}"; }
            JsonValue lm = JsonValue.ParseLenient(limitMap);
            if (lm == null) { lm = JsonValue.NewObject(); }
            o.Put("limits", lm);
            string roleMap = profile.roles;
            if (roleMap == "") { roleMap = "{}"; }
            JsonValue rm = JsonValue.ParseLenient(roleMap);
            if (rm == null) { rm = JsonValue.NewObject(); }
            o.Put("roles", rm);
            arr.Append(o);
        }
        JsonValue root = JsonValue.NewObject();
        root.Put("active", JsonValue.NewNum(Convert.ToString(active)));
        root.Put("profiles", arr);
        Directory.CreateDirectoryRecursive(ZanIDE.UserConfigDir());
        File.WriteAllText(ZanIDE.AiProfilesPath(), root.ToJson());
    }

    /// Parses a run of leading digits into an int (ignores anything else); the
    /// per-model limit inputs are free text, so a stray unit / space is fine.
    static int ParseIntSafe(string s) {
        int n = 0;
        bool any = false;
        for (int i = 0; i < s.Length; i = i + 1) {
            int d = ZanIDE.IndexOfStr("0123456789", s.Substring(i, 1));
            if (d >= 0) {
                n = n * 10 + d;
                any = true;
            } else if (any) {
                break;
            }
        }
        return n;
    }

    /// Reads a per-model limit (`ctx` / `out`, in tokens) from a profile's
    /// `limits` JSON map; 0 when absent.
    static int AiLimitInt(string mapJson, string model, string field) {
        if (mapJson == "" || model == "") { return 0; }
        JsonValue v = JsonValue.ParseLenient(mapJson);
        if (v == null || !v.IsObject()) { return 0; }
        JsonValue mo = v.Get(model);
        if (mo == null || !mo.IsObject()) { return 0; }
        return mo.Int(field, 0);
    }

    /// The limit as editable text ("" when unset), for the settings inputs.
    static string AiLimitStr(string mapJson, string model, string field) {
        int n = ZanIDE.AiLimitInt(mapJson, model, field);
        if (n <= 0) { return ""; }
        return Convert.ToString(n);
    }

    /// Returns `mapJson` with `field` for `model` set to the parsed value (0 =
    /// unset). Creates the map / model object as needed.
    static string AiLimitSet(string mapJson, string model, string field, string val) {
        if (model == "") { return mapJson; }
        JsonValue v = JsonValue.ParseLenient(mapJson);
        if (v == null || !v.IsObject()) { v = JsonValue.NewObject(); }
        JsonValue mo = v.Get(model);
        if (mo == null || !mo.IsObject()) {
            mo = JsonValue.NewObject();
            v.Set(model, mo);
        }
        int n = ZanIDE.ParseIntSafe(val);
        mo.Set(field, JsonValue.NewNum(Convert.ToString(n)));
        return v.ToJson();
    }

    /// The model a team member runs on under this provider ("" when it has
    /// none configured and should use the provider's default model).
    static string AiRoleModel(string mapJson, string roleId) {
        if (mapJson == "" || roleId == "") { return ""; }
        JsonValue v = JsonValue.ParseLenient(mapJson);
        if (v == null || !v.IsObject()) { return ""; }
        return v.Str(roleId, "");
    }

    /// Returns `mapJson` with `roleId` bound to `model` (blank clears it, so a
    /// member can be put back on the provider's default).
    static string AiRoleModelSet(string mapJson, string roleId, string model) {
        if (roleId == "") { return mapJson; }
        JsonValue v = JsonValue.ParseLenient(mapJson);
        if (v == null || !v.IsObject()) { v = JsonValue.NewObject(); }
        v.Set(roleId, JsonValue.NewStr(model));
        return v.ToJson();
    }

    /// Splits a `;`-separated list, skipping empty entries.
    static List<string> SplitList(string s) {
        List<string> outp = new List<string>();
        string cur = "";
        for (int i = 0; i < s.Length; i = i + 1) {
            string ch = s.Substring(i, 1);
            if (ch == ";") {
                if (cur != "") { outp.Add(cur); }
                cur = "";
            } else {
                cur = cur + ch;
            }
        }
        if (cur != "") { outp.Add(cur); }
        return outp;
    }

    /// Launches a detached `GET {base}/models` request. The response and its
    /// done-marker land in the user config dir and are polled by the UI.
    /// Returns "" on success or a user-facing error message.
    static string AiFetchModels(string baseUrl, string key) {
        if (key == "") {
            return ZanIDE.T("Set the API key first.", "请先填写 API 密钥。");
        }
        if (baseUrl == "") { baseUrl = "https://api.openai.com/v1"; }
        ZanIDE.EnsureCacheDir();
        if (File.Exists(ZanIDE.AiModelsRespPath())) { File.Delete(ZanIDE.AiModelsRespPath()); }
        if (File.Exists(ZanIDE.AiModelsDonePath())) { File.Delete(ZanIDE.AiModelsDonePath()); }
        string cmd = "curl -s --max-time 60 \"" + baseUrl + "/models\""
            + " -H \"Authorization: Bearer " + key + "\""
            + " -o \"" + ZanIDE.AiModelsRespPath() + "\"";
        #if WINDOWS
        Process.RunDetached("(" + cmd + ") & echo ok > \"" + ZanIDE.AiModelsDonePath() + "\"");
        #else
        Process.RunDetached("(" + cmd + ") ; echo ok > \"" + ZanIDE.AiModelsDonePath() + "\"");
        #endif
        return "";
    }

    /// Parses the /models response into a `;`-joined id list ("" on failure).
    static string AiReadModels() {
        if (!File.Exists(ZanIDE.AiModelsRespPath())) { return ""; }
        string raw = File.ReadAllText(ZanIDE.AiModelsRespPath());
        if (raw == "") { return ""; }
        JsonValue v = JsonValue.ParseLenient(raw);
        if (v == null) { return ""; }
        JsonValue data = v.Get("data");
        string outp = "";
        if (data != null && data.IsArray()) {
            for (int i = 0; i < data.Count(); i = i + 1) {
                string id = data.At(i).Str("id", "");
                if (id != "") {
                    if (outp != "") { outp = outp + ";"; }
                    outp = outp + id;
                }
            }
        }
        return outp;
    }

    /// Strips a surrounding ``` fence (with optional language tag) from `s`,
    /// and returns "" for error replies so they are never inserted as code.
    static string AiStripFence(string s) {
        if (s.Length >= 7 && s.Substring(0, 7) == "[error]") { return ""; }
        string r = s;
        if (r.Length >= 3 && r.Substring(0, 3) == "```") {
            int nl = 0;
            for (; nl < r.Length && r.Substring(nl, 1) != "\n"; nl = nl + 1) { }
            if (nl < r.Length) { r = r.Substring(nl + 1, r.Length - nl - 1); }
            else { r = ""; }
            int endF = r.Length - 1;
            for (endF = r.Length - 1; endF >= 0 && (r.Substring(endF, 1) == "\n" || r.Substring(endF, 1) == " "); endF = endF - 1) {
            }
            if (endF >= 2 && r.Substring(endF - 2, 3) == "```") {
                r = r.Substring(0, endF - 2);
            }
        }
        return r;
    }

    /// Writes the chat transcript as an OpenAI-compatible /chat/completions
    /// request and launches curl DETACHED (response + done-marker files are
    /// polled from the event loop, so the UI stays responsive). Returns "" on
    /// success or a user-facing error message.
    /// The content of the last ``` fenced code block in the newest assistant
    /// reply, or "" when there is none.
    static string AiLastCode(List<AiChatMsg> msgs) {
        for (int i = msgs.Count - 1; i >= 0; i = i - 1) {
            if (msgs[i].role == "assistant") {
                string s = msgs[i].text;
                int a = ZanIDE.IndexOfStr(s, "```");
                if (a < 0) { return ""; }
                int ls = a + 3;
                while (ls < s.Length && s.Substring(ls, 1) != "\n") { ls = ls + 1; }
                ls = ls + 1;
                if (ls >= s.Length) { return ""; }
                string rest = s.Substring(ls, s.Length - ls);
                int b = ZanIDE.IndexOfStr(rest, "```");
                if (b <= 0) { return ""; }
                return rest.Substring(0, b);
            }
        }
        return "";
    }

    static string AiLaunch(List<AiChatMsg> msgs,
            string ctxName, string ctxCode, string projRoot,
            string baseUrl, string key, string model) {
        return ZanIDE.AiLaunchAs("", msgs, ctxName, ctxCode, projRoot,
            baseUrl, key, model);
    }

    /// As AiLaunch, but speaking as team member `agent` ("" = the single
    /// assistant). The member's charter replaces the shared system prompt and
    /// it only sees its OWN context, which is what keeps six members from
    /// turning into one confused one reading everybody's tool output.
    static string AiLaunchAs(string agent, List<AiChatMsg> msgs,
            string ctxName, string ctxCode, string projRoot,
            string baseUrl, string key, string model) {
        if (key == "") {
            return ZanIDE.T(
                "No API key. Open the AI panel's Config editor and fill in the key for the enabled profile.",
                "未配置 API 密钥。请在小赞面板的“配置”中为启用的配置填写密钥。");
        }
        if (baseUrl == "") { baseUrl = "https://api.openai.com/v1"; }
        // A team member runs on its own model when the enabled provider has one
        // configured for it: the reviewer can be a strong reasoner while the
        // scribe work stays on a cheap fast model. Every launch resolves it
        // again, so an automatic handoff switches models with the speaker.
        if (agent != "") {
            string roleModel = AiTeam.ModelOf(agent);
            if (roleModel != "") { model = roleModel; }
        }
        if (model == "") { model = "gpt-4o-mini"; }
        // stream_options.include_usage: OpenAI-compatible endpoints only put
        // the token counts in the final chunk of a stream when asked, and the
        // usage card is only honest when they arrive.
        AiChatBodyDoc body = new AiChatBodyDoc();
        body.model = model;
        body.stream = true;
        body.stream_options = new AiStreamOptionsDoc();
        body.stream_options.include_usage = true;
        body.messages = new List<AiChatMsgDoc>();
        // The standing instructions, the tool protocol, the open file and the
        // RepoMap outline all come from the agent layer, so the loop that runs
        // the tools and the prompt that describes them can never drift apart.
        string sysMsg = AiAgent.SystemPrompt(ctxName, ctxCode, projRoot);
        if (agent != "") {
            sysMsg = AiTeam.RolePrompt(agent, ctxName, ctxCode, projRoot);
        }
        AiChatMsgDoc sys = new AiChatMsgDoc();
        sys.role = "system";
        sys.content = sysMsg;
        body.messages.Add(sys);
        // Fold the oldest turns into a digest once the transcript passes the
        // budget, so a long agent session keeps working instead of growing
        // until it overflows the model's context window.
        List<AiChatMsg> src = msgs;
        if (agent != "") { src = AiTeam.ContextFor(agent, msgs); }
        AiMessages msgs2 = AiAgent.BuildContext(src);
        for (int i = 0; i < msgs2.msgs.Count; i = i + 1) {
            // Tool results go back as user turns: every OpenAI-compatible
            // endpoint accepts that, including local models with no notion of
            // a tool role.
            string role = msgs2.msgs[i].role;
            if (role == "tool") { role = "user"; }
            if (role == "user" || role == "assistant") {
                AiChatMsgDoc m = new AiChatMsgDoc();
                m.role = role;
                m.content = msgs2.msgs[i].text;
                body.messages.Add(m);
            }
        }
        // Apply the enabled model's configured maximum output length.
        int maxOut = AiAgent.MaxOutTokens();
        if (maxOut > 0) {
            body.max_tokens = JsonValue.NewNum(Convert.ToString(maxOut));
        }
        // The request is made with the Net standard library on a worker
        // thread that streams the decoded response into an in-memory sink;
        // the panel reads the sink each frame for incremental output.
        // Certificate verification stays on (the platform trust store is
        // bridged into OpenSSL by the Tls layer).
        string serr = AiNet.Start(baseUrl, "/chat/completions", key,
            Json.Serialize<AiChatBodyDoc>(body), 600000, true);
        // Counted here, at the one place every request (question, tool result,
        // retry, continue) actually goes out, so the usage panel can never
        // drift from what was really sent.
        if (serr == "") { ZanIDE.aiStatReqs = ZanIDE.aiStatReqs + 1; }
        return serr;
    }

    // ---- AI usage accounting ----
    // Totals for the running IDE session, shown broken out in the context
    // gauge's panel: every request that left the IDE, every one that came back
    // as an error, and the token counts the provider reported for the ones
    // that succeeded. Cached prompt tokens are a subset of the input tokens.
    static int aiStatReqs;
    static int aiStatFails;
    static int aiStatPrompt;
    static int aiStatCompletion;
    static int aiStatCached;
    static int aiStatTotal;
    /// Replies that carried a usage object, so the panel can say "no data"
    /// instead of showing zeros for a provider that reports none.
    static int aiStatUsageReplies;

    /// Folds one finished reply's usage into the running totals.
    static void AiStatAdd(SseAnswer a) {
        if (a.promptTokens <= 0 && a.completionTokens <= 0
            && a.totalTokens <= 0) { return; }
        ZanIDE.aiStatUsageReplies = ZanIDE.aiStatUsageReplies + 1;
        ZanIDE.aiStatPrompt = ZanIDE.aiStatPrompt + a.promptTokens;
        ZanIDE.aiStatCompletion = ZanIDE.aiStatCompletion + a.completionTokens;
        ZanIDE.aiStatCached = ZanIDE.aiStatCached + a.cachedTokens;
        int tot = a.totalTokens;
        if (tot <= 0) { tot = a.promptTokens + a.completionTokens; }
        ZanIDE.aiStatTotal = ZanIDE.aiStatTotal + tot;
    }

    /// Extracts the assistant reply (or a readable error) out of a saved
    /// non-streaming response body.
    static string AiReadAnswerFrom(string path) {
        if (!File.Exists(path)) {
            return ZanIDE.T("[error] No response received (network problem?).",
                "[错误] 未收到响应（网络问题？）。");
        }
        string raw = File.ReadAllText(path);
        if (raw == "") {
            return ZanIDE.T("[error] Empty response from the AI endpoint.",
                "[错误] AI 服务返回为空。");
        }
        JsonValue v = JsonValue.ParseLenient(raw);
        JsonValue ch = v.Get("choices");
        if (ch != null && ch.IsArray() && ch.Count() > 0) {
            JsonValue msg = ch.At(0).Get("message");
            if (msg != null) { return msg.Str("content", ""); }
        }
        JsonValue err = v.Get("error");
        if (err != null) { return "[error] " + err.Str("message", raw); }
        if (raw.Length > 400) { raw = raw.Substring(0, 400) + "..."; }
        return "[error] " + raw;
    }

    /// Runs a shell command in the project root, appending its output to the
    /// terminal history (capped so the transcript can't grow without bound).
    static string TermLogPath() { return ZanIDE.WindowCacheDir() + "/term_session.log"; }

    /// Starts the persistent interactive shell session rooted at the project
    /// directory. The session's stdin is the returned pipe; stdout/stderr
    /// stream into the session log file, which the UI polls each frame.
    static nint TermOpen(string root) {
        ZanIDE.EnsureCacheDir();
        File.WriteAllText(ZanIDE.TermLogPath(), "");
        #if WINDOWS
        string cmd = "cmd /q /k cd /d \"" + root + "\" >>\"" + ZanIDE.TermLogPath() + "\" 2>&1";
        #else
        string cmd = "cd \"" + root + "\" && exec sh >>\"" + ZanIDE.TermLogPath() + "\" 2>&1";
        #endif
        return Process.ShellOpen(cmd);
    }

    /// Appends any new complete lines from the given log file to `outLog`.
    /// Returns the new consumed length (only whole lines are consumed, so a
    /// partially-written line is picked up on a later poll).
    ///
    /// Reads only the bytes past `consumed` (seek, not a full-file re-read), so
    /// a chatty program's output cannot make polling O(total) and grind the UI
    /// to a halt. A runaway log is trimmed at 8 MB: the counter resets to 0 and
    /// everything after the trim is genuinely new output. Never throws: a file
    /// race with the writer is swallowed and polling continues next frame.
    static int PollLogFile(string path, int consumed, List<string> outLog) {
        if (!File.Exists(path)) { return consumed; }
        FileStream fs = null;
        try {
            fs = FileStream.OpenRead(path);
            long total = fs.Length();
            if (total > 8388608) {
                fs.Close();
                fs = null;
                File.WriteAllText(path, "");
                return 0;
            }
            if (consumed > total) { consumed = 0; }
            if (consumed >= total) { fs.Close(); return consumed; }
            int want = (int)(total - consumed);
            if (want > 1048576) { want = 1048576; }
            fs.SeekTo(consumed);
            string chunk = fs.Read(want);
            fs.Close();
            fs = null;
            if (chunk.Length == 0) { return consumed; }
            // Consume up to the last newline only (partial line waits).
            int last = 0 - 1;
            for (int i = chunk.Length - 1; i >= 0; i = i - 1) {
                if (chunk.Substring(i, 1) == "\n") { last = i; i = 0 - 1; }
            }
            if (last < 0) { return consumed; }
            List<string> nl = CodeEditor.SplitLines(chunk.Substring(0, last + 1));
            for (int k = 0; k < nl.Count; k = k + 1) {
                if (!(k == nl.Count - 1 && nl[k] == "")) { outLog.Add(nl[k]); }
            }
            while (outLog.Count > 2000) { outLog.RemoveAt(0); }
            return consumed + last + 1;
        } catch (Exception e) {
            if (fs != null) { fs.Close(); }
            return consumed;
        }
    }

    /// Appends any new complete lines from the terminal session log to the
    /// terminal view.
    static int TermPoll(int consumed, List<string> termLog) {
        return ZanIDE.PollLogFile(ZanIDE.TermLogPath(), consumed, termLog);
    }

    /// Log file that a launched console program's output is mirrored into so
    /// the IDE Output tab can show it alongside the real console window.
    static string RunLogPath() { return ZanIDE.WindowCacheDir() + "/run_output.log"; }

    /// Marker file written once the launched console program has exited. The
    /// main loop watches it to stop streaming (and lift the 4 fps throttle)
    /// when the program finishes instead of polling a dead log forever.
    static string RunDonePath() { return ZanIDE.WindowCacheDir() + "/run_done.marker"; }

    /// Launches a console executable in its own visible console window while
    /// teeing its combined stdout/stderr into RunLogPath. The program's output
    /// therefore appears in the real console (which also keeps a live stdin so
    /// Console.ReadLine works) and, mirrored, in the IDE Output tab. Truncates
    /// the mirror log first; the caller resets its consumed counter to 0.
    /// Starts in `cwd` (the project root) so the program's relative paths work.
    /// Writes RunDonePath once the program exits so the IDE stops streaming.
    static void RunConsole(string exe, string cwd) {
        ZanIDE.EnsureCacheDir();
        File.WriteAllText(ZanIDE.RunLogPath(), "");
        if (File.Exists(ZanIDE.RunDonePath())) { File.Delete(ZanIDE.RunDonePath()); }
        #if WINDOWS
        // Echo each line to the host (so the console window shows it) and append
        // it to the mirror log as UTF-8 without BOM (Tee-Object/Out-File default
        // to UTF-16 on Windows PowerShell, which the log reader cannot decode).
        // The marker is written AFTER the pipeline completes (i.e. the program
        // exited); -NoExit keeps the console window open for reading the output.
        string ps = "$e=New-Object System.Text.UTF8Encoding $false; & '" + exe
            + "' 2>&1 | %{ $_; [IO.File]::AppendAllText('" + ZanIDE.RunLogPath()
            + "',($_ -as [string])+[Environment]::NewLine,$e) }; [IO.File]::WriteAllText('"
            + ZanIDE.RunDonePath() + "','1')";
        Process.RunDetached("cmd /c start \"Zan Run\" /D \"" + ZanIDE.ToWinPath(cwd)
            + "\" powershell -NoProfile -ExecutionPolicy Bypass -NoExit -Command \"" + ps + "\"");
        #else
        Process.RunDetached("sh -c 'cd \"" + cwd + "\" && \"" + exe
            + "\" 2>&1 | tee \"" + ZanIDE.RunLogPath()
            + "\"; echo 1 > \"" + ZanIDE.RunDonePath() + "\"' &");
        #endif
    }

    /// Appends any new mirrored console-program output lines to `outLog`.
    static int RunPoll(int consumed, List<string> outLog) {
        return ZanIDE.PollLogFile(ZanIDE.RunLogPath(), consumed, outLog);
    }

    /// Launches `exe` detached with the Gui UiDriver armed: `ZAN_UI_SCRIPT`
    /// points at the model's driver script and `ZAN_UI_OUT` at the directory
    /// the driver writes its results.log / hit-region dumps into. `donePath` is
    /// touched once the program exits so the AI ui_check poll knows the driven
    /// session finished without blocking the IDE. Starts in `cwd` so the
    /// program's relative asset paths resolve as they do for a normal run.
    static void LaunchUnderUiDriver(string exe, string cwd, string scriptPath,
                                    string outDir, string donePath) {
        if (File.Exists(donePath)) { File.Delete(donePath); }
        #if WINDOWS
        Process.RunDetached("cmd /c \"cd /d \"" + ZanIDE.ToWinPath(cwd)
            + "\"&set ZAN_UI_SCRIPT=" + ZanIDE.ToWinPath(scriptPath)
            + "&set ZAN_UI_OUT=" + ZanIDE.ToWinPath(outDir)
            + "&\"" + exe + "\"&echo ok>\"" + ZanIDE.ToWinPath(donePath) + "\"\"");
        #else
        Process.RunDetached("sh -c 'cd \"" + cwd + "\" && ZAN_UI_SCRIPT=\""
            + scriptPath + "\" ZAN_UI_OUT=\"" + outDir + "\" \"" + exe
            + "\" >/dev/null 2>&1 ; echo ok > \"" + donePath + "\"'");
        #endif
    }

    // ================================================================
    // Git panel helpers (right panel "Git" tab)
    // ================================================================

    /// The project's uncommitted changes as a unified diff, for the `diff`
    /// tool. Runs synchronously: unlike `status` on a huge repository, a diff of
    /// the working tree is small and quick, and the assistant loop is already
    /// waiting on the result. Capped so one large refactor cannot flood the
    /// model's context, and it says so when it truncates.
    static string AiDiffResult(string root) {
        List<string> lines = Process.RunCapture("git -C \"" + root
            + "\" --no-pager diff --stat HEAD");
        List<string> body = Process.RunCapture("git -C \"" + root
            + "\" --no-pager diff HEAD");
        StringBuilder sb = new StringBuilder();
        if (body.Count == 0 && lines.Count == 0) {
            return "diff: no output (is this a git repository?).";
        }
        bool empty = true;
        for (int i = 0; i < body.Count; i = i + 1) {
            if (AiAgent.Trim(body[i]) != "") { empty = false; }
        }
        if (empty) {
            return "diff: the working tree is clean (nothing to review).";
        }
        sb.Append("--- changed files ---\n");
        for (int i = 0; i < lines.Count; i = i + 1) {
            sb.Append(lines[i] + "\n");
        }
        sb.Append("--- unified diff ---\n");
        int budget = 12000;
        int used = 0;
        bool cut = false;
        for (int i = 0; i < body.Count; i = i + 1) {
            if (used + body[i].Length > budget) { cut = true; }
            if (cut) { i = body.Count; } else {
                sb.Append(body[i] + "\n");
                used = used + body[i].Length + 1;
            }
        }
        if (cut) {
            sb.Append("...(diff truncated; read the remaining files directly)\n");
        }
        return sb.ToString();
    }

    /// The last run's captured output for the `run_errors` tool. The IDE already
    /// tees a console run's combined stdout/stderr into RunLogPath, so a failure
    /// (an exception, an assert, a crash trace) is on disk and does not have to
    /// be guessed at from the exit status. Returns the tail, which is where a
    /// failure lands.
    static string AiRunErrorsResult() {
        string lp = ZanIDE.RunLogPath();
        if (!File.Exists(lp)) {
            return "run_errors: nothing has been run yet in this session"
                + " (call run or ui_check first).";
        }
        string txt = File.ReadAllText(lp);
        if (AiAgent.Trim(txt) == "") {
            return "run_errors: the last run produced no output"
                + " (it may still be running, or it was a GUI launch whose"
                + " output is not captured).";
        }
        if (txt.Length > 8000) {
            txt = "...(earlier output omitted)\n"
                + txt.Substring(txt.Length - 8000, 8000);
        }
        return "--- last run output (stdout+stderr, tail) ---\n" + txt;
    }

    static string GitLogPath() { return ZanIDE.WindowCacheDir() + "/git_job.log"; }
    static string GitDonePath() { return ZanIDE.WindowCacheDir() + "/git_job_done.txt"; }

    /// Marker line separating the two commands of a refresh job's output.
    static string GitRefreshMark() { return "--zan-git-branch--"; }

    /// Starts `git -C root <args>` detached: its combined output lands in
    /// GitLogPath and GitDonePath appears once it exits. On a large repository
    /// even `status` takes seconds, so the caller polls GitJobDone() from the
    /// frame loop instead of blocking the UI for the duration.
    static void GitBegin(string root, string args) {
        ZanIDE.GitBeginRaw("git -C \"" + root + "\" " + args);
    }

    /// Starts one detached shell command as the current git job.
    static void GitBeginRaw(string cmd) {
        ZanIDE.EnsureCacheDir();
        File.WriteAllText(ZanIDE.GitLogPath(), "");
        if (File.Exists(ZanIDE.GitDonePath())) { File.Delete(ZanIDE.GitDonePath()); }
        #if WINDOWS
        string sep = " & ";
        #else
        string sep = " ; ";
        #endif
        Process.RunDetached("((" + cmd + ") >> \"" + ZanIDE.GitLogPath() + "\" 2>&1)"
            + sep + "echo ok > \"" + ZanIDE.GitDonePath() + "\"");
    }

    /// Starts a status + branch scan as one job, the two outputs separated by
    /// GitRefreshMark() so GitRefreshApply can tell them apart.
    static void GitRefreshBegin(string root) {
        #if WINDOWS
        string sep = " & ";
        #else
        string sep = " ; ";
        #endif
        string g = "git -C \"" + root + "\" ";
        ZanIDE.GitBeginRaw(g + "status --porcelain" + sep
            + "echo " + ZanIDE.GitRefreshMark() + sep
            + g + "rev-parse --abbrev-ref HEAD");
    }

    /// True when the running git job has finished.
    static bool GitJobDone() { return File.Exists(ZanIDE.GitDonePath()); }

    /// Consumes a finished job's output lines and clears its marker.
    static List<string> GitJobTake() {
        List<string> lines = new List<string>();
        if (File.Exists(ZanIDE.GitLogPath())) {
            lines = CodeEditor.SplitLines(File.ReadAllText(ZanIDE.GitLogPath()));
        }
        if (File.Exists(ZanIDE.GitDonePath())) { File.Delete(ZanIDE.GitDonePath()); }
        return lines;
    }

    /// Refills `files` with the porcelain lines of a finished refresh job and
    /// returns the branch name that followed the marker ("" when unknown).
    static string GitRefreshApply(List<string> out2, List<string> files) {
        while (files.Count > 0) { files.RemoveAt(files.Count - 1); }
        string branch = "";
        bool afterMark = false;
        for (int i = 0; i < out2.Count; i = i + 1) {
            string line = out2[i];
            if (ZanIDE.TrimTail(line) == ZanIDE.GitRefreshMark()) {
                afterMark = true;
            } else if (afterMark) {
                if (branch == "" && line != "") { branch = ZanIDE.TrimTail(line); }
            } else if (line != "") {
                files.Add(line);
            }
        }
        return branch;
    }

    /// Drops trailing spaces (echo on cmd.exe keeps the space before `&`).
    static string TrimTail(string s) {
        int end = s.Length;
        while (end > 0 && s.Substring(end - 1, 1) == " ") { end = end - 1; }
        return s.Substring(0, end);
    }

    /// The path part of a porcelain status line ("XY path" or "XY a -> b",
    /// where the rename target is the interesting path).
    static string GitPathOf(string line) {
        if (line.Length < 4) { return ""; }
        string p = line.Substring(3, line.Length - 3);
        int arrow = ZanIDE.IndexOfStr(p, " -> ");
        if (arrow >= 0) { p = p.Substring(arrow + 4, p.Length - arrow - 4); }
        if (p.Length >= 2 && p.Substring(0, 1) == "\"") {
            p = p.Substring(1, p.Length - 2);
        }
        return p;
    }

    /// Row color for a porcelain status line: green when fully staged,
    /// red for untracked, orange for modified/partially staged.
    static int GitStatusColor(Theme t, string line) {
        if (line.Length < 2) { return t.textSecondary; }
        string x = line.Substring(0, 1);
        string y = line.Substring(1, 1);
        if (x == "?") { return t.error; }
        if (y == " ") { return t.success; }
        return t.warning;
    }

    /// Opening a changed file from the git panel: the list hands back the
    /// porcelain line it is bound to, which carries the path.
    static void GitFileActivated() {
        ZanIDE ide = ZanIDE.current;
        if (ide == null || !ide.gitList.HasSelection()) { return; }
        string gp = ide.root + "/" + ZanIDE.GitPathOf(ide.gitList.Selected());
        if (!File.Exists(gp)) { return; }
        ZanIDE.OpenPath(ide.tabs, ide.activeTab, gp, Path.GetFileName(gp));
        ide.lastActive = 0 - 1;
    }

    // ================================================================
    // Sidebar tree handlers. Every tree reports what the user did; the
    // handler reads the node it is about off the tree, so no panel walks a
    // filtered list by index or tracks the previous selection.
    // ================================================================

    /// A project-tree pick opens the file it names.
    static void ExplorerPicked() {
        ZanIDE ide = ZanIDE.current;
        if (ide == null || !ide.explorerTv.HasSelection()) { return; }
        TreeNode node = ide.explorerTv.Selected();
        if (node.isDir || node.path == "") { return; }
        ZanIDE.OpenPath(ide.tabs, ide.activeTab, node.path, node.label);
        ide.log.Add("> Opened " + node.path + ".");
    }

    static void ExplorerContext() {
        ZanIDE ide = ZanIDE.current;
        if (ide == null) { return; }
        ide.ctxKind = 1;
        ide.ctxX = ide.explorerTv.ContextX();
        ide.ctxY = ide.explorerTv.ContextY();
        ide.ctxTarget = ide.explorerTv.ContextRow();
    }

    /// An outline pick navigates: a symbol jumps the editor to its line, a
    /// component selects that control in the form / scene designer.
    static void StructurePicked() {
        ZanIDE ide = ZanIDE.current;
        if (ide == null || !ide.structTv.HasSelection()) { return; }
        int ci = ZanIDE.OutlineLineOf(ide.structTv.Selected().path);
        if (ci < 0) { return; }
        if (ide.designerMode) {
            List<FormField> flat = new List<FormField>();
            ZanIDE.FlattenFields(ide.formDesigner.fields, flat);
            if (ci < flat.Count) { ide.formDesigner.sel = flat[ci]; }
        } else if (ide.sceneMode) {
            List<SceneElement> ord = ide.sceneDesigner.OrderedByZ();
            if (ci < ord.Count) {
                ide.sceneDesigner.sel = ord[ci];
                ide.sceneDesigner.selExtra = new List<SceneElement>();
            }
        } else {
            ide.pendingGotoLine = ci;
            ide.pendingGotoCol = 0;
        }
    }

    /// A stdlib/examples pick opens the example source, or the built-in
    /// component center for the "@ex:" pseudo-leaf.
    static void ExamplePicked() {
        ZanIDE ide = ZanIDE.current;
        if (ide == null || !ide.stdlibTv.HasSelection()) { return; }
        TreeNode en = ide.stdlibTv.Selected();
        if (en.isDir || en.path == "") { return; }
        if (ZanIDE.StartsWith(en.path, "@ex:")) {
            int di = ZanIDE.FindTabByPath(ide.tabs, "@docs");
            if (di >= 0) {
                ide.activeTab.Set(di);
            } else {
                ide.tabs.Add(TabRecord.Create(ZanIDE.T("Components", "组件中心"), "", "@docs"));
                ide.activeTab.Set(ide.tabs.Count - 1);
            }
            ide.lastActive = 0 - 1;
            ide.log.Add("> Opened the GUI component center.");
            return;
        }
        ZanIDE.OpenPath(ide.tabs, ide.activeTab, en.path, en.label);
        ide.log.Add("> Opened " + en.path + ".");
    }

    static void StdlibContext() {
        ZanIDE ide = ZanIDE.current;
        if (ide == null) { return; }
        ide.ctxKind = 2;
        ide.ctxX = ide.stdlibTv.ContextX();
        ide.ctxY = ide.stdlibTv.ContextY();
        ide.ctxTarget = ide.stdlibTv.ContextRow();
    }

    /// Double-clicking a tool builds and runs it through the same DETACHED
    /// pipeline as the Run ribbon: compiling a tool takes as long as any other
    /// program and must not freeze the UI.
    static void ToolActivated() {
        ZanIDE ide = ZanIDE.current;
        if (ide == null || !ide.toolsTv.HasSelection()) { return; }
        TreeNode n = ide.toolsTv.Selected();
        if (n.isDir || n.path == "" || ZanIDE.StartsWith(n.path, "@")) { return; }
        if (ide.buildBusy) {
            Layer.Msg(ZanIDE.T("Build already running…", "构建进行中…"), 2);
            return;
        }
        string target = ZanIDE.RunTarget(n.path, ide.root);
        if (target == "") { return; }
        ide.log.Add(ZanIDE.T("> Running tool ", "> 运行工具 ") + n.path + " ...");
        ide.buildBusy = true;
        ide.buildThenRun = true;
        ide.buildExe = ZanIDE.RunBuildBegin(ide.root, target);
        ide.buildIsGui = ZanIDE.IsWindowedTarget(ide.root, target);
        ide.buildTargetPath = n.path;
        ide.buildLogLen = 0;
        ide.dock.Focus("output");
    }

    static void ToolContext() {
        ZanIDE ide = ZanIDE.current;
        if (ide == null) { return; }
        ide.rtCtxShow = ide.toolsTv.Nodes();
        ide.ctxKind = 4;
        ide.ctxX = ide.toolsTv.ContextX();
        ide.ctxY = ide.toolsTv.ContextY();
        ide.ctxTarget = ide.toolsTv.ContextRow();
    }

    /// Double-clicking an example opens its source in the editor.
    static void ExampleActivated() {
        ZanIDE ide = ZanIDE.current;
        if (ide == null || !ide.examplesTv.HasSelection()) { return; }
        TreeNode n = ide.examplesTv.Selected();
        if (n.isDir || n.path == "" || ZanIDE.StartsWith(n.path, "@")) { return; }
        ZanIDE.OpenPath(ide.tabs, ide.activeTab, n.path, n.label);
        ide.log.Add("> Opened " + n.path + ".");
    }

    static void ExampleContext() {
        ZanIDE ide = ZanIDE.current;
        if (ide == null) { return; }
        ide.rtCtxShow = ide.examplesTv.Nodes();
        ide.ctxKind = 5;
        ide.ctxX = ide.examplesTv.ContextX();
        ide.ctxY = ide.examplesTv.ContextY();
        ide.ctxTarget = ide.examplesTv.ContextRow();
    }

    /// Makes a commit message safe to embed in a double-quoted shell argument
    /// (quotes/backslashes/backticks would otherwise break out of it).
    static string GitEscape(string msg) {
        StringBuilder sb = new StringBuilder();
        for (int i = 0; i < msg.Length; i = i + 1) {
            string ch = msg.Substring(i, 1);
            if (ch != "\"" && ch != "\\" && ch != "`" && ch != "$"
                && ch != "\r" && ch != "\n") {
                sb.Append(ch);
            } else if (ch == "\r" || ch == "\n") {
                sb.Append(" ");
            } else {
                sb.Append("'");
            }
        }
        return sb.ToString();
    }

    // ================================================================
    // Debug helpers
    // ================================================================

    /// Starts the debug build (`-g`, DWARF + O0) DETACHED and returns the
    /// executable path it will produce ("" when there is nothing to build).
    /// The frame loop polls BuildDone() and, on success, opens the debug
    /// session -- so pressing F5 never freezes the window during compilation.
    static string DebugBuildBegin(
        List<TabRecord> tabs,
        SignalInt activeTab,
        string root,
        List<string> log
    ) {
        int a = activeTab.Get();
        if (a < 0 || a >= tabs.Count) { return ""; }
        string p = tabs[a].path;
        p = ZanIDE.RibbonRunTarget(p, root);
        if (p == "") {
            log.Add(ZanIDE.T("> [Debug] Open a source file first.", "> [调试] 请先打开源文件。"));
            return "";
        }
        string bd = ZanIDE.EnsureBuildDir(root);
        string ll = bd + "/.zandbg.ll";
        string exe = bd + "/.zandbg" + ZanIDE.ExeSuffix();
        if (File.Exists(exe)) { File.Delete(exe); }
        string inputs = ZanIDE.SmartInputs(root, ZanIDE.DirOf(p), p);
        // `-g` emits DWARF and forces -O0 so gdb (via zan-dap) sees real
        // source lines, frames and locals.
        string buildCmd = ZanIDE.CompileToExe(root, p, inputs, ll, exe, false) + " -g";
        log.Add("> [Debug] Building " + p + " ...");
        ZanIDE.BuildDetach(buildCmd);
        return exe;
    }

    static int FirstDebugLine(CodeEditor editor) {
        List<string> lines = CodeEditor.SplitLines(editor.GetText());
        for (int i = 0; i < lines.Count; i = i + 1) {
            string line = ZanIDE.TrimLeadSpaces(lines[i]);
            bool skip = line == "" || line == "{" || line == "}"
                || ZanIDE.Has(line, "using ")
                || ZanIDE.Has(line, "class ")
                || ZanIDE.Has(line, "static void Main")
                || ZanIDE.Has(line, "//");
            if (!skip) { return i; }
        }
        return 0;
    }

    static int ParseInt(string s) {
        int result = 0;
        for (int i = 0; i < s.Length; i = i + 1) {
            string ch = s.Substring(i, 1);
            if (ch == "0") { result = result * 10; }
            else if (ch == "1") { result = result * 10 + 1; }
            else if (ch == "2") { result = result * 10 + 2; }
            else if (ch == "3") { result = result * 10 + 3; }
            else if (ch == "4") { result = result * 10 + 4; }
            else if (ch == "5") { result = result * 10 + 5; }
            else if (ch == "6") { result = result * 10 + 6; }
            else if (ch == "7") { result = result * 10 + 7; }
            else if (ch == "8") { result = result * 10 + 8; }
            else if (ch == "9") { result = result * 10 + 9; }
        }
        return result;
    }

    /// Net change in brace nesting for a line (approximate: counts { and }
    /// literally, which is good enough for well-formed source).
    static int BraceDelta(string ln) {
        int d = 0;
        for (int i = 0; i < ln.Length; i = i + 1) {
            string ch = ln.Substring(i, 1);
            if (ch == "{") { d = d + 1; }
            else if (ch == "}") { d = d - 1; }
        }
        return d;
    }

    /// Returns "" if `elem` is not a primitive the debugger can stringify in an
    /// injected `foreach`, else the element type. (bool is excluded from lists:
    /// it stringifies to -1/0.)
    static string ListElemKind(string elem) {
        if (elem == "int" || elem == "string" || elem == "long"
            || elem == "float" || elem == "double" || elem == "char") {
            return elem;
        }
        return "";
    }

    static bool StartsWith(string s, string pfx) {
        if (s.Length < pfx.Length) { return false; }
        return s.Substring(0, pfx.Length) == pfx;
    }

    /// Path of the active tab, or "" if none.
    static string PathOf(List<string> paths, SignalInt active) {
        int a = active.Get();
        if (a >= 0 && a < paths.Count) { return paths[a]; }
        return "";
    }

    /// Directory portion of a path (before the last '/' or '\'), or "." if none.
    static string DirOf(string path) {
        int last = 0 - 1;
        for (int i = 0; i < path.Length; i = i + 1) {
            string ch = path.Substring(i, 1);
            if (ch == "/" || ch == "\\") { last = i; }
        }
        if (last < 0) { return "."; }
        return path.Substring(0, last);
    }

    static string FindProjectRoot(string path) {
        string dir = ZanIDE.DirOf(path);
        for (int depth = 0; depth < 24; depth = depth + 1) {
            if (File.Exists(dir + "/zan.proj")) { return dir; }
            string parent = ZanIDE.DirOf(dir);
            if (parent == dir || parent == ".") { break; }
            dir = parent;
        }
        return "";
    }

    static bool IsZanFile(string name) {
        int n = name.Length;
        if (n < 4) { return false; }
        return name.Substring(n - 4, 4) == ".zan";
    }

    /// Recursively collects full paths of project source files under `dir` -
    /// .zan sources plus .zform and .zscene design documents (which zanc
    /// compiles directly; their Main is projected by formgen/scenegen, and
    /// only the first input's Main is emitted, so several designs can be
    /// compiled together) - skipping IDE temp files (names starting with ".")
    /// and build/publish output directories.
    static void GatherZanFiles(string dir, List<string> outp) {
        DirectoryTree.FilesInto(outp, dir,
            PathFilter.Only(".zan .zform .zscene")
                .Skip("publish build bin obj dist tools")
                .Dots(true, true));
    }

    /// Builds the quoted, space-joined zanc input list for a whole-project build:
    /// `entry` first (so it becomes the compiler's primary input), then every
    /// other project .zan file except `skip` (e.g. the original of a probe).
    static string ProjectInputs(string dir, string entry, string skip) {
        string args = "\"" + entry + "\"";
        List<string> all = new List<string>();
        ZanIDE.GatherZanFiles(dir, all);
        for (int i = 0; i < all.Count; i = i + 1) {
            string f = all[i];
            if (f != entry && f != skip) {
                args = args + " \"" + f + "\"";
            }
        }
        return args;
    }

    /// Resolves the runnable entry point of the project at `root`. For GUI
    /// projects the entry is the .zform design document (zanc compiles it
    /// directly, projecting Main), for console projects src/main.zan; both come
    /// from zan.proj (`entry = ...`), falling back to src/main.zan.
    static string ProjectEntry(string root) {
        string fallback = root + "/src/main.zan";
        string proj = root + "/zan.proj";
        if (!File.Exists(proj)) { return fallback; }
        List<string> ls = CodeEditor.SplitLines(File.ReadAllText(proj));
        for (int i = 0; i < ls.Count; i = i + 1) {
            string tr = ZanIDE.TrimLeadSpaces(ls[i]);
            if (tr.Length >= 5 && tr.Substring(0, 5) == "entry") {
                string rest = ZanIDE.TrimLeadSpaces(tr.Substring(5, tr.Length - 5));
                if (rest.Length > 0 && rest.Substring(0, 1) == "=") {
                    string val = ZanIDE.TrimLeadSpaces(rest.Substring(1, rest.Length - 1));
                    int e = val.Length;
                    while (e > 0) {
                        string ch = val.Substring(e - 1, 1);
                        if (ch == " " || ch == "\t" || ch == "\r" || ch == "\n") { e = e - 1; }
                        else { break; }
                    }
                    if (e > 0) { return root + "/" + val.Substring(0, e); }
                }
            }
        }
        return fallback;
    }

    static string TrimLeadSpaces(string s) {
        int i = 0;
        while (i < s.Length) {
            string ch = s.Substring(i, 1);
            if (ch == " " || ch == "\t") { i = i + 1; }
            else { break; }
        }
        if (i == 0) { return s; }
        return s.Substring(i, s.Length - i);
    }

    static string ExtractIdent(string s, int start) {
        string idc = "abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ0123456789_";
        string name = "";
        for (int i = start; i < s.Length && CodeEditor.InSet(idc, s.Substring(i, 1)); i = i + 1) {
            name = name + s.Substring(i, 1);
        }
        return name;
    }

    static string ExtractValue(string rest, int ni) {
        if (ni >= rest.Length) { return "(uninitialized)"; }
        if (rest.Substring(ni, 1) != "=") { return "(uninitialized)"; }
        ni = ni + 1;
        while (ni < rest.Length && rest.Substring(ni, 1) == " ") { ni = ni + 1; }
        string val = "";
        while (ni < rest.Length && rest.Substring(ni, 1) != ";") {
            val = val + rest.Substring(ni, 1);
            ni = ni + 1;
        }
        if (val.Length == 0) { return "(empty)"; }
        return val;
    }

    static string TrimTrailSpaces(string s) {
        int e = s.Length;
        while (e > 0 && s.Substring(e - 1, 1) == " ") { e = e - 1; }
        if (e == s.Length) { return s; }
        return s.Substring(0, e);
    }

    static void LogVarsToConsole(List<string> log, List<DbgVar> vars, int execLine) {
        log.Add("> --- Line " + Convert.ToString(execLine + 1) + " ---");
        for (int vi = 0; vi < vars.Count; vi = vi + 1) {
            DbgVar entry = vars[vi];
            string vn = entry.name;
            string vt = entry.type;
            string vv = entry.val;
            log.Add(">   " + vn + " : " + vt + " = " + vv);
        }
    }

    // ================================================================
    // Designer
    // ================================================================

    // The old standalone snippets were replaced by the searchable component
    // center so examples stay aligned with the current Gui.Widget API.
    /// The stdlib/ shipped next to the IDE as a collapsed tree, so the
    /// sidebar's third section doubles as a standard-library browser.
    static List<TreeNode> BuildStdlibTree() {
        List<TreeNode> n = ZanIDE.BuildDirTree(ZanIDE.StdlibDir());
        for (int i = 0; i < n.Count; i = i + 1) {
            if (n[i].isDir) { n[i].expanded = false; }
        }
        return n;
    }

    /// A generic collapsible .zan file tree for any directory (empty list
    /// when the directory does not exist).
    static List<TreeNode> BuildDirTree(string dir) {
        List<TreeNode> n = new List<TreeNode>();
        if (dir != "" && Directory.Exists(dir)) {
            ZanIDE.ScanExamplesInto(n, dir, 0);
        }
        return n;
    }

    static List<TreeNode> BuildExampleTree() {
        List<TreeNode> n = new List<TreeNode>();
        string dir = ZanIDE.ExamplesDir();
        if (dir != "") {
            // Scan the real examples/ folder so every leaf carries the actual
            // on-disk path; clicking one opens the true source and Run/Debug
            // compile it directly. Sub-directories become collapsible groups.
            ZanIDE.ScanExamplesInto(n, dir, 0);
        }
        if (n.Count == 0) {
            // No examples shipped alongside the IDE: fall back to the built-in
            // GUI component center so the panel is never empty.
            n.Add(TreeNode.Dir(ZanIDE.T("GUI Reference", "GUI 参考"), 0, true));
            n.Add(ZanIDE.ExLeaf(
                ZanIDE.T("Component Center", "组件示例中心"), 0));
        }
        return n;
    }

    /// Adds the `.zan` files and sub-directories of `dirPath` to `nodes` in
    /// pre-order, tagging every file leaf with its real path. Mirrors ScanInto
    /// but keeps only Zan sources (examples never ship manifests) and omits the
    /// redundant root directory row so the pane starts at the first example.
    static void ScanExamplesInto(List<TreeNode> nodes, string dirPath, int depth) {
        FileTree.Into(nodes, dirPath, "", depth, true,
            PathFilter.Only(".zan"), false, true);
    }

    static TreeNode ExLeaf(string label, int idx) {
        TreeNode f = TreeNode.FileIcon(label, 1, "file");
        f.path = "@ex:" + Convert.ToString(idx);
        return f;
    }

    // Returns the index of the first tab whose path equals p, or -1.
    static int FindTabByPath(List<string> paths, string p) {
        for (int i = 0; i < paths.Count; i = i + 1) {
            if (paths[i] == p) { return i; }
        }
        return 0 - 1;
    }

    // ---- Help / documentation browser ----

    /// Lowercases ASCII A-Z using only string ops (the runtime has no reliable
    /// char-code helper here), leaving other characters unchanged.
    static string ToLowerS(string s) {
        string up = "ABCDEFGHIJKLMNOPQRSTUVWXYZ";
        string lo = "abcdefghijklmnopqrstuvwxyz";
        string o = "";
        for (int i = 0; i < s.Length; i = i + 1) {
            string ch = s.Substring(i, 1);
            bool done = false;
            for (int k = 0; k < 26 && !done; k = k + 1) {
                if (up.Substring(k, 1) == ch) { o = o + lo.Substring(k, 1); done = true; }
            }
            if (!done) { o = o + ch; }
        }
        return o;
    }

    /// True if `hay` contains `needle` as a substring.
    static bool ContainsS(string hay, string needle) {
        if (needle.Length == 0) { return true; }
        if (hay.Length < needle.Length) { return false; }
        int last = hay.Length - needle.Length;
        for (int i = 0; i <= last; i = i + 1) {
            if (hay.Substring(i, needle.Length) == needle) { return true; }
        }
        return false;
    }

    /// Word-wraps `s` (honoring embedded newlines) to fit `maxW` pixels at
    /// `fontSize`. Empty input paragraphs become blank lines (paragraph gaps).
    static List<string> WrapText(string s, int maxW, int fontSize) {
        List<string> outl = new List<string>();
        List<string> paras = CodeEditor.SplitLines(s);
        for (int p = 0; p < paras.Count; p = p + 1) {
            List<string> words = ZanIDE.SplitSpaces(paras[p]);
            if (words.Count == 0) { outl.Add(""); }
            string cur = "";
            for (int wi = 0; wi < words.Count; wi = wi + 1) {
                string cand = cur;
                if (cand != "") { cand = cand + " "; }
                cand = cand + words[wi];
                if (Canvas.MeasureText(cand, fontSize) > maxW && cur != "") {
                    outl.Add(cur);
                    cur = words[wi];
                } else {
                    cur = cand;
                }
            }
            if (cur != "") { outl.Add(cur); }
        }
        return outl;
    }

    // ================================================================
    // Example Code Library
    // ================================================================

    static void OpenNewTab(List<TabRecord> tabs, SignalInt activeTab, string name, string code) {
        tabs.Add(TabRecord.Create(name, code, ""));
        activeTab.Set(tabs.Count - 1);
    }
}
