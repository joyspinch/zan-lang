using System;
using Gui;
using Gui.Widget;

/// The IDE start page: recent projects (with quick actions) beside articles and
/// news. The page declares structure only -- which element sits in which card
/// and what class it carries; every size, gap and inset comes from the
/// stylesheet (`startpage`, `card.recent`, `list.news`, ... in ide.css), so
/// there is no coordinate arithmetic here and no row building either: the lists
/// own the mapping from model to rows.
///
/// The shell polls TakeAction() after rendering:
///   1/2/3 = New Project / New File / Open, 100+i = open recent i,
///   200+i = open article i, 300+i = drop recent i from the list.
class StartPage : Control {
    RecentList recents;
    NewsList news;
    ButtonBar quick;
    int action;

    StartPage() {
        this.InitControl("startPage", 5);
        Class = "startpage";
        recents = RecentList.Create();
        news = NewsList.Create();
        quick = ButtonBar.Create("quick");
        quick.Add(new Button { Text = ZanIDE.T("New Project", "新建项目"), Icon = "plus", Class = "small" });
        quick.Add(new Button { Text = ZanIDE.T("New File", "新建文件"), Icon = "file", Class = "small" });
        quick.Add(new Button { Text = ZanIDE.T("Open", "打开"), Icon = "folder", Class = "small" });

        Card recentCard = new Card(ZanIDE.T("Recent projects", "最近项目"));
        recentCard.Class = "recent";
        recentCard.Add(recents);
        recentCard.Add(quick);

        Card newsCard = new Card(ZanIDE.T("Articles & news", "资讯与文章"));
        newsCard.Class = "news";
        newsCard.Add(news);

        this.Add(recentCard);
        this.Add(newsCard);
        action = 0;
    }

    override string Kind() { return "StartPage"; }

    override string StyleType() { return "startpage"; }

    void SetRecents(List<RecentItem> items) { recents.SetItems(items); }

    void SetNews(List<NewsItem> items) { news.SetItems(items); }

    /// Where recent entry `i` / article `i` leads, so the shell can act on an
    /// action code without keeping its own copy of the model.
    string RecentPath(int i) { return recents.PathOf(i); }

    string NewsLink(int i) { return news.LinkOf(i); }

    override void OnPaint(App app) {
        Theme t = app.theme;
        // Skins with their own backdrop (glass / gradient) let the window
        // wallpaper be the page background; a flat skin needs the page filled.
        if (t.glass == 0 && t.gradient == 0) {
            Panel.ChromeSurface(app, bx, by, bw, bh, 0, t.bgPrimary);
        }
    }

    /// The action the user triggered in the last frame (0 = none). Consumed by
    /// the read, so the shell handles it exactly once.
    int TakeAction() {
        int pressed = quick.TakePressed();
        if (pressed >= 0) { action = pressed + 1; }
        int removed = recents.TakeRemoved();
        if (removed >= 0) { action = 300 + removed; }
        int opened = recents.TakeOpened();
        if (opened >= 0) { action = 100 + opened; }
        int article = news.TakeOpened();
        if (article >= 0) { action = 200 + article; }
        int a = action;
        action = 0;
        return a;
    }
}
