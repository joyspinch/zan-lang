using System;
using Gui;
using Gui.Widget;

/// The IDE start page: recent projects (with quick actions) beside articles and
/// news. The page declares structure only -- which element sits in which card
/// and what class it carries; every size, gap and inset comes from the
/// stylesheet (`startpage`, `card.recent`, `list.news`, ... in ide.css), so
/// there is no coordinate arithmetic here. The lists are bound straight to the
/// model (`List<RecentItem>` / `List<NewsItem>`) and each row is a control of
/// its own, so no row model is built anywhere.
///
/// The shell polls TakeAction() after rendering:
///   1/2/3 = New Project / New File / Open, 100+i = open recent i,
///   200+i = open article i; a dropped project comes back from
///   TakeRemovedPath() as a path.
class StartPage : Control {
    ListView<RecentItem> recents;
    ListView<NewsItem> news;
    ButtonGroup quick;
    int action;
    /// The IDE has exactly one start page; the list handlers are bound as
    /// methods, and a handler reaches the page through this.
    static StartPage current;

    StartPage() {
        this.InitControl("startPage", 5);
        Class = "startpage";
        current = this;
        recents = new ListView<RecentItem>(RecentRow.Of);
        recents.Class = "recent flat";
        recents.EmptyText(ZanIDE.T("(no recent projects yet)",
                                   "（还没有最近打开的项目）"));
        recents.OnSelect(StartPage.RecentPicked);
        recents.OnActivate(StartPage.RecentPicked);
        news = new ListView<NewsItem>(NewsRow.Of);
        news.Class = "news flat";
        news.OnSelect(StartPage.ArticlePicked);
        news.OnActivate(StartPage.ArticlePicked);
        quick = ButtonGroup.Bar("quick");
        quick.AddButton(new Button { Text = ZanIDE.T("New Project", "新建项目"), Icon = "plus", Class = "small" });
        quick.AddButton(new Button { Text = ZanIDE.T("New File", "新建文件"), Icon = "file", Class = "small" });
        quick.AddButton(new Button { Text = ZanIDE.T("Open", "打开"), Icon = "folder", Class = "small" });

        Card recentCard = new Card(ZanIDE.T("Recent projects", "最近项目"));
        recentCard.Class = "recent";
        recentCard.Add(recents);
        recentCard.Add(quick);

        Card newsCard = new Card(ZanIDE.T("Articles & news", "资讯与文章"));
        newsCard.Class = "news";
        newsCard.Add(news);

        this.Add(recentCard);
        this.Add(newsCard);
        action = 0;
    }

    override string Kind() { return "StartPage"; }

    override string StyleType() { return "startpage"; }

    void SetRecents(List<RecentItem> items) { recents.Bind(items); }

    void SetNews(List<NewsItem> items) { news.Bind(items); }

    /// Where recent entry `i` / article `i` leads, so the shell can act on an
    /// action code without keeping its own copy of the model.
    string RecentPath(int i) {
        if (!recents.Has(i)) { return ""; }
        return recents.ItemAt(i).path;
    }

    string NewsLink(int i) {
        if (!news.Has(i)) { return ""; }
        return news.ItemAt(i).link;
    }

    static void RecentPicked() {
        if (current == null) { return; }
        current.action = 100 + current.recents.SelectedIndex();
    }

    static void ArticlePicked() {
        if (current == null) { return; }
        current.action = 200 + current.news.SelectedIndex();
    }

    override void OnPaint(App app) {
        Theme t = app.theme;
        // Skins with their own backdrop (glass / gradient) let the window
        // wallpaper be the page background; a flat skin needs the page filled.
        if (t.glass == 0 && t.gradient == 0) {
            app.FillChrome(bx, by, bw, bh, 0, t.bgPrimary);
        }
    }

    /// The action the user triggered in the last frame (0 = none). Consumed by
    /// the read, so the shell handles it exactly once.
    int TakeAction() {
        int pressed = quick.TakePressed();
        if (pressed >= 0) { action = pressed + 1; }
        int a = action;
        action = 0;
        return a;
    }

    /// Project the user asked to drop from the list ("" = none). The row owns
    /// the entity, so this is a path, not an index.
    string TakeRemovedPath() { return RecentRow.TakeRemoved(); }
}
