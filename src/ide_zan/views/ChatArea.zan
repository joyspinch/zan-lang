using System;
using Gui;
using Gui.Widget;
using Gui.Component;

/// The AI chat transcript view, extracted from the shell: transcript
/// serialization (ChatPack/ChatUnpack), the wrapped markdown-aware line
/// cache (ChatBuildLines) and the bottom-anchored transcript renderer.
class ChatArea {
    /// Greedily wraps `s` to `maxW` pixels, appending the pieces to `outLines`.
    static void WrapInto(string s, int maxW, int fontSize, List<string> outLines) {
        List<string> hard = CodeEditor.SplitLines(s);
        if (hard.Count == 0) { hard.Add(""); }
        int li = 0;
        while (li < hard.Count) {
            string line = hard[li];
            if (line == "") { outLines.Add(""); }
            while (line != "") {
                if (Canvas.MeasureText(line, fontSize) <= maxW) {
                    outLines.Add(line);
                    line = "";
                } else {
                    // Binary-search the longest prefix that fits.
                    int lo = 1;
                    int hi = line.Length;
                    while (lo < hi) {
                        int mid = (lo + hi + 1) / 2;
                        if (Canvas.MeasureText(line.Substring(0, mid), fontSize) <= maxW) { lo = mid; }
                        else { hi = mid - 1; }
                    }
                    // Never wrap inside a multi-byte character; keep at least
                    // one whole character so the loop progresses.
                    lo = Text.ClampCharStart(line, lo);
                    if (lo <= 0) { lo = Text.NextCharEnd(line, 0); }
                    outLines.Add(line.Substring(0, lo));
                    line = line.Substring(lo, line.Length - lo);
                }
            }
            li = li + 1;
        }
    }

    /// Serializes a chat transcript for the session switcher (JSON, so any
    /// message content round-trips safely).
    static string ChatPack(List<string> roles, List<string> texts,
            List<string> planText, List<int> planDone) {
        StringBuilder sb = new StringBuilder();
        sb.Append("{\"m\": [");
        int i = 0;
        while (i < roles.Count) {
            if (i > 0) { sb.Append(", "); }
            sb.Append("{\"r\": \"" + ZanIDE.JsonEsc(roles[i]) + "\", \"t\": \""
                + ZanIDE.JsonEsc(texts[i]) + "\"}");
            i = i + 1;
        }
        sb.Append("], \"plan\": [");
        int p = 0;
        while (p < planText.Count) {
            if (p > 0) { sb.Append(", "); }
            string dv = "false";
            if (p < planDone.Count && planDone[p] != 0) { dv = "true"; }
            sb.Append("{\"t\": \"" + ZanIDE.JsonEsc(planText[p]) + "\", \"d\": "
                + dv + "}");
            p = p + 1;
        }
        sb.Append("]}");
        return sb.ToString();
    }

    static void ChatUnpack(string packed, List<string> roles, List<string> texts,
            List<string> planText, List<int> planDone) {
        if (packed == "") { return; }
        JsonValue v = JsonValue.ParseLenient(packed);
        if (v == null) { return; }
        JsonValue ms = v.Get("m");
        if (ms != null && ms.IsArray()) {
            int i = 0;
            while (i < ms.Count()) {
                JsonValue m = ms.At(i);
                roles.Add(m.Str("r", "assistant"));
                texts.Add(m.Str("t", ""));
                i = i + 1;
            }
        }
        JsonValue pl = v.Get("plan");
        if (pl != null && pl.IsArray()) {
            int j = 0;
            while (j < pl.Count()) {
                JsonValue p = pl.At(j);
                planText.Add(p.Str("t", ""));
                if (p.Bool("d", false)) { planDone.Add(1); } else { planDone.Add(0); }
                j = j + 1;
            }
        }
    }

    /// First line of `s`, capped to a title length (for the session list).
    static string TitleLine(string s) {
        List<string> hard = CodeEditor.SplitLines(s);
        string first = "";
        if (hard.Count > 0) { first = hard[0]; }
        if (first.Length > 60) { first = Text.Left(first, Text.ClampCharStart(first, 60)); }
        return first;
    }

    /// Title of a live transcript: the first thing the user asked, else "".
    static string FirstUserOf(List<string> roles, List<string> texts) {
        int i = 0;
        while (i < roles.Count) {
            if (roles[i] == "user") { return ChatArea.TitleLine(texts[i]); }
            i = i + 1;
        }
        return "";
    }

    /// Title of a packed (serialized) transcript, without unpacking it whole.
    static string ChatTitle(string packed) {
        if (packed == "") { return ""; }
        JsonValue v = JsonValue.ParseLenient(packed);
        if (v == null) { return ""; }
        JsonValue ms = v.Get("m");
        if (ms == null || !ms.IsArray()) { return ""; }
        int i = 0;
        while (i < ms.Count()) {
            JsonValue m = ms.At(i);
            if (m.Str("r", "") == "user") { return ChatArea.TitleLine(m.Str("t", "")); }
            i = i + 1;
        }
        return "";
    }

    /// Builds the wrapped, markdown-aware line cache for the chat transcript.
    /// kinds: 0 = normal text, 1 = code (drawn on a code background),
    /// 2 = heading, 3 = message header row.
    static void ChatBuildLines(App app, List<string> roles, List<string> texts,
            List<string> reason, int textW, bool thinkOpen, List<string> lines,
            List<int> colors, List<int> kinds) {
        Theme t = app.theme;
        int i = 0;
        while (i < roles.Count) {
            string head = "AI";
            int headCol = t.success;
            int bodyCol = t.textPrimary;
            if (roles[i] == "user") {
                head = ZanIDE.T("You", "我");
                headCol = t.primary;
            } else if (roles[i] == "error") {
                head = ZanIDE.T("Error", "错误");
                headCol = t.error;
                bodyCol = t.error;
            } else if (roles[i] == "tool") {
                head = ZanIDE.T("Tool", "工具");
                headCol = t.textTertiary;
                bodyCol = t.textTertiary;
            }
            lines.Add(head);
            colors.Add(headCol);
            kinds.Add(3);
            // A tool result is evidence the assistant read, not conversation:
            // show what it looked at and the first few lines, so a long file
            // dump cannot bury the answer.
            if (roles[i] == "tool") {
                List<string> tl = CodeEditor.SplitLines(texts[i]);
                int shown = tl.Count;
                if (shown > 6) { shown = 6; }
                int k = 0;
                while (k < shown) {
                    int before = lines.Count;
                    ChatArea.WrapInto(tl[k], textW, t.fontSizeSmall, lines);
                    if (lines.Count == before) { lines.Add(""); }
                    while (colors.Count < lines.Count) { colors.Add(bodyCol); kinds.Add(0); }
                    k = k + 1;
                }
                if (tl.Count > shown) {
                    lines.Add("... " + Convert.ToString(tl.Count - shown)
                        + ZanIDE.T(" more lines", " 行已折叠"));
                    colors.Add(bodyCol);
                    kinds.Add(0);
                }
                i = i + 1;
                continue;
            }
            // F: the model's reasoning is shown as its own dim "Thinking"
            // section above the answer, kept separate from the answer text (and
            // out of the transcript sent back to the model).
            if (roles[i] == "assistant" && i < reason.Count && reason[i] != "") {
                // Collapsed by default: only a clickable one-line toggle (kind 4)
                // shows, so the thinking never buries the answer. Clicking it
                // (handled in RenderChatArea) expands the full reasoning.
                if (thinkOpen) {
                    lines.Add(ZanIDE.T("Thinking (click to hide)",
                        "思考过程（点击收起）"));
                } else {
                    lines.Add(ZanIDE.T("Thinking (click to show)",
                        "思考过程（点击展开）"));
                }
                colors.Add(t.textTertiary);
                kinds.Add(4);
                if (thinkOpen) {
                    List<string> rsrc = CodeEditor.SplitLines(reason[i]);
                    int rk = 0;
                    while (rk < rsrc.Count) {
                        int rbefore = lines.Count;
                        ChatArea.WrapInto(ChatArea.MdStrip(rsrc[rk]), textW,
                            t.fontSizeSmall, lines);
                        if (lines.Count == rbefore) { lines.Add(""); }
                        while (colors.Count < lines.Count) {
                            colors.Add(t.textTertiary); kinds.Add(0);
                        }
                        rk = rk + 1;
                    }
                }
            }
            // Markdown-lite: fenced code blocks get a code background and
            // color; headings/bullets/inline `code`/**bold** markers are
            // simplified for readable plain-canvas rendering.
            List<string> src = CodeEditor.SplitLines(texts[i]);
            bool inCode = false;
            int li = 0;
            while (li < src.Count) {
                string ln = src[li];
                bool fence = ln.Length >= 3 && ln.Substring(0, 3) == "```";
                if (fence) {
                    inCode = !inCode;
                } else if (inCode) {
                    int before = lines.Count;
                    ChatArea.WrapInto(ln, textW - app.Scale(8), t.fontSizeSmall, lines);
                    if (lines.Count == before) { lines.Add(""); }
                    while (colors.Count < lines.Count) { colors.Add(t.info); kinds.Add(1); }
                } else {
                    string shown = ChatArea.MdStrip(ln);
                    int kind = 0;
                    int col = bodyCol;
                    if (ln.Length >= 2 && ln.Substring(0, 1) == "#") {
                        kind = 2;
                        col = t.textPrimary;
                    }
                    int before = lines.Count;
                    ChatArea.WrapInto(shown, textW, t.fontSizeSmall, lines);
                    if (lines.Count == before) { lines.Add(""); }
                    while (colors.Count < lines.Count) { colors.Add(col); kinds.Add(kind); }
                }
                li = li + 1;
            }
            // One blank row separates turns; the per-turn header (kind 3) plus
            // this single gap keeps messages distinct without the old sprawl.
            lines.Add("");
            colors.Add(bodyCol);
            kinds.Add(0);
            i = i + 1;
        }
    }

    /// Strips light markdown syntax for plain-text display: heading hashes,
    /// `**`/`__` bold markers and single backticks; keeps list dashes.
    static string MdStrip(string ln) {
        string s = ln;
        int h = 0;
        while (h < s.Length && s.Substring(h, 1) == "#") { h = h + 1; }
        if (h > 0 && h < s.Length && s.Substring(h, 1) == " ") {
            s = s.Substring(h + 1, s.Length - h - 1);
        }
        StringBuilder sb = new StringBuilder();
        int i = 0;
        while (i < s.Length) {
            string ch = s.Substring(i, 1);
            if (ch == "*" && i + 1 < s.Length && s.Substring(i + 1, 1) == "*") { i = i + 2; }
            else if (ch == "`") { i = i + 1; }
            else { sb.Append(ch); i = i + 1; }
        }
        return sb.ToString();
    }

    /// The display-line index under `mouseY` for a bottom-anchored transcript
    /// whose first visible line is `start`.
    static int RowAtChat(Rect area, int pad, int rowH, int start,
            int count, int mouseY) {
        int rel = (mouseY - (area.y + pad)) / rowH;
        if (rel < 0) { rel = 0; }
        int ri = start + rel;
        if (ri < 0) { ri = 0; }
        if (ri >= count) { ri = count - 1; }
        return ri;
    }

    /// Draws the (pre-wrapped, cached) chat transcript bottom-anchored inside
    /// `area`; code lines get a code-colored background strip. Returns the
    /// maximum scroll offset.
    static int RenderChatArea(App app, Rect area, List<string> lines,
            List<int> colors, List<int> kinds, int scroll, bool busy,
            LogState sel, bool interactive, SignalInt thinkOpen) {
        Canvas c = app.canvas;
        Theme t = app.theme;
        int pad = app.Scale(6);
        int rowH = app.Scale(18);
        int extra = 0;
        if (busy) { extra = 1; }
        if (lines.Count == 0 && !busy) {
            c.PushClip(area.x, area.y, area.width, area.height);
            List<string> hint = new List<string>();
            ChatArea.WrapInto(ZanIDE.T(
                "Ask the AI assistant about your project: explain code, find bugs, generate Zan snippets.",
                "向 AI 助手提问：解释代码、查找问题、生成 Zan 代码片段。"),
                area.width - pad * 2, t.fontSizeSmall, hint);
            int hi = 0;
            while (hi < hint.Count) {
                app.canvas.DrawStyledText(
                    Style.Of(app, "label", "hint small", Style.SNormal()),
                    area.x + pad, area.y + pad + hi * rowH, hint[hi],
                    app.theme.textPrimary, app.theme.fontSizeMedium);
                hi = hi + 1;
            }
            c.PopClip();
            return 0;
        }
        int total = lines.Count + extra;
        int maxRows = (area.height - pad * 2) / rowH;
        if (maxRows < 1) { maxRows = 1; }
        int maxScroll = total - maxRows;
        if (maxScroll < 0) { maxScroll = 0; }
        if (scroll > maxScroll) { scroll = maxScroll; }
        if (scroll < 0) { scroll = 0; }
        int start = total - maxRows - scroll;
        if (start < 0) { start = 0; }
        // Drag-to-select over the wrapped display lines, reusing the LogView
        // selection model (LogState + LogView.ColAt / SelectionText). Wheel
        // scrolling stays with the caller so it keeps its own scroll model.
        if (interactive && lines.Count > 0) {
            int hid = app.focus.AllocId();
            app.hitTester.Register(HitRegion.Create(hid, area.x, area.y,
                area.width, area.height, 1));
            int kind = app.EventKind();
            bool over = app.mouseX >= area.x && app.mouseX < area.x + area.width
                && app.mouseY >= area.y && app.mouseY < area.y + area.height;
            if (kind == 2 && app.window.EventButton() == 0 && over
                && !app.PointerCaptured()) {
                int ri = ChatArea.RowAtChat(area, pad, rowH, start,
                    lines.Count, app.mouseY);
                if (ri >= 0 && ri < kinds.Count && kinds[ri] == 4) {
                    // Clicking a "Thinking" toggle row expands/collapses the
                    // reasoning instead of starting a text selection.
                    thinkOpen.Set(1 - thinkOpen.Get());
                    app.RequestRedraw();
                } else {
                    int cc = LogView.ColAt(lines[ri], area.x + pad,
                        t.fontSizeSmall, app.mouseX);
                    sel.selR0 = ri; sel.selC0 = cc;
                    sel.selR1 = ri; sel.selC1 = cc;
                    sel.selDrag = true;
                    app.RequestRedraw();
                }
            }
            if (kind == 1 && sel.selDrag) {
                int ri = ChatArea.RowAtChat(area, pad, rowH, start,
                    lines.Count, app.mouseY);
                int cc = LogView.ColAt(lines[ri], area.x + pad,
                    t.fontSizeSmall, app.mouseX);
                sel.selR1 = ri; sel.selC1 = cc;
                app.RequestRedraw();
            }
            if (kind == 3 && sel.selDrag) {
                sel.selDrag = false;
                app.RequestRedraw();
            }
        }
        int sr0 = sel.selR0; int sc0 = sel.selC0;
        int sr1 = sel.selR1; int sc1 = sel.selC1;
        if (sr0 >= 0 && (sr0 > sr1 || (sr0 == sr1 && sc0 > sc1))) {
            int tr = sr0; sr0 = sr1; sr1 = tr;
            int tc = sc0; sc0 = sc1; sc1 = tc;
        }
        int selCol = App.ScaleAlpha(t.primary, 90);
        c.PushClip(area.x, area.y, area.width, area.height);
        int row = 0;
        int idx = start;
        int codeBg = App.ScaleAlpha(t.bgTertiary, 160);
        while (idx < total && row < maxRows) {
            int ry = area.y + pad + row * rowH;
            if (idx < lines.Count) {
                if (kinds[idx] == 1) {
                    app.FillChrome(area.x + pad - app.Scale(2), ry - app.Scale(1), area.width - pad * 2 + app.Scale(4), rowH, 0, codeBg);
                }
                if (sr0 >= 0 && idx >= sr0 && idx <= sr1) {
                    string ln = lines[idx];
                    int hs = 0;
                    int he = ln.Length;
                    if (idx == sr0) { hs = sc0; }
                    if (idx == sr1) { he = sc1; }
                    if (hs < 0) { hs = 0; }
                    if (he > ln.Length) { he = ln.Length; }
                    if (hs > he) { hs = he; }
                    int hx0 = area.x + pad
                        + Canvas.MeasureText(Text.Left(ln, hs), t.fontSizeSmall);
                    int hx1 = area.x + pad
                        + Canvas.MeasureText(Text.Left(ln, he), t.fontSizeSmall);
                    if (idx < sr1) { hx1 = hx1 + pad; }
                    if (hx1 < hx0 + 2) { hx1 = hx0 + 2; }
                    c.FillRect(hx0, ry, hx1 - hx0, rowH, selCol);
                }
                if (kinds[idx] == 1) {
                    app.canvas.DrawText(area.x + pad + app.Scale(4), ry, lines[idx], colors[idx],
                        Style.Of(app, "label", "small", Style.SNormal())
                            .FontOr(app.theme.fontSizeSmall));
                } else {
                    app.canvas.DrawText(area.x + pad, ry, lines[idx], colors[idx],
                        Style.Of(app, "label", "small", Style.SNormal())
                            .FontOr(app.theme.fontSizeSmall));
                }
            } else {
                app.canvas.DrawStyledText(
                    Style.Of(app, "label", "hint small", Style.SNormal()),
                    area.x + pad, ry, ZanIDE.T("AI is thinking...", "AI 思考中..."),
                    app.theme.textPrimary, app.theme.fontSizeMedium);
            }
            idx = idx + 1;
            row = row + 1;
        }
        c.PopClip();
        return maxScroll;
    }
}