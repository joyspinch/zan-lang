using System;
using Gui;
using Gui.Widget;

/// One line of the git changes panel: a `git status --porcelain` line, drawn in
/// the colour its status means (staged / untracked / modified). The row is a
/// control bound to the line itself, which is why the panel needs no row model
/// and no per-row colour plumbing through the list.
class GitFileRow : Control {
    string line;

    /// Row template for `new ListView<string>(GitFileRow.Of)`.
    static Control Of(string line) { return new GitFileRow(line); }

    GitFileRow(string src) {
        this.InitControl("gitFile", 1);
        line = src;
    }

    override string Kind() { return "GitFileRow"; }

    override string StyleType() { return "listrow"; }

    override void OnMeasure(App app) {
        prefH = app.theme.heightSmall;
        prefW = Canvas.MeasureText(line, app.theme.fontSizeSmall);
    }

    override void OnPaint(App app) {
        Theme t = app.theme;
        int fs = t.fontSizeSmall;
        int pad = t.paddingSmall;
        string s = Ellipsis.Fit(line, bw - pad * 2, fs);
        app.canvas.DrawText(bx + pad, Canvas.CenterTextY(by, bh, fs), s,
                            ZanIDE.GitStatusColor(t, line), fs);
    }
}
