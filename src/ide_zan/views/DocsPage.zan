using System;
using Gui;
using Gui.Widget;

/// Plain model behind the live component previews. Widgets bind their
/// `.data` to these fields, so a single field drives (and is driven by) the
/// preview widget both ways, mirroring the new instance + `.data` paradigm.
class DocsDemoModel {
    bool toggle;
    int choice;
    int level;
    int pick;
    int stars;
}

/// One rendered documentation topic. Display text and section membership stay
/// together so filtering and detail rendering cannot desynchronise fields.
class DocsTopic {
    string category;
    string title;
    string body;
    string code;
    int section;

    static DocsTopic From(DocEntry entry) {
        DocsTopic topic = new DocsTopic();
        topic.category = entry.Cat();
        topic.title = entry.Title();
        topic.body = entry.Body();
        topic.code = entry.Code();
        topic.section = DocsData.SectionOf(entry.CatEn());
        return topic;
    }
}

/// One line of the topic menu. A row is a topic (`doc` indexes the doc
/// arrays), a category heading (`doc` = -1) or a section row (`doc` = -2)
/// that opens its group; `sec` carries the section index of a section row.
class DocTopic {
    int doc;
    int sec;
    bool open;
    string text;

    static DocTopic Of(int doc, string text) {
        DocTopic t = new DocTopic();
        t.doc = doc;
        t.sec = 0 - 1;
        t.open = false;
        t.text = text;
        return t;
    }

    static DocTopic Header(string text) { return DocTopic.Of(0 - 1, text); }

    /// A collapsible group row; picking it opens that section.
    static DocTopic Section(int sec, string text, bool open) {
        DocTopic t = DocTopic.Of(0 - 2, text);
        t.sec = sec;
        t.open = open;
        return t;
    }

    bool IsSection() { return doc == 0 - 2; }

    bool IsHeader() { return doc < 0; }
}

/// A sidebar line as a control of its own: a heading and a topic differ only in
/// which label class they carry, which is what makes the sidebar a list of
/// custom rows rather than a list with a row model.
class DocTopicRow : Control {
    /// Row template for `new ListView<DocTopic>(DocTopicRow.Of)`.
    static Control Of(DocTopic t) { return new DocTopicRow(t); }

    DocTopicRow(DocTopic t) {
        this.InitControl("docTopic", 1);
        string caption = t.text;
        if (t.IsSection()) {
            if (t.open) { caption = "▾  " + caption; }
            else { caption = "▸  " + caption; }
        } else if (!t.IsHeader()) {
            caption = "   " + caption;
        }
        Label text = new Label(caption);
        if (t.IsSection()) {
            Class = "section";
            text.Class = "small strong";
        } else if (t.IsHeader()) {
            Class = "header";
            text.Class = "hint tiny";
        } else {
            text.Class = "small";
        }
        text.dock = 5;
        this.Add(text);
    }

    override string Kind() { return "DocTopicRow"; }

    override string StyleType() { return "listrow"; }

    override void OnMeasure(App app) {
        StyleBox s = this.ResolveStyleAs(app, "listrow", Class, Style.SNormal());
        prefH = s.HeightOr(app.theme.heightMedium);
    }
}

/// The Help / documentation browser, extracted from the shell: the doc
/// content lists (BuildDocs), the searchable sidebar + detail pane with a
/// copyable code example (RenderDocsPage) and the live widget previews.
class DocsPage {
    // Retained preview widgets + their model, created once so edits (typed
    // text, toggled switch, dragged slider) persist across frames.
    static DocsDemoModel demoModel;
    static Checkbox demoCheck;
    static Switch demoSwitch;
    static Radio demoRadioA;
    static Radio demoRadioB;
    static Slider demoSlider;
    static SelectBox demoSelect;
    static Rate demoRate;
    static Tabs demoTabs;
    static ListView<DocTopic> docList;
    // Where a picked topic goes: the page is rendered from signals the shell
    // owns, and the list handler is a method, so they are held here for it.
    static SignalInt docSel;
    static SignalInt docCodeScroll;
    static ListView<string> previewList;
    static Dropdown<string> demoDropdown;
    // Retained plain-text labels for the live preview rows that used to be
    // hand-painted DrawStyledText calls: each preview branch just sets .Text
    // and RenderAt/RenderInside, like the other demo widgets above.
    static Label lblTitle;
    static Label lblDefault;
    static Label lblSecondary;
    static Label lblSwitch;
    static Label lblSlider;
    static Label lblCard;
    static Label lblPanel;
    static Label lblFallbackA;
    static Label lblFallbackB;
    static Avatar lblFallbackIcon;

    /// A picked topic moves the shell's selection signal; a category heading is
    /// not a topic, so it selects nothing.
    static void TopicPicked() {
        if (DocsPage.docList == null) { return; }
        if (!DocsPage.docList.HasSelection()) { return; }
        DocTopic t = DocsPage.docList.Selected();
        if (t.IsHeader()) { return; }
        if (DocsPage.docSel != null) { DocsPage.docSel.Set(t.doc); }
        if (DocsPage.docCodeScroll != null) { DocsPage.docCodeScroll.Set(0); }
    }

    /// Lazily builds the retained preview widgets and binds each to a field on
    /// the shared model via `.data`. Called once per frame; returns early after
    /// the first build so instances (and their edit state) live across frames.
    static void EnsureDemos() {
        if (DocsPage.demoModel != null) { return; }
        DocsDemoModel m = new DocsDemoModel();
        m.toggle = true;
        m.choice = 0;
        m.level = 50;
        m.pick = 0;
        m.stars = 3;
        DocsPage.demoModel = m;

        Checkbox cb = new Checkbox(ZanIDE.T("Checked", "选中"));
        cb.data = m.toggle;
        DocsPage.demoCheck = cb;

        Switch sw = new Switch();
        sw.data = m.toggle;
        DocsPage.demoSwitch = sw;

        SignalInt group = new SignalInt(0);
        Radio ra = new Radio(group, 0, "Option A");
        ra.data = m.choice;
        DocsPage.demoRadioA = ra;
        Radio rb = new Radio(group, 1, "Option B");
        rb.data = m.choice;
        DocsPage.demoRadioB = rb;

        Slider sl = new Slider(0, 100, new SignalInt(50));
        sl.data = m.level;
        DocsPage.demoSlider = sl;

        List<string> opts = new List<string>{
            ZanIDE.T("Default", "默认"), ZanIDE.T("Success", "成功"),
            ZanIDE.T("Warning", "警告") };
        SelectBox se = SelectBox.FromOptions(opts, ZanIDE.T("Choose a state", "选择状态"));
        se.data = m.pick;
        DocsPage.demoSelect = se;

        Rate rt = new Rate(new SignalInt(3), 5);
        rt.data = m.stars;
        DocsPage.demoRate = rt;

        Tabs tb = new Tabs(0);
        tb.Add("Overview", false);
        tb.Add("API", false);
        tb.Add("Examples", false);
        DocsPage.demoTabs = tb;

        // Plain preview labels: classes mirror the old DrawStyledText calls so
        // the resolved colour/font is identical; only the Text is rebound later.
        DocsPage.lblTitle = new Label(); DocsPage.lblTitle.Class = "title";
        DocsPage.lblDefault = new Label();
        DocsPage.lblSecondary = new Label(); DocsPage.lblSecondary.Class = "secondary";
        DocsPage.lblSwitch = new Label();
        DocsPage.lblSlider = new Label(); DocsPage.lblSlider.Class = "secondary";
        DocsPage.lblCard = new Label();
        DocsPage.lblPanel = new Label();
        DocsPage.lblFallbackA = new Label();
        DocsPage.lblFallbackB = new Label(); DocsPage.lblFallbackB.Class = "secondary small";
        DocsPage.lblFallbackIcon = new Avatar("", 30, "code");
    }

    /// Builds the rendered documentation topics from DocsData. The source keeps
    /// both languages side by side; each topic resolves the active language once.
    static List<DocsTopic> BuildDocs() {
        List<DocsTopic> topics = new List<DocsTopic>();
        List<DocEntry> all = DocsData.All();
        for (int i = 0; i < all.Count; i = i + 1) {
            topics.Add(DocsTopic.From(all[i]));
        }
        return topics;
    }

    /// Renders the Help / documentation browser: a searchable sidebar of topics
    /// (language + GUI components) and a detail pane with a copyable code
    /// example, in the spirit of a component showcase. The whole pane is a
    /// UiNode document (auto layout) whose retained widgets (section tabs,
    /// search box, topic list) and immediate widgets (tag, code block, preview)
    /// are hosted by the registered bridge components in components/DocsBridges.
    /// All state (search text, section, selection, scroll, demo widgets) lives
    /// inside those components; the shell only supplies the frame rectangle and
    /// the IDE output log.
    static void RenderDocsPage(App app, Rect area, List<string> log) {
        // No surface fill: the dock painted this pane's surface (frosted under
        // a glass skin), and the sidebar + detail pane share that material.
        Canvas c = app.canvas;
        Theme t = app.theme;
        SignalInt sectionSig = DocsSectionTabs.Sel();
        Input search = DocsSearchHost.Search();
        SignalInt selSig = DocsTopicList.SelSig();

        List<DocsTopic> docs = DocsPage.BuildDocs();

        int sw = app.Scale(268);
        int railW = app.Scale(104);

        // Search box.
        string query = ZanIDE.ToLowerS(search.GetText());

        // Entries matching the query, whatever section they live in: the menu
        // opens the groups that have a hit, so a search reaches every section.
        List<int> hit = new List<int>();
        for (int fi = 0; fi < docs.Count; fi = fi + 1) {
            DocsTopic docTopic = docs[fi];
            string hay = ZanIDE.ToLowerS(docTopic.title + " "
                + docTopic.category + " " + docTopic.body);
            if (ZanIDE.ContainsS(hay, query)) { hit.Add(fi); }
        }

        // The section the rail is on, and a selection that belongs to it: a
        // search jumps the rail to the first hit, and picking another section
        // opens that section's first topic.
        int openSec = sectionSig.Get();
        if (openSec < 0 || openSec >= DocsData.SectionCount()) { openSec = 0; }
        bool searching = query.Length > 0;
        int selAbs = selSig.Get();
        bool selOk = hit.IndexOf(selAbs) >= 0 && docs[selAbs].section == openSec;
        if (!selOk && searching && hit.Count > 0
                && (selAbs < 0 || hit.IndexOf(selAbs) < 0)) {
            openSec = docs[hit[0]].section;
            sectionSig.Set(openSec);
        }
        if (!selOk) {
            selAbs = 0 - 1;
            for (int h0 = 0; h0 < hit.Count; h0 = h0 + 1) {
                if (docs[hit[h0]].section == openSec) { selAbs = hit[h0]; break; }
            }
            selSig.Set(selAbs);
        }

        // Topic list: the entries of the selected section (a search reaches
        // every section, and then the rail follows the hit). Sections live in
        // the vertical rail beside the list, so they never scroll away.
        List<string> secLabels = new List<string>();
        for (int sl = 0; sl < DocsData.SectionCount(); sl = sl + 1) {
            secLabels.Add(DocsData.SectionName(sl));
        }

        List<DocTopic> topics = new List<DocTopic>();
        int selRow = 0 - 1;
        string lastCat = "";
        for (int k = 0; k < hit.Count; k = k + 1) {
            int dix = hit[k];
            DocsTopic docTopic = docs[dix];
            if (docTopic.section == openSec) {
                if (docTopic.category != lastCat) {
                    topics.Add(DocTopic.Header(docTopic.category));
                    lastCat = docTopic.category;
                }
                if (dix == selAbs) { selRow = topics.Count; }
                topics.Add(DocTopic.Of(dix, docTopic.title));
            }
        }

        // Push the per-frame state into the bridge components (the signals
        // themselves live inside the components; only the frame data flows).
        DocsSearchHost.search = search;
        DocsTopicList.topics = topics;
        DocsSectionTabs.labels = secLabels;
        DocsTopicList.selRow = selRow;
        DocsPreviewHost.preview = "";
        DocsCodeBlockHost.copyLabel = ZanIDE.T("Copy", "复制");
        DocsCodeBlockHost.log = log;
        if (selAbs >= 0) {
            DocsTagHost.text = DocsPage.ToUpperCat(docs[selAbs].category);
            DocsTagHost.cls = "primary";
        }

        // Menu document: search + the grouped topic tree, a vertical tree of
        // collapsible sections rather than a row of tabs.
        UiNode side = UiNode.Column().Dock("left").Width(sw).Pad(12).Gap(8);
        side.Child(UiNode.Of("DocsSearchHost").Dock("top").Height(app.theme.heightMedium));
        side.Child(UiNode.Of("DocsTopicList").Dock("fill"));

        UiNode root = UiNode.Row().Dock("fill");
        root.Child(UiNode.Of("DocsSectionTabs").Dock("left").Width(railW));
        root.Child(side);
        if (selAbs < 0) {
            DocsCodeBlockHost.lines = null;
            UiNode empty = UiNode.Column().Dock("fill").Pad(24).Gap(8);
            empty.Child(UiNode.Label(ZanIDE.T("No topics match your search.",
                                              "没有匹配搜索的主题。"))
                .Class("hint").Dock("top"));
            root.Child(empty);
        } else {
            // Detail pane: category chip, title, rule, wrapped body, live
            // preview (for widgets) and the copyable code example, stacked in
            // a ScrollColumn so a long article scrolls inside the pane.
            DocsTopic selected = docs[selAbs];
            int cw = area.width - sw - railW - app.Scale(56);
            DocsCodeBlockHost.lines = CodeEditor.SplitLines(selected.code);
            DocsCodeBlockHost.copyTitle = selected.title;
            DocsCodeBlockHost.copyText = selected.code;

            UiNode det = UiNode.Column().Dock("fill").Pad(24).Gap(10);
            det.Child(UiNode.Of("DocsTagHost").Dock("top").Height(app.Scale(22)));
            det.Child(UiNode.Label(selected.title).Class("large").Dock("top"));
            det.Child(UiNode.Of("Divider").Dock("top").Height(1));
            det.Child(UiNode.Label(selected.body).Class("secondary")
                .Str("wrap", "true").Width(cw - app.Scale(60)).Dock("top"));
            if (selected.category == ZanIDE.T("GUI - Widgets", "GUI - 组件")) {
                DocsPreviewHost.preview = selected.title;
                det.Child(UiNode.Of("DocsPreviewHost").Dock("top"));
            }
            det.Child(UiNode.Of("DocsCodeBlockHost").Dock("top"));

            UiNode scroll = UiNode.Of("ScrollColumn").Dock("fill");
            scroll.Child(det);
            root.Child(scroll);
        }

        UiDoc doc = UiDoc.FromJson(root.ToJson());
        doc.Wire();
        doc.RenderInto(app, area.x, area.y, area.width, area.height);
    }

    static int RenderComponentPreview(
        App app,
        Theme t,
        string name,
        int x,
        int y,
        int w,
        SignalBool demoBool,
        SignalInt demoInt,
        Input demoInput
    ) {
        DocsPage.EnsureDemos();
        int h = app.Scale(142);
        new Card(ZanIDE.T("LIVE STATES", "实时状态")).RenderInside(app,
            new Rect(x, y, w, h));
        int px = x + app.Scale(18);
        int py = y + app.Scale(44);
        bool rendered = true;
        if (name == "Button") {
            new Button { Text = "Default" }.Render(app, px, py, app.Scale(104));
            new Button { Text = "Primary", Class = "primary" }.Render(
                app, px + app.Scale(116), py, app.Scale(104));
            new Button { Text = "Disabled", Disabled = true }.Render(
                app, px + app.Scale(232), py, app.Scale(104));
        } else if (name == "Label") {
            DocsPage.lblTitle.Text = "Title";
            DocsPage.lblTitle.RenderAt(app, px, py);
            DocsPage.lblDefault.Text = "Default label";
            DocsPage.lblDefault.RenderAt(app, px, py + app.Scale(34));
            DocsPage.lblSecondary.Text = "Secondary";
            DocsPage.lblSecondary.RenderAt(app, px + app.Scale(170), py + app.Scale(34));
        } else if (name == ZanIDE.T("Text Input", "文本输入框")) {
            demoInput.Render(app, px, py, app.Scale(260), t.heightMedium);
        } else if (name == "Checkbox") {
            DocsPage.demoCheck.Render(app, px, py);
        } else if (name == ZanIDE.T("Radio Group", "单选组")) {
            DocsPage.demoRadioA.Render(app, px, py, "Option A");
            DocsPage.demoRadioB.Render(
                app, px + app.Scale(130), py, "Option B");
        } else if (name == "Switch") {
            DocsPage.demoSwitch.Render(app, px, py);
            DocsPage.lblSwitch.Text = ZanIDE.T("Interactive state", "可交互状态");
            DocsPage.lblSwitch.RenderAt(app, px + app.Scale(62), py + app.Scale(6));
        } else if (name == "Slider") {
            DocsPage.demoSlider.Render(app, px, py, app.Scale(300));
            DocsPage.lblSlider.Text = Convert.ToString(DocsPage.demoModel.level);
            DocsPage.lblSlider.RenderAt(app, px + app.Scale(320), py);
        } else if (name == ZanIDE.T("Select (Dropdown)", "下拉选择")) {
            DocsPage.demoSelect.Render(app, px, py, app.Scale(220));
        } else if (name == "Tabs") {
            DocsPage.demoTabs.Render(app, px, py, app.Scale(420));
        } else if (name == "Card") {
            new Card("Card").RenderInside(app,
                new Rect(px, py - app.Scale(8), app.Scale(360),
                            app.Scale(90)));
            DocsPage.lblCard.Text = ZanIDE.T("Card content and actions", "卡片内容与操作");
            DocsPage.lblCard.RenderAt(app, px + app.Scale(14),
                Card.ContentY(py - app.Scale(8), t));
        } else if (name == "Progress") {
            new Progress(68, 0).RenderAt(app, px, py, app.Scale(320));
            new Progress(42, 1).RenderAt(app, px, py + app.Scale(42),
                                        app.Scale(320));
        } else if (name == "Tag") {
            Tag.Chip(app, px, py, "Default", "");
            Tag.Chip(app, px + app.Scale(100), py, "Success", "success");
            Tag.Chip(app, px + app.Scale(200), py, "Warning", "warning");
            Tag.Chip(app, px + app.Scale(300), py, "Error", "error");
        } else if (name == "Alert") {
            Layer.DrawNotify(
                app, px, py - app.Scale(8), w - app.Scale(36),
                ZanIDE.T("Build succeeded — the executable is ready.",
                         "构建成功 — 可执行文件已准备就绪。"), 3);
        } else if (name == "Tooltip") {
            new Button { Text = ZanIDE.T("Hover target", "悬停目标") }.Render(
                app, px, py, app.Scale(130));
            Tooltip.Render(
                app, px + app.Scale(150), py,
                ZanIDE.T("Helpful context", "辅助说明"));
        } else if (name == "Avatar") {
            new Avatar("Z", 42, "").RenderAt(app, px, py);
            new Avatar("", 42, "user").RenderAt(app, px + app.Scale(72), py);
        } else if (name == "Badge") {
            Badge.Dot(app, px + app.Scale(10), py + app.Scale(10));
            Badge.CountAt(app, px + app.Scale(90), py, 12);
        } else if (name == "Divider") {
            new Divider(ZanIDE.T("Section", "区段")).RenderInside(app,
                new Rect(px, py, w - app.Scale(36), app.Scale(24)));
        } else if (name == "Empty") {
            new Empty(ZanIDE.T("No data", "暂无数据")).RenderInside(app,
                new Rect(px, py - app.Scale(20), w - app.Scale(36),
                            app.Scale(96)));
        } else if (name == "ListView") {
            if (DocsPage.previewList == null) {
                List<string> items = new List<string>{ "Alpha", "Beta", "Gamma" };
                DocsPage.previewList =
                    new ListView<string>(new ListColumn<string>("", s => s));
                DocsPage.previewList.Class = "flat";
                DocsPage.previewList.Bind(items);
            }
            DocsPage.previewList.RenderInside(app,
                new Rect(px, py - app.Scale(14), app.Scale(260),
                            app.Scale(96)));
        } else if (name == "Loading") {
            new Spin(36).RenderAt(app, px + app.Scale(12),
                                  py + app.Scale(6));
        } else if (name == "Skeleton") {
            Skeleton dot = new Skeleton(40, 40);
            dot.Class = "circle";
            dot.RenderAt(app, px, py);
            Skeleton.Line(app, app.Scale(260))
                .RenderAt(app, px + app.Scale(58), py);
            new Skeleton(180, 14)
                .RenderAt(app, px + app.Scale(58), py + app.Scale(30));
        } else if (name == "Statistic") {
            new Statistic(ZanIDE.T("Active users", "活跃用户"), "12,480")
                .RenderAt(app, px, py);
        } else if (name == "Typography") {
            Typography.Heading(app, px, py - app.Scale(12), "Heading", 2);
            Typography.Paragraph(
                app, px, py + app.Scale(34),
                ZanIDE.T(
                    "Readable paragraph text for application content.",
                    "用于应用内容的易读段落文本。"));
        } else if (name == "Breadcrumb") {
            List<string> crumbs = new List<string>{ "Home", "Components", "Breadcrumb" };
            Breadcrumb.Of(crumbs).RenderAt(app, px, py);
        } else if (name == "Carousel") {
            List<string> slides = new List<string>{ "First state", "Second state" };
            Carousel.Of(slides, demoInt).RenderInside(app,
                new Rect(px, py - app.Scale(18), w - app.Scale(36),
                            app.Scale(92)));
        } else if (name == "Chart") {
            List<string> labels = new List<string>{ "Q1", "Q2", "Q3", "Q4" };
            List<int> values = new List<int>{ 12, 28, 20, 35 };
            ChartOption opt = ChartOption.With(ChartType.Line, "", labels);
            opt.Add("Series", values);
            ChartView.Of(opt).Render(
                app, px, py - app.Scale(24),
                w - app.Scale(36), app.Scale(104));
        } else if (name == "Collapse") {
            List<CollapsePanel> panels = new List<CollapsePanel>{
                new CollapsePanel("General", "General settings"),
                new CollapsePanel("Advanced", "Advanced settings") };
            Collapse.Of(panels, demoInt)
                .RenderAt(app, px, py - app.Scale(18), w - app.Scale(36));
        } else if (name == "DataTable") {
            List<DataColumn> cols = new List<DataColumn>{
                DataColumn.Text("Name", app.Scale(160)),
                DataColumn.Numeric("Score", app.Scale(100)) };
            List<DataRow> rows = new List<DataRow>();
            DataRow row = new DataRow();
            row.Push("Zan"); row.Push("98"); rows.Add(row);
            DataTableState state = new DataTableState();
            DataTable.Render(
                app, px, py - app.Scale(18),
                w - app.Scale(36), app.Scale(100),
                cols, rows, state);
        } else if (name == "Dropdown") {
            if (DocsPage.demoDropdown == null) {
                List<string> items = new List<string>{
                    ZanIDE.T("Edit", "编辑"), ZanIDE.T("Duplicate", "复制"),
                    ZanIDE.T("Delete", "删除") };
                DocsPage.demoDropdown = new Dropdown<string>(s => s);
                DocsPage.demoDropdown.Hint(ZanIDE.T("Actions", "操作"));
                DocsPage.demoDropdown.Bind(items);
            }
            DocsPage.demoDropdown.RenderInside(app,
                new Rect(px, py, app.Scale(150), t.heightMedium));
        } else if (name == "Ellipsis") {
            string longText = ZanIDE.T(
                "A very long component example that must fit the available width",
                "一个必须适应可用宽度的超长组件示例");
            Ellipsis.Render(app, px, py, app.Scale(280), longText);
        } else if (name == "FloatButton") {
            new FloatButton("plus") { Size = app.Scale(48), Class = "primary" }
                .Render(app, px, py - app.Scale(8));
            new FloatButton("edit") { Size = app.Scale(48) }
                .Render(app, px + app.Scale(72), py - app.Scale(8));
        } else if (name == "Menu") {
            List<string> menuItems = new List<string>{ "Overview", "Settings" };
            int id = Menu.RenderVertical(
                app, px, py - app.Scale(18), app.Scale(220),
                py + app.Scale(78), app.Scale(36),
                menuItems, demoInt, 0);
            Menu.HandleClick(app, id, menuItems.Count, demoInt);
        } else if (name == "PageHeader") {
            new PageHeader(
                ZanIDE.T("Component page", "组件页面"),
                ZanIDE.T("Title, subtitle and back action", "标题、副标题与返回操作"))
                .RenderAt(app, px, py - app.Scale(12), w - app.Scale(36));
        } else if (name == "Pagination") {
            Pagination.Of(12, demoInt).RenderAt(app, px, py);
        } else if (name == "Panel") {
            Panel box = new Panel("panel")
                .Titled(ZanIDE.T("Panel title", "面板标题"));
            box.RenderInside(app, new Rect(px, py - app.Scale(18),
                                             w - app.Scale(36), app.Scale(96)));
            Rect content = box.Inner();
            DocsPage.lblPanel.Text = ZanIDE.T("Panel content", "面板内容");
            DocsPage.lblPanel.RenderAt(app, content.x, content.y);
        } else if (name == "PivotTable") {
            List<DataRow> rows = new List<DataRow>();
            DataRow p0 = new DataRow();
            p0.Push("North"); p0.Push("2026"); p0.Push("42"); rows.Add(p0);
            DataRow p1 = new DataRow();
            p1.Push("South"); p1.Push("2026"); p1.Push("35"); rows.Add(p1);
            PivotConfig cfg = new PivotConfig(0, 1, 2, 0);
            PivotTable.Render(
                app, px, py - app.Scale(18),
                w - app.Scale(36), app.Scale(100), rows, cfg);
        } else if (name == "Popover") {
            Popover.Render(
                app, px, py - app.Scale(12),
                app.Scale(280), app.Scale(90),
                ZanIDE.T("Popover", "气泡卡片"),
                ZanIDE.T("Anchored explanatory content.", "锚定的说明内容。"));
        } else if (name == "Rate") {
            DocsPage.demoRate.Render(app, px, py);
        } else if (name == "Result") {
            Result res = new Result(
                ZanIDE.T("Operation complete", "操作完成"),
                ZanIDE.T("The requested action succeeded.", "请求的操作已成功。"));
            res.Class = Result.StatusClass(1);
            res.RenderAt(app, px, py - app.Scale(28), w - app.Scale(36));
        } else if (name == "Ribbon") {
            List<RibbonCmd> commands = new List<RibbonCmd>{
                RibbonCmd.Group("play", "Run"), new RibbonCmd("build", "Build") };
            Ribbon.Render(
                app, px, py - app.Scale(18),
                w - app.Scale(36), Ribbon.Height(app), commands);
        } else if (name == "Scrollbar") {
            // Demo surface through the component's own style, so the skin's
            // `panel` surface (translucent under the illustrated packs) applies.
            StyleBox sb = Style.Of(app, "panel", "", Style.SNormal());
            sb.Paint(app, px, py - app.Scale(12), app.Scale(280), app.Scale(90));
            Scrollbar.RenderVertical(
                app, px + app.Scale(270), py - app.Scale(12),
                app.Scale(90), app.Scale(360), app.Scale(90));
        } else if (name == "Spin") {
            new Spin(36).RenderAt(app, px + app.Scale(8), py + app.Scale(2));
            Spin load = new Spin(36);
            load.Tip = ZanIDE.T("Loading data...", "正在加载数据...");
            load.RenderInside(app, new Rect(px + app.Scale(80),
                                               py - app.Scale(18),
                                               app.Scale(240),
                                               app.Scale(90)));
        } else if (name == "Steps") {
            List<string> steps = new List<string>{ "Details", "Review", "Done" };
            Steps.Of(steps, demoInt).RenderAt(app, px, py,
                                              w - app.Scale(36));
        } else if (name == "Table") {
            List<string> columns = new List<string>{ "Name", "Status" };
            List<int> widths = new List<int>{ app.Scale(200), app.Scale(140) };
            Table.RenderHeader(app, px, py - app.Scale(14), columns, widths);
            List<string> cells = new List<string>{ "Zan", "Ready" };
            Table.RenderRow(
                app, px, py - app.Scale(14) + t.heightMedium,
                cells, widths, true);
        } else if (name == "Timeline") {
            List<TimelineItem> items = new List<TimelineItem>{
                new TimelineItem("", "Created", "Project initialized"),
                new TimelineItem("", "Published", "Executable generated") };
            Timeline.Of(items)
                .RenderAt(app, px, py - app.Scale(20), w - app.Scale(36));
        } else if (name == "TreeView") {
            List<TreeNode> nodes = new List<TreeNode>{
                TreeNode.Dir("src", 0, true), TreeNode.FileIcon("main.zan", 1, "file") };
            TreeView demoTree = new TreeView();
            demoTree.BindSel(demoInt).Bind(nodes);
            demoTree.RenderInside(app, new Rect(
                px, py - app.Scale(18),
                app.Scale(280), app.Scale(96)));
        } else {
            rendered = false;
        }
        if (!rendered) {
            DocsPage.lblFallbackIcon.Size = app.Scale(30);
            DocsPage.lblFallbackIcon.RenderAt(app, px, py);
            DocsPage.lblFallbackA.Text = ZanIDE.T("Interactive / overlay example", "交互式 / 浮层示例");
            DocsPage.lblFallbackA.RenderAt(app, px + app.Scale(46), py);
            DocsPage.lblFallbackB.Text = ZanIDE.T("Copy the current API example below.", "复制下方当前 API 示例。");
            DocsPage.lblFallbackB.RenderAt(app, px + app.Scale(46), py + app.Scale(28));
        }
        return h;
    }

    /// Renders a category label as an uppercase-ish section header. (Kept simple:
    /// returns the category text prefixed for visual separation.)
    static string ToUpperCat(string s) {
        return s;
    }

}
