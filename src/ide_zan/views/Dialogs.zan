using System;
using Gui;
using Gui.Widget;

/// The shell's modal dialogs, extracted from ZanIDE: Publish targets,
/// Project Config (resources/links) and the template-based New
/// Project / New File picker.
class Dialogs {
    /// Renders the modal Publish dialog. Returns 0 (none), 1 (publish), 2 (cancel).
    /// Lists only the targets this IDE host can build (host-aware, see
    /// ZanIDE.PublishTargetIds): Windows or macOS x64/ARM64 for the native OS
    /// plus Linux x64/ARM64 (musl static). All rows are toggleable.
    static int RenderPublishDialog(App app, string root, string projName, List<int> sel) {
        // Rendered into its OWN top-level child window (App.CreateDark): fills the
        // client area below the title-bar chrome. No scrim / hit-blocking -- the
        // OS routes events, so nothing can fall through to the main window.
        Canvas c = app.canvas;
        Theme t = app.theme;
        int top = app.ContentTop();
        int x = 0;
        int y = top;
        int w = c.Width();
        int h = c.Height() - top;

        int pad = app.Scale(18);
        app.canvas.DrawStyledText(
            Style.Of(app, "label", "secondary small", Style.SNormal()),
            x + pad, y + pad + app.Scale(24), ZanIDE.T("Project: ", "项目：") + projName,
            app.theme.textPrimary, app.theme.fontSizeMedium);
        app.canvas.DrawStyledText(
            Style.Of(app, "label", "secondary small", Style.SNormal()),
            x + pad, y + app.Scale(72), ZanIDE.T("Platforms", "目标平台"),
            app.theme.textPrimary, app.theme.fontSizeMedium);

        // Host-aware: only the targets this IDE host can build are shown
        // (Windows or macOS + Linux); see ZanIDE.PublishTargetIds.
        List<string> pids = ZanIDE.PublishTargetIds();
        List<string> disp = new List<string>();
        int di = 0;
        while (di < pids.Count) { disp.Add(ZanIDE.PublishTargetLabel(pids[di])); di = di + 1; }

        int rowH = app.Scale(30);
        int listX = x + pad;
        int listY = y + app.Scale(94);
        int boxSize = app.Scale(18);
        int clicked = 0 - 1;

        int i = 0;
        while (i < disp.Count) {
            int ry = listY + i * rowH;
            bool on = i < sel.Count && sel[i] == 1;
            SignalBool model = SignalBool.Create(on);
            Checkbox.Bind(disp[i], model).Render(app, listX, ry);
            if (model.Get() != on) { clicked = i; }
            i = i + 1;
        }

        if (clicked >= 0 && clicked < sel.Count) {
            if (sel[clicked] == 1) { sel[clicked] = 0; } else { sel[clicked] = 1; }
            app.RequestRedraw();
        }

        app.canvas.DrawStyledText(
            Style.Of(app, "label", "secondary small", Style.SNormal()),
            x + pad, listY + disp.Count * rowH + app.Scale(8), ZanIDE.T("Linux is cross-compiled here as a static single file.", "Linux 为本机交叉编译的静态单文件产物。"),
            app.theme.textPrimary, app.theme.fontSizeMedium);
        app.canvas.DrawStyledText(
            Style.Of(app, "label", "secondary small", Style.SNormal()),
            x + pad, listY + disp.Count * rowH + app.Scale(8) + app.Scale(16), ZanIDE.T("Run it on Linux (a server or container).", "需在 Linux（服务器或容器）上运行。"),
            app.theme.textPrimary, app.theme.fontSizeMedium);

        // ---- Windows single-file packaging (project setting, persisted in zan.proj) ----
        int sfY = listY + disp.Count * rowH + app.Scale(8) + app.Scale(40);
        if (ZanIDE.IsLibraryProject(root)) {
            // Library project: single-file packing does not apply; offer the
            // static-archive companion output instead (persisted in zan.proj).
            bool slOn = ZanIDE.ProjStaticLib(root);
            SignalBool slModel = SignalBool.Create(slOn);
            Checkbox.Bind(
                ZanIDE.T("Also publish static libraries (.lib on Windows, .a elsewhere)",
                         "同时发布静态库（Windows 为 .lib，其余平台为 .a）"),
                slModel).Render(app, listX, sfY);
            if (slModel.Get() != slOn) {
                string sv = "true";
                if (slOn) { sv = "false"; }
                ZanIDE.SetProjField(root, "staticLib", sv);
                app.RequestRedraw();
            }
        } else {
            bool sfOn = ZanIDE.ProjSingleFile(root);
            SignalBool sfModel = SignalBool.Create(sfOn);
            Checkbox.Bind(
                ZanIDE.T("Single-file exe (bundle DLLs into a self-extracting exe, Windows)",
                         "打包为单文件（把 DLL 打进自解压 exe，仅 Windows）"),
                sfModel).Render(app, listX, sfY);
            if (sfModel.Get() != sfOn) {
                string nv = "true";
                if (sfOn) { nv = "false"; }
                ZanIDE.SetProjField(root, "singleFile", nv);
                app.RequestRedraw();
            }
        }

        int btnH = app.Scale(30);
        int btnY = y + h - btnH - t.paddingLarge;
        int pubW = app.Scale(100);
        int canW = app.Scale(86);
        int pubX = x + w - pad - pubW;
        int canX = pubX - app.Scale(10) - canW;
        int canId = new Button { Text = ZanIDE.T("Cancel", "取消") }.Render(app, canX, btnY, canW);
        int pubId = new Button { Text = ZanIDE.T("Publish", "发布"), Class = "primary" }.Render(app, pubX, btnY, pubW);

        int action = 0;
        if (Ui.Clicked(app, pubId)) { action = 1; }
        else if (Ui.Clicked(app, canId)) { action = 2; }
        app.RenderChrome(ZanIDE.T("Publish Project", "发布项目"));
        return action;
    }
    /// Renders the modal Project Configuration dialog: application icon plus a
    /// list of static resources bundled with the app. Returns 0 (open) / 1 (done).
    static int RenderProjectConfigDialog(App app, string root, List<string> log) {
        // Rendered into its OWN top-level child window (App.CreateDark): fills the
        // client area below the title-bar chrome. No scrim / hit-blocking.
        Canvas c = app.canvas;
        Theme t = app.theme;
        int top = app.ContentTop();
        int x = 0;
        int y = top;
        int w = c.Width();
        int h = c.Height() - top;

        int pad = app.Scale(18);
        app.canvas.DrawStyledText(
            Style.Of(app, "label", "secondary small", Style.SNormal()),
            x + pad, y + pad + app.Scale(24), Path.GetFileName(root),
            app.theme.textPrimary, app.theme.fontSizeMedium);

        bool click = app.ClickAvailable();
        int action = 0;

        // ---- Application icon ----
        app.canvas.DrawStyledText(
            Style.Of(app, "label", "secondary small", Style.SNormal()),
            x + pad, y + app.Scale(74), ZanIDE.T("Application Icon", "应用图标"),
            app.theme.textPrimary, app.theme.fontSizeMedium);
        string curIco = ZanIDE.ProjField(root, "icon");
        string icoLabel = curIco;
        if (icoLabel == "") { icoLabel = ZanIDE.T("(none — the default Zan icon is used)", "（无——使用默认 Zan 图标）"); }
        app.canvas.DrawStyledText(
            Style.Of(app, "label", "", Style.SNormal()),
            x + pad, y + app.Scale(96), icoLabel,
            app.theme.textPrimary, app.theme.fontSizeMedium);

        int bH = app.Scale(28);
        int chooseW = app.Scale(120);
        int chooseX = x + w - pad - chooseW;
        int chooseY = y + app.Scale(90);
        int chooseId = new Button { Text = ZanIDE.T("Choose .ico...", "选择 .ico..."), Class = "primary small" }.Render(app, chooseX, chooseY, chooseW);
        int clearW = app.Scale(58);
        int clearX = chooseX - app.Scale(8) - clearW;
        int clearId = new Button { Text = ZanIDE.T("Clear", "清除"), Class = "small" }.Render(app, clearX, chooseY, clearW);

        app.canvas.FillRect(x + 1, y + app.Scale(130), w - 2,
            Style.Of(app, "divider", "", Style.SNormal()).HeightOr(1),
            Style.Of(app, "divider", "", Style.SNormal()).BgOr(app.theme.divider));

        // ---- Resources (managed in the Asset Manager) ----
        // Resource management (import / copy / link / embed-vs-copy) now lives in
        // one place: the Asset Manager. This dialog only summarizes and links out.
        app.canvas.DrawStyledText(
            Style.Of(app, "label", "secondary small", Style.SNormal()),
            x + pad, y + app.Scale(142), ZanIDE.T("Resources", "资源"),
            app.theme.textPrimary, app.theme.fontSizeMedium);

        List<string> res = ZanIDE.ListResources(root);
        List<string> lnks = ZanIDE.ProjLinks(root);
        int amW = app.Scale(150);
        int amX = x + w - pad - amW;
        int amY = y + app.Scale(138);
        int amId = new Button { Text = ZanIDE.T("Open Asset Manager", "打开资源管理器"), Class = "primary small" }.Render(app, amX, amY, amW);

        app.canvas.DrawStyledText(
            Style.Of(app, "label", "", Style.SNormal()),
            x + pad, y + app.Scale(180), Convert.ToString(res.Count) + ZanIDE.T(" copied asset(s), ", " 个复制资源，") + Convert.ToString(lnks.Count) + ZanIDE.T(" linked", " 个链接资源"),
            app.theme.textPrimary, app.theme.fontSizeMedium);
        app.canvas.DrawStyledText(
            Style.Of(app, "label", "secondary small", Style.SNormal()),
            x + pad, y + app.Scale(206), ZanIDE.T("Import files/folders, link resources, choose embed vs copy, and author", "在资源管理器中导入文件/文件夹、链接资源、选择嵌入或复制，并编辑"),
            app.theme.textPrimary, app.theme.fontSizeMedium);
        app.canvas.DrawStyledText(
            Style.Of(app, "label", "secondary small", Style.SNormal()),
            x + pad, y + app.Scale(222), ZanIDE.T("8-direction / frame-sequence animations — all in the Asset Manager.", "八方向 / 序列帧动画——全部集中在资源管理器。"),
            app.theme.textPrimary, app.theme.fontSizeMedium);

        app.canvas.DrawStyledText(
            Style.Of(app, "label", "secondary small", Style.SNormal()),
            x + pad, y + h - app.Scale(58), ZanIDE.T("Resources are copied next to the published .exe (publish/assets).", "资源会复制到发布的 .exe 旁（publish/assets）。"),
            app.theme.textPrimary, app.theme.fontSizeMedium);
        app.canvas.DrawStyledText(
            Style.Of(app, "label", "secondary small", Style.SNormal()),
            x + pad, y + h - app.Scale(44), ZanIDE.T("The icon is embedded into the .exe on Build/Run/Publish.", "图标会在 构建/运行/发布 时嵌入 .exe。"),
            app.theme.textPrimary, app.theme.fontSizeMedium);

        // ---- Done ----
        int dbH = app.Scale(30);
        int dbW = app.Scale(100);
        int dbX = x + w - pad - dbW;
        int dbYb = y + h - dbH - t.paddingLarge;
        int doneId = new Button { Text = ZanIDE.T("Done", "完成"), Class = "primary" }.Render(app, dbX, dbYb, dbW);

        // ---- Click handling (after drawing so geometry is known) ----
        if (Ui.Clicked(app, chooseId)) {
            action = 2;
        } else if (Ui.Clicked(app, clearId)) {
            ZanIDE.SetProjectIcon(root, "");
            log.Add("> App icon cleared (default icon will be used).");
            app.RequestRedraw();
        } else if (Ui.Clicked(app, amId)) {
            action = 5;
        } else if (Ui.Clicked(app, doneId)) {
            action = 1;
        }
        app.RenderChrome(ZanIDE.T("Project Configuration", "项目配置"));
        return action;
    }
    /// Renders a modal template picker: a selectable list on the left, a name
    /// field (+ optional location field) on the right, and Create/Cancel.
    /// Returns 0 none, 1 create, 2 cancel.
    static int RenderTemplateDialog(App app, string title, List<string> names, List<string> icons,
                                    List<string> descs, SignalInt sel, Input nameInput, Input locInput,
                                    bool showLoc) {
        Canvas c = app.canvas;
        Theme t = app.theme;
        int w = app.Scale(700);
        int h = app.Scale(440);
        int closeId = Layer.Modal(app, w, h, title);
        int x = (c.Width() - w) / 2;
        int y = (c.Height() - h) / 2;
        int pad = t.paddingLarge;
        int contentY = y + pad + t.heightMedium + t.paddingMedium;

        int listW = app.Scale(250);
        int listX = x + pad;
        int listH = h - (contentY - y) - app.Scale(72);
        Menu.RenderVerticalIcons(app, listX, contentY, listW, listH,
            app.Scale(42), names, icons, sel);

        int fx = listX + listW + pad;
        int fw = x + w - pad - fx;
        int fy = contentY;

        app.canvas.DrawStyledText(
            Style.Of(app, "label", "secondary small", Style.SNormal()),
            fx, fy, ZanIDE.T("Name", "名称"),
            app.theme.textPrimary, app.theme.fontSizeMedium);
        nameInput.Render(app, fx, fy + app.Scale(20), fw, t.heightMedium);
        int nextY = fy + app.Scale(20) + t.heightMedium + t.paddingMedium;

        if (showLoc) {
            app.canvas.DrawStyledText(
                Style.Of(app, "label", "secondary small", Style.SNormal()),
                fx, nextY, ZanIDE.T("Location", "位置"),
                app.theme.textPrimary, app.theme.fontSizeMedium);
            locInput.Render(app, fx, nextY + app.Scale(20), fw, t.heightMedium);
            nextY = nextY + app.Scale(20) + t.heightMedium + t.paddingMedium;
        }

        int s = sel.Get();
        if (s >= 0 && s < descs.Count) {
            app.canvas.DrawStyledText(
                Style.Of(app, "label", "hint small", Style.SNormal()),
                fx, nextY, descs[s],
                app.theme.textPrimary, app.theme.fontSizeMedium);
        }

        int bw = app.Scale(100);
        int by = y + h - t.heightMedium - pad;
        int okX = x + w - pad - bw;
        int cancelX = okX - t.gapMedium - bw;

        int result = 0;
        int cancelId = new Button { Text = "Cancel" }.Render(app, cancelX, by, bw);
        if (Ui.Clicked(app, cancelId)) { result = 2; }
        int okId = new Button { Text = "Create", Class = "primary" }.Render(app, okX, by, bw);
        if (Ui.Clicked(app, okId)) { result = 1; }

        if (app.ClickAvailable() && app.hitTester.HitTest(app.mouseX, app.mouseY) == closeId) {
            result = 2;
        }
        return result;
    }
}