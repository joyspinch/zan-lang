using System;

/// One documentation entry, both languages side by side: adding a topic to the
/// Help page means appending one Doc(...) call below -- the page itself renders
/// whatever this list holds, in the UI language picked at runtime.
class DocEntry {
    string catEn;
    string catZh;
    string titleEn;
    string titleZh;
    string bodyEn;
    string bodyZh;
    string code;

    static DocEntry Of(string catEn, string catZh, string titleEn, string titleZh,
                       string bodyEn, string bodyZh, string code) {
        DocEntry d = new DocEntry();
        d.catEn = catEn;
        d.catZh = catZh;
        d.titleEn = titleEn;
        d.titleZh = titleZh;
        d.bodyEn = bodyEn;
        d.bodyZh = bodyZh;
        d.code = code;
        return d;
    }

    string Cat() { return ZanIDE.T(catEn, catZh); }
    /// The language-independent category, used to group entries into sections.
    string CatEn() { return catEn; }
    string Title() { return ZanIDE.T(titleEn, titleZh); }
    string Body() { return ZanIDE.T(bodyEn, bodyZh); }

    /// The sample, with the GUI imports prepended for widget entries so every
    /// widget snippet compiles as shown.
    string Code() {
        if (catEn == "GUI - Widgets" && !ZanIDE.Has(code, "using Gui;")) {
            return "using System;\nusing Gui;\nusing Gui.Widget;\n\n" + code;
        }
        return code;
    }
}

/// The Help page's content, as data. Nothing here knows about layout: the
/// order of this list is the order of the topic tree, and the category names
/// group the entries (see DocsPage.DocSection for the section tabs).
class DocsData {
    static List<DocEntry> cache;

    /// Every documentation entry, built once per process.
    static List<DocEntry> All() {
        if (DocsData.cache != null) { return DocsData.cache; }
        List<DocEntry> d = new List<DocEntry>();
        DocsData.Part1(d);
        DocsData.Part2(d);
        DocsData.Part3(d);
        DocsData.Part4(d);
        DocsData.Part5(d);
        DocsData.Part6(d);
        DocsData.PartNet(d);
        DocsData.PartDb(d);
        DocsData.cache = d;
        return d;
    }

    static void Part1(List<DocEntry> d) {
        DocsData.Doc(d, "Getting Started", "入门",
            "Hello World",
            "Hello World",
            "Every Zan program starts in a static Main method. Console.WriteLine prints a line to standard output.",
            "每个 Zan 程序都从静态 Main 方法开始。Console.WriteLine 向标准输出打印一行。",
            "using System;\n\nclass Program {\n    static void Main() {\n        Console.WriteLine(\"Hello, Zan!\");\n    }\n}");
        DocsData.Doc(d, "Getting Started", "入门",
            "Comments",
            "注释",
            "Use // for a single-line comment and /* ... */ for a block comment. Comments are ignored by the compiler.",
            "使用 // 写单行注释，使用 /* ... */ 写块注释。注释会被编译器忽略。",
            "// a single-line comment\nint x = 1; // trailing comment\n/*\n  a block comment\n  spanning lines\n*/");
        DocsData.Doc(d, "Language", "语言",
            "Variables & Types",
            "变量与类型",
            "Declare a variable with its type followed by a name. Common built-in types are int, double, bool and string.",
            "声明变量时先写类型再写名称。常见内置类型有 int、double、bool 和 string。",
            "int count = 3;\ndouble ratio = 0.5;\nbool ready = true;\nstring name = \"Zan\";");
        DocsData.Doc(d, "Language", "语言",
            "Operators",
            "运算符",
            "Arithmetic (+ - * / %), comparison (== != < > <= >=) and logical (&& || !) operators work as in C-family languages.",
            "算术（+ - * / %）、比较（== != < > <= >=）和逻辑（&& || !）运算符与 C 系语言一致。",
            "int sum = a + b;\nbool equal = (a == b);\nbool both = ready && equal;\nint rem = a % b;");
        DocsData.Doc(d, "Language", "语言",
            "If / Else",
            "If / Else 条件",
            "Branch with if/else if/else. Conditions are boolean expressions.",
            "使用 if / else if / else 分支。条件为布尔表达式。",
            "if (score >= 90) {\n    grade = \"A\";\n} else if (score >= 80) {\n    grade = \"B\";\n} else {\n    grade = \"C\";\n}");
        DocsData.Doc(d, "Language", "语言",
            "While Loop",
            "While 循环",
            "A while loop repeats while its condition holds. Use it when the number of iterations is not known up front; prefer for when you are counting and foreach when you are walking a collection.",
            "while 在条件成立时反复执行。适合次数事先未知的循环；计数用 for，遍历集合用 foreach。",
            "// while suits loops with no fixed count: read until the stream ends\nstring buffer = \"\";\nwhile (true) {\n    string chunk = reader.Read(4096);\n    if (chunk.Length == 0) { break; }\n    buffer = buffer + chunk;\n}\n\n// counting loops read better as for, and collections as foreach\nfor (int i = 0; i < 10; i = i + 1) { Console.WriteLine(Convert.ToString(i)); }"); 
        DocsData.Doc(d, "Language", "语言",
            "For Loop",
            "For 循环",
            "A for loop packs initialization, condition and step into one header.",
            "for 循环把初始化、条件和步进合并到一个头部。",
            "for (int i = 0; i < 10; i = i + 1) {\n    Console.WriteLine(Convert.ToString(i));\n}");
        DocsData.Doc(d, "Language", "语言",
            "Foreach Loop",
            "Foreach 循环",
            "foreach visits every item in a collection without manually managing an index.",
            "foreach 会依次访问集合中的每个元素，不需要手动维护索引。",
            "List<int> numbers = new List<int> { 7, 11 };\nforeach (int number in numbers) {\n    Console.WriteLine(Convert.ToString(number));\n}");
        DocsData.Doc(d, "Language", "语言",
            "String Interpolation",
            "字符串插值",
            "Prefix a string with $ and place expressions inside braces to format readable output.",
            "在字符串前加 $，并把表达式放进花括号中，即可生成易读的格式化文本。",
            "string name = \"Zan\";\nint version = 1;\nConsole.WriteLine($\"Hello {name} v{version}\");");
        DocsData.Doc(d, "Language", "语言",
            "Functions",
            "函数",
            "Functions are static methods: return type, name, typed parameters, then a body. Use return to yield a value.",
            "函数即静态方法：返回类型、名称、带类型的参数，然后是函数体。用 return 返回值。",
            "static int Add(int a, int b) {\n    return a + b;\n}");
        DocsData.Doc(d, "Language", "语言",
            "Classes & Objects",
            "类与对象",
            "A class groups fields and methods. Fields are declared with a type; methods can read them directly.",
            "类把字段和方法组织在一起。字段带类型声明；方法可直接读取它们。",
            "class Point {\n    int x;\n    int y;\n    int Sum() { return x + y; }\n}");
        DocsData.Doc(d, "Language", "语言",
            "Creating Objects",
            "创建对象",
            "Create an instance with new, then access members with the dot operator.",
            "用 new 创建实例，然后用点运算符访问成员。",
            "Point p = new Point();\np.x = 3;\np.y = 4;\nint s = p.Sum();");
        DocsData.Doc(d, "Type System", "类型系统",
            "Constructors",
            "构造函数",
            "A constructor has the same name as the class and runs when you use new. It initializes fields.",
            "构造函数与类同名，在使用 new 时运行，用于初始化字段。",
            "class Point {\n    int x;\n    int y;\n    Point(int px, int py) {\n        x = px;\n        y = py;\n    }\n}\n\nPoint p = new Point(3, 4);");
        DocsData.Doc(d, "Type System", "类型系统",
            "Inheritance",
            "继承",
            "A class can extend a base class, inheriting its fields and methods, and override virtual methods.",
            "类可以继承基类，获得其字段和方法，并可重写虚方法。",
            "class Shape {\n    virtual double Area() { return 0.0; }\n}\n\nclass Circle : Shape {\n    double r;\n    override double Area() { return 3.14159 * r * r; }\n}");
        DocsData.Doc(d, "Type System", "类型系统",
            "Interfaces",
            "接口",
            "An interface declares methods a class must implement. Classes implement it with the : syntax.",
            "接口声明类必须实现的方法。类通过 : 语法实现接口。",
            "interface IShape {\n    double Area();\n}\n\nclass Square : IShape {\n    double side;\n    double Area() { return side * side; }\n}");
        DocsData.Doc(d, "Type System", "类型系统",
            "Generic Collections",
            "泛型集合",
            "List<T> is the built-in generic collection: the element type goes in angle brackets. Add appends, Count is the length and [i] reads an element. The same List<T> works for any element type.",
            "List<T> 是内置的泛型集合：元素类型写在尖括号中。Add 追加，Count 为长度，[i] 读取元素。同一个 List<T> 适用于任意元素类型。",
            "List<int> numbers = new List<int> { 1, 2, 3 };\n\nint sum = 0;\nforeach (int n in numbers) {\n    sum = sum + n;\n}\nConsole.WriteLine(\"sum = \" + Convert.ToString(sum));\n\nList<string> names = new List<string> { \"Zan\", \"lang\" };\nConsole.WriteLine(names[0] + \" \" + names[1]);");
        DocsData.Doc(d, "Type System", "类型系统",
            "Nullable Values",
            "可空值",
            "T? represents a value that may be null. Use ?? to provide a fallback value.",
            "T? 表示可能为 null 的值；使用 ?? 提供后备值。",
            "string? nickname = null;\nstring shown = nickname ?? \"anonymous\";\nConsole.WriteLine(shown);");
        DocsData.Doc(d, "Type System", "类型系统",
            "Enums",
            "枚举",
            "An enum defines a fixed set of named values.",
            "枚举定义一组固定的命名值。",
            "enum Status {\n    Pending,\n    Running,\n    Done\n}\n\nStatus current = Status.Running;");
        DocsData.Doc(d, "Collections & Strings", "集合与字符串",
            "Lists",
            "列表",
            "List<T> is a growable array. Add appends, Count is the length, and [i] indexes.",
            "List<T> 是可增长的数组。Add 追加，Count 为长度，[i] 用于索引。",
            "List<string> items = new List<string> { \"first\", \"second\" };\nint n = items.Count;\nstring a = items[0];");
        DocsData.Doc(d, "Collections & Strings", "集合与字符串",
            "Iterating a List",
            "遍历列表",
            "foreach walks every element without an index; use for when you also need the position.",
            "foreach 直接遍历每个元素，不需要索引；需要下标时再用 for。",
            "List<string> items = new List<string> { \"alpha\", \"beta\", \"gamma\" };\n\nforeach (string item in items) {\n    Console.WriteLine(item);\n}\n\n// when the position matters, index with for\nfor (int i = 0; i < items.Count; i = i + 1) {\n    Console.WriteLine(Convert.ToString(i) + \": \" + items[i]);\n}");
    }

    static void Part2(List<DocEntry> d) {
        DocsData.Doc(d, "Collections & Strings", "集合与字符串",
            "Strings",
            "字符串",
            "Strings support Length, Substring(start, len) and concatenation with +.",
            "字符串支持 Length、Substring(start, len) 以及用 + 拼接。",
            "string s = \"Zan\";\nint len = s.Length;\nstring sub = s.Substring(0, 2);\nstring joined = s + \" lang\";");
        DocsData.Doc(d, "Collections & Strings", "集合与字符串",
            "Convert & Parse",
            "转换与解析",
            "Convert.ToString formats a value as text. Convert.ToInt32 parses an integer from text.",
            "Convert.ToString 把值格式化为文本；Convert.ToInt32 从文本解析整数。",
            "int n = Convert.ToInt32(\"42\");\nstring text = Convert.ToString(n);\nConsole.WriteLine(\"n = \" + text);");
        DocsData.Doc(d, "Language", "语言",
            "Namespaces & using",
            "命名空间与 using",
            "Bring library types into scope with using at the top of the file.",
            "在文件顶部用 using 把库中的类型引入作用域。",
            "using System;\nusing Gui;\nusing Gui.Widget;");
        DocsData.Doc(d, "Files & IO", "文件与 IO",
            "Read a File",
            "读取文件",
            "File.ReadAllText reads an entire text file into a string. File.Exists checks first.",
            "File.ReadAllText 把整个文本文件读入字符串。可先用 File.Exists 检查。",
            "using System.IO;\n\nif (File.Exists(\"notes.txt\")) {\n    string content = File.ReadAllText(\"notes.txt\");\n    Console.WriteLine(content);\n}");
        DocsData.Doc(d, "Files & IO", "文件与 IO",
            "Write a File",
            "写入文件",
            "File.WriteAllText writes a string to a file, creating or overwriting it.",
            "File.WriteAllText 把字符串写入文件，若不存在则创建，存在则覆盖。",
            "using System.IO;\n\nFile.WriteAllText(\"out.txt\", \"Hello from Zan\");");
        DocsData.Doc(d, "Files & IO", "文件与 IO",
            "List a Directory",
            "列出目录",
            "Directory.GetFiles returns the files in a folder; loop over them by index.",
            "Directory.GetFiles 返回文件夹中的文件；按索引遍历它们。",
            "using System.IO;\n\nList<string> files = Directory.GetFiles(\".\");\nforeach (string file in files) {\n    Console.WriteLine(file);\n}");
        DocsData.Doc(d, "GUI - Basics", "GUI - 基础",
            "Create a Window",
            "创建窗口",
            "App.CreateDark(title, width, height) opens a dark-themed window. app.Run drives the whole loop: events, redraw and window chrome.",
            "App.CreateDark(title, width, height) 打开一个深色主题窗口。app.Run 驱动整个循环：事件、重绘和窗口外框。",
            "using System;\nusing Gui;\n\nclass Program {\n    static void Main() {\n        App app = App.CreateDark(\"My App\", 800, 600);\n        app.Run(\"My App\");\n    }\n}");
        DocsData.Doc(d, "GUI - Basics", "GUI - 基础",
            "Custom Drawing Loop",
            "自定义绘制循环",
            "To draw your own content, run the frame loop yourself and paint with the Canvas each frame.",
            "若要绘制自定义内容，可自行运行帧循环，并在每帧用 Canvas 绘制。",
            "using Gui;\n\nclass Program {\n    static void Main() {\n        App app = App.CreateDark(\"My App\", 800, 600);\n        app.Show();\n        while (app.isRunning) {\n            if (!app.ProcessEvent()) { break; }\n            if (!app.needsRedraw) { continue; }\n            app.BeginFrame();\n            app.canvas.DrawText(40, 80, \"Hello\", app.theme.textPrimary, 16);\n            app.RenderChrome(\"My App\");\n            app.PresentFrame();\n        }\n    }\n}");
        DocsData.Doc(d, "GUI - Basics", "GUI - 基础",
            "Reactive State",
            "响应式状态",
            "SignalInt, SignalBool and SignalString hold widget state. Get reads the current value; Set updates it and requests a redraw through the bound widget.",
            "SignalInt、SignalBool 和 SignalString 保存组件状态。Get 读取当前值，Set 更新状态；绑定的组件会据此重绘。",
            "using Gui;\n\nSignalInt count = SignalInt.Create(0);\nSignalBool enabled = SignalBool.Create(true);\nSignalString name = SignalString.Create(\"Zan\");\n\ncount.Set(count.Get() + 1);");
        DocsData.Doc(d, "GUI - Widgets", "GUI - 组件",
            "Button",
            "Button",
            "new Button { Text = \"Save\", Class = \"primary\" } declares a button; Render draws it (x, y, width) and returns its id. Ui.Clicked tests for a click this frame.",
            "new Button { Text = \"保存\", Class = \"primary\" } 声明按钮；Render 绘制它（x, y, width）并返回 id。Ui.Clicked 判断本帧是否被点击。",
            "Button b = new Button { Text = \"Save\" };\nint id = b.Render(app, 40, 80, 120);\nif (Ui.Clicked(app, id)) {\n    Console.WriteLine(\"clicked\");\n}");
        DocsData.Doc(d, "GUI - Widgets", "GUI - 组件",
            "Label",
            "Label",
            "Labels draw static text; classes pick the size and colour (secondary/hint, tiny/small/large/title).",
            "Label 绘制静态文本；字号与颜色由 class 决定（secondary/hint，tiny/small/large/title）。",
            "Label title = new Label { Text = \"A big title\", Class = \"title\" };\ntitle.RenderInside(app, new Rect(40, 40, 240, 30));\nnew Label { Text = \"subtle caption\", Class = \"secondary\" }\n    .RenderInside(app, new Rect(40, 74, 240, 24));");
        DocsData.Doc(d, "GUI - Widgets", "GUI - 组件",
            "Text Input",
            "文本输入框",
            "Input binds a plain string field via `.data` (compiler-lowered two-way binding). Construct with a hint, assign `.data`, then Render each frame.",
            "Input 通过 `.data`（编译器降级的双向绑定）绑定一个普通字符串字段。用提示文本构造，赋值 `.data`，每帧 Render。",
            "class Form { string name; }\nForm form = new Form();\nInput name = new Input(\"your name\");\nname.data = form.name;   // two-way binding\nname.Render(app, 40, 80, 200, 28);");
        DocsData.Doc(d, "GUI - Widgets", "GUI - 组件",
            "Checkbox",
            "Checkbox",
            "Checkbox binds a plain bool field via `.data`; the field tracks the checked state both ways.",
            "Checkbox 通过 `.data` 绑定一个普通 bool 字段；字段与勾选状态双向同步。",
            "class Form { bool agree; }\nForm form = new Form();\nCheckbox agree = new Checkbox(\"I agree\");\nagree.data = form.agree;\nagree.Render(app, 40, 80);\nif (form.agree) {\n    // enabled\n}");
        DocsData.Doc(d, "GUI - Widgets", "GUI - 组件",
            "Radio Group",
            "单选组",
            "Radio buttons bind the SAME int field via `.data`; each has a distinct option value.",
            "多个单选按钮通过 `.data` 绑定同一个 int 字段；每个有各自的选项值。",
            "class Form { int choice; }\nForm form = new Form();\nRadio a = new Radio(SignalInt.Create(0), 0, \"Option A\");\nRadio b = new Radio(SignalInt.Create(0), 1, \"Option B\");\na.data = form.choice;\nb.data = form.choice;\na.Render(app, 40, 80, \"Option A\");\nb.Render(app, 40, 110, \"Option B\");");
        DocsData.Doc(d, "GUI - Widgets", "GUI - 组件",
            "Switch",
            "Switch",
            "A toggle switch that binds a plain bool field via `.data`.",
            "通过 `.data` 绑定普通 bool 字段的开关切换控件。",
            "class Form { bool on; }\nForm form = new Form();\nSwitch sw = new Switch();\nsw.data = form.on;\nsw.Render(app, 40, 80);");
        DocsData.Doc(d, "GUI - Widgets", "GUI - 组件",
            "Slider",
            "Slider",
            "Slider binds a plain int field via `.data`; construct with the range, then Render(app, x, y, width).",
            "Slider 通过 `.data` 绑定一个普通 int 字段；用区间构造，调用 Render(app, x, y, width)。",
            "class Form { int volume; }\nForm form = new Form();\nSlider vol = new Slider(0, 100, SignalInt.Create(50));\nvol.data = form.volume;\nvol.Render(app, 40, 80, 200);");
    }

    static void Part3(List<DocEntry> d) {
        DocsData.Doc(d, "GUI - Widgets", "GUI - 组件",
            "Select (Dropdown)",
            "下拉选择",
            "SelectBox shows a dropdown of options; the chosen index binds to a plain int field via `.data`.",
            "Select 显示下拉选项；选中的索引通过 `.data` 绑定到一个普通 int 字段。",
            "class Form { int color; }\nForm form = new Form();\nList<string> opts = new List<string> { \"Red\", \"Green\", \"Blue\" };\nSelectBox color = SelectBox.FromOptions(opts, \"pick a color\");\ncolor.data = form.color;\ncolor.Render(app, 40, 80, 200);");
        DocsData.Doc(d, "GUI - Widgets", "GUI - 组件",
            "Tabs",
            "Tabs",
            "Tabs is an instance component: Create it, Add labels, Render the strip, and read Active().",
            "Tabs 是实例组件：Create 之后 Add 标签，Render 标签条，用 Active() 读取当前索引。",
            "Tabs tabs = Tabs.Create(0);\ntabs.Add(\"General\", false);\ntabs.Add(\"Advanced\", false);\ntabs.Render(app, 40, 40, 400);\nint active = tabs.Active();");
        DocsData.Doc(d, "GUI - Widgets", "GUI - 组件",
            "Card",
            "Card",
            "Card draws a titled panel. Card.ContentY gives the y where your content should start.",
            "Card 绘制带标题的面板。Card.ContentY 给出内容应开始的 y 坐标。",
            "Card c = new Card(\"Profile\");\nc.Add(new Label { Text = \"Card body goes here\" });\nc.RenderInside(app, new Rect(40, 40, 260, 160));");
        DocsData.Doc(d, "GUI - Widgets", "GUI - 组件",
            "Progress",
            "Progress",
            "new Progress(percent, type) draws a bar; Ring() makes it a gauge, percent 0-100.",
            "new Progress(percent, type) 绘制进度条，Ring() 切换为环形，percent 为 0-100。",
            "new Progress(65, 0).RenderAt(app, 40, 80, 240);");
        DocsData.Doc(d, "GUI - Widgets", "GUI - 组件",
            "Tag",
            "Tag",
            "Tag draws a small colored label. The last argument selects the color variant.",
            "Tag 绘制一个彩色小标签。最后一个参数选择颜色样式。",
            "Tag.Chip(app, 40, 80, \"stable\", \"primary\");");
        DocsData.Doc(d, "GUI - Widgets", "GUI - 组件",
            "Alert",
            "Alert",
            "Alerts come from Layer: Layer.DrawNotify paints an inline banner, Layer.Msg / Layer.Notify queue transient ones, and LayerState.Alert opens a modal dialog. Type: 2 info, 3 success, 4 warning, 5 error.",
            "提示统一由 Layer 提供：Layer.DrawNotify 画内联横幅，Layer.Msg / Layer.Notify 推送临时提示，LayerState.Alert 打开模态对话框。类型：2 信息，3 成功，4 警告，5 错误。",
            "Layer.DrawNotify(app, 40, 80, 360, \"Your changes were saved.\", 3);");
        DocsData.Doc(d, "GUI - Widgets", "GUI - 组件",
            "Tooltip",
            "Tooltip",
            "Tooltip draws a small floating hint anchored at a point.",
            "Tooltip 在某个点绘制一个浮动的小提示。",
            "Tooltip.Render(app, 120, 80, \"More information\");");
        DocsData.Doc(d, "Project & Build", "项目与构建",
            "Project Layout",
            "项目结构",
            "A project has zan.proj describing the entry file, target platforms, icon and resources. Source files live alongside it.",
            "项目包含 zan.proj，描述入口文件、目标平台、图标和资源。源文件与它放在一起。",
            "MyApp/\n  zan.proj        // project config (entry, platforms, icon)\n  MyApp.zan       // source / code-behind\n  MyApp.zform     // visual form layout (Window App)\n  assets/         // bundled resources");
        DocsData.Doc(d, "Project & Build", "项目与构建",
            "Run & Build",
            "运行与构建",
            "Run compiles and launches the active file (or the project entry). Build produces an executable without running it.",
            "运行会编译并启动当前文件（或项目入口）。构建只生成可执行文件而不运行。",
            "// Ribbon: Run (F5) or Build.\n// A stray single file compiles on its own;\n// a project (zan.proj) compiles the whole entry.");
        DocsData.Doc(d, "Project & Build", "项目与构建",
            "Standalone Source Files",
            "独立源文件",
            "Open can load a .zan file without creating a project. The explorer remains empty; Run, Build and Debug use the file's containing folder for temporary output.",
            "“打开”可直接载入 .zan 文件而无需创建项目。资源管理器保持为空；运行、构建和调试会在文件所在目录使用临时输出。",
            "// Ribbon: Open -> choose example.zan\n// Run / Build / Debug operate on example.zan.\n// Add `using Gui;` to link the GUI runtime automatically.");
        DocsData.Doc(d, "Project & Build", "项目与构建",
            "Debugging",
            "调试",
            "Debug first validates a fresh debug build. It pauses at the first breakpoint, or at the first executable line when no breakpoint exists. Use Continue, Step Over, Step Into and Stop from the debug toolbar.",
            "调试会先执行新的调试构建。若有断点则停在首个断点；没有断点时停在首个可执行行。可用调试工具栏中的继续、单步跳过、单步进入和停止。",
            "// Click a line number to toggle a breakpoint.\n// Ribbon: Debug\n// Fix compiler errors before the debug session starts.");
        DocsData.Doc(d, "Project & Build", "项目与构建",
            "Window Designer (.zform)",
            "窗口设计器 (.zform)",
            "A Window App pairs a .zform layout with a .zan code-behind. Edit the layout visually; write your logic in OnLoad(app).",
            "窗口程序由 .zform 布局与 .zan 代码后置配对组成。可视化编辑布局；在 OnLoad(app) 中编写逻辑。",
            "// MyApp.zform  -> visual layout (auto-generated region)\n// MyApp.zan    -> code-behind\nstatic void OnLoad(App app) {\n    // your logic here\n}");
        DocsData.Doc(d, "Project & Build", "项目与构建",
            "Publish",
            "发布",
            "Publish produces a standalone executable per selected platform under publish/. Tick a platform in the publish window; the app icon is embedded into the exe. Windows exe files can also be packed into a single self-extracting file (DLLs bundled). Linux targets are cross-compiled here as a single static file to run on a Linux server or container. Library projects instead publish static libraries (.lib on Windows, .a elsewhere).",
            "发布会为每个所选平台在 publish/ 下生成独立可执行文件。在发布窗口中勾选目标平台；应用图标会嵌入 exe。Windows 的 exe 还可打包为单文件自解压程序（DLL 一并捆绑）。Linux 目标在本机交叉编译为静态单文件，供 Linux 服务器或容器运行。库项目则发布静态库（Windows 为 .lib，其余平台为 .a）。",
            "// Ribbon: Publish -> choose platforms\n// Output: publish/MyApp-windows-x64.exe\n// Linux  : cross-compiled static single file\n// Single : Windows exe with DLLs bundled (self-extracting)");
        DocsData.Doc(d, "Project & Build", "项目与构建",
            "Library Projects",
            "库项目",
            "A Library project compiles to a DLL instead of an exe: Run/Build produces the shared library only, with no entry point to launch. The Class Library template ships reusable classes; Export DLL exposes functions other programs can call. Publishing a library emits static libraries (.lib / .a) for each platform.",
            "库项目编译为 DLL 而非 exe：运行/构建只产出共享库，没有可启动的入口。类库模板提供可复用的类；导出 DLL 暴露可供其他程序调用的函数。发布库项目会为每个平台产出静态库（.lib / .a）。",
            "// New Project -> Library -> Class Library\n// Output: build/MyLib.dll\n// Publish -> static libraries (.lib on Windows, .a elsewhere)");
        DocsData.Doc(d, "Project & Build", "项目与构建",
            "Asset Manager",
            "资源管理器",
            "The Asset Manager manages everything bundled with your app. Import files or whole folders (copied into assets/), link resources referenced in place, or embed assets encrypted into a .zrp. Pick a file to rename or delete it, and author 8-direction or frame-sequence animations for sprites. Project Configuration shows the icon picker and a resource summary.",
            "资源管理器管理随应用打包的所有资源。可导入文件或整个文件夹（复制到 assets/）、按原位置链接资源，或将资源加密嵌入 .zrp。选中文件可重命名或删除，还可为精灵编辑八方向或序列帧动画。项目配置提供图标选择与资源摘要。",
            "// Ribbon: Project Configuration -> Open Asset Manager\n// Import file / Import folder / Link file\n// Publish strategy: copy files vs embed (encrypted .zrp)");
        DocsData.Doc(d, "Project & Build", "项目与构建",
            "Project Templates",
            "项目模板",
            "New Project offers Console (Hello World, command-line args, multi-file), Window App (empty, component showcase, WebView, free layout and fixed sizes: phone 390x844, tablet 768x1024, desktop 1280x720, small screen 480x320, QVGA 320x240, WVGA 800x480, watch 466x466 round), Library (Class Library, Export DLL) and Server (HTTP, WebSocket gateway, Web MVC, MQTT/IoT, TCP echo) templates. Fixed-size window templates are free-layout canvases that also support breakpoint layouts for extra sizes in the designer.",
            "新建项目提供多种模板：控制台（Hello World、命令行参数、多文件）、窗口程序（空窗口、组件展示、WebView、自由布局，以及固定尺寸：手机 390x844、平板 768x1024、桌面 1280x720、小屏 480x320、QVGA 320x240、WVGA 800x480、手表 466x466 圆形）、库（类库、导出 DLL）和服务器（HTTP、WebSocket 网关、Web MVC、MQTT/物联网、TCP 回显）。固定尺寸窗口模板是自由布局画布，还可在设计器中为更多尺寸保存断点布局。",
            "// New Project -> category list:\n//   Console / Window App / Library / Server\n// Window App sizes: 320x240 .. 1280x720, 466x466 round");
        DocsData.Doc(d, "Project & Build", "项目与构建",
            "AI Assistant",
            "AI 助手",
            "The AI assistant panel is a tool loop: the model replies with a fenced zan-tool block, the IDE runs that tool inside your project and appends the result to the transcript. Read tools (read_file, list_dir, grep, repo_map) run silently; mutating tools (write_file, edit_file, build, run, ui_check) wait for your Approve unless Auto-execute is on. Every file tool is confined to the project directory, and ui_check drives the real UI with synthetic input to verify a fix against actual pixels.",
            "AI 助手面板是一个工具循环：模型用 fenced 的 zan-tool 代码块回复，IDE 在项目内运行该工具并把结果追加到对话记录。只读工具（read_file、list_dir、grep、repo_map）静默执行；改动工具（write_file、edit_file、build、run、ui_check）在未开启“自动执行”时等待你的批准。所有文件工具都被限制在项目目录内；ui_check 会用合成输入驱动真实 UI，按实际像素验证修复。",
            "```zan-tool\n{\"tool\": \"read_file\", \"path\": \"src/Main.zan\", \"offset\": 1, \"limit\": 200}\n```");
        DocsData.Doc(d, "Errors", "错误排查",
            "Reading Compiler Errors",
            "读懂编译器错误",
            "After Run/Build, errors appear as red underlines in the editor; the reason shows above the current line. Click a problem to jump to it.",
            "运行/构建后，错误会在编辑器中显示为红色下划线；原因显示在当前行上方。点击问题即可跳转。",
            "// error: expected ';'\nint x = 1   // <- missing semicolon\nint y = 2;");
        DocsData.Doc(d, "Errors", "错误排查",
            "Add a Missing using",
            "补全缺失的 using",
            "When an unknown type belongs to System, System.IO, Gui or Gui.Widget, the Error List shows an Add using action. Click it to insert the import once at the top of the active source file.",
            "当未知类型属于 System、System.IO、Gui 或 Gui.Widget 时，错误列表会显示“添加 using”操作。点击后会在当前源文件顶部插入一次对应导入。",
            "// Error List: unknown type 'Button'\n// Click: Add using Gui.Widget\nusing Gui.Widget;");
        DocsData.Doc(d, "Errors", "错误排查",
            "Undefined Symbol",
            "未定义的符号",
            "An 'undefined reference' at link time usually means a needed library was not linked. GUI apps must include the Gui runtime.",
            "链接期出现 “undefined reference” 通常意味着缺少所需的库。GUI 程序必须包含 Gui 运行时。",
            "// LNK2019 undefined symbol: zan_gui_draw_text\n// Fix: use App/Canvas from the Gui library so the\n// GUI runtime is linked in.\nusing Gui;");
    }

    static void Part4(List<DocEntry> d) {
        DocsData.Doc(d, "GUI - Widgets", "GUI - 组件",
            "Typography",
            "Typography",
            "Headings, paragraphs and inline text styles for documentation and application content.",
            "用于文档和应用内容的标题、段落与行内文本样式。",
            "Typography.Heading(app, 40, 40, \"Heading\", 1);\nTypography.Paragraph(app, 40, 84, \"Readable body text.\");");
        DocsData.Doc(d, "GUI - Widgets", "GUI - 组件",
            "Avatar",
            "Avatar",
            "Render an initial or icon inside a circular avatar.",
            "在圆形头像中渲染首字母或图标。",
            "new Avatar(\"Z\", 40, \"\").RenderAt(app, 40, 60);\nnew Avatar(\"\", 40, \"user\").RenderAt(app, 96, 60);");
        DocsData.Doc(d, "GUI - Widgets", "GUI - 组件",
            "Badge",
            "Badge",
            "Use a status dot or numeric count badge next to another control.",
            "在其他控件旁显示状态圆点或数字计数徽标。",
            "Badge.Dot(app, 48, 60);\nBadge.CountAt(app, 96, 60, 12);");
        DocsData.Doc(d, "GUI - Widgets", "GUI - 组件",
            "Breadcrumb",
            "Breadcrumb",
            "Show the current location as a sequence of navigation labels.",
            "用一组导航标签显示当前位置。",
            "List<string> items = new List<string> { \"Home\", \"Projects\", \"Zan\" };\nBreadcrumb.Of(items).RenderAt(app, 40, 60);");
        DocsData.Doc(d, "GUI - Widgets", "GUI - 组件",
            "Carousel",
            "Carousel",
            "Rotate through a list of slide labels with a SignalInt active index.",
            "使用 SignalInt 当前索引在多张幻灯片标签之间切换。",
            "List<string> slides = new List<string> { \"First\", \"Second\" };\nSignalInt slide = SignalInt.Create(0);\nCarousel.Of(slides, slide).RenderInside(app, new Rect(40, 60, 420, 180));");
        DocsData.Doc(d, "GUI - Widgets", "GUI - 组件",
            "Chart",
            "Chart",
            "Draw line, area, bar, pie, donut and scatter charts from an ECharts-style ChartOption.",
            "从 ECharts 风格的 ChartOption 绘制折线图、面积图、柱状图、饼图、环图和散点图。",
            "List<string> labels = new List<string> { \"Q1\", \"Q2\", \"Q3\" };\nList<int> values = new List<int> { 12, 28, 20 };\nChartOption opt = ChartOption.Line(\"Quarterly sales\", labels);\nopt.Add(\"Sales\", values);\nChartView.Of(opt).Render(app, 40, 60, 480, 240);");
        DocsData.Doc(d, "GUI - Widgets", "GUI - 组件",
            "Collapse",
            "Collapse",
            "Display expandable sections controlled by a SignalInt open index.",
            "显示由 SignalInt 展开索引控制的可折叠区段。",
            "List<CollapsePanel> panels = new List<CollapsePanel> {\n    CollapsePanel.Create(\"General\", \"General settings\"),\n    CollapsePanel.Create(\"Advanced\", \"Advanced settings\")\n};\nSignalInt open = SignalInt.Create(0);\nCollapse.Of(panels, open).RenderAt(app, 40, 60, 420);");
        DocsData.Doc(d, "GUI - Widgets", "GUI - 组件",
            "DataTable",
            "DataTable",
            "A stateful table with typed columns, sorting, filtering and CSV export.",
            "支持类型列、排序、筛选和 CSV 导出的有状态表格。",
            "List<DataColumn> cols = new List<DataColumn> {\n    DataColumn.Text(\"Name\", 180),\n    DataColumn.Numeric(\"Score\", 100)\n};\nList<DataRow> rows = new List<DataRow>();\nDataTableState state = DataTableState.Create();\nDataTable.Render(app, 40, 60, 520, 260, cols, rows, state);");
        DocsData.Doc(d, "GUI - Widgets", "GUI - 组件",
            "Dialog",
            "Dialog",
            "Render a modal dialog with a title, message and action buttons.",
            "渲染带标题、消息和操作按钮的模态对话框。",
            "int action = Dialog.Render(app, 420, 220, 0, \"Confirm\", \"Save changes?\", \"Save\", \"Cancel\");");
        DocsData.Doc(d, "GUI - Widgets", "GUI - 组件",
            "Divider",
            "Divider",
            "Separate content horizontally, vertically or with a text label.",
            "用水平线、垂直线或带文字的分隔线划分内容。",
            "new Divider().RenderInside(app, new Rect(40, 80, 420, 8));\nnew Divider(\"Section\").RenderInside(app, new Rect(40, 120, 420, 24));\nnew Divider { Class = \"vertical\" }.RenderInside(app, new Rect(500, 60, 8, 120));");
        DocsData.Doc(d, "GUI - Widgets", "GUI - 组件",
            "Drawer",
            "Drawer",
            "Show a side panel attached to an edge of the current window.",
            "显示附着在当前窗口边缘的侧边面板。",
            "int action = Layer.Modal(app, 400, 320, \"Details\");\nint bodyY = Layer.BodyTop(app, layer);");
        DocsData.Doc(d, "GUI - Widgets", "GUI - 组件",
            "Dropdown",
            "Dropdown",
            "Combine a trigger button with an anchored menu of actions.",
            "把触发按钮与锚定的操作菜单组合起来。",
            "Dropdown<string> menu = new Dropdown<string>(s => s);\nmenu.Hint(\"Actions\");\nmenu.Bind(items);\nmenu.OnChange(OnAction);   // menu.Selected() is the picked item\nparent.Add(menu);          // size and position come from the layout");
        DocsData.Doc(d, "GUI - Widgets", "GUI - 组件",
            "Ellipsis",
            "Ellipsis",
            "Measure and truncate long text so it fits a fixed width.",
            "测量并截断长文本，使其适合固定宽度。",
            "string shown = Ellipsis.Fit(\"A very long file name.zan\", 160, app.theme.fontSizeMedium);\nEllipsis.Render(app, 40, 60, 160, shown);");
        DocsData.Doc(d, "GUI - Widgets", "GUI - 组件",
            "Empty",
            "Empty",
            "Display a clear empty-state placeholder when no data is available.",
            "没有数据时显示清晰的空状态占位内容。",
            "new Empty(\"No records yet\").RenderInside(app, new Rect(40, 60, 420, 180));");
        DocsData.Doc(d, "GUI - Widgets", "GUI - 组件",
            "FilePicker",
            "FilePicker",
            "Open the reusable custom folder, open-file or save-file child window.",
            "打开可复用的自绘文件夹、打开文件或保存文件子窗口。",
            "FilePicker picker = FilePicker.Create();\npicker.BeginOpenFile(\".\", \".zan\", \"Open Zan source\");\n// Each outer loop: picker.RenderWindow();\n// Then inspect picker.TakeResult() and picker.SelectedPath().");
        DocsData.Doc(d, "GUI - Widgets", "GUI - 组件",
            "FloatButton",
            "FloatButton",
            "A compact circular floating action button with an icon.",
            "带图标的紧凑圆形浮动操作按钮。",
            "int id = new FloatButton(\"plus\") { Size = 48, Class = \"primary\" }\n    .Render(app, 520, 360);\nif (Ui.Clicked(app, id)) {\n    // create an item\n}");
        DocsData.Doc(d, "GUI - Widgets", "GUI - 组件",
            "ListView",
            "ListView",
            "Render a compact vertical list of strings.",
            "渲染紧凑的纵向字符串列表。",
            "List<string> items = new List<string> { \"Alpha\", \"Beta\" };\nListView<string> list = new ListView<string>(new ListColumn<string>(\"\", s => s));\nlist.Bind(items);\nside.Add(list);      // CSS gives it its box");
        DocsData.Doc(d, "GUI - Widgets", "GUI - 组件",
            "Loading",
            "Loading",
            "Draw an animated loading indicator (Spin; Spin.WithTip adds a caption).",
            "绘制动画加载指示器（Spin；Spin.WithTip 附带说明文字）。",
            "new Spin(36).RenderAt(app, 80, 80);");
        DocsData.Doc(d, "GUI - Widgets", "GUI - 组件",
            "Menu",
            "Menu",
            "A vertical application menu with a SignalInt active item.",
            "使用 SignalInt 当前项的纵向应用菜单。",
            "List<string> labels = new List<string> { \"Home\", \"Settings\" };\nSignalInt active = SignalInt.Create(0);\nint first = Menu.RenderVertical(app, 40, 60, 220, 300, 36, labels, active, 0);\nMenu.HandleClick(app, first, labels.Count, active);");
        DocsData.Doc(d, "GUI - Widgets", "GUI - 组件",
            "Message",
            "Message",
            "Render a temporary inline toast message in a screen slot.",
            "在屏幕位置中渲染临时行内消息提示。",
            "Layer.Msg(\"Saved successfully\", 1);");
    }

    static void Part5(List<DocEntry> d) {
        DocsData.Doc(d, "GUI - Widgets", "GUI - 组件",
            "Modal",
            "Modal",
            "Draw a centered modal surface and receive its close action.",
            "绘制居中的模态表面并接收关闭操作。",
            "int action = Layer.Modal(app, 460, 260, \"Account settings\");");
        DocsData.Doc(d, "GUI - Widgets", "GUI - 组件",
            "Notification",
            "Notification",
            "Show a notification card at a chosen position.",
            "在指定位置显示通知卡片。",
            "Layer.Notify(\"Build completed\", 1);");
        DocsData.Doc(d, "GUI - Widgets", "GUI - 组件",
            "PageHeader",
            "PageHeader",
            "Render a page title, subtitle and back action.",
            "渲染页面标题、副标题与返回操作。",
            "PageHeader h = new PageHeader(\"Components\", \"GUI reference\");\nh.RenderAt(app, 40, 40, 520);");
        DocsData.Doc(d, "GUI - Widgets", "GUI - 组件",
            "Pagination",
            "Pagination",
            "Navigate pages with a SignalInt current page.",
            "使用 SignalInt 当前页在多个页面之间导航。",
            "SignalInt page = SignalInt.Create(1);\nPagination.Of(12, page).RenderAt(app, 40, 60);");
        DocsData.Doc(d, "GUI - Widgets", "GUI - 组件",
            "Panel",
            "Panel",
            "Create card, section or colored surface rectangles for custom content.",
            "为自定义内容创建卡片、区段或彩色表面矩形。",
            "Panel box = new Panel(\"card\");\nbox.With(new Label { Text = \"Inside the panel\" });\nbox.RenderInside(app, new Rect(40, 60, 420, 220));");
        DocsData.Doc(d, "GUI - Widgets", "GUI - 组件",
            "PivotTable",
            "PivotTable",
            "Summarize rows by configured row, column and value fields.",
            "按配置的行字段、列字段和值字段汇总数据。",
            "PivotConfig config = PivotConfig.Create(0, 1, 2, 0);\nList<DataRow> rows = new List<DataRow>();\nPivotTable.Render(app, 40, 60, 560, 280, rows, config);");
        DocsData.Doc(d, "GUI - Widgets", "GUI - 组件",
            "Popconfirm",
            "Popconfirm",
            "Ask for confirmation next to an invoking control.",
            "在触发控件旁请求用户确认。",
            "int action = Layer.DrawPopconfirm(app, 180, 80, \"Delete this item?\", \"Delete\", \"Cancel\");");
        DocsData.Doc(d, "GUI - Widgets", "GUI - 组件",
            "Popover",
            "Popover",
            "Display titled explanatory content next to an anchor.",
            "在锚点旁显示带标题的说明内容。",
            "Popover.Render(app, 180, 80, 260, 140, \"Details\", \"Additional information\");");
        DocsData.Doc(d, "GUI - Widgets", "GUI - 组件",
            "Rate",
            "Rate",
            "An interactive star rating that binds a plain int field via `.data`.",
            "通过 `.data` 绑定普通 int 字段的交互式星级评分。",
            "class Form { int rating; }\nForm form = new Form();\nRate rate = new Rate(SignalInt.Create(3), 5);\nrate.data = form.rating;\nrate.Render(app, 40, 60);");
        DocsData.Doc(d, "GUI - Widgets", "GUI - 组件",
            "Result",
            "Result",
            "Show a success, warning or error result with a title and description.",
            "显示带标题和说明的成功、警告或错误结果。",
            "Result r = new Result(\"Published\", \"The executable is ready.\");\nr.Class = \"success\";\nr.RenderAt(app, 40, 60, 460);");
        DocsData.Doc(d, "GUI - Widgets", "GUI - 组件",
            "Ribbon",
            "Ribbon",
            "Build command groups for an IDE-style ribbon toolbar.",
            "为 IDE 风格的功能区工具栏构建命令分组。",
            "List<RibbonCmd> commands = new List<RibbonCmd> {\n    RibbonCmd.Group(\"play\", \"Run\"),\n    RibbonCmd.Create(\"build\", \"Build\")\n};\nRibbon.Render(app, 0, 40, 800, Ribbon.Height(app), commands);");
        DocsData.Doc(d, "GUI - Widgets", "GUI - 组件",
            "Scrollbar",
            "Scrollbar",
            "Draw a vertical scrollbar for a custom scrollable surface.",
            "为自定义可滚动表面绘制纵向滚动条。",
            "Scrollbar.RenderVertical(app, 500, 60, 240, 900, 120);");
        DocsData.Doc(d, "GUI - Widgets", "GUI - 组件",
            "Skeleton",
            "Skeleton",
            "Compose rectangle, circle and text placeholders while content loads.",
            "在内容加载时组合矩形、圆形和文本骨架占位。",
            "Skeleton dot = new Skeleton(40, 40);\ndot.Class = \"circle\";\ndot.RenderAt(app, 40, 60);\nSkeleton.Line(app, 240).RenderAt(app, 96, 62);");
        DocsData.Doc(d, "GUI - Widgets", "GUI - 组件",
            "Spin",
            "Spin",
            "Draw a spinner by itself or centered with a loading tip.",
            "单独绘制旋转器，或将其与加载提示居中显示。",
            "new Spin(36).RenderAt(app, 80, 80);\nSpin s = new Spin(36);\ns.Tip = \"Loading data...\";\ns.RenderInside(app, new Rect(40, 120, 280, 100));");
        DocsData.Doc(d, "GUI - Widgets", "GUI - 组件",
            "Split",
            "Split",
            "Create draggable vertical or horizontal panes backed by a SignalInt size.",
            "创建由 SignalInt 尺寸控制、可拖动的纵向或横向分栏。",
            "SignalInt firstWidth = SignalInt.Create(240);\nRect area = Rect.Create(0, 60, 800, 500);\nSplit panes = Split.Vertical(app, area, firstWidth, 160, 240);");
        DocsData.Doc(d, "GUI - Widgets", "GUI - 组件",
            "Statistic",
            "Statistic",
            "Show a highlighted numeric value with a descriptive label.",
            "显示带说明标签的突出数值。",
            "new Statistic(\"Active users\", \"12,480\").RenderAt(app, 40, 60);");
        DocsData.Doc(d, "GUI - Widgets", "GUI - 组件",
            "Steps",
            "Steps",
            "Show progress through a sequence of labeled steps.",
            "显示一组带标签步骤的完成进度。",
            "List<string> labels = new List<string> { \"Details\", \"Review\", \"Done\" };\nSignalInt current = SignalInt.Create(1);\nSteps.Of(labels, current).RenderAt(app, 40, 60, 520);");
        DocsData.Doc(d, "GUI - Widgets", "GUI - 组件",
            "Table",
            "Table",
            "Render a lightweight table header and striped rows.",
            "渲染轻量表头与交替底色的数据行。",
            "List<string> cols = new List<string> { \"Name\", \"Status\" };\nList<int> widths = new List<int> { 220, 120 };\nTable.RenderHeader(app, 40, 60, cols, widths);");
        DocsData.Doc(d, "GUI - Widgets", "GUI - 组件",
            "Timeline",
            "Timeline",
            "Display ordered events with titles and descriptions.",
            "按顺序显示带标题与说明的事件。",
            "List<TimelineItem> items = new List<TimelineItem> {\n    TimelineItem.Create(\"\", \"Created\", \"Project initialized\"),\n    TimelineItem.Create(\"\", \"Published\", \"Executable generated\")\n};\nTimeline.Of(items).RenderAt(app, 40, 60, 520);");
        DocsData.Doc(d, "GUI - Widgets", "GUI - 组件",
            "TreeView",
            "TreeView",
            "Render expandable directory and file nodes with scrolling and selection.",
            "渲染带滚动与选择的可展开目录和文件节点。",
            "List<TreeNode> nodes = new List<TreeNode> {\n    TreeNode.Dir(\"src\", 0, true),\n    TreeNode.FileIcon(\"main.zan\", 1, \"file\")\n};\n\nTreeView tree = new TreeView();\ntree.Bind(nodes);\ntree.OnSelect(OnPick);\ntree.OnActivate(OnOpen);\nparent.Add(tree);   // size and position come from the layout");
    }

    static void Part6(List<DocEntry> d) {
        DocsData.Doc(d, "GUI - Widgets", "GUI - 组件",
            "Wizard",
            "Wizard",
            "Build a full child-window template or project creation workflow.",
            "构建完整的子窗口模板或项目创建流程。",
            "List<WizardItem> items = new List<WizardItem> {\n    new WizardItem(\"Console\", \"menu\", \"A console app.\"),\n    new WizardItem(\"Library\", \"grid\", \"A reusable library.\")\n};\nSignalInt selected = SignalInt.Create(0);\nInput name = Input.Create(\"project name\");\nInput location = Input.Create(\"location\");\nWizard wiz = Wizard.Create(\"New Project\", items, selected, name, location, true);\nint result = wiz.Show(app);");
        DocsData.Doc(d, "GUI - Widgets", "GUI - 组件",
            "CodeEditor",
            "CodeEditor",
            "A full source editor with diagnostics, undo/redo, multiple carets, breakpoints and completion.",
            "完整的源代码编辑器，支持诊断、撤销/重做、多光标、断点与补全。",
            "CodeEditor editor = CodeEditor.Create();\neditor.LoadText(\"class Program {\\n}\\n\");\neditor.Render(app, Rect.Create(40, 60, 680, 420));");
        DocsData.Doc(d, "Standard Library", "标准库",
            "Date & Time",
            "日期与时间",
            "DateTime.Now() and UtcNow() capture the current time. Read parts with Year(), Month(), Day(), Hour(); format with ToString().",
            "DateTime.Now() 与 UtcNow() 获取当前时间。用 Year()、Month()、Day()、Hour() 读取各部分；用 ToString() 格式化。",
            "using System;\n\nDateTime now = DateTime.Now();\nConsole.WriteLine(now.ToString());\nConsole.WriteLine(Convert.ToString(now.Year()));");
        DocsData.Doc(d, "Standard Library", "标准库",
            "Random Numbers",
            "随机数",
            "Create a Random, then draw values: Next(), NextBelow(n), Between(lo, hi) and NextDouble(). Use Random.Seeded(seed) for a reproducible sequence.",
            "创建 Random 后取值：Next()、NextBelow(n)、Between(lo, hi)、NextDouble()。用 Random.Seeded(seed) 得到可复现序列。",
            "using System;\n\nRandom rng = new Random();\nint dice = rng.Between(1, 7);\ndouble r = rng.NextDouble();\nConsole.WriteLine(Convert.ToString(dice));");
    }


    /// Database entries: connections and configuration for every supported
    /// engine, plain SQL CRUD, transactions and pooling, then the ORM
    /// (models, query builder, joins, paging, migrations).
    /// Networking: one entry per protocol the standard library speaks, client
    /// and server side, with runnable examples taken from examples/net.
    static void PartNet(List<DocEntry> d) {
        DocsData.Doc(d, "HTTP Client", "HTTP 客户端",
            "GET Request",
            "GET 请求",
            "HttpClient.Create(host, port) opens a reusable client; GetAsync(path) returns the response body. For a one-off fetch, the static HttpClient.GetAsync(host, port, path) skips the instance. Every call is a coroutine: await suspends this task, not the thread.",
            "HttpClient.Create(host, port) 创建可复用的客户端，GetAsync(path) 返回响应体。只请求一次时用静态方法 HttpClient.GetAsync(host, port, path) 即可。所有调用都是协程：await 挂起的是当前任务，不是线程。",
            "using System;\nusing System.Net.Sockets;\nusing System.Net.Http;\n\nclass Program {\n    static async int Run() {\n        Socket.Initialize();\n\n        HttpClient cli = HttpClient.Create(\"api.local\", 8080);\n        string body = await cli.GetAsync(\"/users/42\");\n        Console.WriteLine(body);\n\n        // one-shot: no client instance needed\n        string page = await HttpClient.GetAsync(\"example.com\", 80, \"/\");\n        Console.WriteLine(Convert.ToString(page.Length) + \" bytes\");\n        return 0;\n    }\n\n    static void Main() { int r = await Run(); }\n}");
        DocsData.Doc(d, "HTTP Client", "HTTP 客户端",
            "Query Parameters",
            "查询参数",
            "A query string is part of the path: append ?name=value&other=value. Encode values that may contain spaces or & yourself with Uri.Escape so the server parses them back intact.",
            "查询串是路径的一部分：在路径后面拼 ?name=value&other=value。值里可能出现空格或 & 时，先用 Uri.Escape 编码，服务端才能正确还原。",
            "using System;\nusing System.Net.Http;\n\nHttpClient cli = HttpClient.Create(\"api.local\", 8080);\n\nstring q = \"/search?kw=\" + Uri.Escape(\"zan lang\") + \"&page=2&size=20\";\nstring body = await cli.GetAsync(q);\nConsole.WriteLine(body);");
        DocsData.Doc(d, "HTTP Client", "HTTP 客户端",
            "POST JSON",
            "POST 提交 JSON",
            "PostAsync(path, body) sends the body as-is. Build the payload with JsonValue instead of string concatenation so quoting and escaping are correct, and parse the reply with JsonValue.ParseLenient.",
            "PostAsync(path, body) 原样发送请求体。用 JsonValue 构造报文而不是拼字符串，引号和转义才不会出错；响应用 JsonValue.ParseLenient 解析。",
            "using System;\nusing System.Net.Http;\nusing System.Json;\n\nHttpClient cli = HttpClient.Create(\"api.local\", 8080);\ncli.SetHeader(\"Content-Type\", \"application/json\");\n\nJsonValue req = JsonValue.NewObject();\nreq.Set(\"name\", JsonValue.NewStr(\"alice\"));\nreq.Set(\"age\", JsonValue.NewNum(\"30\"));\n\nstring reply = await cli.PostAsync(\"/users\", req.ToJson());\n\nJsonValue res = JsonValue.ParseLenient(reply);\nConsole.WriteLine(\"id=\" + res.Str(\"id\", \"?\"));");
        DocsData.Doc(d, "HTTP Client", "HTTP 客户端",
            "POST a Form",
            "POST 表单",
            "A classic HTML form post is Content-Type application/x-www-form-urlencoded with a body of key=value pairs joined by &. Escape each value; that is all a form post is.",
            "传统 HTML 表单提交就是 Content-Type 为 application/x-www-form-urlencoded、请求体为 & 连接的 key=value。逐个值做转义即可，没有别的魔法。",
            "using System;\nusing System.Net.Http;\n\nHttpClient cli = HttpClient.Create(\"api.local\", 8080);\ncli.SetHeader(\"Content-Type\", \"application/x-www-form-urlencoded\");\n\nstring form = \"user=\" + Uri.Escape(\"zan\")\n    + \"&pass=\" + Uri.Escape(\"p@ss word\")\n    + \"&remember=1\";\n\nstring reply = await cli.PostAsync(\"/login\", form);\nConsole.WriteLine(reply);");
        DocsData.Doc(d, "HTTP Client", "HTTP 客户端",
            "PUT & DELETE",
            "PUT 与 DELETE",
            "PutAsync and DeleteAsync mirror PostAsync and GetAsync; the method is the only difference. RequestAsync(method, path, body) sends any other verb (PATCH, HEAD, OPTIONS).",
            "PutAsync 与 DeleteAsync 和 PostAsync / GetAsync 用法一致，只是方法不同。其他动词（PATCH、HEAD、OPTIONS）用 RequestAsync(method, path, body) 发送。",
            "using System;\nusing System.Net.Http;\n\nHttpClient cli = HttpClient.Create(\"api.local\", 8080);\n\nstring updated = await cli.PutAsync(\"/users/42\", \"{\\\"age\\\":31}\");\nstring gone = await cli.DeleteAsync(\"/users/42\");\n\n// any other verb\nstring patched = await cli.RequestAsync(\"PATCH\", \"/users/42\", \"{\\\"age\\\":32}\");");
        DocsData.Doc(d, "HTTP Client", "HTTP 客户端",
            "Headers & Authentication",
            "请求头与鉴权",
            "SetHeader(name, value) adds a default header to every request this client sends, which is how tokens, API keys and content negotiation are carried. Calls are chainable and a repeated name replaces the previous value.",
            "SetHeader(name, value) 给该客户端之后的每个请求都带上这个头，token、API Key、内容协商都靠它。可以链式调用，同名头会覆盖旧值。",
            "using System;\nusing System.Net.Http;\n\nHttpClient cli = HttpClient.Create(\"api.local\", 8080);\ncli.SetHeader(\"Authorization\", \"Bearer \" + token);\ncli.SetHeader(\"Accept\", \"application/json\");\ncli.SetHeader(\"User-Agent\", \"zan-app/1.0\");\ncli.SetHeader(\"X-Request-Id\", requestId);\n\nstring body = await cli.GetAsync(\"/me\");");
        DocsData.Doc(d, "HTTP Client", "HTTP 客户端",
            "Status Code & Response Headers",
            "状态码与响应头",
            "GetAsync/PostAsync return only the body. SendAsync(method, path, body) returns the whole HttpResponse: statusCode, statusText, headers and body, which is what you branch on when an API signals failure with a status rather than a payload.",
            "GetAsync/PostAsync 只返回响应体。SendAsync(method, path, body) 返回完整的 HttpResponse：statusCode、statusText、响应头和 body——接口用状态码表达失败时就要用它来判断。",
            "using System;\nusing System.Net.Http;\n\nHttpClient cli = HttpClient.Create(\"api.local\", 8080);\n\nHttpResponse res = await cli.SendAsync(\"GET\", \"/users/42\", \"\");\nConsole.WriteLine(Convert.ToString(res.statusCode) + \" \" + res.statusText);\nConsole.WriteLine(\"type: \" + res.GetHeader(\"Content-Type\"));\n\nif (res.statusCode == 404) {\n    Console.WriteLine(\"not found\");\n} else if (res.statusCode >= 500) {\n    Console.WriteLine(\"server error: \" + res.body);\n} else {\n    Console.WriteLine(res.body);\n}");
        DocsData.Doc(d, "HTTP Client", "HTTP 客户端",
            "Timeout & Error Handling",
            "超时与错误处理",
            "SetTimeout(ms) bounds connect and read; a timed-out or refused request yields an empty body, so check before parsing. Wrap the call in try/catch to turn transport failures into your own error path.",
            "SetTimeout(ms) 同时约束连接和读取；超时或连接被拒时返回空串，所以解析前要先判断。用 try/catch 把传输层失败转换成自己的错误处理路径。",
            "using System;\nusing System.Net.Http;\n\nHttpClient cli = HttpClient.Create(\"api.local\", 8080);\ncli.SetTimeout(3000);          // milliseconds, connect + read\n\ntry {\n    string body = await cli.GetAsync(\"/slow\");\n    if (body.Length == 0) {\n        Console.WriteLine(\"empty reply: timed out or refused\");\n        return;\n    }\n    Console.WriteLine(body);\n} catch (Exception e) {\n    Console.WriteLine(\"request failed: \" + e.Message());\n}");
        DocsData.Doc(d, "HTTP Client", "HTTP 客户端",
            "Retry with Backoff",
            "重试与退避",
            "There is no hidden retry: a request is attempted once. Retry in your own loop with Task.Delay between attempts, doubling the wait so a struggling server is not hammered.",
            "客户端不会隐式重试，一次调用只发一次请求。自己写循环重试，配合 Task.Delay 退避，等待时间逐次翻倍，避免把已经吃力的服务打垮。",
            "using System;\nusing System.Net.Http;\n\nstatic async string GetWithRetry(HttpClient cli, string path, int tries) {\n    int wait = 200;\n    for (int i = 0; i < tries; i++) {\n        HttpResponse res = await cli.SendAsync(\"GET\", path, \"\");\n        if (res.statusCode >= 200 && res.statusCode < 300) { return res.body; }\n        if (res.statusCode >= 400 && res.statusCode < 500) { return \"\"; }\n        await Task.Delay(wait);\n        wait = wait * 2;\n    }\n    return \"\";\n}");
        DocsData.Doc(d, "HTTP Client", "HTTP 客户端",
            "HTTPS & Certificates",
            "HTTPS 与证书",
            "CreateHttps(host, port) speaks TLS. DisableTlsVerify() is for local self-signed servers only; PinPublicKey pins the server SPKI hash, and SetClientCertificate presents a client certificate for mutual TLS.",
            "CreateHttps(host, port) 走 TLS。DisableTlsVerify() 只用于本地自签名环境；PinPublicKey 固定服务端 SPKI 指纹；SetClientCertificate 提供客户端证书做双向认证。",
            "using System;\nusing System.Net.Http;\n\nHttpClient api = HttpClient.CreateHttps(\"api.example.com\", 443);\nstring body = await api.GetAsync(\"/v1/status\");\n\n// local self-signed server (development only)\nHttpClient dev = HttpClient.CreateHttps(\"127.0.0.1\", 8443);\ndev.DisableTlsVerify();\n\n// certificate pinning + mutual TLS\nHttpClient hard = HttpClient.CreateHttps(\"api.example.com\", 443);\nhard.PinPublicKey(spkiSha256Base64);\nhard.SetClientCertificate(\"client.crt\", \"client.key\");");
        DocsData.Doc(d, "HTTP Client", "HTTP 客户端",
            "Download a File",
            "下载文件",
            "DownloadFileAsync streams the response straight to disk instead of holding it in a string, so a large file costs no memory.",
            "DownloadFileAsync 把响应直接流式写入磁盘，不在内存里拼字符串，因此下载大文件不吃内存。",
            "using System;\nusing System.Net.Sockets;\nusing System.Net.Http;\n\nclass Program {\n    static async int Run() {\n        Socket.Initialize();\n        await HttpClient.DownloadFileAsync(\n            \"dl.example.com\", 80, \"/zan/zan-1.0.zip\", \"zan-1.0.zip\");\n        Console.WriteLine(\"saved\");\n        return 0;\n    }\n\n    static void Main() { int r = await Run(); }\n}");
        DocsData.Doc(d, "HTTP Server", "HTTP 服务端",
            "Minimal Server",
            "最小服务端",
            "Worker.Create(\"http\", host, port) plus an onRequest callback is a complete server: no socket code, no accept loop. count is the number of worker processes; the kernel spreads accepts across them.",
            "Worker.Create(\"http\", host, port) 加一个 onRequest 回调就是一个完整服务：不用写 socket，也不用写 accept 循环。count 是 worker 进程数，内核会把新连接分流到各进程。",
            "using System;\nusing System.Net;\nusing System.Net.Http;\n\nclass Program {\n    static async HttpResponse Request(HttpRequest req) {\n        return HttpResponse.Text(\"Hello World \" + req.path);\n    }\n\n    static async void Main() {\n        Worker w = Worker.Create(\"http\", \"0.0.0.0\", 9501);\n        w.count = 4;                 // 4 worker processes\n        w.onRequest = Program.Request;\n        await Worker.RunAll();\n    }\n}");
        DocsData.Doc(d, "HTTP Server", "HTTP 服务端",
            "Routing",
            "路由分发",
            "HttpServer.Create(host, port).OnRequest(handler) gives full control: the handler receives the parsed request and returns the response, so routing is an ordinary branch on method and path with a 404 fallback.",
            "HttpServer.Create(host, port).OnRequest(handler) 提供完整控制：处理函数拿到解析好的请求、返回响应，所以路由就是按 method 和 path 分支，最后兜底 404。",
            "using System;\nusing System.Net.Sockets;\nusing System.Net.Http;\n\nclass Program {\n    static async HttpResponse Handle(HttpRequest req) {\n        if (req.method == \"GET\" && req.path == \"/health\") {\n            return HttpResponse.Text(\"ok\");\n        }\n        if (req.method == \"GET\" && req.path == \"/users\") {\n            return HttpResponse.Json(\"[{\\\"id\\\":1,\\\"name\\\":\\\"alice\\\"}]\");\n        }\n        if (req.method == \"POST\" && req.path == \"/users\") {\n            return HttpResponse.Json(\"{\\\"created\\\":true}\");\n        }\n        return HttpResponse.NotFound();\n    }\n\n    static async int Run() {\n        Socket.Initialize();\n        HttpServer server = HttpServer.Create(\"0.0.0.0\", 8080);\n        server.OnRequest(Handle);\n        await server.Start();        // serves until Stop()\n        return 0;\n    }\n\n    static void Main() { int r = await Run(); }\n}");
        DocsData.Doc(d, "HTTP Server", "HTTP 服务端",
            "Reading Request Data",
            "读取请求数据",
            "HttpRequest carries method, path, queryString, headers and body. GetQueryParam reads one query value, GetFormField reads one urlencoded body field and GetHeader is case-insensitive.",
            "HttpRequest 里有 method、path、queryString、请求头和 body。GetQueryParam 取单个查询参数，GetFormField 取 urlencoded 表单字段，GetHeader 不区分大小写。",
            "using System;\nusing System.Net.Http;\nusing System.Json;\n\nstatic async HttpResponse Handle(HttpRequest req) {\n    // /search?kw=zan&page=2\n    string kw = req.GetQueryParam(\"kw\");\n    string page = req.GetQueryParam(\"page\");\n\n    // application/x-www-form-urlencoded body\n    string user = req.GetFormField(\"user\");\n\n    // headers (case-insensitive)\n    string auth = req.GetHeader(\"Authorization\");\n\n    // JSON body\n    JsonValue doc = JsonValue.ParseLenient(req.body);\n    string name = doc.Str(\"name\", \"\");\n\n    return HttpResponse.Text(\"kw=\" + kw + \" page=\" + page\n        + \" user=\" + user + \" name=\" + name);\n}");
        DocsData.Doc(d, "HTTP Server", "HTTP 服务端",
            "JSON API & Status Codes",
            "JSON 接口与状态码",
            "HttpResponse.Json sets the content type; statusCode / statusText carry the outcome. Return a machine-readable error object with a 4xx status rather than plain text, so clients can branch on it.",
            "HttpResponse.Json 会设置内容类型；statusCode / statusText 表达结果。校验失败时返回 4xx 加结构化错误对象，而不是一段纯文本，客户端才好判断。",
            "using System;\nusing System.Net.Http;\nusing System.Json;\n\nstatic async HttpResponse CreateTodo(HttpRequest req) {\n    JsonValue doc = JsonValue.ParseLenient(req.body);\n    string title = doc.Str(\"title\", \"\");\n    if (title.Length == 0) {\n        HttpResponse bad = HttpResponse.Json(\"{\\\"error\\\":\\\"title required\\\"}\");\n        bad.statusCode = 400;\n        bad.statusText = \"Bad Request\";\n        return bad;\n    }\n\n    JsonValue item = JsonValue.NewObject();\n    item.Set(\"id\", JsonValue.NewNum(\"1\"));\n    item.Set(\"title\", JsonValue.NewStr(title));\n    item.Set(\"done\", JsonValue.NewBool(false));\n\n    HttpResponse res = HttpResponse.Json(item.ToJson());\n    res.statusCode = 201;\n    res.statusText = \"Created\";\n    return res;\n}");
        DocsData.Doc(d, "HTTP Server", "HTTP 服务端",
            "Response Types",
            "响应类型",
            "Ready-made responses cover the common shapes: Text, Json, Ok (HTML), Redirect, NotFound, ServerError and WithStatus for anything else. SetHeader / SetContentType adjust one.",
            "常见响应都有现成构造：Text、Json、Ok（HTML）、Redirect、NotFound、ServerError，其他状态用 WithStatus。需要微调时用 SetHeader / SetContentType。",
            "using System;\nusing System.Net.Http;\n\nHttpResponse text = HttpResponse.Text(\"plain body\");\nHttpResponse json = HttpResponse.Json(\"{\\\"ok\\\":true}\");\nHttpResponse html = HttpResponse.Ok(\"<h1>Zan</h1>\");\nHttpResponse move = HttpResponse.Redirect(\"/login\");\nHttpResponse miss = HttpResponse.NotFound();\nHttpResponse boom = HttpResponse.ServerError(\"upstream down\");\nHttpResponse teapot = HttpResponse.WithStatus(418, \"I'm a teapot\", \"no coffee\");\n\nHttpResponse file = HttpResponse.Ok(csv);\nfile.SetContentType(\"text/csv\");\nfile.SetHeader(\"Content-Disposition\", \"attachment; filename=report.csv\");");
        DocsData.Doc(d, "HTTP Server", "HTTP 服务端",
            "Limits & Protection",
            "限流与自我保护",
            "A public server needs bounds: SetMaxConnections caps concurrent sockets, SetTimeout drops idle connections and SetMaxRequestBytes rejects oversized bodies before they are buffered.",
            "对外服务必须设上限：SetMaxConnections 限制并发连接，SetTimeout 回收空闲连接，SetMaxRequestBytes 在缓冲之前就拒掉超大请求体。",
            "using System;\nusing System.Net.Http;\n\nHttpServer server = HttpServer.Create(\"0.0.0.0\", 8080);\nserver.SetMaxConnections(1024);      // refuse new sockets beyond this\nserver.SetTimeout(10000);            // idle connection timeout (ms)\nserver.SetMaxRequestBytes(1048576);  // 1 MB request body cap\nserver.OnRequest(Handle);\nawait server.Start();");
        DocsData.Doc(d, "HTTP Server", "HTTP 服务端",
            "Processes & Service Commands",
            "多进程与服务命令",
            "Worker.RunCommand() turns the program into a service binary: start, start -d, stop, restart, reload (drains workers one by one) and status, without touching business code.",
            "Worker.RunCommand() 让程序变成一个服务可执行文件，支持 start、start -d、stop、restart、reload（逐个平滑替换 worker）、status，业务代码完全不用改。",
            "using System;\nusing System.Net;\nusing System.Net.Http;\n\nclass Program {\n    static async HttpResponse Request(HttpRequest req) {\n        return HttpResponse.Text(\"pid \" + Convert.ToString(ProcessHost.Pid()));\n    }\n\n    static async void Main() {\n        Worker w = Worker.Create(\"http\", \"0.0.0.0\", 9501);\n        w.count = 4;\n        w.onRequest = Program.Request;\n        await Worker.RunCommand();\n    }\n}\n\n// ./service start -d     run as a daemon\n// ./service reload       graceful restart, no dropped requests\n// ./service status       per-worker requests / QPS / CPU / memory\n// ./service stop");
        DocsData.Doc(d, "HTTP Server", "HTTP 服务端",
            "HTTPS Server",
            "HTTPS 服务端",
            "HttpsServer.Create(host, port, certFile, keyFile) is the same server behind TLS: the handler contract is unchanged, only the transport is encrypted.",
            "HttpsServer.Create(host, port, certFile, keyFile) 就是 TLS 版的同一个服务端：处理函数写法不变，只是传输层加密。",
            "using System;\nusing System.Net.Sockets;\nusing System.Net.Http;\nusing System.Net.Https;\n\nclass Program {\n    static async HttpResponse Handle(HttpRequest req) {\n        return HttpResponse.Json(\"{\\\"secure\\\":true,\\\"path\\\":\\\"\" + req.path + \"\\\"}\");\n    }\n\n    static async int Run() {\n        Socket.Initialize();\n        HttpsServer server = HttpsServer.Create(\n            \"0.0.0.0\", 8443, \"server.crt\", \"server.key\");\n        server.SetMaxRequestBytes(1048576);\n        server.OnRequest(Handle);\n        await server.Start();\n        return 0;\n    }\n\n    static void Main() { int r = await Run(); }\n}");
        DocsData.Doc(d, "HTTP Server", "HTTP 服务端",
            "Server-Sent Events",
            "SSE 服务端推送",
            "SSE is one-way push over plain HTTP (text/event-stream), the EventSource API in a browser. AcceptAsync completes the handshake and returns a connection; SendAsync pushes a named event, PingAsync keeps idle proxies from closing the stream.",
            "SSE 是基于普通 HTTP 的单向推送（text/event-stream），对应浏览器的 EventSource。AcceptAsync 完成握手并返回连接，SendAsync 推送命名事件，PingAsync 发注释行保活，避免中间代理断开空闲连接。",
            "using System;\nusing System.Net.Sockets;\nusing System.Net.Sse;\n\nclass Program {\n    static async int Run() {\n        Socket.Initialize();\n        SseServer srv = SseServer.Create(\"0.0.0.0\", 8090);\n        srv.Start();\n\n        List<SseConnection> subs = new List<SseConnection>();\n        SseConnection c = await srv.AcceptAsync();\n        if (c != null) {\n            Console.WriteLine(\"subscriber on \" + c.Path());\n            subs.Add(c);\n        }\n\n        for (int tick = 0; tick < 3; tick++) {\n            foreach (SseConnection s in subs) {\n                int _n = await s.SendAsync(\"price\",\n                    \"{\\\"symbol\\\":\\\"ZAN\\\",\\\"px\\\":\" + Convert.ToString(100 + tick) + \"}\");\n            }\n            await Task.Delay(1000);\n        }\n\n        foreach (SseConnection s in subs) {\n            int _p = await s.PingAsync();     // keep-alive comment line\n            s.Close();                        // client's NextAsync returns null\n        }\n        srv.Stop();\n        return 0;\n    }\n\n    static void Main() { int r = await Run(); }\n}");
        DocsData.Doc(d, "HTTP Server", "HTTP 服务端",
            "Subscribing to SSE",
            "订阅 SSE 事件流",
            "SseClient.ConnectAsync subscribes; NextAsync suspends until the next event and returns null when the server closes the stream. Name() is the event type, Data() the payload (multi-line payloads are reassembled).",
            "SseClient.ConnectAsync 订阅，NextAsync 挂起等待下一条事件，服务端关闭流时返回 null。Name() 是事件类型，Data() 是负载（多行 data 会自动拼回原样）。",
            "using System;\nusing System.Net.Sockets;\nusing System.Net.Sse;\n\nclass Program {\n    static async int Run() {\n        Socket.Initialize();\n        SseClient c = await SseClient.ConnectAsync(\"127.0.0.1\", 8090, \"/stream\");\n        if (!c.IsConnected()) { Console.WriteLine(\"subscribe failed\"); return 1; }\n\n        while (true) {\n            SseEvent e = await c.NextAsync();\n            if (e == null) { break; }        // stream closed\n            Console.WriteLine(e.Name() + \": \" + e.Data());\n        }\n        c.Close();\n        return 0;\n    }\n\n    static void Main() { int r = await Run(); }\n}");
        DocsData.Doc(d, "WebSocket", "WebSocket",
            "WebSocket Client",
            "WebSocket 客户端",
            "ConnectAsync performs the HTTP upgrade handshake; SendText and RecvText exchange text frames, and RecvText suspends until a frame arrives. IsConnected() reports a failed handshake.",
            "ConnectAsync 完成 HTTP 升级握手；SendText / RecvText 收发文本帧，RecvText 会挂起直到收到帧。握手失败可用 IsConnected() 判断。",
            "using System;\nusing System.Net.Sockets;\nusing System.Net.WebSocket;\n\nclass Program {\n    static async int Run() {\n        Socket.Initialize();\n        WebSocketClient c = await WebSocketClient.ConnectAsync(\n            \"127.0.0.1\", 8080, \"/chat\");\n        if (!c.IsConnected()) { Console.WriteLine(\"handshake failed\"); return 1; }\n\n        await c.SendText(\"hello\");\n        string reply = await c.RecvText();\n        Console.WriteLine(\"got: \" + reply);\n\n        await c.Ping();       // heartbeat, server answers with pong\n        await c.Close();      // close frame, then TCP shutdown\n        return 0;\n    }\n\n    static void Main() { int r = await Run(); }\n}");
        DocsData.Doc(d, "WebSocket", "WebSocket",
            "WebSocket Server",
            "WebSocket 服务端",
            "WebSocketServer.Create(host, port).Start() handles the handshake, frame codec and ping/pong; the default OnMessage echoes. Subclass it and override OnMessage to implement your own protocol.",
            "WebSocketServer.Create(host, port).Start() 处理握手、帧编解码和 ping/pong，默认 OnMessage 是回显。继承它并覆写 OnMessage 就能实现自己的业务协议。",
            "using System;\nusing System.Net.Sockets;\nusing System.Net.WebSocket;\n\nclass ChatServer : WebSocketServer {\n    override async string OnMessage(string message) {\n        if (message == \"ping\") { return \"pong\"; }\n        return \"you said: \" + message;\n    }\n}\n\nclass Program {\n    static async int Run() {\n        Socket.Initialize();\n        WebSocketServer server = WebSocketServer.Create(\"0.0.0.0\", 8080);\n        await server.Start();\n        return 0;\n    }\n\n    static void Main() { int r = await Run(); }\n}");
        DocsData.Doc(d, "WebSocket", "WebSocket",
            "Callback-Style Server",
            "回调式 WebSocket 服务",
            "The Worker form gives per-connection callbacks: onOpen, onMessage (its return value is sent back as one frame), onClose, plus onRequest so plain HTTP on the same port still works. conn.Send pushes to a client at any time.",
            "Worker 形式提供按连接的回调：onOpen、onMessage（返回值自动作为一帧回发）、onClose，还有 onRequest 让同端口的普通 HTTP 依然可用。需要主动推送时用 conn.Send。",
            "using System;\nusing System.Net;\nusing System.Net.Http;\n\nclass Program {\n    static async void Open(Connection conn) {\n        Console.WriteLine(\"open #\" + Convert.ToString(conn.GetId()));\n    }\n\n    static async string Message(Connection conn, string data) {\n        return \"{\\\"echo\\\":\\\"\" + data + \"\\\"}\";\n    }\n\n    static async void Closed(Connection conn) {\n        Console.WriteLine(\"close #\" + Convert.ToString(conn.GetId()));\n    }\n\n    static async HttpResponse Request(HttpRequest req) {\n        return HttpResponse.Text(\"plain http on the ws port: \" + req.path);\n    }\n\n    static async void Main() {\n        Worker w = Worker.Create(\"websocket\", \"0.0.0.0\", 9502);\n        w.count = 4;\n        w.onOpen = Program.Open;\n        w.onMessage = Program.Message;\n        w.onClose = Program.Closed;\n        w.onRequest = Program.Request;\n        await Worker.RunAll();\n    }\n}");
        DocsData.Doc(d, "WebSocket", "WebSocket",
            "Secure WebSocket (WSS)",
            "安全 WebSocket（WSS）",
            "WssClient / WssServer are the TLS variants: the server needs a certificate and key, the client API is identical to plain WebSocket.",
            "WssClient / WssServer 是 TLS 版本：服务端需要证书和私钥，客户端 API 与普通 WebSocket 完全一致。",
            "using System;\nusing System.Net.Sockets;\nusing System.Net.WebSocket.Secure;\n\nclass Program {\n    static async int Run() {\n        Socket.Initialize();\n\n        WssServer server = WssServer.Create(\n            \"0.0.0.0\", 8443, \"server.crt\", \"server.key\");\n        Task.Spawn(server.Start());\n\n        WssClient c = await WssClient.ConnectAsync(\"127.0.0.1\", 8443, \"/chat\");\n        await c.SendText(\"secure hello\");\n        Console.WriteLine(await c.RecvText());\n        await c.Close();\n\n        server.Stop();\n        return 0;\n    }\n\n    static void Main() { int r = await Run(); }\n}");
        DocsData.Doc(d, "Sockets", "套接字",
            "TCP Client",
            "TCP 客户端",
            "TcpClient.ConnectAsync opens a connection; SendAsync / RecvAsync move bytes. TCP is a byte stream with no message boundaries, so agree on a framing rule -- here a newline terminator.",
            "TcpClient.ConnectAsync 建立连接，SendAsync / RecvAsync 收发字节。TCP 是字节流、没有消息边界，必须自己约定分帧规则——这里用换行符结尾。",
            "using System;\nusing System.Net.Sockets;\n\nclass Program {\n    static async int Run() {\n        Socket.Initialize();\n        TcpClient c = await TcpClient.ConnectAsync(\"127.0.0.1\", 9000);\n        if (!c.IsConnected()) { Console.WriteLine(\"connect failed\"); return 1; }\n\n        int _n = await c.SendAsync(\"hello\\n\");\n        string reply = await c.RecvAsync(4096);\n        Console.WriteLine(\"reply: \" + reply);\n\n        c.Close();\n        return 0;\n    }\n\n    static void Main() { int r = await Run(); }\n}");
        DocsData.Doc(d, "Sockets", "套接字",
            "TCP Server & Framing",
            "TCP 服务端与分帧",
            "TcpListener accepts on a coroutine; every connection is handed to its own coroutine so one slow peer never blocks the accept loop. A single RecvAsync may return half a message or several, so buffer and split on the delimiter. An empty result means the peer closed.",
            "TcpListener 在协程里 accept，每条连接交给独立协程处理，慢客户端不会卡住 accept 循环。一次 RecvAsync 可能只收到半条消息、也可能收到多条，所以要缓冲后按分隔符切分。返回空串表示对端已关闭。",
            "using System;\nusing System.Net.Sockets;\n\nclass Program {\n    static async void HandleClient(nint sock) {\n        TcpClient c = TcpClient.FromSocket(sock);\n        string buf = \"\";\n        while (true) {\n            string chunk = await c.RecvAsync(4096);\n            if (chunk.Length == 0) { break; }      // peer closed\n            buf = buf + chunk;\n\n            int nl = buf.IndexOf(\"\\n\");\n            while (nl >= 0) {\n                string line = buf.Substring(0, nl);\n                buf = buf.Substring(nl + 1, buf.Length - nl - 1);\n                int _n = await c.SendAsync(\"echo: \" + line + \"\\n\");\n                nl = buf.IndexOf(\"\\n\");\n            }\n        }\n        c.Close();\n    }\n\n    static async int Run() {\n        Socket.Initialize();\n        TcpListener listener = TcpListener.Create(\"0.0.0.0\", 9000);\n        listener.Start();\n        while (true) {\n            nint sock = await listener.AcceptAsync();\n            if (sock >= 0) { Task.Spawn(HandleClient(sock)); }\n        }\n        return 0;\n    }\n\n    static void Main() { int r = await Run(); }\n}");
        DocsData.Doc(d, "Sockets", "套接字",
            "UDP Datagrams",
            "UDP 数据报",
            "UdpClient.Bind(host, port) receives on a port; SendToAsync / RecvFromAsync move whole datagrams. UDP keeps message boundaries so no framing is needed, but datagrams can be lost, duplicated or reordered -- add your own timeout and retry.",
            "UdpClient.Bind(host, port) 在端口上收包，SendToAsync / RecvFromAsync 收发完整数据报。UDP 保留消息边界，不需要分帧；但可能丢包、重复、乱序，需要自己做超时重发。",
            "using System;\nusing System.Net.Sockets;\n\nclass Program {\n    static async void Server() {\n        UdpClient srv = UdpClient.Bind(\"127.0.0.1\", 9100);\n        for (int i = 0; i < 3; i++) {\n            string msg = await srv.RecvFromAsync(4096);\n            Console.WriteLine(\"server got: \" + msg);\n            int _n = await srv.SendToAsync(\"ack: \" + msg, Socket.PeerIp(), Socket.PeerPort());\n        }\n        srv.Close();\n    }\n\n    static async int Run() {\n        Socket.Initialize();\n        Task.Spawn(Server());\n\n        UdpClient cli = UdpClient.Bind(\"127.0.0.1\", 9101);\n        int _s = await cli.SendToAsync(\"ping\", \"127.0.0.1\", 9100);\n        Console.WriteLine(\"client got: \" + await cli.RecvFromAsync(4096));\n        cli.Close();\n        return 0;\n    }\n\n    static void Main() { int r = await Run(); }\n}");
        DocsData.Doc(d, "Sockets", "套接字",
            "Callback-Style TCP / UDP",
            "回调式 TCP / UDP 服务",
            "The Worker form removes the accept loop: register onConnect / onReceive / onClose for TCP or onPacket for UDP; the return value of the handler is sent back, and returning \"\" replies with nothing.",
            "Worker 形式省掉 accept 循环：TCP 注册 onConnect / onReceive / onClose，UDP 注册 onPacket；处理函数的返回值会自动回给对端，返回 \"\" 表示不回复。",
            "using System;\nusing System.Net;\n\nclass Program {\n    static async void Connect(Connection conn) {\n        Console.WriteLine(\"open #\" + Convert.ToString(conn.GetId()));\n    }\n\n    static async string Receive(Connection conn, string data) {\n        return \"Zan: \" + data;\n    }\n\n    static async string Packet(string data) {\n        return \"Server: \" + data;\n    }\n\n    static async void Main() {\n        Worker tcp = Worker.Create(\"tcp\", \"0.0.0.0\", 9503);\n        tcp.count = 4;\n        tcp.onConnect = Program.Connect;\n        tcp.onReceive = Program.Receive;\n\n        Worker udp = Worker.Create(\"udp\", \"0.0.0.0\", 9504);\n        udp.onPacket = Program.Packet;\n\n        await Worker.RunAll();      // both protocols in one process\n    }\n}");
        DocsData.Doc(d, "Sockets", "套接字",
            "TLS Connections",
            "TLS 连接",
            "TlsStream wraps a connected socket in TLS, which is what the HTTPS and WSS clients use underneath. Reach for it when you need an encrypted stream for a protocol of your own.",
            "TlsStream 把已连接的套接字包装成 TLS 流，HTTPS 和 WSS 客户端内部用的就是它。自定义协议需要加密通道时可以直接用。",
            "using System;\nusing System.Net.Sockets;\nusing System.Net.Tls;\n\nclass Program {\n    static async int Run() {\n        Socket.Initialize();\n        TcpClient tcp = await TcpClient.ConnectAsync(\"example.com\", 443);\n\n        TlsStream tls = TlsStream.Client(tcp.GetSocket(), \"example.com\");\n        int _n = await tls.SendAsync(\"GET / HTTP/1.1\\r\\nHost: example.com\\r\\n\\r\\n\");\n        string head = await tls.RecvAsync(4096);\n        Console.WriteLine(head.Substring(0, 32));\n\n        tls.Close();\n        return 0;\n    }\n\n    static void Main() { int r = await Run(); }\n}");
        DocsData.Doc(d, "Messaging", "消息与物联网",
            "MQTT Publish & Subscribe",
            "MQTT 发布与订阅",
            "MqttClient.ConnectAsync(host, port, clientId) connects; SubscribeAsync registers a topic filter (+ matches one level, # matches the rest) and ReceiveAsync suspends until a message arrives. QoS 1 waits for the broker's PUBACK, QoS 0 does not.",
            "MqttClient.ConnectAsync(host, port, clientId) 连接；SubscribeAsync 订阅主题过滤器（+ 匹配一层，# 匹配多层），ReceiveAsync 挂起等待消息。QoS 1 会等 broker 的 PUBACK，QoS 0 不等。",
            "using System;\nusing System.Net.Sockets;\nusing System.Net.Mqtt;\n\nclass Program {\n    static async int Run() {\n        Socket.Initialize();\n\n        MqttClient sub = await MqttClient.ConnectAsync(\"127.0.0.1\", 1883, \"sub-1\");\n        int _s = await sub.SubscribeAsync(\"sensors/+/temp\", MqttQos.AtMostOnce);\n\n        MqttClient pub = await MqttClient.ConnectAsync(\"127.0.0.1\", 1883, \"pub-1\");\n        int _p = await pub.PublishAsync(\"sensors/kitchen/temp\", \"21.5\",\n                                        MqttQos.AtLeastOnce);\n\n        Console.WriteLine(\"received: \" + await sub.ReceiveAsync());\n\n        await sub.DisconnectAsync();\n        await pub.DisconnectAsync();\n        return 0;\n    }\n\n    static void Main() { int r = await Run(); }\n}");
        DocsData.Doc(d, "Messaging", "消息与物联网",
            "Built-in MQTT Broker",
            "内置 MQTT Broker",
            "MqttBroker is an MQTT v3.1.1 server written in Zan, so a deployment needs no external broker. RunAsync serves subscriptions, wildcard matching and fan-out to every matching subscriber.",
            "MqttBroker 是用 Zan 实现的 MQTT v3.1.1 服务端，部署时不需要外部 broker。RunAsync 负责订阅管理、通配符匹配，并把消息扇出给所有匹配的订阅者。",
            "using System;\nusing System.Net.Sockets;\nusing System.Net.Mqtt;\n\nclass Program {\n    static async int Run() {\n        Socket.Initialize();\n        MqttBroker broker = MqttBroker.Create(\"0.0.0.0\", 1883);\n        await broker.RunAsync();      // serves until Stop()\n        return 0;\n    }\n\n    static void Main() { int r = await Run(); }\n}");
        DocsData.Doc(d, "Messaging", "消息与物联网",
            "CoAP",
            "CoAP",
            "CoAP is a compact REST over UDP for constrained devices. CoapClient.Create(host, port) with SetTimeout(ms, retries) handles retransmission; GetAsync / PostAsync / PutAsync / DeleteAsync mirror HTTP and the reply carries a response code and payload.",
            "CoAP 是面向受限设备的 UDP 版 REST。CoapClient.Create(host, port) 配合 SetTimeout(ms, 重试次数) 处理重传；GetAsync / PostAsync / PutAsync / DeleteAsync 与 HTTP 对应，响应里带响应码和负载。",
            "using System;\nusing System.Net.Sockets;\nusing System.Net.Coap;\n\nclass Program {\n    static async int Main() {\n        CoapClient c = CoapClient.Create(\"127.0.0.1\", 5683).SetTimeout(1000, 2);\n\n        CoapResponse r = await c.GetAsync(\"sensors/temp\");\n        Console.WriteLine(\"GET -> \" + r.CodeText() + \" \" + r.payload);\n\n        CoapResponse w = await c.PutAsync(\"actuators/led\", \"on\");\n        Console.WriteLine(\"PUT -> \" + w.CodeText());\n        return 0;\n    }\n}");
        DocsData.Doc(d, "Messaging", "消息与物联网",
            "Modbus TCP",
            "Modbus TCP",
            "ModbusClient.ConnectAsync(host, port, unitId) speaks Modbus TCP to a PLC or meter: ReadHoldingAsync(address, count) reads registers, WriteRegisterAsync writes one and WriteRegistersAsync writes a block.",
            "ModbusClient.ConnectAsync(host, port, 从站号) 与 PLC、电表等设备通信：ReadHoldingAsync(地址, 数量) 读保持寄存器，WriteRegisterAsync 写单个，WriteRegistersAsync 写一批。",
            "using System;\nusing System.Net.Sockets;\nusing System.Net.Modbus;\n\nclass Program {\n    static async int Main() {\n        ModbusClient m = await ModbusClient.ConnectAsync(\"192.168.1.50\", 502, 1);\n\n        List<int> vals = await m.ReadHoldingAsync(0, 4);\n        foreach (int v in vals) { Console.WriteLine(Convert.ToString(v)); }\n\n        int ok = await m.WriteRegisterAsync(2, 1234);\n        List<int> back = await m.ReadHoldingAsync(2, 1);\n        Console.WriteLine(\"wrote=\" + Convert.ToString(ok)\n            + \" read back=\" + Convert.ToString(back[0]));\n\n        m.Close();\n        return 0;\n    }\n}");
        DocsData.Doc(d, "Messaging", "消息与物联网",
            "NTP Time Sync",
            "NTP 时间同步",
            "NtpClient.QueryAsync(host, port, timeoutMs) returns the server's Unix time in seconds (SNTP over UDP), which is how a device corrects its clock without trusting the local one.",
            "NtpClient.QueryAsync(host, port, 超时毫秒) 返回服务端的 Unix 秒（UDP 上的 SNTP），设备靠它校时，而不是相信本地时钟。",
            "using System;\nusing System.Net.Sockets;\nusing System.Net.Ntp;\n\nclass Program {\n    static async int Main() {\n        Socket.Initialize();\n        long unix = await NtpClient.QueryAsync(\"pool.ntp.org\", 123, 2000);\n        if (unix <= 0) { Console.WriteLine(\"ntp timeout\"); return 1; }\n        Console.WriteLine(\"unix seconds: \" + Convert.ToString(unix));\n        return 0;\n    }\n}");
        DocsData.Doc(d, "Messaging", "消息与物联网",
            "SIP Signalling",
            "SIP 信令",
            "SipClient.Create(host, port, user) sends SIP requests over UDP: OptionsAsync probes a server's capabilities and RegisterAsync registers a contact. A null reply means the request timed out; SipMessage.Header reads any header off the answer.",
            "SipClient.Create(host, port, 用户) 通过 UDP 发送 SIP 请求：OptionsAsync 探测服务端能力，RegisterAsync 注册地址。返回 null 表示超时；SipMessage.Header 可读取应答里的任意头。",
            "using System;\nusing System.Net.Sockets;\nusing System.Net.Sip;\n\nclass Program {\n    static async int Main() {\n        SipClient c = SipClient.Create(\"sip.example.com\", 5060, \"zan-demo\");\n\n        SipMessage r = await c.OptionsAsync();\n        if (r == null) { Console.WriteLine(\"OPTIONS timed out\"); return 1; }\n        Console.WriteLine(Convert.ToString(r.status) + \" \" + r.reason\n            + \" allow=\" + r.Header(\"Allow\"));\n\n        SipMessage reg = await c.RegisterAsync(\"alice\", 3600);\n        Console.WriteLine(\"REGISTER -> \" + Convert.ToString(reg.status));\n        return 0;\n    }\n}");
        DocsData.Doc(d, "Remote Calls", "远程调用",
            "JSON-RPC Server",
            "JSON-RPC 服务端",
            "RpcServer.Create(host, port, codec) dispatches by method name to registered async handlers; each peer runs on its own coroutine. Arguments and results are JsonValue, so a handler never parses a wire format itself.",
            "RpcServer.Create(host, port, 编解码器) 按方法名分发到注册的异步处理函数，每个连接独立协程。参数和结果都是 JsonValue，处理函数不用碰任何线上格式。",
            "using System;\nusing System.Json;\nusing System.Net.Rpc;\n\nclass Program {\n    static async RpcResponse Add(RpcRequest req) {\n        int a = req.args.Int(\"a\", 0);\n        int b = req.args.Int(\"b\", 0);\n        return RpcResponse.Ok(req.id, JsonValue.NewNum(Convert.ToString(a + b)));\n    }\n\n    static async int Run() {\n        RpcServer s = RpcServer.Create(\"0.0.0.0\", 4000, new JsonRpcCodec());\n        s.On(\"add\", Program.Add);\n        await s.Start();\n        return 0;\n    }\n\n    static void Main() { int r = await Run(); }\n}");
        DocsData.Doc(d, "Remote Calls", "远程调用",
            "JSON-RPC Client",
            "JSON-RPC 客户端",
            "RpcClient.ConnectAsync(host, port, codec) calls a remote method with CallAsync and gets a correlated RpcResponse; check IsError() once, whatever the protocol. NotifyAsync is fire-and-forget (no id, no reply).",
            "RpcClient.ConnectAsync(host, port, 编解码器) 用 CallAsync 调用远程方法，返回按 id 关联的 RpcResponse，统一用 IsError() 判断失败。NotifyAsync 是通知式调用（无 id、不等回复）。",
            "using System;\nusing System.Json;\nusing System.Net.Rpc;\n\nclass Program {\n    static async int Run() {\n        RpcClient c = await RpcClient.ConnectAsync(\"127.0.0.1\", 4000,\n                                                   new JsonRpcCodec());\n\n        JsonValue args = JsonValue.NewObject();\n        args.Set(\"a\", JsonValue.NewNum(\"2\"));\n        args.Set(\"b\", JsonValue.NewNum(\"40\"));\n\n        RpcResponse r = await c.CallAsync(\"add\", args);\n        if (r.IsError()) {\n            Console.WriteLine(\"rpc failed: \" + r.error.message);\n        } else {\n            Console.WriteLine(\"sum = \" + r.result.ToJson());\n        }\n\n        await c.NotifyAsync(\"log\", args);   // no response expected\n        c.Close();\n        return 0;\n    }\n\n    static void Main() { int r = await Run(); }\n}");
        DocsData.Doc(d, "Remote Calls", "远程调用",
            "Swapping the Protocol",
            "切换 RPC 协议",
            "The codec is the only protocol-specific part: pass XmlRpcCodec instead of JsonRpcCodec and the same client and server speak XML-RPC. Handlers, arguments and results are unchanged.",
            "协议只体现在编解码器上：把 JsonRpcCodec 换成 XmlRpcCodec，同一套客户端和服务端就说 XML-RPC，处理函数、参数、结果都不用改。",
            "using System;\nusing System.Net.Rpc;\n\n// server\nRpcServer s = RpcServer.Create(\"0.0.0.0\", 4000, new XmlRpcCodec());\ns.On(\"add\", Program.Add);\n\n// client\nRpcClient c = await RpcClient.ConnectAsync(\"127.0.0.1\", 4000, new XmlRpcCodec());");
    }

    static void PartDb(List<DocEntry> d) {
        DocsData.Doc(d, "Database", "数据库",
            "Choosing a Database",
            "选型速查",
            "Zan ships native drivers plus an ODBC channel. SQLite (embedded, zero setup) for local relational data; ZanDb for JSON documents with no SQL; PgConnection / MySqlConnection for production PostgreSQL / MySQL over the native wire protocol; DbConnection (ODBC) for SQL Server, Oracle, DM, Kingbase, ClickHouse and anything else with a driver; RedisClient for cache and counters. The ORM drives all SQL connections through the IDbExecutor interface, so switching engines does not change business code.",
            "Zan 内置原生驱动 + ODBC 通道。本地关系型存储用 SQLite（内嵌、零配置）；不想写 SQL 的文档存储用 ZanDb；生产 PostgreSQL / MySQL 用 PgConnection / MySqlConnection（原生线协议）；SQL Server、Oracle、达梦、金仓、ClickHouse 等用 DbConnection（ODBC）；缓存计数用 RedisClient。ORM 通过 IDbExecutor 接口驱动所有 SQL 连接，换数据库不用改业务代码。",
            "using System.Data;            // DbConnection (ODBC), DbParams, DbResult\nusing System.Data.Sqlite;     // SqliteConnection - embedded, zero dependency\nusing System.Data.Postgres;   // PgConnection - native libpq\nusing System.Data.MySql;      // MySqlConnection - native protocol, async\nusing System.Data.Redis;      // RedisClient - cache / counters\nusing System.Data.ZanDb;      // ZanDatabase - embedded document store\nusing System.Data.Orm;        // Model / QueryBuilder / Migration");
        DocsData.Doc(d, "Database", "数据库",
            "SQLite: Open a Database",
            "SQLite：打开数据库",
            "SqliteConnection.Open(path) opens (or creates) a database file with no server and no external dependency. IsConnected() reports the result, GetError() explains a failure, Close() releases it.",
            "SqliteConnection.Open(path) 打开（不存在则创建）一个数据库文件，无需服务端、零外部依赖。IsConnected() 判断是否成功，GetError() 给出失败原因，Close() 释放连接。",
            "using System;\nusing System.Data.Sqlite;\n\nSqliteConnection db = SqliteConnection.Open(\"app.db\");\nif (!db.IsConnected()) {\n    Console.WriteLine(\"open failed: \" + db.GetError());\n    return;\n}\ndb.Execute(\"CREATE TABLE IF NOT EXISTS books (\"\n    + \"id INTEGER PRIMARY KEY AUTOINCREMENT, \"\n    + \"title TEXT NOT NULL, author TEXT, price REAL)\");\ndb.Close();");
        DocsData.Doc(d, "Database", "数据库",
            "Insert with Parameters",
            "参数化插入",
            "Never paste values into SQL text: write `?` placeholders and pass a DbParams. Add for text, AddInt / AddDouble for numbers, AddNull for NULL. Quotes inside a value need no escaping, and injection is impossible. LastInsertId() returns the auto-increment key just written.",
            "不要把值拼进 SQL 文本：用 `?` 占位符并传入 DbParams。文本用 Add，数字用 AddInt / AddDouble，空值用 AddNull。值里的引号无需转义，天然防注入。LastInsertId() 取回刚写入的自增主键。",
            "using System;\nusing System.Data;\nusing System.Data.Sqlite;\n\nSqliteConnection db = SqliteConnection.Open(\"app.db\");\ndb.Execute(\"INSERT INTO books (title, author, price) VALUES (?, ?, ?)\",\n    DbParams.Create().Add(\"Zan in Action\").Add(\"Alice\").AddDouble(59.9));\ndb.Execute(\"INSERT INTO books (title, author, price) VALUES (?, ?, ?)\",\n    DbParams.Create().Add(\"Compilers\").Add(\"O'Brien\").AddDouble(99.0));\n// An unknown author is NULL, not an empty string.\ndb.Execute(\"INSERT INTO books (title, author, price) VALUES (?, ?, ?)\",\n    DbParams.Create().Add(\"Anonymous\").AddNull().AddDouble(9.9));\nConsole.WriteLine(\"new id: \" + Convert.ToString(db.LastInsertId()));");
        DocsData.Doc(d, "Database", "数据库",
            "Query and Read Rows",
            "查询与读取结果",
            "Query returns a DbResult held in memory: RowCount() / ColumnCount() size it, GetString(row, col) and GetByName(row, \"col\") read cells, IsNullByName tells NULL apart from an empty string. ExecuteScalar returns the first cell of the first row - the usual way to read COUNT / MAX.",
            "Query 返回内存中的 DbResult：RowCount() / ColumnCount() 给出大小，GetString(行, 列) 和 GetByName(行, \"列名\") 取单元格，IsNullByName 区分 NULL 和空串。ExecuteScalar 返回首行首列，常用于 COUNT / MAX。",
            "using System;\nusing System.Data;\nusing System.Data.Sqlite;\n\nDbResult r = db.Query(\n    \"SELECT id, title, author FROM books WHERE price > ? ORDER BY id\",\n    DbParams.Create().AddDouble(20.0));\nfor (int i = 0; i < r.RowCount(); i = i + 1) {\n    string author = r.GetByName(i, \"author\");\n    if (r.IsNullByName(i, \"author\")) { author = \"(unknown)\"; }\n    Console.WriteLine(\"#\" + r.GetByName(i, \"id\") + \" \"\n        + r.GetByName(i, \"title\") + \" by \" + author);\n}\nConsole.WriteLine(\"count: \" + db.ExecuteScalar(\"SELECT COUNT(*) FROM books\"));");
        DocsData.Doc(d, "Database", "数据库",
            "Update and Delete",
            "更新与删除",
            "Execute returns the number of affected rows for UPDATE and DELETE, so you can tell a no-op from a real change. Keep the WHERE values in DbParams as well.",
            "UPDATE 与 DELETE 的 Execute 返回受影响行数，可以据此区分“没匹配到”和“真的改了”。WHERE 里的值同样放进 DbParams。",
            "using System;\nusing System.Data;\n\nint updated = db.Execute(\"UPDATE books SET price = price * 0.5 WHERE title = ?\",\n    DbParams.Create().Add(\"Compilers\"));\nConsole.WriteLine(\"discounted: \" + Convert.ToString(updated));\n\nint deleted = db.Execute(\"DELETE FROM books WHERE price < ?\",\n    DbParams.Create().AddDouble(10.0));\nConsole.WriteLine(\"removed: \" + Convert.ToString(deleted));");
        DocsData.Doc(d, "Database", "数据库",
            "Transactions",
            "事务",
            "BeginTransaction / Commit / Rollback group writes into one atomic unit - and make bulk inserts an order of magnitude faster, because autocommit no longer flushes once per statement. Roll back on any error so a half-written batch never lands.",
            "BeginTransaction / Commit / Rollback 把多次写入合并为一个原子单元——同时让批量插入快一个数量级，因为不再每条语句都自动提交落盘。出错时回滚，避免写一半的数据留在库里。",
            "using System;\nusing System.Data;\n\ndb.BeginTransaction();\nfor (int i = 0; i < 1000; i = i + 1) {\n    db.Execute(\"INSERT INTO books (title, price) VALUES (?, ?)\",\n        DbParams.Create().Add(\"batch \" + Convert.ToString(i)).AddDouble(1.0));\n}\ndb.Commit();          // one flush for the whole batch\n\ndb.BeginTransaction();\ndb.Execute(\"DELETE FROM books\");\ndb.Rollback();        // nothing was deleted after all");
        DocsData.Doc(d, "Database", "数据库",
            "Connection Pool",
            "连接池",
            "A pool reuses connections across coroutines and caps concurrency: AcquireAsync suspends (it does not block a thread) when the pool is full, Release hands the connection back. SqlitePool / PgPool / MySqlPool / FirebirdPool follow the same shape.",
            "连接池在多个协程间复用连接并给并发封顶：池满时 AcquireAsync 挂起协程（不阻塞线程），Release 归还连接。SqlitePool / PgPool / MySqlPool / FirebirdPool 用法一致。",
            "using System;\nusing System.Data.Sqlite;\n\nstatic async int Total(string path) {\n    SqlitePool pool = SqlitePool.Create(path, 4);   // at most 4 connections\n    SqliteConnection db = await pool.AcquireAsync();\n    int n = Convert.ToInt(db.ExecuteScalar(\"SELECT COUNT(*) FROM books\"));\n    pool.Release(db);\n    pool.Close();\n    return n;\n}");
        DocsData.Doc(d, "Database", "数据库",
            "PostgreSQL",
            "PostgreSQL",
            "PgConnection speaks to PostgreSQL (and openGauss / Kingbase and other PG-protocol engines) through native libpq. OpenParams(host, port, database, user, password) connects synchronously, OpenParamsAsync inside a coroutine. `?` placeholders are rewritten to $1..$n and bound natively.",
            "PgConnection 通过原生 libpq 连接 PostgreSQL（以及 openGauss、金仓等 PG 协议引擎）。OpenParams(主机, 端口, 库名, 用户, 密码) 同步连接，协程里用 OpenParamsAsync。`?` 占位符会自动改写为 $1..$n 并原生绑定。",
            "using System;\nusing System.Data;\nusing System.Data.Postgres;\n\nPgConnection db = PgConnection.OpenParams(\n    \"127.0.0.1\", 5432, \"postgres\", \"postgres\", \"secret\");\nif (!db.IsConnected()) {\n    Console.WriteLine(\"connect failed: \" + db.GetError());\n    return;\n}\ndb.Execute(\"CREATE TABLE IF NOT EXISTS books (\"\n    + \"id SERIAL PRIMARY KEY, title TEXT NOT NULL, price NUMERIC(8,2))\");\ndb.Execute(\"INSERT INTO books (title, price) VALUES (?, ?)\",\n    DbParams.Create().Add(\"Zan in Action\").AddDouble(59.9));\nDbResult r = db.Query(\"SELECT id, title FROM books ORDER BY id\");\ndb.Close();");
        DocsData.Doc(d, "Database", "数据库",
            "MySQL / MariaDB",
            "MySQL / MariaDB",
            "MySqlConnection implements the MySQL wire protocol in pure Zan (mysql_native_password and caching_sha2_password, no C dependency) and is fully asynchronous. The *ParamsAsync calls use prepared statements over the binary protocol with a statement cache, so a loop prepares once. TiDB / OceanBase and other protocol-compatible engines work the same way.",
            "MySqlConnection 用纯 Zan 实现 MySQL 线协议（支持 mysql_native_password 与 caching_sha2_password，无 C 依赖），全异步。*ParamsAsync 走二进制协议的预处理语句并带语句缓存，循环插入只 PREPARE 一次。TiDB、OceanBase 等协议兼容引擎同样适用。",
            "using System;\nusing System.Data;\nusing System.Data.MySql;\n\nstatic async int Run() {\n    MySqlConnection db = await MySqlConnection.OpenParamsAsync(\n        \"127.0.0.1\", 3306, \"demo\", \"root\", \"secret\");\n    if (!db.IsConnected()) { return -1; }\n\n    await db.ExecuteParamsAsync(\n        \"INSERT INTO books (title, price) VALUES (?, ?)\",\n        DbParams.Create().Add(\"Zan in Action\").AddDouble(59.9));\n\n    DbResult r = await db.QueryParamsAsync(\n        \"SELECT id, title FROM books WHERE price > ?\",\n        DbParams.Create().AddDouble(20.0));\n    db.Close();\n    return r.RowCount();\n}");
        DocsData.Doc(d, "Database", "数据库",
            "SQL Server, Oracle and ODBC",
            "SQL Server / Oracle 等 ODBC 引擎",
            "DbConnection reaches every engine with an ODBC driver installed (Windows odbc32, Linux/macOS unixODBC). Convenience factories: OpenSqlServer / OpenOracle / OpenMySQL / OpenPostgreSQL / OpenDM / OpenKingbase / OpenOpenGauss / OpenClickHouse / OpenTDengine / OpenDuckDB / OpenSQLite / OpenFirebird, plus OpenODBC for any DSN or connection string. The API (Execute / Query / ExecuteScalar, with DbParams) is the same for all of them; GetProvider() reports which engine you got.",
            "DbConnection 可连接任何装有 ODBC 驱动的引擎（Windows 用 odbc32，Linux/macOS 用 unixODBC）。便捷工厂：OpenSqlServer / OpenOracle / OpenMySQL / OpenPostgreSQL / OpenDM（达梦）/ OpenKingbase（金仓）/ OpenOpenGauss / OpenClickHouse / OpenTDengine / OpenDuckDB / OpenSQLite / OpenFirebird，以及万能入口 OpenODBC（任意 DSN 或连接串）。所有引擎共用同一套 API（Execute / Query / ExecuteScalar + DbParams）；GetProvider() 返回实际引擎类型。",
            "using System;\nusing System.Data;\n\nDbConnection db = DbConnection.OpenSqlServer(\n    \"127.0.0.1\", 1433, \"demo\", \"sa\", \"secret\");\n// Any driver by DSN or full connection string:\n// DbConnection db = DbConnection.OpenODBC(\"DSN=mydb;UID=sa;PWD=secret\");\nif (!db.IsConnected()) {\n    Console.WriteLine(\"connect failed: \" + db.GetError());\n    return;\n}\nConsole.WriteLine(\"provider: \" + Convert.ToString(db.GetProvider()));\ndb.Execute(\"INSERT INTO books (id, title, price) VALUES (?, ?, ?)\",\n    DbParams.Create().AddInt(1).Add(\"Zan in Action\").AddInt(59));\nDbResult r = db.Query(\"SELECT id, title FROM books ORDER BY id\");\ndb.Close();");
        DocsData.Doc(d, "Database", "数据库",
            "Error Handling",
            "错误处理",
            "Connections report failure instead of crashing: check IsConnected() after opening and read GetError() for the driver's message. Wrap a batch in try/catch plus Rollback so a failed statement cannot leave a half-applied transaction behind.",
            "连接失败不会崩溃，而是返回状态：打开后检查 IsConnected()，用 GetError() 读取驱动给出的错误信息。批量写入用 try/catch + Rollback 包住，避免失败时留下写了一半的事务。",
            "using System;\nusing System.Data;\n\ntry {\n    db.BeginTransaction();\n    db.Execute(\"UPDATE account SET balance = balance - ? WHERE id = ?\",\n        DbParams.Create().AddInt(100).AddInt(1));\n    db.Execute(\"UPDATE account SET balance = balance + ? WHERE id = ?\",\n        DbParams.Create().AddInt(100).AddInt(2));\n    db.Commit();\n} catch (Exception e) {\n    db.Rollback();\n    Console.WriteLine(\"transfer failed: \" + db.GetError());\n}");
        DocsData.Doc(d, "Database", "数据库",
            "ORM: Entities and CodeFirst",
            "ORM：实体与建表（CodeFirst）",
            "An entity is a plain class: its fields are the columns, an int field named id is the auto-increment primary key, and the table name is the lower-cased class name. db.SyncStructure<T>() creates the table if it is missing and adds columns that were added to the class, using each provider's own types. The compiler generates the mapping, so there is no reflection and no string column names at the call site.",
            "实体就是普通类：字段即列，名为 id 的 int 字段是自增主键，表名取类名小写。db.SyncStructure<T>() 在表不存在时建表，类里新增的字段会自动补列，类型按各数据库方言生成。映射由编译器生成，运行期没有反射，调用处也不需要写列名字符串。",
            "using System;\nusing System.Data;\nusing System.Data.Sqlite;\n\nclass Blog {\n    int id;              // auto-increment primary key\n    string title;\n    int clicks;\n    double score;\n    bool online;\n}\n\nSqliteConnection db = SqliteConnection.Open(\"app.db\");\ndb.SyncStructure<Blog>();     // create or extend the table");
        DocsData.Doc(d, "Database", "数据库",
            "ORM: Lambda Queries",
            "ORM：lambda 查询",
            "db.Select<T>() starts a typed chain: Where takes a lambda over the entity, so columns are checked by the compiler and autocompleted. == != > >= < <= && || and the string helpers Contains / StartsWith / EndsWith / Like translate to SQL, values are always bound as parameters. OrderBy / OrderByDescending sort, Skip + Take paginate, ToList / First / Count / Any / Sum / Max / Min / Avg finish the chain. WhereIf(cond, lambda) adds a filter only when cond is true.",
            "db.Select<T>() 开始类型化链式查询：Where 接收实体 lambda，列名由编译器检查、可自动补全。== != > >= < <= && || 以及 Contains / StartsWith / EndsWith / Like 都会翻译成 SQL，值始终以参数绑定。OrderBy / OrderByDescending 排序，Skip + Take 分页，ToList / First / Count / Any / Sum / Max / Min / Avg 收尾。WhereIf(条件, lambda) 只在条件成立时追加过滤。",
            "using System;\nusing System.Data;\n\nList<Blog> hot = db.Select<Blog>()\n    .Where(a => a.clicks >= 8 && a.online)\n    .OrderByDescending(a => a.clicks)\n    .Take(10)\n    .ToList();\n\nBlog one = db.Select<Blog>().Where(a => a.title == \"hello zan\").First();\nint total = db.Select<Blog>().Where(a => a.title.Contains(\"zan\")).Count();\nlong sum = db.Select<Blog>().Sum(a => a.clicks);\n\n// page 2, 20 per page; the keyword filter only applies when one was typed\nstring kw = \"\";\nList<Blog> page = db.Select<Blog>()\n    .WhereIf(kw.Length > 0, a => a.title.Contains(kw))\n    .OrderBy(a => a.id)\n    .Skip(20).Take(20)\n    .ToList();");
        DocsData.Doc(d, "Database", "数据库",
            "ORM: Insert",
            "ORM：插入",
            "db.Insert<T>(entity) inserts one row, db.Insert<T>(list) inserts a batch in a single statement, and AppendData adds more rows to the same chain. ExecuteAffrows() returns the affected row count, ExecuteIdentity() returns the new auto-increment id. InsertColumns / IgnoreColumns restrict which columns are written.",
            "db.Insert<T>(实体) 插入一行，db.Insert<T>(列表) 一条语句批量插入，AppendData 可继续往同一条链里追加。ExecuteAffrows() 返回受影响行数，ExecuteIdentity() 返回新生成的自增 id。InsertColumns / IgnoreColumns 限定写入哪些列。",
            "using System;\nusing System.Data;\n\nBlog b = new Blog();\nb.title = \"hello zan\";\nb.clicks = 3;\nint id = db.Insert<Blog>(b).ExecuteIdentity();\n\nList<Blog> many = new List<Blog> { First(), Second(), Third() };\nint rows = db.Insert<Blog>(many).ExecuteAffrows();\n\n// only these columns are written, the rest keep their database defaults\ndb.Insert<Blog>(b).InsertColumns(a => a.title).ExecuteAffrows();");
        DocsData.Doc(d, "Database", "数据库",
            "ORM: Update Only the Fields You Mean",
            "ORM：只更新指定字段",
            "Business code usually changes two or three fields, not a whole row. Set(a => a.field, value) writes exactly those columns and SetIncr(a => a.field, n) emits field = field + n, so no read-modify-write is needed. When you do have a full entity, SetSource(o) plus UpdateColumns(...) / IgnoreColumns(...) restricts the UPDATE to the columns you name. A chain without a Where refuses to run, so a missing condition can never wipe the table.",
            "业务里更新往往只改两三个字段，而不是整行。Set(a => a.字段, 值) 只写这些列，SetIncr(a => a.字段, n) 生成 字段 = 字段 + n，不必先查再写。手上是完整实体时，用 SetSource(o) 配合 UpdateColumns(...) / IgnoreColumns(...) 限定实际更新的列。没有 Where 的链不会执行，漏写条件不会清空整表。",
            "using System;\nusing System.Data;\n\nint n = db.Update<Blog>()\n    .Set(a => a.title, \"new title\")\n    .SetIncr(a => a.clicks, 1)          // clicks = clicks + 1\n    .Where(a => a.id == id)\n    .ExecuteAffrows();\n\n// a whole entity, but only title is actually written\ndb.Update<Blog>()\n    .SetSource(blog)\n    .UpdateColumns(a => a.title)\n    .ExecuteAffrows();\n\n// everything except the columns you protect\ndb.Update<Blog>()\n    .SetSource(blog)\n    .IgnoreColumns(a => a.clicks)\n    .ExecuteAffrows();\n\nint gone = db.Delete<Blog>().Where(a => a.clicks == 0).ExecuteAffrows();");
        DocsData.Doc(d, "Database", "数据库",
            "ORM: Dynamic Values (forms, JSON)",
            "ORM：动态字段（表单、JSON）",
            "Submitted data arrives as a bag of fields, not as a lambda per column. DbValues.Create().Set(name, value) collects them and <Entity>Cols gives an autocompleted constant per column, so keys stay checked: an unknown key throws instead of reaching SQL. AppendDict inserts one bag or a List<DbValues> batch, SetDict updates exactly the submitted fields, WhereDict builds dynamic conditions. Values are bound as parameters and converted to the column's declared type, so a form that carries everything as text still writes an INTEGER column as a number - a value that cannot convert throws and names the column.",
            "提交上来的数据是一堆字段，不可能每列写一个 lambda。用 DbValues.Create().Set(列, 值) 收集，列名用生成的 <Entity>Cols 常量（可自动补全），键会被校验：不属于该实体的键直接抛异常，不会进入 SQL。AppendDict 插入单个字典或 List<DbValues> 批量，SetDict 只更新提交到的字段，WhereDict 拼动态条件。所有值都是参数绑定，并按列声明类型转换——表单里全是字符串也能正确写入 INTEGER 列，转换不了会抛出并指明是哪一列。",
            "using System;\nusing System.Data;\n\nDbValues form = DbValues.Create()\n    .Set(BlogCols.title, \"hello\")\n    .Set(BlogCols.clicks, \"42\")        // text in, INTEGER column out\n    .Set(BlogCols.score, 1.5);\n\ndb.Insert<Blog>().AppendDict(form).ExecuteAffrows();\n\nList<DbValues> rows = new List<DbValues> { form, other };\ndb.Insert<Blog>().AppendDict(rows).ExecuteAffrows();\n\n// only the submitted fields are updated\ndb.Update<Blog>().SetDict(form).Where(a => a.id == id).ExecuteAffrows();\n\n// dynamic conditions, still parameterised\nDbValues cond = DbValues.Create().Set(BlogCols.title, \"hello\");\nint n = db.Select<Blog>().WhereDict(cond).Count();\n\nform.Remove(BlogCols.clicks);          // drop a field before executing");
        DocsData.Doc(d, "Database", "数据库",
            "ORM: Connection Pool and Transactions",
            "ORM：连接池与事务",
            "The chain runs on any IDbExecutor, so a connection checked out of a pool drives it unchanged. DbPool (or the typed SqlitePool / MySqlPool / PgPool) hands one out with await pool.AcquireAsync(), which suspends the coroutine instead of blocking a thread when the pool is saturated, and Release puts it back - use the typed pool when you also need driver-only members such as transactions. BeginTransaction / Commit / Rollback wrap several chained statements into one unit.",
            "链式 API 执行在 IDbExecutor 上，因此从连接池取出的连接可以原样使用。DbPool（或类型化的 SqlitePool / MySqlPool / PgPool）用 await pool.AcquireAsync() 取连接，池满时挂起协程而不是阻塞线程，Release 归还；需要驱动特有成员（如事务）时用类型化池。BeginTransaction / Commit / Rollback 把多条链式语句合成一个事务单元。",
            "using System;\nusing System.Data;\nusing System.Data.Sqlite;\n\nstatic async void Work(SqlitePool pool) {\n    SqliteConnection db = await pool.AcquireAsync();\n\n    db.BeginTransaction();\n    db.Insert<Blog>(blog).ExecuteAffrows();\n    db.Update<Blog>().SetIncr(a => a.clicks, 1)\n        .Where(a => a.id == 1).ExecuteAffrows();\n    db.Commit();                       // or db.Rollback();\n\n    List<Blog> open = db.Select<Blog>().Where(a => a.online).ToList();\n    pool.Release(db);                  // always give it back\n}\n\nSqlitePool pool = SqlitePool.Create(\"app.db\", 8);\nawait Work(pool);\npool.Close();");
        DocsData.Doc(d, "Database", "数据库",
            "Query Builder: Safe SQL",
            "查询构建器：安全拼 SQL",
            "QueryBuilder writes the SQL text and the bound parameter list separately, so values never enter the statement. From / InsertInto / Update / DeleteFrom start a chain; BuildSelectParams(columns) with SelectParams(), BuildInsertParams() with InsertParams(), BuildUpdateParams() with UpdateParams() and BuildDeleteParams() hand both halves to the connection. Table and column names are validated at build time - an injected identifier throws instead of running.",
            "QueryBuilder 把 SQL 文本和绑定参数分开生成，值永远不进入语句文本。From / InsertInto / Update / DeleteFrom 开始链式构建；BuildSelectParams(列) 配 SelectParams()、BuildInsertParams() 配 InsertParams()、BuildUpdateParams() 配 UpdateParams()、BuildDeleteParams() 配 SelectParams()，两半一起交给连接执行。表名列名在构建期校验——注入的标识符会直接抛异常，而不是被执行。",
            "using System;\nusing System.Data;\nusing System.Data.Orm;\n\nQueryBuilder q = QueryBuilder.From(\"users\")\n    .WhereEq(\"city\", \"Beijing\")\n    .WhereGeInt(\"age\", 18);\nDbResult r = db.Query(q.BuildSelectParams(\"name, age\"), q.SelectParams());\n\nQueryBuilder ins = QueryBuilder.InsertInto(\"users\")\n    .Set(\"name\", \"O'Brien\").Set(\"city\", \"Beijing\").SetInt(\"age\", 41);\ndb.Execute(ins.BuildInsertParams(), ins.InsertParams());\n\nQueryBuilder up = QueryBuilder.Update(\"users\")\n    .Set(\"city\", \"Hangzhou\").WhereEq(\"name\", \"Bob\");\ndb.Execute(up.BuildUpdateParams(), up.UpdateParams());\n\nQueryBuilder del = QueryBuilder.DeleteFrom(\"users\").WhereLtInt(\"age\", 18);\ndb.Execute(del.BuildDeleteParams(), del.SelectParams());");
        DocsData.Doc(d, "Database", "数据库",
            "Complex Conditions",
            "复杂条件",
            "The whole condition family stacks as AND unless you say otherwise: WhereEq / WhereNe, WhereGtInt / WhereGeInt / WhereLtInt / WhereLeInt, WhereBetween, WhereIn / WhereNotIn, WhereLike / WhereContains / WhereStartsWith, WhereNull / WhereNotNull, and OrWhere for an OR branch.",
            "条件族默认以 AND 叠加，需要 OR 时用 OrWhere：WhereEq / WhereNe、WhereGtInt / WhereGeInt / WhereLtInt / WhereLeInt、WhereBetween、WhereIn / WhereNotIn、WhereLike / WhereContains / WhereStartsWith、WhereNull / WhereNotNull。",
            "using System.Data;\nusing System.Data.Orm;\n\nList<string> cities = new List<string> { \"Beijing\", \"Shanghai\" };\n\nQueryBuilder q = QueryBuilder.From(\"users\")\n    .WhereIn(\"city\", cities)\n    .WhereBetween(\"age\", \"20\", \"36\")\n    .WhereStartsWith(\"name\", \"O'\")\n    .WhereNotNull(\"email\")\n    .OrWhere(\"age > 40\")\n    .OrderByDesc(\"age\");\nDbResult r = db.Query(q.BuildSelectParams(\"name, age\"), q.SelectParams());");
        DocsData.Doc(d, "Database", "数据库",
            "Joins and Aggregates",
            "连接与聚合",
            "Join / LeftJoin add tables on an ON condition (qualify columns as table.column); GroupBy + Having aggregate, Distinct removes duplicates. A LEFT JOIN with WhereNull on the right-hand key is the standard \"rows without a match\" query.",
            "Join / LeftJoin 按 ON 条件连接多表（列名用 表.列 限定）；GroupBy + Having 做聚合，Distinct 去重。LEFT JOIN 配合对右表主键的 WhereNull，就是标准的“查没有匹配记录的行”。",
            "using System;\nusing System.Data;\nusing System.Data.Orm;\n\n// users with a big order, largest first\nQueryBuilder q = QueryBuilder.From(\"users\")\n    .Join(\"orders\", \"orders.user_id = users.id\")\n    .WhereGtInt(\"orders.amount\", 100)\n    .OrderByDesc(\"orders.amount\");\nDbResult r = db.Query(q.BuildSelectParams(\"users.name, orders.amount\"),\n                      q.SelectParams());\n\n// users with no orders at all\nQueryBuilder none = QueryBuilder.From(\"users\")\n    .LeftJoin(\"orders\", \"orders.user_id = users.id\")\n    .WhereNull(\"orders.id\");\nConsole.WriteLine(db.ExecuteScalar(none.BuildSelectParams(\"COUNT(*)\"),\n                                   none.SelectParams()));\n\n// cities with at least two users\nQueryBuilder g = QueryBuilder.From(\"users\")\n    .GroupBy(\"city\").Having(\"COUNT(*) >= 2\").OrderBy(\"city\");\nDbResult byCity = db.Query(g.BuildSelectParams(\"city, COUNT(*)\"),\n                           g.SelectParams());");
        DocsData.Doc(d, "Database", "数据库",
            "Paging Dialects",
            "分页方言",
            "Limit + Offset emit LIMIT/OFFSET by default. SQL Server and Oracle want OFFSET .. FETCH instead: call Dialect(SqlDialect.SqlServer) and the builder emits the right form - the rest of the chain is unchanged. GetProvider() tells you which one the connection needs.",
            "Limit + Offset 默认生成 LIMIT/OFFSET。SQL Server 与 Oracle 需要 OFFSET .. FETCH：调用 Dialect(SqlDialect.SqlServer) 即可生成对应写法，链式的其它部分不变。用 GetProvider() 判断当前连接属于哪一类。",
            "using System.Data;\nusing System.Data.Orm;\n\nQueryBuilder q = QueryBuilder.From(\"users\").OrderBy(\"id\").Limit(20).Offset(40);\nif (db.GetProvider() == DbProvider.SqlServer\n    || db.GetProvider() == DbProvider.Oracle) {\n    q.Dialect(SqlDialect.SqlServer);\n}\nDbResult page = db.Query(q.BuildSelectParams(\"*\"), q.SelectParams());");
        DocsData.Doc(d, "Database", "数据库",
            "Migrations",
            "数据库迁移",
            "A Migration is a named pair of up/down statements. Migration.RunAll(db, list) applies the ones this database has not seen yet, in order, and records them in a _migrations table - running it again does nothing, so it is safe on every startup.",
            "Migration 是一对带名字的升级/回滚语句。Migration.RunAll(db, 列表) 按顺序执行该库尚未应用过的迁移，并记录在 _migrations 表中——再次运行什么都不做，因此可以放在每次启动时执行。",
            "using System.Data.Orm;\n\nList<Migration> ms = new List<Migration> {\n    Migration.Create(\"001_create_posts\",\n        \"CREATE TABLE posts (id INTEGER PRIMARY KEY AUTOINCREMENT, \"\n            + \"user_id INTEGER, title TEXT)\",\n        \"DROP TABLE posts\"),\n    Migration.Create(\"002_add_posts_body\",\n        \"ALTER TABLE posts ADD COLUMN body TEXT\",\n        \"ALTER TABLE posts DROP COLUMN body\")\n};\n\nMigration.RunAll(db, ms);   // idempotent: safe to call on every start");
        DocsData.Doc(d, "Database", "数据库",
            "Database First",
            "从已有表反向生成模型",
            "Model.FromTable(db, table) reads an existing table's schema back into a Model, so an existing database needs no hand-written definition. ToDefineCode() prints the equivalent Model.Define(...) source to paste into your project.",
            "Model.FromTable(db, 表名) 从已有表反推出 Model，接手现成数据库时无需手写定义。ToDefineCode() 输出等价的 Model.Define(...) 源码，可直接粘贴进项目。",
            "using System;\nusing System.Data.Orm;\n\nModel posts = Model.FromTable(db, \"posts\");\nConsole.WriteLine(\"columns: \" + Convert.ToString(posts.ColumnCount())\n    + \" pk=\" + posts.GetPrimaryKey());\nConsole.WriteLine(posts.ToDefineCode());");
        DocsData.Doc(d, "Database", "数据库",
            "Redis Cache",
            "Redis 缓存",
            "RedisClient speaks RESP in pure Zan and is asynchronous: ConnectAsync, then SetAsync / GetAsync / DelAsync / ExistsAsync / IncrAsync / ExpireAsync. CommandAsync sends any other command (hashes, lists, ...) and returns a RedisReply. The classic cache-aside pattern is read cache, miss, load, write back with an expiry.",
            "RedisClient 用纯 Zan 实现 RESP 协议且全异步：ConnectAsync 之后使用 SetAsync / GetAsync / DelAsync / ExistsAsync / IncrAsync / ExpireAsync。CommandAsync 可发送任意其它命令（哈希、列表等），返回 RedisReply。经典的 cache-aside：先查缓存，未命中回源，再回填并设置过期时间。",
            "using System;\nusing System.Data.Redis;\n\nstatic async string UserName(RedisClient r, int id) {\n    string key = \"user:\" + Convert.ToString(id) + \":name\";\n    string cached = await r.GetAsync(key);\n    if (cached != null) { return cached; }\n\n    string fresh = LoadFromDb(id);          // cache miss: go to the database\n    bool ok = await r.SetAsync(key, fresh);\n    int e = await r.ExpireAsync(key, 60);   // expire in 60s\n    return fresh;\n}\n\nstatic async int Run() {\n    RedisClient r = await RedisClient.ConnectAsync(\"127.0.0.1\", 6379);\n    Console.WriteLine(await UserName(r, 42));\n    return 0;\n}");
        DocsData.Doc(d, "Database", "数据库",
            "ZanDb Documents",
            "ZanDb 文档数据库",
            "ZanDb is a built-in single-file document store (WAL crash safety, LRU page cache, no dependency): documents are JsonValue trees, so nested objects and arrays need no schema. A Collection offers Insert / InsertBulk / FindById / Update / Upsert / DeleteById / Count / Exists, EnsureIndex adds a secondary index, and Query() is a lazy LINQ-style chain (WhereEq, Where(lambda), OrderByInt(Desc), Skip, Take, ToList, First, Count).",
            "ZanDb 是内置的单文件文档数据库（WAL 崩溃安全、LRU 页缓存、零依赖）：文档就是 JsonValue 树，嵌套对象与数组无需事先定义结构。Collection 提供 Insert / InsertBulk / FindById / Update / Upsert / DeleteById / Count / Exists；EnsureIndex 建二级索引；Query() 是延迟求值的 LINQ 风格链（WhereEq、Where(lambda)、OrderByInt(Desc)、Skip、Take、ToList、First、Count）。",
            "using System;\nusing System.Json;\nusing System.Data.ZanDb;\n\nZanDatabase db = ZanDatabase.Open(\"app.zdb\");\nCollection users = db.GetCollection(\"users\");\n\nJsonValue u = JsonValue.NewObject();\nu.Put(\"name\", JsonValue.NewStr(\"Alice\"));\nu.Put(\"city\", JsonValue.NewStr(\"Beijing\"));\nu.Put(\"age\", JsonValue.NewNum(\"30\"));\nint id = users.Insert(u);\n\nusers.EnsureIndex(\"city\");                 // WhereEq(\"city\", ...) hits the index\nList<JsonValue> adults = users.Query()\n    .WhereEq(\"city\", \"Beijing\")\n    .Where((JsonValue x) => x.Int(\"age\", 0) >= 18)\n    .OrderByIntDesc((JsonValue x) => x.Int(\"age\", 0))\n    .Take(10)\n    .ToList();\nConsole.WriteLine(\"found: \" + Convert.ToString(adults.Count));");
    }

    /// Appends one entry; the four texts come in English/Chinese pairs.
    /// Sections are the top level of the Help menu; an entry belongs to the
    /// section that claims its category, and the order of the entry list is
    /// the order of the menu. Adding a category means naming it here once.
    static int SectionOf(string catEn) {
        if (catEn == "Language" || catEn == "Type System") { return 1; }
        if (catEn == "Collections & Strings" || catEn == "Files & IO"
            || catEn == "Text & Regex" || catEn == "JSON" || catEn == "LINQ"
            || catEn == "Async & Threads" || catEn == "Cryptography"
            || catEn == "Diagnostics" || catEn == "Standard Library") {
            return 2;
        }
        if (catEn == "HTTP Client" || catEn == "HTTP Server"
            || catEn == "WebSocket" || catEn == "Sockets"
            || catEn == "Messaging" || catEn == "Remote Calls"
            || catEn == "Web Framework" || catEn == "Networking") {
            return 3;
        }
        if (catEn == "Database" || catEn == "SQL Basics" || catEn == "ORM"
            || catEn == "Query Builder" || catEn == "Redis"
            || catEn == "ZanDb") {
            return 4;
        }
        if (catEn == "GUI - Basics" || catEn == "GUI - Widgets") { return 5; }
        if (catEn == "Project & Build" || catEn == "Errors") { return 6; }
        return 0;
    }

    static int SectionCount() { return 7; }

    /// Display name of a section, in the UI language.
    static string SectionName(int i) {
        if (i == 1) { return ZanIDE.T("Language", "语言"); }
        if (i == 2) { return ZanIDE.T("Standard Library", "标准库"); }
        if (i == 3) { return ZanIDE.T("Networking", "网络"); }
        if (i == 4) { return ZanIDE.T("Database", "数据库"); }
        if (i == 5) { return ZanIDE.T("GUI", "界面"); }
        if (i == 6) { return ZanIDE.T("Project & Build", "项目与构建"); }
        return ZanIDE.T("Getting Started", "入门");
    }

    static void Doc(List<DocEntry> d, string catEn, string catZh,
                    string titleEn, string titleZh,
                    string bodyEn, string bodyZh, string code) {
        d.Add(DocEntry.Of(catEn, catZh, titleEn, titleZh, bodyEn, bodyZh, code));
    }
}
