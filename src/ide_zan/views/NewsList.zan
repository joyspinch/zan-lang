using System;
using Gui;
using Gui.Widget;

/// One start-page article: its title, the chip label and the chip's *meaning*
/// ("info", "success", "warning", "error", "primary", or "" for neutral), plus
/// where it leads ("@docs" opens the built-in help tab). Only meaning lives
/// here -- what a chip of a given kind looks like belongs to the stylesheet.
class NewsItem {
    string title;
    string tag;
    string kind;
    string link;

    static NewsItem Create(string title, string tag, string kind, string link) {
        NewsItem it = new NewsItem();
        it.title = title;
        it.tag = tag;
        it.kind = kind;
        it.link = link;
        return it;
    }
}

/// The articles / news list: a list control that takes the model and owns the
/// presentation of an article. Its box comes from the stylesheet (`list.news`).
class NewsList : ListPanel {
    List<NewsItem> items;

    static NewsList Create() {
        NewsList l = new NewsList();
        l.InitControl("list", 5);
        l.Class = "news";
        l.rows = new List<ListRow>();
        l.state = ListState.CreateFlat();
        l.emptyText = "";
        l.items = new List<NewsItem>();
        return l;
    }

    override string Kind() { return "NewsList"; }

    void SetItems(List<NewsItem> src) {
        items = src;
        List<ListRow> built = new List<ListRow>();
        int i = 0;
        while (i < items.Count) {
            built.Add(ListRow.Create(items[i].title).Plain()
                .ChipKind(items[i].tag, items[i].kind));
            i = i + 1;
        }
        rows = built;
    }

    /// Where entry `i` leads ("" when there is no such entry).
    string LinkOf(int i) {
        if (i < 0 || i >= items.Count) { return ""; }
        return items[i].link;
    }

    /// Article the user opened in the last frame (-1 = none).
    int TakeOpened() {
        int i = state.clicked;
        state.clicked = 0 - 1;
        return i;
    }
}
