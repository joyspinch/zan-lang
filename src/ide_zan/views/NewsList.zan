using System;
using Gui;
using Gui.Widget;

/// One start-page article: its title, the chip label and the chip's *meaning*
/// ("info", "success", "warning", "error", "primary", or "" for neutral), plus
/// where it leads ("@docs" opens the built-in help tab). Only meaning lives
/// here -- what a chip of a given kind looks like belongs to the stylesheet.
class NewsItem {
    string title;
    string tag;
    string kind;
    string link;

    static NewsItem Create(string title, string tag, string kind, string link) {
        NewsItem it = new NewsItem();
        it.title = title;
        it.tag = tag;
        it.kind = kind;
        it.link = link;
        return it;
    }
}

/// One article row: the title beside its kind chip, both as children, so the
/// stylesheet owns the row's insets and the chip's look.
class NewsRow : Control {
    NewsItem item;

    /// Row template for `new ListView<NewsItem>(NewsRow.Of)`.
    static Control Of(NewsItem it) { return new NewsRow(it); }

    NewsRow(NewsItem it) {
        this.InitControl("newsRow", 1);
        Class = "news-row";
        item = it;
        Tag chip = new Tag(it.tag);
        chip.Class = it.kind;
        chip.dock = 3;
        this.Add(chip);
        Label title = new Label(it.title);
        title.dock = 5;
        this.Add(title);
    }

    override string Kind() { return "NewsRow"; }

    override string StyleType() { return "listrow"; }

    override void OnMeasure(App app) {
        StyleBox s = this.ResolveStyleAs(app, "listrow", Class, Style.SNormal());
        prefH = s.HeightOr(app.theme.heightLarge);
    }
}
