using System;
using Gui;
using Gui.Widget;

/// One entry of the recent-projects list: where the project is. How it is shown
/// (the initial in the avatar, the path as a sub line, the remove affordance) is
/// the list's business, not the data's.
class RecentItem {
    string path;

    static RecentItem Create(string path) {
        RecentItem it = new RecentItem();
        it.path = path;
        return it;
    }
}

/// The recent-projects list: a list control that takes the model and owns the
/// presentation of an entry. Its box comes from the stylesheet (`list.recent`).
class RecentList : ListPanel {
    List<RecentItem> items;

    static RecentList Create() {
        RecentList l = new RecentList();
        l.InitControl("list", 5);
        l.Class = "recent";
        l.rows = new List<ListRow>();
        l.state = ListState.CreateFlat();
        l.emptyText = ZanIDE.T("(no recent projects yet)", "（还没有最近打开的项目）");
        l.items = new List<RecentItem>();
        return l;
    }

    override string Kind() { return "RecentList"; }

    void SetItems(List<RecentItem> src) {
        items = src;
        List<ListRow> built = new List<ListRow>();
        int i = 0;
        while (i < items.Count) {
            string path = items[i].path;
            string label = Path.GetFileName(path);
            if (label == "") { label = path; }
            string initial = "";
            if (label.Length > 0) { initial = label.Substring(0, 1); }
            built.Add(ListRow.Create(label).WithAvatar(initial).Sub(path)
                .Action("close").Plain());
            i = i + 1;
        }
        rows = built;
    }

    /// Path of entry `i` ("" when there is no such entry).
    string PathOf(int i) {
        if (i < 0 || i >= items.Count) { return ""; }
        return items[i].path;
    }

    /// Entry the user asked to open in the last frame (-1 = none).
    int TakeOpened() {
        int i = state.clicked;
        state.clicked = 0 - 1;
        return i;
    }

    /// Entry the user asked to drop from the list (-1 = none).
    int TakeRemoved() {
        int i = state.actioned;
        state.actioned = 0 - 1;
        return i;
    }
}
