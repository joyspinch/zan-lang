using System;
using Gui;
using Gui.Widget;

/// One entry of the recent-projects list: where the project is. How it is shown
/// (the initial in the avatar, the path as a sub line, the remove affordance) is
/// the row's business, not the data's.
class RecentItem {
    string path;

    static RecentItem Create(string path) {
        RecentItem it = new RecentItem();
        it.path = path;
        return it;
    }
}

/// One row of the recent-projects list, as a control of its own: the avatar and
/// the two lines are children (so the stylesheet lays them out), and the row
/// owns its entity, which is what lets it report the remove request without an
/// index or a row model travelling through the list.
class RecentRow : Control {
    RecentItem item;
    /// Path the user asked to drop, read once by the page ("" = nothing).
    static string removed;

    /// Row template for `new ListView<RecentItem>(RecentRow.Of)`.
    static Control Of(RecentItem it) { return new RecentRow(it); }

    static string TakeRemoved() {
        string p = removed;
        removed = "";
        if (p == null) { return ""; }
        return p;
    }

    RecentRow(RecentItem it) {
        this.InitControl("recentRow", 1);
        Class = "recent-row";
        wiresOwnEvents = true;
        item = it;
        string label = Path.GetFileName(it.path);
        if (label == "") { label = it.path; }
        string initial = "";
        if (label.Length > 0) { initial = label.Substring(0, 1); }
        Avatar av = new Avatar(initial);
        av.dock = 3;
        this.Add(av);
        Panel text = Panel.Column();
        text.dock = 5;
        Label name = new Label(label);
        text.With(name);
        Label sub = new Label(it.path);
        sub.Class = "secondary small";
        text.With(sub);
        this.Add(text);
    }

    override string Kind() { return "RecentRow"; }

    override string StyleType() { return "listrow"; }

    override void OnMeasure(App app) {
        StyleBox s = this.ResolveStyleAs(app, "listrow", Class, Style.SNormal());
        prefH = s.HeightOr(app.theme.heightLarge
                           + Canvas.FontHeight(app.theme.fontSizeSmall));
    }

    /// The remove affordance: revealed on hover at the trailing edge, so the
    /// row stays quiet until the pointer is on it.
    override void OnPaint(App app) {
        Theme t = app.theme;
        int size = app.Scale(20);
        int ax = bx + bw - t.paddingMedium - size;
        int ay = by + (bh - size) / 2;
        if (app.mouseX < bx || app.mouseX >= bx + bw
            || app.mouseY < by || app.mouseY >= by + bh) {
            return;
        }
        int id = app.focus.AllocId();
        app.hitTester.Register(HitRegion.Create(id, ax, ay, size, size, 0));
        int glyph = t.textSecondary;
        if (app.focus.IsHovered(id)) {
            // The hover surface comes from the `button.ghost` style (the skin's
            // own hover fill/border), so the affordance matches every control.
            StyleBox bs = Style.Of(app, "button", "ghost", Style.SHover());
            bs.Paint(app, ax, ay, size, size);
            glyph = t.textPrimary;
        }
        app.canvas.DrawGlyph("close", ax + app.Scale(4), ay + app.Scale(4),
                             size - app.Scale(8), glyph);
        if (app.ClickAvailable()
            && app.hitTester.HitTest(app.mouseX, app.mouseY) == id) {
            removed = item.path;
            app.RequestRedraw();
        }
    }
}
