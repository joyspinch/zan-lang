using System;
using Gui;
using Gui.Widget;

/// The asset manager's chrome as a retained widget tree: breadcrumb, the two
/// toolbar rows, the listing, the detail column and the footer. Nothing here
/// is drawn by hand — every label, input and button is a control, and the
/// manager only says *what* to show (`ShowEmpty` / `ShowMulti` / `ShowEntry`)
/// and asks afterwards which button was pressed (`Button.WasClicked`).
class AssetPanel : Control {
    Label crumbLbl;
    Button impBtn;
    Button impDirBtn;
    Button lnkBtn;
    Button upBtn;
    Button mkBtn;
    Button pkBtn;
    Button closeBtn;
    Label msgLbl;
    Panel body;
    Panel detail;

    Label multiLbl;
    Label titleLbl;
    Label metaLbl;
    Label pathLbl;
    Label hintLbl;
    Panel renameRow;
    Button renameBtn;
    Panel delRow;
    Button delBtn;

    Panel animBox;
    Label animHead;
    Button loopBtn;
    Button animBtn;

    AssetPanel(Input folderIn, Input renameIn, Input fpdIn, Input dirsIn,
               Input fpsIn, Input startIn, Input frameWIn, Input frameHIn) {
        this.InitControl("assetPanel", 5);
        Class = "assets";

        crumbLbl = new Label("");
        crumbLbl.Class = "medium";
        crumbLbl.dock = 1;
        this.Add(crumbLbl);

        Panel tb1 = Panel.Row();
        tb1.Class = "assets-bar";
        tb1.dock = 1;
        impBtn = AssetPanel.Btn("primary small");
        impDirBtn = AssetPanel.Btn("primary small");
        lnkBtn = AssetPanel.Btn("small");
        upBtn = AssetPanel.Btn("small");
        tb1.With(impBtn).With(impDirBtn).With(lnkBtn).With(upBtn);
        this.Add(tb1);

        Panel tb2 = Panel.Row();
        tb2.Class = "assets-bar";
        tb2.dock = 1;
        folderIn.dock = 3;
        folderIn.Prefer(200, 0);
        mkBtn = AssetPanel.Btn("small");
        pkBtn = AssetPanel.Btn("small");
        tb2.Add(folderIn);
        tb2.With(mkBtn).With(pkBtn);
        this.Add(tb2);

        Panel footer = Panel.Row();
        footer.Class = "assets-footer";
        footer.dock = 2;
        msgLbl = new Label("");
        msgLbl.Class = "secondary small";
        msgLbl.dock = 5;
        closeBtn = AssetPanel.Btn("primary");
        closeBtn.dock = 4;
        footer.Add(msgLbl);
        footer.Add(closeBtn);
        this.Add(footer);

        detail = new Panel("assetDetail");
        detail.Class = "assets-detail";
        detail.layout = 1;
        detail.dock = 4;

        multiLbl = new Label("");
        multiLbl.Class = "medium";
        detail.With(multiLbl);
        titleLbl = new Label("");
        titleLbl.Class = "medium";
        detail.With(titleLbl);
        metaLbl = new Label("");
        metaLbl.Class = "secondary small";
        detail.With(metaLbl);
        pathLbl = new Label("");
        pathLbl.Class = "hint tiny";
        detail.With(pathLbl);
        hintLbl = new Label("");
        hintLbl.Class = "secondary small";
        detail.With(hintLbl);

        renameRow = Panel.Row();
        renameRow.Class = "assets-row";
        renameIn.dock = 5;
        renameBtn = AssetPanel.Btn("small");
        renameBtn.dock = 4;
        renameRow.Add(renameIn);
        renameRow.Add(renameBtn);
        detail.With(renameRow);

        delRow = Panel.Row();
        delRow.Class = "assets-row";
        delBtn = AssetPanel.Btn("small error");
        delRow.With(delBtn);
        detail.With(delRow);

        animBox = Panel.Row();
        animBox.layout = 1;
        animBox.Class = "assets-anim";
        animBox.With(new Divider());
        animHead = new Label("");
        animHead.Class = "secondary small";
        animBox.With(animHead);
        animBox.With(AssetPanel.FieldRow(fpdIn, null, null));
        animBox.With(AssetPanel.FieldRow(dirsIn, null, null));
        animBox.With(AssetPanel.FieldRow(fpsIn, null, null));
        animBox.With(AssetPanel.FieldRow(frameWIn, frameHIn, null));
        loopBtn = AssetPanel.Btn("small");
        animBox.With(AssetPanel.FieldRow(startIn, null, loopBtn));
        animBtn = AssetPanel.Btn("primary small");
        Panel writeRow = Panel.Row();
        writeRow.Class = "assets-row";
        writeRow.With(animBtn);
        animBox.With(writeRow);
        detail.With(animBox);

        body = Panel.Row();
        body.Class = "assets-body";
        body.dock = 5;
        body.Add(detail);
        this.Add(body);
    }

    static Button Btn(string cls) {
        return new Button { Text = "", Class = cls };
    }

    /// One "label + input(s)" line of the anim editor. The leading cell is a
    /// label, or the loop-mode button on the row that carries it; the label
    /// text is filled in by `Localize`.
    static Panel FieldRow(Input a, Input b, Button lead) {
        Panel row = Panel.Row();
        row.Class = "assets-field";
        if (lead != null) {
            lead.dock = 3;
            row.Add(lead);
        } else {
            Label l = new Label("");
            l.Class = "hint tiny field-name";
            l.dock = 3;
            row.Add(l);
        }
        a.dock = 5;
        row.Add(a);
        if (b != null) {
            b.dock = 5;
            row.Add(b);
        }
        return row;
    }

    /// The listing is owned by the manager (it carries the selection), so the
    /// panel takes it as the filling child of the body row.
    void AttachList(Control list) {
        list.dock = 5;
        body.Add(list);
    }

    override string Kind() { return "AssetPanel"; }

    /// The one size the stylesheet cannot express in logical pixels here: the
    /// fixed width of the detail column.
    override void OnMeasure(App app) {
        detail.Prefer(app.Scale(290), 0);
    }

    /// Every fixed caption, re-read each frame so switching the IDE language
    /// takes effect without rebuilding the tree.
    void Localize() {
        impBtn.Text = AssetManager.T("Import file", "导入文件");
        impDirBtn.Text = AssetManager.T("Import folder", "导入文件夹");
        lnkBtn.Text = AssetManager.T("Link file", "链接文件");
        upBtn.Text = AssetManager.T("Up", "上级");
        mkBtn.Text = AssetManager.T("New folder", "新建文件夹");
        closeBtn.Text = AssetManager.T("Close", "关闭");
        renameBtn.Text = AssetManager.T("Rename", "重命名");
        animBtn.Text = AssetManager.T("Write .anim", "写入 .anim");
        animHead.Text = AssetManager.T("Animation clip (.anim)",
            "动画剪辑 (.anim)");
        hintLbl.Text = AssetManager.T("Select an entry on the left.",
            "在左侧选择一个条目。");
        this.FieldName(0, AssetManager.T("frames/dir", "每方向帧数"));
        this.FieldName(1, AssetManager.T("directions", "方向数"));
        this.FieldName(2, "fps");
        this.FieldName(3, AssetManager.T("frame WxH", "帧宽x高"));
    }

    /// Text of the leading label of anim editor row `i` (rows start after the
    /// divider and the section heading).
    void FieldName(int i, string text) {
        Control row = animBox.children[i + 2];
        Label l = (Label)row.children[0];
        l.Text = text;
    }

    void SetCrumb(string s) { crumbLbl.Text = s; }
    void SetMessage(string s) { msgLbl.Text = s; }

    void SetPackLabel(bool on) {
        if (on) {
            pkBtn.Text = AssetManager.T("Publish: embed (encrypted)",
                "发布：嵌入(加密)");
            pkBtn.Class = "primary small";
        } else {
            pkBtn.Text = AssetManager.T("Publish: copy files", "发布：复制文件");
            pkBtn.Class = "small";
        }
    }

    void hideAll() {
        multiLbl.visible = false;
        titleLbl.visible = false;
        metaLbl.visible = false;
        pathLbl.visible = false;
        hintLbl.visible = false;
        renameRow.visible = false;
        delRow.visible = false;
        animBox.visible = false;
    }

    /// Nothing selected: only the hint.
    void ShowEmpty() {
        this.hideAll();
        hintLbl.visible = true;
    }

    /// Several rows selected: only a batch delete applies.
    void ShowMulti(int count, bool confirm) {
        this.hideAll();
        multiLbl.visible = true;
        multiLbl.Text = Convert.ToString(count)
            + AssetManager.T(" items selected", " 项已选");
        delRow.visible = true;
        delBtn.Text = AssetManager.T("Delete selected", "删除所选");
        if (confirm) {
            delBtn.Text = AssetManager.T("Confirm delete", "确认删除");
        }
    }

    /// One entry: name, what it is, rename (files/folders), delete, and the
    /// anim editor for images.
    void ShowEntry(AssetEntry e, string meta, bool confirm, bool anim,
                   int loopMode) {
        this.hideAll();
        titleLbl.visible = true;
        titleLbl.Text = e.name;
        metaLbl.visible = true;
        metaLbl.Text = meta;
        pathLbl.visible = e.IsLink();
        pathLbl.Text = e.path;
        renameRow.visible = !e.IsLink();
        delRow.visible = true;
        delBtn.Text = AssetManager.T("Delete", "删除");
        if (e.IsLink()) {
            delBtn.Text = AssetManager.T("Remove link", "移除链接");
        }
        if (confirm) {
            delBtn.Text = AssetManager.T("Confirm delete", "确认删除");
        }
        animBox.visible = anim;
        loopBtn.Text = AssetManager.T("loop: once", "循环: 单次");
        if (loopMode == 1) {
            loopBtn.Text = AssetManager.T("loop: loop", "循环: 循环");
        }
        if (loopMode == 2) {
            loopBtn.Text = AssetManager.T("loop: section", "循环: 区段");
        }
    }
}
