using System;
using Gui;
using Gui.Widget;

/// The Output and Error List panels, extracted from the shell: the panel
/// chrome, the tail-scrolled console renderer and its selection hit-testing
/// helpers. Each is a dock panel of its own; the dock draws the tab strip,
/// these only fill the body it hands over.
class OutputPanel {
    /// Console panel: a toolbar row (substring filter + Clear) over the
    /// tail-scrolled LogView, which owns its scrolling, scrollbar and selection.
    static void RenderConsolePanel(App app, Canvas c, Theme t, Rect orr,
            List<string> log, List<int> colors, LogState st, Input filter,
            Button clearBtn) {
        int barH = t.heightMedium;
        Panel.ChromeSurface(app, orr.x, orr.y, orr.width, barH, 0,
            t.bgSecondary);
        Rect fr = ZanIDE.OutFilterRect(app, orr);
        filter.Render(app, fr.x, fr.y, fr.width, fr.height);
        Rect cbr = ZanIDE.OutClearRect(app, orr);
        clearBtn.SetProp("text", ZanIDE.T("Clear", "清空"));
        clearBtn.Render(app, cbr.x, cbr.y, cbr.width);
        int contentY = orr.y + barH;
        int contentH = orr.height - barH;
        Panel.ChromeSurface(app, orr.x, contentY, orr.width, contentH, 0,
            t.bgPrimary);
        LogView.Render(app, orr.x, contentY, orr.width, contentH, log, colors, st,
            ZanIDE.T("(no console output)", "（暂无控制台输出）"), true);
    }

    /// The colour of each console line: build/debug output is tinted with the
    /// editor palette so it reads apart from plain program output.
    static List<int> ConsoleColors(App app, List<string> lines) {
        EditorPalette pal = EditorPalette.For(app.theme);
        List<int> colors = new List<int>();
        int i = 0;
        while (i < lines.Count) {
            string ln = lines[i];
            int col = 0;
            if (ln.Length > 8 && ln.Substring(0, 2) == "> ") {
                string sub6 = ln.Substring(2, 6);
                if (sub6 == "[Debug") { col = pal.type; }
                else if (sub6 == "--- Li") { col = pal.keyword; }
                else if (sub6 == "  ") { col = pal.str; }
            }
            colors.Add(col);
            i = i + 1;
        }
        return colors;
    }

    /// Error list panel: the parsed compiler diagnostics of the last build.
    static void RenderErrorsPanel(App app, Canvas c, Theme t, Rect er,
            List<string> ePath, List<string> eLine, List<string> eMsg,
            ErrorList errorList) {
        Panel.ChromeSurface(app, er.x, er.y, er.width, er.height, 0,
            t.bgPrimary);
        c.PushClip(er.x, er.y, er.width, er.height);
        errorList.SetErrors(ePath, eLine, eMsg);
        errorList.RenderAt(app, er.x, er.y, er.width, er.height);
        c.PopClip();
    }

    /// Read-only tail of a log (no selection or scrolling), for the small
    /// embedded log strips.
    static void RenderLog(App app, Rect r, List<string> log) {
        LogState st = LogState.Create();
        List<int> colors = new List<int>();
        LogView.Render(app, r.x, r.y, r.width, r.height, log, colors, st, "", false);
    }
}
