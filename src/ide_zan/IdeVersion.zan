using System;

/// The IDE's own build identity. `scripts\build_ide.ps1` regenerates this file
/// from the root VERSION file (plus the build date and commit) before it
/// compiles, so a shipped IDE reports exactly what produced it; the values
/// checked in here are the fallback for a hand-driven compile.
///
/// GENERATED by scripts/build_ide.ps1 - the constants are overwritten there.
class IdeVersion {
    /// Semantic version, e.g. "0.2.0" (root VERSION file).
    static string Number() { return "0.0.0"; }

    /// Build date as YYYY-MM-DD, or "" when unknown.
    static string Date() { return ""; }

    /// Short commit hash of the tree that was built, or "" when unknown.
    static string Commit() { return ""; }

    /// "Zan IDE 0.2.0" -- what the window caption and the log line show.
    static string Product() { return "Zan IDE " + IdeVersion.Number(); }

    /// "0.2.0 (2026-08-03, a1b2c3d)" -- the About/Help detail line.
    static string Full() {
        string s = IdeVersion.Number();
        string detail = IdeVersion.Date();
        if (IdeVersion.Commit() != "") {
            if (detail != "") { detail = detail + ", "; }
            detail = detail + IdeVersion.Commit();
        }
        if (detail != "") { s = s + " (" + detail + ")"; }
        return s;
    }
}
