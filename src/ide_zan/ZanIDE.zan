    /// Form and scene designer state.
    void InitDesignerState() {
        // ---- Designer state ----
        // The single unified designer: .zform tabs host the component-based
        // form designer (stdlib Gui.Designer) with palette, containers,
        // inspector and event bindings. Its design document round-trips
        // through the .zform file.
        designerMode = false;
        formDesigner = new Designer();
        // Design/Code toggle: codeViewForm holds the path of the .zform currently
        // shown as code ("" = design view). The code view reuses a dedicated,
        // in-place editor over the paired code-behind -- it never opens a new tab
        // or creates a file just from switching modes. Only .zform tabs toggle.
        codeViewForm = "";
        formCodeEd = new CodeEditor();
        formCodeLoaded = "";
        // .zscene tabs host the free-canvas game scene designer (stdlib
        // Game.Scene.SceneDesigner): background reference, absolute placement,
        // nine-grid anchors, grid snapping, slot grid groups, z-order. The
        // Design/Code toggle shows the .zscene JSON in place.
        sceneMode = false;
        sceneDesigner = new SceneDesigner();
        assetMgr = AssetManager.Create();
    }

    /// Right side panel (AI / tools / examples / git) and the dockable main
    /// area, seeded from the persisted extents.
    void InitPanelsAndDock(string cfg) {
        treeW = new SignalInt(ZanIDE.CfgClamp(ZanIDE.CfgInt(cfg, "treeW", 240), 120, 900));
        // Seeds for the dock's side extents on a first run (afterwards dock.cfg
        // carries the sizes the user dragged).
        bottomPanelH = new SignalInt(ZanIDE.CfgClamp(ZanIDE.CfgInt(cfg, "bottomH", 190), 70, 2000));

        // ---- Right side panel (AI assistant, tools, examples, git) ----
        rightW = new SignalInt(ZanIDE.CfgClamp(ZanIDE.CfgInt(cfg, "rightW", 600), 120, 1600));

        // ---- Dockable main area ----
        // The shell around the document area is a DockHost: EXPLORER, the
        // structure/components outline, STDLIB, OUTPUT and the assistant column
        // are tab groups the user can drag to another side, tab together,
        // resize and close (right-click a tab strip to bring a closed one
        // back). The editor is the fixed center panel everything docks around.
        // The arrangement is persisted in dock.cfg and restored on launch.
        // Every tool panel closes; the ribbon's Panels section is the switch
        // that brings it back (its icon goes dark while the panel is hidden).
        dock = new DockHost();
        dock.emptyMenuLabel = ZanIDE.T("No closed panels", "没有已关闭的面板");
        dock.Register("explorer", "", DockSide.Left(), true, true);
        dock.Register("structure", "", DockSide.Left(), true, true);
        dock.Register("stdlib", "", DockSide.Left(), true, true);
        // 设计器的组件面板和属性面板是 IDE 自己的 dock 面板，
        // 不再占用设计器画布两侧的位置：设计器里只剩功能区 + 画布。
        dock.Register("toolbox", "", DockSide.Left(), true, false);
        dock.RegisterFixed("editor", "Editor");
        // The assistant column and the bottom band each start as one tab group.
        dock.Register("ai", "", DockSide.Right(), true, true);
        dock.Register("tools", "", DockSide.Right(), true, false);
        dock.Register("examples", "", DockSide.Right(), true, false);
        dock.Register("git", "", DockSide.Right(), true, false);
        dock.Register("props", "", DockSide.Right(), true, false);
        dock.Register("output", "", DockSide.Bottom(), true, true);
        dock.Register("errors", "", DockSide.Bottom(), true, false);
        dock.Register("help", "", DockSide.Bottom(), true, false);
        ZanIDE.ApplyPanelLabels(dock);
        dock.SetWeight("explorer", 40);
        dock.SetWeight("structure", 32);
        dock.SetWeight("stdlib", 28);
        dock.SetSideExtent(DockSide.Left(), treeW.Get());
        dock.SetSideExtent(DockSide.Right(), rightW.Get());
        dock.SetSideExtent(DockSide.Bottom(), bottomPanelH.Get());
        dock.LoadLayout(ZanIDE.ReadDockLayout());
        // The outline panel retitles itself between STRUCTURE and COMPONENTS as
        // the designer opens and closes; this tracks the title in effect.
        dockOutlineTitle = "";
        // The errors panel tab carries the diagnostic count; this tracks it.
        dockErrorsTitle = "";
    }

    /// Git panel state (the right panel's "Git" tab).
    void InitGitPanel() {
        // ---- Git panel state (right panel "Git" tab) ----
        // gitFiles holds `git status --porcelain` lines; gitLoaded gates the
        // first (and refresh-triggered) status scan so git only runs on demand.
        gitFiles = new List<string>();
        gitBranch = "";
        gitLoaded = false;
        // Which detached git job is in flight (0 none, 1 status+branch scan,
        // 2 a command whose output goes to Output); the frame loop polls it so
        // git never blocks drawing.
        gitJob = 0;
        gitSel = new SignalInt(0 - 1);
        gitList = new ListView<string>(GitFileRow.Of);
        gitList.Class = "flat";
        gitList.EmptyText(ZanIDE.T("Working tree clean.", "工作区无变更。"));
        gitList.OnActivate(ZanIDE.GitFileActivated);
        gitScroll = new SignalInt(0);
        gitMsgIn = new Input(
            ZanIDE.T("Commit message...", "提交信息..."));
        // Tools / Examples trees for the right panel tabs.
        rtToolTree = ZanIDE.BuildDirTree(ZanIDE.ToolsDir());
        rtExTree = ZanIDE.BuildExampleTree();
        rtToolSel = new SignalInt(-1);
        rtExSel = new SignalInt(-1);
        rtToolFilter = new Input(ZanIDE.T("Filter...", "筛选..."));
        rtExFilter = new Input(ZanIDE.T("Filter...", "筛选..."));
        rtCtxShow = new List<TreeNode>();
        // Chat transcript: real message entities (role + text + reason) and
        // the task-plan steps (text + done flag).
        aiMsgs = new List<AiChatMsg>();
        aiPlan = new List<AiPlanStep>();
        aiPlanCollapsed = false;
        aiScroll = new SignalInt(0);
        aiThinkOpen = new SignalInt(0);
        // 1 while a completion request is in flight (curl runs detached and the
        // event loop polls for its done-marker file, so the UI never blocks).
        aiBusy = new SignalInt(0);
        aiRunModel = "";
        aiRunCtxName = "";
        aiRunCtxCode = "";
        // Action tools start gated: nothing is written, built or run until the
        // user approves it, until they flip Auto-execute on.
        aiPendingCall = "";
        aiAutoExec = false;
        aiBuildForAi = false;
        aiUiPending = false;
        aiUiRunning = false;
        aiUiScript = "";
        aiUiDeadline = 0;
        aiChatFirstResp = 0;
        aiWaitStart = 0;
        aiStreamMsgIdx = 0 - 1;
        aiStreamLen = 0;
        aiApproveBtn = new Button { Text = ZanIDE.T("Approve", "批准"), Class = "primary small" };
        aiRejectBtn = new Button { Text = ZanIDE.T("Reject", "拒绝"), Class = "small" };
        aiAutoBtn = new Button { Text = ZanIDE.T("Auto: off", "自动:关"), Class = "small" };
        // Multi-line: a question is often a paragraph or a pasted error, and
        // files dropped on the chat are appended as a line of their own.
        aiInput = new TextArea(ZanIDE.T(
            "Ask Xiao Zan about your code...  (Enter sends, Shift+Enter new line)",
            "向小赞提问，辅助开发...（Enter 发送，Shift+Enter 换行）"));
        aiSendBtn = new Button { Text = ZanIDE.T("Send", "发送"), Class = "primary small" };
        aiStopBtn = new Button { Text = ZanIDE.T("Stop", "停止"), Class = "error small" };
        // "Insert code" applies the code block of the last AI answer at the
        // editor cursor, making the assistant a real pair-programming tool.
        aiApplyBtn = new Button { Text = ZanIDE.T("Insert code", "插入代码"), Icon = "code", Class = "small" };
        // "Replace file" swaps the whole active file for the last AI code block.
        aiReplaceBtn = new Button { Text = ZanIDE.T("Replace file", "替换整文件"), Class = "small" };
        aiPlanClearBtn = new Button { Text = ZanIDE.T("Clear plan", "清空计划"), Class = "small" };
        aiRunDots = new List<Badge>();
        Panel runDots = Panel.Row();
        runDots.Class = "runstrip-dots";
        for (int ph = 0; ph < AiPhase.Count(); ph = ph + 1) {
            Badge dot = new Badge();
            dot.Class = "dot phase idle";
            aiRunDots.Add(dot);
            runDots.Add(dot);
        }
        aiRunLabel = new Label("");
        aiRunLabel.Class = "small secondary";
        aiRunStrip = Panel.Row();
        aiRunStrip.Class = "runstrip";
        aiRunStrip.Add(runDots);
        aiRunStrip.Add(aiRunLabel);
        aiRunRule = new Divider();
        aiSideRule = new Divider();
        aiSideRule.Class = "vertical";
        aiCueLbl = new Label("");
        aiCueLbl.Class = "hint small";
        aiCueCaret = new Label("▾");
        aiCueCaret.Class = "hint small";
        aiPendLbl = new Label("");
        aiPendLbl.Class = "small";
        gitNoRepoLbl = new Label(ZanIDE.T("Not a git repository.",
            "当前项目不是 git 仓库。"));
        gitNoRepoLbl.Class = "secondary small";
        gitBranchLbl = new Label("");
        gitBranchLbl.Class = "small";
        aiPlanList = new ListView<AiPlanStep>(PlanRow.Of);
        aiPlanList.Class = "plan flat";
        aiPlanBound = null;
        aiPlanTitle = new Label("");
        aiPlanTitle.Class = "small";
        aiPlanRule = new Divider();
        aiCtxRing = new Progress(0, 3).Ring();
        aiCtxRing.Class = "ctxring";
        aiUsageCard = new UsageCard(ZanIDE.T("Context window", "上下文窗口"),
            ZanIDE.T("This session", "本次会话"));
    }

    /// The active session's archive: transcript, plan and -- so a restart lands
    /// back in the same pipeline stage -- the team mode, state and board.
    string AiPackCur() {
        ChatTeamSave sv = ChatTeamSave.Create();
        if (aiTeamMode) { sv.on = 1; }
        sv.st = aiTeamSt;
        sv.tasks = aiTasks;
        return ChatArea.ChatPack(aiMsgs, aiPlan, sv);
    }

    /// Loads a session archive into the live lists, including the team half. A
    /// single-assistant archive restores as team-off, so opening an old chat
    /// never silently switches the panel into team mode.
    void AiRestoreSession(string pack) {
        ChatTeamSave sv = ChatTeamSave.Create();
        ChatArea.ChatUnpack(pack, aiMsgs, aiPlan, sv);
        aiTeamMode = sv.on == 1;
        aiTeamSt = sv.st;
        aiTasks = sv.tasks;
        aiRunAgent = "";
        aiHandoffs = 0;
    }

    /// Ends the member's turn. Outside team mode this is just "go idle".
    ///
    /// In team mode the reply's protocol beat decides what happens next: a
    /// [question] parks the pipeline for the user (nobody guesses on the user's
    /// behalf), a [handoff]/[block] wakes the next member with a directive
    /// naming the task, and anything else means the same member still owns the
    /// work. The chain is bounded by MaxHandoffs() so a pair of members cannot
    /// volley a task back and forth forever without the user seeing it.
    void AiTeamTurnEnd(string said) {
        if (!aiTeamMode) { aiBusy.Set(0); return; }
        AiEnvelope env = AiTeam.ParseEnvelope(said);
        string from = aiRunAgent;
        if (from == "") { from = AiTeam.Pm(); }
        aiTeamSt = AiTeam.Advance(aiTeamSt, from, env);
        if (aiTeamSt.awaitingUser) {
            // Waiting on the user is a real stop: the panel shows who asked.
            aiBusy.Set(0);
            return;
        }
        string nxt = aiTeamSt.activeAgent;
        if (nxt == "" || nxt == from) { aiBusy.Set(0); return; }
        if (aiHandoffs >= AiTeam.MaxHandoffs()) {
            aiMsgs.Add(AiChatMsg.Create("error", ZanIDE.T(
                "Handoff limit reached; the team stopped so you can look.",
                "交接次数已达上限，团队已暂停，请你介入查看。")));
            aiBusy.Set(0);
            return;
        }
        aiHandoffs = aiHandoffs + 1;
        aiRunAgent = nxt;
        aiRetry = 0;
        aiAutoCont = 0;
        AiChatMsg hmsg = AiChatMsg.Create("user",
            AiTeam.HandoffPrompt(from, nxt, env));
        hmsg.to = nxt;
        hmsg.kind = AiTeam.KindAssign();
        hmsg.taskId = aiTeamSt.activeTask;
        aiMsgs.Add(hmsg);
        string herr = ZanIDE.AiLaunchAs(aiRunAgent, aiMsgs,
            aiRunCtxName, aiRunCtxCode, root,
            aiProfiles[aiProfActive].baseUrl,
            aiProfiles[aiProfActive].key, aiRunModel);
        if (herr != "") {
            aiMsgs.Add(AiChatMsg.Create("error", herr));
            aiBusy.Set(0);
        } else {
            aiBusy.Set(1);
        }
        aiScroll.Set(0);
        app.RequestRedraw();
    }

    /// Runs one assistant tool call inside the open project and continues the
    /// loop. File tools (`write_file` / `edit_file`, and the read tools) run
    /// here and their result is handed straight back to the model. `build` /
    /// `run` go through the IDE's detached build so the window never freezes;
    /// they leave `aiBusy` at 1 and the build-completion poll feeds the
    /// compiler output back. A launch error stops the loop.
    void AiDispatchTool(string call) {
        string tool = AiAgent.ToolName(call);
        // 工具执行前先推进状态机：读=事实检索，写=实施，build=编译,
        // run/ui_check=运行验证。结果由构建完成的轮询回填。
        this.AiRunTool(tool, call);
        // The whitelist is enforced where the tool actually runs. Asking a
        // member in its prompt not to touch a tool is not a boundary; refusing
        // the call is, and naming the owner turns the refusal into a handoff
        // instead of another blocked attempt.
        if (aiTeamMode && aiRunAgent != ""
            && !AiTeam.AllowsTool(aiRunAgent, tool)) {
            aiMsgs.Add(AiChatMsg.Create("tool",
                AiAgent.Describe(call) + "\n"
                + AiTeam.DenyTool(aiRunAgent, tool)));
            string gerr = ZanIDE.AiLaunchAs(aiRunAgent, aiMsgs,
                aiRunCtxName, aiRunCtxCode, root,
                aiProfiles[aiProfActive].baseUrl,
                aiProfiles[aiProfActive].key, aiRunModel);
            if (gerr != "") {
                aiMsgs.Add(AiChatMsg.Create("error", gerr));
                aiBusy.Set(0);
            }
            return;
        }
        if (tool == "plan") {
            aiPlan = new List<AiPlanStep>();
            int nsteps = AiAgent.ParsePlan(call, aiPlan);
            aiMsgs.Add(AiChatMsg.Create("tool",
                AiAgent.Describe(call) + "\nplan updated: "
                + Convert.ToString(nsteps) + " step(s)."));
            string plerr = ZanIDE.AiLaunchAs(aiRunAgent, aiMsgs, aiRunCtxName,
                aiRunCtxCode, root, aiProfiles[aiProfActive].baseUrl,
                aiProfiles[aiProfActive].key, aiRunModel);
            if (plerr != "") {
                aiMsgs.Add(AiChatMsg.Create("error", plerr));
                aiBusy.Set(0);
            }
            return;
        }
        if (tool == "diff" || tool == "run_errors") {
            string body = "";
            if (tool == "diff") {
                body = ZanIDE.AiDiffResult(root);
            } else {
                body = ZanIDE.AiRunErrorsResult();
            }
            aiMsgs.Add(AiChatMsg.Create("tool",
                AiAgent.Describe(call) + "\n" + body));
            string derr = ZanIDE.AiLaunchAs(aiRunAgent, aiMsgs, aiRunCtxName,
                aiRunCtxCode, root, aiProfiles[aiProfActive].baseUrl,
                aiProfiles[aiProfActive].key, aiRunModel);
            if (derr != "") {
                aiMsgs.Add(AiChatMsg.Create("error", derr));
                aiBusy.Set(0);
            }
            return;
        }
        if (tool == "build" || tool == "run" || tool == "ui_check"
            || tool == "ui_tree") {
            string apB = ZanIDE.PathOf(tabs, activeTab);
            string rpB = ZanIDE.RibbonRunTarget(apB, root);
            if (rpB == "") {
                aiMsgs.Add(AiChatMsg.Create("tool",
                    AiAgent.Describe(call)
                    + "\nerror: no buildable/run target is selected in the IDE;"
                    + " open a program file (with a Main) first."));
                string e2 = ZanIDE.AiLaunchAs(aiRunAgent, aiMsgs, aiRunCtxName,
                    aiRunCtxCode, root, aiProfiles[aiProfActive].baseUrl,
                    aiProfiles[aiProfActive].key, aiRunModel);
                if (e2 != "") {
                    aiMsgs.Add(AiChatMsg.Create("error", e2));
                    aiBusy.Set(0);
                }
                return;
            }
            if (tool == "ui_check" || tool == "ui_tree") {
                // Stage the driver script under _scratch/uidrv, then build; the
                // completion poll launches the target under ZAN_UI_SCRIPT.
                JsonValue uv = JsonValue.ParseLenient(call);
                string script = "";
                if (uv != null) { script = uv.Str("script", ""); }
                aiUiTool = tool;
                aiUiScript = AiAgent.NormalizeUiScript(script,
                    tool == "ui_tree");
                string uid = root + "/_scratch/uidrv";
                Directory.CreateDirectoryRecursive(uid);
                File.WriteAllText(uid + "/ai_script.txt", aiUiScript);
                File.WriteAllText(uid + "/results.log", "");
                if (File.Exists(uid + "/regions.json")) {
                    File.Delete(uid + "/regions.json");
                }
                if (File.Exists(uid + "/theme.json")) {
                    File.Delete(uid + "/theme.json");
                }
                if (File.Exists(uid + "/ai_done.txt")) {
                    File.Delete(uid + "/ai_done.txt");
                }
                aiUiPending = true;
            }
            buildBusy = true;
            buildThenRun = (tool == "run") && !ZanIDE.IsLibraryProject(root);
            buildExe = ZanIDE.RunBuildBegin(root, rpB);
            buildIsGui = ZanIDE.IsWindowedTarget(root, rpB);
            buildTargetPath = apB;
            buildLogLen = 0;
            aiBuildForAi = true;
            dock.Focus("output");
            log.Add(ZanIDE.T("> [AI] Building ", "> [AI] 正在构建 ") + rpB + " ...");
            app.RequestAnimationFrame(80);
            return;
        }
        string result = AiAgent.Run(root, call);
        aiMsgs.Add(AiChatMsg.Create("tool",
            AiAgent.Describe(call) + "\n" + result));
        // A write may touch a file open in a tab; the disk-change poll picks
        // that up and offers a reload, so the editor and disk stay in sync.
        string terr = ZanIDE.AiLaunchAs(aiRunAgent, aiMsgs, aiRunCtxName,
            aiRunCtxCode, root, aiProfiles[aiProfActive].baseUrl,
            aiProfiles[aiProfActive].key, aiRunModel);
        if (terr != "") {
            aiMsgs.Add(AiChatMsg.Create("error", terr));
            aiBusy.Set(0);
        }
    }

    /// Clears everything the assistant carries between turns of ONE chat:
    /// the token counters, the retry / auto-continue budgets and any tool call
    /// parked for approval. Called when the active chat is deleted or replaced
    /// by a new one, so a fresh chat never inherits the old one's context.
    void AiResetContextState() {
        aiTokPrompt = 0;
        aiTokCompletion = 0;
        aiTokTotal = 0;
        aiTokCached = 0;
        aiRetry = 0;
        aiAutoCont = 0;
        aiPendingCall = "";
    }

    /// D: a small ring at the top-right of the AI panel showing how full the
    /// running transcript is against the compaction budget, with a hover
    /// tooltip that breaks down the last reply's token usage.
    void AiRenderContextRing(App app, int cx, int cy, int r) {
        if (r < app.Scale(5)) { return; }
        int used = AiAgent.ContextChars(aiMsgs);
        int budget = AiAgent.MaxContextChars();
        int pct = 0;
        if (budget > 0) { pct = used * 100 / budget; }
        if (pct > 100) { pct = 100; }
        // The arc, the track and the "%" label are the Progress control's own
        // ring; only the number and the severity are decided here.
        int tone = 3;
        if (pct >= 75) { tone = 4; }
        if (pct >= 100) { tone = 5; }
        aiCtxRing.ptype = tone;
        aiCtxRing.SetPercent(pct);
        aiCtxRing.RenderInside(app, new Rect(cx - r, cy - r, r * 2, r * 2));
        // Hover (or click, to pin it) opens the usage card. It is a laid-out
        // card rather than a line of tooltip text, and it is drawn after the
        // rest of the panel so nothing paints over it.
        aiUsageOver = app.mouseX >= cx - r && app.mouseX <= cx + r
            && app.mouseY >= cy - r && app.mouseY <= cy + r;
        aiUsageX = cx;
        aiUsageY = cy + r + app.Scale(6);
        if (aiUsageOver && app.ClickAvailable()) {
            aiUsagePinned = !aiUsagePinned;
            app.RequestRedraw();
        }
    }

    /// The context / usage card: what the running transcript costs against the
    /// compaction budget, and the request and token totals for this IDE
    /// session. Only the numbers are assembled here -- the card lays out its
    /// own rows, wraps its own note and paints its own surface.
    void AiRenderUsageCard(App app) {
        if (!aiUsageOver && !aiUsagePinned) { return; }
        Canvas c = app.canvas;
        int used = AiAgent.ContextChars(aiMsgs);
        int budget = AiAgent.MaxContextChars();
        int pct = 0;
        if (budget > 0) { pct = used * 100 / budget; }
        int comp = AiAgent.Compactions();
        List<UsageStat> ctx = new List<UsageStat>();
        ctx.Add(UsageStat.Of(ZanIDE.T("Used", "已使用"),
            Convert.ToString(used) + " " + ZanIDE.T("chars", "字符")));
        // The budget is measured in CHARACTERS (the transcript is not
        // tokenized locally); the model's configured limit is in tokens, so
        // both are shown with the ~4 chars/token conversion that derives one
        // from the other.
        ctx.Add(UsageStat.Of(ZanIDE.T("Budget", "上限"),
            Convert.ToString(budget) + " " + ZanIDE.T("chars", "字符")
            + " ≈ " + Convert.ToString(budget / 4) + " token"));
        ctx.Add(UsageStat.Of(ZanIDE.T("Filled", "占用"),
            Convert.ToString(pct) + "%"));
        // Compaction is why the window never fills up: past the budget the
        // oldest turns are replaced by a digest before the request is sent,
        // while the transcript on screen keeps every turn.
        ctx.Add(UsageStat.Flag(ZanIDE.T("Compacted", "已压缩"),
            comp == 0
                ? ZanIDE.T("never", "未发生")
                : Convert.ToString(comp) + " "
                    + ZanIDE.T("requests", "次请求"),
            comp > 0));
        string note = "";
        if (comp > 0) {
            note = ZanIDE.T("Older turns are sent as a digest",
                    "较早的对话以摘要形式发送")
                + ZanIDE.T(" (last fold: ", "（上次折叠 ")
                + Convert.ToString(AiAgent.LastDropped())
                + ZanIDE.T(" turns; the chat above keeps them all).",
                    " 条；上方对话仍完整保留）。");
        }
        // Token counts only exist for replies whose provider reported usage;
        // say so rather than showing a zero that looks like a real number.
        string inTok = ZanIDE.T("no data", "无数据");
        string outTok = inTok;
        string cacheTok = inTok;
        string totTok = inTok;
        if (ZanIDE.aiStatUsageReplies > 0) {
            inTok = Convert.ToString(ZanIDE.aiStatPrompt);
            outTok = Convert.ToString(ZanIDE.aiStatCompletion);
            totTok = Convert.ToString(ZanIDE.aiStatTotal);
            cacheTok = Convert.ToString(ZanIDE.aiStatCached);
            if (ZanIDE.aiStatPrompt > 0) {
                cacheTok = cacheTok + " ("
                    + Convert.ToString(ZanIDE.aiStatCached * 100
                        / ZanIDE.aiStatPrompt) + "%)";
            }
        }
        List<UsageStat> ses = new List<UsageStat>();
        ses.Add(UsageStat.Of(ZanIDE.T("Requests", "请求次数"),
            Convert.ToString(ZanIDE.aiStatReqs)));
        ses.Add(UsageStat.Flag(ZanIDE.T("Failed", "失败次数"),
            Convert.ToString(ZanIDE.aiStatFails), ZanIDE.aiStatFails > 0));
        ses.Add(UsageStat.Of(ZanIDE.T("Input tokens", "输入 token"), inTok));
        ses.Add(UsageStat.Of(ZanIDE.T("Output tokens", "输出 token"), outTok));
        ses.Add(UsageStat.Of(ZanIDE.T("Cached input", "缓存命中"), cacheTok));
        ses.Add(UsageStat.Of(ZanIDE.T("Total tokens", "合计 token"), totTok));
        if (aiTokTotal > 0 || aiTokPrompt > 0) {
            ses.Add(UsageStat.Of(ZanIDE.T("Last reply", "上次回复"),
                Convert.ToString(aiTokPrompt) + " + "
                + Convert.ToString(aiTokCompletion) + " = "
                + Convert.ToString(aiTokTotal)));
        }
        aiUsageCard.Update(ctx, ses, note);
        int w = app.Scale(330);
        int h = aiUsageCard.Height(app);
        int x = aiUsageX - w / 2;
        int y = aiUsageY;
        int margin = app.Scale(4);
        if (x + w > c.Width() - margin) { x = c.Width() - margin - w; }
        if (x < margin) { x = margin; }
        if (y + h > c.Height() - margin) { y = c.Height() - margin - h; }
        aiUsageCard.RenderAt(app, x, y, w);
    }

    /// How a dropped file is written into the prompt: project-relative when it
    /// lives under the open project (what the assistant's file tools accept),
    /// otherwise the absolute path marked as outside the project so the reply
    /// says so instead of the tool failing with a confusing path error.
    static string AiDropRef(string path, string root) {
        string p = path.Replace("\\", "/");
        string r = root.Replace("\\", "/");
        while (r != "" && r.Substring(r.Length - 1, 1) == "/") {
            r = r.Substring(0, r.Length - 1);
        }
        if (r != "" && p.Length > r.Length + 1
            && p.Substring(0, r.Length + 1) == r + "/") {
            return p.Substring(r.Length + 1, p.Length - r.Length - 1);
        }
        return p + " (outside the project)";
    }

    /// True while the session's plan still has an unchecked step -- the signal
    /// the poll uses to push the assistant on by itself instead of ending the
    /// turn halfway down the checklist.
    bool AiPlanUnfinished() {
        for (int i = 0; i < aiPlan.Count; i = i + 1) {
            if (aiPlan[i].done == 0) { return true; }
        }
        return false;
    }

    /// Height of the task-plan strip drawn above the chat, or 0 when the
    /// current session has no plan. G: a per-session checklist that survives
    /// session switching and context compaction (it lives in the session
    /// record, not the transcript).
    int AiPlanHeight(App app) {
        int runH = this.AiRunStripH(app);
        if (aiPlan.Count == 0) { return runH; }
        int hdr = app.Scale(24);
        if (aiPlanCollapsed) { return runH + hdr; }
        int rows = aiPlan.Count;
        if (rows > 8) { rows = 8; }
        return runH + hdr + rows * app.Scale(20) + app.Scale(6);
    }

    /// Draws the task-plan checklist into `area`: a header (progress count +
    /// collapse + Clear) and the steps as a bound list. Each row is a real
    /// Checkbox that toggles its own step, so no row rectangles, checkbox
    /// drawing or click routing live here.
    void AiRenderPlan(App app, Rect area) {
        int runH = this.AiRenderRunStrip(app, area);
        if (runH > 0) {
            area = new Rect(area.x, area.y + runH, area.width,
                area.height - runH);
        }
        if (aiPlan.Count == 0) { return; }
        int pad = app.Scale(6);
        int hdr = app.Scale(24);
        // No surface fill: the panel (dock) behind already painted it, and this
        // header sits on the same surface as the checklist rows.
        int done = 0;
        for (int di = 0; di < aiPlan.Count; di = di + 1) {
            if (aiPlan[di].done != 0) { done = done + 1; }
        }
        string caret = "v ";
        if (aiPlanCollapsed) { caret = "> "; }
        int btnW = app.Scale(72);
        aiPlanTitle.Text = caret + ZanIDE.T("Plan", "任务计划") + " "
            + Convert.ToString(done) + "/" + Convert.ToString(aiPlan.Count);
        aiPlanTitle.RenderAt(app, area.x + pad, area.y + app.Scale(4),
            area.width - btnW - pad * 3);
        int clrId = aiPlanClearBtn.Render(app,
            area.x + area.width - btnW - pad, area.y + app.Scale(2), btnW);
        bool clrClicked = Ui.Clicked(app, clrId);
        Rect hdrHit = new Rect(area.x, area.y,
            area.width - btnW - pad * 2, hdr);
        if (app.ClickAvailable() && hdrHit.Contains(app.mouseX, app.mouseY)) {
            aiPlanCollapsed = !aiPlanCollapsed;
            app.ClaimClick();
            app.RequestRedraw();
        }
        if (clrClicked) {
            aiPlan = new List<AiPlanStep>();
            app.RequestRedraw();
            return;
        }
        aiPlanRule.RenderAt(app, area.x, area.y + area.height - app.Scale(4),
            area.width);
        if (aiPlanCollapsed) { return; }
        if (aiPlanBound != aiPlan) {
            aiPlanList.Bind(aiPlan);
            aiPlanBound = aiPlan;
        }
        aiPlanList.RenderInside(app, new Rect(area.x + pad, area.y + hdr,
            area.width - pad * 2, area.height - hdr - app.Scale(4)));
    }

    /// AI assistant: provider profiles, chat sessions, transcript cache and the
    /// in-flight request flags.
    void InitAiState() {
        // ---- AI provider profiles (ai_profiles.json) ----
        aiProfiles = new List<AiProfile>();
        aiProfActive = ZanIDE.AiProfilesLoad(aiProfiles);
        aiProfHold = ZanIDE.AiProfilesHold(aiProfiles);
        // The unified AI configuration lives in its own child window
        // (AiSettingsWindow, UiDoc-based like the editor settings).
        aiWindow = null;
        // Chat model switcher: the dropdown lists the active profile's models
        // (default model first); no selection = the profile's default model.
        aiModelSel = new Dropdown<ModelOption>(o => o.label);
        aiModelSel.Hint(ZanIDE.T("Provider / model", "服务商 / 模型"));
        aiModelOptions = new List<ModelOption>();
        aiModelSelSig = "";
        aiCfgBtn = new Button { Text = ZanIDE.T("Config", "配置"), Class = "small" };
        // Chat sessions: switch / new / clear the transcript context. Inactive
        // sessions are kept serialized in `aiSessions` (ChatPack JSON).
        aiSessions = new List<AiSession>();
        aiSessCur = 0;
        aiSessions.Add(AiSession.Create("", 0));
        // Team runtime. Default off so the panel is the single assistant until
        // the user flips the switch; the state is a live object either way so
        // the pipeline code never has to null-check it.
        aiTeamMode = false;
        aiSendTo = "";
        aiCueOpen = false;
        aiRunAgent = "";
        aiHandoffs = 0;
        aiTeamSt = AiTeamState.Create();
        aiTasks = new List<AiTask>();
        aiTeamOpen = new SignalInt(0);
        // Restore sessions persisted on disk so a restart continues the last
        // conversation instead of starting from an empty chat.
        LoadAiSessions();
        aiLastSave = 0;
        aiSessPrevBtn = new Button { Text = "<", Class = "small" };
        aiSessNextBtn = new Button { Text = ">", Class = "small" };
        aiSessNewBtn = new Button { Text = ZanIDE.T("New chat", "新会话"), Class = "small" };
        aiSessClearBtn = new Button { Text = ZanIDE.T("Clear", "清空"), Class = "small" };
        aiSessNav = new SessionList(
            ZanIDE.T("Search chats...", "搜索会话..."),
            ZanIDE.T("New chat", "新会话"))
            .EmptyText(ZanIDE.T("No chats", "暂无会话"))
            .Labels(
                ZanIDE.T("Archive / restore this chat (kept, just hidden)",
                    "归档 / 恢复此会话（保留内容，仅从列表折叠）"),
                ZanIDE.T("Delete this chat and its whole context",
                    "删除此会话及其全部上下文"),
                ZanIDE.T("Archived", "已归档"))
            .RenameLabel(ZanIDE.T("Rename this chat (Enter keeps, Esc cancels)",
                "重命名此会话（回车保存，Esc 取消）"));
        // Chat transcript wrapped-line cache (rebuilt only when the transcript,
        // width or theme changes — rewrapping every frame is too slow).
        aiCacheLines = new List<TextRun>();
        aiToolOpen = new List<int>();
        aiCacheKey = "";
        aiCacheSig = "";
        aiChatSel = new LogState();
        aiTokPrompt = 0;
        aiTokCompletion = 0;
        aiTokTotal = 0;
        aiTokCached = 0;
        aiRetry = 0;
        aiAutoCont = 0;
        aiUsageOver = false;
        aiUsagePinned = false;
        aiUsageX = 0;
        aiUsageY = 0;
    }

    /// Run/build state: the streaming run shell, the detached build's poll
    /// bookkeeping and hot reload.
    void InitRunState(string cfg) {
        // Run shell: a persistent interactive shell session used to stream a
        // launched program's output into the Output tab without blocking the
        // UI. Its stdin is a pipe (Process.ShellSend) and its stdout/stderr
        // stream to a session log file polled each frame.
        termFp = 0;
        termLogLen = 0;
        // Console-program output mirror: a launched console program prints into
        // its own console window and, teed, into RunLogPath, which is polled
        // into the Output tab so output shows in both places.
        runLogLen = 0;
        runStreaming = false;
        // Detached (non-blocking) build behind the Run/Build ribbon actions:
        // the compile runs in a separate shell so the UI never freezes; the
        // main loop polls a done-marker, then applies diagnostics and launches.
        buildBusy = false;
        buildLogLen = 0;
        buildExe = "";
        buildIsGui = false;
        buildThenRun = false;
        // When the in-flight detached build is a debug (`-g`) build, the poll
        // opens the debugger on success instead of running the program.
        dbgBuildPending = false;
        buildTargetPath = "";
        // Hot reload: when ON, saving rebuilds and restarts the running app.
        autoRun = ZanIDE.CfgInt(cfg, "autoRun", 0) == 1;
        // Set by a save when autoRun is ON; consumed once per loop to kick off a
        // DETACHED rebuild (never a synchronous compile on the UI thread).
        hotReloadReq = false;
        treeSel = new SignalInt(-1);
    }

    /// Sidebar sections: explorer / structure / stdlib trees, their filters and
    /// scroll offsets.
    void InitSidebarState() {
        // Vertical scroll offsets for the sidebar sections, so long lists stay
        // inside their region (EXPLORER in pixels, COMPONENTS/EXAMPLES in rows).

        // Third sidebar section: the standard library as a collapsible tree
        // (browse/open stdlib sources directly, like aardio's 库 pane).
        exTree = ZanIDE.BuildStdlibTree();
        exSel = new SignalInt(-1);

        // Per-section filter boxes: each sidebar tree can be narrowed by a
        // case-insensitive substring; the displayed (possibly filtered) lists
        // are recomputed every frame so click handlers index into them.
        treeFilter = new Input(ZanIDE.T("Filter...", "筛选..."));
        structFilter = new Input(ZanIDE.T("Filter...", "筛选..."));
        exFilter = new Input(ZanIDE.T("Filter...", "筛选..."));
        treeShow = new List<TreeNode>();
        structShow = new List<TreeNode>();
        exShow = new List<TreeNode>();

        // STRUCTURE (code outline): types + their members for the active code
        // file, rebuilt only when the buffer signature changes so navigation
        // stays cheap. Clicking a member jumps the editor to its line.
        structTree = new List<TreeNode>();
        structSel = new SignalInt(-1);
        structSig = "@none";
    }


    /// Spawns a fresh wizard child window (a real draggable top-level window),
    /// resetting the selection and name field, and returns its App.
    static App OpenWizard(App parent, string title, SignalInt sel, Input nameInput, string defName) {
        App w = App.CreateDark(title, 720, 470);
        // Child windows inherit the parent's active skin so the whole app shares
        // one look (the skin picker stays available on the child's title bar).
        w.ApplySkin(parent.ThemeMenuIndex());
        w.Show();
        w.SetWindowOpacity(parent.WindowOpacity());
        w.SetUserWallpaper(parent.UserWallpaperPath(), parent.UserWallpaperOpacity());
        sel.Set(0);
        nameInput.SetText(defName);
        return w;
    }

    /// Reveals a path in the OS file manager: Explorer (Windows), Finder via
    /// `open -R` (macOS), or the containing directory via `xdg-open` (Linux).
    static void RevealInFileManager(string path) {
        #if WINDOWS
        Process.RunDetached("explorer /select,\"" + ZanIDE.ToWinPath(path) + "\"");
        #elif MACOS
        Process.RunDetached("open -R \"" + path + "\"");
        #else
        Process.RunDetached("xdg-open \"" + ZanIDE.DirOf(path) + "\"");
        #endif
    }

    /// Converts forward slashes to Windows backslashes (for explorer.exe).
    static string ToWinPath(string p) {
        string outp = "";
        for (int i = 0; i < p.Length; i = i + 1) {
            string ch = p.Substring(i, 1);
            if (ch == "/") { outp = outp + "\\"; } else { outp = outp + ch; }
        }
        return outp;
    }

    /// Closes the tab at `idx`, falling back to the Start tab if it was the
    /// last one open, and clamping the active index.
    static void CloseTabAt(List<TabRecord> tabs, SignalInt active, int idx) {
        if (idx < 0 || idx >= tabs.Count) { return; }
        tabs.RemoveAt(idx);
        if (tabs.Count == 0) {
            tabs.Add(TabRecord.Create("Start", "", "@start"));
        }
        int a = active.Get();
        if (a > idx) { a = a - 1; }
        if (a >= tabs.Count) { a = tabs.Count - 1; }
        if (a < 0) { a = 0; }
        active.Set(a);
    }

    /// Closes every tab except the one at `idx`, which becomes active.
    static void CloseOtherTabs(List<TabRecord> tabs, SignalInt active, int idx) {
        if (idx < 0 || idx >= tabs.Count) { return; }
        for (int k = tabs.Count - 1; k >= 0; k = k - 1) {
            if (k != idx) {
                tabs.RemoveAt(k);
            }
        }
        active.Set(0);
    }
}
