using System;
using System.IO;
using System.Diagnostics;
using System.Json;
using System.Data;
using System.Data.Sqlite;
using Platform;
using Gui;
using Gui.Widget;
using Gui.Designer;
using Gui.Component;
using Game.Scene;

// ---- AI automation-driver entities ---------------------------------------
// EditorProbeJson publishes a typed editor snapshot; the probe's JSON keys
// (caretLine/caretCol/completionActive/completionSel/completion/text and the
// completion item label/kind) are unchanged so existing ZAN_UI_SCRIPT
// assertions keep matching.

class CompletionItemDoc {
    string label;
    string kind;
}

class EditorProbeDoc {
    int caretLine;
    int caretCol;
    bool completionActive;
    int completionSel;
    List<CompletionItemDoc> completion;
    string text;
}

/// Describes one project template: the category it appears under, its display
/// name / icon / description, the scaffolding "kind" (console / dll-class /
/// gui-empty / webview / server / custom / ...), and, for custom templates, the
/// source directory to copy from.
class Tpl {
    string cat;
    string name;
    string icon;
    string desc;
    string kind;
    string src;
    int order;       // sort key inside the wizard (lower = earlier)
    string ptype;    // zan.proj type for copied templates (console/gui/library)
    string ptarget;  // zan.proj target (exe/dll)
    string pentry;   // zan.proj entry
    // Shape metadata (manifest `sizeable` / `size` / `shape` / `preview` /
    // `sketch`): the wizard shows a device-size row for sizeable templates and
    // draws its right-hand preview from these, so a target size is a parameter
    // of one template instead of a dozen near-identical catalog entries.
    bool sizeable;
    int defW;
    int defH;
    bool round;
    string preview;  // absolute path of a real screenshot, "" when none
    string sketch;   // wireframe tokens, see Wizard.RenderSketch

    static Tpl Make(string cat, string name, string icon, string kind, string desc) {
        Tpl t = new Tpl();
        t.cat = cat;
        t.name = name;
        t.icon = icon;
        t.kind = kind;
        t.desc = desc;
        t.src = "";
        t.order = 1000;
        t.ptype = "console";
        t.ptarget = "exe";
        t.pentry = "src/main.zan";
        t.sizeable = false;
        t.defW = 0;
        t.defH = 0;
        t.round = false;
        t.preview = "";
        t.sketch = "";
        return t;
    }
}

/// A miniature aardio/VS-Code-style IDE built from the enterprise GUI components
/// (Ribbon / TreeView / Tabs / CodeEditor / Panel / Split / Modal / Input /
/// Button) wired to a REAL project on disk and the real Zan toolchain.
///
///   * Project ("New Project"): a modal wizard with categorized templates
///     (Console / GUI App / DLL Library / Executable / Empty), a project name
///     and a location — scaffolds the folder + starter files + zan.proj config.
///   * New ("New File"): a modal wizard with file templates (Program / Class /
///     GUI Window / Interface / Empty).
///   * Explorer tree scanned from disk; click a file to open it in a tab.
///   * Save writes to disk; Build/Run/Publish invoke zanc via Process and
///     stream output to the Output panel. Console/library targets link with
///     zanc's own bundled linker (no external clang/LLVM needed); GUI targets
///     still route through clang to link the native GUI runtime.
partial class ZanIDE {
    #if WINDOWS
    [DllImport("kernel32", EntryPoint = "GetModuleFileNameA")]
    static extern int WinGetModuleFileName(int hModule, string buf, int size);
    #elif MACOS
    // _NSGetExecutablePath(char* buf, uint32_t* bufsize): fills buf with the
    // executable path; bufsize points to a 4-byte little-endian capacity.
    [DllImport("crt", EntryPoint = "_NSGetExecutablePath")]
    static extern int MacGetExecutablePath(string buf, string bufsize);
    #else
    // Linux exposes the running executable via the /proc/self/exe symlink.
    [DllImport("crt", EntryPoint = "readlink")]
    static extern int LinuxReadlink(string path, string buf, int bufsize);
    #endif

    /// Full path of the running IDE executable. Platform-specific: Win32
    /// GetModuleFileNameA, macOS _NSGetExecutablePath, Linux /proc/self/exe.
    /// The path is cut to the length the API reports (macOS reports none, so
    /// its NUL terminator is located instead).
    static string ExePath() {
        byte[] buf = new byte[4096];
        int n = 0;
        #if WINDOWS
        n = WinGetModuleFileName(0, buf, 4096);
        #elif MACOS
        byte[] cap = new byte[4];
        cap[1] = 16;
        MacGetExecutablePath(buf, cap);
        while (n < 4096 && (buf[n] & 255) != 0) { n = n + 1; }
        #else
        n = LinuxReadlink("/proc/self/exe", buf, 4096);
        #endif
        if (n < 0) { n = 0; }
        return buf.ToStr(0, n);
    }

    /// Filters of the Open File dialog: Zan sources plus the scripts a Zan
    /// program embeds (System.Scripting.Lua, Python), which the editor
    /// highlights and completes in their own language.
    static List<FileFilter> OpenFileFilters() {
        List<FileFilter> fs = new List<FileFilter>();
        fs.Add(new FileFilter(ZanIDE.T("Zan source", "Zan 源文件"), ".zan"));
        fs.Add(new FileFilter(ZanIDE.T("Script (Lua / Python)", "脚本 (Lua / Python)"),
                              ".lua;.py;.pyw"));
        fs.Add(new FileFilter(ZanIDE.T("All files", "所有文件"), ""));
        return fs;
    }

    /// Directory that contains the running IDE executable, with no trailing
    /// separator. Used so the toolchain (zanc + its stdlib) is located relative
    /// to the IDE rather than a hard-coded absolute path — makes the IDE portable.
    static string ExeDir() {
        string p = ZanIDE.ExePath();
        int cut = 0 - 1;
        for (int i = 0; i < p.Length; i = i + 1) {
            string ch = p.Substring(i, 1);
            if (ch == "\\" || ch == "/") { cut = i; }
        }
        if (cut < 0) { return "."; }
        return p.Substring(0, cut);
    }

    /// Executable file suffix for produced binaries: ".exe" on Windows, none
    /// on POSIX (where the extension is irrelevant and conventionally absent).
    #if WINDOWS
    static string ExeSuffix() { return ".exe"; }
    #else
    static string ExeSuffix() { return ""; }
    #endif

    /// Basename of the Zan compiler shipped next to the IDE.
    static string ZancName() { return "zanc" + ZanIDE.ExeSuffix(); }

    /// C library getenv, for locating per-user directories (mirrors the
    /// approach in System.IO.Path). Returns null when the variable is unset.
    [DllImport("crt")]
    static extern string getenv(string name);

    /// User home directory (USERPROFILE on Windows, HOME on POSIX).
    static string HomeDir() {
        #if WINDOWS
        string h = getenv("USERPROFILE");
        #else
        string h = getenv("HOME");
        #endif
        if (h == null || h == "") { return "."; }
        return h;
    }

    /// Per-user, writable directory for IDE config + custom templates. Kept out
    /// of the (possibly read-only) install dir so nothing user-owned lives there.
    static string UserConfigDir() {
        #if WINDOWS
        string a = getenv("APPDATA");
        if (a == null || a == "") { a = ZanIDE.HomeDir(); }
        return a + "/ZanIDE";
        #elif MACOS
        return ZanIDE.HomeDir() + "/Library/Application Support/ZanIDE";
        #else
        string x = getenv("XDG_CONFIG_HOME");
        if (x != null && x != "") { return x + "/zan-ide"; }
        return ZanIDE.HomeDir() + "/.config/zan-ide";
        #endif
    }

    /// Volatile, per-run files live here: mirrored program logs, terminal
    /// session transcripts, AI stream/request temp files and the chat-session
    /// database. It sits beside the IDE executable (<exe dir>/cache) so a run
    /// never writes into the system profile and logs stay with the install.
    static string CacheDir() {
        return ZanIDE.ExeDir() + "/cache";
    }

    /// Scratch dir of *this* IDE window. Build, run, git, publish and format
    /// all park their output and their "done" marker in the cache dir, and a
    /// second window opened on another project wrote to the very same files:
    /// each window then showed the other's output and stopped waiting on the
    /// other's marker. Keyed by process id, so every window has its own.
    static string WindowCacheDir() {
        return ZanIDE.CacheDir() + "/w" + Convert.ToString(Runtime.GetProcessId());
    }

    static void EnsureCacheDir() {
        Directory.CreateDirectoryRecursive(ZanIDE.CacheDir());
        Directory.CreateDirectoryRecursive(ZanIDE.WindowCacheDir());
    }

    /// Default parent for user projects. Projects are user-owned and never
    /// created under the install dir; the wizard lets the user pick any path.
    static string ProjectsHome() { return ZanIDE.HomeDir() + "/ZanProjects"; }

    /// File remembering the last project the user opened, so the IDE reopens it
    /// next launch instead of scaffolding a throwaway sample project.
    static string LastProjectPath() { return ZanIDE.UserConfigDir() + "/lastproject.txt"; }

    static string ReadLastProject() {
        string f = ZanIDE.LastProjectPath();
        if (!File.Exists(f)) { return ""; }
        string s = ZanIDE.NormSlashes(File.ReadAllText(f));
        int e = s.Length;
        while (e > 0) {
            string ch = s.Substring(e - 1, 1);
            if (ch == " " || ch == "\t" || ch == "\r" || ch == "\n") { e = e - 1; }
            else { break; }
        }
        return s.Substring(0, e);
    }

    static void WriteLastProject(string root) {
        Directory.CreateDirectoryRecursive(ZanIDE.UserConfigDir());
        File.WriteAllText(ZanIDE.LastProjectPath(), root);
        ZanIDE.AddRecentProject(root);
    }

    // ---- Dock layout (panel arrangement of the main area) ----
    /// Where DockHost.SaveLayout() is persisted, so the panels the user dragged,
    /// resized or closed come back the same way next launch.
    static string DockLayoutPath() { return ZanIDE.UserConfigDir() + "/dock.cfg"; }

    static string ReadDockLayout() {
        string f = ZanIDE.DockLayoutPath();
        if (!File.Exists(f)) { return ""; }
        return ZanIDE.TrimWs(File.ReadAllText(f));
    }

    static void WriteDockLayout(string layout) {
        Directory.CreateDirectoryRecursive(ZanIDE.UserConfigDir());
        File.WriteAllText(ZanIDE.DockLayoutPath(), layout);
    }

    // ---- AI chat sessions (disk persistence) -------------------------------
    /// Where the AI chat session list lives (a SQLite database in the cache
    /// dir), so closing the IDE does not lose the conversation: each row is one
    /// session's ChatPack JSON, plus a meta row holding the active index.
    /// Saved on every session change and (throttled) whenever the transcript
    /// grows.
    ///
    /// It is the chat list of the open project. Chats are project work -- they cite
    /// its files and carry its context -- so each project keeps its own list,
    /// and two IDEs on two projects no longer write over one shared database
    /// (the whole list is rewritten on every save, so the loser lost its chats).
    /// With no project open the list is the install-wide one, which is also
    /// where every pre-project-scoped chat still lives.
    string AiSessionsDbPath() {
        if (!haveProject || root == "") { return ZanIDE.SharedSessionsDbPath(); }
        return ZanIDE.CacheDir() + "/sessions/" + ZanIDE.PathKey(root) + ".db";
    }

    static string SharedSessionsDbPath() {
        return ZanIDE.CacheDir() + "/ai_sessions.db";
    }

    /// A stable, file-name-safe key for a path: its leaf plus a hash of the
    /// whole thing, so two projects with the same folder name stay apart.
    static string PathKey(string path) {
        string leaf = ZanIDE.SanitizeName(Path.GetFileName(path));
        if (leaf == "") { leaf = "project"; }
        long h = 2166136261;
        for (int i = 0; i < path.Length; i = i + 1) {
            int b = path[i];
            // Windows paths differ only in case and separator: fold both so the
            // same project does not get two lists.
            if (b >= 65 && b <= 90) { b = b + 32; }
            if (b == 92) { b = 47; }
            h = (h ^ b) * 16777619;
            h = h & 0xFFFFFFFF;
        }
        return leaf + "_" + Convert.ToString(h);
    }

    /// Writes the transcript back at most once a second (and only when it
    /// actually changed). Called once per frame from the main loop.
    void AutosaveAiSessions() {
        if (aiSessCur < 0 || aiSessCur >= aiSessions.Count) { return; }
        int nowMs = Window.GetTickMs();
        if (nowMs - aiLastSave <= 1000) { return; }
        aiLastSave = nowMs;
        string curPack = AiPackCur();
        if (aiSessions[aiSessCur].pack == curPack) { return; }
        aiSessions[aiSessCur].pack = curPack;
        SaveAiSessions();
    }

    void SaveAiSessions() {
        // Fold the live transcript into the current slot first, so the on-disk
        // copy always matches what the user sees.
        if (aiSessCur >= 0 && aiSessCur < aiSessions.Count) {
            aiSessions[aiSessCur].pack = AiPackCur();
        }
        // Archive flags travel beside the packs (one 0/1 per session) rather
        // than inside them, so an older database still loads.
        string archCsv = "";
        for (int ai = 0; ai < aiSessions.Count; ai = ai + 1) {
            if (ai > 0) { archCsv = archCsv + ","; }
            archCsv = archCsv + Convert.ToString(aiSessions[ai].archived);
        }
        SqliteConnection db = null;
        try {
            ZanIDE.EnsureCacheDir();
            string dbp = this.AiSessionsDbPath();
            Directory.CreateDirectoryRecursive(ZanIDE.DirOf(dbp));
            db = SqliteConnection.Open(dbp);
            if (db == null || !db.IsConnected()) { return; }
            db.Execute("CREATE TABLE IF NOT EXISTS sessions ("
                + "id INTEGER PRIMARY KEY, pack TEXT NOT NULL)");
            db.Execute("CREATE TABLE IF NOT EXISTS meta ("
                + "key TEXT PRIMARY KEY, value TEXT NOT NULL)");
            db.Execute("DELETE FROM sessions");
            for (int i = 0; i < aiSessions.Count; i = i + 1) {
                db.Execute("INSERT INTO sessions (id, pack) VALUES (?, ?)",
                    new DbParams().AddInt(i).Add(aiSessions[i].pack));
            }
            db.Execute("INSERT OR REPLACE INTO meta (key, value) VALUES ('cur', ?)",
                new DbParams().Add(Convert.ToString(aiSessCur)));
            db.Execute("INSERT OR REPLACE INTO meta (key, value) VALUES ('arch', ?)",
                new DbParams().Add(archCsv));
            // Names the user typed travel beside the packs too, so a database
            // written by an older build (no titles row) still loads.
            AiTitlesDoc td = new AiTitlesDoc();
            td.t = new List<string>();
            for (int ti2 = 0; ti2 < aiSessions.Count; ti2 = ti2 + 1) {
                td.t.Add(aiSessions[ti2].title);
            }
            db.Execute("INSERT OR REPLACE INTO meta (key, value) VALUES ('titles', ?)",
                new DbParams().Add(Json.Serialize<AiTitlesDoc>(td)));
        } catch (Exception e) {
            // Never let a storage failure crash the IDE's main loop.
            int skip = 0;
        } finally {
            if (db != null) { db.Close(); }
        }
    }

    /// "0,1,0" -> [0, 1, 0]; anything unparsable yields an empty list.
    static List<int> ParseFlagCsv(string csv) {
        List<int> outp = new List<int>();
        string cur = "";
        for (int i = 0; i <= csv.Length; i = i + 1) {
            string ch = "";
            if (i < csv.Length) { ch = csv.Substring(i, 1); }
            if (ch == "," || i == csv.Length) {
                if (cur != "") {
                    int f = 0;
                    if (ZanIDE.ParseIntSafe(cur) != 0) { f = 1; }
                    outp.Add(f);
                }
                cur = "";
            } else {
                cur = cur + ch;
            }
        }
        return outp;
    }

    void LoadAiSessions() {
        aiSessions.Clear();
        aiSessDbPath = this.AiSessionsDbPath();
        // 同一时机读回这个项目的交付检查点，「继续」才能接上上次那一拍，而不是
        // 从需求理解重来。
        this.AiRunLoad();
        // A project opening for the first time since chats became per-project
        // inherits the install-wide list, then owns its copy: the shared file is
        // renamed so the next project starts clean instead of a second copy.
        if (haveProject && !File.Exists(aiSessDbPath)
            && File.Exists(ZanIDE.SharedSessionsDbPath())) {
            try {
                Directory.CreateDirectoryRecursive(ZanIDE.DirOf(aiSessDbPath));
                File.Copy(ZanIDE.SharedSessionsDbPath(), aiSessDbPath);
                File.Move(ZanIDE.SharedSessionsDbPath(),
                    ZanIDE.CacheDir() + "/ai_sessions.pre-project.db");
            } catch (Exception e) {
                int skip2 = 0;
            }
        }
        // One-time migration from the pre-SQLite JSON file (ai_sessions.json in
        // the config dir) when the cache database does not exist yet.
        string legacy = ZanIDE.UserConfigDir() + "/ai_sessions.json";
        if (!File.Exists(aiSessDbPath) && File.Exists(legacy)) {
            try {
                JsonValue v = JsonValue.ParseLenient(File.ReadAllText(legacy));
                if (v != null) {
                    JsonValue s = v.Get("s");
                    if (s != null && s.IsArray()) {
                        for (int i = 0; i < s.Count(); i = i + 1) {
                            JsonValue it = s.At(i);
                            if (it != null) {
                                aiSessions.Add(AiSession.Create(it.AsString(""), 0));
                            }
                        }
                    }
                    aiSessCur = v.Int("cur", 0);
                    if (aiSessions.Count == 0) {
                        aiSessions.Add(AiSession.Create("", 0)); aiSessCur = 0;
                    }
                    if (aiSessCur < 0 || aiSessCur >= aiSessions.Count) { aiSessCur = 0; }
                    // Persist the migrated data immediately (A35 fixed: calling
                    // the try/catch/finally SaveAiSessions from inside this
                    // try/catch no longer trips the LLVM "Incorrect number of
                    // arguments" IR bug).
                    SaveAiSessions();
                }
            } catch (Exception e) {
                // Corrupt legacy file: fall through to the empty database.
                int skip = 0;
            }
        }
        if (File.Exists(aiSessDbPath)) {
            SqliteConnection db = null;
            try {
                db = SqliteConnection.Open(aiSessDbPath);
                if (db != null && db.IsConnected()) {
                    DbResult rs = db.Query("SELECT id, pack FROM sessions ORDER BY id");
                    for (int r = 0; r < rs.RowCount(); r = r + 1) {
                        aiSessions.Add(AiSession.Create(rs.GetString(r, 1), 0));
                    }
                    string curS = db.ExecuteScalar("SELECT value FROM meta WHERE key = 'cur'");
                    int c = ZanIDE.ParseIntSafe(curS);
                    List<int> arch = ZanIDE.ParseFlagCsv(
                        db.ExecuteScalar("SELECT value FROM meta WHERE key = 'arch'"));
                    if (aiSessions.Count == 0) {
                        aiSessions.Add(AiSession.Create("", 0)); c = 0;
                    }
                    if (c < 0 || c >= aiSessions.Count) { c = 0; }
                    for (int ai = 0; ai < arch.Count && ai < aiSessions.Count; ai = ai + 1) {
                        aiSessions[ai].archived = arch[ai];
                    }
                    string tj = db.ExecuteScalar(
                        "SELECT value FROM meta WHERE key = 'titles'");
                    if (tj != "") {
                        AiTitlesDoc td = Json.Deserialize<AiTitlesDoc>(tj);
                        if (td != null && td.t != null) {
                            for (int tk = 0; tk < td.t.Count
                                && tk < aiSessions.Count; tk = tk + 1) {
                                aiSessions[tk].title = td.t[tk];
                            }
                        }
                    }
                    aiSessCur = c;
                }
            } catch (Exception e) {
                if (aiSessions.Count == 0) {
                    aiSessions.Add(AiSession.Create("", 0)); aiSessCur = 0;
                }
            } finally {
                if (db != null) { db.Close(); }
            }
        } else {
            if (aiSessions.Count == 0) {
                aiSessions.Add(AiSession.Create("", 0)); aiSessCur = 0;
            }
        }
        // Restore the active session's transcript into the live lists.
        aiMsgs = new List<AiChatMsg>();
        aiPlan = new List<AiPlanStep>();
        if (aiSessCur >= 0 && aiSessCur < aiSessions.Count) {
            AiRestoreSession(aiSessions[aiSessCur].pack);
        }
        aiCacheKey = "";
        aiCacheSig = "";
        aiToolOpen = new List<int>();
        if (aiSessNav != null) { aiSessNav.CancelRename(); }
    }

    /// Collects the uses of the symbol under the caret and opens the reference
    /// list on them. The count also goes to the output log, so the answer is
    /// still on record after the list is dismissed.
    void ShowReferences() {
        string word = editor.WordAtCaret();
        if (word.Length == 0) {
            log.Add(ZanIDE.T("> Find All References: no symbol under caret.",
                "> 查找所有引用：光标处没有符号。"));
            return;
        }
        List<SearchHit> found = ZanIDE.CollectReferences(
            lspSess, editor, tabs, activeTab, root);
        log.Add("> " + Convert.ToString(found.Count) + " reference(s) to '"
            + word + "'.");
        if (found.Count == 0) { return; }
        refAnchorLine = editor.CurLine();
        refList.Show(word, found, root);
    }

    /// Opens the reference-list row `idx`, switching to (or opening) its file.
    void GotoReference(int idx) {
        if (idx < 0 || idx >= refList.Count()) { return; }
        this.RememberTabView();
        int hitLine = ZanIDE.GotoSearchHit(refList.Hits(), idx, tabs, activeTab, log);
        if (hitLine >= 0) {
            pendingGotoLine = hitLine;
            pendingGotoCol = 0;
            lastActive = 0 - 1;
        }
    }

    /// What Ctrl+F should prefill the query with: the selection when it is a
    /// single line of text, otherwise the word at the caret, like Visual Studio.
    /// "" leaves whatever the bar already holds.
    string FindSeed() {
        if (editor.HasSelection()) {
            string sel = editor.GetSelectedText();
            if (sel.Length > 0 && sel.IndexOf("\n") < 0) { return sel; }
            return "";
        }
        return editor.WordAtCaret();
    }

    /// Records where the active tab is being read, so a jump that leaves it can
    /// put the caret and the viewport back on return.
    void RememberTabView() {
        int a = activeTab.Get();
        if (a < 0 || a >= tabs.Count) { return; }
        if (ZanIDE.IsFormPath(tabs[a].path) || ZanIDE.IsScenePath(tabs[a].path)) {
            return;
        }
        tabs[a].caretLine = editor.CurLine();
        tabs[a].caretCol = editor.CurCol();
        tabs[a].scrollLine = editor.ScrollLine();
    }

    /// Applies a navigation result: the caret goes onto `word` itself on the
    /// destination line, so the next command (references, rename) asks about
    /// the symbol jumped to rather than about the line's first word.
    void ApplyGotoResult(int line, string word) {
        if (line < 0) { return; }
        pendingGotoLine = line;
        pendingGotoCol = 0;
        int a = activeTab.Get();
        if (a >= 0 && a < tabs.Count) {
            pendingGotoCol = ZanIDE.ColOfWordAt(tabs[a].body, line, word);
        }
        lastActive = 0 - 1;
        app.RequestRedraw();
    }

    /// Moves the chat panel onto the project that just became the open one:
    /// the chats of the one before are written back to their own database
    /// first, so nothing of either project ends up in the other's list.
    void AdoptProjectChats() {
        // Startup opens its project before the chat panel exists; the load that
        // sets the panel up runs later and already knows which project it is.
        if (aiSessions == null) { return; }
        string want = this.AiSessionsDbPath();
        if (want == aiSessDbPath) { return; }
        SaveAiSessions();
        LoadAiSessions();
    }

    // ---- Recently opened projects (start page MRU, newest first) ----
    static string RecentProjectsPath() { return ZanIDE.UserConfigDir() + "/recent_projects.txt"; }

    static string TrimWs(string s) {
        int b = 0;
        int e = s.Length;
        while (b < e) {
            string ch = s.Substring(b, 1);
            if (ch == " " || ch == "\t" || ch == "\r" || ch == "\n") { b = b + 1; }
            else { break; }
        }
        while (e > b) {
            string ch = s.Substring(e - 1, 1);
            if (ch == " " || ch == "\t" || ch == "\r" || ch == "\n") { e = e - 1; }
            else { break; }
        }
        return s.Substring(b, e - b);
    }

    /// The most recently opened project roots (existing dirs only, max 10).
    static List<string> ReadRecentProjects() {
        List<string> outp = new List<string>();
        if (!File.Exists(ZanIDE.RecentProjectsPath())) { return outp; }
        List<string> lines = CodeEditor.SplitLines(File.ReadAllText(ZanIDE.RecentProjectsPath()));
        for (int i = 0; i < lines.Count && outp.Count < 10; i = i + 1) {
            string p = ZanIDE.TrimWs(ZanIDE.NormSlashes(lines[i]));
            bool dup = false;
            for (int j = 0; j < outp.Count; j = j + 1) {
                if (outp[j] == p) { dup = true; }
            }
            if (p != "" && !dup && Directory.Exists(p)) { outp.Add(p); }
        }
        return outp;
    }

    static void AddRecentProject(string root) {
        string p = ZanIDE.TrimWs(ZanIDE.NormSlashes(root));
        if (p == "") { return; }
        List<string> cur = ZanIDE.ReadRecentProjects();
        StringBuilder sb = new StringBuilder();
        sb.Append(p);
        sb.Append("\n");
        int n = 1;
        for (int i = 0; i < cur.Count && n < 10; i = i + 1) {
            if (cur[i] != p) {
                sb.Append(cur[i]);
                sb.Append("\n");
                n = n + 1;
            }
        }
        Directory.CreateDirectoryRecursive(ZanIDE.UserConfigDir());
        File.WriteAllText(ZanIDE.RecentProjectsPath(), sb.ToString());
    }

    /// Drops a single entry from the recent-projects MRU (the start-page × removes
    /// just that record; the project on disk is untouched).
    static void RemoveRecentProject(string root) {
        string p = ZanIDE.TrimWs(ZanIDE.NormSlashes(root));
        if (p == "") { return; }
        List<string> cur = ZanIDE.ReadRecentProjects();
        StringBuilder sb = new StringBuilder();
        for (int i = 0; i < cur.Count; i = i + 1) {
            if (cur[i] != p) {
                sb.Append(cur[i]);
                sb.Append("\n");
            }
        }
        Directory.CreateDirectoryRecursive(ZanIDE.UserConfigDir());
        File.WriteAllText(ZanIDE.RecentProjectsPath(), sb.ToString());
    }

    /// The most-recently-used projects as list models.
    static List<RecentItem> RecentProjectItems() {
        List<RecentItem> items = new List<RecentItem>();
        List<string> paths = ZanIDE.ReadRecentProjects();
        for (int i = 0; i < paths.Count; i = i + 1) {
            items.Add(RecentItem.Create(paths[i]));
        }
        return items;
    }

    /// The start-page articles: docs/news.json in the project (or
    /// start_news.json in the user config dir) when present, else the built-in
    /// entries. An entry carries its title, its chip label, the chip's *kind*
    /// ("info", "success", "warning", "error", "primary" or "" for neutral) and
    /// where it leads ("@docs" opens the built-in help tab) -- meaning only; the
    /// look of a chip belongs to the style layer.
    static List<NewsItem> StartNews(string root) {
        List<NewsItem> items = new List<NewsItem>();
        string p = root + "/docs/news.json";
        if (!File.Exists(p)) { p = ZanIDE.UserConfigDir() + "/start_news.json"; }
        if (File.Exists(p)) {
            JsonValue v = JsonValue.ParseLenient(File.ReadAllText(p));
            if (v != null) {
                JsonValue arr = v.Get("items");
                if (arr != null && arr.IsArray()) {
                    for (int i = 0; i < arr.Count(); i = i + 1) {
                        JsonValue it = arr.At(i);
                        string ti = it.Str("title", "");
                        if (ti != "") {
                            items.Add(NewsItem.Create(ti,
                                it.Str("tag", ZanIDE.T("Info", "资讯")),
                                it.Str("kind", ""), it.Str("url", "@docs")));
                        }
                    }
                }
            }
            if (items.Count > 0) { return items; }
        }
        items.Add(NewsItem.Create(
            ZanIDE.T("Quick start: create a project and run it", "快速入门：新建项目并运行"),
            ZanIDE.T("Must read", "必读"), "error", "@docs"));
        items.Add(NewsItem.Create(
            ZanIDE.T("Zan language syntax overview", "Zan 语法速览"),
            ZanIDE.T("Must read", "必读"), "error", "@docs"));
        items.Add(NewsItem.Create(
            ZanIDE.T("Design game UI with the scene designer (.zscene)", "用场景设计器制作游戏 UI（.zscene）"),
            ZanIDE.T("Tutorial", "教程"), "info", "@docs"));
        items.Add(NewsItem.Create(
            ZanIDE.T("Visual forms with the form designer (.zform)", "窗体设计器与 .zform 可视化开发"),
            ZanIDE.T("Tutorial", "教程"), "info", "@docs"));
        items.Add(NewsItem.Create(
            ZanIDE.T("Xiao Zan (AI assistant): provider profiles and model switching", "小赞（AI 助手）：多配置与模型切换"),
            ZanIDE.T("Tool", "工具"), "success", "@docs"));
        items.Add(NewsItem.Create(
            ZanIDE.T("Debugger: breakpoints, stepping and watches", "调试器：断点、单步与监视"),
            ZanIDE.T("Tool", "工具"), "success", "@docs"));
        items.Add(NewsItem.Create(
            ZanIDE.T("Hot reload: save to rebuild and restart", "热重载：保存即重建重启"),
            ZanIDE.T("Tool", "工具"), "success", "@docs"));
        items.Add(NewsItem.Create(
            ZanIDE.T("Browse the built-in examples (right panel)", "浏览内置示例（右侧“示例”页签）"),
            ZanIDE.T("Sample", "示例"), "primary", "@docs"));
        return items;
    }

