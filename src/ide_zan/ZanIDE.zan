        models.Add("gpt-4o-mini");
        regs.Add("https://platform.openai.com/");
    }

    /// Opens `url` in the system browser (detached).
    static void OpenExternal(string url) {
        #if WINDOWS
        Process.RunDetached("cmd /c start \"\" \"" + url + "\"");
        #else
        Process.RunDetached("xdg-open \"" + url + "\"");
        #endif
    }

    // ---- UI language (one-click EN / 中文) ----
    // 0 = English, 1 = 简体中文. Set once at startup from editor.cfg and updated
    // live from the Settings dialog; read everywhere via T(en, zh).
    static int uiLang;

    /// Picks the string for the current UI language. API names, keywords and
    /// project-file syntax are never translated — only human-facing labels.
    static string T(string en, string zh) {
        if (ZanIDE.uiLang == 1) { return zh; }
        return en;
    }

    static int ReadUiLang() {
        string f = ZanIDE.EditorPrefsPath();
        if (!File.Exists(f)) { return 0; }
        return ZanIDE.CfgInt(File.ReadAllText(f), "lang", 0);
    }

    /// Number of selectable UI languages (see uiLang). The Settings dialog
    /// renders one language segment per index via LangName(i).
    static int LangCount() { return 2; }

    /// Display label for UI language `i` (0 = English, 1 = 简体中文).
    static string LangName(int i) {
        if (i == 1) { return "中文"; }
        return "English";
    }

    /// The ribbon's tab strip, localized to the current UI language.
    static List<string> RibbonTabs() {
        List<string> tabs = new List<string>();
        tabs.Add(ZanIDE.T("Home", "开始"));
        tabs.Add(ZanIDE.T("View", "视图"));
        return tabs;
    }

    static int RibbonViewTab() { return 1; }

    /// Builds the ribbon band of `tab` and records each item's stable action id,
    /// in the same order, into `actions` -- dispatch reads `actions[pos]`, never
    /// the position, so groups can be rearranged and translated freely.
    /// The View tab holds only the dock's Panels section (DockHost.AddSwitchGroup).
    static List<RibbonGroup> BuildRibbonGroups(int tab, List<int> actions) {
        List<RibbonGroup> groups = new List<RibbonGroup>();
        if (tab != 0) { return groups; }

        RibbonGroup file = RibbonGroup.Create(ZanIDE.T("File", "文件"));
        file.Add(RibbonItem.Large("plus", ZanIDE.T("Project", "项目")).SetTip(
            ZanIDE.T("Create a project from a template, or open an existing one.",
                "从模板新建工程，或打开已有工程。")));
        actions.Add(0);
        file.Add(RibbonItem.Small("file", ZanIDE.T("New", "新建")).SetTip(
            ZanIDE.T("Add a new source file to the current project.",
                "在当前工程中新建源文件。")));
        actions.Add(1);
        file.Add(RibbonItem.Small("folder", ZanIDE.T("Open", "打开")).SetTip(
            ZanIDE.T("Open a folder as the workspace.", "打开一个文件夹作为工作区。")));
        actions.Add(2);
        file.Add(RibbonItem.Small("save", ZanIDE.T("Save", "保存")).SetTip(
            ZanIDE.T("Write the active editor back to disk (Ctrl+S).",
                "把当前编辑器的内容写回磁盘（Ctrl+S）。")));
        actions.Add(3);
        groups.Add(file);

        RibbonGroup run = RibbonGroup.Create(ZanIDE.T("Run", "运行"));
        run.Add(RibbonItem.Large("play", ZanIDE.T("Run", "运行")).SetTip(
            ZanIDE.T("Build the project and run it, streaming output to the Output panel.",
                "编译并运行工程，输出实时打到“输出”面板。")));
        actions.Add(4);
        run.Add(RibbonItem.Small("bug", ZanIDE.T("Debug", "调试")).SetTip(
            ZanIDE.T("Run with the debugger attached and stop on breakpoints.",
                "以调试方式运行，在断点处中断。")));
        actions.Add(7);
        run.Add(RibbonItem.Small("upload", ZanIDE.T("Publish", "发布")).SetTip(
            ZanIDE.T("Produce a release build and package it for distribution.",
                "生成发布版本并打包分发。")));
        actions.Add(6);
        run.Add(RibbonItem.Small("refresh", ZanIDE.T("Hot", "热重载")).SetTip(
            ZanIDE.T("Reload the running app with the latest code, keeping its state.",
                "用最新代码热重载正在运行的程序，保留其状态。")));
        actions.Add(11);
        groups.Add(run);

        RibbonGroup design = RibbonGroup.Create(ZanIDE.T("Design", "设计"));
        design.Add(RibbonItem.Large("layout", ZanIDE.T("Design/Code", "设计/代码")).SetTip(
            ZanIDE.T("Switch the active form or scene between the visual designer and its code.",
                "在可视化设计器和代码之间切换当前窗体或场景。")));
        actions.Add(9);
        design.Add(RibbonItem.Small("copy", ZanIDE.T("Template", "模板")).SetTip(
            ZanIDE.T("Insert a ready-made file or UI template into the project.",
                "向工程插入现成的文件或界面模板。")));
        actions.Add(8);
        design.Add(RibbonItem.Small("grid", ZanIDE.T("Config", "配置")).SetTip(
            ZanIDE.T("Edit the project's build and run configuration.",
                "编辑工程的构建与运行配置。")));
        actions.Add(12);
        design.Add(RibbonItem.Small("image", ZanIDE.T("Assets", "素材")).SetTip(
            ZanIDE.T("Browse and import images, fonts and other project assets.",
                "浏览并导入图片、字体等工程素材。")));
        actions.Add(15);
        groups.Add(design);

        RibbonGroup shell = RibbonGroup.Create(ZanIDE.T("Application", "应用"));
        shell.Add(RibbonItem.Large("home", ZanIDE.T("Start", "开始页")).SetTip(
            ZanIDE.T("Back to the start page: recent projects and examples.",
                "回到开始页：最近的工程和示例。")));
        actions.Add(10);
        shell.Add(RibbonItem.Small("settings", ZanIDE.T("Settings", "设置")).SetTip(
            ZanIDE.T("Theme, font, language and editor preferences.",
                "主题、字体、语言和编辑器偏好。")));
        actions.Add(13);
        shell.Add(RibbonItem.Small("info", ZanIDE.T("Help", "帮助")).SetTip(
            ZanIDE.T("Language documentation, shortcuts and version info.",
                "语言文档、快捷键和版本信息。")));
        actions.Add(14);
        groups.Add(shell);
        return groups;
    }

    /// Greys out what the current context can't do: Run/Debug/Publish need
    /// something runnable, Hot/Config/Assets/Template need a project, and the
    /// designer needs a form or scene open.
    static void SyncRibbonEnabled(List<RibbonGroup> groups, List<int> actions,
            bool canRun, bool haveProj, bool designable) {
        int idx = 0;
        int g = 0;
        while (g < groups.Count) {
            int j = 0;
            while (j < groups[g].items.Count) {
                if (idx < actions.Count) {
                    int a = actions[idx];
                    bool on = true;
                    if (a == 4 || a == 6 || a == 7) { on = canRun; }
                    else if (a == 8 || a == 11 || a == 12 || a == 15) { on = haveProj; }
                    else if (a == 9) { on = designable; }
                    groups[g].items[j].SetEnabled(on);
                }
                idx = idx + 1;
                j = j + 1;
            }
            g = g + 1;
        }
    }

