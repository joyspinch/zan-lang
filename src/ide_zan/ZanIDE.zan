    /// The stable action id behind ribbon position `pos` (see BuildRibbonGroups).
    /// Action ids: 0 Project, 1 New, 2 Open, 3 Save, 4 Run, 6 Publish, 7 Debug,
    /// 8 Template, 11 Hot, 12 Project settings (assets included), 13 Settings,
    /// 14 Help. The start page is a tab and the design/code switch is F7, so
    /// neither takes a band slot.
    static int RibbonAction(List<int> actions, int pos) {
        if (pos < 0 || pos >= actions.Count) { return 0 - 1; }
        return actions[pos];
    }

    // ---- editor appearance (font + syntax color themes) ----

    static string EditorPrefsPath() { return ZanIDE.UserConfigDir() + "/editor.cfg"; }

    static int ReadEditorTheme() {
        string f = ZanIDE.EditorPrefsPath();
        if (!File.Exists(f)) { return 0; }
        return ZanIDE.CfgInt(File.ReadAllText(f), "theme", 0);
    }

    static int ReadEditorFont() {
        string f = ZanIDE.EditorPrefsPath();
        if (!File.Exists(f)) { return 0; }
        return ZanIDE.CfgInt(File.ReadAllText(f), "font", 0);
    }

    static void WriteEditorPrefs(int themeIdx, int fontPx) {
        Directory.CreateDirectoryRecursive(ZanIDE.UserConfigDir());
        File.WriteAllText(ZanIDE.EditorPrefsPath(),
            "theme=" + Convert.ToString(themeIdx) + ";font=" + Convert.ToString(fontPx)
            + ";lang=" + Convert.ToString(ZanIDE.uiLang) + ";");
    }

    static int EditorThemeCount() { return 6; }

    static string EditorThemeName(int i) {
        if (i == 1) { return "Monokai"; }
        if (i == 2) { return "Dracula"; }
        if (i == 3) { return "Solarized Dark"; }
        if (i == 4) { return "Night Owl"; }
        if (i == 5) { return "High Contrast"; }
        return "Dark+ (default)";
    }

    /// The effective font size: the explicit override, or the theme default.
    static int EditorFontOr(int fontPx, int defFontPx) {
        if (fontPx > 0) { return fontPx; }
        return defFontPx;
    }

    /// One syntax color of a preset theme. role: 0=keyword 1=type 2=string
    /// 3=comment 4=number 5=default text. The palettes themselves live in
    /// the Gui skin layer (EditorPalette.Preset).
    static int EditorThemeColor(int themeIdx, int role) {
        EditorPalette p = EditorPalette.Preset(themeIdx);
        if (role == 0) { return p.keyword; }
        if (role == 1) { return p.type; }
        if (role == 2) { return p.str; }
        if (role == 3) { return p.comment; }
        if (role == 4) { return p.number; }
        return p.plain;
    }

    /// Machine-readable snapshot of the editor for the AI automation driver:
    /// caret, live completion popup (candidates + selection) and buffer text.
    static string EditorProbeJson(CodeEditor ed) {
        EditorProbeDoc o = new EditorProbeDoc();
        o.caretLine = ed.CurLine();
        o.caretCol = ed.CurCol();
        o.completionActive = ed.CompletionActive();
        o.completionSel = ed.CompletionSel();
        o.completion = new List<CompletionItemDoc>();
        int n = ed.CompletionCount();
        for (int i = 0; i < n; i = i + 1) {
            CompletionItemDoc c = new CompletionItemDoc();
            c.label = ed.CompletionItem(i);
            c.kind = ed.CompletionKind(i);
            o.completion.Add(c);
        }
        o.text = ed.GetText();
        return Json.Serialize<EditorProbeDoc>(o);
    }

    /// Pushes the selected preset's colors and font size into the editor.
    static void ApplyEditorTheme(CodeEditor editor, int themeIdx, int fontPx) {
        editor.ApplyTheme(fontPx,
            ZanIDE.EditorThemeColor(themeIdx, 0), ZanIDE.EditorThemeColor(themeIdx, 1),
            ZanIDE.EditorThemeColor(themeIdx, 2), ZanIDE.EditorThemeColor(themeIdx, 3),
            ZanIDE.EditorThemeColor(themeIdx, 4), ZanIDE.EditorThemeColor(themeIdx, 5));
    }

    // ---- Editor Settings dialog: JSON declarative + two-way binding ----
    // The Settings modal is described as a JSON UiDoc bound to a JsonValue model
    // {themeIdx, font, lang}. Handlers are parameterless Actions resolved by the
    // registry, so button clicks flip these static flags which Run() consumes.
    static bool setDone;
    static bool setResetFont;

    static void OnSettingsDone() { ZanIDE.setDone = true; }
    static void OnSettingsResetFont() { ZanIDE.setResetFont = true; }

    /// Builds the Settings modal as a JSON UiDoc document: a title, the color
    /// theme preview cards (custom ThemeCard component, one per preset, all
    /// two-way bound to model.themeIdx), a font-size slider + live readout, a
    /// segmented language chooser (Segment component bound to model.lang), and
    /// the Default / Done buttons.
    static string SettingsDocJson() {
        UiNode doc = UiNode.Column().Pad(18).Gap(8);
        doc.Child(UiNode.Title(ZanIDE.T("Editor Settings", "编辑器设置"))
            .Dock("top").Height(34));
        doc.Child(UiNode.Label(ZanIDE.T("Color Theme", "配色主题"))
            .Class("secondary small").Dock("top").Height(20));
        for (int i = 0; i < ZanIDE.EditorThemeCount(); i = i + 1) {
            doc.Child(UiNode.Of("Radio").Num("option", i)
                .Str("label", ZanIDE.EditorThemeName(i))
                .Dock("top").Bind("themeIdx"));
        }
        doc.Child(UiNode.Label(ZanIDE.T("Font Size", "字体大小"))
            .Class("secondary small").Dock("top").Height(20));
        UiNode fontRow = UiNode.Row().Dock("top").Height(34).Gap(10);
        fontRow.Child(UiNode.Slider().Min(9).Max(30).Bind("font")
            .Dock("left").Width(300));
        fontRow.Child(UiNode.Of("Label").Dock("left").Width(44)
            .BindProp("font", "text"));
        fontRow.Child(UiNode.Label("px").Dock("left").Width(24));
        fontRow.Child(UiNode.Button(ZanIDE.T("Default", "默认"))
            .OnClick("resetFont").Dock("left").Width(100));
        doc.Child(fontRow);
        doc.Child(UiNode.Label(ZanIDE.T("Language", "界面语言"))
            .Class("secondary small").Dock("top").Height(20));
        UiNode langRow = UiNode.Row().Dock("top").Height(34).Gap(8);
        for (int j = 0; j < ZanIDE.LangCount(); j = j + 1) {
            langRow.Child(UiNode.Of("Segment").Index(j)
                .Str("label", ZanIDE.LangName(j))
                .Dock("left").Width(130).Bind("lang"));
        }
        doc.Child(langRow);
        UiNode btnRow = UiNode.Row().Dock("top").Height(40).Gap(10);
        btnRow.Child(UiNode.Button(ZanIDE.T("Done", "完成"))
            .OnClick("done").Dock("right").Width(120));
        doc.Child(btnRow);
        return doc.ToJson();
    }

    /// Converts Windows backslashes to forward slashes, the IDE-internal path
    /// form (Windows file APIs accept either separator).
    static string NormSlashes(string p) {
        string outp = "";
        for (int i = 0; i < p.Length; i = i + 1) {
            string ch = p.Substring(i, 1);
            if (ch == "\\") { outp = outp + "/"; } else { outp = outp + ch; }
        }
        return outp;
    }

    static string LastPickerPath() { return ZanIDE.UserConfigDir() + "/lastpicker.txt"; }

    static string ReadLastPickerDirectory(string fallback) {
        string dir = "";
        string f = ZanIDE.LastPickerPath();
        if (File.Exists(f)) {
            dir = ZanIDE.NormSlashes(File.ReadAllText(f));
            dir = ZanIDE.TrimTrailSpaces(ZanIDE.TrimLeadSpaces(dir));
        }
        if (Directory.Exists(dir)) { return dir; }
        fallback = ZanIDE.NormSlashes(fallback);
        if (File.Exists(fallback)) { fallback = Path.GetDirectoryName(fallback); }
        if (Directory.Exists(fallback)) { return fallback; }
        return ZanIDE.ProjectsHome();
    }

    static void WriteLastPickerDirectory(string dir) {
        dir = ZanIDE.NormSlashes(dir);
        if (!Directory.Exists(dir)) { return; }
        Directory.CreateDirectoryRecursive(ZanIDE.UserConfigDir());
        File.WriteAllText(ZanIDE.LastPickerPath(), dir);
    }

    /// The IDE's install directory, where the shipped read-only resources
    /// (toolchain\, stdlib\, examples\, templates\, tools\) live. Normally the
    /// exe's own folder; when the exe was started by the self-extract launcher
    /// (which unpacks the real exe + SDL3 to a per-user cache and runs it from
    /// there), the launcher passes its own folder via ZAN_APP_DIR so the
    /// sibling folders still resolve next to the launcher in the install dir.
    static string BaseDir() {
        string d = ZanIDE.getenv("ZAN_APP_DIR");
        if (d != null && d != "" && Directory.Exists(d)) { return d; }
        return ZanIDE.ExeDir();
    }

    /// Shipped (read-only) resource roots, laid out relative to the install dir:
    ///   <BaseDir>/toolchain/zanc[.exe] + linker      <BaseDir>/stdlib
    /// This matches scripts/publish_ide.ps1: the compiler and its linker bundle
    /// live together under <BaseDir>/toolchain, and zanc finds its linker next to
    /// itself in that same folder.
    static string ToolchainDir() { return ZanIDE.BaseDir() + "/toolchain"; }
    /// 已发布的安装目录里 stdlib 就在 exe 旁边；从构建树跑（build\ZanIDE.exe）
    /// 时它在上一层。找不到就退回默认路径，让 zanc 自己报错。
    static string StdlibDir() {
        string a = ZanIDE.BaseDir() + "/stdlib";
        if (Directory.Exists(a)) { return a; }
        string b = ZanIDE.BaseDir() + "/../stdlib";
        if (Directory.Exists(b)) { return b; }
        return a;
    }

    /// The IDE's own stylesheet (page layout): shipped next to the executable,
    /// or read from the source tree when running from a dev build. Empty when
    /// neither is present, which leaves pages on the theme's defaults.
    static string PageCss() {
        string p = ZanIDE.ExeDir() + "/ide.css";
        if (!File.Exists(p)) { p = ZanIDE.BaseDir() + "/ide.css"; }
        if (!File.Exists(p)) { p = ZanIDE.BaseDir() + "/../src/ide_zan/ide.css"; }
        if (!File.Exists(p)) { return ""; }
        return File.ReadAllText(p);
    }

    /// Locates the shipped assets folder (with zan.ico): next to the IDE when
    /// published (<BaseDir>/assets), or one level up in the build tree.
    static string ShippedAssetsDir() {
        string a = ZanIDE.BaseDir() + "/assets";
        if (Directory.Exists(a)) { return a; }
        string b = ZanIDE.BaseDir() + "/../assets";
        if (Directory.Exists(b)) { return b; }
        return "";
    }

    /// The Zan application icon (.ico) copied into new projects by default so a
    /// freshly created project already carries an icon its exe links in.
    /// Returns "" when no shipped icon is found.
    static string ZanIconSource() {
        string ad = ZanIDE.ShippedAssetsDir();
        if (ad != "") {
            string c = ad + "/zan.ico";
            if (File.Exists(c)) { return c; }
        }
        string t = ZanIDE.ToolchainDir() + "/zan.ico";
        if (File.Exists(t)) { return t; }
        return "";
    }

    /// Shipped example programs. Published next to the IDE as <BaseDir>/examples
    /// (scripts/publish_ide.ps1); when running from the build tree it sits one
    /// level up at the repo root. Returns "" when neither exists.
    static string ExamplesDir() {
        string a = ZanIDE.BaseDir() + "/examples";
        if (Directory.Exists(a)) { return a; }
        string b = ZanIDE.BaseDir() + "/../examples";
        if (Directory.Exists(b)) { return b; }
        return "";
    }

    /// Shipped IDE tools. Published next to the IDE as <BaseDir>/tools
    /// (scripts/publish_ide.ps1); when running from the build tree it sits one
    /// level up at the repo root. Returns "" when neither exists.
    static string ToolsDir() {
        string a = ZanIDE.BaseDir() + "/tools";
        if (Directory.Exists(a)) { return a; }
        string b = ZanIDE.BaseDir() + "/../tools";
        if (Directory.Exists(b)) { return b; }
        return "";
    }

    /// Per-project build scratch dir (writable, colocated with the sources),
    /// created on demand so build artifacts never touch the install dir.
    static string EnsureBuildDir(string root) {
        string d = root + "/.build";
        if (!Directory.Exists(d)) { Directory.CreateDirectoryRecursive(d); }
        return d;
    }

    /// Resolve the Zan compiler. It lives together with its linker under
    /// <ExeDir>/toolchain/zanc.exe (see scripts/publish_ide.ps1). Falls back to
    /// the bare name (PATH) -- no hard-coded absolute path.
    static string Zanc() {
        string cand = ZanIDE.ToolchainDir() + "/" + ZanIDE.ZancName();
        if (File.Exists(cand)) { return cand; }
        return ZanIDE.ZancName();
    }

    /// Quoted zanc invocation prefix with an explicit --stdlib-path so stdlib
    /// resolution never depends on relative (../stdlib) lookup or the cwd.
    static string ZancCmd() {
        return "\"" + ZanIDE.Zanc() + "\" --stdlib-path \"" + ZanIDE.StdlibDir() + "\"";
    }

    /// True when the project at `root` targets the GUI runtime (zan.proj
    /// `type = gui`). GUI apps must link the native GUI runtime and use the
    /// borderless-window entry, whereas console apps link with the defaults.
    static bool IsGuiProject(string root) {
        string pj = root + "/zan.proj";
        if (!File.Exists(pj)) { return false; }
        string c = File.ReadAllText(pj);
        return ZanIDE.Has(c, "type = gui") || ZanIDE.Has(c, "type=gui");
    }

    /// Extra clang link arguments for GUI projects: the native GUI runtime
    /// (zan_gui.lib, shipped next to the IDE and under toolchain\), the stdio
    /// shim sprintf resolves against, and the windowed subsystem/entry the GUI
    /// runtime expects. Returns "" for console projects (link with defaults).
    static bool IsGuiTarget(string root, string sourcePath) {
        bool isGui = ZanIDE.IsGuiProject(root);
        if (!isGui && File.Exists(sourcePath)) {
            string source = File.ReadAllText(sourcePath);
            isGui = ZanIDE.Has(source, "using Gui;");
        }
        return isGui;
    }

    /// True when the program opens its own window: a GUI-runtime app, or a game
    /// on SDL3/GameKit. Such a target is linked for the windowed subsystem and
    /// started detached, i.e. without a console attached to it.
    static bool IsWindowedTarget(string root, string sourcePath) {
        if (ZanIDE.IsGuiTarget(root, sourcePath)) { return true; }
        if (File.Exists(sourcePath)) {
            string source = File.ReadAllText(sourcePath);
            if (ZanIDE.Has(source, "using SDL3;")) { return true; }
            if (ZanIDE.Has(source, "using GameKit;")) { return true; }
        }
        return false;
    }

    static string GuiLinkArgs(string root, string sourcePath) {
        bool isGui = ZanIDE.IsGuiTarget(root, sourcePath);
        if (!isGui) { return ""; }
        string args = " -L\"" + ZanIDE.BaseDir() + "\" -L\"" + ZanIDE.ToolchainDir() + "\""
            + " -lzan_gui -llegacy_stdio_definitions"
            + " -Xlinker /SUBSYSTEM:WINDOWS -Xlinker /ENTRY:mainCRTStartup"
            + " -Xlinker /STACK:268435456";
        return args;
    }

    /// Extra link input for programs that use the synchronization runtime
    /// (Thread.Start / AtomicInt / SharedTable / Dispatcher). Those symbols
    /// (zan_thread_start / zan_atomic_int_* / zan_shared_table_* /
    /// zan_dispatch_*) live in the prebuilt zanrt_sync object rather than the
    /// emitted IR, so the IDE's `clang <ir>.ll` step must link it explicitly.
    /// Prefer the MSVC-target object (zanrt_sync_ide.obj) since the IDE links
    /// against clang's default MSVC target; the GNU-target zanrt_sync.obj pulls
    /// in __mingw_* and won't resolve. Returns "" when no object is present so
    /// ordinary programs still link unchanged. The object only references
    /// kernel32 (threads / mutexes / file mappings), so linking it into a
    /// program that doesn't call it is harmless dead code.
    static string RtSyncArg() {
        string cand = ZanIDE.ToolchainDir() + "/zanrt_sync_ide.obj";
        if (File.Exists(cand)) { return " \"" + cand + "\""; }
        cand = ZanIDE.BaseDir() + "/zanrt_sync_ide.obj";
        if (File.Exists(cand)) { return " \"" + cand + "\""; }
        cand = ZanIDE.ToolchainDir() + "/zanrt_sync.obj";
        if (File.Exists(cand)) { return " \"" + cand + "\""; }
        cand = ZanIDE.BaseDir() + "/zanrt_sync.obj";
        if (File.Exists(cand)) { return " \"" + cand + "\""; }
        return "";
    }

    /// Produces `exe` from `inputs` through zanc's OWN bundled linker (the GNU
    /// ld shipped in toolchain\), so Build/Run/Debug/Publish need no external
    /// clang or LLVM on the machine -- the IDE is as self-contained as the CLI
    /// (verified with clang/gcc/ld off PATH). GUI targets add --subsystem
    /// windows; the native GUI runtime is auto-bundled by zanc as the `zan_gui`
    /// stdlib driver (stdlib\Gui\drivers), copied next to the exe. `ll` is
    /// retained for signature stability but no longer used. Mode flags:
    /// `publish` adds --publish (optimize + strip, the Release mode); `debug`
    /// adds -g instead (DWARF + -O0, keeping runtime checks and source-line
    /// crash locations for the Debug publish mode). `debug` wins over
    /// `publish` when both are set.
    static string CompileToExe(string root, string p, string inputs, string ll, string exe, bool publish, bool debug) {
        string pub = "";
        if (debug) { pub = " -g"; }
        else if (publish) { pub = " --publish"; }
        if (ZanIDE.IsLibraryProject(root)) {
            // A library has no subsystem or icon; zanc picks the library
            // format (shared/static) from the -o extension.
            return ZanIDE.ZancCmd() + pub + " " + inputs + " -o \"" + exe + "\"";
        }
        string sub = "";
        if (ZanIDE.IsWindowedTarget(root, p)) { sub = " --subsystem windows"; }
        return ZanIDE.ZancCmd() + pub + " " + inputs + " -o \"" + exe + "\"" + sub
            + ZanIDE.IconArg(root);
    }

    /// Like CompileToExe but cross-compiles for an explicit `--target` (e.g.
    /// win-arm64) through zanc's OWN bundled toolchain, so publishing needs no
    /// external clang/LLVM. Statically links the native driver so the cross
    /// output stays a single self-contained file. `debug` swaps --publish for
    /// -g (Debug publish mode: DWARF + -O0 + runtime checks).
    static string CompileToExeCross(string root, string p, string inputs, string exe, string target, bool debug) {
        string sub = "";
        if (ZanIDE.IsWindowedTarget(root, p)) { sub = " --subsystem windows"; }
        string mode = " --publish";
        if (debug) { mode = " -g"; }
        return ZanIDE.ZancCmd() + mode + " --target " + target
            + " --link-mode static " + inputs + " -o \"" + exe + "\"" + sub
            + ZanIDE.IconArg(root);
    }

    /// Reads a `key = value` field from the project's zan.proj, or "" if absent.
    static string ProjField(string root, string key) {
        string proj = root + "/zan.proj";
        if (!File.Exists(proj)) { return ""; }
        List<string> ls = CodeEditor.SplitLines(File.ReadAllText(proj));
        for (int i = 0; i < ls.Count; i = i + 1) {
            string tr = ZanIDE.TrimLeadSpaces(ls[i]);
            if (tr.Length >= key.Length && tr.Substring(0, key.Length) == key) {
                string rest = ZanIDE.TrimLeadSpaces(tr.Substring(key.Length, tr.Length - key.Length));
                if (rest.Length > 0 && rest.Substring(0, 1) == "=") {
                    string val = ZanIDE.TrimLeadSpaces(rest.Substring(1, rest.Length - 1));
                    int e = val.Length;
                    while (e > 0) {
                        string ch = val.Substring(e - 1, 1);
                        if (ch == " " || ch == "\t" || ch == "\r" || ch == "\n") { e = e - 1; }
                        else { break; }
                    }
                    return val.Substring(0, e);
                }
            }
        }
        return "";
    }

    /// Writes/updates the project icon path (relative to the project root) in
    /// zan.proj, dropping any prior `icon =` line so it stays single-valued.
    static void SetProjectIcon(string root, string rel) {
        string proj = root + "/zan.proj";
        string content = "";
        if (File.Exists(proj)) { content = File.ReadAllText(proj); }
        List<string> ls = CodeEditor.SplitLines(content);
        string outp = "";
        for (int i = 0; i < ls.Count; i = i + 1) {
            string ln = ls[i];
            string tr = ZanIDE.TrimLeadSpaces(ln);
            if (tr.Length >= 4 && tr.Substring(0, 4) == "icon") {
                // drop the previous icon line; the new one is appended below
            } else if (tr.Length > 0) {
                outp = outp + ln + "\n";
            }
        }
        outp = outp + "icon = " + rel + "\n";
        File.WriteAllText(proj, outp);
    }

    /// Writes/updates a `key = value` field in zan.proj (dropping any prior line
    /// for that key so it stays single-valued). Used for project settings edited
    /// through the IDE, e.g. `singleFile`.
    static void SetProjField(string root, string key, string val) {
        string proj = root + "/zan.proj";
        string content = "";
        if (File.Exists(proj)) { content = File.ReadAllText(proj); }
        List<string> ls = CodeEditor.SplitLines(content);
        string outp = "";
        for (int i = 0; i < ls.Count; i = i + 1) {
            string ln = ls[i];
            string tr = ZanIDE.TrimLeadSpaces(ln);
            bool isKey = false;
            if (tr.Length >= key.Length && tr.Substring(0, key.Length) == key) {
                string rest = ZanIDE.TrimLeadSpaces(tr.Substring(key.Length, tr.Length - key.Length));
                if (rest.Length > 0 && rest.Substring(0, 1) == "=") { isKey = true; }
            }
            if (isKey) {
                // drop the previous line; the new one is appended below
            } else if (tr.Length > 0) {
                outp = outp + ln + "\n";
            }
        }
        outp = outp + key + " = " + val + "\n";
        File.WriteAllText(proj, outp);
    }

    /// Project setting: pack a Windows publish into one self-extracting exe
    /// (DLLs bundled inside). Defaults to true (the historical behavior) unless
    /// zan.proj explicitly sets `singleFile = false`.
    static bool ProjSingleFile(string root) {
        return ZanIDE.ProjField(root, "singleFile") != "false";
    }

    /// Project setting: publish in Debug mode (zanc -g -- DWARF + -O0, runtime
    /// checks kept, crash logs resolve to .zan:line) instead of the default
    /// Release mode (--publish, optimize + strip). Off by default so shipped
    /// builds stay optimized unless zan.proj sets `pubDebug = true`.
    static bool ProjPublishDebug(string root) {
        return ZanIDE.ProjField(root, "pubDebug") == "true";
    }

    /// Project setting: whether a published GUI app bundles theme skins next to
    /// its exe. Off by default -- the app then ships only its compiled-in base
    /// theme and stays small (the full skin set is ~640KB, mostly banner art).
    /// Turn it on so the produced app's top-right skin picker has packs to load.
    static bool ProjSkinsEnabled(string root) {
        return ZanIDE.ProjField(root, "skins") == "1";
    }

    /// The skin packs available to bundle: the directory names under the shipped
    /// stdlib Gui/skins folder (base.css and other loose files are not dirs).
    static List<string> AvailableSkinNames() {
        List<string> names = new List<string>();
        string dir = ZanIDE.StdlibDir() + "/Gui/skins";
        if (!Directory.Exists(dir)) { return names; }
        List<string> subs = Directory.GetDirectories(dir);
        for (int i = 0; i < subs.Count; i = i + 1) { names.Add(subs[i]); }
        return names;
    }

    /// The skins the project chose to bundle (zan.proj `skinlist = a,b,c`).
    /// When packaging is on but nothing was saved yet, defaults to dark + light
    /// so the picker still has something to switch between.
    static List<string> ProjSkinList(string root) {
        List<string> outp = new List<string>();
        string raw = ZanIDE.ProjField(root, "skinlist");
        int start = 0;
        for (int i = 0; i <= raw.Length; i = i + 1) {
            if (i == raw.Length || raw.Substring(i, 1) == ",") {
                string tok = ZanIDE.TrimLeadSpaces(raw.Substring(start, i - start));
                int e = tok.Length;
                while (e > 0) {
                    string ch = tok.Substring(e - 1, 1);
                    if (ch == " " || ch == "\t") { e = e - 1; } else { break; }
                }
                tok = tok.Substring(0, e);
                if (tok != "") { outp.Add(tok); }
                start = i + 1;
            }
        }
        if (outp.Count == 0) {
            outp.Add("dark");
            outp.Add("light");
        }
        return outp;
    }

    /// True when the project builds a library instead of a runnable program
    /// (zan.proj `target = dll/lib/so/dylib/a` or `type = library`). Library
    /// projects are compiled to the platform's library format and never
    /// launched after a build.
    static bool IsLibraryProject(string root) {
        string t = ZanIDE.ProjField(root, "target");
        if (t == "dll" || t == "lib" || t == "so" || t == "dylib" || t == "a") {
            return true;
        }
        return ZanIDE.ProjField(root, "type") == "library";
    }

    /// The shared-library extension of the machine the IDE runs on.
    static string HostLibExt() {
        #if WINDOWS
        return ".dll";
        #elif MACOS
        return ".dylib";
        #else
        return ".so";
        #endif
    }

    /// The shared-library extension for a publish target id
    /// (windows-* -> .dll, macos-* -> .dylib, linux-* -> .so).
    static string LibExtFor(string id) {
        if (ZanIDE.StartsWith(id, "windows")) { return ".dll"; }
        if (ZanIDE.StartsWith(id, "macos")) { return ".dylib"; }
        return ".so";
    }

    /// The static-library extension for a publish target id
    /// (windows-* -> .lib, everything else -> .a).
    static string StaticLibExtFor(string id) {
        if (ZanIDE.StartsWith(id, "windows")) { return ".lib"; }
        return ".a";
    }

    /// Whether the library project also publishes static archives
    /// (zan.proj `staticLib = true`).
    static bool ProjStaticLib(string root) {
        return ZanIDE.ProjField(root, "staticLib") == "true";
    }

    /// The icon a produced executable should carry: the project's configured
    /// one (zan.proj `icon = ...`), then assets/app.ico, then the shipped Zan
    /// icon -- so every program the IDE builds, tools and samples included,
    /// gets an icon. Returns "" when none of them exists.
    static string IconFile(string root) {
        string rel = ZanIDE.ProjField(root, "icon");
        if (rel != "") {
            string ico = root + "/" + rel;
            if (File.Exists(ico)) { return ico; }
        }
        string a = ZanIDE.AssetsDir(root) + "/app.ico";
        if (File.Exists(a)) { return a; }
        return ZanIDE.ZanIconSource();
    }

    /// The same icon as a zanc `--icon` argument, or "" when there is none.
    static string IconArg(string root) {
        string f = ZanIDE.IconFile(root);
        if (f == "") { return ""; }
        return " --icon \"" + f + "\"";
    }

    static void Main() {
        try {
            ZanIDE ide = new ZanIDE();
            ZanIDE.current = ide;
            ide.Run();
        } catch (Exception e) {
            // The IDE must never vanish without a trace: a stray exception in
            // the main loop used to end the process silently. Write the message
            // to the cache crash log and show it (a Windows GUI program has no
            // console, so the compiler's "Unhandled exception" stderr print
            // would be invisible). The handler stays on field access and
            // finally-free calls only (A35: a call into a finally-bearing
            // method from a try region of this giant module fails to compile).
            string m = e.Message;
            if (m == "") { m = "unknown error"; }
            string p = ZanIDE.CacheDir() + "/ide_error.log";
            File.WriteAllText(p, "ZanIDE crashed: " + m + "\n");
            #if WINDOWS
            System.Windows.Forms.MessageBox.Show("ZanIDE crashed: " + m, "ZanIDE");
            #endif
        }
    }

    /// The IDE itself: builds the window and state, then pumps the main
    /// window, the child windows and the file picker until the app exits.
    void Run() {
        // Restore the last-used window / panel sizes (see SaveSettings).
        string cfg = "";
        if (File.Exists(ZanIDE.CfgPath())) { cfg = File.ReadAllText(ZanIDE.CfgPath()); }
        InitWindowAndProject(cfg);
        // The IDE's own stylesheet: page layout (flex, widths, gaps) lives in
        // ide.css, layered over whichever skin is active.
        app.UseAppCss(ZanIDE.PageCss());
        InitWizardCatalogs();
        InitDialogState();
        InitDocState();
        InitFindReplaceState();
        InitPublishState();
        InitEditorAppearance();
        InitHelpBrowser();
        InitOutputSelection();
        InitDebugState();
        InitDesignerState();
        InitPanelsAndDock(cfg);
        InitGitPanel();
        InitHelpPanel();
        InitAiState();
        InitRunState(cfg);
        InitSidebarState();

        lastPresent = 0;
        lastSkinIdx = app.ThemeMenuIndex();
        while (app.isRunning) {
            // Advance any active AI automation script (ZAN_UI_SCRIPT). This
            // pump bypasses App.ProcessEvent, so drive the driver here too;
            // it injects synthetic events this loop then polls & dispatches.
            UiDriver.Tick();
            FilePicker.lang = ZanIDE.uiLang;
            CodeEditor.lang = ZanIDE.uiLang;
            Designer.lang = ZanIDE.uiLang;
            pathPicker.ApplySkin(app.ThemeMenuIndex());
            // Skin follow: App.SyncSkin raises themeMenuChange (delegate event)
            // when the user picks a new skin; every child window then follows
            // the main window's look here, once per change.
            if (app.ThemeMenuIndex() != lastSkinIdx) {
                lastSkinIdx = app.ThemeMenuIndex();
                if (dlg != null) {
                    dlg.ApplySkin(lastSkinIdx);
                    dlg.RequestRedraw();
                }
                ChildWindows.FollowSkin(lastSkinIdx);
            }
            // Opacity follow: the appearance drawer sets it on the main
            // window; children inherit it and the value is persisted.
            if (app.WindowOpacity() != winOpacity) {
                winOpacity = app.WindowOpacity();
                if (dlg != null) { dlg.SetWindowOpacity(winOpacity); }
                ChildWindows.FollowOpacity(winOpacity);
            }
            // Wallpaper: the appearance drawer asks the host to pick a file
            // (App has no file dialog), and any change follows to the children.
            if (app.ConsumeWallpaperPick() && !pathPicker.IsOpen()) {
                pathPicker.BeginOpenFile(
                    ZanIDE.ReadLastPickerDirectory(root), ".png;.jpg;.jpeg;.bmp",
                    ZanIDE.T("Choose a window background image", "选择窗口背景图片"));
                pathPickerOwner = 9;
                app.RequestRedraw();
            }
            if (app.UserWallpaperPath() != wallPath
                    || app.UserWallpaperOpacity() != wallOpacity) {
                wallPath = app.UserWallpaperPath();
                wallOpacity = app.UserWallpaperOpacity();
                if (dlg != null) { dlg.SetUserWallpaper(wallPath, wallOpacity); }
                ChildWindows.FollowWallpaper(wallPath, wallOpacity);
            }
            // One shared event pump drives BOTH the main window and any open
            // wizard child window. Poll (to keep animating) when either needs a
            // repaint; otherwise block until the OS delivers an event.
            bool want = pathPicker.NeedsRedraw();
            if (!pathPicker.IsOpen() && app.needsRedraw) { want = true; }
            if (!pathPicker.IsOpen() && dlg != null) {
                if (dlg.needsRedraw) { want = true; }
            }
            if (!pathPicker.IsOpen() && ChildWindows.Wants()) { want = true; }
            int r;
            if (want) {
                int since = Window.GetTickMs() - lastPresent;
                if (lastPresent > 0 && since < 16) { Window.SleepMs(16 - since); }
                r = app.window.PollEvent();
            } else {
                // Mirror App.ProcessEvent's idle path: this pump bypasses
                // ProcessEvent, so it must serve the throttled animation /
                // skin-effect deadlines itself — otherwise backdrop effects
                // only tick when the mouse generates events.
                r = 1;
                bool idleWait = true;
                while (idleWait) {
                    int deadline = app.animNextMs;
                    if (app.fxNextMs >= 0 && (deadline < 0 || app.fxNextMs < deadline)) {
                        deadline = app.fxNextMs;
                    }
                    // Fold every open child window's animation deadlines in too, so
                    // button hover/press cross-fades, ripples, and skin backdrop
                    // effects keep ticking smoothly after the mouse stops
                    // (otherwise a fade-out or animated skin freezes mid-way
                    // until the next OS event).
                    if (dlg != null) {
                        if (dlg.animNextMs >= 0 && (deadline < 0 || dlg.animNextMs < deadline)) {
                            deadline = dlg.animNextMs;
                        }
                        if (dlg.fxNextMs >= 0 && (deadline < 0 || dlg.fxNextMs < deadline)) {
                            deadline = dlg.fxNextMs;
                        }
                    }
                    deadline = ChildWindows.Deadline(deadline);
                    if (deadline < 0) {
                        r = app.window.WaitEvent();
                        idleWait = false;
                    } else {
                        int idleNow = Window.GetTickMs();
                        if (idleNow >= deadline) {
                            bool childDue = false;
                            if (dlg != null) {
                                if (dlg.animNextMs >= 0 && idleNow >= dlg.animNextMs) { childDue = true; }
                                if (dlg.fxNextMs >= 0 && idleNow >= dlg.fxNextMs) { childDue = true; }
                            }
                            if (ChildWindows.TickDue(idleNow)) { childDue = true; }
                            bool fxOnly = app.animNextMs < 0 || idleNow < app.animNextMs;
                            if (!childDue && fxOnly && app.FxPresent()) {
                                // Effect tick presented in place; keep idling.
                            } else {
                                app.needsRedraw = true;
                                if (childDue && dlg != null) { dlg.RequestRedraw(); }
                                r = app.window.PollEvent();
                                idleWait = false;
                            }
                        } else {
                            r = app.window.WaitEventTimeout(deadline - idleNow);
                            if (r != 1) { idleWait = false; }
                        }
                    }
                }
            }
            if (r < 0) { break; }

            nint evh = Window.EventHwnd();
            // The raw native kind: this is the router, so it must see events
            // for every window (a child's close arrives with evh == that child).
            // Widgets, by contrast, go through App.EventKind(), which hides
            // events belonging to another window.
            int kind = app.window.EventKind();

            if (kind == 8) {
                if (ChildWindows.Route(evh)) {
                    // A child window closed: it drops out of the registry on
                    // the next pump, and the page it fed may need a repaint.
                    lastActive = 0 - 1;
                    app.RequestRedraw();
                } else if (pathPicker.OwnsWindow(evh)) {
                    pathPicker.ApplyEvent(evh);
                } else if (!pathPicker.IsOpen()) {
                    // Close: only the main window quits the app; a wizard window
                    // that closes simply dismisses the wizard.
                    if (evh == app.WindowHandle()) { break; }
                    dlg = null;
                    dlgMode = 0;
                    if (pathPickerOwner == 1) {
                        pathPicker.Close();
                        pathPickerOwner = 0;
                    }
                    app.RequestRedraw();
                }
            } else if (pathPicker.OwnsWindow(evh)) {
                pathPicker.ApplyEvent(evh);
            } else {
                // Deliver to the one window the event was addressed to. Handing
                // it to every App made each of them decide "is this mine?", and
                // the ones it did not belong to still touched their own pointer
                // and press state. The picker no longer swallows events meant
                // for other windows either: it is a separate OS window, so it
                // cannot be modal to windows it does not own.
                if (evh == app.WindowHandle()) { app.ApplyEvent(evh); }
                else if (dlg != null && evh == dlg.WindowHandle()) { dlg.ApplyEvent(evh); }
                else { ChildWindows.Route(evh); }
            }
            // The form designer is bound to .zform tabs (C#-style form files):
            // the active tab's extension decides whether the designer or the code
            // editor is shown, rather than a global toggle.
            int actDM = activeTab.Get();
            if (actDM >= 0 && actDM < tabs.Count) {
                designerMode = ZanIDE.IsFormPath(tabs[actDM].path) && tabs[actDM].path != codeViewForm;
                sceneMode = ZanIDE.IsScenePath(tabs[actDM].path) && tabs[actDM].path != codeViewForm;
            } else {
                designerMode = false;
                sceneMode = false;
            }

            // ---- keyboard shortcuts for debug ----
            if (kind == 5) {
                int kc = app.window.EventKeyCode();
                if (kc == 116 && dbgState == 0) {
                    // F5 = Start Debug (same as clicking Debug button). The
                    // `-g` build runs DETACHED; the poll opens the debugger on
                    // success so F5 never freezes the window during compilation.
                    if (!buildBusy) {
                        this.SaveActiveTab();
                        string dExe = ZanIDE.DebugBuildBegin(tabs, activeTab, root, log);
                        if (dExe != "") {
                            buildBusy = true;
                            buildThenRun = false;
                            dbgBuildPending = true;
                            buildExe = dExe;
                            buildTargetPath = ZanIDE.PathOf(tabs, activeTab);
                            buildLogLen = 0;
                            dock.Focus("output");
                            app.RequestAnimationFrame(80);
                        }
                    }
                    app.RequestRedraw();
                } else if (kc == 116 && dbgState == 2) {
                    // F5 = Continue
                    if (dbg != null) { dbg.Continue(); }
                    dbgState = ZanIDE.DbgSync(dbg, editor, log, dbgConsole);
                    dbgExecLine = ZanIDE.DbgLine(dbg);
                    dbgVarInfo = ZanIDE.DbgVars(dbg);
                    dbgStack = ZanIDE.DbgStack(dbg);
                    dbgWatchVals = ZanIDE.DbgEvalWatches(dbg, dbgWatches);
                    if (dbgState == 2) {
                        ZanIDE.LogVarsToConsole(log, dbgVarInfo, dbgExecLine);
                    } else {
                        dbg = null;
                    }
                    app.RequestRedraw();
                } else if (kc == 121 && dbgState == 2) {
                    // F10 = Step Over
                    if (dbg != null) { dbg.StepOver(); }
                    dbgState = ZanIDE.DbgSync(dbg, editor, log, dbgConsole);
                    dbgExecLine = ZanIDE.DbgLine(dbg);
                    dbgVarInfo = ZanIDE.DbgVars(dbg);
                    dbgStack = ZanIDE.DbgStack(dbg);
                    dbgWatchVals = ZanIDE.DbgEvalWatches(dbg, dbgWatches);
                    if (dbgState == 2) {
                        ZanIDE.LogVarsToConsole(log, dbgVarInfo, dbgExecLine);
                    } else {
                        dbg = null;
                    }
                    app.RequestRedraw();
                } else if (kc == 122 && dbgState == 2) {
                    // F11 = Step Into
                    if (dbg != null) { dbg.StepIn(); }
                    dbgState = ZanIDE.DbgSync(dbg, editor, log, dbgConsole);
                    dbgExecLine = ZanIDE.DbgLine(dbg);
                    dbgVarInfo = ZanIDE.DbgVars(dbg);
                    dbgStack = ZanIDE.DbgStack(dbg);
                    dbgWatchVals = ZanIDE.DbgEvalWatches(dbg, dbgWatches);
                    if (dbgState == 2) {
                        ZanIDE.LogVarsToConsole(log, dbgVarInfo, dbgExecLine);
                    } else {
                        dbg = null;
                    }
                    app.RequestRedraw();
                } else if (kc == 27 && dbgState == 2) {
                    // Escape = Stop debugging
                    if (dbg != null) { dbg.Stop(); dbg = null; }
                    dbgState = 0; dbgExecLine = -1; editor.SetExecLine(-1);
                    log.Add("> [Debug] Stopped.");
                    app.RequestRedraw();
                } else if (kc == 27 && refList.IsOpen()) {
                    // Escape = close the reference list (before the find bar:
                    // it is the thing that opened last).
                    refList.Close();
                    app.RequestRedraw();
                } else if (kc == 27 && findMode > 0) {
                    // Escape = close find/replace/goto, and hand the keyboard
                    // back to the editor the bar took it from.
                    findMode = 0;
                    app.focus.SetFocused(editor.LastWidgetId());
                    app.RequestRedraw();
                } else if (kc == 27 && pubWin != null && pubWin.IsOpen()) {
                    // Escape = close publish window
                    pubWin.Close();
                    app.RequestRedraw();
                } else if (kc == 27 && marketplaceWin != null && marketplaceWin.IsOpen()) {
                    marketplaceWin.Close();
                    app.RequestRedraw();
                } else if (kc == 123 && !designerMode && dbgState == 0) {
                    // F12 = Go to Definition
                    if (lspSess == null && !lspTried) {
                        lspTried = true;
                        lspSess = LspSession.Start(root);
                        if (lspSess != null) { log.Add("> zan-lsp connected: semantic navigation enabled."); }
                    }
                    string navW_gl12 = editor.WordAtCaret();
                    this.RememberTabView();
                    int gl12 = ZanIDE.GoToDefinitionSmart(lspSess, editor, tabs, activeTab, root, log);
                    this.ApplyGotoResult(gl12, navW_gl12);
                    app.RequestRedraw();
                } else if (kc == 113 && !designerMode && dbgState == 0) {
                    // F2 = Rename Symbol
                    renameWord = editor.WordAtCaret();
                    if (renameWord.Length > 0) {
                        renameText = renameWord;
                        findMode = 5;
                    } else {
                        log.Add("> Rename: no symbol under caret.");
                    }
                    app.RequestRedraw();
                } else if (kc == 119 && !designerMode && dbgState == 0) {
                    // F8 / Shift+F8 = walk the Find in Files results, opening
                    // the file when the match is in one that is not open.
                    if (fifHits.Count == 0) {
                        log.Add(ZanIDE.T("> No search results. Ctrl+Shift+F searches the project.",
                            "> 没有搜索结果。Ctrl+Shift+F 可搜索整个项目。"));
                    } else {
                        if (Modifiers.HasShift(app.window.EventMods())) {
                            fifSel = fifSel - 1;
                            if (fifSel < 0) { fifSel = fifHits.Count - 1; }
                        } else {
                            fifSel = fifSel + 1;
                            if (fifSel >= fifHits.Count) { fifSel = 0; }
                        }
                        int hitLine = ZanIDE.GotoSearchHit(fifHits, fifSel,
                            tabs, activeTab, log);
                        if (hitLine >= 0) {
                            pendingGotoLine = hitLine;
                            pendingGotoCol = 0;
                            lastActive = 0 - 1;
                        }
                    }
                    app.RequestRedraw();
                } else if (kc == 118 && dbgState == 0) {
                    // F7 on a design tab toggles it in place between the visual
                    // designer and a read-only source view (a .zform shows its
                    // design JSON, a .zscene its generated code); on a code
                    // file it opens the .zform paired with it.
                    int actF7 = activeTab.Get();
                    if (actF7 >= 0 && actF7 < tabs.Count
                            && (ZanIDE.IsFormPath(tabs[actF7].path)
                                || ZanIDE.IsScenePath(tabs[actF7].path))) {
                        string fp7 = tabs[actF7].path;
                        if (codeViewForm == fp7) {
                            codeViewForm = "";
                            log.Add(ZanIDE.T("> Design view.", "> 设计视图。"));
                        } else {
                            codeViewForm = fp7;
                            formCodeLoaded = "";
                            log.Add(ZanIDE.T("> Code view.", "> 代码视图。"));
                        }
                        lastActive = 0 - 1;
                    } else if (actF7 >= 0 && actF7 < tabs.Count) {
                        string ap7 = tabs[actF7].path;
                        if (ap7.Length > 4 && ap7.Substring(ap7.Length - 4, 4) == ".zan") {
                            string cand7 = ap7.Substring(0, ap7.Length - 4) + ".zform";
                            if (File.Exists(cand7)) {
                                int ci7 = ZanIDE.FindTabByPath(tabs, cand7);
                                if (ci7 >= 0) { activeTab.Set(ci7); }
                                else { ZanIDE.OpenPath(tabs, activeTab, cand7, Path.GetFileName(cand7)); }
                                loadedFormPath = "";
                                lastActive = 0 - 1;
                            } else {
                                log.Add("> No paired .zform for " + Path.GetFileName(ap7) + ".");
                            }
                        }
                    }
                    app.RequestRedraw();
                }
            }
            // Ctrl+key via WM_CHAR (kind == 6)
            if (kind == 6) {
                int cc = app.window.EventKeyCode();
                if (cc == 6) {
                    // Ctrl+F = Find in this file, Ctrl+Shift+F = Find in Files
                    if (Modifiers.HasShift(app.window.EventMods())) {
                        findMode = 6;
                        fifQuery = "";
                    } else {
                        if (findMode != 2) { findMode = 1; }
                        findBar.Open(false, this.FindSeed());
                    }
                    app.RequestRedraw();
                } else if (cc == 7) {
                    // Ctrl+G = Go to Line
                    findMode = 3;
                    gotoText = "";
                    app.RequestRedraw();
                } else if (cc == 18) {
                    // Ctrl+R = Replace (Ctrl+H is 8 which conflicts with
                    // Backspace); Ctrl+Shift+R = Replace in Files
                    if (Modifiers.HasShift(app.window.EventMods())) {
                        findMode = 7;
                        fifRepl = "";
                    } else {
                        findMode = 2;
                        findBar.Open(true, this.FindSeed());
                    }
                    app.RequestRedraw();
                } else if (cc == 2) {
                    // Ctrl+B = edit the breakpoint condition on the caret line
                    if (!designerMode) {
                        findMode = 4;
                        bpCondText = ZanIDE.CondFor(bpConds, editor.CurLine());
                    }
                    app.RequestRedraw();
                } else if (cc == 5) {
                    // Ctrl+E = Format Document (zanfmt); Ctrl+D is taken by
                    // the editor's duplicate-line.
                    if (!designerMode && !sceneMode && findMode == 0) {
                        ZanIDE.FormatDocument(editor, log);
                    }
                    app.RequestRedraw();
                } else if (cc == 19) {
                    // Ctrl+S = Save (+ hot reload when enabled)
                    int aSv = activeTab.Get();
                    if (aSv >= 0 && aSv < tabs.Count
                            && ZanIDE.IsFormPath(tabs[aSv].path) && codeViewForm == tabs[aSv].path) {
                        // The .zform code view shows the design JSON, which is
                        // owned by the designer - it is read-only here.
                        log.Add(ZanIDE.T("> The design JSON is read-only here; edit the design, or open Name.zan for logic.", "> 设计 JSON 此处只读；请修改设计，或打开 Name.zan 编写逻辑。"));
                    } else if (aSv >= 0 && aSv < tabs.Count
                            && ZanIDE.IsScenePath(tabs[aSv].path) && codeViewForm == tabs[aSv].path) {
                        // The .zscene code view shows the code the compiler
                        // projects from the design - it is read-only here.
                        log.Add(ZanIDE.T("> The projected scene code is read-only; edit the design, or open Name.zan for logic.", "> 场景投影代码只读；请修改设计，或打开 Name.zan 编写逻辑。"));
                    } else if (!designerMode && !sceneMode && aSv >= 0 && aSv < tabs.Count && tabs[aSv].path != "@start") {
                        this.SaveActiveTab();
                        if (autoRun) { hotReloadReq = true; }
                        rescan = true;
                        Layer.Msg(ZanIDE.T("Saved", "已保存"), 3);
                    }
                    app.RequestRedraw();
                }
            }

            // ---------------- main IDE window ----------------
            if (app.needsRedraw && !pathPicker.IsOpen()) {
            // A single bad widget must not take the IDE down: the whole frame
            // runs under an exception boundary, so a failure is logged (see
            // Gui.UiErrorLog / the Help & Feedback panel), this frame is
            // dropped and the next one is repainted from scratch. The body
            // keeps its original indentation to stay diffable.
            try {
                app.BeginFrame();
                Canvas c = app.canvas;
                Theme t = app.theme;
                int W = c.Width();
                int H = c.Height();
                // Persist the LOGICAL (96-dpi) window size, not the physical
                // canvas size. The window is created from a logical size that the
                // runtime scales up by the display DPI; saving the scaled size and
                // re-creating from it would re-scale every launch (the window kept
                // growing/shrinking). Divide back out by dpiScale (a percentage).
                int dscale = app.dpiScale;
                if (dscale <= 0) { dscale = 100; }
                savedW = W * 100 / dscale;
                savedH = H * 100 / dscale;
                int top = app.titlebarH;
                int ribbonH = Ribbon.HeightTabbed(app);
                int sbH = app.Scale(22);
                // Themed window backdrop (gradient/glass wallpaper or flat fill)
                // behind the whole shell, so the IDE renders every skin exactly
                // like the gallery. Translucent surfaces below let it show.
                app.RenderBackground(0, top, W, H - top, 0);

                // Enable/disable ribbon commands by context. Build/Publish/Hot/
                // Config need an open project (zan.proj); Run/Debug/Designer work
                // on a single open file; all are disabled on the Start page.
                int atE = activeTab.Get();
                string apE = "";
                if (atE >= 0 && atE < tabs.Count) { apE = tabs[atE].path; }
                bool activeIsFile = apE != "" && apE != "@start";
                bool haveProj = File.Exists(root + "/zan.proj");
                // Run/Debug/Build follow the active file, or fall back to the
                // project entry (so a designer/start tab can still run the app).
                bool canRun = activeIsFile || haveProj;
                // The ribbon is rebuilt each frame: its commands are pure
                // configuration (icon, label, action id) and the View tab is
                // just the dock's own Panels section.
                List<int> ribbonActions = new List<int>();
                List<RibbonGroup> ribbonGroups =
                    ZanIDE.BuildRibbonGroups(ribbonTab.Get(), ribbonActions);
                ZanIDE.SyncRibbonEnabled(ribbonGroups, ribbonActions, canRun, haveProj);
                if (ribbonTab.Get() == ZanIDE.RibbonViewTab()) {
                    dock.AddSwitchGroup(ribbonGroups, ZanIDE.T("Panels", "面板"));
                } else {
                    dock.ClearSwitches();
                }
                int rcPos = Ribbon.RenderTabbed(app, 0, top, W, ribbonTabs, ribbonTab,
                    ribbonGroups);
                if (dock.HandleRibbon(rcPos)) { rcPos = 0 - 1; }
                int rc = ZanIDE.RibbonAction(ribbonActions, rcPos);
                if (rc == 0 && dlg == null) {
                    // Rebuild the catalog (built-ins + custom templates on disk).
                    tpls = ZanIDE.BuildCatalog(root);
                    wizTpls = ZanIDE.WizTemplates(tpls);
                    catNames = ZanIDE.CatsOf(tpls);
                    catSel.Set(0);
                    pSel.Set(0);
                    pSizeSeededFor = 0 - 1;
                    pNameInput.SetText("NewProject");
                    pLocInput.SetText(ZanIDE.ReadLastPickerDirectory(ZanIDE.ProjectsHome()));
                    Wizard.notice = "";
                    dlg = App.CreateDark(ZanIDE.T("New Project", "新建项目"), 1180, 680);
                    dlg.ApplySkin(app.ThemeMenuIndex());
                    dlg.Show();
                    dlgMode = 1;
                } else if (rc == 1 && dlg == null) {
                    dlg = ZanIDE.OpenWizard(app, ZanIDE.T("New File", "新建文件"), fSel, fNameInput, "NewFile");
                    dlgMode = 2;
                } else if (rc == 2) {
                    pathPicker.BeginOpenFileFilters(
                        ZanIDE.ReadLastPickerDirectory(root),
                        ZanIDE.OpenFileFilters(),
                        ZanIDE.T("Open source file", "打开源文件"));
                    pathPickerOwner = 4;
                    app.RequestRedraw();
                } else if (rc == 16) {
                    pathPicker.BeginFolder(
                        ZanIDE.ReadLastPickerDirectory(root),
                        ZanIDE.T("Open a project folder", "打开项目文件夹"));
                    pathPickerOwner = 10;
                    app.RequestRedraw();
                } else if (rc == 3) {
                    int aSv3 = activeTab.Get();
                    if (aSv3 >= 0 && aSv3 < tabs.Count
                            && ZanIDE.IsFormPath(tabs[aSv3].path) && codeViewForm == tabs[aSv3].path) {
                        // The .zform code view shows the design JSON (read-only).
                        log.Add(ZanIDE.T("> The design JSON is read-only here; edit the design, or open Name.zan for logic.", "> 设计 JSON 此处只读；请修改设计，或打开 Name.zan 编写逻辑。"));
                    } else if (aSv3 >= 0 && aSv3 < tabs.Count
                            && ZanIDE.IsScenePath(tabs[aSv3].path) && codeViewForm == tabs[aSv3].path) {
                        // The projected scene code is read-only in the code view.
                        log.Add(ZanIDE.T("> The projected scene code is read-only; edit the design, or open Name.zan for logic.", "> 场景投影代码只读；请修改设计，或打开 Name.zan 编写逻辑。"));
                    } else {
                        this.SaveActiveTab();
                        if (autoRun) { hotReloadReq = true; }
                    }
                    Layer.Msg(ZanIDE.T("Saved", "已保存"), 3);
                    rescan = true;
                } else if (rc == 4) {
                    // Run (4) and Build (5) compile the active target in a
                    // DETACHED shell so a slow compile never freezes the IDE;
                    // completion is handled by the buildBusy poll below.
                    this.SaveActiveTab();
                    if (buildBusy) {
                        Layer.Msg(ZanIDE.T("Build already running…", "构建进行中…"), 2);
                    } else {
                        int atB = activeTab.Get();
                        string apB = "";
                        if (atB >= 0 && atB < tabs.Count) { apB = tabs[atB].path; }
                        string rpB = ZanIDE.RibbonRunTarget(apB, root);
                        if (rpB == "") {
                            log.Add(ZanIDE.T("> Nothing to run (open and save a source file first).", "> 没有可运行的目标（请先打开并保存源文件）。"));
                        } else {
                            buildBusy = true;
                            // A library has no entry point to launch: Run on a
                            // library project builds the shared library only.
                            buildThenRun = !ZanIDE.IsLibraryProject(root);
                            buildExe = ZanIDE.RunBuildBegin(root, rpB);
                            buildIsGui = ZanIDE.IsWindowedTarget(root, rpB);
                            buildTargetPath = apB;
                            buildLogLen = 0;
                            dock.Focus("output");
                            log.Add("> Building " + rpB + " ...");
                            if (rc == 4 && !buildThenRun) { Layer.Msg(ZanIDE.T("Building library…", "正在构建库…"), 2); }
                            else if (rc == 4) { Layer.Msg(ZanIDE.T("Building & running…", "正在构建并运行…"), 2); }
                            else { Layer.Msg(ZanIDE.T("Building…", "正在构建…"), 2); }
                            app.RequestAnimationFrame(80);
                        }
                    }
                } else if (rc == 6) {
                    this.SaveActiveTab();
                    pubSel = ZanIDE.ReadProjectPlatforms(root);
                    if (pubWin == null) {
                        pubWin = PublishWindow.Open(app, root, pubSel, ZanIDE.uiLang);
                    }
                    app.RequestRedraw();
                } else if (rc == 7) {
                    // Debug (F5)
                    designerMode = false;
                    if (dbgState == 0) {
                        if (!buildBusy) {
                            this.SaveActiveTab();
                            string dExe = ZanIDE.DebugBuildBegin(tabs, activeTab, root, log);
                            if (dExe != "") {
                                buildBusy = true;
                                buildThenRun = false;
                                dbgBuildPending = true;
                                buildExe = dExe;
                                buildTargetPath = ZanIDE.PathOf(tabs, activeTab);
                                buildLogLen = 0;
                                dock.Focus("output");
                                app.RequestAnimationFrame(80);
                            }
                        }
                    } else if (dbgState == 2) {
                        if (dbg != null) { dbg.Continue(); }
                        dbgState = ZanIDE.DbgSync(dbg, editor, log, dbgConsole);
                        dbgExecLine = ZanIDE.DbgLine(dbg);
                        dbgVarInfo = ZanIDE.DbgVars(dbg);
                        dbgStack = ZanIDE.DbgStack(dbg);
                        dbgWatchVals = ZanIDE.DbgEvalWatches(dbg, dbgWatches);
                        if (dbgState == 2) {
                            ZanIDE.LogVarsToConsole(log, dbgVarInfo, dbgExecLine);
                        } else {
                            dbg = null;
                        }
                    }
                } else if (rc == 8 && dlg == null) {
                    tmplCatSel.Set(5);
                    tmplNameInput.SetText(Path.GetFileName(root));
                    dlg = App.CreateDark(ZanIDE.T("Save as Template", "另存为模板"), 640, 470);
                    dlg.ApplySkin(app.ThemeMenuIndex());
                    dlg.Show();
                    dlgMode = 3;
                } else if (rc == 11) {
                    autoRun = !autoRun;
                    if (autoRun) { log.Add("> Hot reload: ON (save rebuilds & restarts the app)."); }
                    else { log.Add("> Hot reload: OFF."); }
                    app.RequestRedraw();
                } else if (rc == 12) {
                    // Open the visual Project Configuration panel (icon + static
                    // resources bundled with the app).
                    if (File.Exists(root + "/zan.proj")) {
                        if (cfgWin == null) {
                            cfgWin = ConfigWindow.Open(app, root, log, ZanIDE.uiLang, 0);
                        }
                    } else {
                        log.Add("> Open or create a project first to configure it.");
                    }
                    app.RequestRedraw();
                } else if (rc == 15) {
                    if (File.Exists(root + "/zan.proj")) {
                        if (marketplaceWin == null || !marketplaceWin.IsOpen()) {
                            marketplaceWin = MarketplaceWindow.Open(app, ZanIDE.uiLang);
                        }
                    } else {
                        log.Add(ZanIDE.T("> Open or create a project before installing packages.",
                            "> 请先打开或创建工程，再安装库。"));
                    }
                    app.RequestRedraw();
                } else if (rc == 13) {
                    if (settingsWindow == null
                        || !settingsWindow.IsOpen()) {
                        settingsWindow = EditorSettingsWindow.Open(
                            app, edThemeIdx, edFontPx,
                            ZanIDE.uiLang, defFontPx);
                    }
                } else if (rc == 14) {
                    // Open the Help / documentation browser (a real "@docs" tab).
                    int di = ZanIDE.FindTabByPath(tabs, "@docs");
                    if (di >= 0) {
                        activeTab.Set(di);
                    } else {
                        tabs.Add(TabRecord.Create(ZanIDE.T("Help", "帮助"), "", "@docs"));
                        activeTab.Set(tabs.Count - 1);
                    }
                    lastActive = 0 - 1;
                    app.RequestRedraw();
                }

                // ---- Debug toolbar (when debugging) ----
                int dbgBarH = 0;
                if (dbgState == 2) {
                    dbgBarH = app.Scale(38);
                    int dbgAction = DebugPanel.RenderDebugToolbar(
                        app, c, t, 0, top + ribbonH, W, dbgBarH, dbgExecLine,
                        DebugPanel.ToolbarButtons());
                    if (dbgAction == 0) {
                        if (dbg != null) { dbg.Continue(); }
                        dbgState = ZanIDE.DbgSync(dbg, editor, log, dbgConsole);
                        dbgExecLine = ZanIDE.DbgLine(dbg);
                        dbgVarInfo = ZanIDE.DbgVars(dbg);
                        dbgStack = ZanIDE.DbgStack(dbg);
                        dbgWatchVals = ZanIDE.DbgEvalWatches(dbg, dbgWatches);
                        if (dbgState == 2) {
                            ZanIDE.LogVarsToConsole(log, dbgVarInfo, dbgExecLine);
                        } else { dbg = null; }
                        app.RequestRedraw();
                    } else if (dbgAction == 1) {
                        if (dbg != null) { dbg.StepOver(); }
                        dbgState = ZanIDE.DbgSync(dbg, editor, log, dbgConsole);
                        dbgExecLine = ZanIDE.DbgLine(dbg);
                        dbgVarInfo = ZanIDE.DbgVars(dbg);
                        dbgStack = ZanIDE.DbgStack(dbg);
                        dbgWatchVals = ZanIDE.DbgEvalWatches(dbg, dbgWatches);
                        if (dbgState == 2) {
                            ZanIDE.LogVarsToConsole(log, dbgVarInfo, dbgExecLine);
                        } else { dbg = null; }
                        app.RequestRedraw();
                    } else if (dbgAction == 2) {
                        if (dbg != null) { dbg.StepIn(); }
                        dbgState = ZanIDE.DbgSync(dbg, editor, log, dbgConsole);
                        dbgExecLine = ZanIDE.DbgLine(dbg);
                        dbgVarInfo = ZanIDE.DbgVars(dbg);
                        dbgStack = ZanIDE.DbgStack(dbg);
                        dbgWatchVals = ZanIDE.DbgEvalWatches(dbg, dbgWatches);
                        if (dbgState == 2) {
                            ZanIDE.LogVarsToConsole(log, dbgVarInfo, dbgExecLine);
                        } else { dbg = null; }
                        app.RequestRedraw();
                    } else if (dbgAction == 3) {
                        if (dbg != null) { dbg.Stop(); dbg = null; }
                        dbgState = 0; dbgExecLine = -1; editor.SetExecLine(-1);
                        log.Add("> [Debug] Stopped.");
                        app.RequestRedraw();
                    }
                }

                Rect area = new Rect(0, top + ribbonH + dbgBarH, W, H - top - ribbonH - dbgBarH - sbH);
                // The dock resolves every panel's rect and owns the tab strips,
                // split handles and drag/close input; the panels below just draw
                // into the rect it hands back (off-screen while closed, so each
                // panel body stays a plain unconditional render).
                string outlineTitle = ZanIDE.T("STRUCTURE", "结构");
                if (designerMode || sceneMode) { outlineTitle = ZanIDE.T("COMPONENTS", "组件"); }
                if (outlineTitle != dockOutlineTitle) {
                    dock.SetTitle("structure", outlineTitle);
                    dockOutlineTitle = outlineTitle;
                }
                dock.Begin(app, area);

                // Section 1: Explorer. The tree owns its filter row, scrolling,
                // scrollbar and selection; opening a file and raising the
                // context menu are handlers.
                if (explorerTv == null) {
                    explorerTv = new TreeView();
                    explorerTv.BindSel(treeSel).WithFilter(treeFilter).WithMultiSelect();
                    explorerTv.OnSelect(ZanIDE.ExplorerPicked);
                    explorerTv.OnContext(ZanIDE.ExplorerContext);
                }
                treeShow = ZanIDE.FilterNodes(tree, treeFilter.GetText());
                explorerTv.Bind(treeShow);
                explorerTv.RenderInside(app, dock.ContentParked("explorer"));

                // Section 2: Structure / Components. Shows a code outline for
                // source tabs, and the form's component tree in the designer.
                // Rebuild the tree only when the active buffer/form changes so
                // typing and clicking stay cheap. The signature prefix (C/F)
                // also flips the panel between code outline and components.
                int stActTab = activeTab.Get();
                string newSig = "";
                if (designerMode) {
                    List<FormField> flatSig = new List<FormField>();
                    ZanIDE.FlattenFields(formDesigner.fields, flatSig);
                    newSig = "F:" + Convert.ToString(stActTab) + ":" + Convert.ToString(flatSig.Count);
                } else if (sceneMode) {
                    newSig = "S:" + Convert.ToString(stActTab) + ":"
                        + Convert.ToString(sceneDesigner.doc.Count()) + ":"
                        + Convert.ToString(sceneDesigner.doc.ToJson().Length);
                } else {
                    // TextStamp is O(lines) with no allocation; the full text is
                    // only materialised when the outline actually needs rebuilding.
                    newSig = "C:" + Convert.ToString(stActTab) + ":" + Convert.ToString(editor.TextStamp());
                    if (newSig != structSig) { structTree = ZanIDE.BuildOutline(editor.GetText()); }
                }
                if (newSig != structSig) {
                    structSig = newSig;
                    if (designerMode) {
                        string sfn = "Form";
                        if (stActTab >= 0 && stActTab < tabs.Count) {
                            sfn = ZanIDE.FormBaseName(tabs[stActTab].path);
                        }
                        structTree = ZanIDE.BuildFieldTree(sfn, formDesigner.fields);
                    } else if (sceneMode) {
                        string scn = "Scene";
                        if (stActTab >= 0 && stActTab < tabs.Count) {
                            scn = ZanIDE.BaseName(tabs[stActTab].path);
                        }
                        structTree = ZanIDE.BuildSceneTree(scn, sceneDesigner);
                    }
                    structSel.Set(0 - 1);
                }
                if (structTv == null) {
                    structTv = new TreeView();
                    structTv.BindSel(structSel).WithFilter(structFilter);
                    structTv.EmptyText(ZanIDE.T("No symbols", "无符号"));
                    structTv.OnSelect(ZanIDE.StructurePicked);
                }
                structShow = ZanIDE.FilterNodes(structTree, structFilter.GetText());
                structTv.Bind(structShow);
                structTv.RenderInside(app, dock.ContentParked("structure"));

                // Section 3: Examples (collapsible tree, click a leaf to open)
                if (stdlibTv == null) {
                    stdlibTv = new TreeView();
                    stdlibTv.BindSel(exSel).WithFilter(exFilter);
                    stdlibTv.OnSelect(ZanIDE.ExamplePicked);
                    stdlibTv.OnContext(ZanIDE.StdlibContext);
                }
                exShow = ZanIDE.FilterNodes(exTree, exFilter.GetText());
                stdlibTv.Bind(exShow);
                stdlibTv.RenderInside(app, dock.ContentParked("stdlib"));

                // The editor is the dock's fixed center panel, so it always has
                // a rect; every tool panel is parked off-screen while closed.
                Rect ea = dock.Content("editor");
                Rect orr = dock.ContentParked("output");

                // Every open file gets a disk baseline (unsaved-edit and
                // changed-outside detection both read it), and the files are
                // polled for outside changes a few times a second.
                this.TrackOpenTabs();
                this.PollDiskChanges();

                this.SyncEditorTabs();
                editorTabs.Select(activeTab.Get());
                editorTabs.TakeChanged();
                int tabH = editorTabs.HeaderHeight(app);
                editorTabs.Render(app, ea.x, ea.y, ea.width);
                int ctxTab = editorTabs.TakeContext();
                int addTab = editorTabs.TakeAdded();
                int shutTab = editorTabs.TakeClosed();
                int chgTab = editorTabs.TakeChanged();
                if (ctxTab >= 0) {
                    ctxKind = 3; ctxX = app.mouseX; ctxY = app.mouseY;
                    ctxTarget = ctxTab; app.RequestRedraw();
                } else if (ctxKind == 0) {
                    if (addTab >= 0 && dlg == null) {
                        dlg = ZanIDE.OpenWizard(app, ZanIDE.T("New File", "新建文件"), fSel, fNameInput, "NewFile");
                        dlgMode = 2;
                    } else if (shutTab >= 0) {
                        // Asks about unsaved edits first; a clean tab just goes.
                        this.RequestCloseTab(shutTab);
                    } else if (chgTab >= 0) {
                        activeTab.Set(chgTab);
                    }
                }

                int act = activeTab.Get();
                if (act != lastActive) {
                    // Only sync editor text for code tabs; .zform tabs are owned by
                    // the designer and must not be overwritten with editor contents.
                    if (lastActive >= 0 && lastActive < tabs.Count
                        && !ZanIDE.IsFormPath(tabs[lastActive].path)
                        && !ZanIDE.IsScenePath(tabs[lastActive].path)) {
                        tabs[lastActive].body = editor.GetText();
                        // Leaving a tab remembers where it was being read.
                        tabs[lastActive].caretLine = editor.CurLine();
                        tabs[lastActive].caretCol = editor.CurCol();
                        tabs[lastActive].scrollLine = editor.ScrollLine();
                    }
                    if (act >= 0 && act < tabs.Count
                        && !ZanIDE.IsFormPath(tabs[act].path)
                        && !ZanIDE.IsScenePath(tabs[act].path)) {
                        // Highlighting, completion and Ctrl+/ follow the file's
                        // language: an embedded .lua/.py script is not Zan.
                        editor.SetSyntaxLang(
                            CodeEditor.LangForName(tabs[act].path));
                        editor.LoadText(tabs[act].body);
                        // Feed the project's other sources to the editor so it
                        // can resolve cross-file types (a `Utils` class in
                        // another file) and count the uses of a member that
                        // live outside the file being edited.
                        editor.SetProjectFiles(
                            ZanIDE.ProjectSources(tabs, root, act));
                        // Back to where this tab was left, not to line 1. A
                        // pending navigation target is applied just below and
                        // still wins.
                        editor.GoToLineCol(tabs[act].caretLine, tabs[act].caretCol);
                        editor.SetScrollLine(tabs[act].scrollLine);
                    }
                    lastActive = act;
                }

                if (pendingGotoLine >= 0) {
                    editor.GoToLineCol(pendingGotoLine, pendingGotoCol);
                    pendingGotoLine = 0 - 1;
                    app.RequestRedraw();
                }

                Rect edRect = new Rect(ea.x, ea.y + tabH, ea.width, ea.height - tabH);
                bool activeIsStart = (act >= 0 && act < tabs.Count && tabs[act].path == "@start");
                bool activeIsDocs = (act >= 0 && act < tabs.Count && tabs[act].path == "@docs");

                if (designerMode) {
                    // The .zform tab hosts the full component-based form designer
                    // (stdlib Gui.Designer): palette, containers, inspector, event
                    // bindings, JSON drawer. The .zform file stores its design
                    // document; legacy coordinate-based .zform files are converted
                    // on first open.
                    string fpath = tabs[act].path;
                    string fname = ZanIDE.FormBaseName(fpath);
                    if (fpath != loadedFormPath) {
                        string fbody = tabs[act].body;
                        if (ZanIDE.LooksLikeJson(fbody)) {
                            formDesigner.LoadJson(fbody);
                        } else {
                            formDesigner.LoadJson(ZanIDE.LegacyFormToJson(fname, fbody));
                        }
                        loadedFormPath = fpath;
                        formCache = formDesigner.SaveJson();
                        ZanIDE.LoadUserComponents(root, formDesigner);
                        // Offer the code-behind's variables in the designer's
                        // bind-path picker (two-way binding targets).
                        string cbpB = ZanIDE.CodeBehindPath(fpath);
                        if (File.Exists(cbpB)) {
                            formDesigner.SetBindVars(ZanIDE.ScanBindVars(File.ReadAllText(cbpB)));
                        } else {
                            formDesigner.SetBindVars(new List<string>());
                        }
                    }
                    // 先画宿主 dock 里的组件/属性面板：设计器据此知道
                    // 左右两栏归宿主管，本体这一帧只排功能区 + 画布。
                    formDesigner.RenderHostPanels(app, dock.ContentParked("toolbox"),
                        dock.ContentParked("props"));
                    formDesigner.Render(app, edRect.x, edRect.y, edRect.width, edRect.height);
                    // Persist design changes to the .zform file - the single
                    // source of truth (zanc projects typed fields + Main from
                    // it at compile time). The business file (Name.zan) is
                    // never touched here - it is only created when missing.
                    string newser = formDesigner.SaveJson();
                    if (newser != formCache) {
                        tabs[act].body = newser;
                        if (fpath.Length > 0 && fpath.Substring(0, 1) != "@") {
                            File.WriteAllText(fpath, newser);
                            string cbpS = ZanIDE.CodeBehindPath(fpath);
                            if (!File.Exists(cbpS)) {
                                File.WriteAllText(cbpS, ZanIDE.GenBusinessShell(fname));
                            }
                            // Push the new design to zan-lsp so the code-behind's
                            // completion sees added/renamed/deleted controls at once.
                            if (lspSess != null && lspSess.Alive()) {
                                lspSess.SyncDoc(fpath, newser);
                            }
                        }
                        formCache = newser;
                    }
                    // "Save as component": persist the whole design as a reusable
                    // project component (components/<name>.zcomp) and refresh the
                    // designer's "My Components" palette group.
                    if (formDesigner.ConsumeSaveComponent()) {
                        string compName = ZanIDE.SanitizeName(formDesigner.formNameSig.Get());
                        if (compName == "") { compName = fname; }
                        string compDir = root + "/components";
                        Directory.CreateDirectoryRecursive(compDir);
                        string compPath = compDir + "/" + compName + ".zcomp";
                        File.WriteAllText(compPath, formDesigner.SaveJson());
                        ZanIDE.LoadUserComponents(root, formDesigner);
                        log.Add("> Saved component -> " + compPath + ".");
                        app.RequestRedraw();
                    }
                } else if (sceneMode) {
                    // The .zscene tab hosts the free-canvas game scene designer
                    // (stdlib Game.Scene.SceneDesigner). The .zscene file stores
                    // the scene JSON document.
                    string spath = tabs[act].path;
                    if (spath != loadedScenePath) {
                        string sbody = tabs[act].body;
                        if (ZanIDE.LooksLikeJson(sbody)) {
                            sceneDesigner.LoadJson(sbody);
                        } else {
                            sceneDesigner.LoadJson(new SceneDoc(
                                ZanIDE.SceneBaseName(spath), 1280, 720).ToJson());
                        }
                        loadedScenePath = spath;
                        sceneCache = sceneDesigner.SaveJson();
                    }
                    SceneDesigner.assetsDir = ZanIDE.AssetsDir(root);
                    // 先画宿主 dock 里的组件/属性面板：设计器据此知道
                    // 左右两栏归宿主管，本体这一帧只排功能区 + 画布。
                    sceneDesigner.RenderHostPanels(app, dock.ContentParked("toolbox"),
                        dock.ContentParked("props"));
                    sceneDesigner.Render(app, edRect.x, edRect.y, edRect.width, edRect.height);
                    // Persist design changes to the .zscene file.
                    string snewser = sceneDesigner.SaveJson();
                    if (snewser != sceneCache) {
                        tabs[act].body = snewser;
                        if (spath.Length > 0 && spath.Substring(0, 1) != "@") {
                            File.WriteAllText(spath, snewser);
                            // The .zscene is the only file the design lives in
                            // (zanc projects the typed elements at compile
                            // time); create the business Name.zan only when
                            // missing - the designer never overwrites it.
                            string sname = ZanIDE.SceneBaseName(spath);
                            string scbP = ZanIDE.SceneCodeBehindPath(spath);
                            if (!File.Exists(scbP)) {
                                File.WriteAllText(scbP, ZanIDE.GenSceneBusinessShell(sname));
                            }
                            // Push the design to zan-lsp, which projects the
                            // typed elements from the JSON itself, so element
                            // completion tracks the designer.
                            if (lspSess != null && lspSess.Alive()) {
                                lspSess.SyncDoc(spath, snewser);
                            }
                        }
                        sceneCache = snewser;
                    }
                } else if (activeIsDocs) {
                    DocsPage.RenderDocsPage(app, edRect, log);
                } else if (activeIsStart) {
                    startPage.SetRecents(ZanIDE.RecentProjectItems());
                    startPage.SetNews(ZanIDE.StartNews(root));
                    startPage.RenderInside(app, edRect);
                    int sact = startPage.TakeAction();
                    string dropped = startPage.TakeRemovedPath();
                    if (dropped != "") {
                        ZanIDE.RemoveRecentProject(dropped);
                        startPage.SetRecents(ZanIDE.RecentProjectItems());
                        app.RequestRedraw();
                    }
                    if (sact == 1 && dlg == null) {
                        tpls = ZanIDE.BuildCatalog(root);
                        wizTpls = ZanIDE.WizTemplates(tpls);
                        catNames = ZanIDE.CatsOf(tpls);
                        catSel.Set(0);
                        pSel.Set(0);
                        pSizeSeededFor = 0 - 1;
                        pNameInput.SetText("NewProject");
                        pLocInput.SetText(ZanIDE.ReadLastPickerDirectory(ZanIDE.ProjectsHome()));
                        Wizard.notice = "";
                        dlg = App.CreateDark(ZanIDE.T("New Project", "新建项目"), 1180, 680);
                        dlg.ApplySkin(app.ThemeMenuIndex());
                        dlg.Show();
                        dlgMode = 1;
                        app.RequestRedraw();
                    } else if (sact == 2 && dlg == null) {
                        dlg = ZanIDE.OpenWizard(app, ZanIDE.T("New File", "新建文件"), fSel, fNameInput, "NewFile");
                        dlgMode = 2;
                        app.RequestRedraw();
                    } else if (sact == 3) {
                        pathPicker.BeginOpenFileFilters(
                            ZanIDE.ReadLastPickerDirectory(root),
                            ZanIDE.OpenFileFilters(),
                            ZanIDE.T("Open source file", "打开源文件"));
                        pathPickerOwner = 4;
                        app.RequestRedraw();
                    } else if (sact == 4) {
                        pathPicker.BeginFolder(
                            ZanIDE.ReadLastPickerDirectory(root),
                            ZanIDE.T("Open a project folder", "打开项目文件夹"));
                        pathPickerOwner = 10;
                        app.RequestRedraw();
                    } else if (sact >= 200) {
                        string nurl = startPage.NewsLink(sact - 200);
                        if (nurl != "") {
                            if (nurl == "@docs") {
                                int di = ZanIDE.FindTabByPath(tabs, "@docs");
                                if (di < 0) {
                                    tabs.Add(TabRecord.Create(ZanIDE.T("Help", "帮助"), "", "@docs"));
                                    di = tabs.Count - 1;
                                }
                                activeTab.Set(di);
                                lastActive = 0 - 1;
                            } else {
                                ZanIDE.OpenExternal(nurl);
                            }
                            app.RequestRedraw();
                        }
                    } else if (sact >= 100) {
                        string newRoot = startPage.RecentPath(sact - 100);
                        if (newRoot != "") {
                            if (newRoot != root && Directory.Exists(newRoot)) {
                                root = newRoot;
                                haveProject = true;
                                ZanIDE.WriteLastProject(root);
                                this.AdoptSymbolIndex();
                                this.AdoptProjectChats();
                                tabs = new List<TabRecord>();
                                activeTab.Set(0);
                                lastActive = 0 - 1;
                                ZanIDE.OpenFirst(tabs, activeTab, root);
                                rescan = true;
                                log.Add("> Opened project " + root + ".");
                            }
                            app.RequestRedraw();
                        }
                    }
                } else if (act >= 0 && act < tabs.Count
                        && ZanIDE.IsScenePath(tabs[act].path) && codeViewForm == tabs[act].path) {
                    // Code view of the current .zscene: show the strongly-typed
                    // scene code the compiler projects from the design - the
                    // read-only "Designer" half, kept in memory only. The scene
                    // is edited visually; game logic lives in Name.zan.
                    string spC = tabs[act].path;
                    if (formCodeLoaded != spC) {
                        string sTxt = "";
                        if (File.Exists(spC)) {
                            sTxt = ZanIDE.GenSceneFile(ZanIDE.SceneBaseName(spC),
                                SceneDoc.Parse(File.ReadAllText(spC)));
                        }
                        formCodeEd.LoadText(sTxt);
                        formCodeLoaded = spC;
                    }
                    ZanIDE.ApplyEditorTheme(formCodeEd, edThemeIdx, edFontPx);
                    formCodeEd.Render(app, edRect);
                } else if (act >= 0 && act < tabs.Count
                        && ZanIDE.IsFormPath(tabs[act].path) && codeViewForm == tabs[act].path) {
                    // Code view of the current .zform: show the design
                    // document's raw JSON in place (read-only) - the window is
                    // edited visually in the designer, and business logic lives
                    // in the paired Name.zan (2-file model, no generated file).
                    string fpC = tabs[act].path;
                    if (formCodeLoaded != fpC) {
                        string codeTxt = "";
                        if (File.Exists(fpC)) {
                            codeTxt = File.ReadAllText(fpC);
                        }
                        formCodeEd.LoadText(codeTxt);
                        formCodeLoaded = fpC;
                    }
                    ZanIDE.ApplyEditorTheme(formCodeEd, edThemeIdx, edFontPx);
                    formCodeEd.Render(app, edRect);
                } else {
                    // Sync debug vars into editor for hover tooltips
                    if (dbgState == 2) { editor.SetDebugVars(dbgVarInfo); }
                    else { editor.SetDebugVars(new List<DbgVar>()); }
                    ZanIDE.ApplyEditorTheme(editor, edThemeIdx, edFontPx);
                    editor.Render(app, edRect);
                    // Publish live editor state to the AI automation driver
                    // (ZAN_UI_SCRIPT) so scripts can assert buffer/caret and the
                    // completion popup without screen-scraping. Inert otherwise.
                    if (UiDriver.Active()) {
                        UiDriver.SetProbe("editor", ZanIDE.EditorProbeJson(editor));
                        UiDriver.SetProbe("log", string.Join("\n", log));
                    }
                    // Ctrl+click in the editor requests Go to Definition.
                    if (editor.ConsumeGotoRequest()) {
                        if (lspSess == null && !lspTried) {
                            lspTried = true;
                            lspSess = LspSession.Start(root);
                            if (lspSess != null) { log.Add("> zan-lsp connected: semantic navigation enabled."); }
                        }
                        string navW_glc = editor.WordAtCaret();
                        this.RememberTabView();
                        int glc = ZanIDE.GoToDefinitionSmart(lspSess, editor, tabs, activeTab, root, log);
                        this.ApplyGotoResult(glc, navW_glc);
                        app.RequestRedraw();
                    }
                    // Draw inline debug annotations
                    if (dbgState == 2 && dbgExecLine >= 0) {
                        DebugPanel.RenderInlineVars(app, c, t, edRect, dbgVarInfo, dbgExecLine);
                    }
                }

                // ---- reference list ("N references" / Shift+F12) ----
                if (refList.IsOpen() && !designerMode && !sceneMode
                        && !activeIsStart && !activeIsDocs) {
                    // Hangs on the line the list was opened from, following it
                    // as the view scrolls. Not the caret: a click in the code
                    // moves that, and the panel would chase the pointer.
                    refList.Anchor(edRect.x + app.Scale(56),
                        editor.LineBottomY(app, refAnchorLine));
                    int refPick = refList.Render(app, edRect);
                    if (refPick >= 0) { this.GotoReference(refPick); }
                } else if (refList.IsOpen()) {
                    // The list belongs to the code view; a designer or start tab
                    // is not where its rows point.
                    refList.Close();
                }

                // ---- Find / Replace bar (Ctrl+F, Ctrl+R) ----
                if ((findMode == 1 || findMode == 2) && !designerMode && !sceneMode
                        && !activeIsStart && !activeIsDocs) {
                    findBar.Render(app, edRect, editor);
                    if (findBar.CloseRequested()) {
                        findBar.ClearCloseRequest();
                        findMode = 0;
                        app.focus.SetFocused(editor.LastWidgetId());
                        app.RequestRedraw();
                    }
                }

                // ---- GoToLine / breakpoint / rename / in-files overlay ----
                if (findMode > 2 && !designerMode && !sceneMode && !activeIsStart && !activeIsDocs) {
                    int fpH = app.Scale(36);
                    if (findMode == 7) { fpH = app.Scale(68); }
                    int fpW = app.Scale(360);
                    int fpX = edRect.x + edRect.width - fpW - app.Scale(8);
                    int fpY = edRect.y + app.Scale(4);
                    Prompt.Surface(app, fpX, fpY, fpW, fpH, "");
                    int inpX = fpX + app.Scale(8);
                    int inpY = fpY + app.Scale(8);
                    int inpW = fpW - app.Scale(100);
                    int inpH = app.Scale(22);
                    if (findMode == 3) {
                        Prompt.Caption(app, fpX, fpY, ZanIDE.T("Go to Line (Ctrl+G)", "跳转到行 (Ctrl+G)"));
                        Prompt.Field(app, inpX, inpY, inpW, gotoText);
                        int gbX = inpX + inpW + app.Scale(6);
                        int gId = gotoBtn.Render(app, gbX, inpY, app.Scale(30));
                        // Handle key input for goto line
                        if (kind == 6) {
                            int gcc = app.window.EventKeyCode();
                            if (gcc == 8 && gotoText.Length > 0) {
                                gotoText = gotoText.Substring(0, gotoText.Length - 1);
                                app.RequestRedraw();
                            } else if (gcc == 13) {
                                int gLine = ZanIDE.ParseInt(gotoText);
                                if (gLine > 0) { editor.GoToLine(gLine - 1); }
                                findMode = 0;
                                app.RequestRedraw();
                            } else if (gcc >= 48 && gcc <= 57) {
                                gotoText = gotoText + Text.CharStr(gcc);
                                app.RequestRedraw();
                            }
                        }
                        // Click Go button
                        if (Ui.Clicked(app, gId)) {
                            int gLine2 = ZanIDE.ParseInt(gotoText);
                            if (gLine2 > 0) { editor.GoToLine(gLine2 - 1); }
                            findMode = 0;
                            app.RequestRedraw();
                        }
                    } else if (findMode == 4) {
                        Prompt.Caption(app, fpX, fpY, ZanIDE.T("Breakpoint Condition (Ctrl+B) - line ", "断点条件 (Ctrl+B) - 行 ")
                            + Convert.ToString(editor.CurLine() + 1));
                        Prompt.Field(app, inpX, inpY, inpW, bpCondText);
                        if (kind == 6) {
                            int bcc = app.window.EventKeyCode();
                            if (bcc == 8 && bpCondText.Length > 0) {
                                bpCondText = bpCondText.Substring(0, bpCondText.Length - 1);
                                app.RequestRedraw();
                            } else if (bcc == 13) {
                                int bLine = editor.CurLine();
                                ZanIDE.SetCond(bpConds, bLine, bpCondText);
                                if (bpCondText.Length > 0 && !editor.HasBreakpoint(bLine)) {
                                    editor.ToggleBreakpoint(bLine);
                                }
                                if (bpCondText.Length > 0) {
                                    log.Add("> [Debug] Breakpoint condition on line "
                                        + Convert.ToString(bLine + 1) + ": " + bpCondText);
                                } else {
                                    log.Add("> [Debug] Breakpoint condition cleared on line "
                                        + Convert.ToString(bLine + 1) + ".");
                                }
                                findMode = 0;
                                app.RequestRedraw();
                            } else if (bcc > 31) {
                                bpCondText = bpCondText + Text.CharStr(bcc);
                                app.RequestRedraw();
                            }
                        }
                    } else if (findMode == 5) {
                        Prompt.Caption(app, fpX, fpY, ZanIDE.T("Rename Symbol (F2): ", "重命名符号 (F2): ") + renameWord);
                        Prompt.Field(app, inpX, inpY, inpW, renameText);
                        if (kind == 6) {
                            int rcc = app.window.EventKeyCode();
                            if (rcc == 8 && renameText.Length > 0) {
                                renameText = renameText.Substring(0, renameText.Length - 1);
                                app.RequestRedraw();
                            } else if (rcc == 13) {
                                if (lspSess == null && !lspTried) {
                                    lspTried = true;
                                    lspSess = LspSession.Start(root);
                                    if (lspSess != null) { log.Add("> zan-lsp connected: semantic rename enabled."); }
                                }
                                ZanIDE.RenameSymbolSmart(lspSess, editor, tabs, activeTab, log, renameWord, renameText);
                                findMode = 0;
                                app.RequestRedraw();
                            } else if (rcc > 31) {
                                renameText = renameText + Text.CharStr(rcc);
                                app.RequestRedraw();
                            }
                        }
                    } else if (findMode == 6) {
                        Prompt.Caption(app, fpX, fpY, ZanIDE.T("Find in Files (Ctrl+Shift+F)", "在文件中查找 (Ctrl+Shift+F)"));
                        Prompt.Field(app, inpX, inpY, inpW, fifQuery);
                        if (kind == 6) {
                            int qcc = app.window.EventKeyCode();
                            if (qcc == 8 && fifQuery.Length > 0) {
                                fifQuery = fifQuery.Substring(0, fifQuery.Length - 1);
                                app.RequestRedraw();
                            } else if (qcc == 13) {
                                if (fifQuery.Length > 0) {
                                    int act6 = activeTab.Get();
                                    if (act6 >= 0 && act6 < tabs.Count) {
                                        tabs[act6].body = editor.GetText();
                                    }
                                    log.Add("> Find in Files: '" + fifQuery + "'");
                                    ZanIDE.FindInFiles(root, fifQuery, false,
                                        tabs, fifHits, log);
                                    fifSel = 0 - 1;
                                    coLog.Reset();
                                    dock.Focus("output");
                                }
                                findMode = 0;
                                app.RequestRedraw();
                            } else if (qcc > 31) {
                                fifQuery = fifQuery + Text.CharStr(qcc);
                                app.RequestRedraw();
                            }
                        }
                    } else if (findMode == 7) {
                        Prompt.Caption(app, fpX, fpY, ZanIDE.T("Replace in Files (Ctrl+Shift+R)", "在文件中替换 (Ctrl+Shift+R)"));
                        Prompt.Field(app, inpX, inpY, inpW, fifQuery);
                        int rr2Y = inpY + inpH + app.Scale(6);
                        Prompt.Field(app, inpX, rr2Y, inpW, fifRepl);
                        if (kind == 6) {
                            int rfc = app.window.EventKeyCode();
                            if (rfc == 9) {
                                fifReplFocus = !fifReplFocus;
                                app.RequestRedraw();
                            } else if (rfc == 8) {
                                if (fifReplFocus && fifRepl.Length > 0) {
                                    fifRepl = fifRepl.Substring(0, fifRepl.Length - 1);
                                } else if (!fifReplFocus && fifQuery.Length > 0) {
                                    fifQuery = fifQuery.Substring(0, fifQuery.Length - 1);
                                }
                                app.RequestRedraw();
                            } else if (rfc == 13) {
                                if (!fifReplFocus) {
                                    fifReplFocus = true;
                                } else if (fifQuery.Length > 0) {
                                    int act7 = activeTab.Get();
                                    if (act7 >= 0 && act7 < tabs.Count) {
                                        tabs[act7].body = editor.GetText();
                                    }
                                    ZanIDE.ReplaceInFiles(root, fifQuery, fifRepl,
                                        false, tabs, log);
                                    int actR = activeTab.Get();
                                    if (actR >= 0 && actR < tabs.Count) {
                                        int keepR = editor.CurLine();
                                        editor.LoadText(tabs[actR].body);
                                        editor.GoToLine(keepR);
                                    }
                                    coLog.Reset();
                                    dock.Focus("output");
                                    fifReplFocus = false;
                                    findMode = 0;
                                }
                                app.RequestRedraw();
                            } else if (rfc > 31) {
                                if (fifReplFocus) {
                                    fifRepl = fifRepl + Text.CharStr(rfc);
                                } else {
                                    fifQuery = fifQuery + Text.CharStr(rfc);
                                }
                                app.RequestRedraw();
                            }
                        }
                    }
                }

                // ---- Errors panel: the diagnostics of the last build. Its own
                // dock panel, so it stays readable next to (or instead of) the
                // console, and its tab carries the error count.
                // 「帮助与反馈」：本地聚合的错误 + 复制/导出。它和错误面板并列
                // 在底部，但收的是全部来源（含界面层异常与程序崩溃），不只是
                // 这一次编译的诊断。
                this.RenderHelpPanel(app, dock.ContentParked("help"));
                Rect errRect = dock.ContentParked("errors");
                List<DiagnosticRecord> errors = new List<DiagnosticRecord>();
                ZanIDE.ParseErrorList(log, errors);
                string errTitle = ZanIDE.T("Errors", "错误");
                if (errors.Count > 0) {
                    errTitle = errTitle + " (" + Convert.ToString(errors.Count) + ")";
                }
                if (errTitle != dockErrorsTitle) {
                    dock.SetTitle("errors", errTitle);
                    dockErrorsTitle = errTitle;
                }
                OutputPanel.RenderErrorsPanel(app, c, t, errRect, errors, errorList);
                // Error rows are widgets: the ErrorList component records clicks
                // during RenderAt; apply them here.
                if (!coCtxOpen) {
                    DiagnosticRecord efr = errorList.TakeFix();
                    if (efr != null) {
                        ZanIDE.AddUsing(editor, tabs, activeTab,
                            errorList.FixNs(efr), log);
                        app.RequestRedraw();
                    }
                    DiagnosticRecord ejr = errorList.TakeJump();
                    if (ejr != null) {
                        int ejt = ZanIDE.FindTabByBase(
                            tabs, ZanIDE.BaseName(ejr.path));
                        int ejl = ZanIDE.ParseInt(ejr.line);
                        if (ejt >= 0) {
                            activeTab.Set(ejt);
                            lastActive = 0 - 1;
                            pendingGotoLine = ejl - 1;
                            pendingGotoCol = 0;
                        }
                        app.RequestRedraw();
                    }
                }

                if (dbgState == 2) {
                    DebugPanel.RenderDebugBottom(app, c, t, orr, dbgPanelTab,
                        dbgConsole, dbgVarInfo, dbgWatchVals,
                        dbgStack, log, coLog);
                    // The Watch tab's field and grid are widgets: typing,
                    // Enter and the row click happen inside them, and the
                    // shell only learns what the user asked for.
                    string wAdd = DebugPanel.TakeWatchAdd();
                    int wDrop = DebugPanel.TakeWatchDrop();
                    if (wAdd.Length > 0) {
                        dbgWatches.Add(wAdd);
                        dbgWatchVals = ZanIDE.DbgEvalWatches(dbg, dbgWatches);
                        app.RequestRedraw();
                    }
                    if (wDrop >= 0 && wDrop < dbgWatches.Count) {
                        dbgWatches.RemoveAt(wDrop);
                        dbgWatchVals = ZanIDE.DbgEvalWatches(dbg, dbgWatches);
                        app.RequestRedraw();
                    }
                } else {
                    // Which bottom panel the pointer is over -- 0 console,
                    // 1 errors -- so copy/clear act on what was right-clicked.
                    int botTab = 0;
                    if (errRect.Contains(app.mouseX, app.mouseY)) { botTab = 1; }
                    // Build the (optionally) filtered view the console shows. The
                    // real `log` is untouched; selection/copy operate on the view.
                    string coFilterText = coFilter.GetText();
                    List<string> coView = log;
                    if (coFilterText != "") {
                        coView = new List<string>();
                        for (int cvi = 0; cvi < log.Count; cvi = cvi + 1) {
                            if (ZanIDE.Has(log[cvi], coFilterText)) { coView.Add(log[cvi]); }
                        }
                    }
                    int obTabH = t.heightMedium;
                    int coContentY = orr.y + obTabH;
                    int coContentH = orr.height - obTabH;
                    int clearId = OutputPanel.RenderConsolePanel(app, c, t, orr, coView,
                        OutputPanel.ConsoleColors(app, coView), coLog, coFilter);
                    // Clear button empties the real log and resets the view state.
                    if (!coCtxOpen && Ui.Clicked(app, clearId)) {
                        log = new List<string>();
                        coFilter.SetText("");
                        coLog.Reset();
                        app.RequestRedraw();
                    }
                    // Right-click opens the shared context menu (copy
                    // selection / line / all, clear) instead of silently copying.
                    Rect botRect = orr;
                    if (botTab == 1) { botRect = errRect; }
                    if (app.EventKind() == 2 && app.window.EventButton() == 1
                        && botRect.Contains(app.mouseX, app.mouseY)) {
                        coCtxOpen = true;
                        coCtxX = app.mouseX;
                        coCtxY = app.mouseY;
                        if (botTab == 0) {
                            coCtxRow = LogView.RowAt(app, coContentY, coContentH,
                                coView.Count, coLog.scroll, app.mouseY);
                        } else {
                            coCtxRow = (app.mouseY - (errRect.y + app.Scale(6))) / app.Scale(20);
                        }
                        app.RequestRedraw();
                    }
                    if (coCtxOpen) {
                        bool haveSel = botTab == 0 && coLog.HasSelection();
                        List<string> cmi = new List<string>();
                        if (haveSel) {
                            cmi.Add(ZanIDE.T("Copy selection", "复制选中"));
                        }
                        cmi.Add(ZanIDE.T("Copy line", "复制该行"));
                        cmi.Add(ZanIDE.T("Copy all", "复制全部"));
                        cmi.Add(ZanIDE.T("Clear", "清空"));
                        int cmHit = ContextMenu.Render(app, coCtxX, coCtxY, cmi);
                        if (cmHit == 0 - 2) {
                            coCtxOpen = false;
                            app.RequestRedraw();
                        } else if (cmHit >= 0) {
                            int base2 = 0;
                            if (haveSel) { base2 = 1; }
                            string clip = "";
                            if (haveSel && cmHit == 0) {
                                clip = LogView.SelectionText(coView, coLog);
                            } else if (cmHit == base2) {
                                if (botTab == 0) {
                                    if (coCtxRow >= 0 && coCtxRow < coView.Count) {
                                        clip = coView[coCtxRow];
                                    }
                                } else if (coCtxRow >= 0 && coCtxRow < errors.Count) {
                                    DiagnosticRecord error = errors[coCtxRow];
                                    clip = ZanIDE.BaseName(error.path) + ":"
                                        + error.line + "  " + error.msg;
                                }
                            } else if (cmHit == base2 + 1) {
                                if (botTab == 0) {
                                    for (int ci = 0; ci < coView.Count; ci = ci + 1) { clip = clip + coView[ci] + "\n"; }
                                } else {
                                    for (int ci = 0; ci < errors.Count; ci = ci + 1) {
                                        DiagnosticRecord error = errors[ci];
                                        clip = clip + ZanIDE.BaseName(error.path) + ":" + error.line
                                            + "  " + error.msg + "\n";
                                    }
                                }
                            } else {
                                log = new List<string>();
                                coFilter.SetText("");
                                coLog.Reset();
                            }
                            if (clip.Length > 0) {
                                Clipboard.SetText(clip);
                                Layer.Msg(ZanIDE.T("Copied to clipboard", "已复制到剪贴板"), 3);
                            }
                            coCtxOpen = false;
                            app.RequestRedraw();
                        }
                    }
                    // Ctrl+C copies the console selection when the pointer is
                    // over the output panel (the editor keeps its own copy).
                    if (app.EventKind() == 4 && app.window.EventKeyCode() == 67
                        && Modifiers.HasCtrl(app.window.EventMods())
                        && coLog.HasSelection()
                        && orr.Contains(app.mouseX, app.mouseY)) {
                        Clipboard.SetText(LogView.SelectionText(coView, coLog));
                        Layer.Msg(ZanIDE.T("Copied to clipboard", "已复制到剪贴板"), 3);
                        app.RequestRedraw();
                    }
                }

                // ---- AI assistant panel ----
                // The assistant, tools, examples and git are four dock panels of
                // their own; each draws into the rect the dock hands it (parked
                // off-screen while hidden), so any of them can be tabbed
                // together, moved to another side or closed.
                Rect rp = dock.ContentParked("ai");
                int rPad = app.Scale(6);
                // ---- Session sidebar: a vertical, searchable chat list on
                // the left; the header/transcript/input fill the rest. A too-
                // narrow dock drops it so the chat keeps usable width. Session
                // switch/new/delete are all driven from here, then the panel
                // below just renders whatever session is current.
                int aiSideW = app.Scale(154);
                if (aiSideW > rp.width - app.Scale(150)) { aiSideW = 0; }
                if (aiSideW > 0) {
                    List<string> aiTitles = new List<string>();
                    List<int> aiArch = new List<int>();
                    for (int sti = 0; sti < aiSessions.Count; sti = sti + 1) {
                        // A name the user typed wins over the first message,
                        // which is only this panel's guess at the subject.
                        string sTtl = aiSessions[sti].title;
                        if (sTtl == "") {
                            if (sti == aiSessCur) {
                                sTtl = ChatArea.FirstUserOf(aiMsgs);
                            } else {
                                sTtl = ChatArea.ChatTitle(aiSessions[sti].pack);
                            }
                        }
                        if (sTtl == "") {
                            sTtl = ZanIDE.T("New chat ", "新会话 ")
                                + Convert.ToString(sti + 1);
                        }
                        aiTitles.Add(sTtl);
                        aiArch.Add(aiSessions[sti].archived);
                    }
                    SessionListAction sAct = aiSessNav.RenderEx(app,
                        rp.x + rPad, rp.y + rPad, aiSideW - rPad * 2,
                        rp.height - rPad * 2, aiTitles, aiSessCur, aiArch);
                    aiSideRule.Prefer(1, rp.height);
                    aiSideRule.RenderAt(app, rp.x + aiSideW, rp.y);
                    if (aiBusy.Get() == 0 && sAct.archived >= 0
                        && sAct.archived < aiSessions.Count) {
                        // Archive keeps the chat (and its whole context) but
                        // folds it out of the list; clicking again restores it.
                        int sArc = sAct.archived;
                        if (aiSessions[sArc].archived == 0) { aiSessions[sArc].archived = 1; }
                        else { aiSessions[sArc].archived = 0; }
                        SaveAiSessions();
                        Layer.Msg(aiSessions[sArc].archived == 1
                            ? ZanIDE.T("Chat archived", "会话已归档")
                            : ZanIDE.T("Chat restored", "会话已恢复"), 3);
                        app.RequestRedraw();
                    } else if (aiBusy.Get() == 0 && sAct.deleted >= 0) {
                        // Delete drops the whole context of that chat: its
                        // transcript, thinking, task plan and archive flag. The
                        // last remaining chat is emptied rather than removed,
                        // so the panel always has a session to write into.
                        aiSessions[aiSessCur].pack = AiPackCur();
                        int sDel = sAct.deleted;
                        bool sDelActive = sDel == aiSessCur;
                        int sNewCur = aiSessCur;
                        if (aiSessions.Count > 1) {
                            aiSessions.RemoveAt(sDel);
                            if (sDel < aiSessCur) { sNewCur = aiSessCur - 1; }
                            else if (sDel == aiSessCur) {
                                if (sNewCur >= aiSessions.Count) {
                                    sNewCur = aiSessions.Count - 1;
                                }
                            }
                        } else {
                            aiSessions[0].pack = "";
                            aiSessions[0].archived = 0;
                            sNewCur = 0;
                        }
                        aiMsgs = new List<AiChatMsg>();
                        aiPlan = new List<AiPlanStep>();
                        AiRestoreSession(aiSessions[sNewCur].pack);
                        aiSessCur = sNewCur;
                        if (sDelActive) { AiResetContextState(); }
                        aiCacheKey = "";
                        aiCacheSig = "";
                        aiToolOpen = new List<int>();
                        aiScroll.Set(0);
                        // Rows shifted under the list: a rename left open would
                        // land on whichever chat took that index.
                        aiSessNav.CancelRename();
                        SaveAiSessions();
                        Layer.Msg(ZanIDE.T("Chat and its context deleted",
                            "会话及其上下文已删除"), 3);
                        app.RequestRedraw();
                    } else if (sAct.renamed >= 0
                        && sAct.renamed < aiSessions.Count) {
                        // An empty name hands the row back to the derived one.
                        aiSessions[sAct.renamed].title =
                            CodeEditor.TrimStr(sAct.title);
                        SaveAiSessions();
                        app.RequestRedraw();
                    } else if (aiBusy.Get() == 0 && sAct.created) {
                        aiSessions[aiSessCur].pack = AiPackCur();
                        aiSessions.Add(AiSession.Create("", 0));
                        aiMsgs = new List<AiChatMsg>();
                        aiPlan = new List<AiPlanStep>();
                        aiSessCur = aiSessions.Count - 1;
                        AiResetContextState();
                        aiCacheKey = "";
                        aiCacheSig = "";
                        aiToolOpen = new List<int>();
                        aiScroll.Set(0);
                        SaveAiSessions();
                        app.RequestRedraw();
                    } else if (aiBusy.Get() == 0 && sAct.selected >= 0
                        && sAct.selected != aiSessCur) {
                        aiSessions[aiSessCur].pack = AiPackCur();
                        aiMsgs = new List<AiChatMsg>();
                        aiPlan = new List<AiPlanStep>();
                        AiRestoreSession(aiSessions[sAct.selected].pack);
                        aiSessCur = sAct.selected;
                        aiCacheKey = "";
                        aiCacheSig = "";
                        aiToolOpen = new List<int>();
                        aiScroll.Set(0);
                        SaveAiSessions();
                        app.RequestRedraw();
                    }
                    rp = new Rect(rp.x + aiSideW, rp.y,
                        rp.width - aiSideW, rp.height);
                }
                int rInH = app.Scale(30);
                // The chat prompt is a multi-line box (Enter sends,
                // Shift+Enter breaks the line), so it is three rows tall --
                // pasting a stack trace or writing a paragraph no longer
                // scrolls inside a 30px slot. The other panels below keep the
                // one-line row height.
                int aiInH = app.Scale(76);
                // Team mode adds a slim cue row above the prompt that names the
                // member the message is about to go to. Reserving it here (not
                // painting it over the transcript) is what keeps the strip, the
                // transcript and the composer from overlapping.
                int aiCueH = 0;
                if (aiTeamMode) {
                    aiCueH = Tag.Height(app, "") + app.Scale(4);
                }
                int aiInY = rp.y + rp.height - aiInH - rPad;
                int aiCueY = aiInY - aiCueH;
                Rect rBody = new Rect(rp.x, rp.y, rp.width,
                    rp.height - aiInH - aiCueH - rPad * 2);
                int rInY = rp.y + rp.height - rInH - rPad;
                int rBtnW = app.Scale(56);
                int rInW = rp.width - rPad * 3 - rBtnW;
                if (rInW < app.Scale(40)) { rInW = app.Scale(40); }
                {
                    // ---- Header: provider + model switcher + Continue + Config
                    // One dropdown lists every profile's models as
                    // "<provider> / <model>", so two providers offering the same
                    // model id stay distinguishable; picking one switches both
                    // the enabled provider and the chat model for this session.
                    string aiSelSig = "";
                    {
                        for (int pfi = 0; pfi < aiProfiles.Count; pfi = pfi + 1) {
                            AiProfile profile = aiProfiles[pfi];
                            aiSelSig = aiSelSig + profile.name + "~"
                                + profile.model + "~" + profile.models
                                + "~" + profile.limits + ";;";
                        }
                    }
                    if (aiModelSelSig != aiSelSig) {
                        aiModelOptions = new List<ModelOption>();
                        for (int pi = 0; pi < aiProfiles.Count; pi = pi + 1) {
                            AiProfile profile = aiProfiles[pi];
                            string pname = profile.name;
                            List<string> pmods = new List<string>();
                            string defM = profile.model;
                            if (defM != "") { pmods.Add(defM); }
                            List<string> fetched = ZanIDE.SplitList(profile.models);
                            for (int fmi = 0; fmi < fetched.Count; fmi = fmi + 1) {
                                bool dup = false;
                                for (int dk = 0; dk < pmods.Count; dk = dk + 1) {
                                    if (pmods[dk] == fetched[fmi]) { dup = true; }
                                }
                                // Models unticked in AI Settings are kept out
                                // of the picker: a provider lists dozens, a
                                // session uses two.
                                bool hidden = ZanIDE.AiLimitInt(profile.limits,
                                    fetched[fmi], "off") == 1;
                                if (!dup && !hidden) { pmods.Add(fetched[fmi]); }
                            }
                            for (int mj = 0; mj < pmods.Count; mj = mj + 1) {
                                aiModelOptions.Add(ModelOption.Of(pi, pmods[mj],
                                    pname + " / " + pmods[mj]));
                            }
                        }
                        // The settings window can replace profiles between
                        // frames. Normalize the active index before any
                        // preselection dereference, not only below the header.
                        if (aiProfActive < 0 || aiProfActive >= aiProfiles.Count) {
                            aiProfActive = 0;
                        }
                        string activeDefaultModel = "";
                        if (aiProfiles.Count > 0) {
                            AiProfile activeProfile = aiProfiles[aiProfActive];
                            if (activeProfile != null) {
                                activeDefaultModel = activeProfile.model;
                            }
                        }
                        // Preselect the enabled profile's default model.
                        int pre = 0 - 1;
                        for (int oi = 0; oi < aiModelOptions.Count; oi = oi + 1) {
                            ModelOption opt = aiModelOptions[oi];
                            if (opt.profile == aiProfActive
                                && opt.model == activeDefaultModel) {
                                pre = oi; break;
                            }
                        }
                        if (pre < 0 && aiModelOptions.Count > 0) {
                            for (int oj = 0; oj < aiModelOptions.Count; oj = oj + 1) {
                                if (aiModelOptions[oj].profile == aiProfActive) { pre = oj; oj = aiModelOptions.Count; }
                            }
                        }
                        aiModelSel = new Dropdown<ModelOption>(o => o.label);
                        aiModelSel.Hint(ZanIDE.T("Provider / model", "服务商 / 模型"));
                        aiModelSel.Bind(aiModelOptions);
                        if (pre >= 0) { aiModelSel.SelectIndex(pre); }
                        aiModelSelSig = aiSelSig;
                    }
                    // One header row now (the model switcher); sessions moved
                    // to the left sidebar, so the transcript starts right below.
                    int aiRow1Y = rBody.y + app.Scale(4);
                    int aiRow1H = app.Scale(34);
                    int aiHdrH = app.Scale(4) + aiRow1H + app.Scale(8);
                    int aiSmBtnW = app.Scale(52);
                    // D: reserve a square at the far right of the header for the
                    // context-usage ring. Header holds selector + Config + ring:
                    // a chat just keeps following its own context, so there is
                    // no fork / continue to explain away.
                    int aiRingBox = aiRow1H;
                    int aiSelW = rBody.width - rPad * 4 - aiSmBtnW - aiRingBox;
                    if (aiSelW < app.Scale(60)) {
                        // A narrow panel cannot hold the natural sizes: share
                        // the strip instead of letting the buttons run past the
                        // right edge (and over each other).
                        int aiStrip = rBody.width - rPad * 4 - aiRingBox;
                        if (aiStrip < app.Scale(48)) { aiStrip = app.Scale(48); }
                        aiSmBtnW = aiStrip * 34 / 100;
                        if (aiSmBtnW < app.Scale(22)) { aiSmBtnW = app.Scale(22); }
                        aiSelW = aiStrip - aiSmBtnW;
                        if (aiSelW < app.Scale(24)) { aiSelW = app.Scale(24); }
                    }
                    // Same explicit height for the selector and every button so
                    // the header row's controls line up (a select's natural head
                    // height is otherwise shorter than a `small` button).
                    aiModelSel.RenderInside(app, new Rect(rBody.x + rPad, aiRow1Y, aiSelW, aiRow1H));
                    int aiCfgId = aiCfgBtn.RenderIn(app,
                        rBody.x + rPad * 2 + aiSelW, aiRow1Y, aiSmBtnW, aiRow1H);
                    int aiRingR = aiRingBox / 2 - app.Scale(3);
                    int aiRingCx = rBody.x + rBody.width - rPad - aiRingBox / 2;
                    int aiRingCy = aiRow1Y + aiRow1H / 2;
                    AiRenderContextRing(app, aiRingCx, aiRingCy, aiRingR);
                    if (Ui.Clicked(app, aiCfgId)) {
                        if (aiWindow == null || !aiWindow.IsOpen()) {
                            aiWindow = AiSettingsWindow.Open(app, ZanIDE.uiLang);
                        }
                        app.RequestRedraw();
                    }
                    // The provider + model in effect: the dropdown selection
                    // switches the enabled profile too, so the base URL / key
                    // below follow the chosen provider. Falls back to the
                    // enabled profile's default model when nothing is picked.
                    ModelOption selMi = aiModelSel.Selected();
                    if (selMi != null && selMi.profile >= 0
                            && selMi.profile < aiProfiles.Count) {
                        aiProfActive = selMi.profile;
                    }
                    // aiProfActive 可能在删改配置后落到越界值；越界索引会返回
                    // null，随后 .model/.limits 解引用崩溃。先夹取到有效范围，
                    // 空列表时用安全默认，避免把悬空/空串喂给 AiLimitInt。
                    if (aiProfActive < 0 || aiProfActive >= aiProfiles.Count) {
                        aiProfActive = 0;
                    }
                    string chatModel = "";
                    string aiLimMap = "";
                    if (aiProfiles.Count > 0) {
                        AiProfile aiProf = aiProfiles[aiProfActive];
                        if (aiProf != null) {
                            chatModel = aiProf.model;
                            aiLimMap = aiProf.limits;
                            // Which model each member runs on, taken from the
                            // provider in effect: reading it here means switching
                            // provider (or saving the settings dialog) moves the
                            // whole team with it.
                            AiTeam.SetModels(aiProf.roles);
                        }
                    }
                    if (selMi != null) { chatModel = selMi.model; }
                    // Feed the enabled model's configured context / output limits
                    // to the agent layer, so context compaction, the usage ring
                    // and the request's max_tokens all follow this model. An
                    // unconfigured model uses the default context length.
                    int aiCtxTok = ZanIDE.AiLimitInt(aiLimMap, chatModel, "ctx");
                    if (aiCtxTok <= 0) { aiCtxTok = AiAgent.DefaultCtxTokens(); }
                    AiAgent.SetLimits(aiCtxTok,
                        ZanIDE.AiLimitInt(aiLimMap, chatModel, "out"));
                    // The team strip owns the single/team switch, so the mode is
                    // always one click away and the panel always says which one
                    // it is in.
                    int aiTeamH = TeamBoard.Height(app, aiTeamMode,
                        aiTeamOpen.Get() == 1, aiTasks.Count, rBody.width);
                    bool aiTeamWas = aiTeamMode;
                    aiTeamMode = TeamBoard.Render(app,
                        new Rect(rBody.x, rBody.y + aiHdrH, rBody.width,
                            aiTeamH),
                        aiTeamMode, aiBusy.Get() == 1, aiTeamSt, aiTasks,
                        aiTeamOpen);
                    if (aiTeamMode != aiTeamWas) {
                        // Switching modes changes who every name row belongs to,
                        // so the wrapped transcript has to be rebuilt.
                        aiCacheKey = "";
                        if (!aiTeamMode) { aiRunAgent = ""; }
                        app.RequestRedraw();
                    }
                    int aiPlanH = AiPlanHeight(app);
                    if (aiPlanH > 0) {
                        AiRenderPlan(app,
                            new Rect(rBody.x, rBody.y + aiHdrH + aiTeamH,
                            rBody.width, aiPlanH));
                    }
                    Rect aiChat = new Rect(rBody.x,
                        rBody.y + aiHdrH + aiTeamH + aiPlanH,
                        rBody.width,
                        rBody.height - aiHdrH - aiTeamH - aiPlanH);
                    // Wheel-scroll the transcript (lines up from the bottom).
                    bool ownsAiWheel = app.CaptureWheel(aiChat.x, aiChat.y, aiChat.width, aiChat.height);
                    if (ownsAiWheel) {
                        int awd = app.window.EventKeyCode();
                        int awstep = awd / 120;
                        if (awstep == 0) {
                            if (awd > 0) { awstep = 1; }
                            else if (awd < 0) { awstep = 0 - 1; }
                        }
                        aiScroll.Set(aiScroll.Get() + awstep);
                        app.RequestRedraw();
                    }
                    // Rebuild the wrapped/markdown line cache only when the
                    // transcript or width changed (rewrapping per frame is slow).
                    int aiTextW = aiChat.width - app.Scale(28);
                    if (aiTextW < app.Scale(20)) { aiTextW = app.Scale(20); }
                    int aiTailLen = 0;
                    if (aiMsgs.Count > 0) {
                        aiTailLen = aiMsgs[aiMsgs.Count - 1].text.Length
                            + aiMsgs[aiMsgs.Count - 1].reason.Length;
                    }
                    int aiToolSig = aiToolOpen.Count;
                    for (int aiTsi = 0; aiTsi < aiToolOpen.Count; aiTsi = aiTsi + 1) {
                        aiToolSig = aiToolSig * 131 + aiToolOpen[aiTsi] + 1;
                    }
                    // Layout inputs: any change here invalidates every wrapped
                    // line, so the whole transcript has to be rebuilt.
                    string aiLayoutSig = Convert.ToString(aiTextW)
                        + ":" + Convert.ToString(edFontPx)
                        + ":" + Convert.ToString(aiThinkOpen.Get())
                        + ":" + Convert.ToString(aiToolSig);
                    string aiKeyNow = aiLayoutSig + ":"
                        + Convert.ToString(aiMsgs.Count) + ":"
                        + Convert.ToString(aiTailLen);
                    if (aiKeyNow != aiCacheKey) {
                        // Only the streaming (last) turn grows from frame to
                        // frame. Keeping the settled turns' wrapped lines and
                        // re-wrapping just the tail keeps a 1000-turn chat as
                        // cheap to stream into as an empty one -- rebuilding
                        // everything each frame is what made long chats crawl.
                        bool aiFull = aiLayoutSig != aiCacheSig
                            || aiMsgs.Count < aiCacheTurns + 1
                            || aiCacheLines.Count < aiCachePrefix;
                        int aiStable = aiMsgs.Count - 1;
                        if (aiStable < 0) { aiStable = 0; }
                        if (aiFull) {
                            aiCacheLines = new List<TextRun>();
                            aiCacheTurns = 0;
                            aiCachePrefix = 0;
                            aiCacheSig = aiLayoutSig;
                            // Rewrapping remaps every line index, so a stale
                            // selection would highlight the wrong text.
                            aiChatSel.ClearSelection();
                        } else {
                            while (aiCacheLines.Count > aiCachePrefix) {
                                int aiLast = aiCacheLines.Count - 1;
                                aiCacheLines.RemoveAt(aiLast);
                            }
                        }
                        if (aiCacheTurns < aiStable) {
                            ChatArea.ChatBuildRange(app, aiMsgs,
                                aiCacheTurns, aiStable, aiTextW,
                                aiThinkOpen.Get() == 1, aiToolOpen,
                                aiCacheLines);
                            aiCacheTurns = aiStable;
                            aiCachePrefix = aiCacheLines.Count;
                        }
                        ChatArea.ChatBuildRange(app, aiMsgs,
                            aiStable, aiMsgs.Count, aiTextW,
                            aiThinkOpen.Get() == 1, aiToolOpen,
                            aiCacheLines);
                        aiCacheKey = aiKeyNow;
                    }
                    int aiMax = ChatArea.RenderChatArea(app, aiChat,
                        aiCacheLines,
                        aiToolOpen, aiScroll.Get(), aiBusy.Get() == 1,
                        aiChatSel, true, aiThinkOpen);
                    if (aiScroll.Get() > aiMax) { aiScroll.Set(aiMax); }
                    if (aiScroll.Get() < 0) { aiScroll.Set(0); }
                    // Ctrl+C copies the selected transcript text when the
                    // pointer is over the chat (like the console output panel).
                    if (app.EventKind() == 4 && app.window.EventKeyCode() == 67
                        && Modifiers.HasCtrl(app.window.EventMods())
                        && aiChatSel.HasSelection()
                        && aiChat.Contains(app.mouseX, app.mouseY)) {
                        Clipboard.SetText(ChatArea.SelectionText(aiCacheLines, aiChatSel));
                        Layer.Msg(ZanIDE.T("Copied to clipboard", "已复制到剪贴板"), 3);
                        app.RequestRedraw();
                    }
                    // "Insert code" / "Replace file": apply the last AI code
                    // block at the editor cursor, or as the whole file.
                    string aiCode = ZanIDE.AiLastCode(aiMsgs);
                    bool aiCanApply = aiCode != "" && act >= 0 && act < tabs.Count
                        && !designerMode && tabs[act].path != ""
                        && tabs[act].path.Substring(0, 1) != "@";
                    if (aiCanApply) {
                        int abW = app.Scale(110);
                        int abH = aiApplyBtn.AutoHeight(app);
                        int abId = aiApplyBtn.Render(app,
                            rp.x + rp.width - abW - rPad,
                            rBody.y + rBody.height - abH - rPad, abW);
                        if (Ui.Clicked(app, abId)) {
                            editor.InsertBlock(aiCode);
                            tabs[act].body = editor.GetText();
                            log.Add(ZanIDE.T("> Inserted AI code into ", "> 已将 AI 代码插入 ")
                                + tabs[act].path + ".");
                            app.RequestRedraw();
                        }
                        int rbId = aiReplaceBtn.Render(app,
                            rp.x + rp.width - abW * 2 - rPad * 2,
                            rBody.y + rBody.height - abH - rPad, abW);
                        if (Ui.Clicked(app, rbId)) {
                            editor.LoadText(aiCode);
                            tabs[act].body = aiCode;
                            log.Add(ZanIDE.T("> Replaced ", "> 已用 AI 代码替换 ")
                                + tabs[act].path + ZanIDE.T(" with AI code.", "。"));
                            app.RequestRedraw();
                        }
                    }
                    // Input row: an [Auto] toggle, the prompt box and Send --
                    // or, while a write / build / run waits, an Approve /
                    // Reject bar. Auto-execute OFF means every action tool asks
                    // first; ON lets the loop edit, build and run on its own.
                    aiAutoBtn.Text = aiAutoExec ? ZanIDE.T("Auto: on", "自动:开")
                        : ZanIDE.T("Auto: off", "自动:关");
                    aiAutoBtn.Class = aiAutoExec ? "primary small" : "small";
                    int aiAutoW = app.Scale(84);
                    // The prompt box is three rows tall and the buttons beside it
                    // are one, so they are centred on it: top-aligning a 30px
                    // button against a 76px box is the misalignment the user saw
                    // along the bottom of the panel.
                    int aiBtnH = aiAutoBtn.AutoHeight(app);
                    int aiBtnY = aiInY + (aiInH - aiBtnH) / 2;
                    // Narrow panel: the toggle gives up its label width before it
                    // starts pushing the prompt box off the right edge.
                    if (aiAutoW > rInW - app.Scale(60)) {
                        aiAutoW = rInW - app.Scale(60);
                        if (aiAutoW < app.Scale(30)) { aiAutoW = app.Scale(30); }
                        aiAutoBtn.Text = aiAutoExec ? ZanIDE.T("A:on", "自:开")
                            : ZanIDE.T("A:off", "自:关");
                    }
                    // Team mode: say who Send will address, and let that be
                    // picked. The recipient is state (aiSendTo), not text in the
                    // prompt, so the box holds only what the user wrote and
                    // exactly one member is addressed. Empty = let the context
                    // decide, shown as the member it currently resolves to.
                    if (aiTeamMode && aiCueH > 0) {
                        string cueId = aiSendTo;
                        bool cueAuto = cueId == "";
                        if (cueAuto) {
                            cueId = AiTeam.RouteUserSt(aiInput.GetText(), aiMsgs,
                                aiTeamSt);
                        }
                        string cueName = AiTeam.DisplayName(cueId);
                        string cueCls = AiTeam.RoleTagClass(cueId);
                        if (cueAuto) {
                            cueName = cueName + ZanIDE.T(" (auto)", "（自动）");
                        }
                        string cueLab = ZanIDE.T("Sending to", "将发给");
                        int cueFs = app.theme.fontSizeSmall;
                        int cueX = rp.x + rPad;
                        int cueTx = cueX;
                        aiCueLbl.Text = cueLab;
                        aiCueLbl.RenderAt(app, cueTx,
                            aiCueY + (aiCueH - Canvas.FontHeight(cueFs)) / 2);
                        cueTx = cueTx + Canvas.MeasureText(cueLab, cueFs)
                            + app.Scale(6);
                        int cueChipW = 0;
                        if (cueName != ""
                            && cueTx + Tag.Width(app, cueName, cueCls)
                                <= rp.x + rp.width - rPad) {
                            cueChipW = Tag.Width(app, cueName, cueCls);
                            Tag.Chip(app, cueTx,
                                aiCueY + (aiCueH - Tag.Height(app, cueCls)) / 2,
                                cueName, cueCls);
                        }
                        // The caret says the row opens, and the whole row (label
                        // + chip + caret) is the hit target: a 10px glyph is not
                        // something to have to aim at.
                        int cueCarX = cueTx + cueChipW + app.Scale(3);
                        aiCueCaret.RenderAt(app, cueCarX,
                            aiCueY + (aiCueH - Canvas.FontHeight(cueFs)) / 2);
                        int cueW = cueCarX + Canvas.MeasureText("▾", cueFs) - cueX;
                        int cueHid = app.focus.AllocId();
                        app.hitTester.Register(new HitRegion(cueHid, cueX,
                            aiCueY, cueW, aiCueH, 1));
                        bool cueOpened = false;
                        if (Ui.Clicked(app, cueHid)) {
                            aiCueOpen = !aiCueOpen;
                            cueOpened = aiCueOpen;
                            app.RequestRedraw();
                        }
                        // The menu waits for the next frame: the click that
                        // opened it is still the frame's click, and the menu
                        // would read it as the outside click that dismisses it.
                        if (aiCueOpen && !cueOpened) {
                            List<string> cueOpts = new List<string>();
                            List<string> cueIds = new List<string>();
                            cueOpts.Add(ZanIDE.T("Auto (by context)", "自动（按上下文）"));
                            cueIds.Add("");
                            List<AiRole> cueRs = AiTeam.Roles();
                            for (int cri = 0; cri < cueRs.Count; cri = cri + 1) {
                                cueOpts.Add(AiTeam.DisplayName(cueRs[cri].id));
                                cueIds.Add(cueRs[cri].id);
                            }
                            // Opens upward, sitting on the row: below it is the
                            // prompt box and the window edge, and leaving that
                            // to the clamp parks the list over the composer.
                            int cuePick = ContextMenu.Render(app, cueX,
                                aiCueY - ContextMenu.Height(app, cueOpts),
                                cueOpts);
                            if (cuePick >= 0 && cuePick < cueIds.Count) {
                                aiSendTo = cueIds[cuePick];
                                aiCueOpen = false;
                                app.RequestRedraw();
                            } else if (cuePick == 0 - 2) {
                                aiCueOpen = false;
                                app.RequestRedraw();
                            }
                        }
                    }
                    int aiAutoId = aiAutoBtn.Render(app, rp.x + rPad, aiBtnY,
                        aiAutoW);
                    // What the toggle actually decides is who gets to run the
                    // action tools, so say that instead of leaving an
                    // unexplained "Auto" in front of the prompt.
                    string aiAutoTip = ZanIDE.T(
                        "Auto-execute action tools.\n"
                        + "OFF: the assistant asks you to approve every"
                        + " write_file / edit_file / build / run / ui_check /"
                        + " ui_tree / diff / run_errors.\n"
                        + "ON: it edits, builds and runs on its own, and keeps"
                        + " working through the task plan without waiting.",
                        "自动执行操作类工具。\n"
                        + "关：写文件 / 改文件 / 构建 / 运行 / UI 检查"
                        + "每次都要你点“批准”。\n"
                        + "开：助手自行修改、构建、运行，并按任务计划持续推进。");
                    if (app.mouseX >= rp.x + rPad
                        && app.mouseX <= rp.x + rPad + aiAutoW
                        && app.mouseY >= aiBtnY && app.mouseY <= aiBtnY + aiBtnH) {
                        Tooltip.RequestBox(app, rp.x + rPad, aiBtnY, aiAutoW,
                            aiBtnH, aiAutoTip, Tooltip.Top(), app.Scale(320));
                    }
                    if (Ui.Clicked(app, aiAutoId)) {
                        aiAutoExec = !aiAutoExec;
                        app.RequestRedraw();
                    }
                    if (aiBusy.Get() == 2) {
                        // Confirm bar: show the parked action and let the user
                        // Approve (run it) or Reject (tell the model to try
                        // something else). Nothing ran while it waited here.
                        string pdesc = ZanIDE.T("Run ", "执行 ")
                            + AiAgent.Describe(aiPendingCall) + " ?";
                        int pdW = rp.width - rPad * 4 - aiAutoW - rBtnW * 2;
                        if (pdW < app.Scale(40)) { pdW = app.Scale(40); }
                        aiPendLbl.Text = pdesc;
                        aiPendLbl.RenderAt(app, rp.x + rPad * 2 + aiAutoW,
                            aiBtnY + (aiBtnH
                                - Canvas.FontHeight(app.theme.fontSizeSmall)) / 2,
                            pdW);
                        int rjId = aiRejectBtn.Render(app,
                            rp.x + rp.width - rBtnW * 2 - rPad * 2, aiBtnY,
                            rBtnW);
                        int apId = aiApproveBtn.Render(app,
                            rp.x + rp.width - rBtnW - rPad, aiBtnY, rBtnW);
                        if (Ui.Clicked(app, apId)) {
                            string capC = aiPendingCall;
                            aiPendingCall = "";
                            aiBusy.Set(1);
                            AiDispatchTool(capC);
                            aiScroll.Set(0);
                            app.RequestRedraw();
                        }
                        if (Ui.Clicked(app, rjId)) {
                            string capR = aiPendingCall;
                            aiPendingCall = "";
                            aiMsgs.Add(AiChatMsg.Create("tool",
                                AiAgent.Describe(capR) + "\n"
                                + "user declined this action; do not repeat it --"
                                + " propose an alternative or ask what to do instead."));
                            string rerr = ZanIDE.AiLaunchAs(aiRunAgent, aiMsgs, aiRunCtxName,
                                aiRunCtxCode, root, aiProfiles[aiProfActive].baseUrl,
                                aiProfiles[aiProfActive].key, aiRunModel);
                            if (rerr != "") {
                                aiMsgs.Add(AiChatMsg.Create("error", rerr));
                                aiBusy.Set(0);
                            } else { aiBusy.Set(1); }
                            aiScroll.Set(0);
                            app.RequestRedraw();
                        }
                    } else {
                    int aiInpX = rp.x + rPad * 2 + aiAutoW;
                    int aiInpW = rInW - aiAutoW - rPad;
                    if (aiInpW < app.Scale(40)) { aiInpW = app.Scale(40); }
                    // No mention picker: an @name is typed like any other word
                    // and the cue row above the box already says who Send will
                    // reach, so a popup that eats Up / Down / Enter / Tab / Esc
                    // buys nothing.
                    int aiInpId = aiInput.Render(app, aiInpX, aiInY, aiInpW, aiInH);
                    // While a request (or an auto-continued tool loop) is in
                    // flight, Send becomes Stop: it abandons the streaming
                    // child and clears the continuation budget, so a task that
                    // is going the wrong way can be interrupted.
                    if (aiBusy.Get() != 0) {
                        int stopId = aiStopBtn.Render(app,
                            rp.x + rPad * 2 + rInW, aiBtnY, rBtnW);
                        if (Ui.Clicked(app, stopId)) {
                            ZanIDE.AiCancelRequest();
                            this.AiRunStopped();
                            aiBusy.Set(0);
                            aiAutoCont = AiAgent.MaxContinues();
                            aiRetry = AiAgent.MaxRetries();
                            aiPendingCall = "";
                            aiMsgs.Add(AiChatMsg.Create("error",
                                ZanIDE.T("[stopped] Interrupted by you.",
                                    "[已停止] 任务被你中断。")));
                            aiCacheKey = "";
                            aiCacheSig = "";
                            app.RequestRedraw();
                        }
                    }
                    int sendId = 0 - 1;
                    if (aiBusy.Get() == 0) {
                        sendId = aiSendBtn.Render(app,
                            rp.x + rPad * 2 + rInW, aiBtnY, rBtnW);
                    }
                    bool doSend = sendId >= 0 && Ui.Clicked(app, sendId);
                    // Enter sends, Shift+Enter is a newline. The box handles
                    // the key itself (it is a real multi-line editor), so the
                    // newline it just inserted is trimmed back off below.
                    if (!doSend && app.EventKind() == 6
                        && app.window.EventKeyCode() == 13
                        && !Modifiers.HasShift(app.window.EventMods())
                        && app.focus.IsFocused(aiInpId)) {
                        doSend = true;
                    }
                    if (doSend && aiBusy.Get() == 0) {
                        string q = AiAgent.Trim(aiInput.GetText());
                        aiInput.SetText("");
                        // An @name that is nobody on the team is a typo, and
                        // delivering the message to the default recipient
                        // instead is how a question reached the wrong member
                        // silently. Say so and keep the text so it can be fixed.
                        string badAt = "";
                        if (aiTeamMode && q != "") {
                            badAt = AiTeam.UnknownMention(q);
                        }
                        if (badAt != "") {
                            aiInput.SetText(q);
                            aiMsgs.Add(AiChatMsg.Create("error", ZanIDE.T(
                                "[error] Nobody on the team is called @" + badAt
                                    + ". Members: " + AiTeam.NameList() + ".",
                                "[错误] 团队里没有 @" + badAt + " 这个成员。可用成员："
                                    + AiTeam.NameList() + "。")));
                            aiScroll.Set(0);
                            q = "";
                        }
                        if (q != "") {
                            // Team mode: the member picked in the cue row is the
                            // address and wins; on "auto" a parked question is
                            // answered by whoever asked it, so "continue"
                            // resumes the stage it stopped in instead of
                            // restarting the pipeline, and otherwise the member
                            // that spoke last takes it.
                            string tgt = "";
                            if (aiTeamMode) {
                                if (aiSendTo != "") { tgt = aiSendTo; }
                                else { tgt = AiTeam.RouteUserSt(q, aiMsgs, aiTeamSt); }
                                aiTeamSt.awaitingUser = false;
                                aiTeamSt.askedBy = "";
                            }
                            aiRunAgent = tgt;
                            AiChatMsg umsg = AiChatMsg.Create("user", q);
                            umsg.to = tgt;
                            aiMsgs.Add(umsg);
                            // 这句话推进十二拍状态机：新需求开一次交付，停在
                            // 「用户确认」那一拍的老交付被它放行。
                            this.AiRunUserTurn(q);
                            // A fresh question restarts every automatic loop,
                            // including the handoff chain's budget.
                            aiRetry = 0;
                            aiAutoCont = 0;
                            aiHandoffs = 0;
                            // Attach the active file as context so the AI can
                            // help with the code actually on screen.
                            string aiCtxName = "";
                            string aiCtxCode = "";
                            if (act >= 0 && act < tabs.Count && tabs[act].body != ""
                                && tabs[act].body.Substring(0, 1) != "@") {
                                aiCtxName = Path.GetFileName(tabs[act].path);
                                if (ZanIDE.IsFormPath(tabs[act].path)) { aiCtxCode = tabs[act].body; }
                                else { aiCtxCode = editor.GetText(); }
                            }
                            aiRunModel = chatModel;
                            aiRunCtxName = aiCtxName;
                            aiRunCtxCode = aiCtxCode;
                            string aerr = ZanIDE.AiLaunchAs(aiRunAgent, aiMsgs,
                                aiCtxName, aiCtxCode, root,
                                aiProfiles[aiProfActive].baseUrl, aiProfiles[aiProfActive].key, chatModel);
                            if (aerr != "") {
                                aiMsgs.Add(AiChatMsg.Create("error", aerr));
                            } else {
                                aiBusy.Set(1);
                            }
                            aiScroll.Set(0);
                            app.RequestRedraw();
                        }
                    }
                    }
                    // Files dragged from the file manager onto the panel are
                    // appended to the prompt as project-relative paths; the
                    // assistant reads them with its read_file tool instead of
                    // us pasting (possibly huge, possibly binary) contents in.
                    if (app.EventKind() == 9) {
                        List<string> drops = app.window.TakeDroppedFiles();
                        int dqx = app.window.EventX();
                        int dqy = app.window.EventY();
                        if (drops.Count > 0 && dqx >= rp.x && dqx < rp.x + rp.width
                            && dqy >= rp.y && dqy < rp.y + rp.height) {
                            string add = "";
                            for (int di = 0; di < drops.Count; di = di + 1) {
                                add = add + " " + AiDropRef(drops[di], root);
                            }
                            string cur = aiInput.GetText();
                            if (cur != "" && cur.Substring(cur.Length - 1, 1) != " ") {
                                cur = cur + " ";
                            }
                            aiInput.SetText(cur + AiAgent.Trim(add) + " ");
                            app.RequestRedraw();
                        }
                    }
                    // Last thing in the panel: the context / usage card the
                    // ring opens, so it sits above the chat and the prompt.
                    AiRenderUsageCard(app);
                }
                {
                    // ---- Git panel: repository status + stage / commit / sync ----
                    Rect gArea = dock.ContentParked("git");
                    int gPad = app.Scale(6);
                    if (!gitLoaded && gitJob == 0 && Directory.Exists(root + "/.git")) {
                        ZanIDE.GitRefreshBegin(root);
                        gitJob = 1;
                        app.RequestAnimationFrame(120);
                    }
                    bool gitRepo = Directory.Exists(root + "/.git");
                    int gy = gArea.y + gPad;
                    if (!gitRepo) {
                        gitNoRepoLbl.RenderAt(app, gArea.x + gPad, gy,
                            gArea.width - gPad * 2);
                        int giId = new Button { Text = ZanIDE.T("Initialize repository", "初始化仓库"), Class = "primary small" }.Render(app, gArea.x + gPad, gy + app.Scale(24), app.Scale(150));
                        if (Ui.Clicked(app, giId)) {
                            if (gitJob == 0) {
                                ZanIDE.GitBegin(root, "init");
                                gitJob = 2;
                                log.Add(ZanIDE.T("> git init ...", "> 正在初始化 git 仓库 ..."));
                            }
                            app.RequestRedraw();
                        }
                    } else {
                        // Header: current branch + change count, then two rows
                        // of actions (all git commands echo into Output).
                        gitBranchLbl.Text = ZanIDE.T("Branch: ", "分支：")
                            + gitBranch + "   ("
                            + Convert.ToString(gitFiles.Count)
                            + ZanIDE.T(" changes", " 处变更") + ")";
                        gitBranchLbl.RenderAt(app, gArea.x + gPad,
                            gy + app.Scale(4), gArea.width - gPad * 2);
                        int gBtnW = (gArea.width - gPad * 4) / 3;
                        if (gBtnW < app.Scale(50)) { gBtnW = app.Scale(50); }
                        int gRow1 = gy + app.Scale(22);
                        int gRefId = new Button { Text = ZanIDE.T("Refresh", "刷新"), Class = "small" }
                            .Render(app, gArea.x + gPad, gRow1, gBtnW);
                        int gStgId = new Button { Text = ZanIDE.T("Stage all", "暂存全部"), Class = "small" }
                            .Render(app, gArea.x + gPad * 2 + gBtnW, gRow1, gBtnW);
                        int gDifId = new Button { Text = ZanIDE.T("Diff", "差异"), Class = "small" }
                            .Render(app, gArea.x + gPad * 3 + gBtnW * 2, gRow1, gBtnW);
                        int gRow2 = gRow1 + app.Scale(28);
                        int gLogId = new Button { Text = ZanIDE.T("History", "历史"), Class = "small" }
                            .Render(app, gArea.x + gPad, gRow2, gBtnW);
                        int gPulId = new Button { Text = ZanIDE.T("Pull", "拉取"), Class = "small" }
                            .Render(app, gArea.x + gPad * 2 + gBtnW, gRow2, gBtnW);
                        int gPshId = new Button { Text = ZanIDE.T("Push", "推送"), Class = "small" }
                            .Render(app, gArea.x + gPad * 3 + gBtnW * 2, gRow2, gBtnW);
                        if (Ui.Clicked(app, gRefId)) {
                            gitLoaded = false;
                            app.RequestRedraw();
                        }
                        if (Ui.Clicked(app, gStgId)) {
                            if (gitJob == 0) {
                                ZanIDE.GitBegin(root, "add -A");
                                gitJob = 2;
                                log.Add(ZanIDE.T("> Staging all changes ...", "> 正在暂存全部变更 ..."));
                            }
                            dock.Focus("output");
                            app.RequestRedraw();
                        }
                        if (Ui.Clicked(app, gDifId)) {
                            int gsv = gitSel.Get();
                            string gtgt = "";
                            if (gsv >= 0 && gsv < gitFiles.Count) {
                                gtgt = " -- \"" + ZanIDE.GitPathOf(gitFiles[gsv]) + "\"";
                            }
                            if (gitJob == 0) {
                                ZanIDE.GitBegin(root, "diff HEAD" + gtgt);
                                gitJob = 2;
                                log.Add("> git diff HEAD" + gtgt + " ...");
                            }
                            dock.Focus("output");
                            coLog.Reset();
                            app.RequestRedraw();
                        }
                        if (Ui.Clicked(app, gLogId)) {
                            if (gitJob == 0) {
                                ZanIDE.GitBegin(root, "log --oneline --decorate -20");
                                gitJob = 2;
                                log.Add("> git log ...");
                            }
                            dock.Focus("output");
                            coLog.Reset();
                            app.RequestRedraw();
                        }
                        if (Ui.Clicked(app, gPulId)) {
                            if (gitJob == 0) {
                                log.Add("> git pull ...");
                                ZanIDE.GitBegin(root, "pull");
                                gitJob = 2;
                            }
                            dock.Focus("output");
                            app.RequestRedraw();
                        }
                        if (Ui.Clicked(app, gPshId)) {
                            if (gitJob == 0) {
                                log.Add("> git push ...");
                                ZanIDE.GitBegin(root, "push");
                                gitJob = 2;
                            }
                            dock.Focus("output");
                            app.RequestRedraw();
                        }
                        // Changed-file list (porcelain "XY path" rows): click
                        // selects, double-click opens the file in the editor.
                        int gListY = gRow2 + app.Scale(30);
                        int gListH = rInY - gPad - gListY;
                        gitList.Bind(gitFiles);
                        gitList.Refresh();
                        gitList.SelectIndex(gitSel.Get());
                        gitList.RenderInside(app, new Rect(
                            gArea.x + gPad, gListY,
                            gArea.width - gPad * 2, gListH));
                        gitSel.Set(gitList.SelectedIndex());
                        // Bottom row: commit message + Commit (stages nothing
                        // itself; commits what is already staged, falling back
                        // to `commit -a` when nothing is staged yet).
                        gitMsgIn.Render(app, rp.x + rPad, rInY, rInW, rInH);
                        int gCmtId = new Button { Text = ZanIDE.T("Commit", "提交"), Class = "primary small" }
                            .Render(app, rp.x + rPad * 2 + rInW, rInY + app.Scale(2), rBtnW);
                        if (Ui.Clicked(app, gCmtId)) {
                            string gMsg = gitMsgIn.GetText();
                            if (gMsg == "") {
                                log.Add(ZanIDE.T("> Enter a commit message first.",
                                    "> 请先输入提交信息。"));
                            } else {
                                gMsg = ZanIDE.GitEscape(gMsg);
                                if (gitJob == 0) {
                                    ZanIDE.GitBegin(root,
                                        "diff --cached --quiet && git -C \"" + root
                                        + "\" commit -a -m \"" + gMsg
                                        + "\" || git -C \"" + root + "\" commit -m \"" + gMsg + "\"");
                                    gitJob = 2;
                                    log.Add("> git commit ...");
                                    gitMsgIn.SetText("");
                                }
                            }
                            dock.Focus("output");
                            app.RequestRedraw();
                        }
                    }
                }
                // ---- Tools and Examples panels: a tree each, both owning their
                // filter row, scrolling and selection. A double-click RUNS a
                // tool (tools are Zan code) or opens an example's source in the
                // editor; a right-click raises the panel's context menu.
                if (toolsTv == null) {
                    toolsTv = new TreeView();
                    toolsTv.BindSel(rtToolSel).WithFilter(rtToolFilter);
                    toolsTv.EmptyText(ZanIDE.T("No files found in ", "没有找到文件：")
                        + ZanIDE.BaseDir() + "/tools");
                    toolsTv.OnActivate(ZanIDE.ToolActivated);
                    toolsTv.OnContext(ZanIDE.ToolContext);
                    examplesTv = new TreeView();
                    examplesTv.BindSel(rtExSel).WithFilter(rtExFilter);
                    examplesTv.EmptyText(ZanIDE.T("No examples found.", "没有找到示例。"));
                    examplesTv.OnActivate(ZanIDE.ExampleActivated);
                    examplesTv.OnContext(ZanIDE.ExampleContext);
                }
                Rect toolsArea = dock.ContentParked("tools");
                toolsTv.Bind(ZanIDE.FilterNodes(rtToolTree, rtToolFilter.GetText()));
                toolsTv.RenderInside(app, toolsArea);
                Rect exsArea = dock.ContentParked("examples");
                examplesTv.Bind(ZanIDE.FilterNodes(rtExTree, rtExFilter.GetText()));
                examplesTv.RenderInside(app, exsArea);
                // Stream new shell output from a launched program into the
                // Output tab. Poll on the throttled animation clock so a live
                // session doesn't spin the CPU but output appears promptly.
                if (termFp != 0) {
                    int consumed2 = ZanIDE.TermPoll(termLogLen, log);
                    if (consumed2 != termLogLen) {
                        termLogLen = consumed2;
                        coLog.Reset();
                        app.RequestRedraw();
                    }
                    app.RequestAnimationFrame(250);
                }
                // Mirror a launched console program's output into the Output tab.
                if (runStreaming) {
                    int rconsumed = ZanIDE.RunPoll(runLogLen, log);
                    if (rconsumed != runLogLen) {
                        runLogLen = rconsumed;
                        coLog.Reset();
                        app.RequestRedraw();
                    }
                    // The launched program exited: drain any trailing output and
                    // stop streaming so the 4 fps throttle lifts and the log is
                    // no longer polled (it also caps the mirror file's growth).
                    if (File.Exists(ZanIDE.RunDonePath())) {
                        File.Delete(ZanIDE.RunDonePath());
                        int rfinal = ZanIDE.RunPoll(runLogLen, log);
                        if (rfinal != runLogLen) {
                            runLogLen = rfinal;
                            coLog.Reset();
                            app.RequestRedraw();
                        }
                        runStreaming = false;
                    }
                    app.RequestAnimationFrame(250);
                }
                // Save-triggered hot reload (autoRun ON): rebuild + restart the
                // active target in a DETACHED shell so saving never freezes the
                // IDE. The buildBusy poll below streams output and relaunches on
                // completion, exactly like the Run action.
                if (hotReloadReq) {
                    hotReloadReq = false;
                    if (!buildBusy) {
                        int atHr = activeTab.Get();
                        string apHr = "";
                        if (atHr >= 0 && atHr < tabs.Count) { apHr = tabs[atHr].path; }
                        string rpHr = ZanIDE.RibbonRunTarget(apHr, root);
                        if (rpHr != "") {
                            string bdHr = ZanIDE.EnsureBuildDir(root);
                            string exeHr = bdHr + "/.zanrun" + ZanIDE.ExeSuffix();
                            ZanIDE.HotKillRunExe(exeHr);
                            buildBusy = true;
                            buildThenRun = !ZanIDE.IsLibraryProject(root);
                            buildExe = ZanIDE.RunBuildBegin(root, rpHr);
                            buildIsGui = ZanIDE.IsWindowedTarget(root, rpHr);
                            buildTargetPath = apHr;
                            buildLogLen = 0;
                            dock.Focus("output");
                            log.Add("> [Hot] Rebuilding " + rpHr + " ...");
                            app.RequestAnimationFrame(80);
                        }
                    }
                }
                // Poll the in-flight detached git job (status scan or a panel
                // command): apply the result when its marker appears, so a slow
                // repository never freezes the window.
                if (gitJob != 0) {
                    if (ZanIDE.GitJobDone()) {
                        List<string> gJob = ZanIDE.GitJobTake();
                        if (gitJob == 1) {
                            gitBranch = ZanIDE.GitRefreshApply(gJob, gitFiles);
                            gitLoaded = true;
                            gitSel.Set(0 - 1);
                        } else {
                            ZanIDE.AppendAll(log, gJob);
                            coLog.Reset();
                            // a command may have changed the working tree
                            gitLoaded = false;
                        }
                        gitJob = 0;
                        app.RequestRedraw();
                    } else {
                        app.RequestAnimationFrame(120);
                    }
                }
                // Poll the on-disk symbol index: a background EmitSymbolsDetach
                // (or a build) may have written a newer one; reload it so member
                // completion follows the newest code without a restart.
                if (haveProject) {
                    string idxP = ZanIDE.SymbolIndexPath(root);
                    if (File.Exists(idxP)) {
                        long stI = FileInfo.GetLastWriteTime(idxP);
                        if (stI > symbolIdxStamp) {
                            if (ZanIDE.LoadSymbolIndexFor(root)) { symbolIdxStamp = stI; }
                        }
                    }
                }
                // Poll the in-flight detached build (Run/Build ribbon): stream
                // compiler output and, when the done-marker appears, apply
                // diagnostics and (for Run) launch the program -- no UI freeze.
                if (buildBusy) {
                    int bConsumed = ZanIDE.BuildPoll(buildLogLen, log);
                    if (bConsumed != buildLogLen) {
                        buildLogLen = bConsumed;
                        coLog.Reset();
                        app.RequestRedraw();
                    }
                    if (File.Exists(ZanIDE.BuildDonePath())) {
                        File.Delete(ZanIDE.BuildDonePath());
                        buildLogLen = ZanIDE.BuildPoll(buildLogLen, log);
                        buildBusy = false;
                        List<string> bout = CodeEditor.SplitLines(File.ReadAllText(ZanIDE.BuildLogPath()));
                        ZanIDE.ApplyDiagnostics(editor, buildTargetPath, bout, log);
                        if (dbgBuildPending) {
                            dbgBuildPending = false;
                            if (!File.Exists(buildExe)) {
                                log.Add("> [Debug] Build failed.");
                            } else {
                                log.Add("> [Debug] Build succeeded.");
                                dbg = ZanIDE.DbgBegin(root, buildTargetPath,
                                    ZanIDE.MergeBreakpoints(editor.Breakpoints(), bpConds),
                                    ZanIDE.FirstDebugLine(editor), log);
                                dbgState = ZanIDE.DbgSync(dbg, editor, log, dbgConsole);
                                dbgExecLine = ZanIDE.DbgLine(dbg);
                                dbgVarInfo = ZanIDE.DbgVars(dbg);
                                dbgStack = ZanIDE.DbgStack(dbg);
                                dbgWatchVals = ZanIDE.DbgEvalWatches(dbg, dbgWatches);
                                dbgPanelTab.Set(1);
                                if (dbgState == 2) {
                                    log.Add(">   F5=Continue  F10=StepOver  F11=StepInto  Ctrl+B=Condition  Esc=Stop");
                                    ZanIDE.LogVarsToConsole(log, dbgVarInfo, dbgExecLine);
                                } else {
                                    dbg = null;
                                }
                            }
                        } else if (!File.Exists(buildExe)) {
                            // 构建失败只报错：把「错误」面板顶到前面，
                            // 绝不擅自弹别的窗口（缺库只给一行提示）。
                            string missingPackage = ZanIDE.MissingPackage(bout);
                            if (missingPackage != "") {
                                log.Add(ZanIDE.T("> Missing package: ",
                                    "> 缺少库：") + missingPackage
                                    + ZanIDE.T(" (install it from Extensions)",
                                        "（可到「扩展」里安装）"));
                            }
                            log.Add(ZanIDE.T("> Build failed; not run.", "> 构建失败，未运行。"));
                            dock.Focus("errors");
                        } else if (buildThenRun) {
                            // The program starts in the project root, not in the
                            // IDE's own directory, so its relative paths (an
                            // example's assets/, config/app.json) resolve.
                            string runCwd = ZanIDE.RunCwd(root, buildTargetPath, buildExe);
                            if (buildIsGui) {
                                #if WINDOWS
                                Process.RunDetached("cmd /c start \"\" /D \""
                                    + ZanIDE.ToWinPath(runCwd) + "\" \"" + buildExe + "\"");
                                #else
                                Process.RunDetached("sh -c 'cd \"" + runCwd + "\" && \""
                                    + buildExe + "\" >/dev/null 2>&1' &");
                                #endif
                                log.Add(ZanIDE.T("> GUI app started.", "> GUI 应用已启动。"));
                            } else {
                                // Console programs run in their own console window
                                // (real stdin, so Console.ReadLine works) with
                                // output teed into the Output tab.
                                log.Add("> " + buildExe);
                                ZanIDE.RunConsole(buildExe, runCwd);
                                runLogLen = 0;
                                runStreaming = true;
                            }
                        } else {
                            log.Add(ZanIDE.T("> Build succeeded.", "> 构建成功。"));
                        }
                        // A build means the code changed: re-index so
                        // completion follows it, and pick up the index
                        // the previous build produced.
                        if (ZanIDE.LoadSymbolIndexFor(root)) {
                            string idxPB = ZanIDE.SymbolIndexPath(root);
                            if (File.Exists(idxPB)) {
                                symbolIdxStamp = FileInfo.GetLastWriteTime(idxPB);
                            }
                        }
                        this.RefreshSymbolIndex(true);
                        // An AI-initiated build/run: hand the compiler result
                        // back to the assistant loop so it reads the real
                        // errors and can fix them, then continue.
                        if (aiBuildForAi) {
                            aiBuildForAi = false;
                            bool aiOk = File.Exists(buildExe);
                            // 编译/运行的真实结果回填到当前那一拍：失败按故障
                            // 分类决定重试、进根因回环还是交给用户，不靠循环
                            // 自己猜。
                            string aiPhTool = "build";
                            if (aiUiPending) { aiPhTool = aiUiTool; }
                            else if (buildThenRun) { aiPhTool = "run"; }
                            this.AiRunBuildDone(aiOk, aiPhTool, bout);
                            if (aiUiPending) {
                                // ui_check: on a good build, launch the target
                                // under the UiDriver script and let the ui poll
                                // gather the log + hit regions; a failed build
                                // goes straight back so the model can fix it.
                                aiUiPending = false;
                                if (aiOk) {
                                    string uid = root + "/_scratch/uidrv";
                                    string uiCwd = ZanIDE.RunCwd(root,
                                        buildTargetPath, buildExe);
                                    ZanIDE.LaunchUnderUiDriver(buildExe, uiCwd,
                                        uid + "/ai_script.txt", uid,
                                        uid + "/ai_done.txt");
                                    aiUiRunning = true;
                                    aiUiDeadline = Window.GetTickMs() + 30000;
                                    log.Add(ZanIDE.T("> [AI] Driving UI...",
                                        "> [AI] 正在驱动 UI 自检..."));
                                    app.RequestAnimationFrame(120);
                                } else {
                                    aiMsgs.Add(AiChatMsg.Create("tool",
                                        aiUiTool + "\n"
                                        + AiAgent.BuildResult(bout, false, false)));
                                    string ube = ZanIDE.AiLaunchAs(aiRunAgent, aiMsgs,
                                        aiRunCtxName, aiRunCtxCode, root,
                                        aiProfiles[aiProfActive].baseUrl,
                                        aiProfiles[aiProfActive].key, aiRunModel);
                                    if (ube != "") {
                                        aiMsgs.Add(AiChatMsg.Create("error", ube));
                                        aiBusy.Set(0);
                                    }
                                    aiScroll.Set(0);
                                }
                            } else {
                                string tb = "build\n";
                                if (buildThenRun) { tb = "run\n"; }
                                aiMsgs.Add(AiChatMsg.Create("tool",
                                    tb + AiAgent.BuildResult(bout, aiOk, buildThenRun)));
                                string aiBe = ZanIDE.AiLaunchAs(aiRunAgent, aiMsgs,
                                    aiRunCtxName, aiRunCtxCode, root,
                                    aiProfiles[aiProfActive].baseUrl,
                                    aiProfiles[aiProfActive].key, aiRunModel);
                                if (aiBe != "") {
                                    aiMsgs.Add(AiChatMsg.Create("error", aiBe));
                                    aiBusy.Set(0);
                                }
                                aiScroll.Set(0);
                            }
                        }
                        coLog.Reset();
                        app.RequestRedraw();
                    }
                    app.RequestAnimationFrame(80);
                }
                // ui_check in flight: the target is being driven by the
                // UiDriver script. Wait (without blocking) for its done-marker
                // or the deadline, then feed the driver log + hit-region dump
                // back so the model can verify the UI against real geometry.
                if (aiUiRunning) {
                    string uidP = root + "/_scratch/uidrv";
                    bool uiDone = File.Exists(uidP + "/ai_done.txt");
                    bool uiTo = Window.GetTickMs() > aiUiDeadline;
                    if (uiDone || uiTo) {
                        aiUiRunning = false;
                        if (uiDone) { File.Delete(uidP + "/ai_done.txt"); }
                        string rlog = "";
                        if (File.Exists(uidP + "/results.log")) {
                            rlog = File.ReadAllText(uidP + "/results.log");
                        }
                        string rjson = "";
                        if (File.Exists(uidP + "/regions.json")) {
                            rjson = File.ReadAllText(uidP + "/regions.json");
                        }
                        string tjson = "";
                        if (File.Exists(uidP + "/theme.json")) {
                            tjson = File.ReadAllText(uidP + "/theme.json");
                        }
                        aiMsgs.Add(AiChatMsg.Create("tool",
                            aiUiTool + "\n"
                            + AiAgent.UiResultOf(aiUiTool, rlog, rjson, tjson,
                                uiTo && !uiDone)));
                        string uce = ZanIDE.AiLaunchAs(aiRunAgent, aiMsgs,
                            aiRunCtxName, aiRunCtxCode, root,
                            aiProfiles[aiProfActive].baseUrl,
                            aiProfiles[aiProfActive].key, aiRunModel);
                        if (uce != "") {
                            aiMsgs.Add(AiChatMsg.Create("error", uce));
                            aiBusy.Set(0);
                        }
                        aiScroll.Set(0);
                        app.RequestRedraw();
                    } else {
                        app.RequestAnimationFrame(150);
                    }
                }
                // Poll the in-flight detached publish: compiler output streams
                // into the Output tab and a done-marker file signals completion,
                // so even a slow cross-compile never blocks the UI.
                if (pubBusy) {
                    int pubConsumed = ZanIDE.PubPoll(pubLogLen, log);
                    if (pubConsumed != pubLogLen) {
                        pubLogLen = pubConsumed;
                        coLog.Reset();
                        app.RequestRedraw();
                    }
                    if (File.Exists(ZanIDE.PubDonePath())) {
                        File.Delete(ZanIDE.PubDonePath());
                        pubLogLen = ZanIDE.PubPoll(pubLogLen, log);
                        int pubOk = 0;
                        for (int pe = 0; pe < pubExes.Count; pe = pe + 1) {
                            if (File.Exists(pubExes[pe])) {
                                log.Add("> Published " + pubExes[pe]);
                                pubOk = pubOk + 1;
                            } else {
                                log.Add(ZanIDE.T("> Publish failed for ", "> 发布失败：") + pubExes[pe]);
                            }
                        }
                        // Each target has its own output directory, so the
                        // resources go beside each executable that does not
                        // already carry them: a packed Windows exe has them
                        // inside, everything else needs the loose copy.
                        bool packed = ZanIDE.CanPackSingle() && ZanIDE.ProjSingleFile(root);
                        for (int pe3 = 0; pe3 < pubExes.Count; pe3 = pe3 + 1) {
                            if (File.Exists(pubExes[pe3])
                                && !(packed && ZanIDE.EndsWith(pubExes[pe3], ".exe"))) {
                                ZanIDE.CopyResources(root, ZanIDE.DirOf(pubExes[pe3]), log);
                            }
                        }
                        pubBusy = false;
                        pubExes = new List<string>();
                        coLog.Reset();
                        app.RequestRedraw();
                    }
                    app.RequestAnimationFrame(250);
                }
                // Poll the in-flight AI request. The Net worker thread streams
                // the decoded response body into an in-memory sink as it
                // arrives and publishes "ok"/"err: ..." when it ends. Each
                // frame the panel reads the sink to show the answer building up
                // live, and a wall-clock backstop times the wait out so the
                // panel never hangs on 'thinking' if the worker dies silently.
                if (aiBusy.Get() == 1) {
                    bool aiToolRunning = buildBusy || aiUiRunning || runStreaming;
                    if (aiToolRunning) {
                        aiWaitStart = 0;
                    }
                    string aiDoneTxt = AiNet.Done();
                    bool aiMarker = aiDoneTxt != "";
                    bool aiTimedOut = false;
                    if (!aiToolRunning && !aiMarker) {
                        // Live read: re-parse only when the decoded body grew,
                        // and drop a stale live bubble if a retry just reset
                        // the sink.
                        string sraw = AiNet.Text();
                        if (sraw.Length < aiStreamLen) {
                            if (aiStreamMsgIdx >= 0
                                && aiStreamMsgIdx == aiMsgs.Count - 1) {
                                aiMsgs.RemoveAt(aiStreamMsgIdx);
                            }
                            aiStreamMsgIdx = 0 - 1;
                            aiStreamLen = 0;
                        }
                        if (sraw.Length != aiStreamLen) {
                            aiStreamLen = sraw.Length;
                            SseAnswer pa = AiAgent.ParseSse(sraw);
                            string live = pa.content;
                            if (live == "" && pa.reasoning != "") {
                                live = ZanIDE.T("(thinking) ", "(思考中) ")
                                    + pa.reasoning;
                            }
                            if (live != "") {
                                if (aiStreamMsgIdx < 0) {
                                    aiMsgs.Add(AiChatMsg.Create("assistant", live));
                                    aiStreamMsgIdx = aiMsgs.Count - 1;
                                } else if (aiStreamMsgIdx < aiMsgs.Count) {
                                    aiMsgs[aiStreamMsgIdx].text = live;
                                }
                                aiScroll.Set(0);
                            }
                            aiWaitStart = 0;
                        } else {
                            int aiNow = Window.GetTickMs();
                            if (aiWaitStart == 0) { aiWaitStart = aiNow; }
                            // Mirrors the transport's idle window (600s): a
                            // model that is still thinking emits nothing for
                            // minutes, so only give up after the same silence
                            // the Net layer would time out on. Any byte of
                            // stream content (or a retry that truncates the
                            // file) re-arms the wait above.
                            else if (aiNow - aiWaitStart > 600000) {
                                aiTimedOut = true;
                            }
                        }
                    }
                    if (aiTimedOut) {
                        aiWaitStart = 0;
                        if (aiStreamMsgIdx >= 0
                            && aiStreamMsgIdx == aiMsgs.Count - 1) {
                            aiMsgs.RemoveAt(aiStreamMsgIdx);
                        }
                        aiStreamMsgIdx = 0 - 1;
                        aiStreamLen = 0;
                        aiMsgs.Add(AiChatMsg.Create("error", ZanIDE.T(
                            "[error] AI request timed out - no response received.",
                            "[错误] AI 请求超时——未收到响应。")));
                        aiBusy.Set(0);
                        aiScroll.Set(0);
                    } else if (aiMarker) {
                        aiWaitStart = 0;
                        string doneTxt = AiAgent.Trim(aiDoneTxt);
                        // Drop the live preview bubble; the final turns are added
                        // below from the fully decoded stream.
                        if (aiStreamMsgIdx >= 0
                            && aiStreamMsgIdx == aiMsgs.Count - 1) {
                            aiMsgs.RemoveAt(aiStreamMsgIdx);
                        }
                        aiStreamMsgIdx = 0 - 1;
                        aiStreamLen = 0;
                        string sraw = AiNet.Text();
                        AiNet.Abandon();
                        SseAnswer fa = AiAgent.ParseSse(sraw);
                        if (fa.totalTokens > 0 || fa.promptTokens > 0) {
                            aiTokPrompt = fa.promptTokens;
                            aiTokCompletion = fa.completionTokens;
                            aiTokTotal = fa.totalTokens;
                            aiTokCached = fa.cachedTokens;
                        }
                        ZanIDE.AiStatAdd(fa);
                        // A success marker begins with "ok" (the streamer can
                        // occasionally append it twice -> "okok"); anything
                        // starting with "err" is a failure.
                        bool doneOk = doneTxt.Length >= 2
                            && doneTxt.Substring(0, 2) == "ok";
                        if (!doneOk || fa.error != "") {
                            string emsg = doneTxt;
                            if (emsg.Length >= 5 && emsg.Substring(0, 5) == "err: ") {
                                emsg = emsg.Substring(5, emsg.Length - 5);
                            }
                            if (fa.error != "") {
                                if (emsg != "" && !doneOk) {
                                    emsg = emsg + ": " + fa.error;
                                } else { emsg = fa.error; }
                            }
                            if (emsg == "") { emsg = "the AI request failed."; }
                            ZanIDE.aiStatFails = ZanIDE.aiStatFails + 1;
                            // A dropped connection or an idle timeout is not an
                            // answer: resend the same request instead of
                            // dumping the task on the user, who could only do
                            // the same thing by hand.
                            bool retryable = fa.error == ""
                                && AiAgent.IsTransient(emsg)
                                && aiRetry < AiAgent.MaxRetries();
                            if (retryable) {
                                aiRetry = aiRetry + 1;
                                string rle = ZanIDE.AiLaunchAs(aiRunAgent, aiMsgs,
                                    aiRunCtxName, aiRunCtxCode, root,
                                    aiProfiles[aiProfActive].baseUrl,
                                    aiProfiles[aiProfActive].key, aiRunModel);
                                if (rle == "") {
                                    log.Add("> 小赞: " + emsg + " - "
                                        + ZanIDE.T("retrying (", "重试中（")
                                        + Convert.ToString(aiRetry) + "/"
                                        + Convert.ToString(AiAgent.MaxRetries())
                                        + ZanIDE.T(")", "）"));
                                    Layer.Msg(ZanIDE.T("Xiao Zan request failed - retrying",
                                        "小赞请求失败——正在重试"), 3);
                                } else {
                                    aiMsgs.Add(AiChatMsg.Create("error",
                                        "[error] " + rle));
                                    aiBusy.Set(0);
                                }
                            } else {
                                aiRetry = 0;
                                aiMsgs.Add(AiChatMsg.Create("error",
                                    "[error] " + emsg));
                                aiBusy.Set(0);
                            }
                        } else {
                            aiRetry = 0;
                            // A reply that asks for a tool is one step of the
                            // assistant loop, not the answer: run the tool inside
                            // the project, hand the result back and ask again, so
                            // the model reads the real code instead of guessing.
                            string reply = fa.content;
                            string call = AiAgent.ToolBlock(reply);
                            bool more = call != ""
                                && AiAgent.StepsSinceUser(aiMsgs) < AiAgent.MaxSteps();
                            string said = reply;
                            if (call != "") { said = AiAgent.StripToolBlock(reply); }
                            string rz = AiAgent.Trim(fa.reasoning);
                            // A reply that is only a tool block still carries
                            // thinking worth keeping, so save the reasoning
                            // even when there is no visible text.
                            if (said != "" || rz != "") {
                                AiChatMsg amsg = AiChatMsg.CreateWithReason(
                                    "assistant", said, rz);
                                if (aiTeamMode) {
                                    // Record the beat on the message itself, so
                                    // the transcript (and the reload of it) can
                                    // show progress and ownership without
                                    // re-parsing the prose.
                                    AiEnvelope env = AiTeam.ParseEnvelope(said);
                                    AiTeam.ApplyToTasks(aiTasks, aiRunAgent, env);
                                    amsg.agent = aiRunAgent;
                                    amsg.kind = env.kind;
                                    amsg.taskId = env.taskId;
                                    amsg.progress = env.progress;
                                    amsg.to = AiTeam.JoinIds(env.to);
                                }
                                aiMsgs.Add(amsg);
                            }
                            if (more) {
                                string tname = AiAgent.ToolName(call);
                                if (AiAgent.IsMutating(tname) && !aiAutoExec) {
                                    // A write / build / run pauses for the user:
                                    // park the call and switch to the confirm
                                    // state (aiBusy == 2). Nothing touches the
                                    // project until they Approve it in the panel.
                                    aiPendingCall = call;
                                    aiBusy.Set(2);
                                } else {
                                    AiDispatchTool(call);
                                }
                            } else {
                                // Nothing left to run this turn. Rather than
                                // stopping half-way through a checklist -- the
                                // task "not continuing by itself" -- push the
                                // loop on with a continue turn, which also
                                // refills the per-question tool budget. Bounded
                                // by MaxContinues() and never taken when the
                                // model just asked the user something.
                                // A read-only tool (read_file / grep /
                                // list_dir / repo_map) that ran out of budget
                                // is NOT a reason to keep going on its own: the
                                // model was only looking, not doing. Only a
                                // mutating call cut mid-task refills the budget
                                // -- or an unfinished plan under Auto-execute.
                                bool limitHit = call != ""
                                    && AiAgent.IsMutating(AiAgent.ToolName(call));
                                bool cont = aiAutoCont < AiAgent.MaxContinues()
                                    && (limitHit
                                        || (aiAutoExec && AiPlanUnfinished()
                                            && !AiAgent.AsksUser(said)));
                                if (cont) {
                                    aiAutoCont = aiAutoCont + 1;
                                    aiMsgs.Add(AiChatMsg.Create("user",
                                        AiAgent.ContinuePrompt(limitHit)));
                                    string cle = ZanIDE.AiLaunchAs(aiRunAgent, aiMsgs,
                                        aiRunCtxName, aiRunCtxCode, root,
                                        aiProfiles[aiProfActive].baseUrl,
                                        aiProfiles[aiProfActive].key, aiRunModel);
                                    if (cle != "") {
                                        aiMsgs.Add(AiChatMsg.Create("error", cle));
                                        aiBusy.Set(0);
                                    }
                                } else {
                                    if (limitHit) {
                                        aiMsgs.Add(AiChatMsg.Create("error", ZanIDE.T(
                                            "Tool limit reached for this question.",
                                            "本次提问的工具调用次数已达上限。")));
                                    }
                                    this.AiRunTurnEnd(said);
                                    AiTeamTurnEnd(said);
                                }
                            }
                        }
                        aiScroll.Set(0);
                    }
                    app.RequestRedraw();
                }

                // Autosave the AI transcript (throttled to 1/s): every new user
                // turn, tool result or streamed answer is folded into the
                // current session and written to disk, so restarting the IDE
                // keeps the conversation instead of losing it. This runs per
                // frame, NOT inside the panel's own branch: a chat that keeps
                // answering while the assistant panel is hidden (or tabbed
                // behind another dock panel) was never written back, which is
                // how a reopened session came back cut off mid-answer.
                this.AutosaveAiSessions();

                // Close the dock frame: draws the drag ghost / drop highlight
                // over the panels and applies a finished drag. The arrangement
                // is written back only when it actually changed.
                dock.End(app);
                string dockClosed = dock.TakeClosed();
                if (dockClosed != "") {
                    Layer.Msg(ZanIDE.T("Panel closed - right-click a tab strip to restore",
                        "面板已关闭 - 右键标签栏可恢复"), 3);
                }
                if (dock.TakeChanged()) { ZanIDE.WriteDockLayout(dock.SaveLayout()); }

                // Status bar. Drawn on the same muted panel surface as the
                // title bar / side panels (bgSecondary) so the shell reads as
                // one calm frame; only the debugging state gets a loud tint.
                int sbY = H - sbH;
                bool sbDebug = (dbgState == 2);
                int sbText = t.textPrimary;
                int sbMuted = t.textSecondary;
                if (sbDebug) {
                    sbText = t.onScrim;
                    sbMuted = t.tooltipTextMuted;
                }
                int curLn = editor.CurLine();
                int curCl = editor.CurCol();
                string posInfo = ZanIDE.T("Ln ", "行 ") + Convert.ToString(curLn + 1) + ZanIDE.T(", Col ", "，列 ") + Convert.ToString(curCl + 1);
                // Language of the buffer, so an embedded .lua/.py script
                // edited next to its Zan host shows which rules the editor
                // is applying (highlighting, comment mark, completion).
                string modeInfo = "Zan";
                if (editor.SyntaxLang() == 1) { modeInfo = "Lua"; }
                if (editor.SyntaxLang() == 2) { modeInfo = "Python"; }
                if (designerMode) { modeInfo = ZanIDE.T("Designer", "设计器"); }
                if (pubBusy) { modeInfo = ZanIDE.T("Publishing...", "发布中..."); }
                if (sbDebug) { modeInfo = ZanIDE.T("Debugging", "调试中"); }
                int sbTint = 0;
                if (sbDebug) { sbTint = t.statusDebugBg; }
                statusBar.SetTint(sbTint);
                statusBar.SetText(sbPosItem, posInfo);
                statusBar.SetColor(sbPosItem, sbText);
                statusBar.SetText(sbModeItem, modeInfo);
                statusBar.SetColor(sbModeItem, sbText);
                statusBar.SetColor(sbEncItem, sbMuted);
                statusBar.RenderAt(app, 0, sbY, W, sbH);

                // Top-level editor context menu overlay (drawn last so nothing
                // paints over it), then bridge its host commands.
                if (!designerMode && !activeIsStart && !activeIsDocs) {
                    editor.RenderCtxMenu(app);
                    string ecmd = editor.TakeCommand();
                    if (ecmd == "find") {
                        findMode = 1;
                        findBar.Open(false, this.FindSeed());
                        app.RequestRedraw();
                    }
                    else if (ecmd == "gotoline") { findMode = 3; gotoText = ""; app.RequestRedraw(); }
                    else if (ecmd == "gotodef") {
                        if (lspSess == null && !lspTried) {
                            lspTried = true;
                            lspSess = LspSession.Start(root);
                            if (lspSess != null) { log.Add("> zan-lsp connected: semantic navigation enabled."); }
                        }
                        string navW_gl = editor.WordAtCaret();
                        this.RememberTabView();
                        int gl = ZanIDE.GoToDefinitionSmart(lspSess, editor, tabs, activeTab, root, log);
                        this.ApplyGotoResult(gl, navW_gl);
                        app.RequestRedraw();
                    } else if (ecmd == "findrefs") {
                        if (lspSess == null && !lspTried) {
                            lspTried = true;
                            lspSess = LspSession.Start(root);
                            if (lspSess != null) { log.Add("> zan-lsp connected: semantic navigation enabled."); }
                        }
                        this.ShowReferences();
                        app.RequestRedraw();
                    }
                }
                // File-tree / tab right-click context menus, drawn above the
                // editor overlay. ctxKind: 1 = project tree row, 2 = stdlib
                // tree row, 3 = editor tab, 4 = Tools panel row, 5 = Examples
                // panel row.
                if (ctxKind != 0) {
                    List<string> cmLabels = new List<string>();
                    if (ctxKind == 1) {
                        cmLabels.Add(ZanIDE.T("New File", "新建文件"));
                        cmLabels.Add(ZanIDE.T("New Folder", "新建文件夹"));
                        cmLabels.Add("-");
                        int delN = 1;
                        if (explorerTv != null && explorerTv.IsMarked(ctxTarget)) {
                            delN = explorerTv.SelectionCount();
                        }
                        if (delN > 1) {
                            cmLabels.Add(ZanIDE.T("Delete ", "删除 ") + Convert.ToString(delN)
                                + ZanIDE.T(" items", " 项"));
                        } else {
                            cmLabels.Add(ZanIDE.T("Delete", "删除"));
                        }
                        cmLabels.Add("-");
                        cmLabels.Add(ZanIDE.T("Refresh", "刷新"));
                        cmLabels.Add(ZanIDE.T("Copy Path", "复制路径"));
                        cmLabels.Add(ZanIDE.T("Reveal in Explorer", "在资源管理器中显示"));
                    } else if (ctxKind == 2) {
                        cmLabels.Add(ZanIDE.T("Open", "打开"));
                        cmLabels.Add("-");
                        cmLabels.Add(ZanIDE.T("Refresh", "刷新"));
                        cmLabels.Add(ZanIDE.T("Copy Path", "复制路径"));
                        cmLabels.Add(ZanIDE.T("Reveal in Explorer", "在资源管理器中显示"));
                    } else if (ctxKind == 3) {
                        cmLabels.Add(ZanIDE.T("Close", "关闭"));
                        cmLabels.Add(ZanIDE.T("Close Others", "关闭其他"));
                        cmLabels.Add("-");
                        cmLabels.Add(ZanIDE.T("Copy Path", "复制路径"));
                    } else if (ctxKind == 4) {
                        cmLabels.Add(ZanIDE.T("Open in Editor", "在编辑器中打开"));
                        cmLabels.Add(ZanIDE.T("Run", "运行"));
                        cmLabels.Add("-");
                        cmLabels.Add(ZanIDE.T("Copy Path", "复制路径"));
                        cmLabels.Add(ZanIDE.T("Reveal in Explorer", "在资源管理器中显示"));
                    } else if (ctxKind == 5) {
                        cmLabels.Add(ZanIDE.T("Open", "打开"));
                        cmLabels.Add("-");
                        cmLabels.Add(ZanIDE.T("Copy Path", "复制路径"));
                        cmLabels.Add(ZanIDE.T("Reveal in Explorer", "在资源管理器中显示"));
                    }
                    int chosen = ContextMenu.Render(app, ctxX, ctxY, cmLabels);
                    if (chosen == 0 - 2) {
                        ctxKind = 0;
                        app.RequestRedraw();
                    } else if (chosen >= 0) {
                        if (ctxKind == 1) {
                            if (chosen == 0 && dlg == null) {
                                dlg = ZanIDE.OpenWizard(app, ZanIDE.T("New File", "新建文件"), fSel, fNameInput, "NewFile");
                                dlgMode = 2;
                            } else if (chosen == 1 && dlg == null) {
                                dlg = ZanIDE.OpenWizard(app, ZanIDE.T("New Folder", "新建文件夹"), fSel, fNameInput, "NewFolder");
                                fSel.Set(ZanIDE.FileKindFolder());
                                dlgMode = 2;
                            } else if (chosen == 3) {
                                // Delete every marked row when the right-clicked
                                // row is part of the multi-selection; otherwise
                                // just the row the menu was opened on.
                                List<int> delRows = new List<int>();
                                if (explorerTv != null && explorerTv.IsMarked(ctxTarget)) {
                                    delRows = explorerTv.SelectedIndices();
                                } else {
                                    delRows.Add(ctxTarget);
                                }
                                int nDel = 0;
                                string lastName = "";
                                for (int dj = 0; dj < delRows.Count; dj = dj + 1) {
                                    int rowd = delRows[dj];
                                    if (rowd >= 0 && rowd < treeShow.Count) {
                                        string dp = treeShow[rowd].path;
                                        if (haveProject && dp != "" && ZanIDE.StartsWith(dp, root) && dp != root) {
                                            ZanIDE.DeletePathRecursive(dp);
                                            log.Add("> Deleted " + dp + ".");
                                            lastName = Path.GetFileName(dp);
                                            nDel = nDel + 1;
                                        }
                                    }
                                }
                                if (nDel > 1) {
                                    Layer.Notify(ZanIDE.T("Deleted ", "已删除 ") + Convert.ToString(nDel)
                                        + ZanIDE.T(" items", " 项"), 3);
                                } else if (nDel == 1) {
                                    Layer.Notify(ZanIDE.T("Deleted: ", "已删除：") + lastName, 3);
                                }
                                if (nDel > 0) {
                                    explorerTv.ClearSelection();
                                    rescan = true;
                                }
                            } else if (chosen == 5) {
                                rescan = true;
                            } else if (chosen == 6) {
                                if (ctxTarget >= 0 && ctxTarget < treeShow.Count) {
                                    Clipboard.SetText(treeShow[ctxTarget].path);
                                    log.Add("> Copied path: " + treeShow[ctxTarget].path);
                                }
                            } else if (chosen == 7) {
                                if (ctxTarget >= 0 && ctxTarget < treeShow.Count) {
                                    ZanIDE.RevealInFileManager(treeShow[ctxTarget].path);
                                }
                            }
                        } else if (ctxKind == 2) {
                            if (ctxTarget >= 0 && ctxTarget < exShow.Count) {
                                TreeNode exn = exShow[ctxTarget];
                                bool exReal = exn.path != "" && !ZanIDE.StartsWith(exn.path, "@");
                                if (chosen == 0) {
                                    if (exReal && !exn.isDir) {
                                        ZanIDE.OpenPath(tabs, activeTab, exn.path, exn.label);
                                        log.Add("> Opened " + exn.path + ".");
                                    }
                                } else if (chosen == 2) {
                                    exTree = ZanIDE.BuildStdlibTree();
                                    log.Add("> Refreshed standard library / tools / examples.");
                                } else if (chosen == 3) {
                                    if (exReal) {
                                        Clipboard.SetText(exn.path);
                                        log.Add("> Copied path: " + exn.path);
                                    }
                                } else if (chosen == 4) {
                                    if (exReal) { ZanIDE.RevealInFileManager(exn.path); }
                                }
                            }
                        } else if (ctxKind == 3) {
                            if (chosen == 0) {
                                this.RequestCloseTab(ctxTarget);
                            } else if (chosen == 1) {
                                if (ctxTarget >= 0 && ctxTarget < tabs.Count) {
                                    this.RequestCloseOthers(tabs[ctxTarget].path);
                                }
                            } else if (chosen == 3) {
                                if (ctxTarget >= 0 && ctxTarget < tabs.Count) {
                                    Clipboard.SetText(tabs[ctxTarget].path);
                                    log.Add("> Copied path: " + tabs[ctxTarget].path);
                                }
                            }
                        } else if (ctxKind == 4) {
                            if (ctxTarget >= 0 && ctxTarget < rtCtxShow.Count) {
                                TreeNode rtrn = rtCtxShow[ctxTarget];
                                bool rtReal = rtrn.path != "" && !ZanIDE.StartsWith(rtrn.path, "@");
                                if (!rtrn.isDir && rtReal) {
                                    if (chosen == 0) {
                                        ZanIDE.OpenPath(tabs, activeTab, rtrn.path, rtrn.label);
                                        log.Add("> Opened " + rtrn.path + ".");
                                    } else if (chosen == 1) {
                                        string rtcT = ZanIDE.RunTarget(rtrn.path, root);
                                        if (buildBusy) {
                                            Layer.Msg(ZanIDE.T("Build already running…", "构建进行中…"), 2);
                                        } else if (rtcT != "") {
                                            log.Add(ZanIDE.T("> Running tool ", "> 运行工具 ") + rtrn.path + " ...");
                                            buildBusy = true;
                                            buildThenRun = true;
                                            buildExe = ZanIDE.RunBuildBegin(root, rtcT);
                                            buildIsGui = ZanIDE.IsWindowedTarget(root, rtcT);
                                            buildTargetPath = rtrn.path;
                                            buildLogLen = 0;
                                            dock.Focus("output");
                                            app.RequestAnimationFrame(80);
                                        }
                                    } else if (chosen == 3) {
                                        Clipboard.SetText(rtrn.path);
                                        log.Add("> Copied path: " + rtrn.path);
                                    } else if (chosen == 4) {
                                        ZanIDE.RevealInFileManager(rtrn.path);
                                    }
                                }
                            }
                        } else if (ctxKind == 5) {
                            if (ctxTarget >= 0 && ctxTarget < rtCtxShow.Count) {
                                TreeNode exrn = rtCtxShow[ctxTarget];
                                bool exrReal = exrn.path != "" && !ZanIDE.StartsWith(exrn.path, "@");
                                if (chosen == 0) {
                                    if (!exrn.isDir && exrReal) {
                                        ZanIDE.OpenPath(tabs, activeTab, exrn.path, exrn.label);
                                        log.Add("> Opened " + exrn.path + ".");
                                    }
                                } else if (chosen == 2) {
                                    if (exrReal) {
                                        Clipboard.SetText(exrn.path);
                                        log.Add("> Copied path: " + exrn.path);
                                    }
                                } else if (chosen == 3) {
                                    if (exrReal) { ZanIDE.RevealInFileManager(exrn.path); }
                                }
                            }
                        }
                        ctxKind = 0;
                        app.RequestRedraw();
                    }
                }

                // Publish / Project Configuration / Asset Manager now render in
                // their own top-level child windows (App.CreateDark) -- see the
                // pumps right after the main frame below. Only the deferred
                // publish kick-off (started once the window has closed) stays here.
                if (pubPending && !pubBusy) {
                    pubPending = false;
                    pubExes = ZanIDE.PublishPlatformsBegin(tabs, activeTab, root, pubSel, log);
                    pubBusy = pubExes.Count > 0;
                    pubLogLen = 0;
                    app.RequestRedraw();
                }
                string windowTitle = IdeVersion.Product();
                if (haveProject) { windowTitle = windowTitle + "  —  " + root; }
                // Unsaved-changes / changed-on-disk questions, above the page
                // and below the transient feedback queues.
                this.RenderDocDialogs();
                // Global operation feedback: toast + notification queues drawn
                // above everything so every action gives visible feedback.
                Layer.RenderToasts(app);
                Layer.RenderNotifs(app);
                app.RenderChrome(windowTitle);
                // Hover tips requested by widgets during the frame, painted on
                // top of everything they would otherwise hide behind.
                Tooltip.Flush(app);
                app.PresentFrame();
                lastPresent = Window.GetTickMs();
            } catch (Exception frameEx) {
                app.NoteFrameError("ide-frame", frameEx.Message);
                app.CancelPartialFrame();
                app.RequestRedraw();
            }
            }

            // Secondary top-level windows and the shared file picker, each
            // pumped for at most one frame here (see ZanIDE.Shell.zan).
            this.PumpWizardWindow();
            // One frame for every registered child window (see ChildWindow.zan),
            // whichever window opened it; the methods below only apply what
            // each of them reported.
            ChildWindows.PumpAll();
            lastPresent = Window.GetTickMs();
            this.PumpPublishWindow();
            this.PumpConfigWindow();
            this.PumpMarketplaceWindow();
            this.PumpSettingsWindows();
            this.PumpFilePicker();
            // Whatever those handlers opened (a window opened from a window,
            // the Asset Manager from Project Configuration, ...) gets its
            // first frame here instead of staying blank until the next event.
            ChildWindows.PumpAll();

            if (rescan) {
                rescan = false;
                // Keep the user's expanded folders across the rebuild: a
                // rescan after e.g. deleting a file must not collapse the tree.
                List<string> expKeep = ZanIDE.ExpandedPaths(tree);
                tree = new List<TreeNode>();
                if (haveProject) {
                    tree = ZanIDE.ScanTree(root);
                    ZanIDE.ApplyExpanded(tree, expKeep);
                }
                treeSel.Set(-1);
            }
        }
        // Flush the chat before the process goes away: the 1/s autosave can
        // still be holding a partially streamed answer when the window closes,
        // and that half-written turn is exactly what a reopened session showed.
        SaveAiSessions();
        // Persist window + panel sizes so the next launch restores them.
        // Only the USER's own wallpaper is persisted: the skin pack's art is
        // installed by the skin on launch, so saving it would leak this pack's
        // backdrop into the next launch (and mix palettes when the skin
        // changes). Skin.Apply installs the pack art when there is no user
        // wallpaper, so the distinction is exact.
        int arv = 0;
        if (autoRun) { arv = 1; }
        ZanIDE.SaveSettings(treeW.Get(), bottomPanelH.Get(), savedW, savedH, arv, app.SkinNameAt(app.ThemeMenuIndex()), rightW.Get(), winOpacity, app.UserWallpaperPath(), app.UserWallpaperOpacity());
    }

    /// Creates the main window from the persisted geometry/skin/wallpaper and
    /// reopens the last project (tree, tabs, editor, symbol index, log).
    void InitWindowAndProject(string cfg) {
        // Default is a standard 1080 (logical, 96-dpi) width; App.Show scales it
        // up by the display DPI, so it stays a sensible size on HiDPI screens.
        int cfgW = ZanIDE.CfgClamp(ZanIDE.CfgInt(cfg, "winW", 1080), 640, 4000);
        int cfgH = ZanIDE.CfgClamp(ZanIDE.CfgInt(cfg, "winH", 720), 480, 3000);
        app = App.CreateDark(IdeVersion.Product(), cfgW, cfgH);
        // Restore the last-used title-bar skin. New configs persist the pack
        // NAME (indices shift when skins are added/removed); a legacy numeric
        // value maps to the index it named and is upgraded on the next save.
        string skinName = ZanIDE.CfgStr(cfg, "skin", "");
        bool skinNumeric = skinName.Length > 0;
        for (int si = 0; si < skinName.Length; si = si + 1) {
            if (!ZanIDE.IsDigit(skinName.Substring(si, 1))) { skinNumeric = false; break; }
        }
        if (skinName != "" && !skinNumeric) {
            app.ApplySkinName(skinName);
        } else {
            app.ApplySkin(ZanIDE.CfgInt(cfg, "skin", 0));
        }
        app.Show();
        // Whole-window opacity (percent), persisted like the skin.
        winOpacity = ZanIDE.CfgClamp(ZanIDE.CfgInt(cfg, "opacity", 100), 30, 100);
        app.SetWindowOpacity(winOpacity);
        // Custom window wallpaper (image + blend strength), set in the
        // appearance drawer and persisted like the skin.
        wallPath = ZanIDE.CfgStr(cfg, "wallpaper", "");
        wallOpacity = ZanIDE.CfgClamp(ZanIDE.CfgInt(cfg, "wallOpacity", 100), 10, 100);
        if (wallPath != "" && !File.Exists(wallPath)) { wallPath = ""; }
        // A path that is any installed pack's OWN artwork is a skin-installed
        // backdrop (older configs persisted it as the wallpaper). The skin we
        // just applied already installed its own art -- leave it alone instead
        // of overwriting one pack's background with another's stale path.
        if (wallPath != "" && !app.IsSkinArtPath(wallPath)) {
            app.SetUserWallpaper(wallPath, wallOpacity);
        }
        savedW = cfgW;
        savedH = cfgH;

        // Reopen the last project the user worked on; when there is none yet,
        // start with just the Start page (no sample project is scaffolded).
        Directory.CreateDirectoryRecursive(ZanIDE.ProjectsHome());
        string lastProj = ZanIDE.ReadLastProject();
        haveProject = lastProj != "" && File.Exists(lastProj + "/zan.proj");
        root = ZanIDE.ProjectsHome();
        if (haveProject) { root = lastProj; }
        if (haveProject) { ZanIDE.AddRecentProject(root); }

        // Completion answers from the compiler's own symbol index: load what the
        // last run left behind and regenerate it behind that, so signatures are
        // the real ones (stdlib included) and an index left pointing at the
        // wrong sources is replaced rather than trusted.
        this.AdoptSymbolIndex();
        tree = new List<TreeNode>();
        if (haveProject) { tree = ZanIDE.ScanTree(root); }
        rescan = false;

        tabs = new List<TabRecord>();

        activeTab = new SignalInt(0);
        editor = new CodeEditor();
        statusBar = new StatusBar();
        sbPosItem = statusBar.AddLeft("Ln 1, Col 1");
        sbModeItem = statusBar.AddRight("Zan");
        sbEncItem = statusBar.AddRight("UTF-8");
        errorList = new ErrorList();
        lastActive = 0 - 1;
        // Which .zform tab the designer is currently bound to, and the last
        // serialized layout (to detect changes and persist them back to disk).
        loadedFormPath = "";
        formCache = "";
        // Same for the .zscene tab bound to the scene designer.
        loadedScenePath = "";
        sceneCache = "";

        if (haveProject) {
            // Restoring the last project must never be fatal: whatever is
            // wrong with it (files deleted since, an unreadable path), the
            // IDE still has to come up on its start page so the user can
            // pick another project.
            try {
                ZanIDE.OpenFirst(tabs, activeTab, root);
            } catch (Exception e) {
                tabs.Clear();
            }
        }
        // Start page is a real tab (path sentinel "@start"), shown first like
        // VS's Start Page. Rendered specially instead of the code editor.
        tabs.Insert(0, TabRecord.Create("Start", "", "@start"));
        activeTab.Set(0);

        log = new List<string>();
        if (haveProject) {
            log.Add("> " + IdeVersion.Product() + " ready. Workspace: " + root);
        } else {
            log.Add("> " + IdeVersion.Product() + " ready. No project is open.");
        }

        ZanIDE.uiLang = ZanIDE.ReadUiLang();
        Wizard.lang = ZanIDE.uiLang;
        Designer.lang = ZanIDE.uiLang;
        SceneDesigner.lang = ZanIDE.uiLang;
        ribbonTabs = ZanIDE.RibbonTabs();
        ribbonTab = new SignalInt(0);
    }

    /// New Project categories and the New File template catalog.
    void InitWizardCatalogs() {
        // ---- New Project categories (built-in + user "Custom") ----
        catNames = new List<string>{
            "Console", "Library", "Window App", "WebView", "Server", "Custom" };

