using System;
using System.IO;
using System.Diagnostics;
using System.Json;
using Gui;
using Gui.Widget;
using Gui.Designer;
using Game.Scene;

// ---- .zform design document entities -------------------------------------
// The form designer's interchange format (Designer.Inspector SaveJson /
// LoadJson) is declared as classes for the IDE-side producers. Optional
// fields the old builders omitted (required/wrap) serialize as explicit
// false, which LoadJson reads identically to a missing key; legacy imports
// use LegacyFormDoc so a blank winTitle can never overwrite the title.

class FormFieldDoc {
    int type;
    string label;
    string name;
    bool required;
    bool wrap;
    int span;
    int fx;
    int fy;
    int fw;
    int fh;
}

class FormDoc {
    string name;
    int winW;
    int winH;
    string winTitle;
    bool winCenter;
    int layoutMode;
    int winZoom;
    List<FormFieldDoc> fields;
}

class LegacyFormDoc {
    string name;
    List<FormFieldDoc> fields;
}

/// ZanIDE part: code navigation (go to definition / find references,
/// text-scan fallback + LSP-backed), the code outline, and the designer
/// <-> code form serialization (.zform model + code-behind emitter).
partial class ZanIDE {
    // ---- code navigation (go to definition / find references) ----

    static string RTrimS(string s) {
        int e = s.Length;
        while (e > 0) {
            string ch = s.Substring(e - 1, 1);
            if (ch == " " || ch == "\t") { e = e - 1; } else { break; }
        }
        return s.Substring(0, e);
    }

    /// True if `after` begins with `word` followed by a non-identifier char.
    static bool StartsWithWord(string after, string word) {
        int wl = word.Length;
        if (after.Length < wl) { return false; }
        if (after.Substring(0, wl) != word) { return false; }
        if (after.Length == wl) { return true; }
        return !CodeEditor.IsIdentChar(after.Substring(wl, 1));
    }

    /// True if the line declares a type named `word` (class/struct/enum/interface).
    static bool IsTypeDecl(string line, string word) {
        string s = CodeEditor.LTrim(line);
        List<string> kws = new List<string>{
            "class ", "struct ", "enum ", "interface ", "namespace " };
        for (int i = 0; i < kws.Count; i = i + 1) {
            string kw = kws[i];
            if (s.Length >= kw.Length && s.Substring(0, kw.Length) == kw) {
                string after = s.Substring(kw.Length, s.Length - kw.Length);
                if (ZanIDE.StartsWithWord(CodeEditor.LTrim(after), word)) { return true; }
            }
        }
        return false;
    }

    /// Index of a whole-word `word(` occurrence in s, or -1.
    static int FindWordCall(string s, string word) {
        int wl = word.Length;
        if (wl == 0) { return 0 - 1; }
        for (int i = 0; i + wl < s.Length; i = i + 1) {
            if (s.Substring(i, wl) == word && s.Substring(i + wl, 1) == "(") {
                bool leftOk = true;
                if (i > 0) { leftOk = !CodeEditor.IsIdentChar(s.Substring(i - 1, 1)); }
                if (leftOk) { return i; }
            }
        }
        return 0 - 1;
    }

    /// Heuristic: the line is a method/function definition header for `word`
    /// (a return-type token precedes `word(` and the line opens a block / ends
    /// the signature), as opposed to a call site.
    static bool IsMethodDef(string line, string word) {
        string s = CodeEditor.LTrim(line);
        if (ZanIDE.StartsWithWord(s, "if") || ZanIDE.StartsWithWord(s, "while")
            || ZanIDE.StartsWithWord(s, "for") || ZanIDE.StartsWithWord(s, "foreach")
            || ZanIDE.StartsWithWord(s, "switch") || ZanIDE.StartsWithWord(s, "return")
            || ZanIDE.StartsWithWord(s, "else")) { return false; }
        int pos = ZanIDE.FindWordCall(s, word);
        if (pos <= 0) { return false; }
        if (s.Substring(pos - 1, 1) != " ") { return false; }
        string rt = ZanIDE.RTrimS(s);
        if (rt.Length == 0) { return false; }
        string last = rt.Substring(rt.Length - 1, 1);
        return last == "{" || last == ")";
    }

    /// First line index declaring `word` in `body` (type decls first, then
    /// method definitions), or -1 when not found.
    static int FindDeclLine(string body, string word) {
        List<string> ls = CodeEditor.SplitLines(body);
        for (int i = 0; i < ls.Count; i = i + 1) {
            if (ZanIDE.IsTypeDecl(ls[i], word)) { return i; }
        }
        for (int k = 0; k < ls.Count; k = k + 1) {
            if (ZanIDE.IsMethodDef(ls[k], word)) { return k; }
        }
        return 0 - 1;
    }

    /// Net brace-nesting change contributed by one source line, ignoring
    /// braces inside string/char literals or after a `//` line comment.
    static int OutlineBraceDelta(string line) {
        int delta = 0;
        bool inStr = false;
        bool inChar = false;
        for (int i = 0; i < line.Length; i = i + 1) {
            string ch = line.Substring(i, 1);
            if (inStr) {
                if (ch == "\\") { i = i + 1; }
                else if (ch == "\"") { inStr = false; }
            } else if (inChar) {
                if (ch == "\\") { i = i + 1; }
                else if (ch == "'") { inChar = false; }
            } else {
                if (ch == "/" && i + 1 < line.Length && line.Substring(i + 1, 1) == "/") {
                    return delta;
                } else if (ch == "\"") { inStr = true; }
                else if (ch == "'") { inChar = true; }
                else if (ch == "{") { delta = delta + 1; }
                else if (ch == "}") { delta = delta - 1; }
            }
        }
        return delta;
    }

    /// True when `ch` is an identifier character. Uses a whitelist lookup
    /// rather than string range comparisons, which are unreliable here.
    static bool OutlineIsIdentChar(string ch) {
        string ok = "abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ0123456789_";
        return ZanIDE.OutlineFind(ok, ch) >= 0;
    }

    /// Leading identifier of a token ("Foo<T>" -> "Foo", "bar;" -> "bar").
    static string OutlineIdent(string tok) {
        string outp = "";
        for (int i = 0; i < tok.Length; i = i + 1) {
            string ch = tok.Substring(i, 1);
            if (ZanIDE.OutlineIsIdentChar(ch)) { outp = outp + ch; }
            else { break; }
        }
        return outp;
    }

    /// Index of the first occurrence of single-char `ch` in `s`, or -1.
    static int OutlineFind(string s, string ch) {
        for (int i = 0; i < s.Length; i = i + 1) {
            if (s.Substring(i, 1) == ch) { return i; }
        }
        return 0 - 1;
    }

    /// The type name declared on `s` (class/struct/enum/interface), or "".
    static string OutlineTypeName(string s) {
        List<string> toks = ZanIDE.SplitSpaces(s);
        for (int i = 0; i < toks.Count; i = i + 1) {
            string tk = toks[i];
            if (tk == "class" || tk == "struct" || tk == "enum" || tk == "interface") {
                if (i + 1 < toks.Count) { return ZanIDE.OutlineIdent(toks[i + 1]); }
                return "";
            }
        }
        return "";
    }

    /// "Name()" when `s` is a method/ctor definition header, else "".
    static string OutlineMethodName(string s) {
        int paren = ZanIDE.OutlineFind(s, "(");
        if (paren <= 0) { return ""; }
        string header = s.Substring(0, paren);
        if (ZanIDE.OutlineFind(header, "=") >= 0) { return ""; }
        string rt = ZanIDE.RTrimS(s);
        if (rt.Length == 0) { return ""; }
        string last = rt.Substring(rt.Length - 1, 1);
        if (last != "{" && last != ")") { return ""; }
        List<string> toks = ZanIDE.SplitSpaces(header);
        if (toks.Count < 2) { return ""; }
        string name = ZanIDE.OutlineIdent(toks[toks.Count - 1]);
        if (name == "") { return ""; }
        if (name == "if" || name == "while" || name == "for" || name == "foreach"
            || name == "switch" || name == "catch" || name == "lock" || name == "using") {
            return "";
        }
        return name + "()";
    }

    /// The field name when `s` is a field declaration, else "".
    static string OutlineFieldName(string s) {
        string rt = ZanIDE.RTrimS(s);
        if (rt.Length == 0) { return ""; }
        if (rt.Substring(rt.Length - 1, 1) != ";") { return ""; }
        string decl = rt.Substring(0, rt.Length - 1);
        int eq = ZanIDE.OutlineFind(decl, "=");
        if (eq >= 0) { decl = decl.Substring(0, eq); }
        if (ZanIDE.OutlineFind(decl, "(") >= 0) { return ""; }
        List<string> toks = ZanIDE.SplitSpaces(decl);
        if (toks.Count < 2) { return ""; }
        string first = toks[0];
        if (first == "return" || first == "using" || first == "namespace"
            || first == "throw" || first == "break" || first == "continue"
            || first == "case" || first == "default") {
            return "";
        }
        return ZanIDE.OutlineIdent(toks[toks.Count - 1]);
    }

    /// Builds a navigable code-structure outline of a source buffer for the
    /// IDE's STRUCTURE panel: each top-level type becomes an expandable node
    /// whose children are the type's direct methods and fields. Each node's
    /// `path` carries the 0-based line to jump to. Best-effort and brace-depth
    /// driven, so it stays responsive on large files without a full parse.
    static List<TreeNode> BuildOutline(string body) {
        List<TreeNode> outp = new List<TreeNode>();
        List<string> ls = CodeEditor.SplitLines(body);
        int depth = 0;
        int bodyDepth = 0 - 1;
        for (int i = 0; i < ls.Count; i = i + 1) {
            string raw = ls[i];
            string s = CodeEditor.LTrim(raw);
            int startDepth = depth;
            bool isComment = false;
            if (s.Length >= 1 && s.Substring(0, 1) == "*") { isComment = true; }
            if (s.Length >= 2) {
                string p2 = s.Substring(0, 2);
                if (p2 == "//" || p2 == "/*") { isComment = true; }
            }
            if (!isComment) {
                if (startDepth == 0) {
                    string tn = ZanIDE.OutlineTypeName(s);
                    if (tn != "") {
                        TreeNode n = TreeNode.Dir(tn, 0, true);
                        n.icon = "code";
                        n.path = Convert.ToString(i);
                        outp.Add(n);
                        bodyDepth = 1;
                    }
                } else if (bodyDepth >= 0 && startDepth == bodyDepth) {
                    string mn = ZanIDE.OutlineMethodName(s);
                    if (mn != "") {
                        TreeNode n = TreeNode.FileIcon(mn, 1, "play");
                        n.path = Convert.ToString(i);
                        outp.Add(n);
                    } else {
                        string fn = ZanIDE.OutlineFieldName(s);
                        if (fn != "") {
                            TreeNode n = TreeNode.FileIcon(fn, 1, "minus");
                            n.path = Convert.ToString(i);
                            outp.Add(n);
                        }
                    }
                }
            }
            depth = depth + ZanIDE.OutlineBraceDelta(raw);
            if (depth < 0) { depth = 0; }
        }
        return outp;
    }

    /// A small icon hint for a designer control type.
    static string ComponentIcon(string type) {
        if (type == "Label") { return "font"; }
        if (type == "Button") { return "grid"; }
        if (type == "Input" || type == "TextBox" || type == "TextArea") { return "edit"; }
        if (type == "Checkbox" || type == "Radio" || type == "Switch") { return "check"; }
        if (type == "Image") { return "image"; }
        if (type == "Table" || type == "Grid" || type == "TreeView") { return "table"; }
        return "layout";
    }

    /// Depth-first flattens the designer's (possibly nested) field tree into
    /// `outp`, so tree rows and selections can address fields by flat index.
    static void FlattenFields(List<FormField> fields, List<FormField> outp) {
        for (int i = 0; i < fields.Count; i = i + 1) {
            outp.Add(fields[i]);
            if (fields[i].IsContainer()) {
                ZanIDE.FlattenFields(fields[i].kids, outp);
            }
        }
    }

    /// Builds the designer component tree from the unified designer's field
    /// model: the form as the root node with each field as a descendant
    /// (label "name : Type", container children indented one level deeper).
    /// A node's `path` carries the field's flat index for click-to-select.
    static List<TreeNode> BuildFieldTree(string formName, List<FormField> fields) {
        List<TreeNode> outp = new List<TreeNode>();
        TreeNode root = TreeNode.Dir(formName, 0, true);
        root.icon = "layout";
        root.path = "@form";
        outp.Add(root);
        List<FormField> flat = new List<FormField>();
        ZanIDE.FlattenFields(fields, flat);
        ZanIDE.AddFieldNodes(outp, fields, flat, 1);
        return outp;
    }

    /// Scene component tree for the sidebar STRUCTURE panel: the scene file as
    /// root, then every element topmost-first. Node paths hold the element's
    /// index into OrderedByZ() so clicks map back to the canvas selection.
    static List<TreeNode> BuildSceneTree(string sceneName, SceneDesigner sd) {
        List<TreeNode> outp = new List<TreeNode>();
        TreeNode root = TreeNode.Dir(sceneName, 0, true);
        root.icon = "layout";
        root.path = "@scene";
        outp.Add(root);
        List<SceneElement> ord = sd.OrderedByZ();
        for (int i = ord.Count - 1; i >= 0; i = i - 1) {
            SceneElement e = ord[i];
            string nm = SceneDesigner.KindLabel(e.Kind());
            if (e.Name().Length > 0) { nm = nm + " · " + e.Name(); }
            if (e.Locked()) { nm = "◈ " + nm; }
            TreeNode n = TreeNode.FileIcon(nm, 1, "layout");
            n.path = Convert.ToString(i);
            outp.Add(n);
        }
        return outp;
    }

    static void AddFieldNodes(List<TreeNode> outp, List<FormField> fields,
                              List<FormField> flat, int depth) {
        for (int i = 0; i < fields.Count; i = i + 1) {
            FormField f = fields[i];
            string nm = f.fname;
            if (nm.Length == 0) { nm = f.label; }
            TreeNode n = TreeNode.FileIcon(nm + " : " + FormField.TypeName(f.ftype), depth, "layout");
            for (int fi = 0; fi < flat.Count; fi = fi + 1) {
                if (flat[fi] == f) { n.path = Convert.ToString(fi); fi = flat.Count; }
            }
            outp.Add(n);
            if (f.IsContainer()) {
                ZanIDE.AddFieldNodes(outp, f.kids, flat, depth + 1);
            }
        }
    }

    /// Parses a decimal line index previously stored in a TreeNode.path by
    /// BuildOutline; returns -1 when the node carries no line.
    static int OutlineLineOf(string path) {
        if (path == "") { return 0 - 1; }
        string digits = "0123456789";
        int val = 0;
        for (int i = 0; i < path.Length; i = i + 1) {
            string ch = path.Substring(i, 1);
            int d = ZanIDE.OutlineFind(digits, ch);
            if (d < 0) { return 0 - 1; }
            val = val * 10 + d;
        }
        return val;
    }

    /// Loads the project's saved user components (components/*.zcomp) into the
    /// designer's "My Components" palette group.
    static void LoadUserComponents(string root, Designer d) {
        List<UserComponent> comps = new List<UserComponent>();
        string dir = root + "/components";
        if (Directory.Exists(dir)) {
            List<string> files = Directory.GetFiles(dir);
            for (int i = 0; i < files.Count; i = i + 1) {
                string nm = files[i];
                if (nm.Length > 6 && nm.Substring(nm.Length - 6, 6) == ".zcomp") {
                    comps.Add(new UserComponent(nm.Substring(0, nm.Length - 6),
                        File.ReadAllText(dir + "/" + nm)));
                }
            }
        }
        d.SetUserComponents(comps);
    }

    /// Keeps only identifier-safe characters (letters, digits, underscore) of a
    /// display name, for use as a component file / type name.
    static string SanitizeName(string s) {
        string ok = "abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ0123456789_";
        string r = "";
        for (int i = 0; i < s.Length; i = i + 1) {
            string ch = s.Substring(i, 1);
            int j = 0;
            while (j < ok.Length) {
                if (ok.Substring(j, 1) == ch) { r = r + ch; j = ok.Length; }
                else { j = j + 1; }
            }
        }
        return r;
    }

    /// True when `name` is a stdlib class name that would conflict with the
    /// class generated by the form designer's code-behind (e.g. "App" clashes
    /// with the Gui.App type used inside every code-behind as `App app = ...`).
    static bool IsGuiReservedName(string name) {
        // Gui namespace: App, Canvas, Window, Layer, Theme, Designer
        // Gui.Widget: Button, Label, Input, Slider, Panel, TreeNode, CodeEditor
        // System: String, Convert, Math, File, Directory, Path, Process, List, Timer
        List<string> reserved = new List<string>{
            "App", "Canvas", "Window", "Layer", "Theme", "Designer",
            "Button", "Label", "Input", "Slider", "Panel", "TreeNode", "CodeEditor",
            "String", "Convert", "Math", "File", "Directory", "Path", "Process",
            "List", "Timer", "Program", "System", "Gui" };
        for (int i = 0; i < reserved.Count; i = i + 1) {
            if (reserved[i] == name) { return true; }
        }
        return false;
    }

    /// Recursively collects every .zan file path under `dir`.
    static List<string> ListZanFiles(string dir) {
        List<string> outp = new List<string>();
        ZanIDE.CollectZan(dir, outp);
        return outp;
    }

    /// First source file of the directory named `name` under `dir` (recursive),
    /// or "". Namespaces map onto directories, so this is how a namespace name
    /// -- which has no declaration line to jump to -- resolves to a file.
    static string FindNamespaceDirFile(string dir, string name) {
        if (!Directory.Exists(dir)) { return ""; }
        List<string> subs = Directory.GetDirectories(dir);
        for (int i = 0; i < subs.Count; i = i + 1) {
            string sub = dir + "/" + subs[i];
            if (subs[i] == name) {
                List<string> inner = ZanIDE.ListZanFiles(sub);
                if (inner.Count > 0) { return inner[0]; }
            }
            string deep = ZanIDE.FindNamespaceDirFile(sub, name);
            if (deep != "") { return deep; }
        }
        return "";
    }

    static void CollectZan(string dir, List<string> outp) {
        if (!Directory.Exists(dir)) { return; }
        List<string> files = Directory.GetFiles(dir);
        for (int i = 0; i < files.Count; i = i + 1) {
            string nm = files[i];
            if (nm.Length > 4 && nm.Substring(nm.Length - 4, 4) == ".zan") {
                outp.Add(dir + "/" + nm);
            } else if (nm.Length > 6 && nm.Substring(nm.Length - 6, 6) == ".zform") {
                outp.Add(dir + "/" + nm);
            }
        }
        List<string> subs = Directory.GetDirectories(dir);
        for (int j = 0; j < subs.Count; j = j + 1) {
            // Build output holds generated copies of the sources; searching it
            // reports every hit twice, in a file the user cannot edit.
            string sn = subs[j];
            if (sn.StartsWith(".") || sn == "build" || sn == "bin" || sn == "obj") {
                continue;
            }
            ZanIDE.CollectZan(dir + "/" + sn, outp);
        }
    }

    /// Column of `word` on line `ln` of `body`, or 0. A jump used to leave the
    /// caret in the destination line's indentation, so the next command asked
    /// about whatever word the line started with instead of the symbol.
    static int ColOfWordAt(string body, int ln, string word) {
        if (word.Length == 0) { return 0; }
        List<string> ls = CodeEditor.SplitLines(body);
        if (ln < 0 || ln >= ls.Count) { return 0; }
        int p = CodeEditor.FindWordFrom(ls[ln], word, 0);
        if (p < 0) { return 0; }
        return p;
    }

    /// Every file on disk the navigation commands search: the project sources,
    /// then the stdlib (whose sources are browsable here, and where most of what
    /// a project calls is declared).
    ///
    /// Walking the stdlib means walking a thousand-odd files, which made every
    /// unresolved jump crawl: the list is built once per project and reused
    /// until the project changes or its index is rebuilt (save / build).
    static List<string> NavSearchFiles(string root) {
        if (ZanIDE.navFiles != null && ZanIDE.navFilesRoot == root) {
            return ZanIDE.navFiles;
        }
        List<string> files = ZanIDE.ListZanFiles(root + "/src");
        List<string> std = ZanIDE.ListZanFiles(ZanIDE.StdlibDir());
        for (int i = 0; i < std.Count; i = i + 1) { files.Add(std[i]); }
        ZanIDE.navFiles = files;
        ZanIDE.navFilesRoot = root;
        return files;
    }

    /// Forgets the cached search list, so a file added since is found.
    static void InvalidateNavFiles() {
        ZanIDE.navFiles = null;
        ZanIDE.navFilesRoot = "";
        ZanIDE.projSrcPaths = null;
        ZanIDE.projSrcRoot = "";
    }

    /// The source of every project file plus the other open tabs, with the live
    /// text of anything open. The editor needs it to count the uses of a member
    /// that live in files other than the one being edited (its reference counts
    /// used to see one buffer, so a method called from elsewhere read "0
    /// references"). Read once per project, kept until the project changes or
    /// its index is rebuilt.
    static List<string> ProjectSources(List<TabRecord> tabs, string root,
                                       int skipTab) {
        if (ZanIDE.projSrcPaths == null || ZanIDE.projSrcRoot != root) {
            ZanIDE.projSrcPaths = new List<string>();
            ZanIDE.projSrcBodies = new List<string>();
            List<string> all = ZanIDE.ListZanFiles(root);
            for (int i = 0; i < all.Count; i = i + 1) {
                if (!all[i].EndsWith(".zan")) { continue; }
                ZanIDE.projSrcPaths.Add(all[i]);
                ZanIDE.projSrcBodies.Add(File.ReadAllText(all[i]));
            }
            ZanIDE.projSrcRoot = root;
        }
        List<string> outp = new List<string>();
        for (int i = 0; i < ZanIDE.projSrcPaths.Count; i = i + 1) {
            int t = ZanIDE.FindTabByPath(tabs, ZanIDE.projSrcPaths[i]);
            if (t == skipTab) { continue; }
            if (t >= 0) { outp.Add(tabs[t].body); }
            else { outp.Add(ZanIDE.projSrcBodies[i]); }
        }
        for (int j = 0; j < tabs.Count; j = j + 1) {
            if (j == skipTab) { continue; }
            if (tabs[j].path.Length == 0 || tabs[j].path == "@start"
                || tabs[j].path == "@docs") { continue; }
            if (!tabs[j].path.EndsWith(".zan")) { continue; }
            if (ZanIDE.HasSamePath(ZanIDE.projSrcPaths, tabs[j].path)) { continue; }
            outp.Add(tabs[j].body);
        }
        return outp;
    }

    /// True when `paths` holds `p` (path equality, not string equality).
    static bool HasSamePath(List<string> paths, string p) {
        for (int i = 0; i < paths.Count; i = i + 1) {
            if (ZanIDE.SamePath(paths[i], p)) { return true; }
        }
        return false;
    }

    /// `files` reordered so the ones named after `hint` come first: a type lives
    /// in the file named after it far more often than not, so the search reads
    /// one file instead of the whole stdlib before it answers.
    static List<string> NameFirst(List<string> files, string hint) {
        if (hint.Length == 0) { return files; }
        List<string> head = new List<string>();
        List<string> tail = new List<string>();
        for (int i = 0; i < files.Count; i = i + 1) {
            string b = Path.GetFileName(files[i]);
            int dot = ZanIDE.IndexOfStr(b, ".");
            if (dot > 0) { b = b.Substring(0, dot); }
            if (b == hint) { head.Add(files[i]); } else { tail.Add(files[i]); }
        }
        for (int j = 0; j < tail.Count; j = j + 1) { head.Add(tail[j]); }
        return head;
    }

    /// Where type `owner` declares `member`, as "file:line" for the log, or "".
    /// Nothing is opened and no tab is switched: this only names the place.
    static string FindMemberDeclFile(List<TabRecord> tabs, string root,
                                     string owner, string member) {
        for (int i = 0; i < tabs.Count; i = i + 1) {
            int ln = CodeEditor.FindMemberDeclLineIn(
                CodeEditor.SplitLines(tabs[i].body), owner, member);
            if (ln >= 0) {
                return tabs[i].name + ":" + Convert.ToString(ln + 1);
            }
        }
        List<string> files = ZanIDE.NameFirst(ZanIDE.NavSearchFiles(root), owner);
        for (int fi = 0; fi < files.Count; fi = fi + 1) {
            if (ZanIDE.FindTabByPath(tabs, files[fi]) >= 0) { continue; }
            int ln = CodeEditor.FindMemberDeclLineIn(
                CodeEditor.SplitLines(File.ReadAllText(files[fi])), owner, member);
            if (ln >= 0) {
                return Path.GetFileName(files[fi]) + ":" + Convert.ToString(ln + 1);
            }
        }
        return "";
    }

    /// Jumps to where type `owner` declares `member`, searching the open tabs
    /// first and then the project and stdlib sources. Returns the line, or -1
    /// when that type has no such member on disk.
    static int FindMemberDecl(List<TabRecord> tabs, SignalInt active, string root,
                              string owner, string member, List<string> log) {
        int a = active.Get();
        if (a >= 0 && a < tabs.Count) {
            int ln = CodeEditor.FindMemberDeclLineIn(
                CodeEditor.SplitLines(tabs[a].body), owner, member);
            if (ln >= 0) {
                log.Add("> Definition of '" + owner + "." + member
                    + "' at line " + Convert.ToString(ln + 1) + " (this file).");
                return ln;
            }
        }
        for (int i = 0; i < tabs.Count; i = i + 1) {
            if (i == a) { continue; }
            int ln = CodeEditor.FindMemberDeclLineIn(
                CodeEditor.SplitLines(tabs[i].body), owner, member);
            if (ln >= 0) {
                active.Set(i);
                log.Add("> Definition of '" + owner + "." + member + "' in "
                    + tabs[i].name + " at line " + Convert.ToString(ln + 1) + ".");
                return ln;
            }
        }
        List<string> files = ZanIDE.NameFirst(ZanIDE.NavSearchFiles(root), owner);
        for (int fi = 0; fi < files.Count; fi = fi + 1) {
            string fp = files[fi];
            if (ZanIDE.FindTabByPath(tabs, fp) >= 0) { continue; }
            int ln = CodeEditor.FindMemberDeclLineIn(
                CodeEditor.SplitLines(File.ReadAllText(fp)), owner, member);
            if (ln >= 0) {
                ZanIDE.OpenPath(tabs, active, fp, Path.GetFileName(fp));
                log.Add("> Definition of '" + owner + "." + member + "' in "
                    + Path.GetFileName(fp) + " at line "
                    + Convert.ToString(ln + 1) + ".");
                return ln;
            }
        }
        return 0 - 1;
    }

    /// Finds the definition of the symbol under the caret across the current
    /// file, other open tabs, then the project's src tree. Switches/opens the
    /// target tab and returns the destination line (-1 when not found).
    static int GoToDefinition(CodeEditor editor, List<TabRecord> tabs,
                              SignalInt active, string root, List<string> log) {
        string word = editor.WordAtCaret();
        if (word == "") { log.Add("> Go to Definition: no symbol under caret."); return 0 - 1; }
        int a = active.Get();
        if (a >= 0 && a < tabs.Count) { tabs[a].body = editor.GetText(); }
        // A member access says which type declares the symbol, so the search is
        // for that type's member rather than for the first same-named thing in
        // the project (`WebApp.Create` used to land on another type's Create).
        string owner = editor.OwnerTypeAtCaret();
        if (owner.Length > 0) {
            int ml = ZanIDE.FindMemberDecl(tabs, active, root, owner, word, log);
            if (ml >= 0) { return ml; }
            // The receiver's type is indexed and has no such member: landing on
            // a same-named member of an unrelated type (`app.maxBodyMB` used to
            // open Cfg's field) is worse than saying so.
            if (CodeEditor.SymbolTypeLacksMember(owner, word)) {
                log.Add("> Go to Definition: '" + word + "' is not a member of '"
                    + owner + "'.");
                return 0 - 1;
            }
        }
        if (a >= 0 && a < tabs.Count) {
            int ln = ZanIDE.FindDeclLine(tabs[a].body, word);
            if (ln >= 0) {
                log.Add("> Definition of '" + word + "' at line " + Convert.ToString(ln + 1) + " (this file).");
                return ln;
            }
        }
        for (int i = 0; i < tabs.Count; i = i + 1) {
            if (i != a) {
                int ln = ZanIDE.FindDeclLine(tabs[i].body, word);
                if (ln >= 0) {
                    active.Set(i);
                    log.Add("> Definition of '" + word + "' in " + tabs[i].name
                        + " at line " + Convert.ToString(ln + 1) + ".");
                    return ln;
                }
            }
        }
        // Most symbols a project uses are declared in the stdlib, and stdlib
        // sources are browsable/openable here, so search them after the project
        // instead of reporting "not found in project".
        List<string> files = ZanIDE.NameFirst(ZanIDE.NavSearchFiles(root), word);
        for (int fi = 0; fi < files.Count; fi = fi + 1) {
            string fp = files[fi];
            if (ZanIDE.FindTabByPath(tabs, fp) < 0) {
                string body = File.ReadAllText(fp);
                int ln = ZanIDE.FindDeclLine(body, word);
                if (ln >= 0) {
                    ZanIDE.OpenPath(tabs, active, fp, Path.GetFileName(fp));
                    log.Add("> Definition of '" + word + "' in " + Path.GetFileName(fp)
                        + " at line " + Convert.ToString(ln + 1) + ".");
                    return ln;
                }
            }
        }
        // Namespaces (`using System.Web;`) declare nothing, so fall back to the
        // directory that backs them and open its first source file.
        string nsFile = ZanIDE.FindNamespaceDirFile(ZanIDE.StdlibDir(), word);
        if (nsFile == "") { nsFile = ZanIDE.FindNamespaceDirFile(root + "/src", word); }
        if (nsFile != "") {
            int nsTab = ZanIDE.FindTabByPath(tabs, nsFile);
            if (nsTab < 0) {
                ZanIDE.OpenPath(tabs, active, nsFile, Path.GetFileName(nsFile));
            } else {
                active.Set(nsTab);
            }
            log.Add("> Namespace '" + word + "' -> " + Path.GetFileName(nsFile) + ".");
            return 0;
        }
        log.Add("> Go to Definition: '" + word + "' not found in project.");
        return 0 - 1;
    }

    /// Case-insensitive path equality with slash normalization (Windows
    /// paths mix separators; LSP URIs always use forward slashes).
    static bool SamePath(string a, string b) {
        return ZanIDE.NormPath(a) == ZanIDE.NormPath(b);
    }

    static string NormPath(string p) {
        string o = "";
        for (int i = 0; i < p.Length; i = i + 1) {
            string ch = p.Substring(i, 1);
            if (ch == "\\") { o = o + "/"; } else { o = o + ch; }
        }
        return ZanIDE.ToLowerS(o);
    }

    /// Go to Definition preferring zan-lsp semantic results (compiler
    /// binder/checker accuracy), with the text-scan heuristic as fallback.
    static int GoToDefinitionSmart(LspSession lsp, CodeEditor editor, List<TabRecord> tabs,
                                   SignalInt active, string root, List<string> log) {
        int a = active.Get();
        // The server indexes the project root only; querying it about a file
        // outside that root (a stdlib source, say) costs a round trip that can
        // never answer, so go straight to the text scan there.
        bool inRoot = a >= 0 && a < tabs.Count
            && ZanIDE.NormPath(tabs[a].path).StartsWith(ZanIDE.NormPath(root));
        if (lsp != null && lsp.Alive() && inRoot && tabs[a].path.Length > 0) {
            tabs[a].body = editor.GetText();
            lsp.SyncDoc(tabs[a].path, tabs[a].body);
            string hit = lsp.Definition(tabs[a].path, editor.CurLine(), editor.CurCol());
            int sep = ZanIDE.IndexOfStr(hit, "\t");
            if (sep > 0) {
                string defPath = hit.Substring(0, sep);
                int ln = ZanIDE.ParseInt(hit.Substring(sep + 1, hit.Length - sep - 1));
                if (ZanIDE.SamePath(defPath, tabs[a].path)) {
                    log.Add("> Definition at line " + Convert.ToString(ln + 1) + " (this file).");
                    return ln;
                }
                for (int ti = 0; ti < tabs.Count; ti = ti + 1) {
                    if (ZanIDE.SamePath(defPath, tabs[ti].path)) {
                        active.Set(ti);
                        log.Add("> Definition in " + tabs[ti].name + " at line " + Convert.ToString(ln + 1) + ".");
                        return ln;
                    }
                }
                if (File.Exists(defPath)) {
                    ZanIDE.OpenPath(tabs, active, defPath, Path.GetFileName(defPath));
                    log.Add("> Definition in " + Path.GetFileName(defPath) + " at line " + Convert.ToString(ln + 1) + ".");
                    return ln;
                }
            }
        }
        return ZanIDE.GoToDefinition(editor, tabs, active, root, log);
    }

    /// Counts whole-word occurrences of `word` in `line`.
    static int CountWord(string line, string word) {
        int wl = word.Length;
        if (wl == 0) { return 0; }
        int count = 0;
        int i = 0;
        while (i + wl <= line.Length) {
            if (line.Substring(i, wl) == word) {
                bool leftOk = true;
                bool rightOk = true;
                if (i > 0) { leftOk = !CodeEditor.IsIdentChar(line.Substring(i - 1, 1)); }
                if (i + wl < line.Length) { rightOk = !CodeEditor.IsIdentChar(line.Substring(i + wl, 1)); }
                if (leftOk && rightOk) { count = count + 1; i = i + wl; }
                else { i = i + 1; }
            } else { i = i + 1; }
        }
        return count;
    }

    /// Every use of the symbol under the caret as clickable hits, for the
    /// reference list: zan-lsp's semantic answer when the server is up, else a
    /// whole-word text scan of the open tabs and the project's files. Paths are
    /// absolute, so a hit opens the file it lives in.
    static List<SearchHit> CollectReferences(LspSession lsp, CodeEditor editor,
                                            List<TabRecord> tabs,
                                            SignalInt active, string root) {
        List<SearchHit> hits = new List<SearchHit>();
        string word = editor.WordAtCaret();
        if (word.Length == 0) { return hits; }
        int a = active.Get();
        if (a >= 0 && a < tabs.Count) { tabs[a].body = editor.GetText(); }
        // The server indexes the project root only: querying it about a file
        // outside that root (a stdlib source, say) costs a round trip that can
        // never answer, so go straight to the text scan there.
        bool inRoot = a >= 0 && a < tabs.Count
            && ZanIDE.NormPath(tabs[a].path).StartsWith(ZanIDE.NormPath(root));
        if (lsp != null && lsp.Alive() && inRoot && tabs[a].path.Length > 0) {
            lsp.SyncDoc(tabs[a].path, tabs[a].body);
            List<string> rows = lsp.References(
                tabs[a].path, editor.CurLine(), editor.CurCol());
            // One file is read once even when it holds twenty of the hits.
            string cachePath = "";
            List<string> cacheLines = new List<string>();
            for (int i = 0; i < rows.Count; i = i + 1) {
                int sep = ZanIDE.IndexOfStr(rows[i], "\t");
                if (sep <= 0) { continue; }
                string rp = rows[i].Substring(0, sep);
                int ln = ZanIDE.ParseInt(
                    rows[i].Substring(sep + 1, rows[i].Length - sep - 1));
                if (rp != cachePath) {
                    cachePath = rp;
                    cacheLines = ZanIDE.SourceLines(tabs, rp);
                }
                string prev = "";
                if (ln >= 0 && ln < cacheLines.Count) {
                    prev = CodeEditor.LTrim(cacheLines[ln]);
                }
                hits.Add(SearchHit.Create(rp, ln, prev));
            }
            if (hits.Count > 0) { return hits; }
        }
        // For a member access the references are the uses of THAT type's member,
        // not of every same-named member in the project.
        string owner = editor.OwnerTypeAtCaret();
        if (owner.Length == 0) { owner = editor.EnclosingTypeOfCaretDecl(); }
        if (owner.Length > 0 && CodeEditor.SymbolTypeLacksMember(owner, word)) {
            return hits;
        }
        for (int i = 0; i < tabs.Count; i = i + 1) {
            if (!tabs[i].path.EndsWith(".zan")) { continue; }
            ZanIDE.CollectRefsInFile(tabs[i].path, tabs[i].body, word, owner, hits);
        }
        List<string> files = ZanIDE.ListZanFiles(root);
        for (int fi = 0; fi < files.Count; fi = fi + 1) {
            string fp = files[fi];
            if (ZanIDE.FindTabByPath(tabs, fp) >= 0) { continue; }
            if (!File.Exists(fp)) { continue; }
            ZanIDE.CollectRefsInFile(fp, File.ReadAllText(fp), word, owner, hits);
        }
        return hits;
    }

    /// The uses of `word` in one file as hits, with the source line as their
    /// preview. `owner` restricts them to that type's member. The list is capped
    /// so a name like `Create` cannot build a 50k-row panel.
    static void CollectRefsInFile(string path, string body, string word,
                                  string owner, List<SearchHit> hits) {
        List<string> ls = CodeEditor.SplitLines(body);
        List<int> lns = new List<int>();
        if (owner.Length > 0) {
            CodeEditor.CountMemberRefsIn(ls, word, owner, lns);
        } else {
            for (int i = 0; i < ls.Count; i = i + 1) {
                if (ZanIDE.CountWord(ls[i], word) > 0) { lns.Add(i); }
            }
        }
        for (int h = 0; h < lns.Count; h = h + 1) {
            if (hits.Count >= 2000) { return; }
            hits.Add(SearchHit.Create(path, lns[h], CodeEditor.LTrim(ls[lns[h]])));
        }
    }

    /// The lines of `path`, from the open tab when it is open (so an unsaved
    /// edit previews correctly) and from disk otherwise. Empty when it is gone.
    static List<string> SourceLines(List<TabRecord> tabs, string path) {
        int t = ZanIDE.FindTabByPath(tabs, path);
        if (t >= 0) { return CodeEditor.SplitLines(tabs[t].body); }
        if (!File.Exists(path)) { return new List<string>(); }
        return CodeEditor.SplitLines(File.ReadAllText(path));
    }

    /// Replaces whole-word occurrences of `word` with `newName`, skipping
    /// string/char literals and line/block comments (same rules as zan-lsp).
    static string ReplaceWholeWord(string text, string word, string newName) {
        string outp = "";
        int i = 0;
        int n = text.Length;
        while (i < n) {
            string ch = text.Substring(i, 1);
            if (ch == "/" && i + 1 < n && text.Substring(i + 1, 1) == "/") {
                int j = i;
                while (j < n && text.Substring(j, 1) != "\n") { j = j + 1; }
                outp = outp + text.Substring(i, j - i);
                i = j;
            } else if (ch == "/" && i + 1 < n && text.Substring(i + 1, 1) == "*") {
                int j = i + 2;
                while (j + 1 < n && !(text.Substring(j, 1) == "*" && text.Substring(j + 1, 1) == "/")) { j = j + 1; }
                if (j + 1 < n) { j = j + 2; } else { j = n; }
                outp = outp + text.Substring(i, j - i);
                i = j;
            } else if (ch == "\"" || ch == "'") {
                int j = i + 1;
                for (j = i + 1; j < n && text.Substring(j, 1) != ch; j = j + 1) {
                    if (text.Substring(j, 1) == "\\" && j + 1 < n) { j = j + 1; }
                }
                if (j < n) { j = j + 1; }
                outp = outp + text.Substring(i, j - i);
                i = j;
            } else if (CodeEditor.IsIdentChar(ch)) {
                int j = i;
                while (j < n && CodeEditor.IsIdentChar(text.Substring(j, 1))) { j = j + 1; }
                string ident = text.Substring(i, j - i);
                if (ident == word) { outp = outp + newName; } else { outp = outp + ident; }
                i = j;
            } else {
                outp = outp + ch;
                i = i + 1;
            }
        }
        return outp;
    }

    // ================================================================
    // Find/Replace in Files (project-wide, including unopened files)
    // ================================================================

    /// Searches every project source file for `needle`, filling `outHits` and
    /// logging one row per hit. Open tabs are searched in their buffers so
    /// unsaved edits count. Returns the number of hits (capped so a one-letter
    /// query cannot flood the panel).
    static int FindInFiles(string root, string needle, bool matchCase,
                           List<TabRecord> tabs, List<SearchHit> outHits,
                           List<string> log) {
        outHits.Clear();
        if (needle == "") { return 0; }
        List<string> files = new List<string>();
        ZanIDE.GatherZanFiles(root, files);
        int hits = 0;
        int scanned = 0;
        for (int fi = 0; fi < files.Count && hits < 2000; fi = fi + 1) {
            string fp = files[fi];
            int tab = ZanIDE.FindTabByPath(tabs, fp);
            string text = "";
            if (tab >= 0) {
                text = tabs[tab].body;
            } else if (File.Exists(fp)) {
                text = File.ReadAllText(fp);
            }
            if (text != "") {
                scanned = scanned + 1;
                List<string> ls = CodeEditor.SplitLines(text);
                for (int li = 0; li < ls.Count && hits < 2000; li = li + 1) {
                    if (ZanIDE.LineContains(ls[li], needle, matchCase)) {
                        string hitText = ZanIDE.TrimLead(ls[li]);
                        outHits.Add(SearchHit.Create(fp, li, hitText));
                        log.Add("   " + fp + ":" + Convert.ToString(li + 1)
                            + ": " + hitText);
                        hits = hits + 1;
                    }
                }
            }
        }
        log.Add("> " + Convert.ToString(hits) + " match(es) for '" + needle
            + "' in " + Convert.ToString(scanned)
            + " file(s). F8 = next match, Shift+F8 = previous.");
        return hits;
    }

    /// Replaces every occurrence of `needle` with `repl` across the project.
    /// Open tabs are changed in their buffers (save to persist); other files
    /// are rewritten on disk. Returns the number of files changed.
    static int ReplaceInFiles(string root, string needle, string repl,
                              bool matchCase, List<TabRecord> tabs,
                              List<string> log) {
        if (needle == "" || needle == repl) { return 0; }
        List<string> files = new List<string>();
        ZanIDE.GatherZanFiles(root, files);
        int bufs = 0;
        int disk = 0;
        int total = 0;
        for (int fi = 0; fi < files.Count; fi = fi + 1) {
            string fp = files[fi];
            int tab = ZanIDE.FindTabByPath(tabs, fp);
            string text = "";
            if (tab >= 0) {
                text = tabs[tab].body;
            } else if (File.Exists(fp)) {
                text = File.ReadAllText(fp);
            }
            if (text != "") {
                int n = ZanIDE.CountOccurrences(text, needle, matchCase);
                if (n > 0) {
                    string nt = ZanIDE.ReplaceAllText(text, needle, repl, matchCase);
                    total = total + n;
                    if (tab >= 0) {
                        tabs[tab].body = nt;
                        bufs = bufs + 1;
                    } else {
                        File.WriteAllText(fp, nt);
                        disk = disk + 1;
                    }
                }
            }
        }
        log.Add("> Replaced " + Convert.ToString(total) + " occurrence(s) of '"
            + needle + "' with '" + repl + "': "
            + Convert.ToString(bufs) + " open tab(s), "
            + Convert.ToString(disk) + " file(s) on disk.");
        return bufs + disk;
    }

    /// Opens result `idx` of the last Find in Files run and jumps to its line.
    /// Returns the 0-based line to move the caret to, or -1.
    static int GotoSearchHit(List<SearchHit> hits, int idx,
                             List<TabRecord> tabs, SignalInt active,
                             List<string> log) {
        if (idx < 0 || idx >= hits.Count) { return 0 - 1; }
        SearchHit hit = hits[idx];
        int tab = ZanIDE.FindTabByPath(tabs, hit.path);
        if (tab < 0) {
            if (!File.Exists(hit.path)) { return 0 - 1; }
            ZanIDE.OpenPath(tabs, active, hit.path, Path.GetFileName(hit.path));
            tab = tabs.Count - 1;
        }
        active.Set(tab);
        log.Add("> Match " + Convert.ToString(idx + 1) + "/"
            + Convert.ToString(hits.Count) + ": " + Path.GetFileName(hit.path)
            + ":" + Convert.ToString(hit.line + 1));
        return hit.line;
    }

    /// True when `line` contains `needle` (case-insensitively unless asked).
    static bool LineContains(string line, string needle, bool matchCase) {
        return ZanIDE.FindOccurrence(line, needle, 0, matchCase) >= 0;
    }

    /// Offset of the first occurrence of `needle` in `hay` at or after `from`,
    /// or -1.
    static int FindOccurrence(string hay, string needle, int from, bool matchCase) {
        int nl = needle.Length;
        if (nl == 0) { return 0 - 1; }
        for (int i = from; i + nl <= hay.Length; i = i + 1) {
            string part = hay.Substring(i, nl);
            if (part == needle) { return i; }
            if (!matchCase && ZanIDE.LowerStr(part) == ZanIDE.LowerStr(needle)) {
                return i;
            }
        }
        return 0 - 1;
    }

    static int CountOccurrences(string text, string needle, bool matchCase) {
        int n = 0;
        int p = ZanIDE.FindOccurrence(text, needle, 0, matchCase);
        while (p >= 0) {
            n = n + 1;
            p = ZanIDE.FindOccurrence(text, needle, p + needle.Length, matchCase);
        }
        return n;
    }

    static string ReplaceAllText(string text, string needle, string repl,
                                 bool matchCase) {
        string outp = "";
        int at = 0;
        int p = ZanIDE.FindOccurrence(text, needle, 0, matchCase);
        while (p >= 0) {
            outp = outp + text.Substring(at, p - at) + repl;
            at = p + needle.Length;
            p = ZanIDE.FindOccurrence(text, needle, at, matchCase);
        }
        return outp + text.Substring(at, text.Length - at);
    }

    static string LowerStr(string s) {
        string outp = "";
        for (int i = 0; i < s.Length; i = i + 1) {
            int c = s[i];
            if (c >= 65 && c <= 90) { c = c + 32; }
            outp = outp + Text.CharStr(c);
        }
        return outp;
    }

    /// Drops leading spaces and tabs (search rows are shown unindented).
    static string TrimLead(string s) {
        int i = 0;
        while (i < s.Length && (s[i] == 32 || s[i] == 9)) { i = i + 1; }
        return s.Substring(i, s.Length - i);
    }

    /// Rename Symbol (F2) backed by zan-lsp: the server answers with a
    /// project-wide WorkspaceEdit, so occurrences in files that were never
    /// opened are rewritten on disk too. Open tabs are edited in their buffers
    /// (save to persist); everything else is written immediately. Falls back to
    /// the buffer-only textual rename when no language server is available.
    static int RenameSymbolSmart(LspSession lsp, CodeEditor editor,
                                 List<TabRecord> tabs, SignalInt active,
                                 List<string> log, string word, string newName) {
        if (word == "" || newName == "" || word == newName) { return 0; }
        int a = active.Get();
        if (lsp == null || !lsp.Alive() || a < 0 || a >= tabs.Count
            || tabs[a].path.Length == 0) {
            return ZanIDE.RenameSymbol(editor, tabs, active, log, word, newName);
        }

        tabs[a].body = editor.GetText();
        lsp.SyncDoc(tabs[a].path, tabs[a].body);
        List<string> rows = lsp.Rename(tabs[a].path, editor.CurLine(),
            editor.CurCol(), newName);
        if (rows.Count == 0) {
            return ZanIDE.RenameSymbol(editor, tabs, active, log, word, newName);
        }

        // Group the edits by file, keeping the server's ascending order.
        List<string> files = new List<string>();
        for (int i = 0; i < rows.Count; i = i + 1) {
            string fp = ZanIDE.RenameRowPath(rows[i]);
            if (fp != "" && ZanIDE.IndexOfPath(files, fp) < 0) { files.Add(fp); }
        }

        int bufs = 0;
        int disk = 0;
        int fi = 0;
        while (fi < files.Count) {
            string fp = files[fi];
            int tab = ZanIDE.FindTabByPath(tabs, fp);
            string text = "";
            if (tab >= 0) {
                text = tabs[tab].body;
            } else if (File.Exists(fp)) {
                text = File.ReadAllText(fp);
            } else {
                fi = fi + 1;
                continue;
            }
            string nt = ZanIDE.ApplyRenameEdits(text, rows, fp, word, newName);
            if (nt != text) {
                if (tab >= 0) {
                    tabs[tab].body = nt;
                    bufs = bufs + 1;
                } else {
                    File.WriteAllText(fp, nt);
                    disk = disk + 1;
                }
            }
            fi = fi + 1;
        }

        if (a >= 0 && a < tabs.Count) {
            int keepLine = editor.CurLine();
            editor.LoadText(tabs[a].body);
            editor.GoToLine(keepLine);
        }
        log.Add("> Renamed '" + word + "' -> '" + newName + "' (semantic): "
            + Convert.ToString(bufs) + " open tab(s), "
            + Convert.ToString(disk) + " file(s) on disk.");
        return bufs + disk;
    }

    /// Path part of a "path\tline\tcol" rename row.
    static string RenameRowPath(string row) {
        int sep = ZanIDE.IndexOfStr(row, "\t");
        if (sep <= 0) { return ""; }
        return row.Substring(0, sep);
    }

    /// Index of `path` in `paths` comparing with SamePath, or -1.
    static int IndexOfPath(List<string> paths, string path) {
        for (int i = 0; i < paths.Count; i = i + 1) {
            if (ZanIDE.SamePath(paths[i], path)) { return i; }
        }
        return 0 - 1;
    }

    /// Applies the rename rows belonging to `path` to `text`. Rows are walked
    /// back to front so an earlier edit never shifts a later column, and a row
    /// is only honoured when `word` really sits at its position (a stale
    /// position from an edit that raced the request is skipped, not corrupted).
    static string ApplyRenameEdits(string text, List<string> rows, string path,
                                   string word, string newName) {
        List<string> ls = CodeEditor.SplitLines(text);
        for (int i = rows.Count - 1; i >= 0; i = i - 1) {
            string row = rows[i];
            int s1 = ZanIDE.IndexOfStr(row, "\t");
            if (s1 > 0 && ZanIDE.SamePath(row.Substring(0, s1), path)) {
                string rest = row.Substring(s1 + 1, row.Length - s1 - 1);
                int s2 = ZanIDE.IndexOfStr(rest, "\t");
                if (s2 > 0) {
                    int ln = ZanIDE.ParseInt(rest.Substring(0, s2));
                    int co = ZanIDE.ParseInt(rest.Substring(s2 + 1, rest.Length - s2 - 1));
                    if (ln >= 0 && ln < ls.Count && co >= 0
                        && co + word.Length <= ls[ln].Length
                        && ls[ln].Substring(co, word.Length) == word) {
                        string line = ls[ln];
                        ls[ln] = line.Substring(0, co) + newName
                            + line.Substring(co + word.Length,
                                line.Length - co - word.Length);
                    }
                }
            }
        }
        string outp = "";
        for (int k = 0; k < ls.Count; k = k + 1) {
            if (k > 0) { outp = outp + "\n"; }
            outp = outp + ls[k];
        }
        return outp;
    }

    /// Rename Symbol (F2): whole-word, comment/string-aware rename of the
    /// symbol under the caret across every open tab (buffers only; save to
    /// persist). Returns the number of tabs changed.
    static int RenameSymbol(CodeEditor editor, List<TabRecord> tabs,
                            SignalInt active, List<string> log,
                            string word, string newName) {
        if (word == "" || newName == "" || word == newName) { return 0; }
        int a = active.Get();
        if (a >= 0 && a < tabs.Count) { tabs[a].body = editor.GetText(); }
        int changed = 0;
        for (int i = 0; i < tabs.Count; i = i + 1) {
            string nb = ZanIDE.ReplaceWholeWord(tabs[i].body, word, newName);
            if (nb != tabs[i].body) {
                tabs[i].body = nb;
                changed = changed + 1;
            }
        }
        if (a >= 0 && a < tabs.Count) {
            int keepLine = editor.CurLine();
            editor.LoadText(tabs[a].body);
            editor.GoToLine(keepLine);
        }
        log.Add("> Renamed '" + word + "' -> '" + newName + "' in "
            + Convert.ToString(changed) + " open tab(s). Save to persist.");
        return changed;
    }

    /// Format Document (Ctrl+E): pipes the active buffer through zanfmt
    /// (--stdout on a temp copy) and reloads the formatted result.
    static void FormatDocument(CodeEditor editor, List<string> log) {
        string exe = ZanIDE.ToolchainDir() + "/zanfmt" + ZanIDE.ExeSuffix();
        if (!File.Exists(exe)) { exe = ZanIDE.ExeDir() + "/zanfmt" + ZanIDE.ExeSuffix(); }
        if (!File.Exists(exe)) { log.Add("> Format: zanfmt not found."); return; }
        string tmp = ZanIDE.WindowCacheDir() + "/fmt_buffer.zan";
        ZanIDE.EnsureCacheDir();
        File.WriteAllText(tmp, editor.GetText());
        List<string> outp = Process.RunCapture("\"" + exe + "\" --stdout \"" + tmp + "\"");
        File.Delete(tmp);
        if (outp.Count == 0) { log.Add("> Format: zanfmt produced no output."); return; }
        string body = "";
        for (int i = 0; i < outp.Count; i = i + 1) {
            body = body + outp[i] + "\n";
        }
        int keepLine = editor.CurLine();
        editor.LoadText(body);
        editor.GoToLine(keepLine);
        log.Add("> Formatted document with zanfmt.");
    }

    // ---- designer <-> code (form serialization) ----

    /// Splits a string on runs of spaces/tabs into tokens.
    static List<string> SplitSpaces(string s) {
        List<string> outp = new List<string>();
        string cur = "";
        for (int i = 0; i < s.Length; i = i + 1) {
            string ch = s.Substring(i, 1);
            if (ch == " " || ch == "\t") {
                if (cur.Length > 0) { outp.Add(cur); cur = ""; }
            } else { cur = cur + ch; }
        }
        if (cur.Length > 0) { outp.Add(cur); }
        return outp;
    }

    static void AppendAll(List<string> log, List<string> lines) {
        for (int i = 0; i < lines.Count; i = i + 1) {
            log.Add("  " + lines[i]);
        }
    }

    // ==== C#-style form file model (.zform design file + .zan code-behind) ====

    /// True when the path names a visual form design file (opened in the designer).
    static bool IsFormPath(string p) {
        int n = p.Length;
        if (n < 6) { return false; }
        return p.Substring(n - 6, 6) == ".zform";
    }

    static bool IsScenePath(string p) {
        int n = p.Length;
        if (n < 7) { return false; }
        return p.Substring(n - 7, 7) == ".zscene";
    }

    /// Base name of a .zscene (the scene name), e.g. src/Hud.zscene -> Hud.
    static string SceneBaseName(string p) {
        string fn = Path.GetFileName(p);
        int n = fn.Length;
        if (n >= 7 && fn.Substring(n - 7, 7) == ".zscene") { return fn.Substring(0, n - 7); }
        return fn;
    }

    /// Base name of a .zform (the form/class name), e.g. src/Login.zform -> Login.
    static string FormBaseName(string p) {
        string fn = Path.GetFileName(p);
        int n = fn.Length;
        if (n >= 6 && fn.Substring(n - 6, 6) == ".zform") { return fn.Substring(0, n - 6); }
        return fn;
    }

    /// Code-behind path for a .zform, e.g. src/Login.zform -> src/Login.zan.
    /// Scans a code-behind file for bindable member variables: simple
    /// `type name;` / `type name = ...;` declarations (skipping methods,
    /// comments and the generated designer region). The designer offers the
    /// names in its bind-path picker for two-way binding.
    static List<string> ScanBindVars(string code) {
        List<string> vars = new List<string>();
        List<string> lines = CodeEditor.SplitLines(code);
        bool inRegion = false;
        int i = 0;
        while (i < lines.Count && vars.Count < 60) {
            string ln = ZanIDE.TrimStr(lines[i]);
            i = i + 1;
            if (ZanIDE.Has(ln, "ZAN-DESIGNER BEGIN")) { inRegion = true; }
            if (ZanIDE.Has(ln, "ZAN-DESIGNER END")) { inRegion = false; continue; }
            if (inRegion) { continue; }
            if (ln.Length < 5) { continue; }
            if (ln.Substring(0, 2) == "//") { continue; }
            if (ZanIDE.Has(ln, "(")) { continue; }
            if (ln.Substring(ln.Length - 1, 1) != ";") { continue; }
            string body = ln.Substring(0, ln.Length - 1);
            int eq = ZanIDE.IndexOfStr(body, "=");
            if (eq >= 0) { body = ZanIDE.TrimStr(body.Substring(0, eq)); }
            // Tokenise "type name" (allow static/public prefixes).
            List<string> toks = ZanIDE.SplitWords(body);
            if (toks.Count < 2) { continue; }
            string ty = toks[toks.Count - 2];
            string nm = toks[toks.Count - 1];
            if (!ZanIDE.IsIdent(nm)) { continue; }
            if (ty == "using" || ty == "namespace" || ty == "return" || ty == "new") { continue; }
            bool dup = false;
            int di = 0;
            while (di < vars.Count) { if (vars[di] == nm) { dup = true; } di = di + 1; }
            if (!dup) { vars.Add(nm); }
        }
        return vars;
    }

    static string TrimStr(string s) {
        int a = 0;
        int b = s.Length;
        while (a < b && (s.Substring(a, 1) == " " || s.Substring(a, 1) == "\t")) { a = a + 1; }
        while (b > a && (s.Substring(b - 1, 1) == " " || s.Substring(b - 1, 1) == "\t" || s.Substring(b - 1, 1) == "\r")) { b = b - 1; }
        return s.Substring(a, b - a);
    }

    static int IndexOfStr(string s, string needle) {
        int n = s.Length;
        int m = needle.Length;
        for (int i = 0; i + m <= n; i = i + 1) {
            if (s.Substring(i, m) == needle) { return i; }
        }
        return -1;
    }

    static List<string> SplitWords(string s) {
        List<string> toks = new List<string>();
        string cur = "";
        for (int i = 0; i < s.Length; i = i + 1) {
            string ch = s.Substring(i, 1);
            if (ch == " " || ch == "\t") {
                if (cur != "") { toks.Add(cur); cur = ""; }
            } else {
                cur = cur + ch;
            }
        }
        if (cur != "") { toks.Add(cur); }
        return toks;
    }

    static bool IsIdent(string s) {
        if (s.Length == 0) { return false; }
        string ok = "abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ0123456789_";
        string digits = "0123456789";
        if (ZanIDE.Has(digits, s.Substring(0, 1))) { return false; }
        for (int i = 0; i < s.Length; i = i + 1) {
            if (!ZanIDE.Has(ok, s.Substring(i, 1))) { return false; }
        }
        return true;
    }

    static string CodeBehindPath(string formPath) {
        int n = formPath.Length;
        if (n >= 6 && formPath.Substring(n - 6, 6) == ".zform") {
            return formPath.Substring(0, n - 6) + ".zan";
        }
        return formPath + ".zan";
    }

    /// True when the .zform body is a designer JSON document (as saved by the
    /// unified form designer) rather than the legacy `control ...` line format.
    static bool LooksLikeJson(string s) {
        int i = 0;
        while (i < s.Length) {
            string ch = s.Substring(i, 1);
            if (ch != " " && ch != "\t" && ch != "\n" && ch != "\r") {
                return ch == "{";
            }
            i = i + 1;
        }
        return false;
    }

    /// Maps a legacy .zform control type to the closest form-designer field type.
    static int LegacyFieldType(string ty) {
        if (ty == "Label") { return 16; }
        if (ty == "CheckBox") { return 5; }
        if (ty == "ComboBox") { return 6; }
        if (ty == "ListBox" || ty == "ListView") { return 40; }
        if (ty == "Panel" || ty == "GroupBox") { return 45; }
        if (ty == "TabControl") { return 36; }
        if (ty == "TreeView") { return 25; }
        if (ty == "DataGrid") { return 41; }
        if (ty == "MenuStrip" || ty == "ToolStrip") { return 38; }
        if (ty == "ProgressBar") { return 29; }
        if (ty == "RichTextBox") { return 14; }
        if (ty == "Button") { return 49; }
        return 0;
    }

    /// Converts a legacy coordinate-based .zform file into the form designer's
    /// JSON document so old forms open in the unified designer (each control
    /// becomes a field row; free coordinates are dropped in favour of the
    /// designer's automatic layout).
    static string LegacyFormToJson(string name, string text) {
        LegacyFormDoc o = new LegacyFormDoc();
        o.name = name;
        o.fields = new List<FormFieldDoc>();
        List<string> ls = CodeEditor.SplitLines(text);
        for (int i = 0; i < ls.Count; i = i + 1) {
            string s = CodeEditor.LTrim(ls[i]);
            if (s.Length > 8 && s.Substring(0, 8) == "control ") {
                List<string> toks = ZanIDE.SplitSpaces(s.Substring(8, s.Length - 8));
                if (toks.Count >= 2) {
                    FormFieldDoc f = new FormFieldDoc();
                    f.type = ZanIDE.LegacyFieldType(toks[0]);
                    f.label = toks[1];
                    f.name = toks[1];
                    o.fields.Add(f);
                }
            }
        }
        return Json.Serialize<LegacyFormDoc>(o);
    }

    // ---- form design model (2-file: .zform design + .zan business) ---------

    /// True for a generated layout file (Name.g.zan) - scenes still use one.
    static bool IsGenPath(string p) {
        int n = p.Length;
        if (n < 6) { return false; }
        return p.Substring(n - 6, 6) == ".g.zan";
    }

    /// True for any Zan source file (.zan).
    static bool IsZanFilePath(string p) {
        int n = p.Length;
        if (n < 4) { return false; }
        return p.Substring(n - 4, 4) == ".zan";
    }

    /// Escapes a string for embedding inside a Zan double-quoted literal.
    static string EscZ(string s) {
        string o = "";
        for (int i = 0; i < s.Length; i = i + 1) {
            string ch = s.Substring(i, 1);
            if (ch == "\\") { o = o + "\\\\"; }
            else if (ch == "\"") { o = o + "\\\""; }
            else if (ch == "\n") { o = o + "\\n"; }
            else if (ch == "\r") { }
            else if (ch == "\t") { o = o + "\\t"; }
            else { o = o + ch; }
        }
        return o;
    }

    static bool ListHasStr(List<string> l, string v) {
        int i = 0;
        while (i < l.Count) { if (l[i] == v) { return true; } i = i + 1; }
        return false;
    }

    /// A fresh business file (Name.zan): the user's half of the partial class.
    /// The designer never overwrites this - only creates it when missing.
    static string GenBusinessShell(string name) {
        string s = "using System;\n";
        s = s + "using Gui;\n";
        s = s + "using Gui.Widget;\n\n";
        s = s + "// Business logic for " + name + ". The window is designed visually in\n";
        s = s + "// " + name + ".zform. At compile time zanc projects its typed controls\n";
        s = s + "// and Main from the design, so there is no generated file to keep in sync.\n";
        s = s + "// This file is yours - the designer never overwrites it.\n";
        s = s + "partial class " + name + " {\n";
        s = s + "    // Runs once after the window is built, before the event loop.\n";
        s = s + "    // Bind events on the designed controls here, for example:\n";
        s = s + "    //     OkButton.OnClick(() => { });\n";
        s = s + "    static void OnLoad(Form form) {\n";
        s = s + "    }\n";
        s = s + "}\n";
        return s;
    }

    /// A fresh free-canvas form design (Name.zform, layoutMode 1): the window
    /// with a starter login-style sample whose controls are absolutely placed,
    /// mirroring the shipped "Free Layout Window" project template. The code
    /// behind is GenFreeShell; zanc projects typed controls + Main at compile
    /// time, so the design file is the single source of truth.
    static string FreeFormBody(string name, int winW, int winH) {
        FormDoc o = new FormDoc();
        o.name = name;
        o.winW = winW;
        o.winH = winH;
        o.winTitle = name;
        o.winCenter = true;
        o.layoutMode = 1;
        o.winZoom = 0;
        o.fields = new List<FormFieldDoc>();
        o.fields.Add(FreeFormField("15", "Welcome", "TitleLabel",
            "24", "16", "16", "448", "30", false, false));
        o.fields.Add(FreeFormField("0", "Name", "NameInput",
            "24", "60", "76", "360", "32", true, false));
        o.fields.Add(FreeFormField("2", "Password", "PasswordInput",
            "24", "60", "122", "360", "32", true, false));
        o.fields.Add(FreeFormField("5", "Remember me", "RememberCheck",
            "24", "60", "168", "200", "26", false, false));
        o.fields.Add(FreeFormField("49", "Sign in", "SignInButton",
            "24", "160", "220", "160", "36", false, false));
        o.fields.Add(FreeFormField("16",
            "Tip: in the designer switch between Flow and Free layout, resize the window, and drag components anywhere on the canvas.",
            "HintText", "24", "16", "300", "448", "40", false, true));
        return Json.Serialize<FormDoc>(o);
    }

    /// One absolutely-placed field of the free-layout starter form.
    static FormFieldDoc FreeFormField(string type, string label, string fname,
            string span, string fx, string fy, string fw, string fh,
            bool required, bool wrap) {
        FormFieldDoc f = new FormFieldDoc();
        f.type = ZanIDE.ParseInt(type);
        f.label = label;
        f.name = fname;
        f.required = required;
        f.span = ZanIDE.ParseInt(span);
        f.fx = ZanIDE.ParseInt(fx);
        f.fy = ZanIDE.ParseInt(fy);
        f.fw = ZanIDE.ParseInt(fw);
        f.fh = ZanIDE.ParseInt(fh);
        f.wrap = wrap;
        return f;
    }

    /// The business half (Name.zan) of a free-canvas form: same partial class
    /// contract as GenBusinessShell, plus a demo of the generated
    /// __ValidateForm() and the event-wiring surface for the starter sample.
    static string GenFreeShell(string name) {
        string s = "using System;\n";
        s = s + "using Gui;\n";
        s = s + "using Gui.Widget;\n\n";
        s = s + "// Business logic for " + name + ". The window is designed visually in\n";
        s = s + "// " + name + ".zform (open it in the form designer). This form uses FREE\n";
        s = s + "// layout: every control is absolutely positioned on the design canvas.\n";
        s = s + "// At compile time zanc projects its typed controls and Main from the\n";
        s = s + "// design, so there is no generated file to keep in sync. This file is\n";
        s = s + "// yours - the designer never overwrites it.\n";
        s = s + "partial class " + name + " {\n";
        s = s + "    // Runs once after the window is built, before the event loop starts.\n";
        s = s + "    static void OnLoad(Form form) {\n";
        s = s + "        SignInButton.OnClick(() => {\n";
        s = s + "            // Required fields (marked in the designer) are validated by the\n";
        s = s + "            // generated __ValidateForm: empty inputs get a red border + message.\n";
        s = s + "            if (!__ValidateForm()) { return; }\n";
        s = s + "            TitleLabel.Text = \"Hello \" + NameInput.GetText() + \"!\";\n";
        s = s + "        });\n";
        s = s + "        PasswordInput.OnEnter(() => { TitleLabel.Text = \"Enter pressed\"; });\n";
        s = s + "        RememberCheck.OnChange(() => {\n";
        s = s + "            TitleLabel.Text = \"Remember: \" + RememberCheck.IsChecked();\n";
        s = s + "        });\n";
        s = s + "    }\n";
        s = s + "}\n";
        return s;
    }

    // ---- retained scene code generation (.zscene, 3-file model) -------------
    // A scene -> Foo.zscene (design data) + Foo.g.zan (generated, below) +
    // Foo.zan (your logic). Foo.g.zan declares each named element as a typed
    // `static SceneElement`, rebuilds the SceneDoc exactly as designed, and
    // renders it at run time via Game.Scene.SceneView (so it runs as designed).

    static string SceneGenFilePath(string scenePath) {
        int n = scenePath.Length;
        if (n >= 7 && scenePath.Substring(n - 7, 7) == ".zscene") {
            return scenePath.Substring(0, n - 7) + ".g.zan";
        }
        return scenePath + ".g.zan";
    }

    static string SceneCodeBehindPath(string scenePath) {
        int n = scenePath.Length;
        if (n >= 7 && scenePath.Substring(n - 7, 7) == ".zscene") {
            return scenePath.Substring(0, n - 7) + ".zan";
        }
        return scenePath + ".zan";
    }

    static string GenSceneFile(string name, SceneDoc doc) {
        List<string> decls = new List<string>();
        List<string> used = new List<string>();
        List<string> body = new List<string>();
        for (int i = 0; i < doc.Count(); i = i + 1) {
            SceneElement e = doc.ElementAt(i);
            string vn = "e" + Convert.ToString(i);
            bool typed = ZanIDE.IsIdent(e.Name()) && !ZanIDE.ListHasStr(used, e.Name());
            if (typed) {
                vn = e.Name();
                used.Add(vn);
                decls.Add("    static SceneElement " + vn + ";");
            } else {
                body.Add("        SceneElement " + vn + ";");
            }
            body.Add("        " + vn + " = SceneElement.Create(\"" + ZanIDE.EscZ(e.Kind()) + "\", \"" + ZanIDE.EscZ(e.Name()) + "\");");
            body.Add("        " + vn + ".At(" + Convert.ToString(e.X()) + ", " + Convert.ToString(e.Y()) + ");");
            body.Add("        " + vn + ".Size(" + Convert.ToString(e.W()) + ", " + Convert.ToString(e.H()) + ");");
            body.Add("        " + vn + ".AnchorTo(" + Convert.ToString(e.AnchorX()) + ", " + Convert.ToString(e.AnchorY()) + ");");
            body.Add("        " + vn + ".Order(" + Convert.ToString(e.Z()) + ");");
            body.Add("        " + vn + ".Tint(" + Convert.ToString(e.R()) + ", " + Convert.ToString(e.G()) + ", " + Convert.ToString(e.B()) + ", " + Convert.ToString(e.A()) + ");");
            if (e.ImageId().Length > 0) {
                body.Add("        " + vn + ".Image(\"" + ZanIDE.EscZ(e.ImageId()) + "\");");
            }
            if (e.Text().Length > 0) {
                body.Add("        " + vn + ".Caption(\"" + ZanIDE.EscZ(e.Text()) + "\");");
            }
            if (e.IsGrid() || e.GapX() != 0 || e.GapY() != 0) {
                body.Add("        " + vn + ".Grid(" + Convert.ToString(e.Rows()) + ", " + Convert.ToString(e.Cols()) + ", " + Convert.ToString(e.GapX()) + ", " + Convert.ToString(e.GapY()) + ");");
            }
            if (e.Value() != 0) {
                body.Add("        " + vn + ".SetValue(" + Convert.ToString(e.Value()) + ");");
            }
            if (e.Items().Length > 0) {
                body.Add("        " + vn + ".SetItems(\"" + ZanIDE.EscZ(e.Items()) + "\");");
            }
            if (e.Locked()) {
                body.Add("        " + vn + ".SetLocked(true);");
            }
            if (!e.Visible()) {
                body.Add("        " + vn + ".SetVisible(false);");
            }
            body.Add("        d.Add(" + vn + ");");
        }
        int dw = doc.DesignWidth();
        if (dw <= 0) { dw = 1280; }
        int dh = doc.DesignHeight();
        if (dh <= 0) { dh = 720; }
        string dws = Convert.ToString(dw);
        string dhs = Convert.ToString(dh);
        string s = "// <auto-generated> Scene layout for " + name + ".zscene.\n";
        s = s + "// Regenerated from the scene designer on every save - do not edit.\n";
        s = s + "// Put your initialization and game logic in " + name + ".zan.\n";
        s = s + "using System;\n";
        s = s + "using Gui;\n";
        s = s + "using Game.Scene;\n\n";
        s = s + "partial class " + name + " {\n";
        int d = 0;
        while (d < decls.Count) { s = s + decls[d] + "\n"; d = d + 1; }
        s = s + "    static SceneDoc scene;\n\n";
        s = s + "    /// Builds the designed scene document (design-resolution HUD tree).\n";
        s = s + "    static SceneDoc BuildScene() {\n";
        s = s + "        SceneDoc d = SceneDoc.Create(\"" + ZanIDE.EscZ(name) + "\", " + dws + ", " + dhs + ");\n";
        s = s + "        d.SetMode(" + Convert.ToString(doc.Mode()) + ");\n";
        s = s + "        d.SetClearColor(" + Convert.ToString(doc.ClearR()) + ", " + Convert.ToString(doc.ClearG()) + ", " + Convert.ToString(doc.ClearB()) + ");\n";
        if (doc.Background().Length > 0) {
            s = s + "        d.SetBackground(\"" + ZanIDE.EscZ(doc.Background()) + "\");\n";
        }
        int b = 0;
        while (b < body.Count) { s = s + body[b] + "\n"; b = b + 1; }
        s = s + "        return d;\n";
        s = s + "    }\n\n";
        s = s + "    static void Main() {\n";
        s = s + "        scene = BuildScene();\n";
        s = s + "        App app = App.CreateDark(\"" + ZanIDE.EscZ(name) + "\", " + dws + ", " + dhs + ");\n";
        if (doc.WinCenter() != 0) {
            s = s + "        app.CenterWindow();\n";
        } else {
            s = s + "        app.SetWindowPos(" + Convert.ToString(doc.WinPosX()) + ", " + Convert.ToString(doc.WinPosY()) + ");\n";
        }
        s = s + "        app.Show();\n";
        s = s + "        " + name + ".OnLoad(app);\n";
        s = s + "        while (app.isRunning) {\n";
        s = s + "            if (!app.ProcessEvent()) { break; }\n";
        s = s + "            if (!app.needsRedraw) { continue; }\n";
        s = s + "            app.BeginFrame();\n";
        s = s + "            SceneView.Render(app, scene);\n";
        s = s + "            app.RenderChrome(\"" + ZanIDE.EscZ(name) + "\");\n";
        s = s + "            app.PresentFrame();\n";
        s = s + "        }\n";
        s = s + "    }\n";
        s = s + "}\n";
        return s;
    }

    // Business shell for a scene - created only when missing; never overwritten.
    static string GenSceneBusinessShell(string name) {
        string s = "using System;\n";
        s = s + "using Gui;\n";
        s = s + "using Game.Scene;\n\n";
        s = s + "// Business logic for scene " + name + ". The scene is designed visually in\n";
        s = s + "// " + name + ".zscene; its typed elements are generated into " + name + ".g.zan.\n";
        s = s + "// This file is yours - the designer never overwrites it.\n";
        s = s + "partial class " + name + " {\n";
        s = s + "    // Runs once after the scene is built, before the render loop.\n";
        s = s + "    // The SceneDoc is in `scene`; named elements are typed fields, e.g.\n";
        s = s + "    //     HealthBar.SetValue(80);\n";
        s = s + "    static void OnLoad(App app) {\n";
        s = s + "    }\n";
        s = s + "}\n";
        return s;
    }

    static bool TabsLabelsEqual(List<string> labels, List<TabRecord> tabs) {
        if (labels == null || tabs == null) { return false; }
        if (labels.Count != tabs.Count) { return false; }
        for (int i = 0; i < labels.Count; i = i + 1) {
            if (labels[i] != tabs[i].name) { return false; }
        }
        return true;
    }

    /// True when two plain label lists hold the same strings in the same
    /// order. Used by retained widgets that cache a Tabs strip built from a
    /// plain label list (docs section rail, debug panel) and rebuild only
    /// when the labels actually change.
    static bool StringListsEqual(List<string> a, List<string> b) {
        if (a == null || b == null) { return false; }
        if (a.Count != b.Count) { return false; }
        for (int i = 0; i < a.Count; i = i + 1) {
            if (a[i] != b[i]) { return false; }
        }
        return true;
    }

    /// Keeps the retained editor tab bar in step with the tab model the IDE
    /// owns (tabs / activeTab). The bar runs in host mode: close / add /
    /// right-click are reported back so this class stays the single source of
    /// truth; labels are rebuilt only when the model actually changes.
    void SyncEditorTabs() {
        if (editorTabs == null) {
            editorTabs = Tabs.Create(Tabs.Card());
            editorTabs.SetShowAdd(true);
            editorTabs.SetHostModel(true);
            editorTabLabels = new List<string>();
        }
        if (!ZanIDE.TabsLabelsEqual(editorTabLabels, tabs)) {
            Tabs nt = Tabs.Create(Tabs.Card());
            nt.SetShowAdd(true);
            nt.SetHostModel(true);
            List<string> cp = new List<string>();
            for (int i = 0; i < tabs.Count; i = i + 1) {
                nt.Add(tabs[i].name, true);
                cp.Add(tabs[i].name);
            }
            editorTabs = nt;
            editorTabLabels = cp;
        }
    }

    // ---- dialog rendering ----
}