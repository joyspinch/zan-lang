using System;
using System.Json;
using Gui;

class EditorSettingsWindow {
    App host;
    UiDoc ui;
    JsonValue model;
    int themeIndex;
    int fontSize;
    int language;
    int defaultFontSize;
    bool open;
    bool saved;
    bool languageChanged;
    static bool done;
    static bool resetFont;

    static string T(int lang, string en, string zh) {
        if (lang == 1) { return zh; }
        return en;
    }

    static string DocJson(int lang) {
        UiNode inner = UiNode.Column().Dock("fill").Pad(18).Gap(8);
        inner.Child(UiNode.Label(EditorSettingsWindow.T(
            lang, "Color Theme", "配色主题"))
            .Class("secondary small").Dock("top").Height(20));
        int i = 0;
        while (i < ZanIDE.EditorThemeCount()) {
            inner.Child(UiNode.Of("ThemeCard").Index(i)
                .Dock("top").Height(38).Bind("themeIdx"));
            i = i + 1;
        }
        inner.Child(UiNode.Label(EditorSettingsWindow.T(
            lang, "Font Size", "字体大小"))
            .Class("secondary small").Dock("top").Height(20));
        UiNode fontRow = UiNode.Row().Dock("top").Height(34).Gap(10);
        fontRow.Child(UiNode.Slider().Min(9).Max(30).Bind("font")
            .Dock("left").Width(300));
        fontRow.Child(UiNode.Of("Label").Dock("left").Width(44)
            .BindProp("font", "text"));
        fontRow.Child(UiNode.Label("px").Dock("left").Width(24));
        fontRow.Child(UiNode.Button(EditorSettingsWindow.T(lang, "Default", "默认"))
            .OnClick("resetFont").Dock("left").Width(100));
        inner.Child(fontRow);
        inner.Child(UiNode.Label(EditorSettingsWindow.T(
            lang, "Language", "界面语言"))
            .Class("secondary small").Dock("top").Height(20));
        UiNode langRow = UiNode.Row().Dock("top").Height(34).Gap(8);
        int j = 0;
        while (j < 2) {
            string label = "English";
            if (j == 1) { label = "简体中文"; }
            langRow.Child(UiNode.Of("Segment").Index(j).Str("label", label)
                .Dock("left").Width(130).Bind("lang"));
            j = j + 1;
        }
        inner.Child(langRow);
        UiNode btnRow = UiNode.Row().Dock("top").Height(40).Gap(10);
        btnRow.Child(UiNode.Button(EditorSettingsWindow.T(lang, "Done", "完成"))
            .OnClick("done").Dock("right").Width(120));
        inner.Child(btnRow);
        UiNode shell = UiNode.Of("WindowShell")
            .Text(EditorSettingsWindow.T(lang, "Editor Settings", "编辑器设置"))
            .Str("onClose", "done");
        shell.Child(inner);
        return shell.ToJson();
    }

    static void OnDone() {
        EditorSettingsWindow.done = true;
    }

    static void OnResetFont() {
        EditorSettingsWindow.resetFont = true;
    }

    void BuildUi() {
        ui = UiDoc.FromJson(
            EditorSettingsWindow.DocJson(language)).Bind(model);
        ui.Handle("done", EditorSettingsWindow.OnDone);
        ui.Handle("resetFont", EditorSettingsWindow.OnResetFont);
        ui.Wire();
    }

    static EditorSettingsWindow Open(
            App parent, int theme, int font, int lang, int defaultFont) {
        EditorSettingsWindow w = new EditorSettingsWindow();
        w.themeIndex = theme;
        w.fontSize = font;
        w.language = lang;
        w.defaultFontSize = defaultFont;

        w.open = true;
        w.saved = false;
        w.languageChanged = false;
        EditorSettingsWindow.done = false;
        EditorSettingsWindow.resetFont = false;
        w.model = JsonValue.NewObject();
        w.model.Set("themeIdx", JsonValue.NewNum(Convert.ToString(theme)));
        w.model.Set("font", JsonValue.NewNum(Convert.ToString(
            ZanIDE.EditorFontOr(font, defaultFont))));
        w.model.Set("lang", JsonValue.NewNum(Convert.ToString(lang)));
        w.BuildUi();
        w.host = App.CreateDark(
            EditorSettingsWindow.T(lang, "Editor Settings", "编辑器设置"),
            560, 560);
        w.host.ApplySkin(parent.ThemeMenuIndex());
        w.host.Show();
        w.host.SetWindowOpacity(parent.WindowOpacity());
        return w;
    }

    /// Re-applies the parent's skin while open (skin-follow for child windows).
    void FollowSkin(int i) {
        if (!open) { return; }
        host.ApplySkin(i);
        host.RequestRedraw();
    }

    /// Follows the parent's whole-window opacity while open.
    void FollowOpacity(int percent) {
        if (!open) { return; }
        host.SetWindowOpacity(percent);
    }

    /// Follows the parent's custom wallpaper image while open.
    void FollowWallpaper(string path, int opacity) {
        if (!open) { return; }
        host.SetUserWallpaper(path, opacity);
    }

    bool IsOpen() { return open; }

    bool OwnsWindow(nint hwnd) {
        return open && hwnd == host.WindowHandle();
    }

    bool NeedsRedraw() {
        return open && host.needsRedraw;
    }

    void ApplyEvent(nint hwnd) {
        if (!this.OwnsWindow(hwnd)) { return; }
        if (host.EventKind() == 8) {
            open = false;
            return;
        }
        host.ApplyEvent(hwnd);
    }

    void Render() {
        if (!this.NeedsRedraw()) { return; }
        host.BeginFrame();
        ui.RenderInto(host, 0, 0, host.canvas.Width(), host.canvas.Height());
        host.PresentFrame();

        if (EditorSettingsWindow.resetFont) {
            model.Set("font", JsonValue.NewNum(
                Convert.ToString(defaultFontSize)));
            fontSize = 0;
            EditorSettingsWindow.resetFont = false;
            host.RequestRedraw();
        }

        themeIndex = model.PathGet("themeIdx").AsInt(themeIndex);
        int boundFont = model.PathGet("font").AsInt(
            ZanIDE.EditorFontOr(fontSize, defaultFontSize));
        if (fontSize != 0 || boundFont != defaultFontSize) {
            fontSize = boundFont;
        }
        int nextLanguage = model.PathGet("lang").AsInt(language);
        if (nextLanguage != language) {
            language = nextLanguage;
            languageChanged = true;
            this.BuildUi();
            host.RequestRedraw();
        }
        if (EditorSettingsWindow.done) {
            saved = true;
            open = false;
            EditorSettingsWindow.done = false;
            host.window.Close();
        }
    }

    int ThemeIndex() { return themeIndex; }
    int FontSize() { return fontSize; }
    int Language() { return language; }

    bool TakeLanguageChanged() {
        bool v = languageChanged;
        languageChanged = false;
        return v;
    }

    bool TakeSaved() {
        bool v = saved;
        saved = false;
        return v;
    }
}
