using System;

/// One row of the AI model-limits table: a model id and its per-model token
/// limits (0 = use the built-in default). The settings window keeps a
/// `List<ModelLimitRow>` as the single source the table renders and commits
/// from, so the three columns can never drift out of sync.
class ModelLimitRow {
    string model;
    int ctx;
    int maxOut;

    static ModelLimitRow Of(string model, int ctx, int maxOut) {
        ModelLimitRow r = new ModelLimitRow();
        r.model = model;
        r.ctx = ctx;
        r.maxOut = maxOut;
        return r;
    }

    /// A limit as editable text: blank when unset (0), so a blank input means
    /// "use the built-in default".
    static string Fmt(int n) {
        if (n <= 0) { return ""; }
        return Convert.ToString(n);
    }
}
