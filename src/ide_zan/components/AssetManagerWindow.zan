using System;
using System.Json;
using Gui;

/// The Asset Manager child window: a WindowShell whose content area hosts the
/// AssetManagerView component (the manager's own immediate-mode renderer).
/// The shell supplies the themed background, title bar and close button, so
/// the manager matches every other IDE window.
class AssetManagerWindow : ChildWindow {
    static bool close;
    /// Action the AssetManagerView reported on its last paint (0 open,
    /// 1 close, 2 import file, 3 import folder, 4 link resource).
    static int action;
    /// Project root + IDE log the view renders against (set at Open).
    static string root;
    static List<string> log;

    static string RootOf() { return AssetManagerWindow.root; }
    static List<string> LogOf() { return AssetManagerWindow.log; }

    static void SetAction(int a) { AssetManagerWindow.action = a; }

    static void OnClose() { AssetManagerWindow.close = true; }

    void BuildUi(int uiLang) {
        AssetManager.lang = uiLang;
        UiNode shell = UiNode.Of("WindowShell")
            .Text(AssetManager.T("Asset Manager", "资源管理器"))
            .Str("onClose", "close");
        shell.Child(UiNode.Of("AssetManagerView").Dock("fill"));
        ui = UiDoc.FromJson(shell.ToJson());
        ui.Handle("close", AssetManagerWindow.OnClose);
        ui.Wire();
    }

    static AssetManagerWindow Open(App parent, string root, List<string> log, int uiLang) {
        AssetManagerWindow w = new AssetManagerWindow();
        AssetManagerWindow.root = root;
        AssetManagerWindow.log = log;
        AssetManagerWindow.action = 0;
        AssetManagerWindow.close = false;
        w.BuildUi(uiLang);
        w.OpenHost(parent);
        return w;
    }

    override string Title() {
        return AssetManager.T("Asset Manager", "资源管理器");
    }

    override int Width() { return 900; }
    override int Height() { return 660; }
    override int IdBase() { return 890000; }

    override bool Pending() { return AssetManagerWindow.close; }

    /// The action the view reported on its last paint (0 when none).
    int TakeAction() {
        int a = AssetManagerWindow.action;
        AssetManagerWindow.action = 0;
        return a;
    }

    /// True once the shell close button was pressed.
    bool TakeClose() {
        if (AssetManagerWindow.close) {
            AssetManagerWindow.close = false;
            open = false;
            return true;
        }
        return false;
    }
}
