using System;
using System.IO;
using System.Json;
using Gui;

/// @component AI settings window
/// The unified AI configuration window (UiDoc + WindowShell, same scheme as
/// EditorSettingsWindow): the saved provider profiles as a selectable list,
/// editable fields, add/delete, official presets, model-list fetching and a
/// default-model picker. Persists to ai_profiles.json via ZanIDE.AiProfilesSave.
class AiSettingsWindow {
    App host;
    UiDoc ui;
    JsonValue model;
    bool open;
    bool saved;
    int lang;

    List<string> names;
    List<string> bases;
    List<string> keys;
    List<string> models;
    List<string> lists;
    /// Per profile: JSON map `<model id> -> {ctx, out}` (token counts).
    List<string> limits;
    /// The current profile's fetched models as row entities (model/ctx/out),
    /// the single source the limits table renders and commits from.
    List<ModelLimitRow> modelRows;
    int active;
    int sel;
    int modelSel;

    List<string> preNames;
    List<string> preBases;
    List<string> preModels;
    List<string> preRegs;

    bool fetchBusy;

    static bool done;
    static bool add;
    static bool del;
    static bool save;
    static bool enable;
    static bool fetch;
    static bool preAdd;
    static bool reg;

    static string T(int lang, string en, string zh) {
        if (lang == 1) { return zh; }
        return en;
    }

    static void OnDone() { AiSettingsWindow.done = true; }
    static void OnAdd() { AiSettingsWindow.add = true; }
    static void OnDel() { AiSettingsWindow.del = true; }
    static void OnSave() { AiSettingsWindow.save = true; }
    static void OnEnable() { AiSettingsWindow.enable = true; }
    static void OnFetch() { AiSettingsWindow.fetch = true; }
    static void OnPreAdd() { AiSettingsWindow.preAdd = true; }
    static void OnReg() { AiSettingsWindow.reg = true; }

    /// `a|b|c` options text for a Select from a string list.
    static string OptionsText(List<string> xs) {
        string s = "";
        int i = 0;
        while (i < xs.Count) {
            if (i > 0) { s = s + "|"; }
            s = s + xs[i];
            i = i + 1;
        }
        return s;
    }

    string DocJson() {
        // Rebuild the limits-table entities + their bound inputs for the
        // current profile before laying out (fetch/add/switch all rebuild).
        this.SeedModelLimits();
        // ---- Left column: saved configurations + presets ----
        UiNode left = UiNode.Column().Dock("left").Width(230).Gap(6);
        left.Child(UiNode.Label(AiSettingsWindow.T(lang, "Configurations", "配置列表"))
            .Class("secondary small").Dock("top").Height(20));
        int i = 0;
        while (i < names.Count) {
            string label = names[i];
            if (i == active) {
                label = label + AiSettingsWindow.T(lang, "  (enabled)", "（已启用）");
            }
            left.Child(UiNode.Of("Segment").Index(i).Str("label", label)
                .Dock("top").Height(32).Bind("sel"));
            i = i + 1;
        }
        UiNode cfgRow = UiNode.Row().Dock("top").Height(34).Gap(8);
        cfgRow.Child(UiNode.Button(AiSettingsWindow.T(lang, "New", "新增"))
            .OnClick("add").Dock("left").Width(106));
        cfgRow.Child(UiNode.Button(AiSettingsWindow.T(lang, "Delete", "删除"))
            .OnClick("del").Dock("right").Width(106));
        left.Child(cfgRow);
        left.Child(UiNode.Label(AiSettingsWindow.T(lang, "Presets", "预设"))
            .Class("secondary small").Dock("top").Height(18));
        int p = 0;
        while (p < preNames.Count) {
            left.Child(UiNode.Of("Segment").Index(p).Str("label", preNames[p])
                .Dock("top").Height(28).Bind("preset"));
            p = p + 1;
        }
        // Dock the fixed-width button first so the "fill" one takes only the
        // space that is left -- otherwise the two overlap.
        UiNode preRow = UiNode.Row().Dock("top").Height(34).Gap(8);
        preRow.Child(UiNode.Button(AiSettingsWindow.T(lang, "Sign up", "注册"))
            .OnClick("reg").Dock("right").Width(70));
        preRow.Child(UiNode.Button(AiSettingsWindow.T(lang, "Add preset", "用预设新增"))
            .OnClick("preAdd").Dock("fill"));
        left.Child(preRow);

        // ---- Right column: editable fields of the selected profile ----
        UiNode right = UiNode.Column().Dock("fill").Gap(6);
        right.Child(UiNode.Label(AiSettingsWindow.T(lang, "Name", "名称"))
            .Dock("top").Height(18));
        right.Child(UiNode.Of("Input").Dock("top").Height(30).Bind("name"));
        right.Child(UiNode.Label(AiSettingsWindow.T(
            lang, "Endpoint (OpenAI-compatible, /v1)", "接口地址（兼容 OpenAI，/v1）"))
            .Dock("top").Height(18));
        right.Child(UiNode.Of("Input").Dock("top").Height(30).Bind("base")
            .Str("hint", "https://api.openai.com/v1"));
        right.Child(UiNode.Label(AiSettingsWindow.T(lang, "API Key / Token", "API 密钥 / Token"))
            .Dock("top").Height(18));
        right.Child(UiNode.Of("Input").Dock("top").Height(30).Bind("key")
            .Str("hint", "sk-...").Str("iconLead", "lock").Str("password", "true"));
        right.Child(UiNode.Label(AiSettingsWindow.T(lang, "Default model", "默认模型"))
            .Dock("top").Height(18));
        string fetchLbl = AiSettingsWindow.T(lang, "Fetch models", "获取模型");
        if (fetchBusy) { fetchLbl = AiSettingsWindow.T(lang, "Fetching...", "获取中..."); }
        UiNode modelRow = UiNode.Row().Dock("top").Height(30).Gap(8);
        // Fixed-width button first: under dock layout a "fill" sibling keeps the
        // whole remaining width, so it must be added after the docked button.
        modelRow.Child(UiNode.Button(fetchLbl).OnClick("fetch").Dock("right").Width(100));
        modelRow.Child(UiNode.Of("Input").Dock("fill").Bind("model")
            .Str("hint", "gpt-4o-mini"));
        right.Child(modelRow);
        right.Child(UiNode.Of("Label").Dock("top").Height(18)
            .BindProp("status", "text"));
        // Actions are pinned to the bottom, reserved before the model list
        // fills the space between them and the status line.
        UiNode actRow = UiNode.Row().Dock("bottom").Height(40).Gap(10);
        actRow.Child(UiNode.Button(AiSettingsWindow.T(lang, "Save", "保存"))
            .OnClick("save").Dock("left").Width(110));
        actRow.Child(UiNode.Button(AiSettingsWindow.T(lang, "Save & enable", "保存并启用"))
            .OnClick("enable").Class("primary").Dock("left").Width(150));
        right.Child(actRow);
        // Per-model limits as a table: one entity (ModelLimitRow) per fetched
        // model, columns = model / context length / max output. Clicking the
        // model cell also picks it as the default. The list scrolls.
        List<string> mopts = ZanIDE.SplitList(lists[SelClamped()]);
        if (mopts.Count > 0) {
            right.Child(UiNode.Label(AiSettingsWindow.T(lang,
                "Pick a model; set its context / max-output (tokens, blank = default 200000)",
                "选择模型；设置其上下文 / 最大输出（tokens，留空 = 默认 200000）"))
                .Class("secondary small").Dock("top").Height(18));
            UiNode hdr = UiNode.Row().Dock("top").Height(24).Gap(8);
            hdr.Child(UiNode.Label(AiSettingsWindow.T(lang, "Max out", "最大输出"))
                .Class("secondary small").Dock("right").Width(92));
            hdr.Child(UiNode.Label(AiSettingsWindow.T(lang, "Context", "上下文"))
                .Class("secondary small").Dock("right").Width(92));
            hdr.Child(UiNode.Label(AiSettingsWindow.T(lang, "Model", "模型"))
                .Class("secondary small").Dock("fill"));
            right.Child(hdr);
            UiNode tbl = UiNode.Of("ScrollColumn").Dock("fill").Gap(4);
            int m = 0;
            while (m < modelRows.Count) {
                string mi = Convert.ToString(m);
                UiNode trow = UiNode.Row().Dock("top").Height(32).Gap(8);
                trow.Child(UiNode.Of("Input").Dock("right").Width(92)
                    .Bind("out_" + mi).Str("hint", ""));
                trow.Child(UiNode.Of("Input").Dock("right").Width(92)
                    .Bind("ctx_" + mi).Str("hint", "200000"));
                trow.Child(UiNode.Of("Segment").Index(m).Str("label", modelRows[m].model)
                    .Dock("fill").Bind("modelsel"));
                tbl.Child(trow);
                m = m + 1;
            }
            right.Child(tbl);
        }

        UiNode row = UiNode.Row().Dock("fill").Pad(16).Gap(14);
        row.Child(left);
        row.Child(right);
        UiNode shell = UiNode.Of("WindowShell")
            .Text(AiSettingsWindow.T(lang, "AI Settings", "AI 配置"))
            .Str("onClose", "done");
        shell.Child(row);
        return shell.ToJson();
    }

    int SelClamped() {
        if (sel < 0 || sel >= names.Count) { return 0; }
        return sel;
    }

    void BuildUi() {
        ui = UiDoc.FromJson(DocJson()).Bind(model);
        ui.Handle("done", AiSettingsWindow.OnDone);
        ui.Handle("add", AiSettingsWindow.OnAdd);
        ui.Handle("del", AiSettingsWindow.OnDel);
        ui.Handle("save", AiSettingsWindow.OnSave);
        ui.Handle("enable", AiSettingsWindow.OnEnable);
        ui.Handle("fetch", AiSettingsWindow.OnFetch);
        ui.Handle("preAdd", AiSettingsWindow.OnPreAdd);
        ui.Handle("reg", AiSettingsWindow.OnReg);
        ui.Wire();
    }

    /// Pushes the selected profile's fields into the bound model (state -> UI).
    void LoadFields() {
        int i = SelClamped();
        model.Set("name", JsonValue.NewStr(names[i]));
        model.Set("base", JsonValue.NewStr(bases[i]));
        model.Set("key", JsonValue.NewStr(keys[i]));
        model.Set("model", JsonValue.NewStr(models[i]));
        this.SeedModelLimits();
        this.SyncModelSel();
    }

    /// Builds one ModelLimitRow entity per fetched model of the current profile
    /// and seeds its bound inputs (ctx_i / out_i). This is the single source the
    /// limits table renders from and commits back to.
    void SeedModelLimits() {
        int i = SelClamped();
        List<string> mopts = ZanIDE.SplitList(lists[i]);
        modelRows = new List<ModelLimitRow>();
        int m = 0;
        while (m < mopts.Count) {
            int cv = ZanIDE.AiLimitInt(limits[i], mopts[m], "ctx");
            int ov = ZanIDE.AiLimitInt(limits[i], mopts[m], "out");
            modelRows.Add(ModelLimitRow.Of(mopts[m], cv, ov));
            string mi = Convert.ToString(m);
            model.Set("ctx_" + mi, JsonValue.NewStr(ModelLimitRow.Fmt(cv)));
            model.Set("out_" + mi, JsonValue.NewStr(ModelLimitRow.Fmt(ov)));
            m = m + 1;
        }
    }

    /// Reads the table's bound inputs back into the profile's limits map.
    void CommitModelLimits() {
        int i = SelClamped();
        int m = 0;
        while (m < modelRows.Count) {
            string mi = Convert.ToString(m);
            limits[i] = ZanIDE.AiLimitSet(limits[i], modelRows[m].model, "ctx",
                model.PathGet("ctx_" + mi).AsString(""));
            limits[i] = ZanIDE.AiLimitSet(limits[i], modelRows[m].model, "out",
                model.PathGet("out_" + mi).AsString(""));
            m = m + 1;
        }
    }

    /// Points the inline model list at the profile's current default model
    /// (or none when it isn't in the fetched list).
    void SyncModelSel() {
        int i = SelClamped();
        List<string> mopts = ZanIDE.SplitList(lists[i]);
        int idx = 0 - 1;
        int m = 0;
        while (m < mopts.Count) {
            if (mopts[m] == models[i]) { idx = m; break; }
            m = m + 1;
        }
        modelSel = idx;
        model.Set("modelsel", JsonValue.NewNum(Convert.ToString(idx)));
    }

    /// Reads the bound inputs back into the selected profile (UI -> lists).
    void CommitFields() {
        int i = SelClamped();
        names[i] = model.PathGet("name").AsString(names[i]);
        bases[i] = model.PathGet("base").AsString(bases[i]);
        keys[i] = model.PathGet("key").AsString(keys[i]);
        models[i] = model.PathGet("model").AsString(models[i]);
        this.CommitModelLimits();
    }

    void Persist() {
        ZanIDE.AiProfilesSave(active, names, bases, keys, models, lists, limits);
        saved = true;
    }

    void SetStatus(string text) {
        model.Set("status", JsonValue.NewStr(text));
    }

    static AiSettingsWindow Open(App parent, int uiLang) {
        AiSettingsWindow w = new AiSettingsWindow();
        w.lang = uiLang;
        w.open = true;
        w.saved = false;
        w.fetchBusy = false;
        AiSettingsWindow.done = false;
        AiSettingsWindow.add = false;
        AiSettingsWindow.del = false;
        AiSettingsWindow.save = false;
        AiSettingsWindow.enable = false;
        AiSettingsWindow.fetch = false;
        AiSettingsWindow.preAdd = false;
        AiSettingsWindow.reg = false;
        w.names = new List<string>();
        w.bases = new List<string>();
        w.keys = new List<string>();
        w.models = new List<string>();
        w.lists = new List<string>();
        w.limits = new List<string>();
        w.active = ZanIDE.AiProfilesLoad(w.names, w.bases, w.keys, w.models,
            w.lists, w.limits);
        w.sel = w.active;
        w.preNames = new List<string>();
        w.preBases = new List<string>();
        w.preModels = new List<string>();
        w.preRegs = new List<string>();
        ZanIDE.AiPresetsInto(w.preNames, w.preBases, w.preModels, w.preRegs);
        w.model = JsonValue.NewObject();
        w.model.Set("sel", JsonValue.NewNum(Convert.ToString(w.sel)));
        w.model.Set("preset", JsonValue.NewNum("0"));
        w.model.Set("status", JsonValue.NewStr(""));
        w.model.Set("ctx", JsonValue.NewStr(""));
        w.model.Set("out", JsonValue.NewStr(""));
        w.LoadFields();
        w.BuildUi();
        w.host = App.CreateDark(
            AiSettingsWindow.T(uiLang, "AI Settings", "AI 配置"), 720, 720);
        w.host.ApplySkin(parent.ThemeMenuIndex());
        w.host.Show();
        w.host.SetWindowOpacity(parent.WindowOpacity());
        return w;
    }

    void FollowSkin(int i) {
        if (!open) { return; }
        host.ApplySkin(i);
        host.RequestRedraw();
    }

    void FollowOpacity(int percent) {
        if (!open) { return; }
        host.SetWindowOpacity(percent);
    }

    /// Follows the parent's custom wallpaper image while open.
    void FollowWallpaper(string path, int opacity) {
        if (!open) { return; }
        host.SetWallpaper(path, opacity);
    }

    bool IsOpen() { return open; }

    bool OwnsWindow(nint hwnd) {
        return open && hwnd == host.WindowHandle();
    }

    bool NeedsRedraw() {
        return open && (host.needsRedraw || fetchBusy);
    }

    void ApplyEvent(nint hwnd) {
        if (!this.OwnsWindow(hwnd)) { return; }
        if (host.EventKind() == 8) {
            open = false;
            return;
        }
        host.ApplyEvent(hwnd);
    }

    /// Rebuilds the document (profile rows / model options changed) keeping
    /// the bound state.
    void Rebuild() {
        this.BuildUi();
        host.RequestRedraw();
    }

    int PresetIndex() {
        int p = model.PathGet("preset").AsInt(0);
        if (p < 0 || p >= preNames.Count) { p = 0; }
        return p;
    }

    void Render() {
        if (!this.NeedsRedraw()) { return; }
        host.BeginFrame();
        ui.RenderInto(host, 0, 0, host.canvas.Width(), host.canvas.Height());
        host.PresentFrame();

        // Selecting another profile in the list: keep edits in memory, then
        // load the newly selected profile into the inputs.
        int nextSel = model.PathGet("sel").AsInt(sel);
        if (nextSel != sel && nextSel >= 0 && nextSel < names.Count) {
            this.CommitFields();
            sel = nextSel;
            this.LoadFields();
            this.Rebuild();
        }

        // Picking a model in the inline list sets the profile's default.
        int nextModel = model.PathGet("modelsel").AsInt(modelSel);
        if (nextModel != modelSel) {
            modelSel = nextModel;
            List<string> mo = ZanIDE.SplitList(lists[SelClamped()]);
            if (nextModel >= 0 && nextModel < mo.Count) {
                model.Set("model", JsonValue.NewStr(mo[nextModel]));
            }
            host.RequestRedraw();
        }

        if (AiSettingsWindow.add) {
            AiSettingsWindow.add = false;
            this.CommitFields();
            names.Add(AiSettingsWindow.T(lang, "AI ", "配置 ")
                + Convert.ToString(names.Count + 1));
            bases.Add("https://api.openai.com/v1");
            keys.Add("");
            models.Add("");
            lists.Add("");
            limits.Add("{}");
            sel = names.Count - 1;
            model.Set("sel", JsonValue.NewNum(Convert.ToString(sel)));
            this.LoadFields();
            this.Persist();
            this.Rebuild();
        }
        if (AiSettingsWindow.preAdd) {
            AiSettingsWindow.preAdd = false;
            int p = PresetIndex();
            this.CommitFields();
            names.Add(preNames[p]);
            bases.Add(preBases[p]);
            keys.Add("");
            models.Add(preModels[p]);
            lists.Add("");
            limits.Add("{}");
            sel = names.Count - 1;
            model.Set("sel", JsonValue.NewNum(Convert.ToString(sel)));
            this.LoadFields();
            this.Persist();
            this.SetStatus(AiSettingsWindow.T(
                lang, "Preset added - fill in the API key and Save & enable.",
                "已添加预设——请填入 API 密钥后“保存并启用”。"));
            this.Rebuild();
        }
        if (AiSettingsWindow.reg) {
            AiSettingsWindow.reg = false;
            ZanIDE.OpenExternal(preRegs[PresetIndex()]);
        }
        if (AiSettingsWindow.del) {
            AiSettingsWindow.del = false;
            if (names.Count > 1) {
                int i = SelClamped();
                names.RemoveAt(i);
                bases.RemoveAt(i);
                keys.RemoveAt(i);
                models.RemoveAt(i);
                lists.RemoveAt(i);
                limits.RemoveAt(i);
                if (active >= names.Count) { active = 0; }
                if (sel >= names.Count) { sel = names.Count - 1; }
                model.Set("sel", JsonValue.NewNum(Convert.ToString(sel)));
                this.LoadFields();
                this.Persist();
                this.Rebuild();
            } else {
                this.SetStatus(AiSettingsWindow.T(
                    lang, "At least one configuration is required.",
                    "至少保留一个配置。"));
                host.RequestRedraw();
            }
        }
        if (AiSettingsWindow.save || AiSettingsWindow.enable) {
            bool en = AiSettingsWindow.enable;
            AiSettingsWindow.save = false;
            AiSettingsWindow.enable = false;
            this.CommitFields();
            if (en) { active = SelClamped(); }
            this.Persist();
            if (en) {
                this.SetStatus(AiSettingsWindow.T(lang, "Saved and enabled ", "已保存并启用 ")
                    + names[SelClamped()]);
            } else {
                this.SetStatus(AiSettingsWindow.T(lang, "Saved.", "已保存。"));
            }
            this.Rebuild();
        }
        if (AiSettingsWindow.fetch && !fetchBusy) {
            AiSettingsWindow.fetch = false;
            this.CommitFields();
            int i = SelClamped();
            string ferr = ZanIDE.AiFetchModels(bases[i], keys[i]);
            if (ferr != "") {
                this.SetStatus(ferr);
            } else {
                fetchBusy = true;
                this.SetStatus(AiSettingsWindow.T(
                    lang, "Fetching model list...", "正在获取模型列表..."));
            }
            this.Rebuild();
        }
        AiSettingsWindow.fetch = false;
        if (fetchBusy) {
            if (File.Exists(ZanIDE.AiModelsDonePath())) {
                File.Delete(ZanIDE.AiModelsDonePath());
                fetchBusy = false;
                string gotModels = ZanIDE.AiReadModels();
                int i = SelClamped();
                if (gotModels != "") {
                    lists[i] = gotModels;
                    List<string> gm = ZanIDE.SplitList(gotModels);
                    if (models[i] == "") {
                        models[i] = gm[0];
                        model.Set("model", JsonValue.NewStr(gm[0]));
                    }
                    this.Persist();
                    this.SyncModelSel();
                    this.SetStatus(AiSettingsWindow.T(lang, "Fetched ", "已获取 ")
                        + Convert.ToString(gm.Count)
                        + AiSettingsWindow.T(lang, " models.", " 个模型。"));
                } else {
                    this.SetStatus(AiSettingsWindow.T(
                        lang, "Could not fetch models (check base URL / key).",
                        "获取模型失败（请检查接口地址和密钥）。"));
                }
                this.Rebuild();
            }
            host.RequestRedraw();
        }
        if (AiSettingsWindow.done) {
            AiSettingsWindow.done = false;
            this.CommitFields();
            this.Persist();
            open = false;
            host.window.Close();
        }
    }

    int Active() { return active; }

    bool TakeSaved() {
        bool v = saved;
        saved = false;
        return v;
    }
}
