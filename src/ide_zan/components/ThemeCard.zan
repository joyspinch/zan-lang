using System;
using Gui;
using Gui.Widget;

/// @component Editor palette
/// Selectable editor theme card with a syntax-colored preview.
class ThemeCard : Control {
    int index;
    string sel;
    int wid;

    ThemeCard() {
        this.InitControl("themecard", 1);
        index = 0;
        sel = "0";
        wid = WidgetId.Next();
    }

    override string Kind() { return "ThemeCard"; }

    override List<PropSpec> Props() {
        List<PropSpec> ps = new List<PropSpec>();
        PropSpec idx = PropSpec.Int("index", "Theme index");
        idx.num = index;
        ps.Add(idx);
        PropSpec val = PropSpec.Text("value", "Selected");
        val.str = sel;
        ps.Add(val);
        return ps;
    }


    override void OnMeasure(App app) {
        prefH = app.Scale(38);
        prefW = app.Scale(300);
    }

    override void OnPaint(App app) {
        Canvas c = app.canvas;
        Theme t = app.theme;
        app.hitTester.Register(HitRegion.Create(wid, bx, by, bw, bh, 0));
        app.focus.RegisterFocusable(wid);
        if (Ui.Clicked(app, wid)) {
            sel = Convert.ToString(index);
            app.RequestRedraw();
        }
        bool selected = Convert.ToInt32(sel) == index;
        // Surface through the component style (`card`): the skin decides the
        // fill (translucent under the illustrated packs, frosted under glass),
        // and the eased resolution handles hover. Selection keeps an accent
        // border as the latched indicator.
        StyleBox s = Style.EasedId(app, wid, "card", "", "", false, selected);
        Style.Inline(s, this);
        s.Paint(app, bx, by, bw, bh);
        if (selected) {
            app.canvas.DrawRoundRect(bx, by, bw, bh,
                s.RadiusOr(t.borderRadiusSmall), t.primary, 1);
        }
        app.canvas.DrawStyledText(
            Style.Of(app, "label", "", Style.SNormal()),
            bx + app.Scale(10), by + app.Scale(3), ZanIDE.EditorThemeName(index),
            app.theme.textPrimary, app.theme.fontSizeMedium);
        int pvX = bx + app.Scale(10);
        int pvY = by + app.Scale(19);
        int fs = t.fontSizeSmall;
        app.canvas.DrawText(pvX, pvY, "class", ZanIDE.EditorThemeColor(index, 0),
            Style.Of(app, "label", "small", Style.SNormal())
                .FontOr(app.theme.fontSizeSmall));
        pvX = pvX + Canvas.MeasureText("class ", fs);
        app.canvas.DrawText(pvX, pvY, "App", ZanIDE.EditorThemeColor(index, 1),
            Style.Of(app, "label", "small", Style.SNormal())
                .FontOr(app.theme.fontSizeSmall));
        pvX = pvX + Canvas.MeasureText("App ", fs);
        app.canvas.DrawText(pvX, pvY, "\"hi\"", ZanIDE.EditorThemeColor(index, 2),
            Style.Of(app, "label", "small", Style.SNormal())
                .FontOr(app.theme.fontSizeSmall));
        pvX = pvX + Canvas.MeasureText("\"hi\" ", fs);
        app.canvas.DrawText(pvX, pvY, "42", ZanIDE.EditorThemeColor(index, 4),
            Style.Of(app, "label", "small", Style.SNormal())
                .FontOr(app.theme.fontSizeSmall));
        pvX = pvX + Canvas.MeasureText("42 ", fs);
        app.canvas.DrawText(pvX, pvY, "// note", ZanIDE.EditorThemeColor(index, 3),
            Style.Of(app, "label", "small", Style.SNormal())
                .FontOr(app.theme.fontSizeSmall));
        this.FireOn(app, wid);
    }
}