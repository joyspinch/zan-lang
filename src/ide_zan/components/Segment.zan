using System;
using Gui;
using Gui.Widget;

/// @component Editor segment
/// One option in a bound segmented selector.
class Segment : Control {
    int index;
    string sel;
    string label;
    int wid;

    Segment() {
        this.InitControl("segment", 3);
        index = 0;
        sel = "0";
        label = "";
        wid = WidgetId.Next();
    }

    override string Kind() { return "Segment"; }

    override List<PropSpec> Props() {
        List<PropSpec> ps = new List<PropSpec>();
        PropSpec idx = PropSpec.Int("index", "Option index");
        idx.num = index;
        ps.Add(idx);
        PropSpec lbl = PropSpec.Text("label", "Label");
        lbl.str = label;
        ps.Add(lbl);
        PropSpec val = PropSpec.Text("value", "Selected");
        val.str = sel;
        ps.Add(val);
        return ps;
    }


    override void OnMeasure(App app) {
        prefH = app.Scale(30);
        prefW = app.Scale(120);
    }

    override void OnPaint(App app) {
        app.hitTester.Register(HitRegion.Create(wid, bx, by, bw, bh, 0));
        app.focus.RegisterFocusable(wid);
        if (Ui.Clicked(app, wid)) {
            sel = Convert.ToString(index);
            app.RequestRedraw();
        }
        bool selected = Convert.ToInt32(sel) == index;
        Theme t = app.theme;
        // Surface through the component style (`button`): the skin decides the
        // fill and hover state, and selection keeps an accent border as the
        // latched indicator.
        StyleBox s = Style.EasedId(app, wid, "button", "", "", false, selected);
        Style.Inline(s, this);
        s.Paint(app, bx, by, bw, bh);
        if (selected) {
            app.canvas.DrawRoundRect(bx, by, bw, bh,
                s.RadiusOr(t.borderRadiusSmall), t.primary, 1);
        }
        int textY = by + (bh - Canvas.FontHeight(app.theme.fontSizeMedium)) / 2;
        app.canvas.DrawStyledText(
            Style.Of(app, "label", "small", Style.SNormal()),
            bx + app.Scale(12), textY, label,
            app.theme.textPrimary, app.theme.fontSizeMedium);
        this.FireOn(app, wid);
    }
}