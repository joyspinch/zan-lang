using System;
using System.Json;
using Gui;

class MarketplaceWindow : ChildWindow {
    static bool close;
    static int action;
    static MarketplaceBrowser browser;

    static MarketplaceBrowser Browser() { return MarketplaceWindow.browser; }
    static void SetAction(int action) { MarketplaceWindow.action = action; }
    static void OnClose() { MarketplaceWindow.close = true; }

    void BuildUi() {
        UiNode shell = UiNode.Of("WindowShell")
            .Text(ZanIDE.T("Package Marketplace", "库商城"))
            .Str("onClose", "close");
        shell.Child(UiNode.Of("MarketplaceView").Dock("fill"));
        ui = UiDoc.FromJson(shell.ToJson());
        ui.Handle("close", MarketplaceWindow.OnClose);
        ui.Wire();
    }

    static MarketplaceWindow Open(App parent, int uiLang) {
        MarketplaceWindow window = new MarketplaceWindow();
        MarketplaceWindow.close = false;
        MarketplaceWindow.action = 0;
        MarketplaceWindow.browser = MarketplaceBrowser.Create(uiLang);
        window.BuildUi();
        window.OpenHost(parent);
        return window;
    }

    void Locate(string packageName) {
        if (MarketplaceWindow.browser != null) {
            MarketplaceWindow.browser.Locate(packageName);
            this.RequestRedraw();
        }
    }

    override string Title() { return ZanIDE.T("Package Marketplace", "库商城"); }
    override int Width() { return 940; }
    override int Height() { return 640; }
    override int IdBase() { return 920000; }
    override bool Pending() {
        return MarketplaceWindow.close || MarketplaceWindow.action != 0
            || (MarketplaceWindow.browser != null && MarketplaceWindow.browser.loading);
    }

    MarketplacePackage TakeInstall() {
        if (MarketplaceWindow.action != 2) { return null; }
        MarketplaceWindow.action = 0;
        return MarketplaceWindow.browser.SelectedPackage();
    }

    bool TakeClose() {
        if (!MarketplaceWindow.close) { return false; }
        MarketplaceWindow.close = false;
        open = false;
        return true;
    }
}
