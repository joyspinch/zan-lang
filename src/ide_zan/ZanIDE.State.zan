using System;
using System.IO;
using System.Diagnostics;
using Gui;
using Gui.Widget;
using Gui.Designer;
using Gui.Component;
using Game.Scene;

/// The live state of one running IDE instance.
///
/// `ZanIDE.Run()` used to hold all of this as ~220 locals inside a single
/// 3700-line method; keeping it as instance state is what lets the main loop
/// be split into the per-area pump methods (`PumpWizardWindow`,
/// `PumpPublishWindow`, ... ) that share it. Everything is assigned in
/// `Run()` before the loop starts -- the declarations here carry no
/// initializers so the setup order stays exactly where it was.
partial class ZanIDE {
    /// The one running IDE, so a widget handler bound as a method reaches it.
    static ZanIDE current;
    App app;
    int winOpacity;
    string wallPath;
    int wallOpacity;
    int savedW;
    int savedH;
    bool haveProject;
    string root;
    List<TreeNode> tree;
    bool rescan;
    List<string> tabNames;
    List<string> tabBodies;
    List<string> tabPaths;
    SignalInt activeTab;
    Tabs editorTabs;
    List<string> editorTabLabels;
    CodeEditor editor;
    // What was last read from / written to disk for every open file, and the
    // pending questions it produces (see ZanIDE.Docs.zan).
    DocBaseline docs;
    LayerState closeAsk;
    int closeAskTab;
    // Tab kept by a running "close other tabs", "" when none is in progress.
    string closeOthersKeepPath;
    LayerState reloadAsk;
    int reloadAskTab;
    int diskPollMs;
    StatusBar statusBar;
    int sbPosItem;
    int sbModeItem;
    int sbEncItem;
    ErrorList errorList;
    Button outClearBtn;
    int lastActive;
    string loadedFormPath;
    string formCache;
    string loadedScenePath;
    string sceneCache;
    List<string> log;
    List<string> ribbonTabs;
    SignalInt ribbonTab;
    List<string> catNames;
    List<Tpl> tpls;
    List<WizardTemplate> wizTpls;
    List<WizardItem> fileItems;
    App dlg;
    int dlgMode;
    FilePicker pathPicker;
    int pathPickerOwner;
    SignalInt catSel;
    SignalInt pSel;
    SignalInt fSel;
    List<string> platformGroups;
    List<WizardTarget> platforms;
    Input pNameInput;
    Input pLocInput;
    Input fNameInput;
    int ctxKind;
    int ctxX;
    int ctxY;
    int ctxTarget;
    SignalInt tmplCatSel;
    Input tmplNameInput;
    List<WizardItem> saveItems;
    int findMode;
    string findText;
    string replText;
    List<string> fifPath;
    List<string> fifLine;
    List<string> fifText;
    string fifQuery;
    string fifRepl;
    bool fifReplFocus;
    int fifSel;
    string gotoText;
    string renameText;
    string renameWord;
    int findMatch;
    Button findBtn;
    Button findNextBtn;
    Button replBtn;
    Button replAllBtn;
    Button gotoBtn;
    StartPage startPage;
    Button debugContinueBtn;
    Button debugStepOverBtn;
    Button debugStepIntoBtn;
    Button debugStopBtn;
    App pubWin;
    bool pubPending;
    List<int> pubSel;
    bool pubBusy;
    List<string> pubExes;
    int pubLogLen;
    App cfgWin;
    App assetWin;
    int edThemeIdx;
    int edFontPx;
    int defFontPx;
    EditorSettingsWindow settingsWindow;
    Input docsSearch;
    SignalInt docsSel;
    SignalInt docsSection;
    SignalInt docsScroll;
    SignalInt docsCodeScroll;
    SignalBool docsDemoBool;
    SignalInt docsDemoInt;
    Input docsDemoInput;
    int pendingGotoLine;
    int pendingGotoCol;
    LogState coLog;
    bool coCtxOpen;
    int coCtxX;
    int coCtxY;
    int coCtxRow;
    Input coFilter;
    int dbgState;
    int dbgExecLine;
    DebugSession dbg;
    List<string> dbgConsole;
    List<string> dbgVarInfo;
    List<string> dbgStack;
    SignalInt dbgPanelTab;
    List<int> bpCondLines;
    List<string> bpCondExprs;
    string bpCondText;
    List<string> dbgWatches;
    List<string> dbgWatchVals;
    string watchText;
    LspSession lspSess;
    bool lspTried;
    bool designerMode;
    Designer formDesigner;
    string codeViewForm;
    CodeEditor formCodeEd;
    string formCodeLoaded;
    bool sceneMode;
    SceneDesigner sceneDesigner;
    AssetManager assetMgr;
    SignalInt treeW;
    SignalInt bottomPanelH;
    SignalInt rightW;
    DockHost dock;
    string dockOutlineTitle;
    string dockErrorsTitle;
    List<string> gitFiles;
    string gitBranch;
    bool gitLoaded;
    int gitJob;
    SignalInt gitSel;
    ListView<string> gitList;
    SignalInt gitScroll;
    Input gitMsgIn;
    List<TreeNode> rtToolTree;
    List<TreeNode> rtExTree;
    SignalInt rtToolSel;
    SignalInt rtExSel;
    Input rtToolFilter;
    Input rtExFilter;
    List<TreeNode> rtCtxShow;
    List<string> aiRole;
    List<string> aiText;
    SignalInt aiScroll;
    SignalInt aiBusy;
    Input aiInput;
    Button aiSendBtn;
    Button aiApplyBtn;
    Button aiReplaceBtn;
    List<string> aiProfNames;
    List<string> aiProfBases;
    List<string> aiProfKeys;
    List<string> aiProfModels;
    List<string> aiProfLists;
    int aiProfActive;
    AiSettingsWindow aiWindow;
    SelectBox aiModelSel;
    List<string> aiModelOpts;
    int aiModelSelProf;
    Button aiCfgBtn;
    Button aiPredictBtn;
    List<string> aiSessions;
    int aiSessCur;
    Button aiSessPrevBtn;
    Button aiSessNextBtn;
    Button aiSessNewBtn;
    Button aiSessClearBtn;
    // E: forks the current session into a new one seeded with a digest.
    Button aiForkBtn;
    SessionList aiSessNav;
    // G: per-session task plan drawn as a checklist above the chat. planText /
    // planDone (0/1) are parallel; the plan is stored inside the session record
    // (ChatPack/ChatUnpack) so switching sessions keeps it, and it lives
    // outside the transcript so context compaction never drops it.
    List<string> aiPlanText;
    List<int> aiPlanDone;
    bool aiPlanCollapsed;
    Button aiPlanClearBtn;
    List<string> aiCacheLines;
    List<int> aiCacheColors;
    List<int> aiCacheKinds;
    string aiCacheKey;
    // C: drag-to-select / copy state for the chat transcript (LogView model,
    // over the wrapped display lines in aiCacheLines).
    LogState aiChatSel;
    // F: per-message reasoning ("" when none), kept parallel to aiRole/aiText
    // but out of the model-visible transcript; shown as a separate "Thinking"
    // section. Padded/trimmed to length by AiSyncReason each frame.
    List<string> aiReason;
    // D: token usage of the last reply (from the stream's usage object), shown
    // in the context-usage ring's tooltip; the ring itself measures the live
    // transcript against AiAgent.MaxContextChars().
    int aiTokPrompt;
    int aiTokCompletion;
    int aiTokTotal;
    SignalInt aiPredBusy;
    int aiPredTab;
    // The request the assistant loop is currently answering: kept so a tool
    // result can be sent back on the same profile / model / open file the
    // question started on, from the poll that has no panel scope.
    string aiRunModel;
    string aiRunCtxName;
    string aiRunCtxCode;
    // Batch-2 action tools: the tool call parked awaiting the user's Approve
    // ("" when none), whether mutating tools may run without asking, whether
    // the in-flight build was kicked off by the assistant loop, and the three
    // confirm-bar / toggle buttons.
    string aiPendingCall;
    bool aiAutoExec;
    bool aiBuildForAi;
    Button aiApproveBtn;
    Button aiRejectBtn;
    Button aiAutoBtn;
    // ui_check (batch-3 self-verification): a build kicked off for ui_check
    // sets aiUiPending, and once it links the target is launched under the Gui
    // UiDriver with the model's script; aiUiRunning then waits for the driven
    // window to close (or aiUiDeadline, a Window.GetTickMs() cutoff) before
    // feeding the driver log + hit-region dump back to the model.
    bool aiUiPending;
    bool aiUiRunning;
    string aiUiScript;
    int aiUiDeadline;
    // Chat-request watchdog: when the current response first appeared on disk
    // (0 = not yet) and when the wait for it began (0 = not waiting). They let
    // a request complete on a settled response file even if the done-marker is
    // lost, and time the wait out so the panel never hangs on 'thinking'.
    int aiChatFirstResp;
    int aiWaitStart;
    // Streaming chat: the index of the live assistant bubble showing the
    // partial answer as it arrives (-1 = none yet) and the last stream-file
    // length seen, so a frame only re-parses when the decoded body grew.
    int aiStreamMsgIdx;
    int aiStreamLen;
    int termFp;
    int termLogLen;
    int runLogLen;
    bool runStreaming;
    bool buildBusy;
    int buildLogLen;
    string buildExe;
    bool buildIsGui;
    bool buildThenRun;
    bool dbgBuildPending;
    string buildTargetPath;
    bool autoRun;
    bool hotReloadReq;
    SignalInt treeSel;
    List<TreeNode> exTree;
    SignalInt exSel;
    Input treeFilter;
    Input structFilter;
    Input exFilter;
    List<TreeNode> treeShow;
    List<TreeNode> structShow;
    List<TreeNode> exShow;
    List<TreeNode> structTree;
    SignalInt structSel;
    string structSig;
    int lastPresent;
    int lastSkinIdx;
    // Retained sidebar trees. Each owns its filter row, scrolling, scrollbar,
    // selection and hit testing; the IDE only rebinds the node list and
    // registers handlers.
    TreeView explorerTv;
    TreeView structTv;
    TreeView stdlibTv;
    TreeView toolsTv;
    TreeView examplesTv;
}
