using System;
using System.IO;
using System.Diagnostics;
using Gui;
using Gui.Widget;
using Gui.Designer;
using Gui.Component;
using Game.Scene;

/// One open editor tab.
class TabRecord {
    string name;
    string body;
    string path;
    /// Where the caret and the viewport were when this tab was last left, so
    /// coming back continues where reading stopped instead of at line 1.
    int caretLine;
    int caretCol;
    int scrollLine;

    static TabRecord Create(string name, string body, string path) {
        TabRecord tab = new TabRecord();
        tab.name = name;
        tab.body = body;
        tab.path = path;
        tab.caretLine = 0;
        tab.caretCol = 0;
        tab.scrollLine = 0;
        return tab;
    }
}

/// One project-wide search result. `line` is 0-based.
class SearchHit {
    string path;
    int line;
    string text;

    static SearchHit Create(string path, int line, string text) {
        SearchHit hit = new SearchHit();
        hit.path = path;
        hit.line = line;
        hit.text = text;
        return hit;
    }
}

/// One AI provider configuration persisted in ai_profiles.json.
class AiProfile {
    string name;
    string baseUrl;
    string key;
    string model;
    string models;
    string limits;
    /// Team mode: `{"<role id>": "<model id>"}`, the model each member runs on
    /// under this provider. A member without an entry uses `model`, so a config
    /// written before team models existed keeps working unchanged.
    string roles;

    static AiProfile Create(string name, string baseUrl, string key, string model,
            string models, string limits) {
        AiProfile profile = new AiProfile();
        profile.name = name;
        profile.baseUrl = baseUrl;
        profile.key = key;
        profile.model = model;
        profile.models = models;
        profile.limits = limits;
        profile.roles = "{}";
        return profile;
    }
}

/// One chat message: the role shown in the transcript (user / assistant /
/// tool / error), the message text and the per-message reasoning ("" when
/// none). One entity instead of parallel role/text/reason lists.
class AiChatMsg {
    string role;
    string text;
    string reason;
    /// Team sessions only: the role id of the member that spoke ("" for the
    /// user and for a single-assistant session), the comma-joined role ids the
    /// message is addressed to, the protocol beat (AiTeam.Kind*) and the task
    /// it belongs to. Empty on every message a single-assistant session
    /// produces, which is what lets one transcript format serve both modes.
    string agent;
    string to;
    string kind;
    string taskId;
    int progress;

    static AiChatMsg Create(string role, string text) {
        AiChatMsg m = new AiChatMsg();
        m.role = role;
        m.text = text;
        m.reason = "";
        m.agent = "";
        m.to = "";
        m.kind = "";
        m.taskId = "";
        m.progress = 0;
        return m;
    }

    /// One message from a team member, with its parsed envelope attached.
    static AiChatMsg CreateFrom(string role, string text, string agent,
            string to, string kind, string taskId, int progress) {
        AiChatMsg m = AiChatMsg.Create(role, text);
        m.agent = agent;
        m.to = to;
        m.kind = kind;
        m.taskId = taskId;
        m.progress = progress;
        return m;
    }

    static AiChatMsg CreateWithReason(string role, string text, string reason) {
        AiChatMsg m = AiChatMsg.Create(role, text);
        m.reason = reason;
        return m;
    }
}

/// One step of the per-session task plan checklist (text + 0/1 done). One
/// entity instead of parallel text/done lists.
class AiPlanStep {
    string text;
    int done;

    static AiPlanStep Create(string text, int done) {
        AiPlanStep s = new AiPlanStep();
        s.text = text;
        s.done = done;
        return s;
    }
}

/// One saved AI chat session: its serialized transcript (ChatPack JSON) plus
/// the archive flag. One entity instead of parallel pack/flag lists.
class AiSession {
    string pack;
    int archived;
    /// The name the user gave this chat. "" means the list shows its first
    /// message instead, which is only a guess at what the chat is about.
    string title;

    static AiSession Create(string pack, int archived) {
        AiSession s = new AiSession();
        s.pack = pack;
        s.archived = archived;
        s.title = "";
        return s;
    }
}

/// The user-given chat names, as one persisted document (a session's own pack
/// is the transcript, and older databases simply have no titles row).
class AiTitlesDoc {
    List<string> t;
}

/// One built-in AI provider preset.
class AiPreset {
    string name;
    string baseUrl;
    string model;
    string registrationUrl;

    static AiPreset Create(string name, string baseUrl, string model,
            string registrationUrl) {
        AiPreset preset = new AiPreset();
        preset.name = name;
        preset.baseUrl = baseUrl;
        preset.model = model;
        preset.registrationUrl = registrationUrl;
        return preset;
    }
}

/// One IDE diagnostic record, shared by the errors panel and code editor.
class DiagnosticRecord {
    string path;
    string line;
    string msg;

    DiagnosticRecord(string path, string line, string msg) {
        this.path = path;
        this.line = line;
        this.msg = msg;
    }
}

/// The live state of one running IDE instance.
///
/// `ZanIDE.Run()` used to hold all of this as ~220 locals inside a single
/// 3700-line method; keeping it as instance state is what lets the main loop
/// be split into the per-area pump methods (`PumpWizardWindow`,
/// `PumpPublishWindow`, ... ) that share it. Everything is assigned in
/// `Run()` before the loop starts -- the declarations here carry no
/// initializers so the setup order stays exactly where it was.
partial class ZanIDE {
    /// The one running IDE, so a widget handler bound as a method reaches it.
    static ZanIDE current;
    /// The navigation search list (project + stdlib sources) and the project it
    /// was built for; see ZanIDE.NavSearchFiles.
    static List<string> navFiles;
    static string navFilesRoot;
    App app;
    int winOpacity;
    string wallPath;
    int wallOpacity;
    int savedW;
    int savedH;
    bool haveProject;
    string root;
    List<TreeNode> tree;
    bool rescan;
    List<TabRecord> tabs;
    SignalInt activeTab;
    Tabs editorTabs;
    List<string> editorTabLabels;
    CodeEditor editor;
    // What was last read from / written to disk for every open file, and the
    // pending questions it produces (see ZanIDE.Docs.zan).
    DocBaseline docs;
    LayerState closeAsk;
    int closeAskTab;
    // Tab kept by a running "close other tabs", "" when none is in progress.
    string closeOthersKeepPath;
    LayerState reloadAsk;
    int reloadAskTab;
    int diskPollMs;
    StatusBar statusBar;
    int sbPosItem;
    int sbModeItem;
    int sbEncItem;
    ErrorList errorList;
    int lastActive;
    string loadedFormPath;
    string formCache;
    string loadedScenePath;
    string sceneCache;
    List<string> log;
    List<string> ribbonTabs;
    SignalInt ribbonTab;
    List<string> catNames;
    List<Tpl> tpls;
    List<WizardTemplate> wizTpls;
    List<WizardItem> fileItems;
    App dlg;
    int dlgMode;
    FilePicker pathPicker;
    int pathPickerOwner;
    SignalInt catSel;
    SignalInt pSel;
    SignalInt fSel;
    /// Selected window-size preset in the New File wizard (index into
    /// Wizard.SizePresetW/H, -1 = none). Applied to Form / Free Layout /
    /// Game Scene templates together with the custom width/height inputs.
    SignalInt fSizeSel;
    Input fSizeWIn;
    Input fSizeHIn;
    List<string> platformGroups;
    List<WizardTarget> platforms;
    Input pNameInput;
    Input pLocInput;
    Input fNameInput;
    int ctxKind;
    int ctxX;
    int ctxY;
    int ctxTarget;
    SignalInt tmplCatSel;
    Input tmplNameInput;
    List<WizardItem> saveItems;
    int findMode;
    string findText;
    string replText;
    List<SearchHit> fifHits;
    string fifQuery;
    string fifRepl;
    bool fifReplFocus;
    int fifSel;
    string gotoText;
    string renameText;
    string renameWord;
    int findMatch;
    Button findBtn;
    Button findNextBtn;
    Button replBtn;
    Button replAllBtn;
    Button gotoBtn;
    StartPage startPage;
    PublishWindow pubWin;
    bool pubPending;
    List<int> pubSel;
    bool pubBusy;
    List<string> pubExes;
    int pubLogLen;
    ConfigWindow cfgWin;
    MarketplaceWindow marketplaceWin;
    MarketplacePackage marketplaceInstall;
    bool marketplaceRetryBuild;
    int edThemeIdx;
    int edFontPx;
    int defFontPx;
    EditorSettingsWindow settingsWindow;
    int pendingGotoLine;
    int pendingGotoCol;
    LogState coLog;
    bool coCtxOpen;
    int coCtxX;
    int coCtxY;
    int coCtxRow;
    Input coFilter;
    int dbgState;
    int dbgExecLine;
    DebugSession dbg;
    List<string> dbgConsole;
    List<DbgVar> dbgVarInfo;
    List<DbgFrame> dbgStack;
    SignalInt dbgPanelTab;
    List<DbgBreakpoint> bpConds;
    string bpCondText;
    List<string> dbgWatches;
    List<DbgVar> dbgWatchVals;
    string watchText;
    LspSession lspSess;
    bool lspTried;
    bool designerMode;
    Designer formDesigner;
    string codeViewForm;
    CodeEditor formCodeEd;
    string formCodeLoaded;
    bool sceneMode;
    SceneDesigner sceneDesigner;
    AssetManager assetMgr;
    SignalInt treeW;
    SignalInt bottomPanelH;
    SignalInt rightW;
    DockHost dock;
    string dockOutlineTitle;
    string dockErrorsTitle;
    List<string> gitFiles;
    string gitBranch;
    bool gitLoaded;
    int gitJob;
    SignalInt gitSel;
    ListView<string> gitList;
    SignalInt gitScroll;
    Input gitMsgIn;
    List<TreeNode> rtToolTree;
    List<TreeNode> rtExTree;
    SignalInt rtToolSel;
    SignalInt rtExSel;
    Input rtToolFilter;
    Input rtExFilter;
    List<TreeNode> rtCtxShow;
    List<AiChatMsg> aiMsgs;
    SignalInt aiScroll;
    SignalInt aiBusy;
    TextArea aiInput;
    Button aiSendBtn;
    Button aiApplyBtn;
    Button aiReplaceBtn;
    List<AiProfile> aiProfiles;
    int aiProfActive;
    AiSettingsWindow aiWindow;
    SelectBox aiModelSel;
    List<string> aiModelOpts;
    /// For each dropdown option: which profile (index) it belongs to, so the
    /// header selector picks provider + model together (two providers can list
    /// the same model id).
    List<int> aiModelOptProf;
    int aiModelSelProf;
    /// Signature of the profile set the model dropdown was last built from;
    /// the dropdown is rebuilt when it changes.
    string aiModelSelSig;
    Button aiCfgBtn;
    /// Replaces Send while a request is in flight: abandons it.
    Button aiStopBtn;
    List<AiSession> aiSessions;
    int aiSessCur;
    /// Database the chats in `aiSessions` came from, so a project switch writes
    /// them back where they belong before loading the new project's list.
    string aiSessDbPath;
    /// Tick of the last AI-session autosave; the transcript is written to disk
    /// at most once per second so streaming a long answer does not hammer the
    /// filesystem, but a crash never loses more than a second of chat.
    int aiLastSave;
    Button aiSessPrevBtn;
    Button aiSessNextBtn;
    Button aiSessNewBtn;
    Button aiSessClearBtn;
    SessionList aiSessNav;
    // G: per-session task plan drawn as a checklist above the chat. The plan
    // is stored inside the session record (ChatPack/ChatUnpack) so switching
    // sessions keeps it, and it lives outside the transcript so context
    // compaction never drops it.
    List<AiPlanStep> aiPlan;
    bool aiPlanCollapsed;
    Button aiPlanClearBtn;
    // Chat transcript wrapped-line cache, one ChatLine entity per display row
    // (text/color/kind/meta/owner); rebuilt only when the transcript, width or
    // theme changes — rewrapping every frame is too slow.
    List<ChatLine> aiCacheLines;
    // Message indices of tool results currently expanded (empty = all collapsed
    // to a single summary line). Ephemeral view state; cleared on session
    // switch / fork like the scroll offset.
    List<int> aiToolOpen;
    string aiCacheKey;
    /// Layout inputs (width / font / expanded sections) the cache was wrapped
    /// with; when these change every line must be re-wrapped.
    string aiCacheSig;
    /// Turns whose wrapped lines are already in the cache and cannot change
    /// any more (everything except the last, streaming, turn).
    int aiCacheTurns;
    /// Line count of those settled turns: the tail is truncated back to here
    /// and only the last turn is re-wrapped while an answer streams in.
    int aiCachePrefix;
    // C: drag-to-select / copy state for the chat transcript (LogView model,
    // over the wrapped display lines in aiCacheLines).
    LogState aiChatSel;
    // F: 1 while the "Thinking" reasoning sections are expanded; collapsed (0)
    // by default so the model's thinking never buries the answer. Toggled by
    // clicking a reasoning header row in the transcript.
    SignalInt aiThinkOpen;
    // D: token usage of the last reply (from the stream's usage object), shown
    // in the context-usage ring's tooltip; the ring itself measures the live
    // transcript against AiAgent.MaxContextChars().
    int aiTokPrompt;
    int aiTokCompletion;
    int aiTokTotal;
    // Prompt tokens the provider served from its cache on the last reply
    // (a subset of aiTokPrompt; 0 when the provider reports no caching).
    int aiTokCached;
    // How many times the request in flight has already been resent after a
    // transport failure, and how many "continue" turns the current question
    // has been pushed on with. Both reset when the user sends a new message,
    // and bound the two automatic loops (AiAgent.MaxRetries/MaxContinues).
    int aiRetry;
    int aiAutoCont;
    // Context / usage card: hovered this frame, pinned open by a click on the
    // ring, and where the ring last drew it (the card is painted after the
    // whole panel so nothing overlaps it).
    bool aiUsageOver;
    bool aiUsagePinned;
    int aiUsageX;
    int aiUsageY;
    // The request the assistant loop is currently answering: kept so a tool
    // result can be sent back on the same profile / model / open file the
    // question started on, from the poll that has no panel scope.
    string aiRunModel;
    string aiRunCtxName;
    string aiRunCtxCode;
    // Batch-2 action tools: the tool call parked awaiting the user's Approve
    // ("" when none), whether mutating tools may run without asking, whether
    // the in-flight build was kicked off by the assistant loop, and the three
    // confirm-bar / toggle buttons.
    string aiPendingCall;
    bool aiAutoExec;
    bool aiBuildForAi;
    Button aiApproveBtn;
    Button aiRejectBtn;
    Button aiAutoBtn;
    // ui_check (batch-3 self-verification): a build kicked off for ui_check
    // sets aiUiPending, and once it links the target is launched under the Gui
    // UiDriver with the model's script; aiUiRunning then waits for the driven
    // window to close (or aiUiDeadline, a Window.GetTickMs() cutoff) before
    // feeding the driver log + hit-region dump back to the model.
    bool aiUiPending;
    bool aiUiRunning;
    string aiUiScript;
    int aiUiDeadline;
    // "ui_check" or "ui_tree": the same drive-the-window machinery serves both,
    // and only the result differs (ui_tree also reports the skin's tokens), so
    // the in-flight tool name has to survive until the run completes.
    string aiUiTool;
    // Team mode. Off by default: with aiTeamMode false every path below behaves
    // exactly as the single assistant did, so turning the team on is opt-in and
    // reversible per chat.
    bool aiTeamMode;
    /// @-mention picker: the row the arrow keys are on, and the composer text
    /// the user dismissed the list for with Esc (the list stays away until the
    /// mention is typed further, instead of popping straight back up).
    int aiMentSel;
    string aiMentHidden;
    // The member the in-flight request speaks as ("" = the single assistant).
    // Tool results, retries and auto-continues all have to come back to the
    // SAME member, or a handoff would silently change who is working.
    string aiRunAgent;
    AiTeamState aiTeamSt;
    // Automatic handoffs taken since the user last spoke, bounded so the team
    // cannot loop between two members without the user noticing.
    int aiHandoffs;
    /// The task board, folded together from the envelopes as they go past.
    List<AiTask> aiTasks;
    /// Whether the team strip is expanded. Collapsed by default: the summary is
    /// what the reader wants, the roster and board are one click away.
    SignalInt aiTeamOpen;
    // Chat-request watchdog: when the current response first appeared on disk
    // (0 = not yet) and when the wait for it began (0 = not waiting). They let
    // a request complete on a settled response file even if the done-marker is
    // lost, and time the wait out so the panel never hangs on 'thinking'.
    int aiChatFirstResp;
    int aiWaitStart;
    // Streaming chat: the index of the live assistant bubble showing the
    // partial answer as it arrives (-1 = none yet) and the last stream-file
    // length seen, so a frame only re-parses when the decoded body grew.
    int aiStreamMsgIdx;
    int aiStreamLen;
    int termFp;
    int termLogLen;
    int runLogLen;
    bool runStreaming;
    bool buildBusy;
    int buildLogLen;
    // Last-modified stamp of the symbol index the editor has loaded, so the
    // main-loop poll can detect a newer one (a background EmitSymbolsDetach
    // finishing, or a build writing a fresh index) and reload it.
    long symbolIdxStamp;
    // Tick of the last background symbol-index run, so a burst of saves is one
    // compiler run instead of one per save.
    int symbolEmitMs;
    string buildExe;
    bool buildIsGui;
    bool buildThenRun;
    bool dbgBuildPending;
    string buildTargetPath;
    bool autoRun;
    bool hotReloadReq;
    SignalInt treeSel;
    List<TreeNode> exTree;
    SignalInt exSel;
    Input treeFilter;
    Input structFilter;
    Input exFilter;
    List<TreeNode> treeShow;
    List<TreeNode> structShow;
    List<TreeNode> exShow;
    List<TreeNode> structTree;
    SignalInt structSel;
    string structSig;
    int lastPresent;
    int lastSkinIdx;
    // Retained sidebar trees. Each owns its filter row, scrolling, scrollbar,
    // selection and hit testing; the IDE only rebinds the node list and
    // registers handlers.
    TreeView explorerTv;
    TreeView structTv;
    TreeView stdlibTv;
    TreeView toolsTv;
    TreeView examplesTv;
}
