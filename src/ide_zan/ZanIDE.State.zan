using System;
using System.IO;
using System.Diagnostics;
using Gui;
using Gui.Widget;
using Game.Scene;

/// The live state of one running IDE instance.
///
/// `ZanIDE.Run()` used to hold all of this as ~220 locals inside a single
/// 3700-line method; keeping it as instance state is what lets the main loop
/// be split into the per-area pump methods (`PumpWizardWindow`,
/// `PumpPublishWindow`, ... ) that share it. Everything is assigned in
/// `Run()` before the loop starts -- the declarations here carry no
/// initializers so the setup order stays exactly where it was.
partial class ZanIDE {
    App app;
    int winOpacity;
    string wallPath;
    int wallOpacity;
    int savedW;
    int savedH;
    bool haveProject;
    string root;
    List<TreeNode> tree;
    bool rescan;
    List<string> tabNames;
    List<string> tabBodies;
    List<string> tabPaths;
    SignalInt activeTab;
    CodeEditor editor;
    // What was last read from / written to disk for every open file, and the
    // pending questions it produces (see ZanIDE.Docs.zan).
    DocBaseline docs;
    LayerState closeAsk;
    int closeAskTab;
    // Tab kept by a running "close other tabs", "" when none is in progress.
    string closeOthersKeepPath;
    LayerState reloadAsk;
    int reloadAskTab;
    int diskPollMs;
    StatusBar statusBar;
    int sbPosItem;
    int sbModeItem;
    int sbEncItem;
    ErrorList errorList;
    Button outClearBtn;
    int lastActive;
    string loadedFormPath;
    string formCache;
    string loadedScenePath;
    string sceneCache;
    List<string> log;
    List<string> ribbonTabs;
    SignalInt ribbonTab;
    List<string> catNames;
    List<Tpl> tpls;
    List<WizardTemplate> wizTpls;
    List<WizardItem> fileItems;
    App dlg;
    int dlgMode;
    FilePicker pathPicker;
    int pathPickerOwner;
    SignalInt catSel;
    SignalInt pSel;
    SignalInt fSel;
    List<string> platformGroups;
    List<WizardTarget> platforms;
    Input pNameInput;
    Input pLocInput;
    Input fNameInput;
    int ctxKind;
    int ctxX;
    int ctxY;
    int ctxTarget;
    SignalInt tmplCatSel;
    Input tmplNameInput;
    List<WizardItem> saveItems;
    int findMode;
    string findText;
    string replText;
    List<string> fifPath;
    List<string> fifLine;
    List<string> fifText;
    string fifQuery;
    string fifRepl;
    bool fifReplFocus;
    int fifSel;
    string gotoText;
    string renameText;
    string renameWord;
    int findMatch;
    Button findBtn;
    Button findNextBtn;
    Button replBtn;
    Button replAllBtn;
    Button gotoBtn;
    StartPage startPage;
    Button debugContinueBtn;
    Button debugStepOverBtn;
    Button debugStepIntoBtn;
    Button debugStopBtn;
    App pubWin;
    bool pubPending;
    List<int> pubSel;
    bool pubBusy;
    List<string> pubExes;
    int pubLogLen;
    App cfgWin;
    App assetWin;
    int edThemeIdx;
    int edFontPx;
    int defFontPx;
    EditorSettingsWindow settingsWindow;
    Input docsSearch;
    SignalInt docsSel;
    SignalInt docsSection;
    SignalInt docsScroll;
    SignalInt docsCodeScroll;
    SignalBool docsDemoBool;
    SignalInt docsDemoInt;
    Input docsDemoInput;
    int pendingGotoLine;
    int pendingGotoCol;
    LogState coLog;
    bool coCtxOpen;
    int coCtxX;
    int coCtxY;
    int coCtxRow;
    Input coFilter;
    int dbgState;
    int dbgExecLine;
    DebugSession dbg;
    List<string> dbgConsole;
    List<string> dbgVarInfo;
    List<string> dbgStack;
    SignalInt dbgPanelTab;
    List<int> bpCondLines;
    List<string> bpCondExprs;
    string bpCondText;
    List<string> dbgWatches;
    List<string> dbgWatchVals;
    string watchText;
    LspSession lspSess;
    bool lspTried;
    bool designerMode;
    Designer formDesigner;
    string codeViewForm;
    CodeEditor formCodeEd;
    string formCodeLoaded;
    bool sceneMode;
    SceneDesigner sceneDesigner;
    AssetManager assetMgr;
    SignalInt treeW;
    SignalInt bottomPanelH;
    SignalInt rightW;
    DockHost dock;
    string dockOutlineTitle;
    string dockErrorsTitle;
    List<string> gitFiles;
    string gitBranch;
    bool gitLoaded;
    int gitJob;
    SignalInt gitSel;
    ListState gitList;
    SignalInt gitScroll;
    Input gitMsgIn;
    List<TreeNode> rtToolTree;
    List<TreeNode> rtExTree;
    SignalInt rtToolSel;
    SignalInt rtExSel;
    Input rtToolFilter;
    Input rtExFilter;
    SignalInt rtToolScroll;
    SignalInt rtExScroll;
    List<TreeNode> rtCtxShow;
    List<string> aiRole;
    List<string> aiText;
    SignalInt aiScroll;
    SignalInt aiBusy;
    Input aiInput;
    Button aiSendBtn;
    Button aiApplyBtn;
    Button aiReplaceBtn;
    List<string> aiProfNames;
    List<string> aiProfBases;
    List<string> aiProfKeys;
    List<string> aiProfModels;
    List<string> aiProfLists;
