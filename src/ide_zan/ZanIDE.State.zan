    Button aiCfgBtn;
    Button aiPredictBtn;
    List<string> aiSessions;
    int aiSessCur;
    Button aiSessPrevBtn;
    Button aiSessNextBtn;
    Button aiSessNewBtn;
    Button aiSessClearBtn;
    List<string> aiCacheLines;
    List<int> aiCacheColors;
    List<int> aiCacheKinds;
    string aiCacheKey;
    SignalInt aiPredBusy;
    int aiPredTab;
    int termFp;
    int termLogLen;
    int runLogLen;
    bool runStreaming;
    bool buildBusy;
    int buildLogLen;
    string buildExe;
    bool buildIsGui;
    bool buildThenRun;
    bool dbgBuildPending;
    string buildTargetPath;
    bool autoRun;
    bool hotReloadReq;
    SignalInt treeSel;
    int lastTreeSel;
    SignalInt treeScrollY;
    List<TreeNode> exTree;
    SignalInt exSel;
    Input treeFilter;
    Input structFilter;
    Input exFilter;
    List<TreeNode> treeShow;
    List<TreeNode> structShow;
    List<TreeNode> exShow;
    int lastExSel;
    SignalInt exTreeScrollY;
    List<TreeNode> structTree;
    SignalInt structSel;
    int lastStructSel;
    SignalInt structScrollY;
    string structSig;
    int lastPresent;
    int lastSkinIdx;
}
