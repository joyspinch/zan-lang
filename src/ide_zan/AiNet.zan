using System;
using System.IO;
using System.Threading;
using System.Net.Sockets;
using System.Net.Http;
using System.Net.Http.Client;

/// The AI chat transport: a real HTTPS request made with the Net standard
/// library, running on a worker thread INSIDE the IDE process. The decoded
/// response body (a text/event-stream) lands in an in-memory sink as chunks
/// arrive; the GUI thread reads the sink every frame, so the answer appears
/// incrementally while the event loop stays responsive.
///
/// Nothing is written to disk: the sink hands the bytes and the outcome
/// across the thread boundary under its own lock. Earlier versions ran the
/// request in a re-executed child process and passed the stream through
/// files in the cache directory, because driving the async reactor on a
/// second OS thread was thought to race the GUI thread's allocator. It does
/// not: object refcounts are atomic and the allocator is per-thread, and the
/// scheduler and reactor state a request touches belong to the thread that
/// drives them.
class AiNet {
    static string sHost;
    static int sPort;
    static bool sTls;
    static bool sVerify;
    static string sPath;
    static string sKey;
    static string sBody;
    static int sTimeout;

    /// The sink of the request in flight. Replaced by every new request and
    /// dropped (set to null) by a cancel: the worker of an abandoned request
    /// keeps writing into the sink object it captured, which nobody reads any
    /// more, so a late chunk or a late error can never land in the answer to
    /// the next question.
    static SseSink sSink;

    /// The sink the worker thread streams into (captured before the GUI can
    /// replace `sSink`).
    static SseSink sWorkerSink;

    /// The request itself: builds the client from the shared fields and
    /// streams the response into the worker's sink.
    static async int RunReq() {
        HttpClient cli;
        if (AiNet.sTls) { cli = HttpClient.CreateHttps(AiNet.sHost, AiNet.sPort); }
        else { cli = HttpClient.Create(AiNet.sHost, AiNet.sPort); }
        if (!AiNet.sVerify) { cli.DisableTlsVerify(); }
        if (AiNet.sKey != "") { cli.SetHeader("Authorization", "Bearer " + AiNet.sKey); }
        cli.SetHeader("Content-Type", "application/json");
        cli.SetHeader("Accept", "text/event-stream");
        cli.SetTimeout(AiNet.sTimeout);
        int rr = await cli.PostSseToSinkAsync(AiNet.sPath, AiNet.sBody,
                                              AiNet.sWorkerSink);
        return rr;
    }

    /// True when an outcome marker means success (it begins with "ok").
    static bool IsOk(string marker) {
        string s = marker;
        int a = 0;
        for (a = 0; a < s.Length; a = a + 1) {
            string ch = s.Substring(a, 1);
            if (ch != " " && ch != "\r" && ch != "\n" && ch != "\t") { break; }
        }
        return a + 2 <= s.Length && s.Substring(a, 2) == "ok";
    }

    /// Drives the request to completion on its own OS thread, retrying
    /// transient failures. The thread's coroutine scheduler pumps every
    /// `await` (connect / recv) until the stream ends. Only the final outcome
    /// is published, so the GUI never sees a mid-retry error and a dropped
    /// connection recovers on its own. Up to 4 attempts (3 retries) with a
    /// growing backoff.
    static void Worker() {
        Socket.Initialize();
        SseSink sink = AiNet.sWorkerSink;
        int attempt = 0;
        string last = "";
        while (attempt < 4) {
            last = "";
            // A throw anywhere in the transport (DNS, TLS, a closed socket)
            // must still end as a marker: without this the worker dies
            // silently and the panel waits out its whole backstop before
            // reporting a timeout that was really a connect error.
            try {
                int _r = await AiNet.RunReq();
            } catch (Exception ex) {
                last = "err: " + ex.Message;
            }
            if (last == "") { last = sink.Attempt(); }
            if (AiNet.IsOk(last)) {
                sink.Publish("ok");
                return;
            }
            attempt = attempt + 1;
            // Backoff 1s / 2s / 3s between retries: enough for a dropped
            // connection to recover, short enough to not stall the reply.
            if (attempt < 4) { Thread.Sleep(1000 * attempt); }
        }
        string msg = last;
        if (msg == "") { msg = "err: request failed"; }
        sink.Publish(msg);
    }

    /// Parses `baseUrl` (scheme://host[:port][/base]) into the transport
    /// fields and appends `suffix` (e.g. "/chat/completions") to its path.
    static void SetUrl(string baseUrl, string suffix) {
        string u = baseUrl;
        bool tls = true;
        int defPort = 443;
        if (u.Length >= 8 && u.Substring(0, 8) == "https://") {
            u = u.Substring(8, u.Length - 8); tls = true; defPort = 443;
        } else if (u.Length >= 7 && u.Substring(0, 7) == "http://") {
            u = u.Substring(7, u.Length - 7); tls = false; defPort = 80;
        }
        int slash = AiNet.FindByte(u, 47, 0);
        string hostport = u;
        string basePath = "";
        if (slash >= 0) {
            hostport = u.Substring(0, slash);
            basePath = u.Substring(slash, u.Length - slash);
        }
        while (basePath.Length > 0
            && (basePath[basePath.Length - 1] & 255) == 47) {
            basePath = basePath.Substring(0, basePath.Length - 1);
        }
        int port = defPort;
        string host = hostport;
        int colon = AiNet.FindByte(hostport, 58, 0);
        if (colon >= 0) {
            host = hostport.Substring(0, colon);
            port = AiNet.ParseInt(hostport.Substring(colon + 1,
                hostport.Length - colon - 1), defPort);
        }
        AiNet.sHost = host;
        AiNet.sPort = port;
        AiNet.sTls = tls;
        AiNet.sPath = basePath + suffix;
    }

    static int FindByte(string s, int b, int from) {
        for (int i = from; i < s.Length; i = i + 1) {
            if ((s[i] & 255) == b) { return i; }
        }
        return 0 - 1;
    }

    static int ParseInt(string s, int fallback) {
        int v = 0;
        int i = 0;
        bool any = false;
        while (i < s.Length) {
            int c = s[i] & 255;
            if (c < 48 || c > 57) { break; }
            v = v * 10 + (c - 48);
            any = true;
            i = i + 1;
        }
        if (!any) { return fallback; }
        return v;
    }

    /// Kicks off the request on a worker thread. Returns "" on success or a
    /// readable error when the thread cannot be started.
    static string Start(string baseUrl, string suffix, string key, string body,
            int timeoutMs, bool verify) {
        AiNet.SetUrl(baseUrl, suffix);
        AiNet.sKey = key;
        AiNet.sBody = body;
        AiNet.sTimeout = timeoutMs;
        AiNet.sVerify = verify;
        SseSink sink = SseSink.ToMemory();
        AiNet.sSink = sink;
        AiNet.sWorkerSink = sink;
        if (!Thread.Start(AiNet.Worker)) {
            AiNet.sSink = null;
            return "could not start the AI request thread.";
        }
        return "";
    }

    /// Everything the reply has streamed so far ("" when nothing is in
    /// flight). Safe to call from the GUI thread every frame.
    static string Text() {
        if (AiNet.sSink == null) { return ""; }
        return AiNet.sSink.All();
    }

    /// The final outcome of the request in flight ("ok" / "err: ..."), or ""
    /// while it is still streaming.
    static string Done() {
        if (AiNet.sSink == null) { return ""; }
        return AiNet.sSink.Done();
    }

    /// Forgets the request in flight. A worker still running keeps streaming
    /// into the sink it captured; nothing reads it, and it is freed once the
    /// worker returns.
    static void Abandon() {
        AiNet.sSink = null;
    }
}
