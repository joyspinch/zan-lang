using System;
using System.IO;
using System.Threading;
using System.Net.Sockets;
using System.Net.Http;
using System.Net.Http.Client;

/// The AI chat transport: a real HTTPS request made with the Net standard
/// library. The request runs in a SEPARATE CHILD PROCESS (the IDE re-executes
/// itself in a headless streaming mode) which streams the decoded response body
/// (a text/event-stream) into a file as chunks arrive; the GUI polls that file
/// every frame, so the answer appears incrementally while the SDL event loop
/// stays responsive.
///
/// Why a child process and not a background thread: the Zan runtime's GC and
/// coroutine allocator are not thread-safe, so driving the async network
/// reactor on a second OS thread races the GUI thread's allocations and
/// corrupts the shared heap (observed: `Invalid address to RtlFreeHeap` while
/// the tool loop reads a project). A child process has its own heap, so the
/// network work and the GUI never touch the same allocator. The request
/// parameters are handed to the child through a small descriptor file whose
/// path is passed in the `ZAN_AI_REQ` environment variable.
class AiNet {
    static string sHost;
    static int sPort;
    static bool sTls;
    static bool sVerify;
    static string sPath;
    static string sKey;
    static string sBody;
    static string sOut;
    static string sDone;
    static int sTimeout;

    /// The request itself: builds the client from the shared fields and streams
    /// the response to the output file. `await` runs on this process's reactor.
    static async int RunReq() {
        HttpClient cli;
        if (AiNet.sTls) { cli = HttpClient.CreateHttps(AiNet.sHost, AiNet.sPort); }
        else { cli = HttpClient.Create(AiNet.sHost, AiNet.sPort); }
        if (!AiNet.sVerify) { cli.DisableTlsVerify(); }
        if (AiNet.sKey != "") { cli.SetHeader("Authorization", "Bearer " + AiNet.sKey); }
        cli.SetHeader("Content-Type", "application/json");
        cli.SetHeader("Accept", "text/event-stream");
        cli.SetTimeout(AiNet.sTimeout);
        int rr = await cli.PostSseToFileAsync(AiNet.sPath, AiNet.sBody,
                                              AiNet.sOut, AiNet.sDone);
        return rr;
    }

    /// True when a done-marker text means success (it begins with "ok"; the
    /// streamer can occasionally append it twice -> "okok").
    static bool IsOk(string marker) {
        string s = marker;
        int a = 0;
        while (a < s.Length) {
            string ch = s.Substring(a, 1);
            if (ch != " " && ch != "\r" && ch != "\n" && ch != "\t") { break; }
            a = a + 1;
        }
        return a + 2 <= s.Length && s.Substring(a, 2) == "ok";
    }

    /// Drives the request to completion, retrying transient failures. Run on a
    /// dedicated OS thread: the thread's coroutine scheduler pumps every `await`
    /// (connect/recv) until PostSseToFileAsync finishes and writes its marker.
    /// Each attempt streams into a private marker file; only the final outcome
    /// is published to the real done file, so the GUI never sees a mid-retry
    /// error and a dropped connection recovers on its own (like mainstream AI
    /// coding tools). Up to 4 attempts (3 retries) with a growing backoff for
    /// transient network blips / provider 5xx.
    static void Worker() {
        Socket.Initialize();
        string realDone = AiNet.sDone;
        string tryDone = realDone + ".try";
        int attempt = 0;
        string last = "";
        while (attempt < 4) {
            if (File.Exists(tryDone)) { File.Delete(tryDone); }
            AiNet.sDone = tryDone;
            int _r = await AiNet.RunReq();
            last = "";
            if (File.Exists(tryDone)) { last = File.ReadAllText(tryDone); }
            if (AiNet.IsOk(last)) {
                HttpClient.AppendText(realDone, "ok");
                if (File.Exists(tryDone)) { File.Delete(tryDone); }
                return;
            }
            attempt = attempt + 1;
            // Backoff 1s / 2s / 3s between retries: enough for a dropped
            // connection to recover, short enough to not stall the reply.
            if (attempt < 4) { Thread.Sleep(1000 * attempt); }
        }
        // All attempts failed: surface the last transport error to the GUI.
        string msg = last;
        if (msg == "") { msg = "err: streamer failed"; }
        HttpClient.AppendText(realDone, msg);
        if (File.Exists(tryDone)) { File.Delete(tryDone); }
    }

    /// Headless entry point: the child process runs this instead of the GUI
    /// when `ZAN_AI_REQ` points at a request descriptor. The request runs on a
    /// worker thread (so its scheduler drives the async reactor to completion —
    /// a top-level `await` in this plain entry point would return at the first
    /// suspension and exit the process mid-stream); the main thread simply waits
    /// for the done-marker the worker writes when the stream ends, then exits.
    static void RunStreamerMain(string descFile) {
        List<string> ln = AiNet.ReadLines(descFile);
        if (ln.Count < 8) { return; }
        string baseUrl = ln[0];
        string suffix = ln[1];
        string key = ln[2];
        string bodyFile = ln[3];
        string outFile = ln[4];
        string doneFile = ln[5];
        int timeout = AiNet.ParseInt(ln[6], 600000);
        bool verify = ln[7] == "1";
        string body = "";
        if (File.Exists(bodyFile)) { body = File.ReadAllText(bodyFile); }
        AiNet.SetUrl(baseUrl, suffix);
        AiNet.sKey = key;
        AiNet.sBody = body;
        AiNet.sOut = outFile;
        AiNet.sDone = doneFile;
        AiNet.sTimeout = timeout;
        AiNet.sVerify = verify;
        Thread.Start(AiNet.Worker);
        // Wait for the worker to publish the real done-marker (it does so
        // last, after any retries). The transport's own timeout is an IDLE
        // window (every received chunk re-arms it), so a model that keeps
        // streaming -- e.g. a long thinking phase -- must not be killed by a
        // fixed total budget. The main thread only waits for the worker to
        // finish all its attempts: an idle backstop here would race the
        // transport (whose window resets per attempt) and kill a request that
        // is mid-retry, so the only bound is the hard cap covering the
        // worker's four attempts. A truly dead streamer still surfaces an
        // error through the cap.
        int baseTimeout = timeout;
        if (baseTimeout <= 0) { baseTimeout = 600000; }
        int hardCap = baseTimeout * 4 + 60000;
        int waited = 0;
        while (!File.Exists(doneFile) && waited < hardCap) {
            Thread.Sleep(50);
            waited = waited + 50;
        }
        // Let the worker fully unwind after it wrote the marker.
        Thread.Sleep(150);
        if (!File.Exists(doneFile)) {
            HttpClient.AppendText(doneFile, "err: streamer timeout");
        }
    }

    /// Splits a descriptor file into its lines (trailing CR stripped).
    static List<string> ReadLines(string path) {
        List<string> res = new List<string>();
        if (!File.Exists(path)) { return res; }
        string raw = File.ReadAllText(path);
        int i = 0;
        int n = raw.Length;
        int start = 0;
        while (i <= n) {
            if (i == n || (raw[i] & 255) == 10) {
                string line = raw.Substring(start, i - start);
                if (line.Length > 0 && (line[line.Length - 1] & 255) == 13) {
                    line = line.Substring(0, line.Length - 1);
                }
                res.Add(line);
                start = i + 1;
            }
            i = i + 1;
        }
        return res;
    }

    /// Parses `baseUrl` (scheme://host[:port][/base]) into the transport
    /// fields and appends `suffix` (e.g. "/chat/completions") to its path.
    static void SetUrl(string baseUrl, string suffix) {
        string u = baseUrl;
        bool tls = true;
        int defPort = 443;
        if (u.Length >= 8 && u.Substring(0, 8) == "https://") {
            u = u.Substring(8, u.Length - 8); tls = true; defPort = 443;
        } else if (u.Length >= 7 && u.Substring(0, 7) == "http://") {
            u = u.Substring(7, u.Length - 7); tls = false; defPort = 80;
        }
        int slash = AiNet.FindByte(u, 47, 0);
        string hostport = u;
        string basePath = "";
        if (slash >= 0) {
            hostport = u.Substring(0, slash);
            basePath = u.Substring(slash, u.Length - slash);
        }
        while (basePath.Length > 0
            && (basePath[basePath.Length - 1] & 255) == 47) {
            basePath = basePath.Substring(0, basePath.Length - 1);
        }
        int port = defPort;
        string host = hostport;
        int colon = AiNet.FindByte(hostport, 58, 0);
        if (colon >= 0) {
            host = hostport.Substring(0, colon);
            port = AiNet.ParseInt(hostport.Substring(colon + 1,
                hostport.Length - colon - 1), defPort);
        }
        AiNet.sHost = host;
        AiNet.sPort = port;
        AiNet.sTls = tls;
        AiNet.sPath = basePath + suffix;
    }

    static int FindByte(string s, int b, int from) {
        int i = from;
        while (i < s.Length) {
            if ((s[i] & 255) == b) { return i; }
            i = i + 1;
        }
        return 0 - 1;
    }

    static int ParseInt(string s, int fallback) {
        int v = 0;
        int i = 0;
        bool any = false;
        while (i < s.Length) {
            int c = s[i] & 255;
            if (c < 48 || c > 57) { break; }
            v = v * 10 + (c - 48);
            any = true;
            i = i + 1;
        }
        if (!any) { return fallback; }
        return v;
    }

    /// Directory part of a path (no trailing separator); "" when there is none.
    static string ParentDir(string p) {
        int cut = 0 - 1;
        int i = 0;
        while (i < p.Length) {
            int c = p[i] & 255;
            if (c == 47 || c == 92) { cut = i; }
            i = i + 1;
        }
        if (cut < 0) { return ""; }
        return p.Substring(0, cut);
    }

    /// Kicks off the request in a detached child process. `outFile` is
    /// truncated and `doneFile` removed first so the poller reads only this
    /// request's output. The child receives every parameter through a
    /// descriptor file (path in `ZAN_AI_REQ`); the request body is written to
    /// its own file to avoid any escaping. Returns "" on success or a readable
    /// error when the child cannot be launched.
    static string Start(string baseUrl, string suffix, string key, string body,
            string outFile, string doneFile, int timeoutMs, bool verify) {
        HttpClient.TruncateFile(outFile);
        if (File.Exists(doneFile)) { File.Delete(doneFile); }

        string dir = AiNet.ParentDir(outFile);
        string descFile = dir + "/ai_net.txt";
        string bodyFile = dir + "/ai_body.txt";
        File.WriteAllText(bodyFile, body);
        string vf = "0";
        if (verify) { vf = "1"; }
        string desc = baseUrl + "\n" + suffix + "\n" + key + "\n"
            + bodyFile + "\n" + outFile + "\n" + doneFile + "\n"
            + Convert.ToString(timeoutMs) + "\n" + vf + "\n";
        File.WriteAllText(descFile, desc);

        string exe = ZanIDE.ExePath();
        #if WINDOWS
        // `cmd.exe /c set "VAR=..."&& "exe"` sets the variable only for the
        // child's environment (the `set "VAR=val"` form keeps the value clean).
        string cmd = "set \"ZAN_AI_REQ=" + descFile + "\"&& \"" + exe + "\"";
        #else
        string cmd = "ZAN_AI_REQ=\"" + descFile + "\" \"" + exe + "\"";
        #endif
        int rc = Process.RunDetached(cmd);
        if (rc != 0) {
            return "could not start the AI request process.";
        }
        return "";
    }
}
