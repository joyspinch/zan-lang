using System;
using System.IO;
using System.Diagnostics;
using System.Json;
using Gui;
using Gui.Widget;
using Game.Scene;

/// One call-stack frame shown in the debugger's Call Stack panel: the function
/// name and the source line it is stopped at.
class DbgFrame {
    string name;
    int line;

    static DbgFrame Create(string name, int line) {
        DbgFrame f = new DbgFrame();
        f.name = name;
        f.line = line;
        return f;
    }
}

/// One conditional breakpoint: the 0-based editor line and its condition
/// expression ("" when unconditional). One entity instead of parallel
/// line/expression lists.
class DbgBreakpoint {
    int line;
    string cond;

    static DbgBreakpoint Create(int line, string cond) {
        DbgBreakpoint b = new DbgBreakpoint();
        b.line = line;
        b.cond = cond;
        return b;
    }
}

/// ZanIDE part: DAP-backed debugging drivers -- session begin / sync,
/// breakpoint conditions and watch evaluation over DebugSession.
partial class ZanIDE {
    // ==== Real DAP-backed debugging (P0-2) ================================
    // These helpers drive a DebugSession (a Debug Adapter Protocol client that
    // talks to a spawned zan-dap over a loopback socket), replacing the old
    // static source-instrumentation debugger. Stop locations, the call stack,
    // scopes and variables all come from a real gdb-backed inferior.

    /// Spawns zan-dap in TCP server mode, connects, and runs the launch
    /// handshake (initialize/launch/setBreakpoints/configurationDone) until the
    /// first stop or program exit. `bps0` holds 0-based breakpoints; when empty
    /// a single breakpoint is placed at `fallback0` so F5 still pauses.
    /// Returns the session, or null when the adapter cannot be reached.
    static DebugSession DbgBegin(string root, string srcPath, List<DbgBreakpoint> bps0,
            int fallback0, List<string> log) {
        string exe = ZanIDE.EnsureBuildDir(root) + "/.zandbg" + ZanIDE.ExeSuffix();
        string dap = ZanIDE.ToolchainDir() + "/zan-dap" + ZanIDE.ExeSuffix();
        if (!File.Exists(dap)) { dap = ZanIDE.ExeDir() + "/zan-dap" + ZanIDE.ExeSuffix(); }
        if (!File.Exists(dap)) {
            log.Add("> [Debug] zan-dap not found in toolchain.");
            return null;
        }
        List<DbgBreakpoint> lines = new List<DbgBreakpoint>();
        for (int bi = 0; bi < bps0.Count; bi = bi + 1) {
            lines.Add(DbgBreakpoint.Create(bps0[bi].line + 1, bps0[bi].cond));
        }
        if (lines.Count == 0) { lines.Add(DbgBreakpoint.Create(fallback0 + 1, "")); }

        for (int attempt = 0; attempt < 4; attempt = attempt + 1) {
            int port = 47113 + attempt;
            Process.RunDetached("\"" + dap + "\" --port " + Convert.ToString(port));
            DebugSession s = DebugSession.Open(port, exe, srcPath, lines);
            if (s != null) { return s; }
        }
        log.Add("> [Debug] Could not connect to zan-dap.");
        return null;
    }

    /// Reflects a session's current stop state into the editor + output log and
    /// mirrors the inferior's stdout into the debug console. Returns the debug
    /// UI state (2 = paused, 0 = not debugging).
    static int DbgSync(DebugSession dbg, CodeEditor editor, List<string> log,
            List<string> console) {
        if (dbg == null) {
            editor.SetExecLine(0 - 1);
            return 0;
        }
        while (console.Count > 0) { console.RemoveAt(console.Count - 1); }
        List<string> outp = dbg.Console();
        int oi = 0;
        while (oi < outp.Count) { console.Add(outp[oi]); oi = oi + 1; }
        if (dbg.Paused()) {
            editor.SetExecLine(dbg.CurLine() - 1);
            log.Add("> [Debug] Paused at line " + Convert.ToString(dbg.CurLine()));
            return 2;
        }
        editor.SetExecLine(0 - 1);
        log.Add("> [Debug] Program exited (code "
            + Convert.ToString(dbg.ExitCode()) + ").");
        dbg.Stop();
        return 0;
    }

    /// 0-based editor line for the current stop, or -1 when not paused.
    static int DbgLine(DebugSession dbg) {
        if (dbg == null) { return 0 - 1; }
        if (!dbg.Paused()) { return 0 - 1; }
        return dbg.CurLine() - 1;
    }

    static List<DbgVar> DbgVars(DebugSession dbg) {
        if (dbg == null) { return new List<DbgVar>(); }
        return dbg.Locals();
    }

    static List<DbgFrame> DbgStack(DebugSession dbg) {
        if (dbg == null) { return new List<DbgFrame>(); }
        return dbg.Stack();
    }

    /// Merges the editor's plain breakpoint lines with the stored conditional
    /// breakpoint entities into one list (unconditional lines get "").
    static List<DbgBreakpoint> MergeBreakpoints(List<int> lines,
            List<DbgBreakpoint> conds) {
        List<DbgBreakpoint> outp = new List<DbgBreakpoint>();
        for (int i = 0; i < lines.Count; i = i + 1) {
            outp.Add(DbgBreakpoint.Create(lines[i], ZanIDE.CondFor(conds, lines[i])));
        }
        return outp;
    }

    /// The condition expression stored for 0-based `line` ("" when none).
    static string CondFor(List<DbgBreakpoint> bps, int line) {
        for (int i = 0; i < bps.Count; i = i + 1) {
            if (bps[i].line == line) { return bps[i].cond; }
        }
        return "";
    }

    /// Sets, replaces or clears (empty expr) the condition for 0-based `line`.
    static void SetCond(List<DbgBreakpoint> bps, int line, string expr) {
        for (int i = 0; i < bps.Count; i = i + 1) {
            if (bps[i].line == line) {
                if (expr.Length == 0) { bps.RemoveAt(i); }
                else { bps[i].cond = expr; }
                return;
            }
        }
        if (expr.Length > 0) { bps.Add(DbgBreakpoint.Create(line, expr)); }
    }

    /// Evaluates every watch expression in the paused frame; returns DbgVar
    /// rows (name = expression, value = evaluation result).
    static List<DbgVar> DbgEvalWatches(DebugSession dbg, List<string> watches) {
        List<DbgVar> rows = new List<DbgVar>();
        for (int i = 0; i < watches.Count; i = i + 1) {
            string v = "";
            if (dbg != null) { v = dbg.Evaluate(watches[i]); }
            rows.Add(DbgVar.Create(watches[i], "", v));
        }
        return rows;
    }
}
