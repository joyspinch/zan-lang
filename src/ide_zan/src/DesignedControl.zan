using System;
using System.Collections.Generic;
using System.IO;
using Gui;
using Gui.Markup;

// role:control 设计稿的运行期宿主基类（B-ID44）：把 HTML 设计稿投影成
// 本控件的子树——Html.Parse 单跳建树后字段按方言几何直挂宿主（不经
// body 包装，宿主自己就是设计根）。命名控件用 accessor 属性寻址
// （this.Tree 这类成员由设计半件提供，落到 Ctl）；事件由宿主
// ChildWindow 的 Handle/Wire 通道接线。设计稿经 --embed 烘进 exe
// （File.ReadAllText 内嵌优先，压缩加密存放），开发期读散盘同一行代码。
public class DesignedControl : Control {
    static int designScopeId;
    string designScope;
    string scopedDesignCss;
    string installedAppCss;
    weak App styledApp;

    // 投影设计稿进本控件。kindName 是设计稿类名：既是控件 Kind
    // （设计器/样式表按它认），也是文档里引用本控件时的 kind。
    protected void Design(string kindName, string docPath) {
        this.InitControl(kindName);
        HtmlDoc doc = Html.Parse(File.ReadAllText(docPath), "", null);
        if (doc.root == null) { return; }
        this.AddClass(doc.root.Class);
        // 自动布局（layoutMode=0）按生成器口径挂 designroot：内边距/
        // 行距取自样式表，统一间距只有一处定义；自由画布不挂。
        if (doc.root.CssAttr("data-layout-mode") != "1") { this.AddClass("designroot"); }
        Html.ProjectBody(this, doc);
        DesignedControl.designScopeId = DesignedControl.designScopeId + 1;
        designScope = "zs-design-" + Convert.ToString(DesignedControl.designScopeId);
        string genPrefix = "zgd-" + Convert.ToString(DesignedControl.designScopeId) + "-";
        DesignedControl.RebaseGenClasses(this, genPrefix);
        string rawCss = doc.css == "" ? "" : doc.css.Replace(".zgen-", "." + genPrefix);
        scopedDesignCss = rawCss == "" ? "" : HtmlScope.Styles(rawCss, designScope);
    }

    static void RebaseGenClasses(Control node, string genPrefix) {
        if (node == null) { return; }
        if (node.Class != "" && node.Class.IndexOf("zgen-") >= 0) {
            List<string> parts = Style.Classes(node.Class);
            string rebuilt = "";
            for (int i = 0; i < parts.Count; i = i + 1) {
                string p = parts[i];
                if (p.Length > 5 && p.IndexOf("zgen-") == 0) {
                    p = genPrefix + p.Substring(5);
                }
                rebuilt = rebuilt == "" ? p : rebuilt + " " + p;
            }
            node.Class = rebuilt;
        }
        for (int i = 0; i < node.ChildCount(); i = i + 1) {
            Control ch = node.ChildAt(i);
            if (!(ch is DesignedControl)) {
                DesignedControl.RebaseGenClasses(ch, genPrefix);
            }
        }
    }

    public override bool OwnsInnerScope() { return true; }
    public override string OwnScopeClass() { return designScope != null ? designScope : ""; }

    // Use the normal measurement preparation hook, including when a view moves
    // between the dock and a child App. Rendering only consumes the prepared tree.
    public override void SyncBinding() {
        base.SyncBinding();
        App host = this.App;
        if (host == null || scopedDesignCss == null || scopedDesignCss == "") { return; }
        string css = host.AppCss();
        if (styledApp == host && installedAppCss == css) { return; }
        if (css.IndexOf(scopedDesignCss) < 0) { host.ApplyScopedTree(this, scopedDesignCss, designScope); }
        styledApp = host;
        installedAppCss = host.AppCss();
    }

    // 设计稿 kind：InitControl 落在本控件 name 上，Kind 直接回读。
    public override string Kind() { return this.name; }

    protected override List<PropSpec> DefineProps() {
        List<PropSpec> ps = new List<PropSpec>();
        ps.Add(this.SizeProp());
        return ps;
    }

    static Control FindInDesign(Control node, string name) {
        if (node.name == name) { return node; }
        if (node is DesignedControl) { return null; }
        for (int i = 0; i < node.ChildCount(); i = i + 1) {
            Control hit = DesignedControl.FindInDesign(node.ChildAt(i), name);
            if (hit != null) { return hit; }
        }
        return null;
    }

    // 命名控件解析：找不着当场抛——设计稿改名而半件没跟上时不静默。
    protected Control Ctl(string name) {
        // The host can receive the same id as an inner control when embedded,
        // and embedded DesignedControls own their own child id namespace.
        for (int i = 0; i < this.ChildCount(); i = i + 1) {
            Control c = DesignedControl.FindInDesign(this.ChildAt(i), name);
            if (c != null) { return c; }
        }
        throw new Exception("designed control missing: " + name);
    }
}
