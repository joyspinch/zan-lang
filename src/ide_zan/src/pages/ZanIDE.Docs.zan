using System;
using System.Threading;
using Gui;
using Gui.Backend;
using Gui.Component;
using Gui.Component.CodeEditor;

class DocBaselineEntry {
    string path;
    string text;
    long stamp;
    int version;

    static DocBaselineEntry Create(string path, string text, long stamp, int version) {
        DocBaselineEntry entry = new DocBaselineEntry();
        entry.path = path;
        entry.text = text;
        entry.stamp = stamp;
        entry.version = version;
        return entry;
    }
}

// 接口数据协议与执行契约。
class DocBaseline {
    Dictionary<string, DocBaselineEntry> entries;
    int revision;

    static DocBaseline Create() {
        DocBaseline docs = new DocBaseline();
        docs.entries = new Dictionary<string, DocBaselineEntry>();
        return docs;
    }

    static bool IsFileTab(string path) {
        return path != "" && !path.StartsWith("@")
            && !ZanIDE.IsScenePath(path);
    }

    // 接口数据协议与执行契约。
    static bool SameText(string left, string right) {
        if (left == right) { return true; }
        int a = 0;
        int b = 0;
        while (a < left.Length || b < right.Length) {
            while (a < left.Length && left[a] == '\r') { a = a + 1; }
            while (b < right.Length && right[b] == '\r') { b = b + 1; }
            if (a == left.Length || b == right.Length) {
                return a == left.Length && b == right.Length;
            }
            if (left[a] != right[b]) { return false; }
            a = a + 1;
            b = b + 1;
        }
        return true;
    }

    DocBaselineEntry Entry(string path) {
        DocBaselineEntry entry = null;
        entries.TryGetValue(path, out entry);
        return entry;
    }

    bool Tracked(string path) { return entries.ContainsKey(path); }

    void Note(string path, string text, long stamp) {
        if (!DocBaseline.IsFileTab(path)) { return; }
        revision = revision + 1;
        entries[path] = DocBaselineEntry.Create(path, text, stamp, revision);
    }

    void Track(string path, string text, long stamp) {
        if (!this.Tracked(path)) { this.Note(path, text, stamp); }
    }

    void Forget(string path) { entries.Remove(path); }

    string TextOf(string path) {
        DocBaselineEntry entry = this.Entry(path);
        return entry == null ? "" : entry.text;
    }

    long StampOf(string path) {
        DocBaselineEntry entry = this.Entry(path);
        return entry == null ? 0 : entry.stamp;
    }

    int VersionOf(string path) {
        DocBaselineEntry entry = this.Entry(path);
        return entry == null ? 0 : entry.version;
    }

    bool IsDirty(string path, string text) {
        if (!DocBaseline.IsFileTab(path)) { return false; }
        DocBaselineEntry entry = this.Entry(path);
        // 接口数据协议与执行契约。
        return entry == null || !DocBaseline.SameText(entry.text, text);
    }

    bool ChangedOutside(string path, long stamp) {
        DocBaselineEntry entry = this.Entry(path);
        // 接口数据协议与执行契约。
        return entry == null || (stamp != 0 && stamp != entry.stamp);
    }

    void AcceptStamp(string path, long stamp) {
        DocBaselineEntry entry = this.Entry(path);
        if (entry == null || stamp == 0) { return; }
        this.Note(path, entry.text, stamp);
    }
}

partial class ZanIDE {
    IdeDocumentWatch documentWatch;
    List<IdeDocumentWatch> retiredDocumentWatches = new List<IdeDocumentWatch>();
    List<IdeDocumentSlot> documentSlots = new List<IdeDocumentSlot>();
    Dictionary<int, IdeDocumentSave> documentSaves = new Dictionary<int, IdeDocumentSave>();
    // 接口数据协议与执行契约。
    List<IdeDocumentSave> pendingDocumentSaves = new List<IdeDocumentSave>();
    List<IdeDocumentSave> pendingSaveContinuations = new List<IdeDocumentSave>();
    List<IdeDocumentDiskResult> pendingDocumentResults = new List<IdeDocumentDiskResult>();
    int documentWatchEpoch;
    int documentSlotSequence;
    int documentSaveSequence;
    int documentWritePauseDepth;
    IdeDocumentSlot closeDocumentSlot;
    int closeDocumentEpoch;
    IdeDocumentDiskResult reloadDocumentResult;

    static int DiskPollMs() { return 1000; }

    void InitDocState() {
        docs = DocBaseline.Create();
        closeAsk = null;
        closeAskTab = -1;
        closeOthersKeepPath = "";
        reloadAsk = null;
        reloadAskTab = -1;
        diskPollMs = 0;
    }

    string TabText(int i) {
        if (i < 0 || i >= tabs.Count) { return ""; }
        TabRecord tab = tabs[i];
        if (i == activeTab.Get() && !tab.designDoc && DocBaseline.IsFileTab(tab.path)
            && editor.documentPath == tab.path) { return editor.GetText(); }
        return tab.body;
    }

    bool TabDirty(int i) {
        if (i < 0 || i >= tabs.Count || tabs[i].designDoc) { return false; }
        return docs.IsDirty(tabs[i].path, this.TabText(i));
    }

    // 接口数据协议与执行契约。
    void TrackPreparedDocument(string path, string text, long stamp) {
        int i = ZanIDE.FindTabByPath(tabs, path);
        if (i >= 0 && tabs[i].designDoc) { return; }
        docs.Note(path, text, stamp);
    }

    IdeDocumentSlot DocumentSlotAt(int i) {
        if (i < 0 || i >= tabs.Count) { return null; }
        TabRecord tab = tabs[i];
        for (int j = 0; j < documentSlots.Count; j = j + 1) {
            IdeDocumentSlot existing = documentSlots[j];
            if (existing.tab == tab && existing.tabSet == tabs && existing.workspace == documentWorkspace) {
                return existing;
            }
        }
        IdeDocumentSlot slot = new IdeDocumentSlot();
        documentSlotSequence = documentSlotSequence + 1;
        slot.id = documentSlotSequence;
        slot.tab = tab;
        slot.tabSet = tabs;
        slot.workspace = documentWorkspace;
        documentSlots.Add(slot);
        return slot;
    }

    int DocumentSlotIndex(IdeDocumentSlot slot) {
        if (slot == null || slot.tabSet != tabs || slot.workspace != documentWorkspace) { return -1; }
        for (int i = 0; i < tabs.Count; i = i + 1) {
            if (tabs[i] == slot.tab) { return i; }
        }
        return -1;
    }

    IdeDocumentSlot DocumentSlotById(int id) {
        for (int i = 0; i < documentSlots.Count; i = i + 1) {
            if (documentSlots[i].id == id) { return documentSlots[i]; }
        }
        return null;
    }

    IdeDocumentDiskInput CaptureDocumentAt(int i) {
        if (i < 0 || i >= tabs.Count || tabs[i].designDoc
            || !DocBaseline.IsFileTab(tabs[i].path)) { return null; }
        IdeDocumentSlot slot = this.DocumentSlotAt(i);
        if (slot == null) { return null; }
        string text = this.TabText(i);
        bool bound = i == activeTab.Get() && editor.documentPath == tabs[i].path;
        int version = bound ? editor.TextStamp() : 0;
        if (slot.path != tabs[i].path || slot.body != text || slot.storedBody != tabs[i].body) {
            slot.bodyVersion = slot.bodyVersion + 1;
            slot.path = tabs[i].path;
            slot.body = text;
            slot.storedBody = tabs[i].body;
        }
        slot.bound = bound;
        slot.editorVersion = version;
        IdeDocumentDiskInput input = new IdeDocumentDiskInput();
        input.workspace = documentWorkspace;
        input.epoch = documentWatchEpoch;
        input.slot = slot.id;
        input.path = slot.path;
        input.body = text;
        input.bodyVersion = slot.bodyVersion;
        input.editorBound = bound;
        input.editorVersion = version;
        input.tracked = docs.Tracked(input.path);
        input.baseline = docs.TextOf(input.path);
        input.stamp = docs.StampOf(input.path);
        input.baselineVersion = docs.VersionOf(input.path);
        return input;
    }

    bool EnsureDocumentWatch() {
        if (shuttingDown || app == null) { return false; }
        if (documentWatch != null) { return true; }
        IdeDocumentWatch watch = new IdeDocumentWatch();
        documentWatch = watch;
        if (watch.Start(app, this.ApplyDocumentDiskResult)) { return true; }
        documentWatch = null;
        retiredDocumentWatches.Add(watch);
        log.Add(ZanIDE.T("> Document worker could not start.", "> 文档后台任务无法启动。"));
        return false;
    }

    void PublishDocumentWatch() {
        if (shuttingDown || !this.EnsureDocumentWatch()) { return; }
        IdeDocumentWatchSnapshot snapshot = new IdeDocumentWatchSnapshot();
        snapshot.workspace = documentWorkspace;
        snapshot.epoch = documentWatchEpoch;
        snapshot.leased = this.CodeNavigationBusy() || documentWritePauseDepth > 0;
        for (int i = 0; i < tabs.Count; i = i + 1) {
            IdeDocumentDiskInput input = this.CaptureDocumentAt(i);
            if (input != null) { snapshot.files.Add(input); }
        }
        for (int i = documentSlots.Count - 1; i >= 0; i = i - 1) {
            if (this.DocumentSlotIndex(documentSlots[i]) < 0) { documentSlots.RemoveAt(i); }
        }
        documentWatch.Submit(snapshot);
    }

    // 接口数据协议与执行契约。
    void PumpDocumentWatch() {
        if (shuttingDown) { return; }
        this.ProcessDocumentDialogs();
        this.FlushPendingDocumentWork();
        this.PublishDocumentWatch();
    }

    // 接口数据协议与执行契约。
    void TrackOpenTabs() { this.PublishDocumentWatch(); }
    void PollDiskChanges() { this.PublishDocumentWatch(); }

    bool DocumentWritesPaused() { return documentWritePauseDepth > 0; }

    // 接口数据协议与执行契约。
    bool DocumentResultCurrent(IdeDocumentDiskInput input, bool body, bool baseline) {
        if (input == null || shuttingDown || input.workspace != documentWorkspace
            || input.epoch != documentWatchEpoch) { return false; }
        IdeDocumentSlot slot = this.DocumentSlotById(input.slot);
        if (slot == null) { return false; }
        int i = this.DocumentSlotIndex(slot);
        if (i < 0 || slot.tab.path != input.path || slot.tab.designDoc) { return false; }
        if (baseline && docs.VersionOf(input.path) != input.baselineVersion) { return false; }
        if (!body) { return true; }
        IdeDocumentDiskInput current = this.CaptureDocumentAt(i);
        return current != null && current.bodyVersion == input.bodyVersion
            && current.body == input.body && current.editorBound == input.editorBound
            && current.editorVersion == input.editorVersion;
    }

    void QueueDocumentSave(IdeDocumentSave save, IdeDocumentDiskInput input) {
        documentSaveSequence = documentSaveSequence + 1;
        save.write.sequence = documentSaveSequence;
        save.write.input = input;
        if (documentWatch != null && documentWatch.Enqueue(save.write)) {
            documentSaves[save.write.sequence] = save;
            return;
        }
        // 接口数据协议与执行契约。
        pendingDocumentSaves.Add(save);
    }

    void SaveTabAtThen(int i, Action continuation) {
        if (shuttingDown || i < 0 || i >= tabs.Count || tabs[i].designDoc
            || !DocBaseline.IsFileTab(tabs[i].path)) { return; }
        string text = this.TabText(i);
        tabs[i].body = text;
        IdeDocumentSave save = new IdeDocumentSave();
        save.write = IdeDocumentWrite.Create(tabs[i].path, text);
        save.continuation = continuation;
        this.PublishDocumentWatch();
        IdeDocumentDiskInput input = this.CaptureDocumentAt(i);
        if (input == null || input.path != save.write.path) {
            log.Add(ZanIDE.T("> Could not save ", "> 无法保存 ") + save.write.path + ".");
            app.RequestRedraw();
            return;
        }
        this.QueueDocumentSave(save, input);
    }

    void SaveTabAt(int i) { this.SaveTabAtThen(i, null); }
    void SaveActiveTab() { this.SaveActiveTabThen(null); }

    // 接口数据协议与执行契约。
    void SaveActiveTabThen(Action continuation) {
        if (shuttingDown) { return; }
        int a = activeTab.Get();
        if (a < 0 || a >= tabs.Count) { return; }
        IdeDocumentWrite write = ZanIDE.SaveActive(editor, tabs, activeTab, root, log);
        if (write == null) {
            // 接口数据协议与执行契约。
            if (continuation != null) { app.Post(continuation); }
            return;
        }
        IdeDocumentSave save = new IdeDocumentSave();
        save.write = write;
        save.continuation = continuation;
        this.PublishDocumentWatch();
        IdeDocumentDiskInput input = this.CaptureDocumentAt(a);
        if (input == null || input.path != write.path) {
            log.Add(ZanIDE.T("> Could not save ", "> 无法保存 ") + write.path + ".");
            app.RequestRedraw();
            return;
        }
        this.QueueDocumentSave(save, input);
    }

    void FlushPendingDocumentWork() {
        if (shuttingDown || this.CodeNavigationBusy() || documentWritePauseDepth > 0) { return; }
        if (pendingSaveContinuations.Count > 0) {
            List<IdeDocumentSave> conts = pendingSaveContinuations;
            pendingSaveContinuations = new List<IdeDocumentSave>();
            for (int i = 0; i < conts.Count; i = i + 1) {
                if (this.DocumentResultCurrent(conts[i].write.input, true, false)) { conts[i].continuation(); }
            }
        }
        if (pendingDocumentSaves.Count > 0) {
            List<IdeDocumentSave> saves = pendingDocumentSaves;
            pendingDocumentSaves = new List<IdeDocumentSave>();
            for (int i = 0; i < saves.Count; i = i + 1) {
                IdeDocumentSave save = saves[i];
                if (documentSaves.ContainsKey(save.write.sequence)) { continue; }
                int index = ZanIDE.FindTabByPath(tabs, save.write.path);
                IdeDocumentDiskInput input = this.CaptureDocumentAt(index);
                if (input == null || input.path != save.write.path) { continue; }
                this.QueueDocumentSave(save, input);
            }
        }
        if (pendingDocumentResults.Count > 0) {
            List<IdeDocumentDiskResult> results = pendingDocumentResults;
            pendingDocumentResults = new List<IdeDocumentDiskResult>();
            for (int i = 0; i < results.Count; i = i + 1) { this.ApplyDocumentDiskResult(results[i]); }
        }
    }

    void CompleteDocumentSave(IdeDocumentDiskResult result) {
        IdeDocumentSave save = null;
        if (result.write == null || !documentSaves.TryGetValue(result.write.sequence, out save)) { return; }
        documentSaves.Remove(result.write.sequence);
        // 接口数据协议与执行契约。
        if (!this.DocumentResultCurrent(result.input, false, false)) { return; }
        if (result.failure != "" || result.canceled) {
            string message = result.canceled
                ? ZanIDE.T("deferred by a document transaction", "被文档事务推迟")
                : result.failure;
            log.Add(ZanIDE.T("> Could not save ", "> 无法保存 ") + result.write.path + ": " + message);
            // 接口数据协议与执行契约。
            closeOthersKeepPath = "";
            closeDocumentSlot = null;
            app.RequestRedraw();
            return;
        }
        IdeDocumentSlot slot = this.DocumentSlotById(result.input.slot);
        if (slot == null) { return; }
        if (result.write.sequence <= slot.saveApplied) { return; }
        slot.saveApplied = result.write.sequence;
        // 接口数据协议与执行契约。
        docs.Note(result.write.path, result.text, result.stamp);
        log.Add("> Saved " + result.write.path + ".");
        this.RefreshSymbolIndex(false);
        bool sameBody = this.DocumentResultCurrent(result.input, true, false);
        bool busy = this.CodeNavigationBusy() || documentWritePauseDepth > 0;
        if (save.continuation != null) {
            if (!sameBody) {
                // 接口数据协议与执行契约。
                closeOthersKeepPath = "";
                closeDocumentSlot = null;
            } else if (busy) {
                pendingSaveContinuations.Add(save);
            } else {
                save.continuation();
            }
        }
        this.PublishDocumentWatch();
        app.RequestRedraw();
    }

    void ApplyDocumentDiskResult(IdeDocumentDiskResult result) {
        if (result == null) { return; }
        if (result.write != null) { this.CompleteDocumentSave(result); return; }
        if (result.input == null || shuttingDown || result.input.workspace != documentWorkspace
            || result.input.epoch != documentWatchEpoch) { return; }
        if (result.failure != "") { return; }
        // 接口数据协议与执行契约。
        if (documentWritePauseDepth > 0 || this.CodeNavigationBusy()
            || (closeAsk != null && closeAsk.open) || (reloadAsk != null && reloadAsk.open)) {
            for (int i = 0; i < pendingDocumentResults.Count; i = i + 1) {
                if (pendingDocumentResults[i].input.path == result.input.path) { return; }
            }
            pendingDocumentResults.Add(result);
            return;
        }
        if (!this.DocumentResultCurrent(result.input, true, true)) { return; }
        if (!result.input.tracked || DocBaseline.SameText(result.text, result.input.body)) {
            docs.Note(result.input.path, result.text, result.stamp);
            this.PublishDocumentWatch();
            return;
        }
        if (DocBaseline.SameText(result.text, result.input.baseline)) {
            docs.AcceptStamp(result.input.path, result.stamp);
            this.PublishDocumentWatch();
            return;
        }
        IdeDocumentSlot slot = this.DocumentSlotById(result.input.slot);
        int i = this.DocumentSlotIndex(slot);
        if (!this.TabDirty(i)) {
            this.AdoptDiskText(result);
            return;
        }
        reloadDocumentResult = result;
        reloadAskTab = i;
        reloadAsk = LayerState.Choose(
            ZanIDE.T("Changed on disk", "文件已被外部修改"),
            tabs[i].name + ZanIDE.T(" changed outside the IDE. Reload and lose your unsaved edits?",
                " 已在 IDE 外被修改。要重新加载并丢弃未保存的修改吗？"),
            2, ZanIDE.T("Reload", "重新加载"), "", ZanIDE.T("Keep my edits", "保留我的修改"));
        reloadAsk.Open();
        app.RequestRedraw();
    }

    void AdoptDiskText(IdeDocumentDiskResult result) {
        if (documentWritePauseDepth > 0 || this.CodeNavigationBusy()
            || !this.DocumentResultCurrent(result.input, true, true)
            || result.prepared == null || result.prepared.applied) { return; }
        IdeDocumentSlot slot = this.DocumentSlotById(result.input.slot);
        if (slot == null) { return; }
        int i = this.DocumentSlotIndex(slot);
        if (i == activeTab.Get() && editor.documentPath == slot.path) {
            CodeEditorTextLoad request = editor.BeginTextLoad(slot.path, CodeEditor.LangForName(slot.path));
            if (!editor.ApplyPreparedText(request, result.prepared)) { return; }
            editor.GoToLineCol(slot.tab.caretLine, slot.tab.caretCol);
            editor.SetScrollLine(slot.tab.scrollLine);
            bindingCodeTab = slot.tab;
            lastActive = i;
        } else if (i == activeTab.Get()) {
            // 接口数据协议与执行契约。
            bindingCodeTab = null;
            lastActive = -1;
        }
        slot.tab.body = result.prepared.text;
        slot.tab.preparedBody = slot.tab.body;
        slot.tab.preparedText = result.prepared;
        docs.Note(slot.path, result.text, result.stamp);
        log.Add("> Reloaded " + slot.path + " (changed on disk).");
        Layer.Msg(ZanIDE.T("Reloaded ", "已重新加载：") + slot.tab.name, 0);
        this.RefreshSymbolIndex(false);
        this.PublishDocumentWatch();
        app.RequestRedraw();
    }

    void CloseTabNow(int i) { this.CloseTabNowThen(i, null); }

    // 接口数据协议与执行契约。
    void CloseTabNowThen(int i, Action continuation) {
        if (i < 0 || i >= tabs.Count || shuttingDown) { return; }
        IdeDocumentSlot slot = this.DocumentSlotAt(i);
        if (slot == null) { return; }
        int epoch = documentWatchEpoch;
        string path = slot.tab.path;
        string body = this.TabText(i);
        this.CancelCodeNavigationThen(delegate () {
            if (shuttingDown || epoch != documentWatchEpoch || this.DocumentSlotIndex(slot) < 0
                || slot.tab.path != path) { return; }
            this.PauseDocumentWritesThen(delegate () {
                int target = this.DocumentSlotIndex(slot);
                if (shuttingDown || epoch != documentWatchEpoch || target < 0 || slot.tab.path != path) {
                    this.ResumeDocumentWrites();
                    return;
                }
                if (this.TabText(target) != body) {
                    this.ResumeDocumentWrites();
                    this.RequestCloseTab(target);
                    return;
                }
                docs.Forget(path);
                ZanIDE.CloseTabAt(tabs, activeTab, target);
                bindingCodeTab = null;
                lastActive = -1;
                this.ResumeDocumentWrites();
                this.PublishDocumentWatch();
                app.RequestRedraw();
                if (continuation != null) { continuation(); }
            });
        });
    }

    void RequestCloseTab(int i) {
        if (i < 0 || i >= tabs.Count || shuttingDown) { return; }
        if (this.CodeNavigationBusy()) {
            IdeDocumentSlot slot = this.DocumentSlotAt(i);
            int epoch = documentWatchEpoch;
            this.CancelCodeNavigationThen(delegate () {
                if (!shuttingDown && epoch == documentWatchEpoch) { this.RequestCloseTab(this.DocumentSlotIndex(slot)); }
            });
            return;
        }
        if (!this.TabDirty(i)) { this.CloseTabNow(i); return; }
        closeAskTab = i;
        closeDocumentSlot = this.DocumentSlotAt(i);
        closeDocumentEpoch = documentWatchEpoch;
        closeAsk = LayerState.Choose(
            ZanIDE.T("Unsaved changes", "尚未保存"),
            ZanIDE.T("Save the changes to ", "是否保存对 ") + tabs[i].name
                + ZanIDE.T(" before closing?", " 的修改？"),
            2, ZanIDE.T("Save", "保存"), ZanIDE.T("Don't save", "不保存"), ZanIDE.T("Cancel", "取消"));
        closeAsk.Open();
        app.RequestRedraw();
    }

    void RequestCloseOthers(string keepPath) {
        if (shuttingDown) { return; }
        if (this.CodeNavigationBusy()) {
            int epoch = documentWatchEpoch;
            this.CancelCodeNavigationThen(delegate () {
                if (!shuttingDown && epoch == documentWatchEpoch) { this.RequestCloseOthers(keepPath); }
            });
            return;
        }
        for (int i = 0; i < tabs.Count; i = i + 1) {
            if (tabs[i].path != keepPath) {
                closeOthersKeepPath = keepPath;
                if (this.TabDirty(i)) { this.RequestCloseTab(i); }
                else { this.CloseDocumentThen(this.DocumentSlotAt(i), keepPath); }
                return;
            }
        }
        closeOthersKeepPath = "";
    }

    // 接口数据协议与执行契约。
    // 核心契约与语义定义。
    void CloseDocumentThen(IdeDocumentSlot slot, string keepPath) {
        int target = this.DocumentSlotIndex(slot);
        if (target < 0) { return; }
        this.CloseTabNowThen(target, delegate () {
            if (keepPath != "" && closeOthersKeepPath == keepPath) { this.RequestCloseOthers(keepPath); }
        });
    }

    // 核心契约与语义定义。
    void ProcessDocumentDialogs() {
        if (closeAsk != null && closeAsk.open && closeAsk.action != 0) {
            int action = closeAsk.action;
            closeAsk.action = 0;
            closeAsk.open = false;
            IdeDocumentSlot slot = closeDocumentSlot;
            int target = this.DocumentSlotIndex(slot);
            string keep = closeOthersKeepPath;
            if (target >= 0 && closeDocumentEpoch == documentWatchEpoch) {
                if (action == 1) {
                    this.SaveTabAtThen(target, delegate () { this.CloseDocumentThen(slot, keep); });
                } else if (action == 4) {
                    this.CloseDocumentThen(slot, keep);
                } else { closeOthersKeepPath = ""; }
            } else { closeOthersKeepPath = ""; }
            app.RequestRedraw();
        }
        if (reloadAsk != null && reloadAsk.open && reloadAsk.action != 0) {
            int action = reloadAsk.action;
            reloadAsk.action = 0;
            reloadAsk.open = false;
            IdeDocumentDiskResult result = reloadDocumentResult;
            reloadDocumentResult = null;
            if (result != null && documentWritePauseDepth == 0
                && this.DocumentResultCurrent(result.input, true, true)) {
                if (action == 1) { this.AdoptDiskText(result); }
                else { docs.AcceptStamp(result.input.path, result.stamp); }
            }
            app.RequestRedraw();
        }
    }

    void RenderDocDialogs() {
        if (closeAsk != null && closeAsk.open) { Layer.Render(app, closeAsk); }
        if (reloadAsk != null && reloadAsk.open) { Layer.Render(app, reloadAsk); }
    }

    // 接口数据协议与执行契约。
    void PauseDocumentWritesThen(Action continuation) {
        if (shuttingDown || continuation == null) { return; }
        documentWritePauseDepth = documentWritePauseDepth + 1;
        int epoch = documentWatchEpoch;
        if (documentWatch == null) {
            app.Post(delegate () {
                if (!shuttingDown && epoch == documentWatchEpoch) { continuation(); }
            });
            return;
        }
        TaskCompletionSource<bool> paused = documentWatch.PauseWrites();
        App host = app;
        this.AwaitDocumentPauseAsync(paused, host, continuation, epoch);
    }

    async void AwaitDocumentPauseAsync(TaskCompletionSource<bool> paused, App host,
                                       Action continuation, int epoch) {
        await paused.Task;
        host.Post(delegate () {
            if (!shuttingDown && epoch == documentWatchEpoch) { continuation(); }
        });
    }

    void ResumeDocumentWrites() {
        if (documentWritePauseDepth > 0) { documentWritePauseDepth = documentWritePauseDepth - 1; }
        if (documentWritePauseDepth == 0 && documentWatch != null) {
            documentWatch.ResumeWrites();
            this.PublishDocumentWatch();
        }
    }

    void CancelDocumentWatch() {
        documentWatchEpoch = documentWatchEpoch + 1;
        IdeDocumentWatch watch = documentWatch;
        documentWatch = null;
        if (watch != null) { watch.Cancel(); retiredDocumentWatches.Add(watch); }
        documentSlots = new List<IdeDocumentSlot>();
        documentSaves.Clear();
        pendingDocumentSaves = new List<IdeDocumentSave>();
        pendingSaveContinuations = new List<IdeDocumentSave>();
        pendingDocumentResults = new List<IdeDocumentDiskResult>();
        documentWritePauseDepth = 0;
        docs = DocBaseline.Create();
        closeAsk = null;
        reloadAsk = null;
        closeDocumentSlot = null;
        reloadDocumentResult = null;
        closeOthersKeepPath = "";
    }

    // 接口数据协议与执行契约。
    async void DrainDocumentWatchAsync() {
        this.CancelDocumentWatch();
        List<IdeDocumentWatch> retired = retiredDocumentWatches;
        retiredDocumentWatches = new List<IdeDocumentWatch>();
        for (int i = 0; i < retired.Count; i = i + 1) { await retired[i].DrainAsync(); }
    }
}
