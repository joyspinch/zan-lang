using System;
using System.Collections.Generic;
using Gui;
using Gui.Widget;

partial class ComponentGallery {
    // 已经搭好的是哪一个组件（空串表示还没搭过），只有换主题时才重建
    // 控件树。
    string shown;
    bool built;

    // 预览卡的逻辑高度（DocsPreviewHost 用，未缩放）。多行演示的组件
    // 给足高度——详栏是 ScrollColumn，装不下会滚动，但卡内不裁。
    static int PreviewH(string name) {
        if (name == "Slider") { return 660; }
        // Switch 增强演示四段（尺寸/形状内容/加载颜色/值轴），按行高
        // 累加给足，卡内不裁。
        if (name == "Switch") { return 330; }
        // Radio Group 增强演示：基础两枚 + 选项值组 + 按钮组 + 跟值
        // 标签，按行高累加给足，卡内不裁。
        if (name == "Radio Group") { return 230; }
        // Text Input 演示有六段（基本/尺寸/前后缀族/计数过滤/TextArea/
        // 手动操作），按行高累加给足，卡内不裁。
        if (name == "Text Input") { return 340; }
        // Pagination 演示两行（基础 + 全段组合：total/jumper/sizes/
        // 前后缀）。
        if (name == "Pagination") { return 250; }
        return 142;
    }

    void OnInit() {
        this.Frame.SetProp("title",
            ZanIDE.T("LIVE STATES", "实时状态"));
        shown = "";
        built = false;
    }

    // 声明一个控件希望占的逻辑尺寸（0 表示由控件自己测量）。逻辑像素
    // 在测量时按当前缩放解析，所以 150% 下演示不会挤在一起。
    static Control Sized(Control c, int w, int h) {
        if (w > 0) { c.logW = w; }
        if (h > 0) { c.logH = h; }
        return c;
    }

    // 按主题搭出这一格的控件树。只有主题变了才重建：保留实例带着
    // 用户的编辑状态，重建会把它们连状态一起丢掉。
    void Show(string name, Input demoInput) {
        if (built && name == shown) { return; }
        built = true;
        shown = name;
        ComponentGallery.EnsurePreviews();
        Panel row1 = this.Row1;
        Panel row2 = this.Row2;
        Panel stage = this.Stage;
        row1.RemoveAll();
        row2.RemoveAll();
        stage.RemoveAll();
        if (name == "Button") {
            row1.Add(ComponentGallery.Sized(
                new Button { Text = "Default" }, 104, 0));
            row1.Add(ComponentGallery.Sized(
                new Button { Text = "Primary", Class = "primary" }, 104, 0));
            row1.Add(ComponentGallery.Sized(
                new Button { Text = "Disabled", Disabled = true }, 104, 0));
        } else if (name == "Label") {
            Label title = new Label("Title");
            title.Class = "title";
            row1.Add(title);
            row2.Add(new Label("Default label"));
            Label second = new Label("Secondary");
            second.Class = "secondary";
            row2.Add(second);
        } else if (name == "Text Input") {
            // 前两行是基本形态与尺寸档；stage 逐组演示 Naive UI 文档
            // 的能力面（前后缀 / 密码 / 清除 / 加载 / 圆角 / 校验态 /
            // 字数 + 过滤），最后一段 TextArea 与手动操作按钮。
            row1.Add(ComponentGallery.Sized(demoInput, 240, 0));
            row1.Add(ComponentGallery.Sized(
                ComponentGallery.demoInputDisabled, 140, 0));
            row2.Add(ComponentGallery.Sized(
                ComponentGallery.demoInputTiny, 80, 0));
            row2.Add(ComponentGallery.Sized(
                ComponentGallery.demoInputLarge, 140, 0));
            stage.Add(new Label {
                Text = ZanIDE.T("Prefix -- password -- clearable -- loading",
                                "前缀 -- 密码 -- 可清除 -- 加载"),
                Class = "secondary" });
            Panel inRow1 = Panel.Row().Gap(12);
            inRow1.Add(ComponentGallery.Sized(
                ComponentGallery.demoInputPfx, 180, 0));
            inRow1.Add(ComponentGallery.Sized(
                ComponentGallery.demoInputPw, 120, 0));
            inRow1.Add(ComponentGallery.Sized(
                ComponentGallery.demoInputClr, 120, 0));
            stage.Add(inRow1);
            Panel inRow2 = Panel.Row().Gap(12);
            inRow2.Add(ComponentGallery.Sized(
                ComponentGallery.demoInputLoad, 130, 0));
            inRow2.Add(ComponentGallery.Sized(
                ComponentGallery.demoInputRound, 110, 0));
            inRow2.Add(ComponentGallery.Sized(
                ComponentGallery.demoInputErr, 130, 0));
            stage.Add(inRow2);
            stage.Add(new Label {
                Text = ZanIDE.T("Show count -- digits-only filter",
                                "字数统计 -- 只许数字（过滤）"),
                Class = "secondary" });
            Panel inRow3 = Panel.Row().Gap(12);
            inRow3.Add(ComponentGallery.Sized(
                ComponentGallery.demoInputCount, 190, 0));
            inRow3.Add(ComponentGallery.Sized(
                ComponentGallery.demoInputDigits, 190, 0));
            stage.Add(inRow3);
            stage.Add(new Label {
                Text = ZanIDE.T("TextArea -- manual ops (act on the top field)",
                                "多行文本框 -- 手动操作（作用于第一行）"),
                Class = "secondary" });
            Panel inRow4 = Panel.Row().Gap(12);
            inRow4.Add(ComponentGallery.Sized(
                ComponentGallery.demoArea, 190, 70));
            inRow4.Add(ComponentGallery.Sized(
                ComponentGallery.demoAreaCount, 190, 70));
            stage.Add(inRow4);
            Panel opsRow = Panel.Row().Gap(8);
            Button bClr = new Button {
                Text = ZanIDE.T("Clear", "清空"), Class = "secondary" };
            bClr.Click += () => { demoInput.Clear(); };
            Button bFoc = new Button {
                Text = ZanIDE.T("Focus", "聚焦"), Class = "secondary" };
            bFoc.Click += () => { demoInput.Focus(); };
            Button bBlur = new Button {
                Text = ZanIDE.T("Blur", "失焦"), Class = "secondary" };
            bBlur.Click += () => { demoInput.Blur(); };
            opsRow.Add(bClr);
            opsRow.Add(bFoc);
            opsRow.Add(bBlur);
            stage.Add(opsRow);
        } else if (name == "Checkbox") {
            row1.Add(ComponentGallery.demoCheck);
        } else if (name == "Radio Group") {
            row1.Add(ComponentGallery.Sized(ComponentGallery.demoRadioA, 130, 0));
            row1.Add(ComponentGallery.Sized(ComponentGallery.demoRadioB, 130, 0));
            // 增强：选项值组（value≠下标，禁用项点不动）+ 按钮形态。
            stage.Add(ComponentGallery.demoRgOpt);
            stage.Add(ComponentGallery.demoRgBtn);
            stage.Add(ComponentGallery.demoRgLbl);
        } else if (name == "Switch") {
            // 第一行保留旧写法（中档 + 实时说明），stage 里分行看全增强：
            // 尺寸四档 / 方形 / 内嵌文字 / 图标 / 加载 / 自定义色 / int 值轴。
            row1.Add(ComponentGallery.demoSwitch);
            row1.Add(new Label(ZanIDE.T("Interactive state", "可交互状态")));
            stage.Add(new Label {
                Text = ZanIDE.T("Sizes: tiny / small / medium / large",
                                "尺寸：tiny / small / medium / large"),
                Class = "secondary" });
            Panel szRow = Panel.Row().Gap(12);
            szRow.Add(ComponentGallery.demoSwTiny);
            szRow.Add(ComponentGallery.demoSwSmall);
            szRow.Add(ComponentGallery.demoSwLarge);
            stage.Add(szRow);
            stage.Add(new Label {
                Text = ZanIDE.T("Square / inner text / icons",
                                "方形 / 内嵌文字 / 图标"),
                Class = "secondary" });
            Panel ctRow = Panel.Row().Gap(12);
            ctRow.Add(ComponentGallery.demoSwSquare);
            ctRow.Add(ComponentGallery.demoSwText);
            ctRow.Add(ComponentGallery.demoSwIcon);
            stage.Add(ctRow);
            stage.Add(new Label {
                Text = ZanIDE.T("Loading (thumb spinner, clicks ignored) / custom colors",
                                "加载中（拇指转圈、点击失聪）/ 自定义颜色"),
                Class = "secondary" });
            Panel ldRow = Panel.Row().Gap(12);
            ldRow.Add(ComponentGallery.demoSwBusy);
            ldRow.Add(ComponentGallery.demoSwColor);
            stage.Add(ldRow);
            stage.Add(new Label {
                Text = ZanIDE.T("Checked value: switch means field == 10",
                                "自定义选中值：开关表达字段 == 10"),
                Class = "secondary" });
            Panel valRow = Panel.Row().Gap(12);
            valRow.Add(ComponentGallery.demoSwValue);
            valRow.Add(ComponentGallery.demoSwValueLbl);
            stage.Add(valRow);
        } else if (name == "Slider") {
            // 第一行：基础滑块 + 实时数值；第二行：范围双柄 + 两端读数。
            row1.Add(ComponentGallery.Sized(ComponentGallery.demoSlider, 300, 0));
            row1.Add(ComponentGallery.valueLbl);
            row2.Add(ComponentGallery.Sized(
                ComponentGallery.demoSliderRange, 300, 0));
            row2.Add(ComponentGallery.sliderRangeLbl);
            // Stage：标记 / 限取标记值（两条共享一个模型字段，
            // 自由与受限一眼可比），下面一行垂直对，再下面气泡三态 +
            // 禁用的 2×2 网格。每行都收在 ~400 逻辑宽内，窄窗格不换行；
            // 预览卡高度由 PreviewH 按组件给足（详栏可滚动）。
            stage.Add(new Label {
                Text = ZanIDE.T("Marks / step on marks (shared value)",
                                "标记 / 限取标记值（共享值）"),
                Class = "secondary" });
            // 水平内边距让首尾刻度文字（0°C / 100°C）出得了轨道边界。
            Panel mkRow = Panel.Row();
            mkRow.Padding(0, 30, 0, 30);
            mkRow.Add(ComponentGallery.Sized(
                ComponentGallery.demoSliderMarks, 300, 0));
            stage.Add(mkRow);
            Panel smkRow = Panel.Row().Gap(10);
            smkRow.Padding(0, 30, 0, 30);
            smkRow.Add(ComponentGallery.Sized(
                ComponentGallery.demoSliderStepMark, 300, 0));
            smkRow.Add(ComponentGallery.sliderMarkLbl);
            stage.Add(smkRow);
            stage.Add(new Label {
                Text = ZanIDE.T(
                    "Vertical + reverse -- tooltip modes -- disabled",
                    "垂直 + 倒转 -- 气泡三态 -- 禁用"),
                Class = "secondary" });
            Panel vtRow = Panel.Row().Gap(16);
            vtRow.Add(ComponentGallery.Sized(
                ComponentGallery.demoSliderVt, 80, 210));
            vtRow.Add(ComponentGallery.Sized(
                ComponentGallery.demoSliderVtRev, 80, 210));
            stage.Add(vtRow);
            // 气泡全高约 63 逻辑像素：两行之间留 64，常显气泡完整落在
            // 行距里，不盖邻排滑块的拇指。
            Panel tipGrid = Panel.Column().Gap(64);
            Panel tipR1 = Panel.Row().Gap(16);
            tipR1.Add(ComponentGallery.Sized(
                ComponentGallery.demoSliderNoTip, 170, 0));
            tipR1.Add(ComponentGallery.Sized(
                ComponentGallery.demoSliderAlways, 170, 0));
            Panel tipR2 = Panel.Row().Gap(16);
            tipR2.Add(ComponentGallery.Sized(
                ComponentGallery.demoSliderFmt, 170, 0));
            tipR2.Add(ComponentGallery.Sized(
                ComponentGallery.demoSliderDisabled, 170, 0));
            tipGrid.Add(tipR1);
            tipGrid.Add(tipR2);
            stage.Add(tipGrid);
        } else if (name == "Select (SelectBox)") {
            row1.Add(ComponentGallery.Sized(ComponentGallery.demoSelect, 220, 0));
        } else if (name == "Tabs") {
            row1.Add(ComponentGallery.Sized(ComponentGallery.demoTabs, 420, 0));
        } else if (name == "Card") {
            Card demo = new Card("Card");
            Label inner = new Label(
                ZanIDE.T("Card content and actions", "卡片内容与操作"));
            inner.dock = 1;
            demo.Add(inner);
            stage.Add(ComponentGallery.Sized(demo, 360, 0));
        } else if (name == "Progress") {
            row1.Add(ComponentGallery.Sized(new Progress(68, 0), 320, 0));
            row2.Add(ComponentGallery.Sized(new Progress(42, 1), 320, 0));
        } else if (name == "Tag") {
            row1.Add(new Tag { Text = "Default" });
            row1.Add(new Tag { Text = "Success", Class = "success" });
            row1.Add(new Tag { Text = "Warning", Class = "warning" });
            row1.Add(new Tag { Text = "Error", Class = "error" });
        } else if (name == "DynamicTags") {
            row1.Add(ComponentGallery.Sized(
                ComponentGallery.demoDynTags, 320, 0));
        } else if (name == "Alert") {
            stage.Add(new GalleryDemoHost("Alert", 44));
        } else if (name == "Tooltip") {
            row1.Add(ComponentGallery.Sized(
                new Button { Text = ZanIDE.T("Hover target", "悬停目标") },
                130, 0));
            row1.Add(ComponentGallery.Sized(
                new GalleryDemoHost("Tooltip", 28), 200, 0));
        } else if (name == "Avatar") {
            row1.Add(new Avatar("Z", 42, ""));
            row1.Add(new Avatar("", 42, "user"));
        } else if (name == "Badge") {
            // 计数为 0 的徽标就是圆点形态（Badge.Label() 为空）。
            row1.Add(new Badge());
            row1.Add(new Badge(12));
        } else if (name == "Divider") {
            stage.Add(new Divider(ZanIDE.T("Section", "区段")));
        } else if (name == "Empty") {
            stage.Add(new Empty(ZanIDE.T("No data", "暂无数据")));
        } else if (name == "ListView") {
            stage.Add(ComponentGallery.Sized(ComponentGallery.demoList, 260, 96));
        } else if (name == "Loading") {
            row1.Add(new Spin(36));
        } else if (name == "Skeleton") {
            Skeleton dot = new Skeleton(40, 40);
            dot.Class = "circle";
            row1.Add(dot);
            row1.Add(new Skeleton(260, 14));
            row2.Add(new Skeleton(180, 14));
        } else if (name == "Statistic") {
            row1.Add(new Statistic(
                ZanIDE.T("Active users", "活跃用户"), "12,480"));
        } else if (name == "Typography") {
            stage.Add(Typography.H("Heading", 2));
            stage.Add(Typography.P(ZanIDE.T(
                "Readable paragraph text for application content.",
                "用于应用内容的易读段落文本。")));
        } else if (name == "Breadcrumb") {
            List<string> crumbs = new List<string>{
                "Home", "Components", "Breadcrumb" };
            row1.Add(Breadcrumb.Of(crumbs));
        } else if (name == "Carousel") {
            List<string> slides = new List<string>{
                "First state", "Second state" };
            stage.Add(Carousel.Of(slides, DocsPreviewHost.DemoInt()));
        } else if (name == "Calendar") {
            Calendar cal = new Calendar();
            DateTime today = DateTime.Now();
            cal.AddMark(today, ZanIDE.T("Standup", "站会"), 1);
            cal.AddMark(today.AddDays(1), ZanIDE.T("Release", "发布"), 3);
            cal.AddMark(today.AddDays(2), ZanIDE.T("Design review", "设计评审"),
                        2);
            stage.Add(ComponentGallery.Sized(cal, 560, 340));
        } else if (name == "Chart") {
            stage.Add(new GalleryDemoHost("Chart", 104));
        } else if (name == "Collapse") {
            List<CollapsePanel> panels = new List<CollapsePanel>{
                new CollapsePanel("General", "General settings"),
                new CollapsePanel("Advanced", "Advanced settings") };
            stage.Add(Collapse.Of(panels, DocsPreviewHost.DemoInt()));
        } else if (name == "DataTable") {
            stage.Add(new GalleryDemoHost("DataTable", 100));
        } else if (name == "Dropdown") {
            // 动作菜单：选中即执行命令，触发器回到提示语（说明/结果
            // 文字在 Sync() 每帧刷新）。
            row1.Add(ComponentGallery.Sized(
                ComponentGallery.demoDropdown, 170, 0));
            row1.Add(ComponentGallery.Sized(
                ComponentGallery.dropdownTipLbl, 330, 0));
        } else if (name == "Ellipsis") {
            row1.Add(ComponentGallery.Sized(
                new GalleryDemoHost("Ellipsis", 22), 280, 0));
        } else if (name == "FloatButton") {
            row1.Add(new FloatButton("plus") { Size = 48, Class = "primary" });
            row1.Add(new FloatButton("edit") { Size = 48 });
        } else if (name == "Menu") {
            stage.Add(ComponentGallery.Sized(
                new GalleryDemoHost("Menu", 78), 220, 0));
        } else if (name == "PageHeader") {
            stage.Add(new PageHeader(
                ZanIDE.T("Component page", "组件页面"),
                ZanIDE.T("Title, subtitle and back action",
                         "标题、副标题与返回操作")));
        } else if (name == "Pagination") {
            row1.Add(Pagination.Of(12, DocsPreviewHost.DemoInt()));
            // 100 页全段组合：总页数 + 跳页输入框 + 每页条数下拉 +
            // 前后缀。省略号点击整窗翻页，输入框回车提交。
            Pagination rich = new Pagination(100);
            rich = Pagination.Of(100, DocsPreviewHost.DemoInt());
            rich.Jumper(true).ShowSizes(true).ShowTotal(true);
            rich.Prefix(ZanIDE.T("Items", "条目"));
            rich.Suffix(ZanIDE.T("end", "完"));
            stage.Add(rich);
        } else if (name == "Panel") {
            Panel box = new Panel("panel")
                .Titled(ZanIDE.T("Panel title", "面板标题"));
            Label inner = new Label(ZanIDE.T("Panel content", "面板内容"));
            inner.dock = 1;
            box.Add(inner);
            stage.Add(box);
        } else if (name == "PivotView") {
            stage.Add(new GalleryDemoHost("PivotView", 280));
        } else if (name == "Popover") {
            stage.Add(new Popover(
                ZanIDE.T("Details", "详情"),
                ZanIDE.T("Popover", "气泡卡片"),
                ZanIDE.T("Anchored explanatory content.", "锚定的说明内容。"),
                280));
        } else if (name == "Rate") {
            row1.Add(ComponentGallery.demoRate);
        } else if (name == "Result") {
            Result res = new Result(
                ZanIDE.T("Operation complete", "操作完成"),
                ZanIDE.T("The requested action succeeded.", "请求的操作已成功。"));
            res.Class = Result.StatusClass(1);
            stage.Add(res);
        } else if (name == "Ribbon") {
            stage.Add(new GalleryDemoHost("Ribbon", 0));
        } else if (name == "Scrollbar") {
            stage.Add(ComponentGallery.Sized(
                new GalleryDemoHost("Scrollbar", 90), 280, 0));
        } else if (name == "Spin") {
            row1.Add(new Spin(36));
            Spin load = new Spin(36);
            load.Tip = ZanIDE.T("Loading data...", "正在加载数据...");
            row1.Add(ComponentGallery.Sized(load, 240, 0));
        } else if (name == "Steps") {
            stage.Add(Steps.Of(new List<string>{ "Details", "Review", "Done" },
                DocsPreviewHost.DemoInt()));
        } else if (name == "Table") {
            stage.Add(new GalleryDemoHost("Table", 60));
        } else if (name == "Timeline") {
            List<TimelineItem> items = new List<TimelineItem>{
                new TimelineItem("", "Created", "Project initialized",
                                 "success", "eye"),
                new TimelineItem("", "Published", "Executable generated") };
            TimelineItem next = new TimelineItem("", "Deploy",
                                                 "Waiting for a target");
            next.pending = true;
            items.Add(next);
            stage.Add(Timeline.Of(items));
        } else if (name == "TreeView") {
            stage.Add(ComponentGallery.Sized(ComponentGallery.demoTree, 280, 96));
        } else {
            // 交互式 / 浮层组件：文档给的是 API 示例，画廊只说明这一点。
            row1.Add(new Avatar("", 30, "code"));
            row1.Add(new Label(ZanIDE.T("Interactive / overlay example",
                                        "交互式 / 浮层示例")));
            row2.Add(new Label(ZanIDE.T("Copy the current API example below.",
                                        "复制下方当前 API 示例。")));
        }
    }

    // 每帧刷新那些跟着模型走的文字（滑块数值），控件树本身不动。
    void Sync() {
        if (ComponentGallery.demoModel == null) { return; }
        if (shown == "Switch") {
            ComponentGallery.demoSwValueLbl.Text =
                ZanIDE.T("value = ", "当前值 = ")
                + Convert.ToString(ComponentGallery.demoModel.swVal);
        }
        if (shown == "Radio Group") {
            ComponentGallery.demoRgLbl.Text =
                ZanIDE.T("value = ", "当前值 = ")
                + Convert.ToString(ComponentGallery.demoModel.rgCity);
        }
        if (shown == "Slider") {
            ComponentGallery.valueLbl.Text =
                Convert.ToString(ComponentGallery.demoModel.level);
            ComponentGallery.sliderRangeLbl.Text =
                Convert.ToString(ComponentGallery.demoModel.sldLo) + " - "
                + Convert.ToString(ComponentGallery.demoModel.sldHi);
            ComponentGallery.sliderMarkLbl.Text =
                ZanIDE.T("value = ", "当前值 = ")
                + Convert.ToString(ComponentGallery.demoModel.sldMark);
        } else if (shown == "Dropdown") {
            if (ComponentGallery.demoDropdownLast == "") {
                ComponentGallery.dropdownTipLbl.Text =
                    ZanIDE.T("Action menu — pick one to run it; the trigger returns to its hint",
                             "动作菜单——选中即执行命令，触发器回到提示语");
            } else {
                ComponentGallery.dropdownTipLbl.Text =
                    ZanIDE.T("Ran: ", "已执行：")
                    + ComponentGallery.demoDropdownLast;
            }
        }
    }
}
