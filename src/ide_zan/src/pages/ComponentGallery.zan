using System;
using Gui;
using Gui.Widget;

/// 组件画廊里那几个「只有即时接口」的标准库组件的宿主：Alert（通知
/// 条）、Tooltip、Table / DataTable / PivotTable、Menu、Ribbon、
/// Scrollbar、Chart、Ellipsis、Popover 这些没有保留态控件形态，只有
/// `X.Render(app, x, y, ...)`。让它们各自占一个声明出来的格子，在自己
/// 的矩形里绘制，画廊本身就不必再手算任何坐标。
class GalleryDemoHost : Control {
    /// 要画哪一个（组件名，和文档主题标题一致）。
    string demo;
    /// 这一格希望占的逻辑高度（宽度由所在行/舞台给出）。
    int logHeight;
    /// PivotTable 演示的保留状态/配置/数据（懒初始化，
    /// 跨帧持有才能保住滚动位置与选中单元格）。
    PivotState pivotState;
    PivotConfig pivotCfg;
    List<DataRow> pivotRows;

    GalleryDemoHost(string name, int h) {
        this.InitControl("GalleryDemoHost", 1);
        demo = name;
        logHeight = h;
    }

    // 演示数据：6 个区域 × 4 个季度，行与列都足以溢出可视区，
    // 展示透视表的行/列滚动与固定合计。
    List<DataRow> PivotDemoRows() {
        List<string> regions = new List<string>{
            "North", "South", "East", "West", "Central", "Overseas" };
        List<string> quarters = new List<string>{ "Q1", "Q2", "Q3", "Q4" };
        List<DataRow> rows = new List<DataRow>();
        int seed = 7;
        for (int r = 0; r < regions.Count; r = r + 1) {
            for (int q = 0; q < quarters.Count; q = q + 1) {
                seed = (seed * 31 + 17) % 997;
                int units = seed % 90 + 10;
                DataRow d = new DataRow();
                d.Push(regions[r]);
                d.Push(quarters[q]);
                d.Push(Convert.ToString(units));
                d.Push(Convert.ToString(units * 137 + seed % 53));
                rows.Add(d);
            }
        }
        return rows;
    }

    override string Kind() { return "GalleryDemoHost"; }

    override void OnMeasure(App app) {
        prefH = app.Scale(logHeight);
    }

    override void OnPaint(App app) {
        Theme t = app.theme;
        if (demo == "Alert") {
            Layer.DrawNotify(app, bx, by, bw,
                ZanIDE.T("Build succeeded — the executable is ready.",
                         "构建成功 — 可执行文件已准备就绪。"), 3);
        } else if (demo == "Tooltip") {
            Tooltip.Render(app, bx, by,
                ZanIDE.T("Helpful context", "辅助说明"));
        } else if (demo == "Table") {
            List<string> columns = new List<string>{ "Name", "Status" };
            List<int> widths = new List<int>{ bw / 2, bw / 2 };
            Table.RenderHeader(app, bx, by, columns, widths);
            List<string> cells = new List<string>{ "Zan", "Ready" };
            Table.RenderRow(app, bx, by + t.heightMedium, cells, widths, true);
        } else if (demo == "DataTable") {
            List<DataColumn> cols = new List<DataColumn>{
                DataColumn.Text("Name", bw / 2),
                DataColumn.Numeric("Score", bw / 3) };
            List<DataRow> rows = new List<DataRow>();
            DataRow row = new DataRow();
            row.Push("Zan"); row.Push("98"); rows.Add(row);
            DataTableState state = new DataTableState();
            DataTable.Render(app, bx, by, bw, bh, cols, rows, state);
        } else if (demo == "PivotTable") {
            if (pivotState == null) {
                pivotState = new PivotState();
                pivotRows = PivotDemoRows();
                pivotCfg = new PivotConfig(0, 1);
                pivotCfg.measures.Add(new PivotMeasure(2, 0, "Units", 0));
                pivotCfg.measures.Add(new PivotMeasure(3, 0, "Rev", 3));
                pivotCfg.groupDigits = true;
                pivotCfg.heat = true;
            }
            PivotTable.Render(app, bx, by, bw, bh, pivotRows, pivotCfg, pivotState);
        } else if (demo == "Menu") {
            List<string> items = new List<string>{ "Overview", "Settings" };
            SignalInt sel = DocsPreviewHost.DemoInt();
            int id = Menu.RenderVertical(app, bx, by, bw, by + bh,
                t.heightLarge, items, sel, 0);
            Menu.HandleClick(app, id, items.Count, sel);
        } else if (demo == "Ribbon") {
            List<RibbonCmd> commands = new List<RibbonCmd>{
                RibbonCmd.Group("play", "Run"), new RibbonCmd("build", "Build") };
            Ribbon.Render(app, bx, by, bw, Ribbon.Height(app), commands);
        } else if (demo == "Scrollbar") {
            // 演示用的底面走组件自己的样式，皮肤给 `panel` 的表面
            // （插画皮肤下是半透明的）同样适用。
            StyleBox sb = Style.Of(app, "panel", "", Style.SNormal());
            sb.Paint(app, bx, by, bw, bh);
            Scrollbar.RenderVertical(app, bx + bw - app.Scale(10), by, bh,
                bh * 4, bh);
        } else if (demo == "Chart") {
            List<string> labels = new List<string>{ "Q1", "Q2", "Q3", "Q4" };
            List<int> values = new List<int>{ 12, 28, 20, 35 };
            ChartOption opt = ChartOption.With(ChartType.Line, "", labels);
            opt.Add("Series", values);
            ChartView.Of(opt).Render(app, bx, by, bw, bh);
        } else if (demo == "Ellipsis") {
            Ellipsis.Render(app, bx, by, bw, ZanIDE.T(
                "A very long component example that must fit the available width",
                "一个必须适应可用宽度的超长组件示例"));
        }
    }
}

/// 组件画廊：文档里每个 GUI 组件主题下方那张「实时状态」卡片。卡片、
/// 两行紧凑演示和下方的舞台都声明在 `ComponentGallery.zform` 里，这里
/// 只按当前主题把真正的标准库控件挂进那三个格子——所以整段画廊没有
/// 一个手算的矩形，尺寸由控件自己测量、由布局分配。
partial class ComponentGallery {
    /// 可交互演示的保留实例与它们共享的模型：跨帧存活，用户输入的
    /// 文字、拖过的滑块、勾上的复选框才不会每帧被重建掉。
    static DocsDemoModel demoModel;
    static Checkbox demoCheck;
    static Switch demoSwitch;
    // Switch 增强演示族（保留态）：尺寸四档（tiny 是 Switch 独有档）/
    // 方形 / 内嵌文字 / 内嵌图标 / 加载 / 自定义色 / int 值轴。
    static Switch demoSwTiny;
    static Switch demoSwSmall;
    static Switch demoSwLarge;
    static Switch demoSwSquare;
    static Switch demoSwText;
    static Switch demoSwIcon;
    static Switch demoSwBusy;
    static Switch demoSwColor;
    static Switch demoSwValue;
    static Label demoSwValueLbl;
    static Radio demoRadioA;
    static Radio demoRadioB;
    // RadioGroup 增强演示（保留态）：选项值组 + 按钮形态组 + 跟值标签。
    static RadioGroup demoRgOpt;
    static RadioGroup demoRgBtn;
    static Label demoRgLbl;
    static Slider demoSlider;
    // Slider 演示族（保留态：每帧 new 会让 WidgetId 漂移，拖拽/悬停
    // 就再也落不回同一控件）。
    static Slider demoSliderRange;
    static Slider demoSliderMarks;
    static Slider demoSliderStepMark;
    static Slider demoSliderVt;
    static Slider demoSliderVtRev;
    static Slider demoSliderNoTip;
    static Slider demoSliderAlways;
    static Slider demoSliderFmt;
    static Slider demoSliderDisabled;
    // Text Input 演示族（同为保留态）：前缀 / 密码 / 可清除 / 加载 /
    // 圆角 / 校验态 / 字数统计 / 数字过滤，加 TextArea 两只。
    static Input demoInputDisabled;
    static Input demoInputTiny;
    static Input demoInputLarge;
    static Input demoInputPfx;
    static Input demoInputPw;
    static Input demoInputClr;
    static Input demoInputLoad;
    static Input demoInputRound;
    static Input demoInputErr;
    static Input demoInputCount;
    static Input demoInputDigits;
    static TextArea demoArea;
    static TextArea demoAreaCount;
    static SelectBox demoSelect;
    static Rate demoRate;
    static Tabs demoTabs;
    static DynamicTags demoDynTags;
    static ListView<string> demoList;
    static Dropdown<string> demoDropdown;
    /// Dropdown（动作菜单）演示：最近执行的命令（空串 = 还没执行过），
    /// 与说明/结果标签一起随 Sync() 每帧刷新。
    static string demoDropdownLast;
    static Label dropdownTipLbl;
    static TreeView demoTree;
    /// 滑块旁边那个跟着数值走的标签：内容每帧刷新，所以单独持有。
    static Label valueLbl;
    /// 范围双柄与标记值的实时读数标签（同 valueLbl，每帧刷新）。
    static Label sliderRangeLbl;
    static Label sliderMarkLbl;

    /// 已经搭好的是哪一个组件（空串表示还没搭过），只有换主题时才重建
    /// 控件树。
    string shown;
    bool built;

    /// 预览卡的逻辑高度（DocsPreviewHost 用，未缩放）。多行演示的组件
    /// 给足高度——详栏是 ScrollColumn，装不下会滚动，但卡内不裁。
    static int PreviewH(string name) {
        if (name == "Slider") { return 660; }
        // Switch 增强演示四段（尺寸/形状内容/加载颜色/值轴），按行高
        // 累加给足，卡内不裁。
        if (name == "Switch") { return 330; }
        // Radio Group 增强演示：基础两枚 + 选项值组 + 按钮组 + 跟值
        // 标签，按行高累加给足，卡内不裁。
        if (name == "Radio Group") { return 230; }
        // Text Input 演示有六段（基本/尺寸/前后缀族/计数过滤/TextArea/
        // 手动操作），按行高累加给足，卡内不裁。
        if (name == "Text Input") { return 340; }
        // Pagination 演示两行（基础 + 全段组合：total/jumper/sizes/
        // 前后缀）。
        if (name == "Pagination") { return 250; }
        return 142;
    }

    void OnInit() {
        this.Frame.SetProp("title",
            ZanIDE.T("LIVE STATES", "实时状态"));
        shown = "";
        built = false;
    }

    /// 声明一个控件希望占的逻辑尺寸（0 表示由控件自己测量）。逻辑像素
    /// 在测量时按当前缩放解析，所以 150% 下演示不会挤在一起。
    static Control Sized(Control c, int w, int h) {
        if (w > 0) { c.logW = w; }
        if (h > 0) { c.logH = h; }
        return c;
    }

    /// 懒建可交互演示，并把每个控件的 `.data` 绑到共享模型的字段上，
    /// 于是一个字段双向驱动一个演示控件。
    static void EnsureDemos() {
        if (ComponentGallery.demoModel != null) { return; }
        DocsDemoModel m = new DocsDemoModel();
        m.toggle = true;
        m.choice = 0;
        m.level = 50;
        m.pick = 0;
        m.stars = 3;
        ComponentGallery.demoModel = m;

        Checkbox cb = new Checkbox(ZanIDE.T("Checked", "选中"));
        cb.data = m.toggle;
        ComponentGallery.demoCheck = cb;

        Switch sw = new Switch();
        sw.data = m.toggle;
        ComponentGallery.demoSwitch = sw;

        // ---- Switch 增强演示族 ------------------------------------------
        m.swVal = 20;
        Switch swt = new Switch();
        swt.Size = "tiny";
        swt.data = m.toggle;
        ComponentGallery.demoSwTiny = swt;
        Switch sws = new Switch();
        sws.Size = "small";
        sws.data = m.toggle;
        ComponentGallery.demoSwSmall = sws;
        Switch swl = new Switch();
        swl.Size = "large";
        swl.data = m.toggle;
        ComponentGallery.demoSwLarge = swl;
        Switch swsq = new Switch();
        swsq.Round = false;
        swsq.data = m.toggle;
        ComponentGallery.demoSwSquare = swsq;
        Switch swtx = new Switch();
        swtx.CheckedText = ZanIDE.T("ON", "开");
        swtx.UncheckedText = ZanIDE.T("OFF", "关");
        swtx.data = m.toggle;
        ComponentGallery.demoSwText = swtx;
        Switch swic = new Switch();
        swic.CheckedIcon = "check";
        swic.UncheckedIcon = "close";
        swic.data = m.toggle;
        ComponentGallery.demoSwIcon = swic;
        Switch swby = new Switch();
        swby.Loading = true;
        swby.CheckedText = ZanIDE.T("Sync", "同步");
        swby.data = m.toggle;
        ComponentGallery.demoSwBusy = swby;
        Switch swco = new Switch();
        swco.CheckedColor = 0x1677FF;
        swco.UncheckedColor = 0x0E9F6E;
        swco.CheckedText = ZanIDE.T("ON", "开");
        swco.UncheckedText = ZanIDE.T("OFF", "关");
        swco.data = m.toggle;
        ComponentGallery.demoSwColor = swco;
        // int 值轴：开关表达 m.swVal == 10，拨动写回 10/20。
        Switch swva = new Switch();
        swva.value = m.swVal;
        swva.CheckedValue = 10;
        swva.UncheckedValue = 20;
        ComponentGallery.demoSwValue = swva;
        ComponentGallery.demoSwValueLbl = new Label("");
        ComponentGallery.demoSwValueLbl.Class = "secondary";

        SignalInt group = new SignalInt(0);
        Radio ra = new Radio(group, 0, "Option A");
        ra.data = m.choice;
        ComponentGallery.demoRadioA = ra;
        Radio rb = new Radio(group, 1, "Option B");
        rb.data = m.choice;
        ComponentGallery.demoRadioB = rb;

        // ---- RadioGroup 增强：选项值组 + 按钮形态组 ----------------
        m.rgCity = 20;
        RadioGroup rgo = new RadioGroup();
        rgo.AddOption("Beijing", 10);
        rgo.AddOption("Shanghai", 20);
        rgo.AddOption("Guangzhou", 30, true);
        rgo.Value = m.rgCity;
        rgo.SyncGroup();
        ComponentGallery.demoRgOpt = rgo;
        RadioGroup rgb = new RadioGroup();
        rgb.AddOption("Daily");
        rgb.AddOption("Pickup");
        rgb.AddOption("Locker", 3, true);
        rgb.Buttons = true;
        rgb.SyncGroup();
        ComponentGallery.demoRgBtn = rgb;
        ComponentGallery.demoRgLbl = new Label("");
        ComponentGallery.demoRgLbl.Class = "secondary";

        Slider sl = new Slider(0, 100, new SignalInt(50));
        sl.data = m.level;
        ComponentGallery.demoSlider = sl;

        // ---- Slider 演示族：范围 / 标记 / 垂直 / 气泡 / 禁用 ----------
        m.sldLo = 30;
        m.sldHi = 70;
        Slider rg = new Slider(0, 100);
        rg.range = true;
        rg.data = m.sldLo;
        rg.dataHigh = m.sldHi;
        ComponentGallery.demoSliderRange = rg;

        m.sldMark = 37;
        Slider mk = new Slider(0, 100);
        mk.AddMark(0, "0°C");
        mk.AddMark(20, "20°C");
        mk.AddMark(37, "37°C");
        mk.AddMark(100, "100°C");
        mk.data = m.sldMark;
        ComponentGallery.demoSliderMarks = mk;
        // 限取标记值（Naive UI step="mark"）：只能停在标记上，
        // 与上一条共享同一个模型字段，自由/受限一眼可比。
        Slider smk = new Slider(0, 100);
        smk.AddMark(20, "20°C");
        smk.AddMark(37, "37°C");
        smk.AddMark(60, "60°C");
        smk.AddMark(100, "100°C");
        smk.stepMark = true;
        smk.data = m.sldMark;
        ComponentGallery.demoSliderStepMark = smk;

        Slider vt = new Slider(0, 100);
        vt.vertical = true;
        vt.AddMark(0, "0°C");
        vt.AddMark(37, "37°C");
        vt.AddMark(100, "100°C");
        vt.data = m.sldMark;
        ComponentGallery.demoSliderVt = vt;
        Slider vr = new Slider(0, 100);
        vr.vertical = true;
        vr.reverse = true;
        vr.data = m.sldMark;
        ComponentGallery.demoSliderVtRev = vr;

        m.sldFmt = 50;
        Slider nt = new Slider(0, 100);
        nt.tooltip = false;
        nt.data = m.sldFmt;
        ComponentGallery.demoSliderNoTip = nt;
        Slider at = new Slider(0, 100);
        at.showTooltip = true;
        at.data = m.sldFmt;
        ComponentGallery.demoSliderAlways = at;
        Slider ft = new Slider(0, 100);
        ft.tipFormat = "{v}%";
        ft.data = m.sldFmt;
        ComponentGallery.demoSliderFmt = ft;

        Slider lk = new Slider(0, 100, new SignalInt(50));
        lk.Disabled = true;
        ComponentGallery.demoSliderDisabled = lk;

        ComponentGallery.sliderRangeLbl = new Label("");
        ComponentGallery.sliderRangeLbl.Class = "secondary";
        ComponentGallery.sliderMarkLbl = new Label("");
        ComponentGallery.sliderMarkLbl.Class = "secondary";

        List<string> opts = new List<string>{
            ZanIDE.T("Default", "默认"), ZanIDE.T("Success", "成功"),
            ZanIDE.T("Warning", "警告") };
        SelectBox se = SelectBox.FromOptions(opts,
            ZanIDE.T("Choose a state", "选择状态"));
        se.data = m.pick;
        ComponentGallery.demoSelect = se;

        Rate rt = new Rate(new SignalInt(3), 5);
        rt.data = m.stars;
        ComponentGallery.demoRate = rt;

        Tabs tb = new Tabs(0);
        tb.Add("Overview", false);
        tb.Add("API", false);
        tb.Add("Examples", false);
        ComponentGallery.demoTabs = tb;

        DynamicTags dt = new DynamicTags();
        List<string> seeds = new List<string>{
            ZanIDE.T("Investigating", "调查中"),
            ZanIDE.T("Published", "已发布") };
        dt.SetItems(seeds);
        ComponentGallery.demoDynTags = dt;

        List<string> items = new List<string>{ "Alpha", "Beta", "Gamma" };
        ListView<string> lv =
            new ListView<string>(new ListColumn<string>("", s => s));
        lv.Class = "flat";
        lv.Bind(items);
        ComponentGallery.demoList = lv;

        // Dropdown 演示成动作菜单（与上面的 SelectBox「选值」区分开）：
        // 选中即执行命令，随后 Clear() 让触发器回到提示语，不保留选中值。
        List<string> actions = new List<string>{
            ZanIDE.T("Share...", "分享…"), ZanIDE.T("Rename...", "重命名…"),
            ZanIDE.T("Copy path", "复制路径"), ZanIDE.T("Delete", "删除") };
        Dropdown<string> dd = new Dropdown<string>(s => s);
        dd.Hint(ZanIDE.T("More actions", "更多操作"));
        dd.Bind(actions);
        dd.OnChange(ComponentGallery.OnDropdownAct);
        ComponentGallery.demoDropdown = dd;
        ComponentGallery.demoDropdownLast = "";
        ComponentGallery.dropdownTipLbl = new Label("");
        ComponentGallery.dropdownTipLbl.Class = "secondary";

        List<TreeNode> nodes = new List<TreeNode>{
            TreeNode.Dir("src", 0, true),
            TreeNode.FileIcon("main.zan", 1, "file") };
        TreeView tv = new TreeView();
        tv.BindSel(DocsPreviewHost.DemoInt()).Bind(nodes);
        ComponentGallery.demoTree = tv;

        ComponentGallery.valueLbl = new Label("");
        ComponentGallery.valueLbl.Class = "secondary";

        // ---- Text Input 演示族：尺寸 / 前后缀 / 密码 / 清除 / 加载 /
        // 圆角 / 校验态 / 字数 / 过滤（对齐 Naive UI Input 文档示例；
        // 基础字段由 DocsPreviewHost 保留、随 Show 传入，直接挂首行）。 ----
        Input inDis = new Input(ZanIDE.T("Disabled", "禁用"));
        inDis.Disabled = true;
        ComponentGallery.demoInputDisabled = inDis;
        Input inTiny = new Input("tiny");
        inTiny.Size = "tiny";
        ComponentGallery.demoInputTiny = inTiny;
        Input inLarge = new Input("large");
        inLarge.Size = "large";
        ComponentGallery.demoInputLarge = inLarge;

        Input inPfx = new Input(ZanIDE.T("site", "站点"));
        inPfx.PrefixIcon = "globe";
        inPfx.Prefix = "https://";
        inPfx.Suffix = ".com";
        inPfx.SetText("zan");
        ComponentGallery.demoInputPfx = inPfx;
        Input inPw = new Input(ZanIDE.T("password", "密码"));
        inPw.password = true;
        inPw.SetText("hunter2");
        ComponentGallery.demoInputPw = inPw;
        Input inClr = new Input(ZanIDE.T("clearable", "可清除"));
        inClr.Clearable = true;
        inClr.SetText(ZanIDE.T("hover me", "悬停我"));
        ComponentGallery.demoInputClr = inClr;
        Input inLoad = new Input(ZanIDE.T("loading", "加载中"));
        inLoad.Loading = true;
        ComponentGallery.demoInputLoad = inLoad;
        Input inRound = new Input(ZanIDE.T("round", "圆角"));
        inRound.Round = true;
        inRound.SetText("pill");
        ComponentGallery.demoInputRound = inRound;
        Input inErr = new Input(ZanIDE.T("status", "校验态"));
        inErr.SetStatus(Control.StatusError());
        inErr.SetText("oops");
        ComponentGallery.demoInputErr = inErr;
        Input inCount = new Input(ZanIDE.T("type here", "在此输入"));
        inCount.ShowCount = true;
        inCount.MaxLen = 30;
        inCount.Clearable = true;
        ComponentGallery.demoInputCount = inCount;
        Input inDigits = new Input(ZanIDE.T("digits only", "只许数字"));
        inDigits.ShowCount = true;
        inDigits.MaxLen = 20;
        inDigits.Filter = Input.OnlyDigits;
        ComponentGallery.demoInputDigits = inDigits;

        ComponentGallery.demoArea = new TextArea(ZanIDE.T(
            "plain textarea", "普通多行"));
        TextArea ar2 = new TextArea(ZanIDE.T("round + count", "圆角 + 字数"));
        ar2.Round = true;
        ar2.ShowCount = true;
        ar2.MaxLen = 100;
        ar2.SetStatus(Control.StatusSuccess());
        ar2.SetText(ZanIDE.T("editable notes...", "可编辑的备注……"));
        ComponentGallery.demoAreaCount = ar2;
    }

    /// 按主题搭出这一格的控件树。只有主题变了才重建：保留实例带着
    /// 用户的编辑状态，重建会把它们连状态一起丢掉。
    void Show(string name, Input demoInput) {
        if (built && name == shown) { return; }
        built = true;
        shown = name;
        ComponentGallery.EnsureDemos();
        Panel row1 = this.Row1;
        Panel row2 = this.Row2;
        Panel stage = this.Stage;
        row1.RemoveAll();
        row2.RemoveAll();
        stage.RemoveAll();
        if (name == "Button") {
            row1.Add(ComponentGallery.Sized(
                new Button { Text = "Default" }, 104, 0));
            row1.Add(ComponentGallery.Sized(
                new Button { Text = "Primary", Class = "primary" }, 104, 0));
            row1.Add(ComponentGallery.Sized(
