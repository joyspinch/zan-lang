using System;
using Gui;
using Gui.Widget;

/// 帮助 / 文档页的界面：左侧区段导轨 + 搜索与主题树，右侧是选中主题的
/// 详情（分类标签、标题、正文、实时预览、可复制的代码示例）。
///
/// 布局在 `DocsView.zform` 里声明；这里只在每帧切换空态/详情态，
/// 并把选中主题的文字铺进去（主题过滤与数据仍在 DocsPage）。
partial class DocsView {
    void OnInit() {
        this.ShowEmpty("");
    }

    /// 没有主题命中搜索：只显示提示文字。
    void ShowEmpty(string text) {
        DocsView.EmptyText.Text = text;
        DocsView.EmptyPane.visible = true;
        DocsView.DetailScroll.visible = false;
    }

    /// 显示选中主题；`preview` 决定是否露出实时组件画廊。正文按自己
    /// 分到的宽度换行（Label 用上一帧的 `bw` 测量），所以这里不需要
    /// 任何宽度计算。
    void ShowTopic(string title, string body, bool preview) {
        DocsView.EmptyPane.visible = false;
        DocsView.DetailScroll.visible = true;
        DocsView.Title.Text = title;
        DocsView.Body.Text = body;
        DocsView.Preview.visible = preview;
    }
}
