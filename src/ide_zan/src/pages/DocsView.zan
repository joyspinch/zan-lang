using System;
using Gui;
using Gui.Widget;

/// 帮助 / 文档页的界面：左侧区段导轨 + 搜索与主题树，右侧是选中主题的
/// 详情（分类标签、标题、正文、实时预览、可复制的代码示例）。
///
/// 布局在 `DocsView.zform` 里声明；这里只在每帧切换空态/详情态，
/// 并把选中主题的文字铺进去（主题过滤与数据仍在 DocsPage）。
partial class DocsView {
    /// 上一次折行的正文和宽度：正文只有在换了主题或者面板宽度变了
    /// 的时候才需要重折，逐帧重折就是白算。
    string bodyText;
    int bodyWidth;

    void OnInit() {
        this.Body.ReadOnly(true);
        this.Body.AutoHeight(true);
        this.ShowEmpty("");
    }

    /// 没有主题命中搜索：只显示提示文字。
    void ShowEmpty(string text) {
        this.EmptyText.Text = text;
        this.EmptyPane.visible = true;
        this.DetailScroll.visible = false;
    }

    /// 显示选中主题；`preview` 决定是否露出实时组件画廊。换主题时调用
    /// 一次，正文的折行由 WrapBody 负责。
    void ShowTopic(string title, string body, bool preview) {
        this.EmptyPane.visible = false;
        this.DetailScroll.visible = true;
        this.Title.Text = title;
        this.bodyText = body;
        this.bodyWidth = 0;
        this.Preview.visible = preview;
    }

    /// 把正文按当前宽度折好灌进正文框。
    ///
    /// 正文是只读的文本框而不是标签：读文档的人要能划选、复制其中
    /// 一段。文本框本身不折行，所以正文在这里按它上一帧分到的宽度
    /// 折好再灌进去（首帧还没有宽度时按面板宽度估一个），高度则由
    /// 文本框按行数自己撑开，交给外层的滚动列滚动。折行只在正文或
    /// 宽度变了时做一次。
    void WrapBody(App app, int paneW) {
        string body = this.bodyText;
        if (body == null) { return; }

        int textW = this.Body.bw - app.theme.paddingSmall * 2;
        if (textW <= 0) { textW = paneW - app.Scale(104 + 268 + 48 + 16); }
        if (textW < app.Scale(120)) { textW = app.Scale(120); }
        if (textW == this.bodyWidth) { return; }
        this.bodyWidth = textW;
        List<string> wrapped = TextWrap.Lines(body, textW,
                                              app.theme.fontSizeMedium);
        StringBuilder sb = new StringBuilder();
        for (int i = 0; i < wrapped.Count; i = i + 1) {
            if (i > 0) { sb.Append("\n"); }
            sb.Append(wrapped[i]);
        }
        string text = sb.ToString();
        // 只在内容真的变了时写入：SetText 会清掉选区和光标，每帧写一次
        // 就等于永远选不中。
        if (this.Body.GetText() != text) { this.Body.SetText(text); }
    }
}
