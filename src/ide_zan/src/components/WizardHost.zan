using Gui;

/// The New Project / New File / Save-as-Template wizard child window.
///
/// The wizard widget is immediate-mode (Wizard.Show draws one frame and
/// reports the action), so unlike the tree-based child windows this one has
/// no Control root: the shell registers a render callback (SetRender) that
/// builds the Wizard for the current mode, renders it into Host() and
/// dispatches the reported action back into the shell.
class WizardHost : ChildWindow {
    string wTitle;
    int wW;
    int wH;
    Action closeCb;

    WizardHost(string title, int w, int h) {
        wTitle = title;
        wW = w;
        wH = h;
        closeCb = null;
    }

    override string Title() { return wTitle; }
    override int Width() { return wW; }
    override int Height() { return wH; }

    /// Called when the user closes the window through the OS caption / ESC:
    /// the shell drops the wizard state (and any picker it opened).
    void OnClose(Action a) {
        closeCb = a;
    }

    override void OnCloseRequested() {
        if (closeCb != null) { closeCb(); }
    }

    /// Opens with the main window's look and registers with the pump.
    void Open(App parent) {
        this.OpenHost(parent);
    }
}
