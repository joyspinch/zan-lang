using Gui;

/// 核心契约与语义定义。
/// 核心契约与语义定义。
/// 核心契约与语义定义。
/// 核心契约与语义定义。
/// 核心契约与语义定义。
/// 核心契约与语义定义。
class WizardHost : ChildWindow {
    string wTitle;
    int wW;
    int wH;
    Action closeCb;

    WizardHost(string title, int w, int h) {
        wTitle = title;
        wW = w;
        wH = h;
        closeCb = null;
    }

    override string Title() { return wTitle; }
    override int Width() { return wW; }
    override int Height() { return wH; }

    /// 核心契约与语义定义。
    /// 核心契约与语义定义。
    void OnClose(Action a) {
        closeCb = a;
    }

    override void OnCloseRequested() {
        if (closeCb != null) { closeCb(); }
    }

    /// 核心契约与语义定义。
    void Open(App parent) {
        this.OpenHost(parent);
    }
}
