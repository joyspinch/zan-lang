using System;
using Gui;
using Gui.Widget;
using Gui.Backend;
using Gui.Component.CodeEditor;

public class DocsSearchHost : Control {

    // 组件自注册（B-ID44 约定）：注册表由 gen_design_halves.py 扫描
    // 文档引用自动生成，这里声明自己的工厂；重复注册以最后一次为准。
    public static void Install() {
        Gui.HeavyControls.Register("DocsSearchHost", (string k) => new DocsSearchHost());
    }

    static Input search;

    static Input Search() {
        if (DocsSearchHost.search == null) {
            Input box = new Input(
                ZanIDE.T("Search syntax & components...", "搜索语法与组件..."));
            box.dock = 5;
            DocsSearchHost.search = box;
        }
        return DocsSearchHost.search;
    }

    DocsSearchHost() {
        this.InitControl("DocsSearchHost", 1);
        this.Add(DocsSearchHost.Search());
    }

    override string Kind() { return "DocsSearchHost"; }

    override void OnMeasure(App app) {
        prefH = app.theme.heightMedium;
    }
}
