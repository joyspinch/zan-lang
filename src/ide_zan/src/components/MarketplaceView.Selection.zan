using System.Collections.Generic;
using Gui;
using Gui.Widget;

partial class MarketplaceView {
    MarketplaceCatalog selectionCatalog;
    List<MarketplacePackage> selectionPackages;
    MarketplacePackage selectionPackage;

    // Only project changed catalog state. A row click queues its callback, so
    // another measurement must preserve the list's selection until it drains.
    void SyncSelection(MarketplaceCatalog cat) {
        List<MarketplacePackage> packages = cat.Packages();
        MarketplacePackage selected = cat.SelectedPackage();
        this.Packages.Bind(packages);
        if (selectionCatalog == cat && selectionPackages == packages
            && selectionPackage == selected) { return; }
        int row = -1;
        if (selected != null) {
            for (int i = 0; i < packages.Count; i = i + 1) {
                if (packages[i].id == selected.id && packages[i].slug == selected.slug) {
                    row = i;
                    break;
                }
            }
        }
        cat.selectedRow = row;
        if (row < 0) {
            this.Packages.ClearSelection();
        } else if (row != this.Packages.SelectedIndex()) {
            this.Packages.SelectIndex(row);
        }
        selectionCatalog = cat;
        selectionPackages = packages;
        selectionPackage = selected;
    }
}
