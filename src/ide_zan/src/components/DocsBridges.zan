using System;
using Gui;
using Gui.Widget;
using Gui.Backend;

// 接口数据协议与执行契约。
// 核心契约与语义定义。

// 接口数据协议与执行契约。
class DocsSectionTabs : Control {
    static SignalInt sel;
    static Tabs tabs;
    static List<string> lastLabels;

    // 接口数据协议与执行契约。
    static SignalInt Sel() {
        if (DocsSectionTabs.sel == null) {
            DocsSectionTabs.sel = new SignalInt(0);
        }
        return DocsSectionTabs.sel;
    }

    // 接口数据协议与执行契约。
    // 核心契约与语义定义。
    static Tabs Strip() {
        if (DocsSectionTabs.tabs == null) {
            Tabs t = Tabs.CreateVertical(Tabs.Line());
            t.dock = 5;
            t.TabChanged.Add(DocsSectionTabs.Changed);
            DocsSectionTabs.tabs = t;
        }
        return DocsSectionTabs.tabs;
    }

    // 接口数据协议与执行契约。
    // 核心契约与语义定义。
    static void Changed() {
        int c = DocsSectionTabs.tabs.TakeChanged();
        if (c >= 0) { DocsSectionTabs.Sel().Set(c); }
    }

    // 接口数据协议与执行契约。
    static void Sections(List<string> labels) {
        Tabs t = DocsSectionTabs.Strip();
        if (ZanIDE.StringListsEqual(DocsSectionTabs.lastLabels, labels)) { return; }
        t.Clear();
        for (int i = 0; i < labels.Count; i = i + 1) { t.Add(labels[i], false); }
        DocsSectionTabs.lastLabels = labels;
    }

    DocsSectionTabs() {
        this.InitControl("DocsSectionTabs", 1);
        this.Add(DocsSectionTabs.Strip());
    }

    override string Kind() { return "DocsSectionTabs"; }

    override void OnMeasure(App app) {
        // 接口数据协议与执行契约。
        // name at 150% DPI.
        Tabs strip = DocsSectionTabs.Strip();
        prefW = strip.prefW;
        prefH = strip.prefH;
        // 接口数据协议与执行契约。
        DocsSectionTabs.Strip().Select(DocsSectionTabs.Sel().Get());
    }
}

// 接口数据协议与执行契约。
// 核心契约与语义定义。
class DocsSearchHost : Control {
    static Input search;

    // 接口数据协议与执行契约。
    // 核心契约与执行状态转移规范。
    static Input Search() {
        if (DocsSearchHost.search == null) {
            Input box = new Input(
                ZanIDE.T("Search syntax & components...", "搜索语法与组件..."));
            box.dock = 5;
            DocsSearchHost.search = box;
        }
        return DocsSearchHost.search;
    }

    DocsSearchHost() {
        this.InitControl("DocsSearchHost", 1);
        this.Add(DocsSearchHost.Search());
    }

    override string Kind() { return "DocsSearchHost"; }

    override void OnMeasure(App app) {
        prefH = app.theme.heightMedium;
    }
}

// 接口数据协议与执行契约。
class DocsTopicList : Control {
    static SignalInt selSig;
    static SignalInt codeScroll;
    static ListView<DocTopic> list;

    // 接口数据协议与执行契约。
    static SignalInt SelSig() {
        if (DocsTopicList.selSig == null) {
            DocsTopicList.selSig = new SignalInt(0);
        }
        return DocsTopicList.selSig;
    }

    // 接口数据协议与执行契约。
    static SignalInt CodeScroll() {
        if (DocsTopicList.codeScroll == null) {
            DocsTopicList.codeScroll = new SignalInt(0);
        }
        return DocsTopicList.codeScroll;
    }

    // 接口数据协议与执行契约。
    static ListView<DocTopic> List() {
        if (DocsTopicList.list == null) {
            ListView<DocTopic> lv = new ListView<DocTopic>(DocTopicRow.Of);
            lv.Class = "flat";
            lv.dock = 5;
            lv.EmptyText(ZanIDE.T("No topics match your search.",
                                  "没有匹配搜索的主题。"));
            lv.OnSelect(DocsPage.TopicPicked);
            DocsTopicList.list = lv;
            DocsPage.docList = lv;
            DocsPage.docSel = DocsTopicList.SelSig();
            DocsPage.docCodeScroll = DocsTopicList.CodeScroll();
        }
        return DocsTopicList.list;
    }

    // 接口数据协议与执行契约。
    // 核心契约与语义定义。
    static void Rows(List<DocTopic> topics) {
        DocsTopicList.List().Bind(topics);
    }

    // 核心契约与语义定义。
    static void Select(int selRow) {
        DocsTopicList.List().SelectIndex(selRow);
    }

    DocsTopicList() {
        this.InitControl("DocsTopicList", 1);
        this.Add(DocsTopicList.List());
    }

    override string Kind() { return "DocsTopicList"; }

    override void OnMeasure(App app) {
        prefH = app.Scale(200);
    }
}

// 接口数据协议与执行契约。
class DocsTagHost : Control {
    static Tag chip;

    static Tag Chip() {
        if (DocsTagHost.chip == null) {
            Tag t = new Tag("");
            t.dock = 3;
            DocsTagHost.chip = t;
        }
        return DocsTagHost.chip;
    }

    // 接口数据协议与执行契约。
    static void Show(string text, string cls) {
        Tag t = DocsTagHost.Chip();
        t.Text = text;
        t.Class = cls;
    }

    DocsTagHost() {
        this.InitControl("DocsTagHost", 1);
        this.Add(DocsTagHost.Chip());
    }

    override string Kind() { return "DocsTagHost"; }

    // 接口数据协议与执行契约。
    override void OnMeasure(App app) {
        prefH = DocsTagHost.Chip().prefH;
    }
}

// 接口数据协议与执行契约。
class DocsPreviewHost : Control {
    static string preview;
    static SignalBool demoBool;
    static SignalInt demoInt;
    static Input demoInput;

    // 接口数据协议与执行契约。
    static SignalBool DemoBool() {
        if (DocsPreviewHost.demoBool == null) {
            DocsPreviewHost.demoBool = new SignalBool(true);
        }
        return DocsPreviewHost.demoBool;
    }

    // 接口数据协议与执行契约。
    static SignalInt DemoInt() {
        if (DocsPreviewHost.demoInt == null) {
            DocsPreviewHost.demoInt = new SignalInt(2);
        }
        return DocsPreviewHost.demoInt;
    }

    // 接口数据协议与执行契约。
    static Input DemoInput() {
        if (DocsPreviewHost.demoInput == null) {
            DocsPreviewHost.demoInput = new Input(ZanIDE.T("Type here", "在此输入"));
            DocsPreviewHost.demoInput.SetText("Zan");
        }
        return DocsPreviewHost.demoInput;
    }

    // 声明出来的画廊（`pages/ComponentGallery.html`）：这一格只是把它
    // 挂进文档的详情列里，控件树、尺寸和布局都由画廊自己负责。
    static ComponentGallery gallery;

    // 切到某个组件主题：重搭画廊里的演示控件。在测量之前调用（测量
    // 是自下而上的，那时候改子节点就太晚了）。
    static void Show(string component) {
        DocsPreviewHost.preview = component;
        if (DocsPreviewHost.gallery == null) { return; }
        DocsPreviewHost.gallery.Show(component, DocsPreviewHost.DemoInput());
    }

    DocsPreviewHost() {
        this.InitControl("DocsPreviewHost", 1);
        if (DocsPreviewHost.gallery == null) {
            DocsPreviewHost.gallery = new ComponentGallery();
        }
        DocsPreviewHost.gallery.dock = 5;
        this.Add(DocsPreviewHost.gallery);
    }

    override string Kind() { return "DocsPreviewHost"; }

    override void OnMeasure(App app) {
        // 高度按组件查表：多行演示（如 Slider 的六组）给足，其余保持
        // 原来的 142。详栏是 ScrollColumn，长卡片滚得到，卡内不裁。
        prefH = app.Scale(ComponentGallery.PreviewH(DocsPreviewHost.preview));
        DocsPreviewHost.gallery.Sync();
    }
}

// 接口数据协议与执行契约。
class DocsCodeBlockHost : Control {
    static CodeBlock code;
    static string copyTitle;
    static string copyText;
    static List<string> log;
    // 接口数据协议与执行契约。
    // 核心契约与语义定义。
    static string loaded;
    static int lineCount;

    // 接口数据协议与执行契约。
    static SignalInt Scroll() {
        return DocsTopicList.CodeScroll();
    }

    static CodeBlock Block() {
        if (DocsCodeBlockHost.code == null) {
            CodeBlock cb = new CodeBlock("Zan", new List<string>());
            cb.dock = 5;
            cb.UseScroll(DocsCodeBlockHost.Scroll());
            cb.Copy.Add(DocsCodeBlockHost.Copied);
            DocsCodeBlockHost.code = cb;
            DocsCodeBlockHost.loaded = "";
        }
        return DocsCodeBlockHost.code;
    }

    // 接口数据协议与执行契约。
    static void Example(string title, string text, List<string> lines,
                        string copyLabel) {
        CodeBlock cb = DocsCodeBlockHost.Block();
        DocsCodeBlockHost.copyTitle = title;
        DocsCodeBlockHost.copyText = text;
        cb.CopyLabel = copyLabel;
        if (lines == null) {
            DocsCodeBlockHost.lineCount = 0;
            cb.SetShown(false);
            return;
        }
        cb.SetShown(true);
        DocsCodeBlockHost.lineCount = lines.Count;
        if (DocsCodeBlockHost.loaded == text) { return; }
        cb.SetLines(lines);
        DocsCodeBlockHost.loaded = text;
    }

    // 接口数据协议与执行契约。
    static void Copied() {
        Clipboard.SetText(DocsCodeBlockHost.copyText);
        if (DocsCodeBlockHost.log != null) {
            DocsCodeBlockHost.log.Add("> Copied \""
                + DocsCodeBlockHost.copyTitle
                + "\" example to the clipboard.");
        }
        Layer.Msg(ZanIDE.T("Example copied to the clipboard",
                           "示例已复制到剪贴板"), 3);
    }

    DocsCodeBlockHost() {
        this.InitControl("DocsCodeBlockHost", 1);
        this.Add(DocsCodeBlockHost.Block());
    }

    override string Kind() { return "DocsCodeBlockHost"; }

    override void OnMeasure(App app) {
        if (DocsCodeBlockHost.lineCount == 0) {
            prefH = app.Scale(40);
            return;
        }
        prefH = CodeBlock.Height(app, DocsCodeBlockHost.lineCount);
    }
}
