using System;
using Gui;
using Gui.Widget;

/// @component Asset Manager view
/// Bridges the Asset Manager's immediate-mode renderer into the retained
/// control tree: the WindowShell paints the themed background + title bar and
/// this component draws the manager inside the remaining content area, so
/// the manager matches every other IDE window.
class AssetManagerView : Control {
    AssetManagerView() {
        this.InitControl("assetview", 4);
    }

    override string Kind() { return "AssetManagerView"; }

    override void OnMeasure(App app) {
        prefW = app.Scale(900);
        prefH = app.Scale(660);
    }

    override void OnPaint(App app) {
        AssetManager m = AssetManager.current;
        if (m == null) { return; }
        int a = m.RenderInside(app, bx, by, bw, bh,
            AssetManager.RootOf(), AssetManager.LogOf());
        AssetManager.SetAction(a);
    }
}
