using System;
using Gui;
using Gui.Widget;

/// @component Marketplace view
class MarketplaceView : Control {
    MarketplaceView() {
        this.InitControl("marketplaceview", 4);
    }

    override string Kind() { return "MarketplaceView"; }

    override void OnMeasure(App app) {
        prefW = app.Scale(940);
        prefH = app.Scale(640);
    }

    override void OnPaint(App app) {
        MarketplaceBrowser browser = MarketplaceWindow.Browser();
        if (browser == null) { return; }
        int action = browser.RenderInside(app, bx, by, bw, bh);
        MarketplaceWindow.SetAction(action);
    }
}
