using System;
using System.Diagnostics;
using System.Collections.Generic;
using Gui;
using Gui.Backend;
using Gui.Widget;

// 扩展市场视图：目录表格 + 详情列 + 刷新 / 安装。
// // 界面在 `MarketplaceView.html` 里声明（工具条一行、左侧详情列、
// 右侧目录表格），目录与网络状态在 Gui 无关的 `MarketplaceCatalog`
// 里。这里只做三件事：建表头、把这一帧的状态铺进控件、把按钮点击
// 转成目录操作或安装意图。
partial class MarketplaceView {
    // 当前视图：按钮与列表的回调是普通函数指针，靠它找回实例。
    static MarketplaceView current;
    ListView<MarketplacePlan> pricingPlans;

    void OnInit() {
        MarketplaceView.current = this;
        this.RefreshBtn.SetProp("text",
            MarketplaceCatalog.T("Refresh", "刷新"));
        this.RefreshBtn.Icon = "refresh";
        this.RefreshBtn.Click.Add(MarketplaceView.Refresh);
        this.InstallBtn.Icon = "download";
        this.InstallBtn.Click.Add(MarketplaceView.Install);
        this.Paid.SetWrap(true);
        List<ListColumn<MarketplacePlan>> plans = new List<ListColumn<MarketplacePlan>>();
        plans.Add(new ListColumn<MarketplacePlan>(MarketplaceCatalog.T("Plan", "方案"), 2, plan => plan.name));
        plans.Add(new ListColumn<MarketplacePlan>(MarketplaceCatalog.T("Points", "积分"), 1,
            plan => plan.pricePoints < 0 ? "?" : Convert.ToString(plan.pricePoints)).Right());
        plans.Add(new ListColumn<MarketplacePlan>(MarketplaceCatalog.T("License", "许可"), 2, plan => plan.licenseMode));
        plans.Add(new ListColumn<MarketplacePlan>(MarketplaceCatalog.T("Days", "天数"), 1,
            plan => plan.durationDays > 0 ? Convert.ToString(plan.durationDays) : "—").Right());
        pricingPlans = new ListView<MarketplacePlan>(plans);
        pricingPlans.SetProp("style", "height: 160px; flex-shrink: 0;");
        this.Detail.Add(pricingPlans);
        this.Packages.WithColumns(MarketplaceView.Columns());
        this.Packages.EmptyText(
            MarketplaceCatalog.T("No extensions available.", "暂无可用扩展。"));
        this.Packages.OnSelect(MarketplaceView.Picked);
    }

    // 目录表格的列：名称、命名空间、分类，价格右对齐。
    static List<ListColumn<MarketplacePackage>> Columns() {
        List<ListColumn<MarketplacePackage>> cols =
            new List<ListColumn<MarketplacePackage>>();
        cols.Add(new ListColumn<MarketplacePackage>(
            MarketplaceCatalog.T("Product", "商品"), 3,
            package => package.displayName));
        cols.Add(new ListColumn<MarketplacePackage>(
            MarketplaceCatalog.T("Namespace", "命名空间"), 2,
            package => package.NamespaceLabel()));
        cols.Add(new ListColumn<MarketplacePackage>(
            MarketplaceCatalog.T("Type", "类型"), 1,
            package => package.IsApp() ? MarketplaceCatalog.T("App", "应用")
                : MarketplaceCatalog.T("Extension", "扩展")));
        cols.Add(new ListColumn<MarketplacePackage>(
            MarketplaceCatalog.T("Category", "分类"), 2,
            package => package.category));
        cols.Add(new ListColumn<MarketplacePackage>(
            MarketplaceCatalog.T("Price", "价格"), 1,
            package => MarketplaceView.PriceLabel(package)).Right());
        return cols;
    }

    static string PriceLabel(MarketplacePackage package) {
        if (package.pricePoints < 0) { return MarketplaceCatalog.T("See product", "查看商品"); }
        return MarketplaceCatalog.PriceLabel(package);
    }

    static MarketplaceCatalog Cat() { return MarketplaceCatalog.current; }

    // 选中一行：拉这个扩展的详情。
    static void Picked() {
        MarketplaceView view = MarketplaceView.current;
        MarketplaceCatalog cat = MarketplaceView.Cat();
        if (cat == null || view == null || cat.Loading()) { return; }
        if (!view.Packages.HasSelection()) { return; }
        cat.Select(view.Packages.Selected());
        cat.selectedRow = view.Packages.SelectedIndex();
    }

    static void Refresh() {
        MarketplaceCatalog cat = MarketplaceView.Cat();
        if (cat != null) { cat.Refresh(); }
    }

    // 安装是要花钱 / 改环境的动作，所以第一次点是「请确认」，第二次
    // 才把意图交给子窗口去装。
    static void Install() {
        MarketplaceCatalog cat = MarketplaceView.Cat();
        if (cat == null || cat.Loading() || MarketplaceInstall.Busy()) { return; }
        MarketplacePackage package = cat.SelectedPackage();
        if (package == null) { return; }
        if (!package.HasKnownPricing()) {
            cat.status = MarketplaceCatalog.T("Product pricing is unavailable.", "商品价格信息不完整。");
            return;
        }
        if (package.IsApp() || !package.IsFree()) {
            string url = MarketplaceInstall.BrowserUrl(package);
            if (url == "" || !Process.OpenUrl(url)) {
                cat.status = MarketplaceCatalog.T("Cannot open product URL.", "无法打开商品地址。");
            } else {
                cat.status = MarketplaceCatalog.T("Opened product page in your browser.", "已在浏览器打开商品页。");
            }
            return;
        }
        if (package.IsExtension() && package.LatestVersion() != null && cat.Confirm()) {
            MarketplaceWindow.SetAction(2);
        }
    }

    // 每帧把目录状态铺进控件：详情列里没有内容的行直接隐藏，于是
    // 未选中时不会留下一排空标签。子窗口按这里的首选尺寸开，所以
    // 目录表格一开始就有一屏的宽度，不是一条缝。
    override void OnMeasure(App app) {
        prefW = app.Scale(940);
        prefH = app.Scale(640);
        MarketplaceCatalog cat = MarketplaceView.Cat();
        if (cat == null) { return; }
        cat.Poll();
        this.SyncSelection(cat);
        this.Status.Text = cat.Status();
        MarketplacePackage sel = cat.SelectedPackage();
        bool has = sel != null;
        MarketplaceVersion version = null;
        if (has) { version = sel.LatestVersion(); }
        this.Name.SetShown(has);
        this.Ns.SetShown(has);
        this.Ver.SetShown(has && version != null);
        this.Paid.SetShown(has);
        pricingPlans.SetShown(has && sel.plans.Count > 0);
        bool knownPricing = has && sel.HasKnownPricing();
        bool browser = knownPricing && (sel.IsApp() || !sel.IsFree());
        this.InstallBtn.SetShown(knownPricing && !cat.Loading()
            && (browser || (sel.CanInstallFree() && version != null))
            && !MarketplaceInstall.Busy());
        if (MarketplaceInstall.Busy() && MarketplaceInstall.Progress().Length > 0) {
            this.Status.Text = MarketplaceInstall.Progress();
        }
        if (has) {
            this.Name.Text = sel.displayName;
            this.Ns.Text = sel.packageName + "\n" + sel.NamespaceLabel();
            this.Ns.SetWrap(true);
            this.Paid.Text = MarketplaceView.PriceLabel(sel);
            pricingPlans.Bind(sel.plans);
            if (version != null) {
                this.Ver.Text =
                    MarketplaceCatalog.T("Version ", "版本 ") + version.version;
            }
            if (browser) {
                this.InstallBtn.Text = sel.IsFree()
                    ? MarketplaceCatalog.T("Open download page", "打开下载页")
                    : MarketplaceCatalog.T("Purchase in browser", "到浏览器购买");
                this.InstallBtn.Icon = "external-link";
            } else if (cat.Confirming()) {
                this.InstallBtn.Icon = "download";
                this.InstallBtn.Text =
                    MarketplaceCatalog.T("Confirm install", "确认安装");
            } else {
                this.InstallBtn.Icon = "download";
                this.InstallBtn.Text =
                    MarketplaceCatalog.T("Install", "安装");
            }
        }
    }
}
