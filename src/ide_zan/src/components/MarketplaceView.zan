using System;
using Gui;
using Gui.Widget;

/// 扩展市场视图：目录表格 + 详情列 + 刷新 / 安装。
///
/// 界面在 `MarketplaceView.zform` 里声明（工具条一行、左侧详情列、
/// 右侧目录表格），目录与网络状态在 Gui 无关的 `MarketplaceCatalog`
/// 里。这里只做三件事：建表头、把这一帧的状态铺进控件、把按钮点击
/// 转成目录操作或安装意图。
/// @component Marketplace view
partial class MarketplaceView {
    /// 当前视图：按钮与列表的回调是普通函数指针，靠它找回实例。
    static MarketplaceView current;

    void OnInit() {
        MarketplaceView.current = this;
        this.RefreshBtn.SetProp("text",
            MarketplaceCatalog.T("Refresh", "刷新"));
        this.RefreshBtn.Icon = "refresh";
        this.RefreshBtn.Click.Add(MarketplaceView.Refresh);
        this.InstallBtn.Icon = "download";
        this.InstallBtn.Click.Add(MarketplaceView.Install);
        this.Paid.Text = MarketplaceCatalog.T("Purchase required",
                                                         "需要购买");
        this.Packages.WithColumns(MarketplaceView.Columns());
        this.Packages.EmptyText(
            MarketplaceCatalog.T("No extensions available.", "暂无可用扩展。"));
        this.Packages.OnSelect(MarketplaceView.Picked);
    }

    /// 目录表格的列：名称、命名空间、分类，价格右对齐。
    static List<ListColumn<MarketplacePackage>> Columns() {
        List<ListColumn<MarketplacePackage>> cols =
            new List<ListColumn<MarketplacePackage>>();
        cols.Add(new ListColumn<MarketplacePackage>(
            MarketplaceCatalog.T("Extension", "扩展"), 3,
            package => package.displayName));
        cols.Add(new ListColumn<MarketplacePackage>(
            MarketplaceCatalog.T("Namespace", "命名空间"), 2,
            package => package.packageName));
        cols.Add(new ListColumn<MarketplacePackage>(
            MarketplaceCatalog.T("Category", "分类"), 2,
            package => package.category));
        cols.Add(new ListColumn<MarketplacePackage>(
            MarketplaceCatalog.T("Price", "价格"), 1,
            package => MarketplaceCatalog.PriceLabel(package)).Right());
        return cols;
    }

    static MarketplaceCatalog Cat() { return MarketplaceCatalog.current; }

    /// 选中一行：拉这个扩展的详情。
    static void Picked() {
        MarketplaceView view = MarketplaceView.current;
        MarketplaceCatalog cat = MarketplaceView.Cat();
        if (cat == null || view == null) { return; }
        if (!view.Packages.HasSelection()) { return; }
        cat.Select(view.Packages.Selected());
    }

    static void Refresh() {
        MarketplaceCatalog cat = MarketplaceView.Cat();
        if (cat != null) { cat.Refresh(); }
    }

    /// 安装是要花钱 / 改环境的动作，所以第一次点是「请确认」，第二次
    /// 才把意图交给子窗口去装。
    static void Install() {
        MarketplaceCatalog cat = MarketplaceView.Cat();
        if (cat == null) { return; }
        if (cat.Confirm()) { MarketplaceWindow.SetAction(2); }
    }

    /// 选中行由目录持有（刷新、按名定位都会改它），每帧对齐到表格。
    void SyncSelection(MarketplaceCatalog cat) {
        this.Packages.Bind(cat.Packages());
        int row = cat.SelectedRow();
        if (row < 0) {
            this.Packages.ClearSelection();
        } else if (row != this.Packages.SelectedIndex()) {
            this.Packages.SelectIndex(row);
        }
    }

    /// 每帧把目录状态铺进控件：详情列里没有内容的行直接隐藏，于是
    /// 未选中时不会留下一排空标签。子窗口按这里的首选尺寸开，所以
    /// 目录表格一开始就有一屏的宽度，不是一条缝。
    override void OnMeasure(App app) {
        prefW = app.Scale(940);
        prefH = app.Scale(640);
        MarketplaceCatalog cat = MarketplaceView.Cat();
        if (cat == null) { return; }
        cat.Poll();
        this.SyncSelection(cat);
        this.Status.Text = cat.Status();
        MarketplacePackage sel = cat.SelectedPackage();
        bool has = sel != null;
        MarketplaceVersion version = null;
        if (has) { version = sel.LatestVersion(); }
        this.Name.SetShown(has);
        this.Ns.SetShown(has);
        this.Ver.SetShown(has && version != null);
        this.Paid.SetShown(has && !sel.IsFree());
        this.InstallBtn.SetShown(has && sel.IsFree() && version != null);
        if (has) {
            this.Name.Text = sel.displayName;
            this.Ns.Text = sel.packageName;
            if (version != null) {
                this.Ver.Text =
                    MarketplaceCatalog.T("Version ", "版本 ") + version.version;
            }
            if (cat.Confirming()) {
                this.InstallBtn.Text =
                    MarketplaceCatalog.T("Confirm install", "确认安装");
            } else {
                this.InstallBtn.Text =
                    MarketplaceCatalog.T("Install", "安装");
            }
        }
    }
}
