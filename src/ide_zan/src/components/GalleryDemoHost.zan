using System;
using System.Collections.Generic;
using Gui;
using Gui.Widget;

// 组件画廊中即时渲染型标准库组件的宿主控件：Alert、Tooltip、Table、DataTable、PivotView、Menu、Ribbon、Scrollbar、Chart、Ellipsis
public class GalleryDemoHost : Control {
    // 组件名，与文档主题标题一致
    string demo;
    // 逻辑高度
    int logHeight;
    // PivotView 演示的保留状态
    DataTableState pivotState;
    List<DataColumn> pivotCols;
    RowListSource pivotSrc;

    GalleryDemoHost(string name, int h) {
        this.InitControl("GalleryDemoHost", 1);
        demo = name;
        logHeight = h;
    }

    // 演示数据：6 个区域 × 4 个季度
    List<DataRow> PivotDemoRows() {
        List<string> regions = new List<string>{
            "North", "South", "East", "West", "Central", "Overseas" };
        List<string> quarters = new List<string>{ "Q1", "Q2", "Q3", "Q4" };
        List<DataRow> rows = new List<DataRow>();
        int seed = 7;
        for (int r = 0; r < regions.Count; r = r + 1) {
            for (int q = 0; q < quarters.Count; q = q + 1) {
                seed = (seed * 31 + 17) % 997;
                int units = seed % 90 + 10;
                DataRow d = new DataRow();
                d.Push(regions[r]);
                d.Push(quarters[q]);
                d.Push(Convert.ToString(units));
                d.Push(Convert.ToString(units * 137 + seed % 53));
                rows.Add(d);
            }
        }
        return rows;
    }

    override string Kind() { return "GalleryDemoHost"; }

    override void OnMeasure(App app) {
        prefH = app.Scale(logHeight);
    }

    override void OnPaint(App app) {
        Theme t = app.theme;
        if (demo == "Alert") {
            Layer.DrawNotify(app, bx, by, bw,
                ZanIDE.T("Build succeeded — the executable is ready.",
                         "构建成功 — 可执行文件已准备就绪。"), 3);
        } else if (demo == "Tooltip") {
            Tooltip.Render(app, bx, by,
                ZanIDE.T("Helpful context", "辅助说明"));
        } else if (demo == "Table") {
            List<string> columns = new List<string>{ "Name", "Status" };
            List<int> widths = new List<int>{ bw / 2, bw / 2 };
            Table.RenderHeader(app, bx, by, columns, widths);
            List<string> cells = new List<string>{ "Zan", "Ready" };
            Table.RenderRow(app, bx, by + t.heightMedium, cells, widths, true);
        } else if (demo == "DataTable") {
            List<DataColumn> cols = new List<DataColumn>{
                DataColumn.Text("Name", bw / 2),
                DataColumn.Numeric("Score", bw / 3) };
            List<DataRow> rows = new List<DataRow>();
            DataRow row = new DataRow();
            row.Push("Zan"); row.Push("98"); rows.Add(row);
            DataTableState state = new DataTableState();
            DataTable.Render(app, bx, by, bw, bh, cols, rows, state);
        } else if (demo == "PivotView") {
            if (pivotState == null) {
                pivotCols = new List<DataColumn>();
                pivotCols.Add(DataColumn.Field(new DataColumn("Region", 90), "region"));
                pivotCols.Add(DataColumn.Field(new DataColumn("Quarter", 70), "quarter"));
                pivotCols.Add(DataColumn.Field(DataColumn.Numeric("Units", 70), "units"));
                pivotCols.Add(DataColumn.Field(DataColumn.Numeric("Revenue", 90), "revenue"));
                pivotSrc = new RowListSource(PivotDemoRows());
                pivotState = new DataTableState();
                DataTable.SetPivot(pivotState, pivotCols, pivotSrc, 0, 1, 2, 0);
            }
            DataTable.RenderSource(app, bx, by, bw, bh, pivotCols, pivotSrc, pivotState);
        } else if (demo == "Menu") {
            List<string> items = new List<string>{ "Overview", "Settings" };
            SignalInt sel = DocsPreviewHost.DemoInt();
            int id = Menu.RenderVertical(app, bx, by, bw, by + bh,
                t.heightLarge, items, sel, 0);
            Menu.HandleClick(app, id, items.Count, sel);
        } else if (demo == "Ribbon") {
            List<RibbonCmd> commands = new List<RibbonCmd>{
                RibbonCmd.Group("play", "Run"), new RibbonCmd("build", "Build") };
            Ribbon.Render(app, bx, by, bw, Ribbon.Height(app), commands);
        } else if (demo == "Scrollbar") {
            StyleBox sb = Style.Of(app, "panel", "", Style.SNormal());
            sb.Paint(app, bx, by, bw, bh);
            Scrollbar.RenderVertical(app, bx + bw - app.Scale(10), by, bh,
                bh * 4, bh);
        } else if (demo == "Chart") {
            List<string> labels = new List<string>{ "Q1", "Q2", "Q3", "Q4" };
            List<int> values = new List<int>{ 12, 28, 20, 35 };
            ChartOption opt = ChartOption.With(ChartType.Line, "", labels);
            opt.Add("Series", values);
            ChartView.Of(opt).Render(app, bx, by, bw, bh);
        } else if (demo == "Ellipsis") {
            Ellipsis.Render(app, bx, by, bw, ZanIDE.T(
                "A very long component example that must fit the available width",
                "一个必须适应可用宽度的超长组件示例"));
        }
    }
}
