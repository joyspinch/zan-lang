using System;
using System.Collections.Generic;
using Gui;
using Gui.Widget;

// 组件画廊中即时渲染型标准库组件的宿主控件：Alert、Tooltip、Table、DataTable、PivotView、Menu、Ribbon、Scrollbar、Chart、Ellipsis
public class GalleryDemoHost : Control {
    // 组件名，与文档主题标题一致
    string demo;
    // 逻辑高度
    int logHeight;
    // PivotView 演示的保留状态
    DataTableState pivotState;
    List<DataColumn> pivotCols;
    RowListSource pivotSrc;
    Ribbon ribbon;
    ChartView chartView;
    AlertBox alertPreview;
    DataTableControl tableView;

    GalleryDemoHost(string name, int h) {
        this.InitControl("GalleryDemoHost", 1);
        demo = name;
        logHeight = h;
        if (name == "Ribbon") { this.InitializeRibbon(); }
        if (name == "DataTable" || name == "PivotView") { this.InitializeTable(); }
        if (name == "Alert") {
            alertPreview = new AlertBox(ZanIDE.T("Build succeeded — the executable is ready.",
            "构建成功 — 可执行文件已准备就绪。"));
            alertPreview.SetType(1);
            this.Add(alertPreview);
        }
        if (name == "Chart") {
            List<string> labels = new List<string>{ "Q1", "Q2", "Q3", "Q4" };
            List<int> values = new List<int>{ 12, 28, 20, 35 };
            ChartOption opt = ChartOption.With(ChartType.Line, "", labels);
            opt.Add("Series", values);
            chartView = ChartView.KeyedStatic(opt, 700101);
            this.Add(chartView);
        }
        if (name == "Menu") {
            List<string> items = new List<string>{ "Overview", "Settings" };
            this.Add(new Menu(items, DocsPreviewHost.DemoInt()));
        }
    }

    void InitializeRibbon() {
        this.SetProp("style", "display:flex;flex-direction:column;overflow:hidden;");
        ribbon = new Ribbon();
        ribbon.SetProp("style", "flex-shrink:0;");
        ribbon.AddCommand(RibbonCmd.Group("play", "Run"));
        ribbon.AddCommand(new RibbonCmd("build", "Build"));
        // A real child shares the host's layout, input clip and retirement lifetime.
        this.Add(ribbon);
    }

    void InitializeTable() {
        this.SetProp("style", "display:flex;flex-direction:column;overflow:hidden;");
        pivotCols = new List<DataColumn>();
        pivotState = new DataTableState();
        if (demo == "DataTable") {
            pivotCols.Add(DataColumn.Text("Name", 140));
            pivotCols.Add(DataColumn.Numeric("Score", 100));
            List<DataRow> rows = new List<DataRow>();
            DataRow row = new DataRow();
            row.Push("Zan"); row.Push("98"); rows.Add(row);
            pivotSrc = new RowListSource(rows);
        } else {
            pivotCols.Add(DataColumn.Field(new DataColumn("Region", 90), "region"));
            pivotCols.Add(DataColumn.Field(new DataColumn("Quarter", 70), "quarter"));
            pivotCols.Add(DataColumn.Field(DataColumn.Numeric("Units", 70), "units"));
            pivotCols.Add(DataColumn.Field(DataColumn.Numeric("Revenue", 90), "revenue"));
            pivotSrc = new RowListSource(this.PivotDemoRows());
            DataTable.SetPivot(pivotState, pivotCols, pivotSrc, 0, 1, 2, 0);
        }
        tableView = new DataTableControl(pivotCols, pivotSrc, pivotState);
        tableView.SetProp("style", "flex:1;min-width:0;min-height:0;");
        this.Add(tableView);
    }

    // 演示数据：6 个区域 × 4 个季度
    List<DataRow> PivotDemoRows() {
        List<string> regions = new List<string>{
            "North", "South", "East", "West", "Central", "Overseas" };
            List<string> quarters = new List<string>{ "Q1", "Q2", "Q3", "Q4" };
            List<DataRow> rows = new List<DataRow>();
            int seed = 7;
            for (int r = 0; r < regions.Count; r = r + 1) {
                for (int q = 0; q < quarters.Count; q = q + 1) {
                    seed = (seed * 31 + 17) % 997;
                    int units = seed % 90 + 10;
                    DataRow d = new DataRow();
                    d.Push(regions[r]);
                    d.Push(quarters[q]);
                    d.Push(Convert.ToString(units));
                    d.Push(Convert.ToString(units * 137 + seed % 53));
                    rows.Add(d);
                }
            }
            return rows;
        }

        override void OnMeasure(App app) {
            prefH = app.Scale(logHeight);
        }

        override void OnPaint(App app) {
            Theme t = app.theme;
            if (demo == "Alert") {
                // AlertPreview is a retained child added by the constructor.
            } else if (demo == "Tooltip") {
                Tooltip.RequestBox(app, bx, by, bw, bh,
                ZanIDE.T("Helpful context", "辅助说明"), Tooltip.Bottom(), bw);
            } else if (demo == "Table") {
                Table tbl = new Table();
                TableRow head = new TableRow(true);
                head.AddCell("Name", bw / 2);
                head.AddCell("Status", bw / 2);
                tbl.AddRow(head);
                TableRow r = new TableRow(false);
                r.SetStriped(true);
                r.AddCell("Zan", bw / 2);
                r.AddCell("Ready", bw / 2);
                tbl.AddRow(r);
                tbl.Arrange(bx, by, bw, t.heightMedium * 2);
                tbl.RenderTree(app);
            } else if (demo == "DataTable" || demo == "PivotView") {
                // Persistent children prepare their layout and input with the gallery tree.
            } else if (demo == "Scrollbar") {
                StyleBox sb = Style.Of(app, "panel", "", Style.SNormal());
                sb.Paint(app, bx, by, bw, bh);
                Scrollbar.RenderVertical(app, bx + bw - app.Scale(10), by, bh,
                bh * 4, bh);
            } else if (demo == "Chart") {
                chartView.Arrange(bx, by, bw, bh);
            } else if (demo == "Ellipsis") {
                string txt = Ellipsis.Fit(ZanIDE.T(
                "A very long component example that must fit the available width",
                "一个必须适应可用宽度的超长组件示例"), bw, t.fontSizeMedium);
                Label lbl = new Label(txt);
                lbl.Arrange(bx, by, bw, t.heightMedium);
                lbl.RenderTree(app);
            }
        }
    }
