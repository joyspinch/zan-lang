using System;
using Gui;

/// IDE 自有组件的运行期注册入口（与 ControlBootstrap/CefBootstrap
/// 同一契约：先注册后可用）。声明式页面（DocsView/MarketplaceView/
/// AssetPanel 等 .html）按 kind 字符串经 ControlFactory 建树，这里把
/// 每个 IDE 自有组件的工厂挂进 HeavyControls——不注册的 kind 显式
/// 失败（节点为 null），拼错的名字不会静默变型。
///
/// 取代了旧的生成注册表（scan_components.ps1 产出的
/// ProjectComponents.ide.zan）：那张表把 `new DocsSectionTabs()` 这样的
/// 活标识符写进一个游离文件，一旦被无关编译（工具面板运行、命名空间
/// 本地解析捞到 build 残留）带上就是八个 undefined type；改为显式注册
/// 后，组件类与注册始终同在 IDE 源码集里，编译图不再依赖构建期生成物。
class IdeBootstrap {
    static bool installed;

    /// 注册 IDE 自有组件的全部 kind（幂等）。ZanIDE.Startup 在各
    /// Bootstrap.Install() 之后调用一次；页面加载都发生在其后。
    static void Install() {
        if (installed) { return; }
        installed = true;
        HeavyControls.Register("DocsSectionTabs", MakeDocsSectionTabs);
        HeavyControls.Register("DocsSearchHost", MakeDocsSearchHost);
        HeavyControls.Register("DocsTopicList", MakeDocsTopicList);
        HeavyControls.Register("DocsTagHost", MakeDocsTagHost);
        HeavyControls.Register("DocsPreviewHost", MakeDocsPreviewHost);
        HeavyControls.Register("DocsCodeBlockHost", MakeDocsCodeBlockHost);
        HeavyControls.Register("MarketplaceView", MakeMarketplaceView);
        HeavyControls.Register("AssetPanel", MakeAssetPanel);
    }

    static Control MakeDocsSectionTabs(string kind) { return new DocsSectionTabs(); }
    static Control MakeDocsSearchHost(string kind) { return new DocsSearchHost(); }
    static Control MakeDocsTopicList(string kind) { return new DocsTopicList(); }
    static Control MakeDocsTagHost(string kind) { return new DocsTagHost(); }
    static Control MakeDocsPreviewHost(string kind) { return new DocsPreviewHost(); }
    static Control MakeDocsCodeBlockHost(string kind) { return new DocsCodeBlockHost(); }
    static Control MakeMarketplaceView(string kind) { return new MarketplaceView(); }
    static Control MakeAssetPanel(string kind) { return new AssetPanel(); }
}
