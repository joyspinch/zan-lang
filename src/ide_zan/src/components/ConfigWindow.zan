using System;
using System.Json;
using Gui;

/// The Project window: everything about the project itself, in two tabs of one
/// window instead of two windows that had to hand off to each other -- the
/// application icon and the resource summary, and the Asset Manager. Rendered
/// through the shared WindowShell so it matches every other IDE window (same
/// themed background, title bar and close button).
class ConfigWindow : ChildWindow {
    string root;
    List<string> log;
    int lang;           // 0 English, 1 Chinese
    int tab;            // 0 configuration, 1 assets
    JsonValue model;
    static bool done;
    static bool choose;
    static bool clear;

    static string T(int lang, string en, string zh) {
        if (lang == 1) { return zh; }
        return en;
    }

    static void OnDone() { ConfigWindow.done = true; }
    static void OnChoose() { ConfigWindow.choose = true; }
    static void OnClear() { ConfigWindow.clear = true; }

    /// The configuration tab: application icon plus a summary of what the
    /// project carries as resources.
    static UiNode ConfigTab(int lang, string root) {
        string projName = Path.GetFileName(root);
        string curIco = ZanIDE.ProjField(root, "icon");
        string icoLabel = curIco;
        if (icoLabel == "") {
            icoLabel = ConfigWindow.T(lang,
                "(none — the default Zan icon is used)",
                "（无——使用默认 Zan 图标）");
        }
        List<string> res = ZanIDE.ListResources(root);
        List<string> lnks = ZanIDE.ProjLinks(root);
        string counts = Convert.ToString(res.Count)
            + ConfigWindow.T(lang, " copied asset(s), ", " 个复制资源，")
            + Convert.ToString(lnks.Count)
            + ConfigWindow.T(lang, " linked", " 个链接资源");

        UiNode inner = UiNode.Column().Dock("fill").Pad(16).Gap(6);
        inner.Child(UiNode.Label(projName)
            .Class("secondary small").Dock("top").Height(20));
        inner.Child(UiNode.Label(ConfigWindow.T(lang,
            "Application Icon", "应用图标"))
            .Class("secondary small").Dock("top").Height(20));
        inner.Child(UiNode.Label(icoLabel)
            .Class("small").Dock("top").Height(20));
        UiNode iconRow = UiNode.Row().Dock("top").Height(34).Gap(8);
        iconRow.Child(UiNode.Button(ConfigWindow.T(lang,
            "Choose .ico...", "选择 .ico..."))
            .OnClick("choose").Class("primary small").Dock("left").Width(130));
        iconRow.Child(UiNode.Button(ConfigWindow.T(lang, "Clear", "清除"))
            .OnClick("clear").Class("small").Dock("left").Width(70));
        inner.Child(iconRow);

        inner.Child(UiNode.Label(ConfigWindow.T(lang, "Resources", "资源"))
            .Class("secondary small").Dock("top").Height(20));
        inner.Child(UiNode.Label(counts).Dock("top").Height(22));
        inner.Child(UiNode.Label(ConfigWindow.T(lang,
            "The Assets tab imports files/folders, links resources, chooses embed",
            "「资源」标签页可导入文件/文件夹、链接资源、选择嵌入或复制，"))
            .Class("secondary small").Dock("top").Height(16));
        inner.Child(UiNode.Label(ConfigWindow.T(lang,
            "vs copy, and authors 8-direction / frame-sequence animations.",
            "并编辑八方向 / 序列帧动画。"))
            .Class("secondary small").Dock("top").Height(16));

        // ---- theme skin packaging for the built app --------------------
        // Whether the produced GUI app ships the top-right skin picker's packs
        // (each is copied next to the exe). Off keeps the exe small; the full
        // set is ~640KB, mostly banner art.
        inner.Child(UiNode.Label(ConfigWindow.T(lang, "Skins / Themes", "皮肤 / 主题"))
            .Class("secondary small").Dock("top").Height(20));
        inner.Child(UiNode.Of("Checkbox").Text(ConfigWindow.T(lang,
            "Package skins with the built app (top-right skin picker)",
            "把皮肤打包进生成的应用（右上角皮肤切换）"))
            .Dock("top").Height(26).Bind("skins"));
        inner.Child(UiNode.Label(ConfigWindow.T(lang,
            "Off = smallest exe (base theme only). Tick the packs to bundle:",
            "关闭 = 最小体积（仅基础主题）。勾选要打包的皮肤："))
            .Class("secondary small").Dock("top").Height(16));
        UiNode skinList = UiNode.Of("ScrollColumn").Dock("fill").Gap(2);
        List<string> skins = ZanIDE.AvailableSkinNames();
        for (int si = 0; si < skins.Count; si = si + 1) {
            skinList.Child(UiNode.Of("Checkbox").Text(skins[si])
                .Dock("top").Height(24).Bind("skin_" + skins[si]));
        }
        inner.Child(skinList);

        UiNode doneRow = UiNode.Row().Dock("bottom").Height(40).Gap(10);
        doneRow.Child(UiNode.Button(ConfigWindow.T(lang, "Done", "完成"))
            .OnClick("done").Class("primary").Dock("right").Width(110));
        inner.Child(doneRow);
        inner.Child(UiNode.Label(ConfigWindow.T(lang,
            "Resources are copied next to the published .exe (publish/assets).",
            "资源会复制到发布的 .exe 旁（publish/assets）。"))
            .Class("secondary small").Dock("bottom").Height(16));
        inner.Child(UiNode.Label(ConfigWindow.T(lang,
            "The icon is embedded into the .exe on Build/Run/Publish.",
            "图标会在 构建/运行/发布 时嵌入 .exe。"))
            .Class("secondary small").Dock("bottom").Height(16));
        return inner;
    }

    static UiNode Doc(int lang, string root, int tab) {
        UiNode page = UiNode.Column().Dock("fill").Pad(0).Gap(0);
        UiNode tabs = UiNode.Row().Dock("top").Height(38).Pad(8).Gap(8);
        tabs.Child(UiNode.Of("Radio").Num("option", 0)
            .Str("label", ConfigWindow.T(lang, "Configuration", "配置"))
            .Dock("left").Width(120).Bind("tab"));
        tabs.Child(UiNode.Of("Radio").Num("option", 1)
            .Str("label", ConfigWindow.T(lang, "Assets", "资源"))
            .Dock("left").Width(120).Bind("tab"));
        page.Child(tabs);
        if (tab == 1) {
            page.Child(UiNode.Of("AssetManagerView").Dock("fill"));
        } else {
            page.Child(ConfigWindow.ConfigTab(lang, root));
        }

        UiNode root = UiNode.Of("Panel").Dock("fill");
        root.Child(page);
        return root;
    }

    override void OnCloseRequested() { ConfigWindow.OnDone(); }

    void BuildUi() {
        this.SetRoot(ConfigWindow.Doc(lang, root, tab).Root(), model);
        this.Handle("done", ConfigWindow.OnDone);
        this.Handle("choose", ConfigWindow.OnChoose);
        this.Handle("clear", ConfigWindow.OnClear);
        this.Wire();
    }

    static ConfigWindow Open(App parent, string root, List<string> log,
                             int uiLang, int tab) {
        ConfigWindow w = new ConfigWindow();
        w.root = root;
        w.log = log;
        w.lang = uiLang;
        w.tab = tab;
        w.open = true;
        ConfigWindow.done = false;
        ConfigWindow.choose = false;
        ConfigWindow.clear = false;
        AssetManager.BindView(root, log, uiLang);
        w.model = JsonValue.NewObject();
        w.model.Set("tab", JsonValue.NewNum(Convert.ToString(tab)));
        // Skin packaging: reflect the saved zan.proj settings into the model so
        // the toggle and per-skin checkboxes come up matching the project.
        string skinsOn = "0";
        if (ZanIDE.ProjSkinsEnabled(root)) { skinsOn = "1"; }
        w.model.Set("skins", JsonValue.NewStr(skinsOn));
        List<string> avail = ZanIDE.AvailableSkinNames();
        List<string> chosen = ZanIDE.ProjSkinList(root);
        for (int i = 0; i < avail.Count; i = i + 1) {
            string v = "0";
            for (int j = 0; j < chosen.Count; j = j + 1) {
                if (chosen[j] == avail[i]) { v = "1"; }
            }
            w.model.Set("skin_" + avail[i], JsonValue.NewStr(v));
        }
        w.BuildUi();
        w.OpenHost(parent);
        return w;
    }

    override string Title() {
        return ConfigWindow.T(lang, "Project", "项目配置");
    }

    override int Width() { return 900; }
    override int Height() { return 680; }
    override int IdBase() { return 870000; }

    override bool Pending() {
        return ConfigWindow.done || ConfigWindow.choose
            || ConfigWindow.clear || AssetManager.viewAction != 0;
    }

    /// Rebuilds the document when a displayed value (icon path / counts) or the
    /// selected tab changes.
    void Rebuild() {
        this.BuildUi();
        if (open) { host.RequestRedraw(); }
    }

    override void AfterFrame() {
        if (ConfigWindow.clear) {
            ConfigWindow.clear = false;
            ZanIDE.SetProjectIcon(root, "");
            log.Add("> App icon cleared (default icon will be used).");
            this.Rebuild();
        }
        // The tab strip is a bound selector, so the switch shows up as a model
        // change rather than as an action: the page is rebuilt for the tab the
        // segments now agree on.
        int picked = model.Int("tab", tab);
        if (picked != tab) {
            tab = picked;
            this.Rebuild();
        }
        this.SyncSkins();
    }

    /// Writes the skin-packaging toggle and per-skin checkboxes back to
    /// zan.proj (`skins` + `skinlist`), only when they actually changed.
    void SyncSkins() {
        string enabled = "0";
        string mv = model.PathGet("skins").AsString("0");
        if (mv == "1" || mv == "true") { enabled = "1"; }
        if (ZanIDE.ProjField(root, "skins") != enabled) {
            ZanIDE.SetProjField(root, "skins", enabled);
        }
        List<string> avail = ZanIDE.AvailableSkinNames();
        string list = "";
        for (int i = 0; i < avail.Count; i = i + 1) {
            string v = model.PathGet("skin_" + avail[i]).AsString("0");
            if (v == "1" || v == "true") {
                if (list != "") { list = list + ","; }
                list = list + avail[i];
            }
        }
        if (ZanIDE.ProjField(root, "skinlist") != list) {
            ZanIDE.SetProjField(root, "skinlist", list);
        }
    }

    /// True once the user pressed Done or the shell close button.
    bool TakeDone() {
        if (ConfigWindow.done) {
            ConfigWindow.done = false;
            open = false;
            return true;
        }
        return false;
    }

    /// True once the user pressed "Choose .ico..." (opens the file picker).
    bool TakeChoose() {
        if (ConfigWindow.choose) {
            ConfigWindow.choose = false;
            return true;
        }
        return false;
    }

    /// What the Asset Manager tab asked for on its last paint (0 none,
    /// 2 import file, 3 import folder, 4 link resource); 1 (its own close
    /// button) closes the window.
    int TakeAssetAction() {
        return AssetManager.TakeAction();
    }
}
