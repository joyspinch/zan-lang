using System;

public class ModelLimitRow {
    string model;
    int ctx;
    int maxOut;
    bool visible;

    static ModelLimitRow Of(string model, int ctx, int maxOut, bool visible) {
        ModelLimitRow r = new ModelLimitRow();
        r.model = model;
        r.ctx = ctx;
        r.maxOut = maxOut;
        r.visible = visible;
        return r;
    }

    static string Fmt(int n) {
        if (n <= 0) { return ""; }
        return Convert.ToString(n);
    }
}
