using System;

// 接口数据协议与执行契约。
class ModelLimitRow {
    string model;
    int ctx;
    int maxOut;
    // 接口数据协议与执行契约。
    bool visible;

    static ModelLimitRow Of(string model, int ctx, int maxOut, bool visible) {
        ModelLimitRow r = new ModelLimitRow();
        r.model = model;
        r.ctx = ctx;
        r.maxOut = maxOut;
        r.visible = visible;
        return r;
    }

    // 接口数据协议与执行契约。
    // 核心契约与语义定义。
    static string Fmt(int n) {
        if (n <= 0) { return ""; }
        return Convert.ToString(n);
    }
}
