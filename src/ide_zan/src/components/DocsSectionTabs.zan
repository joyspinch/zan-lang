using System;
using Gui;
using Gui.Widget;

[GuiKind("DocsSectionTabs")]
public class DocsSectionTabs : Control {
    public override Control CreateCloneShell() { return new DocsSectionTabs(); }

    static Binding<int> sel;
    static List<string> labels;
    Tabs strip;
    List<string> shownLabels;

    static Binding<int> Sel() {
        if (DocsSectionTabs.sel == null) { DocsSectionTabs.sel = 0; }
        return DocsSectionTabs.sel;
    }

    static void Sections(List<string> values) { DocsSectionTabs.labels = values; }

    public DocsSectionTabs() {
        this.InitControl("DocsSectionTabs");
        strip = Tabs.CreateVertical(Tabs.Line());
        strip.Grow();
        DocsSectionTabEvents relay = new DocsSectionTabEvents();
        relay.owner = this;
        strip.TabChanged.AddS(relay.Changed);
        this.Add(strip);
    }

    void Changed(Control sender) {
        if (sender != strip || !this.StyleVisible() || this.IsDisabled()) { return; }
        DocsSectionTabs.Sel().Set(strip.Active());
    }

    override string Kind() { return "DocsSectionTabs"; }

    override void OnMeasure(App app) {
        List<string> values = DocsSectionTabs.labels;
        if (values != null && !ZanIDE.StringListsEqual(shownLabels, values)) {
            strip.Clear();
            for (int i = 0; i < values.Count; i = i + 1) { strip.Add(values[i], false); }
            shownLabels = values;
            strip.MeasureTree(app);
        }
        strip.Select(DocsSectionTabs.Sel().Get());
        prefW = strip.prefW;
        prefH = strip.prefH;
    }
}
