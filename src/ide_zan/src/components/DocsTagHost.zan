using System;
using Gui;
using Gui.Widget;
using Gui.Backend;
using Gui.Component.CodeEditor;

[GuiKind("DocsTagHost")]
public class DocsTagHost : Control {
    public override Control CreateCloneShell() { return new DocsTagHost(); }

    static Tag chip;

    static Tag Chip() {
        if (DocsTagHost.chip == null) {
            Tag t = new Tag("");
            t.SetProp("style", "flex-shrink:0");
            DocsTagHost.chip = t;
        }
        return DocsTagHost.chip;
    }

    static void Show(string text, string cls) {
        Tag t = DocsTagHost.Chip();
        t.Text = text;
        t.Class = cls;
    }

    public DocsTagHost() {
        this.InitControl("DocsTagHost");
        this.Add(DocsTagHost.Chip());
    }

    override string Kind() { return "DocsTagHost"; }

    override void OnMeasure(App app) {
        prefH = DocsTagHost.Chip().prefH;
    }
}
