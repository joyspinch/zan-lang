using System;
using Gui;
using Gui.Widget;
using Gui.Backend;
using Gui.Component.CodeEditor;

public class DocsTagHost : Control {

    // 组件自注册（B-ID44 约定）：注册表由 gen_design_halves.py 扫描
    // 文档引用自动生成，这里声明自己的工厂；重复注册以最后一次为准。
    public static void Install() {
        Gui.HeavyControls.Register("DocsTagHost", (string k) => new DocsTagHost());
    }

    static Tag chip;

    static Tag Chip() {
        if (DocsTagHost.chip == null) {
            Tag t = new Tag("");
            t.dock = 3;
            DocsTagHost.chip = t;
        }
        return DocsTagHost.chip;
    }

    static void Show(string text, string cls) {
        Tag t = DocsTagHost.Chip();
        t.Text = text;
        t.Class = cls;
    }

    DocsTagHost() {
        this.InitControl("DocsTagHost", 1);
        this.Add(DocsTagHost.Chip());
    }

    override string Kind() { return "DocsTagHost"; }

    override void OnMeasure(App app) {
        prefH = DocsTagHost.Chip().prefH;
    }
}
