// 项目新建向导与模板展示实体
public class Tpl {
    string cat;
    string name;
    string icon;
    string desc;
    string kind;
    string src;
    int order;
    string ptype;
    string ptarget;  // zan.proj target (exe/dll)
    string pentry;   // zan.proj entry
    bool sizeable;
    int defW;
    int defH;
    bool round;
    string preview;  // absolute path of a real screenshot, "" when none
    string sketch;   // wireframe tokens, see Wizard.RenderSketch
    string device;
    string caps;
    string platforms;

    static Tpl Make(string cat, string name, string icon, string kind, string desc) {
        Tpl t = new Tpl();
        t.cat = cat;
        t.name = name;
        t.icon = icon;
        t.kind = kind;
        t.desc = desc;
        t.src = "";
        t.order = 1000;
        t.ptype = "console";
        t.ptarget = "exe";
        t.pentry = "src/main.zan";
        t.sizeable = false;
        t.defW = 0;
        t.defH = 0;
        t.round = false;
        t.preview = "";
        t.sketch = "";
        t.device = "";
        t.caps = "";
        t.platforms = "";
        return t;
    }
}
