using System;
using System.IO;
using System.Diagnostics;
using System.Json;
using Gui;
using Gui.Widget;
using Game.Scene;

class DbgFrame {
    string name;
    int line;

    static DbgFrame Create(string name, int line) {
        DbgFrame f = new DbgFrame();
        f.name = name;
        f.line = line;
        return f;
    }
}
