using Gui.Designer;
using Game.Scene;

// Published once on the UI thread. The worker owns options and only reads the
// persistent form/scene baselines; it never receives a document, tab or control.
public class IdeDesignLoadSnapshot {
    int mode;
    string path;
    string body;
    string project;
    bool html;
    bool scenePath;
    DesignerDocumentSnapshot options;
    DesignerDocumentSnapshot form;
    SceneDoc scene;
}
