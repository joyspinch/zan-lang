using System;
using System.IO;
using System.Diagnostics;
using System.Json;
using Game.Scene;

public class DbgBreakpoint {
    int line;
    string cond;

    static DbgBreakpoint Create(int line, string cond) {
        DbgBreakpoint b = new DbgBreakpoint();
        b.line = line;
        b.cond = cond;
        return b;
    }
}
