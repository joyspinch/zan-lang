using System;
using System.IO;
using System.Threading;

public class IdeDocumentWrite {
    string path;
    string text;
    int sequence;
    IdeDocumentDiskInput input;

    static IdeDocumentWrite Create(string path, string text) {
        IdeDocumentWrite write = new IdeDocumentWrite();
        write.path = path;
        write.text = text;
        return write;
    }
}
