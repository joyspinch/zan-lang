using System;
using System.Text;
using System.Collections.Generic;
using System.Json;

// 团队内部信令信封
public class AiEnvelope {
    public List<string> to;
    public string kind;
    public string taskId;
    public int progress;
    public string body;

    static AiEnvelope Create() {
        AiEnvelope e = new AiEnvelope();
        e.to = new List<string>();
        e.kind = "";
        e.taskId = "";
        e.progress = 0;
        e.body = "";
        return e;
    }
}
