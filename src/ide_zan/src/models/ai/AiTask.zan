using System;
using System.Text;
using System.Collections.Generic;
using System.Json;

// 团队协作任务实体（依赖图节点与执行产出）
public class AiTask {
    public string id;
    public string title;
    public string owner;
    public int state;
    public int progress;
    public string accept;
    public List<string> deps;
    public List<AiTaskPart> parts;
    public string outcome;
    public List<AiPlanStep> items;

    static AiTask Create(string id, string title, string owner) {
        AiTask t = new AiTask();
        t.id = id;
        t.title = title;
        t.owner = owner;
        t.state = 0;
        t.progress = 0;
        t.accept = "";
        t.deps = new List<string>();
        t.parts = new List<AiTaskPart>();
        t.outcome = "";
        t.items = new List<AiPlanStep>();
        return t;
    }
}
