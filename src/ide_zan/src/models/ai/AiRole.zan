using System;
using System.Text;
using System.Collections.Generic;
using System.Json;

// AI 团队角色元数据
public class AiRole {
    public string id;
    public string en;
    public string zh;
    public string next;
    public string duty;
    public int tint;

    static AiRole Create(string id, string en, string zh, string next,
            string duty, int tint) {
        AiRole r = new AiRole();
        r.id = id;
        r.en = en;
        r.zh = zh;
        r.next = next;
        r.duty = duty;
        r.tint = tint;
        return r;
    }
}
