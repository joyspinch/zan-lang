using System;

public class AiRunStatus {
    static int Pending() { return 0; }
    static int Running() { return 1; }
    static int Done() { return 2; }
    static int Failed() { return 3; }
    static int Skipped() { return 4; }
    static int Blocked() { return 5; }

    static string Id(int st) {
        if (st == 0) { return "pending"; }
        if (st == 1) { return "running"; }
        if (st == 2) { return "done"; }
        if (st == 3) { return "failed"; }
        if (st == 4) { return "skipped"; }
        if (st == 5) { return "blocked"; }
        return "unknown";
    }

    static string Mark(int st) {
        if (st == 1) { return "…"; }
        if (st == 2) { return "✓"; }
        if (st == 3) { return "✗"; }
        if (st == 4) { return "»"; }
        if (st == 5) { return "?"; }
        return "·";
    }
}
