using System;

public class AiFault {
    static int None() { return 0; }
    static int Compile() { return 1; }
    static int Test() { return 2; }
    static int Runtime() { return 3; }
    static int Ui() { return 4; }
    static int Io() { return 5; }
    static int Network() { return 6; }
    static int Config() { return 7; }
    static int Cancelled() { return 8; }
    static int Internal() { return 9; }

    static string Id(int cls) {
        if (cls == 0) { return "none"; }
        if (cls == 1) { return "compile"; }
        if (cls == 2) { return "test"; }
        if (cls == 3) { return "runtime"; }
        if (cls == 4) { return "ui"; }
        if (cls == 5) { return "io"; }
        if (cls == 6) { return "network"; }
        if (cls == 7) { return "config"; }
        if (cls == 8) { return "cancelled"; }
        if (cls == 9) { return "internal"; }
        return "unknown";
    }

    static string Zh(int cls) {
        if (cls == 0) { return "无"; }
        if (cls == 1) { return "编译错误"; }
        if (cls == 2) { return "测试失败"; }
        if (cls == 3) { return "运行异常"; }
        if (cls == 4) { return "界面验证失败"; }
        if (cls == 5) { return "文件/IO 错误"; }
        if (cls == 6) { return "网络错误"; }
        if (cls == 7) { return "配置缺失"; }
        if (cls == 8) { return "已取消"; }
        if (cls == 9) { return "内部错误"; }
        return "未知错误";
    }

    // 自动重试是否有意义。配置缺失要人补、取消是人的决定，重试只会刷屏。
    static bool Retryable(int cls) {
        return cls == AiFault.Network() || cls == AiFault.Io()
            || cls == AiFault.Internal();
    }

    // 走「定位根因再重验」回环的故障（代码问题，不是环境问题）。
    static bool Repairable(int cls) {
        return cls == AiFault.Compile() || cls == AiFault.Test()
            || cls == AiFault.Runtime() || cls == AiFault.Ui();
    }

    // 子串包含。
    static bool Has(string hay, string needle) {
        if (hay == null || needle == null) { return false; }
        if (needle.Length == 0) { return true; }
        return hay.IndexOf(needle) >= 0;
    }

    // 小写化。
    static string Lower(string s) {
        if (s == null) { return ""; }
        return s.ToLower();
    }

    // 从错误文本粗分类。宁可落到 `Internal` 也不要猜成 `Config`：分错成不可
    // 重试会让本来能自愈的一步停下来等人。
    static int Classify(string message) {
        if (message == "") { return AiFault.None(); }
        string m = AiFault.Lower(message);
        if (AiFault.Has(m, "cancel") || AiFault.Has(m, "aborted")
            || AiFault.Has(m, "已取消")) {
            return AiFault.Cancelled();
        }
        if (AiFault.Has(m, "api key") || AiFault.Has(m, "unauthorized")
            || AiFault.Has(m, "401") || AiFault.Has(m, "not configured")
            || AiFault.Has(m, "未配置")) {
            return AiFault.Config();
        }
        if (AiFault.Has(m, "timed out") || AiFault.Has(m, "timeout")
            || AiFault.Has(m, "connection") || AiFault.Has(m, "socket")
            || AiFault.Has(m, "dns") || AiFault.Has(m, "http 5")) {
            return AiFault.Network();
        }
        if (AiFault.Has(m, "error:") || AiFault.Has(m, "compile")
            || AiFault.Has(m, "expected ") || AiFault.Has(m, "undeclared")
            || AiFault.Has(m, "编译")) {
            return AiFault.Compile();
        }
        if (AiFault.Has(m, "tests failed") || AiFault.Has(m, "test failed")
            || AiFault.Has(m, "assert") || AiFault.Has(m, "mismatch")) {
            return AiFault.Test();
        }
        if (AiFault.Has(m, "0xc0000005") || AiFault.Has(m, "segmentation")
            || AiFault.Has(m, "exception") || AiFault.Has(m, "crash")
            || AiFault.Has(m, "闪退")) {
            return AiFault.Runtime();
        }
        if (AiFault.Has(m, "no such file") || AiFault.Has(m, "not found")
            || AiFault.Has(m, "access is denied") || AiFault.Has(m, "denied")) {
            return AiFault.Io();
        }
        if (AiFault.Has(m, "region") || AiFault.Has(m, "hit-test")
            || AiFault.Has(m, "ui_check")) {
            return AiFault.Ui();
        }
        return AiFault.Internal();
    }
}
