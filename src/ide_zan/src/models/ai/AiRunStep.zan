using System;

public class AiRunStep {
    int phase;
    int status;
    // 这一拍实际做了什么（一行摘要）。
    string title;
    // 可重现命令（`scripts\test.ps1 standard` 等），为空表示不是命令步骤。
    string command;
    // 这一拍真的调了几次工具。这是「它到底在搜代码，还是只在文字里说自己
    // 要搜」的唯一硬证据：模型说什么都不进这个数，只有工具真被执行才加一。
    int calls;
    int exitCode;
    int startedMs;
    int endedMs;
    int retries;
    int fault;
    string error;
    List<string> diagnostics;
    List<string> artifacts;

    static AiRunStep Create(int phase) {
        AiRunStep s = new AiRunStep();
        s.phase = phase;
        s.status = AiRunStatus.Pending();
        s.title = "";
        s.command = "";
        s.calls = 0;
        s.exitCode = 0;
        s.startedMs = 0;
        s.endedMs = 0;
        s.retries = 0;
        s.fault = AiFault.None();
        s.error = "";
        s.diagnostics = new List<string>();
        s.artifacts = new List<string>();
        return s;
    }

    void Begin(int nowMs, string title) {
        this.status = AiRunStatus.Running();
        this.startedMs = nowMs;
        this.endedMs = 0;
        this.fault = AiFault.None();
        this.error = "";
        if (title != "") { this.title = title; }
    }

    void Finish(int nowMs) {
        this.status = AiRunStatus.Done();
        this.endedMs = nowMs;
    }

    void Fail(int nowMs, int fault, string error) {
        this.endedMs = nowMs;
        this.fault = fault;
        this.error = error;
        if (fault == AiFault.Config() || fault == AiFault.Cancelled()) {
            this.status = AiRunStatus.Blocked();
        } else {
            this.status = AiRunStatus.Failed();
        }
    }

    int DurationMs() {
        if (this.startedMs == 0) { return 0; }
        if (this.endedMs == 0) { return 0; }
        return this.endedMs - this.startedMs;
    }

    string Label() {
        if (this.title != "") { return this.title; }
        return AiPhase.Zh(this.phase);
    }
}
