using System;
using System.Text;
using System.Collections.Generic;
using System.Json;

// 一个角色在某个任务节点上的参与记录
public class AiTaskPart {
    public string role;
    public string model;
    public int rounds;
    public long lastTs;

    static AiTaskPart Create(string role) {
        AiTaskPart p = new AiTaskPart();
        p.role = role;
        p.model = "";
        p.rounds = 0;
        p.lastTs = 0;
        return p;
    }
}
