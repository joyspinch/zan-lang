using System;
using System.Data;
using System.Data.Sqlite;

public class TaskNodeDoc {
    string id;
    string title;
    string owner;
    // 参与过本节点的角色，每条带模型与轮数。
    List<TaskPartDoc> parts;
    // 前置节点 id。
    List<string> deps;
    int state;
    int progress;
    string accept;
    string outcome;
    // 本节点自己的开发任务清单（节点＝一块功能，清单＝要干的活）。
    List<TaskItemDoc> items;
}
