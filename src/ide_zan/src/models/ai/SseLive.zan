using System;
using System.Text;
using System.Collections.Generic;
using System.Json;

public class SseLive {
    public int gen;
    // 已经折过的字节数（只用于诊断）。
    public int cursor;
    // 上一次喂进来的那一段结尾处那半行（还没等到换行）。增量喂法只拿到「新到
    // 的几个 chunk」，一行事件常常被切在两段之间，所以留着它跟下一段拼起来。
    public string pend;
    public StringBuilder c;
    public StringBuilder r;
    public SseAnswer a;
    public bool dirty;

    public SseLive() { this.Reset(0); }

    public void Reset(int g) {
        gen = g;
        cursor = 0;
        pend = "";
        c = new StringBuilder();
        r = new StringBuilder();
        a = new SseAnswer();
        a.content = "";
        a.reasoning = "";
        a.error = "";
        a.done = false;
        a.promptTokens = 0;
        a.completionTokens = 0;
        a.totalTokens = 0;
        a.cachedTokens = 0;
        dirty = false;
    }

    // 只吃「上次之后新到的那一段」（`AiNet.Since()`），把其中已经完整的事件行
    // 折进来；拿到半行就留在 `pend` 里等下一段，所以没有一个 chunk 被折两次、
    // 也没有一个被丢。不要回到「每一拍把整条流再扒一遍」：那份全文复制在
    // 长回答的最后几十秒里就是 GUI 线程烧掉的那一核。
    public void FeedTail(int g, string tail) {
        if (g != gen) { this.Reset(g); }
        if (tail == "") { return; }
        string raw = tail;
        if (pend != "") { raw = pend + tail; }
        int n = raw.Length;
        int i = 0;
        while (i < n) {
            int nl = i;
            while (nl < n && (raw[nl] & 255) != 10) { nl = nl + 1; }
            if (nl >= n) { break; }
            int lineEnd = nl;
            if (lineEnd > i && (raw[lineEnd - 1] & 255) == 13) {
                lineEnd = lineEnd - 1;
            }
            this.FoldLine(raw.Substring(i, lineEnd - i));
            i = nl + 1;
        }
        pend = "";
        if (i < n) { pend = raw.Substring(i, n - i); }
        cursor = cursor + tail.Length;
    }

    public void FoldLine(string line) {
        string payload = "";
        bool isData = false;
        if (line.Length >= 6 && line.Substring(0, 6) == "data: ") {
            payload = line.Substring(6, line.Length - 6);
            isData = true;
        } else if (line.Length >= 5 && line.Substring(0, 5) == "data:") {
            payload = AiAgent.Trim(line.Substring(5, line.Length - 5));
            isData = true;
        }
        if (!isData) { return; }
        if (payload == "[DONE]") { a.done = true; return; }
        AiAgent.FoldChunk(a, c, r, JsonValue.ParseLenient(payload), payload);
        dirty = true;
    }

    // 流结束：把残留的半行按完整的一行折进来。
    //
    // SSE 允许最后一帧**不以换行收尾**（最后一个事件不必带空行）。增量
    // 喂法把半行留在 `pend` 里等下一段——可流已经结束了，没有下一段了，
    // 那半行就永远折不进来：预览里最后一个分片凭空消失（最终那条消息是
    // 从全文用 AiAgent.ParseSse 重新解析的，所以那条是对的——于是预览比
    // 最终消息少一截，看着像"又抽风了一下"）。
    public void Finish() {
        if (pend != "") {
            string tail = pend;
            pend = "";
            this.FoldLine(tail);
        }
        this.Materialise();
    }

    public void Materialise() {
        if (!dirty) { return; }
        a.content = c.ToString();
        a.reasoning = r.ToString();
        dirty = false;
    }

    public string Content() { this.Materialise(); return a.content; }
    public string Reasoning() { this.Materialise(); return a.reasoning; }
}
