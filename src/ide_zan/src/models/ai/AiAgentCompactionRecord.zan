using System;
using System.Text;
using System.Collections.Generic;
using System.Json;

public class AiAgentCompactionRecord {
    public string role;
    public int count;
    public int lastDrop;
    public int stickyFrom;
    public string stickyText;

    public AiAgentCompactionRecord(string role) {
        this.role = role;
        this.count = 0;
        this.lastDrop = 0;
        this.stickyFrom = 0;
        this.stickyText = "";
    }
}
