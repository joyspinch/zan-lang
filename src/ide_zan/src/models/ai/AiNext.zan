using System;

public class AiNext {
    static int Continue() { return 0; }
    static int Retry() { return 1; }
    static int Diagnose() { return 2; }
    static int AskUser() { return 3; }
    static int Finished() { return 4; }
    static int Abort() { return 5; }

    static string Id(int act) {
        if (act == 0) { return "continue"; }
        if (act == 1) { return "retry"; }
        if (act == 2) { return "diagnose"; }
        if (act == 3) { return "ask-user"; }
        if (act == 4) { return "finished"; }
        if (act == 5) { return "abort"; }
        return "unknown";
    }
}
