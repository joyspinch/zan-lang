using System;
using System.Collections.Generic;
using System.Diagnostics;
using System.Net.Http.Client;

// 异步后台作业快照实体，记录所有监听分支的状态与序列
class IdeJobSnapshot {
    public int workspace;
    public int session;
    public int monitor;
    public string root;
    public int termSeq;
    public bool term;
    public int termConsumed;
    public int runSeq;
    public bool run;
    public int runConsumed;
    public int gitSeq;
    public int git;
    public int buildSeq;
    public bool build;
    public int buildStart;
    public int buildConsumed;
    public string buildExe;
    public string buildTarget;
    public bool thenRun;
    public bool gui;
    public bool debug;
    public List<DbgBreakpoint> breakpoints;
    public int debugLine;
    public string debugText;
    public int debugSeq;
    public DebugSession debugger;
    public List<DbgVar> watches;
    public bool aiBuild;
    public bool aiUiPending;
    public string aiUiScript;
    public int uiSeq;
    public bool ui;
    public int uiDeadline;
    public string uiTool;
    public int pubSeq;
    public bool pub;
    public bool packing;
    public int pubStart;
    public int pubConsumed;
    public string pubRoot;
    public bool packed;
    public List<string> exes;
    public AiReq request;
    public AiJob tool;
    public bool ai;
    public int aiLaunchSeq;
}

delegate void IdeJobReady(IdeJobResult result);

// 异步后台作业轮询与阶段产出结果实体
class IdeJobResult {
    public IdeJobSnapshot input;
    public int kind;
    public int phase;
    public int consumed;
    public bool complete;
    public bool ok;
    public bool timeout;
    public List<string> log = new List<string>();
    public List<string> output;
    public List<Diagnostic> diagnostics;
    public string missingPackage;
    public string exe;
    public string target;
    public bool gui;
    public bool thenRun;
    public bool consoleStarted;
    public bool uiStarted;
    public int uiDeadline;
    public string uiResult;
    public List<string> files;
    public string branch;
    public string head;
    public List<string> exes;
    public string step;
    public string publishFolder;
    public DebugSession debugSession;
    public int debugState;
    public int debugLine;
    public List<string> debugConsole;
    public List<DbgVar> debugVars;
    public List<DbgFrame> debugStack;
    public List<DbgVar> watches;
    public AiJob tool;
    public bool dropPreview;
    public bool final;
    public string live;
    public string done;
    public SseAnswer answer;
    public string call;
    public string said;
    public string reasoning;
    public string archiveCall;
    public string toolName;
    public string badTool;
    public AiEnvelope envelope;
    public string buildResult;
    public string error;
    public string debugCommand;
    public string debugExpression;
    public string debugValue;
    public int debugWatch;
    public List<ChatMessage> pins;
    public AiReq startedRequest;
}

// 异步作业启动请求参数实体
class IdeJobStart {
    public IdeJobSnapshot input;
    public int kind;
    public string target;
    public bool hot;
    public string gitArgs;
    public bool gitRefresh;
    public List<PublishTargetOption> options;
    public string command;
    public string argument;
    public int watch;
    public List<ChatMessage> messages;
    public string agent;
    public string contextName;
    public string contextCode;
    public string baseUrl;
    public string key;
    public string model;
}

// 调试会话集合与并发互斥保护
class IdeJobDebugSessions {
    nint gate = Mutex.Create();
    List<DebugSession> sessions = new List<DebugSession>();

    public void Remember(DebugSession session) {
        if (session == null) { return; }
        Mutex.Lock(gate);
        sessions.Add(session);
        Mutex.Unlock(gate);
    }

    public void StopAll() {
        for (int i = 0; i < sessions.Count; i = i + 1) { sessions[i].Stop(); }
        sessions = new List<DebugSession>();
    }
}
