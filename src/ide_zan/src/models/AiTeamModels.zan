using System;
using System.Collections.Generic;

// AI 团队角色元数据
class AiRole {
    public string id;
    public string en;
    public string zh;
    public string next;
    public string duty;
    public int tint;

    static AiRole Create(string id, string en, string zh, string next,
            string duty, int tint) {
        AiRole r = new AiRole();
        r.id = id;
        r.en = en;
        r.zh = zh;
        r.next = next;
        r.duty = duty;
        r.tint = tint;
        return r;
    }
}

// 一个角色在某个任务节点上的参与记录
class AiTaskPart {
    public string role;
    public string model;
    public int rounds;
    public long lastTs;

    static AiTaskPart Create(string role) {
        AiTaskPart p = new AiTaskPart();
        p.role = role;
        p.model = "";
        p.rounds = 0;
        p.lastTs = 0;
        return p;
    }
}

// 团队协作任务实体（依赖图节点与执行产出）
class AiTask {
    public string id;
    public string title;
    public string owner;
    public int state;
    public int progress;
    public string accept;
    public List<string> deps;
    public List<AiTaskPart> parts;
    public string outcome;
    public List<AiPlanStep> items;

    static AiTask Create(string id, string title, string owner) {
        AiTask t = new AiTask();
        t.id = id;
        t.title = title;
        t.owner = owner;
        t.state = 0;
        t.progress = 0;
        t.accept = "";
        t.deps = new List<string>();
        t.parts = new List<AiTaskPart>();
        t.outcome = "";
        t.items = new List<AiPlanStep>();
        return t;
    }
}

// 团队运行与断点恢复状态
class AiTeamState {
    public string activeAgent;
    public string activeTask;
    public bool awaitingUser;
    public string askedBy;

    static AiTeamState Create() {
        AiTeamState s = new AiTeamState();
        s.activeAgent = AiTeam.Pm();
        s.activeTask = "";
        s.awaitingUser = false;
        s.askedBy = "";
        return s;
    }
}

// 团队内部信令信封
class AiEnvelope {
    public List<string> to;
    public string kind;
    public string taskId;
    public int progress;
    public string body;

    static AiEnvelope Create() {
        AiEnvelope e = new AiEnvelope();
        e.to = new List<string>();
        e.kind = "";
        e.taskId = "";
        e.progress = 0;
        e.body = "";
        return e;
    }
}
