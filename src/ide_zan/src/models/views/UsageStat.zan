using System;

public class UsageStat {
    string label;
    string value;
    string tone;

    static UsageStat Of(string label, string value) {
        UsageStat s = new UsageStat();
        s.label = label;
        s.value = value;
        s.tone = "";
        return s;
    }

    static UsageStat Flag(string label, string value, bool warn) {
        UsageStat s = UsageStat.Of(label, value);
        if (warn) { s.tone = "warning"; }
        return s;
    }
}
