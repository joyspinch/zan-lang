using System;
using System.IO;
using System.Json;
using System.Resources;
using System.Security.Cryptography;
using Game.Scene;

public class AssetEntry {
    string name;
    int kind;
    string chip;
    string size;
    string path;  // link target; "" for folders and files

    static AssetEntry Of(string name, int kind, string chip, string size) {
        AssetEntry e = new AssetEntry();
        e.name = name;
        e.kind = kind;
        e.chip = chip;
        e.size = size;
        e.path = "";
        return e;
    }

    bool IsDir() { return kind == 0; }
    bool IsLink() { return kind == 2; }
}
