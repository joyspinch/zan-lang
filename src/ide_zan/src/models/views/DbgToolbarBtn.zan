using System;

public class DbgToolbarBtn {
    string icon;
    string label;
    string cls;
    int action;

    static DbgToolbarBtn Of(string icon, string label, string cls, int action) {
        DbgToolbarBtn b = new DbgToolbarBtn();
        b.icon = icon;
        b.label = label;
        b.cls = cls;
        b.action = action;
        return b;
    }
}
