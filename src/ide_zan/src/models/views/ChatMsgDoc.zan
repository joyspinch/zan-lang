using System;
using System.Json;

public class ChatMsgDoc {
    string r;
    string t;
    string z;
    string a;
    string to;
    string k;
    string ti;
    int pg;
    // 这一拍发出的工具调用（留档给模型看它自己的格式）。旧存档里没有 -> ""。
    string c;
    // 这条消息的时刻（Unix 秒，UTC）。旧存档里没有 -> 0，重新打开
    // 时头行就不显示时刻（而不是把旧消息全标成打开存档的那一刻）。存成
    // int 而不是 long：这份存档里每一个数字字段都是 int，Unix 秒到
    // 2038 年前都在 int 范围内。
    int at;
}
