using System;

public class NewsItem {
    string title;
    string tag;
    string kind;
    string link;

    static NewsItem Create(string title, string tag, string kind, string link) {
        NewsItem it = new NewsItem();
        it.title = title;
        it.tag = tag;
        it.kind = kind;
        it.link = link;
        return it;
    }
}
