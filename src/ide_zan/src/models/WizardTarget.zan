public class WizardTarget {
    public string name;
    public int selected;
    public string id;

    public WizardTarget(string n, int s) {
        name = n;
        selected = s;
        id = "";
    }

    public WizardTarget(string n, int s, string tid) {
        name = n;
        selected = s;
        id = tid;
    }
}
