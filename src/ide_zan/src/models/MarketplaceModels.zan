using System;
using System.Json;

class MarketplacePlan {
    string id;
    string name;
    string licenseMode;
    int pricePoints;
    int durationDays;

    static MarketplacePlan FromJson(JsonValue node) {
        MarketplacePlan plan = new MarketplacePlan();
        plan.id = node.Str("id", "");
        plan.name = node.Str("name", "");
        plan.licenseMode = node.Str("license_mode", "");
        plan.pricePoints = node.Int("price_points", 0);
        plan.durationDays = node.Int("duration_days", 0);
        return plan;
    }
}

class MarketplaceVersion {
    string id;
    string version;
    int majorVersion;
    string artifactUrl;
    string artifactSha256;
    string releaseNotes;

    static MarketplaceVersion FromJson(JsonValue node) {
        MarketplaceVersion version = new MarketplaceVersion();
        version.id = node.Str("id", "");
        version.version = node.Str("version", "");
        version.majorVersion = node.Int("major_version", 0);
        version.artifactUrl = node.Str("artifact_url", "");
        version.artifactSha256 = node.Str("artifact_sha256", "");
        version.releaseNotes = node.Str("release_notes", "");
        return version;
    }
}

class MarketplacePackage {
    string id;
    string packageName;
    string displayName;
    string description;
    string category;
    /// "extension"（源码库包，装进 .zan-packages）、"app"（应用，暂只下载）
    /// 或 "plugin"（商业插件：源码包带 plugin_id + 钉住的公钥指纹）。
    string productType;
    /// 商业插件身份与信任链：商城下发的 plugin_id 与签名公钥指纹，
    /// 安装时对包内 plugin.pub/plugin.sig 验签，二者不一致即拒绝。
    string pluginId;
    string pubkeyFp;
    int pricePoints;
    List<MarketplacePlan> plans;
    List<MarketplaceVersion> versions;

    MarketplacePackage() {
        plans = new List<MarketplacePlan>();
        versions = new List<MarketplaceVersion>();
    }

    bool IsFree() { return pricePoints == 0; }
    bool IsApp() { return productType == "app"; }
    bool IsPlugin() { return productType == "plugin"; }

    MarketplaceVersion LatestVersion() {
        if (versions.Count == 0) { return null; }
        return versions[0];
    }

    static MarketplacePackage FromCatalogJson(JsonValue node) {
        MarketplacePackage package = new MarketplacePackage();
        package.id = node.Str("id", "");
        package.packageName = node.Str("slug", "");
        package.displayName = node.Str("name", "");
        package.description = node.Str("description", "");
        package.category = node.Str("category", "");
        package.productType = node.Str("product_type", "extension");
        package.pluginId = node.Str("plugin_id", "");
        package.pubkeyFp = node.Str("pubkey_fp", "");
        package.pricePoints = node.Int("price_points", 0);
        return package;
    }

    static MarketplacePackage FromProductJson(JsonValue node) {
        MarketplacePackage package = MarketplacePackage.FromCatalogJson(node);
        JsonValue planValues = node.Get("plans");
        if (planValues != null && planValues.IsArray()) {
            for (int i = 0; i < planValues.Count(); i = i + 1) {
                package.plans.Add(MarketplacePlan.FromJson(planValues.At(i)));
            }
        }
        JsonValue versionValues = node.Get("versions");
        if (versionValues != null && versionValues.IsArray()) {
            for (int i = 0; i < versionValues.Count(); i = i + 1) {
                package.versions.Add(MarketplaceVersion.FromJson(versionValues.At(i)));
            }
        }
        return package;
    }
}

class MarketplaceResponse {
    /// 接口数据协议与执行契约。
    /// 接口数据协议与执行契约。
    /// 接口数据协议与执行契约。
    /// 接口数据协议与执行契约。
    /// 接口数据协议与执行契约。
    static JsonValue Data(string response) {
        JsonValue envelope = null;
        try {
            envelope = JsonValue.Parse(response);
        } catch (JsonException ex) {
            return null;
        }
        if (envelope == null || !envelope.IsObject()
            || envelope.Str("code", "") != "0000") {
            return null;
        }
        return envelope.Get("data");
    }

    /// 接口数据协议与执行契约。
    /// 接口数据协议与执行契约。
    /// 核心契约与语义定义。
    static bool IsRegistryResponse(string response) {
        return MarketplaceResponse.Data(response) != null;
    }

    static List<MarketplacePackage> Catalog(string response) {
        List<MarketplacePackage> packages = new List<MarketplacePackage>();
        JsonValue data = MarketplaceResponse.Data(response);
        if (data == null || !data.IsArray()) { return packages; }
        for (int i = 0; i < data.Count(); i = i + 1) {
            packages.Add(MarketplacePackage.FromCatalogJson(data.At(i)));
        }
        return packages;
    }

    static MarketplacePackage Product(string response) {
        JsonValue data = MarketplaceResponse.Data(response);
        if (data == null || !data.IsObject()) { return null; }
        return MarketplacePackage.FromProductJson(data);
    }
}

/// 项目源码缓存条目实体（消除 projSrcPaths / projSrcBodies 平行列表反模式）。
class ProjectSourceItem {
    string path;
    string body;

    ProjectSourceItem(string path, string body) {
        this.path = path;
        this.body = body;
    }
}

/// 聊天折叠行目标条目实体（消除 togPos / togMsg 平行列表反模式）。
class ChatToggleTarget {
    int position;
    int msgIndex;

    ChatToggleTarget(int position, int msgIndex) {
        this.position = position;
        this.msgIndex = msgIndex;
    }
}

/// macOS CEF 辅助进程描述实体（消除 names / idents 平行列表反模式）。
class MacHelperSpec {
    string nameSuffix;
    string identSuffix;

    MacHelperSpec(string nameSuffix, string identSuffix) {
        this.nameSuffix = nameSuffix;
        this.identSuffix = identSuffix;
    }
}
