using System;
using System.IO;
using System.Json;

public class DiagEvent {
    string kind;
    // error / warning / crash
    string severity;
    int ts;
    // 诊断码或退出码（"exit=1"），没有就空串。
    string code;
    string message;
    // 有就带（项目相对路径，绝对路径在入库时就被裁掉）。
    string file;
    int line;
    int col;
    // 上下若干行原始输出：`code generation failed` 这种没细节的错误，只有连着
    // 上文诊断才有意义。
    List<string> context;
    // 同一个 key 重复了多少次（去重计数，不是刷屏）。
    int count;

    static DiagEvent Create(string kind, string severity, string message,
                            int ts) {
        DiagEvent e = new DiagEvent();
        e.kind = kind;
        e.severity = severity;
        e.ts = ts;
        e.code = "";
        e.message = message;
        e.file = "";
        e.line = 0;
        e.col = 0;
        e.context = new List<string>();
        e.count = 1;
        return e;
    }

    // 去重键：同一处、同一条消息只留一条带计数。
    string Key() {
        return this.kind + "|" + this.code + "|" + this.file + "|"
            + Convert.ToString(this.line) + "|" + this.message;
    }

    // 列表里显示的一行。
    string Line() {
        string s = "[" + this.kind + "] ";
        if (this.file != "") {
            s = s + this.file;
            if (this.line > 0) { s = s + ":" + Convert.ToString(this.line); }
            s = s + " ";
        }
        if (this.code != "") { s = s + this.code + " "; }
        s = s + this.message;
        if (this.count > 1) { s = s + " (x" + Convert.ToString(this.count) + ")"; }
        return s;
    }
}
