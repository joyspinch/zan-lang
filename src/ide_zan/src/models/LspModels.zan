using System;
using System.Collections.Generic;
using System.Json;
using System.Threading;

class LspNotification {
    public string jsonrpc;
    public string method;
    public JsonValue params;
}

class LspRequest {
    public string jsonrpc;
    public int id;
    public string method;
    public JsonValue params;
}

class LspInitParams {
    public JsonValue processId;
    public string rootUri;
    public JsonValue capabilities;
}

class LspTextDocumentItem {
    public string uri;
    public string languageId;
    public int version;
    public string text;
}

class LspDidOpenParams {
    public LspTextDocumentItem textDocument;
}

class LspTextDocumentIdentifier {
    public string uri;
}

class LspVersionedDocument {
    public string uri;
    public int version;
}

class LspContentChange {
    public string text;
}

class LspDidChangeParams {
    public LspVersionedDocument textDocument;
    public List<LspContentChange> contentChanges;
}

class LspOpenDocument {
    public string path;
    public string text;
    public int version;
    public List<string> lines;
}

class LspPosition {
    public int line;
    public int character;
}

class LspReferenceContext {
    public bool includeDeclaration;
}

class LspDocPosParams {
    public LspTextDocumentIdentifier textDocument;
    public LspPosition position;
}

class LspDocParams {
    public LspTextDocumentIdentifier textDocument;
}

class LspReferenceParams {
    public LspTextDocumentIdentifier textDocument;
    public LspPosition position;
    public LspReferenceContext context;
}

class LspRenameParams {
    public LspTextDocumentIdentifier textDocument;
    public LspPosition position;
    public string newName;
}

class LspDefinitionTarget {
    public string path;
    public int line;
    public int column;
}

class LspRenameEdit {
    public string path;
    public LspPosition start;
    public LspPosition end;
    public string newText;
    public int version;
}

class LspEditApplication {
    public bool valid;
    public string text;
}

class LspEditSpan {
    public int start;
    public int end;
    public string newText;
}

class LspLocation {
    public string uri;
    public JsonValue range;
}

class LspLocationsResult {
    public List<LspLocation> result;
}

class LspHoverResult {
    public JsonValue result;
}

class LspCompletionItem {
    public string label;
    public int kind;
    public string detail;
    public JsonValue documentation;
    public string insertText;
    public int insertTextFormat;
    public string sortText;
    public JsonValue textEdit;
}

class LspCompletionsResult {
    public List<LspCompletionItem> result;
}

class LspParameterInformation {
    public string label;
    public JsonValue documentation;
}

class LspSignatureInformation {
    public string label;
    public JsonValue documentation;
    public List<LspParameterInformation> parameters;
}

class LspSignatureHelp {
    public List<LspSignatureInformation> signatures;
    public int activeSignature;
    public int activeParameter;
}

class LspSignatureHelpResult {
    public LspSignatureHelp result;
}

enum LspPendingState { Pending, Ready, Empty, Error, Timeout, Cancelled }

delegate void LspReadyHandler(LspSession session, bool ready);
delegate void LspFoldingHandler(LspFoldingResult result);
delegate void LspDefinitionHandler(LspDefinitionResult result);
delegate void LspReferencesHandler(LspReferencesResult result);
delegate void LspRenameHandler(LspRenameResult result);

class LspResult {
    public string path;
    public int version;
    public int stamp;
    public int generation;
    public int documentGeneration;
    public LspPendingState state;
}

class LspFoldingResult : LspResult {
    public List<CodeFoldRegion> regions;
}

class LspDefinitionResult : LspResult {
    public LspDefinitionTarget target;
}

class LspReferencesResult : LspResult {
    public List<string> rows;
}

class LspDocumentSnapshot {
    public string path;
    public string text;
    public int version;
}

class LspRenameResult : LspResult {
    public List<LspRenameEdit> edits;
    public List<LspDocumentSnapshot> documents;
}

class LspCommand {
    public string method;
    public string path;
    public string text;
    public string name;
    public int id;
    public int version;
    public int stamp;
    public int line;
    public int col;
    public int generation;
    public int documentGeneration;
    public CancellationToken cancellation;
    public LspFoldingHandler folding;
    public LspDefinitionHandler definition;
    public LspReferencesHandler references;
    public LspRenameHandler rename;
    public List<LspDocumentSnapshot> documents;
}

class LspWorkerResult : LspResult {
    public int id;
    public string method;
    public List<CodeCompletionItem> completions;
    public string signatureLabel;
    public string hover;
    public LspFoldingResult folding;
    public LspDefinitionResult definition;
    public LspReferencesResult references;
    public LspRenameResult rename;
}

class LspSendFrame {
    public string data;
    public int offset;
    public int requestId;
}

class LspPendingRequest {
    public int id;
    public string method;
    public string path;
    public string name;
    public int version;
    public int documentGeneration;
    public int generation;
    public int line;
    public int col;
    public long deadline;
    public LspPendingState state;
    public string message;
    public List<LspCompletionItem> completions;
    public LspSignatureHelp signature;
    public string hover;
    public CodeEditor editor;
    public string text;
    public int stamp;
    public int caretLine;
    public int caretCol;
    public int completionToken;
    public List<CodeCompletionItem> editorCompletions;
    public string signatureLabel;
    public CancellationTokenSource cancellation;
}
