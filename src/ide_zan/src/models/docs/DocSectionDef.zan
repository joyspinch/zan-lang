using System;
using System.IO;
using System.Json;

public class DocSectionDef {
    string en;
    string zh;
    List<string> cats;

    bool Holds(string catEn) {
        for (int i = 0; i < cats.Count; i = i + 1) {
            if (cats[i] == catEn) { return true; }
        }
        return false;
    }
}
