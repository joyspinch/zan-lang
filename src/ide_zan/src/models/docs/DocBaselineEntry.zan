using System;
using System.Threading;

public class DocBaselineEntry {
    string path;
    string text;
    long stamp;
    int version;

    static DocBaselineEntry Create(string path, string text, long stamp, int version) {
        DocBaselineEntry entry = new DocBaselineEntry();
        entry.path = path;
        entry.text = text;
        entry.stamp = stamp;
        entry.version = version;
        return entry;
    }
}
