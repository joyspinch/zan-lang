using System;
using System.Threading;

public class DocBaseline {
    Dictionary<string, DocBaselineEntry> entries;
    int revision;

    static DocBaseline Create() {
        DocBaseline docs = new DocBaseline();
        docs.entries = new Dictionary<string, DocBaselineEntry>();
        return docs;
    }

    static bool IsFileTab(string path) {
        return path != "" && !path.StartsWith("@")
            && !ZanIDE.IsScenePath(path);
    }

    static bool SameText(string left, string right) {
        if (left == right) { return true; }
        int a = 0;
        int b = 0;
        while (a < left.Length || b < right.Length) {
            while (a < left.Length && left[a] == '\r') { a = a + 1; }
            while (b < right.Length && right[b] == '\r') { b = b + 1; }
            if (a == left.Length || b == right.Length) {
                return a == left.Length && b == right.Length;
            }
            if (left[a] != right[b]) { return false; }
            a = a + 1;
            b = b + 1;
        }
        return true;
    }

    DocBaselineEntry Entry(string path) {
        DocBaselineEntry entry = null;
        entries.TryGetValue(path, out entry);
        return entry;
    }

    bool Tracked(string path) { return entries.ContainsKey(path); }

    void Note(string path, string text, long stamp) {
        if (!DocBaseline.IsFileTab(path)) { return; }
        revision = revision + 1;
        entries[path] = DocBaselineEntry.Create(path, text, stamp, revision);
    }

    void Track(string path, string text, long stamp) {
        if (!this.Tracked(path)) { this.Note(path, text, stamp); }
    }

    void Forget(string path) { entries.Remove(path); }

    string TextOf(string path) {
        DocBaselineEntry entry = this.Entry(path);
        return entry == null ? "" : entry.text;
    }

    long StampOf(string path) {
        DocBaselineEntry entry = this.Entry(path);
        return entry == null ? 0 : entry.stamp;
    }

    int VersionOf(string path) {
        DocBaselineEntry entry = this.Entry(path);
        return entry == null ? 0 : entry.version;
    }

    bool IsDirty(string path, string text) {
        if (!DocBaseline.IsFileTab(path)) { return false; }
        DocBaselineEntry entry = this.Entry(path);
        return entry == null || !DocBaseline.SameText(entry.text, text);
    }

    bool ChangedOutside(string path, long stamp) {
        DocBaselineEntry entry = this.Entry(path);
        return entry == null || (stamp != 0 && stamp != entry.stamp);
    }

    void AcceptStamp(string path, long stamp) {
        DocBaselineEntry entry = this.Entry(path);
        if (entry == null || stamp == 0) { return; }
        this.Note(path, entry.text, stamp);
    }
}
