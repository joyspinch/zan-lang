using System;
using System.IO;
using System.Json;

public class DocEntry {
    string catEn;
    string catZh;
    string titleEn;
    string titleZh;
    string bodyEn;
    string bodyZh;
    string code;
    List<string> imports;
    string preview;

    static DocEntry Of(string catEn, string catZh, string titleEn, string titleZh,
                       string bodyEn, string bodyZh, string code,
                       List<string> imports, string preview) {
        DocEntry d = new DocEntry();
        d.catEn = catEn;
        d.catZh = catZh;
        d.titleEn = titleEn;
        d.titleZh = titleZh;
        d.bodyEn = bodyEn;
        d.bodyZh = bodyZh;
        d.code = code;
        d.imports = imports;
        d.preview = preview;
        return d;
    }

    string Cat() { return ZanIDE.T(catEn, catZh); }
    string CatEn() { return catEn; }
    string Title() { return ZanIDE.T(titleEn, titleZh); }
    string Body() { return ZanIDE.T(bodyEn, bodyZh); }

    string Preview() { return preview; }

    string Code() {
        if (imports == null || imports.Count == 0) { return code; }
        StringBuilder sb = new StringBuilder();
        for (int i = 0; i < imports.Count; i = i + 1) {
            if (ZanIDE.Has(code, imports[i])) { continue; }
            sb.Append(imports[i]);
            sb.Append("\n");
        }
        if (sb.Length == 0) { return code; }
        sb.Append("\n");
        sb.Append(code);
        return sb.ToString();
    }
}
