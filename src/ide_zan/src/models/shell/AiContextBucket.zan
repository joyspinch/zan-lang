using System;
using System.IO;
using System.Diagnostics;
using Game.Scene;

public class AiContextBucket {
    string key;
    List<ChatMessage> messages;

    static AiContextBucket Create(string key, List<ChatMessage> msgs) {
        AiContextBucket b = new AiContextBucket();
        b.key = key;
        b.messages = msgs;
        return b;
    }
}
