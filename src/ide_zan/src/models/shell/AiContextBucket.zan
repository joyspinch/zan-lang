using System;
using System.IO;
using System.Diagnostics;
using Gui;
using Gui.Backend;
using Gui.Widget;
using Gui.Designer;
using Gui.Component;
using Game.Scene;

class AiContextBucket {
    string key;
    List<ChatMessage> messages;

    static AiContextBucket Create(string key, List<ChatMessage> msgs) {
        AiContextBucket b = new AiContextBucket();
        b.key = key;
        b.messages = msgs;
        return b;
    }
}
