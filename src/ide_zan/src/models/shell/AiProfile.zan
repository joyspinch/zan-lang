using System;
using System.IO;
using System.Diagnostics;
using Game.Scene;

public class AiProfile {
    string name;
    string baseUrl;
    string key;
    string model;
    string models;
    string limits;
    string roles;

    static AiProfile Create(string name, string baseUrl, string key, string model,
            string models, string limits) {
        AiProfile profile = new AiProfile();
        profile.name = name;
        profile.baseUrl = baseUrl;
        profile.key = key;
        profile.model = model;
        profile.models = models;
        profile.limits = limits;
        profile.roles = "{}";
        return profile;
    }
}
