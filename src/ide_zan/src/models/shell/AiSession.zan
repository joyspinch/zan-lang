using System;
using System.IO;
using System.Diagnostics;
using Game.Scene;

public class AiSession {
    string pack;
    int archived;
    string title;
    // 没有 `title` 时列表显示的那句话，从 `pack` 里取一次就存着：取它要把整
    // 段存档 JSON 解一遍，每帧为每个会话解一次是画不起的。
    string derived;
    // `derived` 是从多长的 `pack` 上算出来的（-1 = 还没算过）。
    int derivedLen;

    static AiSession Create(string pack, int archived) {
        AiSession s = new AiSession();
        s.pack = pack;
        s.archived = archived;
        s.title = "";
        s.derived = "";
        s.derivedLen = 0 - 1;
        return s;
    }
}
