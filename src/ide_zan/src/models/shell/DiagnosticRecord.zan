using System;
using System.IO;
using System.Diagnostics;
using Gui;
using Gui.Backend;
using Gui.Widget;
using Gui.Designer;
using Gui.Component;
using Game.Scene;

class DiagnosticRecord {
    string path;
    string line;
    string msg;

    DiagnosticRecord(string path, string line, string msg) {
        this.path = path;
        this.line = line;
        this.msg = msg;
    }
}
