using System;
using System.IO;
using System.Diagnostics;
using Gui;
using Gui.Backend;
using Gui.Widget;
using Gui.Designer;
using Gui.Component;
using Game.Scene;

class ModelOption {
    int profile;
    string model;
    string label;

    static ModelOption Of(int profile, string model, string label) {
        ModelOption o = new ModelOption();
        o.profile = profile;
        o.model = model;
        o.label = label;
        return o;
    }
}
