using System;
using System.IO;
using System.Diagnostics;
using Game.Scene;

public class ModelOption {
    int profile;
    string model;
    string label;

    static ModelOption Of(int profile, string model, string label) {
        ModelOption o = new ModelOption();
        o.profile = profile;
        o.model = model;
        o.label = label;
        return o;
    }
}
