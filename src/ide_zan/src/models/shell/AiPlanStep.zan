using System;
using System.IO;
using System.Diagnostics;
using Game.Scene;

public class AiPlanStep {
    string text;
    int done;
    // 1 = 这一步就是「现在正在做的那一步」（第一条还没打勾的）。派生自
    // `done`，每帧由 `PlanStrip.Sync` 重算，不落盘。
    int cur;

    static AiPlanStep Create(string text, int done) {
        AiPlanStep s = new AiPlanStep();
        s.text = text;
        s.done = done;
        s.cur = 0;
        return s;
    }
}
