using System;
using System.IO;
using System.Diagnostics;
using Gui;
using Gui.Backend;
using Gui.Widget;
using Gui.Designer;
using Gui.Component;
using Game.Scene;

class TabRecord {
    string name;
    string body;
    string path;
    int caretLine;
    int caretCol;
    int scrollLine;
    bool designDoc;
    CodeEditorPreparedText preparedText;
    string preparedBody;

    static TabRecord Create(string name, string body, string path) {
        TabRecord tab = new TabRecord();
        tab.name = name;
        tab.body = body;
        tab.path = path;
        tab.caretLine = 0;
        tab.caretCol = 0;
        tab.scrollLine = 0;
        tab.designDoc = ZanIDE.IsHtmlPath(path) && ZanIDE.IsHtmlDesignBody(body);
        return tab;
    }
}
