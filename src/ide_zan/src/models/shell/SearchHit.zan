using System;
using System.IO;
using System.Diagnostics;
using Gui;
using Gui.Backend;
using Gui.Widget;
using Gui.Designer;
using Gui.Component;
using Game.Scene;

class SearchHit {
    string path;
    int line;
    string text;

    static SearchHit Create(string path, int line, string text) {
        SearchHit hit = new SearchHit();
        hit.path = path;
        hit.line = line;
        hit.text = text;
        return hit;
    }
}
