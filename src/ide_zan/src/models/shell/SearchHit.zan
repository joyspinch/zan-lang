using System;
using System.IO;
using System.Diagnostics;
using Game.Scene;

public class SearchHit {
    string path;
    int line;
    string text;

    static SearchHit Create(string path, int line, string text) {
        SearchHit hit = new SearchHit();
        hit.path = path;
        hit.line = line;
        hit.text = text;
        return hit;
    }
}
