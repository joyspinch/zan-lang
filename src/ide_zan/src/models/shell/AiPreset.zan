using System;
using System.IO;
using System.Diagnostics;
using Gui;
using Gui.Backend;
using Gui.Widget;
using Gui.Designer;
using Gui.Component;
using Game.Scene;

class AiPreset {
    string name;
    string baseUrl;
    string model;
    string registrationUrl;

    static AiPreset Create(string name, string baseUrl, string model,
            string registrationUrl) {
        AiPreset preset = new AiPreset();
        preset.name = name;
        preset.baseUrl = baseUrl;
        preset.model = model;
        preset.registrationUrl = registrationUrl;
        return preset;
    }
}
