using System;
using System.Collections.Generic;
using System.Threading;

// 异步作业启动请求参数实体
public class IdeJobStart {
    public IdeJobSnapshot input;
    public int kind;
    public string target;
    public bool hot;
    public string gitArgs;
    public bool gitRefresh;
    public List<PublishTargetOption> options;
    public string command;
    public string argument;
    public int watch;
    public List<ChatMessage> messages;
    public string agent;
    public string contextName;
    public string contextCode;
    public string baseUrl;
    public string key;
    public string model;
}
