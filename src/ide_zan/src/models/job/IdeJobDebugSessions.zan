using System;
using System.Collections.Generic;
using System.Threading;

// 调试会话集合与并发互斥保护
public class IdeJobDebugSessions {
    nint gate = Mutex.Create();
    List<DebugSession> sessions = new List<DebugSession>();

    public void Remember(DebugSession session) {
        if (session == null) { return; }
        Mutex.Lock(gate);
        sessions.Add(session);
        Mutex.Unlock(gate);
    }

    public void StopAll() {
        for (int i = 0; i < sessions.Count; i = i + 1) { sessions[i].Stop(); }
        sessions = new List<DebugSession>();
    }
}
