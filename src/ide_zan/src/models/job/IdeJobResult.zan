using System;
using System.Collections.Generic;
using System.Threading;

// 异步后台作业轮询与阶段产出结果实体
public class IdeJobResult {
    public IdeJobSnapshot input;
    public int kind;
    public int phase;
    public int consumed;
    public bool complete;
    public bool ok;
    public bool timeout;
    public List<string> log = new List<string>();
    public List<string> output;
    public List<Diagnostic> diagnostics;
    public string missingPackage;
    public string exe;
    public string target;
    public bool gui;
    public bool thenRun;
    public bool consoleStarted;
    public bool uiStarted;
    public int uiDeadline;
    public string uiResult;
    public List<string> files;
    public string branch;
    public string head;
    public List<string> exes;
    public string step;
    public string publishFolder;
    public DebugSession debugSession;
    public int debugState;
    public int debugLine;
    public List<string> debugConsole;
    public List<DbgVar> debugVars;
    public List<DbgFrame> debugStack;
    public List<DbgVar> watches;
    public AiJob tool;
    public bool dropPreview;
    public bool final;
    public string live;
    public string done;
    public SseAnswer answer;
    public string call;
    public string said;
    public string reasoning;
    public string archiveCall;
    public string toolName;
    public string badTool;
    public AiEnvelope envelope;
    public string buildResult;
    public string error;
    public string debugCommand;
    public string debugExpression;
    public string debugValue;
    public int debugWatch;
    public List<ChatMessage> pins;
    public AiReq startedRequest;
}
