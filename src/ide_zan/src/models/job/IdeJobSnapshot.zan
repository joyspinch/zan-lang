using System;
using System.Collections.Generic;
using System.Threading;

// 异步后台作业快照实体，记录所有监听分支的状态与序列
public class IdeJobSnapshot {
    public int workspace;
    public int session;
    public int monitor;
    public string root;
    public int termSeq;
    public bool term;
    public int termConsumed;
    public int runSeq;
    public bool run;
    public int runConsumed;
    public int gitSeq;
    public int git;
    public int buildSeq;
    public bool build;
    public int buildStart;
    public int buildConsumed;
    public string buildExe;
    public string buildTarget;
    public bool thenRun;
    public bool gui;
    public bool debug;
    public List<DbgBreakpoint> breakpoints;
    public int debugLine;
    public string debugText;
    public int debugSeq;
    public DebugSession debugger;
    public List<DbgVar> watches;
    public bool aiBuild;
    public bool aiUiPending;
    public string aiUiScript;
    public int uiSeq;
    public bool ui;
    public int uiDeadline;
    public string uiTool;
    public int pubSeq;
    public bool pub;
    public bool packing;
    public int pubStart;
    public int pubConsumed;
    public string pubRoot;
    public bool packed;
    public List<string> exes;
    public AiReq request;
    public AiJob tool;
    public bool ai;
    public int aiLaunchSeq;
}
