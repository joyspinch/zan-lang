using System;
using System.Collections.Generic;
using System.Json;
using System.Threading;

public class LspPosition {
    public int line;
    public int character;

    // JSON 视图：JsonValue.Put 只收 JsonValue，而这些位置对象要
    // 被塞进请求参数的 JsonValue 里（见 LspSession.CodeActions）。
    public JsonValue ToJson() {
        JsonValue o = JsonValue.NewObject();
        o.PutInt("line", this.line);
        o.PutInt("character", this.character);
        return o;
    }
}
