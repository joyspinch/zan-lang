using System;
using System.Collections.Generic;
using System.Json;
using System.Threading;

public class LspTextDocumentIdentifier {
    public string uri;

    // JSON 视图：JsonValue.Put 只收 JsonValue，而这个文档标识要
    // 被塞进请求参数的 JsonValue 里（见 LspSession.CodeActions）。
    public JsonValue ToJson() {
        JsonValue o = JsonValue.NewObject();
        o.PutStr("uri", this.uri);
        return o;
    }
}
