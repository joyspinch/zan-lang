using System;
using System.Collections.Generic;
using System.Json;
using System.Threading;

public class LspCommand {
    public string method;
    public string path;
    public string text;
    public string name;
    public int id;
    public int version;
    public int stamp;
    public int line;
    public int col;
    public int generation;
    public int documentGeneration;
    public CancellationToken cancellation;
    public LspFoldingHandler folding;
    public LspDefinitionHandler definition;
    public LspReferencesHandler references;
    public LspRenameHandler rename;
    public List<LspDocumentSnapshot> documents;
}
