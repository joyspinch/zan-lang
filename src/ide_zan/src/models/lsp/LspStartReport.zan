// 语言服务启动诊断袋：zan-lsp 起不来时，把「为什么」带出来。
//
// 以前启动失败只回一个 null，IDE 只能写一句"语言服务不可用"——
// 用户既不知道是找不到可执行文件、连不上端口、还是握手超时，
// 更没法据此重连。这里把失败分类（code）与技术细节（detail：
// 查过的路径、试过的端口）一起带出来，IDE 翻成人话显示在状态栏。
public class LspStartReport {
    // 0=没失败；1=找不到可执行文件；2=连不上（服务没起来/端口占用）；
    // 3=握手超时（连上了但 initialize 没回）。
    public int code;
    // 技术细节：路径、端口区间等，原样带给用户看。
    public string detail;
    // 试了几次端口。
    public int attempts;
    // 最后试的端口。
    public int lastPort;
}
