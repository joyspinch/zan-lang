using System;

// Pure LSP diagnostic item (UI-free); converted to CodeEditor.Diagnostic at the editor boundary.
public class LspDiagnostic {
    public int line;
    public int startCol;
    public int endCol;
    public int severity;
    public string msg;

    public LspDiagnostic(int line, int startCol, int endCol, int severity, string msg) {
        this.line = line;
        this.startCol = startCol;
        this.endCol = endCol;
        this.severity = severity;
        this.msg = msg;
    }
}
