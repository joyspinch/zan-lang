using System;
using System.IO;
using System.Diagnostics;
using System.Json;
using System.Text;
using System.Security.Cryptography;
using AppUpdate;

public class IdeSyncPlan {
    UpdateManifest manifest;
    string release;
    int matchCount;
    string error = "invalid sync response";

    static IdeSyncPlan Parse(string done) {
        IdeSyncPlan plan = new IdeSyncPlan();
        if (done.StartsWith("err:")) { plan.error = done.Substring(4); return plan; }
        if (!done.StartsWith("ok:")) { return plan; }
        try {
            JsonDoc doc = JsonDoc.Parse(done.Substring(3));
            if (doc == null || doc.KindAt(doc.root) != 5) { return plan; }
            string code = doc.Str(doc.root, "code", "");
            if (code != "0" && code != "0000") { plan.error = "sync rejected"; return plan; }
            int data = doc.Get(doc.root, "data");
            if (data < 0 || doc.KindAt(data) != 5) { return plan; }
            int signed = doc.Get(data, "manifest");
            if (signed < 0 || doc.KindAt(signed) != 5) { return plan; }
            UpdateManifest manifest = UpdateManifest.Parse(doc.ToJson(signed));
            if (!IdeSyncPlan.Trusted(manifest)) { plan.error = "untrusted update manifest"; return plan; }
            string release = AppUpdater.HashBytes(Encoding.UTF8.GetBytes(manifest.ToJson()));
            if (doc.Str(data, "release", "") != release) { plan.error = "release binding mismatch"; return plan; }
            plan.manifest = manifest;
            plan.release = release;
            plan.matchCount = (int)doc.Long(data, "match", 0L);
            plan.error = "";
        } catch (Exception ex) { plan.error = "invalid sync response"; }
        return plan;
    }

    // The pin is provisioned with the installed IDE. No key from the remote
    // manifest or mall response can establish update trust.
    static bool ConfigureSigner() {
        string path = ProcessHost.Env("ZAN_UPDATE_PUBLIC_KEYSET_FILE");
        if (path.Length == 0) { path = ProcessHost.Env("ZAN_UPDATE_PUBLIC_KEY_FILE"); }
        AppUpdater.SetTrustedSigner("", "");
        if (path.Length == 0 || !File.Exists(path) || File.GetSize64(path) > 16384) { return false; }
        try {
            return AppUpdater.SetTrustedSignerPemBundle(File.ReadAllText(path));
        } catch (Exception ex) { return false; }
    }

    static bool Trusted(UpdateManifest manifest) {
        return IdeSyncPlan.TrustedFor(manifest, "ide", IdeUpdate.PlatformOf());
    }

    static bool TrustedFor(UpdateManifest manifest, string channel, string platform) {
        if (manifest == null || manifest.appName != "zan-channel/" + channel + "/" + platform) { return false; }
        if (!IdeSyncPlan.ConfigureSigner()) { return false; }
        return AppUpdater.VerifyManifestSignature(manifest, null);
    }

    UpdateManifest Manifest() { return this.manifest; }
    string Release() { return this.release; }
    long DownloadBytes() { return this.manifest != null ? this.manifest.packageSize : 0L; }
    int MatchCount() { return this.matchCount; }
    string Error() { return this.error; }
    bool Ok() { return this.error == "" && this.manifest != null; }
}
