using System;
using System.Json;
using System.Net.Http.Client;
using System.Net.External;
using System.Net.Sockets;

public class IdeSyncPlan {
    List<IdeDownloadItem> items;
    long downloadBytes;
    int matchCount;
    string error;

    static IdeSyncPlan Parse(string done) {
        IdeSyncPlan plan = new IdeSyncPlan();
        plan.items = new List<IdeDownloadItem>();
        plan.error = "";
        if (done.Length > 4 && done.Substring(0, 4) == "err:") {
            plan.error = done.Substring(4, done.Length - 4);
            return plan;
        }
        if (done.Length < 3 || done.Substring(0, 3) != "ok:") {
            plan.error = "invalid sync response";
            return plan;
        }
        try {
            string json = done.Substring(3, done.Length - 3);
            JsonDoc.ParseScoped(json, doc => {
                int root = doc.root;
                if (doc.KindAt(root) != 5 || doc.Str(root, "code", "") != "0000") {
                    plan.error = "sync rejected";
                    return;
                }
                int data = doc.Get(root, "data");
                if (data < 0 || doc.KindAt(data) != 5) { return; }
                int downloads = doc.Get(data, "download");
                if (downloads >= 0 && doc.KindAt(downloads) == 4) {
                    int child = doc.FirstChild(downloads);
                    while (child >= 0) {
                        if (doc.KindAt(child) == 5) {
                            string p = doc.Str(child, "path", "");
                            string m = doc.Str(child, "md5", "");
                            long s = IdeSyncPlan.ParseLong(doc.Str(child, "size", "0"));
                            plan.items.Add(new IdeDownloadItem(p, m, s));
                            plan.downloadBytes = plan.downloadBytes + s;
                        }
                        child = doc.NextSibling(child);
                    }
                }
                plan.matchCount = (int)doc.Long(data, "match", 0L);
            });
        } catch (Exception) {
            plan.error = "sync rejected";
            return plan;
        }
        return plan;
    }

    // 无依赖的十进制解析（IDE 不编 System.Web 的 Filter）。
    static long ParseLong(string s) {
        long v = 0;
        for (int i = 0; i < s.Length; i = i + 1) {
            int c = s[i] & 255;
            if (c < 48 || c > 57) { break; }
            v = v * 10 + c - 48;
        }
        return v;
    }

    List<IdeDownloadItem> Items() { return items; }
    List<string> DownloadPaths() {
        List<string> paths = new List<string>();
        for (int i = 0; i < items.Count; i = i + 1) {
            paths.Add(items[i].Path());
        }
        return paths;
    }
    List<string> DownloadMd5s() {
        List<string> md5s = new List<string>();
        for (int i = 0; i < items.Count; i = i + 1) {
            md5s.Add(items[i].Md5());
        }
        return md5s;
    }
    long DownloadBytes() { return downloadBytes; }
    int MatchCount() { return matchCount; }
    string Error() { return error; }
    bool Ok() { return error == ""; }
}
