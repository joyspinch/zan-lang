using System;
using System.Json;
using System.Net.Http.Client;
using System.Net.External;
using System.Net.Sockets;

public class IdeDownloadItem {
    string path;
    string md5;
    long size;

    IdeDownloadItem(string path, string md5, long size) {
        this.path = path;
        this.md5 = md5;
        this.size = size;
    }

    string Path() { return path; }
    string Md5() { return md5; }
    long Size() { return size; }
}
