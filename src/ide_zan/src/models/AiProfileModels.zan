using System;
using System.Collections.Generic;

// AI 对话消息传输文档
class ChatMessageDoc {
    string role;
    string content;
}

// AI 流式选项传输文档
class AiStreamOptionsDoc {
    bool include_usage;
}

// AI 聊天请求体基础文档
class AiChatBodyDoc {
    string model;
    bool stream;
    AiStreamOptionsDoc stream_options;
    List<ChatMessageDoc> messages;
}

// AI 聊天请求体带 max_tokens 参数文档
class AiChatBodyMaxDoc : AiChatBodyDoc {
    int max_tokens;
}

// AI 远端模型列表拉取请求实体
class AiModelsFetchReq {
    string baseUrl;
    string key;
}

// AI 模型请求体缓存实体（消除平行列表）
class AiModelPrefixCache {
    string model;
    string lastPayload;

    AiModelPrefixCache(string model, string lastPayload) {
        this.model = model;
        this.lastPayload = lastPayload;
    }
}
