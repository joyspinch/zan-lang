using System;
using System.Collections.Generic;
using System.Json;

// 项目源码缓存条目实体（消除 projSrcPaths / projSrcBodies 平行列表反模式）。
public class ProjectSourceItem {
    string path;
    string body;

    ProjectSourceItem(string path, string body) {
        this.path = path;
        this.body = body;
    }
}
