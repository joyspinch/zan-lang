using System;
using System.Collections.Generic;
using System.Json;

public class MarketplaceResponse {
    // Current MVC response: numeric 0; legacy registry: string "0000".
    // Require the slot and its actual type: missing/null/false/string "0" fail closed.
    public static bool Success(JsonDoc doc, int root) {
        if (doc.KindAt(root) != 5) { return false; }
        int code = doc.Get(root, "code");
        if (code < 0) { return false; }
        if (doc.KindAt(code) == 2) {
            // KindAt normalizes floating tokens to number; LongAt truncates fractions.
            // StrAt preserves decimal/exponent tokens. Only an all-zero mantissa is zero,
            // including 0.0/-0/0e10, without floating underflow accepting 1e-9999.
            string number = doc.StrAt(code, "");
            bool digit = false;
            for (int i = 0; i < number.Length; i = i + 1) {
                int c = number[i] & 255;
                if (c == 101 || c == 69) { return digit; }
                if (c == 45 && i == 0) { continue; }
                if (c == 46) { continue; }
                if (c != 48) { return false; }
                digit = true;
            }
            return digit;
        }
        return doc.KindAt(code) == 3 && doc.StrAt(code, "") == "0000";
    }

    public static bool IsRegistryResponse(string response) {
        if (response == null || response.Length == 0) { return false; }
        try {
            return JsonDoc.ParseScoped<bool>(response, doc => {
                int root = doc.root;
                if (doc.KindAt(root) != 5) { return false; }
                if (!MarketplaceResponse.Success(doc, root)) { return false; }
                return doc.Get(root, "data") >= 0;
            });
        } catch (Exception) {
            return false;
        }
    }

    public static List<MarketplacePackage> Catalog(string response) {
        List<MarketplacePackage> packages = new List<MarketplacePackage>();
        if (response == null || response.Length == 0) { return packages; }
        try {
            JsonDoc.ParseScoped(response, doc => {
                int root = doc.root;
                if (!MarketplaceResponse.Success(doc, root)) { return; }
                int data = doc.Get(root, "data");
                if (data < 0 || doc.KindAt(data) != 4) { return; }
                int child = doc.FirstChild(data);
                while (child >= 0) {
                    if (doc.KindAt(child) == 5) {
                        packages.Add(MarketplacePackage.FromCatalogDoc(doc, child));
                    }
                    child = doc.NextSibling(child);
                }
            });
        } catch (Exception) {
        }
        return packages;
    }

    public static MarketplacePackage Product(string response) {
        if (response == null || response.Length == 0) { return null; }
        try {
            return JsonDoc.ParseScoped<MarketplacePackage>(response, doc => {
                int root = doc.root;
                if (!MarketplaceResponse.Success(doc, root)) { return null; }
                int data = doc.Get(root, "data");
                if (data < 0 || doc.KindAt(data) != 5) { return null; }
                return MarketplacePackage.FromProductDoc(doc, data);
            });
        } catch (Exception) {
            return null;
        }
    }
}
