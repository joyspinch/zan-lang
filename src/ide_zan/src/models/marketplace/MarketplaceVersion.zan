using System;
using System.Collections.Generic;
using System.Json;

public class MarketplaceVersion {
    string id;
    string version;
    int majorVersion;
    string artifactUrl;
    string artifactSha256;
    string releaseNotes;

    static MarketplaceVersion FromJson(JsonValue node) {
        MarketplaceVersion version = new MarketplaceVersion();
        version.id = node.Str("id", "");
        version.version = node.Str("version", "");
        version.majorVersion = node.Int("major_version", 0);
        version.artifactUrl = node.Str("artifact_url", "");
        version.artifactSha256 = node.Str("artifact_sha256", "");
        version.releaseNotes = node.Str("release_notes", "");
        return version;
    }
}
