using System;
using System.Collections.Generic;
using System.Json;

public class MarketplaceVersion {
    string id;
    string version;
    int majorVersion;
    string artifactUrl;
    string artifactSha256;
    string releaseNotes;

    public static MarketplaceVersion FromDoc(JsonDoc doc, int node) {
        MarketplaceVersion version = new MarketplaceVersion();
        version.id = doc.Str(node, "id", "");
        version.version = doc.Str(node, "version", "");
        version.majorVersion = (int)doc.Long(node, "major_version", 0L);
        version.artifactUrl = doc.Str(node, "artifact_url", "");
        version.artifactSha256 = doc.Str(node, "artifact_sha256", "");
        version.releaseNotes = doc.Str(node, "release_notes", "");
        return version;
    }
}
