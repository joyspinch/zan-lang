using System;
using System.Collections.Generic;
using System.Json;

// macOS CEF 辅助进程描述实体（消除 names / idents 平行列表反模式）。
public class MacHelperSpec {
    string nameSuffix;
    string identSuffix;

    MacHelperSpec(string nameSuffix, string identSuffix) {
        this.nameSuffix = nameSuffix;
        this.identSuffix = identSuffix;
    }
}
