using System;
using System.Collections.Generic;
using System.Json;

public class MarketplacePlan {
    string id;
    string name;
    string licenseMode;
    int pricePoints;
    int durationDays;

    static MarketplacePlan FromJson(JsonValue node) {
        MarketplacePlan plan = new MarketplacePlan();
        plan.id = node.Str("id", "");
        plan.name = node.Str("name", "");
        plan.licenseMode = node.Str("license_mode", "");
        plan.pricePoints = node.Int("price_points", 0);
        plan.durationDays = node.Int("duration_days", 0);
        return plan;
    }
}
