using System;
using System.Collections.Generic;
using System.Json;

public class MarketplacePlan {
    string id;
    string name;
    string licenseMode;
    int pricePoints;
    int durationDays;

    public static MarketplacePlan FromDoc(JsonDoc doc, int node) {
        MarketplacePlan plan = new MarketplacePlan();
        plan.id = MarketplacePackage.DocId(doc, node, "id");
        plan.name = doc.Str(node, "name", "");
        plan.licenseMode = doc.Str(node, "license_mode", "");
        plan.pricePoints = MarketplacePackage.Price(doc, node, "price_points");
        plan.durationDays = (int)doc.Long(node, "duration_days", 0L);
        return plan;
    }
}
