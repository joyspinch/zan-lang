public class WizardTemplate {
    public string cat;
    public string name;
    public string icon;
    public string desc;
    public bool sizeable;
    public int defW;
    public int defH;
    public bool round;
    public string preview;
    public string sketch;
    public string deviceId;
    public string caps;
    public string plats;

    public WizardTemplate(string c, string n, string ic, string d) {
        cat = c;
        name = n;
        icon = ic;
        desc = d;
        sizeable = false;
        defW = 0;
        defH = 0;
        round = false;
        preview = "";
        sketch = "";
        deviceId = "";
        caps = "";
        plats = "";
    }

    public WizardTemplate Shape(bool canSize, int w, int h, bool isRound) {
        sizeable = canSize;
        defW = w;
        defH = h;
        round = isRound;
        return this;
    }

    public WizardTemplate Look(string previewPath, string sketchSpec) {
        preview = previewPath;
        sketch = sketchSpec;
        return this;
    }

    public WizardTemplate Device(string id) {
        deviceId = id;
        return this;
    }

    public WizardTemplate Caps(string spec) {
        caps = spec;
        return this;
    }

    public WizardTemplate Plats(string spec) {
        plats = spec;
        return this;
    }
}
