using System;
using System.Collections.Generic;
using System.Json;
using Gui.Component.CodeEditor;

partial class LspSession {
    LspDiagnosticsHandler onDiagnostics;

    void WireConnectionDiagnostics(LspSession connection) {
        if (connection == null) { return; }
        LspSession owner = this;
        connection.onDiagnostics = (string uri, List<Diagnostic> diagnostics) => {
            owner.DeliverDiagnostics(uri, diagnostics);
        };
    }

    void DeliverDiagnostics(string uri, List<Diagnostic> diagnostics) {
        if (uiDispatcher == null) { return; }
        string path = LspSession.UriToPath(uri);
        uiDispatcher(() => {
            if (stopping) { return; }
            if (onDiagnostics != null) { onDiagnostics(path, diagnostics); }
        });
    }

    static List<Diagnostic> ParsePublishDiagnostics(JsonDoc doc, int paramsNode, List<string> lines) {
        List<Diagnostic> diags = new List<Diagnostic>();
        if (paramsNode < 0 || doc.KindAt(paramsNode) != 5) { return diags; }
        int arr = doc.Get(paramsNode, "diagnostics");
        if (arr < 0 || doc.KindAt(arr) != 4) { return diags; }
        int d = doc.FirstChild(arr);
        while (d >= 0) {
            if (doc.KindAt(d) == 5) {
                int line = 0;
                int startCol = 0;
                int endCol = 0;
                int range = doc.Get(d, "range");
                if (range >= 0 && doc.KindAt(range) == 5) {
                    int start = doc.Get(range, "start");
                    int end = doc.Get(range, "end");
                    if (start >= 0 && doc.KindAt(start) == 5) {
                        line = (int)doc.Long(start, "line", 0L);
                        int sc = (int)doc.Long(start, "character", 0L);
                        int ec = end >= 0 && doc.KindAt(end) == 5
                            ? (int)doc.Long(end, "character", (long)sc)
                            : sc;
                        string src = "";
                        if (lines != null && line >= 0 && line < lines.Count) { src = lines[line]; }
                        startCol = LspSession.Utf16ColumnToByte(src, sc);
                        endCol = LspSession.Utf16ColumnToByte(src, ec);
                    }
                }
                int severity = (int)doc.Long(d, "severity", 1L);
                string message = doc.Str(d, "message", "");
                diags.Add(new Diagnostic(line, startCol, endCol, severity, message));
            }
            d = doc.NextSibling(d);
        }
        return diags;
    }
}
