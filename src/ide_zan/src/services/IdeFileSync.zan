using System;
using System.IO;
using System.Json;
using System.Net.Http;
using System.Net.Http.Client;
using System.Net.External;
using System.Net.Sockets;
using AppUpdate;

// Dedicated updater: stage an authenticated release archive, then install via
// Zan.AppUpdate's recoverable transaction. Pending directories are never copied wholesale.
public class IdeFileSync {
    static SseSink sink;
    static List<long> workers;
    static bool closing;
    static string progress;
    static IdeSyncPlan plan;
    static int phase;

    static string T(string en, string zh) { return Lang.Tr(en, zh); }
    static bool Busy() { return IdeFileSync.phase == 1 || IdeFileSync.phase == 2; }
    static string Progress() { return IdeFileSync.progress; }
    static string PendingDir() { return ZanIDE.UserConfigDir() + "/pending-sync"; }

    static string Start() {
        if (IdeFileSync.closing) { return "IDE is closing"; }
        if (IdeFileSync.Busy()) { return T("sync already running", "同步已在进行中"); }
        if (Directory.Exists(IdeFileSync.PendingDir())) {
            return T("update staging exists; restart or inspect the failed update", "更新暂存已存在，请重启或检查失败的更新");
        }
        if (!IdeSyncPlan.ConfigureSigner()) { return "trusted update public key is not configured"; }
        IdeFileSync.plan = null;
        IdeFileSync.phase = 1;
        IdeFileSync.progress = T("Comparing with server...", "正在与服务端比对...");
        // The signed archive is the installation unit. No scan of user files and
        // no parallel path/hash arrays are needed to request the complete target.
        string error = IdeUpdate.BeginSync(new List<UpdateFileEntry>());
        if (error.Length > 0) { IdeFileSync.phase = 0; IdeFileSync.progress = ""; }
        return error;
    }

    static string Poll() {
        if (IdeFileSync.closing) { return ""; }
        if (IdeFileSync.phase == 2) {
            string done = IdeFileSync.sink != null ? IdeFileSync.sink.Done() : "";
            if (done.Length == 0) { return ""; }
            IdeFileSync.sink = null;
            IdeFileSync.phase = done == "ok:staged" ? 9 : 0;
            IdeFileSync.progress = "";
            if (done == "ok:staged") { return T("> Update staged; restart to apply.", "> 更新已暂存，重启后应用。"); }
            return "> Update failed: " + (done.StartsWith("err:") ? done.Substring(4) : done);
        }
        if (IdeFileSync.phase != 1) { return ""; }
        IdeSyncPlan plan = IdeUpdate.SyncPlan();
        if (plan == null && !IdeUpdate.SyncDone()) { return ""; }
        if (plan == null || !plan.Ok()) {
            IdeFileSync.phase = 0;
            IdeFileSync.progress = "";
            return "> Update failed: " + (plan != null ? plan.Error() : "server unreachable");
        }
        IdeFileSync.plan = plan;
        IdeFileSync.phase = 2;
        IdeFileSync.progress = T("Downloading signed update...", "正在下载已签名更新...");
        IdeFileSync.sink = SseSink.ToMemory();
        if (IdeFileSync.workers == null) { IdeFileSync.workers = new List<long>(); }
        long worker = Task.Run(IdeFileSync.DownloadWorker(IdeFileSync.sink, plan, IdeFileSync.PendingDir()));
        IdeFileSync.workers.Add(worker);
        return "";
    }

    static async void DownloadWorker(SseSink target, IdeSyncPlan plan, string pending) {
        try {
            string error = await IdeFileSync.DownloadAll(plan, pending);
            target.Publish(error.Length == 0 ? "ok:staged" : "err:" + error);
        } catch (Exception ex) { target.Publish("err:" + ex.Message); }
    }

    static void BeginShutdown() { IdeFileSync.closing = true; }

    static async void DrainAsync() {
        IdeFileSync.BeginShutdown();
        if (IdeFileSync.workers != null) { await Task.WhenAll(IdeFileSync.workers); }
        IdeFileSync.sink = null;
        IdeFileSync.phase = 0;
        IdeFileSync.progress = "";
    }

    static async string DownloadAll(IdeSyncPlan plan, string pending) {
        UpdateManifest manifest = plan.Manifest();
        if (!IdeSyncPlan.Trusted(manifest)) { return "untrusted update manifest"; }
        if (!AppUpdater.SafeDestination(pending, "release.zip")
            || !AppUpdater.SafeDestination(pending, "manifest.json")) { return "unsafe update staging"; }
        // Construct the fixed mall route locally. Never fetch a metadata-supplied host.
        string url = IdeUpdate.BaseUrl() + "/api/channel/file?channel=ide&platform="
            + IdeUpdate.PlatformOf() + "&version=" + IdeUpdate.UrlEncode(manifest.version)
            + "&release=" + plan.Release() + "&path=_release.zip";
        byte[] bytes = await IdeFileSync.Fetch(url);
        if (bytes == null || bytes.Length != manifest.packageSize
            || AppUpdater.HashBytes(bytes) != manifest.packageSha256.ToLower()) { return "release SHA-256 or size mismatch"; }
        Directory.CreateDirectoryRecursive(pending);
        File.WriteAllBytes(pending + "/release.zip", bytes);
        // The signed manifest is the ready marker; partial downloads never become installable.
        manifest.SaveToFile(pending + "/manifest.json");
        return "";
    }

    static async byte[] Fetch(string url) {
        ExternalTarget target = ExternalTarget.Parse(url);
        if (target == null) { return null; }
        Socket.Initialize();
        HttpClient client;
        if (target.IsTls()) { client = HttpClient.CreateHttps(target.Host(), target.Port()); }
        else { client = new HttpClient(target.Host(), target.Port()); }
        client.SetCallPolicy(IdeUpdate.FilePolicy(target.Host()));
        client.SetTimeout(120000);
        HttpResponse response = await client.SendBytesAsync("GET", target.Path() + target.Query(), "");
        if (response.statusCode != 200) { return null; }
        if (response.IsBinary()) {
            // HttpClient keeps a trailing byte in its backing buffer; only
            // BodyLength() bytes belong to the authenticated archive payload.
            int length = response.BodyLength();
            byte[] buffer = response.bodyBytes;
            if (buffer == null || length < 0 || length > buffer.Length) { return null; }
            if (length == buffer.Length) { return buffer; }
            byte[] payload = new byte[length];
            for (int i = 0; i < length; i = i + 1) { payload[i] = buffer[i]; }
            return payload;
        }
        byte[] bytes = new byte[response.body.Length];
        for (int i = 0; i < response.body.Length; i = i + 1) { bytes[i] = response.body[i] & 255; }
        return bytes;
    }

    static bool PathSafe(string path) {
        return path != null && !path.Contains("\\") && UpdateFileEntry.SafeRelPath(path);
    }

    // Only files in the last successfully installed signed manifest are eligible
    // for removal. Projects, configuration and other local files are never inferred.
    static bool RemoveObsolete(string root, UpdateManifest previous, UpdateManifest target) {
        if (previous == null) { return true; }
        if (!IdeSyncPlan.Trusted(previous)) { return false; }
        for (int i = 0; i < previous.files.Count; i = i + 1) {
            UpdateFileEntry old = previous.files[i];
            if (target.FindFile(old.path) != null) { continue; }
            if (!AppUpdater.SafeDestination(root, old.path)) { return false; }
            string full = root + "/" + old.path;
            if (!File.Exists(full)) { continue; }
            // Preserve a locally modified formerly managed file.
            if (File.GetSize64(full) != old.size) { continue; }
            byte[] bytes = File.ReadAllBytes(full);
            if (bytes == null || AppUpdater.HashBytes(bytes) != old.sha256.ToLower()) { continue; }
            File.Delete(full);
            if (File.Exists(full)) { return false; }
        }
        return true;
    }

    static bool SamePath(string a, string b) {
        #if WINDOWS
        return Path.GetFullPath(a).Replace("\\", "/").ToLower() == Path.GetFullPath(b).Replace("\\", "/").ToLower();
        #else
        return Path.GetFullPath(a) == Path.GetFullPath(b);
        #endif
    }

    // target is bound by UpdateBootstrap to the opened original process image.
    // Key selection remains independent installed host configuration.
    static int BootstrapPending(string target, string pending, string manifestHash, bool install) {
        string configured = Environment.GetEnvironmentVariable("ZAN_APP_DIR");
        if (configured.Length > 0 && !IdeFileSync.SamePath(configured, target)) { return 0; }
        string config = Environment.GetEnvironmentVariable("ZAN_IDE_CONFIG_DIR");
        if (config.Length == 0) { config = target + "/config"; }
        if (!IdeFileSync.SamePath(pending, config + "/pending-sync")
            || !AppUpdater.SafeDestination(pending, "manifest.json")
            || !AppUpdater.SafeDestination(pending, "release.zip")
            || AppUpdater.HashBytes(File.ReadAllBytes(pending + "/manifest.json")) != manifestHash) { return 0; }
        UpdateManifest manifest = UpdateManifest.LoadFromFile(pending + "/manifest.json");
        if (!IdeSyncPlan.Trusted(manifest) || !File.Exists(pending + "/release.zip")
            || File.GetSize64(pending + "/release.zip") != manifest.packageSize
            || AppUpdater.HashBytes(File.ReadAllBytes(pending + "/release.zip")) != manifest.packageSha256.ToLower()) { return 0; }
        if (!install) { return 1; }
        return IdeFileSync.ApplyPendingAt(target, pending);
    }

    // 0: nothing staged; 1: acknowledged handoff; -1: fail closed before UI.
    static int BootstrapStart(string[] args) {
        try {
            if (!Directory.Exists(IdeFileSync.PendingDir())) { return 0; }
            #if WINDOWS
            // Resolve inherited local configuration before changing the helper cwd.
            string keyset = Environment.GetEnvironmentVariable("ZAN_UPDATE_PUBLIC_KEYSET_FILE");
            string key = Environment.GetEnvironmentVariable("ZAN_UPDATE_PUBLIC_KEY_FILE");
            if (keyset.Length == 0 && key.Length == 0) { return -1; }
            if (keyset.Length > 0) { Environment.SetEnvironmentVariable("ZAN_UPDATE_PUBLIC_KEYSET_FILE", Path.GetFullPath(keyset)); }
            if (key.Length > 0) { Environment.SetEnvironmentVariable("ZAN_UPDATE_PUBLIC_KEY_FILE", Path.GetFullPath(key)); }
            string config = Environment.GetEnvironmentVariable("ZAN_IDE_CONFIG_DIR");
            if (config.Length > 0) { Environment.SetEnvironmentVariable("ZAN_IDE_CONFIG_DIR", Path.GetFullPath(config)); }
            string root = Environment.GetEnvironmentVariable("ZAN_APP_DIR");
            if (root.Length > 0) { Environment.SetEnvironmentVariable("ZAN_APP_DIR", Path.GetFullPath(root)); }
            string pending = IdeFileSync.PendingDir();
            UpdateManifest manifest = UpdateManifest.LoadFromFile(pending + "/manifest.json");
            if (!IdeSyncPlan.Trusted(manifest)) { return -1; }
            if (!UpdateBootstrap.Begin(ZanIDE.BaseDir(), pending, Path.GetTempPath() + "/Zan.AppUpdate", manifest, args)) { return -1; }
            return 1;
            #else
            Console.WriteLine("Staged IDE update requires an external bootstrap on this platform.");
            return -1;
            #endif
        } catch (Exception ex) { return -1; }
    }

    static int ApplyPending() { return IdeFileSync.ApplyPendingAt(ZanIDE.BaseDir(), IdeFileSync.PendingDir()); }

    static int ApplyPendingAt(string root, string pending) {
        if (!Directory.Exists(pending)) { return 0; }
        try {
            if (!AppUpdater.SafeDestination(pending, "manifest.json")
                || !AppUpdater.SafeDestination(pending, "release.zip")) { return 0; }
            UpdateManifest manifest = UpdateManifest.LoadFromFile(pending + "/manifest.json");
            if (!IdeSyncPlan.Trusted(manifest)) { return 0; }
            string installed = "update.installed.manifest.json";
            if (!AppUpdater.SafeDestination(root, installed)) { return 0; }
            UpdateManifest previous = UpdateManifest.LoadFromFile(root + "/" + installed);
            if (File.Exists(root + "/" + installed) && !IdeSyncPlan.Trusted(previous)) { return 0; }
            // ApplyPackage verifies the signature, ZIP SHA-256, full inventory and
            // every entry before its journalled install begins. Failure leaves staging for retry.
            if (!AppUpdater.ApplyPackage(pending + "/release.zip", manifest, root, true, null)) { return 0; }
            if (!IdeFileSync.RemoveObsolete(root, previous, manifest)) { return 0; }
            if (!AppUpdater.SafeDestination(root, installed + ".tmp")) { return 0; }
            manifest.SaveToFile(root + "/" + installed + ".tmp");
            File.Move(root + "/" + installed + ".tmp", root + "/" + installed);
            File.Delete(pending + "/manifest.json");
            File.Delete(pending + "/release.zip");
            Directory.Delete(pending);
            return manifest.files.Count;
        } catch (Exception ex) { return 0; }
    }
}
