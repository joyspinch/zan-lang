using System;
using System.Collections.Generic;
using System.Json;

// 节点内的开发任务清单（图上一个节点＝一块功能，节点里的这份清单＝把这块
// 功能做出来要干的活）。
public class AiTaskPlan {
    public static void ReadItems(JsonDoc doc, int node, AiTask t) {
        if (node < 0 || doc.KindAt(node) != 4) { return; }
        List<AiPlanStep> outp = new List<AiPlanStep>();
        int it = doc.FirstChild(node);
        while (it >= 0) {
            string txt = "";
            bool done = false;
            if (doc.KindAt(it) == 5) {
                txt = doc.Str(it, "t", doc.Str(it, "text", ""));
                done = doc.Bool(it, "d", doc.Bool(it, "done", false));
            } else if (doc.KindAt(it) == 3) {
                txt = doc.StrAt(it, "");
                if (txt.Length >= 4) {
                    string pre = txt.Substring(0, 4);
                    if (pre == "[x] " || pre == "[X] ") {
                        done = true;
                        txt = txt.Substring(4, txt.Length - 4);
                    } else if (pre == "[ ] ") {
                        txt = txt.Substring(4, txt.Length - 4);
                    }
                }
            }
            txt = AiAgent.Trim(txt);
            if (txt != "") {
                int d = 0;
                if (done) { d = 1; }
                if (d == 0 && AiTaskPlan.WasDone(t, txt)) { d = 1; }
                outp.Add(AiPlanStep.Create(txt, d));
            }
            it = doc.NextSibling(it);
        }
        if (outp.Count > 0) {
            t.items = outp;
        }
    }

    // 这条活在节点原来的清单里已经打过勾了吗（按文本认人）。
    static bool WasDone(AiTask t, string text) {
        if (t == null || t.items == null) { return false; }
        for (int i = 0; i < t.items.Count; i = i + 1) {
            if (t.items[i].text == text) { return t.items[i].done != 0; }
        }
        return false;
    }

    // 节点清单里打过勾的条数。
    static int DoneOf(AiTask t) {
        int n = 0;
        if (t == null || t.items == null) { return 0; }
        for (int i = 0; i < t.items.Count; i = i + 1) {
            if (t.items[i].done != 0) { n = n + 1; }
        }
        return n;
    }

    static int CountOf(AiTask t) {
        if (t == null || t.items == null) { return 0; }
        return t.items.Count;
    }

    // 「3/7」这样的一小段，没有清单时返回 ""。
    static string Brief(AiTask t) {
        int n = AiTaskPlan.CountOf(t);
        if (n == 0) { return ""; }
        return Convert.ToString(AiTaskPlan.DoneOf(t)) + "/"
            + Convert.ToString(n);
    }

    // 节点清单换成百分比，封顶 95：清单全打勾也只是「活干完了」，最后那一
    // 档留给验收（和 AiTeam.ApplyToTasks 里同一个规矩）。
    static int PctOf(AiTask t) {
        int n = AiTaskPlan.CountOf(t);
        if (n == 0) { return 0; }
        int pct = AiTaskPlan.DoneOf(t) * 95 / n;
        return pct;
    }

    // 一个还没验收的节点最多能显示到多少：打过勾的那些是实打实的，再加上
    // 「正在做的那一条」最多算一条的份额。没有这一条，清单 0/5 的节点也能
    // 因为这一次交付的拍数跑满而显示 95%——用户看到的就是「计划一条都没勾，
    // 上面却快到头了」。清单为空时没有可对账的东西，只能信拍数。
    static int CapOf(AiTask t) {
        int n = AiTaskPlan.CountOf(t);
        if (n == 0) { return 95; }
        int d = AiTaskPlan.DoneOf(t) + 1;
        if (d > n) { d = n; }
        return d * 95 / n;
    }

    // 清单进度加上手上这一条干到哪儿了：拍数（读代码 → 改 → 编译 → 验证）
    // 只按比例折进当前那一条的份额里，所以百分比永远跟勾选数对得上。
    static int WithRun(AiTask t, int runPct) {
        int n = AiTaskPlan.CountOf(t);
        if (n == 0) {
            if (runPct > 95) { return 95; }
            return runPct;
        }
        int d = AiTaskPlan.DoneOf(t);
        int got = d * 95 / n;
        if (d >= n) { return got; }
        return got + (95 / n) * runPct / 100;
    }

    // 节点验收通过时把清单一次勾完：活儿确实做完了（验收看的就是这个节点的
    // 验收标准），卡片却写着「已完成 0/5」只会让人以为漏了活。
    static void MarkAllDone(AiTask t) {
        if (t == null || t.items == null) { return; }
        for (int i = 0; i < t.items.Count; i = i + 1) {
            t.items[i].done = 1;
        }
    }

    // 把每个节点自己的清单进度折进它自己的百分比：多个节点各自有各自的
    // 完成度，正是这一步让它们互不影响。只往前推，且不替验收宣布完成。
    static void Fold(List<AiTask> tasks) {
        if (tasks == null) { return; }
        for (int i = 0; i < tasks.Count; i = i + 1) {
            AiTask t = tasks[i];
            if (t.state == AiTeam.TaskDone()) { continue; }
            int pct = AiTaskPlan.PctOf(t);
            if (pct > t.progress) { t.progress = pct; }
        }
    }

    // 图签名里代表清单的那一段（条数 + 每条的勾选位）：清单变了要重画卡片、
    // 要落盘，所以它得进签名。
    static string SigOf(AiTask t) {
        StringBuilder sb = new StringBuilder();
        int n = AiTaskPlan.CountOf(t);
        sb.Append(Convert.ToString(n));
        for (int i = 0; i < n; i = i + 1) {
            sb.Append(Convert.ToString(t.items[i].done));
        }
        return sb.ToString();
    }

    // 一份可以直接绑到界面上的清单副本（节点没有清单时是空表，绝不返回
    // null）。返回节点自己那份列表本身：面板上的勾选就是改这个节点的活。
    static List<AiPlanStep> ItemsOf(AiTask t) {
        if (t == null || t.items == null) { return new List<AiPlanStep>(); }
        return t.items;
    }
}
