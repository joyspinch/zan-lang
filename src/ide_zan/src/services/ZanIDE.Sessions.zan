using System;
using System.IO;
using System.Diagnostics;
using System.Json;
using System.Threading;
using Gui;

// 接口数据协议与执行契约。
partial class ZanIDE {
    IdeAiSessionWork aiSessionWork = new IdeAiSessionWork();
    IdeAiSessionContext aiSessionContext;
    List<IdeAiSessionImage> aiSessionImages = new List<IdeAiSessionImage>();
    AtomicInt aiSessionVersion = new AtomicInt(0);
    AtomicInt aiSessionClosing = new AtomicInt(0);
    CancellationTokenSource aiSessionLoads = new CancellationTokenSource();
    int aiSessionLoadSequence;
    int aiSessionSaveSequence;
    int aiRunLoadSequence;
    bool aiSessionPending;
    bool aiSessionDrafts;
    string aiSessionLastError = "";

    string AiSessionsDbPath() {
        if (!haveProject || root == "") { return ZanIDE.SharedSessionsDbPath(); }
        return ZanIDE.CacheDir() + "/sessions/" + ZanIDE.PathKey(root) + ".db";
    }

    static string SharedSessionsDbPath() { return ZanIDE.CacheDir() + "/ai_sessions.db"; }

    // 接口数据协议与执行契约。
    static void CloseSessDb() { }

    static string PathKey(string path) {
        string leaf = ZanIDE.SanitizeName(Path.GetFileName(path));
        if (leaf == "") { leaf = "project"; }
        long h = 2166136261;
        for (int i = 0; i < path.Length; i = i + 1) {
            int b = path[i];
            if (b >= 65 && b <= 90) { b = b + 32; }
            if (b == 92) { b = 47; }
            h = (h ^ b) * 16777619;
            h = h & 0xFFFFFFFF;
        }
        return leaf + "_" + Convert.ToString(h);
    }

    // 接口数据协议与执行契约。
    int AiSessionVersion() { return (int)aiSessionVersion.Load(); }
    bool IsAiSessionVersion(int version) { return (int)aiSessionVersion.Load() == version; }
    string AiSessionWorkError() { return aiSessionWork.Error(); }
    int AiCancelledSessionLoads() { return aiSessionWork.CancelledLoads(); }

    IdeAiSessionContext NewAiSessionContext() {
        IdeAiSessionContext context = new IdeAiSessionContext();
        context.path = this.AiSessionsDbPath();
        context.checkpoint = this.AiRunCheckpointPath();
        context.root = root;
        context.project = haveProject;
        context.shared = ZanIDE.SharedSessionsDbPath();
        context.sharedArchive = ZanIDE.CacheDir() + "/ai_sessions.pre-project.db";
        context.legacy = ZanIDE.UserConfigDir() + "/ai_sessions.json";
        return context;
    }

    bool AiSessionMatches(IdeAiSessionContext context, int version) {
        return context != null && this.IsAiSessionVersion(version) && aiSessionContext == context
            && root == context.root && haveProject == context.project;
    }

    void AiSessionChanged() {
        aiSessionVersion.Increment();
        aiSaveSig = "";
        if (aiSessionPending) { aiSessionDrafts = true; }
    }

    void RememberAiSessionCurrent() {
        if (aiSessions == null || aiSessCur < 0 || aiSessCur >= aiSessions.Count) { return; }
        while (aiSessionImages.Count < aiSessions.Count) { aiSessionImages.Add(null); }
        IdeAiSessionImage image = IdeAiSessionImage.Capture(this.AiCtxProject(), aiPlan,
            aiTeamMode, aiTeamSt, aiTasks, aiRun);
        aiSessionImages[aiSessCur] = image;
        aiSessions[aiSessCur].derived = ChatArea.FirstUserOf(image.messages);
        if (aiSessionPending && image.HasContent()) { aiSessionDrafts = true; }
    }

    List<IdeAiSessionEntry> CaptureAiSessionEntries() {
        this.RememberAiSessionCurrent();
        List<IdeAiSessionEntry> entries = new List<IdeAiSessionEntry>();
        for (int i = 0; i < aiSessions.Count; i = i + 1) {
            IdeAiSessionEntry entry = new IdeAiSessionEntry();
            entry.pack = aiSessions[i].pack;
            entry.archived = aiSessions[i].archived;
            entry.title = aiSessions[i].title;
            entry.derived = aiSessions[i].derived;
            entry.image = aiSessionImages[i];
            entries.Add(entry);
            if (aiSessionPending && (entry.title != "" || entry.archived != 0)) { aiSessionDrafts = true; }
        }
        return entries;
    }

    // 接口数据协议与执行契约。
    void AutosaveAiSessions(int nowMs) {
        if (!Dispatcher.CheckUiThread()) {
            int version = this.AiSessionVersion();
            App host = app;
            if (host != null) { host.Post(delegate () {
                if (this.IsAiSessionVersion(version)) { this.AutosaveAiSessions(nowMs); }
            }, "Sessions.Autosave"); }
            return;
        }
        if (aiSessions == null || aiSessCur < 0 || aiSessCur >= aiSessions.Count) { return; }
        int gap = 1000;
        if (aiBusy.Get() == 1 && aiStreamMsgIdx >= 0 && aiStreamMsgIdx == aiMsgs.Count - 1) { gap = 5000; }
        if (nowMs - aiLastSave <= gap) { return; }
        aiLastSave = nowMs;
        string sig = this.AiLiveSig();
        if (sig == aiSaveSig) { return; }
        aiSaveSig = sig;
        this.SaveAiSession(aiSessCur);
    }

    string AiLiveSig() {
        StringBuilder sb = new StringBuilder();
        sb.Append(Convert.ToString(aiMsgs.Count));
        if (aiMsgs.Count > 0) {
            ChatMessage tail = aiMsgs[aiMsgs.Count - 1];
            sb.Append(":" + Convert.ToString(tail.text.Length)
                + "/" + Convert.ToString(tail.reason.Length)
                + "/" + tail.role + "/" + tail.agent
                + "/" + Convert.ToString(tail.kind)
                + "/" + Convert.ToString(tail.progress));
        }
        sb.Append(":" + Convert.ToString(AiAgent.Compactions())
            + "/" + Convert.ToString(AiAgent.LastDroppedOf(aiRunAgent)));
        sb.Append(":" + Convert.ToString(aiPlan.Count));
        for (int p = 0; p < aiPlan.Count; p = p + 1) { sb.Append(Convert.ToString(aiPlan[p].done)); }
        sb.Append(":" + Convert.ToString(aiTasks.Count));
        for (int t = 0; t < aiTasks.Count; t = t + 1) {
            sb.Append("/" + aiTasks[t].id + "@" + Convert.ToString(aiTasks[t].state)
                + ":" + Convert.ToString(aiTasks[t].progress));
        }
        if (aiTeamMode) { sb.Append(":team"); }
        if (aiTeamSt != null) { sb.Append(":" + aiTeamSt.activeTask); }
        if (aiRun != null) {
            sb.Append(":" + aiRun.taskId + "/" + Convert.ToString(aiRun.phase)
                + "/" + Convert.ToString(aiRun.DoneCount())
                + "/" + Convert.ToString(aiRun.ChangedFileCount())
                + "/" + Convert.ToString(aiRun.TotalAdds())
                + "/" + Convert.ToString(aiRun.TotalDels()));
        }
        return sb.ToString();
    }

    // 接口数据协议与执行契约。
    static string AiSessTitleOf(AiSession session) { return session.derived; }

    void SaveAiSession(int index) { this.SaveAiSession(index, this.AiSessionVersion()); }

    void SaveAiSession(int index, int version) {
        if (!Dispatcher.CheckUiThread()) {
            App host = app;
            if (host != null) { host.Post(delegate () { this.SaveAiSession(index, version); }); }
            return;
        }
        if (!this.IsAiSessionVersion(version)) { return; }
        if (aiSessions == null || index < 0 || index >= aiSessions.Count) { return; }
        this.QueueAiSessionSave(index);
    }

    void SaveAiSessions() { this.SaveAiSessions(this.AiSessionVersion()); }

    // 接口数据协议与执行契约。
    void SaveAiSessions(int version) {
        if (!Dispatcher.CheckUiThread()) {
            App host = app;
            if (host != null) { host.Post(delegate () { this.SaveAiSessions(version); }); }
            return;
        }
        if (!this.IsAiSessionVersion(version) || aiSessions == null) { return; }
        this.QueueAiSessionSave(-1);
    }

    void QueueAiSessionSave(int index) {
        if (aiSessionContext == null) {
            aiSessionContext = this.NewAiSessionContext();
            aiSessDbPath = aiSessionContext.path;
        }
        IdeAiSessionContext context = aiSessionContext;
        int version = this.AiSessionVersion();
        aiSessionSaveSequence = aiSessionSaveSequence + 1;
        int sequence = aiSessionSaveSequence;
        IdeAiSessionRequest request = new IdeAiSessionRequest();
        request.kind = index < 0 ? 0 : 1;
        request.context = context;
        request.index = index;
        request.entries = this.CaptureAiSessionEntries();
        request.current = aiSessCur;
        request.mergeBaseline = aiSessionPending;
        request.hasDrafts = aiSessionDrafts;
        request.host = app;
        request.completed = delegate (IdeAiSessionResult result) {
            if (!this.AiSessionMatches(context, version) || sequence != aiSessionSaveSequence) { return; }
            if (result.error != "") { this.ReportAiSessionError(result.error); aiSaveSig = ""; return; }
            if (aiSessionPending || result.entries.Count != aiSessions.Count) { return; }
            for (int i = 0; i < result.entries.Count; i = i + 1) {
                aiSessions[i].pack = result.entries[i].pack;
                aiSessions[i].derived = result.entries[i].derived;
                aiSessions[i].derivedLen = result.entries[i].pack.Length;
            }
        };
        if (!aiSessionWork.Enqueue(request)) { aiSaveSig = ""; }
    }

    void ReportAiSessionError(string error) {
        aiSessionLastError = error;
        Layer.Msg(ZanIDE.T("Chat storage failed: ", "会话存储失败：") + error, 5);
    }

    // 接口数据协议与执行契约。
    async void DrainAiSessionWorkAsync() {
        TaskCompletionSource<int> completion = aiSessionWork.Seal();
        await completion.Task;
    }

    // 接口数据协议与执行契约。
    void CancelAiSessionLoads() {
        if (!Dispatcher.CheckUiThread()) {
            App host = app;
            if (host != null) { host.Post(delegate () { this.CancelAiSessionLoads(); }); }
            return;
        }
        aiSessionLoads.Cancel();
        aiSessionLoads = new CancellationTokenSource();
        aiSessionLoadSequence = aiSessionLoadSequence + 1;
        aiRunLoadSequence = aiRunLoadSequence + 1;
        aiSessionVersion.Increment();
    }

    static List<int> ParseFlagCsv(string csv) {
        List<int> flags = new List<int>();
        string current = "";
        for (int i = 0; i <= csv.Length; i = i + 1) {
            string ch = "";
            if (i < csv.Length) { ch = csv.Substring(i, 1); }
            if (ch == "," || i == csv.Length) {
                if (current != "") { flags.Add(ZanIDE.ParseIntSafe(current) != 0 ? 1 : 0); }
                current = "";
            } else { current = current + ch; }
        }
        return flags;
    }

    void LoadAiSessions() {
        if (!Dispatcher.CheckUiThread()) {
            int version = this.AiSessionVersion();
            App host = app;
            if (host != null) { host.Post(delegate () {
                if (this.IsAiSessionVersion(version)) { this.LoadAiSessions(); }
            }); }
            return;
        }
        // 接口数据协议与执行契约。
        if (aiSessionContext != null && aiSessions != null) { this.QueueAiSessionSave(-1); }
        this.CancelAiSessionLoads();
        IdeAiSessionContext context = this.NewAiSessionContext();
        aiSessionContext = context;
        aiSessDbPath = context.path;
        aiSessionPending = true;
        aiSessionDrafts = false;
        aiSessions = new List<AiSession>();
        aiSessions.Add(AiSession.Create("", 0));
        aiSessionImages = new List<IdeAiSessionImage>();
        aiSessionImages.Add(IdeAiSessionImage.Empty());
        aiSessCur = 0;
        this.UseAiSessionImage(aiSessionImages[0]);
        this.AiResetContextState();
        if (aiSessNav != null) { aiSessNav.CancelRename(); }
        int sequence = aiSessionLoadSequence;
        IdeAiSessionRequest request = new IdeAiSessionRequest();
        request.kind = 2;
        request.context = context;
        request.cancellation = aiSessionLoads.Token;
        request.host = app;
        request.completed = delegate (IdeAiSessionResult result) {
            if (result.cancelled || sequence != aiSessionLoadSequence || aiSessionContext != context
                || root != context.root || haveProject != context.project) { return; }
            this.ApplyAiSessionLoad(result);
        };
        aiSessionWork.Enqueue(request);
    }

    void ApplyAiSessionLoad(IdeAiSessionResult result) {
        if (result.error != "") { this.ReportAiSessionError(result.error); return; }
        List<IdeAiSessionEntry> drafts = this.CaptureAiSessionEntries();
        bool keepDrafts = aiSessionDrafts;
        int current = result.current;
        List<IdeAiSessionEntry> entries = IdeAiSessionWork.CopyEntries(result.entries);
        if (keepDrafts) {
            current = entries.Count + aiSessCur;
            for (int i = 0; i < drafts.Count; i = i + 1) { entries.Add(drafts[i]); }
        }
        if (entries.Count == 0) {
            IdeAiSessionEntry entry = new IdeAiSessionEntry();
            entry.image = IdeAiSessionImage.Empty();
            entries.Add(entry);
            current = 0;
        }
        if (current < 0 || current >= entries.Count) { current = 0; }
        IdeAiSessionImage active = entries[current].image;
        if (active == null) { active = IdeAiSessionImage.Empty(); entries[current].image = active; }
        if (!keepDrafts && active.run == null && result.run != null && active.messages.Count > 0) {
            active = active.Copy();
            active.run = IdeAiSessionImage.CopyRun(result.run);
            entries[current].image = active;
        }
        aiSessions = new List<AiSession>();
        aiSessionImages = new List<IdeAiSessionImage>();
        for (int i = 0; i < entries.Count; i = i + 1) {
            AiSession session = AiSession.Create(entries[i].pack, entries[i].archived);
            session.title = entries[i].title;
            session.derived = entries[i].derived;
            session.derivedLen = session.pack.Length;
            aiSessions.Add(session);
            aiSessionImages.Add(entries[i].image);
        }
        aiSessCur = current;
        aiSessionPending = false;
        aiSessionDrafts = false;
        // 接口数据协议与执行契约。
        if (!keepDrafts) {
            this.UseAiSessionImage(active);
            this.AiSessionChanged();
        }
        this.QueueAiRunCheckpoint();
        if (keepDrafts) { this.SaveAiSessions(); }
        if (app != null) { app.RequestRedraw(); }
    }

    void AdoptProjectChats() {
        if (!Dispatcher.CheckUiThread()) {
            int version = this.AiSessionVersion();
            App host = app;
            if (host != null) { host.Post(delegate () {
                if (this.IsAiSessionVersion(version)) { this.AdoptProjectChats(); }
            }); }
            return;
        }
        if (aiSessions == null) { return; }
        if (this.AiSessionsDbPath() == aiSessDbPath) { return; }
        this.LoadAiSessions();
    }

    void UseAiSessionImage(IdeAiSessionImage image) {
        IdeAiSessionImage live = image.Copy();
        aiMsgs = live.messages;
        aiPlan = live.plan;
        aiTeamMode = live.team.on == 1;
        aiTeamSt = live.team.st;
        aiTasks = live.team.tasks;
        aiRun = live.run;
        aiRunAgent = "";
        aiHandoffs = 0;
        AiAgent.ResetCompaction();
        this.AiForgetTools();
        aiIdleKey = ""; aiIdleTimes = 0; aiEscKey = ""; aiRevKey = ""; aiRevTimes = 0;
        aiSaveSig = ""; aiCacheKey = ""; aiCacheSig = "";
        aiToolOpen = new List<int>();
    }

    void UseAiSessionCurrent(int index) {
        if (index < 0 || index >= aiSessions.Count) { return; }
        aiSessCur = index;
        this.UseAiSessionImage(aiSessionImages[index]);
        this.QueueAiRunCheckpoint();
    }

    // 接口数据协议与执行契约。
    string AiPackCur() {
        IdeAiSessionImage image = IdeAiSessionImage.Capture(this.AiCtxProject(), aiPlan,
            aiTeamMode, aiTeamSt, aiTasks, aiRun);
        return image.Pack();
    }

    void AiRestoreSession(string pack) {
        this.UseAiSessionImage(IdeAiSessionImage.Read(pack));
        this.QueueAiRunCheckpoint();
    }

    void QueueAiRunCheckpoint() {
        if (aiSessionContext == null) { aiSessionContext = this.NewAiSessionContext(); }
        aiRunLoadSequence = aiRunLoadSequence + 1;
        IdeAiSessionRequest request = new IdeAiSessionRequest();
        request.kind = 3;
        request.context = aiSessionContext;
        request.run = IdeAiSessionImage.CopyRun(aiRun);
        int version = this.AiSessionVersion();
        IdeAiSessionContext context = aiSessionContext;
        request.host = app;
        request.completed = delegate (IdeAiSessionResult result) {
            if (this.AiSessionMatches(context, version) && result.error != "") { this.ReportAiSessionError(result.error); }
        };
        aiSessionWork.Enqueue(request);
    }

    void RequestAiRunLoad(bool restore, string json) {
        if (aiSessionContext == null) { aiSessionContext = this.NewAiSessionContext(); }
        aiRunLoadSequence = aiRunLoadSequence + 1;
        int sequence = aiRunLoadSequence;
        int version = this.AiSessionVersion();
        IdeAiSessionContext context = aiSessionContext;
        IdeAiSessionRequest request = new IdeAiSessionRequest();
        request.kind = 4;
        request.context = context;
        request.restoreCheckpoint = restore;
        request.packedRun = json;
        request.cancellation = aiSessionLoads.Token;
        request.host = app;
        request.completed = delegate (IdeAiSessionResult result) {
            if (result.cancelled || !this.AiSessionMatches(context, version) || sequence != aiRunLoadSequence) { return; }
            if (result.error != "") { this.ReportAiSessionError(result.error); return; }
            aiRun = IdeAiSessionImage.CopyRun(result.run);
        };
        aiSessionWork.Enqueue(request);
    }
}
