using System;
using System.IO;
using System.Net.Http.Client;
using System.Net.External;
using System.Net.Sockets;

public class MarketplaceClient {
    static string host;
    static int port;
    static bool tls;
    static string path;
    static string savePath;
    static int operation;
    static SseSink sink;
    static List<long> workers;
    static bool closing;

    static int FindByte(string s, int b, int from) {
        for (int i = from; i < s.Length; i = i + 1) {
            if ((s[i] & 255) == b) { return i; }
        }
        return 0 - 1;
    }

    static int ParseInt(string s, int fallback) {
        int v = 0;
        bool any = false;
        for (int i = 0; i < s.Length; i = i + 1) {
            int c = s[i] & 255;
            if (c < 48 || c > 57) { return fallback; }
            v = v * 10 + c - 48;
            any = true;
        }
        if (!any) { return fallback; }
        return v;
    }

    static void SetUrl(string url) {
        string u = url;
        MarketplaceClient.tls = true;
        int defaultPort = 443;
        if (u.Length >= 8 && u.Substring(0, 8) == "https://") {
            u = u.Substring(8, u.Length - 8);
        } else if (u.Length >= 7 && u.Substring(0, 7) == "http://") {
            MarketplaceClient.tls = false;
            defaultPort = 80;
            u = u.Substring(7, u.Length - 7);
        }
        int slash = FindByte(u, 47, 0);
        string hostPort = u;
        MarketplaceClient.path = "/";
        if (slash >= 0) {
            hostPort = u.Substring(0, slash);
            MarketplaceClient.path = u.Substring(slash, u.Length - slash);
        }
        MarketplaceClient.host = hostPort;
        MarketplaceClient.port = defaultPort;
        int colon = FindByte(hostPort, 58, 0);
        if (colon >= 0) {
            MarketplaceClient.host = hostPort.Substring(0, colon);
            MarketplaceClient.port = ParseInt(hostPort.Substring(colon + 1,
                hostPort.Length - colon - 1), defaultPort);
        }
    }

    static string BaseUrl() {
        string u = ProcessHost.Env("ZAN_MALL_URL");
        if (u == "") { return "https://ide.zanlang.top"; }
        while (u.Length > 0 && u.Substring(u.Length - 1, 1) == "/") {
            u = u.Substring(0, u.Length - 1);
        }
        return u;
    }

    // Marketplace 请求的统一外部调用预算。默认 endpoint 是本机
    // HTTP 服务；其它 HTTP 目标不获得明文例外，必须使用 HTTPS。
    static ExternalCallPolicy CallPolicy() {
        ExternalCallPolicy policy = ExternalCallPolicy.Default()
            .TotalTimeout(15000)
            .ResponseLimit(16 * 1024 * 1024)
            .StreamLimit(16 * 1024 * 1024)
            .Redirects(0)
            .RetryNetwork(false)
            .RetryAttempts(0);
        bool loopback = ExternalTargetPolicy.IsLoopback(MarketplaceClient.host);
        if (loopback) {
            if (!MarketplaceClient.tls) { policy.AllowLocalHttp(); }
            else { policy.AllowLoopback(); }
        }
        return policy;
    }

    static async void Worker(SseSink target, HttpClient client, string requestPath,
        int op, string targetPath) {
        Socket.Initialize();
        string result = "";
        try {
            result = await client.GetAsync(requestPath);
            if (op == 3 && result != "") {
                File.WriteAllText(targetPath, result);
                result = "saved:" + targetPath;
            }
        } catch (Exception ex) {
            target.Publish("err:" + ex.Message);
            return;
        }
        if (result == "") {
            target.Publish("err:empty response");
            return;
        }
        target.Publish("ok:" + result);
    }

    static void BeginShutdown() { MarketplaceClient.closing = true; }

    static async void DrainAsync() {
        MarketplaceClient.BeginShutdown();
        if (MarketplaceClient.workers != null) { await Task.WhenAll(MarketplaceClient.workers); }
        MarketplaceClient.sink = null;
    }

    static string Start(int op, string suffix, string targetPath) {
        if (MarketplaceClient.closing) { return "IDE is closing"; }
        if (MarketplaceClient.sink != null
            && MarketplaceClient.sink.Done() == "") {
            return "request already running";
        }
        MarketplaceClient.operation = op;
        MarketplaceClient.savePath = targetPath;
        MarketplaceClient.SetUrl(MarketplaceClient.BaseUrl() + suffix);
        SseSink s = SseSink.ToMemory();
        MarketplaceClient.sink = s;
        HttpClient client;
        if (MarketplaceClient.tls) {
            client = HttpClient.CreateHttps(MarketplaceClient.host, MarketplaceClient.port);
        } else {
            client = new HttpClient(MarketplaceClient.host, MarketplaceClient.port);
        }
        client.SetCallPolicy(MarketplaceClient.CallPolicy());
        client.SetTimeout(15000);
        if (MarketplaceClient.workers == null) { MarketplaceClient.workers = new List<long>(); }
        long worker = Task.Run(MarketplaceClient.Worker(s, client, MarketplaceClient.path, op, targetPath));
        MarketplaceClient.workers.Add(worker);
        return "";
    }

    static string StartCatalog() {
        return MarketplaceClient.Start(1, "/api/mall/catalog", "");
    }

    static string StartProduct(string id) {
        return MarketplaceClient.Start(2, "/api/mall/product?id=" + id, "");
    }

    static string StartDownload(string artifactUrl, string targetPath) {
        string path = artifactUrl;
        if (path.Length == 0 || path.Substring(0, 1) != "/") { path = "/" + path; }
        return MarketplaceClient.Start(3, path, targetPath);
    }

    static string Done() {
        if (MarketplaceClient.sink == null) { return ""; }
        return MarketplaceClient.sink.Done();
    }

    static void Clear() {
        MarketplaceClient.sink = null;
    }
}
