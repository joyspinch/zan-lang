using System;

/// 单个改动文件的变更记录实体（聚合路径与增/删行数，取代原本的平行列表）
class AiFileChange {
    public string path;
    public int adds;
    public int dels;

    AiFileChange(string path, int adds, int dels) {
        this.path = path != null ? path : "";
        this.adds = adds;
        this.dels = dels;
    }

    string Label() {
        if (this.adds <= 0 && this.dels <= 0) { return this.path; }
        return this.path + "  +" + Convert.ToString(this.adds)
            + " -" + Convert.ToString(this.dels);
    }
}

/// 一次改动的行数变化：增加了几行、删除了几行。
class AiLineDelta {
    int adds;
    int dels;

    static AiLineDelta Of(int adds, int dels) {
        AiLineDelta d = new AiLineDelta();
        d.adds = adds;
        if (d.adds < 0) { d.adds = 0; }
        d.dels = dels;
        if (d.dels < 0) { d.dels = 0; }
        return d;
    }
}

/// 「这一轮改了哪些文件、每个文件动了多少行」这一份账。
///
/// 单独一个文件是因为它是一件独立的事：状态机（`AiRun.zan`）管的是十二拍怎么
/// 走，这里管的是改动清单——面板上那句 `src/ide_zan/src/views/PlanStrip.zan
/// +12 -4` 里的每个数字都出自这里，而它们又必须跟着检查点一起落盘。
partial class AiRun {
    /// 记一个被改动的文件（去重）——交付摘要和「改了什么」都靠它。行数未知
    /// 时记 0/0：写工具还没执行完的那一刻就是这种情况。
    void NoteChangedFile(string path) {
        this.NoteChangedFile(path, 0, 0);
    }

    /// 记一个被改动的文件连同这次的增 / 删行数。同一个文件被改多次就累加：
    /// 「本轮改了什么」问的是这一轮总共动了多少行，不是最后一次动了多少。
    void NoteChangedFile(string path, int adds, int dels) {
        if (path == "") { return; }
        if (this.changes == null) { this.changes = new List<AiFileChange>(); }
        int at = 0 - 1;
        for (int i = 0; i < this.changes.Count; i = i + 1) {
            if (this.changes[i].path == path) { at = i; break; }
        }
        if (at < 0) {
            this.changes.Add(new AiFileChange(path, 0, 0));
            at = this.changes.Count - 1;
        }
        AiFileChange fc = this.changes[at];
        if (adds > 0) {
            fc.adds = fc.adds + adds;
        }
        if (dels > 0) {
            fc.dels = fc.dels + dels;
        }
        this.RebuildChangedLabels();
    }

    /// 改动文件路径列表提取器（按需派生，避免冗余维护平行列表）。
    List<string> ChangedPaths() {
        List<string> outp = new List<string>();
        if (this.changes != null) {
            for (int i = 0; i < this.changes.Count; i = i + 1) {
                outp.Add(this.changes[i].path);
            }
        }
        return outp;
    }

    /// 改动文件数量。
    int ChangedFileCount() {
        if (this.changes == null) { return 0; }
        return this.changes.Count;
    }

    /// 改动清单显示用的那几行。行数都是 0（旧检查点，或者写工具报错什么都没
    /// 落地）时只显示路径，不写一个假的 +0 -0。
    ///
    /// 每次记账重建一整份、并且换成新的列表对象：清单每帧都要显示，界面正是
    /// 靠「列表对象换了没有」决定要不要重新绑定，所以这里不做原地改。
    void RebuildChangedLabels() {
        List<string> outp = new List<string>();
        if (this.changes != null) {
            for (int i = 0; i < this.changes.Count; i = i + 1) {
                outp.Add(this.changes[i].Label());
            }
        }
        this.changedLabels = outp;
    }

    static string ChangedLabel(string path, int adds, int dels) {
        if (adds <= 0 && dels <= 0) { return path; }
        return path + "  +" + Convert.ToString(adds)
            + " -" + Convert.ToString(dels);
    }

    int AddsAt(int i) {
        if (this.changes == null || i < 0 || i >= this.changes.Count) { return 0; }
        return this.changes[i].adds;
    }

    int DelsAt(int i) {
        if (this.changes == null || i < 0 || i >= this.changes.Count) { return 0; }
        return this.changes[i].dels;
    }

    /// 这一轮总共增加 / 删除了多少行——改动清单表头那句 `+40 -12`。
    int TotalAdds() {
        int n = 0;
        if (this.changes != null) {
            for (int i = 0; i < this.changes.Count; i = i + 1) {
                n = n + this.changes[i].adds;
            }
        }
        return n;
    }

    int TotalDels() {
        int n = 0;
        if (this.changes != null) {
            for (int i = 0; i < this.changes.Count; i = i + 1) {
                n = n + this.changes[i].dels;
            }
        }
        return n;
    }
}
