using System;
using System.IO;
using System.Diagnostics;
using System.Json;
using System.Threading;
using System.Net.Sockets;

// 核心契约与执行状态转移规范。
// 接口数据协议与执行契约。

class DapRequest {
    int seq;
    string type;
    string command;
    JsonValue arguments;
}

class DapInitArgs {
    string clientID;
    string adapterID;
    bool linesStartAt1;
    bool columnsStartAt1;
}

class DapLaunchArgs {
    string program;
    bool stopOnEntry;
}

class DapSource {
    string path;
}

class DapBreakpoint {
    int line;
    string condition;   // "" = plain breakpoint (adapter treats it as unset)
}

class DapSetBreakpointsArgs {
    DapSource source;
    List<DapBreakpoint> breakpoints;
}

class DapEvaluateArgs {
    string expression;
    int frameId;
    string context;
}

class DapThreadArgs {
    int threadId;
}

class DapDisconnectArgs {
    bool terminateDebuggee;
}

class DapStackTraceArgs {
    int threadId;
    int startFrame;
    int levels;
}

class DapScopesArgs {
    int frameId;
}

class DapVariablesArgs {
    int variablesReference;
}

// 接口数据协议与执行契约。

class DapFrame {
    int id;
    string name;
    int line;
    DapSource source;
}

class DapStackBody {
    List<DapFrame> stackFrames;
}

class DapStackResponse {
    DapStackBody body;
}

class DapVar {
    string name;
    string value;
    string type;
}

class DapVarsBody {
    List<DapVar> variables;
}

class DapVarsResponse {
    DapVarsBody body;
}

class DapScope {
    int variablesReference;
}

class DapScopesBody {
    List<DapScope> scopes;
}

class DapScopesResponse {
    DapScopesBody body;
}

class DapEvalResponse {
    bool success;
    JsonValue body;
}

class DapEvent {
    string type;
    string event;
    JsonValue body;
}

// 接口数据协议与执行契约。
class DebugSession {
    #if WINDOWS
    [DllImport("ws2_32", EntryPoint = "WSAStartup")]
    static extern int ws_startup(int version, string data);
    [DllImport("ws2_32", EntryPoint = "socket")]
    static extern int ws_socket(int af, int type, int proto);
    [DllImport("ws2_32", EntryPoint = "connect")]
    static extern int ws_connect(int s, string addr, int len);
    [DllImport("ws2_32", EntryPoint = "closesocket")]
    static extern int ws_close(int s);
    [DllImport("ws2_32", EntryPoint = "send")]
    static extern int ws_send(int s, string buf, int len, int flags);
    [DllImport("ws2_32", EntryPoint = "recv")]
    static extern int ws_recv(int s, string buf, int len, int flags);
    [DllImport("ws2_32", EntryPoint = "htons")]
    static extern int ws_htons(int v);
    [DllImport("ws2_32", EntryPoint = "inet_addr")]
    static extern int ws_inet_addr(string cp);
    [DllImport("kernel32", EntryPoint = "Sleep")]
    static extern void plat_sleep(int ms);
    #else
    [DllImport("crt", EntryPoint = "socket")]
    static extern int ws_socket(int af, int type, int proto);
    [DllImport("crt", EntryPoint = "connect")]
    static extern int ws_connect(int s, string addr, int len);
    [DllImport("crt", EntryPoint = "close")]
    static extern int ws_close(int s);
    [DllImport("crt", EntryPoint = "send")]
    static extern int ws_send(int s, string buf, int len, int flags);
    [DllImport("crt", EntryPoint = "recv")]
    static extern int ws_recv(int s, string buf, int len, int flags);
    [DllImport("crt", EntryPoint = "htons")]
    static extern int ws_htons(int v);
    [DllImport("crt", EntryPoint = "inet_addr")]
    static extern int ws_inet_addr(string cp);
    [DllImport("crt", EntryPoint = "usleep")]
    static extern int plat_usleep(int us);
    #endif
    [DllImport("crt")]
    static extern int strlen(string str);

    nint sock;
    CancellationToken cancellation;
    CancellationTokenSource interrupted = new CancellationTokenSource();
    int seq;
    bool paused;
    bool alive;
    int curLine;
    int exitCode;
    int frameId;
    string curFile;
    string rbuf;
    List<DbgVar> locals;
    List<DbgFrame> stack;
    List<string> console;

    // ---- lifecycle --------------------------------------------------------

    // 接口数据协议与执行契约。
    static DebugSession Open(int port, string program, string source,
            List<DbgBreakpoint> bps, CancellationToken cancellation = null) {
        DebugSession d = new DebugSession();
        d.cancellation = cancellation;
        d.sock = 0 - 1;
        d.seq = 1;
        d.paused = false;
        d.alive = false;
        d.curLine = 0;
        d.exitCode = 0;
        d.frameId = 0;
        d.curFile = "";
        d.rbuf = "";
        d.locals = new List<DbgVar>();
        d.stack = new List<DbgFrame>();
        d.console = new List<string>();

        Socket.Initialize();
        // 接口数据协议与执行契约。
        bool connected = false;
        for (int tries = 0; tries < 100 && !connected && !d.Cancelled(); tries = tries + 1) {
            nint s = Socket.socket(2, 1, 6);
            if (s < 0) { return null; }
            d.sock = s;
            if (Socket.SetNonBlocking(s) != 0) { d.Stop(); return null; }
            byte[] addr = d.BuildAddr(port);
            int status = Socket.SysConnect(s, addr, 16);
            if (status == 0) { connected = true; }
            else {
                status = Socket.ConnectStatus(s);
                while (status == -2 && !d.Cancelled()) {
                    d.SnoozeMs(20);
                    status = Socket.ConnectStatus(s);
                }
                connected = status == 0 && !d.Cancelled();
            }
            if (!connected) { d.Stop(); d.SnoozeMs(20); }
        }
        if (!connected) { d.Stop(); return null; }
        d.alive = true;

        d.Request("initialize", DebugSession.InitArgs());
        d.AwaitResponse("initialize");
        d.AwaitEvent("initialized");
        DapLaunchArgs launch = new DapLaunchArgs();
        launch.program = program;
        launch.stopOnEntry = false;
        d.Request("launch", Json.Serialize<DapLaunchArgs>(launch));
        d.AwaitResponse("launch");
        d.Request("setBreakpoints", d.BpJson(source, bps));
        d.AwaitResponse("setBreakpoints");
        d.Request("configurationDone", "");
        d.AwaitResponse("configurationDone");
        d.PumpUntilStop();
        return d;
    }

    void SnoozeMs(int ms) {
        #if WINDOWS
        plat_sleep(ms);
        #else
        plat_usleep(ms * 1000);
        #endif
    }

    byte[] BuildAddr(int port) {
        byte[] addr = new byte[16];
        #if MACOS
        addr[0] = 16;
        addr[1] = 2;
        #else
        addr[0] = 2;
        addr[1] = 0;
        #endif
        int nport = ws_htons(port);
        addr[2] = (byte)(nport & 255);
        addr[3] = (byte)((nport >> 8) & 255);
        int ip = ws_inet_addr("127.0.0.1");
        addr[4] = (byte)(ip & 255);
        addr[5] = (byte)((ip >> 8) & 255);
        addr[6] = (byte)((ip >> 16) & 255);
        addr[7] = (byte)((ip >> 24) & 255);
        return addr;
    }

    static string InitArgs() {
        DapInitArgs o = new DapInitArgs();
        o.clientID = "zanide";
        o.adapterID = "zan";
        o.linesStartAt1 = true;
        o.columnsStartAt1 = true;
        return Json.Serialize<DapInitArgs>(o);
    }

    string BpJson(string source, List<DbgBreakpoint> bps) {
        DapSetBreakpointsArgs o = new DapSetBreakpointsArgs();
        o.source = new DapSource();
        o.source.path = source;
        o.breakpoints = new List<DapBreakpoint>();
        for (int i = 0; i < bps.Count; i = i + 1) {
            DapBreakpoint bp = new DapBreakpoint();
            bp.line = bps[i].line;
            bp.condition = bps[i].cond;
            o.breakpoints.Add(bp);
        }
        return Json.Serialize<DapSetBreakpointsArgs>(o);
    }

    // 核心契约与执行状态转移规范。

    bool Paused() { return this.paused; }
    bool Alive() { return this.alive; }
    int CurLine() { return this.curLine; }
    int ExitCode() { return this.exitCode; }
    string CurFile() { return this.curFile; }
    List<DbgVar> Locals() { return this.locals; }
    List<DbgFrame> Stack() { return this.stack; }
    List<string> Console() { return this.console; }

    void Continue() { this.Resume("continue"); }
    void StepOver() { this.Resume("next"); }
    void StepIn() { this.Resume("stepIn"); }
    void StepOut() { this.Resume("stepOut"); }

    // 接口数据协议与执行契约。
    // 核心契约与执行状态转移规范。
    string Evaluate(string expr) {
        if (!this.alive || !this.paused) { return ""; }
        DapEvaluateArgs args = new DapEvaluateArgs();
        args.expression = expr;
        args.frameId = this.frameId;
        args.context = "watch";
        this.Request("evaluate", Json.Serialize<DapEvaluateArgs>(args));
        string m = this.AwaitResponseMsg("evaluate");
        if (m.Length == 0) { return "<error>"; }
        DapEvalResponse r = Json.Deserialize<DapEvalResponse>(m);
        if (r == null || !r.success || r.body == null) { return "<error>"; }
        return r.body.Str("result", "");
    }

    void Resume(string cmd) {
        if (!this.alive) { this.paused = false; return; }
        this.paused = false;
        DapThreadArgs args = new DapThreadArgs();
        args.threadId = 1;
        this.Request(cmd, Json.Serialize<DapThreadArgs>(args));
        this.AwaitResponse(cmd);
        this.PumpUntilStop();
    }

    bool Cancelled() {
        return interrupted.Token.IsCancellationRequested
            || (cancellation != null && cancellation.IsCancellationRequested);
    }

    // 接口数据协议与执行契约。
    void CancelWait() { interrupted.Cancel(); }

    void Stop() {
        if (this.sock >= 0) {
            if (this.alive) {
                DapDisconnectArgs args = new DapDisconnectArgs();
                args.terminateDebuggee = true;
                DapRequest request = new DapRequest();
                request.seq = this.seq;
                request.type = "request";
                request.command = "disconnect";
                request.arguments = JsonValue.ParseLenient(Json.Serialize<DapDisconnectArgs>(args));
                string body = Json.Serialize<DapRequest>(request);
                string message = "Content-Length: " + Convert.ToString(strlen(body)) + "\r\n\r\n" + body;
                // 接口数据协议与执行契约。
                long sent = Socket.ReactorSend(this.sock, message, strlen(message), 0);
            }
            Socket.ReactorCloseNotify(this.sock);
            Socket.SysClose(this.sock);
            this.sock = -1;
        }
        this.alive = false;
        this.paused = false;
    }

    // 接口数据协议与执行契约。

    void SendAll(string data) {
        int total = strlen(data);
        int off = 0;
        while (off < total && !this.Cancelled()) {
            string chunk = data;
            if (off > 0) { chunk = data.Substring(off, total - off); }
            long n = Socket.ReactorSend(this.sock, chunk, total - off, 0);
            if (n == -1) { this.SnoozeMs(20); continue; }
            if (n <= 0) { this.alive = false; return; }
            off = off + (int)n;
        }
        if (this.Cancelled()) { this.alive = false; }
    }

    void SendMsg(string body) {
        string msg = "Content-Length: " + Convert.ToString(strlen(body))
            + "\r\n\r\n" + body;
        this.SendAll(msg);
    }

    void Request(string cmd, string argsJson) {
        DapRequest o = new DapRequest();
        o.seq = this.seq;
        o.type = "request";
        o.command = cmd;
        if (argsJson.Length > 0) {
            o.arguments = JsonValue.ParseLenient(argsJson);
        }
        this.seq = this.seq + 1;
        this.SendMsg(Json.Serialize<DapRequest>(o));
    }

    string RecvChunk() {
        int cap = 65536;
        byte[] buf = new byte[cap + 1];
        while (!this.Cancelled()) {
            long n = Socket.ReactorRecv(this.sock, buf, cap, 0);
            if (n == -1) { this.SnoozeMs(20); continue; }
            if (n <= 0) { return ""; }
            return buf.ToStr(0, (int)n);
        }
        return "";
    }

    // 接口数据协议与执行契约。
    string ReadMsg() {
        int guard = 0;
        while (guard < 1000000) {
            guard = guard + 1;
            int he = DebugSession.IndexOf(this.rbuf, "\r\n\r\n", 0);
            if (he >= 0) {
                string header = this.rbuf.Substring(0, he);
                int cl = DebugSession.HeaderLen(header);
                int start = he + 4;
                if (cl >= 0 && this.rbuf.Length >= start + cl) {
                    string body = this.rbuf.Substring(start, cl);
                    int rest = this.rbuf.Length - start - cl;
                    this.rbuf = this.rbuf.Substring(start + cl, rest);
                    return body;
                }
            }
            string chunk = this.RecvChunk();
            if (chunk.Length == 0) { this.alive = false; return ""; }
            this.rbuf = this.rbuf + chunk;
        }
        return "";
    }

    // 核心契约与执行状态转移规范。

    // 接口数据协议与执行契约。
    // 核心契约与语义定义。
    void Aside(string m) {
        DapEvent ev = Json.Deserialize<DapEvent>(m);
        if (ev == null) { return; }
        if (ev.event == "output") {
            string txt = "";
            if (ev.body != null) { txt = ev.body.Str("output", ""); }
            if (txt.Length > 0) { this.console.Add(DebugSession.RTrimNl(txt)); }
        } else if (ev.event == "exited") {
            int ec = 0;
            if (ev.body != null) { ec = ev.body.Int("exitCode", 0); }
            this.exitCode = ec;
            this.alive = false;
            this.paused = false;
        } else if (ev.event == "terminated") {
            this.alive = false;
            this.paused = false;
        }
    }

    // 接口数据协议与执行契约。
    // `value`（树解析取值，杜绝引号子串匹配——值里含引号或字段名
    // 是别的键的子串时，子串匹配会误判）。
    static bool FieldIs(string m, string key, string value) {
        JsonValue v = null;
        try { v = JsonValue.ParseLenient(m); } catch (Exception) { v = null; }
        if (v == null || !v.IsObject()) { return false; }
        return v.Str(key, "") == value;
    }

    string AwaitResponseMsg(string cmd) {
        int guard = 0;
        while (guard < 100000) {
            guard = guard + 1;
            string m = this.ReadMsg();
            if (m.Length == 0) { return ""; }
            if (DebugSession.FieldIs(m, "type", "response")
                && DebugSession.FieldIs(m, "command", cmd)) {
                return m;
            }
            this.Aside(m);
        }
        return "";
    }

    void AwaitResponse(string cmd) {
        this.AwaitResponseMsg(cmd);
    }

    void AwaitEvent(string name) {
        int guard = 0;
        while (guard < 100000) {
            guard = guard + 1;
            string m = this.ReadMsg();
            if (m.Length == 0) { return; }
            if (DebugSession.FieldIs(m, "event", name)) {
                return;
            }
            this.Aside(m);
        }
    }

    // 接口数据协议与执行契约。
    // 核心契约与语义定义。
    void PumpUntilStop() {
        int guard = 0;
        while (guard < 100000) {
            guard = guard + 1;
            string m = this.ReadMsg();
            if (m.Length == 0) { this.alive = false; this.paused = false; return; }
            if (DebugSession.FieldIs(m, "event", "stopped")) {
                this.paused = true;
                this.Refresh();
                return;
            }
            if (DebugSession.FieldIs(m, "event", "exited")
                || DebugSession.FieldIs(m, "event", "terminated")) {
                this.Aside(m);
                this.paused = false;
                return;
            }
            this.Aside(m);
        }
    }

    // 接口数据协议与执行契约。
    void Refresh() {
        while (this.stack.Count > 0) { this.stack.RemoveAt(this.stack.Count - 1); }
        while (this.locals.Count > 0) { this.locals.RemoveAt(this.locals.Count - 1); }
        this.frameId = 0;
        this.curLine = 0;
        this.curFile = "";

        DapStackTraceArgs stArgs = new DapStackTraceArgs();
        stArgs.threadId = 1;
        stArgs.startFrame = 0;
        stArgs.levels = 64;
        this.Request("stackTrace", Json.Serialize<DapStackTraceArgs>(stArgs));
        string st = this.AwaitResponseMsg("stackTrace");
        this.ParseFrames(st);

        DapScopesArgs scArgs = new DapScopesArgs();
        scArgs.frameId = this.frameId;
        this.Request("scopes", Json.Serialize<DapScopesArgs>(scArgs));
        string sc = this.AwaitResponseMsg("scopes");
        int reff = 0;
        DapScopesResponse scR = Json.Deserialize<DapScopesResponse>(sc);
        if (scR != null && scR.body != null && scR.body.scopes != null
                && scR.body.scopes.Count > 0) {
            reff = scR.body.scopes[0].variablesReference;
        }
        if (reff != 0) {
            DapVariablesArgs vArgs = new DapVariablesArgs();
            vArgs.variablesReference = reff;
            this.Request("variables", Json.Serialize<DapVariablesArgs>(vArgs));
            string vs = this.AwaitResponseMsg("variables");
            this.ParseVariables(vs);
        }
    }

    // 接口数据协议与执行契约。
    void ParseFrames(string m) {
        if (m.Length == 0) { return; }
        DapStackResponse r = Json.Deserialize<DapStackResponse>(m);
        if (r == null || r.body == null || r.body.stackFrames == null) { return; }
        bool first = true;
        for (int i = 0; i < r.body.stackFrames.Count; i = i + 1) {
            DapFrame f = r.body.stackFrames[i];
            string name = f.name;
            if (name.Length == 0) { name = "?"; }
            this.stack.Add(DbgFrame.Create(name, f.line));
            if (first) {
                this.frameId = f.id;
                this.curLine = f.line;
                if (f.source != null) { this.curFile = f.source.path; }
                first = false;
            }
        }
    }

    // 接口数据协议与执行契约。
    // 核心契约与语义定义。
    void ParseVariables(string m) {
        if (m.Length == 0) { return; }
        DapVarsResponse r = Json.Deserialize<DapVarsResponse>(m);
        if (r == null || r.body == null || r.body.variables == null) { return; }
        for (int i = 0; i < r.body.variables.Count; i = i + 1) {
            DapVar v = r.body.variables[i];
            this.locals.Add(new DbgVar(v.name, v.type, v.value));
        }
    }

    // 接口数据协议与执行契约。

    static int IndexOf(string hay, string needle, int from) {
        int hl = hay.Length;
        int nl = needle.Length;
        if (nl == 0) { return from; }
        int i = from;
        if (i < 0) { i = 0; }
        while (i + nl <= hl) {
            if (hay.Substring(i, nl) == needle) { return i; }
            i = i + 1;
        }
        return 0 - 1;
    }

    static int HeaderLen(string header) {
        int idx = DebugSession.IndexOf(header, "Content-Length:", 0);
        if (idx < 0) { idx = DebugSession.IndexOf(header, "content-length:", 0); }
        if (idx < 0) { return 0 - 1; }
        int p = idx + 15;
        int hl = header.Length;
        while (p < hl && header[p] == 32) { p = p + 1; }
        int val = 0;
        bool any = false;
        while (p < hl && header[p] >= 48 && header[p] <= 57) {
            val = val * 10 + (header[p] - 48);
            any = true;
            p = p + 1;
        }
        if (!any) { return 0 - 1; }
        return val;
    }

    static string RTrimNl(string s) {
        int e = s.Length;
        while (e > 0) {
            int c = s[e - 1];
            if (c == 10 || c == 13) { e = e - 1; }
            else { break; }
        }
        return s.Substring(0, e);
    }
}
