using System;
using System.IO;
using System.Collections.Generic;
using System.Text;
using System.Json;

// AI 离线知识库检索、官方示例库检索与本地包生态发现服务
partial class AiAgent {

    static string KnowledgeDir() {
        string a = ZanIDE.BaseDir() + "/knowledge";
        if (Directory.Exists(a)) { return a; }
        string b = ZanIDE.BaseDir() + "/../knowledge";
        if (Directory.Exists(b)) { return b; }
        return "";
    }

    static string PackagesDir() {
        string a = ZanIDE.BaseDir() + "/packages";
        if (Directory.Exists(a)) { return a; }
        string b = ZanIDE.BaseDir() + "/packages_cache";
        if (Directory.Exists(b)) { return b; }
        string c = ZanIDE.BaseDir() + "/../packages";
        if (Directory.Exists(c)) { return c; }
        return "";
    }

    static string PkgList(string root) {
        string pkgDir = root + "/.zan-packages";
        if (!Directory.Exists(pkgDir)) {
            JsonWriter emptyW = new JsonWriter();
            emptyW.StartObject();
            emptyW.WriteKey("installed");
            emptyW.StartArray();
            emptyW.EndArray();
            emptyW.WriteProperty("count", 0);
            emptyW.WriteProperty("tip", "No packages installed in this project (.zan-packages/ does not exist).");
            emptyW.EndObject();
            return emptyW.ToJson();
        }
        JsonWriter w = new JsonWriter();
        w.StartObject();
        w.WriteKey("installed");
        w.StartArray();
        List<string> subdirs = Directory.GetDirectories(pkgDir);
        for (int i = 0; i < subdirs.Count; i = i + 1) {
            string name = subdirs[i];
            string d = pkgDir + "/" + name;
            string manifestPath = d + "/zan.pkg";
            string ver = "1.0.0";
            string desc = "";
            if (File.Exists(manifestPath)) {
                JsonDoc.ParseScoped(File.ReadAllText(manifestPath), (JsonDoc doc) => {
                    ver = doc.Str(0, "version", "1.0.0");
                    desc = doc.Str(0, "description", "");
                });
            }
            w.StartObject();
            w.WriteProperty("name", name);
            w.WriteProperty("version", ver);
            w.WriteProperty("description", desc);
            w.WriteProperty("path", ".zan-packages/" + name);
            w.EndObject();
        }
        w.EndArray();
        w.WriteProperty("count", subdirs.Count);
        w.EndObject();
        return w.ToJson();
    }

    static string PkgSearch(string query) {
        string kdir = AiAgent.KnowledgeDir();
        string catalogPath = kdir + "/packages-catalog.json";
        JsonWriter w = new JsonWriter();
        w.StartObject();
        w.WriteKey("packages");
        w.StartArray();
        int count = 0;
        if (File.Exists(catalogPath)) {
            JsonDoc.ParseScoped(File.ReadAllText(catalogPath), (JsonDoc root) => {
                if (root.KindAt(0) != 4) { return; }
                string qLower = query.ToLower();
                int p = root.FirstChild(0);
                while (p >= 0) {
                    if (root.KindAt(p) == 5) {
                        string name = root.Str(p, "name", "");
                        string desc = root.Str(p, "description", "");
                        bool match = query == ""
                            || ZanIDE.IndexOfStr(name.ToLower(), qLower) >= 0
                            || ZanIDE.IndexOfStr(desc.ToLower(), qLower) >= 0;
                        if (!match) {
                            int nsArr = root.Get(p, "namespaces");
                            if (nsArr >= 0 && root.KindAt(nsArr) == 4) {
                                int it = root.FirstChild(nsArr);
                                while (it >= 0) {
                                    if (ZanIDE.IndexOfStr(root.StrAt(it, "").ToLower(), qLower) >= 0) {
                                        match = true;
                                        break;
                                    }
                                    it = root.NextSibling(it);
                                }
                            }
                        }
                        if (match) {
                            w.StartObject();
                            w.WriteProperty("name", name);
                            w.WriteProperty("version", root.Str(p, "version", "1.0.0"));
                            w.WriteProperty("description", desc);
                            w.EndObject();
                            count = count + 1;
                        }
                    }
                    p = root.NextSibling(p);
                }
            });
        } else {
            string pkgsDir = AiAgent.PackagesDir();
            if (pkgsDir != "" && Directory.Exists(pkgsDir)) {
                List<string> subs = Directory.GetDirectories(pkgsDir);
                string qLower = query.ToLower();
                for (int i = 0; i < subs.Count; i = i + 1) {
                    string name = subs[i];
                    if (query == "" || ZanIDE.IndexOfStr(name.ToLower(), qLower) >= 0) {
                        w.StartObject();
                        w.WriteProperty("name", name);
                        w.WriteProperty("version", "1.0.0");
                        w.WriteProperty("description", "Discovered in local packages/ cache");
                        w.EndObject();
                        count = count + 1;
                    }
                }
            }
        }
        w.EndArray();
        w.WriteProperty("count", count);
        w.EndObject();
        return w.ToJson();
    }

    static void CopyDir(string src, string dest) {
        Directory.CreateDirectoryRecursive(dest);
        List<string> files = Directory.GetFileNames(src);
        for (int i = 0; i < files.Count; i = i + 1) {
            string dstFile = dest + "/" + files[i];
            if (File.Exists(dstFile)) { File.Delete(dstFile); }
            File.Copy(src + "/" + files[i], dstFile);
        }
        List<string> dirs = Directory.GetDirectories(src);
        for (int i = 0; i < dirs.Count; i = i + 1) {
            AiAgent.CopyDir(src + "/" + dirs[i], dest + "/" + dirs[i]);
        }
    }

    static string PkgInstall(string root, string name) {
        if (name == "") { return "error: 'name' is required (e.g. 'Zan.Gui.Charts')"; }
        string pkgsDir = AiAgent.PackagesDir();
        if (pkgsDir == "") { return "error: local packages repository/cache not found."; }
        string srcPkg = pkgsDir + "/" + name;
        if (!Directory.Exists(srcPkg)) {
            return "error: package '" + name + "' not found in " + pkgsDir;
        }
        string dstPkg = root + "/.zan-packages/" + name;
        try {
            AiAgent.CopyDir(srcPkg, dstPkg);
            JsonWriter w = new JsonWriter();
            w.StartObject();
            w.WriteProperty("ok", true);
            w.WriteProperty("package", name);
            w.WriteProperty("path", ".zan-packages/" + name);
            w.WriteProperty("message", "Package installed into project successfully.");
            w.EndObject();
            return w.ToJson();
        } catch (Exception e) {
            return "error: failed to install package " + name + ": " + e.Message;
        }
    }

    static string ShippedFile(string rel) {
        string a = ZanIDE.BaseDir() + "/" + rel;
        if (File.Exists(a)) { return a; }
        string b = ZanIDE.BaseDir() + "/../" + rel;
        if (File.Exists(b)) { return b; }
        return "";
    }

    static string ApiSearch(string query, int limit) {
        if (AiAgent.Trim(query) == "") {
            return "error: 'query' is required (a symbol fragment, e.g."
                + " \"Button\" or \"App.Create\").";
        }
        string kdir = AiAgent.KnowledgeDir();
        if (kdir == "") {
            return "error: the knowledge index was not found next to the IDE"
                + " (expected knowledge/symbols.json). Use stdlib_grep instead.";
        }
        string idx = kdir + "/symbols.json";
        if (!File.Exists(idx)) {
            return "error: knowledge/symbols.json is missing. Use stdlib_grep"
                + " instead.";
        }
        if (limit <= 0) { limit = 40; }
        string q = ZanIDE.ToLowerS(query);
        List<string> lines = File.ReadAllLines(idx);
        StringBuilder sb = new StringBuilder();
        int found = 0;
        for (int i = 0; i < lines.Count; i = i + 1) {
            if (found >= limit) { break; }
            string line = lines[i];
            if (ZanIDE.IndexOfStr(line, "\"name\"") < 0) { continue; }
            if (ZanIDE.IndexOfStr(ZanIDE.ToLowerS(line), q) < 0) { continue; }
            string rec = AiAgent.Trim(line);
            if (rec.Length > 0 && rec.Substring(rec.Length - 1, 1) == ",") {
                rec = rec.Substring(0, rec.Length - 1);
            }
            sb.Append(rec);
            sb.Append("\n");
            found = found + 1;
        }
        if (found == 0) {
            return "no symbol matched \"" + query + "\". Try a shorter fragment"
                + " (e.g. \"Button\", \"App.Create\", \"Gauge\"), or use"
                + " stdlib_grep.";
        }
        return "api_search \"" + query + "\" -- " + Convert.ToString(found)
            + " match(es), each {name,kind,file,line,sig}:\n" + sb.ToString();
    }

    static string Example(string topic) {
        string kdir = AiAgent.KnowledgeDir();
        if (kdir == "") {
            return "error: the knowledge catalog was not found next to the IDE"
                + " (expected knowledge/gallery.json).";
        }
        string gp = kdir + "/gallery.json";
        if (!File.Exists(gp)) {
            return "error: knowledge/gallery.json is missing.";
        }
        string result = "";
        JsonDoc.ParseScoped(File.ReadAllText(gp), (JsonDoc man) => {
            if (man.KindAt(0) != 5) {
                result = "error: knowledge/gallery.json is not valid JSON.";
                return;
            }
            int entries = man.Get(0, "entries");
            if (entries < 0 || man.KindAt(entries) != 4) {
                result = "error: knowledge/gallery.json has no 'entries' array.";
                return;
            }
            string want = AiAgent.Trim(topic);
            if (want == "") {
                StringBuilder sb = new StringBuilder();
                sb.Append("example catalog -- call example {\"topic\":\"<one"
                    + " below>\"} to get the verbatim file(s):\n");
                int e = man.FirstChild(entries);
                while (e >= 0) {
                    if (man.KindAt(e) == 5) {
                        sb.Append("- " + man.Str(e, "topic", "") + "  [" + man.Str(e, "kind", "")
                            + "]  " + man.Str(e, "summary", "") + "\n");
                    }
                    e = man.NextSibling(e);
                }
                result = sb.ToString();
                return;
            }
            int match = -1;
            int cur = man.FirstChild(entries);
            while (cur >= 0) {
                if (man.KindAt(cur) == 5 && man.Str(cur, "topic", "") == want) {
                    match = cur;
                    break;
                }
                cur = man.NextSibling(cur);
            }
            if (match < 0) {
                string wLower = want.ToLower();
                cur = man.FirstChild(entries);
                while (cur >= 0) {
                    if (man.KindAt(cur) == 5 && ZanIDE.IndexOfStr(man.Str(cur, "topic", "").ToLower(), wLower) >= 0) {
                        match = cur;
                        break;
                    }
                    cur = man.NextSibling(cur);
                }
            }
            if (match < 0) {
                result = "error: no example for topic '" + topic + "'. Call example"
                    + " with no topic to list the catalog.";
                return;
            }
            string kind = man.Str(match, "kind", "");
            StringBuilder sbMatch = new StringBuilder();
            sbMatch.Append("example topic \"" + man.Str(match, "topic", "") + "\" [" + kind
                + "]: " + man.Str(match, "summary", "") + "\n");
            string bld = man.Str(match, "build", "");
            if (bld != "") { sbMatch.Append("build: " + bld + "\n"); }
            int models = man.Get(0, "models");
            if (models >= 0 && man.KindAt(models) == 5) {
                string mod = man.Str(models, kind, "");
                if (mod != "") { sbMatch.Append("model: " + mod + "\n"); }
            }
            int files = man.Get(match, "files");
            if (files >= 0 && man.KindAt(files) == 4) {
                int f = man.FirstChild(files);
                while (f >= 0) {
                    string rel = man.StrAt(f, "");
                    sbMatch.Append("\n===== " + rel + " =====\n");
                    string full = AiAgent.ShippedFile(rel);
                    if (full == "") {
                        sbMatch.Append("(file missing next to the IDE)\n");
                    } else {
                        sbMatch.Append(File.ReadAllText(full));
                        sbMatch.Append("\n");
                    }
                    f = man.NextSibling(f);
                }
            }
            result = sbMatch.ToString();
        });
        return result;
    }
}
