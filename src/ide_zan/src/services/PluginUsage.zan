using System;
using System.IO;
using System.Json;
using System.Net.Http.Client;
using System.Net.External;
using System.Net.Sockets;

/// <summary>商业插件使用账目的 IDE 侧执行面（账本，不是闸门）。
/// zanc 在两类时刻会往 stderr 打一条 ZANPKG_USAGE 行（该包 zan.pkg 带
/// plugin_id 时）：
/// 安装：ZANPKG_USAGE plugin_id=<id> package=<name> scope=project
/// 构建：ZANPKG_USAGE plugin_id=<id> package=<name> action=build
/// IDE 的输出面板与安装日志都从 zanc 的捕获输出流经 log 列表——
/// PluginUsage.Observe(line) 挂在两处日志入口上，命中即记账。
/// 上报纪律（平台侧"发布后不记录、服务器零压力"原则的客户端形态）：
/// - 异步旁路：入队即返回，网络线程 fire-and-forget，失败静默留队；
/// - 去重：同 (plugin_id, 本机, 当天) 只报一次（dev_day 文件存当天已报集）；
/// - 批量：队列攒满 8 条或距上次发送超过 10 分钟才发一次 ingest；
/// - 上限：本地队列封顶 256 条，满了丢最老的——账本允许有洞。
/// 没登录/没网/商城不可达都完全不影响任何功能。</summary>
class PluginUsage {
    /// 待上报队列（逐条 JSON 行）。
    static List<string> queue;
    /// 当天已上报的 plugin_id 集（与 dev_day 文件同步持久化）。
    static List<string> reportedToday;
    /// dev_day 文件里记的日期（yyyyMMdd），换天即清 reportedToday。
    static string dayStamp;
    /// 上次触发发送的时刻（Stopwatch ms）。
    static Stopwatch sendClock;
    static bool sendBusy;

    static string T(string en, string zh) { return Lang.Tr(en, zh); }

    /// 本机指纹：用户名 + 机器名的 SHA-256 前 16 hex。平台只拿这个
    /// 稳定哈希做聚合，原始主机信息不出机器。
    static string MachineFp() {
        string raw = KnownFolders.UserName() + "@" + KnownFolders.ComputerName();
        return Hex.Encode(Sha256.Hash(raw, raw.Length), 32).Substring(0, 16);
    }

    static string StateDir() {
        return ZanIDE.UserConfigDir() + "/plugin-usage";
    }

    static string QueuePath() { return StateDir() + "/queue.jsonl"; }
    static string DayPath() { return StateDir() + "/dev_day.txt"; }

    /// 今天 yyyyMMdd（账本按天去重的键）。
    static string Today() {
        DateTime d = DateTime.Now();
        return "" + d.Year() + Pad2(d.Month()) + Pad2(d.Day());
    }

    static string Pad2(int n) {
        return n < 10 ? "0" + Convert.ToString(n) : Convert.ToString(n);
    }

    /// 装载持久状态（队列 + 当天已报集）。惰性，首次 Observe 时跑。
    static void EnsureLoaded() {
        if (PluginUsage.queue != null) { return; }
        PluginUsage.queue = new List<string>();
        PluginUsage.reportedToday = new List<string>();
        PluginUsage.dayStamp = PluginUsage.Today();
        try {
            if (File.Exists(DayPath())) {
                List<string> parts = ZanIDE.SplitLinesOf(File.ReadAllText(DayPath()));
                if (parts.Count > 0) { PluginUsage.dayStamp = parts[0].Trim(); }
                for (int i = 1; i < parts.Count; i = i + 1) {
                    string id = parts[i].Trim();
                    if (id.Length > 0) { PluginUsage.reportedToday.Add(id); }
                }
            }
            if (PluginUsage.dayStamp != PluginUsage.Today()) {
                PluginUsage.reportedToday.Clear();
                PluginUsage.dayStamp = PluginUsage.Today();
            }
            if (File.Exists(QueuePath())) {
                List<string> lines = ZanIDE.SplitLinesOf(File.ReadAllText(QueuePath()));
                for (int i = 0; i < lines.Count; i = i + 1) {
                    string ln = lines[i].Trim();
                    if (ln.Length > 0) { PluginUsage.queue.Add(ln); }
                }
            }
        } catch (Exception ex) {
            // 状态读不出来就从空开始：账本坏了不能影响 IDE。
        }
    }

    static void Persist() {
        try {
            Directory.CreateDirectoryRecursive(StateDir());
            StringBuilder sb = new StringBuilder();
            sb.Append(PluginUsage.dayStamp);
            for (int i = 0; i < PluginUsage.reportedToday.Count; i = i + 1) {
                sb.Append("\n");
                sb.Append(PluginUsage.reportedToday[i]);
            }
            File.WriteAllText(DayPath(), sb.ToString());
            StringBuilder qb = new StringBuilder();
            for (int i = 0; i < PluginUsage.queue.Count; i = i + 1) {
                qb.Append(PluginUsage.queue[i]);
                qb.Append("\n");
            }
            File.WriteAllText(QueuePath(), qb.ToString());
        } catch (Exception ex) {
            // 同上：持久化失败只影响本次账目的完整性。
        }
    }
    /// <summary>喂一条日志行（构建输出/安装输出里任意一行）。命中
    /// ZANPKG_USAGE 就记账并尝试触发上报；其余行直接返回。</summary>
    static void Observe(string line) {
        if (line == null || line.Length < 14) { return; }
        int at = line.IndexOf("ZANPKG_USAGE");
        if (at < 0) { return; }
        PluginUsage.EnsureLoaded();
        string pluginId = PluginUsage.Field(line, "plugin_id");
        if (pluginId.Length == 0) { return; }
        string action = PluginUsage.Field(line, "action");
        if (action.Length == 0) { action = "install"; }
        // 当天同插件只记一次（install/build 都算"用过"）。
        for (int i = 0; i < PluginUsage.reportedToday.Count; i = i + 1) {
            if (PluginUsage.reportedToday[i] == pluginId) { return; }
        }
        PluginUsage.reportedToday.Add(pluginId);
        if (PluginUsage.dayStamp != PluginUsage.Today()) {
            PluginUsage.dayStamp = PluginUsage.Today();
            PluginUsage.reportedToday.Clear();
            PluginUsage.reportedToday.Add(pluginId);
        }
        JsonValue o = JsonValue.NewObject();
        o.Put("plugin_id", JsonValue.NewStr(pluginId));
        o.Put("action", JsonValue.NewStr(action));
        o.Put("machine_fp", JsonValue.NewStr(MachineFp()));
        o.Put("day", JsonValue.NewStr(PluginUsage.dayStamp));
        o.Put("ide_version", JsonValue.NewStr(IdeVersion.Number()));
        string pkg = PluginUsage.Field(line, "package");
        if (pkg.Length > 0) { o.Put("package", JsonValue.NewStr(pkg)); }
        PluginUsage.queue.Add(o.ToJson());
        // 队列封顶：丢最老的（账本允许有洞）。
        while (PluginUsage.queue.Count > 256) { PluginUsage.queue.RemoveAt(0); }
        PluginUsage.Persist();
        PluginUsage.MaybeSend();
    }

    /// "ZANPKG_USAGE plugin_id=x package=y action=build" 里取一个键值。
    static string Field(string line, string key) {
        string needle = key + "=";
        int at = line.IndexOf(needle);
        if (at < 0) { return ""; }
        int start = at + needle.Length;
        int end = start;
        while (end < line.Length && line[end] != ' '
            && line[end] != '\t' && line[end] != '\n') { end = end + 1; }
        return line.Substring(start, end - start);
    }

    /// 队列满 8 条，或距上次发送 10 分钟且有存货，就发一轮。
    static void MaybeSend() {
        if (PluginUsage.sendBusy) { return; }
        if (PluginUsage.queue.Count == 0) { return; }
        bool batchFull = PluginUsage.queue.Count >= 8;
        bool enoughDelay = PluginUsage.sendClock == null
            || PluginUsage.sendClock.ElapsedMilliseconds() > 600000;
        if (!batchFull && !enoughDelay) { return; }
        PluginUsage.sendClock = Stopwatch.StartNew();
        PluginUsage.sendBusy = true;
        if (!Thread.Start(PluginUsage.SendWorker)) {
            PluginUsage.sendBusy = false;
            return;
        }
    }

    /// UI 每帧调：上一轮发送结束就清忙位并视情再触发（低频）。
    /// 发送线程通过 sink.Publish("ok:batch") / ("err:...") 收尾。
    static void Poll() {
        if (!PluginUsage.sendBusy) { return; }
        if (PluginUsage.sink == null) { return; }
        string done = PluginUsage.sink.Done();
        if (done.Length == 0) { return; }
        bool ok = done.Length >= 3 && done.Substring(0, 3) == "ok:";
        PluginUsage.sink = null;
        PluginUsage.sendBusy = false;
        if (ok) { PluginUsage.CommitBatch(); }
        PluginUsage.MaybeSend();
    }

    static SseSink sink;
    static SseSink workerSink;

    static void SendWorker() {
        Socket.Initialize();
        string body = PluginUsage.TakeBatch();
        if (body.Length == 0) {
            PluginUsage.workerSink.Publish("ok:empty");
            return;
        }
        try {
            ExternalTarget t = ExternalTarget.Parse(MarketplaceClient.BaseUrl());
            if (t == null) {
                PluginUsage.workerSink.Publish("err:bad base url");
                return;
            }
            HttpClient cli;
            if (t.scheme == "https") {
                cli = HttpClient.CreateHttps(t.Host(), t.Port());
            } else {
                cli = new HttpClient(t.Host(), t.Port());
            }
            ExternalCallPolicy policy = ExternalCallPolicy.Default()
                .TotalTimeout(15000)
                .Redirects(0)
                .RetryNetwork(false)
                .RetryAttempts(0);
            if (ExternalTargetPolicy.IsLoopback(t.Host())) { policy.AllowLocalHttp(); }
            cli.SetCallPolicy(policy);
            cli.SetTimeout(15000);
            // fire-and-forget：结果只决定这批算不算"发过了"。
            HttpResponse resp = await cli.SendBytesAsync("POST",
                "/api/pluginusage/ingest", body);
            if (resp.statusCode >= 200 && resp.statusCode < 300) {
                PluginUsage.workerSink.Publish("ok:batch");
            } else {
                PluginUsage.workerSink.Publish("err:HTTP "
                    + Convert.ToString(resp.statusCode));
            }
        } catch (Exception ex) {
            PluginUsage.workerSink.Publish("err:" + ex.Message);
        }
    }

    /// 取出本轮要发的批量 JSON（最多 32 条）。bad JSON 行在组装时丢弃。
    static string TakeBatch() {
        PluginUsage.EnsureLoaded();
        int n = PluginUsage.queue.Count > 32 ? 32 : PluginUsage.queue.Count;
        if (n == 0) { return ""; }
        JsonValue arr = JsonValue.NewArray();
        for (int i = 0; i < n; i = i + 1) {
            try {
                arr.Append(JsonValue.Parse(PluginUsage.queue[i]));
            } catch (JsonException ex) {
                // 坏行直接丢
            }
        }
        JsonValue body = JsonValue.NewObject();
        body.Put("events", arr);
        return body.ToJson();
    }

    static void CommitBatch() {
        PluginUsage.EnsureLoaded();
        int n = PluginUsage.queue.Count > 32 ? 32 : PluginUsage.queue.Count;
        for (int i = 0; i < n; i = i + 1) { PluginUsage.queue.RemoveAt(0); }
        PluginUsage.Persist();
    }
}
