class IdeCompileMode {
    static string Flags(bool publish, bool debug, bool strictMemory) {
        if (publish) {
            // 核心契约与语义定义。
            // 核心契约与语义定义。
            if (debug) { return " -g --no-arc-guard --no-check-leaks"; }
            return " --publish";
        }
        if (debug || strictMemory) {
            return " -g --arc-guard --check-leaks --strict-runtime";
        }
        return "";
    }
}
