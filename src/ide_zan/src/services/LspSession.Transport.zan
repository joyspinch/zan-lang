using System;
using System.IO;
using System.Diagnostics;
using System.Json;
using System.Text;
using System.Threading;
using System.Collections.Generic;
using Platform;
using System.Net.Sockets;
using Gui.Component.CodeEditor;

partial class LspSession {
    // ---- transport ----

    void SnoozeMs(int ms) {
        #if WINDOWS
        plat_sleep(ms);
        #else
        plat_usleep(ms * 1000);
        #endif
    }

    static int RecvTimeoutMs() { return 250; }
    static int RequestWaits() { return 60; }
    static int PollIoBudget() { return 8; }
    static int PollFrameBudget() { return 16; }
    static int MaxFrameBytes() { return 16777216; }
    static int MaxQueuedBytes() { return 33554432; }
    static int SendStallMs() { return LspSession.RequestWaits() * LspSession.RecvTimeoutMs(); }

    void Disconnect() {
        if (sock >= 0) { Socket.Close(sock); sock = -1; }
        alive = false;
        generation = generation + 1;
        rbuf = "";
        if (sendQueue != null) { sendQueue.Clear(); }
        queuedBytes = 0;
        if (boundEditor != null) { boundEditor.ResetSemanticProviders(); }
        if (pending != null) {
            List<int> ids = pending.Keys;
            for (int i = 0; i < ids.Count; i = i + 1) {
                pending[ids[i]].state = LspPendingState.Error;
            }
            pending.Clear();
        }
        if (cache != null) { cache.Clear(); }
    }

    static bool RetrySocket() {
        // Send/Recv 的 raw API 不缓存错误；必须紧跟失败点捕获。
        Socket.CaptureLastError();
        int error = Socket.LastSocketError();
        #if WINDOWS
        return error == 10035 || error == 10004;
        #else
        return error == 11 || error == 35 || error == 4;
        #endif
    }

    void SendMsg(string body, int requestId = 0) {
        if (!alive) { return; }
        string data = "Content-Length: " + Convert.ToString(body.Length) + "\r\n\r\n" + body;
        if (!nonBlocking) {
            // 只有 initialize 握手允许同步传输；日常请求只保存 frame。
            int offset = 0;
            while (offset < data.Length) {
                int n = Socket.Send(sock, data.Substring(offset), data.Length - offset);
                if (n <= 0) { Disconnect(); return; }
                offset = offset + n;
            }
            return;
        }
        if (data.Length > LspSession.MaxQueuedBytes() - queuedBytes) { Disconnect(); return; }
        if (sendQueue.Count == 0) { sendProgressMs = Stopwatch.GetMilliseconds(); }
        LspSendFrame frame = new LspSendFrame();
        frame.data = data;
        frame.offset = 0;
        frame.requestId = requestId;
        sendQueue.Add(frame);
        queuedBytes = queuedBytes + data.Length;
    }

    bool DropUnsentRequest(int requestId) {
        for (int i = 0; i < sendQueue.Count; i = i + 1) {
            LspSendFrame frame = sendQueue[i];
            if (frame.requestId == requestId && frame.offset == 0) {
                queuedBytes = queuedBytes - frame.data.Length;
                sendQueue.RemoveAt(i);
                return true;
            }
        }
        return false;
    }

    void FlushSendQueue() {
        if (sendQueue.Count > 0 && Stopwatch.GetMilliseconds() - sendProgressMs >= LspSession.SendStallMs()) {
            Disconnect(); return;
        }
        for (int i = 0; alive && sendQueue.Count > 0 && i < LspSession.PollIoBudget(); i = i + 1) {
            bool writable = Socket.IsWritable(sock);
                        if (!writable) { return; }
            LspSendFrame frame = sendQueue[0];
            int remaining = frame.data.Length - frame.offset;
            int count = remaining < 65536 ? remaining : 65536;
                        int n = Socket.Send(sock, frame.data.Substring(frame.offset, count), count);
            if (n < 0 && LspSession.RetrySocket()) { return; }
            if (n <= 0) { Disconnect(); return; }
            frame.offset = frame.offset + n;
            queuedBytes = queuedBytes - n;
            sendProgressMs = Stopwatch.GetMilliseconds();
            if (frame.offset == frame.data.Length) {
                sendQueue.RemoveAt(0);
            }
        }
    }

    void Notify(string method, string paramsJson) {
        LspNotification o = new LspNotification();
        o.jsonrpc = "2.0";
        o.method = method;
        if (paramsJson.Length > 0) { o.params = JsonValue.ParseLenient(paramsJson); }
        this.SendMsg(Json.Serialize<LspNotification>(o));
    }

    LspPendingRequest NewRequest(string method) {
        LspPendingRequest request = new LspPendingRequest();
        request.id = seq;
        seq = seq + 1;
        request.method = method;
        request.generation = generation;
        request.state = LspPendingState.Pending;
        request.message = "";
        request.hover = "";
        request.deadline = Stopwatch.GetMilliseconds() + waitBudget * LspSession.RecvTimeoutMs();
        pending[request.id] = request;
        return request;
    }

    void SendRequest(LspPendingRequest request, string paramsJson) {
        LspRequest envelope = new LspRequest();
        envelope.jsonrpc = "2.0";
        envelope.id = request.id;
        envelope.method = request.method;
        if (paramsJson.Length > 0) { envelope.params = JsonValue.ParseLenient(paramsJson); }
        this.SendMsg(Json.Serialize<LspRequest>(envelope), request.id);
    }

    // 显式导航等待也分发所有 ID，不会吞掉在途的日常提示响应。
    string RequestWait(string method, string paramsJson) {
        if (background) { throw new Exception("Synchronous LSP requests are worker-only."); }
        lastRequestState = LspPendingState.Error;
        if (!alive) { return ""; }
        LspPendingRequest request = NewRequest(method);
        SendRequest(request, paramsJson);
        WaitRequest(request);
        lastRequestState = request.state;
        return request.state == LspPendingState.Ready ? request.message : "";
    }

    bool OperationCancelled() {
        return (serviceCancellation != null && serviceCancellation.IsCancellationRequested)
            || (activeCancellation != null && activeCancellation.IsCancellationRequested);
    }

    void WaitRequest(LspPendingRequest request) {
        if (background) { throw new Exception("LSP waits are worker-only."); }
        if (!alive || request == null) { return; }
        while (alive && request.state == LspPendingState.Pending) {
            if (OperationCancelled()) {
                request.state = LspPendingState.Cancelled;
                pending.Remove(request.id);
                if (!DropUnsentRequest(request.id)) {
                    JsonValue cancellation = JsonValue.NewObject();
                    cancellation.PutInt("id", request.id);
                    Notify("$/cancelRequest", cancellation.ToJson());
                }
                return;
            }
            Poll();
            if (request.state == LspPendingState.Pending) { SnoozeMs(2); }
        }
    }

    // 只取完整 frame；分片头、分片 body 和后续 frame 一律留在 rbuf。
    string TakeFrame() {
        int headerEnd = rbuf.IndexOf("\r\n\r\n");
        if (headerEnd < 0) {
            if (rbuf.Length > 8192) { Disconnect(); }
            return "";
        }
        if (headerEnd > 8192) { Disconnect(); return ""; }
        int length = DebugSession.HeaderLen(rbuf.Substring(0, headerEnd));
        if (length <= 0 || length > LspSession.MaxFrameBytes()) { Disconnect(); return ""; }
        int start = headerEnd + 4;
        if (rbuf.Length - start < length) { return ""; }
        string message = rbuf.Substring(start, length);
        rbuf = rbuf.Substring(start + length);
        return message;
    }

    void DispatchResponse(string message) {
        JsonValue root = null;
        try { root = JsonValue.ParseLenient(message); } catch (Exception) { return; }
        if (root == null || !root.IsObject()) { return; }
        JsonValue id = root.Get("id");
        if (id == null || !id.IsInt()) {
            // 服务器主动推送的通知（没有 id，带 method）。此前这里
            // 直接 return，诊断推送（textDocument/publishDiagnostics）
            // 就被整条扔掉了。
            this.DispatchNotification(root);
            return;
        }
                if (!pending.ContainsKey(id.AsInt(-1))) { return; }
        LspPendingRequest request = pending[id.AsInt(-1)];
        pending.Remove(request.id);
        if (Stopwatch.GetMilliseconds() >= request.deadline) {
            request.state = LspPendingState.Timeout;
            return;
        }
        if (root.Has("error") || !root.Has("result")) {
            request.state = LspPendingState.Error;
            return;
        }
        request.state = LspPendingState.Ready;
        if (request.editor == null) { request.message = message; return; }
        JsonValue result = root.Get("result");
        if (request.method == "textDocument/completion") {
            request.completions = new List<LspCompletionItem>();
            if (result != null && result.IsObject()) { result = result.Get("items"); }
            if (result != null && result.IsArray()) {
                for (int i = 0; i < result.Count(); i = i + 1) {
                    LspCompletionItem item = Json.Deserialize<LspCompletionItem>(result.At(i).ToJson());
                    if (item != null) { request.completions.Add(item); }
                }
            }
            List<string> lines = CodeEditor.SplitLines(request.text);
            string sourceLine = request.line >= 0 && request.line < lines.Count ? lines[request.line] : "";
            request.editorCompletions = LspSession.EditorCompletions(request.completions, sourceLine, request.line, request.col);
            if (request.editorCompletions == null || request.editorCompletions.Count == 0) { request.state = LspPendingState.Empty; }
        } else if (request.method == "textDocument/signatureHelp") {
            if (result != null && result.IsObject()) {
                request.signature = Json.Deserialize<LspSignatureHelp>(result.ToJson());
            }
            request.signatureLabel = LspSession.SignatureLabel(request.signature);
            if (request.signatureLabel.Length == 0) { request.state = LspPendingState.Empty; }
        } else if (request.method == "textDocument/hover") {
            if (result != null && result.IsObject()) { request.hover = LspSession.MarkupText(result.Get("contents")); }
            if (request.hover.Length == 0) { request.state = LspPendingState.Empty; }
        }
        RefreshEditor(request);
    }

    // 服务器主动推送的通知（没有 id）。目前只有诊断：
    // textDocument/publishDiagnostics —— 服务端在输入停顿后把这一份
    // 文档的词法/语法错误推过来。
    void DispatchNotification(JsonValue root) {
        JsonValue method = root.Get("method");
        if (method == null || !method.IsString()) { return; }
        if (method.AsString("") != "textDocument/publishDiagnostics") { return; }
        JsonValue params = root.Get("params");
        if (params == null || !params.IsObject()) { return; }
        JsonValue uri = params.Get("uri");
        if (uri == null || !uri.IsString()) { return; }
        string key = uri.AsString("");
        List<string> lines = null;
        if (documents != null && documents.ContainsKey(key)) {
            lines = documents[key].lines;
        }
        List<Diagnostic> diags = LspSession.ParsePublishDiagnostics(params, lines);
        if (onDiagnostics != null) { onDiagnostics(key, diags); }
    }

    void Poll() {
        if (background || !alive || polling) { return; }
        polling = true;
        CancelStaleEditorRequests();
        if (nonBlocking) { FlushSendQueue(); }
        int frames = 0;
        int reads = 0;
        while (alive && frames < LspSession.PollFrameBudget()) {
            string message = TakeFrame();
            if (message.Length > 0) {
                frames = frames + 1;
                try { DispatchResponse(message); } catch (Exception) { }
                continue;
            }
            bool readable = Socket.IsReadable(sock);
            if (!readable) {
                                break;
            }
            if (!alive || reads >= LspSession.PollIoBudget()) { break; }
            reads = reads + 1;
            byte[] buffer = new byte[65536];
            int n = Socket.Recv(sock, buffer, buffer.Length);
                        if (n < 0 && LspSession.RetrySocket()) { break; }
            if (n <= 0) { Disconnect(); break; }
            rbuf = rbuf + buffer.ToStr(0, n);
        }
        long now = Stopwatch.GetMilliseconds();
        List<int> ids = pending.Keys;
        for (int i = ids.Count - 1; i >= 0; i = i - 1) {
            LspPendingRequest request = pending[ids[i]];
            if (now >= request.deadline) {
                request.state = LspPendingState.Timeout;
                pending.Remove(request.id);
                DropUnsentRequest(request.id);
            }
        }
        TrimTerminalCache();
        polling = false;
    }

    void TrimTerminalCache() {
        int terminalCount = 0;
        for (int i = 0; i < cache.Count; i = i + 1) {
            if (cache[i].state != LspPendingState.Pending) { terminalCount = terminalCount + 1; }
        }
        // 保留最近 64 个终态抑制重复查询，pending 不能因缓存上限被移除。
        int index = 0;
        while (terminalCount > 64 && index < cache.Count) {
            if (cache[index].state == LspPendingState.Pending) { index = index + 1; }
            else { cache.RemoveAt(index); terminalCount = terminalCount - 1; }
        }
    }

    void CancelStaleEditorRequests() {
        List<int> ids = pending.Keys;
        for (int i = ids.Count - 1; i >= 0; i = i - 1) {
            LspPendingRequest request = pending[ids[i]];
            CodeEditor editor = request.editor;
            if (editor == null) { continue; }
            bool keep = (editor == boundEditor && request.generation == generation
                && request.documentGeneration == documentGeneration && DocVersion(request.path) == request.version
                && editor.documentPath == request.path && editor.TextStamp() == request.stamp
                && editor.CurLine() == request.caretLine && editor.CurCol() == request.caretCol
                && editor.GetText() == request.text
                && (request.method != "textDocument/completion"
                    || editor.SemanticCompletionToken() == request.completionToken));

            if (keep) { continue; }
            request.state = LspPendingState.Cancelled;
            pending.Remove(request.id);
            cache.Remove(request);
            editor.ClearSemanticTextMemo(request.method, request.path, request.stamp,
                request.line, request.col, request.name);
            if (background) {
                if (request.cancellation != null) { request.cancellation.Cancel(); }
            } else if (!DropUnsentRequest(request.id)) {
                JsonValue cancellation = JsonValue.NewObject();
                cancellation.PutInt("id", request.id);
                Notify("$/cancelRequest", cancellation.ToJson());
            }
        }
    }

    bool HasPendingWork() {
        if (background || !alive) { return false; }
        if (sendQueue.Count > 0 || pending.Count > 0) { return true; }
        // 完整缓冲响应需要下一拍；无人等待的半包不能造成永久唤醒。
        int headerEnd = rbuf.IndexOf("\r\n\r\n");
        if (headerEnd < 0) { return false; }
        int length = DebugSession.HeaderLen(rbuf.Substring(0, headerEnd));
        return length <= 0 || rbuf.Length - headerEnd - 4 >= length;
    }

    bool ConsumeEditorRefresh() {
        bool changed = editorRefreshNeeded;
        editorRefreshNeeded = false;
        return changed;
    }

}
