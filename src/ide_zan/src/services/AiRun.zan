using System;

partial class AiRun {
    // 同一拍自动重试的上限。
    static int MaxRetries() { return 2; }
    // 同一个需求里「定位根因 → 重验」的回环上限，超了就交给用户，不无限修。
    static int MaxRepairs() { return 3; }

    string taskId;
    // 需求原文的一行摘要。
    string title;
    int createdMs;
    int updatedMs;
    // 当前拍。
    int phase;
    // 整体状态（Running / Done / Failed / Blocked）。
    int status;
    List<AiRunStep> steps;
    // 根因回环修完要回到哪一拍重跑；-1 表示不在回环里。
    int resumeAt;
    int repairs;
    int fault;
    string lastError;
    // 改动文件记录（包含路径与增删行数，强类型实体集合）。
    List<AiFileChange> changes;

    static AiRun Begin(string taskId, string title, int nowMs) {
        AiRun r = new AiRun();
        r.taskId = taskId;
        r.title = title;
        r.createdMs = nowMs;
        r.updatedMs = nowMs;
        r.phase = AiPhase.Understand();
        r.status = AiRunStatus.Running();
        r.steps = new List<AiRunStep>();
        for (int i = 0; i < AiPhase.Count(); i = i + 1) {
            r.steps.Add(AiRunStep.Create(i));
        }
        r.resumeAt = -1;
        r.repairs = 0;
        r.fault = AiFault.None();
        r.lastError = "";
        r.changes = new List<AiFileChange>();
        return r;
    }

    AiRunStep At(int phase) {
        if (phase < 0 || phase >= this.steps.Count) { return null; }
        return this.steps[phase];
    }

    AiRunStep Current() { return this.At(this.phase); }

    bool HasStarted() {
        if (this.phase > AiPhase.Understand()) { return true; }
        if (this.fault != AiFault.None()) { return true; }
        AiRunStep s = this.Current();
        if (s == null) { return false; }
        return s.status == AiRunStatus.Done()
            || s.status == AiRunStatus.Failed()
            || s.status == AiRunStatus.Blocked()
            || s.calls > 0;
    }

    // --- 推进 -----------------------------------------------------------------

    // 开始某一拍。回到已完成的拍（回归重跑）会把它重新置为 running。
    void Enter(int phase, int nowMs, string title) {
        if (phase < 0 || phase >= AiPhase.Count()) { return; }
        this.phase = phase;
        this.updatedMs = nowMs;
        this.status = AiRunStatus.Running();
        AiRunStep s = this.At(phase);
        if (s != null) { s.Begin(nowMs, title); }
    }

    // 当前拍成功；十二拍走完则整个任务完成。
    void Pass(int nowMs, string note) {
        AiRunStep s = this.Current();
        if (note != "") { s.title = note; }
        // 通过之后不能还挂着上一次的错误：否则交付证据里一个 ✓ 的拍旁边写着
        // 一条失败原因，读起来像是把失败当成功报了。
        s.error = "";
        s.fault = AiFault.None();
        s.Finish(nowMs);
        this.updatedMs = nowMs;
        this.fault = AiFault.None();
        this.lastError = "";
        if (this.phase == AiPhase.Knowledge()) {
            this.status = AiRunStatus.Done();
        }
    }

    // 当前拍失败。分类由错误文本推出（调用方已知分类时用另一个重载）。
    void Fail(int nowMs, string error) {
        this.Fail(nowMs, AiFault.Classify(error), error);
    }

    void Fail(int nowMs, int fault, string error) {
        AiRunStep s = this.Current();
        s.Fail(nowMs, fault, error);
        this.updatedMs = nowMs;
        this.fault = fault;
        this.lastError = error;
        this.status = s.status;
    }

    void FailCommand(int nowMs, string command, int exitCode, string error) {
        AiRunStep s = this.Current();
        s.command = command;
        s.exitCode = exitCode;
        this.Fail(nowMs, error);
    }

    // 跳过一拍（例如纯文档改动不需要 UI 验证）。理由必填，否则交付时无法解释
    // 为什么少验了一层。
    void Skip(int nowMs, string why) {
        AiRunStep s = this.Current();
        s.status = AiRunStatus.Skipped();
        s.endedMs = nowMs;
        s.error = why;
        this.updatedMs = nowMs;
    }

    // 状态机的唯一决策点。
    int NextAction() {
        if (this.status == AiRunStatus.Done()) { return AiNext.Finished(); }
        AiRunStep s = this.Current();
        if (s == null) { return AiNext.Abort(); }
        if (s.status == AiRunStatus.Blocked()) { return AiNext.AskUser(); }
        if (s.status == AiRunStatus.Failed()) {
            if (AiFault.Retryable(s.fault) && s.retries < AiRun.MaxRetries()) {
                return AiNext.Retry();
            }
            if (AiFault.Repairable(s.fault)
                && this.repairs < AiRun.MaxRepairs()
                && this.phase != AiPhase.Diagnose()) {
                return AiNext.Diagnose();
            }
            return AiNext.AskUser();
        }
        if (s.status == AiRunStatus.Running()
            && AiPhase.NeedsUser(this.phase)) {
            return AiNext.AskUser();
        }
        return AiNext.Continue();
    }

    // 重跑当前拍（同一拍，retries+1）。达到上限返回 false，绝不静默无限重试。
    bool Retry(int nowMs) {
        AiRunStep s = this.Current();
        if (s == null) { return false; }
        // 等外部输入的一拍重试毫无意义：凭据没补上、用户没答，跑一百次还是同一
        // 个结果，只会把面板刷满。
        if (s.status == AiRunStatus.Blocked()) { return false; }
        if (s.retries >= AiRun.MaxRetries()) { return false; }
        s.retries = s.retries + 1;
        this.Enter(this.phase, nowMs, s.title);
        return true;
    }

    // 进入根因回环：记住失败的那一拍，修完由 `ResumeAfterRepair` 回去重验。
    bool EnterRepair(int nowMs) {
        if (this.repairs >= AiRun.MaxRepairs()) { return false; }
        this.repairs = this.repairs + 1;
        this.resumeAt = this.phase;
        this.Enter(AiPhase.Diagnose(), nowMs, "定位 " + AiPhase.Zh(this.resumeAt)
            + " 失败的根因");
        return true;
    }

    // 根因修完，回到失败的那一拍重跑（不是往后跳过它）。
    int ResumeAfterRepair(int nowMs) {
        int back = this.resumeAt;
        if (back < 0) { back = AiPhase.Build(); }
        this.resumeAt = -1;
        AiRunStep s = this.At(back);
        if (s == null) { return back; }
        s.retries = s.retries + 1;
        this.Enter(back, nowMs, s.title);
        return back;
    }

    // 直接跳到某一拍。中间没跑过的拍被标成「跳过」并写下理由，而不是悄悄留在
    // pending 假装还会做 —— 交付证据里少验了哪一层必须看得见。
    void GotoPhase(int phase, int nowMs, string title, string skipWhy) {
        if (phase < 0 || phase >= AiPhase.Count()) { return; }
        if (phase <= this.phase) {
            this.Enter(phase, nowMs, title);
            return;
        }
        for (int p = this.phase; p < phase; p = p + 1) {
            AiRunStep s = this.At(p);
            if (s == null) { continue; }
            if (s.status == AiRunStatus.Done()
                || s.status == AiRunStatus.Skipped()) {
                continue;
            }
            if (s.status == AiRunStatus.Running()) {
                this.phase = p;
                this.Pass(nowMs, "");
            } else {
                this.phase = p;
                this.Skip(nowMs, skipWhy);
            }
        }
        this.Enter(phase, nowMs, title);
    }

    // 当前拍等外部输入（用户确认、缺凭据、要人决定）。不是失败，所以不重试。
    void Block(int nowMs, string why) {
        AiRunStep s = this.Current();
        s.status = AiRunStatus.Blocked();
        s.endedMs = nowMs;
        s.error = why;
        this.updatedMs = nowMs;
        this.lastError = why;
        this.status = AiRunStatus.Blocked();
    }

    // 前进到下一拍。已在最后一拍则返回 false。
    bool Advance(int nowMs) {
        if (this.phase >= AiPhase.Knowledge()) { return false; }
        this.Enter(this.phase + 1, nowMs, "");
        return true;
    }

    // --- 记录 -----------------------------------------------------------------

    void NoteCommand(string command, int exitCode) {
        AiRunStep s = this.Current();
        s.command = command;
        s.calls = s.calls + 1;
        s.exitCode = exitCode;
    }

    void NoteDiagnostic(string line) {
        if (line == "") { return; }
        this.Current().diagnostics.Add(line);
    }

    void NoteArtifact(string path) {
        if (path == "") { return; }
        this.Current().artifacts.Add(path);
    }

    // --- 查询 -----------------------------------------------------------------

    int DoneCount() {
        int n = 0;
        for (int i = 0; i < this.steps.Count; i = i + 1) {
            int st = this.steps[i].status;
            if (st == AiRunStatus.Done() || st == AiRunStatus.Skipped()) {
                n = n + 1;
            }
        }
        return n;
    }

    int Progress() {
        return this.DoneCount() * 100 / AiPhase.Count();
    }

    bool Finished() { return this.status == AiRunStatus.Done(); }

    // 面板标题栏那一行：进度、当前拍、状态、重试/回环次数。
    string Summary() {
        string head = this.taskId + " " + Convert.ToString(this.DoneCount())
            + "/" + Convert.ToString(AiPhase.Count()) + " "
            + AiPhase.Zh(this.phase) + " " + AiRunStatus.Id(this.Current().status);
        if (this.fault != AiFault.None()) {
            head = head + " [" + AiFault.Zh(this.fault) + "]";
        }
        if (this.repairs > 0) {
            head = head + " 回环x" + Convert.ToString(this.repairs);
        }
        return head;
    }

    // 交付证据：每一拍的命令、退出码和产物。没有它，「已验证」只是说法。
    List<string> Evidence() {
        List<string> outp = new List<string>();
        for (int i = 0; i < this.steps.Count; i = i + 1) {
            AiRunStep s = this.steps[i];
            if (s.status == AiRunStatus.Pending()) { continue; }
            string line = AiRunStatus.Mark(s.status) + " " + AiPhase.Zh(i);
            if (s.command != "") {
                line = line + ": " + s.command + " -> "
                    + Convert.ToString(s.exitCode);
            } else if (s.title != "") {
                line = line + ": " + s.title;
            }
            if (s.retries > 0) {
                line = line + " (重试" + Convert.ToString(s.retries) + ")";
            }
            if (s.error != "") { line = line + " — " + s.error; }
            for (int a = 0; a < s.artifacts.Count; a = a + 1) {
                line = line + " [" + s.artifacts[a] + "]";
            }
            outp.Add(line);
        }
        return outp;
    }

    // --- 检查点 ---------------------------------------------------------------

    // 序列化为检查点 JSON。IDE 崩了、被关了、任务被停了，都能从这里续跑，而
    // 不是从需求理解重新开始。
    string ToJson() {
        AiRunDoc d = new AiRunDoc();
        d.id = this.taskId;
        d.ti = this.title;
        d.cr = this.createdMs;
        d.up = this.updatedMs;
        d.ph = AiPhase.Id(this.phase);
        d.st = this.status;
        d.ra = this.resumeAt;
        d.rp = this.repairs;
        d.fl = this.fault;
        d.er = this.lastError;
        d.ch = new List<AiRunChangeDoc>();
        if (this.changes != null) {
            for (int c = 0; c < this.changes.Count; c = c + 1) {
                d.ch.Add(AiRunChangeDoc.Create(this.changes[c].path, this.changes[c].adds, this.changes[c].dels));
            }
        }
        d.sp = new List<AiRunStepDoc>();
        for (int i = 0; i < this.steps.Count; i = i + 1) {
            AiRunStep s = this.steps[i];
            AiRunStepDoc sd = new AiRunStepDoc();
            sd.ph = AiPhase.Id(s.phase);
            sd.st = s.status;
            sd.ti = s.title;
            sd.cm = s.command;
            sd.cl = s.calls;
            sd.ec = s.exitCode;
            sd.s0 = s.startedMs;
            sd.s1 = s.endedMs;
            sd.rt = s.retries;
            sd.fl = s.fault;
            sd.er = s.error;
            sd.dg = new List<string>();
            for (int g = 0; g < s.diagnostics.Count; g = g + 1) {
                sd.dg.Add(s.diagnostics[g]);
            }
            sd.ar = new List<string>();
            for (int t = 0; t < s.artifacts.Count; t = t + 1) {
                sd.ar.Add(s.artifacts[t]);
            }
            d.sp.Add(sd);
        }
        return Json.Serialize<AiRunDoc>(d);
    }

    // 读回检查点。空串或坏 JSON 得到 null（调用方开新任务），不抛。
    static AiRun FromJson(string packed) {
        if (packed == "") { return null; }
        AiRunDoc d = null;
        try {
            d = Json.Deserialize<AiRunDoc>(packed);
        } catch (Exception ex) {
            return null;
        }
        if (d == null || d.id == null || d.id == "") { return null; }
        AiRun r = AiRun.Begin(d.id, d.ti, d.cr);
        r.updatedMs = d.up;
        int ph = AiPhase.FromId(d.ph);
        if (ph < 0) { ph = AiPhase.Understand(); }
        r.phase = ph;
        r.status = d.st;
        r.resumeAt = d.ra;
        r.repairs = d.rp;
        r.fault = d.fl;
        r.lastError = d.er;
        if (d.ch != null && d.ch.Count > 0) {
            for (int c = 0; c < d.ch.Count; c = c + 1) {
                r.NoteChangedFile(d.ch[c].p, d.ch[c].a, d.ch[c].d);
            }
        }
        if (d.sp == null) { return r; }
        for (int i = 0; i < d.sp.Count; i = i + 1) {
            AiRunStepDoc sd = d.sp[i];
            int sp = AiPhase.FromId(sd.ph);
            if (sp < 0) { continue; }
            AiRunStep s = r.At(sp);
            if (s == null) { continue; }
            s.status = sd.st;
            s.title = sd.ti;
            s.command = sd.cm;
            s.calls = sd.cl;
            s.exitCode = sd.ec;
            s.startedMs = sd.s0;
            s.endedMs = sd.s1;
            s.retries = sd.rt;
            s.fault = sd.fl;
            s.error = sd.er;
            if (sd.dg != null) {
                for (int g = 0; g < sd.dg.Count; g = g + 1) {
                    s.diagnostics.Add(sd.dg[g]);
                }
            }
            if (sd.ar != null) {
                for (int t = 0; t < sd.ar.Count; t = t + 1) {
                    s.artifacts.Add(sd.ar[t]);
                }
            }
        }
        return r;
    }
}
