using System;
using System.Json;

/// 版本频道检查的客户端侧结果：一次 GET /api/channel/check 的解析产物。
/// update_available = 灰度内且远端比本地新；update_required = 低于安全线
/// （IDE 阻塞式提示，不允许跳过）。包体三元组（url/sha256/signature）
/// 供下载与 RSA-SHA256 验签，与商城商品包同一套校验流程。
class IdeUpdateInfo {
    string channel;
    string platform;
    string current;
    string latest;
    bool updateAvailable;
    bool updateRequired;
    string installerUrl;
    string sha256;
    string signature;
    string releaseNotes;
    /// 网络/解析失败时的原因；"" = 成功。
    string error;

    static IdeUpdateInfo FromJson(string channel, string current, string body) {
        IdeUpdateInfo info = new IdeUpdateInfo();
        info.channel = channel;
        info.current = current;
        info.error = "";
        JsonValue envelope = null;
        try {
            envelope = JsonValue.Parse(body);
        } catch (JsonException ex) {
            envelope = null;
        }
        if (envelope == null || !envelope.IsObject()
            || envelope.Str("code", "") != "0000") {
            info.error = "invalid channel response";
            return info;
        }
        JsonValue data = envelope.Get("data");
        if (data == null || !data.IsObject()) {
            info.error = "invalid channel payload";
            return info;
        }
        info.platform = data.Str("platform", "");
        info.latest = data.Str("latest", "");
        JsonValue avail = data.Get("update_available");
        JsonValue required = data.Get("update_required");
        info.updateAvailable = avail != null && avail.AsInt(0) == 1;
        info.updateRequired = required != null && required.AsInt(0) == 1;
        info.installerUrl = data.Str("installer_url", "");
        info.sha256 = data.Str("sha256", "");
        info.signature = data.Str("signature", "");
        info.releaseNotes = data.Str("release_notes", "");
        return info;
    }

    static IdeUpdateInfo Fail(string channel, string why) {
        IdeUpdateInfo info = new IdeUpdateInfo();
        info.channel = channel;
        info.current = "";
        info.error = why;
        return info;
    }

    string Channel() { return channel; }
    string Latest() { return latest; }
    bool UpdateAvailable() { return updateAvailable; }
    bool UpdateRequired() { return updateRequired; }
    string InstallerUrl() { return installerUrl; }
    string Error() { return error; }
    string ReleaseNotes() { return releaseNotes; }

    bool Ok() { return error == ""; }
}
