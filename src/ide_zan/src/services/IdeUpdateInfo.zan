using System;
using System.Json;
using AppUpdate;

// 版本频道检查的客户端侧结果：一次 GET /api/channel/check 的解析产物。
// update_available = 灰度内且远端比本地新；update_required = 低于安全线
// （IDE 阻塞式提示，不允许跳过）。包体三元组（url/sha256/signature）
// 供下载与 RSA-SHA256 验签，与商城商品包同一套校验流程。
public class IdeUpdateInfo {
    string channel;
    string platform;
    string current;
    string latest;
    bool updateAvailable;
    bool updateRequired;
    string installerUrl;
    string sha256;
    string signature;
    string releaseNotes;
    // 网络/解析失败时的原因；"" = 成功。
    string error;

    static IdeUpdateInfo FromJson(string channel, string current, string body) {
        IdeUpdateInfo info = new IdeUpdateInfo();
        info.channel = channel;
        info.current = current;
        info.error = "";
        if (body == null || body.Length == 0) {
            info.error = "invalid channel response";
            return info;
        }
        try {
            JsonDoc.ParseScoped(body, doc => {
                int root = doc.root;
                string code = doc.Str(root, "code", "");
                if (doc.KindAt(root) != 5 || (code != "0" && code != "0000")) {
                    info.error = "invalid channel response";
                    return;
                }
                int data = doc.Get(root, "data");
                if (data < 0 || doc.KindAt(data) != 5) {
                    info.error = "invalid channel payload";
                    return;
                }
                info.platform = doc.Str(data, "platform", "");
                int signed = doc.Get(data, "manifest");
                UpdateManifest manifest = signed >= 0 ? UpdateManifest.Parse(doc.ToJson(signed)) : null;
                if (!IdeSyncPlan.TrustedFor(manifest, channel, info.platform)
                    || info.platform != IdeUpdate.PlatformOf()
                    || manifest.version != doc.Str(data, "latest", "")) {
                    info.error = "untrusted channel manifest";
                    return;
                }
                info.latest = manifest.version;
                info.updateAvailable = doc.Bool(data, "update_available", false);
                info.updateRequired = doc.Bool(data, "update_required", false);
                info.installerUrl = manifest.packageUrl;
                info.sha256 = manifest.packageSha256;
                info.signature = manifest.Signature();
                info.releaseNotes = manifest.changelog;
            });
        } catch (Exception) {
            info.error = "invalid channel response";
            return info;
        }
        return info;
    }

    static IdeUpdateInfo Fail(string channel, string why) {
        IdeUpdateInfo info = new IdeUpdateInfo();
        info.channel = channel;
        info.current = "";
        info.error = why;
        return info;
    }

    string Channel() { return channel; }
    string Latest() { return latest; }
    bool UpdateAvailable() { return updateAvailable; }
    bool UpdateRequired() { return updateRequired; }
    string InstallerUrl() { return installerUrl; }
    string Error() { return error; }
    string ReleaseNotes() { return releaseNotes; }

    bool Ok() { return error == ""; }
}
