using System;
using System.IO;
using System.Collections.Generic;
using System.Resources;
using System.Security.Cryptography;

// 发布期资源复制、目录清理与加密打包（.zrp）服务（零 GUI 依赖）。
partial class ZanIDE {
    static int CopyTree(string src, string dst) {
        Directory.CreateDirectoryRecursive(dst);
        int n = 0;
        List<string> fs = Directory.GetFileNames(src);
        for (int i = 0; i < fs.Count; i = i + 1) {
            File.Copy(src + "/" + fs[i], dst + "/" + fs[i]);
            n = n + 1;
        }
        List<string> ds = Directory.GetDirectories(src);
        for (int i = 0; i < ds.Count; i = i + 1) {
            n = n + ZanIDE.CopyTree(src + "/" + ds[i], dst + "/" + ds[i]);
        }
        return n;
    }

    static void DeleteTree(string path) {
        if (!Directory.Exists(path)) { return; }
        List<string> fs = Directory.GetFileNames(path);
        for (int i = 0; i < fs.Count; i = i + 1) {
            File.Delete(path + "/" + fs[i]);
        }
        List<string> ds = Directory.GetDirectories(path);
        for (int i = 0; i < ds.Count; i = i + 1) {
            ZanIDE.DeleteTree(path + "/" + ds[i]);
        }
        Directory.Delete(path);
    }

    static bool PackEnabled(string root) {
        return ZanIDE.ProjField(root, "packassets") == "1";
    }

    static void EnablePack(string root, List<string> log) {
        string aHex = ZanIDE.ProjField(root, "assetkey_a");
        string bHex = ZanIDE.ProjField(root, "assetkey_b");
        if (aHex.Length != 64 || bHex.Length != 64) {
            byte[] a = RandomNumberGenerator.GetBytes(32);
            byte[] b = RandomNumberGenerator.GetBytes(32);
            if (a == null || b == null) {
                log.Add(ZanIDE.T("> ERROR: no secure random source; .zrp packing not enabled.",
                                 "> 错误：缺少安全随机源，未能启用 .zrp 加密打包。"));
                return;
            }
            aHex = Hex.Encode(a, 32);
            bHex = Hex.Encode(b, 32);
            ZanIDE.SetProjField(root, "assetkey_a", aHex);
            ZanIDE.SetProjField(root, "assetkey_b", bHex);
        }
        ZanIDE.SetProjField(root, "packassets", "1");
        ZanIDE.WriteAssetPackHelper(root, aHex, bHex);
        log.Add(ZanIDE.T("> Publishing now packs assets/ into an encrypted assets.zrp (AssetPack.zan added).",
                         "> 发布时将把 assets/ 加密打包为 assets.zrp（已生成 AssetPack.zan）。"));
    }

    static void DisablePack(string root, List<string> log) {
        ZanIDE.SetProjField(root, "packassets", "0");
        log.Add(ZanIDE.T("> Publishing copies assets/ as plain files again.",
                         "> 发布时将恢复以普通文件形式复制 assets/。"));
    }

    static void WriteAssetPackHelper(string root, string aHex, string bHex) {
        string o = "using System;\n";
        o = o + "using System.Collections.Generic;\n";
        o = o + "using System.Resources;\n";
        o = o + "using System.Security.Cryptography;\n\n";
        o = o + "/// Generated by ZanIDE (do not edit by hand; rewritten when\n";
        o = o + "/// asset packing is re-enabled). Opens the encrypted assets.zrp.\n";
        o = o + "class AssetPack {\n";
        o = o + "    static ResourcePack Open(string dir, List<int> err) {\n";
        o = o + "        byte[] a = Hex.Decode(\"" + aHex + "\");\n";
        o = o + "        byte[] b = Hex.Decode(\"" + bHex + "\");\n";
        o = o + "        byte[] k = ResourcePack.MixKey(a, b, 32);\n";
        o = o + "        return ResourcePack.Open(dir + \"/assets/assets.zrp\", k, null, null, err);\n";
        o = o + "    }\n";
        o = o + "}\n";
        File.WriteAllText(root + "/AssetPack.zan", o);
    }

    static void PackAddTree(ResourcePackWriter w, string dir, string rel, List<int> count) {
        List<string> fs = Directory.GetFileNames(dir);
        for (int i = 0; i < fs.Count; i = i + 1) {
            string nm = fs[i];
            string entry = nm;
            if (rel.Length > 0) { entry = rel + "/" + nm; }
            if (entry != "app.ico") {
                int sz = File.GetSize(dir + "/" + nm);
                if (sz >= 0) {
                    byte[] data = File.ReadBytes(dir + "/" + nm, 0, sz);
                    if (data != null) {
                        w.Add(entry, data, sz);
                        count[0] = count[0] + 1;
                    }
                }
            }
        }
        List<string> ds = Directory.GetDirectories(dir);
        for (int i = 0; i < ds.Count; i = i + 1) {
            string sub = ds[i];
            string srel = sub;
            if (rel.Length > 0) { srel = rel + "/" + sub; }
            ZanIDE.PackAddTree(w, dir + "/" + sub, srel, count);
        }
    }

    static int PackAssets(string root, string outDir, List<string> lnks, List<string> log) {
        string aHex = ZanIDE.ProjField(root, "assetkey_a");
        string bHex = ZanIDE.ProjField(root, "assetkey_b");
        if (aHex.Length != 64 || bHex.Length != 64) {
            log.Add(ZanIDE.T("> ERROR: asset key shards missing in zan.proj; re-enable asset packing in Project Settings.",
                             "> 错误：zan.proj 中缺少资源密钥分片，请在项目配置中重新启用加密打包。"));
            return 0 - 1;
        }
        byte[] ab = Hex.Decode(aHex);
        byte[] bb = Hex.Decode(bHex);
        byte[] master = ResourcePack.MixKey(ab, bb, 32);
        ResourcePackWriter w = new ResourcePackWriter();
        List<int> count = new List<int>();
        count.Add(0);
        if (Directory.Exists(root + "/assets")) {
            ZanIDE.PackAddTree(w, root + "/assets", "", count);
        }
        for (int li = 0; li < lnks.Count; li = li + 1) {
            if (File.Exists(lnks[li])) {
                int sz = File.GetSize(lnks[li]);
                byte[] data = File.ReadBytes(lnks[li], 0, sz);
                if (data != null) {
                    w.Add(Path.GetFileName(lnks[li]), data, sz);
                    count[0] = count[0] + 1;
                }
            } else {
                log.Add("> WARNING: linked resource missing: " + lnks[li]);
            }
        }
        Directory.CreateDirectoryRecursive(outDir + "/assets");
        bool ok = w.Write(outDir + "/assets/assets.zrp", master, null, null);
        if (!ok) {
            log.Add("> ERROR: failed to write assets.zrp");
            return 0 - 1;
        }
        return count[0];
    }
}
