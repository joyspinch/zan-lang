using System;
using System.IO;
using System.Threading;
using System.Net.Sockets;
using System.Net.Http;
using System.Net.Http.Client;

/// The AI chat transport: a real HTTPS request made with the Net standard
/// library, running on a worker thread INSIDE the IDE process. The decoded
/// response body (a text/event-stream) lands in an in-memory sink as chunks
/// arrive; the GUI thread reads the sink every frame, so the answer appears
/// incrementally while the event loop stays responsive.
///
/// Nothing is written to disk: the sink hands the bytes and the outcome
/// across the thread boundary under its own lock. Earlier versions ran the
/// request in a re-executed child process and passed the stream through
/// files in the cache directory, because driving the async reactor on a
/// second OS thread was thought to race the GUI thread's allocator. It does
/// not: object refcounts are atomic and the allocator is per-thread, and the
/// scheduler and reactor state a request touches belong to the thread that
/// drives them.
class AiNet {
    /// The request the panel is reading. Dropped (null) by a cancel: an
    /// abandoned worker keeps writing into the sink it captured, which nobody
    /// reads any more.
    static AiReq sCur;

    /// Bumped by every Start and every Abandon, so a worker can tell whether
    /// it is still the request the panel cares about before it retries.
    static int sGen;

    /// Requests handed to a worker that has not claimed one yet, and the lock
    /// that guards the list. A thread body must not capture (Thread.Start takes
    /// a non-capturing delegate), so the request travels through this queue
    /// instead of through shared request fields: every Start pushes exactly one
    /// request and starts exactly one worker, so each worker claims a distinct
    /// request object and two overlapping requests cannot end up driving the
    /// same URL, body, key or sink.
    static List<AiReq> sPend;
    #if WINDOWS
    static nint sLock;
    #else
    static string sLock;
    #endif

    static void EnsureQueue() {
        if (AiNet.sPend == null) {
            AiNet.sPend = new List<AiReq>();
            AiNet.sLock = Mutex.Create();
        }
    }

    static void Push(AiReq rq) {
        AiNet.EnsureQueue();
        Mutex.Lock(AiNet.sLock);
        AiNet.sPend.Add(rq);
        Mutex.Unlock(AiNet.sLock);
    }

    /// Claims one queued request, or null when another worker already took it.
    static AiReq Take() {
        AiNet.EnsureQueue();
        Mutex.Lock(AiNet.sLock);
        AiReq rq = null;
        if (AiNet.sPend.Count > 0) {
            rq = AiNet.sPend[0];
            AiNet.sPend.RemoveAt(0);
        }
        Mutex.Unlock(AiNet.sLock);
        return rq;
    }

    /// The worker thread's entry point: claim a request and drive it.
    static void Worker() {
        AiReq rq = AiNet.Take();
        if (rq == null) { return; }
        AiNet.Drive(rq);
    }

    /// The request itself: builds the client from its own snapshot and streams
    /// the response into its own sink.
    static async int RunReq(AiReq rq) {
        HttpClient cli;
        if (rq.tls) { cli = HttpClient.CreateHttps(rq.host, rq.port); }
        else { cli = new HttpClient(rq.host, rq.port); }
        if (!rq.verify) { cli.DisableTlsVerify(); }
        if (rq.key != "") { cli.SetHeader("Authorization", "Bearer " + rq.key); }
        cli.SetHeader("Content-Type", "application/json");
        cli.SetHeader("Accept", "text/event-stream");
        cli.SetTimeout(rq.timeout);
        int rr = await cli.PostSseToSinkAsync(rq.path, rq.body, rq.sink);
        return rr;
    }

    /// True when an outcome marker means success (it begins with "ok").
    static bool IsOk(string marker) {
        string s = marker;
        int a = 0;
        for (a = 0; a < s.Length; a = a + 1) {
            string ch = s.Substring(a, 1);
            if (ch != " " && ch != "\r" && ch != "\n" && ch != "\t") { break; }
        }
        return a + 2 <= s.Length && s.Substring(a, 2) == "ok";
    }

    /// True when a failed attempt is worth repeating: a dropped connection, a
    /// timeout, a rate limit or a gateway error. A refusal the provider
    /// explained (a wrong key, an unknown model, a body it rejected) answers
    /// the same way every time, so resending it only delays the message the
    /// user needs to see by the whole backoff.
    static bool Retryable(string marker) {
        if (AiNet.Has(marker, "HTTP 5")) { return true; }
        if (AiNet.Has(marker, "HTTP 429")) { return true; }
        if (AiNet.Has(marker, "HTTP 408")) { return true; }
        if (AiNet.Has(marker, "HTTP ")) { return false; }
        return true;
    }

    static bool Has(string s, string sub) {
        if (sub.Length == 0 || s.Length < sub.Length) { return false; }
        for (int i = 0; i + sub.Length <= s.Length; i = i + 1) {
            if (s.Substring(i, sub.Length) == sub) { return true; }
        }
        return false;
    }

    /// Drives the request to completion on its own OS thread, retrying
    /// transient failures. The thread's coroutine scheduler pumps every
    /// `await` (connect / recv) until the stream ends. Only the final outcome
    /// is published, so the GUI never sees a mid-retry error and a dropped
    /// connection recovers on its own. Up to 3 attempts (2 retries) with a
    /// growing backoff.
    static void Drive(AiReq rq) {
        Socket.Initialize();
        SseSink sink = rq.sink;
        int attempt = 0;
        string last = "";
        while (attempt < 3) {
            last = "";
            // A throw anywhere in the transport (DNS, TLS, a closed socket)
            // must still end as a marker: without this the worker dies
            // silently and the panel waits out its whole backstop before
            // reporting a timeout that was really a connect error.
            try {
                int _r = await AiNet.RunReq(rq);
            } catch (Exception ex) {
                last = "err: " + ex.Message;
            }
            if (last == "") { last = sink.Attempt(); }
            if (AiNet.IsOk(last)) {
                sink.Publish("ok");
                return;
            }
            if (!AiNet.Retryable(last)) {
                sink.Publish(last);
                return;
            }
            attempt = attempt + 1;
            // Nobody is reading this sink any more (stopped, or superseded by
            // the next question): stop instead of spending a backoff and
            // another provider call on an answer that is already gone.
            if (rq.gen != AiNet.sGen) { return; }
            // Backoff 1s / 2s between retries: enough for a dropped
            // connection to recover, short enough to not stall the reply.
            if (attempt < 3) { Thread.Sleep(1000 * attempt); }
        }
        string msg = last;
        if (msg == "") { msg = "err: request failed"; }
        sink.Publish(msg);
    }

    /// Parses `baseUrl` (scheme://host[:port][/base]) into `rq` and appends
    /// `suffix` (e.g. "/chat/completions") to its path.
    static void SetUrl(AiReq rq, string baseUrl, string suffix) {
        string u = baseUrl;
        bool tls = true;
        int defPort = 443;
        if (u.Length >= 8 && u.Substring(0, 8) == "https://") {
            u = u.Substring(8, u.Length - 8); tls = true; defPort = 443;
        } else if (u.Length >= 7 && u.Substring(0, 7) == "http://") {
            u = u.Substring(7, u.Length - 7); tls = false; defPort = 80;
        }
        int slash = AiNet.FindByte(u, 47, 0);
        string hostport = u;
        string basePath = "";
        if (slash >= 0) {
            hostport = u.Substring(0, slash);
            basePath = u.Substring(slash, u.Length - slash);
        }
        while (basePath.Length > 0
            && (basePath[basePath.Length - 1] & 255) == 47) {
            basePath = basePath.Substring(0, basePath.Length - 1);
        }
        int port = defPort;
        string host = hostport;
        int colon = AiNet.FindByte(hostport, 58, 0);
        if (colon >= 0) {
            host = hostport.Substring(0, colon);
            port = AiNet.ParseInt(hostport.Substring(colon + 1,
                hostport.Length - colon - 1), defPort);
        }
        rq.host = host;
        rq.port = port;
        rq.tls = tls;
        rq.path = basePath + suffix;
    }

    static int FindByte(string s, int b, int from) {
        for (int i = from; i < s.Length; i = i + 1) {
            if ((s[i] & 255) == b) { return i; }
        }
        return 0 - 1;
    }

    static int ParseInt(string s, int fallback) {
        int v = 0;
        bool any = false;
        for (int i = 0; i < s.Length; i = i + 1) {
            int c = s[i] & 255;
            if (c < 48 || c > 57) { break; }
            v = v * 10 + (c - 48);
            any = true;
        }
        if (!any) { return fallback; }
        return v;
    }

    /// Kicks off the request on a worker thread. Returns "" on success or a
    /// readable error when the thread cannot be started.
    static string Start(string baseUrl, string suffix, string key, string body,
            int timeoutMs, bool verify) {
        AiReq rq = new AiReq();
        AiNet.SetUrl(rq, baseUrl, suffix);
        rq.key = key;
        rq.body = body;
        rq.timeout = timeoutMs;
        rq.verify = verify;
        rq.sink = SseSink.ToMemory();
        AiNet.sGen = AiNet.sGen + 1;
        rq.gen = AiNet.sGen;
        AiNet.sCur = rq;
        AiNet.Push(rq);
        if (!Thread.Start(AiNet.Worker)) {
            AiReq _drop = AiNet.Take();
            AiNet.sCur = null;
            return "could not start the AI request thread.";
        }
        return "";
    }

    /// Everything the reply has streamed so far ("" when nothing is in
    /// flight). Safe to call from the GUI thread every frame.
    static string Text() {
        if (AiNet.sCur == null) { return ""; }
        return AiNet.sCur.sink.All();
    }

    /// The final outcome of the request in flight ("ok" / "err: ..."), or ""
    /// while it is still streaming.
    static string Done() {
        if (AiNet.sCur == null) { return ""; }
        return AiNet.sCur.sink.Done();
    }

    /// Forgets the request in flight. A worker still running keeps streaming
    /// into the sink it captured; nothing reads it, and it is freed once the
    /// worker returns.
    static void Abandon() {
        AiNet.sCur = null;
        AiNet.sGen = AiNet.sGen + 1;
    }
}

/// One AI request: everything the worker thread needs, snapshotted when the
/// GUI starts it. A request is never edited after it is handed over, so two
/// requests can overlap without touching each other's URL, body, key or sink.
class AiReq {
    string host;
    int port;
    bool tls;
    bool verify;
    string path;
    string key;
    string body;
    int timeout;
    SseSink sink;
    int gen;
}
