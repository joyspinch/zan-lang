using System;
using System.IO;
using System.Threading;
using System.Net.Sockets;
using System.Net.Http;
using System.Net.Http.Client;
using System.Net.External;

/// IDE 工具链交互与状态驱动契约。
/// IDE 工具链交互与状态驱动契约。
/// IDE 工具链交互与状态驱动契约。
/// IDE 工具链交互与状态驱动契约。
/// IDE 工具链交互与状态驱动契约。
///
/// IDE 工具链交互与状态驱动契约。
/// IDE 工具链交互与状态驱动契约。
/// IDE 工具链交互与状态驱动契约。
/// IDE 工具链交互与状态驱动契约。
/// IDE 工具链交互与状态驱动契约。
/// IDE 工具链交互与状态驱动契约。
/// IDE 工具链交互与状态驱动契约。
/// 核心契约与执行状态转移规范。
class AiNet {
    /// IDE 工具链交互与状态驱动契约。
    /// IDE 工具链交互与状态驱动契约。
    /// 核心契约与执行状态转移规范。
    static AiReq sCur;

    /// IDE 工具链交互与状态驱动契约。
    /// IDE 工具链交互与状态驱动契约。
    /// IDE 工具链交互与状态驱动契约。
    /// 核心契约与执行状态转移规范。
    static ExternalCallPolicy Policy(bool allowLocal, string idempotencyKey) {
        return AiNet.Policy(allowLocal, idempotencyKey, 600000);
    }

    static ExternalCallPolicy Policy(bool allowLocal, string idempotencyKey,
            int totalTimeoutMs) {
        ExternalCallPolicy p = ExternalCallPolicy.Default()
            .ConnectTimeout(15000)
            .WriteTimeout(15000)
            .ReadTimeout(totalTimeoutMs)
            .IdleTimeout(totalTimeoutMs)
            .TotalTimeout(totalTimeoutMs)
            .RequestLimit(8388608)
            .ResponseLimit(16777216)
            .ErrorLimit(65536)
            .StreamLimit(33554432)
            .Redirects(0)
            .RetryNetwork(true)
            .RetryAttempts(2)
            .RetryBackoff(1000);
        if (allowLocal) { p.AllowLocalHttp(); }
        if (idempotencyKey != null && idempotencyKey != "") {
            p.Idempotent(idempotencyKey);
        }
        return p;
    }

    /// IDE 工具链交互与状态驱动契约。
    /// IDE 工具链交互与状态驱动契约。
    static bool IsLocalOllama(string baseUrl) {
        if (baseUrl == null) { return false; }
        string u = baseUrl;
        while (u.Length > 0 && u.Substring(u.Length - 1, 1) == "/") {
            u = u.Substring(0, u.Length - 1);
        }
        return ExternalTargetPolicy.AllowExactLocal(u,
            "http://127.0.0.1:11434/v1");
    }

    /// IDE 工具链交互与状态驱动契约。
    /// IDE 工具链交互与状态驱动契约。
    static int sGen;

    /// IDE 工具链交互与状态驱动契约。
    /// IDE 工具链交互与状态驱动契约。
    /// IDE 工具链交互与状态驱动契约。
    /// IDE 工具链交互与状态驱动契约。
    /// IDE 工具链交互与状态驱动契约。
    /// IDE 工具链交互与状态驱动契约。
    /// 核心契约与语义定义。
    static List<AiReq> sPend;
    // IDE 工具链交互与状态驱动契约。
    static int sActive;
    #if WINDOWS
    static nint sLock;
    #else
    static string sLock;
    #endif

    static void EnsureQueue() {
        if (AiNet.sPend == null) {
            AiNet.sPend = new List<AiReq>();
            AiNet.sLock = Mutex.Create();
        }
    }

    static void Push(AiReq rq) {
        AiNet.EnsureQueue();
        Mutex.Lock(AiNet.sLock);
        AiNet.sPend.Add(rq);
        Mutex.Unlock(AiNet.sLock);
    }

    /// IDE 工具链交互与状态驱动契约。
    static AiReq Take() {
        AiNet.EnsureQueue();
        Mutex.Lock(AiNet.sLock);
        AiReq rq = null;
        if (AiNet.sPend.Count > 0) {
            rq = AiNet.sPend[0];
            AiNet.sPend.RemoveAt(0);
        }
        Mutex.Unlock(AiNet.sLock);
        return rq;
    }

    /// IDE 工具链交互与状态驱动契约。
    static void Worker() {
        AiReq rq = AiNet.Take();
        if (rq == null) { return; }
        Mutex.Lock(AiNet.sLock);
        AiNet.sActive = AiNet.sActive + 1;
        Mutex.Unlock(AiNet.sLock);
        AiNet.Drive(rq);
        Mutex.Lock(AiNet.sLock);
        AiNet.sActive = AiNet.sActive - 1;
        Mutex.Unlock(AiNet.sLock);
    }

    /// IDE 工具链交互与状态驱动契约。
    /// IDE 工具链交互与状态驱动契约。
    /// IDE 工具链交互与状态驱动契约。
    /// IDE 工具链交互与状态驱动契约。
    /// 核心契约与语义定义。
    static async void DrainAsync() {
        AiNet.EnsureQueue();
        int waited = 0;
        while (waited < 3000) {
            bool idle;
            Mutex.Lock(AiNet.sLock);
            idle = AiNet.sPend.Count == 0 && AiNet.sActive == 0;
            Mutex.Unlock(AiNet.sLock);
            if (idle) { return; }
            await Task.Delay(50);
            waited = waited + 50;
        }
    }

    /// IDE 工具链交互与状态驱动契约。
    /// IDE 工具链交互与状态驱动契约。
    static async int RunReq(AiReq rq) {
        HttpClient cli;
        if (rq.tls) { cli = HttpClient.CreateHttps(rq.host, rq.port); }
        else { cli = new HttpClient(rq.host, rq.port); }
        if (!rq.verify) { cli.DisableTlsVerify(); }
        if (rq.key != "") { cli.SetHeader("Authorization", "Bearer " + rq.key); }
        string idem = rq.policy.IdempotencyKey();
        if (idem != "") { cli.SetHeader("Idempotency-Key", idem); }
        cli.SetHeader("Content-Type", "application/json");
        cli.SetHeader("Accept", "text/event-stream");
        cli.SetCallPolicy(rq.policy);
        cli.SetTimeout(rq.timeout);
        int rr = await cli.PostSseToSinkAsync(rq.path, rq.body, rq.sink);
        return rr;
    }

    /// IDE 工具链交互与状态驱动契约。
    static bool IsOk(string marker) {
        string s = marker;
        int a = 0;
        for (a = 0; a < s.Length; a = a + 1) {
            string ch = s.Substring(a, 1);
            if (ch != " " && ch != "\r" && ch != "\n" && ch != "\t") { break; }
        }
        return a + 2 <= s.Length && s.Substring(a, 2) == "ok";
    }

    /// IDE 工具链交互与状态驱动契约。
    /// IDE 工具链交互与状态驱动契约。
    /// IDE 工具链交互与状态驱动契约。
    /// IDE 工具链交互与状态驱动契约。
    /// IDE 工具链交互与状态驱动契约。
    static bool Retryable(string marker) {
        if (AiNet.Has(marker, "HTTP 5")) { return true; }
        if (AiNet.Has(marker, "HTTP 429")) { return true; }
        if (AiNet.Has(marker, "HTTP 408")) { return true; }
        if (AiNet.Has(marker, "HTTP ")) { return false; }
        return true;
    }

    static bool Has(string s, string sub) {
        if (sub.Length == 0 || s.Length < sub.Length) { return false; }
        for (int i = 0; i + sub.Length <= s.Length; i = i + 1) {
            if (s.Substring(i, sub.Length) == sub) { return true; }
        }
        return false;
    }

    /// IDE 工具链交互与状态驱动契约。
    /// IDE 工具链交互与状态驱动契约。
    /// IDE 工具链交互与状态驱动契约。
    static void Drive(AiReq rq) {
        Socket.Initialize();
        SseSink sink = rq.sink;
        ExternalCallPolicy policy = rq.policy;
        int retry = 0;
        string last = "";
        while (true) {
            last = "";
            // IDE 工具链交互与状态驱动契约。
            // IDE 工具链交互与状态驱动契约。
            // IDE 工具链交互与状态驱动契约。
            // IDE 工具链交互与状态驱动契约。
            try {
                int _r = await AiNet.RunReq(rq);
            } catch (Exception ex) {
                last = "err: " + ex.Message;
            }
            if (last == "") { last = sink.Attempt(); }
            if (AiNet.IsOk(last)) {
                sink.Publish("ok");
                return;
            }
            int status = sink.ResponseStatus();
            // IDE 工具链交互与状态驱动契约。
            // IDE 工具链交互与状态驱动契约。
            // IDE 工具链交互与状态驱动契约。
            bool canRetry = policy.CanRetry("POST", false, status)
                && AiNet.Retryable(last);
            if (!canRetry || retry >= policy.RetryAttempts()) {
                if (last == "") { last = "err: request failed"; }
                sink.Publish(last);
                return;
            }
            retry = retry + 1;
            // IDE 工具链交互与状态驱动契约。
            // IDE 工具链交互与状态驱动契约。
            // IDE 工具链交互与状态驱动契约。
            if (rq.gen != AiNet.sGen) { return; }
            int delay = policy.RetryBackoffMs() * retry;
            if (delay > 0) { Thread.Sleep(delay); }
        }
    }

    /// IDE 工具链交互与状态驱动契约。
    /// IDE 工具链交互与状态驱动契约。
    /// IDE 工具链交互与状态驱动契约。
    static bool SetUrl(AiReq rq, string baseUrl, string suffix) {
        ExternalTarget target = ExternalTarget.Parse(baseUrl);
        if (target == null || target.Query() != "") { return false; }
        bool local = AiNet.IsLocalOllama(baseUrl);
        if (!ExternalTargetPolicy.IsAllowedTarget(target, local, local)) {
            return false;
        }
        string basePath = target.Path();
        while (basePath.Length > 0
            && basePath.Substring(basePath.Length - 1, 1) == "/") {
            basePath = basePath.Substring(0, basePath.Length - 1);
        }
        rq.host = target.Host();
        rq.port = target.Port();
        rq.tls = target.IsTls();
        rq.path = basePath + suffix;
        return true;
    }

    static int FindByte(string s, int b, int from) {
        for (int i = from; i < s.Length; i = i + 1) {
            if ((s[i] & 255) == b) { return i; }
        }
        return 0 - 1;
    }

    static int ParseInt(string s, int fallback) {
        int v = 0;
        bool any = false;
        for (int i = 0; i < s.Length; i = i + 1) {
            int c = s[i] & 255;
            if (c < 48 || c > 57) { break; }
            v = v * 10 + (c - 48);
            any = true;
        }
        if (!any) { return fallback; }
        return v;
    }

    /// IDE 工具链交互与状态驱动契约。
    /// IDE 工具链交互与状态驱动契约。
    static string Start(string baseUrl, string suffix, string key, string body,
            int timeoutMs, bool verify) {
        return AiNet.Start(baseUrl, suffix, key, body, timeoutMs, verify, "");
    }

    /// IDE 工具链交互与状态驱动契约。
    /// IDE 工具链交互与状态驱动契约。
    static string Start(string baseUrl, string suffix, string key, string body,
            int timeoutMs, bool verify, string idempotencyKey) {
        AiReq rq = new AiReq();
        if (!AiNet.SetUrl(rq, baseUrl, suffix)) {
            return "invalid or disallowed AI endpoint.";
        }
        rq.key = key;
        rq.body = body;
        rq.timeout = timeoutMs;
        rq.verify = verify;
        // IDE 工具链交互与状态驱动契约。
        // IDE 工具链交互与状态驱动契约。
        // IDE 工具链交互与状态驱动契约。
        rq.policy = AiNet.Policy(AiNet.IsLocalOllama(baseUrl), idempotencyKey);
        rq.sink = SseSink.ToMemory();
        AiNet.sGen = AiNet.sGen + 1;
        rq.gen = AiNet.sGen;
        AiNet.sCur = rq;
        AiNet.Push(rq);
        if (!Thread.Start(AiNet.Worker)) {
            AiReq _drop = AiNet.Take();
            AiNet.sCur = null;
            return "could not start the AI request thread.";
        }
        return "";
    }

    /// IDE 工具链交互与状态驱动契约。
    static AiReq Snapshot() { return AiNet.sCur; }

    /// IDE 工具链交互与状态驱动契约。
    /// IDE 工具链交互与状态驱动契约。
    static string Text() {
        if (AiNet.sCur == null) { return ""; }
        return AiNet.sCur.sink.All();
    }

    /// 自上次调用以来新到的那一段（"" = 没有新内容）。逐帧刷新预览的读者用
    /// 这个：`Text()` 每一拍都要把已经收到的全文复制一遍（还占着流写入的那把
    /// 锁），一个几百 KB 的长回答光是这份复制就够烧掉一核。最终那一轮仍然从
    /// `Text()` 的全文重新解析，所以内容一份没少。
    static string Since() {
        if (AiNet.sCur == null) { return ""; }
        return AiNet.sCur.sink.Since();
    }

    /// IDE 工具链交互与状态驱动契约。
    /// IDE 工具链交互与状态驱动契约。
    /// IDE 工具链交互与状态驱动契约。
    /// 核心契约与语义定义。
    static int Length() {
        if (AiNet.sCur == null) { return 0; }
        return AiNet.sCur.sink.Total();
    }

    /// IDE 工具链交互与状态驱动契约。
    /// IDE 工具链交互与状态驱动契约。
    /// IDE 工具链交互与状态驱动契约。
    static int Gen() {
        if (AiNet.sCur == null) { return 0; }
        return AiNet.sCur.gen;
    }

    /// IDE 工具链交互与状态驱动契约。
    /// 核心契约与执行状态转移规范。
    static string Done() {
        if (AiNet.sCur == null) { return ""; }
        return AiNet.sCur.sink.Done();
    }

    /// IDE 工具链交互与状态驱动契约。
    /// IDE 工具链交互与状态驱动契约。
    /// 核心契约与执行状态转移规范。
    static void Abandon() {
        AiNet.sCur = null;
        AiNet.sGen = AiNet.sGen + 1;
    }
}

/// IDE 工具链交互与状态驱动契约。
/// IDE 工具链交互与状态驱动契约。
/// IDE 工具链交互与状态驱动契约。
class AiReq {
    string host;
    int port;
    bool tls;
    bool verify;
    string path;
    string key;
    string body;
    int timeout;
    ExternalCallPolicy policy;
    SseSink sink;
    int gen;
}
