using System;
using System.Text;
using System.Collections.Generic;

// 差异类型枚举：未变、新增、删除
public enum DiffKind {
    Unchanged = 0,
    Added = 1,
    Deleted = 2
}

// 单行差异记录：用于在可视化差异审查器中呈现单行对比
public class DiffLine {
    public DiffKind kind;
    public int oldLineNo; // 原文件行号（1-based，新增行为 0）
    public int newLineNo; // 新文件行号（1-based，删除行为 0）
    public string text;   // 该行文本内容

    public DiffLine(DiffKind kind, int oldLineNo, int newLineNo, string text) {
        this.kind = kind;
        this.oldLineNo = oldLineNo;
        this.newLineNo = newLineNo;
        this.text = text != null ? text : "";
    }

    public string Marker() {
        if (this.kind == DiffKind.Added) { return "+"; }
        if (this.kind == DiffKind.Deleted) { return "-"; }
        return " ";
    }
}

// 纯 Zan 实现的轻量高效行级 Diff 引擎
// 具备首尾公共子序列剪枝（O(N)）与中间区域最长公共子序列（LCS）精确还原
public class AiDiff {

    // 将文本安全按行切分（统一剥离 \r 并保留每行内容）
    public static List<string> SplitLines(string text) {
        List<string> lines = new List<string>();
        if (text == null || text.Length == 0) {
            return lines;
        }
        int len = text.Length;
        int start = 0;
        for (int i = 0; i < len; i = i + 1) {
            char c = text[i];
            if (c == '\n') {
                int end = i;
                if (end > start && text[end - 1] == '\r') {
                    end = end - 1;
                }
                lines.Add(text.Substring(start, end - start));
                start = i + 1;
            }
        }
        if (start < len) {
            int end = len;
            if (end > start && text[end - 1] == '\r') {
                end = end - 1;
            }
            lines.Add(text.Substring(start, end - start));
        }
        return lines;
    }

    // 统计差异列表中的新增与删除行数
    public static void CountChanges(List<DiffLine> lines, out int adds, out int dels) {
        adds = 0;
        dels = 0;
        if (lines == null) { return; }
        for (int i = 0; i < lines.Count; i = i + 1) {
            DiffLine l = lines[i];
            if (l.kind == DiffKind.Added) {
                adds = adds + 1;
            } else if (l.kind == DiffKind.Deleted) {
                dels = dels + 1;
            }
        }
    }

    // 对比两段文本并生成完整的结构化 DiffLine 序列
    public static List<DiffLine> Compare(string oldText, string newText) {
        List<string> a = AiDiff.SplitLines(oldText);
        List<string> b = AiDiff.SplitLines(newText);
        List<DiffLine> result = new List<DiffLine>();

        int aCount = a.Count;
        int bCount = b.Count;

        // 优化 1：掐除头部公共行（O(N) 极速匹配）
        int prefix = 0;
        while (prefix < aCount && prefix < bCount && a[prefix] == b[prefix]) {
            result.Add(new DiffLine(DiffKind.Unchanged, prefix + 1, prefix + 1, a[prefix]));
            prefix = prefix + 1;
        }

        // 优化 2：掐除尾部公共行（O(N) 极速匹配）
        int suffix = 0;
        while (suffix < aCount - prefix && suffix < bCount - prefix &&
               a[aCount - 1 - suffix] == b[bCount - 1 - suffix]) {
            suffix = suffix + 1;
        }

        // 中间实际发生变动的区间
        int midA = aCount - prefix - suffix;
        int midB = bCount - prefix - suffix;

        if (midA > 0 && midB == 0) {
            // 全删
            for (int i = 0; i < midA; i = i + 1) {
                int line = prefix + i + 1;
                result.Add(new DiffLine(DiffKind.Deleted, line, 0, a[prefix + i]));
            }
        } else if (midA == 0 && midB > 0) {
            // 全增
            for (int i = 0; i < midB; i = i + 1) {
                int line = prefix + i + 1;
                result.Add(new DiffLine(DiffKind.Added, 0, line, b[prefix + i]));
            }
        } else if (midA > 0 && midB > 0) {
            // 中间存在增删改：若区间过大（> 1500 行），降级为快块替换避免矩阵爆炸
            if (midA > 1500 || midB > 1500) {
                for (int i = 0; i < midA; i = i + 1) {
                    result.Add(new DiffLine(DiffKind.Deleted, prefix + i + 1, 0, a[prefix + i]));
                }
                for (int i = 0; i < midB; i = i + 1) {
                    result.Add(new DiffLine(DiffKind.Added, 0, prefix + i + 1, b[prefix + i]));
                }
            } else {
                // 标准 DP LCS 算法
                int rows = midA + 1;
                int cols = midB + 1;
                int[] dp = new int[rows * cols];

                for (int i = 1; i <= midA; i = i + 1) {
                    for (int j = 1; j <= midB; j = j + 1) {
                        if (a[prefix + i - 1] == b[prefix + j - 1]) {
                            dp[i * cols + j] = dp[(i - 1) * cols + (j - 1)] + 1;
                        } else {
                            int v1 = dp[(i - 1) * cols + j];
                            int v2 = dp[i * cols + (j - 1)];
                            dp[i * cols + j] = v1 > v2 ? v1 : v2;
                        }
                    }
                }

                // 回溯重构差异链
                List<DiffLine> midDiffs = new List<DiffLine>();
                int currI = midA;
                int currJ = midB;

                while (currI > 0 || currJ > 0) {
                    if (currI > 0 && currJ > 0 && a[prefix + currI - 1] == b[prefix + currJ - 1]) {
                        midDiffs.Add(new DiffLine(DiffKind.Unchanged, prefix + currI, prefix + currJ, a[prefix + currI - 1]));
                        currI = currI - 1;
                        currJ = currJ - 1;
                    } else if (currJ > 0 && (currI == 0 || dp[currI * cols + (currJ - 1)] >= dp[(currI - 1) * cols + currJ])) {
                        midDiffs.Add(new DiffLine(DiffKind.Added, 0, prefix + currJ, b[prefix + currJ - 1]));
                        currJ = currJ - 1;
                    } else if (currI > 0 && (currJ == 0 || dp[currI * cols + (currJ - 1)] < dp[(currI - 1) * cols + currJ])) {
                        midDiffs.Add(new DiffLine(DiffKind.Deleted, prefix + currI, 0, a[prefix + currI - 1]));
                        currI = currI - 1;
                    }
                }

                // 反转回溯顺序并拼装
                for (int i = midDiffs.Count - 1; i >= 0; i = i - 1) {
                    result.Add(midDiffs[i]);
                }
            }
        }

        // 拼接尾部公共行
        for (int i = 0; i < suffix; i = i + 1) {
            int oldL = aCount - suffix + i + 1;
            int newL = bCount - suffix + i + 1;
            result.Add(new DiffLine(DiffKind.Unchanged, oldL, newL, a[aCount - suffix + i]));
        }

        return result;
    }
}
