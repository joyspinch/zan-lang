using System;

public class IdeVersion {
    static string Number() { return "0.0.0"; }

    static string Date() { return ""; }

    static string Commit() { return ""; }

    static string Product() { return "Zan IDE " + IdeVersion.Number(); }

    static string Full() {
        string s = IdeVersion.Number();
        string detail = IdeVersion.Date();
        if (IdeVersion.Commit() != "") {
            if (detail != "") { detail = detail + ", "; }
            detail = detail + IdeVersion.Commit();
        }
        if (detail != "") { s = s + " (" + detail + ")"; }
        return s;
    }
}
