using System;
using System.IO;
using System.Diagnostics;
using System.Json;
using System.Text;
using System.Threading;
using Platform;
using Gui;
using Gui.Component;
using System.Net.Sockets;

// 核心契约与执行状态转移规范。
// 接口数据协议与执行契约。

class LspNotification {
    string jsonrpc;
    string method;
    JsonValue params;
}

class LspRequest {
    string jsonrpc;
    int id;
    string method;
    JsonValue params;
}

class LspInitParams {
    JsonValue processId;      // 接口数据协议与执行契约。
    string rootUri;
    JsonValue capabilities;
}

class LspTextDocumentItem {
    string uri;
    string languageId;
    int version;
    string text;
}

class LspDidOpenParams {
    LspTextDocumentItem textDocument;
}

class LspTextDocumentIdentifier {
    string uri;
}

class LspVersionedDocument {
    string uri;
    int version;
}

class LspContentChange {
    string text;
}

class LspDidChangeParams {
    LspVersionedDocument textDocument;
    List<LspContentChange> contentChanges;
}

class LspOpenDocument {
    string path;
    string text;
    int version;
    List<string> lines;
}

class LspPosition {
    int line;
    int character;
}

class LspReferenceContext {
    bool includeDeclaration;
}

class LspDocPosParams {
    LspTextDocumentIdentifier textDocument;
    LspPosition position;
}

// {"textDocument": {...}} — foldingRange 等只带文档选择器的请求参数。
class LspDocParams {
    LspTextDocumentIdentifier textDocument;
}

class LspReferenceParams {
    LspTextDocumentIdentifier textDocument;
    LspPosition position;
    LspReferenceContext context;
}

class LspRenameParams {
    LspTextDocumentIdentifier textDocument;
    LspPosition position;
    string newName;
}

// 接口数据协议与执行契约。

class LspDefinitionTarget {
    string path;
    int line;
    int column;  // UTF-16 码元列，载入目标文本后再转换为字节列。
}

class LspRenameEdit {
    string path;
    LspPosition start;
    LspPosition end;
    string newText;
    int version;  // -1 表示 changes 或未带版本的 TextDocumentEdit。
}

class LspEditApplication {
    bool valid;
    string text;
}

class LspEditSpan {
    int start;
    int end;
    string newText;
}

class LspLocation {
    string uri;
    JsonValue range;
}

class LspLocationsResult {
    List<LspLocation> result;
}

class LspHoverResult {
    JsonValue result;
}

class LspCompletionItem {
    string label;
    int kind;
    string detail;
    JsonValue documentation;
    string insertText;
    int insertTextFormat;
    string sortText;
    JsonValue textEdit;
}

class LspCompletionsResult {
    List<LspCompletionItem> result;
}

class LspParameterInformation {
    string label;
    JsonValue documentation;
}

class LspSignatureInformation {
    string label;
    JsonValue documentation;
    List<LspParameterInformation> parameters;
}

class LspSignatureHelp {
    List<LspSignatureInformation> signatures;
    int activeSignature;
    int activeParameter;
}

class LspSignatureHelpResult {
    LspSignatureHelp result;
}

enum LspPendingState { Pending, Ready, Empty, Error, Timeout, Cancelled }

// 接口数据协议与执行契约。
delegate void LspReadyHandler(LspSession session, bool ready);
delegate void LspFoldingHandler(LspFoldingResult result);
delegate void LspDefinitionHandler(LspDefinitionResult result);
delegate void LspReferencesHandler(LspReferencesResult result);
delegate void LspRenameHandler(LspRenameResult result);

class LspResult {
    string path;
    int version;
    int stamp;
    int generation;
    int documentGeneration;
    LspPendingState state;
}

class LspFoldingResult : LspResult {
    List<CodeFoldRegion> regions;
}

class LspDefinitionResult : LspResult {
    LspDefinitionTarget target;
}

class LspReferencesResult : LspResult {
    List<string> rows;
}

class LspDocumentSnapshot {
    string path;
    string text;
    int version;
}

class LspRenameResult : LspResult {
    List<LspRenameEdit> edits;
    List<LspDocumentSnapshot> documents;
}

// 接口数据协议与执行契约。
class LspCommand {
    string method;
    string path;
    string text;
    string name;
    int id;
    int version;
    int stamp;
    int line;
    int col;
    int generation;
    int documentGeneration;
    CancellationToken cancellation;
    LspFoldingHandler folding;
    LspDefinitionHandler definition;
    LspReferencesHandler references;
    LspRenameHandler rename;
    List<LspDocumentSnapshot> documents;
}

class LspWorkerResult : LspResult {
    int id;
    string method;
    List<CodeCompletionItem> completions;
    string signatureLabel;
    string hover;
    LspFoldingResult folding;
    LspDefinitionResult definition;
    LspReferencesResult references;
    LspRenameResult rename;
}

class LspSendFrame {
    string data;
    int offset;
    int requestId;
}

// 同一个实体同时由 ID 分发表和语义缓存引用，终态也保留以抑制重复请求。
class LspPendingRequest {
    int id;
    string method;
    string path;
    string name;
    int version;
    int documentGeneration;
    int generation;
    int line;
    int col;
    long deadline;
    LspPendingState state;
    string message;
    List<LspCompletionItem> completions;
    LspSignatureHelp signature;
    string hover;
    CodeEditor editor;
    string text;
    int stamp;
    int caretLine;
    int caretCol;
    int completionToken;
    List<CodeCompletionItem> editorCompletions;
    string signatureLabel;
    CancellationTokenSource cancellation;
}

// 接口数据协议与执行契约。
// 核心契约与语义定义。
// 接口数据协议与执行契约。
class LspSession {
    #if WINDOWS
    [DllImport("kernel32", EntryPoint = "Sleep")]
    static extern void plat_sleep(int ms);
    #else
    [DllImport("crt", EntryPoint = "usleep")]
    static extern int plat_usleep(int us);
    #endif

    // 接口数据协议与执行契约。
    bool background;
    bool stopping;
    App uiApp;
    BlockingQueue<LspCommand> commands;
    CancellationTokenSource shutdownSource;
    CancellationTokenSource commandSource;
    TaskCompletionSource<int> serviceStopped;
    CancellationToken serviceCancellation;
    CancellationToken activeCancellation;
    LspPendingState lastRequestState;

    // 接口数据协议与执行契约。
    nint sock;
    int seq;
    bool alive;
    bool nonBlocking;
    bool polling;
    bool editorRefreshNeeded;
    string rbuf;
    int waitBudget;
    List<LspSendFrame> sendQueue;
    int queuedBytes;
    long sendProgressMs;
    Dict<int, LspPendingRequest> pending;
    List<LspPendingRequest> cache;
    CodeEditor boundEditor;
    int generation;
    Dict<string, LspOpenDocument> documents;
    int documentGeneration;

    // 接口数据协议与执行契约。
    static LspSession StartAsync(App app, string root, LspReadyHandler completed = null) {
        LspSession session = new LspSession();
        session.background = true;
        session.uiApp = app;
        session.sock = -1;
        session.seq = 1;
        session.generation = 1;
        session.documents = new Dict<string, LspOpenDocument>();
        session.pending = new Dict<int, LspPendingRequest>();
        session.cache = new List<LspPendingRequest>();
        session.commands = new BlockingQueue<LspCommand>(null, 0);
        session.shutdownSource = new CancellationTokenSource();
        session.commandSource = new CancellationTokenSource();
        session.serviceStopped = new TaskCompletionSource<int>();
        LspSession workerSession = session;
        LspReadyHandler workerReady = completed;
        string workerRoot = root;
        TaskCompletionSource<int> stopped = session.serviceStopped;
        if (!Thread.Start(() => {
            try { workerSession.RunService(workerRoot, workerReady); }
            finally {
                // 接口数据协议与执行契约。
                workerSession = null;
                workerReady = null;
                workerRoot = "";
                stopped.TrySetResult(0);
            }
        })) {
            session.commands.Cancel();
            session.serviceStopped.TrySetResult(0);
            app.Post(() => {
                if (session.stopping) { return; }
                session.generation = session.generation + 1;
                session.CancelUiRequests(LspPendingState.Error);
                session.DetachEditor();
                if (completed != null) { completed(session, false); }
            }, "LspSession.Abort");
        }
        return session;
    }

    // 接口数据协议与执行契约。
    bool IsCurrent(string path, int version, int requestGeneration, int requestDocumentGeneration) {
        return !stopping && generation == requestGeneration
            && documentGeneration == requestDocumentGeneration && DocVersion(path) == version;
    }

    bool HaveDocVersion(string path, int version) {
        return version < 0 || DocVersion(path) == version;
    }

    List<LspDocumentSnapshot> SnapshotDocuments() {
        List<LspDocumentSnapshot> snapshots = new List<LspDocumentSnapshot>();
        if (documents == null) { return snapshots; }
        List<string> keys = documents.Keys;
        for (int i = 0; i < keys.Count; i = i + 1) {
            LspOpenDocument document = documents[keys[i]];
            LspDocumentSnapshot snapshot = new LspDocumentSnapshot();
            snapshot.path = document.path;
            snapshot.text = document.text;
            snapshot.version = document.version;
            snapshots.Add(snapshot);
        }
        return snapshots;
    }

    LspCommand CreateCommand(string method, string path, int line, int col) {
        LspCommand command = new LspCommand();
        command.method = method;
        command.path = path;
        command.line = line;
        command.col = col;
        command.version = DocVersion(path);
        command.generation = generation;
        command.documentGeneration = documentGeneration;
        if (background) { command.cancellation = commandSource.Token; }
        string key = DocumentUri(path);
        if (documents != null && documents.ContainsKey(key)) { command.text = documents[key].text; }
        else { command.text = ""; }
        return command;
    }

    void QueueCommand(LspCommand command) {
        if (!background) { throw new Exception("Async LSP commands require StartAsync."); }
        if (stopping || !commands.Enqueue(command)) {
            PublishResult(command, LspSession.EmptyWorkerResult(command, LspPendingState.Error));
        }
    }

    void RequestFoldingRanges(string path, int stamp, LspFoldingHandler completed) {
        LspCommand command = CreateCommand("textDocument/foldingRange", path, 0, 0);
        command.stamp = stamp;
        command.folding = completed;
        QueueCommand(command);
    }

    void DefinitionAsync(string path, int line0, int col0, LspDefinitionHandler completed) {
        LspCommand command = CreateCommand("textDocument/definition", path, line0, col0);
        command.definition = completed;
        QueueCommand(command);
    }

    void ReferencesAsync(string path, int line0, int col0, LspReferencesHandler completed) {
        LspCommand command = CreateCommand("textDocument/references", path, line0, col0);
        command.references = completed;
        QueueCommand(command);
    }

    void RenameAsync(string path, int line0, int col0, string newName, LspRenameHandler completed) {
        LspCommand command = CreateCommand("textDocument/rename", path, line0, col0);
        command.name = newName;
        command.rename = completed;
        command.documents = SnapshotDocuments();
        QueueCommand(command);
    }

    static void CopyResult(LspResult result, LspCommand command, LspPendingState state) {
        result.path = command.path;
        result.version = command.version;
        result.stamp = command.stamp;
        result.generation = command.generation;
        result.documentGeneration = command.documentGeneration;
        result.state = state;
    }

    static LspWorkerResult EmptyWorkerResult(LspCommand command, LspPendingState state) {
        LspWorkerResult result = new LspWorkerResult();
        LspSession.CopyResult(result, command, state);
        result.id = command.id;
        result.method = command.method;
        result.hover = "";
        result.signatureLabel = "";
        if (command.method == "textDocument/foldingRange") {
            result.folding = new LspFoldingResult();
            LspSession.CopyResult(result.folding, command, state);
            result.folding.regions = new List<CodeFoldRegion>();
        } else if (command.method == "textDocument/definition") {
            result.definition = new LspDefinitionResult();
            LspSession.CopyResult(result.definition, command, state);
        } else if (command.method == "textDocument/references") {
            result.references = new LspReferencesResult();
            LspSession.CopyResult(result.references, command, state);
            result.references.rows = new List<string>();
        } else if (command.method == "textDocument/rename") {
            result.rename = new LspRenameResult();
            LspSession.CopyResult(result.rename, command, state);
            result.rename.documents = command.documents;
        }
        return result;
    }

    // 接口数据协议与执行契约。
    void RunService(string root, LspReadyHandler completed) {
        LspSession connection = null;
        LspCommand activeCommand = null;
        bool readyPublished = false;
        try {
            connection = LspSession.Start(root, shutdownSource.Token);
            bool ready = connection != null;
            uiApp.Post(() => {
                if (stopping) { return; }
                alive = ready;
                if (ready && boundEditor != null) { boundEditor.ResetSemanticProviders(); }
                if (completed != null) { completed(this, ready); }
            }, "LspSession.Ready");
            readyPublished = true;
            while (connection != null && connection.alive && !shutdownSource.Token.IsCancellationRequested) {
                activeCommand = commands.DequeueFor(20);
                LspCommand command = activeCommand;
                if (shutdownSource.Token.IsCancellationRequested) { break; }
                if (command != null) {
                    if (command.method == "sync") { connection.SyncDoc(command.path, command.text); }
                    else {
                        LspWorkerResult result = null;
                        try {
                            result = connection.ExecuteCommand(command);
                        } catch (Exception e) {
                            // 接口数据协议与执行契约。
                            Console.WriteLine("LSP request failed: " + e.Message);
                            result = LspSession.EmptyWorkerResult(command, LspPendingState.Error);
                        }
                        PublishResult(command, result);
                    }
                }
                activeCommand = null;
                connection.Poll();
            }
        } catch (Exception e) {
            // 接口数据协议与执行契约。
            Console.WriteLine("LSP service failed: " + e.Message);
        } finally {
            commands.Complete();
            LspPendingState abandonedState = shutdownSource.Token.IsCancellationRequested
                ? LspPendingState.Cancelled : LspPendingState.Error;
            if (activeCommand != null && activeCommand.method != "sync") {
                PublishResult(activeCommand, LspSession.EmptyWorkerResult(activeCommand, abandonedState));
            }
            activeCommand = null;
            LspCommand abandoned = commands.TryDequeue();
            while (abandoned != null) {
                if (abandoned.method != "sync") {
                    PublishResult(abandoned, LspSession.EmptyWorkerResult(abandoned, abandonedState));
                }
                abandoned = commands.TryDequeue();
            }
            // 接口数据协议与执行契约。
            commands.Cancel();
            if (connection != null) {
                connection.serviceCancellation = null;
                connection.activeCancellation = null;
                connection.waitBudget = 4;
                try { connection.Shutdown(); } catch (Exception e) {
                    // 接口数据协议与执行契约。
                    Console.WriteLine("LSP shutdown failed: " + e.Message);
                    connection.Disconnect();
                }
            }
            connection = null;
            uiApp.Post(() => {
                if (stopping) { return; }
                alive = false;
                generation = generation + 1;
                CancelUiRequests(LspPendingState.Error);
                DetachEditor();
                if (!readyPublished && completed != null) { completed(this, false); }
            }, "LspSession.Exit");
        }
    }

    LspWorkerResult ExecuteCommand(LspCommand command) {
        if (command.cancellation != null && command.cancellation.IsCancellationRequested) {
            return LspSession.EmptyWorkerResult(command, LspPendingState.Cancelled);
        }
        activeCancellation = command.cancellation;
        LspWorkerResult result = LspSession.EmptyWorkerResult(command, LspPendingState.Pending);
        try {
            if (command.method == "textDocument/definition") {
                result.definition.target = Definition(command.path, command.line, command.col);
            } else if (command.method == "textDocument/references") {
                result.references.rows = References(command.path, command.line, command.col);
            } else if (command.method == "textDocument/rename") {
                result.rename.edits = Rename(command.path, command.line, command.col, command.name);
            } else if (command.method == "textDocument/foldingRange") {
                List<string> rows = FoldingRanges(command.path);
                for (int i = 0; i < rows.Count; i = i + 1) {
                    int sep = rows[i].IndexOf("\t");
                    if (sep <= 0) { continue; }
                    int start = Convert.ToInt32(rows[i].Substring(0, sep));
                    int end = Convert.ToInt32(rows[i].Substring(sep + 1));
                    if (start >= 0 && end > start) { result.folding.regions.Add(new CodeFoldRegion(start, end, false)); }
                }
            } else if (command.method == "textDocument/completion") {
                List<LspCompletionItem> items = Completion(command.path, command.line, command.col);
                List<string> lines = CodeEditor.SplitLines(command.text);
                string line = command.line >= 0 && command.line < lines.Count ? lines[command.line] : "";
                result.completions = LspSession.EditorCompletions(items, line, command.line, command.col);
            } else if (command.method == "textDocument/signatureHelp") {
                LspSignatureHelp signature = SignatureHelp(command.path, command.line, command.col);
                result.signatureLabel = LspSession.SignatureLabel(signature);
            } else if (command.method == "textDocument/hover") {
                result.hover = Hover(command.path, command.line, command.col);
            }
            result.state = lastRequestState;
            if (result.state == LspPendingState.Ready) {
                bool empty = (result.folding != null && result.folding.regions.Count == 0)
                    || (result.definition != null && result.definition.target == null)
                    || (result.references != null && result.references.rows.Count == 0)
                    || (result.rename != null && (result.rename.edits == null || result.rename.edits.Count == 0))
                    || (result.method == "textDocument/completion" && (result.completions == null || result.completions.Count == 0))
                    || (result.method == "textDocument/signatureHelp" && result.signatureLabel.Length == 0)
                    || (result.method == "textDocument/hover" && result.hover.Length == 0);
                if (empty) { result.state = LspPendingState.Empty; }
            }
            if (result.folding != null) { result.folding.state = result.state; }
            if (result.definition != null) { result.definition.state = result.state; }
            if (result.references != null) { result.references.state = result.state; }
            if (result.rename != null) { result.rename.state = result.state; }
            return result;
        } finally { activeCancellation = null; }
    }

    void PublishResult(LspCommand command, LspWorkerResult result) {
        LspFoldingHandler folding = command.folding;
        LspDefinitionHandler definition = command.definition;
        LspReferencesHandler references = command.references;
        LspRenameHandler rename = command.rename;
        // 接口数据协议与执行契约。
        command.folding = null; command.definition = null;
        command.references = null; command.rename = null;
        uiApp.Post(() => {
            if (stopping) { return; }
            bool current = IsCurrent(result.path, result.version, result.generation, result.documentGeneration);
            if (!current) {
                result.state = LspPendingState.Cancelled;
                if (result.folding != null) { result.folding.state = result.state; }
                if (result.definition != null) { result.definition.state = result.state; }
                if (result.references != null) { result.references.state = result.state; }
                if (result.rename != null) { result.rename.state = result.state; }
            }
            if (result.id > 0 && pending.ContainsKey(result.id)) {
                LspPendingRequest request = pending[result.id];
                pending.Remove(result.id);
                request.state = result.state;
                request.editorCompletions = result.completions;
                request.signatureLabel = result.signatureLabel;
                request.hover = result.hover;
                RefreshEditor(request);
                TrimTerminalCache();
            }
            if (folding != null) { folding(result.folding); }
            if (definition != null) { definition(result.definition); }
            if (references != null) { references(result.references); }
            if (rename != null) { rename(result.rename); }
        }, "LspSession.PublishResult");
    }

    void CancelUiRequests(LspPendingState state) {
        commandSource.Cancel();
        if (!stopping) { commandSource = new CancellationTokenSource(); }
        List<int> ids = pending.Keys;
        for (int i = 0; i < ids.Count; i = i + 1) {
            LspPendingRequest request = pending[ids[i]];
            request.state = state;
            if (request.cancellation != null) { request.cancellation.Cancel(); }
        }
        pending.Clear();
        cache.Clear();
    }

    // 接口数据协议与执行契约。
    static LspSession Start(string root, CancellationToken cancellation = null) {
        if (cancellation != null && cancellation.IsCancellationRequested) { return null; }
        string exe = ZanIDE.ToolchainDir() + "/zan-lsp" + ZanIDE.ExeSuffix();
        if (!File.Exists(exe)) { exe = ZanIDE.ExeDir() + "/zan-lsp" + ZanIDE.ExeSuffix(); }
        if (!File.Exists(exe)) { return null; }
        // 接口数据协议与执行契约。
        // 核心契约与语义定义。
        int portBase = 47411 + (Runtime.GetProcessId() % 89) * 4;
        for (int attempt = 0; attempt < 4; attempt = attempt + 1) {
            if (cancellation != null && cancellation.IsCancellationRequested) { return null; }
            int port = portBase + attempt;
            Process.RunDetached("\"" + exe + "\" --port " + Convert.ToString(port));
            LspSession s = LspSession.Open(port, root, cancellation);
            if (s != null) { return s; }
        }
        return null;
    }

    static LspSession Open(int port, string root, CancellationToken cancellation = null) {
        LspSession d = new LspSession();
        d.sock = 0 - 1;
        d.seq = 1;
        d.alive = false;
        d.rbuf = "";
        d.waitBudget = LspSession.RequestWaits();
        d.sendQueue = new List<LspSendFrame>();
        d.pending = new Dict<int, LspPendingRequest>();
        d.cache = new List<LspPendingRequest>();
        d.generation = 1;
        d.serviceCancellation = cancellation;
        d.nonBlocking = true;

        nint s = Socket.CreateTcp();
        if (s < 0) { return null; }
        d.sock = s;

        bool connected = false;
        #if WINDOWS
        // 接口数据协议与执行契约。
        if (Socket.SetNonBlocking(s) != 0) { Socket.Close(s); return null; }
        int tries = 0;
        while (tries < 25 && !connected && !d.OperationCancelled()) {
            int r = Socket.Connect(s, "127.0.0.1", port);
            // 核心契约与语义定义。
            if (r == 0 || Socket.LastSocketError() == 10056) { connected = true; }
            else { d.SnoozeMs(20); tries = tries + 1; }
        }
        // 接口数据协议与执行契约。
        #else
        if (Socket.SetNonBlocking(s) != 0) { Socket.Close(s); return null; }
        int tries = 0;
        while (tries < 100 && !connected && !d.OperationCancelled()) {
            int r = Socket.Connect(s, "127.0.0.1", port);
            #if MACOS
            if (r == 0 || Socket.LastSocketError() == 56) { connected = true; }
            #else
            if (r == 0 || Socket.LastSocketError() == 106) { connected = true; }
            #endif
            else { d.SnoozeMs(20); tries = tries + 1; }
        }
        #endif
        if (!connected) { Socket.Close(s); return null; }
        d.alive = true;

        // 接口数据协议与执行契约。
        d.waitBudget = 240;
        LspInitParams init = new LspInitParams();
        init.processId = JsonValue.NewNull();
        init.rootUri = LspSession.PathToUri(root);
        init.capabilities = JsonValue.NewObject();
        string m = d.RequestWait("initialize", Json.Serialize<LspInitParams>(init));
        if (m.Length == 0) {
            d.waitBudget = 4;
            if (d.OperationCancelled()) { d.Disconnect(); }
            else { d.Shutdown(); }
            return null;
        }
        d.waitBudget = LspSession.RequestWaits();
        if (Socket.SetNonBlocking(d.sock) != 0) { d.Disconnect(); return null; }
        d.nonBlocking = true;
        d.Notify("initialized", "{}");
        return d;
    }

    bool Alive() { return this.alive; }

    // 接口数据协议与执行契约。
    void Shutdown() {
        if (background) {
            if (stopping) { return; }
            stopping = true;
            alive = false;
            generation = generation + 1;
            CancelUiRequests(LspPendingState.Cancelled);
            DetachEditor();
            shutdownSource.Cancel();
            commands.Complete();
            return;
        }
        if (alive) {
            this.RequestWait("shutdown", "");
            this.Notify("exit", "");
            long deadline = Stopwatch.GetMilliseconds() + 1000;
            while (alive && nonBlocking && sendQueue.Count > 0 && Stopwatch.GetMilliseconds() < deadline) {
                FlushSendQueue();
                if (sendQueue.Count > 0) { SnoozeMs(2); }
            }
        }
        Disconnect();
    }

    // 接口数据协议与执行契约。
    async void ShutdownAsync() {
        if (!background) { Shutdown(); return; }
        int ignored = await serviceStopped.Task;
    }

    // 同一文档只打开一次，后续未保存修改走递增版本的全量 didChange。
    void SyncDoc(string path, string text) {
        if (background) {
            if (stopping || path.Length == 0) { return; }
            string key = DocumentUri(path);
            LspOpenDocument previous = documents.ContainsKey(key) ? documents[key] : null;
            if (previous != null && previous.text == text) { return; }
            LspOpenDocument snapshot = new LspOpenDocument();
            snapshot.path = path;
            snapshot.text = text;
            snapshot.version = previous != null ? previous.version + 1 : 1;
            documents[key] = snapshot;
            documentGeneration = documentGeneration + 1;
            CancelUiRequests(LspPendingState.Cancelled);
            if (boundEditor != null) {
                if (LspSession.SameDocumentPath(boundEditor.documentPath, path)) { boundEditor.ClearSemanticTextMemos(); }
                else { boundEditor.ResetSemanticProviders(); }
            }
            LspCommand command = CreateCommand("sync", path, 0, 0);
            // 接口数据协议与执行契约。
            commands.Enqueue(command);
            return;
        }
        if (!this.alive || path.Length == 0) { return; }
        if (documents == null) { documents = new Dict<string, LspOpenDocument>(); }
        string uri = this.DocumentUri(path);
        LspOpenDocument doc = null;
        if (documents.ContainsKey(uri)) { doc = documents[uri]; }
        if (doc != null && doc.text == text) { return; }
        if (doc == null) {
            doc = new LspOpenDocument();
            doc.version = 1;
            LspDidOpenParams p = new LspDidOpenParams();
            p.textDocument = new LspTextDocumentItem();
            p.textDocument.uri = uri;
            p.textDocument.languageId = "zan";
            p.textDocument.version = doc.version;
            p.textDocument.text = text;
            this.Notify("textDocument/didOpen", Json.Serialize<LspDidOpenParams>(p));
        } else {
            doc.version = doc.version + 1;
            LspDidChangeParams p = new LspDidChangeParams();
            p.textDocument = new LspVersionedDocument();
            p.textDocument.uri = uri;
            p.textDocument.version = doc.version;
            p.contentChanges = new List<LspContentChange>();
            LspContentChange change = new LspContentChange();
            change.text = text;
            p.contentChanges.Add(change);
            this.Notify("textDocument/didChange", Json.Serialize<LspDidChangeParams>(p));
        }
        doc.path = path;
        doc.text = text;
        doc.lines = CodeEditor.SplitLines(text);
        documents[uri] = doc;
        documentGeneration = documentGeneration + 1;
        if (cache != null) { cache.Clear(); }
        if (boundEditor != null) {
            if (LspSession.SameDocumentPath(boundEditor.documentPath, path)) {
                boundEditor.ClearSemanticTextMemos();
            } else { boundEditor.ResetSemanticProviders(); }
        }
    }

    string DocumentUri(string path) {
        if (background) {
            string key = path.Replace("\\", "/");
            #if WINDOWS
            key = key.ToLower();
            #endif
            return key;
        }
        string uri = LspSession.PathToUri(path);
        if (documents == null || documents.ContainsKey(uri)) { return uri; }
        List<string> keys = documents.Keys;
        for (int i = 0; i < keys.Count; i = i + 1) {
            if (LspSession.SameDocumentPath(LspSession.UriToPath(keys[i]), path)) { return keys[i]; }
        }
        return uri;
    }

    int DocVersion(string path) {
        string uri = this.DocumentUri(path);
        if (documents == null || !documents.ContainsKey(uri)) { return 0; }
        return documents[uri].version;
    }

    bool DocTextMatches(string path, string text) {
        string uri = this.DocumentUri(path);
        return documents == null || !documents.ContainsKey(uri) || documents[uri].text == text;
    }

    LspPosition DocPosObj(string path, int line0, int byteCol) {
        string uri = this.DocumentUri(path);
        if (documents != null && documents.ContainsKey(uri)) {
            LspOpenDocument doc = documents[uri];
            if (line0 >= 0 && line0 < doc.lines.Count) {
                return LspSession.PosObj(line0, CodeEditor.ByteColumnToUtf16(doc.lines[line0], byteCol));
            }
        }
        return LspSession.PosObj(line0, byteCol);
    }

    LspTextDocumentIdentifier DocUriObj(string path) {
        LspTextDocumentIdentifier document = new LspTextDocumentIdentifier();
        document.uri = this.DocumentUri(path);
        return document;
    }

    string DocPosParams(string path, int line0, int byteCol) {
        LspDocPosParams p = new LspDocPosParams();
        p.textDocument = this.DocUriObj(path);
        p.position = this.DocPosObj(path, line0, byteCol);
        return Json.Serialize<LspDocPosParams>(p);
    }

    // Semantic go-to-definition. null 表示无目标、失败或文档已变更。
    LspDefinitionTarget Definition(string path, int line0, int col0) {
        if (background) { throw new Exception("Use DefinitionAsync on the UI LSP facade."); }
        int version = this.DocVersion(path);
        int generation = documentGeneration;
        string m = this.RequestWait("textDocument/definition",
            this.DocPosParams(path, line0, col0));
        if (m.Length == 0 || this.DocVersion(path) != version
            || documentGeneration != generation) { return null; }
        return LspSession.ParseDefinition(m);
    }

    static LspPosition ParsePosition(JsonValue value) {
        if (value == null || !value.IsObject()) { return null; }
        JsonValue lineValue = value.Get("line");
        JsonValue characterValue = value.Get("character");
        if (lineValue == null || characterValue == null || !lineValue.IsInt() || !characterValue.IsInt()) { return null; }
        int line = lineValue.AsInt(-1);
        int character = characterValue.AsInt(-1);
        if (line < 0 || character < 0) { return null; }
        return LspSession.PosObj(line, character);
    }

    static LspDefinitionTarget ParseDefinitionLocation(JsonValue value) {
        if (value == null || !value.IsObject()) { return null; }
        string uri = value.Str("uri", "");
        JsonValue range = value.Get("range");
        if (uri.Length == 0) {
            uri = value.Str("targetUri", "");
            range = value.Get("targetSelectionRange");
            if (range == null) { range = value.Get("targetRange"); }
        }
        if (uri.Length == 0 || range == null || !range.IsObject()) { return null; }
        LspPosition start = LspSession.ParsePosition(range.Get("start"));
        LspPosition end = LspSession.ParsePosition(range.Get("end"));
        if (start == null || end == null || end.line < start.line
            || (end.line == start.line && end.character < start.character)) { return null; }
        LspDefinitionTarget target = new LspDefinitionTarget();
        target.path = LspSession.UriToPath(uri);
        if (target.path.Length == 0) { return null; }
        target.line = start.line;
        target.column = start.character;
        return target;
    }

    static JsonValue ParseResponse(string message) {
        JsonValue root = null;
        // 协议解析的错误值契约：坏响应返回 null，调用方拒绝导航或编辑。
        try { root = JsonValue.ParseLenient(message); } catch (Exception) { return null; }
        if (root == null || !root.IsObject() || root.Has("error")) { return null; }
        return root;
    }

    // 接受单个 Location、Location[] 与 LocationLink[]，优先使用目标选择范围。
    static LspDefinitionTarget ParseDefinition(string message) {
        JsonValue root = LspSession.ParseResponse(message);
        if (root == null) { return null; }
        JsonValue result = root.Get("result");
        if (result == null || result.IsNull()) { return null; }
        if (!result.IsArray()) { return LspSession.ParseDefinitionLocation(result); }
        for (int i = 0; i < result.Count(); i = i + 1) {
            LspDefinitionTarget target = LspSession.ParseDefinitionLocation(result.At(i));
            if (target != null) { return target; }
        }
        return null;
    }

    // 接口数据协议与执行契约。
    List<string> References(string path, int line0, int col0) {
        if (background) { throw new Exception("Use ReferencesAsync on the UI LSP facade."); }
        List<string> outp = new List<string>();
        LspReferenceParams p = new LspReferenceParams();
        p.textDocument = this.DocUriObj(path);
        p.position = this.DocPosObj(path, line0, col0);
        p.context = new LspReferenceContext();
        p.context.includeDeclaration = true;
        string m = this.RequestWait("textDocument/references",
            Json.Serialize<LspReferenceParams>(p));
        if (m.Length == 0) { return outp; }
        LspLocationsResult r = Json.Deserialize<LspLocationsResult>(m);
        if (r == null || r.result == null) { return outp; }
        for (int i = 0; i < r.result.Count; i = i + 1) {
            if (r.result[i].uri.Length == 0) { continue; }
            int ln = 0;
            if (r.result[i].range != null) {
                JsonValue start = r.result[i].range.Get("start");
                if (start != null) { ln = start.Int("line", 0); }
            }
            outp.Add(LspSession.UriToPath(r.result[i].uri) + "\t"
                + Convert.ToString(ln));
        }
        return outp;
    }

    // Semantic rename. null 表示失败/过期；空列表表示服务端未给出编辑。
    List<LspRenameEdit> Rename(string path, int line0, int col0, string newName) {
        if (background) { throw new Exception("Use RenameAsync on the UI LSP facade."); }
        int version = this.DocVersion(path);
        int generation = documentGeneration;
        LspRenameParams p = new LspRenameParams();
        p.textDocument = this.DocUriObj(path);
        p.position = this.DocPosObj(path, line0, col0);
        p.newName = newName;
        string m = this.RequestWait("textDocument/rename",
            Json.Serialize<LspRenameParams>(p));
        if (m.Length == 0 || this.DocVersion(path) != version
            || documentGeneration != generation) { return null; }
        List<LspRenameEdit> edits = LspSession.ParseWorkspaceEdit(m);
        if (edits == null) { return null; }
        for (int i = 0; i < edits.Count; i = i + 1) {
            if (edits[i].version >= 0 && this.DocVersion(edits[i].path) != edits[i].version) { return null; }
        }
        return edits;
    }

    static bool AppendRenameEdits(List<LspRenameEdit> output, string uri, JsonValue edits, int version) {
        if (uri.Length == 0 || edits == null || !edits.IsArray()) { return false; }
        string path = LspSession.UriToPath(uri);
        if (path.Length == 0) { return false; }
        for (int i = 0; i < edits.Count(); i = i + 1) {
            JsonValue edit = edits.At(i);
            if (edit == null || !edit.IsObject()) { return false; }
            JsonValue range = edit.Get("range");
            JsonValue newText = edit.Get("newText");
            if (range == null || !range.IsObject() || newText == null || !newText.IsString()) { return false; }
            LspPosition start = LspSession.ParsePosition(range.Get("start"));
            LspPosition end = LspSession.ParsePosition(range.Get("end"));
            if (start == null || end == null || end.line < start.line
                || (end.line == start.line && end.character < start.character)) { return false; }
            LspRenameEdit item = new LspRenameEdit();
            item.path = path; item.start = start; item.end = end;
            item.newText = newText.AsString(""); item.version = version;
            output.Add(item);
        }
        return true;
    }

    // 树解析：changes 里文件 URI 是对象 key（不是 "uri" 字段），逐 key
    // 取出 edits 数组读 range.start/end；不再按引号子串扫描文本。
    // 不支持的资源操作或任何坏编辑使整批失败，禁止应用部分重命名。
    static List<LspRenameEdit> ParseWorkspaceEdit(string m) {
        List<LspRenameEdit> output = new List<LspRenameEdit>();
        JsonValue root = LspSession.ParseResponse(m);
        if (root == null) { return null; }
        JsonValue result = root.Get("result");
        if (result == null) { return null; }
        if (result.IsNull()) { return output; }
        if (!result.IsObject()) { return null; }
        JsonValue changes = result.Get("changes");
        JsonValue documentChanges = result.Get("documentChanges");
        if (changes != null && documentChanges != null) { return null; }
        if (changes != null) {
            if (!changes.IsObject()) { return null; }
            for (int f = 0; f < changes.Count(); f = f + 1) {
                if (!LspSession.AppendRenameEdits(output, changes.KeyAt(f), changes.ValAt(f), -1)) { return null; }
            }
        } else if (documentChanges != null) {
            if (!documentChanges.IsArray()) { return null; }
            for (int f = 0; f < documentChanges.Count(); f = f + 1) {
                JsonValue entry = documentChanges.At(f);
                if (entry == null || !entry.IsObject() || entry.Has("kind")) { return null; }
                JsonValue document = entry.Get("textDocument");
                if (document == null || !document.IsObject()) { return null; }
                JsonValue versionValue = document.Get("version");
                int version = -1;
                if (versionValue != null && !versionValue.IsNull()) {
                    if (!versionValue.IsInt()) { return null; }
                    version = versionValue.AsInt(-1);
                    if (version < 0) { return null; }
                }
                if (!LspSession.AppendRenameEdits(output, document.Str("uri", ""), entry.Get("edits"), version)) { return null; }
            }
        }
        return output;
    }

    // 保留原文换行；返回 -1 表示越界或 UTF-16 列切在代理对中间。
    static int PositionOffset(string text, LspPosition position) {
        if (position == null || position.line < 0 || position.character < 0) { return -1; }
        int start = 0;
        for (int line = 0; line < position.line; line = line + 1) {
            int next = text.IndexOf("\n", start);
            if (next < 0) { return -1; }
            start = next + 1;
        }
        int end = text.IndexOf("\n", start);
        if (end < 0) { end = text.Length; }
        if (end > start && (text[end - 1] & 255) == 13) { end = end - 1; }
        string source = text.Substring(start, end - start);
        int col = CodeEditor.Utf16ColumnToByte(source, position.character);
        if (CodeEditor.ByteColumnToUtf16(source, col) != position.character) { return -1; }
        return start + col;
    }

    // 全部偏移基于同一原文，排序后倒序应用；重叠/越界使整份文本失败。
    static LspEditApplication ApplyTextEdits(string text, List<LspRenameEdit> edits, string path) {
        LspEditApplication result = new LspEditApplication();
        result.text = text;
        if (edits == null) { return result; }
        List<LspEditSpan> spans = new List<LspEditSpan>();
        for (int i = 0; i < edits.Count; i = i + 1) {
            LspRenameEdit edit = edits[i];
            if (edit == null) { return result; }
            if (!LspSession.SameDocumentPath(edit.path, path)) { continue; }
            int start = LspSession.PositionOffset(text, edit.start);
            int end = LspSession.PositionOffset(text, edit.end);
            if (start < 0 || end < start) { return result; }
            LspEditSpan span = new LspEditSpan();
            span.start = start; span.end = end; span.newText = edit.newText;
            int at = 0;
            while (at < spans.Count && (spans[at].start > start
                || (spans[at].start == start && spans[at].end > end))) { at = at + 1; }
            spans.Insert(at, span);
        }
        for (int i = 1; i < spans.Count; i = i + 1) {
            if (spans[i].end > spans[i - 1].start) { return result; }
        }
        string output = text;
        for (int i = 0; i < spans.Count; i = i + 1) {
            LspEditSpan span = spans[i];
            output = output.Substring(0, span.start) + span.newText
                + output.Substring(span.end, output.Length - span.end);
        }
        result.valid = true;
        result.text = output;
        return result;
    }

    static bool SameDocumentPath(string left, string right) {
        left = left.Replace("\\", "/");
        right = right.Replace("\\", "/");
        #if WINDOWS
        left = left.ToLower(); right = right.ToLower();
        #endif
        return left == right;
    }

    // 接口数据协议与执行契约。
    string Hover(string path, int line0, int col0) {
        if (background) { throw new Exception("UI hover must use the bound provider."); }
        int version = this.DocVersion(path);
        string m = this.RequestWait("textDocument/hover",
            this.DocPosParams(path, line0, col0));
        if (m.Length == 0 || this.DocVersion(path) != version) { return ""; }
        LspHoverResult r = Json.Deserialize<LspHoverResult>(m);
        if (r == null || r.result == null) { return ""; }
        JsonValue contents = r.result.Get("contents");
        if (contents == null) { return ""; }
        return LspSession.MarkupText(contents);
    }

    // 接口数据协议与执行契约。
    List<LspCompletionItem> Completion(string path, int line0, int col0) {
        if (background) { throw new Exception("UI completion must use the bound provider."); }
        List<LspCompletionItem> empty = new List<LspCompletionItem>();
        int version = this.DocVersion(path);
        string m = this.RequestWait("textDocument/completion",
            this.DocPosParams(path, line0, col0));
        if (m.Length == 0 || this.DocVersion(path) != version) { return empty; }
        JsonValue root = JsonValue.ParseLenient(m);
        JsonValue result = root != null ? root.Get("result") : null;
        if (result == null) { return empty; }
        if (result.IsObject()) { result = result.Get("items"); }
        if (result == null || !result.IsArray()) { return empty; }
        for (int i = 0; i < result.Count(); i = i + 1) {
            LspCompletionItem item = Json.Deserialize<LspCompletionItem>(result.At(i).ToJson());
            if (item != null) { empty.Add(item); }
        }
        return empty;
    }

    // 接口数据协议与执行契约。
    LspSignatureHelp SignatureHelp(string path, int line0, int col0) {
        if (background) { throw new Exception("UI signature help must use the bound provider."); }
        int version = this.DocVersion(path);
        string m = this.RequestWait("textDocument/signatureHelp",
            this.DocPosParams(path, line0, col0));
        if (m.Length == 0 || this.DocVersion(path) != version) { return null; }
        LspSignatureHelpResult r = Json.Deserialize<LspSignatureHelpResult>(m);
        if (r == null || r.result == null) { return null; }
        return r.result;
    }

    // 接口数据协议与执行契约。
    List<string> FoldingRanges(string path) {
        if (background) { throw new Exception("Use RequestFoldingRanges on the UI LSP facade."); }
        List<string> outp = new List<string>();
        LspDocParams p = new LspDocParams();
        p.textDocument = this.DocUriObj(path);
        string m = this.RequestWait("textDocument/foldingRange",
            Json.Serialize<LspDocParams>(p));
        if (m.Length == 0) { return outp; }
        JsonValue root = null;
        try { root = JsonValue.ParseLenient(m); } catch (Exception) { root = null; }
        JsonValue arr = root != null ? root.Get("result") : null;
        if (arr == null || !arr.IsArray()) { return outp; }
        for (int i = 0; i < arr.Count(); i = i + 1) {
            JsonValue fr = arr.At(i);
            if (fr == null) { continue; }
            outp.Add(Convert.ToString(fr.Int("startLine", 0)) + "\t"
                + Convert.ToString(fr.Int("endLine", 0)));
        }
        return outp;
    }

    static string PosParams(string path, int line0, int col0) {
        LspDocPosParams p = new LspDocPosParams();
        p.textDocument = LspSession.UriObj(path);
        p.position = LspSession.PosObj(line0, col0);
        return Json.Serialize<LspDocPosParams>(p);
    }

    // 接口数据协议与执行契约。
    static LspTextDocumentIdentifier UriObj(string path) {
        LspTextDocumentIdentifier o = new LspTextDocumentIdentifier();
        o.uri = LspSession.PathToUri(path);
        return o;
    }

    // 核心契约与语义定义。
    static LspPosition PosObj(int line0, int col0) {
        LspPosition o = new LspPosition();
        o.line = line0;
        o.character = col0;
        return o;
    }

    // 接口数据协议与执行契约。
    static string PathToUri(string path) {
        string p = "";
        for (int i = 0; i < path.Length; i = i + 1) {
            string ch = path.Substring(i, 1);
            if (ch == "\\") { p = p + "/"; } else { p = p + ch; }
        }
        // URL 编码器按表单编码空格；文件 URI 保留路径分隔符并使用 %20。
        p = Encoding.UrlEncode(p).Replace("+", "%20").Replace("%2f", "/").Replace("%3a", ":");
        if (p.StartsWith("//")) { return "file:" + p; }
        if (p.StartsWith("/")) { return "file://" + p; }
        return "file:///" + p;
    }

    static string UriToPath(string uri) {
        if (!uri.StartsWith("file://")) { return ""; }
        string p = uri.Substring(7);
        if (p.StartsWith("localhost/")) { p = p.Substring(9); }
        else if (!p.StartsWith("/")) { p = "//" + p; }
        // 接口数据协议与执行契约。
        // 文件路径里的 '+' 是字面量，不能按表单解码为空格。
        p = Encoding.UrlDecode(p.Replace("+", "%2b"));
        if (p.Length >= 3 && (p[0] & 255) == 47 && (p[2] & 255) == 58
            && (((p[1] & 255) >= 65 && (p[1] & 255) <= 90)
                || ((p[1] & 255) >= 97 && (p[1] & 255) <= 122))) { p = p.Substring(1); }
        return p;
    }

    // ---- transport ----

    void SnoozeMs(int ms) {
        #if WINDOWS
        plat_sleep(ms);
        #else
        plat_usleep(ms * 1000);
        #endif
    }

    static int RecvTimeoutMs() { return 250; }
    static int RequestWaits() { return 60; }
    static int PollIoBudget() { return 8; }
    static int PollFrameBudget() { return 16; }
    static int MaxFrameBytes() { return 16777216; }
    static int MaxQueuedBytes() { return 33554432; }
    static int SendStallMs() { return LspSession.RequestWaits() * LspSession.RecvTimeoutMs(); }

    void Disconnect() {
        if (sock >= 0) { Socket.Close(sock); sock = -1; }
        alive = false;
        generation = generation + 1;
        rbuf = "";
        if (sendQueue != null) { sendQueue.Clear(); }
        queuedBytes = 0;
        if (boundEditor != null) { boundEditor.ResetSemanticProviders(); }
        if (pending != null) {
            List<int> ids = pending.Keys;
            for (int i = 0; i < ids.Count; i = i + 1) {
                pending[ids[i]].state = LspPendingState.Error;
            }
            pending.Clear();
        }
        if (cache != null) { cache.Clear(); }
    }

    static bool RetrySocket() {
        // Send/Recv 的 raw API 不缓存错误；必须紧跟失败点捕获。
        Socket.CaptureLastError();
        int error = Socket.LastSocketError();
        #if WINDOWS
        return error == 10035 || error == 10004;
        #else
        return error == 11 || error == 35 || error == 4;
        #endif
    }

    void SendMsg(string body, int requestId = 0) {
        if (!alive) { return; }
        string data = "Content-Length: " + Convert.ToString(body.Length) + "\r\n\r\n" + body;
        if (!nonBlocking) {
            // 只有 initialize 握手允许同步传输；日常请求只保存 frame。
            int offset = 0;
            while (offset < data.Length) {
                int n = Socket.Send(sock, data.Substring(offset), data.Length - offset);
                if (n <= 0) { Disconnect(); return; }
                offset = offset + n;
            }
            return;
        }
        if (data.Length > LspSession.MaxQueuedBytes() - queuedBytes) { Disconnect(); return; }
        if (sendQueue.Count == 0) { sendProgressMs = Stopwatch.GetMilliseconds(); }
        LspSendFrame frame = new LspSendFrame();
        frame.data = data;
        frame.offset = 0;
        frame.requestId = requestId;
        sendQueue.Add(frame);
        queuedBytes = queuedBytes + data.Length;
    }

    bool DropUnsentRequest(int requestId) {
        for (int i = 0; i < sendQueue.Count; i = i + 1) {
            LspSendFrame frame = sendQueue[i];
            if (frame.requestId == requestId && frame.offset == 0) {
                queuedBytes = queuedBytes - frame.data.Length;
                sendQueue.RemoveAt(i);
                return true;
            }
        }
        return false;
    }

    void FlushSendQueue() {
        if (sendQueue.Count > 0 && Stopwatch.GetMilliseconds() - sendProgressMs >= LspSession.SendStallMs()) {
            Disconnect(); return;
        }
        for (int i = 0; alive && sendQueue.Count > 0 && i < LspSession.PollIoBudget(); i = i + 1) {
            bool writable = Socket.IsWritable(sock);
                        if (!writable) { return; }
            LspSendFrame frame = sendQueue[0];
            int remaining = frame.data.Length - frame.offset;
            int count = remaining < 65536 ? remaining : 65536;
                        int n = Socket.Send(sock, frame.data.Substring(frame.offset, count), count);
            if (n < 0 && LspSession.RetrySocket()) { return; }
            if (n <= 0) { Disconnect(); return; }
            frame.offset = frame.offset + n;
            queuedBytes = queuedBytes - n;
            sendProgressMs = Stopwatch.GetMilliseconds();
            if (frame.offset == frame.data.Length) {
                sendQueue.RemoveAt(0);
            }
        }
    }

    void Notify(string method, string paramsJson) {
        LspNotification o = new LspNotification();
        o.jsonrpc = "2.0";
        o.method = method;
        if (paramsJson.Length > 0) { o.params = JsonValue.ParseLenient(paramsJson); }
        this.SendMsg(Json.Serialize<LspNotification>(o));
    }

    LspPendingRequest NewRequest(string method) {
        LspPendingRequest request = new LspPendingRequest();
        request.id = seq;
        seq = seq + 1;
        request.method = method;
        request.generation = generation;
        request.state = LspPendingState.Pending;
        request.message = "";
        request.hover = "";
        request.deadline = Stopwatch.GetMilliseconds() + waitBudget * LspSession.RecvTimeoutMs();
        pending[request.id] = request;
        return request;
    }

    void SendRequest(LspPendingRequest request, string paramsJson) {
        LspRequest envelope = new LspRequest();
        envelope.jsonrpc = "2.0";
        envelope.id = request.id;
        envelope.method = request.method;
        if (paramsJson.Length > 0) { envelope.params = JsonValue.ParseLenient(paramsJson); }
        this.SendMsg(Json.Serialize<LspRequest>(envelope), request.id);
    }

    // 显式导航等待也分发所有 ID，不会吞掉在途的日常提示响应。
    string RequestWait(string method, string paramsJson) {
        if (background) { throw new Exception("Synchronous LSP requests are worker-only."); }
        lastRequestState = LspPendingState.Error;
        if (!alive) { return ""; }
        LspPendingRequest request = NewRequest(method);
        SendRequest(request, paramsJson);
        WaitRequest(request);
        lastRequestState = request.state;
        return request.state == LspPendingState.Ready ? request.message : "";
    }

    bool OperationCancelled() {
        return (serviceCancellation != null && serviceCancellation.IsCancellationRequested)
            || (activeCancellation != null && activeCancellation.IsCancellationRequested);
    }

    void WaitRequest(LspPendingRequest request) {
        if (background) { throw new Exception("LSP waits are worker-only."); }
        if (!alive || request == null) { return; }
        while (alive && request.state == LspPendingState.Pending) {
            if (OperationCancelled()) {
                request.state = LspPendingState.Cancelled;
                pending.Remove(request.id);
                if (!DropUnsentRequest(request.id)) {
                    JsonValue cancellation = JsonValue.NewObject();
                    cancellation.PutInt("id", request.id);
                    Notify("$/cancelRequest", cancellation.ToJson());
                }
                return;
            }
            Poll();
            if (request.state == LspPendingState.Pending) { SnoozeMs(2); }
        }
    }

    // 只取完整 frame；分片头、分片 body 和后续 frame 一律留在 rbuf。
    string TakeFrame() {
        int headerEnd = rbuf.IndexOf("\r\n\r\n");
        if (headerEnd < 0) {
            if (rbuf.Length > 8192) { Disconnect(); }
            return "";
        }
        if (headerEnd > 8192) { Disconnect(); return ""; }
        int length = DebugSession.HeaderLen(rbuf.Substring(0, headerEnd));
        if (length <= 0 || length > LspSession.MaxFrameBytes()) { Disconnect(); return ""; }
        int start = headerEnd + 4;
        if (rbuf.Length - start < length) { return ""; }
        string message = rbuf.Substring(start, length);
        rbuf = rbuf.Substring(start + length);
        return message;
    }

    void DispatchResponse(string message) {
        JsonValue root = null;
        try { root = JsonValue.ParseLenient(message); } catch (Exception) { return; }
        if (root == null || !root.IsObject()) { return; }
        JsonValue id = root.Get("id");
                if (id == null || !id.IsInt() || !pending.ContainsKey(id.AsInt(-1))) { return; }
        LspPendingRequest request = pending[id.AsInt(-1)];
        pending.Remove(request.id);
        if (Stopwatch.GetMilliseconds() >= request.deadline) {
            request.state = LspPendingState.Timeout;
            return;
        }
        if (root.Has("error") || !root.Has("result")) {
            request.state = LspPendingState.Error;
            return;
        }
        request.state = LspPendingState.Ready;
        if (request.editor == null) { request.message = message; return; }
        JsonValue result = root.Get("result");
        if (request.method == "textDocument/completion") {
            request.completions = new List<LspCompletionItem>();
            if (result != null && result.IsObject()) { result = result.Get("items"); }
            if (result != null && result.IsArray()) {
                for (int i = 0; i < result.Count(); i = i + 1) {
                    LspCompletionItem item = Json.Deserialize<LspCompletionItem>(result.At(i).ToJson());
                    if (item != null) { request.completions.Add(item); }
                }
            }
            List<string> lines = CodeEditor.SplitLines(request.text);
            string sourceLine = request.line >= 0 && request.line < lines.Count ? lines[request.line] : "";
            request.editorCompletions = LspSession.EditorCompletions(request.completions, sourceLine, request.line, request.col);
            if (request.editorCompletions == null || request.editorCompletions.Count == 0) { request.state = LspPendingState.Empty; }
        } else if (request.method == "textDocument/signatureHelp") {
            if (result != null && result.IsObject()) {
                request.signature = Json.Deserialize<LspSignatureHelp>(result.ToJson());
            }
            request.signatureLabel = LspSession.SignatureLabel(request.signature);
            if (request.signatureLabel.Length == 0) { request.state = LspPendingState.Empty; }
        } else if (request.method == "textDocument/hover") {
            if (result != null && result.IsObject()) { request.hover = LspSession.MarkupText(result.Get("contents")); }
            if (request.hover.Length == 0) { request.state = LspPendingState.Empty; }
        }
        RefreshEditor(request);
    }

    // 接口数据协议与执行契约。
    void Poll() {
        if (background || !alive || polling) { return; }
        polling = true;
        CancelStaleEditorRequests();
        if (nonBlocking) { FlushSendQueue(); }
        int frames = 0;
        int reads = 0;
        while (alive && frames < LspSession.PollFrameBudget()) {
            string message = TakeFrame();
            if (message.Length > 0) {
                frames = frames + 1;
                try { DispatchResponse(message); } catch (Exception) { }
                continue;
            }
            bool readable = Socket.IsReadable(sock);
            if (!readable) {
                                break;
            }
            if (!alive || reads >= LspSession.PollIoBudget()) { break; }
            reads = reads + 1;
            byte[] buffer = new byte[65536];
            int n = Socket.Recv(sock, buffer, buffer.Length);
                        if (n < 0 && LspSession.RetrySocket()) { break; }
            if (n <= 0) { Disconnect(); break; }
            rbuf = rbuf + buffer.ToStr(0, n);
        }
        long now = Stopwatch.GetMilliseconds();
        List<int> ids = pending.Keys;
        for (int i = ids.Count - 1; i >= 0; i = i - 1) {
            LspPendingRequest request = pending[ids[i]];
            if (now >= request.deadline) {
                request.state = LspPendingState.Timeout;
                pending.Remove(request.id);
                DropUnsentRequest(request.id);
            }
        }
        TrimTerminalCache();
        polling = false;
    }

    void TrimTerminalCache() {
        int terminalCount = 0;
        for (int i = 0; i < cache.Count; i = i + 1) {
            if (cache[i].state != LspPendingState.Pending) { terminalCount = terminalCount + 1; }
        }
        // 保留最近 64 个终态抑制重复查询，pending 不能因缓存上限被移除。
        int index = 0;
        while (terminalCount > 64 && index < cache.Count) {
            if (cache[index].state == LspPendingState.Pending) { index = index + 1; }
            else { cache.RemoveAt(index); terminalCount = terminalCount - 1; }
        }
    }

    void CancelStaleEditorRequests() {
        List<int> ids = pending.Keys;
        for (int i = ids.Count - 1; i >= 0; i = i - 1) {
            LspPendingRequest request = pending[ids[i]];
            CodeEditor editor = request.editor;
            if (editor == null) { continue; }
            bool keep = (editor == boundEditor && request.generation == generation
                && request.documentGeneration == documentGeneration && DocVersion(request.path) == request.version
                && editor.documentPath == request.path && editor.TextStamp() == request.stamp
                && editor.CurLine() == request.caretLine && editor.CurCol() == request.caretCol
                && editor.GetText() == request.text
                && (request.method != "textDocument/completion"
                    || editor.SemanticCompletionToken() == request.completionToken));

            if (keep) { continue; }
            request.state = LspPendingState.Cancelled;
            pending.Remove(request.id);
            cache.Remove(request);
            editor.ClearSemanticTextMemo(request.method, request.path, request.stamp,
                request.line, request.col, request.name);
            if (background) {
                if (request.cancellation != null) { request.cancellation.Cancel(); }
            } else if (!DropUnsentRequest(request.id)) {
                JsonValue cancellation = JsonValue.NewObject();
                cancellation.PutInt("id", request.id);
                Notify("$/cancelRequest", cancellation.ToJson());
            }
        }
    }

    bool HasPendingWork() {
        if (background || !alive) { return false; }
        if (sendQueue.Count > 0 || pending.Count > 0) { return true; }
        // 完整缓冲响应需要下一拍；无人等待的半包不能造成永久唤醒。
        int headerEnd = rbuf.IndexOf("\r\n\r\n");
        if (headerEnd < 0) { return false; }
        int length = DebugSession.HeaderLen(rbuf.Substring(0, headerEnd));
        return length <= 0 || rbuf.Length - headerEnd - 4 >= length;
    }

    bool ConsumeEditorRefresh() {
        bool changed = editorRefreshNeeded;
        editorRefreshNeeded = false;
        return changed;
    }

    LspPendingRequest CachedRequest(CodeEditor editor, string method, string path,
        int line, int col, string name) {
        if (!alive || stopping || editor != boundEditor || path != editor.documentPath
            || line < 0 || line >= editor.LineCount() || col < 0 || col > editor.LineAt(line).Length) { return null; }
        string text = editor.GetText();
        SyncDoc(path, text);
        CancelStaleEditorRequests();
        int version = DocVersion(path);
        LspPendingRequest request = null;
        for (int i = 0; i < cache.Count; i = i + 1) {
            LspPendingRequest candidate = cache[i];
            if (candidate.method == method && candidate.path == path && candidate.line == line
                && candidate.col == col && candidate.name == name && candidate.version == version
                && candidate.generation == generation && candidate.documentGeneration == documentGeneration) {
                request = candidate;
                break;
            }
        }
        bool created = request == null;
        if (created) {
            request = NewRequest(method);
            request.path = path;
            request.name = name;
            request.line = line;
            request.col = col;
            request.version = version;
            request.documentGeneration = documentGeneration;
            cache.Add(request);
        }
        request.editor = editor;
        request.text = text;
        request.stamp = editor.TextStamp();
        request.caretLine = editor.CurLine();
        request.caretCol = editor.CurCol();
        request.completionToken = editor.SemanticCompletionToken();
        if (created) {
            if (background) {
                request.cancellation = new CancellationTokenSource();
                LspCommand command = CreateCommand(method, path, line, col);
                command.id = request.id;
                command.name = name;
                command.stamp = request.stamp;
                command.cancellation = request.cancellation.Token;
                QueueCommand(command);
            } else { SendRequest(request, DocPosParams(path, line, col)); }
        }
        // 接口数据协议与执行契约。
        return request.state == LspPendingState.Ready ? request : null;
    }

    void RefreshEditor(LspPendingRequest request) {
        CodeEditor editor = request.editor;
        if (editor == null || editor != boundEditor || request.generation != generation
            || request.documentGeneration != documentGeneration || DocVersion(request.path) != request.version
            || editor.documentPath != request.path || editor.TextStamp() != request.stamp
            || editor.CurLine() != request.caretLine || editor.CurCol() != request.caretCol
            || editor.GetText() != request.text) { return; }
        if (editor.RefreshSemanticResult(request.method, request.path, request.stamp,
            request.line, request.col, request.name, request.completionToken)) {
            editorRefreshNeeded = true;
        }
    }

    static string MarkupText(JsonValue value) {
        if (value == null) { return ""; }
        if (value.IsString()) { return value.AsString(""); }
        if (value.IsArray()) {
            List<string> parts = new List<string>();
            for (int i = 0; i < value.Count(); i = i + 1) {
                parts.Add(LspSession.MarkupText(value.At(i)));
            }
            return string.Join("\n", parts);
        }
        return value.Str("value", "");
    }

    // 接口数据协议与执行契约。
    static List<CodeCompletionItem> EditorCompletions(List<LspCompletionItem> items, string sourceLine, int line0, int col0) {
        if (items == null || items.Count == 0) { return null; }
        List<CodeCompletionItem> res = new List<CodeCompletionItem>();
        for (int i = 0; i < items.Count; i = i + 1) {
            string k = "M";
            if (items[i].kind == 7) { k = "C"; }
            else if (items[i].kind == 5) { k = "F"; }
            else if (items[i].kind == 10) { k = "P"; }
            else if (items[i].kind == 14) { k = "K"; }
            // 客户端未声明 snippetSupport，不能把占位符作为普通文本插入。
            if (items[i].insertTextFormat == 2) { continue; }
            CodeCompletionItem item = new CodeCompletionItem(items[i].label, k,
                items[i].detail, LspSession.MarkupText(items[i].documentation));
            item.insertText = items[i].insertText != null ? items[i].insertText : "";
            JsonValue edit = items[i].textEdit;
            if (edit != null && !edit.IsNull()) {
                JsonValue range = edit.Get("range");
                if (range == null) { range = edit.Get("replace"); }
                if (range == null || !range.IsObject()) { continue; }
                JsonValue start = range.Get("start");
                JsonValue end = range.Get("end");
                JsonValue newText = edit.Get("newText");
                if (start == null || end == null || !start.IsObject() || !end.IsObject()
                    || newText == null || !newText.IsString()) { continue; }
                item.startLine = start.Int("line", -1);
                item.endLine = end.Int("line", -1);
                // Completion 的编辑范围必须在请求行内并包含请求光标。
                if (item.startLine != line0 || item.endLine != line0) { continue; }
                int startUtf16 = start.Int("character", -1);
                int endUtf16 = end.Int("character", -1);
                int lineUtf16 = CodeEditor.ByteColumnToUtf16(sourceLine, sourceLine.Length);
                if (startUtf16 < 0 || endUtf16 < startUtf16 || endUtf16 > lineUtf16) { continue; }
                item.startCol = CodeEditor.Utf16ColumnToByte(sourceLine, startUtf16);
                item.endCol = CodeEditor.Utf16ColumnToByte(sourceLine, endUtf16);
                if (CodeEditor.ByteColumnToUtf16(sourceLine, item.startCol) != startUtf16
                    || CodeEditor.ByteColumnToUtf16(sourceLine, item.endCol) != endUtf16
                    || item.startCol > col0 || item.endCol < col0) { continue; }
                item.hasTextEdit = true;
                item.insertText = edit.Str("newText", "");
            }
            res.Add(item);
        }
        return res;
    }

    static string SignatureLabel(LspSignatureHelp sh) {
        if (sh == null || sh.signatures == null || sh.signatures.Count == 0) { return ""; }
        int actSig = sh.activeSignature;
        if (actSig < 0 || actSig >= sh.signatures.Count) { actSig = 0; }
        return sh.signatures[actSig].label;
    }

    void DetachEditor() {
        if (boundEditor == null) { return; }
        boundEditor.CancelSemanticCompletion();
        boundEditor.ResetSemanticProviders();
        boundEditor.externalCompletion = null;
        boundEditor.externalSignature = null;
        boundEditor.externalHover = null;
        boundEditor = null;
    }

    // 接口数据协议与执行契约。
    void BindToEditor(CodeEditor editor) {
        if (editor == null || stopping) { return; }
        DetachEditor();
        boundEditor = editor;
        generation = generation + 1;
        if (background) { CancelUiRequests(LspPendingState.Cancelled); }
        else { CancelStaleEditorRequests(); cache.Clear(); }
        editor.ResetSemanticProviders();
        LspSession self = this;
        editor.externalCompletion = (string path, int line0, int col0) => {
            string text = editor.GetText();
            int stamp = editor.TextStamp();
            LspPendingRequest request = self.CachedRequest(editor, "textDocument/completion", path, line0, col0, "");
            if (editor.documentPath != path || editor.TextStamp() != stamp
                || editor.CurLine() != line0 || editor.CurCol() != col0
                || editor.GetText() != text) { return null; }
            return request != null ? request.editorCompletions : null;
        };
        editor.externalSignature = (string path, int line0, int col0, string callee) => {
            string text = editor.GetText();
            int stamp = editor.TextStamp();
            LspPendingRequest request = self.CachedRequest(editor, "textDocument/signatureHelp", path, line0, col0, callee);
            if (editor.documentPath != path || editor.TextStamp() != stamp
                || editor.CurLine() != line0 || editor.CurCol() != col0
                || editor.GetText() != text) { return ""; }
            return request != null ? request.signatureLabel : "";
        };
        editor.externalHover = (string path, int line0, int col0, string word) => {
            string text = editor.GetText();
            int stamp = editor.TextStamp();
            int caretLine = editor.CurLine();
            int caretCol = editor.CurCol();
            LspPendingRequest request = self.CachedRequest(editor, "textDocument/hover", path, line0, col0, word);
            if (editor.documentPath != path || editor.TextStamp() != stamp
                || editor.CurLine() != caretLine || editor.CurCol() != caretCol
                || editor.GetText() != text) { return ""; }
            return request != null ? request.hover : "";
        };
    }
}
