using System;

/// The tool layer behind the AI assistant panel.
///
/// The assistant is a loop, not a single question: the model answers with a
/// fenced `zan-tool` block, the IDE runs that tool inside the project, appends
/// the result to the transcript and asks again. That is what lets it look at
/// the real code instead of guessing from the one file that happens to be open.
///
///     ```zan-tool
///     {"tool": "read_file", "path": "src/Main.zan", "offset": 1, "limit": 200}
///     ```
///
/// The protocol is plain text on purpose: it works with any OpenAI-compatible
/// endpoint, including local models that do not implement function calling.
///
/// Read tools (`read_file`, `list_dir`, `grep`, `repo_map`) run silently.
/// The mutating tools (`write_file`, `edit_file`, `build`, `run`, `ui_check`)
/// wait for the user's Approve unless "Auto-execute" is on -- that gate is
/// enforced by the panel, not by trusting the model. Every file tool is
/// confined to the project directory: `SafePath` rejects absolute paths and
/// any `..` that would escape the root.
///
/// `ui_check` closes the loop the four rules ask for: the model can build the
/// program, drive its real UI with a script (the Gui UiDriver injects synthetic
/// input through the same event loop a human does) and read back the hit-region
/// geometry and assertion results -- so it verifies a fix against actual pixel
/// coordinates instead of claiming success.
class AiAgent {
    /// Hard ceiling on tool calls per user question, so a model that keeps
    /// asking for files can never spin forever. Higher than the read-only
    /// era because an edit -> build -> read-error -> fix cycle spends a few
    /// steps per change.
    static int MaxSteps() { return 20; }

    /// Largest slice of a file handed to the model in one read.
    static int MaxReadChars() { return 12000; }

    /// Largest file (bytes) the reader will pull fully into memory. A project
    /// contains build artifacts (.build/*.exe) and assets (images) far bigger
    /// than any source file; loading one of those as a string and splitting it
    /// into lines exhausts memory and takes the IDE down, so anything past this
    /// is refused with a hint rather than read.
    static int MaxFileBytes() { return 1048576; }

    /// True when the head of `s` contains a NUL byte -- the cheap, reliable
    /// signal that a file is binary rather than text, so the reader can decline
    /// instead of feeding megabytes of garbage into the transcript and shaper.
    static bool LooksBinary(string s) {
        int n = s.Length;
        if (n > 4096) { n = 4096; }
        for (int i = 0; i < n; i = i + 1) {
            if ((s[i] & 255) == 0) { return true; }
        }
        return false;
    }

    /// The fenced marker the model wraps a tool call in.
    static string Fence() { return "```zan-tool"; }

    /// Extracts the first `zan-tool` block's JSON from a model reply, or ""
    /// when the reply is a normal answer.
    static string ToolBlock(string reply) {
        int a = ZanIDE.IndexOfStr(reply, AiAgent.Fence());
        if (a < 0) { return ""; }
        int s = a + AiAgent.Fence().Length;
        while (s < reply.Length && reply.Substring(s, 1) != "\n") { s = s + 1; }
        s = s + 1;
        if (s >= reply.Length) { return ""; }
        string rest = reply.Substring(s, reply.Length - s);
        int b = ZanIDE.IndexOfStr(rest, "```");
        if (b < 0) { return ""; }
        return rest.Substring(0, b);
    }

    /// 流式过程中给聊天区看的那一段。
    ///
    /// 工具调用的正文（write_file 的整个文件、edit_file 的前后文本）是给 IDE
    /// 看的，不是给人读的：它一进流里，聊天区就被一整屏 `{"tool": "write_file",
    /// "content": "using System;\\nusing ..."` 埋掉，而这段 JSON 对用户没有任何
    /// 意义。所以工具块一露头就折成一行「▷ write_file 路径」——真正的结果稍后
    /// 由工具消息（本来就是一行可展开的摘要）给出，改了哪些文件、加减多少行由
    /// 改动清单给出。答完之后落进存档的那条消息走的是同一个折叠
    /// （`VisibleText`），流式过程与存档于是长一个样。
    static string LiveText(string live) { return AiAgent.VisibleText(live); }

    /// 一段回复里真正适合给人看的部分：正文照旧，工具调用折成一行
    /// 「▷ 工具 路径」。带围栏的和模型忘了围栏、光吐一个裸 `{"tool": ...}` 的都算：
    /// 一屏转义过的文件正文对人没有意义，而当时就是因为少了围栏没折，
    /// 整屏密密麻麻的 JSON 铺了出来。
    static string VisibleText(string reply) {
        int cut = ZanIDE.IndexOfStr(reply, AiAgent.Fence());
        int s = 0;
        if (cut >= 0) {
            s = cut + AiAgent.Fence().Length;
        } else {
            cut = AiAgent.BareCallAt(reply);
            if (cut < 0) { return reply; }
            s = cut;
        }
        string said = AiAgent.Trim(reply.Substring(0, cut));
        // 从调用起点往后扫，不把尾巴切出来：那一段就是整个文件的正文，
        // 流式期间每一拍复制一次几十万字节，界面就是在这里被拖住的。
        string one = "▷ " + AiAgent.LiveCall(reply, s);
        if (said == "") { return one; }
        return said + "\n\n" + one;
    }

    /// 这段回复里的工具调用摘要是不是已经定型了（工具名和第一个参数都拿到了）。
    /// 定型之后，后面再来多少字节都只是工具正文，摘要那一行不会再变——预览是
    /// 装饰性的（最终那一轮从整段原文重新解析），于是轮询可以停下来，不必为一个
    /// 越来越长的正文每一拍复制、折行、重排一次。
    static bool CallSettled(string reply) {
        int cut = ZanIDE.IndexOfStr(reply, AiAgent.Fence());
        int s = 0;
        if (cut >= 0) {
            s = cut + AiAgent.Fence().Length;
        } else {
            cut = AiAgent.BareCallAt(reply);
            if (cut < 0) { return false; }
            s = cut;
        }
        if (AiAgent.LiveField(reply, "tool", s) == "") { return false; }
        if (AiAgent.LiveField(reply, "path", s) != "") { return true; }
        if (AiAgent.LiveField(reply, "pattern", s) != "") { return true; }
        if (AiAgent.LiveField(reply, "query", s) != "") { return true; }
        return false;
    }

    /// 没带围栏的那个工具 JSON 从哪儿开始（没有就是 -1）。只看开头那一句
    /// `{"tool"`：说得再宽就会把普通说明里提到的字段名当成调用。
    static int BareCallAt(string reply) {
        int a = ZanIDE.IndexOfStr(reply, "{\"tool\"");
        int b = ZanIDE.IndexOfStr(reply, "{ \"tool\"");
        if (a < 0) { return b; }
        if (b < 0) { return a; }
        if (b < a) { return b; }
        return a;
    }

    /// 还没收完的那段工具 JSON 里，已经能看出来的「工具名 + 路径」。JSON 是
    /// 半截的，所以不解析、只按字段名往后扫第一个字符串值。
    static string LiveCall(string partial, int from) {
        string tool = AiAgent.LiveField(partial, "tool", from);
        if (tool == "") { return ZanIDE.T("preparing a tool call", "正在准备工具调用"); }
        string name = AiAgent.ToolLabel(tool);
        string path = AiAgent.LiveField(partial, "path", from);
        if (path != "") { return name + " " + path; }
        string pattern = AiAgent.LiveField(partial, "pattern", from);
        if (pattern != "") { return name + " \"" + pattern + "\""; }
        string query = AiAgent.LiveField(partial, "query", from);
        if (query != "") { return name + " \"" + query + "\""; }
        return name;
    }

    /// `"key": "value"` 里的 value（找不到就是 ""）。转义序列不还原：这一行是
    /// 给人扫一眼的路径，不是要拿去打开文件。
    static string LiveField(string s, string key, int from) {
        int at = ZanIDE.IndexOfFrom(s, "\"" + key + "\"", from);
        if (at < 0) { return ""; }
        int i = at + key.Length + 2;
        int n = s.Length;
        // 按字节看，不逐字符切子串：`Substring(i, 1)` 每个字符都要新分配一个
        // 字符串，扫一段几十万字节的正文就是几十万次分配。
        while (i < n && (s[i] & 255) != 34) {
            int ch = s[i] & 255;
            if (ch != 32 && ch != 58 && ch != 10 && ch != 13 && ch != 9) {
                return "";
            }
            i = i + 1;
        }
        i = i + 1;
        int b = i;
        while (b < n && (s[b] & 255) != 34) { b = b + 1; }
        if (b > n) { return ""; }
        return s.Substring(i, b - i);
    }

    /// The reply with its tool block removed -- what is worth showing in the
    /// transcript while the tool runs.
    static string StripToolBlock(string reply) {
        int a = ZanIDE.IndexOfStr(reply, AiAgent.Fence());
        if (a < 0) { return reply; }
        return AiAgent.Trim(reply.Substring(0, a));
    }

    /// 存进对话记录里的那一份工具调用（模型下一拍看到的就是这个）。
    ///
    /// 以前存的是剥掉工具块之后的正文，于是模型自己的历史里只剩「read_file
    /// src/X.zan」这种大白话，它照着自己的历史学，下一拍就把调用写成文字，
    /// IDE 收不到调用——「来回好几拍没进展」就是这么来的。所以历史里必须留下
    /// 真正的块。write_file / edit_file 的正文不留（一整个文件重复一遍只是烧
    /// 上下文，内容在上面的工具结果里），只留格式和路径。
    static string ArchiveCall(string call) {
        JsonValue v = JsonValue.ParseLenient(call);
        if (v == null) { return ""; }
        string tool = v.Str("tool", "");
        if (tool == "") { return ""; }
        if (!AiAgent.IsMutating(tool)) {
            return AiAgent.Fence() + "\n" + AiAgent.Trim(call) + "\n```";
        }
        StringBuilder sb = new StringBuilder();
        sb.Append(AiAgent.Fence() + "\n{\"tool\": \"" + tool + "\"");
        string path = v.Str("path", "");
        if (path != "") { sb.Append(", \"path\": \"" + path + "\""); }
        sb.Append(", \"...\": \"(正文见上面这次调用的结果，不重复)\"}\n```");
        return sb.ToString();
    }

    static string Trim(string s) {
        int a = 0;
        for (a = 0; a < s.Length; a = a + 1) {
            string ch = s.Substring(a, 1);
            if (ch != " " && ch != "\n" && ch != "\r" && ch != "\t") { break; }
        }
        int b = s.Length;
        for (b = s.Length; b > a; b = b - 1) {
            string ch = s.Substring(b - 1, 1);
            if (ch != " " && ch != "\n" && ch != "\r" && ch != "\t") { break; }
        }
        return s.Substring(a, b - a);
    }

    /// How many tool calls have already run for the question being answered:
    /// the trailing run of tool results since the last thing the user typed.
    static int StepsSinceUser(List<ChatMessage> msgs) {
        int n = 0;
        for (int i = msgs.Count - 1; i >= 0; i = i - 1) {
            if (msgs[i].role == "user") { return n; }
            if (msgs[i].role == "tool") { n = n + 1; }
        }
        return n;
    }

    /// The read-only standard-library root shipped with the IDE (or the
    /// source tree's stdlib when running from a dev build), so the assistant
    /// can answer API questions from the real stdlib source. "" when absent.
    static string StdlibRoot() {
        string d = ZanIDE.StdlibDir();
        if (Directory.Exists(d)) { return d; }
        d = ZanIDE.BaseDir() + "/../stdlib";
        if (Directory.Exists(d)) { return d; }
        return "";
    }

    /// The knowledge base shipped next to the IDE: knowledge/symbols.json
    /// (the RepoMap API index built from the real stdlib) and
    /// knowledge/gallery.json (the golden-example catalog). Published layout
    /// is <BaseDir>/knowledge; the dev tree keeps it one level up. "" when
    /// absent -- callers then fall back to stdlib_grep. This is the SAME data
    /// the server-side MCP serves, so the built-in assistant and external
    /// agents answer from one source and neither has to grep large files.
    static string KnowledgeDir() {
        string a = ZanIDE.BaseDir() + "/knowledge";
        if (Directory.Exists(a)) { return a; }
        string b = ZanIDE.BaseDir() + "/../knowledge";
        if (Directory.Exists(b)) { return b; }
        return "";
    }

    /// Resolves a shipped example/template path (as stored in gallery.json,
    /// e.g. "templates/gui/gui-empty/src/App.zan") to a file next to the IDE,
    /// trying the published layout then the dev tree one level up. "" when
    /// the file is not present.
    static string ShippedFile(string rel) {
        string a = ZanIDE.BaseDir() + "/" + rel;
        if (File.Exists(a)) { return a; }
        string b = ZanIDE.BaseDir() + "/../" + rel;
        if (File.Exists(b)) { return b; }
        return "";
    }

    /// Searches the shipped API index (knowledge/symbols.json) for records
    /// whose name or signature contains `query` (case-insensitive), returning
    /// up to `limit` verbatim {name,kind,file,line,sig} JSON records. This is
    /// the fast path for "what is the exact signature of X" -- use it before
    /// grepping the raw stdlib.
    static string ApiSearch(string query, int limit) {
        if (AiAgent.Trim(query) == "") {
            return "error: 'query' is required (a symbol fragment, e.g."
                + " \"Button\" or \"App.Create\").";
        }
        string kdir = AiAgent.KnowledgeDir();
        if (kdir == "") {
            return "error: the knowledge index was not found next to the IDE"
                + " (expected knowledge/symbols.json). Use stdlib_grep instead.";
        }
        string idx = kdir + "/symbols.json";
        if (!File.Exists(idx)) {
            return "error: knowledge/symbols.json is missing. Use stdlib_grep"
                + " instead.";
        }
        if (limit <= 0) { limit = 40; }
        string q = ZanIDE.ToLowerS(query);
        List<string> lines = File.ReadAllLines(idx);
        StringBuilder sb = new StringBuilder();
        int found = 0;
        for (int i = 0; i < lines.Count; i = i + 1) {
            if (found >= limit) { break; }
            string line = lines[i];
            if (ZanIDE.IndexOfStr(line, "\"name\"") < 0) { continue; }
            if (ZanIDE.IndexOfStr(ZanIDE.ToLowerS(line), q) < 0) { continue; }
            string rec = AiAgent.Trim(line);
            if (rec.Length > 0 && rec.Substring(rec.Length - 1, 1) == ",") {
                rec = rec.Substring(0, rec.Length - 1);
            }
            sb.Append(rec);
            sb.Append("\n");
            found = found + 1;
        }
        if (found == 0) {
            return "no symbol matched \"" + query + "\". Try a shorter fragment"
                + " (e.g. \"Button\", \"App.Create\", \"Gauge\"), or use"
                + " stdlib_grep.";
        }
        return "api_search \"" + query + "\" -- " + Convert.ToString(found)
            + " match(es), each {name,kind,file,line,sig}:\n" + sb.ToString();
    }

    /// Returns a shipped, build-verified template/example VERBATIM from the
    /// gallery.json catalog. With no topic it lists the catalog. The assistant
    /// copies the returned file(s) as a known-good starting point rather than
    /// inventing API usage.
    static string Example(string topic) {
        string kdir = AiAgent.KnowledgeDir();
        if (kdir == "") {
            return "error: the knowledge catalog was not found next to the IDE"
                + " (expected knowledge/gallery.json).";
        }
        string gp = kdir + "/gallery.json";
        if (!File.Exists(gp)) {
            return "error: knowledge/gallery.json is missing.";
        }
        JsonValue man = JsonValue.ParseLenient(File.ReadAllText(gp));
        if (man == null) {
            return "error: knowledge/gallery.json is not valid JSON.";
        }
        JsonValue entries = man.Get("entries");
        if (entries == null || !entries.IsArray()) {
            return "error: knowledge/gallery.json has no 'entries' array.";
        }
        string want = AiAgent.Trim(topic);
        if (want == "") {
            StringBuilder sb = new StringBuilder();
            sb.Append("example catalog -- call example {\"topic\":\"<one"
                + " below>\"} to get the verbatim file(s):\n");
            for (int i = 0; i < entries.Count(); i = i + 1) {
                JsonValue e = entries.At(i);
                sb.Append("- " + e.Str("topic", "") + "  [" + e.Str("kind", "")
                    + "]  " + e.Str("summary", "") + "\n");
            }
            return sb.ToString();
        }
        JsonValue match = null;
        for (int i = 0; i < entries.Count(); i = i + 1) {
            if (entries.At(i).Str("topic", "") == want) {
                match = entries.At(i);
                break;
            }
        }
        if (match == null) {
            for (int i = 0; i < entries.Count(); i = i + 1) {
                if (ZanIDE.IndexOfStr(entries.At(i).Str("topic", ""), want) >= 0) {
                    match = entries.At(i);
                    break;
                }
            }
        }
        if (match == null) {
            return "error: no example for topic '" + topic + "'. Call example"
                + " with no topic to list the catalog.";
        }
        string kind = match.Str("kind", "");
        StringBuilder sb = new StringBuilder();
        sb.Append("example topic \"" + match.Str("topic", "") + "\" [" + kind
            + "]: " + match.Str("summary", "") + "\n");
        string bld = match.Str("build", "");
        if (bld != "") { sb.Append("build: " + bld + "\n"); }
        JsonValue models = man.Get("models");
        if (models != null && models.Has(kind)) {
            sb.Append("model: " + models.Str(kind, "") + "\n");
        }
        JsonValue files = match.Get("files");
        if (files != null && files.IsArray()) {
            for (int i = 0; i < files.Count(); i = i + 1) {
                string rel = files.At(i).AsString("");
                sb.Append("\n===== " + rel + " =====\n");
                string full = AiAgent.ShippedFile(rel);
                if (full == "") {
                    sb.Append("(file missing next to the IDE)\n");
                } else {
                    sb.Append(File.ReadAllText(full));
                    sb.Append("\n");
                }
            }
        }
        return sb.ToString();
    }

    // --- path sandbox --------------------------------------------------------

    /// Resolves a project-relative path against `root`, or returns "" when it
    /// is absolute or climbs out of the project. Every tool goes through this,
    /// so the assistant cannot read the user's whole disk.
    static string SafePath(string root, string rel) {
        if (root == "") { return ""; }
        string p = AiAgent.Trim(rel);
        if (p == "" || p == ".") { return root; }
        p = AiAgent.Slashes(p);
        if (ZanIDE.IndexOfStr(p, "..") >= 0) { return ""; }
        if (p.Substring(0, 1) == "/") { return ""; }
        if (p.Length >= 2 && p.Substring(1, 1) == ":") { return ""; }
        return root + "/" + p;
    }

    static string Slashes(string p) {
        StringBuilder sb = new StringBuilder();
        for (int i = 0; i < p.Length; i = i + 1) {
            string ch = p.Substring(i, 1);
            if (ch == "\\") { sb.Append("/"); } else { sb.Append(ch); }
        }
        return sb.ToString();
    }

    /// Directories a code search never needs to walk into.
    static bool SkipDir(string name) {
        return name == ".git" || name == "build" || name == "publish"
            || name == "node_modules" || name == ".zanmap" || name == "obj"
            || name == "bin" || name == "_scratch";
    }

    /// True for a file worth searching: source and config text, not binaries.
    static bool TextFile(string name) {
        string e = AiAgent.ExtOf(name);
        return e == "zan" || e == "css" || e == "json" || e == "md"
            || e == "txt" || e == "proj" || e == "zform" || e == "zscene"
            || e == "c" || e == "h" || e == "ps1" || e == "yml" || e == "cfg";
    }

    static string ExtOf(string name) {
        for (int i = name.Length - 1; i >= 0; i = i - 1) {
            if (name.Substring(i, 1) == ".") {
                return name.Substring(i + 1, name.Length - i - 1);
            }
            if (name.Substring(i, 1) == "/") { return ""; }
        }
        return "";
    }

    // --- dispatch ------------------------------------------------------------

    /// Runs one tool call and returns the text handed back to the model.
    /// Never throws at the caller: a bad call comes back as an `error:` line
    /// the model can read and correct itself from.
    static string Run(string root, string json) {
        JsonValue v = JsonValue.ParseLenient(json);
        if (v == null) {
            return "error: the tool call is not valid JSON.";
        }
        string tool = v.Str("tool", "");
        if (tool == "read_file") {
            return AiAgent.ReadFile(root, v.Str("path", ""),
                                    v.Int("offset", 1), v.Int("limit", 300));
        }
        if (tool == "list_dir") {
            return AiAgent.ListDir(root, v.Str("path", ""));
        }
        if (tool == "grep") {
            return AiAgent.Grep(root, v.Str("pattern", ""), v.Str("path", ""),
                                v.Str("ext", ""));
        }
        if (tool == "repo_map") {
            return AiAgent.RepoMap(root);
        }
        if (tool == "stdlib_read") {
            string sroot = AiAgent.StdlibRoot();
            if (sroot == "") { return "error: the stdlib folder was not found next to the IDE."; }
            return AiAgent.ReadFile(sroot, v.Str("path", ""),
                                    v.Int("offset", 1), v.Int("limit", 300));
        }
        if (tool == "stdlib_grep") {
            string sroot = AiAgent.StdlibRoot();
            if (sroot == "") { return "error: the stdlib folder was not found next to the IDE."; }
            return AiAgent.Grep(sroot, v.Str("pattern", ""), v.Str("path", ""),
                                v.Str("ext", ""));
        }
        if (tool == "api_search") {
            return AiAgent.ApiSearch(v.Str("query", ""), v.Int("limit", 40));
        }
        if (tool == "example") {
            return AiAgent.Example(v.Str("topic", ""));
        }
        if (tool == "write_file") {
            return AiAgent.WriteFile(root, v.Str("path", ""),
                                     v.Str("content", ""));
        }
        if (tool == "edit_file") {
            return AiAgent.EditFile(root, v.Str("path", ""),
                                    v.Str("old", ""), v.Str("new", ""));
        }
        if (tool == "build" || tool == "run" || tool == "ui_check"
            || tool == "plan" || tool == "ui_tree" || tool == "diff"
            || tool == "run_errors") {
            // These need the IDE's own state / async machinery, so the panel
            // drives them directly; they never reach here.
            return "error: '" + tool + "' is run by the IDE, not this dispatch.";
        }
        return "error: unknown tool '" + tool + "'. Available: read_file,"
            + " list_dir, grep, repo_map, stdlib_read, stdlib_grep, api_search,"
            + " example, plan, write_file, edit_file, build, run, ui_check,"
            + " ui_tree, diff, run_errors.";
    }

    /// Fills `outSteps` from a `plan` tool call's `items` array, replacing
    /// whatever it held. Each item is either a short step string (optionally
    /// prefixed "[x] " / "[ ] " to mark it done) or an object
    /// {"t"|"text", "d"|"done"}. Returns the resulting step count.
    static int ParsePlan(string json, List<AiPlanStep> outSteps) {
        JsonValue v = JsonValue.ParseLenient(json);
        if (v == null) { return 0; }
        JsonValue items = v.Get("items");
        if (items == null || !items.IsArray()) { return 0; }
        for (int i = 0; i < items.Count(); i = i + 1) {
            JsonValue it = items.At(i);
            string txt = "";
            bool done = false;
            if (it.IsObject()) {
                txt = it.Str("t", it.Str("text", ""));
                done = it.Bool("d", it.Bool("done", false));
            } else {
                txt = it.AsString("");
                if (txt.Length >= 4) {
                    string pre = txt.Substring(0, 4);
                    if (pre == "[x] " || pre == "[X] ") {
                        done = true;
                        txt = txt.Substring(4, txt.Length - 4);
                    } else if (pre == "[ ] ") {
                        txt = txt.Substring(4, txt.Length - 4);
                    }
                }
            }
            txt = AiAgent.Trim(txt);
            if (txt != "") {
                int d = 0;
                if (done) { d = 1; }
                outSteps.Add(AiPlanStep.Create(txt, d));
            }
        }
        return outSteps.Count;
    }

    /// The plan a `plan` call asks for, with the previous plan's ticks carried
    /// over: steps are matched by their text, so a model that resends its
    /// checklist without repeating every "[x] " does not un-finish work that is
    /// already done. Returns a NEW list (the strip rebinds on identity change).
    ///
    /// Losing those ticks is what made a long task look aimless: the checklist
    /// reset to all-unfinished, so "the next unfinished step" pointed back at
    /// step 1 and the assistant redid or skipped around work it had finished.
    static List<AiPlanStep> MergePlan(string json, List<AiPlanStep> prev) {
        List<AiPlanStep> fresh = new List<AiPlanStep>();
        AiAgent.ParsePlan(json, fresh);
        for (int i = 0; i < fresh.Count; i = i + 1) {
            if (fresh[i].done != 0) { continue; }
            if (AiAgent.WasDone(prev, fresh[i].text)) { fresh[i].done = 1; }
        }
        return fresh;
    }

    /// Was this step (matched by text) already ticked in that plan?
    static bool WasDone(List<AiPlanStep> plan, string text) {
        if (plan == null) { return false; }
        for (int i = 0; i < plan.Count; i = i + 1) {
            if (plan[i].text == text) { return plan[i].done != 0; }
        }
        return false;
    }

    static int PlanDone(List<AiPlanStep> plan) {
        int n = 0;
        if (plan == null) { return 0; }
        for (int i = 0; i < plan.Count; i = i + 1) {
            if (plan[i].done != 0) { n = n + 1; }
        }
        return n;
    }

    /// The step being worked on -- the first unticked one -- as "3/7 <text>",
    /// or "" when the plan is empty or fully ticked. This is the one place that
    /// decides "where we are", so the strip, the context block and the continue
    /// nudge all name the same step.
    static string CurStepText(List<AiPlanStep> plan) {
        if (plan == null) { return ""; }
        for (int i = 0; i < plan.Count; i = i + 1) {
            if (plan[i].done == 0) {
                return Convert.ToString(i + 1) + "/"
                    + Convert.ToString(plan.Count) + " " + plan[i].text;
            }
        }
        return "";
    }

    /// What the `plan` tool answers with: the resulting counts, the step now
    /// current, and -- when the model rewrote its checklist instead of ticking
    /// it -- how many steps it dropped. Naming the churn is what stops it: the
    /// model only sees its plan through this reply.
    static string PlanNote(List<AiPlanStep> prev, List<AiPlanStep> next) {
        StringBuilder sb = new StringBuilder();
        sb.Append("\nplan updated: " + Convert.ToString(next.Count)
            + " step(s), " + Convert.ToString(AiAgent.PlanDone(next))
            + " done.");
        string cur = AiAgent.CurStepText(next);
        if (cur != "") {
            sb.Append(" current step: " + cur + ".");
        } else {
            sb.Append(" every step is ticked: say in one line what you"
                + " delivered and stop.");
        }
        int gone = 0;
        if (prev != null) {
            for (int i = 0; i < prev.Count; i = i + 1) {
                bool kept = false;
                for (int j = 0; j < next.Count && !kept; j = j + 1) {
                    if (next[j].text == prev[i].text) { kept = true; }
                }
                if (!kept) { gone = gone + 1; }
            }
        }
        if (gone > 0) {
            sb.Append(" NOTE: " + Convert.ToString(gone) + " step(s) of the"
                + " previous plan are gone. Rewording a step loses its [x] and"
                + " reads as starting over -- keep the wording of a step"
                + " identical for the whole task, and only add or remove a step"
                + " when the plan really changed (then say why in one line).");
        }
        return sb.ToString();
    }

    /// 单人模式那份计划在提示词里的样子（团队模式的对应物是任务图那块板）：
    /// 整张清单、当前那一步、以及「一步一步来」的规矩。由宿主在计划变化时写
    /// 进来（`SetPlanBoard`），每一拍作为现场的一部分发出去。
    ///
    /// 不发这一段，模型就只能从对话历史里回忆自己的清单——而历史会被压缩，
    /// 摘要里那份清单是几拍之前的：于是它一会儿跳到第 5 步、一会儿回头重做第
    /// 2 步，看着毫无逻辑。
    static string gPlanBoard;

    static void SetPlanBoard(string s) { AiAgent.gPlanBoard = s; }

    static string PlanBoard() {
        if (AiAgent.gPlanBoard == null) { return ""; }
        return AiAgent.gPlanBoard;
    }

    /// 把一份计划拼成上面那一段。空计划返回 ""。
    static string PlanBlock(List<AiPlanStep> plan) {
        if (plan == null || plan.Count == 0) { return ""; }
        StringBuilder sb = new StringBuilder();
        sb.Append("YOUR PLAN (the checklist above the chat, "
            + Convert.ToString(AiAgent.PlanDone(plan)) + "/"
            + Convert.ToString(plan.Count) + " done; this is the live copy --"
            + " trust it over any plan text earlier in the conversation):\n");
        for (int i = 0; i < plan.Count; i = i + 1) {
            string mark = "[ ]";
            if (plan[i].done != 0) { mark = "[x]"; }
            string lead = "  ";
            if (plan[i].done == 0 && AiAgent.PlanFirstOpen(plan) == i) {
                lead = "->";
            }
            sb.Append(lead + " " + Convert.ToString(i + 1) + ". " + mark + " "
                + plan[i].text + "\n");
        }
        string cur = AiAgent.CurStepText(plan);
        if (cur != "") {
            sb.Append("Work the step marked -> (" + cur + ") to the end before"
                + " you touch any later step; when it is really done, resend"
                + " the plan with it marked [x]. Do not jump ahead and do not"
                + " reword the steps.\n\n");
        } else {
            sb.Append("Every step is ticked: report what you delivered in one"
                + " line and stop instead of finding new work.\n\n");
        }
        return sb.ToString();
    }

    /// 第一条没打勾的下标（全打勾了返回 -1）。
    static int PlanFirstOpen(List<AiPlanStep> plan) {
        if (plan == null) { return -1; }
        for (int i = 0; i < plan.Count; i = i + 1) {
            if (plan[i].done == 0) { return i; }
        }
        return -1;
    }

    /// How many times one request is resent by the panel after a transport
    /// failure before the error reaches the user (the Net layer retries within
    /// a request too, so this is the outer, visible loop).
    static int MaxRetries() { return 2; }

    /// How many times one question may be pushed on with a continue turn when
    /// the user has not set a budget in the AI settings. Each continue also
    /// refills the per-question tool budget, so this bounds a runaway loop at
    /// MaxContinues() * MaxSteps() tool calls. Generous on purpose: a task
    /// graph of a dozen nodes spends a continue per hand-back, and stopping
    /// mid-graph to ask for "continue" reads as the assistant giving up.
    static int MaxContinues() { return 40; }

    /// The ceiling behind "unlimited" (0 in the settings). A truly unbounded
    /// loop has no way to stop a model that answers without ever finishing, so
    /// "unlimited" means "far past any real task" rather than "no bound".
    static int ContinuesCeiling() { return 100000; }

    /// The continue budget in force: what the user configured, 0 meaning
    /// unlimited, and a negative value meaning "never configured" -> default.
    static int ContinuesBudget(int configured) {
        if (configured < 0) { return AiAgent.MaxContinues(); }
        if (configured == 0) { return AiAgent.ContinuesCeiling(); }
        return configured;
    }

    /// True when a failed request looks like a transport hiccup rather than a
    /// refusal from the provider: a dropped connection, an idle timeout, a
    /// gateway 5xx or a rate limit. The panel retries those on its own instead
    /// of ending the task with an error the user has to restart by hand.
    static bool IsTransient(string msg) {
        // A refusal the provider spelled out (401 key, 400 body/model, 404 URL,
        // 413 too large) answers the same way every time. Resending it only
        // hides the message that tells the user what to fix -- and its text
        // often contains words like "connection" that would otherwise read as a
        // transport hiccup here.
        if (AiAgent.Has(msg, "http 4")
            && !AiAgent.Has(msg, "http 429") && !AiAgent.Has(msg, "http 408")) {
            return false;
        }
        return AiAgent.Has(msg, "timeout") || AiAgent.Has(msg, "timed out")
            || AiAgent.Has(msg, "streamer") || AiAgent.Has(msg, "connect")
            || AiAgent.Has(msg, "connection") || AiAgent.Has(msg, "reset")
            || AiAgent.Has(msg, "closed") || AiAgent.Has(msg, "eof")
            || AiAgent.Has(msg, "temporarily") || AiAgent.Has(msg, "429")
            || AiAgent.Has(msg, "500") || AiAgent.Has(msg, "502")
            || AiAgent.Has(msg, "503") || AiAgent.Has(msg, "504");
    }

    /// Case-insensitive substring test.
    static bool Has(string hay, string needle) {
        return ZanIDE.IndexOfStr(ZanIDE.ToLowerS(hay), needle) >= 0;
    }

    /// True when the assistant's last words put the ball back in the user's
    /// court (a question), so the loop must stop and wait instead of
    /// continuing on its own.
    static bool AsksUser(string reply) {
        string t = AiAgent.Trim(reply);
        if (t == "") { return false; }
        string tail = t.Substring(t.Length - 1, 1);
        if (tail == "?") { return true; }
        // '？' (U+FF1F) is three UTF-8 bytes; compare the whole suffix.
        if (t.Length >= 3 && t.Substring(t.Length - 3, 3) == "？") { return true; }
        return false;
    }

    /// The nudge that keeps a multi-step task moving without the user having
    /// to type "continue" after every pause.
    /// `curStep` = the step the checklist says is current ("3/7 <text>", "" when
    /// there is no plan): naming it is what keeps the work in one place. The old
    /// wording ("continue with the next unfinished step") left the choice to the
    /// model, which after a compaction no longer knew which step that was.
    static string ContinuePrompt(bool limitHit, string curStep) {
        StringBuilder sb = new StringBuilder();
        if (limitHit) {
            sb.Append("[auto] The per-question tool budget ran out mid-task."
                + " Keep going from where you stopped; do not start over.");
        } else {
            sb.Append("[auto] Continue.");
        }
        if (curStep != "") {
            sb.Append(" The current step is " + curStep + " -- finish exactly"
                + " that one, then resend the plan with it marked [x]. Do not"
                + " start a later step, do not reopen a step already marked"
                + " [x], and do not reword the plan.");
        } else {
            sb.Append(" Every planned step is marked [x]: say in one line what"
                + " you delivered and stop.");
        }
        return sb.ToString();
    }

    /// 回复里明明想调用工具、却没能解析成工具块时，给模型的纠错提示（""=没有
    /// 这种迹象）。
    ///
    /// 这就是「来回好几拍都没有进展」的真正原因：模型把调用写成了大白话
    /// （`read_file src/Main.zan`），或者工具块太长被截断没闭合，IDE 于是当成
    /// 「这一拍只说话没动手」，只回一句「上一拍没真做」——它永远不知道自己格式
    /// 错了，于是原样再来一遍。这里把失败原因直接说给它听。
    static string BadToolHint(string reply) {
        if (AiAgent.ToolBlock(reply) != "") { return ""; }
        if (ZanIDE.IndexOfStr(reply, AiAgent.Fence()) >= 0) {
            return "[auto] 你上一拍的工具块没有闭合（结尾的 ``` 丢了，通常是内容"
                + "太长被截断），所以那个调用根本没有执行。重发这一个调用：一次"
                + "只发一个 " + AiAgent.Fence() + " 块并且收尾闭合；文件很大就拆"
                + "成几次 write_file，或者用 edit_file 只改要改的那几行。";
        }
        if (!AiAgent.MentionsTool(reply)) { return ""; }
        return "[auto] 你上一拍只把工具名写成了文字，IDE 没有收到任何调用（能被"
            + "执行的只有工具块，别的写法一律无效）。照这个格式把你刚才想做的那"
            + "一个调用重发一遍：\n" + AiAgent.Fence()
            + "\n{\"tool\": \"read_file\", \"path\": \"src/Main.zan\"}\n```";
    }

    /// 回复里是不是提到了某个工具名：用来判断「它本来是想调用工具」。`run` /
    /// `plan` 这种太常见的词不算，免得把普通说明当成格式错误。
    static bool MentionsTool(string reply) {
        return ZanIDE.IndexOfStr(reply, "read_file") >= 0
            || ZanIDE.IndexOfStr(reply, "write_file") >= 0
            || ZanIDE.IndexOfStr(reply, "edit_file") >= 0
            || ZanIDE.IndexOfStr(reply, "list_dir") >= 0
            || ZanIDE.IndexOfStr(reply, "repo_map") >= 0
            || ZanIDE.IndexOfStr(reply, "stdlib_read") >= 0
            || ZanIDE.IndexOfStr(reply, "stdlib_grep") >= 0
            || ZanIDE.IndexOfStr(reply, "api_search") >= 0
            || ZanIDE.IndexOfStr(reply, "ui_check") >= 0
            || ZanIDE.IndexOfStr(reply, "grep") >= 0;
    }

    /// True for a tool that changes the project or runs code, so the panel
    /// asks the user before it runs (unless Auto-execute is on).
    static bool IsMutating(string tool) {
        return tool == "write_file" || tool == "edit_file"
            || tool == "build" || tool == "run" || tool == "ui_check";
    }

    /// 纯查询工具：结果只取决于工程当前的内容，没有写入发生时同一个调用
    /// 再跑一遍只会返回一模一样的东西。
    static bool IsLookup(string tool) {
        return tool == "read_file" || tool == "list_dir" || tool == "grep"
            || tool == "repo_map" || tool == "stdlib_read"
            || tool == "stdlib_grep" || tool == "api_search"
            || tool == "example";
    }

    /// 一个查询调用的身份：工具名加上真正决定结果的那几个参数。签名相同就是
    /// 同一次查询，调用方据此拦掉重复的第二次（见 ZanIDE.AiSeenTool）。
    static string CallSig(string json) {
        JsonValue v = JsonValue.ParseLenient(json);
        if (v == null) { return ""; }
        StringBuilder sb = new StringBuilder();
        sb.Append(v.Str("tool", ""));
        sb.Append("|" + v.Str("path", ""));
        sb.Append("|" + v.Str("pattern", ""));
        sb.Append("|" + v.Str("ext", ""));
        sb.Append("|" + v.Str("query", ""));
        sb.Append("|" + v.Str("topic", ""));
        sb.Append("|" + Convert.ToString(v.Int("offset", 1)));
        sb.Append("|" + Convert.ToString(v.Int("limit", 0)));
        return sb.ToString();
    }

    /// The tool name of a call, or "" for a malformed one.
    static string ToolName(string json) {
        JsonValue v = JsonValue.ParseLenient(json);
        if (v == null) { return ""; }
        return v.Str("tool", "");
    }

    /// 工具名在界面上的叫法：聊天区是给人看的，“read_file”“edit_file”是协议
    /// 里的字眼，不是人话。发给模型的调用名照旧（只换显示，不动协议）；
    /// 认不出来的就原样显示。
    static string ToolLabel(string tool) {
        if (tool == "read_file") { return ZanIDE.T("read_file", "读取文件"); }
        if (tool == "write_file") { return ZanIDE.T("write_file", "写入文件"); }
        if (tool == "edit_file") { return ZanIDE.T("edit_file", "修改文件"); }
        if (tool == "list_dir") { return ZanIDE.T("list_dir", "列目录"); }
        if (tool == "grep") { return ZanIDE.T("grep", "搜代码"); }
        if (tool == "repo_map") { return ZanIDE.T("repo_map", "工程概览"); }
        if (tool == "stdlib_read") { return ZanIDE.T("stdlib_read", "读标准库"); }
        if (tool == "stdlib_grep") { return ZanIDE.T("stdlib_grep", "搜标准库"); }
        if (tool == "api_search") { return ZanIDE.T("api_search", "查接口"); }
        if (tool == "example") { return ZanIDE.T("example", "看示例"); }
        if (tool == "plan") { return ZanIDE.T("plan", "列计划"); }
        if (tool == "build") { return ZanIDE.T("build", "编译"); }
        if (tool == "run") { return ZanIDE.T("run", "运行"); }
        if (tool == "run_errors") { return ZanIDE.T("run_errors", "运行错误"); }
        if (tool == "ui_check") { return ZanIDE.T("ui_check", "界面校验"); }
        if (tool == "ui_tree") { return ZanIDE.T("ui_tree", "界面结构"); }
        if (tool == "diff") { return ZanIDE.T("diff", "改动清单"); }
        return tool;
    }

    /// A one-line description of a call, shown folded in the transcript so the
    /// user can see what the assistant looked at.
    static string Describe(string json) {
        JsonValue v = JsonValue.ParseLenient(json);
        if (v == null) { return ZanIDE.T("tool", "工具"); }
        string tool = v.Str("tool", "?");
        string name = AiAgent.ToolLabel(tool);
        if (tool == "grep" || tool == "stdlib_grep") {
            return name + " \"" + v.Str("pattern", "") + "\"";
        }
        if (tool == "api_search") {
            return name + " \"" + v.Str("query", "") + "\"";
        }
        if (tool == "example") {
            return name + " " + v.Str("topic", "");
        }
        if (tool == "repo_map" || tool == "plan" || tool == "build"
            || tool == "run" || tool == "ui_check" || tool == "ui_tree"
            || tool == "diff" || tool == "run_errors") {
            return name;
        }
        return name + " " + v.Str("path", "");
    }

    /// Makes a model-supplied UiDriver script safe to run unattended: appends a
    /// hit-region dump and a `quit` when they are missing, so the driven window
    /// always closes (never hanging the check) and geometry is always captured.
    ///
    /// `withTheme` (ui_tree) also appends the skin's style-token dump, which is
    /// the half that lets the caller judge style rather than only position.
    static string NormalizeUiScript(string script, bool withTheme) {
        StringBuilder sb = new StringBuilder();
        sb.Append(script);
        if (script.Length == 0 || script.Substring(script.Length - 1, 1) != "\n") {
            sb.Append("\n");
        }
        if (ZanIDE.IndexOfStr(script, "dump hitregions") < 0) {
            sb.Append("wait 200\ndump hitregions regions.json\n");
        }
        if (withTheme && ZanIDE.IndexOfStr(script, "dump theme") < 0) {
            sb.Append("dump theme theme.json\n");
        }
        if (ZanIDE.IndexOfStr(script, "quit") < 0) {
            sb.Append("wait 200\nquit\n");
        }
        return sb.ToString();
    }

    /// Builds the ui_check result handed back to the model: the driver's
    /// assertion/step log first, then the hit-region geometry it dumped, so the
    /// model reasons over real coordinates rather than a screenshot it cannot
    /// see. Either part may be empty when the run produced nothing.
    static string UiResult(string resultsLog, string regionsJson,
            bool timedOut) {
        return AiAgent.UiResultOf("ui_check", resultsLog, regionsJson, "",
            timedOut);
    }

    /// As UiResult, for a named tool and with the optional style-token dump
    /// appended (ui_tree). Geometry answers "where is it", the tokens answer
    /// "what was it supposed to look like" -- a caller needs both to call a
    /// border extra or a label off-centre.
    static string UiResultOf(string toolName, string resultsLog,
            string regionsJson, string themeJson, bool timedOut) {
        StringBuilder sb = new StringBuilder();
        if (timedOut) {
            sb.Append(toolName + " TIMED OUT (the window did not close in"
                + " time); partial output below.\n");
        } else {
            sb.Append(toolName + " finished.\n");
        }
        if (resultsLog != "") {
            string rl = resultsLog;
            if (rl.Length > 4000) {
                rl = AiAgent.ClipTail(rl, 4000);
            }
            sb.Append("--- driver log ---\n" + rl);
            if (rl.Length > 0 && rl.Substring(rl.Length - 1, 1) != "\n") {
                sb.Append("\n");
            }
        } else {
            sb.Append("--- driver log --- (empty: script produced no output)\n");
        }
        if (regionsJson != "") {
            string rj = regionsJson;
            if (rj.Length > 6000) {
                rj = AiAgent.Clip(rj, 6000) + " ...(truncated)";
            }
            sb.Append("--- hit regions (x,y,w,h per widget) ---\n" + rj + "\n");
        }
        if (themeJson != "") {
            string tj = themeJson;
            if (tj.Length > 4000) {
                tj = AiAgent.Clip(tj, 4000) + " ...(truncated)";
            }
            sb.Append("--- skin style tokens (scale is x1000) ---\n"
                + tj + "\n");
        }
        return sb.ToString();
    }

    // --- tools ---------------------------------------------------------------

    /// Reads `limit` lines from `path` starting at 1-based `offset`, numbered
    /// so the model can quote exact line numbers back.
    static string ReadFile(string root, string path, int offset, int limit) {
        string full = AiAgent.SafePath(root, path);
        if (full == "") { return "error: path outside the project: " + path; }
        if (!File.Exists(full)) { return "error: no such file: " + path; }
        int fsz = File.GetSize(full);
        if (fsz > AiAgent.MaxFileBytes()) {
            return "error: file too large to read (" + Convert.ToString(fsz)
                + " bytes) -- likely a build artifact or asset, not source."
                + " Use grep to find what you need, or read a source file.";
        }
        int from = offset;
        if (from < 1) { from = 1; }
        int max = limit;
        if (max < 1) { max = 1; }
        if (max > 600) { max = 600; }
        string raw = File.ReadAllText(full);
        if (AiAgent.LooksBinary(raw)) {
            return "error: this is a binary file (not text); skipping " + path + ".";
        }
        List<string> lines = ZanIDE.Lines(raw);
        StringBuilder sb = new StringBuilder();
        sb.Append(path + " (" + Convert.ToString(lines.Count) + " lines)\n");
        int i = from - 1;
        for (int shown = 0; i < lines.Count && shown < max; shown = shown + 1) {
            sb.Append(Convert.ToString(i + 1) + ": " + lines[i] + "\n");
            if (sb.Length > AiAgent.MaxReadChars()) {
                sb.Append("... truncated, read again with a larger offset\n");
                return sb.ToString();
            }
            i = i + 1;
        }
        if (i < lines.Count) {
            sb.Append("... " + Convert.ToString(lines.Count - i)
                + " more lines; read again with offset "
                + Convert.ToString(i + 1) + "\n");
        }
        return sb.ToString();
    }

    /// Lists one directory: sub-directories first, then files.
    static string ListDir(string root, string path) {
        string full = AiAgent.SafePath(root, path);
        if (full == "") { return "error: path outside the project: " + path; }
        if (!Directory.Exists(full)) { return "error: no such directory: " + path; }
        StringBuilder sb = new StringBuilder();
        List<string> dirs = Directory.GetDirectories(full);
        for (int i = 0; i < dirs.Count; i = i + 1) {
            sb.Append(Path.GetFileName(dirs[i]) + "/\n");
        }
        List<string> files = Directory.GetFiles(full);
        for (int f = 0; f < files.Count; f = f + 1) {
            sb.Append(Path.GetFileName(files[f]) + "\n");
        }
        if (dirs.Count == 0 && files.Count == 0) { return "(empty)"; }
        return sb.ToString();
    }

    /// Substring search across the project's text files, reported as
    /// `path:line: text` -- the assistant's way of finding where a symbol is
    /// actually defined and used before it changes anything.
    static string Grep(string root, string pattern, string path, string ext) {
        if (pattern == "") { return "error: grep needs a 'pattern'."; }
        string start = AiAgent.SafePath(root, path);
        if (start == "") { return "error: path outside the project: " + path; }
        if (!Directory.Exists(start)) { start = root; }
        List<string> hits = new List<string>();
        AiAgent.GrepDir(start, root, pattern, ext, hits, 0);
        if (hits.Count == 0) { return "no match for \"" + pattern + "\""; }
        StringBuilder sb = new StringBuilder();
        for (int i = 0; i < hits.Count; i = i + 1) { sb.Append(hits[i] + "\n"); }
        if (hits.Count >= 80) {
            sb.Append("... more matches; narrow the pattern\n");
        }
        return sb.ToString();
    }

    /// Recursive grep walk. Directory.GetDirectories/GetFiles return bare
    /// entry names, so each recursion re-joins the full path -- a bare name
    /// would be resolved against the process working directory, which is not
    /// guaranteed to be the project root, and File.GetSize/ReadAllText would
    /// then throw on a file that is actually there.
    static void GrepDir(string dir, string root, string pattern, string ext,
                        List<string> hits, int depth) {
        if (hits.Count >= 80 || depth > 8) { return; }
        List<string> files = Directory.GetFiles(dir);
        for (int f = 0; f < files.Count && hits.Count < 80; f = f + 1) {
            string name = Path.GetFileName(files[f]);
            bool want = AiAgent.TextFile(name);
            if (ext != "" && AiAgent.ExtOf(name) != ext) { want = false; }
            if (want) { AiAgent.GrepFile(dir + "/" + name, root, pattern, hits); }
        }
        List<string> dirs = Directory.GetDirectories(dir);
        for (int d = 0; d < dirs.Count && hits.Count < 80; d = d + 1) {
            string dn = dirs[d];
            if (!AiAgent.SkipDir(dn)) {
                AiAgent.GrepDir(dir + "/" + dn, root, pattern, ext, hits, depth + 1);
            }
        }
    }

    static void GrepFile(string full, string root, string pattern,
                         List<string> hits) {
        if (File.GetSize(full) > AiAgent.MaxFileBytes()) { return; }
        string body = File.ReadAllText(full);
        if (ZanIDE.IndexOfStr(body, pattern) < 0) { return; }
        string rel = full;
        if (rel.Length > root.Length + 1 && rel.Substring(0, root.Length) == root) {
            rel = rel.Substring(root.Length + 1, rel.Length - root.Length - 1);
        }
        rel = AiAgent.Slashes(rel);
        List<string> lines = ZanIDE.Lines(body);
        for (int i = 0; i < lines.Count && hits.Count < 80; i = i + 1) {
            if (ZanIDE.IndexOfStr(lines[i], pattern) >= 0) {
                string txt = lines[i];
                if (txt.Length > 200) { txt = AiAgent.Clip(txt, 200) + "..."; }
                hits.Add(rel + ":" + Convert.ToString(i + 1) + ": " + txt);
            }
        }
    }

    /// The RepoMap outline (files, classes, method signatures) produced by the
    /// RepoMap tool, when the project has one. Without one the project tree is
    /// generated on the fly so the assistant still sees the whole project
    /// shape before it starts reading files.
    static string RepoMap(string root) {
        string mapPath = root + "/.zanmap/repo.map.txt";
        if (File.Exists(mapPath)) {
            string rm = File.ReadAllText(mapPath);
            if (rm.Length > 12000) { rm = AiAgent.Clip(rm, 12000) + "\n... truncated"; }
            return rm;
        }
        StringBuilder sb = new StringBuilder();
        sb.Append("(no RepoMap outline yet; auto-generated project tree)\n");
        AiAgent.AutoMap(root, sb, 0);
        string tree = sb.ToString();
        if (tree.Length > 12000) { tree = AiAgent.Clip(tree, 12000) + "\n... truncated"; }
        return tree;
    }

    /// Walks `dir` appending a tree of directories and text files to `sb`.
    /// `depth` caps recursion so a deep tree cannot blow the size budget;
    /// files carry a line count (byte size when too large to read cheaply).
    /// Directory.GetDirectories/GetFiles return bare entry names, so every
    /// recursion and file access re-joins the full path (never rely on the
    /// process working directory matching the project root).
    static void AutoMap(string dir, StringBuilder sb, int depth) {
        if (depth > 6 || sb.Length > 11000) { return; }
        List<string> dirs = Directory.GetDirectories(dir);
        for (int d = 0; d < dirs.Count && sb.Length <= 11000; d = d + 1) {
            string name = dirs[d];
            if (!AiAgent.SkipDir(name)) {
                string ind = "";
                for (int k = 0; k < depth; k = k + 1) { ind = ind + "  "; }
                sb.Append(ind + name + "/\n");
                AiAgent.AutoMap(dir + "/" + name, sb, depth + 1);
            }
        }
        List<string> files = Directory.GetFiles(dir);
        for (int f = 0; f < files.Count && sb.Length <= 11000; f = f + 1) {
            string name = Path.GetFileName(files[f]);
            if (AiAgent.TextFile(name)) {
                string ind = "";
                for (int k = 0; k < depth; k = k + 1) { ind = ind + "  "; }
                int size = File.GetSize(dir + "/" + name);
                if (size > 0 && size <= 262144) {
                    List<string> lines = ZanIDE.Lines(
                        File.ReadAllText(dir + "/" + name));
                    sb.Append(ind + name + " ("
                        + Convert.ToString(lines.Count) + " lines)\n");
                } else {
                    sb.Append(ind + name + " ("
                        + Convert.ToString(size) + " bytes)\n");
                }
            }
        }
    }

    // --- write tools ---------------------------------------------------------

    /// 一次改动的行数变化：掐掉首尾完全相同的行之后，新文本剩下的行算「增」、
    /// 旧文本剩下的行算「删」。
    ///
    /// 这不是最小编辑距离（那要 O(n*m)，而这条路径上每写一个文件都要算一次），
    /// 对一次连续的改动它就是准的；改了好几处时它报的是「从第一处到最后一处这
    /// 一段」的行数，偏大而不会偏小，也绝不会把没动过的头尾算成改动。
    static AiLineDelta LineDelta(string oldText, string newText) {
        List<string> a = ZanIDE.Lines(oldText);
        List<string> b = ZanIDE.Lines(newText);
        if (oldText == newText) { return AiLineDelta.Of(0, 0); }
        int head = 0;
        while (head < a.Count && head < b.Count && a[head] == b[head]) {
            head = head + 1;
        }
        int tail = 0;
        while (tail < a.Count - head && tail < b.Count - head
            && a[a.Count - 1 - tail] == b[b.Count - 1 - tail]) {
            tail = tail + 1;
        }
        return AiLineDelta.Of(b.Count - head - tail, a.Count - head - tail);
    }

    /// Writes `content` to `path`, creating parent directories as needed.
    /// Used for new files or full rewrites; prefer `edit_file` for a small
    /// change to an existing file. Confined to the project by `SafePath`.
    static string WriteFile(string root, string path, string content) {
        string full = AiAgent.SafePath(root, path);
        if (full == "") { return "error: path outside the project: " + path; }
        string dir = ZanIDE.DirOf(full);
        if (dir != "" && dir != "." && !Directory.Exists(dir)) {
            Directory.CreateDirectoryRecursive(dir);
        }
        File.WriteAllText(full, content);
        List<string> lines = ZanIDE.Lines(content);
        return "wrote " + path + " (" + Convert.ToString(lines.Count)
            + " lines, " + Convert.ToString(content.Length) + " chars)";
    }

    /// Replaces the single occurrence of `old` in `path` with `new`. The match
    /// must be unique -- if `old` is missing or appears more than once the edit
    /// is refused with an error the model can correct from, so a change never
    /// lands in the wrong place.
    static string EditFile(string root, string path, string oldS, string newS) {
        if (oldS == "") {
            return "error: edit_file needs the 'old' text to find and replace.";
        }
        string full = AiAgent.SafePath(root, path);
        if (full == "") { return "error: path outside the project: " + path; }
        if (!File.Exists(full)) { return "error: no such file: " + path; }
        if (File.GetSize(full) > AiAgent.MaxFileBytes()) {
            return "error: file too large to edit (" + Convert.ToString(File.GetSize(full))
                + " bytes); this tool only edits source-sized text files.";
        }
        string body = File.ReadAllText(full);
        int first = ZanIDE.IndexOfStr(body, oldS);
        if (first < 0) {
            return "error: 'old' text not found in " + path
                + "; read the file and copy the exact text (including indentation).";
        }
        int after = first + oldS.Length;
        string rest = body.Substring(after, body.Length - after);
        if (ZanIDE.IndexOfStr(rest, oldS) >= 0) {
            return "error: 'old' text appears more than once in " + path
                + "; include more surrounding lines so the match is unique.";
        }
        string updated = body.Substring(0, first) + newS + rest;
        File.WriteAllText(full, updated);
        return "edited " + path + " (replaced 1 occurrence, now "
            + Convert.ToString(updated.Length) + " chars)";
    }

    /// Turns a finished build's compiler output into the result handed back to
    /// the model: the pass/fail line, then the actual error/warning lines (or
    /// a tail of the log when there are none) so it reads real diagnostics
    /// rather than a summary it has to trust.
    static string BuildResult(List<string> lines, bool ok, bool ran) {
        StringBuilder sb = new StringBuilder();
        if (ok) { sb.Append("build succeeded"); }
        else { sb.Append("build FAILED"); }
        if (ok && ran) { sb.Append("; program launched"); }
        sb.Append(".\n");
        List<string> keep = new List<string>();
        for (int i = 0; i < lines.Count; i = i + 1) {
            string ln = lines[i];
            if (ZanIDE.IndexOfStr(ln, "error") >= 0
                || ZanIDE.IndexOfStr(ln, "Error") >= 0
                || ZanIDE.IndexOfStr(ln, "warning") >= 0) {
                keep.Add(ln);
            }
        }
        if (keep.Count == 0) {
            int from = lines.Count - 20;
            if (from < 0) { from = 0; }
            int k = from;
            while (k < lines.Count) { sb.Append(lines[k] + "\n"); k = k + 1; }
        } else {
            int shown = keep.Count;
            if (shown > 40) { shown = 40; }
            for (int k = 0; k < shown; k = k + 1) { sb.Append(keep[k] + "\n"); }
            if (keep.Count > shown) {
                sb.Append("... " + Convert.ToString(keep.Count - shown)
                    + " more diagnostic lines\n");
            }
        }
        return sb.ToString();
    }

    // --- prompt --------------------------------------------------------------

    /// The assistant's standing instructions. The rules are what keep a model
    /// from guessing: look before answering, fix the general layer, and never
    /// claim something works without having checked it.
    ///
    /// 这一段每一拍都逐字节相同，因此它就是供应商 prompt 缓存命中的那段前缀
    /// （缓存是按前缀匹配的：前面差一个字节，后面全部重新计费）。每一拍都在变的
    /// 现场 —— 当前打开的文件、任务图 —— 一律放 `ContextBlock`，作为最后一条
    /// 消息发出去，别写回这里；只在项目变了才变的项目结构/项目知识定型一份接
    /// 在这一段后面（`ProjectRef`）。
    static string BaseInstructions() {
        StringBuilder sb = new StringBuilder();
        sb.Append("You are Xiao Zan (小赞), the assistant built into Zan IDE,"
            + " the IDE of the"
            + " Zan programming language. Help the user develop the project"
            + " that is open. Answer concisely, in the user's language.\n\n");
        sb.Append("TOOLS. You can look at the project yourself. To call a tool,"
            + " reply with ONLY a fenced block and nothing else:\n"
            + AiAgent.Fence() + "\n{\"tool\": \"read_file\", \"path\":"
            + " \"src/Main.zan\", \"offset\": 1, \"limit\": 200}\n```\n"
            + "Read tools (run silently):\n"
            + "- read_file {path, offset, limit}: numbered lines of one file.\n"
            + "- list_dir {path}: entries of one directory (\"\" = project root).\n"
            + "- grep {pattern, path, ext}: substring search across the project;"
            + " returns path:line: text.\n"
            + "- repo_map {}: full outline of the codebase. A project tree is"
            + " ALREADY included in this message (Project structure, below),"
            + " so you rarely need it; call it only when you need a deeper"
            + " tree than the one there.\n"
            + "- stdlib_read {path, offset, limit} / stdlib_grep {pattern, path,"
            + " ext}: read/search the Zan STANDARD LIBRARY source shipped with"
            + " the IDE (paths relative to the stdlib root, e.g."
            + " \"Gui/Widget/Button.zan\"). Use these to check the real"
            + " signature/behaviour of a stdlib API before using it.\n"
            + "- api_search {query, limit}: search the shipped API index"
            + " (knowledge/symbols.json, generated from the real stdlib) and"
            + " get matching {name,kind,file,line,sig} records. Use this FIRST"
            + " to find a control/method's exact signature instead of grepping"
            + " large stdlib files.\n"
            + "- example {topic}: return a shipped, build-verified"
            + " template/example VERBATIM (no topic = list the catalog). Copy"
            + " this as your starting point for Gui/Game code instead of"
            + " writing from memory.\n"
            + "- plan {items}: show/update the task-plan checklist above the"
            + " chat. `items` is an array of short step strings (prefix"
            + " \"[x] \" to mark a step done); it replaces the current plan."
            + " Steps are matched by their text, so keep each step's wording"
            + " IDENTICAL for the whole task: reword it and it loses its [x]."
            + " Aim for 3-8 steps, each one a change you can finish and verify"
            + " on its own, in the order you will do them. Runs silently.\n"
            + "Action tools (the IDE asks the user to approve each one first,"
            + " unless they turned on Auto-execute):\n"
            + "- edit_file {path, old, new}: replace the UNIQUE occurrence of"
            + " `old` with `new` in an existing file. Copy `old` verbatim from a"
            + " read_file, including indentation; if it is not unique the edit is"
            + " refused, so include enough surrounding lines. Prefer this for"
            + " small changes.\n"
            + "- write_file {path, content}: create a new file or fully rewrite"
            + " one. `content` is the whole file. Keep one call under ~200"
            + " lines: a longer reply gets cut off mid-block, the call is then"
            + " unparsable and NOTHING runs. Split a big file into a first"
            + " write_file plus edit_file additions.\n"
            + "- build {}: compile the current run target and send you the"
            + " compiler errors/warnings.\n"
            + "- run {}: build, then launch the program.\n"
            + "- ui_check {script}: build the target, launch it, and drive its"
            + " real UI with `script` (one UiDriver command per line), then send"
            + " you the assertion log and the hit-region geometry it dumped."
            + " Commands: `wait <ms>`, `move/click <x> <y>`, `clickid <id>`,"
            + " `type \\\"text\\\"`, `keydown/keyup <code> [mods]`,"
            + " `dump hitregions <file>`, `assert probe <name> contains|equals"
            + " <text>`, `log <text>`, `quit`. It auto-dumps regions and quits"
            + " if you omit them. This is how you VERIFY a UI fix: read the"
            + " widget x/y/w/h back and check the real numbers.\n"
            + "- ui_tree {}: build, launch and send you BOTH the widget"
            + " geometry (x/y/w/h/type per hit region) AND the active skin's"
            + " resolved style tokens (text/bg/border colours, radii, border"
            + " width, font sizes, control heights, paddings, gaps, and the"
            + " glass/gradient/neu/brutal skin flags). The GUI renders"
            + " immediate-mode, so there is no retained widget tree to walk:"
            + " this pairing IS the tree. Use it to judge style, not just"
            + " position -- e.g. compare a label's rect against the control"
            + " height and font size to check vertical centring, or against"
            + " borderWidth to tell a real extra frame from the skin's own.\n"
            + "- diff {}: the project's uncommitted changes as a unified diff."
            + " Read this before reviewing or auditing a change instead of"
            + " re-reading whole files.\n"
            + "- run_errors {}: the last run's exit code, stderr and crash"
            + " backtrace, structured. Call it after a run/ui_check that"
            + " failed rather than guessing why.\n"
            + "Paths are relative to the project root; absolute paths and '..'"
            + " are refused. The IDE runs the tool and sends you the result,"
            + " then you continue. One tool call per reply, at most "
            + Convert.ToString(AiAgent.MaxSteps()) + " per question. If the user"
            + " rejects an action, do not repeat it -- propose something else or"
            + " ask.\n\n");
        sb.Append("WORKFLOW. Work in this order for every coding task:\n"
            + "1. PLAN first, then follow it top-down. For any task that needs"
            + " more than one edit or tool call, post a short checklist with the"
            + " plan tool BEFORE the first action.\n"
            + "1a. ONE STEP AT A TIME. Every turn, work the first step that is"
            + " not [x] (the current context block marks it with ->) and nothing"
            + " else: retrieve for it, change code for it, verify it, then"
            + " resend the plan with that step marked [x]. Do not start a later"
            + " step while the current one is unfinished, and do not reopen a"
            + " step that is already [x] -- if it turns out to be wrong, say so"
            + " in one line and add a new step for the fix.\n"
            + "1b. Revise the plan only when the situation really changed (you"
            + " found the cause somewhere else, a step turned out unnecessary):"
            + " say in one line what changed, then resend the plan keeping the"
            + " wording of the steps that survive. Re-listing the same work in"
            + " new words is not progress and loses your ticks.\n"
            + "2. RETRIEVE before acting. Read the code a change depends on"
            + " first (grep / read_file / stdlib_grep / api_search); find the"
            + " real source of a value before editing it. Never invent a file,"
            + " symbol or API you have not seen in a tool result this"
            + " conversation. For Gui or Game work this is mandatory: query the"
            + " API index (api_search) AND open a shipped example (example tool)"
            + " -- see the GUI & GAME section -- BEFORE writing code; do not"
            + " guess a control constructor, a Theme token or a Game module"
            + " entry.\n"
            + "3. CITE your evidence as path:line so the user can check every"
            + " claim against the code you actually read.\n"
            + "4. VERIFY before claiming. After an edit, build (or run /"
            + " ui_check) and read the result. Never say fixed, done, built or"
            + " tested unless a tool actually ran and confirmed it; state"
            + " plainly what is still unverified.\n"
            + "5. RECOVER from errors instead of thrashing. When a build or"
            + " tool fails: read the error text, name the most likely cause,"
            + " and fix that cause. Never resend the exact same failing action."
            + " If the same error survives two different fixes, stop patching:"
            + " re-read the surrounding code and question your assumption. If"
            + " your own edit made things worse, revert it (edit_file with old"
            + " and new swapped) before trying a new approach. If you are still"
            + " stuck near the step limit, report honestly what you tried, what"
            + " failed and what you would try next.\n\n");
        sb.Append("RULES.\n"
            + "1. Fix the general layer, not the symptom: prefer changing the"
            + " shared style/layout/helper over special-casing one screen, and"
            + " never hard-code coordinates or magic values to hide a bug.\n"
            + "2. Keep edits minimal and in the surrounding style; prefer"
            + " edit_file over rewriting a whole file. Do not change code that is"
            + " not part of the question.\n"
            + "3. Lead with the answer or the bad news; skip preamble.\n\n");
        sb.Append("ZAN LANGUAGE. Zan looks like C# but is NOT C#: the standard"
            + " library is Zan's own, so never assume a .NET API exists --"
            + " check with stdlib_grep/stdlib_read first. Working notes:\n"
            + "- Files declare `using Ns;` imports and one `namespace Ns;`;"
            + " code lives in classes/structs; entry point is `static void"
            + " Main()`.\n"
            + "- Common types: int, long, float, double, bool, string,"
            + " List<T>, Dictionary<K,V>. Literals: `new List<int>{1,2}`.\n"
            + "- Strings: s.Length, s.Substring(start, len), s.Split(sep),"
            + " s[i] indexes a char code (mask with `& 255`); build long text"
            + " with StringBuilder. Numbers <-> strings via Convert.ToString /"
            + " Convert.ToInt32.\n"
            + "- Prefer plain `while` loops and `i = i + 1`, explicit `if`"
            + " chains, and early returns -- match the style of the code"
            + " around you. There is no LINQ, no lambdas-everywhere, no"
            + " exceptions-driven flow in typical Zan code.\n"
            + "- GUI apps are self-rendered: an App owns windows; widgets"
            + " (Gui.Widget.*) render immediate-mode with `.Render(app, x,"
            + " y, w)`; Canvas draws primitives. Designer documents are"
            + " .zform/.zscene JSON generating a .g.zan file, with user logic"
            + " in the paired .zan code-behind.\n"
            + "- Build/run a file: `zanc file.zan --auto-stdlib -o out.exe`"
            + " (the IDE's build tool does this for you).\n\n");
        sb.Append("GUI & GAME. Before writing ANY Gui or Game code you MUST"
            + " first look up the exact API (api_search, falling back to"
            + " stdlib_read/stdlib_grep) AND copy a shipped example (the example"
            + " tool) instead of inventing usage. Never guess a control"
            + " constructor, a Theme token name, or a Game module's entry"
            + " shape.\n"
            + "GUI has two models -- pick one, don't mix:\n"
            + "- DESIGNER (recommended for windows/forms): a .zform/.zscene JSON"
            + " defines the window; zanc projects the designed controls into"
            + " typed fields and generates a .g.zan; your logic lives in the"
            + " paired .zan code-behind (OnLoad(Form form), then"
            + " control.OnClick(...)/OnChange(...)). There is NO manual main"
            + " loop and NO generated file to hand-edit. Start from"
            + " templates/gui/gui-* (gui-empty, gui-components, gui-dashboard,"
            + " gui-hmi, gui-ribbon, gui-sidebar, gui-tabform, gui-toolbar,"
            + " gui-watch, gui-free, gui-webview).\n"
            + "- IMMEDIATE-MODE (custom-drawn/canvas/dashboards): you drive the"
            + " frame loop yourself:\n"
            + "    App app = App.CreateDark(title, w, h); app.Show();\n"
            + "    while (app.isRunning) {\n"
            + "        if (!app.ProcessEvent()) break;\n"
            + "        if (!app.needsRedraw) continue;\n"
            + "        app.BeginFrame(); app.RenderChrome(title);\n"
            + "        /* widget.Render(app, x, y, w); */\n"
            + "        app.PresentFrame();\n"
            + "    }\n"
            + "  Keep control IDs stable across frames; hold state in"
            + " caller-owned signals/inputs; never block on I/O during"
            + " rendering; use app.Scale(n) for DPI. Controls render THEMSELVES"
            + " -- configure/position them at the call site, never re-draw a"
            + " Widget/Hmi/Chart's internals. Examples: examples/gui_charts,"
            + " examples/gui_gallery, examples/gui_browser.\n"
            + "Theme tokens are a FIXED set -- any other name is an error."
            + " Valid: primary, info, success, warning, error;"
            + " textPrimary/Secondary/Tertiary/Disabled/Inverse;"
            + " bgPrimary/Secondary/Tertiary/Hover/Active/Disabled;"
            + " borderPrimary/Secondary/Hover/Focus; divider, overlay,"
            + " tooltipBg, tooltipBorder, tooltipText, tooltipTextMuted, scrim,"
            + " scrimChip, scrollbar, scrollbarHover. (There is NO `surface`,"
            + " `windowW` or `windowH` token.)\n"
            + "GAME: SDL3 owns the window/render/input/timing; the Game.*"
            + " modules own domain concepts -- do not open windows from Game"
            + " code. Module map:\n"
            + "- Game.Foundation: fixed-step timing, deterministic RNG, semantic"
            + " input, scenes.\n"
            + "- Game.Board: grids, pathfinding, turns, validated commands,"
            + " snapshots/replay (gomoku, weiqi, xiangqi).\n"
            + "- Game.Cards: catalogs, runtime instances, zones, deck-building"
            + " runtime (ddz).\n"
            + "- Game.Arcade2D: geometry, collision, animation, pooled entities,"
            + " path following (snake, breakout).\n"
            + "- Game.Zgm: typed component model, maps, roles/items/skills/buffs,"
            + " windows, saves/networking/SQLite.\n"
            + "- Game.Arpg: typed RPG runtime"
            + " (world/combat/scheduling/data-binding/SDL render).\n"
            + "- examples/game/ra2: clean-room RA2-compatible demo for user-owned"
            + " assets.\n"
            + "Start from examples/game/* (snake, breakout, gomoku, weiqi,"
            + " xiangqi, ddz, ra2).\n\n");
        return sb.ToString();
    }

    /// 这一拍的现场：当前打开的文件和自己拆出来的任务图。每一拍都可能变（用户
    /// 敲一个字、工具改一个文件、任务图动一下），所以它单独作为**最后一条**消息
    /// 发出去：前面的系统指令、项目参考和整段对话于是逐字节不变，供应商的
    /// prompt 缓存才有东西可命中。
    static string ContextBlock(string ctxName, string ctxCode, string root) {
        StringBuilder sb = new StringBuilder();
        sb.Append("CURRENT CONTEXT (refreshed every turn; always trust this"
            + " over anything older in the conversation).\n\n");
        if (ctxName != "") {
            string ctx = ctxCode;
            if (ctx.Length > 6000) { ctx = AiAgent.Clip(ctx, 6000); }
            sb.Append("The user is currently editing " + ctxName
                + ". Its current content:\n" + ctx + "\n\n");
        }
        // 项目参考定型之后才变的那种情况（工具新建了文件、知识被写了一条）：
        // 差异走这条消息补，前缀那份一个字都不动。重写前缀等于把整段对话的
        // 缓存一起作废，为一次结构变动付那个价钱不值得。
        if (root != "") {
            string now = AiAgent.ProjectRefNow(root);
            if (now != AiAgent.ProjectRef(root)) {
                sb.Append("PROJECT REFERENCE UPDATED since the copy in the"
                    + " system message -- this is the current one:\n"
                    + now + "\n");
            }
        }
        // 单人模式那份计划：当前那一步在这里被指出来，模型于是不必从被压缩过
        // 的历史里猜自己走到哪了。
        sb.Append(AiAgent.PlanBoard());
        // 自己拆出来的任务图（含当前打开的节点、能开工的节点，以及怎么改
        // 它）。不告诉它图长什么样，它就只能把图当作一次性的清单发完就忘。
        sb.Append(AiTeam.Board());
        return sb.ToString();
    }

    // 项目参考（RepoMap 结构 + 项目知识）：内容只在项目本身变了才变，但足有
    // 一万多字节。以前它跟着现场每一拍重发一遍，那一万多字节于是每一拍都落在
    // 缓存前缀之外——这就是命中率上不去的大头。现在在会话第一次请求时定型一
    // 份，挂在系统消息后面进到前缀里，之后逐字节复用。
    static string gProjRef;
    static string gProjRoot;

    /// 这个项目定型的那份项目参考（第一次问到就按当前项目生成并留下来）。
    static string ProjectRef(string root) {
        if (root == "") { return ""; }
        if (AiAgent.gProjRef == null || AiAgent.gProjRoot != root) {
            AiAgent.gProjRoot = root;
            AiAgent.gProjRef = AiAgent.ProjectRefNow(root);
        }
        return AiAgent.gProjRef;
    }

    /// 现在这一刻的项目参考：项目结构（RepoMap 大纲，没有就现生成目录树）加
    /// 项目知识（`.zan/knowledge.md` 里已经验收通过的结论——它是这个项目里
    /// 「已经定成什么样」的现有事实，所以先读它再动手，别把上一个任务定下来的
    /// 东西重新讨论一遍）。
    static string ProjectRefNow(string root) {
        if (root == "") { return ""; }
        StringBuilder sb = new StringBuilder();
        string mapPath = root + "/.zanmap/repo.map.txt";
        string rm = "";
        if (File.Exists(mapPath)) {
            rm = File.ReadAllText(mapPath);
        } else {
            // No RepoMap outline: generate the project tree on the fly so
            // the model still starts with the project's shape.
            StringBuilder am = new StringBuilder();
            am.Append("(auto-generated project tree; no RepoMap outline)\n");
            AiAgent.AutoMap(root, am, 0);
            rm = am.ToString();
        }
        if (rm.Length > 8000) { rm = AiAgent.Clip(rm, 8000); }
        sb.Append("Project structure (RepoMap outline -- files, classes"
            + " and method signatures):\n" + rm + "\n");
        string kn = AiTaskGraph.LoadNotes(root, 4000);
        if (AiAgent.Trim(kn) != "") {
            sb.Append("Project knowledge (.zan/knowledge.md -- settled"
                + " conclusions from accepted tasks; treat as current"
                + " fact and keep it up to date):\n" + kn + "\n\n");
        }
        return sb.ToString();
    }

    // --- streaming (SSE) parsing ---------------------------------------------

    /// Folds a text/event-stream reply into an answer. The stream is a series
    /// of `data: {json}` lines; each JSON carries a `choices[0].delta` with an
    /// incremental `content` (the answer) and/or `reasoning_content` (the
    /// model's thinking). Concatenating the deltas in order rebuilds both. A
    /// provider `error` object or the terminal `data: [DONE]` are surfaced too,
    /// and malformed lines are skipped so a half-written tail never throws.
    static SseAnswer ParseSse(string raw) {
        SseAnswer a = new SseAnswer();
        a.content = "";
        a.reasoning = "";
        a.error = "";
        a.done = false;
        a.promptTokens = 0;
        a.completionTokens = 0;
        a.totalTokens = 0;
        a.cachedTokens = 0;
        StringBuilder c = new StringBuilder();
        StringBuilder r = new StringBuilder();
        int n = raw.Length;
        int i = 0;
        while (i < n) {
            int nl = i;
            while (nl < n && (raw[nl] & 255) != 10) { nl = nl + 1; }
            int lineEnd = nl;
            if (lineEnd > i && (raw[lineEnd - 1] & 255) == 13) {
                lineEnd = lineEnd - 1;
            }
            string line = raw.Substring(i, lineEnd - i);
            // `data:` carries the optional space or not, depending on the
            // provider; both are the same event.
            string payload = "";
            bool isData = false;
            if (line.Length >= 6 && line.Substring(0, 6) == "data: ") {
                payload = line.Substring(6, line.Length - 6);
                isData = true;
            } else if (line.Length >= 5 && line.Substring(0, 5) == "data:") {
                payload = AiAgent.Trim(line.Substring(5, line.Length - 5));
                isData = true;
            }
            if (isData) {
                if (payload == "[DONE]") {
                    a.done = true;
                } else {
                    AiAgent.FoldChunk(a, c, r, JsonValue.ParseLenient(payload),
                                      payload);
                }
            }
            if (nl >= n) { break; }
            i = nl + 1;
        }
        // No event line at all: a provider that answers a stream request with a
        // plain JSON body (an error object, or a whole non-streamed reply) has
        // to be understood too, or its explanation is dropped and the panel
        // reports an empty answer with nothing to act on.
        string flat = AiAgent.Trim(raw);
        if (!a.done && a.error == "" && c.Length == 0 && flat.Length > 0
            && flat.Substring(0, 1) == "{") {
            AiAgent.FoldChunk(a, c, r, JsonValue.ParseLenient(flat), flat);
        }
        a.content = c.ToString();
        a.reasoning = r.ToString();
        return a;
    }

    /// Folds one parsed chunk (a stream event's JSON, or a whole non-streamed
    /// body) into the answer being assembled. `raw` is the text it came from,
    /// used as the error message when the provider sent an error object without
    /// one.
    static void FoldChunk(SseAnswer a, StringBuilder c, StringBuilder r,
            JsonValue v, string raw) {
        if (v == null) { return; }
        JsonValue err = v.Get("error");
        if (err != null && a.error == "") {
            if (err.IsObject()) { a.error = err.Str("message", raw); }
            else { a.error = err.AsString(raw); }
        }
        JsonValue ch = v.Get("choices");
        if (ch != null && ch.IsArray() && ch.Count() > 0) {
            JsonValue delta = ch.At(0).Get("delta");
            if (delta != null) {
                c.Append(delta.Str("content", ""));
                r.Append(delta.Str("reasoning_content", ""));
            } else {
                // A non-streamed reply carries the whole answer in `message`.
                JsonValue full = ch.At(0).Get("message");
                if (full != null) {
                    c.Append(full.Str("content", ""));
                    r.Append(full.Str("reasoning_content", ""));
                }
            }
        }
        // A usage object (usually the final chunk) carries the real token
        // counts for the request.
        JsonValue us = v.Get("usage");
        if (us != null && us.IsObject()) {
            a.promptTokens = us.Int("prompt_tokens", a.promptTokens);
            a.completionTokens = us.Int("completion_tokens", a.completionTokens);
            a.totalTokens = us.Int("total_tokens", a.totalTokens);
            // Prompt tokens served from the provider's cache. DeepSeek reports
            // them flat as `prompt_cache_hit_tokens`, OpenAI-compatible
            // providers nest them under `prompt_tokens_details.cached_tokens`;
            // either way they are a subset of prompt_tokens, not an extra
            // charge, so they are shown as such.
            a.cachedTokens = us.Int("prompt_cache_hit_tokens", a.cachedTokens);
            JsonValue pd = us.Get("prompt_tokens_details");
            if (pd != null && pd.IsObject()) {
                a.cachedTokens = pd.Int("cached_tokens", a.cachedTokens);
            }
        }
    }

    // --- context compaction --------------------------------------------------

    // 生效服务商的限额表（模型 -> {ctx, out}，就是设置里那张表）和聊天框选中
    // 的默认模型，由面板每帧刷新。团队模式下每个成员各跑自己的模型，上下文
    // 窗口和输出上限也就各不相同，所以这里存的是「按模型查」的那张表，而不是
    // 一份被所有人共用的数字——共用那份就是「统计不对、压缩按别人的窗口算」的
    // 来源。
    static string gLimits;
    static string gChatModel;

    // 每个成员各自的压缩记录：谁的上下文被折叠过几次、最近那次折掉了几轮。
    // 一个成员因为自己的窗口小而压缩，不该显示成全队都压缩了。下标一一对应，
    // 空成员名（"" ）就是单人模式那一份。
    static List<string> gCompRoles;
    static List<int> gCompCount;
    static List<int> gCompDrop;

    static void EnsureCompRoles() {
        if (AiAgent.gCompRoles == null) {
            AiAgent.gCompRoles = new List<string>();
            AiAgent.gCompCount = new List<int>();
            AiAgent.gCompDrop = new List<int>();
        }
    }

    /// 这个成员在压缩记录里的下标；`make` 为真时没有就建一条。
    static int CompSlot(string agent, bool make) {
        AiAgent.EnsureCompRoles();
        string who = agent;
        if (who == null) { who = ""; }
        for (int i = 0; i < AiAgent.gCompRoles.Count; i = i + 1) {
            if (AiAgent.gCompRoles[i] == who) { return i; }
        }
        if (!make) { return 0 - 1; }
        AiAgent.gCompRoles.Add(who);
        AiAgent.gCompCount.Add(0);
        AiAgent.gCompDrop.Add(0);
        return AiAgent.gCompRoles.Count - 1;
    }

    static void NoteCompaction(string agent, int dropped) {
        int s = AiAgent.CompSlot(agent, true);
        AiAgent.gCompCount[s] = AiAgent.gCompCount[s] + 1;
        AiAgent.gCompDrop[s] = dropped;
    }

    /// 这个成员的上下文被折叠过几次请求，以及最近那次折掉了几轮。
    static int CompactionsOf(string agent) {
        int s = AiAgent.CompSlot(agent, false);
        if (s < 0) { return 0; }
        return AiAgent.gCompCount[s];
    }

    static int LastDroppedOf(string agent) {
        int s = AiAgent.CompSlot(agent, false);
        if (s < 0) { return 0; }
        return AiAgent.gCompDrop[s];
    }

    /// 全队一共压缩过几次（本次会话的总数）。
    static int Compactions() {
        AiAgent.EnsureCompRoles();
        int acc = 0;
        for (int i = 0; i < AiAgent.gCompCount.Count; i = i + 1) {
            acc = acc + AiAgent.gCompCount[i];
        }
        return acc;
    }

    static void ResetCompaction() {
        AiAgent.gCompRoles = new List<string>();
        AiAgent.gCompCount = new List<int>();
        AiAgent.gCompDrop = new List<int>();
        AiAgent.gCompFrom = new List<int>();
        AiAgent.gCompText = new List<string>();
    }

    // 已经定型的那份摘要：折掉了前 `gCompFrom` 轮，正文是 `gCompText`。留着它
    // 是为了让摘要**逐字节不变**：摘要在消息序列里排在最前面，改一个字就等于
    // 换掉整份前缀，它后面的每一条历史在供应商那边都要重新计费（prompt 缓存按
    // 前缀匹配），命中率于是永远归零。
    static List<int> gCompFrom;
    static List<string> gCompText;

    static void EnsureSticky() {
        AiAgent.EnsureCompRoles();
        if (AiAgent.gCompFrom == null) {
            AiAgent.gCompFrom = new List<int>();
            AiAgent.gCompText = new List<string>();
        }
        while (AiAgent.gCompFrom.Count < AiAgent.gCompRoles.Count) {
            AiAgent.gCompFrom.Add(0);
            AiAgent.gCompText.Add("");
        }
    }

    /// 这个成员已经定型的摘要折掉了前几轮（0 = 还没折过）。
    static int StickyFrom(string agent) {
        AiAgent.EnsureSticky();
        int s = AiAgent.CompSlot(agent, false);
        if (s < 0 || s >= AiAgent.gCompFrom.Count) { return 0; }
        return AiAgent.gCompFrom[s];
    }

    /// 这个成员已经定型的摘要正文（"" = 还没折过）。
    static string StickyText(string agent) {
        AiAgent.EnsureSticky();
        int s = AiAgent.CompSlot(agent, false);
        if (s < 0 || s >= AiAgent.gCompText.Count) { return ""; }
        return AiAgent.gCompText[s];
    }

    static void SetSticky(string agent, int from, string text) {
        int s = AiAgent.CompSlot(agent, true);
        AiAgent.EnsureSticky();
        AiAgent.gCompFrom[s] = from;
        AiAgent.gCompText[s] = text;
    }

    /// Records the enabled provider's per-model limits table and the model the
    /// chat box is on, so every launch can resolve the limits of the model that
    /// launch actually runs on.
    static void SetProvider(string limitsJson, string chatModel) {
        AiAgent.gLimits = limitsJson;
        AiAgent.gChatModel = chatModel;
    }

    /// 这个模型配置的上下文长度（token）；没配过就用默认。空模型名 = 聊天框
    /// 选中的那个模型（单人模式，以及没给成员单独绑模型的时候）。
    static int CtxTokensOf(string model) {
        int tok = AiAgent.LimitOf(model, "ctx");
        if (tok <= 0) { tok = AiAgent.DefaultCtxTokens(); }
        return tok;
    }

    /// 这个模型配置的最大输出长度（token）；0 表示没配（请求里不带 max_tokens）。
    static int MaxOutTokensOf(string model) {
        return AiAgent.LimitOf(model, "out");
    }

    static int LimitOf(string model, string field) {
        string m = model;
        if (m == null || m == "") { m = AiAgent.gChatModel; }
        if (m == null || m == "") { return 0; }
        if (AiAgent.gLimits == null) { return 0; }
        return ZanIDE.AiLimitInt(AiAgent.gLimits, m, field);
    }

    /// Character budget for the running transcript (everything after the system
    /// prompt). Beyond this the oldest turns are folded into a compact digest so
    /// a long agent session keeps going instead of growing until it overflows
    /// the model's context window. Derived from THAT model's configured context
    /// length (tokens ~= 4 chars) when set, else a safe default.
    static int MaxContextCharsOf(string model) {
        return AiAgent.CtxTokensOf(model) * 4;
    }

    /// Default context length (tokens) for a model with no explicit setting.
    static int DefaultCtxTokens() { return 200000; }

    /// Total characters of the running transcript -- the quantity BuildContext
    /// measures against that model's budget to decide when to compact, and what
    /// the context-usage ring shows.
    static int ContextChars(List<ChatMessage> msgs) {
        int acc = 0;
        for (int i = 0; i < msgs.Count; i = i + 1) { acc = acc + msgs[i].text.Length; }
        return acc;
    }

    /// The most recent turns are always sent verbatim, even past the budget, so
    /// the model never loses the thread it is actively working on.
    static int MinRecentTurns() { return 6; }

    static string FirstLine(string s) {
        int i = ZanIDE.IndexOfStr(s, "\n");
        if (i < 0) { return s; }
        return s.Substring(0, i);
    }

    static string Cap(string s, int n) {
        if (s.Length <= n) { return s; }
        return AiAgent.Clip(s, n) + " ...";
    }

    /// 前 `cap` 个字节，但截断点退到字符边界上。
    ///
    /// 字符串按字节索引，一个汉字占三个字节，所以 `Substring(0, 6000)` 有
    /// 三分之二的概率把某个汉字切成半个。半个字符不是合法 UTF-8，装进请求体
    /// 之后服务端整包拒收（HTTP 400 invalid unicode code point），提示词里
    /// 越靠后的内容越无辜地背锅。所以凡是按长度截提示词的地方都走这里。
    static string Clip(string s, int cap) {
        if (cap <= 0) { return ""; }
        if (s.Length <= cap) { return s; }
        int n = cap;
        // 续字节是 10xxxxxx（128..191）：落在续字节上说明切进了字符中间，
        // 往前退到这个字符的首字节为止。
        while (n > 0) {
            int b = s[n] & 255;
            if (b < 128 || b > 191) { break; }
            n = n - 1;
        }
        return s.Substring(0, n);
    }

    /// 末 `cap` 个字节，同样只在字符边界上开切（掐头留尾的场合用它）。
    static string ClipTail(string s, int cap) {
        if (cap <= 0) { return ""; }
        if (s.Length <= cap) { return s; }
        int st = s.Length - cap;
        while (st < s.Length) {
            int b = s[st] & 255;
            if (b < 128 || b > 191) { break; }
            st = st + 1;
        }
        return s.Substring(st, s.Length - st);
    }

    /// 把一段字节流洗成合法 UTF-8：非法字节换成 `?`。
    ///
    /// 请求体里只要有一个非法码点，服务端就整包 400，一整轮对话原地卡死；而
    /// 非法字节的来源不止截断——read_file 读到 GBK 存的源文件、命令输出里的
    /// 半截多字节字符，都会带进来。所以发送前统一过一遍，宁可显示成 `?` 也
    /// 不能让整个请求发不出去。
    static string SafeUtf8(string s) {
        int bad = 0;
        int i = 0;
        while (i < s.Length) {
            int need = AiAgent.SeqLen(s, i);
            if (need <= 0) { bad = bad + 1; i = i + 1; } else { i = i + need; }
        }
        if (bad == 0) { return s; }
        StringBuilder sb = new StringBuilder();
        i = 0;
        while (i < s.Length) {
            int need = AiAgent.SeqLen(s, i);
            if (need <= 0) {
                sb.Append("?");
                i = i + 1;
                continue;
            }
            sb.Append(s.Substring(i, need));
            i = i + need;
        }
        return sb.ToString();
    }

    /// 从 `i` 开始的这个 UTF-8 序列有几个字节；不是合法序列就返回 0。
    static int SeqLen(string s, int i) {
        int b = s[i] & 255;
        if (b < 128) { return 1; }
        int need = 0;
        if (b >= 194 && b <= 223) { need = 2; }
        if (b >= 224 && b <= 239) { need = 3; }
        if (b >= 240 && b <= 244) { need = 4; }
        if (need == 0) { return 0; }
        if (i + need > s.Length) { return 0; }
        for (int k = 1; k < need; k = k + 1) {
            int c = s[i + k] & 255;
            if (c < 128 || c > 191) { return 0; }
        }
        return need;
    }

    /// One line standing in for a turn that fell out of the verbatim window:
    /// the user's questions and the assistant's conclusions are kept, while a
    /// tool result collapses to its header plus first result line so the bulky
    /// file/JSON bodies do not survive into every later request.
    static string DigestTurn(ChatMessage m) {
        if (m.role == "user") {
            return "USER: " + AiAgent.Cap(AiAgent.FirstLine(m.text), 300);
        }
        if (m.role == "assistant") {
            string t = AiAgent.StripToolBlock(m.text);
            if (AiAgent.Trim(t) == "") {
                string call = AiAgent.ToolBlock(m.text);
                if (call == "") { call = AiAgent.ToolBlock(m.call); }
                return "ASSISTANT: (called " + AiAgent.Describe(call) + ")";
            }
            return "ASSISTANT: " + AiAgent.Cap(t, 400);
        }
        if (m.role == "tool") {
            string head = AiAgent.FirstLine(m.text);
            string body = "";
            if (m.text.Length > head.Length + 1) {
                body = AiAgent.FirstLine(
                    m.text.Substring(head.Length + 1, m.text.Length - head.Length - 1));
            }
            string line = "TOOL " + head;
            if (body != "") { line = line + " -> " + AiAgent.Cap(body, 200); }
            return line;
        }
        return AiAgent.Cap(AiAgent.FirstLine(m.text), 200);
    }

    /// Builds the message list actually sent to the model: recent turns kept
    /// whole, and everything older than `budget` characters replaced by a single
    /// digest message. Returns the turns unchanged when the transcript is small.
    ///
    /// `msgs` 是这个成员自己那份上下文（`AiTeam.ContextFor`），`budget` 是
    /// 它自己那个模型的窗口，`agent` 只用来把压缩记到它名下：一个成员
    /// 因为自己的窗口小而压缩，不会动到别人的上下文、也不会显示成全队都
    /// 压缩了。
    static AiMessages BuildContext(List<ChatMessage> msgs, int budget,
            string agent) {
        AiMessages m = new AiMessages();
        m.msgs = new List<ChatMessage>();
        m.compacted = false;
        m.dropped = 0;
        int n = msgs.Count;
        // 上一拍定型的那份摘要：只要它后面的尾部还放得下，就一个字都不动地
        // 复用。重算一次摘要 = 换掉整份前缀，后面每一条历史都要重新计费。
        int sticky = AiAgent.StickyFrom(agent);
        string stickyText = AiAgent.StickyText(agent);
        if (sticky > 0 && sticky <= n && stickyText != ""
                && stickyText.Length + AiAgent.TailChars(msgs, sticky)
                    <= budget) {
            m.msgs.Add(ChatMessage.Create("user", stickyText));
            for (int k = sticky; k < n; k = k + 1) { m.msgs.Add(msgs[k]); }
            m.compacted = true;
            m.dropped = sticky;
            return m;
        }
        if (sticky > n) {
            // 换了一份记录（切换/删除会话）：旧摘要说的不是这段对话了。
            AiAgent.SetSticky(agent, 0, "");
            sticky = 0;
        }
        int keepFrom = AiAgent.FoldPoint(msgs, budget);
        if (keepFrom <= 0 && sticky <= 0) {
            for (int k = 0; k < n; k = k + 1) {
                m.msgs.Add(msgs[k]);
            }
            return m;
        }
        // 重折的时候一次折到预算的一半，而不是刚好放得下：刚好放得下意味着
        // 下一拍又要重折，摘要于是每一拍都在变，缓存一次也命不中。
        int target = budget * AiAgent.CompactKeepPercent() / 100;
        int folded = AiAgent.FoldPoint(msgs, target);
        if (folded > keepFrom) { keepFrom = folded; }
        if (keepFrom <= sticky) { keepFrom = sticky; }
        if (keepFrom <= 0) { keepFrom = 1; }
        if (keepFrom > n) { keepFrom = n; }
        StringBuilder d = new StringBuilder();
        d.Append("[Earlier turns were compacted to save context; digest of the"
            + " conversation so far -- decisions, files touched and findings:]\n");
        for (int j = 0; j < keepFrom; j = j + 1) {
            d.Append(AiAgent.DigestTurn(msgs[j]) + "\n");
            if (d.Length > 6000) {
                d.Append("... (older turns elided)\n");
                break;
            }
        }
        string digest = d.ToString();
        AiAgent.SetSticky(agent, keepFrom, digest);
        m.msgs.Add(ChatMessage.Create("user", digest));
        int r = keepFrom;
        while (r < n) {
            m.msgs.Add(msgs[r]); r = r + 1;
        }
        m.compacted = true;
        m.dropped = keepFrom;
        AiAgent.NoteCompaction(agent, keepFrom);
        return m;
    }

    /// 从末尾往前累计，`limit` 个字符放得下的最早那一轮的下标（0 = 整份都
    /// 放得下）。最近 `MinRecentTurns()` 轮无论多长都保留。
    static int FoldPoint(List<ChatMessage> msgs, int limit) {
        int n = msgs.Count;
        int acc = 0;
        int from = n;
        for (int i = n - 1; i >= 0; i = i - 1) {
            acc = acc + msgs[i].text.Length;
            int kept = n - i;
            if (acc > limit && kept > AiAgent.MinRecentTurns()) { break; }
            from = i;
        }
        if (from > n) { from = n; }
        if (from < 0) { from = 0; }
        return from;
    }

    /// `from` 之后逐字发出的那部分有多少字符。
    static int TailChars(List<ChatMessage> msgs, int from) {
        int acc = 0;
        for (int i = from; i < msgs.Count; i = i + 1) {
            acc = acc + msgs[i].text.Length;
        }
        return acc;
    }

    /// 重折一次之后尾部占预算的比例：折到一半，之后好几十拍都能复用同一
    /// 份摘要（摘要不变 = 前缀不变 = 缓存还能命中）。
    static int CompactKeepPercent() { return 50; }
}

/// The message list handed to the endpoint after compaction: one entity per
/// turn, `compacted` is true when older turns were folded into a digest and
/// `dropped` counts how many raw turns that digest replaced.
class AiMessages {
    List<ChatMessage> msgs;
    bool compacted;
    int dropped;
}

/// Folds a stream INCREMENTALLY while it arrives: the live preview used to
/// call `AiAgent.ParseSse` on the whole body every time it grew, which is a
/// full JSON re-parse of everything received so far ten times a second -- the
/// cost grows with the square of the answer's length, and it is what pinned a
/// core (and made the window stutter) while a long reply streamed in.
///
/// This keeps a byte cursor into the body plus the two builders, so a frame
/// only parses the event lines that are actually new. A stream that was
/// replaced (a new question) or truncated (a retry) resets the fold: `gen` is
/// the request generation the cursor belongs to.
class SseLive {
    int gen;
    int cursor;
    StringBuilder c;
    StringBuilder r;
    /// Carries the error / usage / done fields the fold collects, so
    /// `AiAgent.FoldChunk` is reused verbatim instead of duplicated here.
    SseAnswer a;
    /// Whether `a.content` / `a.reasoning` still have to be materialised from
    /// the builders (ToString is a copy; a frame that folded nothing skips it).
    bool dirty;

    SseLive() { this.Reset(0); }

    void Reset(int g) {
        gen = g;
        cursor = 0;
        c = new StringBuilder();
        r = new StringBuilder();
        a = new SseAnswer();
        a.content = "";
        a.reasoning = "";
        a.error = "";
        a.done = false;
        a.promptTokens = 0;
        a.completionTokens = 0;
        a.totalTokens = 0;
        a.cachedTokens = 0;
        dirty = false;
    }

    /// Folds every COMPLETE event line past the cursor. A half-written tail
    /// line stays unparsed until the rest of it arrives, so no chunk is folded
    /// twice and none is dropped.
    void Feed(int g, string raw) {
        if (g != gen || raw.Length < cursor) { this.Reset(g); }
        int n = raw.Length;
        int i = cursor;
        while (i < n) {
            int nl = i;
            while (nl < n && (raw[nl] & 255) != 10) { nl = nl + 1; }
            if (nl >= n) { break; }
            int lineEnd = nl;
            if (lineEnd > i && (raw[lineEnd - 1] & 255) == 13) {
                lineEnd = lineEnd - 1;
            }
            this.FoldLine(raw.Substring(i, lineEnd - i));
            i = nl + 1;
        }
        cursor = i;
    }

    void FoldLine(string line) {
        string payload = "";
        bool isData = false;
        if (line.Length >= 6 && line.Substring(0, 6) == "data: ") {
            payload = line.Substring(6, line.Length - 6);
            isData = true;
        } else if (line.Length >= 5 && line.Substring(0, 5) == "data:") {
            payload = AiAgent.Trim(line.Substring(5, line.Length - 5));
            isData = true;
        }
        if (!isData) { return; }
        if (payload == "[DONE]") { a.done = true; return; }
        AiAgent.FoldChunk(a, c, r, JsonValue.ParseLenient(payload), payload);
        dirty = true;
    }

    void Materialise() {
        if (!dirty) { return; }
        a.content = c.ToString();
        a.reasoning = r.ToString();
        dirty = false;
    }

    /// The answer so far.
    string Content() { this.Materialise(); return a.content; }
    /// The thinking so far.
    string Reasoning() { this.Materialise(); return a.reasoning; }
}

/// A text/event-stream reply folded by `AiAgent.ParseSse`: `content` is the
/// answer so far, `reasoning` the model's thinking so far, `error` a provider
/// error message (or "") and `done` whether the terminal `[DONE]` arrived.
class SseAnswer {
    string content;
    string reasoning;
    string error;
    bool done;
    int promptTokens;
    int completionTokens;
    int totalTokens;
    /// Prompt tokens the provider served from its cache (a subset of
    /// promptTokens); 0 when the provider does not report caching.
    int cachedTokens;
}
