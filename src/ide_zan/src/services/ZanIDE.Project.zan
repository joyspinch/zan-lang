using System;
using System.IO;
using System.Diagnostics;
using System.Json;
using System.Data;
using System.Data.Sqlite;
using Platform;

// zan.proj 的读写与编译命令拼装：目标类型（控制台 / GUI / 库）、图标、
// 皮肤清单和跨平台链接参数。
partial class ZanIDE {
    // IDE 工具链交互与状态驱动契约。
    static bool IsGuiProject(string root) {
        string pj = root + "/zan.proj";
        if (!File.Exists(pj)) { return false; }
        string c = File.ReadAllText(pj);
        return ZanIDE.Has(c, "type = gui") || ZanIDE.Has(c, "type=gui");
    }

    // IDE 工具链交互与状态驱动契约。
    static bool IsGuiTarget(string root, string sourcePath) {
        // IDE 工具链交互与状态驱动契约。
        bool isGui = ZanIDE.IsGuiProject(ZanIDE.TargetRoot(root, sourcePath));
        if (!isGui && File.Exists(sourcePath)) {
            string source = File.ReadAllText(sourcePath);
            isGui = ZanIDE.Has(source, "using Gui;");
        }
        return isGui;
    }

    // IDE 工具链交互与状态驱动契约。
    static bool IsWindowedTarget(string root, string sourcePath) {
        if (ZanIDE.IsGuiTarget(root, sourcePath)) { return true; }
        if (File.Exists(sourcePath)) {
            string source = File.ReadAllText(sourcePath);
            if (ZanIDE.Has(source, "using Game.Kit;")) { return true; }
        }
        return false;
    }

    static string GuiLinkArgs(string root, string sourcePath) {
        bool isGui = ZanIDE.IsGuiTarget(root, sourcePath);
        if (!isGui) { return ""; }
        string args = " -L\"" + ZanIDE.BaseDir() + "\" -L\"" + ZanIDE.ToolchainDir() + "\""
            + " -lzan_gui -llegacy_stdio_definitions"
            + " -Xlinker /SUBSYSTEM:WINDOWS -Xlinker /ENTRY:mainCRTStartup"
            + " -Xlinker /STACK:268435456";
        return args;
    }

    // IDE 工具链交互与状态驱动契约。
    static string RtSyncArg() {
        string cand = ZanIDE.ToolchainDir() + "/zanrt_sync_ide.obj";
        if (File.Exists(cand)) { return " \"" + cand + "\""; }
        cand = ZanIDE.BaseDir() + "/zanrt_sync_ide.obj";
        if (File.Exists(cand)) { return " \"" + cand + "\""; }
        cand = ZanIDE.ToolchainDir() + "/zanrt_sync.obj";
        if (File.Exists(cand)) { return " \"" + cand + "\""; }
        cand = ZanIDE.BaseDir() + "/zanrt_sync.obj";
        if (File.Exists(cand)) { return " \"" + cand + "\""; }
        return "";
    }

    // IDE 工具链交互与状态驱动契约。
    static string CompileToExe(string root, string p, string inputs, string ll, string exe, bool publish, bool debug) {
        string pub = IdeCompileMode.Flags(publish, debug, ZanIDE.ProjStrictMemory(root));
        if (ZanIDE.ProjDenyWarnings(root)) {
            pub = pub + " --deny-warnings";
        }
        if (ZanIDE.IsLibraryProject(root)) {
            // IDE 工具链交互与状态驱动契约。
            return ZanIDE.ZancCmd() + pub + " " + inputs + " -o \"" + exe + "\"";
        }
        string sub = "";
        if (ZanIDE.IsWindowedTarget(root, p)) { sub = " --subsystem windows"; }
        return ZanIDE.ZancCmd() + pub + " " + inputs + " -o \"" + exe + "\"" + sub
            + ZanIDE.IconArg(root);
    }

    // IDE 工具链交互与状态驱动契约。
    static string CompileToExeSingleFile(string root, string p, string inputs,
                                         string ll, string exe, bool publish,
                                         bool debug) {
        return ZanIDE.CompileToExe(root, p, inputs, ll, exe, publish, debug)
            + " --link-mode static";
    }

    // IDE 工具链交互与状态驱动契约。
    static string CompileToExeCross(string root, string p, string inputs, string exe, string target, bool debug) {
        string sub = "";
        if (ZanIDE.IsWindowedTarget(root, p)) { sub = " --subsystem windows"; }
        string mode = IdeCompileMode.Flags(true, debug, false);
        if (ZanIDE.ProjDenyWarnings(root)) {
            mode = mode + " --deny-warnings";
        }
        return ZanIDE.ZancCmd() + mode + " --target " + target
            + " --link-mode static " + inputs + " -o \"" + exe + "\"" + sub
            + ZanIDE.IconArg(root);
    }

    // IDE 工具链交互与状态驱动契约。
    static string ProjField(string root, string key) {
        string proj = root + "/zan.proj";
        if (!File.Exists(proj)) { return ""; }
        List<string> ls = ZanIDE.Lines(File.ReadAllText(proj));
        for (int i = 0; i < ls.Count; i = i + 1) {
            string tr = ZanIDE.TrimLeadSpaces(ls[i]);
            if (tr.Length >= key.Length && tr.Substring(0, key.Length) == key) {
                string rest = ZanIDE.TrimLeadSpaces(tr.Substring(key.Length, tr.Length - key.Length));
                if (rest.Length > 0 && rest.Substring(0, 1) == "=") {
                    string val = ZanIDE.TrimLeadSpaces(rest.Substring(1, rest.Length - 1));
                    int e = val.Length;
                    while (e > 0) {
                        string ch = val.Substring(e - 1, 1);
                        if (ch == " " || ch == "\t" || ch == "\r" || ch == "\n") { e = e - 1; }
                        else { break; }
                    }
                    return val.Substring(0, e);
                }
            }
        }
        return "";
    }

    // IDE 工具链交互与状态驱动契约。
    static void SetProjectIcon(string root, string rel) {
        string proj = root + "/zan.proj";
        string content = "";
        if (File.Exists(proj)) { content = File.ReadAllText(proj); }
        List<string> ls = ZanIDE.Lines(content);
        string outp = "";
        for (int i = 0; i < ls.Count; i = i + 1) {
            string ln = ls[i];
            string tr = ZanIDE.TrimLeadSpaces(ln);
            if (tr.Length >= 4 && tr.Substring(0, 4) == "icon") {
                // IDE 工具链交互与状态驱动契约。
            } else if (tr.Length > 0) {
                outp = outp + ln + "\n";
            }
        }
        outp = outp + "icon = " + rel + "\n";
        File.WriteAllText(proj, outp);
    }

    // IDE 工具链交互与状态驱动契约。
    // 核心契约与语义定义。
    static void SetProjField(string root, string key, string val) {
        string proj = root + "/zan.proj";
        string content = "";
        if (File.Exists(proj)) { content = File.ReadAllText(proj); }
        List<string> ls = ZanIDE.Lines(content);
        string outp = "";
        for (int i = 0; i < ls.Count; i = i + 1) {
            string ln = ls[i];
            string tr = ZanIDE.TrimLeadSpaces(ln);
            bool isKey = false;
            if (tr.Length >= key.Length && tr.Substring(0, key.Length) == key) {
                string rest = ZanIDE.TrimLeadSpaces(tr.Substring(key.Length, tr.Length - key.Length));
                if (rest.Length > 0 && rest.Substring(0, 1) == "=") { isKey = true; }
            }
            if (isKey) {
                // IDE 工具链交互与状态驱动契约。
            } else if (tr.Length > 0) {
                outp = outp + ln + "\n";
            }
        }
        outp = outp + key + " = " + val + "\n";
        File.WriteAllText(proj, outp);
    }

    // IDE 工具链交互与状态驱动契约。
    // 核心契约与语义定义。
    static bool ProjSingleFile(string root) {
        return ZanIDE.ProjField(root, "singleFile") != "false";
    }

    // IDE 工具链交互与状态驱动契约。
    static bool ProjPublishDebug(string root) {
        return ZanIDE.ProjField(root, "pubDebug") == "true";
    }

    // IDE 工具链交互与状态驱动契约。
    static bool ProjMacMultiInstance(string root) {
        string v = ZanIDE.ProjField(root, "macMultiInstance");
        return v == "true" || v == "1";
    }

    // IDE 工具链交互与状态驱动契约。
    static string ProjPreBuild(string root) {
        return ZanIDE.ProjField(root, "preBuild");
    }

    // IDE 工具链交互与状态驱动契约。
    static string ProjPrePublish(string root) {
        string pub = ZanIDE.ProjField(root, "prePublish");
        if (pub != "") { return pub; }
        return ZanIDE.ProjField(root, "preBuild");
    }

    // IDE 工具链交互与状态驱动契约。
    static bool ProjStrictMemory(string root) {
        return ZanIDE.ProjField(root, "strictMemory") == "1";
    }

    // IDE 工具链交互与状态驱动契约。
    // 核心契约与语义定义。
    static bool ProjDenyWarnings(string root) {
        return ZanIDE.ProjField(root, "denyWarnings") == "1";
    }

    // IDE 工具链交互与状态驱动契约。
    // 核心契约与语义定义。
    static bool ProjSkinsEnabled(string root) {
        return ZanIDE.ProjField(root, "skins") == "1";
    }

    // IDE 工具链交互与状态驱动契约。
    static List<string> AvailableSkinNames() {
        List<string> names = new List<string>();
        string dir = ZanIDE.StdlibDir() + "/Gui/skins";
        if (!Directory.Exists(dir)) { return names; }
        List<string> subs = Directory.GetDirectories(dir);
        for (int i = 0; i < subs.Count; i = i + 1) { names.Add(subs[i]); }
        return names;
    }

    // IDE 工具链交互与状态驱动契约。
    static List<string> ProjSkinList(string root) {
        List<string> outp = ZanIDE.ProjCsvItems(ZanIDE.ProjField(root, "skinlist"));
        if (outp.Count == 0) {
            outp.Add("dark");
            outp.Add("light");
        }
        return outp;
    }

    // IDE 工具链交互与状态驱动契约。
    // 核心契约与执行状态转移规范。
    static List<string> ProjContentDirs(string root) {
        List<string> outp = new List<string>();
        string raw = ZanIDE.ProjField(root, "content");
        if (raw == "-") { return outp; }
        if (raw == "") {
            List<string> conv = new List<string>();
            conv.Add("config");
            conv.Add("views");
            conv.Add("wwwroot");
            for (int i = 0; i < conv.Count; i = i + 1) {
                if (Directory.Exists(root + "/" + conv[i])) { outp.Add(conv[i]); }
            }
            return outp;
        }
        return ZanIDE.ProjCsvItems(raw);
    }

    // IDE 工具链交互与状态驱动契约。
    static List<string> ProjCsvItems(string raw) {
        List<string> outp = new List<string>();
        int start = 0;
        for (int i = 0; i <= raw.Length; i = i + 1) {
            if (i == raw.Length || raw.Substring(i, 1) == ",") {
                string tok = ZanIDE.TrimLeadSpaces(raw.Substring(start, i - start));
                int e = tok.Length;
                while (e > 0) {
                    string ch = tok.Substring(e - 1, 1);
                    if (ch == " " || ch == "\t") { e = e - 1; } else { break; }
                }
                tok = tok.Substring(0, e);
                if (tok != "") { outp.Add(tok); }
                start = i + 1;
            }
        }
        return outp;
    }

    // IDE 工具链交互与状态驱动契约。
    static string NormRel(string rel) {
        StringBuilder sb = new StringBuilder();
        for (int i = 0; i < rel.Length; i = i + 1) {
            string ch = rel.Substring(i, 1);
            if (ch == "\\") { ch = "/"; }
            sb.Append(ch);
        }
        string s = sb.ToString();
        while (s.Length >= 2 && s.Substring(0, 2) == "./") {
            s = s.Substring(2, s.Length - 2);
        }
        while (s.Length > 0 && s.Substring(s.Length - 1, 1) == "/") {
            s = s.Substring(0, s.Length - 1);
        }
        while (s.Length > 0 && s.Substring(0, 1) == "/") {
            s = s.Substring(1, s.Length - 1);
        }
        return s;
    }

    // IDE 工具链交互与状态驱动契约。
    static List<string> ProjGenList(string root, string action) {
        List<string> outp = new List<string>();
        List<string> raw = ZanIDE.ProjCsvItems(ZanIDE.ProjField(root, "gen." + action));
        for (int i = 0; i < raw.Count; i = i + 1) {
            string p = ZanIDE.NormRel(raw[i]);
            if (p != "") { outp.Add(p); }
        }
        return outp;
    }

    // IDE 工具链交互与状态驱动契约。
    static string ProjGenRule(string root, string rel) {
        string p = ZanIDE.NormRel(rel);
        if (p == "") { return ""; }
        List<string> acts = ZanIDE.GenActions();
        for (int a = 0; a < acts.Count; a = a + 1) {
            List<string> items = ZanIDE.ProjGenList(root, acts[a]);
            for (int i = 0; i < items.Count; i = i + 1) {
                if (items[i] == p) { return acts[a]; }
            }
        }
        return "";
    }

    // IDE 工具链交互与状态驱动契约。
    static List<string> GenActions() {
        List<string> acts = new List<string>();
        acts.Add("copy");
        acts.Add("embed");
        acts.Add("none");
        return acts;
    }

    // IDE 工具链交互与状态驱动契约。
    // 核心契约与语义定义。
    static string ProjGenAction(string root, string rel) {
        string p = ZanIDE.NormRel(rel);
        string q = p;
        while (p != "") {
            string r = ZanIDE.ProjGenRule(root, p);
            if (r != "") { return r; }
            int cut = 0 - 1;
            for (int i = 0; i < p.Length; i = i + 1) {
                if (p.Substring(i, 1) == "/") { cut = i; }
            }
            if (cut < 0) { break; }
            p = p.Substring(0, cut);
        }
        List<string> def = ZanIDE.ProjContentDirs(root);
        for (int i = 0; i < def.Count; i = i + 1) {
            string d = ZanIDE.NormRel(def[i]);
            if (q == d) { return "copy"; }
            if (q.Length > d.Length + 1
                && q.Substring(0, d.Length + 1) == d + "/") { return "copy"; }
        }
        return "none";
    }

    // IDE 工具链交互与状态驱动契约。
    static void SetProjGenAction(string root, string rel, string action) {
        string p = ZanIDE.NormRel(rel);
        if (p == "") { return; }
        List<string> acts = ZanIDE.GenActions();
        for (int a = 0; a < acts.Count; a = a + 1) {
            List<string> items = ZanIDE.ProjGenList(root, acts[a]);
            string joined = "";
            for (int i = 0; i < items.Count; i = i + 1) {
                if (items[i] == p) { continue; }
                if (joined != "") { joined = joined + ","; }
                joined = joined + items[i];
            }
            if (acts[a] == action) {
                if (joined != "") { joined = joined + ","; }
                joined = joined + p;
            }
            ZanIDE.SetProjField(root, "gen." + acts[a], joined);
        }
    }

    // IDE 工具链交互与状态驱动契约。
    // 核心契约与执行状态转移规范。
    static List<string> ProjCopyItems(string root) {
        List<string> outp = ZanIDE.ProjGenList(root, "copy");
        List<string> def = ZanIDE.ProjContentDirs(root);
        for (int i = 0; i < def.Count; i = i + 1) {
            string d = ZanIDE.NormRel(def[i]);
            if (d == "") { continue; }
            if (ZanIDE.ProjGenRule(root, d) != "") { continue; }
            bool seen = false;
            for (int k = 0; k < outp.Count; k = k + 1) {
                if (outp[k] == d) { seen = true; break; }
            }
            if (!seen) { outp.Add(d); }
        }
        return outp;
    }

    // IDE 工具链交互与状态驱动契约。
    static List<string> ProjEmbedItems(string root) {
        return ZanIDE.ProjGenList(root, "embed");
    }

    // IDE 工具链交互与状态驱动契约。
    // 核心契约与语义定义。
    static bool GenTreeHasRules(string root, string rel) {
        string dir = root + "/" + rel;
        List<string> fs = Directory.GetFiles(dir);
        for (int i = 0; i < fs.Count; i = i + 1) {
            if (ZanIDE.ProjGenRule(root, rel + "/" + fs[i]) != "") { return true; }
        }
        List<string> ds = Directory.GetDirectories(dir);
        for (int i = 0; i < ds.Count; i = i + 1) {
            string sub = rel + "/" + ds[i];
            if (ZanIDE.ProjGenRule(root, sub) != "") { return true; }
            if (ZanIDE.GenTreeHasRules(root, sub)) { return true; }
        }
        return false;
    }

    // IDE 工具链交互与状态驱动契约。
    static void GenCollectFiles(string root, string rel, List<string> outp) {
        string dir = root + "/" + rel;
        List<string> fs = Directory.GetFiles(dir);
        for (int i = 0; i < fs.Count; i = i + 1) {
            string f = rel + "/" + fs[i];
            if (ZanIDE.ProjGenRule(root, f) != "") { continue; }
            outp.Add(f);
        }
        List<string> ds = Directory.GetDirectories(dir);
        for (int i = 0; i < ds.Count; i = i + 1) {
            string sub = rel + "/" + ds[i];
            if (ZanIDE.ProjGenRule(root, sub) != "") { continue; }
            ZanIDE.GenCollectFiles(root, sub, outp);
        }
    }

    // IDE 工具链交互与状态驱动契约。
    // parts of one.
    static string EmbedArgs(string root) {
        List<string> items = ZanIDE.ProjEmbedItems(root);
        string s = "";
        for (int i = 0; i < items.Count; i = i + 1) {
            string rel = items[i];
            string src = root + "/" + rel;
            if (Directory.Exists(src)) {
                if (!ZanIDE.GenTreeHasRules(root, rel)) {
                    s = s + " --embed \"" + src + "=" + rel + "\"";
                } else {
                    List<string> fs = new List<string>();
                    ZanIDE.GenCollectFiles(root, rel, fs);
                    for (int k = 0; k < fs.Count; k = k + 1) {
                        s = s + " --embed \"" + root + "/" + fs[k]
                            + "=" + fs[k] + "\"";
                    }
                }
            } else if (File.Exists(src)) {
                s = s + " --embed \"" + src + "=" + rel + "\"";
            }
        }
        return s;
    }

    // IDE 工具链交互与状态驱动契约。
    // 核心契约与执行状态转移规范。
    static bool IsLibraryProject(string root) {
        string t = ZanIDE.ProjField(root, "target");
        if (t == "dll" || t == "lib" || t == "so" || t == "dylib" || t == "a") {
            return true;
        }
        return ZanIDE.ProjField(root, "type") == "library";
    }

    // IDE 工具链交互与状态驱动契约。
    static string HostLibExt() {
        #if WINDOWS
        return ".dll";
        #elif MACOS
        return ".dylib";
        #else
        return ".so";
        #endif
    }

    // IDE 工具链交互与状态驱动契约。
    // 核心契约与语义定义。
    static string LibExtFor(string id) {
        if (ZanIDE.StartsWith(id, "windows")) { return ".dll"; }
        if (ZanIDE.StartsWith(id, "macos")) { return ".dylib"; }
        return ".so";
    }

    // IDE 工具链交互与状态驱动契约。
    // 核心契约与语义定义。
    static string StaticLibExtFor(string id) {
        if (ZanIDE.StartsWith(id, "windows")) { return ".lib"; }
        return ".a";
    }

    // IDE 工具链交互与状态驱动契约。
    // 核心契约与语义定义。
    static bool ProjStaticLib(string root) {
        return ZanIDE.ProjField(root, "staticLib") == "true";
    }

    // IDE 工具链交互与状态驱动契约。
    static string IconFile(string root) {
        string rel = ZanIDE.ProjField(root, "icon");
        if (rel != "") {
            string ico = root + "/" + rel;
            if (File.Exists(ico)) { return ico; }
        }
        string a = ZanIDE.AssetsDir(root) + "/app.ico";
        if (File.Exists(a)) { return a; }
        return ZanIDE.ZanIconSource();
    }

    // IDE 工具链交互与状态驱动契约。
    static string IconArg(string root) {
        string f = ZanIDE.IconFile(root);
        if (f == "") { return ""; }
        return " --icon \"" + f + "\"";
    }
}
