using System;
using System.IO;
using System.Diagnostics;
using System.Json;
using System.Data;
using System.Data.Sqlite;
using Platform;

/// zan.proj 的读写与编译命令拼装：目标类型（控制台 / GUI / 库）、图标、
/// 皮肤清单和跨平台链接参数。
partial class ZanIDE {
    /// True when the project at `root` targets the GUI runtime (zan.proj
    /// `type = gui`). GUI apps must link the native GUI runtime and use the
    /// borderless-window entry, whereas console apps link with the defaults.
    static bool IsGuiProject(string root) {
        string pj = root + "/zan.proj";
        if (!File.Exists(pj)) { return false; }
        string c = File.ReadAllText(pj);
        return ZanIDE.Has(c, "type = gui") || ZanIDE.Has(c, "type=gui");
    }

    /// Extra clang link arguments for GUI projects: the native GUI runtime
    /// (zan_gui.lib, shipped next to the IDE and under toolchain\), the stdio
    /// shim sprintf resolves against, and the windowed subsystem/entry the GUI
    /// runtime expects. Returns "" for console projects (link with defaults).
    static bool IsGuiTarget(string root, string sourcePath) {
        // The manifest that decides this is the one of the project the SOURCE
        // belongs to, not of whichever project the IDE has open: running an
        // example while a GUI project was open linked it for the windowed
        // subsystem (no console, no output), and vice versa.
        bool isGui = ZanIDE.IsGuiProject(ZanIDE.TargetRoot(root, sourcePath));
        if (!isGui && File.Exists(sourcePath)) {
            string source = File.ReadAllText(sourcePath);
            isGui = ZanIDE.Has(source, "using Gui;");
        }
        return isGui;
    }

    /// True when the program opens its own window: a GUI-runtime app, or a game
    /// on SDL3/Game.Kit. Such a target is linked for the windowed subsystem and
    /// started detached, i.e. without a console attached to it.
    static bool IsWindowedTarget(string root, string sourcePath) {
        if (ZanIDE.IsGuiTarget(root, sourcePath)) { return true; }
        if (File.Exists(sourcePath)) {
            string source = File.ReadAllText(sourcePath);
            if (ZanIDE.Has(source, "using SDL3;")) { return true; }
            if (ZanIDE.Has(source, "using Game.Kit;")) { return true; }
        }
        return false;
    }

    static string GuiLinkArgs(string root, string sourcePath) {
        bool isGui = ZanIDE.IsGuiTarget(root, sourcePath);
        if (!isGui) { return ""; }
        string args = " -L\"" + ZanIDE.BaseDir() + "\" -L\"" + ZanIDE.ToolchainDir() + "\""
            + " -lzan_gui -llegacy_stdio_definitions"
            + " -Xlinker /SUBSYSTEM:WINDOWS -Xlinker /ENTRY:mainCRTStartup"
            + " -Xlinker /STACK:268435456";
        return args;
    }

    /// Extra link input for programs that use the synchronization runtime
    /// (Thread.Start / AtomicInt / SharedTable / Dispatcher). Those symbols
    /// (zan_thread_start / zan_atomic_int_* / zan_shared_table_* /
    /// zan_dispatch_*) live in the prebuilt zanrt_sync object rather than the
    /// emitted IR, so the IDE's `clang <ir>.ll` step must link it explicitly.
    /// Prefer the MSVC-target object (zanrt_sync_ide.obj) since the IDE links
    /// against clang's default MSVC target; the GNU-target zanrt_sync.obj pulls
    /// in __mingw_* and won't resolve. Returns "" when no object is present so
    /// ordinary programs still link unchanged. The object only references
    /// kernel32 (threads / mutexes / file mappings), so linking it into a
    /// program that doesn't call it is harmless dead code.
    static string RtSyncArg() {
        string cand = ZanIDE.ToolchainDir() + "/zanrt_sync_ide.obj";
        if (File.Exists(cand)) { return " \"" + cand + "\""; }
        cand = ZanIDE.BaseDir() + "/zanrt_sync_ide.obj";
        if (File.Exists(cand)) { return " \"" + cand + "\""; }
        cand = ZanIDE.ToolchainDir() + "/zanrt_sync.obj";
        if (File.Exists(cand)) { return " \"" + cand + "\""; }
        cand = ZanIDE.BaseDir() + "/zanrt_sync.obj";
        if (File.Exists(cand)) { return " \"" + cand + "\""; }
        return "";
    }

    /// Compiler flags for the Debug publish mode: DWARF and -O0 (so a crash in
    /// the published program resolves to .zan:line) but explicitly WITHOUT the
    /// ARC diagnostics `-g` turns on by itself. `--arc-guard` never returns a
    /// freed object to the allocator, so a published server grew its RSS with
    /// every request until an allocation failed -- which surfaced as a SIGSEGV
    /// at a tiny address inside a buffer write, not as a leak. Diagnostics of
    /// that shape belong to a debug RUN, not to a deployed artifact.
    static string PublishDebugFlags() {
        return " -g --no-arc-guard --no-check-leaks";
    }

    /// Produces `exe` from `inputs` through zanc's OWN bundled linker (the GNU
    /// ld shipped in toolchain\), so Build/Run/Debug/Publish need no external
    /// clang or LLVM on the machine -- the IDE is as self-contained as the CLI
    /// (verified with clang/gcc/ld off PATH). GUI targets add --subsystem
    /// windows; the native GUI runtime is auto-bundled by zanc as the `zan_gui`
    /// stdlib driver (stdlib\Gui\drivers), copied next to the exe. `ll` is
    /// retained for signature stability but no longer used. Mode flags:
    /// `publish` adds --publish (optimize + strip, the Release mode); `debug`
    /// adds PublishDebugFlags() instead (DWARF + -O0, keeping runtime checks and
    /// source-line crash locations for the Debug publish mode). `debug` wins
    /// over `publish` when both are set.
    static string CompileToExe(string root, string p, string inputs, string ll, string exe, bool publish, bool debug) {
        string pub = "";
        if (debug) { pub = ZanIDE.PublishDebugFlags(); }
        else if (publish) { pub = " --publish"; }
        if (ZanIDE.IsLibraryProject(root)) {
            // A library has no subsystem or icon; zanc picks the library
            // format (shared/static) from the -o extension.
            return ZanIDE.ZancCmd() + pub + " " + inputs + " -o \"" + exe + "\"";
        }
        string sub = "";
        if (ZanIDE.IsWindowedTarget(root, p)) { sub = " --subsystem windows"; }
        return ZanIDE.ZancCmd() + pub + " " + inputs + " -o \"" + exe + "\"" + sub
            + ZanIDE.IconArg(root);
    }

    /// Windows x64 single-file publish: embed project payloads and statically
    /// link the native drivers that have static archives. Drivers that are
    /// dlopen'd (CEF/WebView2) remain runtime bundles beside the exe.
    static string CompileToExeSingleFile(string root, string p, string inputs,
                                         string ll, string exe, bool publish,
                                         bool debug) {
        return ZanIDE.CompileToExe(root, p, inputs, ll, exe, publish, debug)
            + " --link-mode static";
    }

    /// Like CompileToExe but cross-compiles for an explicit `--target` (e.g.
    /// win-arm64) through zanc's OWN bundled toolchain, so publishing needs no
    /// external clang/LLVM. Statically links the native driver so the cross
    /// output stays a single self-contained file. `debug` swaps --publish for
    /// PublishDebugFlags() (Debug publish mode: DWARF + -O0 + runtime checks).
    static string CompileToExeCross(string root, string p, string inputs, string exe, string target, bool debug) {
        string sub = "";
        if (ZanIDE.IsWindowedTarget(root, p)) { sub = " --subsystem windows"; }
        string mode = " --publish";
        if (debug) { mode = ZanIDE.PublishDebugFlags(); }
        return ZanIDE.ZancCmd() + mode + " --target " + target
            + " --link-mode static " + inputs + " -o \"" + exe + "\"" + sub
            + ZanIDE.IconArg(root);
    }

    /// Reads a `key = value` field from the project's zan.proj, or "" if absent.
    static string ProjField(string root, string key) {
        string proj = root + "/zan.proj";
        if (!File.Exists(proj)) { return ""; }
        List<string> ls = ZanIDE.Lines(File.ReadAllText(proj));
        for (int i = 0; i < ls.Count; i = i + 1) {
            string tr = ZanIDE.TrimLeadSpaces(ls[i]);
            if (tr.Length >= key.Length && tr.Substring(0, key.Length) == key) {
                string rest = ZanIDE.TrimLeadSpaces(tr.Substring(key.Length, tr.Length - key.Length));
                if (rest.Length > 0 && rest.Substring(0, 1) == "=") {
                    string val = ZanIDE.TrimLeadSpaces(rest.Substring(1, rest.Length - 1));
                    int e = val.Length;
                    while (e > 0) {
                        string ch = val.Substring(e - 1, 1);
                        if (ch == " " || ch == "\t" || ch == "\r" || ch == "\n") { e = e - 1; }
                        else { break; }
                    }
                    return val.Substring(0, e);
                }
            }
        }
        return "";
    }

    /// Writes/updates the project icon path (relative to the project root) in
    /// zan.proj, dropping any prior `icon =` line so it stays single-valued.
    static void SetProjectIcon(string root, string rel) {
        string proj = root + "/zan.proj";
        string content = "";
        if (File.Exists(proj)) { content = File.ReadAllText(proj); }
        List<string> ls = ZanIDE.Lines(content);
        string outp = "";
        for (int i = 0; i < ls.Count; i = i + 1) {
            string ln = ls[i];
            string tr = ZanIDE.TrimLeadSpaces(ln);
            if (tr.Length >= 4 && tr.Substring(0, 4) == "icon") {
                // drop the previous icon line; the new one is appended below
            } else if (tr.Length > 0) {
                outp = outp + ln + "\n";
            }
        }
        outp = outp + "icon = " + rel + "\n";
        File.WriteAllText(proj, outp);
    }

    /// Writes/updates a `key = value` field in zan.proj (dropping any prior line
    /// for that key so it stays single-valued). Used for project settings edited
    /// through the IDE, e.g. `singleFile`.
    static void SetProjField(string root, string key, string val) {
        string proj = root + "/zan.proj";
        string content = "";
        if (File.Exists(proj)) { content = File.ReadAllText(proj); }
        List<string> ls = ZanIDE.Lines(content);
        string outp = "";
        for (int i = 0; i < ls.Count; i = i + 1) {
            string ln = ls[i];
            string tr = ZanIDE.TrimLeadSpaces(ln);
            bool isKey = false;
            if (tr.Length >= key.Length && tr.Substring(0, key.Length) == key) {
                string rest = ZanIDE.TrimLeadSpaces(tr.Substring(key.Length, tr.Length - key.Length));
                if (rest.Length > 0 && rest.Substring(0, 1) == "=") { isKey = true; }
            }
            if (isKey) {
                // drop the previous line; the new one is appended below
            } else if (tr.Length > 0) {
                outp = outp + ln + "\n";
            }
        }
        outp = outp + key + " = " + val + "\n";
        File.WriteAllText(proj, outp);
    }

    /// Project setting: publish Windows as ONE executable -- the resources are
    /// baked in with zanc --embed and read from the exe's own image, and the
    /// native drivers are linked statically. Nothing is unpacked to a cache
    /// directory and run from there. Defaults to true unless zan.proj
    /// explicitly sets `singleFile = false`.
    static bool ProjSingleFile(string root) {
        return ZanIDE.ProjField(root, "singleFile") != "false";
    }

    /// Project setting: publish in Debug mode (zanc -g -- DWARF + -O0, runtime
    /// checks kept, crash logs resolve to .zan:line) instead of the default
    /// Release mode (--publish, optimize + strip). Off by default so shipped
    /// builds stay optimized unless zan.proj sets `pubDebug = true`.
    static bool ProjPublishDebug(string root) {
        return ZanIDE.ProjField(root, "pubDebug") == "true";
    }

    /// Project setting: the baseline base.css + dark + light always ship with
    /// a published GUI app; this switch controls whether additional skin packs
    /// from skinlist are bundled too.
    static bool ProjSkinsEnabled(string root) {
        return ZanIDE.ProjField(root, "skins") == "1";
    }

    /// The skin packs available to bundle: the directory names under the shipped
    /// stdlib Gui/skins folder (base.css and other loose files are not dirs).
    static List<string> AvailableSkinNames() {
        List<string> names = new List<string>();
        string dir = ZanIDE.StdlibDir() + "/Gui/skins";
        if (!Directory.Exists(dir)) { return names; }
        List<string> subs = Directory.GetDirectories(dir);
        for (int i = 0; i < subs.Count; i = i + 1) { names.Add(subs[i]); }
        return names;
    }

    /// The skins the project chose to bundle (zan.proj `skinlist = a,b,c`).
    /// When packaging is on but nothing was saved yet, defaults to dark + light
    /// so the picker still has something to switch between.
    static List<string> ProjSkinList(string root) {
        List<string> outp = ZanIDE.ProjCsvItems(ZanIDE.ProjField(root, "skinlist"));
        if (outp.Count == 0) {
            outp.Add("dark");
            outp.Add("light");
        }
        return outp;
    }

    /// Runtime content directories: the folders a published program must find
    /// next to its executable to run at all -- a server's config/, its views/
    /// and wwwroot/. `content = a,b,c` in zan.proj names them explicitly;
    /// with no such line the conventional three are shipped when they exist,
    /// which is what makes a published server read its own config/app.json
    /// instead of silently starting on the built-in defaults. `content = -`
    /// ships nothing.
    static List<string> ProjContentDirs(string root) {
        List<string> outp = new List<string>();
        string raw = ZanIDE.ProjField(root, "content");
        if (raw == "-") { return outp; }
        if (raw == "") {
            List<string> conv = new List<string>();
            conv.Add("config");
            conv.Add("views");
            conv.Add("wwwroot");
            for (int i = 0; i < conv.Count; i = i + 1) {
                if (Directory.Exists(root + "/" + conv[i])) { outp.Add(conv[i]); }
            }
            return outp;
        }
        return ZanIDE.ProjCsvItems(raw);
    }

    /// Splits a `a, b, c` project field into trimmed, non-empty items.
    static List<string> ProjCsvItems(string raw) {
        List<string> outp = new List<string>();
        int start = 0;
        for (int i = 0; i <= raw.Length; i = i + 1) {
            if (i == raw.Length || raw.Substring(i, 1) == ",") {
                string tok = ZanIDE.TrimLeadSpaces(raw.Substring(start, i - start));
                int e = tok.Length;
                while (e > 0) {
                    string ch = tok.Substring(e - 1, 1);
                    if (ch == " " || ch == "\t") { e = e - 1; } else { break; }
                }
                tok = tok.Substring(0, e);
                if (tok != "") { outp.Add(tok); }
                start = i + 1;
            }
        }
        return outp;
    }

    /// Normalizes a project-relative path for rule matching: backslashes to
    /// '/', no "./" prefix, no trailing '/'. The tree, zan.proj and the
    /// compiler's --embed names must agree on one spelling or a rule saved
    /// from the tree would never match the item it was saved for.
    static string NormRel(string rel) {
        StringBuilder sb = new StringBuilder();
        for (int i = 0; i < rel.Length; i = i + 1) {
            string ch = rel.Substring(i, 1);
            if (ch == "\\") { ch = "/"; }
            sb.Append(ch);
        }
        string s = sb.ToString();
        while (s.Length >= 2 && s.Substring(0, 2) == "./") {
            s = s.Substring(2, s.Length - 2);
        }
        while (s.Length > 0 && s.Substring(s.Length - 1, 1) == "/") {
            s = s.Substring(0, s.Length - 1);
        }
        while (s.Length > 0 && s.Substring(0, 1) == "/") {
            s = s.Substring(1, s.Length - 1);
        }
        return s;
    }

    /// The paths a project marked with one generation action, from zan.proj's
    /// `gen.copy` / `gen.embed` / `gen.none` lines.
    static List<string> ProjGenList(string root, string action) {
        List<string> outp = new List<string>();
        List<string> raw = ZanIDE.ProjCsvItems(ZanIDE.ProjField(root, "gen." + action));
        for (int i = 0; i < raw.Count; i = i + 1) {
            string p = ZanIDE.NormRel(raw[i]);
            if (p != "") { outp.Add(p); }
        }
        return outp;
    }

    /// The generation action recorded for exactly this path: "copy", "embed",
    /// "none", or "" when the item was never given one (it then inherits from
    /// its folder, or falls back to the convention -- see ProjGenAction).
    static string ProjGenRule(string root, string rel) {
        string p = ZanIDE.NormRel(rel);
        if (p == "") { return ""; }
        List<string> acts = ZanIDE.GenActions();
        for (int a = 0; a < acts.Count; a = a + 1) {
            List<string> items = ZanIDE.ProjGenList(root, acts[a]);
            for (int i = 0; i < items.Count; i = i + 1) {
                if (items[i] == p) { return acts[a]; }
            }
        }
        return "";
    }

    /// The three generation actions, in the order rules are looked up.
    static List<string> GenActions() {
        List<string> acts = new List<string>();
        acts.Add("copy");
        acts.Add("embed");
        acts.Add("none");
        return acts;
    }

    /// What publishing actually does with `rel`: its own rule if it has one,
    /// otherwise the nearest parent folder's rule, otherwise the convention
    /// (config/, views/, wwwroot/ are copied -- see ProjContentDirs), and
    /// "none" for everything else.
    static string ProjGenAction(string root, string rel) {
        string p = ZanIDE.NormRel(rel);
        string q = p;
        while (p != "") {
            string r = ZanIDE.ProjGenRule(root, p);
            if (r != "") { return r; }
            int cut = 0 - 1;
            for (int i = 0; i < p.Length; i = i + 1) {
                if (p.Substring(i, 1) == "/") { cut = i; }
            }
            if (cut < 0) { break; }
            p = p.Substring(0, cut);
        }
        List<string> def = ZanIDE.ProjContentDirs(root);
        for (int i = 0; i < def.Count; i = i + 1) {
            string d = ZanIDE.NormRel(def[i]);
            if (q == d) { return "copy"; }
            if (q.Length > d.Length + 1
                && q.Substring(0, d.Length + 1) == d + "/") { return "copy"; }
        }
        return "none";
    }

    /// Records (or clears) the generation action for one file or folder.
    /// Choosing the action an item already has by convention still writes the
    /// rule, so the choice survives a later change to the conventions.
    static void SetProjGenAction(string root, string rel, string action) {
        string p = ZanIDE.NormRel(rel);
        if (p == "") { return; }
        List<string> acts = ZanIDE.GenActions();
        for (int a = 0; a < acts.Count; a = a + 1) {
            List<string> items = ZanIDE.ProjGenList(root, acts[a]);
            string joined = "";
            for (int i = 0; i < items.Count; i = i + 1) {
                if (items[i] == p) { continue; }
                if (joined != "") { joined = joined + ","; }
                joined = joined + items[i];
            }
            if (acts[a] == action) {
                if (joined != "") { joined = joined + ","; }
                joined = joined + p;
            }
            ZanIDE.SetProjField(root, "gen." + acts[a], joined);
        }
    }

    /// The items a publish copies next to the executable: everything marked
    /// "copy", plus the conventional content folders that were not given some
    /// other action.
    static List<string> ProjCopyItems(string root) {
        List<string> outp = ZanIDE.ProjGenList(root, "copy");
        List<string> def = ZanIDE.ProjContentDirs(root);
        for (int i = 0; i < def.Count; i = i + 1) {
            string d = ZanIDE.NormRel(def[i]);
            if (d == "") { continue; }
            if (ZanIDE.ProjGenRule(root, d) != "") { continue; }
            bool seen = false;
            for (int k = 0; k < outp.Count; k = k + 1) {
                if (outp[k] == d) { seen = true; break; }
            }
            if (!seen) { outp.Add(d); }
        }
        return outp;
    }

    /// The items a publish compiles into the executable itself.
    static List<string> ProjEmbedItems(string root) {
        return ZanIDE.ProjGenList(root, "embed");
    }

    /// True when something inside `rel` was given an action of its own, so the
    /// folder cannot go in as a single --embed spec.
    static bool GenTreeHasRules(string root, string rel) {
        string dir = root + "/" + rel;
        List<string> fs = Directory.GetFiles(dir);
        for (int i = 0; i < fs.Count; i = i + 1) {
            if (ZanIDE.ProjGenRule(root, rel + "/" + fs[i]) != "") { return true; }
        }
        List<string> ds = Directory.GetDirectories(dir);
        for (int i = 0; i < ds.Count; i = i + 1) {
            string sub = rel + "/" + ds[i];
            if (ZanIDE.ProjGenRule(root, sub) != "") { return true; }
            if (ZanIDE.GenTreeHasRules(root, sub)) { return true; }
        }
        return false;
    }

    /// Collects the project-relative files below `rel` that still belong to
    /// `rel`'s action -- anything given an action of its own is left out.
    static void GenCollectFiles(string root, string rel, List<string> outp) {
        string dir = root + "/" + rel;
        List<string> fs = Directory.GetFiles(dir);
        for (int i = 0; i < fs.Count; i = i + 1) {
            string f = rel + "/" + fs[i];
            if (ZanIDE.ProjGenRule(root, f) != "") { continue; }
            outp.Add(f);
        }
        List<string> ds = Directory.GetDirectories(dir);
        for (int i = 0; i < ds.Count; i = i + 1) {
            string sub = rel + "/" + ds[i];
            if (ZanIDE.ProjGenRule(root, sub) != "") { continue; }
            ZanIDE.GenCollectFiles(root, sub, outp);
        }
    }

    /// zanc `--embed path=name` arguments for the items marked "embed": the
    /// program then reads them through the ordinary File / Directory calls
    /// (disk first, embedded copy as the fallback), so config/app.json keeps
    /// working with no code change. A folder goes in as one spec unless
    /// something below it has its own action, in which case each kept file is
    /// named individually -- the compiler embeds whole folders and cannot skip
    /// parts of one.
    static string EmbedArgs(string root) {
        List<string> items = ZanIDE.ProjEmbedItems(root);
        string s = "";
        for (int i = 0; i < items.Count; i = i + 1) {
            string rel = items[i];
            string src = root + "/" + rel;
            if (Directory.Exists(src)) {
                if (!ZanIDE.GenTreeHasRules(root, rel)) {
                    s = s + " --embed \"" + src + "=" + rel + "\"";
                } else {
                    List<string> fs = new List<string>();
                    ZanIDE.GenCollectFiles(root, rel, fs);
                    for (int k = 0; k < fs.Count; k = k + 1) {
                        s = s + " --embed \"" + root + "/" + fs[k]
                            + "=" + fs[k] + "\"";
                    }
                }
            } else if (File.Exists(src)) {
                s = s + " --embed \"" + src + "=" + rel + "\"";
            }
        }
        return s;
    }

    /// True when the project builds a library instead of a runnable program
    /// (zan.proj `target = dll/lib/so/dylib/a` or `type = library`). Library
    /// projects are compiled to the platform's library format and never
    /// launched after a build.
    static bool IsLibraryProject(string root) {
        string t = ZanIDE.ProjField(root, "target");
        if (t == "dll" || t == "lib" || t == "so" || t == "dylib" || t == "a") {
            return true;
        }
        return ZanIDE.ProjField(root, "type") == "library";
    }

    /// The shared-library extension of the machine the IDE runs on.
    static string HostLibExt() {
        #if WINDOWS
        return ".dll";
        #elif MACOS
        return ".dylib";
        #else
        return ".so";
        #endif
    }

    /// The shared-library extension for a publish target id
    /// (windows-* -> .dll, macos-* -> .dylib, linux-* -> .so).
    static string LibExtFor(string id) {
        if (ZanIDE.StartsWith(id, "windows")) { return ".dll"; }
        if (ZanIDE.StartsWith(id, "macos")) { return ".dylib"; }
        return ".so";
    }

    /// The static-library extension for a publish target id
    /// (windows-* -> .lib, everything else -> .a).
    static string StaticLibExtFor(string id) {
        if (ZanIDE.StartsWith(id, "windows")) { return ".lib"; }
        return ".a";
    }

    /// Whether the library project also publishes static archives
    /// (zan.proj `staticLib = true`).
    static bool ProjStaticLib(string root) {
        return ZanIDE.ProjField(root, "staticLib") == "true";
    }

    /// The icon a produced executable should carry: the project's configured
    /// one (zan.proj `icon = ...`), then assets/app.ico, then the shipped Zan
    /// icon -- so every program the IDE builds, tools and samples included,
    /// gets an icon. Returns "" when none of them exists.
    static string IconFile(string root) {
        string rel = ZanIDE.ProjField(root, "icon");
        if (rel != "") {
            string ico = root + "/" + rel;
            if (File.Exists(ico)) { return ico; }
        }
        string a = ZanIDE.AssetsDir(root) + "/app.ico";
        if (File.Exists(a)) { return a; }
        return ZanIDE.ZanIconSource();
    }

    /// The same icon as a zanc `--icon` argument, or "" when there is none.
    static string IconArg(string root) {
        string f = ZanIDE.IconFile(root);
        if (f == "") { return ""; }
        return " --icon \"" + f + "\"";
    }
}
