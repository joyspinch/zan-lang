using System;
using System.Collections.Generic;
using System.Json;
using System.Text;

partial class LspSession {
    static int ByteColumnToUtf16(string text, int byteCol) {
        int pos = 0;
        int units = 0;
        while (pos < text.Length && pos < byteCol) {
            int next = Text.NextCharEnd(text, pos);
            if (next > byteCol) { break; }
            units = units + (next - pos == 4 ? 2 : 1);
            pos = next;
        }
        return units;
    }

    static int Utf16ColumnToByte(string text, int column) {
        int pos = 0;
        int units = 0;
        while (pos < text.Length && units < column) {
            int next = Text.NextCharEnd(text, pos);
            int width = next - pos == 4 ? 2 : 1;
            if (units + width > column) { break; }
            units = units + width;
            pos = next;
        }
        return pos;
    }

    static List<string> SplitLines(string text) {
        List<string> lines = new List<string>();
        int start = 0;
        int len = text.Length;
        for (int i = 0; i < len; i = i + 1) {
            char c = text[i];
            if (c == '\n') {
                int end = i;
                if (end > start && text[end - 1] == '\r') { end = end - 1; }
                lines.Add(text.Substring(start, end - start));
                start = i + 1;
            }
        }
        if (start <= len) {
            lines.Add(text.Substring(start, len - start));
        }
        return lines;
    }

    static LspDefinitionTarget ExtractDefinitionLocation(JsonDoc doc, int loc) {
        if (loc < 0 || doc.KindAt(loc) != 5) { return null; }
        string uri = doc.Str(loc, "uri", "");
        int range = doc.Get(loc, "range");
        if (uri.Length == 0) {
            uri = doc.Str(loc, "targetUri", "");
            range = doc.Get(loc, "targetSelectionRange");
            if (range < 0) { range = doc.Get(loc, "targetRange"); }
        }
        if (uri.Length == 0 || range < 0 || doc.KindAt(range) != 5) { return null; }
        int start = doc.Get(range, "start");
        int end = doc.Get(range, "end");
        if (start < 0 || end < 0 || doc.KindAt(start) != 5 || doc.KindAt(end) != 5) { return null; }
        int startLine = (int)doc.Long(start, "line", -1L);
        int startChar = (int)doc.Long(start, "character", -1L);
        int endLine = (int)doc.Long(end, "line", -1L);
        int endChar = (int)doc.Long(end, "character", -1L);
        if (startLine < 0 || startChar < 0 || endLine < startLine
            || (endLine == startLine && endChar < startChar)) { return null; }
        string path = LspSession.UriToPath(uri);
        if (path.Length == 0) { return null; }
        LspDefinitionTarget target = new LspDefinitionTarget();
        target.path = path;
        target.line = startLine;
        target.column = startChar;
        return target;
    }

    static LspDefinitionTarget ParseDefinition(string message) {
        if (message == null || message.Length == 0) { return null; }
        LspDefinitionTarget target = null;
        try {
            JsonDoc.ParseScoped(message, doc => {
                int root = doc.root;
                if (doc.KindAt(root) != 5 || doc.Get(root, "error") >= 0) { return; }
                int result = doc.Get(root, "result");
                if (result < 0 || doc.KindAt(result) == 0) { return; }
                if (doc.KindAt(result) == 4) {
                    int loc = doc.FirstChild(result);
                    while (loc >= 0) {
                        LspDefinitionTarget t = LspSession.ExtractDefinitionLocation(doc, loc);
                        if (t != null) { target = t; return; }
                        loc = doc.NextSibling(loc);
                    }
                } else if (doc.KindAt(result) == 5) {
                    target = LspSession.ExtractDefinitionLocation(doc, result);
                }
            });
        } catch (Exception) {
            return null;
        }
        return target;
    }

    static bool AppendRenameEditsFromDoc(List<LspRenameEdit> output, string uri, JsonDoc doc, int editsNode, int version) {
        if (uri.Length == 0 || editsNode < 0 || doc.KindAt(editsNode) != 4) { return false; }
        string path = LspSession.UriToPath(uri);
        if (path.Length == 0) { return false; }
        int edit = doc.FirstChild(editsNode);
        while (edit >= 0) {
            if (doc.KindAt(edit) == 5) {
                int range = doc.Get(edit, "range");
                string newText = doc.Str(edit, "newText", "");
                if (range >= 0 && doc.KindAt(range) == 5) {
                    int start = doc.Get(range, "start");
                    int end = doc.Get(range, "end");
                    if (start >= 0 && end >= 0 && doc.KindAt(start) == 5 && doc.KindAt(end) == 5) {
                        int sLine = (int)doc.Long(start, "line", -1L);
                        int sChar = (int)doc.Long(start, "character", -1L);
                        int eLine = (int)doc.Long(end, "line", -1L);
                        int eChar = (int)doc.Long(end, "character", -1L);
                        if (sLine >= 0 && sChar >= 0 && (eLine > sLine || (eLine == sLine && eChar >= sChar))) {
                            LspRenameEdit item = new LspRenameEdit();
                            item.path = path;
                            item.start = LspSession.PosObj(sLine, sChar);
                            item.end = LspSession.PosObj(eLine, eChar);
                            item.newText = newText;
                            item.version = version;
                            output.Add(item);
                        }
                    }
                }
            }
            edit = doc.NextSibling(edit);
        }
        return true;
    }

    /// WorkspaceEdit 抽取；返回 false = 结构不支持，调用方必须整体拒绝
    /// （返回 null），与 JsonValue 版的"拒绝而非静默跳过"语义一致。
    static bool ExtractWorkspaceEdit(JsonDoc doc, int resNode, List<LspRenameEdit> output) {
        if (resNode < 0 || doc.KindAt(resNode) != 5) { return true; }
        int changes = doc.Get(resNode, "changes");
        int docChanges = doc.Get(resNode, "documentChanges");
        if (changes >= 0 && docChanges >= 0) { return false; }
        if (changes >= 0 && doc.KindAt(changes) != 5) { return false; }
        if (docChanges >= 0 && doc.KindAt(docChanges) != 4) { return false; }
        if (changes >= 0) {
            int p = (int)(doc.slots[changes].a >> 8);
            while (p >= 0) {
                JsonPair pair = doc.pairs[p];
                string uri = pair.keyStart >= 0
                    ? doc.src.Substring(pair.keyStart, pair.keyLen)
                    : doc.escPool[pair.keyLen];
                int edits = pair.valueSlot;
                if (edits >= 0 && doc.KindAt(edits) == 4) {
                    if (!LspSession.AppendRenameEditsFromDoc(output, uri, doc, edits, -1)) { return false; }
                }
                p = pair.nextPair;
            }
        } else if (docChanges >= 0) {
            int entry = doc.FirstChild(docChanges);
            while (entry >= 0) {
                // 带 kind 的条目是 create/rename/delete 资源操作，不支持即整体拒绝。
                if (doc.KindAt(entry) != 5 || doc.Get(entry, "kind") >= 0) { return false; }
                int document = doc.Get(entry, "textDocument");
                if (document < 0 || doc.KindAt(document) != 5) { return false; }
                string uri = doc.Str(document, "uri", "");
                int vslot = doc.Get(document, "version");
                int version = -1;
                if (vslot >= 0 && doc.KindAt(vslot) != 0) {
                    version = (int)doc.Long(document, "version", -1L);
                    if (version < 0) { return false; }
                }
                int edits = doc.Get(entry, "edits");
                if (edits >= 0 && doc.KindAt(edits) == 4) {
                    if (!LspSession.AppendRenameEditsFromDoc(output, uri, doc, edits, version)) { return false; }
                }
                entry = doc.NextSibling(entry);
            }
        }
        return true;
    }

    static List<LspRenameEdit> ParseWorkspaceEdit(string m) {
        List<LspRenameEdit> output = new List<LspRenameEdit>();
        if (m == null || m.Length == 0) { return null; }
        bool rejected = false;
        try {
            JsonDoc.ParseScoped(m, doc => {
                int root = doc.root;
                if (doc.KindAt(root) != 5 || doc.Get(root, "error") >= 0) { return; }
                int result = doc.Get(root, "result");
                if (result >= 0 && doc.KindAt(result) == 5) {
                    if (!LspSession.ExtractWorkspaceEdit(doc, result, output)) { rejected = true; }
                }
            });
        } catch (Exception) {
            return null;
        }
        if (rejected) { return null; }
        return output;
    }

    static int PositionOffset(string text, LspPosition position) {
        if (position == null || position.line < 0 || position.character < 0) { return -1; }
        int start = 0;
        for (int line = 0; line < position.line; line = line + 1) {
            int next = text.IndexOf("\n", start);
            if (next < 0) { return -1; }
            start = next + 1;
        }
        int end = text.IndexOf("\n", start);
        if (end < 0) { end = text.Length; }
        if (end > start && (text[end - 1] & 255) == 13) { end = end - 1; }
        string source = text.Substring(start, end - start);
        int col = LspSession.Utf16ColumnToByte(source, position.character);
        if (LspSession.ByteColumnToUtf16(source, col) != position.character) { return -1; }
        return start + col;
    }

    static LspEditApplication ApplyTextEdits(string text, List<LspRenameEdit> edits, string path) {
        LspEditApplication result = new LspEditApplication();
        result.text = text;
        if (edits == null) { return result; }
        List<LspEditSpan> spans = new List<LspEditSpan>();
        for (int i = 0; i < edits.Count; i = i + 1) {
            LspRenameEdit edit = edits[i];
            if (edit == null) { return result; }
            if (!LspSession.SameDocumentPath(edit.path, path)) { continue; }
            int start = LspSession.PositionOffset(text, edit.start);
            int end = LspSession.PositionOffset(text, edit.end);
            if (start < 0 || end < start) { return result; }
            LspEditSpan span = new LspEditSpan();
            span.start = start; span.end = end; span.newText = edit.newText;
            int at = 0;
            while (at < spans.Count && (spans[at].start > start
                || (spans[at].start == start && spans[at].end > end))) { at = at + 1; }
            spans.Insert(at, span);
        }
        for (int i = 1; i < spans.Count; i = i + 1) {
            if (spans[i].end > spans[i - 1].start) { return result; }
        }
        string output = text;
        for (int i = 0; i < spans.Count; i = i + 1) {
            LspEditSpan span = spans[i];
            output = output.Substring(0, span.start) + span.newText
                + output.Substring(span.end, output.Length - span.end);
        }
        result.valid = true;
        result.text = output;
        return result;
    }

    static bool SameDocumentPath(string left, string right) {
        left = left.Replace("\\", "/");
        right = right.Replace("\\", "/");
        #if WINDOWS
        left = left.ToLower(); right = right.ToLower();
        #endif
        return left == right;
    }

    static List<LspWorkspaceSymbol> ParseWorkspaceSymbols(string message) {
        List<LspWorkspaceSymbol> outp = new List<LspWorkspaceSymbol>();
        if (message == null || message.Length == 0) { return outp; }
        try {
            JsonDoc.ParseScoped(message, doc => {
                int root = doc.root;
                if (doc.KindAt(root) != 5 || doc.Get(root, "error") >= 0) { return; }
                int result = doc.Get(root, "result");
                if (result < 0 || doc.KindAt(result) != 4) { return; }
                int item = doc.FirstChild(result);
                while (item >= 0) {
                    if (doc.KindAt(item) == 5) {
                        string name = doc.Str(item, "name", "");
                        int location = doc.Get(item, "location");
                        if (name.Length > 0 && location >= 0 && doc.KindAt(location) == 5) {
                            string path = LspSession.UriToPath(doc.Str(location, "uri", ""));
                            if (path.Length > 0) {
                                int line = 0;
                                int col = 0;
                                int range = doc.Get(location, "range");
                                if (range >= 0 && doc.KindAt(range) == 5) {
                                    int start = doc.Get(range, "start");
                                    if (start >= 0 && doc.KindAt(start) == 5) {
                                        line = (int)doc.Long(start, "line", 0L);
                                        col = (int)doc.Long(start, "character", 0L);
                                    }
                                }
                                if (line < 0) { line = 0; }
                                if (col < 0) { col = 0; }
                                LspWorkspaceSymbol symbol = new LspWorkspaceSymbol();
                                symbol.name = name;
                                symbol.kind = (int)doc.Long(item, "kind", 0L);
                                symbol.containerName = doc.Str(item, "containerName", "");
                                symbol.path = path;
                                symbol.line = line;
                                symbol.column = col;
                                outp.Add(symbol);
                            }
                        }
                    }
                    item = doc.NextSibling(item);
                }
            });
        } catch (Exception) {}
        return outp;
    }

    static List<LspCodeAction> ParseCodeActions(string message) {
        List<LspCodeAction> outp = new List<LspCodeAction>();
        if (message == null || message.Length == 0) { return outp; }
        try {
            JsonDoc.ParseScoped(message, doc => {
                int root = doc.root;
                if (doc.KindAt(root) != 5 || doc.Get(root, "error") >= 0) { return; }
                int result = doc.Get(root, "result");
                if (result < 0 || doc.KindAt(result) != 4) { return; }
                int item = doc.FirstChild(result);
                while (item >= 0) {
                    if (doc.KindAt(item) == 5) {
                        string title = doc.Str(item, "title", "");
                        if (title.Length > 0) {
                            int edit = doc.Get(item, "edit");
                            if (edit >= 0 && doc.KindAt(edit) == 5) {
                                LspCodeAction action = new LspCodeAction();
                                action.title = title;
                                action.kind = doc.Str(item, "kind", "");
                                action.edits = new List<LspRenameEdit>();
                                LspSession.ExtractWorkspaceEdit(doc, edit, action.edits);
                                outp.Add(action);
                            }
                        }
                    }
                    item = doc.NextSibling(item);
                }
            });
        } catch (Exception) {}
        return outp;
    }

    static string MarkupText(object docObj) {
        if (docObj == null) { return ""; }
        if (docObj is string) { return (string)docObj; }
        if (docObj is Dict<string, string>) {
            Dict<string, string> d = (Dict<string, string>)docObj;
            if (d.ContainsKey("value")) { return d["value"]; }
        }
        return "";
    }

    static string ExtractMarkupText(JsonDoc doc, int node) {
        if (node < 0) { return ""; }
        int kind = doc.KindAt(node);
        if (kind == 3) { return doc.StrAt(node, ""); }
        if (kind == 5) { return doc.Str(node, "value", ""); }
        if (kind == 4) {
            List<string> parts = new List<string>();
            int child = doc.FirstChild(node);
            while (child >= 0) {
                string t = LspSession.ExtractMarkupText(doc, child);
                if (t.Length > 0) { parts.Add(t); }
                child = doc.NextSibling(child);
            }
            return string.Join("\n", parts);
        }
        return "";
    }

    static string PosParams(string path, int line0, int col0) {
        LspDocPosParams p = new LspDocPosParams();
        p.textDocument = LspSession.UriObj(path);
        p.position = LspSession.PosObj(line0, col0);
        return Json.Serialize<LspDocPosParams>(p);
    }

    static LspTextDocumentIdentifier UriObj(string path) {
        LspTextDocumentIdentifier o = new LspTextDocumentIdentifier();
        o.uri = LspSession.PathToUri(path);
        return o;
    }

    static LspPosition PosObj(int line0, int col0) {
        LspPosition o = new LspPosition();
        o.line = line0;
        o.character = col0;
        return o;
    }

    static string PathToUri(string path) {
        string p = "";
        for (int i = 0; i < path.Length; i = i + 1) {
            string ch = path.Substring(i, 1);
            if (ch == "\\") { p = p + "/"; } else { p = p + ch; }
        }
        p = Encoding.UrlEncode(p).Replace("+", "%20").Replace("%2f", "/").Replace("%3a", ":");
        if (p.StartsWith("//")) { return "file:" + p; }
        if (p.StartsWith("/")) { return "file://" + p; }
        return "file:///" + p;
    }

    static string UriToPath(string uri) {
        if (!uri.StartsWith("file://")) { return ""; }
        string p = uri.Substring(7);
        if (p.StartsWith("localhost/")) { p = p.Substring(9); }
        else if (!p.StartsWith("/")) { p = "//" + p; }
        p = Encoding.UrlDecode(p.Replace("+", "%2b"));
        if (p.Length >= 3 && (p[0] & 255) == 47 && (p[2] & 255) == 58
            && (((p[1] & 255) >= 65 && (p[1] & 255) <= 90)
                || ((p[1] & 255) >= 97 && (p[1] & 255) <= 122))) { p = p.Substring(1); }
        return p;
    }
}
