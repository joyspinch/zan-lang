using System;

/// One member of the assistant team.
///
/// `next` is the role work flows to when this member's stage passes, which is
/// what makes the pipeline a fixed chain instead of six agents guessing who
/// goes next: 产品经理 -> 架构师 -> 素材设计师 -> 开发者 -> 测试工程师 -> 代码审查员 ->
/// 安全审计员 -> 产品经理. A member that finds a defect always sends it back
/// to the developer (`AiTeam.FixOwner()`), never onward.
class AiRole {
    string id;
    string en;
    string zh;
    string next;
    string duty;
    /// Palette slot for the member's Avatar tint, resolved against the theme
    /// so the six members stay distinguishable in every skin.
    int tint;

    static AiRole Create(string id, string en, string zh, string next,
            string duty, int tint) {
        AiRole r = new AiRole();
        r.id = id;
        r.en = en;
        r.zh = zh;
        r.next = next;
        r.duty = duty;
        r.tint = tint;
        return r;
    }
}

/// 一个角色在某个任务节点上的参与记录。
///
/// 参与者不是一串角色 id：面板要显示「谁、用哪个模型、说了几轮、最后一次
/// 什么时候」，用平行的 List<string> 靠下标对齐迟早对不上，所以每个参与者
/// 就是一条带自己字段的记录，按 role 查。
class AiTaskPart {
    /// 角色 id（`AiTeam.Dev()` 等七个之一）。节点内唯一，就是这条记录的键。
    string role;
    /// 该角色在本节点实际用的模型名，记下来是因为角色到模型的映射用户随时
    /// 会改：事后看历史时要知道当时是谁跑的。
    string model;
    /// 该角色在本节点发过的消息轮数。
    int rounds;
    /// 最后一次发言的 Unix 秒。0 表示只被计划提名、还没说过话。
    long lastTs;

    static AiTaskPart Create(string role) {
        AiTaskPart p = new AiTaskPart();
        p.role = role;
        p.model = "";
        p.rounds = 0;
        p.lastTs = 0;
        return p;
    }
}

/// One card on the team task board.
///
/// Replaces the flat `AiPlanStep` for team sessions: a task now has an owner
/// and an acceptance criterion, because the whole point of the architect
/// writing `accept` is that the tester verifies against it instead of
/// inventing its own idea of "done".
class AiTask {
    string id;
    string title;
    string owner;
    /// 0 todo, 1 acked, 2 doing, 3 blocked, 4 in review, 5 done.
    int state;
    int progress;
    string accept;
    /// 前置任务的 id。全部完成前本任务是锁着的：这既是「不能提前开工」
    /// 的开关，也是上下文传递的路径（前置的产出摘要注入本节点）。
    List<string> deps;
    /// 在本节点参与过的角色，按首次出现排序。一个节点通常不止一个角色
    /// （开发者做、测试工程师验、审查员看），所以节点自己记住参与者，而不是
    /// 从整条流水里反推；每条记录带模型与轮数，见 `AiTaskPart`。
    List<AiTaskPart> parts;
    /// 本节点的产出摘要：交付了什么、结论是什么。解锁后继节点时原样注入
    /// 它们的上下文头部，所以后继不必重读前置的全部对话。
    string outcome;
    /// 本节点自己的开发任务清单（一个节点是一块功能，比如「前台商品展示」，
    /// 清单才是把它做出来要干的活）。节点的百分比也从这份清单折出来，所以
    /// 多个节点各有各的进度，互不影响。见 `AiTaskPlan`。
    List<AiPlanStep> items;

    static AiTask Create(string id, string title, string owner) {
        AiTask t = new AiTask();
        t.id = id;
        t.title = title;
        t.owner = owner;
        t.state = 0;
        t.progress = 0;
        t.accept = "";
        t.deps = new List<string>();
        t.parts = new List<AiTaskPart>();
        t.outcome = "";
        t.items = new List<AiPlanStep>();
        return t;
    }
}

/// Where a team session is, so "继续" after a crash or a stopped run resumes
/// the member that was mid-stage instead of restarting the whole pipeline at
/// the product manager.
class AiTeamState {
    string activeAgent;
    string activeTask;
    /// True while a `question` is outstanding: the pipeline is parked and only
    /// the user's answer may restart it.
    bool awaitingUser;
    /// The member whose question is waiting, so the answer routes back to it.
    string askedBy;

    static AiTeamState Create() {
        AiTeamState s = new AiTeamState();
        s.activeAgent = AiTeam.Pm();
        s.activeTask = "";
        s.awaitingUser = false;
        s.askedBy = "";
        return s;
    }
}

/// The parsed routing header of one team message: who it is for, what kind of
/// beat it is in the protocol, which task it belongs to and the body with the
/// header removed.
class AiEnvelope {
    List<string> to;
    string kind;
    string taskId;
    int progress;
    string body;

    static AiEnvelope Create() {
        AiEnvelope e = new AiEnvelope();
        e.to = new List<string>();
        e.kind = "";
        e.taskId = "";
        e.progress = 0;
        e.body = "";
        return e;
    }
}

/// The team layer: role definitions, @-routing, per-member tool whitelists and
/// per-member system prompts.
///
/// The single assistant becomes a group chat by adding three things to the
/// existing agent loop, and nothing else: an envelope on each message (who
/// spoke, who it is for, which beat of the protocol), a private context view
/// per member, and a fixed handoff chain. The loop, the tools and the
/// approval gate are unchanged -- a team member is the same `AiAgent` running
/// with a different system prompt and a narrower tool whitelist.
class AiTeam {
    // --- roles ---------------------------------------------------------------

    static string Pm() { return "pm"; }
    static string Arch() { return "arch"; }
    static string Dev() { return "dev"; }
    static string Qa() { return "qa"; }
    static string Rev() { return "rev"; }
    static string Sec() { return "sec"; }
    static string Art() { return "art"; }

    /// 流程自己发的那些指令（派单、催一脚、转交）的发语人。它们技术上必须
    /// 以 user 角色进模型请求（接口只收 user/assistant），但它们不是用户说的
    /// 话——标上这个发语人，聊天记录里就不会把团队内部派单显示成「我」，
    /// 每个成员也不会把别人的派单当成用户需求读。
    static string Auto() { return "auto"; }

    /// 这条是流程自己发的内部指令，不是用户发言。
    static bool IsAuto(ChatMessage m) {
        return m.role == "user" && m.agent == AiTeam.Auto();
    }

    /// The member a defect always goes back to.
    static string FixOwner() { return AiTeam.Dev(); }

    /// 全程握着任务图和派单权的那个人：拆完的图由它按依赖一个一个往外派，
    /// 每个节点验收过了再派下一个。干活的成员不自己找下一个活。
    static string Dispatcher() { return AiTeam.Pm(); }

    /// 同一个成员在同一个节点上，最多连着查几次就必须交东西出来。读代码是手段
    /// 不是交付：只读角色（架构师 / 审查 / 安全）读够了要给出指令，能写的角色
    /// 读够了要动手改。没有这道闸，「每拍都发了工具调用」会一直算成有进展，于
    /// 是它可以一路读到预算见底，用户看到的就是满屏读文件。
    /// 查到上限时顶回去的那句话：说清「不许再查」和「这一拍要交什么」，按角色
    /// 分——只读角色交指令，能写的角色交改动。
    static string LookupCapped(string roleId) {
        return AiTeam.LookupHead() + AiTeam.LookupAsk(roleId);
    }

    /// 顶回去时先说清「这是 IDE 不让你查，不是文件不存在」：不说的话，模型会把
    /// 这条当成缺陷证据写进验收报告（真实发生过：它据此判前台入口缺失，而那个
    /// 文件其实好好地在那儿）。
    static string LookupHead() {
        return "refused: 这一拍不许再查（不是文件不存在、也不是代码有问题，"
            + "是你已经连着查了好几次还没交东西）。别把这条当成缺陷证据。";
    }

    static string LookupAsk(string roleId) {
        if (roleId == AiTeam.Qa()) {
            return "按手上的证据下结论：达标就 [report]，不达标就 [block]"
                + " 写清「哪条验收、怎么复现、实际是什么」，别再补取证。";
        }
        if (!AiTeam.AllowsTool(roleId, "write_file")) {
            return "代码你看够了：把结论写成一条别人拿着就能敲的指令（改哪个"
                + "文件、加什么、怎么算做完）然后 [handoff] @"
                + AiTeam.DisplayName(AiTeam.Dev())
                + "；确实缺前置或要用户拍板就 [block] / [question] 说清缺什么。";
        }
        return "直接 edit_file / write_file 把这一步改出来，改完 build；"
            + "真做不了就 [block] 说清卡在哪。";
    }

    static int MaxLookups(string roleId) {
        // 测试要按验收标准一条条取证，读的文件本来就多，给到和开发一样的额度。
        if (roleId == AiTeam.Qa()) { return 8; }
        if (!AiTeam.AllowsTool(roleId, "write_file")) { return 5; }
        return 8;
    }

    /// 干活的成员（自己不管图、不派单）：产品经理和架构师以外都是。
    static bool Executor(string roleId) {
        return roleId != AiTeam.Pm() && roleId != AiTeam.Arch();
    }

    // --- per-member models ---------------------------------------------------

    /// The enabled provider's role -> model map (AiProfile.roles), refreshed by
    /// the panel whenever the profiles are loaded, saved or switched. It lives
    /// here because every launch of a member -- the first question, a retry, an
    /// automatic handoff -- has to pick that member's model, and those launches
    /// are spread over the whole run loop.
    static string sRoleModels;

    static void SetModels(string mapJson) { AiTeam.sRoleModels = mapJson; }

    /// The user's per-member prompt overrides (role id -> prompt), refreshed
    /// alongside the models. An empty entry means "use the built-in charter".
    static string sRolePrompts;

    static void SetPrompts(string mapJson) { AiTeam.sRolePrompts = mapJson; }

    /// The member's own charter as configured: the user's text when it set
    /// one, else the built-in default.
    static string PromptOf(string roleId) {
        if (AiTeam.sRolePrompts != null) {
            string custom = ZanIDE.AiRoleModel(AiTeam.sRolePrompts, roleId);
            if (custom != null && custom != "") { return custom; }
        }
        return AiTeam.DefaultDuty(roleId);
    }

    /// The model `roleId` runs on, or "" to use the provider's default model.
    static string ModelOf(string roleId) {
        if (AiTeam.sRoleModels == null) { return ""; }
        return ZanIDE.AiRoleModel(AiTeam.sRoleModels, roleId);
    }

    static List<AiRole> Roles() {
        List<AiRole> rs = new List<AiRole>();
        rs.Add(AiRole.Create(AiTeam.Pm(), "Product Manager", "产品经理",
            AiTeam.Arch(),
            "澄清需求、写需求卡、对用户负责", 0));
        rs.Add(AiRole.Create(AiTeam.Arch(), "Architect", "架构师",
            AiTeam.Art(),
            "拆任务、定接口与文件边界、写验收标准", 1));
        rs.Add(AiRole.Create(AiTeam.Art(), "Asset Designer", "素材设计师",
            AiTeam.Dev(),
            "产出界面与游戏素材：图标、皮肤、精灵图与配色", 6));
        rs.Add(AiRole.Create(AiTeam.Dev(), "Developer", "开发者",
            AiTeam.Qa(),
            "实现任务卡并保证能编译通过", 2));
        rs.Add(AiRole.Create(AiTeam.Qa(), "Test Engineer", "测试工程师",
            AiTeam.Rev(),
            "跑真实程序与真实 UI，出可复现的失败证据", 3));
        rs.Add(AiRole.Create(AiTeam.Rev(), "Code Reviewer", "代码审查员",
            AiTeam.Sec(),
            "审 diff：正确性、边界、风格一致", 4));
        rs.Add(AiRole.Create(AiTeam.Sec(), "Security Auditor", "安全审计员",
            AiTeam.Pm(),
            "审明文密钥、注入、路径逃逸、权限", 5));
        return rs;
    }

    static AiRole RoleOf(string id) {
        List<AiRole> rs = AiTeam.Roles();
        for (int i = 0; i < rs.Count; i = i + 1) {
            if (rs[i].id == id) { return rs[i]; }
        }
        return null;
    }

    /// The member's name in the user's language, or "" for a non-member
    /// speaker (the user, a tool result, an error).
    static string DisplayName(string id) {
        AiRole r = AiTeam.RoleOf(id);
        if (r == null) { return ""; }
        return ZanIDE.T(r.en, r.zh);
    }

    /// The member work flows to when `id`'s stage passes.
    static string NextOf(string id) {
        AiRole r = AiTeam.RoleOf(id);
        if (r == null) { return AiTeam.Pm(); }
        return r.next;
    }

    // --- @ routing -----------------------------------------------------------

    /// Resolves one @name to a role id: the Chinese name, the English name,
    /// the bare id, and the short aliases a user actually types. "" when the
    /// name is not a member.
    static string RoleIdOfName(string name) {
        string n = AiAgent.Trim(name);
        if (n == "") { return ""; }
        List<AiRole> rs = AiTeam.Roles();
        for (int i = 0; i < rs.Count; i = i + 1) {
            if (n == rs[i].zh || n == rs[i].id) { return rs[i].id; }
        }
        string low = ZanIDE.ToLowerS(n);
        for (int i = 0; i < rs.Count; i = i + 1) {
            if (low == ZanIDE.ToLowerS(rs[i].en)) { return rs[i].id; }
            // An @name ends at the first space, so the English titles are also
            // matched without theirs ("@productmanager"): typing the displayed
            // "Product Manager" would otherwise resolve nothing and the message
            // would quietly go to whoever spoke last.
            if (low == AiTeam.Squash(rs[i].en)) { return rs[i].id; }
            if (low == rs[i].id) { return rs[i].id; }
        }
        // Aliases: the words people use instead of the formal title.
        if (n == "项目经理" || n == "产品" || low == "pm"
            || low == "product") { return AiTeam.Pm(); }
        if (n == "架构" || low == "architect" || low == "arch") {
            return AiTeam.Arch();
        }
        if (n == "开发" || n == "程序员" || low == "dev"
            || low == "developer" || low == "coder") { return AiTeam.Dev(); }
        if (n == "测试" || low == "qa" || low == "test"
            || low == "tester") { return AiTeam.Qa(); }
        if (n == "审查" || n == "代码审查" || n == "评审" || low == "review"
            || low == "reviewer" || low == "rev") { return AiTeam.Rev(); }
        if (n == "安全" || n == "安全审计" || low == "sec"
            || low == "security" || low == "auditor") { return AiTeam.Sec(); }
        if (n == "素材" || n == "美术" || n == "设计师" || low == "art"
            || low == "artist" || low == "asset" || low == "designer") {
            return AiTeam.Art();
        }
        return "";
    }

    /// A name lowercased with its spaces removed ("Product Manager" ->
    /// "productmanager").
    static string Squash(string s) {
        StringBuilder sb = new StringBuilder();
        string low = ZanIDE.ToLowerS(s);
        for (int i = 0; i < low.Length; i = i + 1) {
            if ((low[i] & 255) != 32) { sb.Append(low.Substring(i, 1)); }
        }
        return sb.ToString();
    }

    /// The broadcast handle.
    static bool IsEveryone(string name) {
        string low = ZanIDE.ToLowerS(AiAgent.Trim(name));
        return name == "所有人" || name == "全体" || low == "all"
            || low == "everyone" || low == "team";
    }

    /// True for an ASCII byte that ends an @name: whitespace or punctuation.
    /// A name runs to the first of these, so "@dev: fix" resolves. Multi-byte
    /// (UTF-8) content is handled by BreakLen so Chinese names survive but the
    /// Chinese comma/space between two names still separates them.
    static bool NameBreak(int ch) {
        if (ch >= 128) { return false; }
        if (ch == 32 || ch == 9 || ch == 10 || ch == 13) { return true; }
        if (ch == 44 || ch == 58 || ch == 59 || ch == 46) { return true; }
        if (ch == 33 || ch == 63 || ch == 91 || ch == 93) { return true; }
        if (ch == 64) { return true; }
        return false;
    }

    /// Byte length of a name-separator at `i`: 1 for an ASCII break, 3 for a
    /// full-width CJK comma "，", enumeration comma "、", colon "：" or space
    /// "　" (the ones a user actually types between two @names), else 0. The
    /// scanner works on bytes, so a three-byte separator has to be recognised
    /// explicitly or "@测试，@审查" would read as one impossible name.
    static int BreakLen(string t, int i) {
        int ch = t[i] & 255;
        if (ch < 128) {
            if (AiTeam.NameBreak(ch)) { return 1; }
            return 0;
        }
        if (i + 2 < t.Length) {
            int b2 = t[i + 1] & 255;
            int b3 = t[i + 2] & 255;
            // ，(EF BC 8C)  ：(EF BC 9A)
            if (ch == 239 && b2 == 188 && (b3 == 140 || b3 == 154)) {
                return 3;
            }
            // 、(E3 80 81)  full-width space (E3 80 80)
            if (ch == 227 && b2 == 128 && (b3 == 129 || b3 == 128)) {
                return 3;
            }
        }
        return 0;
    }

    /// Every role id mentioned with @ in `text`, in order, without duplicates.
    /// `@所有人` expands to the whole team. Only the leading run of mentions
    /// is routing: an @name deeper in a sentence is prose, not an address, so
    /// scanning stops at the first non-mention content.
    static List<string> ParseMentions(string text) {
        List<string> outIds = new List<string>();
        int i = 0;
        while (i < text.Length) {
            // Skip whitespace and CJK separators between names (but not @).
            while (i < text.Length && (text[i] & 255) != 64) {
                int bl = AiTeam.BreakLen(text, i);
                if (bl == 0) { return outIds; }
                i = i + bl;
            }
            if (i >= text.Length) { return outIds; }
            if ((text[i] & 255) != 64) { return outIds; }
            int s = i + 1;
            int e = s;
            while (e < text.Length && (text[e] & 255) != 64
                   && AiTeam.BreakLen(text, e) == 0) {
                e = e + 1;
            }
            string name = text.Substring(s, e - s);
            if (AiTeam.IsEveryone(name)) {
                List<AiRole> rs = AiTeam.Roles();
                for (int k = 0; k < rs.Count; k = k + 1) {
                    AiTeam.AddOnce(outIds, rs[k].id);
                }
            } else {
                string id = AiTeam.RoleIdOfName(name);
                if (id == "") { return outIds; }
                AiTeam.AddOnce(outIds, id);
            }
            i = e;
        }
        return outIds;
    }

    static void AddOnce(List<string> xs, string v) {
        for (int i = 0; i < xs.Count; i = i + 1) {
            if (xs[i] == v) { return; }
        }
        xs.Add(v);
    }

    static bool HasStr(List<string> xs, string v) {
        for (int i = 0; i < xs.Count; i = i + 1) {
            if (xs[i] == v) { return true; }
        }
        return false;
    }

    // --- envelope ------------------------------------------------------------

    static string KindAssign() { return "assign"; }
    static string KindAck() { return "ack"; }
    static string KindProgress() { return "progress"; }
    static string KindHandoff() { return "handoff"; }
    static string KindQuestion() { return "question"; }
    static string KindReport() { return "report"; }
    static string KindBlock() { return "block"; }
    /// 不是模型说的拍子，而是 IDE 自己放进节点上下文的一条：前置节点的产出
    /// 摘要。单独一个 kind 是为了「这个节点已经收到过前置摘要了」可以被查到，
    /// 于是切回来十次也只注入一次。
    static string KindDeps() { return "deps"; }

    static bool IsKind(string k) {
        return k == AiTeam.KindAssign() || k == AiTeam.KindAck()
            || k == AiTeam.KindProgress() || k == AiTeam.KindHandoff()
            || k == AiTeam.KindQuestion() || k == AiTeam.KindReport()
            || k == AiTeam.KindBlock();
    }

    /// Parses the routing header a member puts on the first line of its reply:
    ///
    ///     @测试工程师 [handoff T-3] 表单校验已实现，build 通过。
    ///     [progress T-3 60%] 正在补边界用例
    ///     [question] 这两种做法哪个是你要的？
    ///
    /// Everything is optional, so a plain sentence still parses (to=[], kind=""
    /// and the whole text as the body) and a model that forgets the header
    /// degrades to a normal chat message rather than breaking the pipeline.
    static AiEnvelope ParseEnvelope(string text) {
        AiEnvelope e = AiEnvelope.Create();
        e.body = text;
        e.to = AiTeam.ParseMentions(text);
        // Consume the mention run so the body does not repeat the addresses.
        int at = 0;
        if (e.to.Count > 0) { at = AiTeam.MentionEnd(text); }
        // A bracket marker is only a marker when it opens the remaining text.
        int i = at;
        while (i < text.Length && (text[i] & 255) != 91) {
            int bl = AiTeam.BreakLen(text, i);
            if (bl == 0) { break; }
            i = i + bl;
        }
        if (i < text.Length && (text[i] & 255) == 91) {
            int close = i + 1;
            while (close < text.Length && (text[close] & 255) != 93) {
                if ((text[close] & 255) == 10) { break; }
                close = close + 1;
            }
            if (close < text.Length && (text[close] & 255) == 93) {
                string inner = text.Substring(i + 1, close - i - 1);
                if (AiTeam.ReadMarker(inner, e)) { at = close + 1; }
            }
        }
        string rest = text.Substring(at, text.Length - at);
        e.body = AiAgent.Trim(rest);
        return e;
    }

    /// End offset of the leading run of @mentions in `text`.
    static int MentionEnd(string text) {
        int i = 0;
        int last = 0;
        while (i < text.Length) {
            while (i < text.Length && (text[i] & 255) != 64) {
                int bl = AiTeam.BreakLen(text, i);
                if (bl == 0) { return last; }
                i = i + bl;
            }
            if (i >= text.Length) { return last; }
            if ((text[i] & 255) != 64) { return last; }
            int s = i + 1;
            int e = s;
            while (e < text.Length && (text[e] & 255) != 64
                   && AiTeam.BreakLen(text, e) == 0) {
                e = e + 1;
            }
            string name = text.Substring(s, e - s);
            if (!AiTeam.IsEveryone(name) && AiTeam.RoleIdOfName(name) == "") {
                return last;
            }
            last = e;
            i = e;
        }
        return last;
    }

    /// Reads a `[kind T-3 60%]` marker into `e`; false when the brackets hold
    /// something else (so it stays part of the body).
    static bool ReadMarker(string inner, AiEnvelope e) {
        List<string> parts = new List<string>();
        int s = 0;
        for (int i = 0; i <= inner.Length; i = i + 1) {
            bool end = i == inner.Length;
            bool sp = false;
            if (!end) {
                int ch = inner[i] & 255;
                sp = ch == 32 || ch == 9;
            }
            if (end || sp) {
                if (i > s) { parts.Add(inner.Substring(s, i - s)); }
                s = i + 1;
            }
        }
        if (parts.Count == 0) { return false; }
        string kind = ZanIDE.ToLowerS(parts[0]);
        if (!AiTeam.IsKind(kind)) { return false; }
        e.kind = kind;
        for (int i = 1; i < parts.Count; i = i + 1) {
            string p = parts[i];
            if (p.Length > 0 && (p[p.Length - 1] & 255) == 37) {
                e.progress = AiTeam.NumOf(p.Substring(0, p.Length - 1));
            } else {
                e.taskId = AiTeam.TaskIdOf(p);
            }
        }
        return true;
    }

    /// 标记里那一段任务号，去掉模型顺手带上的 `task=` 之类的前缀。
    ///
    /// 提示词里写的是 `[report] task=T-1`，模型多半合成一个标记写成
    /// `[report task=T-1]`，于是这一段字面量是 `task=T-1`。不剥掉前缀，它就是
    /// 一个图上不存在的节点号：`Fold` 照它新建一个空节点，真正的 T-1 因此永远
    /// 不会被收尾、永远留在「能开工」里，产品经理于是一拍一拍地把同一个节点
    /// 重新派出去——用户看到的那个「验收通过了还在原地打转」的死循环。
    static string TaskIdOf(string s) {
        string p = s;
        int eq = -1;
        for (int i = 0; i < p.Length; i = i + 1) {
            int ch = p[i] & 255;
            if (ch == 61 || ch == 58) { eq = i; break; }
        }
        if (eq >= 0) {
            string head = ZanIDE.ToLowerS(p.Substring(0, eq));
            if (head == "task" || head == "id" || head == "taskid"
                || head == "node") {
                p = p.Substring(eq + 1, p.Length - eq - 1);
            }
        }
        while (p.Length > 0 && (p[0] & 255) == 35) {
            p = p.Substring(1, p.Length - 1);
        }
        return p;
    }

    /// Leading decimal digits of `s` as an int (0 when there are none), so a
    /// malformed percentage can never throw inside the parser.
    static int NumOf(string s) {
        int v = 0;
        for (int i = 0; i < s.Length; i = i + 1) {
            int ch = s[i] & 255;
            if (ch < 48 || ch > 57) { break; }
            v = v * 10 + (ch - 48);
        }
        if (v > 100) { v = 100; }
        return v;
    }

    /// Formats the header a member is asked to write, used for the prompt
    /// examples and for the messages the IDE itself injects.
    static string Header(string toId, string kind, string taskId) {
        StringBuilder sb = new StringBuilder();
        if (toId != "") { sb.Append("@" + AiTeam.DisplayName(toId) + " "); }
        if (kind != "") {
            sb.Append("[" + kind);
            if (taskId != "") { sb.Append(" " + taskId); }
            sb.Append("] ");
        }
        return sb.ToString();
    }

    // --- default recipient ---------------------------------------------------

    /// Who the user's message goes to when they did not type an @name:
    /// the member that spoke last, else the product manager.
    ///
    /// Both halves are the user's rule. Replying to whoever just spoke is what
    /// makes a group chat feel like a conversation instead of a dispatch form,
    /// and falling back to the product manager means an unaddressed request is
    /// always turned into a requirement by the one member who talks to users.
    static string DefaultRecipient(List<ChatMessage> msgs) {
        for (int i = msgs.Count - 1; i >= 0; i = i - 1) {
            if (msgs[i].role == "user") { continue; }
            if (msgs[i].agent != "" && AiTeam.RoleOf(msgs[i].agent) != null) {
                return msgs[i].agent;
            }
        }
        return AiTeam.Pm();
    }

    /// The recipient of a user message: an explicit @name wins, otherwise the
    /// default above.
    static string RouteUser(string text, List<ChatMessage> msgs) {
        List<string> ms = AiTeam.ParseMentions(text);
        if (ms.Count > 0) { return ms[0]; }
        return AiTeam.DefaultRecipient(msgs);
    }

    /// The recipient with the team's state taken into account -- the routing
    /// the composer shows and the send uses, so what the user is told and what
    /// happens cannot disagree.
    ///
    /// An @name is an address, so it beats everything: a member parked on a
    /// question used to be handed every following message, which is exactly the
    /// "@ someone else and the wrong member answers" the user hit. Without an
    /// @name the parked question is answered by whoever asked it, and otherwise
    /// the default recipient applies.
    static string RouteUserSt(string text, List<ChatMessage> msgs,
            AiTeamState st) {
        List<string> ms = AiTeam.ParseMentions(text);
        if (ms.Count > 0) { return ms[0]; }
        if (st != null && st.awaitingUser) {
            string r = AiTeam.ResumeTarget(st);
            if (r != "") { return r; }
        }
        return AiTeam.DefaultRecipient(msgs);
    }

    /// The @name at the head of `text` that is not a member, or "". A message
    /// addressed to nobody must not be delivered to somebody else, so the
    /// composer refuses it instead of falling back to the default recipient.
    static string UnknownMention(string text) {
        int i = 0;
        while (i < text.Length && AiTeam.BreakLen(text, i) > 0) {
            i = i + AiTeam.BreakLen(text, i);
        }
        if (i >= text.Length || (text[i] & 255) != 64) { return ""; }
        int s = i + 1;
        int e = s;
        while (e < text.Length && (text[e] & 255) != 64
               && AiTeam.BreakLen(text, e) == 0) {
            e = e + 1;
        }
        string name = text.Substring(s, e - s);
        if (name == "") { return ""; }
        if (AiTeam.IsEveryone(name)) { return ""; }
        if (AiTeam.RoleIdOfName(name) != "") { return ""; }
        return name;
    }

    /// Every member's name in the user's language, comma-joined: what to offer
    /// when an @name did not resolve.
    static string NameList() {
        List<AiRole> rs = AiTeam.Roles();
        StringBuilder sb = new StringBuilder();
        for (int i = 0; i < rs.Count; i = i + 1) {
            if (i > 0) { sb.Append("、"); }
            sb.Append(ZanIDE.T(rs[i].en, rs[i].zh));
        }
        return sb.ToString();
    }

    // --- tool whitelist ------------------------------------------------------

    /// True when `roleId` may call `tool`.
    ///
    /// The whitelist is the load-bearing part of the separation: only the
    /// developer can write files, only the tester can drive the UI, and the
    /// reviewer and auditor are read-only by construction, so a member cannot
    /// quietly "fix" what it was asked to judge.
    static bool AllowsTool(string roleId, string tool) {
        if (roleId == "" || AiTeam.RoleOf(roleId) == null) { return true; }
        // Everyone may look at code and keep the plan up to date.
        if (tool == "read_file" || tool == "list_dir" || tool == "grep"
            || tool == "repo_map" || tool == "stdlib_read"
            || tool == "stdlib_grep" || tool == "plan") { return true; }
        if (roleId == AiTeam.Dev()) {
            return tool == "write_file" || tool == "edit_file"
                || tool == "build";
        }
        if (roleId == AiTeam.Qa()) {
            return tool == "run" || tool == "build" || tool == "ui_check"
                || tool == "ui_tree" || tool == "run_errors";
        }
        if (roleId == AiTeam.Rev() || roleId == AiTeam.Sec()) {
            return tool == "diff";
        }
        if (roleId == AiTeam.Art()) {
            return tool == "write_file" || tool == "edit_file";
        }
        // Product manager and architect stay read-only.
        return false;
    }

    /// The refusal handed back when a member reaches for a tool outside its
    /// remit: it names the member that owns the tool, so the model's next move
    /// is a handoff rather than another blocked attempt.
    static string DenyTool(string roleId, string tool) {
        string owner = AiTeam.Dev();
        if (tool == "ui_check" || tool == "run" || tool == "ui_tree"
            || tool == "run_errors") { owner = AiTeam.Qa(); }
        if (tool == "diff") { owner = AiTeam.Rev(); }
        return "error: '" + tool + "' is not yours to call as "
            + AiTeam.DisplayName(roleId) + ". Do not call it again -- hand the"
            + " work to @" + AiTeam.MentionToken(owner)
            + " with a [handoff] message that states what you need done.";
    }

    // --- per-member context --------------------------------------------------

    /// The private transcript of one member: what it said, what was addressed
    /// to it, its own tool results, and the user's turns.
    ///
    /// A member never sees another member's tool output or internal reasoning,
    /// which is both the isolation the user asked for and the reason six
    /// members cost far less than six full transcripts. Cross-member knowledge
    /// travels only through the envelope bodies, which forces every handoff to
    /// actually state its conclusion.
    static List<ChatMessage> ContextFor(string roleId, List<ChatMessage> msgs) {
        List<ChatMessage> outMsgs = new List<ChatMessage>();
        for (int i = 0; i < msgs.Count; i = i + 1) {
            ChatMessage m = msgs[i];
            if (AiTeam.IsAuto(m)) {
                // 内部派单只给收件人看：它不是需求，把它广播给所有人只会让每个
                // 成员都以为自己被叫到了。没写收件人的（旧存档）算公共上下文。
                if (m.to == ""
                    || AiTeam.HasStr(AiTeam.ToListOf(m), roleId)) {
                    outMsgs.Add(m);
                }
                continue;
            }
            if (m.role == "user") {
                // A user turn aimed at another member is still context the
                // team shares (it is the requirement), but it is relabelled
                // so this member does not think it was asked.
                outMsgs.Add(m);
                continue;
            }
            if (m.role == "tool" || m.role == "error") {
                // 没署名的工具结果（旧存档，或单人模式留下的）算公共上下文：
                // 宁可多看一条，也不能把成员自己刚读到的东西滤掉——滤掉的
                // 后果是它每一拍都以为自己还没查过，于是一直重发同一个调用。
                if (m.agent == "" || m.agent == roleId) { outMsgs.Add(m); }
                continue;
            }
            if (m.agent == roleId) { outMsgs.Add(m); continue; }
            if (AiTeam.HasStr(AiTeam.ToListOf(m), roleId)) {
                outMsgs.Add(m);
                continue;
            }
        }
        return outMsgs;
    }

    /// The recipients recorded on a message, as a list (the field is stored as
    /// a comma-joined string so it round-trips through the session archive
    /// without a nested array).
    static List<string> ToListOf(ChatMessage m) {
        List<string> ids = new List<string>();
        if (m.to == "") { return ids; }
        int s = 0;
        for (int i = 0; i <= m.to.Length; i = i + 1) {
            bool end = i == m.to.Length;
            bool comma = false;
            if (!end) { comma = (m.to[i] & 255) == 44; }
            if (end || comma) {
                if (i > s) { AiTeam.AddOnce(ids, m.to.Substring(s, i - s)); }
                s = i + 1;
            }
        }
        return ids;
    }

    static string ToStrOf(List<string> ids) {
        StringBuilder sb = new StringBuilder();
        for (int i = 0; i < ids.Count; i = i + 1) {
            if (i > 0) { sb.Append(","); }
            sb.Append(ids[i]);
        }
        return sb.ToString();
    }

    // --- prompts -------------------------------------------------------------

    /// The protocol every member shares: the header format, the beats, and the
    /// rules that keep the pipeline honest (no chatter, one owner at a time,
    /// park on a question instead of guessing).
    /// 协议里与成员无关的那一段（头部 + 规则 1-5）。单独拆出来是给全队共用的
    /// 系统提示用的：系统消息逐字节与成员无关，供应商的前缀缓存才跨成员命中。
    static string ProtocolHead() {
        StringBuilder sb = new StringBuilder();
        sb.Append("TEAM PROTOCOL. You are one member of a seven-member team in"
            + " a group chat with the user. Members: @产品经理 (Product"
            + " Manager), @架构师 (Architect), @素材设计师 (Asset Designer),"
            + " @开发者 (Developer), @测试工程师 (Test Engineer), @代码审查员"
            + " (Code Reviewer), @安全审计员 (Security Auditor).\n"
            + "Every message you send starts with a routing header:\n"
            + "  @<member> [<kind> <taskId>] then your text\n"
            + "Never put a percentage in the header or the text: the IDE"
            + " computes a node's progress from its checklist and the beats"
            + " that actually ran, and a number you invent is ignored.\n"
            + "Kinds: assign (hand a task over), progress (ONE line on what"
            + " just moved), handoff (your stage passed, pass it on), question"
            + " (you need the USER to decide), report (your conclusion),"
            + " block (you are stuck).\n"
            + "Examples:\n"
            + "  @架构师 [handoff T-1] 需求已确认：三条验收标准如下……\n"
            + "  [progress T-3] 校验规则写完，还剩边界用例。\n"
            + "  @开发者 [block T-3] ui_check 报 hitregion 缺失，见下。\n"
            + "RULES.\n"
            + "1. NO CHATTER, NO RESTATING. A task assigned to you needs no"
            + " acknowledgement: your first message is the work itself (a tool"
            + " call, or one [progress] line). Never repeat the task text, the"
            + " acceptance criterion, the plan, the previous message, or a"
            + " result already in the transcript above -- the user sees all of"
            + " it. Say only what is NEW in this beat, in one to three short"
            + " sentences, with no closing recap of what you just said."
            + " EVERY beat of yours carries an action: a tool call, or a"
            + " finished result. A beat that only announces what you are"
            + " about to do, or re-derives the requirement, is a wasted beat"
            + " -- make the call instead of describing it.\n"
            + "2. ONE OWNER AT A TIME. While the work is unfinished it stays"
            + " YOURS: do not @ anybody mid-way, and never @ yourself. Only"
            + " when your stage is really done -- or you are genuinely"
            + " blocked -- you address exactly one member with [handoff] /"
            + " [block] and stop. Do not do the next member's job yourself.\n"
            + "3. DEFECTS GO BACK TO THE DEVELOPER. If you find a problem,"
            + " address @开发者 with [block], and always include how to"
            + " reproduce it, what actually happened and what you expected."
            + " Never just say it is broken.\n"
            + "4. PARK ON UNCERTAINTY. If an important decision is genuinely"
            + " ambiguous, send [question] and STOP -- the user answers it."
            + " Do not guess and carry on. Route it through @产品经理 unless"
            + " the user asked you directly.\n"
            + "5. STAY IN YOUR LANE. Only the tools listed for you below are"
            + " available; the IDE refuses the rest. If you need one you do"
            + " not have, hand off to the member who owns it.\n");
        return sb.ToString();
    }

    /// 协议的收尾一条（验收流程，同样与成员无关）。
    static string ProtocolTail() {
        StringBuilder sb = new StringBuilder();
        sb.Append("7. REPORT IS AN ACCEPTANCE REQUEST, NOT THE END. When you send"
            + " [report] on a task that has an `accept` criterion, the IDE"
            + " hands it to @测试工程师 to check it against that criterion,"
            + " and only after it reports back does the node close, its"
            + " conclusion get written into the project knowledge"
            + " (.zan/knowledge.md) and the next unblocked node get assigned"
            + " automatically. So: state in [report] exactly what you"
            + " delivered and how you verified it -- that text is what gets"
            + " checked and archived. KEEP IT SHORT: five lines at most"
            + " (delivered / verified / what is left), never a blow-by-blow"
            + " of the beats you already sent. If you are the one checking,"
            + " judge only against the criterion, take your own evidence"
            + " (build / run / read the code), and answer [report] (passed)"
            + " or [block] (failed, with the evidence).\n\n");
        return sb.ToString();
    }

    /// 谁有权改任务图，写进各自的提示词里。
    ///
    /// 这就是「大家都在反复列需求、没人开工」那个断点：拆图的规矩以前发给所有
    /// 人，于是开发者接到任务的第一反应也是再拆一遍需求。图只由产品经理和架构
    /// 师维护，其他人唯一能碰计划的时候是把自己节点里做完的那一条打勾。
    static string GraphPrompt(string roleId) {
        if (AiTeam.Executor(roleId)) {
            return "6. THE BOARD IS ALREADY THERE, AND YOU BUILD, NOT PLAN."
                + " @产品经理 and @架构师 own the task graph; you never emit a"
                + " new plan and never re-list the requirement. Your node and"
                + " its checklist are in the board above: implement the next"
                + " unchecked item with your tools. The ONLY plan call you"
                + " ever make is re-sending YOUR OWN node with a finished"
                + " item marked \"[x] \" (everything you do not mention is"
                + " kept), which is how the board moves while you work."
                + " A node whose `deps` are not DONE is not startable: the IDE"
                + " refuses write_file / edit_file / build on it, so if the"
                + " node you were given waits on an unaccepted one, say"
                + " [block] naming it instead of building ahead."
                + " When the node is done you send [report] task=<id> and"
                + " STOP: @产品经理 dispatches the next node. Never pick up"
                + " another node yourself, and never assign one.\n";
        }
        StringBuilder sb = new StringBuilder();
        sb.Append("6. THE PLAN IS A TASK GRAPH, AND IT COMES FIRST. A requirement"
            + " of any size is broken into nodes with the `plan` tool BEFORE"
            + " implementation starts: the user's progress readout is"
            + " 'nodes done / nodes total', so work that exists only in the"
            + " chat looks like no progress at all. If you are asked to build"
            + " something and there is no node for it in the board above,"
            + " the first move is to emit the graph (or hand off to the one"
            + " who should). In team mode the `plan` tool's"
            + " items are the task nodes the user sees and clicks, so give"
            + " each one the fields that make it a node:\n"
            + "  {\"id\":\"T-2\", \"t\":\"前台商品展示\", \"owner\":\"开发者\","
            + " \"deps\":[\"T-1\"], \"parts\":[\"测试工程师\"],"
            + " \"accept\":\"列表、详情、搜索都能用真实数据打开\","
            + " \"tasks\":[\"商品列表页\",\"商品详情页\",\"关键字搜索\"]}\n"
            + " A NODE IS A FEATURE, NOT ONE EDIT. Cut the requirement the way"
            + " a product is cut -- for a shop: 前台商品展示 / 下单购买 /"
            + " 积分兑换 / 后台商品管理 / 后台订单管理 -- one node per"
            + " deliverable capability, front-end and back-office as separate"
            + " nodes. Then put the actual work INSIDE the node as `tasks`:"
            + " the short checklist of what has to be built for that feature."
            + " The user's plan strip shows the `tasks` of the node being"
            + " worked on, and the node's percentage is that checklist's"
            + " done-ratio, so a node with no `tasks` cannot show real"
            + " progress. Keep `tasks` at 3-8 concrete items; if a node needs"
            + " far more, it was really two nodes.\n"
            + " A NODE IS ALSO NOT A STAGE. 需求理解 / 数据模型设计 /"
            + " 安全审计 / 测试 / 验收 are NOT nodes: every node already runs"
            + " the whole pipeline inside itself (understand, survey the code,"
            + " plan, implement, build, test, verify, accept) and its `accept`"
            + " line is where acceptance lives. A board shaped 需求 -> 模型 ->"
            + " 实现 -> 安全 -> 验收 delivers nothing runnable until the last"
            + " node and tells the user nothing about what works;"
            + " 前台商品展示 / 下单购买 / 积分兑换 / 后台商品管理 does both."
            + " Cross-cutting concerns (security, performance, telemetry,"
            + " data model) belong in the `tasks` and `accept` of the nodes"
            + " they affect, not in a node of their own.\n"
            + " As you finish an item,"
            + " re-send just that node with the item marked \"[x] \" (state,"
            + " ownership and everything you did not mention are kept), which"
            + " is how the board moves while you work.\n"
            + " `deps` are the task ids that must be DONE first -- a node"
            + " whose deps are unfinished is locked in the panel and nobody"
            + " starts it. EVERY node carries `deps`, and that is what makes"
            + " the board a graph instead of a flat list: only the nodes that"
            + " can genuinely start on day one get `\"deps\":[]`, everything"
            + " else names the node(s) it waits on (design before build,"
            + " build before test, and a node that needs two upstream"
            + " results lists both). If you send a plan where no node has"
            + " any deps, the IDE assumes you meant a straight sequence and"
            + " chains the items in the order you listed them -- so wire the"
            + " real dependencies yourself when the work is not a single"
            + " line. `owner` is the one member responsible, `parts` the"
            + " others who will speak on that node, `accept` how we know it"
            + " is done. Re-send the plan (same ids) to add or re-wire nodes;"
            + " progress and state come from your [progress]/[handoff]"
            + " headers, not from the plan, so re-sending never resets"
            + " work that is already underway.\n");
        return sb.ToString();
    }

    /// The tool line for a member, so its prompt only advertises what it can
    /// actually call.
    static string ToolsPrompt(string roleId) {
        if (roleId == AiTeam.Dev()) {
            return "YOUR TOOLS: the read tools, plus edit_file, write_file,"
                + " build. You do NOT have run/ui_check (that is the test"
                + " engineer's) or diff.\n\n";
        }
        if (roleId == AiTeam.Qa()) {
            return "YOUR TOOLS: the read tools, plus build, run, ui_check,"
                + " ui_tree, run_errors. You do NOT have edit_file/write_file:"
                + " you prove the defect, the developer fixes it.\n\n";
        }
        if (roleId == AiTeam.Rev() || roleId == AiTeam.Sec()) {
            return "YOUR TOOLS: the read tools, plus diff. You are read-only"
                + " by design -- you judge the change, you never edit it.\n\n";
        }
        if (roleId == AiTeam.Art()) {
            return "YOUR TOOLS: the read tools, plus write_file and edit_file"
                + " for asset files only (icons, skins, sprite sheets, style"
                + " sheets). You do NOT have build/run: hand the assets to the"
                + " developer.\n\n";
        }
        return "YOUR TOOLS: the read tools and plan only. You do not edit,"
            + " build or run anything.\n\n";
    }

    /// The member's own charter: the configured prompt when the user wrote
    /// one in the settings, else the built-in default below.
    static string DutyPrompt(string roleId) {
        if (AiTeam.sRolePrompts != null) {
            string custom = ZanIDE.AiRoleModel(AiTeam.sRolePrompts, roleId);
            if (custom != null && custom != "") { return custom + "\n\n"; }
        }
        return AiTeam.DefaultDuty(roleId);
    }

    /// The built-in charter of a member: what it is for, what it must produce,
    /// and who it hands to. This is also what the settings window offers as
    /// the default text of a member's prompt box.
    static string DefaultDuty(string roleId) {
        if (roleId == AiTeam.Pm()) {
            return "YOUR ROLE: 产品经理 (Product Manager). You are the only member"
                + " who owns the conversation with the user.\n"
                + "- First, make the requirement unambiguous. If the request is"
                + " vague, ask the user ONE round of the few questions that"
                + " actually change the design -- do not interrogate.\n"
                + "- Then write a requirement card: goal, scope, acceptance"
                + " criteria, and explicitly what is NOT in scope.\n"
                + "- Then [handoff] to @架构师.\n"
                + "- You are also the DISPATCHER: once the graph exists you"
                + " hand out ONE node at a time ([assign] task=<id> @owner),"
                + " and only after that node is accepted do you dispatch the"
                + " next one whose deps are done. Never two nodes at once,"
                + " and never re-list the requirement when dispatching -- one"
                + " line of what to deliver is enough.\n"
                + "- The task graph belongs to @架构师: if you sketch one with"
                + " the plan tool, hand it off in the same turn. Re-sending the"
                + " plan instead of handing off is how a run stalls -- you do"
                + " not implement any node yourself.\n"
                + "- You are NOT the one who surveys the codebase: a couple of"
                + " reads to sanity-check a term is fine, but if you find"
                + " yourself grepping file after file you are doing the"
                + " architect's job -- hand off instead. Never repeat a read"
                + " you already did; its result is above in this chat.\n"
                + "- Other members route their questions through you: fold them"
                + " into one clear question for the user rather than relaying"
                + " six separate interruptions.\n"
                + "- At the end, summarise for the user what shipped and what"
                + " is still open. Do not design, do not write code.\n\n";
        }
        if (roleId == AiTeam.Arch()) {
            return "YOUR ROLE: 架构师 (Architect). You turn a requirement card"
                + " into an ordered set of task cards.\n"
                + "- Read the real code first (grep/read_file/repo_map): decide"
                + " which existing layer should change, and prefer extending it"
                + " over adding a parallel one.\n"
                + "- Emit the task board with the plan tool: each item is one"
                + " task with the files it touches and an ACCEPTANCE CRITERION"
                + " the test engineer can check without asking you.\n"
                + "- Order tasks by dependency; call out the risky one.\n"
                + "- ONE graph, then get out of the way: if the board above"
                + " already has the nodes, do not re-emit or re-describe it.\n"
                + "- Then [handoff] to @产品经理 in the same beat: it dispatches"
                + " the nodes one at a time. You do not hand nodes out"
                + " yourself, and you never write the implementation.\n\n";
        }
        if (roleId == AiTeam.Dev()) {
            return "YOUR ROLE: 开发者 (Developer). You implement one task card at"
                + " a time.\n"
                + "- Your FIRST beat on a node is a tool call: read_file /"
                + " grep the file you are about to change. No"
                + " acknowledgement, no restating the task, no plan of"
                + " your own.\n"
                + "- Then edit_file / write_file the real change. Reading"
                + " forever is not progress: after a couple of reads on a"
                + " node, the next beat edits something.\n"
                + "- Keep the edit minimal and in the surrounding style; fix the"
                + " general layer, never hard-code a value to hide the bug.\n"
                + "- build and read the errors. Do not hand off until it"
                + " compiles.\n"
                + "- Then [report] task=<id> stating what you changed"
                + " (path:line) and how to exercise it -- the IDE sends it to"
                + " acceptance and @产品经理 hands you the next node. Do not"
                + " route it yourself, and do not start another node.\n"
                + "- When a defect comes back to you, reproduce the reported"
                + " cause before editing; do not re-send a fix that already"
                + " failed.\n\n";
        }
        if (roleId == AiTeam.Qa()) {
            return "YOUR ROLE: 测试工程师 (Test Engineer). You decide whether the"
                + " change actually works, against the task's acceptance"
                + " criterion.\n"
                + "- Exercise the real program: run it, and for UI work drive"
                + " it with ui_check and read the widget geometry back with"
                + " ui_tree. Check real numbers, not your expectations.\n"
                + "- A failure report must be reproducible: the script or steps,"
                + " the actual value, the expected value.\n"
                + "- Fail -> [block] to @开发者. Pass -> [handoff] to"
                + " @代码审查员 with what you verified and what you could not.\n"
                + "- Never report a pass for something you did not execute.\n\n";
        }
        if (roleId == AiTeam.Rev()) {
            return "YOUR ROLE: 代码审查员 (Code Reviewer). You read the diff.\n"
                + "- Look for: wrong edge cases, broken invariants, changes"
                + " outside the task's scope, duplicated logic that belonged in"
                + " a shared helper, and tests or checks weakened to make"
                + " something pass.\n"
                + "- Judge consistency with the surrounding style, not your"
                + " personal taste. Cite path:line for every point.\n"
                + "- Problems -> [block] to @开发者, one concrete change each."
                + " Clean -> [handoff] to @安全审计员.\n\n";
        }
        if (roleId == AiTeam.Art()) {
            return "YOUR ROLE: 素材设计师 (Asset Designer). You produce the UI and"
                + " game assets a task needs, as files in the project.\n"
                + "- Icons and UI marks: write vector glyph / SVG-style assets"
                + " that read at 16px as well as at 64px, on one grid, in one"
                + " stroke weight.\n"
                + "- Skins and palettes: derive a full palette (surfaces, text,"
                + " border, accent, states) from the requested mood, keep text"
                + " on surface contrast readable, and write it as a skin /"
                + " style sheet the app can load.\n"
                + "- Game assets: sprite sheets, tiles and simple animation"
                + " frames at a stated pixel size, with a consistent light"
                + " direction and a named frame layout the code can index.\n"
                + "- Always state the asset's path, size, and how the code"
                + " should reference it; reuse the project's existing assets"
                + " and naming instead of inventing a parallel set.\n"
                + "- Then [handoff] to @开发者 to wire the assets in. You do not"
                + " write program logic.\n\n";
        }
        if (roleId == AiTeam.Sec()) {
            return "YOUR ROLE: 安全审计员 (Security Auditor). You audit the change"
                + " for exposure.\n"
                + "- Look for: secrets/keys/tokens in plain text, injection"
                + " (SQL/command/path), path traversal escaping the project"
                + " root, over-broad permissions, and unvalidated external"
                + " input.\n"
                + "- Say plainly what is a real risk versus a theoretical one;"
                + " do not pad the report.\n"
                + "- Findings -> [block] to @开发者. Clean -> [handoff] to"
                + " @产品经理 to close out.\n\n";
        }
        return "";
    }

    /// 全队共用的那一份系统提示：IDE/助手基础说明、团队协议、规则 6 的两种
    /// 形态，然后是七个成员各自的章程与工具清单。
    ///
    /// 它逐字节与「这一拍是谁在说话」无关，这是故意的。供应商的 prompt 缓存按
    /// **前缀**匹配：以前系统消息是 `BaseInstructions + 这个成员的协议/章程/
    /// 工具`，七个成员各自一份，而团队模式几乎每一拍都在换人，于是能命中的只有
    /// 大家共有的那一段（基础说明结尾处，实测就停在 4.9K token），后面两万
    /// token 每拍全额重算。把整份系统提示做成全队同一份之后，不管这一拍谁开口，
    /// 前缀都是同一串字节。本拍的身份改由 `SelfPrompt` 放在最后那条动态消息里
    /// （见 `ZanIDE.AiLaunchAs`）——它排在最后，换人只作废尾巴，不作废前缀。
    static string TeamPrompt() {
        StringBuilder sb = new StringBuilder();
        sb.Append(AiAgent.BaseInstructions());
        sb.Append("\n\n");
        sb.Append(AiTeam.ProtocolHead());
        sb.Append("6 COMES IN TWO FORMS -- use the one named in the YOUR ROLE"
            + " line at the end of this conversation, and ignore the other.\n"
            + "[FORM P -- planners: @产品经理 and @架构师 only]\n");
        sb.Append(AiTeam.GraphPrompt(AiTeam.Pm()));
        sb.Append("[FORM B -- builders: @素材设计师, @开发者, @测试工程师,"
            + " @代码审查员, @安全审计员]\n");
        sb.Append(AiTeam.GraphPrompt(AiTeam.Dev()));
        sb.Append(AiTeam.ProtocolTail());
        sb.Append("MEMBER CHARTERS. Below is every member's charter and tool"
            + " list, one section each. Exactly ONE of them is yours -- the"
            + " YOUR ROLE line at the end of this conversation names it. Read"
            + " your own section as your orders; the others are here only so"
            + " you know who to hand work to, and doing their job is a"
            + " protocol violation.\n\n");
        List<AiRole> rs = AiTeam.Roles();
        for (int i = 0; i < rs.Count; i = i + 1) {
            sb.Append("=== MEMBER @" + rs[i].zh + " (" + rs[i].en
                + ") -- applies when you are @" + rs[i].zh + " ===\n");
            sb.Append(AiTeam.DutyPrompt(rs[i].id));
            sb.Append(AiTeam.ToolsPrompt(rs[i].id));
        }
        return sb.ToString();
    }

    /// 「这一拍你是谁」那一小段：跟着会变的现场一起放在最后一条消息里，所以换
    /// 人不会动到前面那份共用前缀（见 `TeamPrompt` 的说明）。
    static string SelfPrompt(string roleId) {
        AiRole r = AiTeam.RoleOf(roleId);
        if (r == null) { return ""; }
        string form = "FORM B (builders)";
        if (!AiTeam.Executor(roleId)) { form = "FORM P (planners)"; }
        StringBuilder sb = new StringBuilder();
        sb.Append("YOUR ROLE THIS BEAT: you are @" + r.zh + " (" + r.en
            + "). Your orders are the section '=== MEMBER @" + r.zh
            + "' in the system prompt above, and rule 6 applies to you in "
            + form + ". Speak only as @" + r.zh
            + ": every header you write is yours, and the other members'"
            + " sections are not your instructions.\n\n");
        return sb.ToString();
    }

    // --- handoff engine (batch 2) --------------------------------------------

    /// The result of examining a member's finished reply: who the pipeline
    /// hands to next (""=stay), whether it must park for the user, and the
    /// task the beat referred to. The IDE turns `nextAgent` into the next
    /// member's turn and `awaitingUser` into the "waiting on you" banner.
    static AiTeamState Advance(AiTeamState st, string fromAgent,
            AiEnvelope env) {
        st.activeAgent = fromAgent;
        if (env.taskId != "") { st.activeTask = env.taskId; }
        st.awaitingUser = false;
        st.askedBy = "";
        // A question parks the whole pipeline: only the user may restart it,
        // and the answer routes back to whoever asked.
        if (env.kind == AiTeam.KindQuestion()) {
            st.awaitingUser = true;
            st.askedBy = fromAgent;
            return st;
        }
        // A handoff / block moves ownership to the addressed member; a defect
        // (block) always lands on the developer regardless of who was named,
        // so a mis-addressed bug report still reaches the one who can fix it.
        if (env.kind == AiTeam.KindHandoff() || env.kind == AiTeam.KindBlock()
            || env.kind == AiTeam.KindAssign()) {
            string target = "";
            if (env.to.Count > 0) { target = env.to[0]; }
            if (env.kind == AiTeam.KindBlock()) { target = AiTeam.FixOwner(); }
            // 干活的人做完不自己找下一环：交回产品经理，由它按依赖决定是送
            // 验收还是派下一个节点。否则每个成员都在自作主张地派单，任务图
            // 上的顺序就没人管了。
            if (env.kind == AiTeam.KindHandoff()
                && AiTeam.Executor(fromAgent)) {
                target = AiTeam.Dispatcher();
            }
            // 自己 @ 自己不是交接（模型常把自己的名字当抬头写）：当成「没指定
            // 收件人」，按链条交给下一环，而不是把这一拍又送回自己。
            if (target == fromAgent) { target = ""; }
            if (target == "") { target = AiTeam.NextOf(fromAgent); }
            st.activeAgent = target;
            return st;
        }
        // 一句 [ack] 里 @ 了别人，意思是「下一拍归你」，抬头选错了不该把流程
        // 卡在自己这里。但 [progress] 不算：活没完就还是自己的，干活途中提一
        // 句「回头要给测试看」不能就把这一拍交出去（交接只能是 [handoff] /
        // [block]）。Report 也不动 -- 那由验收决定下一个说话的人。
        if (env.kind != AiTeam.KindReport()
            && env.kind != AiTeam.KindProgress() && env.to.Count > 0) {
            for (int i = 0; i < env.to.Count; i = i + 1) {
                string cand = env.to[i];
                if (cand == fromAgent) { continue; }
                if (AiTeam.RoleOf(cand) == null) { continue; }
                st.activeAgent = cand;
                return st;
            }
        }
        // Otherwise ownership stays where it is: the member has more to do on
        // the same task.
        return st;
    }

    /// Who a bare "继续" after a stop or crash should wake. The parked
    /// question's owner wins (the pipeline is literally waiting on it),
    /// otherwise the member that was mid-stage; never silently restart at the
    /// product manager, which would drop the in-flight task.
    static string ResumeTarget(AiTeamState st) {
        if (st.awaitingUser && st.askedBy != "") { return st.askedBy; }
        if (st.activeAgent != "" && AiTeam.RoleOf(st.activeAgent) != null) {
            return st.activeAgent;
        }
        return AiTeam.Pm();
    }

    /// The continue directive injected as the resumed member's next turn, so
    /// it picks up its own stage instead of re-greeting the user.
    static string ResumePrompt(AiTeamState st) {
        string who = AiTeam.DisplayName(AiTeam.ResumeTarget(st));
        StringBuilder sb = new StringBuilder();
        sb.Append("[auto] 恢复中断的流程。本拍执行人：" + who + "。");
        if (st.activeTask != "") {
            sb.Append("当前任务 " + st.activeTask + "。");
        }
        if (st.awaitingUser) {
            sb.Append("用户刚刚回答了你之前的提问，据此继续，不要从头开始。");
        } else {
            sb.Append("从你上次停下的地方继续本阶段，不要重新问需求、不要从头开始。");
        }
        return sb.ToString();
    }

    // --- per-member context compression (batch 2) ----------------------------

    /// How many of a member's most recent messages stay verbatim; older ones
    /// are eligible to be folded into one digest. Kept small on purpose --
    /// the point of the digest is that the recent exchange is enough to keep
    /// working and everything durable is pinned separately.
    static int KeepRecent() { return 8; }

    /// A message that must never be compressed away: the task cards a member
    /// owns and the user's turns (the requirement and the decisions). Folding
    /// these would lose the pipeline's state, which is exactly the failure the
    /// user called out.
    static bool IsPinned(ChatMessage m) {
        if (m.role == "user") { return true; }
        if (m.kind == AiTeam.KindAssign()) { return true; }
        if (m.kind == AiTeam.KindQuestion()) { return true; }
        return false;
    }

    /// Given one member's private context, the indices of the messages to fold
    /// into a digest: everything past the recent window that is not pinned.
    /// Returns an empty list when the context is short enough to leave alone,
    /// so compression only ever runs when it is actually needed.
    static List<int> Compressible(List<ChatMessage> ctx) {
        List<int> outIx = new List<int>();
        int keepFrom = ctx.Count - AiTeam.KeepRecent();
        if (keepFrom <= 0) { return outIx; }
        for (int i = 0; i < keepFrom; i = i + 1) {
            if (!AiTeam.IsPinned(ctx[i])) { outIx.Add(i); }
        }
        return outIx;
    }

    /// The instruction handed to a member to compress its own old turns: it
    /// writes a three-part digest (settled conclusions / files touched / open
    /// questions) so the summary is traceable, not a blind truncation.
    static string CompressPrompt() {
        return "[auto] 你的上下文较长，请把较早的历史压缩成一条摘要，分三段："
            + "1) 已确定的结论与决策；2) 已改动的文件（path:line）；"
            + "3) 未解决的问题。只输出摘要，保留任务号与验收标准，不要丢状态。";
    }

    // --- mention addressing --------------------------------------------------

    /// The @token that addresses a member: an address ends at the first space,
    /// so an English title ("Code Reviewer") cannot be one -- the id is used
    /// there. A Chinese name has no space and is what the user reads.
    static string MentionToken(string roleId) {
        AiRole r = AiTeam.RoleOf(roleId);
        if (r == null) { return roleId; }
        return ZanIDE.T(r.id, r.zh);
    }

    // --- presentation helpers (batch 4) --------------------------------------

    /// The Tag/Avatar class that colours a member everywhere it appears, so the
    /// roster, the task board and the transcript agree on who is who.
    static string RoleTagClass(string id) {
        if (id == AiTeam.Pm()) { return "primary"; }
        if (id == AiTeam.Arch()) { return "info"; }
        if (id == AiTeam.Dev()) { return "success"; }
        if (id == AiTeam.Qa()) { return "warning"; }
        if (id == AiTeam.Rev()) { return "info"; }
        if (id == AiTeam.Sec()) { return "danger"; }
        if (id == AiTeam.Art()) { return "primary"; }
        return "";
    }

    /// A protocol beat as a short chip label: the reader only needs the beat and
    /// the percentage, the prose behind it stays foldable.
    static string KindLabel(string kind) {
        if (kind == AiTeam.KindAssign()) { return ZanIDE.T("assigned", "派单"); }
        if (kind == AiTeam.KindAck()) { return ZanIDE.T("acked", "收到"); }
        if (kind == AiTeam.KindProgress()) { return ZanIDE.T("progress", "进度"); }
        if (kind == AiTeam.KindHandoff()) { return ZanIDE.T("handoff", "交接"); }
        if (kind == AiTeam.KindQuestion()) { return ZanIDE.T("question", "待确认"); }
        if (kind == AiTeam.KindReport()) { return ZanIDE.T("report", "汇报"); }
        if (kind == AiTeam.KindBlock()) { return ZanIDE.T("defect", "问题"); }
        if (kind == AiTeam.KindDeps()) {
            return ZanIDE.T("upstream", "前置产出");
        }
        return "";
    }

    // --- task board (batch 4) ------------------------------------------------

    static int TaskTodo() { return 0; }
    static int TaskAcked() { return 1; }
    static int TaskDoing() { return 2; }
    static int TaskBlocked() { return 3; }
    static int TaskReview() { return 4; }
    static int TaskDone() { return 5; }

    /// The board state a protocol beat implies for the task it names.
    static int TaskStateOf(string kind, int cur) {
        if (kind == AiTeam.KindAck()) { return AiTeam.TaskAcked(); }
        if (kind == AiTeam.KindProgress()) { return AiTeam.TaskDoing(); }
        if (kind == AiTeam.KindBlock()) { return AiTeam.TaskBlocked(); }
        if (kind == AiTeam.KindHandoff()) { return AiTeam.TaskReview(); }
        // 汇报是「我交活了」，不是「这活验收过了」：完成只能由验收给出
        // （AiTeamAccept），否则一句 [report] 就把节点跳成 100%，而验收
        // 其实还没跑，下游也会跟着提前解锁。
        if (kind == AiTeam.KindReport()) { return AiTeam.TaskReview(); }
        // 派活只对还没开始的节点有意义：已经在跑 / 已交接 / 已完成的节点
        // 不能被一句 [assign] 摸回「待办」，否则状态条会说「无进行中节点」。
        if (kind == AiTeam.KindAssign()) {
            if (cur > AiTeam.TaskTodo()) { return cur; }
            return AiTeam.TaskTodo();
        }
        return cur;
    }

    static string TaskStateName(int st) {
        if (st == AiTeam.TaskAcked()) { return ZanIDE.T("acked", "已认领"); }
        if (st == AiTeam.TaskDoing()) { return ZanIDE.T("doing", "进行中"); }
        if (st == AiTeam.TaskBlocked()) { return ZanIDE.T("blocked", "待修复"); }
        if (st == AiTeam.TaskReview()) { return ZanIDE.T("handed off", "已交接"); }
        if (st == AiTeam.TaskDone()) { return ZanIDE.T("done", "已完成"); }
        return ZanIDE.T("todo", "待办");
    }

    /// The Tag class that colours a board state, so the board reads at a glance
    /// without anybody drawing a status dot by hand.
    static string TaskStateClass(int st) {
        if (st == AiTeam.TaskBlocked()) { return "danger"; }
        if (st == AiTeam.TaskDone()) { return "success"; }
        if (st == AiTeam.TaskDoing()) { return "primary"; }
        if (st == AiTeam.TaskReview()) { return "warning"; }
        return "";
    }

    static int IndexOfTask(List<AiTask> tasks, string id) {
        for (int i = 0; i < tasks.Count; i = i + 1) {
            if (tasks[i].id == id) { return i; }
        }
        return 0 - 1;
    }

    /// Folds one envelope into the board. A task appears the first time anybody
    /// names it and then only moves forward in progress, so a member reporting
    /// "40%" after another said "80%" cannot make the board walk backwards.
    static void ApplyToTasks(List<AiTask> tasks, string owner,
            AiEnvelope env) {
        if (env.taskId == "") { return; }
        int at = AiTeam.IndexOfTask(tasks, env.taskId);
        if (at < 0) {
            AiTask t = AiTask.Create(env.taskId,
                AiTeam.TaskTitleOf(env.body), owner);
            tasks.Add(t);
            at = tasks.Count - 1;
        }
        AiTask cur = tasks[at];
        cur.owner = owner;
        int next = AiTeam.TaskStateOf(env.kind, cur.state);
        // 前置没验收的节点不会因为「有人开口说在做它」就变成进行中：图上画了
        // 依赖、板上却显示下游已经在跑（上游还挂着「已交接」），说的就是这条。
        // 真正开工的闸门在工具那一层，这里只管别把状态写成开工过。
        bool locked = AiTeam.LockedTask(tasks, cur.id);
        if (locked && (next == AiTeam.TaskDoing()
                || next == AiTeam.TaskReview()
                || next == AiTeam.TaskDone())) {
            next = cur.state;
        }
        cur.state = next;
        // 模型自报的那个百分比不进节点：它是一句话里的数字，跟这个节点真的
        // 打了几个勾、跑到第几拍没有任何关系（同一次执行里一个节点写着 45%、
        // 另一个 30%，而清单是 1/6 和 0/5，就是这么来的）。进度只有两个来源：
        // 节点自己的清单（AiTaskPlan.Fold）和这一次交付的拍数
        // （ZanIDE.AiRunPct），信封里的数字只留在那条消息的徽标上供参考。
        if (cur.state == AiTeam.TaskDone()) {
            cur.progress = 100;
            AiTaskPlan.MarkAllDone(cur);
        }
        // 100% 就是「验收过了」的同义词：还没完成的节点即使自报一百，也只
        // 显示到 95，最后那一档留给验收（和 AiGraphReopen 把 100 退回 90 同理）。
        if (cur.state != AiTeam.TaskDone() && cur.progress >= 100) {
            cur.progress = 95;
        }
        if (cur.title == "") { cur.title = AiTeam.TaskTitleOf(env.body); }
        AiTeam.TouchPart(cur, owner);
        // 交接和汇报是这个节点「交付了什么」的唯一权威说法，所以它们的正文
        // 就是节点产出；后继节点解锁时注入的正是这一段。
        if (env.kind == AiTeam.KindHandoff() || env.kind == AiTeam.KindReport()) {
            AiTeam.NoteOutcome(cur, env.body);
        }
    }

    // --- task graph: deps, participants, outcomes -----------------------------

    /// The task with `id`, or null. The board is small (a plan, not a database),
    /// so a linear scan is the whole index.
    static AiTask TaskOf(List<AiTask> tasks, string id) {
        int at = AiTeam.IndexOfTask(tasks, id);
        if (at < 0) { return null; }
        return tasks[at];
    }

    /// 本任务还没完成的前置 id。图里查不到的前置被忽略——模型写错一个任务号
    /// 不该把整条链永久锁死；查得到但未完成的一律阻塞。
    static List<string> PendingDeps(List<AiTask> tasks, string id) {
        List<string> miss = new List<string>();
        AiTask t = AiTeam.TaskOf(tasks, id);
        if (t == null || t.deps == null) { return miss; }
        for (int i = 0; i < t.deps.Count; i = i + 1) {
            AiTask p = AiTeam.TaskOf(tasks, t.deps[i]);
            if (p == null) { continue; }
            if (p.state == AiTeam.TaskDone()) { continue; }
            AiTeam.AddOnce(miss, t.deps[i]);
        }
        return miss;
    }

    /// True while any dependency is unfinished: the node may be read and
    /// discussed but not started.
    static bool LockedTask(List<AiTask> tasks, string id) {
        return AiTeam.PendingDeps(tasks, id).Count > 0;
    }

    /// 点到锁着的节点时给用户看的原因：卡在哪几个前置、它们叫什么、现在什么
    /// 状态。只说事实，不猜什么时候能解锁。
    static string BlockedWhy(List<AiTask> tasks, string id) {
        List<string> miss = AiTeam.PendingDeps(tasks, id);
        if (miss.Count == 0) { return ""; }
        StringBuilder sb = new StringBuilder();
        sb.Append(ZanIDE.T("blocked by ", "前置未完成："));
        for (int i = 0; i < miss.Count; i = i + 1) {
            if (i > 0) { sb.Append("; "); }
            sb.Append(miss[i]);
            AiTask p = AiTeam.TaskOf(tasks, miss[i]);
            if (p != null) {
                if (p.title != "") { sb.Append(" " + p.title); }
                sb.Append(" [" + AiTeam.TaskStateName(p.state) + "]");
            }
        }
        return sb.ToString();
    }

    static void AddDep(AiTask t, string depId) {
        if (t == null || depId == "" || depId == t.id) { return; }
        if (t.deps == null) { t.deps = new List<string>(); }
        AiTeam.AddOnce(t.deps, depId);
    }

    /// 本节点上某角色的参与记录，没有就建一条。按 role 查，所以谁先发言、
    /// 记录怎么排序都不影响能不能找到。
    static AiTaskPart PartOf(AiTask t, string roleId) {
        if (t == null || roleId == "") { return null; }
        if (t.parts == null) { t.parts = new List<AiTaskPart>(); }
        for (int i = 0; i < t.parts.Count; i = i + 1) {
            if (t.parts[i].role == roleId) { return t.parts[i]; }
        }
        AiTaskPart p = AiTaskPart.Create(roleId);
        t.parts.Add(p);
        return p;
    }

    /// 把一个角色记为本节点的参与者，不计轮（计划里提名、从文件读回都走这里）。
    static void AddPart(AiTask t, string roleId) {
        AiTaskPart p = AiTeam.PartOf(t, roleId);
        if (p == null) { return; }
        if (p.model == "") { p.model = AiTeam.ModelOf(roleId); }
    }

    /// 该角色在本节点又说了一轮：轮数 +1、时间戳刷新、模型按当时配置记下。
    static void TouchPart(AiTask t, string roleId) {
        AiTaskPart p = AiTeam.PartOf(t, roleId);
        if (p == null) { return; }
        p.rounds = p.rounds + 1;
        p.lastTs = DateTime.UtcNow().ToUnixSeconds();
        string m = AiTeam.ModelOf(roleId);
        if (m != "") { p.model = m; }
    }

    /// 参与者的角色 id 表，给只关心「有谁」的调用方（卡片头像行、提示词）。
    static List<string> PartRoles(AiTask t) {
        List<string> ids = new List<string>();
        if (t == null || t.parts == null) { return ids; }
        for (int i = 0; i < t.parts.Count; i = i + 1) {
            if (t.parts[i].role == "") { continue; }
            AiTeam.AddOnce(ids, t.parts[i].role);
        }
        return ids;
    }

    /// Records what a node delivered. Later beats replace the earlier summary
    /// on purpose: the last handoff/report is the current truth about the node.
    static void NoteOutcome(AiTask t, string body) {
        if (t == null) { return; }
        string s = AiAgent.Trim(body);
        if (s == "") { return; }
        if (s.Length > 600) { s = AiAgent.Clip(s, 600); }
        t.outcome = s;
    }

    /// 前置节点的产出，拼成注入后继节点上下文头部的一段。依赖不只是解锁开关，
    /// 也是上下文的传递路径：后继读这一段就够，不用重读前置的全部对话。
    static string DepsBrief(List<AiTask> tasks, string id) {
        AiTask t = AiTeam.TaskOf(tasks, id);
        if (t == null || t.deps == null || t.deps.Count == 0) { return ""; }
        StringBuilder sb = new StringBuilder();
        for (int i = 0; i < t.deps.Count; i = i + 1) {
            AiTask p = AiTeam.TaskOf(tasks, t.deps[i]);
            if (p == null || p.outcome == "") { continue; }
            sb.Append("- " + p.id);
            if (p.title != "") { sb.Append(" " + p.title); }
            if (p.owner != "") {
                sb.Append("（" + AiTeam.DisplayName(p.owner) + "）");
            }
            sb.Append("：" + p.outcome + "\n");
        }
        if (sb.Length == 0) { return ""; }
        return ZanIDE.T("[upstream results]\n", "[前置产出]\n") + sb.ToString();
    }

    /// 当前任务图那一段提示词，由宿主在图变化时写进来（每帧重拼一遍全图是
    /// 白花的钱）。没有这一段时模型看不见自己拆出来的图，既不知道现在开着
    /// 哪个节点、哪几个能开工，也就无从修改它。
    static string gBoard;

    static void SetBoard(string s) { AiTeam.gBoard = s; }

    static string Board() {
        if (AiTeam.gBoard == null) { return ""; }
        return AiTeam.gBoard;
    }

    /// 任务图的现状 + 「怎么改它」：节点一行一条（负责人、状态、进度、依赖、
    /// 验收标准），标出当前打开的节点和现在能开工的节点。改图的手段就是重发
    /// `plan`——带上已有 id 的条目只更新那几个字段，新 id 就是新增节点，所以
    /// 在任何节点上聊出来的新需求都能挂进图里，而不用另起一套接口。
    static string BoardBrief(List<AiTask> tasks, string cur) {
        if (tasks == null || tasks.Count == 0) { return ""; }
        StringBuilder sb = new StringBuilder();
        sb.Append("TASK GRAPH (project .zan/tasks.json; each node has its own"
            + " multi-round context in .zan/tasks.db):\n");
        for (int i = 0; i < tasks.Count; i = i + 1) {
            AiTask t = tasks[i];
            sb.Append("- " + t.id);
            if (t.title != "") { sb.Append(" " + t.title); }
            sb.Append(" [" + AiTeam.TaskStateName(t.state) + " "
                + Convert.ToString(t.progress) + "%]");
            if (t.owner != "") { sb.Append(" owner=@" + t.owner); }
            if (t.deps != null && t.deps.Count > 0) {
                sb.Append(" deps=" + AiTeam.JoinIds(t.deps));
            }
            if (t.accept != "") { sb.Append(" accept=" + t.accept); }
            if (t.outcome != "") { sb.Append(" outcome=" + t.outcome); }
            string brief = AiTaskPlan.Brief(t);
            if (brief != "") { sb.Append(" tasks=" + brief); }
            sb.Append("\n");
        }
        if (cur != "") {
            sb.Append("OPEN NODE: " + cur + " -- the turns below are THIS"
                + " node's own context, not the whole project chat.\n");
            // 开着的那个节点把自己的活逐条列出来：图上只看得见「功能」，
            // 真要干的是这几条，而不列出来模型就又去重新编一份。
            AiTask co = AiTeam.TaskOf(tasks, cur);
            List<AiPlanStep> its = AiTaskPlan.ItemsOf(co);
            if (its.Count > 0) {
                sb.Append("THIS NODE'S CHECKLIST (re-send this node via plan"
                    + " with \"[x] \" on an item as you finish it):\n");
                int open = AiAgent.PlanFirstOpen(its);
                for (int k = 0; k < its.Count; k = k + 1) {
                    string mark = "[ ] ";
                    if (its[k].done != 0) { mark = "[x] "; }
                    string lead = "  ";
                    if (k == open) { lead = "->"; }
                    sb.Append(lead + " " + mark + its[k].text + "\n");
                }
                // 逐条列出来还不够：不点名「现在做哪一条」，模型就会在同一
                // 个节点里东挑一条西挑一条，看着毫无顺序。
                if (open >= 0) {
                    sb.Append("Work the item marked -> ("
                        + AiAgent.CurStepText(its) + ") to the end before you"
                        + " touch a later one: retrieve for it, change code for"
                        + " it, verify it, then re-send this node with it"
                        + " marked [x]. Keep each item's wording identical --"
                        + " rewording it loses its [x].\n");
                } else {
                    sb.Append("Every item is [x]: report this node with"
                        + " [report] instead of finding more work in it.\n");
                }
            }
        } else {
            sb.Append("OPEN NODE: none (project-level conversation).\n");
        }
        List<string> ready = AiTeam.ReadyTasks(tasks);
        if (ready.Count > 0) {
            sb.Append("READY (deps satisfied): " + AiTeam.JoinIds(ready)
                + "\n");
        }
        sb.Append("The graph is EDITABLE and you maintain it: re-send the"
            + " plan tool with items carrying the SAME id to change a node's"
            + " title/owner/deps/accept, and a NEW id to add one. A new"
            + " requirement raised while working on a node becomes its own"
            + " node depending on this one -- do not silently widen the node"
            + " you are on. State and progress come from your"
            + " [progress]/[handoff]/[done] envelopes, not from plan.\n\n");
        return sb.ToString();
    }

    // --- 自动验收 / 自动接下一个任务 ------------------------------------------

    /// 验收的人：测试工程师。验收必须换一个人做，报完成的人自己说「通过」不
    /// 算验收——这一条就是「执行验收结束」里的验收。
    static string Verifier() { return AiTeam.Qa(); }

    /// 报完成的这一拍要不要先送去验收：写了验收标准、而且报的人不是验收人。
    /// 没写验收标准就没有可对的东西，硬塞一拍只是空转。
    static bool NeedsAccept(AiTask t, string from) {
        if (t == null) { return false; }
        if (AiAgent.Trim(t.accept) == "") { return false; }
        return from != AiTeam.Verifier();
    }

    /// 交给验收人的指令：只对着验收标准判，通过就 [report]，不通过就 [block]
    /// 回开发——两个出口都已经在协议里，所以这里不引入新状态。
    static string AcceptPrompt(AiTask t) {
        StringBuilder sb = new StringBuilder();
        sb.Append("[auto] 请验收任务 " + t.id);
        if (t.title != "") { sb.Append("（" + t.title + "）"); }
        sb.Append("。验收标准：\n" + AiAgent.Trim(t.accept) + "\n");
        if (AiAgent.Trim(t.outcome) != "") {
            sb.Append("交付说明：\n" + AiAgent.Trim(t.outcome) + "\n");
        }
        sb.Append("按标准逐条核对，需要就自己编译 / 运行 / 读代码取证，不要只"
            + "看它怎么说。通过就回 [report] task=" + t.id
            + " 并写清核对结果；不通过回 [block] task=" + t.id
            + " 说清哪条不达标、证据是什么。");
        return sb.ToString();
    }

    /// 验收通过后自动接的下一个节点：前置全齐、还没完成，排在最前的那个。
    /// 没有就返回 null（整条链跑完，或剩下的都被前置卡着）。
    static AiTask NextReady(List<AiTask> tasks, string doneId) {
        List<string> ready = AiTeam.ReadyTasks(tasks);
        for (int i = 0; i < ready.Count; i = i + 1) {
            if (ready[i] == doneId) { continue; }
            AiTask t = AiTeam.TaskOf(tasks, ready[i]);
            if (t == null) { continue; }
            return t;
        }
        return null;
    }

    /// 正在跑的那个节点（进行中或验收中）：同一时刻只允许一个，所以派单前先
    /// 看有没有人手上还有活，有就不要再开第二个。
    static AiTask InFlight(List<AiTask> tasks) {
        if (tasks == null) { return null; }
        for (int i = 0; i < tasks.Count; i = i + 1) {
            if (tasks[i].state == AiTeam.TaskDoing()
                || tasks[i].state == AiTeam.TaskReview()) {
                return tasks[i];
            }
        }
        return null;
    }

    /// 挂在「已交接（验收中）」却一直没有验收结论的那个节点。
    ///
    /// 送去验收的那一拍只要没回 [report]/[block]（说了两句就停、或者话头被别的
    /// 节点带走），节点就一直停在验收中——而它又是下游的 `deps`，整张图都被它
    /// 挡住（用户看到的「上游还挂着已交接，进度 96% 一直不动」）。所以派下一个
    /// 节点之前先看有没有这种欠着结论的节点。
    static AiTask AwaitingAccept(List<AiTask> tasks) {
        if (tasks == null) { return null; }
        for (int i = 0; i < tasks.Count; i = i + 1) {
            if (tasks[i].state == AiTeam.TaskReview()) { return tasks[i]; }
        }
        return null;
    }

    /// 同一个节点最多催几次验收：催不动就是验收这一拍本身有问题（标准没法判、
    /// 交付说明缺证据），再催只会把同一段话刷屏，那时挂起节点交给用户。
    static int MaxReviewChases() { return 2; }

    /// 催验收的指令：把原来的验收要求原样再给一遍，并说清「不回结论下游全都
    /// 开不了工」——只有 [report]/[block] 两个出口，不引入新状态。
    static string ChaseAcceptPrompt(AiTask t, int times) {
        StringBuilder sb = new StringBuilder();
        sb.Append("[auto] " + t.id + " 还挂在「验收中」，上一拍没有给出验收"
            + "结论（第 " + Convert.ToString(times) + " 次催办）。这个节点是下游的"
            + "前置，不验收下游一个都开不了工。\n");
        sb.Append(AiTeam.AcceptPrompt(t));
        sb.Append("\n这一拍必须以 [report] 或 [block] 收尾，别只描述你打算"
            + "怎么核对；缺证据就自己读代码 / 编译 / 运行去取。");
        return sb.ToString();
    }

    /// 一个节点验收过了之后交回产品经理的指令：它这一拍只做调度——把下一个
    /// 能开工的节点派给负责人。派单以外的话（重述需求、再发一份计划）就是
    /// 用户看到的那种「反复列需求不开工」。
    static string DispatchPrompt(string doneId, AiTask nx) {
        StringBuilder sb = new StringBuilder();
        sb.Append("[auto] " + doneId + " 已验收通过，结论已写进项目知识。");
        if (nx == null) {
            sb.Append("图上暂时没有能开工的节点了：要么向用户交代这一轮的结果，"
                + "要么说清还卡在哪个前置。");
            return sb.ToString();
        }
        sb.Append("你这一拍只做一件事——派下一个节点：\n");
        sb.Append("  " + nx.id);
        if (nx.title != "") { sb.Append("（" + nx.title + "）"); }
        string who = AiTeam.OwnerOf(nx);
        sb.Append(" → @" + AiTeam.DisplayName(who) + "\n");
        sb.Append("回一条 [assign] task=" + nx.id + " @"
            + AiTeam.DisplayName(who)
            + "，一句话说清这个节点要交付什么就够了。不要重述需求、不要重发"
            + "计划、不要同时派两个节点；有真需要用户定的事才 [question]。");
        return sb.ToString();
    }

    /// 自动派下一个任务的指令。前置产出摘要由调用方附在后面（同一条消息里），
    /// 所以接手的人不必回头读前置的整段对话。
    static string NextPrompt(AiTask t, string doneId) {
        StringBuilder sb = new StringBuilder();
        sb.Append("[auto] " + doneId + " 已验收通过，按计划接下一个任务 " + t.id);
        if (t.title != "") { sb.Append("（" + t.title + "）"); }
        sb.Append("。直接开工，不用回「收到」；");
        if (AiAgent.Trim(t.accept) != "") {
            sb.Append("这个任务的验收标准是：\n" + AiAgent.Trim(t.accept) + "\n");
        }
        sb.Append("做完回 [report] task=" + t.id
            + "，说清交付了什么、怎么验证的。计划要改就重发 plan。");
        return sb.ToString();
    }

    /// 派单给节点负责人的指令。跟 `NextPrompt` 的区别只在由头：那条是「前一个
    /// 节点验收过了」，这条是「图已经拆好了、这个节点该你干」——图一落地就得有
    /// 人接手，否则拆活儿的人只会被反复叫回来再拆一遍。
    static string AssignPrompt(AiTask t, string who) {
        StringBuilder sb = new StringBuilder();
        sb.Append("[auto] 按任务图派单。本拍执行人："
            + AiTeam.DisplayName(who) + "，这个节点归你——" + t.id);
        if (t.title != "") { sb.Append("（" + t.title + "）"); }
        sb.Append("。直接动手做这个节点自己的活（不用回「收到」，也别重述计划、"
            + "别把别人节点的活揽过来）。\n");
        List<AiPlanStep> its = AiTaskPlan.ItemsOf(t);
        if (its.Count > 0) {
            sb.Append("这个节点要干的活：\n");
            for (int i = 0; i < its.Count; i = i + 1) {
                string mark = "[ ] ";
                if (its[i].done != 0) { mark = "[x] "; }
                sb.Append("  " + mark + its[i].text + "\n");
            }
        }
        if (AiAgent.Trim(t.accept) != "") {
            sb.Append("验收标准：\n" + AiAgent.Trim(t.accept) + "\n");
        }
        sb.Append(AiTeam.TickHint(t));
        sb.Append("做完回 [report] task=" + t.id
            + " 说清交付了什么、怎么验证的；真有需要用户定的事才 [question]。");
        return sb.ToString();
    }

    /// 「干完一条怎么把它勾上」。节点百分比只从这份清单和真跑过的拍数算，而勾选
    /// 只有重发 plan（把做完的那条写成 "[x] ..."）才会打上：不说这件事，模型
    /// 就在正文里写个 100%，于是图上出现「进行到 95% 而清单 0/5」。
    static string TickHint(AiTask t) {
        int n = AiTaskPlan.CountOf(t);
        if (n == 0) { return ""; }
        return "每干完一条就用 plan 工具把这个节点连同整份 tasks 重发一次，做完的那条"
            + "写成 \"[x] ...\"：节点进度就是这份清单的完成比，正文里写百分比不会让它"
            + "动一格（也不要写）。\n";
    }

    /// 该派给谁：节点写了负责人就按它，没写（或写成产品经理——它不写代码）就
    /// 按固定链条交给产品经理的下一环。
    static string OwnerOf(AiTask t) {
        if (t == null) { return ""; }
        string who = AiAgent.Trim(t.owner);
        if (who == "" || who == AiTeam.Pm()) {
            return AiTeam.NextOf(AiTeam.Pm());
        }
        return who;
    }

    /// 验收通过后落进项目知识的那一段（`.zan/knowledge.md` 的一节）。写的是
    /// 结论而不是过程：下一次开工的人要的是「这里已经定成什么样」，不是当时
    /// 聊了多少拍。
    static string NoteSection(AiTask t, string verdict) {
        StringBuilder sb = new StringBuilder();
        sb.Append("\n## " + t.id);
        if (t.title != "") { sb.Append(" " + t.title); }
        sb.Append("\n");
        if (t.owner != "") {
            sb.Append("- 负责人：@" + AiTeam.DisplayName(t.owner) + "\n");
        }
        if (AiAgent.Trim(t.accept) != "") {
            sb.Append("- 验收标准：" + AiTeam.OneLine(t.accept) + "\n");
        }
        if (AiAgent.Trim(t.outcome) != "") {
            sb.Append("- 产出：" + AiTeam.OneLine(t.outcome) + "\n");
        }
        string v = AiAgent.Trim(verdict);
        if (v != "") { sb.Append("- 验收结论：" + AiTeam.OneLine(v) + "\n"); }
        return sb.ToString();
    }

    /// 折成一行：知识条目是给人扫的，多行正文塞进列表项里会把结构撑烂。
    static string OneLine(string s) {
        StringBuilder sb = new StringBuilder();
        bool sp = false;
        string t = AiAgent.Trim(s);
        for (int i = 0; i < t.Length; i = i + 1) {
            string ch = t.Substring(i, 1);
            if (ch == "\n" || ch == "\r" || ch == "\t") {
                sp = true;
                continue;
            }
            if (sp && sb.Length > 0) { sb.Append(" "); }
            sp = false;
            sb.Append(ch);
        }
        string one = sb.ToString();
        if (one.Length > 600) { one = AiAgent.Clip(one, 600) + "..."; }
        return one;
    }

    /// 现在可以开工的节点：自己未完成、前置全齐。面板用它提示「接下来能做
    /// 哪几个」，模型也用它决定下一步派单给谁。
    static List<string> ReadyTasks(List<AiTask> tasks) {
        List<string> ids = new List<string>();
        for (int i = 0; i < tasks.Count; i = i + 1) {
            if (tasks[i].state == AiTeam.TaskDone()) { continue; }
            if (AiTeam.LockedTask(tasks, tasks[i].id)) { continue; }
            ids.Add(tasks[i].id);
        }
        return ids;
    }

    /// 团队模式下 `plan` 工具的一次调用即一张任务图：`items` 里每项除了标题，
    /// 还可以带 `id` / `owner` / `deps` / `accept` / `parts`。已存在的节点只更新
    /// 图信息，状态和进度留给协议信封推进——重发一次计划不该把进行中的节点
    /// 打回待办。返回图里的节点总数。
    static int ParseGraph(string json, List<AiTask> tasks) {
        JsonValue v = JsonValue.ParseLenient(json);
        if (v == null) { return tasks.Count; }
        JsonValue items = v.Get("items");
        if (items == null || !items.IsArray()) { return tasks.Count; }
        // 本次计划里出现的节点次序，以及模型到底有没有说过前置：没说过和
        // 说了「没有前置」是两件事，前者才需要 IDE 替它连线。
        List<string> order = new List<string>();
        bool told = false;
        for (int i = 0; i < items.Count(); i = i + 1) {
            JsonValue it = items.At(i);
            if (!it.IsObject()) { continue; }
            string id = AiAgent.Trim(it.Str("id", ""));
            string title = AiAgent.Trim(it.Str("t", it.Str("text",
                it.Str("title", ""))));
            if (id == "" && title == "") { continue; }
            if (id == "") { id = "T-" + Convert.ToString(i + 1); }
            AiTask t = AiTeam.TaskOf(tasks, id);
            if (t == null) {
                t = AiTask.Create(id, title, "");
                tasks.Add(t);
            } else if (title != "") {
                t.title = title;
            }
            string owner = AiTeam.RoleIdArg(it.Str("owner", it.Str("o", "")));
            if (owner != "") { t.owner = owner; }
            string accept = AiAgent.Trim(it.Str("accept", it.Str("ac", "")));
            if (accept != "") { t.accept = accept; }
            if (it.Get("deps") != null) { told = true; }
            // 节点内的开发任务清单：功能节点下面那几件具体的活。
            JsonValue sub = it.Get("tasks");
            if (sub == null) { sub = it.Get("items"); }
            if (sub == null) { sub = it.Get("steps"); }
            AiTaskPlan.ReadItems(sub, t);
            AiTeam.ReadIds(it.Get("deps"), t, true);
            AiTeam.ReadIds(it.Get("parts"), t, false);
            AiTeam.AddOnce(order, id);
        }
        if (!told) { AiTeam.ChainOrder(tasks, order); }
        return tasks.Count;
    }

    /// 一个 `deps` 都没写的计划：把这次列出的节点按给出的次序串成一条链。
    /// 没有连线的任务图退化成一排卡片——看不出先后，也就没有「谁在等谁」
    /// 和「现在能开工的是哪个」，而列出来的次序正是模型心里的顺序。只补
    /// 空缺：已经有前置的节点不动，所以下一次带 deps 的重发能把链改成真
    /// 正的分叉。
    static void ChainOrder(List<AiTask> tasks, List<string> ids) {
        if (ids == null || ids.Count < 2) { return; }
        for (int i = 1; i < ids.Count; i = i + 1) {
            AiTask t = AiTeam.TaskOf(tasks, ids[i]);
            if (t == null) { continue; }
            if (t.deps != null && t.deps.Count > 0) { continue; }
            AiTeam.AddDep(t, ids[i - 1]);
        }
    }

    /// Folds a JSON `deps`/`parts` value into the task. Both a real array and
    /// the comma-separated string models keep emitting instead are accepted, so
    /// a well-meant `"deps": "T-1, T-2"` is not silently dropped.
    static void ReadIds(JsonValue v, AiTask t, bool asDeps) {
        if (v == null) { return; }
        List<string> ids = new List<string>();
        if (v.IsArray()) {
            for (int i = 0; i < v.Count(); i = i + 1) {
                ids.Add(AiAgent.Trim(v.At(i).AsString("")));
            }
        } else {
            string s = v.AsString("");
            int start = 0;
            for (int i = 0; i <= s.Length; i = i + 1) {
                bool end = i == s.Length;
                bool comma = false;
                if (!end) { comma = (s[i] & 255) == 44; }
                if (end || comma) {
                    ids.Add(AiAgent.Trim(s.Substring(start, i - start)));
                    start = i + 1;
                }
            }
        }
        for (int k = 0; k < ids.Count; k = k + 1) {
            if (ids[k] == "") { continue; }
            if (asDeps) { AiTeam.AddDep(t, ids[k]); }
            else { AiTeam.AddPart(t, AiTeam.RoleIdArg(ids[k])); }
        }
    }

    /// A role written by the model as an id ("dev"), an @name or a display name,
    /// resolved to the role id; "" when it is none of the seven.
    static string RoleIdArg(string s) {
        string v = AiAgent.Trim(s);
        if (v == "") { return ""; }
        if ((v[0] & 255) == 64) { v = v.Substring(1, v.Length - 1); }
        if (AiTeam.RoleOf(v) != null) { return v; }
        return AiTeam.RoleIdOfName(v);
    }

    /// The board shows one line per task, so the title is the envelope body's
    /// first line trimmed to something that fits a narrow panel.
    static string TaskTitleOf(string body) {
        string t = AiAgent.Trim(body);
        int nl = t.IndexOf("\n");
        if (nl >= 0) { t = t.Substring(0, nl); }
        if (t.Length > 60) { t = AiAgent.Clip(t, 60); }
        return AiAgent.Trim(t);
    }

    /// Where the pipeline stands, for the Steps strip: the index of `id` in the
    /// pm -> arch -> dev -> qa -> rev -> sec order.
    static int StageOf(string id) {
        List<AiRole> rs = AiTeam.Roles();
        for (int i = 0; i < rs.Count; i = i + 1) {
            if (rs[i].id == id) { return i; }
        }
        return 0;
    }

    // --- pipeline driving (batch 4) ------------------------------------------

    /// How many automatic handoffs one user turn may trigger. The pipeline is
    /// six members long, so a full pass plus a round of fixes fits; past that
    /// the members are volleying and the user should see it.
    static int MaxHandoffs() { return 12; }

    /// 同一个人在同一个节点上能被原地催几次。第一脚常常真能把它推动，
    /// 第二脚往往已经是一模一样的一拍；再催就只是把同一段话刷给用户看，
    /// 所以到这里换人而不是接着催。
    static int MaxIdleNudges() { return 2; }

    /// 原地卡住的人把活儿交给谁：具体干活的人卡住先找架构师理清（拆活儿
    /// 、定方案本来就是它的职责），架构师自己卡住就回到产品经理去统筴。
    /// 产品经理本身卡住不在这条路上（给它的一脚已经是“转派”），返回 ""
    /// 让调用方停下来交回用户。
    static string EscalateTo(string who) {
        if (who == AiTeam.Pm()) { return ""; }
        if (who == AiTeam.Arch()) { return AiTeam.Pm(); }
        return AiTeam.Arch();
    }

    /// 换人时给接手人的指令：说清是谁在哪个节点上停住了，接手人要么自己
    /// 把这一步做完、要么把它拆成能执行的下一步再交回去，不要原封不动地
    /// 把同一句话再弹回给卡住的人，也不要把这事丢给用户。
    static string EscalatePrompt(string stuck, string esc, AiTask t,
        string taskId) {
        string id = taskId;
        if (t != null) { id = t.id; }
        StringBuilder sb = new StringBuilder();
        sb.Append("[auto] 团队内部转交：" + AiTeam.DisplayName(stuck)
            + " 在");
        if (id != "") { sb.Append("任务 " + id); }
        if (t != null && t.title != "") { sb.Append("（" + t.title + "）"); }
        sb.Append(" 上连着几拍没有推进（只说下一步、或重复同一个查询），"
            + "现在转给你。\n");
        if (t != null && AiAgent.Trim(t.accept) != "") {
            sb.Append("验收标准：\n" + AiAgent.Trim(t.accept) + "\n");
        }
        // 转给一个没有写权限的角色（架构师、审查、安全）时，「你自己把那一步
        // 做完」是它做不到的事：它只会一遍遍读代码，然后同一个节点又挂起。
        // 这种角色这一拍只能产出一条可执行指令，或者说清真的缺什么。
        if (!AiTeam.AllowsTool(esc, "write_file")) {
            sb.Append("你没有改代码的权限，所以不要试着自己做完：这一拍只做一件"
                + "事——把卡住的那一步变成一条别人拿着就能敲的指令（改哪个文件、"
                + "加什么、怎么算做完），然后 [handoff] @"
                + AiTeam.DisplayName(stuck) + " task=" + id
                + "。已经读过的东西别再读一遍；要是缺的是前置条件或用户拍板，"
                + "直接 [block] 说清缺什么。");
            return sb.ToString();
        }
        sb.Append("这一拍要么你自己把卡住的那一步做完，要么把它拆成一条明确、可"
            + "执行的指令后 [handoff] 给合适的人（带上 task=" + id
            + "）；不要把同一句话原样退回去，也不要因为这个去问用户。");
        return sb.ToString();
    }

    /// 交接上限：跟「自动继续上限」用同一个设置项，因为一次自动交接对用户
    /// 就是「小助手又自己跑了一拍」，两个刹车分开配只会出现「继续设成不限、
    /// 团队照样停」。`configured` 是设置里的值（<0 = 没配过，用内置默认；
    /// 0 = 不限，仍受 AiAgent.ContinuesCeiling() 兜底）。
    static int HandoffsBudget(int configured) {
        if (configured < 0) { return AiTeam.MaxHandoffs(); }
        if (configured == 0) { return AiAgent.ContinuesCeiling(); }
        return configured;
    }

    /// The comma-separated recipient list stored on a message.
    static string JoinIds(List<string> ids) {
        StringBuilder sb = new StringBuilder();
        for (int i = 0; i < ids.Count; i = i + 1) {
            if (i > 0) { sb.Append(","); }
            sb.Append(ids[i]);
        }
        return sb.ToString();
    }

    /// The turn handed to the member being woken by a handoff. It carries only
    /// the previous member's conclusion (the envelope body), never its context:
    /// the point of separate contexts is that the next member re-derives the
    /// work from the artefacts, so it can actually catch what the last one got
    /// wrong.
    static string HandoffPrompt(string from, string to, AiEnvelope env) {
        StringBuilder sb = new StringBuilder();
        sb.Append("[assign] @" + AiTeam.DisplayName(to) + "，来自 @"
            + AiTeam.DisplayName(from));
        if (env.taskId != "") { sb.Append("，任务 " + env.taskId); }
        sb.Append("。\n");
        if (env.kind == AiTeam.KindBlock()) {
            sb.Append("上一环节发现问题，需要你修复：\n");
        }
        string body = AiAgent.Trim(env.body);
        if (body != "") { sb.Append(body + "\n"); }
        sb.Append("直接开始你自己那一段（不用回「收到」）；做完再按协议 @ 下一"
            + "环节，中途不要 @ 人。");
        return sb.ToString();
    }

    /// 认领之后那一脚：认领本身不是工作，所以自动执行时立刻把同一个成员
    /// 叫回来干活，而不是停在「已认领 0%」等用户催。
    static string StartPrompt(string who, AiTask t, string taskId) {
        // 产品经理认领了也不是它自己干：它统筹，所以那一脚仍是转派。
        if (who == AiTeam.Pm()) { return AiTeam.RoutePrompt(t); }
        string id = taskId;
        if (t != null) { id = t.id; }
        StringBuilder sb = new StringBuilder();
        sb.Append("[auto] 本拍执行人："
            + AiTeam.DisplayName(who) + "，现在直接做");
        if (id != "") { sb.Append("任务 " + id); }
        if (t != null && t.title != "") { sb.Append("（" + t.title + "）"); }
        sb.Append("该由你负责的那一段：该查就查、该改就改，"
            + "别复述计划也别重复刚才已经查过的东西。\n");
        sb.Append(AiTeam.TickHint(t));
        sb.Append("做完回 [report] 说清交付了什么、怎么验证的；"
            + "真有需要用户定的事才 [question]。");
        return sb.ToString();
    }

    /// 团队还欠着活儿：任务图里还有节点没到「已完成」。图是空的不算欠活儿
    /// （还没拆任务时不该替用户往下催）。
    static bool HasUnfinished(List<AiTask> tasks) {
        if (tasks == null) { return false; }
        for (int i = 0; i < tasks.Count; i = i + 1) {
            if (tasks[i].state != AiTeam.TaskDone()) { return true; }
        }
        return false;
    }

    /// 一拍说完了却什么也没做（只回了一句「接下来看 X」、或者读文件读到次数
    /// 上限被截断）时给同一个成员的那一脚。它欠的活儿还在图上，停下来只会让
    /// 用户手打「继续」，所以直接把它叫回原地接着干。
    ///
    /// 产品经理是例外：它的活儿是盯全程和转派，不是自己下手做。催它「接着做」
    /// 只会换回一份重写的计划或又一份报告，所以给它的那一脚是「按图把这一段
    /// 交给对应负责人」。
    static string NudgePrompt(string who, AiTask t, string taskId) {
        if (who == AiTeam.Pm()) { return AiTeam.RoutePrompt(t); }
        string id = taskId;
        if (t != null) { id = t.id; }
        StringBuilder sb = new StringBuilder();
        sb.Append("[auto] 本拍执行人：" + AiTeam.DisplayName(who)
            + "。从你上次停下的地方继续");
        if (id != "") { sb.Append("任务 " + id); }
        if (t != null && t.title != "") { sb.Append("（" + t.title + "）"); }
        sb.Append("：上一拍只说了下一步却没真做，现在直接发出那一步的工具调用，"
            + "别重述计划、别重复已经查过的东西、别从头开始。\n");
        sb.Append(AiTeam.TickHint(t));
        if (!AiTeam.AllowsTool(who, "write_file")) {
            // 只读角色再催「发工具调用」只会换个文件继续读：它的交付不是代码，
            // 是一条能落地的指令。
            sb.Append("你没有改代码的权限：代码已经读够了就别再读，直接把结论写"
                + "成一条可执行的指令 [handoff] 给 @"
                + AiTeam.DisplayName(AiTeam.Dev()) + " task=" + id
                + "；确实缺前置就 [block] 说清缺什么。");
            return sb.ToString();
        }
        sb.Append("做完回 [report] 说清交付了什么、怎么验证的；"
            + "真有需要用户定的事才 [question]。");
        return sb.ToString();
    }

    /// 给产品经理的那一脚：转派，不是自己做。图上已经有这个节点就点名它的
    /// 负责人；图还没拆（或这个节点没写负责人）就交给架构师去拆——拆活儿本来
    /// 就是架构师的职责，产品经理只负责需求和统筹。
    static string RoutePrompt(AiTask t) {
        string who = AiTeam.OwnerOf(t);
        if (t == null) { who = AiTeam.Arch(); }
        StringBuilder sb = new StringBuilder();
        sb.Append("[auto] 本拍执行人：" + AiTeam.DisplayName(AiTeam.Pm())
            + "。你不写代码、不做设计、不自己跑测试：你的活儿是把需求讲清楚、"
            + "盯着整条流程、需要用户拍板时才问用户。上一拍你既没交接也没提问，"
            + "流程停住了。\n");
        sb.Append("现在这一拍只做一件事：[handoff] @"
            + AiTeam.DisplayName(who));
        if (t != null) {
            sb.Append(" task=" + t.id);
            if (t.title != "") { sb.Append("（" + t.title + "）"); }
        }
        sb.Append("，一句话说清要它交付什么、验收看什么。");
        if (t == null) {
            sb.Append("任务图还没拆，让架构师按功能拆成节点（每个节点自己带"
                + " 3-8 条活儿、负责人和验收标准）。");
        }
        sb.Append("别重发计划、别再写一遍报告、别复述已经说过的话。");
        return sb.ToString();
    }

    // --- team state persistence (batch 2) ------------------------------------

    /// Serialises the resume state into the compact form stored alongside the
    /// transcript, so "继续" survives an IDE restart.
    static string PackState(AiTeamState st) {
        StringBuilder sb = new StringBuilder();
        sb.Append(st.activeAgent + "|" + st.activeTask + "|");
        if (st.awaitingUser) { sb.Append("1"); } else { sb.Append("0"); }
        sb.Append("|" + st.askedBy);
        return sb.ToString();
    }

    /// Reads a state string back; a blank or malformed value yields a fresh
    /// state parked at the product manager rather than throwing.
    static AiTeamState UnpackState(string s) {
        AiTeamState st = AiTeamState.Create();
        if (AiAgent.Trim(s) == "") { return st; }
        List<string> parts = new List<string>();
        int start = 0;
        for (int i = 0; i <= s.Length; i = i + 1) {
            bool end = i == s.Length;
            bool bar = false;
            if (!end) { bar = (s[i] & 255) == 124; }
            if (end || bar) {
                parts.Add(s.Substring(start, i - start));
                start = i + 1;
            }
        }
        if (parts.Count >= 1 && parts[0] != "") { st.activeAgent = parts[0]; }
        if (parts.Count >= 2) { st.activeTask = parts[1]; }
        if (parts.Count >= 3) { st.awaitingUser = parts[2] == "1"; }
        if (parts.Count >= 4) { st.askedBy = parts[3]; }
        return st;
    }
}
