using System;
using System.IO;
using System.Diagnostics;
using System.Threading;
using System.Net.Http.Client;
using Gui;
using Gui.Backend;
using Gui.Widget;
using Gui.Component;

// 接口数据协议与执行契约。
class IdeJobSnapshot {
    int workspace;
    int session;
    int monitor;
    string root;
    int termSeq;
    bool term;
    int termConsumed;
    int runSeq;
    bool run;
    int runConsumed;
    int gitSeq;
    int git;
    int buildSeq;
    bool build;
    int buildStart;
    int buildConsumed;
    string buildExe;
    string buildTarget;
    bool thenRun;
    bool gui;
    bool debug;
    List<DbgBreakpoint> breakpoints;
    int debugLine;
    string debugText;
    int debugSeq;
    DebugSession debugger;
    List<DbgVar> watches;
    bool aiBuild;
    bool aiUiPending;
    string aiUiScript;
    int uiSeq;
    bool ui;
    int uiDeadline;
    string uiTool;
    int pubSeq;
    bool pub;
    bool packing;
    int pubStart;
    int pubConsumed;
    string pubRoot;
    bool packed;
    List<string> exes;
    AiReq request;
    AiJob tool;
    bool ai;
    int aiLaunchSeq;
}

delegate void IdeJobReady(IdeJobResult result);

class IdeJobResult {
    IdeJobSnapshot input;
    int kind;
    int phase;
    int consumed;
    bool complete;
    bool ok;
    bool timeout;
    List<string> log = new List<string>();
    List<string> output;
    List<Diagnostic> diagnostics;
    string missingPackage;
    string exe;
    string target;
    bool gui;
    bool thenRun;
    bool consoleStarted;
    bool uiStarted;
    int uiDeadline;
    string uiResult;
    List<string> files;
    string branch;
    string head;
    List<string> exes;
    string step;
    string publishFolder;
    DebugSession debugSession;
    int debugState;
    int debugLine;
    List<string> debugConsole;
    List<DbgVar> debugVars;
    List<DbgFrame> debugStack;
    List<DbgVar> watches;
    AiJob tool;
    bool dropPreview;
    bool final;
    string live;
    string done;
    SseAnswer answer;
    string call;
    string said;
    string reasoning;
    string archiveCall;
    string toolName;
    string badTool;
    AiEnvelope envelope;
    string buildResult;
    string error;
    string debugCommand;
    string debugExpression;
    string debugValue;
    int debugWatch;
    List<ChatMessage> pins;
    AiReq startedRequest;
}

class IdeJobStart {
    IdeJobSnapshot input;
    int kind;
    string target;
    bool hot;
    string gitArgs;
    bool gitRefresh;
    List<PublishTargetOption> options;
    string command;
    string argument;
    int watch;
    List<ChatMessage> messages;
    string agent;
    string contextName;
    string contextCode;
    string baseUrl;
    string key;
    string model;
}

class IdeJobDebugSessions {
    nint gate = Mutex.Create();
    List<DebugSession> sessions = new List<DebugSession>();

    void Remember(DebugSession session) {
        if (session == null) { return; }
        Mutex.Lock(gate);
        sessions.Add(session);
        Mutex.Unlock(gate);
    }

    void StopAll() {
        // 接口数据协议与执行契约。
        for (int i = 0; i < sessions.Count; i = i + 1) { sessions[i].Stop(); }
        sessions = new List<DebugSession>();
    }
}

// 接口数据协议与执行契约。
class IdeJobMonitor {
    int lane;
    List<IdeJobMonitor> lanes = new List<IdeJobMonitor>();
    IdeJobSnapshot bound;
    IdeJobDebugSessions debugSessions = new IdeJobDebugSessions();
    App host;
    IdeJobReady apply;
    CancellationTokenSource cancellation = new CancellationTokenSource();
    TaskCompletionSource<bool> drained = new TaskCompletionSource<bool>();
    nint sync = Mutex.Create();
    IdeJobSnapshot snapshot;
    List<IdeJobStart> starts = new List<IdeJobStart>();
    int termSeq;
    int termConsumed;
    int runSeq;
    int runConsumed;
    int runDone;
    int gitDone;
    int buildSeq;
    int buildConsumed;
    int buildDone;
    string preparedExe;
    string preparedTarget;
    bool preparedGui;
    bool preparedThenRun;
    int pubSeq;
    int pubConsumed;
    int pubDone;
    List<string> preparedExes;
    bool packing;
    int packStarted;
    int uiDone;
    AiReq request;
    AiJob toolDone;
    SseLive live;
    int streamLength;
    int streamShown;
    int streamAt;
    int waitStart;
    bool settled;
    bool answerDone;

    void Submit(IdeJobSnapshot next) {
        if (lane == 0) {
            for (int i = 0; i < lanes.Count; i = i + 1) { lanes[i].Submit(next); }
        }
        Mutex.Lock(sync);
        snapshot = next;
        Mutex.Unlock(sync);
    }

    void Begin(IdeJobStart start) {
        if (lane == 0) {
            // 接口数据协议与执行契约。
            for (int i = 0; i < lanes.Count; i = i + 1) {
                if (lanes[i].lane == start.kind) { lanes[i].Begin(start); }
                else { lanes[i].Submit(start.input); }
            }
            return;
        }
        Mutex.Lock(sync);
        starts.Add(start);
        snapshot = start.input;
        Mutex.Unlock(sync);
    }

    IdeJobSnapshot ReadSnapshot() {
        Mutex.Lock(sync);
        IdeJobSnapshot next = snapshot;
        Mutex.Unlock(sync);
        return next;
    }

    IdeJobStart TakeStart() {
        Mutex.Lock(sync);
        IdeJobStart start = null;
        if (starts.Count > 0) {
            start = starts[0];
            starts.RemoveAt(0);
        }
        Mutex.Unlock(sync);
        return start;
    }

    bool Current(IdeJobSnapshot input, int kind) {
        if (cancellation.Token.IsCancellationRequested) { return false; }
        IdeJobSnapshot current = ReadSnapshot();
        if (current == null || current.workspace != input.workspace
            || current.monitor != input.monitor || current.root != input.root) { return false; }
        if ((kind == 5 || kind == 7 || kind == 8 || kind == 10)
            && current.session != input.session) { return false; }
        if (kind == 1) { return current.term && current.termSeq == input.termSeq; }
        if (kind == 2) { return current.run && current.runSeq == input.runSeq; }
        if (kind == 3) { return current.git != 0 && current.gitSeq == input.gitSeq; }
        if (kind == 4) { return current.build && current.buildSeq == input.buildSeq; }
        if (kind == 5) { return current.ui && current.uiSeq == input.uiSeq; }
        if (kind == 6) { return current.pub && current.pubSeq == input.pubSeq; }
        if (kind == 7) { return current.ai && current.request == input.request; }
        if (kind == 8) { return current.ai && current.tool == input.tool; }
        if (kind == 9) { return current.debugSeq == input.debugSeq && current.debugger == input.debugger; }
        if (kind == 10) { return current.aiLaunchSeq == input.aiLaunchSeq; }
        return false;
    }

    void Emit(IdeJobResult result) {
        if (!Current(result.input, result.kind)) { return; }
        IdeJobReady receiver = apply;
        if (receiver == null) { return; }
        host.Post(delegate () { receiver(result); }, "JobMonitor.Emit");
    }

    bool Start() {
        if (lane == 0) {
            bool ok = true;
            for (int kind = 1; kind <= 10; kind = kind + 1) {
                IdeJobMonitor worker = new IdeJobMonitor();
                worker.lane = kind;
                worker.host = host;
                worker.apply = apply;
                worker.debugSessions = debugSessions;
                worker.snapshot = snapshot;
                lanes.Add(worker);
                if (!worker.Start()) { ok = false; }
            }
            if (!ok) {
                for (int i = 0; i < lanes.Count; i = i + 1) { lanes[i].cancellation.Cancel(); }
            }
            drained.TrySetResult(ok);
            return ok;
        }
        this.RunAsync();
        return true;
    }

    bool HasActiveJob(IdeJobSnapshot input) {
        if (input == null || !Current(input, lane)) { return false; }
        if (lane == 1) { return input.term; }
        if (lane == 2) { return input.run && runDone != input.runSeq; }
        if (lane == 3) { return input.git != 0 && gitDone != input.gitSeq; }
        if (lane == 4) { return input.build && buildDone != input.buildSeq; }
        if (lane == 5) { return input.ui && uiDone != input.uiSeq; }
        if (lane == 6) { return input.pub && pubDone != input.pubSeq; }
        if (lane == 7) { return input.ai && input.request != null; }
        if (lane == 8) { return input.ai && input.tool != null && toolDone != input.tool; }
        return false;
    }

    async void RunAsync() {
        try {
            while (!cancellation.Token.IsCancellationRequested) {
                bool busy = false;
                IdeJobStart start = TakeStart();
                if (start != null) { bound = start.input; StartOne(start); busy = true; }
                IdeJobSnapshot input = ReadSnapshot();
                if (input != null && lane <= 8) {
                    if (bound == null || !SameJob(bound, input)) { bound = input; }
                    if (this.HasActiveJob(bound)) {
                        busy = true;
                        PollOne(bound);
                    }
                }
                await Task.Delay(busy ? 80 : 200);
            }
        } catch (Exception error) {
            // 接口数据协议与执行契约。
            IdeJobSnapshot input = ReadSnapshot();
            if (input != null) {
                string message = error.Message;
                IdeJobReady receiver = apply;
                if (receiver != null) {
                    IdeJobResult failure = new IdeJobResult();
                    failure.input = input;
                    failure.kind = 0;
                    failure.log.Add("> Job monitor failed: " + message);
                    host.Post(delegate () { receiver(failure); }, "JobMonitor.Failure");
                }
            }
        } finally {
            drained.TrySetResult(true);
        }
    }

    bool SameJob(IdeJobSnapshot a, IdeJobSnapshot b) {
        if (a.workspace != b.workspace || a.monitor != b.monitor || a.root != b.root) { return false; }
        if (lane == 1) { return a.termSeq == b.termSeq && a.term == b.term; }
        if (lane == 2) { return a.runSeq == b.runSeq && a.run == b.run; }
        if (lane == 3) { return a.gitSeq == b.gitSeq && a.git == b.git; }
        if (lane == 4) { return a.buildSeq == b.buildSeq && a.build == b.build; }
        if (lane == 5) { return a.uiSeq == b.uiSeq && a.ui == b.ui; }
        if (lane == 6) { return a.pubSeq == b.pubSeq && a.pub == b.pub; }
        if (lane == 7) { return a.request == b.request && a.ai == b.ai; }
        if (lane == 8) { return a.tool == b.tool && a.ai == b.ai; }
        return false;
    }

    void Cancel() {
        cancellation.Cancel();
        for (int i = 0; i < lanes.Count; i = i + 1) { lanes[i].Cancel(); }
    }

    async void StopAsync() {
        this.Cancel();
        await drained.Task;
        for (int i = 0; i < lanes.Count; i = i + 1) { await lanes[i].StopAsync(); }
        if (lane == 0) {
            debugSessions.StopAll();
            await PubPack.DrainAsync();
            await AiNet.DrainAsync();
            await AiWork.DrainAsync();
        }
        Mutex.Lock(sync);
        snapshot = null;
        bound = null;
        starts = new List<IdeJobStart>();
        apply = null;
        Mutex.Unlock(sync);
        lanes = new List<IdeJobMonitor>();
        host = null;
    }

    void StartOne(IdeJobStart start) {
        IdeJobSnapshot input = start.input;
        if (!Current(input, start.kind)) { return; }
        IdeJobResult result = new IdeJobResult();
        result.input = input;
        result.kind = start.kind;
        result.phase = 1;
        try {
            if (start.kind == 4) {
                string target = start.target;
                {
                    target = ZanIDE.RibbonRunTarget(target, input.root);
                    if (target == "") {
                        result.complete = true;
                        buildDone = input.buildSeq;
                        Emit(result);
                        return;
                    }
                }
                if (input.aiUiPending) {
                    string dir = input.root + "/_scratch/uidrv";
                    Directory.CreateDirectory(dir);
                    File.WriteAllText(dir + "/ai_script.txt", input.aiUiScript);
                    if (File.Exists(dir + "/ai_done.txt")) { File.Delete(dir + "/ai_done.txt"); }
                }
                preparedTarget = target;
                preparedThenRun = input.thenRun && !ZanIDE.IsLibraryProject(input.root);
                preparedGui = ZanIDE.IsWindowedTarget(input.root, target);
                if (input.debug) {
                    string troot = ZanIDE.TargetRoot(input.root, target);
                    string bd = ZanIDE.EnsureBuildDir(troot);
                    string ll = bd + "/.zandbg.ll";
                    preparedExe = bd + "/.zandbg" + ZanIDE.ExeSuffix();
                    if (File.Exists(preparedExe)) { File.Delete(preparedExe); }
                    string inputs = ZanIDE.InputsArg(bd, ".zandbg_inputs",
                        ZanIDE.SmartInputs(troot, ZanIDE.DirOf(target), target));
                    string command = ZanIDE.CompileToExe(troot, target, inputs,
                        ll, preparedExe, false, true);
                    result.log.Add("> [Debug] Building " + target + " ...");
                    string pre = ZanIDE.ProjPreBuild(troot);
                    ZanIDE.BuildDetachWithPre(command, troot, pre);
                } else { preparedExe = ZanIDE.RunBuildBegin(input.root, target); }
                buildSeq = input.buildSeq;
                buildConsumed = 0;
                result.exe = preparedExe;
                result.target = target;
                result.gui = preparedGui;
                result.thenRun = preparedThenRun;
                if (start.hot) { result.log.Add("> [Hot] Rebuilding " + target + " ..."); }
            } else if (start.kind == 3) {
                if (start.gitRefresh) { ZanIDE.GitRefreshBegin(input.root); }
                else { ZanIDE.GitBegin(input.root, start.gitArgs); }
            } else if (start.kind == 6) {
                preparedExes = ZanIDE.PublishPlatformsBeginWithOptions(input.pubRoot,
                    start.options, result.log);
                result.exes = preparedExes;
                pubSeq = input.pubSeq;
                pubConsumed = 0;
                packing = false;
                if (preparedExes.Count == 0) {
                    result.complete = true;
                    result.ok = false;
                    pubDone = input.pubSeq;
                    Emit(result);
                    return;
                }
            } else if (start.kind == 9) {
                RunDebugCommand(start, result);
            } else if (start.kind == 10) {
                int count = start.messages.Count;
                result.error = ZanIDE.AiLaunchAs(start.agent, start.messages,
                    start.contextName, start.contextCode, input.root,
                    start.baseUrl, start.key, start.model, false);
                result.pins = new List<ChatMessage>();
                for (int i = count; i < start.messages.Count; i = i + 1) {
                    result.pins.Add(start.messages[i]);
                }
                result.startedRequest = AiNet.Snapshot();
                result.complete = true;
            }
            result.ok = true;
        } catch (Exception error) {
            // 接口数据协议与执行契约。
            result.complete = true;
            result.ok = false;
            result.log.Add("> Job could not start: " + error.Message);
            if (start.kind == 4) { buildDone = input.buildSeq; }
            if (start.kind == 6) { pubDone = input.pubSeq; }
            if (start.kind == 3) { gitDone = input.gitSeq; }
        }
        Emit(result);
    }

    void PollOne(IdeJobSnapshot input) {
        // 接口数据协议与执行契约。
        if (!Current(input, lane)) { return; }
        if (lane == 1 && input.term) { PollSafely(input, 1); }
        if (lane == 2 && input.run && runDone != input.runSeq) { PollSafely(input, 2); }
        if (lane == 3 && input.git != 0 && gitDone != input.gitSeq) { PollSafely(input, 3); }
        if (lane == 4 && input.build && buildDone != input.buildSeq) { PollSafely(input, 4); }
        if (lane == 5 && input.ui && uiDone != input.uiSeq) { PollSafely(input, 5); }
        if (lane == 6 && input.pub && pubDone != input.pubSeq) { PollSafely(input, 6); }
        if (input.ai) {
            if (lane == 8 && input.tool != null && toolDone != input.tool) { PollSafely(input, 8); }
            if (lane == 7 && input.request != null) { PollSafely(input, 7); }
        }
    }

    void PollSafely(IdeJobSnapshot input, int kind) {
        try {
            if (kind == 1 || kind == 2) { PollOutput(input, kind); }
            else if (kind == 3) { PollGit(input); }
            else if (kind == 4) { PollBuild(input); }
            else if (kind == 5) { PollUi(input); }
            else if (kind == 6) { PollPublish(input); }
            else if (kind == 7) { PollAi(input); }
            else if (kind == 8 && AiWork.DoneOf(input.tool) != 0) {
                IdeJobResult result = new IdeJobResult();
                result.input = input;
                result.kind = kind;
                result.tool = input.tool;
                toolDone = input.tool;
                Emit(result);
            }
        } catch (Exception error) {
            // 接口数据协议与执行契约。
            IdeJobResult result = new IdeJobResult();
            result.input = input;
            result.kind = kind;
            result.phase = -1;
            result.log.Add("> Job monitor: " + error.Message);
            Emit(result);
        }
    }

    void PollOutput(IdeJobSnapshot input, int kind) {
        IdeJobResult result = new IdeJobResult();
        result.input = input;
        result.kind = kind;
        if (kind == 1) {
            if (termSeq != input.termSeq) { termSeq = input.termSeq; termConsumed = input.termConsumed; }
            result.consumed = ZanIDE.TermPoll(termConsumed, result.log);
            if (result.consumed == termConsumed) { return; }
            termConsumed = result.consumed;
        } else {
            if (runSeq != input.runSeq) { runSeq = input.runSeq; runConsumed = input.runConsumed; }
            result.consumed = ZanIDE.RunPoll(runConsumed, result.log);
            if (File.Exists(ZanIDE.RunDonePath())) {
                result.consumed = ZanIDE.RunPoll(result.consumed, result.log);
                File.Delete(ZanIDE.RunDonePath());
                result.complete = true;
                runDone = input.runSeq;
            }
            if (result.consumed == runConsumed && !result.complete) { return; }
            runConsumed = result.consumed;
        }
        Emit(result);
    }

    void PollGit(IdeJobSnapshot input) {
        if (!ZanIDE.GitJobDone()) { return; }
        IdeJobResult result = new IdeJobResult();
        result.input = input;
        result.kind = 3;
        result.complete = true;
        List<string> lines = ZanIDE.GitJobTake();
        if (input.git == 1) {
            result.files = new List<string>();
            result.branch = ZanIDE.GitRefreshApply(lines, result.files);
            result.head = ZanIDE.GitRefreshHead(lines);
        } else { result.log = lines; }
        gitDone = input.gitSeq;
        Emit(result);
    }

    static List<Diagnostic> ParseDiagnostics(string path, List<string> output) {
        List<Diagnostic> diagnostics = new List<Diagnostic>();
        if (!ZanIDE.EndsWith(path, ".zan")) { return diagnostics; }
        string baseName = Path.GetFileName(path);
        for (int i = 0; i < output.Count; i = i + 1) {
            string raw = ZanIDE.StripAnsi(output[i]);
            int errorAt = raw.IndexOf(": error:");
            if (errorAt <= 0) { continue; }
            string location = raw.Substring(0, errorAt);
            if (location.IndexOf(baseName) < 0) { continue; }
            int columnAt = location.LastIndexOf(":");
            if (columnAt <= 0) { continue; }
            int lineAt = location.Substring(0, columnAt).LastIndexOf(":");
            if (lineAt < 0) { continue; }
            int line = ZanIDE.ParseLeadInt(location.Substring(lineAt + 1, columnAt - lineAt - 1));
            if (line > 0) {
                diagnostics.Add(new Diagnostic(line - 1,
                    ZanIDE.TrimLeadSpaces(raw.Substring(errorAt + 8))));
            }
        }
        return diagnostics;
    }

    static List<DbgVar> CopyVars(List<DbgVar> source) {
        List<DbgVar> copy = new List<DbgVar>();
        if (source != null) {
            for (int i = 0; i < source.Count; i = i + 1) {
                copy.Add(new DbgVar(source[i].name, source[i].type, source[i].val));
            }
        }
        return copy;
    }

    static List<DbgFrame> CopyFrames(List<DbgFrame> source) {
        List<DbgFrame> copy = new List<DbgFrame>();
        if (source != null) {
            for (int i = 0; i < source.Count; i = i + 1) {
                copy.Add(DbgFrame.Create(source[i].name, source[i].line));
            }
        }
        return copy;
    }

    static int FirstDebugLineOf(string text) {
        List<string> lines = CodeEditor.SplitLines(text);
        for (int i = 0; i < lines.Count; i = i + 1) {
            string line = ZanIDE.TrimLeadSpaces(lines[i]);
            bool skip = line == "" || line == "{" || line == "}"
                || ZanIDE.Has(line, "using ") || ZanIDE.Has(line, "class ")
                || ZanIDE.Has(line, "static void Main") || ZanIDE.Has(line, "//");
            if (!skip) { return i; }
        }
        return 0;
    }

    DebugSession OpenDebug(IdeJobSnapshot input, string target, string exe, List<string> log) {
        string dap = ZanIDE.ToolchainDir() + "/zan-dap" + ZanIDE.ExeSuffix();
        if (!File.Exists(dap)) { dap = ZanIDE.ExeDir() + "/zan-dap" + ZanIDE.ExeSuffix(); }
        if (!File.Exists(dap)) { log.Add("> [Debug] zan-dap not found in toolchain."); return null; }
        List<DbgBreakpoint> lines = new List<DbgBreakpoint>();
        for (int i = 0; i < input.breakpoints.Count; i = i + 1) {
            lines.Add(DbgBreakpoint.Create(input.breakpoints[i].line + 1, input.breakpoints[i].cond));
        }
        if (lines.Count == 0) {
            lines.Add(DbgBreakpoint.Create(IdeJobMonitor.FirstDebugLineOf(input.debugText) + 1, ""));
        }
        for (int attempt = 0; attempt < 4 && Current(input, 4); attempt = attempt + 1) {
            int port = 47113 + attempt;
            Process.RunDetached("\"" + dap + "\" --port " + Convert.ToString(port));
            DebugSession session = DebugSession.Open(port, exe, target, lines, cancellation.Token);
            if (session != null) { return session; }
        }
        log.Add("> [Debug] Could not connect to zan-dap.");
        return null;
    }

    void PrepareDebug(IdeJobSnapshot input, IdeJobResult result) {
        result.debugSession = OpenDebug(input, result.target, result.exe, result.log);
        debugSessions.Remember(result.debugSession);
        DebugSession session = result.debugSession;
        result.debugConsole = new List<string>();
        result.debugVars = new List<DbgVar>();
        result.debugStack = new List<DbgFrame>();
        result.watches = IdeJobMonitor.CopyVars(input.watches);
        result.debugLine = -1;
        if (session != null) {
            result.debugConsole = ZanIDE.CopyJobStrings(session.Console());
            if (session.Paused()) {
                result.debugState = 2;
                result.debugLine = session.CurLine() - 1;
                result.debugVars = IdeJobMonitor.CopyVars(session.Locals());
                result.debugStack = IdeJobMonitor.CopyFrames(session.Stack());
                ZanIDE.DbgEvalWatches(session, result.watches);
                result.log.Add("> [Debug] Paused at line " + Convert.ToString(session.CurLine()));
            } else {
                result.log.Add("> [Debug] Program exited (code "
                    + Convert.ToString(session.ExitCode()) + ").");
                session.Stop();
                result.debugSession = null;
            }
        }
        if (!Current(input, 4) && result.debugSession != null) {
            result.debugSession.Stop();
            result.debugSession = null;
        }
    }

    void RunDebugCommand(IdeJobStart start, IdeJobResult result) {
        DebugSession session = start.input.debugger;
        result.complete = true;
        result.debugCommand = start.command;
        result.debugExpression = start.argument;
        result.debugWatch = start.watch;
        result.debugConsole = new List<string>();
        result.debugVars = new List<DbgVar>();
        result.debugStack = new List<DbgFrame>();
        result.watches = IdeJobMonitor.CopyVars(start.input.watches);
        result.debugLine = -1;
        if (session == null) { return; }
        if (start.command == "stop") { session.Stop(); return; }
        if (start.command == "continue") { session.Continue(); }
        else if (start.command == "next" || start.command == "stepOver") { session.StepOver(); }
        else if (start.command == "stepIn") { session.StepIn(); }
        else if (start.command == "stepOut") { session.StepOut(); }
        else if (start.command == "evaluate" || start.command == "watch") {
            result.debugValue = session.Evaluate(start.argument);
        }
        result.debugConsole = ZanIDE.CopyJobStrings(session.Console());
        if (session.Paused()) {
            result.debugSession = session;
            result.debugState = 2;
            result.debugLine = session.CurLine() - 1;
            result.debugVars = IdeJobMonitor.CopyVars(session.Locals());
            result.debugStack = IdeJobMonitor.CopyFrames(session.Stack());
            ZanIDE.DbgEvalWatches(session, result.watches);
            if (start.command != "evaluate" && start.command != "watch") {
                result.log.Add("> [Debug] Paused at line " + Convert.ToString(session.CurLine()));
            }
        } else {
            result.log.Add("> [Debug] Program exited (code " + Convert.ToString(session.ExitCode()) + ").");
            session.Stop();
        }
    }

    void PollBuild(IdeJobSnapshot input) {
        if (buildSeq != input.buildSeq) {
            buildSeq = input.buildSeq;
            buildConsumed = input.buildConsumed;
            preparedExe = input.buildExe;
            preparedTarget = input.buildTarget;
            preparedGui = input.gui;
            preparedThenRun = input.thenRun;
        }
        IdeJobResult result = new IdeJobResult();
        result.input = input;
        result.kind = 4;
        result.exe = preparedExe;
        result.target = preparedTarget;
        result.gui = preparedGui;
        result.thenRun = preparedThenRun;
        result.consumed = ZanIDE.BuildPoll(buildConsumed, result.log);
        if (File.Exists(ZanIDE.BuildDonePath())) {
            result.ok = ZanIDE.DoneOk(ZanIDE.BuildDonePath()) && File.Exists(preparedExe);
            result.consumed = ZanIDE.BuildPoll(result.consumed, result.log);
            result.output = CodeEditor.SplitLines(File.ReadAllText(ZanIDE.BuildLogPath()));
            result.diagnostics = IdeJobMonitor.ParseDiagnostics(preparedTarget, result.output);
            result.missingPackage = ZanIDE.MissingPackage(result.output);
            result.buildResult = AiAgent.BuildResult(result.output, result.ok, preparedThenRun);
            File.Delete(ZanIDE.BuildDonePath());
            result.complete = true;
            buildDone = input.buildSeq;
            if (result.ok && Current(input, 4)) {
                if (input.debug) {
                    result.log.Add("> [Debug] Build succeeded.");
                    PrepareDebug(input, result);
                } else {
                    string cwd = ZanIDE.RunCwd(input.root, preparedTarget, preparedExe);
                    if (preparedThenRun) {
                        if (preparedGui) {
                            #if WINDOWS
                            Process.RunDetached("cmd /c start \"\" /D \""
                                + ZanIDE.ToWinPath(cwd) + "\" \"" + preparedExe + "\"");
                            #else
                            Process.RunDetached("sh -c 'cd \"" + cwd + "\" && \""
                                + preparedExe + "\" >/dev/null 2>&1' &");
                            #endif
                            result.log.Add(ZanIDE.T("> GUI app started.", "> GUI 应用已启动。"));
                        } else {
                            result.log.Add("> " + preparedExe);
                            ZanIDE.RunConsole(preparedExe, cwd);
                            result.consoleStarted = true;
                        }
                    }
                    if (input.aiBuild && input.aiUiPending) {
                        string dir = input.root + "/_scratch/uidrv";
                        ZanIDE.LaunchUnderUiDriver(preparedExe, cwd,
                            dir + "/ai_script.txt", dir, dir + "/ai_done.txt");
                        result.uiStarted = true;
                        result.uiDeadline = Window.GetTickMs() + 30000;
                    }
                }
            }
        } else if (input.buildStart != 0 && Window.GetTickMs() - input.buildStart > 600000) {
            result.complete = true;
            result.timeout = true;
            buildDone = input.buildSeq;
        }
        bool changed = result.consumed != buildConsumed;
        buildConsumed = result.consumed;
        if (changed || result.complete) { Emit(result); }
    }

    static string ReadOptional(string path) {
        if (!File.Exists(path)) { return ""; }
        return File.ReadAllText(path);
    }

    void PollUi(IdeJobSnapshot input) {
        string dir = input.root + "/_scratch/uidrv";
        bool done = File.Exists(dir + "/ai_done.txt");
        bool timeout = Window.GetTickMs() > input.uiDeadline;
        if (!done && !timeout) { return; }
        IdeJobResult result = new IdeJobResult();
        result.input = input;
        result.kind = 5;
        result.uiResult = AiAgent.UiResultOf(input.uiTool,
            IdeJobMonitor.ReadOptional(dir + "/results.log"),
            IdeJobMonitor.ReadOptional(dir + "/regions.json"),
            IdeJobMonitor.ReadOptional(dir + "/theme.json"), timeout && !done);
        if (done) { File.Delete(dir + "/ai_done.txt"); }
        uiDone = input.uiSeq;
        Emit(result);
    }

    void PollPublish(IdeJobSnapshot input) {
        if (pubSeq != input.pubSeq) {
            pubSeq = input.pubSeq;
            pubConsumed = input.pubConsumed;
            preparedExes = input.exes;
            packing = input.packing;
            packStarted = Window.GetTickMs();
        }
        IdeJobResult result = new IdeJobResult();
        result.input = input;
        result.kind = 6;
        if (packing) {
            PubJob packedJob = PubPack.Ready();
            if (packedJob == null) {
                if (Window.GetTickMs() - packStarted <= 600000) { return; }
                result.log.Add(ZanIDE.T("> Packaging timed out at: ", "> 打包超时，停在：") + PubPack.Stage());
                result.timeout = true;
            } else {
                result.log = packedJob.log;
                result.ok = packedJob.ok;
                if (packedJob.ok) {
                    result.log.Add(ZanIDE.T("> Packaging completed.", "> 发布产物打包完成。"));
                    result.log.Add(ZanIDE.T("> Publishing completed.", "> 发布完成。"));
                }
            }
            result.complete = true;
        } else {
            result.consumed = ZanIDE.PubPoll(pubConsumed, result.log);
            for (int i = 0; i < result.log.Count; i = i + 1) {
                string line = result.log[i];
                int slash = line.IndexOf('/');
                if (line.Length > 3 && line[0] == '[' && slash > 1 && line.IndexOf(']') > slash) { result.step = line; }
            }
            if (File.Exists(ZanIDE.PubDonePath())) {
                bool statusOk = ZanIDE.DoneOk(ZanIDE.PubDonePath());
                result.consumed = ZanIDE.PubPoll(result.consumed, result.log);
                File.Delete(ZanIDE.PubDonePath());
                if (!statusOk) {
                    result.log.Add(ZanIDE.T("> A publish step reported an error (see the log above).",
                        "> 有发布步骤报错（见上方日志）。"));
                }
                int count = 0;
                for (int i = 0; i < preparedExes.Count; i = i + 1) {
                    if (File.Exists(preparedExes[i])) {
                        result.log.Add("> Published " + preparedExes[i]);
                        count = count + 1;
                    } else { result.log.Add(ZanIDE.T("> Publish failed for ", "> 发布失败：") + preparedExes[i]); }
                }
                bool success = statusOk && preparedExes.Count > 0 && count == preparedExes.Count;
                if (success && PubPack.NeedsPackaging(input.pubRoot, preparedExes, input.packed)) {
                    int started = PubPack.Start(input.pubRoot, preparedExes, input.packed);
                    if (started == 1) {
                        packing = true;
                        packStarted = Window.GetTickMs();
                        result.phase = 2;
                        result.log.Add(ZanIDE.T("> Packaging the published output ...", "> 正在打包发布产物 ..."));
                    } else if (started == 0) {
                        // 接口数据协议与执行契约。
                        result.ok = PubPack.PackNow(input.pubRoot, preparedExes, input.packed, result.log);
                        result.log.Add(result.ok ? ZanIDE.T("> Publishing completed.", "> 发布完成。")
                            : ZanIDE.T("> Publishing failed.", "> 发布失败。"));
                        result.complete = true;
                    } else {
                        result.log.Add(ZanIDE.T("> The previous packaging worker is still running; this publish was not packaged.",
                            "> 上一次超时的打包线程仍在运行，本次未继续打包。"));
                        result.complete = true;
                    }
                } else {
                    result.complete = true;
                    result.ok = success;
                    result.log.Add(result.ok ? ZanIDE.T("> Publishing completed.", "> 发布完成。")
                        : ZanIDE.T("> Publishing failed.", "> 发布失败。"));
                }
            } else if (input.pubStart != 0 && Window.GetTickMs() - input.pubStart > 1800000) {
                result.complete = true;
                result.timeout = true;
                result.log.Add(ZanIDE.T("> Publish timed out; no result reported.", "> 发布超时，未拿到结果。"));
            }
            pubConsumed = result.consumed;
        }
        if (result.complete) {
            pubDone = input.pubSeq;
            result.publishFolder = input.pubRoot;
            if (Directory.Exists(input.pubRoot + "/publish")) { result.publishFolder = input.pubRoot + "/publish"; }
        }
        if (result.complete || result.phase == 2 || result.log.Count > 0) { Emit(result); }
    }

    void PollAi(IdeJobSnapshot input) {
        AiReq current = input.request;
        if (request != current) {
            request = current;
            live = new SseLive();
            streamLength = 0;
            streamShown = 0;
            streamAt = 0;
            waitStart = 0;
            settled = false;
            answerDone = false;
        }
        if (answerDone) { return; }
        IdeJobResult result = new IdeJobResult();
        result.input = input;
        result.kind = 7;
        string marker = current.sink.Done();
        if (marker != "") {
            result.final = true;
            result.done = AiAgent.Trim(marker);
            result.answer = AiAgent.ParseSse(current.sink.All());
            result.call = AiAgent.ToolBlock(result.answer.content);
            result.said = AiAgent.VisibleText(result.answer.content);
            result.reasoning = AiAgent.Trim(result.answer.reasoning);
            result.envelope = AiTeam.ParseEnvelope(result.said);
            if (result.call != "") {
                result.archiveCall = AiAgent.ArchiveCall(result.call);
                result.toolName = AiAgent.ToolName(result.call);
            } else if (result.envelope.kind == "") { result.badTool = AiAgent.BadToolHint(result.answer.content); }
            answerDone = true;
            Emit(result);
            return;
        }
        bool toolRunning = input.build || input.ui || input.run
            || (input.tool != null && AiWork.DoneOf(input.tool) == 0);
        if (toolRunning) { waitStart = 0; return; }
        int grown = current.sink.Total();
        if (grown < streamLength) {
            live = new SseLive();
            streamShown = 0;
            settled = false;
            result.dropPreview = true;
        }
        int now = Window.GetTickMs();
        bool refresh = grown != streamShown && !settled && now - streamAt >= 120;
        if (grown != streamLength) { streamLength = grown; waitStart = 0; }
        else if (!refresh) {
            if (waitStart == 0) { waitStart = now; }
            else if (now - waitStart > 600000) { result.timeout = true; answerDone = true; }
        }
        if (refresh) {
            streamShown = grown;
            streamAt = now;
            live.FeedTail(current.gen, current.sink.Since());
            string content = live.Content();
            result.live = AiAgent.LiveText(content);
            if (result.live == "" && live.Reasoning() != "") {
                result.live = ZanIDE.T("(thinking) ", "(思考中) ") + live.Reasoning();
            }
            if (AiAgent.CallSettled(content)) { settled = true; }
            waitStart = 0;
        }
        if (result.dropPreview || result.timeout || result.live != "") { Emit(result); }
    }
}

partial class ZanIDE {
    IdeJobMonitor jobMonitor;
    IdeJobSnapshot jobSnapshot;
    int jobSerial;
    int jobMonitorEpoch;
    int jobAiSession;
    int jobDebugSeq;
    int jobAiLaunchSeq;
    AiReq jobAiRequest;
    nint jobTermHandle;
    string jobPublishedTarget;

    void StartJobMonitor() {
        if (jobMonitor != null || shuttingDown) { return; }
        IdeJobMonitor monitor = new IdeJobMonitor();
        monitor.host = app;
        monitor.apply = this.ApplyJobResult;
        jobMonitor = monitor;
        jobMonitorEpoch = ++jobSerial;
        this.CaptureJobMonitor();
        if (!monitor.Start()) {
            jobMonitor = null;
            log.Add("> Could not start job monitor.");
            app.RequestRedraw();
        }
    }

    async void StopJobMonitorAsync() {
        IdeJobMonitor monitor = jobMonitor;
        jobMonitor = null;
        jobSnapshot = null;
        if (monitor != null) { await monitor.StopAsync(); }
    }

    void ResetJobMonitorWorkspace() {
        jobSnapshot = null;
        jobSerial = jobSerial + 1;
        this.CaptureJobMonitor();
    }

    static List<string> CopyJobStrings(List<string> source) {
        List<string> copy = new List<string>();
        if (source != null) {
            for (int i = 0; i < source.Count; i = i + 1) { copy.Add(source[i]); }
        }
        return copy;
    }

    void CaptureJobMonitor(bool submit = true) {
        if (jobMonitor == null || shuttingDown) { return; }
        jobAiSession = this.AiSessionVersion();
        IdeJobSnapshot prev = jobSnapshot;
        IdeJobSnapshot input = new IdeJobSnapshot();
        input.workspace = documentWorkspace;
        input.session = jobAiSession;
        input.monitor = jobMonitorEpoch;
        input.root = root;
        if (prev != null && prev.workspace != input.workspace) { prev = null; }
        input.term = termFp != 0;
        input.termConsumed = termLogLen;
        input.termSeq = prev != null ? prev.termSeq : 0;
        if (input.term && (prev == null || !prev.term)) { input.termSeq = ++jobSerial; }
        if (termFp != jobTermHandle) { input.termSeq = ++jobSerial; jobTermHandle = termFp; }
        input.run = runStreaming;
        input.runConsumed = runLogLen;
        input.runSeq = prev != null ? prev.runSeq : 0;
        if (input.run && (prev == null || !prev.run)) { input.runSeq = ++jobSerial; }
        input.git = gitJob;
        input.gitSeq = prev != null ? prev.gitSeq : 0;
        if (input.git != 0 && (prev == null || prev.git != input.git)) { input.gitSeq = ++jobSerial; }
        input.build = buildBusy;
        input.buildStart = buildStartMs;
        input.buildSeq = prev != null ? prev.buildSeq : 0;
        if (input.build && (prev == null || !prev.build || prev.buildStart != input.buildStart)) { input.buildSeq = ++jobSerial; }
        input.buildConsumed = buildLogLen;
        input.buildExe = buildExe;
        input.buildTarget = buildTargetPath;
        input.thenRun = buildThenRun;
        input.gui = buildIsGui;
        input.debug = dbgBuildPending;
        input.aiBuild = aiBuildForAi;
        input.aiUiPending = aiUiPending;
        input.aiUiScript = aiUiScript;
        input.debugger = dbg;
        input.debugSeq = jobDebugSeq;
        if (input.debug) {
            if (prev != null && prev.buildSeq == input.buildSeq && prev.debug) {
                input.breakpoints = prev.breakpoints;
                input.debugText = prev.debugText;
            } else {
                input.breakpoints = ZanIDE.MergeBreakpoints(editor.Breakpoints(), bpConds);
                input.debugText = editor.GetText();
            }
        }
        if (input.debug || dbg != null) { input.watches = IdeJobMonitor.CopyVars(dbgWatches); }
        input.ui = aiUiRunning;
        input.uiDeadline = aiUiDeadline;
        input.uiTool = aiUiTool;
        input.uiSeq = prev != null ? prev.uiSeq : 0;
        if (input.ui && (prev == null || !prev.ui || prev.uiDeadline != input.uiDeadline)) { input.uiSeq = ++jobSerial; }
        input.pub = pubBusy;
        input.packing = pubPacking;
        input.pubStart = pubStartMs;
        input.pubSeq = prev != null ? prev.pubSeq : 0;
        if (input.pub && (prev == null || !prev.pub || prev.pubStart != input.pubStart)) { input.pubSeq = ++jobSerial; }
        input.pubConsumed = pubLogLen;
        input.pubRoot = pubRoot;
        input.packed = pubPacked;
        input.exes = ZanIDE.CopyJobStrings(pubExes);
        input.ai = aiBusy.Get() == 1;
        input.request = input.ai ? jobAiRequest : null;
        input.tool = input.ai ? AiWork.Snapshot() : null;
        input.aiLaunchSeq = jobAiLaunchSeq;
        bool snapshotChanged = prev == null || !ZanIDE.SameJobSnapshot(prev, input);
        jobSnapshot = input;
        if (submit && snapshotChanged) { jobMonitor.Submit(input); }
    }

    static bool SameJobSnapshot(IdeJobSnapshot a, IdeJobSnapshot b) {
        if (a == null || b == null) { return false; }
        return a.workspace == b.workspace && a.session == b.session
            && a.monitor == b.monitor && a.root == b.root
            && a.term == b.term && a.termConsumed == b.termConsumed && a.termSeq == b.termSeq
            && a.run == b.run && a.runConsumed == b.runConsumed && a.runSeq == b.runSeq
            && a.git == b.git && a.gitSeq == b.gitSeq
            && a.build == b.build && a.buildConsumed == b.buildConsumed && a.buildSeq == b.buildSeq
            && a.ui == b.ui && a.uiSeq == b.uiSeq
            && a.pub == b.pub && a.pubConsumed == b.pubConsumed && a.pubSeq == b.pubSeq
            && a.ai == b.ai && a.request == b.request && a.tool == b.tool
            && a.debugger == b.debugger && a.debugSeq == b.debugSeq
            && a.aiLaunchSeq == b.aiLaunchSeq;
    }

    void BeginBuildJob(string target, bool thenRun, bool debug = false, bool hot = false) {
        if (buildBusy || pubBusy || shuttingDown) { return; }
        this.StartJobMonitor();
        if (jobMonitor == null) { return; }
        buildBusy = true;
        buildStartMs = Window.GetTickMs();
        buildTargetPath = target;
        buildExe = "";
        buildThenRun = thenRun;
        dbgBuildPending = debug;
        buildLogLen = 0;
        this.CaptureJobMonitor(false);
        IdeJobStart start = new IdeJobStart();
        start.input = jobSnapshot;
        start.kind = 4;
        start.target = target;
        start.hot = hot;
        jobMonitor.Begin(start);
    }

    void ConsumeHotReloadJob() {
        if (!hotReloadReq || shuttingDown) { return; }
        hotReloadReq = false;
        if (buildBusy || pubBusy) { return; }
        int active = activeTab.Get();
        string path = "";
        if (active >= 0 && active < tabs.Count) { path = tabs[active].path; }
        this.BeginBuildJob(path, true, false, true);
        dock.Focus("output");
    }

    void BeginGitJob(string args, bool refresh = false) {
        if (gitJob != 0 || shuttingDown) { return; }
        this.StartJobMonitor();
        if (jobMonitor == null) { return; }
        gitJob = refresh ? 1 : 2;
        this.CaptureJobMonitor(false);
        IdeJobStart start = new IdeJobStart();
        start.input = jobSnapshot;
        start.kind = 3;
        start.gitArgs = args;
        start.gitRefresh = refresh;
        jobMonitor.Begin(start);
    }

    void BeginPublishJob() {
        if (buildBusy || pubBusy || shuttingDown) { return; }
        this.StartJobMonitor();
        if (jobMonitor == null) { return; }
        pubPending = false;
        pubBusy = true;
        pubPacking = false;
        pubStartMs = Window.GetTickMs();
        pubLogLen = 0;
        this.CaptureJobMonitor(false);
        IdeJobStart start = new IdeJobStart();
        start.input = jobSnapshot;
        start.kind = 6;
        start.options = new List<PublishTargetOption>();
        for (int i = 0; i < pubPlatformOptions.Count; i = i + 1) {
            PublishTargetOption option = new PublishTargetOption(pubPlatformOptions[i].id,
                pubPlatformOptions[i].label, pubPlatformOptions[i].selected);
            start.options.Add(option);
        }
        jobMonitor.Begin(start);
    }

    bool IsJobResultCurrent(IdeJobResult result) {
        if (shuttingDown || jobMonitor == null || jobSnapshot == null
            || result.input.workspace != documentWorkspace
            || result.input.monitor != jobMonitorEpoch
            || result.input.root != root) { return false; }
        IdeJobSnapshot current = jobSnapshot;
        if (result.kind == 0) { return current.workspace == result.input.workspace; }
        if (result.kind == 1) { return termFp != 0 && current.termSeq == result.input.termSeq; }
        if (result.kind == 2) { return runStreaming && current.runSeq == result.input.runSeq; }
        if (result.kind == 3) { return gitJob != 0 && current.gitSeq == result.input.gitSeq; }
        if (result.kind == 4) { return buildBusy && current.buildSeq == result.input.buildSeq; }
        if (result.kind == 5) { return aiUiRunning && current.uiSeq == result.input.uiSeq
            && this.IsJobAiSessionCurrent(result.input); }
        if (result.kind == 6) { return pubBusy && current.pubSeq == result.input.pubSeq; }
        if (result.kind == 7) { return this.IsJobAiSessionCurrent(result.input)
            && aiBusy.Get() == 1 && jobAiRequest == result.input.request; }
        if (result.kind == 8) { return this.IsJobAiSessionCurrent(result.input)
            && aiBusy.Get() == 1 && AiWork.Snapshot() == result.input.tool; }
        if (result.kind == 9) { return jobDebugSeq == result.input.debugSeq && dbg == result.input.debugger; }
        if (result.kind == 10) { return this.IsJobAiSessionCurrent(result.input)
            && jobAiLaunchSeq == result.input.aiLaunchSeq; }
        return false;
    }

    bool IsJobAiSessionCurrent(IdeJobSnapshot input) {
        return this.IsAiSessionVersion(input.session);
    }

    void ApplyJobResult(IdeJobResult result) {
        if (!this.IsJobResultCurrent(result)) { return; }
        ZanIDE.AppendAll(log, result.log);
        while (log.Count > 2000) { log.RemoveAt(0); }
        if (result.phase == -1 || result.kind == 0) { coLog.Reset(); app.RequestRedraw(); return; }
        if (result.kind == 1) { termLogLen = result.consumed; }
        else if (result.kind == 2) {
            runLogLen = result.consumed;
            if (result.complete) { runStreaming = false; }
        } else if (result.kind == 3 && result.complete) {
            if (gitJob == 1 && result.files != null) {
                gitFiles = result.files;
                gitBranch = result.branch;
                gitHead = result.head;
                gitLoaded = true;
                gitSel.Set(-1);
            } else { gitLoaded = false; }
            gitJob = 0;
        } else if (result.kind == 4) { this.ApplyBuildJobResult(result); }
        else if (result.kind == 5) {
            aiUiRunning = false;
            aiMsgs.Add(this.AiToolMsg("tool", aiUiTool + "\n" + result.uiResult));
            this.ResumeAiJob();
        } else if (result.kind == 6) {
            if (result.phase == 1 && result.exes != null) { pubExes = result.exes; }
            if (result.phase == 0) { pubLogLen = result.consumed; }
            if (result.step != null && result.step != "") { pubStep = result.step; }
            if (result.phase == 2) { pubPacking = true; pubPackStartMs = Window.GetTickMs(); }
            if (result.complete) { jobPublishedTarget = result.publishFolder; this.FinishPublish(result.ok); }
        } else if (result.kind == 7) { this.ApplyAiJobResult(result); }
        else if (result.kind == 8) {
            AiWork.Consume(result.tool);
            this.AiWorkFinish(result.tool);
        } else if (result.kind == 9) { this.ApplyDebugJobResult(result); }
        else if (result.kind == 10) {
            if (!result.ok || (result.error != null && result.error != "")) {
                string error = result.error;
                if (error == null || error == "") { error = "could not prepare the AI request."; }
                aiMsgs.Add(this.AiToolMsg("error", error));
                aiBusy.Set(0);
            } else {
                if (result.pins != null) {
                    for (int i = 0; i < result.pins.Count; i = i + 1) { aiMsgs.Add(result.pins[i]); }
                }
                jobAiRequest = result.startedRequest;
                ZanIDE.aiStatReqs = ZanIDE.aiStatReqs + 1;
            }
            this.AiChatToEnd();
        }
        if ((result.kind == 5 || result.kind == 7 || result.kind == 8 || result.kind == 10
                || (result.kind == 4 && result.input.aiBuild))
            && this.IsAiSessionVersion(result.input.session)) {
            this.SaveAiSessions(result.input.session);
        }
        coLog.Reset();
        this.CaptureJobMonitor();
        app.RequestRedraw();
    }

    string BeginAiJob() {
        if (shuttingDown) { return "IDE is shutting down."; }
        this.StartJobMonitor();
        if (jobMonitor == null) { return "could not start the AI job monitor."; }
        jobAiLaunchSeq = ++jobSerial;
        jobAiRequest = null;
        AiNet.Abandon();
        this.CaptureJobMonitor(false);
        IdeJobStart start = new IdeJobStart();
        start.kind = 10;
        start.input = jobSnapshot;
        start.agent = aiRunAgent;
        start.contextName = aiRunCtxName;
        start.contextCode = aiRunCtxCode;
        start.baseUrl = aiProfiles[aiProfActive].baseUrl;
        start.key = aiProfiles[aiProfActive].key;
        start.model = aiRunModel;
        start.messages = new List<ChatMessage>();
        for (int i = 0; i < aiMsgs.Count; i = i + 1) {
            ChatMessage source = aiMsgs[i];
            ChatMessage copy = ChatMessage.CreateWithReason(source.role, source.text, source.reason);
            copy.agent = source.agent;
            copy.to = source.to;
            copy.kind = source.kind;
            copy.taskId = source.taskId;
            copy.progress = source.progress;
            copy.call = source.call;
            copy.at = source.at;
            copy.img = source.img;
            copy.msgId = source.msgId;
            copy.mark = source.mark;
            copy.quoteWho = source.quoteWho;
            copy.quoteText = source.quoteText;
            copy.quoteId = source.quoteId;
            copy.card = source.card;
            start.messages.Add(copy);
        }
        jobMonitor.Begin(start);
        return "";
    }

    void ResumeAiJob() {
        string error = this.BeginAiJob();
        if (error != "") { aiMsgs.Add(this.AiToolMsg("error", error)); aiBusy.Set(0); }
        this.AiChatToEnd();
    }

    void BeginDebugCommand(string command, string argument = "", int line = -1) {
        if (shuttingDown || dbg == null) { return; }
        this.StartJobMonitor();
        if (jobMonitor == null) { return; }
        jobDebugSeq = ++jobSerial;
        if (command == "stop") { dbg.CancelWait(); }
        this.CaptureJobMonitor(false);
        IdeJobStart start = new IdeJobStart();
        start.kind = 9;
        start.input = jobSnapshot;
        start.command = command;
        start.argument = argument;
        start.watch = line;
        jobMonitor.Begin(start);
    }

    void ApplyDebugJobResult(IdeJobResult result) {
        dbg = result.debugSession;
        dbgState = result.debugState;
        dbgExecLine = result.debugLine;
        dbgConsole = result.debugConsole;
        dbgVarInfo = result.debugVars;
        dbgStack = result.debugStack;
        if (result.watches != null) { dbgWatches = result.watches; }
        editor.SetExecLine(dbgExecLine);
        if (result.debugCommand == "evaluate") {
            if (result.debugWatch >= 0 && result.debugWatch < dbgWatches.Count
                && dbgWatches[result.debugWatch].name == result.debugExpression) {
                dbgWatches[result.debugWatch].val = result.debugValue;
            } else if (result.debugExpression != "") {
                log.Add("> " + result.debugExpression + " = " + result.debugValue);
            }
        }
    }

    void ApplyBuildJobResult(IdeJobResult result) {
        if (result.phase == 1) {
            buildExe = result.exe;
            if (result.target != null && result.target != "") { buildTargetPath = result.target; }
            buildIsGui = result.gui;
            buildThenRun = result.thenRun;
            if (!result.complete) { return; }
        }
        buildLogLen = result.consumed;
        if (!result.complete) { return; }
        buildBusy = false;
        if (result.timeout) {
            dbgBuildPending = false;
            aiBuildForAi = false;
            log.Add(ZanIDE.T("> Build timed out; no compiler result.", "> 构建超时，未拿到编译结果。"));
            dock.Focus("errors");
            return;
        }
        List<string> output = result.output;
        if (output == null) { output = new List<string>(); }
        int active = activeTab.Get();
        if (result.diagnostics != null && active >= 0 && active < tabs.Count
            && ZanIDE.SamePath(tabs[active].path, result.input.buildTarget)) {
            editor.SetCompilerDiagnostics(result.diagnostics);
            if (result.diagnostics.Count > 0) {
                log.Add("> " + Convert.ToString(result.diagnostics.Count) + " error(s) in this file; jumped to the first.");
            }
        }
        if (dbgBuildPending) {
            dbgBuildPending = false;
            if (!result.ok) { log.Add("> [Debug] Build failed."); }
            else {
                dbg = result.debugSession;
                dbgState = result.debugState;
                dbgExecLine = result.debugLine;
                dbgConsole = result.debugConsole;
                dbgVarInfo = result.debugVars;
                dbgStack = result.debugStack;
                if (result.watches != null) { dbgWatches = result.watches; }
                editor.SetExecLine(dbgExecLine);
                dbgPanelTab.Set(1);
                if (dbgState == 2) {
                    log.Add(">   F5=Continue  F10=StepOver  F11=StepInto  Ctrl+B=Condition  Esc=Stop");
                    ZanIDE.LogVarsToConsole(log, dbgVarInfo, dbgExecLine);
                }
            }
        } else if (!result.ok) {
            if (result.missingPackage != null && result.missingPackage != "") {
                log.Add(ZanIDE.T("> Missing package: ", "> 缺少库：") + result.missingPackage
                    + ZanIDE.T(" (install it from Extensions)", "（可到「扩展」里安装）"));
            }
            log.Add(ZanIDE.T("> Build failed; not run.", "> 构建失败，未运行。"));
            dock.Focus("errors");
        } else if (result.consoleStarted) { runLogLen = 0; runStreaming = true; }
        else if (!result.thenRun) { log.Add(ZanIDE.T("> Build succeeded.", "> 构建成功。")); }
        this.RefreshSymbolIndex(true);
        if (aiBuildForAi && this.IsJobAiSessionCurrent(result.input)) {
            aiBuildForAi = false;
            string tool = aiUiPending ? aiUiTool : (buildThenRun ? "run" : "build");
            this.AiRunBuildDone(result.ok, tool, output);
            if (aiUiPending) {
                aiUiPending = false;
                if (result.uiStarted) {
                    aiUiRunning = true;
                    aiUiDeadline = result.uiDeadline;
                    log.Add(ZanIDE.T("> [AI] Driving UI...", "> [AI] 正在驱动 UI 自检..."));
                } else {
                    aiMsgs.Add(this.AiToolMsg("tool", aiUiTool + "\n" + AiAgent.BuildResult(output, false, false)));
                    this.ResumeAiJob();
                }
            } else {
                aiMsgs.Add(this.AiToolMsg("tool", (buildThenRun ? "run\n" : "build\n")
                    + AiAgent.BuildResult(output, result.ok, buildThenRun)));
                this.ResumeAiJob();
            }
        }
    }

    void ApplyAiFinalResult(IdeJobResult result) {
        this.AiStreamDrop(true);
        jobAiRequest = null;
        AiNet.Abandon();
        SseAnswer answer = result.answer;
        if (answer.totalTokens > 0 || answer.promptTokens > 0) {
            aiTokPrompt = answer.promptTokens;
            aiTokCompletion = answer.completionTokens;
            aiTokTotal = answer.totalTokens;
            aiTokCached = answer.cachedTokens;
        }
        ZanIDE.AiStatAdd(answer);
        string done = result.done;
        bool ok = done.Length >= 2 && done.Substring(0, 2) == "ok";
        if (!ok || answer.error != "") {
            string error = done;
            if (error.Length >= 5 && error.Substring(0, 5) == "err: ") {
                error = error.Substring(5, error.Length - 5);
            }
            if (answer.error != "") {
                if (error != "" && !ok) { error = error + ": " + answer.error; }
                else { error = answer.error; }
            }
            if (error == "") { error = "the AI request failed."; }
            ZanIDE.aiStatFails = ZanIDE.aiStatFails + 1;
            bool retry = answer.error == "" && AiAgent.IsTransient(error)
                && aiRetry < AiAgent.MaxRetries();
            if (retry) {
                aiRetry = aiRetry + 1;
                string startError = this.BeginAiJob();
                if (startError == "") {
                    log.Add("> 小赞: " + error + " - " + ZanIDE.T("retrying (", "重试中（")
                        + Convert.ToString(aiRetry) + "/" + Convert.ToString(AiAgent.MaxRetries())
                        + ZanIDE.T(")", "）"));
                    Layer.Msg(ZanIDE.T("Xiao Zan request failed - retrying", "小赞请求失败——正在重试"), 3);
                } else {
                    aiMsgs.Add(ChatMessage.Create("error", "[error] " + startError));
                    aiBusy.Set(0);
                }
            } else {
                aiRetry = 0;
                aiMsgs.Add(ChatMessage.Create("error", "[error] " + error));
                aiBusy.Set(0);
            }
            this.AiChatToEnd();
            return;
        }
        aiRetry = 0;
        string call = result.call;
        string said = result.said;
        bool more = call != "" && AiAgent.StepsSinceUser(aiMsgs) < AiAgent.MaxSteps();
        if (said != "" || result.reasoning != "" || result.archiveCall != null && result.archiveCall != "") {
            ChatMessage message = ChatMessage.CreateWithReason("assistant", said, result.reasoning);
            message.call = result.archiveCall == null ? "" : result.archiveCall;
            if (aiTeamMode) {
                AiEnvelope envelope = result.envelope;
                AiTeam.ApplyToTasks(aiTasks, aiRunAgent, envelope);
                message.agent = aiRunAgent;
                message.kind = envelope.kind;
                message.taskId = envelope.taskId;
                message.progress = envelope.progress;
                message.to = AiTeam.JoinIds(envelope.to);
            }
            aiMsgs.Add(message);
        }
        if (more) {
            if (AiAgent.IsMutating(result.toolName) && !aiAutoExec) {
                aiPendingCall = call;
                aiBusy.Set(2);
            } else { this.AiDispatchTool(call); }
        } else {
            bool limitHit = call != "" && AiAgent.IsMutating(result.toolName);
            string badTool = result.badTool == null ? "" : result.badTool;
            if (badTool != "") {
                aiIdleWhy = ZanIDE.T("the tool block could not be parsed, so nothing ran",
                    "它发的工具块解析不出来（格式不对或被截断），所以那个调用根本没执行");
            }
            if (limitHit) {
                aiIdleWhy = ZanIDE.T("the per-turn tool budget ran out", "这一问的工具预算用完了");
            }
            bool cont = aiAutoCont < aiContMax && (limitHit || badTool != ""
                || (!aiTeamMode && aiAutoExec && this.AiPlanUnfinished() && !AiAgent.AsksUser(said)));
            if (cont) {
                aiAutoCont = aiAutoCont + 1;
                string body = AiAgent.ContinuePrompt(limitHit, this.AiCurStep());
                if (badTool != "") { body = badTool; }
                ChatMessage message = ChatMessage.Create("user", body);
                message.agent = AiTeam.Auto();
                message.to = aiRunAgent;
                aiMsgs.Add(message);
                string error = this.BeginAiJob();
                if (error != "") { aiMsgs.Add(ChatMessage.Create("error", error)); aiBusy.Set(0); }
            } else {
                if (limitHit) {
                    aiMsgs.Add(ChatMessage.Create("error", ZanIDE.T("Tool limit reached for this question.",
                        "本次提问的工具调用次数已达上限。")));
                }
                this.AiRunTurnEnd(said);
                this.AiTeamTurnEnd(said);
                if (aiBusy.Get() == 0 && aiAutoCont >= aiContMax
                    && (this.AiPlanUnfinished() || (aiTeamMode && AiTeam.HasUnfinished(aiTasks)))) {
                    aiMsgs.Add(ChatMessage.Create("error", ZanIDE.T(
                        "Auto-continue budget spent with work left; say \"continue\" to push on.",
                        "自动继续次数已用完，任务还没做完；回一句「继续」就接着跑。")));
                }
            }
        }
        this.AiChatToEnd();
    }

    void ApplyAiJobResult(IdeJobResult result) {
        if (result.dropPreview) { this.AiStreamDrop(true); }
        if (result.live != null && result.live != "") {
            bool valid = aiStreamMsgIdx >= 0 && aiStreamMsgIdx == aiMsgs.Count - 1
                && aiMsgs[aiStreamMsgIdx].role == "assistant";
            if (valid) { aiMsgs[aiStreamMsgIdx].text = result.live; }
            else {
                ChatMessage message = ChatMessage.Create("assistant", result.live);
                message.agent = aiRunAgent;
                aiMsgs.Add(message);
                aiStreamMsgIdx = aiMsgs.Count - 1;
            }
            this.AiChatToEnd();
        }
        if (result.timeout) {
            this.AiStreamDrop(true);
            aiMsgs.Add(ChatMessage.Create("error", ZanIDE.T(
                "[error] AI request timed out - no response received.", "[错误] AI 请求超时——未收到响应。")));
            aiBusy.Set(0);
            this.AiChatToEnd();
            return;
        }
        if (result.final) { this.ApplyAiFinalResult(result); }
    }
}
