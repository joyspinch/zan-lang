using System;
using System.Text;
using System.Json;

// SSE 帧的折叠：把一帧 JSON 里的增量文本 / 错误 / 用量折进 SseAnswer。
//
// 单独成文件是为了能独立测试：纯函数提取，仅依赖 SseAnswer 与 JsonDoc。
partial class AiAgent {
    // 去首尾空白（空格 / 换行 / 回车 / 制表）。SSE 的 `data:` 载荷前后
    // 常常有空白，解析前要剪掉。放在这个文件里是为了让 SSE 相关的那几
    // 个文件（AiAgent.Sse / SseLive）能单独编译、单独写用例。
    static string Trim(string s) {
        int a = 0;
        for (a = 0; a < s.Length; a = a + 1) {
            string ch = s.Substring(a, 1);
            if (ch != " " && ch != "\n" && ch != "\r" && ch != "\t") { break; }
        }
        int b = s.Length;
        for (b = s.Length; b > a; b = b - 1) {
            string ch = s.Substring(b - 1, 1);
            if (ch != " " && ch != "\n" && ch != "\r" && ch != "\t") { break; }
        }
        return s.Substring(a, b - a);
    }

    public static void FoldChunk(SseAnswer a, StringBuilder c, StringBuilder r, string raw) {
        if (raw == null || raw.Length == 0) { return; }
        try {
            JsonDoc.ParseScoped(raw, doc => {
                int root = doc.root;
                if (doc.KindAt(root) != 5) { return; }

                int errSlot = doc.Get(root, "error");
                if (errSlot >= 0 && a.error == "") {
                    if (doc.KindAt(errSlot) == 5) {
                        a.error = doc.Str(errSlot, "message", raw);
                    } else {
                        a.error = doc.StrAt(errSlot, raw);
                    }
                }

                int chSlot = doc.Get(root, "choices");
                if (chSlot >= 0 && doc.KindAt(chSlot) == 4 && doc.Count(chSlot) > 0) {
                    int firstChoice = doc.FirstChild(chSlot);
                    if (firstChoice >= 0 && doc.KindAt(firstChoice) == 5) {
                        int deltaSlot = doc.Get(firstChoice, "delta");
                        if (deltaSlot >= 0 && doc.KindAt(deltaSlot) == 5) {
                            c.Append(doc.Str(deltaSlot, "content", ""));
                            r.Append(doc.Str(deltaSlot, "reasoning_content", ""));
                        } else {
                            int msgSlot = doc.Get(firstChoice, "message");
                            if (msgSlot >= 0 && doc.KindAt(msgSlot) == 5) {
                                c.Append(doc.Str(msgSlot, "content", ""));
                                r.Append(doc.Str(msgSlot, "reasoning_content", ""));
                            }
                        }
                    }
                }

                int usSlot = doc.Get(root, "usage");
                if (usSlot >= 0 && doc.KindAt(usSlot) == 5) {
                    a.promptTokens = (int)doc.Long(usSlot, "prompt_tokens", (long)a.promptTokens);
                    a.completionTokens = (int)doc.Long(usSlot, "completion_tokens", (long)a.completionTokens);
                    a.totalTokens = (int)doc.Long(usSlot, "total_tokens", (long)a.totalTokens);
                    a.cachedTokens = (int)doc.Long(usSlot, "prompt_cache_hit_tokens", (long)a.cachedTokens);
                    int pdSlot = doc.Get(usSlot, "prompt_tokens_details");
                    if (pdSlot >= 0 && doc.KindAt(pdSlot) == 5) {
                        a.cachedTokens = (int)doc.Long(pdSlot, "cached_tokens", (long)a.cachedTokens);
                    }
                }
            });
        } catch (Exception) {
        }
    }
}
