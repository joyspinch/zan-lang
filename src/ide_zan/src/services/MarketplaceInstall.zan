using System;
using System.IO;
using System.Diagnostics;
using System.Threading;
using System.Collections.Generic;
using System.IO.Compression;
using System.Json;
using System.Net.Http.Client;
using System.Net.External;
using System.Net.Sockets;
using System.Security.Cryptography;

// 商城扩展的安装执行器：把"确认安装"的意图变成落地的包。
// 管线（Install() 发起，后台线程执行，Poll() 每帧收结果）：
// 1. GET /api/mall/product?id= 已由目录完成，这里只消费
// MarketplacePackage.LatestVersion() 的 artifact_url/sha256；
// 2. 下载制品（二进制安全通道，NUL 不截断）到缓存临时文件；
// 3. 必须校验 SHA256 与独立配置的平台 RSA 公钥签名；
// 4. 解 zip 到暂存目录（Zip.ExtractToDirectory 内建路径穿越防护）；
// 5. 读暂存目录的 zan.pkg，要求 name 一致且声明了版本；
// 6. 调 zanc --package-install <dir> --package-name <name> 走编译器
// 自己的安装器（拷进 <project>/.zan-packages/<name>/ 或全局仓库，
// 编译器通过 stdlib/<namespace>/ 布局发现它们）。
// app 类商品始终交浏览器处理，不进入 IDE 安装管线。
// Task.Run 跟踪异步 Worker；结果槽由任务参数保活，关闭时统一 join。
// SseSink 回传 + UI 每帧 Poll。所有步骤的失败都变成
// 一条 "err:..." 结果，不会把线程静默吞掉。
public class MarketplaceInstall {
    static SseSink sink;
    static List<long> workers;
    static bool closing;
    // 0 = 空闲；1..5 = 步骤（下载/校验/解压/检查清单/安装）；9 = 完成。
    static int step;
    static string packageName;
    static string slug;
    static string version;
    static string signature;
    static string installRoot;
    static string trustedSignerFile;
    static bool lastSucceeded;

    static bool LastSucceeded() { return MarketplaceInstall.lastSucceeded; }

    // Only independent local configuration establishes platform signer trust.
    static string TrustedKeyFile() {
        string path = Environment.GetEnvironmentVariable("ZAN_MALL_SIGNER_PUBLIC_KEYSET_FILE");
        if (path.Length == 0) { path = Environment.GetEnvironmentVariable("ZAN_MALL_SIGNER_PUBLIC_KEY_FILE"); }
        return path.Length > 0 ? Path.GetFullPath(path) : "";
    }

    static string ResolveUrl(string url) {
        return MarketplaceProtocol.ResolveUrl(url, MarketplaceClient.BaseUrl());
    }

    static string BrowserUrl(MarketplacePackage package) {
        return MarketplaceProtocol.BrowserUrl(package, MarketplaceClient.BaseUrl());
    }
    static string productType;
    // 商业插件信任链：商城下发的 plugin_id 与钉住的公钥指纹（64 hex）。
    // plugin_id 非空 = 本次安装按插件验签流程走。
    static string pluginId;
    static string pubkeyFp;
    static string artifactUrl;
    static string artifactSha256;
    // 全程一次的状态行（轮转追加给状态条）。
    static string progress;
    // 成功 / 失败后的最终一句话；"" = 未结束。
    static string outcome;

    static string T(string en, string zh) { return Lang.Tr(en, zh); }

    // 是否有安装流程在跑（UI 据此禁用按钮）。
    static bool Busy() { return MarketplaceInstall.sink != null; }

    static string Progress() { return MarketplaceInstall.progress; }

    // 已结束的最终结果并复位状态（"" = 还没结束）。UI 只读一次。
    static string TakeOutcome() {
        string s = MarketplaceInstall.outcome;
        MarketplaceInstall.outcome = "";
        if (s.Length > 0) {
            MarketplaceInstall.step = 0;
            MarketplaceInstall.progress = "";
            MarketplaceInstall.sink = null;
        }
        return s;
    }

    // 发起安装。package 是目录里已选中的（详情已加载）。
    // 返回 "" = 已发起；非空 = 未发起的原因。
    static string Start(MarketplacePackage package, string projectRoot = "") {
        if (MarketplaceInstall.closing) { return "IDE is closing"; }
        if (package == null || !package.CanInstallFree()) {
            return T("use the product page to purchase or download", "请到商品页购买或下载");
        }
        if (!MarketplaceProtocol.SafeName(package.slug)
            || !MarketplaceProtocol.SafeName(package.packageName)) {
            return T("missing or invalid slug/package_name", "缺少有效的商品标识或包名");
        }
        if (MarketplaceInstall.Busy()) { return T("install already running",
            "已有安装在进行中"); }
        MarketplaceVersion v = package.LatestVersion();
        if (v == null) { return T("no installable version", "没有可安装的版本"); }
        if (v.artifactUrl.Length == 0) { return T("no artifact for this version",
            "该版本没有制品包"); }
        if (!MarketplaceProtocol.SafeVersion(v.version)
            || !MarketplaceProtocol.ValidSha256(v.artifactSha256) || v.artifactSignature == "") {
            return T("version, SHA256 and platform signature are required", "必须提供版本、SHA256 和平台签名");
        }
        if (MarketplaceInstall.ResolveUrl(v.artifactUrl) == "") { return "invalid artifact URL"; }
        if (MarketplaceInstall.TrustedKeyFile() == "") {
            return "configure ZAN_MALL_SIGNER_PUBLIC_KEY_FILE before installing";
        }
        if ((package.IsPlugin() || package.pluginId != "")
            && (package.pluginId == "" || !MarketplaceProtocol.ValidSha256(package.pubkeyFp))) {
            return "plugin identity and key fingerprint are required";
        }
        MarketplaceInstall.slug = package.slug;
        MarketplaceInstall.version = v.version;
        MarketplaceInstall.signature = v.artifactSignature;
        MarketplaceInstall.installRoot = projectRoot;
        MarketplaceInstall.trustedSignerFile = MarketplaceInstall.TrustedKeyFile();
        MarketplaceInstall.lastSucceeded = false;
        MarketplaceInstall.packageName = package.packageName;
        MarketplaceInstall.productType = package.productType;
        MarketplaceInstall.pluginId = package.pluginId;
        MarketplaceInstall.pubkeyFp = package.pubkeyFp;
        MarketplaceInstall.artifactUrl = MarketplaceInstall.ResolveUrl(v.artifactUrl);
        MarketplaceInstall.artifactSha256 = v.artifactSha256;
        MarketplaceInstall.step = 1;
        MarketplaceInstall.progress = T("Downloading ", "正在下载 ")
            + v.artifactUrl;
        MarketplaceInstall.outcome = "";
        MarketplaceInstall.sink = SseSink.ToMemory();
        if (MarketplaceInstall.workers == null) { MarketplaceInstall.workers = new List<long>(); }
        long worker = Task.Run(MarketplaceInstall.Worker(MarketplaceInstall.sink));
        MarketplaceInstall.workers.Add(worker);
        return "";
    }

    // 与 MarketplaceClient.CallPolicy 同款预算；制品可能几十 MB，
    // 上限放到 256 MB。HTTPS-only（loopback 明文例外）。
    static ExternalCallPolicy CallPolicy(string host) {
        ExternalCallPolicy policy = ExternalCallPolicy.Default()
            .TotalTimeout(120000)
            .ResponseLimit(256 * 1024 * 1024)
            .StreamLimit(256 * 1024 * 1024)
            .Redirects(0)
            .RetryNetwork(false)
            .RetryAttempts(0);
        if (ExternalTargetPolicy.IsLoopback(host)) { policy.AllowLocalHttp(); }
        return policy;
    }

    static string AbsoluteUrl(string url) {
        return MarketplaceInstall.ResolveUrl(url);
    }

    // 下载暂存文件：缓存目录下 mall-<slug>-<ver>.zip。返回错误或 ""。
    static async string DownloadArtifact(string target) {
        string url = MarketplaceInstall.AbsoluteUrl(MarketplaceInstall.artifactUrl);
        ExternalTarget t = ExternalTarget.Parse(url);
        if (t == null) { return T("bad artifact url", "制品地址无效"); }
        HttpClient cli;
        if (t.IsTls()) {
            cli = HttpClient.CreateHttps(t.Host(), t.Port());
        } else {
            cli = new HttpClient(t.Host(), t.Port());
        }
        cli.SetCallPolicy(MarketplaceInstall.CallPolicy(t.Host()));
        cli.SetTimeout(120000);
        // 二进制安全通道：zip 里的 NUL 不能截断响应。
        HttpResponse resp = await cli.SendBytesAsync("GET",
            t.Path() + t.Query(), "");
        if (resp.statusCode != 200) {
            return "HTTP " + Convert.ToString(resp.statusCode);
        }
        byte[] data;
        int len;
        if (resp.IsBinary()) {
            len = resp.BodyLength();
            if (len <= 0) { return T("empty artifact", "制品为空"); }
            if (resp.bodyBytes == null || len > resp.bodyBytes.Length) {
                return T("bad artifact length", "制品长度无效");
            }
            // HTTP keeps a trailing NUL in its backing buffer; only the
            // logical body belongs in the signed archive and SHA256 input.
            data = new byte[len];
            for (int i = 0; i < len; i = i + 1) {
                data[i] = resp.bodyBytes[i];
            }
        } else {
            data = new byte[resp.body.Length];
            for (int i = 0; i < resp.body.Length; i = i + 1) {
                data[i] = resp.body[i] & 255;
            }
            len = resp.body.Length;
        }
        if (len <= 0) { return T("empty artifact", "制品为空"); }
        File.WriteAllBytes(target, data);
        return "";
    }

    static async void Worker(SseSink target) {
        Socket.Initialize();
        string err = "";
        try { err = await MarketplaceInstall.Pipeline(); }
        catch (Exception ex) {
            err = ex.Message;
            if (err == "") { err = "install worker failed"; }
        }
        if (err.Length > 0) { target.Publish("err:" + err); }
        else { target.Publish("ok:installed"); }
    }

    static void BeginShutdown() { MarketplaceInstall.closing = true; }

    static async void DrainAsync() {
        MarketplaceInstall.BeginShutdown();
        if (MarketplaceInstall.workers != null) { await Task.WhenAll(MarketplaceInstall.workers); }
        MarketplaceInstall.sink = null;
    }

    // 顺序执行 1..5 步；任何一步失败返回原因（后续不再执行）。
    static async string Pipeline() {
        ZanIDE.EnsureCacheDir();
        string cache = ZanIDE.CacheDir() + "/mall";
        Directory.CreateDirectoryRecursive(cache);
        string zip = cache + "/mall-" + MarketplaceInstall.packageName + ".zip";
        string stage = cache + "/stage-" + MarketplaceInstall.packageName;

        MarketplaceInstall.step = 1;
        string err = await MarketplaceInstall.DownloadArtifact(zip);
        if (err.Length > 0) { return T("download failed: ", "下载失败：") + err; }

        MarketplaceInstall.step = 2;
        byte[] data = File.ReadAllBytes(zip);
        if (data == null) { return T("downloaded file unreadable", "下载文件不可读"); }
        string got = Hex.Encode(Sha256.Hash(data, data.Length), 32);
        if (!MarketplaceProtocol.ValidSha256(MarketplaceInstall.artifactSha256)
            || got != MarketplaceInstall.artifactSha256) {
            File.Delete(zip);
            return T("artifact SHA256 mismatch", "制品 SHA256 不符");
        }
        string keyFile = MarketplaceInstall.trustedSignerFile;
        if (keyFile == "" || !File.Exists(keyFile) || File.GetSize64(keyFile) > 16384) { return "trusted platform signer key file missing or oversized"; }
        // PKCS#1 v1.5 / SHA256; trust comes only from the configured local PEM.
        if (!MarketplaceProtocol.VerifySignature(File.ReadAllText(keyFile),
            MarketplaceInstall.slug, MarketplaceInstall.version,
            MarketplaceInstall.artifactSha256, MarketplaceInstall.signature)) {
            File.Delete(zip);
            return T("platform artifact signature verification failed", "平台制品签名校验失败");
        }
        MarketplaceInstall.progress = T("Artifact signature verified.", "制品签名校验通过。");

        MarketplaceInstall.step = 3;
        if (Directory.Exists(stage)) { Directory.DeleteRecursive(stage); }
        int n = Zip.ExtractToDirectory(zip, stage);
        if (n < 0) { return T("bad package archive", "包归档损坏"); }

        MarketplaceInstall.step = 4;
        string manifest = stage + "/zan.pkg";
        if (!File.Exists(manifest)) {
            return T("package has no zan.pkg manifest", "包缺少 zan.pkg 清单");
        }
        string mtext = File.ReadAllText(manifest);
        string mname = MarketplaceInstall.ManifestField(mtext, "name");
        if (mname != MarketplaceInstall.packageName) {
            return T("manifest name mismatch: ", "清单名不符：") + mname;
        }
        if (MarketplaceInstall.ManifestField(mtext, "version") != MarketplaceInstall.version) {
            return T("manifest version mismatch", "清单版本不符");
        }
        // 商业插件：装前验签。商城钉的公钥指纹对不上包里的 plugin.pub，
        // 或清单/源码被篡改，都拒绝安装（错误信息即返回原因）。
        string manifestPlugin = MarketplaceInstall.ManifestField(mtext, "plugin_id");
        if (manifestPlugin != "" || MarketplaceInstall.pluginId != ""
            || MarketplaceInstall.productType == "plugin") {
            if (MarketplaceInstall.pluginId == ""
                || !MarketplaceProtocol.ValidSha256(MarketplaceInstall.pubkeyFp)
                || manifestPlugin != MarketplaceInstall.pluginId) {
                return T("plugin identity mismatch", "插件身份不符");
            }
            string sigErr = MarketplaceInstall.VerifyPluginSignature(stage);
            if (sigErr.Length > 0) { return sigErr; }
        }
        MarketplaceInstall.progress = T("Signature verified.", "签名校验通过。");

        MarketplaceInstall.step = 5;
        MarketplaceInstall.progress = T("Installing into package store...",
            "正在装进包仓库...");
        // Destination was captured at dispatch; workers never inspect live IDE state.
        string projectRoot = MarketplaceInstall.installRoot;
        string cmd = "\"" + ZanIDE.Zanc() + "\" --stdlib-path \""
            + ZanIDE.StdlibDir() + "\" --package-install \"" + stage
            + "\" --package-name \"" + MarketplaceInstall.packageName + "\"";
        if (projectRoot.Length > 0) {
            cmd = cmd + " --package-project \"" + projectRoot
                + "\" --package-scope project";
        }
        ProcessResult r = Process.Capture(cmd);
        // 编译器安装器会为商业插件在 stderr 打 ZANPKG_USAGE（scope 行），
        // 这里与构建日志同一条上报链路（PluginUsage 解析 + 去重 + 异步上报）。
        List<string> installLines = ZanIDE.SplitLinesOf(r.Text());
        for (int i = 0; i < installLines.Count; i = i + 1) {
            PluginUsage.Observe(installLines[i]);
        }
        bool ok = r.Ok();
        if (!ok) {
            string tail = r.Text();
            int cut = tail.Length - 160;
            if (cut > 0) { tail = tail.Substring(cut, 160); }
            return T("install refused: ", "安装被拒：") + tail;
        }
        MarketplaceInstall.step = 9;
        return "";
    }

    // zan.pkg 顶层 `key = "value"` 的取值（清单格式见 package.c 的解析器）。
    static string ManifestField(string text, string key) {
        List<string> lines = ZanIDE.SplitLinesOf(text);
        for (int i = 0; i < lines.Count; i = i + 1) {
            string ln = lines[i].Trim();
            if (ln.Length > key.Length + 2
                && ln.IndexOf("=") >= 0
                && ln.Substring(0, ln.IndexOf("=")).Trim() == key) {
                string v = ln.Substring(ln.IndexOf("=") + 1).Trim();
                if (v.Length >= 2 && v.Substring(0, 1) == "\""
                    && v.Substring(v.Length - 1, 1) == "\"") {
                    return v.Substring(1, v.Length - 2);
                }
                return v;
            }
        }
        return "";
    }

    // 商业插件的装前签名校验（信任链：平台钉的 pubkey_fp → 包内
    // plugin.pub → 对 payload 哈希清单的 plugin.sig）。清单内容与
    // scripts/pluginkey.ps1 sign 生成侧完全一致：对每个文件取
    // "sha256(小写hex)  相对路径(/ 分隔)"，按行排序，LF 结尾，排除
    // plugin.sig 本身。三处失败都给出明确原因：
    // - 包里没有 plugin.pub/plugin.sig → 未签名
    // - plugin.pub 指纹 ≠ 商城下发的 pubkey_fp → 公钥被调包
    // - 验签不过 → payload（清单/源码）被篡改
    static string VerifyPluginSignature(string stage) {
        string pubPath = stage + "/plugin.pub";
        string sigPath = stage + "/plugin.sig";
        if (!File.Exists(pubPath) || !File.Exists(sigPath)) {
            return T("package is not signed (missing plugin.pub/plugin.sig)",
                "包未签名（缺少 plugin.pub/plugin.sig）");
        }
        byte[] pubBytes = File.ReadAllBytes(pubPath);
        byte[] sigBytes = File.ReadAllBytes(sigPath);
        if (pubBytes == null || sigBytes == null) {
            return T("signature files unreadable", "签名文件不可读");
        }
        string pubPem = File.ReadAllText(pubPath);
        // 平台钉的指纹必须与包内公钥一致，否则拒绝（防公钥调包）。
        string fp = Hex.Encode(Sha256.Hash(pubBytes, pubBytes.Length), 32);
        if (fp != MarketplaceInstall.pubkeyFp) {
            return T("plugin public key fingerprint mismatch",
                "插件公钥指纹与商城记录不符");
        }
        RsaKey key = RsaKey.FromPublicPem(pubPem);
        if (key == null) {
            return T("plugin public key unreadable", "插件公钥无法解析");
        }
        string message = MarketplaceInstall.PayloadManifest(stage);
        if (message.Length == 0) {
            return T("package payload is empty", "包内容为空");
        }
        // 签名是原始 256 字节，VerifySha256 吃 Base64；清单消息是纯 ASCII
        // ("hex  path\n" 行)，string 逐字符即字节，无需额外编码。
        if (!key.VerifySha256(message,
            Base64.Encode(sigBytes, sigBytes.Length))) {
            return T("plugin signature verification failed (payload tampered?)",
                "插件验签失败（包内容可能被篡改）");
        }
        return "";
    }

    // 对 stage 目录递归生成待签名清单："sha256hex  相对路径"行，
    // 按行排序、LF 结尾，排除 plugin.sig 本身。与 pluginkey.ps1 生成侧
    // 完全一致，任何字节差异都会导致验签失败。
    static string PayloadManifest(string stage) {
        List<string> lines = new List<string>();
        MarketplaceInstall.PayloadWalk(stage, "", lines);
        if (lines.Count == 0) { return ""; }
        for (int i = 1; i < lines.Count; i = i + 1) {
            string line = lines[i];
            int j = i - 1;
            while (j >= 0 && MarketplaceInstall.CompareText(lines[j], line) > 0) {
                lines[j + 1] = lines[j];
                j = j - 1;
            }
            lines[j + 1] = line;
        }
        string message = "";
        for (int i = 0; i < lines.Count; i = i + 1) {
            message = message + lines[i] + "\n";
        }
        return message;
    }

    static void PayloadWalk(string root, string rel, List<string> lines) {
        string here = root + (rel.Length > 0 ? "/" + rel : "");
        List<string> dirs = Directory.GetDirectories(here);
        for (int i = 0; i < dirs.Count; i = i + 1) {
            // GetFiles/GetDirectories 返回裸名；读文件须拼回全路径。
            string baseName = MarketplaceInstall.BaseName(dirs[i]);
            MarketplaceInstall.PayloadWalk(root,
                rel.Length > 0 ? rel + "/" + baseName : baseName, lines);
        }
        List<string> files = Directory.GetFiles(here);
        for (int i = 0; i < files.Count; i = i + 1) {
            string baseName = MarketplaceInstall.BaseName(files[i]);
            string childRel = rel.Length > 0 ? rel + "/" + baseName : baseName;
            if (childRel == "plugin.sig") { continue; }
            byte[] data = File.ReadAllBytes(here + "/" + baseName);
            if (data == null) { throw new IOException("unreadable plugin payload: " + childRel); }
            lines.Add(Hex.Encode(Sha256.Hash(data, data.Length), 32)
                + "  " + childRel);
        }
    }

    static int CompareText(string a, string b) {
        int count = a.Length < b.Length ? a.Length : b.Length;
        for (int i = 0; i < count; i = i + 1) {
            if (a[i] != b[i]) { return (a[i] & 255) - (b[i] & 255); }
        }
        return a.Length - b.Length;
    }

    static string BaseName(string path) {
        int slash = path.LastIndexOf("/") >= 0
            ? path.LastIndexOf("/") : path.LastIndexOf("\\");
        return slash >= 0 ? path.Substring(slash + 1) : path;
    }

    // UI 每帧调用：完成后取结果。返回 "" = 还在跑或空闲；
    // 非空 = 本次安装的最终一句话（含成败），内部已复位。
    static string Poll() {
        if (MarketplaceInstall.sink == null) { return ""; }
        string done = MarketplaceInstall.sink.Done();
        if (done == "") { return ""; }
        MarketplaceInstall.sink = null;
        MarketplaceInstall.lastSucceeded = done == "ok:installed";
        if (!MarketplaceInstall.lastSucceeded && !done.StartsWith("err:")) {
            done = "err:invalid install worker result";
        }
        if (done.Length > 4 && done.Substring(0, 4) == "err:") {
            string why = done.Substring(4, done.Length - 4);
            MarketplaceInstall.outcome = T("Install failed: ", "安装失败：") + why;
            MarketplaceInstall.step = 0;
            MarketplaceInstall.progress = "";
            return MarketplaceInstall.outcome;
        }
        string line = T("Installed ", "已安装 ") + MarketplaceInstall.packageName
            + T(". Rebuild to resolve it.", "。重新构建即可解析。");
        MarketplaceInstall.outcome = "";
        MarketplaceInstall.step = 0;
        MarketplaceInstall.progress = "";
        return line;
    }
}
