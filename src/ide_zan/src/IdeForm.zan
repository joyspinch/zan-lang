using System;
using System.IO;
using Gui.Markup;
using Gui;
using Gui.Widget;

partial class IdeForm {
    static void OnLoad(Form form) {
        ZanIDE.Attach(form);
    }
}

// 入口（B-ID44）：设计稿窗口的运行期投影——读 --embed 烘入的
// IdeForm.html（开发期散盘同路径），窗口键取自文档 body 属性，内容
// 走 Html.Parse 单跳建树（zan-ide-surface → IdeSurface，由生成的
// IdeDesignedRegistry 注册的工厂构造），OnLoad 后进事件循环。
class IdeEntry {
    static void Main() {
        IdeDesignedRegistry.Install();
        string html = File.ReadAllText("ide/IdeForm.html");
        HtmlDoc doc = Html.Parse(html, "", null);
        Control tree = doc.root;
        int winW = KeyInt(tree, "data-win-w", 1280);
        int winH = KeyInt(tree, "data-win-h", 820);
        string title = Form.WinKey(tree, "data-win-title");
        Form form = Form.Create(title != "" ? title : "ZanIDE", winW, winH);
        App app = form.GetApp();
        string zs = app.NextLoadScope();
        app.ApplyScopedTree(tree, HtmlScope.Styles(doc.css, zs), zs);
        if (tree is Element) { ((Element)tree).Grow(); }
        form.Add(tree);
        if (Form.WinKey(tree, "data-win-center") == "true") { app.CenterWindow(); }
        if (Form.WinKey(tree, "data-win-resizable") == "false") { app.SetResizable(false); }
        if (Form.WinKey(tree, "data-win-chrome") == "false") { app.SetChromeVisible(false); }
        int shadow = KeyInt(tree, "data-win-shadow", 0);
        if (shadow > 0) { app.SetWindowShadow(shadow); }
        int radius = KeyInt(tree, "data-win-shape-radius", 0);
        if (radius > 0) {
            // 全窗圆角矩形的联合规格（生成器同式：类型1 = 圆角矩形）。
            app.SetWindowShape("1,0,0," + Convert.ToString(winW)
                             + "," + Convert.ToString(winH)
                             + "," + Convert.ToString(radius));
        }
        int opacity = KeyInt(tree, "data-win-opacity", 100);
        if (opacity > 0 && opacity < 100) { app.SetWindowOpacity(opacity); }
        IdeForm.OnLoad(form);
        form.Run();
    }

    // 文档键整数（缺失/非法 → def）。
    static int KeyInt(Control tree, string key, int def) {
        string v = Form.WinKey(tree, key);
        if (v == "") { return def; }
        return Convert.ToInt32(v);
    }
}
