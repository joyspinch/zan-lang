using System;
using Gui;
using Gui.Widget;

/// The IDE's standard project entry: `src/IdeForm.zform` designs the main
/// window, zanc projects it into a `partial class IdeForm` (typed fields,
/// __BuildForm, Main) at compile time, and this file hosts the business
/// logic. OnLoad hands the whole shell over to the ZanIDE class, which builds
/// the control tree and drives the per-frame work through Form.FrameHook.
partial class IdeForm {
    /// Runs once after the window is built, before the event loop starts.
    static void OnLoad(Form form) {
        ZanIDE.Attach(form);
    }
}
