using System;
using System.IO;
using System.Json;
using System.Web;
using Gui;
using Gui.Widget;

partial class IdeForm {
    static void OnLoad(Form form) {
        ZanIDE.Attach(form);
    }
}

// 入口（B-ID44）：设计稿窗口的运行期投影——读 --embed 烘入的
// IdeForm.html（开发期散盘同路径），窗口属性取自文档键，内容投影
// 交给 FormBuilder（zan-ide-surface → IdeSurface，由生成的
// IdeDesignedRegistry 注册的工厂构造），OnLoad 后进事件循环。生成器时代的合成 Main
// 由这段手写入口接替。
class IdeEntry {
    static void Main() {
        IdeDesignedRegistry.Install();
        string html = File.ReadAllText("ide/IdeForm.html");
        JsonValue doc = JsonValue.ParseLenient(DesignerHtml.ToJsonDoc(html));
        Form form = Form.Create(doc.Str("winTitle", "ZanIDE"),
                                doc.Int("winW", 1280), doc.Int("winH", 820));
        form.Add(FormBuilder.BuildWith(doc, null));
        if (doc.Bool("winCenter", false)) { form.GetApp().CenterWindow(); }
        if (!doc.Bool("winResizable", true)) { form.GetApp().SetResizable(false); }
        if (!doc.Bool("winChrome", true)) { form.GetApp().SetChromeVisible(false); }
        int shadow = doc.Int("winShadow", 0);
        if (shadow > 0) { form.GetApp().SetWindowShadow(shadow); }
        int radius = doc.Int("winShapeRadius", 0);
        if (radius > 0) {
            // 全窗圆角矩形的联合规格（生成器同式：类型1 = 圆角矩形）。
            form.GetApp().SetWindowShape("1,0,0," + Convert.ToString(doc.Int("winW", 1280))
                                         + "," + Convert.ToString(doc.Int("winH", 820))
                                         + "," + Convert.ToString(radius));
        }
        int opacity = doc.Int("winOpacity", 100);
        if (opacity > 0 && opacity < 100) { form.GetApp().SetWindowOpacity(opacity); }
        IdeForm.OnLoad(form);
        form.Run();
    }
}
