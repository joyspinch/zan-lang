using System;
using Gui;
using Gui.Widget;

// 差异视图单行渲染器：展示旧行号、新行号、Diff 标记（+/-）与代码文本
public class DiffRow {
    public static Control Of(DiffLine line) {
        if (line == null) { return new Label(""); }

        string oldNoStr = line.oldLineNo > 0 ? Convert.ToString(line.oldLineNo) : "    ";
        while (oldNoStr.Length < 4) { oldNoStr = " " + oldNoStr; }

        string newNoStr = line.newLineNo > 0 ? Convert.ToString(line.newLineNo) : "    ";
        while (newNoStr.Length < 4) { newNoStr = " " + newNoStr; }

        string marker = line.Marker();
        string display = oldNoStr + " " + newNoStr + " " + marker + " " + line.text;

        Label lbl = new Label(display);
        lbl.Class = "diff-line monospace " + DiffRow.ClassFor(line.kind);
        return lbl;
    }

    static string ClassFor(DiffKind kind) {
        if (kind == DiffKind.Added) { return "diff-added success"; }
        if (kind == DiffKind.Deleted) { return "diff-deleted error"; }
        return "diff-unchanged secondary";
    }
}
