using System;
using Gui;
using Gui.Widget;

public class StartPage : Control {
    ListView<RecentItem> recents;
    ListView<NewsItem> news;
    ButtonGroup quick;
    public weak IdeDocumentPageOwner owner;

    StartPage() {
        this.InitControl("startPage", 5);
        Class = "startpage";
        name = "ide-start-page";
        StartPageEvents events = new StartPageEvents();
        events.owner = this;
        recents = new ListView<RecentItem>(events.CreateRecent);
        recents.Class = "recent flat";
        recents.name = "start-recents";
        recents.EmptyText(ZanIDE.T("(no recent projects yet)",
        "（还没有最近打开的项目）"));
        recents.OnSelect(events.RecentPicked);
        recents.OnActivate(events.RecentPicked);
        news = new ListView<NewsItem>(NewsRow.Of);
        news.Class = "news flat";
        news.name = "start-news";
        news.OnSelect(events.ArticlePicked);
        news.OnActivate(events.ArticlePicked);
        quick = new ButtonGroup("quick");
        quick.name = "start-quick";
        quick.AddButton(new Button { Text = ZanIDE.T("New Project", "新建项目"), Icon = "plus", Class = "small" });
        quick.AddButton(new Button { Text = ZanIDE.T("New File", "新建文件"), Icon = "file", Class = "small" });
        quick.AddButton(new Button { Text = ZanIDE.T("Open", "打开"), Icon = "file", Class = "small" });
        quick.AddButton(new Button { Text = ZanIDE.T("Open Project", "打开项目"), Icon = "folder", Class = "small" });
        List<string> names = new List<string> { "start-new-project", "start-new-file", "start-open-file", "start-open-project" };
        for (int i = 0; i < quick.SegCount(); i = i + 1) {
            Button action = quick.ButtonAt(i);
            if (action != null) {
                action.name = names[i];
                action.Click.AddS(events.QuickPicked);
            }
        }

        Card recentCard = new Card(ZanIDE.T("Recent projects", "最近项目"));
        recentCard.Class = "recent";
        recentCard.name = "start-recent-card";
        recentCard.Content(recents);
        recentCard.Action(quick);

        Card newsCard = new Card(ZanIDE.T("Articles & news", "资讯与文章"));
        newsCard.Class = "news";
        newsCard.name = "start-news-card";
        newsCard.Content(news);

        this.Add(recentCard);
        this.Add(newsCard);
    }

    override string Kind() { return "StartPage"; }

    override string StyleType() { return "startpage"; }

    void SetRecents(List<RecentItem> items) {
        if (recents.Count() == items.Count) {
            bool same = true;
            for (int i = 0; i < items.Count && same; i = i + 1) {
                if (recents.ItemAt(i).path != items[i].path) { same = false; }
            }
            if (same) { return; }
        }
        recents.Bind(items);
    }

    void SetNews(List<NewsItem> items) {
        if (news.Count() == items.Count) {
            bool same = true;
            for (int i = 0; i < items.Count && same; i = i + 1) {
                if (news.ItemAt(i).title != items[i].title || news.ItemAt(i).link != items[i].link) { same = false; }
            }
            if (same) { return; }
        }
        news.Bind(items);
    }

    string RecentPath(int i) {
        if (!recents.Has(i)) { return ""; }
        return recents.ItemAt(i).path;
    }

    string NewsLink(int i) {
        if (!news.Has(i)) { return ""; }
        return news.ItemAt(i).link;
    }

    void PickRecent() {
        string path = this.RecentPath(recents.SelectedIndex());
        if (path != "") { this.SubmitAction(5, path); }
    }

    void PickArticle() {
        string link = this.NewsLink(news.SelectedIndex());
        if (link != "") { this.SubmitAction(6, link); }
    }

    void PickQuick(Control sender) {
        for (int i = 0; i < quick.SegCount(); i = i + 1) {
            if (sender == quick.ButtonAt(i)) { this.SubmitAction(i + 1, ""); return; }
        }
    }

    void RemoveRecent(RecentRow row, string path) {
        if (row != null && this.ContainsInputControl(row)) { this.SubmitAction(7, path); }
    }

    private void SubmitAction(int action, string path) {
        IdeDocumentPageOwner target = owner;
        if (target != null && this.StyleVisible()) { target.StartPageAction(this, action, path); }
    }
}
