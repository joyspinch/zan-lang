using System;
using Gui;
using Gui.Widget;

/// One step of the AI task plan, as a control of its own: a real Checkbox
/// whose label is the step text. The box, its hit area and the toggle are the
/// control's business -- this row only carries the step it is bound to and
/// keeps the two in sync, which is what lets the chat panel drop its own row
/// rectangles, checkbox drawing and click routing.
class PlanRow : Control {
    AiPlanStep step;
    Checkbox check;
    /// Done state as of the last frame, so a change can be attributed to the
    /// user (UI -> step) or to the assistant editing the plan (step -> UI).
    int shown;

    /// Row template for `new ListView<AiPlanStep>(PlanRow.Of)`.
    static Control Of(AiPlanStep s) { return new PlanRow(s); }

    PlanRow(AiPlanStep s) {
        this.InitControl("planRow", 1);
        Class = "plan-row";
        step = s;
        shown = s.done;
        check = new Checkbox(s.text);
        check.Class = "small plan";
        check.SetChecked(s.done != 0);
        check.dock = 5;
        this.Add(check);
    }

    override string Kind() { return "PlanRow"; }

    override string StyleType() { return "listrow"; }

    override void OnMeasure(App app) {
        prefH = app.theme.heightSmall;
    }

    /// Nothing is drawn here: the row reconciles the checkbox with the step
    /// (either side may have moved) and hands the current text to the control.
    override void OnPaint(App app) {
        int cur = 0;
        if (check.IsChecked()) { cur = 1; }
        if (cur != shown) {
            step.done = cur;
            shown = cur;
            app.RequestRedraw();
        } else if (step.done != shown) {
            shown = step.done;
            check.SetChecked(shown != 0);
        }
        // 「正在做的那一步」要在清单里认得出来：前面加一个箭头、用强调
        // 类，这样一眼能看到活干到哪一条，而不是数勾。
        if (shown == 0 && step.cur != 0) {
            check.label = "> " + step.text;
            check.Class = "small plan doing";
        } else {
            check.label = step.text;
            if (shown != 0) { check.Class = "small plan done"; }
            else { check.Class = "small plan"; }
        }
    }
}
