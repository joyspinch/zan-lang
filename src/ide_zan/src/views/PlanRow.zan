using System;
using Gui;
using Gui.Widget;

public class PlanRow : Control {
    AiPlanStep step;
    Checkbox check;
    int shown;

    static Control Of(AiPlanStep s) { return new PlanRow(s); }

    PlanRow(AiPlanStep s) {
        this.InitControl("planRow");
        Class = "plan-row";
        step = s;
        shown = s.done;
        check = new Checkbox(s.text);
        check.Class = "small plan";
        check.SetChecked(s.done != 0);
        check.Grow();
        this.Add(check);
        this.SyncStep();
    }

    override string StyleType() { return "listrow"; }

    override void OnMeasure(App app) {
        this.SyncStep();
        prefH = app.theme.heightSmall;
    }

    override void Arrange(int x, int y, int w, int h) {
        this.SyncStep();
        base.Arrange(x, y, w, h);
    }

    public override void OnChildEvent(Control child, string eventName) {
        if (child == check && eventName == "Change") {
            int cur = check.IsChecked() ? 1 : 0;
            if (cur != step.done) {
                step.done = cur;
            }
            shown = cur;
            this.SyncStep();
            if (this.App != null) { this.App.RequestRedraw(); }
        }
        base.OnChildEvent(child, eventName);
    }

    void SyncStep() {
        if (step == null || check == null) { return; }
        if (step.done != shown) {
            shown = step.done;
            check.SetChecked(shown != 0);
        }
        // 「正在做的那一步」要在清单里认得出来：前面加一个箭头、用强调
        // 类，这样一眼能看到活干到哪一条，而不是数勾。
        string wantLabel = step.text;
        string wantClass = "small plan";
        if (shown == 0 && step.cur != 0) {
            wantLabel = "> " + step.text;
            wantClass = "small plan doing";
        } else if (shown != 0) {
            wantClass = "small plan done";
        }
        if (check.label != wantLabel) { check.SetLabel(wantLabel); }
        if (check.Class != wantClass) { check.Class = wantClass; }
    }
}
