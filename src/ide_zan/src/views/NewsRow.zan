using System;
using Gui;
using Gui.Widget;

public class NewsRow : Control {
    NewsItem item;

    static Control Of(NewsItem it) { return new NewsRow(it); }

    NewsRow(NewsItem it) {
        this.InitControl("newsRow");
        Class = "news-row";
        this.SetProp("style", "display:flex;flex-direction:row;align-items:center;gap:var(--gap-small)");
        item = it;
        Tag chip = new Tag(it.tag);
        chip.Class = it.kind;
        chip.SetProp("style", "flex-shrink:0");
        this.Add(chip);
        Label title = new Label(it.title);
        title.SetProp("style", "flex:1;min-width:0");
        title.Tip = it.title;
        this.Add(title);
    }

    override string StyleType() { return "listrow"; }

    override void OnMeasure(App app) {
        StyleBox s = this.ResolveStyleAs(app, "listrow", Class, Style.SNormal());
        prefH = s.HeightOr(app.theme.heightLarge);
    }
}
