using System;
using Gui;
using Gui.Widget;

/// Output panel "Errors" tab as a standard ListView over diagnostic records.
/// Each row is a message label plus an optional quick-fix button bound to the
/// record itself, so the panel no longer walks parallel lists or tracks rows
/// by index.
class ErrorList : Control {
    ListView<DiagnosticRecord> list;
    List<DiagnosticRecord> lastRecords;
    string lastSig;
    DiagnosticRecord fixRecord;
    DiagnosticRecord jumpRecord;

    ErrorList() {
        this.InitControl("errorList", 5);
        ErrorList.current = this;
        // lastSig 必须先给空串：SetErrors 第一帧就会算 `sig == lastSig`，
        // 若 lastSig 还是未初始化的 null，字符串比较会在原生层解引用空指针
        // 直接崩溃（错误面板一显示就闪退）。
        this.lastSig = "";
        this.lastRecords = null;
        list = new ListView<DiagnosticRecord>(ErrorList.RowOf);
        list.EmptyText(ZanIDE.T("No errors.", "无错误。"));
        list.OnActivate(ErrorList.OnJump);
        list.dock = 5;
        this.Add(list);
    }

    static Control RowOf(DiagnosticRecord r) {
        Panel row = Panel.Row();
        if (r == null) { return row; }
        string rmsg = r.msg; if (rmsg == null) { rmsg = ""; }
        string rpath = r.path; if (rpath == null) { rpath = ""; }
        string rline = r.line; if (rline == null) { rline = ""; }
        string ns = ZanIDE.SuggestedUsing(rmsg);
        Label lbl = new Label(
            ZanIDE.BaseName(rpath) + ":" + rline + "   " + rmsg);
        lbl.Class = "secondary small";
        lbl.dock = 5;
        row.Add(lbl);
        if (ns != "") {
            Button b = new Button(
                ZanIDE.T("Add using " + ns, "添加 using " + ns));
            b.Class = "primary tiny";
            b.dock = 4;
            b.Click += () => { ErrorList.current.fixRecord = r; };
            row.Add(b);
        }
        return row;
    }

    static ErrorList current;

    static void OnJump() {
        if (ErrorList.current == null) { return; }
        ErrorList.current.jumpRecord = ErrorList.current.list.Selected();
    }

    /// Rebind the list only when the diagnostics actually changed.
    void SetErrors(List<DiagnosticRecord> records) {
        if (records == null) { records = new List<DiagnosticRecord>(); }
        string sig = "";
        for (int i = 0; i < records.Count; i = i + 1) {
            DiagnosticRecord r = records[i];
            if (r == null) { continue; }
            string rp = r.path; if (rp == null) { rp = ""; }
            string rl = r.line; if (rl == null) { rl = ""; }
            string rm = r.msg;  if (rm == null) { rm = ""; }
            sig = sig + rp + ":" + rl + ":" + rm + "|";
        }
        if (sig == lastSig && lastRecords == records) { return; }
        lastSig = sig;
        lastRecords = records;
        list.Bind(records);
        list.Refresh();
    }

    /// The quick-fix record clicked since the last call, or null. Consumes it.
    DiagnosticRecord TakeFix() {
        DiagnosticRecord r = fixRecord;
        fixRecord = null;
        return r;
    }

    /// The jump-to record activated since the last call, or null. Consumes it.
    DiagnosticRecord TakeJump() {
        DiagnosticRecord r = jumpRecord;
        jumpRecord = null;
        return r;
    }

    /// Suggested `using` namespace for a record ("" when none).
    string FixNs(DiagnosticRecord r) {
        if (r == null) { return ""; }
        return ZanIDE.SuggestedUsing(r.msg);
    }
}
