using System;
using Gui;
using Gui.Widget;

/// 小助手面板头部最右边那一格：一个小圆环，显示正在跑的对话占了上下文
/// 预算的多少；悬停（或点一下钉住）打开用量卡片。
///
/// 结构在 `views/CtxRing.zform` 里声明（一个环形 Progress）。弧线、轨道和
/// 「%」都是控件自己的，这里只决定数字和严重程度；卡片走标准覆盖层通道，
/// 因此它压在面板内容之上，位置由 `OverlayPopup.FitX/FitY` 贴着圆环给出。
partial class CtxRing {
    UsageCard card;
    /// 卡片被点住不放（不再只跟着悬停）。
    bool pinned;
    /// 卡片当前要显示的数字。
    List<UsageStat> ctxStats;
    List<UsageStat> sesStats;
    string note;

    void OnInit() {
        pinned = false;
        note = "";
        ctxStats = new List<UsageStat>();
        sesStats = new List<UsageStat>();
        CtxRing.Ring.Ring();
        card = new UsageCard(ZanIDE.T("Context window", "上下文窗口"),
            ZanIDE.T("This session", "本次会话"));
    }

    /// 本帧的数字：`pct` 是已用占预算的百分比，两份统计和那句压缩说明
    /// 由外壳给出（它们是 IDE 的数据，不是控件的）。
    void Sync(int pct, List<UsageStat> ctx, List<UsageStat> ses,
              string noteText) {
        int p = pct;
        if (p > 100) { p = 100; }
        if (p < 0) { p = 0; }
        // 语义色随占用升级：满了就是红的，别让人去读数字才知道。
        int tone = 3;
        if (p >= 75) { tone = 4; }
        if (p >= 100) { tone = 5; }
        CtxRing.Ring.ptype = tone;
        CtxRing.Ring.SetPercent(p);
        ctxStats = ctx;
        sesStats = ses;
        note = noteText;
    }

    /// 悬停就显示卡片，点一下钉住 / 取消钉住。卡片本身在覆盖层阶段画，
    /// 所以面板里没有东西会盖在它上面。
    override void OnPaint(App app) {
        bool over = app.mouseX >= bx && app.mouseX < bx + bw
            && app.mouseY >= by && app.mouseY < by + bh;
        if (over && app.ClickAvailable()) {
            pinned = !pinned;
            app.ClaimClick();
            app.RequestRedraw();
        }
        if (over || pinned) { app.AddOverlay(OverlayPopup.Host(this)); }
    }

    /// 用量卡片：贴在圆环下面，越界自动收进窗口。
    override void OnPaintOverlay(App app) {
        card.Update(ctxStats, sesStats, note);
        int w = app.Scale(330);
        int h = card.Height(app);
        int x = OverlayPopup.FitX(app, bx + bw / 2 - w / 2, w);
        int y = OverlayPopup.FitY(app, by + bh + app.Scale(6), bh, h);
        card.RenderAt(app, x, y, w);
    }
}
