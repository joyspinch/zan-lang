using System;
using Gui;
using Gui.Widget;

// 小助手面板头部最右边那一格：一个小圆环，显示正在跑的对话占了上下文
// 预算的多少；悬停（或点一下钉住）打开用量卡片。
// 结构在 `views/CtxRing.html` 里声明（一个环形 Progress）。弧线、轨道和
// 「%」都是控件自己的，这里只决定数字和严重程度；卡片走标准覆盖层通道，
// 因此它压在面板内容之上，位置由 `OverlayPopup.FitX/FitY` 贴着圆环给出。
partial class CtxRing {
    UsageCard card;
    // 卡片被点住不放（不再只跟着悬停）。
    bool pinned;
    // 卡片当前要显示的数字。
    List<UsageStat> ctxStats;
    List<UsageStat> sesStats;
    string note;
    void OnInit() {
        pinned = false;
        note = "";
        ctxStats = new List<UsageStat>();
        sesStats = new List<UsageStat>();
        this.Ring.Ring();
        card = new UsageCard(ZanIDE.T("Context window", "上下文窗口"),
        ZanIDE.T("This session", "本次会话"));
    }

    // 本帧的数字：`pct` 是已用占预算的百分比，两份统计和那句压缩说明
    // 由外壳给出（它们是 IDE 的数据，不是控件的）。
    void Sync(int pct, List<UsageStat> ctx, List<UsageStat> ses,
    string noteText) {
        int p = pct;
        if (p > 100) { p = 100; }
        if (p < 0) { p = 0; }
        // 语义色随占用升级：满了就是红的，别让人去读数字才知道。
        int tone = 3;
        if (p >= 75) { tone = 4; }
        if (p >= 100) { tone = 5; }
        this.Ring.ptype = tone;
        this.Ring.SetPercent(p);
        ctxStats = ctx;
        sesStats = ses;
        note = noteText;
        card.Update(ctxStats, sesStats, note);
    }

    override void Arrange(int x, int y, int w, int h) {
        base.Arrange(x, y, w, h);
        App host = this.App;
        if (host == null) { return; }
        int cardWidth = host.Scale(330);
        int cardHeight = card.Height(host);
        int cardX = OverlayPopup.FitX(host, bx + bw / 2 - cardWidth / 2, cardWidth);
        int cardY = OverlayPopup.FitY(host, by + bh + host.Scale(6), bh, cardHeight);
        card.PrepareAt(host, cardX, cardY, cardWidth, cardHeight);
    }

    override void OnClick(RoutedEventArgs e) {
        pinned = !pinned;
        e.Handle();
        this.Invalidate();
    }

    // 悬停与点击由真实控件树派发，绘制只投影当前状态。
    override void OnPaint(App app) {
        if (bw > 0 && bh > 0 && (this.isHovered || pinned)) {
            app.AddOverlay(OverlayPopup.Host(this));
        }
    }

    // 用量卡片：贴在圆环下面，越界自动收进窗口。
    override void OnPaintOverlay(App app) {
        card.RenderPrepared(app);
    }
}
