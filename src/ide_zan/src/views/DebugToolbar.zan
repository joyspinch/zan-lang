using System;
using Gui;
using Gui.Widget;

/// 一个调试工具条按钮的数据描述（图标、双语文案、样式、动作 id）。
/// 工具条自己用它建出 Button 控件，调用方只碰数据。
class DbgToolbarBtn {
    string icon;
    string label;
    string cls;
    int action;

    static DbgToolbarBtn Of(string icon, string label, string cls, int action) {
        DbgToolbarBtn b = new DbgToolbarBtn();
        b.icon = icon;
        b.label = label;
        b.cls = cls;
        b.action = action;
        return b;
    }
}

/// 调试步进工具条：继续 / 单步跳过 / 单步进入 / 停止，右端显示当前执行行。
///
/// 结构在 `views/DebugToolbar.zform` 里声明（一条 ToolStrip + 行号标签）。
/// 按钮集合是数据（`DbgToolbarBtn`），所以调试器可以随状态换整套按钮，
/// 这里只在集合真的变了时重建工具条项。
partial class DebugToolbar {
    static DebugToolbar current;
    /// 上一次建条时的按钮签名：图标/文案/样式没变就不重建。
    static string btnSig;
    /// 本帧被点中的动作 id，外壳每帧取走。
    static int action;

    void OnInit() {
        DebugToolbar.current = this;
        DebugToolbar.btnSig = "";
        DebugToolbar.action = 0 - 1;
    }

    /// 按条上顺序给出步进按钮的数据。
    static List<DbgToolbarBtn> Buttons() {
        List<DbgToolbarBtn> btns = new List<DbgToolbarBtn>();
        btns.Add(DbgToolbarBtn.Of("play", ZanIDE.T("Continue", "继续"),
            "success small", 0));
        btns.Add(DbgToolbarBtn.Of("arrow-right",
            ZanIDE.T("Step Over", "单步跳过"), "info small", 1));
        btns.Add(DbgToolbarBtn.Of("arrow-down",
            ZanIDE.T("Step Into", "单步进入"), "info small", 2));
        btns.Add(DbgToolbarBtn.Of("stop", ZanIDE.T("Stop", "停止"),
            "error small", 3));
        return btns;
    }

    /// 画工具条，返回用户点的动作 id（-1 表示没点）。
    int Render(App app, Rect area, int execLine, List<DbgToolbarBtn> btns) {
        this.SyncButtons(btns);
        this.LineLbl.Text = ZanIDE.T("Line: ", "行：")
            + Convert.ToString(execLine + 1);
        this.RenderInside(app, area);
        int a = DebugToolbar.action;
        DebugToolbar.action = 0 - 1;
        return a;
    }

    /// 按钮是数据；只有图标/双语文案/样式或顺序变了才重建项。
    void SyncButtons(List<DbgToolbarBtn> btns) {
        string sig = "";
        for (int i = 0; i < btns.Count; i = i + 1) {
            DbgToolbarBtn bd = btns[i];
            sig = sig + bd.icon + ":" + bd.label + ":" + bd.cls + "|";
        }
        if (sig == DebugToolbar.btnSig) { return; }
        this.Strip.Clear();
        for (int i = 0; i < btns.Count; i = i + 1) {
            DbgToolbarBtn bd = btns[i];
            int act = bd.action;
            int idx = this.Strip.Add(bd.label, bd.icon);
            Button b = this.Strip.ItemAt(idx);
            if (b == null) { continue; }
            b.Class = bd.cls;
            b.Click += () => { DebugToolbar.action = act; };
        }
        DebugToolbar.btnSig = sig;
    }
}
