using System;
using Gui;
using Gui.Widget;

// 核心契约与语义定义。
class RecentItem {
    string path;

    static RecentItem Create(string path) {
        RecentItem it = new RecentItem();
        it.path = path;
        return it;
    }
}

// 核心契约与语义定义。
class RecentRow : Control {
    RecentItem item;
    // 核心契约与语义定义。
    static string removed;

    // 核心契约与语义定义。
    static Control Of(RecentItem it) { return new RecentRow(it); }

    static string TakeRemoved() {
        string p = removed;
        removed = "";
        if (p == null) { return ""; }
        return p;
    }

    RecentRow(RecentItem it) {
        this.InitControl("recentRow", 1);
        Class = "recent-row";
        item = it;
        string label = Path.GetFileName(it.path);
        if (label == "") { label = it.path; }
        string initial = "";
        if (label.Length > 0) { initial = label.Substring(0, 1); }
        Avatar av = new Avatar(initial);
        av.dock = 3;
        this.Add(av);
        Panel text = Panel.Column();
        text.dock = 5;
        Label name = new Label(label);
        text.With(name);
        Label sub = new Label(it.path);
        sub.Class = "secondary small";
        text.With(sub);
        this.Add(text);

        Button close = new Button("");
        close.Class = "ghost small";
        close.Icon = "close";
        close.Tip = ZanIDE.T("Remove", "移除");
        close.dock = 4;
        close.Click += () => { removed = it.path; };
        this.Add(close);
    }

    override string Kind() { return "RecentRow"; }

    override string StyleType() { return "listrow"; }

    override void OnMeasure(App app) {
        StyleBox s = this.ResolveStyleAs(app, "listrow", Class, Style.SNormal());
        prefH = s.HeightOr(app.theme.heightLarge
                           + Canvas.FontHeight(app.theme.fontSizeSmall));
    }
}
