using System;
using System.IO;
using System.Collections.Generic;
using Gui;
using Gui.Widget;

// 代码差异审查视图（@diff: 虚拟标签页）
// 展示待审阅文件的路径、新增/删除统计、差异行清单，并提供接受/丢弃操作按钮
public class DiffView : Control {
    public weak IdeDocumentPageOwner owner;
    StagedFile preparedFile;
    List<DiffLine> preparedDiffs;
    bool preparedAccepted;
    int preparedAdds;
    int preparedDels;
    bool prepared;
    int actionRevision;
    DiffViewEvents events;
    string targetPath;
    Label titleLabel;
    Label statsLabel;
    Button acceptBtn;
    Button rejectBtn;
    ListView<DiffLine> list;

    static string T(string en, string zh) {
        return Lang.Tr(en, zh);
    }

    public DiffView() {
        this.InitControl("diffView");
        this.Class = "diffview-host";
        name = "ide-diff-page";
        this.targetPath = "";
        events = new DiffViewEvents();
        events.owner = this;

        // 顶部工具栏
        Panel toolbar = Panel.Row();
        toolbar.Class = "diff-toolbar bar align-center";

        titleLabel = new Label("Diff: (no file)");
        titleLabel.Class = "diff-title bold";

        statsLabel = new Label("");
        statsLabel.Class = "diff-stats secondary";

        Panel spacer = new Panel("spacer");
        spacer.Class = "grow";

        acceptBtn = new Button(DiffView.T("Accept (落盘保存)", "接受此修改"));
        acceptBtn.Class = "primary small";
        acceptBtn.name = "diff-accept";
        acceptBtn.Click.AddS(events.Accept);

        rejectBtn = new Button(DiffView.T("Discard (丢弃改动)", "放弃此修改"));
        rejectBtn.Class = "small";
        rejectBtn.name = "diff-reject";
        rejectBtn.Click.AddS(events.Reject);

        toolbar.Add(titleLabel);
        toolbar.Add(statsLabel);
        toolbar.Add(spacer);
        toolbar.Add(acceptBtn);
        toolbar.Add(rejectBtn);

        // 差异行列表
        list = new ListView<DiffLine>(DiffRow.Of);
        list.Class = "grow monospace";
        list.EmptyText(DiffView.T("No pending staged diff for this file.", "该文件暂无待审阅的虚拟差异。"));

        this.Add(toolbar);
        this.Add(list);
    }

    public void BindPath(string path) {
        if (path == null) { path = ""; }
        string norm = AiStaging.NormalizePath(path);
        if (norm.StartsWith("@diff:")) {
            norm = norm.Substring(6, norm.Length - 6);
        }
        StagedFile sf = AiStaging.Get(norm);
        if (prepared && norm == targetPath && sf == preparedFile
        && (sf == null || (sf.diffs == preparedDiffs && sf.accepted == preparedAccepted
        && sf.adds == preparedAdds && sf.dels == preparedDels))) { return; }
        // Already queued clicks retain the old relay and cannot act on new content.
        acceptBtn.Click.RemoveS(events.Accept);
        rejectBtn.Click.RemoveS(events.Reject);
        actionRevision = actionRevision + 1;
        events = new DiffViewEvents();
        events.owner = this;
        events.revision = actionRevision;
        acceptBtn.Click.AddS(events.Accept);
        rejectBtn.Click.AddS(events.Reject);
        targetPath = norm;
        prepared = true;
        preparedFile = sf;
        preparedDiffs = sf != null ? sf.diffs : null;
        preparedAccepted = sf != null && sf.accepted;
        preparedAdds = sf != null ? sf.adds : 0;
        preparedDels = sf != null ? sf.dels : 0;
        if (sf != null) {
            string title = "Diff: " + sf.path;
            if (sf.accepted) {
                title = title + " [" + DiffView.T("Accepted", "已接受") + "]";
            } else {
                title = title + " [" + DiffView.T("Pending Review", "待审阅") + "]";
            }
            titleLabel.Text = title;
            statsLabel.Text = "  +" + Convert.ToString(sf.adds) + " -" + Convert.ToString(sf.dels);
            list.Bind(sf.diffs);
            list.Refresh();
        } else {
            titleLabel.Text = "Diff: " + norm;
            statsLabel.Text = "";
            list.Bind(new List<DiffLine>());
            list.Refresh();
        }
    }

    void SubmitAction(Control sender, bool accept, int revision) {
        IdeDocumentPageOwner target = owner;
        if (target == null || revision != actionRevision || !this.StyleVisible()
        || sender != (accept ? acceptBtn : rejectBtn)) { return; }
        target.DiffViewAction(this, accept, targetPath);
    }

    public string CurrentPath() {
        return this.targetPath;
    }
}
