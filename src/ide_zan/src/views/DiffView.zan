using System;
using System.IO;
using System.Collections.Generic;
using Gui;
using Gui.Widget;

// 代码差异审查视图（@diff: 虚拟标签页）
// 展示待审阅文件的路径、新增/删除统计、差异行清单，并提供接受/丢弃操作按钮
public class DiffView : Control {
    static DiffView current;
    public static DiffView Current() { return current; }

    string targetPath;
    Label titleLabel;
    Label statsLabel;
    Button acceptBtn;
    Button rejectBtn;
    ListView<DiffLine> list;
    int action; // 1 = accept, 2 = reject

    static string T(string en, string zh) {
        return Lang.Tr(en, zh);
    }

    public DiffView() {
        this.InitControl("diffView", 5);
        this.Class = "diffview-host";
        DiffView.current = this;
        this.targetPath = "";
        this.action = 0;

        // 顶部工具栏
        Panel toolbar = Panel.Row();
        toolbar.Class = "diff-toolbar bar align-center";

        titleLabel = new Label("Diff: (no file)");
        titleLabel.Class = "diff-title bold";

        statsLabel = new Label("");
        statsLabel.Class = "diff-stats secondary";

        Panel spacer = new Panel("spacer");
        spacer.Class = "grow";

        acceptBtn = new Button(DiffView.T("Accept (落盘保存)", "接受此修改"));
        acceptBtn.Class = "primary small";
        acceptBtn.Click += () => {
            if (DiffView.current != null) { DiffView.current.action = 1; }
        };

        rejectBtn = new Button(DiffView.T("Discard (丢弃改动)", "放弃此修改"));
        rejectBtn.Class = "small";
        rejectBtn.Click += () => {
            if (DiffView.current != null) { DiffView.current.action = 2; }
        };

        toolbar.Add(titleLabel);
        toolbar.Add(statsLabel);
        toolbar.Add(spacer);
        toolbar.Add(acceptBtn);
        toolbar.Add(rejectBtn);

        // 差异行列表
        list = new ListView<DiffLine>(DiffRow.Of);
        list.Class = "grow monospace";
        list.EmptyText(DiffView.T("No pending staged diff for this file.", "该文件暂无待审阅的虚拟差异。"));

        this.Add(toolbar);
        this.Add(list);
    }

    public void BindPath(string path) {
        if (path == null) { path = ""; }
        string norm = AiStaging.NormalizePath(path);
        if (norm.StartsWith("@diff:")) {
            norm = norm.Substring(6, norm.Length - 6);
        }
        if (norm == this.targetPath && list.data != null) { return; }
        this.targetPath = norm;
        this.action = 0;

        StagedFile sf = AiStaging.Get(norm);
        if (sf != null) {
            string title = "Diff: " + sf.path;
            if (sf.accepted) {
                title = title + " [" + DiffView.T("Accepted", "已接受") + "]";
            } else {
                title = title + " [" + DiffView.T("Pending Review", "待审阅") + "]";
            }
            titleLabel.Text = title;
            statsLabel.Text = "  +" + Convert.ToString(sf.adds) + " -" + Convert.ToString(sf.dels);
            list.Bind(sf.diffs);
            list.Refresh();
        } else {
            titleLabel.Text = "Diff: " + norm;
            statsLabel.Text = "";
            list.Bind(new List<DiffLine>());
            list.Refresh();
        }
    }

    public int TakeAction() {
        int a = this.action;
        this.action = 0;
        return a;
    }

    public string CurrentPath() {
        return this.targetPath;
    }
}
