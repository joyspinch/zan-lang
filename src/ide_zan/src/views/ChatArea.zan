using System;
using System.Json;
using Gui;
using Gui.Widget;
using Gui.Component;

// ---- chat transcript persistence entities --------------------------------
// ChatPack/ChatUnpack round-trip through Json.Serialize/Deserialize. The
// short keys (r/t/z, m/plan) are kept so on-disk session archives written by
// older builds stay readable; missing "z" (reason) or "d" (done) default to
// "" / false exactly as the old reader did.

class ChatMsgDoc {
    string r;
    string t;
    string z;
    // Team envelope. Added as optional short keys so a session archive written
    // by a single-assistant build still deserializes (they come back "" / 0)
    // and an archive written here still opens in an older build, which ignores
    // keys it does not know.
    string a;
    string to;
    string k;
    string ti;
    int pg;
}

class ChatPlanStepDoc {
    string t;
    bool d;
}

class ChatTaskDoc {
    string id;
    string ti;
    string o;
    int st;
    int pg;
}

class ChatPackDoc {
    List<ChatMsgDoc> m;
    List<ChatPlanStepDoc> plan;
    // Team mode, the pipeline's parked position and the board. Persisted so a
    // restart mid-pipeline resumes with the member that was working (or the one
    // waiting on an answer) instead of quietly restarting from the top and
    // losing the task. Absent in a single-assistant archive -> 0 / "" / null,
    // which restores as "team off", exactly the old behaviour.
    int tm;
    string ts;
    List<ChatTaskDoc> tk;
}

/// Mutable holder for the team half of a session archive, so ChatUnpack can
/// hand back more than the transcript without eight call sites growing three
/// out-parameters each.
class ChatTeamSave {
    int on;
    AiTeamState st;
    List<AiTask> tasks;

    static ChatTeamSave Create() {
        ChatTeamSave s = new ChatTeamSave();
        s.on = 0;
        s.st = AiTeamState.Create();
        s.tasks = new List<AiTask>();
        return s;
    }
}

class ChatSessionsDoc {
    int cur;
    List<string> s;
}

/// The AI chat transcript view, extracted from the shell: transcript
/// serialization (ChatPack/ChatUnpack), the wrapped markdown-aware line
/// cache (ChatBuildLines) and the bottom-anchored transcript renderer.
class ChatArea {
    /// The display-line row type lives in the stdlib as `Gui.Widget.TextRun`
    /// (declared in StyledText.zan), so the chat transcript's line cache and
    /// the StyledText control that paints it share one entity without the IDE
    /// having to re-wrap rows per frame.

    /// Greedily wraps `s` to `maxW` pixels, appending the pieces to `outLines`.
    static void WrapInto(string s, int maxW, int fontSize, List<string> outLines) {
        List<string> hard = CodeEditor.SplitLines(s);
        if (hard.Count == 0) { hard.Add(""); }
        for (int li = 0; li < hard.Count; li = li + 1) {
            string line = hard[li];
            if (line == "") { outLines.Add(""); }
            while (line != "") {
                if (Canvas.MeasureText(line, fontSize) <= maxW) {
                    outLines.Add(line);
                    line = "";
                } else {
                    // Binary-search the longest prefix that fits.
                    int lo = 1;
                    int hi = line.Length;
                    while (lo < hi) {
                        int mid = (lo + hi + 1) / 2;
                        if (Canvas.MeasureText(line.Substring(0, mid), fontSize) <= maxW) { lo = mid; }
                        else { hi = mid - 1; }
                    }
                    // Never wrap inside a multi-byte character; keep at least
                    // one whole character so the loop progresses.
                    lo = Text.ClampCharStart(line, lo);
                    if (lo <= 0) { lo = Text.NextCharEnd(line, 0); }
                    outLines.Add(line.Substring(0, lo));
                    line = line.Substring(lo, line.Length - lo);
                }
            }
        }
    }

    /// Wraps `s` to `maxW` pixels and appends the pieces to `cache` as styled
    /// display rows (`color`/`kind`). At least one row is always appended (an
    /// empty piece becomes one empty row), matching the old "add a blank line
    /// when nothing was emitted" idiom without the index bookkeeping.
    static void WrapRows(string s, int maxW, int fontSize,
            List<TextRun> cache, int color, int kind) {
        List<string> wrapped = new List<string>();
        ChatArea.WrapInto(s, maxW, fontSize, wrapped);
        for (int wi = 0; wi < wrapped.Count; wi = wi + 1) {
            cache.Add(TextRun.Create(wrapped[wi], color, kind));
        }
    }

    /// Sets `owner` on every row the cache gained since `start`: the speaker
    /// of the message those rows belong to, used to tint whole blocks.
    static void OwnRows(List<TextRun> cache, int start, int owner) {
        for (int oi = start; oi < cache.Count; oi = oi + 1) {
            cache[oi].owner = owner;
        }
    }

    /// The selected text of `cache`, newline-joined ("" when nothing is
    /// selected); mirrors LogView.SelectionText for the TextRun entity.
    static string SelectionText(List<TextRun> cache, LogState st) {
        if (!st.HasSelection()) { return ""; }
        int r0 = st.selR0; int c0 = st.selC0;
        int r1 = st.selR1; int c1 = st.selC1;
        if (r0 > r1 || (r0 == r1 && c0 > c1)) {
            int tr = r0; r0 = r1; r1 = tr;
            int tc = c0; c0 = c1; c1 = tc;
        }
        string outp = "";
        for (int r = r0; r <= r1 && r < cache.Count; r = r + 1) {
            string ln = cache[r].text;
            int s = 0;
            int e = ln.Length;
            if (r == r0) { s = c0; }
            if (r == r1) { e = c1; }
            if (s < 0) { s = 0; }
            if (e > ln.Length) { e = ln.Length; }
            if (s > e) { s = e; }
            outp = outp + ln.Substring(s, e - s);
            if (r < r1) { outp = outp + "\n"; }
        }
        return outp;
    }

    /// Serializes a chat transcript for the session switcher (JSON, so any
    /// message content round-trips safely). The per-message reasoning ("z")
    /// rides along so switching sessions keeps each answer's thinking.
    static string ChatPack(List<ChatMessage> msgs, List<AiPlanStep> plan) {
        return ChatArea.ChatPack(msgs, plan, ChatTeamSave.Create());
    }

    static string ChatPack(List<ChatMessage> msgs, List<AiPlanStep> plan,
            ChatTeamSave team) {
        ChatPackDoc o = new ChatPackDoc();
        o.tm = team.on;
        o.ts = AiTeam.PackState(team.st);
        o.tk = new List<ChatTaskDoc>();
        for (int q = 0; q < team.tasks.Count; q = q + 1) {
            ChatTaskDoc td = new ChatTaskDoc();
            td.id = team.tasks[q].id;
            td.ti = team.tasks[q].title;
            td.o = team.tasks[q].owner;
            td.st = team.tasks[q].state;
            td.pg = team.tasks[q].progress;
            o.tk.Add(td);
        }
        o.m = new List<ChatMsgDoc>();
        for (int i = 0; i < msgs.Count; i = i + 1) {
            ChatMsgDoc m = new ChatMsgDoc();
            m.r = msgs[i].role;
            m.t = msgs[i].text;
            m.z = msgs[i].reason;
            m.a = msgs[i].agent;
            m.to = msgs[i].to;
            m.k = msgs[i].kind;
            m.ti = msgs[i].taskId;
            m.pg = msgs[i].progress;
            o.m.Add(m);
        }
        o.plan = new List<ChatPlanStepDoc>();
        for (int p = 0; p < plan.Count; p = p + 1) {
            ChatPlanStepDoc s = new ChatPlanStepDoc();
            s.t = plan[p].text;
            s.d = (plan[p].done != 0);
            o.plan.Add(s);
        }
        return Json.Serialize<ChatPackDoc>(o);
    }

    static void ChatUnpack(string packed, List<ChatMessage> msgs,
            List<AiPlanStep> plan) {
        ChatArea.ChatUnpack(packed, msgs, plan, ChatTeamSave.Create());
    }

    static void ChatUnpack(string packed, List<ChatMessage> msgs,
            List<AiPlanStep> plan, ChatTeamSave team) {
        if (packed == "") { return; }
        ChatPackDoc v = Json.Deserialize<ChatPackDoc>(packed);
        if (v == null || v.m == null) { return; }
        team.on = v.tm;
        team.st = AiTeam.UnpackState(v.ts);
        team.tasks = new List<AiTask>();
        if (v.tk != null) {
            for (int q = 0; q < v.tk.Count; q = q + 1) {
                AiTask tk = AiTask.Create(v.tk[q].id, v.tk[q].ti, v.tk[q].o);
                tk.state = v.tk[q].st;
                tk.progress = v.tk[q].pg;
                team.tasks.Add(tk);
            }
        }
        for (int i = 0; i < v.m.Count; i = i + 1) {
            ChatMessage m = ChatMessage.CreateWithReason(v.m[i].r, v.m[i].t,
                v.m[i].z);
            m.agent = v.m[i].a;
            m.to = v.m[i].to;
            m.kind = v.m[i].k;
            m.taskId = v.m[i].ti;
            m.progress = v.m[i].pg;
            msgs.Add(m);
        }
        if (v.plan != null) {
            for (int j = 0; j < v.plan.Count; j = j + 1) {
                int d = 0;
                if (v.plan[j].d) { d = 1; }
                plan.Add(AiPlanStep.Create(v.plan[j].t, d));
            }
        }
    }

    /// Serializes the whole session list (each session is a ChatPack JSON
    /// string) plus the active index, for disk persistence. Sessions are
    /// JSON-escaped so their own quoting survives nesting.
    static string ChatPackSessions(List<AiSession> sessions, int cur) {
        ChatSessionsDoc o = new ChatSessionsDoc();
        o.cur = cur;
        o.s = new List<string>();
        for (int i = 0; i < sessions.Count; i = i + 1) {
            o.s.Add(sessions[i].pack);
        }
        return Json.Serialize<ChatSessionsDoc>(o);
    }

    /// Restores a session list from ChatPackSessions output; returns the
    /// active index (clamped to the restored list).
    static int ChatUnpackSessions(string packed, List<AiSession> sessions) {
        sessions.Clear();
        if (packed == "") { return 0; }
        ChatSessionsDoc v = Json.Deserialize<ChatSessionsDoc>(packed);
        if (v == null || v.s == null) { return 0; }
        for (int i = 0; i < v.s.Count; i = i + 1) {
            sessions.Add(AiSession.Create(v.s[i], 0));
        }
        int c = v.cur;
        if (c < 0 || c >= sessions.Count) { c = 0; }
        return c;
    }

    /// First line of `s`, capped to a title length (for the session list).
    static string TitleLine(string s) {
        List<string> hard = CodeEditor.SplitLines(s);
        string first = "";
        if (hard.Count > 0) { first = hard[0]; }
        if (first.Length > 60) { first = Text.Left(first, Text.ClampCharStart(first, 60)); }
        return first;
    }

    /// Title of a live transcript: the first thing the user asked, else "".
    static string FirstUserOf(List<ChatMessage> msgs) {
        for (int i = 0; i < msgs.Count; i = i + 1) {
            if (msgs[i].role == "user") { return ChatArea.TitleLine(msgs[i].text); }
        }
        return "";
    }

    /// Title of a packed (serialized) transcript, without unpacking it whole.
    static string ChatTitle(string packed) {
        if (packed == "") { return ""; }
        ChatPackDoc v = Json.Deserialize<ChatPackDoc>(packed);
        if (v == null || v.m == null) { return ""; }
        for (int i = 0; i < v.m.Count; i = i + 1) {
            if (v.m[i].r == "user") { return ChatArea.TitleLine(v.m[i].t); }
        }
        return "";
    }

    /// Builds the wrapped, markdown-aware line cache for the chat transcript.
    /// kinds: 0 = normal text, 1 = code (drawn on a code background),
    /// 2 = heading, 3 = message header row.
    static bool HasInt(List<int> xs, int v) {
        for (int i = 0; i < xs.Count; i = i + 1) {
            if (xs[i] == v) { return true; }
        }
        return false;
    }

    /// Code lines of a fenced block shown before it folds behind a
    /// "show N more" row.
    static int CodeFoldLines() { return 14; }

    /// True when `src` holds a fenced block long enough to be folded.
    static bool HasLongCode(List<string> src) {
        int i = 0;
        while (i < src.Count) {
            string ln = src[i];
            if (ln.Length >= 3 && ln.Substring(0, 3) == "```") {
                int endAt = i + 1;
                for (endAt = i + 1; endAt < src.Count; endAt = endAt + 1) {
                    string el = src[endAt];
                    if (el.Length >= 3 && el.Substring(0, 3) == "```") { break; }
                }
                if (endAt - i - 1 > ChatArea.CodeFoldLines() + 2) { return true; }
                i = endAt + 1;
                continue;
            }
            i = i + 1;
        }
        return false;
    }

    static void ChatBuildLines(App app, List<ChatMessage> msgs,
            int textW, bool thinkOpen, List<int> toolOpen,
            List<TextRun> cache) {
        ChatArea.ChatBuildRange(app, msgs, 0, msgs.Count,
            textW, thinkOpen, toolOpen, cache);
    }

    /// Speaker code of a transcript role, used to tint whole message blocks:
    /// 0 = you, 1 = Xiao Zan, 2 = tool, 3 = error.
    static int RoleCode(string role) {
        if (role == "user") { return 0; }
        if (role == "tool") { return 2; }
        if (role == "error") { return 3; }
        return 1;
    }

    /// Wraps only the turns in [from, to) and APPENDS them to the cache lists.
    /// Splitting the build this way lets the panel keep the wrapped lines of
    /// the settled turns and re-wrap just the turn that is streaming, instead
    /// of re-wrapping a whole long conversation on every frame.
    /// Wraps only the turns in [from, to) and APPENDS them to the cache.
    /// Splitting the build this way lets the panel keep the wrapped lines of
    /// the settled turns and re-wrap just the turn that is streaming, instead
    /// of re-wrapping a whole long conversation on every frame.
    static void ChatBuildRange(App app, List<ChatMessage> msgs,
            int from, int to, int textW, bool thinkOpen,
            List<int> toolOpen, List<TextRun> cache) {
        Theme t = app.theme;
        List<int> togPos = new List<int>();
        List<int> togMsg = new List<int>();
        int i = from;
        if (i < 0) { i = 0; }
        int stop = to;
        if (stop > msgs.Count) { stop = msgs.Count; }
        while (i < stop) {
            string head = ZanIDE.T("Xiao Zan", "小赞");
            int headCol = t.success;
            int bodyCol = t.textPrimary;
            string headCls = "success";
            if (msgs[i].role == "user") {
                head = ZanIDE.T("You", "我");
                headCol = t.primary;
                headCls = "primary";
            } else if (msgs[i].role == "error") {
                head = ZanIDE.T("Error", "错误");
                headCol = t.error;
                bodyCol = t.error;
                headCls = "danger";
            } else if (msgs[i].role == "tool") {
                head = ZanIDE.T("Tool", "工具");
                headCol = t.textTertiary;
                bodyCol = t.textTertiary;
                headCls = "";
            }
            // In a team chat the speaker is a named member, not "Xiao Zan", and
            // the beat it carried is what the reader actually wants at a glance:
            // who is working and how far along. The detail stays foldable below.
            string headStatus = "";
            int headPct = 0 - 1;
            AiRole headRole = AiTeam.RoleOf(msgs[i].agent);
            if (msgs[i].agent != "" && headRole != null) {
                head = AiTeam.DisplayName(msgs[i].agent);
                headCol = headRole.tint;
                headCls = AiTeam.RoleTagClass(msgs[i].agent);
                if (msgs[i].kind != "") {
                    headStatus = AiTeam.KindLabel(msgs[i].kind);
                }
                if (msgs[i].progress > 0) { headPct = msgs[i].progress; }
            }
            // A tool call/result is collapsed to ONE clickable summary line
            // (its first line, e.g. "list_dir src/"); clicking expands the full
            // result below it. This keeps a long dump from burying the answer
            // while staying inspectable -- like a mainstream AI coding tool.
            if (msgs[i].role == "tool") {
                int msgStart = cache.Count;
                List<string> tl = CodeEditor.SplitLines(msgs[i].text);
                string summary = "";
                if (tl.Count > 0) { summary = tl[0]; }
                bool open = ChatArea.HasInt(toolOpen, i);
                bool expandable = tl.Count > 1;
                string prefix = "  ";
                if (expandable) {
                    if (open) { prefix = "▼ "; } else { prefix = "▶ "; }
                }
                List<string> tmp = new List<string>();
                ChatArea.WrapInto(prefix + head + ": " + summary, textW,
                    t.fontSizeSmall, tmp);
                string sline = prefix + head;
                if (tmp.Count > 0) {
                    sline = tmp[0];
                    if (tmp.Count > 1) { sline = sline + " …"; }
                }
                if (expandable) { togPos.Add(cache.Count); togMsg.Add(i); }
                if (expandable) {
                    cache.Add(TextRun.Create(sline, headCol, 5));
                } else {
                    cache.Add(TextRun.Create(sline, headCol, 3));
                }
                if (open) {
                    for (int k = 1; k < tl.Count; k = k + 1) {
                        ChatArea.WrapRows(tl[k], textW, t.fontSizeSmall,
                            cache, bodyCol, 0);
                    }
                }
                ChatArea.OwnRows(cache, msgStart, 2);
                TextRun tgap = TextRun.Create("", t.textTertiary, 6);
                tgap.owner = 2;
                cache.Add(tgap);
                i = i + 1;
                continue;
            }
            int msgStart = cache.Count;
            TextRun hln = TextRun.Create(head, headCol, 3);
            hln.ava = StyledText.Initial(head);
            hln.tagCls = headCls;
            hln.status = headStatus;
            hln.pct = headPct;
            cache.Add(hln);
            // F: the model's reasoning is shown as its own dim "Thinking"
            // section above the answer, kept separate from the answer text (and
            // out of the transcript sent back to the model).
            if (msgs[i].role == "assistant" && msgs[i].reason != "") {
                // Collapsed by default: only a clickable one-line toggle (kind 4)
                // shows, so the thinking never buries the answer. Clicking it
                // (handled in RenderChatArea) expands the full reasoning.
                if (thinkOpen) {
                    cache.Add(TextRun.Create(ZanIDE.T("Thinking (click to hide)",
                        "思考过程（点击收起）"), t.textTertiary, 4));
                } else {
                    cache.Add(TextRun.Create(ZanIDE.T("Thinking (click to show)",
                        "思考过程（点击展开）"), t.textTertiary, 4));
                }
                if (thinkOpen) {
                    List<string> rsrc = CodeEditor.SplitLines(msgs[i].reason);
                    for (int rk = 0; rk < rsrc.Count; rk = rk + 1) {
                        ChatArea.WrapRows(ChatArea.MdStrip(rsrc[rk]), textW,
                            t.fontSizeSmall, cache, t.textTertiary, 0);
                    }
                }
            }
            // Markdown-lite: fenced code blocks get a code background and
            // color; headings/bullets/inline `code`/**bold** markers are
            // simplified for readable plain-canvas rendering.
            List<string> src = CodeEditor.SplitLines(msgs[i].text);
            bool inCode = false;
            // A long code block (a whole file the model printed, or the half
            // of one a stopped answer left behind) is folded to its first
            // lines plus a clickable "show N more" row -- like a tool result --
            // instead of burying the rest of the transcript. Expanding it uses
            // the same per-message toggle list as tool results.
            bool codeOpen = ChatArea.HasInt(toolOpen, i);
            if (codeOpen && ChatArea.HasLongCode(src)) {
                togPos.Add(cache.Count);
                togMsg.Add(i);
                cache.Add(TextRun.Create("▼ " + ZanIDE.T("collapse code", "收起代码"),
                    t.textTertiary, 5));
            }
            int li = 0;
            while (li < src.Count) {
                string ln = src[li];
                bool fence = ln.Length >= 3 && ln.Substring(0, 3) == "```";
                if (fence && !inCode && !codeOpen) {
                    // Opening fence: measure the block before emitting it.
                    int endAt = li + 1;
                    for (endAt = li + 1; endAt < src.Count; endAt = endAt + 1) {
                        string el = src[endAt];
                        if (el.Length >= 3 && el.Substring(0, 3) == "```") { break; }
                    }
                    int blockLen = endAt - li - 1;
                    if (blockLen > ChatArea.CodeFoldLines() + 2) {
                        int keep = ChatArea.CodeFoldLines();
                        for (int ck = li + 1; ck < li + 1 + keep; ck = ck + 1) {
                            ChatArea.WrapRows(src[ck], textW - app.Scale(8),
                                t.fontSizeSmall, cache, t.info, 1);
                        }
                        togPos.Add(cache.Count);
                        togMsg.Add(i);
                        cache.Add(TextRun.Create("▶ " + ZanIDE.T("show ", "展开剩余 ")
                            + Convert.ToString(blockLen - keep)
                            + ZanIDE.T(" more code lines", " 行代码"),
                            t.textTertiary, 5));
                        li = endAt + 1;
                        continue;
                    }
                }
                if (fence) {
                    inCode = !inCode;
                } else if (inCode) {
                    ChatArea.WrapRows(ln, textW - app.Scale(8), t.fontSizeSmall,
                        cache, t.info, 1);
                } else {
                    string shown = ChatArea.MdStrip(ln);
                    int kind = 0;
                    int col = bodyCol;
                    if (ln.Length >= 2 && ln.Substring(0, 1) == "#") {
                        kind = 2;
                        col = t.textPrimary;
                    }
                    ChatArea.WrapRows(shown, textW, t.fontSizeSmall,
                        cache, col, kind);
                }
                li = li + 1;
            }
            // owner[row] = which speaker this display row belongs to, so the
            // renderer can paint the whole message as one tinted block.
            int ownCode = ChatArea.RoleCode(msgs[i].role);
            ChatArea.OwnRows(cache, msgStart, ownCode);
            // One unpainted spacer row closes a turn: with six members talking,
            // tinted blocks that touch each other read as one wall of text. The
            // spacer carries no tint and no rail, so the blocks separate.
            TextRun gap = TextRun.Create("", t.textTertiary, 6);
            gap.owner = ownCode;
            cache.Add(gap);
            i = i + 1;
        }
        // meta[row] = the message index a kind-5 toggle row controls (else -1).
        for (int tpi = 0; tpi < togPos.Count; tpi = tpi + 1) {
            int at = togPos[tpi];
            if (at >= 0 && at < cache.Count) { cache[at].meta = togMsg[tpi]; }
        }
    }

    /// Strips light markdown syntax for plain-text display: heading hashes,
    /// `**`/`__` bold markers and single backticks; keeps list dashes.
    static string MdStrip(string ln) {
        string s = ln;
        int h = 0;
        for (; h < s.Length && s.Substring(h, 1) == "#"; h = h + 1) { }
        if (h > 0 && h < s.Length && s.Substring(h, 1) == " ") {
            s = s.Substring(h + 1, s.Length - h - 1);
        }
        StringBuilder sb = new StringBuilder();
        int i = 0;
        while (i < s.Length) {
            string ch = s.Substring(i, 1);
            if (ch == "*" && i + 1 < s.Length && s.Substring(i + 1, 1) == "*") { i = i + 2; }
            else if (ch == "`") { i = i + 1; }
            else { sb.Append(ch); i = i + 1; }
        }
        return sb.ToString();
    }

    // HeadAvatar / PaintHeadRow / FontPx / RowH / RowAtChat used to live here;
    // they moved into the StyledText control alongside the line-grid painting,
    // so this view no longer holds any drawing helpers of its own.

    // One retained StyledText paints the whole transcript grid; one retained
    // Label paints the empty-state hint. Static so they live across frames
    // instead of being rebuilt each draw.
    static StyledText tx;
    static Label emptyLbl;

    /// Binds the (pre-wrapped, cached) chat transcript to the StyledText grid
    /// and returns the maximum scroll offset. All painting -- block tints, the
    /// speaker rail, code background, selection highlight, head row, busy line
    /// -- is the control's own OnPaint; this view only supplies the data and
    /// the empty-state hint.
    static int RenderChatArea(App app, Rect area, List<TextRun> cache,
            List<int> toolOpen, int scroll, bool busy,
            LogState sel, bool interactive, SignalInt thinkOpen) {
        int pad = app.Scale(6);
        if (cache.Count == 0 && !busy) {
            if (ChatArea.emptyLbl == null) {
                ChatArea.emptyLbl = new Label();
                ChatArea.emptyLbl.wrap = true;
                ChatArea.emptyLbl.Class = "hint small";
            }
            ChatArea.emptyLbl.Text = ZanIDE.T(
                "Ask Xiao Zan about your project: explain code, find bugs, generate Zan snippets.",
                "向小赞提问：解释代码、查找问题、生成 Zan 代码片段。");
            ChatArea.emptyLbl.RenderInside(app,
                new Rect(area.x + pad, area.y + pad,
                         area.width - pad * 2, area.height));
            return 0;
        }
        if (ChatArea.tx == null) { ChatArea.tx = new StyledText(); }
        StyledText g = ChatArea.tx;
        g.lines = cache;
        g.scroll = scroll;
        g.busy = busy;
        g.sel = sel;
        g.interactive = interactive;
        g.thinkOpen = thinkOpen;
        g.toolOpen = toolOpen;
        g.busyText = ZanIDE.T("Xiao Zan is thinking...", "小赞思考中...");
        g.RenderInside(app, area);
        return g.maxScroll;
    }
}