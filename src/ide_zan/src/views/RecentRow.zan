using System;
using Gui;
using Gui.Widget;

public class RecentRow : Control {
    RecentItem item;
    weak StartPage owner;
    Button close;

    RecentRow(RecentItem it, StartPage page) {
        owner = page;
        this.InitControl("recentRow", 1);
        Class = "recent-row";
        this.SetProp("style", "display:flex;flex-direction:row;align-items:center;gap:var(--gap-small)");
        item = it;
        string label = Path.GetFileName(it.path);
        if (label == "") { label = it.path; }
        string initial = "";
        if (label.Length > 0) { initial = label.Substring(0, 1); }
        Avatar av = new Avatar(initial);
        av.SetProp("style", "flex-shrink:0");
        this.Add(av);
        Panel text = Panel.Column();
        text.SetProp("style", "flex:1;min-width:0");
        Label name = new Label(label);
        text.With(name);
        Label sub = new Label(it.path);
        sub.Class = "secondary small";
        text.With(sub);
        this.Add(text);

        close = new Button("");
        close.name = "recent-remove";
        close.Class = "ghost small";
        close.Icon = "close";
        close.Tip = ZanIDE.T("Remove", "移除");
        close.SetProp("style", "flex-shrink:0");
        RecentRowEvents events = new RecentRowEvents();
        events.owner = this;
        close.Click.Add(events.Remove);
        this.Add(close);
    }

    void RemoveClicked(Control sender) {
        StartPage page = owner;
        if (sender == close && page != null) { page.RemoveRecent(this, item.path); }
    }

    override string StyleType() { return "listrow"; }

    override void OnMeasure(App app) {
        StyleBox s = this.ResolveStyleAs(app, "listrow", Class, Style.SNormal());
        prefH = s.HeightOr(app.theme.heightLarge
                           + Canvas.FontHeight(app.theme.fontSizeSmall));
    }
}
