using System;
using Gui;
using Gui.Widget;

/// 聊天记录上方那条「这次交付跑到哪了 + 任务计划」：状态条（RunStrip）、
/// 一行「任务计划 3/7」带清空按钮的表头，和步骤清单。
///
/// 结构在 `views/PlanStrip.zform` 里声明。每一步是一个真正的 Checkbox 行
/// （`PlanRow`），点表头折叠、点「清空计划」清空都由控件自己的事件给出，
/// 因此这里没有行矩形、没有勾选框绘制、也没有点击派发。
partial class PlanStrip {
    /// 绑上去的那份计划：只在计划被换掉时重绑（每帧重绑会把用户刚点的
    /// 勾选状态丢掉）。
    List<AiPlanStep> bound;
    bool collapsed;
    /// 本帧用户点了「清空计划」，外壳取走。
    bool clearWanted;
    static PlanStrip current;

    void OnInit() {
        bound = null;
        collapsed = false;
        clearWanted = false;
        PlanStrip.current = this;
        this.Rows.WithRow(PlanRow.Of);
        this.ClearBtn.Text = ZanIDE.T("Clear plan", "清空计划");
        this.ClearBtn.Click.Add(PlanStrip.ClearClicked);
        this.TitleBtn.Click.Add(PlanStrip.HeadClicked);
    }

    static void ClearClicked() {
        if (PlanStrip.current != null) { PlanStrip.current.clearWanted = true; }
    }

    /// 点表头折叠 / 展开清单。
    static void HeadClicked() {
        if (PlanStrip.current != null) {
            PlanStrip.current.collapsed = !PlanStrip.current.collapsed;
        }
    }

    /// 本帧用户要求清空计划（取走后清标记）。
    bool TakeClear() {
        bool c = clearWanted;
        clearWanted = false;
        return c;
    }

    /// 这条带子要占多高：只有状态条时就是状态条的高度，折叠时加一行
    /// 表头，展开时按步数（至多八行）加清单。
    int HeightOf(App app, AiRun run, List<AiPlanStep> plan) {
        int runH = RunStrip.HeightOf(app, run);
        if (plan == null || plan.Count == 0) { return runH; }
        int hdr = app.Scale(24);
        if (collapsed) { return runH + hdr; }
        int rows = plan.Count;
        if (rows > 8) { rows = 8; }
        return runH + hdr + rows * app.Scale(20) + app.Scale(6);
    }

    /// 把这一帧的交付状态和计划铺进控件。
    void Sync(App app, AiRun run, List<AiPlanStep> plan) {
        int runH = RunStrip.HeightOf(app, run);
        this.Run.Prefer(0, runH);
        this.Run.SetShown(runH > 0);
        if (runH > 0) { this.Run.Sync(run); }

        bool has = plan != null && plan.Count > 0;
        this.Head.SetShown(has);
        this.Rule.SetShown(has);
        this.Rows.SetShown(has && !collapsed);
        if (!has) { return; }
        int done = 0;
        for (int i = 0; i < plan.Count; i = i + 1) {
            if (plan[i].done != 0) { done = done + 1; }
        }
        string caret = "v ";
        if (collapsed) { caret = "> "; }
        this.TitleBtn.Text = caret + ZanIDE.T("Plan", "任务计划") + " "
            + Convert.ToString(done) + "/" + Convert.ToString(plan.Count);
        if (bound != plan) {
            this.Rows.Bind(plan);
            bound = plan;
        }
    }
}
