using System;
using Gui;
using Gui.Widget;

public class UsageCard {
    Card card;
    ListView<UsageStat> ctxList;
    ListView<UsageStat> sesList;
    Label note;
    Label contextHead;
    Label sessionHead;

    UsageCard(string title, string sessionTitle) {
        // 卡片自己的标题走主题的大字号，对一张只有数字的统计卡
        // 来说太重；标题和分节名都是卡片里的普通标签，字号由
        // ide.css 的 `label.usage-head` 决定。
        card = new Card("");
        card.Class = "usage";
        contextHead = new Label(title);
        contextHead.Class = "usage-head";
        card.Add(contextHead);
        ctxList = new ListView<UsageStat>(UsageStatRow.Of);
        ctxList.Class = "usage flat";
        // 两份列表都停靠到顶部（而不是默认的填充）：卡片的高度要由内容
        // 量决定，而停靠容器只能把顶/底停靠的子项累成自然高度，
        // 两个填充子项反而会重叠在一起。
        ctxList.dock = 1;
        card.Add(ctxList);
        note = new Label("");
        note.Class = "small secondary";
        note.wrap = true;
        note.visible = false;
        card.Add(note);
        card.Add(new Divider());
        sessionHead = new Label(sessionTitle);
        sessionHead.Class = "usage-head";
        card.Add(sessionHead);
        sesList = new ListView<UsageStat>(UsageStatRow.Of);
        sesList.Class = "usage flat";
        sesList.dock = 1;
        card.Add(sesList);
    }

    void Update(List<UsageStat> context, List<UsageStat> session,
            string noteText) {
        ctxList.Bind(context);
        sesList.Bind(session);
        note.Text = noteText;
        note.visible = noteText != "";
    }

    int Height(App app) {
        card.MeasureTree(app);
        return card.prefH;
    }

    void RenderAt(App app, int x, int y, int w) {
        card.RenderAt(app, x, y, w);
    }
}
