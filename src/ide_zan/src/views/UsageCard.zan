using System;
using Gui;
using Gui.Widget;

/// One `name  value` line of the usage card. Only the numbers live here; how
/// they are shown is the row's business.
class UsageStat {
    string label;
    string value;
    /// Extra class for the value label ("" = plain, "warning" = attention).
    string tone;

    static UsageStat Of(string label, string value) {
        UsageStat s = new UsageStat();
        s.label = label;
        s.value = value;
        s.tone = "";
        return s;
    }

    /// The same line, flagged when the number is one the user should notice
    /// (compactions that happened, requests that failed).
    static UsageStat Flag(string label, string value, bool warn) {
        UsageStat s = UsageStat.Of(label, value);
        if (warn) { s.tone = "warning"; }
        return s;
    }
}

/// One row of the usage card: name on the left, number on the right, both of
/// them labels docked by the layout -- so no column arithmetic and no
/// right-alignment measuring anywhere.
class UsageStatRow : Control {
    static Control Of(UsageStat s) { return new UsageStatRow(s); }

    UsageStatRow(UsageStat s) {
        this.InitControl("usageStat", 1);
        Class = "usage-row";
        Label name = new Label(s.label);
        name.Class = "small secondary";
        name.dock = 3;
        this.Add(name);
        Label val = new Label(s.value);
        val.Class = "small";
        if (s.tone != "") { val.Class = "small " + s.tone; }
        val.dock = 4;
        this.Add(val);
    }

    override string Kind() { return "UsageStatRow"; }

    override string StyleType() { return "listrow"; }

    override void OnMeasure(App app) {
        prefH = app.theme.heightSmall;
    }
}

/// The AI panel's context / usage card: what the running transcript costs
/// against the compaction budget, and this session's request and token totals.
/// It is a card with two bound lists, so the panel only supplies numbers and a
/// position -- the surface, the rows and the wrapped note draw themselves.
class UsageCard {
    Card card;
    ListView<UsageStat> ctxList;
    ListView<UsageStat> sesList;
    Label note;
    Label contextHead;
    Label sessionHead;

    UsageCard(string title, string sessionTitle) {
        // 卡片自己的标题走主题的大字号，对一张只有数字的统计卡
        // 来说太重；标题和分节名都是卡片里的普通标签，字号由
        // ide.css 的 `label.usage-head` 决定。
        card = new Card("");
        card.Class = "usage";
        contextHead = new Label(title);
        contextHead.Class = "usage-head";
        card.Add(contextHead);
        ctxList = new ListView<UsageStat>(UsageStatRow.Of);
        ctxList.Class = "usage flat";
        card.Add(ctxList);
        // The compaction note is a paragraph, not a row: it wraps to the card
        // width instead of being cut into hand-broken lines.
        note = new Label("");
        note.Class = "small secondary";
        note.wrap = true;
        note.visible = false;
        card.Add(note);
        card.Add(new Divider());
        sessionHead = new Label(sessionTitle);
        sessionHead.Class = "usage-head";
        card.Add(sessionHead);
        sesList = new ListView<UsageStat>(UsageStatRow.Of);
        sesList.Class = "usage flat";
        card.Add(sesList);
    }

    /// Replace the numbers shown. `noteText` is "" when the transcript has
    /// never been compacted, and the note disappears with it.
    void Update(List<UsageStat> context, List<UsageStat> session,
            string noteText) {
        ctxList.Bind(context);
        sesList.Bind(session);
        note.Text = noteText;
        note.visible = noteText != "";
    }

    /// Height the card needs for the numbers it currently holds, so the host
    /// can keep it inside the window before drawing it.
    int Height(App app) {
        card.MeasureTree(app);
        return card.prefH;
    }

    void RenderAt(App app, int x, int y, int w) {
        card.RenderAt(app, x, y, w);
    }
}
