using System;
using Gui;
using Gui.Widget;

// 接口数据协议与执行契约。
// 核心契约与语义定义。
class UsageStat {
    string label;
    string value;
    // 接口数据协议与执行契约。
    string tone;

    static UsageStat Of(string label, string value) {
        UsageStat s = new UsageStat();
        s.label = label;
        s.value = value;
        s.tone = "";
        return s;
    }

    // 接口数据协议与执行契约。
    // 核心契约与语义定义。
    static UsageStat Flag(string label, string value, bool warn) {
        UsageStat s = UsageStat.Of(label, value);
        if (warn) { s.tone = "warning"; }
        return s;
    }
}

// 接口数据协议与执行契约。
// 核心契约与语义定义。
class UsageStatRow : Control {
    static Control Of(UsageStat s) { return new UsageStatRow(s); }

    UsageStatRow(UsageStat s) {
        this.InitControl("usageStat", 1);
        Class = "usage-row";
        Label name = new Label(s.label);
        name.Class = "small secondary";
        name.dock = 3;
        this.Add(name);
        Label val = new Label(s.value);
        val.Class = "small";
        if (s.tone != "") { val.Class = "small " + s.tone; }
        val.dock = 4;
        this.Add(val);
    }

    override string Kind() { return "UsageStatRow"; }

    override string StyleType() { return "listrow"; }

    override void OnMeasure(App app) {
        prefH = app.theme.heightSmall;
    }
}

// 接口数据协议与执行契约。
class UsageCard {
    Card card;
    ListView<UsageStat> ctxList;
    ListView<UsageStat> sesList;
    Label note;
    Label contextHead;
    Label sessionHead;

    UsageCard(string title, string sessionTitle) {
        // 卡片自己的标题走主题的大字号，对一张只有数字的统计卡
        // 来说太重；标题和分节名都是卡片里的普通标签，字号由
        // ide.css 的 `label.usage-head` 决定。
        card = new Card("");
        card.Class = "usage";
        contextHead = new Label(title);
        contextHead.Class = "usage-head";
        card.Add(contextHead);
        ctxList = new ListView<UsageStat>(UsageStatRow.Of);
        ctxList.Class = "usage flat";
        // 两份列表都停靠到顶部（而不是默认的填充）：卡片的高度要由内容
        // 量决定，而停靠容器只能把顶/底停靠的子项累成自然高度，
        // 两个填充子项反而会重叠在一起。
        ctxList.dock = 1;
        card.Add(ctxList);
        // 接口数据协议与执行契约。
        note = new Label("");
        note.Class = "small secondary";
        note.wrap = true;
        note.visible = false;
        card.Add(note);
        card.Add(new Divider());
        sessionHead = new Label(sessionTitle);
        sessionHead.Class = "usage-head";
        card.Add(sessionHead);
        sesList = new ListView<UsageStat>(UsageStatRow.Of);
        sesList.Class = "usage flat";
        sesList.dock = 1;
        card.Add(sesList);
    }

    // 接口数据协议与执行契约。
    void Update(List<UsageStat> context, List<UsageStat> session,
            string noteText) {
        ctxList.Bind(context);
        sesList.Bind(session);
        note.Text = noteText;
        note.visible = noteText != "";
    }

    // 接口数据协议与执行契约。
    int Height(App app) {
        card.MeasureTree(app);
        return card.prefH;
    }

    void RenderAt(App app, int x, int y, int w) {
        card.RenderAt(app, x, y, w);
    }
}
