using System;
using Gui;
using Gui.Widget;

/// One line of the git changes panel: a `git status --porcelain` line rendered
/// as a standard Label. The status character selects a semantic colour class.
class GitFileRow {
    /// Row template for `new ListView<string>(GitFileRow.Of)`.
    static Control Of(string line) {
        Label lbl = new Label(line);
        lbl.Class = GitFileRow.ClassFor(line);
        return lbl;
    }

    static string ClassFor(string line) {
        if (line.Length < 2) { return "secondary"; }
        string x = line.Substring(0, 1);
        string y = line.Substring(1, 1);
        if (x == "?") { return "error"; }
        if (y == " ") { return "success"; }
        return "warning";
    }
}
