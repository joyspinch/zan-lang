using System;
using Gui;
using Gui.Widget;

/// 资产管理器的界面：面包屑、两行工具条、列表、右侧详情列和底栏。
///
/// 像素全在 `AssetPanel.zform` 里声明，这里只做三件事：开局把列表的列
/// 与按钮的 Click 接到 `AssetManager` 上、每帧让管理器把状态铺进来
/// （`AssetManager.Sync`）、以及把「显示什么」表达成显隐（`ShowEmpty` /
/// `ShowMulti` / `ShowEntry`）。没有手算坐标，也没有轮询 WasClicked。
/// @component Project assets
partial class AssetPanel {
    void OnInit() {
        AssetManager.BindPanel(this);
        this.List.Class = "headless";
        this.List.WithColumns(AssetPanel.Columns()).WithMultiSelect();
        this.List.EmptyText(AssetManager.T(
            "Empty. Import files or a whole folder to begin.",
            "空目录。可导入文件或整个文件夹。"));
        this.List.OnSelect(AssetManager.EntrySelected);
        this.List.OnActivate(AssetManager.EntryActivated);
        this.ImportBtn.Click.Add(AssetManager.RequestImportFile);
        this.ImportDirBtn.Click.Add(AssetManager.RequestImportFolder);
        this.LinkBtn.Click.Add(AssetManager.RequestLink);
        this.UpBtn.Click.Add(AssetManager.GoUp);
        this.MkBtn.Click.Add(AssetManager.MakeFolder);
        this.PkBtn.Click.Add(AssetManager.TogglePack);
        this.RenameBtn.Click.Add(AssetManager.RenameSelected);
        this.DelBtn.Click.Add(AssetManager.DeleteSelected);
        this.LoopBtn.Click.Add(AssetManager.CycleLoop);
        this.AnimBtn.Click.Add(AssetManager.WriteAnimClip);
        this.CloseBtn.Click.Add(AssetManager.RequestClose);
    }

    /// 列表的列：名称、类型徽标、大小（右对齐）。徽标和大小列没有表头，
    /// 列表整体也是 headless，于是它读起来像一个文件树而不是表格。
    static List<ListColumn<AssetEntry>> Columns() {
        List<ListColumn<AssetEntry>> cols = new List<ListColumn<AssetEntry>>();
        cols.Add(new ListColumn<AssetEntry>(AssetManager.T("Name", "名称"), 4,
                                           entry => entry.name));
        cols.Add(new ListColumn<AssetEntry>("", 1, entry => entry.chip));
        cols.Add(new ListColumn<AssetEntry>("", 1, entry => entry.size).Right());
        return cols;
    }

    /// 每帧由管理器把当前目录、列表内容和详情列的状态铺进来。
    override void OnMeasure(App app) {
        AssetManager manager = AssetManager.current;
        if (manager != null) { manager.Sync(); }
    }

    /// 固定的文案，每帧重读一次，于是切换 IDE 语言不用重建控件树。
    void Localize() {
        this.ImportBtn.Text = AssetManager.T("Import file", "导入文件");
        this.ImportDirBtn.Text = AssetManager.T("Import folder", "导入文件夹");
        this.LinkBtn.Text = AssetManager.T("Link file", "链接文件");
        this.UpBtn.Text = AssetManager.T("Up", "上级");
        this.MkBtn.Text = AssetManager.T("New folder", "新建文件夹");
        this.CloseBtn.Text = AssetManager.T("Close", "关闭");
        this.RenameBtn.Text = AssetManager.T("Rename", "重命名");
        this.AnimBtn.Text = AssetManager.T("Write .anim", "写入 .anim");
        this.AnimHead.Text = AssetManager.T("Animation clip (.anim)",
                                            "动画剪辑 (.anim)");
        this.HintLbl.Text = AssetManager.T("Select an entry on the left.",
                                           "在左侧选择一个条目。");
        this.FpdName.Text = AssetManager.T("frames/dir", "每方向帧数");
        this.DirsName.Text = AssetManager.T("directions", "方向数");
        this.FpsName.Text = "fps";
        this.SizeName.Text = AssetManager.T("frame WxH", "帧宽x高");
    }

    void SetCrumb(string text) { this.Crumb.Text = text; }
    void SetMessage(string text) { this.Msg.Text = text; }

    /// 发布方式是个开关按钮：文案本身说明当前是哪种模式。
    void SetPackLabel(bool on) {
        if (on) {
            this.PkBtn.Text = AssetManager.T("Publish: embed (encrypted)",
                                             "发布：嵌入(加密)");
            this.PkBtn.Class = "primary small";
        } else {
            this.PkBtn.Text = AssetManager.T("Publish: copy files",
                                             "发布：复制文件");
            this.PkBtn.Class = "small";
        }
    }

    void HideAll() {
        this.MultiLbl.SetShown(false);
        this.TitleLbl.SetShown(false);
        this.MetaLbl.SetShown(false);
        this.PathLbl.SetShown(false);
        this.HintLbl.SetShown(false);
        this.RenameRow.SetShown(false);
        this.DelRow.SetShown(false);
        this.AnimBox.SetShown(false);
    }

    /// 没有选中：只留提示。
    void ShowEmpty() {
        this.HideAll();
        this.HintLbl.SetShown(true);
    }

    /// 多选：只有批量删除可用。
    void ShowMulti(int count, bool confirm) {
        this.HideAll();
        this.MultiLbl.SetShown(true);
        this.MultiLbl.Text = Convert.ToString(count)
            + AssetManager.T(" items selected", " 项已选");
        this.DelRow.SetShown(true);
        this.DelBtn.Text = AssetManager.T("Delete selected", "删除所选");
        if (confirm) {
            this.DelBtn.Text = AssetManager.T("Confirm delete", "确认删除");
        }
    }

    /// 单选：名称、它是什么、重命名（文件/目录）、删除，图片再加动画编辑器。
    void ShowEntry(AssetEntry entry, string meta, bool confirm,
                   bool anim, int loopMode) {
        this.HideAll();
        this.TitleLbl.SetShown(true);
        this.TitleLbl.Text = entry.name;
        this.MetaLbl.SetShown(true);
        this.MetaLbl.Text = meta;
        this.PathLbl.SetShown(entry.IsLink());
        this.PathLbl.Text = entry.path;
        this.RenameRow.SetShown(!entry.IsLink());
        this.DelRow.SetShown(true);
        this.DelBtn.Text = AssetManager.T("Delete", "删除");
        if (entry.IsLink()) {
            this.DelBtn.Text = AssetManager.T("Remove link", "移除链接");
        }
        if (confirm) {
            this.DelBtn.Text = AssetManager.T("Confirm delete", "确认删除");
        }
        this.AnimBox.SetShown(anim);
        this.LoopBtn.Text = AssetManager.T("loop: once", "循环: 单次");
        if (loopMode == 1) {
            this.LoopBtn.Text = AssetManager.T("loop: loop", "循环: 循环");
        }
        if (loopMode == 2) {
            this.LoopBtn.Text = AssetManager.T("loop: section", "循环: 区段");
        }
    }
}
