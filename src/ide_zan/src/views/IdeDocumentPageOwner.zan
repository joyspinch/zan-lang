// Document pages submit input actions to their host; painting only consumes the tree.
interface IdeDocumentPageOwner {
    void StartPageAction(StartPage sender, int action, string path);
    void DiffViewAction(DiffView sender, bool accept, string path);
}

class StartPageEvents {
    public weak StartPage owner;

    public Gui.Control CreateRecent(RecentItem item) {
        StartPage page = owner;
        return new RecentRow(item, page);
    }

    public void RecentPicked() {
        StartPage page = owner;
        if (page != null) { page.PickRecent(); }
    }

    public void ArticlePicked() {
        StartPage page = owner;
        if (page != null) { page.PickArticle(); }
    }

    public void QuickPicked(Gui.Control sender) {
        StartPage page = owner;
        if (page != null) { page.PickQuick(sender); }
    }
}

class RecentRowEvents {
    public weak RecentRow owner;

    public void Remove(Gui.Control sender) {
        RecentRow row = owner;
        if (row != null) { row.RemoveClicked(sender); }
    }
}

class DiffViewEvents {
    public weak DiffView owner;
    public int revision;

    public void Accept(Gui.Control sender) {
        DiffView page = owner;
        if (page != null) { page.SubmitAction(sender, true, revision); }
    }

    public void Reject(Gui.Control sender) {
        DiffView page = owner;
        if (page != null) { page.SubmitAction(sender, false, revision); }
    }
}
