using System;
using Gui;
using Gui.Widget;

/// 任务计划带子里的「跑到哪了」状态条：十二个相位圆点、当前拍与下一步
/// 动作的一行文字，下面一条分隔线。
///
/// 结构在 `views/RunStrip.zform` 里声明（圆点容器 + 状态文字 + 分隔线）。
/// 圆点数量来自 `AiPhase.Count()`，因此在 OnInit 里按相位建一次 Badge 并
/// 留着，不是每帧造临时控件；这里只把状态翻译成类名和一句话。
partial class RunStrip {
    List<Badge> dots;

    void OnInit() {
        dots = new List<Badge>();
        for (int ph = 0; ph < AiPhase.Count(); ph = ph + 1) {
            Badge dot = new Badge();
            dot.Class = "dot phase idle";
            dots.Add(dot);
            this.Dots.Add(dot);
        }
    }

    /// 相位方块的语义色：状态是数据，颜色由样式表按类给出。
    static string Tone(int st) {
        if (st == AiRunStatus.Done()) { return "success"; }
        if (st == AiRunStatus.Running()) { return "primary"; }
        if (st == AiRunStatus.Failed()) { return "error"; }
        if (st == AiRunStatus.Blocked()) { return "warning"; }
        if (st == AiRunStatus.Skipped()) { return "skipped"; }
        return "idle";
    }

    /// 「任务号 当前拍 · 已完成/总数 [· 故障分类] [· 下一步]」。
    static string StatusText(AiRun run) {
        string label = run.taskId + " "
            + ZanIDE.T(AiPhase.En(run.phase), AiPhase.Zh(run.phase));
        label = label + " · " + Convert.ToString(run.DoneCount()) + "/"
            + Convert.ToString(AiPhase.Count());
        if (run.fault != AiFault.None()) {
            label = label + " · " + AiFault.Zh(run.fault);
        }
        int act = run.NextAction();
        if (act == AiNext.AskUser()) {
            label = label + " · " + ZanIDE.T("waiting for you", "等你");
        } else if (act == AiNext.Diagnose()) {
            label = label + " · " + ZanIDE.T("root-causing", "定位根因");
        } else if (act == AiNext.Retry()) {
            label = label + " · " + ZanIDE.T("retrying", "重试");
        } else if (act == AiNext.Finished()) {
            label = label + " · " + ZanIDE.T("done", "完成");
        }
        return label;
    }

    /// 状态条的高度（没有任务时为 0）。
    static int HeightOf(App app, AiRun run) {
        if (run == null) { return 0; }
        return app.Scale(22);
    }

    /// 把 `run` 铺进控件：圆点的语义色和那一行文字。绘制归控件树。
    void Sync(AiRun run) {
        if (run == null) { return; }
        for (int i = 0; i < dots.Count; i = i + 1) {
            AiRunStep st = run.At(i);
            if (st == null) { continue; }
            dots[i].Class = "dot phase " + RunStrip.Tone(st.status);
        }
        this.StatusLbl.Text = RunStrip.StatusText(run);
        if (run.fault != AiFault.None()) {
            this.StatusLbl.Class = "small error";
        } else {
            this.StatusLbl.Class = "small secondary";
        }
    }
}
