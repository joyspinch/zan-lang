using System;
using Gui;
using Gui.Widget;

/// 代码视图右上角那个小输入条：跳转到行、断点条件、重命名符号、在文件中
/// 查找 / 替换都用它。以前每一种都是自己画一个面板、自己收按键（退格、
/// 回车、可见字符各写一遍，没有选择、没有剪贴板、没有输入法）；现在结构
/// 在 `views/QuickPrompt.zform` 里声明，两行都是标准 Input，回车由控件的
/// Submit 事件送出来，编辑行为全归输入框。
///
/// 它是覆盖层：贴在编辑区里画，位置由调用方给一个锚点，而不是在页面的绘制
/// 顺序里插一段。
partial class QuickPrompt {
    bool open;
    /// 第二行（只有「在文件中替换」用得上）。
    bool twoLine;
    /// 本帧用户按了回车 / 点了按钮。
    bool submitted;
    int anchorX;
    int anchorY;
    int anchorW;
    static QuickPrompt current;

    void OnInit() {
        open = false;
        twoLine = false;
        submitted = false;
        anchorX = 0;
        anchorY = 0;
        anchorW = 0;
        QuickPrompt.current = this;
        QuickPrompt.Go.Text = ZanIDE.T("Go", "转到");
        QuickPrompt.Go.Click.Add(QuickPrompt.Submitted);
        QuickPrompt.First.Submit.Add(QuickPrompt.Submitted);
        QuickPrompt.Second.Submit.Add(QuickPrompt.Submitted);
    }

    static void Submitted() {
        if (QuickPrompt.current != null) { QuickPrompt.current.submitted = true; }
    }

    bool IsOpen() { return open; }

    string FirstText() { return QuickPrompt.First.GetText(); }

    string SecondText() { return QuickPrompt.Second.GetText(); }

    /// 打开（或换一种用途）。`second` 为 null 表示只有一行。
    void Show(string caption, string text, string second, string goText) {
        open = true;
        submitted = false;
        twoLine = second != null;
        QuickPrompt.Cap.Text = caption;
        QuickPrompt.First.SetText(text);
        if (twoLine) { QuickPrompt.Second.SetText(second); }
        QuickPrompt.Row2.SetShown(twoLine);
        QuickPrompt.Go.Text = goText;
    }

    /// 只换标题（同一种用途、行号或符号名变了时不要冲掉正在输入的内容）。
    void Caption(string caption) { QuickPrompt.Cap.Text = caption; }

    void Close() {
        open = false;
        submitted = false;
    }

    /// 本帧提交了（取走后清标记，这样一次回车只会执行一次）。
    bool TakeSubmit() {
        bool s = submitted;
        submitted = false;
        return s;
    }

    /// 贴在编辑区右上角：`x`/`y` 是编辑区左上角，`w` 是它的宽度。
    void Anchor(int x, int y, int w) {
        anchorX = x;
        anchorY = y;
        anchorW = w;
    }

    void Frame(App app) {
        if (!open) { return; }
        app.AddOverlay(OverlayPopup.Host(this));
    }

    override void OnPaintOverlay(App app) {
        if (!open) { return; }
        int w = app.Scale(360);
        if (w > anchorW - app.Scale(16)) { w = anchorW - app.Scale(16); }
        int rows = 1;
        if (twoLine) { rows = 2; }
        int h = app.Scale(34) + rows * app.Scale(32);
        int x = anchorX + anchorW - w - app.Scale(8);
        int y = anchorY + app.Scale(4);
        // 它压在代码上面，所以下面的编辑器不能同时吃到这一下点击。
        app.BlockHitsRect(x, y, w, h);
        this.RenderInside(app, new Rect(x, y, w, h));
        // Esc 关掉，和其它浮层一致。
        if (app.window.EventKind() == 6 && app.window.EventKeyCode() == 27) {
            this.Close();
            app.RequestRedraw();
        }
    }
}
