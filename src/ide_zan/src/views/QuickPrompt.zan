using System;
using Gui;
using Gui.Widget;

// 代码视图右上角那个小输入条：跳转到行、断点条件、重命名符号、在文件中
// 查找 / 替换都用它。以前每一种都是自己画一个面板、自己收按键（退格、
// 回车、可见字符各写一遍，没有选择、没有剪贴板、没有输入法）；现在结构
// 在 `views/QuickPrompt.html` 里声明，两行都是标准 Input，回车由控件的
// Submit 事件送出来，编辑行为全归输入框。
// 它是覆盖层：贴在编辑区里画，位置由调用方给一个锚点，而不是在页面的绘制
// 顺序里插一段。
partial class QuickPrompt {
    bool open;
    // 第二行（只有「在文件中替换」用得上）。
    bool twoLine;
    // 本帧用户按了回车 / 点了按钮。
    bool submitted;
    bool focusPending;
    bool shownOverlay;
    bool shownTwoLine;
    int anchorX;
    int anchorY;
    int anchorW;
    int shownX;
    int shownY;
    int shownW;
    static QuickPrompt current;

    void OnInit() {
        open = false;
        twoLine = false;
        submitted = false;
        focusPending = false;
        shownOverlay = false;
        shownTwoLine = false;
        anchorX = 0;
        anchorY = 0;
        anchorW = 0;
        shownX = 0 - 1;
        shownY = 0 - 1;
        shownW = 0 - 1;
        QuickPrompt.current = this;
        this.Go.Text = ZanIDE.T("Go", "转到");
        this.Go.Click.Add(QuickPrompt.Submitted);
        this.First.Submit.Add(QuickPrompt.Submitted);
        this.Second.Submit.Add(QuickPrompt.Submitted);
    }

    static void Submitted() {
        if (QuickPrompt.current != null) { QuickPrompt.current.submitted = true; }
    }

    bool IsOpen() { return open; }

    string FirstText() { return this.First.GetText(); }

    string SecondText() { return this.Second.GetText(); }

    // 打开（或换一种用途）。`second` 为 null 表示只有一行。
    void Show(string caption, string text, string second, string goText) {
        open = true;
        submitted = false;
        focusPending = true;
        twoLine = second != null;
        this.Cap.Text = caption;
        this.First.SetText(text);
        if (twoLine) { this.Second.SetText(second); }
        this.Row2.SetShown(twoLine);
        this.Go.Text = goText;
    }

    // 只换标题（同一种用途、行号或符号名变了时不要冲掉正在输入的内容）。
    void Caption(string caption) { this.Cap.Text = caption; }

    void Close() {
        open = false;
        submitted = false;
        focusPending = false;
        shownOverlay = false;
        if (this.App != null && this.App.overlayHost != null) {
            this.App.overlayHost.Hide(this);
        }
    }

    public override void OnPopupDismissed() {
        open = false;
        submitted = false;
        focusPending = false;
        shownOverlay = false;
    }

    // 本帧提交了（取走后清标记，这样一次回车只会执行一次）。
    bool TakeSubmit() {
        bool s = submitted;
        submitted = false;
        return s;
    }

    // 贴在编辑区右上角：`x`/`y` 是编辑区左上角，`w` 是它的宽度。
    void Anchor(int x, int y, int w) {
        anchorX = x;
        anchorY = y;
        anchorW = w;
    }

    override void OnMeasure(App app) {
        int w = app.Scale(360);
        if (anchorW > 0 && w > anchorW - app.Scale(16)) { w = anchorW - app.Scale(16); }
        if (w < app.Scale(120)) { w = app.Scale(120); }
        int rows = 1;
        if (twoLine) { rows = 2; }
        prefW = w;
        prefH = app.Scale(34) + rows * app.Scale(32);
    }

    void Frame(App app) {
        if (app == null || app.overlayHost == null) { return; }
        if (!open) {
            if (shownOverlay || app.overlayHost.ActiveRoot() == this) {
                shownOverlay = false;
                app.overlayHost.Hide(this);
            }
            return;
        }
        int w = app.Scale(360);
        if (anchorW > 0 && w > anchorW - app.Scale(16)) { w = anchorW - app.Scale(16); }
        if (w < app.Scale(120)) { w = app.Scale(120); }
        int x = anchorX + anchorW - w - app.theme.gapMedium;
        int y = anchorY + app.theme.gapSmall;
        if (app.overlayHost.ActiveRoot() != this || !shownOverlay
            || x != shownX || y != shownY || w != shownW || twoLine != shownTwoLine) {
            shownX = x;
            shownY = y;
            shownW = w;
            shownTwoLine = twoLine;
            shownOverlay = true;
            app.overlayHost.ShowAt(app, this, x, y);
        }
        if (focusPending && app.focus != null && this.First != null) {
            focusPending = false;
            app.focus.SetFocused(this.First.WidgetId());
        }
    }
}
