using System;
using Gui;
using Gui.Widget;
using Gui.Component;

/// 调试器的底部面板：控制台 / 变量 / 监视 / 调用栈。
///
/// 结构在 `views/DebugPanel.zform` 里声明（页签条 + 四块内容），这里只
/// 绑定调试器的数据、切页签、并把用户在「监视」页里的意图交回外壳。
/// 表头、行高、条纹、滚动、空状态和文本编辑全部属于控件。
partial class DebugPanel {
    /// 一个外壳一块底部面板；静态处理器靠它找回实例。
    static DebugPanel current;
    /// 页签标签的上一份内容：切换界面语言才重建，避免每帧重排。
    static List<string> tabLbls;
    /// 用户在「监视」页里做的事，外壳每帧取走：要加的表达式、要删的行。
    static string watchAdd;
    static int watchDrop;

    void OnInit() {
        DebugPanel.current = this;
        DebugPanel.watchAdd = "";
        DebugPanel.watchDrop = 0 - 1;
        DebugPanel.tabLbls = null;
        this.Console.EmptyText(
            ZanIDE.T("(no debug output)", "（暂无调试输出）"));
        this.Vars.WithColumns(DebugPanel.VarColumns());
        this.Vars.EmptyText(ZanIDE.T("(no variables in scope)",
            "（作用域内没有变量）"));
        this.WatchGrid.WithColumns(DebugPanel.VarColumns());
        this.WatchGrid.EmptyText(ZanIDE.T("No watches yet.",
            "还没有监视表达式。"));
        this.WatchGrid.OnSelect(DebugPanel.WatchRowPicked);
        List<ListColumn<DbgFrame>> fcols = new List<ListColumn<DbgFrame>>();
        fcols.Add(new ListColumn<DbgFrame>(ZanIDE.T("Call Stack", "调用栈"),
            f => f.name + " : line " + Convert.ToString(f.line)));
        this.Stack.WithColumns(fcols);
        this.WatchIn.SetProp("placeholder", ZanIDE.T(
            "Type an expression and press Enter; click a row to remove it",
            "输入表达式后回车添加；点击行删除"));
        this.WatchIn.Submit.Add(DebugPanel.WatchSubmitted);
    }

    /// 变量 / 监视共用的「名称 / 类型 / 值」三列。
    static List<ListColumn<DbgVar>> VarColumns() {
        List<ListColumn<DbgVar>> cols = new List<ListColumn<DbgVar>>();
        cols.Add(new ListColumn<DbgVar>(ZanIDE.T("Name", "名称"), 2,
            v => v.name));
        cols.Add(new ListColumn<DbgVar>(ZanIDE.T("Type", "类型"), 2,
            v => v.type));
        cols.Add(new ListColumn<DbgVar>(ZanIDE.T("Value", "值"), 3,
            v => v.val));
        return cols;
    }

    /// 控制台的滚动 / 选择状态（外壳在新一轮运行前 Reset）。
    LogState ConsoleState() { return this.Console.State(); }

    /// 画面板：绑定这一帧的数据，选中的页签决定哪一块可见。
    void Render(App app, Rect area, SignalInt panelTab, List<string> console,
            List<DbgVar> vars, List<DbgVar> watchRows, List<DbgFrame> stack) {
        this.SyncTabs(panelTab.Get());
        int tab = panelTab.Get();
        this.Console.SetShown(tab == 0);
        this.Vars.SetShown(tab == 1);
        this.WatchPane.SetShown(tab == 2);
        this.Stack.SetShown(tab == 3);
        if (tab == 0) {
            this.Console.Bind(console);
            this.Console.WithColors(
                OutputPanel.ConsoleColors(app, console));
        } else if (tab == 1) {
            this.Vars.Bind(vars);
        } else if (tab == 2) {
            this.WatchGrid.Bind(watchRows);
        } else if (tab == 3) {
            this.Stack.Bind(stack);
        }
        this.RenderInside(app, area);
        // 页签在绘制时处理点击，所以选择在这里回读。
        int chg = this.TabBar.TakeChanged();
        if (chg >= 0) { panelTab.Set(chg); }
    }

    /// 页签标签跟着界面语言走；只有真的变了才重建那条页签条。
    void SyncTabs(int tab) {
        List<string> labels = new List<string>{
            ZanIDE.T("Console", "控制台"), ZanIDE.T("Variables", "变量"),
            ZanIDE.T("Watch", "监视"), ZanIDE.T("CallStack", "调用栈") };
        if (DebugPanel.tabLbls == null
                || !ZanIDE.StringListsEqual(DebugPanel.tabLbls, labels)) {
            this.TabBar.Clear();
            for (int i = 0; i < labels.Count; i = i + 1) {
                this.TabBar.Add(labels[i], false);
            }
            DebugPanel.tabLbls = labels;
        }
        this.TabBar.Select(tab);
        this.TabBar.TakeChanged();
    }

    /// 监视框里回车：外壳把它加进监视表并重新求值。
    static void WatchSubmitted() {
        DebugPanel dp = DebugPanel.current;
        if (dp == null) { return; }
        Input box = dp.WatchIn;
        if (box.GetText().Length == 0) { return; }
        DebugPanel.watchAdd = box.GetText();
        box.SetText("");
    }

    /// 点一行监视就是删掉那个表达式，所以选择只是一次手势，随即清掉。
    static void WatchRowPicked() {
        DebugPanel dp = DebugPanel.current;
        if (dp == null) { return; }
        ListView<DbgVar> rows = dp.WatchGrid;
        if (rows == null || !rows.HasSelection()) { return; }
        DebugPanel.watchDrop = rows.SelectedIndex();
        rows.ClearSelection();
    }

    /// 用户自上次调用以来提交的表达式，没有则为 ""。
    static string TakeWatchAdd() {
        string s = DebugPanel.watchAdd;
        DebugPanel.watchAdd = "";
        return s;
    }

    /// 用户自上次调用以来点掉的监视行，没有则为 -1。
    static int TakeWatchDrop() {
        int i = DebugPanel.watchDrop;
        DebugPanel.watchDrop = 0 - 1;
        return i;
    }
}
