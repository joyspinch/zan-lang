using System;
using Gui;
using Gui.Widget;

public class UsageStatRow : Control {
    static Control Of(UsageStat s) { return new UsageStatRow(s); }

    UsageStatRow(UsageStat s) {
        this.InitControl("usageStat", 1);
        Class = "usage-row";
        Label name = new Label(s.label);
        name.Class = "small secondary";
        name.dock = 3;
        this.Add(name);
        Label val = new Label(s.value);
        val.Class = "small";
        if (s.tone != "") { val.Class = "small " + s.tone; }
        val.dock = 4;
        this.Add(val);
    }

    override string Kind() { return "UsageStatRow"; }

    override string StyleType() { return "listrow"; }

    override void OnMeasure(App app) {
        prefH = app.theme.heightSmall;
    }
}
