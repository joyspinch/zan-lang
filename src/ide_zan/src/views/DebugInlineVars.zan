using System;
using Gui;
using Gui.Widget;

/// 单步时浮在编辑器右上角的行内变量条：`i = 3  |  n = 10`。
///
/// 结构在 `views/DebugInlineVars.zform` 里声明（一个自量宽的 Tag 徽章），
/// 这里只把这一帧的变量拼成文本，并按测量出的首选尺寸贴到编辑器右上角。
partial class DebugInlineVars {
    void OnInit() { this.SetShown(false); }

    /// 首选尺寸就是徽章的尺寸：覆盖层不占布局，自己贴位置。
    override void OnMeasure(App app) {
        prefW = DebugInlineVars.Chip.prefW;
        prefH = DebugInlineVars.Chip.prefH;
    }

    /// 把变量画到编辑器区域的右上角；没有变量时什么都不画。
    void Render(App app, Rect edRect, List<DbgVar> varInfo) {
        if (varInfo == null || varInfo.Count == 0) { return; }
        string text = "";
        for (int i = 0; i < varInfo.Count; i = i + 1) {
            DbgVar entry = varInfo[i];
            if (text.Length > 0) { text = text + "  |  "; }
            text = text + entry.name + " = " + entry.val;
        }
        if (text.Length == 0) { return; }
        this.SetShown(true);
        DebugInlineVars.Chip.Text = text;
        this.MeasureTree(app);
        int gap = app.theme.paddingSmall;
        int w = prefW;
        int h = prefH;
        this.Arrange(edRect.x + edRect.width - w - gap, edRect.y + gap, w, h);
        this.RenderTree(app);
    }
}
