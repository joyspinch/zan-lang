using System;
using System.Collections.Generic;
using System.IO;
using System.Json;
using Gui;

public class DocsData {
    static List<DocEntry> cache;
    static List<DocSectionDef> sections;
    static List<DocCategoryDef> categories;
    static string loadError;
    static int version;

    static string EmbedName() { return "docs/topics.json"; }

    static List<string> DiskPaths() {
        List<string> paths = new List<string>();
        paths.Add(ZanIDE.ExeDir() + "/docs/topics.json");
        paths.Add(ZanIDE.BaseDir() + "/docs/topics.json");
        paths.Add(ZanIDE.BaseDir() + "/../src/ide_zan/assets/docs/topics.json");
        return paths;
    }

    static string ReadDocument() {
        List<string> paths = DocsData.DiskPaths();
        for (int i = 0; i < paths.Count; i = i + 1) {
            if (File.Exists(paths[i])) { return File.ReadAllText(paths[i]); }
        }
        return Skin.EmbedRead(DocsData.EmbedName());
    }

    static int Version() {
        DocsData.All();
        return DocsData.version;
    }

    static void Reload() {
        DocsData.cache = null;
        DocsData.sections = null;
        DocsData.categories = null;
    }

    static List<DocEntry> All() {
        if (DocsData.cache != null) { return DocsData.cache; }
        DocsData.cache = new List<DocEntry>();
        DocsData.sections = new List<DocSectionDef>();
        DocsData.categories = new List<DocCategoryDef>();
        DocsData.version = DocsData.version + 1;
        DocsData.loadError = "";
        string text = DocsData.ReadDocument();
        if (text == "") {
            DocsData.loadError = "docs/topics.json not found";
            return DocsData.cache;
        }
        JsonDoc.ParseScoped(text, (JsonDoc doc) => {
            if (doc.KindAt(0) != 5) {
                DocsData.loadError = "docs/topics.json is not valid JSON";
                return;
            }
            DocsData.ParseSections(doc, doc.Get(0, "sections"));
            DocsData.ParseCategories(doc, doc.Get(0, "categories"));
            DocsData.ParseTopics(doc, doc.Get(0, "topics"));
        });
        return DocsData.cache;
    }

    static void ParseSections(JsonDoc doc, int arr) {
        if (arr < 0 || doc.KindAt(arr) != 4) { return; }
        int s = doc.FirstChild(arr);
        while (s >= 0) {
            if (doc.KindAt(s) == 5) {
                DocSectionDef def = new DocSectionDef();
                def.en = doc.Str(s, "en", "");
                def.zh = doc.Str(s, "zh", def.en);
                def.cats = new List<string>();
                int cats = doc.Get(s, "cats");
                if (cats >= 0 && doc.KindAt(cats) == 4) {
                    int c = doc.FirstChild(cats);
                    while (c >= 0) {
                        def.cats.Add(doc.StrAt(c, ""));
                        c = doc.NextSibling(c);
                    }
                }
                DocsData.sections.Add(def);
            }
            s = doc.NextSibling(s);
        }
    }

    static void ParseCategories(JsonDoc doc, int arr) {
        if (arr < 0 || doc.KindAt(arr) != 4) { return; }
        int c = doc.FirstChild(arr);
        while (c >= 0) {
            if (doc.KindAt(c) == 5) {
                DocCategoryDef def = new DocCategoryDef();
                def.en = doc.Str(c, "en", "");
                def.imports = DocsData.Strings(doc, doc.Get(c, "imports"));
                DocsData.categories.Add(def);
            }
            c = doc.NextSibling(c);
        }
    }

    static List<string> Strings(JsonDoc doc, int arr) {
        if (arr < 0 || doc.KindAt(arr) != 4) { return null; }
        List<string> lines = new List<string>();
        int it = doc.FirstChild(arr);
        while (it >= 0) {
            lines.Add(doc.StrAt(it, ""));
            it = doc.NextSibling(it);
        }
        return lines;
    }

    static List<string> ImportsFor(JsonDoc doc, int topic, string catEn) {
        List<string> own = DocsData.Strings(doc, doc.Get(topic, "imports"));
        if (own != null) { return own; }
        for (int i = 0; i < DocsData.categories.Count; i = i + 1) {
            if (DocsData.categories[i].en == catEn) {
                return DocsData.categories[i].imports;
            }
        }
        return null;
    }

    static void ParseTopics(JsonDoc doc, int arr) {
        if (arr < 0 || doc.KindAt(arr) != 4) { return; }
        int t = doc.FirstChild(arr);
        while (t >= 0) {
            if (doc.KindAt(t) == 5) {
                string catEn = DocsData.Text(doc, t, "cat", "en");
                DocsData.cache.Add(DocEntry.Of(
                    catEn, DocsData.Text(doc, t, "cat", "zh"),
                    DocsData.Text(doc, t, "title", "en"), DocsData.Text(doc, t, "title", "zh"),
                    DocsData.Text(doc, t, "body", "en"), DocsData.Text(doc, t, "body", "zh"),
                    doc.Str(t, "code", ""), DocsData.ImportsFor(doc, t, catEn),
                    doc.Str(t, "preview", "")));
            }
            t = doc.NextSibling(t);
        }
    }

    static string Text(JsonDoc doc, int topic, string field, string lang) {
        int pair = doc.Get(topic, field);
        if (pair < 0) { return ""; }
        string value = doc.Str(pair, lang, "");
        if (value == "") { value = doc.Str(pair, "en", ""); }
        return value;
    }

    static List<DocSectionDef> Sections() {
        DocsData.All();
        return DocsData.sections;
    }

    static int SectionOf(string catEn) {
        List<DocSectionDef> defs = DocsData.Sections();
        for (int i = 0; i < defs.Count; i = i + 1) {
            if (defs[i].Holds(catEn)) { return i; }
        }
        return 0;
    }

    static int SectionCount() { return DocsData.Sections().Count; }

    static string SectionName(int i) {
        List<DocSectionDef> defs = DocsData.Sections();
        if (i < 0 || i >= defs.Count) { return ""; }
        return ZanIDE.T(defs[i].en, defs[i].zh);
    }
}
