using System;
using System.IO;
using System.Json;
using Gui;

/// One documentation entry, both languages side by side. Entries are data now
/// (`assets/docs/topics.json`), so adding a topic to the Help page is a JSON
/// edit -- no rebuild, and no 1000-line source file of string literals.
class DocEntry {
    string catEn;
    string catZh;
    string titleEn;
    string titleZh;
    string bodyEn;
    string bodyZh;
    string code;

    static DocEntry Of(string catEn, string catZh, string titleEn, string titleZh,
                       string bodyEn, string bodyZh, string code) {
        DocEntry d = new DocEntry();
        d.catEn = catEn;
        d.catZh = catZh;
        d.titleEn = titleEn;
        d.titleZh = titleZh;
        d.bodyEn = bodyEn;
        d.bodyZh = bodyZh;
        d.code = code;
        return d;
    }

    string Cat() { return ZanIDE.T(catEn, catZh); }
    /// The language-independent category, used to group entries into sections.
    string CatEn() { return catEn; }
    string Title() { return ZanIDE.T(titleEn, titleZh); }
    string Body() { return ZanIDE.T(bodyEn, bodyZh); }

    /// The sample, with the GUI imports prepended for widget entries so every
    /// widget snippet compiles as shown.
    string Code() {
        if (catEn == "GUI - Widgets" && !ZanIDE.Has(code, "using Gui;")) {
            return "using System;\nusing Gui;\nusing Gui.Widget;\n\n" + code;
        }
        return code;
    }
}

/// One section tab of the Help page and the categories it collects.
class DocSectionDef {
    string en;
    string zh;
    List<string> cats;

    bool Holds(string catEn) {
        for (int i = 0; i < cats.Count; i = i + 1) {
            if (cats[i] == catEn) { return true; }
        }
        return false;
    }
}

/// The Help page's content, loaded from `docs/topics.json`.
///
/// The document is looked up on disk first (the working copy inside the repo,
/// so editing documentation and pressing reload is enough during development)
/// and falls back to the copy baked into the executable, which is what ships.
/// Nothing here knows about layout: the order of the topic list is the order of
/// the tree, and `sections` maps categories onto the section tabs.
class DocsData {
    static List<DocEntry> cache;
    static List<DocSectionDef> sections;
    /// Empty while the document loaded; otherwise why it did not.
    static string loadError;

    /// The name the document is baked under, and the paths it is looked for on
    /// disk (exe folder first, then the repo working copy).
    static string EmbedName() { return "docs/topics.json"; }

    static List<string> DiskPaths() {
        List<string> paths = new List<string>();
        paths.Add(ZanIDE.ExeDir() + "/docs/topics.json");
        paths.Add(ZanIDE.BaseDir() + "/docs/topics.json");
        paths.Add(ZanIDE.BaseDir() + "/../src/ide_zan/assets/docs/topics.json");
        return paths;
    }

    static string ReadDocument() {
        List<string> paths = DocsData.DiskPaths();
        for (int i = 0; i < paths.Count; i = i + 1) {
            if (File.Exists(paths[i])) { return File.ReadAllText(paths[i]); }
        }
        // Skin owns the zan_embed_* bindings; the resources are one registry.
        return Skin.EmbedRead(DocsData.EmbedName());
    }

    /// Forgets the parsed document so the next read picks up an edited file.
    static void Reload() {
        DocsData.cache = null;
        DocsData.sections = null;
    }

    /// Every documentation entry, parsed once per process (or after `Reload`).
    static List<DocEntry> All() {
        if (DocsData.cache != null) { return DocsData.cache; }
        DocsData.cache = new List<DocEntry>();
        DocsData.sections = new List<DocSectionDef>();
        DocsData.loadError = "";
        string text = DocsData.ReadDocument();
        if (text == "") {
            DocsData.loadError = "docs/topics.json not found";
            return DocsData.cache;
        }
        JsonValue doc = JsonValue.ParseLenient(text);
        if (doc == null || !doc.IsObject()) {
            DocsData.loadError = "docs/topics.json is not valid JSON";
            return DocsData.cache;
        }
        DocsData.ParseSections(doc.Get("sections"));
        DocsData.ParseTopics(doc.Get("topics"));
        return DocsData.cache;
    }

    static void ParseSections(JsonValue arr) {
        if (arr == null || !arr.IsArray()) { return; }
        for (int i = 0; i < arr.Count(); i = i + 1) {
            JsonValue s = arr.At(i);
            DocSectionDef def = new DocSectionDef();
            def.en = s.Str("en", "");
            def.zh = s.Str("zh", def.en);
            def.cats = new List<string>();
            JsonValue cats = s.Get("cats");
            if (cats != null && cats.IsArray()) {
                for (int c = 0; c < cats.Count(); c = c + 1) {
                    def.cats.Add(cats.At(c).AsString(""));
                }
            }
            DocsData.sections.Add(def);
        }
    }

    static void ParseTopics(JsonValue arr) {
        if (arr == null || !arr.IsArray()) { return; }
        for (int i = 0; i < arr.Count(); i = i + 1) {
            JsonValue t = arr.At(i);
            DocsData.cache.Add(DocEntry.Of(
                DocsData.Text(t, "cat", "en"), DocsData.Text(t, "cat", "zh"),
                DocsData.Text(t, "title", "en"), DocsData.Text(t, "title", "zh"),
                DocsData.Text(t, "body", "en"), DocsData.Text(t, "body", "zh"),
                t.Str("code", "")));
        }
    }

    /// `{ "field": { "en": ..., "zh": ... } }`, falling back to English when a
    /// translation is missing, so a half-translated topic still reads.
    static string Text(JsonValue topic, string field, string lang) {
        JsonValue pair = topic.Get(field);
        if (pair == null) { return ""; }
        string value = pair.Str(lang, "");
        if (value == "") { value = pair.Str("en", ""); }
        return value;
    }

    static List<DocSectionDef> Sections() {
        DocsData.All();
        return DocsData.sections;
    }

    /// Which section tab a category belongs to (0 when it names none).
    static int SectionOf(string catEn) {
        List<DocSectionDef> defs = DocsData.Sections();
        for (int i = 0; i < defs.Count; i = i + 1) {
            if (defs[i].Holds(catEn)) { return i; }
        }
        return 0;
    }

    static int SectionCount() { return DocsData.Sections().Count; }

    /// Display name of a section, in the UI language.
    static string SectionName(int i) {
        List<DocSectionDef> defs = DocsData.Sections();
        if (i < 0 || i >= defs.Count) { return ""; }
        return ZanIDE.T(defs[i].en, defs[i].zh);
    }
}
