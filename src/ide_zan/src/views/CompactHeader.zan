using System;
using System.IO;
using System.Collections.Generic;
using Gui;
using Gui.Widget;

// 极简 Agent 优先紧凑顶部工具条（高度 34px）
// 完全由标准库组件 (Panel, Button, Label) 组装，禁止任何自绘
public class CompactHeader : Control {
    static CompactHeader current;
    public static CompactHeader Current() { return current; }

    Label projectLabel;
    Button runBtn;
    Button dbgBtn;
    Button hotBtn;
    Button pubBtn;
    Button palBtn;
    Button agentBtn;
    Button ribbonBtn;

    int pendingAction; // 4=run, 7=debug, 11=hot, 6=pub, 10=palette, 19=agent, 99=toggleRibbon

    static string T(string en, string zh) {
        return Lang.Tr(en, zh);
    }

    public CompactHeader() {
        this.InitControl("compactHeader", 1);
        this.Class = "compact-header-host";
        CompactHeader.current = this;
        this.pendingAction = 0;

        Panel bar = Panel.Row();
        bar.Class = "compact-bar bar align-center grow";

        projectLabel = new Label("[zan-lang]");
        projectLabel.Class = "compact-proj-label bold secondary";

        runBtn = new Button("▶ " + CompactHeader.T("Run", "运行"));
        runBtn.Class = "success small";
        runBtn.Click += () => {
            if (CompactHeader.current != null) { CompactHeader.current.pendingAction = 4; }
        };

        dbgBtn = new Button("🐛 " + CompactHeader.T("Debug", "调试"));
        dbgBtn.Class = "info small";
        dbgBtn.Click += () => {
            if (CompactHeader.current != null) { CompactHeader.current.pendingAction = 7; }
        };

        hotBtn = new Button("⚡ " + CompactHeader.T("Hot", "热重载"));
        hotBtn.Class = "warning small";
        hotBtn.Click += () => {
            if (CompactHeader.current != null) { CompactHeader.current.pendingAction = 11; }
        };

        pubBtn = new Button("📦 " + CompactHeader.T("Publish", "发布"));
        pubBtn.Class = "small";
        pubBtn.Click += () => {
            if (CompactHeader.current != null) { CompactHeader.current.pendingAction = 6; }
        };

        Panel spacer1 = new Panel("spacer1");
        spacer1.Class = "grow";

        palBtn = new Button("🔍 " + CompactHeader.T("Search / Agent Intent (Ctrl+K)...", "搜索命令或输入意图 (Ctrl+K)..."));
        palBtn.Class = "compact-pal-btn secondary monospace small";
        palBtn.Click += () => {
            if (CompactHeader.current != null) { CompactHeader.current.pendingAction = 10; }
        };

        Panel spacer2 = new Panel("spacer2");
        spacer2.Class = "grow";

        agentBtn = new Button("🤖 " + CompactHeader.T("Agent (Ctrl+Shift+A)", "智能体 (Ctrl+Shift+A)"));
        agentBtn.Class = "primary small";
        agentBtn.Click += () => {
            if (CompactHeader.current != null) { CompactHeader.current.pendingAction = 19; }
        };

        ribbonBtn = new Button("📜 " + CompactHeader.T("Ribbon", "功能区"));
        ribbonBtn.Class = "ghost small";
        ribbonBtn.Click += () => {
            if (CompactHeader.current != null) { CompactHeader.current.pendingAction = 99; }
        };

        bar.Add(projectLabel);
        bar.Add(runBtn);
        bar.Add(dbgBtn);
        bar.Add(hotBtn);
        bar.Add(pubBtn);
        bar.Add(spacer1);
        bar.Add(palBtn);
        bar.Add(spacer2);
        bar.Add(agentBtn);
        bar.Add(ribbonBtn);

        this.Add(bar);
    }

    public void SyncState(string projName, bool canRun, bool haveProj, bool agentOn) {
        if (projectLabel != null) {
            projectLabel.Text = "[" + (projName != "" ? projName : CompactHeader.T("No Project", "未打开工程")) + "]";
        }
        if (runBtn != null) {
            runBtn.Class = canRun ? "success small" : "small disabled";
        }
        if (dbgBtn != null) {
            dbgBtn.Class = canRun ? "info small" : "small disabled";
        }
        if (hotBtn != null) {
            hotBtn.Class = haveProj ? "warning small" : "small disabled";
        }
        if (pubBtn != null) {
            pubBtn.Class = canRun ? "small" : "small disabled";
        }
        if (agentBtn != null) {
            agentBtn.Class = agentOn ? "primary small bold" : "secondary small";
        }
    }

    public int TakeAction() {
        int a = this.pendingAction;
        this.pendingAction = 0;
        return a;
    }
}
