using Gui;

/// Full-window canvas control: the IDE paints itself (immediate mode) inside
/// the standard retained tree, so `Form.Run()` owns BeginFrame/PresentFrame
/// and the shell's PaintFrame draws the ribbon / editors / panels onto the
/// canvas of the current frame.
class IdeSurface : Control {
    override void OnPaint(App app) {
        if (ZanIDE.current != null) {
            ZanIDE.current.PaintFrame(app);
        }
    }
}
