using Gui;

[GuiKind("IdeSurface")]
public class IdeSurface : Control {
    public override Control CreateCloneShell() { return new IdeSurface(); }

    public IdeSurface() {
        this.InitControl("shell");
        this.Pad(0);
        this.gap = 0;
    }

    override string StyleType() { return "window"; }
    override bool ChildControlsRenderedByOwner() { return true; }

    override void Arrange(int x, int y, int w, int h) {
        bx = x; by = y; bw = w; bh = h;
        if (ZanIDE.current != null && this.App != null) { ZanIDE.current.PrepareShellControls(this.App); }
    }

    override void OnPaint(App app) {
        if (ZanIDE.current != null) {
            ZanIDE.current.PaintFrame(app);
        }
    }
}
