using Gui;

public class IdeSurface : Control {

    // 组件自注册（B-ID44 约定）：注册表由 gen_design_halves.py 扫描
    // 文档引用自动生成，这里声明自己的工厂；重复注册以最后一次为准。
    public static void Install() {
        Gui.HeavyControls.Register("IdeSurface", (string k) => new IdeSurface());
    }

    IdeSurface() {
        this.InitControl("shell", 5);
        this.Pad(0);
        this.gap = 0;
    }

    override string StyleType() { return "window"; }

    override void OnPaint(App app) {
        if (ZanIDE.current != null) {
            ZanIDE.current.PaintFrame(app);
        }
    }
}
