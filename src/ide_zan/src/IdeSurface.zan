using Gui;

/// Full-window canvas control: the IDE paints itself (immediate mode) inside
/// the standard retained tree, so `Form.Run()` owns BeginFrame/PresentFrame
/// and the shell's PaintFrame draws the ribbon / editors / panels onto the
/// canvas of the current frame.
class IdeSurface : Control {
    /// The designed `.zform` builds it with the field name, so the base
    /// control state (docking, visibility, padding) has to be initialised
    /// here: an uninitialised Control is invisible and never gets painted.
    IdeSurface() {
        this.InitControl("shell", 5);
        this.Pad(0);
        this.gap = 0;
    }

    /// The client area itself, not a card on it. Without this the shell is an
    /// unknown control type, which resolves to the neutral surface look, and
    /// the IDE pays for a window-sized rounded fill plus its shadow on every
    /// single frame.
    override string StyleType() { return "window"; }

    override void OnPaint(App app) {
        if (ZanIDE.current != null) {
            ZanIDE.current.PaintFrame(app);
        }
    }
}
