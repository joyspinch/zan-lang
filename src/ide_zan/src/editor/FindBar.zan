using System;
using System.Text.RegularExpressions;
using Gui;
using Gui.Widget;
using Gui.Component.CodeEditor;

/// One occurrence of the find bar's query in the buffer: a single-line range.
class FindHit {
    int line;
    int col;
    int len;

    static FindHit Create(int line, int col, int len) {
        FindHit h = new FindHit();
        h.line = line;
        h.col = col;
        h.len = len;
        return h;
    }
}

/// Visual-Studio-style Find / Replace bar for the code editor.
///
/// 界面在 `FindBar.zform` 里声明：查找行（折叠箭头、查询框、Aa/ab/.*
/// 三个选项、计数、上一个 / 下一个 / 关闭）、替换行（替换框 + 替换 /
/// 全部替换）和一行正则错误说明，三行装在一个 `findbar` 表面里由布局
/// 排版——所以这个浮条不再手算任何一个按钮的坐标，只决定自己贴在编
/// 辑器的哪个角，高度由测量出来的行高给出。
///
///     Ctrl+F   opens it on the query row (seeded with the selection)
///     Ctrl+R   opens it with the replace row expanded
///     v / ^    collapses / expands the replace row
///     Aa ab .* toggle match case, whole word, regular expression
///     Enter    next match (Shift+Enter previous), Escape closes
///
/// Cost control: the match set is computed once per (query, options, buffer)
/// combination and reused for the counter, the navigation and Replace All, so
/// typing does not rescan the document per frame. A scan stops at `maxHits`
/// occurrences, and a document longer than `liveLimit` lines is only scanned
/// when the user actually asks (Enter / a button), never per keystroke. An
/// invalid regular expression is reported in the bar (Regex.Validate, no
/// throw) and simply matches nothing.
partial class FindBar {
    /// Replace row shown (Ctrl+R / the chevron).
    bool expanded;
    bool matchCase;
    bool wholeWord;
    bool useRegex;
    /// Why the pattern cannot be used ("" when it is fine).
    string err;
    /// Cached match set and the (query, options, buffer) it was built for.
    List<FindHit> hits;
    string cacheQuery;
    int cacheOpts;
    int cacheStamp;
    bool cacheValid;
    /// Index into `hits` of the occurrence the editor is showing, or -1.
    int sel;
    /// True until the frame that hands the keyboard to the query field.
    bool focusPending;
    /// Set for one frame when the bar wants the host to close it.
    bool closeReq;
    /// Largest match set collected in one scan.
    int maxHits;
    /// Documents longer than this are not scanned on every keystroke.
    int liveLimit;

    void OnInit() {
        FindBar.QueryIn.SetProp("placeholder", ZanIDE.T("Find", "查找"));
        FindBar.ReplIn.SetProp("placeholder",
            ZanIDE.T("Replace with", "替换为"));
        FindBar.CaseBtn.Tip = ZanIDE.T("Match case", "区分大小写");
        FindBar.WordBtn.Tip = ZanIDE.T("Match whole word", "全字匹配");
        FindBar.RegexBtn.Tip =
            ZanIDE.T("Use regular expressions", "使用正则表达式");
        FindBar.PrevBtn.Tip =
            ZanIDE.T("Previous match (Shift+Enter)", "上一个匹配 (Shift+Enter)");
        FindBar.NextBtn.Tip = ZanIDE.T("Next match (Enter)", "下一个匹配 (Enter)");
        FindBar.CloseBtn.Tip = ZanIDE.T("Close (Esc)", "关闭 (Esc)");
        FindBar.ReplBtn.Text = ZanIDE.T("Replace", "替换");
        FindBar.ReplAllBtn.Text = ZanIDE.T("All", "全部");
        expanded = false;
        matchCase = false;
        wholeWord = false;
        useRegex = false;
        err = "";
        hits = new List<FindHit>();
        cacheQuery = "";
        cacheOpts = 0 - 1;
        cacheStamp = 0 - 1;
        cacheValid = false;
        sel = 0 - 1;
        focusPending = false;
        closeReq = false;
        maxHits = 5000;
        liveLimit = 20000;
    }

    static FindBar Create() { return new FindBar(); }

    /// 浮条不参与宿主布局，自己贴在编辑器角上：首选高度就是这一帧
    /// 可见的那几行加上表面的内边距。
    override void OnMeasure(App app) {
        prefH = FindBar.Rows.prefH + FindBar.Surface.padT
            + FindBar.Surface.padB;
    }

    /// Opens (or re-focuses) the bar. `seed` replaces the query when it is not
    /// empty -- the editor's selection or the word at the caret, as in VS.
    void Open(bool replace, string seed) {
        if (replace) { expanded = true; }
        if (seed.Length > 0) { FindBar.QueryIn.SetText(seed); }
        focusPending = true;
        closeReq = false;
        cacheValid = false;
    }

    /// True for the frame the bar asked to be dismissed (the X button).
    bool CloseRequested() { return closeReq; }
    void ClearCloseRequest() { closeReq = false; }

    string Query() { return FindBar.QueryIn.GetText(); }

    int OptBits() {
        int b = 0;
        if (matchCase) { b = b + 1; }
        if (wholeWord) { b = b + 2; }
        if (useRegex) { b = b + 4; }
        return b;
    }

    /// ASCII case fold. Search is byte-based, so folding only the 26 Latin
    /// letters leaves every multi-byte sequence untouched (and comparable).
    static string LowerAscii(string s) {
        string up = "ABCDEFGHIJKLMNOPQRSTUVWXYZ";
        string lo = "abcdefghijklmnopqrstuvwxyz";
        string o = "";
        for (int i = 0; i < s.Length; i = i + 1) {
            string ch = s.Substring(i, 1);
            int p = up.IndexOf(ch);
            if (p >= 0) { o = o + lo.Substring(p, 1); }
            else { o = o + ch; }
        }
        return o;
    }

    /// True when [col, col+len) in `s` is not glued to an identifier character
    /// on either side (the "match whole word" rule).
    static bool WordEdges(string s, int col, int len) {
        if (col > 0 && CodeEditor.IsIdentChar(s.Substring(col - 1, 1))) {
            return false;
        }
        int end = col + len;
        if (end < s.Length && CodeEditor.IsIdentChar(s.Substring(end, 1))) {
            return false;
        }
        return true;
    }

    /// Rebuilds `hits` when the query, the options or the buffer changed.
    /// `onDemand` is true when the user asked for a search (Enter / a button):
    /// only then is a very large document scanned, so plain typing in a huge
    /// file never costs a full pass per keystroke.
    void EnsureHits(CodeEditor ed, bool onDemand) {
        string q = FindBar.QueryIn.GetText();
        int opts = OptBits();
        int stamp = ed.TextStamp();
        if (cacheValid && cacheQuery == q && cacheOpts == opts
            && cacheStamp == stamp) {
            return;
        }
        if (q.Length == 0) {
            hits = new List<FindHit>();
            sel = 0 - 1;
            err = "";
            cacheQuery = q;
            cacheOpts = opts;
            cacheStamp = stamp;
            cacheValid = true;
            return;
        }
        if (!onDemand && ed.LineCount() > liveLimit) {
            // Leave the previous result in place; the counter shows it is stale
            // by simply not changing until the user presses Enter.
            return;
        }
        hits = new List<FindHit>();
        err = "";
        if (useRegex) {
            string why = Regex.Validate(q);
            if (why.Length > 0) {
                err = why;
                sel = 0 - 1;
                cacheQuery = q;
                cacheOpts = opts;
                cacheStamp = stamp;
                cacheValid = true;
                return;
            }
            ScanRegex(ed, q);
        } else {
            ScanPlain(ed, q);
        }
        cacheQuery = q;
        cacheOpts = opts;
        cacheStamp = stamp;
        cacheValid = true;
        if (sel >= hits.Count) { sel = hits.Count - 1; }
    }

    void ScanPlain(CodeEditor ed, string q) {
        string needle = q;
        if (!matchCase) { needle = FindBar.LowerAscii(q); }
        int n = ed.LineCount();
        for (int ln = 0; ln < n && hits.Count < maxHits; ln = ln + 1) {
            string raw = ed.LineAt(ln);
            string hay = raw;
            if (!matchCase) { hay = FindBar.LowerAscii(raw); }
            int at = 0;
            while (at <= hay.Length - needle.Length) {
                int p = CodeEditor.FindFrom(hay, needle, at);
                if (p < 0) { break; }
                if (!wholeWord || FindBar.WordEdges(raw, p, needle.Length)) {
                    hits.Add(FindHit.Create(ln, p, needle.Length));
                    if (hits.Count >= maxHits) { break; }
                }
                at = p + 1;
            }
        }
    }

    void ScanRegex(CodeEditor ed, string q) {
        // Compiled once for the whole scan; the pattern was validated above so
        // this cannot throw.
        Regex re = Regex.CompileOptions(q, !matchCase);
        int n = ed.LineCount();
        for (int ln = 0; ln < n && hits.Count < maxHits; ln = ln + 1) {
            string raw = ed.LineAt(ln);
            int at = 0;
            while (at <= raw.Length) {
                Match m = re.FindFrom(raw, at);
                if (!m.Success()) { break; }
                int mi = m.Index();
                int mlen = m.Length();
                if (mlen > 0 && (!wholeWord || FindBar.WordEdges(raw, mi, mlen))) {
                    hits.Add(FindHit.Create(ln, mi, mlen));
                    if (hits.Count >= maxHits) { break; }
                }
                // An empty match would spin here forever: always advance.
                if (mlen == 0) { at = mi + 1; } else { at = mi + mlen; }
            }
        }
        re = null;
    }

    /// Index of the first hit at or after (line, col), or -1.
    int IndexAtOrAfter(int line, int col) {
        for (int i = 0; i < hits.Count; i = i + 1) {
            FindHit h = hits[i];
            if (h.line > line || (h.line == line && h.col >= col)) { return i; }
        }
        return 0 - 1;
    }

    void ShowHit(CodeEditor ed, int idx) {
        if (idx < 0 || idx >= hits.Count) { return; }
        sel = idx;
        FindHit h = hits[idx];
        ed.SelectRange(h.line, h.col, h.line, h.col + h.len);
    }

    /// Moves to the next (`dir` = 1) or previous (`dir` = -1) occurrence,
    /// wrapping at the ends like VS does.
    void Step(CodeEditor ed, int dir) {
        EnsureHits(ed, true);
        if (hits.Count == 0) { return; }
        int idx = sel;
        if (idx < 0) {
            idx = IndexAtOrAfter(ed.CurLine(), ed.CurCol());
            if (idx < 0) { idx = 0; }
            if (dir < 0) { idx = idx - 1; }
        } else {
            idx = idx + dir;
        }
        if (idx < 0) { idx = hits.Count - 1; }
        if (idx >= hits.Count) { idx = 0; }
        ShowHit(ed, idx);
    }

    /// The text `hits[idx]` is replaced with: the replace field as typed, or
    /// with `$1`-style group references expanded in regular-expression mode.
    string ReplacementFor(CodeEditor ed, int idx) {
        string rep = FindBar.ReplIn.GetText();
        if (!useRegex) { return rep; }
        string q = FindBar.QueryIn.GetText();
        if (q.Length == 0 || Regex.Validate(q).Length > 0) { return rep; }
        FindHit h = hits[idx];
        Regex re = Regex.CompileOptions(q, !matchCase);
        Match m = re.FindFrom(ed.LineAt(h.line), h.col);
        string expanded = re.Expand(rep, m);
        re = null;
        if (!m.Success() || m.Index() != h.col) { return rep; }
        return expanded;
    }

    /// Replaces the shown occurrence (or the next one when none is shown) and
    /// moves to the following one, as VS's Replace button does.
    void ReplaceOne(CodeEditor ed) {
        EnsureHits(ed, true);
        if (hits.Count == 0) { return; }
        if (sel < 0 || sel >= hits.Count) {
            Step(ed, 1);
            return;
        }
        FindHit h = hits[sel];
        string rep = ReplacementFor(ed, sel);
        ed.SelectRange(h.line, h.col, h.line, h.col + h.len);
        // InsertBlock drops the selection first and snapshots undo, so one
        // Replace is one Ctrl+Z.
        ed.InsertBlock(rep);
        cacheValid = false;
        int keepLine = h.line;
        int keepCol = h.col + rep.Length;
        EnsureHits(ed, true);
        int nxt = IndexAtOrAfter(keepLine, keepCol);
        if (nxt < 0) { nxt = 0; }
        sel = 0 - 1;
        if (hits.Count > 0) { ShowHit(ed, nxt); }
    }

    /// Replaces every occurrence in one edit (one undo step, one reload) rather
    /// than driving the editor once per hit -- a 2000-hit Replace All is a
    /// single pass over the lines instead of 2000 snapshots of the document.
    int ReplaceAll(CodeEditor ed) {
        EnsureHits(ed, true);
        if (hits.Count == 0) { return 0; }
        int done = 0;
        List<string> outLines = new List<string>();
        int n = ed.LineCount();
        int hi = 0;
        for (int ln = 0; ln < n; ln = ln + 1) {
            string raw = ed.LineAt(ln);
            // The hits of this line, in order: rebuild the line around them.
            string built = "";
            int at = 0;
            while (hi < hits.Count && hits[hi].line == ln) {
                FindHit h = hits[hi];
                if (h.col >= at && h.col + h.len <= raw.Length) {
                    built = built + raw.Substring(at, h.col - at)
                        + ReplacementFor(ed, hi);
                    at = h.col + h.len;
                    done = done + 1;
                }
                hi = hi + 1;
            }
            if (at == 0) { outLines.Add(raw); }
            else { outLines.Add(built + raw.Substring(at, raw.Length - at)); }
        }
        if (done == 0) { return 0; }
        int keep = ed.CurLine();
        int keepScroll = ed.ScrollLine();
        ed.SaveUndo();
        ed.LoadText(string.Join("\n", outLines));
        ed.GoToLine(keep);
        ed.SetScrollLine(keepScroll);
        cacheValid = false;
        sel = 0 - 1;
        return done;
    }

    /// "3/17", "No results", or the reason the pattern is unusable.
    string StatusText() {
        if (FindBar.QueryIn.GetText().Length == 0) { return ""; }
        if (err.Length > 0) { return ZanIDE.T("bad pattern", "正则无效"); }
        if (hits.Count == 0) { return ZanIDE.T("No results", "无结果"); }
        string total = Convert.ToString(hits.Count);
        if (hits.Count >= maxHits) { total = total + "+"; }
        if (sel < 0) { return total; }
        return Convert.ToString(sel + 1) + "/" + total;
    }

    /// 这一帧条上各行的可见性与文案：替换行只在展开时出现，正则错误
    /// 说明有内容才占一行，所以高度跟着测量走。
    void Sync() {
        FindBar.ExpandBtn.Icon = "chevron-down";
        if (expanded) { FindBar.ExpandBtn.Icon = "chevron-up"; }
        FindBar.ReplRow.SetShown(expanded);
        // An active option reads as pressed (the skin's `button:checked`).
        FindBar.CaseBtn.Class = FindBar.ToggleClass(matchCase);
        FindBar.WordBtn.Class = FindBar.ToggleClass(wholeWord);
        FindBar.RegexBtn.Class = FindBar.ToggleClass(useRegex);
        string status = StatusText();
        FindBar.StatusLbl.Text = status;
        FindBar.StatusLbl.SetShown(status.Length > 0);
        FindBar.StatusLbl.Class = "small hint";
        if (err.Length > 0 || hits.Count == 0) {
            FindBar.StatusLbl.Class = "small error";
        }
        // The reason a pattern is rejected gets its own line inside the panel,
        // so it can never be painted over the code below it.
        FindBar.ErrLbl.Text = ZanIDE.T("Pattern: ", "正则: ") + err;
        FindBar.ErrLbl.SetShown(err.Length > 0);
    }

    /// Draws the bar in the top-right corner of `edRect` and runs every
    /// interaction in it. Returns the height it used.
    int Render(App app, Rect edRect, CodeEditor ed) {
        Sync();
        // 测量之后高度才知道（几行、每行多高都由样式决定），浮条只
        // 决定自己贴哪个角。
        this.MeasureTree(app);
        int w = app.Scale(430);
        if (w > edRect.width - app.Scale(16)) { w = edRect.width - app.Scale(16); }
        int h = prefH;
        int x = edRect.x + edRect.width - w - app.Scale(10);
        if (x < edRect.x) { x = edRect.x; }
        int y = edRect.y + app.Scale(4);
        this.Arrange(x, y, w, h);
        // Registered before the bar's own widgets so it swallows clicks meant
        // for the editor underneath while its buttons stay live (the hit tester
        // is last-registered-wins).
        app.BlockHitsRect(x, y, w, h);
        this.RenderTree(app);

        // Opening the bar hands it the keyboard, so the first keystroke lands
        // in the query field instead of in the document.
        if (focusPending) {
            app.focus.SetFocused(FindBar.QueryIn.WidgetId());
            focusPending = false;
            app.RequestRedraw();
        }

        bool qFocused = app.focus.IsFocused(FindBar.QueryIn.WidgetId());
        bool rFocused = expanded
            && app.focus.IsFocused(FindBar.ReplIn.WidgetId());

        // Keep the counter honest while typing (cheap: cached per buffer stamp).
        EnsureHits(ed, false);

        // ---- keyboard: Enter / Shift+Enter walk the matches ----
        if (app.EventKind() == 6 && (qFocused || rFocused)) {
            int cc = app.window.EventKeyCode();
            if (cc == 13) {
                if (rFocused) { ReplaceOne(ed); }
                else if (Modifiers.HasShift(app.window.EventMods())) { Step(ed, 0 - 1); }
                else { Step(ed, 1); }
                app.RequestRedraw();
            }
        }

        // ---- buttons ----
        if (FindBar.ExpandBtn.WasClicked()) {
            expanded = !expanded;
            app.RequestRedraw();
        }
        if (FindBar.CloseBtn.WasClicked()) {
            closeReq = true;
            app.RequestRedraw();
        }
        if (FindBar.NextBtn.WasClicked()) { Step(ed, 1); app.RequestRedraw(); }
        if (FindBar.PrevBtn.WasClicked()) { Step(ed, 0 - 1); app.RequestRedraw(); }
        if (FindBar.CaseBtn.WasClicked()) {
            matchCase = !matchCase;
            cacheValid = false;
            sel = 0 - 1;
            app.RequestRedraw();
        }
        if (FindBar.WordBtn.WasClicked()) {
            wholeWord = !wholeWord;
            cacheValid = false;
            sel = 0 - 1;
            app.RequestRedraw();
        }
        if (FindBar.RegexBtn.WasClicked()) {
            useRegex = !useRegex;
            cacheValid = false;
            sel = 0 - 1;
            app.RequestRedraw();
        }
        if (expanded && FindBar.ReplBtn.WasClicked()) {
            ReplaceOne(ed);
            app.RequestRedraw();
        }
        if (expanded && FindBar.ReplAllBtn.WasClicked()) {
            ReplaceAll(ed);
            app.RequestRedraw();
        }
        return h;
    }

    /// Class string that makes a toggle button look pressed while it is on.
    static string ToggleClass(bool on) {
        if (on) { return "primary tiny"; }
        return "text tiny";
    }
}
