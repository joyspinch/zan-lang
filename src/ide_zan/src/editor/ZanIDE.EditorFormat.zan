using System;
using System.IO;
using System.Diagnostics;
using Gui;
using Gui.Widget;
using Gui.Component;
using Gui.Backend;

partial class ZanIDE {
    static void FormatDocument(CodeEditor editor, List<string> log) {
        string exe = ZanIDE.ToolchainDir() + "/zanfmt" + ZanIDE.ExeSuffix();
        if (!File.Exists(exe)) { exe = ZanIDE.ExeDir() + "/zanfmt" + ZanIDE.ExeSuffix(); }
        if (!File.Exists(exe)) { log.Add("> Format: zanfmt not found."); return; }
        string tmp = ZanIDE.WindowCacheDir() + "/fmt_buffer.zan";
        ZanIDE.EnsureCacheDir();
        File.WriteAllText(tmp, editor.GetText());
        List<string> outp = Process.RunCapture("\"" + exe + "\" --stdout \"" + tmp + "\"");
        File.Delete(tmp);
        if (outp.Count == 0) { log.Add("> Format: zanfmt produced no output."); return; }
        string body = "";
        for (int i = 0; i < outp.Count; i = i + 1) {
            body = body + outp[i] + "\n";
        }
        int keepLine = editor.CurLine();
        editor.LoadText(body);
        editor.GoToLine(keepLine);
        log.Add("> Formatted document with zanfmt.");
    }

    static List<string> SplitSpaces(string s) {
        List<string> outp = new List<string>();
        string cur = "";
        for (int i = 0; i < s.Length; i = i + 1) {
            string ch = s.Substring(i, 1);
            if (ch == " " || ch == "\t") {
                if (cur.Length > 0) { outp.Add(cur); cur = ""; }
            } else { cur = cur + ch; }
        }
        if (cur.Length > 0) { outp.Add(cur); }
        return outp;
    }

    static void AppendAll(List<string> log, List<string> lines) {
        for (int i = 0; i < lines.Count; i = i + 1) {
            log.Add("  " + lines[i]);
        }
    }

    static bool TabsMatchRecords(Tabs widget, List<TabRecord> records) {
        if (widget == null || records == null) { return false; }
        if (widget.Count() != records.Count) { return false; }
        for (int i = 0; i < records.Count; i = i + 1) {
            if (widget.LabelAt(i) != records[i].name) { return false; }
        }
        return true;
    }

    static bool StringListsEqual(List<string> a, List<string> b) {
        if (a == null || b == null) { return false; }
        if (a.Count != b.Count) { return false; }
        for (int i = 0; i < a.Count; i = i + 1) {
            if (a[i] != b[i]) { return false; }
        }
        return true;
    }

    void SyncEditorTabs() {
        if (editorTabs == null) {
            editorTabs = new Tabs(Tabs.Card());
            editorTabs.SetShowAdd(true);
            editorTabs.SetHostModel(true);
        }
        if (!ZanIDE.TabsMatchRecords(editorTabs, tabs)) {
            Tabs nt = new Tabs(Tabs.Card());
            nt.SetShowAdd(true);
            nt.SetHostModel(true);
            for (int i = 0; i < tabs.Count; i = i + 1) {
                nt.Add(tabs[i].name, true);
            }
            editorTabs = nt;
        }
    }
}
