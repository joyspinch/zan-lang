using System;
using System.IO;
using System.Text;
using System.Collections.Generic;
using Gui;
using Gui.Widget;
using Game.Scene;

partial class ZanIDE {

    static bool IsFormPath(string p) {
        if (!ZanIDE.IsHtmlPath(p)) { return false; }
        try {
            if (File.Exists(p)) {
                string s = File.ReadAllText(p);
                return ZanIDE.IsHtmlDesignBody(s) && !ZanIDE.IsScenePath(p);
            }
        } catch (Exception ex) {}
        return false;
    }

    static bool IsDesignFilePath(string p) {
        return ZanIDE.IsFormPath(p) || ZanIDE.IsScenePath(p);
    }

    static bool IsHtmlPath(string p) {
        int n = p.Length;
        if (n >= 5 && p.Substring(n - 5, 5) == ".html") { return true; }
        return n >= 4 && p.Substring(n - 4, 4) == ".htm";
    }

    static bool IsHtmlDesignBody(string s) {
        return System.Web.DesignerHtml.IsDesignDoc(s);
    }

    static bool IsScenePath(string p) {
        int n = p.Length;
        if (n >= 5 && p.Substring(n - 5, 5) == ".html") {
            try {
                if (File.Exists(p)) {
                    string s = File.ReadAllText(p);
                    return s.IndexOf("data-zan-scene") >= 0 || s.IndexOf("<body data-scene") >= 0;
                }
            } catch (Exception ex) {}
        }
        return false;
    }

    static string SceneBaseName(string p) {
        string fn = Path.GetFileName(p);
        int n = fn.Length;
        if (n >= 5 && fn.Substring(n - 5, 5) == ".html") { return fn.Substring(0, n - 5); }
        if (n >= 4 && fn.Substring(n - 4, 4) == ".htm") { return fn.Substring(0, n - 4); }
        return fn;
    }

    static string FormBaseName(string p) {
        string fn = Path.GetFileName(p);
        int n = fn.Length;
        if (n >= 5 && fn.Substring(n - 5, 5) == ".html") { return fn.Substring(0, n - 5); }
        if (n >= 4 && fn.Substring(n - 4, 4) == ".htm") { return fn.Substring(0, n - 4); }
        return fn;
    }

    static List<string> ScanBindVars(string code) {
        List<string> vars = new List<string>();
        List<string> lines = CodeEditor.SplitLines(code);
        bool inRegion = false;
        int i = 0;
        while (i < lines.Count && vars.Count < 60) {
            string ln = ZanIDE.TrimStr(lines[i]);
            i = i + 1;
            if (ZanIDE.Has(ln, "ZAN-DESIGNER BEGIN")) { inRegion = true; }
            if (ZanIDE.Has(ln, "ZAN-DESIGNER END")) { inRegion = false; continue; }
            if (inRegion) { continue; }
            if (ln.Length < 5) { continue; }
            if (ln.Substring(0, 2) == "//") { continue; }
            if (ZanIDE.Has(ln, "(")) { continue; }
            if (ln.Substring(ln.Length - 1, 1) != ";") { continue; }
            string body = ln.Substring(0, ln.Length - 1);
            int eq = ZanIDE.IndexOfStr(body, "=");
            if (eq >= 0) { body = ZanIDE.TrimStr(body.Substring(0, eq)); }
            List<string> toks = ZanIDE.SplitWords(body);
            if (toks.Count < 2) { continue; }
            string ty = toks[toks.Count - 2];
            string nm = toks[toks.Count - 1];
            if (!ZanIDE.IsIdent(nm)) { continue; }
            if (ty == "using" || ty == "namespace" || ty == "return" || ty == "new") { continue; }
            bool dup = false;
            for (int di = 0; di < vars.Count; di = di + 1) { if (vars[di] == nm) { dup = true; } }
            if (!dup) { vars.Add(nm); }
        }
        return vars;
    }

    // 从配对的 code-behind 源码中扫描候选事件响应方法名（用于设计器事件下拉选择）
    static List<string> ScanCandidateHandlers(string code) {
        List<string> handlers = new List<string>();
        if (code == null || code == "") { return handlers; }
        List<string> lines = CodeEditor.SplitLines(code);
        for (int i = 0; i < lines.Count && handlers.Count < 60; i = i + 1) {
            string ln = ZanIDE.TrimStr(lines[i]);
            if (ln.StartsWith("//") || ln.StartsWith("/*")) { continue; }
            int vIdx = ZanIDE.IndexOfStr(ln, "void ");
            if (vIdx >= 0) {
                string after = ZanIDE.TrimStr(ln.Substring(vIdx + 5, ln.Length - vIdx - 5));
                int pIdx = ZanIDE.IndexOfStr(after, "(");
                if (pIdx > 0) {
                    string nm = ZanIDE.TrimStr(after.Substring(0, pIdx));
                    if (nm != "" && nm != "Main" && ZanIDE.IsIdent(nm)) {
                        bool dup = false;
                        for (int di = 0; di < handlers.Count; di = di + 1) {
                            if (handlers[di] == nm) { dup = true; break; }
                        }
                        if (!dup) { handlers.Add(nm); }
                    }
                }
            }
        }
        return handlers;
    }

    static string TrimStr(string s) {
        int a = 0;
        int b = s.Length;
        for (; a < b && (s.Substring(a, 1) == " " || s.Substring(a, 1) == "\t"); a = a + 1) { }
        while (b > a && (s.Substring(b - 1, 1) == " " || s.Substring(b - 1, 1) == "\t" || s.Substring(b - 1, 1) == "\r")) { b = b - 1; }
        return s.Substring(a, b - a);
    }

    static List<string> SplitWords(string s) {
        List<string> toks = new List<string>();
        string cur = "";
        for (int i = 0; i < s.Length; i = i + 1) {
            string ch = s.Substring(i, 1);
            if (ch == " " || ch == "\t") {
                if (cur != "") { toks.Add(cur); cur = ""; }
            } else {
                cur = cur + ch;
            }
        }
        if (cur != "") { toks.Add(cur); }
        return toks;
    }

    static bool IsIdent(string s) {
        if (s.Length == 0) { return false; }
        string ok = "abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ0123456789_";
        string digits = "0123456789";
        if (ZanIDE.Has(digits, s.Substring(0, 1))) { return false; }
        for (int i = 0; i < s.Length; i = i + 1) {
            if (!ZanIDE.Has(ok, s.Substring(i, 1))) { return false; }
        }
        return true;
    }

    static string CodeBehindPath(string formPath) {
        int n = formPath.Length;
        if (n >= 5 && formPath.Substring(n - 5, 5) == ".html") {
            return formPath.Substring(0, n - 5) + ".zan";
        }
        if (n >= 4 && formPath.Substring(n - 4, 4) == ".htm") {
            return formPath.Substring(0, n - 4) + ".zan";
        }
        return formPath + ".zan";
    }

    static bool LooksLikeJson(string s) {
        for (int i = 0; i < s.Length; i = i + 1) {
            string ch = s.Substring(i, 1);
            if (ch != " " && ch != "\t" && ch != "\n" && ch != "\r") {
                return ch == "{";
            }
        }
        return false;
    }

    static bool IsGenPath(string p) {
        int n = p.Length;
        if (n < 6) { return false; }
        return p.Substring(n - 6, 6) == ".g.zan";
    }

    static bool IsZanFilePath(string p) {
        int n = p.Length;
        if (n < 4) { return false; }
        return p.Substring(n - 4, 4) == ".zan";
    }

    static string EscZ(string s) {
        string o = "";
        for (int i = 0; i < s.Length; i = i + 1) {
            string ch = s.Substring(i, 1);
            if (ch == "\\") { o = o + "\\\\"; }
            else if (ch == "\"") { o = o + "\\\""; }
            else if (ch == "\n") { o = o + "\\n"; }
            else if (ch == "\r") { }
            else if (ch == "\t") { o = o + "\\t"; }
            else { o = o + ch; }
        }
        return o;
    }

    static bool ListHasStr(List<string> l, string v) {
        for (int i = 0; i < l.Count; i = i + 1) { if (l[i] == v) { return true; } }
        return false;
    }

    static string GenBusinessShell(string name) {
        string s = "using System;\n";
        s = s + "using Gui;\n";
        s = s + "using Gui.Widget;\n\n";
        s = s + "// Business logic for " + name + ". The window is designed visually in\n";
        s = s + "// " + name + ".html. At compile time zanc projects its typed controls\n";
        s = s + "// and Main from the design, so there is no generated file to keep in sync.\n";
        s = s + "// This file is yours - the designer never overwrites it.\n";
        s = s + "partial class " + name + " {\n";
        s = s + "    // Runs once after the window is built, before the event loop.\n";
        s = s + "    static void OnLoad(Form form) {\n";
        s = s + "    }\n\n";
        s = s + "    static void OnOk(Control sender = null) {\n";
        s = s + "    }\n";
        s = s + "}\n";
        return s;
    }

    // 生成标准流式窗体 HTML5 设计稿。
    static string FlowFormBody(string name, int winW, int winH) {
        string b = "<!DOCTYPE html>\n<html>\n<head>\n";
        b = b + "<meta charset=\"utf-8\">\n";
        b = b + "<title>" + name + "</title>\n";
        b = b + "</head>\n";
        b = b + "<body data-zan-design id=\"" + name + "\" data-win-w=\"" + Convert.ToString(winW)
            + "\" data-win-h=\"" + Convert.ToString(winH)
            + "\" data-win-title=\"" + name
            + "\" data-win-center=\"true\" data-layout-mode=\"0\" data-win-zoom=\"0\">\n";
        b = b + "  <label id=\"TitleLabel\" data-kind=\"Label\" data-label=\"欢迎使用 " + name + "\"></label>\n";
        b = b + "  <button id=\"OkButton\" class=\"primary\" data-kind=\"Button\" data-label=\"确定\" @click=\"OnOk\"></button>\n";
        b = b + "</body>\n</html>\n";
        return b;
    }

    // 生成自由绝对定位布局窗体 HTML5 设计稿。
    static string FreeFormBody(string name, int winW, int winH) {
        string b = "<!DOCTYPE html>\n<html>\n<head>\n";
        b = b + "<meta charset=\"utf-8\">\n";
        b = b + "<title>" + name + "</title>\n";
        b = b + "</head>\n";
        b = b + "<body data-zan-design id=\"" + name + "\" data-win-w=\"" + Convert.ToString(winW)
            + "\" data-win-h=\"" + Convert.ToString(winH)
            + "\" data-win-title=\"" + name
            + "\" data-win-center=\"true\" data-layout-mode=\"1\" data-win-zoom=\"0\">\n";
        b = b + "  <span id=\"TitleLabel\" style=\"position:absolute;left:16px;top:16px;width:448px;height:30px;font-size:24px;\">欢迎</span>\n";
        b = b + "  <input id=\"NameInput\" type=\"text\" placeholder=\"姓名\" required style=\"position:absolute;left:60px;top:76px;width:360px;height:32px;\" />\n";
        b = b + "  <input id=\"PasswordInput\" type=\"password\" placeholder=\"密码\" required style=\"position:absolute;left:60px;top:122px;width:360px;height:32px;\" />\n";
        b = b + "  <input id=\"RememberCheck\" type=\"checkbox\" style=\"position:absolute;left:60px;top:168px;width:200px;height:26px;\">记住我</input>\n";
        b = b + "  <button id=\"SignInButton\" class=\"primary\" style=\"position:absolute;left:160px;top:220px;width:160px;height:36px;\">登录</button>\n";
        b = b + "  <span id=\"HintText\" class=\"muted\" style=\"position:absolute;left:16px;top:300px;width:448px;height:40px;\">提示：在设计器中可切换流式/自由布局、缩放窗口，并把组件拖到画布任意位置。</span>\n";
        b = b + "</body>\n</html>\n";
        return b;
    }

    static string GenFreeShell(string name) {
        string s = "using System;\n";
        s = s + "using Gui;\n";
        s = s + "using Gui.Widget;\n\n";
        s = s + "// Business logic for " + name + ". The window is designed visually in\n";
        s = s + "// " + name + ".html (open it in the form designer). This form uses FREE\n";
        s = s + "// layout: every control is absolutely positioned on the design canvas.\n";
        s = s + "// At compile time zanc projects its typed controls and Main from the\n";
        s = s + "// design, so there is no generated file to keep in sync.\n";
        s = s + "// This file is yours - the designer never overwrites it.\n";
        s = s + "partial class " + name + " {\n";
        s = s + "    // Runs once after the window is built, before the event loop starts.\n";
        s = s + "    static void OnLoad(Form form) {\n";
        s = s + "        SignInButton.OnClick(() => {\n";
        s = s + "            // Required fields (marked in the designer) are validated by the\n";
        s = s + "            // generated __ValidateForm: empty inputs get a red border + message.\n";
        s = s + "            if (!__ValidateForm()) { return; }\n";
        s = s + "            TitleLabel.Text = \"你好，\" + NameInput.GetText() + \"!\";\n";
        s = s + "        });\n";
        s = s + "        PasswordInput.OnEnter(() => { TitleLabel.Text = \"已按回车\"; });\n";
        s = s + "        RememberCheck.OnChange(() => {\n";
        s = s + "            TitleLabel.Text = \"记住我：\" + RememberCheck.IsChecked();\n";
        s = s + "        });\n";
        s = s + "    }\n";
        s = s + "}\n";
        return s;
    }

    // 清洗方法名为合法的 ASCII 标识符，杜绝中文字符或符号引发编译器语法错误
    static string SanitizeIdentifier(string s) {
        if (s == null || s.Length == 0) { return "Handler"; }
        string src = s;
        if (src.Contains("粘贴")) { src = src.Replace("粘贴", "Paste"); }
        if (src.Contains("复制")) { src = src.Replace("复制", "Copy"); }
        if (src.Contains("剪切")) { src = src.Replace("剪切", "Cut"); }
        if (src.Contains("撤销")) { src = src.Replace("撤销", "Undo"); }
        if (src.Contains("重做")) { src = src.Replace("重做", "Redo"); }
        if (src.Contains("全选")) { src = src.Replace("全选", "SelectAll"); }
        if (src.Contains("保存")) { src = src.Replace("保存", "Save"); }
        if (src.Contains("新建")) { src = src.Replace("新建", "New"); }
        if (src.Contains("打开")) { src = src.Replace("打开", "Open"); }
        if (src.Contains("关闭")) { src = src.Replace("关闭", "Close"); }
        if (src.Contains("删除")) { src = src.Replace("删除", "Delete"); }
        if (src.Contains("查找")) { src = src.Replace("查找", "Find"); }
        if (src.Contains("替换")) { src = src.Replace("替换", "Replace"); }
        if (src.Contains("刷新")) { src = src.Replace("刷新", "Refresh"); }
        if (src.Contains("设置")) { src = src.Replace("设置", "Settings"); }
        if (src.Contains("帮助")) { src = src.Replace("帮助", "Help"); }
        if (src.Contains("确定")) { src = src.Replace("确定", "Ok"); }
        if (src.Contains("取消")) { src = src.Replace("取消", "Cancel"); }
        if (src.Contains("退出")) { src = src.Replace("退出", "Exit"); }
        if (src.Contains("运行")) { src = src.Replace("运行", "Run"); }
        if (src.Contains("调试")) { src = src.Replace("调试", "Debug"); }
        if (src.Contains("停止")) { src = src.Replace("停止", "Stop"); }
        if (src.Contains("重置")) { src = src.Replace("重置", "Reset"); }
        if (src.Contains("清除")) { src = src.Replace("清除", "Clear"); }
        if (src.Contains("清空")) { src = src.Replace("清空", "Clear"); }
        if (src.Contains("导出")) { src = src.Replace("导出", "Export"); }
        if (src.Contains("导入")) { src = src.Replace("导入", "Import"); }
        if (src.Contains("添加")) { src = src.Replace("添加", "Add"); }
        if (src.Contains("移除")) { src = src.Replace("移除", "Remove"); }
        if (src.Contains("编辑")) { src = src.Replace("编辑", "Edit"); }
        if (src.Contains("查看")) { src = src.Replace("查看", "View"); }
        if (src.Contains("关于")) { src = src.Replace("关于", "About"); }
        if (src.Contains("搜索")) { src = src.Replace("搜索", "Search"); }
        if (src.Contains("下载")) { src = src.Replace("下载", "Download"); }
        if (src.Contains("上传")) { src = src.Replace("上传", "Upload"); }
        if (src.Contains("提交")) { src = src.Replace("提交", "Submit"); }
        if (src.Contains("确认")) { src = src.Replace("确认", "Confirm"); }
        if (src.Contains("应用")) { src = src.Replace("应用", "Apply"); }
        if (src.Contains("开始")) { src = src.Replace("开始", "Start"); }
        if (src.Contains("暂停")) { src = src.Replace("暂停", "Pause"); }
        if (src.Contains("继续")) { src = src.Replace("继续", "Resume"); }
        if (src.Contains("重试")) { src = src.Replace("重试", "Retry"); }

        string res = "";
        for (int i = 0; i < src.Length; i = i + 1) {
            int ch = src[i];
            if ((ch >= 65 && ch <= 90) || (ch >= 97 && ch <= 122) || (ch >= 48 && ch <= 57) || ch == 95) {
                res = res + src.Substring(i, 1);
            }
        }
        if (res.Length == 0) { res = "Action"; }
        int first = res[0];
        if (first >= 48 && first <= 57) {
            res = "_" + res;
        }
        return res;
    }

    // 智能事件桩补齐与定位：当用户在设计器双击控件或在事件检查器中点击“定位/新建”时，
    // 若 code-behind 源码中已有该事件方法或控件变量，则返回已有行号；
    // 若无，则自动在类体末尾插入标准事件响应方法（例如 static void OnSubmit() { }）并返回插入行号。
    static int EnsureControlEventHandler(CodeEditor editor, string ctrlName) {
        if (editor == null || ctrlName == "") { return -1; }
        string target = ctrlName;
        string handlerName = "";
        bool isHandler = false;
        if (target.StartsWith("handler:")) {
            handlerName = target.Substring(8, target.Length - 8);
            isHandler = true;
        } else if (target.StartsWith("On")) {
            handlerName = target;
            isHandler = true;
        }

        List<string> lines = CodeEditor.SplitLines(editor.GetText());

        if (isHandler && handlerName != "") {
            handlerName = ZanIDE.SanitizeIdentifier(handlerName);
            for (int li = 0; li < lines.Count; li = li + 1) {
                string ln = lines[li];
                if ((ZanIDE.IndexOfStr(ln, "void " + handlerName) >= 0
                    || ZanIDE.IndexOfStr(ln, handlerName + "(") >= 0
                    || ZanIDE.IndexOfStr(ln, handlerName + " (") >= 0)
                    && ZanIDE.IndexOfStr(ln, "//") < 0) {
                    return li;
                }
            }
            for (int li = 0; li < lines.Count; li = li + 1) {
                if (ZanIDE.IndexOfStr(lines[li], handlerName) >= 0) {
                    return li;
                }
            }

            int insertLine = -1;
            for (int i = lines.Count - 1; i >= 0; i = i - 1) {
                string tr = ZanIDE.TrimTrailSpaces(ZanIDE.TrimLeadSpaces(lines[i]));
                if (tr == "}" || tr == "};") {
                    insertLine = i;
                    break;
                }
            }
            if (insertLine < 0) { insertLine = lines.Count; }

            lines.Insert(insertLine, "");
            lines.Insert(insertLine + 1, "    static void " + handlerName + "(Control sender = null) {");
            lines.Insert(insertLine + 2, "    }");

            StringBuilder sb = new StringBuilder();
            for (int k = 0; k < lines.Count; k = k + 1) {
                sb.Append(lines[k]);
                sb.Append("\n");
            }
            editor.LoadText(sb.ToString());
            return insertLine + 1;
        }

        int existing = -1;
        for (int li = 0; li < lines.Count; li = li + 1) {
            if (ZanIDE.IndexOfStr(lines[li], ctrlName) >= 0) {
                existing = li;
                break;
            }
        }
        if (existing >= 0) { return existing; }

        int onLoadLine = -1;
        for (int i = 0; i < lines.Count; i = i + 1) {
            string l = lines[i];
            if (ZanIDE.IndexOfStr(l, "OnLoad") >= 0 && ZanIDE.IndexOfStr(l, "(") >= 0) {
                onLoadLine = i;
                break;
            }
        }
        if (onLoadLine < 0) { return -1; }

        int ins = onLoadLine + 1;
        for (int j = onLoadLine + 1; j < lines.Count; j = j + 1) {
            string tr = ZanIDE.TrimTrailSpaces(ZanIDE.TrimLeadSpaces(lines[j]));
            if (tr == "}" || tr == "};") {
                ins = j;
                break;
            }
        }

        string evtMethod = "OnClick";
        string cnLower = ctrlName.ToLower();
        if (cnLower.EndsWith("check") || cnLower.EndsWith("checkbox")
            || cnLower.EndsWith("switch") || cnLower.EndsWith("select")
            || cnLower.EndsWith("radio")) {
            evtMethod = "OnChange";
        } else if (cnLower.EndsWith("input") || cnLower.EndsWith("text")
                   || cnLower.EndsWith("edit") || cnLower.EndsWith("box")) {
            evtMethod = "OnChange";
        }

        string stub = "        " + ctrlName + "." + evtMethod + "(() => {\n        });";
        lines.Insert(ins, stub);
        string newBody = "";
        for (int k = 0; k < lines.Count; k = k + 1) {
            newBody = newBody + lines[k] + "\n";
        }
        editor.LoadText(newBody);
        return ins;
    }

    // 针对指定 Code-Behind 文件与 Tab 执行强一致事件方法注入与持久化，返回目标定位行号。
    static int EnsureCodeBehindFileHandler(string cbPath, string ctrlName, List<TabRecord> tabs, int tabIdx, CodeEditor editor) {
        if (cbPath == "" || ctrlName == "") { return -1; }
        string src = "";
        if (tabIdx >= 0 && tabIdx < tabs.Count && tabs[tabIdx].body != "") {
            src = tabs[tabIdx].body;
        } else if (File.Exists(cbPath)) {
            src = File.ReadAllText(cbPath);
        }
        if (src == "") {
            string fbase = ZanIDE.FormBaseName(cbPath);
            src = ZanIDE.GenBusinessShell(fbase);
        }

        string target = ctrlName;
        string handlerName = "";
        bool isHandler = false;
        if (target.StartsWith("handler:")) {
            handlerName = target.Substring(8, target.Length - 8);
            isHandler = true;
        } else if (target.StartsWith("On")) {
            handlerName = target;
            isHandler = true;
        }

        List<string> lines = CodeEditor.SplitLines(src);
        int targetLine = -1;

        if (isHandler && handlerName != "") {
            handlerName = ZanIDE.SanitizeIdentifier(handlerName);
            for (int li = 0; li < lines.Count; li = li + 1) {
                string ln = lines[li];
                if ((ZanIDE.IndexOfStr(ln, "void " + handlerName) >= 0
                    || ZanIDE.IndexOfStr(ln, handlerName + "(") >= 0
                    || ZanIDE.IndexOfStr(ln, handlerName + " (") >= 0)
                    && ZanIDE.IndexOfStr(ln, "//") < 0) {
                    targetLine = li;
                    break;
                }
            }
            if (targetLine < 0) {
                for (int li = 0; li < lines.Count; li = li + 1) {
                    if (ZanIDE.IndexOfStr(lines[li], handlerName) >= 0) {
                        targetLine = li;
                        break;
                    }
                }
            }

            if (targetLine < 0) {
                // 自动在 OnLoad 钩子中登记 form.On(handlerName, handlerName)，
                // 确保声明式事件被 Form.Call 分发时能够真正执行，无需手写繁琐的手动挂载。
                bool hasOnReg = false;
                string onSearch = "\"" + handlerName + "\"";
                for (int si = 0; si < lines.Count; si = si + 1) {
                    if (ZanIDE.IndexOfStr(lines[si], "form.On") >= 0 && ZanIDE.IndexOfStr(lines[si], onSearch) >= 0) {
                        hasOnReg = true;
                        break;
                    }
                }
                if (!hasOnReg) {
                    int onLoadIdx = -1;
                    for (int si = 0; si < lines.Count; si = si + 1) {
                        string sl = lines[si];
                        if (ZanIDE.IndexOfStr(sl, "OnLoad") >= 0 && ZanIDE.IndexOfStr(sl, "form") >= 0) {
                            onLoadIdx = si;
                            break;
                        }
                    }
                    if (onLoadIdx >= 0) {
                        int braceLine = -1;
                        for (int bi = onLoadIdx; bi < lines.Count && bi < onLoadIdx + 5; bi = bi + 1) {
                            if (ZanIDE.IndexOfStr(lines[bi], "{") >= 0) {
                                braceLine = bi;
                                break;
                            }
                        }
                        if (braceLine >= 0) {
                            lines.Insert(braceLine + 1, "        form.On(\"" + handlerName + "\", " + handlerName + ");");
                        }
                    }
                }

                int insertLine = -1;
                for (int i = lines.Count - 1; i >= 0; i = i - 1) {
                    string tr = ZanIDE.TrimTrailSpaces(ZanIDE.TrimLeadSpaces(lines[i]));
                    if (tr == "}" || tr == "};") {
                        insertLine = i;
                        break;
                    }
                }
                if (insertLine < 0) { insertLine = lines.Count; }

                lines.Insert(insertLine, "");
                lines.Insert(insertLine + 1, "    static void " + handlerName + "(Control sender = null) {");
                lines.Insert(insertLine + 2, "    }");

                StringBuilder sb = new StringBuilder();
                for (int k = 0; k < lines.Count; k = k + 1) {
                    sb.Append(lines[k]);
                    sb.Append("\n");
                }
                src = sb.ToString();
                targetLine = insertLine + 1;

                // 持久化到磁盘文件，确保绝对不会丢失
                File.WriteAllText(cbPath, src);
            }
        } else {
            for (int li = 0; li < lines.Count; li = li + 1) {
                if (ZanIDE.IndexOfStr(lines[li], ctrlName) >= 0) {
                    targetLine = li;
                    break;
                }
            }
            if (targetLine < 0) {
                int onLoadLine = -1;
                for (int i = 0; i < lines.Count; i = i + 1) {
                    string l = lines[i];
                    if (ZanIDE.IndexOfStr(l, "OnLoad") >= 0 && ZanIDE.IndexOfStr(l, "(") >= 0) {
                        onLoadLine = i;
                        break;
                    }
                }
                if (onLoadLine >= 0) {
                    int ins = onLoadLine + 1;
                    for (int j = onLoadLine + 1; j < lines.Count; j = j + 1) {
                        string tr = ZanIDE.TrimTrailSpaces(ZanIDE.TrimLeadSpaces(lines[j]));
                        if (tr == "}" || tr == "};") {
                            ins = j;
                            break;
                        }
                    }
                    string evtMethod = "OnClick";
                    string cnLower = ctrlName.ToLower();
                    if (cnLower.EndsWith("check") || cnLower.EndsWith("checkbox")
                        || cnLower.EndsWith("switch") || cnLower.EndsWith("select")
                        || cnLower.EndsWith("radio")) {
                        evtMethod = "OnChange";
                    } else if (cnLower.EndsWith("input") || cnLower.EndsWith("text")
                               || cnLower.EndsWith("edit") || cnLower.EndsWith("box")) {
                        evtMethod = "OnChange";
                    }
                    string stub = "        " + ctrlName + "." + evtMethod + "(() => {\n        });";
                    lines.Insert(ins, stub);
                    StringBuilder sb = new StringBuilder();
                    for (int k = 0; k < lines.Count; k = k + 1) {
                        sb.Append(lines[k]);
                        sb.Append("\n");
                    }
                    src = sb.ToString();
                    targetLine = ins;
                    File.WriteAllText(cbPath, src);
                }
            }
        }

        // 同步内存 Tab
        if (tabIdx >= 0 && tabIdx < tabs.Count) {
            tabs[tabIdx].body = src;
        }

        // 同步编辑器并定位
        if (editor != null) {
            editor.documentPath = cbPath;
            editor.LoadText(src);
            if (targetLine >= 0) {
                editor.GoToLine(targetLine);
            }
        }

        return targetLine;
    }

    // 配对设计稿探测：给定 .zan 源码路径，寻找同名对应 .html/.htm 设计稿。
    static string FindPairedDesignPath(string zanPath) {
        if (zanPath.Length <= 4 || !zanPath.EndsWith(".zan")) { return ""; }
        string baseWithoutExt = zanPath.Substring(0, zanPath.Length - 4);
        string directHtml = baseWithoutExt + ".html";
        if (File.Exists(directHtml)) { return directHtml; }
        string directHtm = baseWithoutExt + ".htm";
        if (File.Exists(directHtm)) { return directHtm; }
        return "";
    }
}
