using System;
using System.Collections.Generic;
using System.Threading;

public class IdeCodeNavigationWork {
    nint syncLock = Mutex.Create();
    int pending;
    List<TaskCompletionSource<int>> waiting = new List<TaskCompletionSource<int>>();

    void Begin() {
        Mutex.Lock(syncLock);
        pending = pending + 1;
        Mutex.Unlock(syncLock);
    }

    void Complete() {
        List<TaskCompletionSource<int>> ready = null;
        Mutex.Lock(syncLock);
        pending = pending - 1;
        if (pending == 0) {
            ready = waiting;
            waiting = new List<TaskCompletionSource<int>>();
        }
        Mutex.Unlock(syncLock);
        if (ready != null) {
            for (int i = 0; i < ready.Count; i = i + 1) {
                ready[i].SetResult(0);
                ready[i].Close();
            }
        }
    }

    Task Run(Action worker) {
        this.Begin();
        try {
            IdeCodeNavigationRunner runner = new IdeCodeNavigationRunner(this, worker);
            return Task.Run(runner.Execute);
        } catch (Exception error) {
            this.Complete();
            throw error;
        }
    }

    Task DrainAsync() {
        TaskCompletionSource<int> completion = null;
        Mutex.Lock(syncLock);
        if (pending > 0) {
            completion = new TaskCompletionSource<int>();
            waiting.Add(completion);
        }
        Mutex.Unlock(syncLock);
        return Task.Run(this.WaitForDrain(completion));
    }

    private async void WaitForDrain(TaskCompletionSource<int> completion) {
        if (completion != null) { await completion.Task; }
    }
}

class IdeCodeNavigationRunner {
    IdeCodeNavigationWork owner;
    Action worker;

    public IdeCodeNavigationRunner(IdeCodeNavigationWork owner, Action worker) {
        this.owner = owner;
        this.worker = worker;
    }

    public void Execute() {
        try {
            if (worker != null) { worker(); }
        } finally {
            worker = null;
            if (owner != null) {
                owner.Complete();
                owner = null;
            }
        }
    }
}
