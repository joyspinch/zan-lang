using System;
using System.IO;
using System.Diagnostics;
using System.Threading;
using Gui;
using Gui.Widget;
using Gui.Component;
using Gui.Designer;
using Game.Scene;

partial class ZanIDE {
    static List<IdeSourceSnapshot> ReadSourceSnapshots(string directory, CancellationToken cancellation) {
        List<IdeSourceSnapshot> sources = new List<IdeSourceSnapshot>();
        if (directory.Length == 0 || cancellation.IsCancellationRequested) { return sources; }
        List<string> paths = ZanIDE.ListZanFiles(directory);
        for (int i = 0; i < paths.Count; i = i + 1) {
            if (cancellation.IsCancellationRequested) { return sources; }
            string path = paths[i];
            if (!path.ToLower().EndsWith(".zan") || !File.Exists(path)) { continue; }
            sources.Add(IdeSourceSnapshot.Create(path, File.ReadAllText(path), 0));
        }
        return sources;
    }

    static IdeProjectSourceCache LoadProjectSourceSnapshot(IdeProjectSourceRead request) {
        IdeProjectSourceCache cache = new IdeProjectSourceCache();
        cache.root = request.root; cache.workspace = request.workspace; cache.revision = request.revision;
        cache.search = new List<IdeSourceSnapshot>();
        cache.project = ZanIDE.ReadSourceSnapshots(request.root, request.cancellation);
        cache.library = request.library;
        if (cache.library == null) {
            cache.library = ZanIDE.ReadSourceSnapshots(ZanIDE.StdlibDir(), request.cancellation);
        }
        cache.byPath = new Dictionary<string, IdeSourceSnapshot>();
        for (int i = 0; i < cache.library.Count; i = i + 1) {
            cache.byPath[cache.library[i].key] = cache.library[i];
        }
        for (int i = 0; i < cache.project.Count; i = i + 1) {
            cache.byPath[cache.project[i].key] = cache.project[i];
        }
        if (request.cancellation.IsCancellationRequested || request.root.Length == 0) { return cache; }
        List<string> searchPaths = new List<string>();
        ZanIDE.GatherZanFiles(request.root, searchPaths);
        for (int i = 0; i < searchPaths.Count; i = i + 1) {
            if (request.cancellation.IsCancellationRequested) { return cache; }
            string key = ZanIDE.NormPath(searchPaths[i]);
            if (!cache.byPath.ContainsKey(key) && File.Exists(searchPaths[i])) {
                cache.byPath[key] = IdeSourceSnapshot.Create(searchPaths[i], File.ReadAllText(searchPaths[i]), 0);
            }
            if (cache.byPath.ContainsKey(key)) { cache.search.Add(cache.byPath[key]); }
        }
        return cache;
    }

    void WithProjectSources(Action ready) {
        if (shuttingDown) { return; }
        if (navigationSources != null && navigationSources.root == root
            && navigationSources.workspace == navigationWorkspace
            && navigationSources.revision == ZanIDE.navigationSourceRevision) {
            ready();
            return;
        }
        bool current = projectSourceRead != null && projectSourceRead.root == root
            && projectSourceRead.workspace == navigationWorkspace
            && projectSourceRead.revision == ZanIDE.navigationSourceRevision;
        if (!current) {
            projectSourceCancellation.Cancel();
            projectSourceCancellation = new CancellationTokenSource();
            projectSourceWaiters.Clear();
            IdeProjectSourceRead request = new IdeProjectSourceRead();
            request.root = root; request.workspace = navigationWorkspace;
            request.revision = ZanIDE.navigationSourceRevision;
            request.library = navigationSources != null && navigationSources.revision == request.revision
                ? navigationSources.library : null;
            request.cancellation = projectSourceCancellation.Token;
            projectSourceRead = request;
            App host = app;
            navigationWork.Run(delegate () {
                IdeProjectSourceCache result = null;
                string failure = "";
                try { result = ZanIDE.LoadProjectSourceSnapshot(request); }
                catch (Exception error) {
                    failure = error.Message;
                }
                if (request.cancellation.IsCancellationRequested) { return; }
                host.Post(delegate () { this.CompleteProjectSources(request, result, failure); });
            });
        }
        projectSourceWaiters.Add(ready);
    }

    void CompleteProjectSources(IdeProjectSourceRead request, IdeProjectSourceCache cache, string failure) {
        if (request != projectSourceRead || request.cancellation.IsCancellationRequested
            || request.workspace != navigationWorkspace || request.root != root
            || request.revision != ZanIDE.navigationSourceRevision) { return; }
        projectSourceRead = null;
        if (failure != "" || cache == null) {
            projectSourceWaiters.Clear();
            log.Add("> Project sources: " + failure);
            app.RequestRedraw();
            return;
        }
        navigationSources = cache;
        List<Action> waiting = projectSourceWaiters;
        projectSourceWaiters = new List<Action>();
        for (int i = 0; i < waiting.Count; i = i + 1) { waiting[i](); }
    }

    static List<IdeSourceSnapshot> MergeSourceSnapshots(List<IdeSourceSnapshot> project,
            List<IdeSourceSnapshot> documents) {
        Dictionary<string, IdeSourceSnapshot> opened = new Dictionary<string, IdeSourceSnapshot>();
        for (int i = 0; i < documents.Count; i = i + 1) { opened[documents[i].key] = documents[i]; }
        List<IdeSourceSnapshot> merged = new List<IdeSourceSnapshot>();
        Dictionary<string, bool> seen = new Dictionary<string, bool>();
        for (int i = 0; i < project.Count; i = i + 1) {
            IdeSourceSnapshot source = project[i];
            merged.Add(opened.ContainsKey(source.key) ? opened[source.key] : source);
            seen[source.key] = true;
        }
        for (int i = 0; i < documents.Count; i = i + 1) {
            if (!seen.ContainsKey(documents[i].key)) { merged.Add(documents[i]); }
        }
        return merged;
    }

    static List<string> ProjectSourceBodies(IdeProjectSourceCache cache,
            IdeNavigationSnapshot snapshot) {
        List<IdeSourceSnapshot> sources = ZanIDE.MergeSourceSnapshots(cache.project, snapshot.documents);
        List<string> bodies = new List<string>();
        string skip = ZanIDE.NormPath(snapshot.path);
        for (int i = 0; i < sources.Count; i = i + 1) {
            if (sources[i].key != skip && sources[i].path.ToLower().EndsWith(".zan")) {
                bodies.Add(sources[i].body);
            }
        }
        return bodies;
    }

    void RequestProjectSourcesAsync() {
        if (!haveProject || editor == null) { return; }
        IdeNavigationGuard guard = this.CaptureNavigation(false, false);
        if (guard == null || !guard.editorBound) { return; }
        projectFeedCancellation.Cancel();
        projectFeedCancellation = new CancellationTokenSource();
        guard.snapshot.cancellation = projectFeedCancellation.Token;
        projectFeedSequence = projectFeedSequence + 1;
        int feed = projectFeedSequence;
        IdeNavigationSnapshot snapshot = guard.snapshot;
        this.WithProjectSources(delegate () {
            if (feed != projectFeedSequence || !this.NavigationGuardCurrent(guard, false, false)) { return; }
            IdeProjectSourceCache cache = navigationSources;
            App host = app;
            navigationWork.Run(delegate () {
                List<string> bodies = ZanIDE.ProjectSourceBodies(cache, snapshot);
                if (snapshot.cancellation.IsCancellationRequested) { return; }
                host.Post(delegate () {
                    if (feed != projectFeedSequence || !this.NavigationGuardCurrent(guard, false, false)) { return; }
                    editor.SetProjectFiles(bodies);
                    projSrcFeed = false;
                    app.RequestRedraw();
                });
            });
        });
    }

    static List<string> ListZanFiles(string dir) {
        List<string> outp = new List<string>();
        ZanIDE.CollectZan(dir, outp);
        return outp;
    }

    static string FindNamespaceDirFile(string dir, string name) {
        List<string> subs = DirectoryTree.SubNames(dir, PathFilter.Any());
        for (int i = 0; i < subs.Count; i = i + 1) {
            string sub = dir + "/" + subs[i];
            if (subs[i] == name) {
                List<string> inner = ZanIDE.ListZanFiles(sub);
                if (inner.Count > 0) { return inner[0]; }
            }
            string deep = ZanIDE.FindNamespaceDirFile(sub, name);
            if (deep != "") { return deep; }
        }
        return "";
    }

    static void CollectZan(string dir, List<string> outp) {
        DirectoryTree.FilesInto(outp, dir,
            PathFilter.Only(".zan .html .htm").Skip("build bin obj"));
    }

    static int ColOfWordAt(string body, int ln, string word) {
        IdeDefinitionCaret caret = ZanIDE.definitionCaret;
        ZanIDE.definitionCaret = null;
        if (caret != null && caret.body == body && caret.line == ln && caret.word == word) { return caret.column; }
        if (word.Length == 0) { return 0; }
        List<string> ls = CodeEditor.SplitLines(body);
        if (ln < 0 || ln >= ls.Count) { return 0; }
        int p = CodeEditor.FindWordFrom(ls[ln], word, 0);
        if (p < 0) { return 0; }
        return p;
    }

    static List<string> NavSearchFiles(string root) {
        if (ZanIDE.navFiles != null && ZanIDE.navFilesRoot == root) {
            return ZanIDE.navFiles;
        }
        List<string> files = ZanIDE.ListZanFiles(root + "/src");
        List<string> std = ZanIDE.ListZanFiles(ZanIDE.StdlibDir());
        for (int i = 0; i < std.Count; i = i + 1) { files.Add(std[i]); }
        ZanIDE.navFiles = files;
        ZanIDE.navFilesRoot = root;
        return files;
    }

    static void InvalidateNavFiles() {
        ZanIDE.navFiles = null;
        ZanIDE.navFilesRoot = "";
        ZanIDE.projSources = null;
        ZanIDE.projSrcRoot = "";
        ZanIDE.projectSourceReadCursor = 0;
        ZanIDE.navigationSourceRevision = ZanIDE.navigationSourceRevision + 1;
    }

    static List<string> ProjectSources(List<TabRecord> tabs, string root,
                                       int skipTab) {
        List<string> outp = new List<string>();
        List<ProjectSourceItem> cached = ZanIDE.projSrcRoot == root
            ? ZanIDE.projSources : null;
        if (cached == null) { cached = new List<ProjectSourceItem>(); }
        for (int i = 0; i < cached.Count; i = i + 1) {
            ProjectSourceItem item = cached[i];
            int t = ZanIDE.FindTabByPath(tabs, item.path);
            if (t == skipTab) { continue; }
            if (t >= 0) { outp.Add(tabs[t].body); }
            else { outp.Add(item.body); }
        }
        for (int j = 0; j < tabs.Count; j = j + 1) {
            if (j == skipTab) { continue; }
            if (tabs[j].path.Length == 0 || tabs[j].path == "@start"
                || tabs[j].path == "@docs") { continue; }
            if (!tabs[j].path.EndsWith(".zan")) { continue; }
            if (ZanIDE.HasSameSourcePath(cached, tabs[j].path)) { continue; }
            outp.Add(tabs[j].body);
        }
        return outp;
    }

    static bool ProjectSourcesStep(string root, int kbBudget) {
        if (ZanIDE.projSources == null || ZanIDE.projSrcRoot != root) {
            ZanIDE.projSources = new List<ProjectSourceItem>();
            List<string> all = ZanIDE.ListZanFiles(root);
            for (int i = 0; i < all.Count; i = i + 1) {
                if (!all[i].EndsWith(".zan")) { continue; }
                ZanIDE.projSources.Add(new ProjectSourceItem(all[i], ""));
            }
            ZanIDE.projSrcRoot = root;
            ZanIDE.projectSourceReadCursor = 0;
        }
        int spent = 0;
        while (ZanIDE.projectSourceReadCursor < ZanIDE.projSources.Count) {
            if (kbBudget > 0 && spent >= kbBudget) { return false; }
            ProjectSourceItem item = ZanIDE.projSources[ZanIDE.projectSourceReadCursor];
            item.body = File.ReadAllText(item.path);
            ZanIDE.projectSourceReadCursor = ZanIDE.projectSourceReadCursor + 1;
            spent = spent + item.body.Length / 1024 + 1;
        }
        return true;
    }

    static bool HasSameSourcePath(List<ProjectSourceItem> items, string p) {
        if (items == null) { return false; }
        for (int i = 0; i < items.Count; i = i + 1) {
            if (ZanIDE.SamePath(items[i].path, p)) { return true; }
        }
        return false;
    }

    static bool HasSamePath(List<string> paths, string p) {
        for (int i = 0; i < paths.Count; i = i + 1) {
            if (ZanIDE.SamePath(paths[i], p)) { return true; }
        }
        return false;
    }

    static List<string> NameFirst(List<string> files, string hint) {
        if (hint.Length == 0) { return files; }
        List<string> head = new List<string>();
        List<string> tail = new List<string>();
        for (int i = 0; i < files.Count; i = i + 1) {
            string b = Path.GetFileName(files[i]);
            int dot = ZanIDE.IndexOfStr(b, ".");
            if (dot > 0) { b = b.Substring(0, dot); }
            if (b == hint) { head.Add(files[i]); } else { tail.Add(files[i]); }
        }
        for (int j = 0; j < tail.Count; j = j + 1) { head.Add(tail[j]); }
        return head;
    }
}
