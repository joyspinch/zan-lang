using System;
using System.IO;
using System.Diagnostics;
using System.Json;
using System.Data;
using System.Data.Sqlite;
using Platform;
using Gui;
using Gui.Widget;
using Gui.Designer;
using Gui.Component;
using Game.Scene;

/// 编辑器外观：字号与语法配色主题的读写，以及设置对话框的两向绑定。
partial class ZanIDE {
    // ---- editor appearance (font + syntax color themes) ----

    static string EditorPrefsPath() { return ZanIDE.UserConfigDir() + "/editor.cfg"; }

    static int ReadEditorTheme() {
        string f = ZanIDE.EditorPrefsPath();
        if (!File.Exists(f)) { return 0; }
        return ZanIDE.CfgInt(File.ReadAllText(f), "theme", 0);
    }

    static int ReadEditorFont() {
        string f = ZanIDE.EditorPrefsPath();
        if (!File.Exists(f)) { return 0; }
        return ZanIDE.CfgInt(File.ReadAllText(f), "font", 0);
    }

    static void WriteEditorPrefs(int themeIdx, int fontPx) {
        Directory.CreateDirectoryRecursive(ZanIDE.UserConfigDir());
        File.WriteAllText(ZanIDE.EditorPrefsPath(),
            "theme=" + Convert.ToString(themeIdx) + ";font=" + Convert.ToString(fontPx)
            + ";lang=" + Convert.ToString(ZanIDE.uiLang) + ";");
    }

    static int EditorThemeCount() { return 6; }

    static string EditorThemeName(int i) {
        if (i == 1) { return "Monokai"; }
        if (i == 2) { return "Dracula"; }
        if (i == 3) { return "Solarized Dark"; }
        if (i == 4) { return "Night Owl"; }
        if (i == 5) { return "High Contrast"; }
        return "Dark+ (default)";
    }

    /// The effective font size: the explicit override, or the theme default.
    static int EditorFontOr(int fontPx, int defFontPx) {
        if (fontPx > 0) { return fontPx; }
        return defFontPx;
    }

    /// One syntax color of a preset theme. role: 0=keyword 1=type 2=string
    /// 3=comment 4=number 5=default text. The palettes themselves live in
    /// the Gui skin layer (EditorPalette.PresetFor): every preset ships a
    /// light-background variant, so a light skin never draws dark-surface
    /// (bright gray/blue) code text on its white editor surface.
    static int EditorThemeColor(int themeIdx, int role, bool lightBg) {
        EditorPalette p = EditorPalette.PresetFor(themeIdx, lightBg);
        if (role == 0) { return p.keyword; }
        if (role == 1) { return p.type; }
        if (role == 2) { return p.str; }
        if (role == 3) { return p.comment; }
        if (role == 4) { return p.number; }
        return p.plain;
    }

    /// Machine-readable snapshot of the editor for the AI automation driver:
    /// caret, live completion popup (candidates + selection) and buffer text.
    static string EditorProbeJson(CodeEditor ed) {
        EditorProbeDoc o = new EditorProbeDoc();
        o.caretLine = ed.CurLine();
        o.caretCol = ed.CurCol();
        o.completionActive = ed.CompletionActive();
        o.completionSel = ed.CompletionSel();
        o.completion = new List<CompletionItemDoc>();
        int n = ed.CompletionCount();
        for (int i = 0; i < n; i = i + 1) {
            CompletionItemDoc c = new CompletionItemDoc();
            c.label = ed.CompletionItem(i);
            c.kind = ed.CompletionKind(i);
            o.completion.Add(c);
        }
        o.text = ed.GetText();
        return Json.Serialize<EditorProbeDoc>(o);
    }

    /// Pushes the selected preset's colors and font size into the editor.
    /// The preset follows the active skin's background: switching skins
    /// re-resolves the palette on the next frame (this runs every frame
    /// before Render), so the editor text always contrasts its surface.
    static void ApplyEditorTheme(App app, CodeEditor editor, int themeIdx, int fontPx) {
        bool lightBg = app.theme.IsLightBg();
        editor.ApplyTheme(fontPx,
            ZanIDE.EditorThemeColor(themeIdx, 0, lightBg),
            ZanIDE.EditorThemeColor(themeIdx, 1, lightBg),
            ZanIDE.EditorThemeColor(themeIdx, 2, lightBg),
            ZanIDE.EditorThemeColor(themeIdx, 3, lightBg),
            ZanIDE.EditorThemeColor(themeIdx, 4, lightBg),
            ZanIDE.EditorThemeColor(themeIdx, 5, lightBg));
    }

    // ---- Editor Settings dialog: declarative tree + two-way binding ----
    // The Settings modal is declared in EditorSettingsDialog.zform and bound to a JsonValue model
    // {themeIdx, font, lang}. Handlers are parameterless Actions resolved by the
    // registry, so button clicks flip these static flags which Run() consumes.
    static bool setDone;

    static bool setResetFont;

    static void OnSettingsDone() { ZanIDE.setDone = true; }

    static void OnSettingsResetFont() { ZanIDE.setResetFont = true; }
}
