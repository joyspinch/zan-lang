using System;
using System.Collections.Generic;
using Gui;
using Gui.Component;
using Gui.Component.CodeEditor;

// 代码编辑区右键菜单的宿主段。控件（CodeEditor）自绘菜单，
// 只认自己的动作 id；宿主能力走 ctxCmd → TakeCommand() 通道
// 回吐命令名，IDE 在这里落地——控件不画菜单、IDE 不自绘。
partial class ZanIDE {
    // 宿主段动作 id：控件把 action >= 100 留给宿主。
    static int CtxCmdFormat = 100;
    static int CtxCmdRename = 101;
    static int CtxCmdCodeActions = 102;

    // 注入宿主菜单项：控件把这一段排在基础项之后。
    void SetupEditorCtxItems() {
        if (editor == null) { return; }
        List<ContextMenuItem> items = new List<ContextMenuItem>();
        ContextMenuItem fmt = new ContextMenuItem(
            ZanIDE.T("Format Document", "格式化文档"), "Shift+Alt+F", CtxCmdFormat);
        fmt.cmd = "format";
        items.Add(fmt);
        ContextMenuItem ren = new ContextMenuItem(
            ZanIDE.T("Rename Symbol", "重命名符号"), "F2", CtxCmdRename);
        ren.cmd = "rename";
        items.Add(ren);
        ContextMenuItem ca = new ContextMenuItem(
            ZanIDE.T("Code Actions...", "代码动作..."), "Ctrl+Shift+.", CtxCmdCodeActions);
        ca.cmd = "codeactions";
        items.Add(ca);
        editor.SetHostCtxItems(items);
    }

    // 派发宿主段命令（TakeCommand() 回吐的命令名）。
    void RunEditorCtxCommand(string cmd) {
        if (cmd == "format") {
            ZanIDE.FormatDocument(editor, log);
        } else if (cmd == "rename") {
            this.BeginRenameAtCaret();
        } else if (cmd == "codeactions") {
            // 锚在右键点击处：菜单项被点时鼠标已移到菜单上，
            // 用当前鼠标位置会把动作菜单弹到菜单上面去。
            this.BeginCodeActions(editor.CtxAnchorX(), editor.CtxAnchorY());
        }
        app.RequestRedraw();
    }

    // 以光标处符号为起点发起重命名（F2 与右键菜单共用一条路）。
    void BeginRenameAtCaret() {
        if (editor == null) { return; }
        renameWord = editor.WordAtCaret();
        if (renameWord.Length > 0) {
            findMode = 5;
        } else {
            log.Add(ZanIDE.T("> Rename: no symbol under caret.",
                            "> 重命名：光标处没有符号。"));
        }
    }
}
