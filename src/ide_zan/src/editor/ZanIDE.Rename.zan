using System;
using System.IO;
using System.Collections.Generic;
using System.Threading;
using Gui;
using Gui.Widget;
using Gui.Component;
using Gui.Designer;

partial class ZanIDE {
    static List<IdeRenameDocument> SyncNavigationDocuments(LspSession lsp, List<TabRecord> tabs) {
        List<IdeRenameDocument> snapshots = new List<IdeRenameDocument>();
        for (int i = 0; i < tabs.Count; i = i + 1) {
            TabRecord tab = tabs[i];
            if (tab.path.Length == 0 || tab.designDoc || !tab.path.ToLower().EndsWith(".zan")) { continue; }
            lsp.SyncDoc(tab.path, tab.body);
            IdeRenameDocument snapshot = new IdeRenameDocument();
            snapshot.path = tab.path; snapshot.originalText = tab.body;
            snapshot.tab = tab; snapshot.version = lsp.DocVersion(tab.path);
            snapshots.Add(snapshot);
        }
        return snapshots;
    }

    static bool NavigationDocumentsCurrent(LspSession lsp, List<TabRecord> tabs, List<IdeRenameDocument> snapshots) {
        int sourceTabs = 0;
        for (int i = 0; i < tabs.Count; i = i + 1) {
            if (tabs[i].path.Length > 0 && !tabs[i].designDoc && tabs[i].path.ToLower().EndsWith(".zan")) {
                sourceTabs = sourceTabs + 1;
            }
        }
        if (sourceTabs != snapshots.Count) { return false; }
        for (int i = 0; i < snapshots.Count; i = i + 1) {
            IdeRenameDocument snapshot = snapshots[i];
            int tab = ZanIDE.FindNavigationTab(tabs, snapshot.path);
            if (tab < 0 || tabs[tab] != snapshot.tab || tabs[tab].body != snapshot.originalText
                || lsp.DocVersion(snapshot.path) != snapshot.version) { return false; }
        }
        return true;
    }

    // 无有效语义结果时拒绝修改，文本替换无法区分同名但不同绑定的符号。
    static int RenameSymbolSmart(LspSession lsp, CodeEditor editor,
                                 List<TabRecord> tabs, SignalInt active,
                                 List<string> log, string word, string newName) {
        if (word == "" || newName == "" || word == newName) { return 0; }
        int a = active.Get();
        if (lsp == null || !lsp.Alive() || a < 0 || a >= tabs.Count
            || tabs[a].path.Length == 0) {
            log.Add("> Rename: semantic service unavailable; no files changed.");
            return 0;
        }
        string source = editor.GetText();
        int stamp = editor.TextStamp();
        int line = editor.CurLine();
        int col = editor.CurCol();
        TabRecord origin = tabs[a];
        origin.body = source;
        List<IdeRenameDocument> snapshots = ZanIDE.SyncNavigationDocuments(lsp, tabs);
        List<LspRenameEdit> edits = lsp.Rename(origin.path, line, col, newName);
        if (active.Get() != a || a >= tabs.Count || tabs[a] != origin
            || editor.TextStamp() != stamp || editor.GetText() != source
            || editor.CurLine() != line || editor.CurCol() != col
            || !ZanIDE.NavigationDocumentsCurrent(lsp, tabs, snapshots)) {
            log.Add("> Rename: document changed during request; no files changed.");
            return 0;
        }
        if (edits == null || edits.Count == 0) {
            log.Add("> Rename: no valid semantic edits; no files changed.");
            return 0;
        }

        // 按文件先准备和验证整批编辑，再改缓冲区或磁盘，避免半份重命名。
        List<IdeRenameDocument> plans = new List<IdeRenameDocument>();
        List<string> files = new List<string>();
        for (int i = 0; i < edits.Count; i = i + 1) {
            string path = edits[i].path;
            if (ZanIDE.IndexOfPath(files, path) >= 0) { continue; }
            files.Add(path);
            int tab = ZanIDE.FindNavigationTab(tabs, path);
            if (tab < 0 && !File.Exists(path)) {
                log.Add("> Rename: target file unavailable; no files changed."); return 0;
            }
            string text = tab >= 0 ? tabs[tab].body : File.ReadAllText(path);
            if (!lsp.DocTextMatches(path, text)) {
                log.Add("> Rename: target differs from synchronized text; no files changed."); return 0;
            }
            LspEditApplication applied = ZanIDE.ApplyRenameEdits(text, edits, path);
            if (!applied.valid) {
                log.Add("> Rename: invalid or overlapping edit ranges; no files changed."); return 0;
            }
            IdeRenameDocument plan = new IdeRenameDocument();
            plan.path = path; plan.originalText = text; plan.newText = applied.text;
            plan.tab = tab >= 0 ? tabs[tab] : null;
            plan.version = lsp.DocVersion(path);
            plans.Add(plan);
        }
        for (int i = 0; i < plans.Count; i = i + 1) {
            IdeRenameDocument plan = plans[i];
            int tab = ZanIDE.FindNavigationTab(tabs, plan.path);
            bool current = plan.tab != null
                ? tab >= 0 && tabs[tab] == plan.tab && tabs[tab].body == plan.originalText
                : tab < 0 && File.Exists(plan.path) && File.ReadAllText(plan.path) == plan.originalText;
            if (!current || lsp.DocVersion(plan.path) != plan.version) {
                log.Add("> Rename: target changed before apply; no files changed."); return 0;
            }
        }

        int bufs = 0;
        int disk = 0;
        bool activeChanged = false;
        for (int i = 0; i < plans.Count; i = i + 1) {
            IdeRenameDocument plan = plans[i];
            if (plan.newText == plan.originalText) { continue; }
            if (plan.tab != null) {
                if (plan.tab == origin) { editor.SaveUndo(); activeChanged = true; }
                plan.tab.body = plan.newText;
                bufs = bufs + 1;
            } else {
                File.WriteAllText(plan.path, plan.newText);
                disk = disk + 1;
            }
        }
        if (activeChanged) {
            editor.LoadText(origin.body);
            editor.GoToLine(line);
        }
        for (int i = 0; i < plans.Count; i = i + 1) {
            IdeRenameDocument plan = plans[i];
            if (plan.newText != plan.originalText) { lsp.SyncDoc(plan.path, plan.newText); }
        }
        log.Add("> Renamed '" + word + "' -> '" + newName + "' (semantic): "
            + Convert.ToString(bufs) + " open tab(s), "
            + Convert.ToString(disk) + " file(s) on disk.");
        return bufs + disk;
    }

    static LspDocumentSnapshot SemanticDocumentSnapshot(List<LspDocumentSnapshot> documents, string path) {
        if (documents == null) { return null; }
        for (int i = 0; i < documents.Count; i = i + 1) {
            if (LspSession.SameDocumentPath(documents[i].path, path)) { return documents[i]; }
        }
        return null;
    }

    static IdeRenamePlan PrepareRenamePlan(IdeNavigationSnapshot snapshot,
            List<LspRenameEdit> edits, List<LspDocumentSnapshot> synchronized) {
        IdeRenamePlan plan = new IdeRenamePlan();
        if (edits == null || edits.Count == 0) {
            plan.failure = "no valid semantic edits; no files changed."; return plan;
        }
        Dictionary<string, bool> seen = new Dictionary<string, bool>();
        for (int i = 0; i < edits.Count; i = i + 1) {
            if (snapshot.cancellation.IsCancellationRequested) {
                plan.failure = "canceled; no files changed."; return plan;
            }
            string path = edits[i].path;
            string key = ZanIDE.NormPath(path);
            if (seen.ContainsKey(key)) { continue; }
            seen[key] = true;
            IdeSourceSnapshot opened = ZanIDE.SnapshotSource(snapshot.documents, path);
            LspDocumentSnapshot semantic = ZanIDE.SemanticDocumentSnapshot(synchronized, path);
            if (opened == null && !File.Exists(path)) {
                plan.failure = "target file unavailable; no files changed."; return plan;
            }
            string text = opened != null ? opened.body : File.ReadAllText(path);
            int version = semantic != null ? semantic.version : opened != null ? opened.version : 0;
            if (semantic != null && semantic.text != text
                || opened != null && semantic != null && opened.version != semantic.version) {
                plan.failure = "target differs from synchronized text; no files changed."; return plan;
            }
            for (int e = 0; e < edits.Count; e = e + 1) {
                if (LspSession.SameDocumentPath(edits[e].path, path)
                    && edits[e].version >= 0 && edits[e].version != version) {
                    plan.failure = "target version changed; no files changed."; return plan;
                }
            }
            LspEditApplication applied = ZanIDE.ApplyRenameEdits(text, edits, path);
            if (!applied.valid) {
                plan.failure = "invalid or overlapping edit ranges; no files changed."; return plan;
            }
            if (applied.text == text) { continue; }
            IdeRenamePlanEntry entry = new IdeRenamePlanEntry();
            entry.path = path; entry.originalText = text; entry.newText = applied.text;
            entry.open = opened != null; entry.version = version;
            if (entry.open) { entry.prepared = CodeEditor.PrepareText(entry.newText); plan.buffers = plan.buffers + 1; }
            else { plan.disk = plan.disk + 1; }
            plan.entries.Add(entry);
        }
        plan.valid = true;
        return plan;
    }

    static string ValidateRenameDiskPlan(IdeRenamePlan plan, CancellationToken cancellation) {
        for (int i = 0; i < plan.entries.Count; i = i + 1) {
            if (cancellation.IsCancellationRequested) { return "canceled; no files changed."; }
            IdeRenamePlanEntry entry = plan.entries[i];
            if (entry.open) { continue; }
            if (!File.Exists(entry.path) || File.ReadAllText(entry.path) != entry.originalText) {
                return "target changed before apply; no files changed.";
            }
        }
        return "";
    }

    static string RollbackRenameDiskPlan(IdeRenamePlan plan) {
        string failure = "";
        for (int i = plan.entries.Count - 1; i >= 0; i = i - 1) {
            IdeRenamePlanEntry entry = plan.entries[i];
            if (!entry.written) { continue; }
            try {
                if (File.Exists(entry.path) && File.ReadAllText(entry.path) == entry.originalText) {
                    entry.written = false;
                    continue;
                }
                File.WriteAllText(entry.path, entry.originalText);
                if (File.ReadAllText(entry.path) != entry.originalText) {
                    throw new IOException("Could not restore original text: " + entry.path);
                }
                entry.written = false;
            } catch (Exception error) {
                failure = failure + " Restore failed for " + entry.path + ": " + error.Message;
            }
        }
        return failure;
    }

    static IdeRenameCommit CommitRenameDiskPlan(IdeRenamePlan plan, CancellationToken cancellation) {
        return ZanIDE.CommitRenameDiskPlanWithWriter(plan, cancellation, null);
    }

    static IdeRenameCommit CommitRenameDiskPlanWithWriter(IdeRenamePlan plan,
            CancellationToken cancellation, IdeRenameDiskWriter writer) {
        IdeRenameCommit result = new IdeRenameCommit();
        if (!plan.valid) { result.failure = plan.failure; return result; }
        try {
            result.failure = ZanIDE.ValidateRenameDiskPlan(plan, cancellation);
            if (result.failure != "") { return result; }
            for (int i = 0; i < plan.entries.Count; i = i + 1) {
                if (cancellation.IsCancellationRequested) { throw new Exception("canceled before apply completed."); }
                IdeRenamePlanEntry entry = plan.entries[i];
                if (entry.open) { continue; }
                if (!File.Exists(entry.path) || File.ReadAllText(entry.path) != entry.originalText) {
                    throw new Exception("target changed before write: " + entry.path);
                }
                entry.written = true;
                if (writer == null) { File.WriteAllText(entry.path, entry.newText); }
                else { writer(entry.path, entry.newText); }
                if (File.ReadAllText(entry.path) != entry.newText) {
                    throw new IOException("Could not verify written text: " + entry.path);
                }
            }
            if (cancellation.IsCancellationRequested) { throw new Exception("canceled before apply completed."); }
            result.committed = true;
        } catch (Exception error) {
            result.failure = error.Message + ZanIDE.RollbackRenameDiskPlan(plan);
        }
        return result;
    }

    bool RenamePlanTabsCurrent(IdeNavigationGuard guard, IdeRenamePlan plan) {
        if (!this.NavigationGuardCurrent(guard, true, true)
            || guard.snapshot.designRevision != this.DesignDocumentRevision()) { return false; }
        for (int i = 0; i < plan.entries.Count; i = i + 1) {
            IdeRenamePlanEntry entry = plan.entries[i];
            int tab = ZanIDE.FindNavigationTab(tabs, entry.path);
            if (entry.open ? tab < 0 || tabs[tab].body != entry.originalText : tab >= 0) { return false; }
            if (guard.synchronized && (!guard.session.DocTextMatches(entry.path, entry.originalText)
                || guard.session.DocVersion(entry.path) != entry.version)) { return false; }
        }
        return true;
    }

    void RenameSymbolAsync(string word, string newName) {
        if (word == "" || newName == "" || word == newName || this.CodeNavigationBusy()) { return; }
        IdeNavigationGuard guard = this.BeginCodeNavigation(true, true);
        if (guard == null) { return; }
        LspSession session = guard.session;
        if (session == null || !session.Alive() || !ZanIDE.NavigationPathInRoot(guard.snapshot.path, root)) {
            log.Add("> Rename: semantic service unavailable; no files changed."); app.RequestRedraw(); return;
        }
        if (guard.snapshot.word != word) {
            log.Add("> Rename: symbol changed before request; no files changed."); app.RequestRedraw(); return;
        }
        IdeNavigationSnapshot snapshot = guard.snapshot;
        session.RenameAsync(guard.snapshot.path, guard.snapshot.line, guard.snapshot.column, newName,
            delegate (LspRenameResult result) {
                if (!this.NavigationGuardCurrent(guard, true, true) || result == null
                    || !session.IsCurrent(result.path, result.version, result.generation, result.documentGeneration)) { return; }
                // 闭包里不再沿用外层的空值收窄：自己判一次。
                if (guard == null) { return; }
                guard.semantic = result;
                List<LspRenameEdit> edits = result.edits;
                List<LspDocumentSnapshot> documents = result.documents;
                App host = app;
                navigationWork.Run(delegate () {
                    IdeRenamePlan plan = new IdeRenamePlan();
                    try { plan = ZanIDE.PrepareRenamePlan(snapshot, edits, documents); }
                    catch (Exception error) {
                        plan.failure = error.Message;
                    }
                    if (snapshot.cancellation.IsCancellationRequested) { return; }
                    host.Post(delegate () {
                        List<SearchHit> previewHits = new List<SearchHit>();
                        if (edits != null) {
                            for (int ei = 0; ei < edits.Count; ei = ei + 1) {
                                LspRenameEdit ed = edits[ei];
                                previewHits.Add(SearchHit.Create(ed.path, ed.start.line,
                                    "Rename '" + word + "' -> '" + newName + "'"));
                            }
                        }
                        if (previewHits.Count > 0) {
                            fifHits = previewHits;
                            fifSel = -1;
                        }
                        this.BeginRenamePlanCommit(guard, plan, "Rename", "Renamed '" + word + "' -> '" + newName + "' (semantic)");
                    });
                });
            });
    }

    void BeginRenamePlanCommit(IdeNavigationGuard guard, IdeRenamePlan plan, string operation, string summary) {
        if (!this.NavigationGuardCurrent(guard, true, true) || this.CodeNavigationBusy()) { return; }
        if (!plan.valid) {
            log.Add("> " + operation + ": " + plan.failure); app.RequestRedraw(); return;
        }
        if (!this.RenamePlanTabsCurrent(guard, plan)) {
            log.Add("> " + operation + ": document changed before apply; no files changed."); app.RequestRedraw(); return;
        }
        if (plan.entries.Count == 0) {
            log.Add("> " + operation + ": no changes."); app.RequestRedraw(); return;
        }
        navigationCommitWaiting = true;
        navigationDocumentWritesPaused = true;
        try {
            this.PauseDocumentWritesThen(delegate () {
                if (!this.RenamePlanTabsCurrent(guard, plan)) {
                    log.Add("> " + operation + ": request canceled or document changed while waiting for saves; no files changed.");
                    this.ReleaseNavigationCommit();
                    return;
                }
                navigationDesignWritesPaused = true;
                try {
                    this.PauseDesignWritesThen(delegate () {
                        this.StartRenamePlanDiskCommit(guard, plan, operation, summary);
                    });
                } catch (Exception error) {
                    log.Add("> " + operation + ": could not pause design saves: " + error.Message);
                    this.ReleaseNavigationCommit();
                }
            });
        } catch (Exception error) {
            log.Add("> " + operation + ": could not pause document saves: " + error.Message);
            this.ReleaseNavigationCommit();
        }
        app.RequestRedraw();
    }

    void StartRenamePlanDiskCommit(IdeNavigationGuard guard, IdeRenamePlan plan,
            string operation, string summary) {
        if (!navigationCommitWaiting || !this.RenamePlanTabsCurrent(guard, plan)) {
            this.ReleaseNavigationCommit();
            return;
        }
        navigationCommitWaiting = false;
        navigationCommitBusy = true;
        IdeNavigationSnapshot snapshot = guard.snapshot;
        App host = app;
        try {
            navigationWork.Run(delegate () {
                IdeRenameCommit result = ZanIDE.CommitRenameDiskPlan(plan, snapshot.cancellation);
                host.Post(delegate () { this.FinishRenamePlanCommit(guard, plan, result, operation, summary); });
            });
        } catch (Exception error) {
            log.Add("> " + operation + ": " + error.Message);
            this.ReleaseNavigationCommit();
        }
    }

    void CompensateRenamePlan(IdeRenamePlan plan, string operation, string failure) {
        App host = app;
        navigationWork.Run(delegate () {
            string rollback = ZanIDE.RollbackRenameDiskPlan(plan);
            host.Post(delegate () {
                log.Add("> " + operation + ": " + failure + rollback);
                this.ReleaseNavigationCommit();
            });
        });
    }

    void FinishRenamePlanCommit(IdeNavigationGuard guard, IdeRenamePlan plan,
            IdeRenameCommit result, string operation, string summary) {
        if (!result.committed) {
            log.Add("> " + operation + ": " + result.failure);
            this.ReleaseNavigationCommit();
            return;
        }
        if (!this.RenamePlanTabsCurrent(guard, plan)) {
            this.CompensateRenamePlan(plan, operation, "request canceled or document changed; disk writes rolled back.");
            return;
        }
        IdeNavigationSnapshot snapshot = guard.snapshot;
        IdeRenamePlanEntry active = null;
        for (int i = 0; i < plan.entries.Count; i = i + 1) {
            if (plan.entries[i].open && LspSession.SameDocumentPath(plan.entries[i].path, snapshot.path)) {
                active = plan.entries[i];
            }
        }
        if (active != null && guard.editorBound) {
            CodeEditorTextLoad request = editor.BeginTextLoad(snapshot.path, CodeEditor.LangForName(snapshot.path));
            editor.SaveUndo();
            if (!editor.ApplyPreparedText(request, active.prepared)) {
                this.CompensateRenamePlan(plan, operation, "editor changed before apply; disk writes rolled back.");
                return;
            }
            editor.GoToLineCol(snapshot.line, snapshot.column);
            editor.SetScrollLine(guard.origin.scrollLine);
        }
        for (int i = 0; i < plan.entries.Count; i = i + 1) {
            IdeRenamePlanEntry entry = plan.entries[i];
            if (entry.open) {
                int tab = ZanIDE.FindNavigationTab(tabs, entry.path);
                tabs[tab].body = entry.newText;
                tabs[tab].preparedText = entry.prepared;
                tabs[tab].preparedBody = entry.newText;
                this.InvalidateLoadedDocument(tabs[tab].path);
            }
            if (lspSess != null && lspSess.Alive() && entry.path.ToLower().EndsWith(".zan")) {
                lspSess.SyncDoc(entry.path, entry.newText);
            }
        }
        this.PushRenameHistory(snapshot.word, summary, plan);
        ZanIDE.InvalidateNavFiles();
        log.Add("> " + summary + ": " + Convert.ToString(plan.buffers) + " open tab(s), "
            + Convert.ToString(plan.disk) + " file(s) on disk. (Ctrl+Alt+Z / Ctrl+Shift+Z to undo)");
        this.ReleaseNavigationCommit();
        this.RequestProjectSourcesAsync();
    }

    void PushRenameHistory(string word, string newName, IdeRenamePlan plan) {
        if (plan == null || plan.entries == null || plan.entries.Count == 0) { return; }
        IdeRenameHistoryItem item = new IdeRenameHistoryItem();
        item.word = word;
        item.newName = newName;
        item.plan = plan;
        renameHistory.Add(item);
    }

    bool UndoRename() {
        if (renameHistory == null || renameHistory.Count == 0) {
            log.Add(ZanIDE.T("> Undo Rename: no rename history to undo.", "> 撤销重命名：没有可撤销的重命名历史。"));
            app.RequestRedraw();
            return false;
        }
        IdeRenameHistoryItem last = renameHistory[renameHistory.Count - 1];
        renameHistory.RemoveAt(renameHistory.Count - 1);
        IdeRenamePlan plan = last.plan;
        if (plan == null || plan.entries == null || plan.entries.Count == 0) {
            log.Add(ZanIDE.T("> Undo Rename: empty rename plan.", "> 撤销重命名：重命名计划为空。"));
            app.RequestRedraw();
            return false;
        }

        // 1. 校验当前性（打开页签 body == newText、磁盘 == newText）
        for (int i = 0; i < plan.entries.Count; i = i + 1) {
            IdeRenamePlanEntry entry = plan.entries[i];
            if (entry.open) {
                int tab = ZanIDE.FindNavigationTab(tabs, entry.path);
                if (tab < 0 || tabs[tab].body != entry.newText) {
                    log.Add(ZanIDE.T("> Undo Rename: document '", "> 撤销重命名：文档 '")
                        + Path.GetFileName(entry.path)
                        + ZanIDE.T("' was modified after rename; cannot undo.", "' 在重命名后已被修改，无法撤销。"));
                    app.RequestRedraw();
                    return false;
                }
            } else {
                if (!File.Exists(entry.path) || File.ReadAllText(entry.path) != entry.newText) {
                    log.Add(ZanIDE.T("> Undo Rename: file '", "> 撤销重命名：文件 '")
                        + Path.GetFileName(entry.path)
                        + ZanIDE.T("' was modified after rename; cannot undo.", "' 在重命名后已被修改，无法撤销。"));
                    app.RequestRedraw();
                    return false;
                }
            }
        }

        // 2. RollbackRenameDiskPlan 语义还盘
        for (int i = 0; i < plan.entries.Count; i = i + 1) {
            if (!plan.entries[i].open) {
                plan.entries[i].written = true;
            }
        }
        string rollbackErr = ZanIDE.RollbackRenameDiskPlan(plan);
        if (rollbackErr != "") {
            log.Add("> Undo Rename: " + rollbackErr);
        }

        // 3. 恢复打开页签 body
        for (int i = 0; i < plan.entries.Count; i = i + 1) {
            IdeRenamePlanEntry entry = plan.entries[i];
            if (entry.open) {
                int tab = ZanIDE.FindNavigationTab(tabs, entry.path);
                if (tab >= 0) {
                    tabs[tab].body = entry.originalText;
                    tabs[tab].preparedText = CodeEditor.PrepareText(entry.originalText);
                    tabs[tab].preparedBody = entry.originalText;
                    this.InvalidateLoadedDocument(tabs[tab].path);
                }
            }
        }

        // 4. 重载活动编辑器
        int active = activeTab.Get();
        if (active >= 0 && active < tabs.Count) {
            string curPath = tabs[active].path;
            for (int i = 0; i < plan.entries.Count; i = i + 1) {
                if (LspSession.SameDocumentPath(plan.entries[i].path, curPath)) {
                    CodeEditorTextLoad req = editor.BeginTextLoad(curPath, CodeEditor.LangForName(curPath));
                    editor.SaveUndo();
                    editor.ApplyPreparedText(req, tabs[active].preparedText);
                    break;
                }
            }
        }

        // 5. lspSess.SyncDoc
        if (lspSess != null && lspSess.Alive()) {
            for (int i = 0; i < plan.entries.Count; i = i + 1) {
                IdeRenamePlanEntry entry = plan.entries[i];
                if (entry.path.ToLower().EndsWith(".zan")) {
                    lspSess.SyncDoc(entry.path, entry.originalText);
                }
            }
        }

        ZanIDE.InvalidateNavFiles();
        log.Add(ZanIDE.T("> Undo Rename: reverted '", "> 撤销重命名：已恢复 '")
            + last.newName + "' -> '" + last.word + "' ("
            + Convert.ToString(plan.entries.Count) + " file(s)).");
        this.RequestProjectSourcesAsync();
        app.RequestRedraw();
        return true;
    }

    static int IndexOfPath(List<string> paths, string path) {
        for (int i = 0; i < paths.Count; i = i + 1) {
            if (ZanIDE.SamePath(paths[i], path)) { return i; }
        }
        return 0 - 1;
    }

    // 按服务端完整 range/newText 应用语义编辑；非法范围使整份文本失败。
    static LspEditApplication ApplyRenameEdits(string text, List<LspRenameEdit> edits, string path) {
        return LspSession.ApplyTextEdits(text, edits, path);
    }

    static int RenameSymbol(CodeEditor editor, List<TabRecord> tabs,
                            SignalInt active, List<string> log,
                            string word, string newName) {
        if (word == "" || newName == "" || word == newName) { return 0; }
        int a = active.Get();
        if (a >= 0 && a < tabs.Count) { tabs[a].body = editor.GetText(); }
        int changed = 0;
        for (int i = 0; i < tabs.Count; i = i + 1) {
            string nb = ZanIDE.ReplaceWholeWord(tabs[i].body, word, newName);
            if (nb != tabs[i].body) {
                tabs[i].body = nb;
                changed = changed + 1;
            }
        }
        if (a >= 0 && a < tabs.Count) {
            int keepLine = editor.CurLine();
            editor.LoadText(tabs[a].body);
            editor.GoToLine(keepLine);
        }
        log.Add("> Renamed '" + word + "' -> '" + newName + "' in "
            + Convert.ToString(changed) + " open tab(s). Save to persist.");
        return changed;
    }
}
