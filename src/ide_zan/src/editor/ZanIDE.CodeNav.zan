using System;
using System.IO;
using System.Diagnostics;
using System.Json;
using System.Threading;
using Gui;
using Gui.Widget;
using Gui.Component;
using Gui.Designer;
using Game.Scene;

partial class ZanIDE {
    static IdeDefinitionCaret definitionCaret;
    static int navigationSourceRevision;
    static int projectSourceReadCursor;
    int navigationWorkspace;
    int navigationSequence;
    int projectFeedSequence;
    CancellationTokenSource navigationCancellation = new CancellationTokenSource();
    CancellationTokenSource projectSourceCancellation = new CancellationTokenSource();
    CancellationTokenSource projectFeedCancellation = new CancellationTokenSource();
    IdeProjectSourceCache navigationSources;
    IdeProjectSourceRead projectSourceRead;
    List<Action> projectSourceWaiters = new List<Action>();
    List<Action> navigationIdleWaiters = new List<Action>();
    List<IdeRenameHistoryItem> renameHistory = new List<IdeRenameHistoryItem>();
    bool navigationCommitBusy;
    bool navigationCommitWaiting;
    bool navigationDocumentWritesPaused;
    bool navigationDesignWritesPaused;
    IdeCodeNavigationWork navigationWork = new IdeCodeNavigationWork();

    bool CodeNavigationBusy() { return navigationCommitWaiting || navigationCommitBusy; }

    async void DrainCodeNavigationAsync() { await navigationWork.DrainAsync(); }

    void CancelCodeNavigation() {
        navigationWorkspace = navigationWorkspace + 1;
        navigationSequence = navigationSequence + 1;
        projectFeedSequence = projectFeedSequence + 1;
        projectFeedCancellation.Cancel();
        projectFeedCancellation = new CancellationTokenSource();
        navigationCancellation.Cancel();
        navigationCancellation = new CancellationTokenSource();
        projectSourceCancellation.Cancel();
        projectSourceCancellation = new CancellationTokenSource();
        projectSourceRead = null;
        navigationSources = null;
        projectSourceWaiters.Clear();
    }

    void CancelCodeNavigationThen(Action continuation) {
        this.CancelCodeNavigation();
        if (continuation == null) { return; }
        if (this.CodeNavigationBusy()) { navigationIdleWaiters.Add(continuation); }
        else { app.Post(continuation); }
    }

    void ReleaseNavigationCommit() {
        if (navigationDesignWritesPaused) {
            navigationDesignWritesPaused = false;
            this.ResumeDesignWrites();
        }
        if (navigationDocumentWritesPaused) {
            navigationDocumentWritesPaused = false;
            this.ResumeDocumentWrites();
        }
        navigationCommitWaiting = false;
        navigationCommitBusy = false;
        List<Action> waiting = navigationIdleWaiters;
        navigationIdleWaiters = new List<Action>();
        for (int i = 0; i < waiting.Count; i = i + 1) { app.Post(waiting[i]); }
        app.RequestRedraw();
    }

    IdeNavigationGuard CaptureNavigation(bool synchronize, bool symbol) {
        if (shuttingDown) { return null; }
        int active = activeTab.Get();
        if (active < 0 || active >= tabs.Count || editor == null) { return null; }
        TabRecord origin = tabs[active];
        bool bound = origin.path == editor.documentPath && !origin.designDoc
            && !origin.path.StartsWith("@");
        if (symbol && (!bound || origin.path.Length == 0)) { return null; }
        string text = bound ? editor.GetText() : origin.body;
        if (bound) { origin.body = text; }
        IdeNavigationSnapshot snapshot = new IdeNavigationSnapshot();
        snapshot.root = root; snapshot.path = origin.path; snapshot.body = text;
        snapshot.workspace = navigationWorkspace;
        snapshot.sourceRevision = ZanIDE.navigationSourceRevision;
        snapshot.designRevision = this.DesignDocumentRevision();
        snapshot.sequence = navigationSequence;
        snapshot.stamp = bound ? editor.TextStamp() : 0;
        snapshot.line = bound ? editor.CurLine() : origin.caretLine;
        snapshot.column = bound ? editor.CurCol() : origin.caretCol;
        snapshot.word = symbol ? editor.WordAtCaret() : "";
        snapshot.owner = symbol ? editor.OwnerTypeAtCaret() : "";
        snapshot.referenceOwner = snapshot.owner;
        if (symbol && snapshot.referenceOwner.Length == 0) {
            snapshot.referenceOwner = editor.EnclosingTypeOfCaretDecl();
        }
        snapshot.family = new List<string>();
        if (snapshot.referenceOwner.Length > 0) {
            snapshot.family.Add(snapshot.referenceOwner);
            CodeEditor.SymbolSubtypesOf(snapshot.referenceOwner, snapshot.family);
            snapshot.lacksReferenceMember = CodeEditor.SymbolTypeLacksMember(
                snapshot.referenceOwner, snapshot.word);
        }
        snapshot.lacksMember = snapshot.owner.Length > 0
            && CodeEditor.SymbolTypeLacksMember(snapshot.owner, snapshot.word);
        snapshot.documents = new List<IdeSourceSnapshot>();
        snapshot.cancellation = navigationCancellation.Token;
        IdeNavigationGuard guard = new IdeNavigationGuard();
        guard.snapshot = snapshot; guard.origin = origin; guard.tabSet = tabs;
        guard.sourceTabs = new List<TabRecord>();
        guard.session = lspSess; guard.editorBound = bound;
        guard.synchronized = synchronize && lspSess != null && lspSess.Alive();
        for (int i = 0; i < tabs.Count; i = i + 1) {
            TabRecord tab = tabs[i];
            if (!ZanIDE.NavigationSourcePath(tab.path)) { continue; }
            int version = -1;
            if (guard.synchronized && !tab.designDoc && tab.path.ToLower().EndsWith(".zan")) {
                lspSess.SyncDoc(tab.path, tab.body);
                version = lspSess.DocVersion(tab.path);
            }
            snapshot.documents.Add(IdeSourceSnapshot.Create(tab.path, tab.body, version));
            guard.sourceTabs.Add(tab);
        }
        return guard;
    }

    static bool NavigationSnapshotCurrent(IdeNavigationSnapshot snapshot,
            int workspace, int revision, int sequence, string path,
            int stamp, int line, int column, bool caret) {
        return snapshot != null && !snapshot.cancellation.IsCancellationRequested
            && snapshot.workspace == workspace && snapshot.sourceRevision == revision
            && snapshot.sequence == sequence && LspSession.SameDocumentPath(snapshot.path, path)
            && snapshot.stamp == stamp && (!caret || snapshot.line == line && snapshot.column == column);
    }

    bool NavigationGuardCurrent(IdeNavigationGuard guard, bool caret, bool sequence) {
        if (shuttingDown || guard == null || guard.tabSet != tabs || editor == null) { return false; }
        IdeNavigationSnapshot snapshot = guard.snapshot;
        int active = activeTab.Get();
        int serial = sequence ? navigationSequence : snapshot.sequence;
        if (active < 0 || active >= tabs.Count || tabs[active] != guard.origin) { return false; }
        if (guard.editorBound && editor.documentPath != snapshot.path) { return false; }
        int stamp = guard.editorBound ? editor.TextStamp() : 0;
        int line = guard.editorBound ? editor.CurLine() : guard.origin.caretLine;
        int column = guard.editorBound ? editor.CurCol() : guard.origin.caretCol;
        if (!ZanIDE.NavigationSnapshotCurrent(snapshot, navigationWorkspace,
                ZanIDE.navigationSourceRevision, serial, tabs[active].path,
                stamp, line, column, caret)) { return false; }
        int count = 0;
        for (int i = 0; i < tabs.Count; i = i + 1) {
            if (ZanIDE.NavigationSourcePath(tabs[i].path)) { count = count + 1; }
        }
        if (count != snapshot.documents.Count) { return false; }
        for (int i = 0; i < snapshot.documents.Count; i = i + 1) {
            IdeSourceSnapshot source = snapshot.documents[i];
            int tab = ZanIDE.FindNavigationTab(tabs, source.path);
            if (tab < 0 || tabs[tab] != guard.sourceTabs[i] || tabs[tab].body != source.body) { return false; }
            if (guard.synchronized && source.version >= 0 && (guard.session != lspSess
                || lspSess.DocVersion(source.path) != source.version)) { return false; }
        }
        LspResult semantic = guard.semantic;
        return semantic == null || guard.session == lspSess && lspSess.IsCurrent(
            semantic.path, semantic.version, semantic.generation, semantic.documentGeneration);
    }

    IdeNavigationGuard BeginCodeNavigation(bool synchronize, bool symbol) {
        if (shuttingDown || this.CodeNavigationBusy()) { return null; }
        navigationCancellation.Cancel();
        navigationCancellation = new CancellationTokenSource();
        navigationSequence = navigationSequence + 1;
        this.RememberTabView();
        return this.CaptureNavigation(synchronize, symbol);
    }

    static bool NavigationSourcePath(string path) {
        if (path.Length == 0 || path.StartsWith("@")) { return false; }
        string p = path.ToLower();
        return p.EndsWith(".zan") || p.EndsWith(".html") || p.EndsWith(".htm")
            || p.EndsWith(".zcomp");
    }

    static bool NavigationPathInRoot(string path, string root) {
        string normalized = ZanIDE.NormPath(root);
        while (normalized.EndsWith("/")) { normalized = normalized.Substring(0, normalized.Length - 1); }
        return normalized.Length > 0 && ZanIDE.NormPath(path).StartsWith(normalized + "/");
    }

    static IdeSourceSnapshot SnapshotSource(List<IdeSourceSnapshot> sources, string path) {
        string key = ZanIDE.NormPath(path);
        for (int i = 0; i < sources.Count; i = i + 1) {
            if (sources[i].key == key) { return sources[i]; }
        }
        return null;
    }

    static string FindMemberDeclFile(List<TabRecord> tabs, string root,
                                     string owner, string member) {
        for (int i = 0; i < tabs.Count; i = i + 1) {
            int ln = CodeEditor.FindMemberDeclLineIn(
                CodeEditor.SplitLines(tabs[i].body), owner, member);
            if (ln >= 0) {
                return tabs[i].name + ":" + Convert.ToString(ln + 1);
            }
        }
        List<string> files = ZanIDE.NameFirst(ZanIDE.NavSearchFiles(root), owner);
        for (int fi = 0; fi < files.Count; fi = fi + 1) {
            if (ZanIDE.FindTabByPath(tabs, files[fi]) >= 0) { continue; }
            int ln = CodeEditor.FindMemberDeclLineIn(
                CodeEditor.SplitLines(File.ReadAllText(files[fi])), owner, member);
            if (ln >= 0) {
                return Path.GetFileName(files[fi]) + ":" + Convert.ToString(ln + 1);
            }
        }
        return "";
    }

    static int FindMemberDecl(List<TabRecord> tabs, SignalInt active, string root,
                              string owner, string member, List<string> log) {
        int a = active.Get();
        if (a >= 0 && a < tabs.Count) {
            int ln = CodeEditor.FindMemberDeclLineIn(
                CodeEditor.SplitLines(tabs[a].body), owner, member);
            if (ln >= 0) {
                log.Add("> Definition of '" + owner + "." + member
                    + "' at line " + Convert.ToString(ln + 1) + " (this file).");
                return ln;
            }
        }
        for (int i = 0; i < tabs.Count; i = i + 1) {
            if (i == a) { continue; }
            int ln = CodeEditor.FindMemberDeclLineIn(
                CodeEditor.SplitLines(tabs[i].body), owner, member);
            if (ln >= 0) {
                active.Set(i);
                log.Add("> Definition of '" + owner + "." + member + "' in "
                    + tabs[i].name + " at line " + Convert.ToString(ln + 1) + ".");
                return ln;
            }
        }
        List<string> files = ZanIDE.NameFirst(ZanIDE.NavSearchFiles(root), owner);
        for (int fi = 0; fi < files.Count; fi = fi + 1) {
            string fp = files[fi];
            if (ZanIDE.FindTabByPath(tabs, fp) >= 0) { continue; }
            int ln = CodeEditor.FindMemberDeclLineIn(
                CodeEditor.SplitLines(File.ReadAllText(fp)), owner, member);
            if (ln >= 0) {
                ZanIDE.OpenPath(tabs, active, fp, Path.GetFileName(fp));
                log.Add("> Definition of '" + owner + "." + member + "' in "
                    + Path.GetFileName(fp) + " at line "
                    + Convert.ToString(ln + 1) + ".");
                return ln;
            }
        }
        return 0 - 1;
    }

    static int GoToDefinition(CodeEditor editor, List<TabRecord> tabs,
                              SignalInt active, string root, List<string> log) {
        string word = editor.WordAtCaret();
        if (word == "") { log.Add("> Go to Definition: no symbol under caret."); return 0 - 1; }
        int a = active.Get();
        if (a >= 0 && a < tabs.Count) { tabs[a].body = editor.GetText(); }
        string owner = editor.OwnerTypeAtCaret();
        if (owner.Length > 0) {
            int ml = ZanIDE.FindMemberDecl(tabs, active, root, owner, word, log);
            if (ml >= 0) { return ml; }
            if (CodeEditor.SymbolTypeLacksMember(owner, word)) {
                log.Add("> Go to Definition: '" + word + "' is not a member of '"
                    + owner + "'.");
                return 0 - 1;
            }
        }
        if (a >= 0 && a < tabs.Count) {
            int ln = ZanIDE.FindDeclLine(tabs[a].body, word);
            if (ln >= 0) {
                log.Add("> Definition of '" + word + "' at line " + Convert.ToString(ln + 1) + " (this file).");
                return ln;
            }
        }
        for (int i = 0; i < tabs.Count; i = i + 1) {
            if (i != a) {
                int ln = ZanIDE.FindDeclLine(tabs[i].body, word);
                if (ln >= 0) {
                    active.Set(i);
                    log.Add("> Definition of '" + word + "' in " + tabs[i].name
                        + " at line " + Convert.ToString(ln + 1) + ".");
                    return ln;
                }
            }
        }
        List<string> files = ZanIDE.NameFirst(ZanIDE.NavSearchFiles(root), word);
        for (int fi = 0; fi < files.Count; fi = fi + 1) {
            string fp = files[fi];
            if (ZanIDE.FindTabByPath(tabs, fp) < 0) {
                string body = File.ReadAllText(fp);
                int ln = ZanIDE.FindDeclLine(body, word);
                if (ln >= 0) {
                    ZanIDE.OpenPath(tabs, active, fp, Path.GetFileName(fp));
                    log.Add("> Definition of '" + word + "' in " + Path.GetFileName(fp)
                        + " at line " + Convert.ToString(ln + 1) + ".");
                    return ln;
                }
            }
        }
        string nsFile = ZanIDE.FindNamespaceDirFile(ZanIDE.StdlibDir(), word);
        if (nsFile == "") { nsFile = ZanIDE.FindNamespaceDirFile(root + "/src", word); }
        if (nsFile != "") {
            int nsTab = ZanIDE.FindTabByPath(tabs, nsFile);
            if (nsTab < 0) {
                ZanIDE.OpenPath(tabs, active, nsFile, Path.GetFileName(nsFile));
            } else {
                active.Set(nsTab);
            }
            log.Add("> Namespace '" + word + "' -> " + Path.GetFileName(nsFile) + ".");
            return 0;
        }
        log.Add("> Go to Definition: '" + word + "' not found in project.");
        return 0 - 1;
    }

    static bool SamePath(string a, string b) {
        return ZanIDE.NormPath(a) == ZanIDE.NormPath(b);
    }

    static string NormPath(string p) {
        return p.Replace("\\", "/").ToLower();
    }

    static int GoToDefinitionSmart(LspSession lsp, CodeEditor editor, List<TabRecord> tabs,
                                   SignalInt active, string root, List<string> log) {
        ZanIDE.definitionCaret = null;
        int a = active.Get();
        string normalizedRoot = ZanIDE.NormPath(root);
        while (normalizedRoot.EndsWith("/")) { normalizedRoot = normalizedRoot.Substring(0, normalizedRoot.Length - 1); }
        bool inRoot = a >= 0 && a < tabs.Count && normalizedRoot.Length > 0
            && ZanIDE.NormPath(tabs[a].path).StartsWith(normalizedRoot + "/");
        if (lsp != null && lsp.Alive() && inRoot && tabs[a].path.Length > 0) {
            string source = editor.GetText();
            int stamp = editor.TextStamp();
            int line = editor.CurLine();
            int col = editor.CurCol();
            string word = editor.WordAtCaret();
            TabRecord origin = tabs[a];
            origin.body = source;
            List<IdeRenameDocument> snapshots = ZanIDE.SyncNavigationDocuments(lsp, tabs);
            LspDefinitionTarget hit = lsp.Definition(origin.path, line, col);
            if (active.Get() != a || a >= tabs.Count || tabs[a] != origin
                || editor.TextStamp() != stamp || editor.GetText() != source
                || editor.CurLine() != line || editor.CurCol() != col
                || !ZanIDE.NavigationDocumentsCurrent(lsp, tabs, snapshots)) {
                log.Add("> Go to Definition: document changed during request.");
                return -1;
            }
            if (hit != null) {
                int target = ZanIDE.FindNavigationTab(tabs, hit.path);
                string body = target >= 0 ? tabs[target].body : "";
                if (target < 0 && File.Exists(hit.path)) { body = File.ReadAllText(hit.path); }
                List<string> ls = CodeEditor.SplitLines(body);
                if (hit.line >= 0 && hit.line < ls.Count) {
                    int byteCol = CodeEditor.Utf16ColumnToByte(ls[hit.line], hit.column);
                    if (CodeEditor.ByteColumnToUtf16(ls[hit.line], byteCol) == hit.column
                        && (target >= 0 || File.Exists(hit.path))) {
                        if (target < 0) {
                            ZanIDE.OpenPath(tabs, active, hit.path, Path.GetFileName(hit.path));
                            target = active.Get();
                        } else { active.Set(target); }
                        if (target >= 0 && target < tabs.Count && tabs[target].body == body) {
                            IdeDefinitionCaret caret = new IdeDefinitionCaret();
                            caret.body = body; caret.word = word;
                            caret.line = hit.line; caret.column = byteCol;
                            ZanIDE.definitionCaret = caret;
                            tabs[target].caretLine = hit.line;
                            tabs[target].caretCol = byteCol;
                            log.Add("> Definition in " + tabs[target].name + " at line "
                                + Convert.ToString(hit.line + 1) + ".");
                            return hit.line;
                        }
                    }
                }
            }
        }
        return ZanIDE.GoToDefinition(editor, tabs, active, root, log);
    }

    static IdeNavigationDiskText ReadNavigationDiskText(string path) {
        IdeNavigationDiskText read = new IdeNavigationDiskText();
        read.stamp = FileInfo.GetLastWriteTime(path);
        long length = FileInfo.GetLength(path);
        read.body = File.ReadAllText(path);
        if (length < 0 || read.stamp != FileInfo.GetLastWriteTime(path)
            || length != FileInfo.GetLength(path)) {
            throw new IOException("Navigation target changed while being read: " + path);
        }
        return read;
    }

    static IdeNavigationTarget PrepareNavigationTarget(string path, string body,
            int line, int column, string word, bool utf16) {
        IdeNavigationTarget result = new IdeNavigationTarget();
        List<string> lines = CodeEditor.SplitLines(body);
        if (line < 0 || line >= lines.Count) { return result; }
        int byteColumn = column;
        if (utf16) {
            byteColumn = CodeEditor.Utf16ColumnToByte(lines[line], column);
            if (CodeEditor.ByteColumnToUtf16(lines[line], byteColumn) != column) { return result; }
        } else if (column < 0) {
            byteColumn = CodeEditor.FindWordFrom(lines[line], word, 0);
            if (byteColumn < 0) { byteColumn = 0; }
        }
        result.path = path; result.body = body; result.line = line; result.column = byteColumn;
        result.prepared = TabRecord.Create(Path.GetFileName(path), body, path);
        result.prepared.preparedText = CodeEditor.PrepareText(body);
        result.prepared.preparedBody = body;
        result.valid = true;
        result.message = "> Definition in " + result.prepared.name + " at line " + Convert.ToString(line + 1) + ".";
        return result;
    }

    static IdeNavigationTarget DefinitionInSnapshot(IdeNavigationSnapshot snapshot,
            IdeProjectSourceCache cache, LspDefinitionTarget semantic) {
        if (snapshot.cancellation.IsCancellationRequested) { return new IdeNavigationTarget(); }
        if (semantic != null) {
            IdeSourceSnapshot opened = ZanIDE.SnapshotSource(snapshot.documents, semantic.path);
            bool exists = opened != null || File.Exists(semantic.path);
            IdeNavigationDiskText read = opened == null && exists ? ZanIDE.ReadNavigationDiskText(semantic.path) : null;
            string body = opened != null ? opened.body : read != null ? read.body : "";
            if (exists) {
                IdeNavigationTarget target = ZanIDE.PrepareNavigationTarget(semantic.path, body,
                    semantic.line, semantic.column, snapshot.word, true);
                if (target.valid) {
                    target.fromDisk = read != null;
                    target.diskStamp = read != null ? read.stamp : 0;
                    return target;
                }
            }
        }
        List<IdeSourceSnapshot> ordered = new List<IdeSourceSnapshot>();
        IdeSourceSnapshot origin = ZanIDE.SnapshotSource(snapshot.documents, snapshot.path);
        if (origin != null) { ordered.Add(origin); }
        for (int i = 0; i < snapshot.documents.Count; i = i + 1) {
            if (snapshot.documents[i] != origin) { ordered.Add(snapshot.documents[i]); }
        }
        List<IdeSourceSnapshot> disk = new List<IdeSourceSnapshot>();
        string hint = snapshot.owner.Length > 0 ? snapshot.owner : snapshot.word;
        for (int i = 0; i < cache.project.Count; i = i + 1) { disk.Add(cache.project[i]); }
        for (int i = 0; i < cache.library.Count; i = i + 1) { disk.Add(cache.library[i]); }
        for (int pass = 0; pass < 2; pass = pass + 1) {
            for (int i = 0; i < disk.Count; i = i + 1) {
                IdeSourceSnapshot source = disk[i];
                if (ZanIDE.SnapshotSource(snapshot.documents, source.path) != null) { continue; }
                string name = Path.GetFileName(source.path);
                int dot = name.IndexOf(".");
                if (dot >= 0) { name = name.Substring(0, dot); }
                if ((name == hint) == (pass == 0)) { ordered.Add(source); }
            }
        }
        for (int pass = 0; pass < 2; pass = pass + 1) {
            if (pass == 0 && snapshot.owner.Length == 0) { continue; }
            if (pass == 1 && snapshot.lacksMember) { break; }
            for (int i = 0; i < ordered.Count; i = i + 1) {
                if (snapshot.cancellation.IsCancellationRequested) { return new IdeNavigationTarget(); }
                IdeSourceSnapshot source = ordered[i];
                int line = pass == 0
                    ? CodeEditor.FindMemberDeclLineIn(CodeEditor.SplitLines(source.body), snapshot.owner, snapshot.word)
                    : ZanIDE.FindDeclLine(source.body, snapshot.word);
                if (line < 0) { continue; }
                string body = source.body;
                IdeNavigationDiskText read = null;
                if (ZanIDE.SnapshotSource(snapshot.documents, source.path) == null) {
                    if (!File.Exists(source.path)) { continue; }
                    read = ZanIDE.ReadNavigationDiskText(source.path);
                    body = read.body;
                    line = pass == 0
                        ? CodeEditor.FindMemberDeclLineIn(CodeEditor.SplitLines(body), snapshot.owner, snapshot.word)
                        : ZanIDE.FindDeclLine(body, snapshot.word);
                    if (line < 0) { continue; }
                }
                IdeNavigationTarget target = ZanIDE.PrepareNavigationTarget(source.path, body, line, -1, snapshot.word, false);
                target.fromDisk = read != null;
                target.diskStamp = read != null ? read.stamp : 0;
                return target;
            }
        }
        if (!snapshot.lacksMember) {
            string segment = "/" + snapshot.word + "/";
            for (int i = 0; i < disk.Count; i = i + 1) {
                if (snapshot.cancellation.IsCancellationRequested) { return new IdeNavigationTarget(); }
                IdeSourceSnapshot source = disk[i];
                if (source.path.Replace("\\", "/").IndexOf(segment) < 0) { continue; }
                IdeSourceSnapshot opened = ZanIDE.SnapshotSource(snapshot.documents, source.path);
                if (opened == null && !File.Exists(source.path)) { continue; }
                IdeNavigationDiskText read = opened == null ? ZanIDE.ReadNavigationDiskText(source.path) : null;
                string body = opened != null ? opened.body : read.body;
                IdeNavigationTarget target = ZanIDE.PrepareNavigationTarget(source.path, body, 0, 0, snapshot.word, false);
                target.fromDisk = read != null;
                target.diskStamp = read != null ? read.stamp : 0;
                target.message = "> Namespace '" + snapshot.word + "' -> " + Path.GetFileName(source.path) + ".";
                return target;
            }
        }
        IdeNavigationTarget missing = new IdeNavigationTarget();
        missing.message = snapshot.lacksMember
            ? "> Go to Definition: '" + snapshot.word + "' is not a member of '" + snapshot.owner + "'."
            : "> Go to Definition: '" + snapshot.word + "' not found in project.";
        return missing;
    }

    void GoToDefinitionAsync() {
        IdeNavigationGuard guard = this.BeginCodeNavigation(true, true);
        if (guard == null) { return; }
        if (guard.snapshot.word.Length == 0) {
            log.Add("> Go to Definition: no symbol under caret."); app.RequestRedraw(); return;
        }
        LspSession session = guard.session;
        if (session != null && session.Alive()
            && ZanIDE.NavigationPathInRoot(guard.snapshot.path, guard.snapshot.root)) {
            session.DefinitionAsync(guard.snapshot.path, guard.snapshot.line, guard.snapshot.column,
                delegate (LspDefinitionResult result) {
                    if (!this.NavigationGuardCurrent(guard, true, true)) { return; }
                    if (result != null && !session.IsCurrent(result.path, result.version,
                            result.generation, result.documentGeneration)) { return; }
                    guard.semantic = result;
                    this.StartDefinitionScan(guard, result != null ? result.target : null);
                });
        } else { this.StartDefinitionScan(guard, null); }
    }

    void StartDefinitionScan(IdeNavigationGuard guard, LspDefinitionTarget semantic) {
        this.WithProjectSources(delegate () {
            if (!this.NavigationGuardCurrent(guard, true, true)) { return; }
            IdeNavigationSnapshot snapshot = guard.snapshot;
            IdeProjectSourceCache cache = navigationSources;
            App host = app;
            navigationWork.Run(delegate () {
                IdeNavigationTarget result = new IdeNavigationTarget();
                try { result = ZanIDE.DefinitionInSnapshot(snapshot, cache, semantic); }
                catch (Exception error) {
                    result.message = "> Go to Definition: " + error.Message;
                }
                if (snapshot.cancellation.IsCancellationRequested) { return; }
                host.Post(delegate () { this.ApplyNavigationTarget(guard, result); });
            });
        });
    }

    void ApplyNavigationTarget(IdeNavigationGuard guard, IdeNavigationTarget result) {
        if (!this.NavigationGuardCurrent(guard, true, true) || this.CodeNavigationBusy()) { return; }
        if (result.message.Length > 0) { log.Add(result.message); }
        if (!result.valid) { app.RequestRedraw(); return; }
        int tab = ZanIDE.FindNavigationTab(tabs, result.path);
        if (tab < 0) {
            if (!result.fromDisk) { return; }
            tabs.Add(result.prepared);
            this.TrackPreparedDocument(result.path, result.body, result.diskStamp);
            tab = tabs.Count - 1;
        } else {
            if (tabs[tab].body != result.body) { return; }
            tabs[tab].preparedText = result.prepared.preparedText;
            tabs[tab].preparedBody = result.body;
        }
        tabs[tab].caretLine = result.line; tabs[tab].caretCol = result.column;
        activeTab.Set(tab);
        pendingGotoLine = result.line; pendingGotoCol = result.column;
        lastActive = -1;
        this.UpdateActiveCodeTab();
        app.RequestRedraw();
    }
}
