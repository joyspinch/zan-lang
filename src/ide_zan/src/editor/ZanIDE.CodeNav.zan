using System;
using System.IO;
using System.Diagnostics;
using System.Json;
using System.Threading;
using Gui;
using Gui.Widget;
using Gui.Component;
using Gui.Designer;
using Game.Scene;

partial class ZanIDE {
    static IdeDefinitionCaret definitionCaret;
    static int navigationSourceRevision;
    static int projectSourceReadCursor;
    int navigationWorkspace;
    int navigationSequence;
    int projectFeedSequence;
    CancellationTokenSource navigationCancellation = new CancellationTokenSource();
    CancellationTokenSource projectSourceCancellation = new CancellationTokenSource();
    CancellationTokenSource projectFeedCancellation = new CancellationTokenSource();
    IdeProjectSourceCache navigationSources;
    IdeProjectSourceRead projectSourceRead;
    List<Action> projectSourceWaiters = new List<Action>();
    List<Action> navigationIdleWaiters = new List<Action>();
    List<IdeRenameHistoryItem> renameHistory = new List<IdeRenameHistoryItem>();
    bool navigationCommitBusy;
    bool navigationCommitWaiting;
    bool navigationDocumentWritesPaused;
    bool navigationDesignWritesPaused;
    IdeCodeNavigationWork navigationWork = new IdeCodeNavigationWork();

    bool CodeNavigationBusy() { return navigationCommitWaiting || navigationCommitBusy; }

    async void DrainCodeNavigationAsync() { await navigationWork.DrainAsync(); }

    void CancelCodeNavigation() {
        navigationWorkspace = navigationWorkspace + 1;
        navigationSequence = navigationSequence + 1;
        projectFeedSequence = projectFeedSequence + 1;
        projectFeedCancellation.Cancel();
        projectFeedCancellation = new CancellationTokenSource();
        navigationCancellation.Cancel();
        navigationCancellation = new CancellationTokenSource();
        projectSourceCancellation.Cancel();
        projectSourceCancellation = new CancellationTokenSource();
        projectSourceRead = null;
        navigationSources = null;
        projectSourceWaiters.Clear();
    }

    void CancelCodeNavigationThen(Action continuation) {
        this.CancelCodeNavigation();
        if (continuation == null) { return; }
        if (this.CodeNavigationBusy()) { navigationIdleWaiters.Add(continuation); }
        else { app.Post(continuation); }
    }

    void ReleaseNavigationCommit() {
        if (navigationDesignWritesPaused) {
            navigationDesignWritesPaused = false;
            this.ResumeDesignWrites();
        }
        if (navigationDocumentWritesPaused) {
            navigationDocumentWritesPaused = false;
            this.ResumeDocumentWrites();
        }
        navigationCommitWaiting = false;
        navigationCommitBusy = false;
        List<Action> waiting = navigationIdleWaiters;
        navigationIdleWaiters = new List<Action>();
        for (int i = 0; i < waiting.Count; i = i + 1) { app.Post(waiting[i]); }
        app.RequestRedraw();
    }

    IdeNavigationGuard CaptureNavigation(bool synchronize, bool symbol) {
        if (shuttingDown) { return null; }
        int active = activeTab.Get();
        if (active < 0 || active >= tabs.Count || editor == null) { return null; }
        TabRecord origin = tabs[active];
        bool bound = origin.path == editor.documentPath && !origin.designDoc
            && !origin.path.StartsWith("@");
        if (symbol && (!bound || origin.path.Length == 0)) { return null; }
        string text = bound ? editor.GetText() : origin.body;
        if (bound) { origin.body = text; }
        IdeNavigationSnapshot snapshot = new IdeNavigationSnapshot();
        snapshot.root = root; snapshot.path = origin.path; snapshot.body = text;
        snapshot.workspace = navigationWorkspace;
        snapshot.sourceRevision = ZanIDE.navigationSourceRevision;
        snapshot.designRevision = this.DesignDocumentRevision();
        snapshot.sequence = navigationSequence;
        snapshot.stamp = bound ? editor.TextStamp() : 0;
        snapshot.line = bound ? editor.CurLine() : origin.caretLine;
        snapshot.column = bound ? editor.CurCol() : origin.caretCol;
        snapshot.word = symbol ? editor.WordAtCaret() : "";
        snapshot.owner = symbol ? editor.OwnerTypeAtCaret() : "";
        snapshot.referenceOwner = snapshot.owner;
        if (symbol && snapshot.referenceOwner.Length == 0) {
            snapshot.referenceOwner = editor.EnclosingTypeOfCaretDecl();
        }
        snapshot.family = new List<string>();
        if (snapshot.referenceOwner.Length > 0) {
            snapshot.family.Add(snapshot.referenceOwner);
            CodeEditor.SymbolSubtypesOf(snapshot.referenceOwner, snapshot.family);
            snapshot.lacksReferenceMember = CodeEditor.SymbolTypeLacksMember(
                snapshot.referenceOwner, snapshot.word);
        }
        snapshot.lacksMember = snapshot.owner.Length > 0
            && CodeEditor.SymbolTypeLacksMember(snapshot.owner, snapshot.word);
        snapshot.documents = new List<IdeSourceSnapshot>();
        snapshot.cancellation = navigationCancellation.Token;
        IdeNavigationGuard guard = new IdeNavigationGuard();
        guard.snapshot = snapshot; guard.origin = origin; guard.tabSet = tabs;
        guard.sourceTabs = new List<TabRecord>();
        guard.session = lspSess; guard.editorBound = bound;
        guard.synchronized = synchronize && lspSess != null && lspSess.Alive();
        for (int i = 0; i < tabs.Count; i = i + 1) {
            TabRecord tab = tabs[i];
            if (!ZanIDE.NavigationSourcePath(tab.path)) { continue; }
            int version = -1;
            if (guard.synchronized && !tab.designDoc && tab.path.ToLower().EndsWith(".zan")) {
                lspSess.SyncDoc(tab.path, tab.body);
                version = lspSess.DocVersion(tab.path);
            }
            snapshot.documents.Add(IdeSourceSnapshot.Create(tab.path, tab.body, version));
            guard.sourceTabs.Add(tab);
        }
        return guard;
    }

    static bool NavigationSnapshotCurrent(IdeNavigationSnapshot snapshot,
            int workspace, int revision, int sequence, string path,
            int stamp, int line, int column, bool caret) {
        return snapshot != null && !snapshot.cancellation.IsCancellationRequested
            && snapshot.workspace == workspace && snapshot.sourceRevision == revision
            && snapshot.sequence == sequence && LspSession.SameDocumentPath(snapshot.path, path)
            && snapshot.stamp == stamp && (!caret || snapshot.line == line && snapshot.column == column);
    }

    bool NavigationGuardCurrent(IdeNavigationGuard guard, bool caret, bool sequence) {
        if (shuttingDown || guard == null || guard.tabSet != tabs || editor == null) { return false; }
        IdeNavigationSnapshot snapshot = guard.snapshot;
        int active = activeTab.Get();
        int serial = sequence ? navigationSequence : snapshot.sequence;
        if (active < 0 || active >= tabs.Count || tabs[active] != guard.origin) { return false; }
        if (guard.editorBound && editor.documentPath != snapshot.path) { return false; }
        int stamp = guard.editorBound ? editor.TextStamp() : 0;
        int line = guard.editorBound ? editor.CurLine() : guard.origin.caretLine;
        int column = guard.editorBound ? editor.CurCol() : guard.origin.caretCol;
        if (!ZanIDE.NavigationSnapshotCurrent(snapshot, navigationWorkspace,
                ZanIDE.navigationSourceRevision, serial, tabs[active].path,
                stamp, line, column, caret)) { return false; }
        int count = 0;
        for (int i = 0; i < tabs.Count; i = i + 1) {
            if (ZanIDE.NavigationSourcePath(tabs[i].path)) { count = count + 1; }
        }
        if (count != snapshot.documents.Count) { return false; }
        for (int i = 0; i < snapshot.documents.Count; i = i + 1) {
            IdeSourceSnapshot source = snapshot.documents[i];
            int tab = ZanIDE.FindNavigationTab(tabs, source.path);
            if (tab < 0 || tabs[tab] != guard.sourceTabs[i] || tabs[tab].body != source.body) { return false; }
            if (guard.synchronized && source.version >= 0 && (guard.session != lspSess
                || lspSess.DocVersion(source.path) != source.version)) { return false; }
        }
        LspResult semantic = guard.semantic;
        return semantic == null || guard.session == lspSess && lspSess.IsCurrent(
            semantic.path, semantic.version, semantic.generation, semantic.documentGeneration);
    }

    IdeNavigationGuard BeginCodeNavigation(bool synchronize, bool symbol) {
        if (shuttingDown || this.CodeNavigationBusy()) { return null; }
        navigationCancellation.Cancel();
        navigationCancellation = new CancellationTokenSource();
        navigationSequence = navigationSequence + 1;
        this.RememberTabView();
        return this.CaptureNavigation(synchronize, symbol);
    }

    static bool NavigationSourcePath(string path) {
        if (path.Length == 0 || path.StartsWith("@")) { return false; }
        string p = path.ToLower();
        return p.EndsWith(".zan") || p.EndsWith(".html") || p.EndsWith(".htm")
            || p.EndsWith(".zcomp");
    }

    static bool NavigationPathInRoot(string path, string root) {
        string normalized = ZanIDE.NormPath(root);
        while (normalized.EndsWith("/")) { normalized = normalized.Substring(0, normalized.Length - 1); }
        return normalized.Length > 0 && ZanIDE.NormPath(path).StartsWith(normalized + "/");
    }

    static IdeSourceSnapshot SnapshotSource(List<IdeSourceSnapshot> sources, string path) {
        string key = ZanIDE.NormPath(path);
        for (int i = 0; i < sources.Count; i = i + 1) {
            if (sources[i].key == key) { return sources[i]; }
        }
        return null;
    }

    static List<IdeSourceSnapshot> ReadSourceSnapshots(string directory, CancellationToken cancellation) {
        List<IdeSourceSnapshot> sources = new List<IdeSourceSnapshot>();
        if (directory.Length == 0 || cancellation.IsCancellationRequested) { return sources; }
        List<string> paths = ZanIDE.ListZanFiles(directory);
        for (int i = 0; i < paths.Count; i = i + 1) {
            if (cancellation.IsCancellationRequested) { return sources; }
            string path = paths[i];
            if (!path.ToLower().EndsWith(".zan") || !File.Exists(path)) { continue; }
            sources.Add(IdeSourceSnapshot.Create(path, File.ReadAllText(path), 0));
        }
        return sources;
    }

    static IdeProjectSourceCache LoadProjectSourceSnapshot(IdeProjectSourceRead request) {
        IdeProjectSourceCache cache = new IdeProjectSourceCache();
        cache.root = request.root; cache.workspace = request.workspace; cache.revision = request.revision;
        cache.search = new List<IdeSourceSnapshot>();
        cache.project = ZanIDE.ReadSourceSnapshots(request.root, request.cancellation);
        cache.library = request.library;
        if (cache.library == null) {
            cache.library = ZanIDE.ReadSourceSnapshots(ZanIDE.StdlibDir(), request.cancellation);
        }
        cache.byPath = new Dictionary<string, IdeSourceSnapshot>();
        for (int i = 0; i < cache.library.Count; i = i + 1) {
            cache.byPath[cache.library[i].key] = cache.library[i];
        }
        for (int i = 0; i < cache.project.Count; i = i + 1) {
            cache.byPath[cache.project[i].key] = cache.project[i];
        }
        if (request.cancellation.IsCancellationRequested || request.root.Length == 0) { return cache; }
        List<string> searchPaths = new List<string>();
        ZanIDE.GatherZanFiles(request.root, searchPaths);
        for (int i = 0; i < searchPaths.Count; i = i + 1) {
            if (request.cancellation.IsCancellationRequested) { return cache; }
            string key = ZanIDE.NormPath(searchPaths[i]);
            if (!cache.byPath.ContainsKey(key) && File.Exists(searchPaths[i])) {
                cache.byPath[key] = IdeSourceSnapshot.Create(searchPaths[i], File.ReadAllText(searchPaths[i]), 0);
            }
            if (cache.byPath.ContainsKey(key)) { cache.search.Add(cache.byPath[key]); }
        }
        return cache;
    }

    void WithProjectSources(Action ready) {
        if (shuttingDown) { return; }
        if (navigationSources != null && navigationSources.root == root
            && navigationSources.workspace == navigationWorkspace
            && navigationSources.revision == ZanIDE.navigationSourceRevision) {
            ready();
            return;
        }
        bool current = projectSourceRead != null && projectSourceRead.root == root
            && projectSourceRead.workspace == navigationWorkspace
            && projectSourceRead.revision == ZanIDE.navigationSourceRevision;
        if (!current) {
            projectSourceCancellation.Cancel();
            projectSourceCancellation = new CancellationTokenSource();
            projectSourceWaiters.Clear();
            IdeProjectSourceRead request = new IdeProjectSourceRead();
            request.root = root; request.workspace = navigationWorkspace;
            request.revision = ZanIDE.navigationSourceRevision;
            request.library = navigationSources != null && navigationSources.revision == request.revision
                ? navigationSources.library : null;
            request.cancellation = projectSourceCancellation.Token;
            projectSourceRead = request;
            App host = app;
            navigationWork.Run(delegate () {
                IdeProjectSourceCache result = null;
                string failure = "";
                try { result = ZanIDE.LoadProjectSourceSnapshot(request); }
                catch (Exception error) {
                    failure = error.Message;
                }
                if (request.cancellation.IsCancellationRequested) { return; }
                host.Post(delegate () { this.CompleteProjectSources(request, result, failure); });
            });
        }
        projectSourceWaiters.Add(ready);
    }

    void CompleteProjectSources(IdeProjectSourceRead request, IdeProjectSourceCache cache, string failure) {
        if (request != projectSourceRead || request.cancellation.IsCancellationRequested
            || request.workspace != navigationWorkspace || request.root != root
            || request.revision != ZanIDE.navigationSourceRevision) { return; }
        projectSourceRead = null;
        if (failure != "" || cache == null) {
            projectSourceWaiters.Clear();
            log.Add("> Project sources: " + failure);
            app.RequestRedraw();
            return;
        }
        navigationSources = cache;
        List<Action> waiting = projectSourceWaiters;
        projectSourceWaiters = new List<Action>();
        for (int i = 0; i < waiting.Count; i = i + 1) { waiting[i](); }
    }

    static List<IdeSourceSnapshot> MergeSourceSnapshots(List<IdeSourceSnapshot> project,
            List<IdeSourceSnapshot> documents) {
        Dictionary<string, IdeSourceSnapshot> opened = new Dictionary<string, IdeSourceSnapshot>();
        for (int i = 0; i < documents.Count; i = i + 1) { opened[documents[i].key] = documents[i]; }
        List<IdeSourceSnapshot> merged = new List<IdeSourceSnapshot>();
        Dictionary<string, bool> seen = new Dictionary<string, bool>();
        for (int i = 0; i < project.Count; i = i + 1) {
            IdeSourceSnapshot source = project[i];
            merged.Add(opened.ContainsKey(source.key) ? opened[source.key] : source);
            seen[source.key] = true;
        }
        for (int i = 0; i < documents.Count; i = i + 1) {
            if (!seen.ContainsKey(documents[i].key)) { merged.Add(documents[i]); }
        }
        return merged;
    }

    static List<string> ProjectSourceBodies(IdeProjectSourceCache cache,
            IdeNavigationSnapshot snapshot) {
        List<IdeSourceSnapshot> sources = ZanIDE.MergeSourceSnapshots(cache.project, snapshot.documents);
        List<string> bodies = new List<string>();
        string skip = ZanIDE.NormPath(snapshot.path);
        for (int i = 0; i < sources.Count; i = i + 1) {
            if (sources[i].key != skip && sources[i].path.ToLower().EndsWith(".zan")) {
                bodies.Add(sources[i].body);
            }
        }
        return bodies;
    }

    void RequestProjectSourcesAsync() {
        if (!haveProject || editor == null) { return; }
        IdeNavigationGuard guard = this.CaptureNavigation(false, false);
        if (guard == null || !guard.editorBound) { return; }
        projectFeedCancellation.Cancel();
        projectFeedCancellation = new CancellationTokenSource();
        guard.snapshot.cancellation = projectFeedCancellation.Token;
        projectFeedSequence = projectFeedSequence + 1;
        int feed = projectFeedSequence;
        this.WithProjectSources(delegate () {
            if (feed != projectFeedSequence || !this.NavigationGuardCurrent(guard, false, false)) { return; }
            IdeProjectSourceCache cache = navigationSources;
            IdeNavigationSnapshot snapshot = guard.snapshot;
            App host = app;
            navigationWork.Run(delegate () {
                List<string> bodies = ZanIDE.ProjectSourceBodies(cache, snapshot);
                if (snapshot.cancellation.IsCancellationRequested) { return; }
                host.Post(delegate () {
                    if (feed != projectFeedSequence || !this.NavigationGuardCurrent(guard, false, false)) { return; }
                    editor.SetProjectFiles(bodies);
                    projSrcFeed = false;
                    app.RequestRedraw();
                });
            });
        });
    }

    static string RTrimS(string s) {
        int e = s.Length;
        while (e > 0) {
            string ch = s.Substring(e - 1, 1);
            if (ch == " " || ch == "\t") { e = e - 1; } else { break; }
        }
        return s.Substring(0, e);
    }

    static bool StartsWithWord(string after, string word) {
        int wl = word.Length;
        if (after.Length < wl) { return false; }
        if (after.Substring(0, wl) != word) { return false; }
        if (after.Length == wl) { return true; }
        return !CodeEditor.IsIdentByte(after[wl]);
    }

    static bool IsTypeDecl(string line, string word) {
        string s = CodeEditor.LTrim(line);
        List<string> kws = new List<string>{
            "class ", "struct ", "enum ", "interface ", "namespace " };
        for (int i = 0; i < kws.Count; i = i + 1) {
            string kw = kws[i];
            if (s.Length >= kw.Length && s.Substring(0, kw.Length) == kw) {
                string after = s.Substring(kw.Length, s.Length - kw.Length);
                if (ZanIDE.StartsWithWord(CodeEditor.LTrim(after), word)) { return true; }
            }
        }
        return false;
    }

    static int FindWordCall(string s, string word) {
        int wl = word.Length;
        if (wl == 0 || s == null) { return 0 - 1; }
        for (int i = 0; i + wl < s.Length; i = i + 1) {
            if ((s[i + wl] & 255) == 40 && s.Substring(i, wl) == word) {
                bool leftOk = true;
                if (i > 0) { leftOk = !CodeEditor.IsIdentByte(s[i - 1]); }
                if (leftOk) { return i; }
            }
        }
        return 0 - 1;
    }

    static bool IsMethodDef(string line, string word) {
        string s = CodeEditor.LTrim(line);
        if (ZanIDE.StartsWithWord(s, "if") || ZanIDE.StartsWithWord(s, "while")
            || ZanIDE.StartsWithWord(s, "for") || ZanIDE.StartsWithWord(s, "foreach")
            || ZanIDE.StartsWithWord(s, "switch") || ZanIDE.StartsWithWord(s, "return")
            || ZanIDE.StartsWithWord(s, "else")) { return false; }
        int pos = ZanIDE.FindWordCall(s, word);
        if (pos <= 0) { return false; }
        if (s.Substring(pos - 1, 1) != " ") { return false; }
        string rt = ZanIDE.RTrimS(s);
        if (rt.Length == 0) { return false; }
        string last = rt.Substring(rt.Length - 1, 1);
        if (last == "{" || last == ")") { return true; }
        return CodeEditor.DeclNameAt(s) == word;
    }

    static int FindDeclLine(string body, string word) {
        List<string> ls = CodeEditor.SplitLines(body);
        for (int i = 0; i < ls.Count; i = i + 1) {
            if (ZanIDE.IsTypeDecl(ls[i], word)) { return i; }
        }
        for (int k = 0; k < ls.Count; k = k + 1) {
            if (ZanIDE.IsMethodDef(ls[k], word)) { return k; }
        }
        return 0 - 1;
    }

    static int OutlineBraceDelta(string line) {
        int delta = 0;
        bool inStr = false;
        bool inChar = false;
        for (int i = 0; i < line.Length; i = i + 1) {
            string ch = line.Substring(i, 1);
            if (inStr) {
                if (ch == "\\") { i = i + 1; }
                else if (ch == "\"") { inStr = false; }
            } else if (inChar) {
                if (ch == "\\") { i = i + 1; }
                else if (ch == "'") { inChar = false; }
            } else {
                if (ch == "/" && i + 1 < line.Length && line.Substring(i + 1, 1) == "/") {
                    return delta;
                } else if (ch == "\"") { inStr = true; }
                else if (ch == "'") { inChar = true; }
                else if (ch == "{") { delta = delta + 1; }
                else if (ch == "}") { delta = delta - 1; }
            }
        }
        return delta;
    }

    static bool OutlineIsIdentChar(string ch) {
        if (ch == null || ch.Length == 0) { return false; }
        return CodeEditor.IsIdentByte(ch[0]);
    }

    static string OutlineIdent(string tok) {
        if (tok == null || tok.Length == 0) { return ""; }
        int i = 0;
        int len = tok.Length;
        while (i < len && CodeEditor.IsIdentByte(tok[i])) {
            i = i + 1;
        }
        if (i == 0) { return ""; }
        return tok.Substring(0, i);
    }

    static int OutlineFind(string s, string ch) {
        if (s == null || ch == null || ch.Length == 0) { return 0 - 1; }
        return s.IndexOf(ch);
    }

    static string OutlineTypeName(string s) {
        List<string> toks = ZanIDE.SplitSpaces(s);
        for (int i = 0; i < toks.Count; i = i + 1) {
            string tk = toks[i];
            if (tk == "class" || tk == "struct" || tk == "enum" || tk == "interface") {
                if (i + 1 < toks.Count) { return ZanIDE.OutlineIdent(toks[i + 1]); }
                return "";
            }
        }
        return "";
    }

    static string OutlineMethodName(string s) {
        int paren = ZanIDE.OutlineFind(s, "(");
        if (paren <= 0) { return ""; }
        string header = s.Substring(0, paren);
        if (ZanIDE.OutlineFind(header, "=") >= 0) { return ""; }
        string rt = ZanIDE.RTrimS(s);
        if (rt.Length == 0) { return ""; }
        string last = rt.Substring(rt.Length - 1, 1);
        if (last != "{" && last != ")") { return ""; }
        List<string> toks = ZanIDE.SplitSpaces(header);
        if (toks.Count < 2) { return ""; }
        string name = ZanIDE.OutlineIdent(toks[toks.Count - 1]);
        if (name == "") { return ""; }
        if (name == "if" || name == "while" || name == "for" || name == "foreach"
            || name == "switch" || name == "catch" || name == "lock" || name == "using") {
            return "";
        }
        return name + "()";
    }

    static string OutlineFieldName(string s) {
        string rt = ZanIDE.RTrimS(s);
        if (rt.Length == 0) { return ""; }
        if (rt.Substring(rt.Length - 1, 1) != ";") { return ""; }
        string decl = rt.Substring(0, rt.Length - 1);
        int eq = ZanIDE.OutlineFind(decl, "=");
        if (eq >= 0) { decl = decl.Substring(0, eq); }
        if (ZanIDE.OutlineFind(decl, "(") >= 0) { return ""; }
        List<string> toks = ZanIDE.SplitSpaces(decl);
        if (toks.Count < 2) { return ""; }
        string first = toks[0];
        if (first == "return" || first == "using" || first == "namespace"
            || first == "throw" || first == "break" || first == "continue"
            || first == "case" || first == "default") {
            return "";
        }
        return ZanIDE.OutlineIdent(toks[toks.Count - 1]);
    }

    static List<TreeNode> BuildOutline(string body) {
        List<TreeNode> outp = new List<TreeNode>();
        List<string> ls = CodeEditor.SplitLines(body);
        int depth = 0;
        int bodyDepth = 0 - 1;
        for (int i = 0; i < ls.Count; i = i + 1) {
            string raw = ls[i];
            string s = CodeEditor.LTrim(raw);
            int startDepth = depth;
            bool isComment = false;
            if (s.Length >= 1 && s.Substring(0, 1) == "*") { isComment = true; }
            if (s.Length >= 2) {
                string p2 = s.Substring(0, 2);
                if (p2 == "//" || p2 == "/*") { isComment = true; }
            }
            if (!isComment) {
                if (startDepth == 0) {
                    string tn = ZanIDE.OutlineTypeName(s);
                    if (tn != "") {
                        TreeNode n = TreeNode.Dir(tn, 0, true);
                        n.icon = "code";
                        n.path = Convert.ToString(i);
                        outp.Add(n);
                        bodyDepth = 1;
                    }
                } else if (bodyDepth >= 0 && startDepth == bodyDepth) {
                    string mn = ZanIDE.OutlineMethodName(s);
                    if (mn != "") {
                        TreeNode n = TreeNode.FileIcon(mn, 1, "play");
                        n.path = Convert.ToString(i);
                        outp.Add(n);
                    } else {
                        string fn = ZanIDE.OutlineFieldName(s);
                        if (fn != "") {
                            TreeNode n = TreeNode.FileIcon(fn, 1, "minus");
                            n.path = Convert.ToString(i);
                            outp.Add(n);
                        }
                    }
                }
            }
            depth = depth + ZanIDE.OutlineBraceDelta(raw);
            if (depth < 0) { depth = 0; }
        }
        return outp;
    }

    static string ComponentIcon(string type) {
        if (type == "Label") { return "font"; }
        if (type == "Button") { return "grid"; }
        if (type == "Input" || type == "TextBox" || type == "TextArea") { return "edit"; }
        if (type == "Checkbox" || type == "Radio" || type == "Switch") { return "check"; }
        if (type == "Image") { return "image"; }
        if (type == "Table" || type == "Grid" || type == "TreeView") { return "table"; }
        return "layout";
    }

    static void FlattenFields(List<FormField> fields, List<FormField> outp) {
        for (int i = 0; i < fields.Count; i = i + 1) {
            outp.Add(fields[i]);
            if (fields[i].IsContainer()) {
                ZanIDE.FlattenFields(fields[i].kids, outp);
            }
        }
    }

    static List<TreeNode> BuildFieldTree(string formName, List<FormField> fields) {
        List<TreeNode> outp = new List<TreeNode>();
        TreeNode root = TreeNode.Dir(formName, 0, true);
        root.icon = "layout";
        root.path = "@form";
        outp.Add(root);
        List<FormField> flat = new List<FormField>();
        ZanIDE.FlattenFields(fields, flat);
        ZanIDE.AddFieldNodes(outp, fields, flat, 1);
        return outp;
    }

    static List<TreeNode> BuildSceneTree(string sceneName, SceneDesigner sd) {
        List<TreeNode> outp = new List<TreeNode>();
        TreeNode root = TreeNode.Dir(sceneName, 0, true);
        root.icon = "layout";
        root.path = "@scene";
        outp.Add(root);
        List<SceneElement> ord = sd.OrderedByZ();
        for (int i = ord.Count - 1; i >= 0; i = i - 1) {
            SceneElement e = ord[i];
            string nm = SceneDesigner.KindLabel(e.Kind());
            if (e.Name().Length > 0) { nm = nm + " · " + e.Name(); }
            if (e.Locked()) { nm = "◈ " + nm; }
            TreeNode n = TreeNode.FileIcon(nm, 1, "layout");
            n.path = Convert.ToString(i);
            outp.Add(n);
        }
        return outp;
    }

    static void AddFieldNodes(List<TreeNode> outp, List<FormField> fields,
                              List<FormField> flat, int depth) {
        for (int i = 0; i < fields.Count; i = i + 1) {
            FormField f = fields[i];
            string nm = f.fname;
            if (nm.Length == 0) { nm = f.label; }
            TreeNode n = TreeNode.FileIcon(nm + " : " + FormField.TypeName(f.ftype), depth, "layout");
            for (int fi = 0; fi < flat.Count; fi = fi + 1) {
                if (flat[fi] == f) { n.path = Convert.ToString(fi); fi = flat.Count; }
            }
            outp.Add(n);
            if (f.IsContainer()) {
                ZanIDE.AddFieldNodes(outp, f.kids, flat, depth + 1);
            }
        }
    }

    static int OutlineLineOf(string path) {
        if (path == "") { return 0 - 1; }
        string digits = "0123456789";
        int val = 0;
        for (int i = 0; i < path.Length; i = i + 1) {
            string ch = path.Substring(i, 1);
            int d = ZanIDE.OutlineFind(digits, ch);
            if (d < 0) { return 0 - 1; }
            val = val * 10 + d;
        }
        return val;
    }

    static void LoadUserComponents(string root, Designer d) {
        List<UserComponent> comps = new List<UserComponent>();
        string dir = root + "/components";
        List<string> files = DirectoryTree.Names(dir, PathFilter.Only(".zcomp"));
        for (int i = 0; i < files.Count; i = i + 1) {
            string nm = files[i];
            comps.Add(new UserComponent(nm.Substring(0, nm.Length - 6),
                File.ReadAllText(dir + "/" + nm)));
        }
        d.SetUserComponents(comps);
    }

    static string SanitizeName(string s) {
        string ok = "abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ0123456789_";
        string r = "";
        for (int i = 0; i < s.Length; i = i + 1) {
            string ch = s.Substring(i, 1);
            int j = 0;
            while (j < ok.Length) {
                if (ok.Substring(j, 1) == ch) { r = r + ch; j = ok.Length; }
                else { j = j + 1; }
            }
        }
        return r;
    }

    static bool IsGuiReservedName(string name) {
        List<string> reserved = new List<string>{
            "App", "Canvas", "Window", "Layer", "Theme", "Designer",
            "Button", "Label", "Input", "Slider", "Panel", "TreeNode", "CodeEditor",
            "String", "Convert", "Math", "File", "Directory", "Path", "Process",
            "List", "Timer", "Program", "System", "Gui" };
        for (int i = 0; i < reserved.Count; i = i + 1) {
            if (reserved[i] == name) { return true; }
        }
        return false;
    }

    static List<string> ListZanFiles(string dir) {
        List<string> outp = new List<string>();
        ZanIDE.CollectZan(dir, outp);
        return outp;
    }

    static string FindNamespaceDirFile(string dir, string name) {
        List<string> subs = DirectoryTree.SubNames(dir, PathFilter.Any());
        for (int i = 0; i < subs.Count; i = i + 1) {
            string sub = dir + "/" + subs[i];
            if (subs[i] == name) {
                List<string> inner = ZanIDE.ListZanFiles(sub);
                if (inner.Count > 0) { return inner[0]; }
            }
            string deep = ZanIDE.FindNamespaceDirFile(sub, name);
            if (deep != "") { return deep; }
        }
        return "";
    }

    static void CollectZan(string dir, List<string> outp) {
        DirectoryTree.FilesInto(outp, dir,
            PathFilter.Only(".zan .html .htm").Skip("build bin obj"));
    }

    static int ColOfWordAt(string body, int ln, string word) {
        // shell 的 ApplyGotoResult 仍用此接口；一次性消费已验证的语义目标列。
        IdeDefinitionCaret caret = ZanIDE.definitionCaret;
        ZanIDE.definitionCaret = null;
        if (caret != null && caret.body == body && caret.line == ln && caret.word == word) { return caret.column; }
        if (word.Length == 0) { return 0; }
        List<string> ls = CodeEditor.SplitLines(body);
        if (ln < 0 || ln >= ls.Count) { return 0; }
        int p = CodeEditor.FindWordFrom(ls[ln], word, 0);
        if (p < 0) { return 0; }
        return p;
    }

    //
    static List<string> NavSearchFiles(string root) {
        if (ZanIDE.navFiles != null && ZanIDE.navFilesRoot == root) {
            return ZanIDE.navFiles;
        }
        List<string> files = ZanIDE.ListZanFiles(root + "/src");
        List<string> std = ZanIDE.ListZanFiles(ZanIDE.StdlibDir());
        for (int i = 0; i < std.Count; i = i + 1) { files.Add(std[i]); }
        ZanIDE.navFiles = files;
        ZanIDE.navFilesRoot = root;
        return files;
    }

    static void InvalidateNavFiles() {
        ZanIDE.navFiles = null;
        ZanIDE.navFilesRoot = "";
        ZanIDE.projSources = null;
        ZanIDE.projSrcRoot = "";
        ZanIDE.projectSourceReadCursor = 0;
        ZanIDE.navigationSourceRevision = ZanIDE.navigationSourceRevision + 1;
    }

    static List<string> ProjectSources(List<TabRecord> tabs, string root,
                                       int skipTab) {
        List<string> outp = new List<string>();
        List<ProjectSourceItem> cached = ZanIDE.projSrcRoot == root
            ? ZanIDE.projSources : null;
        if (cached == null) { cached = new List<ProjectSourceItem>(); }
        for (int i = 0; i < cached.Count; i = i + 1) {
            ProjectSourceItem item = cached[i];
            int t = ZanIDE.FindTabByPath(tabs, item.path);
            if (t == skipTab) { continue; }
            if (t >= 0) { outp.Add(tabs[t].body); }
            else { outp.Add(item.body); }
        }
        for (int j = 0; j < tabs.Count; j = j + 1) {
            if (j == skipTab) { continue; }
            if (tabs[j].path.Length == 0 || tabs[j].path == "@start"
                || tabs[j].path == "@docs") { continue; }
            if (!tabs[j].path.EndsWith(".zan")) { continue; }
            if (ZanIDE.HasSameSourcePath(cached, tabs[j].path)) { continue; }
            outp.Add(tabs[j].body);
        }
        return outp;
    }

    static bool ProjectSourcesStep(string root, int kbBudget) {
        if (ZanIDE.projSources == null || ZanIDE.projSrcRoot != root) {
            ZanIDE.projSources = new List<ProjectSourceItem>();
            List<string> all = ZanIDE.ListZanFiles(root);
            for (int i = 0; i < all.Count; i = i + 1) {
                if (!all[i].EndsWith(".zan")) { continue; }
                ZanIDE.projSources.Add(new ProjectSourceItem(all[i], ""));
            }
            ZanIDE.projSrcRoot = root;
            ZanIDE.projectSourceReadCursor = 0;
        }
        int spent = 0;
        while (ZanIDE.projectSourceReadCursor < ZanIDE.projSources.Count) {
            if (kbBudget > 0 && spent >= kbBudget) { return false; }
            ProjectSourceItem item = ZanIDE.projSources[ZanIDE.projectSourceReadCursor];
            item.body = File.ReadAllText(item.path);
            ZanIDE.projectSourceReadCursor = ZanIDE.projectSourceReadCursor + 1;
            spent = spent + item.body.Length / 1024 + 1;
        }
        return true;
    }

    static bool HasSameSourcePath(List<ProjectSourceItem> items, string p) {
        if (items == null) { return false; }
        for (int i = 0; i < items.Count; i = i + 1) {
            if (ZanIDE.SamePath(items[i].path, p)) { return true; }
        }
        return false;
    }

    static bool HasSamePath(List<string> paths, string p) {
        for (int i = 0; i < paths.Count; i = i + 1) {
            if (ZanIDE.SamePath(paths[i], p)) { return true; }
        }
        return false;
    }

    static List<string> NameFirst(List<string> files, string hint) {
        if (hint.Length == 0) { return files; }
        List<string> head = new List<string>();
        List<string> tail = new List<string>();
        for (int i = 0; i < files.Count; i = i + 1) {
            string b = Path.GetFileName(files[i]);
            int dot = ZanIDE.IndexOfStr(b, ".");
            if (dot > 0) { b = b.Substring(0, dot); }
            if (b == hint) { head.Add(files[i]); } else { tail.Add(files[i]); }
        }
        for (int j = 0; j < tail.Count; j = j + 1) { head.Add(tail[j]); }
        return head;
    }

    static string FindMemberDeclFile(List<TabRecord> tabs, string root,
                                     string owner, string member) {
        for (int i = 0; i < tabs.Count; i = i + 1) {
            int ln = CodeEditor.FindMemberDeclLineIn(
                CodeEditor.SplitLines(tabs[i].body), owner, member);
            if (ln >= 0) {
                return tabs[i].name + ":" + Convert.ToString(ln + 1);
            }
        }
        List<string> files = ZanIDE.NameFirst(ZanIDE.NavSearchFiles(root), owner);
        for (int fi = 0; fi < files.Count; fi = fi + 1) {
            if (ZanIDE.FindTabByPath(tabs, files[fi]) >= 0) { continue; }
            int ln = CodeEditor.FindMemberDeclLineIn(
                CodeEditor.SplitLines(File.ReadAllText(files[fi])), owner, member);
            if (ln >= 0) {
                return Path.GetFileName(files[fi]) + ":" + Convert.ToString(ln + 1);
            }
        }
        return "";
    }

    static int FindMemberDecl(List<TabRecord> tabs, SignalInt active, string root,
                              string owner, string member, List<string> log) {
        int a = active.Get();
        if (a >= 0 && a < tabs.Count) {
            int ln = CodeEditor.FindMemberDeclLineIn(
                CodeEditor.SplitLines(tabs[a].body), owner, member);
            if (ln >= 0) {
                log.Add("> Definition of '" + owner + "." + member
                    + "' at line " + Convert.ToString(ln + 1) + " (this file).");
                return ln;
            }
        }
        for (int i = 0; i < tabs.Count; i = i + 1) {
            if (i == a) { continue; }
            int ln = CodeEditor.FindMemberDeclLineIn(
                CodeEditor.SplitLines(tabs[i].body), owner, member);
            if (ln >= 0) {
                active.Set(i);
                log.Add("> Definition of '" + owner + "." + member + "' in "
                    + tabs[i].name + " at line " + Convert.ToString(ln + 1) + ".");
                return ln;
            }
        }
        List<string> files = ZanIDE.NameFirst(ZanIDE.NavSearchFiles(root), owner);
        for (int fi = 0; fi < files.Count; fi = fi + 1) {
            string fp = files[fi];
            if (ZanIDE.FindTabByPath(tabs, fp) >= 0) { continue; }
            int ln = CodeEditor.FindMemberDeclLineIn(
                CodeEditor.SplitLines(File.ReadAllText(fp)), owner, member);
            if (ln >= 0) {
                ZanIDE.OpenPath(tabs, active, fp, Path.GetFileName(fp));
                log.Add("> Definition of '" + owner + "." + member + "' in "
                    + Path.GetFileName(fp) + " at line "
                    + Convert.ToString(ln + 1) + ".");
                return ln;
            }
        }
        return 0 - 1;
    }

    static int GoToDefinition(CodeEditor editor, List<TabRecord> tabs,
                              SignalInt active, string root, List<string> log) {
        string word = editor.WordAtCaret();
        if (word == "") { log.Add("> Go to Definition: no symbol under caret."); return 0 - 1; }
        int a = active.Get();
        if (a >= 0 && a < tabs.Count) { tabs[a].body = editor.GetText(); }
        string owner = editor.OwnerTypeAtCaret();
        if (owner.Length > 0) {
            int ml = ZanIDE.FindMemberDecl(tabs, active, root, owner, word, log);
            if (ml >= 0) { return ml; }
            if (CodeEditor.SymbolTypeLacksMember(owner, word)) {
                log.Add("> Go to Definition: '" + word + "' is not a member of '"
                    + owner + "'.");
                return 0 - 1;
            }
        }
        if (a >= 0 && a < tabs.Count) {
            int ln = ZanIDE.FindDeclLine(tabs[a].body, word);
            if (ln >= 0) {
                log.Add("> Definition of '" + word + "' at line " + Convert.ToString(ln + 1) + " (this file).");
                return ln;
            }
        }
        for (int i = 0; i < tabs.Count; i = i + 1) {
            if (i != a) {
                int ln = ZanIDE.FindDeclLine(tabs[i].body, word);
                if (ln >= 0) {
                    active.Set(i);
                    log.Add("> Definition of '" + word + "' in " + tabs[i].name
                        + " at line " + Convert.ToString(ln + 1) + ".");
                    return ln;
                }
            }
        }
        List<string> files = ZanIDE.NameFirst(ZanIDE.NavSearchFiles(root), word);
        for (int fi = 0; fi < files.Count; fi = fi + 1) {
            string fp = files[fi];
            if (ZanIDE.FindTabByPath(tabs, fp) < 0) {
                string body = File.ReadAllText(fp);
                int ln = ZanIDE.FindDeclLine(body, word);
                if (ln >= 0) {
                    ZanIDE.OpenPath(tabs, active, fp, Path.GetFileName(fp));
                    log.Add("> Definition of '" + word + "' in " + Path.GetFileName(fp)
                        + " at line " + Convert.ToString(ln + 1) + ".");
                    return ln;
                }
            }
        }
        string nsFile = ZanIDE.FindNamespaceDirFile(ZanIDE.StdlibDir(), word);
        if (nsFile == "") { nsFile = ZanIDE.FindNamespaceDirFile(root + "/src", word); }
        if (nsFile != "") {
            int nsTab = ZanIDE.FindTabByPath(tabs, nsFile);
            if (nsTab < 0) {
                ZanIDE.OpenPath(tabs, active, nsFile, Path.GetFileName(nsFile));
            } else {
                active.Set(nsTab);
            }
            log.Add("> Namespace '" + word + "' -> " + Path.GetFileName(nsFile) + ".");
            return 0;
        }
        log.Add("> Go to Definition: '" + word + "' not found in project.");
        return 0 - 1;
    }

    static bool SamePath(string a, string b) {
        return ZanIDE.NormPath(a) == ZanIDE.NormPath(b);
    }

    static string NormPath(string p) {
        return p.Replace("\\", "/").ToLower();
    }

    static int GoToDefinitionSmart(LspSession lsp, CodeEditor editor, List<TabRecord> tabs,
                                   SignalInt active, string root, List<string> log) {
        ZanIDE.definitionCaret = null;
        int a = active.Get();
        string normalizedRoot = ZanIDE.NormPath(root);
        while (normalizedRoot.EndsWith("/")) { normalizedRoot = normalizedRoot.Substring(0, normalizedRoot.Length - 1); }
        bool inRoot = a >= 0 && a < tabs.Count && normalizedRoot.Length > 0
            && ZanIDE.NormPath(tabs[a].path).StartsWith(normalizedRoot + "/");
        if (lsp != null && lsp.Alive() && inRoot && tabs[a].path.Length > 0) {
            string source = editor.GetText();
            int stamp = editor.TextStamp();
            int line = editor.CurLine();
            int col = editor.CurCol();
            string word = editor.WordAtCaret();
            TabRecord origin = tabs[a];
            origin.body = source;
            List<IdeRenameDocument> snapshots = ZanIDE.SyncNavigationDocuments(lsp, tabs);
            LspDefinitionTarget hit = lsp.Definition(origin.path, line, col);
            if (active.Get() != a || a >= tabs.Count || tabs[a] != origin
                || editor.TextStamp() != stamp || editor.GetText() != source
                || editor.CurLine() != line || editor.CurCol() != col
                || !ZanIDE.NavigationDocumentsCurrent(lsp, tabs, snapshots)) {
                log.Add("> Go to Definition: document changed during request.");
                return -1;
            }
            if (hit != null) {
                int target = ZanIDE.FindNavigationTab(tabs, hit.path);
                string body = target >= 0 ? tabs[target].body : "";
                if (target < 0 && File.Exists(hit.path)) { body = File.ReadAllText(hit.path); }
                List<string> ls = CodeEditor.SplitLines(body);
                if (hit.line >= 0 && hit.line < ls.Count) {
                    int byteCol = CodeEditor.Utf16ColumnToByte(ls[hit.line], hit.column);
                    if (CodeEditor.ByteColumnToUtf16(ls[hit.line], byteCol) == hit.column
                        && (target >= 0 || File.Exists(hit.path))) {
                        if (target < 0) {
                            ZanIDE.OpenPath(tabs, active, hit.path, Path.GetFileName(hit.path));
                            target = active.Get();
                        } else { active.Set(target); }
                        if (target >= 0 && target < tabs.Count && tabs[target].body == body) {
                            IdeDefinitionCaret caret = new IdeDefinitionCaret();
                            caret.body = body; caret.word = word;
                            caret.line = hit.line; caret.column = byteCol;
                            ZanIDE.definitionCaret = caret;
                            tabs[target].caretLine = hit.line;
                            tabs[target].caretCol = byteCol;
                            log.Add("> Definition in " + tabs[target].name + " at line "
                                + Convert.ToString(hit.line + 1) + ".");
                            return hit.line;
                        }
                    }
                }
            }
        }
        return ZanIDE.GoToDefinition(editor, tabs, active, root, log);
    }

    static IdeNavigationDiskText ReadNavigationDiskText(string path) {
        IdeNavigationDiskText read = new IdeNavigationDiskText();
        read.stamp = FileInfo.GetLastWriteTime(path);
        long length = FileInfo.GetLength(path);
        read.body = File.ReadAllText(path);
        if (length < 0 || read.stamp != FileInfo.GetLastWriteTime(path)
            || length != FileInfo.GetLength(path)) {
            throw new IOException("Navigation target changed while being read: " + path);
        }
        return read;
    }

    static IdeNavigationTarget PrepareNavigationTarget(string path, string body,
            int line, int column, string word, bool utf16) {
        IdeNavigationTarget result = new IdeNavigationTarget();
        List<string> lines = CodeEditor.SplitLines(body);
        if (line < 0 || line >= lines.Count) { return result; }
        int byteColumn = column;
        if (utf16) {
            byteColumn = CodeEditor.Utf16ColumnToByte(lines[line], column);
            if (CodeEditor.ByteColumnToUtf16(lines[line], byteColumn) != column) { return result; }
        } else if (column < 0) {
            byteColumn = CodeEditor.FindWordFrom(lines[line], word, 0);
            if (byteColumn < 0) { byteColumn = 0; }
        }
        result.path = path; result.body = body; result.line = line; result.column = byteColumn;
        result.prepared = TabRecord.Create(Path.GetFileName(path), body, path);
        result.prepared.preparedText = CodeEditor.PrepareText(body);
        result.prepared.preparedBody = body;
        result.valid = true;
        result.message = "> Definition in " + result.prepared.name + " at line " + Convert.ToString(line + 1) + ".";
        return result;
    }

    static IdeNavigationTarget DefinitionInSnapshot(IdeNavigationSnapshot snapshot,
            IdeProjectSourceCache cache, LspDefinitionTarget semantic) {
        if (snapshot.cancellation.IsCancellationRequested) { return new IdeNavigationTarget(); }
        if (semantic != null) {
            IdeSourceSnapshot opened = ZanIDE.SnapshotSource(snapshot.documents, semantic.path);
            bool exists = opened != null || File.Exists(semantic.path);
            IdeNavigationDiskText read = opened == null && exists ? ZanIDE.ReadNavigationDiskText(semantic.path) : null;
            string body = opened != null ? opened.body : read != null ? read.body : "";
            if (exists) {
                IdeNavigationTarget target = ZanIDE.PrepareNavigationTarget(semantic.path, body,
                    semantic.line, semantic.column, snapshot.word, true);
                if (target.valid) {
                    target.fromDisk = read != null;
                    target.diskStamp = read != null ? read.stamp : 0;
                    return target;
                }
            }
        }
        List<IdeSourceSnapshot> ordered = new List<IdeSourceSnapshot>();
        IdeSourceSnapshot origin = ZanIDE.SnapshotSource(snapshot.documents, snapshot.path);
        if (origin != null) { ordered.Add(origin); }
        for (int i = 0; i < snapshot.documents.Count; i = i + 1) {
            if (snapshot.documents[i] != origin) { ordered.Add(snapshot.documents[i]); }
        }
        List<IdeSourceSnapshot> disk = new List<IdeSourceSnapshot>();
        string hint = snapshot.owner.Length > 0 ? snapshot.owner : snapshot.word;
        for (int i = 0; i < cache.project.Count; i = i + 1) { disk.Add(cache.project[i]); }
        for (int i = 0; i < cache.library.Count; i = i + 1) { disk.Add(cache.library[i]); }
        for (int pass = 0; pass < 2; pass = pass + 1) {
            for (int i = 0; i < disk.Count; i = i + 1) {
                IdeSourceSnapshot source = disk[i];
                if (ZanIDE.SnapshotSource(snapshot.documents, source.path) != null) { continue; }
                string name = Path.GetFileName(source.path);
                int dot = name.IndexOf(".");
                if (dot >= 0) { name = name.Substring(0, dot); }
                if ((name == hint) == (pass == 0)) { ordered.Add(source); }
            }
        }
        for (int pass = 0; pass < 2; pass = pass + 1) {
            if (pass == 0 && snapshot.owner.Length == 0) { continue; }
            if (pass == 1 && snapshot.lacksMember) { break; }
            for (int i = 0; i < ordered.Count; i = i + 1) {
                if (snapshot.cancellation.IsCancellationRequested) { return new IdeNavigationTarget(); }
                IdeSourceSnapshot source = ordered[i];
                int line = pass == 0
                    ? CodeEditor.FindMemberDeclLineIn(CodeEditor.SplitLines(source.body), snapshot.owner, snapshot.word)
                    : ZanIDE.FindDeclLine(source.body, snapshot.word);
                if (line < 0) { continue; }
                string body = source.body;
                IdeNavigationDiskText read = null;
                if (ZanIDE.SnapshotSource(snapshot.documents, source.path) == null) {
                    if (!File.Exists(source.path)) { continue; }
                    read = ZanIDE.ReadNavigationDiskText(source.path);
                    body = read.body;
                    line = pass == 0
                        ? CodeEditor.FindMemberDeclLineIn(CodeEditor.SplitLines(body), snapshot.owner, snapshot.word)
                        : ZanIDE.FindDeclLine(body, snapshot.word);
                    if (line < 0) { continue; }
                }
                IdeNavigationTarget target = ZanIDE.PrepareNavigationTarget(source.path, body, line, -1, snapshot.word, false);
                target.fromDisk = read != null;
                target.diskStamp = read != null ? read.stamp : 0;
                return target;
            }
        }
        if (!snapshot.lacksMember) {
            string segment = "/" + snapshot.word + "/";
            for (int i = 0; i < disk.Count; i = i + 1) {
                if (snapshot.cancellation.IsCancellationRequested) { return new IdeNavigationTarget(); }
                IdeSourceSnapshot source = disk[i];
                if (source.path.Replace("\\", "/").IndexOf(segment) < 0) { continue; }
                IdeSourceSnapshot opened = ZanIDE.SnapshotSource(snapshot.documents, source.path);
                if (opened == null && !File.Exists(source.path)) { continue; }
                IdeNavigationDiskText read = opened == null ? ZanIDE.ReadNavigationDiskText(source.path) : null;
                string body = opened != null ? opened.body : read.body;
                IdeNavigationTarget target = ZanIDE.PrepareNavigationTarget(source.path, body, 0, 0, snapshot.word, false);
                target.fromDisk = read != null;
                target.diskStamp = read != null ? read.stamp : 0;
                target.message = "> Namespace '" + snapshot.word + "' -> " + Path.GetFileName(source.path) + ".";
                return target;
            }
        }
        IdeNavigationTarget missing = new IdeNavigationTarget();
        missing.message = snapshot.lacksMember
            ? "> Go to Definition: '" + snapshot.word + "' is not a member of '" + snapshot.owner + "'."
            : "> Go to Definition: '" + snapshot.word + "' not found in project.";
        return missing;
    }

    void GoToDefinitionAsync() {
        IdeNavigationGuard guard = this.BeginCodeNavigation(true, true);
        if (guard == null) { return; }
        if (guard.snapshot.word.Length == 0) {
            log.Add("> Go to Definition: no symbol under caret."); app.RequestRedraw(); return;
        }
        LspSession session = guard.session;
        if (session != null && session.Alive()
            && ZanIDE.NavigationPathInRoot(guard.snapshot.path, guard.snapshot.root)) {
            session.DefinitionAsync(guard.snapshot.path, guard.snapshot.line, guard.snapshot.column,
                delegate (LspDefinitionResult result) {
                    if (!this.NavigationGuardCurrent(guard, true, true)) { return; }
                    if (result != null && !session.IsCurrent(result.path, result.version,
                            result.generation, result.documentGeneration)) { return; }
                    guard.semantic = result;
                    this.StartDefinitionScan(guard, result != null ? result.target : null);
                });
        } else { this.StartDefinitionScan(guard, null); }
    }

    void StartDefinitionScan(IdeNavigationGuard guard, LspDefinitionTarget semantic) {
        this.WithProjectSources(delegate () {
            if (!this.NavigationGuardCurrent(guard, true, true)) { return; }
            IdeNavigationSnapshot snapshot = guard.snapshot;
            IdeProjectSourceCache cache = navigationSources;
            App host = app;
            navigationWork.Run(delegate () {
                IdeNavigationTarget result = new IdeNavigationTarget();
                try { result = ZanIDE.DefinitionInSnapshot(snapshot, cache, semantic); }
                catch (Exception error) {
                    result.message = "> Go to Definition: " + error.Message;
                }
                if (snapshot.cancellation.IsCancellationRequested) { return; }
                host.Post(delegate () { this.ApplyNavigationTarget(guard, result); });
            });
        });
    }

    void ApplyNavigationTarget(IdeNavigationGuard guard, IdeNavigationTarget result) {
        if (!this.NavigationGuardCurrent(guard, true, true) || this.CodeNavigationBusy()) { return; }
        if (result.message.Length > 0) { log.Add(result.message); }
        if (!result.valid) { app.RequestRedraw(); return; }
        int tab = ZanIDE.FindNavigationTab(tabs, result.path);
        if (tab < 0) {
            if (!result.fromDisk) { return; }
            tabs.Add(result.prepared);
            this.TrackPreparedDocument(result.path, result.body, result.diskStamp);
            tab = tabs.Count - 1;
        } else {
            if (tabs[tab].body != result.body) { return; }
            tabs[tab].preparedText = result.prepared.preparedText;
            tabs[tab].preparedBody = result.body;
        }
        tabs[tab].caretLine = result.line; tabs[tab].caretCol = result.column;
        activeTab.Set(tab);
        pendingGotoLine = result.line; pendingGotoCol = result.column;
        lastActive = -1;
        this.UpdateActiveCodeTab();
        app.RequestRedraw();
    }

    static void CollectRefsInSnapshot(IdeSourceSnapshot source, IdeNavigationSnapshot snapshot,
            List<SearchHit> hits) {
        List<string> lines = CodeEditor.SplitLines(source.body);
        if (snapshot.referenceOwner.Length == 0) {
            for (int i = 0; i < lines.Count && hits.Count < 2000; i = i + 1) {
                if (ZanIDE.CountWord(lines[i], snapshot.word) > 0) {
                    hits.Add(SearchHit.Create(source.path, i, CodeEditor.LTrim(lines[i])));
                }
            }
            return;
        }
        CeFileIndex index = CeFileIndex.Of(lines);
        List<string> receivers = new List<string>();
        receivers.Add("this"); receivers.Add("base");
        for (int i = 0; i < snapshot.family.Count; i = i + 1) {
            string type = snapshot.family[i];
            if (!CodeEditor.Has(receivers, type)) { receivers.Add(type); }
            CodeEditor.CollectTypedVarsPre(index.stripped, type, receivers);
        }
        List<int> found = new List<int>();
        CodeEditor.CountMemberRefsWith(index, snapshot.family, receivers, snapshot.word, found);
        for (int i = 0; i < found.Count && hits.Count < 2000; i = i + 1) {
            hits.Add(SearchHit.Create(source.path, found[i], CodeEditor.LTrim(lines[found[i]])));
        }
    }

    static List<SearchHit> ReferencesInSnapshot(IdeNavigationSnapshot snapshot,
            IdeProjectSourceCache cache, List<string> rows) {
        List<SearchHit> hits = new List<SearchHit>();
        Dictionary<string, List<string>> previews = new Dictionary<string, List<string>>();
        if (rows != null) {
            for (int i = 0; i < rows.Count && hits.Count < 2000; i = i + 1) {
                if (snapshot.cancellation.IsCancellationRequested) { return hits; }
                int separator = rows[i].IndexOf("\t");
                if (separator <= 0) { continue; }
                string path = rows[i].Substring(0, separator);
                int line = ZanIDE.ParseInt(rows[i].Substring(separator + 1, rows[i].Length - separator - 1));
                string key = ZanIDE.NormPath(path);
                if (!previews.ContainsKey(key)) {
                    IdeSourceSnapshot opened = ZanIDE.SnapshotSource(snapshot.documents, path);
                    string body = opened != null ? opened.body : File.Exists(path) ? File.ReadAllText(path) : "";
                    previews[key] = CodeEditor.SplitLines(body);
                }
                List<string> lines = previews[key];
                if (line < 0 || line >= lines.Count) { continue; }
                hits.Add(SearchHit.Create(path, line, CodeEditor.LTrim(lines[line])));
            }
            if (hits.Count > 0) { return hits; }
        }
        if (snapshot.lacksReferenceMember) { return hits; }
        List<IdeSourceSnapshot> sources = ZanIDE.MergeSourceSnapshots(cache.project, snapshot.documents);
        for (int i = 0; i < sources.Count && hits.Count < 2000; i = i + 1) {
            if (snapshot.cancellation.IsCancellationRequested) { return hits; }
            if (!sources[i].path.ToLower().EndsWith(".zan")) { continue; }
            ZanIDE.CollectRefsInSnapshot(sources[i], snapshot, hits);
        }
        return hits;
    }

    void CollectReferencesAsync() {
        IdeNavigationGuard guard = this.BeginCodeNavigation(true, true);
        if (guard == null) { return; }
        if (guard.snapshot.word.Length == 0) {
            log.Add("> Find All References: no symbol under caret."); app.RequestRedraw(); return;
        }
        LspSession session = guard.session;
        if (session != null && session.Alive()
            && ZanIDE.NavigationPathInRoot(guard.snapshot.path, guard.snapshot.root)) {
            session.ReferencesAsync(guard.snapshot.path, guard.snapshot.line, guard.snapshot.column,
                delegate (LspReferencesResult result) {
                    if (!this.NavigationGuardCurrent(guard, true, true)) { return; }
                    if (result != null && !session.IsCurrent(result.path, result.version,
                            result.generation, result.documentGeneration)) { return; }
                    guard.semantic = result;
                    this.StartReferenceScan(guard, result != null ? result.rows : null);
                });
        } else { this.StartReferenceScan(guard, null); }
    }

    void StartReferenceScan(IdeNavigationGuard guard, List<string> rows) {
        this.WithProjectSources(delegate () {
            if (!this.NavigationGuardCurrent(guard, true, true)) { return; }
            IdeNavigationSnapshot snapshot = guard.snapshot;
            IdeProjectSourceCache cache = navigationSources;
            App host = app;
            navigationWork.Run(delegate () {
                List<SearchHit> hits = new List<SearchHit>();
                string failure = "";
                try { hits = ZanIDE.ReferencesInSnapshot(snapshot, cache, rows); }
                catch (Exception error) {
                    failure = error.Message;
                }
                if (snapshot.cancellation.IsCancellationRequested) { return; }
                host.Post(delegate () {
                    if (!this.NavigationGuardCurrent(guard, true, true)) { return; }
                    if (failure != "") { log.Add("> Find All References: " + failure); }
                    else {
                        log.Add("> " + Convert.ToString(hits.Count) + " reference(s) to '" + snapshot.word + "'.");
                        refAnchorLine = snapshot.line;
                        if (hits.Count > 0) { refList.Show(snapshot.word, hits, snapshot.root); }
                    }
                    app.RequestRedraw();
                });
            });
        });
    }

    void GotoSearchHitAsync(List<SearchHit> hits, int index) {
        if (index < 0 || index >= hits.Count) { return; }
        SearchHit hit = hits[index];
        string path = hit.path;
        int line = hit.line;
        string message = "> Match " + Convert.ToString(index + 1) + "/"
            + Convert.ToString(hits.Count) + ": " + Path.GetFileName(path) + ":" + Convert.ToString(line + 1);
        IdeNavigationGuard guard = this.BeginCodeNavigation(false, false);
        if (guard == null) { return; }
        IdeNavigationSnapshot snapshot = guard.snapshot;
        App host = app;
        navigationWork.Run(delegate () {
            IdeNavigationTarget result = new IdeNavigationTarget();
            try {
                IdeSourceSnapshot opened = ZanIDE.SnapshotSource(snapshot.documents, path);
                if (opened != null || File.Exists(path)) {
                    IdeNavigationDiskText read = opened == null ? ZanIDE.ReadNavigationDiskText(path) : null;
                    string body = opened != null ? opened.body : read.body;
                    result = ZanIDE.PrepareNavigationTarget(path, body, line, 0, "", false);
                    result.fromDisk = read != null;
                    result.diskStamp = read != null ? read.stamp : 0;
                }
                result.message = message;
            } catch (Exception error) {
                result.message = "> Match: " + error.Message;
            }
            if (snapshot.cancellation.IsCancellationRequested) { return; }
            host.Post(delegate () { this.ApplyNavigationTarget(guard, result); });
        });
    }

    static int CountWord(string line, string word) {
        int wl = word.Length;
        if (wl == 0 || line == null) { return 0; }
        int count = 0;
        int i = 0;
        int len = line.Length;
        while (i + wl <= len) {
            if (line.Substring(i, wl) == word) {
                bool leftOk = true;
                bool rightOk = true;
                if (i > 0) { leftOk = !CodeEditor.IsIdentByte(line[i - 1]); }
                if (i + wl < len) { rightOk = !CodeEditor.IsIdentByte(line[i + wl]); }
                if (leftOk && rightOk) { count = count + 1; i = i + wl; }
                else { i = i + 1; }
            } else { i = i + 1; }
        }
        return count;
    }

    static List<SearchHit> CollectReferences(LspSession lsp, CodeEditor editor,
                                            List<TabRecord> tabs,
                                            SignalInt active, string root) {
        List<SearchHit> hits = new List<SearchHit>();
        string word = editor.WordAtCaret();
        if (word.Length == 0) { return hits; }
        int a = active.Get();
        if (a >= 0 && a < tabs.Count) { tabs[a].body = editor.GetText(); }
        bool inRoot = a >= 0 && a < tabs.Count
            && ZanIDE.NormPath(tabs[a].path).StartsWith(ZanIDE.NormPath(root));
        if (lsp != null && lsp.Alive() && inRoot && tabs[a].path.Length > 0) {
            lsp.SyncDoc(tabs[a].path, tabs[a].body);
            List<string> rows = lsp.References(
                tabs[a].path, editor.CurLine(), editor.CurCol());
            string cachePath = "";
            List<string> cacheLines = new List<string>();
            for (int i = 0; i < rows.Count; i = i + 1) {
                int sep = ZanIDE.IndexOfStr(rows[i], "\t");
                if (sep <= 0) { continue; }
                string rp = rows[i].Substring(0, sep);
                int ln = ZanIDE.ParseInt(
                    rows[i].Substring(sep + 1, rows[i].Length - sep - 1));
                if (rp != cachePath) {
                    cachePath = rp;
                    cacheLines = ZanIDE.SourceLines(tabs, rp);
                }
                string prev = "";
                if (ln >= 0 && ln < cacheLines.Count) {
                    prev = CodeEditor.LTrim(cacheLines[ln]);
                }
                hits.Add(SearchHit.Create(rp, ln, prev));
            }
            if (hits.Count > 0) { return hits; }
        }
        string owner = editor.OwnerTypeAtCaret();
        if (owner.Length == 0) { owner = editor.EnclosingTypeOfCaretDecl(); }
        if (owner.Length > 0 && CodeEditor.SymbolTypeLacksMember(owner, word)) {
            return hits;
        }
        for (int i = 0; i < tabs.Count; i = i + 1) {
            if (!tabs[i].path.EndsWith(".zan")) { continue; }
            ZanIDE.CollectRefsInFile(tabs[i].path, tabs[i].body, word, owner, hits);
        }
        List<string> files = ZanIDE.ListZanFiles(root);
        for (int fi = 0; fi < files.Count; fi = fi + 1) {
            string fp = files[fi];
            if (ZanIDE.FindTabByPath(tabs, fp) >= 0) { continue; }
            if (!File.Exists(fp)) { continue; }
            ZanIDE.CollectRefsInFile(fp, File.ReadAllText(fp), word, owner, hits);
        }
        return hits;
    }

    static void CollectRefsInFile(string path, string body, string word,
                                  string owner, List<SearchHit> hits) {
        List<string> ls = CodeEditor.SplitLines(body);
        List<int> lns = new List<int>();
        if (owner.Length > 0) {
            CodeEditor.CountMemberRefsIn(ls, word, owner, lns);
        } else {
            for (int i = 0; i < ls.Count; i = i + 1) {
                if (ZanIDE.CountWord(ls[i], word) > 0) { lns.Add(i); }
            }
        }
        for (int h = 0; h < lns.Count; h = h + 1) {
            if (hits.Count >= 2000) { return; }
            hits.Add(SearchHit.Create(path, lns[h], CodeEditor.LTrim(ls[lns[h]])));
        }
    }

    static List<string> SourceLines(List<TabRecord> tabs, string path) {
        int t = ZanIDE.FindTabByPath(tabs, path);
        if (t >= 0) { return CodeEditor.SplitLines(tabs[t].body); }
        if (!File.Exists(path)) { return new List<string>(); }
        return CodeEditor.SplitLines(File.ReadAllText(path));
    }

    static string ReplaceWholeWord(string text, string word, string newName) {
        if (text == null || text.Length == 0) { return ""; }
        StringBuilder sb = new StringBuilder();
        int i = 0;
        int n = text.Length;
        int start = 0;
        while (i < n) {
            int c = text[i] & 255;
            if (c == 47 && i + 1 < n && (text[i + 1] & 255) == 47) {
                int j = i + 2;
                while (j < n && (text[j] & 255) != 10) { j = j + 1; }
                i = j;
            } else if (c == 47 && i + 1 < n && (text[i + 1] & 255) == 42) {
                int j = i + 2;
                while (j + 1 < n && !((text[j] & 255) == 42 && (text[j + 1] & 255) == 47)) { j = j + 1; }
                if (j + 1 < n) { j = j + 2; } else { j = n; }
                i = j;
            } else if (c == 34 || c == 39) {
                int quote = c;
                int j = i + 1;
                while (j < n && (text[j] & 255) != quote) {
                    if ((text[j] & 255) == 92 && j + 1 < n) { j = j + 1; }
                    j = j + 1;
                }
                if (j < n) { j = j + 1; }
                i = j;
            } else if (CodeEditor.IsIdentByte(c)) {
                int j = i;
                while (j < n && CodeEditor.IsIdentByte(text[j])) { j = j + 1; }
                string ident = text.Substring(i, j - i);
                if (ident == word) {
                    if (i > start) { sb.Append(text.Substring(start, i - start)); }
                    sb.Append(newName);
                    start = j;
                }
                i = j;
            } else {
                i = i + 1;
            }
        }
        if (i > start) {
            sb.Append(text.Substring(start, i - start));
        }
        return sb.ToString();
    }

    // ================================================================
    // ================================================================

    static int FindInFiles(string root, string needle, bool matchCase,
                           List<TabRecord> tabs, List<SearchHit> outHits,
                           List<string> log) {
        outHits.Clear();
        if (needle == "") { return 0; }
        List<string> files = new List<string>();
        ZanIDE.GatherZanFiles(root, files);
        int hits = 0;
        int scanned = 0;
        for (int fi = 0; fi < files.Count && hits < 2000; fi = fi + 1) {
            string fp = files[fi];
            int tab = ZanIDE.FindTabByPath(tabs, fp);
            string text = "";
            if (tab >= 0) {
                text = tabs[tab].body;
            } else if (File.Exists(fp)) {
                text = File.ReadAllText(fp);
            }
            if (text != "") {
                scanned = scanned + 1;
                List<string> ls = CodeEditor.SplitLines(text);
                for (int li = 0; li < ls.Count && hits < 2000; li = li + 1) {
                    if (ZanIDE.LineContains(ls[li], needle, matchCase)) {
                        string hitText = ZanIDE.TrimLeadSpaces(ls[li]);
                        outHits.Add(SearchHit.Create(fp, li, hitText));
                        log.Add("   " + fp + ":" + Convert.ToString(li + 1)
                            + ": " + hitText);
                        hits = hits + 1;
                    }
                }
            }
        }
        log.Add("> " + Convert.ToString(hits) + " match(es) for '" + needle
            + "' in " + Convert.ToString(scanned)
            + " file(s). F8 = next match, Shift+F8 = previous.");
        return hits;
    }

    static int ReplaceInFiles(string root, string needle, string repl,
                              bool matchCase, List<TabRecord> tabs,
                              List<string> log) {
        if (needle == "" || needle == repl) { return 0; }
        List<string> files = new List<string>();
        ZanIDE.GatherZanFiles(root, files);
        int bufs = 0;
        int disk = 0;
        int total = 0;
        for (int fi = 0; fi < files.Count; fi = fi + 1) {
            string fp = files[fi];
            int tab = ZanIDE.FindTabByPath(tabs, fp);
            string text = "";
            if (tab >= 0) {
                text = tabs[tab].body;
            } else if (File.Exists(fp)) {
                text = File.ReadAllText(fp);
            }
            if (text != "") {
                int n = ZanIDE.CountOccurrences(text, needle, matchCase);
                if (n > 0) {
                    string nt = ZanIDE.ReplaceAllText(text, needle, repl, matchCase);
                    total = total + n;
                    if (tab >= 0) {
                        tabs[tab].body = nt;
                        bufs = bufs + 1;
                    } else {
                        File.WriteAllText(fp, nt);
                        disk = disk + 1;
                    }
                }
            }
        }
        log.Add("> Replaced " + Convert.ToString(total) + " occurrence(s) of '"
            + needle + "' with '" + repl + "': "
            + Convert.ToString(bufs) + " open tab(s), "
            + Convert.ToString(disk) + " file(s) on disk.");
        return bufs + disk;
    }

    static int GotoSearchHit(List<SearchHit> hits, int idx,
                             List<TabRecord> tabs, SignalInt active,
                             List<string> log) {
        if (idx < 0 || idx >= hits.Count) { return 0 - 1; }
        SearchHit hit = hits[idx];
        int tab = ZanIDE.FindTabByPath(tabs, hit.path);
        if (tab < 0) {
            if (!File.Exists(hit.path)) { return 0 - 1; }
            ZanIDE.OpenPath(tabs, active, hit.path, Path.GetFileName(hit.path));
            tab = tabs.Count - 1;
        }
        active.Set(tab);
        log.Add("> Match " + Convert.ToString(idx + 1) + "/"
            + Convert.ToString(hits.Count) + ": " + Path.GetFileName(hit.path)
            + ":" + Convert.ToString(hit.line + 1));
        return hit.line;
    }

    static bool LineContains(string line, string needle, bool matchCase) {
        return ZanIDE.FindOccurrence(line, needle, 0, matchCase) >= 0;
    }

    // or -1.
    static int FindOccurrence(string hay, string needle, int from, bool matchCase) {
        int nl = needle.Length;
        if (nl == 0) { return 0 - 1; }
        for (int i = from; i + nl <= hay.Length; i = i + 1) {
            string part = hay.Substring(i, nl);
            if (part == needle) { return i; }
            if (!matchCase && ZanIDE.LowerStr(part) == ZanIDE.LowerStr(needle)) {
                return i;
            }
        }
        return 0 - 1;
    }

    static int CountOccurrences(string text, string needle, bool matchCase) {
        int n = 0;
        int p = ZanIDE.FindOccurrence(text, needle, 0, matchCase);
        while (p >= 0) {
            n = n + 1;
            p = ZanIDE.FindOccurrence(text, needle, p + needle.Length, matchCase);
        }
        return n;
    }

    static string ReplaceAllText(string text, string needle, string repl,
                                 bool matchCase) {
        string outp = "";
        int at = 0;
        int p = ZanIDE.FindOccurrence(text, needle, 0, matchCase);
        while (p >= 0) {
            outp = outp + text.Substring(at, p - at) + repl;
            at = p + needle.Length;
            p = ZanIDE.FindOccurrence(text, needle, at, matchCase);
        }
        return outp + text.Substring(at, text.Length - at);
    }

    static string LowerStr(string s) {
        string outp = "";
        for (int i = 0; i < s.Length; i = i + 1) {
            int c = s[i];
            if (c >= 65 && c <= 90) { c = c + 32; }
            outp = outp + Text.CharStr(c);
        }
        return outp;
    }

    static int FindNavigationTab(List<TabRecord> tabs, string path) {
        for (int i = 0; i < tabs.Count; i = i + 1) {
            if (LspSession.SameDocumentPath(tabs[i].path, path)) { return i; }
        }
        return -1;
    }

    // 请求前同步每个打开的源码缓冲区，各自版本与原文用实体记录。
    static List<IdeSourceSnapshot> SearchSourceSnapshots(IdeProjectSourceCache cache,
            List<IdeSourceSnapshot> documents) {
        List<IdeSourceSnapshot> sources = new List<IdeSourceSnapshot>();
        for (int i = 0; i < cache.search.Count; i = i + 1) {
            IdeSourceSnapshot disk = cache.search[i];
            IdeSourceSnapshot opened = ZanIDE.SnapshotSource(documents, disk.path);
            sources.Add(opened != null ? opened : disk);
        }
        return sources;
    }

    static List<SearchHit> FindInSourceSnapshot(IdeNavigationSnapshot snapshot,
            IdeProjectSourceCache cache, string query) {
        List<SearchHit> hits = new List<SearchHit>();
        List<IdeSourceSnapshot> sources = ZanIDE.SearchSourceSnapshots(cache, snapshot.documents);
        for (int i = 0; i < sources.Count && hits.Count < 2000; i = i + 1) {
            if (snapshot.cancellation.IsCancellationRequested) { return hits; }
            List<string> lines = CodeEditor.SplitLines(sources[i].body);
            for (int line = 0; line < lines.Count && hits.Count < 2000; line = line + 1) {
                if (ZanIDE.LineContains(lines[line], query, false)) {
                    hits.Add(SearchHit.Create(sources[i].path, line, CodeEditor.LTrim(lines[line])));
                }
            }
        }
        return hits;
    }

    void FindInFilesAsync(string query) {
        if (query.Length == 0) { return; }
        IdeNavigationGuard guard = this.BeginCodeNavigation(false, false);
        if (guard == null) { return; }
        this.WithProjectSources(delegate () {
            if (!this.NavigationGuardCurrent(guard, false, true)) { return; }
            IdeNavigationSnapshot snapshot = guard.snapshot;
            IdeProjectSourceCache cache = navigationSources;
            App host = app;
            navigationWork.Run(delegate () {
                List<SearchHit> hits = ZanIDE.FindInSourceSnapshot(snapshot, cache, query);
                if (snapshot.cancellation.IsCancellationRequested) { return; }
                host.Post(delegate () {
                    if (!this.NavigationGuardCurrent(guard, false, true)) { return; }
                    fifHits = hits; fifSel = -1;
                    log.Add("> " + Convert.ToString(hits.Count) + " match(es) for '" + query + "'.");
                    coLog.Reset(); dock.Focus("output"); app.RequestRedraw();
                });
            });
        });
    }

    static IdeRenamePlan PrepareReplacementPlan(IdeNavigationSnapshot snapshot,
            IdeProjectSourceCache cache, string query, string replacement) {
        IdeRenamePlan plan = new IdeRenamePlan();
        List<IdeSourceSnapshot> sources = ZanIDE.SearchSourceSnapshots(cache, snapshot.documents);
        for (int i = 0; i < sources.Count; i = i + 1) {
            if (snapshot.cancellation.IsCancellationRequested) {
                plan.failure = "canceled; no files changed."; return plan;
            }
            IdeSourceSnapshot source = sources[i];
            string text = ZanIDE.ReplaceAllText(source.body, query, replacement, false);
            if (text == source.body) { continue; }
            IdeRenamePlanEntry entry = new IdeRenamePlanEntry();
            entry.path = source.path; entry.originalText = source.body; entry.newText = text;
            entry.open = ZanIDE.SnapshotSource(snapshot.documents, source.path) != null;
            entry.version = source.version;
            if (entry.open) { entry.prepared = CodeEditor.PrepareText(text); plan.buffers = plan.buffers + 1; }
            else { plan.disk = plan.disk + 1; }
            plan.entries.Add(entry);
        }
        plan.valid = true;
        return plan;
    }

    void ReplaceInFilesAsync(string query, string replacement) {
        if (query == "" || query == replacement) { return; }
        IdeNavigationGuard guard = this.BeginCodeNavigation(false, false);
        if (guard == null) { return; }
        this.WithProjectSources(delegate () {
            if (!this.NavigationGuardCurrent(guard, true, true)) { return; }
            IdeNavigationSnapshot snapshot = guard.snapshot;
            IdeProjectSourceCache cache = navigationSources;
            App host = app;
            navigationWork.Run(delegate () {
                IdeRenamePlan plan = new IdeRenamePlan();
                try { plan = ZanIDE.PrepareReplacementPlan(snapshot, cache, query, replacement); }
                catch (Exception error) {
                    plan.failure = error.Message;
                }
                if (snapshot.cancellation.IsCancellationRequested) { return; }
                host.Post(delegate () {
                    this.BeginRenamePlanCommit(guard, plan, "Replace in Files", "Replaced '" + query + "' with '" + replacement + "'");
                });
            });
        });
    }

    static int IndexOfPath(List<string> paths, string path) {
        for (int i = 0; i < paths.Count; i = i + 1) {
            if (ZanIDE.SamePath(paths[i], path)) { return i; }
        }
        return 0 - 1;
    }

    // 按服务端完整 range/newText 应用语义编辑；非法范围使整份文本失败。
    static LspEditApplication ApplyRenameEdits(string text, List<LspRenameEdit> edits, string path) {
        return LspSession.ApplyTextEdits(text, edits, path);
    }

    static int RenameSymbol(CodeEditor editor, List<TabRecord> tabs,
                            SignalInt active, List<string> log,
                            string word, string newName) {
        if (word == "" || newName == "" || word == newName) { return 0; }
        int a = active.Get();
        if (a >= 0 && a < tabs.Count) { tabs[a].body = editor.GetText(); }
        int changed = 0;
        for (int i = 0; i < tabs.Count; i = i + 1) {
            string nb = ZanIDE.ReplaceWholeWord(tabs[i].body, word, newName);
            if (nb != tabs[i].body) {
                tabs[i].body = nb;
                changed = changed + 1;
            }
        }
        if (a >= 0 && a < tabs.Count) {
            int keepLine = editor.CurLine();
            editor.LoadText(tabs[a].body);
            editor.GoToLine(keepLine);
        }
        log.Add("> Renamed '" + word + "' -> '" + newName + "' in "
            + Convert.ToString(changed) + " open tab(s). Save to persist.");
        return changed;
    }

    static void FormatDocument(CodeEditor editor, List<string> log) {
        string exe = ZanIDE.ToolchainDir() + "/zanfmt" + ZanIDE.ExeSuffix();
        if (!File.Exists(exe)) { exe = ZanIDE.ExeDir() + "/zanfmt" + ZanIDE.ExeSuffix(); }
        if (!File.Exists(exe)) { log.Add("> Format: zanfmt not found."); return; }
        string tmp = ZanIDE.WindowCacheDir() + "/fmt_buffer.zan";
        ZanIDE.EnsureCacheDir();
        File.WriteAllText(tmp, editor.GetText());
        List<string> outp = Process.RunCapture("\"" + exe + "\" --stdout \"" + tmp + "\"");
        File.Delete(tmp);
        if (outp.Count == 0) { log.Add("> Format: zanfmt produced no output."); return; }
        string body = "";
        for (int i = 0; i < outp.Count; i = i + 1) {
            body = body + outp[i] + "\n";
        }
        int keepLine = editor.CurLine();
        editor.LoadText(body);
        editor.GoToLine(keepLine);
        log.Add("> Formatted document with zanfmt.");
    }


    static List<string> SplitSpaces(string s) {
        List<string> outp = new List<string>();
        string cur = "";
        for (int i = 0; i < s.Length; i = i + 1) {
            string ch = s.Substring(i, 1);
            if (ch == " " || ch == "\t") {
                if (cur.Length > 0) { outp.Add(cur); cur = ""; }
            } else { cur = cur + ch; }
        }
        if (cur.Length > 0) { outp.Add(cur); }
        return outp;
    }

    static void AppendAll(List<string> log, List<string> lines) {
        for (int i = 0; i < lines.Count; i = i + 1) {
            log.Add("  " + lines[i]);
        }
    }

    static bool TabsMatchRecords(Tabs widget, List<TabRecord> records) {
        if (widget == null || records == null) { return false; }
        if (widget.Count() != records.Count) { return false; }
        for (int i = 0; i < records.Count; i = i + 1) {
            if (widget.LabelAt(i) != records[i].name) { return false; }
        }
        return true;
    }

    static bool StringListsEqual(List<string> a, List<string> b) {
        if (a == null || b == null) { return false; }
        if (a.Count != b.Count) { return false; }
        for (int i = 0; i < a.Count; i = i + 1) {
            if (a[i] != b[i]) { return false; }
        }
        return true;
    }

    void SyncEditorTabs() {
        if (editorTabs == null) {
            editorTabs = new Tabs(Tabs.Card());
            editorTabs.SetShowAdd(true);
            editorTabs.SetHostModel(true);
        }
        if (!ZanIDE.TabsMatchRecords(editorTabs, tabs)) {
            Tabs nt = new Tabs(Tabs.Card());
            nt.SetShowAdd(true);
            nt.SetHostModel(true);
            for (int i = 0; i < tabs.Count; i = i + 1) {
                nt.Add(tabs[i].name, true);
            }
            editorTabs = nt;
        }
    }

}