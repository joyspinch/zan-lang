    // 接口数据协议与执行契约。
    static string EscZ(string s) {
        string o = "";
        for (int i = 0; i < s.Length; i = i + 1) {
            string ch = s.Substring(i, 1);
            if (ch == "\\") { o = o + "\\\\"; }
            else if (ch == "\"") { o = o + "\\\""; }
            else if (ch == "\n") { o = o + "\\n"; }
            else if (ch == "\r") { }
            else if (ch == "\t") { o = o + "\\t"; }
            else { o = o + ch; }
        }
        return o;
    }

    static bool ListHasStr(List<string> l, string v) {
        for (int i = 0; i < l.Count; i = i + 1) { if (l[i] == v) { return true; } }
        return false;
    }

    // IDE 视图状态管理与用户交互调度。
    // 接口数据协议与执行契约。
    static string GenBusinessShell(string name) {
        string s = "using System;\n";
        s = s + "using Gui;\n";
        s = s + "using Gui.Widget;\n\n";
        s = s + "// Business logic for " + name + ". The window is designed visually in\n";
        s = s + "// " + name + ".html. At compile time zanc projects its typed controls\n";
        s = s + "// and Main from the design, so there is no generated file to keep in sync.\n";
        s = s + "// This file is yours - the designer never overwrites it.\n";
        s = s + "partial class " + name + " {\n";
        s = s + "    // Runs once after the window is built, before the event loop.\n";
        s = s + "    // Bind events on the designed controls here, for example:\n";
        s = s + "    //     OkButton.OnClick(() => { });\n";
        s = s + "    static void OnLoad(Form form) {\n";
        s = s + "    }\n";
        s = s + "}\n";
        return s;
    }

    // IDE 视图状态管理与用户交互调度。
    // 接口数据协议与执行契约。
    static string FreeFormBody(string name, int winW, int winH) {
        FormDoc o = new FormDoc();
        o.name = name;
        o.winW = winW;
        o.winH = winH;
        o.winTitle = name;
        o.winCenter = true;
        o.layoutMode = 1;
        o.winZoom = 0;
        o.fields = new List<FormFieldDoc>();
        o.fields.Add(FreeFormField("15", "欢迎", "TitleLabel",
            "24", "16", "16", "448", "30", false, false));
        o.fields.Add(FreeFormField("0", "姓名", "NameInput",
            "24", "60", "76", "360", "32", true, false));
        o.fields.Add(FreeFormField("2", "密码", "PasswordInput",
            "24", "60", "122", "360", "32", true, false));
        o.fields.Add(FreeFormField("5", "记住我", "RememberCheck",
            "24", "60", "168", "200", "26", false, false));
        o.fields.Add(FreeFormField("49", "登录", "SignInButton",
            "24", "160", "220", "160", "36", false, false));
        o.fields.Add(FreeFormField("16",
            "提示：在设计器中可切换流式/自由布局、缩放窗口，并把组件拖到画布任意位置。",
            "HintText", "24", "16", "300", "448", "40", false, true));
        return System.Web.DesignerHtml.FromJsonDoc(Json.Serialize<FormDoc>(o));
    }

    // 接口数据协议与执行契约。
    static FormFieldDoc FreeFormField(string type, string label, string fname,
            string span, string fx, string fy, string fw, string fh,
            bool required, bool wrap) {
        FormFieldDoc f = new FormFieldDoc();
        f.type = ZanIDE.ParseInt(type);
        f.label = label;
        f.name = fname;
        f.required = required;
        f.span = ZanIDE.ParseInt(span);
        f.fx = ZanIDE.ParseInt(fx);
        f.fy = ZanIDE.ParseInt(fy);
        f.fw = ZanIDE.ParseInt(fw);
        f.fh = ZanIDE.ParseInt(fh);
        f.wrap = wrap;
        return f;
    }

    // IDE 视图状态管理与用户交互调度。
    // 代码导航与工程符号语义索引契约。
    // IDE 视图状态管理与用户交互调度。
    static string GenFreeShell(string name) {
        string s = "using System;\n";
        s = s + "using Gui;\n";
        s = s + "using Gui.Widget;\n\n";
        s = s + "// Business logic for " + name + ". The window is designed visually in\n";
        s = s + "// " + name + ".html (open it in the form designer). This form uses FREE\n";
        s = s + "// layout: every control is absolutely positioned on the design canvas.\n";
        s = s + "// At compile time zanc projects its typed controls and Main from the\n";
        s = s + "// design, so there is no generated file to keep in sync. This file is\n";
        s = s + "// yours - the designer never overwrites it.\n";
        s = s + "partial class " + name + " {\n";
        s = s + "    // Runs once after the window is built, before the event loop starts.\n";
        s = s + "    static void OnLoad(Form form) {\n";
        s = s + "        SignInButton.OnClick(() => {\n";
        s = s + "            // Required fields (marked in the designer) are validated by the\n";
        s = s + "            // generated __ValidateForm: empty inputs get a red border + message.\n";
        s = s + "            if (!__ValidateForm()) { return; }\n";
        s = s + "            TitleLabel.Text = \"你好，\" + NameInput.GetText() + \"!\";\n";
        s = s + "        });\n";
        s = s + "        PasswordInput.OnEnter(() => { TitleLabel.Text = \"已按回车\"; });\n";
        s = s + "        RememberCheck.OnChange(() => {\n";
        s = s + "            TitleLabel.Text = \"记住我：\" + RememberCheck.IsChecked();\n";
        s = s + "        });\n";
        s = s + "    }\n";
        s = s + "}\n";
        return s;
    }

    // 代码导航与工程符号语义索引契约。
    // IDE 视图状态管理与用户交互调度。
    // 接口数据协议与执行契约。
    // IDE 视图状态管理与用户交互调度。
    // 接口数据协议与执行契约。

    static string SceneCodeBehindPath(string scenePath) {
        int n = scenePath.Length;
        if (n >= 7 && scenePath.Substring(n - 7, 7) == ".zscene") {
            return scenePath.Substring(0, n - 7) + ".zan";
        }
        return scenePath + ".zan";
    }

    static string GenSceneFile(string name, SceneDoc doc) {
        List<string> decls = new List<string>();
        List<string> used = new List<string>();
        List<string> body = new List<string>();
        for (int i = 0; i < doc.Count(); i = i + 1) {
            SceneElement e = doc.ElementAt(i);
            string vn = "e" + Convert.ToString(i);
            bool typed = ZanIDE.IsIdent(e.Name()) && !ZanIDE.ListHasStr(used, e.Name());
            if (typed) {
                vn = e.Name();
                used.Add(vn);
                decls.Add("    static SceneElement " + vn + ";");
            } else {
                body.Add("        SceneElement " + vn + ";");
            }
            body.Add("        " + vn + " = new SceneElement(\"" + ZanIDE.EscZ(e.Kind()) + "\", \"" + ZanIDE.EscZ(e.Name()) + "\");");
            body.Add("        " + vn + ".At(" + Convert.ToString(e.X()) + ", " + Convert.ToString(e.Y()) + ");");
            body.Add("        " + vn + ".Size(" + Convert.ToString(e.W()) + ", " + Convert.ToString(e.H()) + ");");
            body.Add("        " + vn + ".AnchorTo(" + Convert.ToString(e.AnchorX()) + ", " + Convert.ToString(e.AnchorY()) + ");");
            body.Add("        " + vn + ".Order(" + Convert.ToString(e.Z()) + ");");
            body.Add("        " + vn + ".Tint(" + Convert.ToString(e.R()) + ", " + Convert.ToString(e.G()) + ", " + Convert.ToString(e.B()) + ", " + Convert.ToString(e.A()) + ");");
            if (e.ImageId().Length > 0) {
                body.Add("        " + vn + ".Image(\"" + ZanIDE.EscZ(e.ImageId()) + "\");");
            }
            if (e.Text().Length > 0) {
                body.Add("        " + vn + ".Caption(\"" + ZanIDE.EscZ(e.Text()) + "\");");
            }
            if (e.IsGrid() || e.GapX() != 0 || e.GapY() != 0) {
                body.Add("        " + vn + ".Grid(" + Convert.ToString(e.Rows()) + ", " + Convert.ToString(e.Cols()) + ", " + Convert.ToString(e.GapX()) + ", " + Convert.ToString(e.GapY()) + ");");
            }
            if (e.Value() != 0) {
                body.Add("        " + vn + ".SetValue(" + Convert.ToString(e.Value()) + ");");
            }
            if (e.Items().Length > 0) {
                body.Add("        " + vn + ".SetItems(\"" + ZanIDE.EscZ(e.Items()) + "\");");
            }
            if (e.Locked()) {
                body.Add("        " + vn + ".SetLocked(true);");
            }
            if (e.Layer().Length > 0) {
                body.Add("        " + vn + ".SetLayer(\"" + ZanIDE.EscZ(e.Layer()) + "\");");
            }
            if (e.OnAction("Click").Length > 0) {
                body.Add("        " + vn + ".On(\"Click\", \"" + ZanIDE.EscZ(e.OnAction("Click")) + "\");");
            }
            if (!e.Visible()) {
                body.Add("        " + vn + ".SetVisible(false);");
            }
            body.Add("        d.Add(" + vn + ");");
        }
        int dw = doc.DesignWidth();
        if (dw <= 0) { dw = 1280; }
        int dh = doc.DesignHeight();
        if (dh <= 0) { dh = 720; }
        string dws = Convert.ToString(dw);
        string dhs = Convert.ToString(dh);
        string wtitle = doc.WinTitle();
        if (wtitle.Length == 0) { wtitle = name; }
        string s = "// <auto-generated> compile-time projection of " + name + ".zscene.\n";
        s = s + "// The design document is the source of truth; this code is not a file.\n";
        s = s + "// Put your initialization and game logic in " + name + ".zan.\n";
        s = s + "using System;\n";
        s = s + "using Gui;\n";
        s = s + "using Game.Scene;\n\n";
        s = s + "partial class " + name + " {\n";
        for (int d = 0; d < decls.Count; d = d + 1) { s = s + decls[d] + "\n"; }
        s = s + "    static SceneDoc scene;\n\n";
        s = s + "    /// Builds the designed scene document (design-resolution HUD tree).\n";
        s = s + "    static SceneDoc BuildScene() {\n";
        s = s + "        SceneDoc d = new SceneDoc(\"" + ZanIDE.EscZ(name) + "\", " + dws + ", " + dhs + ");\n";
        s = s + "        d.SetMode(" + Convert.ToString(doc.Mode()) + ");\n";
        s = s + "        d.SetClearColor(" + Convert.ToString(doc.ClearR()) + ", " + Convert.ToString(doc.ClearG()) + ", " + Convert.ToString(doc.ClearB()) + ");\n";
        if (doc.Background().Length > 0) {
            s = s + "        d.SetBackground(\"" + ZanIDE.EscZ(doc.Background()) + "\");\n";
        }
        for (int b = 0; b < body.Count; b = b + 1) { s = s + body[b] + "\n"; }
        s = s + "        return d;\n";
        s = s + "    }\n\n";
        s = s + "    /// Opens this designed scene and renders it until the window\n";
        s = s + "    /// closes, so one design opens another with `" + name + ".Run();`.\n";
        s = s + "    static void Run() {\n";
        s = s + "        scene = BuildScene();\n";
        s = s + "        App app = App.CreateDark(\"" + ZanIDE.EscZ(wtitle) + "\", " + dws + ", " + dhs + ");\n";
        if (doc.WinCenter() != 0) {
            s = s + "        app.CenterWindow();\n";
        } else {
            s = s + "        app.SetWindowPos(" + Convert.ToString(doc.WinPosX()) + ", " + Convert.ToString(doc.WinPosY()) + ");\n";
        }
        if (!doc.WinResizable()) {
            s = s + "        app.SetResizable(false);\n";
        }
        if (!doc.WinChrome()) {
            s = s + "        app.SetChromeVisible(false);\n";
        }
        s = s + "        app.Show();\n";
        s = s + "        " + name + ".OnLoad(app);\n";
        s = s + "        scene.SetLayersActive(true);\n";
        s = s + "        while (app.isRunning) {\n";
        s = s + "            if (!app.ProcessEvent()) { break; }\n";
        s = s + "            if (!app.needsRedraw) { continue; }\n";
        s = s + "            app.BeginFrame();\n";
        s = s + "            SceneView.Render(app, scene);\n";
        s = s + "            SceneView.HandleClicks(app, scene);\n";
        s = s + "            app.RenderChrome(\"" + ZanIDE.EscZ(wtitle) + "\");\n";
        s = s + "            app.PresentFrame();\n";
        s = s + "            if (scene.PendingScene().Length > 0) {\n";
        s = s + "                app.RequestClose();\n";
        s = s + "            }\n";
        s = s + "        }\n";
        s = s + "    }\n\n";
        s = s + "    static void Main() {\n";
        s = s + "        " + name + ".Run();\n";
        s = s + "    }\n\n";
        s = s + "    /// Adapts this designed scene to Game.Foundation.IGameScene\n";
        s = s + "    /// so it plugs into a SceneStack directly:\n";
        s = s + "    ///     var s = new " + name + "Scene();\n";
        s = s + "    ///     stack.Push(s);\n";
        s = s + "    ///     s.Host(app);          // once, before the loop\n";
        s = s + "    ///     stack.Update(deltaMs); // per frame\n";
        s = s + "    /// PendingScene() names the scene queued by an OpenScene\n";
        s = s + "    /// action (the host decides how to switch);\n";
        s = s + "    /// ClearPendingScene() consumes it.\n";
        s = s + "    partial class " + name + "Scene : Game.Foundation.IGameScene {\n";
        s = s + "        SceneDoc d;\n";
        s = s + "        App host;\n\n";
        s = s + "        public string Name() { return \"" + ZanIDE.EscZ(name) + "\"; }\n\n";
        s = s + "        /// Gives the adapter the host window; call once after\n";
        s = s + "        /// the App exists, before the first Update.\n";
        s = s + "        public void Host(App app) { host = app; }\n\n";
        s = s + "        /// Rebuilds the design document for this entry.\n";
        s = s + "        public void Enter() {\n";
        s = s + "            d = " + name + ".BuildScene();\n";
        s = s + "            d.SetLayersActive(true);\n";
        s = s + "            " + name + ".OnSceneEnter();\n";
        s = s + "        }\n\n";
        s = s + "        public void Exit() {\n";
        s = s + "            " + name + ".OnSceneExit();\n";
        s = s + "            d = null;\n";
        s = s + "        }\n\n";
        s = s + "        public void Pause() { " + name + ".OnScenePause(); }\n\n";
        s = s + "        public void Resume() { " + name + ".OnSceneResume(); }\n\n";
        s = s + "        public void FixedUpdate(int deltaMilliseconds) {\n";
        s = s + "            " + name + ".OnSceneFixedUpdate(deltaMilliseconds);\n";
        s = s + "        }\n\n";
        s = s + "        /// One frame: render + click dispatch on the live design\n";
        s = s + "        /// into the host window (no-op while paused/without host).\n";
        s = s + "        public void Update(int deltaMilliseconds) {\n";
        s = s + "            if (d == null || host == null) { return; }\n";
        s = s + "            if (!host.needsRedraw) { return; }\n";
        s = s + "            host.BeginFrame();\n";
        s = s + "            SceneView.Render(host, d);\n";
        s = s + "            SceneView.HandleClicks(host, d);\n";
        s = s + "            host.PresentFrame();\n";
        s = s + "        }\n\n";
        s = s + "        /// The live design document (null before Enter /\n";
        s = s + "        /// after Exit): register click handlers here, e.g.\n";
        s = s + "        ///     Doc().SetHandler(\"OnNext\", () => { ... });\n";
        s = s + "        public SceneDoc Doc() { return d; }\n\n";
        s = s + "        /// OpenScene target queued by actions (the host switches\n";
        s = s + "        /// and calls ClearPendingScene); \"\" = none.\n";
        s = s + "        public string PendingScene() {\n";
        s = s + "            return d == null ? \"\" : d.PendingScene();\n";
        s = s + "        }\n";
        s = s + "    }\n";
        s = s + "}\n";
        return s;
    }

    // IDE 视图状态管理与用户交互调度。
    static string GenSceneBusinessShell(string name) {
        string s = "using System;\n";
        s = s + "using Gui;\n";
        s = s + "using Game.Scene;\n\n";
        s = s + "// Business logic for scene " + name + ". The scene is designed visually in\n";
        s = s + "// " + name + ".zscene; the compiler projects its typed elements at build time.\n";
        s = s + "// This file is yours - the designer never overwrites it.\n";
        s = s + "partial class " + name + " {\n";
        s = s + "    // Runs once after the scene is built, before the render loop.\n";
        s = s + "    // The SceneDoc is in `scene`; named elements are typed fields, e.g.\n";
        s = s + "    //     HealthBar.SetValue(80);\n";
        s = s + "    static void OnLoad(App app) {\n";
        s = s + "    }\n";
        s = s + "\n";
        s = s + "    // Optional Game.Foundation.IGameScene lifecycle hooks (the\n";
        s = s + "    // generated " + name + "Scene adapter calls these; delete the ones\n";
        s = s + "    // you do not use):\n";
        s = s + "    static void OnSceneEnter() {\n";
        s = s + "    }\n";
        s = s + "    static void OnSceneExit() {\n";
        s = s + "    }\n";
        s = s + "    static void OnScenePause() {\n";
        s = s + "    }\n";
        s = s + "    static void OnSceneResume() {\n";
        s = s + "    }\n";
        s = s + "    static void OnSceneFixedUpdate(int deltaMilliseconds) {\n";
        s = s + "    }\n";
        s = s + "}\n";
        return s;
    }

    static bool TabsMatchRecords(Tabs widget, List<TabRecord> records) {
        if (widget == null || records == null) { return false; }
        if (widget.Count() != records.Count) { return false; }
        for (int i = 0; i < records.Count; i = i + 1) {
            if (widget.LabelAt(i) != records[i].name) { return false; }
        }
        return true;
    }

    // IDE 视图状态管理与用户交互调度。
    // 核心契约与语义定义。
    static bool StringListsEqual(List<string> a, List<string> b) {
        if (a == null || b == null) { return false; }
        if (a.Count != b.Count) { return false; }
        for (int i = 0; i < a.Count; i = i + 1) {
            if (a[i] != b[i]) { return false; }
        }
        return true;
    }

    // IDE 视图状态管理与用户交互调度。
    void SyncEditorTabs() {
        if (editorTabs == null) {
            editorTabs = new Tabs(Tabs.Card());
            editorTabs.SetShowAdd(true);
            editorTabs.SetHostModel(true);
        }
        if (!ZanIDE.TabsMatchRecords(editorTabs, tabs)) {
            Tabs nt = new Tabs(Tabs.Card());
            nt.SetShowAdd(true);
            nt.SetHostModel(true);
            for (int i = 0; i < tabs.Count; i = i + 1) {
                nt.Add(tabs[i].name, true);
            }
            editorTabs = nt;
        }
    }

    // 核心契约与执行状态转移规范。
}