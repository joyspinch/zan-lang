// IDE 视图状态管理与用户交互调度。
// 接口数据协议与执行契约。
class IdeSourceSnapshot {
    string path;
    string key;
    string body;
    int version;

    static IdeSourceSnapshot Create(string path, string body, int version) {
        IdeSourceSnapshot source = new IdeSourceSnapshot();
        source.path = path; source.key = ZanIDE.NormPath(path);
        source.body = body; source.version = version;
        return source;
    }
}

