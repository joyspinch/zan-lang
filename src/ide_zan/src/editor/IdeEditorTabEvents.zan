using Gui;

// The strip owns its callbacks; the relay must not keep the IDE alive.
class IdeEditorTabEvents {
    public weak ZanIDE owner;
    public void Changed(Control sender) {
        ZanIDE target = owner;
        if (target != null) { target.OnEditorTabChanged(sender); }
    }
    public void Added(Control sender) {
        ZanIDE target = owner;
        if (target != null) { target.OnEditorTabAdded(sender); }
    }
    public void DesignChanged(Control sender) {
        ZanIDE target = owner;
        if (target != null) { target.OnDesignTabChanged(sender); }
    }
    public void LspClicked(Control sender) {
        ZanIDE target = owner;
        if (target != null) { target.OnLspStatusClicked(sender); }
    }
    public void Closed(Control sender) {
        ZanIDE target = owner;
        if (target != null) { target.OnEditorTabClosed(sender); }
    }
}
