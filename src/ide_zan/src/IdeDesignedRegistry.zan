// Install() 的组件类发一条调用。新增组件只需新增文档（或带
// Install 的组件类）后重新构建，本表自动更新。勿手改。
using Gui;
using Gui.Widget;
using Gui.Component;

public static class IdeDesignedRegistry {
    static bool installed;

    // 注册文档实际引用的全部 kind（幂等）。未注册的 kind 显式
    // 失败（节点为 null），拼错的名字不会静默变型。
    public static void Install() {
        if (installed) { return; }
        installed = true;
        Gui.ControlBootstrap.Install();
        Gui.Component.DataTable.DataTableBootstrap.Install();
        HeavyControls.Register("AssetPanel", (string k) => new AssetPanel());
        Gui.Component.ChatView.Install();
        Gui.Component.ConsoleView.Install();
        HeavyControls.Register("CtxRing", (string k) => new CtxRing());
        DocsCodeBlockHost.Install();
        DocsPreviewHost.Install();
        DocsSearchHost.Install();
        DocsSectionTabs.Install();
        DocsTagHost.Install();
        DocsTopicList.Install();
        ErrorList.Install();
        Gui.Component.GraphView.Install();
        IdeSurface.Install();
        HeavyControls.Register("MarketplaceView", (string k) => new MarketplaceView());
        HeavyControls.Register("PlanStrip", (string k) => new PlanStrip());
        HeavyControls.Register("RunStrip", (string k) => new RunStrip());
        HeavyControls.Register("SendCue", (string k) => new SendCue());
        HeavyControls.Register("TeamBoard", (string k) => new TeamBoard());
    }
}
