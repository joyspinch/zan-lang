using System;
using System.IO;
using System.Diagnostics;
using System.Json;
using System.Data;
using System.Data.Sqlite;
using Platform;
using Gui;
using Gui.Widget;
using Gui.Designer;
using Gui.Component;
using Game.Scene;

/// 标签页的关闭规则（关这一个 / 关其它），含活动标签的重新归位。
partial class ZanIDE {
    /// Closes the tab at `idx`, falling back to the Start tab if it was the
    /// last one open, and clamping the active index.
    static void CloseTabAt(List<TabRecord> tabs, SignalInt active, int idx) {
        if (idx < 0 || idx >= tabs.Count) { return; }
        tabs.RemoveAt(idx);
        if (tabs.Count == 0) {
            tabs.Add(TabRecord.Create("Start", "", "@start"));
        }
        int a = active.Get();
        if (a > idx) { a = a - 1; }
        if (a >= tabs.Count) { a = tabs.Count - 1; }
        if (a < 0) { a = 0; }
        active.Set(a);
    }

    /// Closes every tab except the one at `idx`, which becomes active.
    static void CloseOtherTabs(List<TabRecord> tabs, SignalInt active, int idx) {
        if (idx < 0 || idx >= tabs.Count) { return; }
        for (int k = tabs.Count - 1; k >= 0; k = k - 1) {
            if (k != idx) {
                tabs.RemoveAt(k);
            }
        }
        active.Set(0);
    }
}
