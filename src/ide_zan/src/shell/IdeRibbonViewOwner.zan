using Gui;

// The view and its event endpoints borrow the IDE. Retaining a queued endpoint
// cannot retain the window, and UiViewScope retires that endpoint on close.
class IdeRibbonViewOwner : UiViewOwner {
    public weak ZanIDE Owner;

    public void PrepareView(UiViewScope view, App app) {
        ZanIDE owner = Owner;
        if (owner != null) { owner.PrepareRibbonView(app); }
    }

    public void ViewAction(string name, Control sender) {
        ZanIDE owner = Owner;
        if (owner != null) { owner.RibbonViewAction(name, sender); }
    }

    public void ViewPointer(Control sender, RoutedEventArgs args) { }
}
