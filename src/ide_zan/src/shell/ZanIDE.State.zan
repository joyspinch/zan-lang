    SignalInt catSel;
    SignalInt pSel;
    SignalInt fSel;
    SignalInt fSizeSel;
    Input fSizeWIn;
    Input fSizeHIn;
    SignalInt pSizeSel;
    Input pSizeWIn;
    Input pSizeHIn;
    // New Project 目标设备画像（DeviceProfile.All() 下标；0 = 桌面
    // 自由尺寸）与横竖屏方向（0 竖 / 1 横）。锁定类设备收起尺寸
    // 预设行，画布由画像给出，创建时连同 device 一并写进 .html。
    SignalInt pDevSel;
    SignalInt pDevRot;
    int pSizeSeededFor;
    List<string> platformGroups;
    List<WizardTarget> platforms;
    Input pNameInput;
    Input pLocInput;
    Input fNameInput;
    int ctxKind;
    int ctxX;
    int ctxY;
    int ctxTarget;
    // 功能区溢出菜单（ctxKind == 8）：条带放不下、收进「»」的那些
    // 命令。菜单项文案 + 动作号在打开时定下（动作表每帧重建，
    // 菜单开着也不怕对不上）。arm 跳过打开当帧的那次点击——
    // 菜单开在按钮下方，那次点击落在菜单外，否则同帧自关。
    List<string> ribbonOverflowLabels;
    List<int> ribbonOverflowActions;
    bool ribbonOverflowArm;
    // 右键落在任务图上时的节点号（ctxKind == 7）：图的行号会随重新分层
    // 变化，所以菜单记的是任务 id 而不是行。
    string ctxTaskId;
    SignalInt tmplCatSel;
    Input tmplNameInput;
    List<WizardItem> saveItems;
    int findMode;
    List<SearchHit> fifHits;
    string fifQuery;
    string fifRepl;
    int fifSel;
    // 光标下那个要被重命名的词（F2 打开输入条时定下来）。
    string renameWord;
    // 跳转 / 断点条件 / 重命名 / 全项目查找替换共用的那个小输入条。
    QuickPrompt quickPrompt;
    FindBar findBar;
    RefListPopup refList;
    int refAnchorLine;
    // Ctrl+T 全项目符号检索的浮层（LSP workspace/symbol 的结果列表）。
    SymbolListPopup symbolList;
    string symbolQuery;
    List<LspWorkspaceSymbol> symbolHits;
    // Alt+Enter 行内代码动作（LSP textDocument/codeAction 的结果菜单）。
    List<LspCodeAction> codeActionHits;
    List<string> codeActionLabels;
    int codeActionX;
    int codeActionY;
    int codeActionPick;
    StartPage startPage;
    PublishWindow pubWin;
    bool pubPending;
    List<PublishTargetOption> pubPlatformOptions;
    string pubRoot;
    bool pubPacked;
    bool pubBusy;
    int pubStartMs;
    int pubPackStartMs;
    List<string> pubExes;
    int pubLogLen;
    string pubStep;
    bool pubPacking;
    // 提示用户是否打开发布产物目录的模态对话框状态
    LayerState pubDoneAsk;
    string pubDoneTarget;
    ConfigWindow cfgWin;
    MarketplaceWindow marketplaceWin;
    bool marketplaceRetryBuild;
    int edThemeIdx;
    int edFontPx;
    int defFontPx;
    EditorSettingsWindow settingsWindow;
    int pendingGotoLine;
    int pendingGotoCol;
    List<IdeNavLocation> navBackStack = new List<IdeNavLocation>();
    List<IdeNavLocation> navForwardStack = new List<IdeNavLocation>();
    LogState coLog;
    bool coCtxOpen;
    int coCtxX;
    int coCtxY;
    int coCtxRow;
    Input coFilter;
    int dbgState;
    int dbgExecLine;
    DebugSession dbg;
    List<string> dbgConsole;
    List<DbgVar> dbgVarInfo;
    List<DbgFrame> dbgStack;
    SignalInt dbgPanelTab;
    List<DbgBreakpoint> bpConds;
    // 调试监视项实体列表（消除 dbgWatches / dbgWatchVals 平行列表反模式）。
    List<DbgVar> dbgWatches;
    LspSession lspSess;
    bool lspTried;
    // 语言服务状态与诊断：状态栏常驻显示（0=未启用 1=连接中
    // 2=已连接 3=不可用），lspError 说清不可用的原因，
    // lspStartedMs 用来判"连接中"是否已经卡死。
    int lspState;
    string lspError;
    long lspStartedMs;
    // 从"发起启动"到"连上"实际花了多少毫秒。zan-lsp 冷启动要索引
    // stdlib + 全部可见包仓库（建树里 11~13 秒），这个数是唯一能
    // 说明"为什么状态栏一直是连接中"的凭据，别再靠猜。
    long lspConnectMs;
    // 手动重连语言服务的次数（探针/回归用）。
    int lspRestarts;
    bool designerMode;
    Designer formDesigner;
    string codeViewForm;
    CodeEditor formCodeEd;
    string formCodeLoaded;
    bool sceneMode;
    SceneDesigner sceneDesigner;
    // 工作面维度一：项目种类 0=工具 1=游戏，由工程类型自动判定
    // （见 ZanIDE.Modes）。维度二（Agent）是右侧那扇会话面板的显隐，
    // 状态在 dock 里，不另设字段。
    int projKind;
    int sbWorkItem;
    AssetManager assetMgr;
    SignalInt treeW;
    SignalInt bottomPanelH;
    SignalInt rightW;
    DockHost dock;
    string dockOutlineTitle;
    string dockErrorsTitle;
    List<string> gitFiles;
    string gitBranch;
    string gitHead;
    bool gitLoaded;
    int gitJob;
    SignalInt gitSel;
    ListView<string> gitList;
    SignalInt gitScroll;
    List<TreeNode> rtToolTree;
    List<TreeNode> rtExTree;
    SignalInt rtToolSel;
    SignalInt rtExSel;
    Input rtToolFilter;
    Input rtExFilter;
    List<TreeNode> rtCtxShow;
    List<ChatMessage> aiMsgs;
    SignalInt aiBusy;
    List<AiProfile> aiProfiles;
    List<AiProfile> aiProfHold;
    int aiProfActive;
    // 每个团队成员自己的提示词（角色 id -> 文本，ai_role_prompts.json）；
    // 没配过的成员用内置的默认提示词。
    string aiRolePrompts;
    AiSettingsWindow aiWindow;
    bool aiCfgPending;
    // 小赞独立子窗口（dialogs/AiAssistantWindow.zan）：AI 面板不再停靠，
    // 整个搬进这扇顶层窗口。渲染由 ChildWindow 的 SetRender 回调驱动
    // （Form.Run 里 ChildWindows.PumpAll 泵到），外壳只负责在帧与帧之间
    // 兑现开启请求（aiWinPending）和回收已关闭的引用。
    AiAssistantWindow aiWin;
    bool aiWinPending;
    Dropdown<ModelOption> aiModelSel;
        // 本帧生效的聊天模型（下拉的选择，或启用 profile 的默认模型）。
        // 发送处理器、agent 层都读它，所以它由绘制那一步先算好。
        string aiChatModel;
    List<ModelOption> aiModelOptions;
    string aiModelSelSig;
    List<AiSession> aiSessions;
    int aiSessCur;
    string aiSessDbPath;
    int aiLastSave;
    // 上一次自动保存时这段对话的廉价指纹（轮数、尾条长度、计划、任务图与交付
    // 状态）。自动保存先比它：不然每秒都要把整段对话序列化一遍才知道「没
    // 变」，而那次序列化在上千轮的对话里就是 CPU 的大头。
    string aiSaveSig;
    // 「最后一段 AI 代码」的缓存与它的指纹（轮数 + 尾条长度）：切出那段代码
    // 要复制整条回答，长回答每帧复制一次纯属白烧 CPU。
    string aiCodeSig;
    string aiCodeVal;
    SessionList aiSessNav;
    List<AiPlanStep> aiPlan;
    // 上一次拼进提示词的那份计划的签名（见 AiPlanSig）：计划不动就不重拼那
    // 段文字，也让它在两次请求之间逐字节相同（缓存前缀）。
    string aiPlanSig;
    // 计划和交付状态都由 AiPanel 里声明的 PlanStrip 显示（views/
    // PlanStrip.html）：外壳只持有这份计划本身。
    // (AiAgent.MaxContextCharsOf).
    int aiTokPrompt;
    int aiTokCompletion;
    int aiTokTotal;
    int aiTokCached;
    int aiRetry;
    int aiAutoCont;
    // 本次会话允许的自动继续拍数（AI 设置里的「自动继续上限」，0 = 不限，
    // 没配过就是 AiAgent.MaxContinues()），已经过 AiAgent.ContinuesBudget
    // 解析，所以用它的地方直接比大小。
    int aiContMax;
    // 本次会话允许的自动交接次数：同一个设置项（见 AiTeam.HandoffsBudget），
    // 所以「自动继续设成不限」时团队也不会在交接上被拦住。
    int aiHandoffMax;
    string aiRunModel;
    string aiRunCtxName;
    string aiRunCtxCode;
    string aiPendingCall;
    bool aiAutoExec;
    bool aiBuildForAi;
    bool aiUiPending;
    bool aiUiRunning;
    string aiUiScript;
    int aiUiDeadline;
    string aiUiTool;
    bool aiTeamMode;
    string aiSendTo;
    string aiRunAgent;
    string aiRunRoot;
    AiTeamState aiTeamSt;
    int aiHandoffs;
    // 本次提问里已经跑过的查询调用签名（AiAgent.CallSig）。同一个查询发第二
    // 次只会把一模一样的结果再堆一遍上下文，模型于是原地打转、同一段催促
    // 刷屏，所以第二次被拒。写入会清空这份记录（文件变了，再读是合理的）。
    List<string> aiToolSigs;
    // 本次提问里 read_file 已经覆盖到的行区间实体记录集合。
    // 签名里带 offset/limit，所以「读 1-200 再读 40-120」是两个签名却
    // 一个新字节都读不到；按区间比才拦得住这种重复。写入那个文件会清掉它
    // 自己那几条（见 AiForgetToolsFor）。
    List<AiReadSpan> aiReadSpans;
    // 上一次原地空转是「哪个节点上的哪个人」，以及连着空转了几次：同一个人
    // 在同一个节点上连着空转到上限就换人，而不是把它第三次催回原地。
    string aiIdleKey;
    int aiIdleTimes;
    // 已经因为空转换过一次人的那个节点。换了人还是空转说明这个节点自己有问题
    // （前置没交代清楚、要的工具没有、或者要求本身做不了），再转一圈只会变成
    // 「空转→换人→又派回来」的死循环：那时挂起节点，交给用户。
    string aiEscKey;
    // 上一拍为什么没算进展（人话，直接给用户看），以及最后一个真正跑成功的
    // 动作。挂起一个节点时光说「推不动」等于什么都没说：用户要的是「谁、最后
    // 做成了什么、然后卡在哪一步」。
    string aiIdleWhy;
    string aiLastAct;
    // 「哪个节点上的哪个人」连着查了几次没交东西：到上限就不给再查了（见
    // AiTeam.MaxLookups）。写入、构建、运行、交接、换节点都会清零。
    string aiLookKey;
    int aiLookTimes;
    // 停在「已交接（验收中）」却没人回验收结论的那个节点，以及已经催过几次。
    // 送去验收的那一拍要是没回 [report]/[block]，节点会一直挂在验收中，而它
    // 又是下游的前置——整张图就这么堵住（用户看到的「上游还在已交接，下游却
    // 开工了」的另一半）。催到上限就挂起它交给用户，不假装还在推进。
    string aiRevKey;
    int aiRevTimes;
    // 上一次「这一轮到头了」是对着什么样的图说的（节点数/已完成数）。图没变就
    // 不再重复那句交代——否则用户每按一次继续都收到同一段「无开放节点」。
    string aiWrapKey;
    List<AiTask> aiTasks;
    SignalInt aiTeamOpen;
    string aiGraphSel;
    string aiGraphRoot;
    string aiGraphSig;
    int aiCtxSaved;
    int aiChatFirstResp;
    int aiWaitStart;
    int aiStreamMsgIdx;
    int aiStreamLen;
    // 预览刷新的节流与止损：`aiStreamShown` 是上一次真正折过、排过版的长度，
    // `aiStreamAt` 是那一拍的时刻，`aiStreamSettled` 表示工具调用摘要已经定型
    // （后面再来的字节都是工具正文，那一行不会再变）。写一个几十 KB 的文件时，
    // 每一拍复制全文 + 重排整段聊天就是 GUI 线程「未响应」的那份活。
    int aiStreamShown;
    int aiStreamAt;
    bool aiStreamSettled;
    SseLive aiLive;
    // 每个上下文桶（任务号，或项目对话 "@project"）最近在聊天区里的那份
    // 记录，按桶名存在内存里。切节点会把 aiMsgs 整份换掉，没有这份留档时
    // 「点了任务面板，刚才聊的就没了」：没打开项目时 tasks.db 根本不可写,
    // 打开了项目也省掉来回切的重复读库。
    // 使用 AiContextBucket 实体列表统一管理，消除旧 aiCtxKeys / aiCtxMem 平行列表。
    List<AiContextBucket> aiCtxBuckets;
    string aiRingSig;
    nint termFp;
    int termLogLen;
    int runLogLen;
    bool runStreaming;
    bool buildBusy;
    int buildLogLen;
    int buildStartMs;
    long symbolIdxStamp;
    int symbolEmitMs;
    string buildExe;
    bool buildIsGui;
    bool buildThenRun;
    bool dbgBuildPending;
    string buildTargetPath;
    bool autoRun;
    bool hotReloadReq;
    SignalInt treeSel;
    List<TreeNode> exTree;
    SignalInt exSel;
    Input treeFilter;
    Input structFilter;
    Input exFilter;
    List<TreeNode> treeShow;
    List<TreeNode> structShow;
    List<TreeNode> exShow;
    List<TreeNode> structTree;
    SignalInt structSel;
    string structSig;
    int structPendingStamp;
    int structChangeMs;
    int lastPresent;
    int lastSkinIdx;
    TreeView explorerTv;
    TreeView structTv;
    TreeView stdlibTv;
    TreeView toolsTv;
    TreeView examplesTv;
    // 声明式的 dock 面板：每个面板是一个 .html 控件文档 + 同名
    // code-behind（src/ide_zan/src/panels/）。外壳只把 dock 分配的
    // 矩形交给它们，面板自己拥有控件树、绑定和事件。
    ExplorerPanel explorerPanel;
    OutputPanel outputPanel;
    ErrorsPanel errorsPanel;
    TerminalPanel terminalPanel;
    GitPanel gitPanel;
    StructurePanel structurePanel;
    StdlibPanel stdlibPanel;
    ToolsPanel toolsPanel;
    ExamplesPanel examplesPanel;
    AiPanel aiPanel;
        // 调试器的三块界面：底部面板、步进工具条、编辑器右上角的行内变量条。
        DebugPanel dbgPanel;
    DebugToolbar dbgToolbar;
    DebugInlineVars dbgInline;
}
