using System;
using System.IO;
using System.Threading;
using Gui;
using Gui.Component;

// Workers receive snapshots; only the posted completion touches the IDE or controls.
class IdeDocumentPageWork {
    public weak ZanIDE owner;
    public App host;
    public string root;
    public int workspace;
    public int sequence;
    public string removePath = "";
    public List<RecentItem> recents;
    public List<NewsItem> news;
    public string failure = "";
    public string path;
    public string fullPath;
    public string text;
    public StagedFile staged;
    public string stagedFullPath;
    public List<DiffLine> diffs;
    public bool completed;
    public TabRecord tab;
    public string tabPath = "";
    public string originalBody = "";
    public bool editorCaptured;
    public int editorStamp;
    public string editorText = "";
    public CodeEditorPreparedText prepared;
    public long stamp;
    public CancellationToken cancellation;
    public bool canceled;

    public void ReadStart() {
        try {
            // A submitted removal persists even after its page/workspace retires.
            if (removePath != "") { ZanIDE.RemoveRecentProject(removePath); }
            if (cancellation != null && cancellation.IsCancellationRequested) { canceled = true; }
            else {
                recents = ZanIDE.RecentProjectItems();
                news = ZanIDE.StartNews(root);
            }
        } catch (Exception error) { failure = error.Message; }
        host.Post(this.ApplyStart);
    }

    public void ApplyStart() {
        ZanIDE target = owner;
        if (target != null) { target.ApplyStartPageData(this); }
    }

    public void WriteDiff() {
        try {
            prepared = CodeEditor.PrepareText(text);
            string directory = Path.GetDirectoryName(fullPath);
            if (directory != "" && !Directory.Exists(directory)) { Directory.CreateDirectoryRecursive(directory); }
            File.WriteAllText(fullPath, text);
        } catch (Exception error) { failure = error.Message; }
        if (failure == "") {
            // Timestamp lookup cannot turn a completed write into a reported failure.
            try { stamp = FileInfo.GetLastWriteTime(fullPath); } catch (Exception) { }
        }
        host.Post(this.ApplyDiff);
    }

    public void ApplyDiff() {
        ZanIDE target = owner;
        if (target != null) { target.ApplyDiffWrite(this); }
    }
}
