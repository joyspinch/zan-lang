    WizardHost OpenWizardHost(App parent, string title, int w, int h, int mode) {
        WizardHost host = new WizardHost(title, w, h);
        host.OnClose(() => {
            dlg = null;
            dlgMode = 0;
            if (pathPickerOwner == 1) {
                pathPicker.Close();
                pathPickerOwner = 0;
            }
            app.RequestRedraw();
        });
        host.SetRender(() => {
            App hApp = host.Host();
            if (pathPicker.IsOpen()) { return; }
            hApp.BeginFrame();
            int savedSeq = WidgetId.SeqValue();
            WidgetId.SetSeq(850000);
            int action = 0;
            Wizard wiz;
            if (dlgMode == 1) {
                int psel = pSel.Get();
                if (psel != pSizeSeededFor) {
                    pSizeSeededFor = psel;
                    pSizeSel.Set(-1);
                    pDevRot.Set(0);
                    string sw = "";
                    string sh = "";
                    string devid = "";
                    if (psel >= 0 && psel < tpls.Count) {
                        devid = tpls[psel].device;
                        if (tpls[psel].sizeable && tpls[psel].defW > 0
                                && tpls[psel].defH > 0) {
                            sw = Convert.ToString(tpls[psel].defW);
                            sh = Convert.ToString(tpls[psel].defH);
                        }
                    }
                    DeviceProfile dp = DeviceProfile.ById(devid);
                    if (dp != null && dp.Locked()) {
                        pDevSel.Set(DeviceProfile.IndexOfId(devid));
                        pSizeWIn.SetText(Convert.ToString(dp.CanvasW(0)));
                        pSizeHIn.SetText(Convert.ToString(dp.CanvasH(0)));
                    } else {
                        pDevSel.Set(0);
                        pSizeWIn.SetText(sw);
                        pSizeHIn.SetText(sh);
                    }
                }
                wiz = Wizard.Categorized(ZanIDE.T("New Project", "新建项目"), catNames, catSel,
                                         wizTpls, pSel,
                                         pNameInput, pLocInput,
                                         platforms, platformGroups,
                                         pSizeSel, pSizeWIn, pSizeHIn,
                                         pDevSel, pDevRot);
            } else if (dlgMode == 3) {
                wiz = new Wizard(ZanIDE.T("Save as Template", "另存为模板"), saveItems,
                                    tmplCatSel, tmplNameInput, tmplNameInput, false, null);
            } else {
                SignalInt szSel = null;
                int fk = fSel.Get();
                if (ZanIDE.FileKindNeedsSize(fk)) { szSel = fSizeSel; }
                wiz = new Wizard(ZanIDE.T("New File", "新建文件"), fileItems, fSel,
                                    fNameInput, fNameInput, false, szSel,
                                    fSizeWIn, fSizeHIn);
            }
            action = wiz.Show(hApp);
            WidgetId.SetSeq(savedSeq);
            hApp.PresentFrame();

            if (action == 1) {
                bool dlgDone = true;
                if (dlgMode == 1) {
                    string parentDir = pLocInput.GetText();
                    string name = pNameInput.GetText();
                    int gi = pSel.Get();
                    if (gi >= 0 && gi < tpls.Count && tpls[gi].ptype == "gui" && ZanIDE.IsGuiReservedName(name)) {
                        Wizard.notice = ZanIDE.T(
                            "That name conflicts with a built-in Gui/System type. Choose another.",
                            "该名称与内置的 Gui/System 类型冲突，请换一个名称。");
                        dlgDone = false;
                    } else if (!ZanIDE.IsValidProjectName(name)) {
                        Wizard.notice = ZanIDE.T(
                            "The name contains invalid characters or is reserved. Use letters, digits, '_' or '-'.",
                            "名称包含非法字符或是保留名，请使用字母、数字、下划线或连字符。");
                        dlgDone = false;
                    } else if (ZanIDE.DirHasEntries(parentDir + "/" + name)) {
                        // 项目脚手架从不写进别人的目录：目标必须不存在或为空。
                        Wizard.notice = ZanIDE.T(
                            "That folder already exists and is not empty. Choose another name or location.",
                            "目标文件夹已存在且不是空的，请换个名称或位置。");
                        dlgDone = false;
                    } else if (gi >= 0 && gi < tpls.Count) {
                        string plats = ZanIDE.PlatformCsv(platforms);
                        // 选中的锁定类设备画像随尺寸一并写进 .html，
                        // 设计器据此持续锁定画布；桌面自由尺寸不写。
                        string devId = "";
                        DeviceProfile dp = DeviceProfile.At(pDevSel.Get());
                        if (dp != null && dp.Locked()) { devId = dp.Id(); }
                        ZanIDE.WriteLastPickerDirectory(parentDir);
                        string newDir = ZanIDE.CreateProjectT(tpls[gi], parentDir, name, plats,
                            ZanIDE.ParseIntSafe(pSizeWIn.GetText()),
                            ZanIDE.ParseIntSafe(pSizeHIn.GetText()), devId, log);
                        if (newDir == "") {
                            Wizard.notice = ZanIDE.T(
                                "Project creation failed. See the Output tab for details.",
                                "创建项目失败，详情见输出面板。");
                            dlgDone = false;
                        } else {
                            Layer.Notify(ZanIDE.T("Project created: ", "项目已创建：") + name, 3);
                            this.OpenProjectAsync(newDir);
                        }
                    }
                } else if (dlgMode == 3) {
                    string cat = saveItems[tmplCatSel.Get()].name;
                    string tname = tmplNameInput.GetText();
                    ZanIDE.SaveAsTemplate(root, cat, tname, log);
                    Layer.Notify(ZanIDE.T("Template saved: ", "模板已保存：") + tname, 3);
                } else {
                    string name = fNameInput.GetText();
                    if (ZanIDE.FileKindDeclaresType(fSel.Get())
                            && ZanIDE.IsGuiReservedName(name)) {
                        Wizard.notice = ZanIDE.T(
                            "That name conflicts with a built-in Gui/System type. Choose another.",
                            "该名称与内置的 Gui/System 类型冲突，请换一个名称。");
                        dlgDone = false;
                    } else if (ZanIDE.NewFileTaken(fSel.Get(), root, name) != "") {
                        // 新建从不覆盖已有文件：让用户换个名字。
                        Wizard.notice = ZanIDE.T(
                            "A file with that name already exists. Choose another name.",
                            "同名文件已存在，请换一个名称。");
                        dlgDone = false;
                    } else {
                        string p = ZanIDE.CreateFile(fSel.Get(), root, name, fSizeSel.Get(),
                            ZanIDE.ParseIntSafe(fSizeWIn.GetText()),
                            ZanIDE.ParseIntSafe(fSizeHIn.GetText()), log);
                        if (p == "") {
                            Wizard.notice = ZanIDE.T(
                                "File creation failed. See the Output tab for details.",
                                "新建文件失败，详情见输出面板。");
                            dlgDone = false;
                        } else {
                            if (!Directory.Exists(p)) {
                                ZanIDE.OpenPath(tabs, activeTab, p, Path.GetFileName(p));
                            }
                            Layer.Notify(ZanIDE.T("Created: ", "已创建：")
                                + Path.GetFileName(p), 3);
                        }
                    }
                }
                if (dlgDone) {
                    rescan = true;
                    Wizard.notice = "";
                    host.Close();
                    dlg = null;
                    dlgMode = 0;
                } else {
                    host.RequestRedraw();
                }
                app.RequestRedraw();
            } else if (action == 2) {
                Wizard.notice = "";
                host.Close();
                dlg = null;
                dlgMode = 0;
                app.RequestRedraw();
            } else if (action == 3) {
                if (dlgMode == 1 && !pathPicker.IsOpen()) {
                    pathPicker.BeginFolder(ZanIDE.ReadLastPickerDirectory(pLocInput.GetText()),
                        ZanIDE.T("Select project location", "选择项目位置"));
                    pathPickerOwner = 1;
                    host.RequestRedraw();
                }
            }
        });
        dlg = host;
        dlgMode = mode;
        if (mode == 2) {
            fSel.Set(0);
            fNameInput.SetText("NewFile");
        }
        host.Open(parent);
        return host;
    }

    static void ExplorerPicked() {
        ZanIDE ide = ZanIDE.current;
        if (ide == null || !ide.explorerTv.HasSelection()) { return; }
        TreeNode node = ide.explorerTv.Selected();
        if (node.isDir || node.path == "") { return; }
        ZanIDE.OpenPath(ide.tabs, ide.activeTab, node.path, node.label);
        ide.log.Add("> Opened " + node.path + ".");
    }

    static void ExplorerContext() {
        ZanIDE ide = ZanIDE.current;
        if (ide == null) { return; }
        ide.ctxKind = 1;
        ide.ctxX = ide.explorerTv.ContextX();
        ide.ctxY = ide.explorerTv.ContextY();
        ide.ctxTarget = ide.explorerTv.ContextRow();
    }

    static void StructurePicked() {
        ZanIDE ide = ZanIDE.current;
        if (ide == null || !ide.structTv.HasSelection()) { return; }
        int ci = ZanIDE.OutlineLineOf(ide.structTv.Selected().path);
        if (ci < 0) { return; }
        if (ide.designerMode) {
            List<FormField> flat = new List<FormField>();
            ZanIDE.FlattenFields(ide.formDesigner.fields, flat);
            if (ci < flat.Count) { ide.formDesigner.sel = flat[ci]; }
        } else if (ide.sceneMode) {
            List<SceneElement> ord = ide.sceneDesigner.OrderedByZ();
            if (ci < ord.Count) {
                ide.sceneDesigner.sel = ord[ci];
                ide.sceneDesigner.selExtra = new List<SceneElement>();
            }
        } else {
            ide.pendingGotoLine = ci;
            ide.pendingGotoCol = 0;
        }
    }

    static void ExamplePicked() {
        ZanIDE ide = ZanIDE.current;
        if (ide == null || !ide.stdlibTv.HasSelection()) { return; }
        TreeNode en = ide.stdlibTv.Selected();
        if (en.isDir || en.path == "") { return; }
        if (ZanIDE.StartsWith(en.path, "@ex:")) {
            int di = ZanIDE.FindTabByPath(ide.tabs, "@docs");
            if (di >= 0) {
                ide.activeTab.Set(di);
            } else {
                ide.tabs.Add(TabRecord.Create(ZanIDE.T("Components", "组件中心"), "", "@docs"));
                ide.activeTab.Set(ide.tabs.Count - 1);
            }
            ide.lastActive = 0 - 1;
            ide.log.Add("> Opened the GUI component center.");
            return;
        }
        ZanIDE.OpenPath(ide.tabs, ide.activeTab, en.path, en.label);
        ide.log.Add("> Opened " + en.path + ".");
    }

    static void StdlibContext() {
        ZanIDE ide = ZanIDE.current;
        if (ide == null) { return; }
        ide.ctxKind = 2;
        ide.ctxX = ide.stdlibTv.ContextX();
        ide.ctxY = ide.stdlibTv.ContextY();
        ide.ctxTarget = ide.stdlibTv.ContextRow();
    }

    static void ToolActivated() {
        ZanIDE ide = ZanIDE.current;
        if (ide == null || !ide.toolsTv.HasSelection()) { return; }
        TreeNode n = ide.toolsTv.Selected();
        if (n.isDir || n.path == "" || ZanIDE.StartsWith(n.path, "@")) { return; }
        if (ide.buildBusy || ide.pubBusy) {
            Layer.Msg(ZanIDE.T("Build or publish already running…", "构建或发布进行中…"), 2);
            return;
        }
        ide.log.Add(ZanIDE.T("> Running tool ", "> 运行工具 ") + n.path + " ...");
        ide.BeginBuildJob(n.path, true);
        ide.dock.Focus("output");
    }

    static void ToolContext() {
        ZanIDE ide = ZanIDE.current;
        if (ide == null) { return; }
        ide.rtCtxShow = ide.toolsTv.Nodes();
        ide.ctxKind = 4;
        ide.ctxX = ide.toolsTv.ContextX();
        ide.ctxY = ide.toolsTv.ContextY();
        ide.ctxTarget = ide.toolsTv.ContextRow();
    }

    static void ExampleActivated() {
        ZanIDE ide = ZanIDE.current;
