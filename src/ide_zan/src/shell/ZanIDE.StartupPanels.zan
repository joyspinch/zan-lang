using System;
using System.IO;
using System.Diagnostics;
using System.Json;
using System.Data;
using System.Data.Sqlite;
using Platform;
using Gui;
using Gui.Backend;
using Gui.Widget;
using Gui.Designer;
using Gui.Component;
using Game.Scene;

// 启动时装配的后半段：面板与停靠、Git 面板、小助手、运行状态、侧栏，
// 以及新建项目 / 新建文件 / 另存为模板共用的向导宿主。
partial class ZanIDE {
    // 接口数据协议与执行契约。
    // 核心契约与语义定义。
    void InitPanelsAndDock(string cfg) {
        treeW = new SignalInt(ZanIDE.CfgClamp(ZanIDE.CfgInt(cfg, "treeW", 240), 120, 900));
        // 接口数据协议与执行契约。
        bottomPanelH = new SignalInt(ZanIDE.CfgClamp(ZanIDE.CfgInt(cfg, "bottomH", 190), 70, 2000));

        // 接口数据协议与执行契约。
        rightW = new SignalInt(ZanIDE.CfgClamp(ZanIDE.CfgInt(cfg, "rightW", 600), 120, 1600));

        // 核心契约与执行状态转移规范。
        // 接口数据协议与执行契约。
        dock = new DockHost();
        dock.emptyMenuLabel = ZanIDE.T("No closed panels", "没有已关闭的面板");
        dock.Register("explorer", "", DockSide.Left(), true, true);
        dock.Register("structure", "", DockSide.Left(), true, true);
        dock.Register("stdlib", "", DockSide.Left(), true, true);
        // 设计器的组件面板和属性面板是 IDE 自己的 dock 面板，
        // 不再占用设计器画布两侧的位置：设计器里只剩功能区 + 画布。
        dock.Register("toolbox", "", DockSide.Left(), true, false);
        dock.RegisterFixed("editor", "Editor");
        // 接口数据协议与执行契约。
        dock.Register("tools", "", DockSide.Right(), true, true);
        dock.Register("examples", "", DockSide.Right(), true, false);
        dock.Register("git", "", DockSide.Right(), true, false);
        dock.Register("props", "", DockSide.Right(), true, false);
        dock.Register("output", "", DockSide.Bottom(), true, true);
        dock.Register("errors", "", DockSide.Bottom(), true, false);
        dock.Register("help", "", DockSide.Bottom(), true, false);
        ZanIDE.ApplyPanelLabels(dock);
        dock.SetWeight("explorer", 40);
        dock.SetWeight("structure", 32);
        dock.SetWeight("stdlib", 28);
        int dockScale = Canvas.GetDpiScale();
        if (dockScale <= 0) { dockScale = 100; }
        dock.SetSideExtent(DockSide.Left(), treeW.Get() * dockScale / 100);
        dock.SetSideExtent(DockSide.Right(), rightW.Get() * dockScale / 100);
        dock.SetSideExtent(DockSide.Bottom(), bottomPanelH.Get() * dockScale / 100);
        dock.LoadLayout(ZanIDE.ReadDockLayout());
        // 接口数据协议与执行契约。
        dockOutlineTitle = "";
        // 接口数据协议与执行契约。
        dockErrorsTitle = "";
    }

    // 接口数据协议与执行契约。
    // duplicated.
    void InitDockPanels(Form form) {
        explorerPanel = new ExplorerPanel();
        explorerPanel.Wire(treeSel, treeFilter);
        explorerTv = explorerPanel.Tree;
        outputPanel = new OutputPanel();
        coFilter = outputPanel.FilterBox();
        coLog = outputPanel.State();
        errorsPanel = new ErrorsPanel();
        errorList = errorsPanel.List;
        gitPanel = new GitPanel();
        gitList = gitPanel.FileList();
        structurePanel = new StructurePanel();
        structurePanel.Wire(structSel, structFilter);
        structTv = structurePanel.TreeCtl();
        stdlibPanel = new StdlibPanel();
        stdlibPanel.Wire(exSel, exFilter);
        stdlibTv = stdlibPanel.TreeCtl();
        toolsPanel = new ToolsPanel();
        toolsPanel.Wire(rtToolSel, rtToolFilter);
        toolsTv = toolsPanel.TreeCtl();
        examplesPanel = new ExamplesPanel();
        examplesPanel.Wire(rtExSel, rtExFilter);
        examplesTv = examplesPanel.TreeCtl();
        // 接口数据协议与执行契约。
        form.On("outputClear", ZanIDE.OutputClearRequested);
        GitPanel.WireHandlers(form);
            // 小赞面板：界面在 panels/AiPanel.html，行为在 ZanIDE.AiPanel.zan。
            aiPanel = new AiPanel();
        AiPanel.WireHandlers(form);
            // 团队条是小赞面板设计里的子控件，它的事件走同一份注册表。
        TeamBoard.WireHandlers(form);
        // 停放面板不挂在窗口树上：外壳每帧把它们直接画进 dock 交出来
        // 的矩形，所以 Control.Adopt 那条「挂上树就拿到宿主窗口」的路
        // 走不到，设计里的 on<Event> 会被 __Dispatch 丢掉（小赞面板的
        // 「配置」按钮点了没反应就是这样）。这里把窗口交给带设计事件
        // 的那几个面板。
        outputPanel.SpreadHostForm(form);
        gitPanel.SpreadHostForm(form);
        aiPanel.SpreadHostForm(form);
        aiPanel.SetModelSelect(aiModelSel);
        // 调试界面（views/DebugPanel.html / DebugToolbar.html /
            // DebugInlineVars.html）：只在调试时可见，但控件树常驻。
            // 这样滚动位置与监视表在两次单步之间不会丢。
            dbgPanel = new DebugPanel();
        dbgToolbar = new DebugToolbar();
        dbgInline = new DebugInlineVars();
    }

    // 接口数据协议与执行契约。
    void InitGitPanel() {
        // 接口数据协议与执行契约。
        gitFiles = new List<string>();
        gitBranch = "";
        gitHead = "";
        gitLoaded = false;
        // 接口数据协议与执行契约。
        // 核心契约与语义定义。
        gitJob = 0;
        gitSel = new SignalInt(0 - 1);
        gitScroll = new SignalInt(0);
        // 接口数据协议与执行契约。
        rtToolTree = ZanIDE.BuildDirTree(ZanIDE.ToolsDir());
        rtExTree = ZanIDE.BuildExampleTree();
        rtToolSel = new SignalInt(-1);
        rtExSel = new SignalInt(-1);
        rtToolFilter = new Input(ZanIDE.T("Filter...", "筛选..."));
        rtExFilter = new Input(ZanIDE.T("Filter...", "筛选..."));
        rtCtxShow = new List<TreeNode>();
        // 接口数据协议与执行契约。
        aiMsgs = new List<ChatMessage>();
        aiPlan = new List<AiPlanStep>();
        aiThinkOpen = new SignalInt(0);
        // 接口数据协议与执行契约。
        aiBusy = new SignalInt(0);
        aiRunModel = "";
        aiRunCtxName = "";
        aiRunCtxCode = "";
        // 接口数据协议与执行契约。
        aiPendingCall = "";
        aiAutoExec = true;
        aiBuildForAi = false;
        aiUiPending = false;
        aiUiRunning = false;
        aiUiScript = "";
        aiUiDeadline = 0;
        aiChatFirstResp = 0;
        aiWaitStart = 0;
        aiStreamMsgIdx = 0 - 1;
        aiStreamLen = 0;
        aiStreamShown = 0;
        aiStreamAt = 0;
        aiStreamSettled = false;
        aiLive = null;
        aiCtxBuckets = new List<AiContextBucket>();
        aiRingSig = "";
    }

    // 接口数据协议与执行契约。
    // 核心契约与执行状态转移规范。
    void InitAiState() {
        // 核心契约与语义定义。
        aiProfiles = new List<AiProfile>();
        aiProfActive = ZanIDE.AiProfilesLoad(aiProfiles);
        aiProfHold = ZanIDE.AiProfilesHold(aiProfiles);
        aiRolePrompts = ZanIDE.AiRolePromptsLoad();
        // 接口数据协议与执行契约。
        // 核心契约与语义定义。
        aiWindow = null;
        aiCfgPending = false;
        // 接口数据协议与执行契约。
        // 核心契约与语义定义。
        aiWin = null;
        aiWinPending = false;
        // 接口数据协议与执行契约。
        aiModelSel = new Dropdown<ModelOption>(o => o.label);
        aiModelSel.Class = "ai-row";
        aiModelSel.Hint(ZanIDE.T("Provider / model", "服务商 / 模型"));
        aiModelOptions = new List<ModelOption>();
        aiModelSelSig = "";
        // 接口数据协议与执行契约。
        aiSessions = new List<AiSession>();
        aiSessCur = 0;
        aiSessions.Add(AiSession.Create("", 0));
        // 接口数据协议与执行契约。
        aiTeamMode = false;
        aiSendTo = "";
        aiRunAgent = "";
        aiHandoffs = 0;
        aiToolSigs = new List<string>();
        aiIdleKey = "";
        aiIdleTimes = 0;
        aiEscKey = "";
        aiRevKey = "";
        aiRevTimes = 0;
        aiWrapKey = "";
        aiTeamSt = AiTeamState.Create();
        aiTasks = new List<AiTask>();
        aiTeamOpen = new SignalInt(0);
        // 接口数据协议与执行契约。
        aiGraphSel = "";
        aiGraphRoot = "";
        aiGraphSig = "";
        aiCtxSaved = 0;
        // 接口数据协议与执行契约。
        // 核心契约与语义定义。
        LoadAiSessions();
        aiLastSave = 0;
        aiSaveSig = "";
        aiCodeSig = "";
        aiCodeVal = "";
        aiSessNav = new SessionList(
            ZanIDE.T("Search chats...", "搜索会话..."),
            ZanIDE.T("New chat", "新会话"))
            .EmptyText(ZanIDE.T("No chats", "暂无会话"))
            .Labels(
                ZanIDE.T("Archive / restore this chat (kept, just hidden)",
                    "归档 / 恢复此会话（保留内容，仅从列表折叠）"),
                ZanIDE.T("Delete this chat and its whole context",
                    "删除此会话及其全部上下文"),
                ZanIDE.T("Archived", "已归档"))
            .RenameLabel(ZanIDE.T("Rename this chat (Enter keeps, Esc cancels)",
                "重命名此会话（回车保存，Esc 取消）"));
        // 接口数据协议与执行契约。
        aiCacheLines = new List<TextRun>();
        aiToolOpen = new List<int>();
        aiCacheKey = "";
        aiCacheSig = "";
        aiChatSel = new LogState();
        aiTokPrompt = 0;
        aiTokCompletion = 0;
        aiTokTotal = 0;
        aiTokCached = 0;
        aiRetry = 0;
        aiAutoCont = 0;
        aiContMax = AiAgent.ContinuesBudget(ZanIDE.AiAutoContLoad());
        aiHandoffMax = AiTeam.HandoffsBudget(ZanIDE.AiAutoContLoad());
    }

    // 接口数据协议与执行契约。
    // 核心契约与语义定义。
    void InitRunState(string cfg) {
        // 接口数据协议与执行契约。
        termFp = 0;
        termLogLen = 0;
        // 接口数据协议与执行契约。
        runLogLen = 0;
        runStreaming = false;
        // 接口数据协议与执行契约。
        buildBusy = false;
        buildStartMs = 0;
        buildLogLen = 0;
        buildExe = "";
        buildIsGui = false;
        buildThenRun = false;
        // 接口数据协议与执行契约。
        dbgBuildPending = false;
        buildTargetPath = "";
        // 接口数据协议与执行契约。
        autoRun = ZanIDE.CfgInt(cfg, "autoRun", 0) == 1;
        // 接口数据协议与执行契约。
        hotReloadReq = false;
        treeSel = new SignalInt(-1);
    }

    // 接口数据协议与执行契约。
    // 核心契约与执行状态转移规范。
    void InitSidebarState() {
        // 接口数据协议与执行契约。

        // (browse/open stdlib sources directly, like aardio's 库 pane).
        exTree = ZanIDE.BuildStdlibTree();
        exSel = new SignalInt(-1);

        // 接口数据协议与执行契约。
        treeFilter = new Input(ZanIDE.T("Filter...", "筛选..."));
        structFilter = new Input(ZanIDE.T("Filter...", "筛选..."));
        exFilter = new Input(ZanIDE.T("Filter...", "筛选..."));
        treeShow = new List<TreeNode>();
        structShow = new List<TreeNode>();
        exShow = new List<TreeNode>();

        // 接口数据协议与执行契约。
        structTree = new List<TreeNode>();
        structSel = new SignalInt(-1);
        structSig = "@none";
        structPendingStamp = 0 - 1;
        structChangeMs = 0;
    }

    // 接口数据协议与执行契约。
    // 核心契约与语义定义。
    WizardHost OpenWizardHost(App parent, string title, int w, int h, int mode) {
        WizardHost host = new WizardHost(title, w, h);
        // 接口数据协议与执行契约。
        // 核心契约与语义定义。
        host.OnClose(() => {
            dlg = null;
            dlgMode = 0;
            if (pathPickerOwner == 1) {
                pathPicker.Close();
                pathPickerOwner = 0;
            }
            app.RequestRedraw();
        });
        // 接口数据协议与执行契约。
        host.SetRender(() => {
            App hApp = host.Host();
            if (pathPicker.IsOpen()) { return; }
            hApp.BeginFrame();
            // 接口数据协议与执行契约。
            int savedSeq = WidgetId.SeqValue();
            WidgetId.SetSeq(850000);
            int action = 0;
            Wizard wiz;
            if (dlgMode == 1) {
                // 接口数据协议与执行契约。
                int psel = pSel.Get();
                if (psel != pSizeSeededFor) {
                    pSizeSeededFor = psel;
                    pSizeSel.Set(-1);
                    pDevRot.Set(0);
                    string sw = "";
                    string sh = "";
                    string devid = "";
                    if (psel >= 0 && psel < tpls.Count) {
                        devid = tpls[psel].device;
                        if (tpls[psel].sizeable && tpls[psel].defW > 0
                                && tpls[psel].defH > 0) {
                            sw = Convert.ToString(tpls[psel].defW);
                            sh = Convert.ToString(tpls[psel].defH);
                        }
                    }
                    DeviceProfile dp = DeviceProfile.ById(devid);
                    if (dp != null && dp.Locked()) {
                        pDevSel.Set(DeviceProfile.IndexOfId(devid));
                        pSizeWIn.SetText(Convert.ToString(dp.CanvasW(0)));
                        pSizeHIn.SetText(Convert.ToString(dp.CanvasH(0)));
                    } else {
                        pDevSel.Set(0);
                        pSizeWIn.SetText(sw);
                        pSizeHIn.SetText(sh);
                    }
                }
                wiz = Wizard.Categorized(ZanIDE.T("New Project", "新建项目"), catNames, catSel,
                                         wizTpls, pSel,
                                         pNameInput, pLocInput,
                                         platforms, platformGroups,
                                         pSizeSel, pSizeWIn, pSizeHIn,
                                         pDevSel, pDevRot);
            } else if (dlgMode == 3) {
                wiz = new Wizard(ZanIDE.T("Save as Template", "另存为模板"), saveItems,
                                    tmplCatSel, tmplNameInput, tmplNameInput, false, null);
            } else {
                // 接口数据协议与执行契约。
                // 核心契约与语义定义。
                SignalInt szSel = null;
                int fk = fSel.Get();
                if (fk >= 7 && fk <= 9) { szSel = fSizeSel; }
                wiz = new Wizard(ZanIDE.T("New File", "新建文件"), fileItems, fSel,
                                    fNameInput, fNameInput, false, szSel,
                                    fSizeWIn, fSizeHIn);
            }
            action = wiz.Show(hApp);
            WidgetId.SetSeq(savedSeq);
            hApp.PresentFrame();

            if (action == 1) {
                bool dlgDone = true;
                if (dlgMode == 1) {
                    string parentDir = pLocInput.GetText();
                    string name = pNameInput.GetText();
                    int gi = pSel.Get();
                    if (gi >= 0 && gi < tpls.Count && tpls[gi].ptype == "gui" && ZanIDE.IsGuiReservedName(name)) {
                        Wizard.notice = ZanIDE.T(
                            "That name conflicts with a built-in Gui/System type. Choose another.",
                            "该名称与内置的 Gui/System 类型冲突，请换一个名称。");
                        dlgDone = false;
                    } else if (!ZanIDE.IsValidProjectName(name)) {
                        Wizard.notice = ZanIDE.T(
                            "The name contains invalid characters or is reserved. Use letters, digits, '_' or '-'.",
                            "名称包含非法字符或是保留名，请使用字母、数字、下划线或连字符。");
                        dlgDone = false;
                    } else if (ZanIDE.DirHasEntries(parentDir + "/" + name)) {
                        // 项目脚手架从不写进别人的目录：目标必须不存在或为空。
                        Wizard.notice = ZanIDE.T(
                            "That folder already exists and is not empty. Choose another name or location.",
                            "目标文件夹已存在且不是空的，请换个名称或位置。");
                        dlgDone = false;
                    } else if (gi >= 0 && gi < tpls.Count) {
                        string plats = ZanIDE.PlatformCsv(platforms);
                        // 选中的锁定类设备画像随尺寸一并写进 .html，
                        // 设计器据此持续锁定画布；桌面自由尺寸不写。
                        string devId = "";
                        DeviceProfile dp = DeviceProfile.At(pDevSel.Get());
                        if (dp != null && dp.Locked()) { devId = dp.Id(); }
                        ZanIDE.WriteLastPickerDirectory(parentDir);
                        string newDir = ZanIDE.CreateProjectT(tpls[gi], parentDir, name, plats,
                            ZanIDE.ParseIntSafe(pSizeWIn.GetText()),
                            ZanIDE.ParseIntSafe(pSizeHIn.GetText()), devId, log);
                        if (newDir == "") {
                            // 核心契约与语义定义。
                            // 接口数据协议与执行契约。
                            Wizard.notice = ZanIDE.T(
                                "Project creation failed. See the Output tab for details.",
                                "创建项目失败，详情见输出面板。");
                            dlgDone = false;
                        } else {
                            Layer.Notify(ZanIDE.T("Project created: ", "项目已创建：") + name, 3);
                            // 接口数据协议与执行契约。
                            // 核心契约与语义定义。
                            this.OpenProjectAsync(newDir);
                        }
                    }
                } else if (dlgMode == 3) {
                    string cat = saveItems[tmplCatSel.Get()].name;
                    string tname = tmplNameInput.GetText();
                    ZanIDE.SaveAsTemplate(root, cat, tname, log);
                    Layer.Notify(ZanIDE.T("Template saved: ", "模板已保存：") + tname, 3);
                } else {
                    string name = fNameInput.GetText();
                    if (ZanIDE.FileKindDeclaresType(fSel.Get())
                            && ZanIDE.IsGuiReservedName(name)) {
                        Wizard.notice = ZanIDE.T(
                            "That name conflicts with a built-in Gui/System type. Choose another.",
                            "该名称与内置的 Gui/System 类型冲突，请换一个名称。");
                        dlgDone = false;
                    } else if (ZanIDE.NewFileTaken(fSel.Get(), root, name) != "") {
                        // 新建从不覆盖已有文件：让用户换个名字。
                        Wizard.notice = ZanIDE.T(
                            "A file with that name already exists. Choose another name.",
                            "同名文件已存在，请换一个名称。");
                        dlgDone = false;
                    } else {
                        string p = ZanIDE.CreateFile(fSel.Get(), root, name, fSizeSel.Get(),
                            ZanIDE.ParseIntSafe(fSizeWIn.GetText()),
                            ZanIDE.ParseIntSafe(fSizeHIn.GetText()), log);
                        if (p == "") {
                            Wizard.notice = ZanIDE.T(
                                "File creation failed. See the Output tab for details.",
                                "新建文件失败，详情见输出面板。");
                            dlgDone = false;
                        } else {
                            if (!Directory.Exists(p)) {
                                ZanIDE.OpenPath(tabs, activeTab, p, Path.GetFileName(p));
                            }
                            Layer.Notify(ZanIDE.T("Created: ", "已创建：")
                                + Path.GetFileName(p), 3);
                        }
                    }
                }
                if (dlgDone) {
                    rescan = true;
                    Wizard.notice = "";
                    host.Close();
                    dlg = null;
                    dlgMode = 0;
                } else {
                    host.RequestRedraw();
                }
                app.RequestRedraw();
            } else if (action == 2) {
                Wizard.notice = "";
                host.Close();
                dlg = null;
                dlgMode = 0;
                app.RequestRedraw();
            } else if (action == 3) {
                if (dlgMode == 1 && !pathPicker.IsOpen()) {
                    pathPicker.BeginFolder(ZanIDE.ReadLastPickerDirectory(pLocInput.GetText()),
                        ZanIDE.T("Select project location", "选择项目位置"));
                    pathPickerOwner = 1;
                    host.RequestRedraw();
                }
            }
        });
        dlg = host;
        dlgMode = mode;
        if (mode == 2) {
            fSel.Set(0);
            fNameInput.SetText("NewFile");
        }
        host.Open(parent);
        return host;
    }
}
