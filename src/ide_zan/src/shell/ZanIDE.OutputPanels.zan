using System;
using System.IO;
using System.Diagnostics;
using System.Json;
using System.Text;
using System.Collections.Generic;
using Gui;
using Gui.Widget;
using Gui.Designer;
using Gui.Component;
using Game.Scene;
using Gui.Backend;

partial class ZanIDE {
    // 上一次构建的编译诊断（后台线程解析，解析结果缓存在 errCache）。
    List<DiagnosticRecord> BuildLogErrors() {
        if (errCache == null) { errCache = new List<DiagnosticRecord>(); }
        return errCache;
    }

    // 错误列表的内容：IDE 侧诊断（语言服务实时诊断、设计期错误）
    // + 上一次构建的诊断，重复的按 (文件, 行, 消息) 去掉。
    List<DiagnosticRecord> BuildErrors() {
        return this.MergedErrors(this.BuildLogErrors());
    }

    void ClearOutputContextMenuState() {
        coCtxOpen = false;
        coCtxMenu = null;
        coCtxView = null;
        coCtxErrors = null;
        coCtxHaveSel = false;
        coCtxBotTab = 0;
    }

    void OpenOutputContextMenu(App app) {
        if (!coCtxOpen || coCtxMenu != null) { return; }
        List<string> labels = new List<string>();
        if (coCtxHaveSel) { labels.Add(ZanIDE.T("Copy selection", "复制选中")); }
        labels.Add(ZanIDE.T("Copy line", "复制该行"));
        labels.Add(ZanIDE.T("Copy all", "复制全部"));
        labels.Add(ZanIDE.T("Clear", "清空"));
        ContextMenu menu = this.CreateContextMenu(app, 100, labels);
        coCtxMenu = menu;
        menu.ShowAt(app, coCtxX, coCtxY);
    }

    void ApplyOutputContextMenu(App app, int chosen) {
        bool haveSel = coCtxHaveSel;
        int botTab = coCtxBotTab;
        List<string> view = coCtxView;
        List<DiagnosticRecord> errors = coCtxErrors;
        int base2 = haveSel ? 1 : 0;
        string clip = "";
        if (haveSel && chosen == 0 && view != null) {
            clip = LogView.SelectionText(view, coLog);
        } else if (chosen == base2) {
            if (botTab == 0) {
                if (view != null && coCtxRow >= 0 && coCtxRow < view.Count) {
                    clip = view[coCtxRow];
                }
            } else if (errors != null && coCtxRow >= 0 && coCtxRow < errors.Count) {
                DiagnosticRecord error = errors[coCtxRow];
                clip = ZanIDE.BaseName(error.path) + ":"
                + error.line + "  " + error.msg;
            }
        } else if (chosen == base2 + 1) {
            if (botTab == 0) {
                if (view != null) {
                    for (int i = 0; i < view.Count; i = i + 1) { clip = clip + view[i] + "\n"; }
                }
            } else if (errors != null) {
                for (int i = 0; i < errors.Count; i = i + 1) {
                    DiagnosticRecord error = errors[i];
                    clip = clip + ZanIDE.BaseName(error.path) + ":" + error.line
                    + "  " + error.msg + "\n";
                }
            }
        } else {
            log = new List<string>();
            coFilter.SetText("");
            coLog.Reset();
        }
        if (clip.Length > 0) {
            Clipboard.SetText(clip);
            Layer.Msg(ZanIDE.T("Copied to clipboard", "已复制到剪贴板"), 3);
        }
        this.ClearOutputContextMenuState();
        app.RequestRedraw();
    }

    void RenderOutputPanels(App app, Rect orr) {
        Theme t = app.theme;
        // 「帮助与反馈」：本地聚合的错误 + 复制/导出。它和错误面板并列
        // 在底部，但收的是全部来源（含界面层异常与程序崩溃），不只是
        // 这一次编译的诊断。
        Rect errRect = dock.ContentParked("errors");
        List<DiagnosticRecord> errors = this.BuildErrors();
        string errTitle = ZanIDE.T("Errors", "错误");
        if (errors.Count > 0) {
            errTitle = errTitle + " (" + Convert.ToString(errors.Count) + ")";
        }
        if (errTitle != dockErrorsTitle) {
            dock.SetTitle("errors", errTitle);
            dockErrorsTitle = errTitle;
        }
        errorsPanel.Render(app, errRect, errors);
        if (!coCtxOpen) {
            DiagnosticRecord efr = errorsPanel.TakeFix();
            if (efr != null) {
                ZanIDE.AddUsing(editor, tabs, activeTab,
                errorsPanel.FixNs(efr), log);
                app.RequestRedraw();
            }
            DiagnosticRecord ejr = errorsPanel.TakeJump();
            if (ejr != null) {
                int curAct = activeTab.Get();
                if (curAct >= 0 && curAct < tabs.Count && editor != null) {
                    this.PushNavLocation(tabs[curAct].path, editor.CurLine(), editor.CurCol());
                }
                int ejl = ZanIDE.ParseInt(ejr.line);
                // 双击一条诊断要能落到出错那一行，哪怕它所在的文件
                // 还没打开：先按诊断里的路径开出标签页，只有路径压
                // 根定位不到（无位置的诊断、被截断的路径）才退回到
                // 按文件名找已打开的标签页。
                string ejp = ZanIDE.ResolveDiagPath(root, ejr.path);
                int ejt = 0 - 1;
                if (ejp != "") {
                    ZanIDE.OpenPath(tabs, activeTab, ejp,
                    Path.GetFileName(ejp));
                    ejt = activeTab.Get();
                } else {
                    ejt = ZanIDE.FindTabByBase(
                    tabs, ZanIDE.BaseName(ejr.path));
                    if (ejt >= 0) { activeTab.Set(ejt); }
                }
                if (ejt >= 0 && ejl > 0) {
                    lastActive = 0 - 1;
                    pendingGotoLine = ejl - 1;
                    pendingGotoCol = 0;
                }
                app.RequestRedraw();
            }
        }
        app.PerfMark("sh.errors");

        if (dbgState == 2) {
            dbgPanel.Render(app, orr, dbgPanelTab,
            dbgConsole, dbgVarInfo, dbgWatches, dbgStack);
            string wAdd = DebugPanel.TakeWatchAdd();
            int wDrop = DebugPanel.TakeWatchDrop();
            if (wAdd.Length > 0) {
                string v = "";
                if (dbg != null) { v = dbg.Evaluate(wAdd); }
                dbgWatches.Add(new DbgVar(wAdd, "", v));
                app.RequestRedraw();
            }
            if (wDrop >= 0 && wDrop < dbgWatches.Count) {
                dbgWatches.RemoveAt(wDrop);
                app.RequestRedraw();
            }
        } else {
            int botTab = 0;
            if (errRect.Contains(app.mouseX, app.mouseY)) { botTab = 1; }
            int obTabH = t.heightMedium;
            int coContentY = orr.y + obTabH;
            int coContentH = orr.height - obTabH;
            outputPanel.Render(app, orr, log);
            List<string> coView = outputPanel.Shown();
            Rect botRect = orr;
            if (botTab == 1) { botRect = errRect; }
            if (app.EventKind() == 2 && app.window.EventButton() == 1
            && botRect.Contains(app.mouseX, app.mouseY)) {
                coCtxOpen = true;
                coCtxX = app.mouseX;
                coCtxY = app.mouseY;
                coCtxBotTab = botTab;
                coCtxHaveSel = botTab == 0 && coLog.HasSelection();
                coCtxView = coView;
                coCtxErrors = errors;
                if (botTab == 0) {
                    coCtxRow = LogView.RowAt(app, coContentY, coContentH,
                    coView.Count, coLog.scroll, app.mouseY);
                } else {
                    coCtxRow = (app.mouseY - (errRect.y + app.theme.paddingTiny)) / app.Scale(20);
                }
                app.RequestRedraw();
            }
            this.OpenOutputContextMenu(app);
            if (app.EventKind() == 4 && app.window.EventKeyCode() == 67
            && Modifiers.HasCtrl(app.window.EventMods())
            && coLog.HasSelection()
            && orr.Contains(app.mouseX, app.mouseY)) {
                Clipboard.SetText(LogView.SelectionText(coView, coLog));
                Layer.Msg(ZanIDE.T("Copied to clipboard", "已复制到剪贴板"), 3);
                app.RequestRedraw();
            }
        }
        app.PerfMark("sh.output");

        // 终端面板：交互式 shell（会话 lazily 打开），命令经
        // Input.Submit 送出，输出由后台 job 轮询会话日志回流。
        Rect termRect = dock.ContentParked("terminal");
        if (termRect.width > 0 && termRect.height > 0) {
            terminalPanel.RenderTree(app);
            if (termFp != 0) {
                if (terminalPanel.TakeSubmitted()) {
                    string cmdline = terminalPanel.CmdBox().GetText().Trim();
                    if (cmdline.Length > 0) {
                        terminalPanel.ClearCmd();
                        this.TermRun(cmdline);
                    }
                    app.RequestRedraw();
                }
            }
        }
        app.PerfMark("sh.terminal");
        gitPanel.Render(app, dock.ContentParked("git"));
        toolsPanel.Render(app, dock.ContentParked("tools"), rtToolTree);
        examplesPanel.Render(app, dock.ContentParked("examples"), rtExTree);
        // ---- Agent 面板：小赞的会话流。同一块控件树只能有一个宿主
        // ——小赞住在独立窗口里时这里不画（见 AiAssistantWindow）。
        if (!this.AiInWindow()) {
            this.RenderAiPanel(app, dock.ContentParked("agent"));
        }
    }
}
