using System;
using Gui;
using Gui.Widget;

partial class ZanIDE {
    Tabs designTabs;
    Label designTabLabel;
    Label codeTabLabel;

    bool DesignTabsApplicable() {
        int act = activeTab.Get();
        if (act < 0 || act >= tabs.Count) { return false; }
        string path = tabs[act].path;
        return tabs[act].designDoc || ZanIDE.IsFormPath(path) || ZanIDE.IsScenePath(path);
    }

    void InitializeDesignTabs(Control root) {
        designTabs = new Tabs(Tabs.Line());
        designTabs.SetProp("style", "height:26px;");
        designTabLabel = new Label(ZanIDE.T("Design", "设计"));
        designTabLabel.name = "ide-design-tab";
        codeTabLabel = new Label(ZanIDE.T("Code", "代码"));
        codeTabLabel.name = "ide-code-tab";
        designTabs.Add(new TabItem("", false).Header(designTabLabel));
        designTabs.Add(new TabItem("", false).Header(codeTabLabel));
        IdeEditorTabEvents relay = new IdeEditorTabEvents(); relay.owner = this;
        designTabs.TabChanged.Add(relay.DesignChanged);
        root.Add(designTabs);
    }

    void OnDesignTabChanged(Control sender) {
        if (sender != designTabs || shuttingDown || closeRequested || !this.DesignTabsApplicable()) { return; }
        int act = activeTab.Get();
        bool code = designTabs.Active() == 1;
        if (code == (codeViewForm == tabs[act].path)) { return; }
        codeViewForm = code ? tabs[act].path : "";
        if (code) { formCodeLoaded = ""; }
        lastActive = 0 - 1;
        app.RequestRedraw();
    }

    void PrepareDesignTabs(App host, Rect bounds) {
        bool shown = this.DesignTabsApplicable();
        designTabs.SetShown(shown);
        if (!shown) { return; }
        designTabLabel.Text = ZanIDE.T("Design", "设计");
        codeTabLabel.Text = ZanIDE.T("Code", "代码");
        int act = activeTab.Get();
        designTabs.Select(codeViewForm == tabs[act].path ? 1 : 0);
        designTabs.UseApp(host);
        designTabs.MeasureTree(host, bounds.width);
        if (designTabLabel.parent != null) { designTabLabel.parent.name = "ide-design-tab"; }
        if (codeTabLabel.parent != null) { codeTabLabel.parent.name = "ide-code-tab"; }
        designTabs.Arrange(bounds.x, bounds.y, bounds.width, host.Scale(26));
    }

    int RenderDesignTabs(App host, int x, int y) {
        if (designTabs == null || !designTabs.StyleVisible()) { return 0; }
        designTabs.RenderTree(host);
        return designTabs.bh;
    }
}
