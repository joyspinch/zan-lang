using System;
using Gui;

// 设计 | 代码 标签条（WinForms 窗体设计器同款）：窗体/场景设计稿
// 作为活动文档时，编辑区左上角挂两个小标签，点一下就切视图。此前的
// 切换只有 F7 一条隐藏手势（ZanIDE.Hotkeys 的 codeViewForm 分支），
// 标签条把这条路摆到台面上——用户不必猜快捷键。
//
// 标签条独占一行，内容整体下移一行（不覆盖设计器画面）。
partial class ZanIDE {
    // 标签条的两个命中 id（设计 / 代码），在 345000 段内分配。
    int designTabBase;

    // 当前活动文档是否值得挂这条标签条（窗体/场景设计稿）。
    bool DesignTabsApplicable() {
        int act = activeTab.Get();
        if (act < 0 || act >= tabs.Count) { return false; }
        string p = tabs[act].path;
        if (tabs[act].designDoc) { return true; }
        return ZanIDE.IsFormPath(p) || ZanIDE.IsScenePath(p);
    }

    // 画标签条，返回它占用的高度（不适用时 0）。
    int RenderDesignTabs(App app, int x, int y) {
        if (!this.DesignTabsApplicable()) { return 0; }
        Theme t = app.theme;
        int h = app.Scale(26);
        int act = activeTab.Get();
        string path = tabs[act].path;
        bool code = codeViewForm == path;
        // 主题里的字号已经是设备像素（ApplyMetricsScaled 乘过缩放），
        // 别再乘一次。
        int fs = t.fontSizeSmall;
        int padX = app.Scale(12);
        int minW = app.Scale(52);
        string designLbl = ZanIDE.T("Design", "设计");
        string codeLbl = ZanIDE.T("Code", "代码");
        int designW = Canvas.MeasureText(designLbl, fs) + padX * 2;
        int codeW = Canvas.MeasureText(codeLbl, fs) + padX * 2;
        if (designW < minW) { designW = minW; }
        if (codeW < minW) { codeW = minW; }

        this.designTabBase = WidgetId.Block(2);
        int designId = this.designTabBase;
        int codeId = this.designTabBase + 1;

        // 条底：编辑区同色的一条窄带 + 下边线，把标签条与内容分开。
        app.canvas.FillRect(x, y, designW + codeW, h, t.bgPrimary);
        app.canvas.FillRect(x, y + h - app.Scale(1),
                            designW + codeW, app.Scale(1), t.borderSecondary);

        this.DrawDesignTab(app, x, y, designW, h, fs, designLbl, !code, designId,
                            "ide-design-tab");
        this.DrawDesignTab(app, x + designW, y, codeW, h, fs, codeLbl, code, codeId,
                            "ide-code-tab");

        // 点击：切视图。已经在当前视图上则不动（点了不闪）。
        if (Ui.Clicked(app, designId) && code) {
            codeViewForm = "";
            lastActive = 0 - 1;
            app.ClaimClick();
            app.RequestRedraw();
        } else if (Ui.Clicked(app, codeId) && !code) {
            codeViewForm = path;
            formCodeLoaded = "";
            lastActive = 0 - 1;
            app.ClaimClick();
            app.RequestRedraw();
        }
        return h;
    }

    // 单个标签：活动标签用主色文字 + 底部主色短线，未活动的用弱文字。
    void DrawDesignTab(App app, int x, int y, int w, int h, int fs,
                        string label, bool active, int id, string hitLabel) {
        Theme t = app.theme;
        int fg = active ? t.primary : t.textTertiary;
        int ty = y + (h - Canvas.FontHeight(fs)) / 2;
        app.canvas.DrawText(x + app.Scale(12), ty, label, fg, fs);
        if (active) {
            app.canvas.FillRect(x + app.Scale(8), y + h - app.Scale(2),
                                w - app.Scale(16), app.Scale(2), t.primary);
        }
        // 带语义标签注册：自动化脚本 clickid @ide-design-tab 能按名点中，
        // 不受布局漂移影响（id 随帧变化，标签稳定）。
        app.hitTester.RegisterRectL(id, x, y, w, h, 0, hitLabel);
    }
}
