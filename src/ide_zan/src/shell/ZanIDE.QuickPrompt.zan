using System;
using System.IO;
using System.Json;
using Platform;
using Gui;
using Gui.Widget;

// 代码视图右上角那个小输入条要做的事：跳转到行（Ctrl+G）、断点条件
// （Ctrl+B）、重命名符号（F2）、在文件中查找 / 替换（Ctrl+Shift+F / R）。
// // 输入条本身是 views/QuickPrompt.html 那个控件，编辑、选择、剪贴板和
// 输入法都归它；这里只负责：换用途时把种子文本铺进去，回车之后按当前
// 用途执行一次，然后关掉。
partial class ZanIDE {
    // 上一帧输入条在做哪件事，用来判断要不要重新铺种子文本（否则每帧
    // 都会把用户正在输入的内容冲掉）。
    int promptMode;

    // `off` 为真表示当前标签页不是代码（设计器 / 起始页 / 帮助），这时
    // 这些命令没有落点，直接收起来。
    void RunQuickPrompt(App app, Rect edRect, bool off) {
        if (findMode <= 2 || off) {
            if (quickPrompt.IsOpen()) { quickPrompt.Close(); }
            promptMode = 0;
            return;
        }
        if (findMode != promptMode) {
            this.SeedQuickPrompt(app);
            promptMode = findMode;
        } else if (findMode == 4) {
            // 断点条件的标题里带着行号，光标换行时要跟着走。
            quickPrompt.Caption(ZanIDE.T("Breakpoint Condition (Ctrl+B) - line ",
                "断点条件 (Ctrl+B) - 行 ")
                + Convert.ToString(editor.CurLine() + 1));
        }
        quickPrompt.Anchor(edRect.x, edRect.y, edRect.width);
        if (quickPrompt.TakeSubmit()) { this.ApplyQuickPrompt(app); }
        if (!quickPrompt.IsOpen()) {
            // 控件自己被 Esc 关掉了。
            findMode = 0;
            promptMode = 0;
            app.RequestRedraw();
        }
        quickPrompt.Frame(app);
    }

    // 按当前用途铺标题、种子文本和按钮文案。
    void SeedQuickPrompt(App app) {
        if (findMode == 3) {
            quickPrompt.Show(ZanIDE.T("Go to Line (Ctrl+G)", "跳转到行 (Ctrl+G)"),
                "", null, ZanIDE.T("Go", "转到"));
        } else if (findMode == 4) {
            quickPrompt.Show(ZanIDE.T("Breakpoint Condition (Ctrl+B) - line ",
                    "断点条件 (Ctrl+B) - 行 ")
                    + Convert.ToString(editor.CurLine() + 1),
                ZanIDE.CondFor(bpConds, editor.CurLine()), null,
                ZanIDE.T("Set", "设置"));
        } else if (findMode == 5) {
            quickPrompt.Show(ZanIDE.T("Rename Symbol (F2): ", "重命名符号 (F2): ")
                + renameWord, renameWord, null, ZanIDE.T("Rename", "重命名"));
        } else if (findMode == 6) {
            quickPrompt.Show(ZanIDE.T("Find in Files (Ctrl+Shift+F)",
                "在文件中查找 (Ctrl+Shift+F)"), fifQuery, null,
                ZanIDE.T("Find", "查找"));
        } else if (findMode == 7) {
            quickPrompt.Show(ZanIDE.T("Replace in Files (Ctrl+Shift+R)",
                "在文件中替换 (Ctrl+Shift+R)"), fifQuery, fifRepl,
                ZanIDE.T("Replace", "替换"));
        } else if (findMode == 8) {
            quickPrompt.Show(ZanIDE.T("Open File by Name (Ctrl+P)",
                "快速打开文件 (Ctrl+P)"), "", null,
                ZanIDE.T("Open", "打开"));
        } else if (findMode == 9) {
            quickPrompt.Show(ZanIDE.T("Go to Symbol (Ctrl+T)",
                "转到符号 (Ctrl+T)"), "", null,
                ZanIDE.T("Search", "搜索"));
        }
    }

    // 回车 / 点按钮之后执行一次。
    void ApplyQuickPrompt(App app) {
        string text = quickPrompt.FirstText();
        if (findMode == 3) {
            int line = ZanIDE.ParseInt(text);
            if (line > 0) { editor.GoToLine(line - 1); }
        } else if (findMode == 4) {
            int bLine = editor.CurLine();
            ZanIDE.SetCond(bpConds, bLine, text);
            // 加了条件却没有断点的话，条件永远不会被问到，所以顺手打上。
            if (text.Length > 0 && !editor.HasBreakpoint(bLine)) {
                editor.ToggleBreakpoint(bLine);
            }
            if (text.Length > 0) {
                log.Add("> [Debug] Breakpoint condition on line "
                    + Convert.ToString(bLine + 1) + ": " + text);
            } else {
                log.Add("> [Debug] Breakpoint condition cleared on line "
                    + Convert.ToString(bLine + 1) + ".");
            }
        } else if (findMode == 5) {
            string oldName = renameWord;
            app.Post(delegate () { this.RenameSymbolAsync(oldName, text); });
        } else if (findMode == 6) {
            fifQuery = text;
            if (fifQuery.Length > 0) {
                app.Post(delegate () { this.FindInFilesAsync(text); });
            }
        } else if (findMode == 7) {
            fifQuery = text;
            fifRepl = quickPrompt.SecondText();
            if (fifQuery.Length > 0) {
                string replacement = fifRepl;
                app.Post(delegate () { this.ReplaceInFilesAsync(text, replacement); });
            }
        } else if (findMode == 8) {
            string query = text != null ? text.Trim() : "";
            if (query.Length > 0) {
                this.QuickOpenFile(query);
            }
        } else if (findMode == 9) {
            string symbolQuery = text != null ? text.Trim() : "";
            if (symbolQuery.Length > 0) {
                this.SearchSymbolsAsync(symbolQuery);
            }
        }
        quickPrompt.Close();
        findMode = 0;
        promptMode = 0;
        app.RequestRedraw();
    }

    void QuickOpenFile(string query) {
        if (query == null || query.Length == 0) { return; }
        int colon = query.IndexOf(":");
        int targetLine = -1;
        string fileQuery = query;
        if (colon >= 0) {
            fileQuery = query.Substring(0, colon).Trim();
            string lineStr = query.Substring(colon + 1, query.Length - (colon + 1)).Trim();
            targetLine = ZanIDE.ParseInt(lineStr);
        }
        string fileLower = fileQuery.ToLower();
        for (int i = 0; i < tabs.Count; i = i + 1) {
            string tabName = tabs[i].name != null ? tabs[i].name.ToLower() : "";
            string tabPath = tabs[i].path != null ? tabs[i].path.ToLower() : "";
            if (tabName == fileLower || tabName.StartsWith(fileLower) || tabPath.EndsWith("/" + fileLower) || tabPath.EndsWith("\\" + fileLower)) {
                activeTab.Set(i);
                lastActive = -1;
                this.UpdateActiveCodeTab();
                if (targetLine > 0 && editor != null) {
                    editor.GoToLine(targetLine - 1);
                }
                Layer.Msg(ZanIDE.T("Switched to ", "切换到 ") + tabs[i].name, 2);
                app.RequestRedraw();
                return;
            }
        }
        List<string> candidates = ZanIDE.NavSearchFiles(root);
        string matchedPath = "";
        for (int c = 0; c < candidates.Count; c = c + 1) {
            string cand = candidates[c];
            string candName = Path.GetFileName(cand).ToLower();
            if (candName == fileLower || candName == fileLower + ".zan" || candName == fileLower + ".html") {
                matchedPath = cand;
                break;
            }
        }
        if (matchedPath.Length == 0) {
            for (int c = 0; c < candidates.Count; c = c + 1) {
                string cand = candidates[c];
                string candName = Path.GetFileName(cand).ToLower();
                string normCand = cand.Replace("\\", "/").ToLower();
                if (candName.Contains(fileLower) || normCand.Contains("/" + fileLower)) {
                    matchedPath = cand;
                    break;
                }
            }
        }
        if (matchedPath.Length > 0 && File.Exists(matchedPath)) {
            ZanIDE.OpenPath(tabs, activeTab, matchedPath, Path.GetFileName(matchedPath));
            lastActive = -1;
            this.UpdateActiveCodeTab();
            if (targetLine > 0 && editor != null) {
                editor.GoToLine(targetLine - 1);
            }
            Layer.Msg(ZanIDE.T("Opened ", "已打开 ") + Path.GetFileName(matchedPath), 2);
        } else {
            Layer.Msg(ZanIDE.T("File not found: ", "未找到文件: ") + fileQuery, 2);
        }
        app.RequestRedraw();
    }

    // 全项目搜索读的是标签页里的文本，所以先把编辑器里未落盘的改动写回去。
    void SyncActiveTabBody() {
        int at = activeTab.Get();
        if (at >= 0 && at < tabs.Count) { tabs[at].body = editor.GetText(); }
    }
}
