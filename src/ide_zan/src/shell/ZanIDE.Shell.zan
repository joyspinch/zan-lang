using System;
using System.IO;
using System.Diagnostics;
using System.Json;
using Gui;
using Gui.Widget;
using Gui.Designer;
using Game.Scene;

/// ZanIDE part: applying what the secondary windows reported.
///
/// Each method reads the actions a child window class took (Publish /
/// Project Configuration / Marketplace / Settings / the file picker) and
/// translates them into shell state. The frames themselves are rendered by
/// ChildWindows.PumpAll inside `Form.Run()`; nothing here draws.
partial class ZanIDE {

    /// Applies what the publish child window reported. "Publish" only closes
    /// it and arms `pubPending`, so the blocking cross-compile never runs
    /// behind a frozen window.
    void PumpPublishWindow() {
        // ---------------- publish child window ----------------
        if (pubWin != null) {
            if (pubWin.TakePublish()) {
                pubWin.Close();
                pubWin = null;
                pubRoot = root;
                pubPacked = ZanIDE.ProjSingleFile(root)
                    && !ZanIDE.IsLibraryProject(root);
                pubPending = true;
                app.RequestRedraw();
            } else if (pubWin.TakeCancel()) {
                pubWin.Close();
                pubWin = null;
                app.RequestRedraw();
            } else if (!pubWin.IsOpen()) {
                // Closed through the OS caption / ESC: just drop it.
                pubWin = null;
                app.RequestRedraw();
            }
        }
    }

    /// Pumps the Project child window: the icon picker of its configuration
    /// tab and the import / link picker requests raised by its Asset Manager
    /// tab.
    void PumpConfigWindow() {
        // ---------------- project child window ----------------
        if (cfgWin != null) {
            int aAct = cfgWin.TakeAssetAction();
            if (cfgWin.TakeDone() || aAct == 1) {
                cfgWin.Close();
                cfgWin = null;
                lastActive = 0 - 1;
                app.RequestRedraw();
            } else if (cfgWin.TakeChoose()) {
                pathPicker.BeginOpenFile(
                    ZanIDE.ReadLastPickerDirectory(root), ".ico",
                    ZanIDE.T("Select application icon (.ico)", "选择应用图标 (.ico)"));
                pathPickerOwner = 2;
                app.RequestRedraw();
            } else if (aAct == 2) {
                pathPicker.BeginOpenFile(
                    ZanIDE.ReadLastPickerDirectory(root), "",
                    ZanIDE.T("Import an asset file", "导入素材文件"));
                pathPickerOwner = 6;
                app.RequestRedraw();
            } else if (aAct == 3) {
                pathPicker.BeginFolder(
                    ZanIDE.ReadLastPickerDirectory(root),
                    ZanIDE.T("Import an asset folder (recursive)", "导入素材文件夹（递归）"));
                pathPickerOwner = 7;
                app.RequestRedraw();
            } else if (aAct == 4) {
                pathPicker.BeginOpenFile(
                    ZanIDE.ReadLastPickerDirectory(root), "",
                    ZanIDE.T("Link a resource (referenced in place)", "链接资源（引用原位置）"));
                pathPickerOwner = 8;
                app.RequestRedraw();
            } else if (!cfgWin.IsOpen()) {
                // Closed through the OS caption / ESC: just drop it.
                cfgWin = null;
                lastActive = 0 - 1;
                app.RequestRedraw();
            }
        }
    }

    /// Pumps the marketplace child window and records a confirmed free-package
    /// install request for the verified download/install pipeline.
    void PumpMarketplaceWindow() {
        if (marketplaceWin == null) { return; }
        MarketplacePackage package = marketplaceWin.TakeInstall();
        if (package != null) {
            marketplaceInstall = package;
            log.Add(ZanIDE.T("> Package install confirmed: ", "> 已确认安装库：")
                + package.packageName);
            marketplaceWin.RequestRedraw();
            app.RequestRedraw();
        } else if (marketplaceWin.TakeClose() || !marketplaceWin.IsOpen()) {
            marketplaceWin.Close();
            marketplaceWin = null;
            app.RequestRedraw();
        }
    }

    /// Pumps the two settings windows (editor appearance and AI
    /// providers), applying a language switch, saved editor prefs or reloaded
    /// AI profiles.
    void PumpSettingsWindows() {
        if (settingsWindow != null) {
            edThemeIdx = settingsWindow.ThemeIndex();
            edFontPx = settingsWindow.FontSize();
            if (settingsWindow.TakeLanguageChanged()) {
                ZanIDE.uiLang = settingsWindow.Language();
                // 键式查找（Lang.Tr）与 lang 信号同侧切换：空码 =
                // 源语言（内置中文缺省串），"en" 走英文包或回退键本身。
                Lang.Set(ZanIDE.uiLang == "zh" ? "" : ZanIDE.uiLang);
                Wizard.lang = ZanIDE.uiLang;
                Designer.lang = ZanIDE.uiLang;
                FilePicker.lang = ZanIDE.uiLang;
                CodeEditor.lang = ZanIDE.uiLang;
                MarketplaceCatalog.lang = ZanIDE.uiLang;
                ribbonTabs = ZanIDE.RibbonTabs();
                ZanIDE.ApplyCaptionTips(app);
                ZanIDE.ApplyPanelLabels(dock);
                // Every open child window refills its designed texts and
                // re-titles itself; without this, dialogs opened before the
                // switch kept the old language until reopened.
                ChildWindows.ApplyLanguage(ZanIDE.uiLang);
                dockOutlineTitle = "";
                dockErrorsTitle = "";
                lastActive = 0 - 1;
                app.RequestRedraw();
            }
            if (settingsWindow.TakeSaved()) {
                ZanIDE.WriteEditorPrefs(edThemeIdx, edFontPx);
                log.Add("> Editor theme: "
                    + ZanIDE.EditorThemeName(edThemeIdx)
                    + "; font " + Convert.ToString(
                        ZanIDE.EditorFontOr(edFontPx, defFontPx))
                    + "px.");
                app.RequestRedraw();
            }
            if (!settingsWindow.IsOpen()) {
                settingsWindow = null;
            }
        }

        if (aiWindow != null) {
            if (aiWindow.TakeSaved()) {
                // Reload the chat's profiles from disk so the enabled
                // profile / model dropdown follow the dialog immediately.
                aiProfiles = new List<AiProfile>();
                aiProfActive = ZanIDE.AiProfilesLoad(aiProfiles);
                aiProfHold = ZanIDE.AiProfilesHold(aiProfiles);
                aiRolePrompts = ZanIDE.AiRolePromptsLoad();
                aiContMax = AiAgent.ContinuesBudget(ZanIDE.AiAutoContLoad());
                aiHandoffMax = AiTeam.HandoffsBudget(
                    ZanIDE.AiAutoContLoad());
                aiModelSelSig = "";
                app.RequestRedraw();
            }
            if (!aiWindow.IsOpen()) {
                aiWindow = null;
            }
        }

        // The assistant child window needs no state hand-back (its panel
        // reads/writes shell state directly while rendering); only the
        // reference is recycled when the user closes it from its own title
        // bar, so the View-tab toggle's on-state follows the window.
        if (aiWin != null && !aiWin.IsOpen()) {
            aiWin = null;
            app.RequestRedraw();
        }
    }

    /// Renders the shared file picker and dispatches its result to whoever
    /// opened it (`pathPickerOwner`).
    void PumpFilePicker() {
        int pickerResult = pathPicker.TakeResult();
        if (pickerResult == 1) {
            string picked = pathPicker.SelectedPath();
            ZanIDE.WriteLastPickerDirectory(
                pathPicker.CurrentDirectory());
            if (pathPickerOwner == 1) {
                pLocInput.SetText(picked);
                if (dlg != null) { dlg.RequestRedraw(); }
            } else if (pathPickerOwner == 2) {
                string ad = ZanIDE.AssetsDir(root);
                Directory.CreateDirectoryRecursive(ad);
                File.Copy(picked, ad + "/app.ico");
                ZanIDE.SetProjectIcon(root, "assets/app.ico");
                log.Add(
                    "> App icon set: assets/app.ico (embedded into the exe on the next Build/Run/Publish).");
            } else if (pathPickerOwner == 3) {
                string ad = ZanIDE.AssetsDir(root);
                Directory.CreateDirectoryRecursive(ad);
                string nm = Path.GetFileName(picked);
                File.Copy(picked, ad + "/" + nm);
                log.Add("> Added resource: assets/" + nm);
                Layer.Msg(ZanIDE.T("Resource copied: ", "已复制资源：") + nm, 3);
            } else if (pathPickerOwner == 6) {
                assetMgr.ImportFile(picked, root, log);
                Layer.Msg(ZanIDE.T("Asset imported", "素材已导入"), 3);
            } else if (pathPickerOwner == 7) {
                assetMgr.ImportFolder(picked, root, log);
                Layer.Msg(ZanIDE.T("Folder imported", "文件夹已导入"), 3);
            } else if (pathPickerOwner == 5 || pathPickerOwner == 8) {
                ZanIDE.AddProjLink(root, picked);
                log.Add("> Linked resource: " + picked);
                Layer.Msg(ZanIDE.T("Resource linked: ", "已链接资源：") + Path.GetFileName(picked), 3);
            } else if (pathPickerOwner == 10) {
                // "Open Project": the pick is a folder, so the project is the
                // folder itself when it holds a zan.proj, else the nearest
                // ancestor that does. A folder with none still opens as a
                // plain workspace -- the project-only commands stay disabled.
                string projRoot = picked;
                if (!File.Exists(projRoot + "/zan.proj")) {
                    projRoot = ZanIDE.FindProjectRoot(picked + "/x");
                }
                tabs = new List<TabRecord>();
                activeTab.Set(0);
                if (projRoot == "") {
                    root = picked;
                    haveProject = false;
                    string firstSrc = ZanIDE.FirstSourceFile(root);
                    if (firstSrc != "") {
                        ZanIDE.OpenPath(tabs, activeTab, firstSrc,
                            Path.GetFileName(firstSrc));
                    }
                    log.Add("> Opened folder " + root + " (no zan.proj).");
                } else {
                    root = projRoot;
                    haveProject = true;
                    ZanIDE.WriteLastProject(root);
                    this.AdoptSymbolIndex();
                    this.AdoptProjectChats();
                    ZanIDE.OpenFirst(tabs, activeTab, root);
                    log.Add("> Opened project " + root + ".");
                }
                startPage.SetRecents(ZanIDE.RecentProjectItems());
                lastActive = 0 - 1;
                rescan = true;
            } else if (pathPickerOwner == 9) {
                app.SetUserWallpaper(picked, app.UserWallpaperOpacity());
            } else if (pathPickerOwner == 4) {
                string projectRoot = ZanIDE.FindProjectRoot(picked);
                haveProject = projectRoot != "";
                if (haveProject) {
                    root = projectRoot;
                    ZanIDE.WriteLastProject(root);
                    this.AdoptSymbolIndex();
                    this.AdoptProjectChats();
                } else {
                    root = ZanIDE.DirOf(picked);
                }
                ZanIDE.OpenPath(tabs, activeTab,
                    picked, Path.GetFileName(picked));
                lastActive = 0 - 1;
                rescan = true;
                log.Add("> Opened " + picked + ".");
            }
            pathPickerOwner = 0;
            ChildWindows.RequestRedrawAll();
            app.RequestRedraw();
        } else if (pickerResult == 2) {
            pathPickerOwner = 0;
            if (dlg != null) { dlg.RequestRedraw(); }
            ChildWindows.RequestRedrawAll();
            app.RequestRedraw();
        }
    }
}
