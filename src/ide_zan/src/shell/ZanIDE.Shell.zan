using System;
using System.IO;
using System.Diagnostics;
using System.Json;
using Gui;
using Gui.Backend;
using Gui.Widget;
using Gui.Designer;
using Game.Scene;

//
partial class ZanIDE {

    void PumpPublishWindow() {
        if (pubWin != null) {
            if (pubWin.TakePublish()) {
                if (buildBusy || pubBusy) {
                    Layer.Msg(ZanIDE.T("A build or publish is already running; wait for it to finish.",
                                       "已有构建/发布在进行，请等待其完成。"), 2);
                    app.RequestRedraw();
                    return;
                }
                pubWin.Close();
                pubWin = null;
                pubRoot = root;
                pubPacked = ZanIDE.ProjSingleFile(root)
                    && !ZanIDE.IsLibraryProject(root);
                pubPending = true;
                app.RequestRedraw();
            } else if (pubWin.TakeCancel()) {
                pubWin.Close();
                pubWin = null;
                app.RequestRedraw();
            } else if (!pubWin.IsOpen()) {
                pubWin = null;
                app.RequestRedraw();
            }
        }
    }

    // tab.
    void PumpConfigWindow() {
        if (cfgWin != null) {
            int aAct = cfgWin.TakeAssetAction();
            if (cfgWin.TakeDone() || aAct == 1) {
                cfgWin.Close();
                cfgWin = null;
                lastActive = 0 - 1;
                app.RequestRedraw();
            } else if (cfgWin.TakeChoose()) {
                pathPicker.BeginOpenFile(
                    ZanIDE.ReadLastPickerDirectory(root), ".ico",
                    ZanIDE.T("Select application icon (.ico)", "选择应用图标 (.ico)"));
                pathPickerOwner = 2;
                app.RequestRedraw();
            } else if (aAct == 2) {
                pathPicker.BeginOpenFile(
                    ZanIDE.ReadLastPickerDirectory(root), "",
                    ZanIDE.T("Import an asset file", "导入素材文件"));
                pathPickerOwner = 6;
                app.RequestRedraw();
            } else if (aAct == 3) {
                pathPicker.BeginFolder(
                    ZanIDE.ReadLastPickerDirectory(root),
                    ZanIDE.T("Import an asset folder (recursive)", "导入素材文件夹（递归）"));
                pathPickerOwner = 7;
                app.RequestRedraw();
            } else if (aAct == 4) {
                pathPicker.BeginOpenFile(
                    ZanIDE.ReadLastPickerDirectory(root), "",
                    ZanIDE.T("Link a resource (referenced in place)", "链接资源（引用原位置）"));
                pathPickerOwner = 8;
                app.RequestRedraw();
            } else if (!cfgWin.IsOpen()) {
                cfgWin = null;
                lastActive = 0 - 1;
                app.RequestRedraw();
            }
        }
    }

    void ClearMarketplaceRecovery() {
        marketplaceRetryBuild = false;
        marketplaceFailedBuild = null;
        marketplaceMissingNamespace = "";
        marketplaceInstallPackage = "";
        marketplaceInstallPending = false;
        marketplaceLocated = false;
    }

    bool MarketplaceContextCurrent() {
        IdeJobResult failed = marketplaceFailedBuild;
        if (failed == null || failed.input == null || shuttingDown) { return false; }
        bool sameRoot = root == failed.input.root
            || ZanIDE.SamePath(root, failed.input.root);
        return documentWorkspace == failed.input.workspace
            && jobMonitorEpoch == failed.input.monitor
            && sameRoot
            && (!failed.input.aiBuild || this.IsJobAiSessionCurrent(failed.input));
    }

    void FinishMarketplaceRecovery(bool installed) {
        if (!marketplaceRetryBuild) { return; }
        IdeJobResult failed = marketplaceFailedBuild;
        bool current = this.MarketplaceContextCurrent();
        bool hot = marketplacePendingHot;
        this.ClearMarketplaceRecovery();
        if (!current || failed == null) { return; }
        // Consume the pending build before dispatch. A failed retry cannot reopen recovery.
        if (installed && !buildBusy && !pubBusy) {
            string target = failed.target != null && failed.target != ""
                ? failed.target : failed.input.buildTarget;
            aiBuildForAi = failed.input.aiBuild;
            aiUiPending = failed.input.aiUiPending;
            aiUiScript = failed.input.aiUiScript;
            aiUiTool = failed.input.uiTool;
            log.Add(ZanIDE.T("> Package installed; retrying the original build once.",
                "> 依赖已安装，正在重试原构建（一次）。"));
            this.BeginBuildJob(target, failed.input.thenRun, failed.input.debug,
                hot, failed.input);
        } else {
            // Preserve the existing debug/AI failure completion path, with no new build.
            this.ApplyBuildJobResult(failed);
        }
    }

    void LocateMarketplaceNamespace() {
        if (!marketplaceRetryBuild || marketplaceLocated) { return; }
        MarketplaceCatalog cat = MarketplaceCatalog.current;
        if (cat == null || cat.Loading()) { return; }
        marketplaceLocated = true;
        List<MarketplacePackage> packages = cat.Packages();
        int best = -1;
        int length = 0;
        bool ambiguous = false;
        for (int i = 0; i < packages.Count; i = i + 1) {
            int match = packages[i].NamespaceMatchLength(marketplaceMissingNamespace);
            if (match > length) { best = i; length = match; ambiguous = false; }
            else if (match > 0 && match == length) { ambiguous = true; }
        }
        if (best >= 0 && !ambiguous) {
            cat.Select(packages[best]);
            cat.selectedRow = best;
        } else {
            cat.status = ambiguous
                ? ZanIDE.T("Multiple extensions provide this namespace: ", "多个扩展提供此命名空间：")
                    + marketplaceMissingNamespace
                : ZanIDE.T("Namespace is not listed in Extensions: ", "扩展中心未收录命名空间：")
                    + marketplaceMissingNamespace;
            log.Add("> " + cat.status);
        }
        marketplaceWin.RequestRedraw();
    }

    void PumpMarketplaceWindow() {
        if (marketplaceRetryBuild && !this.MarketplaceContextCurrent()) {
            this.ClearMarketplaceRecovery();
        }
        if (marketplaceWin == null) { return; }
        this.LocateMarketplaceNamespace();
        MarketplacePackage package = marketplaceWin.TakeInstall();
        if (package != null) {
            // 真正的安装交给执行器（下载→校验→解包→入包仓库），在
            // 后台线程里跑；这里只把意图交出去并展示"已在安装"。
            bool recover = marketplaceRetryBuild && this.MarketplaceContextCurrent()
                && package.Provides(marketplaceMissingNamespace);
            string projectRoot = haveProject ? root : "";
            if (recover) {
                IdeJobResult failed = marketplaceFailedBuild;
                string target = failed.target != null && failed.target != ""
                    ? failed.target : failed.input.buildTarget;
                projectRoot = ZanIDE.TargetRoot(failed.input.root, target);
            }
            string err = MarketplaceInstall.Start(package, projectRoot);
            if (err.Length > 0) {
                log.Add(ZanIDE.T("> Cannot install ", "> 无法安装：") + err);
                if (recover) { this.FinishMarketplaceRecovery(false); }
            } else {
                marketplaceInstallPending = recover;
                marketplaceInstallPackage = recover ? package.packageName : "";
                log.Add(ZanIDE.T("> Installing ", "> 正在安装：")
                    + package.packageName + "...");
            }
            marketplaceWin.RequestRedraw();
            app.RequestRedraw();
        } else if (marketplaceWin.TakeClose() || !marketplaceWin.IsOpen()) {
            this.FinishMarketplaceRecovery(false);
            marketplaceWin.Close();
            marketplaceWin = null;
            app.RequestRedraw();
        }
    }

    // AI profiles.
    void PumpSettingsWindows() {
        if (settingsWindow != null) {
            edThemeIdx = settingsWindow.ThemeIndex();
            edFontPx = settingsWindow.FontSize();
            if (settingsWindow.TakeLanguageChanged()) {
                ZanIDE.uiLang = settingsWindow.Language();
                // 键式查找（Lang.Tr）与 lang 信号同侧切换：空码 =
                // 源语言（内置中文缺省串），"en" 走英文包或回退键本身。
                Lang.Set(ZanIDE.uiLang == "zh" ? "" : ZanIDE.uiLang);
                Wizard.lang = ZanIDE.uiLang;
                Designer.lang = ZanIDE.uiLang;
                FilePicker.lang = ZanIDE.uiLang;
                CodeEditor.lang = ZanIDE.uiLang;
                MarketplaceCatalog.lang = ZanIDE.uiLang;
                ribbonTabs = ZanIDE.RibbonTabs();
                ZanIDE.ApplyCaptionTips(app);
                ZanIDE.ApplyPanelLabels(dock);
                ChildWindows.ApplyLanguage(ZanIDE.uiLang);
                dockOutlineTitle = "";
                dockErrorsTitle = "";
                lastActive = 0 - 1;
                app.RequestRedraw();
            }
            if (settingsWindow.TakeSaved()) {
                ZanIDE.WriteEditorPrefs(edThemeIdx, edFontPx);
                log.Add("> Editor theme: "
                    + ZanIDE.EditorThemeName(edThemeIdx)
                    + "; font " + Convert.ToString(
                        ZanIDE.EditorFontOr(edFontPx, defFontPx))
                    + "px.");
                app.RequestRedraw();
            }
            if (!settingsWindow.IsOpen()) {
                settingsWindow = null;
            }
        }

        if (aiWindow != null) {
            if (aiWindow.TakeSaved()) {
                aiProfiles = new List<AiProfile>();
                aiProfActive = ZanIDE.AiProfilesLoad(aiProfiles);
                aiProfHold = ZanIDE.AiProfilesHold(aiProfiles);
                aiRolePrompts = ZanIDE.AiRolePromptsLoad();
                aiContMax = AiAgent.ContinuesBudget(ZanIDE.AiAutoContLoad());
                aiHandoffMax = AiTeam.HandoffsBudget(
                    ZanIDE.AiAutoContLoad());
                aiModelSelSig = "";
                app.RequestRedraw();
            }
            if (!aiWindow.IsOpen()) {
                aiWindow = null;
            }
        }

        if (aiWin != null && !aiWin.IsOpen()) {
            aiWin = null;
            app.RequestRedraw();
        }
    }

    // opened it (`pathPickerOwner`).
    void PumpFilePicker() {
        int pickerResult = pathPicker.TakeResult();
        if (pickerResult == 1) {
            string picked = pathPicker.SelectedPath();
            ZanIDE.WriteLastPickerDirectory(
                pathPicker.CurrentDirectory());
            if (pathPickerOwner == 1) {
                pLocInput.SetText(picked);
                if (dlg != null) { dlg.RequestRedraw(); }
            } else if (pathPickerOwner == 2) {
                // 图标/资源拷贝也走 worker：选中的资源可以是任意大的文件，
                // UI 线程同步 File.Copy 就是发布/加素材时的一整段假死。
                // zan.proj 的配置改写留在主侧（与其他配置写串行）。
                string src2 = picked;
                App host = app;
                Task worker = Task.Run(delegate () {
                    string ad = ZanIDE.AssetsDir(root);
                    Directory.CreateDirectoryRecursive(ad);
                    File.Copy(src2, ad + "/app.ico");
                    host.Post(delegate () {
                        if (shuttingDown) { return; }
                        ZanIDE.SetProjectIcon(root, "assets/app.ico");
                        log.Add(
                            "> App icon set: assets/app.ico (embedded into the exe on the next Build/Run/Publish).");
                        app.RequestRedraw();
                    });
                });
            } else if (pathPickerOwner == 3) {
                string src3 = picked;
                string nm3 = Path.GetFileName(picked);
                App host = app;
                Task worker = Task.Run(delegate () {
                    string ad = ZanIDE.AssetsDir(root);
                    Directory.CreateDirectoryRecursive(ad);
                    File.Copy(src3, ad + "/" + nm3);
                    host.Post(delegate () {
                        if (shuttingDown) { return; }
                        log.Add("> Added resource: assets/" + nm3);
                        Layer.Msg(ZanIDE.T("Resource copied: ", "已复制资源：") + nm3, 3);
                        app.RequestRedraw();
                    });
                });
            } else if (pathPickerOwner == 6) {
                string src6 = picked;
                App host = app;
                Task worker = Task.Run(delegate () {
                    List<string> messages = new List<string>();
                    assetMgr.ImportFile(src6, root, messages);
                    host.Post(delegate () {
                        if (shuttingDown) { return; }
                        ZanIDE.AppendAll(log, messages);
                        Layer.Msg(ZanIDE.T("Asset imported", "素材已导入"), 3);
                        app.RequestRedraw();
                    });
                });
            } else if (pathPickerOwner == 7) {
                string src7 = picked;
                App host = app;
                Task worker = Task.Run(delegate () {
                    List<string> messages = new List<string>();
                    assetMgr.ImportFolder(src7, root, messages);
                    host.Post(delegate () {
                        if (shuttingDown) { return; }
                        ZanIDE.AppendAll(log, messages);
                        Layer.Msg(ZanIDE.T("Folder imported", "文件夹已导入"), 3);
                        app.RequestRedraw();
                    });
                });
            } else if (pathPickerOwner == 5 || pathPickerOwner == 8) {
                ZanIDE.AddProjLink(root, picked);
                log.Add("> Linked resource: " + picked);
                Layer.Msg(ZanIDE.T("Resource linked: ", "已链接资源：") + Path.GetFileName(picked), 3);
            } else if (pathPickerOwner == 10) {
                this.OpenProjectAsync(picked);
                startPage.SetRecents(ZanIDE.RecentProjectItems());
            } else if (pathPickerOwner == 9) {
                app.SetUserWallpaper(picked, app.UserWallpaperOpacity());
            } else if (pathPickerOwner == 4) {
                this.OpenPickedDocumentAsync(picked);
            }
            pathPickerOwner = 0;
            ChildWindows.RequestRedrawAll();
            app.RequestRedraw();
        } else if (pickerResult == 2) {
            pathPickerOwner = 0;
            if (dlg != null) { dlg.RequestRedraw(); }
            ChildWindows.RequestRedrawAll();
            app.RequestRedraw();
        }
    }
}
