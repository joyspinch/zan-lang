using System;
using System.IO;
using System.Diagnostics;
using System.Json;
using System.Web;
using Gui;
using Gui.Widget;
using Gui.Component;
using Gui.Designer;
using Game.Scene;
using Gui.Backend;

partial class ZanIDE {
    // Project templates, scaffolding, wizard retargeting and new-file generation moved to ZanIDE.Scaffold.zan

    static List<TreeNode> ScanTree(string root) {
        List<TreeNode> nodes = new List<TreeNode>();
        ZanIDE.ScanInto(
            nodes, root, Path.GetFileName(root), 0, true);
        return nodes;
    }

    static List<string> ExpandedPaths(List<TreeNode> nodes) {
        List<string> outp = new List<string>();
        for (int i = 0; i < nodes.Count; i = i + 1) {
            TreeNode n = nodes[i];
            if (n.isDir && n.expanded && n.path != "") { outp.Add(n.path); }
        }
        return outp;
    }

    // rescan (counterpart of ExpandedPaths).
    static void ApplyExpanded(List<TreeNode> nodes, List<string> exp) {
        for (int i = 0; i < nodes.Count; i = i + 1) {
            TreeNode n = nodes[i];
            if (n.isDir && n.path != "" && exp.Contains(n.path)) {
                n.expanded = true;
            }
        }
    }

    static void ScanInto(List<TreeNode> nodes, string dirPath, string dirName, int depth, bool expanded) {
        FileTree.Into(nodes, dirPath, dirName, depth, expanded,
            PathFilter.Any().Hide(".proj").Dots(true, true),
            true, false);
    }

    static bool EndsWith(string s, string suffix) {
        int sl = s.Length;
        int fl = suffix.Length;
        if (fl > sl) { return false; }
        return s.Substring(sl - fl, fl) == suffix;
    }

    // ---- tabs ----

    static int FindTabByPath(List<TabRecord> tabs, string path) {
        for (int i = 0; i < tabs.Count; i = i + 1) {
            if (tabs[i].path == path) { return i; }
        }
        return 0 - 1;
    }

    static void OpenPath(List<TabRecord> tabs, SignalInt active,
                         string path, string name) {
        ZanIDE owner = ZanIDE.current;
        if (owner != null && owner.app != null && owner.tabs == tabs) {
            owner.OpenDocumentAsync(path, name);
            return;
        }
        int idx = ZanIDE.FindTabByPath(tabs, path);
        if (idx >= 0) {
            active.Set(idx);
            return;
        }
        string content = "";
        if (File.Exists(path)) { content = File.ReadAllText(path); }
        tabs.Add(TabRecord.Create(name, content, path));
        active.Set(tabs.Count - 1);
    }

    // 诊断里的位置解析成一个真实存在的文件路径，定位不到时为 ""。
    // 编译器打印的路径可能是绝对路径、相对工作区根的路径，或用
    // 反斜杠分隔；诊断也可能压根没有位置（`error:` 开头的那种）。
    static string ResolveDiagPath(string root, string p) {
        if (p == null) { return ""; }
        string s = ZanIDE.NormSlashes(p.Trim());
        if (s == "") { return ""; }
        if (File.Exists(s)) { return s; }
        if (root != null && root != "") {
            string j = ZanIDE.NormSlashes(root) + "/" + s;
            if (File.Exists(j)) { return j; }
        }
        return "";
    }

    static IdeDocumentWrite SaveActive(CodeEditor editor, List<TabRecord> tabs,
                                       SignalInt active, string root, List<string> log) {
        int a = active.Get();
        if (a < 0 || a >= tabs.Count) { return null; }
        string p = tabs[a].path;
        if (p.StartsWith("@") || ZanIDE.IsFormPath(p) || ZanIDE.IsScenePath(p)
            || tabs[a].designDoc) { return null; }
        string text = editor.documentPath == p ? editor.GetText() : tabs[a].body;
        tabs[a].body = text;
        if (p == "") {
            p = root + "/" + tabs[a].name;
            tabs[a].path = p;
        }
        return IdeDocumentWrite.Create(p, text);
    }

    static IdeDocumentWrite SaveFormCode(CodeEditor ed, string formPath, string root, List<string> log) {
        string cbp = ZanIDE.CodeBehindPath(formPath);
        return IdeDocumentWrite.Create(cbp, ed.GetText());
    }

    // ---- toolchain ----

    static List<TreeNode> FilterNodes(List<TreeNode> nodes, string filter) {
        if (filter == "") { return nodes; }
        string f = ZanIDE.ToLowerS(filter);
        List<TreeNode> outp = new List<TreeNode>();
        for (int i = 0; i < nodes.Count; i = i + 1) {
            TreeNode n = nodes[i];
            if (!n.isDir && ZanIDE.Has(ZanIDE.ToLowerS(n.label), f)) {
                TreeNode m = TreeNode.FileIcon(n.label, 0, n.icon);
                m.path = n.path;
                outp.Add(m);
            }
        }
        return outp;
    }

    static string RunTarget(string p, string root) {
        if (p == "@start" || p == "@docs") {
            string entry = ZanIDE.ProjectEntry(root);
            if (File.Exists(entry)) { return entry; }
            return "";
        }
        if (ZanIDE.IsFormPath(p)) {
            return p;
        }
        if (ZanIDE.IsScenePath(p)) {
            return p;
        }
        if (ZanIDE.IsGenPath(p)) {
            string gform = p.Substring(0, p.Length - 6) + ".html";
            if (File.Exists(gform)) { return gform; }
        }
        if (ZanIDE.IsZanFilePath(p) && !ZanIDE.IsGenPath(p)) {
            string form = p.Substring(0, p.Length - 4) + ".html";
            if (File.Exists(form)) { return form; }
        }
        // 非源文件（config/app.json、views/*.html、wwwroot 里的资源…）
        // 不是编译输入：它们只是被复制到输出目录（见 ProjCopyItems），
        // 所以在这种标签页上运行 / 构建回到项目入口，
        // 而不是把 JSON 当源码交给编译器。
        if (!ZanIDE.IsZanFilePath(p)) {
            string pentry = ZanIDE.ProjectEntry(root);
            if (File.Exists(pentry)) { return pentry; }
            return "";
        }
        return p;
    }

    static string RibbonRunTarget(string activePath, string root) {
        return ZanIDE.RunTarget(activePath, root);
    }

    static string SmartInputs(string root, string dir, string entry) {
        bool proj = File.Exists(root + "/zan.proj") || File.Exists(dir + "/zan.proj");
        List<string> have = new List<string>();
        have.Add(entry);
        if (!proj) {
            string args0 = "\"" + entry + "\"";
            if (ZanIDE.IsDesignFilePath(entry)) {
                string cbp0 = ZanIDE.CodeBehindPath(entry);
                if (File.Exists(cbp0)) { args0 = args0 + " \"" + cbp0 + "\""; have.Add(cbp0); }
            }
            if (ZanIDE.IsScenePath(entry)) {
                string scb0 = ZanIDE.SceneCodeBehindPath(entry);
                if (File.Exists(scb0)) { args0 = args0 + " \"" + scb0 + "\""; have.Add(scb0); }
            }
            return ZanIDE.WithUsedModules(args0, dir, entry, have);
        }
        string args = "\"" + entry + "\"";
        List<string> all = new List<string>();
        ZanIDE.GatherZanFiles(dir, all);
        for (int i = 0; i < all.Count; i = i + 1) {
            string f = all[i];
            if (f != entry && !ZanIDE.FileHasMain(f)) {
                args = args + " \"" + f + "\"";
                have.Add(f);
            }
        }
        return ZanIDE.WithUsedModules(args, dir, entry, have);
    }

    // again.
    static string WithUsedModules(string args, string dir, string entry,
                                  List<string> have) {
        List<string> want = new List<string>();
        ZanIDE.CollectUsings(entry, want);
        if (want.Count == 0) { return args; }
        int guard = 0;
        while (want.Count > 0 && guard < 32) {
            guard = guard + 1;
            string ns = want[0];
            want.RemoveAt(0);
            string found = ZanIDE.FindNamespaceFile(dir, ns, entry, have);
            if (found == "") { continue; }
            have.Add(found);
            args = args + " \"" + found + "\"";
            ZanIDE.CollectUsings(found, want);
        }
        return args;
    }

    static void CollectUsings(string path, List<string> outp) {
        if (!File.Exists(path)) { return; }
        List<string> lines = ZanIDE.SplitLinesOf(File.ReadAllText(path));
        for (int i = 0; i < lines.Count; i = i + 1) {
            string ln = lines[i].Trim();
            if (ZanIDE.StartsWith(ln, "using ") && ZanIDE.EndsWith(ln, ";")) {
                string ns = ln.Substring(6, ln.Length - 7).Trim();
                if (ns != "" && !outp.Contains(ns)) { outp.Add(ns); }
            }
        }
    }

    static string FindNamespaceFile(string dir, string ns, string entry,
                                    List<string> skip) {
        string at = dir;
        PathFilter dirs = PathFilter.Any().Skip("build dist bin obj publish");
        for (int up = 0; up < 4; up = up + 1) {
            if (dirs.EnterDir(Path.GetFileName(at))) {
                List<string> cand = new List<string>();
                ZanIDE.ListZanFilesIn(at, cand);
                List<string> subs = DirectoryTree.SubDirs(at, dirs);
                for (int s = 0; s < subs.Count; s = s + 1) {
                    ZanIDE.ListZanFilesIn(subs[s], cand);
                }
                for (int i = 0; i < cand.Count; i = i + 1) {
                    string f = cand[i];
                    if (f != entry && !skip.Contains(f)
                        && ZanIDE.DeclaresNamespace(f, ns)
                        && !ZanIDE.FileHasMain(f)) {
                        return f;
                    }
                }
            }
            string parent = ZanIDE.DirOf(at);
            if (parent == at || parent == ".") { return ""; }
            at = parent;
        }
        return "";
    }

    static void ListZanFilesIn(string dir, List<string> outp) {
        DirectoryTree.FlatInto(outp, dir, PathFilter.Only(".zan").Dots(true, true));
    }

    static bool DeclaresNamespace(string path, string ns) {
        if (!File.Exists(path)) { return false; }
        return ZanIDE.IndexOfStr(File.ReadAllText(path), "namespace " + ns + ";") >= 0;
    }

    static List<string> SplitLinesOf(string text) {
        List<string> outp = new List<string>();
        string cur = "";
        for (int i = 0; i < text.Length; i = i + 1) {
            string ch = text.Substring(i, 1);
            if (ch == "\n") { outp.Add(cur); cur = ""; }
            else if (ch != "\r") { cur = cur + ch; }
        }
        if (cur != "") { outp.Add(cur); }
        return outp;
    }

    static bool FileHasMain(string path) {
        if (!File.Exists(path)) { return false; }
        string s = File.ReadAllText(path);
        int i = ZanIDE.IndexOfStr(s, " Main(");
        while (i >= 0) {
            int ls = i;
            while (ls > 0 && s.Substring(ls - 1, 1) != "\n") { ls = ls - 1; }
            string line = s.Substring(ls, i - ls);
            if (ZanIDE.IndexOfStr(line, "static ") >= 0) { return true; }
            int nxt = ZanIDE.IndexOfStr(s.Substring(i + 1, s.Length - i - 1), " Main(");
            if (nxt < 0) { return false; }
            i = i + 1 + nxt;
        }
        return false;
    }

    // // 按字节比较，不切子串：`hay.Substring(i, n) == needle` 每个位置都要新分配
    // 一个字符串，扫一份几十万字节的流式正文就是几十万次分配。小助手工作时
    // 每 100ms 就要在整段正文上找一次工具块围栏，界面于是一卡一卡的。
    static int IndexOfStr(string hay, string needle) {
        return ZanIDE.IndexOfFrom(hay, needle, 0);
    }

    // Same, starting at `from`. 找一段大正文里的字段时，从调用起点往后扫，
    // 省掉「先切出尾巴再找」那一次整段复制。
    static int IndexOfFrom(string hay, string needle, int from) {
        int n = needle.Length;
        int h = hay.Length;
        if (from < 0) { from = 0; }
        if (n == 0) { return from; }
        int c0 = needle[0] & 255;
        for (int i = from; i + n <= h; i = i + 1) {
            if ((hay[i] & 255) != c0) { continue; }
            int k = 1;
            while (k < n && (hay[i + k] & 255) == (needle[k] & 255)) {
                k = k + 1;
            }
            if (k == n) { return i; }
        }
        return -1;
    }

    static int LastIndexOfStr(string hay, string needle) {
        int n = needle.Length;
        int h = hay.Length;
        if (n == 0) { return h; }
        int c0 = needle[0] & 255;
        for (int i = h - n; i >= 0; i = i - 1) {
            if ((hay[i] & 255) != c0) { continue; }
            int k = 1;
            while (k < n && (hay[i + k] & 255) == (needle[k] & 255)) {
                k = k + 1;
            }
            if (k == n) { return i; }
        }
        return -1;
    }

    static int DigitVal(string ch) {
        return ZanIDE.IndexOfStr("0123456789", ch);
    }

    static int ParseLeadInt(string s) {
        int v = 0;
        bool any = false;
        for (int i = 0; i < s.Length; i = i + 1) {
            int d = ZanIDE.DigitVal(s.Substring(i, 1));
            if (d < 0) { break; }
            v = v * 10 + d;
            any = true;
        }
        if (!any) { return -1; }
        return v;
    }

    static string StripAnsi(string s) {
        string esc = Text.ByteChar(27);
        string outp = "";
        int i = 0;
        while (i < s.Length) {
            string ch = s.Substring(i, 1);
            if (ch == esc) {
                i = i + 1;
                while (i < s.Length && s.Substring(i, 1) != "m") { i = i + 1; }
                if (i < s.Length) { i = i + 1; }
            } else {
                outp = outp + ch;
                i = i + 1;
            }
        }
        return outp;
    }

    static void ApplyDiagnostics(CodeEditor editor, string activePath, List<string> output, List<string> log) {
        List<Diagnostic> diagnostics = new List<Diagnostic>();
        bool isZan = activePath.Length > 4
            && activePath.Substring(activePath.Length - 4, 4) == ".zan";
        if (isZan) {
            string baseName = Path.GetFileName(activePath);
            for (int oi = 0; oi < output.Count; oi = oi + 1) {
                string raw = ZanIDE.StripAnsi(output[oi]);
                int ep = ZanIDE.IndexOfStr(raw, ": error:");
                if (ep > 0) {
                    string loc = raw.Substring(0, ep);
                    if (ZanIDE.IndexOfStr(loc, baseName) >= 0) {
                        int c2 = ZanIDE.LastIndexOfStr(loc, ":");
                        if (c2 > 0) {
                            int c1 = ZanIDE.LastIndexOfStr(loc.Substring(0, c2), ":");
                            if (c1 >= 0) {
                                string lineStr = loc.Substring(c1 + 1, c2 - (c1 + 1));
                                int lineNo = ZanIDE.ParseLeadInt(lineStr);
                                if (lineNo > 0) {
                                    string msg = raw.Substring(ep + 8, raw.Length - (ep + 8));
                                    diagnostics.Add(new Diagnostic(lineNo - 1,
                                        ZanIDE.TrimLeadSpaces(msg)));
                                }
                            }
                        }
                    }
                }
            }
        }
        editor.SetCompilerDiagnostics(diagnostics);
        if (diagnostics.Count > 0) {
            log.Add("> " + Convert.ToString(diagnostics.Count) + " error(s) in this file; jumped to the first.");
        }
    }

    // compile.
    static void HotKillRunExe(string exe) {
        string nm = ZanIDE.BaseName(exe);
        #if WINDOWS
        Process.Run("taskkill /F /IM \"" + nm + "\" >nul 2>nul");
        #else
        Process.Run("pkill -f \"" + exe + "\" >/dev/null 2>&1");
        #endif
    }

    static void ClearStaleRunExe(string exe) {
        if (File.Exists(exe)) { File.Delete(exe); }
        if (!File.Exists(exe)) {
            #if !WINDOWS
            ZanIDE.HotKillRunExe(exe);
            #endif
            return;
        }
        ZanIDE.HotKillRunExe(exe);
        if (File.Exists(exe)) { File.Delete(exe); }
    }

    static bool Has(string hay, string needle) {
        int n = needle.Length;
        int h = hay.Length;
        if (n == 0) { return true; }
        for (int i = 0; i + n <= h; i = i + 1) {
            if (hay.Substring(i, n) == needle) { return true; }
        }
        return false;
    }

    static string RunCwd(string root, string target, string exe) {
        string troot = ZanIDE.TargetRoot(root, target);
        if (troot != "" && Directory.Exists(troot)) { return troot; }
        string d = ZanIDE.DirOf(target);
        if (d != "" && Directory.Exists(d)) { return d; }
        if (root != "" && Directory.Exists(root)) { return root; }
        return ZanIDE.DirOf(exe);
    }

    static string MissingPackage(List<string> lines) {
        string marker = "ZANPKG_MISSING namespace=";
        for (int i = 0; i < lines.Count; i = i + 1) {
            int at = lines[i].IndexOf(marker);
            if (at >= 0) {
                string ns = lines[i].Substring(at + marker.Length,
                    lines[i].Length - at - marker.Length);
                int end = ns.IndexOf(" ");
                if (end >= 0) { ns = ns.Substring(0, end); }
                ns = ns.Trim();
                // 标准库自带的命名空间（Gui、Gui/Widget、Game/Scene…）不是
                // 缺失的扩展：这种是编译参数/代码的问题，别当成要装扩展。
                if (Directory.Exists(ZanIDE.StdlibDir() + "/" + ns)) { continue; }
                return ZanIDE.ReplaceAll(ns, "/", ".");
            }
        }
        return "";
    }

    static string TargetRoot(string root, string target) {
        string owner = ZanIDE.FindProjectRoot(target);
        if (owner != "") { return owner; }
        string dir = ZanIDE.DirOf(target);
        if (root != "" && ZanIDE.StartsWith(ZanIDE.NormSlashes(target) + "/",
                                            ZanIDE.NormSlashes(root) + "/")) {
            return root;
        }
        if (dir == "" || dir == ".") { return root; }
        return dir;
    }

    static string RunBuildBegin(string root, string target) {
        string troot = ZanIDE.TargetRoot(root, target);
        string bd = ZanIDE.EnsureBuildDir(troot);
        string exe = bd + "/.zanrun" + ZanIDE.ExeSuffix();
        if (ZanIDE.IsLibraryProject(troot)) {
            string baseName = Path.GetFileName(troot);
            if (baseName == "") { baseName = "lib"; }
            exe = bd + "/" + baseName + ZanIDE.HostLibExt();
        }
        ZanIDE.ClearStaleRunExe(exe);
        string inputs = ZanIDE.InputsArg(bd, ".zanrun_inputs",
            ZanIDE.SmartInputs(troot, ZanIDE.DirOf(target), target));
        string pre = ZanIDE.ProjPreBuild(troot);
        ZanIDE.BuildDetachWithPre(
            ZanIDE.CompileToExe(troot, target, inputs, bd + "/.zanrun.ll", exe, false, false),
            troot, pre);
        return exe;
    }

    static string SymbolIndexPath(string root) {
        return ZanIDE.EnsureBuildDir(root) + "/symbols.idx";
    }

    static string ProjectEntryPath(string root) {
        string entry = "src/main.zan";
        string mpath = root + "/zan.proj";
        if (File.Exists(mpath)) {
            entry = ZanIDE.ManifestField(File.ReadAllText(mpath), "entry", entry);
        }
        string full = root + "/" + entry;
        if (ZanIDE.IsGenPath(full)) {
            string form = full.Substring(0, full.Length - 6) + ".html";
            if (File.Exists(form)) { return form; }
        }
        if (!File.Exists(full)) { full = root + "/src/main.zan"; }
        return full;
    }

    static void EmitSymbolsDetach(string root, string target) {
        string idx = ZanIDE.SymbolIndexPath(root);
        string tmp = idx + ".tmp";
        string inputs = ZanIDE.InputsArg(ZanIDE.EnsureBuildDir(root), ".symbols_inputs",
            ZanIDE.SmartInputs(root, ZanIDE.DirOf(target), target));
        string cmd = ZanIDE.ZancCmd() + " --emit-symbols \"" + tmp + "\" " + inputs
            + " --auto-stdlib";
        #if WINDOWS
        string sep = " && ";
        string mvSrc = ZanIDE.ReplaceAll(tmp, "/", "\\");
        string mvDst = ZanIDE.ReplaceAll(idx, "/", "\\");
        string mv = "move /y \"" + mvSrc + "\" \"" + mvDst + "\"";
        #else
        string sep = " && ";
        string mv = "mv -f \"" + tmp + "\" \"" + idx + "\"";
        #endif
        File.WriteAllText(idx + ".log", "CMD: " + cmd + "\n");
        Process.RunDetached("((" + cmd + ") >> \"" + idx + ".log\" 2>&1)" + sep + mv
            + " >> \"" + idx + ".log\" 2>&1");
    }

    static bool LoadSymbolIndexFor(string root) {
        return CodeEditor.LoadSymbolIndex(ZanIDE.SymbolIndexPath(root));
    }

    //
    void AdoptSymbolIndex() {
        if (adoptedSymbolProject == haveProject && ZanIDE.SamePath(adoptedSymbolRoot, root)) { return; }
        adoptedSymbolRoot = root;
        adoptedSymbolProject = haveProject;
        this.CancelDocumentReads();
        this.CancelCodeNavigation();
        if (lspSess != null) {
            lspSess.Shutdown();
            retiredLanguageServices.Add(lspSess);
        }
        lspSess = null;
        lspTried = false;
        ZanIDE.InvalidateNavFiles();
        CodeEditor.ClearSymbolIndex();
        symbolIdxStamp = 0;
        symbolEmitMs = 0;
        this.StartSymbolMonitor();
        this.ResetJobMonitorWorkspace();
        this.RefreshSymbolIndex(true);
        if (gitPanel != null) { this.gitPanel.SyncWorkspace(); }
    }

    void RefreshSymbolIndex(bool force) {
        if (!haveProject || shuttingDown || symbolMonitor == null) { return; }
        int now = Window.GetTickMs();
        if (!force && symbolEmitMs != 0 && now - symbolEmitMs < 15000) { return; }
        symbolEmitMs = now;
        ZanIDE.InvalidateNavFiles();
        symbolMonitor.requests.Enqueue(new IdeSymbolRefresh());
    }

    static string PathOf(List<TabRecord> tabs, SignalInt active) {
        int a = active.Get();
        if (a >= 0 && a < tabs.Count) { return tabs[a].path; }
        return "";
    }

    static string DirOf(string path) {
        int last = 0 - 1;
        for (int i = 0; i < path.Length; i = i + 1) {
            string ch = path.Substring(i, 1);
            if (ch == "/" || ch == "\\") { last = i; }
        }
        if (last < 0) { return "."; }
        return path.Substring(0, last);
    }

    static string FindProjectRoot(string path) {
        string dir = ZanIDE.DirOf(path);
        for (int depth = 0; depth < 24; depth = depth + 1) {
            if (File.Exists(dir + "/zan.proj")) { return dir; }
            string parent = ZanIDE.DirOf(dir);
            if (parent == dir || parent == ".") { break; }
            dir = parent;
        }
        return "";
    }

    static bool IsZanFile(string name) {
        int n = name.Length;
        if (n < 4) { return false; }
        return name.Substring(n - 4, 4) == ".zan";
    }

    static void GatherZanFiles(string dir, List<string> outp) {
        DirectoryTree.FilesInto(outp, dir,
            PathFilter.Only(".zan .html .htm .zcomp")
                .Skip("publish build bin obj dist tools")
                .Dots(true, true));
    }

    static string ProjectInputs(string dir, string entry, string skip) {
        string args = "\"" + entry + "\"";
        List<string> all = new List<string>();
        ZanIDE.GatherZanFiles(dir, all);
        for (int i = 0; i < all.Count; i = i + 1) {
            string f = all[i];
            if (f != entry && f != skip) {
                args = args + " \"" + f + "\"";
            }
        }
        return args;
    }

    static string ProjectEntry(string root) {
        return ZanIDE.ProjectEntryPath(root);
    }

    static string TrimLeadSpaces(string s) {
        int i = 0;
        while (i < s.Length) {
            string ch = s.Substring(i, 1);
            if (ch == " " || ch == "\t") { i = i + 1; }
            else { break; }
        }
        if (i == 0) { return s; }
        return s.Substring(i, s.Length - i);
    }

    static string TrimTrailSpaces(string s) {
        int e = s.Length;
        while (e > 0 && s.Substring(e - 1, 1) == " ") { e = e - 1; }
        if (e == s.Length) { return s; }
        return s.Substring(0, e);
    }

    static string ExtractIdent(string s, int start) {
        string idc = "abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ0123456789_";
        string name = "";
        for (int i = start; i < s.Length && CodeEditor.InSet(idc, s.Substring(i, 1)); i = i + 1) {
            name = name + s.Substring(i, 1);
        }
        return name;
    }

    static string ExtractValue(string rest, int ni) {
        if (ni >= rest.Length) { return "(uninitialized)"; }
        if (rest.Substring(ni, 1) != "=") { return "(uninitialized)"; }
        ni = ni + 1;
        while (ni < rest.Length && rest.Substring(ni, 1) == " ") { ni = ni + 1; }
        string val = "";
        while (ni < rest.Length && rest.Substring(ni, 1) != ";") {
            val = val + rest.Substring(ni, 1);
            ni = ni + 1;
        }
        if (val.Length == 0) { return "(empty)"; }
        return val;
    }

    static void OpenNewTab(List<TabRecord> tabs, SignalInt activeTab, string name, string code) {
        tabs.Add(TabRecord.Create(name, code, ""));
        activeTab.Set(tabs.Count - 1);
    }

    static int ParseInt(string s) {
        int result = 0;
        for (int i = 0; i < s.Length; i = i + 1) {
            string ch = s.Substring(i, 1);
            if (ch == "0") { result = result * 10; }
            else if (ch == "1") { result = result * 10 + 1; }
            else if (ch == "2") { result = result * 10 + 2; }
            else if (ch == "3") { result = result * 10 + 3; }
            else if (ch == "4") { result = result * 10 + 4; }
            else if (ch == "5") { result = result * 10 + 5; }
            else if (ch == "6") { result = result * 10 + 6; }
            else if (ch == "7") { result = result * 10 + 7; }
            else if (ch == "8") { result = result * 10 + 8; }
            else if (ch == "9") { result = result * 10 + 9; }
        }
        return result;
    }

    static int BraceDelta(string ln) {
        int d = 0;
        for (int i = 0; i < ln.Length; i = i + 1) {
            string ch = ln.Substring(i, 1);
            if (ch == "{") { d = d + 1; }
            else if (ch == "}") { d = d - 1; }
        }
        return d;
    }

    static string ListElemKind(string elem) {
        if (elem == "int" || elem == "string" || elem == "long"
            || elem == "float" || elem == "double" || elem == "char") {
            return elem;
        }
        return "";
    }

    static bool StartsWith(string s, string pfx) {
        if (s.Length < pfx.Length) { return false; }
        return s.Substring(0, pfx.Length) == pfx;
    }
}
