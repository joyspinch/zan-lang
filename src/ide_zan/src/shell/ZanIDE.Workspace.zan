using System;
using System.IO;
using System.Diagnostics;
using System.Json;
using Gui;
using Gui.Widget;
using Gui.Component;
using Gui.Designer;
using Game.Scene;

/// ZanIDE part: workspace scaffolding, the New Project template catalog
/// and bodies, explorer tree scanning, tab management and the zanc
/// toolchain (build / run / publish process plumbing).
partial class ZanIDE {
    // ---- workspace / scaffolding ----

    // ---- template catalog ----

    /// Where the shipped template tree lives: <BaseDir>/templates when
    /// published, <BaseDir>/../templates when running from the build tree.
    static string TemplatesDir() {
        string a = ZanIDE.BaseDir() + "/templates";
        if (Directory.Exists(a)) { return a; }
        string b = ZanIDE.BaseDir() + "/../templates";
        if (Directory.Exists(b)) { return b; }
        return "";
    }

    /// Templates found on disk (category dirs -> template dirs, each described
    /// by a template.manifest) plus user templates.
    static List<Tpl> BuildCatalog(string root) {
        List<Tpl> ts = new List<Tpl>();
        ZanIDE.LoadDiskTemplates(ts);
        ZanIDE.LoadCustomTemplates(ts, root);
        return ts;
    }

    /// Scans <templates>/<category>/<template>/template.manifest (also accepts
    /// a template.manifest directly one level down) and appends each template,
    /// sorted by its manifest `order`.
    static void LoadDiskTemplates(List<Tpl> ts) {
        string base_ = ZanIDE.TemplatesDir();
        if (base_.Length == 0) { return; }
        List<Tpl> found = new List<Tpl>();
        List<string> cats = Directory.GetDirectories(base_);
        for (int i = 0; i < cats.Count; i = i + 1) {
            string catDir = base_ + "/" + cats[i];
            if (File.Exists(catDir + "/template.manifest")) {
                ZanIDE.AddDiskTemplate(found, catDir);
            } else {
                List<string> subs = Directory.GetDirectories(catDir);
                for (int j = 0; j < subs.Count; j = j + 1) {
                    ZanIDE.AddDiskTemplate(found, catDir + "/" + subs[j]);
                }
            }
        }
        // Insertion sort by order (catalog stays tiny).
        for (int k = 0; k < found.Count; k = k + 1) {
            int best = k;
            for (int m = k + 1; m < found.Count; m = m + 1) {
                if (found[m].order < found[best].order) { best = m; }
            }
            Tpl tmp = found[k]; found[k] = found[best]; found[best] = tmp;
            ts.Add(found[k]);
        }
    }

    /// Parses one template.manifest into a Tpl (localized name/desc).
    static void AddDiskTemplate(List<Tpl> ts, string dir) {
        string mpath = dir + "/template.manifest";
        if (!File.Exists(mpath)) { return; }
        string m = File.ReadAllText(mpath);
        string nameEn = ZanIDE.ManifestField(m, "name", Path.GetFileName(dir));
        string nameZh = ZanIDE.ManifestField(m, "name.zh", nameEn);
        string descEn = ZanIDE.ManifestField(m, "desc", "");
        string descZh = ZanIDE.ManifestField(m, "desc.zh", descEn);
        string catEn = ZanIDE.ManifestField(m, "category", "Other");
        string catZh = ZanIDE.ManifestField(m, "category.zh", catEn);
        Tpl t = Tpl.Make(
            ZanIDE.T(catEn, catZh),
            ZanIDE.T(nameEn, nameZh),
            ZanIDE.ManifestField(m, "icon", "file"),
            ZanIDE.ManifestField(m, "kind", "copy"),
            ZanIDE.T(descEn, descZh));
        t.src = dir;
        t.ptype = ZanIDE.ManifestField(m, "type", "console");
        t.ptarget = ZanIDE.ManifestField(m, "target", "exe");
        t.pentry = ZanIDE.ManifestField(m, "entry", "src/main.zan");
        t.order = ZanIDE.ParseInt(ZanIDE.ManifestField(m, "order", "1000"));
        // `size=1280x720` is the design size; `sizeable=1` marks the template as
        // creatable at any device size (the wizard then shows the size row and
        // the host rewrites the .zform canvas), `shape=round` a watch face.
        string size = ZanIDE.ManifestField(m, "size", "");
        if (size != "") {
            List<string> wh = size.Split("x");
            if (wh.Count == 2) {
                t.defW = ZanIDE.ParseIntSafe(wh[0]);
                t.defH = ZanIDE.ParseIntSafe(wh[1]);
            }
        }
        t.sizeable = ZanIDE.ManifestField(m, "sizeable", "0") == "1";
        t.round = ZanIDE.ManifestField(m, "shape", "") == "round";
        t.sketch = ZanIDE.ManifestField(m, "sketch", "");
        string prev = ZanIDE.ManifestField(m, "preview", "");
        if (prev != "" && File.Exists(dir + "/" + prev)) {
            t.preview = dir + "/" + prev;
        }
        ts.Add(t);
    }

    /// The distinct categories of a catalog, in first-appearance order.
    static List<string> CatsOf(List<Tpl> ts) {
        List<string> outp = new List<string>();
        for (int i = 0; i < ts.Count; i = i + 1) {
            string c = ts[i].cat;
            bool seen = false;
            for (int j = 0; j < outp.Count; j = j + 1) {
                if (outp[j] == c) { seen = true; }
            }
            if (!seen) { outp.Add(c); }
        }
        return outp;
    }

    /// Projects the catalog into the entity list the wizard consumes.
    static List<WizardTemplate> WizTemplates(List<Tpl> ts) {
        List<WizardTemplate> outp = new List<WizardTemplate>();
        foreach (Tpl t in ts) {
            outp.Add(new WizardTemplate(t.cat, t.name, t.icon, t.desc)
                .Shape(t.sizeable, t.defW, t.defH, t.round)
                .Look(t.preview, t.sketch));
        }
        return outp;
    }

    /// Scans root/.templates/<name>/ and appends each as a "Custom" template.
    /// GetDirectories on a missing directory yields an empty list, so no
    /// separate existence check is needed.
    static void LoadCustomTemplates(List<Tpl> ts, string root) {
        string dir = ZanIDE.UserConfigDir() + "/templates";
        List<string> subs = Directory.GetDirectories(dir);
        for (int i = 0; i < subs.Count; i = i + 1) {
            string tname = subs[i];
            string tdir = dir + "/" + tname;
            string desc = "Custom template.";
            string icon = "file";
            string mpath = tdir + "/template.manifest";
            if (!File.Exists(mpath)) { mpath = tdir + "/manifest.txt"; }
            if (File.Exists(mpath)) {
                string m = File.ReadAllText(mpath);
                desc = ZanIDE.ManifestField(m, "desc", desc);
                icon = ZanIDE.ManifestField(m, "icon", icon);
            }
            Tpl t = Tpl.Make("Custom", tname, icon, "custom", desc);
            t.src = tdir;
            ts.Add(t);
        }
    }

    /// Reads a "key=value" field from a simple manifest, or returns def.
    /// Scans char-by-char (rather than splitting into a list) to stay robust.
    static string ManifestField(string content, string key, string def) {
        string prefix = key + "=";
        int n = content.Length;
        int pl = prefix.Length;
        for (int i = 0; i < n; i = i + 1) {
            bool atLineStart = (i == 0) || (content.Substring(i - 1, 1) == "\n");
            if (atLineStart && i + pl <= n && content.Substring(i, pl) == prefix) {
                int j = i + pl;
                string val = "";
                while (j < n) {
                    string ch = content.Substring(j, 1);
                    if (ch == "\n" || ch == "\r") { break; }
                    val = val + ch;
                    j = j + 1;
                }
                return val;
            }
        }
        return def;
    }

    /// Recursively copies a template's files (skipping its manifest) into dst.
    static void CopyTree(string srcDir, string dstDir) {
        ZanIDE.CopyTreeT(srcDir, dstDir, "");
    }

    /// CopyTree with template-variable substitution: when name is non-empty,
    /// every occurrence of {{NAME}} in file contents becomes the project name.
    static void CopyTreeT(string srcDir, string dstDir, string name) {
        Directory.CreateDirectory(dstDir);
        List<string> files = Directory.GetFiles(srcDir);
        for (int i = 0; i < files.Count; i = i + 1) {
            string fn = files[i];
            if (fn != "manifest.txt" && fn != "template.manifest") {
                string body = File.ReadAllText(srcDir + "/" + fn);
                if (name.Length > 0) {
                    body = ZanIDE.ReplaceAll(body, "{{NAME}}", name);
                }
                File.WriteAllText(dstDir + "/" + fn, body);
            }
        }
        List<string> subs = Directory.GetDirectories(srcDir);
        for (int j = 0; j < subs.Count; j = j + 1) {
            ZanIDE.CopyTreeT(srcDir + "/" + subs[j], dstDir + "/" + subs[j], name);
        }
    }

    /// Replaces every occurrence of pat in s (no overlap handling needed for
    /// template variables).
    static string ReplaceAll(string s, string pat, string rep) {
        if (pat.Length == 0) { return s; }
        StringBuilder sb = new StringBuilder();
        int n = s.Length;
        int pl = pat.Length;
        int i = 0;
        while (i < n) {
            bool hit = false;
            if (i + pl <= n) {
                if (s.Substring(i, pl) == pat) { hit = true; }
            }
            if (hit) { sb.Append(rep); i = i + pl; }
            else { sb.Append(s.Substring(i, 1)); i = i + 1; }
        }
        return sb.ToString();
    }

    /// Saves the current project (its src/ tree + zan.proj) as a reusable custom
    /// template under root/.templates/<tname>/ with a small manifest.
    static void SaveAsTemplate(string root, string cat, string tname, List<string> log) {
        string tdir = ZanIDE.UserConfigDir() + "/templates/" + tname;
        Directory.CreateDirectoryRecursive(tdir);
        if (Directory.Exists(root + "/src")) {
            ZanIDE.CopyTree(root + "/src", tdir + "/src");
        }
        if (File.Exists(root + "/zan.proj")) {
            File.WriteAllText(tdir + "/zan.proj", File.ReadAllText(root + "/zan.proj"));
        }
        File.WriteAllText(tdir + "/template.manifest",
            "name=" + tname + "\ncategory=" + cat + "\nicon=file\nkind=custom\ndesc=Custom template from " + Path.GetFileName(root) + ".\n");
        log.Add("> Saved current project as template '" + tname + "' (" + tdir + ").");
    }

    /// Maps the multi-select platform flags to a comma-separated id list
    /// (e.g. "windows-x64,linux-arm64"); defaults to windows-x64 if none chosen.
    static string PlatformCsv(List<WizardTarget> targets) {
        List<string> ids = new List<string>{
            "windows-x64", "windows-arm64",
            "linux-x64", "linux-arm64",
            "macos-x64", "macos-arm64" };
        string outp = "";
        for (int i = 0; i < targets.Count; i = i + 1) {
            if (i < ids.Count && targets[i].selected == 1) {
                if (outp.Length > 0) { outp = outp + ","; }
                outp = outp + ids[i];
            }
        }
        if (outp.Length == 0) { outp = "windows-x64"; }
        return outp;
    }

    /// True when `name` is usable as a new project's folder/file name:
    /// non-empty, no Windows-reserved characters or path separators (which
    /// would escape the parent directory or crash the scaffolding file calls),
    /// not "." / "..", and not a reserved device name (CON, PRN, NUL, COM1-9,
    /// LPT1-9 -- CreateDirectory fails or aliases hardware on Windows).
    static bool IsValidProjectName(string name) {
        if (name == "") { return false; }
        if (name == "." || name == "..") { return false; }
        string bad = "<>:\"/\\|?*";
        int i = 0;
        for (i = 0; i < name.Length; i = i + 1) {
            string ch = name.Substring(i, 1);
            for (int j = 0; j < bad.Length; j = j + 1) {
                if (bad.Substring(j, 1) == ch) { return false; }
            }
        }
        // Uppercase the name (ASCII only) to compare against Windows device names.
        StringBuilder ub = new StringBuilder();
        i = 0;
        i = 0;
        for (i = 0; i < name.Length; i = i + 1) {
            string ch = name.Substring(i, 1);
            int code = ch[0] & 255;
            if (code < 32 || code == 127) { return false; }   // control chars
            if (code >= 97 && code <= 122) { code = code - 32; }
            ub.Append(Text.CharStr(code));
        }
        string upper = ub.ToString();
        string reserved = " CON PRN AUX NUL COM1 COM2 COM3 COM4 COM5 COM6 COM7 COM8 COM9 LPT1 LPT2 LPT3 LPT4 LPT5 LPT6 LPT7 LPT8 LPT9 ";
        if (ZanIDE.Has(reserved, " " + upper + " ")) { return false; }
        return true;
    }

    /// Scaffolds a new project and, for a `sizeable` template, retargets its
    /// design canvas to the size picked in the wizard (0 = keep the template's
    /// own size). Device size is a parameter of one template, so "phone" and
    /// "desktop" are the same scaffold at a different canvas.
    static string CreateProjectT(Tpl tpl, string parent, string name, string platforms,
                                 int devW, int devH, List<string> log) {
        string dir = ZanIDE.CreateProjectT(tpl, parent, name, platforms, log);
        if (dir == "") { return dir; }
        if (tpl.sizeable && devW >= 40 && devH >= 40) {
            ZanIDE.RetargetForms(dir + "/src", devW, devH, log);
        }
        return dir;
    }

    /// Rewrites the design size of every .zform under `srcDir` and keeps the
    /// absolutely-placed controls inside the new canvas (a 1280x720 layout
    /// pasted onto a 390x844 phone would otherwise leave controls off-screen).
    static void RetargetForms(string srcDir, int devW, int devH, List<string> log) {
        List<string> files = DirectoryTree.Flat(srcDir, PathFilter.Only(".zform"));
        for (int i = 0; i < files.Count; i = i + 1) {
            string fp = files[i];
            FormDoc d = Json.Deserialize<FormDoc>(File.ReadAllText(fp));
            if (d == null || d.fields == null) { continue; }
            if (d.winW == devW && d.winH == devH) { continue; }
            int margin = 16;
            for (int k = 0; k < d.fields.Count; k = k + 1) {
                FormFieldDoc f = d.fields[k];
                if (f.fw > devW - 2 * margin) { f.fw = devW - 2 * margin; }
                if (f.fx + f.fw > devW - margin) { f.fx = devW - margin - f.fw; }
                if (f.fx < margin) { f.fx = margin; }
                if (f.fy + f.fh > devH - margin) { f.fy = devH - margin - f.fh; }
                if (f.fy < margin) { f.fy = margin; }
            }
            d.winW = devW;
            d.winH = devH;
            File.WriteAllText(fp, Json.Serialize<FormDoc>(d));
            log.Add("> Design canvas set to " + Convert.ToString(devW) + "x"
                + Convert.ToString(devH) + ": " + fp);
        }
    }

    /// Scaffolds a new project from a template descriptor; returns its directory.
    /// platforms is a comma-separated target-platform id list written to zan.proj.
    static string CreateProjectT(Tpl tpl, string parent, string name, string platforms, List<string> log) {
        if (!ZanIDE.IsValidProjectName(name)) {
            log.Add(ZanIDE.T("> Cannot create project: invalid name '",
                "> 无法创建项目：名称非法 '") + name + "'.");
            return "";
        }
        string dir = parent + "/" + name;
        try {
        // Scaffolding into an existing non-empty folder would mix template
        // files into unrelated user data, so refuse and return "" (the caller
        // keeps the wizard open).
        if (Directory.Exists(dir)) {
            List<string> exFiles = Directory.GetFiles(dir);
            List<string> exDirs = Directory.GetDirectories(dir);
            if (exFiles.Count > 0 || exDirs.Count > 0) {
                log.Add(ZanIDE.T("> Cannot create project: target folder is not empty: ",
                    "> 无法创建项目：目标文件夹非空：") + dir);
                return "";
            }
        }
        Directory.CreateDirectoryRecursive(dir);

        string typeName = "console";
        string target = "exe";
        string entry = "src/main.zan";
        string kind = tpl.kind;

        if (kind == "custom") {
            ZanIDE.CopyTree(tpl.src, dir);
        } else if (tpl.src.Length > 0) {
            // Disk template: copy its tree with {{NAME}} substituted, and take
            // project type/target/entry from its manifest.
            typeName = tpl.ptype; target = tpl.ptarget; entry = tpl.pentry;
            if (name.Length > 0) {
                entry = ZanIDE.ReplaceAll(entry, "{{NAME}}", name);
            }
            ZanIDE.CopyTreeT(tpl.src, dir, name);
            // For GUI templates, rename App.zan and App.zform to the actual project name
            if (typeName == "gui" && name.Length > 0) {
                if (File.Exists(dir + "/src/App.zan")) {
                    string body = File.ReadAllText(dir + "/src/App.zan");
                    File.WriteAllText(dir + "/src/" + name + ".zan", body);
                    File.Delete(dir + "/src/App.zan");
                }
                if (File.Exists(dir + "/src/App.zform")) {
                    string body = File.ReadAllText(dir + "/src/App.zform");
                    File.WriteAllText(dir + "/src/" + name + ".zform", body);
                    File.Delete(dir + "/src/App.zform");
                }
                // 2-file model: the .zform IS the compiled design source (zanc's
                // formgen projects its typed fields + Main at compile time), so
                // only ensure the business file exists; the form is the entry.
                // Window-app templates WITHOUT a .zform (e.g. WebView, which
                // builds its UI in code) keep the manifest entry (src/main.zan).
                ZanIDE.SyncFormCodeBehinds(dir + "/src");
                if (File.Exists(dir + "/src/" + name + ".zform")) {
                    entry = "src/" + name + ".zform";
                }
            }
        } else {
            typeName = "empty";
        }

        if (!File.Exists(dir + "/README.md")) {
            File.WriteAllText(dir + "/README.md",
                "# " + name + "\n\nGenerated by the Zan IDE (template: " + tpl.name + ").\n");
        }
        // Give every new project the Zan icon by default: copy the shipped
        // zan.ico into <project>/assets and record it in zan.proj (icon =),
        // so the produced exe links it in (see EnsureProjectIconRes).
        string iconRel = "";
        string iconSrc = ZanIDE.ZanIconSource();
        if (iconSrc != "") {
            Directory.CreateDirectory(dir + "/assets");
            File.Copy(iconSrc, dir + "/assets/zan.ico");
            iconRel = "assets/zan.ico";
        }
        if (kind != "custom" && !File.Exists(dir + "/zan.proj")) {
            string projc = "name = " + name + "\ntype = " + typeName + "\nentry = " + entry
                + "\ntarget = " + target + "\nplatform = " + platforms + "\n";
            if (iconRel != "") { projc = projc + "icon = " + iconRel + "\n"; }
            File.WriteAllText(dir + "/zan.proj", projc);
        } else if (kind != "custom" && iconRel != "") {
            // The template shipped its own manifest (so it is a project on
            // disk too, openable and buildable without being instantiated).
            // It cannot name the icon that is only copied here, and the
            // selected platform is not its business either, so both are
            // completed on the copy.
            string projc = File.ReadAllText(dir + "/zan.proj");
            if (ZanIDE.IndexOfStr(projc, "icon =") < 0
                && ZanIDE.IndexOfStr(projc, "icon=") < 0) {
                projc = projc + "icon = " + iconRel + "\n";
            }
            if (ZanIDE.IndexOfStr(projc, "platform") < 0) {
                projc = projc + "platform = " + platforms + "\n";
            }
            File.WriteAllText(dir + "/zan.proj", projc);
        }
        log.Add("> Created " + typeName + " project for [" + platforms + "] at " + dir + " (template: " + tpl.name + ").");
        return dir;
        } catch (Exception e) {
            // Any filesystem failure (permission, read-only volume, path too
            // long, template file locked, ...) used to escape to the main loop
            // and crash the IDE. Surface it in the Output tab and keep the
            // wizard open instead.
            log.Add(ZanIDE.T("> Failed to create project: ",
                "> 创建项目失败：") + e.Message);
            return "";
        }
    }

    /// After a GUI project is scaffolded from a disk template, make sure each
    /// form has its business file (.zan). The .zform itself is the single
    /// source of truth: zanc compiles it directly, so there is no generated
    /// layout file to keep in sync. Scenes follow the same two-file model.
    static void SyncFormCodeBehinds(string srcDir) {
        List<string> files = DirectoryTree.Flat(srcDir,
            PathFilter.Only(".zform .zscene"));
        int i = 0;
        while (i < files.Count) {
            string fp = files[i];
            i = i + 1;
            if (ZanIDE.IsFormPath(fp)) {
                string fbase = ZanIDE.FormBaseName(fp);
                // The business file is created only if absent - never overwritten.
                string cbp = ZanIDE.CodeBehindPath(fp);
                if (!File.Exists(cbp)) {
                    File.WriteAllText(cbp, ZanIDE.GenBusinessShell(fbase));
                }
            } else if (ZanIDE.IsScenePath(fp)) {
                string sbase = ZanIDE.SceneBaseName(fp);
                string scbp = ZanIDE.SceneCodeBehindPath(fp);
                if (!File.Exists(scbp)) {
                    File.WriteAllText(scbp, ZanIDE.GenSceneBusinessShell(sbase));
                }
            }
        }
    }

    // ---- New File kinds ----
    //
    // The wizard list (fileItems), CreateFile's branches and every "is this
    // kind special?" test all index the same catalog, so a kind inserted in
    // the middle used to silently shift the others -- the explorer's "New
    // Folder" command still asked for kind 8 after Free Layout Window took
    // that slot, and created a form instead of a folder. The catalog order
    // is defined here once and read through these names.

    /// New File kind: Lua script (Name.lua).
    static int FileKindLua() { return 5; }

    /// New File kind: Python script (Name.py).
    static int FileKindPython() { return 6; }

    /// New File kind: Form, flow layout (Name.zform + code-behind).
    static int FileKindForm() { return 7; }

    /// New File kind: Free Layout Window, absolute layout (layoutMode 1).
    static int FileKindFreeForm() { return 8; }

    /// New File kind: Game Scene (Name.zscene + code-behind).
    static int FileKindScene() { return 9; }

    /// New File kind: folder under src/.
    static int FileKindFolder() { return 10; }

    /// True for the kinds that declare a Gui/System type named after the
    /// file (the designer kinds), so the wizard must reject a name that
    /// collides with a built-in type.
    static bool FileKindDeclaresType(int kind) {
        return kind == ZanIDE.FileKindForm()
            || kind == ZanIDE.FileKindFreeForm()
            || kind == ZanIDE.FileKindScene();
    }

    /// True when `dir` exists and holds anything at all: scaffolding a project
    /// into it would mix template files into unrelated user data.
    static bool DirHasEntries(string dir) {
        if (!Directory.Exists(dir)) { return false; }
        return Directory.GetFiles(dir).Count > 0
            || Directory.GetDirectories(dir).Count > 0;
    }

    /// The path a New File of `kind` named `name` would occupy, or "" when
    /// nothing of that name exists yet. Creating a file never overwrites what
    /// is already on disk, so the wizard asks first (see CreateFile).
    static string NewFileTaken(int kind, string root, string name) {
        string src = root + "/src/";
        if (kind == ZanIDE.FileKindLua()) {
            if (File.Exists(src + name + ".lua")) { return src + name + ".lua"; }
            return "";
        }
        if (kind == ZanIDE.FileKindPython()) {
            if (File.Exists(src + name + ".py")) { return src + name + ".py"; }
            return "";
        }
        if (kind == ZanIDE.FileKindScene()) {
            if (File.Exists(src + name + ".zscene")) { return src + name + ".zscene"; }
            return "";
        }
        if (kind == ZanIDE.FileKindForm() || kind == ZanIDE.FileKindFreeForm()) {
            if (File.Exists(src + name + ".zform")) { return src + name + ".zform"; }
            return "";
        }
        if (kind == ZanIDE.FileKindFolder()) {
            if (Directory.Exists(src + name)) { return src + name; }
            return "";
        }
        if (File.Exists(src + name + ".zan")) { return src + name + ".zan"; }
        return "";
    }

    /// Creates a file from the chosen file template; returns the path to open.
    /// The kinds match the New File wizard's item order (fileItems): 0-4 code
    /// templates, 5 Lua script, 6 Python script, 7 Form (flow layout,
    /// layoutMode 0), 8 Free Layout Window (free-canvas absolute layout,
    /// layoutMode 1), 9 Game Scene, 10 Folder.
    /// For a Form / Free Layout Window this follows the C#-style rule and
    /// creates BOTH the visual layout file (Name.zform) and its code-behind
    /// (Name.zan), returning the .zform so it opens in the designer.
    /// `sizeSel` indexes the shared device presets (Wizard.SizePresetW/H,
    /// -1 = none); `customW`/`customH` come from the wizard's width/height
    /// inputs and win when valid (>= 40), since preset clicks refill them.
    /// Both apply to the form-producing kinds (Form / Free Layout / Scene).
    static string CreateFile(int kind, string root, string name, int sizeSel,
                             int customW, int customH, List<string> log) {
        int winW = 480;
        int winH = 520;
        List<int> pw = Wizard.SizePresetW();
        List<int> ph = Wizard.SizePresetH();
        bool sized = false;
        if (customW >= 40 && customH >= 40) {
            winW = customW;
            winH = customH;
            sized = sizeSel >= 0 || customW != 480 || customH != 520;
        } else if (sizeSel >= 0 && sizeSel < pw.Count) {
            winW = pw[sizeSel];
            winH = ph[sizeSel];
            sized = true;
        }
        string taken = ZanIDE.NewFileTaken(kind, root, name);
        if (taken != "") {
            log.Add(ZanIDE.T("> Cannot create file: already exists: ",
                "> 无法新建：文件已存在：") + taken);
            return "";
        }
        Directory.CreateDirectory(root + "/src");
        if (kind == ZanIDE.FileKindLua() || kind == ZanIDE.FileKindPython()) {
            // Scripts are not standalone programs: they are data a Zan host
            // loads through System.Scripting, so they live next to the code
            // that loads them and never become a Run/Debug target themselves.
            string ext = ".lua";
            if (kind == ZanIDE.FileKindPython()) { ext = ".py"; }
            string spath = root + "/src/" + name + ext;
            File.WriteAllText(spath, ZanIDE.ScriptTemplateBody(kind, name));
            log.Add("> Created script " + spath
                    + " (load it from Zan, see the header comment).");
            return spath;
        }
        if (kind == ZanIDE.FileKindScene()) {
            // Scenes keep their classic HD default unless a size was chosen.
            int scW = 1280;
            int scH = 720;
            if (sized) { scW = winW; scH = winH; }
            string scenePath = root + "/src/" + name + ".zscene";
            string scbPath = ZanIDE.SceneCodeBehindPath(scenePath);
            SceneDoc sdoc = new SceneDoc(name, scW, scH);
            File.WriteAllText(scenePath, sdoc.ToJson());
            if (!File.Exists(scbPath)) {
                File.WriteAllText(scbPath, ZanIDE.GenSceneBusinessShell(name));
            }
            log.Add("> Created scene " + scenePath + " (+ " + scbPath + ").");
            return scenePath;
        }
        if (kind == ZanIDE.FileKindForm()) {
            string formPath = root + "/src/" + name + ".zform";
            string cbPath = ZanIDE.CodeBehindPath(formPath);
            FormDoc o = new FormDoc();
            o.name = name;
            o.winW = winW;
            o.winH = winH;
            o.winTitle = name;
            o.winCenter = true;
            o.layoutMode = 0;
            o.winZoom = 0;
            o.fields = new List<FormFieldDoc>();
            File.WriteAllText(formPath, Json.Serialize<FormDoc>(o));
            if (!File.Exists(cbPath)) {
                File.WriteAllText(cbPath, ZanIDE.GenBusinessShell(name));
            }
            log.Add("> Created form " + formPath + " (+ " + cbPath + ").");
            return formPath;
        }
        if (kind == ZanIDE.FileKindFreeForm()) {
            // Free-canvas layout window: same 2-file model as a Form, but the
            // design uses layoutMode 1 so every control is absolutely placed on
            // the canvas (the designer's Free mode), with a starter sample that
            // also demonstrates required-field validation and a wrapping hint.
            string formPath = root + "/src/" + name + ".zform";
            string cbPath = ZanIDE.CodeBehindPath(formPath);
            File.WriteAllText(formPath, ZanIDE.FreeFormBody(name, winW, winH));
            if (!File.Exists(cbPath)) {
                File.WriteAllText(cbPath, ZanIDE.GenFreeShell(name));
            }
            log.Add("> Created free-layout form " + formPath + " (+ " + cbPath + ").");
            return formPath;
        }
        if (kind == ZanIDE.FileKindFolder()) {
            string dirPath = root + "/src/" + name;
            Directory.CreateDirectoryRecursive(dirPath);
            log.Add("> Created folder " + dirPath + ".");
            return dirPath;
        }
        string path = root + "/src/" + name + ".zan";
        File.WriteAllText(path, ZanIDE.FileTemplateBody(kind, name));
        log.Add("> Created file " + path + ".");
        return path;
    }

    /// Recursively deletes a file or directory (files first, then the dir).
    /// Used by the explorer's Delete action; missing paths are a no-op.
    static void DeletePathRecursive(string p) {
        if (Directory.Exists(p)) {
            List<string> subs = Directory.GetDirectories(p);
            for (int i = 0; i < subs.Count; i = i + 1) {
                ZanIDE.DeletePathRecursive(p + "/" + subs[i]);
            }
            List<string> files = Directory.GetFiles(p);
            for (int j = 0; j < files.Count; j = j + 1) {
                File.Delete(p + "/" + files[j]);
            }
            Directory.Delete(p);
        } else if (File.Exists(p)) {
            File.Delete(p);
        }
    }

    static void OpenFirst(List<TabRecord> tabs, SignalInt active, string root) {
        string formP = root + "/src/" + Path.GetFileName(root) + ".zform";
        string main = root + "/src/main.zan";
        string lib = root + "/src/lib.zan";
        if (File.Exists(formP)) {
            ZanIDE.OpenPath(tabs, active, formP, Path.GetFileName(formP));
        } else if (File.Exists(main)) {
            ZanIDE.OpenPath(tabs, active, main, "main.zan");
        } else if (File.Exists(lib)) {
            ZanIDE.OpenPath(tabs, active, lib, "lib.zan");
        } else if (File.Exists(root + "/README.md")) {
            ZanIDE.OpenPath(tabs, active, root + "/README.md", "README.md");
        } else {
            // A project without any of the conventional entry files (an older
            // or hand-made layout) must still open: fall back to the first
            // source file under src/, and to no tab at all rather than
            // throwing on a README that was never there -- that exception
            // reached Main and took the whole IDE down at startup.
            string first = ZanIDE.FirstSourceFile(root + "/src");
            if (first == "") { first = ZanIDE.FirstSourceFile(root); }
            if (first != "") {
                ZanIDE.OpenPath(tabs, active, first, Path.GetFileName(first));
            }
        }
    }

    /// The first `.zan` file directly inside `dir` ("" when there is none).
    static string FirstSourceFile(string dir) {
        List<string> fs = DirectoryTree.Flat(dir, PathFilter.Only(".zan"));
        if (fs.Count == 0) { return ""; }
        return fs[0];
    }

    // ---- template bodies ----

    static string FileTemplateBody(int kind, string name) {
        if (kind == 0) {
            return "using System;\n\nclass Program {\n    static void Main() {\n        Console.WriteLine(\"Hello from " + name + "\");\n    }\n}\n";
        }
        if (kind == 1) {
            return "using System;\n\nclass " + name + " {\n    // fields and methods\n}\n";
        }
        if (kind == 2) {
            // A window is a control tree: build it with Form (retained mode),
            // add controls with With()/Add() and Run() it. A bare App.Run()
            // window can only ever be empty, which is a dead end for anyone
            // who just wants to put a button on screen.
            return "using System;\n"
                 + "using Gui;\n"
                 + "using Gui.Widget;\n\n"
                 + "class Program {\n"
                 + "    static void Main() {\n"
                 + "        Form form = Form.CreateDark(\"" + name + "\", 800, 600);\n\n"
                 + "        // Controls go into a container, the container into the\n"
                 + "        // window; Panel.Column() stacks its children top to bottom.\n"
                 + "        Panel root = Panel.Column();\n"
                 + "        root.With(new Label(\"" + name + "\"));\n"
                 + "        Input who = new Input(\"your name\");\n"
                 + "        root.With(who);\n"
                 + "        Button hi = new Button(\"Say hi\");\n"
                 + "        hi.Click += () => {\n"
                 + "            Layer.Notify(\"Hi, \" + who.GetText() + \"!\", 3);\n"
                 + "        };\n"
                 + "        root.With(hi);\n\n"
                 + "        form.Add(root);\n"
                 + "        form.Run();\n"
                 + "    }\n"
                 + "}\n";
        }
        if (kind == 3) {
            return "using System;\n\n/// Contract implemented by concrete types.\nclass " + name + " {\n    void Execute() { }\n}\n";
        }
        return "";
    }

    /// Body of a new Lua (kind 5) / Python (kind 6) script. A script is never
    /// a program on its own -- Zan loads it through System.Scripting -- so the
    /// template opens with the exact host snippet that runs it, and exposes a
    /// single entry function for the host to call.
    static string ScriptTemplateBody(int kind, string name) {
        if (kind == 6) {
            return "# " + name + ".py -- loaded by a Zan host, not run on its own.\n"
                 + "#\n"
                 + "#   using System.Scripting;\n"
                 + "#   Python.Initialize();\n"
                 + "#   Python.RunFile(\"src/" + name + ".py\");\n"
                 + "#   Console.WriteLine(Python.Eval(\"" + name + "_main()\"));\n"
                 + "#\n"
                 + "# The interpreter comes from ZAN_PYTHON_LIB, the runtime bundled\n"
                 + "# next to the executable by zanc, or the system CPython.\n\n"
                 + "def " + name + "_main():\n"
                 + "    return \"hello from " + name + ".py\"\n";
        }
        return "-- " + name + ".lua -- loaded by a Zan host, not run on its own.\n"
             + "--\n"
             + "--   using System.Scripting;\n"
             + "--   Lua.Initialize();\n"
             + "--   Lua.RunFile(\"src/" + name + ".lua\");\n"
             + "--   Console.WriteLine(Lua.CallS(\"" + name + "_main\"));\n"
             + "--\n"
             + "-- The interpreter comes from ZAN_LUA_LIB, the runtime bundled next\n"
             + "-- to the executable by zanc, or the system Lua.\n\n"
             + "function " + name + "_main()\n"
             + "    return \"hello from " + name + ".lua\"\n"
             + "end\n";
    }

    // ---- tree scanning ----

    static List<TreeNode> ScanTree(string root) {
        List<TreeNode> nodes = new List<TreeNode>();
        ZanIDE.ScanInto(
            nodes, root, Path.GetFileName(root), 0, true);
        return nodes;
    }

    /// The filesystem paths of the currently expanded directory nodes, so a
    /// rescan can rebuild the tree without collapsing what the user opened.
    static List<string> ExpandedPaths(List<TreeNode> nodes) {
        List<string> outp = new List<string>();
        for (int i = 0; i < nodes.Count; i = i + 1) {
            TreeNode n = nodes[i];
            if (n.isDir && n.expanded && n.path != "") { outp.Add(n.path); }
        }
        return outp;
    }

    /// Re-expands the directory nodes whose paths were expanded before a
    /// rescan (counterpart of ExpandedPaths).
    static void ApplyExpanded(List<TreeNode> nodes, List<string> exp) {
        for (int i = 0; i < nodes.Count; i = i + 1) {
            TreeNode n = nodes[i];
            if (n.isDir && n.path != "" && exp.Contains(n.path)) {
                n.expanded = true;
            }
        }
    }

    static void ScanInto(List<TreeNode> nodes, string dirPath, string dirName, int depth, bool expanded) {
        // Dot-entries are tooling state, not project content: `.git` alone is
        // thousands of files nobody edits from the IDE, and `.build` holds
        // intermediate compile artifacts (.ll/.o/.zanrun). `.proj` is the
        // manifest the explorer edits through its own UI.
        FileTree.Into(nodes, dirPath, dirName, depth, expanded,
            PathFilter.Any().Hide(".proj").Dots(true, true),
            true, false);
    }

    /// True when `s` ends with `suffix` (used to hide project manifests from
    /// the explorer tree).
    static bool EndsWith(string s, string suffix) {
        int sl = s.Length;
        int fl = suffix.Length;
        if (fl > sl) { return false; }
        return s.Substring(sl - fl, fl) == suffix;
    }

    // ---- tabs ----

    static int FindTabByPath(List<TabRecord> tabs, string path) {
        for (int i = 0; i < tabs.Count; i = i + 1) {
            if (tabs[i].path == path) { return i; }
        }
        return 0 - 1;
    }

    static void OpenPath(List<TabRecord> tabs, SignalInt active,
                         string path, string name) {
        int idx = ZanIDE.FindTabByPath(tabs, path);
        if (idx >= 0) {
            active.Set(idx);
            return;
        }
        // A path that vanished (deleted outside the IDE, a stale entry in a
        // restored session) opens as an empty tab instead of throwing: an
        // unhandled read error here used to reach Main and crash the IDE.
        string content = "";
        if (File.Exists(path)) { content = File.ReadAllText(path); }
        tabs.Add(TabRecord.Create(name, content, path));
        active.Set(tabs.Count - 1);
    }

    static void SaveActive(CodeEditor editor, List<TabRecord> tabs,
                           SignalInt active, string root, List<string> log) {
        int a = active.Get();
        if (a < 0 || a >= tabs.Count) { return; }
        string p = tabs[a].path;
        // Virtual tabs (@start / @docs) have no file behind them; saving one
        // used to write a literal "@start" file into the workspace root.
        if (p == "@start" || p == "@docs") { return; }
        // Design documents (.zform / .zscene) are owned by their designer,
        // which persists them itself. The code editor holds unrelated text
        // while a designer tab is active, so writing it here would replace the
        // design with source and the designer would open empty next time.
        // Run / Build / Publish / Debug all save before compiling, which is
        // exactly when that happened.
        if (ZanIDE.IsFormPath(p) || ZanIDE.IsScenePath(p)) { return; }
        tabs[a].body = editor.GetText();
        if (p == "") {
            p = root + "/" + tabs[a].name;
            tabs[a].path = p;
        }
        File.WriteAllText(p, tabs[a].body);
        log.Add("> Saved " + p + ".");
    }

    /// Saves the .zform code view: writes the in-place code editor to the form's
    /// paired code-behind (.zan). Used instead of SaveActive while a .zform tab is
    /// showing code, so the form JSON is never overwritten with source.
    static void SaveFormCode(CodeEditor ed, string formPath, string root, List<string> log) {
        string cbp = ZanIDE.CodeBehindPath(formPath);
        File.WriteAllText(cbp, ed.GetText());
        log.Add("> Saved " + cbp + ".");
    }

    // ---- toolchain ----

    /// Rows whose label contains the filter (case-insensitive substring);
    /// directories are dropped and matches flattened to depth 0 so every hit
    /// is visible regardless of collapsed ancestors. An empty filter returns
    /// the nodes unchanged.
    static List<TreeNode> FilterNodes(List<TreeNode> nodes, string filter) {
        if (filter == "") { return nodes; }
        string f = ZanIDE.ToLowerS(filter);
        List<TreeNode> outp = new List<TreeNode>();
        for (int i = 0; i < nodes.Count; i = i + 1) {
            TreeNode n = nodes[i];
            if (!n.isDir && ZanIDE.Has(ZanIDE.ToLowerS(n.label), f)) {
                TreeNode m = TreeNode.FileIcon(n.label, 0, n.icon);
                m.path = n.path;
                outp.Add(m);
            }
        }
        return outp;
    }

    /// Resolves the source file Run/Build/Debug/Publish should compile for
    /// the active tab: a .zform compiles directly (zanc's formgen projects its
    /// fields + Main), a form's business .zan routes to its paired .zform, and
    /// the special @start/@docs tabs map to the project entry when one exists.
    /// Returns "" when there is no target.
    static string RunTarget(string p, string root) {
        if (p == "@start" || p == "@docs") {
            string entry = ZanIDE.ProjectEntry(root);
            if (File.Exists(entry)) { return entry; }
            return "";
        }
        if (ZanIDE.IsFormPath(p)) {
            // 2-file model: the .zform is the compiled input; its business
            // file (Name.zan) rides along through SmartInputs.
            return p;
        }
        if (ZanIDE.IsScenePath(p)) {
            // Same 2-file model: the .zscene is the compiled input (zanc's
            // scenegen projects its elements + Main) and its business file
            // rides along through SmartInputs.
            return p;
        }
        // A leftover generated Name.g.zan still routes to the design it came
        // from, which the compiler now projects directly.
        if (ZanIDE.IsGenPath(p)) {
            string gform = p.Substring(0, p.Length - 6) + ".zform";
            if (File.Exists(gform)) { return gform; }
            string gscene = p.Substring(0, p.Length - 6) + ".zscene";
            if (File.Exists(gscene)) { return gscene; }
        }
        // A form's business file (Name.zan) has no Main of its own; compile via
        // its paired .zform, which zanc projects into the window's entry point.
        if (ZanIDE.IsZanFilePath(p) && !ZanIDE.IsGenPath(p)) {
            string form = p.Substring(0, p.Length - 4) + ".zform";
            if (File.Exists(form)) { return form; }
            // Same for a scene's business file: compile via its .zscene.
            string scene = p.Substring(0, p.Length - 4) + ".zscene";
            if (File.Exists(scene)) { return scene; }
        }
        return p;
    }

    /// Run/Build/Debug from the ribbon act on the ACTIVE TAB: the focused code
    /// tab is what gets compiled and run, so a scratch snippet in its own tab
    /// can be tried without touching the project entry. Special tabs
    /// (@start/@docs) map to the project entry via RunTarget, while a designer
    /// tab runs the design it has open (the .zform or .zscene itself, which
    /// zanc compiles directly).
    static string RibbonRunTarget(string activePath, string root) {
        return ZanIDE.RunTarget(activePath, root);
    }

    /// Compiler inputs for Run/Build. Inside a project (a zan.proj at the root or
    /// beside the file) all sibling .zan files are compiled together; a loose
    /// single file is compiled on its own so unrelated scratch files in the same
    /// folder don't clash (e.g. two Main methods).
    static string SmartInputs(string root, string dir, string entry) {
        bool proj = File.Exists(root + "/zan.proj") || File.Exists(dir + "/zan.proj");
        // Every file already on the command line, so the namespace resolution
        // below cannot add one a second time: passing a file twice makes the
        // compiler see every type in it twice (`duplicate type declaration`).
        List<string> have = new List<string>();
        have.Add(entry);
        if (!proj) {
            // A loose file still needs the modules it imports: the examples put
            // their shared library in a sibling folder (examples/game/common,
            // `namespace GameKit`) and every game does `using GameKit;`, so
            // compiling main.zan alone fails on every type it defines.
            string args0 = "\"" + entry + "\"";
            // A loose .zform compiles together with its business half (Name.zan)
            // - OnLoad / registered handlers live there.
            if (ZanIDE.IsFormPath(entry)) {
                string cbp0 = ZanIDE.CodeBehindPath(entry);
                if (File.Exists(cbp0)) { args0 = args0 + " \"" + cbp0 + "\""; have.Add(cbp0); }
            }
            // Same for a loose .zscene and its business half (OnLoad).
            if (ZanIDE.IsScenePath(entry)) {
                string scb0 = ZanIDE.SceneCodeBehindPath(entry);
                if (File.Exists(scb0)) { args0 = args0 + " \"" + scb0 + "\""; have.Add(scb0); }
            }
            return ZanIDE.WithUsedModules(args0, dir, entry, have);
        }
        // Feed the project's other files in for cross-file types, but skip any
        // that declare their own Main: when the focused tab is a runnable
        // snippet, compiling it together with the project entry's Main would
        // fail with a duplicate entry point.
        string args = "\"" + entry + "\"";
        List<string> all = new List<string>();
        ZanIDE.GatherZanFiles(dir, all);
        for (int i = 0; i < all.Count; i = i + 1) {
            string f = all[i];
            if (f != entry && !ZanIDE.FileHasMain(f)) {
                args = args + " \"" + f + "\"";
                have.Add(f);
            }
        }
        return ZanIDE.WithUsedModules(args, dir, entry, have);
    }

    /// Appends the source files that provide the namespaces `entry` imports but
    /// that do not live beside it. Namespaces are looked for by walking up from
    /// the entry's folder and scanning each ancestor's direct files and its
    /// immediate sub-folders (bounded, so this stays cheap on a big tree); a
    /// file matches when it declares `namespace <Name>;`. Resolution is
    /// transitive, so a shared module may import another one. `have` lists the
    /// files already on the command line and is extended in place; a whole-
    /// project build passes all of them, so a namespace served from inside the
    /// project (`src/framework/Cache.zan` for `using ZanWeb;`) is not appended
    /// again.
    static string WithUsedModules(string args, string dir, string entry,
                                  List<string> have) {
        List<string> want = new List<string>();
        ZanIDE.CollectUsings(entry, want);
        if (want.Count == 0) { return args; }
        int guard = 0;
        while (want.Count > 0 && guard < 32) {
            guard = guard + 1;
            string ns = want[0];
            want.RemoveAt(0);
            string found = ZanIDE.FindNamespaceFile(dir, ns, entry, have);
            if (found == "") { continue; }
            have.Add(found);
            args = args + " \"" + found + "\"";
            ZanIDE.CollectUsings(found, want);
        }
        return args;
    }

    /// Namespace names of the `using X;` lines at the top of `path`.
    static void CollectUsings(string path, List<string> outp) {
        if (!File.Exists(path)) { return; }
        List<string> lines = ZanIDE.SplitLinesOf(File.ReadAllText(path));
        for (int i = 0; i < lines.Count; i = i + 1) {
            string ln = lines[i].Trim();
            if (ZanIDE.StartsWith(ln, "using ") && ZanIDE.EndsWithStr(ln, ";")) {
                string ns = ln.Substring(6, ln.Length - 7).Trim();
                if (ns != "" && !outp.Contains(ns)) { outp.Add(ns); }
            }
        }
    }

    /// First file declaring `namespace ns;` near `dir`, or "".
    static string FindNamespaceFile(string dir, string ns, string entry,
                                    List<string> skip) {
        string at = dir;
        for (int up = 0; up < 4; up = up + 1) {
            List<string> cand = new List<string>();
            ZanIDE.ListZanFilesIn(at, cand);
            List<string> subs = DirectoryTree.SubDirs(at,
                PathFilter.Any().Skip("build dist bin obj publish"));
            for (int s = 0; s < subs.Count; s = s + 1) {
                ZanIDE.ListZanFilesIn(subs[s], cand);
            }
            for (int i = 0; i < cand.Count; i = i + 1) {
                string f = cand[i];
                if (f != entry && !skip.Contains(f)
                    && ZanIDE.DeclaresNamespace(f, ns)
                    && !ZanIDE.FileHasMain(f)) {
                    return f;
                }
            }
            string parent = ZanIDE.DirOf(at);
            if (parent == at || parent == ".") { return ""; }
            at = parent;
        }
        return "";
    }

    /// Full paths of the .zan files directly inside `dir` (no recursion).
    static void ListZanFilesIn(string dir, List<string> outp) {
        DirectoryTree.FlatInto(outp, dir, PathFilter.Only(".zan").Dots(true, true));
    }

    /// True when `path` declares `namespace ns;`.
    static bool DeclaresNamespace(string path, string ns) {
        if (!File.Exists(path)) { return false; }
        return ZanIDE.IndexOfStr(File.ReadAllText(path), "namespace " + ns + ";") >= 0;
    }

    static bool EndsWithStr(string s, string suffix) {
        if (s.Length < suffix.Length) { return false; }
        return s.Substring(s.Length - suffix.Length, suffix.Length) == suffix;
    }

    static List<string> SplitLinesOf(string text) {
        List<string> outp = new List<string>();
        string cur = "";
        for (int i = 0; i < text.Length; i = i + 1) {
            string ch = text.Substring(i, 1);
            if (ch == "\n") { outp.Add(cur); cur = ""; }
            else if (ch != "\r") { cur = cur + ch; }
        }
        if (cur != "") { outp.Add(cur); }
        return outp;
    }

    /// True when the file declares a `static ... Main(` entry point.
    static bool FileHasMain(string path) {
        if (!File.Exists(path)) { return false; }
        string s = File.ReadAllText(path);
        int i = ZanIDE.IndexOfStr(s, " Main(");
        while (i >= 0) {
            // Require `static` earlier on the same line so a call like
            // `x.Main()` or a comment does not count.
            int ls = i;
            while (ls > 0 && s.Substring(ls - 1, 1) != "\n") { ls = ls - 1; }
            string line = s.Substring(ls, i - ls);
            if (ZanIDE.IndexOfStr(line, "static ") >= 0) { return true; }
            int nxt = ZanIDE.IndexOfStr(s.Substring(i + 1, s.Length - i - 1), " Main(");
            if (nxt < 0) { return false; }
            i = i + 1 + nxt;
        }
        return false;
    }

    /// First index of `needle` in `hay`, or -1.
    static int IndexOfStr(string hay, string needle) {
        int n = needle.Length;
        int h = hay.Length;
        if (n == 0) { return 0; }
        for (int i = 0; i + n <= h; i = i + 1) {
            if (hay.Substring(i, n) == needle) { return i; }
        }
        return -1;
    }

    /// Last index of `needle` in `hay`, or -1.
    static int LastIndexOfStr(string hay, string needle) {
        int n = needle.Length;
        int h = hay.Length;
        if (n == 0) { return h; }
        for (int i = h - n; i >= 0; i = i - 1) {
            if (hay.Substring(i, n) == needle) { return i; }
        }
        return -1;
    }

    /// Numeric value of a single-character digit string, or -1.
    static int DigitVal(string ch) {
        return ZanIDE.IndexOfStr("0123456789", ch);
    }

    /// Parses a leading run of digits into an int, or -1 when there are none.
    static int ParseLeadInt(string s) {
        int v = 0;
        bool any = false;
        for (int i = 0; i < s.Length; i = i + 1) {
            int d = ZanIDE.DigitVal(s.Substring(i, 1));
            if (d < 0) { break; }
            v = v * 10 + d;
            any = true;
        }
        if (!any) { return -1; }
        return v;
    }

    /// Strips ANSI SGR escape sequences (ESC [ ... m) from compiler output so the
    /// text can be matched and shown cleanly.
    static string StripAnsi(string s) {
        string esc = Text.ByteChar(27);
        string outp = "";
        int i = 0;
        while (i < s.Length) {
            string ch = s.Substring(i, 1);
            if (ch == esc) {
                i = i + 1;
                while (i < s.Length && s.Substring(i, 1) != "m") { i = i + 1; }
                if (i < s.Length) { i = i + 1; }
            } else {
                outp = outp + ch;
                i = i + 1;
            }
        }
        return outp;
    }

    /// Parses compiler output lines of the form `<path>:<line>:<col>: error: <msg>`
    /// that refer to the active file, and pushes them onto the editor as real
    /// diagnostics (red underline + reason tooltip), jumping to the first error.
    static void ApplyDiagnostics(CodeEditor editor, string activePath, List<string> output, List<string> log) {
        List<Diagnostic> diagnostics = new List<Diagnostic>();
        bool isZan = activePath.Length > 4
            && activePath.Substring(activePath.Length - 4, 4) == ".zan";
        if (isZan) {
            string baseName = Path.GetFileName(activePath);
            for (int oi = 0; oi < output.Count; oi = oi + 1) {
                string raw = ZanIDE.StripAnsi(output[oi]);
                int ep = ZanIDE.IndexOfStr(raw, ": error:");
                if (ep > 0) {
                    string loc = raw.Substring(0, ep);
                    if (ZanIDE.IndexOfStr(loc, baseName) >= 0) {
                        int c2 = ZanIDE.LastIndexOfStr(loc, ":");
                        if (c2 > 0) {
                            int c1 = ZanIDE.LastIndexOfStr(loc.Substring(0, c2), ":");
                            if (c1 >= 0) {
                                string lineStr = loc.Substring(c1 + 1, c2 - (c1 + 1));
                                int lineNo = ZanIDE.ParseLeadInt(lineStr);
                                if (lineNo > 0) {
                                    string msg = raw.Substring(ep + 8, raw.Length - (ep + 8));
                                    diagnostics.Add(new Diagnostic(lineNo - 1,
                                        ZanIDE.TrimLeadSpaces(msg)));
                                }
                            }
                        }
                    }
                }
            }
        }
        editor.SetCompilerDiagnostics(diagnostics);
        if (diagnostics.Count > 0) {
            log.Add("> " + Convert.ToString(diagnostics.Count) + " error(s) in this file; jumped to the first.");
        }
    }

    /// Hot reload: rebuild the active file and (re)launch it detached, killing
    /// the previous hot instance so the IDE stays responsive across saves.
    /// <summary>Stops a previously launched run/hot-reload instance so its exe
    /// can be overwritten and relaunched. Fast and fire-and-forget -- the actual
    /// rebuild runs detached (BuildDetach) so the UI thread never blocks on a
    /// compile.</summary>
    static void HotKillRunExe(string exe) {
        string nm = ZanIDE.BaseName(exe);
        #if WINDOWS
        Process.Run("taskkill /F /IM \"" + nm + "\" >nul 2>nul");
        #else
        Process.Run("pkill -f \"" + nm + "\" >/dev/null 2>&1");
        #endif
    }

    /// Naive substring search (the stdlib string type here exposes only
    /// Substring/Length), used to detect platform ids inside zan.proj.
    static bool Has(string hay, string needle) {
        int n = needle.Length;
        int h = hay.Length;
        if (n == 0) { return true; }
        for (int i = 0; i + n <= h; i = i + 1) {
            if (hay.Substring(i, n) == needle) { return true; }
        }
        return false;
    }

    /// The publish targets offered on THIS build host, with the host's own
    /// first. Same-OS publishing is native; Linux (static musl) and macOS
    /// (ld64.lld against the bundled libSystem stub, with the committed Cocoa
    /// driver and the Mach-O async/atomics objects, ad-hoc signed on arm64)
    /// cross from any host with GUI, threads and async all linking. Cross to
    /// Windows is still restricted to the host, so it is only listed there.
    static List<string> PublishTargetIds() {
        List<string> ids = new List<string>();
        #if WINDOWS
        ids.Add("windows-x64"); ids.Add("windows-arm64");
        #endif
        #if MACOS
        ids.Add("macos-arm64"); ids.Add("macos-x64");
        ids.Add("linux-x64"); ids.Add("linux-arm64");
        #else
        ids.Add("linux-x64"); ids.Add("linux-arm64");
        ids.Add("macos-arm64"); ids.Add("macos-x64");
        #endif
        return ids;
    }

    /// The OS-arch id matching the running IDE's own host (its native target),
    /// e.g. "windows-x64" or "macos-arm64". Built from the compile-time OS and
    /// arch macros so it needs no runtime probing.
    static string HostTargetId() {
        string os = "linux";
        #if WINDOWS
        os = "windows";
        #elif MACOS
        os = "macos";
        #endif
        string arch = "x64";
        #if ARM64
        arch = "arm64";
        #endif
        return os + "-" + arch;
    }

    /// Human-readable dialog label for a publish target id.
    static string PublishTargetLabel(string id) {
        if (id == "windows-x64") { return "Windows   x64"; }
        if (id == "windows-arm64") { return "Windows   ARM64"; }
        if (id == "macos-x64") { return "macOS   x64"; }
        if (id == "macos-arm64") { return "macOS   ARM64"; }
        if (id == "linux-x64") { return "Linux   x64  (musl static)"; }
        if (id == "linux-arm64") { return "Linux   ARM64  (musl static)"; }
        return id;
    }

    /// Reads persisted platform selection (parallel to PublishTargetIds) from
    /// zan.proj, defaulting to the first (host-native) target when none match.
    static List<int> ReadProjectPlatforms(string root) {
        List<string> ids = ZanIDE.PublishTargetIds();
        List<int> flags = new List<int>();
        for (int z = 0; z < ids.Count; z = z + 1) { flags.Add(0); }
        string content = "";
        string pj = root + "/zan.proj";
        if (File.Exists(pj)) { content = File.ReadAllText(pj); }
        bool any = false;
        for (int k = 0; k < ids.Count; k = k + 1) {
            if (ZanIDE.Has(content, ids[k])) { flags[k] = 1; any = true; }
        }
        if (!any && ids.Count > 0) { flags[0] = 1; }
        return flags;
    }

    /// Streamed log + done-marker used by the detached (non-blocking) publish.
    static string PubLogPath() { return ZanIDE.WindowCacheDir() + "/publish.log"; }
    static string PubDonePath() { return ZanIDE.WindowCacheDir() + "/publish_done.txt"; }

    /// Streamed log + done-marker for the DETACHED (non-blocking) Run/Build
    /// ribbon actions, so a slow compile (e.g. a many-file GUI app) never
    /// freezes the UI -- same pattern as the publish pipeline.
    static string BuildLogPath() { return ZanIDE.WindowCacheDir() + "/build.log"; }
    static string BuildDonePath() { return ZanIDE.WindowCacheDir() + "/build_done.txt"; }

    /// Working directory for a launched program. Relative paths in a program
    /// (`config/app.json`, an example's `assets/` folder) are resolved against
    /// it, so it has to be the project root the sources sit in -- inheriting the
    /// IDE's own directory instead means the program finds none of its data and
    /// e.g. a game opens as a black window with no textures.
    static string RunCwd(string root, string target, string exe) {
        // Relative paths inside a program (an example's assets/, config/app.json)
        // are written relative to ITS OWN project root, which is not the
        // workspace root when a file is run from outside the workspace (an
        // examples/game/* source while the workspace is a user project), so the
        // same owner the build used decides the working directory (TargetRoot).
        // A `.git` ancestor is deliberately NOT a fallback here: it made a
        // manifest-less example run from the whole repository, where its
        // assets/ do not resolve.
        string troot = ZanIDE.TargetRoot(root, target);
        if (troot != "" && Directory.Exists(troot)) { return troot; }
        string d = ZanIDE.DirOf(target);
        if (d != "" && Directory.Exists(d)) { return d; }
        if (root != "" && Directory.Exists(root)) { return root; }
        return ZanIDE.DirOf(exe);
    }

    static string MissingPackage(List<string> lines) {
        string marker = "ZANPKG_MISSING namespace=";
        for (int i = 0; i < lines.Count; i = i + 1) {
            int at = lines[i].IndexOf(marker);
            if (at >= 0) {
                string ns = lines[i].Substring(at + marker.Length,
                    lines[i].Length - at - marker.Length);
                int end = ns.IndexOf(" ");
                if (end >= 0) { ns = ns.Substring(0, end); }
                ns = ns.Trim();
                // 标准库自带的命名空间（Gui、Gui/Widget、Game/Scene…）不是
                // 缺失的扩展：这种是编译参数/代码的问题，别当成要装扩展。
                if (Directory.Exists(ZanIDE.StdlibDir() + "/" + ns)) { continue; }
                return ZanIDE.ReplaceAll(ns, "/", ".");
            }
        }
        return "";
    }

    /// The project that owns `target`: its nearest ancestor holding a zan.proj,
    /// else the open project when the file lives inside it, else the file's own
    /// directory. Everything derived from a build -- output directory, library
    /// vs. program, subsystem, icon, working directory -- has to key on THIS
    /// root and not on whatever project the IDE happens to have open: running
    /// an example while another project was open put `.zanrun.exe` into that
    /// other project's `.build`, so the example silently launched the other
    /// program and, once it was running and holding the file, the next build
    /// failed to link ("cannot open output file ... Permission denied").
    static string TargetRoot(string root, string target) {
        string owner = ZanIDE.FindProjectRoot(target);
        if (owner != "") { return owner; }
        string dir = ZanIDE.DirOf(target);
        // A manifest-less folder opened as the project keeps its own root, so
        // its files still share one .build; a file from outside it does not.
        if (root != "" && ZanIDE.StartsWith(ZanIDE.NormSlashes(target) + "/",
                                            ZanIDE.NormSlashes(root) + "/")) {
            return root;
        }
        if (dir == "" || dir == ".") { return root; }
        return dir;
    }

    /// Starts a DETACHED Run build of `target` and returns the executable it
    /// will produce, so every caller (Run ribbon, hot reload, the Tools panel)
    /// only has to record the poll state. The stale exe is removed first so a
    /// failed compile cannot look like a successful one.
    static string RunBuildBegin(string root, string target) {
        string troot = ZanIDE.TargetRoot(root, target);
        string bd = ZanIDE.EnsureBuildDir(troot);
        string exe = bd + "/.zanrun" + ZanIDE.ExeSuffix();
        if (ZanIDE.IsLibraryProject(troot)) {
            // Library project: build the platform's shared library (zanc picks
            // library output from the -o extension) instead of a runnable exe.
            string baseName = Path.GetFileName(troot);
            if (baseName == "") { baseName = "lib"; }
            exe = bd + "/" + baseName + ZanIDE.HostLibExt();
        }
        if (File.Exists(exe)) { File.Delete(exe); }
        string inputs = ZanIDE.InputsArg(bd, ".zanrun_inputs",
            ZanIDE.SmartInputs(troot, ZanIDE.DirOf(target), target));
        ZanIDE.BuildDetach(
            ZanIDE.CompileToExe(troot, target, inputs, bd + "/.zanrun.ll", exe, false, false),
            bd);
        return exe;
    }

    /// Where the compiler-produced symbol index for `root` lives.
    static string SymbolIndexPath(string root) {
        return ZanIDE.EnsureBuildDir(root) + "/symbols.idx";
    }

    /// The project's manifest-declared entry source (zan.proj `entry`), as an
    /// absolute path. Window-app templates keep a .zform entry (never
    /// src/main.zan), so the hardcoded main.zan fallback only applies to
    /// projects that do not declare one. A `Name.g.zan` entry is a leftover
    /// from the pre-formgen IDE: the design document is the single source (the
    /// compiler synthesises the partial class at build time, see formgen.h /
    /// scenegen.h), so it is mapped back to the .zform or .zscene when that
    /// file exists.
    static string ProjectEntryPath(string root) {
        string entry = "src/main.zan";
        string mpath = root + "/zan.proj";
        if (File.Exists(mpath)) {
            entry = ZanIDE.ManifestField(File.ReadAllText(mpath), "entry", entry);
        }
        string full = root + "/" + entry;
        if (ZanIDE.IsGenPath(full)) {
            string form = full.Substring(0, full.Length - 6) + ".zform";
            if (File.Exists(form)) { return form; }
            string scene = full.Substring(0, full.Length - 6) + ".zscene";
            if (File.Exists(scene)) { return scene; }
        }
        if (!File.Exists(full)) { full = root + "/src/main.zan"; }
        return full;
    }

    /// Regenerates the symbol index in the background: `zanc --emit-symbols`
    /// parses the project plus the standard library and writes every type and
    /// member it found. Completion reads that instead of guessing, so it stops
    /// offering members the compiler does not have. Runs detached (it never
    /// blocks the UI) and via its own marker file, so it cannot disturb an
    /// in-flight build's log. The index is only installed when the compiler
    /// exits successfully (`&&`), so a parse failure never replaces a good
    /// index with a partial one.
    static void EmitSymbolsDetach(string root, string target) {
        string idx = ZanIDE.SymbolIndexPath(root);
        string tmp = idx + ".tmp";
        string inputs = ZanIDE.InputsArg(ZanIDE.EnsureBuildDir(root), ".symbols_inputs",
            ZanIDE.SmartInputs(root, ZanIDE.DirOf(target), target));
        string cmd = ZanIDE.ZancCmd() + " --emit-symbols \"" + tmp + "\" " + inputs
            + " --auto-stdlib";
        #if WINDOWS
        string sep = " && ";
        // cmd's built-in `move` rejects forward-slash paths (unlike zanc,
        // which uses the C runtime), so flip the separators for the install.
        string mvSrc = ZanIDE.ReplaceAll(tmp, "/", "\\");
        string mvDst = ZanIDE.ReplaceAll(idx, "/", "\\");
        string mv = "move /y \"" + mvSrc + "\" \"" + mvDst + "\"";
        #else
        string sep = " && ";
        string mv = "mv -f \"" + tmp + "\" \"" + idx + "\"";
        #endif
        // Log the exact command first so a failure is diagnosable from the
        // index log (it also marks the run start).
        File.WriteAllText(idx + ".log", "CMD: " + cmd + "\n");
        Process.RunDetached("((" + cmd + ") >> \"" + idx + ".log\" 2>&1)" + sep + mv
            + " >> \"" + idx + ".log\" 2>&1");
    }

    /// Loads the symbol index for `root` into the editor's completion engine.
    /// False when it has not been generated yet, in which case completion
    /// falls back to its built-in tables.
    static bool LoadSymbolIndexFor(string root) {
        return CodeEditor.LoadSymbolIndex(ZanIDE.SymbolIndexPath(root));
    }

    /// Adopts the symbol index of the project that just became the open one.
    ///
    /// Member completion answers from this index, and only from it for anything
    /// outside its small built-in tables. Startup did this, but opening or
    /// creating a project afterwards did not: the index of the *previous*
    /// project stayed loaded (or none was), so every receiver fell through to
    /// the four universal members and `app.` / `WebApp.` looked like completion
    /// was dead. Loading whatever is on disk is instant; the refresh behind it
    /// lands through the main loop's index poll.
    void AdoptSymbolIndex() {
        // The language server indexes the one workspace root it was started
        // with, and this window started it for the project open at the time:
        // keeping it would answer every definition and reference from the
        // project just left. Drop it and let the next navigation start one.
        if (lspSess != null) { lspSess.Shutdown(); }
        lspSess = null;
        lspTried = false;
        ZanIDE.InvalidateNavFiles();
        CodeEditor.ClearSymbolIndex();
        symbolIdxStamp = 0;
        symbolEmitMs = 0;
        if (!haveProject) { return; }
        string idxP = ZanIDE.SymbolIndexPath(root);
        if (ZanIDE.LoadSymbolIndexFor(root) && File.Exists(idxP)) {
            symbolIdxStamp = FileInfo.GetLastWriteTime(idxP);
        }
        this.RefreshSymbolIndex(true);
    }

    /// Regenerates the index in the background. The compiler writes it from the
    /// code as it was when it ran, so a type reached through a `using` added
    /// since is invisible to completion until it runs again -- saving is that
    /// moment, throttled so a burst of saves is a single run.
    void RefreshSymbolIndex(bool force) {
        if (!haveProject) { return; }
        // Always the project's own entry, never the active tab: Run/Build act on
        // the focused tab, which can be a file from outside the project (the
        // Tools tree), and indexing that wrote its symbols over the project's --
        // leaving every project type unknown to completion.
        string entry = ZanIDE.ProjectEntryPath(root);
        if (!File.Exists(entry)) { return; }
        int now = Window.GetTickMs();
        if (!force && symbolEmitMs != 0 && now - symbolEmitMs < 15000) { return; }
        symbolEmitMs = now;
        // A file may have been added since the last jump searched the tree.
        ZanIDE.InvalidateNavFiles();
        ZanIDE.EmitSymbolsDetach(root, entry);
    }

    /// Runs `cmd` detached, teeing its output into BuildLogPath and dropping
    /// BuildDonePath on completion. The main loop polls both to stream compiler
    /// output and, once done, apply diagnostics + launch the built program.
    static void BuildDetach(string cmd, string bd) {
        ZanIDE.EnsureCacheDir();
        File.WriteAllText(ZanIDE.BuildLogPath(), "");
        if (File.Exists(ZanIDE.BuildDonePath())) { File.Delete(ZanIDE.BuildDonePath()); }
        List<string> steps = new List<string>();
        steps.Add(cmd);
        ZanIDE.ScriptSeqDetach(steps, ZanIDE.BuildLogPath(), ZanIDE.BuildDonePath(),
                               bd, "zanbuild");
    }

    /// Runs `steps` detached, one command per script line, teeing all output
    /// into `logPath` and writing the combined exit status ("ok" / "fail") to
    /// `donePath`. Every step runs even if an earlier one fails, matching the
    /// previous `&`-chained behaviour, but a failure is now REPORTED instead of
    /// being inferred from which outputs happen to exist.
    ///
    /// A script (rather than one long command line) is what makes a many-target
    /// publish work at all: a command line above the shell's limit -- 8191
    /// characters for cmd.exe -- is not run, and since the redirection is part
    /// of that same line the failure leaves no log and no marker, which is
    /// exactly how a publish came to hang on "Publishing ..." forever.
    static void ScriptSeqDetach(List<string> steps, string logPath, string donePath,
                                string bd, string name) {
        StringBuilder sb = new StringBuilder();
        #if WINDOWS
        sb.Append("@echo off\r\nset ZANFAIL=0\r\n");
        for (int i = 0; i < steps.Count; i = i + 1) {
            sb.Append("(" + steps[i] + ") >> \"" + logPath + "\" 2>&1\r\n");
            sb.Append("if errorlevel 1 set ZANFAIL=1\r\n");
        }
        sb.Append("if \"%ZANFAIL%\"==\"0\" (echo ok> \"" + donePath + "\") "
            + "else (echo fail> \"" + donePath + "\")\r\n");
        string path = bd + "/" + name + ".cmd";
        File.WriteAllText(path, sb.ToString());
        int rc = Process.RunDetached("cmd /c \"" + ZanIDE.ToWinPath(path) + "\"");
        // A shell that never started writes neither log nor marker, and the
        // caller would poll for a result that can never arrive: report the
        // failure through the same marker the poll already reads.
        if (rc != 0) { File.WriteAllText(donePath, "fail"); }
        #else
        sb.Append("#!/bin/sh\nfail=0\n");
        for (int i = 0; i < steps.Count; i = i + 1) {
            sb.Append("(" + steps[i] + ") >> \"" + logPath + "\" 2>&1 || fail=1\n");
        }
        sb.Append("if [ $fail -eq 0 ] ; then echo ok > \"" + donePath + "\" ;"
            + " else echo fail > \"" + donePath + "\" ; fi\n");
        string path = bd + "/" + name + ".sh";
        File.WriteAllText(path, sb.ToString());
        int rc = Process.RunDetached("sh \"" + path + "\"");
        if (rc != 0) { File.WriteAllText(donePath, "fail"); }
        #endif
    }

    /// True when the finished detached command reported success. An unreadable
    /// or empty marker counts as failure: a build whose status we cannot see is
    /// not one to launch.
    static bool DoneOk(string donePath) {
        if (!File.Exists(donePath)) { return false; }
        string st = File.ReadAllText(donePath).Trim();
        return st == "ok";
    }

    /// Appends new complete lines of the detached build's log to the Output tab.
    static int BuildPoll(int consumed, List<string> log) {
        return ZanIDE.PollLogFile(ZanIDE.BuildLogPath(), consumed, log);
    }

    /// True when the shipped single-file packer is available: the self-extract
    /// launcher stub plus the pack script, both living in toolchain\ (put there
    /// by scripts/publish_ide.ps1). With them, Windows publishes become ONE exe
    /// carrying its resources; without them (e.g. a dev build tree) the publish
    /// falls back to a plain exe + loose assets.
    static bool CanPackSingle() {
        return File.Exists(ZanIDE.ToolchainDir() + "/pkg_stub.exe")
            && File.Exists(ZanIDE.ToolchainDir() + "/pack_single.ps1");
    }

    /// Fresh (emptied and recreated) staging directory for single-file packing.
    static string ResetStage(string dir) {
        if (Directory.Exists(dir)) { AssetManager.deleteTree(dir); }
        Directory.CreateDirectoryRecursive(dir);
        return dir;
    }

    /// The packer invocation appended after a Windows publish compile: wraps
    /// the staged exe + resources into one self-extracting exe at `outExe`.
    static string PackCmd(string root, string stage, string outExe) {
        string cmd = "powershell -NoProfile -ExecutionPolicy Bypass -File \""
            + ZanIDE.ToolchainDir() + "/pack_single.ps1\""
            + " -Stage \"" + stage + "\" -Stub \"" + ZanIDE.ToolchainDir() + "/pkg_stub.exe\""
            + " -Out \"" + outExe + "\"";
        // The launcher stub is a prebuilt exe, so its icon is stamped by the
        // packer; use the very icon the payload exe was built with.
        string ico = ZanIDE.IconFile(root);
        if (ico != "") { cmd = cmd + " -Icon \"" + ico + "\""; }
        return cmd;
    }

    /// Starts publishing the selected targets in a DETACHED shell so the UI
    /// stays responsive while the (possibly slow) compiles run: compiler
    /// output streams into PubLogPath and PubDonePath marks completion (the
    /// main loop polls both, same pattern as the AI request). Returns the exe
    /// paths the caller must verify once the done-marker appears; an empty
    /// list means nothing was started.
    static List<string> PublishPlatformsBegin(List<TabRecord> tabs, SignalInt active, string root, List<int> sel, List<string> log) {
        List<string> exes = new List<string>();
        int a = active.Get();
        if (a < 0 || a >= tabs.Count) { log.Add("> Nothing to publish."); return exes; }
        // Publish always targets the whole project (its entry + every project
        // .zan file), not whichever tab happens to be focused.
        string p = ZanIDE.RibbonRunTarget(tabs[a].path, root);
        if (p == "") { log.Add("> Nothing to publish (save the file first)."); return exes; }
        Directory.CreateDirectory(root + "/publish");
        string bd = ZanIDE.EnsureBuildDir(root);
        string zc = ZanIDE.ZancCmd();
        // One response file for every target's compile: a publish chains
        // several whole-project commands, so inline inputs blow past the
        // shell's command-line limit and nothing runs (the publish then hung
        // forever on "Publishing ..." with an empty log).
        string inputs = ZanIDE.InputsArg(bd, ".zanpub_inputs",
            ZanIDE.ProjectInputs(ZanIDE.DirOf(p), p, ""));
        string baseName = Path.GetFileName(root);
        List<string> steps = new List<string>();
        bool isLib = ZanIDE.IsLibraryProject(root);
        bool wantPack = ZanIDE.ProjSingleFile(root) && !isLib;
        bool pack = ZanIDE.CanPackSingle() && wantPack;
        // Release (--publish, optimize + strip) vs Debug (-g, DWARF + -O0,
        // runtime checks kept so published-build crashes resolve to .zan:line).
        // The choice lives in zan.proj (toggled in the Publish window) and is
        // threaded into every target's compile command below.
        bool dbg = ZanIDE.ProjPublishDebug(root);
        string pubFlag = " --publish";
        if (dbg) { pubFlag = " -g"; }
        if (dbg) {
            log.Add(ZanIDE.T(
                "> Publish mode: Debug (-g, source locations, runtime checks kept).",
                "> 发布模式：Debug（-g，保留源码位置与运行时检查）。"));
        } else {
            log.Add(ZanIDE.T(
                "> Publish mode: Release (--publish, optimized + stripped).",
                "> 发布模式：Release（--publish，优化并去除调试信息）。"));
        }
        // Silently falling back to loose DLLs is what makes "I checked
        // single-file and still got DLLs" look like a bug, so say why.
        if (isLib) {
            log.Add(ZanIDE.T("> Library project: publishing shared libraries.",
                             "> 库项目：发布为共享库。"));
        } else if (wantPack && !pack) {
            log.Add(ZanIDE.T(
                "> Single-file packing unavailable (no pkg_stub.exe / pack_single.ps1 in "
                    + ZanIDE.ToolchainDir() + "); publishing loose files.",
                "> 单文件打包不可用（" + ZanIDE.ToolchainDir()
                    + " 下缺 pkg_stub.exe / pack_single.ps1），改为普通发布。"));
        } else if (!wantPack) {
            log.Add(ZanIDE.T("> Single-file packing is off for this project.",
                             "> 本项目未启用单文件打包。"));
        }
        // Host-aware target set (see PublishTargetIds); sel is parallel to it.
        // Each id maps to zanc's supported path for this host: native for the
        // host OS, self-contained musl-static for Linux, --target cross for the
        // remaining arch.
        List<string> ids = ZanIDE.PublishTargetIds();
        string hostId = ZanIDE.HostTargetId();
        for (int ti = 0; ti < ids.Count; ti = ti + 1) {
            if (ti < sel.Count && sel[ti] == 1) {
                string id = ids[ti];
                // One directory per target: a publish drops driver DLLs /
                // dylibs and resources next to its executable, so sharing a
                // directory would mix incompatible binaries of the same name.
                string outDir = ZanIDE.PublishDir(root, id);
                if (isLib) {
                    // Library project: one shared library per target, named
                    // with the platform's extension (.dll/.so/.dylib). zanc
                    // picks the library format from the -o extension; cross
                    // targets go through its bundled toolchain.
                    string lib = outDir + "/" + baseName + "-" + id + ZanIDE.LibExtFor(id);
                    string ct = "";
                    if (id != hostId) {
                        ct = id;
                        if (id == "windows-arm64") { ct = "win-arm64"; }
                        if (id == "linux-x64") { ct = "linux-musl"; }
                        ct = " --target " + ct;
                    }
                    steps.Add(zc + pubFlag + ct + " " + inputs
                        + " -o \"" + lib + "\"");
                    exes.Add(lib);
                    log.Add("> Publishing " + id + " library ...");
                    // Optional static archive next to the shared library
                    // (zan.proj `staticLib = true`; zanc picks the archive
                    // format from the .a / .lib output extension).
                    if (ZanIDE.ProjStaticLib(root)) {
                        string slib = outDir + "/" + baseName + "-" + id
                            + ZanIDE.StaticLibExtFor(id);
                        steps.Add(zc + pubFlag + ct + " "
                            + inputs + " -o \"" + slib + "\"");
                        exes.Add(slib);
                        log.Add("> Publishing " + id + " static library ...");
                    }
                } else if (id == "windows-x64") {
                    string exe = outDir + "/" + baseName + "-windows-x64.exe";
                    string ll = bd + "/.zanpub_x64.ll";
                    if (pack) {
                        // Compile into a staging dir (zanc drops any driver DLLs
                        // next to the exe there), add the project resources, then
                        // wrap the whole stage into one self-extracting exe.
                        string stage = ZanIDE.ResetStage(bd + "/pub_win_x64");
                        string sexe = stage + "/" + baseName + "-windows-x64.exe";
                        ZanIDE.CopyResources(root, stage, log);
                        ZanIDE.CopyThemeSkins(root, stage, log);
                        steps.Add(ZanIDE.CompileToExe(root, p, inputs, ll, sexe, !dbg, dbg)
                            + " && " + ZanIDE.PackCmd(root, stage, exe));
                    } else {
                        steps.Add(ZanIDE.CompileToExe(root, p, inputs, ll, exe, !dbg, dbg));
                    }
                    exes.Add(exe);
                    log.Add("> Publishing windows-x64 ...");
                } else if (id == "windows-arm64") {
                    string exe = outDir + "/" + baseName + "-windows-arm64.exe";
                    // Cross-compile ARM64 through zanc's bundled toolchain
                    // (win-arm64 target) -- no external clang needed.
                    if (pack) {
                        string stage = ZanIDE.ResetStage(bd + "/pub_win_arm64");
                        string sexe = stage + "/" + baseName + "-windows-arm64.exe";
                        ZanIDE.CopyResources(root, stage, log);
                        ZanIDE.CopyThemeSkins(root, stage, log);
                        steps.Add(ZanIDE.CompileToExeCross(root, p, inputs, sexe, "win-arm64", dbg)
                            + " && " + ZanIDE.PackCmd(root, stage, exe));
                    } else {
                        steps.Add(ZanIDE.CompileToExeCross(root, p, inputs, exe, "win-arm64", dbg));
                    }
                    exes.Add(exe);
                    log.Add("> Publishing windows-arm64 ...");
                } else if (id == "macos-x64" || id == "macos-arm64") {
                    // macOS: the host's own arch builds natively; every other
                    // host cross-links a Mach-O through zanc's own toolchain
                    // (ld64.lld, the bundled libSystem stub and the committed
                    // Cocoa driver). Either way the output is a bare Mach-O, so
                    // there is no single-file pack step.
                    string exe = outDir + "/" + baseName + "-" + id;
                    if (id == hostId) {
                        steps.Add(ZanIDE.CompileToExe(root, p, inputs, "", exe, !dbg, dbg));
                    } else {
                        steps.Add(ZanIDE.CompileToExeCross(root, p, inputs, exe, id, dbg));
                    }
                    exes.Add(exe);
                    log.Add("> Publishing " + id + " ...");
                } else if (id == "linux-x64") {
                    // Self-contained musl static single file (cross from any host).
                    string exe = outDir + "/" + baseName + "-linux-x64";
                    steps.Add(zc + pubFlag + " " + inputs
                        + " --target linux-musl --link-mode static -o \"" + exe + "\"");
                    exes.Add(exe);
                    log.Add("> Publishing linux-x64 ...");
                } else if (id == "linux-arm64") {
                    // Same musl static path as linux-x64; only triple/sysroot differ.
                    string exe = outDir + "/" + baseName + "-linux-arm64";
                    steps.Add(zc + pubFlag + " " + inputs
                        + " --target linux-arm64 --link-mode static -o \"" + exe + "\"");
                    exes.Add(exe);
                    log.Add("> Publishing linux-arm64 ...");
                }
            }
        }
        if (steps.Count == 0) {
            log.Add("> No target selected; nothing published.");
            return exes;
        }
        // Stale outputs would make a failed compile look successful, so drop
        // them before the detached run starts.
        for (int di = 0; di < exes.Count; di = di + 1) {
            if (File.Exists(exes[di])) { File.Delete(exes[di]); }
        }
        ZanIDE.EnsureCacheDir();
        File.WriteAllText(ZanIDE.PubLogPath(), "");
        if (File.Exists(ZanIDE.PubDonePath())) { File.Delete(ZanIDE.PubDonePath()); }
        // One script line per target: even with response files for the inputs,
        // chaining every target into a single command line adds up, and a
        // truncated command line fails silently (no log, no marker, a publish
        // that never finishes).
        ZanIDE.ScriptSeqDetach(steps, ZanIDE.PubLogPath(), ZanIDE.PubDonePath(),
                               bd, "zanpub");
        return exes;
    }

    /// Appends any new complete lines of the detached publish's streamed log
    /// to the Output tab; returns the new consumed length (same contract as
    /// TermPoll).
    static int PubPoll(int consumed, List<string> log) {
        return ZanIDE.PollLogFile(ZanIDE.PubLogPath(), consumed, log);
    }

    /// The project's assets directory, where the app icon and bundled static
    /// resources (text, images, data files) live.
    static string AssetsDir(string root) { return root + "/assets"; }

    /// Classifies a resource by extension: 0 image, 1 audio, 2 font, 3 data, 4 other.
    static int ResType(string nm) {
        string lo = SceneDesigner.AsciiLower(nm);
        if (ZanIDE.EndsWith(lo, ".png") || ZanIDE.EndsWith(lo, ".jpg")
            || ZanIDE.EndsWith(lo, ".jpeg") || ZanIDE.EndsWith(lo, ".bmp")
            || ZanIDE.EndsWith(lo, ".gif") || ZanIDE.EndsWith(lo, ".tga")
            || ZanIDE.EndsWith(lo, ".ico")) { return 0; }
        if (ZanIDE.EndsWith(lo, ".wav") || ZanIDE.EndsWith(lo, ".mp3")
            || ZanIDE.EndsWith(lo, ".ogg") || ZanIDE.EndsWith(lo, ".flac")
            || ZanIDE.EndsWith(lo, ".mid")) { return 1; }
        if (ZanIDE.EndsWith(lo, ".ttf") || ZanIDE.EndsWith(lo, ".otf")
            || ZanIDE.EndsWith(lo, ".fnt")) { return 2; }
        if (ZanIDE.EndsWith(lo, ".json") || ZanIDE.EndsWith(lo, ".txt")
            || ZanIDE.EndsWith(lo, ".xml") || ZanIDE.EndsWith(lo, ".csv")
            || ZanIDE.EndsWith(lo, ".ini") || ZanIDE.EndsWith(lo, ".zscene")) { return 3; }
        return 4;
    }

    static string ResTypeLabel(int ty) {
        if (ty == 0) { return ZanIDE.T("IMG", "图片"); }
        if (ty == 1) { return ZanIDE.T("AUD", "音频"); }
        if (ty == 2) { return ZanIDE.T("FONT", "字体"); }
        if (ty == 3) { return ZanIDE.T("DATA", "数据"); }
        return ZanIDE.T("MISC", "其它");
    }

    static int ResTypeColor(Theme t, int ty) {
        if (ty == 0) { return t.success; }
        if (ty == 1) { return t.info; }
        if (ty == 2) { return t.warning; }
        if (ty == 3) { return t.primary; }
        return t.textTertiary;
    }

    /// Linked (referenced-in-place) resources: `link = <path>` lines in zan.proj.
    static List<string> ProjLinks(string root) {
        List<string> outp = new List<string>();
        string proj = root + "/zan.proj";
        if (!File.Exists(proj)) { return outp; }
        List<string> ls = CodeEditor.SplitLines(File.ReadAllText(proj));
        for (int i = 0; i < ls.Count; i = i + 1) {
            string tr = ZanIDE.TrimLeadSpaces(ls[i]);
            if (tr.Length > 5 && tr.Substring(0, 5) == "link ") {
                string rest = ZanIDE.TrimLeadSpaces(tr.Substring(5, tr.Length - 5));
                if (rest.Length > 1 && rest.Substring(0, 1) == "=") {
                    string val = ZanIDE.TrimLeadSpaces(rest.Substring(1, rest.Length - 1));
                    int e = val.Length;
                    while (e > 0) {
                        string ch = val.Substring(e - 1, 1);
                        if (ch == " " || ch == "\t" || ch == "\r") { e = e - 1; }
                        else { break; }
                    }
                    if (e > 0) { outp.Add(val.Substring(0, e)); }
                }
            }
        }
        return outp;
    }

    static void AddProjLink(string root, string path) {
        string proj = root + "/zan.proj";
        string content = "";
        if (File.Exists(proj)) { content = File.ReadAllText(proj); }
        if (content.Length > 0 && content.Substring(content.Length - 1, 1) != "\n") {
            content = content + "\n";
        }
        File.WriteAllText(proj, content + "link = " + path + "\n");
    }

    static void RemoveProjLink(string root, string path) {
        string proj = root + "/zan.proj";
        if (!File.Exists(proj)) { return; }
        List<string> ls = CodeEditor.SplitLines(File.ReadAllText(proj));
        string outp = "";
        for (int i = 0; i < ls.Count; i = i + 1) {
            string tr = ZanIDE.TrimLeadSpaces(ls[i]);
            bool drop = false;
            if (tr.Length > 5 && tr.Substring(0, 5) == "link ") {
                if (ZanIDE.ContainsS(tr, path)) { drop = true; }
            }
            if (!drop && tr.Length > 0) { outp = outp + ls[i] + "\n"; }
        }
        File.WriteAllText(proj, outp);
    }

    /// Lists bundled static resources (everything in assets/ except the app icon).
    static List<string> ListResources(string root) {
        List<string> outp = new List<string>();
        List<string> files = DirectoryTree.Names(ZanIDE.AssetsDir(root),
            PathFilter.Any().Dots(false, false));
        for (int i = 0; i < files.Count; i = i + 1) {
            if (files[i] != "app.ico") { outp.Add(files[i]); }
        }
        return outp;
    }

    /// The (created) output directory of one publish target, e.g.
    /// `<root>/publish/macos-arm64`.
    static string PublishDir(string root, string id) {
        string dir = root + "/publish/" + id;
        Directory.CreateDirectoryRecursive(dir);
        return dir;
    }

    /// Copies the project's bundled resources (assets/, minus app.ico) into an
    /// output directory, so a published program ships with its static files.
    static void CopyResources(string root, string outDir, List<string> log) {
        List<string> res = ZanIDE.ListResources(root);
        List<string> lnks = ZanIDE.ProjLinks(root);
        if (res.Count == 0 && lnks.Count == 0) { return; }
        // Opted-in projects ship one encrypted assets.zrp instead of loose
        // files (toggle in the Asset Manager; opened via generated AssetPack).
        if (AssetManager.PackEnabled(root)) {
            int packed = AssetManager.PackAssets(root, outDir, lnks, log);
            if (packed >= 0) {
                log.Add("> Packed " + Convert.ToString(packed)
                    + " resource file(s) into " + outDir + "/assets/assets.zrp");
                return;
            }
            log.Add("> Falling back to plain resource copy.");
        }
        string dst = outDir + "/assets";
        Directory.CreateDirectoryRecursive(dst);
        string ad = ZanIDE.AssetsDir(root);
        for (int i = 0; i < res.Count; i = i + 1) {
            File.Copy(ad + "/" + res[i], dst + "/" + res[i]);
        }
        // Asset subfolders (from the Asset Manager) ship recursively too.
        List<string> subs = Directory.GetDirectories(ad);
        int scopied = 0;
        for (int si = 0; si < subs.Count; si = si + 1) {
            scopied = scopied + AssetManager.copyTree(ad + "/" + subs[si], dst + "/" + subs[si]);
        }
        // Linked resources are referenced in place during development and
        // copied next to the exe only when publishing.
        int lcopied = 0;
        for (int li = 0; li < lnks.Count; li = li + 1) {
            if (File.Exists(lnks[li])) {
                File.Copy(lnks[li], dst + "/" + Path.GetFileName(lnks[li]));
                lcopied = lcopied + 1;
            } else {
                log.Add("> WARNING: linked resource missing: " + lnks[li]);
            }
        }
        log.Add("> Bundled " + Convert.ToString(res.Count + scopied + lcopied) + " resource file(s) into " + dst);
    }

    /// Copies the project's selected theme skins into <outDir>/skins so a
    /// published GUI app can switch skins at runtime -- the skin loader finds a
    /// skins\ folder next to the exe (Skin.FindDir's disk fallback). A no-op
    /// when skin packaging is off, so the produced exe stays small.
    static void CopyThemeSkins(string root, string outDir, List<string> log) {
        if (!ZanIDE.ProjSkinsEnabled(root)) { return; }
        string src = ZanIDE.StdlibDir() + "/Gui/skins";
        if (!Directory.Exists(src)) {
            log.Add("> WARNING: skins requested but stdlib skins folder not found.");
            return;
        }
        string dst = outDir + "/skins";
        Directory.CreateDirectoryRecursive(dst);
        // base.css is the shared reset every skin builds on -- ship it too.
        if (File.Exists(src + "/base.css")) {
            File.Copy(src + "/base.css", dst + "/base.css");
        }
        List<string> want = ZanIDE.ProjSkinList(root);
        int copied = 0;
        for (int i = 0; i < want.Count; i = i + 1) {
            string sd = src + "/" + want[i];
            if (Directory.Exists(sd)) {
                AssetManager.copyTree(sd, dst + "/" + want[i]);
                copied = copied + 1;
            } else {
                log.Add("> WARNING: skin not found, skipped: " + want[i]);
            }
        }
        log.Add("> Bundled " + Convert.ToString(copied) + " skin pack(s) into " + dst);
    }
}
