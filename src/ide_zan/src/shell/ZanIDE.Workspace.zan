// IDE 工具链交互与状态驱动契约。
// IDE 视图状态管理与用户交互调度。
// IDE 工具链交互与状态驱动契约。
// 发布目标平台选项强类型实体（封装目标ID、显示标签与选中状态，彻底消除平行列表）
class PublishTargetOption {
    public string id;
    public string label;
    public bool selected;

    PublishTargetOption(string id, string label, bool selected) {
        this.id = id != null ? id : "";
        this.label = label != null ? label : "";
        this.selected = selected;
    }

    static PublishTargetOption Of(string id, string label, bool selected) {
        return new PublishTargetOption(id, label, selected);
    }
}

partial class ZanIDE {
    // ---- workspace / scaffolding ----

    // 核心契约与执行状态转移规范。

    // IDE 工具链交互与状态驱动契约。
    static string TemplatesDir() {
        string a = ZanIDE.BaseDir() + "/templates";
        if (Directory.Exists(a)) { return a; }
        string b = ZanIDE.BaseDir() + "/../templates";
        if (Directory.Exists(b)) { return b; }
        return "";
    }

    // IDE 工具链交互与状态驱动契约。
    // 核心契约与语义定义。
    static List<Tpl> BuildCatalog(string root) {
        List<Tpl> ts = new List<Tpl>();
        ZanIDE.LoadDiskTemplates(ts);
        ZanIDE.LoadCustomTemplates(ts, root);
        return ts;
    }

    // IDE 工具链交互与状态驱动契约。
    // IDE 视图状态管理与用户交互调度。
    // 核心契约与语义定义。
    static void LoadDiskTemplates(List<Tpl> ts) {
        string base_ = ZanIDE.TemplatesDir();
        if (base_.Length == 0) { return; }
        List<Tpl> found = new List<Tpl>();
        List<string> cats = Directory.GetDirectories(base_);
        for (int i = 0; i < cats.Count; i = i + 1) {
            string catDir = base_ + "/" + cats[i];
            if (File.Exists(catDir + "/template.manifest")) {
                ZanIDE.AddDiskTemplate(found, catDir);
            } else {
                List<string> subs = Directory.GetDirectories(catDir);
                for (int j = 0; j < subs.Count; j = j + 1) {
                    ZanIDE.AddDiskTemplate(found, catDir + "/" + subs[j]);
                }
            }
        }
        // IDE 工具链交互与状态驱动契约。
        for (int k = 0; k < found.Count; k = k + 1) {
            int best = k;
            for (int m = k + 1; m < found.Count; m = m + 1) {
                if (found[m].order < found[best].order) { best = m; }
            }
            Tpl tmp = found[k]; found[k] = found[best]; found[best] = tmp;
            ts.Add(found[k]);
        }
    }

    // IDE 工具链交互与状态驱动契约。
    static void AddDiskTemplate(List<Tpl> ts, string dir) {
        string mpath = dir + "/template.manifest";
        if (!File.Exists(mpath)) { return; }
        string m = File.ReadAllText(mpath);
        string nameEn = ZanIDE.ManifestField(m, "name", Path.GetFileName(dir));
        string nameZh = ZanIDE.ManifestField(m, "name.zh", nameEn);
        string descEn = ZanIDE.ManifestField(m, "desc", "");
        string descZh = ZanIDE.ManifestField(m, "desc.zh", descEn);
        string catEn = ZanIDE.ManifestField(m, "category", "Other");
        string catZh = ZanIDE.ManifestField(m, "category.zh", catEn);
        Tpl t = Tpl.Make(
            ZanIDE.T(catEn, catZh),
            ZanIDE.T(nameEn, nameZh),
            ZanIDE.ManifestField(m, "icon", "file"),
            ZanIDE.ManifestField(m, "kind", "copy"),
            ZanIDE.T(descEn, descZh));
        t.src = dir;
        t.ptype = ZanIDE.ManifestField(m, "type", "console");
        t.ptarget = ZanIDE.ManifestField(m, "target", "exe");
        t.pentry = ZanIDE.ManifestField(m, "entry", "src/main.zan");
        t.order = ZanIDE.ParseInt(ZanIDE.ManifestField(m, "order", "1000"));
        t.platforms = ZanIDE.ManifestField(m, "platforms", "");
        // IDE 工具链交互与状态驱动契约。
        // IDE 视图状态管理与用户交互调度。
        string size = ZanIDE.ManifestField(m, "size", "");
        if (size != "") {
            List<string> wh = size.Split("x");
            if (wh.Count == 2) {
                t.defW = ZanIDE.ParseIntSafe(wh[0]);
                t.defH = ZanIDE.ParseIntSafe(wh[1]);
            }
        }
        t.sizeable = ZanIDE.ManifestField(m, "sizeable", "0") == "1";
        t.round = ZanIDE.ManifestField(m, "shape", "") == "round";
        t.sketch = ZanIDE.ManifestField(m, "sketch", "");
        t.device = ZanIDE.ManifestField(m, "device", "");
        t.caps = ZanIDE.ManifestField(m, "caps", "");
        string prev = ZanIDE.ManifestField(m, "preview", "");
        if (prev != "" && File.Exists(dir + "/" + prev)) {
            t.preview = dir + "/" + prev;
        }
        ts.Add(t);
    }

    // IDE 工具链交互与状态驱动契约。
    static List<string> CatsOf(List<Tpl> ts) {
        List<string> outp = new List<string>();
        for (int i = 0; i < ts.Count; i = i + 1) {
            string c = ts[i].cat;
            bool seen = false;
            for (int j = 0; j < outp.Count; j = j + 1) {
                if (outp[j] == c) { seen = true; }
            }
            if (!seen) { outp.Add(c); }
        }
        return outp;
    }

    // IDE 视图状态管理与用户交互调度。
    static List<WizardTemplate> WizTemplates(List<Tpl> ts) {
        List<WizardTemplate> outp = new List<WizardTemplate>();
        foreach (Tpl t in ts) {
            outp.Add(new WizardTemplate(t.cat, t.name, t.icon, t.desc)
                .Shape(t.sizeable, t.defW, t.defH, t.round)
                .Look(t.preview, t.sketch)
                .Device(t.device)
                .Caps(t.caps)
                .Plats(t.platforms));
        }
        return outp;
    }

    // IDE 工具链交互与状态驱动契约。
    // 核心契约与语义定义。
    static void LoadCustomTemplates(List<Tpl> ts, string root) {
        string dir = ZanIDE.UserConfigDir() + "/templates";
        List<string> subs = Directory.GetDirectories(dir);
        for (int i = 0; i < subs.Count; i = i + 1) {
            string tname = subs[i];
            string tdir = dir + "/" + tname;
            string desc = "Custom template.";
            string icon = "file";
            string mpath = tdir + "/template.manifest";
            if (!File.Exists(mpath)) { mpath = tdir + "/manifest.txt"; }
            if (File.Exists(mpath)) {
                string m = File.ReadAllText(mpath);
                desc = ZanIDE.ManifestField(m, "desc", desc);
                icon = ZanIDE.ManifestField(m, "icon", icon);
            }
            Tpl t = Tpl.Make("Custom", tname, icon, "custom", desc);
            t.src = tdir;
            ts.Add(t);
        }
    }

    // IDE 工具链交互与状态驱动契约。
    // IDE 视图状态管理与用户交互调度。
    // IDE 工具链交互与状态驱动契约。
    // IDE 视图状态管理与用户交互调度。
    // IDE 工具链交互与状态驱动契约。
    static string ManifestField(string content, string key, string def) {
        int n = content.Length;
        int kl = key.Length;
        for (int i = 0; i < n; i = i + 1) {
            bool atLineStart = (i == 0) || (content.Substring(i - 1, 1) == "\n");
            if (!atLineStart || i + kl > n
                || content.Substring(i, kl) != key) { continue; }
            int j = i + kl;
            while (j < n) {
                string sp = content.Substring(j, 1);
                if (sp == " " || sp == "\t") { j = j + 1; } else { break; }
            }
            if (j >= n || content.Substring(j, 1) != "=") { continue; }
            j = j + 1;
            string val = "";
            while (j < n) {
                string ch = content.Substring(j, 1);
                if (ch == "\n" || ch == "\r") { break; }
                val = val + ch;
                j = j + 1;
            }
            return val.Trim();
        }
        return def;
    }

    // IDE 工具链交互与状态驱动契约。
    static void CopyTree(string srcDir, string dstDir) {
        ZanIDE.CopyTreeT(srcDir, dstDir, "");
    }

    // IDE 工具链交互与状态驱动契约。
    static void CopyTreeT(string srcDir, string dstDir, string name) {
        Directory.CreateDirectory(dstDir);
        List<string> files = Directory.GetFiles(srcDir);
        for (int i = 0; i < files.Count; i = i + 1) {
            string fn = files[i];
            if (fn != "manifest.txt" && fn != "template.manifest") {
                string body = File.ReadAllText(srcDir + "/" + fn);
                if (name.Length > 0) {
                    body = ZanIDE.ReplaceAll(body, "{{NAME}}", name);
                }
                File.WriteAllText(dstDir + "/" + fn, body);
            }
        }
        List<string> subs = Directory.GetDirectories(srcDir);
        for (int j = 0; j < subs.Count; j = j + 1) {
            ZanIDE.CopyTreeT(srcDir + "/" + subs[j], dstDir + "/" + subs[j], name);
        }
    }

    // IDE 工具链交互与状态驱动契约。
    // 核心契约与执行状态转移规范。
    static string ReplaceAll(string s, string pat, string rep) {
        if (pat.Length == 0) { return s; }
        StringBuilder sb = new StringBuilder();
        int n = s.Length;
        int pl = pat.Length;
        int i = 0;
        while (i < n) {
            bool hit = false;
            if (i + pl <= n) {
                if (s.Substring(i, pl) == pat) { hit = true; }
            }
            if (hit) { sb.Append(rep); i = i + pl; }
            else { sb.Append(s.Substring(i, 1)); i = i + 1; }
        }
        return sb.ToString();
    }

    // IDE 视图状态管理与用户交互调度。
    // IDE 工具链交互与状态驱动契约。
    static void SaveAsTemplate(string root, string cat, string tname, List<string> log) {
        string tdir = ZanIDE.UserConfigDir() + "/templates/" + tname;
        Directory.CreateDirectoryRecursive(tdir);
        if (Directory.Exists(root + "/src")) {
            ZanIDE.CopyTree(root + "/src", tdir + "/src");
        }
        if (File.Exists(root + "/zan.proj")) {
            File.WriteAllText(tdir + "/zan.proj", File.ReadAllText(root + "/zan.proj"));
        }
        File.WriteAllText(tdir + "/template.manifest",
            "name=" + tname + "\ncategory=" + cat + "\nicon=file\nkind=custom\ndesc=Custom template from " + Path.GetFileName(root) + ".\n");
        log.Add("> Saved current project as template '" + tname + "' (" + tdir + ").");
    }

    // IDE 工具链交互与状态驱动契约。
    // IDE 视图状态管理与用户交互调度。
    static List<string> PlatformCsvIds() {
        List<string> ids = new List<string>{
            "windows-x64", "windows-arm64",
            "linux-x64", "linux-arm64",
            "macos-x64", "macos-arm64",
            "android-x64", "android-arm64",
            "ohos-x64", "ohos-arm64" };
        return ids;
    }

    static string PlatformCsv(List<WizardTarget> targets) {
        List<string> ids = ZanIDE.PlatformCsvIds();
        string outp = "";
        for (int i = 0; i < targets.Count; i = i + 1) {
            if (i < ids.Count && targets[i].selected == 1) {
                if (outp.Length > 0) { outp = outp + ","; }
                outp = outp + ids[i];
            }
        }
        if (outp.Length == 0) { outp = ZanIDE.HostTargetId(); }
        return outp;
    }

    // IDE 工具链交互与状态驱动契约。
    static List<string> SplitIds(string s) {
        List<string> outp = new List<string>();
        if (s == null) { return outp; }
        string cur = "";
        for (int i = 0; i < s.Length; i = i + 1) {
            string ch = s.Substring(i, 1);
            if (ch == ",") {
                if (cur != "") { outp.Add(cur); }
                cur = "";
            } else {
                cur = cur + ch;
            }
        }
        if (cur != "") { outp.Add(cur); }
        return outp;
    }

    // IDE 工具链交互与状态驱动契约。
    // IDE 视图状态管理与用户交互调度。
    // IDE 工具链交互与状态驱动契约。
    static bool IsValidProjectName(string name) {
        if (name == "") { return false; }
        if (name == "." || name == "..") { return false; }
        string bad = "<>:\"/\\|?*";
        int i = 0;
        for (i = 0; i < name.Length; i = i + 1) {
            string ch = name.Substring(i, 1);
            for (int j = 0; j < bad.Length; j = j + 1) {
                if (bad.Substring(j, 1) == ch) { return false; }
            }
        }
        // IDE 视图状态管理与用户交互调度。
        StringBuilder ub = new StringBuilder();
        i = 0;
        i = 0;
        for (i = 0; i < name.Length; i = i + 1) {
            string ch = name.Substring(i, 1);
            int code = ch[0] & 255;
            if (code < 32 || code == 127) { return false; }   // control chars
            if (code >= 97 && code <= 122) { code = code - 32; }
            ub.Append(Text.CharStr(code));
        }
        string upper = ub.ToString();
        string reserved = " CON PRN AUX NUL COM1 COM2 COM3 COM4 COM5 COM6 COM7 COM8 COM9 LPT1 LPT2 LPT3 LPT4 LPT5 LPT6 LPT7 LPT8 LPT9 ";
        if (ZanIDE.Has(reserved, " " + upper + " ")) { return false; }
        return true;
    }

    // IDE 工具链交互与状态驱动契约。
    // IDE 视图状态管理与用户交互调度。
    // IDE 工具链交互与状态驱动契约。
    // IDE 视图状态管理与用户交互调度。
    static string CreateProjectT(Tpl tpl, string parent, string name, string platforms,
                                 int devW, int devH, string devId, List<string> log) {
        string dir = ZanIDE.CreateProjectT(tpl, parent, name, platforms, log);
        if (dir == "") { return dir; }
        if (tpl.sizeable && devW >= 40 && devH >= 40) {
            ZanIDE.RetargetForms(dir + "/src", devW, devH, devId, log);
        }
        return dir;
    }

    // IDE 视图状态管理与用户交互调度。
    // IDE 工具链交互与状态驱动契约。
    static void RetargetForms(string srcDir, int devW, int devH, List<string> log) {
        ZanIDE.RetargetForms(srcDir, devW, devH, "", log);
    }

    // IDE 工具链交互与状态驱动契约。
    static void RetargetForms(string srcDir, int devW, int devH, string devId,
                              List<string> log) {
        List<string> files = DirectoryTree.Flat(srcDir,
            PathFilter.Only(".html"));
        for (int i = 0; i < files.Count; i = i + 1) {
            string fp = files[i];
            // 逐文件守卫：模板 src/ 里的一份坏设计文档（截断/手改的 JSON，
            // 或目标文件被占用/只读）不能把整个"新建项目"炸成进程闪退——
            // 记日志跳过，其余文件继续。这条链在 WizardHost 的子窗口泵里
            // 运行，不走主框架的每帧 catch。
            try {
                JsonValue d = JsonValue.Parse(File.ReadAllText(fp));
                if (!Designer.RetargetDoc(d, devW, devH, devId)) { continue; }
                File.WriteAllText(fp, d.PrettyToJson() + "\n");
                log.Add("> Design canvas set to " + Convert.ToString(devW) + "x"
                    + Convert.ToString(devH) + " (" + devId + "): " + fp);
            } catch (Exception e) {
                log.Add(ZanIDE.T("> Skipped unreadable design file: " + fp
                        + " (" + e.Message + ")",
                        "> 跳过无法读取的设计文件：" + fp + "（" + e.Message + "）"));
            }
        }
    }

    // IDE 工具链交互与状态驱动契约。
    static string CreateProjectT(Tpl tpl, string parent, string name, string platforms, List<string> log) {
        if (!ZanIDE.IsValidProjectName(name)) {
            log.Add(ZanIDE.T("> Cannot create project: invalid name '",
                "> 无法创建项目：名称非法 '") + name + "'.");
            return "";
        }
        // IDE 工具链交互与状态驱动契约。
        if (tpl.platforms.Length > 0) {
            string kept = "";
            string dropped = "";
            List<string> wants = ZanIDE.SplitIds(platforms);
            for (int i = 0; i < wants.Count; i = i + 1) {
                string id = wants[i];
                string os = id;
                int dash = ZanIDE.IndexOfStr(id, "-");
                if (dash > 0) { os = id.Substring(0, dash); }
                if (ZanIDE.Has("," + tpl.platforms + ",", "," + os + ",")) {
                    if (kept.Length > 0) { kept = kept + ","; }
                    kept = kept + id;
                } else {
                    if (dropped.Length > 0) { dropped = dropped + ","; }
                    dropped = dropped + id;
                }
            }
            if (kept.Length == 0) {
                log.Add(ZanIDE.T("> Cannot create project: template '" + tpl.name
                        + "' supports [" + tpl.platforms + "] -- none of the selected targets is supported.",
                    "> 无法创建项目：模板 '" + tpl.name
                        + "' 支持 [" + tpl.platforms + "] -- 与所选目标平台无交集。"));
                return "";
            }
            if (dropped.Length > 0) {
                log.Add(ZanIDE.T("> Template '" + tpl.name + "' supports [" + tpl.platforms
                        + "]; dropped unsupported targets: " + dropped + ".",
                    "> 模板 '" + tpl.name + "' 支持 [" + tpl.platforms
                        + "]；已剔除不支持的目标：" + dropped + "。"));
            }
            platforms = kept;
        }
        string dir = parent + "/" + name;
        try {
        // IDE 工具链交互与状态驱动契约。
        // IDE 视图状态管理与用户交互调度。
        // 核心契约与语义定义。
        if (Directory.Exists(dir)) {
            List<string> exFiles = Directory.GetFiles(dir);
            List<string> exDirs = Directory.GetDirectories(dir);
            if (exFiles.Count > 0 || exDirs.Count > 0) {
                log.Add(ZanIDE.T("> Cannot create project: target folder is not empty: ",
                    "> 无法创建项目：目标文件夹非空：") + dir);
                return "";
            }
        }
        Directory.CreateDirectoryRecursive(dir);

        string typeName = "console";
        string target = "exe";
        string entry = "src/main.zan";
        string kind = tpl.kind;

        if (kind == "custom") {
            ZanIDE.CopyTree(tpl.src, dir);
        } else if (tpl.src.Length > 0) {
            // IDE 视图状态管理与用户交互调度。
            // IDE 工具链交互与状态驱动契约。
            typeName = tpl.ptype; target = tpl.ptarget; entry = tpl.pentry;
            if (name.Length > 0) {
                entry = ZanIDE.ReplaceAll(entry, "{{NAME}}", name);
            }
            ZanIDE.CopyTreeT(tpl.src, dir, name);
            // IDE 视图状态管理与用户交互调度。
            if (typeName == "gui" && name.Length > 0) {
                if (File.Exists(dir + "/src/App.zan")) {
                    string body = File.ReadAllText(dir + "/src/App.zan");
                    File.WriteAllText(dir + "/src/" + name + ".zan", body);
                    File.Delete(dir + "/src/App.zan");
                }
                if (File.Exists(dir + "/src/App.html")) {
                    string body = File.ReadAllText(dir + "/src/App.html");
                    File.WriteAllText(dir + "/src/" + name + ".html", body);
                    File.Delete(dir + "/src/App.html");
                }
                // IDE 工具链交互与状态驱动契约。
                // 核心契约与语义定义。
                ZanIDE.SyncFormCodeBehinds(dir + "/src");
                if (File.Exists(dir + "/src/" + name + ".html")) {
                    entry = "src/" + name + ".html";
                }
            }
        } else {
            typeName = "empty";
        }

        // IDE 视图状态管理与用户交互调度。
        // IDE 工具链交互与状态驱动契约。
        // IDE 视图状态管理与用户交互调度。
        if (!File.Exists(dir + "/README.md")) {
            string platNote = "";
            if (tpl.platforms != "") {
                platNote = "\n" + ZanIDE.T("Runs on: ", "支持平台：") + tpl.platforms
                    + ZanIDE.T(" (declared by the template).", "（模板声明）。");
            }
            string runLine = "";
            if (typeName == "gui") {
                runLine = ZanIDE.T(
                    "Open this folder in the IDE and press Run (F5) - the IDE passes the window subsystem and driver paths. Publish produces a standalone exe.",
                    "在 IDE 中打开本目录并按运行（F5）——窗口子系统与驱动路径由 IDE 自动传入；发布命令产出独立 exe。");
            } else if (target == "dll") {
                runLine = "`zanc " + entry + " --auto-stdlib --emit-lib -o build/" + name + ".dll`";
            } else {
                runLine = "`zanc " + entry + " --auto-stdlib -o build/" + name + ".exe`, "
                    + ZanIDE.T("then run `build/", "然后运行 `build/") + name + ".exe`";
            }
            File.WriteAllText(dir + "/README.md",
                "# " + name + "\n\n"
                + ZanIDE.T("Created by the Zan IDE from template '", "由 Zan IDE 从模板 '")
                    + tpl.name + ZanIDE.T("'.\nEntry: ", "' 创建。\n入口：") + entry + "\n"
                + platNote
                + "\n\n## " + ZanIDE.T("Run", "运行") + "\n\n"
                + "- " + runLine + "\n"
                + "- " + ZanIDE.T(
                    "Language docs live in the Zan SDK's docs/; examples/ has complete programs.",
                    "语言文档见 Zan SDK 的 docs/；examples/ 里有完整示例程序。") + "\n");
        }
        // IDE 工具链交互与状态驱动契约。
        // IDE 视图状态管理与用户交互调度。
        // IDE 工具链交互与状态驱动契约。
        if (!File.Exists(dir + "/.gitignore")) {
            File.WriteAllText(dir + "/.gitignore",
                "# Build and publish output is disposable - keep it out of version control.\n"
                + "# In the IDE use Run / Publish; on the CLI prefer -o build/<app>.exe.\n"
                + "build/\n"
                + "publish/\n"
                + "*.exe\n"
                + "*.dll\n"
                + "*.lib\n"
                + "*.pdb\n"
                + "*.obj\n"
                + "*.o\n"
                + "*.wasm\n"
                + "*.log\n"
                + "zan_crash.log\n");
        }
        // IDE 视图状态管理与用户交互调度。
        // IDE 工具链交互与状态驱动契约。
        string iconRel = "";
        string iconSrc = ZanIDE.ZanIconSource();
        if (iconSrc != "") {
            Directory.CreateDirectory(dir + "/assets");
            File.Copy(iconSrc, dir + "/assets/zan.ico");
            iconRel = "assets/zan.ico";
        }
        if (kind != "custom" && !File.Exists(dir + "/zan.proj")) {
            string projc = "name = " + name + "\ntype = " + typeName + "\nentry = " + entry
                + "\ntarget = " + target + "\nplatform = " + platforms + "\n";
            if (iconRel != "") { projc = projc + "icon = " + iconRel + "\n"; }
            File.WriteAllText(dir + "/zan.proj", projc);
        } else if (kind != "custom") {
            // IDE 视图状态管理与用户交互调度。
            ZanIDE.SetProjField(dir, "platform", platforms);
            if (iconRel != "" && ZanIDE.ProjField(dir, "icon") == "") {
                ZanIDE.SetProjField(dir, "icon", iconRel);
            }
        }
        log.Add("> Created " + typeName + " project for [" + platforms + "] at " + dir + " (template: " + tpl.name + ").");
        return dir;
        } catch (Exception e) {
            // IDE 工具链交互与状态驱动契约。
            // IDE 视图状态管理与用户交互调度。
            // 核心契约与执行状态转移规范。
            log.Add(ZanIDE.T("> Failed to create project: ",
                "> 创建项目失败：") + e.Message);
            return "";
        }
    }

    // IDE 视图状态管理与用户交互调度。
    // IDE 工具链交互与状态驱动契约。
    // IDE 视图状态管理与用户交互调度。
    static void SyncFormCodeBehinds(string srcDir) {
        List<string> files = DirectoryTree.Flat(srcDir,
            PathFilter.Only(".zscene .html .htm"));
        int i = 0;
        while (i < files.Count) {
            string fp = files[i];
            i = i + 1;
            if (ZanIDE.IsFormPath(fp)) {
                string fbase = ZanIDE.FormBaseName(fp);
                // IDE 工具链交互与状态驱动契约。
                string cbp = ZanIDE.CodeBehindPath(fp);
                if (!File.Exists(cbp)) {
                    File.WriteAllText(cbp, ZanIDE.GenBusinessShell(fbase));
                }
            } else if (ZanIDE.IsScenePath(fp)) {
                string sbase = ZanIDE.SceneBaseName(fp);
                string scbp = ZanIDE.SceneCodeBehindPath(fp);
                if (!File.Exists(scbp)) {
                    File.WriteAllText(scbp, ZanIDE.GenSceneBusinessShell(sbase));
                }
            }
        }
    }

    // 核心契约与执行状态转移规范。
    // IDE 工具链交互与状态驱动契约。
    // IDE 视图状态管理与用户交互调度。
    // IDE 工具链交互与状态驱动契约。

    static int FileKindLua() { return 5; }

    // IDE 视图状态管理与用户交互调度。
    static int FileKindForm() { return 6; }

    // IDE 工具链交互与状态驱动契约。
    static int FileKindFreeForm() { return 7; }

    // IDE 工具链交互与状态驱动契约。
    static int FileKindScene() { return 8; }

    // IDE 工具链交互与状态驱动契约。
    static int FileKindFolder() { return 9; }

    // IDE 视图状态管理与用户交互调度。
    // 核心契约与语义定义。
    static bool FileKindDeclaresType(int kind) {
        return kind == ZanIDE.FileKindForm()
            || kind == ZanIDE.FileKindFreeForm()
            || kind == ZanIDE.FileKindScene();
    }

    // IDE 视图状态管理与用户交互调度。
    // IDE 工具链交互与状态驱动契约。
    static bool DirHasEntries(string dir) {
        if (!Directory.Exists(dir)) { return false; }
        return Directory.GetFiles(dir).Count > 0
            || Directory.GetDirectories(dir).Count > 0;
    }

    // IDE 视图状态管理与用户交互调度。
    // IDE 工具链交互与状态驱动契约。
    static string NewFileTaken(int kind, string root, string name) {
        string src = root + "/src/";
        if (kind == ZanIDE.FileKindLua()) {
            if (File.Exists(src + name + ".lua")) { return src + name + ".lua"; }
            return "";
        }
        if (kind == ZanIDE.FileKindScene()) {
            if (File.Exists(src + name + ".html")) { return src + name + ".html"; }
            if (File.Exists(src + name + ".zscene")) { return src + name + ".zscene"; }
            return "";
        }
        if (kind == ZanIDE.FileKindForm() || kind == ZanIDE.FileKindFreeForm()) {
            if (File.Exists(src + name + ".html")) { return src + name + ".html"; }
            return "";
        }
        if (kind == ZanIDE.FileKindFolder()) {
            if (Directory.Exists(src + name)) { return src + name; }
            return "";
        }
        if (File.Exists(src + name + ".zan")) { return src + name + ".zan"; }
        return "";
    }

    // IDE 视图状态管理与用户交互调度。
    // IDE 工具链交互与状态驱动契约。
    // Scene, 9 Folder.
    // IDE 视图状态管理与用户交互调度。
    // IDE 工具链交互与状态驱动契约。
    // IDE 视图状态管理与用户交互调度。
    static string CreateFile(int kind, string root, string name, int sizeSel,
                             int customW, int customH, List<string> log) {
        int winW = 480;
        int winH = 520;
        List<int> pw = Wizard.SizePresetW();
        List<int> ph = Wizard.SizePresetH();
        bool sized = false;
        if (customW >= 40 && customH >= 40) {
            winW = customW;
            winH = customH;
            sized = sizeSel >= 0 || customW != 480 || customH != 520;
        } else if (sizeSel >= 0 && sizeSel < pw.Count) {
            winW = pw[sizeSel];
            winH = ph[sizeSel];
            sized = true;
        }
        string taken = ZanIDE.NewFileTaken(kind, root, name);
        if (taken != "") {
            log.Add(ZanIDE.T("> Cannot create file: already exists: ",
                "> 无法新建：文件已存在：") + taken);
            return "";
        }
        Directory.CreateDirectory(root + "/src");
        if (kind == ZanIDE.FileKindLua()) {
            // IDE 视图状态管理与用户交互调度。
            // IDE 工具链交互与状态驱动契约。
            // IDE 视图状态管理与用户交互调度。
            string ext = ".lua";
            string spath = root + "/src/" + name + ext;
            File.WriteAllText(spath, ZanIDE.ScriptTemplateBody(name));
            log.Add("> Created script " + spath
                    + " (load it from Zan, see the header comment).");
            return spath;
        }
        if (kind == ZanIDE.FileKindScene()) {
            // IDE 工具链交互与状态驱动契约。
            int scW = 1280;
            int scH = 720;
            if (sized) { scW = winW; scH = winH; }
            string scenePath = root + "/src/" + name + ".html";
            string scbPath = ZanIDE.SceneCodeBehindPath(scenePath);
            SceneDoc sdoc = new SceneDoc(name, scW, scH);
            File.WriteAllText(scenePath, sdoc.ToHtml());
            if (!File.Exists(scbPath)) {
                File.WriteAllText(scbPath, ZanIDE.GenSceneBusinessShell(name));
            }
            log.Add("> Created scene " + scenePath + " (+ " + scbPath + ").");
            return scenePath;
        }
        if (kind == ZanIDE.FileKindForm()) {
            string formPath = root + "/src/" + name + ".html";
            string cbPath = ZanIDE.CodeBehindPath(formPath);
            FormDoc o = new FormDoc();
            o.name = name;
            o.winW = winW;
            o.winH = winH;
            o.winTitle = name;
            o.winCenter = true;
            o.layoutMode = 0;
            o.winZoom = 0;
            o.fields = new List<FormFieldDoc>();
            File.WriteAllText(formPath,
                DesignerHtml.FromJsonDoc(Json.Serialize<FormDoc>(o)));
            if (!File.Exists(cbPath)) {
                File.WriteAllText(cbPath, ZanIDE.GenBusinessShell(name));
            }
            log.Add("> Created form " + formPath + " (+ " + cbPath + ").");
            return formPath;
        }
        if (kind == ZanIDE.FileKindFreeForm()) {
            // IDE 视图状态管理与用户交互调度。
            // IDE 工具链交互与状态驱动契约。
            // IDE 视图状态管理与用户交互调度。
            // IDE 工具链交互与状态驱动契约。
            string formPath = root + "/src/" + name + ".html";
            string cbPath = ZanIDE.CodeBehindPath(formPath);
            File.WriteAllText(formPath, ZanIDE.FreeFormBody(name, winW, winH));
            if (!File.Exists(cbPath)) {
                File.WriteAllText(cbPath, ZanIDE.GenFreeShell(name));
            }
            log.Add("> Created free-layout form " + formPath + " (+ " + cbPath + ").");
            return formPath;
        }
        if (kind == ZanIDE.FileKindFolder()) {
            string dirPath = root + "/src/" + name;
            Directory.CreateDirectoryRecursive(dirPath);
            log.Add("> Created folder " + dirPath + ".");
            return dirPath;
        }
        string path = root + "/src/" + name + ".zan";
        File.WriteAllText(path, ZanIDE.FileTemplateBody(kind, name));
        log.Add("> Created file " + path + ".");
        return path;
    }

    // IDE 工具链交互与状态驱动契约。
    static void DeletePathRecursive(string p) {
        if (Directory.Exists(p)) {
            List<string> subs = Directory.GetDirectories(p);
            for (int i = 0; i < subs.Count; i = i + 1) {
                ZanIDE.DeletePathRecursive(p + "/" + subs[i]);
            }
            List<string> files = Directory.GetFiles(p);
            for (int j = 0; j < files.Count; j = j + 1) {
                File.Delete(p + "/" + files[j]);
            }
            Directory.Delete(p);
        } else if (File.Exists(p)) {
            File.Delete(p);
        }
    }

    static void OpenFirst(List<TabRecord> tabs, SignalInt active, string root) {
        string formP = root + "/src/" + Path.GetFileName(root) + ".html";
        string main = root + "/src/main.zan";
        string lib = root + "/src/lib.zan";
        if (File.Exists(formP)) {
            ZanIDE.OpenPath(tabs, active, formP, Path.GetFileName(formP));
        } else if (File.Exists(main)) {
            ZanIDE.OpenPath(tabs, active, main, "main.zan");
        } else if (File.Exists(lib)) {
            ZanIDE.OpenPath(tabs, active, lib, "lib.zan");
        } else if (File.Exists(root + "/README.md")) {
            ZanIDE.OpenPath(tabs, active, root + "/README.md", "README.md");
        } else {
            // IDE 工具链交互与状态驱动契约。
            // IDE 视图状态管理与用户交互调度。
            // IDE 工具链交互与状态驱动契约。
            string first = ZanIDE.FirstSourceFile(root + "/src");
            if (first == "") { first = ZanIDE.FirstSourceFile(root); }
            if (first != "") {
                ZanIDE.OpenPath(tabs, active, first, Path.GetFileName(first));
            }
        }
    }

    // IDE 视图状态管理与用户交互调度。
    static string FirstSourceFile(string dir) {
        List<string> fs = DirectoryTree.Flat(dir, PathFilter.Only(".zan"));
        if (fs.Count == 0) { return ""; }
        return fs[0];
    }

    // 核心契约与执行状态转移规范。

    static string FileTemplateBody(int kind, string name) {
        if (kind == 0) {
            return "using System;\n\nclass Program {\n    static void Main() {\n        Console.WriteLine(\"Hello from " + name + "\");\n    }\n}\n";
        }
        if (kind == 1) {
            return "using System;\n\nclass " + name + " {\n    // fields and methods\n}\n";
        }
        if (kind == 2) {
            // IDE 工具链交互与状态驱动契约。
            // IDE 视图状态管理与用户交互调度。
            // IDE 工具链交互与状态驱动契约。
            return "using System;\n"
                 + "using Gui;\n"
                 + "using Gui.Widget;\n\n"
                 + "class Program {\n"
                 + "    static void Main() {\n"
                 + "        Form form = Form.Create(\"" + name + "\", 800, 600);\n\n"
                 + "        // Controls go into a container, the container into the\n"
                 + "        // window; Panel.Column() stacks its children top to bottom.\n"
                 + "        Panel root = Panel.Column();\n"
                 + "        root.With(new Label(\"" + name + "\"));\n"
                 + "        Input who = new Input(\"你的名字\");\n"
                 + "        root.With(who);\n"
                 + "        Button hi = new Button(\"打个招呼\");\n"
                 + "        hi.Click += () => {\n"
                 + "            Layer.Notify(\"你好，\" + who.GetText() + \"！\", 3);\n"
                 + "        };\n"
                 + "        root.With(hi);\n\n"
                 + "        form.Add(root);\n"
                 + "        form.Run();\n"
                 + "    }\n"
                 + "}\n";
        }
        if (kind == 3) {
            return "using System;\n\n/// Contract implemented by concrete types.\nclass " + name + " {\n    void Execute() { }\n}\n";
        }
        return "";
    }

    // IDE 工具链交互与状态驱动契约。
    // IDE 视图状态管理与用户交互调度。
    // IDE 工具链交互与状态驱动契约。
    static string ScriptTemplateBody(string name) {
        return "-- " + name + ".lua -- loaded by a Zan host, not run on its own.\n"
             + "--\n"
             + "--   using System.Scripting;\n"
             + "--   Lua.Initialize();\n"
             + "--   Lua.RunFile(\"src/" + name + ".lua\");\n"
             + "--   Console.WriteLine(Lua.CallS(\"" + name + "_main\"));\n"
             + "--\n"
             + "-- The interpreter comes from ZAN_LUA_LIB, the runtime bundled next\n"
             + "-- to the executable by zanc, or the system Lua.\n\n"
             + "function " + name + "_main()\n"
             + "    return \"hello from " + name + ".lua\"\n"
             + "end\n";
    }

    // 核心契约与执行状态转移规范。

    static List<TreeNode> ScanTree(string root) {
        List<TreeNode> nodes = new List<TreeNode>();
        ZanIDE.ScanInto(
            nodes, root, Path.GetFileName(root), 0, true);
        return nodes;
    }

    // IDE 工具链交互与状态驱动契约。
    // IDE 视图状态管理与用户交互调度。
    static List<string> ExpandedPaths(List<TreeNode> nodes) {
        List<string> outp = new List<string>();
        for (int i = 0; i < nodes.Count; i = i + 1) {
            TreeNode n = nodes[i];
            if (n.isDir && n.expanded && n.path != "") { outp.Add(n.path); }
        }
        return outp;
    }

    // IDE 工具链交互与状态驱动契约。
    // rescan (counterpart of ExpandedPaths).
    static void ApplyExpanded(List<TreeNode> nodes, List<string> exp) {
        for (int i = 0; i < nodes.Count; i = i + 1) {
            TreeNode n = nodes[i];
            if (n.isDir && n.path != "" && exp.Contains(n.path)) {
                n.expanded = true;
            }
        }
    }

    static void ScanInto(List<TreeNode> nodes, string dirPath, string dirName, int depth, bool expanded) {
        // IDE 视图状态管理与用户交互调度。
        // IDE 工具链交互与状态驱动契约。
        FileTree.Into(nodes, dirPath, dirName, depth, expanded,
            PathFilter.Any().Hide(".proj").Dots(true, true),
            true, false);
    }

    // IDE 视图状态管理与用户交互调度。
    // 核心契约与执行状态转移规范。
    static bool EndsWith(string s, string suffix) {
        int sl = s.Length;
        int fl = suffix.Length;
        if (fl > sl) { return false; }
        return s.Substring(sl - fl, fl) == suffix;
    }

    // ---- tabs ----

    static int FindTabByPath(List<TabRecord> tabs, string path) {
        for (int i = 0; i < tabs.Count; i = i + 1) {
            if (tabs[i].path == path) { return i; }
        }
        return 0 - 1;
    }

    static void OpenPath(List<TabRecord> tabs, SignalInt active,
                         string path, string name) {
        ZanIDE owner = ZanIDE.current;
        if (owner != null && owner.app != null && owner.tabs == tabs) {
            owner.OpenDocumentAsync(path, name);
            return;
        }
        int idx = ZanIDE.FindTabByPath(tabs, path);
        if (idx >= 0) {
            active.Set(idx);
            return;
        }
        // IDE 视图状态管理与用户交互调度。
        string content = "";
        if (File.Exists(path)) { content = File.ReadAllText(path); }
        tabs.Add(TabRecord.Create(name, content, path));
        active.Set(tabs.Count - 1);
    }

    // 诊断里的位置解析成一个真实存在的文件路径，定位不到时为 ""。
    // 编译器打印的路径可能是绝对路径、相对工作区根的路径，或用
    // 反斜杠分隔；诊断也可能压根没有位置（`error:` 开头的那种）。
    static string ResolveDiagPath(string root, string p) {
        if (p == null) { return ""; }
        string s = ZanIDE.NormSlashes(p.Trim());
        if (s == "") { return ""; }
        if (File.Exists(s)) { return s; }
        if (root != null && root != "") {
            string j = ZanIDE.NormSlashes(root) + "/" + s;
            if (File.Exists(j)) { return j; }
        }
        return "";
    }

    static IdeDocumentWrite SaveActive(CodeEditor editor, List<TabRecord> tabs,
                                       SignalInt active, string root, List<string> log) {
        int a = active.Get();
        if (a < 0 || a >= tabs.Count) { return null; }
        string p = tabs[a].path;
        if (p.StartsWith("@") || ZanIDE.IsFormPath(p) || ZanIDE.IsScenePath(p)
            || tabs[a].designDoc) { return null; }
        // IDE 工具链交互与状态驱动契约。
        string text = editor.documentPath == p ? editor.GetText() : tabs[a].body;
        tabs[a].body = text;
        if (p == "") {
            p = root + "/" + tabs[a].name;
            tabs[a].path = p;
        }
        // IDE 工具链交互与状态驱动契约。
        return IdeDocumentWrite.Create(p, text);
    }

    // IDE 视图状态管理与用户交互调度。
    // IDE 工具链交互与状态驱动契约。
    // IDE 视图状态管理与用户交互调度。
    static IdeDocumentWrite SaveFormCode(CodeEditor ed, string formPath, string root, List<string> log) {
        string cbp = ZanIDE.CodeBehindPath(formPath);
        return IdeDocumentWrite.Create(cbp, ed.GetText());
    }

    // ---- toolchain ----

    // IDE 工具链交互与状态驱动契约。
    // 核心契约与执行状态转移规范。
    static List<TreeNode> FilterNodes(List<TreeNode> nodes, string filter) {
        if (filter == "") { return nodes; }
        string f = ZanIDE.ToLowerS(filter);
        List<TreeNode> outp = new List<TreeNode>();
        for (int i = 0; i < nodes.Count; i = i + 1) {
            TreeNode n = nodes[i];
            if (!n.isDir && ZanIDE.Has(ZanIDE.ToLowerS(n.label), f)) {
                TreeNode m = TreeNode.FileIcon(n.label, 0, n.icon);
                m.path = n.path;
                outp.Add(m);
            }
        }
        return outp;
    }

    // IDE 视图状态管理与用户交互调度。
    // 核心契约与语义定义。
    static string RunTarget(string p, string root) {
        if (p == "@start" || p == "@docs") {
            string entry = ZanIDE.ProjectEntry(root);
            if (File.Exists(entry)) { return entry; }
            return "";
        }
        if (ZanIDE.IsFormPath(p)) {
            // IDE 工具链交互与状态驱动契约。
            return p;
        }
        if (ZanIDE.IsScenePath(p)) {
            // IDE 工具链交互与状态驱动契约。
            // 核心契约与语义定义。
            return p;
        }
        // IDE 工具链交互与状态驱动契约。
        if (ZanIDE.IsGenPath(p)) {
            string gform = p.Substring(0, p.Length - 6) + ".html";
            if (File.Exists(gform)) { return gform; }
            string gscene = p.Substring(0, p.Length - 6) + ".zscene";
            if (File.Exists(gscene)) { return gscene; }
        }
        // IDE 视图状态管理与用户交互调度。
        if (ZanIDE.IsZanFilePath(p) && !ZanIDE.IsGenPath(p)) {
            string form = p.Substring(0, p.Length - 4) + ".html";
            if (File.Exists(form)) { return form; }
            // IDE 工具链交互与状态驱动契约。
            string scene = p.Substring(0, p.Length - 4) + ".zscene";
            if (File.Exists(scene)) { return scene; }
        }
        // 非源文件（config/app.json、views/*.html、wwwroot 里的资源…）
        // 不是编译输入：它们只是被复制到输出目录（见 ProjCopyItems），
        // 所以在这种标签页上运行 / 构建回到项目入口，
        // 而不是把 JSON 当源码交给编译器。
        if (!ZanIDE.IsZanFilePath(p)) {
            string pentry = ZanIDE.ProjectEntry(root);
            if (File.Exists(pentry)) { return pentry; }
            return "";
        }
        return p;
    }

    // IDE 视图状态管理与用户交互调度。
    // IDE 工具链交互与状态驱动契约。
    // IDE 视图状态管理与用户交互调度。
    // 核心契约与执行状态转移规范。
    static string RibbonRunTarget(string activePath, string root) {
        return ZanIDE.RunTarget(activePath, root);
    }

    // IDE 视图状态管理与用户交互调度。
    // IDE 工具链交互与状态驱动契约。
    static string SmartInputs(string root, string dir, string entry) {
        bool proj = File.Exists(root + "/zan.proj") || File.Exists(dir + "/zan.proj");
        // IDE 工具链交互与状态驱动契约。
        // IDE 视图状态管理与用户交互调度。
        // IDE 工具链交互与状态驱动契约。
        List<string> have = new List<string>();
        have.Add(entry);
        if (!proj) {
            // IDE 工具链交互与状态驱动契约。
            // IDE 视图状态管理与用户交互调度。
            // IDE 工具链交互与状态驱动契约。
            // 核心契约与语义定义。
            string args0 = "\"" + entry + "\"";
            // IDE 工具链交互与状态驱动契约。
            if (ZanIDE.IsDesignFilePath(entry)) {
                string cbp0 = ZanIDE.CodeBehindPath(entry);
                if (File.Exists(cbp0)) { args0 = args0 + " \"" + cbp0 + "\""; have.Add(cbp0); }
            }
            // IDE 工具链交互与状态驱动契约。
            if (ZanIDE.IsScenePath(entry)) {
                string scb0 = ZanIDE.SceneCodeBehindPath(entry);
                if (File.Exists(scb0)) { args0 = args0 + " \"" + scb0 + "\""; have.Add(scb0); }
            }
            return ZanIDE.WithUsedModules(args0, dir, entry, have);
        }
        // IDE 视图状态管理与用户交互调度。
        // IDE 工具链交互与状态驱动契约。
        // 核心契约与语义定义。
        string args = "\"" + entry + "\"";
        List<string> all = new List<string>();
        ZanIDE.GatherZanFiles(dir, all);
        for (int i = 0; i < all.Count; i = i + 1) {
            string f = all[i];
            if (f != entry && !ZanIDE.FileHasMain(f)) {
                args = args + " \"" + f + "\"";
                have.Add(f);
            }
        }
        return ZanIDE.WithUsedModules(args, dir, entry, have);
    }

    // IDE 视图状态管理与用户交互调度。
    // IDE 工具链交互与状态驱动契约。
    // IDE 视图状态管理与用户交互调度。
    // IDE 工具链交互与状态驱动契约。
    // IDE 视图状态管理与用户交互调度。
    // again.
    static string WithUsedModules(string args, string dir, string entry,
                                  List<string> have) {
        List<string> want = new List<string>();
        ZanIDE.CollectUsings(entry, want);
        if (want.Count == 0) { return args; }
        int guard = 0;
        while (want.Count > 0 && guard < 32) {
            guard = guard + 1;
            string ns = want[0];
            want.RemoveAt(0);
            string found = ZanIDE.FindNamespaceFile(dir, ns, entry, have);
            if (found == "") { continue; }
            have.Add(found);
            args = args + " \"" + found + "\"";
            ZanIDE.CollectUsings(found, want);
        }
        return args;
    }

    // IDE 工具链交互与状态驱动契约。
    static void CollectUsings(string path, List<string> outp) {
        if (!File.Exists(path)) { return; }
        List<string> lines = ZanIDE.SplitLinesOf(File.ReadAllText(path));
        for (int i = 0; i < lines.Count; i = i + 1) {
            string ln = lines[i].Trim();
            if (ZanIDE.StartsWith(ln, "using ") && ZanIDE.EndsWithStr(ln, ";")) {
                string ns = ln.Substring(6, ln.Length - 7).Trim();
                if (ns != "" && !outp.Contains(ns)) { outp.Add(ns); }
            }
        }
    }

    // IDE 工具链交互与状态驱动契约。
    static string FindNamespaceFile(string dir, string ns, string entry,
                                    List<string> skip) {
        string at = dir;
        PathFilter dirs = PathFilter.Any().Skip("build dist bin obj publish");
        for (int up = 0; up < 4; up = up + 1) {
            // IDE 视图状态管理与用户交互调度。
            // IDE 工具链交互与状态驱动契约。
            if (dirs.EnterDir(Path.GetFileName(at))) {
                List<string> cand = new List<string>();
                ZanIDE.ListZanFilesIn(at, cand);
                List<string> subs = DirectoryTree.SubDirs(at, dirs);
                for (int s = 0; s < subs.Count; s = s + 1) {
                    ZanIDE.ListZanFilesIn(subs[s], cand);
                }
                for (int i = 0; i < cand.Count; i = i + 1) {
                    string f = cand[i];
                    if (f != entry && !skip.Contains(f)
                        && ZanIDE.DeclaresNamespace(f, ns)
                        && !ZanIDE.FileHasMain(f)) {
                        return f;
                    }
                }
            }
            string parent = ZanIDE.DirOf(at);
            if (parent == at || parent == ".") { return ""; }
            at = parent;
        }
        return "";
    }

    // IDE 工具链交互与状态驱动契约。
    static void ListZanFilesIn(string dir, List<string> outp) {
        DirectoryTree.FlatInto(outp, dir, PathFilter.Only(".zan").Dots(true, true));
    }

    // 核心契约与语义定义。
    static bool DeclaresNamespace(string path, string ns) {
        if (!File.Exists(path)) { return false; }
        return ZanIDE.IndexOfStr(File.ReadAllText(path), "namespace " + ns + ";") >= 0;
    }

    static bool EndsWithStr(string s, string suffix) {
        if (s.Length < suffix.Length) { return false; }
        return s.Substring(s.Length - suffix.Length, suffix.Length) == suffix;
    }

    static List<string> SplitLinesOf(string text) {
        List<string> outp = new List<string>();
        string cur = "";
        for (int i = 0; i < text.Length; i = i + 1) {
            string ch = text.Substring(i, 1);
            if (ch == "\n") { outp.Add(cur); cur = ""; }
            else if (ch != "\r") { cur = cur + ch; }
        }
        if (cur != "") { outp.Add(cur); }
        return outp;
    }

    // IDE 工具链交互与状态驱动契约。
    static bool FileHasMain(string path) {
        if (!File.Exists(path)) { return false; }
        string s = File.ReadAllText(path);
        int i = ZanIDE.IndexOfStr(s, " Main(");
        while (i >= 0) {
            // IDE 工具链交互与状态驱动契约。
            // 核心契约与语义定义。
            int ls = i;
            while (ls > 0 && s.Substring(ls - 1, 1) != "\n") { ls = ls - 1; }
            string line = s.Substring(ls, i - ls);
            if (ZanIDE.IndexOfStr(line, "static ") >= 0) { return true; }
            int nxt = ZanIDE.IndexOfStr(s.Substring(i + 1, s.Length - i - 1), " Main(");
            if (nxt < 0) { return false; }
            i = i + 1 + nxt;
        }
        return false;
    }

    // 核心契约与语义定义。
    // // 按字节比较，不切子串：`hay.Substring(i, n) == needle` 每个位置都要新分配
    // 一个字符串，扫一份几十万字节的流式正文就是几十万次分配。小助手工作时
    // 每 100ms 就要在整段正文上找一次工具块围栏，界面于是一卡一卡的。
    static int IndexOfStr(string hay, string needle) {
        return ZanIDE.IndexOfFrom(hay, needle, 0);
    }

    // Same, starting at `from`. 找一段大正文里的字段时，从调用起点往后扫，
    // 省掉「先切出尾巴再找」那一次整段复制。
    static int IndexOfFrom(string hay, string needle, int from) {
        int n = needle.Length;
        int h = hay.Length;
        if (from < 0) { from = 0; }
        if (n == 0) { return from; }
        int c0 = needle[0] & 255;
        for (int i = from; i + n <= h; i = i + 1) {
            if ((hay[i] & 255) != c0) { continue; }
            int k = 1;
            while (k < n && (hay[i + k] & 255) == (needle[k] & 255)) {
                k = k + 1;
            }
            if (k == n) { return i; }
        }
        return -1;
    }

    // 核心契约与语义定义。
    static int LastIndexOfStr(string hay, string needle) {
        int n = needle.Length;
        int h = hay.Length;
        if (n == 0) { return h; }
        int c0 = needle[0] & 255;
        for (int i = h - n; i >= 0; i = i - 1) {
            if ((hay[i] & 255) != c0) { continue; }
            int k = 1;
            while (k < n && (hay[i + k] & 255) == (needle[k] & 255)) {
                k = k + 1;
            }
            if (k == n) { return i; }
        }
        return -1;
    }

    // IDE 工具链交互与状态驱动契约。
    static int DigitVal(string ch) {
        return ZanIDE.IndexOfStr("0123456789", ch);
    }

    // IDE 视图状态管理与用户交互调度。
    static int ParseLeadInt(string s) {
        int v = 0;
        bool any = false;
        for (int i = 0; i < s.Length; i = i + 1) {
            int d = ZanIDE.DigitVal(s.Substring(i, 1));
            if (d < 0) { break; }
            v = v * 10 + d;
            any = true;
        }
        if (!any) { return -1; }
        return v;
    }

    // IDE 视图状态管理与用户交互调度。
    // IDE 工具链交互与状态驱动契约。
    static string StripAnsi(string s) {
        string esc = Text.ByteChar(27);
        string outp = "";
        int i = 0;
        while (i < s.Length) {
            string ch = s.Substring(i, 1);
            if (ch == esc) {
                i = i + 1;
                while (i < s.Length && s.Substring(i, 1) != "m") { i = i + 1; }
                if (i < s.Length) { i = i + 1; }
            } else {
                outp = outp + ch;
                i = i + 1;
            }
        }
        return outp;
    }

    // IDE 视图状态管理与用户交互调度。
    // IDE 工具链交互与状态驱动契约。
    static void ApplyDiagnostics(CodeEditor editor, string activePath, List<string> output, List<string> log) {
        List<Diagnostic> diagnostics = new List<Diagnostic>();
        bool isZan = activePath.Length > 4
            && activePath.Substring(activePath.Length - 4, 4) == ".zan";
        if (isZan) {
            string baseName = Path.GetFileName(activePath);
            for (int oi = 0; oi < output.Count; oi = oi + 1) {
                string raw = ZanIDE.StripAnsi(output[oi]);
                int ep = ZanIDE.IndexOfStr(raw, ": error:");
                if (ep > 0) {
                    string loc = raw.Substring(0, ep);
                    if (ZanIDE.IndexOfStr(loc, baseName) >= 0) {
                        int c2 = ZanIDE.LastIndexOfStr(loc, ":");
                        if (c2 > 0) {
                            int c1 = ZanIDE.LastIndexOfStr(loc.Substring(0, c2), ":");
                            if (c1 >= 0) {
                                string lineStr = loc.Substring(c1 + 1, c2 - (c1 + 1));
                                int lineNo = ZanIDE.ParseLeadInt(lineStr);
                                if (lineNo > 0) {
                                    string msg = raw.Substring(ep + 8, raw.Length - (ep + 8));
                                    diagnostics.Add(new Diagnostic(lineNo - 1,
                                        ZanIDE.TrimLeadSpaces(msg)));
                                }
                            }
                        }
                    }
                }
            }
        }
        editor.SetCompilerDiagnostics(diagnostics);
        if (diagnostics.Count > 0) {
            log.Add("> " + Convert.ToString(diagnostics.Count) + " error(s) in this file; jumped to the first.");
        }
    }

    // IDE 视图状态管理与用户交互调度。
    // IDE 工具链交互与状态驱动契约。
    // compile.
    static void HotKillRunExe(string exe) {
        string nm = ZanIDE.BaseName(exe);
        #if WINDOWS
        Process.Run("taskkill /F /IM \"" + nm + "\" >nul 2>nul");
        #else
        Process.Run("pkill -f \"" + exe + "\" >/dev/null 2>&1");
        #endif
    }

    // IDE 视图状态管理与用户交互调度。
    // IDE 工具链交互与状态驱动契约。
    // IDE 视图状态管理与用户交互调度。
    // IDE 工具链交互与状态驱动契约。
    static void ClearStaleRunExe(string exe) {
        if (File.Exists(exe)) { File.Delete(exe); }
        if (!File.Exists(exe)) {
            #if !WINDOWS
            // IDE 工具链交互与状态驱动契约。
            ZanIDE.HotKillRunExe(exe);
            #endif
            return;
        }
        ZanIDE.HotKillRunExe(exe);
        if (File.Exists(exe)) { File.Delete(exe); }
    }

    // IDE 视图状态管理与用户交互调度。
    // IDE 工具链交互与状态驱动契约。
    static bool Has(string hay, string needle) {
        int n = needle.Length;
        int h = hay.Length;
        if (n == 0) { return true; }
        for (int i = 0; i + n <= h; i = i + 1) {
            if (hay.Substring(i, n) == needle) { return true; }
        }
        return false;
    }

    // IDE 视图状态管理与用户交互调度。
    // IDE 工具链交互与状态驱动契约。
    // IDE 视图状态管理与用户交互调度。
    // IDE 工具链交互与状态驱动契约。
    static List<string> PublishTargetIds() {
        List<string> ids = new List<string>();
        #if WINDOWS
        ids.Add("windows-x64"); ids.Add("windows-arm64");
        #endif
        #if MACOS
        ids.Add("macos-arm64"); ids.Add("macos-x64");
        ids.Add("linux-x64"); ids.Add("linux-arm64");
        #else
        ids.Add("linux-x64"); ids.Add("linux-arm64");
        ids.Add("macos-arm64"); ids.Add("macos-x64");
        #endif
        // IDE 视图状态管理与用户交互调度。
        // IDE 工具链交互与状态驱动契约。
        ids.Add("android-x64"); ids.Add("android-arm64");
        // IDE 视图状态管理与用户交互调度。
        // IDE 工具链交互与状态驱动契约。
        ids.Add("ohos-x64"); ids.Add("ohos-arm64");
        return ids;
    }

    // IDE 视图状态管理与用户交互调度。
    // IDE 工具链交互与状态驱动契约。
    // 核心契约与语义定义。
    static string HostTargetId() {
        string os = "linux";
        #if WINDOWS
        os = "windows";
        #elif MACOS
        os = "macos";
        #endif
        string arch = "x64";
        #if ARM64
        arch = "arm64";
        #endif
        return os + "-" + arch;
    }

    // IDE 工具链交互与状态驱动契约。
    static string PublishTargetLabel(string id) {
        if (id == "windows-x64") { return "Windows   x64"; }
        if (id == "windows-arm64") { return "Windows   ARM64"; }
        if (id == "macos-x64") { return "macOS   x64"; }
        if (id == "macos-arm64") { return "macOS   ARM64"; }
        if (id == "linux-x64") { return "Linux   x64  (musl static)"; }
        if (id == "linux-arm64") { return "Linux   ARM64  (musl static)"; }
        if (id == "android-x64") { return "Android   x64  (signed APK)"; }
        if (id == "android-arm64") { return "Android   ARM64  (signed APK)"; }
        if (id == "ohos-x64") { return "HarmonyOS   x64  (HAP, emulator)"; }
        if (id == "ohos-arm64") { return "HarmonyOS   ARM64  (HAP)"; }
        return id;
    }

    // IDE 视图状态管理与用户交互调度。
    // IDE 工具链交互与状态驱动契约。
    // 核心契约与执行状态转移规范。
    static bool zancHapProbed;
    static bool zancHapSupported;
    static bool ZancHasEmitHap(string zc) {
        // 一次发布勾选两个鸿蒙架构会走到这里两次；探测对同一个 zanc
        // 前缀结果不会变，缓存住，别每次都在 UI 线程上重复 spawn 进程
        // （升级工具链后重启 IDE 会重新探测）。
        if (zancHapProbed) { return zancHapSupported; }
        // zc 已经是带引号的前缀（ZancCmd：'"exe" --stdlib-path "dir"'），
        // 不能再包一层引号，否则命令损坏、探测恒 false。
        List<string> outp = Process.RunCapture(zc + " --help");
        for (int i = 0; i < outp.Count; i = i + 1) {
            if (ZanIDE.Has(outp[i], "--emit-hap")) {
                zancHapSupported = true;
                break;
            }
        }
        zancHapProbed = true;
        return zancHapSupported;
    }

    // IDE 工具链交互与状态驱动契约。
    // IDE 视图状态管理与用户交互调度。
    // IDE 工具链交互与状态驱动契约。
    // IDE 视图状态管理与用户交互调度。
    // IDE 工具链交互与状态驱动契约。
    // IDE 视图状态管理与用户交互调度。
    // IDE 工具链交互与状态驱动契约。
    static string OhosEnvPrefix(List<string> log) {
        string sdk = ProcessHost.Env("ZAN_OHOS_SDK");
        string deveco = ProcessHost.Env("ZAN_DEVECO_HOME");
        if (sdk == "" && deveco != "" && Directory.Exists(deveco + "/sdk")) {
            sdk = deveco + "/sdk";
        }
        if (sdk == "") {
            string pf = "C:/Program Files/Huawei/DevEco Studio/sdk";
            if (Directory.Exists(pf)) { sdk = pf; }
        }
        if (sdk != "") {
            log.Add("> OHOS SDK: " + sdk);
            #if WINDOWS
            return "set \"DEVECO_SDK_HOME=" + ZanIDE.ToWinPath(sdk) + "\" && ";
            #else
            return "DEVECO_SDK_HOME='" + sdk + "' ";
            #endif
        }
        log.Add(ZanIDE.T(
            "> OHOS SDK not found: install DevEco Studio (or set ZAN_OHOS_SDK to its sdk directory) for hdc install/signing. Building and packaging still work from zanc's bundled toolchain.",
            "> 未找到 OHOS SDK：安装 DevEco Studio（或设置 ZAN_OHOS_SDK 指向其 sdk 目录）以启用 hdc 安装/签名。编译打包用 zanc 自带工具链即可，不受影响。"));
        return "";
    }

    // 读取项目中配置的发布目标平台列表，返回强类型 PublishTargetOption 实体列表
    static List<PublishTargetOption> ReadProjectPlatformOptions(string root) {
        List<string> ids = ZanIDE.PublishTargetIds();
        List<PublishTargetOption> opts = new List<PublishTargetOption>();
        string saved = ZanIDE.ProjField(root, "publishPlatforms");
        bool any = false;
        for (int k = 0; k < ids.Count; k = k + 1) {
            bool sel = false;
            if (saved != "") {
                if (ZanIDE.Has("," + saved + ",", "," + ids[k] + ",")) {
                    sel = true;
                    any = true;
                }
            }
            opts.Add(new PublishTargetOption(ids[k], ZanIDE.PublishTargetLabel(ids[k]), sel));
        }
        if (!any) {
            string platforms = ZanIDE.ProjField(root, "platform");
            for (int k = 0; k < opts.Count; k = k + 1) {
                if (ZanIDE.Has("," + platforms + ",", "," + opts[k].id + ",")) {
                    opts[k].selected = true;
                    any = true;
                }
            }
        }
        if (!any) {
            string host = ZanIDE.HostTargetId();
            for (int k = 0; k < opts.Count; k = k + 1) {
                if (opts[k].id == host) { opts[k].selected = true; }
            }
        }
        return opts;
    }

    // Reads persisted platform selection from zan.proj (兼容旧调用)
    static List<int> ReadProjectPlatforms(string root) {
        List<PublishTargetOption> opts = ZanIDE.ReadProjectPlatformOptions(root);
        List<int> flags = new List<int>();
        for (int i = 0; i < opts.Count; i = i + 1) {
            flags.Add(opts[i].selected ? 1 : 0);
        }
        return flags;
    }

    // IDE 视图状态管理与用户交互调度。
    static string PubLogPath() { return ZanIDE.WindowCacheDir() + "/publish.log"; }
    static string PubDonePath() { return ZanIDE.WindowCacheDir() + "/publish_done.txt"; }

    // IDE 视图状态管理与用户交互调度。
    // IDE 工具链交互与状态驱动契约。
    static string BuildLogPath() { return ZanIDE.WindowCacheDir() + "/build.log"; }
    static string BuildDonePath() { return ZanIDE.WindowCacheDir() + "/build_done.txt"; }

    // IDE 工具链交互与状态驱动契约。
    // IDE 视图状态管理与用户交互调度。
    // IDE 工具链交互与状态驱动契约。
    static string RunCwd(string root, string target, string exe) {
        // IDE 工具链交互与状态驱动契约。
        // IDE 视图状态管理与用户交互调度。
        // IDE 工具链交互与状态驱动契约。
        // IDE 视图状态管理与用户交互调度。
        // IDE 工具链交互与状态驱动契约。
        // IDE 视图状态管理与用户交互调度。
        // 核心契约与执行状态转移规范。
        string troot = ZanIDE.TargetRoot(root, target);
        if (troot != "" && Directory.Exists(troot)) { return troot; }
        string d = ZanIDE.DirOf(target);
        if (d != "" && Directory.Exists(d)) { return d; }
        if (root != "" && Directory.Exists(root)) { return root; }
        return ZanIDE.DirOf(exe);
    }

    static string MissingPackage(List<string> lines) {
        string marker = "ZANPKG_MISSING namespace=";
        for (int i = 0; i < lines.Count; i = i + 1) {
            int at = lines[i].IndexOf(marker);
            if (at >= 0) {
                string ns = lines[i].Substring(at + marker.Length,
                    lines[i].Length - at - marker.Length);
                int end = ns.IndexOf(" ");
                if (end >= 0) { ns = ns.Substring(0, end); }
                ns = ns.Trim();
                // 标准库自带的命名空间（Gui、Gui/Widget、Game/Scene…）不是
                // 缺失的扩展：这种是编译参数/代码的问题，别当成要装扩展。
                if (Directory.Exists(ZanIDE.StdlibDir() + "/" + ns)) { continue; }
                return ZanIDE.ReplaceAll(ns, "/", ".");
            }
        }
        return "";
    }

    // IDE 视图状态管理与用户交互调度。
    // IDE 工具链交互与状态驱动契约。
    // IDE 视图状态管理与用户交互调度。
    // IDE 工具链交互与状态驱动契约。
    // IDE 视图状态管理与用户交互调度。
    // IDE 工具链交互与状态驱动契约。
    static string TargetRoot(string root, string target) {
        string owner = ZanIDE.FindProjectRoot(target);
        if (owner != "") { return owner; }
        string dir = ZanIDE.DirOf(target);
        // IDE 视图状态管理与用户交互调度。
        if (root != "" && ZanIDE.StartsWith(ZanIDE.NormSlashes(target) + "/",
                                            ZanIDE.NormSlashes(root) + "/")) {
            return root;
        }
        if (dir == "" || dir == ".") { return root; }
        return dir;
    }

    // IDE 工具链交互与状态驱动契约。
    // IDE 视图状态管理与用户交互调度。
    // IDE 工具链交互与状态驱动契约。
    static string RunBuildBegin(string root, string target) {
        string troot = ZanIDE.TargetRoot(root, target);
        string bd = ZanIDE.EnsureBuildDir(troot);
        string exe = bd + "/.zanrun" + ZanIDE.ExeSuffix();
        if (ZanIDE.IsLibraryProject(troot)) {
            // IDE 工具链交互与状态驱动契约。
            string baseName = Path.GetFileName(troot);
            if (baseName == "") { baseName = "lib"; }
            exe = bd + "/" + baseName + ZanIDE.HostLibExt();
        }
        ZanIDE.ClearStaleRunExe(exe);
        string inputs = ZanIDE.InputsArg(bd, ".zanrun_inputs",
            ZanIDE.SmartInputs(troot, ZanIDE.DirOf(target), target));
        ZanIDE.BuildDetach(
            ZanIDE.CompileToExe(troot, target, inputs, bd + "/.zanrun.ll", exe, false, false),
            bd);
        return exe;
    }

    // IDE 工具链交互与状态驱动契约。
    static string SymbolIndexPath(string root) {
        return ZanIDE.EnsureBuildDir(root) + "/symbols.idx";
    }

    // IDE 工具链交互与状态驱动契约。
    // IDE 视图状态管理与用户交互调度。
    // IDE 工具链交互与状态驱动契约。
    // IDE 视图状态管理与用户交互调度。
    // IDE 工具链交互与状态驱动契约。
    // 核心契约与执行状态转移规范。
    static string ProjectEntryPath(string root) {
        string entry = "src/main.zan";
        string mpath = root + "/zan.proj";
        if (File.Exists(mpath)) {
            entry = ZanIDE.ManifestField(File.ReadAllText(mpath), "entry", entry);
        }
        string full = root + "/" + entry;
        if (ZanIDE.IsGenPath(full)) {
            string form = full.Substring(0, full.Length - 6) + ".html";
            if (File.Exists(form)) { return form; }
            string scene = full.Substring(0, full.Length - 6) + ".zscene";
            if (File.Exists(scene)) { return scene; }
        }
        if (!File.Exists(full)) { full = root + "/src/main.zan"; }
        return full;
    }

    // IDE 工具链交互与状态驱动契约。
    // IDE 视图状态管理与用户交互调度。
    // IDE 工具链交互与状态驱动契约。
    // IDE 视图状态管理与用户交互调度。
    // IDE 工具链交互与状态驱动契约。
    // 核心契约与语义定义。
    static void EmitSymbolsDetach(string root, string target) {
        string idx = ZanIDE.SymbolIndexPath(root);
        string tmp = idx + ".tmp";
        string inputs = ZanIDE.InputsArg(ZanIDE.EnsureBuildDir(root), ".symbols_inputs",
            ZanIDE.SmartInputs(root, ZanIDE.DirOf(target), target));
        string cmd = ZanIDE.ZancCmd() + " --emit-symbols \"" + tmp + "\" " + inputs
            + " --auto-stdlib";
        #if WINDOWS
        string sep = " && ";
        // IDE 工具链交互与状态驱动契约。
        // IDE 视图状态管理与用户交互调度。
        string mvSrc = ZanIDE.ReplaceAll(tmp, "/", "\\");
        string mvDst = ZanIDE.ReplaceAll(idx, "/", "\\");
        string mv = "move /y \"" + mvSrc + "\" \"" + mvDst + "\"";
        #else
        string sep = " && ";
        string mv = "mv -f \"" + tmp + "\" \"" + idx + "\"";
        #endif
        // IDE 工具链交互与状态驱动契约。
        File.WriteAllText(idx + ".log", "CMD: " + cmd + "\n");
        Process.RunDetached("((" + cmd + ") >> \"" + idx + ".log\" 2>&1)" + sep + mv
            + " >> \"" + idx + ".log\" 2>&1");
    }

    // IDE 视图状态管理与用户交互调度。
    // 核心契约与语义定义。
    static bool LoadSymbolIndexFor(string root) {
        return CodeEditor.LoadSymbolIndex(ZanIDE.SymbolIndexPath(root));
    }

    // IDE 视图状态管理与用户交互调度。
    // // IDE 视图状态管理与用户交互调度。
    // IDE 视图状态管理与用户交互调度。
    // IDE 工具链交互与状态驱动契约。
    // IDE 视图状态管理与用户交互调度。
    // IDE 工具链交互与状态驱动契约。
    void AdoptSymbolIndex() {
        if (adoptedSymbolProject == haveProject && ZanIDE.SamePath(adoptedSymbolRoot, root)) { return; }
        adoptedSymbolRoot = root;
        adoptedSymbolProject = haveProject;
        this.CancelDocumentReads();
        this.CancelCodeNavigation();
        // IDE 视图状态管理与用户交互调度。
        // IDE 工具链交互与状态驱动契约。
        // IDE 视图状态管理与用户交互调度。
        if (lspSess != null) {
            lspSess.Shutdown();
            retiredLanguageServices.Add(lspSess);
        }
        lspSess = null;
        lspTried = false;
        ZanIDE.InvalidateNavFiles();
        CodeEditor.ClearSymbolIndex();
        symbolIdxStamp = 0;
        symbolEmitMs = 0;
        this.StartSymbolMonitor();
        this.ResetJobMonitorWorkspace();
        this.RefreshSymbolIndex(true);
        if (gitPanel != null) { this.gitPanel.SyncWorkspace(); }
    }

    // IDE 视图状态管理与用户交互调度。
    // IDE 工具链交互与状态驱动契约。
    void RefreshSymbolIndex(bool force) {
        if (!haveProject || shuttingDown || symbolMonitor == null) { return; }
        int now = Window.GetTickMs();
        if (!force && symbolEmitMs != 0 && now - symbolEmitMs < 15000) { return; }
        symbolEmitMs = now;
        ZanIDE.InvalidateNavFiles();
        symbolMonitor.requests.Enqueue(new IdeSymbolRefresh());
    }

    // IDE 视图状态管理与用户交互调度。
    // IDE 工具链交互与状态驱动契约。
    // IDE 视图状态管理与用户交互调度。
    static void BuildDetach(string cmd, string bd) {
        ZanIDE.EnsureCacheDir();
        File.WriteAllText(ZanIDE.BuildLogPath(), "");
        if (File.Exists(ZanIDE.BuildDonePath())) { File.Delete(ZanIDE.BuildDonePath()); }
        List<string> steps = new List<string>();
        steps.Add(cmd);
        ZanIDE.ScriptSeqDetach(steps, ZanIDE.BuildLogPath(), ZanIDE.BuildDonePath(),
                               bd, "zanbuild");
    }

    // IDE 视图状态管理与用户交互调度。
    // IDE 工具链交互与状态驱动契约。
    // IDE 视图状态管理与用户交互调度。
    // IDE 工具链交互与状态驱动契约。
    // // IDE 视图状态管理与用户交互调度。
    // IDE 工具链交互与状态驱动契约。
    // IDE 视图状态管理与用户交互调度。
    // IDE 工具链交互与状态驱动契约。
    static void ScriptSeqDetach(List<string> steps, string logPath, string donePath,
                                string bd, string name) {
        ZanIDE.ScriptSeqDetachMarked(steps, null, logPath, donePath, bd, name);
    }

    // IDE 视图状态管理与用户交互调度。
    // IDE 工具链交互与状态驱动契约。
    // IDE 视图状态管理与用户交互调度。
    // IDE 工具链交互与状态驱动契约。
    static void ScriptSeqDetachMarked(List<string> steps, List<string> marks,
                                      string logPath, string donePath,
                                      string bd, string name) {
        StringBuilder sb = new StringBuilder();
        #if WINDOWS
        // IDE 视图状态管理与用户交互调度。
        // IDE 工具链交互与状态驱动契约。
        sb.Append("@echo off\r\nchcp 65001>nul\r\nset ZANFAIL=0\r\n");
        for (int i = 0; i < steps.Count; i = i + 1) {
            if (marks != null && i < marks.Count) {
                sb.Append("echo [" + Convert.ToString(i + 1) + "/"
                    + Convert.ToString(steps.Count) + "] %time% "
                    + marks[i] + " >> \"" + logPath + "\"\r\n");
            }
            sb.Append("(" + steps[i] + ") >> \"" + logPath + "\" 2>&1\r\n");
            sb.Append("if errorlevel 1 set ZANFAIL=1\r\n");
        }
        sb.Append("if \"%ZANFAIL%\"==\"0\" (echo ok> \"" + donePath + "\") "
            + "else (echo fail> \"" + donePath + "\")\r\n");
        // IDE 视图状态管理与用户交互调度。
        // IDE 工具链交互与状态驱动契约。
        // IDE 视图状态管理与用户交互调度。
        string path = ZanIDE.WindowCacheDir() + "/" + name + ".cmd";
        File.WriteAllText(path, sb.ToString());
        // IDE 视图状态管理与用户交互调度。
        // 核心契约与执行状态转移规范。
        int rc = Process.RunDetached("call \"" + ZanIDE.ToWinPath(path) + "\"");
        // IDE 视图状态管理与用户交互调度。
        // IDE 工具链交互与状态驱动契约。
        if (rc != 0) { File.WriteAllText(donePath, "fail"); }
        #else
        sb.Append("#!/bin/sh\nfail=0\n");
        for (int i = 0; i < steps.Count; i = i + 1) {
            if (marks != null && i < marks.Count) {
                sb.Append("echo [" + Convert.ToString(i + 1) + "/"
                    + Convert.ToString(steps.Count) + "] $(date +%H:%M:%S) "
                    + marks[i] + " >> \"" + logPath + "\"\n");
            }
            sb.Append("(" + steps[i] + ") >> \"" + logPath + "\" 2>&1 || fail=1\n");
        }
        sb.Append("if [ $fail -eq 0 ] ; then echo ok > \"" + donePath + "\" ;"
            + " else echo fail > \"" + donePath + "\" ; fi\n");
        string path2 = bd + "/" + name + ".sh";
        File.WriteAllText(path2, sb.ToString());
        int rc2 = Process.RunDetached("sh \"" + path2 + "\"");
        if (rc2 != 0) { File.WriteAllText(donePath, "fail"); }
        #endif
    }

    // IDE 工具链交互与状态驱动契约。
    // 核心契约与执行状态转移规范。
    static bool DoneOk(string donePath) {
        if (!File.Exists(donePath)) { return false; }
        string st = File.ReadAllText(donePath).Trim();
        return st == "ok";
    }

    // IDE 视图状态管理与用户交互调度。
    static int BuildPoll(int consumed, List<string> log) {
        return ZanIDE.PollLogFile(ZanIDE.BuildLogPath(), consumed, log);
    }

    // IDE 视图状态管理与用户交互调度。
    static string ResetStage(string dir) {
        if (Directory.Exists(dir)) { AssetManager.deleteTree(dir); }
        Directory.CreateDirectoryRecursive(dir);
        return dir;
    }

    // IDE 视图状态管理与用户交互调度。
    // IDE 工具链交互与状态驱动契约。
    // IDE 视图状态管理与用户交互调度。
    // IDE 工具链交互与状态驱动契约。
    static string StageEmbedArgs(string stage) {
        string s = "";
        List<string> fs = Directory.GetFiles(stage);
        for (int i = 0; i < fs.Count; i = i + 1) {
            s = s + " --embed \"" + stage + "/" + fs[i] + "=" + fs[i] + "\"";
        }
        List<string> ds = Directory.GetDirectories(stage);
        for (int i = 0; i < ds.Count; i = i + 1) {
            s = s + " --embed \"" + stage + "/" + ds[i] + "=" + ds[i] + "\"";
        }
        return s;
    }

    // IDE 工具链交互与状态驱动契约。
    // IDE 视图状态管理与用户交互调度。
    // 核心契约与语义定义。
    static List<string> PublishPlatformsBegin(string root, List<int> sel,
                                               List<string> log) {
        List<PublishTargetOption> opts = new List<PublishTargetOption>();
        List<string> targetIds = ZanIDE.PublishTargetIds();
        for (int i = 0; i < targetIds.Count; i = i + 1) {
            bool isSel = i < sel.Count && sel[i] == 1;
            opts.Add(new PublishTargetOption(targetIds[i], ZanIDE.PublishTargetLabel(targetIds[i]), isSel));
        }
        return ZanIDE.PublishPlatformsBeginWithOptions(root, opts, log);
    }

    // 使用强类型 PublishTargetOption 实体列表启动发布编译流程
    static List<string> PublishPlatformsBeginWithOptions(string root, List<PublishTargetOption> options,
                                                         List<string> log) {
        List<string> exes = new List<string>();
        string p = ZanIDE.ProjectEntryPath(root);
        if (!File.Exists(p)) {
            log.Add(ZanIDE.T("> Project entry does not exist: ",
                             "> 项目入口不存在：") + p);
            return exes;
        }
        Directory.CreateDirectory(root + "/publish");
        string bd = ZanIDE.EnsureBuildDir(root);
        string zc = ZanIDE.ZancCmd();
        // IDE 工具链交互与状态驱动契约。
        // IDE 视图状态管理与用户交互调度。
        // 核心契约与语义定义。
        string inputs = ZanIDE.InputsArg(bd, ".zanpub_inputs",
            ZanIDE.ProjectInputs(ZanIDE.DirOf(p), p, ""));
        string projName = ZanIDE.ProjField(root, "name");
        string baseName = projName != "" ? projName : Path.GetFileName(root);
        List<string> steps = new List<string>();
        // IDE 视图状态管理与用户交互调度。
        // IDE 工具链交互与状态驱动契约。
        List<string> marks = new List<string>();
        bool isLib = ZanIDE.IsLibraryProject(root);
        // IDE 工具链交互与状态驱动契约。
        // IDE 视图状态管理与用户交互调度。
        bool pack = ZanIDE.ProjSingleFile(root) && !isLib;
        // IDE 工具链交互与状态驱动契约。
        // IDE 视图状态管理与用户交互调度。
        // IDE 工具链交互与状态驱动契约。
        bool dbg = ZanIDE.ProjPublishDebug(root);
        string pubFlag = IdeCompileMode.Flags(true, dbg, false);
        if (dbg) {
            log.Add(ZanIDE.T(
                "> Publish mode: Debug (-g, source locations, runtime checks kept; "
                    + "ARC quarantine/leak table off).",
                "> 发布模式：Debug（-g，保留源码位置与运行时检查；不带 ARC 隔离区与泄漏表）。"));
        } else {
            log.Add(ZanIDE.T(
                "> Publish mode: Release (--publish, optimized + stripped).",
                "> 发布模式：Release（--publish，优化并去除调试信息）。"));
        }
        // IDE 视图状态管理与用户交互调度。
        // IDE 工具链交互与状态驱动契约。
        if (isLib) {
            log.Add(ZanIDE.T("> Library project: publishing shared libraries.",
                             "> 库项目：发布为共享库。"));
        } else if (pack) {
            log.Add(ZanIDE.T(
                "> Single file: resources are embedded in the executable"
                    + "; native drivers are statically linked into the exe"
                    + "; only runtime-loaded drivers (CEF, WebView2) travel"
                    + " beside it.",
                "> 单文件：资源内嵌进可执行文件（直接从 exe 自身读取，"
                    + "不解包到任何目录）；我们自己的原生驱动静态链接进 exe，"
                    + "只有运行时按需加载的驱动（CEF、WebView2）仍随包。"));
        } else {
            log.Add(ZanIDE.T("> Single-file packing is off for this project.",
                             "> 本项目未启用单文件打包。"));
        }
        // IDE 工具链交互与状态驱动契约。
        // IDE 视图状态管理与用户交互调度。
        // 核心契约与执行状态转移规范。
        string hostId = ZanIDE.HostTargetId();
        // IDE 工具链交互与状态驱动契约。
        string emb = ZanIDE.EmbedArgs(root);
        if (emb != "") {
            log.Add(ZanIDE.T("> Embedding project items into the executable.",
                             "> 内嵌项目资源到可执行文件。"));
        }
        for (int ti = 0; ti < options.Count; ti = ti + 1) {
            if (options[ti].selected) {
                string id = options[ti].id;
                // IDE 工具链交互与状态驱动契约。
                string outDir = ZanIDE.PublishDir(root, id);
                if (isLib) {
                    // IDE 工具链交互与状态驱动契约。
                    // 核心契约与语义定义。
                    // IDE 工具链交互与状态驱动契约。
                    string lib = outDir + "/" + baseName + ZanIDE.LibExtFor(id);
                    string ct = "";
                    if (id != hostId) {
                        ct = id;
                        if (id == "windows-arm64") { ct = "win-arm64"; }
                        if (id == "linux-x64") { ct = "linux-musl"; }
                        ct = " --target " + ct;
                    }
                    steps.Add(zc + pubFlag + ct + " " + inputs
                        + " -o \"" + lib + "\"");
                    exes.Add(lib);
                    marks.Add("Publishing " + id + " library");
                    // IDE 工具链交互与状态驱动契约。
                    if (ZanIDE.ProjStaticLib(root)) {
                        string slib = outDir + "/" + baseName
                            + ZanIDE.StaticLibExtFor(id);
                        steps.Add(zc + pubFlag + ct + " "
                            + inputs + " -o \"" + slib + "\"");
                        exes.Add(slib);
                        marks.Add("Publishing " + id + " static library");
                    }
                } else if (id == "windows-x64") {
                    string exe = outDir + "/" + baseName + ".exe";
                    string ll = bd + "/.zanpub_x64.ll";
                    if (pack) {
                        // IDE 视图状态管理与用户交互调度。
                        // IDE 工具链交互与状态驱动契约。
                        string stage = ZanIDE.ResetStage(bd + "/pub_win_x64");
                        ZanIDE.CopyPayloadPacked(root, stage, outDir, p, log);
                        steps.Add(ZanIDE.CompileToExeSingleFile(root, p, inputs, ll,
                            exe, true, dbg)
                            + emb + ZanIDE.StageEmbedArgs(stage));
                    } else {
                        ZanIDE.CopyPayload(root, outDir, p, log);
                        steps.Add(ZanIDE.CompileToExe(root, p, inputs, ll, exe, true, dbg) + emb);
                    }
                    exes.Add(exe);
                    marks.Add("Publishing windows-x64");
                } else if (id == "windows-arm64") {
                    string exe = outDir + "/" + baseName + ".exe";
                    // IDE 工具链交互与状态驱动契约。
                    if (pack) {
                        string stage = ZanIDE.ResetStage(bd + "/pub_win_arm64");
                        ZanIDE.CopyPayloadPacked(root, stage, outDir, p, log);
                        steps.Add(ZanIDE.CompileToExeCross(root, p, inputs, exe, "win-arm64", dbg)
                            + emb + ZanIDE.StageEmbedArgs(stage));
                    } else {
                        ZanIDE.CopyPayload(root, outDir, p, log);
                        steps.Add(ZanIDE.CompileToExeCross(root, p, inputs, exe, "win-arm64", dbg) + emb);
                    }
                    exes.Add(exe);
                    marks.Add("Publishing windows-arm64");
                } else if (id == "macos-x64" || id == "macos-arm64") {
                    // IDE 工具链交互与状态驱动契约。
                    string exe = ZanIDE.MacAppPrepare(root, outDir, baseName,
                        ZanIDE.IsWindowedTarget(root, p), log);
                    ZanIDE.CopyPayload(root, ZanIDE.PayloadDirFor(exe), p, log);
                    if (id == hostId) {
                        steps.Add(ZanIDE.CompileToExe(root, p, inputs, "", exe, true, dbg) + emb);
                    } else {
                        steps.Add(ZanIDE.CompileToExeCross(root, p, inputs, exe, id, dbg) + emb);
                    }
                    exes.Add(exe);
                    marks.Add("Publishing " + id);
                } else if (id == "linux-x64") {
                    // IDE 视图状态管理与用户交互调度。
                    string exe = outDir + "/" + baseName;
                    ZanIDE.CopyPayload(root, outDir, p, log);
                    steps.Add(zc + pubFlag + " " + inputs
                        + " --target linux-musl --link-mode static -o \"" + exe + "\"" + emb);
                    exes.Add(exe);
                    marks.Add("Publishing linux-x64");
                } else if (id == "linux-arm64") {
                    // IDE 工具链交互与状态驱动契约。
                    string exe = outDir + "/" + baseName;
                    ZanIDE.CopyPayload(root, outDir, p, log);
                    steps.Add(zc + pubFlag + " " + inputs
                        + " --target linux-arm64 --link-mode static -o \"" + exe + "\"" + emb);
                    exes.Add(exe);
                    marks.Add("Publishing linux-arm64");
                } else if (id == "android-x64" || id == "android-arm64") {
                    // IDE 工具链交互与状态驱动契约。
                    string apk = outDir + "/" + baseName + ".apk";
                    steps.Add(zc + pubFlag + " " + inputs
                        + " --target " + id + " --emit-apk \"" + apk + "\"" + emb);
                    exes.Add(apk);
                    marks.Add("Publishing " + id + " APK");
                } else if (id == "ohos-x64" || id == "ohos-arm64") {
                    // IDE 视图状态管理与用户交互调度。
                    // IDE 工具链交互与状态驱动契约。
                    // 核心契约与执行状态转移规范。
                    string hap = outDir + "/" + baseName + ".hap";
                    if (!ZanIDE.ZancHasEmitHap(zc)) {
                        log.Add(ZanIDE.T(
                            "> HarmonyOS publish skipped: this zanc has no --emit-hap yet; update the toolchain.",
                            "> 已跳过鸿蒙发布：当前 zanc 尚不支持 --emit-hap，请更新工具链。"));
                    } else {
                        steps.Add(ZanIDE.OhosEnvPrefix(log) + zc + pubFlag + " "
                            + inputs + " --target " + id + " --emit-hap \""
                            + hap + "\"" + emb);
                        exes.Add(hap);
                        marks.Add("Publishing " + id + " HAP");
                    }
                }
            }
        }
        if (steps.Count == 0) {
            log.Add("> No target selected; nothing published.");
            return exes;
        }
        // IDE 工具链交互与状态驱动契约。
        for (int di = 0; di < exes.Count; di = di + 1) {
            if (File.Exists(exes[di])) { File.Delete(exes[di]); }
        }
        ZanIDE.EnsureCacheDir();
        File.WriteAllText(ZanIDE.PubLogPath(), "");
        if (File.Exists(ZanIDE.PubDonePath())) { File.Delete(ZanIDE.PubDonePath()); }
        // IDE 视图状态管理与用户交互调度。
        // IDE 工具链交互与状态驱动契约。
        // 核心契约与执行状态转移规范。
        ZanIDE.ScriptSeqDetachMarked(steps, marks, ZanIDE.PubLogPath(),
                                     ZanIDE.PubDonePath(), bd, "zanpub");
        return exes;
    }

    // IDE 视图状态管理与用户交互调度。
    // TermPoll).
    static int PubPoll(int consumed, List<string> log) {
        return ZanIDE.PollLogFile(ZanIDE.PubLogPath(), consumed, log);
    }

    // IDE 视图状态管理与用户交互调度。
    // IDE 工具链交互与状态驱动契约。
    static string AssetsDir(string root) { return root + "/assets"; }

    // IDE 工具链交互与状态驱动契约。
    static int ResType(string nm) {
        string lo = SceneDesigner.AsciiLower(nm);
        if (ZanIDE.EndsWith(lo, ".png") || ZanIDE.EndsWith(lo, ".jpg")
            || ZanIDE.EndsWith(lo, ".jpeg") || ZanIDE.EndsWith(lo, ".bmp")
            || ZanIDE.EndsWith(lo, ".gif") || ZanIDE.EndsWith(lo, ".tga")
            || ZanIDE.EndsWith(lo, ".ico")) { return 0; }
        if (ZanIDE.EndsWith(lo, ".wav") || ZanIDE.EndsWith(lo, ".mp3")
            || ZanIDE.EndsWith(lo, ".ogg") || ZanIDE.EndsWith(lo, ".flac")
            || ZanIDE.EndsWith(lo, ".mid")) { return 1; }
        if (ZanIDE.EndsWith(lo, ".ttf") || ZanIDE.EndsWith(lo, ".otf")
            || ZanIDE.EndsWith(lo, ".fnt")) { return 2; }
        if (ZanIDE.EndsWith(lo, ".json") || ZanIDE.EndsWith(lo, ".txt")
            || ZanIDE.EndsWith(lo, ".xml") || ZanIDE.EndsWith(lo, ".csv")
            || ZanIDE.EndsWith(lo, ".ini") || ZanIDE.EndsWith(lo, ".zscene")) { return 3; }
        return 4;
    }

    static string ResTypeLabel(int ty) {
        if (ty == 0) { return ZanIDE.T("IMG", "图片"); }
        if (ty == 1) { return ZanIDE.T("AUD", "音频"); }
        if (ty == 2) { return ZanIDE.T("FONT", "字体"); }
        if (ty == 3) { return ZanIDE.T("DATA", "数据"); }
        return ZanIDE.T("MISC", "其它");
    }

    static int ResTypeColor(Theme t, int ty) {
        if (ty == 0) { return t.success; }
        if (ty == 1) { return t.info; }
        if (ty == 2) { return t.warning; }
        if (ty == 3) { return t.primary; }
        return t.textTertiary;
    }

    // IDE 工具链交互与状态驱动契约。
    static List<string> ProjLinks(string root) {
        List<string> outp = new List<string>();
        string proj = root + "/zan.proj";
        if (!File.Exists(proj)) { return outp; }
        List<string> ls = CodeEditor.SplitLines(File.ReadAllText(proj));
        for (int i = 0; i < ls.Count; i = i + 1) {
            string tr = ZanIDE.TrimLeadSpaces(ls[i]);
            if (tr.Length > 5 && tr.Substring(0, 5) == "link ") {
                string rest = ZanIDE.TrimLeadSpaces(tr.Substring(5, tr.Length - 5));
                if (rest.Length > 1 && rest.Substring(0, 1) == "=") {
                    string val = ZanIDE.TrimLeadSpaces(rest.Substring(1, rest.Length - 1));
                    int e = val.Length;
                    while (e > 0) {
                        string ch = val.Substring(e - 1, 1);
                        if (ch == " " || ch == "\t" || ch == "\r") { e = e - 1; }
                        else { break; }
                    }
                    if (e > 0) { outp.Add(val.Substring(0, e)); }
                }
            }
        }
        return outp;
    }

    static void AddProjLink(string root, string path) {
        string proj = root + "/zan.proj";
        string content = "";
        if (File.Exists(proj)) { content = File.ReadAllText(proj); }
        if (content.Length > 0 && content.Substring(content.Length - 1, 1) != "\n") {
            content = content + "\n";
        }
        File.WriteAllText(proj, content + "link = " + path + "\n");
    }

    static void RemoveProjLink(string root, string path) {
        string proj = root + "/zan.proj";
        if (!File.Exists(proj)) { return; }
        List<string> ls = CodeEditor.SplitLines(File.ReadAllText(proj));
        string outp = "";
        for (int i = 0; i < ls.Count; i = i + 1) {
            string tr = ZanIDE.TrimLeadSpaces(ls[i]);
            bool drop = false;
            if (tr.Length > 5 && tr.Substring(0, 5) == "link ") {
                if (ZanIDE.ContainsS(tr, path)) { drop = true; }
            }
            if (!drop && tr.Length > 0) { outp = outp + ls[i] + "\n"; }
        }
        File.WriteAllText(proj, outp);
    }

    // IDE 视图状态管理与用户交互调度。
    static List<string> ListResources(string root) {
        List<string> outp = new List<string>();
        List<string> files = DirectoryTree.Names(ZanIDE.AssetsDir(root),
            PathFilter.Any().Dots(false, false));
        for (int i = 0; i < files.Count; i = i + 1) {
            if (files[i] != "app.ico") { outp.Add(files[i]); }
        }
        return outp;
    }

    // IDE 工具链交互与状态驱动契约。
    // 核心契约与语义定义。
    static string PublishDir(string root, string id) {
        string dir = root + "/publish/" + id;
        Directory.CreateDirectoryRecursive(dir);
        return dir;
    }

    // IDE 视图状态管理与用户交互调度。
    // IDE 工具链交互与状态驱动契约。
    static void CopyResources(string root, string outDir, List<string> log) {
        List<string> res = ZanIDE.ListResources(root);
        List<string> lnks = ZanIDE.ProjLinks(root);
        if (res.Count == 0 && lnks.Count == 0) { return; }
        // IDE 工具链交互与状态驱动契约。
        if (AssetManager.PackEnabled(root)) {
            int packed = AssetManager.PackAssets(root, outDir, lnks, log);
            if (packed >= 0) {
                log.Add("> Packed " + Convert.ToString(packed)
                    + " resource file(s) into " + outDir + "/assets/assets.zrp");
                return;
            }
            log.Add("> Falling back to plain resource copy.");
        }
        string dst = outDir + "/assets";
        Directory.CreateDirectoryRecursive(dst);
        string ad = ZanIDE.AssetsDir(root);
        for (int i = 0; i < res.Count; i = i + 1) {
            File.Copy(ad + "/" + res[i], dst + "/" + res[i]);
        }
        // IDE 工具链交互与状态驱动契约。
        List<string> subs = Directory.GetDirectories(ad);
        int scopied = 0;
        for (int si = 0; si < subs.Count; si = si + 1) {
            scopied = scopied + AssetManager.copyTree(ad + "/" + subs[si], dst + "/" + subs[si]);
        }
        // IDE 工具链交互与状态驱动契约。
        int lcopied = 0;
        for (int li = 0; li < lnks.Count; li = li + 1) {
            if (File.Exists(lnks[li])) {
                File.Copy(lnks[li], dst + "/" + Path.GetFileName(lnks[li]));
                lcopied = lcopied + 1;
            } else {
                log.Add("> WARNING: linked resource missing: " + lnks[li]);
            }
        }
        log.Add("> Bundled " + Convert.ToString(res.Count + scopied + lcopied) + " resource file(s) into " + dst);
    }

    // IDE 工具链交互与状态驱动契约。
    // IDE 视图状态管理与用户交互调度。
    // IDE 工具链交互与状态驱动契约。
    static void CopyContent(string root, string outDir, List<string> log) {
        List<string> items = ZanIDE.ProjCopyItems(root);
        int copied = 0;
        for (int i = 0; i < items.Count; i = i + 1) {
            string sd = root + "/" + items[i];
            if (!Directory.Exists(sd) && !File.Exists(sd)) {
                log.Add("> WARNING: content item missing, skipped: " + items[i]);
                continue;
            }
            copied = copied + ZanIDE.CopyRuleTree(root, items[i], outDir, log);
        }
        if (items.Count > 0) {
            log.Add("> Bundled " + Convert.ToString(copied)
                + " content file(s) into " + outDir);
        }
    }

    // IDE 视图状态管理与用户交互调度。
    // IDE 工具链交互与状态驱动契约。
    static int CopyRuleTree(string root, string rel, string outDir, List<string> log) {
        string src = root + "/" + rel;
        string dst = outDir + "/" + rel;
        if (!Directory.Exists(src)) {
            if (!File.Exists(src)) { return 0; }
            Directory.CreateDirectoryRecursive(Path.GetDirectoryName(dst));
            File.Copy(src, dst);
            return 1;
        }
        Directory.CreateDirectoryRecursive(dst);
        int n = 0;
        List<string> fs = Directory.GetFiles(src);
        for (int i = 0; i < fs.Count; i = i + 1) {
            string f = rel + "/" + fs[i];
            if (ZanIDE.ProjGenRule(root, f) != "") { continue; }
            File.Copy(src + "/" + fs[i], dst + "/" + fs[i]);
            n = n + 1;
        }
        List<string> ds = Directory.GetDirectories(src);
        for (int i = 0; i < ds.Count; i = i + 1) {
            string d = rel + "/" + ds[i];
            if (ZanIDE.ProjGenRule(root, d) != "") { continue; }
            n = n + ZanIDE.CopyRuleTree(root, d, outDir, log);
        }
        return n;
    }

    // IDE 工具链交互与状态驱动契约。
    // IDE 视图状态管理与用户交互调度。
    // 核心契约与语义定义。
    static void CopyPayload(string root, string dir, string sourcePath, List<string> log) {
        ZanIDE.CopyResources(root, dir, log);
        ZanIDE.CopyThemeSkins(root, dir, sourcePath, log);
        ZanIDE.CopyContent(root, dir, log);
    }

    // IDE 视图状态管理与用户交互调度。
    // IDE 工具链交互与状态驱动契约。
    // IDE 视图状态管理与用户交互调度。
    static void CopyPayloadPacked(string root, string stage, string outDir,
                                  string sourcePath, List<string> log) {
        ZanIDE.CopyResources(root, stage, log);
        ZanIDE.CopyThemeSkins(root, stage, sourcePath, log);
        ZanIDE.CopyContent(root, outDir, log);
    }

    // IDE 工具链交互与状态驱动契约。
    // IDE 视图状态管理与用户交互调度。
    // 核心契约与语义定义。
    static void CopyThemeSkins(string root, string outDir, string sourcePath,
                              List<string> log) {
        if (!ZanIDE.IsGuiTarget(root, sourcePath)) { return; }
        // IDE 工具链交互与状态驱动契约。
        // IDE 视图状态管理与用户交互调度。
        // 核心契约与语义定义。
        string src = ZanIDE.StdlibDir() + "/Gui/skins";
        if (!Directory.Exists(src)) {
            src = ZanIDE.StdlibDir() + "/../packages/Zan.Gui/src/Gui/skins";
        }
        if (!Directory.Exists(src)) {
            log.Add("> WARNING: skins requested but no baseline skins folder "
                + "found (looked in stdlib/Gui/skins and "
                + "packages/Zan.Gui/src/Gui/skins).");
            return;
        }
        string packSrc = ZanIDE.StdlibDir() + "/Gui/skins";
        if (!Directory.Exists(packSrc)) {
            packSrc = ZanIDE.StdlibDir() + "/../packages/Zan.Gui.Themes/skins";
        }
        string dst = outDir + "/skins";
        Directory.CreateDirectoryRecursive(dst);
        // IDE 视图状态管理与用户交互调度。
        int baseCopied = 0;
        if (File.Exists(src + "/base.css")) {
            File.Copy(src + "/base.css", dst + "/base.css");
            baseCopied = 1;
        }
        List<string> baseline = new List<string>();
        baseline.Add("dark");
        baseline.Add("light");
        List<string> bundled = new List<string>();
        int baselineCopied = 0;
        for (int i = 0; i < baseline.Count; i = i + 1) {
            string sd = src + "/" + baseline[i];
            if (Directory.Exists(sd)) {
                AssetManager.copyTree(sd, dst + "/" + baseline[i]);
                bundled.Add(baseline[i]);
                baselineCopied = baselineCopied + 1;
            } else {
                log.Add("> WARNING: skin not found, skipped: " + baseline[i]);
            }
        }
        int extraCopied = 0;
        if (ZanIDE.ProjSkinsEnabled(root)) {
            List<string> want = ZanIDE.ProjSkinList(root);
            for (int i = 0; i < want.Count; i = i + 1) {
                if (bundled.Contains(want[i])) { continue; }
                string sd = packSrc + "/" + want[i];
                if (Directory.Exists(sd)) {
                    AssetManager.copyTree(sd, dst + "/" + want[i]);
                    bundled.Add(want[i]);
                    extraCopied = extraCopied + 1;
                } else {
                    log.Add("> WARNING: skin not found, skipped: " + want[i]);
                }
            }
        }
        log.Add("> Bundled " + Convert.ToString(baseCopied)
            + " base.css file(s), " + Convert.ToString(baselineCopied)
            + " baseline skin pack(s) and " + Convert.ToString(extraCopied)
            + " extra skin pack(s) into " + dst);
    }
}
