partial class ZanIDE {
    static string AiCfgPath() { return ZanIDE.UserConfigDir() + "/ai.cfg"; }

    static void AiCancelRequest() {
        AiNet.Abandon();
        // 工具线程同理：停下这一轮之后，一个还在写/还在扫的调用不能等它跑完
        // 再把结果接到下一个问题的后面。
        AiWork.Abandon();
    }

    static void DeleteIfExists(string path) {
        if (File.Exists(path)) { File.Delete(path); }
    }

    static string KvField(string content, string key) {
        List<string> ls = CodeEditor.SplitLines(content);
        for (int i = 0; i < ls.Count; i = i + 1) {
            string tr = ZanIDE.TrimLeadSpaces(ls[i]);
            if (tr.Length >= key.Length && tr.Substring(0, key.Length) == key) {
                string rest = ZanIDE.TrimLeadSpaces(tr.Substring(key.Length, tr.Length - key.Length));
                if (rest.Length > 0 && rest.Substring(0, 1) == "=") {
                    string val = ZanIDE.TrimLeadSpaces(rest.Substring(1, rest.Length - 1));
                    int e = val.Length;
                    while (e > 0) {
                        string ch = val.Substring(e - 1, 1);
                        if (ch == " " || ch == "\t" || ch == "\r" || ch == "\n") { e = e - 1; }
                        else { break; }
                    }
                    return val.Substring(0, e);
                }
            }
        }
        return "";
    }

    static string AiSetting(string key, string envName, string def) {
        if (File.Exists(ZanIDE.AiCfgPath())) {
            string v = ZanIDE.KvField(File.ReadAllText(ZanIDE.AiCfgPath()), key);
            if (v != "") { return v; }
        }
        string e = getenv(envName);
        if (e != null && e != "") { return e; }
        return def;
    }

    // "roles": {"<role id>": "<model id>"}}]}
    static string AiProfilesPath() { return ZanIDE.UserConfigDir() + "/ai_profiles.json"; }
    static AiModelsFetchReq aiModelsFetch;
    static string AiModelsRespPath() { return ZanIDE.WindowCacheDir() + "/ai_models.json"; }
    static string AiModelsDonePath() { return ZanIDE.WindowCacheDir() + "/ai_models_done.txt"; }

    static string ExtractObjectJson(JsonDoc doc, int node) {
        if (node < 0 || doc.KindAt(node) != 5) { return "{}"; }
        return doc.ToJson(node);
    }

    static int AiProfilesLoad(List<AiProfile> profiles) {
        int active = 0;
        if (File.Exists(ZanIDE.AiProfilesPath())) {
            string text = File.ReadAllText(ZanIDE.AiProfilesPath());
            if (text != "") {
                JsonDoc.ParseScoped(text, (JsonDoc v) => {
                    if (v.KindAt(0) != 5) { return; }
                    active = (int)v.Long(0, "active", 0L);
                    int ps = v.Get(0, "profiles");
                    if (ps >= 0 && v.KindAt(ps) == 4) {
                        int p = v.FirstChild(ps);
                        int idx = 0;
                        while (p >= 0) {
                            if (v.KindAt(p) == 5) {
                                string modelList = "";
                                int ms = v.Get(p, "models");
                                if (ms >= 0 && v.KindAt(ms) == 4) {
                                    int mv = v.FirstChild(ms);
                                    while (mv >= 0) {
                                        if (v.KindAt(mv) == 3) {
                                            string mid = v.StrAt(mv, "");
                                            if (mid != "") {
                                                if (modelList != "") { modelList = modelList + ";"; }
                                                modelList = modelList + mid;
                                            }
                                        }
                                        mv = v.NextSibling(mv);
                                    }
                                }
                                string limitMap = ZanIDE.ExtractObjectJson(v, v.Get(p, "limits"));
                                string roleMap = ZanIDE.ExtractObjectJson(v, v.Get(p, "roles"));
                                AiProfile loaded = AiProfile.Create(
                                    v.Str(p, "name", "AI " + (idx + 1).ToString()),
                                    v.Str(p, "base", ""), v.Str(p, "key", ""),
                                    v.Str(p, "model", ""), modelList, limitMap);
                                loaded.roles = roleMap;
                                profiles.Add(loaded);
                                idx = idx + 1;
                            }
                            p = v.NextSibling(p);
                        }
                    }
                });
            }
        }
        if (profiles.Count == 0) {
            profiles.Add(AiProfile.Create(ZanIDE.T("Default", "默认"),
                ZanIDE.AiSetting("base", "OPENAI_BASE_URL", "https://api.openai.com/v1"),
                ZanIDE.AiSetting("key", "OPENAI_API_KEY", ""),
                ZanIDE.AiSetting("model", "OPENAI_MODEL", "gpt-4o-mini"), "", "{}"));
            active = 0;
        }
        if (active < 0 || active >= profiles.Count) { active = 0; }
        return active;
    }

    static List<AiProfile> AiProfilesHold(List<AiProfile> profiles) {
        List<AiProfile> hold = new List<AiProfile>();
        for (int i = 0; i < profiles.Count; i = i + 1) {
            hold.Add(profiles[i]);
        }
        return hold;
    }

    static void AiProfilesSave(int active, List<AiProfile> profiles) {
        JsonWriter w = new JsonWriter();
        w.StartObject();
        w.WriteProperty("active", active);
        w.WriteKey("profiles");
        w.StartArray();
        for (int i = 0; i < profiles.Count; i = i + 1) {
            AiProfile profile = profiles[i];
            w.StartObject();
            w.WriteProperty("name", profile.name);
            w.WriteProperty("base", profile.baseUrl);
            w.WriteProperty("key", profile.key);
            w.WriteProperty("model", profile.model);
            w.WriteKey("models");
            w.StartArray();
            List<string> models = ZanIDE.SplitList(profile.models);
            for (int j = 0; j < models.Count; j = j + 1) {
                w.WriteString(models[j]);
            }
            w.EndArray();
            string limitMap = profile.limits;
            if (limitMap.IsNullOrEmpty()) { limitMap = "{}"; }
            w.WriteRawProperty("limits", limitMap);
            string roleMap = profile.roles;
            if (roleMap.IsNullOrEmpty()) { roleMap = "{}"; }
            w.WriteRawProperty("roles", roleMap);
            w.EndObject();
        }
        w.EndArray();
        w.EndObject();
        Directory.CreateDirectoryRecursive(ZanIDE.UserConfigDir());
        File.WriteAllText(ZanIDE.AiProfilesPath(), w.ToJson());
    }

    static int ParseIntSafe(string s) {
        if (s == null) { return 0; }
        int n = 0;
        bool any = false;
        for (int i = 0; i < s.Length; i = i + 1) {
            int d = ZanIDE.IndexOfStr("0123456789", s.Substring(i, 1));
            if (d >= 0) {
                n = n * 10 + d;
                any = true;
            } else if (any) {
                break;
            }
        }
        return n;
    }

    static int AiLimitInt(string mapJson, string model, string field) {
        if (mapJson.IsNullOrEmpty() || model.IsNullOrEmpty()) { return 0; }
        int result = 0;
        JsonDoc.ParseScoped(mapJson, (JsonDoc v) => {
            if (v.KindAt(0) != 5) { return; }
            int mo = v.Get(0, model);
            if (mo >= 0 && v.KindAt(mo) == 5) {
                result = (int)v.Long(mo, field, 0L);
            }
        });
        return result;
    }

    static string AiLimitStr(string mapJson, string model, string field) {
        int n = ZanIDE.AiLimitInt(mapJson, model, field);
        if (n <= 0) { return ""; }
        return n.ToString();
    }

    static string AiLimitSet(string mapJson, string model, string field, string val) {
        if (model.IsNullOrEmpty()) { return mapJson; }
        int n = ZanIDE.ParseIntSafe(val);
        Dictionary<string, Dictionary<string, int>> dict = new Dictionary<string, Dictionary<string, int>>();
        if (!mapJson.IsNullOrEmpty() && mapJson != "{}") {
            JsonDoc.ParseScoped(mapJson, (JsonDoc v) => {
                if (v.KindAt(0) != 5) { return; }
                int cnt = v.Count(0);
                for (int i = 0; i < cnt; i = i + 1) {
                    string mod = v.KeyAt(0, i);
                    int p = v.ValAt(0, i);
                    if (v.KindAt(p) == 5) {
                        Dictionary<string, int> sub = new Dictionary<string, int>();
                        int fcnt = v.Count(p);
                        for (int j = 0; j < fcnt; j = j + 1) {
                            string fk = v.KeyAt(p, j);
                            int fval = v.ValAt(p, j);
                            sub[fk] = (int)v.LongAt(fval, 0L);
                        }
                        dict[mod] = sub;
                    }
                }
            });
        }
        Dictionary<string, int> target = null;
        if (!dict.TryGetValue(model, out target) || target == null) {
            target = new Dictionary<string, int>();
            dict[model] = target;
        }
        target[field] = n;
        JsonWriter w = new JsonWriter();
        w.StartObject();
        List<string> models = dict.Keys;
        for (int i = 0; i < models.Count; i = i + 1) {
            string m = models[i];
            w.WriteKey(m);
            w.StartObject();
            Dictionary<string, int> sub = dict[m];
            List<string> fields = sub.Keys;
            for (int j = 0; j < fields.Count; j = j + 1) {
                w.WriteProperty(fields[j], sub[fields[j]]);
            }
            w.EndObject();
        }
        w.EndObject();
        return w.ToJson();
    }

    static string AiRoleModel(string mapJson, string roleId) {
        if (mapJson.IsNullOrEmpty() || roleId.IsNullOrEmpty()) { return ""; }
        string result = "";
        JsonDoc.ParseScoped(mapJson, (JsonDoc v) => {
            if (v.KindAt(0) == 5) {
                result = v.Str(0, roleId, "");
            }
        });
        return result;
    }

    static string AiRoleModelSet(string mapJson, string roleId, string model) {
        if (roleId.IsNullOrEmpty()) { return mapJson; }
        if (model == null) { model = ""; }
        Dictionary<string, string> dict = new Dictionary<string, string>();
        if (!mapJson.IsNullOrEmpty() && mapJson != "{}") {
            JsonDoc.ParseScoped(mapJson, (JsonDoc v) => {
                if (v.KindAt(0) == 5) {
                    int cnt = v.Count(0);
                    for (int i = 0; i < cnt; i = i + 1) {
                        string k = v.KeyAt(0, i);
                        int valSlot = v.ValAt(0, i);
                        dict[k] = v.StrAt(valSlot, "");
                    }
                }
            });
        }
        dict[roleId] = model;
        JsonWriter w = new JsonWriter();
        w.StartObject();
        List<string> keys = dict.Keys;
        for (int i = 0; i < keys.Count; i = i + 1) {
            w.WriteProperty(keys[i], dict[keys[i]]);
        }
        w.EndObject();
        return w.ToJson();
    }

    static string AiRolePromptsPath() {
        return ZanIDE.UserConfigDir() + "/ai_role_prompts.json";
    }

    static string AiRolePromptsLoad() {
        if (!File.Exists(ZanIDE.AiRolePromptsPath())) { return "{}"; }
        string text = File.ReadAllText(ZanIDE.AiRolePromptsPath());
        if (text.IsNullOrEmpty()) { return "{}"; }
        return text;
    }

    static void AiRolePromptsSave(string mapJson) {
        if (mapJson.IsNullOrEmpty()) { mapJson = "{}"; }
        Directory.CreateDirectoryRecursive(ZanIDE.UserConfigDir());
        File.WriteAllText(ZanIDE.AiRolePromptsPath(), mapJson);
    }

    // ---- 助手行为（ai_behavior.json）----
    // {"autoCont": 40}：一次提问最多自动接着跑几拍。0 = 不限，
    // 缺这个字段 = 从没配过，用 AiAgent.MaxContinues() 的内置默认。
    // 单独一个文件而不是塞进 ai_profiles.json：它跟服务商无关，换服务商、
    // 删配置都不该把它带走（ai_role_prompts.json 同理）。
    static string AiBehaviorPath() {
        return ZanIDE.UserConfigDir() + "/ai_behavior.json";
    }

    // 配置里的自动继续上限，-1 表示没配过。
    static int AiAutoContLoad() {
        if (!File.Exists(ZanIDE.AiBehaviorPath())) { return 0 - 1; }
        string text = File.ReadAllText(ZanIDE.AiBehaviorPath());
        if (text == "") { return 0 - 1; }
        int result = 0 - 1;
        JsonDoc.ParseScoped(text, (JsonDoc v) => {
            if (v.KindAt(0) == 5) {
                result = (int)v.Long(0, "autoCont", -1L);
            }
        });
        return result;
    }

    static void AiAutoContSave(int configured) {
        if (configured < 0) { configured = 0 - 1; }
        JsonWriter w = new JsonWriter();
        w.StartObject();
        w.WriteProperty("autoCont", configured);
        w.EndObject();
        Directory.CreateDirectoryRecursive(ZanIDE.UserConfigDir());
        File.WriteAllText(ZanIDE.AiBehaviorPath(), w.ToJson());
    }

    // 一个服务商在模型选择器里应当出现的模型：默认模型在最前，其后是
    // 抓取到的模型，去重，并去掉在 AI 设置里取消勾选的
    // （`limits[model].off == 1`）。聊天框与 AI 设置共用这一条规则。
    static List<string> AiEnabledModels(AiProfile profile) {
        List<string> outp = new List<string>();
        if (profile == null) { return outp; }
        if (!profile.model.IsNullOrEmpty()) { outp.Add(profile.model); }
        List<string> fetched = ZanIDE.SplitList(profile.models);
        for (int i = 0; i < fetched.Count; i = i + 1) {
            bool dup = false;
            for (int k = 0; k < outp.Count; k = k + 1) {
                if (outp[k] == fetched[i]) { dup = true; }
            }
            bool hidden = ZanIDE.AiLimitInt(profile.limits, fetched[i], "off") == 1;
            if (!dup && !hidden) { outp.Add(fetched[i]); }
        }
        return outp;
    }

    // 所有服务商的启用模型，标签写成 "<服务商> / <模型>"，所以两家
    // 提供同一个模型 id 也能分清。聊天框的模型下拉和 AI 设置里的助手
    // 模型下拉都从这里取候选，两处不会漂移。
    static List<ModelOption> AiModelOptions(List<AiProfile> profiles) {
        List<ModelOption> opts = new List<ModelOption>();
        if (profiles == null) { return opts; }
        for (int pi = 0; pi < profiles.Count; pi = pi + 1) {
            AiProfile profile = profiles[pi];
            if (profile == null) { continue; }
            List<string> ms = ZanIDE.AiEnabledModels(profile);
            for (int mi = 0; mi < ms.Count; mi = mi + 1) {
                opts.Add(ModelOption.Of(pi, ms[mi],
                    profile.name + " / " + ms[mi]));
            }
        }
        return opts;
    }

    static List<string> SplitList(string s) {
        List<string> outp = new List<string>();
        if (s == null) { return outp; }
        string cur = "";
        for (int i = 0; i < s.Length; i = i + 1) {
            string ch = s.Substring(i, 1);
            if (ch == ";") {
                if (cur != "") { outp.Add(cur); }
                cur = "";
            } else {
                cur = cur + ch;
            }
        }
        if (cur != "") { outp.Add(cur); }
        return outp;
    }

    static string AiFetchModels(string baseUrl, string key) {
        if (key == "") {
            return ZanIDE.T("Set the API key first.", "请先填写 API 密钥。");
        }
        if (baseUrl == "") { baseUrl = "https://api.openai.com/v1"; }
        while (baseUrl.Length > 0
            && baseUrl.Substring(baseUrl.Length - 1, 1) == "/") {
            baseUrl = baseUrl.Substring(0, baseUrl.Length - 1);
        }
        ExternalTarget target = ExternalTarget.Parse(baseUrl);
        if (target == null || target.Query() != "") {
            return ZanIDE.T("Invalid API base URL.", "接口地址无效。");
        }
        bool local = ExternalTargetPolicy.AllowExactLocal(baseUrl,
            "http://127.0.0.1:11434/v1");
        if (!ExternalTargetPolicy.IsAllowedTarget(target, local, local)) {
            return ZanIDE.T("API endpoint is not allowed.", "接口地址不在允许范围内。");
        }
        ZanIDE.EnsureCacheDir();
        if (File.Exists(ZanIDE.AiModelsRespPath())) { File.Delete(ZanIDE.AiModelsRespPath()); }
        if (File.Exists(ZanIDE.AiModelsDonePath())) { File.Delete(ZanIDE.AiModelsDonePath()); }
        AiModelsFetchReq rq = new AiModelsFetchReq();
        rq.baseUrl = baseUrl;
        rq.key = key;
        ZanIDE.aiModelsFetch = rq;
        if (!Thread.Start(ZanIDE.AiFetchModelsWorker)) {
            ZanIDE.aiModelsFetch = null;
            return ZanIDE.T("Could not start model fetch.", "无法启动模型获取。");
        }
        return "";
    }

    static void AiFetchModelsWorker() {
        AiModelsFetchReq rq = ZanIDE.aiModelsFetch;
        if (rq == null) { return; }
        string marker = "err: model fetch failed";
        try {
            ExternalTarget target = ExternalTarget.Parse(rq.baseUrl);
            if (target == null || target.Query() != "") {
                File.WriteAllText(ZanIDE.AiModelsDonePath(),
                    "err: invalid API base URL");
                return;
            }
            bool local = ExternalTargetPolicy.AllowExactLocal(rq.baseUrl,
                "http://127.0.0.1:11434/v1");
            ExternalCallPolicy policy = AiNet.Policy(local, "", 60000);
            HttpClient cli;
            if (target.IsTls()) {
                cli = HttpClient.CreateHttps(target.Host(), target.Port());
            } else {
                cli = new HttpClient(target.Host(), target.Port());
            }
            cli.SetCallPolicy(policy);
            cli.SetTimeout(policy.TotalTimeoutMs());
            cli.SetHeader("Authorization", "Bearer " + rq.key);
            string path = target.Path();
            while (path.Length > 1 && path.Substring(path.Length - 1, 1) == "/") {
                path = path.Substring(0, path.Length - 1);
            }
            int retry = 0;
            string raw = "";
            while (true) {
                try {
                    raw = await cli.GetAsync(path + "/models");
                    marker = "ok";
                    break;
                } catch (Exception ex) {
                    marker = "err: " + ex.Message;
                    if (!policy.CanRetry("GET", false, 0)
                        || retry >= policy.RetryAttempts()) { break; }
                    retry = retry + 1;
                    int delay = policy.RetryBackoffMs() * retry;
                    if (delay > 0) { await Task.Delay(delay); }
                }
            }
            File.WriteAllText(ZanIDE.AiModelsRespPath(), raw);
        } catch (Exception ex) {
            marker = "err: " + ex.Message;
        }
        File.WriteAllText(ZanIDE.AiModelsDonePath(), marker);
    }

    static string AiReadModels() {
        if (!File.Exists(ZanIDE.AiModelsRespPath())) { return ""; }
        string raw = File.ReadAllText(ZanIDE.AiModelsRespPath());
        if (raw == "") { return ""; }
        string outp = "";
        JsonDoc.ParseScoped(raw, (JsonDoc v) => {
            if (v.KindAt(0) == 5) {
                int dataNode = v.Get(0, "data");
                if (dataNode >= 0 && v.KindAt(dataNode) == 4) {
                    int p = v.FirstChild(dataNode);
                    while (p >= 0) {
                        string id = v.Str(p, "id", "");
                        if (id != "") {
                            if (outp != "") { outp = outp + ";"; }
                            outp = outp + id;
                        }
                        p = v.NextSibling(p);
                    }
                }
            }
        });
        return outp;
    }

    static string AiStripFence(string s) {
        if (s.Length >= 7 && s.Substring(0, 7) == "[error]") { return ""; }
        string r = s;
        if (r.Length >= 3 && r.Substring(0, 3) == "```") {
            int nl = 0;
            for (; nl < r.Length && r.Substring(nl, 1) != "\n"; nl = nl + 1) { }
            if (nl < r.Length) { r = r.Substring(nl + 1, r.Length - nl - 1); }
            else { r = ""; }
            int endF = r.Length - 1;
            for (endF = r.Length - 1; endF >= 0 && (r.Substring(endF, 1) == "\n" || r.Substring(endF, 1) == " "); endF = endF - 1) {
            }
            if (endF >= 2 && r.Substring(endF - 2, 3) == "```") {
                r = r.Substring(0, endF - 2);
            }
        }
        return r;
    }

    static string AiLastCode(List<ChatMessage> msgs) {
        for (int i = msgs.Count - 1; i >= 0; i = i - 1) {
            if (msgs[i].role == "assistant") {
                string s = msgs[i].text;
                int a = ZanIDE.IndexOfStr(s, "```");
                if (a < 0) { return ""; }
                int ls = a + 3;
                while (ls < s.Length && s.Substring(ls, 1) != "\n") { ls = ls + 1; }
                ls = ls + 1;
                if (ls >= s.Length) { return ""; }
                string rest = s.Substring(ls, s.Length - ls);
                int b = ZanIDE.IndexOfStr(rest, "```");
                if (b <= 0) { return ""; }
                return rest.Substring(0, b);
            }
        }
        return "";
    }

    static string AiLaunchAs(string agent, List<ChatMessage> msgs,
            string ctxName, string ctxCode, string projRoot,
            string baseUrl, string key, string model, bool countRequest = true) {
        if (key == "") {
            return ZanIDE.T(
                "No API key. Open the AI panel's Config editor and fill in the key for the enabled profile.",
                "未配置 API 密钥。请在小赞面板的“配置”中为启用的配置填写密钥。");
        }
        if (baseUrl == "") { baseUrl = "https://api.openai.com/v1"; }
        if (agent != "") {
            string roleModel = AiTeam.ModelOf(agent);
            if (roleModel != "") { model = roleModel; }
        }
        if (model == "") { model = "gpt-4o-mini"; }
        // 每一拍发请求都发生在 UI 线程的那一帧里（点发送、工具跑完续跑、
        // 重试），所以这里花掉的毫秒就是那一帧的卡顿。开着 ZAN_FRAME_PROF
        // 时按阶段记一行，好分清是项目参考的磁盘扫描、上下文拼装、JSON
        // 序列化还是前缀比对在吃时间。
        int aiT0 = 0;
        if (App.PerfOn()) { aiT0 = Window.GetTickMs(); }
        // 现场里的大块内容（打开文件的正文、项目参考的新版本）只在真的变了
        // 的时候作为一条工具消息钉进对话：只追加、不重发。于是它下一拍就落在
        // 缓存前缀里（以前每一拍重发一遍，一次提问二十拍白扔十几万字节），
        // 而且它一直在历史里看得见——模型不必为了看自己刚看过的正文再发一次
        // read_file（用户看到的「反复读同一段代码」就是这么来的）。
        List<string> aiPins = AiAgent.PinNotes(ctxName, ctxCode, projRoot);
        for (int pi = 0; pi < aiPins.Count; pi = pi + 1) {
            msgs.Add(ChatMessage.Create("tool", aiPins[pi]));
        }
        AiChatBodyMaxDoc body = new AiChatBodyMaxDoc();
        body.model = model;
        body.stream = true;
        body.stream_options = new AiStreamOptionsDoc();
        body.stream_options.include_usage = true;
        body.messages = new List<ChatMessageDoc>();
        // them can never drift apart. 这一段是定死的文本，逐字节不变 ——
        // prompt 缓存按前缀匹配，把「当前打开的文件 / 项目结构 / 任务图」这些
        // 每一拍都在变的现场写进系统消息，等于每一拍都换掉整份前缀，缓存命中
        // 率就永远是 0。会变的现场作为最后一条消息发（见下面的 ctxMsg）。
        // 团队模式下这一段还要与「这一拍是谁在说话」无关：七个成员各发一份自己的
        // 系统提示、而团队几乎每一拍都在换人时，能命中的只有大家共有的那一小
        // 段（实测停在 4.9K token，后面两万 token 每拍重算）。所以全队共用同一份
        // 系统提示（含七份章程），本拍的身份跟着现场走最后一条消息。
        string sysMsg = AiAgent.BaseInstructions();
        if (agent != "") { sysMsg = AiTeam.TeamPrompt(); }
        // 项目结构和项目知识也挂在这里：它们只在项目本身变了才变，却有一万多
        // 字节。跟着每一拍的现场重发就等于每一拍白扔一万多字节的缓存，所以定
        // 型一份进前缀（真变了由现场那条消息补差异，见 `ContextBlock`）。
        string projRef = AiAgent.ProjectRef(projRoot);
        if (projRef != "") { sysMsg = sysMsg + "\n\n" + projRef; }
        ChatMessageDoc sys = new ChatMessageDoc();
        sys.role = "system";
        // 洗一遍：带非法字节的请求体会被服务端整包 400（invalid unicode
        // code point），而那些字节可能来自任何一份读进来的文件或命令输出。
        sys.content = AiAgent.SafeUtf8(sysMsg);
        body.messages.Add(sys);
        int aiT1 = 0;
        if (App.PerfOn()) { aiT1 = Window.GetTickMs(); }
        // 上下文和压缩都按「这一次发请求的成员 + 它自己那个模型」来算：一个
        // 8k 窗口的成员该压缩的时候必须压缩，而它压缩不能拿别人 200k 的窗口
        // 当预算（也不能反过来把大窗口的成员按小窗口砍掉一半上下文）。
        List<ChatMessage> src = msgs;
        if (agent != "") { src = AiTeam.ContextFor(agent, msgs); }
        AiMessages msgs2 = AiAgent.BuildContext(src,
            AiAgent.MaxContextCharsOf(model), agent);
        for (int i = 0; i < msgs2.msgs.Count; i = i + 1) {
            string role = msgs2.msgs[i].role;
            if (role == "tool") { role = "user"; }
            if (role == "user" || role == "assistant") {
                ChatMessageDoc m = new ChatMessageDoc();
                m.role = role;
                // 正文 + 这一拍真正发出的工具调用：历史里只留正文的话，模型
                // 会照着「read_file src/X.zan」这种大白话学，下一拍就发不出
                // 可执行的调用（那一拍就白跑了）。
                string body2 = msgs2.msgs[i].text;
                if (msgs2.msgs[i].call != "") {
                    if (body2 == "") { body2 = msgs2.msgs[i].call; }
                    else { body2 = body2 + "\n\n" + msgs2.msgs[i].call; }
                }
                m.content = AiAgent.SafeUtf8(body2);
                body.messages.Add(m);
            }
        }
        // 这一拍的现场（打开的文件、项目结构、项目知识、任务图）作为最后一条
        // 消息：它每一拍都在变，放在最后就只废掉自己这一段，前面的系统指令加
        // 整段对话仍然逐字节等于上一拍的前缀，于是供应商的 prompt 缓存能命中
        // 到「上一拍为止的全部内容」。角色用 user：OpenAI 兼容端点（含本地
        // 模型）都收 user，而尾部的 system 有的实现会忽略。
        int aiT2 = 0;
        if (App.PerfOn()) { aiT2 = Window.GetTickMs(); }
        ChatMessageDoc ctxMsg = new ChatMessageDoc();
        ctxMsg.role = "user";
        string ctxBody = AiAgent.ContextBlock(ctxName, ctxCode, projRoot);
        if (agent != "") { ctxBody = AiTeam.SelfPrompt(agent) + ctxBody; }
        ctxMsg.content = AiAgent.SafeUtf8(ctxBody);
        body.messages.Add(ctxMsg);
        int aiT3 = 0;
        if (App.PerfOn()) { aiT3 = Window.GetTickMs(); }
        int maxOut = AiAgent.MaxOutTokensOf(model);
        string payload = "";
        if (maxOut > 0) {
            body.max_tokens = maxOut;
            payload = Json.Serialize<AiChatBodyMaxDoc>(body);
        } else {
            payload = Json.Serialize<AiChatBodyDoc>(body);
        }
        // 这一拍的请求体跟上一拍到底有多少字节是逐字相同的前缀：供应商报的
        // cached_tokens 让人觉得不对的时候，只有这个数能分清是谁的问题。
        int aiT4 = 0;
        if (App.PerfOn()) { aiT4 = Window.GetTickMs(); }
        ZanIDE.AiPrefixNote(model, payload);
        int aiT5 = 0;
        if (App.PerfOn()) { aiT5 = Window.GetTickMs(); }
        string serr = AiNet.Start(baseUrl, "/chat/completions", key,
            payload, 600000, true);
        if (serr == "" && countRequest) { ZanIDE.aiStatReqs = ZanIDE.aiStatReqs + 1; }
        if (App.PerfOn()) {
            int aiT6 = Window.GetTickMs();
            File.AppendAllText("zan_frame_perf.log",
                "  ailaunch total_ms=" + Convert.ToString(aiT6 - aiT0)
                + " sys_ms=" + Convert.ToString(aiT1 - aiT0)
                + " hist_ms=" + Convert.ToString(aiT2 - aiT1)
                + " ctx_ms=" + Convert.ToString(aiT3 - aiT2)
                + " json_ms=" + Convert.ToString(aiT4 - aiT3)
                + " prefix_ms=" + Convert.ToString(aiT5 - aiT4)
                + " start_ms=" + Convert.ToString(aiT6 - aiT5)
                + " bytes=" + Convert.ToString(payload.Length) + "\n");
        }
        return serr;
    }

    static int aiStatReqs;
    static int aiStatFails;
    static int aiStatPrompt;
    static int aiStatCompletion;
    static int aiStatCached;
    static int aiStatTotal;
    // 被当成重复而拒掉的查询次数（同一个调用、已经读过的行区间、或者正文已经
    // 钉在对话里的那个打开文件）。这个数就是「省下来没白读的那些拍」，跟缓存
    // 命中并列着看：它涨得越多，模型在原地打转的时间越少。
    static int aiStatDupTools;
    // 客户端这一侧的前缀稳定度：每个模型上一次发出去的请求体，以及本次
    // 与它逐字节相同的前缀长度。prompt 缓存按前缀匹配，所以「缓存命中就那
    // 么一点」只有两种可能：本地前缀本身每一拍在变（那是 IDE 的错），或者
    // 前缀不变而服务端没给那么多（那是供应商的事）。两个数并列在用量面板
    // 里，以后不用再猜（以 AiModelPrefixCache 实体承载，消除平行列表）。
    static List<AiModelPrefixCache> aiPrefixCaches;
    // 上一次请求的共同前缀字节数与整个请求体的字节数。
    static int aiPrefixShared;
    static int aiPrefixTotal;

    static int aiStatUsageReplies;

    // 记下这一拍的请求体，并与同一个模型上一拍的请求体比一下前缀。按模型
    // 分开存：团队模式下两个成员各跑自己的模型，他们的缓存也是各自一份。
    static void AiPrefixNote(string model, string payload) {
        if (ZanIDE.aiPrefixCaches == null) {
            ZanIDE.aiPrefixCaches = new List<AiModelPrefixCache>();
        }
        int at = 0 - 1;
        for (int i = 0; i < ZanIDE.aiPrefixCaches.Count; i = i + 1) {
            if (ZanIDE.aiPrefixCaches[i].model == model) { at = i; }
        }
        ZanIDE.aiPrefixTotal = payload.Length;
        if (at < 0) {
            ZanIDE.aiPrefixCaches.Add(new AiModelPrefixCache(model, payload));
            ZanIDE.aiPrefixShared = 0;
            return;
        }
        string prev = ZanIDE.aiPrefixCaches[at].lastPayload;
        int n = prev.Length;
        if (payload.Length < n) { n = payload.Length; }
        int k = 0;
        while (k < n && prev[k] == payload[k]) { k = k + 1; }
        ZanIDE.aiPrefixShared = k;
        ZanIDE.aiPrefixCaches[at].lastPayload = payload;
    }

    static void AiStatAdd(SseAnswer a) {
        if (a.promptTokens <= 0 && a.completionTokens <= 0
            && a.totalTokens <= 0) { return; }
        ZanIDE.aiStatUsageReplies = ZanIDE.aiStatUsageReplies + 1;
        ZanIDE.aiStatPrompt = ZanIDE.aiStatPrompt + a.promptTokens;
        ZanIDE.aiStatCompletion = ZanIDE.aiStatCompletion + a.completionTokens;
        ZanIDE.aiStatCached = ZanIDE.aiStatCached + a.cachedTokens;
        int tot = a.totalTokens;
        if (tot <= 0) { tot = a.promptTokens + a.completionTokens; }
        ZanIDE.aiStatTotal = ZanIDE.aiStatTotal + tot;
    }

    static string AiReadAnswerFrom(string path) {
        if (!File.Exists(path)) {
            return ZanIDE.T("[error] No response received (network problem?).",
                "[错误] 未收到响应（网络问题？）。");
        }
        string raw = File.ReadAllText(path);
        if (raw == "") {
            return ZanIDE.T("[error] Empty response from the AI endpoint.",
                "[错误] AI 服务返回为空。");
        }
        string content = "";
        string errMsg = "";
        bool foundContent = false;
        bool foundErr = false;
        JsonDoc.ParseScoped(raw, (JsonDoc v) => {
            if (v.KindAt(0) == 5) {
                int ch = v.Get(0, "choices");
                if (ch >= 0 && v.KindAt(ch) == 4) {
                    int first = v.FirstChild(ch);
                    if (first >= 0) {
                        int msg = v.Get(first, "message");
                        if (msg >= 0) {
                            content = v.Str(msg, "content", "");
                            foundContent = true;
                        }
                    }
                }
                int err = v.Get(0, "error");
                if (err >= 0) {
                    errMsg = v.Str(err, "message", raw);
                    foundErr = true;
                }
            }
        });
        if (foundContent) { return content; }
        if (foundErr) { return "[error] " + errMsg; }
        if (raw.Length > 400) { raw = AiAgent.Clip(raw, 400) + "..."; }
        return "[error] " + raw;
    }
}
