using System;
using System.Collections.Generic;
using Gui;
using Gui.Widget;

// 单窗体极简发布台：布局由 PublishStudio.html 声明，半件 PublishStudio.design.zan
// 暴露强类型控件访问器。这里只负责数据填充与动态平台复选框生成。
partial class PublishStudio {
    void OnInit() {
        this.LogArea.ReadOnly(true);
        this.PubProgress.SetPercent(0);
    }

    void ApplyTexts(bool haveProject, string root, string entryRel, string projType,
                    bool singleFile, bool packAssets, bool pubDebug,
                    bool stripSymbols, bool denyWarnings,
                    bool busy, int progressPct, string status) {
        this.TitleLabel.SetProp("text", ZanIDE.T("Zan Publish Studio", "Zan 一键发布台"));
        this.BtnOpen.SetText(ZanIDE.T("Open Project...", "打开项目..."));
        this.BtnConfig.SetText(ZanIDE.T("Project & Signing", "项目与签名配置"));
        this.BtnLang.SetText(ZanIDE.T("中文", "EN"));
        this.RecentSelect.Placeholder = ZanIDE.T("Recent projects...", "最近项目...");

        this.BtnPublish.SetText(ZanIDE.T("One-Click Publish", "一键发布"));
        this.BtnBuild.SetText(ZanIDE.T("Build Check", "编译检查"));
        this.BtnRun.SetText(ZanIDE.T("Run", "运行"));
        this.BtnOpenOut.SetText(ZanIDE.T("Open Output", "打开发布目录"));
        this.BtnClearLog.SetText(ZanIDE.T("Clear Log", "清空日志"));
        this.OutputCap.SetProp("text", ZanIDE.T("Build & Publish Output", "编译与发布输出"));
        this.TargetsCap.SetProp("text", ZanIDE.T("Target Platforms", "发布目标平台"));

        this.ChkSingleFile.SetLabel(ZanIDE.T("Single-File Embed", "单文件打包"));
        this.ChkPackAssets.SetLabel(ZanIDE.T("Pack Assets (.zrp)", "资源打包 (.zrp)"));
        this.ChkPubDebug.SetLabel(ZanIDE.T("Debug Mode (-g)", "调试模式 (-g)"));
        this.ChkStripSymbols.SetLabel(ZanIDE.T("Strip Symbols", "剥离符号"));
        this.ChkDenyWarnings.SetLabel(ZanIDE.T("Deny Warnings", "严苛警告"));

        if (haveProject) {
            string name = ZanIDE.ProjField(root, "name");
            if (name == "") { name = ZanIDE.BaseName(root); }
            this.ProjectNameLabel.SetProp("text", name);
            this.TypeTag.SetText(projType);
            this.ProjectEntryLabel.SetProp("text",
                ZanIDE.T("Entry: ", "入口：") + (entryRel != "" ? entryRel : "(auto)"));
            this.ProjectPathLabel.SetProp("text", root);
            this.SigningSummaryLabel.SetProp("text",
                ZanIDE.T("Signing — ", "签名摘要 — ")
                + "Android: " + ZanIDE.SigningSummary(root, "android")
                + "   |   iOS: " + ZanIDE.SigningSummary(root, "ios")
                + "   |   OHOS: " + ZanIDE.SigningSummary(root, "ohos"));
        } else {
            this.ProjectNameLabel.SetProp("text",
                ZanIDE.T("No Project Loaded", "未加载项目"));
            this.TypeTag.SetText("NONE");
            this.ProjectEntryLabel.SetProp("text", "");
            this.ProjectPathLabel.SetProp("text",
                ZanIDE.T("Click \"Open Project...\" to select a zan.proj file.",
                         "点击「打开项目...」选择 zan.proj 项目配置文件。"));
            this.SigningSummaryLabel.SetProp("text", "");
        }

        this.ChkSingleFile.SetChecked(singleFile);
        this.ChkPackAssets.SetChecked(packAssets);
        this.ChkPubDebug.SetChecked(pubDebug);
        this.ChkStripSymbols.SetChecked(stripSymbols);
        this.ChkDenyWarnings.SetChecked(denyWarnings);

        this.ChkSingleFile.Disabled.Set(!haveProject || busy);
        this.ChkPackAssets.Disabled.Set(!haveProject || busy);
        this.ChkPubDebug.Disabled.Set(!haveProject || busy);
        this.ChkStripSymbols.Disabled.Set(!haveProject || busy);
        this.ChkDenyWarnings.Disabled.Set(!haveProject || busy);

        this.BtnConfig.Disabled.Set(!haveProject || busy);
        this.BtnOpen.Disabled.Set(busy);
        this.RecentSelect.Disabled.Set(busy);
        this.BtnPublish.Disabled.Set(!haveProject || busy);
        this.BtnBuild.Disabled.Set(!haveProject || busy);
        this.BtnRun.Disabled.Set(!haveProject || busy);
        this.BtnOpenOut.Disabled.Set(!haveProject);

        this.PubProgress.SetPercent(progressPct);
        this.StatusLabel.SetProp("text", status);
    }

    void PopulateRecent(List<string> recents, string currentRoot) {
        List<SelectOption> opts = new List<SelectOption>();
        for (int i = 0; i < recents.Count; i = i + 1) {
            string p = recents[i];
            string lbl = ZanIDE.BaseName(p) + " — " + p;
            opts.Add(new SelectOption(lbl, p, false));
        }
        this.RecentSelect.Options = opts;
        if (currentRoot != "") {
            this.RecentSelect.SelectByValue(currentRoot);
        } else {
            this.RecentSelect.ClearSelection();
        }
    }

    List<Checkbox> PopulateTargets(List<PublishTargetOption> opts, bool disabled) {
        this.TargetList.RemoveAll();
        List<Checkbox> boxes = new List<Checkbox>();
        if (opts == null) { return boxes; }
        for (int i = 0; i < opts.Count; i = i + 1) {
            Checkbox cb = new Checkbox(opts[i].label);
            cb.AddClass("small");
            cb.SetChecked(opts[i].selected);
            cb.Disabled.Set(disabled);
            this.TargetList.Add(cb);
            boxes.Add(cb);
        }
        return boxes;
    }

    void SetLogText(string text) {
        if (this.LogArea.GetText() != text) {
            this.LogArea.SetText(text);
            this.LogArea.ScrollToEnd();
        }
    }
}
