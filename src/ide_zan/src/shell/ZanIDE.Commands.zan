using System;
using System.IO;
using System.Diagnostics;
using System.Json;
using System.Data;
using System.Data.Sqlite;
using Platform;
using Gui;
using Gui.Widget;
using Gui.Designer;
using Gui.Component;
using Game.Scene;

/// 功能区上一次点击变成一次操作：新建 / 打开 / 保存 / 构建 / 运行 / 调试 /
/// 发布 / 配置 / 库市场 / 设置 / 帮助。命令本身是纯配置（图标、文案、动作
/// 号，见 ZanIDE.Ribbon），这里是它们各自要做的事。
partial class ZanIDE {
    /// 执行动作号 `rc`（-1 表示这一帧没有点击）。
    void RunRibbonCommand(App app, int rc) {
        if (rc == 0 && dlg == null) {
            // Rebuild the catalog (built-ins + custom templates on disk).
            tpls = ZanIDE.BuildCatalog(root);
            wizTpls = ZanIDE.WizTemplates(tpls);
            catNames = ZanIDE.CatsOf(tpls);
            catSel.Set(0);
            pSel.Set(0);
            pSizeSeededFor = 0 - 1;
            pNameInput.SetText("NewProject");
            pLocInput.SetText(ZanIDE.ReadLastPickerDirectory(ZanIDE.ProjectsHome()));
            Wizard.notice = "";
            this.OpenWizardHost(app, ZanIDE.T("New Project", "新建项目"), 1180, 680, 1);
        } else if (rc == 1 && dlg == null) {
            dlg = this.OpenWizardHost(app, ZanIDE.T("New File", "新建文件"), 720, 470, 2);
            dlgMode = 2;
        } else if (rc == 2) {
            pathPicker.BeginOpenFileFilters(
                ZanIDE.ReadLastPickerDirectory(root),
                ZanIDE.OpenFileFilters(),
                ZanIDE.T("Open source file", "打开源文件"));
            pathPickerOwner = 4;
            app.RequestRedraw();
        } else if (rc == 16) {
            pathPicker.BeginFolder(
                ZanIDE.ReadLastPickerDirectory(root),
                ZanIDE.T("Open a project folder", "打开项目文件夹"));
            pathPickerOwner = 10;
            app.RequestRedraw();
        } else if (rc == 17) {
            // View tab: the assistant window toggle (on = open). The open
            // request is honored between frames (aiWinPending) -- never from
            // inside this frame.
            AiAssistantWindow.ToggleFromRibbon();
        } else if (rc == 3) {
            int aSv3 = activeTab.Get();
            if (aSv3 >= 0 && aSv3 < tabs.Count
                    && ZanIDE.IsFormPath(tabs[aSv3].path) && codeViewForm == tabs[aSv3].path) {
                // The .zform code view shows the design JSON (read-only).
                log.Add(ZanIDE.T("> The design JSON is read-only here; edit the design, or open Name.zan for logic.", "> 设计 JSON 此处只读；请修改设计，或打开 Name.zan 编写逻辑。"));
            } else if (aSv3 >= 0 && aSv3 < tabs.Count
                    && ZanIDE.IsScenePath(tabs[aSv3].path) && codeViewForm == tabs[aSv3].path) {
                // The projected scene code is read-only in the code view.
                log.Add(ZanIDE.T("> The projected scene code is read-only; edit the design, or open Name.zan for logic.", "> 场景投影代码只读；请修改设计，或打开 Name.zan 编写逻辑。"));
            } else {
                this.SaveActiveTab();
                if (autoRun) { hotReloadReq = true; }
            }
            Layer.Msg(ZanIDE.T("Saved", "已保存"), 3);
            rescan = true;
        } else if (rc == 4) {
            // Run (4) and Build (5) compile the active target in a
            // DETACHED shell so a slow compile never freezes the IDE;
            // completion is handled by the buildBusy poll below.
            this.SaveActiveTab();
            if (buildBusy) {
                Layer.Msg(ZanIDE.T("Build already running…", "构建进行中…"), 2);
            } else {
                int atB = activeTab.Get();
                string apB = "";
                if (atB >= 0 && atB < tabs.Count) { apB = tabs[atB].path; }
                string rpB = ZanIDE.RibbonRunTarget(apB, root);
                if (rpB == "") {
                    log.Add(ZanIDE.T("> Nothing to run (open and save a source file first).", "> 没有可运行的目标（请先打开并保存源文件）。"));
                } else {
                    buildBusy = true;
                    buildStartMs = Window.GetTickMs();
                    // A library has no entry point to launch: Run on a
                    // library project builds the shared library only.
                    buildThenRun = !ZanIDE.IsLibraryProject(root);
                    buildExe = ZanIDE.RunBuildBegin(root, rpB);
                    buildIsGui = ZanIDE.IsWindowedTarget(root, rpB);
                    buildTargetPath = apB;
                    buildLogLen = 0;
                    dock.Focus("output");
                    log.Add("> Building " + rpB + " ...");
                    if (rc == 4 && !buildThenRun) { Layer.Msg(ZanIDE.T("Building library…", "正在构建库…"), 2); }
                    else if (rc == 4) { Layer.Msg(ZanIDE.T("Building & running…", "正在构建并运行…"), 2); }
                    else { Layer.Msg(ZanIDE.T("Building…", "正在构建…"), 2); }
                    app.RequestAnimationFrame(80);
                }
            }
        } else if (rc == 6) {
            this.SaveActiveTab();
            pubSel = ZanIDE.ReadProjectPlatforms(root);
            if (pubWin == null) {
                pubWin = PublishWindow.Open(app, root, pubSel, ZanIDE.uiLang);
            }
            app.RequestRedraw();
        } else if (rc == 7) {
            // Debug (F5)
            designerMode = false;
            if (dbgState == 0) {
                if (!buildBusy) {
                    this.SaveActiveTab();
                    string dExe = ZanIDE.DebugBuildBegin(tabs, activeTab, root, log);
                    if (dExe != "") {
                        buildBusy = true;
                        buildStartMs = Window.GetTickMs();
                        buildThenRun = false;
                        dbgBuildPending = true;
                        buildExe = dExe;
                        buildTargetPath = ZanIDE.PathOf(tabs, activeTab);
                        buildLogLen = 0;
                        dock.Focus("output");
                        app.RequestAnimationFrame(80);
                    }
                }
            } else if (dbgState == 2) {
                if (dbg != null) { dbg.Continue(); }
                dbgState = ZanIDE.DbgSync(dbg, editor, log, dbgConsole);
                dbgExecLine = ZanIDE.DbgLine(dbg);
                dbgVarInfo = ZanIDE.DbgVars(dbg);
                dbgStack = ZanIDE.DbgStack(dbg);
                dbgWatchVals = ZanIDE.DbgEvalWatches(dbg, dbgWatches);
                if (dbgState == 2) {
                    ZanIDE.LogVarsToConsole(log, dbgVarInfo, dbgExecLine);
                } else {
                    dbg = null;
                }
            }
        } else if (rc == 8 && dlg == null) {
            tmplCatSel.Set(5);
            tmplNameInput.SetText(Path.GetFileName(root));
            this.OpenWizardHost(app, ZanIDE.T("Save as Template", "另存为模板"), 640, 470, 3);
        } else if (rc == 11) {
            autoRun = !autoRun;
            if (autoRun) { log.Add("> Hot reload: ON (save rebuilds & restarts the app)."); }
            else { log.Add("> Hot reload: OFF."); }
            app.RequestRedraw();
        } else if (rc == 12) {
            // Open the visual Project Configuration panel (icon + static
            // resources bundled with the app).
            if (File.Exists(root + "/zan.proj")) {
                if (cfgWin == null) {
                    cfgWin = ConfigWindow.Open(app, root, log, ZanIDE.uiLang, 0);
                }
            } else {
                log.Add("> Open or create a project first to configure it.");
            }
            app.RequestRedraw();
        } else if (rc == 15) {
            if (File.Exists(root + "/zan.proj")) {
                if (marketplaceWin == null || !marketplaceWin.IsOpen()) {
                    marketplaceWin = MarketplaceWindow.Open(app, ZanIDE.uiLang);
                }
            } else {
                log.Add(ZanIDE.T("> Open or create a project before installing packages.",
                    "> 请先打开或创建工程，再安装库。"));
            }
            app.RequestRedraw();
        } else if (rc == 13) {
            if (settingsWindow == null
                || !settingsWindow.IsOpen()) {
                settingsWindow = EditorSettingsWindow.Open(
                    app, edThemeIdx, edFontPx,
                    ZanIDE.uiLang, defFontPx);
            }
        } else if (rc == 14) {
            // Open the Help / documentation browser (a real "@docs" tab).
            int di = ZanIDE.FindTabByPath(tabs, "@docs");
            if (di >= 0) {
                activeTab.Set(di);
            } else {
                tabs.Add(TabRecord.Create(ZanIDE.T("Help", "帮助"), "", "@docs"));
                activeTab.Set(tabs.Count - 1);
            }
            lastActive = 0 - 1;
            app.RequestRedraw();
        }
    }
}
