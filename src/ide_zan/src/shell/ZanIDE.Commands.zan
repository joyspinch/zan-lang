using System;
using System.IO;
using System.Diagnostics;
using System.Json;
using System.Data;
using System.Data.Sqlite;
using Platform;
using Gui;
using Gui.Widget;
using Gui.Designer;
using Gui.Component;
using Game.Scene;
using Gui.Backend;

// 功能区上一次点击变成一次操作：新建 / 打开 / 保存 / 构建 / 运行 / 调试 /
// 发布 / 配置 / 库市场 / 设置 / 帮助。命令本身是纯配置（图标、文案、动作
// 号，见 ZanIDE.Ribbon），这里是它们各自要做的事。
partial class ZanIDE {
    // 执行动作号 `rc`（-1 表示这一帧没有点击）。
    void RunRibbonCommand(App app, int rc) {
        if (closeRequested) { return; }
        if (rc == 0 && dlg == null) {
            // 接口数据协议与执行契约。
            this.OpenNewProjectWizardAsync();
        } else if (rc == 1 && dlg == null) {
            dlg = this.OpenWizardHost(app, ZanIDE.T("New File", "新建文件"), 720, 470, 2);
            dlgMode = 2;
        } else if (rc == 2) {
            pathPicker.BeginOpenFileFilters(
                ZanIDE.ReadLastPickerDirectory(root),
                ZanIDE.OpenFileFilters(),
                ZanIDE.T("Open source file", "打开源文件"));
            pathPickerOwner = 4;
            app.RequestRedraw();
        } else if (rc == 16) {
            pathPicker.BeginFolder(
                ZanIDE.ReadLastPickerDirectory(root),
                ZanIDE.T("Open a project folder", "打开项目文件夹"));
            pathPickerOwner = 10;
            app.RequestRedraw();
        } else if (rc == 17) {
            // 接口数据协议与执行契约。
            // 核心契约与执行状态转移规范。
            AiAssistantWindow.ToggleFromRibbon();
        } else if (rc == 3) {
            int aSv3 = activeTab.Get();
            if (aSv3 >= 0 && aSv3 < tabs.Count
                    && (ZanIDE.IsFormPath(tabs[aSv3].path)
                        || tabs[aSv3].designDoc) && codeViewForm == tabs[aSv3].path) {
                // 接口数据协议与执行契约。
                log.Add(ZanIDE.T("> The design JSON is read-only here; edit the design, or open Name.zan for logic.", "> 设计 JSON 此处只读；请修改设计，或打开 Name.zan 编写逻辑。"));
            } else if (aSv3 >= 0 && aSv3 < tabs.Count
                    && ZanIDE.IsScenePath(tabs[aSv3].path) && codeViewForm == tabs[aSv3].path) {
                // 接口数据协议与执行契约。
                log.Add(ZanIDE.T("> The projected scene code is read-only; edit the design, or open Name.zan for logic.", "> 场景投影代码只读；请修改设计，或打开 Name.zan 编写逻辑。"));
            } else {
                int aSv3 = activeTab.Get();
                string savePath3 = aSv3 >= 0 && aSv3 < tabs.Count ? tabs[aSv3].path : "";
                this.SaveActiveTabThen(delegate () {
                    rescan = true;
                    if (autoRun) {
                        this.BeginBuildJob(savePath3, true, false, true);
                        dock.Focus("output");
                    }
                    app.RequestRedraw();
                });
            }
            Layer.Msg(ZanIDE.T("Saved", "已保存"), 3);
        } else if (rc == 4) {
            // 接口数据协议与执行契约。
            // 核心契约与语义定义。
            if (buildBusy) {
                Layer.Msg(ZanIDE.T("Build already running…", "构建进行中…"), 2);
            } else if (pubBusy) {
                Layer.Msg(ZanIDE.T("Publish in progress…", "发布进行中…"), 2);
            } else {
                int atB = activeTab.Get();
                string apB = "";
                if (atB >= 0 && atB < tabs.Count) { apB = tabs[atB].path; }
                string rpB = ZanIDE.RibbonRunTarget(apB, root);
                if (rpB == "") {
                    log.Add(ZanIDE.T("> Nothing to run (open and save a source file first).", "> 没有可运行的目标（请先打开并保存源文件）。"));
                } else {
                    // 接口数据协议与执行契约。
                    string runOwner = ZanIDE.TargetRoot(root, rpB);
                    if (runOwner != "" && runOwner != root) {
                        log.Add(ZanIDE.T("> [Run] Target belongs to project ",
                            "> [运行] 目标属于工程 ") + runOwner
                            + ZanIDE.T(" (open project: ", "（当前打开工程：") + root + "）");
                    }
                    log.Add("> Building " + rpB + " ...");
                    dock.Focus("output");
                    Layer.Msg(ZanIDE.T("Building…", "正在构建…"), 2);
                    string buildTarget = apB;
                    this.SaveActiveTabThen(delegate () { this.BeginBuildJob(buildTarget, rc == 4); });
                }
            }
        } else if (rc == 6) {
            this.SaveActiveTabThen(delegate () { this.OpenPublishWindowAsync(); });
            app.RequestRedraw();
        } else if (rc == 7) {
            // Debug (F5)
            designerMode = false;
            if (pubBusy) {
                Layer.Msg(ZanIDE.T("Publish in progress…", "发布进行中…"), 2);
            } else if (dbgState == 0) {
                if (!buildBusy) {
                    string targetD = ZanIDE.PathOf(tabs, activeTab);
                    this.SaveActiveTabThen(delegate () {
                        this.BeginBuildJob(targetD, false, true);
                        dock.Focus("output");
                    });
                }
            } else if (dbgState == 2) {
                if (dbg != null) { dbg.Continue(); }
                dbgState = ZanIDE.DbgSync(dbg, editor, log, dbgConsole);
                dbgExecLine = ZanIDE.DbgLine(dbg);
                dbgVarInfo = ZanIDE.DbgVars(dbg);
                dbgStack = ZanIDE.DbgStack(dbg);
                ZanIDE.DbgEvalWatches(dbg, dbgWatches);
                if (dbgState == 2) {
                    ZanIDE.LogVarsToConsole(log, dbgVarInfo, dbgExecLine);
                } else {
                    dbg = null;
                }
            }
        } else if (rc == 8 && dlg == null) {
            tmplCatSel.Set(5);
            tmplNameInput.SetText(Path.GetFileName(root));
            this.OpenWizardHost(app, ZanIDE.T("Save as Template", "另存为模板"), 640, 470, 3);
        } else if (rc == 11) {
            autoRun = !autoRun;
            if (autoRun) { log.Add("> Hot reload: ON (save rebuilds & restarts the app)."); }
            else { log.Add("> Hot reload: OFF."); }
            app.RequestRedraw();
        } else if (rc == 12) {
            // 接口数据协议与执行契约。
            // 核心契约与语义定义。
            if (File.Exists(root + "/zan.proj")) {
                if (cfgWin == null) {
                    cfgWin = ConfigWindow.Open(app, root, log, ZanIDE.uiLang, 0);
                }
            } else {
                log.Add("> Open or create a project first to configure it.");
            }
            app.RequestRedraw();
        } else if (rc == 15) {
            if (File.Exists(root + "/zan.proj")) {
                if (marketplaceWin == null || !marketplaceWin.IsOpen()) {
                    marketplaceWin = MarketplaceWindow.Open(app, ZanIDE.uiLang);
                }
            } else {
                log.Add(ZanIDE.T("> Open or create a project before installing packages.",
                    "> 请先打开或创建工程，再安装库。"));
            }
            app.RequestRedraw();
        } else if (rc == 13) {
            if (settingsWindow == null
                || !settingsWindow.IsOpen()) {
                settingsWindow = EditorSettingsWindow.Open(
                    app, edThemeIdx, edFontPx,
                    ZanIDE.uiLang, defFontPx);
            }
        } else if (rc == 14) {
            // 接口数据协议与执行契约。
            int di = ZanIDE.FindTabByPath(tabs, "@docs");
            if (di >= 0) {
                activeTab.Set(di);
            } else {
                tabs.Add(TabRecord.Create(ZanIDE.T("Help", "帮助"), "", "@docs"));
                activeTab.Set(tabs.Count - 1);
            }
            lastActive = 0 - 1;
            app.RequestRedraw();
        } else if (rc == 18) {
            // 手动触发一次 IDE 增量更新（扫本地 → 比对 → 暂存 → 提示重启）。
            string err = IdeFileSync.Start();
            if (err.Length > 0) {
                log.Add(ZanIDE.T("> Cannot start update: ", "> 无法开始更新：") + err);
            } else {
                log.Add(ZanIDE.T("> Checking for toolchain updates...",
                    "> 正在检查工具链更新..."));
            }
            app.RequestRedraw();
        }
    }
}
