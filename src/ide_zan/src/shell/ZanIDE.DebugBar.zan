using System;
using System.IO;
using System.Diagnostics;
using System.Json;
using System.Data;
using System.Data.Sqlite;
using Platform;
using Gui;
using Gui.Widget;
using Gui.Designer;
using Gui.Component;
using Game.Scene;

/// 调试工具条：正在调试时压在功能区下面的那一条（继续 / 单步 / 步入 /
/// 停止）。按钮和布局由 views/DebugToolbar.zform 声明，这里把它给出的动作
/// 接到调试会话上，并把每次停下后的变量、调用栈和监视值同步回界面。
partial class ZanIDE {
    /// 画这一条并处理它的动作，返回它占掉的高度（没在调试时为 0）。
    int RunDebugBar(App app, int W, int y) {
        int dbgBarH = 0;
        if (dbgState == 2) {
            dbgBarH = app.Scale(38);
            int dbgAction = dbgToolbar.Render(app,
                new Rect(0, y, W, dbgBarH), dbgExecLine,
                DebugToolbar.Buttons());
            if (dbgAction == 0) {
                if (dbg != null) { dbg.Continue(); }
                dbgState = ZanIDE.DbgSync(dbg, editor, log, dbgConsole);
                dbgExecLine = ZanIDE.DbgLine(dbg);
                dbgVarInfo = ZanIDE.DbgVars(dbg);
                dbgStack = ZanIDE.DbgStack(dbg);
                dbgWatchVals = ZanIDE.DbgEvalWatches(dbg, dbgWatches);
                if (dbgState == 2) {
                    ZanIDE.LogVarsToConsole(log, dbgVarInfo, dbgExecLine);
                } else { dbg = null; }
                app.RequestRedraw();
            } else if (dbgAction == 1) {
                if (dbg != null) { dbg.StepOver(); }
                dbgState = ZanIDE.DbgSync(dbg, editor, log, dbgConsole);
                dbgExecLine = ZanIDE.DbgLine(dbg);
                dbgVarInfo = ZanIDE.DbgVars(dbg);
                dbgStack = ZanIDE.DbgStack(dbg);
                dbgWatchVals = ZanIDE.DbgEvalWatches(dbg, dbgWatches);
                if (dbgState == 2) {
                    ZanIDE.LogVarsToConsole(log, dbgVarInfo, dbgExecLine);
                } else { dbg = null; }
                app.RequestRedraw();
            } else if (dbgAction == 2) {
                if (dbg != null) { dbg.StepIn(); }
                dbgState = ZanIDE.DbgSync(dbg, editor, log, dbgConsole);
                dbgExecLine = ZanIDE.DbgLine(dbg);
                dbgVarInfo = ZanIDE.DbgVars(dbg);
                dbgStack = ZanIDE.DbgStack(dbg);
                dbgWatchVals = ZanIDE.DbgEvalWatches(dbg, dbgWatches);
                if (dbgState == 2) {
                    ZanIDE.LogVarsToConsole(log, dbgVarInfo, dbgExecLine);
                } else { dbg = null; }
                app.RequestRedraw();
            } else if (dbgAction == 3) {
                if (dbg != null) { dbg.Stop(); dbg = null; }
                dbgState = 0; dbgExecLine = -1; editor.SetExecLine(-1);
                log.Add("> [Debug] Stopped.");
                app.RequestRedraw();
            }
        }
        return dbgBarH;
    }
}
