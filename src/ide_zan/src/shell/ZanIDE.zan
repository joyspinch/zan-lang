using System;
using System.IO;
using System.Diagnostics;
using System.Json;
using System.Data;
using System.Data.Sqlite;
using Gui;
using Gui.Widget;
using Gui.Designer;
using Gui.Component;
using Game.Scene;
using Gui.Backend;

partial class ZanIDE : UiViewOwner {

    // ---- UI language (one-click EN / 中文) ----
    static string uiLang = "zh";

    // to compile).
    static void Attach(Form form) {
        try {
            ZanIDE ide = new ZanIDE();
            ZanIDE.current = ide;
            ide.InitShell(form);
        } catch (Exception e) {
            string m = e.Message;
            if (m == "") { m = "unknown error"; }
            string p = ZanIDE.CacheDir() + "/ide_error.log";
            Directory.CreateDirectoryRecursive(ZanIDE.CacheDir());
            File.WriteAllText(p, "ZanIDE crashed: " + m + "\n");
            #if WINDOWS
            System.Windows.MessageBox.Show("ZanIDE crashed: " + m, "ZanIDE");
            #endif
        }
    }

    string CtxProjRel() {
        if (!haveProject) { return ""; }
        if (ctxTarget < 0 || ctxTarget >= treeShow.Count) { return ""; }
        string p = treeShow[ctxTarget].path;
        if (p == "" || p == root) { return ""; }
        if (!ZanIDE.StartsWith(p, root)) { return ""; }
        return ZanIDE.NormRel(p.Substring(root.Length, p.Length - root.Length));
    }

    static string GenMark(string cur, string act) {
        if (cur == act) { return "✓ "; }
        return "   ";
    }

    static string GenLabel(string act) {
        if (act == "copy") { return ZanIDE.T("Copy to Output", "复制到输出"); }
        if (act == "embed") { return ZanIDE.T("Embed", "内嵌到程序"); }
        return ZanIDE.T("None", "不处理");
    }

    void FrameTick() {
        if (shuttingDown || closeRequested) { this.RetireEditorTabsView(); return; }
        this.SyncEditorDocument();
        if (haveProject) { this.EnsureLsp(); }
        this.PumpDocumentPages();
        this.UpdateActiveCodeTab();
        this.UpdateDesignDocument();
        this.ApplyPendingCodeCaret();
        this.PumpDocumentWatch();
        this.RequestBuildErrors();
        this.AutosaveAiSessions(Gui.Backend.Window.GetTickMs());
        if (dock.TakeChanged()) { this.RememberDockLayoutAsync(dock.SaveLayout()); }
        this.CaptureJobMonitor();
        FilePicker.lang = ZanIDE.uiLang;
        CodeEditor.lang = ZanIDE.uiLang;
        Designer.lang = ZanIDE.uiLang;
        pathPicker.ApplySkin(app.ThemeMenuIndex());
        if (app.ThemeMenuIndex() != lastSkinIdx) {
            lastSkinIdx = app.ThemeMenuIndex();
            ChildWindows.FollowSkin(lastSkinIdx);
        }
        if (app.WindowOpacity() != winOpacity) {
            winOpacity = app.WindowOpacity();
            ChildWindows.FollowOpacity(winOpacity);
        }
        if (app.ConsumeWallpaperPick() && !pathPicker.IsOpen()) {
            pathPicker.BeginOpenFile(
            ZanIDE.ReadLastPickerDirectory(root), ".png;.jpg;.jpeg;.bmp",
            ZanIDE.T("Choose a window background image", "选择窗口背景图片"));
            pathPickerOwner = 9;
            app.RequestRedraw();
        }
        if (app.UserWallpaperPath() != wallPath
        || app.UserWallpaperOpacity() != wallOpacity) {
            wallPath = app.UserWallpaperPath();
            wallOpacity = app.UserWallpaperOpacity();
            ChildWindows.FollowWallpaper(wallPath, wallOpacity);
        }
        app.PerfMark("sh.skin");

        nint evh = Gui.Backend.Window.EventHwnd();
        int kind = app.window.EventKind();

        if (kind == 8) {
            if (ChildWindows.RouteEvent(evh)) {
                lastActive = 0 - 1;
                app.RequestRedraw();
            } else if (pathPicker.OwnsWindow(evh)) {
                pathPicker.ApplyEvent(evh);
                if (pathPicker.NeedsRedraw()) {
                    pathPicker.RenderWindow();
                }
            } else if (evh == app.WindowHandle()) {
                return;
            } else {
                app.RequestRedraw();
            }
        } else if (pathPicker.OwnsWindow(evh)) {
            pathPicker.ApplyEvent(evh);
            if (pathPicker.NeedsRedraw()) {
                pathPicker.RenderWindow();
            }
        } else if (evh != 0 && evh != app.WindowHandle()) {
            ChildWindows.RouteEvent(evh);
        }
        app.PerfMark("sh.route");
        int actDM = activeTab.Get();
        if (actDM >= 0 && actDM < tabs.Count) {
            designerMode = (ZanIDE.IsFormPath(tabs[actDM].path)
            || tabs[actDM].designDoc)
            && tabs[actDM].path != codeViewForm;
            sceneMode = ZanIDE.IsScenePath(tabs[actDM].path) && tabs[actDM].path != codeViewForm;
        } else {
            designerMode = false;
            sceneMode = false;
        }

        if (sceneDesigner != null) { sceneDesigner.SetInspectorVisible(sceneMode); }
        this.HandleFrameHotkeys(kind);
        app.PerfMark("sh.input");

        this.PumpPublishWindow();
        this.PumpConfigWindow();
        this.PumpMarketplaceWindow();
        this.PumpSettingsWindows();
        this.PumpFilePicker();
        IdeUpdate.Poll();
        // 商城安装执行器的结果（成败一行），接到输出面板。
        string installDone = MarketplaceInstall.Poll();
        if (installDone.Length > 0) {
            log.Add(installDone);
            if (marketplaceInstallPending && marketplaceInstallPackage == MarketplaceInstall.packageName) {
                this.FinishMarketplaceRecovery(MarketplaceInstall.LastSucceeded());
            }
            app.RequestRedraw();
        }
        // 增量更新执行面：比对计划落地后接管下载/暂存，结果一行进日志。
        string syncLine = IdeFileSync.Poll();
        if (syncLine.Length > 0) {
            log.Add(syncLine);
            app.RequestRedraw();
        }
        // 商业插件使用账目：攒批/到点异步上报一轮（fire-and-forget，失败留队）。
        PluginUsage.Poll();
        app.PerfMark("sh.children");

        if (aiCfgPending) {
            aiCfgPending = false;
            if (aiWindow == null || !aiWindow.IsOpen()) {
                aiWindow = AiSettingsWindow.Open(app, ZanIDE.uiLang);
            }
            app.RequestRedraw();
        }

        if (aiWinPending) {
            aiWinPending = false;
            if (aiWin == null || !aiWin.IsOpen()) {
                aiWin = AiAssistantWindow.Open(app);
            }
            app.RequestRedraw();
        }
        if (aiWin != null && !aiWin.IsOpen()) {
            aiWin = null;
            app.RequestRedraw();
        }

        if (rescan) {
            rescan = false;
            this.RequestTreeScan();
        }
        app.PerfMark("sh.rescan");
    }

    // 后台活儿（构建、发布、程序输出、git、小助手请求）下一拍的重绘：
    // 只声明这一拍可能变化的那块像素——那块面板自己。
    // // 这些轮询过去都用整窗的 RequestAnimationFrame 排下一拍，于是模型
    // 在想、编译器在跑的那几十秒里，屏上只有一个转圈在动，IDE 却按
    // 4~12 帧/秒把整个窗口（磨砂主题还要重新模糊一遍背景）重画一遍：
    // 这就是「小助手一干活 CPU 就上去」的那份活。声明了范围之后，
    // 由这一拍唤醒的帧走损伤裁剪，只有那块面板被重画；真有内容变化
    // 的时候各处照旧调 RequestRedraw，整窗帧一帧都没少。面板被收起
    // （停到屏外）时范围为空，这一拍就只跑轮询逻辑、几乎不画东西。
    void PollNextIn(App app, int ms, Rect r) {
        if (r == null || r.x < 0 || r.y < 0 || r.width <= 0 || r.height <= 0) {
            app.RequestAnimationFrame(ms);
            return;
        }
        app.RequestAnimationFrameIn(ms, r.x, r.y, r.width, r.height);
    }

    int editorPaintOwnerId = WidgetId.Next();

    void PaintFrame(App app) {
        int kind = app.window.EventKind();
        try {
            Canvas c = app.canvas;
            Theme t = app.theme;
            int left = app.ShapeOffX();
            int W = app.ClientWidth();
            int dscale = app.dpiScale;
            if (dscale <= 0) { dscale = 100; }
            savedW = W * 100 / dscale;
            savedH = app.ClientHeight() * 100 / dscale;
            int top = app.ShapeOffY() + app.ContentTop();
            int ribbonH = compactHeader ? app.Scale(34) : Ribbon.HeightTabbed(app);

            int atE = activeTab.Get();
            string apE = "";
            if (atE >= 0 && atE < tabs.Count) { apE = tabs[atE].path; }
            bool activeIsFile = apE != "" && apE != "@start";
            bool haveProj = File.Exists(root + "/zan.proj");
            bool canRun = activeIsFile || haveProj;
            if (compactHeader) {
                if (compactHeaderView == null) { compactHeaderView = new CompactHeader(); }
                string curProj = haveProject ? Path.GetFileName(root) : "";
                compactHeaderView.SyncState(curProj, canRun, haveProj, this.AgentOn());
                compactHeaderView.RenderInside(app, new Rect(left, top, W, ribbonH));
                int chAct = compactHeaderView.TakeAction();
                if (chAct == 10) {
                    findMode = 10;
                    app.RequestRedraw();
                } else if (chAct == 99) {
                    compactHeader = false;
                    ZanIDE.WriteEditorPrefs(edThemeIdx, edFontPx, compactHeader);
                    app.RequestRedraw();
                } else if (chAct > 0) {
                    this.RunRibbonCommand(app, chAct);
                }
            } else {
                // 功能区由当前保留树准备和分发输入，Paint 只访问这棵树。
                if (this.RibbonViewReady(app)) { ribbonControl.RenderTree(app); }
            }

            // 调试工具条（正在调试时）：按钮由 views/DebugToolbar.html
            // 声明，这里只把它给出的动作接到调试会话上。
            int dbgBarH = this.RunDebugBar(app, W, top + ribbonH);
            app.PerfMark("sh.ribbon");
            string outlineTitle = ZanIDE.T("STRUCTURE", "结构");
            if (designerMode || sceneMode) { outlineTitle = ZanIDE.T("COMPONENTS", "组件"); }
            if (outlineTitle != dockOutlineTitle) {
                dock.SetTitle("structure", outlineTitle);
                dockOutlineTitle = outlineTitle;
            }
            dock.RenderPrepared(app);
            explorerPanel.Render(app, dock.ContentParked("explorer"), tree);
            treeShow = explorerPanel.Shown();
            app.PerfMark("sh.explorer");

            int stActTab = activeTab.Get();
            string newSig = "";
            if (designerMode) {
                List<FormField> flatSig = new List<FormField>();
                ZanIDE.FlattenFields(formDesigner.fields, flatSig);
                int nameHash = 0;
                for (int fi = 0; fi < flatSig.Count; fi = fi + 1) {
                    FormField ff = flatSig[fi];
                    nameHash = nameHash * 31 + ff.fname.Length + ff.label.Length + ff.dockSide;
                    if (ff.fname.Length > 0) { nameHash = nameHash + Convert.ToInt(ff.fname[0]); }
                }
                newSig = "F:" + Convert.ToString(stActTab) + ":" + Convert.ToString(flatSig.Count) + ":" + Convert.ToString(nameHash);
            } else if (sceneMode) {
                newSig = "S:" + Convert.ToString(stActTab) + ":"
                + Convert.ToString(sceneDesigner.doc.Count()) + ":"
                + Convert.ToString(this.DesignDocumentRevision());
            } else {
                int cStamp = editor.TextStamp();
                if (cStamp != structPendingStamp) {
                    structPendingStamp = cStamp;
                    structChangeMs = app.nowMs;
                }
                newSig = "C:" + Convert.ToString(stActTab) + ":" + Convert.ToString(cStamp);
                if (newSig != structSig) {
                    if (app.nowMs - structChangeMs < 350 && structTree != null && structTree.Count > 0) {
                        newSig = structSig;
                    } else {
                        structTree = ZanIDE.BuildOutline(editor.GetText());
                    }
                }
            }
            if (newSig != structSig) {
                structSig = newSig;
                if (designerMode) {
                    string sfn = "Form";
                    if (stActTab >= 0 && stActTab < tabs.Count) {
                        sfn = ZanIDE.FormBaseName(tabs[stActTab].path);
                    }
                    structTree = ZanIDE.BuildFieldTree(sfn, formDesigner.fields);
                } else if (sceneMode) {
                    string scn = "Scene";
                    if (stActTab >= 0 && stActTab < tabs.Count) {
                        scn = ZanIDE.BaseName(tabs[stActTab].path);
                    }
                    structTree = ZanIDE.BuildSceneTree(scn, sceneDesigner);
                }
                structSel.Set(0 - 1);
            }
            structurePanel.Render(app, dock.ContentParked("structure"), structTree);
            structShow = structurePanel.Shown();
            app.PerfMark("sh.structure");
            stdlibPanel.Render(app, dock.ContentParked("stdlib"), exTree);
            exShow = stdlibPanel.Shown();
            app.PerfMark("sh.stdlib");

            Rect ea = dock.Content("editor");
            Rect orr = dock.ContentParked("output");

            int tabH = editorTabs.HeaderHeight(app);
            editorTabs.RenderTree(app);
            app.PerfMark("sh.tabs");
            int ctxTab = editorTabs.TakeContext();
            if (ctxTab >= 0) {
                ctxKind = 3; ctxX = app.mouseX; ctxY = app.mouseY;
                ctxTarget = ctxTab; app.RequestRedraw();
            }

            int act = activeTab.Get();
            Rect edRect = new Rect(ea.x, ea.y + tabH, ea.width, ea.height - tabH);
            bool activeIsStart = (act >= 0 && act < tabs.Count && tabs[act].path == "@start");
            bool activeIsDocs = (act >= 0 && act < tabs.Count && tabs[act].path == "@docs");
            bool activeIsDiff = (act >= 0 && act < tabs.Count && tabs[act].path != null && tabs[act].path.StartsWith("@diff:"));

            // 设计 | 代码 标签条（WinForms 同款）：窗体/场景设计稿的活动
            // 文档在编辑区左上角挂两个标签，独占一行，内容整体下移。
            int designTabsH = this.RenderDesignTabs(app, edRect.x, edRect.y);
            Rect viewRect = edRect;
            if (designTabsH > 0) {
                viewRect = new Rect(edRect.x, edRect.y + designTabsH,
                edRect.width, edRect.height - designTabsH);
            }

            // 编辑区（设计器 / 代码 / 起始页 / 文档）自成一段 id：设计器里
            // 选中组件会让属性面板长出一批控件，若和标签条共用一条递增
            // 序号，这一帧的点击就会落到标签条上，表现为“点一下就跳到
            // 后面打开的代码页”。
            if (designerMode) {
                if (this.FormDesignReady()) {
                    formDesigner.RenderHostPanels(app, dock.ContentParked("toolbox"),
                    dock.ContentParked("props"));
                    formDesigner.RootControl().RenderTree(app);
                    this.QueueDesignCapture();
                    string cbField = formDesigner.ConsumeOpenCodeBehind();
                    if (cbField != "") {
                        int actNow = activeTab.Get();
                        if (actNow >= 0 && actNow < tabs.Count) {
                            string curPath = tabs[actNow].path;
                            string cbPath = ZanIDE.CodeBehindPath(curPath);
                            if (!File.Exists(cbPath)) {
                                string fbase = ZanIDE.FormBaseName(curPath);
                                File.WriteAllText(cbPath, ZanIDE.GenBusinessShell(fbase));
                            }
                            if (File.Exists(cbPath)) {
                                int cbTab = ZanIDE.FindTabByPath(tabs, cbPath);
                                if (cbTab >= 0) {
                                    activeTab.Set(cbTab);
                                } else {
                                    ZanIDE.OpenPath(tabs, activeTab, cbPath, Path.GetFileName(cbPath));
                                    cbTab = activeTab.Get();
                                }
                                codeViewForm = "";
                                lastActive = 0 - 1;
                                int matchLine = ZanIDE.EnsureCodeBehindFileHandler(cbPath, cbField, tabs, cbTab, editor);
                                if (matchLine >= 0) {
                                    editor.GoToLine(matchLine);
                                }
                                app.RequestRedraw();
                            }
                        }
                    }
                    string renPair = formDesigner.ConsumeRenamedField();
                    if (renPair != "") {
                        int colon = ZanIDE.IndexOfStr(renPair, ":");
                        if (colon > 0) {
                            string oldN = renPair.Substring(0, colon);
                            string newN = renPair.Substring(colon + 1, renPair.Length - colon - 1);
                            int actNow = activeTab.Get();
                            if (actNow >= 0 && actNow < tabs.Count) {
                                string curPath = tabs[actNow].path;
                                string cbPath = ZanIDE.CodeBehindPath(curPath);
                                if (File.Exists(cbPath)) {
                                    string src = File.ReadAllText(cbPath);
                                    string replaced = ZanIDE.ReplaceWholeWord(src, oldN, newN);
                                    if (replaced != src) {
                                        File.WriteAllText(cbPath, replaced);
                                        int cbTab = ZanIDE.FindTabByPath(tabs, cbPath);
                                        if (cbTab >= 0) { tabs[cbTab].body = replaced; }
                                        log.Add("> Synchronized rename in code-behind: " + oldN + " -> " + newN);
                                    }
                                }
                            }
                        }
                    }
                }
            } else if (sceneMode) {
                if (this.SceneDesignReady()) {
                    sceneDesigner.PaletteRoot().RenderTree(app);
                    sceneDesigner.InspectorRoot().RenderTree(app);
                    sceneDesigner.CanvasRoot().RenderTree(app);
                    sceneDesigner.RenderStatus(app, app.canvas, app.theme, viewRect.x + app.Scale(10),
                    viewRect.y + viewRect.height - app.Scale(30), viewRect.width - app.Scale(20));
                    this.QueueDesignCapture();
                    string scbElement = sceneDesigner.ConsumeOpenCodeBehind();
                    if (scbElement != "") {
                        int actNow = activeTab.Get();
                        if (actNow >= 0 && actNow < tabs.Count) {
                            string curPath = tabs[actNow].path;
                            string scbPath = ZanIDE.SceneCodeBehindPath(curPath);
                            if (File.Exists(scbPath)) {
                                int scbTab = ZanIDE.FindTabByPath(tabs, scbPath);
                                if (scbTab >= 0) {
                                    activeTab.Set(scbTab);
                                } else {
                                    ZanIDE.OpenPath(tabs, activeTab, scbPath, Path.GetFileName(scbPath));
                                }
                                codeViewForm = "";
                                lastActive = 0 - 1;
                                app.Post(delegate () {
                                    int matchLine = ZanIDE.EnsureControlEventHandler(editor, scbElement);
                                    if (matchLine >= 0) { editor.GoToLine(matchLine); }
                                });
                                app.RequestRedraw();
                            }
                        }
                    }
                }
            } else if (activeIsDiff) {
                if (diffView != null) { diffView.RenderTree(app); }
            } else if (activeIsDocs) {
                DocsPage.RenderDocsPage(app, edRect, log);
            } else if (activeIsStart) {
                startPage.RenderTree(app);
            } else if (act >= 0 && act < tabs.Count
            && ZanIDE.IsScenePath(tabs[act].path) && codeViewForm == tabs[act].path) {
                if (this.DesignCodeReady()) {
                    formCodeEd.RenderTree(app);
                }
            } else if (act >= 0 && act < tabs.Count
            && (ZanIDE.IsFormPath(tabs[act].path)
            || tabs[act].designDoc)
            && codeViewForm == tabs[act].path) {
                if (this.DesignCodeReady()) {
                    formCodeEd.RenderTree(app);
                }
            } else {
                if (act >= 0 && act < tabs.Count && editor.documentPath == tabs[act].path) {
                    PaintHashToken editorPaint = app.PaintHashBeginScope();
                    try {
                        editor.RenderTree(app);
                        app.PaintHashEndSelf(editorPaint, editorPaintOwnerId,
                        edRect.x, edRect.y, edRect.width, edRect.height);
                    } finally {
                        App.PaintHashRestore(editorPaint);
                    }
                }
                if (UiDriver.Active()) {
                    UiDriver.SetProbe("editor", ZanIDE.EditorProbeJson(editor));
                    UiDriver.SetProbe("log", string.Join("\n", log));
                }
                if (editor.ConsumeGotoRequest()) {
                    app.Post(delegate () { this.GoToDefinitionAsync(); });
                }
                if (dbgState == 2 && dbgExecLine >= 0) {
                    dbgInline.Render(app, edRect, dbgVarInfo);
                }
            }
            if (refList.IsOpen() && !designerMode && !sceneMode
            && !activeIsStart && !activeIsDocs) {
                refList.Anchor(edRect.x + app.Scale(56),
                editor.LineBottomY(app, refAnchorLine));
                int refPick = refList.TakePicked();
                if (refPick >= 0) { this.GotoReference(refPick); }
                refList.Frame(app);
            } else if (refList.IsOpen()) {
                refList.Close();
            }

            if (symbolList.IsOpen() && !designerMode && !sceneMode
            && !activeIsStart && !activeIsDocs) {
                symbolList.Anchor(edRect.x + app.Scale(56),
                editor.LineBottomY(app, editor.ScrollLine()));
                int symPick = symbolList.TakePicked();
                if (symPick >= 0) { this.GotoSymbol(symPick); }
                symbolList.Frame(app);
            } else if (symbolList.IsOpen()) {
                symbolList.Close();
            }

            this.RunCodeActionMenu(app);

            if ((findMode == 1 || findMode == 2) && !designerMode && !sceneMode
            && !activeIsStart && !activeIsDocs) {
                findBar.Render(app, edRect, editor);
                if (findBar.CloseRequested()) {
                    findBar.ClearCloseRequest();
                    findMode = 0;
                    editor.Focus(app);
                    app.RequestRedraw();
                }
            }

            // ---- 跳转到行 / 断点条件 / 重命名 / 在文件中查找替换 ----
            // 一个声明式的小输入条（views/QuickPrompt.html），编辑、
            // 选择、剪贴板和输入法都归标准输入框。
            this.RunQuickPrompt(app, edRect, designerMode || sceneMode
            || activeIsStart || activeIsDocs);
            app.PerfMark("sh.editor");

            this.RenderOutputPanels(app, orr);
            app.PerfMark("sh.sidepanels");
            app.PerfMark("");

            app.PerfMark("sh.runpoll");
            this.ConsumeHotReloadJob();

            app.PerfMark("sh.gitpoll");

            app.PerfMark("sh.buildpoll");
            if (aiUiRunning) {
                string uidP = root + "/_scratch/uidrv";
                bool uiDone = File.Exists(uidP + "/ai_done.txt");
                bool uiTo = Gui.Backend.Window.GetTickMs() > aiUiDeadline;
                if (uiDone || uiTo) {
                    aiUiRunning = false;
                    if (uiDone) { File.Delete(uidP + "/ai_done.txt"); }
                    string rlog = "";
                    if (File.Exists(uidP + "/results.log")) {
                        rlog = File.ReadAllText(uidP + "/results.log");
                    }
                    string rjson = "";
                    if (File.Exists(uidP + "/regions.json")) {
                        rjson = File.ReadAllText(uidP + "/regions.json");
                    }
                    string tjson = "";
                    if (File.Exists(uidP + "/theme.json")) {
                        tjson = File.ReadAllText(uidP + "/theme.json");
                    }
                    aiMsgs.Add(this.AiToolMsg("tool",
                    aiUiTool + "\n"
                    + AiAgent.UiResultOf(aiUiTool, rlog, rjson, tjson,
                    uiTo && !uiDone)));
                    string uce = ZanIDE.AiLaunchAs(aiRunAgent, aiMsgs,
                    aiRunCtxName, aiRunCtxCode, root,
                    aiProfiles[aiProfActive].baseUrl,
                    aiProfiles[aiProfActive].key, aiRunModel);
                    if (uce != "") {
                        aiMsgs.Add(this.AiToolMsg("error", uce));
                        aiBusy.Set(0);
                    }
                    this.AiChatToEnd();
                    app.RequestRedraw();
                } else {
                    // 唤醒范围交给 Agent 面板自己：它开着时只重画那一块
                    // （流式回答的像素都在那儿），关着时这块矩形停在屏外，
                    // 心跳链照旧（RequestWakeIn 不置 needsRedraw，会断流）。
                    this.PollNextIn(app, 150, dock.ContentParked("agent"));
                }
            }
            app.PerfMark("sh.uipoll");
            app.PerfMark("sh.pubpoll");
            this.PollAiChat(app);
            app.PerfMark("sh.aipoll");

            this.AutosaveAiSessions(Gui.Backend.Window.GetTickMs());
            app.PerfMark("sh.autosave");

            dock.RenderOverlay(app);
            string dockClosed = dock.TakeClosed();
            if (dockClosed != "") {
                Layer.Msg(ZanIDE.T("Panel closed - right-click a tab strip to restore",
                "面板已关闭 - 右键标签栏可恢复"), 3);
            }
            if (dock.TakeChanged()) { ZanIDE.WriteDockLayout(dock.SaveLayout()); }
            app.PerfMark("sh.dockend");

            statusBar.RenderTree(app);
            app.PerfMark("sh.status");

            if (!designerMode && !activeIsStart && !activeIsDocs) {
                string ecmd = editor.TakeCommand();
                if (ecmd == "find") {
                    findMode = 1;
                    findBar.Open(false, this.FindSeed());
                    app.RequestRedraw();
                }
                else if (ecmd == "gotoline") { findMode = 3; app.RequestRedraw(); }
                else if (ecmd == "gotodef") {
                    app.Post(delegate () { this.GoToDefinitionAsync(); });
                } else if (ecmd == "findrefs") {
                    app.Post(delegate () { this.CollectReferencesAsync(); });
                } else if (ecmd == "format" || ecmd == "rename" || ecmd == "codeactions") {
                    this.RunEditorCtxCommand(ecmd);
                }
            }
            this.RenderContextMenu(app);

            if (pubPending) {
                pubPending = false;
                if (buildBusy || pubBusy) {
                    log.Add(ZanIDE.T("> Task already running; publish not started.",
                    "> 已有任务进行中，发布未开始。"));
                } else {
                    this.BeginPublishJob();
                }
                app.RequestRedraw();
            }
            string windowTitle = IdeVersion.Product();
            string updateBadge = IdeUpdate.Summary();
            if (updateBadge.Length > 0) {
                windowTitle = windowTitle + "  " + updateBadge;
            }
            if (haveProject) { windowTitle = windowTitle + "  —  " + root; }
            Tooltip.Flush(app);
        } catch (Exception frameEx) {
            app.NoteFrameError("ide-frame", frameEx.Message);
            app.CancelPartialFrame();
            app.RequestRedraw();
        }
    }

    void OutputReset() {
        if (coLog != null) { coLog.Reset(); }
    }

    static void OutputClearRequested() {
        ZanIDE ide = ZanIDE.current;
        if (ide == null || ide.coCtxOpen) { return; }
        ide.log = new List<string>();
        ide.coFilter.SetText("");
        ide.OutputReset();
    }

    // EnsureLsp, SyncEditorDocument, RefreshFoldRanges moved to ZanIDE.Lsp.zan

}

