using System;
using System.IO;
using System.Collections.Generic;
using System.Windows;
using Gui;
using Gui.Widget;
using Gui.Backend;

// Zan Publish Studio 主控壳层：管理单窗体状态、工程加载、编译/运行/一键发布流水线。
partial class ZanIDE {
    static ZanIDE current;

    Form form;
    App app;
    PublishStudio studio;

    string root = "";
    bool haveProject = false;
    List<string> log = new List<string>();
    int lastLogCount = -1;

    List<PublishTargetOption> pubTargets = new List<PublishTargetOption>();
    List<Checkbox> targetBoxes = new List<Checkbox>();

    bool buildBusy = false;
    bool buildIsRun = false;
    int buildConsumed = 0;
    string runExe = "";
    string runDir = "";

    bool pubBusy = false;
    bool pubPacking = false;
    int pubConsumed = 0;
    int pubPackStartMs = 0;
    int pubPct = 0;
    string statusMsg = "";
    string pubRoot = "";
    string jobPublishedTarget = "";
    List<string> pubExes = new List<string>();

    bool runPolling = false;
    int runConsumed = 0;

    LayerState pubDoneAsk = null;
    string pubDoneTarget = "";
    ConfigWindow cfgWindow = null;

    FilePicker pathPicker = new FilePicker();
    int pathPickerOwner = 0; // 1 = open zan.proj, 2 = pick icon
    int lastSkinIdx = -1;
    int savedW = 1040;
    int savedH = 720;
    bool updatingUi = false;

    static void ApplySavedPreferences(App app) {
        string cfg = "";
        string path = ZanIDE.CfgPath();
        if (File.Exists(path)) { cfg = File.ReadAllText(path); }
        string lang = ZanIDE.CfgStr(cfg, "lang", "");
        if (lang == "en" || lang == "zh") {
            ZanIDE.uiLang = lang;
        } else {
            ZanIDE.uiLang = ZanIDE.ReadUiLang();
        }
        string skin = ZanIDE.CfgStr(cfg, "skin", "");
        if (skin != "" && app != null) {
            app.ApplySkinName(skin);
        }
    }

    static void Attach(Form form) {
        try {
            ZanIDE ide = new ZanIDE();
            ZanIDE.current = ide;
            ide.InitShell(form);
        } catch (Exception e) {
            string m = e.Message;
            if (m == "") { m = "unknown error"; }
            string p = ZanIDE.CacheDir() + "/ide_error.log";
            Directory.CreateDirectoryRecursive(ZanIDE.CacheDir());
            File.WriteAllText(p, "ZanIDE crashed: " + m + "\n");
            #if WINDOWS
            System.Windows.MessageBox.Show("ZanIDE crashed: " + m, "ZanIDE");
            #endif
        }
    }

    void InitShell(Form f) {
        form = f;
        app = f.GetApp();
        studio = f.Get<PublishStudio>("Studio");
        lastSkinIdx = app.ThemeMenuIndex();
        statusMsg = ZanIDE.T("Ready", "就绪");

        form.On("openProject", () => { this.OpenProjectPicker(); });
        form.On("openConfig", () => { this.OpenConfigWindow(); });
        form.On("toggleLang", () => { this.ToggleLanguage(); });
        form.On("startPublish", () => { this.BeginPublish(); });
        form.On("startBuild", () => { this.BeginBuild(false); });
        form.On("startRun", () => { this.BeginBuild(true); });
        form.On("openPublishDir", () => { this.OpenPublishFolder(); });
        form.On("clearLog", () => { this.ClearLog(); });

        if (studio != null) {
            studio.RecentSelect.Change.Add(() => { this.OnRecentPicked(); });
            studio.ChkSingleFile.Change.Add(() => { this.OnQuickOptionToggled(); });
            studio.ChkPackAssets.Change.Add(() => { this.OnQuickOptionToggled(); });
            studio.ChkPubDebug.Change.Add(() => { this.OnQuickOptionToggled(); });
            studio.ChkStripSymbols.Change.Add(() => { this.OnQuickOptionToggled(); });
            studio.ChkDenyWarnings.Change.Add(() => { this.OnQuickOptionToggled(); });
        }

        form.FrameHook(() => { this.FrameTick(); });
        form.Every(120, () => { this.PollJobs(); });
        form.OnExit(() => { this.OnExit(); });

        this.LoadInitialProject();
        this.RefreshUi();
    }

    void LoadInitialProject() {
        string last = ZanIDE.ReadLastProject();
        if (last != "" && File.Exists(last + "/zan.proj")) {
            this.LoadProject(last);
            return;
        }
        List<string> recents = ZanIDE.ReadRecentProjects();
        for (int i = 0; i < recents.Count; i = i + 1) {
            if (File.Exists(recents[i] + "/zan.proj")) {
                this.LoadProject(recents[i]);
                return;
            }
        }
        log.Add(ZanIDE.T("> Select a zan.proj project to configure targets and publish.",
                         "> 请选择 zan.proj 项目以配置目标平台并一键发布。"));
    }

    void LoadProject(string dir) {
        string clean = ZanIDE.NormSlashes(dir);
        if (!File.Exists(clean + "/zan.proj")) {
            Layer.Msg(app, ZanIDE.T("Selected folder does not contain zan.proj.",
                "所选目录不包含 zan.proj 配置文件。"), 2);
            return;
        }
        root = clean;
        haveProject = true;
        ZanIDE.WriteLastProject(root);
        pubTargets = ZanIDE.ReadProjectPlatformOptions(root);
        pubPct = 0;
        statusMsg = ZanIDE.T("Project loaded", "已加载项目");
        log.Add(ZanIDE.T("> Loaded project: ", "> 已加载项目：") + root);
        this.RefreshUi();
    }

    string ProjectTypeLabel() {
        if (!haveProject) { return "NONE"; }
        if (ZanIDE.IsLibraryProject(root)) { return "LIB"; }
        if (ZanIDE.ProjField(root, "mvcRoutes") != "") { return "MVC"; }
        if (ZanIDE.IsGuiProject(root)) { return "GUI"; }
        return "CLI";
    }

    bool IsBusy() { return buildBusy || pubBusy; }

    void RefreshUi() {
        if (studio == null) { return; }
        updatingUi = true;
        try {
            string entryRel = haveProject ? ZanIDE.ProjField(root, "entry") : "";
            bool singleFile = haveProject && ZanIDE.ProjSingleFile(root);
            bool packAssets = haveProject && ZanIDE.PackEnabled(root);
            bool pubDebug = haveProject && ZanIDE.ProjPublishDebug(root);
            bool stripSymbols = haveProject && ZanIDE.ProjStripSymbols(root);
            bool denyWarnings = haveProject && ZanIDE.ProjDenyWarnings(root);

            studio.ApplyTexts(haveProject, root, entryRel, this.ProjectTypeLabel(),
                singleFile, packAssets, pubDebug, stripSymbols, denyWarnings,
                this.IsBusy(), pubPct, statusMsg);
            studio.PopulateRecent(ZanIDE.ReadRecentProjects(), root);
            targetBoxes = studio.PopulateTargets(pubTargets, !haveProject || this.IsBusy());
            for (int i = 0; i < targetBoxes.Count; i = i + 1) {
                int idx = i;
                targetBoxes[i].Change.Add(() => { this.OnTargetBoxChanged(idx); });
            }
            this.SyncLogView();
            string winTitle = IdeVersion.Product();
            if (haveProject) { winTitle = winTitle + " — " + ZanIDE.BaseName(root); }
            form.SetTitle(winTitle);
        } finally {
            updatingUi = false;
        }
        app.RequestRedraw();
    }

    void SyncLogView() {
        if (studio == null) { return; }
        if (log.Count == lastLogCount) { return; }
        lastLogCount = log.Count;
        studio.SetLogText(string.Join("\n", log));
    }

    void OnTargetBoxChanged(int idx) {
        if (updatingUi || idx < 0 || idx >= pubTargets.Count || idx >= targetBoxes.Count) { return; }
        pubTargets[idx].selected = targetBoxes[idx].IsChecked();
        ZanIDE.SavePublishPlatforms(root, pubTargets);
    }

    void OnRecentPicked() {
        if (updatingUi || studio == null || this.IsBusy()) { return; }
        string picked = studio.RecentSelect.SelectedValue();
        if (picked != "" && picked != root) {
            this.LoadProject(picked);
        }
    }

    void OnQuickOptionToggled() {
        if (updatingUi || !haveProject || studio == null) { return; }
        ZanIDE.SetProjField(root, "singleFile",
            studio.ChkSingleFile.IsChecked() ? "true" : "false");
        if (studio.ChkPackAssets.IsChecked()) {
            ZanIDE.EnablePack(root, log);
        } else {
            ZanIDE.DisablePack(root, log);
        }
        ZanIDE.SetProjField(root, "pubDebug",
            studio.ChkPubDebug.IsChecked() ? "true" : "false");
        ZanIDE.SetProjField(root, "secStripSymbols",
            studio.ChkStripSymbols.IsChecked() ? "1" : "0");
        ZanIDE.SetProjField(root, "denyWarnings",
            studio.ChkDenyWarnings.IsChecked() ? "1" : "0");
    }

    void ToggleLanguage() {
        ZanIDE.uiLang = (ZanIDE.uiLang == "zh") ? "en" : "zh";
        ChildWindows.ApplyLanguage(ZanIDE.uiLang);
        this.RefreshUi();
    }

    void OpenProjectPicker() {
        if (this.IsBusy() || pathPicker.IsOpen()) { return; }
        string init = ZanIDE.ReadLastPickerDirectory(root);
        pathPickerOwner = 1;
        pathPicker.BeginOpenFile(init, ".proj",
            ZanIDE.T("Open zan.proj Project File", "打开 zan.proj 项目文件"));
        app.RequestRedraw();
    }

    void OpenConfigWindow() {
        if (!haveProject || this.IsBusy()) { return; }
        if (cfgWindow != null && cfgWindow.IsOpen()) { return; }
        cfgWindow = ConfigWindow.Open(app, root, log, ZanIDE.uiLang);
        app.RequestRedraw();
    }

    void OpenPublishFolder() {
        if (!haveProject) { return; }
        string pubDir = root + "/publish";
        if (!Directory.Exists(pubDir)) { pubDir = root; }
        ZanIDE.RevealInFileManager(pubDir);
    }

    void ClearLog() {
        log = new List<string>();
        lastLogCount = -1;
        this.SyncLogView();
        app.RequestRedraw();
    }

    void BeginBuild(bool runAfter) {
        if (!haveProject) { return; }
        if (this.IsBusy()) {
            Layer.Msg(app, ZanIDE.T("Another build or publish task is running.",
                "已有编译或发布任务正在运行。"), 2);
            return;
        }
        string entry = ZanIDE.ProjectEntryPath(root);
        if (!File.Exists(entry)) {
            log.Add(ZanIDE.T("> Entry file not found: ", "> 入口文件不存在：") + entry);
            this.SyncLogView();
            return;
        }
        if (runAfter && ZanIDE.IsLibraryProject(root)) {
            Layer.Msg(app, ZanIDE.T("Library projects cannot be executed directly.",
                "库项目无法直接运行。"), 2);
            return;
        }
        string bd = ZanIDE.EnsureBuildDir(root);
        string inputs = ZanIDE.InputsArg(bd, ".zanbuild_inputs",
            ZanIDE.ProjectInputs(ZanIDE.DirOf(entry), entry, ""));
        string projName = ZanIDE.ProjField(root, "name");
        string baseName = projName != "" ? projName : ZanIDE.BaseName(root);
        string ext = ZanIDE.IsLibraryProject(root) ? ZanIDE.HostLibExt() : ZanIDE.ExeSuffix();
        string outExe = bd + "/" + baseName + ext;
        string ll = bd + "/.zanbuild.ll";
        string cmd = ZanIDE.CompileToExe(root, entry, inputs, ll, outExe, false, true)
            + ZanIDE.EmbedArgs(root);

        buildBusy = true;
        buildIsRun = runAfter;
        buildConsumed = 0;
        runExe = outExe;
        runDir = bd;
        pubPct = 20;
        statusMsg = runAfter
            ? ZanIDE.T("Building to run...", "正在编译以便运行...")
            : ZanIDE.T("Building project...", "正在编译检查...");
        log.Add(ZanIDE.T("> Building: ", "> 开始编译：") + outExe);
        ZanIDE.BuildDetachWithPre(cmd, root, ZanIDE.ProjPreBuild(root));
        this.RefreshUi();
    }

    void BeginPublish() {
        if (!haveProject) { return; }
        if (this.IsBusy()) {
            Layer.Msg(app, ZanIDE.T("Another build or publish task is running.",
                "已有编译或发布任务正在运行。"), 2);
            return;
        }
        ZanIDE.SavePublishPlatforms(root, pubTargets);
        pubExes = ZanIDE.PublishPlatformsBeginWithOptions(root, pubTargets, log);
        if (pubExes.Count == 0) {
            Layer.Msg(app, ZanIDE.T("Please select at least one target platform.",
                "请至少勾选一个目标发布平台。"), 2);
            this.SyncLogView();
            return;
        }
        pubBusy = true;
        pubPacking = false;
        pubConsumed = 0;
        pubPackStartMs = 0;
        pubRoot = root;
        jobPublishedTarget = "";
        pubPct = 20;
        statusMsg = ZanIDE.T("Compiling publish targets...", "正在编译发布目标...");
        this.RefreshUi();
    }

    void PollJobs() {
        if (buildBusy) {
            buildConsumed = ZanIDE.BuildPoll(buildConsumed, log);
            if (File.Exists(ZanIDE.BuildDonePath())) {
                bool ok = ZanIDE.DoneOk(ZanIDE.BuildDonePath());
                buildBusy = false;
                if (ok) {
                    pubPct = 100;
                    statusMsg = ZanIDE.T("Build succeeded", "编译成功");
                    log.Add(ZanIDE.T("> Build succeeded.", "> 编译成功。"));
                    if (buildIsRun && File.Exists(runExe)) {
                        string entry = ZanIDE.ProjectEntryPath(root);
                        ZanIDE.CopyPayload(root, runDir, entry, log);
                        ZanIDE.RunConsole(runExe, runDir);
                        runPolling = true;
                        runConsumed = 0;
                        statusMsg = ZanIDE.T("Running...", "运行中...");
                    }
                } else {
                    pubPct = 0;
                    statusMsg = ZanIDE.T("Build failed", "编译失败");
                    log.Add(ZanIDE.T("> Build failed.", "> 编译失败。"));
                }
                this.RefreshUi();
            } else {
                if (pubPct < 80) { pubPct = pubPct + 3; }
                if (studio != null) { studio.PubProgress.SetPercent(pubPct); }
            }
        }

        if (pubBusy && !pubPacking) {
            pubConsumed = ZanIDE.PubPoll(pubConsumed, log);
            if (File.Exists(ZanIDE.PubDonePath())) {
                bool ok = ZanIDE.DoneOk(ZanIDE.PubDonePath());
                if (!ok) {
                    log.Add(ZanIDE.T("> Publish compile step failed.", "> 发布编译阶段失败。"));
                    this.FinishPublish(false);
                } else {
                    bool pack = ZanIDE.ProjSingleFile(pubRoot) && !ZanIDE.IsLibraryProject(pubRoot);
                    if (PubPack.NeedsPackaging(pubRoot, pubExes, pack)) {
                        int st = PubPack.Start(pubRoot, pubExes, pack);
                        if (st > 0) {
                            pubPacking = true;
                            pubPackStartMs = Gui.Backend.Window.GetTickMs();
                            pubPct = 75;
                            statusMsg = ZanIDE.T("Packaging outputs...", "正在归档打包产物...");
                            this.RefreshUi();
                        } else {
                            bool syncOk = PubPack.PackNow(pubRoot, pubExes, pack, log);
                            this.ResolvePublishedTarget();
                            this.FinishPublish(syncOk);
                        }
                    } else {
                        this.ResolvePublishedTarget();
                        this.FinishPublish(true);
                    }
                }
            } else {
                if (pubPct < 70) { pubPct = pubPct + 2; }
                if (studio != null) { studio.PubProgress.SetPercent(pubPct); }
            }
        }

        if (pubBusy && pubPacking) {
            PubJob doneJob = PubPack.Ready();
            if (doneJob != null) {
                for (int i = 0; i < doneJob.log.Count; i = i + 1) {
                    log.Add(doneJob.log[i]);
                }
                this.ResolvePublishedTarget();
                this.FinishPublish(doneJob.ok);
            } else {
                statusMsg = ZanIDE.T("Packaging: ", "打包中：") + PubPack.Stage();
                if (studio != null) { studio.StatusLabel.SetProp("text", statusMsg); }
            }
        }

        if (runPolling) {
            runConsumed = ZanIDE.RunPoll(runConsumed, log);
            if (File.Exists(ZanIDE.RunDonePath())) {
                runPolling = false;
                statusMsg = ZanIDE.T("Run exited", "运行结束");
                this.RefreshUi();
            }
        }

        this.SyncLogView();
    }

    void ResolvePublishedTarget() {
        jobPublishedTarget = pubRoot + "/publish";
        for (int i = 0; i < pubExes.Count; i = i + 1) {
            if (File.Exists(pubExes[i])) {
                jobPublishedTarget = pubExes[i];
                return;
            }
        }
    }

    void FrameTick() {
        int dscale = app.dpiScale;
        if (dscale <= 0) { dscale = 100; }
        savedW = app.ClientWidth() * 100 / dscale;
        savedH = app.ClientHeight() * 100 / dscale;

        pathPicker.ApplySkin(app.ThemeMenuIndex());
        if (app.ThemeMenuIndex() != lastSkinIdx) {
            lastSkinIdx = app.ThemeMenuIndex();
            ChildWindows.FollowSkin(lastSkinIdx);
        }

        nint evh = Gui.Backend.Window.EventHwnd();
        if (pathPicker.OwnsWindow(evh)) {
            pathPicker.ApplyEvent(evh);
            if (pathPicker.NeedsRedraw()) { pathPicker.RenderWindow(); }
        } else if (evh != 0 && evh != app.WindowHandle()) {
            ChildWindows.RouteEvent(evh);
        }

        this.PumpFilePicker();
        this.PumpConfigWindow();
        this.SyncPublishDialog();
    }

    void PumpFilePicker() {
        int pr = pathPicker.TakeResult();
        if (pr == 0) { return; }
        string picked = ZanIDE.NormSlashes(pathPicker.SelectedPath());
        string curDir = ZanIDE.NormSlashes(pathPicker.CurrentDirectory());
        if (curDir != "") { ZanIDE.WriteLastPickerDirectory(curDir); }
        int owner = pathPickerOwner;
        pathPickerOwner = 0;
        if (pr != 1 || picked == "") { return; }

        if (owner == 1) {
            string dir = Directory.Exists(picked) ? picked : ZanIDE.DirOf(picked);
            this.LoadProject(dir);
        } else if (owner == 2 && haveProject) {
            string dst = ZanIDE.AssetsDir(root) + "/app.ico";
            Directory.CreateDirectoryRecursive(ZanIDE.AssetsDir(root));
            if (ZanIDE.NormSlashes(picked) != ZanIDE.NormSlashes(dst)) {
                File.Copy(picked, dst);
            }
            ZanIDE.SetProjectIcon(root, "assets/app.ico");
            log.Add(ZanIDE.T("> Updated application icon: assets/app.ico",
                             "> 已更新应用图标：assets/app.ico"));
            if (cfgWindow != null && cfgWindow.IsOpen()) {
                cfgWindow.OnLanguageChanged(ZanIDE.uiLang);
            }
            this.RefreshUi();
        }
    }

    void PumpConfigWindow() {
        if (cfgWindow == null) { return; }
        if (cfgWindow.TakeChoose() && !pathPicker.IsOpen()) {
            pathPickerOwner = 2;
            pathPicker.BeginOpenFile(ZanIDE.ReadLastPickerDirectory(root), ".ico",
                ZanIDE.T("Choose Application Icon (.ico)", "选择应用图标 (.ico)"));
            app.RequestRedraw();
        }
        if (cfgWindow.TakeDone()) {
            cfgWindow.Close();
            cfgWindow = null;
            this.RefreshUi();
        }
    }

    void OnExit() {
        ZanIDE.SaveSettings(savedW, savedH, app.SkinName(), ZanIDE.uiLang);
        if (pubPacking) {
            PubPack.DrainAsync();
        }
    }
}
