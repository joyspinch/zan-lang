using System;
using System.IO;
using System.Diagnostics;
using System.Json;
using System.Data;
using System.Data.Sqlite;
using Platform;
using Gui;
using Gui.Widget;
using Gui.Designer;
using Gui.Component;
using Game.Scene;

// ---- AI automation-driver entities ---------------------------------------
// EditorProbeJson publishes a typed editor snapshot; the probe's JSON keys
// (caretLine/caretCol/completionActive/completionSel/completion/text and the
// completion item label/kind) are unchanged so existing ZAN_UI_SCRIPT
// assertions keep matching.

class CompletionItemDoc {
    string label;
    string kind;
}

class EditorProbeDoc {
    int caretLine;
    int caretCol;
    bool completionActive;
    int completionSel;
    List<CompletionItemDoc> completion;
    string text;
}

/// Describes one project template: the category it appears under, its display
/// name / icon / description, the scaffolding "kind" (console / dll-class /
/// gui-empty / webview / server / custom / ...), and, for custom templates, the
/// source directory to copy from.
class Tpl {
    string cat;
    string name;
    string icon;
    string desc;
    string kind;
    string src;
    int order;       // sort key inside the wizard (lower = earlier)
    string ptype;    // zan.proj type for copied templates (console/gui/library)
    string ptarget;  // zan.proj target (exe/dll)
    string pentry;   // zan.proj entry
    // Shape metadata (manifest `sizeable` / `size` / `shape` / `preview` /
    // `sketch`): the wizard shows a device-size row for sizeable templates and
    // draws its right-hand preview from these, so a target size is a parameter
    // of one template instead of a dozen near-identical catalog entries.
    bool sizeable;
    int defW;
    int defH;
    bool round;
    string preview;  // absolute path of a real screenshot, "" when none
    string sketch;   // wireframe tokens, see Wizard.RenderSketch

    static Tpl Make(string cat, string name, string icon, string kind, string desc) {
        Tpl t = new Tpl();
        t.cat = cat;
        t.name = name;
        t.icon = icon;
        t.kind = kind;
        t.desc = desc;
        t.src = "";
        t.order = 1000;
        t.ptype = "console";
        t.ptarget = "exe";
        t.pentry = "src/main.zan";
        t.sizeable = false;
        t.defW = 0;
        t.defH = 0;
        t.round = false;
        t.preview = "";
        t.sketch = "";
        return t;
    }
}

/// A miniature aardio/VS-Code-style IDE built from the enterprise GUI components
/// (Ribbon / TreeView / Tabs / CodeEditor / Panel / Split / Modal / Input /
/// Button) wired to a REAL project on disk and the real Zan toolchain.
///
///   * Project ("New Project"): a modal wizard with categorized templates
///     (Console / GUI App / DLL Library / Executable / Empty), a project name
///     and a location — scaffolds the folder + starter files + zan.proj config.
///   * New ("New File"): a modal wizard with file templates (Program / Class /
///     GUI Window / Interface / Empty).
///   * Explorer tree scanned from disk; click a file to open it in a tab.
///   * Save writes to disk; Build/Run/Publish invoke zanc via Process and
///     stream output to the Output panel. Console/library targets link with
///     zanc's own bundled linker (no external clang/LLVM needed); GUI targets
///     still route through clang to link the native GUI runtime.
partial class ZanIDE {

    // ---- UI language (one-click EN / 中文) ----
    // 0 = English, 1 = 简体中文. Set once at startup from editor.cfg and updated
    // live from the Settings dialog; read everywhere via T(en, zh).
    static int uiLang;


    /// Attached by `App.OnLoad`: the designed window is handed to the IDE,
    /// which builds its state, mounts the shell surface and drives the
    /// per-frame work through Form.FrameHook / Form.OnExit. A crash here
    /// (before the event loop starts) writes the cache crash log and shows
    /// it (a Windows GUI program has no console, so the compiler's
    /// "Unhandled exception" stderr print would be invisible). The handler
    /// stays on field access and finally-free calls only (A35: a call into a
    /// finally-bearing method from a try region of this giant module fails
    /// to compile).
    static void Attach(Form form) {
        try {
            ZanIDE ide = new ZanIDE();
            ZanIDE.current = ide;
            ide.InitShell(form);
        } catch (Exception e) {
            string m = e.Message;
            if (m == "") { m = "unknown error"; }
            string p = ZanIDE.CacheDir() + "/ide_error.log";
            Directory.CreateDirectoryRecursive(ZanIDE.CacheDir());
            File.WriteAllText(p, "ZanIDE crashed: " + m + "\n");
            #if WINDOWS
            MessageBox.Show("ZanIDE crashed: " + m, "ZanIDE");
            #endif
        }
    }

    /// The project-relative path of the right-clicked file-tree row, or ""
    /// when there is no project or the row is the root itself. Generation
    /// actions are stored per relative path, so the tree and zan.proj stay in
    /// agreement when the project moves.
    string CtxProjRel() {
        if (!haveProject) { return ""; }
        if (ctxTarget < 0 || ctxTarget >= treeShow.Count) { return ""; }
        string p = treeShow[ctxTarget].path;
        if (p == "" || p == root) { return ""; }
        if (!ZanIDE.StartsWith(p, root)) { return ""; }
        return ZanIDE.NormRel(p.Substring(root.Length, p.Length - root.Length));
    }

    /// Marks the generation action an item currently has in the menu.
    static string GenMark(string cur, string act) {
        if (cur == act) { return "✓ "; }
        return "   ";
    }

    /// The generation action's name in the UI language.
    static string GenLabel(string act) {
        if (act == "copy") { return ZanIDE.T("Copy to Output", "复制到输出"); }
        if (act == "embed") { return ZanIDE.T("Embed", "内嵌到程序"); }
        return ZanIDE.T("None", "不处理");
    }

    /// One frame of work after App.ProcessEvent handled the main window's
    /// event: follow skin/opacity/wallpaper to the child windows, route
    /// events addressed to other windows, handle the debug shortcuts, pump
    /// the secondary windows and rescan the tree when requested.
    void FrameTick() {
        // Advance any active AI automation script (ZAN_UI_SCRIPT). This
        // it injects synthetic events this loop then polls & dispatches.
        FilePicker.lang = ZanIDE.uiLang;
        CodeEditor.lang = ZanIDE.uiLang;
        Designer.lang = ZanIDE.uiLang;
        pathPicker.ApplySkin(app.ThemeMenuIndex());
        // Skin follow: App.SyncSkin raises themeMenuChange (delegate event)
        // when the user picks a new skin; every child window then follows
        // the main window's look here, once per change.
        if (app.ThemeMenuIndex() != lastSkinIdx) {
            lastSkinIdx = app.ThemeMenuIndex();
            ChildWindows.FollowSkin(lastSkinIdx);
        }
        // Opacity follow: the appearance drawer sets it on the main
        // window; children inherit it and the value is persisted.
        if (app.WindowOpacity() != winOpacity) {
            winOpacity = app.WindowOpacity();
            ChildWindows.FollowOpacity(winOpacity);
        }
        // Wallpaper: the appearance drawer asks the host to pick a file
        // (App has no file dialog), and any change follows to the children.
        if (app.ConsumeWallpaperPick() && !pathPicker.IsOpen()) {
            pathPicker.BeginOpenFile(
                ZanIDE.ReadLastPickerDirectory(root), ".png;.jpg;.jpeg;.bmp",
                ZanIDE.T("Choose a window background image", "选择窗口背景图片"));
            pathPickerOwner = 9;
            app.RequestRedraw();
        }
        if (app.UserWallpaperPath() != wallPath
                || app.UserWallpaperOpacity() != wallOpacity) {
            wallPath = app.UserWallpaperPath();
            wallOpacity = app.UserWallpaperOpacity();
            ChildWindows.FollowWallpaper(wallPath, wallOpacity);
        }
        app.PerfMark("sh.skin");

        // Child-window animation deadlines are folded into the main loop's
        // idle wait and due windows woken by ChildWindows.FoldDeadlines,
        // called from Form.Run() after this frame hook.
        nint evh = Window.EventHwnd();
        // The raw native kind: this is the router, so it must see events
        // for every window (a child's close arrives with evh == that child).
        // Widgets, by contrast, go through App.EventKind(), which hides
        // events belonging to another window. Main-window events were
        // already handled by App.ProcessEvent; only events addressed to
        // other windows reach this router.
        int kind = app.window.EventKind();

        if (kind == 8) {
            if (ChildWindows.Route(evh)) {
                // A child window closed: it drops out of the registry on
                // the next pump, and the page it fed may need a repaint.
                lastActive = 0 - 1;
                app.RequestRedraw();
            } else if (pathPicker.OwnsWindow(evh)) {
                pathPicker.ApplyEvent(evh);
            } else if (evh == app.WindowHandle()) {
                // Close of the main window: App.ProcessEvent already stopped
                // the loop, so this frame hook must not keep running.
                return;
            } else {
                app.RequestRedraw();
            }
        } else if (pathPicker.OwnsWindow(evh)) {
            pathPicker.ApplyEvent(evh);
        } else if (evh != app.WindowHandle()) {
            // Deliver to the one window the event was addressed to (a wizard
            // or child window owns it, or nobody does).
            ChildWindows.Route(evh);
        }
        app.PerfMark("sh.route");
        // The form designer is bound to .zform tabs (C#-style form files):
        // the active tab's extension decides whether the designer or the code
        // editor is shown, rather than a global toggle.
        int actDM = activeTab.Get();
        if (actDM >= 0 && actDM < tabs.Count) {
            designerMode = ZanIDE.IsFormPath(tabs[actDM].path) && tabs[actDM].path != codeViewForm;
            sceneMode = ZanIDE.IsScenePath(tabs[actDM].path) && tabs[actDM].path != codeViewForm;
        } else {
            designerMode = false;
            sceneMode = false;
        }


        // ---- keyboard shortcuts for debug ----
        if (kind == 5) {
            int kc = app.window.EventKeyCode();
            if (kc == 116 && dbgState == 0) {
                // F5 = Start Debug (same as clicking Debug button). The
                // `-g` build runs DETACHED; the poll opens the debugger on
                // success so F5 never freezes the window during compilation.
                if (!buildBusy) {
                    this.SaveActiveTab();
                    string dExe = ZanIDE.DebugBuildBegin(tabs, activeTab, root, log);
                    if (dExe != "") {
                        buildBusy = true;
                        buildStartMs = Window.GetTickMs();
                        buildThenRun = false;
                        dbgBuildPending = true;
                        buildExe = dExe;
                        buildTargetPath = ZanIDE.PathOf(tabs, activeTab);
                        buildLogLen = 0;
                        dock.Focus("output");
                        app.RequestAnimationFrame(80);
                    }
                }
                app.RequestRedraw();
            } else if (kc == 116 && dbgState == 2) {
                // F5 = Continue
                if (dbg != null) { dbg.Continue(); }
                dbgState = ZanIDE.DbgSync(dbg, editor, log, dbgConsole);
                dbgExecLine = ZanIDE.DbgLine(dbg);
                dbgVarInfo = ZanIDE.DbgVars(dbg);
                dbgStack = ZanIDE.DbgStack(dbg);
                dbgWatchVals = ZanIDE.DbgEvalWatches(dbg, dbgWatches);
                if (dbgState == 2) {
                    ZanIDE.LogVarsToConsole(log, dbgVarInfo, dbgExecLine);
                } else {
                    dbg = null;
                }
                app.RequestRedraw();
            } else if (kc == 121 && dbgState == 2) {
                // F10 = Step Over
                if (dbg != null) { dbg.StepOver(); }
                dbgState = ZanIDE.DbgSync(dbg, editor, log, dbgConsole);
                dbgExecLine = ZanIDE.DbgLine(dbg);
                dbgVarInfo = ZanIDE.DbgVars(dbg);
                dbgStack = ZanIDE.DbgStack(dbg);
                dbgWatchVals = ZanIDE.DbgEvalWatches(dbg, dbgWatches);
                if (dbgState == 2) {
                    ZanIDE.LogVarsToConsole(log, dbgVarInfo, dbgExecLine);
                } else {
                    dbg = null;
                }
                app.RequestRedraw();
            } else if (kc == 122 && dbgState == 2) {
                // F11 = Step Into
                if (dbg != null) { dbg.StepIn(); }
                dbgState = ZanIDE.DbgSync(dbg, editor, log, dbgConsole);
                dbgExecLine = ZanIDE.DbgLine(dbg);
                dbgVarInfo = ZanIDE.DbgVars(dbg);
                dbgStack = ZanIDE.DbgStack(dbg);
                dbgWatchVals = ZanIDE.DbgEvalWatches(dbg, dbgWatches);
                if (dbgState == 2) {
                    ZanIDE.LogVarsToConsole(log, dbgVarInfo, dbgExecLine);
                } else {
                    dbg = null;
                }
                app.RequestRedraw();
            } else if (kc == 27 && dbgState == 2) {
                // Escape = Stop debugging
                if (dbg != null) { dbg.Stop(); dbg = null; }
                dbgState = 0; dbgExecLine = -1; editor.SetExecLine(-1);
                log.Add("> [Debug] Stopped.");
                app.RequestRedraw();
            } else if (kc == 27 && refList.IsOpen()) {
                // Escape = close the reference list (before the find bar:
                // it is the thing that opened last).
                refList.Close();
                app.RequestRedraw();
            } else if (kc == 27 && findMode > 0) {
                // Escape = close find/replace/goto, and hand the keyboard
                // back to the editor the bar took it from.
                findMode = 0;
                app.focus.SetFocused(editor.LastWidgetId());
                app.RequestRedraw();
            } else if (kc == 27 && pubWin != null && pubWin.IsOpen()) {
                // Escape = close publish window
                pubWin.Close();
                app.RequestRedraw();
            } else if (kc == 27 && marketplaceWin != null && marketplaceWin.IsOpen()) {
                marketplaceWin.Close();
                app.RequestRedraw();
            } else if (kc == 123 && !designerMode && dbgState == 0) {
                // F12 = Go to Definition
                if (lspSess == null && !lspTried) {
                    lspTried = true;
                    lspSess = LspSession.Start(root);
                    if (lspSess != null) { log.Add("> zan-lsp connected: semantic navigation enabled."); }
                }
                string navW_gl12 = editor.WordAtCaret();
                this.RememberTabView();
                int gl12 = ZanIDE.GoToDefinitionSmart(lspSess, editor, tabs, activeTab, root, log);
                this.ApplyGotoResult(gl12, navW_gl12);
                app.RequestRedraw();
            } else if (kc == 113 && !designerMode && dbgState == 0) {
                // F2 = Rename Symbol
                renameWord = editor.WordAtCaret();
                if (renameWord.Length > 0) {
                    findMode = 5;
                } else {
                    log.Add("> Rename: no symbol under caret.");
                }
                app.RequestRedraw();
            } else if (kc == 119 && !designerMode && dbgState == 0) {
                // F8 / Shift+F8 = walk the Find in Files results, opening
                // the file when the match is in one that is not open.
                if (fifHits.Count == 0) {
                    log.Add(ZanIDE.T("> No search results. Ctrl+Shift+F searches the project.",
                        "> 没有搜索结果。Ctrl+Shift+F 可搜索整个项目。"));
                } else {
                    if (Modifiers.HasShift(app.window.EventMods())) {
                        fifSel = fifSel - 1;
                        if (fifSel < 0) { fifSel = fifHits.Count - 1; }
                    } else {
                        fifSel = fifSel + 1;
                        if (fifSel >= fifHits.Count) { fifSel = 0; }
                    }
                    int hitLine = ZanIDE.GotoSearchHit(fifHits, fifSel,
                        tabs, activeTab, log);
                    if (hitLine >= 0) {
                        pendingGotoLine = hitLine;
                        pendingGotoCol = 0;
                        lastActive = 0 - 1;
                    }
                }
                app.RequestRedraw();
            } else if (kc == 118 && dbgState == 0) {
                // F7 on a design tab toggles it in place between the visual
                // designer and a read-only source view (a .zform shows its
                // design JSON, a .zscene its generated code); on a code
                // file it opens the .zform paired with it.
                int actF7 = activeTab.Get();
                if (actF7 >= 0 && actF7 < tabs.Count
                        && (ZanIDE.IsFormPath(tabs[actF7].path)
                            || ZanIDE.IsScenePath(tabs[actF7].path))) {
                    string fp7 = tabs[actF7].path;
                    if (codeViewForm == fp7) {
                        codeViewForm = "";
                        log.Add(ZanIDE.T("> Design view.", "> 设计视图。"));
                    } else {
                        codeViewForm = fp7;
                        formCodeLoaded = "";
                        log.Add(ZanIDE.T("> Code view.", "> 代码视图。"));
                    }
                    lastActive = 0 - 1;
                } else if (actF7 >= 0 && actF7 < tabs.Count) {
                    string ap7 = tabs[actF7].path;
                    if (ap7.Length > 4 && ap7.Substring(ap7.Length - 4, 4) == ".zan") {
                        string cand7 = ap7.Substring(0, ap7.Length - 4) + ".zform";
                        if (File.Exists(cand7)) {
                            int ci7 = ZanIDE.FindTabByPath(tabs, cand7);
                            if (ci7 >= 0) { activeTab.Set(ci7); }
                            else { ZanIDE.OpenPath(tabs, activeTab, cand7, Path.GetFileName(cand7)); }
                            loadedFormPath = "";
                            lastActive = 0 - 1;
                        } else {
                            log.Add("> No paired .zform for " + Path.GetFileName(ap7) + ".");
                        }
                    }
                }
                app.RequestRedraw();
            }
        }
        app.PerfMark("sh.debug");
        // Ctrl+key via WM_CHAR (kind == 6)
        if (kind == 6) {
            int cc = app.window.EventKeyCode();
            if (cc == 6) {
                // Ctrl+F = Find in this file, Ctrl+Shift+F = Find in Files
                if (Modifiers.HasShift(app.window.EventMods())) {
                    findMode = 6;
                    fifQuery = "";
                } else {
                    if (findMode != 2) { findMode = 1; }
                    findBar.Open(false, this.FindSeed());
                }
                app.RequestRedraw();
            } else if (cc == 7) {
                // Ctrl+G = Go to Line
                findMode = 3;
                app.RequestRedraw();
            } else if (cc == 18) {
                // Ctrl+R = Replace (Ctrl+H is 8 which conflicts with
                // Backspace); Ctrl+Shift+R = Replace in Files
                if (Modifiers.HasShift(app.window.EventMods())) {
                    findMode = 7;
                    fifRepl = "";
                } else {
                    findMode = 2;
                    findBar.Open(true, this.FindSeed());
                }
                app.RequestRedraw();
            } else if (cc == 2) {
                // Ctrl+B = edit the breakpoint condition on the caret line
                if (!designerMode) {
                    findMode = 4;
                }
                app.RequestRedraw();
            } else if (cc == 5) {
                // Ctrl+E = Format Document (zanfmt); Ctrl+D is taken by
                // the editor's duplicate-line.
                if (!designerMode && !sceneMode && findMode == 0) {
                    ZanIDE.FormatDocument(editor, log);
                }
                app.RequestRedraw();
            } else if (cc == 19) {
                // Ctrl+S = Save (+ hot reload when enabled)
                int aSv = activeTab.Get();
                if (aSv >= 0 && aSv < tabs.Count
                        && ZanIDE.IsFormPath(tabs[aSv].path) && codeViewForm == tabs[aSv].path) {
                    // The .zform code view shows the design JSON, which is
                    // owned by the designer - it is read-only here.
                    log.Add(ZanIDE.T("> The design JSON is read-only here; edit the design, or open Name.zan for logic.", "> 设计 JSON 此处只读；请修改设计，或打开 Name.zan 编写逻辑。"));
                } else if (aSv >= 0 && aSv < tabs.Count
                        && ZanIDE.IsScenePath(tabs[aSv].path) && codeViewForm == tabs[aSv].path) {
                    // The .zscene code view shows the code the compiler
                    // projects from the design - it is read-only here.
                    log.Add(ZanIDE.T("> The projected scene code is read-only; edit the design, or open Name.zan for logic.", "> 场景投影代码只读；请修改设计，或打开 Name.zan 编写逻辑。"));
                } else if (!designerMode && !sceneMode && aSv >= 0 && aSv < tabs.Count && tabs[aSv].path != "@start") {
                    this.SaveActiveTab();
                    if (autoRun) { hotReloadReq = true; }
                    rescan = true;
                    Layer.Msg(ZanIDE.T("Saved", "已保存"), 3);
                }
                app.RequestRedraw();
            }
        }
        app.PerfMark("sh.input");

        // Apply what the secondary windows reported (Publish / Project
        // Configuration / Marketplace / Settings / the file picker): each
        // window class takes its own actions; these pumps only translate
        // them into shell state. The frames themselves were already
        // rendered by ChildWindows.PumpAll inside Form.Run().
        this.PumpPublishWindow();
        this.PumpConfigWindow();
        this.PumpMarketplaceWindow();
        this.PumpSettingsWindows();
        this.PumpFilePicker();
        app.PerfMark("sh.children");

        // Deferred AI-settings open (see aiCfgPending). Creating a top-level
        // window has to happen BETWEEN frames: run from inside PaintFrame it
        // ran in the middle of the main window's own frame, which left the new
        // window unpainted on the first click and took the process down on the
        // next one.
        if (aiCfgPending) {
            aiCfgPending = false;
            if (aiWindow == null || !aiWindow.IsOpen()) {
                aiWindow = AiSettingsWindow.Open(app, ZanIDE.uiLang);
            }
            app.RequestRedraw();
        }

        if (rescan) {
            rescan = false;
            // Keep the user's expanded folders across the rebuild: a
            // rescan after e.g. deleting a file must not collapse the tree.
            List<string> expKeep = ZanIDE.ExpandedPaths(tree);
            tree = new List<TreeNode>();
            if (haveProject) {
                tree = ZanIDE.ScanTree(root);
                ZanIDE.ApplyExpanded(tree, expKeep);
            }
            treeSel.Set(-1);
        }
        app.PerfMark("sh.rescan");
    }

    /// 后台活儿（构建、发布、程序输出、git、小助手请求）下一拍的重绘：
    /// 只声明这一拍可能变化的那块像素——那块面板自己。
    ///
    /// 这些轮询过去都用整窗的 RequestAnimationFrame 排下一拍，于是模型
    /// 在想、编译器在跑的那几十秒里，屏上只有一个转圈在动，IDE 却按
    /// 4~12 帧/秒把整个窗口（磨砂主题还要重新模糊一遍背景）重画一遍：
    /// 这就是「小助手一干活 CPU 就上去」的那份活。声明了范围之后，
    /// 由这一拍唤醒的帧走损伤裁剪，只有那块面板被重画；真有内容变化
    /// 的时候各处照旧调 RequestRedraw，整窗帧一帧都没少。面板被收起
    /// （停到屏外）时范围为空，这一拍就只跑轮询逻辑、几乎不画东西。
    void PollNextIn(App app, int ms, Rect r) {
        app.RequestAnimationFrameIn(ms, r.x, r.y, r.width, r.height);
    }

    /// Paints the whole shell into the current frame. Called by
    /// IdeSurface.OnPaint inside Form.Run()'s retained loop (which already
    /// began the frame and will present it), so the frame must not call
    /// BeginFrame/RenderChrome/PresentFrame itself. A single bad widget
    /// must not take the IDE down: the whole frame runs under an exception
    /// boundary, so a failure is logged (see Gui.UiErrorLog / the Help &
    /// Feedback panel), this frame is dropped and the next one is repainted
    /// from scratch.
    void PaintFrame(App app) {
        // The current event kind for the frame's immediate-mode text inputs
        // (the Go-to-Line prompt etc.): same source the frame hook routes on.
        int kind = app.window.EventKind();
        // A single bad widget must not take the IDE down: the whole frame
        // runs under an exception boundary, so a failure is logged (see
        // Gui.UiErrorLog / the Help & Feedback panel), this frame is
        // dropped and the next one is repainted from scratch. The body
        // keeps its original indentation to stay diffable.
        try {
            Canvas c = app.canvas;
            Theme t = app.theme;
            int W = c.Width();
            int H = c.Height();
            // Persist the LOGICAL (96-dpi) window size, not the physical
            // canvas size. The window is created from a logical size that the
            // runtime scales up by the display DPI; saving the scaled size and
            // re-creating from it would re-scale every launch (the window kept
            // growing/shrinking). Divide back out by dpiScale (a percentage).
            int dscale = app.dpiScale;
            if (dscale <= 0) { dscale = 100; }
            savedW = W * 100 / dscale;
            savedH = H * 100 / dscale;
            int top = app.titlebarH;
            int ribbonH = Ribbon.HeightTabbed(app);
            int sbH = app.Scale(22);
            // Themed window backdrop (gradient/glass wallpaper or flat fill)
            // behind the whole shell, so the IDE renders every skin exactly
            // like the gallery. Translucent surfaces below let it show.

            // Enable/disable ribbon commands by context. Build/Publish/Hot/
            // Config need an open project (zan.proj); Run/Debug/Designer work
            // on a single open file; all are disabled on the Start page.
            int atE = activeTab.Get();
            string apE = "";
            if (atE >= 0 && atE < tabs.Count) { apE = tabs[atE].path; }
            bool activeIsFile = apE != "" && apE != "@start";
            bool haveProj = File.Exists(root + "/zan.proj");
            // Run/Debug/Build follow the active file, or fall back to the
            // project entry (so a designer/start tab can still run the app).
            bool canRun = activeIsFile || haveProj;
            // The ribbon is rebuilt each frame: its commands are pure
            // configuration (icon, label, action id) and the View tab is
            // just the dock's own Panels section.
            List<int> ribbonActions = new List<int>();
            List<RibbonGroup> ribbonGroups =
                ZanIDE.BuildRibbonGroups(ribbonTab.Get(), ribbonActions);
            ZanIDE.SyncRibbonEnabled(ribbonGroups, ribbonActions, canRun, haveProj);
            if (ribbonTab.Get() == ZanIDE.RibbonViewTab()) {
                dock.AddSwitchGroup(ribbonGroups, ZanIDE.T("Panels", "面板"));
            } else {
                dock.ClearSwitches();
            }
            // 每个大区域在自己的即时模式 id 段里绘制（见 App.BeginIdScope）：
            // 某个面板这一帧多画 / 少画一个控件，不会把其他区域的 id 推着走，
            // 点击也就不会落到别的控件上。
            app.BeginIdScope(100000);
            int rcPos = Ribbon.RenderTabbed(app, 0, top, W, ribbonTabs, ribbonTab,
                ribbonGroups);
            app.EndIdScope();
            if (dock.HandleRibbon(rcPos)) { rcPos = 0 - 1; }
            int rc = ZanIDE.RibbonAction(ribbonActions, rcPos);
            this.RunRibbonCommand(app, rc);

            // 调试工具条（正在调试时）：按钮由 views/DebugToolbar.zform
            // 声明，这里只把它给出的动作接到调试会话上。
            int dbgBarH = this.RunDebugBar(app, W, top + ribbonH);
            app.PerfMark("sh.ribbon");
            Rect area = new Rect(0, top + ribbonH + dbgBarH, W, H - top - ribbonH - dbgBarH - sbH);
            // The dock resolves every panel's rect and owns the tab strips,
            // split handles and drag/close input; the panels below just draw
            // into the rect it hands back (off-screen while closed, so each
            // panel body stays a plain unconditional render).
            string outlineTitle = ZanIDE.T("STRUCTURE", "结构");
            if (designerMode || sceneMode) { outlineTitle = ZanIDE.T("COMPONENTS", "组件"); }
            if (outlineTitle != dockOutlineTitle) {
                dock.SetTitle("structure", outlineTitle);
                dockOutlineTitle = outlineTitle;
            }
            dock.Begin(app, area);

            // Section 1: Explorer. The tree owns its filter row, scrolling,
            // scrollbar and selection; opening a file and raising the
            // context menu are handlers.
            app.BeginIdScope(150000);
            explorerPanel.Render(app, dock.ContentParked("explorer"), tree);
            app.EndIdScope();
            treeShow = explorerPanel.Shown();
            app.PerfMark("sh.explorer");

            // Section 2: Structure / Components. Shows a code outline for
            // source tabs, and the form's component tree in the designer.
            // Rebuild the tree only when the active buffer/form changes so
            // typing and clicking stay cheap. The signature prefix (C/F)
            // also flips the panel between code outline and components.
            int stActTab = activeTab.Get();
            string newSig = "";
            if (designerMode) {
                List<FormField> flatSig = new List<FormField>();
                ZanIDE.FlattenFields(formDesigner.fields, flatSig);
                newSig = "F:" + Convert.ToString(stActTab) + ":" + Convert.ToString(flatSig.Count);
            } else if (sceneMode) {
                newSig = "S:" + Convert.ToString(stActTab) + ":"
                    + Convert.ToString(sceneDesigner.doc.Count()) + ":"
                    + Convert.ToString(sceneDesigner.doc.ToJson().Length);
            } else {
                // TextStamp is O(lines) with no allocation; the full text is
                // only materialised when the outline actually needs rebuilding.
                newSig = "C:" + Convert.ToString(stActTab) + ":" + Convert.ToString(editor.TextStamp());
                if (newSig != structSig) { structTree = ZanIDE.BuildOutline(editor.GetText()); }
            }
            if (newSig != structSig) {
                structSig = newSig;
                if (designerMode) {
                    string sfn = "Form";
                    if (stActTab >= 0 && stActTab < tabs.Count) {
                        sfn = ZanIDE.FormBaseName(tabs[stActTab].path);
                    }
                    structTree = ZanIDE.BuildFieldTree(sfn, formDesigner.fields);
                } else if (sceneMode) {
                    string scn = "Scene";
                    if (stActTab >= 0 && stActTab < tabs.Count) {
                        scn = ZanIDE.BaseName(tabs[stActTab].path);
                    }
                    structTree = ZanIDE.BuildSceneTree(scn, sceneDesigner);
                }
                structSel.Set(0 - 1);
            }
            app.BeginIdScope(200000);
            structurePanel.Render(app, dock.ContentParked("structure"), structTree);
            app.EndIdScope();
            structShow = structurePanel.Shown();
            app.PerfMark("sh.structure");

            // Section 3: the stdlib / examples tree, click a leaf to open it.
            app.BeginIdScope(250000);
            stdlibPanel.Render(app, dock.ContentParked("stdlib"), exTree);
            app.EndIdScope();
            exShow = stdlibPanel.Shown();
            app.PerfMark("sh.stdlib");

            // The editor is the dock's fixed center panel, so it always has
            // a rect; every tool panel is parked off-screen while closed.
            Rect ea = dock.Content("editor");
            Rect orr = dock.ContentParked("output");

            // Every open file gets a disk baseline (unsaved-edit and
            // changed-outside detection both read it), and the files are
            // polled for outside changes a few times a second.
            this.TrackOpenTabs();
            this.PollDiskChanges();

            this.SyncEditorTabs();
            editorTabs.Select(activeTab.Get());
            editorTabs.TakeChanged();
            int tabH = editorTabs.HeaderHeight(app);
            app.BeginIdScope(300000);
            editorTabs.Render(app, ea.x, ea.y, ea.width);
            app.EndIdScope();
            app.PerfMark("sh.tabs");
            int ctxTab = editorTabs.TakeContext();
            int addTab = editorTabs.TakeAdded();
            int shutTab = editorTabs.TakeClosed();
            int chgTab = editorTabs.TakeChanged();
            if (ctxTab >= 0) {
                ctxKind = 3; ctxX = app.mouseX; ctxY = app.mouseY;
                ctxTarget = ctxTab; app.RequestRedraw();
            } else if (ctxKind == 0) {
                if (addTab >= 0 && dlg == null) {
                    dlg = this.OpenWizardHost(app, ZanIDE.T("New File", "新建文件"), 720, 470, 2);
                    dlgMode = 2;
                } else if (shutTab >= 0) {
                    // Asks about unsaved edits first; a clean tab just goes.
                    this.RequestCloseTab(shutTab);
                } else if (chgTab >= 0) {
                    activeTab.Set(chgTab);
                }
            }

            int act = activeTab.Get();
            if (act != lastActive) {
                // Only sync editor text for code tabs; .zform tabs are owned by
                // the designer and must not be overwritten with editor contents.
                if (lastActive >= 0 && lastActive < tabs.Count
                    && !ZanIDE.IsFormPath(tabs[lastActive].path)
                    && !ZanIDE.IsScenePath(tabs[lastActive].path)) {
                    tabs[lastActive].body = editor.GetText();
                    // Leaving a tab remembers where it was being read.
                    tabs[lastActive].caretLine = editor.CurLine();
                    tabs[lastActive].caretCol = editor.CurCol();
                    tabs[lastActive].scrollLine = editor.ScrollLine();
                }
                if (act >= 0 && act < tabs.Count
                    && !ZanIDE.IsFormPath(tabs[act].path)
                    && !ZanIDE.IsScenePath(tabs[act].path)) {
                    // Highlighting, completion and Ctrl+/ follow the file's
                    // language: an embedded .lua/.py script is not Zan.
                    editor.SetSyntaxLang(
                        CodeEditor.LangForName(tabs[act].path));
                    editor.LoadText(tabs[act].body);
                    // Feed the project's other sources to the editor so it
                    // can resolve cross-file types (a `Utils` class in
                    // another file) and count the uses of a member that
                    // live outside the file being edited.
                    // 交给编辑器的是分帧读入的项目源码：切换标签的这一帧
                    // 只登记一次请求，实际读盘在下面的轮询段按预算推进
                    // （整个工程一次读完实测 266 ms，全落在第一帧上）。
                    projSrcFeed = true;
                    // Back to where this tab was left, not to line 1. A
                    // pending navigation target is applied just below and
                    // still wins.
                    editor.GoToLineCol(tabs[act].caretLine, tabs[act].caretCol);
                    editor.SetScrollLine(tabs[act].scrollLine);
                }
                lastActive = act;
            }

            if (pendingGotoLine >= 0) {
                editor.GoToLineCol(pendingGotoLine, pendingGotoCol);
                pendingGotoLine = 0 - 1;
                app.RequestRedraw();
            }

            Rect edRect = new Rect(ea.x, ea.y + tabH, ea.width, ea.height - tabH);
            bool activeIsStart = (act >= 0 && act < tabs.Count && tabs[act].path == "@start");
            bool activeIsDocs = (act >= 0 && act < tabs.Count && tabs[act].path == "@docs");

            // 编辑区（设计器 / 代码 / 起始页 / 文档）自成一段 id：设计器里
            // 选中组件会让属性面板长出一批控件，若和标签条共用一条递增
            // 序号，这一帧的点击就会落到标签条上，表现为“点一下就跳到
            // 后面打开的代码页”。
            app.BeginIdScope(350000);
            if (designerMode) {
                // The .zform tab hosts the full component-based form designer
                // (stdlib Gui.Designer): palette, containers, inspector, event
                // bindings, JSON drawer. The .zform file stores its design
                // document; legacy coordinate-based .zform files are converted
                // on first open.
                string fpath = tabs[act].path;
                string fname = ZanIDE.FormBaseName(fpath);
                if (fpath != loadedFormPath) {
                    string fbody = tabs[act].body;
                    if (ZanIDE.LooksLikeJson(fbody)) {
                        formDesigner.LoadJson(fbody);
                    } else {
                        formDesigner.LoadJson(ZanIDE.LegacyFormToJson(fname, fbody));
                    }
                    loadedFormPath = fpath;
                    formCache = formDesigner.SaveJson();
                    ZanIDE.LoadUserComponents(root, formDesigner);
                    // Offer the code-behind's variables in the designer's
                    // bind-path picker (two-way binding targets).
                    string cbpB = ZanIDE.CodeBehindPath(fpath);
                    if (File.Exists(cbpB)) {
                        formDesigner.SetBindVars(ZanIDE.ScanBindVars(File.ReadAllText(cbpB)));
                    } else {
                        formDesigner.SetBindVars(new List<string>());
                    }
                }
                // 先画宿主 dock 里的组件/属性面板：设计器据此知道
                // 左右两栏归宿主管，本体这一帧只排功能区 + 画布。
                // 工具箱 / 属性栏和画布再各占一段：选中组件会改变属性栏
                // 的控件数，不能连带把画布上每个组件的 id 推着走。
                app.BeginIdScope(360000);
                formDesigner.RenderHostPanels(app, dock.ContentParked("toolbox"),
                    dock.ContentParked("props"));
                app.EndIdScope();
                app.BeginIdScope(400000);
                formDesigner.Render(app, edRect.x, edRect.y, edRect.width, edRect.height);
                app.EndIdScope();
                // Persist design changes to the .zform file - the single
                // source of truth (zanc projects typed fields + Main from
                // it at compile time). The business file (Name.zan) is
                // never touched here - it is only created when missing.
                string newser = formDesigner.SaveJson();
                if (newser != formCache) {
                    tabs[act].body = newser;
                    if (fpath.Length > 0 && fpath.Substring(0, 1) != "@") {
                        File.WriteAllText(fpath, newser);
                        string cbpS = ZanIDE.CodeBehindPath(fpath);
                        if (!File.Exists(cbpS)) {
                            File.WriteAllText(cbpS, ZanIDE.GenBusinessShell(fname));
                        }
                        // Push the new design to zan-lsp so the code-behind's
                        // completion sees added/renamed/deleted controls at once.
                        if (lspSess != null && lspSess.Alive()) {
                            lspSess.SyncDoc(fpath, newser);
                        }
                    }
                    formCache = newser;
                }
                // "Save as component": persist the whole design as a reusable
                // project component (components/<name>.zcomp) and refresh the
                // designer's "My Components" palette group.
                if (formDesigner.ConsumeSaveComponent()) {
                    string compName = ZanIDE.SanitizeName(formDesigner.formNameSig.Get());
                    if (compName == "") { compName = fname; }
                    string compDir = root + "/components";
                    Directory.CreateDirectoryRecursive(compDir);
                    string compPath = compDir + "/" + compName + ".zcomp";
                    File.WriteAllText(compPath, formDesigner.SaveJson());
                    ZanIDE.LoadUserComponents(root, formDesigner);
                    log.Add("> Saved component -> " + compPath + ".");
                    app.RequestRedraw();
                }
            } else if (sceneMode) {
                // The .zscene tab hosts the free-canvas game scene designer
                // (stdlib Game.Scene.SceneDesigner). The .zscene file stores
                // the scene JSON document.
                string spath = tabs[act].path;
                if (spath != loadedScenePath) {
                    string sbody = tabs[act].body;
                    if (ZanIDE.LooksLikeJson(sbody)) {
                        sceneDesigner.LoadJson(sbody);
                    } else {
                        sceneDesigner.LoadJson(new SceneDoc(
                            ZanIDE.SceneBaseName(spath), 1280, 720).ToJson());
                    }
                    loadedScenePath = spath;
                    sceneCache = sceneDesigner.SaveJson();
                }
                SceneDesigner.assetsDir = ZanIDE.AssetsDir(root);
                // 先画宿主 dock 里的组件/属性面板：设计器据此知道
                // 左右两栏归宿主管，本体这一帧只排功能区 + 画布。
                app.BeginIdScope(360000);
                sceneDesigner.RenderHostPanels(app, dock.ContentParked("toolbox"),
                    dock.ContentParked("props"));
                app.EndIdScope();
                app.BeginIdScope(400000);
                sceneDesigner.Render(app, edRect.x, edRect.y, edRect.width, edRect.height);
                app.EndIdScope();
                // Persist design changes to the .zscene file.
                string snewser = sceneDesigner.SaveJson();
                if (snewser != sceneCache) {
                    tabs[act].body = snewser;
                    if (spath.Length > 0 && spath.Substring(0, 1) != "@") {
                        File.WriteAllText(spath, snewser);
                        // The .zscene is the only file the design lives in
                        // (zanc projects the typed elements at compile
                        // time); create the business Name.zan only when
                        // missing - the designer never overwrites it.
                        string sname = ZanIDE.SceneBaseName(spath);
                        string scbP = ZanIDE.SceneCodeBehindPath(spath);
                        if (!File.Exists(scbP)) {
                            File.WriteAllText(scbP, ZanIDE.GenSceneBusinessShell(sname));
                        }
                        // Push the design to zan-lsp, which projects the
                        // typed elements from the JSON itself, so element
                        // completion tracks the designer.
                        if (lspSess != null && lspSess.Alive()) {
                            lspSess.SyncDoc(spath, snewser);
                        }
                    }
                    sceneCache = snewser;
                }
            } else if (activeIsDocs) {
                DocsPage.RenderDocsPage(app, edRect, log);
            } else if (activeIsStart) {
                startPage.SetRecents(ZanIDE.RecentProjectItems());
                startPage.SetNews(ZanIDE.StartNews(root));
                startPage.RenderInside(app, edRect);
                int sact = startPage.TakeAction();
                string dropped = startPage.TakeRemovedPath();
                if (dropped != "") {
                    ZanIDE.RemoveRecentProject(dropped);
                    startPage.SetRecents(ZanIDE.RecentProjectItems());
                    app.RequestRedraw();
                }
                if (sact == 1 && dlg == null) {
                    tpls = ZanIDE.BuildCatalog(root);
                    wizTpls = ZanIDE.WizTemplates(tpls);
                    catNames = ZanIDE.CatsOf(tpls);
                    catSel.Set(0);
                    pSel.Set(0);
                    pSizeSeededFor = 0 - 1;
                    pNameInput.SetText("NewProject");
                    pLocInput.SetText(ZanIDE.ReadLastPickerDirectory(ZanIDE.ProjectsHome()));
                    Wizard.notice = "";
                    dlg = this.OpenWizardHost(app, ZanIDE.T("New Project", "新建项目"), 1180, 680, 1);
                    dlgMode = 1;
                    app.RequestRedraw();
                } else if (sact == 2 && dlg == null) {
                    dlg = this.OpenWizardHost(app, ZanIDE.T("New File", "新建文件"), 720, 470, 2);
                    dlgMode = 2;
                    app.RequestRedraw();
                } else if (sact == 3) {
                    pathPicker.BeginOpenFileFilters(
                        ZanIDE.ReadLastPickerDirectory(root),
                        ZanIDE.OpenFileFilters(),
                        ZanIDE.T("Open source file", "打开源文件"));
                    pathPickerOwner = 4;
                    app.RequestRedraw();
                } else if (sact == 4) {
                    pathPicker.BeginFolder(
                        ZanIDE.ReadLastPickerDirectory(root),
                        ZanIDE.T("Open a project folder", "打开项目文件夹"));
                    pathPickerOwner = 10;
                    app.RequestRedraw();
                } else if (sact >= 200) {
                    string nurl = startPage.NewsLink(sact - 200);
                    if (nurl != "") {
                        if (nurl == "@docs") {
                            int di = ZanIDE.FindTabByPath(tabs, "@docs");
                            if (di < 0) {
                                tabs.Add(TabRecord.Create(ZanIDE.T("Help", "帮助"), "", "@docs"));
                                di = tabs.Count - 1;
                            }
                            activeTab.Set(di);
                            lastActive = 0 - 1;
                        } else {
                            ZanIDE.OpenExternal(nurl);
                        }
                        app.RequestRedraw();
                    }
                } else if (sact >= 100) {
                    string newRoot = startPage.RecentPath(sact - 100);
                    if (newRoot != "") {
                        if (newRoot != root && Directory.Exists(newRoot)) {
                            root = newRoot;
                            haveProject = true;
                            ZanIDE.WriteLastProject(root);
                            this.AdoptSymbolIndex();
                            this.AdoptProjectChats();
                            tabs = new List<TabRecord>();
                            activeTab.Set(0);
                            lastActive = 0 - 1;
                            ZanIDE.OpenFirst(tabs, activeTab, root);
                            rescan = true;
                            log.Add("> Opened project " + root + ".");
                        }
                        app.RequestRedraw();
                    }
                }
            } else if (act >= 0 && act < tabs.Count
                    && ZanIDE.IsScenePath(tabs[act].path) && codeViewForm == tabs[act].path) {
                // Code view of the current .zscene: show the strongly-typed
                // scene code the compiler projects from the design - the
                // read-only "Designer" half, kept in memory only. The scene
                // is edited visually; game logic lives in Name.zan.
                string spC = tabs[act].path;
                if (formCodeLoaded != spC) {
                    string sTxt = "";
                    if (File.Exists(spC)) {
                        sTxt = ZanIDE.GenSceneFile(ZanIDE.SceneBaseName(spC),
                            SceneDoc.Parse(File.ReadAllText(spC)));
                    }
                    formCodeEd.LoadText(sTxt);
                    formCodeLoaded = spC;
                }
                ZanIDE.ApplyEditorTheme(formCodeEd, edThemeIdx, edFontPx);
                formCodeEd.Render(app, edRect);
            } else if (act >= 0 && act < tabs.Count
                    && ZanIDE.IsFormPath(tabs[act].path) && codeViewForm == tabs[act].path) {
                // Code view of the current .zform: show the design
                // document's raw JSON in place (read-only) - the window is
                // edited visually in the designer, and business logic lives
                // in the paired Name.zan (2-file model, no generated file).
                string fpC = tabs[act].path;
                if (formCodeLoaded != fpC) {
                    string codeTxt = "";
                    if (File.Exists(fpC)) {
                        codeTxt = File.ReadAllText(fpC);
                    }
                    formCodeEd.LoadText(codeTxt);
                    formCodeLoaded = fpC;
                }
                ZanIDE.ApplyEditorTheme(formCodeEd, edThemeIdx, edFontPx);
                formCodeEd.Render(app, edRect);
            } else {
                // Sync debug vars into editor for hover tooltips
                if (dbgState == 2) { editor.SetDebugVars(dbgVarInfo); }
                else { editor.SetDebugVars(new List<DbgVar>()); }
                ZanIDE.ApplyEditorTheme(editor, edThemeIdx, edFontPx);
                editor.Render(app, edRect);
                // Publish live editor state to the AI automation driver
                // (ZAN_UI_SCRIPT) so scripts can assert buffer/caret and the
                // completion popup without screen-scraping. Inert otherwise.
                if (UiDriver.Active()) {
                    UiDriver.SetProbe("editor", ZanIDE.EditorProbeJson(editor));
                    UiDriver.SetProbe("log", string.Join("\n", log));
                }
                // Ctrl+click in the editor requests Go to Definition.
                if (editor.ConsumeGotoRequest()) {
                    if (lspSess == null && !lspTried) {
                        lspTried = true;
                        lspSess = LspSession.Start(root);
                        if (lspSess != null) { log.Add("> zan-lsp connected: semantic navigation enabled."); }
                    }
                    string navW_glc = editor.WordAtCaret();
                    this.RememberTabView();
                    int glc = ZanIDE.GoToDefinitionSmart(lspSess, editor, tabs, activeTab, root, log);
                    this.ApplyGotoResult(glc, navW_glc);
                    app.RequestRedraw();
                }
                // Draw inline debug annotations
                if (dbgState == 2 && dbgExecLine >= 0) {
                    dbgInline.Render(app, edRect, dbgVarInfo);
                }
            }
            app.EndIdScope();

            // ---- reference list ("N references" / Shift+F12) ----
            if (refList.IsOpen() && !designerMode && !sceneMode
                    && !activeIsStart && !activeIsDocs) {
                // Hangs on the line the list was opened from, following it
                // as the view scrolls. Not the caret: a click in the code
                // moves that, and the panel would chase the pointer.
                refList.Anchor(edRect.x + app.Scale(56),
                    editor.LineBottomY(app, refAnchorLine));
                // A row activated in the overlay phase is read on the next
                // frame: the popup draws after the page, so the jump happens
                // once, from here, and not in the middle of painting it.
                int refPick = refList.TakePicked();
                if (refPick >= 0) { this.GotoReference(refPick); }
                refList.Frame(app);
            } else if (refList.IsOpen()) {
                // The list belongs to the code view; a designer or start tab
                // is not where its rows point.
                refList.Close();
            }

            // ---- Find / Replace bar (Ctrl+F, Ctrl+R) ----
            if ((findMode == 1 || findMode == 2) && !designerMode && !sceneMode
                    && !activeIsStart && !activeIsDocs) {
                findBar.Render(app, edRect, editor);
                if (findBar.CloseRequested()) {
                    findBar.ClearCloseRequest();
                    findMode = 0;
                    app.focus.SetFocused(editor.LastWidgetId());
                    app.RequestRedraw();
                }
            }

            // ---- 跳转到行 / 断点条件 / 重命名 / 在文件中查找替换 ----
            // 一个声明式的小输入条（views/QuickPrompt.zform），编辑、
            // 选择、剪贴板和输入法都归标准输入框。
            this.RunQuickPrompt(app, edRect, designerMode || sceneMode
                || activeIsStart || activeIsDocs);
            app.PerfMark("sh.editor");

            // ---- Errors panel: the diagnostics of the last build. Its own
            // dock panel, so it stays readable next to (or instead of) the
            // console, and its tab carries the error count.
            // 「帮助与反馈」：本地聚合的错误 + 复制/导出。它和错误面板并列
            // 在底部，但收的是全部来源（含界面层异常与程序崩溃），不只是
            // 这一次编译的诊断。
            Rect errRect = dock.ContentParked("errors");
            List<DiagnosticRecord> errors = this.BuildErrors();
            string errTitle = ZanIDE.T("Errors", "错误");
            if (errors.Count > 0) {
                errTitle = errTitle + " (" + Convert.ToString(errors.Count) + ")";
            }
            if (errTitle != dockErrorsTitle) {
                dock.SetTitle("errors", errTitle);
                dockErrorsTitle = errTitle;
            }
            app.BeginIdScope(700000);
            errorsPanel.Render(app, errRect, errors);
            app.EndIdScope();
            // Error rows are widgets: the ErrorList component records clicks
            // during RenderAt; apply them here.
            if (!coCtxOpen) {
                DiagnosticRecord efr = errorsPanel.TakeFix();
                if (efr != null) {
                    ZanIDE.AddUsing(editor, tabs, activeTab,
                        errorsPanel.FixNs(efr), log);
                    app.RequestRedraw();
                }
                DiagnosticRecord ejr = errorsPanel.TakeJump();
                if (ejr != null) {
                    int ejt = ZanIDE.FindTabByBase(
                        tabs, ZanIDE.BaseName(ejr.path));
                    int ejl = ZanIDE.ParseInt(ejr.line);
                    if (ejt >= 0) {
                        activeTab.Set(ejt);
                        lastActive = 0 - 1;
                        pendingGotoLine = ejl - 1;
                        pendingGotoCol = 0;
                    }
                    app.RequestRedraw();
                }
            }
            app.PerfMark("sh.errors");

            if (dbgState == 2) {
                app.BeginIdScope(650000);
                dbgPanel.Render(app, orr, dbgPanelTab,
                    dbgConsole, dbgVarInfo, dbgWatchVals, dbgStack);
                app.EndIdScope();
                // The Watch tab's field and grid are widgets: typing,
                // Enter and the row click happen inside them, and the
                // shell only learns what the user asked for.
                string wAdd = DebugPanel.TakeWatchAdd();
                int wDrop = DebugPanel.TakeWatchDrop();
                if (wAdd.Length > 0) {
                    dbgWatches.Add(wAdd);
                    dbgWatchVals = ZanIDE.DbgEvalWatches(dbg, dbgWatches);
                    app.RequestRedraw();
                }
                if (wDrop >= 0 && wDrop < dbgWatches.Count) {
                    dbgWatches.RemoveAt(wDrop);
                    dbgWatchVals = ZanIDE.DbgEvalWatches(dbg, dbgWatches);
                    app.RequestRedraw();
                }
            } else {
                // Which bottom panel the pointer is over -- 0 console,
                // 1 errors -- so copy/clear act on what was right-clicked.
                int botTab = 0;
                if (errRect.Contains(app.mouseX, app.mouseY)) { botTab = 1; }
                // The console is its own designed panel (panels/OutputPanel.zform):
                // it filters the real log into its own view, colours the rows
                // and owns the filter box, Clear button and selection. The
                // real `log` is untouched; copy/selection act on the view.
                int obTabH = t.heightMedium;
                int coContentY = orr.y + obTabH;
                int coContentH = orr.height - obTabH;
                app.BeginIdScope(600000);
                outputPanel.Render(app, orr, log);
                app.EndIdScope();
                List<string> coView = outputPanel.Shown();
                // Right-click opens the shared context menu (copy
                // selection / line / all, clear) instead of silently copying.
                Rect botRect = orr;
                if (botTab == 1) { botRect = errRect; }
                if (app.EventKind() == 2 && app.window.EventButton() == 1
                    && botRect.Contains(app.mouseX, app.mouseY)) {
                    coCtxOpen = true;
                    coCtxX = app.mouseX;
                    coCtxY = app.mouseY;
                    if (botTab == 0) {
                        coCtxRow = LogView.RowAt(app, coContentY, coContentH,
                            coView.Count, coLog.scroll, app.mouseY);
                    } else {
                        coCtxRow = (app.mouseY - (errRect.y + app.Scale(6))) / app.Scale(20);
                    }
                    app.RequestRedraw();
                }
                if (coCtxOpen) {
                    // The menu draws in the middle of the frame, so it gets
                    // its own id segment: allocating its ids from the running
                    // counter would push every panel rendered after it by one
                    // and the pointer target -- resolved against the previous
                    // frame's ids -- would land on a different control (a
                    // right-click in the log firing a ribbon command). It also
                    // owns the pointer while open, so the click that dismisses
                    // it does not reach what is underneath.
                    app.BeginIdScope(620000);
                    app.BlockHitsMenu();
                    bool haveSel = botTab == 0 && coLog.HasSelection();
                    List<string> cmi = new List<string>();
                    if (haveSel) {
                        cmi.Add(ZanIDE.T("Copy selection", "复制选中"));
                    }
                    cmi.Add(ZanIDE.T("Copy line", "复制该行"));
                    cmi.Add(ZanIDE.T("Copy all", "复制全部"));
                    cmi.Add(ZanIDE.T("Clear", "清空"));
                    int cmHit = ContextMenu.Render(app, coCtxX, coCtxY, cmi);
                    if (cmHit == 0 - 2) {
                        coCtxOpen = false;
                        app.RequestRedraw();
                    } else if (cmHit >= 0) {
                        int base2 = 0;
                        if (haveSel) { base2 = 1; }
                        string clip = "";
                        if (haveSel && cmHit == 0) {
                            clip = LogView.SelectionText(coView, coLog);
                        } else if (cmHit == base2) {
                            if (botTab == 0) {
                                if (coCtxRow >= 0 && coCtxRow < coView.Count) {
                                    clip = coView[coCtxRow];
                                }
                            } else if (coCtxRow >= 0 && coCtxRow < errors.Count) {
                                DiagnosticRecord error = errors[coCtxRow];
                                clip = ZanIDE.BaseName(error.path) + ":"
                                    + error.line + "  " + error.msg;
                            }
                        } else if (cmHit == base2 + 1) {
                            if (botTab == 0) {
                                for (int ci = 0; ci < coView.Count; ci = ci + 1) { clip = clip + coView[ci] + "\n"; }
                            } else {
                                for (int ci = 0; ci < errors.Count; ci = ci + 1) {
                                    DiagnosticRecord error = errors[ci];
                                    clip = clip + ZanIDE.BaseName(error.path) + ":" + error.line
                                        + "  " + error.msg + "\n";
                                }
                            }
                        } else {
                            log = new List<string>();
                            coFilter.SetText("");
                            coLog.Reset();
                        }
                        if (clip.Length > 0) {
                            Clipboard.SetText(clip);
                            Layer.Msg(ZanIDE.T("Copied to clipboard", "已复制到剪贴板"), 3);
                        }
                        coCtxOpen = false;
                        app.RequestRedraw();
                    }
                    app.EndIdScope();
                }
                // Ctrl+C copies the console selection when the pointer is
                // over the output panel (the editor keeps its own copy).
                if (app.EventKind() == 4 && app.window.EventKeyCode() == 67
                    && Modifiers.HasCtrl(app.window.EventMods())
                    && coLog.HasSelection()
                    && orr.Contains(app.mouseX, app.mouseY)) {
                    Clipboard.SetText(LogView.SelectionText(coView, coLog));
                    Layer.Msg(ZanIDE.T("Copied to clipboard", "已复制到剪贴板"), 3);
                    app.RequestRedraw();
                }
            }
            app.PerfMark("sh.output");

            // ---- AI 助手面板：界面在 panels/AiPanel.zform 里声明，
            // 行为在 ZanIDE.AiPanel.zan。助手、工具、示例和 git 是四个
            // 各自独立的停靠面板，外壳只把 dock 分给它的矩形交出来
            // （隐藏时停在屏幕外），所以它们可以互相并成页签、换边或关闭
            app.BeginIdScope(750000);
            this.RenderAiPanel(app, dock.ContentParked("ai"));
            app.EndIdScope();
            // ---- Git panel: its own designed panel
            // (panels/GitPanel.zform): branch header, the command rows, the
            // changed-file list and the commit row. Every button is a designed
            // onClick handler, so the shell only hands over the rect.
            app.BeginIdScope(800000);
            gitPanel.Render(app, dock.ContentParked("git"));
            app.EndIdScope();
            // ---- Tools and Examples panels: a tree each, both owning their
            // filter row, scrolling and selection. A double-click RUNS a
            // tool (tools are Zan code) or opens an example's source in the
            // editor; a right-click raises the panel's context menu.
            app.BeginIdScope(850000);
            toolsPanel.Render(app, dock.ContentParked("tools"), rtToolTree);
            app.EndIdScope();
            app.BeginIdScope(900000);
            examplesPanel.Render(app, dock.ContentParked("examples"), rtExTree);
            app.EndIdScope();
            app.PerfMark("sh.sidepanels");
            app.PerfMark("");
            // Stream new shell output from a launched program into the
            // Output tab. Poll on the throttled animation clock so a live
            // session doesn't spin the CPU but output appears promptly.
            if (termFp != 0) {
                int consumed2 = ZanIDE.TermPoll(termLogLen, log);
                if (consumed2 != termLogLen) {
                    termLogLen = consumed2;
                    coLog.Reset();
                    app.RequestRedraw();
                }
                this.PollNextIn(app, 250, orr);
            }
            // Mirror a launched console program's output into the Output tab.
            if (runStreaming) {
                int rconsumed = ZanIDE.RunPoll(runLogLen, log);
                if (rconsumed != runLogLen) {
                    runLogLen = rconsumed;
                    coLog.Reset();
                    app.RequestRedraw();
                }
                // The launched program exited: drain any trailing output and
                // stop streaming so the 4 fps throttle lifts and the log is
                // no longer polled (it also caps the mirror file's growth).
                if (File.Exists(ZanIDE.RunDonePath())) {
                    File.Delete(ZanIDE.RunDonePath());
                    int rfinal = ZanIDE.RunPoll(runLogLen, log);
                    if (rfinal != runLogLen) {
                        runLogLen = rfinal;
                        coLog.Reset();
                        app.RequestRedraw();
                    }
                    runStreaming = false;
                }
                this.PollNextIn(app, 250, orr);
            }
            app.PerfMark("sh.runpoll");
            // Save-triggered hot reload (autoRun ON): rebuild + restart the
            // active target in a DETACHED shell so saving never freezes the
            // IDE. The buildBusy poll below streams output and relaunches on
            // completion, exactly like the Run action.
            if (hotReloadReq) {
                hotReloadReq = false;
                if (!buildBusy) {
                    int atHr = activeTab.Get();
                    string apHr = "";
                    if (atHr >= 0 && atHr < tabs.Count) { apHr = tabs[atHr].path; }
                    string rpHr = ZanIDE.RibbonRunTarget(apHr, root);
                    if (rpHr != "") {
                        buildBusy = true;
                        buildStartMs = Window.GetTickMs();
                        buildThenRun = !ZanIDE.IsLibraryProject(root);
                        buildExe = ZanIDE.RunBuildBegin(root, rpHr);
                        buildIsGui = ZanIDE.IsWindowedTarget(root, rpHr);
                        buildTargetPath = apHr;
                        buildLogLen = 0;
                        dock.Focus("output");
                        log.Add("> [Hot] Rebuilding " + rpHr + " ...");
                        app.RequestAnimationFrame(80);
                    }
                }
            }
            // Poll the in-flight detached git job (status scan or a panel
            // command): apply the result when its marker appears, so a slow
            // repository never freezes the window.
            if (gitJob != 0) {
                if (ZanIDE.GitJobDone()) {
                    List<string> gJob = ZanIDE.GitJobTake();
                    if (gitJob == 1) {
                        gitBranch = ZanIDE.GitRefreshApply(gJob, gitFiles);
                        gitHead = ZanIDE.GitRefreshHead(gJob);
                        gitLoaded = true;
                        gitSel.Set(0 - 1);
                    } else {
                        ZanIDE.AppendAll(log, gJob);
                        coLog.Reset();
                        // a command may have changed the working tree
                        gitLoaded = false;
                    }
                    gitJob = 0;
                    app.RequestRedraw();
                } else {
                    this.PollNextIn(app, 120, dock.ContentParked("git"));
                }
            }
            app.PerfMark("sh.gitpoll");
            // Poll the on-disk symbol index: a background EmitSymbolsDetach
            // (or a build) may have written a newer one; reload it so member
            // completion follows the newest code without a restart.
            if (haveProject) {
                string idxP = ZanIDE.SymbolIndexPath(root);
                if (File.Exists(idxP)) {
                    long stI = FileInfo.GetLastWriteTime(idxP);
                    if (stI > symbolIdxStamp) {
                        if (ZanIDE.LoadSymbolIndexFor(root)) { symbolIdxStamp = stI; }
                    }
                }
            }
            app.PerfMark("sh.symidx");
            // 把项目源码读进编辑器：跨文件类型解析和引用计数要读工程里
            // 每个 .zan，一帧读完就是几百毫秒的卡顿（本工程 266 ms，更大的
            // 工程更久）。所以按字节预算分帧读，进度留在帧之间，读完了才
            // 一次交给编辑器 —— 与 CodeEditor.StepExternRefs 同一套办法。
            if (projSrcFeed && haveProject) {
                if (ZanIDE.ProjectSourcesStep(root, 256)) {
                    editor.SetProjectFiles(
                        ZanIDE.ProjectSources(tabs, root, lastActive));
                    projSrcFeed = false;
                }
                app.RequestRedraw();
            }
            app.PerfMark("sh.projsrc");
            // Poll the in-flight detached build (Run/Build ribbon): stream
            // compiler output and, when the done-marker appears, apply
            // diagnostics and (for Run) launch the program -- no UI freeze.
            if (buildBusy) {
                int bConsumed = ZanIDE.BuildPoll(buildLogLen, log);
                if (bConsumed != buildLogLen) {
                    buildLogLen = bConsumed;
                    coLog.Reset();
                    app.RequestRedraw();
                }
                if (File.Exists(ZanIDE.BuildDonePath())) {
                    // The compiler's own exit status decides success. Asking
                    // "does the exe exist?" called a failed build successful
                    // whenever an older executable was still there (a failed
                    // link leaves the previous image untouched), and the IDE
                    // then launched that stale program instead of showing the
                    // error.
                    bool buildOk = ZanIDE.DoneOk(ZanIDE.BuildDonePath())
                        && File.Exists(buildExe);
                    File.Delete(ZanIDE.BuildDonePath());
                    buildLogLen = ZanIDE.BuildPoll(buildLogLen, log);
                    buildBusy = false;
                    List<string> bout = CodeEditor.SplitLines(File.ReadAllText(ZanIDE.BuildLogPath()));
                    ZanIDE.ApplyDiagnostics(editor, buildTargetPath, bout, log);
                    if (dbgBuildPending) {
                        dbgBuildPending = false;
                        if (!buildOk) {
                            log.Add("> [Debug] Build failed.");
                        } else {
                            log.Add("> [Debug] Build succeeded.");
                            dbg = ZanIDE.DbgBegin(root, buildTargetPath,
                                ZanIDE.MergeBreakpoints(editor.Breakpoints(), bpConds),
                                ZanIDE.FirstDebugLine(editor), log);
                            dbgState = ZanIDE.DbgSync(dbg, editor, log, dbgConsole);
                            dbgExecLine = ZanIDE.DbgLine(dbg);
                            dbgVarInfo = ZanIDE.DbgVars(dbg);
                            dbgStack = ZanIDE.DbgStack(dbg);
                            dbgWatchVals = ZanIDE.DbgEvalWatches(dbg, dbgWatches);
                            dbgPanelTab.Set(1);
                            if (dbgState == 2) {
                                log.Add(">   F5=Continue  F10=StepOver  F11=StepInto  Ctrl+B=Condition  Esc=Stop");
                                ZanIDE.LogVarsToConsole(log, dbgVarInfo, dbgExecLine);
                            } else {
                                dbg = null;
                            }
                        }
                    } else if (!buildOk) {
                        // 构建失败只报错：把「错误」面板顶到前面，
                        // 绝不擅自弹别的窗口（缺库只给一行提示）。
                        string missingPackage = ZanIDE.MissingPackage(bout);
                        if (missingPackage != "") {
                            log.Add(ZanIDE.T("> Missing package: ",
                                "> 缺少库：") + missingPackage
                                + ZanIDE.T(" (install it from Extensions)",
                                    "（可到「扩展」里安装）"));
                        }
                        log.Add(ZanIDE.T("> Build failed; not run.", "> 构建失败，未运行。"));
                        dock.Focus("errors");
                    } else if (buildThenRun) {
                        // The program starts in the project root, not in the
                        // IDE's own directory, so its relative paths (an
                        // example's assets/, config/app.json) resolve.
                        string runCwd = ZanIDE.RunCwd(root, buildTargetPath, buildExe);
                        if (buildIsGui) {
                            #if WINDOWS
                            Process.RunDetached("cmd /c start \"\" /D \""
                                + ZanIDE.ToWinPath(runCwd) + "\" \"" + buildExe + "\"");
                            #else
                            Process.RunDetached("sh -c 'cd \"" + runCwd + "\" && \""
                                + buildExe + "\" >/dev/null 2>&1' &");
                            #endif
                            log.Add(ZanIDE.T("> GUI app started.", "> GUI 应用已启动。"));
                        } else {
                            // Console programs run in their own console window
                            // (real stdin, so Console.ReadLine works) with
                            // output teed into the Output tab.
                            log.Add("> " + buildExe);
                            ZanIDE.RunConsole(buildExe, runCwd);
                            runLogLen = 0;
                            runStreaming = true;
                        }
                    } else {
                        log.Add(ZanIDE.T("> Build succeeded.", "> 构建成功。"));
                    }
                    // A build means the code changed: re-index so
                    // completion follows it, and pick up the index
                    // the previous build produced.
                    if (ZanIDE.LoadSymbolIndexFor(root)) {
                        string idxPB = ZanIDE.SymbolIndexPath(root);
                        if (File.Exists(idxPB)) {
                            symbolIdxStamp = FileInfo.GetLastWriteTime(idxPB);
                        }
                    }
                    this.RefreshSymbolIndex(true);
                    // An AI-initiated build/run: hand the compiler result
                    // back to the assistant loop so it reads the real
                    // errors and can fix them, then continue.
                    if (aiBuildForAi) {
                        aiBuildForAi = false;
                        bool aiOk = buildOk;
                        // 编译/运行的真实结果回填到当前那一拍：失败按故障
                        // 分类决定重试、进根因回环还是交给用户，不靠循环
                        // 自己猜。
                        string aiPhTool = "build";
                        if (aiUiPending) { aiPhTool = aiUiTool; }
                        else if (buildThenRun) { aiPhTool = "run"; }
                        this.AiRunBuildDone(aiOk, aiPhTool, bout);
                        if (aiUiPending) {
                            // ui_check: on a good build, launch the target
                            // under the UiDriver script and let the ui poll
                            // gather the log + hit regions; a failed build
                            // goes straight back so the model can fix it.
                            aiUiPending = false;
                            if (aiOk) {
                                string uid = root + "/_scratch/uidrv";
                                string uiCwd = ZanIDE.RunCwd(root,
                                    buildTargetPath, buildExe);
                                ZanIDE.LaunchUnderUiDriver(buildExe, uiCwd,
                                    uid + "/ai_script.txt", uid,
                                    uid + "/ai_done.txt");
                                aiUiRunning = true;
                                aiUiDeadline = Window.GetTickMs() + 30000;
                                log.Add(ZanIDE.T("> [AI] Driving UI...",
                                    "> [AI] 正在驱动 UI 自检..."));
                                app.RequestAnimationFrame(120);
                            } else {
                                aiMsgs.Add(this.AiToolMsg("tool",
                                    aiUiTool + "\n"
                                    + AiAgent.BuildResult(bout, false, false)));
                                string ube = ZanIDE.AiLaunchAs(aiRunAgent, aiMsgs,
                                    aiRunCtxName, aiRunCtxCode, root,
                                    aiProfiles[aiProfActive].baseUrl,
                                    aiProfiles[aiProfActive].key, aiRunModel);
                                if (ube != "") {
                                    aiMsgs.Add(this.AiToolMsg("error", ube));
                                    aiBusy.Set(0);
                                }
                                this.AiChatToEnd();
                            }
                        } else {
                            string tb = "build\n";
                            if (buildThenRun) { tb = "run\n"; }
                            aiMsgs.Add(this.AiToolMsg("tool",
                                tb + AiAgent.BuildResult(bout, aiOk, buildThenRun)));
                            string aiBe = ZanIDE.AiLaunchAs(aiRunAgent, aiMsgs,
                                aiRunCtxName, aiRunCtxCode, root,
                                aiProfiles[aiProfActive].baseUrl,
                                aiProfiles[aiProfActive].key, aiRunModel);
                            if (aiBe != "") {
                                aiMsgs.Add(this.AiToolMsg("error", aiBe));
                                aiBusy.Set(0);
                            }
                            this.AiChatToEnd();
                        }
                    }
                    coLog.Reset();
                    app.RequestRedraw();
                }
                // A compiler that never reports back (a shell that failed to
                // start it, a killed process) must not leave the IDE stuck in
                // "building": Run/Build stay disabled while buildBusy is set,
                // which is indistinguishable from a frozen IDE.
                if (buildBusy && buildStartMs != 0
                    && Window.GetTickMs() - buildStartMs > 600000) {
                    buildBusy = false;
                    dbgBuildPending = false;
                    aiBuildForAi = false;
                    log.Add(ZanIDE.T("> Build timed out; no compiler result.",
                                     "> 构建超时，未拿到编译结果。"));
                    dock.Focus("errors");
                    coLog.Reset();
                    app.RequestRedraw();
                }
                this.PollNextIn(app, 80, orr);
            }
            app.PerfMark("sh.buildpoll");
            // ui_check in flight: the target is being driven by the
            // UiDriver script. Wait (without blocking) for its done-marker
            // or the deadline, then feed the driver log + hit-region dump
            // back so the model can verify the UI against real geometry.
            if (aiUiRunning) {
                string uidP = root + "/_scratch/uidrv";
                bool uiDone = File.Exists(uidP + "/ai_done.txt");
                bool uiTo = Window.GetTickMs() > aiUiDeadline;
                if (uiDone || uiTo) {
                    aiUiRunning = false;
                    if (uiDone) { File.Delete(uidP + "/ai_done.txt"); }
                    string rlog = "";
                    if (File.Exists(uidP + "/results.log")) {
                        rlog = File.ReadAllText(uidP + "/results.log");
                    }
                    string rjson = "";
                    if (File.Exists(uidP + "/regions.json")) {
                        rjson = File.ReadAllText(uidP + "/regions.json");
                    }
                    string tjson = "";
                    if (File.Exists(uidP + "/theme.json")) {
                        tjson = File.ReadAllText(uidP + "/theme.json");
                    }
                    aiMsgs.Add(this.AiToolMsg("tool",
                        aiUiTool + "\n"
                        + AiAgent.UiResultOf(aiUiTool, rlog, rjson, tjson,
                            uiTo && !uiDone)));
                    string uce = ZanIDE.AiLaunchAs(aiRunAgent, aiMsgs,
                        aiRunCtxName, aiRunCtxCode, root,
                        aiProfiles[aiProfActive].baseUrl,
                        aiProfiles[aiProfActive].key, aiRunModel);
                    if (uce != "") {
                        aiMsgs.Add(this.AiToolMsg("error", uce));
                        aiBusy.Set(0);
                    }
                    this.AiChatToEnd();
                    app.RequestRedraw();
                } else {
                    this.PollNextIn(app, 150, dock.ContentParked("ai"));
                }
            }
            app.PerfMark("sh.uipoll");
            // Poll the in-flight detached publish: compiler output streams
            // into the Output tab and a done-marker file signals completion,
            // so even a slow cross-compile never blocks the UI.
            if (pubBusy) {
                int pubConsumed = ZanIDE.PubPoll(pubLogLen, log);
                if (pubConsumed != pubLogLen) {
                    pubLogLen = pubConsumed;
                    coLog.Reset();
                    app.RequestRedraw();
                }
                if (File.Exists(ZanIDE.PubDonePath())) {
                    bool pubStatusOk = ZanIDE.DoneOk(ZanIDE.PubDonePath());
                    File.Delete(ZanIDE.PubDonePath());
                    pubLogLen = ZanIDE.PubPoll(pubLogLen, log);
                    if (!pubStatusOk) {
                        log.Add(ZanIDE.T("> A publish step reported an error (see the log above).",
                                         "> 有发布步骤报错（见上方日志）。"));
                    }
                    int pubOk = 0;
                    for (int pe = 0; pe < pubExes.Count; pe = pe + 1) {
                        if (File.Exists(pubExes[pe])) {
                            log.Add("> Published " + pubExes[pe]);
                            pubOk = pubOk + 1;
                        } else {
                            log.Add(ZanIDE.T("> Publish failed for ", "> 发布失败：") + pubExes[pe]);
                        }
                    }
                    // Each target has its own output directory, so the
                    // resources go beside each executable that does not
                    // already carry them: a single-file Windows exe has them
                    // embedded, everything else needs the loose copy.
                    bool packed = ZanIDE.ProjSingleFile(root);
                    for (int pe3 = 0; pe3 < pubExes.Count; pe3 = pe3 + 1) {
                        if (File.Exists(pubExes[pe3])
                            && !(packed && ZanIDE.EndsWith(pubExes[pe3], ".exe"))) {
                            ZanIDE.CopyResources(root,
                                ZanIDE.PayloadDirFor(pubExes[pe3]), log);
                        }
                    }
                    // macOS / Linux publishes leave Windows as a tar archive:
                    // it is the only common format that carries the unix mode,
                    // so the unpacked binary (and the .app's Contents/MacOS)
                    // is executable instead of "permission denied".
                    List<string> tarred = new List<string>();
                    for (int pe4 = 0; pe4 < pubExes.Count; pe4 = pe4 + 1) {
                        // A library target produces two files in one directory;
                        // archive that directory once.
                        if (File.Exists(pubExes[pe4])) {
                            string tp = ZanIDE.TarPublishFor(pubExes[pe4],
                                                             tarred, log);
                            if (tp != "") { tarred.Add(tp); }
                        }
                    }
                    pubBusy = false;
                    pubExes = new List<string>();
                    coLog.Reset();
                    app.RequestRedraw();
                }
                if (pubBusy && pubStartMs != 0
                    && Window.GetTickMs() - pubStartMs > 1800000) {
                    pubBusy = false;
                    pubExes = new List<string>();
                    log.Add(ZanIDE.T("> Publish timed out; no result reported.",
                                     "> 发布超时，未拿到结果。"));
                    coLog.Reset();
                    app.RequestRedraw();
                }
                this.PollNextIn(app, 250, orr);
            }
            app.PerfMark("sh.pubpoll");
            // Poll the in-flight AI request. The Net worker thread streams
            // the decoded response body into an in-memory sink as it
            // arrives and publishes "ok"/"err: ..." when it ends. Each
            // frame the panel reads the sink to show the answer building up
            // live, and a wall-clock backstop times the wait out so the
            // panel never hangs on 'thinking' if the worker dies silently.
            if (aiBusy.Get() == 1) {
                // 文件工具在自己的线程上跑（读大文件、全仓 grep、写文件）：
                // 跑完了就在这里收结果并接着发下一拍，跑着的时候这段安静不是
                // 「模型没回话」，所以也算 aiToolRunning，不能走请求超时。
                AiJob aiJob = AiWork.Ready();
                if (aiJob != null) { this.AiWorkFinish(aiJob); }
                bool aiToolRunning = buildBusy || aiUiRunning || runStreaming
                    || AiWork.Busy();
                // 这一拍之后隔多久再取一次流。这个数字直接乘在 CPU 上，所以
                // 有新文本在流的时候才跟到 100ms（看得出字在一个个蹦），其余
                // 时候 250ms 一拍转圈照样转。这一拍本身只声明助手面板那块像素
                // （PollNextIn），模型在想的那几十秒里唤醒的是局部帧，而不是
                // 每秒 4~10 次整窗重绘 + 重新模糊背景。
                int aiPollMs = 250;
                if (aiToolRunning) {
                    aiWaitStart = 0;
                }
                string aiDoneTxt = AiNet.Done();
                bool aiMarker = aiDoneTxt != "";
                bool aiTimedOut = false;
                if (!aiToolRunning && !aiMarker) {
                    // Live read: the byte count comes from the sink without
                    // copying the body, so a model that is still thinking
                    // costs nothing per frame. When it did grow, only the
                    // bytes that are new are copied out of the sink and
                    // folded (AiNet.Since + SseLive.FeedTail): copying and
                    // re-parsing the whole stream every 100ms is what
                    // burned a core on a long answer.
                    int sgrown = AiNet.Length();
                    if (sgrown < aiStreamLen) {
                        // 流变短了 = 重试把这一轮从头开始：连那条写了一半的
                        // 预览一起丢掉，否则记录里会剩下半句话。
                        this.AiStreamDrop(true);
                    }
                    int aiTick = Window.GetTickMs();
                    // 预览只是给人看的（最终那一轮从整段原文重新解析），所以
                    // 一旦工具调用的摘要定型，就别再为一个越写越长的文件正文
                    // 每一拍复制全文、重排整段聊天——写一个几十 KB 的文件时，
                    // 这条链（复制 SSE 全文 → 折叠 → 折行 → 重绘）就是 GUI
                    // 线程「未响应」的那份活。节流到 120ms 一拍同理。
                    bool aiRefresh = sgrown != aiStreamShown
                        && !aiStreamSettled
                        && aiTick - aiStreamAt >= 120;
                    if (sgrown != aiStreamShown && !aiStreamSettled) {
                        aiPollMs = 100;
                    }
                    if (sgrown != aiStreamLen) {
                        aiStreamLen = sgrown;
                        aiWaitStart = 0;
                    } else if (!aiRefresh) {
                        int aiNow = aiTick;
                        if (aiWaitStart == 0) { aiWaitStart = aiNow; }
                        // Mirrors the transport's idle window (600s): a
                        // model that is still thinking emits nothing for
                        // minutes, so only give up after the same silence
                        // the Net layer would time out on. Any byte of
                        // stream content (or a retry that truncates the
                        // file) re-arms the wait above.
                        else if (aiNow - aiWaitStart > 600000) {
                            aiTimedOut = true;
                        }
                    }
                    if (aiRefresh) {
                        aiStreamShown = sgrown;
                        aiStreamAt = aiTick;
                        if (aiLive == null) { aiLive = new SseLive(); }
                        aiLive.FeedTail(AiNet.Gen(), AiNet.Since());
                        string cont = aiLive.Content();
                        // 工具块折成一行：整个文件的内容流进聊天区没有意义，
                        // 而且会把它真正说的那几句话推出屏幕。
                        string live = AiAgent.LiveText(cont);
                        if (live == "" && aiLive.Reasoning() != "") {
                            live = ZanIDE.T("(thinking) ", "(思考中) ")
                                + aiLive.Reasoning();
                        }
                        if (AiAgent.CallSettled(cont)) {
                            aiStreamSettled = true;
                        }
                        if (live != "") {
                            // 只认「还挂在末尾、而且真是自己那条助手气泡」的
                            // 下标。记录在这一轮中间被换掉过（切节点、切会话、
                            // 停止后又发了一句）时，旧下标要么越界、要么正好
                            // 落在别人的消息上——改写用户刚发的那句话，收尾时
                            // 再把它删掉，就是那一下闪退。
                            bool liveOk = aiStreamMsgIdx >= 0
                                && aiStreamMsgIdx == aiMsgs.Count - 1
                                && aiMsgs[aiStreamMsgIdx].role == "assistant";
                            if (liveOk) {
                                aiMsgs[aiStreamMsgIdx].text = live;
                            } else {
                                // 流式那条气泡也要署名：不署名头行就退回默认的
                                // 「小赞」，于是团队会话里每一拍都先冒出一个
                                // 没人 @ 过的小赞，写完才变回真正在说话的成员。
                                ChatMessage lm = ChatMessage.Create(
                                    "assistant", live);
                                lm.agent = aiRunAgent;
                                aiMsgs.Add(lm);
                                aiStreamMsgIdx = aiMsgs.Count - 1;
                            }
                            this.AiChatToEnd();
                        }
                        aiWaitStart = 0;
                    }
                }
                if (aiTimedOut) {
                    this.AiStreamDrop(true);
                    aiMsgs.Add(ChatMessage.Create("error", ZanIDE.T(
                        "[error] AI request timed out - no response received.",
                        "[错误] AI 请求超时——未收到响应。")));
                    aiBusy.Set(0);
                    this.AiChatToEnd();
                } else if (aiMarker) {
                    string doneTxt = AiAgent.Trim(aiDoneTxt);
                    // Drop the live preview bubble; the final turns are added
                    // below from the fully decoded stream.
                    this.AiStreamDrop(true);
                    string sraw = AiNet.Text();
                    AiNet.Abandon();
                    SseAnswer fa = AiAgent.ParseSse(sraw);
                    if (fa.totalTokens > 0 || fa.promptTokens > 0) {
                        aiTokPrompt = fa.promptTokens;
                        aiTokCompletion = fa.completionTokens;
                        aiTokTotal = fa.totalTokens;
                        aiTokCached = fa.cachedTokens;
                    }
                    ZanIDE.AiStatAdd(fa);
                    // A success marker begins with "ok" (the streamer can
                    // occasionally append it twice -> "okok"); anything
                    // starting with "err" is a failure.
                    bool doneOk = doneTxt.Length >= 2
                        && doneTxt.Substring(0, 2) == "ok";
                    if (!doneOk || fa.error != "") {
                        string emsg = doneTxt;
                        if (emsg.Length >= 5 && emsg.Substring(0, 5) == "err: ") {
                            emsg = emsg.Substring(5, emsg.Length - 5);
                        }
                        if (fa.error != "") {
                            if (emsg != "" && !doneOk) {
                                emsg = emsg + ": " + fa.error;
                            } else { emsg = fa.error; }
                        }
                        if (emsg == "") { emsg = "the AI request failed."; }
                        ZanIDE.aiStatFails = ZanIDE.aiStatFails + 1;
                        // A dropped connection or an idle timeout is not an
                        // answer: resend the same request instead of
                        // dumping the task on the user, who could only do
                        // the same thing by hand.
                        bool retryable = fa.error == ""
                            && AiAgent.IsTransient(emsg)
                            && aiRetry < AiAgent.MaxRetries();
                        if (retryable) {
                            aiRetry = aiRetry + 1;
                            string rle = ZanIDE.AiLaunchAs(aiRunAgent, aiMsgs,
                                aiRunCtxName, aiRunCtxCode, root,
                                aiProfiles[aiProfActive].baseUrl,
                                aiProfiles[aiProfActive].key, aiRunModel);
                            if (rle == "") {
                                log.Add("> 小赞: " + emsg + " - "
                                    + ZanIDE.T("retrying (", "重试中（")
                                    + Convert.ToString(aiRetry) + "/"
                                    + Convert.ToString(AiAgent.MaxRetries())
                                    + ZanIDE.T(")", "）"));
                                Layer.Msg(ZanIDE.T("Xiao Zan request failed - retrying",
                                    "小赞请求失败——正在重试"), 3);
                            } else {
                                aiMsgs.Add(ChatMessage.Create("error",
                                    "[error] " + rle));
                                aiBusy.Set(0);
                            }
                        } else {
                            aiRetry = 0;
                            aiMsgs.Add(ChatMessage.Create("error",
                                "[error] " + emsg));
                            aiBusy.Set(0);
                        }
                    } else {
                        aiRetry = 0;
                        // A reply that asks for a tool is one step of the
                        // assistant loop, not the answer: run the tool inside
                        // the project, hand the result back and ask again, so
                        // the model reads the real code instead of guessing.
                        string reply = fa.content;
                        string call = AiAgent.ToolBlock(reply);
                        bool more = call != ""
                            && AiAgent.StepsSinceUser(aiMsgs) < AiAgent.MaxSteps();
                        // 聊天区显示的正文：工具调用一律折成一行摘要，包括
                        // 模型忘了围栏、直接吐一个裸 {"tool": ...} 的那种——
                        // 那次一整屏转义过的文件正文就是这么铺出来的。
                        string said = AiAgent.VisibleText(reply);
                        string rz = AiAgent.Trim(fa.reasoning);
                        // A reply that is only a tool block still carries
                        // thinking worth keeping, so save the reasoning
                        // even when there is no visible text.
                        // 这一拍真正发出的调用留在消息的 call 上：聊天区照旧
                        // 只显示正文（工具那一行由工具消息给出），发回模型的
                        // 请求带上它——不然模型照着自己历史里的大白话学，下一
                        // 拍就发不出可执行的调用。
                        string ac = "";
                        if (call != "") { ac = AiAgent.ArchiveCall(call); }
                        if (said != "" || rz != "" || ac != "") {
                            ChatMessage amsg = ChatMessage.CreateWithReason(
                                "assistant", said, rz);
                            amsg.call = ac;
                            if (aiTeamMode) {
                                // Record the beat on the message itself, so
                                // the transcript (and the reload of it) can
                                // show progress and ownership without
                                // re-parsing the prose.
                                AiEnvelope env = AiTeam.ParseEnvelope(said);
                                AiTeam.ApplyToTasks(aiTasks, aiRunAgent, env);
                                amsg.agent = aiRunAgent;
                                amsg.kind = env.kind;
                                amsg.taskId = env.taskId;
                                amsg.progress = env.progress;
                                amsg.to = AiTeam.JoinIds(env.to);
                            }
                            aiMsgs.Add(amsg);
                        }
                        if (more) {
                            string tname = AiAgent.ToolName(call);
                            if (AiAgent.IsMutating(tname) && !aiAutoExec) {
                                // A write / build / run pauses for the user:
                                // park the call and switch to the confirm
                                // state (aiBusy == 2). Nothing touches the
                                // project until they Approve it in the panel.
                                aiPendingCall = call;
                                aiBusy.Set(2);
                            } else {
                                AiDispatchTool(call);
                            }
                        } else {
                            // Nothing left to run this turn. Rather than
                            // stopping half-way through a checklist -- the
                            // task "not continuing by itself" -- push the
                            // loop on with a continue turn, which also
                            // refills the per-question tool budget. Bounded
                            // by aiContMax and never taken when the
                            // model just asked the user something.
                            // A read-only tool (read_file / grep /
                            // list_dir / repo_map) that ran out of budget
                            // is NOT a reason to keep going on its own: the
                            // model was only looking, not doing. Only a
                            // mutating call cut mid-task refills the budget
                            // -- or an unfinished plan under Auto-execute.
                            // 团队模式下这一拍归谁、要不要往下走由协议说话
                            // （AiTeamTurnEnd 读拍子：提问停、交接换人、其余
                            // 原地续），所以这条按计划催的通路只走单助手。
                            // 否则一句「@开发者 [handoff]」会被当成「计划还
                            // 没做完」原地催回架构师，交接永远发不出去。
                            bool limitHit = call != ""
                                && AiAgent.IsMutating(AiAgent.ToolName(call));
                            // 想调用工具但格式不对（裸文本、块没闭合）：这不是
                            // 「只说不做」，是那个调用没被执行。把失败原因说给
                            // 它听并让它重发，否则它只会一模一样再来一遍。
                            // 但正式交付（[report]/[block]/[handoff]/
                            // [question]…）本身就是这一拍的成品，它的正文里
                            // 引用了「read_file "src/X.zan" 返回 no such
                            // file」这种取证也很正常——那不是「想调用工具却
                            // 写成了文字」。这种拍子不许纠格式，得让它按协议
                            // 交出去，不然交接永远发不出来，屏幕上只剩一遍遍
                            // 的格式提醒。
                            string badTool = "";
                            if (call == ""
                                && AiTeam.ParseEnvelope(said).kind == "") {
                                badTool = AiAgent.BadToolHint(reply);
                            }
                            if (badTool != "") {
                                aiIdleWhy = ZanIDE.T("the tool block could not"
                                    + " be parsed, so nothing ran",
                                    "它发的工具块解析不出来（格式不对或被截断），"
                                    + "所以那个调用根本没执行");
                            }
                            if (limitHit) {
                                aiIdleWhy = ZanIDE.T("the per-turn tool budget"
                                    + " ran out", "这一问的工具预算用完了");
                            }
                            bool cont = aiAutoCont < aiContMax
                                && (limitHit || badTool != ""
                                    || (!aiTeamMode && aiAutoExec
                                        && AiPlanUnfinished()
                                        && !AiAgent.AsksUser(said)));
                            if (cont) {
                                aiAutoCont = aiAutoCont + 1;
                                // 「接着做」是流程自己发的，不是用户说的：标上
                                // 流程发语人，聊天区才不会把它画成「我」。
                                string cbody = AiAgent.ContinuePrompt(limitHit,
                                    this.AiCurStep());
                                if (badTool != "") { cbody = badTool; }
                                ChatMessage cm = ChatMessage.Create("user",
                                    cbody);
                                cm.agent = AiTeam.Auto();
                                cm.to = aiRunAgent;
                                aiMsgs.Add(cm);
                                string cle = ZanIDE.AiLaunchAs(aiRunAgent, aiMsgs,
                                    aiRunCtxName, aiRunCtxCode, root,
                                    aiProfiles[aiProfActive].baseUrl,
                                    aiProfiles[aiProfActive].key, aiRunModel);
                                if (cle != "") {
                                    aiMsgs.Add(ChatMessage.Create("error", cle));
                                    aiBusy.Set(0);
                                }
                            } else {
                                if (limitHit) {
                                    aiMsgs.Add(ChatMessage.Create("error", ZanIDE.T(
                                        "Tool limit reached for this question.",
                                        "本次提问的工具调用次数已达上限。")));
                                }
                                this.AiRunTurnEnd(said);
                                AiTeamTurnEnd(said);
                                // 真停下来了而活儿还没干完：把原因说出来。
                                // 预算用尽后静悄悄结束，看上去就是「任务自己
                                // 断了」，用户只能猜要不要催。
                                if (aiBusy.Get() == 0
                                    && aiAutoCont >= aiContMax
                                    && (AiPlanUnfinished()
                                        || (aiTeamMode
                                            && AiTeam.HasUnfinished(aiTasks)))) {
                                    aiMsgs.Add(ChatMessage.Create("error",
                                        ZanIDE.T("Auto-continue budget spent with"
                                            + " work left; say \"continue\" to"
                                            + " push on.",
                                            "自动继续次数已用完，任务还没做完；"
                                            + "回一句「继续」就接着跑。")));
                                }
                            }
                        }
                    }
                    this.AiChatToEnd();
                }
                // 请求在飞的时候按节奏取流，而不是每帧无条件整窗重绘：
                // RequestRedraw 会让事件循环在等模型的那几十秒里满帧空转
                // （一个核心跑满，界面跟着发洩），而流式文本每 100ms 追一次
                // 已经看不出差别。节奏见上面 aiPollMs：真有文本在流才 100ms，
                // 模型在想 / 工具在跑就 250ms。构建 / 运行 / 发布的轮询同理。
                this.PollNextIn(app, aiPollMs, dock.ContentParked("ai"));
            }
            app.PerfMark("sh.aipoll");

            // Autosave the AI transcript (throttled to 1/s): every new user
            // turn, tool result or streamed answer is folded into the
            // current session and written to disk, so restarting the IDE
            // keeps the conversation instead of losing it. This runs per
            // frame, NOT inside the panel's own branch: a chat that keeps
            // answering while the assistant panel is hidden (or tabbed
            // behind another dock panel) was never written back, which is
            // how a reopened session came back cut off mid-answer.
            this.AutosaveAiSessions(Window.GetTickMs());
            app.PerfMark("sh.autosave");

            // Close the dock frame: draws the drag ghost / drop highlight
            // over the panels and applies a finished drag. The arrangement
            // is written back only when it actually changed.
            dock.End(app);
            string dockClosed = dock.TakeClosed();
            if (dockClosed != "") {
                Layer.Msg(ZanIDE.T("Panel closed - right-click a tab strip to restore",
                    "面板已关闭 - 右键标签栏可恢复"), 3);
            }
            if (dock.TakeChanged()) { ZanIDE.WriteDockLayout(dock.SaveLayout()); }
            app.PerfMark("sh.dockend");

            // Status bar. Drawn on the same muted panel surface as the
            // title bar / side panels (bgSecondary) so the shell reads as
            // one calm frame; only the debugging state gets a loud tint.
            int sbY = H - sbH;
            bool sbDebug = (dbgState == 2);
            int sbText = t.textPrimary;
            int sbMuted = t.textSecondary;
            if (sbDebug) {
                sbText = t.onScrim;
                sbMuted = t.tooltipTextMuted;
            }
            int curLn = editor.CurLine();
            int curCl = editor.CurCol();
            string posInfo = ZanIDE.T("Ln ", "行 ") + Convert.ToString(curLn + 1) + ZanIDE.T(", Col ", "，列 ") + Convert.ToString(curCl + 1);
            // Language of the buffer, so an embedded .lua/.py script
            // edited next to its Zan host shows which rules the editor
            // is applying (highlighting, comment mark, completion).
            string modeInfo = "Zan";
            if (editor.SyntaxLang() == 1) { modeInfo = "Lua"; }
            if (editor.SyntaxLang() == 2) { modeInfo = "Python"; }
            if (designerMode) { modeInfo = ZanIDE.T("Designer", "设计器"); }
            if (pubBusy) { modeInfo = ZanIDE.T("Publishing...", "发布中..."); }
            if (sbDebug) { modeInfo = ZanIDE.T("Debugging", "调试中"); }
            int sbTint = 0;
            if (sbDebug) { sbTint = t.statusDebugBg; }
            statusBar.SetTint(sbTint);
            statusBar.SetText(sbPosItem, posInfo);
            statusBar.SetColor(sbPosItem, sbText);
            statusBar.SetText(sbModeItem, modeInfo);
            statusBar.SetColor(sbModeItem, sbText);
            statusBar.SetColor(sbEncItem, sbMuted);
            statusBar.RenderAt(app, 0, sbY, W, sbH);
            app.PerfMark("sh.status");

            // Top-level editor context menu overlay (drawn last so nothing
            // paints over it), then bridge its host commands.
            if (!designerMode && !activeIsStart && !activeIsDocs) {
                app.BeginIdScope(930000);
                editor.RenderCtxMenu(app);
                app.EndIdScope();
                string ecmd = editor.TakeCommand();
                if (ecmd == "find") {
                    findMode = 1;
                    findBar.Open(false, this.FindSeed());
                    app.RequestRedraw();
                }
                else if (ecmd == "gotoline") { findMode = 3; app.RequestRedraw(); }
                else if (ecmd == "gotodef") {
                    if (lspSess == null && !lspTried) {
                        lspTried = true;
                        lspSess = LspSession.Start(root);
                        if (lspSess != null) { log.Add("> zan-lsp connected: semantic navigation enabled."); }
                    }
                    string navW_gl = editor.WordAtCaret();
                    this.RememberTabView();
                    int gl = ZanIDE.GoToDefinitionSmart(lspSess, editor, tabs, activeTab, root, log);
                    this.ApplyGotoResult(gl, navW_gl);
                    app.RequestRedraw();
                } else if (ecmd == "findrefs") {
                    if (lspSess == null && !lspTried) {
                        lspTried = true;
                        lspSess = LspSession.Start(root);
                        if (lspSess != null) { log.Add("> zan-lsp connected: semantic navigation enabled."); }
                    }
                    this.ShowReferences();
                    app.RequestRedraw();
                }
            }
            // File-tree / tab right-click context menus, drawn above the
            // editor overlay. ctxKind: 1 = project tree row, 2 = stdlib
            // tree row, 3 = editor tab, 4 = Tools panel row, 5 = Examples
            // panel row, 6 = Structure / Components panel row.
            if (ctxKind != 0) {
                List<string> cmLabels = new List<string>();
                if (ctxKind == 1) {
                    cmLabels.Add(ZanIDE.T("New File", "新建文件"));
                    cmLabels.Add(ZanIDE.T("New Folder", "新建文件夹"));
                    cmLabels.Add("-");
                    int delN = 1;
                    if (explorerTv != null && explorerTv.IsMarked(ctxTarget)) {
                        delN = explorerTv.SelectionCount();
                    }
                    if (delN > 1) {
                        cmLabels.Add(ZanIDE.T("Delete ", "删除 ") + Convert.ToString(delN)
                            + ZanIDE.T(" items", " 项"));
                    } else {
                        cmLabels.Add(ZanIDE.T("Delete", "删除"));
                    }
                    cmLabels.Add("-");
                    cmLabels.Add(ZanIDE.T("Refresh", "刷新"));
                    cmLabels.Add(ZanIDE.T("Copy Path", "复制路径"));
                    cmLabels.Add(ZanIDE.T("Reveal in Explorer", "在资源管理器中显示"));
                    // 生成操作：这一项发布时是复制到输出目录、编进可执行
                    // 文件，还是不处理（默认按约定复制 config/views/wwwroot）。
                    string genRel = this.CtxProjRel();
                    if (genRel != "") {
                        string cur = ZanIDE.ProjGenAction(root, genRel);
                        cmLabels.Add("-");
                        cmLabels.Add(ZanIDE.GenMark(cur, "none")
                            + ZanIDE.T("Build Action: None", "生成操作：不处理"));
                        cmLabels.Add(ZanIDE.GenMark(cur, "copy")
                            + ZanIDE.T("Build Action: Copy to Output", "生成操作：复制到输出"));
                        cmLabels.Add(ZanIDE.GenMark(cur, "embed")
                            + ZanIDE.T("Build Action: Embed", "生成操作：内嵌到程序"));
                    }
                } else if (ctxKind == 2) {
                    cmLabels.Add(ZanIDE.T("Open", "打开"));
                    cmLabels.Add("-");
                    cmLabels.Add(ZanIDE.T("Refresh", "刷新"));
                    cmLabels.Add(ZanIDE.T("Copy Path", "复制路径"));
                    cmLabels.Add(ZanIDE.T("Reveal in Explorer", "在资源管理器中显示"));
                } else if (ctxKind == 3) {
                    cmLabels.Add(ZanIDE.T("Close", "关闭"));
                    cmLabels.Add(ZanIDE.T("Close Others", "关闭其他"));
                    cmLabels.Add("-");
                    cmLabels.Add(ZanIDE.T("Copy Path", "复制路径"));
                } else if (ctxKind == 4) {
                    cmLabels.Add(ZanIDE.T("Open in Editor", "在编辑器中打开"));
                    cmLabels.Add(ZanIDE.T("Run", "运行"));
                    cmLabels.Add("-");
                    cmLabels.Add(ZanIDE.T("Copy Path", "复制路径"));
                    cmLabels.Add(ZanIDE.T("Reveal in Explorer", "在资源管理器中显示"));
                } else if (ctxKind == 5) {
                    cmLabels.Add(ZanIDE.T("Open", "打开"));
                    cmLabels.Add("-");
                    cmLabels.Add(ZanIDE.T("Copy Path", "复制路径"));
                    cmLabels.Add(ZanIDE.T("Reveal in Explorer", "在资源管理器中显示"));
                } else if (ctxKind == 6) {
                    // 组件行可以成组删除 / 复制；代码大纲只是符号，
                    // 那两项灰不掉就干脆不列出来。
                    if (this.StructEditable()) {
                        int selN = 1;
                        if (structTv != null && structTv.IsMarked(ctxTarget)) {
                            selN = structTv.SelectionCount();
                        }
                        if (selN > 1) {
                            cmLabels.Add(ZanIDE.T("Delete ", "删除 ")
                                + Convert.ToString(selN)
                                + ZanIDE.T(" components", " 个组件"));
                        } else {
                            cmLabels.Add(ZanIDE.T("Delete", "删除"));
                        }
                        cmLabels.Add(ZanIDE.T("Duplicate", "创建副本"));
                        cmLabels.Add("-");
                    }
                    cmLabels.Add(ZanIDE.T("Copy Name", "复制名称"));
                } else if (ctxKind == 7) {
                    // 任务图节点：被前置卡住的节点不列「开工」，列不出来的
                    // 原因由「为什么被卡住」那一项讲清楚。
                    if (AiTeam.BlockedWhy(aiTasks, ctxTaskId) == "") {
                        cmLabels.Add(ZanIDE.T("Start work", "开工"));
                    } else {
                        cmLabels.Add(ZanIDE.T("Why is it blocked?",
                            "为什么被卡住"));
                    }
                    // 收尾了的节点这一项换成「重新打开」：完成不是只读——在
                    // 某个节点上聊出新需求、要改验收标准或换负责人，都得先
                    // 能把它重新打开。
                    AiTask cmT = AiTeam.TaskOf(aiTasks, ctxTaskId);
                    if (cmT != null && cmT.state == AiTeam.TaskDone()) {
                        cmLabels.Add(ZanIDE.T("Reopen for changes",
                            "重新打开修改"));
                    } else {
                        cmLabels.Add(ZanIDE.T("Mark done", "标记完成"));
                    }
                    // 开工能撤：被推成「进行中」的节点必须退得回去，否则点错一下
                    // 就永远挂着一个假的进行中。
                    cmLabels.Add(ZanIDE.T("Withdraw, back to todo",
                        "撤回到待办"));
                    cmLabels.Add("-");
                    cmLabels.Add(ZanIDE.T("Acceptance criteria", "验收标准"));
                    cmLabels.Add(ZanIDE.T("Copy task ID", "复制节点 ID"));
                }
                // An open context menu owns the pointer. Without this, the
                // click that dismisses it also reached whatever was under it
                // (a tree row got selected / a file opened / a tab switched by
                // the same click that closed the menu), which is what made the
                // right-click menus look like they fired the wrong action.
                // Registering the block here -- after the panels below have
                // rendered, before the menu itself -- is what keeps the menu's
                // own items clickable (see App.ClickAvailable).
                // The scope is what keeps the menu from renumbering every id
                // allocated after it (dialogs, toasts, the window caption):
                // an open menu consumed two root ids, so the frame that opened
                // or closed it resolved the pointer against a different
                // control than the one that ends up with that id.
                app.BeginIdScope(935000);
                app.BlockHitsMenu();
                int chosen = ContextMenu.Render(app, ctxX, ctxY, cmLabels);
                app.EndIdScope();
                if (chosen == 0 - 2) {
                    ctxKind = 0;
                    app.RequestRedraw();
                } else if (chosen >= 0) {
                    if (ctxKind == 1) {
                        if (chosen == 0 && dlg == null) {
                            dlg = this.OpenWizardHost(app, ZanIDE.T("New File", "新建文件"), 720, 470, 2);
                            dlgMode = 2;
                        } else if (chosen == 1 && dlg == null) {
                            dlg = this.OpenWizardHost(app, ZanIDE.T("New Folder", "新建文件夹"), 720, 470, 2);
                            fNameInput.SetText("NewFolder");
                            fSel.Set(ZanIDE.FileKindFolder());
                            dlgMode = 2;
                        } else if (chosen == 3) {
                            // Delete every marked row when the right-clicked
                            // row is part of the multi-selection; otherwise
                            // just the row the menu was opened on.
                            List<int> delRows = new List<int>();
                            if (explorerTv != null && explorerTv.IsMarked(ctxTarget)) {
                                delRows = explorerTv.SelectedIndices();
                            } else {
                                delRows.Add(ctxTarget);
                            }
                            int nDel = 0;
                            string lastName = "";
                            for (int dj = 0; dj < delRows.Count; dj = dj + 1) {
                                int rowd = delRows[dj];
                                if (rowd >= 0 && rowd < treeShow.Count) {
                                    string dp = treeShow[rowd].path;
                                    if (haveProject && dp != "" && ZanIDE.StartsWith(dp, root) && dp != root) {
                                        ZanIDE.DeletePathRecursive(dp);
                                        log.Add("> Deleted " + dp + ".");
                                        lastName = Path.GetFileName(dp);
                                        nDel = nDel + 1;
                                    }
                                }
                            }
                            if (nDel > 1) {
                                Layer.Notify(ZanIDE.T("Deleted ", "已删除 ") + Convert.ToString(nDel)
                                    + ZanIDE.T(" items", " 项"), 3);
                            } else if (nDel == 1) {
                                Layer.Notify(ZanIDE.T("Deleted: ", "已删除：") + lastName, 3);
                            }
                            if (nDel > 0) {
                                explorerTv.ClearSelection();
                                rescan = true;
                            }
                        } else if (chosen == 5) {
                            rescan = true;
                        } else if (chosen == 6) {
                            if (ctxTarget >= 0 && ctxTarget < treeShow.Count) {
                                Clipboard.SetText(treeShow[ctxTarget].path);
                                log.Add("> Copied path: " + treeShow[ctxTarget].path);
                            }
                        } else if (chosen == 7) {
                            if (ctxTarget >= 0 && ctxTarget < treeShow.Count) {
                                ZanIDE.RevealInFileManager(treeShow[ctxTarget].path);
                            }
                        } else if (chosen >= 9 && chosen <= 11) {
                            string grel = this.CtxProjRel();
                            if (grel != "") {
                                string act = "none";
                                if (chosen == 10) { act = "copy"; }
                                if (chosen == 11) { act = "embed"; }
                                ZanIDE.SetProjGenAction(root, grel, act);
                                log.Add("> Build action for " + grel + ": " + act
                                    + " (zan.proj).");
                                Layer.Notify(grel + " → " + ZanIDE.GenLabel(act), 3);
                            }
                        }
                    } else if (ctxKind == 2) {
                        if (ctxTarget >= 0 && ctxTarget < exShow.Count) {
                            TreeNode exn = exShow[ctxTarget];
                            bool exReal = exn.path != "" && !ZanIDE.StartsWith(exn.path, "@");
                            if (chosen == 0) {
                                if (exReal && !exn.isDir) {
                                    ZanIDE.OpenPath(tabs, activeTab, exn.path, exn.label);
                                    log.Add("> Opened " + exn.path + ".");
                                }
                            } else if (chosen == 2) {
                                exTree = ZanIDE.BuildStdlibTree();
                                log.Add("> Refreshed standard library / tools / examples.");
                            } else if (chosen == 3) {
                                if (exReal) {
                                    Clipboard.SetText(exn.path);
                                    log.Add("> Copied path: " + exn.path);
                                }
                            } else if (chosen == 4) {
                                if (exReal) { ZanIDE.RevealInFileManager(exn.path); }
                            }
                        }
                    } else if (ctxKind == 3) {
                        if (chosen == 0) {
                            this.RequestCloseTab(ctxTarget);
                        } else if (chosen == 1) {
                            if (ctxTarget >= 0 && ctxTarget < tabs.Count) {
                                this.RequestCloseOthers(tabs[ctxTarget].path);
                            }
                        } else if (chosen == 3) {
                            if (ctxTarget >= 0 && ctxTarget < tabs.Count) {
                                Clipboard.SetText(tabs[ctxTarget].path);
                                log.Add("> Copied path: " + tabs[ctxTarget].path);
                            }
                        }
                    } else if (ctxKind == 4) {
                        if (ctxTarget >= 0 && ctxTarget < rtCtxShow.Count) {
                            TreeNode rtrn = rtCtxShow[ctxTarget];
                            bool rtReal = rtrn.path != "" && !ZanIDE.StartsWith(rtrn.path, "@");
                            if (!rtrn.isDir && rtReal) {
                                if (chosen == 0) {
                                    ZanIDE.OpenPath(tabs, activeTab, rtrn.path, rtrn.label);
                                    log.Add("> Opened " + rtrn.path + ".");
                                } else if (chosen == 1) {
                                    string rtcT = ZanIDE.RunTarget(rtrn.path, root);
                                    if (buildBusy) {
                                        Layer.Msg(ZanIDE.T("Build already running…", "构建进行中…"), 2);
                                    } else if (rtcT != "") {
                                        log.Add(ZanIDE.T("> Running tool ", "> 运行工具 ") + rtrn.path + " ...");
                                        buildBusy = true;
                                        buildStartMs = Window.GetTickMs();
                                        buildThenRun = true;
                                        buildExe = ZanIDE.RunBuildBegin(root, rtcT);
                                        buildIsGui = ZanIDE.IsWindowedTarget(root, rtcT);
                                        buildTargetPath = rtrn.path;
                                        buildLogLen = 0;
                                        dock.Focus("output");
                                        app.RequestAnimationFrame(80);
                                    }
                                } else if (chosen == 3) {
                                    Clipboard.SetText(rtrn.path);
                                    log.Add("> Copied path: " + rtrn.path);
                                } else if (chosen == 4) {
                                    ZanIDE.RevealInFileManager(rtrn.path);
                                }
                            }
                        }
                    } else if (ctxKind == 6) {
                        int strDel = 0;
                        int strDup = 1;
                        int strCopy = 3;
                        if (!this.StructEditable()) {
                            strDel = 0 - 1;
                            strDup = 0 - 1;
                            strCopy = 0;
                        }
                        if (chosen == strDel) {
                            this.StructureDeleteSelection();
                        } else if (chosen == strDup) {
                            this.StructureDuplicate();
                        } else if (chosen == strCopy) {
                            if (ctxTarget >= 0 && structShow != null
                                && ctxTarget < structShow.Count) {
                                Clipboard.SetText(structShow[ctxTarget].label);
                                log.Add("> Copied name: "
                                    + structShow[ctxTarget].label);
                            }
                        }
                    } else if (ctxKind == 5) {
                        if (ctxTarget >= 0 && ctxTarget < rtCtxShow.Count) {
                            TreeNode exrn = rtCtxShow[ctxTarget];
                            bool exrReal = exrn.path != "" && !ZanIDE.StartsWith(exrn.path, "@");
                            if (chosen == 0) {
                                if (!exrn.isDir && exrReal) {
                                    ZanIDE.OpenPath(tabs, activeTab, exrn.path, exrn.label);
                                    log.Add("> Opened " + exrn.path + ".");
                                }
                            } else if (chosen == 2) {
                                if (exrReal) {
                                    Clipboard.SetText(exrn.path);
                                    log.Add("> Copied path: " + exrn.path);
                                }
                            } else if (chosen == 3) {
                                if (exrReal) { ZanIDE.RevealInFileManager(exrn.path); }
                            }
                        }
                    } else if (ctxKind == 7) {
                        this.AiGraphMenu(ctxTaskId, chosen);
                    }
                    ctxKind = 0;
                    app.RequestRedraw();
                }
            }

            // Publish / Project Configuration / Asset Manager now render in
            // their own top-level child windows (App.CreateDark) -- see the
            // pumps right after the main frame below. Only the deferred
            // publish kick-off (started once the window has closed) stays here.
            if (pubPending && !pubBusy) {
                pubPending = false;
                pubExes = ZanIDE.PublishPlatformsBegin(tabs, activeTab, root, pubSel, log);
                pubBusy = pubExes.Count > 0;
                pubStartMs = Window.GetTickMs();
                pubLogLen = 0;
                app.RequestRedraw();
            }
            string windowTitle = IdeVersion.Product();
            if (haveProject) { windowTitle = windowTitle + "  —  " + root; }
            // Unsaved-changes / changed-on-disk questions, above the page
            // and below the transient feedback queues.
            app.BeginIdScope(940000);
            this.RenderDocDialogs();
            app.EndIdScope();
            // Global operation feedback: toast + notification queues drawn
            // above everything so every action gives visible feedback.
            app.BeginIdScope(945000);
            Layer.RenderToasts(app);
            Layer.RenderNotifs(app);
            // Hover tips requested by widgets during the frame, painted on
            // top of everything they would otherwise hide behind.
            Tooltip.Flush(app);
            app.EndIdScope();
        } catch (Exception frameEx) {
            app.NoteFrameError("ide-frame", frameEx.Message);
            app.CancelPartialFrame();
            app.RequestRedraw();
        }
    }

    /// Runs once when the event loop ends: flush the AI chat and persist the
    /// window + panel sizes before the process goes away.
    void Shutdown() {
    // Flush the chat before the process goes away: the 1/s autosave can
    // still be holding a partially streamed answer when the window closes,
    // and that half-written turn is exactly what a reopened session showed.
    SaveAiSessions();
    // Persist window + panel sizes so the next launch restores them.
    // Only the USER's own wallpaper is persisted: the skin pack's art is
    // installed by the skin on launch, so saving it would leak this pack's
    // backdrop into the next launch (and mix palettes when the skin
    // changes). Skin.Apply installs the pack art when there is no user
    // wallpaper, so the distinction is exact.
    int arv = 0;
    if (autoRun) { arv = 1; }
    ZanIDE.SaveSettings(treeW.Get(), bottomPanelH.Get(), savedW, savedH, arv, app.SkinNameAt(app.ThemeMenuIndex()), rightW.Get(), winOpacity, app.UserWallpaperPath(), app.UserWallpaperOpacity());
}

    /// The console jumps back to the newest line (a fresh run/build starts).
    /// The diagnostics of the last build. Scanning the whole console costs
    /// time proportional to its length, and the panel is drawn every frame,
    /// so the parse is kept until the log itself changes.
    List<DiagnosticRecord> BuildErrors() {
        if (errCache == null || errCacheLog != log
                || errCacheCount != log.Count) {
            errCache = new List<DiagnosticRecord>();
            ZanIDE.ParseErrorList(log, errCache);
            errCacheLog = log;
            errCacheCount = log.Count;
        }
        return errCache;
    }

    void OutputReset() {
        if (coLog != null) { coLog.Reset(); }
    }

    /// The console'''s Clear button (designed handler): empties the real log
    /// and resets the panel'''s filter and scroll state.
    static void OutputClearRequested() {
        ZanIDE ide = ZanIDE.current;
        if (ide == null || ide.coCtxOpen) { return; }
        ide.log = new List<string>();
        ide.coFilter.SetText("");
        ide.OutputReset();
    }
}
