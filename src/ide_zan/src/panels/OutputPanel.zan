using System;
using Gui;
using Gui.Widget;

/// OUTPUT 面板（控制台）。
///
/// 界面在 `OutputPanel.zform` 里声明：顶部一行是筛选框 + 清空按钮，
/// 一条分隔线，其下是填满面板的 ConsoleView（尾部滚动、可选择、
/// 自带滚动条）。这里只做数据绑定、着色和把「清空」的意图交回外壳。
partial class OutputPanel {
    /// 面板当前显示的行（筛选后的视图，不是真实日志）。
    List<string> shown;

    void OnInit() {
        shown = new List<string>();
        this.Filter.SetProp("placeholder",
            ZanIDE.T("Filter...", "筛选..."));
        this.ClearBtn.SetProp("text", ZanIDE.T("Clear", "清空"));
        this.Log.EmptyText(
            ZanIDE.T("(no console output)", "（暂无控制台输出）"));
    }

    /// 筛选框：外壳复用同一个控件，语言切换时刷新占位符。
    Input FilterBox() { return this.Filter; }

    /// 控制台的滚动/选择状态：外壳在新一轮构建、运行前 Reset()。
    LogState State() { return this.Log.State(); }

    /// 面板这一帧显示的行（右键菜单按行号取内容）。
    List<string> Shown() { return shown; }

    /// 用真实日志绘制面板：按筛选文本裁出视图，着色后交给
    /// ConsoleView。真实日志不被修改。
    void Render(App app, Rect area, List<string> log) {
        string q = this.Filter.GetText();
        List<string> view = log;
        if (q != "") {
            view = new List<string>();
            for (int i = 0; i < log.Count; i = i + 1) {
                if (ZanIDE.Has(log[i], q)) { view.Add(log[i]); }
            }
        }
        shown = view;
        this.Log.Bind(view);
        this.Log.WithColors(OutputPanel.ConsoleColors(app, view));
        this.RenderInside(app, area);
    }

    /// 每行的颜色：构建/调试输出按编辑器调色板着色，于是它和
    /// 程序自身的输出一眼能分开。
    static List<int> ConsoleColors(App app, List<string> lines) {
        EditorPalette pal = EditorPalette.For(app.theme);
        List<int> colors = new List<int>();
        for (int i = 0; i < lines.Count; i = i + 1) {
            string ln = lines[i];
            int col = 0;
            if (ln.Length > 8 && ln.Substring(0, 2) == "> ") {
                string sub6 = ln.Substring(2, 6);
                if (sub6 == "[Debug") { col = pal.type; }
                else if (sub6 == "--- Li") { col = pal.keyword; }
                else if (sub6 == "  ") { col = pal.str; }
            }
            colors.Add(col);
        }
        return colors;
    }
}
