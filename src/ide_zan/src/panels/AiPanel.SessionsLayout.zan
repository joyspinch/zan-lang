using Gui;

partial class AiPanel {
    Rect LayoutSidebarForSessions(App app, Rect area, int sideW) {
        if (area == null || area.width <= 0 || area.height <= 0) {
            return new Rect(0, 0, 0, 0);
        }
        this.Sidebar.Prefer(sideW, 0);
        this.Sidebar.SetShown(sideW > 0);
        this.SideRule.SetShown(sideW > 0);
        this.MeasureTree(app, area.width);
        this.Arrange(area.x, area.y, area.width, area.height);
        // Hidden controls retain their previous bounds; the separate session
        // tree must receive an empty area so it releases borrowed input.
        if (sideW <= 0) { return new Rect(0, 0, 0, 0); }
        return this.SidebarRect();
    }
}
