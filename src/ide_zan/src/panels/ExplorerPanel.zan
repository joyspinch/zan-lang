using System;
using Gui;
using Gui.Widget;

// EXPLORER 面板：项目文件树。设计稿声明真实子树，宿主在输入前准备 dock 区域。
partial class ExplorerPanel {
    IdeTreePanelHost host;
    Input filter;

    void OnInit() {
        // ProjectBody adopts children; the designed host keeps its own layout classes.
        this.AddClass("ide-panel");
        this.Tree.WithMultiSelect();
        this.Tree.EmptyText(ZanIDE.T("No files", "没有文件"));
        host = new IdeTreePanelHost(this, this.Tree);
    }

    // 保留外壳的选择、筛选、文件打开与上下文菜单契约。
    void Wire(Binding<int> selection, Input f) {
        filter = f;
        this.Tree.Value = selection;
        this.Tree.WithFilter(f);
        this.Tree.OnSelect(ZanIDE.ExplorerPicked);
        this.Tree.OnActivate(ZanIDE.ExplorerPicked);
        this.Tree.OnContext(ZanIDE.ExplorerContext);
    }

    List<TreeNode> Shown() { return host.Shown(); }
    void InitializeHost(App app, UiViewOwner owner) { host.Initialize(app, owner); }
    bool OwnsView(UiViewScope view) { return host.OwnsView(view); }
    void PrepareHost(App app, Rect area, List<TreeNode> nodes) { host.Prepare(app, area, nodes, filter); }
    void RetireHost() { host.Retire(); }

    // Paint consumes prepared data and geometry, without mounting input or relaying events.
    void Render(App app, Rect area, List<TreeNode> nodes) { host.Render(app, area); }
}
