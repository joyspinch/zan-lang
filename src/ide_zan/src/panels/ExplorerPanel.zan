using System;
using Gui;
using Gui.Widget;

/// EXPLORER 面板：项目文件树。
///
/// 界面在 `ExplorerPanel.zform` 里声明（一个填充整个面板的
/// TreeView，树自带筛选行、滚动条和选择），这里只做数据绑定和
/// 事件接线。宿主（IDE 外壳）把 dock 分配到的矩形交给
/// `Render`，面板不关心自己被停靠在哪一侧。
partial class ExplorerPanel {
    /// 树的当前视图（已按筛选文本过滤），每帧重建一次。
    List<TreeNode> shown;
    /// 外壳持有的筛选输入框（树自己绘制这一行）。
    Input filter;

    void OnInit() {
        ExplorerPanel.Tree.WithMultiSelect();
        ExplorerPanel.Tree.EmptyText(ZanIDE.T("No files", "没有文件"));
        shown = new List<TreeNode>();
    }

    /// 把面板接到外壳的选择/筛选状态和文件打开、右键菜单处理器上。
    void Wire(SignalInt sel, Input f) {
        filter = f;
        ExplorerPanel.Tree.BindSel(sel).WithFilter(f);
        ExplorerPanel.Tree.OnSelect(ZanIDE.ExplorerPicked);
        ExplorerPanel.Tree.OnContext(ZanIDE.ExplorerContext);
    }

    /// 面板当前显示的节点（外壳按索引回查选中的文件）。
    List<TreeNode> Shown() { return shown; }

    /// 用项目树数据绘制面板。
    void Render(App app, Rect area, List<TreeNode> nodes) {
        string q = "";
        if (filter != null) { q = filter.GetText(); }
        shown = ZanIDE.FilterNodes(nodes, q);
        ExplorerPanel.Tree.Bind(shown);
        this.RenderInside(app, area);
    }
}
