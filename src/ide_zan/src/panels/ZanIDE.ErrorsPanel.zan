using System;
using System.Collections.Generic;
using Gui;
using Gui.Widget;
using Gui.Component;

partial class ZanIDE {
    static void ParseErrorList(List<string> log, List<DiagnosticRecord> records) {
        for (int i = 0; i < log.Count; i = i + 1) {
            string ln = ZanIDE.TrimLogPrefix(ZanIDE.StripAnsi(log[i]));
            int ep = ZanIDE.IndexOfStr(ln, ": error:");
            if (ep < 0) { ep = ZanIDE.IndexOfStr(ln, ": warning:"); }
            if (ep < 0) {
                if (ZanIDE.StartsWith(ln, "error:")
                    || ZanIDE.StartsWith(ln, "warning:")) {
                    records.Add(new DiagnosticRecord("", "", ln));
                }
                continue;
            }
            string msg = ZanIDE.TrimLeadSpaces(
                ln.Substring(ep + 2, ln.Length - (ep + 2)));
            string head = ln.Substring(0, ep);
            string col = ZanIDE.CutTrailingNumber(head);
            if (col != "") { head = head.Substring(0, head.Length - (col.Length + 1)); }
            string line = ZanIDE.CutTrailingNumber(head);
            if (line != "") { head = head.Substring(0, head.Length - (line.Length + 1)); }
            if (line == "") { line = col; }
            records.Add(new DiagnosticRecord(head, line, msg));
        }
    }

    static string CutTrailingNumber(string s) {
        int p = s.Length;
        while (p > 0 && ZanIDE.IsDigit(s.Substring(p - 1, 1))) { p = p - 1; }
        if (p >= s.Length || p == 0) { return ""; }
        if (s.Substring(p - 1, 1) != ":") { return ""; }
        return s.Substring(p, s.Length - p);
    }

    static string TrimLogPrefix(string s) {
        int p = 0;
        while (p < s.Length) {
            string c = s.Substring(p, 1);
            if (c == " " || c == "\t" || c == ">") { p = p + 1; } else { break; }
        }
        return s.Substring(p, s.Length - p);
    }

    static string DiagnosticName(string msg) {
        int first = ZanIDE.StrFind(msg, "'");
        if (first < 0) { return ""; }
        int rest = first + 1;
        int secondRel = ZanIDE.StrFind(
            msg.Substring(rest, msg.Length - rest), "'");
        if (secondRel < 0) { return ""; }
        return msg.Substring(rest, secondRel);
    }

    static string SuggestedUsing(string msg) {
        string name = ZanIDE.DiagnosticName(msg);
        string widgets = "|Avatar|Badge|Breadcrumb|Button|Card|Carousel|Chart|"
            + "Checkbox|CodeEditor|Collapse|DataTable|Dialog|Divider|Drawer|Dropdown|"
            + "Ellipsis|Empty|FilePicker|FloatButton|Input|Label|ListView|"
            + "Menu|Message|Modal|Notification|PageHeader|Pagination|Panel|"
            + "Popconfirm|Popover|Progress|Radio|Rate|Result|Ribbon|Scrollbar|"
            + "Skeleton|Slider|Spin|Split|Statistic|Steps|Switch|Table|Tabs|"
            + "Tag|Timeline|Tooltip|TreeView|Typography|Wizard|";
        string gui = "|App|Canvas|Theme|Window|Rect|Color|SignalBool|SignalInt|"
            + "SignalString|HitRegion|TreeNode|Icon|Clipboard|Ui|Stack|Text|Point|"
            + "Size|FlexStyle|FocusManager|";
        string io = "|File|Directory|Path|";
        string system = "|Console|Convert|List|StringBuilder|";
        string text = "|Encoding|";
        string threading = "|Thread|Mutex|Semaphore|Stopwatch|Channel|AtomicInt|";
        string http = "|HttpClient|HttpRequest|HttpResponse|HttpServer|HttpRouter|";
        string sockets = "|Socket|TcpClient|UdpClient|TcpListener|AsyncSocket|";
        string net = "|Dns|IPAddress|";
        string json = "|JsonValue|";
        string drawing = "|ImageBuffer|PixelOps|Point|Size|Rectangle|Color|";
        string crypto = "|Sha1|Sha256|Sha512|Md5|Hmac|Aes|AesGcm|Rsa|Base64|Hex|"
            + "RandomNumberGenerator|BigInt|";
        string data = "|DbConnection|DbResult|";
        string collections = "|HashSet|PriorityQueue|LinkedList|RingBuffer|IEnumerable|IEnumerator|KVP|KeyValuePair|Queue|Stack|ConcurrentDictionary|ConcurrentQueue|";
        string linq = "|ValueEnumerable|Stream|Enumerable|Grouping|";
        string orm = "|OrmMeta|BaseRepository|TransactionScope|UnitOfWork|OrmSelect|OrmUpdate|OrmDelete|OrmInsert|OrmCol|OrmIndex|OrmNav|OrmCond|";
        string chart = "|ChartOption|ChartSeries|ChartType|ChartData|ChartAxis|ChartPoint|ChartBreak|ChartNode|ChartLink|";
        string designer = "|LiveLayoutSession|LiveDeltaOp|LiveDeltaOpKind|";
        string config = "|ConfigurationBuilder|IConfiguration|IConfigurationSection|IConfigurationProvider|"
            + "ConfigurationRoot|ConfigurationSection|ConfigurationProvider|ConfigurationKeys|ConfigurationValues|"
            + "MemoryConfigurationProvider|EnvironmentConfigurationProvider|EnvFileConfigurationProvider|"
            + "JsonFileConfigurationProvider|";
        string di = "|IServiceProvider|ServiceCollection|ServiceProvider|IServiceScope|";
        if (name != "" && ZanIDE.Has(widgets, "|" + name + "|")) {
            return "Gui.Widget";
        }
        if (name != "" && ZanIDE.Has(collections, "|" + name + "|")) {
            return "System.Collections.Generic";
        }
        if (name != "" && ZanIDE.Has(linq, "|" + name + "|")) {
            return "System.Linq";
        }
        if (name != "" && ZanIDE.Has(orm, "|" + name + "|")) {
            return "System.Data.Orm";
        }
        if (name != "" && ZanIDE.Has(chart, "|" + name + "|")) {
            return "Gui.Component.Chart";
        }
        if (name != "" && ZanIDE.Has(designer, "|" + name + "|")) {
            return "Gui.Designer";
        }
        if (name != "" && ZanIDE.Has(config, "|" + name + "|")) {
            return "System.Configuration";
        }
        if (name != "" && ZanIDE.Has(di, "|" + name + "|")) {
            return "System.DependencyInjection";
        }
        if (name == "ArrayPool") { return "System.Buffers"; }
        if (name == "Csv" || name == "CsvTable") { return "System.Csv"; }
        if (name == "Yaml" || name == "YamlParser") { return "System.Yaml"; }
        if (name == "Toml" || name == "TomlParser") { return "System.Toml"; }
        if (name == "Bson" || name == "BsonReader" || name == "BsonWriter") { return "System.Bson"; }
        if (name == "Cbor" || name == "CborReader" || name == "CborWriter") { return "System.Cbor"; }
        if (name != "" && ZanIDE.Has(gui, "|" + name + "|")) {
            return "Gui";
        }
        if (name != "" && ZanIDE.Has(io, "|" + name + "|")) {
            return "System.IO";
        }
        if (name != "" && ZanIDE.Has(system, "|" + name + "|")) {
            return "System";
        }
        if (name != "" && ZanIDE.Has(text, "|" + name + "|")) {
            return "System.Text";
        }
        if (name != "" && ZanIDE.Has(threading, "|" + name + "|")) {
            return "System.Threading";
        }
        if (name != "" && ZanIDE.Has(http, "|" + name + "|")) {
            return "System.Net.Http";
        }
        if (name != "" && ZanIDE.Has(sockets, "|" + name + "|")) {
            return "System.Net.Sockets";
        }
        if (name != "" && ZanIDE.Has(net, "|" + name + "|")) {
            return "System.Net";
        }
        if (name != "" && ZanIDE.Has(json, "|" + name + "|")) {
            return "System.Json";
        }
        if (name != "" && ZanIDE.Has(drawing, "|" + name + "|")) {
            return "System.Drawing";
        }
        if (name != "" && ZanIDE.Has(crypto, "|" + name + "|")) {
            return "System.Security.Cryptography";
        }
        if (name != "" && ZanIDE.Has(data, "|" + name + "|")) {
            return "System.Data";
        }
        if (name == "Process") { return "System.Diagnostics"; }
        return "";
    }

    static void AddUsing(
        CodeEditor editor,
        List<TabRecord> tabs,
        SignalInt active,
        string importNs,
        List<string> log
    ) {
        string line = "using " + importNs + ";";
        string text = editor.GetText();
        if (ZanIDE.Has(text, line)) {
            log.Add("> " + line + " is already present.");
            return;
        }
        int lastUsing = text.LastIndexOf("using ");
        if (lastUsing >= 0) {
            int endOfLine = text.IndexOf("\n", lastUsing);
            if (endOfLine >= 0) {
                text = text.Substring(0, endOfLine + 1) + line + "\n" + text.Substring(endOfLine + 1, text.Length - (endOfLine + 1));
            } else {
                text = text + "\n" + line;
            }
        } else {
            text = line + "\n" + text;
        }
        editor.LoadText(text);
        int a = active.Get();
        if (a >= 0 && a < tabs.Count) { tabs[a].body = text; }
        editor.SetCompilerDiagnostics(new List<Diagnostic>());
        log.Add("> Added " + line);
    }
}
