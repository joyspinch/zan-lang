using System;
using Gui;
using Gui.Widget;

/// EXAMPLES 面板：随发行版一起提供的示例工程树，双击在编辑器里打开示例
/// 源码，右键弹出面板自己的上下文菜单。
///
/// 界面在 `ExamplesPanel.zform` 里声明；这里只做数据绑定和事件接线。
partial class ExamplesPanel {
    List<TreeNode> shown;
    Input filter;

    void OnInit() {
        ExamplesPanel.Tree.EmptyText(ZanIDE.T("No examples found.", "没有找到示例。"));
        shown = new List<TreeNode>();
    }

    void Wire(SignalInt sel, Input f) {
        filter = f;
        ExamplesPanel.Tree.BindSel(sel).WithFilter(f);
        ExamplesPanel.Tree.OnActivate(ZanIDE.ExampleActivated);
        ExamplesPanel.Tree.OnContext(ZanIDE.ExampleContext);
    }

    List<TreeNode> Shown() { return shown; }

    TreeView Tree() { return ExamplesPanel.Tree; }

    void Render(App app, Rect area, List<TreeNode> nodes) {
        string q = "";
        if (filter != null) { q = filter.GetText(); }
        shown = ZanIDE.FilterNodes(nodes, q);
        ExamplesPanel.Tree.Bind(shown);
        this.RenderInside(app, area);
    }
}
