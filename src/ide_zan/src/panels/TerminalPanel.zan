using System;
using System.Collections.Generic;
using Gui;
using Gui.Widget;
using Gui.Component;

// 终端面板（TERMINAL）。
// 界面在 `TerminalPanel.html` 里声明：上面是填满面板的 ConsoleView
// （尾部滚动、可选择），最底下一行提示符 + 标准 Input。回车经
// Input.Submit 送出，命令写入交互 shell 管道（Process.ShellSend），
// 输出由后台 job（kind=1）轮询 term_session.log 回流到日志。
// shell 会话的生命周期归外壳：面板只发命令、显示日志。
partial class TerminalPanel {
    // 本帧用户按了回车（命令文本由外壳来取）。
    bool submitted;
    static TerminalPanel current;

    void OnInit() {
        submitted = false;
        TerminalPanel.current = this;
        this.Prompt.Text = ">";
        this.Cmd.Submit.Add(TerminalPanel.Entered);
    }

    static void Entered() {
        if (TerminalPanel.current != null) { TerminalPanel.current.submitted = true; }
    }

    // 输入框控件：外壳在会话打开时聚焦它，语言切换时刷新占位符。
    Input CmdBox() { return this.Cmd; }

    // 本帧是否按了回车；取走后归零。
    bool TakeSubmitted() {
        bool s = this.submitted;
        this.submitted = false;
        return s;
    }

    // 清空输入行（外壳取走命令后调用）。
    void ClearCmd() { this.Cmd.SetText(""); }

    // 用终端日志绘制面板；`focusCmd` 时把焦点交给输入行
    // （切换到该面板或点过日志后仍想继续敲命令）。
    void Render(App app, Rect area, List<string> log, bool focusCmd) {
        if (area == null || area.width <= 0 || area.height <= 0 || area.x <= -1000) { return; }
        int rowH = app.Scale(26);
        Rect logRect = new Rect(area.x, area.y, area.width, area.height - rowH);
        this.Log.Bind(log);
        this.RenderInside(app, area);
        if (focusCmd) { app.focus.SetFocused(this.Cmd.WidgetId()); }
    }
}
