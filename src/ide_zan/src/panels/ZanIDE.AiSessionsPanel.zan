using System;
using Gui;
using Gui.Widget;
using Gui.Component;

/// 核心契约与语义定义。
partial class ZanIDE {
    void AiRenderSessions(App app, Rect area) {
        int pad = app.Scale(6);
        List<string> titles = new List<string>();
        List<int> archives = new List<int>();
        for (int i = 0; i < aiSessions.Count; i = i + 1) {
            string title = aiSessions[i].title;
            if (title == "") { title = ZanIDE.AiSessTitleOf(aiSessions[i]); }
            if (title == "") { title = ZanIDE.T("New chat ", "新会话 ") + Convert.ToString(i + 1); }
            titles.Add(title);
            archives.Add(aiSessions[i].archived);
        }
        SessionListAction action = aiSessNav.RenderEx(app, area.x + pad, area.y + pad,
            area.width - pad * 2, area.height - pad * 2, titles, aiSessCur, archives);
        if (action.archived >= 0 || action.deleted >= 0 || action.renamed >= 0
            || action.created || action.selected >= 0 && action.selected != aiSessCur) {
            int version = this.AiSessionVersion();
            IdeAiSessionContext context = aiSessionContext;
            app.Post(delegate () {
                if (this.AiSessionMatches(context, version)) { this.ApplyAiSessionAction(action); }
            });
        }
    }

    void ApplyAiSessionAction(SessionListAction action) {
        if (aiSessions == null || aiSessCur < 0 || aiSessCur >= aiSessions.Count) { return; }
        if (aiBusy.Get() == 0 && action.archived >= 0 && action.archived < aiSessions.Count) {
            int index = action.archived;
            aiSessions[index].archived = aiSessions[index].archived == 0 ? 1 : 0;
            this.AiSessionChanged();
            this.SaveAiSessions();
            Layer.Msg(aiSessions[index].archived == 1
                ? ZanIDE.T("Chat archived", "会话已归档") : ZanIDE.T("Chat restored", "会话已恢复"), 3);
        } else if (aiBusy.Get() == 0 && action.deleted >= 0 && action.deleted < aiSessions.Count) {
            this.RememberAiSessionCurrent();
            int index = action.deleted;
            bool active = index == aiSessCur;
            int current = aiSessCur;
            if (aiSessions.Count > 1) {
                aiSessions.RemoveAt(index);
                aiSessionImages.RemoveAt(index);
                if (index < current) { current = current - 1; }
                if (current >= aiSessions.Count) { current = aiSessions.Count - 1; }
            } else {
                aiSessions[0].pack = "";
                aiSessions[0].derived = "";
                aiSessions[0].archived = 0;
                aiSessionImages[0] = IdeAiSessionImage.Empty();
                current = 0;
            }
            this.AiSessionChanged();
            this.UseAiSessionCurrent(current);
            if (active) { this.AiResetContextState(); }
            this.AiChatReset();
            aiSessNav.CancelRename();
            this.SaveAiSessions();
            Layer.Msg(ZanIDE.T("Chat and its context deleted", "会话及其上下文已删除"), 3);
        } else if (action.renamed >= 0 && action.renamed < aiSessions.Count) {
            aiSessions[action.renamed].title = CodeEditor.TrimStr(action.title);
            // 核心契约与语义定义。
            aiSaveSig = "";
            if (aiSessionPending) { aiSessionDrafts = true; }
            this.SaveAiSessions();
        } else if (aiBusy.Get() == 0 && action.created) {
            // 核心契约与语义定义。
            this.RememberAiSessionCurrent();
            aiSessions.Add(AiSession.Create("", 0));
            aiSessionImages.Add(IdeAiSessionImage.Empty());
            this.AiSessionChanged();
            this.UseAiSessionCurrent(aiSessions.Count - 1);
            this.AiResetContextState();
            this.AiChatReset();
            this.SaveAiSessions();
        } else if (aiBusy.Get() == 0 && action.selected >= 0 && action.selected < aiSessions.Count
            && action.selected != aiSessCur) {
            this.RememberAiSessionCurrent();
            this.AiSessionChanged();
            this.UseAiSessionCurrent(action.selected);
            this.AiChatReset();
            this.SaveAiSessions();
        }
        app.RequestRedraw();
    }
}
