using System;
using Gui;
using Gui.Widget;

/// STRUCTURE 面板：当前文件的符号大纲（或场景树）。
///
/// 界面在 `StructurePanel.zform` 里声明（一个填充面板的 TreeView，树自带
/// 筛选行和滚动），这里只做数据绑定和事件接线；宿主把 dock 分配的矩形
/// 交给 `Render`。
partial class StructurePanel {
    /// 当前显示的节点（已按筛选文本过滤），每帧重建一次。
    List<TreeNode> shown;
    Input filter;

    void OnInit() {
        StructurePanel.Tree.EmptyText(ZanIDE.T("No symbols", "无符号"));
        shown = new List<TreeNode>();
    }

    void Wire(SignalInt sel, Input f) {
        filter = f;
        StructurePanel.Tree.BindSel(sel).WithFilter(f);
        // 组件可以成组删除、拖动排序，所以树按多选 + 可排序开：右键
        // 菜单与真正的模型改动都在 ZanIDE.StructurePanel.zan 那侧。
        StructurePanel.Tree.WithMultiSelect().WithReorder();
        StructurePanel.Tree.OnSelect(ZanIDE.StructurePicked);
        StructurePanel.Tree.OnContext(ZanIDE.StructureContext);
        StructurePanel.Tree.OnMove(ZanIDE.StructureMoved);
    }

    List<TreeNode> Shown() { return shown; }

    TreeView TreeCtl() { return StructurePanel.Tree; }

    void Render(App app, Rect area, List<TreeNode> nodes) {
        string q = "";
        if (filter != null) { q = filter.GetText(); }
        shown = ZanIDE.FilterNodes(nodes, q);
        StructurePanel.Tree.Bind(shown);
        this.RenderInside(app, area);
    }
}
