using System;
using System.IO;
using System.Diagnostics;
using Gui;
using Gui.Widget;
using Gui.Component;

/// 小赞（AI 助手）面板的宿主侧：本帧数据、需要即时绘制的内容
/// （会话列表、任务计划、发给谁提示行、用量卡）以及设计里那些
/// `onClick` 背后的行为。
///
/// 聊天记录本身是标准库组件 `Gui.Component.ChatView`：换行缓存、折叠、
/// 选区复制、滚轮与 busy 行都在组件里，这里只绑消息与状态。
///
/// 界面骨架在 `panels/AiPanel.zform` 里声明，控件的显示 / 隐藏与本帧
/// 尺寸由 `AiPanel.Prepare(...)` 一次性交出去；这里不再手算任何按钮
/// 或输入框的矩形。
partial class ZanIDE {
    /// 画一帧小赞面板。`rp` 是 dock 交给 "ai" 面板的矩形（隐藏时停在
    /// 屏幕外，所以这里不判断可见性）。
    void RenderAiPanel(App app, Rect rp) {
        int rPad = app.Scale(6);
        int act = activeTab.Get();

        // ---- 模型下拉：一个下拉列出每个 profile 的模型，写成
        // "<服务商> / <模型>"，所以两家提供同一个模型 id 也能分清；
        // 选中一项同时切换启用的服务商和本会话的聊天模型。
        string aiSelSig = "";
        for (int pfi = 0; pfi < aiProfiles.Count; pfi = pfi + 1) {
            AiProfile profile = aiProfiles[pfi];
            aiSelSig = aiSelSig + profile.name + "~" + profile.model + "~"
                + profile.models + "~" + profile.limits + ";;";
        }
        if (aiModelSelSig != aiSelSig) {
            // 候选由 ZanIDE.AiModelOptions 统一构造（默认模型在前、去重、
            // 去掉在 AI 设置里取消勾选的），AI 设置里的助手模型下拉用的
            // 是同一个来源，所以两处永远一致。
            aiModelOptions = ZanIDE.AiModelOptions(aiProfiles);
            // 设置窗口可能在两帧之间换掉整份 profile 列表：先把启用
            // 索引夹回有效范围，再做任何预选解引用。
            if (aiProfActive < 0 || aiProfActive >= aiProfiles.Count) {
                aiProfActive = 0;
            }
            string activeDefaultModel = "";
            if (aiProfiles.Count > 0) {
                AiProfile activeProfile = aiProfiles[aiProfActive];
                if (activeProfile != null) {
                    activeDefaultModel = activeProfile.model;
                }
            }
            // 预选启用 profile 的默认模型。
            int pre = 0 - 1;
            for (int oi = 0; oi < aiModelOptions.Count; oi = oi + 1) {
                ModelOption opt = aiModelOptions[oi];
                if (opt.profile == aiProfActive
                    && opt.model == activeDefaultModel) {
                    pre = oi; break;
                }
            }
            if (pre < 0 && aiModelOptions.Count > 0) {
                for (int oj = 0; oj < aiModelOptions.Count; oj = oj + 1) {
                    if (aiModelOptions[oj].profile == aiProfActive) {
                        pre = oj; oj = aiModelOptions.Count;
                    }
                }
            }
            aiModelSel = new Dropdown<ModelOption>(o => o.label);
            aiModelSel.Class = "ai-row";
            aiModelSel.Hint(ZanIDE.T("Provider / model", "服务商 / 模型"));
            aiModelSel.Bind(aiModelOptions);
            if (pre >= 0) { aiModelSel.SelectIndex(pre); }
            aiModelSelSig = aiSelSig;
            // 下拉是按签名重建的实例，所以每次重建都要重新挂进
            // 设计里的宿主格子。
            aiPanel.SetModelSelect(aiModelSel);
        }

        // 生效的服务商 + 模型：下拉的选择同时切换启用的 profile，所以
        // 下面的 base URL / key 跟着选中的服务商走；没有选择时用启用
        // profile 的默认模型。
        ModelOption selMi = aiModelSel.Selected();
        if (selMi != null && selMi.profile >= 0
                && selMi.profile < aiProfiles.Count) {
            aiProfActive = selMi.profile;
        }
        // aiProfActive 可能在删改配置后落到越界值；越界索引会返回 null，
        // 随后 .model/.limits 解引用崩溃。先夹取到有效范围。
        if (aiProfActive < 0 || aiProfActive >= aiProfiles.Count) {
            aiProfActive = 0;
        }
        string chatModel = "";
        string aiLimMap = "";
        if (aiProfiles.Count > 0) {
            AiProfile aiProf = aiProfiles[aiProfActive];
            if (aiProf != null) {
                chatModel = aiProf.model;
                aiLimMap = aiProf.limits;
                // 每个成员跑在哪个模型上，取自生效的服务商：在这里读
                // 意味着换服务商（或保存设置）会把整个团队一起搬过去。
                AiTeam.SetModels(aiProf.roles);
                AiTeam.SetPrompts(aiRolePrompts);
            }
        }
        if (selMi != null) { chatModel = selMi.model; }
        aiChatModel = chatModel;
        // 把整张限额表（模型 -> 上下文 / 输出上限）和聊天框选中的模型交给
        // agent 层：团队里每个成员各跑自己的模型，所以压缩预算、用量环和请求
        // 的 max_tokens 都必须按「那一次发请求的模型」去查这张表，而不是全队
        // 共用聊天框这一个模型的数字。没配过的模型用默认上下文长度。
        AiAgent.SetProvider(aiLimMap, chatModel);

        // ---- 本帧的可变尺寸 ----
        // 会话栏：太窄的停靠位直接收起它，好让聊天保持可用宽度。
        int aiSideW = app.Scale(154);
        if (aiSideW > rp.width - app.Scale(150)) { aiSideW = 0; }
        int aiBodyW = rp.width - aiSideW;
        if (aiSideW > 0) { aiBodyW = aiBodyW - 1; }
        // 团队模式在输入框上方加一条细提示行，说明这条消息将发给谁。
        int aiCueH = 0;
        if (aiTeamMode) { aiCueH = SendCue.HeightOf(app); }
        // 团队条自己拥有「单人 / 团队」开关，所以模式永远只差一次点击；
        // 条子自己量高度（声明的控件树），宿主只送状态。
        // 任务图跟着打开的项目走：换项目就换图，图变了就落盘，聊天里
        // 新增的话追加到它所属节点的上下文。
        this.AiGraphTick();
        aiPanel.TeamStrip().Sync(aiTeamMode, aiBusy.Get() == 1, aiTeamSt,
            aiTasks, aiTeamOpen, aiGraphSel,
            aiTeamSt.activeTask, this.AiGraphLive(aiTeamSt.activeTask),
            this.AiGraphRunning());
        // 「跑到哪了」+ 任务计划：带子自己量高度（声明的控件树），
        // 宿主只把这次交付和计划交给它。
        PlanStrip aiBand = aiPanel.PlanBand();
        // 进度以任务图为主：拆出来的节点做完了几个才是「需求做到哪了」，
        // 十二拍只是当前节点内部的细节。
        // 状态条上的「当前节点」说的是谁在被执行，所以它只能来自状态机。点开
        // 一个节点只是切它自己的上下文（`aiGraphSel`），不代表它在跑；拿选中项
        // 当执行节点，就是「没有进行的任务却写着执行中」的由来。
        // 团队状态机的活动节点在前：单人模式下没有活动节点，才拿这次交付自己
        // 的编号（T1、T2……由 aiRunSeq 发）当标题。
        string aiCurTask = aiTeamSt.activeTask;
        if (aiCurTask == "" && aiRun != null) { aiCurTask = aiRun.taskId; }
        // 团队模式下这条计划是「当前这个节点自己的活」：图上一个节点是一块功能
        // （前台商品展示、积分兑换……），要干的活在节点里边。看哪个节点就看它
        // 那份活（没在执行时看的是选中的那个），所以图和计划说的是同一件事。
        List<AiPlanStep> aiBandPlan = aiPlan;
        string aiBandTag = "";
        if (aiTeamMode) {
            string aiPlanNode = aiCurTask;
            if (aiPlanNode == "") { aiPlanNode = aiGraphSel; }
            AiTask aiPlanTask = AiTeam.TaskOf(aiTasks, aiPlanNode);
            if (aiPlanTask != null) {
                aiBandPlan = AiTaskPlan.ItemsOf(aiPlanTask);
                aiBandTag = aiPlanNode;
            } else {
                aiBandPlan = new List<AiPlanStep>();
            }
        }
        int aiPlanH = aiBand.HeightOf(app, aiRun, aiTasks, aiBandPlan);
        aiBand.Sync(app, aiRun, aiTasks, aiCurTask, aiBandPlan,
            aiBusy.Get() == 1, aiBandTag);
        // 「插入代码」/「替换整文件」：把最后一段 AI 代码写到光标处或
        // 整个文件；没有可用代码（或当前不是可写文件）就不占那一行。
        string aiCode = this.AiLastCodeCached();
        bool aiCanApply = aiCode != "" && act >= 0 && act < tabs.Count
            && !designerMode && tabs[act].path != ""
            && tabs[act].path.Substring(0, 1) != "@";
        int aiApplyH = 0;
        if (aiCanApply) { aiApplyH = app.Scale(34); }
        // 自动执行开关：窄面板下只留短标签，不挤输入框。
        string aiAutoText = aiAutoExec ? ZanIDE.T("Auto: on", "自动:开")
            : ZanIDE.T("Auto: off", "自动:关");
        if (aiBodyW < app.Scale(240)) {
            aiAutoText = aiAutoExec ? ZanIDE.T("A:on", "自:开")
                : ZanIDE.T("A:off", "自:关");
        }
        if (aiCueH > 0) {
            // 收件人先回读、再铺进控件：下拉的选中变化是在覆盖层里发生的（这一帧
            // 更靠后），所以必须在 Sync 之前把它取走。反过来的话 Sync 会先按旧的
            // aiSendTo 把选中项按回去，用户怎么点都换不了人。
            if (aiTeamMode && aiPanel.CueRow().TakeChanged()) {
                aiSendTo = aiPanel.CueRow().Recipient();
                app.RequestRedraw();
            }
            // 自动模式下徽标显示当前解析到的成员，所以路由在这里算一次。
            aiPanel.CueRow().Sync(aiSendTo,
                AiTeam.RouteUserSt(aiPanel.PromptBox().GetText(), aiMsgs,
                    aiTeamSt));
        }
        // 上下文用量环（头部最右侧那一格）：环、卡片、悬停和钉住都归
        // 控件，外壳只算这一帧的数字。
        this.AiSyncCtxRing();
        aiPanel.Prepare(aiSideW, aiPlanH, aiCueH, aiApplyH,
            aiBusy.Get(), aiAutoExec, aiAutoText);
        if (aiBusy.Get() == 2) {
            // 确认栏：说明被挂起的那个动作，让用户批准（执行）或拒绝
            // （让模型换个做法）。等待期间什么都没跑。
            aiPanel.SetPending(ZanIDE.T("Run ", "执行 ")
                + AiAgent.Describe(aiPendingCall) + " ?");
        }

        // 画界面：按钮的点击在这一步派发到下面那些处理器。
        aiPanel.Render(app, rp);

        // ---- 会话栏：可搜索的会话列表；切换 / 新建 / 归档 / 删除都
        // 从这里驱动，下面的面板只渲染当前会话。
        if (aiSideW > 0) { this.AiRenderSessions(app, aiPanel.SidebarRect()); }

        // ---- 团队条：开关在绘制时处理点击，所以模式在这里回读 ----
        bool aiTeamWas = aiTeamMode;
        aiTeamMode = aiPanel.TeamStrip().TeamOn();
        if (aiTeamMode != aiTeamWas) {
            // 换模式会改变每一行名字的归属，所以换行缓存要重建。
            this.AiChatInvalidate();
            if (!aiTeamMode) { aiRunAgent = ""; }
            app.RequestRedraw();
        }

        // ---- 任务图：选中就是切这个节点自己的多角色多轮上下文，双击
        // 是开工，双击锁住的节点要一个解释 ----
        TeamBoard aiStrip = aiPanel.TeamStrip();
        string aiPicked = aiStrip.TakePicked();
        string aiStarted = aiStrip.TakeStarted();
        string aiBlockedNode = aiStrip.TakeBlocked();
        // 右键：菜单和文件树 / 标签页的右键菜单同一套，由外壳在这一帧的
        // 最上层画（ctxKind == 7），这里只记下是哪个节点。
        string aiCtxNode = aiStrip.TakeContext();
        if (aiCtxNode != "") {
            ctxKind = 7;
            ctxTaskId = aiCtxNode;
            ctxX = aiStrip.CtxX();
            ctxY = aiStrip.CtxY();
            app.RequestRedraw();
        }
        if (aiStrip.TakeBackProject()) {
            // 回项目级对话：节点上下文和项目对话各存一份，来回切都不丢。
            this.AiGraphOpen("");
            app.RequestRedraw();
        } else if (aiStarted != "") {
            this.AiGraphStart(aiStarted);
            app.RequestRedraw();
        } else if (aiBlockedNode != "") {
            this.AiGraphBlocked(aiBlockedNode);
            app.RequestRedraw();
        } else if (aiPicked != "") {
            this.AiGraphOpen(aiPicked);
            app.RequestRedraw();
        }

        // ---- 任务计划：清空由带子上的按钮给出，计划归外壳所有 ----
        if (aiBand.TakeClear()) {
            // 团队模式下这条计划是某个节点自己的活，清空它就是清空那个节点的
            // 清单（进度跟着回落）；全局那份只属于单人模式。
            if (aiBandTag != "") {
                AiTask aiClr = AiTeam.TaskOf(aiTasks, aiBandTag);
                if (aiClr != null) { aiClr.items = new List<AiPlanStep>(); }
            } else {
                aiPlan = new List<AiPlanStep>();
            }
            app.RequestRedraw();
        }

        // ---- 本轮改动文件：双击清单里的一行就在编辑器里打开它，
        // 免得为了看小助手改了什么去文件树里翻。
        string aiOpenChanged = aiBand.TakeOpen();
        if (aiOpenChanged != "") {
            string aiCp = aiOpenChanged;
            if (!File.Exists(aiCp) && root != "") {
                aiCp = root + "/" + aiOpenChanged;
            }
            if (File.Exists(aiCp)) {
                ZanIDE.OpenPath(tabs, activeTab, aiCp,
                    Path.GetFileName(aiCp));
                lastActive = 0 - 1;
                app.RequestRedraw();
            }
        }

        // ---- 聊天记录：组件自己排版、滚动、折叠与复制 ----
        aiPanel.Transcript().Bind(aiMsgs);
        aiPanel.Transcript().SetBusy(aiBusy.Get() == 1);

        // 自动执行开关真正决定的是「谁有权跑操作类工具」，所以把它说
        // 清楚，而不是在输入框前面留一个没头没尾的 "Auto"。
        Rect aiAuto = aiPanel.AutoRect();
        if (aiAuto.Contains(app.mouseX, app.mouseY)) {
            Tooltip.RequestBox(app, aiAuto.x, aiAuto.y, aiAuto.width,
                aiAuto.height, ZanIDE.T(
                "Auto-execute action tools.\n"
                + "OFF: the assistant asks you to approve every"
                + " write_file / edit_file / build / run / ui_check /"
                + " ui_tree / diff / run_errors.\n"
                + "ON: it edits, builds and runs on its own, and keeps"
                + " working through the task plan without waiting.",
                "自动执行操作类工具。\n"
                + "关：写文件 / 改文件 / 构建 / 运行 / UI 检查"
                + "每次都要你点“批准”。\n"
                + "开：助手自行修改、构建、运行，并按任务计划持续推进。"),
                Tooltip.Top(), app.Scale(320));
        }

        // 回车发送，Shift+回车换行。输入框自己处理这个按键（它是真正的
        // 多行编辑器），所以刚插入的换行会在发送时被 Trim 掉。
        if (app.EventKind() == 6 && app.window.EventKeyCode() == 13
            && !Modifiers.HasShift(app.window.EventMods())
            && aiBusy.Get() == 0
            && app.focus.IsFocused(aiPanel.PromptBox().Id())) {
            ZanIDE.AiSendClicked();
        }

        // 从文件管理器拖到面板上的文件，按项目相对路径追加到提示里；
        // 内容由助手用 read_file 工具自己读，不在这里粘贴进去。
        if (app.EventKind() == 9) {
            List<string> drops = app.window.TakeDroppedFiles();
            int dqx = app.window.EventX();
            int dqy = app.window.EventY();
            if (drops.Count > 0 && rp.Contains(dqx, dqy)) {
                string add = "";
                for (int di = 0; di < drops.Count; di = di + 1) {
                    add = add + " " + AiDropRef(drops[di], root);
                }
                TextArea box = aiPanel.PromptBox();
                string cur = box.GetText();
                if (cur != "" && cur.Substring(cur.Length - 1, 1) != " ") {
                    cur = cur + " ";
                }
                box.SetText(cur + AiAgent.Trim(add) + " ");
                app.RequestRedraw();
            }
        }
    }

    /// 会话列表（左栏）：标题取用户改过的名字，否则取第一条用户消息。
    /// 最后一段 AI 代码，按「轮数 + 尾条长度」缓存。取它要在最后那条回答上
    /// 找围栏并切出中间那段，一条几十 KB 的长回答每帧复制一次就是白烧 CPU，
    /// 而它只在那条回答变长时才会变。
    string AiLastCodeCached() {
        string sig = Convert.ToString(aiMsgs.Count);
        if (aiMsgs.Count > 0) {
            ChatMessage tail = aiMsgs[aiMsgs.Count - 1];
            sig = sig + ":" + Convert.ToString(tail.text.Length)
                + ":" + tail.role;
        }
        if (sig != aiCodeSig) {
            aiCodeSig = sig;
            aiCodeVal = ZanIDE.AiLastCode(aiMsgs);
        }
        return aiCodeVal;
    }

    /// 换行缓存失效（文案、字号、团队模式或主题变了）：下一帧整份重排。
    void AiChatInvalidate() {
        if (aiPanel != null) { aiPanel.Transcript().Invalidate(); }
    }

    /// 换掉整份记录（新建 / 切换 / 删除会话）：缓存、折叠、选区与滚动
    /// 一起归零，否则新会话会带着上一份的展开项和高亮。
    void AiChatReset() {
        // 上一份会话的节点留档不能跟着新会话走：它们属于那份记录，留着就是
        // 切到同名节点时看到别的会话说过的话。
        aiCtxKeys = new List<string>();
        aiCtxMem = new List<List<ChatMessage>>();
        aiGraphSel = "";
        aiCtxSaved = aiMsgs.Count;
        // 换会话就换了一张图：留着上一份的图状态，下一次请求会带着别的会话
        // 的节点去问。
        aiGraphSig = "";
        AiTeam.SetBoard(AiTeam.BoardBrief(aiTasks, ""));
        // 上一份记录折出来的那份摘要说的是上一段对话：留着它，新会话第一次
        // 压缩就会把别人的历史当成自己的前情摘要发出去。
        AiAgent.ResetCompaction();
        if (aiPanel != null) { aiPanel.Transcript().Reset(); }
    }

    /// 贴回最新一行（新消息进来时）。
    void AiChatToEnd() {
        if (aiPanel != null) { aiPanel.Transcript().Scroll().Set(0); }
    }

    /// 本帧的上下文 / 用量数字：正在跑的对话相对压缩预算的开销，以及本次
    /// IDE 会话的请求与 token 总量。只在这里组装数字 —— 环、卡片、卡片
    /// 里的行和那段会自动换行的说明都由控件自己画。
    void AiSyncCtxRing() {
        // 上下文是按成员分开的：每个成员只带自己那一份对话
        // （`AiTeam.ContextFor`），而且各按自己绑的那个模型的窗口压缩。所以
        // 环上显示的必须是「这一轮在说话的那个成员」的用量与它自己的上限，
        // 底下再逐个成员列一行——把整条聊天记录对着聊天框那个模型的窗口算，
        // 显示的和真正发出去的根本不是一回事。
        string who = aiRunAgent;
        if (!aiTeamMode) { who = ""; }
        List<ChatMessage> mine = aiMsgs;
        if (who != "") { mine = AiTeam.ContextFor(who, aiMsgs); }
        string myModel = "";
        if (who != "") { myModel = AiTeam.ModelOf(who); }
        int used = AiAgent.ContextChars(mine);
        int budget = AiAgent.MaxContextCharsOf(myModel);
        int pct = 0;
        if (budget > 0) { pct = used * 100 / budget; }
        int comp = AiAgent.CompactionsOf(who);
        int allChars = AiAgent.ContextChars(aiMsgs);
        // Nothing here changes between frames unless one of these numbers did,
        // and the control keeps the lists it was handed. Rebuilding a dozen
        // cards (and their strings) every frame while an answer streams is
        // pure garbage the collector then has to walk.
        string sig = Convert.ToString(used) + ":" + Convert.ToString(budget)
            + ":" + Convert.ToString(comp)
            + ":" + Convert.ToString(AiAgent.LastDroppedOf(who))
            + ":" + who + ":" + myModel
            // 逐个成员那几行要重算就得给每个人过一遍 ContextFor（O(成员 × 对话)）,
            // 所以整条聊天记录的字数进签名：它不动，谁的那份也不会动。
            + ":" + Convert.ToString(allChars)
            + ":" + Convert.ToString(aiMsgs.Count)
            + ":" + Convert.ToString(ZanIDE.aiStatReqs)
            + ":" + Convert.ToString(ZanIDE.aiStatFails)
            + ":" + Convert.ToString(ZanIDE.aiStatUsageReplies)
            + ":" + Convert.ToString(ZanIDE.aiStatPrompt)
            + ":" + Convert.ToString(ZanIDE.aiStatCompletion)
            + ":" + Convert.ToString(ZanIDE.aiStatCached)
            + ":" + Convert.ToString(ZanIDE.aiStatTotal)
            + ":" + Convert.ToString(aiTokPrompt)
            + ":" + Convert.ToString(aiTokCompletion)
            + ":" + Convert.ToString(aiTokTotal)
            + ":" + Convert.ToString(ZanIDE.uiLang);
        if (sig == aiRingSig) { return; }
        aiRingSig = sig;
        List<UsageStat> ctx = new List<UsageStat>();
        // 这一份用量是谁的：团队模式下不写出来的话，同一个环会在成员之间跳来
        // 跳去，看着像统计错了。
        if (who != "") {
            string whoTxt = AiTeam.DisplayName(who);
            if (myModel != "") { whoTxt = whoTxt + " · " + myModel; }
            ctx.Add(UsageStat.Of(ZanIDE.T("Member", "当前成员"), whoTxt));
        }
        ctx.Add(UsageStat.Of(ZanIDE.T("Used", "已使用"),
            Convert.ToString(used) + " " + ZanIDE.T("chars", "字符")));
        // The budget is measured in CHARACTERS (the transcript is not
        // tokenized locally); the model's configured limit is in tokens, so
        // both are shown with the ~4 chars/token conversion that derives one
        // from the other.
        ctx.Add(UsageStat.Of(ZanIDE.T("Budget", "上限"),
            Convert.ToString(budget) + " " + ZanIDE.T("chars", "字符")
            + " ≈ " + Convert.ToString(budget / 4) + " token"));
        ctx.Add(UsageStat.Of(ZanIDE.T("Filled", "占用"),
            Convert.ToString(pct) + "%"));
        // Compaction is why the window never fills up: past the budget the
        // oldest turns are replaced by a digest before the request is sent,
        // while the transcript on screen keeps every turn.
        ctx.Add(UsageStat.Flag(ZanIDE.T("Compacted", "已压缩"),
            comp == 0
                ? ZanIDE.T("never", "未发生")
                : Convert.ToString(comp) + " "
                    + ZanIDE.T("requests", "次请求"),
            comp > 0));
        // 团队模式：每个成员一行「占用% · 已用/上限」，各自按自己那个模型的
        // 窗口算。谁快满了、谁已经在压缩，在这里一眼看得见。
        if (aiTeamMode) {
            List<AiRole> rrs = AiTeam.Roles();
            for (int ri = 0; ri < rrs.Count; ri = ri + 1) {
                string rid = rrs[ri].id;
                int rused = AiAgent.ContextChars(
                    AiTeam.ContextFor(rid, aiMsgs));
                if (rused == 0) { continue; }
                int rbud = AiAgent.MaxContextCharsOf(AiTeam.ModelOf(rid));
                int rpct = 0;
                if (rbud > 0) { rpct = rused * 100 / rbud; }
                string rtxt = Convert.ToString(rpct) + "% · "
                    + Convert.ToString(rused) + " / " + Convert.ToString(rbud);
                int rcomp = AiAgent.CompactionsOf(rid);
                if (rcomp > 0) {
                    rtxt = rtxt + ZanIDE.T(" · compacted x", " · 压缩 ")
                        + Convert.ToString(rcomp);
                }
                ctx.Add(UsageStat.Flag(ZanIDE.T(rrs[ri].en, rrs[ri].zh),
                    rtxt, rid == who));
            }
        }
        string note = "";
        if (comp > 0) {
            note = ZanIDE.T("Older turns are sent as a digest",
                    "较早的对话以摘要形式发送")
                + ZanIDE.T(" (last fold: ", "（上次折叠 ")
                + Convert.ToString(AiAgent.LastDroppedOf(who))
                + ZanIDE.T(" turns; the chat above keeps them all).",
                    " 条；上方对话仍完整保留）。");
        }
        // Token counts only exist for replies whose provider reported usage;
        // say so rather than showing a zero that looks like a real number.
        string inTok = ZanIDE.T("no data", "无数据");
        string outTok = inTok;
        string cacheTok = inTok;
        string totTok = inTok;
        if (ZanIDE.aiStatUsageReplies > 0) {
            inTok = Convert.ToString(ZanIDE.aiStatPrompt);
            outTok = Convert.ToString(ZanIDE.aiStatCompletion);
            totTok = Convert.ToString(ZanIDE.aiStatTotal);
            cacheTok = Convert.ToString(ZanIDE.aiStatCached);
            if (ZanIDE.aiStatPrompt > 0) {
                cacheTok = cacheTok + " ("
                    + Convert.ToString(ZanIDE.aiStatCached * 100
                        / ZanIDE.aiStatPrompt) + "%)";
            }
        }
        List<UsageStat> ses = new List<UsageStat>();
        ses.Add(UsageStat.Of(ZanIDE.T("Requests", "请求次数"),
            Convert.ToString(ZanIDE.aiStatReqs)));
        ses.Add(UsageStat.Flag(ZanIDE.T("Failed", "失败次数"),
            Convert.ToString(ZanIDE.aiStatFails), ZanIDE.aiStatFails > 0));
        ses.Add(UsageStat.Of(ZanIDE.T("Input tokens", "输入 token"), inTok));
        ses.Add(UsageStat.Of(ZanIDE.T("Output tokens", "输出 token"), outTok));
        ses.Add(UsageStat.Of(ZanIDE.T("Cached input", "缓存命中"), cacheTok));
        ses.Add(UsageStat.Of(ZanIDE.T("Total tokens", "合计 token"), totTok));
        if (aiTokTotal > 0 || aiTokPrompt > 0) {
            ses.Add(UsageStat.Of(ZanIDE.T("Last reply", "上次回复"),
                Convert.ToString(aiTokPrompt) + " + "
                + Convert.ToString(aiTokCompletion) + " = "
                + Convert.ToString(aiTokTotal)));
        }
        aiPanel.RingCtl().Sync(pct, ctx, ses, note);
    }

    // ---- 设计里的处理器（panels/AiPanel.zform 的 onClick）----

    /// 统一的 AI 配置窗口（和编辑器设置一样是独立子窗口）。
    static void AiOpenSettings() {
        ZanIDE ide = ZanIDE.current;
        if (ide == null) { return; }
        // Only ask for it: the window is created by the main loop (see
        // aiCfgPending), never from inside this frame's event dispatch.
        if (ide.aiWindow == null || !ide.aiWindow.IsOpen()) {
            ide.aiCfgPending = true;
        }
        ide.app.RequestRedraw();
    }

    /// 「AI 接入」：把 AI 接入文件装进当前打开的项目（AGENTS.md、
    /// .agents\skills\、.mcp.json、.cursor\mcp.json、.vscode\mcp.json），
    /// 让 Cursor / Claude Code / Copilot / Windsurf 直接连上本 SDK 的 MCP
    /// 服务。装的是项目目录而不是 IDE 安装目录：这些文件只在你写代码的
    /// 那个工程里才有意义。
    ///
    /// 走的就是命令行的那条路径（zan-mcp --init-agent），所以两种入口的
    /// 行为一致，占位符也由同一份代码展开。已存在的文件保留不覆盖。
    static void AiInitAgentClicked() {
        ZanIDE ide = ZanIDE.current;
        if (ide == null) { return; }
        if (ide.root == "" || !Directory.Exists(ide.root)) {
            ide.aiMsgs.Add(ChatMessage.Create("error", ZanIDE.T(
                "Open a project first: the AI access files are installed into"
                + " the project you are working on, not into the SDK folder.",
                "请先打开一个项目：AI 接入文件装进你正在开发的项目目录，"
                + "而不是 IDE 的安装目录。")));
            ide.AiChatToEnd();
            ide.app.RequestRedraw();
            return;
        }
        string exe = ZanIDE.McpServerExe();
        if (exe == "") {
            ide.aiMsgs.Add(ChatMessage.Create("error", ZanIDE.T(
                "zan-mcp is missing from this installation (expected"
                + " tools\\zan-mcp" + ZanIDE.ExeSuffix() + ").",
                "本安装缺少 zan-mcp（应在 tools\\zan-mcp"
                + ZanIDE.ExeSuffix() + "）。")));
            ide.AiChatToEnd();
            ide.app.RequestRedraw();
            return;
        }
        // 同步跑：只是复制几个模板文件，比一次保存还快，用捕获输出把
        // 「写了什么 / 保留了什么」原样报给用户。
        ProcessResult r = Process.Capture("\"" + exe + "\" --init-agent \""
            + ide.root + "\"");
        string text = r.Text();
        ide.log.Add(ZanIDE.T("> AI access: ", "> AI 接入：") + exe
            + " --init-agent " + ide.root);
        ide.log.Add(text);
        if (r.Ok()) {
            ide.aiMsgs.Add(ChatMessage.Create("tool", ZanIDE.T(
                "AI access enabled for ", "已为项目启用 AI 接入：")
                + ide.root + "\n" + text + "\n"
                + ZanIDE.T("Open this project in your AI editor; it launches"
                    + " the Zan MCP server itself and should call"
                    + " zan_start_here first.",
                    "在 AI 编辑器里打开该项目即可：它会自己启动 Zan MCP"
                    + " 服务，并应先调用 zan_start_here。")));
        } else {
            ide.aiMsgs.Add(ChatMessage.Create("error", ZanIDE.T(
                "Could not install the AI access files:\n",
                "AI 接入文件安装失败：\n") + text));
        }
        ide.AiChatToEnd();
        ide.app.RequestRedraw();
    }

    /// 自动执行：关 = 每个操作类工具都先问；开 = 循环自己改、构建、运行。
    static void AiAutoToggled() {
        ZanIDE ide = ZanIDE.current;
        if (ide == null) { return; }
        ide.aiAutoExec = !ide.aiAutoExec;
        ide.app.RequestRedraw();
    }

    /// 发送：把提示框里的话作为一轮用户输入交给（团队模式下被寻址的）
    /// 成员，并附上当前文件作为上下文。
    static void AiSendClicked() {
        ZanIDE ide = ZanIDE.current;
        if (ide == null || ide.aiBusy.Get() != 0) { return; }
        App app = ide.app;
        TextArea box = ide.aiPanel.PromptBox();
        string q = AiAgent.Trim(box.GetText());
        box.SetText("");
        // 团队里没有的 @名字 是打字错误，把消息投给默认收件人正是问题
        // 悄悄发错人的原因。说清楚，并把文字留下来好改。
        string badAt = "";
        if (ide.aiTeamMode && q != "") { badAt = AiTeam.UnknownMention(q); }
        if (badAt != "") {
            box.SetText(q);
            ide.aiMsgs.Add(ChatMessage.Create("error", ZanIDE.T(
                "[error] Nobody on the team is called @" + badAt
                    + ". Members: " + AiTeam.NameList() + ".",
                "[错误] 团队里没有 @" + badAt + " 这个成员。可用成员："
                    + AiTeam.NameList() + "。")));
            ide.AiChatToEnd();
            app.RequestRedraw();
            return;
        }
        if (q == "") { return; }
        // 团队模式：提示行里选中的成员就是地址；「自动」时被挂起的问题
        // 由问它的人回答，于是「继续」接着停下的那一拍，否则由最后
        // 说话的成员接手。
        string tgt = "";
        bool wasAsked = false;
        if (ide.aiTeamMode) {
            if (ide.aiSendTo != "") { tgt = ide.aiSendTo; }
            else { tgt = AiTeam.RouteUserSt(q, ide.aiMsgs, ide.aiTeamSt); }
            wasAsked = ide.aiTeamSt.awaitingUser;
            ide.aiTeamSt.awaitingUser = false;
            ide.aiTeamSt.askedBy = "";
        }
        // 执行节点由「在这个节点上真的发了话」给出，不由「点开看了一眼」给出。
        //
        // 在项目对话里发话（没选节点）而且上一次交付已经收尾，就把执行节点卸
        // 掉：让它挂在上一个节点上，接下来这段话会被算进那个节点的进度里。回答
        // 被挂起的提问是例外——那句话本来就是那个节点在等的东西。
        if (ide.aiTeamMode) {
            if (ide.aiGraphSel != "") {
                ide.aiTeamSt.activeTask = ide.aiGraphSel;
                ide.AiRunForTask(ide.aiGraphSel);
            } else if (!wasAsked
                && (ide.aiRun == null || ide.aiRun.Finished())) {
                ide.aiTeamSt.activeTask = "";
            }
        }
        ide.aiRunAgent = tgt;
        // 新一轮开始前，上一轮流式显示剩下的东西一律作废（停止、报错、
        // 切会话那几条路径都可能留下一半）。这里不删气泡：当时那条已经
        // 是记录的一部分，只把下标和解析状态归零。
        ide.AiStreamDrop(false);
        ChatMessage umsg = ChatMessage.Create("user", q);
        umsg.to = tgt;
        ide.aiMsgs.Add(umsg);
        // 这句话推进十二拍状态机：新需求开一次交付，停在「用户确认」
        // 那一拍的老交付被它放行。
        ide.AiRunUserTurn(q);
        // 新问题会重启每一个自动循环，包括交接链的预算。
        ide.aiRetry = 0;
        ide.aiAutoCont = 0;
        ide.aiHandoffs = 0;
        // 用户又说了一句话：这一问该查什么、谁在原地空转都重新算。
        ide.AiForgetTools();
        ide.aiIdleKey = "";
        ide.aiIdleTimes = 0;
        ide.aiEscKey = "";
        // 把当前文件作为上下文附上，助手才能帮到屏幕上这段代码。
        string aiCtxName = "";
        string aiCtxCode = "";
        int act = ide.activeTab.Get();
        if (act >= 0 && act < ide.tabs.Count && ide.tabs[act].body != ""
            && ide.tabs[act].body.Substring(0, 1) != "@") {
            aiCtxName = Path.GetFileName(ide.tabs[act].path);
            if (ZanIDE.IsFormPath(ide.tabs[act].path)) {
                aiCtxCode = ide.tabs[act].body;
            } else {
                aiCtxCode = ide.editor.GetText();
            }
        }
        ide.aiRunModel = ide.aiChatModel;
        ide.aiRunCtxName = aiCtxName;
        ide.aiRunCtxCode = aiCtxCode;
        string aerr = ZanIDE.AiLaunchAs(ide.aiRunAgent, ide.aiMsgs,
            aiCtxName, aiCtxCode, ide.root,
            ide.aiProfiles[ide.aiProfActive].baseUrl,
            ide.aiProfiles[ide.aiProfActive].key, ide.aiChatModel);
        if (aerr != "") { ide.aiMsgs.Add(ChatMessage.Create("error", aerr)); }
        else { ide.aiBusy.Set(1); }
        ide.AiChatToEnd();
        app.RequestRedraw();
    }

    /// 停止：丢掉正在流式输出的子进程并清空续跑预算，好中断一个跑偏
    /// 的任务。
    static void AiStopClicked() {
        ZanIDE ide = ZanIDE.current;
        if (ide == null || ide.aiBusy.Get() == 0) { return; }
        ZanIDE.AiCancelRequest();
        ide.AiRunStopped();
        ide.aiBusy.Set(0);
        ide.aiAutoCont = ide.aiContMax;
        ide.aiRetry = AiAgent.MaxRetries();
        ide.aiPendingCall = "";
        // 中断就把这一轮的运行态一次清完：写了一半的预览气泡、它的下标、
        // SSE 解析游标和等待起点。只清一半（以前只清待发调用）的后果是
        // 下一句话进来时，旧下标落在那句新消息上。
        ide.AiStreamDrop(true);
        ide.aiMsgs.Add(ChatMessage.Create("error",
            ZanIDE.T("[stopped] Interrupted by you.",
                "[已停止] 任务被你中断。")));
        ide.AiChatInvalidate();
        ide.app.RequestRedraw();
    }

    /// 批准挂起的动作：现在才真正执行它。
    static void AiApproveClicked() {
        ZanIDE ide = ZanIDE.current;
        if (ide == null || ide.aiBusy.Get() != 2) { return; }
        string capC = ide.aiPendingCall;
        ide.aiPendingCall = "";
        ide.aiBusy.Set(1);
        ide.AiDispatchTool(capC);
        ide.AiChatToEnd();
        ide.app.RequestRedraw();
    }

    /// 拒绝挂起的动作：告诉模型换个做法，别重复这一个。
    static void AiRejectClicked() {
        ZanIDE ide = ZanIDE.current;
        if (ide == null || ide.aiBusy.Get() != 2) { return; }
        string capR = ide.aiPendingCall;
        ide.aiPendingCall = "";
        ide.aiMsgs.Add(ide.AiToolMsg("tool",
            AiAgent.Describe(capR) + "\n"
            + "user declined this action; do not repeat it --"
            + " propose an alternative or ask what to do instead."));
        string rerr = ZanIDE.AiLaunchAs(ide.aiRunAgent, ide.aiMsgs,
            ide.aiRunCtxName, ide.aiRunCtxCode, ide.root,
            ide.aiProfiles[ide.aiProfActive].baseUrl,
            ide.aiProfiles[ide.aiProfActive].key, ide.aiRunModel);
        if (rerr != "") {
            ide.aiMsgs.Add(ide.AiToolMsg("error", rerr));
            ide.aiBusy.Set(0);
        } else { ide.aiBusy.Set(1); }
        ide.AiChatToEnd();
        ide.app.RequestRedraw();
    }

    /// 「插入代码」：把最后一段 AI 代码插到编辑器光标处。
    static void AiApplyClicked() {
        ZanIDE ide = ZanIDE.current;
        if (ide == null) { return; }
        string code = ZanIDE.AiLastCode(ide.aiMsgs);
        int act = ide.activeTab.Get();
        if (code == "" || act < 0 || act >= ide.tabs.Count) { return; }
        ide.editor.InsertBlock(code);
        ide.tabs[act].body = ide.editor.GetText();
        ide.log.Add(ZanIDE.T("> Inserted AI code into ",
            "> 已将 AI 代码插入 ") + ide.tabs[act].path + ".");
        ide.app.RequestRedraw();
    }

    /// 「替换整文件」：用最后一段 AI 代码替换当前文件的全部内容。
    static void AiReplaceClicked() {
        ZanIDE ide = ZanIDE.current;
        if (ide == null) { return; }
        string code = ZanIDE.AiLastCode(ide.aiMsgs);
        int act = ide.activeTab.Get();
        if (code == "" || act < 0 || act >= ide.tabs.Count) { return; }
        ide.editor.LoadText(code);
        ide.tabs[act].body = code;
        ide.log.Add(ZanIDE.T("> Replaced ", "> 已用 AI 代码替换 ")
            + ide.tabs[act].path + ZanIDE.T(" with AI code.", "。"));
        ide.app.RequestRedraw();
    }
}
