using System;
using Gui;
using Gui.Widget;

// Borrows an existing designed tree panel; the shell remains its view owner.
class IdeTreePanelHost {
    weak Control root;
    weak TreeView tree;
    ControlInputHost input;
    UiViewScope scope;
    bool prepared;
    List<TreeNode> shown = new List<TreeNode>();

    public IdeTreePanelHost(Control root, TreeView tree) { this.root = root; this.tree = tree; }
    public List<TreeNode> Shown() { return shown; }

    public void Initialize(App app, UiViewOwner owner) {
        if (scope != null) { return; }
        input = new ControlInputHost(root);
        scope = new UiViewScope(app, owner, root);
        input.Bind(app);
    }

    public bool OwnsView(UiViewScope view) { return scope != null && scope == view; }

    public void Prepare(App app, Rect area, List<TreeNode> nodes, Input filter) {
        prepared = false;
        if (scope == null || !scope.IsActive() || root == null || tree == null) { return; }
        if (area == null || area.width <= 0 || area.height <= 0
        || area.x <= -1000 || area.y <= -1000) {
            input.Hide();
            return;
        }
        // Form.Run can replace the startup root. Restore before saving the input proof.
        input.Bind(app);
        string query = filter != null ? filter.GetText() : "";
        shown = ZanIDE.FilterNodes(nodes, query);
        tree.Bind(shown);
        prepared = scope.Layout(area.x, area.y, area.width, area.height);
    }

    public void Render(App app, Rect area) {
        if (!prepared || root == null || area == null || area.width <= 0 || area.height <= 0
        || area.x <= -1000 || area.y <= -1000) { return; }
        root.RenderTree(app);
    }

    public void Retire() {
        prepared = false;
        if (scope != null) { scope.Retire(); scope = null; }
        if (input != null) { input.Hide(); input = null; }
    }
}
