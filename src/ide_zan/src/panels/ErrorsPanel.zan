using System;
using Gui;
using Gui.Widget;

/// ERRORS 面板：上一次构建的编译诊断。
///
/// 界面在 `ErrorsPanel.zform` 里声明（一个填满面板的 ErrorList，
/// 每行是消息 + 可选的快速修复按钮）。这里负责把外壳的诊断列表
/// 绑上去，并把用户在行上的操作（跳转 / 快速修复）交回外壳。
partial class ErrorsPanel {
    /// 这一帧绑定的诊断，面板标题的计数也取自它。
    List<DiagnosticRecord> records;

    void OnInit() {
        records = new List<DiagnosticRecord>();
    }

    /// 诊断条数（外壳把它写进面板标题）。
    int Count() { return records.Count; }

    /// 自上次调用以来被点掉的快速修复记录，没有则为 null。
    DiagnosticRecord TakeFix() { return ErrorsPanel.List.TakeFix(); }

    /// 自上次调用以来被双击的记录（跳到出错行），没有则为 null。
    DiagnosticRecord TakeJump() { return ErrorsPanel.List.TakeJump(); }

    /// 某条记录建议补的 using 命名空间（没有则为 ""）。
    string FixNs(DiagnosticRecord r) { return ErrorsPanel.List.FixNs(r); }

    void Render(App app, Rect area, List<DiagnosticRecord> recs) {
        if (recs == null) { recs = new List<DiagnosticRecord>(); }
        records = recs;
        ErrorsPanel.List.SetErrors(recs);
        this.RenderInside(app, area);
    }
}
