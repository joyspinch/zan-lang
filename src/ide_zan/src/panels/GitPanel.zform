{
  "name": "GitPanel",
  "role": "control",
  "layoutMode": 1,
  "fields": [
    {
      "kind": "Label",
      "name": "NoRepo",
      "label": "Not a git repository.",
      "class": "secondary small",
      "dock": 1,
      "fh": 24
    },
    {
      "kind": "Button",
      "name": "InitBtn",
      "label": "Initialize repository",
      "class": "primary small",
      "dock": 1,
      "fh": 30,
      "onClick": "gitInit"
    },
    {
      "kind": "Label",
      "name": "Branch",
      "class": "small",
      "dock": 1,
      "fh": 22
    },
    {
      "kind": "Panel",
      "name": "Row1",
      "dock": 1,
      "fh": 30,
      "kids": [
        {
          "kind": "Button",
          "name": "RefreshBtn",
          "label": "Refresh",
          "class": "small",
          "dock": 3,
          "fw": 92,
          "onClick": "gitRefresh"
        },
        {
          "kind": "Button",
          "name": "StageBtn",
          "label": "Stage all",
          "class": "small",
          "dock": 3,
          "fw": 92,
          "onClick": "gitStage"
        },
        {
          "kind": "Button",
          "name": "DiffBtn",
          "label": "Diff",
          "class": "small",
          "dock": 3,
          "fw": 92,
          "onClick": "gitDiff"
        }
      ]
    },
    {
      "kind": "Panel",
      "name": "Row2",
      "dock": 1,
      "fh": 30,
      "kids": [
        {
          "kind": "Button",
          "name": "LogBtn",
          "label": "History",
          "class": "small",
          "dock": 3,
          "fw": 92,
          "onClick": "gitLog"
        },
        {
          "kind": "Button",
          "name": "PullBtn",
          "label": "Pull",
          "class": "small",
          "dock": 3,
          "fw": 92,
          "onClick": "gitPull"
        },
        {
          "kind": "Button",
          "name": "PushBtn",
          "label": "Push",
          "class": "small",
          "dock": 3,
          "fw": 92,
          "onClick": "gitPush"
        }
      ]
    },
    {
      "kind": "Panel",
      "name": "CommitRow",
      "dock": 2,
      "fh": 34,
      "kids": [
        {
          "kind": "Button",
          "name": "CommitBtn",
          "label": "Commit",
          "class": "primary small",
          "dock": 4,
          "fw": 92,
          "onClick": "gitCommit"
        },
        {
          "kind": "Input",
          "name": "Message",
          "placeholder": "Commit message...",
          "dock": 5
        }
      ]
    },
    {
      "kind": "ListView",
      "of": "string",
      "name": "Files",
      "class": "flat",
      "dock": 5
    }
  ]
}
