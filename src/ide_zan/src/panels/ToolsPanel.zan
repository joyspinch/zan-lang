using System;
using Gui;
using Gui.Widget;

/// TOOLS 面板：`<安装目录>/tools` 下的 Zan 工具脚本树，双击直接运行一个
/// 工具，右键弹出面板自己的上下文菜单。
///
/// 界面在 `ToolsPanel.zform` 里声明；这里只做数据绑定和事件接线。
partial class ToolsPanel {
    List<TreeNode> shown;
    Input filter;

    void OnInit() {
        ToolsPanel.Tree.EmptyText(ZanIDE.T("No files found in ", "没有找到文件：")
            + ZanIDE.BaseDir() + "/tools");
        shown = new List<TreeNode>();
    }

    void Wire(SignalInt sel, Input f) {
        filter = f;
        ToolsPanel.Tree.BindSel(sel).WithFilter(f);
        ToolsPanel.Tree.OnActivate(ZanIDE.ToolActivated);
        ToolsPanel.Tree.OnContext(ZanIDE.ToolContext);
    }

    List<TreeNode> Shown() { return shown; }

    TreeView TreeCtl() { return ToolsPanel.Tree; }

    void Render(App app, Rect area, List<TreeNode> nodes) {
        string q = "";
        if (filter != null) { q = filter.GetText(); }
        shown = ZanIDE.FilterNodes(nodes, q);
        ToolsPanel.Tree.Bind(shown);
        this.RenderInside(app, area);
    }
}
