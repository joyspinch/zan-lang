using System;
using Gui;
using Gui.Widget;

/// STDLIB 面板：标准库与内置示例的树，选中一项在编辑器里打开它的源码。
///
/// 界面在 `StdlibPanel.zform` 里声明；这里只做数据绑定和事件接线。
partial class StdlibPanel {
    /// 当前显示的节点（已按筛选文本过滤），每帧重建一次。
    List<TreeNode> shown;
    Input filter;

    void OnInit() {
        shown = new List<TreeNode>();
    }

    void Wire(SignalInt sel, Input f) {
        filter = f;
        this.Tree.BindSel(sel).WithFilter(f);
        this.Tree.OnSelect(ZanIDE.ExamplePicked);
        this.Tree.OnContext(ZanIDE.StdlibContext);
    }

    List<TreeNode> Shown() { return shown; }

    TreeView TreeCtl() { return this.Tree; }

    void Render(App app, Rect area, List<TreeNode> nodes) {
        string q = "";
        if (filter != null) { q = filter.GetText(); }
        shown = ZanIDE.FilterNodes(nodes, q);
        this.Tree.Bind(shown);
        this.RenderInside(app, area);
    }
}
