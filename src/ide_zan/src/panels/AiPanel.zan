using System;
using Gui;
using Gui.Widget;
using Gui.Component;

/// 小赞（AI 助手）面板的界面骨架。
///
/// 界面在 `AiPanel.zform` 里声明：左侧会话栏 + 分隔线，右侧从上到下是
/// 头部（模型选择 / 配置按钮 / 上下文用量环）、团队条、任务计划、聊天
/// 记录，底部是「发给谁」提示行、代码应用行和输入行（自动执行开关、
/// 多行提示框、发送 / 停止 / 批准 / 拒绝）。
///
/// 聊天记录是标准库组件 `Gui.Component.ChatView`：换行、折叠、选区、
/// 滚动、busy 行都在组件里，面板只把消息列表绑给它。剩下几块还需要
/// 即时内容的地方（会话列表、任务计划、用量环）是 `Panel` 宿主，由
/// code-behind（`ZanIDE.AiPanel.zan`）填充；按钮全部走设计里的
/// `onClick` 名字，行为在 `ZanIDE` 那侧。
partial class AiPanel {
    void OnInit() {
        this.CfgBtn.SetProp("text", ZanIDE.T("Config", "配置"));
        // 一键把 AI 接入文件（AGENTS.md / .mcp.json / skills）装进当前
        // 打开的项目，和命令行 zan-mcp --init-agent 是同一套实现。
        this.InitBtn.SetProp("text", ZanIDE.T("AI access", "AI 接入"));
        this.InitBtn.SetProp("tip", ZanIDE.T(
            "Enable AI access for this project (AGENTS.md, .mcp.json, skills)",
            "为当前项目启用 AI 接入（AGENTS.md、.mcp.json、skills）"));
        this.SendBtn.SetProp("text", ZanIDE.T("Send", "发送"));
        this.StopBtn.SetProp("text", ZanIDE.T("Stop", "停止"));
        this.ApproveBtn.SetProp("text", ZanIDE.T("Approve", "批准"));
        this.RejectBtn.SetProp("text", ZanIDE.T("Reject", "拒绝"));
        this.ApplyBtn.SetProp("text", ZanIDE.T("Insert code", "插入代码"));
        this.ReplaceBtn.SetProp("text", ZanIDE.T("Replace file", "替换文件"));
        this.Prompt.SetProp("placeholder",
            ZanIDE.T("Ask the assistant...", "问问小赞..."));
        // 模型下拉框的宿主只是头部那一行里的一块地方，不是卡片：
        // 卡片默认的 paddingLarge 会把 46dp 高的头部吃光，下拉框只能
        // 既向右偏移又溢出头部。
        this.ModelHost.Layout();
        // 聊天组件是通用的：文案由宿主给，团队成员的名字/色调/标签
        // 由钩子解析，所以组件本身不认识 IDE 的翻译层和 AiTeam。
        this.Chat.WithStrings(AiPanel.ChatText());
        this.Chat.WithSpeakers(AiPanel.SpeakerOf, AiTeam.KindLabel);
    }

    /// 聊天视图的全部可见文案（本地化在 IDE 这一侧）。
    static ChatStrings ChatText() {
        ChatStrings s = ChatStrings.Default();
        s.you = ZanIDE.T("You", "我");
        s.assistant = ZanIDE.T("Xiao Zan", "小赞");
        s.tool = ZanIDE.T("Tool", "工具");
        s.error = ZanIDE.T("Error", "错误");
        s.thinkShow = ZanIDE.T("Thinking (click to show)", "思考过程（点击展开）");
        s.thinkHide = ZanIDE.T("Thinking (click to hide)", "思考过程（点击收起）");
        s.codeMorePre = ZanIDE.T("show ", "展开剩余 ");
        s.codeMorePost = ZanIDE.T(" more code lines", " 行代码");
        s.codeCollapse = ZanIDE.T("collapse code", "收起代码");
        s.busy = ZanIDE.T("Xiao Zan is thinking...", "小赞思考中...");
        s.empty = ZanIDE.T(
            "Ask Xiao Zan about your project: explain code, find bugs, generate Zan snippets.",
            "向小赞提问：解释代码、查找问题、生成 Zan 代码片段。");
        return s;
    }

    /// 团队会话里某个成员在记录头行上的样子；不认识的 id 返回 null，
    /// 组件就按普通助手画。
    static ChatSpeaker SpeakerOf(string agent) {
        AiRole r = AiTeam.RoleOf(agent);
        if (r == null) { return null; }
        return ChatSpeaker.Of(AiTeam.DisplayName(agent), r.tint,
            AiTeam.RoleTagClass(agent));
    }

    /// 把设计里的 `onClick` 名字接到外壳的处理器上：面板只表达意图，
    /// 发请求 / 落盘 / 改编辑器都在 ZanIDE 那一层。
    static void WireHandlers(Form form) {
        form.On("aiOpenSettings", ZanIDE.AiOpenSettings);
        form.On("aiInitAgent", ZanIDE.AiInitAgentClicked);
        form.On("aiAutoToggle", ZanIDE.AiAutoToggled);
        form.On("aiSend", ZanIDE.AiSendClicked);
        form.On("aiStop", ZanIDE.AiStopClicked);
        form.On("aiApprove", ZanIDE.AiApproveClicked);
        form.On("aiReject", ZanIDE.AiRejectClicked);
        form.On("aiApplyCode", ZanIDE.AiApplyClicked);
        form.On("aiReplaceFile", ZanIDE.AiReplaceClicked);
    }

    /// 提示框（外壳读取 / 清空文本，并按焦点判断回车是否发送）。
    TextArea PromptBox() { return this.Prompt; }

    /// 团队条：设计里声明的子控件，外壳每帧只喂状态（见 TeamBoard）。
    TeamBoard TeamStrip() { return this.Team; }

    /// 「跑到哪了」+ 任务计划那条带子：同样是声明的子控件，外壳只把
    /// 当前那次交付和计划交给它（见 PlanStrip）。
    PlanStrip PlanBand() { return this.Plan; }

    /// 「将发给 …」那一行（团队模式）：收件人下拉归它，外壳只读写状态。
    SendCue CueRow() { return this.Cue; }

    /// 上下文用量环：悬停打开的那张用量卡也归它，外壳只送数字。
    CtxRing RingCtl() { return this.Ring; }

    /// 聊天记录组件：外壳只绑消息、设 busy、切会话时 Reset。
    ChatView Transcript() { return this.Chat; }

    /// 模型下拉框的宿主：下拉框按 profile 变化重建，所以由外壳把当前
    /// 那个实例放进来（面板不持有它的类型参数）。
    void SetModelSelect(Control sel) {
        this.ModelHost.RemoveAll();
        if (sel != null) {
            // 填充停靠：宽度取头部行剩下的空间、高度跟着行高，
            // 而不是按手动定位把预设尺寸画到宿主外面（模型名很长，
            // 触发器越宽越不需要截断）。
            sel.Dock(Dock.Fill());
            this.ModelHost.Add(sel);
        }
    }

    static Rect RectOf(Control c) {
        return new Rect(c.bx, c.by, c.bw, c.bh);
    }

    Rect SidebarRect() { return AiPanel.RectOf(this.Sidebar); }
    Rect AutoRect() { return AiPanel.RectOf(this.AutoBtn); }
    Rect BodyRect() { return AiPanel.RectOf(this.Body); }

    /// 本帧的可变尺寸与可见性：会话栏宽度（0 = 面板太窄，收起）、
    /// 任务计划 / 提示行 / 代码应用行的高度，以及请求状态
    /// （0 空闲、1 进行中、2 等待批准）决定输入行显示哪一组控件。
    void Prepare(int sideW, int planH, int cueH, int applyH,
                 int busy, bool autoExec, string autoText) {
        this.Sidebar.Prefer(sideW, 0);
        this.Sidebar.SetShown(sideW > 0);
        this.SideRule.SetShown(sideW > 0);
        // 团队条始终在：单人 / 团队开关就长在它头一行上，跟着团队模式一起
        // 隐藏的话，关掉之后再没有地方把它打开（任务图也就跟着不可达）。
        // 关的时候条子自己只留那一行（ShowSolo）。
        this.Team.SetShown(true);
        this.Plan.Prefer(0, planH);
        this.Plan.SetShown(planH > 0);
        this.Cue.Prefer(0, cueH);
        this.Cue.SetShown(cueH > 0);
        this.ApplyRow.Prefer(0, applyH);
        this.ApplyRow.SetShown(applyH > 0);
        this.AutoBtn.Text = autoText;
        this.AutoBtn.Class = autoExec ? "primary small ai-row"
                                         : "small ai-row";
        bool waiting = busy == 2;
        this.PendLbl.SetShown(waiting);
        this.ApproveBtn.SetShown(waiting);
        this.RejectBtn.SetShown(waiting);
        this.Prompt.SetShown(!waiting);
        this.SendBtn.SetShown(!waiting && busy == 0);
        this.StopBtn.SetShown(!waiting && busy != 0);
    }

    /// 等待批准时输入行上显示的动作说明。
    void SetPending(string text) { this.PendLbl.Text = text; }

    void Render(App app, Rect area) {
        this.RenderInside(app, area);
    }
}
