using System;
using Gui;
using Gui.Widget;
using Gui.Component;

/// 「帮助与反馈」面板的界面。
///
/// 结构在 `HelpPanel.zform` 里声明：顶部一行是说明文字加五个动作按钮
/// （上报 / 带日志 / 复制 / 导出 / 清空），下面是一段可填的复现说明、
/// 一行状态文字，最下面是填满剩余空间的 ConsoleView（诊断列表或上报
/// payload 预览，自带滚动与选择）。
///
/// 这里只做三件事：把这一帧的文字和行铺进控件、按状态换按钮文案、把
/// 用户点了哪个按钮告诉外壳；面板不再计算任何一个按钮的矩形，也不再
/// 自己画列表。
partial class HelpPanel {
    /// `Render` 的返回值：本帧用户触发的动作。
    static int None() { return 0; }
    static int Consent() { return 1; }
    static int Copy() { return 2; }
    static int Export() { return 3; }
    static int Clear() { return 4; }
    static int Report() { return 5; }

    void OnInit() {
        logPad = 6;
        logGap = 6;
        HelpPanel.CopyBtn.SetProp("text", ZanIDE.T("Copy", "复制"));
        HelpPanel.ExportBtn.SetProp("text", ZanIDE.T("Export", "导出"));
        HelpPanel.ClearBtn.SetProp("text", ZanIDE.T("Clear", "清空"));
        HelpPanel.ReportBtn.SetProp("text", ZanIDE.T("Report", "上报"));
        HelpPanel.Note.SetProp("placeholder", ZanIDE.T(
            "What were you doing? Steps to reproduce (optional)",
            "你在做什么？复现步骤（可选）"));
        HelpPanel.List.EmptyText(
            ZanIDE.T("No errors recorded.", "还没有记录到错误。"));
    }

    /// 用户填的复现说明（报告里带上）。
    string NoteText() { return HelpPanel.Note.GetText(); }

    /// 列表的滚动 / 选择状态：清空或切换预览时外壳把它复位。
    LogState State() { return HelpPanel.List.State(); }

    /// 画这一帧并返回用户触发的动作。`head` / `stat` 是两行说明，
    /// `logsOn` 决定「带日志」按钮的文案，`rows` / `colors` 是列表内容。
    int Render(App app, Rect area, string head, string stat, bool logsOn,
               List<string> rows, List<int> colors) {
        HelpPanel.Head.Text = head;
        HelpPanel.Stat.Text = stat;
        if (logsOn) {
            HelpPanel.ConsentBtn.Text = ZanIDE.T("Logs: on", "带日志:开");
        } else {
            HelpPanel.ConsentBtn.Text = ZanIDE.T("Logs: off", "带日志:关");
        }
        HelpPanel.List.Bind(rows);
        HelpPanel.List.WithColors(colors);
        this.RenderInside(app, area);
        // 按钮在绘制时记下自己被点过，外壳只需要问结果——不需要 id、
        // 不需要命中测试。
        if (HelpPanel.ConsentBtn.WasClicked()) { return HelpPanel.Consent(); }
        if (HelpPanel.CopyBtn.WasClicked()) { return HelpPanel.Copy(); }
        if (HelpPanel.ExportBtn.WasClicked()) { return HelpPanel.Export(); }
        if (HelpPanel.ClearBtn.WasClicked()) { return HelpPanel.Clear(); }
        if (HelpPanel.ReportBtn.WasClicked()) { return HelpPanel.Report(); }
        return HelpPanel.None();
    }
}
