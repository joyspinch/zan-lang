using System;
using Gui;
using Gui.Widget;
using Gui.Component;

// 「帮助与反馈」面板的界面。
// 结构在 `HelpPanel.html` 里声明：顶部一行是说明文字加五个动作按钮
// （上报 / 带日志 / 复制 / 导出 / 清空），下面是一段可填的复现说明、
// 一行状态文字，最下面是填满剩余空间的 ConsoleView（诊断列表或上报
// payload 预览，自带滚动与选择）。
// 这里只做三件事：把这一帧的文字和行铺进控件、按状态换按钮文案、把
// 用户点了哪个按钮告诉外壳；面板不再计算任何一个按钮的矩形，也不再
// 自己画列表。
partial class HelpPanel {
    int pendingAction;
    static HelpPanel current;

    static void Action(int action) {
        HelpPanel panel = HelpPanel.current;
        if (panel != null) { panel.pendingAction = action; }
    }

    // `Render` 的返回值：路由事件产生的待处理动作。
    static int None() { return 0; }
    static int Consent() { return 1; }
    static int Copy() { return 2; }
    static int Export() { return 3; }
    static int Clear() { return 4; }
    static int Report() { return 5; }

    void OnInit() {
        this.Pad(6);
        this.Gap(6);
        this.CopyBtn.SetProp("text", ZanIDE.T("Copy", "复制"));
        this.ExportBtn.SetProp("text", ZanIDE.T("Export", "导出"));
        this.ClearBtn.SetProp("text", ZanIDE.T("Clear", "清空"));
        this.ReportBtn.SetProp("text", ZanIDE.T("Report", "上报"));
        this.Note.SetProp("placeholder", ZanIDE.T(
            "What were you doing? Steps to reproduce (optional)",
            "你在做什么？复现步骤（可选）"));
        this.List.EmptyText(
            ZanIDE.T("No errors recorded.", "还没有记录到错误。"));
        HelpPanel.current = this;
        this.ConsentBtn.Click.Add(() => HelpPanel.Action(HelpPanel.Consent()));
        this.CopyBtn.Click.Add(() => HelpPanel.Action(HelpPanel.Copy()));
        this.ExportBtn.Click.Add(() => HelpPanel.Action(HelpPanel.Export()));
        this.ClearBtn.Click.Add(() => HelpPanel.Action(HelpPanel.Clear()));
        this.ReportBtn.Click.Add(() => HelpPanel.Action(HelpPanel.Report()));
    }

    // 用户填的复现说明（报告里带上）。
    string NoteText() { return this.Note.GetText(); }

    // 列表的滚动 / 选择状态：清空或切换预览时外壳把它复位。
    LogState State() { return this.List.State(); }

    // 画这一帧并返回用户触发的动作。`head` / `stat` 是两行说明，
    // `logsOn` 决定「带日志」按钮的文案，`rows` / `colors` 是列表内容。
    int Render(App app, Rect area, string head, string stat, bool logsOn,
               List<string> rows, List<int> colors) {
        this.Head.Text = head;
        this.Stat.Text = stat;
        if (logsOn) {
            this.ConsentBtn.Text = ZanIDE.T("Logs: on", "带日志:开");
        } else {
            this.ConsentBtn.Text = ZanIDE.T("Logs: off", "带日志:关");
        }
        this.List.Bind(rows);
        this.List.WithColors(colors);
        this.RenderInside(app, area);
        int action = pendingAction;
        pendingAction = HelpPanel.None();
        return action;
    }
}
