using System;
using System.IO;
using System.Threading;
using Gui;
using Gui.Widget;

/// GIT 面板：仓库状态 + 暂存 / 提交 / 同步 / 分支（建、切、并）/ 贮藏。
///
/// 界面在 `GitPanel.html` 里声明：分支行、两排命令按钮、变更文件
/// 列表、底部的提交信息行；空仓库时只显示提示和「初始化仓库」。
/// 每个按钮的 `onClick` 是设计里的处理器名，由 `WireHandlers` 注册
/// 到宿主 Form 的处理器表上（`.html` 的事件通路），这里的代码只
/// 表达意图：真正跑 git 的是 `BeginGitJob` 那一层（工作线程执行），
/// 命令的输出全部回到 OUTPUT 面板；仓库探测与状态刷新走
/// `SyncWorkspace` 的后台线程，渲染只读缓存，永不阻塞。
partial class GitPanel {
    void OnInit() {
        this.Files.WithRow(GitFileRow.Of);
        this.Files.EmptyText(ZanIDE.T("Working tree clean.", "工作区无变更。"));
        this.Files.OnActivate(ZanIDE.GitFileActivated);
        this.NoRepo.Text = ZanIDE.T("Not a git repository.",
            "当前项目不是 git 仓库。");
        this.InitBtn.SetProp("text",
            ZanIDE.T("Initialize repository", "初始化仓库"));
        this.RefreshBtn.SetProp("text", ZanIDE.T("Refresh", "刷新"));
        this.StageBtn.SetProp("text", ZanIDE.T("Stage all", "暂存全部"));
        this.StageOneBtn.SetProp("text", ZanIDE.T("Stage file", "暂存所选"));
        this.UnstageBtn.SetProp("text", ZanIDE.T("Unstage", "撤销暂存"));
        this.DiffBtn.SetProp("text", ZanIDE.T("Diff", "差异"));
        this.LogBtn.SetProp("text", ZanIDE.T("History", "历史"));
        this.PullBtn.SetProp("text", ZanIDE.T("Pull", "拉取"));
        this.PushBtn.SetProp("text", ZanIDE.T("Push", "推送"));
        this.BranchNewBtn.SetProp("text", ZanIDE.T("Branch", "建分支"));
        this.BranchSwitchBtn.SetProp("text", ZanIDE.T("Switch", "切换"));
        this.MergeBtn.SetProp("text", ZanIDE.T("Merge", "合并"));
        this.StashBtn.SetProp("text", ZanIDE.T("Stash", "贮藏"));
        this.StashPopBtn.SetProp("text", ZanIDE.T("Unstash", "弹出"));
        this.StashListBtn.SetProp("text", ZanIDE.T("Stash list", "贮藏列表"));
        this.CommitBtn.SetProp("text", ZanIDE.T("Commit", "提交"));
        this.Message.SetProp("placeholder",
            ZanIDE.T("Commit message...", "提交信息..."));
        this.BranchName.SetProp("placeholder",
            ZanIDE.T("Branch name...", "分支名..."));
    }

    /// 把设计里的 `onClick` 名字接到本面板的处理器上。
    static void WireHandlers(Form form) {
        form.On("gitInit", GitPanel.OnInitRepo);
        form.On("gitRefresh", GitPanel.OnRefresh);
        form.On("gitStage", GitPanel.OnStage);
        form.On("gitStageOne", GitPanel.OnStageSelected);
        form.On("gitUnstage", GitPanel.OnUnstageSelected);
        form.On("gitDiff", GitPanel.OnDiff);
        form.On("gitLog", GitPanel.OnHistory);
        form.On("gitPull", GitPanel.OnPull);
        form.On("gitPush", GitPanel.OnPush);
        form.On("gitBranchNew", GitPanel.OnBranchNew);
        form.On("gitBranchSwitch", GitPanel.OnBranchSwitch);
        form.On("gitMerge", GitPanel.OnMerge);
        form.On("gitStash", GitPanel.OnStash);
        form.On("gitStashPop", GitPanel.OnStashPop);
        form.On("gitStashList", GitPanel.OnStashList);
        form.On("gitCommit", GitPanel.OnCommit);
    }

    /// 变更文件列表控件（外壳的行处理器读取选中项）。
    ListView<string> FileList() { return this.Files; }

    /// 仓库探测（后台线程结果）与是否已扫过状态。渲染路径只读这两个缓存。
    bool repoKnown;
    bool repoState;

    /// 仓库状态与变更列表的异步刷新入口：主流程在切换工作区、git 作业完成、
    /// 手动刷新后调用。.git 探测与状态作业的发起都离开渲染线程；结果经
    /// Post 回 UI 线程，并按「同一 IDE、同一根目录、未关停」核对后才生效。
    void SyncWorkspace() {
        ZanIDE ide = ZanIDE.current;
        if (ide == null || ide.shuttingDown) { return; }
        string rootAt = ide.root;
        if (rootAt == "") {
            this.repoKnown = true;
            this.repoState = false;
            return;
        }
        App host = ide.app;
        Task.Run(delegate () {
            bool repo = Directory.Exists(rootAt + "/.git");
            host.Post(delegate () {
                ZanIDE owner = ZanIDE.current;
                if (owner == null || owner != ide || owner.root != rootAt
                    || owner.shuttingDown) { return; }
                this.repoKnown = true;
                this.repoState = repo;
                if (repo && !owner.gitLoaded && owner.gitJob == 0) {
                    // 状态作业：refresh 变体在工作线程上跑 `git status` 等，
                    // 结果由 job 监视器回填 gitFiles/gitBranch/gitHead。
                    owner.BeginGitJob("", true);
                }
                owner.app.RequestRedraw();
            });
        });
    }

    void Render(App app, Rect area) {
        ZanIDE ide = ZanIDE.current;
        if (ide == null) { return; }
        bool repo = this.repoKnown && this.repoState;
        this.NoRepo.SetShown(!repo);
        this.InitRow.SetShown(!repo);
        this.Branch.SetShown(repo);
        this.Row1.SetShown(repo);
        this.Row2.SetShown(repo);
        this.BranchRow.SetShown(repo);
        this.CommitRow.SetShown(repo);
        this.Files.SetShown(repo);
        if (repo) {
            this.Branch.Text = ZanIDE.T("Branch: ", "分支：")
                + GitPanel.BranchText(ide) + "   ("
                + Convert.ToString(ide.gitFiles.Count)
                + ZanIDE.T(" changes", " 处变更") + ")";
            this.Files.Bind(ide.gitFiles);
            this.Files.Refresh();
            this.Files.SelectIndex(ide.gitSel.Get());
        }
        this.RenderInside(app, area);
        if (repo) { ide.gitSel.Set(this.Files.SelectedIndex()); }
    }

    /// 分支行的文字。仓库还没有提交时 HEAD 是「未出生」的，那时既没有
    /// 提交也不算游离，写清楚这一点，而不是把 git 的 stderr 抄到界面上。
    static string BranchText(ZanIDE ide) {
        if (ide.gitBranch != "") {
            if (ide.gitHead == "") {
                return ide.gitBranch
                    + ZanIDE.T(" (no commits yet)", "（尚无提交）");
            }
            return ide.gitBranch;
        }
        if (ide.gitHead != "") {
            return ZanIDE.T("detached at ", "游离于 ") + ide.gitHead;
        }
        return ZanIDE.T("(unknown)", "（未知）");
    }

    /// 列表当前选中的变更路径（没有选中时是 ""）。
    static string SelectedPath(ZanIDE ide) {
        int sel = ide.gitSel.Get();
        if (sel < 0 || sel >= ide.gitFiles.Count) { return ""; }
        return ZanIDE.GitPathOf(ide.gitFiles[sel]);
    }

    // ---- 设计里的处理器：每个都只发起一次后台 git 作业 ----

    static void OnInitRepo() {
        ZanIDE ide = ZanIDE.current;
        if (ide == null || ide.gitJob != 0) { return; }
        ide.BeginGitJob("init");
        ide.log.Add(ZanIDE.T("> git init ...", "> 正在初始化 git 仓库 ..."));
    }

    static void OnRefresh() {
        ZanIDE ide = ZanIDE.current;
        if (ide == null) { return; }
        ide.gitLoaded = false;
        if (ide.gitPanel != null) { ide.gitPanel.SyncWorkspace(); }
    }

    static void OnStage() {
        ZanIDE ide = ZanIDE.current;
        if (ide == null) { return; }
        if (ide.gitJob == 0) {
            ide.BeginGitJob("add -A");
            ide.log.Add(ZanIDE.T("> Staging all changes ...",
                "> 正在暂存全部变更 ..."));
        }
        ide.dock.Focus("output");
    }

    /// 暂存所选：只把列表里选中的那一个路径加进索引。
    static void OnStageSelected() {
        ZanIDE ide = ZanIDE.current;
        if (ide == null || ide.gitJob != 0) { return; }
        string p = GitPanel.SelectedPath(ide);
        if (p == "") {
            ide.log.Add(ZanIDE.T("> Select a changed file first.",
                "> 请先在列表里选择一个文件。"));
            ide.dock.Focus("output");
            return;
        }
        ide.BeginGitJob("add -- \"" + p + "\"");
        ide.log.Add("> git add -- \"" + p + "\" ...");
        ide.dock.Focus("output");
    }

    /// 撤销暂存：`reset -- <path>` 而不是 `restore --staged`，因为还没有
    /// 提交的仓库里没有 HEAD 可以拿来恢复。
    static void OnUnstageSelected() {
        ZanIDE ide = ZanIDE.current;
        if (ide == null || ide.gitJob != 0) { return; }
        string p = GitPanel.SelectedPath(ide);
        if (p == "") {
            ide.log.Add(ZanIDE.T("> Select a changed file first.",
                "> 请先在列表里选择一个文件。"));
            ide.dock.Focus("output");
            return;
        }
        ide.BeginGitJob("reset -q -- \"" + p + "\"");
        ide.log.Add("> git reset -q -- \"" + p + "\" ...");
        ide.dock.Focus("output");
    }

    /// 差异：还没有提交时和 HEAD 比会报 `ambiguous argument 'HEAD'`，那时
    /// 唯一有意义的比较是索引本身（`diff --cached`）。
    static void OnDiff() {
        ZanIDE ide = ZanIDE.current;
        if (ide == null) { return; }
        string target = "";
        string p = GitPanel.SelectedPath(ide);
        if (p != "") { target = " -- \"" + p + "\""; }
        string what = "diff HEAD";
        if (ide.gitHead == "") { what = "diff --cached"; }
        if (ide.gitJob == 0) {
            ide.BeginGitJob(what + target);
            ide.log.Add("> git " + what + target + " ...");
        }
        ide.dock.Focus("output");
        ide.OutputReset();
    }

    static void OnHistory() {
        ZanIDE ide = ZanIDE.current;
        if (ide == null) { return; }
        if (ide.gitHead == "") {
            ide.log.Add(ZanIDE.T("> No commits yet.", "> 仓库还没有提交。"));
            ide.dock.Focus("output");
            return;
        }
        if (ide.gitJob == 0) {
            ide.BeginGitJob("log --oneline --decorate -20");
            ide.log.Add("> git log ...");
        }
        ide.dock.Focus("output");
        ide.OutputReset();
    }

    static void OnPull() {
        ZanIDE ide = ZanIDE.current;
        if (ide == null) { return; }
        if (ide.gitJob == 0) {
            ide.log.Add("> git pull ...");
            ide.BeginGitJob("pull");
        }
        ide.dock.Focus("output");
    }

    static void OnPush() {
        ZanIDE ide = ZanIDE.current;
        if (ide == null) { return; }
        if (ide.gitJob == 0) {
            ide.log.Add("> git push ...");
            ide.BeginGitJob("push");
        }
        ide.dock.Focus("output");
    }

    /// 分支行输入框里的名字（去掉首尾空白）。
    static string BranchInput(ZanIDE ide) {
        if (ide == null || ide.gitPanel == null) { return ""; }
        return ide.gitPanel.BranchName.GetText().Trim();
    }

    /// 建分支：`checkout -b <名>`，建好即切过去。
    static void OnBranchNew() {
        ZanIDE ide = ZanIDE.current;
        if (ide == null) { return; }
        string name = GitPanel.BranchInput(ide);
        if (name == "") {
            ide.log.Add(ZanIDE.T("> Enter a branch name first.",
                "> 请先输入分支名。"));
        } else if (ide.gitJob == 0) {
            name = ZanIDE.GitEscape(name);
            ide.BeginGitJob("checkout -b \"" + name + "\"");
            ide.log.Add("> git checkout -b \"" + name + "\" ...");
            ide.gitPanel.BranchName.SetText("");
        }
        ide.dock.Focus("output");
    }

    /// 切分支：`checkout <名>`（不用 `switch`，它要求 git ≥ 2.23）；
    /// 名字不存在时 git 的报错原样回显。
    static void OnBranchSwitch() {
        ZanIDE ide = ZanIDE.current;
        if (ide == null) { return; }
        string name = GitPanel.BranchInput(ide);
        if (name == "") {
            ide.log.Add(ZanIDE.T("> Enter a branch name first.",
                "> 请先输入分支名。"));
        } else if (ide.gitJob == 0) {
            name = ZanIDE.GitEscape(name);
            ide.BeginGitJob("checkout \"" + name + "\"");
            ide.log.Add("> git checkout \"" + name + "\" ...");
            ide.gitPanel.BranchName.SetText("");
        }
        ide.dock.Focus("output");
    }

    /// 合并：把输入框里的分支并进当前分支。
    static void OnMerge() {
        ZanIDE ide = ZanIDE.current;
        if (ide == null) { return; }
        string name = GitPanel.BranchInput(ide);
        if (name == "") {
            ide.log.Add(ZanIDE.T("> Enter a branch name to merge first.",
                "> 请先输入要合并的分支名。"));
        } else if (ide.gitJob == 0) {
            name = ZanIDE.GitEscape(name);
            ide.BeginGitJob("merge \"" + name + "\"");
            ide.log.Add("> git merge \"" + name + "\" ...");
            ide.gitPanel.BranchName.SetText("");
        }
        ide.dock.Focus("output");
    }

    /// 贮藏：把工作区改动收进 stash，工作区恢复干净。
    static void OnStash() {
        ZanIDE ide = ZanIDE.current;
        if (ide == null) { return; }
        if (ide.gitJob == 0) {
            ide.log.Add("> git stash ...");
            ide.BeginGitJob("stash");
        }
        ide.dock.Focus("output");
    }

    /// 弹出最近一次贮藏。
    static void OnStashPop() {
        ZanIDE ide = ZanIDE.current;
        if (ide == null) { return; }
        if (ide.gitJob == 0) {
            ide.log.Add("> git stash pop ...");
            ide.BeginGitJob("stash pop");
        }
        ide.dock.Focus("output");
    }

    /// 贮藏列表：列出所有 stash 供 pop 前确认。
    static void OnStashList() {
        ZanIDE ide = ZanIDE.current;
        if (ide == null) { return; }
        if (ide.gitJob == 0) {
            ide.log.Add("> git stash list ...");
            ide.BeginGitJob("stash list");
        }
        ide.dock.Focus("output");
    }

    /// 提交:不自行暂存,提交已暂存的内容;什么都没暂存时退回
    /// `commit -a`,于是「暂存全部 + 提交」和直接提交都成立。
    static void OnCommit() {
        ZanIDE ide = ZanIDE.current;
        if (ide == null || ide.gitPanel == null) { return; }
        string msg = ide.gitPanel.Message.GetText();
        if (msg == "") {
            ide.log.Add(ZanIDE.T("> Enter a commit message first.",
                "> 请先输入提交信息。"));
        } else if (ide.gitJob == 0) {
            msg = ZanIDE.GitEscape(msg);
            ide.BeginGitJob(
                "diff --cached --quiet && git -C \"" + ide.root
                + "\" commit -a -m \"" + msg
                + "\" || git -C \"" + ide.root + "\" commit -m \"" + msg + "\"");
            ide.log.Add("> git commit ...");
            ide.gitPanel.Message.SetText("");
        }
        ide.dock.Focus("output");
    }
}
