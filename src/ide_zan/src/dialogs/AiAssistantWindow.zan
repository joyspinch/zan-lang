using System;
using Gui;
using Gui.Widget;
using Gui.Component;

// 小赞的独立子窗口：小助手面板（panels/AiPanel.html + 行为在
// ZanIDE.AiPanel.zan）不再停靠在主窗口右侧，而是住进自己的顶层窗口。
// 窗口只做宿主——每一帧把客户区矩形交给 `ZanIDE.RenderAiPanel`，
// 全部状态（会话、任务图、团队、请求流水线）仍归外壳所有，这里只是
// 那块界面的新画布。渲染回调（SetRender）即 WizardHost 同款路径：
// 基类已在回调前后钉住 WidgetId 基线，回调自己负责
// BeginFrame / RenderChrome / PresentFrame。
// 重绘判据走快照对比（Pending）：外壳侧的小赞状态变了才出帧。流式
// 回答的节奏由主窗口的轮询时钟带动（aiBusy 期间主循环每 100~250ms
// 醒一次，见 ZanIDE.zan 的 RequestWakeIn(aiPollMs)），PumpAll 每圈都会
// 泵到本窗口，空转时一帧都不画。
public class AiAssistantWindow : ChildWindow {
    AppLoopRegistration sessionsPreparation;

    // Custom rendering bypasses ChildWindow's retained-root layout. Register
    // before the first input snapshot so resize cannot borrow Paint bounds.
    void InitializeSessionsHost(App host) {
        if (host == null) { return; }
        if (sessionsPreparation != null && sessionsPreparation.active
        && sessionsPreparation.host == host) { return; }
        this.RetireSessionsPreparation();
        sessionsPreparation = host.RegisterLoopParticipant(this,
        new IdeAiWindowPreparation(this));
        ZanIDE ide = ZanIDE.current;
        if (ide != null) {
            if (ide.dock != null && ide.dock.Visible("agent")) {
                ide.PrepareAiSessionsView(ide.app);
            } else {
                if (ide.aiPanel.parent != null) { ide.aiPanel.parent.Remove(ide.aiPanel); }
                this.SetView(ide.aiPanel, null);
                ide.PrepareAiSessionsWindow(host);
            }
        }
    }

    void PrepareSessionsHost(App host) {
        if (sessionsPreparation == null || !sessionsPreparation.active
        || sessionsPreparation.host != host || !this.IsOpen()) { return; }
        ZanIDE ide = ZanIDE.current;
        if (ide == null || ide.aiWin != this) { return; }
        if (ide.dock != null && ide.dock.Visible("agent")) {
            Rect area = ide.dock.PreviewContent(ide.app,
            ide.dock.Content("editor"), "agent");
            ide.PrepareAiSessionsView(ide.app, area);
        } else {
            int top = host.ContentTop();
            Rect area = new Rect(host.ShapeOffX(), top + host.ShapeOffY(),
            host.ClientWidth(), host.ClientHeight() - top);
            ide.PrepareAiPanel(host, area);
            ide.aiPanel.UseApp(host);
            ide.aiPanel.MeasureTree(host, area.width);
            ide.aiPanel.Arrange(area.x, area.y, area.width, area.height);
            ide.PrepareAiSessionsWindow(host);
        }
    }

    private void RetireSessionsPreparation() {
        AppLoopRegistration previous = sessionsPreparation;
        sessionsPreparation = null;
        if (previous != null) { previous.Invalidate(); }
    }

    // ---- 重绘快照（Pending 逐项比较，AfterFrame 落盘）----
    // 不拼签名字符串：Pending 每轮循环都会跑，逐字段比较开销可忽略。
    int sBusy;
    int sMsgCount;
    int sTailLen;
    int sPlanCount;
    int sTaskCount;
    string sRoot;
    string sModelSig;
    string sPendingCall;
    string sActiveTask;
    string sGraphSel;
    string sSendTo;
    int sSessCur;
    bool sTeamModeB;
    bool sAutoExecB;
    int sTeamOpen;
    int sProfActive;

    // 功能区的「小赞」开关：没开就请求打开，开着就收起来。
    // 打开请求由外壳在帧与帧之间兑现（aiWinPending，与 aiCfgPending
    // 同一条约束：帧内创建顶层窗口会未绘制并在下一拍崩掉）。
    //
    // 同一块小赞控件树不能画两遍：右侧那扇 Agent 面板开着的时候，
    // 这里先把面板收掉——两个宿主二选一。
    static void ToggleFromRibbon() {
        ZanIDE ide = ZanIDE.current;
        if (ide == null) { return; }
        if (ide.aiWin != null && ide.aiWin.IsOpen()) {
            ide.RetireAiSessionsView();
            ide.aiWin.Close();
            ide.aiWin = null;
        } else {
            // 右侧那扇 Agent 面板开着就先收掉：同一块小赞控件树不能
            // 画两遍（两个宿主共用同一批控件 id，点击会落到另一个上）。
            if (ide.dock != null && !ide.dock.IsHidden("agent")) {
                ide.RetireAiSessionsView();
                ide.dock.Close("agent");
                ide.dock.TakeClosed();
            }
            ide.aiWinPending = true;
        }
        ide.app.RequestRedraw();
    }

    static AiAssistantWindow Open(App parent) {
        AiAssistantWindow w = new AiAssistantWindow();
        w.SetRender(() => {
            App hApp = w.Host();
            ZanIDE ide = ZanIDE.current;
            if (ide == null || hApp == null || ide.aiWin != w) { return; }
            // 面板已经挪回主窗口右侧时，这里不画：同一块控件树画两遍
            // 会让两处共用同一批控件 id，点击会落到另一个宿主上。
            if (ide.dock != null && !ide.dock.IsHidden("agent")) {
                Rect dockArea = ide.dock.PreviewContent(ide.app,
                ide.dock.Content("editor"), "agent");
                ide.PrepareAiSessionsView(ide.app, dockArea);
                return;
            }
            hApp.BeginFrame();
            if (!hApp.PrepareStandardHostFrame()) { return; }
            int top = hApp.ContentTop();
            Rect area = new Rect(hApp.ShapeOffX(),
            top + hApp.ShapeOffY(), hApp.ClientWidth(),
            hApp.ClientHeight() - top);
            ide.RenderAiPanel(hApp, area);
            if (!hApp.ContinuePreparedFrame()) { return; }
            // 任务图菜单与主窗口共用外壳状态，但由本窗口的 OverlayHost 持有。
            if (ide.ctxKind == 7 && (ide.ctxMenu == null || !ide.ctxMenu.IsOpen()
            || ide.ctxMenuApp != hApp)) {
                List<string> cmLabels = new List<string>();
                ide.AiGraphMenuLabels(cmLabels);
                ContextMenu menu = ide.CreateContextMenu(hApp, 7, cmLabels);
                ide.ctxMenu = menu;
                ide.ctxMenuApp = hApp;
                menu.ShowAt(hApp, ide.ctxX, ide.ctxY);
                if (ide.ctxMenu == menu && menu.IsOpen()
                && hApp.overlayHost.ActiveRoot() == menu) {
                    ide.ctxKind = 7;
                }
            }
            hApp.RenderChrome(w.Title());
            hApp.PresentFrame();
        });
        w.OpenHost(parent);
        w.InitializeSessionsHost(w.Host());
        return w;
    }

    override string Title() { return ZanIDE.T("Xiao Zan", "小赞"); }

    override int Width() { return 640; }
    override int Height() { return 720; }

    // 用户点了标题栏 X：外壳那一侧的引用由 FrameTick 的泵清掉；这里
    // 只要把可能开着的任务图右键菜单状态收掉，免得菜单悬在已经关掉
    // 的窗口坐标上。
    override void OnCloseRequested() {
        this.RetireSessionsPreparation();
        ZanIDE ide = ZanIDE.current;
        if (ide != null && ide.aiWin == this) {
            if (ide.ctxKind == 7) { ide.CloseIdeContextMenu(); }
            if (!ide.shuttingDown && !ide.closeRequested && ide.dock != null
            && ide.dock.Visible("agent")) {
                Rect area = ide.dock.PreviewContent(ide.app,
                ide.dock.Content("editor"), "agent");
                ide.PrepareAiSessionsView(ide.app, area);
            } else {
                ide.RetireAiSessionsView();
            }
        }
    }

    // 数据快照对比：任何一处外壳侧的小赞状态变了就重画。这里不追踪
    // 子窗口自己的控件状态（滚动、选区、悬停）——它们由子窗口的事件
    // 直接置 needsRedraw，不走这条判据。
    override bool Pending() {
        ZanIDE ide = ZanIDE.current;
        if (ide == null) { return false; }
        if (ide.aiBusy.Get() != sBusy) { return true; }
        if (ide.aiMsgs == null) { return false; }
        if (ide.aiMsgs.Count != sMsgCount) { return true; }
        if (ide.aiMsgs.Count > 0) {
            ChatMessage tail = ide.aiMsgs[ide.aiMsgs.Count - 1];
            if (tail == null) { return true; }
            if (tail.text.Length != sTailLen) { return true; }
        }
        if (ide.aiPlan != null && ide.aiPlan.Count != sPlanCount) { return true; }
        if (ide.aiTasks != null && ide.aiTasks.Count != sTaskCount) { return true; }
        if (ide.root != sRoot) { return true; }
        if (ide.aiModelSelSig != sModelSig) { return true; }
        if (ide.aiPendingCall != sPendingCall) { return true; }
        if (ide.aiTeamSt.activeTask != sActiveTask) { return true; }
        if (ide.aiGraphSel != sGraphSel) { return true; }
        if (ide.aiSendTo != sSendTo) { return true; }
        if (ide.aiSessCur != sSessCur) { return true; }
        if (ide.aiTeamOpen.Get() != sTeamOpen) { return true; }
        if (ide.aiTeamMode != sTeamModeB) { return true; }
        if (ide.aiAutoExec != sAutoExecB) { return true; }
        if (ide.aiProfActive != sProfActive) { return true; }
        return false;
    }

    // 帧后把当前值落进快照：下一轮 Pending 从这里起算。只在出帧后
    // 运行，所以「变了→出帧→落盘→安静」自然收敛。
    override void AfterFrame() {
        ZanIDE ide = ZanIDE.current;
        if (ide == null) { return; }
        sBusy = ide.aiBusy.Get();
        sMsgCount = 0;
        sTailLen = 0;
        if (ide.aiMsgs != null) {
            sMsgCount = ide.aiMsgs.Count;
            if (sMsgCount > 0) {
                ChatMessage tail = ide.aiMsgs[sMsgCount - 1];
                if (tail != null) { sTailLen = tail.text.Length; }
            }
        }
        sPlanCount = 0;
        if (ide.aiPlan != null) { sPlanCount = ide.aiPlan.Count; }
        sTaskCount = 0;
        if (ide.aiTasks != null) { sTaskCount = ide.aiTasks.Count; }
        sRoot = ide.root;
        sModelSig = ide.aiModelSelSig;
        sPendingCall = ide.aiPendingCall;
        sActiveTask = ide.aiTeamSt.activeTask;
        sGraphSel = ide.aiGraphSel;
        sSendTo = ide.aiSendTo;
        sSessCur = ide.aiSessCur;
        sTeamOpen = ide.aiTeamOpen.Get();
        sTeamModeB = ide.aiTeamMode;
        sAutoExecB = ide.aiAutoExec;
        sProfActive = ide.aiProfActive;
    }
}
