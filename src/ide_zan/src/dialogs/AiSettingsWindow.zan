using System;
using System.IO;
using System.Collections.Generic;
using Gui;
using Gui.Backend;
using Gui.Component.DataTable;

// 「小赞配置」子窗口宿主：管理 AI 服务商配置、预设与参数持久化
public class AiSettingsWindow : ChildWindow {
    bool saved;
    string lang;

    List<AiProfile> profiles;
    List<AiProfile> hold;
    string rolePrompts;
    List<ModelLimitRow> modelRows;
    int active;
    int sel;
    int modelSel;
    int tab;
    int autoCont;
    string curRoleId;
    Dictionary<string, string> state;

    AiSettingsDialog content;
    ListView<AiProfile> profileList;
    ListView<AiPreset> presetList;
    DataGrid<ModelLimitRow> limitGrid;

    List<AiPreset> presets;

    bool fetchBusy;

    static bool done;
    static bool add;
    static bool del;
    static bool save;
    static bool enable;
    static bool fetch;
    static bool preAdd;
    static bool reg;

    string Get(string key, string dflt) {
        if (state != null && state.ContainsKey(key)) { return state[key]; }
        return dflt;
    }

    int GetInt(string key, int dflt) {
        string s = this.Get(key, "");
        if (s == "") { return dflt; }
        return Convert.ToInt32(s);
    }

    static string T(string lang, string en, string zh) {
        if (lang == "zh") { return zh; }
        return en;
    }

    static void OnDone() { AiSettingsWindow.done = true; }
    static void OnAdd() { AiSettingsWindow.add = true; }
    static void OnDel() { AiSettingsWindow.del = true; }
    static void OnSave() { AiSettingsWindow.save = true; }
    static void OnEnable() { AiSettingsWindow.enable = true; }
    static void OnFetch() { AiSettingsWindow.fetch = true; }
    static void OnPreAdd() { AiSettingsWindow.preAdd = true; }
    static void OnReg() { AiSettingsWindow.reg = true; }

    static string OptionsText(List<string> xs) {
        string s = "";
        for (int i = 0; i < xs.Count; i = i + 1) {
            if (i > 0) { s = s + "|"; }
            s = s + xs[i];
        }
        return s;
    }

    override void OnCloseRequested() { AiSettingsWindow.OnDone(); }

    int SelClamped() {
        if (sel < 0 || sel >= profiles.Count) { return 0; }
        return sel;
    }

    void Hold() {
        for (int i = 0; i < profiles.Count; i = i + 1) {
            hold.Add(profiles[i]);
        }
    }

    void BuildUi() {
        content = new AiSettingsDialog();
        this.SetRoot(content, state);
        this.Handle("aiProfileAdd", AiSettingsWindow.OnAdd);
        this.Handle("aiProfileDelete", AiSettingsWindow.OnDel);
        this.Handle("aiProfileSave", AiSettingsWindow.OnSave);
        this.Handle("aiProfileEnable", AiSettingsWindow.OnEnable);
        this.Handle("aiModelsFetch", AiSettingsWindow.OnFetch);
        this.Handle("aiPresetAdd", AiSettingsWindow.OnPreAdd);
        this.Handle("aiPresetSignUp", AiSettingsWindow.OnReg);
        this.Wire();

        profileList = content.ProfileList();
        presetList = content.PresetList();
        limitGrid = content.LimitTable();
        profileList.OnSelect(this.ProfileSelected);
        presetList.OnSelect(this.PresetSelected);
        limitGrid.OnRowClick(this.LimitRowClicked);
        presetList.Bind(presets);
        this.Refresh();
    }

    // 把当前状态铺到界面上：文案、页签、当前页与逐模型限额表。
    // 每次配置切换/增删/抓取完成后调用（不重建控件树）。
    void Refresh() {
        this.SeedModelLimits();
        content.ApplyTexts(lang, fetchBusy);
        if (active < 0 || active >= profiles.Count) { active = 0; }
        content.SetActiveProfile(profiles[active]);
        this.RefreshTabs();
        profileList.Bind(profiles);
        if (sel >= 0 && sel < profiles.Count) {
            profileList.SelectIndex(sel);
        }
        limitGrid.Bind(modelRows);
        this.SyncFromModel();
    }

    // 页签标签：第一页是模型配置，之后每个助手一页（跟着界面语言走）。
    List<string> TabLabels() {
        List<string> labels = new List<string>();
        labels.Add(AiSettingsWindow.T(lang, "Models", "模型"));
        List<AiRole> rs = AiTeam.Roles();
        for (int r = 0; r < rs.Count; r = r + 1) {
            if (lang == "zh") { labels.Add(rs[r].zh); } else { labels.Add(rs[r].en); }
        }
        labels.Add(AiSettingsWindow.T(lang, "Behaviour", "行为"));
        return labels;
    }

    // 行为页的页签号（助手页之后的那一页）。
    int ActTab() { return AiTeam.Roles().Count + 1; }

    // 铺当前页：模型页只要下拉的选项，助手页换一次绑定路径与下拉选项，
    // 一套控件服务所有助手（不按成员数量堆控件）。
    void RefreshTabs() {
        List<AiRole> rs = AiTeam.Roles();
        if (tab < 0 || tab > this.ActTab()) { tab = 0; }
        bool act = tab == this.ActTab();
        content.SyncTabs(this.TabLabels(), tab);
        content.ShowPage(tab, act);

        AiProfile profile = profiles[SelClamped()];
        content.FillModelOptions(this.DefaultModelOptions(profile),
            profile.model);

        if (act) {
            curRoleId = "";
            content.FillAct();
            return;
        }
        if (tab == 0) { curRoleId = ""; return; }
        AiRole role = rs[tab - 1];
        curRoleId = role.id;
        string rname = role.en;
        if (lang == "zh") { rname = role.zh; }
        content.BindRolePrompt(role.id);
        // 助手的模型下拉列所有服务商的启用模型，和聊天框那个下拉同源。
        content.FillRole(rname, ZanIDE.AiModelOptions(profiles),
            ZanIDE.AiRoleModel(profile.roles, role.id));
    }

    // 默认模型下拉的选项：这家服务商抓到的全部模型（勾选与否是限额表
    // 的事），外加当前默认模型 —— 老配置里的模型可能已经不在最新的
    // 抓取结果里，漏掉它会让下拉选不中、保存时把默认模型改掉。
    List<string> DefaultModelOptions(AiProfile profile) {
        List<string> opts = ZanIDE.SplitList(profile.models);
        if (profile.model.IsNullOrEmpty()) { return opts; }
        for (int i = 0; i < opts.Count; i = i + 1) {
            if (opts[i] == profile.model) { return opts; }
        }
        opts.Insert(0, profile.model);
        return opts;
    }

    void ProfileSelected() {
        int idx = profileList.SelectedIndex();
        if (idx >= 0 && idx != sel) {
            state["sel"] = idx.ToString();
        }
    }

    void PresetSelected() {
        int idx = presetList.SelectedIndex();
        if (idx >= 0) {
            state["preset"] = idx.ToString();
        }
    }

    void LimitRowClicked() {
        int row = limitGrid.State().HitRow();
        if (row >= 0 && row < modelRows.Count) {
            string m = modelRows[row].model;
            profiles[SelClamped()].model = m;
            state["model"] = m;
        }
    }

    void LoadFields() {
        AiProfile profile = profiles[SelClamped()];
        state["name"] = profile.name;
        state["base"] = profile.baseUrl;
        state["key"] = profile.key;
        state["model"] = profile.model;
        curRoleId = "";
        this.SeedModelLimits();
        this.SeedRoleModels();
        this.SyncModelSel();
    }

    void SeedRoleModels() {
        List<AiRole> rs = AiTeam.Roles();
        for (int r = 0; r < rs.Count; r = r + 1) {
            string text = ZanIDE.AiRoleModel(rolePrompts, rs[r].id);
            if (text == "") { text = AiTeam.DefaultDuty(rs[r].id); }
            state["roleprompt_" + rs[r].id] = text;
        }
    }

    void CommitRoleModels() {
        if (curRoleId == "") { return; }
        AiProfile profile = profiles[SelClamped()];
        profile.roles = ZanIDE.AiRoleModelSet(profile.roles, curRoleId,
            content.RoleModelValue());
        string text = this.Get("roleprompt_" + curRoleId, "");
        if (text == AiTeam.DefaultDuty(curRoleId)) { text = ""; }
        rolePrompts = ZanIDE.AiRoleModelSet(rolePrompts, curRoleId, text);
    }

    void SeedModelLimits() {
        AiProfile profile = profiles[SelClamped()];
        List<string> mopts = ZanIDE.SplitList(profile.models);
        modelRows = new List<ModelLimitRow>();
        for (int m = 0; m < mopts.Count; m = m + 1) {
            int cv = ZanIDE.AiLimitInt(profile.limits, mopts[m], "ctx");
            int ov = ZanIDE.AiLimitInt(profile.limits, mopts[m], "out");
            bool vis = ZanIDE.AiLimitInt(profile.limits, mopts[m], "off") == 0;
            modelRows.Add(ModelLimitRow.Of(mopts[m], cv, ov, vis));
        }
    }

    void CommitModelLimits() {
        AiProfile profile = profiles[SelClamped()];
        string keep = profile.model;
        for (int m = 0; m < modelRows.Count; m = m + 1) {
            ModelLimitRow row = modelRows[m];
            profile.limits = ZanIDE.AiLimitSet(profile.limits, row.model, "ctx",
                ModelLimitRow.Fmt(row.ctx));
            profile.limits = ZanIDE.AiLimitSet(profile.limits, row.model, "out",
                ModelLimitRow.Fmt(row.maxOut));
            bool vis = row.visible || row.model == keep;
            profile.limits = ZanIDE.AiLimitSet(profile.limits, row.model, "off",
                vis ? "0" : "1");
        }
    }

    void SyncModelSel() {
        AiProfile profile = profiles[SelClamped()];
        List<string> mopts = ZanIDE.SplitList(profile.models);
        int idx = 0 - 1;
        for (int m = 0; m < mopts.Count; m = m + 1) {
            if (mopts[m] == profile.model) { idx = m; break; }
        }
        modelSel = idx;
        state["modelsel"] = idx.ToString();
    }

    void CommitFields() {
        AiProfile profile = profiles[SelClamped()];
        profile.name = this.Get("name", profile.name);
        profile.baseUrl = this.Get("base", profile.baseUrl);
        profile.key = this.Get("key", profile.key);
        profile.model = content.ModelValue(
            this.Get("model", profile.model));
        this.CommitModelLimits();
        this.CommitRoleModels();
        this.CommitAct();
    }

    // 行为页读回：留空 = 没配过（跟内置默认走），0 = 不限，其余就是拍数。
    void CommitAct() {
        string text = AiAgent.Trim(this.Get("autocont", ""));
        if (text == "") { autoCont = 0 - 1; return; }
        autoCont = ZanIDE.ParseInt(text);
    }

    void Persist() {
        ZanIDE.AiProfilesSave(active, profiles);
        ZanIDE.AiRolePromptsSave(rolePrompts);
        ZanIDE.AiAutoContSave(autoCont);
        saved = true;
    }

    void SetStatus(string text) {
        state["status"] = text;
    }

    static AiSettingsWindow Open(App parent, string uiLang) {
        AiSettingsWindow w = new AiSettingsWindow();
        w.lang = uiLang;
        w.open = true;
        w.saved = false;
        w.fetchBusy = false;
        AiSettingsWindow.done = false;
        AiSettingsWindow.add = false;
        AiSettingsWindow.del = false;
        AiSettingsWindow.save = false;
        AiSettingsWindow.enable = false;
        AiSettingsWindow.fetch = false;
        AiSettingsWindow.preAdd = false;
        AiSettingsWindow.reg = false;
        w.profiles = new List<AiProfile>();
        w.active = ZanIDE.AiProfilesLoad(w.profiles);
        w.hold = ZanIDE.AiProfilesHold(w.profiles);
        w.rolePrompts = ZanIDE.AiRolePromptsLoad();
        w.sel = w.active;
        w.presets = ZanIDE.AiPresets();
        w.state = new Dictionary<string, string>();
        w.state["sel"] = w.sel.ToString();
        w.state["preset"] = "0";
        w.state["status"] = "";
        w.state["ctx"] = "";
        w.state["out"] = "";
        w.autoCont = ZanIDE.AiAutoContLoad();
        string contText = "";
        if (w.autoCont >= 0) { contText = w.autoCont.ToString(); }
        w.state["autocont"] = contText;
        w.tab = 0;
        w.curRoleId = "";
        w.LoadFields();
        w.BuildUi();
        w.OpenHost(parent);
        return w;
    }

    override string Title() {
        return AiSettingsWindow.T(lang, "Xiao Zan settings", "小赞配置");
    }

    override int Width() { return 840; }
    override int Height() { return 780; }

    // 语言切换热生效：Refresh 重铺文案、页签与限额表（控件树与
    // 绑定不动，见 Refresh 文档）。
    override void OnLanguageChanged(string lang) {
        this.lang = lang;
        this.Refresh();
    }

    override bool Pending() { return fetchBusy; }

    // 配置行 / 模型列表变了：只刷新数据，保留控件树与绑定状态。
    void Rebuild() {
        this.Refresh();
        host.RequestRedraw();
    }

    int PresetIndex() {
        int p = this.GetInt("preset", 0);
        if (p < 0 || p >= presets.Count) { p = 0; }
        return p;
    }

    override void AfterFrame() {

        // 换页签：先把正在编辑的这一页收下来，再铺下一页。
        int nextTab = content.TakeTabChanged();
        if (nextTab >= 0 && nextTab != tab) {
            this.CommitFields();
            tab = nextTab;
            this.Rebuild();
        }

        int nextSel = this.GetInt("sel", sel);
        if (nextSel != sel && nextSel >= 0 && nextSel < profiles.Count) {
            this.CommitFields();
            sel = nextSel;
            this.LoadFields();
            this.Rebuild();
        }

        if (AiSettingsWindow.add) {
            AiSettingsWindow.add = false;
            this.CommitFields();
            profiles.Add(AiProfile.Create(AiSettingsWindow.T(lang, "AI ", "配置 ")
                + (profiles.Count + 1).ToString(),
                "https://api.openai.com/v1", "", "", "", "{}"));
            this.Hold();
            sel = profiles.Count - 1;
            state["sel"] = sel.ToString();
            this.LoadFields();
            this.Persist();
            this.Rebuild();
        }
        if (AiSettingsWindow.preAdd) {
            AiSettingsWindow.preAdd = false;
            int p = PresetIndex();
            this.CommitFields();
            AiPreset preset = presets[p];
            profiles.Add(AiProfile.Create(preset.name, preset.baseUrl, "", preset.model,
                "", "{}"));
            this.Hold();
            sel = profiles.Count - 1;
            state["sel"] = sel.ToString();
            this.LoadFields();
            this.Persist();
            this.SetStatus(AiSettingsWindow.T(
                lang, "Preset added - fill in the API key and Save & enable.",
                "已添加预设——请填入 API 密钥后“保存并启用”。"));
            this.Rebuild();
        }
        if (AiSettingsWindow.reg) {
            AiSettingsWindow.reg = false;
            ZanIDE.OpenExternal(presets[PresetIndex()].registrationUrl);
        }
        if (AiSettingsWindow.del) {
            AiSettingsWindow.del = false;
            if (profiles.Count > 1) {
                int i = SelClamped();
                profiles.RemoveAt(i);
                if (active >= profiles.Count) { active = 0; }
                if (sel >= profiles.Count) { sel = profiles.Count - 1; }
                state["sel"] = sel.ToString();
                this.LoadFields();
                this.Persist();
                this.Rebuild();
            } else {
                this.SetStatus(AiSettingsWindow.T(
                    lang, "At least one configuration is required.",
                    "至少保留一个配置。"));
                host.RequestRedraw();
            }
        }
        if (AiSettingsWindow.save || AiSettingsWindow.enable) {
            bool en = AiSettingsWindow.enable;
            AiSettingsWindow.save = false;
            AiSettingsWindow.enable = false;
            this.CommitFields();
            if (en) { active = SelClamped(); }
            this.Persist();
            if (en) {
                this.SetStatus(AiSettingsWindow.T(lang, "Saved and enabled ", "已保存并启用 ")
                    + profiles[SelClamped()].name);
            } else {
                this.SetStatus(AiSettingsWindow.T(lang, "Saved.", "已保存。"));
            }
            this.Rebuild();
        }
        if (AiSettingsWindow.fetch && !fetchBusy) {
            AiSettingsWindow.fetch = false;
            this.CommitFields();
            AiProfile profile = profiles[SelClamped()];
            string ferr = ZanIDE.AiFetchModels(profile.baseUrl, profile.key);
            if (ferr != "") {
                this.SetStatus(ferr);
            } else {
                fetchBusy = true;
                this.SetStatus(AiSettingsWindow.T(
                    lang, "Fetching model list...", "正在获取模型列表..."));
            }
            this.Rebuild();
        }
        AiSettingsWindow.fetch = false;
        if (fetchBusy) {
            if (File.Exists(ZanIDE.AiModelsDonePath())) {
                File.Delete(ZanIDE.AiModelsDonePath());
                fetchBusy = false;
                string gotModels = ZanIDE.AiReadModels();
                AiProfile profile = profiles[SelClamped()];
                if (gotModels != "") {
                    profile.models = gotModels;
                    List<string> gm = ZanIDE.SplitList(gotModels);
                    if (profile.model == "") {
                        profile.model = gm[0];
                        state["model"] = gm[0];
                    }
                    this.Persist();
                    this.SyncModelSel();
                    this.SetStatus(AiSettingsWindow.T(lang, "Fetched ", "已获取 ")
                        + gm.Count.ToString()
                        + AiSettingsWindow.T(lang, " models.", " 个模型。"));
                } else {
                    this.SetStatus(AiSettingsWindow.T(
                        lang, "Could not fetch models (check base URL / key).",
                        "获取模型失败（请检查接口地址和密钥）。"));
                }
                this.Rebuild();
            }
            host.RequestRedraw();
        }
        if (AiSettingsWindow.done) {
            AiSettingsWindow.done = false;
            this.CommitFields();
            this.Persist();
            open = false;
            host.window.Close();
        }
    }

    int Active() { return active; }

    bool TakeSaved() {
        bool v = saved;
        saved = false;
        return v;
    }
}
