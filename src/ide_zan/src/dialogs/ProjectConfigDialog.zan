using System;
using Gui;
using Gui.Widget;

/// 「项目配置」对话框的内容：配置页（应用图标、资源摘要、皮肤打包）
/// 与资源管理页，两页由上方的标签选择器切换。
///
/// 布局在 `ProjectConfigDialog.zform` 里声明；这里只填数据相关的
/// 文本、按语言给静态文案、按可用皮肤生成勾选项，以及切页。
partial class ProjectConfigDialog {
    void OnInit() {
        ProjectConfigDialog.Assets.SetShown(false);
    }

    /// 把项目状态铺到界面上：文案按 `lang`，图标/资源摘要按 `root`。
    void Fill(int lang, string root) {
        ProjectConfigDialog.TabConfig.SetProp("label",
            ProjectConfigDialog.Pick(lang, "Configuration", "配置"));
        ProjectConfigDialog.TabAssets.SetProp("label",
            ProjectConfigDialog.Pick(lang, "Assets", "资源"));
        ProjectConfigDialog.ProjectName.SetProp("text", Path.GetFileName(root));
        ProjectConfigDialog.IconCap.SetProp("text",
            ProjectConfigDialog.Pick(lang, "Application Icon", "应用图标"));

        string icon = ZanIDE.ProjField(root, "icon");
        if (icon == "") {
            icon = ProjectConfigDialog.Pick(lang,
                "(none — the default Zan icon is used)",
                "（无——使用默认 Zan 图标）");
        }
        ProjectConfigDialog.IconPath.SetProp("text", icon);
        ProjectConfigDialog.ChooseIcon.SetProp("text",
            ProjectConfigDialog.Pick(lang, "Choose .ico...", "选择 .ico..."));
        ProjectConfigDialog.ClearIcon.SetProp("text",
            ProjectConfigDialog.Pick(lang, "Clear", "清除"));

        ProjectConfigDialog.ResourcesCap.SetProp("text",
            ProjectConfigDialog.Pick(lang, "Resources", "资源"));
        List<string> copied = ZanIDE.ListResources(root);
        List<string> linked = ZanIDE.ProjLinks(root);
        ProjectConfigDialog.ResourceCounts.SetProp("text",
            Convert.ToString(copied.Count)
            + ProjectConfigDialog.Pick(lang, " copied asset(s), ", " 个复制资源，")
            + Convert.ToString(linked.Count)
            + ProjectConfigDialog.Pick(lang, " linked", " 个链接资源"));
        ProjectConfigDialog.AssetsHint1.SetProp("text",
            ProjectConfigDialog.Pick(lang,
                "The Assets tab imports files/folders, links resources, chooses embed",
                "「资源」标签页可导入文件/文件夹、链接资源、选择嵌入或复制，"));
        ProjectConfigDialog.AssetsHint2.SetProp("text",
            ProjectConfigDialog.Pick(lang,
                "vs copy, and authors 8-direction / frame-sequence animations.",
                "并编辑八方向 / 序列帧动画。"));

        ProjectConfigDialog.SkinsCap.SetProp("text",
            ProjectConfigDialog.Pick(lang, "Skins / Themes", "皮肤 / 主题"));
        ProjectConfigDialog.SkinsOn.SetProp("label",
            ProjectConfigDialog.Pick(lang,
                "Package skins with the built app (top-right skin picker)",
                "把皮肤打包进生成的应用（右上角皮肤切换）"));
        ProjectConfigDialog.SkinsHint.SetProp("text",
            ProjectConfigDialog.Pick(lang,
                "Off = smallest exe (base theme only). Tick the packs to bundle:",
                "关闭 = 最小体积（仅基础主题）。勾选要打包的皮肤："));
        ProjectConfigDialog.PublishHint.SetProp("text",
            ProjectConfigDialog.Pick(lang,
                "Resources are copied next to the published .exe (publish/assets).",
                "资源会复制到发布的 .exe 旁（publish/assets）。"));
        ProjectConfigDialog.IconHint.SetProp("text",
            ProjectConfigDialog.Pick(lang,
                "The icon is embedded into the .exe on Build/Run/Publish.",
                "图标会在 构建/运行/发布 时嵌入 .exe。"));
        ProjectConfigDialog.Done.SetProp("text",
            ProjectConfigDialog.Pick(lang, "Done", "完成"));

        this.FillSkins();
    }

    /// 每个可用皮肤一个勾选项，绑定到状态实体的 `skin_<名字>`。
    void FillSkins() {
        ScrollColumn list = ProjectConfigDialog.SkinList;
        list.RemoveAll();
        List<string> names = ZanIDE.AvailableSkinNames();
        for (int i = 0; i < names.Count; i = i + 1) {
            Checkbox cb = new Checkbox();
            cb.SetProp("label", names[i]);
            cb.Dock(Dock.Top());
            cb.Prefer(0, 24);
            cb.bindPath = "skin_" + names[i];
            list.Add(cb);
        }
    }

    /// 切页：0 配置，1 资源管理。两页都是 Fill，靠可见性互斥。
    void ShowTab(int tab) {
        ProjectConfigDialog.ConfigPage.SetShown(tab != 1);
        ProjectConfigDialog.Assets.SetShown(tab == 1);
    }

    static string Pick(int lang, string en, string zh) {
        if (lang == 1) { return zh; }
        return en;
    }
}
