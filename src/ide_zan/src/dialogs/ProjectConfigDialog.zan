using System;
using System.IO;
using System.Collections.Generic;
using Gui;
using Gui.Widget;

// 「项目与签名配置」对话框的内容：应用图标、打包选项、皮肤打包、
// 诊断/安全标志以及 Android/iOS/HarmonyOS/Windows 签名凭据。
partial class ProjectConfigDialog {
    void Fill(string lang, string root) {
        this.ProjectName.SetProp("text", Path.GetFileName(root));
        this.IconCap.SetProp("text",
            ProjectConfigDialog.Pick(lang, "Application Icon", "应用图标"));

        string icon = ZanIDE.ProjField(root, "icon");
        if (icon == "") {
            icon = ProjectConfigDialog.Pick(lang,
                "(none — the default Zan icon is used)",
                "（无——使用默认 Zan 图标）");
        }
        this.IconPath.SetProp("text", icon);
        this.ChooseIcon.SetText(ProjectConfigDialog.Pick(lang, "Choose .ico...", "选择 .ico..."));
        this.ClearIcon.SetText(ProjectConfigDialog.Pick(lang, "Clear", "清除"));

        this.ResourcesCap.SetProp("text",
            ProjectConfigDialog.Pick(lang, "Packaging & Resources", "打包与资源"));
        List<string> copied = ZanIDE.ListResources(root);
        List<string> linked = ZanIDE.ProjLinks(root);
        this.ResourceCounts.SetProp("text",
            copied.Count.ToString()
            + ProjectConfigDialog.Pick(lang, " asset file(s), ", " 个资源文件，")
            + linked.Count.ToString()
            + ProjectConfigDialog.Pick(lang, " linked", " 个链接资源"));
        this.SingleFileOn.SetLabel(ProjectConfigDialog.Pick(lang,
            "Single-file self-contained packaging (Windows)",
            "启用单文件自包含打包（Windows）"));
        this.PackAssetsOn.SetLabel(ProjectConfigDialog.Pick(lang,
            "Compress assets into assets.zrp archive",
            "将 assets 资源压缩打包为 assets.zrp"));
        this.PublishHint.SetProp("text", ProjectConfigDialog.Pick(lang,
            "When single-file is off, resources are copied next to the executable (publish/assets).",
            "未启用单文件时，资源会复制或打包至输出目录旁（publish/assets）。"));
        this.IconHint.SetProp("text", ProjectConfigDialog.Pick(lang,
            "The icon is embedded into the executable on Build/Run/Publish.",
            "图标会在 构建/运行/发布 时嵌入可执行文件。"));

        this.SkinsCap.SetProp("text",
            ProjectConfigDialog.Pick(lang, "Skins / Themes", "皮肤 / 主题"));
        this.SkinsOn.SetLabel(ProjectConfigDialog.Pick(lang,
            "Package additional skins with the built app",
            "把额外皮肤打包进生成的应用"));
        this.SkinsHint.SetProp("text", ProjectConfigDialog.Pick(lang,
            "Built-in skins are included by default. Select additional skins below.",
            "默认包含内置皮肤。可在下方选择要一同打包的额外皮肤。"));

        this.DiagCap.SetProp("text",
            ProjectConfigDialog.Pick(lang, "Diagnostics / Code Safety", "代码安全 / 诊断选项"));
        this.StrictMemOn.SetLabel(ProjectConfigDialog.Pick(lang,
            "Strict Memory Diagnostics (ArcGuard & LeakCheck)",
            "严格内存诊断（开启释放检疫与退出泄漏报告）"));
        this.StrictMemHint.SetProp("text", ProjectConfigDialog.Pick(lang,
            "Pins dangling/freed pointers immediately; reports unreleased objects at exit.",
            "将野指针/悬垂指针变为即时崩溃暴露，并在进程退出时打印未释放内存的分配位置。"));
        this.DenyWarningsOn.SetLabel(ProjectConfigDialog.Pick(lang,
            "Deny Warnings (Treat warnings as compilation errors)",
            "严苛编译模式（将警告视为编译错误）"));
        this.DenyWarningsHint.SetProp("text", ProjectConfigDialog.Pick(lang,
            "Blocks build on warnings to catch defects at compile time.",
            "存在编译警告时直接阻断编译，在编译期拦截潜在缺陷。"));

        this.PlatformCap.SetProp("text",
            ProjectConfigDialog.Pick(lang, "Target Platform Options", "目标平台选项"));
        this.MacMultiInstanceOn.SetLabel(ProjectConfigDialog.Pick(lang,
            "macOS multi-instance (allow opening multiple copies simultaneously)",
            "macOS 允许多开（双击启动独立新实例）"));
        this.MacMultiInstanceHint.SetProp("text", ProjectConfigDialog.Pick(lang,
            "Wraps the app launcher with open -n in Finder.",
            "在 macOS Finder 中双击应用时使用 open -n 启动新实例。"));

        this.SecurityCap.SetProp("text",
            ProjectConfigDialog.Pick(lang, "Code Protection / Release Security", "代码保护 / 发布安全选项"));
        this.StripSymbolsOn.SetLabel(ProjectConfigDialog.Pick(lang,
            "Strip Symbols on Publish (--strip-symbols)",
            "发布期剥离符号（--strip-symbols）"));
        this.StripSymbolsHint.SetProp("text", ProjectConfigDialog.Pick(lang,
            "Eliminates internal symbols from published native binaries.",
            "从发布的原生二进制中剥除内部函数与符号名。"));
        this.HideDiagnosticsOn.SetLabel(ProjectConfigDialog.Pick(lang,
            "Hide Source Diagnostics (--hide-diagnostics)",
            "脱敏诊断路径（--hide-diagnostics）"));
        this.HideDiagnosticsHint.SetProp("text", ProjectConfigDialog.Pick(lang,
            "Masks source filenames and line numbers into numeric Site IDs.",
            "将源码文件名与行号替换为数字代号，防止路径泄露。"));
        this.ObfStringsOn.SetLabel(ProjectConfigDialog.Pick(lang,
            "Obfuscate User Strings (--obfuscate-strings)",
            "加密用户字符串（--obfuscate-strings）"));
        this.ObfStringsHint.SetProp("text", ProjectConfigDialog.Pick(lang,
            "Encrypts string constants in readonly data.",
            "混淆只读数据段中的字符串字面量。"));

        this.SigningCap.SetProp("text",
            ProjectConfigDialog.Pick(lang, "Platform Signing Credentials", "平台证书与签名配置"));
        this.SigningHint.SetProp("text", ProjectConfigDialog.Pick(lang,
            "Leave blank to fall back to debug/unsigned packaging. Values are saved directly into zan.proj.",
            "留空将安全降级为调试证书或未签名包；填写内容直接保存进 zan.proj。"));
        this.LblAndroidKs.SetProp("text", ProjectConfigDialog.Pick(lang, "Android Keystore", "Android 密钥库"));
        this.LblAndroidAlias.SetProp("text", ProjectConfigDialog.Pick(lang, "Android Key Alias", "Android 密钥别名"));
        this.LblAndroidPass.SetProp("text", ProjectConfigDialog.Pick(lang, "Android Key Pass", "Android 密钥密码"));
        this.LblIosCert.SetProp("text", ProjectConfigDialog.Pick(lang, "iOS Certificate", "iOS 开发者证书"));
        this.LblIosProf.SetProp("text", ProjectConfigDialog.Pick(lang, "iOS Profile", "iOS 描述文件"));
        this.LblIosBundle.SetProp("text", ProjectConfigDialog.Pick(lang, "iOS Bundle ID", "iOS Bundle ID"));
        this.LblIosName.SetProp("text", ProjectConfigDialog.Pick(lang, "iOS App Name", "iOS 应用名称"));
        this.LblOhosCert.SetProp("text", ProjectConfigDialog.Pick(lang, "OHOS Cert (.cer)", "鸿蒙证书 (.cer)"));
        this.LblOhosProf.SetProp("text", ProjectConfigDialog.Pick(lang, "OHOS Profile (.p7b)", "鸿蒙描述 (.p7b)"));
        this.LblOhosAlias.SetProp("text", ProjectConfigDialog.Pick(lang, "OHOS Key Alias", "鸿蒙密钥别名"));
        this.LblOhosPass.SetProp("text", ProjectConfigDialog.Pick(lang, "OHOS Key Pass", "鸿蒙密钥密码"));
        this.LblWinCert.SetProp("text", ProjectConfigDialog.Pick(lang, "Windows Cert (.pfx)", "Windows 证书 (.pfx)"));
        this.LblWinPass.SetProp("text", ProjectConfigDialog.Pick(lang, "Windows Cert Pass", "Windows 证书密码"));

        this.Done.SetText(ProjectConfigDialog.Pick(lang, "Done", "完成"));
        this.FillSkins();
    }

    void FillSkins() {
        Panel list = this.SkinList;
        list.RemoveAll();
        List<string> names = ZanIDE.AvailableSkinNames();
        for (int i = 0; i < names.Count; i = i + 1) {
            Checkbox cb = new Checkbox();
            cb.SetProp("label", names[i]);
            cb.AddClass("small");
            cb.BindPath("skin_" + names[i]);
            list.Add(cb);
        }
    }

    static string Pick(string lang, string en, string zh) {
        if (lang == "zh") { return zh; }
        return en;
    }
}
