using System;
using Gui;

/// 「编辑器设置」对话框的内容：配色主题、字号、界面语言。
///
/// 界面在 `EditorSettingsDialog.zform` 里声明；每个控件的 `bind` 指向
/// 宿主窗口的状态实体路径（themeIdx / font / lang），宿主在每帧前后
/// 同步两边，所以这里没有一行取值/回写的代码，只负责按语言给文本。
partial class EditorSettingsDialog {
    void OnInit() {
        this.ApplyTexts(0);
    }

    /// 按界面语言（0=English，1=简体中文）刷新静态文本。主题名是
    /// 产品名，不翻译。
    void ApplyTexts(int lang) {
        this.ThemeCap.SetProp("text",
            EditorSettingsDialog.Pick(lang, "Color Theme", "配色主题"));
        this.FontCap.SetProp("text",
            EditorSettingsDialog.Pick(lang, "Font Size", "字体大小"));
        this.LangCap.SetProp("text",
            EditorSettingsDialog.Pick(lang, "Language", "界面语言"));
        this.ResetFont.SetProp("text",
            EditorSettingsDialog.Pick(lang, "Default", "默认"));
        this.Done.SetProp("text",
            EditorSettingsDialog.Pick(lang, "Done", "完成"));
        // 主题是一份可能变长的清单：用下拉一行放下，
        // 而不是每个主题占一行单选。
        string names = "";
        for (int i = 0; i < 6; i = i + 1) {
            if (i > 0) { names = names + "|"; }
            names = names + ZanIDE.EditorThemeName(i);
        }
        this.ThemeSel.SetProp("options", names);
    }

    static string Pick(int lang, string en, string zh) {
        if (lang == 1) { return zh; }
        return en;
    }
}
