using System;
using System.Collections.Generic;
using Gui;
using Gui.Backend;

// 「项目与签名配置」子窗口：负责状态实体、生命周期与 zan.proj 持久化回写。
public class ConfigWindow : ChildWindow {
    ProjectConfigDialog content;
    string root;
    List<string> log;
    string lang;
    Dictionary<string, string> state;
    static bool done;
    static bool choose;
    static bool clear;

    string Get(string key, string dflt) {
        if (state != null && state.ContainsKey(key)) { return state[key]; }
        return dflt;
    }

    static string T(string lang, string en, string zh) {
        if (lang == "zh") { return zh; }
        return en;
    }

    static void OnDone() { ConfigWindow.done = true; }
    static void OnChoose() { ConfigWindow.choose = true; }
    static void OnClear() { ConfigWindow.clear = true; }

    override void OnCloseRequested() { ConfigWindow.OnDone(); }

    void BuildUi() {
        content = new ProjectConfigDialog();
        content.Fill(lang, root);
        this.SetView(content, state);
        this.Handle("projectConfigDone", ConfigWindow.OnDone);
        this.Handle("projectIconChoose", ConfigWindow.OnChoose);
        this.Handle("projectIconClear", ConfigWindow.OnClear);
    }

    static ConfigWindow Open(App parent, string root, List<string> log, string uiLang) {
        ConfigWindow w = new ConfigWindow();
        w.root = root;
        w.log = log;
        w.lang = uiLang;
        w.open = true;
        ConfigWindow.done = false;
        ConfigWindow.choose = false;
        ConfigWindow.clear = false;

        w.state = new Dictionary<string, string>();
        w.state["singleFile"] = ZanIDE.ProjSingleFile(root) ? "1" : "0";
        w.state["packAssets"] = ZanIDE.PackEnabled(root) ? "1" : "0";
        w.state["skins"] = ZanIDE.ProjSkinsEnabled(root) ? "1" : "0";
        w.state["strictMemory"] = ZanIDE.ProjStrictMemory(root) ? "1" : "0";
        w.state["denyWarnings"] = ZanIDE.ProjDenyWarnings(root) ? "1" : "0";
        w.state["macMultiInstance"] = ZanIDE.ProjMacMultiInstance(root) ? "1" : "0";
        w.state["secStripSymbols"] = ZanIDE.ProjField(root, "secStripSymbols") == "0" ? "0" : "1";
        w.state["secHideDiagnostics"] = ZanIDE.ProjHideDiagnostics(root) ? "1" : "0";
        w.state["secObfStrings"] = ZanIDE.ProjProtectStrings(root) ? "1" : "0";

        w.state["androidKeystore"] = ZanIDE.ProjField(root, "androidKeystore");
        w.state["androidKeyAlias"] = ZanIDE.ProjField(root, "androidKeyAlias");
        w.state["androidKeyPass"] = ZanIDE.ProjField(root, "androidKeyPass");
        w.state["iosCert"] = ZanIDE.ProjField(root, "iosCert");
        w.state["iosProfile"] = ZanIDE.ProjField(root, "iosProfile");
        w.state["iosBundleId"] = ZanIDE.ProjField(root, "iosBundleId");
        w.state["iosName"] = ZanIDE.ProjField(root, "iosName");
        w.state["ohosCert"] = ZanIDE.ProjField(root, "ohosCert");
        w.state["ohosProfile"] = ZanIDE.ProjField(root, "ohosProfile");
        w.state["ohosKeyAlias"] = ZanIDE.ProjField(root, "ohosKeyAlias");
        w.state["ohosKeyPass"] = ZanIDE.ProjField(root, "ohosKeyPass");
        w.state["windowsCert"] = ZanIDE.ProjField(root, "windowsCert");
        w.state["windowsCertPass"] = ZanIDE.ProjField(root, "windowsCertPass");

        List<string> avail = ZanIDE.AvailableSkinNames();
        List<string> chosen = ZanIDE.ProjSkinList(root);
        for (int i = 0; i < avail.Count; i = i + 1) {
            string v = "0";
            for (int j = 0; j < chosen.Count; j = j + 1) {
                if (chosen[j] == avail[i]) { v = "1"; }
            }
            w.state["skin_" + avail[i]] = v;
        }
        w.BuildUi();
        w.OpenHost(parent);
        return w;
    }

    override string Title() {
        return ConfigWindow.T(lang, "Project & Signing Configuration", "项目与签名配置");
    }

    override int Width() { return 780; }
    override int Height() { return 760; }

    override void OnLanguageChanged(string lang) {
        this.lang = lang;
        content.Fill(lang, root);
    }

    override bool Pending() {
        return ConfigWindow.done || ConfigWindow.choose || ConfigWindow.clear;
    }

    void SyncBoolField(string stateKey, string projKey, string trueVal, string falseVal) {
        string mv = this.Get(stateKey, "");
        string target = (mv == "1" || mv == "true") ? trueVal : falseVal;
        if (ZanIDE.ProjField(root, projKey) != target) {
            ZanIDE.SetProjField(root, projKey, target);
        }
    }

    void SyncStrField(string key) {
        string val = this.Get(key, "");
        if (ZanIDE.ProjField(root, key) != val) {
            ZanIDE.SetProjField(root, key, val);
        }
    }

    override void AfterFrame() {
        if (ConfigWindow.clear) {
            ConfigWindow.clear = false;
            ZanIDE.SetProjectIcon(root, "");
            log.Add("> App icon cleared (default icon will be used).");
            content.Fill(lang, root);
            if (open) { host.RequestRedraw(); }
        }
        this.SyncPackagingOptions();
        this.SyncSkins();
        this.SyncBoolField("strictMemory", "strictMemory", "1", "0");
        this.SyncBoolField("denyWarnings", "denyWarnings", "1", "0");
        this.SyncBoolField("macMultiInstance", "macMultiInstance", "1", "0");
        this.SyncBoolField("secStripSymbols", "secStripSymbols", "1", "0");
        this.SyncBoolField("secHideDiagnostics", "secHideDiagnostics", "1", "0");
        this.SyncBoolField("secObfStrings", "secObfStrings", "1", "0");
        this.SyncSigningFields();
    }

    void SyncPackagingOptions() {
        this.SyncBoolField("singleFile", "singleFile", "true", "false");
        string mvPack = this.Get("packAssets", "1");
        bool wantPack = mvPack == "1" || mvPack == "true";
        if (ZanIDE.PackEnabled(root) != wantPack) {
            if (wantPack) { ZanIDE.EnablePack(root, log); } else { ZanIDE.DisablePack(root, log); }
        }
    }

    void SyncSigningFields() {
        ZanIDE.SetSigningConfig(root, "android",
            this.Get("androidKeystore", ""), "",
            this.Get("androidKeyPass", ""), this.Get("androidKeyAlias", ""));
        ZanIDE.SetSigningConfig(root, "ios",
            this.Get("iosCert", ""), this.Get("iosProfile", ""), "", "");
        this.SyncStrField("iosBundleId");
        this.SyncStrField("iosName");
        ZanIDE.SetSigningConfig(root, "ohos",
            this.Get("ohosCert", ""), this.Get("ohosProfile", ""),
            this.Get("ohosKeyPass", ""), this.Get("ohosKeyAlias", ""));
        ZanIDE.SetSigningConfig(root, "windows",
            this.Get("windowsCert", ""), "",
            this.Get("windowsCertPass", ""), "");
    }

    void SyncSkins() {
        this.SyncBoolField("skins", "skins", "1", "0");
        List<string> avail = ZanIDE.AvailableSkinNames();
        string list = "";
        for (int i = 0; i < avail.Count; i = i + 1) {
            string v = this.Get("skin_" + avail[i], "0");
            if (v == "1" || v == "true") {
                if (list != "") { list = list + ","; }
                list = list + avail[i];
            }
        }
        if (ZanIDE.ProjField(root, "skinlist") != list) {
            ZanIDE.SetProjField(root, "skinlist", list);
        }
    }

    bool TakeDone() {
        if (ConfigWindow.done) {
            ConfigWindow.done = false;
            open = false;
            return true;
        }
        return false;
    }

    bool TakeChoose() {
        if (ConfigWindow.choose) {
            ConfigWindow.choose = false;
            return true;
        }
        return false;
    }
}
