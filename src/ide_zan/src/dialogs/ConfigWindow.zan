using System;
using System.Json;
using Gui;
using Gui.Backend;

/// 「项目」子窗口：项目自身的一切——应用图标与资源摘要，以及资源
/// 管理器——同一个窗口的两页。窗口只做宿主：状态实体、生命周期、
/// 回写 zan.proj；界面由 `ProjectConfigDialog.html` 声明。
class ConfigWindow : ChildWindow {
    ProjectConfigDialog content;
    string root;
    List<string> log;
    string lang;        // UI language code: "zh" / "en"
    int tab;            // 0 configuration, 1 assets
    static bool done;
    static bool choose;
    static bool clear;

    static string T(string lang, string en, string zh) {
        if (lang == "zh") { return zh; }
        return en;
    }

    static void OnDone() { ConfigWindow.done = true; }
    static void OnChoose() { ConfigWindow.choose = true; }
    static void OnClear() { ConfigWindow.clear = true; }

    override void OnCloseRequested() { ConfigWindow.OnDone(); }

    void BuildUi() {
        content = new ProjectConfigDialog();
        content.Fill(lang, root);
        content.ShowTab(tab);
        this.SetRoot(content, model);
        this.Handle("projectConfigDone", ConfigWindow.OnDone);
        this.Handle("projectIconChoose", ConfigWindow.OnChoose);
        this.Handle("projectIconClear", ConfigWindow.OnClear);
        this.Wire();
    }

    static ConfigWindow Open(App parent, string root, List<string> log,
                             string uiLang, int tab) {
        ConfigWindow w = new ConfigWindow();
        w.root = root;
        w.log = log;
        w.lang = uiLang;
        w.tab = tab;
        w.open = true;
        ConfigWindow.done = false;
        ConfigWindow.choose = false;
        ConfigWindow.clear = false;
        AssetManager.BindView(root, log, uiLang);
        w.model = JsonValue.NewObject();
        w.model.Set("tab", JsonValue.NewNum(Convert.ToString(tab)));
        // 接口数据协议与执行契约。
        // 接口数据协议与执行契约。
        string skinsOn = "0";
        if (ZanIDE.ProjSkinsEnabled(root)) { skinsOn = "1"; }
        w.model.Set("skins", JsonValue.NewStr(skinsOn));
        string strictMem = "0";
        if (ZanIDE.ProjStrictMemory(root)) { strictMem = "1"; }
        w.model.Set("strictMemory", JsonValue.NewStr(strictMem));
        string denyWarn = "0";
        if (ZanIDE.ProjDenyWarnings(root)) { denyWarn = "1"; }
        w.model.Set("denyWarnings", JsonValue.NewStr(denyWarn));
        string macMulti = "0";
        if (ZanIDE.ProjMacMultiInstance(root)) { macMulti = "1"; }
        w.model.Set("macMultiInstance", JsonValue.NewStr(macMulti));
        List<string> avail = ZanIDE.AvailableSkinNames();
        List<string> chosen = ZanIDE.ProjSkinList(root);
        for (int i = 0; i < avail.Count; i = i + 1) {
            string v = "0";
            for (int j = 0; j < chosen.Count; j = j + 1) {
                if (chosen[j] == avail[i]) { v = "1"; }
            }
            w.model.Set("skin_" + avail[i], JsonValue.NewStr(v));
        }
        w.BuildUi();
        w.OpenHost(parent);
        return w;
    }

    override string Title() {
        return ConfigWindow.T(lang, "Project", "项目配置");
    }

    override int Width() { return 900; }
    override int Height() { return 760; }
    override int IdBase() { return 870000; }

    /// 语言切换热生效：重填两页的设计期文案（图标/资源状态都由
    /// Fill 自己重新读取，重复调用安全），并让资源管理器的静态
    /// 语言跟着走（BindView 才会刷新它，这里手动补上）。
    override void OnLanguageChanged(string lang) {
        this.lang = lang;
        AssetManager.lang = lang;
        content.Fill(lang, root);
    }

    override bool Pending() {
        return ConfigWindow.done || ConfigWindow.choose
            || ConfigWindow.clear || AssetManager.viewAction != 0;
    }

    override void AfterFrame() {
        if (ConfigWindow.clear) {
            ConfigWindow.clear = false;
            ZanIDE.SetProjectIcon(root, "");
            log.Add("> App icon cleared (default icon will be used).");
            content.Fill(lang, root);
            if (open) { host.RequestRedraw(); }
        }
        // 接口数据协议与执行契约。
        // 接口数据协议与执行契约。
        // 核心契约与执行状态转移规范。
        int picked = model.Int("tab", tab);
        if (picked != tab) {
            tab = picked;
            content.ShowTab(tab);
            if (open) { host.RequestRedraw(); }
        }
        this.SyncSkins();
        this.SyncDiagnostics();
        this.SyncPlatformOptions();
    }

    /// 接口数据协议与执行契约。
    /// 核心契约与语义定义。
    void SyncPlatformOptions() {
        string mi = "0";
        string mv = model.PathStr("macMultiInstance", "0");
        if (mv == "1" || mv == "true") { mi = "1"; }
        if (ZanIDE.ProjField(root, "macMultiInstance") != mi) {
            ZanIDE.SetProjField(root, "macMultiInstance", mi);
        }
    }

    /// 接口数据协议与执行契约。
    /// 核心契约与语义定义。
    void SyncDiagnostics() {
        string sm = "0";
        string mvSm = model.PathStr("strictMemory", "0");
        if (mvSm == "1" || mvSm == "true") { sm = "1"; }
        if (ZanIDE.ProjField(root, "strictMemory") != sm) {
            ZanIDE.SetProjField(root, "strictMemory", sm);
        }

        string dw = "0";
        string mvDw = model.PathStr("denyWarnings", "0");
        if (mvDw == "1" || mvDw == "true") { dw = "1"; }
        if (ZanIDE.ProjField(root, "denyWarnings") != dw) {
            ZanIDE.SetProjField(root, "denyWarnings", dw);
        }
    }

    /// 接口数据协议与执行契约。
    /// 接口数据协议与执行契约。
    void SyncSkins() {
        string enabled = "0";
        string mv = model.PathStr("skins", "0");
        if (mv == "1" || mv == "true") { enabled = "1"; }
        if (ZanIDE.ProjField(root, "skins") != enabled) {
            ZanIDE.SetProjField(root, "skins", enabled);
        }
        List<string> avail = ZanIDE.AvailableSkinNames();
        string list = "";
        for (int i = 0; i < avail.Count; i = i + 1) {
            string v = model.PathStr("skin_" + avail[i], "0");
            if (v == "1" || v == "true") {
                if (list != "") { list = list + ","; }
                list = list + avail[i];
            }
        }
        if (ZanIDE.ProjField(root, "skinlist") != list) {
            ZanIDE.SetProjField(root, "skinlist", list);
        }
    }

    /// 接口数据协议与执行契约。
    bool TakeDone() {
        if (ConfigWindow.done) {
            ConfigWindow.done = false;
            open = false;
            return true;
        }
        return false;
    }

    /// 接口数据协议与执行契约。
    bool TakeChoose() {
        if (ConfigWindow.choose) {
            ConfigWindow.choose = false;
            return true;
        }
        return false;
    }

    /// 接口数据协议与执行契约。
    /// 接口数据协议与执行契约。
    /// 核心契约与语义定义。
    int TakeAssetAction() {
        return AssetManager.TakeAction();
    }
}
