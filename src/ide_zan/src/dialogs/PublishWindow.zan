using System;
using System.Collections.Generic;
using Gui;
using Gui.Backend;
using Gui.Widget;

// 「发布」子窗口宿主：管理发布目标选项、状态及 zan.proj 配置同步
public class PublishWindow : ChildWindow {
    PublishDialog content;
    string root;
    List<PublishTargetOption> options;
    string lang;
    Dictionary<string, string> state;
    static bool publish;
    static bool cancel;

    string Get(string key, string dflt) {
        if (state != null && state.ContainsKey(key)) { return state[key]; }
        return dflt;
    }

    static string T(string lang, string en, string zh) {
        if (lang == "zh") { return zh; }
        return en;
    }

    static void OnPublish() { PublishWindow.publish = true; }
    static void OnCancel() { PublishWindow.cancel = true; }

    override void OnCloseRequested() { PublishWindow.OnCancel(); }

    void BuildUi() {
        content = new PublishDialog();
        content.Fill(lang, root);
        this.SetRoot(content, state);
        this.Handle("publishStart", PublishWindow.OnPublish);
        this.Handle("publishCancel", PublishWindow.OnCancel);
        this.Wire();
    }

    static PublishWindow OpenWithOptions(App parent, string root, List<PublishTargetOption> options, string uiLang) {
        PublishWindow w = new PublishWindow();
        w.root = root;
        w.options = options;
        w.lang = uiLang;
        w.open = true;
        PublishWindow.publish = false;
        PublishWindow.cancel = false;
        w.state = new Dictionary<string, string>();
        for (int i = 0; i < options.Count; i = i + 1) {
            string mi = i.ToString();
            string v = options[i].selected ? "1" : "0";
            w.state["plat_" + mi] = v;
        }
        if (ZanIDE.IsLibraryProject(root)) {
            string sl = "0";
            if (ZanIDE.ProjStaticLib(root)) { sl = "1"; }
            w.state["staticLib"] = sl;
        } else {
            string sf = "1";
            if (!ZanIDE.ProjSingleFile(root)) { sf = "0"; }
            w.state["singleFile"] = sf;
        }
        string pd = "0";
        if (ZanIDE.ProjPublishDebug(root)) { pd = "1"; }
        w.state["pubDebug"] = pd;
        string mi2 = "0";
        if (ZanIDE.ProjMacMultiInstance(root)) { mi2 = "1"; }
        w.state["macMultiInstance"] = mi2;
        w.BuildUi();
        w.OpenHost(parent);
        return w;
    }

    static PublishWindow Open(App parent, string root, List<int> sel, string uiLang) {
        List<PublishTargetOption> opts = new List<PublishTargetOption>();
        List<string> ids = ZanIDE.PublishTargetIds();
        for (int i = 0; i < ids.Count; i = i + 1) {
            bool s = i < sel.Count && sel[i] == 1;
            opts.Add(new PublishTargetOption(ids[i], ZanIDE.PublishTargetLabel(ids[i]), s));
        }
        PublishWindow w = PublishWindow.OpenWithOptions(parent, root, opts, uiLang);
        return w;
    }

    override string Title() {
        return PublishWindow.T(lang, "Publish Project", "发布项目");
    }

    override int Width() { return 470; }
    override int Height() { return 700; }

    // 语言切换热生效：重填窗口设计期文案（平台列表的勾选
    // 状态在 model 里，Fill 只改标签不动绑定，重复调用安全）。
    override void OnLanguageChanged(string lang) {
        this.lang = lang;
        content.Fill(lang, root);
    }

    override bool Pending() {
        return PublishWindow.publish || PublishWindow.cancel;
    }

    // 一个绑定开关的开/关。初始值以 "1"/"0" 写入状态实体，而
    // 勾选框回写的是 "true"/"false"，两种形式都要认。
    static bool On(string v) { return v == "1" || v == "true"; }

    void SyncFlags() {
        string platStr = "";
        for (int i = 0; i < options.Count; i = i + 1) {
            string v = this.Get("plat_" + i.ToString(), "0");
            bool on = PublishWindow.On(v);
            options[i].selected = on;
            if (on) {
                if (platStr != "") { platStr = platStr + ","; }
                platStr = platStr + options[i].id;
            }
        }
        if (ZanIDE.ProjField(root, "publishPlatforms") != platStr) {
            ZanIDE.SetProjField(root, "publishPlatforms", platStr);
        }
        if (ZanIDE.IsLibraryProject(root)) {
            bool want = PublishWindow.On(this.Get("staticLib", "0"));
            if (ZanIDE.ProjStaticLib(root) != want) {
                string sv = "false";
                if (want) { sv = "true"; }
                ZanIDE.SetProjField(root, "staticLib", sv);
            }
        } else {
            bool want = PublishWindow.On(this.Get("singleFile", "1"));
            if (ZanIDE.ProjSingleFile(root) != want) {
                string sv = "false";
                if (want) { sv = "true"; }
                ZanIDE.SetProjField(root, "singleFile", sv);
            }
            bool wantMi = PublishWindow.On(this.Get("macMultiInstance", "0"));
            if (ZanIDE.ProjMacMultiInstance(root) != wantMi) {
                string mv = "false";
                if (wantMi) { mv = "true"; }
                ZanIDE.SetProjField(root, "macMultiInstance", mv);
            }
        }
        bool wantDbg = PublishWindow.On(this.Get("pubDebug", "0"));
        if (ZanIDE.ProjPublishDebug(root) != wantDbg) {
            string dv = "false";
            if (wantDbg) { dv = "true"; }
            ZanIDE.SetProjField(root, "pubDebug", dv);
        }
    }

    override void AfterFrame() {
        this.SyncFlags();
    }

    bool TakePublish() {
        if (PublishWindow.publish) {
            PublishWindow.publish = false;
            this.SyncFlags();
            bool hasTarget = false;
            for (int i = 0; i < options.Count; i = i + 1) {
                if (options[i].selected) { hasTarget = true; }
            }
            if (!hasTarget) {
                Layer.Msg(PublishWindow.T(lang, "Select at least one publish target.",
                    "请至少选择一个发布平台。"), 2);
                return false;
            }
            open = false;
            return true;
        }
        return false;
    }

    bool TakeCancel() {
        if (PublishWindow.cancel) {
            PublishWindow.cancel = false;
            open = false;
            return true;
        }
        return false;
    }
}
