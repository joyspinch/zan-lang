using Gui;

// This registration borrows the child; late input cannot keep a closed window alive.
class IdeAiWindowPreparation : AppLoopParticipant, AppPreparationParticipant {
    private weak AiAssistantWindow owner;

    public IdeAiWindowPreparation(AiAssistantWindow owner) { this.owner = owner; }
    public int NextDeadline() { return -1; }
    public void Tick(App app, int now) { }
    public void BeforeInput(App app, int kind) {
        AiAssistantWindow window = owner;
        if (window != null) { window.PrepareSessionsHost(app); }
    }
    public void BeforePaint(App app, int frameSequence) {
        AiAssistantWindow window = owner;
        if (window != null) { window.PrepareSessionsHost(app); }
    }
}
