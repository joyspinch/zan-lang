using System;
using Gui;
using Gui.Widget;

/// 「发布」对话框的内容：按宿主平台列出的目标平台勾选项、单文件 /
/// 静态库伴生开关、构建模式，以及发布 / 取消。
///
/// 布局在 `PublishDialog.zform` 里声明；平台列表按 `PublishTargetIds()`
/// 生成，绑定到状态实体的 `plat_<序号>`。
partial class PublishDialog {
    void OnInit() { }

    void Fill(int lang, string root) {
        string projName = Path.GetFileName(root);
        if (projName == "") { projName = "project"; }
        this.ProjectCap.SetProp("text",
            PublishDialog.Pick(lang, "Project: ", "项目：") + projName);
        this.PlatformsCap.SetProp("text",
            PublishDialog.Pick(lang, "Platforms", "目标平台"));
        this.ModeCap.SetProp("text",
            PublishDialog.Pick(lang, "Build mode", "构建模式"));
        this.DebugBuild.SetProp("label", PublishDialog.Pick(lang,
            "Debug build (-g: keep symbols, source locations, runtime checks)",
            "Debug 构建（-g：保留符号、源码位置与运行时检查）"));
        this.Cancel.SetProp("text",
            PublishDialog.Pick(lang, "Cancel", "取消"));
        this.Publish.SetProp("text",
            PublishDialog.Pick(lang, "Publish", "发布"));

        bool anyLinux = this.FillPlatforms();
        this.LinuxHint1.SetShown(anyLinux);
        this.LinuxHint2.SetShown(anyLinux);
        if (anyLinux) {
            this.LinuxHint1.SetProp("text", PublishDialog.Pick(lang,
                "Linux is cross-compiled here as a static single file.",
                "Linux 为本机交叉编译的静态单文件产物。"));
            this.LinuxHint2.SetProp("text", PublishDialog.Pick(lang,
                "Run it on Linux (a server or container).",
                "需在 Linux（服务器或容器）上运行。"));
        }

        // 库项目发布静态库，程序项目打包单文件 exe：同一个位置，
        // 两种含义,所以绑定路径也随项目类型切换。
        if (ZanIDE.IsLibraryProject(root)) {
            this.Companion.bindPath = "staticLib";
            this.Companion.SetProp("label", PublishDialog.Pick(lang,
                "Also publish static libraries (.lib on Windows, .a elsewhere)",
                "同时发布静态库（Windows 为 .lib，其余平台为 .a）"));
        } else {
            this.Companion.bindPath = "singleFile";
            this.Companion.SetProp("label", PublishDialog.Pick(lang,
                "Single-file exe (bundle DLLs into a self-extracting exe, Windows)",
                "打包为单文件（把 DLL 打进自解压 exe，仅 Windows）"));
        }
    }

    /// 每个可发布目标一个勾选项；返回是否含 Linux 目标（决定提示行）。
    bool FillPlatforms() {
        ScrollColumn list = this.Platforms;
        list.RemoveAll();
        bool anyLinux = false;
        List<string> ids = ZanIDE.PublishTargetIds();
        for (int i = 0; i < ids.Count; i = i + 1) {
            Checkbox cb = new Checkbox();
            cb.SetProp("label", ZanIDE.PublishTargetLabel(ids[i]));
            cb.Dock(Dock.Top());
            cb.logH = 26;
            cb.bindPath = "plat_" + Convert.ToString(i);
            list.Add(cb);
            if (ids[i].Length > 6 && ids[i].Substring(0, 6) == "linux-") {
                anyLinux = true;
            }
        }
        return anyLinux;
    }

    static string Pick(int lang, string en, string zh) {
        if (lang == 1) { return zh; }
        return en;
    }
}
