          "dock": 1,
          "fh": 34
        },
        {
          "kind": "Label",
          "name": "RolePromptCap",
          "class": "small",
          "dock": 1,
          "fh": 22
        },
        {
          "kind": "TextArea",
          "name": "RolePrompt",
