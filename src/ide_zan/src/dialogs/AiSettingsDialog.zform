{
  "name": "AiSettingsDialog",
  "role": "control",
  "layoutMode": 1,
  "fields": [
    {
      "kind": "Tabs",
      "name": "TabBar",
      "dock": 1,
      "fh": 0
    },
    {
      "kind": "Panel",
      "name": "ModelsPage",
      "dock": 5,
      "pad": 16,
      "gap": 14,
      "kids": [
        {
          "kind": "Panel",
          "name": "Left",
          "dock": 3,
          "fw": 230,
          "gap": 6,
          "kids": [
            {
              "kind": "Label",
              "name": "ConfigsCap",
              "class": "secondary small",
              "dock": 1,
              "fh": 20
            },
            {
              "kind": "ListView",
              "of": "AiProfile",
              "name": "Profiles",
              "dock": 1,
              "fh": 180
            },
            {
              "kind": "Panel",
              "name": "ConfigRow",
              "dock": 1,
              "fh": 34,
              "gap": 8,
              "kids": [
                {
                  "kind": "Button",
                  "name": "NewProfile",
                  "class": "small",
                  "dock": 3,
                  "fw": 106,
                  "onClick": "aiProfileAdd"
                },
                {
                  "kind": "Button",
                  "name": "DeleteProfile",
                  "class": "small",
                  "dock": 4,
                  "fw": 106,
                  "onClick": "aiProfileDelete"
                }
              ]
            },
            {
              "kind": "Label",
              "name": "PresetsCap",
              "class": "secondary small",
              "dock": 1,
              "fh": 22
            },
            {
              "kind": "ListView",
              "of": "AiPreset",
              "name": "Presets",
              "dock": 1,
              "fh": 140
            },
            {
              "kind": "Panel",
              "name": "PresetActions",
              "dock": 1,
              "fh": 34,
              "gap": 8,
              "kids": [
                {
                  "kind": "Button",
                  "name": "SignUp",
                  "class": "small",
                  "dock": 4,
                  "fw": 70,
                  "onClick": "aiPresetSignUp"
                },
                {
                  "kind": "Button",
                  "name": "AddPreset",
                  "class": "small",
                  "dock": 5,
                  "onClick": "aiPresetAdd"
                }
              ]
            }
          ]
        },
        {
          "kind": "Panel",
          "name": "Right",
          "dock": 5,
          "gap": 6,
          "kids": [
            {
              "kind": "Label",
              "name": "NameCap",
              "class": "small",
              "dock": 1,
              "fh": 22
            },
            {
              "kind": "Input",
              "name": "Name",
              "dock": 1,
              "fh": 34,
              "bind": "name"
            },
            {
              "kind": "Label",
              "name": "EndpointCap",
              "class": "small",
              "dock": 1,
              "fh": 22
            },
            {
              "kind": "Input",
              "name": "Endpoint",
              "placeholder": "https://api.openai.com/v1",
              "dock": 1,
              "fh": 34,
              "bind": "base"
            },
            {
              "kind": "Label",
              "name": "KeyCap",
              "class": "small",
              "dock": 1,
              "fh": 22
            },
            {
              "kind": "Input",
              "name": "Key",
              "placeholder": "sk-...",
              "dock": 1,
              "fh": 34,
              "bind": "key",
              "props": { "iconLead": "lock", "password": "true" }
            },
            {
              "kind": "Label",
              "name": "ModelCap",
              "class": "small",
              "dock": 1,
              "fh": 22
            },
            {
              "kind": "Panel",
              "name": "ModelRow",
              "dock": 1,
              "fh": 34,
              "gap": 8,
              "kids": [
                {
                  "kind": "Button",
                  "name": "Fetch",
                  "class": "small",
                  "dock": 4,
                  "fw": 100,
                  "onClick": "aiModelsFetch"
                },
                {
                  "kind": "SelectBox",
                  "name": "ModelPick",
                  "dock": 5
                },
                {
                  "kind": "Input",
                  "name": "Model",
                  "placeholder": "gpt-4o-mini",
                  "dock": 5,
                  "bind": "model"
                }
              ]
            },
            {
              "kind": "Label",
              "name": "Status",
              "class": "small",
              "dock": 1,
              "fh": 22,
              "bind": "status",
              "bindProp": "text"
            },
            {
              "kind": "Panel",
              "name": "ActionRow",
              "dock": 2,
              "fh": 40,
              "gap": 10,
              "kids": [
                {
                  "kind": "Button",
                  "name": "Save",
                  "class": "small",
                  "dock": 3,
                  "fw": 110,
                  "onClick": "aiProfileSave"
                },
                {
                  "kind": "Button",
                  "name": "SaveEnable",
                  "class": "primary small",
                  "dock": 3,
                  "fw": 150,
                  "onClick": "aiProfileEnable"
                }
              ]
            },
            {
              "kind": "Label",
              "name": "LimitsCap",
              "class": "secondary small",
              "dock": 1,
              "fh": 22
            },
            {
              "kind": "DataGrid",
              "of": "ModelLimitRow",
              "name": "Limits",
              "dock": 5
            }
          ]
        }
      ]
    },
