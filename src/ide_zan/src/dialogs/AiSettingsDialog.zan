using System;
using Gui;
using Gui.Widget;
using Gui.Component.DataTable;

/// 「小赞配置」对话框的内容：页签条下面第一页是模型配置（已保存的配置、
/// 官方预设、接口地址与密钥、默认模型下拉、逐模型的上下文/最大输出表），
/// 之后每个助手各一页（自己的模型与提示词）。
///
/// 布局在 `AiSettingsDialog.zform` 里声明；这里只做与数据有关的部分：
/// 行模板、表格列、按语言的文案，以及页签与助手页的填充。
partial class AiSettingsDialog {
    int lang;
    /// 当前启用的配置，行模板据此加「已启用」后缀。
    AiProfile activeProfile;
    /// 页签标签的上一份内容：只有真的变了才重建那条页签条。
    List<string> tabLbls;
    /// 助手页模型下拉的候选（与聊天框同一来源）：下拉里显示的是
    /// 「服务商 / 模型」，存回配置的必须是真正的模型 id，所以选项和
    /// 候选实体一起留着，不靠显示文本反推。
    List<ModelOption> roleOpts;

    void OnInit() {
        lang = 0;
        activeProfile = null;
        tabLbls = null;
        roleOpts = new List<ModelOption>();
        this.Profiles.WithRow(this.ProfileRow);
        this.Presets.WithRow(this.PresetRow);
        this.Limits.BoolCol("Show", 60, r => r.visible)
            .Editable((ModelLimitRow r, string v) => {
                r.visible = DataTable.ParseBool(v);
            });
        this.Limits.Col("Model", 220, r => r.model);
        this.Limits.NumCol("Context", 90, r => r.ctx)
            .Editable((ModelLimitRow r, string v) => {
                r.ctx = ZanIDE.ParseInt(v);
            });
        this.Limits.NumCol("Max out", 90, r => r.maxOut)
            .Editable((ModelLimitRow r, string v) => {
                r.maxOut = ZanIDE.ParseInt(v);
            });
    }

    ListView<AiProfile> ProfileList() { return this.Profiles; }
    ListView<AiPreset> PresetList() { return this.Presets; }
    DataGrid<ModelLimitRow> LimitTable() { return this.Limits; }
    SelectBox ModelPicker() { return this.ModelPick; }

    /// 哪个配置正在生效由宿主给出（保存/启用后会变）。
    void SetActiveProfile(AiProfile p) { activeProfile = p; }

    Control ProfileRow(AiProfile p) {
        string suffix = "";
        if (p == activeProfile) {
            suffix = AiSettingsDialog.Pick(lang, "  (enabled)", "（已启用）");
        }
        Label lbl = new Label(p.name + suffix);
        lbl.Class = "secondary small";
        return lbl;
    }

    Control PresetRow(AiPreset p) {
        Label lbl = new Label(p.name);
        lbl.Class = "secondary small";
        return lbl;
    }

    /// 页签条：第 0 页是模型配置，之后每个助手一页。标签跟着界面语言
    /// 走，只有真的变了才重建。
    void SyncTabs(List<string> labels, int active) {
        if (tabLbls == null || !ZanIDE.StringListsEqual(tabLbls, labels)) {
            this.TabBar.Clear();
            for (int i = 0; i < labels.Count; i = i + 1) {
                this.TabBar.Add(labels[i], false);
            }
            tabLbls = labels;
        }
        this.TabBar.Select(active);
        this.TabBar.TakeChanged();
    }

    /// 用户这一帧点了哪个页签（没点则 -1）。
    int TakeTabChanged() { return this.TabBar.TakeChanged(); }

    void ShowPage(int tab) {
        this.ModelsPage.SetShown(tab == 0);
        this.RolePage.SetShown(tab > 0);
    }

    /// 默认模型：拉到过模型列表就用下拉选，还没有列表时回落成手输，
    /// 这样第一次配置（还没有密钥/接口）也填得进去。
    void FillModelOptions(List<string> models, string current) {
        bool has = models.Count > 0;
        this.ModelPick.SetShown(has);
        this.Model.SetShown(!has);
        if (!has) { return; }
        this.ModelPick.SetOptionsText(
            AiSettingsDialog.Options(models));
        this.ModelPick.Select(
            AiSettingsDialog.IndexOf(models, current));
    }

    /// 一个助手页：名字、说明、模型下拉（第一项＝跟随默认模型）与提示词。
    /// `opts` 是聊天框那套「启用模型」候选，所以两处列的东西一样。
    void FillRole(string title, List<ModelOption> opts, string current) {
        this.RoleTitle.SetProp("text", title);
        this.RoleDuty.SetProp("text", AiSettingsDialog.Pick(lang,
            "Its own model (first entry = follow the default model) and its own"
            + " prompt (clear it to fall back to the built-in one).",
            "这个助手自己的模型（第一项＝跟随默认模型）与自己的提示词"
            + "（清空则回到内置默认提示词）。"));
        this.RoleModelCap.SetProp("text",
            AiSettingsDialog.Pick(lang, "Model", "模型"));
        this.RolePromptCap.SetProp("text",
            AiSettingsDialog.Pick(lang, "Prompt", "提示词"));

        roleOpts = opts;
        List<string> labels = new List<string>();
        labels.Add(AiSettingsDialog.Pick(lang, "(default model)", "（默认模型）"));
        int sel = 0;
        for (int i = 0; i < opts.Count; i = i + 1) {
            labels.Add(opts[i].label);
            if (sel == 0 && opts[i].model == current) { sel = i + 1; }
        }
        this.RoleModel.SetOptionsText(
            AiSettingsDialog.Options(labels));
        this.RoleModel.Select(sel);
    }

    /// 助手页的提示词框绑到 `roleprompt_<id>`，一套控件服务所有助手，
    /// 切页只换绑定路径，不重建控件。
    void BindRolePrompt(string roleId) {
        this.RolePrompt.bindPath = "roleprompt_" + roleId;
    }

    /// 当前助手页选中的模型 id（跟随默认模型时是 ""）。存的是候选实体里
    /// 的模型 id，不是下拉显示的「服务商 / 模型」文本。
    string RoleModelValue() {
        int i = this.RoleModel.Value();
        if (i <= 0 || i > roleOpts.Count) { return ""; }
        return roleOpts[i - 1].model;
    }

    /// 默认模型下拉当前选中的模型（没有列表时用手输框的值）。
    string ModelValue(string fallback) {
        if (this.ModelPick.HasValue()) {
            return this.ModelPick.Text();
        }
        return fallback;
    }

    static string Options(List<string> xs) {
        string s = "";
        for (int i = 0; i < xs.Count; i = i + 1) {
            if (i > 0) { s = s + "|"; }
            s = s + xs[i];
        }
        return s;
    }

    static int IndexOf(List<string> xs, string v) {
        for (int i = 0; i < xs.Count; i = i + 1) {
            if (xs[i] == v) { return i; }
        }
        return 0 - 1;
    }

    /// 按界面语言刷新静态文案；`fetchBusy` 只影响「获取模型」按钮。
    void ApplyTexts(int uiLang, bool fetchBusy) {
        lang = uiLang;
        this.ConfigsCap.SetProp("text",
            AiSettingsDialog.Pick(lang, "Configurations", "配置列表"));
        this.NewProfile.SetProp("text",
            AiSettingsDialog.Pick(lang, "New", "新增"));
        this.DeleteProfile.SetProp("text",
            AiSettingsDialog.Pick(lang, "Delete", "删除"));
        this.PresetsCap.SetProp("text",
            AiSettingsDialog.Pick(lang, "Presets", "预设"));
        this.SignUp.SetProp("text",
            AiSettingsDialog.Pick(lang, "Sign up", "注册"));
        this.AddPreset.SetProp("text",
            AiSettingsDialog.Pick(lang, "Add preset", "用预设新增"));

        this.NameCap.SetProp("text",
            AiSettingsDialog.Pick(lang, "Name", "名称"));
        this.EndpointCap.SetProp("text",
            AiSettingsDialog.Pick(lang, "Endpoint (OpenAI-compatible, /v1)",
                "接口地址（兼容 OpenAI，/v1）"));
        this.KeyCap.SetProp("text",
            AiSettingsDialog.Pick(lang, "API Key / Token", "API 密钥 / Token"));
        this.ModelCap.SetProp("text",
            AiSettingsDialog.Pick(lang, "Default model", "默认模型"));
        this.SetFetchBusy(fetchBusy);
        this.Save.SetProp("text",
            AiSettingsDialog.Pick(lang, "Save", "保存"));
        this.SaveEnable.SetProp("text",
            AiSettingsDialog.Pick(lang, "Save & enable", "保存并启用"));
        this.LimitsCap.SetProp("text",
            AiSettingsDialog.Pick(lang,
                "Tick the models to offer in the chat picker; set each one's"
                + " context / max-output (tokens, blank = default 200000)",
                "勾选要在聊天模型列表里显示的模型；并设置各自的"
                + "上下文 / 最大输出（tokens，留空 = 默认 200000）"));
    }

    void SetFetchBusy(bool busy) {
        string label = AiSettingsDialog.Pick(lang, "Fetch models", "获取模型");
        if (busy) {
            label = AiSettingsDialog.Pick(lang, "Fetching...", "获取中...");
        }
        this.Fetch.SetProp("text", label);
    }

    static string Pick(int lang, string en, string zh) {
        if (lang == 1) { return zh; }
        return en;
    }
}
