using Gui;

class AiSettingsRowEvents {
    public weak AiSettingsDialog owner;
    public Control Profile(AiProfile profile) {
        AiSettingsDialog target = owner;
        return target != null ? target.ProfileRow(profile) : null;
    }
    public Control Preset(AiPreset preset) {
        AiSettingsDialog target = owner;
        return target != null ? target.PresetRow(preset) : null;
    }
}

class AiSettingsTabEvents {
    public weak AiSettingsWindow owner;
    public weak Control profiles;
    public weak Control presets;
    public weak Control limits;
    public void ProfileSelected() {
        AiSettingsWindow target = owner;
        if (target != null && target.IsOpen() && target.profileList == profiles) { target.ProfileSelected(); }
    }
    public void PresetSelected() {
        AiSettingsWindow target = owner;
        if (target != null && target.IsOpen() && target.presetList == presets) { target.PresetSelected(); }
    }
    public void LimitSelected() {
        AiSettingsWindow target = owner;
        if (target != null && target.IsOpen() && target.limitGrid == limits) { target.LimitRowClicked(); }
    }
    public void Changed(Control sender) {
        AiSettingsWindow target = owner;
        if (target != null) { target.TabPicked(sender); }
    }
}
