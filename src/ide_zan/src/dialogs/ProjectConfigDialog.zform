{
  "name": "ProjectConfigDialog",
  "role": "control",
  "layoutMode": 1,
  "fields": [
    {
      "kind": "Panel",
      "name": "Tabs",
      "props": { "style": "3" },
      "dock": 1,
      "fh": 40,
      "pad": 10,
      "gap": 8,
      "kids": [
        {
          "kind": "Radio",
          "name": "TabConfig",
          "dock": 3,
          "fw": 110,
          "bind": "tab",
          "props": { "option": "0" }
        },
        {
          "kind": "Radio",
          "name": "TabAssets",
          "dock": 3,
          "fw": 110,
          "bind": "tab",
          "props": { "option": "1" }
        }
      ]
    },
    {
      "kind": "AssetPanel",
      "name": "Assets",
      "dock": 5
    },
    {
      "kind": "Panel",
      "name": "ConfigPage",
      "props": { "style": "3" },
      "dock": 5,
      "pad": 16,
      "gap": 6,
      "kids": [
        {
          "kind": "Label",
          "name": "ProjectName",
          "class": "title",
          "dock": 1,
          "fh": 26
        },
        {
          "kind": "Label",
          "name": "IconCap",
          "class": "secondary small",
          "dock": 1,
          "fh": 20
        },
        {
          "kind": "Panel",
          "name": "IconRow",
          "props": { "style": "3" },
          "dock": 1,
          "fh": 32,
          "gap": 8,
          "kids": [
            {
              "kind": "Button",
              "name": "ChooseIcon",
              "class": "primary small",
              "dock": 3,
              "fw": 130,
              "onClick": "projectIconChoose"
            },
            {
              "kind": "Button",
              "name": "ClearIcon",
              "class": "ghost small",
              "dock": 3,
              "fw": 70,
              "onClick": "projectIconClear"
            },
            {
              "kind": "Label",
              "name": "IconPath",
              "class": "small",
              "dock": 5
            }
          ]
        },
        {
          "kind": "Label",
          "name": "IconHint",
          "class": "secondary small",
          "dock": 1,
          "fh": 18
        },
        {
          "kind": "Label",
          "name": "ResourcesCap",
          "class": "secondary small",
          "dock": 1,
          "fh": 22
        },
        {
          "kind": "Label",
          "name": "ResourceCounts",
          "dock": 1,
          "fh": 22
        },
        {
          "kind": "Label",
          "name": "AssetsHint1",
          "class": "secondary small",
          "dock": 1,
          "fh": 16
        },
        {
          "kind": "Label",
          "name": "AssetsHint2",
          "class": "secondary small",
          "dock": 1,
          "fh": 16
        },
        {
          "kind": "Label",
          "name": "PublishHint",
          "class": "secondary small",
          "dock": 1,
          "fh": 18
        },
        {
          "kind": "Label",
          "name": "SkinsCap",
          "class": "secondary small",
          "dock": 1,
          "fh": 22
        },
        {
          "kind": "Checkbox",
          "name": "SkinsOn",
          "dock": 1,
          "fh": 26,
          "bind": "skins"
        },
        {
          "kind": "Label",
          "name": "SkinsHint",
          "class": "secondary small",
          "dock": 1,
          "fh": 18
        },
        {
          "kind": "Panel",
          "name": "DoneRow",
          "props": { "style": "3" },
          "dock": 2,
          "fh": 44,
          "gap": 10,
          "kids": [
            {
              "kind": "Button",
              "name": "Done",
              "class": "primary small",
              "dock": 4,
              "fw": 110,
              "onClick": "projectConfigDone"
            }
          ]
        },
        {
          "kind": "ScrollColumn",
          "name": "SkinList",
          "dock": 5,
          "gap": 2
        }
      ]
    }
  ]
}
