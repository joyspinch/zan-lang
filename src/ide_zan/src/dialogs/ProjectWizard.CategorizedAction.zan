// Child event subscriptions retain this action, never the wizard.
public class WizardCategorizedAction {
    public weak Wizard owner;
    public int kind;
    public int index;

    public WizardCategorizedAction(Wizard wizard, int actionKind, int actionIndex) {
        owner = wizard;
        kind = actionKind;
        index = actionIndex;
    }

    public void Invoke() {
        Wizard wizard = owner;
        if (wizard != null) { wizard.ActivateCategorized(kind, index); }
    }
}
