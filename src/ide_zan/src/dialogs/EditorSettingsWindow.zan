using System;
using System.Json;
using Gui;

/// 「编辑器设置」子窗口：只做宿主——状态实体、生命周期与回写，
/// 界面由 `EditorSettingsDialog.zform` 声明。
class EditorSettingsWindow : ChildWindow {
    EditorSettingsDialog content;
    int themeIndex;
    int fontSize;
    int language;
    int defaultFontSize;
    bool saved;
    bool languageChanged;
    static bool done;
    static bool resetFont;

    static string T(int lang, string en, string zh) {
        if (lang == 1) { return zh; }
        return en;
    }

    override void OnCloseRequested() { EditorSettingsWindow.OnDone(); }

    static void OnDone() {
        EditorSettingsWindow.done = true;
    }

    static void OnResetFont() {
        EditorSettingsWindow.resetFont = true;
    }

    void BuildUi() {
        content = new EditorSettingsDialog();
        content.ApplyTexts(language);
        this.SetRoot(content, model);
        this.Handle("editorSettingsDone", EditorSettingsWindow.OnDone);
        this.Handle("resetFont", EditorSettingsWindow.OnResetFont);
        this.Wire();
    }

    static EditorSettingsWindow Open(
            App parent, int theme, int font, int lang, int defaultFont) {
        EditorSettingsWindow w = new EditorSettingsWindow();
        w.themeIndex = theme;
        w.fontSize = font;
        w.language = lang;
        w.defaultFontSize = defaultFont;

        w.open = true;
        w.saved = false;
        w.languageChanged = false;
        EditorSettingsWindow.done = false;
        EditorSettingsWindow.resetFont = false;
        w.model = JsonValue.NewObject();
        w.model.Set("themeIdx", JsonValue.NewNum(Convert.ToString(theme)));
        w.model.Set("font", JsonValue.NewNum(Convert.ToString(
            ZanIDE.EditorFontOr(font, defaultFont))));
        w.model.Set("lang", JsonValue.NewNum(Convert.ToString(lang)));
        w.BuildUi();
        w.OpenHost(parent);
        return w;
    }

    override string Title() {
        return EditorSettingsWindow.T(language, "Editor Settings", "编辑器设置");
    }

    override int Width() { return 520; }
    /// 三组设置各一行，窗口按内容高度开，不留半屏空白。
    override int Height() { return 320; }
    override bool ShowMaximize() { return false; }
    override int IdBase() { return 880000; }

    /// 语言切换热生效：正文由 AfterFrame 的模型监听重填，这里只把
    /// language 对齐（Title() 随之返回新语言，基类负责改标题文字）。
    override void OnLanguageChanged(int lang) {
        language = lang;
    }

    override bool Pending() {
        return EditorSettingsWindow.done || EditorSettingsWindow.resetFont;
    }

    override void AfterFrame() {
        if (EditorSettingsWindow.resetFont) {
            model.Set("font", JsonValue.NewNum(
                Convert.ToString(defaultFontSize)));
            fontSize = 0;
            EditorSettingsWindow.resetFont = false;
            host.RequestRedraw();
        }

        themeIndex = model.PathInt("themeIdx", themeIndex);
        int boundFont = model.PathInt("font",
            ZanIDE.EditorFontOr(fontSize, defaultFontSize));
        if (fontSize != 0 || boundFont != defaultFontSize) {
            fontSize = boundFont;
        }
        int nextLanguage = model.PathInt("lang", language);
        if (nextLanguage != language) {
            language = nextLanguage;
            languageChanged = true;
            content.ApplyTexts(language);
            host.RequestRedraw();
        }
        if (EditorSettingsWindow.done) {
            saved = true;
            open = false;
            EditorSettingsWindow.done = false;
            host.window.Close();
        }
    }

    int ThemeIndex() { return themeIndex; }
    int FontSize() { return fontSize; }
    int Language() { return language; }

    bool TakeLanguageChanged() {
        bool v = languageChanged;
        languageChanged = false;
        return v;
    }

    bool TakeSaved() {
        bool v = saved;
        saved = false;
        return v;
    }
}
