using System;
using System.Collections.Generic;
using Gui;
using Gui.Backend;

// 「编辑器设置」子窗口宿主：管理主题、字号与语言配置
public class EditorSettingsWindow : ChildWindow {
    EditorSettingsDialog content;
    int themeIndex;
    int fontSize;
    string language;    // UI language code: "zh" / "en"
    int defaultFontSize;
    bool saved;
    bool languageChanged;
    Dictionary<string, string> state;
    static bool done;
    static bool resetFont;

    string Get(string key, string dflt) {
        if (state != null && state.ContainsKey(key)) { return state[key]; }
        return dflt;
    }

    int GetInt(string key, int dflt) {
        string s = this.Get(key, "");
        if (s == "") { return dflt; }
        return Convert.ToInt32(s);
    }

    static string T(string lang, string en, string zh) {
        if (lang == "zh") { return zh; }
        return en;
    }

    // 0 = en, 1 = zh
    static string LangCode(int idx) {
        if (idx == 1) { return "zh"; }
        return "en";
    }

    static int LangIndex(string lang) {
        if (lang == "zh") { return 1; }
        return 0;
    }

    override void OnCloseRequested() { EditorSettingsWindow.OnDone(); }

    static void OnDone() {
        EditorSettingsWindow.done = true;
    }

    static void OnResetFont() {
        EditorSettingsWindow.resetFont = true;
    }

    void BuildUi() {
        content = new EditorSettingsDialog();
        content.ApplyTexts(language);
        this.SetRoot(content, state);
        this.Handle("editorSettingsDone", EditorSettingsWindow.OnDone);
        this.Handle("resetFont", EditorSettingsWindow.OnResetFont);
        this.Wire();
    }

    static EditorSettingsWindow Open(
            App parent, int theme, int font, string lang, int defaultFont) {
        EditorSettingsWindow w = new EditorSettingsWindow();
        w.themeIndex = theme;
        w.fontSize = font;
        w.language = lang;
        w.defaultFontSize = defaultFont;

        w.open = true;
        w.saved = false;
        w.languageChanged = false;
        EditorSettingsWindow.done = false;
        EditorSettingsWindow.resetFont = false;
        w.state = new Dictionary<string, string>();
        w.state["themeIdx"] = theme.ToString();
        w.state["font"] = ZanIDE.EditorFontOr(font, defaultFont).ToString();
        w.state["lang"] = EditorSettingsWindow.LangIndex(lang).ToString();
        w.BuildUi();
        w.OpenHost(parent);
        return w;
    }

    override string Title() {
        return EditorSettingsWindow.T(language, "Editor Settings", "编辑器设置");
    }

    override int Width() { return 520; }
    override int Height() { return 320; }
    override bool ShowMaximize() { return false; }

    override void OnLanguageChanged(string lang) {
        language = lang;
    }

    override bool Pending() {
        return EditorSettingsWindow.done || EditorSettingsWindow.resetFont;
    }

    override void AfterFrame() {
        if (EditorSettingsWindow.resetFont) {
            state["font"] = defaultFontSize.ToString();
            fontSize = 0;
            EditorSettingsWindow.resetFont = false;
            host.RequestRedraw();
        }

        themeIndex = this.GetInt("themeIdx", themeIndex);
        int boundFont = this.GetInt("font",
            ZanIDE.EditorFontOr(fontSize, defaultFontSize));
        if (fontSize != 0 || boundFont != defaultFontSize) {
            fontSize = boundFont;
        }
        string nextLanguage = EditorSettingsWindow.LangCode(
            this.GetInt("lang", EditorSettingsWindow.LangIndex(language)));
        if (nextLanguage != language) {
            language = nextLanguage;
            languageChanged = true;
            content.ApplyTexts(language);
            host.RequestRedraw();
        }
        if (EditorSettingsWindow.done) {
            saved = true;
            open = false;
            EditorSettingsWindow.done = false;
            host.window.Close();
        }
    }

    int ThemeIndex() { return themeIndex; }
    int FontSize() { return fontSize; }
    string Language() { return language; }

    bool TakeLanguageChanged() {
        bool v = languageChanged;
        languageChanged = false;
        return v;
    }

    bool TakeSaved() {
        bool v = saved;
        saved = false;
        return v;
    }
}
