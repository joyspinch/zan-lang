{
  "name": "EditorSettingsDialog",
  "role": "control",
  "layoutMode": 1,
  "fields": [
    {
      "kind": "Panel",
      "name": "Body",
      "dock": 5,
      "pad": 18,
      "gap": 8,
      "kids": [
        {
          "kind": "Label",
          "name": "ThemeCap",
          "class": "secondary small",
          "dock": 1,
          "fh": 20
        },
        {
          "kind": "Radio",
          "name": "Theme0",
          "dock": 1,
          "fh": 26,
          "bind": "themeIdx",
          "props": { "option": "0" }
        },
        {
          "kind": "Radio",
          "name": "Theme1",
          "dock": 1,
          "fh": 26,
          "bind": "themeIdx",
          "props": { "option": "1" }
        },
        {
          "kind": "Radio",
          "name": "Theme2",
          "dock": 1,
          "fh": 26,
          "bind": "themeIdx",
          "props": { "option": "2" }
        },
        {
          "kind": "Radio",
          "name": "Theme3",
          "dock": 1,
          "fh": 26,
          "bind": "themeIdx",
          "props": { "option": "3" }
        },
        {
          "kind": "Radio",
          "name": "Theme4",
          "dock": 1,
          "fh": 26,
          "bind": "themeIdx",
          "props": { "option": "4" }
        },
        {
          "kind": "Radio",
          "name": "Theme5",
          "dock": 1,
          "fh": 26,
          "bind": "themeIdx",
          "props": { "option": "5" }
        },
        {
          "kind": "Label",
          "name": "FontCap",
          "class": "secondary small",
          "dock": 1,
          "fh": 20
        },
        {
          "kind": "Panel",
          "name": "FontRow",
          "dock": 1,
          "fh": 34,
          "gap": 10,
          "kids": [
            {
              "kind": "Button",
              "name": "ResetFont",
              "dock": 4,
              "fw": 100,
              "onClick": "resetFont"
            },
            {
              "kind": "Label",
              "name": "PxCap",
              "label": "px",
              "dock": 4,
              "fw": 24
            },
            {
              "kind": "Label",
              "name": "FontValue",
              "dock": 4,
              "fw": 44,
              "bind": "font",
              "bindProp": "text"
            },
            {
              "kind": "Slider",
              "name": "Font",
              "dock": 5,
              "bind": "font",
              "props": { "min": "9", "max": "30" }
            }
          ]
        },
        {
          "kind": "Label",
          "name": "LangCap",
          "class": "secondary small",
          "dock": 1,
          "fh": 20
        },
        {
          "kind": "Panel",
          "name": "LangRow",
          "dock": 1,
          "fh": 34,
          "gap": 8,
          "kids": [
            {
              "kind": "Radio",
              "name": "LangEn",
              "label": "English",
              "dock": 3,
              "fw": 130,
              "bind": "lang",
              "props": { "option": "0" }
            },
            {
              "kind": "Radio",
              "name": "LangZh",
              "label": "简体中文",
              "dock": 3,
              "fw": 130,
              "bind": "lang",
              "props": { "option": "1" }
            }
          ]
        },
        {
          "kind": "Panel",
          "name": "ButtonRow",
          "dock": 1,
          "fh": 40,
          "kids": [
            {
              "kind": "Button",
              "name": "Done",
              "dock": 4,
              "fw": 120,
              "onClick": "editorSettingsDone"
            }
          ]
        }
      ]
    }
  ]
}
