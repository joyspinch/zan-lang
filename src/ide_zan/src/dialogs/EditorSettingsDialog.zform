{
  "name": "EditorSettingsDialog",
  "role": "control",
  "layoutMode": 1,
  "fields": [
    {
      "kind": "Panel",
      "name": "Body",
      "props": { "style": "3" },
      "dock": 5,
      "pad": 18,
      "gap": 10,
      "kids": [
        {
          "kind": "Label",
          "name": "ThemeCap",
          "class": "secondary small",
          "dock": 1,
          "fh": 20
        },
        {
          "kind": "SelectBox",
          "name": "ThemeSel",
          "dock": 1,
          "fh": 34,
          "bind": "themeIdx"
        },
        {
          "kind": "Label",
          "name": "FontCap",
          "class": "secondary small",
          "dock": 1,
          "fh": 20
        },
        {
          "kind": "Panel",
          "name": "FontRow",
          "props": { "style": "3" },
          "dock": 1,
          "fh": 34,
          "gap": 10,
          "kids": [
            {
              "kind": "Button",
              "name": "ResetFont",
              "class": "ghost small",
              "dock": 4,
              "fw": 90,
              "onClick": "resetFont"
            },
            {
              "kind": "Label",
              "name": "PxCap",
              "label": "px",
              "class": "secondary small",
              "dock": 4,
              "fw": 24
            },
            {
              "kind": "Label",
              "name": "FontValue",
              "dock": 4,
              "fw": 36,
              "bind": "font",
              "bindProp": "text"
            },
            {
              "kind": "Slider",
              "name": "Font",
              "dock": 5,
              "bind": "font",
              "props": { "min": "9", "max": "30" }
            }
          ]
        },
        {
          "kind": "Label",
          "name": "LangCap",
          "class": "secondary small",
          "dock": 1,
          "fh": 20
        },
        {
          "kind": "Panel",
          "name": "LangRow",
          "props": { "style": "3" },
          "dock": 1,
          "fh": 30,
          "gap": 8,
          "kids": [
            {
              "kind": "Radio",
              "name": "LangEn",
              "label": "English",
              "dock": 3,
              "fw": 130,
              "bind": "lang",
              "props": { "option": "0" }
            },
            {
              "kind": "Radio",
              "name": "LangZh",
              "label": "简体中文",
              "dock": 3,
              "fw": 130,
              "bind": "lang",
              "props": { "option": "1" }
            }
          ]
        },
        {
          "kind": "Panel",
          "name": "ButtonRow",
          "props": { "style": "3" },
          "dock": 2,
          "fh": 40,
          "kids": [
            {
              "kind": "Button",
              "name": "Done",
              "class": "primary",
              "dock": 4,
              "fw": 120,
              "onClick": "editorSettingsDone"
            }
          ]
        }
      ]
    }
  ]
}
