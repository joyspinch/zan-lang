using System;
using Gui;
using Gui.Widget;

public partial class Wizard {
    Control categorizedView;
    List<Button> categoryButtons;
    List<Button> templateButtons;
    List<Button> targetButtons;
    List<Button> deviceButtons;
    List<Button> orientationButtons;
    List<Button> presetButtons;
    List<DeviceProfile> devices;
    Control categorizedSizes;
    Control categorizedDevices;
    Control categorizedOrientation;
    Control categorizedFreeSize;
    Label categorizedDescription;
    Label categorizedCapabilities;
    Label categorizedPlatforms;
    Label categorizedNotice;
    Button categorizedCreate;
    int categorizedAction;

    Button CategorizedButton(string text, string name, int kind, int index) {
        Button button = new Button(text);
        button.SetProp("name", name);
        button.SetProp("style", "flex-shrink:0;");
        WizardCategorizedAction action = new WizardCategorizedAction(this, kind, index);
        button.Click.Add(() => { action.Invoke(); });
        return button;
    }

    void BuildCategorized() {
        categoryButtons = new List<Button>();
        templateButtons = new List<Button>();
        targetButtons = new List<Button>();
        deviceButtons = new List<Button>();
        orientationButtons = new List<Button>();
        presetButtons = new List<Button>();
        devices = DeviceProfile.All();
        Panel root = Wizard.Column("padding:var(--padding-large);gap:var(--gap-medium);");
        root.SetProp("name", "wizard-root");
        Panel header = Panel.Row();
        header.SetProp("style", "display:flex;align-items:center;flex-shrink:0;");
        Label title = new Label(iTitle).Large();
        title.Grow();
        header.Add(title);
        Button close = this.CategorizedButton("", "wizard-close", 0, 2);
        close.Add(new IconView("x"));
        close.Class = "ghost small";
        header.Add(close);
        root.Add(header);
        Panel body = Panel.Row();
        body.SetProp("style", "display:flex;flex-grow:1;flex-basis:0;min-height:0;gap:var(--gap-medium);");
        Panel categories = Wizard.Column("width:145px;flex-shrink:0;overflow-y:auto;gap:var(--gap-small);");
        for (int i = 0; i < iCatNames.Count; i = i + 1) {
            Button button = this.CategorizedButton(iCatNames[i], "wizard-category-" + Convert.ToString(i), 1, i);
            categories.Add(button);
            categoryButtons.Add(button);
        }
        body.Add(categories);
        Panel templates = Wizard.Column("width:200px;flex-shrink:0;overflow-y:auto;gap:var(--gap-small);");
        for (int i = 0; i < iTpls.Count; i = i + 1) {
            Button button = this.CategorizedButton(iTpls[i].name, "wizard-template-" + Convert.ToString(i), 2, i);
            if (iTpls[i].icon != "") { button.Add(new IconView(iTpls[i].icon)); }
            templates.Add(button);
            templateButtons.Add(button);
        }
        body.Add(templates);
        Panel details = Wizard.Column("flex-grow:1;flex-basis:0;min-width:0;overflow-y:auto;gap:var(--gap-small);");
        this.BuildCategorizedDetails(details);
        body.Add(details);
        root.Add(body);
        categorizedNotice = new Label("").Error().SetWrap(true);
        categorizedNotice.SetProp("name", "wizard-notice");
        root.Add(categorizedNotice);
        Panel footer = Panel.Row();
        footer.SetProp("style", "display:flex;justify-content:flex-end;flex-shrink:0;gap:var(--gap-medium);");
        footer.Add(this.CategorizedButton(Wizard.TW("Cancel", "取消"), "wizard-cancel", 0, 2));
        categorizedCreate = this.CategorizedButton(Wizard.TW("Create", "创建"), "wizard-create", 0, 1).Primary();
        footer.Add(categorizedCreate);
        root.Add(footer);
        categorizedView = root;
    }

    void BuildCategorizedDetails(Panel details) {
        details.Add(new Label(Wizard.TW("Name", "名称")));
        iName.SetProp("name", "wizard-name");
        iName.SetProp("style", "flex-shrink:0;");
        details.Add(iName);
        if (iLoc != null) {
            details.Add(new Label(Wizard.TW("Location", "位置")));
            Panel location = Panel.Row();
            location.SetProp("style", "display:flex;align-items:center;flex-shrink:0;gap:var(--gap-small);");
            iLoc.SetProp("name", "wizard-location");
            iLoc.SetProp("style", "flex-grow:1;flex-basis:0;min-width:0;");
            location.Add(iLoc);
            location.Add(this.CategorizedButton("…", "wizard-browse", 0, 3));
            details.Add(location);
        }
        categorizedDescription = new Label("").SetWrap(true).Muted();
        categorizedDescription.SetProp("name", "wizard-description");
        details.Add(categorizedDescription);
        categorizedCapabilities = new Label("").SetWrap(true).Small();
        categorizedCapabilities.SetProp("name", "wizard-capabilities");
        details.Add(categorizedCapabilities);
        categorizedPlatforms = new Label("").SetWrap(true).Small().Muted();
        categorizedPlatforms.SetProp("name", "wizard-supported-platforms");
        details.Add(categorizedPlatforms);
        this.BuildCategorizedSizes(details);
        this.BuildCategorizedTargets(details);
        this.BuildPreview(null);
        details.Add(previewView);
    }

    void BuildCategorizedSizes(Panel details) {
        Panel sizes = Wizard.Column("flex-shrink:0;gap:var(--gap-small);");
        Panel deviceRow = new Panel();
        deviceRow.SetProp("style", "display:grid;grid-template-columns:repeat(3,1fr);gap:var(--gap-small);");
        for (int i = 0; i < devices.Count; i = i + 1) {
            Button button = this.CategorizedButton(devices[i].Label(Wizard.lang), "wizard-device-" + Convert.ToString(i), 4, i);
            button.Class = "small";
            deviceRow.Add(button);
            deviceButtons.Add(button);
        }
        categorizedDevices = deviceRow;
        sizes.Add(deviceRow);
        Panel orientations = Panel.Row();
        orientations.SetProp("style", "display:flex;flex-shrink:0;gap:var(--gap-small);");
        for (int i = 0; i < 2; i = i + 1) {
            string label = i == 0 ? Wizard.TW("Portrait", "竖屏") : Wizard.TW("Landscape", "横屏");
            Button button = this.CategorizedButton(label, "wizard-orientation-" + Convert.ToString(i), 5, i);
            button.Class = "small";
            orientations.Add(button);
            orientationButtons.Add(button);
        }
        categorizedOrientation = orientations;
        sizes.Add(orientations);
        Panel free = Wizard.Column("flex-shrink:0;gap:var(--gap-small);");
        Panel presets = new Panel();
        presets.SetProp("style", "display:grid;grid-template-columns:repeat(4,1fr);gap:var(--gap-small);");
        List<int> widths = Wizard.SizePresetW();
        for (int i = 0; i < widths.Count; i = i + 1) {
            Button button = this.CategorizedButton(Wizard.SizePresetName(i), "wizard-size-preset-" + Convert.ToString(i), 6, i);
            button.Class = "small";
            presets.Add(button);
            presetButtons.Add(button);
        }
        free.Add(presets);
        if (iSizeW != null && iSizeH != null) {
            Panel custom = Panel.Row();
            custom.SetProp("style", "display:flex;align-items:center;flex-shrink:0;gap:var(--gap-small);");
            custom.Add(new Label(Wizard.TW("Custom", "自定义")));
            iSizeW.SetProp("name", "wizard-size-width");
            iSizeH.SetProp("name", "wizard-size-height");
            iSizeW.SetProp("style", "width:72px;");
            iSizeH.SetProp("style", "width:72px;");
            custom.Add(iSizeW);
            custom.Add(new Label("×"));
            custom.Add(iSizeH);
            free.Add(custom);
        }
        categorizedFreeSize = free;
        sizes.Add(free);
        categorizedSizes = sizes;
        details.Add(sizes);
    }

    void BuildCategorizedTargets(Panel details) {
        if (iTargets == null) { return; }
        Panel platforms = new Panel();
        platforms.SetProp("style", "display:grid;grid-template-columns:repeat(3,1fr);gap:var(--gap-small);flex-shrink:0;");
        int groups = iGroups != null && iGroups.Count > 0 ? iGroups.Count : 1;
        platforms.SetProp("style", "display:grid;grid-template-columns:repeat(" + Convert.ToString(groups) + ",1fr);gap:var(--gap-small);flex-shrink:0;");
        int perGroup = (iTargets.Count + groups - 1) / groups;
        for (int group = 0; group < groups; group = group + 1) {
            Panel column = Wizard.Column("gap:var(--gap-small);min-width:0;");
            if (iGroups != null && group < iGroups.Count) {
                Label heading = new Label(iGroups[group]).Small().Muted();
                heading.SetProp("name", "wizard-platform-group-" + Convert.ToString(group));
                column.Add(heading);
            }
            for (int row = 0; row < perGroup; row = row + 1) {
                int index = group * perGroup + row;
                if (index < iTargets.Count) {
                    Button button = this.CategorizedButton(iTargets[index].name, "wizard-target-" + Convert.ToString(index), 3, index);
                    button.Class = "small";
                    column.Add(button);
                    targetButtons.Add(button);
                }
            }
            platforms.Add(column);
        }
        details.Add(platforms);
    }

    WizardTemplate SelectedTemplate() {
        int selected = iTplSel.Get();
        if (selected < 0 || selected >= iTpls.Count) { return null; }
        return iTpls[selected];
    }

    void SyncCategorized() {
        int category = iCatSel.Get();
        string name = "";
        if (category >= 0 && category < iCatNames.Count) { name = iCatNames[category]; }
        int first = -1;
        bool found = false;
        for (int i = 0; i < templateButtons.Count; i = i + 1) {
            bool shown = category >= 0 && iTpls[i].cat == name;
            templateButtons[i].Visible = shown;
            if (shown && first < 0) { first = i; }
            if (shown && i == iTplSel.Get()) { found = true; }
        }
        if (!found && iTplSel.Get() != first) { iTplSel.Set(first); }
        for (int i = 0; i < categoryButtons.Count; i = i + 1) {
            categoryButtons[i].Class = i == category ? "primary" : "";
        }
        for (int i = 0; i < templateButtons.Count; i = i + 1) {
            templateButtons[i].Class = i == iTplSel.Get() ? "primary" : "";
        }
        WizardTemplate tpl = this.SelectedTemplate();
        categorizedCreate.Disabled = tpl == null;
        categorizedDescription.Text.Set(tpl != null ? tpl.desc : "");
        categorizedCapabilities.Text.Set(tpl != null ? tpl.caps : "");
        categorizedCapabilities.Visible = tpl != null && tpl.caps != "";
        categorizedPlatforms.Text.Set(tpl != null ? Wizard.PrettyPlats(tpl.plats) : "");
        categorizedPlatforms.Visible = tpl != null && tpl.plats != "";
        categorizedNotice.Text.Set(Wizard.notice);
        categorizedNotice.Visible = Wizard.notice != "";
        for (int i = 0; i < targetButtons.Count; i = i + 1) {
            bool supported = Wizard.TplSupports(tpl, iTargets[i].id);
            targetButtons[i].Class = iTargets[i].selected != 0 ? "primary small" : (supported ? "small" : "ghost small");
        }
        this.SyncCategorizedSizes(tpl);
    }

    void SyncCategorizedSizes(WizardTemplate tpl) {
        bool sizeable = tpl != null && tpl.sizeable && iSizeSel != null;
        categorizedSizes.Visible = sizeable;
        bool hasDevice = iDevSel != null && iDevRot != null;
        int selected = hasDevice ? iDevSel.Get() : 0;
        if (selected < 0 || selected >= devices.Count) { selected = 0; }
        DeviceProfile device = devices[selected];
        categorizedDevices.Visible = hasDevice;
        categorizedOrientation.Visible = hasDevice && device.Locked() && device.Rotatable();
        categorizedFreeSize.Visible = !hasDevice || !device.Locked();
        int orientation = hasDevice ? iDevRot.Get() : 0;
        if (sizeable && hasDevice && device.Locked()) {
            if (iSizeW != null) { iSizeW.SetText(Convert.ToString(device.CanvasW(orientation))); }
            if (iSizeH != null) { iSizeH.SetText(Convert.ToString(device.CanvasH(orientation))); }
        }
        for (int i = 0; i < deviceButtons.Count; i = i + 1) {
            deviceButtons[i].Class = i == selected ? "primary small" : "small";
        }
        for (int i = 0; i < orientationButtons.Count; i = i + 1) {
            orientationButtons[i].Class = i == orientation ? "primary small" : "small";
        }
        for (int i = 0; i < presetButtons.Count; i = i + 1) {
            presetButtons[i].Class = iSizeSel != null && iSizeSel.Get() == i ? "primary small" : "small";
        }
        int w = iSizeW != null && sizeable ? Wizard.ParseDim(iSizeW.GetText()) : (tpl != null ? tpl.defW : 0);
        int h = iSizeH != null && sizeable ? Wizard.ParseDim(iSizeH.GetText()) : (tpl != null ? tpl.defH : 0);
        bool round = sizeable && hasDevice && device.Locked() ? device.Round() : (tpl != null && tpl.round);
        this.SyncPreview(tpl, w, h, 360, round);
    }

    public void ActivateCategorized(int kind, int index) {
        if (kind == 0) {
            if (index != 1 || this.SelectedTemplate() != null) { categorizedAction = index; }
        }
        else if (kind == 1) { iCatSel.Set(index); }
        else if (kind == 2) { iTplSel.Set(index); }
        else if (kind == 3) {
            WizardTarget target = iTargets[index];
            if (target.selected != 0) { target.selected = 0; }
            else if (Wizard.TplSupports(this.SelectedTemplate(), target.id)) { target.selected = 1; }
            else {
                WizardTemplate tpl = this.SelectedTemplate();
                string os = Wizard.OsName(Wizard.OsOf(target.id));
                Wizard.notice = Wizard.lang == "zh"
                    ? "模板 '" + tpl.name + "' 不支持 " + os + "。"
                    : "Template '" + tpl.name + "' doesn't run on " + os + ".";
            }
        } else if (kind == 4 && iDevSel != null) {
            iDevSel.Set(index);
            if (iDevRot != null) { iDevRot.Set(0); }
        }
        else if (kind == 5 && iDevRot != null) { iDevRot.Set(index); }
        else if (kind == 6 && iSizeSel != null) {
            iSizeSel.Set(index);
            List<int> widths = Wizard.SizePresetW();
            List<int> heights = Wizard.SizePresetH();
            if (iSizeW != null) { iSizeW.SetText(Convert.ToString(widths[index])); }
            if (iSizeH != null) { iSizeH.SetText(Convert.ToString(heights[index])); }
        }
    }

    int ShowCategorized(App app) {
        if (categorizedView == null) { this.BuildCategorized(); }
        app.SetRootControl(categorizedView);
        this.SyncCategorized();
        categorizedView.RenderInside(app, new Rect(0, 0, app.canvas.Width(), app.canvas.Height()));
        int action = categorizedAction;
        categorizedAction = 0;
        return action;
    }
}
