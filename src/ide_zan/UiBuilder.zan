using System;
using System.Json;

/// H: a typed builder for UiDoc documents -- the declarative UI the IDE's
/// Layer/Ui layer parses into a live control tree. It replaces hand-assembled
/// JSON strings: a node is an entity wrapping a JsonValue object, fluent
/// setters fill its fields, children nest as real sub-entities, and JsonValue
/// does the string escaping -- so an unbalanced brace or an unescaped quote is
/// no longer possible to emit by hand. Call ToJson() to hand the document to
/// the existing UiDoc parser unchanged.
class UiNode {
    JsonValue obj;

    /// A node of the given UiDoc type ("Column", "Button", "ThemeCard", ...).
    static UiNode Of(string type) {
        UiNode n = new UiNode();
        n.obj = JsonValue.NewObject();
        n.obj.Set("type", JsonValue.NewStr(type));
        return n;
    }

    static UiNode Column() { return UiNode.Of("Column"); }
    static UiNode Row() { return UiNode.Of("Row"); }
    static UiNode Title(string text) { return UiNode.Of("Title").Text(text); }
    static UiNode Label(string text) { return UiNode.Of("Label").Text(text); }
    static UiNode Button(string text) { return UiNode.Of("Button").Text(text); }
    static UiNode Slider() { return UiNode.Of("Slider"); }

    // ---- fluent field setters (each returns the node for chaining) --------

    /// Sets a string-valued field.
    UiNode Str(string key, string val) {
        obj.Set(key, JsonValue.NewStr(val));
        return this;
    }

    /// Sets an integer-valued field.
    UiNode Num(string key, int val) {
        obj.Set(key, JsonValue.NewNum(Convert.ToString(val)));
        return this;
    }

    UiNode Text(string t) { return this.Str("text", t); }
    UiNode Class(string c) { return this.Str("class", c); }
    UiNode Dock(string d) { return this.Str("dock", d); }
    UiNode Height(int h) { return this.Num("height", h); }
    UiNode Width(int w) { return this.Num("width", w); }
    UiNode Gap(int g) { return this.Num("gap", g); }
    UiNode Pad(int p) { return this.Num("pad", p); }
    UiNode Min(int m) { return this.Num("min", m); }
    UiNode Max(int m) { return this.Num("max", m); }
    UiNode Index(int i) { return this.Num("index", i); }
    UiNode Bind(string path) { return this.Str("bind", path); }
    UiNode OnClick(string action) { return this.Str("onClick", action); }

    /// A two-way bind that targets a control property, emitting the object
    /// form {"path": ..., "prop": ...} the parser expects.
    UiNode BindProp(string path, string prop) {
        JsonValue b = JsonValue.NewObject();
        b.Set("path", JsonValue.NewStr(path));
        b.Set("prop", JsonValue.NewStr(prop));
        obj.Set("bind", b);
        return this;
    }

    /// Appends a child node, creating the "children" array on first use.
    UiNode Child(UiNode c) {
        JsonValue arr = obj.Get("children");
        if (arr == null) {
            arr = JsonValue.NewArray();
            obj.Set("children", arr);
        }
        arr.Append(c.obj);
        return this;
    }

    /// The underlying JsonValue (for nesting into another builder by hand).
    JsonValue Value() { return obj; }

    /// Serializes the document to the JSON string the UiDoc parser consumes.
    string ToJson() { return obj.ToJson(); }
}
