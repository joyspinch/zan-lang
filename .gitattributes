# Shell scripts must keep LF endings: CRLF makes bash reject them ("set: -
# invalid option"), which silently disabled examples/game/ra2/tests/run.sh.
*.sh text eol=lf

# ZanIDE.zan is the one file whose committed blob has always been CRLF (all
# other .zan blobs are LF). Declaring it non-normalized keeps git from
# re-comparing it as LF-vs-CRLF on every edit, which would show the whole file
# as modified whenever the file is touched.
src/ide_zan/ZanIDE.zan -text
