class McpServer {
    // ---- configuration ------------------------------------------------------
    static string root;          // workspace root, absolute, no trailing slash
    static string host;
    static int port;
    static string token;
    static string serverName;
    static bool readOnly;
    static bool allowExec;
    static int maxRead;
    static int workers;
    // IDE 工具链交互与状态驱动契约。
    static bool stdio;
    // IDE 工具链交互与状态驱动契约。
    static string parseError;

    // 核心契约与执行状态转移规范。
    static string knowledge;
    static string indexPath;
    static string refsPath;
    static string callGraphPath;
    static string galleryPath;
    static string formSchemaPath;
    // IDE 工具链交互与状态驱动契约。
    static string routesIndexPath;
    static string entitiesIndexPath;
    static string indexManifestPath;
    static string knowledgeStatus;
    static bool knowledgeFresh;
    static string zancPath;
    static string stdlibPath;
    // IDE 工具链交互与状态驱动契约。
    static string sdkRoot;
    // IDE 工具链交互与状态驱动契约。
    static string skillsDir;
    // IDE 工具链交互与状态驱动契约。
    static bool frozenTools;
    static string workRoot;
    static int compileSeq;

    static string Version() { return "2.0"; }

    // IDE 工具链交互与状态驱动契约。
    static string ProtocolVersion() { return "2025-06-18"; }

    static bool SpeaksProtocol(string v) {
        return v == "2024-11-05" || v == "2025-03-26" || v == "2025-06-18";
    }

    [DllImport("crt", EntryPoint = "getenv")]
    static extern string PlatGetEnv(string name);

    // 核心契约与执行状态转移规范。
    // IDE 工具链交互与状态驱动契约。
    // 核心契约与语义定义。
    #if WINDOWS
    [DllImport("crt", EntryPoint = "_read")]
    static extern int PlatRead(int fd, nint buf, int count);

    [DllImport("crt", EntryPoint = "_write")]
    static extern int PlatWrite(int fd, nint buf, int count);

    // IDE 工具链交互与状态驱动契约。
    [DllImport("crt", EntryPoint = "_setmode")]
    static extern int PlatSetMode(int fd, int mode);
    #else
    [DllImport("crt", EntryPoint = "read")]
    static extern int PlatRead(int fd, nint buf, int count);

    [DllImport("crt", EntryPoint = "write")]
    static extern int PlatWrite(int fd, nint buf, int count);
    #endif

    static nint inBuf;      // stdin read buffer (raw, not ARC managed)
    static int inCap;
    static int inLen;       // bytes currently held in inBuf
    static int inPos;       // next unconsumed byte

    // IDE 工具链交互与状态驱动契约。
    static string Env(string name, string dflt) {
        string v = McpServer.PlatGetEnv(name);
        if (v == null) { return dflt; }
        if (v == "") { return dflt; }
        return v;
    }

    static void Main() {
        McpServer.root = McpServer.Env("MCP_ROOT", "");
        McpServer.host = McpServer.Env("MCP_HOST", "127.0.0.1");
        McpServer.port = McpServer.ParseInt(McpServer.Env("MCP_PORT", ""), 18848);
        McpServer.token = McpServer.Env("MCP_TOKEN", "");
        McpServer.serverName = "zan-mcp";
        McpServer.readOnly = false;
        McpServer.allowExec = true;
        McpServer.maxRead = 8388608;
        McpServer.workers = 1;
        McpServer.knowledge = "";
        McpServer.zancPath = "";
        McpServer.stdlibPath = "";
        McpServer.compileSeq = 0;
        McpServer.parseError = "";
        McpServer.stdio = false;
        McpServer.sdkRoot = "";
        McpServer.skillsDir = McpServer.Env("MCP_SKILLS", "");
        McpServer.frozenTools = McpServer.Env("MCP_FROZEN_TOOLS", "") != "";
        bool initAgent = false;
        string initTarget = "";
        bool force = false;
        bool testSemantic = false;

        int i = 0;
        int argc = Environment.ArgCount();
        while (i < argc) {
            string a = Environment.ArgAt(i);
            bool hasNext = i + 1 < argc;
            if (a == "--host" && hasNext) {
                McpServer.host = Environment.ArgAt(i + 1); i = i + 2; continue;
            }
            if (a == "--port" && hasNext) {
                McpServer.port = McpServer.ParseInt(Environment.ArgAt(i + 1), 18848);
                i = i + 2; continue;
            }
            if (a == "--token" && hasNext) {
                McpServer.token = Environment.ArgAt(i + 1); i = i + 2; continue;
            }
            if (a == "--token-env" && hasNext) {
                McpServer.token = McpServer.Env(Environment.ArgAt(i + 1), "");
                i = i + 2; continue;
            }
            if (a == "--name" && hasNext) {
                McpServer.serverName = Environment.ArgAt(i + 1); i = i + 2; continue;
            }
            if (a == "--max-read" && hasNext) {
                McpServer.maxRead = McpServer.ParseInt(Environment.ArgAt(i + 1), 8388608);
                i = i + 2; continue;
            }
            if (a == "--workers" && hasNext) {
                McpServer.workers = McpServer.ParseInt(Environment.ArgAt(i + 1), 1);
                i = i + 2; continue;
            }
            if (a == "--knowledge" && hasNext) {
                McpServer.knowledge = Environment.ArgAt(i + 1); i = i + 2; continue;
            }
            if (a == "--zanc" && hasNext) {
                McpServer.zancPath = Environment.ArgAt(i + 1); i = i + 2; continue;
            }
            if (a == "--stdlib" && hasNext) {
                McpServer.stdlibPath = Environment.ArgAt(i + 1); i = i + 2; continue;
            }
            if (a == "--skills" && hasNext) {
                McpServer.skillsDir = Environment.ArgAt(i + 1); i = i + 2; continue;
            }
            if (a == "--frozen-tools") {
                McpServer.frozenTools = true; i = i + 1; continue;
            }
            if (a == "--sdk-root" && hasNext) {
                McpServer.sdkRoot = Environment.ArgAt(i + 1); i = i + 2; continue;
            }
            if (a == "--init-agent") {
                initAgent = true;
                if (hasNext && !McpServer.IsOption(Environment.ArgAt(i + 1))) {
                    initTarget = Environment.ArgAt(i + 1); i = i + 2; continue;
                }
                i = i + 1; continue;
            }
            if (a == "--force") {
                force = true; i = i + 1; continue;
            }
            if (a == "--stdio") {
                McpServer.stdio = true; i = i + 1; continue;
            }
            if (a == "--test-semantic") {
                testSemantic = true; i = i + 1; continue;
            }
            if (a == "--read-only" || a == "--readonly") {
                McpServer.readOnly = true; i = i + 1; continue;
            }
            if (a == "--no-exec") {
                McpServer.allowExec = false; i = i + 1; continue;
            }
            if (a.Length >= 2 && a.Substring(0, 2) == "--") { i = i + 1; continue; }
            McpServer.root = a;
            i = i + 1;
        }
        // IDE 工具链交互与状态驱动契约。
        if (McpServer.root == "" || McpServer.root == "." || McpServer.root == "./") {
            McpServer.root = Directory.GetCurrentDirectory();
        }
        McpServer.root = McpServer.TrimTrailingSep(McpServer.root);

        // IDE 工具链交互与状态驱动契约。
        // 核心契约与语义定义。
        string exeDir = McpServer.TrimTrailingSep(Environment.ExeDir());
        if (McpServer.sdkRoot == "") {
            McpServer.sdkRoot = McpServer.ResolveSdkDir(exeDir);
        }
        McpServer.sdkRoot = McpServer.TrimTrailingSep(McpServer.sdkRoot);
        string sdk = McpServer.sdkRoot;

        if (initAgent) {
            int initRc = McpServer.InitAgent(initTarget, exeDir, force);
            McpServer.PlatExit(initRc);
            return;
        }

        if (McpServer.knowledge == "") {
            McpServer.knowledge = sdk + "/knowledge";
            if (!Directory.Exists(McpServer.knowledge)) {
                McpServer.knowledge = exeDir + "/knowledge";
            }
            if (!Directory.Exists(McpServer.knowledge)) {
                McpServer.knowledge = McpServer.root + "/.zanmap";
            }
        }
        if (McpServer.zancPath == "") {
            McpServer.zancPath = sdk + "/toolchain/zanc" + McpServer.ExeSuffix();
            if (!File.Exists(McpServer.zancPath)) {
                McpServer.zancPath = exeDir + "/toolchain/zanc" + McpServer.ExeSuffix();
            }
            if (!File.Exists(McpServer.zancPath)) {
                McpServer.zancPath = exeDir + "/zanc" + McpServer.ExeSuffix();
            }
            if (!File.Exists(McpServer.zancPath)) {
                McpServer.zancPath = McpServer.root + "/build/zanc" + McpServer.ExeSuffix();
            }
        }
        if (McpServer.stdlibPath == "") {
            McpServer.stdlibPath = sdk + "/stdlib";
            if (!Directory.Exists(McpServer.stdlibPath)) {
                McpServer.stdlibPath = exeDir + "/stdlib";
            }
            if (!Directory.Exists(McpServer.stdlibPath)) {
                McpServer.stdlibPath = McpServer.root + "/stdlib";
            }
        }
        if (McpServer.skillsDir == "") {
            McpServer.skillsDir = sdk + "/ai/skills";
            if (!Directory.Exists(McpServer.skillsDir)) {
                McpServer.skillsDir = sdk + "/tools/ai_pack/skills";
            }
            if (!Directory.Exists(McpServer.skillsDir)) {
                McpServer.skillsDir = exeDir + "/ai/skills";
            }
        }
        McpServer.skillsDir = McpServer.TrimTrailingSep(McpServer.skillsDir);
        McpServer.indexPath = McpServer.knowledge + "/symbols.json";
        McpServer.refsPath = McpServer.knowledge + "/refs.json";
        if (!File.Exists(McpServer.refsPath)
            && File.Exists(McpServer.root + "/.zanmap/refs.json")) {
            McpServer.refsPath = McpServer.root + "/.zanmap/refs.json";
        }
        McpServer.callGraphPath = McpServer.knowledge + "/callgraph.jsonl";
        if (!File.Exists(McpServer.callGraphPath)
            && File.Exists(McpServer.root + "/.zanmap/callgraph.jsonl")) {
            McpServer.callGraphPath = McpServer.root + "/.zanmap/callgraph.jsonl";
        }
        if (!File.Exists(McpServer.callGraphPath)
            && File.Exists(McpServer.root + "/.zanmap/callgraph.json")) {
            McpServer.callGraphPath = McpServer.root + "/.zanmap/callgraph.json";
        }
        McpServer.galleryPath = McpServer.knowledge + "/gallery.json";
        McpServer.formSchemaPath = McpServer.knowledge + "/controls.json";
        // IDE 工具链交互与状态驱动契约。
        McpServer.routesIndexPath = McpServer.root + "/.zanmap/routes.json";
        // IDE 工具链交互与状态驱动契约。
        if (!File.Exists(McpServer.routesIndexPath)
            && File.Exists(McpServer.root + "/.zanmap/routes.approx.json")) {
            McpServer.routesIndexPath =
                McpServer.root + "/.zanmap/routes.approx.json";
        }
        McpServer.entitiesIndexPath = McpServer.root + "/.zanmap/entities.json";
        McpServer.indexManifestPath = McpServer.root + "/.zanmap/index.json";
        McpServer.KnowledgeCheck(false);
        McpServer.workRoot = McpServer.root + "/_scratch/mcp_compile";
        McpServer.InitJobs();

        if (testSemantic) {
            Console.WriteLine("========================================");
            Console.WriteLine("1. Testing CallChain('McpServer.CallTool', 'outgoing', 2):");
            Console.WriteLine(McpServer.CallChain("McpServer.CallTool", "outgoing", 2));
            Console.WriteLine("----------------------------------------");
            Console.WriteLine("2. Testing TypeHierarchy('Control'):");
            Console.WriteLine(McpServer.TypeHierarchy("Control"));
            Console.WriteLine("----------------------------------------");
            Console.WriteLine("3. Testing BlastRadius('CallNode.Create', 3):");
            Console.WriteLine(McpServer.BlastRadius("CallNode.Create", 3));
            Console.WriteLine("----------------------------------------");
            Console.WriteLine("4. Testing ArchCheck():");
            Console.WriteLine(McpServer.ArchCheck());
            Console.WriteLine("========================================");
            return;
        }

        // IDE 工具链交互与状态驱动契约。
        if (McpServer.stdio) {
            int stdioRc = await McpServer.RunStdio();
            return;
        }
        if (!McpServer.knowledgeFresh) {
            Console.WriteLine("WARNING: " + McpServer.knowledgeStatus
                + "; call zan_refresh_knowledge when inputs are available.");
        }

        Console.WriteLine("MCP server " + McpServer.Version() + " (protocol "
            + McpServer.ProtocolVersion() + ")");
        Console.WriteLine("  workspace : " + McpServer.root);
        Console.WriteLine("  endpoint  : http://" + McpServer.host + ":"
            + Convert.ToString(McpServer.port) + "/");
        string mode = "read-write";
        if (McpServer.readOnly) { mode = "read-only"; }
        string exec = "run_command enabled";
        if (!McpServer.CanExec()) { exec = "run_command disabled"; }
        Console.WriteLine("  mode      : " + mode + ", " + exec);
        if (McpServer.token == "") {
            Console.WriteLine("  auth      : none");
            if (!McpServer.IsLoopback(McpServer.host)) {
                Console.WriteLine("  WARNING: bound to a non-loopback address with no token;"
                    + " anyone who can reach this port owns the workspace."
                    + " Pass --token or --token-env.");
            }
        } else {
            Console.WriteLine("  auth      : Bearer token required");
        }
        if (McpServer.ZanToolsAvailable()) {
            Console.WriteLine("  zan tools : zanc=" + McpServer.zancPath
                + " stdlib=" + McpServer.stdlibPath);
        }
        int rc = await McpServer.Run();
    }

    static string ExeSuffix() {
        #if WINDOWS
        return ".exe";
        #else
        return "";
        #endif
    }

    static bool IsLoopback(string h) {
        return h == "127.0.0.1" || h == "localhost" || h == "::1";
    }

    static bool CanExec() {
        return McpServer.allowExec && !McpServer.readOnly;
    }

    static bool ZanToolsAvailable() {
        return File.Exists(McpServer.zancPath);
    }

    // 核心契约与执行状态转移规范。

    [DllImport("crt", EntryPoint = "exit")]
    static extern void PlatExit(int code);

    static bool IsOption(string a) {
        return a.Length >= 2 && a.Substring(0, 2) == "--";
    }

    // IDE 工具链交互与状态驱动契约。
    static bool LooksLikeSdk(string dir) {
        if (Directory.Exists(dir + "/stdlib")) { return true; }
        if (Directory.Exists(dir + "/toolchain")) { return true; }
        return Directory.Exists(dir + "/ai");
    }

    // IDE 工具链交互与状态驱动契约。
    static string ResolveSdkDir(string exeDir) {
        if (McpServer.LooksLikeSdk(exeDir)) { return exeDir; }
        string up = McpServer.ParentOf(exeDir);
        if (up != "" && McpServer.LooksLikeSdk(up)) { return up; }
        return exeDir;
    }

    // ---- --init-agent -------------------------------------------------------

    // IDE 工具链交互与状态驱动契约。
    static int InitAgent(string target, string exeDir, bool force) {
        string project = target;
        if (project == "" || project == "." || project == "./") {
            project = Directory.GetCurrentDirectory();
        }
        project = McpServer.TrimTrailingSep(project);
        // IDE 工具链交互与状态驱动契约。
        if (!McpServer.IsAbsolute(project)) {
            project = McpServer.TrimTrailingSep(Directory.GetCurrentDirectory())
                + "/" + project;
        }
        if (!Directory.Exists(project)) {
            Console.WriteLine("error: project directory not found: " + project);
            return 2;
        }

        string pack = McpServer.sdkRoot + "/ai";
        if (!Directory.Exists(pack)) {
            // IDE 工具链交互与状态驱动契约。
            pack = McpServer.sdkRoot + "/tools/ai_pack";
        }
        if (!Directory.Exists(pack)) {
            Console.WriteLine("error: AI pack not found; looked for "
                + McpServer.ToNative(McpServer.sdkRoot + "/ai") + " and "
                + McpServer.ToNative(McpServer.sdkRoot + "/tools/ai_pack"));
            Console.WriteLine("       pass --sdk-root <sdk install dir> if the"
                + " server was moved out of the SDK.");
            return 2;
        }

        string mcpExe = exeDir + "/zan-mcp" + McpServer.ExeSuffix();
        if (!File.Exists(mcpExe)) {
            mcpExe = exeDir + "/mcp_server" + McpServer.ExeSuffix();
        }

        Console.WriteLine("Installing the Zan AI pack");
        Console.WriteLine("  sdk     : " + McpServer.ToNative(McpServer.sdkRoot));
        Console.WriteLine("  pack    : " + McpServer.ToNative(pack));
        Console.WriteLine("  project : " + McpServer.ToNative(project));

        int written = 0;
        try {
        // IDE 工具链交互与状态驱动契约。
        // 核心契约与语义定义。
        written = written + McpServer.InstallOne(pack + "/AGENTS.md",
            project + "/AGENTS.md", project, mcpExe, false, force);
        written = written + McpServer.InstallOne(pack + "/mcp.json",
            project + "/.mcp.json", project, mcpExe, true, force);
        written = written + McpServer.InstallOne(pack + "/cursor.mcp.json",
            project + "/.cursor/mcp.json", project, mcpExe, true, force);
        written = written + McpServer.InstallOne(pack + "/vscode.mcp.json",
            project + "/.vscode/mcp.json", project, mcpExe, true, force);

        string skills = pack + "/skills";
        if (Directory.Exists(skills)) {
            written = written + McpServer.InstallTree(skills,
                project + "/.agents/skills", project, mcpExe, force);
        }
        } catch (Exception e) {
            Console.WriteLine("error: failed to install AI pack into "
                + McpServer.ToNative(project) + ": " + e.Message);
            return 3;
        }

        Console.WriteLine("INIT_AGENT_OK " + Convert.ToString(written)
            + " file(s) written into " + McpServer.ToNative(project));
        if (!File.Exists(mcpExe)) {
            Console.WriteLine("  note: could not locate the server executable in "
                + McpServer.ToNative(exeDir) + "; the mcp configs point at "
                + mcpExe + " -- edit them if that path is wrong.");
        }
        Console.WriteLine("  next : open the project in your AI client; it starts"
            + " the server over stdio and should call zan_start_here first.");
        Console.WriteLine("  files: AGENTS.md, .mcp.json, .cursor\\mcp.json,"
            + " .vscode\\mcp.json, .agents\\skills\\");
        if (!force) {
            Console.WriteLine("  (files that already existed were left alone;"
                + " pass --force to overwrite)");
        }
        return 0;
    }

    // IDE 工具链交互与状态驱动契约。
    static int InstallOne(string src, string dest, string project,
                          string mcpExe, bool json, bool force) {
        if (!File.Exists(src)) { return 0; }
        if (File.Exists(dest) && !force) {
            Console.WriteLine("  keep  " + McpServer.RelOf(dest, project)
                + " (exists)");
            return 0;
        }
        string text = McpServer.Expand(File.ReadAllText(src), project, mcpExe, json);
        McpServer.EnsureParent(dest);
        File.WriteAllText(dest, text);
        Console.WriteLine("  write " + McpServer.RelOf(dest, project));
        return 1;
    }

    // IDE 工具链交互与状态驱动契约。
    static int InstallTree(string srcDir, string destDir, string project,
                           string mcpExe, bool force) {
        int n = 0;
        List<string> files = Directory.GetFiles(srcDir);
        for (int i = 0; i < files.Count; i = i + 1) {
            n = n + McpServer.InstallOne(srcDir + "/" + files[i],
                destDir + "/" + files[i], project, mcpExe, false, force);
        }
        List<string> dirs = Directory.GetDirectories(srcDir);
        for (int i = 0; i < dirs.Count; i = i + 1) {
            n = n + McpServer.InstallTree(srcDir + "/" + dirs[i],
                destDir + "/" + dirs[i], project, mcpExe, force);
        }
        return n;
    }

    // IDE 工具链交互与状态驱动契约。
    static string Expand(string text, string project, string mcpExe, bool json) {
        string sdk = McpServer.sdkRoot;
        string exe = mcpExe;
        string proj = project;
        if (json) {
            // IDE 工具链交互与状态驱动契约。
            sdk = McpServer.ToPosix(sdk);
            exe = McpServer.ToPosix(exe);
            proj = McpServer.ToPosix(proj);
        } else {
            sdk = McpServer.ToNative(sdk);
            exe = McpServer.ToNative(exe);
            proj = McpServer.ToNative(proj);
        }
        string s = McpServer.Substitute(text, "<ZAN_MCP>", exe);
        s = McpServer.Substitute(s, "<ZAN_SDK>", sdk);
        s = McpServer.Substitute(s, "<ZAN_PROJECT>", proj);
        return s;
    }

    // IDE 工具链交互与状态驱动契约。
    static string Substitute(string s, string pat, string rep) {
        if (pat.Length == 0) { return s; }
        int at = McpServer.Find(s, pat);
        if (at < 0) { return s; }
        StringBuilder sb = new StringBuilder();
        string rest = s;
        while (at >= 0) {
            sb.Append(rest.Substring(0, at));
            sb.Append(rep);
            int cut = at + pat.Length;
            rest = rest.Substring(cut, rest.Length - cut);
            at = McpServer.Find(rest, pat);
        }
        sb.Append(rest);
        return sb.ToString();
    }

    // IDE 工具链交互与状态驱动契约。
    static bool IsAbsolute(string p) {
        if (p.Length == 0) { return false; }
        int c0 = p[0] & 255;
        if (c0 == 47 || c0 == 92) { return true; }
        return p.Length > 1 && (p[1] & 255) == 58;
    }

    // IDE 工具链交互与状态驱动契约。
    static string ToPosix(string p) {
        StringBuilder sb = new StringBuilder();
        for (int i = 0; i < p.Length; i = i + 1) {
            int c = p[i] & 255;
            if (c == 92) { sb.Append("/"); } else { sb.Append(p.Substring(i, 1)); }
        }
        return sb.ToString();
    }

    // IDE 工具链交互与状态驱动契约。
    static string ToNative(string p) {
        #if WINDOWS
        StringBuilder sb = new StringBuilder();
        for (int i = 0; i < p.Length; i = i + 1) {
            int c = p[i] & 255;
            if (c == 47) { sb.Append("\\"); } else { sb.Append(p.Substring(i, 1)); }
        }
        return sb.ToString();
        #else
        return p;
        #endif
    }

    // IDE 工具链交互与状态驱动契约。
    static string RelOf(string full, string baseDir) {
        int n = baseDir.Length;
        if (full.Length > n + 1 && full.Substring(0, n) == baseDir) {
            return McpServer.ToNative(full.Substring(n + 1, full.Length - n - 1));
        }
        return McpServer.ToNative(full);
    }

    // 核心契约与执行状态转移规范。

    // IDE 工具链交互与状态驱动契约。
    static async int RunStdio() {
        McpServer.inCap = 65536;
        McpServer.inBuf = NativeMemory.Alloc(McpServer.inCap);
        McpServer.inLen = 0;
        McpServer.inPos = 0;
        #if WINDOWS
        McpServer.PlatSetMode(0, 32768);   // _O_BINARY
        McpServer.PlatSetMode(1, 32768);
        #endif
        while (true) {
            string line = McpServer.ReadStdioLine();
            if (line == null) { break; }
            string msg = McpServer.Trim(line);
            if (msg == "") { continue; }
            JsonValue v = McpServer.ParseBody(msg);
            if (v == null) {
                McpServer.WriteStdio(McpServer.RpcErrorDoc(JsonValue.NewNull(),
                    0 - 32700, McpServer.ParseErrorText()).ToJson());
                continue;
            }
            if (v.IsArray()) {
                JsonValue outArr = JsonValue.NewArray();
                for (int i = 0; i < v.Count(); i = i + 1) {
                    JsonValue one = await McpServer.RpcOne(v.At(i));
                    if (one != null) { outArr.Append(one); }
                }
                // IDE 工具链交互与状态驱动契约。
                if (outArr.Count() > 0) { McpServer.WriteStdio(outArr.ToJson()); }
                continue;
            }
            JsonValue res = await McpServer.RpcOne(v);
            if (res != null) { McpServer.WriteStdio(res.ToJson()); }
        }
        NativeMemory.Free(McpServer.inBuf);
        McpServer.inBuf = 0;
        return 0;
    }

    // IDE 工具链交互与状态驱动契约。
    // refills.
    static string ReadStdioLine() {
        StringBuilder sb = new StringBuilder();
        bool any = false;
        while (true) {
            if (McpServer.inPos >= McpServer.inLen) {
                int got = McpServer.PlatRead(0, McpServer.inBuf, McpServer.inCap);
                if (got <= 0) {
                    if (!any) { return null; }
                    return McpServer.StripCr(sb.ToString());
                }
                McpServer.inLen = got;
                McpServer.inPos = 0;
            }
            int start = McpServer.inPos;
            int avail = McpServer.inLen - start;
            int nl = NativeMemory.Find(McpServer.inBuf, start, 10, avail);
            if (nl >= 0) {
                if (nl > start) {
                    sb.Append(NativeMemory.GetString(McpServer.inBuf, start, nl - start));
                }
                McpServer.inPos = nl + 1;
                return McpServer.StripCr(sb.ToString());
            }
            sb.Append(NativeMemory.GetString(McpServer.inBuf, start, avail));
            McpServer.inPos = McpServer.inLen;
            any = true;
        }
    }

    static string StripCr(string s) {
        if (s.Length > 0 && (s[s.Length - 1] & 255) == 13) {
            return s.Substring(0, s.Length - 1);
        }
        return s;
    }

    // IDE 工具链交互与状态驱动契约。
    // 核心契约与语义定义。
    static void WriteStdio(string json) {
        string s = json + "\n";
        int n = s.Length;
        nint p = NativeMemory.Alloc(n + 1);
        NativeMemory.PutString(p, 0, s, n);
        int off = 0;
        while (off < n) {
            int w = McpServer.PlatWrite(1, p + off, n - off);
            if (w <= 0) { break; }
            off = off + w;
        }
        NativeMemory.Free(p);
    }

    static async int Run() {
        Socket.Initialize();
        HttpServer server = new HttpServer(McpServer.host, McpServer.port);
        // IDE 工具链交互与状态驱动契约。
        int bodyCap = McpServer.maxRead + 1048576;
        server.SetMaxRequestBytes(bodyCap);
        server.SetMaxConnections(512);
        server.SetTimeout(600000);
        if (McpServer.workers > 1) { server.Workers(McpServer.workers); }
        server.OnRequest(McpServer.Handle);
        await server.Start();
        return 0;
    }

    // 核心契约与执行状态转移规范。

    static async HttpResponse Handle(HttpRequest req) {
        // IDE 工具链交互与状态驱动契约。
        // 核心契约与执行状态转移规范。
        if (req.method == "OPTIONS") {
            return McpServer.Cors(HttpResponse.WithStatus(204, "No Content", ""));
        }
        if (!McpServer.AuthOk(req)) {
            return McpServer.Fail(401, "Unauthorized", "unauthorized",
                "provide 'Authorization: Bearer <token>'");
        }

        string p = req.path;
        if (req.method == "GET" && (p == "/health" || p == "/healthz")) {
            return McpServer.Ok(McpServer.HealthDoc());
        }
        if (req.method == "GET" && p == "/api/files") {
            return McpServer.RestList(McpServer.Query(req.queryString, "path"));
        }
        if (req.method == "GET" && p == "/api/file") {
            return McpServer.RestRead(req);
        }
        if (req.method == "POST" && p == "/api/file") {
            return McpServer.RestWrite(req);
        }
        if (req.method == "POST" && p == "/api/mkdir") {
            return McpServer.RestSimple(req, "mkdir");
        }
        if (req.method == "POST" && p == "/api/delete") {
            return McpServer.RestSimple(req, "delete");
        }
        if (req.method == "POST" && p == "/api/move") {
            return McpServer.RestSimple(req, "move");
        }
        if (req.method == "POST" && p == "/api/copy") {
            return McpServer.RestSimple(req, "copy");
        }
        // IDE 工具链交互与状态驱动契约。
        // 核心契约与语义定义。
        if (p == "/mcp/" || p == "/rpc/") {
            p = p.Substring(0, p.Length - 1);
        }
        if (req.method == "POST" && (p == "/" || p == "/mcp" || p == "/rpc")) {
            return await McpServer.Rpc(req.body);
        }
        if (req.method == "DELETE" && (p == "/" || p == "/mcp" || p == "/rpc")) {
            // IDE 工具链交互与状态驱动契约。
            // 核心契约与语义定义。
            return McpServer.Cors(HttpResponse.WithStatus(204, "No Content", ""));
        }
        if (req.method == "GET" && (p == "/" || p == "/mcp" || p == "/rpc")) {
            // IDE 工具链交互与状态驱动契约。
            // 核心契约与语义定义。
            if (McpServer.WantsSse(req)) {
                HttpResponse r = HttpResponse.WithStatus(405,
                    "Method Not Allowed", "");
                r = r.SetHeader("Allow", "POST, DELETE, OPTIONS");
                return McpServer.Cors(r);
            }
            // IDE 工具链交互与状态驱动契约。
            // 核心契约与语义定义。
            return McpServer.Ok(McpServer.HealthDoc());
        }
        return McpServer.Fail(404, "Not Found", "no such endpoint",
            "POST / for JSON-RPC, GET /health, GET|POST /api/file,"
            + " GET /api/files, POST /api/mkdir|delete|move|copy");
    }

    static bool WantsSse(HttpRequest req) {
        string a = req.GetHeader("Accept");
        if (a == "") { a = req.GetHeader("accept"); }
        return McpServer.Find(a.ToLower(), "text/event-stream") >= 0;
    }

    // IDE 工具链交互与状态驱动契约。
    static bool AuthOk(HttpRequest req) {
        if (McpServer.token == "") { return true; }
        string h = req.GetHeader("Authorization");
        if (h == "") { h = req.GetHeader("X-Api-Key"); }
        else {
            if (h.Length > 7 && h.Substring(0, 7) == "Bearer ") {
                h = h.Substring(7, h.Length - 7);
            }
        }
        h = McpServer.Trim(h);
        if (h.Length != McpServer.token.Length) { return false; }
        int diff = 0;
        for (int i = 0; i < h.Length; i = i + 1) {
            diff = diff | ((h[i] & 255) ^ (McpServer.token[i] & 255));
        }
        return diff == 0;
    }

    static HttpResponse Cors(HttpResponse r) {
        r = r.SetHeader("Access-Control-Allow-Origin", "*");
        r = r.SetHeader("Access-Control-Allow-Headers",
            "Authorization, Content-Type, Mcp-Session-Id, Mcp-Protocol-Version");
        r = r.SetHeader("Access-Control-Allow-Methods",
            "GET, POST, DELETE, OPTIONS");
        return r;
    }

    static HttpResponse Ok(JsonValue doc) {
        return McpServer.Cors(HttpResponse.Json(doc.ToJson()));
    }

    static HttpResponse Fail(int code, string statusText, string message,
                             string hint) {
        JsonValue o = JsonValue.NewObject();
        o.Put("ok", JsonValue.NewBool(false));
        o.Put("error", JsonValue.NewStr(message));
        if (hint != "") { o.Put("hint", JsonValue.NewStr(hint)); }
        HttpResponse r = HttpResponse.WithStatus(code, statusText, o.ToJson());
        r = r.SetContentType("application/json");
        return McpServer.Cors(r);
    }

    static JsonValue HealthDoc() {
        JsonValue o = JsonValue.NewObject();
        o.Put("ok", JsonValue.NewBool(true));
        o.Put("status", JsonValue.NewStr("ok"));
        o.Put("server", JsonValue.NewStr(McpServer.serverName));
        o.Put("version", JsonValue.NewStr(McpServer.Version()));
        o.Put("protocolVersion", JsonValue.NewStr(McpServer.ProtocolVersion()));
        o.Put("workspace", JsonValue.NewStr(McpServer.root));
        o.Put("readOnly", JsonValue.NewBool(McpServer.readOnly));
        o.Put("exec", JsonValue.NewBool(McpServer.CanExec()));
        o.Put("maxReadBytes", JsonValue.NewNum(Convert.ToString(McpServer.maxRead)));
        o.Put("zanTools", JsonValue.NewBool(McpServer.ZanToolsAvailable()));
        o.Put("frozenTools", JsonValue.NewBool(McpServer.frozenTools));
        o.Put("skillRoots", JsonValue.NewNum(
            Convert.ToString(McpServer.SkillRoots().Count)));
        o.Put("platform", JsonValue.NewStr(McpServer.Platform()));
        return o;
    }

    static string Platform() {
        #if WINDOWS
        return "windows";
        #elif MACOS
        return "macos";
        #else
        return "linux";
        #endif
    }

    // 核心契约与执行状态转移规范。

    // IDE 工具链交互与状态驱动契约。
    static HttpResponse RestRead(HttpRequest req) {
        string rel = McpServer.Query(req.queryString, "path");
        string full = McpServer.Resolve(rel);
        if (full == "") { return McpServer.Outside(rel); }
        if (Directory.Exists(full) && !File.Exists(full)) {
            return McpServer.RestList(rel);
        }
        if (!File.Exists(full)) {
            return McpServer.Fail(404, "Not Found", "file not found: " + rel, "");
        }
        int offset = McpServer.ParseInt(McpServer.Query(req.queryString, "offset"), 0);
        int limit = McpServer.ParseInt(McpServer.Query(req.queryString, "limit"), 0);
        byte[] data = McpServer.ReadSlice(full, offset, limit);
        int n = data.Length;
        if (McpServer.Query(req.queryString, "base64") == "1") {
            JsonValue o = JsonValue.NewObject();
            o.Put("path", JsonValue.NewStr(rel));
            o.Put("encoding", JsonValue.NewStr("base64"));
            o.Put("bytes", JsonValue.NewNum(Convert.ToString(n)));
            o.Put("content_base64",
                JsonValue.NewStr(Encoding.Base64EncodeBytes(data, n)));
            return McpServer.Ok(o);
        }
        string ct = "application/octet-stream";
        if (McpServer.Utf8Valid(data, n)) { ct = "text/plain; charset=utf-8"; }
        // IDE 工具链交互与状态驱动契约。
        HttpResponse r = HttpResponse.Bytes(data, n, ct);
        r = r.SetHeader("X-Content-Bytes", Convert.ToString(n));
        return McpServer.Cors(r);
    }

    static HttpResponse RestList(string rel) {
        string full = McpServer.Resolve(rel);
        if (full == "") { return McpServer.Outside(rel); }
        if (!Directory.Exists(full)) {
            return McpServer.Fail(404, "Not Found", "directory not found: " + rel, "");
        }
        return McpServer.Ok(McpServer.ListDoc(rel, full));
    }

    static HttpResponse RestWrite(HttpRequest req) {
        if (McpServer.readOnly) { return McpServer.ReadOnlyFail(); }
        JsonValue body = McpServer.ParseBody(req.body);
        if (body == null) {
            return McpServer.Fail(400, "Bad Request", "request body is not valid JSON",
                "send {\"path\":\"...\",\"content\":\"...\"}");
        }
        string rel = body.Str("path", "");
        string full = McpServer.Resolve(rel);
        if (full == "") { return McpServer.Outside(rel); }
        byte[] data = null;
        if (body.Has("content_base64")) {
            try {
                data = Encoding.Base64Decode(body.Str("content_base64", ""));
            } catch (ArgumentException e) {
                return McpServer.Fail(400, "Bad Request",
                    "content_base64 is not valid base64: " + e.Message, "");
            }
        } else {
            data = body.Str("content", "").ToBytes();
        }
        string why = McpServer.WriteFile(full, data, body.Bool("append", false));
        if (why != "") {
            return McpServer.Fail(500, "Internal Server Error", why, "");
        }
        JsonValue o = JsonValue.NewObject();
        o.Put("ok", JsonValue.NewBool(true));
        o.Put("path", JsonValue.NewStr(rel));
        o.Put("size", JsonValue.NewNum(Convert.ToString(data.Length)));
        return McpServer.Ok(o);
    }

    // IDE 工具链交互与状态驱动契约。
    // 核心契约与语义定义。
    static HttpResponse RestSimple(HttpRequest req, string verb) {
        if (McpServer.readOnly) { return McpServer.ReadOnlyFail(); }
        JsonValue body = McpServer.ParseBody(req.body);
        if (body == null) {
            return McpServer.Fail(400, "Bad Request", "request body is not valid JSON", "");
        }
        JsonValue args = body;
        string text = McpServer.FileTool(verb, args);
        if (text.Length >= 6 && text.Substring(0, 6) == "error:") {
            return McpServer.Fail(400, "Bad Request",
                text.Substring(7, text.Length - 7), "");
        }
        JsonValue o = JsonValue.NewObject();
        o.Put("ok", JsonValue.NewBool(true));
        o.Put("result", JsonValue.NewStr(text));
        return McpServer.Ok(o);
    }

    static HttpResponse Outside(string rel) {
        return McpServer.Fail(403, "Forbidden",
            "path escapes the workspace root: " + rel,
            "use workspace-relative paths without '..' or a drive letter");
    }

    static HttpResponse ReadOnlyFail() {
        return McpServer.Fail(403, "Forbidden", "server is running --read-only", "");
    }

    // ---- JSON-RPC -----------------------------------------------------------

    static async HttpResponse Rpc(string body) {
        JsonValue v = McpServer.ParseBody(body);
        if (v == null) {
            return McpServer.RpcFail(JsonValue.NewNull(), 0 - 32700,
                McpServer.ParseErrorText());
        }
        // IDE 工具链交互与状态驱动契约。
        // 核心契约与语义定义。
        if (v.IsArray()) {
            JsonValue outArr = JsonValue.NewArray();
            for (int i = 0; i < v.Count(); i = i + 1) {
                JsonValue one = await McpServer.RpcOne(v.At(i));
                if (one != null) { outArr.Append(one); }
            }
            if (outArr.Count() == 0) { return McpServer.Accepted(); }
            return McpServer.Cors(HttpResponse.Json(outArr.ToJson()));
        }
        JsonValue res = await McpServer.RpcOne(v);
        if (res == null) { return McpServer.Accepted(); }
        return McpServer.Cors(HttpResponse.Json(res.ToJson()));
    }

    // IDE 工具链交互与状态驱动契约。
    // 核心契约与语义定义。
    static HttpResponse Accepted() {
        return McpServer.Cors(HttpResponse.WithStatus(202, "Accepted", ""));
    }

    // IDE 工具链交互与状态驱动契约。
    static async JsonValue RpcOne(JsonValue v) {
        if (v == null || !v.IsObject()) {
            return McpServer.RpcErrorDoc(JsonValue.NewNull(), 0 - 32600,
                "invalid request: expected a JSON-RPC object");
        }
        // IDE 工具链交互与状态驱动契约。
        JsonValue id = v.Get("id");
        bool isNotification = id == null || id.IsNull();
        string rpc = v.Str("method", "");
        JsonValue p = v.Get("params");

        if (rpc == "") {
            if (isNotification) { return null; }
            return McpServer.RpcErrorDoc(id, 0 - 32600, "invalid request: no method");
        }
        if (rpc == "notifications/initialized" || rpc == "initialized"
            || rpc == "notifications/cancelled") {
            if (isNotification) { return null; }
            return McpServer.RpcResultDoc(id, JsonValue.NewObject());
        }
        if (rpc == "ping") {
            return McpServer.RpcResultDoc(id, JsonValue.NewObject());
        }
        if (rpc == "initialize") {
            string want = "";
            if (p != null) { want = p.Str("protocolVersion", ""); }
            string speak = McpServer.ProtocolVersion();
            if (McpServer.SpeaksProtocol(want)) { speak = want; }
            JsonValue caps = JsonValue.NewObject();
            caps.Put("tools", JsonValue.NewObject());
            JsonValue resCap = JsonValue.NewObject();
            resCap.Put("listChanged", JsonValue.NewBool(false));
            caps.Put("resources", resCap);
            JsonValue info = JsonValue.NewObject();
            info.Put("name", JsonValue.NewStr(McpServer.serverName));
            info.Put("version", JsonValue.NewStr(McpServer.Version()));
            JsonValue r = JsonValue.NewObject();
            r.Put("protocolVersion", JsonValue.NewStr(speak));
            r.Put("capabilities", caps);
            r.Put("serverInfo", info);
            r.Put("instructions", JsonValue.NewStr(
                "Call zan_start_here FIRST: one call returns the project"
                + " layout, the build and test commands, the Zan coding rules"
                + " and what every other tool is for, so you never have to"
                + " crawl the tree to get oriented. Before writing Zan code,"
                + " look the API up with zan_lookup_symbol /"
                + " zan_list_members (zan_api_search for fuzzy fragments),"
                + " check the blast radius of an edit with zan_find_refs, and"
                + " copy a shipped pattern from zan_example instead of"
                + " reading whole files or guessing signatures;"
                + " check your edit with zan_compile / zan_build_project and"
                + " read the structured diagnostics."
                + " Workspace-scoped file and shell access: paths are relative"
                + " to the workspace root; '..' and absolute paths are"
                + " rejected. Use read_file with encoding=base64 for binary"
                + " files."));
            return McpServer.RpcResultDoc(id, r);
        }
        if (rpc == "tools/list") {
            JsonValue r = JsonValue.NewObject();
            r.Put("tools", McpServer.ToolsDoc());
            return McpServer.RpcResultDoc(id, r);
        }
        if (rpc == "resources/list") {
            JsonValue r = JsonValue.NewObject();
            r.Put("resources", McpServer.ResourcesDoc());
            return McpServer.RpcResultDoc(id, r);
        }
        if (rpc == "resources/read") {
            string uri = "";
            if (p != null) { uri = p.Str("uri", ""); }
            return McpServer.ReadResource(id, uri);
        }
        if (rpc == "prompts/list") {
            JsonValue r = JsonValue.NewObject();
            r.Put("prompts", JsonValue.NewArray());
            return McpServer.RpcResultDoc(id, r);
        }
        if (rpc == "tools/call") {
            string name = "";
            JsonValue targs = null;
            if (p != null) {
                name = p.Str("name", "");
                targs = p.Get("arguments");
            }
            if (targs == null) { targs = JsonValue.NewObject(); }
            string text = await McpServer.CallTool(name, targs);
            bool bad = text.Length >= 6 && text.Substring(0, 6) == "error:";
            JsonValue r = JsonValue.NewObject();
            JsonValue content = JsonValue.NewArray();
            JsonValue item = JsonValue.NewObject();
            item.Put("type", JsonValue.NewStr("text"));
            item.Put("text", JsonValue.NewStr(text));
            content.Append(item);
            r.Put("content", content);
            // IDE 工具链交互与状态驱动契约。
            r.Put("isError", JsonValue.NewBool(bad));
            return McpServer.RpcResultDoc(id, r);
        }
        if (isNotification) { return null; }
        return McpServer.RpcErrorDoc(id, 0 - 32601, "method not found: " + rpc);
    }

    static JsonValue RpcResultDoc(JsonValue id, JsonValue result) {
        JsonValue o = JsonValue.NewObject();
        o.Put("jsonrpc", JsonValue.NewStr("2.0"));
        o.Put("id", McpServer.IdOf(id));
        o.Put("result", result);
        return o;
    }

    static JsonValue RpcErrorDoc(JsonValue id, int code, string msg) {
        JsonValue o = JsonValue.NewObject();
        o.Put("jsonrpc", JsonValue.NewStr("2.0"));
        o.Put("id", McpServer.IdOf(id));
        JsonValue e = JsonValue.NewObject();
        e.Put("code", JsonValue.NewNum(Convert.ToString(code)));
        e.Put("message", JsonValue.NewStr(msg));
        o.Put("error", e);
        return o;
    }

    static JsonValue IdOf(JsonValue id) {
        if (id == null) { return JsonValue.NewNull(); }
        return id;
    }

    static HttpResponse RpcFail(JsonValue id, int code, string msg) {
        JsonValue doc = McpServer.RpcErrorDoc(id, code, msg);
        return McpServer.Cors(HttpResponse.Json(doc.ToJson()));
    }

    // IDE 工具链交互与状态驱动契约。
    // 核心契约与语义定义。
    static JsonValue ParseBody(string body) {
        McpServer.parseError = "";
        if (McpServer.Trim(body) == "") {
            McpServer.parseError = "empty request body";
            return null;
        }
        try {
            return JsonValue.Parse(body);
        } catch (JsonException e) {
            McpServer.parseError = e.Message;
            return null;
        }
    }

    static string ParseErrorText() {
        if (McpServer.parseError == "") { return "parse error"; }
        return "parse error: " + McpServer.parseError;
    }

    // ---- resources ----------------------------------------------------------
    // IDE 工具链交互与状态驱动契约。

    static JsonValue ResourcesDoc() {
        JsonValue arr = JsonValue.NewArray();
        // IDE 工具链交互与状态驱动契约。
        McpServer.AddResource(arr, "repo://map", ".zanmap/repo.map.txt",
            "Workspace outline: every file with its classes and members",
            "text/plain");
        McpServer.AddResource(arr, "repo://symbols", ".zanmap/symbols.json",
            "Symbol index (one JSON record per line)", "application/json");
        McpServer.AddResource(arr, "repo://routes", McpServer.RoutesRel(),
            "HTTP route index", "application/json");
        McpServer.AddResource(arr, "repo://entities", ".zanmap/entities.json",
            "ORM entities: table, columns, indexes and generated facades",
            "application/json");
        McpServer.AddResource(arr, "repo://index", ".zanmap/index.json",
            "Semantic index manifest: counts and the source file table",
            "application/json");
        return arr;
    }

    static void AddResource(JsonValue arr, string uri, string rel, string desc,
                            string mime) {
        if (!File.Exists(McpServer.root + "/" + rel)) { return; }
        JsonValue o = JsonValue.NewObject();
        o.Put("uri", JsonValue.NewStr(uri));
        o.Put("name", JsonValue.NewStr(rel));
        o.Put("description", JsonValue.NewStr(desc));
        o.Put("mimeType", JsonValue.NewStr(mime));
        arr.Append(o);
    }

    // IDE 工具链交互与状态驱动契约。
    // 核心契约与语义定义。
    static string RoutesRel() {
        string p = McpServer.routesIndexPath;
        string approx = "routes.approx.json";
        if (p.Length >= approx.Length
            && p.Substring(p.Length - approx.Length, approx.Length) == approx) {
            return ".zanmap/" + approx;
        }
        return ".zanmap/routes.json";
    }

    static JsonValue ReadResource(JsonValue id, string uri) {
        string rel = "";
        string mime = "application/json";
        if (uri == "repo://map") { rel = ".zanmap/repo.map.txt"; mime = "text/plain"; }
        if (uri == "repo://symbols") { rel = ".zanmap/symbols.json"; }
        if (uri == "repo://routes") { rel = McpServer.RoutesRel(); }
        if (uri == "repo://entities") { rel = ".zanmap/entities.json"; }
        if (uri == "repo://index") { rel = ".zanmap/index.json"; }
        if (rel == "") {
            return McpServer.RpcErrorDoc(id, 0 - 32602, "unknown resource: " + uri);
        }
        string full = McpServer.root + "/" + rel;
        if (!File.Exists(full)) {
            return McpServer.RpcErrorDoc(id, 0 - 32002,
                "resource not generated yet: " + rel
                + "; build tools/repomap/RepoMap.zan and run it on this workspace");
        }
        JsonValue item = JsonValue.NewObject();
        item.Put("uri", JsonValue.NewStr(uri));
        item.Put("mimeType", JsonValue.NewStr(mime));
        item.Put("text", JsonValue.NewStr(File.ReadAllText(full)));
        JsonValue contents = JsonValue.NewArray();
        contents.Append(item);
        JsonValue r = JsonValue.NewObject();
        r.Put("contents", contents);
        return McpServer.RpcResultDoc(id, r);
    }

    // ---- tools --------------------------------------------------------------

    static async string CallTool(string name, JsonValue args) {
        if (name == "zan_start_here" || name == "start_here") {
            return McpServer.StartHere().ToJson();
        }
        if (name == "health_check") { return McpServer.HealthDoc().ToJson(); }
        if (name == "run_command") { return await McpServer.RunCommand(args); }
        if (name == "skills_list") { return McpServer.SkillsList(); }
        if (name == "skill_read" || name == "skill_get") {
            return McpServer.SkillRead(args);
        }

        // IDE 工具链交互与状态驱动契约。
        if (name == "zan_api_search") {
            return McpServer.ApiSearch(args.Str("query", ""), args.Int("limit", 40));
        }
        if (name == "zan_lookup_symbol" || name == "lookup_symbol") {
            return McpServer.LookupSymbol(args.Str("name", ""), args.Int("limit", 10));
        }
        if (name == "zan_list_members" || name == "list_members") {
            return McpServer.ListMembers(args.Str("type", ""), args.Str("filter", ""),
                                        args.Int("limit", 80));
        }
        if (name == "zan_find_refs" || name == "find_refs") {
            return McpServer.FindRefs(args.Str("name", ""), args.Int("limit", 30));
        }
        if (name == "zan_call_chain" || name == "call_chain" || name == "get_call_chain") {
            return McpServer.CallChain(args.Str("symbol", ""),
                                      args.Str("direction", "outgoing"),
                                      args.Int("depth", 3));
        }
        if (name == "zan_type_hierarchy" || name == "type_hierarchy" || name == "get_type_hierarchy") {
            return McpServer.TypeHierarchy(args.Str("type", args.Str("name", "")));
        }
        if (name == "zan_blast_radius" || name == "blast_radius" || name == "analyze_impact") {
            return McpServer.BlastRadius(args.Str("symbol", ""),
                                        args.Int("depth", 4));
        }
        if (name == "zan_arch_check" || name == "arch_check" || name == "check_architecture") {
            return McpServer.ArchCheck();
        }
        if (name == "zan_gui_preview" || name == "gui_preview") {
            return McpServer.GuiPreview(args.Str("file", ""),
                                       args.Int("delay_ms", 800),
                                       args.Str("output", "_scratch/gui_preview.png"));
        }
        if (name == "zan_project_overview" || name == "project_overview") {
            return McpServer.ProjectOverview(args.Int("limit", 40));
        }
        if (name == "zan_route_lookup" || name == "route_lookup") {
            return McpServer.RouteLookup(args);
        }
        if (name == "zan_change_impact" || name == "change_impact") {
            return McpServer.ChangeImpact(args.Str("symbol", ""),
                                         args.Int("limit", 30));
        }
        if (name == "zan_read_context" || name == "read_context") {
            return McpServer.ReadContext(args.Str("symbol", ""),
                                        args.Int("before", 4),
                                        args.Int("lines", 80));
        }
        if (name == "zan_orm_lookup" || name == "orm_lookup") {
            return McpServer.OrmLookup(args);
        }
        if (name == "zan_refresh_index") {
            if (!McpServer.Mutable()) { return McpServer.ReadOnlyMsg(); }
            if (!McpServer.ZanToolsAvailable()) { return McpServer.NoZancMsg(); }
            return await McpServer.RefreshIndex();
        }
        if (name == "zan_example") { return McpServer.Example(args.Str("topic", "")); }
        if (name == "zan_control_schema" || name == "zan_form_schema") {
            return McpServer.FormSchema(args.Str("control", ""));
        }
        if (name == "zan_refresh_knowledge") {
            if (!McpServer.Mutable()) { return McpServer.ReadOnlyMsg(); }
            return McpServer.RefreshKnowledge();
        }
        if (name == "zan_compile") {
            if (!McpServer.Mutable()) { return McpServer.ReadOnlyMsg(); }
            if (!McpServer.ZanToolsAvailable()) { return McpServer.NoZancMsg(); }
            return await McpServer.Compile(args.Str("filename", ""),
                args.Str("content", ""));
        }
        if (name == "zan_build_project" || name == "build") {
            if (!McpServer.Mutable()) { return McpServer.ReadOnlyMsg(); }
            if (!McpServer.ZanToolsAvailable()) { return McpServer.NoZancMsg(); }
            return await McpServer.BuildProject(args.Str("entry", ""));
        }
        string text = McpServer.FileTool(name, args);
        if (text != "") { return text; }
        return "error: unknown tool '" + name + "'; call tools/list for the catalog";
    }

    static bool Mutable() { return !McpServer.readOnly; }
    static string KnowledgeSeedPath() {
        string sdkSeed = McpServer.knowledge + "/gallery.seed.json";
        if (File.Exists(sdkSeed)) { return sdkSeed; }
        return McpServer.root + "/tools/mcp_server/gallery.json";
    }
    static bool KnowledgeInputs() {
        return File.Exists(McpServer.KnowledgeSeedPath());
    }

    static long LatestMtime(string dir) {
        if (!Directory.Exists(dir)) { return 0; }
        long latest = FileInfo.GetLastWriteTime(dir);
        List<string> fs = Directory.GetFiles(dir);
        for (int i = 0; i < fs.Count; i = i + 1) {
            long t = FileInfo.GetLastWriteTime(dir + "/" + fs[i]);
            if (t > latest) { latest = t; }
        }
        List<string> ds = Directory.GetDirectories(dir);
        for (int i = 0; i < ds.Count; i = i + 1) {
            long t = McpServer.LatestMtime(dir + "/" + ds[i]);
            if (t > latest) { latest = t; }
        }
        return latest;
    }

    static void KnowledgeCheck(bool deep) {
        McpServer.knowledgeFresh = false;
        bool g = File.Exists(McpServer.galleryPath);
        bool s = File.Exists(McpServer.indexPath);
        if (!g || !s) {
            McpServer.knowledgeStatus = "missing knowledge artifact";
            return;
        }
        long latest = FileInfo.GetLastWriteTime(
            McpServer.KnowledgeSeedPath());
        if (deep) {
            long templates = McpServer.LatestMtime(
                McpServer.root + "/templates");
            long examples = McpServer.LatestMtime(
                McpServer.root + "/examples");
            long gui = McpServer.LatestMtime(McpServer.stdlibPath + "/Gui");
            if (templates > latest) { latest = templates; }
            if (examples > latest) { latest = examples; }
            if (gui > latest) { latest = gui; }
        }
        if (FileInfo.GetLastWriteTime(McpServer.galleryPath) < latest) {
            McpServer.knowledgeStatus = "knowledge artifacts are stale";
            return;
        }
        // IDE 工具链交互与状态驱动契约。
        long code = McpServer.LatestMtime(McpServer.root + "/src/compiler");
        long rt = McpServer.LatestMtime(McpServer.root + "/src/runtime");
        if (rt > code) { code = rt; }
        if (deep) {
            long sl = McpServer.LatestMtime(McpServer.stdlibPath);
            if (sl > code) { code = sl; }
        }
        if (code > 0 && FileInfo.GetLastWriteTime(McpServer.indexPath) < code) {
            McpServer.knowledgeStatus = "symbol index is stale; rebuild it "
                + "with tools/repomap/RepoMap.zan";
            return;
        }
        McpServer.knowledgeFresh = true;
        McpServer.knowledgeStatus = "knowledge artifacts are fresh";
    }

    static string RefreshKnowledge() {
        JsonValue o = JsonValue.NewObject();
        if (!McpServer.KnowledgeInputs()) {
            o.Put("ok", JsonValue.NewBool(false));
            o.Put("error", JsonValue.NewStr(
                "knowledge generation inputs are unavailable"));
            return o.ToJson();
        }
        try {
            GalleryResult g = GalleryIndex.Generate(McpServer.root,
                McpServer.KnowledgeSeedPath());
            File.WriteAllText(McpServer.galleryPath, g.json);
            McpServer.KnowledgeCheck(true);
            o.Put("ok", JsonValue.NewBool(true));
            o.Put("galleryEntries", JsonValue.NewNum(Convert.ToString(g.entries)));
            o.Put("knowledgeFresh", JsonValue.NewBool(McpServer.knowledgeFresh));
            JsonValue ws = JsonValue.NewArray();
            for (int i = 0; i < g.warnings.Count; i = i + 1) {
                ws.Append(JsonValue.NewStr(g.warnings[i]));
            }
            o.Put("warnings", ws);
            if (!File.Exists(McpServer.indexPath)) {
                o.Put("symbols", JsonValue.NewStr(
                    "symbols.json is absent; generate it with: zanc "
                    + "tools/repomap/RepoMap.zan --auto-stdlib -o repomap.exe"
                    + " && repomap.exe stdlib"));
            } else {
                o.Put("symbols", JsonValue.NewStr("symbols.json present"));
            }
        } catch (Exception e) {
            o.Put("ok", JsonValue.NewBool(false));
            o.Put("error", JsonValue.NewStr(e.Message));
        }
        return o.ToJson();
    }
    static string ReadOnlyMsg() { return "error: server is running --read-only"; }

    static string NoZancMsg() {
        return "error: no Zan toolchain next to this server (looked for "
            + McpServer.zancPath + "); pass --zanc <path> to enable the zan_* tools";
    }

    // IDE 工具链交互与状态驱动契约。
    static string FileTool(string name, JsonValue args) {
        string rel = args.Str("path", "");
        if (name == "list_dir" || name == "list_files") {
            string full = McpServer.Resolve(rel);
            if (full == "") { return McpServer.OutsideMsg(rel); }
            if (!Directory.Exists(full)) {
                return "error: directory not found: " + rel;
            }
            return McpServer.ListDoc(rel, full).ToJson();
        }
        if (name == "read_file") {
            string full = McpServer.Resolve(rel);
            if (full == "") { return McpServer.OutsideMsg(rel); }
            if (!File.Exists(full)) { return "error: file not found: " + rel; }
            return McpServer.ReadDoc(rel, full, args);
        }
        if (name == "stat_path") {
            string full = McpServer.Resolve(rel);
            if (full == "") { return McpServer.OutsideMsg(rel); }
            return McpServer.StatDoc(rel, full).ToJson();
        }
        if (name == "find_files") {
            string full = McpServer.Resolve(rel);
            if (full == "") { return McpServer.OutsideMsg(rel); }
            return McpServer.FindFiles(rel, args);
        }
        if (name == "search_text") {
            return McpServer.SearchText(rel, args);
        }
        if (name == "write_file") {
            if (!McpServer.Mutable()) { return McpServer.ReadOnlyMsg(); }
            string full = McpServer.Resolve(rel);
            if (full == "") { return McpServer.OutsideMsg(rel); }
            byte[] data = null;
            if (args.Has("content_base64")) {
                try {
                    data = Encoding.Base64Decode(args.Str("content_base64", ""));
                } catch (ArgumentException e) {
                    return "error: content_base64 is not valid base64: " + e.Message;
                }
            } else {
                data = args.Str("content", "").ToBytes();
            }
            string why = McpServer.WriteFile(full, data, args.Bool("append", false));
            if (why != "") { return "error: " + why; }
            JsonValue o = JsonValue.NewObject();
            o.Put("ok", JsonValue.NewBool(true));
            o.Put("path", JsonValue.NewStr(rel));
            o.Put("bytes", JsonValue.NewNum(Convert.ToString(data.Length)));
            return o.ToJson();
        }
        if (name == "edit_file") {
            if (!McpServer.Mutable()) { return McpServer.ReadOnlyMsg(); }
            string full = McpServer.Resolve(rel);
            if (full == "") { return McpServer.OutsideMsg(rel); }
            if (!File.Exists(full)) {
                return "error: file not found: " + rel
                    + "; use write_file to create it";
            }
            return McpServer.EditFile(rel, full, args);
        }
        if (name == "mkdir") {
            if (!McpServer.Mutable()) { return McpServer.ReadOnlyMsg(); }
            string full = McpServer.Resolve(rel);
            if (full == "") { return McpServer.OutsideMsg(rel); }
            Directory.CreateDirectoryRecursive(full);
            if (!Directory.Exists(full)) {
                return "error: could not create directory: " + rel;
            }
            return "ok: created " + rel;
        }
        if (name == "delete_path" || name == "delete") {
            if (!McpServer.Mutable()) { return McpServer.ReadOnlyMsg(); }
            string full = McpServer.Resolve(rel);
            if (full == "") { return McpServer.OutsideMsg(rel); }
            if (full == McpServer.root) {
                return "error: refusing to delete the workspace root";
            }
            if (File.Exists(full)) {
                File.Delete(full);
                return "ok: deleted " + rel;
            }
            if (Directory.Exists(full)) {
                if (!args.Bool("recursive", false)) {
                    return "error: " + rel + " is a directory; pass recursive=true";
                }
                int n = McpServer.DeleteTree(full);
                return "ok: deleted " + rel + " (" + Convert.ToString(n) + " entries)";
            }
            return "error: path not found: " + rel;
        }
        if (name == "move_path" || name == "move" || name == "copy_path"
            || name == "copy") {
            if (!McpServer.Mutable()) { return McpServer.ReadOnlyMsg(); }
            string fromRel = args.Str("from", "");
            string toRel = args.Str("to", "");
            if (fromRel == "") { fromRel = rel; }
            string from = McpServer.Resolve(fromRel);
            string to = McpServer.Resolve(toRel);
            if (from == "") { return McpServer.OutsideMsg(fromRel); }
            if (to == "") { return McpServer.OutsideMsg(toRel); }
            if (!File.Exists(from)) { return "error: file not found: " + fromRel; }
            McpServer.EnsureParent(to);
            bool moving = name == "move_path" || name == "move";
            if (moving) { File.Move(from, to); } else { File.Copy(from, to); }
            if (moving) { return "ok: moved " + fromRel + " -> " + toRel; }
            return "ok: copied " + fromRel + " -> " + toRel;
        }
        return "";
    }

    static string OutsideMsg(string rel) {
        return "error: path escapes the workspace root: '" + rel + "'";
    }

    // 核心契约与执行状态转移规范。

    static JsonValue ListDoc(string rel, string full) {
        List<string> dirs = Directory.GetDirectories(full);
        List<string> files = Directory.GetFiles(full);
        JsonValue entries = JsonValue.NewArray();
        for (int i = 0; i < dirs.Count; i = i + 1) {
            JsonValue e = JsonValue.NewObject();
            e.Put("name", JsonValue.NewStr(dirs[i]));
            e.Put("type", JsonValue.NewStr("dir"));
            entries.Append(e);
        }
        for (int i = 0; i < files.Count; i = i + 1) {
            JsonValue e = JsonValue.NewObject();
            e.Put("name", JsonValue.NewStr(files[i]));
            e.Put("type", JsonValue.NewStr("file"));
            e.Put("size", JsonValue.NewNum(
                Convert.ToString(McpServer.SizeOf(full + "/" + files[i]))));
            entries.Append(e);
        }
        JsonValue o = JsonValue.NewObject();
        o.Put("type", JsonValue.NewStr("directory"));
        o.Put("path", JsonValue.NewStr(rel));
        o.Put("count", JsonValue.NewNum(Convert.ToString(entries.Count())));
        o.Put("entries", entries);
        return o;
    }

    static JsonValue StatDoc(string rel, string full) {
        JsonValue o = JsonValue.NewObject();
        o.Put("path", JsonValue.NewStr(rel));
        bool isDir = Directory.Exists(full) && !File.Exists(full);
        bool exists = isDir || File.Exists(full);
        o.Put("exists", JsonValue.NewBool(exists));
        if (!exists) { return o; }
        o.Put("type", JsonValue.NewStr(McpServer.KindName(isDir)));
        if (!isDir) {
            o.Put("size", JsonValue.NewNum(Convert.ToString(McpServer.SizeOf(full))));
        }
        FileInfo fi = new FileInfo(full);
        o.Put("modified", JsonValue.NewNum(Convert.ToString(fi.LastWriteTime())));
        return o;
    }

    // IDE 工具链交互与状态驱动契约。
    static int SizeOf(string full) {
        FileInfo fi = new FileInfo(full);
        long n = fi.Length();
        if (n < 0) { return 0; }
        return (int)n;
    }

    static string KindName(bool isDir) {
        if (isDir) { return "dir"; }
        return "file";
    }

    // IDE 工具链交互与状态驱动契约。
    static string ReadDoc(string rel, string full, JsonValue args) {
        // IDE 工具链交互与状态驱动契约。
        if (args.Int("from_line", 0) > 0) {
            return McpServer.ReadLinesDoc(rel, full, args);
        }
        int offset = args.Int("offset", 0);
        int limit = args.Int("limit", 0);
        byte[] data = McpServer.ReadSlice(full, offset, limit);
        int n = data.Length;
        int total = McpServer.SizeOf(full);
        bool wantB64 = args.Str("encoding", "") == "base64";
        bool text = McpServer.Utf8Valid(data, n);
        JsonValue o = JsonValue.NewObject();
        o.Put("path", JsonValue.NewStr(rel));
        o.Put("bytes", JsonValue.NewNum(Convert.ToString(n)));
        o.Put("size", JsonValue.NewNum(Convert.ToString(total)));
        o.Put("offset", JsonValue.NewNum(Convert.ToString(offset)));
        o.Put("truncated", JsonValue.NewBool(offset + n < total));
        if (text && !wantB64) {
            o.Put("encoding", JsonValue.NewStr("text"));
            o.Put("content", JsonValue.NewStr(data.ToStr(0, n)));
        } else {
            o.Put("encoding", JsonValue.NewStr("base64"));
            o.Put("binary", JsonValue.NewBool(!text));
            o.Put("content_base64",
                JsonValue.NewStr(Encoding.Base64EncodeBytes(data, n)));
        }
        return o.ToJson();
    }

    // IDE 工具链交互与状态驱动契约。
    // 核心契约与语义定义。
    static string ReadLinesDoc(string rel, string full, JsonValue args) {
        int from = args.Int("from_line", 1);
        int want = args.Int("max_lines", 120);
        if (from < 1) { from = 1; }
        if (want <= 0) { want = 120; }
        bool numbered = args.Bool("numbered", true);
        List<string> lines = File.ReadAllLines(full);
        int last = from + want - 1;
        if (last > lines.Count) { last = lines.Count; }
        StringBuilder sb = new StringBuilder();
        int i = from;
        while (i <= last) {
            if (numbered) { sb.Append(Convert.ToString(i) + "| "); }
            sb.Append(lines[i - 1] + "\n");
            i = i + 1;
        }
        JsonValue o = JsonValue.NewObject();
        o.Put("path", JsonValue.NewStr(rel));
        o.Put("encoding", JsonValue.NewStr("text"));
        o.Put("lines", JsonValue.NewNum(Convert.ToString(lines.Count)));
        o.Put("from_line", JsonValue.NewNum(Convert.ToString(from)));
        o.Put("to_line", JsonValue.NewNum(Convert.ToString(last)));
        o.Put("numbered", JsonValue.NewBool(numbered));
        o.Put("truncated", JsonValue.NewBool(last < lines.Count));
        o.Put("content", JsonValue.NewStr(sb.ToString()));
        return o.ToJson();
    }

    // IDE 工具链交互与状态驱动契约。
    static string EditFile(string rel, string full, JsonValue args) {
        string oldText = args.Str("old", "");
        string newText = args.Str("new", "");
        if (oldText == "") {
            return "error: 'old' is required and must not be empty;"
                + " use write_file to create a file";
        }
        if (oldText == newText) {
            return "error: 'old' and 'new' are identical; nothing to do";
        }
        string text = File.ReadAllText(full);
        int hits = McpServer.CountOccurrences(text, oldText);
        if (hits == 0) {
            return "error: 'old' does not occur in " + rel
                + "; read the exact text first (read_file with from_line)"
                + " and copy it byte for byte, whitespace included";
        }
        bool all = args.Bool("all", false);
        if (hits > 1 && !all) {
            return "error: 'old' occurs " + Convert.ToString(hits) + " times in "
                + rel + "; extend it with surrounding lines until it is unique,"
                + " or pass all=true to replace every occurrence";
        }
        int at = McpServer.Find(text, oldText);
        int line = McpServer.LineOf(text, at);
        string outText = "";
        if (all) { outText = McpServer.ReplaceAll(text, oldText, newText); }
        else {
            outText = text.Substring(0, at) + newText
                + text.Substring(at + oldText.Length,
                    text.Length - at - oldText.Length);
        }
        string why = McpServer.WriteFile(full, outText.ToBytes(), false);
        if (why != "") { return "error: " + why; }
        JsonValue o = JsonValue.NewObject();
        o.Put("ok", JsonValue.NewBool(true));
        o.Put("path", JsonValue.NewStr(rel));
        int done = 1;
        if (all) { done = hits; }
        o.Put("replacements", JsonValue.NewNum(Convert.ToString(done)));
        o.Put("line", JsonValue.NewNum(Convert.ToString(line)));
        o.Put("bytes", JsonValue.NewNum(Convert.ToString(outText.Length)));
        return o.ToJson();
    }

    static int CountOccurrences(string hay, string needle) {
        if (needle.Length == 0) { return 0; }
        int n = 0;
        int i = 0;
        while (i + needle.Length <= hay.Length) {
            int at = McpServer.Find(hay.Substring(i, hay.Length - i), needle);
            if (at < 0) { break; }
            n = n + 1;
            i = i + at + needle.Length;
        }
        return n;
    }

    static string ReplaceAll(string hay, string needle, string with) {
        StringBuilder sb = new StringBuilder();
        int i = 0;
        while (i < hay.Length) {
            int at = McpServer.Find(hay.Substring(i, hay.Length - i), needle);
            if (at < 0) {
                sb.Append(hay.Substring(i, hay.Length - i));
                break;
            }
            sb.Append(hay.Substring(i, at));
            sb.Append(with);
            i = i + at + needle.Length;
        }
        return sb.ToString();
    }

    // 核心契约与语义定义。
    static int LineOf(string text, int at) {
        int line = 1;
        for (int i = 0; i < at && i < text.Length; i = i + 1) {
            if ((text[i] & 255) == 10) { line = line + 1; }
        }
        return line;
    }

    // ---- skills -------------------------------------------------------------
    // IDE 工具链交互与状态驱动契约。
    // 30k one.

    static List<string> SkillRoots() {
        List<string> outs = new List<string>();
        string ws = McpServer.root + "/.agents/skills";
        if (Directory.Exists(ws)) { outs.Add(ws); }
        if (McpServer.skillsDir != "" && Directory.Exists(McpServer.skillsDir)
            && McpServer.skillsDir != ws) {
            outs.Add(McpServer.skillsDir);
        }
        return outs;
    }

    static string SkillsList() {
        JsonValue arr = JsonValue.NewArray();
        List<string> roots = McpServer.SkillRoots();
        for (int r = 0; r < roots.Count; r = r + 1) {
            List<string> names = Directory.GetDirectories(roots[r]);
            for (int i = 0; i < names.Count; i = i + 1) {
                string md = roots[r] + "/" + names[i] + "/SKILL.md";
                if (!File.Exists(md)) { continue; }
                JsonValue o = JsonValue.NewObject();
                o.Put("name", JsonValue.NewStr(names[i]));
                o.Put("summary", JsonValue.NewStr(McpServer.SkillSummary(md)));
                o.Put("bytes", JsonValue.NewNum(
                    Convert.ToString(McpServer.SizeOf(md))));
                string scope = "project";
                if (r > 0 || roots[r] != McpServer.root + "/.agents/skills") {
                    scope = "installed";
                }
                o.Put("scope", JsonValue.NewStr(scope));
                arr.Append(o);
            }
        }
        JsonValue res = JsonValue.NewObject();
        res.Put("count", JsonValue.NewNum(Convert.ToString(arr.Count())));
        res.Put("skills", arr);
        res.Put("usage", JsonValue.NewStr(
            "Read a skill only when its summary matches the task:"
            + " skill_read(name). The bodies are deliberately not included"
            + " here."));
        if (arr.Count() == 0) {
            res.Put("hint", JsonValue.NewStr(
                "No skills found. They are <name>/SKILL.md directories under"
                + " the workspace's .agents/skills, or under the server's"
                + " --skills directory."));
        }
        return res.ToJson();
    }

    // IDE 工具链交互与状态驱动契约。
    static string SkillSummary(string md) {
        List<string> lines = File.ReadAllLines(md);
        int n = lines.Count;
        if (n > 40) { n = 40; }
        for (int i = 0; i < n; i = i + 1) {
            string l = McpServer.Trim(lines[i]);
            if (l.Length > 12 && l.Substring(0, 12) == "description:") {
                return McpServer.Trim(l.Substring(12, l.Length - 12));
            }
        }
        for (int i = 0; i < n; i = i + 1) {
            string l = McpServer.Trim(lines[i]);
            if (l == "" || l == "---") { continue; }
            if ((l[0] & 255) == 35) { continue; }
            if (l.Length > 200) { return l.Substring(0, 200); }
            return l;
        }
        return "";
    }

    static string SkillRead(JsonValue args) {
        string name = args.Str("name", "");
        if (name == "") { return "error: 'name' is required; call skills_list"; }
        if (McpServer.Find(name, "..") >= 0 || McpServer.Find(name, "/") >= 0
            || McpServer.Find(name, "\\") >= 0) {
            return "error: 'name' is a skill directory name, not a path";
        }
        string file = args.Str("file", "SKILL.md");
        if (file == "") { file = "SKILL.md"; }
        if (McpServer.Find(file, "..") >= 0 || McpServer.IsAbsolute(file)) {
            return "error: 'file' must stay inside the skill directory";
        }
        List<string> roots = McpServer.SkillRoots();
        for (int r = 0; r < roots.Count; r = r + 1) {
            string full = roots[r] + "/" + name + "/" + file;
            if (!File.Exists(full)) { continue; }
            JsonValue o = JsonValue.NewObject();
            o.Put("name", JsonValue.NewStr(name));
            o.Put("file", JsonValue.NewStr(file));
            o.Put("bytes", JsonValue.NewNum(
                Convert.ToString(McpServer.SizeOf(full))));
            o.Put("content", JsonValue.NewStr(File.ReadAllText(full)));
            return o.ToJson();
        }
        return "error: skill not found: " + name + "/" + file
            + "; call skills_list for the catalogue";
    }

    // IDE 工具链交互与状态驱动契约。
    // 核心契约与执行状态转移规范。
    static byte[] ReadSlice(string full, int offset, int limit) {
        int total = McpServer.SizeOf(full);
        if (offset < 0) { offset = 0; }
        int want = total - offset;
        if (limit > 0 && limit < want) { want = limit; }
        if (want > McpServer.maxRead) { want = McpServer.maxRead; }
        if (want <= 0) { return new byte[0]; }
        return File.ReadBytes(full, offset, want);
    }

    // IDE 工具链交互与状态驱动契约。
    // 核心契约与语义定义。
    static string WriteFile(string full, byte[] data, bool append) {
        McpServer.EnsureParent(full);
        try {
            if (append) { File.AppendAllBytes(full, data); }
            else { File.WriteAllBytes(full, data); }
        } catch (IOException e) {
            return e.Message;
        }
        return "";
    }

    static void EnsureParent(string full) {
        string dir = McpServer.ParentOf(full);
        if (dir == "") { return; }
        if (Directory.Exists(dir)) { return; }
        Directory.CreateDirectoryRecursive(dir);
    }

    static string ParentOf(string path) {
        int cut = 0 - 1;
        for (int i = 0; i < path.Length; i = i + 1) {
            int c = path[i] & 255;
            if (c == 47 || c == 92) { cut = i; }
        }
        if (cut <= 0) { return ""; }
        return path.Substring(0, cut);
    }

    // IDE 工具链交互与状态驱动契约。
    static int DeleteTree(string dir) {
        int n = 0;
        List<string> files = Directory.GetFiles(dir);
        for (int i = 0; i < files.Count; i = i + 1) {
            File.Delete(dir + "/" + files[i]);
            n = n + 1;
        }
        List<string> subs = Directory.GetDirectories(dir);
        for (int i = 0; i < subs.Count; i = i + 1) {
            n = n + McpServer.DeleteTree(dir + "/" + subs[i]);
        }
        Directory.Delete(dir);
        return n + 1;
    }

    // ---- find / search ------------------------------------------------------

    // IDE 工具链交互与状态驱动契约。
    // or contains `contains`.
    static string FindFiles(string rel, JsonValue args) {
        string glob = args.Str("glob", "");
        string contains = args.Str("contains", "");
        int limit = args.Int("max_results", 500);
        List<string> hits = new List<string>();
        McpServer.Walk(rel, McpServer.Resolve(rel), glob, contains, limit, hits, 0);
        JsonValue arr = JsonValue.NewArray();
        for (int i = 0; i < hits.Count; i = i + 1) {
            arr.Append(JsonValue.NewStr(hits[i]));
        }
        JsonValue o = JsonValue.NewObject();
        o.Put("path", JsonValue.NewStr(rel));
        o.Put("count", JsonValue.NewNum(Convert.ToString(hits.Count)));
        o.Put("truncated", JsonValue.NewBool(hits.Count >= limit));
        o.Put("files", arr);
        return o.ToJson();
    }

    static void Walk(string rel, string full, string glob, string contains,
                     int limit, List<string> hits, int depth) {
        if (hits.Count >= limit) { return; }
        if (depth > 32) { return; }
        if (!Directory.Exists(full)) { return; }
        List<string> files = Directory.GetFiles(full);
        for (int i = 0; i < files.Count; i = i + 1) {
            if (hits.Count >= limit) { return; }
            string name = files[i];
            bool hit = true;
            if (glob != "") { hit = McpServer.GlobMatch(glob, name); }
            if (hit && contains != "") {
                hit = McpServer.Find(name.ToLower(), contains.ToLower()) >= 0;
            }
            if (hit) { hits.Add(McpServer.JoinRel(rel, name)); }
        }
        List<string> dirs = Directory.GetDirectories(full);
        for (int i = 0; i < dirs.Count; i = i + 1) {
            string name = dirs[i];
            // IDE 工具链交互与状态驱动契约。
            if (name == ".git" || name == "node_modules" || name == "build"
                || name == "dist" || name == "__pycache__") {
                continue;
            }
            McpServer.Walk(McpServer.JoinRel(rel, name), full + "/" + name,
                glob, contains, limit, hits, depth + 1);
        }
    }

    static string JoinRel(string rel, string name) {
        if (rel == "" || rel == ".") { return name; }
        return rel + "/" + name;
    }

    // IDE 工具链交互与状态驱动契约。
    static bool GlobMatch(string pat, string text) {
        int p = 0;
        int t = 0;
        int star = 0 - 1;
        int mark = 0;
        while (t < text.Length) {
            if (p < pat.Length
                && ((pat[p] & 255) == 63 || (pat[p] & 255) == (text[t] & 255))) {
                p = p + 1;
                t = t + 1;
            } else if (p < pat.Length && (pat[p] & 255) == 42) {
                star = p;
                mark = t;
                p = p + 1;
            } else if (star >= 0) {
                p = star + 1;
                mark = mark + 1;
                t = mark;
            } else {
                return false;
            }
        }
        while (p < pat.Length && (pat[p] & 255) == 42) { p = p + 1; }
        return p == pat.Length;
    }

    // IDE 工具链交互与状态驱动契约。
    static string SearchText(string rel, JsonValue args) {
        string query = args.Str("query", "");
        if (query == "") { return "error: 'query' is required"; }
        string glob = args.Str("glob", "");
        int limit = args.Int("max_results", 200);
        bool fold = args.Bool("ignore_case", true);
        List<string> files = new List<string>();
        McpServer.Walk(rel, McpServer.Resolve(rel), glob, "", 20000, files, 0);
        string needle = query;
        if (fold) { needle = query.ToLower(); }
        JsonValue matches = JsonValue.NewArray();
        int scanned = 0;
        for (int i = 0; i < files.Count; i = i + 1) {
            if (matches.Count() >= limit) { break; }
            string full = McpServer.Resolve(files[i]);
            if (full == "") { continue; }
            if (McpServer.SizeOf(full) > 4194304) { continue; }
            // IDE 工具链交互与状态驱动契约。
            byte[] raw = McpServer.ReadSlice(full, 0, 0);
            if (!McpServer.Utf8Valid(raw, raw.Length)) { continue; }
            string body = raw.ToStr(0, raw.Length);
            scanned = scanned + 1;
            List<string> lines = Process.SplitLines(body);
            for (int k = 0; k < lines.Count; k = k + 1) {
                if (matches.Count() >= limit) { break; }
                string hay = lines[k];
                if (fold) { hay = hay.ToLower(); }
                if (McpServer.Find(hay, needle) < 0) { continue; }
                JsonValue m = JsonValue.NewObject();
                m.Put("file", JsonValue.NewStr(files[i]));
                m.Put("line", JsonValue.NewNum(Convert.ToString(k + 1)));
                m.Put("text", JsonValue.NewStr(McpServer.Clip(lines[k], 400)));
                matches.Append(m);
            }
        }
        JsonValue o = JsonValue.NewObject();
        o.Put("query", JsonValue.NewStr(query));
        o.Put("filesScanned", JsonValue.NewNum(Convert.ToString(scanned)));
        o.Put("count", JsonValue.NewNum(Convert.ToString(matches.Count())));
        o.Put("truncated", JsonValue.NewBool(matches.Count() >= limit));
        o.Put("matches", matches);
        return o.ToJson();
    }

    static string Clip(string s, int n) {
        if (s.Length <= n) { return s; }
        return s.Substring(0, n) + "...";
    }

    // ---- run_command --------------------------------------------------------

    // IDE 工具链交互与状态驱动契约。
    // 核心契约与语义定义。
    static async string RunCommand(JsonValue args) {
        if (!McpServer.CanExec()) {
            return "error: command execution is disabled on this server";
        }
        string cmd = args.Str("command", "");
        if (cmd == "") { return "error: 'command' is required"; }
        string cwd = McpServer.root;
        string cwdRel = args.Str("cwd", "");
        if (cwdRel != "") {
            cwd = McpServer.Resolve(cwdRel);
            if (cwd == "") { return McpServer.OutsideMsg(cwdRel); }
        }
        string shell = args.Str("shell", "");
        string full = McpServer.ShellWrap(shell, cmd, cwd);
        ProcessResult res = await McpServer.RunProcessAsync(full);
        StringBuilder sb = new StringBuilder();
        for (int i = 0; i < res.lines.Count; i = i + 1) {
            sb.Append(McpServer.StripAnsi(res.lines[i]));
            sb.Append("\n");
        }
        JsonValue o = JsonValue.NewObject();
        o.Put("ok", JsonValue.NewBool(res.exitCode == 0));
        o.Put("exitCode", JsonValue.NewNum(Convert.ToString(res.exitCode)));
        o.Put("command", JsonValue.NewStr(cmd));
        o.Put("cwd", JsonValue.NewStr(cwd));
        o.Put("stdout", JsonValue.NewStr(sb.ToString()));
        return o.ToJson();
    }

    // IDE 工具链交互与状态驱动契约。
    static string ShellWrap(string shell, string cmd, string cwd) {
        #if WINDOWS
        if (shell == "powershell" || shell == "pwsh") {
            return shell + " -NoProfile -NonInteractive -Command \"Set-Location -LiteralPath '"
                + cwd + "'; " + cmd + "\"";
        }
        return "cd /d \"" + cwd + "\" && " + cmd;
        #else
        string sh = shell;
        if (sh == "" || sh == "cmd" || sh == "powershell") { sh = "sh"; }
        return sh + " -c 'cd \"" + cwd + "\" && " + cmd + "'";
        #endif
    }

    // 核心契约与语义定义。
    // IDE 工具链交互与状态驱动契约。

    class PendingJob {
        int id;
        string cmd;
        bool started;
        bool done;
        ProcessResult result;
    }

    static List<PendingJob> jobs;
    static nint jobLock;
    static int jobSeq;

    static void InitJobs() {
        McpServer.jobs = new List<PendingJob>();
        McpServer.jobLock = Mutex.Create();
        McpServer.jobSeq = 0;
    }

    static async ProcessResult RunProcessAsync(string cmd) {
        PendingJob job = new PendingJob();
        McpServer.jobSeq = McpServer.jobSeq + 1;
        job.id = McpServer.jobSeq;
        job.cmd = cmd;
        job.started = false;
        job.done = false;
        job.result = null;
        Mutex.Lock(McpServer.jobLock);
        McpServer.jobs.Add(job);
        Mutex.Unlock(McpServer.jobLock);
        if (!Thread.Start(McpServer.ProcessWorker)) {
            // IDE 工具链交互与状态驱动契约。
            job.result = Process.Capture(job.cmd);
            job.done = true;
        }
        while (!job.done) { await Task.Delay(10); }
        Mutex.Lock(McpServer.jobLock);
        for (int i = 0; i < McpServer.jobs.Count; i = i + 1) {
            if (McpServer.jobs[i].id == job.id) {
                McpServer.jobs.RemoveAt(i);
                break;
            }
        }
        Mutex.Unlock(McpServer.jobLock);
        if (job.result == null) { job.result = new ProcessResult(); }
        if (job.result.lines == null) { job.result.lines = new List<string>(); }
        return job.result;
    }

    // IDE 工具链交互与状态驱动契约。
    static void ProcessWorker() {
        while (true) {
            PendingJob job = null;
            Mutex.Lock(McpServer.jobLock);
            for (int i = 0; i < McpServer.jobs.Count; i = i + 1) {
                if (!McpServer.jobs[i].started) {
                    McpServer.jobs[i].started = true;
                    job = McpServer.jobs[i];
                    break;
                }
            }
            Mutex.Unlock(McpServer.jobLock);
            if (job == null) { return; }
            job.result = Process.Capture(job.cmd);
            job.done = true;
        }
    }

    // 核心契约与执行状态转移规范。

    static string ApiSearch(string query, int limit) {
        if (query == "") { return "error: 'query' is required"; }
        if (!File.Exists(McpServer.indexPath)) {
            return "error: symbol index not found at " + McpServer.indexPath
                + "; generate it with: zanc tools/repomap/RepoMap.zan"
                + " --auto-stdlib -o repomap.exe && repomap.exe stdlib";
        }
        List<string> lines = File.ReadAllLines(McpServer.indexPath);
        List<JsonValue> cands = new List<JsonValue>();
        for (int i = 0; i < lines.Count; i = i + 1) {
            if (cands.Count >= McpServer.CandCap()) { break; }
            string line = lines[i];
            if (McpServer.Find(line, "\"name\"") < 0) { continue; }
            if (!McpServer.TokensMatch(line, query)) { continue; }
            string trimmed = line;
            if (trimmed.Length > 0
                && trimmed.Substring(trimmed.Length - 1, 1) == ",") {
                trimmed = trimmed.Substring(0, trimmed.Length - 1);
            }
            JsonValue rec = McpServer.ParseBody(trimmed);
            if (rec == null) { continue; }
            cands.Add(rec);
        }
        JsonValue results = McpServer.RankedTake(cands, limit);
        int found = results.Count();
        JsonValue o = JsonValue.NewObject();
        o.Put("query", JsonValue.NewStr(query));
        o.Put("count", JsonValue.NewNum(Convert.ToString(found)));
        o.Put("results", results);
        if (found == 0) {
            o.Put("hint", JsonValue.NewStr(
                "no match; try a shorter symbol fragment, e.g. 'Button'"));
        }
        return o.ToJson();
    }

    // IDE 工具链交互与状态驱动契约。
    static string LookupSymbol(string name, int limit) {
        if (name == "") { return "error: 'name' is required"; }
        if (!File.Exists(McpServer.indexPath)) { return McpServer.NoIndex(); }
        string lower = name.ToLower();
        string dotted = "." + lower;
        List<string> lines = File.ReadAllLines(McpServer.indexPath);
        List<JsonValue> exactRecs = new List<JsonValue>();
        List<JsonValue> memberRecs = new List<JsonValue>();
        for (int i = 0; i < lines.Count; i = i + 1) {
            if (exactRecs.Count + memberRecs.Count >= McpServer.CandCap()) { break; }
            // IDE 工具链交互与状态驱动契约。
            string full = McpServer.NameField(lines[i]);
            if (full == "") { continue; }
            bool isExact = full == lower;
            bool isMember = full.Length > dotted.Length
                && full.Substring(full.Length - dotted.Length, dotted.Length) == dotted;
            if (!isExact && !isMember) { continue; }
            JsonValue rec = McpServer.IndexRecord(lines[i]);
            if (rec == null) { continue; }
            if (isExact) { exactRecs.Add(rec); } else { memberRecs.Add(rec); }
        }
        JsonValue exact = McpServer.RankedTake(exactRecs, limit);
        JsonValue member = McpServer.RankedTake(memberRecs, limit);
        int found = exact.Count() + member.Count();
        JsonValue o = JsonValue.NewObject();
        o.Put("name", JsonValue.NewStr(name));
        o.Put("exact", exact);
        o.Put("members", member);
        o.Put("count", JsonValue.NewNum(Convert.ToString(found)));
        if (found == 0) {
            o.Put("hint", JsonValue.NewStr(
                "no exact match; try zan_api_search for fuzzy fragments"));
        }
        return o.ToJson();
    }

    // IDE 工具链交互与状态驱动契约。
    static string ListMembers(string type, string filter, int limit) {
        if (type == "") { return "error: 'type' is required"; }
        if (!File.Exists(McpServer.indexPath)) { return McpServer.NoIndex(); }
        string owner = type.ToLower();
        string prefix = owner + ".";
        string want = filter.ToLower();
        List<string> lines = File.ReadAllLines(McpServer.indexPath);
        List<JsonValue> declCands = new List<JsonValue>();
        List<JsonValue> memberCands = new List<JsonValue>();
        for (int i = 0; i < lines.Count; i = i + 1) {
            if (memberCands.Count >= McpServer.CandCap()) { break; }
            string lower = McpServer.NameField(lines[i]);
            if (lower == "") { continue; }
            bool isSelf = lower == owner;
            if (!isSelf) {
                if (lower.Length <= prefix.Length) { continue; }
                if (lower.Substring(0, prefix.Length) != prefix) { continue; }
                if (want != "" && McpServer.Find(lower, want) < 0) { continue; }
            }
            JsonValue rec = McpServer.IndexRecord(lines[i]);
            if (rec == null) { continue; }
            if (isSelf) { declCands.Add(rec); } else { memberCands.Add(rec); }
        }
        // IDE 工具链交互与状态驱动契约。
        JsonValue decls = McpServer.RankedTake(declCands, 1);
        bool haveDecl = decls.Count() > 0;
        JsonValue decl = JsonValue.NewObject();
        int best = McpServer.RANK_MAX();
        if (haveDecl) {
            decl = decls.At(0);
            best = McpServer.SourceRank(decl.Str("file", ""));
        } else {
            for (int i = 0; i < memberCands.Count; i = i + 1) {
                int r = McpServer.SourceRank(memberCands[i].Str("file", ""));
                if (r < best) { best = r; }
            }
        }
        JsonValue members = JsonValue.NewArray();
        int total = 0;
        for (int i = 0; i < memberCands.Count; i = i + 1) {
            JsonValue rec = memberCands[i];
            if (McpServer.SourceRank(rec.Str("file", "")) != best) { continue; }
            total = total + 1;
            if (members.Count() >= limit) { continue; }
            JsonValue row = JsonValue.NewObject();
            row.Put("name", JsonValue.NewStr(rec.Str("name", "")));
            row.Put("kind", JsonValue.NewStr(rec.Str("kind", "")));
            row.Put("sig", JsonValue.NewStr(rec.Str("sig", "")));
            row.Put("file", JsonValue.NewStr(rec.Str("file", "")));
            row.Put("line", JsonValue.NewNum(Convert.ToString(rec.Int("line", 0))));
            string doc = rec.Str("doc", "");
            if (doc != "") { row.Put("doc", JsonValue.NewStr(doc)); }
            members.Append(row);
        }
        JsonValue o = JsonValue.NewObject();
        o.Put("type", JsonValue.NewStr(type));
        if (haveDecl) { o.Put("declaration", decl); }
        o.Put("memberCount", JsonValue.NewNum(Convert.ToString(total)));
        o.Put("returned", JsonValue.NewNum(Convert.ToString(members.Count())));
        o.Put("members", members);
        if (total == 0) {
            o.Put("hint", JsonValue.NewStr(
                "unknown type; call zan_api_search to find the exact name"));
        } else if (members.Count() < total) {
            o.Put("hint", JsonValue.NewStr(
                "truncated; narrow with 'filter' or raise 'limit'"));
        }
        return o.ToJson();
    }

    // IDE 工具链交互与状态驱动契约。
    // // IDE 工具链交互与状态驱动契约。
    // IDE 工具链交互与状态驱动契约。
    // 核心契约与语义定义。
    static string FindRefs(string name, int limit) {
        if (name == "") { return "error: 'name' is required"; }
        if (!File.Exists(McpServer.refsPath)) {
            return "error: reference index not found at " + McpServer.refsPath
                + "; generate it with: zanc tools/repomap/RepoMap.zan"
                + " --auto-stdlib -o repomap.exe && repomap.exe .";
        }
        string simple = McpServer.AfterLastDot(name).ToLower();
        List<string> lines = File.ReadAllLines(McpServer.refsPath);
        for (int i = 0; i < lines.Count; i = i + 1) {
            if (McpServer.NameField(lines[i]) != simple) { continue; }
            JsonValue rec = McpServer.IndexRecord(lines[i]);
            if (rec == null) { continue; }
            JsonValue o = JsonValue.NewObject();
            o.Put("name", JsonValue.NewStr(rec.Str("name", "")));
            o.Put("kinds", rec.Get("kinds"));
            o.Put("owners", rec.Get("owners"));
            o.Put("defs", rec.Get("defs"));
            o.Put("defCount", JsonValue.NewNum(
                Convert.ToString(rec.Int("defCount", 0))));
            o.Put("refCount", JsonValue.NewNum(
                Convert.ToString(rec.Int("refCount", 0))));
            o.Put("testRefs", JsonValue.NewNum(
                Convert.ToString(rec.Int("testRefs", 0))));
            o.Put("refs", McpServer.HeadOf(rec.Get("refs"), limit));
            o.Put("subtypes", rec.Get("subtypes"));
            o.Put("evidence", JsonValue.NewStr(
                "text-level identifier matches minus declaration lines; not"
                + " overload-resolved. 'subtypes' comes from declared bases."));
            return o.ToJson();
        }
        JsonValue miss = JsonValue.NewObject();
        miss.Put("name", JsonValue.NewStr(name));
        miss.Put("refCount", JsonValue.NewNum("0"));
        miss.Put("hint", JsonValue.NewStr(
            "no indexed name matches; the index keys simple names"
            + " (\"ReadAllText\", not \"File.ReadAllText\")"));
        return miss.ToJson();
    }

    static string GameSimulateTrajectory(float gravity, float jumpVelocity, float airFriction, int frames) {
        if (frames <= 0) { frames = 60; }
        if (frames > 180) { frames = 180; }
        if (gravity <= 0.0f) { gravity = 980.0f; }
        if (jumpVelocity <= 0.0f) { jumpVelocity = 450.0f; }

        float dt = 1.0f / 60.0f;
        float y = 0.0f;
        float vy = 0.0f - jumpVelocity;
        float maxApex = 0.0f;
        int apexFrame = 0;
        int landFrame = 0;
        bool landed = false;

        StringBuilder sb = new StringBuilder();
        sb.Append("=== Trajectory Simulation ===\n");
        sb.Append("Params: Gravity=" + Convert.ToString(gravity) + " px/s^2, JumpVy=" + Convert.ToString(jumpVelocity) + " px/s, AirFriction=" + Convert.ToString(airFriction) + "\n\n");
        sb.Append("Frame |   Time(s) |  Height(px) |   Vy(px/s) | Event\n");
        sb.Append("------+-----------+-------------+------------+----------------\n");

        for (int f = 1; f <= frames; f = f + 1) {
            float prevVy = vy;
            vy = vy + gravity * dt;
            if (airFriction > 0.0f) {
                vy = vy * (1.0f - airFriction * dt);
            }
            y = y + vy * dt;

            float height = 0.0f - y;
            if (height > maxApex) {
                maxApex = height;
                apexFrame = f;
            }

            string evt = "";
            if (f == 1) { evt = "Jump Start"; }
            else if (prevVy < 0.0f && vy >= 0.0f) { evt = "Apex (Peak)"; }

            if (f > 1 && y >= 0.0f && !landed) {
                landed = true;
                landFrame = f;
                y = 0.0f;
                height = 0.0f;
                evt = "Touchdown";
            }

            if (f <= 25 || f == apexFrame || f == landFrame || f % 5 == 0 || (f <= landFrame + 3 && landed)) {
                sb.Append(Convert.ToString(f));
                sb.Append("     | ");
                sb.Append(Convert.ToString(f * dt));
                sb.Append("s   | ");
                sb.Append(Convert.ToString(height));
                sb.Append("px    | ");
                sb.Append(Convert.ToString(vy));
                sb.Append("px/s | ");
                sb.Append(evt);
                sb.Append("\n");
            }
        }

        sb.Append("\n--- Analysis & Feel Summary ---\n");
        sb.Append("Max Apex Height : " + Convert.ToString(maxApex) + " px\n");
        sb.Append("Time to Apex    : " + Convert.ToString(apexFrame * dt) + " s (" + Convert.ToString(apexFrame) + " frames)\n");
        if (landed) {
            sb.Append("Total Air Time  : " + Convert.ToString(landFrame * dt) + " s (" + Convert.ToString(landFrame) + " frames)\n");
        } else {
            sb.Append("Total Air Time  : > " + Convert.ToString(frames * dt) + " s (Did not land within frames)\n");
        }

        string style = "Balanced Platformer (Celeste / Mario-like)";
        if (apexFrame < 15 && maxApex < 120.0f) {
            style = "Snappy & Grounded (Hollow Knight / Megaman-like)";
        } else if (apexFrame > 28 || maxApex > 260.0f) {
            style = "Floaty / Lunar (Moon Gravity / Super Meat Boy float-hang)";
        }
        sb.Append("Game Feel Style : " + style + "\n");

        JsonValue res = JsonValue.NewObject();
        res.Put("ok", JsonValue.NewBool(true));
        res.Put("apex_height", JsonValue.NewNum(Convert.ToString(maxApex)));
        res.Put("apex_frame", JsonValue.NewNum(Convert.ToString(apexFrame)));
        res.Put("air_time_frames", JsonValue.NewNum(Convert.ToString(landFrame)));
        res.Put("style", JsonValue.NewStr(style));
        res.Put("report", JsonValue.NewStr(sb.ToString()));
        return res.ToJson();
    }

    static string GameFrameBudgetCheck(string file) {
        string full = file;
        if (!File.Exists(full)) {
            full = McpServer.root + "/" + file;
        }
        if (!File.Exists(full)) {
            return "error: source file not found: " + file;
        }

        string code = File.ReadAllText(full);
        List<string> warnings = new List<string>();
        int allocCount = 0;

        // IDE 工具链交互与状态驱动契约。
        int pos = 0;
        int lineNum = 1;
        bool inUpdate = false;

        List<string> lines = code.Split("\n");
        for (int i = 0; i < lines.Count; i = i + 1) {
            string l = lines[i];
            string trimmed = McpServer.Trim(l);

            if (McpServer.Find(l, "void Update(") >= 0 || McpServer.Find(l, "void OnUpdate(") >= 0
                || McpServer.Find(l, "void Tick(") >= 0 || McpServer.Find(l, "void Render(") >= 0
                || McpServer.Find(l, "void Draw(") >= 0) {
                inUpdate = true;
            }

            if (inUpdate) {
                if (McpServer.Find(trimmed, "new ") >= 0 && McpServer.Find(trimmed, "new List") >= 0) {
                    warnings.Add("Line " + Convert.ToString(i + 1) + ": [HOT-PATH ALLOC] 'new List' in frame loop. Pre-allocate or reuse instance.");
                    allocCount = allocCount + 1;
                } else if (McpServer.Find(trimmed, "new ") >= 0 && McpServer.Find(trimmed, "new ") != McpServer.Find(trimmed, "new Point") && McpServer.Find(trimmed, "new Rect") < 0) {
                    warnings.Add("Line " + Convert.ToString(i + 1) + ": [HOT-PATH ALLOC] Heap allocation 'new' detected in hot frame loop. Use ObjectPool<T>.");
                    allocCount = allocCount + 1;
                }

                if (McpServer.Find(trimmed, "GC.Collect(") >= 0) {
                    warnings.Add("Line " + Convert.ToString(i + 1) + ": [CRITICAL] GC.Collect() invoked in frame loop! Guaranteed frame hitch.");
                }

                if (trimmed == "}") {
                    // 核心契约与语义定义。
                    if (l.Length > 0 && l[0] == '}') {
                        inUpdate = false;
                    }
                }
            }
        }

        JsonValue res = JsonValue.NewObject();
        res.Put("file", JsonValue.NewStr(file));
        res.Put("budget_ms", JsonValue.NewNum("16.6"));
        res.Put("hot_path_allocations", JsonValue.NewNum(Convert.ToString(allocCount)));
        res.Put("pass", JsonValue.NewBool(allocCount == 0));

        JsonValue warnArr = JsonValue.NewArray();
        for (int w = 0; w < warnings.Count; w = w + 1) {
            warnArr.Append(JsonValue.NewStr(warnings[w]));
        }
        res.Put("diagnostics", warnArr);
        return res.ToJson();
    }

    // IDE 工具链交互与状态驱动契约。
    static JsonValue HeadOf(JsonValue arr, int limit) {
        JsonValue outp = JsonValue.NewArray();
        if (arr == null) { return outp; }
        for (int i = 0; i < arr.Count(); i = i + 1) {
            if (i >= limit) { break; }
            outp.Append(JsonValue.NewStr(arr.At(i).AsString("")));
        }
        return outp;
    }

    static string AfterLastDot(string s) {
        int cut = -1;
        for (int i = 0; i < s.Length; i = i + 1) {
            if (s.Substring(i, 1) == ".") { cut = i; }
        }
        if (cut < 0) { return s; }
        return s.Substring(cut + 1, s.Length - cut - 1);
    }

    // IDE 工具链交互与状态驱动契约。
    static string NameField(string line) {
        int key = McpServer.Find(line, "\"name\":\"");
        if (key < 0) { return ""; }
        int from = key + 8;
        int end = from;
        while (end < line.Length && (line[end] & 255) != 34) { end = end + 1; }
        if (end >= line.Length) { return ""; }
        return line.Substring(from, end - from).ToLower();
    }

    // IDE 工具链交互与状态驱动契约。
    static JsonValue IndexRecord(string line) {
        string t = line;
        if (McpServer.Find(t, "\"name\"") < 0) { return null; }
        if (t.Length > 0 && t.Substring(t.Length - 1, 1) == ",") {
            t = t.Substring(0, t.Length - 1);
        }
        return McpServer.ParseBody(t);
    }

    // IDE 工具链交互与状态驱动契约。
    // 核心契约与语义定义。
    static int SourceRank(string file) {
        if (McpServer.Starts(file, "stdlib/")) { return 0; }
        if (McpServer.Starts(file, "src/")) { return 0; }
        if (McpServer.Starts(file, "tools/")) { return 1; }
        if (McpServer.Starts(file, "templates/")) { return 2; }
        if (McpServer.Starts(file, "examples/")) { return 2; }
        if (McpServer.Starts(file, "tests/")) { return 3; }
        return 2;
    }

    static int RANK_MAX() { return 3; }

    // IDE 工具链交互与状态驱动契约。
    static int CandCap() { return 400; }

    static bool Starts(string s, string p) {
        if (s.Length < p.Length) { return false; }
        return s.Substring(0, p.Length) == p;
    }

    // IDE 工具链交互与状态驱动契约。
    // rank.
    static JsonValue RankedTake(List<JsonValue> recs, int limit) {
        JsonValue outp = JsonValue.NewArray();
        for (int r = 0; r <= McpServer.RANK_MAX(); r = r + 1) {
            for (int i = 0; i < recs.Count; i = i + 1) {
                if (outp.Count() >= limit) { return outp; }
                JsonValue rec = recs[i];
                if (McpServer.SourceRank(rec.Str("file", "")) != r) { continue; }
                outp.Append(rec);
            }
        }
        return outp;
    }

    static string NoIndex() {
        return "error: symbol index not found at " + McpServer.indexPath
            + "; generate it with: zanc tools/repomap/RepoMap.zan"
            + " --auto-stdlib -o repomap.exe && repomap.exe .";
    }

    // IDE 工具链交互与状态驱动契约。
    // record, case-insensitively.
    static bool TokensMatch(string line, string query) {
        string l = line.ToLower();
        string q = query.ToLower();
        int start = 0;
        int i = 0;
        while (i <= q.Length) {
            bool end = i == q.Length;
            bool space = false;
            if (!end) {
                int c = q[i] & 255;
                space = c == 32 || c == 9;
            }
            if (end || space) {
                if (i > start) {
                    if (McpServer.Find(l, q.Substring(start, i - start)) < 0) {
                        return false;
                    }
                }
                start = i + 1;
            }
            i = i + 1;
        }
        return true;
    }

    // 核心契约与语义定义。
    // IDE 工具链交互与状态驱动契约。

    static string IndexMissingMsg(string rel) {
        return "error: " + rel + " has not been generated for this workspace;"
            + " call zan_refresh_index (or compile with ZAN_INDEX_DIR=<root>"
            + "/.zanmap set) to build it";
    }

    // IDE 工具链交互与状态驱动契约。
    static bool FieldHas(JsonValue rec, string key, string needle) {
        return McpServer.Find(rec.Str(key, "").ToLower(), needle) >= 0;
    }

    // IDE 工具链交互与状态驱动契约。
    static string RouteLookup(JsonValue args) {
        if (!File.Exists(McpServer.routesIndexPath)) {
            return McpServer.IndexMissingMsg(".zanmap/routes.json");
        }
        JsonValue all = McpServer.ParseBody(
            File.ReadAllText(McpServer.routesIndexPath));
        if (all == null || !all.IsArray()) {
            return "error: .zanmap/routes.json is not a JSON array";
        }
        string q = args.Str("query", "").ToLower();
        string verb = args.Str("method", "").ToUpper();
        bool unmarked = args.Bool("unmarked_perm", false);
        int limit = args.Int("limit", 40);
        JsonValue hits = JsonValue.NewArray();
        int total = 0;
        for (int i = 0; i < all.Count(); i = i + 1) {
            JsonValue r = all.At(i);
            if (verb != "" && r.Str("method", "") != verb) { continue; }
            if (unmarked && r.Str("perm", "") != "") { continue; }
            if (q != "" && !McpServer.FieldHas(r, "path", q)
                && !McpServer.FieldHas(r, "action", q)
                && !McpServer.FieldHas(r, "controller", q)
                && !McpServer.FieldHas(r, "module", q)
                && !McpServer.FieldHas(r, "title", q)) {
                continue;
            }
            total = total + 1;
            if (hits.Count() < limit) { hits.Append(r); }
        }
        JsonValue o = JsonValue.NewObject();
        o.Put("routes", hits);
        o.Put("matched", JsonValue.NewNum(Convert.ToString(total)));
        o.Put("indexed", JsonValue.NewNum(Convert.ToString(all.Count())));
        o.Put("truncated", JsonValue.NewBool(total > hits.Count()));
        return o.ToJson();
    }

    // IDE 工具链交互与状态驱动契约。
    // 核心契约与语义定义。
    static string OrmLookup(JsonValue args) {
        if (!File.Exists(McpServer.entitiesIndexPath)) {
            return McpServer.IndexMissingMsg(".zanmap/entities.json");
        }
        JsonValue all = McpServer.ParseBody(
            File.ReadAllText(McpServer.entitiesIndexPath));
        if (all == null || !all.IsArray()) {
            return "error: .zanmap/entities.json is not a JSON array";
        }
        string q = args.Str("query", "").ToLower();
        string col = args.Str("column", "").ToLower();
        int limit = args.Int("limit", 10);
        JsonValue hits = JsonValue.NewArray();
        JsonValue names = JsonValue.NewArray();
        int total = 0;
        for (int i = 0; i < all.Count(); i = i + 1) {
            JsonValue e = all.At(i);
            names.Append(JsonValue.NewStr(e.Str("name", "")
                + " -> " + e.Str("table", "")));
            if (q != "" && !McpServer.FieldHas(e, "name", q)
                && !McpServer.FieldHas(e, "table", q)
                && !McpServer.FieldHas(e, "ns", q)) {
                continue;
            }
            if (col != "" && !McpServer.EntityHasColumn(e, col)) { continue; }
            total = total + 1;
            if (hits.Count() < limit) { hits.Append(e); }
        }
        JsonValue o = JsonValue.NewObject();
        // IDE 工具链交互与状态驱动契约。
        if (q == "" && col == "") {
            o.Put("entities", names);
            o.Put("usage", JsonValue.NewStr(
                "pass query=<entity|table> for the full column list, or"
                + " column=<name> to find which entities carry a column"));
            return o.ToJson();
        }
        o.Put("entities", hits);
        o.Put("matched", JsonValue.NewNum(Convert.ToString(total)));
        o.Put("indexed", JsonValue.NewNum(Convert.ToString(all.Count())));
        o.Put("truncated", JsonValue.NewBool(total > hits.Count()));
        return o.ToJson();
    }

    static bool EntityHasColumn(JsonValue e, string needle) {
        JsonValue cols = e.Get("columns");
        if (cols == null) { return false; }
        for (int i = 0; i < cols.Count(); i = i + 1) {
            JsonValue c = cols.At(i);
            if (McpServer.FieldHas(c, "column", needle)) { return true; }
            if (McpServer.FieldHas(c, "field", needle)) { return true; }
        }
        return false;
    }

    // IDE 工具链交互与状态驱动契约。
    static string ProjectOverview(int limit) {
        if (!File.Exists(McpServer.indexManifestPath)) {
            return McpServer.IndexMissingMsg(".zanmap/index.json");
        }
        JsonValue man = McpServer.ParseBody(
            File.ReadAllText(McpServer.indexManifestPath));
        JsonValue o = JsonValue.NewObject();
        o.Put("root", JsonValue.NewStr(McpServer.root));
        if (man != null) {
            o.Put("generatedBy", man.Get("generatedBy"));
            o.Put("sourceFiles", man.Get("sourceFiles"));
        }
        JsonValue routes = McpServer.IndexArray(McpServer.routesIndexPath);
        JsonValue ents = McpServer.IndexArray(McpServer.entitiesIndexPath);
        JsonValue mods = JsonValue.NewObject();
        JsonValue verbs = JsonValue.NewObject();
        JsonValue unmarked = JsonValue.NewArray();
        int unmarkedTotal = 0;
        for (int i = 0; i < routes.Count(); i = i + 1) {
            JsonValue r = routes.At(i);
            if (r == null) { continue; }
            McpServer.Bump(mods, r.Str("module", ""));
            McpServer.Bump(verbs, r.Str("method", ""));
            // IDE 工具链交互与状态驱动契约。
            // 核心契约与执行状态转移规范。
            if (r.Str("perm", "") == "" && r.Str("auth", "") == "Grant") {
                unmarkedTotal = unmarkedTotal + 1;
                if (unmarked.Count() < limit) {
                    unmarked.Append(JsonValue.NewStr(r.Str("action", "")));
                }
            }
        }
        JsonValue tables = JsonValue.NewArray();
        for (int i = 0; i < ents.Count(); i = i + 1) {
            JsonValue e = ents.At(i);
            if (e == null) { continue; }
            if (tables.Count() >= limit) { break; }
            tables.Append(JsonValue.NewStr(e.Str("name", "") + " -> "
                + e.Str("table", "")));
        }
        o.Put("routes", JsonValue.NewNum(Convert.ToString(routes.Count())));
        o.Put("routesByModule", mods);
        o.Put("routesByMethod", verbs);
        o.Put("entities", JsonValue.NewNum(Convert.ToString(ents.Count())));
        o.Put("tables", tables);
        // IDE 工具链交互与状态驱动契约。
        // 核心契约与执行状态转移规范。
        o.Put("authorizedWithoutPerm",
            JsonValue.NewNum(Convert.ToString(unmarkedTotal)));
        o.Put("authorizedWithoutPermSample", unmarked);
        o.Put("next", JsonValue.NewStr(
            "zan_route_lookup for an URL or action, zan_orm_lookup for an"
            + " entity's columns and facades, zan_change_impact before"
            + " editing a shared symbol, zan_read_context to see one"
            + " definition"));
        return o.ToJson();
    }

    // IDE 工具链交互与状态驱动契约。
    static JsonValue IndexArray(string path) {
        if (!File.Exists(path)) { return JsonValue.NewArray(); }
        JsonValue all = McpServer.ParseBody(File.ReadAllText(path));
        if (all == null || !all.IsArray()) { return JsonValue.NewArray(); }
        return all;
    }

    // IDE 工具链交互与状态驱动契约。
    static void Bump(JsonValue map, string key) {
        string k = key;
        if (k == "") { k = "(none)"; }
        int n = 0;
        if (map.Has(k)) {
            JsonValue cur = map.Get(k);
            if (cur != null) { n = cur.AsInt(0); }
        }
        map.Set(k, JsonValue.NewNum(Convert.ToString(n + 1)));
    }

    // IDE 工具链交互与状态驱动契约。
    // 核心契约与语义定义。
    // // IDE 工具链交互与状态驱动契约。
    // IDE 工具链交互与状态驱动契约。
    static string ChangeImpact(string name, int limit) {
        if (name == "") { return "error: 'symbol' is required"; }
        if (!File.Exists(McpServer.refsPath)) {
            return "error: reference index not found at " + McpServer.refsPath
                + "; generate it with: zanc tools/repomap/RepoMap.zan"
                + " --auto-stdlib -o repomap.exe && repomap.exe .";
        }
        string simple = McpServer.AfterLastDot(name).ToLower();
        List<string> lines = File.ReadAllLines(McpServer.refsPath);
        JsonValue rec = null;
        for (int i = 0; i < lines.Count; i = i + 1) {
            if (McpServer.NameField(lines[i]) != simple) { continue; }
            rec = McpServer.IndexRecord(lines[i]);
            if (rec != null) { break; }
        }
        JsonValue o = JsonValue.NewObject();
        o.Put("symbol", JsonValue.NewStr(name));
        if (rec == null) {
            o.Put("hint", JsonValue.NewStr(
                "no indexed name matches; the index keys simple names"
                + " (\"OpenRouterKey\", not \"Model.OpenRouterKey\")"));
            return o.ToJson();
        }
        JsonValue files = JsonValue.NewObject();
        McpServer.CountSites(files, rec.Get("defs"));
        McpServer.CountSites(files, rec.Get("refs"));
        o.Put("defs", rec.Get("defs"));
        o.Put("refCount", JsonValue.NewNum(
            Convert.ToString(rec.Int("refCount", 0))));
        o.Put("testRefs", JsonValue.NewNum(
            Convert.ToString(rec.Int("testRefs", 0))));
        o.Put("files", files);
        o.Put("subtypes", rec.Get("subtypes"));

        JsonValue routes = McpServer.IndexArray(McpServer.routesIndexPath);
        JsonValue hitRoutes = JsonValue.NewArray();
        int routeTotal = 0;
        for (int i = 0; i < routes.Count(); i = i + 1) {
            JsonValue r = routes.At(i);
            if (r == null || !files.Has(r.Str("file", ""))) { continue; }
            routeTotal = routeTotal + 1;
            if (hitRoutes.Count() >= limit) { continue; }
            JsonValue row = JsonValue.NewObject();
            row.Put("method", r.Get("method"));
            row.Put("path", r.Get("path"));
            row.Put("action", r.Get("action"));
            row.Put("perm", r.Get("perm"));
            hitRoutes.Append(row);
        }
        JsonValue ents = McpServer.IndexArray(McpServer.entitiesIndexPath);
        JsonValue hitEnts = JsonValue.NewArray();
        for (int i = 0; i < ents.Count(); i = i + 1) {
            JsonValue e = ents.At(i);
            if (e == null) { continue; }
            bool byFile = files.Has(e.Str("file", ""));
            bool byName = e.Str("name", "").ToLower() == simple;
            if (!byFile && !byName) { continue; }
            JsonValue row = JsonValue.NewObject();
            row.Put("name", e.Get("name"));
            row.Put("table", e.Get("table"));
            row.Put("file", e.Get("file"));
            hitEnts.Append(row);
        }
        o.Put("routes", hitRoutes);
        o.Put("routesAffected", JsonValue.NewNum(
            Convert.ToString(routeTotal)));
        o.Put("entities", hitEnts);
        o.Put("evidence", JsonValue.NewStr(
            "'files' and 'refCount' are text-level identifier matches (review"
            + " them); 'routes'/'entities' are exact, derived from the"
            + " compiler's unit metadata for the files that mention the name"));
        return o.ToJson();
    }

    // IDE 工具链交互与状态驱动契约。
    static void CountSites(JsonValue map, JsonValue arr) {
        if (arr == null || !arr.IsArray()) { return; }
        for (int i = 0; i < arr.Count(); i = i + 1) {
            string site = arr.At(i).AsString("");
            int cut = site.LastIndexOf(":");
            if (cut > 0) { site = site.Substring(0, cut); }
            if (site == "") { continue; }
            McpServer.Bump(map, site);
        }
    }

    // IDE 工具链交互与状态驱动契约。
    static string ReadContext(string name, int before, int lines) {
        if (name == "") { return "error: 'symbol' is required"; }
        if (!File.Exists(McpServer.indexPath)) { return McpServer.NoIndex(); }
        string lower = name.ToLower();
        string dotted = "." + lower;
        List<string> idx = File.ReadAllLines(McpServer.indexPath);
        List<JsonValue> cands = new List<JsonValue>();
        for (int i = 0; i < idx.Count; i = i + 1) {
            if (cands.Count >= McpServer.CandCap()) { break; }
            string full = McpServer.NameField(idx[i]);
            if (full == "") { continue; }
            bool exact = full == lower;
            bool member = full.Length > dotted.Length
                && full.Substring(full.Length - dotted.Length,
                                  dotted.Length) == dotted;
            if (!exact && !member) { continue; }
            JsonValue rec = McpServer.IndexRecord(idx[i]);
            if (rec != null) { cands.Add(rec); }
        }
        JsonValue best = McpServer.RankedTake(cands, 1);
        if (best.Count() == 0) {
            JsonValue miss = JsonValue.NewObject();
            miss.Put("symbol", JsonValue.NewStr(name));
            miss.Put("hint", JsonValue.NewStr(
                "no definition indexed for that name; try zan_api_search"));
            return miss.ToJson();
        }
        JsonValue def = best.At(0);
        string rel = def.Str("file", "");
        int line = def.Int("line", 0);
        string full2 = McpServer.Resolve(rel);
        if (rel == "" || full2 == "" || !File.Exists(full2)) {
            JsonValue miss = JsonValue.NewObject();
            miss.Put("symbol", JsonValue.NewStr(name));
            miss.Put("definition", def);
            miss.Put("hint", JsonValue.NewStr(
                "the definition lives outside this workspace ('" + rel
                + "'); the index record above is all this server can show"));
            return miss.ToJson();
        }
        int from = line - before;
        if (from < 1) { from = 1; }
        JsonValue args = JsonValue.NewObject();
        args.Put("from_line", JsonValue.NewNum(Convert.ToString(from)));
        args.Put("max_lines", JsonValue.NewNum(Convert.ToString(lines)));
        JsonValue win = McpServer.ParseBody(
            McpServer.ReadLinesDoc(rel, full2, args));
        JsonValue o = JsonValue.NewObject();
        o.Put("symbol", JsonValue.NewStr(name));
        o.Put("definition", def);
        if (win != null) {
            o.Put("from_line", win.Get("from_line"));
            o.Put("to_line", win.Get("to_line"));
            o.Put("fileLines", win.Get("lines"));
            o.Put("content", win.Get("content"));
        }
        return o.ToJson();
    }

    // IDE 工具链交互与状态驱动契约。

    static string CleanJsonStr(string s) {
        if (s.Length >= 2 && s.Substring(0, 1) == "\"" && s.Substring(s.Length - 1, 1) == "\"") {
            return s.Substring(1, s.Length - 2);
        }
        return s;
    }

    // IDE 工具链交互与状态驱动契约。

    static bool LoadCallGraph(Dictionary<string, JsonValue> byId, Dictionary<string, List<JsonValue>> byName) {
        if (!File.Exists(McpServer.callGraphPath)) { return false; }
        if (McpServer.callGraphPath.Length >= 6 && McpServer.callGraphPath.Substring(McpServer.callGraphPath.Length - 6, 6) == ".jsonl") {
            List<string> lines = File.ReadAllLines(McpServer.callGraphPath);
            for (int i = 0; i < lines.Count; i = i + 1) {
                string l = lines[i];
                if (l.Length == 0) { continue; }
                JsonValue n = McpServer.ParseBody(l);
                if (n == null) { continue; }
                string id = n.Str("id", "");
                string name = n.Str("name", "");
                byId[id] = n;
                if (!byName.ContainsKey(name)) { byName[name] = new List<JsonValue>(); }
                byName[name].Add(n);
            }
            return true;
        }
        string raw = File.ReadAllText(McpServer.callGraphPath);
        JsonValue doc = McpServer.ParseBody(raw);
        if (doc == null) { return false; }
        JsonValue nodes = doc.Get("nodes");
        if (nodes == null || !nodes.IsArray()) { return false; }
        for (int i = 0; i < nodes.Count(); i = i + 1) {
            JsonValue n = nodes.At(i);
            string id = n.Str("id", "");
            string name = n.Str("name", "");
            byId[id] = n;
            if (!byName.ContainsKey(name)) { byName[name] = new List<JsonValue>(); }
            byName[name].Add(n);
        }
        return true;
    }

    static string CallChain(string symbol, string direction, int maxDepth) {
        if (symbol == "") { return "error: 'symbol' is required (e.g. 'Program.Main' or 'CallTool')"; }
        if (!File.Exists(McpServer.callGraphPath)) {
            return "error: call graph not found at " + McpServer.callGraphPath
                + "; generate it with: repomap.exe .";
        }
        Dictionary<string, JsonValue> byId = new Dictionary<string, JsonValue>();
        Dictionary<string, List<JsonValue>> byName = new Dictionary<string, List<JsonValue>>();
        if (!McpServer.LoadCallGraph(byId, byName)) {
            return "error: failed to load call graph from " + McpServer.callGraphPath;
        }

        JsonValue rootNode = null;
        if (byId.ContainsKey(symbol)) {
            rootNode = byId[symbol];
        } else if (byName.ContainsKey(symbol)) {
            List<JsonValue> cands = byName[symbol];
            if (cands.Count == 1) {
                rootNode = cands[0];
            } else {
                StringBuilder candMsg = new StringBuilder();
                candMsg.Append("Ambiguous symbol '" + symbol + "', matches " + Convert.ToString(cands.Count) + " methods:\n");
                for (int c = 0; c < cands.Count && c < 8; c = c + 1) {
                    candMsg.Append("  - " + cands[c].Str("id", "") + " (" + cands[c].Str("file", "") + ":" + Convert.ToString(cands[c].Int("line", 0)) + ")\n");
                }
                candMsg.Append("Please specify full ID: ClassName.MethodName");
                return candMsg.ToString();
            }
        }

        if (rootNode == null) {
            return "Symbol '" + symbol + "' not found in project call graph.";
        }

        bool outgoing = (direction != "incoming");
        StringBuilder sb = new StringBuilder();
        sb.Append("[Call Hierarchy (" + (outgoing ? "outgoing / Callee Tree" : "incoming / Caller Tree") + ", maxDepth=" + Convert.ToString(maxDepth) + ")]\n");

        List<string> visited = new List<string>();
        McpServer.FormatCallTree(rootNode, byId, outgoing, 0, maxDepth, visited, sb);
        return sb.ToString();
    }

    static void FormatCallTree(JsonValue current, Dictionary<string, JsonValue> byId, bool outgoing, int depth, int maxDepth, List<string> visited, StringBuilder sb) {
        string indent = "";
        for (int i = 0; i < depth; i = i + 1) { indent = indent + "  "; }

        string id = current.Str("id", "");
        string file = current.Str("file", "");
        int line = current.Int("line", 0);
        string sig = current.Str("sig", "");

        sb.Append(indent);
        if (depth > 0) { sb.Append("├── "); }
        sb.Append(id);
        if (line > 0) {
            sb.Append(" [");
            sb.Append(file);
            sb.Append(":");
            sb.Append(Convert.ToString(line));
            sb.Append("]");
        }
        if (sig.Length > 0 && depth == 0) {
            sb.Append(" :: ");
            sb.Append(sig);
        }

        for (int v = 0; v < visited.Count; v = v + 1) {
            if (visited[v] == id) {
                sb.Append(" (recursion)\n");
                return;
            }
        }
        sb.Append("\n");

        if (depth >= maxDepth) { return; }

        visited.Add(id);

        JsonValue targets = outgoing ? current.Get("callees") : current.Get("callers");
        if (targets != null && targets.IsArray()) {
            for (int i = 0; i < targets.Count(); i = i + 1) {
                string targetId = McpServer.CleanJsonStr(targets.At(i).ToJson());
                if (byId.ContainsKey(targetId)) {
                    McpServer.FormatCallTree(byId[targetId], byId, outgoing, depth + 1, maxDepth, visited, sb);
                } else {
                    sb.Append(indent + "  ├── " + targetId + " (external/stdlib)\n");
                }
            }
        }

        visited.RemoveAt(visited.Count - 1);
    }

    static string TypeHierarchy(string typeName) {
        if (typeName == "") { return "error: 'type' is required"; }
        if (!File.Exists(McpServer.refsPath)) {
            return "error: refs.json not found at " + McpServer.refsPath;
        }
        List<string> lines = File.ReadAllLines(McpServer.refsPath);
        string simple = McpServer.AfterLastDot(typeName).ToLower();
        JsonValue targetRec = null;
        for (int i = 0; i < lines.Count; i = i + 1) {
            if (McpServer.NameField(lines[i]) == simple) {
                targetRec = McpServer.IndexRecord(lines[i]);
                if (targetRec != null) { break; }
            }
        }

        StringBuilder sb = new StringBuilder();
        sb.Append("=== [Type Hierarchy for '" + typeName + "'] ===\n");
        if (targetRec == null) {
            sb.Append("Type '" + typeName + "' not found in reference index.\n");
            return sb.ToString();
        }

        JsonValue defs = targetRec.Get("defs");
        if (defs != null && defs.IsArray() && defs.Count() > 0) {
            sb.Append("Declared at:\n");
            for (int d = 0; d < defs.Count(); d = d + 1) {
                sb.Append("  - " + defs.At(d).ToJson() + "\n");
            }
        }

        JsonValue subtypes = targetRec.Get("subtypes");
        if (subtypes != null && subtypes.IsArray() && subtypes.Count() > 0) {
            sb.Append("Derived Classes / Implementations (" + Convert.ToString(subtypes.Count()) + "):\n");
            for (int s = 0; s < subtypes.Count(); s = s + 1) {
                sb.Append("  ├── " + subtypes.At(s).ToJson() + "\n");
            }
        } else {
            sb.Append("No known derived classes or subtypes in this workspace.\n");
        }
        return sb.ToString();
    }

    static string BlastRadius(string symbol, int maxDepth) {
        if (symbol == "") { return "error: 'symbol' is required"; }
        if (!File.Exists(McpServer.callGraphPath)) {
            return "error: call graph not found at " + McpServer.callGraphPath;
        }
        Dictionary<string, JsonValue> byId = new Dictionary<string, JsonValue>();
        Dictionary<string, List<JsonValue>> byName = new Dictionary<string, List<JsonValue>>();
        if (!McpServer.LoadCallGraph(byId, byName)) {
            return "error: failed to load call graph from " + McpServer.callGraphPath;
        }

        JsonValue rootNode = null;
        if (byId.ContainsKey(symbol)) { rootNode = byId[symbol]; }
        else if (byName.ContainsKey(symbol)) {
            List<JsonValue> cands = byName[symbol];
            if (cands.Count == 1) { rootNode = cands[0]; }
        }

        if (rootNode == null) {
            return "Symbol '" + symbol + "' not found in call graph.";
        }

        string rootId = rootNode.Str("id", "");
        List<string> directCallers = new List<string>();
        List<string> indirectCallers = new List<string>();
        List<string> affectedFiles = new List<string>();
        List<string> queue = new List<string>();
        Dictionary<string, int> visited = new Dictionary<string, int>();

        visited[rootId] = 1;
        string rootFile = rootNode.Str("file", "");
        if (rootFile.Length > 0) { affectedFiles.Add(rootFile); }

        JsonValue callers = rootNode.Get("callers");
        if (callers != null && callers.IsArray()) {
            for (int i = 0; i < callers.Count(); i = i + 1) {
                string cid = McpServer.CleanJsonStr(callers.At(i).ToJson());
                directCallers.Add(cid);
                queue.Add(cid);
                visited[cid] = 1;
            }
        }

        int curDepth = 1;
        while (queue.Count > 0 && curDepth < maxDepth) {
            int qLen = queue.Count;
            for (int q = 0; q < qLen; q = q + 1) {
                string nextId = queue[0];
                queue.RemoveAt(0);
                if (byId.ContainsKey(nextId)) {
                    JsonValue n = byId[nextId];
                    string f = n.Str("file", "");
                    bool found = false;
                    for (int fi = 0; fi < affectedFiles.Count; fi = fi + 1) {
                        if (affectedFiles[fi] == f) { found = true; break; }
                    }
                    if (!found && f.Length > 0) { affectedFiles.Add(f); }

                    JsonValue upCallers = n.Get("callers");
                    if (upCallers != null && upCallers.IsArray()) {
                        for (int u = 0; u < upCallers.Count(); u = u + 1) {
                            string upId = McpServer.CleanJsonStr(upCallers.At(u).ToJson());
                            if (!visited.ContainsKey(upId)) {
                                visited[upId] = 1;
                                indirectCallers.Add(upId);
                                queue.Add(upId);
                            }
                        }
                    }
                }
            }
            curDepth = curDepth + 1;
        }

        StringBuilder sb = new StringBuilder();
        sb.Append("=== [Blast Radius / Impact Matrix for " + rootId + "] ===\n");
        sb.Append("Target: " + rootNode.Str("file", "") + ":" + Convert.ToString(rootNode.Int("line", 0)) + "\n");
        sb.Append("Direct Callers (" + Convert.ToString(directCallers.Count) + "):\n");
        for (int i = 0; i < directCallers.Count; i = i + 1) {
            sb.Append("  - " + directCallers[i]);
            if (byId.ContainsKey(directCallers[i])) {
                sb.Append(" (" + byId[directCallers[i]].Str("file", "") + ")");
            }
            sb.Append("\n");
        }
        sb.Append("Indirect Callers (" + Convert.ToString(indirectCallers.Count) + "):\n");
        for (int i = 0; i < indirectCallers.Count && i < 15; i = i + 1) {
            sb.Append("  - " + indirectCallers[i]);
            if (byId.ContainsKey(indirectCallers[i])) {
                sb.Append(" (" + byId[indirectCallers[i]].Str("file", "") + ")");
            }
            sb.Append("\n");
        }
        if (indirectCallers.Count > 15) {
            sb.Append("  ... and " + Convert.ToString(indirectCallers.Count - 15) + " more.\n");
        }

        sb.Append("Total Affected Files: " + Convert.ToString(affectedFiles.Count) + "\n");
        string risk = "Low";
        if (directCallers.Count > 10 || indirectCallers.Count > 25) { risk = "HIGH (Critical Hub Symbol)"; }
        else if (directCallers.Count > 3 || indirectCallers.Count > 8) { risk = "MEDIUM"; }
        sb.Append("Risk Rating: " + risk + "\n");
        return sb.ToString();
    }

    static string ArchCheck() {
        StringBuilder sb = new StringBuilder();
        sb.Append("=== [Zan Architecture & Rules Check (Rules as Code)] ===\n");
        int violations = 0;

        // 系统底层交互与数据流转契约
        string ideDir = McpServer.root + "/src/ide_zan";
        if (Directory.Exists(ideDir)) {
            List<string> ideFiles = new List<string>();
            McpServer.Walk("src/ide_zan", ideDir, "*.zan", "", 1000, ideFiles, 0);
            for (int i = 0; i < ideFiles.Count; i = i + 1) {
                string rel = ideFiles[i];
                string abs = McpServer.root + "/" + rel;
                string content = File.ReadAllText(abs);
                List<string> lines = File.ReadAllLines(abs);
                for (int l = 0; l < lines.Count; l = l + 1) {
                    string line = lines[l];
                    if (McpServer.Find(line, "DirectDraw(") >= 0 || McpServer.Find(line, "DrawText(") >= 0 || McpServer.Find(line, "FillRect(") >= 0) {
                        violations = violations + 1;
                        sb.Append("[FAIL - ArchRule-01: ZanIDE Custom Draw Forbidden]\n");
                        sb.Append("  File: " + rel + ":" + Convert.ToString(l + 1) + "\n");
                        sb.Append("  Code: " + line.Trim() + "\n");
                        sb.Append("  Constraint: ZanIDE must use standard library components (stdlib/Gui/Component/*), direct drawing is forbidden.\n");
                    }
                }
            }
        }

        // IDE 工具链交互与状态驱动契约。
        string ctrlDir = McpServer.root + "/src/Controller";
        if (Directory.Exists(ctrlDir)) {
            List<string> ctrlFiles = new List<string>();
            McpServer.Walk("src/Controller", ctrlDir, "*.zan", "", 1000, ctrlFiles, 0);
            for (int i = 0; i < ctrlFiles.Count; i = i + 1) {
                string rel = ctrlFiles[i];
                string abs = McpServer.root + "/" + rel;
                string content = File.ReadAllText(abs);
                if (McpServer.Find(content, "DllImport(") >= 0) {
                    violations = violations + 1;
                    sb.Append("[FAIL - ArchRule-02: Controller Native Leak]\n");
                    sb.Append("  File: " + rel + "\n");
                    sb.Append("  Constraint: Web Controllers must delegate through Service layer and never invoke Native DllImport directly.\n");
                }
            }
        }

        if (violations == 0) {
            sb.Append("All Architecture Rules PASSED (0 violations detected).\n");
        } else {
            sb.Append("Total Violations: " + Convert.ToString(violations) + ". Build gate BLOCKED.\n");
        }
        return sb.ToString();
    }

    static string GuiPreview(string srcPath, int delayMs, string outPath) {
        if (srcPath == "") { return "error: 'file' is required (e.g. 'examples/gui_gallery/App.zan')"; }
        string fullSrc = srcPath;
        if (!File.Exists(fullSrc) && File.Exists(McpServer.root + "/" + srcPath)) {
            fullSrc = McpServer.root + "/" + srcPath;
        }
        if (!File.Exists(fullSrc)) {
            return "error: source file not found: " + srcPath;
        }
        if (outPath == "") { outPath = "_scratch/gui_preview.png"; }
        if (delayMs <= 0) { delayMs = 800; }

        string exePath = "_scratch/gui_probe.exe";
        string zanc = McpServer.zancPath;
        if (!File.Exists(zanc)) { zanc = "build/zanc.exe"; }

        StringBuilder sb = new StringBuilder();
        sb.Append("=== [Zan GUI Visual Preview & Inspection Probe] ===\n");
        sb.Append("Target Source: " + srcPath + "\n");
        sb.Append("Output Image: " + outPath + "\n");
        sb.Append("Capture Command:\n");
        sb.Append("  powershell -ExecutionPolicy Bypass -File scripts/gui_capture.ps1 -exePath \"" + exePath + "\" -delayMs " + Convert.ToString(delayMs) + " -outPng \"" + outPath + "\"\n\n");
        sb.Append("--- [Design System / Visual Judge Checklist] ---\n");
        sb.Append("1. 8pt Grid Alignment: Are margins and paddings using Space.M (16px) or Space.L (24px)?\n");
        sb.Append("2. Typography Ladder: Clear hierarchy (Title 16pt -> Subhead 14pt -> Body 12pt)?\n");
        sb.Append("3. Control Height: Buttons/Inputs conforming to WidgetSize.Normal (32px) or Large (40px)?\n");
        sb.Append("4. Standard Components: Are UI elements using stdlib/Gui/Widget/* instead of custom OnPaint?\n");
        sb.Append("5. Color Semantics: Using Theme.Primary and Theme.Surface instead of hardcoded RGB?\n");
        return sb.ToString();
    }


    static async string RefreshIndex() {
        List<string> srcs = new List<string>();
        string scope = "src";
        if (!Directory.Exists(McpServer.root + "/src")) { scope = ""; }
        McpServer.Walk(scope, McpServer.Resolve(scope), "*.zan", "",
                       20000, srcs, 0);
        JsonValue o = JsonValue.NewObject();
        if (srcs.Count == 0) {
            o.Put("ok", JsonValue.NewBool(false));
            o.Put("error", JsonValue.NewStr(
                "no .zan sources found under " + McpServer.root));
            return o.ToJson();
        }
        Directory.CreateDirectoryRecursive(McpServer.root + "/_scratch");
        // IDE 工具链交互与状态驱动契约。
        string listPath = McpServer.root + "/_scratch/mcp_index_sources.txt";
        StringBuilder list = new StringBuilder();
        for (int i = 0; i < srcs.Count; i = i + 1) {
            list.Append(McpServer.root + "/" + srcs[i]);
            list.Append("\n");
        }
        File.WriteAllText(listPath, list.ToString());
        string metaPath = McpServer.root + "/_scratch/mcp_index_meta.json";
        ProcessResult res = await McpServer.RunProcessAsync(
            "\"" + McpServer.zancPath + "\" \"@" + listPath
            + "\" --stdlib-path \"" + McpServer.stdlibPath
            + "\" --gen-meta \"" + metaPath + "\"");
        if (!File.Exists(metaPath)) {
            o.Put("ok", JsonValue.NewBool(false));
            o.Put("error", JsonValue.NewStr(
                "zanc --gen-meta produced no metadata"));
            o.Put("compiler", McpServer.ParseBody(McpServer.DiagResult(res)));
            return o.ToJson();
        }
        JsonValue unit = McpServer.ParseBody(File.ReadAllText(metaPath));
        if (unit == null) {
            o.Put("ok", JsonValue.NewBool(false));
            o.Put("error", JsonValue.NewStr("metadata is not valid JSON"));
            return o.ToJson();
        }
        // 元数据用绝对路径喂的编译器,索引对外只给工作区相对路径。
        GenIndex.Base = McpServer.root;
        int routes = GenIndex.WriteTo(unit, McpServer.root + "/.zanmap");
        JsonValue man = McpServer.ParseBody(
            File.ReadAllText(McpServer.indexManifestPath));
        o.Put("ok", JsonValue.NewBool(true));
        o.Put("sources", JsonValue.NewNum(Convert.ToString(srcs.Count)));
        o.Put("routes", JsonValue.NewNum(Convert.ToString(routes)));
        if (man != null) { o.Put("entities", man.Get("entities")); }
        JsonValue arte = JsonValue.NewArray();
        arte.Append(JsonValue.NewStr(".zanmap/routes.json"));
        arte.Append(JsonValue.NewStr(".zanmap/entities.json"));
        arte.Append(JsonValue.NewStr(".zanmap/index.json"));
        o.Put("artefacts", arte);
        o.Put("note", JsonValue.NewStr(
            "symbols.json/refs.json/repo.map.txt come from"
            + " tools/repomap/RepoMap.zan and are not touched here"));
        return o.ToJson();
    }

    static string Example(string topic) {
        if (!File.Exists(McpServer.galleryPath)) {
            return "error: gallery.json not found at " + McpServer.galleryPath;
        }
        JsonValue man = McpServer.ParseBody(File.ReadAllText(McpServer.galleryPath));
        if (man == null) { return "error: gallery.json is not valid JSON"; }
        JsonValue entries = man.Get("entries");
        if (entries == null) { return "error: gallery.json has no 'entries'"; }
        if (topic == "") {
            JsonValue list = JsonValue.NewArray();
            for (int i = 0; i < entries.Count(); i = i + 1) {
                JsonValue e = entries.At(i);
                JsonValue row = JsonValue.NewObject();
                row.Put("topic", JsonValue.NewStr(e.Str("topic", "")));
                row.Put("kind", JsonValue.NewStr(e.Str("kind", "")));
                row.Put("summary", JsonValue.NewStr(e.Str("summary", "")));
                list.Append(row);
            }
            JsonValue o = JsonValue.NewObject();
            o.Put("topics", list);
            o.Put("usage", JsonValue.NewStr(
                "call zan_example with one of these 'topic' values to get the files"));
            return o.ToJson();
        }
        JsonValue match = McpServer.MatchEntry(entries, topic);
        if (match == null) {
            return "error: no example for topic '" + topic
                + "'; call zan_example with no topic to list the catalog";
        }
        string kind = match.Str("kind", "");
        JsonValue o = JsonValue.NewObject();
        o.Put("topic", JsonValue.NewStr(match.Str("topic", "")));
        o.Put("kind", JsonValue.NewStr(kind));
        o.Put("summary", JsonValue.NewStr(match.Str("summary", "")));
        o.Put("build", JsonValue.NewStr(match.Str("build", "")));
        JsonValue models = man.Get("models");
        if (models != null && models.Has(kind)) { o.Put("model", models.Get(kind)); }
        JsonValue files = match.Get("files");
        JsonValue outFiles = JsonValue.NewArray();
        if (files != null) {
            for (int i = 0; i < files.Count(); i = i + 1) {
                string rel = files.At(i).AsString("");
                JsonValue fo = JsonValue.NewObject();
                fo.Put("path", JsonValue.NewStr(rel));
                string full = McpServer.TrimTrailingSep(Environment.ExeDir())
                    + "/" + rel;
                if (!File.Exists(full)) { full = McpServer.root + "/" + rel; }
                if (File.Exists(full)) {
                    fo.Put("content", JsonValue.NewStr(File.ReadAllText(full)));
                } else {
                    fo.Put("error", JsonValue.NewStr("file missing on server"));
                }
                outFiles.Append(fo);
            }
        }
        o.Put("files", outFiles);
        return o.ToJson();
    }

    static string FormSchema(string control) {
        if (!File.Exists(McpServer.formSchemaPath)) {
            return "error: controls.json not found at " + McpServer.formSchemaPath;
        }
        JsonValue schema = McpServer.ParseBody(
            File.ReadAllText(McpServer.formSchemaPath));
        if (schema == null) { return "error: controls.json is not valid JSON"; }
        JsonValue controls = schema.Get("controls");
        if (controls == null || !controls.IsArray()) {
            return "error: controls.json has no 'controls'";
        }
        JsonValue out0 = JsonValue.NewObject();
        if (control == "") {
            out0.Put("document", schema.Get("document"));
            out0.Put("fields", schema.Get("fields"));
            out0.Put("commonEvents", schema.Get("commonEvents"));
            JsonValue names = JsonValue.NewArray();
            for (int i = 0; i < controls.Count(); i = i + 1) {
                names.Append(JsonValue.NewStr(controls.At(i).Str("name", "")));
            }
            out0.Put("controls", names);
            return out0.ToJson();
        }
        JsonValue match = null;
        for (int i = 0; i < controls.Count(); i = i + 1) {
            if (controls.At(i).Str("name", "") == control) {
                match = controls.At(i);
                break;
            }
        }
        if (match == null) {
            for (int i = 0; i < controls.Count(); i = i + 1) {
                if (McpServer.Find(controls.At(i).Str("name", ""), control) >= 0) {
                    match = controls.At(i);
                    break;
                }
            }
        }
        if (match == null) {
            return "error: no form control matching '" + control + "'";
        }
        out0.Put("control", match);
        return out0.ToJson();
    }

    static JsonValue MatchEntry(JsonValue entries, string topic) {
        for (int i = 0; i < entries.Count(); i = i + 1) {
            if (entries.At(i).Str("topic", "") == topic) { return entries.At(i); }
        }
        for (int i = 0; i < entries.Count(); i = i + 1) {
            if (McpServer.Find(entries.At(i).Str("topic", ""), topic) >= 0) {
                return entries.At(i);
            }
        }
        return null;
    }

    static async string Compile(string filename, string content) {
        if (filename == "") { filename = "snippet.zan"; }
        if (!McpServer.IsBareName(filename)) {
            return "error: filename must be a bare file name with no path separators";
        }
        McpServer.compileSeq = McpServer.compileSeq + 1;
        string dir = McpServer.workRoot + "/" + Convert.ToString(McpServer.compileSeq);
        Directory.CreateDirectoryRecursive(dir);
        File.WriteAllText(dir + "/" + filename, content);
        ProcessResult res = await McpServer.RunProcessAsync(
            "\"" + McpServer.zancPath + "\" \"" + dir + "/" + filename
            + "\" --stdlib-path \"" + McpServer.stdlibPath + "\" -o \""
            + dir + "/out" + McpServer.ExeSuffix() + "\"");
        return McpServer.DiagResult(res);
    }

    static async string BuildProject(string entry) {
        if (entry == "") {
            if (File.Exists(McpServer.root + "/src/App.zan")) { entry = "src/App.zan"; }
            else { entry = "src/main.zan"; }
        }
        string full = McpServer.Resolve(entry);
        if (full == "") { return McpServer.OutsideMsg(entry); }
        if (!File.Exists(full)) { return "error: entry not found: " + entry; }
        Directory.CreateDirectoryRecursive(McpServer.root + "/_scratch");
        string outPath = McpServer.root + "/_scratch/mcp_project_out"
            + McpServer.ExeSuffix();
        ProcessResult res = await McpServer.RunProcessAsync(
            "\"" + McpServer.zancPath + "\" \"" + full
            + "\" --stdlib-path \"" + McpServer.stdlibPath + "\" -o \""
            + outPath + "\"");
        return McpServer.DiagResult(res);
    }

    // IDE 工具链交互与状态驱动契约。
    static string DiagResult(ProcessResult res) {
        JsonValue diags = JsonValue.NewArray();
        StringBuilder rawSb = new StringBuilder();
        for (int i = 0; i < res.lines.Count; i = i + 1) {
            string line = McpServer.StripAnsi(res.lines[i]);
            rawSb.Append(line);
            rawSb.Append("\n");
            string sev = "";
            int pos = McpServer.Find(line, " error:");
            if (pos >= 0) { sev = "error"; }
            if (sev == "") {
                pos = McpServer.Find(line, " warning:");
                if (pos >= 0) { sev = "warning"; }
            }
            if (sev == "") {
                pos = McpServer.Find(line, " note:");
                if (pos >= 0) { sev = "note"; }
            }
            if (sev == "") { continue; }
            string loc = line.Substring(0, pos);
            if (loc.Length > 0 && loc.Substring(loc.Length - 1, 1) == ":") {
                loc = loc.Substring(0, loc.Length - 1);
            }
            int markerLen = sev.Length + 2;
            string msg = line.Substring(pos + markerLen, line.Length - pos - markerLen);
            JsonValue d = JsonValue.NewObject();
            d.Put("severity", JsonValue.NewStr(sev));
            d.Put("location", JsonValue.NewStr(loc));
            McpServer.PeelLineCol(loc, d);
            d.Put("message", JsonValue.NewStr(McpServer.Trim(msg)));
            diags.Append(d);
        }
        JsonValue o = JsonValue.NewObject();
        o.Put("ok", JsonValue.NewBool(res.exitCode == 0));
        o.Put("exitCode", JsonValue.NewNum(Convert.ToString(res.exitCode)));
        o.Put("diagnostics", diags);
        o.Put("raw", JsonValue.NewStr(rawSb.ToString()));
        return o.ToJson();
    }

    static void PeelLineCol(string loc, JsonValue d) {
        int c2 = McpServer.LastColon(loc);
        if (c2 < 0) { return; }
        string colStr = loc.Substring(c2 + 1, loc.Length - c2 - 1);
        string head = loc.Substring(0, c2);
        int c1 = McpServer.LastColon(head);
        if (c1 < 0) { return; }
        string lineStr = head.Substring(c1 + 1, head.Length - c1 - 1);
        if (McpServer.AllDigits(colStr) && McpServer.AllDigits(lineStr)) {
            d.Put("file", JsonValue.NewStr(head.Substring(0, c1)));
            d.Put("line", JsonValue.NewNum(lineStr));
            d.Put("col", JsonValue.NewNum(colStr));
        }
    }

    static int LastColon(string s) {
        for (int i = s.Length - 1; i >= 0; i = i - 1) {
            if ((s[i] & 255) == 58) { return i; }
        }
        return 0 - 1;
    }

    static bool IsBareName(string s) {
        if (s == "") { return false; }
        for (int i = 0; i < s.Length; i = i + 1) {
            int c = s[i] & 255;
            if (c == 47 || c == 92) { return false; }
        }
        for (int i = 0; i + 1 < s.Length; i = i + 1) {
            if (s.Substring(i, 2) == "..") { return false; }
        }
        return true;
    }

    // 核心契约与执行状态转移规范。

    static JsonValue ToolsDoc() {
        JsonValue arr = JsonValue.NewArray();

        // IDE 工具链交互与状态驱动契约。
        // 核心契约与语义定义。
        JsonValue t = McpServer.NewTool("zan_start_here",
            "START HERE. Everything you need to work in this project in one"
            + " call: layout and entry point, build/run/test commands, the Zan"
            + " coding rules, the tool catalog with what to use each tool for,"
            + " and the available resources. Costs one round trip and replaces"
            + " browsing the tree.");
        arr.Append(t);

        t = McpServer.NewTool("health_check",
            "Liveness and configuration of this server: workspace root,"
            + " read-only/exec flags, protocol version, platform.");
        arr.Append(t);

        t = McpServer.NewTool("list_dir",
            "List one directory of the workspace. Returns"
            + " {type,path,count,entries:[{name,type,size}]}.");
        McpServer.AddParam(t, "path", "string",
            "Workspace-relative directory ('' or '.' for the root).", false);
        arr.Append(t);

        t = McpServer.NewTool("read_file",
            "Read a workspace file -- ideally ONE window of it. Pass"
            + " from_line/max_lines (numbered output) to read just the"
            + " neighbourhood of a search_text hit; that is the cheap read and"
            + " it gives you the line numbers to cite and to edit by. Reading"
            + " the whole file, or the same lines twice, buys nothing: what a"
            + " tool result already told you in this conversation is still"
            + " true unless you changed it. Text comes back in 'content',"
            + " binary (or encoding='base64') in 'content_base64'.");
        McpServer.AddParam(t, "path", "string", "Workspace-relative file.", true);
        McpServer.AddParam(t, "from_line", "integer",
            "First line (1-based). Preferred over offset for source code.", false);
        McpServer.AddParam(t, "max_lines", "integer",
            "Lines to return (default 120).", false);
        McpServer.AddParam(t, "numbered", "boolean",
            "Prefix each line with its number (default true).", false);
        McpServer.AddParam(t, "offset", "integer", "First byte to read.", false);
        McpServer.AddParam(t, "limit", "integer", "Maximum bytes to read.", false);
        McpServer.AddParam(t, "encoding", "string",
            "'text' (default when the bytes are valid UTF-8) or 'base64'.", false);
        arr.Append(t);

        t = McpServer.NewTool("write_file",
            "Create or overwrite a workspace file, byte for byte. Parent"
            + " directories are created. Pass content_base64 for binary data"
            + " and append=true to add to the end.");
        McpServer.AddParam(t, "path", "string", "Workspace-relative file.", true);
        McpServer.AddParam(t, "content", "string", "UTF-8 text to write.", false);
        McpServer.AddParam(t, "content_base64", "string", "Base64 bytes to write.", false);
        McpServer.AddParam(t, "append", "boolean", "Append instead of replacing.", false);
        arr.Append(t);

        t = McpServer.NewTool("edit_file",
            "Change a file in place by replacing an exact snippet. This is the"
