using Gui;
using Gui.Widget;

namespace Tools.GameAsset;

// Clip and editor bounds can differ when embedded. The content is arranged by
// PrepareView at its host rectangle; this standard Panel owns the shared clip.
class GameAssetViewport : Panel {
    int contentX; int contentY; int contentWidth; int contentHeight;
    public GameAssetViewport() { this.SetProp("style", "overflow:hidden;"); }
    public void SetContentBounds(int x, int y, int width, int height) {
        contentX = x; contentY = y; contentWidth = width; contentHeight = height;
    }
    public override void Arrange(int x, int y, int width, int height) {
        bx = x; by = y; bw = width; bh = height;
        if (Children.Count > 0) { Children[0].Arrange(contentX, contentY, contentWidth, contentHeight); }
    }
}
