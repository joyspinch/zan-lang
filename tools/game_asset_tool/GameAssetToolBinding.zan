using Gui;

namespace Tools.GameAsset;

class GameAssetToolBinding {
    public UiEvent Event;
    public weak Control Sender;
    public string Name;
    public GameAssetToolAction Endpoint;
    public UiViewActions Action;

    public void Wire(GameAssetToolView owner, int epoch) {
        if (Endpoint != null) { Event.Remove(Endpoint.Run); }
        GameAssetToolAction next = new GameAssetToolAction();
        if (Action == null) { Action = owner.Scope().Action(Name, Sender); }
        next.Owner = owner; next.Sender = Sender; next.Name = Name; next.Epoch = epoch; next.Action = Action;
        Endpoint = next;
        Event.Add(next.Run);
    }
}
