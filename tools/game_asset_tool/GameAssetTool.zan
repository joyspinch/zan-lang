using Gui;

namespace Tools.GameAsset;

// Production entry. The view installs its scope and borrowed input host before
// Show/ProcessEvent; preparing and painting always use the same retained tree.
class GameAssetTool {
    static void Main() {
        App app = App.CreateDark("GameAssetTool · 游戏素材管理工作台", 1280, 800);
        GameAssetToolView view = new GameAssetToolView(app);
        app.Show();
        while (app.isRunning) {
            if (!app.ProcessEvent()) { break; }
            app.BeginFrame();
            if (!app.PrepareStandardHostFrame() || !app.ContinuePreparedFrame()) { continue; }
            view.Render(app);
            if (!app.ContinuePreparedFrame()) { continue; }
            app.RenderChrome("GameAssetTool · 游戏素材管理工作台");
            if (!app.ContinuePreparedFrame()) { continue; }
            app.PresentFrame();
        }
        view.Retire();
        app.SetRootControl(null);
    }
}
