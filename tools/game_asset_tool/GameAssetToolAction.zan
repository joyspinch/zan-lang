using Gui;

namespace Tools.GameAsset;

// Queued subscriptions borrow the view and the control. A new visible session
// replaces these endpoints, so late work cannot act on a returned/rebound page.
class GameAssetToolAction {
    public weak GameAssetToolView Owner;
    public weak Control Sender;
    public string Name;
    public int Epoch;
    public UiViewActions Action;

    public void Run() {
        GameAssetToolView current = Owner;
        Control source = Sender;
        if (current != null && source != null && current.ActionCurrent(Epoch, source)) {
            if (Action != null) { Action.Run(); }
        }
    }
}
