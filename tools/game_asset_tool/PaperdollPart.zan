using System;

class PaperdollPart {
    public string id;
    public string name;
    public int color;
    public int[] depthPerDir; // 8 个方向的深度偏移（-50 ~ +50）

    public PaperdollPart(string id, string name, int color, int[] depths) {
        this.id = id;
        this.name = name;
        this.color = color;
        this.depthPerDir = depths;
    }
}

// 游戏素材管理主工具类。
