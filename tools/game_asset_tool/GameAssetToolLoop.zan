using Gui;

namespace Tools.GameAsset;

class GameAssetToolLoop : AppLoopParticipant, AppLoopStopped {
    public weak GameAssetToolView Owner;
    public void Tick(App app, int now) {
        GameAssetToolView current = Owner;
        if (current != null) { current.Advance(app, now); }
    }
    public int NextDeadline() {
        GameAssetToolView current = Owner;
        return current != null ? current.NextDeadline() : -1;
    }
    public void Stopped(App app) {
        GameAssetToolView current = Owner;
        if (current != null) { current.Stopped(app); }
    }
}
