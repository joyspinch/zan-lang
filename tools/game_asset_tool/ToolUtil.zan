using System;
using System.IO;

class ToolUtil {
    public static string FromInt(int v) { return Convert.ToString(v); }

    public static int ToInt(string s, int dflt) {
        if (s == null || s.Length == 0) { return dflt; }
        StringBuilder sb = new StringBuilder();
        int i = 0;
        bool negative = false;
        if (s.StartsWith("-")) {
            negative = true;
            i = 1;
        }
        while (i < s.Length) {
            char c = s[i];
            if (c >= '0' && c <= '9') {
                sb.Append(c);
            }
            i = i + 1;
        }
        string digits = sb.ToString();
        if (digits.Length == 0) { return dflt; }
        int val = Convert.ToInt(digits);
        return negative ? -val : val;
    }
}

