using System;
using System.IO;
using System.Security.Cryptography;

// PackScript -- 把 Lua 脚本加密打包为可编译的 .zan 常量文件。
//
// 与 tools/packtool（.zrp 资源包）同一保护模型：AES-256-GCM 加密，
// 密钥经 HKDF-SHA256 从种子派生、运行期才组装，密文与种子以 Base64/
// hex 常量进 exe——脚本源码与密钥都不以可读文本出现在二进制里，
// 明文 chunk 只在内存中存活一瞬（LoadBytes 加载后立即清零缓冲）。
//
//   Build: zanc tools/pack_script.zan --auto-stdlib -o build/pack_script.exe
//   Pack : pack_script.exe <in.lua|.luac> <out.zan> <ChunkName> [keySeed]
//
// in.lua 建议先 luac -s 编成字节码（去行号表/局部名，反编译门槛更高；
// 字节码与运行时 5.4.x 主次版本绑定）。chunk 名同时是 AES-GCM 的 AAD。
//
// !! 语言坑（同 tools/packtool 头注释）：byte[] → string 是零拷贝别名，
// 本工具全部通过显式长度参数当场用掉，不把 byte[] 存进跨分配的字段。


class PackScript {
    [DllImport("crt")]
    static extern void exit(int code);

    // AES-GCM takes binary key/IV material through string (char buffer with
    // explicit length); stage bytes through an unmanaged scratch buffer so
    // NUL bytes in key/IV/ciphertext survive the round trip.
    static string BytesToText(byte[] b, int off, int len) {
        nint p = NativeMemory.Alloc(len);
        int i = 0;
        while (i < len) {
            NativeMemory.Fill(p + i, b[off + i] & 255, 1);
            i = i + 1;
        }
        string s = NativeMemory.GetString(p, 0, len);
        NativeMemory.Fill(p, 0, len);
        NativeMemory.Free(p);
        return s;
    }

    static int Main() {
        if (Environment.ArgCount() < 3) {
            Console.WriteLine("usage: pack_script <in.lua|.luac> <out.zan> <ChunkName> [keySeed]");
            return 2;
        }
        string inPath = Environment.ArgAt(0);
        string outPath = Environment.ArgAt(1);
        string chunkName = Environment.ArgAt(2);
        string seed = Environment.ArgCount() > 3
            ? Environment.ArgAt(3) : "zan-default-pack-seed";

        byte[] data = File.ReadAllBytes(inPath);
        if (data.Length == 0) {
            Console.WriteLine("error: empty input: " + inPath);
            exit(1);
        }
        string dataText = BytesToText(data, 0, data.Length);

        // 32-byte key = HKDF-SHA256(seed); 96-bit random IV.
        byte[] keyB = Hkdf.Derive("zan-lua-pack-v1", 14, seed, seed.Length,
                                  "lua-chunk-key", 13, 32);
        string key = BytesToText(keyB, 0, 32);
        byte[] ivB = RandomNumberGenerator.GetBytes(12);
        string iv = BytesToText(ivB, 0, 12);

        byte[] tag = new byte[16];
        byte[] ct = AesGcm.Encrypt(key, 32, iv, chunkName, chunkName.Length,
                                   dataText, data.Length, tag);
        if (ct == null) {
            Console.WriteLine("error: AesGcm.Encrypt failed");
            exit(1);
        }

        // blob = IV(12) || ciphertext || tag(16); Base64 so the emitted .zan
        // file is pure printable text.
        byte[] blob = new byte[12 + data.Length + 16];
        int o = 0;
        while (o < 12) { blob[o] = ivB[o]; o = o + 1; }
        o = 0;
        while (o < data.Length) { blob[12 + o] = ct[o]; o = o + 1; }
        o = 0;
        while (o < 16) { blob[12 + data.Length + o] = tag[o]; o = o + 1; }
        string blob64 = Encoding.Base64EncodeBytes(
            BytesToText(blob, 0, blob.Length), blob.Length);

        string seedHex = Hex.Encode(BytesToText(data, 0, 0), 0);
        // hex-encode the seed from its bytes (not from data)
        byte[] seedB = new byte[seed.Length];
        int si = 0;
        while (si < seed.Length) { seedB[si] = seed[si] & 255; si = si + 1; }
        seedHex = Hex.Encode(BytesToText(seedB, 0, seedB.Length), seedB.Length);

        string zan = "using System;\n"
            + "using System.Security.Cryptography;\n"
            + "\n"
            + "// Generated by tools/pack_script.zan from " + inPath + " -- do not edit.\n"
            + "// AES-256-GCM; blob = IV(12) || ciphertext || tag(16);\n"
            + "// key = HKDF-SHA256(\"zan-lua-pack-v1\", seed) derived at run time,\n"
            + "// so neither the chunk nor the key appears as literal text here.\n"
            + "// Usage: Lua.ExecBytes(PackedScript.DecryptChunk(), ChunkName)\n"
            + "class PackedScript {\n"
            + "    /// chunk 名，同时是 AES-GCM 的 AAD（换包/换名都过不了认证）。\n"
            + "    public static string ChunkName() { return \"" + chunkName + "\"; }\n"
            + "\n"
            + "    static string B64 = \"" + blob64 + "\";\n"
            + "    static string SeedHex = \"" + seedHex + "\";\n"
            + "\n"
            + "    static string BytesToText(byte[] b, int off, int len) {\n"
            + "        nint p = NativeMemory.Alloc(len);\n"
            + "        int i = 0;\n"
            + "        while (i < len) { NativeMemory.Fill(p + i, b[off + i] & 255, 1); i = i + 1; }\n"
            + "        string s = NativeMemory.GetString(p, 0, len);\n"
            + "        NativeMemory.Fill(p, 0, len);\n"
            + "        NativeMemory.Free(p);\n"
            + "        return s;\n"
            + "    }\n"
            + "\n"
            + "    /// 解出 chunk 字节（源码或 luac 字节码），交给 Lua.ExecBytes。\n"
            + "    /// 认证失败（被篡改/密钥不符）抛异常，不返回半截数据。\n"
            + "    public static byte[] DecryptChunk() {\n"
            + "        byte[] blob = Encoding.Base64Decode(B64);\n"
            + "        string iv = BytesToText(blob, 0, 12);\n"
            + "        int ctLen = blob.Length - 12 - 16;\n"
            + "        string ct = BytesToText(blob, 12, ctLen);\n"
            + "        string tag = BytesToText(blob, 12 + ctLen, 16);\n"
            + "        byte[] seedB = Hex.Decode(SeedHex);\n"
            + "        string seed = BytesToText(seedB, 0, seedB.Length);\n"
            + "        byte[] keyB = Hkdf.Derive(\"zan-lua-pack-v1\", 14, seed, seed.Length, \"lua-chunk-key\", 13, 32);\n"
            + "        string key = BytesToText(keyB, 0, 32);\n"
            + "        List<int> ok = new List<int>();\n"
            + "        ok.Add(0);\n"
            + "        byte[] pt = AesGcm.Decrypt(key, 32, iv, ChunkName(), "
            + Convert.ToString(chunkName.Length) + ", ct, ctLen, tag, ok);\n"
            + "        if (ok[0] != -1 || pt == null) {\n"
            + "            throw new InvalidOperationException(\"packed script authentication failed\");\n"
            + "        }\n"
            + "        return pt;\n"
            + "    }\n"
            + "}\n";

        File.WriteAllText(outPath, zan);
        Console.WriteLine("PACK_OK " + outPath + " blob=" + Convert.ToString(blob.Length)
                          + "B b64=" + Convert.ToString(blob64.Length) + "B");
    }
}
