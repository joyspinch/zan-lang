using System;

namespace Zan.Tools.Gallery;

public class GalleryResult {
    public string json;
    public int entries;
    public int discovered;
    public int templates;
    public List<string> warnings;

    public GalleryResult() {
        this.json = "";
        this.entries = 0;
        this.discovered = 0;
        this.templates = 0;
        this.warnings = new List<string>();
    }
}
