namespace Zan.Tools.SemanticIndex;

// Metadata for one indexed ORM member, including inferred identity state.
class IndexedField {
    public string Name;
    public string TypeName;
    public int Kind;  // 0 integer, 1 float, 2 bool, 3 string, 4 enum, 5 navigation
    public string Col;
    public bool IsPk;
    public bool IsIdent;
    public bool IdentSet;
    public bool NotNull;
    public int StrLen;
}
