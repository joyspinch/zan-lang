using System;
using System.IO;
using System.Knowledge;

namespace GenKnowledge;

class GenKnowledge {
    static int Main() {
        string root = ".";
        string stdlib = "";
        string outDir = "";
        string seed = "";
        int i = 0;
        while (i < Environment.ArgCount()) {
            string a = Environment.ArgAt(i);
            if (a == "--root" && i + 1 < Environment.ArgCount()) { root = Environment.ArgAt(i + 1); i = i + 2; continue; }
            if (a == "--stdlib" && i + 1 < Environment.ArgCount()) { stdlib = Environment.ArgAt(i + 1); i = i + 2; continue; }
            if (a == "--out" && i + 1 < Environment.ArgCount()) { outDir = Environment.ArgAt(i + 1); i = i + 2; continue; }
            if (a == "--seed" && i + 1 < Environment.ArgCount()) { seed = Environment.ArgAt(i + 1); i = i + 2; continue; }
            i = i + 1;
        }
        root = GenKnowledge.Trim(root);
        if (stdlib == "") { stdlib = root + "/stdlib"; }
        if (outDir == "") { outDir = root + "/knowledge"; }
        if (seed == "") { seed = root + "/tools/mcp_server/gallery.json"; }
        Directory.CreateDirectoryRecursive(outDir);
        GalleryResult g = GalleryIndex.Generate(root, seed);
        File.WriteAllText(outDir + "/gallery.json", g.json);
        Console.WriteLine("KNOWLEDGE_GALLERY_OK -> " + outDir + "/gallery.json");
        for (int j = 0; j < g.warnings.Count; j = j + 1) {
            Console.WriteLine("KNOWLEDGE_WARN: " + g.warnings[j]);
        }
        return 0;
    }
    static string Trim(string s) {
        while (s.Length > 1 && (s.Substring(s.Length - 1, 1) == "/" || s.Substring(s.Length - 1, 1) == "\\")) {
            s = s.Substring(0, s.Length - 1);
        }
        return s;
    }
}
