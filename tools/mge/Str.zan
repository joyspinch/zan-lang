using System;
using System.Collections.Generic;
using System.Text;

namespace Mge;

class Str {
    static bool IsDigit(string c) {
        return c == "0" || c == "1" || c == "2" || c == "3" || c == "4"
            || c == "5" || c == "6" || c == "7" || c == "8" || c == "9";
    }

    static string Digits(string s, bool signed) {
        StringBuilder sb = new StringBuilder();
        int i = 0;
        while (i < s.Length) {
            string c = s.Substring(i, 1);
            if (Str.IsDigit(c)) { sb.Append(c); }
            else if (signed && c == "-" && i == 0) { sb.Append(c); }
            i = i + 1;
        }
        return sb.ToString();
    }

    static int ToInt(string s) {
        string d = Str.Digits(s, true);
        if (d == "" || d == "-") { return 0; }
        return Convert.ToInt(d);
    }

    static string FromInt(int v) { return Convert.ToString(v); }

    static List<string> SplitList(string s) {
        List<string> parts = new List<string>();
        StringBuilder sb = new StringBuilder();
        int i = 0;
        while (i <= s.Length) {
            bool end = i == s.Length;
            string c = "";
            if (!end) { c = s.Substring(i, 1); }
            if (end || c == "," || c == "，") {
                string p = Str.Trim(sb.ToString());
                if (p != "") { parts.Add(p); }
                sb = new StringBuilder();
            } else {
                sb.Append(c);
            }
            i = i + 1;
        }
        return parts;
    }

    static string Trim(string s) {
        int a = 0;
        int b = s.Length;
        while (a < b && Str.IsSpace(s.Substring(a, 1))) { a = a + 1; }
        while (b > a && Str.IsSpace(s.Substring(b - 1, 1))) { b = b - 1; }
        if (b <= a) { return ""; }
        return s.Substring(a, b - a);
    }

    static bool IsSpace(string c) {
        return c == " " || c == "\t" || c == "\r" || c == "\n";
    }

    static bool Contains(string s, string sub) {
        if (sub.Length == 0) { return true; }
        int i = 0;
        while (i + sub.Length <= s.Length) {
            if (s.Substring(i, sub.Length) == sub) { return true; }
            i = i + 1;
        }
        return false;
    }

    static string Quote(string s) {
        StringBuilder sb = new StringBuilder();
        sb.Append("\"");
        int i = 0;
        while (i < s.Length) {
            string c = s.Substring(i, 1);
            if (c == "\"") { sb.Append("\\\""); }
            else if (c == "\\") { sb.Append("\\\\"); }
            else if (c == "\n") { sb.Append("\\n"); }
            else if (c == "\r") { sb.Append(""); }
            else if (c == "\t") { sb.Append("\\t"); }
            else { sb.Append(c); }
            i = i + 1;
        }
        sb.Append("\"");
        return sb.ToString();
    }
}
