using System;
using System.Collections.Generic;

namespace Mge;

class MapDoc {
    string name;
    int cellW;
    int cellH;
    int cols;
    int rows;
    int startX;
    int startY;
    bool isDefault;
    List<int> cells;        // cols*rows flags: 0 none, 1 障碍, 2 透明, 3 both
    List<JsonValue> spawns; // {name,x,y,range,count,level,faction}

    static MapDoc Create(string name, int cols, int rows) {
        MapDoc m = new MapDoc();
        m.name = name;
        m.cellW = 64;
        m.cellH = 32;
        m.cols = cols;
        m.rows = rows;
        m.startX = 0;
        m.startY = 0;
        m.isDefault = false;
        m.cells = new List<int>();
        m.spawns = new List<JsonValue>();
        int i = 0;
        while (i < cols * rows) {
            m.cells.Add(0);
            i = i + 1;
        }
        return m;
    }

    int CellAt(int x, int y) {
        if (x < 0 || y < 0 || x >= cols || y >= rows) { return 0; }
        return cells[y * cols + x];
    }

    void SetCell(int x, int y, int flags) {
        if (x < 0 || y < 0 || x >= cols || y >= rows) { return; }
        cells[y * cols + x] = flags;
    }

    void Resize(int newCols, int newRows) {
        if (newCols < 1) { newCols = 1; }
        if (newRows < 1) { newRows = 1; }
        if (newCols == cols && newRows == rows) { return; }
        List<int> next = new List<int>();
        int y = 0;
        while (y < newRows) {
            int x = 0;
            while (x < newCols) {
                next.Add(this.CellAt(x, y));
                x = x + 1;
            }
            y = y + 1;
        }
        cells = next;
        cols = newCols;
        rows = newRows;
        if (startX >= cols) { startX = cols - 1; }
        if (startY >= rows) { startY = rows - 1; }
    }

    string CellString() {
        StringBuilder sb = new StringBuilder();
        int i = 0;
        while (i < cells.Count) {
            sb.Append(Str.FromInt(cells[i]));
            i = i + 1;
        }
        return sb.ToString();
    }

    void LoadCellString(string s) {
        int i = 0;
        while (i < cells.Count) {
            int v = 0;
            if (i < s.Length) { v = Str.ToInt(s.Substring(i, 1)); }
            cells[i] = v;
            i = i + 1;
        }
    }

    int SpawnIndexAt(int x, int y) {
        int i = 0;
        while (i < spawns.Count) {
            if (spawns[i].Int("x", -1) == x && spawns[i].Int("y", -1) == y) { return i; }
            i = i + 1;
        }
        return -1;
    }
}

// The application: four sheets (角色 / 道具 / 技能 / 地图), JSON
