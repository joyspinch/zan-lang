using System;
using System.Collections.Generic;
using Gui.Widget;

namespace Mge;

class Sheet {
    string title;
    string file;              // file name inside the data dir
    List<FieldSpec> specs;
    List<JsonValue> rows;
    int sel;
    int scroll;
    List<Input> inputs;       // one per spec (used by text / int fields)
    int formScroll;
    Input search;
    bool dirty;

    static Sheet Create(string title, string file, List<FieldSpec> specs) {
        Sheet s = new Sheet();
        s.title = title;
        s.file = file;
        s.specs = specs;
        s.rows = new List<JsonValue>();
        s.sel = -1;
        s.scroll = 0;
        s.formScroll = 0;
        s.inputs = new List<Input>();
        int i = 0;
        while (i < specs.Count) {
            s.inputs.Add(new Input(""));
            i = i + 1;
        }
        s.search = new Input("搜索名称...");
        s.dirty = false;
        return s;
    }

    JsonValue NewRow() {
        JsonValue row = JsonValue.NewObject();
        int i = 0;
        while (i < specs.Count) {
            FieldSpec f = specs[i];
            if (f.kind == 0) { row.Set(f.key, JsonValue.NewStr(f.dfltText)); }
            if (f.kind == 1) { row.Set(f.key, JsonValue.NewNum(Str.FromInt(f.dfltInt))); }
            if (f.kind == 2) { row.Set(f.key, JsonValue.NewBool(f.dfltInt == 1)); }
            if (f.kind == 3) { row.Set(f.key, JsonValue.NewNum(Str.FromInt(f.dfltInt))); }
            i = i + 1;
        }
        row.Set("name", JsonValue.NewStr(this.UniqueName("new")));
        return row;
    }

    string UniqueName(string stem) {
        int n = 1;
        while (n < 10000) {
            string candidate = stem + Str.FromInt(n);
            if (this.FindByName(candidate) < 0) { return candidate; }
            n = n + 1;
        }
        return stem;
    }

    int FindByName(string name) {
        int i = 0;
        while (i < rows.Count) {
            if (rows[i].Str("name", "") == name) { return i; }
            i = i + 1;
        }
        return -1;
    }

    JsonValue Selected() {
        if (sel < 0 || sel >= rows.Count) { return null; }
        return rows[sel];
    }

    void PushForm() {
        JsonValue row = this.Selected();
        int i = 0;
        while (i < specs.Count) {
            FieldSpec f = specs[i];
            string v = "";
            if (row != null) {
                if (f.kind == 0) { v = row.Str(f.key, f.dfltText); }
                if (f.kind == 1) { v = Str.FromInt(row.Int(f.key, f.dfltInt)); }
            }
            inputs[i].SetText(v);
            i = i + 1;
        }
    }
}

// 刷怪点 (spawn) list.
