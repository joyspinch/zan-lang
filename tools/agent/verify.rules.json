{
  "version": 3,
  "repo": "zan-lang",
  "note": "改动路径 -> 必跑检查 + 该跑哪个 ctest。规则自上而下取第一条。ctest 正则的命中数不写死，由 verify.ps1 现场用 ctest -N 验证：命中 0 就是映射失效，直接报出来。",
  "tools": {
    "zanc": "build/zanc.exe",
    "zanfmt": "build/zanfmt.exe",
    "repomap": "build/repomap.exe",
    "repomapEntry": "scripts/build_repomap.ps1",
    "testEntry": "scripts/test.ps1",
    "templateGateWindows": "tools/agent/gate-templates.ps1",
    "templateGateMac": "scripts/test_all_templates.py"
  },
  "policy": {
    "routine": "日常只跑 target 化测试：scripts/test.ps1 smoke -Match \"<re>\"",
    "releaseGateOnly": ["standard", "full"],
    "why": "全套 3904 条，standard/full 是发布门(AGENTS.md Rule 8)，日常跑会占满所有核且与本改动无关"
  },
  "checks": {
    "fmt": {
      "tier": "A",
      "why": "zanfmt --check，退出码即裁决（0=ok，1=needs formatting）"
    },
    "compile": {
      "tier": "A",
      "why": "build/zanc --deny-warnings --emit-lib：类型/语法/警告一次收全，诊断带 file:line:col"
    },
    "rebuild": {
      "tier": "C",
      "why": "C/C++ 源改动只能整目标重建（cmake --build build --target zanc）；单文件编译不代表任何东西，所以不假装能判"
    },
    "impact": {
      "tier": "B",
      "why": "公共面改动必须列外部消费方；模板/示例漏改是本仓库最贵的一类"
    },
    "ctest": {
      "tier": "B",
      "why": "把改动路径映射到一组测试，避免要么瞎跑全套、要么不跑"
    },
    "templates": {
      "tier": "C",
      "why": "模板验收：Windows 用 tools/agent/gate-templates.ps1，macOS 用 scripts/test_all_templates.py（后者硬编码 macOS 路径）"
    }
  },
  "rules": [
    { "glob": "stdlib/**/*.zan", "checks": ["fmt", "compile", "impact", "ctest"], "ctest": "^conformance_" },
    { "glob": "packages/**/*.zan", "checks": ["fmt", "compile", "impact", "ctest"], "ctest": "^conformance_" },
    { "glob": "templates/**/*.zan", "checks": ["fmt", "templates"] },
    { "glob": "examples/**/*.zan", "checks": ["fmt", "compile", "ctest"], "ctest": "^conformance_" },
    { "glob": "tools/**/*.zan", "checks": ["fmt", "compile", "ctest"], "ctest": "^tool_" },
    { "glob": "src/compiler/**", "checks": ["rebuild", "ctest"], "ctest": "^(golden_|diag_|compiler_)" },
    { "glob": "src/runtime/**", "checks": ["rebuild", "ctest"], "ctest": "^(runtime_|abi_)" },
    { "glob": "src/lsp/**", "checks": ["rebuild", "ctest"], "ctest": "^lsp_" },
    { "glob": "src/dap/**", "checks": ["rebuild", "ctest"], "ctest": "^dap" },
    { "glob": "src/fmt/**", "checks": ["rebuild", "ctest"], "ctest": "fmt" },
    { "glob": "src/doc/**", "checks": ["rebuild", "ctest"], "ctest": "doc" },
    { "glob": "src/pm/**", "checks": ["rebuild", "ctest"], "ctest": "^(policy_|unit_)" },
    { "glob": "src/selfhost*/**", "checks": ["rebuild", "ctest"], "ctest": "^selfhost" },
    { "glob": "src/ide_zan/**", "checks": ["rebuild", "ctest"], "ctest": "^(ide_|gui)" },
    { "glob": "tests/**", "checks": ["ctest"], "ctestFromPath": true },
    { "glob": "CMakeLists.txt", "checks": ["rebuild", "ctest"], "ctest": "^(golden_|diag_|runtime_|abi_)" },
    { "glob": "scripts/**", "checks": [] },
    { "glob": "**/*.zan", "checks": ["fmt", "compile"] },
    { "glob": "**", "checks": [] }
  ],
  "escalate": [
    {
      "when": "impact.crossBoundary",
      "then": "公共面改动跨出区域：跑模板验收门，别只看编译过",
      "suggest": "tools/agent/gate-templates.ps1"
    },
    {
      "when": "targets contain stdlib/* or packages/*",
      "then": "结构变了要重生成地图，否则下一个会话读到旧账",
      "suggest": "scripts/build_repomap.ps1"
    }
  ],
  "skipDirs": [".git", "_scratch", "build", "dist", ".zanmap", ".zan-packages", "node_modules", "Testing", "logs", "video", "zan-site", "deps"],
  "verdict": "任一 A 档失败即不可提交；ctest 只是建议命令，绝不自动跑 standard/full"
}
