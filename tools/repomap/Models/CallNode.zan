using System;
using System.Collections.Generic;

class CallNode {
    string id;        // "ClassName.MethodName"
    string name;      // "MethodName"
    string owner;     // "ClassName"
    string file;      // "src/Foo.zan"
    int line;         // declaration line
    string sig;       // method signature
    List<string> callees;  // 当前方法体内部调用的目标方法标识符列表
    List<string> callers;  // 调用当前方法的外部调用者方法标识符列表

    static CallNode Create(string id, string name, string owner, string file, int line, string sig) {
        CallNode c = new CallNode();
        c.id = id;
        c.name = name;
        c.owner = owner;
        c.file = file;
        c.line = line;
        c.sig = sig;
        c.callees = new List<string>();
        c.callers = new List<string>();
        return c;
    }

    static void AddUnique(List<string> target, string value) {
        if (value.Length == 0) { return; }
        int i = 0;
        while (i < target.Count) {
            if (target[i] == value) { return; }
            i = i + 1;
        }
        target.Add(value);
    }
}
