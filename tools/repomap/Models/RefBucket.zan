using System;
using System.Collections.Generic;


namespace RepoMap;

class RefBucket {
    string name;
    List<string> kinds;
    List<string> owners;
    List<string> defs;      // "file:line" of every declaration (capped on output)
    List<string> refs;      // "file:line", capped at RepoMap.REF_CAP
    List<string> subtypes;  // types declaring this one as a base
    int total;
    int tests;

    static RefBucket Create(string name) {
        RefBucket b = new RefBucket();
        b.name = name;
        b.kinds = new List<string>();
        b.owners = new List<string>();
        b.defs = new List<string>();
        b.refs = new List<string>();
        b.subtypes = new List<string>();
        b.total = 0;
        b.tests = 0;
        return b;
    }

    static void AddUnique(List<string> target, string value) {
        if (value.Length == 0) { return; }
        int i = 0;
        while (i < target.Count) {
            if (target[i] == value) { return; }
            i = i + 1;
        }
        target.Add(value);
    }
}