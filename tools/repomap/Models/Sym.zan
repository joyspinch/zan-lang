using System;
using System.Collections.Generic;

class Sym {
    string kind;    // class | struct | interface | enum | method | delegate
    string name;    // "MqttBroker" or "MqttBroker.Start"
    string sig;     // full signature line (methods) or "" (types)
    string doc;     // first line of the /// summary, "" when undocumented
    string ext;     // base type list of a type declaration, "" otherwise
    int line;

    static Sym Create(string kind, string name, string sig, int line) {
        Sym s = new Sym();
        s.kind = kind;
        s.name = name;
        s.sig = sig;
        s.doc = "";
        s.ext = "";
        s.line = line;
        return s;
    }
}
