using System;
using System.Collections.Generic;

class FileInfo {
    string path;    // path relative to the scanned root
    string abs;     // path the scanner can re-open for the reference pass
    string ns;      // declared namespace, "" when the file has none
    List<Sym> syms;

    static FileInfo Create(string path) {
        FileInfo f = new FileInfo();
        f.path = path;
        f.abs = path;
        f.ns = "";
        f.syms = new List<Sym>();
        return f;
    }
}
