using System;


namespace RepoMap;

class BuiltinMemberEntry {
    public string arr;
    public string name;
    public string kind;
    public string sig;
    public int line;

    public BuiltinMemberEntry(string arr, string name, string kind, string sig, int line) {
        this.arr = arr;
        this.name = name;
        this.kind = kind;
        this.sig = sig;
        this.line = line;
    }
}