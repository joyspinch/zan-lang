using System;
using System.IO;
using System.Text;

namespace RepoMap;

// -----------------------------------------------------------------------------
// 扫描 Zan 工程并生成符号索引（.zanmap/），供大模型快速理解代码库全貌。
// 以微小体积聚合全工程核心类型定义与成员签名。
// -----------------------------------------------------------------------------

class RepoMap {
    static string OUT_DIR = ".zanmap";

    static int REF_CAP = 30;

    static string scanRoot = ".";

    static int Main() {
        string root = ".";
        bool wantRefs = true;
        int ai = 0;
        while (ai < Environment.ArgCount()) {
            string a = Environment.ArgAt(ai);
            ai = ai + 1;
            if (a == "--no-refs") { wantRefs = false; }
            else if (!Str.StartsWith(a, "--")) { root = a; }
        }

        RepoMap.scanRoot = root;
        List<FileInfo> files = new List<FileInfo>();
        RepoMap.ScanDir(root, "", files);

        // 输出目录只能按磁盘状态判断：Directory.Exists 会回退到随附资源
        // 目录，工作目录下没有 .zanmap 时也会答“有”，写入随后就失败。
        // CreateDirectoryRecursive 自己按 ExistsOnDisk 判重，直接调用即可。
        Directory.CreateDirectoryRecursive(RepoMap.OUT_DIR);
        File.WriteAllText(RepoMap.OUT_DIR + "/repo.map.txt", RepoMap.RenderText(root, files));
        File.WriteAllText(RepoMap.OUT_DIR + "/symbols.json", RepoMap.RenderSymbols(files));

        int refCount = 0;
        if (wantRefs) {
            List<RefBucket> buckets = RepoMap.BuildRefIndex(files);
            File.WriteAllText(RepoMap.OUT_DIR + "/refs.json", RepoMap.RenderRefs(buckets));
            refCount = buckets.Count;
        }

        List<CallNode> callNodes = RepoMap.BuildCallGraph(files);
        string cgJson = RepoMap.RenderCallGraph(callNodes);
        File.WriteAllText(RepoMap.OUT_DIR + "/callgraph.json", cgJson);
        File.WriteAllText(RepoMap.OUT_DIR + "/callgraph.jsonl", RepoMap.RenderCallGraphJsonl(callNodes));

        string controllerDir = root + "/src/Controller";
        if (!Directory.Exists(controllerDir)) { controllerDir = root + "/src/controller"; }
        int routeCount = 0;
        if (Directory.Exists(controllerDir)) {
            string routes = RepoMap.RenderRoutes(controllerDir);
            File.WriteAllText(RepoMap.OUT_DIR + "/routes.approx.json", routes);
            routeCount = RepoMap.lastRouteCount;
        }

        int symCount = 0;
        int i = 0;
        while (i < files.Count) { symCount = symCount + files[i].syms.Count; i = i + 1; }
        Console.WriteLine("[repomap] " + Convert.ToString(files.Count) + " files, "
            + Convert.ToString(symCount) + " symbols, "
            + Convert.ToString(callNodes.Count) + " call nodes, "
            + Convert.ToString(refCount) + " indexed names, "
            + Convert.ToString(routeCount) + " routes -> " + RepoMap.OUT_DIR + "/");
        return 0;
    }

    static bool SkipDir(string name) {
        string n = Str.Lower(name);
        int slash = Str.Find(n, "/", 0);
        while (slash >= 0) {
            n = n.Substring(slash + 1, n.Length - slash - 1);
            slash = Str.Find(n, "/", 0);
        }
        slash = Str.Find(n, "\\", 0);
        while (slash >= 0) {
            n = n.Substring(slash + 1, n.Length - slash - 1);
            slash = Str.Find(n, "\\", 0);
        }
        return n == "_scratch" || n == "build" || n == "dist" || n == ".git"
            || n == "assets" || n == "toolchain" || n == "node_modules"
            || n == ".zanmap" || n == "uploads" || n == "obj" || n == "bin"
            || n == "cmakefiles" || n == ".vs" || n == ".idea";
    }

    static void ScanDir(string dir, string rel, List<FileInfo> outp) {
        if (!Directory.Exists(dir)) { return; }
        List<string> fs = Directory.GetFiles(dir);
        int i = 0;
        while (i < fs.Count) {
            string fn = fs[i];
            i = i + 1;
            bool isZan = Str.EndsWith(fn, ".zan");
            bool isC = Str.EndsWith(fn, ".c") || Str.EndsWith(fn, ".h");
            if (isZan || isC) {
                string relPath = rel + fn;
                FileInfo fi = FileInfo.Create(relPath);
                fi.abs = dir + "/" + fn;
                if (isZan) { RepoMap.ScanFile(fi.abs, fi); }
                else { RepoMap.ScanCFile(fi.abs, fi); }
                if (fi.syms.Count > 0) { outp.Add(fi); }
            }
        }
        List<string> subs = Directory.GetDirectories(dir);
        int j = 0;
        while (j < subs.Count) {
            string sd = subs[j];
            j = j + 1;
            if (!RepoMap.SkipDir(sd)) {
                RepoMap.ScanDir(dir + "/" + sd, rel + sd + "/", outp);
            }
        }
    }


    static void ScanFile(string path, FileInfo fi) {
        string text = File.ReadAllText(path);
        List<string> lines = RepoMap.SplitLines(text);
        List<int> depth = RepoMap.DepthPerLine(lines);
        string doc = "";
        int i = 0;
        while (i < lines.Count) {
            string t = Str.Trim(lines[i]);
            int d = depth[i];
            if (t.Length > 0) {
                if (Str.StartsWith(t, "///")) {
                    string piece = Str.Trim(RepoMap.StripTags(t.Substring(3, t.Length - 3)));
                    if (piece.Length > 0 && doc.Length == 0) { doc = piece; }
                } else if (Str.StartsWith(t, "//") || Str.StartsWith(t, "[")
                           || Str.StartsWith(t, "*") || Str.StartsWith(t, "/*")) {
                } else {
                    if (d == 0) {
                        if (Str.Word(t, "namespace") && fi.ns.Length == 0) {
                            fi.ns = RepoMap.DottedAfter(t, "namespace");
                        }
                        RepoMap.TryType(t, i + 1, fi, doc);
                    } else if (d == 1) {
                        RepoMap.TryMethod(t, i + 1, fi, doc);
                    }
                    doc = "";
                }
            }
            i = i + 1;
        }
    }

    // C 语言编译单元或头文件符号抽取：支持宏定义与函数原型索引。
    static void ScanCFile(string path, FileInfo fi) {
        List<string> lines = RepoMap.SplitLines(File.ReadAllText(path));
        List<int> depth = RepoMap.DepthPerLine(lines);
        string doc = "";
        string pend = "";        // signature text accumulated at depth 0
        int pendLine = 0;
        bool inBlock = false;    // inside a /* ... */ comment
        int i = 0;
        while (i < lines.Count) {
            string t = Str.Trim(lines[i]);
            int d = depth[i];
            i = i + 1;
            if (inBlock) {
                int close = Str.Find(t, "*/", 0);
                if (close < 0) {
                    if (doc.Length == 0) { doc = RepoMap.CDocLine(t); }
                    continue;
                }
                inBlock = false;
                t = Str.Trim(t.Substring(close + 2, t.Length - close - 2));
                if (t.Length == 0) { continue; }
            }
            if (d == 1 && Str.StartsWith(t, "}") && Str.EndsWith(t, ";")
                && Str.Find(t, "(", 0) < 0) {                // not `} while (c);`
                string cn = RepoMap.LastIdent(t);
                if (cn.Length > 0) {
                    Sym cs = Sym.Create("typedef", cn, "typedef struct { ... } "
                        + cn, i);
                    fi.syms.Add(cs);
                }
                continue;
            }
            if (d != 0) { continue; }
            if (t.Length == 0) { pend = ""; doc = ""; continue; }
            if (Str.StartsWith(t, "//") || Str.StartsWith(t, "*")
                || Str.StartsWith(t, "/*")) {
                if (doc.Length == 0) { doc = RepoMap.CDocLine(t); }
                if (Str.Find(t, "/*", 0) >= 0 && Str.Find(t, "*/", 0) < 0) {
                    inBlock = true;
                }
                continue;
            }
            if (Str.StartsWith(t, "#")) {
                RepoMap.TryCMacro(t, i, fi, doc);
                doc = "";
                continue;
            }
            if (pend.Length == 0) { pendLine = i; }
            pend = pend + (pend.Length > 0 ? " " : "") + t;
            if (Str.EndsWith(t, "{")) {
                RepoMap.TryCBlock(pend, pendLine, fi, doc);
                pend = "";
                doc = "";
            } else if (Str.EndsWith(t, ";")) {
                RepoMap.TryCProto(pend, pendLine, fi, doc);
                pend = "";
                doc = "";
            }
        }
    }

    static string CDocLine(string t) {
        string s = t;
        if (Str.StartsWith(s, "/**")) { s = s.Substring(3, s.Length - 3); }
        else if (Str.StartsWith(s, "/*")) { s = s.Substring(2, s.Length - 2); }
        else if (Str.StartsWith(s, "//")) { s = s.Substring(2, s.Length - 2); }
        else if (Str.StartsWith(s, "*")) { s = s.Substring(1, s.Length - 1); }
        int end = Str.Find(s, "*/", 0);
        if (end >= 0) { s = s.Substring(0, end); }
        return Str.Trim(s);
    }

    static void TryCMacro(string t, int line, FileInfo fi, string doc) {
        if (!Str.StartsWith(t, "#define")) { return; }
        string name = RepoMap.IdentAfter(t, "#define");
        if (name.Length == 0) { return; }
        Sym s = Sym.Create("macro", name, Str.Trim(t), line);
        s.doc = doc;
        fi.syms.Add(s);
    }

    static void TryCBlock(string head, int line, FileInfo fi, string doc) {
        string sig = head;
        int brace = Str.Find(sig, "{", 0);
        if (brace >= 0) { sig = Str.Trim(sig.Substring(0, brace)); }
        if (sig.Length == 0) { return; }
        if (RepoMap.IsControlWord(sig)) { return; }
        string kind = "";
        if (Str.Word(sig, "struct")) { kind = "struct"; }
        else if (Str.Word(sig, "union")) { kind = "struct"; }
        else if (Str.Word(sig, "enum")) { kind = "enum"; }
        int p = Str.Find(sig, "(", 0);
        if (p > 0 && kind == "") {
            string name = RepoMap.NameBefore(sig, p);
            if (name.Length == 0) { return; }
            Sym s = Sym.Create("function", name, sig, line);
            s.doc = doc;
            fi.syms.Add(s);
            return;
        }
        if (kind == "") { return; }
        string tag = RepoMap.IdentAfter(sig, kind);
        if (tag.Length == 0) { return; }   // anonymous: named by its typedef
        Sym st = Sym.Create(kind, tag, sig, line);
        st.doc = doc;
        fi.syms.Add(st);
    }

    static void TryCProto(string head, int line, FileInfo fi, string doc) {
        string sig = head;
        int semi = Str.Find(sig, ";", 0);
        if (semi >= 0) { sig = Str.Trim(sig.Substring(0, semi)); }
        if (sig.Length == 0) { return; }
        if (Str.Word(sig, "typedef")) {
            string tn = RepoMap.LastIdent(sig);
            if (tn.Length == 0) { return; }
            Sym s = Sym.Create("typedef", tn, sig, line);
            s.doc = doc;
            fi.syms.Add(s);
            return;
        }
        int p = Str.Find(sig, "(", 0);
        if (p <= 0) { return; }
        string name = RepoMap.NameBefore(sig, p);
        if (name.Length == 0) { return; }
        if (RepoMap.IsControlWord(sig)) { return; }
        Sym sp = Sym.Create("prototype", name, sig, line);
        sp.doc = doc;
        fi.syms.Add(sp);
    }

    static string LastIdent(string s) {
        int i = s.Length - 1;
        while (i >= 0 && !Str.IsAlnum(s.Substring(i, 1))) { i = i - 1; }
        int end = i + 1;
        while (i >= 0 && Str.IsAlnum(s.Substring(i, 1))) { i = i - 1; }
        if (end <= i + 1) { return ""; }
        return s.Substring(i + 1, end - i - 1);
    }

    // 去除 XML 文档标签，将文档注释提炼为纯文本摘要。
    static string StripTags(string s) {
        StringBuilder sb = new StringBuilder();
        int i = 0;
        while (i < s.Length) {
            string c = s.Substring(i, 1);
            if (c == "<") {
                int close = Str.Find(s, ">", i + 1);
                if (close < 0) { break; }
                i = close + 1;
                continue;
            }
            sb.Append(c);
            i = i + 1;
        }
        return sb.ToString();
    }

    static string DottedAfter(string line, string kw) {
        int p = Str.Find(line, kw, 0);
        if (p < 0) { return ""; }
        int i = p + kw.Length;
        while (i < line.Length && Str.IsSpace(line.Substring(i, 1))) { i = i + 1; }
        StringBuilder sb = new StringBuilder();
        while (i < line.Length) {
            string c = line.Substring(i, 1);
            if (!Str.IsAlnum(c) && c != ".") { break; }
            sb.Append(c);
            i = i + 1;
        }
        return sb.ToString();
    }

    static string BasesOf(string t) {
        int brace = Str.Find(t, "{", 0);
        string head = t;
        if (brace >= 0) { head = t.Substring(0, brace); }
        int colon = Str.Find(head, ":", 0);
        if (colon < 0) { return ""; }
        string tail = head.Substring(colon + 1, head.Length - colon - 1);
        StringBuilder sb = new StringBuilder();
        int depth = 0;
        int i = 0;
        while (i < tail.Length) {
            string c = tail.Substring(i, 1);
            if (c == "<") { depth = depth + 1; }
            else if (c == ">") { depth = depth - 1; }
            else if (depth == 0) {
                if (Str.IsAlnum(c) || c == ".") { sb.Append(c); }
                else if (c == ",") { sb.Append(","); }
            }
            i = i + 1;
        }
        return Str.Trim(sb.ToString());
    }

    static void TryType(string t, int line, FileInfo fi, string doc) {
        string kind = "";
        if (Str.Word(t, "class")) { kind = "class"; }
        else if (Str.Word(t, "struct")) { kind = "struct"; }
        else if (Str.Word(t, "interface")) { kind = "interface"; }
        else if (Str.Word(t, "enum")) { kind = "enum"; }
        if (kind == "") { return; }
        Sym s = Sym.Create(kind, RepoMap.IdentAfter(t, kind), "", line);
        s.doc = doc;
        s.ext = RepoMap.BasesOf(t);
        fi.syms.Add(s);
    }

    static bool IsControlWord(string t) {
        return Str.Word(t, "if") || Str.Word(t, "for") || Str.Word(t, "while")
            || Str.Word(t, "switch") || Str.Word(t, "catch") || Str.Word(t, "else")
            || Str.Word(t, "do") || Str.Word(t, "return") || Str.Word(t, "using")
            || Str.Word(t, "namespace") || Str.Word(t, "await") || Str.Word(t, "lock");
    }

    static void TryMethod(string t, int line, FileInfo fi, string doc) {
        if (Str.StartsWith(t, "//") || Str.StartsWith(t, "*") || Str.StartsWith(t, "/*")) { return; }
        if (Str.StartsWith(t, "[")) { return; }          // attribute
        if (RepoMap.IsControlWord(t)) { return; }
        int p = Str.Find(t, "(", 0);
        if (p <= 0) { return; }                          // no call/def parens
        string name = RepoMap.NameBefore(t, p);
        if (name.Length == 0) { return; }
        int ni = Str.Find(t, name, 0);
        if (ni <= 0) { return; }
        string sig = t;
        int brace = Str.Find(sig, "{", 0);
        if (brace >= 0) { sig = Str.Trim(sig.Substring(0, brace)); }
        int semi = Str.Find(sig, ";", 0);
        if (semi >= 0) { sig = Str.Trim(sig.Substring(0, semi)); }
        string kind = "method";
        if (Str.Word(t, "delegate")) { kind = "delegate"; }
        Sym sym = Sym.Create(kind, name, sig, line);
        sym.doc = doc;
        fi.syms.Add(sym);
    }

    static string NameBefore(string s, int p) {
        int i = p - 1;
        while (i >= 0 && Str.IsSpace(s.Substring(i, 1))) { i = i - 1; }
        int end = i + 1;
        while (i >= 0 && Str.IsAlnum(s.Substring(i, 1))) { i = i - 1; }
        int start = i + 1;
        if (end <= start) { return ""; }
        return s.Substring(start, end - start);
    }

    static string IdentAfter(string line, string kw) {
        int p = Str.Find(line, kw, 0);
        if (p < 0) { return ""; }
        int i = p + kw.Length;
        while (i < line.Length && Str.IsSpace(line.Substring(i, 1))) { i = i + 1; }
        StringBuilder sb = new StringBuilder();
        while (i < line.Length) {
            string c = line.Substring(i, 1);
            if (!Str.IsAlnum(c)) { break; }
            sb.Append(c);
            i = i + 1;
        }
        return sb.ToString();
    }

    static List<int> DepthPerLine(List<string> lines) {
        List<int> outp = new List<int>();
        int depth = 0;
        bool inBlock = false;
        int li = 0;
        while (li < lines.Count) {
            outp.Add(depth);
            string s = lines[li];
            li = li + 1;
            int i = 0;
            int n = s.Length;
            bool inStr = false;
            bool inChar = false;
            while (i < n) {
                string c = s.Substring(i, 1);
                if (inBlock) {
                    if (c == "*" && i + 1 < n && s.Substring(i + 1, 1) == "/") { inBlock = false; i = i + 2; continue; }
                    i = i + 1; continue;
                }
                if (inStr) {
                    if (c == "\\") { i = i + 2; continue; }
                    if (c == "\"") { inStr = false; }
                    i = i + 1; continue;
                }
                if (inChar) {
                    if (c == "\\") { i = i + 2; continue; }
                    if (c == "'") { inChar = false; }
                    i = i + 1; continue;
                }
                if (c == "/" && i + 1 < n && s.Substring(i + 1, 1) == "/") { break; }   // line comment
                if (c == "/" && i + 1 < n && s.Substring(i + 1, 1) == "*") { inBlock = true; i = i + 2; continue; }
                if (c == "\"") { inStr = true; i = i + 1; continue; }
                if (c == "'") { inChar = true; i = i + 1; continue; }
                if (c == "{") { depth = depth + 1; }
                else if (c == "}") { depth = depth - 1; }
                i = i + 1;
            }
        }
        return outp;
    }

    static List<string> SplitLines(string text) {
        List<string> outp = new List<string>();
        StringBuilder sb = new StringBuilder();
        int i = 0;
        while (i < text.Length) {
            string c = text.Substring(i, 1);
            if (c == "\n") { outp.Add(sb.ToString()); sb = new StringBuilder(); }
            else if (c != "\r") { sb.Append(c); }
            i = i + 1;
        }
        outp.Add(sb.ToString());
        return outp;
    }

    // ---- renderers ----

    static string RenderText(string root, List<FileInfo> files) {
        StringBuilder sb = new StringBuilder();
        sb.Append("# RepoMap for ");
        sb.Append(root);
        sb.Append("\n# <file>\n#   <kind> <name/signature>  :line\n\n");
        int i = 0;
        while (i < files.Count) {
            FileInfo f = files[i];
            i = i + 1;
            sb.Append(f.path);
            sb.Append("\n");
            int j = 0;
            while (j < f.syms.Count) {
                Sym s = f.syms[j];
                j = j + 1;
                if (s.kind == "class" || s.kind == "struct"
                    || s.kind == "interface" || s.kind == "enum") {
                    sb.Append("  ");
                    sb.Append(s.kind);
                    sb.Append(" ");
                    sb.Append(s.name);
                } else {
                    sb.Append("    ");
                    sb.Append(s.sig);
                }
                sb.Append("  :");
                sb.Append(Convert.ToString(s.line));
                sb.Append("\n");
            }
            sb.Append("\n");
        }
        return sb.ToString();
    }

    static string RenderSymbols(List<FileInfo> files) {
        StringBuilder sb = new StringBuilder();
        sb.Append("[");
        bool first = true;
        int i = 0;
        while (i < files.Count) {
            FileInfo f = files[i];
            i = i + 1;
            string owner = "";
            int j = 0;
            while (j < f.syms.Count) {
                Sym s = f.syms[j];
                j = j + 1;
                string full = s.name;
                if (s.kind == "class" || s.kind == "struct"
                    || s.kind == "interface" || s.kind == "enum") {
                    owner = s.name;
                } else if (owner.Length > 0) {
                    full = owner + "." + s.name;
                }
                string ownerOf = "";
                if (full != s.name) { ownerOf = owner; }
                if (!first) { sb.Append(","); }
                first = false;
                sb.Append("\n{\"name\":\"");
                sb.Append(Str.JsonEsc(full));
                sb.Append("\",\"kind\":\"");
                sb.Append(s.kind);
                sb.Append("\",\"owner\":\"");
                sb.Append(Str.JsonEsc(ownerOf));
                sb.Append("\",\"ns\":\"");
                sb.Append(Str.JsonEsc(f.ns));
                sb.Append("\",\"file\":\"");
                sb.Append(Str.JsonEsc(f.path));
                sb.Append("\",\"line\":");
                sb.Append(Convert.ToString(s.line));
                sb.Append(",\"sig\":\"");
                sb.Append(Str.JsonEsc(s.sig));
                sb.Append("\",\"ext\":\"");
                sb.Append(Str.JsonEsc(s.ext));
                sb.Append("\",\"doc\":\"");
                sb.Append(Str.JsonEsc(s.doc));
                sb.Append("\"}");
            }
        }
        // 编译器内建函数符号表注入，使其可被统一搜索索引。
        List<string> builtins = RepoMap.BuiltinRecords();
        int bi = 0;
        while (bi < builtins.Count) {
            if (!first) { sb.Append(","); }
            first = false;
            sb.Append("\n");
            sb.Append(builtins[bi]);
            bi = bi + 1;
        }
        sb.Append("\n]\n");
        return sb.ToString();
    }


    // 文本级符号引用查找：快速建立跨文件调用依赖关系。
    static List<RefBucket> BuildRefIndex(List<FileInfo> files) {
        List<RefBucket> buckets = new List<RefBucket>();
        Dictionary<string, int> byName = new Dictionary<string, int>();

        int i = 0;
        while (i < files.Count) {
            FileInfo f = files[i];
            i = i + 1;
            string owner = "";
            int j = 0;
            while (j < f.syms.Count) {
                Sym s = f.syms[j];
                j = j + 1;
                bool isType = s.kind == "class" || s.kind == "struct"
                    || s.kind == "interface" || s.kind == "enum";
                if (isType) { owner = s.name; }
                if (s.name.Length == 0) { continue; }
                int bi = RepoMap.BucketOf(buckets, byName, s.name);
                RefBucket b = buckets[bi];
                RefBucket.AddUnique(b.kinds, s.kind);
                if (!isType && owner.Length > 0) { RefBucket.AddUnique(b.owners, owner); }
                RefBucket.AddUnique(b.defs, f.path + ":" + Convert.ToString(s.line));
                if (isType && s.ext.Length > 0) {
                    List<string> bases = RepoMap.SplitCommas(s.ext);
                    int k = 0;
                    while (k < bases.Count) {
                        string bn = RepoMap.LastSegment(bases[k]);
                        k = k + 1;
                        if (bn.Length == 0) { continue; }
                        int bx = RepoMap.BucketOf(buckets, byName, bn);
                        RefBucket bb = buckets[bx];
                        RefBucket.AddUnique(bb.subtypes, s.name);
                    }
                }
            }
        }

        int fx = 0;
        while (fx < files.Count) {
            FileInfo f = files[fx];
            fx = fx + 1;
            bool isTest = Str.StartsWith(f.path, "tests/");
            List<string> lines = RepoMap.SplitLines(File.ReadAllText(f.abs));
            int li = 0;
            while (li < lines.Count) {
                string raw = lines[li];
                li = li + 1;
                string t = Str.Trim(raw);
                if (t.Length == 0) { continue; }
                if (Str.StartsWith(t, "//") || Str.StartsWith(t, "*")
                    || Str.StartsWith(t, "/*")) { continue; }
                string site = f.path + ":" + Convert.ToString(li);
                List<string> ids = RepoMap.Identifiers(raw);
                int k = 0;
                while (k < ids.Count) {
                    string id = ids[k];
                    k = k + 1;
                    if (!byName.ContainsKey(id)) { continue; }
                    int bidx = byName[id];
                    RefBucket b = buckets[bidx];
                    if (RepoMap.Has(b.defs, site)) { continue; }
                    b.total = b.total + 1;
                    if (isTest) { b.tests = b.tests + 1; }
                    if (b.refs.Count < RepoMap.REF_CAP) { b.refs.Add(site); }
                }
            }
        }
        return buckets;
    }

    static int BucketOf(List<RefBucket> buckets, Dictionary<string, int> byName,
                        string name) {
        if (byName.ContainsKey(name)) { return byName[name]; }
        buckets.Add(RefBucket.Create(name));
        int idx = buckets.Count - 1;
        byName[name] = idx;
        return idx;
    }

    static bool Has(List<string> items, string value) {
        int i = 0;
        while (i < items.Count) {
            if (items[i] == value) { return true; }
            i = i + 1;
        }
        return false;
    }

    // 过滤字符与字符串字面量，防止字面文本被误认为符号引用。
    static List<string> Identifiers(string s) {
        List<string> outp = new List<string>();
        int i = 0;
        int n = s.Length;
        while (i < n) {
            string c = s.Substring(i, 1);
            if (c == "\"" || c == "'") {
                string quote = c;
                i = i + 1;
                while (i < n) {
                    string q = s.Substring(i, 1);
                    if (q == "\\") { i = i + 2; continue; }
                    i = i + 1;
                    if (q == quote) { break; }
                }
                continue;
            }
            if (c == "/" && i + 1 < n && s.Substring(i + 1, 1) == "/") { break; }
            if (!Str.IsAlnum(c)) { i = i + 1; continue; }
            int start = i;
            while (i < n && Str.IsAlnum(s.Substring(i, 1))) { i = i + 1; }
            string id = s.Substring(start, i - start);
            string first = id.Substring(0, 1);
            if (Str.Find("0123456789", first, 0) >= 0) { continue; }
            if (!RepoMap.Has(outp, id)) { outp.Add(id); }
        }
        return outp;
    }

    static List<string> SplitCommas(string s) {
        List<string> outp = new List<string>();
        StringBuilder sb = new StringBuilder();
        int i = 0;
        while (i < s.Length) {
            string c = s.Substring(i, 1);
            if (c == ",") { outp.Add(Str.Trim(sb.ToString())); sb = new StringBuilder(); }
            else { sb.Append(c); }
            i = i + 1;
        }
        outp.Add(Str.Trim(sb.ToString()));
        return outp;
    }

    static string LastSegment(string s) {
        int cut = -1;
        int i = 0;
        while (i < s.Length) {
            if (s.Substring(i, 1) == ".") { cut = i; }
            i = i + 1;
        }
        if (cut < 0) { return s; }
        return s.Substring(cut + 1, s.Length - cut - 1);
    }

    static string RenderRefs(List<RefBucket> buckets) {
        StringBuilder sb = new StringBuilder();
        sb.Append("[");
        bool first = true;
        int i = 0;
        while (i < buckets.Count) {
            RefBucket b = buckets[i];
            i = i + 1;
            if (b.defs.Count == 0 && b.subtypes.Count == 0) { continue; }
            if (!first) { sb.Append(","); }
            first = false;
            sb.Append("\n{\"name\":\"");
            sb.Append(Str.JsonEsc(b.name));
            sb.Append("\",\"kinds\":");
            sb.Append(RepoMap.RenderStrArray(b.kinds));
            sb.Append(",\"owners\":");
            sb.Append(RepoMap.RenderStrArray(b.owners));
            sb.Append(",\"defCount\":");
            sb.Append(Convert.ToString(b.defs.Count));
            sb.Append(",\"defs\":");
            sb.Append(RepoMap.RenderCapped(b.defs));
            sb.Append(",\"refCount\":");
            sb.Append(Convert.ToString(b.total));
            sb.Append(",\"testRefs\":");
            sb.Append(Convert.ToString(b.tests));
            sb.Append(",\"refs\":");
            sb.Append(RepoMap.RenderStrArray(b.refs));
            sb.Append(",\"subtypes\":");
            sb.Append(RepoMap.RenderStrArray(b.subtypes));
            sb.Append("}");
        }
        sb.Append("\n]\n");
        return sb.ToString();
    }

    static string RenderCapped(List<string> items) {
        List<string> head = new List<string>();
        int i = 0;
        while (i < items.Count && i < RepoMap.REF_CAP) {
            head.Add(items[i]);
            i = i + 1;
        }
        return RepoMap.RenderStrArray(head);
    }

    static string RenderStrArray(List<string> items) {
        StringBuilder sb = new StringBuilder();
        sb.Append("[");
        int i = 0;
        while (i < items.Count) {
            if (i > 0) { sb.Append(","); }
            sb.Append("\"");
            sb.Append(Str.JsonEsc(items[i]));
            sb.Append("\"");
            i = i + 1;
        }
        sb.Append("]");
        return sb.ToString();
    }

    // 
    static List<string> BuiltinRecords() {
        List<string> r = RepoMap.BuiltinApiRecords();
        if (r.Count > 0) {
            r.Add(RepoMap.BuiltinRec("Json.Serialize", "string Serialize<T>(T obj)"));
            r.Add(RepoMap.BuiltinRec("Json.Deserialize",
                "T Deserialize<T>(string json)"));
            return r;
        }
        r.Add(RepoMap.BuiltinRec("Convert.ToDouble", "double ToDouble(string text)"));
        r.Add(RepoMap.BuiltinRec("Convert.ToInt32", "int ToInt32(string text)"));
        r.Add(RepoMap.BuiltinRec("Convert.ToInt64", "long ToInt64(string text)"));
        r.Add(RepoMap.BuiltinRec("Convert.ToString", "string ToString(object value)"));
        r.Add(RepoMap.BuiltinRec("Task.Spawn", "long Spawn(asyncCall)"));
        r.Add(RepoMap.BuiltinRec("Task.Run", "long Run(asyncCall)"));
        r.Add(RepoMap.BuiltinRec("Task.Delay", "await Task.Delay(long ms)"));
        r.Add(RepoMap.BuiltinRec("Task.WhenAll", "async int WhenAll(List<long> handles)"));
        r.Add(RepoMap.BuiltinRec("Task.WhenAny", "async int WhenAny(List<long> handles)"));
        r.Add(RepoMap.BuiltinRec("Task.IsDone", "int IsDone(long handle)"));
        r.Add(RepoMap.BuiltinRec("Task.Cancel", "void Cancel(long handle)"));
        r.Add(RepoMap.BuiltinRec("Task.IsCancellationRequested",
            "int IsCancellationRequested()"));
        r.Add(RepoMap.BuiltinRec("Json.Serialize", "string Serialize<T>(T obj)"));
        r.Add(RepoMap.BuiltinRec("Json.Deserialize", "T Deserialize<T>(string json)"));
        return r;
    }

    static List<string> BuiltinApiRecords() {
        List<string> outp = new List<string>();
        string rel = "src/compiler/builtin_api.c";
        string path = RepoMap.scanRoot + "/" + rel;
        if (!File.Exists(path)) { path = RepoMap.scanRoot + "/../" + rel; }
        if (!File.Exists(path)) { path = RepoMap.scanRoot + "/../../" + rel; }
        if (!File.Exists(path)) { return outp; }
        List<string> lines = RepoMap.SplitLines(File.ReadAllText(path));

        // BuiltinMemberEntry 强类型实体列表，彻底消除 5 组平行列表
        List<BuiltinMemberEntry> members = new List<BuiltinMemberEntry>();
        string cur = "";
        int i = 0;
        while (i < lines.Count) {
            string t = Str.Trim(lines[i]);
            i = i + 1;
            if (Str.Contains(t, "zan_builtin_member_t") && Str.EndsWith(t, "{")) {
                cur = RepoMap.IdentAfter(t, "members_");
                if (cur.Length > 0) { cur = "members_" + cur; }
                continue;
            }
            if (cur.Length > 0 && Str.StartsWith(t, "}")) { cur = ""; continue; }
            if (cur.Length == 0 || !Str.StartsWith(t, "{")) { continue; }
            List<string> f = RepoMap.CRowFields(t);
            if (f.Count < 3) { continue; }
            members.Add(new BuiltinMemberEntry(cur, f[0], f[1] == "P" ? "property" : "method", f[2], i));
        }

        int j = 0;
        while (j < lines.Count) {
            string t = Str.Trim(lines[j]);
            j = j + 1;
            if (!Str.StartsWith(t, "BT(")) { continue; }
            List<string> f = RepoMap.CRowFields(t);
            if (f.Count < 5) { continue; }
            string pub = f[1];
            string disp = f[2];
            string arr = f[4];
            if (pub.Length == 0 || arr.Length == 0) { continue; }
            outp.Add(RepoMap.BuiltinTypeRec(pub, disp, rel, j));
            int k = 0;
            while (k < members.Count) {
                BuiltinMemberEntry m = members[k];
                if (m.arr == arr) {
                    outp.Add(RepoMap.BuiltinMemberRec(pub + "." + m.name,
                        pub, m.kind, m.sig, rel, m.line));
                }
                k = k + 1;
            }
        }
        return outp;
    }

    static List<string> CRowFields(string t) {
        List<string> outp = new List<string>();
        int depth = 0;
        int i = 0;
        while (i < t.Length) {
            string c = t.Substring(i, 1);
            if (c == "\"" || c == "'") {
                int end = Str.Find(t, c, i + 1);
                if (end < 0) { break; }
                outp.Add(t.Substring(i + 1, end - i - 1));
                i = end + 1;
                continue;
            }
            if (Str.IsAlnum(c)) {
                int s = i;
                while (i < t.Length && Str.IsAlnum(t.Substring(i, 1))) { i = i + 1; }
                string word = t.Substring(s, i - s);
                if (word != "BT") { outp.Add(word); }
                continue;
            }
            i = i + 1;
        }
        return outp;
    }

    static string BuiltinTypeRec(string name, string disp, string file, int line) {
        return "{\"name\":\"" + Str.JsonEsc(name) + "\",\"kind\":\"class\""
            + ",\"owner\":\"\",\"ns\":\"\",\"file\":\"" + Str.JsonEsc(file)
            + "\",\"line\":" + Convert.ToString(line) + ",\"sig\":\""
            + Str.JsonEsc(disp) + "\",\"ext\":\"\",\"doc\":\""
            + "compiler builtin; no stdlib source\"}";
    }

    static string BuiltinMemberRec(string name, string owner, string kind,
                                   string sig, string file, int line) {
        return "{\"name\":\"" + Str.JsonEsc(name) + "\",\"kind\":\""
            + Str.JsonEsc(kind) + "\",\"owner\":\"" + Str.JsonEsc(owner)
            + "\",\"ns\":\"\",\"file\":\"" + Str.JsonEsc(file) + "\",\"line\":"
            + Convert.ToString(line) + ",\"sig\":\"" + Str.JsonEsc(sig)
            + "\",\"ext\":\"\",\"doc\":\"compiler builtin\"}";
    }

    static string BuiltinRec(string name, string sig) {
        return "{\"name\":\"" + Str.JsonEsc(name) + "\",\"kind\":\"method\""
            + ",\"file\":\"<compiler-builtin>\",\"line\":0,\"sig\":\""
            + Str.JsonEsc(sig) + "\"}";
    }


    static int lastRouteCount;

    static string RenderRoutes(string controllerDir) {
        StringBuilder sb = new StringBuilder();
        sb.Append("[");
        List<string> rows = new List<string>();
        RepoMap.ScanControllers(controllerDir, "", rows);
        int i = 0;
        while (i < rows.Count) {
            if (i > 0) { sb.Append(","); }
            sb.Append("\n");
            sb.Append(rows[i]);
            i = i + 1;
        }
        sb.Append("\n]\n");
        RepoMap.lastRouteCount = rows.Count;
        return sb.ToString();
    }

    static void ScanControllers(string dir, string prefix, List<string> rows) {
        if (!Directory.Exists(dir)) { return; }
        List<string> fs = Directory.GetFiles(dir);
        int i = 0;
        while (i < fs.Count) {
            string fn = fs[i];
            i = i + 1;
            if (Str.EndsWith(fn, ".zan")) {
                RepoMap.ScanControllerFile(dir + "/" + fn, prefix, rows);
            }
        }
        List<string> subs = Directory.GetDirectories(dir);
        int j = 0;
        while (j < subs.Count) {
            string sd = subs[j];
            j = j + 1;
            RepoMap.ScanControllers(dir + "/" + sd, prefix + Str.Lower(sd) + "/", rows);
        }
    }

    // class.
    static void ScanControllerFile(string path, string prefix, List<string> rows) {
        List<string> lines = RepoMap.SplitLines(File.ReadAllText(path));
        string cbase = "";
        string controller = "";
        string classRoute = "";
        string classAuth = "";
        string verb = "";
        string routePath = "";
        string title = "";
        string auth = "";
        int i = 0;
        while (i < lines.Count) {
            string t = Str.Trim(lines[i]);
            i = i + 1;
            if (t.Length == 0 || Str.StartsWith(t, "//") || Str.StartsWith(t, "*")) {
                continue;
            }
            if (Str.StartsWith(t, "[")) {
                string a = RepoMap.AttrName(t);
                if (a == "HttpGet" || a == "Get") { verb = "GET"; }
                else if (a == "HttpPost" || a == "Post") { verb = "POST"; }
                else if (a == "HttpPut" || a == "Put") { verb = "PUT"; }
                else if (a == "HttpDelete" || a == "Delete") { verb = "DELETE"; }
                else if (a == "HttpPatch" || a == "Patch") { verb = "PATCH"; }
                else if (a == "Route") { routePath = Str.FirstQuoted(t); }
                else if (a == "Description" || a == "Title") { title = Str.FirstQuoted(t); }
                else if (a == "Custom") { auth = RepoMap.AuthOf(t); }
                else if (a == "Login") { auth = "Login"; }
                else if (a == "Auth") { auth = "Auth"; }
                continue;
            }
            if (Str.Word(t, "class")) {
                controller = RepoMap.IdentAfter(t, "class");
                cbase = RepoMap.ControllerBase(controller);
                classRoute = routePath;
                classAuth = auth;
                verb = ""; routePath = ""; title = ""; auth = "";
                continue;
            }
            int lp = Str.Find(t, "(", 0);
            if (lp > 0 && controller.Length > 0 && (verb.Length > 0 || routePath.Length > 0)) {
                string m = RepoMap.NameBefore(t, lp);
                if (m.Length > 0) {
                    string v = verb;
                    if (v.Length == 0) { v = "GET"; }
                    string tpl = routePath;
                    if (tpl.Length == 0) { tpl = classRoute; }
                    string pth = "";
                    if (tpl.Length == 0) {
                        pth = RepoMap.ConventionPath(prefix, cbase, m);
                    } else {
                        pth = RepoMap.ExpandRoute(tpl, cbase, m);
                    }
                    string ga = auth;
                    if (ga.Length == 0) { ga = classAuth; }
                    if (ga.Length == 0) { ga = "Unknown"; }
                    StringBuilder r = new StringBuilder();
                    r.Append("{\"method\":\"");
                    r.Append(v);
                    r.Append("\",\"path\":\"");
                    r.Append(Str.JsonEsc(pth));
                    r.Append("\",\"action\":\"");
                    r.Append(Str.JsonEsc(controller + "." + m));
                    r.Append("\",\"title\":\"");
                    r.Append(Str.JsonEsc(title));
                    r.Append("\",\"auth\":\"");
                    r.Append(Str.JsonEsc(ga));
                    r.Append("\"}");
                    rows.Add(r.ToString());
                }
            }
            verb = ""; routePath = ""; title = ""; auth = "";
        }
    }

    static string AuthOf(string line) {
        string key = "CustomAuthorization.";
        int p = Str.Find(line, key, 0);
        if (p < 0) { return ""; }
        int i = p + key.Length;
        StringBuilder sb = new StringBuilder();
        while (i < line.Length) {
            string c = line.Substring(i, 1);
            if (!Str.IsAlnum(c)) { break; }
            sb.Append(c);
            i = i + 1;
        }
        return sb.ToString();
    }

    static string ExpandRoute(string tpl, string cbase, string method) {
        StringBuilder sb = new StringBuilder();
        int i = 0;
        while (i < tpl.Length) {
            if (i + 12 <= tpl.Length && tpl.Substring(i, 12) == "[controller]") {
                sb.Append(cbase);
                i = i + 12;
                continue;
            }
            if (i + 8 <= tpl.Length && tpl.Substring(i, 8) == "[action]") {
                sb.Append(Str.Lower(method));
                i = i + 8;
                continue;
            }
            sb.Append(tpl.Substring(i, 1));
            i = i + 1;
        }
        string p = sb.ToString();
        if (Str.StartsWith(p, "/")) { return p; }
        return "/" + p;
    }

    static string AttrName(string line) {
        int a = Str.Find(line, "[", 0);
        if (a < 0) { return ""; }
        int i = a + 1;
        StringBuilder sb = new StringBuilder();
        while (i < line.Length) {
            string c = line.Substring(i, 1);
            if (c == "(" || c == "]" || c == " ") { return sb.ToString(); }
            sb.Append(c);
            i = i + 1;
        }
        return sb.ToString();
    }

    static string ControllerBase(string controller) {
        string b = controller;
        if (Str.EndsWith(b, "Controller")) { b = b.Substring(0, b.Length - 10); }
        return Str.Lower(b);
    }

    static string ConventionPath(string prefix, string cbase, string method) {
        string m = Str.Lower(method);
        if (m == "index") { return "/" + prefix + cbase; }
        return "/" + prefix + cbase + "/" + m;
    }

    static List<CallNode> BuildCallGraph(List<FileInfo> files) {
        List<CallNode> nodes = new List<CallNode>();
        Dictionary<string, int> knownIds = new Dictionary<string, int>();
        Dictionary<string, List<CallNode>> fileToMethods = new Dictionary<string, List<CallNode>>();

        int fi = 0;
        while (fi < files.Count) {
            FileInfo f = files[fi];
            fi = fi + 1;
            string owner = "";
            List<CallNode> curFileMethods = new List<CallNode>();
            fileToMethods[f.path] = curFileMethods;

            int si = 0;
            while (si < f.syms.Count) {
                Sym s = f.syms[si];
                si = si + 1;
                if (s.kind == "class" || s.kind == "struct" || s.kind == "interface") {
                    owner = s.name;
                } else if (s.kind == "method" || s.kind == "function") {
                    string full = s.name;
                    if (owner.Length > 0) { full = owner + "." + s.name; }
                    CallNode node = CallNode.Create(full, s.name, owner, f.path, s.line, s.sig);
                    nodes.Add(node);
                    curFileMethods.Add(node);
                    knownIds[full] = 1;
                }
            }
        }

        fi = 0;
        while (fi < files.Count) {
            FileInfo f = files[fi];
            fi = fi + 1;
            List<CallNode> fileMethods = fileToMethods[f.path];
            if (fileMethods.Count == 0) { continue; }

            string text = File.ReadAllText(f.abs);
            List<string> lines = RepoMap.SplitLines(text);

            CallNode currentMethod = null;
            int methodCursor = 0;
            int li = 0;
            while (li < lines.Count) {
                string line = Str.Trim(lines[li]);
                int lineNum = li + 1;
                li = li + 1;

                while (methodCursor < fileMethods.Count && fileMethods[methodCursor].line <= lineNum) {
                    currentMethod = fileMethods[methodCursor];
                    methodCursor = methodCursor + 1;
                }

                if (line.Length == 0 || Str.StartsWith(line, "//") || Str.StartsWith(line, "/*") || Str.StartsWith(line, "*")) {
                    continue;
                }

                if (currentMethod == null) { continue; }

                RepoMap.ExtractCallsInLine(line, currentMethod, knownIds);
            }
        }

        Dictionary<string, CallNode> nodeById = new Dictionary<string, CallNode>();
        int ni = 0;
        while (ni < nodes.Count) {
            nodeById[nodes[ni].id] = nodes[ni];
            ni = ni + 1;
        }

        ni = 0;
        while (ni < nodes.Count) {
            CallNode caller = nodes[ni];
            ni = ni + 1;
            int ci = 0;
            while (ci < caller.callees.Count) {
                string calleeId = caller.callees[ci];
                ci = ci + 1;
                if (nodeById.ContainsKey(calleeId)) {
                    CallNode calleeNode = nodeById[calleeId];
                    CallNode.AddUnique(calleeNode.callers, caller.id);
                }
            }
        }

        return nodes;
    }

    static void ExtractCallsInLine(string line, CallNode currentMethod, Dictionary<string, int> knownIds) {
        int i = 0;
        while (i < line.Length) {
            int p = Str.Find(line, "(", i);
            if (p < 0) { break; }
            i = p + 1;

            string name = RepoMap.NameBefore(line, p);
            if (name.Length == 0) { continue; }
            if (name == "if" || name == "while" || name == "for" || name == "switch" || name == "catch" || name == "return" || name == "typeof" || name == "sizeof") {
                continue;
            }

            int pos = p - 1;
            while (pos >= 0 && Str.IsSpace(line.Substring(pos, 1))) { pos = pos - 1; }
            pos = pos - name.Length;

            string receiver = "";
            if (pos >= 0 && line.Substring(pos, 1) == ".") {
                receiver = RepoMap.NameBefore(line, pos);
            }

            string targetId = "";
            if (receiver.Length > 0 && receiver != "this") {
                targetId = receiver + "." + name;
            } else if (currentMethod.owner.Length > 0) {
                targetId = currentMethod.owner + "." + name;
            } else {
                targetId = name;
            }

            if (knownIds.ContainsKey(targetId) && targetId != currentMethod.id) {
                CallNode.AddUnique(currentMethod.callees, targetId);
            }
        }
    }

    static string RenderCallGraph(List<CallNode> nodes) {
        StringBuilder sb = new StringBuilder();
        sb.Append("{\n  \"totalNodes\": ");
        sb.Append(Convert.ToString(nodes.Count));
        sb.Append(",\n  \"nodes\": [\n");
        int i = 0;
        while (i < nodes.Count) {
            if (i > 0) { sb.Append(",\n"); }
            CallNode n = nodes[i];
            i = i + 1;
            sb.Append("    {\n");
            sb.Append("      \"id\": \"");
            sb.Append(Str.JsonEsc(n.id));
            sb.Append("\",\n      \"name\": \"");
            sb.Append(Str.JsonEsc(n.name));
            sb.Append("\",\n      \"owner\": \"");
            sb.Append(Str.JsonEsc(n.owner));
            sb.Append("\",\n      \"file\": \"");
            sb.Append(Str.JsonEsc(n.file));
            sb.Append("\",\n      \"line\": ");
            sb.Append(Convert.ToString(n.line));
            sb.Append(",\n      \"sig\": \"");
            sb.Append(Str.JsonEsc(n.sig));
            sb.Append("\",\n      \"callees\": ");
            sb.Append(RepoMap.RenderStrArray(n.callees));
            sb.Append(",\n      \"callers\": ");
            sb.Append(RepoMap.RenderStrArray(n.callers));
            sb.Append("\n    }");
        }
        sb.Append("\n  ]\n}\n");
        return sb.ToString();
    }

    static string RenderCallGraphJsonl(List<CallNode> nodes) {
        StringBuilder sb = new StringBuilder();
        int i = 0;
        while (i < nodes.Count) {
            CallNode n = nodes[i];
            i = i + 1;
            sb.Append("{\"id\":\"");
            sb.Append(Str.JsonEsc(n.id));
            sb.Append("\",\"name\":\"");
            sb.Append(Str.JsonEsc(n.name));
            sb.Append("\",\"owner\":\"");
            sb.Append(Str.JsonEsc(n.owner));
            sb.Append("\",\"file\":\"");
            sb.Append(Str.JsonEsc(n.file));
            sb.Append("\",\"line\":");
            sb.Append(Convert.ToString(n.line));
            sb.Append(",\"sig\":\"");
            sb.Append(Str.JsonEsc(n.sig));
            sb.Append("\",\"callees\":");
            sb.Append(RepoMap.RenderStrArray(n.callees));
            sb.Append(",\"callers\":");
            sb.Append(RepoMap.RenderStrArray(n.callers));
            sb.Append("}\n");
        }
        return sb.ToString();
    }
}
