// ZanIndex -- 项目语义索引生成器(路由 / ORM 实体 / 清单)。
//
// 与 tools/repomap 分工:RepoMap 只做文本扫描(符号大纲、引用、路由近似),
// 不需要编译器;ZanIndex 吃 `zanc --gen-meta` 的单元元数据,给出与编译器
// 生成代码同源的精确结果(路由路径/Perm/参数、实体列/表名/门面名)。索引
// 逻辑本体在 stdlib 的 System.Compiler.GenIndex,编译期的 ZanGen 走同一份。
//
//   Build: zanc tools/zanindex/ZanIndex.zan --auto-stdlib -o build/zanindex.exe
//   Run  : zanc <项目入口> --auto-stdlib --gen-meta .zanmap/meta.json
//          zanindex.exe .zanmap/meta.json --out .zanmap [--base <项目根>]
using System;
using System.IO;
using System.Json;
using System.Compiler;

namespace ZanIndex;

class Program {
    static int Main() {
        string meta = "";
        string outDir = "";
        string baseDir = "";
        int i = 0;
        while (i < Environment.ArgCount()) {
            string a = Environment.ArgAt(i);
            i = i + 1;
            if (a == "--out") {
                if (i < Environment.ArgCount()) {
                    outDir = Environment.ArgAt(i);
                    i = i + 1;
                }
            } else if (a == "--base") {
                if (i < Environment.ArgCount()) {
                    baseDir = Environment.ArgAt(i);
                    i = i + 1;
                }
            } else if (!a.StartsWith("--")) {
                if (meta.Length == 0) { meta = a; }
            }
        }
        if (meta.Length == 0) {
            Console.WriteLine("zanindex: usage: zanindex <meta.json> [--out <dir>]"
                + " [--base <project-root>]");
            Console.WriteLine("  meta.json comes from: zanc <entry> --auto-stdlib"
                + " --gen-meta <meta.json>");
            Console.WriteLine("  --base trims that prefix off indexed paths, so"
                + " absolute compiler inputs still yield project-relative hits");
            return 2;
        }
        if (!File.Exists(meta)) {
            Console.WriteLine("zanindex: no such metadata file: " + meta);
            return 2;
        }
        if (outDir.Length == 0) { outDir = ".zanmap"; }

        JsonValue unit = JsonValue.Parse(File.ReadAllText(meta));
        GenIndex.Base = baseDir;
        int routes = GenIndex.WriteTo(unit, outDir);
        JsonValue manifest = JsonValue.Parse(
            File.ReadAllText(outDir + "/index.json"));
        Console.WriteLine("[zanindex] " + Convert.ToString(routes) + " routes, "
            + Convert.ToString(manifest.Int("entities", 0)) + " entities, "
            + Convert.ToString(manifest.Int("sourceFiles", 0)) + " files -> "
            + outDir + "/");
        return 0;
    }
}
