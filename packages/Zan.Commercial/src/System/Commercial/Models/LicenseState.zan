using System;
using System.IO;
using System.Json;
using System.Management;
using System.Net.External;
using System.Net.Http.Client;
using System.Net.Sockets;
using System.Security.Cryptography;

class LicenseState {
    public LicenseState() {
        this.mode = "";
        this.product = "";
        this.subject = "";
        this.deviceFp = "";
        this.sessionToken = "";
        this.salt = "";
        this.mac = "";
        this.certSig = "";
    }

    // account / code / signed / online（登录/激活时服务端下发）。
    public string mode;
    // 产品标识（防状态文件拷给别的产品）。
    public string product;
    // 授权主体（账号名或激活码尾号，展示用）。
    public string subject;
    // 激活时绑定的本机指纹（重绑由服务端解绑）。
    public string deviceFp;
    // 会话令牌（服务端可吊销；本地只存，不签发）。
    public string sessionToken;
    // 状态 HMAC 的盐（随机生成落盘；密钥由本机因子派生不落盘）。
    public string salt;
    // 状态 HMAC-SHA256（hex）。缺失/不符 = 状态被篡改或跨机拷贝。
    public string mac;
    // signed 模式的离线证书签名（hex，发行方 RSA 私钥签发）。
    public string certSig;
    // 授权到期 epoch 秒；0 = 终身。
    public long expiresAt;
    // 掉线宽限秒数（服务端策略下发）。
    public int graceSeconds;
    // 最后一次成功心跳的 epoch 秒。
    public long lastHeartbeat;
}
