using System;
using System.IO;
using System.Json;
using System.Management;
using System.Net.External;
using System.Net.Http.Client;
using System.Net.Sockets;
using System.Security.Cryptography;

namespace System.Commercial;

/// <summary>授权校验结果（在线模式）。</summary>
class LicenseCheckResult {
    /// true = 已授权可用。
    public bool ok;
    /// 不可用的原因（供应用显示）：no_license / expired / device_mismatch
    /// / seat_limit / network_fail / server_reject / bad_state。
    public string reason;
    /// 服务端下发的续期窗口（秒）——该窗口内离线仍可用（online 模式）。
    public int graceSeconds;
    /// 授权到期（epoch 秒；0 = 不限/终身）。
    public long expiresAt;
    /// 可读一句话（ok=false 时的建议动作）。
    public string message;

    static LicenseCheckResult Fail(string why, string msg) {
        LicenseCheckResult r = new LicenseCheckResult();
        r.ok = false;
        r.reason = why;
        r.message = msg;
        return r;
    }
}

/// <summary>Zan 商业软件授权客户端（官方基础模板，C 端成品软件接
/// 入用）。与授权服务端模板（templates/server/server-licensing）配对：
///
///   授权模式 licenseMode（服务端签发决定，客户端只认结果）：
///     account  —— 账号密码登录授权（按用户，不限设备或按 seat 数限终端）
///     code     —— 激活码激活（按码授权，可绑设备）
///     signed   —— 离线证书（RSA 验签，发布前签好，全程无网可用）
///     online   —— 在线会话：登录/激活后由服务端发放会话令牌，
///                 客户端静默心跳续期；掉线进入宽限期，超期回落
///
///   有效期 period：服务端在授权里下发 expiresAt（epoch 秒，0=终身）；
///   月/季/年只是服务端签发时算好的到期时间，客户端不区分档位。
///
///   终端数：account/online 模式服务端按 seatLimit 管理并发在线座位
///   （心跳即座位占用；超限拒绝并提示）；code 模式可绑定 deviceFp。
///
/// 用法（约五行接入）：
///   LicenseClient lic = LicenseClient.Shared();
///   lic.Server("http://127.0.0.1:8095", "ZanSoft");
///   lic.Product("my-app");
///   LicenseCheckResult r = await lic.Check();
///   if (!r.ok) { Console.WriteLine(r.message); return; }
///
/// 状态持久化在用户目录下（默认 ~/.zan-license/<product>/license.json），
/// 剥离即回到未激活。SDK 从不通过网络传输任何明文密码——账号模式
/// 只上送服务端校验后的会话令牌。所有网络失败都返回结果对象而非
/// 抛异常，宿主程序绝不因授权探测崩溃。</summary>
class LicenseClient {
    /// 授权服务端地址（http(s)://host[:port]）。
    string serverUrl;
    /// 厂商名（状态目录隔离 + 展示用）。
    string vendor;
    /// 产品标识（授权服务端按此签发）。
    string product;
    /// 已加载的持久状态（null = 未加载）。
    LicenseState state;

    static LicenseClient shared;

    /// 进程级共享客户端（绝大多数成品软件只用一个授权）。
    static LicenseClient Shared() {
        if (LicenseClient.shared == null) { LicenseClient.shared = new LicenseClient(); }
        return LicenseClient.shared;
    }

    /// 授权服务端地址与厂商名（须与授权服务端部署一致）。
    void Server(string url, string vendorName) {
        this.serverUrl = url;
        while (this.serverUrl.Length > 0
            && this.serverUrl.Substring(this.serverUrl.Length - 1, 1) == "/") {
            this.serverUrl = this.serverUrl.Substring(0, this.serverUrl.Length - 1);
        }
        this.vendor = vendorName;
    }

    /// 产品标识。
    void Product(string productId) {
        this.product = productId;
    }

    // ---- 本机指纹（隐私纪律：只传哈希，不传原始主机/用户名） ----

    /// 本机指纹：用户名 + 机器名的 SHA-256 前 16 hex。服务端只见这个
    /// 稳定哈希，拿不到原始主机信息；重装系统/换用户名才会变。
    string DeviceFp() {
        string raw = KnownFolders.UserName() + "@"
            + SystemInfo.ComputerName();
        return Hex.Encode(Sha256.Hash(raw, raw.Length), 32).Substring(0, 16);
    }

    /// 本机指纹（宿主程序展示"绑定设备"信息用）。
    public string Fingerprint() { return this.DeviceFp(); }

    /// 本地授权状态文件路径（复位说明/诊断展示用）。
    public string StateFile() { return this.StatePath(); }

    // ---- 状态持久化 ----

    /// 状态文件目录：~/.zan-license/<vendor>/<product>/（可整体删除复位）。
    string StateDir() {
        string vendorDir = this.vendor.Length > 0 ? this.vendor : "default";
        string productDir = this.product.Length > 0 ? this.product : "app";
        return KnownFolders.Home() + "/.zan-license/" + vendorDir
            + "/" + productDir;
    }

    string StatePath() { return this.StateDir() + "/license.json"; }

    /// 载入持久状态；文件缺失/损坏返回空状态（调用方读 .ok 判断）。
    void EnsureLoaded() {
        if (this.state != null) { return; }
        this.state = new LicenseState();
        try {
            if (File.Exists(this.StatePath())) {
                JsonValue o = JsonValue.ParseLenient(
                    File.ReadAllText(this.StatePath()));
                if (o != null && o.IsObject()) {
                    this.state.mode = o.Str("mode", "");
                    this.state.product = o.Str("product", "");
                    this.state.subject = o.Str("subject", "");
                    this.state.deviceFp = o.Str("device_fp", "");
                    this.state.sessionToken = o.Str("session", "");
                    this.state.expiresAt = o.Long("expires_at", 0);
                    this.state.graceSeconds = o.Int("grace_seconds", 0);
                    this.state.lastHeartbeat = o.Long("last_seen", 0);
                }
            }
        } catch (Exception ex) {
            // 状态读不出 = 未激活；不能让坏文件挡住启动。
        }
    }

    /// 把当前状态写回磁盘；失败静默（最坏情况是重新激活一次）。
    void Persist() {
        try {
            Directory.CreateDirectoryRecursive(this.StateDir());
            JsonValue o = JsonValue.NewObject();
            o.Put("mode", JsonValue.NewStr(this.state.mode));
            o.Put("product", JsonValue.NewStr(this.state.product));
            o.Put("subject", JsonValue.NewStr(this.state.subject));
            o.Put("device_fp", JsonValue.NewStr(this.state.deviceFp));
            o.Put("session", JsonValue.NewStr(this.state.sessionToken));
            o.Put("expires_at", JsonValue.NewNum(
                Convert.ToString(this.state.expiresAt)));
            o.Put("grace_seconds", JsonValue.NewNum(
                Convert.ToString(this.state.graceSeconds)));
            o.Put("last_seen", JsonValue.NewNum(
                Convert.ToString(this.state.lastHeartbeat)));
            File.WriteAllText(this.StatePath(), o.ToJson());
        } catch (Exception ex) {
            // 持久化失败不影响本次校验结论。
        }
    }

    /// 清除本地状态（登出/注销用）。
    void Forget() {
        this.state = new LicenseState();
        try { File.Delete(this.StatePath()); } catch (Exception ex) { }
    }

    // ---- 对外动作 ----

    /// <summary>激活码激活。成功后本地持有签发的会话，之后 Check()
    /// 走 online 心跳；服务端拒绝（错码/用尽/终端超限）返回原因。</summary>
    async LicenseCheckResult Activate(string code) {
        return await this.PostActivate(code, "");
    }

    /// <summary>账号密码登录授权。服务端校验密码（本方法不传原密码——
    /// 改用 /api/license/login 在服务端换会话），按账号可用授权签发。
    /// 本客户端仅上送账号名+密码给服务端专用端点，服务端返回会话。</summary>
    async LicenseCheckResult Login(string account, string password) {
        return await this.PostLogin(account, password);
    }

    /// <summary>总校验入口：启动时与需要时调用。本地有效即放行
    /// （online 模式带最后心跳+宽限期），否则联网复检。绝不抛异常。</summary>
    async LicenseCheckResult Check() {
        this.EnsureLoaded();
        long now = DateTime.UtcNow().ToUnixSeconds();
        // 1) 本地状态检查：产品一致 + 未过期。
        if (this.state.mode.Length > 0 && this.state.product == this.product) {
            if (this.state.expiresAt != 0 && this.state.expiresAt <= now) {
                return LicenseCheckResult.Fail("expired",
                    "授权已过期（到期时间见服务端），请续费或更换授权");
            }
            if (this.state.deviceFp.Length > 0
                && this.state.deviceFp != this.DeviceFp()) {
                return LicenseCheckResult.Fail("device_mismatch",
                    "授权绑定在其他设备，请在服务端解绑后重新激活");
            }
            // signed 证书模式：本地有效即可用（离线软件）。
            if (this.state.mode == "signed") {
                return this.OkResult(now);
            }
            // account/code/online：本地在宽限期内放行并后台复检。
            if (this.state.mode == "online" || this.state.mode == "account"
                || this.state.mode == "code") {
                long deadline = (this.state.lastHeartbeat > 0
                        ? this.state.lastHeartbeat : now)
                    + (long)(this.state.graceSeconds > 0
                        ? this.state.graceSeconds : 86400);
                if (now <= deadline) {
                    return this.OkResult(now);
                }
            }
        }
        // 2) 本地缺状态/超宽限：有会话令牌就静默心跳续期。
        if (this.state.sessionToken.Length > 0) {
            LicenseCheckResult r = await this.Heartbeat(true);
            if (r.ok) { return r; }
            return LicenseCheckResult.Fail("network_fail",
                "无法连接授权服务端确认授权，请检查网络后重试");
        }
        return LicenseCheckResult.Fail("no_license",
            "尚未激活：请登录账号或输入激活码");
    }

    /// <summary>立即向服务端心跳一次（在线座位占用）。返回服务端结论。</summary>
    async LicenseCheckResult Heartbeat() {
        return await this.Heartbeat(false);
    }

    /// <summary>登出并清除本地状态（account/online 模式用）。释放座位的
    /// 通知是尽力而为：Zan 的 HTTP 客户端是 async 通道，同步方法里无法
    /// 等待其完成——通知失败只是座位等心跳过期，不影响本地清理。</summary>
    void Logout() {
        this.EnsureLoaded();
        this.Forget();
    }

    // ---- 结果构造 ----

    LicenseCheckResult OkResult(long now) {
        LicenseCheckResult r = new LicenseCheckResult();
        r.ok = true;
        r.reason = "";
        r.expiresAt = this.state.expiresAt;
        r.graceSeconds = this.state.graceSeconds;
        r.message = "";
        return r;
    }

    // ---- 网络（全部返回结果对象，不抛异常） ----

    /// 会话心跳：带 session 调 /api/license/heartbeat，服务端校验座位
    /// 与有效期并回发续期窗口；返回的 JSON 即服务端模板的响应契约。
    async LicenseCheckResult Heartbeat(bool quiet) {
        try {
            JsonValue req = JsonValue.NewObject();
            req.Put("product", JsonValue.NewStr(this.product));
            req.Put("device_fp", JsonValue.NewStr(this.DeviceFp()));
            req.Put("session", JsonValue.NewStr(this.state.sessionToken));
            string body = await this.PostJson("/api/license/heartbeat",
                req.ToJson());
            if (body.Length == 0) {
                return LicenseCheckResult.Fail("network_fail",
                    quiet ? "" : "授权服务端不可达");
            }
            JsonValue env = JsonValue.ParseLenient(body);
            if (env == null || !env.IsObject()) {
                return LicenseCheckResult.Fail("server_reject",
                    quiet ? "" : "授权服务端响应异常");
            }
            string code = env.Str("code", "");
            JsonValue data = env.Get("data");
            if (code == "0000" && data != null && data.IsObject()) {
                this.state.mode = data.Str("mode", this.state.mode);
                this.state.expiresAt = data.Long("expires_at", 0);
                this.state.graceSeconds = data.Int("grace_seconds",
                    this.state.graceSeconds);
                this.state.lastHeartbeat = DateTime.UtcNow().ToUnixSeconds();
                if (data.Str("session", "").Length > 0) {
                    this.state.sessionToken = data.Str("session", "");
                }
                this.Persist();
                if (this.state.expiresAt != 0
                    && this.state.expiresAt <= DateTime.UtcNow().ToUnixSeconds()) {
                    return LicenseCheckResult.Fail("expired",
                        "授权已过期，请续费或更换授权");
                }
                return this.OkResult(DateTime.UtcNow().ToUnixSeconds());
            }
            string msg = env.Str("msg", "授权校验被拒绝");
            return LicenseCheckResult.Fail("server_reject", msg);
        } catch (Exception ex) {
            return LicenseCheckResult.Fail("network_fail",
                quiet ? "" : "网络异常：" + ex.Message);
        }
    }

    async LicenseCheckResult PostActivate(string code, string unused) {
        try {
            JsonValue req = JsonValue.NewObject();
            req.Put("product", JsonValue.NewStr(this.product));
            req.Put("code", JsonValue.NewStr(code));
            req.Put("device_fp", JsonValue.NewStr(this.DeviceFp()));
            string body = await this.PostJson("/api/license/activate",
                req.ToJson());
            if (body.Length == 0) {
                return LicenseCheckResult.Fail("network_fail",
                    "无法连接授权服务端");
            }
            JsonValue env = JsonValue.ParseLenient(body);
            string code2 = env == null ? "" : env.Str("code", "");
            JsonValue d = env != null && code2 == "0000" ? env.Get("data") : null;
            if (d != null && d.IsObject()) {
                this.state = new LicenseState();
                this.state.mode = d.Str("mode", "code");
                this.state.product = this.product;
                this.state.subject = d.Str("subject", "");
                this.state.deviceFp = this.DeviceFp();
                this.state.sessionToken = d.Str("session", "");
                this.state.expiresAt = d.Long("expires_at", 0);
                this.state.graceSeconds = d.Int("grace_seconds", 86400);
                this.state.lastHeartbeat = DateTime.UtcNow().ToUnixSeconds();
                this.Persist();
                return this.OkResult(DateTime.UtcNow().ToUnixSeconds());
            }
            string msg = env == null ? "激活失败" : env.Str("msg", "激活失败");
            return LicenseCheckResult.Fail("server_reject", msg);
        } catch (Exception ex) {
            return LicenseCheckResult.Fail("network_fail",
                "网络异常：" + ex.Message);
        }
    }

    async LicenseCheckResult PostLogin(string account, string password) {
        try {
            JsonValue req = JsonValue.NewObject();
            req.Put("product", JsonValue.NewStr(this.product));
            req.Put("account", JsonValue.NewStr(account));
            req.Put("password", JsonValue.NewStr(password));
            req.Put("device_fp", JsonValue.NewStr(this.DeviceFp()));
            string body = await this.PostJson("/api/license/login",
                req.ToJson());
            if (body.Length == 0) {
                return LicenseCheckResult.Fail("network_fail",
                    "无法连接授权服务端");
            }
            JsonValue env = JsonValue.ParseLenient(body);
            string code2 = env == null ? "" : env.Str("code", "");
            JsonValue d = env != null && code2 == "0000" ? env.Get("data") : null;
            if (d != null && d.IsObject()) {
                this.state = new LicenseState();
                this.state.mode = d.Str("mode", "account");
                this.state.product = this.product;
                this.state.subject = account;
                this.state.deviceFp = this.DeviceFp();
                this.state.sessionToken = d.Str("session", "");
                this.state.expiresAt = d.Long("expires_at", 0);
                this.state.graceSeconds = d.Int("grace_seconds", 86400);
                this.state.lastHeartbeat = DateTime.UtcNow().ToUnixSeconds();
                this.Persist();
                return this.OkResult(DateTime.UtcNow().ToUnixSeconds());
            }
            string msg = env == null ? "登录失败" : env.Str("msg", "登录失败");
            return LicenseCheckResult.Fail("server_reject", msg);
        } catch (Exception ex) {
            return LicenseCheckResult.Fail("network_fail",
                "网络异常：" + ex.Message);
        }
    }

    /// POST JSON 的公共通道：设置 Content-Type、超时预算，返回响应
    /// 正文；连接失败/非 2xx 返回空串（调用方按 network_fail 处理）。
    async string PostJson(string path, string json) {
        Socket.Initialize();
        ExternalTarget t = ExternalTarget.Parse(this.serverUrl);
        if (t == null) { return ""; }
        HttpClient cli;
        if (t.scheme == "https") {
            cli = HttpClient.CreateHttps(t.Host(), t.Port());
        } else {
            cli = new HttpClient(t.Host(), t.Port());
        }
        ExternalCallPolicy policy = ExternalCallPolicy.Default()
            .TotalTimeout(15000)
            .ResponseLimit(4 * 1024 * 1024)
            .Redirects(0)
            .RetryNetwork(false)
            .RetryAttempts(0);
        if (ExternalTargetPolicy.IsLoopback(t.Host())) { policy.AllowLocalHttp(); }
        cli.SetCallPolicy(policy);
        cli.SetTimeout(15000);
        cli.SetHeader("Content-Type", "application/json");
        HttpResponse resp = await cli.SendBytesAsync("POST", path, json);
        if (resp.statusCode < 200 || resp.statusCode >= 300) { return ""; }
        return resp.body;
    }

    /// <summary>在线登出：通知服务端释放座位后清本地状态。UI 侧有
    /// 协程上下文时用这个；控制台一次性脚本用同步 Logout() 即可。</summary>
    async LicenseCheckResult LogoutOnline() {
        this.EnsureLoaded();
        LicenseCheckResult r = new LicenseCheckResult();
        r.ok = true;
        if (this.state.sessionToken.Length > 0) {
            JsonValue req = JsonValue.NewObject();
            req.Put("product", JsonValue.NewStr(this.product));
            req.Put("session", JsonValue.NewStr(this.state.sessionToken));
            try {
                string body = await this.PostJson("/api/license/logout",
                    req.ToJson());
                if (body.Length == 0) { r.ok = false; r.reason = "network_fail"; }
            } catch (Exception ex) {
                r.ok = false;
                r.reason = "network_fail";
            }
        }
        this.Forget();
        r.message = r.ok ? "已登出，本地授权已清除"
            : "服务端暂不可达，本地授权已清除（座位等心跳过期）";
        return r;
    }
}

/// <summary>本地持久化的授权状态（license.json 的字段）。字符串字段
/// 构造时初始化为 ""——Zan 的引用类型字段默认是 null，长度探测即
/// 运行时错误，绝不能让授权状态带着 null 出门。</summary>
class LicenseState {
    public LicenseState() {
        this.mode = "";
        this.product = "";
        this.subject = "";
        this.deviceFp = "";
        this.sessionToken = "";
    }

    /// account / code / signed / online（登录/激活时服务端下发）。
    public string mode;
    /// 产品标识（防状态文件拷给别的产品）。
    public string product;
    /// 授权主体（账号名或激活码尾号，展示用）。
    public string subject;
    /// 激活时绑定的本机指纹（重绑由服务端解绑）。
    public string deviceFp;
    /// 会话令牌（服务端可吊销；本地只存，不签发）。
    public string sessionToken;
    /// 授权到期 epoch 秒；0 = 终身。
    public long expiresAt;
    /// 掉线宽限秒数（服务端策略下发）。
    public int graceSeconds;
    /// 最后一次成功心跳的 epoch 秒。
    public long lastHeartbeat;
}
