using System;

namespace Data.Validation;

// 校验用的文本原语：空/空白判定、通配符匹配。
//
// 通配符语法：`*` 匹配任意长度（含空），`?` 匹配恰好一个字节，
// 其它字符按字面比较。刻意不引入正则引擎——校验规则里的模式
// 都是"是否以…开头/是否形如 a*b"这类，写死匹配器既没有正则的
// 回溯风险，也没有正则的编译开销。
//
// 匹配按字节进行：非 ASCII 文本里 `?` 只覆盖一个 UTF-8 字节，
// 需要按码点匹配时用 LengthBetween + 前缀/后缀规则。
public class ValidationText {
    // null 或空串视为空。
    public static bool IsEmpty(string value) {
        if (value == null) { return true; }
        return value.Length == 0;
    }

    // null、空串或全是空白字符视为空。
    public static bool IsBlank(string value) {
        if (value == null) { return true; }
        for (int i = 0; i < value.Length; i = i + 1) {
            int c = value[i] & 255;
            if (c != 32 && (c < 9 || c > 13)) { return false; }
        }
        return true;
    }

    // 通配匹配：pattern 里的 `*` 匹配任意长度，`?` 匹配一个字节。
    // 贪心 + 回溯（记录最近一个 `*` 的位置），线性于常见输入。
    public static bool Matches(string value, string pattern) {
        if (value == null || pattern == null) { return false; }
        int v = 0;
        int p = 0;
        int star = 0 - 1;
        int mark = 0;
        while (v < value.Length) {
            if (p < pattern.Length && (pattern[p] == '?' || pattern[p] == value[v])) {
                v = v + 1;
                p = p + 1;
            } else if (p < pattern.Length && pattern[p] == '*') {
                star = p;
                mark = v;
                p = p + 1;
            } else if (star >= 0) {
                p = star + 1;
                mark = mark + 1;
                v = mark;
            } else {
                return false;
            }
        }
        while (p < pattern.Length && pattern[p] == '*') {
            p = p + 1;
        }
        return p == pattern.Length;
    }

    // 基础邮箱格式校验：不含空白/控制字符，含有唯一 @ 且前后合法，域名含合法分段与 .
    public static bool IsValidEmail(string value) {
        if (value == null || value.Length < 5) { return false; }
        for (int i = 0; i < value.Length; i = i + 1) {
            int c = value[i] & 255;
            if (c <= 32 || c == 127) { return false; }
        }
        int at = value.IndexOf("@");
        if (at <= 0 || at == value.Length - 1) { return false; }
        // 只能有一个 @
        if (value.IndexOf("@", at + 1) >= 0) { return false; }
        // 本地部分与域名不得以点起止或包含连续点
        if ((value[0] & 255) == 46 || (value[at - 1] & 255) == 46) { return false; }
        if ((value[at + 1] & 255) == 46 || (value[value.Length - 1] & 255) == 46) { return false; }
        if (value.IndexOf("..") >= 0) { return false; }
        int dot = value.IndexOf(".", at + 1);
        if (dot <= at + 1 || dot == value.Length - 1) { return false; }
        return true;
    }
}
