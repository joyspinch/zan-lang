using System;

namespace Data.Validation;

// 校验用的文本原语：空/空白判定、通配符匹配。
//
// 通配符语法：`*` 匹配任意长度（含空），`?` 匹配恰好一个字节，
// 其它字符按字面比较。刻意不引入正则引擎——校验规则里的模式
// 都是"是否以…开头/是否形如 a*b"这类，写死匹配器既没有正则的
// 回溯风险，也没有正则的编译开销。
//
// 匹配按字节进行：非 ASCII 文本里 `?` 只覆盖一个 UTF-8 字节，
// 需要按码点匹配时用 LengthBetween + 前缀/后缀规则。
public class ValidationText {
    // null 或空串视为空。
    public static bool IsEmpty(string value) {
        if (value == null) { return true; }
        return value.Length == 0;
    }

    // null、空串或全是空白字符视为空。
    public static bool IsBlank(string value) {
        if (value == null) { return true; }
        int n = value.Length;
        for (int i = 0; i < n; i = i + 1) {
            int c = value[i] & 255;
            if (c != 32 && (c < 9 || c > 13)) { return false; }
        }
        return true;
    }

    // 通配匹配：pattern 里的 `*` 匹配任意长度，`?` 匹配一个字节。
    // 字面/前缀/后缀/包含快路径 + 贪心回溯，缓存长度并按字节直比。
    public static bool Matches(string value, string pattern) {
        if (value == null || pattern == null) { return false; }
        int vLen = value.Length;
        int pLen = pattern.Length;
        if (pLen == 0) { return vLen == 0; }
        nint pp = (nint)pattern;
        int wPos = NativeMemory.IndexOfAny(pp, pLen, 42, 63);  // '*' or '?'
        if (wPos < 0) {
            return vLen == pLen && value == pattern;
        }
        if (wPos > 0) {
            if (vLen < wPos) { return false; }
            for (int k = 0; k < wPos; k = k + 1) {
                if ((value[k] & 255) != (pattern[k] & 255)) { return false; }
            }
            if (wPos == pLen - 1 && (pattern[wPos] & 255) == 42) { return true; }
        } else if ((pattern[0] & 255) == 42) {
            if (pLen == 1) { return true; }
            int tailLen = pLen - 1;
            int w2 = NativeMemory.IndexOfAny(pp + (nint)1, tailLen, 42, 63);
            if (w2 < 0) {
                // 纯后缀模式 "*bar"
                if (vLen < tailLen) { return false; }
                int off = vLen - tailLen;
                for (int k = 0; k < tailLen; k = k + 1) {
                    if ((value[off + k] & 255) != (pattern[1 + k] & 255)) { return false; }
                }
                return true;
            }
            if (w2 == tailLen - 1 && (pattern[pLen - 1] & 255) == 42) {
                // 纯包含模式 "*mid*"
                int midLen = pLen - 2;
                if (midLen == 0) { return true; }
                if (vLen < midLen) { return false; }
                int first = pattern[1] & 255;
                int limit = vLen - midLen;
                nint vp = (nint)value;
                int pos = 0;
                while (pos <= limit) {
                    int hit = NativeMemory.Find(vp, pos, first, limit - pos + 1);
                    if (hit < 0) { return false; }
                    bool ok = true;
                    for (int k = 1; k < midLen; k = k + 1) {
                        if ((value[hit + k] & 255) != (pattern[1 + k] & 255)) { ok = false; break; }
                    }
                    if (ok) { return true; }
                    pos = hit + 1;
                }
                return false;
            }
        }
        int v = wPos;
        int p = wPos;
        int star = -1;
        int mark = wPos;
        while (v < vLen) {
            if (p < pLen) {
                int pc = pattern[p] & 255;
                if (pc == 63 || pc == (value[v] & 255)) {
                    v = v + 1;
                    p = p + 1;
                    continue;
                }
                if (pc == 42) {
                    star = p;
                    mark = v;
                    p = p + 1;
                    continue;
                }
            }
            if (star >= 0) {
                p = star + 1;
                mark = mark + 1;
                v = mark;
            } else {
                return false;
            }
        }
        while (p < pLen && (pattern[p] & 255) == 42) {
            p = p + 1;
        }
        return p == pLen;
    }

    // 基础邮箱格式校验：单遍字节扫描融合控制符、唯一 @、起止点、连续点与域名点检查。
    public static bool IsValidEmail(string value) {
        if (value == null) { return false; }
        int n = value.Length;
        if (n < 5) { return false; }
        int first = value[0] & 255;
        int last = value[n - 1] & 255;
        if (first == 46 || last == 46 || first == 64 || last == 64) { return false; }
        int at = -1;
        bool hasDotAfterAt = false;
        int prev = 0;
        for (int i = 0; i < n; i = i + 1) {
            int c = value[i] & 255;
            if (c <= 32 || c == 127) { return false; }
            if (c == 64) {
                if (at >= 0 || prev == 46) { return false; }
                at = i;
            } else if (c == 46) {
                if (prev == 46 || prev == 64) { return false; }
                if (at >= 0) { hasDotAfterAt = true; }
            }
            prev = c;
        }
        return at > 0 && hasDotAfterAt;
    }
}
