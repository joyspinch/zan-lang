using System;

namespace System.Validation;

// 校验用的文本原语：空/空白判定、通配符匹配。
//
// 通配符语法：`*` 匹配任意长度（含空），`?` 匹配恰好一个字节，
// 其它字符按字面比较。刻意不引入正则引擎——校验规则里的模式
// 都是"是否以…开头/是否形如 a*b"这类，写死匹配器既没有正则的
// 回溯风险，也没有正则的编译开销。
//
// 匹配按字节进行：非 ASCII 文本里 `?` 只覆盖一个 UTF-8 字节，
// 需要按码点匹配时用 LengthBetween + 前缀/后缀规则。
public class ValidationText {
    // null 或空串视为空。
    public static bool IsEmpty(string value) {
        if (value == null) { return true; }
        return value.Length == 0;
    }

    // null、空串或全是空白字符视为空。
    public static bool IsBlank(string value) {
        if (value == null) { return true; }
        if (value.Length == 0) { return true; }
        return value.Trim().Length == 0;
    }

    // 通配匹配：pattern 里的 `*` 匹配任意长度，`?` 匹配一个字节。
    // 贪心 + 回溯（记录最近一个 `*` 的位置），线性于常见输入。
    public static bool Matches(string value, string pattern) {
        if (value == null || pattern == null) { return false; }
        int v = 0;
        int p = 0;
        int star = 0 - 1;
        int mark = 0;
        while (v < value.Length) {
            if (p < pattern.Length && (pattern[p] == '?' || pattern[p] == value[v])) {
                v = v + 1;
                p = p + 1;
            } else if (p < pattern.Length && pattern[p] == '*') {
                star = p;
                mark = v;
                p = p + 1;
            } else if (star >= 0) {
                p = star + 1;
                mark = mark + 1;
                v = mark;
            } else {
                return false;
            }
        }
        while (p < pattern.Length && pattern[p] == '*') {
            p = p + 1;
        }
        return p == pattern.Length;
    }
}
