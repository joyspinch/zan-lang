using System;

namespace System.Validation;

// 一次校验的执行上下文：是否首错即停、属性名前缀。
//
// 首错即停（FailFast）用于"只要有一条就不合法"的场景（表单提交、
// 协议握手），避免为一次请求构造几百条错误。
//
// 属性名前缀用于把子对象的失败项归到父属性名下：
// WithPrefix("address") 时子校验器的 "city" 变成 "address.city"。
public class ValidationContext {
    // 命中第一条失败后立刻停止。
    public bool stopOnFirstFailure;
    // 失败项属性名前缀（"" 表示不加前缀）。
    public string propertyPrefix;

    public ValidationContext() {
        this.stopOnFirstFailure = false;
        this.propertyPrefix = "";
    }

    // 打开首错即停（链式）。
    public ValidationContext FailFast() {
        this.stopOnFirstFailure = true;
        return this;
    }

    // 设置属性名前缀（链式）。
    public ValidationContext WithPrefix(string prefix) {
        this.propertyPrefix = prefix == null ? "" : prefix;
        return this;
    }
}
