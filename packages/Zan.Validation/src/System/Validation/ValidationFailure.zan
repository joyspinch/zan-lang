using System;

namespace System.Validation;

// 一条校验失败。property 是出错的属性路径（嵌套校验时形如
// "address.city"），message 是面向人的说明，code 是机器可读的
// 规则标识（"NotEmpty"/"RangeInt"…），attemptedValue 是出错时
// 取到的值（已转成文本；无值时为空串）。
public class ValidationFailure {
    public string property;
    public string message;
    public string code;
    public string attemptedValue;

    public ValidationFailure(string property, string message, string code, string attemptedValue) {
        this.property = property == null ? "" : property;
        this.message = message == null ? "" : message;
        this.code = code == null ? "" : code;
        this.attemptedValue = attemptedValue == null ? "" : attemptedValue;
    }

    // "property: message"。ToText 与 ToString 同义（ToString 便于
    // 直接塞进日志/异常消息）。
    public string ToText() {
        if (this.property.Length == 0) { return this.message; }
        return this.property + ": " + this.message;
    }

    public string ToString() {
        return this.ToText();
    }
}
