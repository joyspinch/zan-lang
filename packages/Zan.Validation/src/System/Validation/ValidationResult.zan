using System;
using System.Collections.Generic;
using System.Json;

namespace System.Validation;

// 一次校验的聚合结果。失败项按规则声明顺序排列（不是按属性名字
// 典序），因此同一条规则的多个错误相邻，便于日志阅读。
public class ValidationResult {
    public List<ValidationFailure> failures;

    public ValidationResult() {
        this.failures = new List<ValidationFailure>();
    }

    // 没有失败项即为通过。
    public bool IsValid { get { return this.failures.Count == 0; } }

    // 失败项数量。
    public int ErrorCount { get { return this.failures.Count; } }

    // 与 IsValid 取反，方便 `if (result.HasError)` 的写法。
    public bool HasError { get { return this.failures.Count > 0; } }

    // 追加一条失败项。
    public void Add(ValidationFailure failure) {
        if (failure != null) { this.failures.Add(failure); }
    }

    // 造一个只含单条失败项的结果（规则内部用）。
    public static ValidationResult One(string property, string message, string code, string attemptedValue) {
        ValidationResult r = new ValidationResult();
        r.Add(new ValidationFailure(property, message, code, attemptedValue));
        return r;
    }

    // 追加一批失败项（逐项拷贝引用，不共享列表）。
    public void AddAll(List<ValidationFailure> items) {
        if (items == null) { return; }
        for (int i = 0; i < items.Count; i = i + 1) {
            this.failures.Add(items[i]);
        }
    }

    // 第一条失败项；没有则返回 null。
    public ValidationFailure FirstFailure() {
        if (this.failures.Count == 0) { return null; }
        return this.failures[0];
    }

    // 第一条失败消息；没有则返回空串。
    public string FirstError() {
        ValidationFailure f = this.FirstFailure();
        if (f == null) { return ""; }
        return f.message;
    }

    // 指定属性的全部失败项（没有则返回空列表）。
    public List<ValidationFailure> ErrorsFor(string property) {
        List<ValidationFailure> hits = new List<ValidationFailure>();
        for (int i = 0; i < this.failures.Count; i = i + 1) {
            ValidationFailure f = this.failures[i];
            if (f.property == property) { hits.Add(f); }
        }
        return hits;
    }

    // 属性 → 首条错误消息。同一个属性有多条错误时取第一条。
    public Dictionary<string, string> ToDictionary() {
        Dictionary<string, string> map = new Dictionary<string, string>();
        for (int i = 0; i < this.failures.Count; i = i + 1) {
            ValidationFailure f = this.failures[i];
            if (!map.ContainsKey(f.property)) {
                map.Add(f.property, f.message);
            }
        }
        return map;
    }

    // 逐行文本："property: message"，每行一条。
    public string ToText() {
        if (this.failures.Count == 0) { return "valid"; }
        string outp = "";
        for (int i = 0; i < this.failures.Count; i = i + 1) {
            if (i > 0) { outp = outp + "\n"; }
            outp = outp + this.failures[i].ToText();
        }
        return outp;
    }

    // JSON：{"valid":false,"errors":[{"property","message","code"}]}。
    public string ToJson() {
        JsonValue root = JsonValue.NewObject();
        root.PutBool("valid", this.IsValid);
        JsonValue arr = JsonValue.NewArray();
        for (int i = 0; i < this.failures.Count; i = i + 1) {
            ValidationFailure f = this.failures[i];
            JsonValue item = JsonValue.NewObject();
            item.PutStr("property", f.property);
            item.PutStr("message", f.message);
            item.PutStr("code", f.code);
            arr.Append(item);
        }
        root.Put("errors", arr);
        return root.ToJson();
    }

    public string ToString() {
        return this.ToText();
    }
}
