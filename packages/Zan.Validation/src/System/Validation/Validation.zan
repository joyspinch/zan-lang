using System;

namespace System.Validation;

// 校验门面：不依赖具体被校验类型的静态入口。
//
// 绝大多数场景直接用 ValidationPlan<T> 的实例方法即可；门面提供
// 的是"不关心 T"的通用动作：造空结果、把失败变成异常。
public class Validation {
    // 一个通过的结果（无失败项）。
    public static ValidationResult Ok() {
        return new ValidationResult();
    }

    // 结果不通过就抛 ValidationException；通过则原样返回入参。
    public static ValidationResult Ensure(ValidationResult result) {
        if (result != null && !result.IsValid) {
            throw new ValidationException(result);
        }
        return result;
    }

    // 跑一个规则集。T 由 plan 的实参推出。
    public static ValidationResult Validate<T>(ValidationPlan<T> plan, T instance) {
        if (plan == null) { return new ValidationResult(); }
        return plan.Validate(instance);
    }
}
