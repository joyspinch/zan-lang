using System;

namespace System.Validation;

// 校验失败时抛出。携带原始 ValidationResult，调用方既能拿到
// 结构化错误，也能从 Message 拿到人读文本。
public class ValidationException : Exception {
    // 原始校验结果（可能为 null）。
    public ValidationResult result;

    public ValidationException(ValidationResult result) : base(result == null ? "validation failed" : result.ToText()) {
        this.result = result;
    }

    public ValidationException(string message) : base(message) {
        this.result = null;
    }
}
