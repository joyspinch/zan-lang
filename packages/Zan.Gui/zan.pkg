name = "Zan.Gui"
version = "1.0.0"
description = "The Zan GUI toolkit: HTML+CSS markup grown into a retained control tree, CSS styling/skins, two-way data binding, App/window shell, control library (inputs, tabs, menus, ChatView, DockHost, ...), text shaping, media and the platform backend shells, with skins/icons/native driver bundles riding in src/Gui. Charts, DataTable, CodeEditor, Browser and Designer are the sibling Zan.Gui.* packages"
author = "Zan Team"
license = "MIT"
