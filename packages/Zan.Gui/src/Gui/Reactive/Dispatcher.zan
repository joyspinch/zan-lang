using System;
using System.Collections.Generic;
using System.Threading;

namespace Gui.Reactive;

public class Dispatcher {
    List<Action> queue;
    /* Mutex 句柄全平台都是 nint（见 System.Threading.Mutex 的平台分支注释）。 */
    nint lockHandle;
    long uiThreadId;

    // 创建由调用（UI）线程拥有的调度器。
    Dispatcher() {
        this.queue = new List<Action>();
        this.lockHandle = Mutex.Create();
        this.uiThreadId = Thread.CurrentId();
    }

    // 当从创建调度器的线程调用时为 true。
    bool IsUiThread() {
        return Thread.CurrentId() == this.uiThreadId;
    }

    // 将工作排队到 UI 线程执行。任意线程调用均安全。
    void Post(Action work) {
        Mutex.Lock(this.lockHandle);
        this.queue.Add(work);
        Mutex.Unlock(this.lockHandle);
    }

    // 在 UI 线程上运行工作：已在该线程则立即执行，否则
    // 经 Post 调度过去，调用方不会跨线程修改 UI 状态。
    void Invoke(Action work) {
        if (IsUiThread()) {
            work();
        } else {
            Post(work);
        }
    }

    // 排空所有已排队的工作并在当前（UI）线程执行。请在
    // UI/事件循环中每帧调用一次。返回执行的工作项数。
    int Drain() {
        Mutex.Lock(this.lockHandle);
        List<Action> pending = this.queue;
        this.queue = new List<Action>();
        Mutex.Unlock(this.lockHandle);
        int ran = 0;
        for (int i = 0; i < pending.Count; i = i + 1) {
            Action work = pending[i];
            work();
            ran = ran + 1;
        }
        return ran;
    }
}

// 保存单个事件的名称与订阅者。
