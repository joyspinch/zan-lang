using System;
using System.Collections.Generic;
using System.Threading;

namespace Gui.Reactive;

public class EventHub {
    List<NamedEventSlot> slots;
    Dispatcher dispatcher;

    // 创建 hub。传入 Dispatcher 以自动在 UI 线程投递，或传
    // null 以在调用线程同步调用处理器。
    EventHub(Dispatcher d) {
        this.slots = new List<NamedEventSlot>();
        this.dispatcher = d;
    }

    // 事件槽下标，未订阅过该事件时返回 -1。
    int IndexOf(string evt) {
        for (int i = 0; i < this.slots.Count; i = i + 1) {
            if (this.slots[i].name == evt) {
                return i;
            }
        }
        return -1;
    }

    // 返回事件的槽，尚不存在时先创建。
    NamedEventSlot SlotFor(string evt) {
        int idx = this.IndexOf(evt);
        if (idx >= 0) {
            return this.slots[idx];
        }
        NamedEventSlot slot = new NamedEventSlot(evt);
        this.slots.Add(slot);
        return slot;
    }

    // 将处理器订阅到事件（类似 `evt += handler`）。
    void On(string evt, Action handler) {
        this.SlotFor(evt).handlers.Add(handler);
    }

    // 当前订阅某事件的处理器数量。
    int CountFor(string evt) {
        int idx = this.IndexOf(evt);
        if (idx < 0) {
            return 0;
        }
        return this.slots[idx].handlers.Count;
    }

    // 移除某事件的所有处理器。
    void Clear(string evt) {
        int idx = this.IndexOf(evt);
        if (idx >= 0) {
            this.slots[idx].handlers = new List<Action>();
        }
    }

    // 触发事件，调用每个订阅者。挂有 Dispatcher 时
    // 处理器被调度到 UI 线程；否则内联执行。
    void Emit(string evt) {
        int idx = this.IndexOf(evt);
        if (idx < 0) {
            return;
        }
        List<Action> hs = this.slots[idx].handlers;
        for (int i = 0; i < hs.Count; i = i + 1) {
            Action h = hs[i];
            if (this.dispatcher != null) {
                this.dispatcher.Invoke(h);
            } else {
                h();
            }
        }
    }
}

