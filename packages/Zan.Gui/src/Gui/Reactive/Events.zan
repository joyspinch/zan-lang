using System;
using System.Threading;

namespace Gui.Reactive;

// 事件和调度器使用的无参回调。
delegate void Action();

// UI 线程派发队列。后台线程通过 Post/Invoke 将工作入队；
// UI 线程每帧通过 Drain() 排空并执行一次。这正是
// 事件回调和属性写入跨线程安全的原因：在
// UI 线程之外触发的工作会被调度回该线程，而不是从
// 另一线程触碰 UI 状态。
class Dispatcher {
    List<Action> queue;
    /* Mutex 句柄全平台都是 nint（见 System.Threading.Mutex 的平台分支注释）。 */
    nint lockHandle;
    long uiThreadId;

    // 创建由调用（UI）线程拥有的调度器。
    Dispatcher() {
        this.queue = new List<Action>();
        this.lockHandle = Mutex.Create();
        this.uiThreadId = Thread.CurrentId();
    }

    // 当从创建调度器的线程调用时为 true。
    bool IsUiThread() {
        return Thread.CurrentId() == this.uiThreadId;
    }

    // 将工作排队到 UI 线程执行。任意线程调用均安全。
    void Post(Action work) {
        Mutex.Lock(this.lockHandle);
        this.queue.Add(work);
        Mutex.Unlock(this.lockHandle);
    }

    // 在 UI 线程上运行工作：已在该线程则立即执行，否则
    // 经 Post 调度过去，调用方不会跨线程修改 UI 状态。
    void Invoke(Action work) {
        if (IsUiThread()) {
            work();
        } else {
            Post(work);
        }
    }

    // 排空所有已排队的工作并在当前（UI）线程执行。请在
    // UI/事件循环中每帧调用一次。返回执行的工作项数。
    int Drain() {
        Mutex.Lock(this.lockHandle);
        List<Action> pending = this.queue;
        this.queue = new List<Action>();
        Mutex.Unlock(this.lockHandle);
        int ran = 0;
        for (int i = 0; i < pending.Count; i = i + 1) {
            Action work = pending[i];
            work();
            ran = ran + 1;
        }
        return ran;
    }
}

// 保存单个事件的名称与订阅者。
class NamedEventSlot {
    string name;
    List<Action> handlers;

    NamedEventSlot(string name) {
        this.name = name;
        this.handlers = new List<Action>();
    }
}

// C# 风格的事件聚合器。组件用 On() 将委托订阅到命名事件，
// 用 Emit() 触发。挂上 Dispatcher 时每个
// 处理器都会自动在 UI 线程运行，因此从工作线程
// 触发事件是安全的。
class EventHub {
    List<NamedEventSlot> slots;
    Dispatcher dispatcher;

    // 创建 hub。传入 Dispatcher 以自动在 UI 线程投递，或传
    // null 以在调用线程同步调用处理器。
    EventHub(Dispatcher d) {
        this.slots = new List<NamedEventSlot>();
        this.dispatcher = d;
    }

    // 事件槽下标，未订阅过该事件时返回 -1。
    int IndexOf(string evt) {
        for (int i = 0; i < this.slots.Count; i = i + 1) {
            if (this.slots[i].name == evt) {
                return i;
            }
        }
        return -1;
    }

    // 返回事件的槽，尚不存在时先创建。
    NamedEventSlot SlotFor(string evt) {
        int idx = this.IndexOf(evt);
        if (idx >= 0) {
            return this.slots[idx];
        }
        NamedEventSlot slot = new NamedEventSlot(evt);
        this.slots.Add(slot);
        return slot;
    }

    // 将处理器订阅到事件（类似 `evt += handler`）。
    void On(string evt, Action handler) {
        this.SlotFor(evt).handlers.Add(handler);
    }

    // 当前订阅某事件的处理器数量。
    int CountFor(string evt) {
        int idx = this.IndexOf(evt);
        if (idx < 0) {
            return 0;
        }
        return this.slots[idx].handlers.Count;
    }

    // 移除某事件的所有处理器。
    void Clear(string evt) {
        int idx = this.IndexOf(evt);
        if (idx >= 0) {
            this.slots[idx].handlers = new List<Action>();
        }
    }

    // 触发事件，调用每个订阅者。挂有 Dispatcher 时
    // 处理器被调度到 UI 线程；否则内联执行。
    void Emit(string evt) {
        int idx = this.IndexOf(evt);
        if (idx < 0) {
            return;
        }
        List<Action> hs = this.slots[idx].handlers;
        for (int i = 0; i < hs.Count; i = i + 1) {
            Action h = hs[i];
            if (this.dispatcher != null) {
                this.dispatcher.Invoke(h);
            } else {
                h();
            }
        }
    }
}
