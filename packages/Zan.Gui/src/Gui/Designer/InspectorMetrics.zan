using System;

namespace Gui.Designer;

// 检查器排版 Token 与标准尺寸阶梯（消除裸 Scale，统一语义化对齐）。
public class InspectorMetrics {
    // 基础高度档位（对应 CSS --control-h-*）
    public const int RowHeight = 28;            // 标准行高与输入框高度
    public const int RowHeightCompact = 22;     // 紧凑行高与表头高度
    public const int TabButtonHeight = 28;      // 顶部 Tab/分类按钮标准高度
    public const int ActionButtonSize = 22;     // 行内标准操作按钮盒 (22x22px 实体靶心)
    public const int DropdownButtonWidth = 22;  // 下拉展开按钮宽度
    public const int SearchInputHeight = 28;    // 搜索过滤框标准高度

    // 基础间距档位（对应 CSS gap / margin，严格 8 点栅格）
    public const int GapMicro = 3;              // 微小间隙（如行内连续小按钮之间）
    public const int GapInline = 4;             // 行内小间距 (Space.XS)
    public const int GapStack = 8;              // 垂直控件/卡片标准堆叠间隙 (Space.S)
    public const int GapSection = 12;           // 大模块/大分类间隔 (Space.SM)

    // 内边距与面板外框
    public const int PaddingPanel = 12;         // 检查器外框左右内边距
    public const int PaddingCard = 8;           // 卡片内部内边距
}
