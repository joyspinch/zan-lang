using System;
using Gui;

namespace Gui.Designer;

// 属性默认值的唯一来源（VS 的"恢复默认值"）：以"同类型控件
// 刚被添加到画布时的样子"为准——即 FormField 的干净实例。
//
// 两类属性不给默认值：
//   · 枚举类（dock/position/anchor/...）——设计器里同一语义有多套
//     表示（序号 / 选项文本 / 类型强制值），比对不可靠，复位会打乱；
//   · 几何类（x/y/w/h）——随布局而定，没有"默认值"可言。
public class DesignerDefaults {
    // 各类型的干净实例缓存：属性表每帧重建，默认值来源不能每帧新建控件。
    static List<FormField> protos;

    // 同类型控件的干净实例（默认值的来源）。自定义组件没有干净
    // 实例（它的默认值取决于用户代码），返回 null。
    static FormField Proto(FormField f) {
        if (f == null || f.IsCustom()) { return null; }
        int ft = f.ftype;
        if (ft < 0) { return null; }
        if (protos == null) { protos = new List<FormField>(); }
        while (protos.Count <= ft) { protos.Add(null); }
        FormField p = protos[ft];
        if (p == null) {
            p = new FormField(ft);
            protos[ft] = p;
        }
        return p;
    }

    // 给属性列表挂上默认值（就地修改），返回挂上的条数。
    static int Apply(List<PropSpec> ps, FormField f) {
        FormField proto = DesignerDefaults.Proto(f);
        if (proto == null) { return 0; }
        int n = 0;
        for (int i = 0; i < ps.Count; i = i + 1) {
            PropSpec p = ps[i];
            if (p.kind == 5 || p.kind == 3) { continue; }
            string dv = DesignerDefaults.Of(p.key, proto);
            if (dv == null) { continue; }
            p.Default(dv);
            n = n + 1;
        }
        return n;
    }

    // 某属性的默认值（null = 该属性没有自然默认值）。
    static string Of(string key, FormField proto) {
        if (key == "label") { return proto.label; }
        if (key == "placeholder") { return proto.placeholder; }
        if (key == "visible") { return "true"; }
        if (key == "disabled") { return "false"; }
        if (key == "required") { return "false"; }
        if (key == "wrap") { return "false"; }
        if (key == "defOn") { return "false"; }
        if (key == "tooltip") { return ""; }
        if (key == "pvOff") { return "true"; }
        if (key == "span") { return "24"; }
        if (key == "flexGrow") { return "0"; }
        if (key == "margin") { return "0"; }
        if (key == "padding") { return "0"; }
        if (key == "gap") { return "0"; }
        if (key == "flexWrap") { return "false"; }
        if (key == "bind") { return ""; }
        if (key == "bindProp") { return ""; }
        if (key == "of") { return ""; }
        return null;
    }
}
