        if (ft == 74) { return Designer.T("Responsive equal-width grid", "响应式等宽网格"); }
        if (ft == 75) { return Designer.T("Image with alt / fit", "图片（带替代文本 / 适配）"); }
        if (ft == 76) { return Designer.T("Month calendar", "月历"); }
        if (ft == 77) { return Designer.T("Live countdown timer", "实时倒计时"); }
        if (ft == 78) { return Designer.T("QR code from label text", "二维码（内容取标签）"); }
        if (ft == 79) { return Designer.T("Tiled watermark overlay", "平铺水印"); }
        if (ft == 80) { return Designer.T("Scrolling announcement text", "滚动公告"); }
        if (ft == 81) { return Designer.T("Editable tag list", "动态标签（可增删）"); }
        if (ft == 82) { return Designer.T("Animated count-up number", "数字滚动动画"); }
        if (ft == 83) { return Designer.T("One-time-code input boxes", "一次性验证码输入"); }
        if (ft == 84) { return Designer.T("Two-pane shuttle picker", "穿梭框（双栏选择）"); }
        if (ft == 85) { return Designer.T("Virtualized long list", "虚拟化长列表"); }
        return Designer.T("Form field", "表单字段");
    }

