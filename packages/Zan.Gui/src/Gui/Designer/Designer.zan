using System;
using System.Globalization;
using System.Json;
using Gui.Widget;
using Gui;
using Gui.Component;

namespace Gui.Designer;

/// 自包含、可复用的 FormCreate/form-builder 风格可视化设计器。
///
/// 不做自由像素拖拽，而是编辑有序的表单字段列表
/// （FormField 控件作为 `form` 根面板的子级），并渲染为
/// 带标签的纵向表单——即大家在 VB /
/// WinForms / element-plus 表单设计器里手工搭的那种布局，但无需操作坐标。
///
/// 界面：
///   * 左侧分类字段面板（点击类型即可追加一行），
///   * 中间为纵向表单预览（标签 + 必填星号 + 每个字段控件的
///     预览；点击行可选中），
///   * 右侧检查器，带 Field / Form 两个标签页：Field 编辑
///     选中行（标签、model 名、placeholder、必填、选项、change
///     处理器）；Form 编辑表单级配置（名称、标签位置、尺寸、标签
///     宽度、必填星号显隐、提交/重置按钮、提交处理器），
///   * 底部状态栏。
///
/// 一切通过 Serialize 往返：表单配置是一行头部，
/// 字段是序列化的 Control 子树，因此关系、顺序、
/// 属性和事件绑定都能持久化。
///
/// 用法：
///   Designer d = new Designer();   // 创建一次
///   d.Seed(app);                      // 可选：填充示例字段
///   d.Render(app, x, y, w, h);        // 每帧调用

/// 一个已保存的用户组件：显示名 + 设计 JSON。用一个实体
/// 而非并行的 name/json 列表。
class UserComponent {
    string name;
    string json;

    UserComponent(string name, string json) {
        this.name = name;
        this.json = json;
    }
}

/// 工具箱组件条目强类型实体（消除平行列表索引对齐反模式）。
class PaletteItem {
    int kind;
    string custom;

    PaletteItem(int kind, string custom) {
        this.kind = kind;
        this.custom = custom;
    }
}

/// DataGrid 列声明强类型实体（收敛设计器内的动态 JsonValue 树散布）。
class ColumnConfig {
    int width;
    int align;      // 0 = 缺省/左, 1 = 中, 2 = 右
    int type;       // 0 = 缺省/文本, 1 = num, 2 = real, 3 = bool, 4 = date
    bool sortable;
    bool resizable;
    bool editable;
    int decimals;
    string money;
    bool percent;
    string prefix;
    string suffix;
    bool grouped;
    int summary;    // 0 = 无, 1 = sum, 2 = avg, 3 = min, 4 = max, 5 = count
    int pin;        // 0 = 无, 1 = left, 2 = right
    string band;
    string click;

    ColumnConfig() {
        this.width = 0;
        this.align = 0;
        this.type = 0;
        this.sortable = true;
        this.resizable = true;
        this.editable = false;
        this.decimals = 2;
        this.money = "";
        this.percent = false;
        this.prefix = "";
        this.suffix = "";
        this.grouped = false;
        this.summary = 0;
        this.pin = 0;
        this.band = "";
        this.click = "";
    }

    /// 从原始 JsonValue 对象反序列化并构造 ColumnConfig 强类型实体。
    static ColumnConfig FromJson(JsonValue e) {
        ColumnConfig cfg = new ColumnConfig();
        if (e == null || !e.IsObject()) { return cfg; }
        cfg.width = e.Int("width", 0);
        string al = e.Str("align", "");
        if (al == "center") { cfg.align = 1; }
        else if (al == "right") { cfg.align = 2; }
        string tp = e.Str("type", "");
        if (tp == "num") { cfg.type = 1; }
        else if (tp == "real") { cfg.type = 2; }
        else if (tp == "bool") { cfg.type = 3; }
        else if (tp == "date") { cfg.type = 4; }
        JsonValue sv = e.Get("sortable");
        if (sv != null && sv.IsBool()) { cfg.sortable = sv.AsBool(true); }
        JsonValue rv = e.Get("resizable");
        if (rv != null && rv.IsBool()) { cfg.resizable = rv.AsBool(true); }
        JsonValue ev = e.Get("editable");
        if (ev != null && ev.IsBool()) { cfg.editable = ev.AsBool(false); }
        cfg.decimals = e.Int("decimals", 2);
        cfg.money = e.Str("money", "");
        JsonValue pv = e.Get("percent");
        if (pv != null && pv.IsBool()) { cfg.percent = pv.AsBool(false); }
        cfg.prefix = e.Str("prefix", "");
        cfg.suffix = e.Str("suffix", "");
        JsonValue gv = e.Get("grouped");
        if (gv != null && gv.IsBool()) { cfg.grouped = gv.AsBool(false); }
        if (Designer.ColBool(e, "sum")) { cfg.summary = 1; }
        else if (Designer.ColBool(e, "avg")) { cfg.summary = 2; }
        else if (Designer.ColBool(e, "min")) { cfg.summary = 3; }
        else if (Designer.ColBool(e, "max")) { cfg.summary = 4; }
        else if (Designer.ColBool(e, "count")) { cfg.summary = 5; }
        string pin = e.Str("pin", "");
        if (pin == "left") { cfg.pin = 1; }
        else if (pin == "right") { cfg.pin = 2; }
        cfg.band = e.Str("band", "");
        cfg.click = e.Str("click", "");
        return cfg;
    }

    /// 将 ColumnConfig 强类型实体导出为落盘属性字典（不存默认值，保持最小体积）。
    JsonValue ToJsonObject() {
        JsonValue o = JsonValue.NewObject();
        if (this.width > 0) {
            o.Set("width", JsonValue.NewNum(Convert.ToString(this.width)));
        }
        if (this.align == 1) { o.Set("align", JsonValue.NewStr("center")); }
        else if (this.align == 2) { o.Set("align", JsonValue.NewStr("right")); }
        if (this.type == 1) { o.Set("type", JsonValue.NewStr("num")); }
        else if (this.type == 2) { o.Set("type", JsonValue.NewStr("real")); }
        else if (this.type == 3) { o.Set("type", JsonValue.NewStr("bool")); }
        else if (this.type == 4) { o.Set("type", JsonValue.NewStr("date")); }
        if (!this.sortable) { o.Set("sortable", JsonValue.NewBool(false)); }
        if (!this.resizable) { o.Set("resizable", JsonValue.NewBool(false)); }
        if (this.editable) { o.Set("editable", JsonValue.NewBool(true)); }
        if (this.type == 2 && this.decimals != 2) {
            o.Set("decimals", JsonValue.NewNum(Convert.ToString(this.decimals)));
        }
        if (StyleSheet.Trim(this.money) != "") {
            o.Set("money", JsonValue.NewStr(StyleSheet.Trim(this.money)));
        }
        if (this.percent) { o.Set("percent", JsonValue.NewBool(true)); }
        if (StyleSheet.Trim(this.prefix) != "") {
            o.Set("prefix", JsonValue.NewStr(StyleSheet.Trim(this.prefix)));
        }
        if (StyleSheet.Trim(this.suffix) != "") {
            o.Set("suffix", JsonValue.NewStr(StyleSheet.Trim(this.suffix)));
        }
        if (this.grouped) { o.Set("grouped", JsonValue.NewBool(true)); }
        if (this.summary == 1) { o.Set("sum", JsonValue.NewBool(true)); }
        else if (this.summary == 2) { o.Set("avg", JsonValue.NewBool(true)); }
        else if (this.summary == 3) { o.Set("min", JsonValue.NewBool(true)); }
        else if (this.summary == 4) { o.Set("max", JsonValue.NewBool(true)); }
        else if (this.summary == 5) { o.Set("count", JsonValue.NewBool(true)); }
        if (this.pin == 1) { o.Set("pin", JsonValue.NewStr("left")); }
        else if (this.pin == 2) { o.Set("pin", JsonValue.NewStr("right")); }
        if (StyleSheet.Trim(this.band) != "") {
            o.Set("band", JsonValue.NewStr(StyleSheet.Trim(this.band)));
        }
        if (StyleSheet.Trim(this.click) != "") {
            o.Set("click", JsonValue.NewStr(StyleSheet.Trim(this.click)));
        }
        return o;
    }
}

/// 画布上一个页签的屏幕矩形。渲染标签条时逐个登记，指针按下
/// 时据此把点击判成「翻到那一页」，而不是选中或拖动 Tabs 容器。
class TabHeaderHit {
    FormField tabs;
    int page;
    int x;
    int y;
    int w;
    int h;

    TabHeaderHit(FormField tabs, int page, int x, int y, int w, int h) {
        this.tabs = tabs;
        this.page = page;
        this.x = x;
        this.y = y;
        this.w = w;
        this.h = h;
    }
}

/// 预览控件缓存条目强类型实体（替代 pvCompKeys 与 pvCompCtls 平行列表）。
class PreviewControlCache {
    string key;
    Control control;

    PreviewControlCache(string key, Control control) {
        this.key = key != null ? key : "";
        this.control = control;
    }
}

/// 组件属性对外声明强类型实体（替代 compPropKeys, compPropLabels, compPropDefs 平行列表）。
class CompPropDecl {
    public string key;
    public string label;
    public string def;

    CompPropDecl(string key, string label, string def) {
        this.key = key != null ? key : "";
        this.label = label != null ? label : "";
        this.def = def != null ? def : "";
    }
}

/// 检查器组件属性编辑行强类型实体（替代 compPropInputs, compPropSwitches, compPropIsBool, compPropShadow 平行列表）。
class CompPropEditRow {
    public string key;
    public string label;
    public bool isBool;
    public Input input;
    public Switch sw;
    public string shadow;

    CompPropEditRow(string key, string label, bool isBool, Input input, Switch sw, string shadow) {
        this.key = key != null ? key : "";
        this.label = label != null ? label : "";
        this.isBool = isBool;
        this.input = input;
        this.sw = sw;
        this.shadow = shadow != null ? shadow : "";
    }
}

partial class Designer {
    // UI language code ("zh" / "en"). Set by the host (e.g. the IDE) so the
    // designer 界面文案跟随宿主 UI 语言，通过 T(en, zh) 读取。
    static string lang = "en";

    List<FormField> fields;
    FormField sel;
    FormField selPrev;
    string doc;
    string msg;
    int inspTab;      // 0 = 字段，1 = 表单
    bool preview;
    // 宿主（IDE）把组件面板和属性面板挂在自己的 dock 里时置位：
    // 设计器本体只留功能区 + 画布，不再自己开左右两栏。
    bool hostPanels;
    int seq;          // 生成字段名的递增计数器

    // 面板添加新组件时放入的容器：当前选中
    // 的容器，或选中子级的父容器；null 表示
    // 顶层表单。点击 Card / Tabs 后即可把组件放入其中。
    FormField activeContainer;
    // 组件工具箱（TreeView 控件 + 与其绑定的节点表）。
    // palItems 强类型实体表与 palNodes 一一对应：行 -> 组件类型与自定义标识。
    TreeView palTv;
    List<TreeNode> palNodes;
    List<PaletteItem> palItems;
    // 单击工具箱添加组件被推迟到抬起：按下时还不知道这是一次点击
    // 还是一次拖拽，立刻添加会让拖入的第一个组件变成两个
    // （点击加一个、放下再加一个）。
    bool palClickPending;
    int palClickKind;
    string palClickCustom;
    bool palBuilt;      // 节点表是否已构建
    string palBuiltQ;   // 上次构建节点时的过滤串
    int palBuiltUser;   // 上次构建节点时的用户组件数量

    // 工具箱中被折叠起来的分组标题（Visual Studio 风格的
    // 可折叠分组），按标题记住，跨帧保留。
    List<string> palFolded;

    // 被设计窗口的布局模式：0 = 流式（24 列，form-builder
    // 风格），1 = 自由（绝对定位的设计画布，场景设计器风格）。
    int layoutMode;
    // 自由画布缩放，以设计尺寸的千分比表示（1000 = 100%，0 = 适配
    // 到编辑器视口）。默认 1000：100% 的语义是"目标设备 1:1"——
    // 渲染比例 = 视图缩放 × dpiScale，任何显示比例的机器打开同一张
    // 设计，看到的逻辑布局都一致；「适应」把显示器 DPI 烘进缩放
    // 结果（同一张设计在不同 DPI 屏上适应出的比例不同），只作为
    // 缩放下拉里的一档，不作为默认视图。
    int winZoom;
    // 最近一帧「适应」算出的实际缩放（千分比，1000 = 100%），供功能区
    // 显示与从 Fit 缩放的起步值使用。
    int lastFitPct;
    // 自由画布交互状态。名称带前缀，避免与
    // 流式模式的面板拖拽（`dragging` 等）冲突。
    bool freeDragging;   // 在自由画布上拖移选区
    bool freeResizing;   // 通过角/边手柄调整大小
    int freeResizeH;     // 当前活动的手柄 0-7（TL,T,TR,R,BR,B,BL,L）
	    int freeDragDx;      // 设计空间中从元素原点指向光标的偏移
	    int freeDragDy;
	    int freeDragStartX;  // 自由画布拖拽起点的设计空间坐标
	    int freeDragStartY;
	    bool freeDragHasMoved; // 是否已产生实质位移（超过阈值），防单击时误解除停靠
	    bool canvasMenuOpen; // 画板右键上下文菜单
	    int canvasMenuX;
	    int canvasMenuY;
	    bool canvasMenuArm;
	    FormField canvasMenuHit; // 右键命中的组件（null 表示画板空白处）
    int freeGuideX;      // 纵向智能参考线的设计空间 x 坐标（-1 = 无）
    int freeGuideY;      // 横向智能参考线的设计空间 y 坐标（-1 = 无）
    FormField hoverField; // 指针悬停命中的可视字段（hover 描边高亮）
    int freeSelPX;       // 选区父级内容的设计空间原点
    int freeSelPY;       // （这样嵌套子级拖动位置才正确）
    int freeDropPX;      // 从工具箱拖入时命中的容器内容框原点
    int freeDropPY;      // （新组件的坐标要相对它）
    bool showGrid;       // 绘制自由画布网格
    bool snapGrid;       // 自由画布上的放置吸附到网格
    int gridSize;        // 自由画布网格步长（设计像素）
    // 自由画布设计尺寸预设下拉框（保留的 SelectBox）以及
    // 最后应用到 winW/winH 的预设索引，这样外部尺寸编辑（检查器的
    // Width/Height 行）会重新同步下拉框，而不是被它
    // 覆盖。
    // 自由画布的平移偏移（屏幕像素，0,0 = 居中/左上），另有
    // 拖拽平移状态：按住画布空白处拖动视口，
    // 用于放大后的设计超出编辑器面板的情况。
    int freePanX;
    int freePanY;
    bool freePanning;
    /// 自由画布上的附加选中项（Ctrl+点击 / 框选），
    /// `sel` 是其中的主选中项（手柄和检查器跟着它）。
    List<FormField> freeExtra;
    // --- 撤销 / 重做与剪贴板 -------------------------------------
    /// 整份设计 JSON 快照（最多 60 份）：任何修改前压栈，
    /// 撤销时把当前快照压回重做栈再载入栈顶。和场景设计器
    /// 同一套模型——SaveJson/LoadJson 就是文档的完整往返。
    List<string> undoStack;
    List<string> redoStack;
    /// 剪贴板：复制选中项的 FieldJson 片段，粘贴时重建
    /// （容器连子级一起）。
    List<string> clipFields;
    bool freeHand;       // 抓手模式：左键拖动即平移画布
    bool freeMarquee;    // 正在空白处拉框选
    int freeMqSX;        // 框选起点（屏幕坐标）
    int freeMqSY;
    int freePanSX;   // 平移拖拽开始时指针的位置
    int freePanSY;
    int freePanOX;   // 平移拖拽开始时的偏移
    int freePanOY;
    // 圆形显示（智能手表）：设计器在自由画布上叠加圆形可视
    // 区域。以 `winRound` 保存在设计 JSON 中。
    bool winRound;
    // 预览缩放（千分比，参见 PvS/PvFont）；1000 = 1:1（流式模式）。
    int pvScale;
    /// 本帧画出的页签矩形（渲染时填，指针处理时读）。
    List<TabHeaderHit> tabHits;
    // 真实控件预览的等比缩放：渲染真控件（输入/表格/图表等）时
    // 临时把 app.dpiScale 和主题度量按视图缩放放大/缩小，让它们
    // 的字号、内边距随画布一起等比缩放，渲染完精确还原。
    // czBase 是被缩放前的主题度量快照，czDpi 是原 dpiScale。
    List<int> czBase;
    int czDpi;
    // 进入缩放前的 app.metricsScale（退出时原值还原）。
    int czScale;
    // 嵌套深度：预览整体已经夹在一层缩放里时，里层的 PvCtrl /
    // 图表等再夹一次只能是空操作，否则度量会被重复缩放。
    int czDepth;

    // 缩放下拉菜单（50%–200% 档位）：点功能区缩放按钮弹出，
    // 在叠层顶部绘制。zoomMenuArm 跳过打开当帧的那次点击，
    // 避免同帧自关。
    bool zoomMenuOpen;
    int zoomMenuX;
    int zoomMenuY;
    bool zoomMenuArm;

    // 表单级配置。
    int labelPos;     // 0 左侧，1 右侧，2 顶部
    int formSize;     // 0 大，1 默认，2 小
    int labelWidth;   // 为标签列预留的逻辑像素宽度
    bool hideStar;    // 隐藏必填字段的红星
    bool showSubmit;
    bool showReset;

    // 拖拽状态（从面板拖到表单添加；表单内拖动排序）。
    bool dragging;
    bool dragFromPalette;
    bool dragMoved;
    int dragKind;     // 正从面板拖出的字段类型
    string dragCustomKind; // 当 dragKind == 100 时的自定义组件 tag
    int dragIndex;    // 排序时的源行索引
    int dropIndex;    // 计算出的插入索引
    int dropY;        // 插入指示线的 y 坐标
    int dragMouseX;
    int dragMouseY;
    // 拖拽指针当前所在的容器（拖拽期间每帧重新计算）；
    // 放置时嵌套进该容器而非顶层表单。
    FormField dropContainer;
    int dragUserComp; // 正在拖拽的用户组件索引，否则为 -1

    // 面板悬停（用于绘制在面板之上的 tooltip）。
    int hoverFt;
    int hoverX;
    int hoverY;

    // 属性表：普通属性行全由它画，检查器只提供 PropSpec 列表。
    PropertyGrid propGrid;
    // 属性表的目标序号：选中目标变了才递增，编辑名字
    // 不会把编辑器重建掉。
    int inspKeySeq;

    // 内联编辑器（跨帧保留；选区变化时重新初始化）。
    // 文本经 GetText()/SetText() 读写——动态宿主没有
    // 编译期字段可绑，不走 Binding<T>（§6.1）。
    Input optInput;
    Input optFieldInput;   // 表格列的数据字段键
    Input evtInput;
    string evtEditing;   // 处理器框正在编辑选中字段的哪个事件
    Input formNameInput;
    Input submitInput;

    // 根窗口（正在设计的最外层组件）：其自身的属性
    // 和事件处理器。未选中任何子级时由检查器编辑。
    /// 窗口标题的唯一真相（普通字段）：标题输入框经 `data` 绑定、
    /// PropertyGrid 的 title 行经 PropSpec.str 指到同一字段。
    string winTitle;
    Input winTitleInput;
    int winW;
    int winH;
    bool winResizable;
    bool winTool;
    bool winCenter;
    bool winGlass;
    int winShape;        // 0 矩形，1 圆角矩形，2 椭圆，3 自定义并集
    int winShapeRadius;  // 圆角半径（逻辑像素）
    string winShapeSpec; // 自定义形状描述 "t,x,y,w,h,r;..."（winShape == 3）
    bool winChrome;      // 绘制自定义标题栏 chrome
    int winOpacity;      // 整窗不透明度百分比（10..100，100 = 保持不透明）
    int winShadow;       // 窗口阴影大小（像素，0 = 无阴影）
    /// 设计文档的 "role"："control" 的文档编译成可嵌入的自定义
    /// 组件（partial class X : Control）而不是窗口。设计器自己
    /// 不用它，但必须原样往返：丢了这一键，一次另存就把组件
    /// 变成窗口，代码后置里的字段访问全部编译不过。
    string docRole;
    int winPosX;   // 手动设置的窗口 X（winCenter 为 false 时使用）
    int winPosY;   // 手动设置的窗口 Y（winCenter 为 false 时使用）
    /// 目标设备画像 id（DeviceProfile，"" = 桌面自由尺寸）。锁定类
    /// 画像下 winW/winH 由画像给出，属性面板不再提供宽高输入，
    /// 只保留画像允许的横竖屏切换。
    string device;
    /// device/方向在属性面板里的镜像下标：每帧从模型同步，
    /// PropertyGrid 经绑定写回，渲染后与模型差量即用户改动。
    int devSelIdx;
    int devOrient;
    List<EventBinding> winEvents;  // 窗口事件 → 处理器的绑定
    string winEvtEditing;          // 处理器框正在编辑哪个窗口事件

    // 组件面板过滤器（搜索框）+ 检查器滚动状态。
    Input filterInput;
    int inspScroll;
    int inspContentH;

    // 从配对的 code-behind 文件扫描出的可绑定变量（宿主 IDE
    // 通过 SetBindVars 提供）。检查器的绑定路径行以
    // 小型选择器展示它们，这样组件可双向绑定到代码变量，
    // 无需手打变量名。
    List<string> bindVars;
    bool bindPickOpen;

    // 可编辑的 JSON 抽屉：设计内容的唯一权威文本框
    // （取代旧的 Save/Load/Export 按钮）。编辑后
    // 点击 Apply 重建设计；打开它则导出当前设计。
    TextArea jsonArea;
    bool jsonOpen;
    bool evtRootPrev;              // 上一次事件标签页的目标是窗口根
    FormField evtSelPrev;         // 上一次事件标签页的组件目标

    // 项目用户组件：保存为可复用组件的设计（宿主
    // IDE 以 components/*.zcomp 持久化并回喂）。保存
    // 请求由检查器发起、宿主消费。
    List<UserComponent> userComps;
    bool saveCompRequested;

    // 引用节点画布预览的构建缓存：key = 代次|组件名|宽x高。
    // 组件文档只在加载/保存时变（SetUserComponents 递增代次），
    // 尺寸变化才重建 FormBuilder 树，其余帧只重渲染。
    List<PreviewControlCache> pvCompCache;
    int pvCompGen;

    // 当前选中引用节点的组件属性声明缓存（组件文档根上的
    // "props":[{key,label,kind,target,prop,def}]，v1 只消费 text 型）。
    // 实例值存引用节点 extra 的 "props" 直通表，序列化/展开全链路
    // 复用既有通道。
    string compPropFor;
    List<CompPropDecl> compPropDecls;

    // 检查器里的组件属性行（即时模式）：每条声明一个输入框 +
    // 影子值，选中节点/组件代次变化时重建；输入变化写回
    // f.extra 的 "props" 直通表。
    string compPropEditFor;
    List<CompPropEditRow> compPropEditRows;

    // 检查器里的 STYLE（CSS 声明行）编辑器：一行一条声明，选中
    // 节点变化时按 f.styleText 重建；输入变化每帧重组写回
    // f.styleText（空行跳过），画布预览下一帧经 FormBuilder.FromField
    // → SetProp("style") 即时生效。
    string styleEditFor;
    List<Input> styleInputs;

    // 选中组件的弹窗式大编辑器（属性面板太窄装不下的批量编辑）：
    // RowsEditor / PropsEditor 都是商业组件设计器同款的主从布局——
    // 顶部工具条（添加/复制/删除/上移/下移 + 计数），左侧带筛选的
    // 行/键列表，右侧选中项的属性表（PropertyGrid），底部说明区 +
    // 关闭。字段指向正在编辑的组件，null = 关闭。
    FormField rowsEdField;
    FormField propsEdField;
    // 两个编辑器里选中的行/键下标（-1 = 无）。selPrev 是已经加载进
    // 右侧属性表暂存字段的行号：变了才重新解析选项原文，PropertyGrid
    // 的编辑器与输入焦点不会每帧被重置。
    int rowsEdSel;
    int rowsEdSelPrev;
    int propsEdSel;
    int propsEdSelPrev;
    // 弹窗打开代次：PropertyGrid.Bind 以它组键，每次打开强制重建
    // 编辑器，丢弃上一轮的影子值。
    int rowsEdGen;
    int propsEdGen;
    // 左侧列表的筛选框（跨帧保留文本）与滚动偏移。
    Input rowsFilter;
    Input propsFilter;
    int rowsScroll;
    int propsScroll;
    // 选中行/键的属性暂存（PropSpec 的绑定目标）：渲染帧内
    // PropertyGrid 读写它们，帧末按组件的存储格式拼回选项原文 /
    // props 直通表。这样右侧就是标准属性表，而存储仍是一个字符串。
    string rowEdTitle;
    string rowEdField;
    bool rowEdRight;
    bool rowEdSep;
    string propEdKey;
    string propEdVal;
    // 表格选中列的声明式属性暂存：存储是 extra["columns"][i]
    // （GenForm 声明式列的同一张表，键缺省 = 引擎缺省），这里只
    // 展开选中列，帧末把偏离缺省的键写回。ofEd 是行实体
    // （extra["of"]）的检查器暂存。
    int colEdWidth;
    int colEdAlign;
    int colEdType;
    bool colEdSortable;
    bool colEdResizable;
    bool colEdEditable;
    // 扩展列声明（GenForm EmitColumn 消费的同一批键）：decimals
    // 仅 real 列生效（缺省 2）；summary 是 sum/avg/min/max/count
    // 五个布尔键的设计器侧归一枚举；pin 归一 left/right。
    int colEdDecimals;
    string colEdMoney;
    bool colEdPercent;
    string colEdPrefix;
    string colEdSuffix;
    bool colEdGrouped;
    int colEdSummary;
    int colEdPin;
    string colEdBand;
    // 列级点击处理器名（extra["columns"][i].click）：GenForm 脱糖
    // 成按 HitField 分派的 CellClick 接线。
    string colEdClick;
    string ofEd;
    // 两个弹窗右侧的属性表（与检查器的 propGrid 分实例：同帧各自
    // 持有自己的编辑器与影子值），以及行编辑器的图标选择入口——
    // PropertyGrid 行里放不下按钮，图标行走隐藏 Input 转交选择器。
    PropertyGrid edGridRows;
    PropertyGrid edGridProps;
    Input iconHolder;
    // 图标选择器：图标格不再手敲名字，点输入框旁的格子按钮弹出
    // 内置图标网格（Icon.Names()），点选写回目标输入框。target 指向
    // 发起选择的那个输入框（行内图标格或追加行的图标格）。
    Input iconPickTarget;
    Input iconPickSearch;
    // 大编辑器的宿主窗口（LayerState 仿真窗口）：标题栏可拖动、
    // 可最小化/最大化/边缘缩放，窗口矩形整体吞命中。内容几何每帧
    // 从窗口的实时 x/y/w/h 读出——拖动/缩放自动跟随，编辑器自己
    // 不再算居中（旧 Layer.Modal 方案的三宗罪：不可移动、遮罩挡
    // 不住画布的原始指针路径、居中坐标各画各的）。
    LayerState rowsWin;
    LayerState propsWin;
    LayerState iconWin;

    // 画布双击引用节点的开门请求：宿主轮询 ConsumeOpenComponent，
    // 打开 components/<名>.zcomp 文档本身供编辑（组件的一等
    // 编辑入口，与「保存为组件」对称）。
    bool openCompRequested;
    string openCompName;

    /// 切换被设计窗口的布局模型。宿主在打开一份设计时
    /// 调用（设计文档里存了 layoutMode），设计器自己不提供
    /// 切换命令：两种布局不共享坐标，来回切会丢摆放。
    void SetLayoutMode(int mode) {
        layoutMode = mode;
        if (mode == 1) { this.SeedFreeBounds(); }
    }

    /// 给还没有绝对坐标的组件在自由画布上排一列，
    /// 免得它们全叠在原点。
    void SeedFreeBounds() {
        int cy2 = 16;
        for (int i = 0; i < fields.Count; i = i + 1) {
            FormField f = fields[i];
            if (f.fw <= 0) { f.fw = 200; }
            if (f.fh <= 0) { f.fh = 32; }
            if (f.fx == 0 && f.fy == 0) {
                f.fx = 16;
                f.fy = cy2;
            }
            cy2 = f.fy + f.fh + 12;
        }
    }

    /// 按当前 UI 语言选取字符串：键式查找（System.Globalization.Lang），
    /// 英文原文作键、内置中文为缺省串；语言包未加载时回退缺省串。
    static string T(string en, string zh) {
        return Lang.Tr(en, zh);
    }

