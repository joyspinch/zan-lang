using System;
using System.Collections.Generic;
using System.Text.Json;
using Gui;
using Gui.Widget;
using Gui.Component;
using Gui.Backend;

namespace Gui.Designer;

public class PaletteItem {
    public int kind;
    public string custom;

    public PaletteItem(int kind, string custom) {
        this.kind = kind;
        this.custom = custom;
    }
}

// DataGrid 列声明强类型实体（收敛设计器内的动态 JsonValue 树散布）。
