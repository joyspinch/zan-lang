using System;
using System.Collections.Generic;
using Gui;
using Gui.Widget;
using Gui.Component;
using Gui.Backend;

namespace Gui.Designer;

public class RibbonAlignCommand {
    public string icon;
    public string label;
    public string tip;
    public string act;
    public bool requiresFree; // 是否需要自由浮动布局 (layoutMode == 1)

    public RibbonAlignCommand(string icon, string label, string tip, string act, bool requiresFree) {
        this.icon = icon != null ? icon : "";
        this.label = label != null ? label : "";
        this.tip = tip != null ? tip : "";
        this.act = act != null ? act : "";
        this.requiresFree = requiresFree;
    }
}
