using System;
using System.Collections.Generic;
using System.Text.Json;
using Gui;
using Gui.Widget;
using Gui.Component;
using Gui.Backend;

namespace Gui.Designer;

class UserComponent {
    public string name;
    public string json;

    UserComponent(string name, string json) {
        this.name = name;
        this.json = json;
    }
}

