using System;
using Gui;
using Gui.Widget;

namespace Gui.Designer;

// 设计器事件选项卡中的单个可编辑事件行实体
public class EventEditRow {
    public string key;
    public string title;
    public string category;
    public Input input;
    public string shadow;
    public string sug;
    public bool isRoot;
    public string rawEv;
    public int toolIdx;
    public int dropBtnId;
    public int jumpBtnId;
    public int labelHitId;

    public EventEditRow(string key, string title, string category, string val, string sug, bool isRoot, string rawEv, int toolIdx) {
        this.key = key != null ? key : "";
        this.title = title != null ? title : "";
        this.category = category != null ? category : "";
        this.input = new Input("");
        this.input.SetText(val != null ? val : "");
        this.shadow = val != null ? val : "";
        this.sug = sug != null ? sug : "";
        this.isRoot = isRoot;
        this.rawEv = rawEv != null ? rawEv : "";
        this.toolIdx = toolIdx;
        this.dropBtnId = WidgetId.Next();
        this.jumpBtnId = WidgetId.Next();
        this.labelHitId = WidgetId.Next();
    }
}
