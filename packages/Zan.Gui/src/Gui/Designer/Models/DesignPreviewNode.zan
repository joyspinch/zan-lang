using System;
using System.Collections.Generic;
using System.Text.Json;
using Gui;
using Gui.Widget;
using Gui.Component;
using Gui.Backend;

namespace Gui.Designer;

public class DesignPreviewNode {
    public FormField field;
    public Control control;
    public int originX;
    public int originY;
    public int insetX;
    public int insetY;
    public bool visible;

    public DesignPreviewNode(FormField field, Control control) {
        this.field = field;
        this.control = control;
    }
}

