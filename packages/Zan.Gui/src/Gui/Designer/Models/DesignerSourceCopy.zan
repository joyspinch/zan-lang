using System;
using System.Collections.Generic;
using System.Text.Json;
using Gui;
using Gui.Widget;
using Gui.Component;
using Gui.Backend;

namespace Gui.Designer;

class DesignerSourceCopy {
    public JsonValue source;
    public JsonValue copy;
    DesignerSourceCopy(JsonValue source, JsonValue copy) {
        this.source = source;
        this.copy = copy;
    }
}
