using System;
using System.Collections.Generic;
using System.Text.Json;
using Gui;
using Gui.Widget;
using Gui.Component;
using Gui.Backend;

namespace Gui.Designer;

public class CompPropEditRow {
    public string key;
    public string label;
    public bool isBool;
    public bool isEnum;
    public bool isIcon;
    public bool isAsset;
    public bool isColor;
    public Input input;
    public Switch sw;
    public SelectBox pick;
    public string shadow;

    public CompPropEditRow(string key, string label, bool isBool, Input input, Switch sw, string shadow) {
        this.key = key != null ? key : "";
        this.label = label != null ? label : "";
        this.isBool = isBool;
        this.isEnum = false;
        this.isIcon = false;
        this.isAsset = false;
        this.isColor = false;
        this.input = input;
        this.sw = sw;
        this.pick = null;
        this.shadow = shadow != null ? shadow : "";
    }
}
