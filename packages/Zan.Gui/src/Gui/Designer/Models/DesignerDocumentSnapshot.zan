using System;
using System.Collections.Generic;
using System.Text.Json;
using Gui;
using Gui.Widget;
using Gui.Component;
using Gui.Backend;

namespace Gui.Designer;

public class DesignerDocumentSnapshot {
    public string name;
    public string submit;
    public string docRole;
    public string device;
    public int labelPos;
    public int formSize;
    public int labelWidth;
    public bool hideStar;
    public bool showSubmit;
    public bool showReset;
    public int winW;
    public int winH;
    public string winTitle;
    public bool winResizable;
    public bool winTool;
    public bool winTopMost;
    public int winMinWidth;
    public int winMinHeight;
    public bool winCenter;
    public int winPosX;
    public int winPosY;
    public int layoutMode;
    public int winZoom;
    public bool winRound;
    public int winShape;
    public string winShapeSpec;
    public int winShapeRadius;
    public bool winChrome;
    public bool winGlass;
    public int winOpacity;
    public int winShadow;
    public JsonValue docSource;
    public List<EventBinding> winEvents = new List<EventBinding>();
    List<FormField> fields = new List<FormField>();
    public int sequence;
    public bool loadError;
    public string lastError = "";
    public bool applied;

    // 不读取 Designer/Input；序列化仅消费独立快照。
    string ToJson() {
        JsonValue o = JsonValue.NewObject();
        o.PutStr("name", name);
        if (docRole != "") { o.PutStr("role", docRole); }
        if (device != "") { o.PutStr("device", device); }
        o.PutInt("labelPos", labelPos);
        o.PutInt("formSize", formSize);
        o.PutInt("labelWidth", labelWidth);
        o.PutBool("hideStar", hideStar);
        o.PutBool("showSubmit", showSubmit);
        o.PutBool("showReset", showReset);
        o.PutStr("submit", submit);
        o.PutInt("winW", winW);
        o.PutInt("winH", winH);
        o.PutStr("winTitle", winTitle);
        o.PutBool("winResizable", winResizable);
        o.PutBool("winTool", winTool);
        o.PutBool("winTopMost", winTopMost);
        if (winMinWidth > 0) { o.PutInt("winMinWidth", winMinWidth); }
        if (winMinHeight > 0) { o.PutInt("winMinHeight", winMinHeight); }
        o.PutBool("winCenter", winCenter);
        o.PutInt("winPosX", winPosX);
        o.PutInt("winPosY", winPosY);
        o.PutInt("layoutMode", layoutMode);
        o.PutInt("winZoom", winZoom);
        o.PutBool("winRound", winRound);
        if (winShape != 3) { o.PutInt("winShape", winShape); }
        else {
            JsonValue regions = JsonValue.NewArray();
            List<string> parts = winShapeSpec.Split(";");
            for (int i = 0; i < parts.Count; i = i + 1) {
                List<string> values = parts[i].Split(",");
                if (values.Count < 6) { continue; }
                JsonValue region = JsonValue.NewObject();
                region.Put("t", JsonValue.NewNum(values[0]));
                region.Put("x", JsonValue.NewNum(values[1]));
                region.Put("y", JsonValue.NewNum(values[2]));
                region.Put("w", JsonValue.NewNum(values[3]));
                region.Put("h", JsonValue.NewNum(values[4]));
                region.Put("r", JsonValue.NewNum(values[5]));
                regions.Append(region);
            }
            o.Put("winShape", regions);
        }
        o.PutInt("winShapeRadius", winShapeRadius);
        o.PutBool("winChrome", winChrome);
        o.PutBool("winGlass", winGlass);
        o.PutInt("winOpacity", winOpacity);
        o.PutInt("winShadow", winShadow);
        for (int i = 0; i < winEvents.Count; i = i + 1) {
            if (winEvents[i].val != "") {
                o.PutStr("on" + winEvents[i].key, winEvents[i].val);
            }
        }
        JsonValue arr = JsonValue.NewArray();
        for (int i = 0; i < fields.Count; i = i + 1) {
            arr.Append(Designer.PreparedFieldJson(fields[i]));
        }
        o.Put("fields", arr);
        if (docSource != null && docSource.IsObject()) {
            for (int i = 0; i < docSource.Count(); i = i + 1) {
                string key = docSource.KeyAt(i);
                if (!o.Has(key)) { o.Put(key, docSource.ValAt(i)); }
            }
            if (docSource.Has("bodyContent")) {
                o.Set("bodyContent", Designer.PreparedRemapContent(docSource.Get("bodyContent"),
                    docSource.Get("fields"), fields));
            }
        }
        return o.PrettyToJson() + "\n";
    }

    string ToHtml() { return DesignerHtml.FromJsonDoc(this.ToJson()); }

    DesignerDocumentSnapshot Copy() {
        DesignerDocumentSnapshot s = new DesignerDocumentSnapshot();
        s.name = name; s.submit = submit; s.docRole = docRole; s.device = device;
        s.labelPos = labelPos; s.formSize = formSize; s.labelWidth = labelWidth;
        s.hideStar = hideStar; s.showSubmit = showSubmit; s.showReset = showReset;
        s.winW = winW; s.winH = winH; s.winTitle = winTitle;
        s.winResizable = winResizable; s.winTool = winTool; s.winTopMost = winTopMost;
        s.winMinWidth = winMinWidth; s.winMinHeight = winMinHeight; s.winCenter = winCenter;
        s.winPosX = winPosX; s.winPosY = winPosY; s.layoutMode = layoutMode; s.winZoom = winZoom;
        s.winRound = winRound; s.winShape = winShape; s.winShapeSpec = winShapeSpec;
        s.winShapeRadius = winShapeRadius; s.winChrome = winChrome; s.winGlass = winGlass;
        s.winOpacity = winOpacity; s.winShadow = winShadow; s.sequence = sequence;
        s.loadError = loadError; s.lastError = lastError;
        for (int i = 0; i < winEvents.Count; i = i + 1) {
            s.winEvents.Add(new EventBinding(winEvents[i].key, winEvents[i].val));
        }
        List<DesignerSourceCopy> copies = new List<DesignerSourceCopy>();
        s.docSource = Designer.CopyDocumentSource(docSource, copies);
        s.fields = Designer.CopyDocumentFields(fields, copies);
        return s;
    }
}
