using System;
using System.Collections.Generic;

namespace Gui.Designer;

// 布局差量操作类型枚举（Live Layout Protocol）
public enum LiveDeltaOpKind {
    SetAttr,     // 修改或新增属性
    RemoveAttr,  // 移除属性
    SetText,     // 更新元素文本内容
    SetStyle,    // 差量更新样式表字段
    InsertNode,  // 插入新节点
    RemoveNode   // 移除节点
}

// 布局微小差量变更指令包，支持毫秒级无损更新设计器 DOM / 控件树
public class LiveDeltaOp {
    public LiveDeltaOpKind kind;
    public string targetId;
    public string key;
    public string value;

    public LiveDeltaOp(LiveDeltaOpKind kind, string targetId, string key, string value) {
        this.kind = kind;
        this.targetId = targetId != null ? targetId : "";
        this.key = key != null ? key : "";
        this.value = value != null ? value : "";
    }

    public static LiveDeltaOp Attr(string targetId, string key, string value) {
        return new LiveDeltaOp(LiveDeltaOpKind.SetAttr, targetId, key, value);
    }

    public static LiveDeltaOp Text(string targetId, string text) {
        return new LiveDeltaOp(LiveDeltaOpKind.SetText, targetId, "text", text);
    }

    public static LiveDeltaOp Style(string targetId, string prop, string val) {
        return new LiveDeltaOp(LiveDeltaOpKind.SetStyle, targetId, prop, val);
    }

    public static LiveDeltaOp Remove(string targetId) {
        return new LiveDeltaOp(LiveDeltaOpKind.RemoveNode, targetId, "", "");
    }
}

// ZanIDE 表单/页面设计器实时预览差量会话协议（Live Layout Engine）。
// 在 HTML/CSS/JSON 发生微调时，通过发送细粒度差量包（LiveDeltaBatch），
// 避免整树全量重绘或重新编译运行，达成毫秒级即时预览。
public class LiveLayoutSession {
    public string sessionId;
    public long version;
    public List<LiveDeltaOp> pendingDeltas;

    public LiveLayoutSession(string sessionId) {
        this.sessionId = sessionId != null ? sessionId : "default";
        this.version = 0;
        this.pendingDeltas = new List<LiveDeltaOp>();
    }

    public static LiveLayoutSession Create(string id) {
        return new LiveLayoutSession(id);
    }

    // 追加一条差量更新操作
    public void Push(LiveDeltaOp op) {
        if (op != null) {
            this.pendingDeltas.Add(op);
            this.version = this.version + 1;
        }
    }

    // 批量生成差量并清空暂存
    public List<LiveDeltaOp> Flush() {
        List<LiveDeltaOp> batch = new List<LiveDeltaOp>();
        for (int i = 0; i < this.pendingDeltas.Count; i = i + 1) {
            batch.Add(this.pendingDeltas[i]);
        }
        this.pendingDeltas.Clear();
        return batch;
    }

    // 获取未刷新操作数
    public int PendingCount {
        get { return this.pendingDeltas.Count; }
    }
}
