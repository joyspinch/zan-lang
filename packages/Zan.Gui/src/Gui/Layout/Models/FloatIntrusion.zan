using System;
using System.Collections.Generic;
using Gui;

namespace Gui;

public class FloatIntrusion {
    public int side;  // 1 left / 2 right
    public int x0;  // 左缘（right float = 压可用宽的边界）
    public int x1;  // 右缘（left float = xOff 抬到这里）
    public int yTop;
    public int yBot;
}

// 行顶查询结果：xOff = 左侧 float 抬起的行左缘，availW = 右侧
// float 压剩的右边界（都是容器内容框坐标；行内 limit 用
// availW − xOff 现算）。
