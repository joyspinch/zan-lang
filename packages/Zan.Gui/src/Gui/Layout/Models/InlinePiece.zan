using System;
using System.Collections.Generic;
using Gui;

namespace Gui;

// 放不下整行下坠（绕排）。
public class InlinePiece {
    public Control owner;  // 文本所有者（原子盒 = 盒子本身）；strut 为 null
    public bool isStrut;  // 行盒支柱：只贡献行高，不落位
    public bool isBox;  // 原子盒（inline-block/带子元素的行内容器）
    public bool isSpace;  // 可折叠空白（normal 分词；行首/断点处消失，不绘制）
    public bool hardBreak;  // 此 piece 后强制断行（white-space:pre 的 \n）
    public string text;  // 文本内容（空格 piece 为单个空格）
    public StyleBox st;  // 生效样式（owner 的计算样式）
    public int fs;  // 字号
    public int w;  // 度量宽（原子盒含水平 margin）
    public int lh;  // 行高贡献
    public int asc;  // 基线上高（原子盒 = margin-top + 盒高）
    public int desc;  // 基线下高（= lh − asc；原子盒 = margin-bottom）
    public int ascOff;  // 绘制偏移：DrawText y = 行内 top + ascOff
    public int boxH;  // 原子盒高（不含 margin）
    public int ml;  // 原子盒水平 margin
    public int mr;
    public int x;  // Layout 输出：行内 x（未含对齐偏移）
}

// 块流内容序列的条目（P2）：文本块（text 非空）或子项。块流容器
// 按文档序分段——文本与行内子项连续的区段合成匿名块排行盒，
// 块级子项截断段（CSS 匿名块模型）。
