using System;
using System.Collections.Generic;
using Gui;
namespace Gui;

public class FloatIntrusion {
    public int side;  // 1 left / 2 right
    public int x0;  // 左缘（right float = 压可用宽的边界）
    public int x1;  // 右缘（left float = xOff 抬到这里）
    public int yTop;
    public int yBot;
}

public class FlowSegment {
    public List<InlineLine> lines;
    public int height;  // Σ 行高
    public int width;  // 最宽行
}

public class GridItemSlot {
    public int colStart;  // 0 基
    public int colSpan;
    public int rowStart;
    public int rowSpan;
    GridItemSlot(int cs, int cp, int rs, int rp) {
        this.colStart = cs;
        this.colSpan = cp;
        this.rowStart = rs;
        this.rowSpan = rp;
    }
}

public class GridLine {
    public int start;  // 1 基线号，0 = auto
    public int end;  // 1 基线号（不含），0 = auto
    public int span;  // >0 = 显式 span（"span N"）
}

public class GridPlace {
    public List<GridItemSlot> slots;
    public int nCols;
    public int nRows;
}

public class GridTrack {
    public int kind;
    public int val;
    public int minKind; int minVal;
    public int maxKind; int maxVal;
}

public class InlineLine {
    public List<InlinePiece> pieces;
    public int width;
    public int asc;
    public int desc;
    public int xOff;
    public int availW;
    public int yOff;
}

public class InlinePiece {
    public StyleNode owner;  // 文本所有者（原子盒 = 盒子本身）；strut 为 null
    public bool isStrut;  // 行盒支柱：只贡献行高，不落位
    public bool isBox;  // 原子盒（inline-block/带子元素的行内容器）
    public bool isSpace;  // 可折叠空白（normal 分词；行首/断点处消失，不绘制）
    public bool hardBreak;  // 此 piece 后强制断行（white-space:pre 的 \n）
    public string text;  // 文本内容（空格 piece 为单个空格）
    public StyleBox st;  // 生效样式（owner 的计算样式）
    public int fs;  // 字号
    public int w;  // 度量宽（原子盒含水平 margin）
    public int lh;  // 行高贡献
    public int asc;  // 基线上高（原子盒 = margin-top + 盒高）
    public int desc;  // 基线下高（= lh − asc；原子盒 = margin-bottom）
    public int ascOff;  // 绘制偏移：DrawText y = 行内 top + ascOff
    public int boxH;  // 原子盒高（不含 margin）
    public int ml;  // 原子盒水平 margin
    public int mr;
    public int x;  // Layout 输出：行内 x（未含对齐偏移）
}

public class LineSpan {
    public int xOff;
    public int availW;
}
