using System;
using System.Collections.Generic;
using Gui;

namespace Gui;

public class GridItemSlot {
    public int colStart;  // 0 基
    public int colSpan;
    public int rowStart;
    public int rowSpan;

    GridItemSlot(int cs, int cp, int rs, int rp) {
        this.colStart = cs;
        this.colSpan = cp;
        this.rowStart = rs;
        this.rowSpan = rp;
    }
}
