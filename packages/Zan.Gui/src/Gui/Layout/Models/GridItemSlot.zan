using System;
using System.Collections.Generic;
using Gui;

namespace Gui;

public class GridItemSlot {
    public int colStart;  // 0 基
    public int colSpan;
    public int rowStart;
    public int rowSpan;

    GridItemSlot(int cs, int cp, int rs, int rp) {
        this.colStart = cs;
        this.colSpan = cp;
        this.rowStart = rs;
        this.rowSpan = rp;
    }
}

// 一次放置的输出：条目槽位实体数组（0 基格子坐标 + span），以及网格
// 最终的列/行数（含隐式轨道）。测量与排布端各算一遍，结果一致
// （纯函数，无状态）。
