using System;
using System.Collections.Generic;
using Gui;

namespace Gui;

// 一条 grid-column/row 声明的解析结果。
public class GridLine {
    public int start;  // 1 基线号，0 = auto
    public int end;  // 1 基线号（不含），0 = auto
    public int span;  // >0 = 显式 span（"span N"）
}

// 一条轨道定义。kind：0 px，1 %（千分），2 auto，3 fr，4 minmax；
// minmax 的上下限用同一套 kind/val 编码存在 min*/max* 里。
