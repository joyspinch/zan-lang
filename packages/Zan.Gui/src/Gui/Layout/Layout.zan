using System;

namespace Gui;

/// CSS Flexbox 布局引擎（纯 Zan 实现）。
/// 支持：direction、justify、align、gap、wrap、grow/shrink、padding/margin。

class FlexStyle {
    int direction;
    int justify;
    int alignItems;
    int flexGrow;
    int flexShrink;
    int width;
    int height;
    int minWidth;
    int minHeight;
    int maxWidth;
    int maxHeight;
    int padTop;
    int padRight;
    int padBottom;
    int padLeft;
    int marginTop;
    int marginRight;
    int marginBottom;
    int marginLeft;
    int gap;
    int position;     // 0 = relative/flow (流式排列), 1 = absolute/float (脱离文档流浮动定位)
    int left;         // 浮动左偏移（-999999 = auto）
    int top;          // 浮动上偏移（-999999 = auto）
    int right;        // 浮动右偏移（-999999 = auto）
    int bottom;       // 浮动下偏移（-999999 = auto）
    int anchor;       // 0=None, 1=TopLeft, 2=TopCenter, 3=TopRight, 4=CenterLeft, 5=Center, 6=CenterRight, 7=BottomLeft, 8=BottomCenter, 9=BottomRight, 10=Stretch
    int zIndex;       // 浮动层级

    /// 全默认样式：水平排列、交叉轴拉伸（align=3）、允许收缩、宽高取容器尺寸（-1）。
    static FlexStyle Default() {
        FlexStyle s = new FlexStyle();
        s.direction = 0;
        s.justify = 0;
        s.alignItems = 3;
        s.flexGrow = 0;
        s.flexShrink = 1000;
        s.width = -1;
        s.height = -1;
        s.minWidth = 0;
        s.minHeight = 0;
        s.maxWidth = -1;
        s.maxHeight = -1;
        s.padTop = 0;
        s.padRight = 0;
        s.padBottom = 0;
        s.padLeft = 0;
        s.marginTop = 0;
        s.marginRight = 0;
        s.marginBottom = 0;
        s.marginLeft = 0;
        s.gap = 0;
        s.position = 0;
        s.left = -999999;
        s.top = -999999;
        s.right = -999999;
        s.bottom = -999999;
        s.anchor = 0;
        s.zIndex = 0;
        return s;
    }

    /// 水平排列（主轴 = 行方向）的样式起点。
    static FlexStyle Row() {
        FlexStyle s = FlexStyle.Default();
        s.direction = 0;
        return s;
    }

    /// 垂直排列（主轴 = 列方向）的样式起点。
    static FlexStyle Column() {
        FlexStyle s = FlexStyle.Default();
        s.direction = 1;
        return s;
    }

    /// 四边内边距（上右下左，顺时针），单位与容器一致（像素或设计单位）。
    FlexStyle SetPadding(int top, int right, int bottom, int left) {
        padTop = top;
        padRight = right;
        padBottom = bottom;
        padLeft = left;
        return this;
    }

    /// 四边统一内边距。
    FlexStyle SetPaddingAll(int p) {
        padTop = p;
        padRight = p;
        padBottom = p;
        padLeft = p;
        return this;
    }

    /// 子项之间的主轴间距。
    FlexStyle SetGap(int g) {
        gap = g;
        return this;
    }

    /// 固定尺寸；-1 表示该轴取容器尺寸（行内子项的交叉轴默认拉伸即来源于此）。
    FlexStyle SetSize(int w, int h) {
        width = w;
        height = h;
        return this;
    }

    /// 主轴弹性权重：剩余空间按各子项 grow 比例分配。
    FlexStyle SetGrow(int g) {
        flexGrow = g;
        return this;
    }

    /// 主轴对齐：0=起始 1=居中 2=末尾 3=两端间均分 4=两侧环绕 5=evenly 均分。
    FlexStyle SetJustify(int j) {
        justify = j;
        return this;
    }

    /// 交叉轴对齐：0=起始 1=居中 2=末尾 3(默认)=拉伸填满。
    FlexStyle SetAlign(int a) {
        alignItems = a;
        return this;
    }

    /// 设置定位模式（0=文档流 flow, 1=脱离文档流浮动 float/absolute）。
    FlexStyle SetPosition(int pos) {
        position = pos;
        return this;
    }

    /// 设置浮动四向偏移（-999999 = auto）。
    FlexStyle SetOffsets(int l, int t, int r, int b) {
        left = l;
        top = t;
        right = r;
        bottom = b;
        return this;
    }

    /// 快捷设置浮动/绝对定位偏移：left 与 top。
    FlexStyle SetFloat(int l, int t) {
        position = 1;
        left = l;
        top = t;
        right = -999999;
        bottom = -999999;
        return this;
    }

    /// 快捷设置锚点/停靠模式（1=TopLeft, 2=TopCenter, 3=TopRight, 4=CenterLeft, 5=Center, 6=CenterRight, 7=BottomLeft, 8=BottomCenter, 9=BottomRight, 10=Stretch）。
    FlexStyle SetAnchor(int a) {
        position = 1;
        anchor = a;
        return this;
    }

    /// 设置层级 zIndex。
    FlexStyle SetZIndex(int z) {
        zIndex = z;
        return this;
    }
}

/// 解算树的节点：持有一个 FlexStyle、子节点列表，以及
/// Compute 写入的结果矩形（resultX/Y/W/H）与内容尺寸（contentW/H）。
class FlexNode {
    FlexStyle style;
    List<FlexNode> children;
    int resultX;
    int resultY;
    int resultW;
    int resultH;
    int contentW;
    int contentH;

    /// 构建解算树的节点：持有一个样式与子节点列表。
    FlexNode(FlexStyle s) {
        this.style = s;
        this.children = new List<FlexNode>();
        this.resultX = 0;
        this.resultY = 0;
        this.resultW = 0;
        this.resultH = 0;
        this.contentW = 0;
        this.contentH = 0;
    }

    /// 添加子节点，返回 this 便于链式构建。
    FlexNode AddChild(FlexNode child) {
        children.Add(child);
        return this;
    }

    /// 以给定容器尺寸解算整棵子树；结果写入各节点 resultX/Y/W/H（相对父节点内容框），
    /// contentW/H 为内容实际尺寸。解算前可修改样式，重算需重新调用。
    void Compute(int containerW, int containerH) {
        int w = style.width;
        int h = style.height;
        if (w < 0) { w = containerW; }
        if (h < 0) { h = containerH; }
        if (style.maxWidth >= 0 && w > style.maxWidth) { w = style.maxWidth; }
        if (style.maxHeight >= 0 && h > style.maxHeight) { h = style.maxHeight; }
        if (w < style.minWidth) { w = style.minWidth; }
        if (h < style.minHeight) { h = style.minHeight; }

        resultW = w;
        resultH = h;

        int innerW = w - style.padLeft - style.padRight;
        int innerH = h - style.padTop - style.padBottom;
        if (innerW < 0) { innerW = 0; }
        if (innerH < 0) { innerH = 0; }

        int count = children.Count;
        if (count == 0) { return; }

        bool isRow = style.direction == 0;
        int totalFixed = 0;
        int totalGrow = 0;
        int flowCount = 0;

        int i = 0;
        for (; i < count; i = i + 1) {
            FlexNode child = children[i];
            int cw = child.style.width;
            int ch = child.style.height;
            if (cw < 0 && !isRow) { cw = innerW; }
            if (ch < 0 && isRow) { ch = innerH; }
            if (cw < 0) { cw = 0; }
            if (ch < 0) { ch = 0; }

            child.Compute(cw, ch);

            // 脱离文档流的浮动组件（position == 1）不占用主轴弹性空间
            if (child.style.position == 1) {
                continue;
            }

            flowCount = flowCount + 1;
            if (isRow) {
                totalFixed = totalFixed + child.resultW + child.style.marginLeft + child.style.marginRight;
                totalGrow = totalGrow + child.style.flexGrow;
            } else {
                totalFixed = totalFixed + child.resultH + child.style.marginTop + child.style.marginBottom;
                totalGrow = totalGrow + child.style.flexGrow;
            }
        }

        int gaps = 0;
        if (flowCount > 1) { gaps = (flowCount - 1) * style.gap; }

        int mainSize = innerW;
        if (!isRow) { mainSize = innerH; }
        int freeSpace = mainSize - totalFixed - gaps;
        if (freeSpace < 0) { freeSpace = 0; }

        if (totalGrow > 0) {
            i = 0;
            while (i < count) {
                FlexNode child = children[i];
                if (child.style.position != 1 && child.style.flexGrow > 0) {
                    int extra = freeSpace * child.style.flexGrow / totalGrow;
                    if (isRow) {
                        child.resultW = child.resultW + extra;
                    } else {
                        child.resultH = child.resultH + extra;
                    }
                }
                i = i + 1;
            }
            freeSpace = 0;
        }

        int offset = 0;
        int spaceBefore = 0;
        int spaceBetween = style.gap;

        if (style.justify == 1) {
            offset = freeSpace / 2;
        } else if (style.justify == 2) {
            offset = freeSpace;
        } else if (style.justify == 3 && flowCount > 1) {
            spaceBetween = freeSpace / (flowCount - 1) + style.gap;
        } else if (style.justify == 4) {
            int totalSpaces = flowCount * 2;
            if (totalSpaces > 0) {
                spaceBefore = freeSpace / totalSpaces;
                spaceBetween = spaceBefore * 2 + style.gap;
                offset = spaceBefore;
            }
        } else if (style.justify == 5 && flowCount > 0) {
            int totalSpaces = flowCount + 1;
            spaceBefore = freeSpace / totalSpaces;
            spaceBetween = spaceBefore + style.gap;
            offset = spaceBefore;
        }

        int pos = offset;
        i = 0;
        while (i < count) {
            FlexNode child = children[i];
            int mx = style.padLeft;
            int my = style.padTop;

            if (child.style.position == 1) {
                // 浮动/绝对定位解算：依据 left/top/right/bottom 与 anchor
                int anc = child.style.anchor;
                int l = child.style.left;
                int t = child.style.top;
                int r = child.style.right;
                int b = child.style.bottom;

                if (anc == 1) { // TopLeft
                    child.resultX = mx + (l != -999999 ? l : 0);
                    child.resultY = my + (t != -999999 ? t : 0);
                } else if (anc == 2) { // TopCenter (如游戏 Boss 血条)
                    child.resultX = mx + (innerW - child.resultW) / 2 + (l != -999999 ? l : 0);
                    child.resultY = my + (t != -999999 ? t : 0);
                } else if (anc == 3) { // TopRight (如小地图)
                    child.resultX = mx + innerW - child.resultW - (r != -999999 ? r : 0);
                    child.resultY = my + (t != -999999 ? t : 0);
                } else if (anc == 4) { // CenterLeft (如左侧任务栏)
                    child.resultX = mx + (l != -999999 ? l : 0);
                    child.resultY = my + (innerH - child.resultH) / 2 + (t != -999999 ? t : 0);
                } else if (anc == 5) { // Center (居中对话框/弹窗)
                    child.resultX = mx + (innerW - child.resultW) / 2 + (l != -999999 ? l : 0);
                    child.resultY = my + (innerH - child.resultH) / 2 + (t != -999999 ? t : 0);
                } else if (anc == 6) { // CenterRight
                    child.resultX = mx + innerW - child.resultW - (r != -999999 ? r : 0);
                    child.resultY = my + (innerH - child.resultH) / 2 + (t != -999999 ? t : 0);
                } else if (anc == 7) { // BottomLeft (如聊天框)
                    child.resultX = mx + (l != -999999 ? l : 0);
                    child.resultY = my + innerH - child.resultH - (b != -999999 ? b : 0);
                } else if (anc == 8) { // BottomCenter (如技能快捷栏)
                    child.resultX = mx + (innerW - child.resultW) / 2 + (l != -999999 ? l : 0);
                    child.resultY = my + innerH - child.resultH - (b != -999999 ? b : 0);
                } else if (anc == 9) { // BottomRight (如菜单按钮组)
                    child.resultX = mx + innerW - child.resultW - (r != -999999 ? r : 0);
                    child.resultY = my + innerH - child.resultH - (b != -999999 ? b : 0);
                } else if (anc == 10) { // Stretch (全屏覆盖/蒙版)
                    child.resultX = mx;
                    child.resultY = my;
                    child.resultW = innerW;
                    child.resultH = innerH;
                } else { // 自由绝对偏移
                    if (l != -999999) { child.resultX = mx + l; }
                    else if (r != -999999) { child.resultX = mx + innerW - child.resultW - r; }
                    else { child.resultX = mx; }

                    if (t != -999999) { child.resultY = my + t; }
                    else if (b != -999999) { child.resultY = my + innerH - child.resultH - b; }
                    else { child.resultY = my; }
                }

                i = i + 1;
                continue;
            }

            if (isRow) {
                pos = pos + child.style.marginLeft;
                child.resultX = mx + pos;

                int crossSize = innerH - child.style.marginTop - child.style.marginBottom;
                if (style.alignItems == 0) {
                    child.resultY = my + child.style.marginTop;
                } else if (style.alignItems == 1) {
                    child.resultY = my + child.style.marginTop + (crossSize - child.resultH) / 2;
                } else if (style.alignItems == 2) {
                    child.resultY = my + child.style.marginTop + crossSize - child.resultH;
                } else {
                    child.resultY = my + child.style.marginTop;
                    child.resultH = crossSize;
                }

                pos = pos + child.resultW + child.style.marginRight;
            } else {
                pos = pos + child.style.marginTop;
                child.resultY = my + pos;

                int crossSize = innerW - child.style.marginLeft - child.style.marginRight;
                if (style.alignItems == 0) {
                    child.resultX = mx + child.style.marginLeft;
                } else if (style.alignItems == 1) {
                    child.resultX = mx + child.style.marginLeft + (crossSize - child.resultW) / 2;
                } else if (style.alignItems == 2) {
                    child.resultX = mx + child.style.marginLeft + crossSize - child.resultW;
                } else {
                    child.resultX = mx + child.style.marginLeft;
                    child.resultW = crossSize;
                }

                pos = pos + child.resultH + child.style.marginBottom;
            }

            pos = pos + spaceBetween;
            i = i + 1;
        }
    }
}
