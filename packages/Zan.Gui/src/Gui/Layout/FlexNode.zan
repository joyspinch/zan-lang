using System;

namespace Gui;


// 解算树的节点：持有一个 FlexStyle、子节点列表，以及
// Compute 写入的结果矩形（resultX/Y/W/H）与内容尺寸（contentW/H）。
public class FlexNode {
    FlexStyle style;
    List<FlexNode> children;
    int resultX;
    int resultY;
    int resultW;
    int resultH;
    int contentW;
    int contentH;

    // 构建解算树的节点：持有一个样式与子节点列表。
    FlexNode(FlexStyle s) {
        this.style = s;
        this.children = null;
        this.resultX = 0;
        this.resultY = 0;
        this.resultW = 0;
        this.resultH = 0;
        this.contentW = 0;
        this.contentH = 0;
    }

    // 添加子节点，返回 this 便于链式构建。
    FlexNode AddChild(FlexNode child) {
        if (this.children == null) {
            this.children = new List<FlexNode>();
        }
        children.Add(child);
        return this;
    }

    // 以给定容器尺寸解算整棵子树；结果写入各节点 resultX/Y/W/H（相对父节点内容框），
    // contentW/H 为内容实际尺寸。解算前可修改样式，重算需重新调用。
    void Compute(int containerW, int containerH) {
        int w = style.width;
        int h = style.height;
        if (w < 0) { w = containerW; }
        if (h < 0) { h = containerH; }
        if (style.maxWidth >= 0 && w > style.maxWidth) { w = style.maxWidth; }
        if (style.maxHeight >= 0 && h > style.maxHeight) { h = style.maxHeight; }
        if (w < style.minWidth) { w = style.minWidth; }
        if (h < style.minHeight) { h = style.minHeight; }

        resultW = w;
        resultH = h;

        int innerW = w - style.padLeft - style.padRight;
        int innerH = h - style.padTop - style.padBottom;
        if (innerW < 0) { innerW = 0; }
        if (innerH < 0) { innerH = 0; }

        int count = this.children != null ? this.children.Count : 0;
        if (count == 0) { return; }

        bool isRow = style.direction == 0;
        int totalFixed = 0;
        int totalGrow = 0;
        int flowCount = 0;

        int i = 0;
        for (; i < count; i = i + 1) {
            FlexNode child = children[i];
            int cw = child.style.width;
            int ch = child.style.height;
            if (cw < 0 && !isRow) { cw = innerW; }
            if (ch < 0 && isRow) { ch = innerH; }
            if (cw < 0) { cw = 0; }
            if (ch < 0) { ch = 0; }

            child.Compute(cw, ch);

            // 脱离文档流的浮动组件（position == 1）不占用主轴弹性空间
            if (child.style.position == 1) {
                continue;
            }

            flowCount = flowCount + 1;
            if (isRow) {
                totalFixed = totalFixed + child.resultW + child.style.marginLeft + child.style.marginRight;
                totalGrow = totalGrow + child.style.flexGrow;
            } else {
                totalFixed = totalFixed + child.resultH + child.style.marginTop + child.style.marginBottom;
                totalGrow = totalGrow + child.style.flexGrow;
            }
        }

        int gaps = 0;
        if (flowCount > 1) { gaps = (flowCount - 1) * style.gap; }

        int mainSize = innerW;
        if (!isRow) { mainSize = innerH; }
        int freeSpace = mainSize - totalFixed - gaps;
        if (freeSpace < 0) { freeSpace = 0; }

        if (totalGrow > 0 && freeSpace > 0) {
            i = 0;
            if (totalGrow == 1) {
                while (i < count) {
                    FlexNode child = children[i];
                    if (child.style.position != 1 && child.style.flexGrow > 0) {
                        if (isRow) {
                            child.resultW = child.resultW + freeSpace;
                        } else {
                            child.resultH = child.resultH + freeSpace;
                        }
                    }
                    i = i + 1;
                }
            } else {
                while (i < count) {
                    FlexNode child = children[i];
                    if (child.style.position != 1 && child.style.flexGrow > 0) {
                        int extra = freeSpace * child.style.flexGrow / totalGrow;
                        if (isRow) {
                            child.resultW = child.resultW + extra;
                        } else {
                            child.resultH = child.resultH + extra;
                        }
                    }
                    i = i + 1;
                }
            }
            freeSpace = 0;
        }

        int offset = 0;
        int spaceBefore = 0;
        int spaceBetween = style.gap;

        if (freeSpace > 0) {
            if (style.justify == 1) {
                offset = freeSpace >> 1;
            } else if (style.justify == 2) {
                offset = freeSpace;
            } else if (style.justify == 3 && flowCount > 1) {
                spaceBetween = freeSpace / (flowCount - 1) + style.gap;
            } else if (style.justify == 4) {
                int totalSpaces = flowCount << 1;
                if (totalSpaces > 0) {
                    spaceBefore = freeSpace / totalSpaces;
                    spaceBetween = (spaceBefore << 1) + style.gap;
                    offset = spaceBefore;
                }
            } else if (style.justify == 5 && flowCount > 0) {
                int totalSpaces = flowCount + 1;
                spaceBefore = freeSpace / totalSpaces;
                spaceBetween = spaceBefore + style.gap;
                offset = spaceBefore;
            }
        }

        int pos = offset;
        int mx = style.padLeft;
        int my = style.padTop;
        int align = style.alignItems;
        i = 0;
        while (i < count) {
            FlexNode child = children[i];

            if (child.style.position == 1) {
                // 浮动/绝对定位解算：依据 left/top/right/bottom 与 anchor
                int anc = child.style.anchor;
                int l = child.style.left;
                int t = child.style.top;
                int r = child.style.right;
                int b = child.style.bottom;
                int offL = l != -999999 ? l : 0;
                int offT = t != -999999 ? t : 0;
                int offR = r != -999999 ? r : 0;
                int offB = b != -999999 ? b : 0;

                if (anc == 1) {  // TopLeft
                    child.resultX = mx + offL;
                    child.resultY = my + offT;
                } else if (anc == 2) {  // TopCenter (如游戏 Boss 血条)
                    child.resultX = mx + ((innerW - child.resultW) >> 1) + offL;
                    child.resultY = my + offT;
                } else if (anc == 3) {  // TopRight (如小地图)
                    child.resultX = mx + innerW - child.resultW - offR;
                    child.resultY = my + offT;
                } else if (anc == 4) {  // CenterLeft (如左侧任务栏)
                    child.resultX = mx + offL;
                    child.resultY = my + ((innerH - child.resultH) >> 1) + offT;
                } else if (anc == 5) {  // Center (居中对话框/弹窗)
                    child.resultX = mx + ((innerW - child.resultW) >> 1) + offL;
                    child.resultY = my + ((innerH - child.resultH) >> 1) + offT;
                } else if (anc == 6) {  // CenterRight
                    child.resultX = mx + innerW - child.resultW - offR;
                    child.resultY = my + ((innerH - child.resultH) >> 1) + offT;
                } else if (anc == 7) {  // BottomLeft (如聊天框)
                    child.resultX = mx + offL;
                    child.resultY = my + innerH - child.resultH - offB;
                } else if (anc == 8) {  // BottomCenter (如技能快捷栏)
                    child.resultX = mx + ((innerW - child.resultW) >> 1) + offL;
                    child.resultY = my + innerH - child.resultH - offB;
                } else if (anc == 9) {  // BottomRight (如菜单按钮组)
                    child.resultX = mx + innerW - child.resultW - offR;
                    child.resultY = my + innerH - child.resultH - offB;
                } else if (anc == 10) {  // Stretch (全屏覆盖/蒙版)
                    child.resultX = mx;
                    child.resultY = my;
                    child.resultW = innerW;
                    child.resultH = innerH;
                } else {  // 自由绝对偏移
                    if (l != -999999) { child.resultX = mx + l; }
                    else if (r != -999999) { child.resultX = mx + innerW - child.resultW - r; }
                    else { child.resultX = mx; }

                    if (t != -999999) { child.resultY = my + t; }
                    else if (b != -999999) { child.resultY = my + innerH - child.resultH - b; }
                    else { child.resultY = my; }
                }

                i = i + 1;
                continue;
            }

            if (isRow) {
                pos = pos + child.style.marginLeft;
                child.resultX = mx + pos;

                int crossSize = innerH - child.style.marginTop - child.style.marginBottom;
                if (align == 0) {
                    child.resultY = my + child.style.marginTop;
                } else if (align == 1) {
                    child.resultY = my + child.style.marginTop + ((crossSize - child.resultH) >> 1);
                } else if (align == 2) {
                    child.resultY = my + child.style.marginTop + crossSize - child.resultH;
                } else {
                    child.resultY = my + child.style.marginTop;
                    child.resultH = crossSize;
                }

                pos = pos + child.resultW + child.style.marginRight;
            } else {
                pos = pos + child.style.marginTop;
                child.resultY = my + pos;

                int crossSize = innerW - child.style.marginLeft - child.style.marginRight;
                if (align == 0) {
                    child.resultX = mx + child.style.marginLeft;
                } else if (align == 1) {
                    child.resultX = mx + child.style.marginLeft + ((crossSize - child.resultW) >> 1);
                } else if (align == 2) {
                    child.resultX = mx + child.style.marginLeft + crossSize - child.resultW;
                } else {
                    child.resultX = mx + child.style.marginLeft;
                    child.resultW = crossSize;
                }

                pos = pos + child.resultH + child.style.marginBottom;
            }

            pos = pos + spaceBetween;
            i = i + 1;
        }
    }
}
