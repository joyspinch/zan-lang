using System;
using System.Collections.Generic;
using Gui;
namespace Gui;
public class LineBox {
    static InlinePiece MakeText(StyleNode owner, StyleBox st, string text,
                                bool space) {
        StyleBox style = st != null ? st : new StyleBox();
        string txt = text != null ? text : "";
        InlinePiece p = new InlinePiece();
        p.owner = owner;
        p.st = style;
        p.text = txt;
        p.isSpace = space;
        p.fs = style.fontPx > 0 ? style.fontPx
            : (style.envRemPx > 0 ? style.envRemPx : 14);
        if (space) {
            p.w = StyleBox.MeasureSpaced(" ", p.fs, style.letterSpacing);
        } else {
            p.w = StyleBox.MeasureSpaced(txt, p.fs, style.letterSpacing);
        }
        p.lh = style.LineHeightPx(p.fs);
        if (p.lh <= 0) { p.lh = Canvas.FontHeight(p.fs); }
        int cellAsc = Canvas.FontAscent(p.fs);
        int cellDesc = Canvas.FontHeight(p.fs) - cellAsc;
        int lead = p.lh - cellAsc - cellDesc;
        int half = lead / 2;
        if (lead < 0 && lead % 2 != 0) { half = half - 1; }
        p.asc = cellAsc + half;
        p.desc = p.lh - p.asc;
        p.ascOff = p.asc - cellAsc;
        return p;
    }
    static InlinePiece MakeBox(StyleNode kid, int w, int h,
                               int ml, int mr, int mt, int mb, StyleBox st,
                               int xhHalf) {
        StyleBox style = st != null ? st : new StyleBox();
        InlinePiece p = new InlinePiece();
        p.owner = kid;
        p.isBox = true;
        p.st = style;
        p.fs = style.fontPx > 0 ? style.fontPx
            : (style.envRemPx > 0 ? style.envRemPx : 14);
        p.boxH = h;
        p.ml = ml;
        p.mr = mr;
        p.w = w + ml + mr;
        if (style.vaInline == 1 && xhHalf > 0) {
            p.asc = h / 2 + xhHalf;
            p.desc = h - p.asc;
        } else {
            p.asc = mt + h;
            p.desc = mb;
        }
        p.lh = p.asc + p.desc;
        return p;
    }
    static InlinePiece MakeStrut(StyleBox st) {
        InlinePiece p = MakeText(null, st, "", false);
        p.isStrut = true;
        p.w = 0;
        return p;
    }
    static LineSpan LineAvail(List<FloatIntrusion> floats, int availW,
                              int yTop, int yBot) {
        LineSpan sp = new LineSpan();
        sp.xOff = 0;
        sp.availW = availW;
        if (floats == null) { return sp; }
        for (int i = 0; i < floats.Count; i = i + 1) {
            FloatIntrusion f = floats[i];
            if (f == null || f.yTop >= yBot || f.yBot <= yTop) { continue; }
            if (f.side == 1) {
                if (f.x1 > sp.xOff) { sp.xOff = f.x1; }
            } else {
                if (f.x0 < sp.availW) { sp.availW = f.x0; }
            }
        }
        return sp;
    }
    static int ClearY(List<FloatIntrusion> floats, int side, int y) {
        int r = y;
        if (floats == null) { return r; }
        for (int i = 0; i < floats.Count; i = i + 1) {
            FloatIntrusion f = floats[i];
            if (f == null) { continue; }
            if (side == 3 || f.side == side) {
                if (f.yBot > r) { r = f.yBot; }
            }
        }
        return r;
    }
    static int NextShelf(List<FloatIntrusion> floats, int y) {
        int r = 0 - 1;
        if (floats != null) {
            for (int i = 0; i < floats.Count; i = i + 1) {
                FloatIntrusion f = floats[i];
                if (f != null && f.yBot > y && (r < 0 || f.yBot < r)) { r = f.yBot; }
            }
        }
        if (r < 0) { r = y; }
        return r;
    }
    static void PushText(List<InlinePiece> sink, StyleNode owner, StyleBox st,
                         string text) {
        if (sink == null || text == null || text.Length == 0) { return; }
        StyleBox style = st != null ? st : new StyleBox();
        int mode = style.whiteSpace;
        if (mode == 2 || mode == 3) {
            int start = 0;
            int len = text.Length;
            for (int i = 0; i <= len; i = i + 1) {
                if (i == len || (text[i] & 255) == 10) {
                    string seg = text.Substring(start, i - start);
                    InlinePiece p = MakeText(owner, style, seg, false);
                    if (i < len) { p.hardBreak = true; }
                    sink.Add(p);
                    start = i + 1;
                }
            }
            return;
        }
        int n = text.Length;
        int k = 0;
        while (k < n) {
            int b = text[k] & 255;
            if (b == 32 || b == 9 || b == 13 || b == 10) {
                while (k < n) {
                    int c = text[k] & 255;
                    if (c != 32 && c != 9 && c != 13 && c != 10) { break; }
                    k = k + 1;
                }
                sink.Add(MakeText(owner, style, " ", true));
            } else {
                int e = k;
                while (e < n) {
                    int c = text[e] & 255;
                    if (c == 32 || c == 9 || c == 13 || c == 10) { break; }
                    e = e + 1;
                }
                sink.Add(MakeText(owner, style, text.Substring(k, e - k), false));
                k = e;
            }
        }
    }
    static void Layout(List<InlinePiece> items, InlinePiece strut,
                       int availW, List<InlineLine> sink) {
        if (items == null || sink == null) { return; }
        if (availW <= 0) { availW = 1; }
        InlineLine cur = new InlineLine();
        cur.pieces = new List<InlinePiece>();
        int x = 0;
        int yy = 0;
        for (int i = 0; i < items.Count; i = i + 1) {
            InlinePiece p = items[i];
            if (p == null) { continue; }
            bool canBreak = true;
            if (p.st != null && p.st.whiteSpace == 1 && !p.hardBreak) { canBreak = false; }
            if (p.isSpace) {
                if (cur.pieces.Count == 0) { continue; }
                if (x + p.w > availW) { continue; }
                p.x = x;
                x = x + p.w;
                cur.pieces.Add(p);
                continue;
            }
            if (canBreak && cur.pieces.Count > 0 && x + p.w > availW) {
                yy = yy + Flush(cur, x, strut, sink, yy);
                cur = new InlineLine();
                cur.pieces = new List<InlinePiece>();
                x = 0;
            }
            p.x = x;
            x = x + p.w;
            cur.pieces.Add(p);
            if (p.hardBreak) {
                yy = yy + Flush(cur, x, strut, sink, yy);
                cur = new InlineLine();
                cur.pieces = new List<InlinePiece>();
                x = 0;
            }
        }
        Flush(cur, x, strut, sink, yy);
    }
    static InlineLine BeginFloatLine(LineSpan sp, out int limit) {
        InlineLine line = new InlineLine();
        line.pieces = new List<InlinePiece>();
        line.xOff = sp.xOff;
        line.availW = sp.availW;
        limit = sp.availW - sp.xOff;
        if (limit < 0) { limit = 0; }
        return line;
    }
    static bool TryDropLineToShelf(List<FloatIntrusion> floats, int availW, int strutH,
                                   int x, int curY, LineSpan curSp,
                                   out int nextY, out LineSpan nextSp) {
        nextY = curY;
        nextSp = curSp;
        if (curSp.xOff + x <= curSp.availW) { return false; }
        int shelf = NextShelf(floats, curY);
        if (shelf <= curY) { return false; }
        nextY = shelf;
        nextSp = LineAvail(floats, availW, nextY, nextY + strutH);
        return true;
    }
    static void LayoutF(List<InlinePiece> items, InlinePiece strut,
                        int availW, List<InlineLine> sink,
                        List<FloatIntrusion> floats, int yStart) {
        if (items == null || sink == null) { return; }
        if (availW <= 0) { availW = 1; }
        int strutH = strut != null ? strut.asc + strut.desc : 0;
        if (strutH <= 0) { strutH = 1; }
        int y = yStart;
        LineSpan sp = LineAvail(floats, availW, y, y + strutH);
        int limit = 0;
        InlineLine cur = BeginFloatLine(sp, out limit);
        int x = 0;
        int lineStart = 0;
        for (int i = 0; i < items.Count; i = i + 1) {
            InlinePiece p = items[i];
            if (p == null) { continue; }
            bool canBreak = true;
            if (p.st != null && p.st.whiteSpace == 1 && !p.hardBreak) { canBreak = false; }
            if (p.isSpace) {
                if (cur.pieces.Count == 0) { continue; }
                if (x + p.w > limit) { continue; }
                p.x = x;
                x = x + p.w;
                cur.pieces.Add(p);
                continue;
            }
            if (canBreak && cur.pieces.Count > 0 && x + p.w > limit) {
                int ny; LineSpan nsp;
                if (TryDropLineToShelf(floats, availW, strutH, x, y, sp, out ny, out nsp)) {
                    y = ny; sp = nsp;
                    cur = BeginFloatLine(sp, out limit);
                    x = 0;
                    i = lineStart - 1;
                    continue;
                }
                y = y + Flush(cur, x, strut, sink, y);
                sp = LineAvail(floats, availW, y, y + strutH);
                cur = BeginFloatLine(sp, out limit);
                x = 0;
                lineStart = i;
            }
            p.x = x;
            x = x + p.w;
            cur.pieces.Add(p);
            if (p.hardBreak) {
                int ny2; LineSpan nsp2;
                if (TryDropLineToShelf(floats, availW, strutH, x, y, sp, out ny2, out nsp2)) {
                    y = ny2; sp = nsp2;
                    cur = BeginFloatLine(sp, out limit);
                    x = 0;
                    i = lineStart - 1;
                    continue;
                }
                y = y + Flush(cur, x, strut, sink, y);
                sp = LineAvail(floats, availW, y, y + strutH);
                cur = BeginFloatLine(sp, out limit);
                x = 0;
                lineStart = i + 1;
            }
        }
        for (int mv = 0; mv < 8; mv = mv + 1) {
            if (cur.pieces.Count == 0) { break; }
            int ny3; LineSpan nsp3;
            if (!TryDropLineToShelf(floats, availW, strutH, x, y, sp, out ny3, out nsp3)) { break; }
            y = ny3; sp = nsp3;
        }
        cur.xOff = sp.xOff;
        cur.availW = sp.availW;
        Flush(cur, x, strut, sink, y);
    }
    static int Flush(InlineLine cur, int width, InlinePiece strut,
                     List<InlineLine> sink, int yOff) {
        if (cur == null || cur.pieces == null || sink == null) { return 0; }
        while (cur.pieces.Count > 0) {
            InlinePiece last = cur.pieces[cur.pieces.Count - 1];
            if (!last.isSpace) { break; }
            width = width - last.w;
            cur.pieces.RemoveAt(cur.pieces.Count - 1);
        }
        if (cur.pieces.Count == 0) { return 0; }
        int asc = strut != null ? strut.asc : 0;
        int desc = strut != null ? strut.desc : 0;
        for (int i = 0; i < cur.pieces.Count; i = i + 1) {
            InlinePiece p = cur.pieces[i];
            if (p.asc > asc) { asc = p.asc; }
            if (p.desc > desc) { desc = p.desc; }
        }
        cur.width = width;
        cur.asc = asc;
        cur.desc = desc;
        cur.yOff = yOff;
        sink.Add(cur);
        return asc + desc;
    }
}
