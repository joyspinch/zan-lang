using System;
using System.Collections.Generic;
using Gui;

namespace Gui;

public class LineBox {
    // 文本 piece：按样式折算字号/行高/基线（半行距模型）。
    static InlinePiece MakeText(Control owner, StyleBox st, string text,
                                bool space) {
        InlinePiece p = new InlinePiece();
        p.owner = owner;
        p.st = st;
        p.text = text;
        p.isSpace = space;
        p.fs = st.fontPx > 0 ? st.fontPx
            : (st.envRemPx > 0 ? st.envRemPx : 14);
        if (space) {
            p.w = StyleBox.MeasureSpaced(" ", p.fs, st.letterSpacing);
        } else {
            p.w = StyleBox.MeasureSpaced(text, p.fs, st.letterSpacing);
        }
        p.lh = st.LineHeightPx(p.fs);
        if (p.lh <= 0) { p.lh = Canvas.FontHeight(p.fs); }
        int cellAsc = Canvas.FontAscent(p.fs);
        int cellDesc = Canvas.FontHeight(p.fs) - cellAsc;
        int lead = p.lh - cellAsc - cellDesc;
        // Chrome 的半行距分配对负 lead 向下取整（lead=-1 时 asc 也减 1，
        // 基线探针实测），C 风格的 / 向零截断会把基线整体抬高 1px。
        int half = lead / 2;
        if (lead < 0 && lead % 2 != 0) { half = half - 1; }
        p.asc = cellAsc + half;
        p.desc = p.lh - p.asc;
        p.ascOff = p.asc - cellAsc;
        return p;
    }

    // 原子盒 piece（inline-block 等）：基线对齐时下 margin 边坐在
    // 基线上（CSS 10.8.1），asc = margin-top + 盒高、desc = margin-bottom。
    // va:middle 时盒中点对到基线向上半个 x 高（浏览器实测语义，
    // CSS 原文的 "baseline + 半 x 高" 是排版向上方向的加法），
    // 行内 A/D 贡献改为盒相对基线上下伸出的部分。
    static InlinePiece MakeBox(Control kid, int w, int h,
                               int ml, int mr, int mt, int mb, StyleBox st,
                               int xhHalf) {
        InlinePiece p = new InlinePiece();
        p.owner = kid;
        p.isBox = true;
        p.st = st;
        p.fs = st.fontPx > 0 ? st.fontPx
            : (st.envRemPx > 0 ? st.envRemPx : 14);
        p.boxH = h;
        p.ml = ml;
        p.mr = mr;
        p.w = w + ml + mr;
        if (st.vaInline == 1 && xhHalf > 0) {
            p.asc = h / 2 + xhHalf;
            p.desc = h - p.asc;
        } else {
            p.asc = mt + h;
            p.desc = mb;
        }
        p.lh = p.asc + p.desc;
        return p;
    }

    // 容器支柱（strut）：块的字体/行高参与每一行的 A/D 竞争。
    static InlinePiece MakeStrut(StyleBox st) {
        InlinePiece p = MakeText(null, st, "", false);
        p.isStrut = true;
        p.w = 0;
        return p;
    }

    // [yTop, yBot) 带与 float 入侵的相交查询：左 float 把行左缘
    // 抬到 x1，右 float 把右边界压到 x0（同一带内取最窄者）。
    static LineSpan LineAvail(List<FloatIntrusion> floats, int availW,
                              int yTop, int yBot) {
        LineSpan sp = new LineSpan();
        sp.xOff = 0;
        sp.availW = availW;
        if (floats == null) { return sp; }
        for (int i = 0; i < floats.Count; i = i + 1) {
            FloatIntrusion f = floats[i];
            if (f.yTop >= yBot || f.yBot <= yTop) { continue; }
            if (f.side == 1) {
                if (f.x1 > sp.xOff) { sp.xOff = f.x1; }
            } else {
                if (f.x0 < sp.availW) { sp.availW = f.x0; }
            }
        }
        return sp;
    }

    // clear 要求块顶边 ≥ 相关侧 float 的最低底边（side 1 左 / 2 右
    // / 3 双侧）；无相关 float 时原 y 返回。
    static int ClearY(List<FloatIntrusion> floats, int side, int y) {
        int r = y;
        if (floats == null) { return r; }
        for (int i = 0; i < floats.Count; i = i + 1) {
            FloatIntrusion f = floats[i];
            if (side == 3 || f.side == side) {
                if (f.yBot > r) { r = f.yBot; }
            }
        }
        return r;
    }

    // 严格大于 y 的最低 float 底边（下一搁架）；没有则返回 y，
    // 调用方据此停止下坠、行在原地溢出（防呆不挂死）。
    static int NextShelf(List<FloatIntrusion> floats, int y) {
        int r = 0 - 1;
        if (floats != null) {
            for (int i = 0; i < floats.Count; i = i + 1) {
                FloatIntrusion f = floats[i];
                if (f.yBot > y && (r < 0 || f.yBot < r)) { r = f.yBot; }
            }
        }
        if (r < 0) { r = y; }
        return r;
    }

    // 把一段文本拆成 piece 序列。white-space：
    // 0 normal / 1 nowrap——空白折叠成单空格 piece、按词可断；
    // 2 pre / 3 pre-wrap——按 \n 硬分段，空白原样保留、段内不断
    // （空段也给 piece，保住空行的高度）。
    static void PushText(List<InlinePiece> sink, Control owner, StyleBox st,
                         string text) {
        int mode = st.whiteSpace;
        if (mode == 2 || mode == 3) {
            int start = 0;
            int len = text.Length;
            for (int i = 0; i <= len; i = i + 1) {
                if (i == len || text[i] == 10) {
                    string seg = text.Substring(start, i - start);
                    InlinePiece p = MakeText(owner, st, seg, false);
                    if (i < len) { p.hardBreak = true; }
                    sink.Add(p);
                    start = i + 1;
                }
            }
            return;
        }
        int n = text.Length;
        int k = 0;
        while (k < n) {
            int b = text[k];
            if (b == 32 || b == 9 || b == 13 || b == 10) {
                while (k < n) {
                    int c = text[k];
                    if (c != 32 && c != 9 && c != 13 && c != 10) { break; }
                    k = k + 1;
                }
                sink.Add(MakeText(owner, st, " ", true));
            } else {
                int e = k;
                while (e < n) {
                    int c = text[e];
                    if (c == 32 || c == 9 || c == 13 || c == 10) { break; }
                    e = e + 1;
                }
                sink.Add(MakeText(owner, st, text.Substring(k, e - k), false));
                k = e;
            }
        }
    }

    // 排版：贪心填行。nowrap 的 piece 自身不引发行首断行
    // （white-space 是逐 owner 的）；pre 的硬断行永远生效。
    // strut 参与（但不属于）每一行。
    static void Layout(List<InlinePiece> items, InlinePiece strut,
                       int availW, List<InlineLine> sink) {
        if (availW <= 0) { availW = 1; }
        InlineLine cur = new InlineLine();
        cur.pieces = new List<InlinePiece>();
        int x = 0;
        int yy = 0;
        for (int i = 0; i < items.Count; i = i + 1) {
            InlinePiece p = items[i];
            bool canBreak = true;
            if (p.st != null && p.st.whiteSpace == 1 && !p.hardBreak) {
                canBreak = false;
            }
            if (p.isSpace) {
                if (cur.pieces.Count == 0) { continue; }
                if (x + p.w > availW) { continue; }
                p.x = x;
                x = x + p.w;
                cur.pieces.Add(p);
                continue;
            }
            if (canBreak && cur.pieces.Count > 0 && x + p.w > availW) {
                yy = yy + Flush(cur, x, strut, sink, yy);
                cur = new InlineLine();
                cur.pieces = new List<InlinePiece>();
                x = 0;
            }
            p.x = x;
            x = x + p.w;
            cur.pieces.Add(p);
            if (p.hardBreak) {
                yy = yy + Flush(cur, x, strut, sink, yy);
                cur = new InlineLine();
                cur.pieces = new List<InlinePiece>();
                x = 0;
            }
        }
        Flush(cur, x, strut, sink, yy);
    }

    // float 感知排版（P3）：与 Layout 同一贪心骨架，但每行的可用
    // 区在行顶处与 float 入侵带相交查询（yStart = 本段在流里的起
    // 点）。行宽只在行顶处查询（Chrome 同款：float 贴着行底擦过
    // 不收窄本行）；piece 放不下且行顶查询显示 xOff 已越过可用右
    // 缘，就整行下坠到下一搁架、从行首重排（CSS 9.5"line box 放
    // 不下就移到 float 之下"）。行几何随行记录，排布端据此绕排。
    static void LayoutF(List<InlinePiece> items, InlinePiece strut,
                        int availW, List<InlineLine> sink,
                        List<FloatIntrusion> floats, int yStart) {
        if (availW <= 0) { availW = 1; }
        int strutH = strut != null ? strut.asc + strut.desc : 0;
        if (strutH <= 0) { strutH = 1; }
        int y = yStart;
        LineSpan sp = LineAvail(floats, availW, y, y + strutH);
        InlineLine cur = new InlineLine();
        cur.pieces = new List<InlinePiece>();
        cur.xOff = sp.xOff;
        cur.availW = sp.availW;
        int limit = sp.availW - sp.xOff;
        if (limit < 0) { limit = 0; }
        int x = 0;
        int lineStart = 0;
        for (int i = 0; i < items.Count; i = i + 1) {
            InlinePiece p = items[i];
            bool canBreak = true;
            if (p.st != null && p.st.whiteSpace == 1 && !p.hardBreak) {
                canBreak = false;
            }
            if (p.isSpace) {
                if (cur.pieces.Count == 0) { continue; }
                if (x + p.w > limit) { continue; }
                p.x = x;
                x = x + p.w;
                cur.pieces.Add(p);
                continue;
            }
            // 非空格 piece 放不下且可断：先按行顶规则复查，要下坠
            // 就把已放入的 piece 全部回退、从行首重来。
            if (canBreak && cur.pieces.Count > 0 && x + p.w > limit) {
                bool restart = false;
                for (int mv = 0; mv < 8; mv = mv + 1) {
                    if (sp.xOff + x > sp.availW) {
                        int shelf = NextShelf(floats, y);
                        if (shelf <= y) { break; }  // 溢出容差
                        y = shelf;  // 整行下坠
                        sp = LineAvail(floats, availW, y, y + strutH);
                    } else {
                        break;  // 本行成立
                    }
                    limit = sp.availW - sp.xOff;
                    if (limit < 0) { limit = 0; }
                    cur = new InlineLine();
                    cur.pieces = new List<InlinePiece>();
                    cur.xOff = sp.xOff;
                    cur.availW = sp.availW;
                    x = 0;
                    restart = true;
                    break;
                }
                if (restart) { i = lineStart - 1; continue; }
                y = y + Flush(cur, x, strut, sink, y);
                sp = LineAvail(floats, availW, y, y + strutH);
                cur = new InlineLine();
                cur.pieces = new List<InlinePiece>();
                cur.xOff = sp.xOff;
                cur.availW = sp.availW;
                limit = sp.availW - sp.xOff;
                if (limit < 0) { limit = 0; }
                x = 0;
                lineStart = i;
            }
            p.x = x;
            x = x + p.w;
            cur.pieces.Add(p);
            // pre 硬断行：断行在它之后，同样按行顶规则复查/下坠。
            if (p.hardBreak) {
                bool restart2 = false;
                for (int mv = 0; mv < 8; mv = mv + 1) {
                    if (sp.xOff + x > sp.availW) {
                        int shelf = NextShelf(floats, y);
                        if (shelf <= y) { break; }
                        y = shelf;
                        sp = LineAvail(floats, availW, y, y + strutH);
                    } else {
                        break;
                    }
                    limit = sp.availW - sp.xOff;
                    if (limit < 0) { limit = 0; }
                    cur = new InlineLine();
                    cur.pieces = new List<InlinePiece>();
                    cur.xOff = sp.xOff;
                    cur.availW = sp.availW;
                    x = 0;
                    restart2 = true;
                    break;
                }
                if (restart2) { i = lineStart - 1; continue; }
                y = y + Flush(cur, x, strut, sink, y);
                sp = LineAvail(floats, availW, y, y + strutH);
                cur = new InlineLine();
                cur.pieces = new List<InlinePiece>();
                cur.xOff = sp.xOff;
                cur.availW = sp.availW;
                limit = sp.availW - sp.xOff;
                if (limit < 0) { limit = 0; }
                x = 0;
                lineStart = i + 1;
            }
        }
        // 末行：装不下就整行下坠（不再取词，piece 相对位置不变）。
        for (int mv = 0; mv < 8; mv = mv + 1) {
            if (cur.pieces.Count == 0) { break; }
            if (sp.xOff + x <= sp.availW) { break; }
            int shelf = NextShelf(floats, y);
            if (shelf <= y) { break; }
            y = shelf;
            sp = LineAvail(floats, availW, y, y + strutH);
        }
        cur.xOff = sp.xOff;
        cur.availW = sp.availW;
        Flush(cur, x, strut, sink, y);
    }

    // 结束当前行（裁掉行尾空白，行高 = strut 与 pieces 的 A/D 竞争）。
    // yOff 记入行盒；返回行高（asc+desc，空行 0）供调用方推进 y。
    static int Flush(InlineLine cur, int width, InlinePiece strut,
                     List<InlineLine> sink, int yOff) {
        while (cur.pieces.Count > 0) {
            InlinePiece last = cur.pieces[cur.pieces.Count - 1];
            if (!last.isSpace) { break; }
            width = width - last.w;
            cur.pieces.RemoveAt(cur.pieces.Count - 1);
        }
        if (cur.pieces.Count == 0) { return 0; }
        int asc = strut != null ? strut.asc : 0;
        int desc = strut != null ? strut.desc : 0;
        for (int i = 0; i < cur.pieces.Count; i = i + 1) {
            InlinePiece p = cur.pieces[i];
            if (p.asc > asc) { asc = p.asc; }
            if (p.desc > desc) { desc = p.desc; }
        }
        cur.width = width;
        cur.asc = asc;
        cur.desc = desc;
        cur.yOff = yOff;
        sink.Add(cur);
        return asc + desc;
    }
}
