using System;
using System.Collections.Generic;
using Gui;
namespace Gui;
public class CssGrid {
    static Dict<string, List<GridTrack>> s_trackCache;
    static GridTrack s_autoTrack;
    static GridTrack AutoTrack() {
        if (CssGrid.s_autoTrack == null) {
            GridTrack tr = new GridTrack();
            tr.kind = 2;
            CssGrid.s_autoTrack = tr;
        }
        return CssGrid.s_autoTrack;
    }
    static GridLine ParseLine(string v) {
        GridLine gl = new GridLine();
        List<string> t = StyleSheet.Tokens(v);
        int nums = 0;
        for (int i = 0; i < t.Count; i = i + 1) {
            string w = t[i];
            if (w == "/" || w == "auto") { continue; }
            if (w == "span") {
                if (i + 1 < t.Count) {
                    int n = StyleSheet.ParseInt(t[i + 1]);
                    if (n > 0) { gl.span = n; }
                    i = i + 1;
                }
                if (gl.span <= 0) { gl.span = 1; }
                continue;
            }
            int num = StyleSheet.ParseInt(w);
            if (num <= 0) { continue; }  // 非法/负线号：忽略
            if (nums == 0) { gl.start = num; }
            else if (nums == 1) { gl.end = num; }
            nums = nums + 1;
        }
        if (gl.span <= 0 && gl.end > gl.start) { gl.span = gl.end - gl.start; }
        if (gl.span <= 0) { gl.span = 0; }  // 0 = 未声明（消费端按 1）
        return gl;
    }
    static bool HasAutoRepeat(string v) {
        if (v == null || v.IndexOf("(") < 0) { return false; }
        string lo = StyleSheet.Lower(v);
        return lo.IndexOf("auto-fill") >= 0 || lo.IndexOf("auto-fit") >= 0;
    }
    static bool HasAutoFit(string v) {
        if (v == null || v.IndexOf("(") < 0) { return false; }
        return StyleSheet.Lower(v).IndexOf("auto-fit") >= 0;
    }
    static int TrackMinPx(GridTrack tr) {
        if (tr == null) { return 0; }
        if (tr.kind == 0) { return tr.val > 0 ? tr.val : 0; }
        if (tr.kind == 4 && tr.minKind == 0) { return tr.minVal > 0 ? tr.minVal : 0; }
        return 0;
    }
    static List<GridTrack> ParseTracks(string v) {
        if (v == null || v == "") { return new List<GridTrack>(); }
        if (CssGrid.HasAutoRepeat(v)) {
            return CssGrid.ParseTracksForWidth(v, 0 - 1, 0);
        }
        if (CssGrid.s_trackCache == null) {
            CssGrid.s_trackCache = new Dict<string, List<GridTrack>>();
        }
        List<GridTrack> hit = null;
        if (CssGrid.s_trackCache.TryGetValue(v, out hit)) { return hit; }
        List<GridTrack> parsed = CssGrid.ParseTracksForWidth(v, 0 - 1, 0);
        if (CssGrid.s_trackCache.Count >= 256) { CssGrid.s_trackCache.Clear(); }
        CssGrid.s_trackCache[v] = parsed;
        return parsed;
    }
    static List<GridTrack> ParseTracksForWidth(string v, int avail, int gap) {
        List<GridTrack> out2 = new List<GridTrack>();
        if (v == null || v == "") { return out2; }
        List<string> t = CssGrid.SplitTop(v);
        for (int i = 0; i < t.Count; i = i + 1) {
            string w = t[i];
            if (CssGrid.StartsWith(w, "repeat(") && CssGrid.EndsWith(w, ")")) {
                string inner = w.Substring(7, w.Length - 8);
                int comma = Css.TopComma(inner);
                if (comma < 0) { continue; }
                string countTok = StyleSheet.Lower(StyleSheet.Trim(
                    inner.Substring(0, comma)));
                List<GridTrack> sub = CssGrid.ParseTracksForWidth(
                    inner.Substring(comma + 1), avail, gap);
                int n = 0;
                if (countTok == "auto-fill" || countTok == "auto-fit") {
                    int unitMin = 0;
                    for (int s = 0; s < sub.Count; s = s + 1) {
                        unitMin = unitMin + CssGrid.TrackMinPx(sub[s]);
                    }
                    if (sub.Count > 1 && gap > 0) {
                        unitMin = unitMin + gap * (sub.Count - 1);
                    }
                    if (avail > 0 && unitMin > 0) {
                        int g = gap > 0 ? gap : 0;
                        n = (avail + g) / (unitMin + g);
                        if (n < 1) { n = 1; }
                    } else {
                        n = 1;
                    }
                } else {
                    n = StyleSheet.ParseInt(countTok);
                    if (n < 0) { n = 0; }
                }
                for (int r2 = 0; r2 < n; r2 = r2 + 1) {
                    for (int k2 = 0; k2 < sub.Count; k2 = k2 + 1) {
                        GridTrack cp = new GridTrack();
                        cp.kind = sub[k2].kind; cp.val = sub[k2].val;
                        cp.minKind = sub[k2].minKind;
                        cp.minVal = sub[k2].minVal;
                        cp.maxKind = sub[k2].maxKind;
                        cp.maxVal = sub[k2].maxVal;
                        out2.Add(cp);
                    }
                }
                continue;
            }
            out2.Add(CssGrid.ParseOne(w));
        }
        return out2;
    }
    static GridTrack ParseOne(string w) {
        GridTrack tr = new GridTrack();
        if (w == "auto") { tr.kind = 2; return tr; }
        if (CssGrid.EndsWith(w, "fr")) {
            tr.kind = 3;
            double f = StyleSheet.ParseDbl(w.Substring(0, w.Length - 2));
            int fv = (int)(f * 1000.0 + 0.5);
            tr.val = fv > 0 ? fv : 1000;
            return tr;
        }
        if (CssGrid.EndsWith(w, "%")) {
            tr.kind = 1;
            tr.val = StyleSheet.ParseInt(
                w.Substring(0, w.Length - 1)) * 10;
            return tr;
        }
        if (CssGrid.StartsWith(w, "minmax(") && CssGrid.EndsWith(w, ")")) {
            string inner = w.Substring(7, w.Length - 8);
            int comma = Css.TopComma(inner);
            tr.kind = 4;
            GridTrack lo = comma > 0
                ? CssGrid.ParseOne(StyleSheet.Trim(inner.Substring(0, comma)))
                : CssGrid.AutoTrack();
            GridTrack hi = comma > 0
                ? CssGrid.ParseOne(StyleSheet.Trim(inner.Substring(comma + 1)))
                : CssGrid.AutoTrack();
            tr.minKind = lo.kind; tr.minVal = lo.val;
            tr.maxKind = hi.kind; tr.maxVal = hi.val;
            return tr;
        }
        tr.kind = 0;
        string num = CssGrid.EndsWith(w, "px")
            ? w.Substring(0, w.Length - 2) : w;
        tr.val = StyleSheet.ParseInt(num);
        return tr;
    }
    static List<string> SplitTop(string v) {
        List<string> out2 = new List<string>();
        int depth = 0;
        int start = 0;
        for (int i = 0; i < v.Length; i = i + 1) {
            int ch = v[i];
            if (ch == 40) { depth = depth + 1; }
            else if (ch == 41) { depth = depth - 1; }
            else if (depth == 0
                     && (ch == 32 || ch == 9 || ch == 10 || ch == 13)) {
                if (i > start) { out2.Add(v.Substring(start, i - start)); }
                start = i + 1;
            }
        }
        if (v.Length > start) { out2.Add(v.Substring(start)); }
        return out2;
    }
    static bool StartsWith(string s, string pre) {
        if (s == null || pre == null || s.Length < pre.Length) { return false; }
        return s.StartsWith(pre);
    }
    static bool EndsWith(string s, string suf) {
        if (s == null || suf == null || s.Length < suf.Length) { return false; }
        return s.EndsWith(suf);
    }
    static int EnsureRows(List<bool> occ, int nCols, int capRows, int needRows) {
        while (capRows < needRows) {
            for (int k = 0; k < nCols; k = k + 1) { occ.Add(false); }
            capRows = capRows + 1;
        }
        return capRows;
    }
    static void CommitSlot(GridItemSlot slot, List<bool> occ, int nCols,
                           int colStart, int rowStart, int colSpan, int rowSpan) {
        slot.colStart = colStart;
        slot.colSpan = colSpan;
        slot.rowStart = rowStart;
        slot.rowSpan = rowSpan;
        CssGrid.Mark(occ, nCols, colStart, rowStart, colSpan, rowSpan);
    }
    static GridPlace Place(List<StyleBox> itemStyles, int expCols, int expRows) {
        GridPlace pl = new GridPlace();
        int n = itemStyles.Count;
        pl.slots = new List<GridItemSlot>();
        for (int i = 0; i < n; i = i + 1) {
            pl.slots.Add(new GridItemSlot(-1, 0, -1, 0));
        }
        List<int> c0 = new List<int>();
        List<int> cN = new List<int>();
        List<int> r0 = new List<int>();
        List<int> rN = new List<int>();
        int nCols = expCols > 0 ? expCols : 1;
        int nRows = expRows > 0 ? expRows : 1;
        for (int i = 0; i < n; i = i + 1) {
            StyleBox sb = itemStyles[i];
            int cs = sb != null ? sb.gColStart : 0;
            int ce = sb != null ? sb.gColEnd : 0;
            int cp = sb != null && sb.gColSpan > 0 ? sb.gColSpan : 1;
            if (ce > cs && cp <= 1) { cp = ce - cs; }
            int rs = sb != null ? sb.gRowStart : 0;
            int re = sb != null ? sb.gRowEnd : 0;
            int rp = sb != null && sb.gRowSpan > 0 ? sb.gRowSpan : 1;
            if (re > rs && rp <= 1) { rp = re - rs; }
            c0.Add(cs - 1);  // 0 基；-1 = auto
            cN.Add(cp);
            r0.Add(rs - 1);
            rN.Add(rp);
            if (c0[i] >= 0 && c0[i] + cN[i] > nCols) { nCols = c0[i] + cN[i]; }
            if (r0[i] >= 0 && r0[i] + rN[i] > nRows) { nRows = r0[i] + rN[i]; }
        }
        List<bool> occ = new List<bool>();
        int capRows = CssGrid.EnsureRows(occ, nCols, 0, nRows);
        for (int i = 0; i < n; i = i + 1) {
            if (c0[i] < 0 || r0[i] < 0) { continue; }
            CssGrid.CommitSlot(pl.slots[i], occ, nCols, c0[i], r0[i], cN[i], rN[i]);
        }
        for (int i = 0; i < n; i = i + 1) {
            if (r0[i] < 0 || c0[i] >= 0) { continue; }
            int c = CssGrid.FindFreeInRow(occ, nCols, r0[i], cN[i]);
            if (c < 0) {
                c = nCols;
                occ = CssGrid.Widen(occ, nCols, capRows, c + cN[i]);
                nCols = c + cN[i];
            }
            CssGrid.CommitSlot(pl.slots[i], occ, nCols, c, r0[i], cN[i], rN[i]);
        }
        for (int i = 0; i < n; i = i + 1) {
            if (c0[i] < 0 || r0[i] >= 0) { continue; }
            int r = CssGrid.FindFreeInCol(occ, nCols, capRows, c0[i], rN[i]);
            if (r < 0) {
                r = capRows;
                capRows = CssGrid.EnsureRows(occ, nCols, capRows, r + rN[i]);
            }
            if (r + rN[i] > nRows) { nRows = r + rN[i]; }
            CssGrid.CommitSlot(pl.slots[i], occ, nCols, c0[i], r, cN[i], rN[i]);
        }
        int cr = 0;
        int cc = 0;
        for (int i = 0; i < n; i = i + 1) {
            if (c0[i] >= 0 || r0[i] >= 0) { continue; }
            while (true) {
                capRows = CssGrid.EnsureRows(occ, nCols, capRows, cr + rN[i]);
                if (cc + cN[i] <= nCols
                    && CssGrid.Free(occ, nCols, cc, cr, cN[i], rN[i])) {
                    break;
                }
                cc = cc + 1;
                if (cc + cN[i] > nCols) { cr = cr + 1; cc = 0; }
            }
            if (cr + rN[i] > nRows) { nRows = cr + rN[i]; }
            CssGrid.CommitSlot(pl.slots[i], occ, nCols, cc, cr, cN[i], rN[i]);
            cc = cc + cN[i];
        }
        pl.nCols = nCols;
        pl.nRows = nRows;
        return pl;
    }
    static bool Free(List<bool> occ, int nCols, int c, int r, int cs, int rs) {
        for (int rr = r; rr < r + rs; rr = rr + 1) {
            for (int cx = c; cx < c + cs; cx = cx + 1) {
                if (occ[rr * nCols + cx]) { return false; }
            }
        }
        return true;
    }
    static void Mark(List<bool> occ, int nCols, int c, int r, int cs, int rs) {
        for (int rr = r; rr < r + rs; rr = rr + 1) {
            for (int cx = c; cx < c + cs; cx = cx + 1) {
                occ[rr * nCols + cx] = true;
            }
        }
    }
    static int FindFreeInRow(List<bool> occ, int nCols, int r, int cs) {
        for (int c = 0; c + cs <= nCols; c = c + 1) {
            if (CssGrid.Free(occ, nCols, c, r, cs, 1)) { return c; }
        }
        return 0 - 1;
    }
    static int FindFreeInCol(List<bool> occ, int nCols, int capRows,
                             int c, int rs) {
        for (int r = 0; r + rs <= capRows; r = r + 1) {
            if (CssGrid.Free(occ, nCols, c, r, 1, rs)) { return r; }
        }
        return 0 - 1;
    }
    static List<bool> Widen(List<bool> occ, int oldCols, int rows,
                            int newCols) {
        List<bool> out2 = new List<bool>();
        for (int r = 0; r < rows; r = r + 1) {
            for (int c = 0; c < oldCols; c = c + 1) {
                out2.Add(occ[r * oldCols + c]);
            }
            for (int c2 = oldCols; c2 < newCols; c2 = c2 + 1) {
                out2.Add(false);
            }
        }
        return out2;
    }
    static List<int> SizeTracks(List<GridTrack> defs, List<GridTrack> auto,
                                int n, List<int> span1At, List<int> span1Sz,
                                int avail, int gap) {
        List<int> size = new List<int>();
        List<int> limit = new List<int>();
        List<bool> flex = new List<bool>();
        List<int> frVal = new List<int>();
        List<int> contentMax = new List<int>();
        for (int i = 0; i < n; i = i + 1) { contentMax.Add(0); }
        for (int k = 0; k < span1At.Count; k = k + 1) {
            int idx = span1At[k];
            if (idx >= 0 && idx < n && span1Sz[k] > contentMax[idx]) {
                contentMax[idx] = span1Sz[k];
            }
        }
        int frTotal = 0;
        int big = 1 << 28;
        GridTrack autoDef = CssGrid.AutoTrack();
        for (int i = 0; i < n; i = i + 1) {
            GridTrack d = null;
            if (i < defs.Count) { d = defs[i]; }
            else if (auto != null && auto.Count > 0) { d = auto[(i - defs.Count) % auto.Count]; }
            int b = contentMax[i];
            int lim = big;
            bool fx = false;
            int fv = 0;
            if (d == null) { d = autoDef; }
            if (d.kind == 0) { b = d.val; lim = d.val; }
            else if (d.kind == 1) {
                if (avail >= 0) { b = d.val * avail / 1000; lim = b; }
            } else if (d.kind == 3) {
                fx = true; fv = d.val;
            } else if (d.kind == 4) {
                if (d.minKind == 0) { b = d.minVal; }
                else if (d.minKind == 1 && avail >= 0) { b = d.minVal * avail / 1000; }
                if (d.maxKind == 0) { lim = d.maxVal; }
                else if (d.maxKind == 1 && avail >= 0) {
                    lim = d.maxVal * avail / 1000;
                } else if (d.maxKind == 3) {
                    fx = true; fv = d.maxVal;
                }
            }
            size.Add(b);
            limit.Add(fx ? b : lim);
            flex.Add(fx);
            frVal.Add(fv);
            frTotal = frTotal + fv;
        }
        if (avail >= 0) {
            int used = gap * (n > 0 ? n - 1 : 0);
            for (int i = 0; i < n; i = i + 1) { used = used + size[i]; }
            int free = avail - used;
            int rounds = 0;
            while (free > 0 && rounds < 64) {
                int cand = 0;
                for (int i = 0; i < n; i = i + 1) {
                    if (!flex[i] && size[i] < limit[i] && (frTotal == 0 || limit[i] < big)) {
                        cand = cand + 1;
                    }
                }
                if (cand == 0) { break; }
                int share = free / cand;
                if (share <= 0) { share = 1; }
                bool grew = false;
                for (int i = 0; i < n && free > 0; i = i + 1) {
                    if (flex[i] || size[i] >= limit[i] || (frTotal > 0 && limit[i] == big)) { continue; }
                    int add = limit[i] - size[i];
                    if (add > share) { add = share; }
                    if (add > free) { add = free; }
                    size[i] = size[i] + add;
                    free = free - add;
                    if (add > 0) { grew = true; }
                }
                if (!grew) { break; }
                rounds = rounds + 1;
            }
            if (frTotal > 0) {
                used = gap * (n > 0 ? n - 1 : 0);
                for (int i = 0; i < n; i = i + 1) { used = used + size[i]; }
                int free2 = avail - used;
                if (free2 > 0) {
                    for (int i = 0; i < n; i = i + 1) {
                        if (flex[i]) { size[i] = size[i] + free2 * frVal[i] / frTotal; }
                    }
                }
            }
        }
        return size;
    }
    static int SpanSum(List<int> size, int gap, int start, int span) {
        if (span <= 0) { return 0; }
        int s = 0;
        for (int i = start; i < start + span && i < size.Count; i = i + 1) {
            if (i < 0) { continue; }
            s = s + size[i];
        }
        return s + gap * (span - 1);
    }
    static int TrackOffset(List<int> size, int gap, int start) {
        if (start <= 0) { return 0; }
        int s = 0;
        for (int i = 0; i < start && i < size.Count; i = i + 1) {
            s = s + size[i];
        }
        return s + gap * start;
    }
}
