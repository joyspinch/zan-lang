using System;

namespace Gui;

// CSS Flexbox 布局引擎（纯 Zan 实现）。
// 支持：direction、justify、align、gap、wrap、grow/shrink、padding/margin。

public class FlexStyle {
    int direction;
    int justify;
    int alignItems;
    int flexGrow;
    int flexShrink;
    int width;
    int height;
    int minWidth;
    int minHeight;
    int maxWidth;
    int maxHeight;
    int padTop;
    int padRight;
    int padBottom;
    int padLeft;
    int marginTop;
    int marginRight;
    int marginBottom;
    int marginLeft;
    int gap;
    int position;  // 0 = relative/flow (流式排列), 1 = absolute/float (脱离文档流浮动定位)
    int left;  // 浮动左偏移（-999999 = auto）
    int top;  // 浮动上偏移（-999999 = auto）
    int right;  // 浮动右偏移（-999999 = auto）
    int bottom;  // 浮动下偏移（-999999 = auto）
    int anchor;  // 0=None, 1=TopLeft, 2=TopCenter, 3=TopRight, 4=CenterLeft, 5=Center, 6=CenterRight, 7=BottomLeft, 8=BottomCenter, 9=BottomRight, 10=Stretch
    int zIndex;  // 浮动层级

    // 全默认样式：水平排列、交叉轴拉伸（align=3）、允许收缩、宽高取容器尺寸（-1）。
    static FlexStyle Default() {
        FlexStyle s = new FlexStyle();
        s.direction = 0;
        s.justify = 0;
        s.alignItems = 3;
        s.flexGrow = 0;
        s.flexShrink = 1000;
        s.width = -1;
        s.height = -1;
        s.minWidth = 0;
        s.minHeight = 0;
        s.maxWidth = -1;
        s.maxHeight = -1;
        s.padTop = 0;
        s.padRight = 0;
        s.padBottom = 0;
        s.padLeft = 0;
        s.marginTop = 0;
        s.marginRight = 0;
        s.marginBottom = 0;
        s.marginLeft = 0;
        s.gap = 0;
        s.position = 0;
        s.left = -999999;
        s.top = -999999;
        s.right = -999999;
        s.bottom = -999999;
        s.anchor = 0;
        s.zIndex = 0;
        return s;
    }

    // 水平排列（主轴 = 行方向）的样式起点。
    static FlexStyle Row() {
        FlexStyle s = FlexStyle.Default();
        s.direction = 0;
        return s;
    }

    // 垂直排列（主轴 = 列方向）的样式起点。
    static FlexStyle Column() {
        FlexStyle s = FlexStyle.Default();
        s.direction = 1;
        return s;
    }

    // 四边内边距（上右下左，顺时针），单位与容器一致（像素或设计单位）。
    FlexStyle SetPadding(int top, int right, int bottom, int left) {
        padTop = top;
        padRight = right;
        padBottom = bottom;
        padLeft = left;
        return this;
    }

    // 四边统一内边距。
    FlexStyle SetPaddingAll(int p) {
        padTop = p;
        padRight = p;
        padBottom = p;
        padLeft = p;
        return this;
    }

    // 子项之间的主轴间距。
    FlexStyle SetGap(int g) {
        gap = g;
        return this;
    }

    // 固定尺寸；-1 表示该轴取容器尺寸（行内子项的交叉轴默认拉伸即来源于此）。
    FlexStyle SetSize(int w, int h) {
        width = w;
        height = h;
        return this;
    }

    // 主轴弹性权重：剩余空间按各子项 grow 比例分配。
    FlexStyle SetGrow(int g) {
        flexGrow = g;
        return this;
    }

    // 主轴对齐：0=起始 1=居中 2=末尾 3=两端间均分 4=两侧环绕 5=evenly 均分。
    FlexStyle SetJustify(int j) {
        justify = j;
        return this;
    }

    // 交叉轴对齐：0=起始 1=居中 2=末尾 3(默认)=拉伸填满。
    FlexStyle SetAlign(int a) {
        alignItems = a;
        return this;
    }

    // 设置定位模式（0=文档流 flow, 1=脱离文档流浮动 float/absolute）。
    FlexStyle SetPosition(int pos) {
        position = pos;
        return this;
    }

    // 设置浮动四向偏移（-999999 = auto）。
    FlexStyle SetOffsets(int l, int t, int r, int b) {
        left = l;
        top = t;
        right = r;
        bottom = b;
        return this;
    }

    // 快捷设置浮动/绝对定位偏移：left 与 top。
    FlexStyle SetFloat(int l, int t) {
        position = 1;
        left = l;
        top = t;
        right = -999999;
        bottom = -999999;
        return this;
    }

    // 快捷设置锚点/停靠模式（1=TopLeft, 2=TopCenter, 3=TopRight, 4=CenterLeft, 5=Center, 6=CenterRight, 7=BottomLeft, 8=BottomCenter, 9=BottomRight, 10=Stretch）。
    FlexStyle SetAnchor(int a) {
        position = 1;
        anchor = a;
        return this;
    }

    // 设置层级 zIndex。
    FlexStyle SetZIndex(int z) {
        zIndex = z;
        return this;
    }
}

