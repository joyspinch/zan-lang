using System;

namespace Gui;

/// <summary>
/// 立即模式组合用的线性布局游标。
///
/// Stack 包装一个内容矩形和一个主轴方向（row/column）。
/// 调用方通过 Slot()/Fill()/Space() 依次从中切出子矩形，
/// 控件无需再手算 x/y/w/h。每次分配都会推进
/// 内部游标，并遵守配置的 gap 与 padding。
///
/// 由于框架是立即模式，Stack 是每帧的轻量值：
/// 创建、自上而下（或从左到右）摆放子项、丢弃。
///
/// 示例（带内边距的工具栏行：固定按钮 + 弹性搜索框）：
///   Stack bar = Stack.Row(x, y, w, h);
///   bar.SetPad(8);
///   bar.SetGap(8);
///   Rect btn = bar.Slot(96);
///   Rect search = bar.Fill();
/// </summary>
class Stack {
    /// 游标在内部移动的内容框（已按 padding 内缩）。
    int ox;
    int oy;
    int ow;
    int oh;
    /// 主轴：0 = row（水平），1 = column（垂直）。
    int dir;
    int gap;
    /// 游标沿主轴相对内容框的偏移。
    int cursor;
    /// 已摆放的子项数（决定 gap 的插入）。
    int placed;

    /// 指定矩形、主轴方向（0=row，1=column）与 gap 的栈。
    static Stack Of(int x, int y, int w, int h, int direction, int gap) {
        Stack s = new Stack();
        s.ox = x;
        s.oy = y;
        s.ow = w;
        s.oh = h;
        s.dir = direction;
        s.gap = gap;
        s.cursor = 0;
        s.placed = 0;
        return s;
    }

    /// 自上而下（垂直）铺满给定矩形的栈。
    static Stack Column(int x, int y, int w, int h) {
        return Stack.Of(x, y, w, h, 1, 0);
    }

    /// 从左到右（水平）铺满给定矩形的栈。
    static Stack Row(int x, int y, int w, int h) {
        return Stack.Of(x, y, w, h, 0, 0);
    }

    /// 在已有 Rect 内布局的垂直栈。
    static Stack ColumnIn(Rect r) {
        return Stack.Of(r.x, r.y, r.width, r.height, 1, 0);
    }

    /// 在已有 Rect 内布局的水平栈。
    static Stack RowIn(Rect r) {
        return Stack.Of(r.x, r.y, r.width, r.height, 0, 0);
    }

    /// 设置相邻子项之间插入的间隙。返回 this 以便
    /// 可作独立语句使用（而不是在其他调用之前链式调用）。
    Stack SetGap(int g) {
        gap = g;
        return this;
    }

    /// 四边统一内缩内容框。须在摆放子项之前调用；
    /// 它会缩小可摆放区域，Slot/Fill/Remaining 都会遵守。
    Stack SetPad(int p) {
        return SetPadding(p, p, p, p);
    }

    /// 按各边分别内缩内容框（上、右、下、左）。
    Stack SetPadding(int top, int right, int bottom, int left) {
        ox = ox + left;
        oy = oy + top;
        ow = ow - left - right;
        oh = oh - top - bottom;
        if (ow < 0) { ow = 0; }
        if (oh < 0) { oh = 0; }
        return this;
    }

    /// 主轴长度（row 为宽度，column 为高度）。
    int MainSize() {
        if (dir == 1) { return oh; }
        return ow;
    }

    /// 交叉轴长度（row 为高度，column 为宽度）。
    int CrossSize() {
        if (dir == 1) { return ow; }
        return oh;
    }

    /// 沿主轴在已摆放内容之后剩余的空间。
    int Remaining() {
        int rem = MainSize() - cursor;
        if (rem < 0) { rem = 0; }
        return rem;
    }

    /// 给定主轴尺寸的子项（非首个子项时加上前导 gap）
    /// 仍能放进剩余空间时返回 true。
    bool HasRoom(int mainSize) {
        int need = mainSize;
        if (placed > 0) { need = need + gap; }
        return need <= Remaining();
    }

    /// 只推进游标而不产生子矩形（用作间隔）。
    void Space(int mainSize) {
        if (placed > 0) { cursor = cursor + gap; }
        cursor = cursor + mainSize;
        placed = placed + 1;
    }

    /// 切出下一个给定主轴尺寸的子矩形。交叉轴
    /// 拉伸到内容区全幅，并推进游标。
    Rect Slot(int mainSize) {
        if (placed > 0) { cursor = cursor + gap; }
        Rect r;
        if (dir == 1) {
            r = new Rect(ox, oy + cursor, ow, mainSize);
        } else {
            r = new Rect(ox + cursor, oy, mainSize, oh);
        }
        cursor = cursor + mainSize;
        placed = placed + 1;
        return r;
    }

    /// 切出一个占满主轴剩余空间的子项（弹性
    /// 填充）。适合作为栈的最后一个子项。
    Rect Fill() {
        int rem = Remaining();
        if (placed > 0) { rem = rem - gap; }
        if (rem < 0) { rem = 0; }
        return Slot(rem);
    }

    /// 按原始主轴长度的比例（千分比，0..1000）切出子项——
    /// 适合 300/700 侧边栏这类按比例分栏。
    Rect SlotFraction(int permille) {
        int size = MainSize() * permille / 1000;
        return Slot(size);
    }

    /// 保持可用的比例槽：原始主轴长度的比例，
    /// 限制在 `minSize`/`maxSize`（0 = 不限）以及
    /// 剩余空间之内，因此面板在窄窗口下不会塌缩，
    /// 在宽窗口下也不会超过可读宽度。
    Rect SlotFractionClamped(int permille, int minSize, int maxSize) {
        int size = MainSize() * permille / 1000;
        if (maxSize > 0 && size > maxSize) { size = maxSize; }
        if (size < minSize) { size = minSize; }
        int free = Remaining();
        if (placed > 0) { free = free - gap; }
        if (size > free) { size = free; }
        if (size < 0) { size = 0; }
        return Slot(size);
    }

    /// 按每个自然尺寸切出一个子项，剩余的主轴空间
    /// 在它们之间均分（自然尺寸放不下时按比例收缩）——
    /// 一排按钮想要的 flex 行，调用方无需
    /// 再手动分配宽度。
    List<Rect> SlotsGrown(List<int> naturalSizes) {
        int n = naturalSizes.Count;
        List<Rect> outp = new List<Rect>();
        if (n == 0) { return outp; }
        int avail = Remaining();
        if (placed > 0) { avail = avail - gap; }
        avail = avail - gap * (n - 1);
        if (avail < 0) { avail = 0; }
        int natural = 0;
        int i = 0;
        for (; i < n; i = i + 1) { natural = natural + naturalSizes[i]; }

        List<int> sizes = new List<int>();
        int used = 0;
        i = 0;
        while (i < n) {
            int s = naturalSizes[i];
            if (natural <= avail) {
                s = s + (avail - natural) / n;
            } else if (natural > 0) {
                s = s * avail / natural;
            }
            if (i == n - 1) { s = avail - used; }
            if (s < 0) { s = 0; }
            sizes.Add(s);
            used = used + s;
            i = i + 1;
        }
        i = 0;
        while (i < n) { outp.Add(Slot(sizes[i])); i = i + 1; }
        return outp;
    }
}
