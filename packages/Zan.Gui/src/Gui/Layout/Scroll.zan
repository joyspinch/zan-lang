using System;
using Gui;

namespace Gui;

// CSS 滚动容器的交互状态（WEB_GUI_ROADMAP P6）：滚轮认领、
// 覆盖式滚动条绘制与滑块拖动。偏移本体存在 Control.scrollY /
// Control.scrollX——排布期（Arrange）按内容延伸钳制并把子树
// 平移 -scrollY / -scrollX，本类只管"输入如何改 offset"与
// "滚动条怎么画"，方法都吃现值返回新值。
// 与 Widget.ScrollView 的分工：ScrollView 是立即模式帮助类（自带
// 塌陷保护——内容高度按帧实测会抖）；保留模式树里内容高度来自
// 上一次排布，是确定的，塌陷恢复不适用（差异记 roadmap 台账）。
// 滚动条是覆盖式（overlay）：画在内容上、不占布局宽——Chrome
// 经典滚动条占 17px 布局宽，这里不模拟（oracle 用 --hide-scrollbars
// 对齐，台账）。
class ScrollState {
    bool dragging;
    int dragMouseY0;
    int dragOffset0;
    int dragMo0;
    bool draggingX;
    int dragMouseX0;
    int dragOffsetX0;
    int dragMoX0;
    // 滚动条宽（OnMeasure 后的消费端自行 Scale；此处存基准值）。
    int barW;

    ScrollState() {
        dragging = false;
        dragMouseY0 = 0;
        dragOffset0 = 0;
        dragMo0 = 0;
        draggingX = false;
        dragMouseX0 = 0;
        dragOffsetX0 = 0;
        dragMoX0 = 0;
        barW = 8;
    }

    // 双轴滚轮认领（渲染期每帧调用）：指针悬停且**该轴真的溢出**
    // 时才认领（CaptureWheel 两段式，与单轴版同序）——声明了
    // auto/scroll 但内容放得下的容器不认领：认领了 offset 也只会
    // 被钳回 0，白白吃掉本属于外层容器/页面的滚轮，指针扫过这类
    // 区域时消费权内外横跳，滚动条表现为乱跳（Chrome 滚动链同款
    // 语义：不溢出不拦截）。滚轮帧上 shift+滚轮且横向可滚时平移
    // host.scrollX——Chrome Windows 同款（触控板横扫由外壳映射成
    // shift+滚轮），横向滚不动时回落纵向；其余平移 host.scrollY。
    // 写入即钳位：贴底/贴顶时差值为 0 → 返回 false 不算消费，也
    // 不再把越界 offset 留给下一帧 Arrange 收拾。返回是否移动了
    // 偏移（调用方据此报损伤）。取代单轴 Wheel（双轴分支并到
    // 一处，认领只做一次）。
    bool WheelXY(App app, int x, int y, int w, int h, Control host,
                 int oxMode, int oyMode) {
        bool xCan = oxMode >= 2 && host.scrollExtentX > w;
        bool yCan = oyMode >= 2 && host.scrollExtent > h;
        if (!xCan && !yCan) { return false; }
        if (!Ui.Over(app, x, y, w, h)) { return false; }
        if (!app.CaptureWheel(x, y, w, h)) { return false; }
        if (Modifiers.HasShift(app.window.EventMods()) && xCan) {
            int nx = this.Clamp(host.scrollX - app.window.EventKeyCode()
                * app.scrollSpeed / 120, host.scrollExtentX, w);
            if (nx != host.scrollX) { host.scrollX = nx; return true; }
            return false;
        }
        int ny = this.Clamp(host.scrollY - app.window.EventKeyCode()
            * app.scrollSpeed / 120, host.scrollExtent, h);
        if (ny != host.scrollY) { host.scrollY = ny; return true; }
        return false;
    }

    // 该不该画滚动条：scroll 常驻（Chrome 桌面对 overflow:scroll
    // 总是显示轨道），auto 溢出才出，hidden 永不（调用方不调）。
    bool WantsBar(int extent, int client, int mode) {
        if (mode == 3) { return true; }
        return extent > client;
    }

    // 排布期钳制：offset 落回 [0, extent-client]（mo<0 视为 0）。
    int Clamp(int offset, int extent, int client) {
        int mo = extent - client;
        if (mo < 0) { mo = 0; }
        if (offset > mo) { return mo; }
        if (offset < 0) { return 0; }
        return offset;
    }

    // 渲染尾段（子项画完、裁剪弹出后调用）：画覆盖式滚动条并处理
    // 轨道点击/滑块拖动，返回（可能被拖动改写的）offset。条带矩形
    // 是滚动容器的 padding box；不溢出且 mode=auto 时只收拖动状态。
    int Bar(App app, int x, int y, int w, int h, int offset,
            int extent, int mode) {
        int client = h;
        int mo = extent - client;
        if (mo < 0) { mo = 0; }
        if (!this.WantsBar(extent, client, mode)) {
            dragging = false;
            return this.Clamp(offset, extent, client);
        }

        Canvas c = app.canvas;
        int bw = app.Scale(barW);
        if (bw > w) { bw = w; }
        if (bw < 1) { bw = 1; }
        int inset = app.Scale(2);
        int bx = x + w - bw - inset;
        if (bx < x) { bx = x; }
        int by = y;
        int bh = h;
        if (bh <= 0) { dragging = false; return offset; }

        int minThumb = app.Scale(24);
        if (minThumb > bh) { minThumb = bh; }
        int thumbH = bh * bh / extent;
        if (thumbH < minThumb) { thumbH = minThumb; }
        if (thumbH > bh) { thumbH = bh; }
        int travel = bh - thumbH;
        if (travel < 0) { travel = 0; }

        int off = this.Clamp(offset, extent, client);
        int thumbY = by;
        if (mo > 0) { thumbY = by + off * travel / mo; }
        if (thumbY < by) { thumbY = by; }
        if (thumbY + thumbH > by + bh) { thumbY = by + bh - thumbH; }

        bool overThumb = Ui.Over(app, bx, thumbY, bw, thumbH);
        bool overBar = Ui.Over(app, bx, by, bw, bh);

        if (!dragging && Ui.MousePressed(app) && overBar) {
            // 点轨道：滑块跳到指针处再拖（整条可抓，ScrollView 同款）
            if (!overThumb && travel > 0) {
                int want = app.mouseY - by - thumbH / 2;
                int o = want * mo / travel;
                if (o < 0) { o = 0; }
                if (o > mo) { o = mo; }
                off = o;
            }
            dragging = true;
            dragMouseY0 = app.mouseY;
            dragOffset0 = off;
            dragMo0 = mo;
        }

        if (dragging) {
            int dyPix = app.mouseY - dragMouseY0;
            int o = dragOffset0;
            if (mo != dragMo0) {
                // 拖拽中内容高度变了：以当前位置重新锚定，防"按住
                // 不动自己滚"的正反馈（ScrollView 同款）。
                dragOffset0 = off;
                dragMouseY0 = app.mouseY;
                dragMo0 = mo;
                dyPix = 0;
            }
            if (travel > 0) { o = dragOffset0 + dyPix * mo / travel; }
            if (o < 0) { o = 0; }
            if (o > mo) { o = mo; }
            off = o;
            if (Ui.MouseReleased(app)) { dragging = false; }
        }

        if (off != offset) {
            app.NoteScrollDamage(x, y, w, h);
        }

        StyleBox track = Style.Of(app, "scrollbar", "", Style.SNormal());
        int thumbState = Style.SNormal();
        if (dragging || overThumb) { thumbState = Style.SHover(); }
        StyleBox thumb = Style.Part(app, "scrollbar", "thumb", "", "", "",
                                    thumbState);

        int half = bw / 2;
        c.PushClip(x, y, w, h);
        c.FillRoundRect(bx, by, bw, bh, half, track.bg);
        c.FillRoundRect(bx, thumbY, bw, thumbH, half, thumb.bg);
        c.PopClip();
        return off;
    }

    // 水平轴版 Bar（P6 横滚）：轨道贴 padding box 底边，滑块按
    // scrollExtentX/scrollX 映射；拖拽跟随 mouseX，其余语义与
    // 纵向 Bar 全同。先纵后横绘制——右下角被横向轨道盖住
    // （Chrome 经典滚动条此处是独立方角，台账）。
    int BarX(App app, int x, int y, int w, int h, int offset,
             int extent, int mode) {
        int client = w;
        int mo = extent - client;
        if (mo < 0) { mo = 0; }
        if (!this.WantsBar(extent, client, mode)) {
            draggingX = false;
            return this.Clamp(offset, extent, client);
        }

        Canvas c = app.canvas;
        int bw = app.Scale(barW);
        if (bw > h) { bw = h; }
        if (bw < 1) { bw = 1; }
        int inset = app.Scale(2);
        int by = y + h - bw - inset;
        if (by < y) { by = y; }
        int bx = x;
        int bh = w;
        if (bh <= 0) { draggingX = false; return offset; }

        int minThumb = app.Scale(24);
        if (minThumb > bh) { minThumb = bh; }
        int thumbW = bh * bh / extent;
        if (thumbW < minThumb) { thumbW = minThumb; }
        if (thumbW > bh) { thumbW = bh; }
        int travel = bh - thumbW;
        if (travel < 0) { travel = 0; }

        int off = this.Clamp(offset, extent, client);
        int thumbX = bx;
        if (mo > 0) { thumbX = bx + off * travel / mo; }
        if (thumbX < bx) { thumbX = bx; }
        if (thumbX + thumbW > bx + bh) { thumbX = bx + bh - thumbW; }

        bool overThumb = Ui.Over(app, thumbX, by, thumbW, bw);
        bool overBar = Ui.Over(app, bx, by, bh, bw);

        if (!draggingX && Ui.MousePressed(app) && overBar) {
            // 点轨道：滑块跳到指针处再拖（纵向 Bar 同款）
            if (!overThumb && travel > 0) {
                int want = app.mouseX - bx - thumbW / 2;
                int o = want * mo / travel;
                if (o < 0) { o = 0; }
                if (o > mo) { o = mo; }
                off = o;
            }
            draggingX = true;
            dragMouseX0 = app.mouseX;
            dragOffsetX0 = off;
            dragMoX0 = mo;
        }

        if (draggingX) {
            int dxPix = app.mouseX - dragMouseX0;
            int o = dragOffsetX0;
            if (mo != dragMoX0) {
                // 拖拽中内容宽度变了：重新锚定（纵向 Bar 同款）。
                dragOffsetX0 = off;
                dragMouseX0 = app.mouseX;
                dragMoX0 = mo;
                dxPix = 0;
            }
            if (travel > 0) { o = dragOffsetX0 + dxPix * mo / travel; }
            if (o < 0) { o = 0; }
            if (o > mo) { o = mo; }
            off = o;
            if (Ui.MouseReleased(app)) { draggingX = false; }
        }

        if (off != offset) {
            app.NoteScrollDamage(x, y, w, h);
        }

        StyleBox track = Style.Of(app, "scrollbar", "", Style.SNormal());
        int thumbState = Style.SNormal();
        if (draggingX || overThumb) { thumbState = Style.SHover(); }
        StyleBox thumb = Style.Part(app, "scrollbar", "thumb", "", "", "",
                                    thumbState);

        int half = bw / 2;
        c.PushClip(x, y, w, h);
        c.FillRoundRect(bx, by, bh, bw, half, track.bg);
        c.FillRoundRect(thumbX, by, thumbW, bw, half, thumb.bg);
        c.PopClip();
        return off;
    }
}
