using System;
using System.Net.Sockets;
using System.Net.Http;
using System.Net.Http.Client;
using System.Net.External;
using System.Threading;
using Gui;
using Gui.Widget;

namespace Gui;

// 网络图片异步加载器。
// 取回在后台 OS 线程上以协程 await 完成（不阻塞 UI），结果经 App.Post 封送回
// UI 线程再解码注册；单个共享 worker 逐条处理排队的请求。UI 线程入口是
// Fetch（控件模式）与 EnsureUrl（URL 槽模式）。
public class ImageHttp {
    static bool installed;

    // 向 Widget.Image 注册远端取回与 URL 槽实现（ResolveUrl 的 http(s) 通道）。
    // 需要远端网络图的程序在启动时调用；未安装时网络图进入失败/占位态，
    // 保证不需要网络图的桌面程序不引入网络栈与加解密驱动。
    static void Install() {
        if (installed) { return; }
        installed = true;
        Image.SetUrlFetcher(ImageHttp.Fetch);
        Image.SetUrlEnsurer(ImageHttp.EnsureUrl);
    }

    // 一次取回请求：UI 线程排队，worker 领走，完成后经 Post 通知。
    // img 为 null 时是 URL 槽请求（见 EnsureUrl）。
    static nint lockHandle;
    static List<ImageHttpReq> pending;
    static bool workerStarted;
    static Dict<string, ImageHttpSlot> urlSlots;
    static int slotSeq;

    // UI 线程调用：确保 `url` 的图片取回已排队（无控件场景，例如
    // DataTable 图片列）。就绪返回已注册的 `mem:` key，加载中或
    // 失败返回 null——同一 URL 只排队一次，结果缓存供后续帧直用。
    static string EnsureUrl(App app, string url) {
        if (url == null || url == "") { return null; }
        if (urlSlots == null) { urlSlots = new Dict<string, ImageHttpSlot>(); }
        if (urlSlots.ContainsKey(url)) {
            ImageHttpSlot have = urlSlots[url];
            if (have.state == 1) { return have.key; }
            return null;
        }
        slotSeq = slotSeq + 1;
        ImageHttpSlot s = new ImageHttpSlot();
        s.key = "mem:slot" + Convert.ToString(slotSeq);
        s.state = 0;
        urlSlots[url] = s;
        ImageHttp.Fetch(app, null, url, s.key);
        return null;
    }

    // UI 线程调用：排队一次 URL 取回。worker 首次需要时启动。
    static void Fetch(App app, Image img, string url, string key) {
        if (lockHandle == 0) {
            lockHandle = Mutex.Create();
            pending = new List<ImageHttpReq>();
        }
        ImageHttpReq r = new ImageHttpReq();
        r.url = url;
        r.key = key;
        r.app = app;
        r.img = img;
        Mutex.Lock(lockHandle);
        pending.Add(r);
        bool needWorker = !workerStarted;
        workerStarted = true;
        Mutex.Unlock(lockHandle);
        if (needWorker) {
            // worker 是 async 协程（M:1 协作式调度，见 rt_co.c）：协程
            // 不会"起不来"，所以没有线程启动失败那套兜底。
            ImageHttp.WorkerLoop();
        }
    }

    // worker 协程：逐条取回直到队列清空，然后退出
    // （下一次 Fetch 会重新拉起）。await 让出期间 IO 反应器推进传输。
    //
    // 必须是 async 方法：await 只在 async 方法里有意义（放在普通方法里
    // 会被丢掉，"取回一条 await 一条"就退化成并发拉起全部）；也不能放在
    // 后台线程里跑——Zan 的协程是 M:1 协作式，await 挂起后由调度器在
    // 同一个线程上恢复。传输本身在 IO 反应器上跑，UI 不会被卡住。
    static async void WorkerLoop() {
        Socket.Initialize();
        while (true) {
            ImageHttpReq r = ImageHttp.Take();
            if (r == null) {
                Mutex.Lock(lockHandle);
                if (pending.Count == 0) {
                    workerStarted = false;
                    Mutex.Unlock(lockHandle);
                    return;
                }
                Mutex.Unlock(lockHandle);
                continue;
            }
            await ImageHttp.FetchOne(r);
        }
    }

    static ImageHttpReq Take() {
        ImageHttpReq r = null;
        Mutex.Lock(lockHandle);
        if (pending.Count > 0) {
            r = pending[0];
            pending.RemoveAt(0);
        }
        Mutex.Unlock(lockHandle);
        return r;
    }

    // 取回单个 URL。传输里任何一处抛出（DNS、TLS、断开的套接字、
    // 超时）都必须变成一条错误结果：不接住的话 worker 静静死掉，
    // 控件会永远停在加载占位上。
    static async int FetchOne(ImageHttpReq r) {
        string err = "";
        string body = null;
        byte[] bytes = null;
        int blen = 0;
        ExternalTarget target = ExternalTarget.Parse(r.url);
        if (target == null || !ExternalTargetPolicy.IsAllowedTarget(
                target, false, false)) {
            err = "bad url";
        } else {
            try {
                HttpClient client = HttpClient.CreateHttps(target.Host(),
                    target.Port());
                ExternalCallPolicy policy = ExternalCallPolicy.Default()
                    .TotalTimeout(15000)
                    .ResponseLimit(16 * 1024 * 1024)
                    .StreamLimit(16 * 1024 * 1024);
                client.SetCallPolicy(policy);
                // 二进制安全通道：图片字节里的 NUL 不能让响应在
                // strlen 语义下提前截断（否则 JPEG 头几个字节就是终点）。
                HttpResponse resp = await client.SendBytesAsync("GET",
                    target.Path() + target.Query(), "");
                if (resp.statusCode != 200) {
                    err = "HTTP " + resp.statusCode;
                } else if (resp.IsBinary()) {
                    bytes = resp.bodyBytes;
                    blen = resp.BodyLength();
                } else {
                    body = resp.body;
                    blen = resp.BodyLength();
                }
            } catch (Exception ex) {
                err = ex.Message;
            }
        }
        string e = err;
        string b = body;
        byte[] bb = bytes;
        int n = blen;
        r.app.Post(() => { ImageHttp.Apply(r, bb, b, n, e); }, "ImageHttp.Apply");
        return 0;
    }

    // UI 线程：把取回的字节注册进图像缓存并通知消费方。解码必须
    // 发生在 UI 线程（图像注册表与光栅器只从 UI 线程触碰）。
    static void Apply(ImageHttpReq r, byte[] bytes, string body, int len, string err) {
        if (r.img == null) {
            // URL 槽模式：注册 key、置状态、触发重绘（下一帧命中缓存）。
            ImageHttpSlot s = null;
            if (urlSlots != null && urlSlots.ContainsKey(r.url)) {
                s = urlSlots[r.url];
            }
            if (s != null) {
                bool ok = false;
                if (err == "") {
                    int w = 0;
                    if (bytes != null) {
                        w = Canvas.ImageLoadMem(s.key, bytes, len);
                    } else if (body != null) {
                        if (body.Contains("<svg")) {
                            w = Canvas.ImageLoadSvg(s.key, body, 0, 0);
                        } else {
                            w = Canvas.ImageLoadMem(s.key, body, len);
                        }
                    }
                    ok = w > 0;
                }
                if (ok) {
                    s.state = 1;
                } else {
                    s.state = 2;
                }
                r.app.RequestRedraw();
            }
            return;
        }
        if (err == "") {
            int w2 = 0;
            if (bytes != null) {
                w2 = Canvas.ImageLoadMem(r.key, bytes, len);
            } else if (body != null) {
                if (body.Contains("<svg")) {
                    r.img.OnSvgFetched(body);
                    return;
                }
                w2 = Canvas.ImageLoadMem(r.key, body, len);
            }
            if (w2 > 0) {
                r.img.OnFetched(r.key, w2, Canvas.ImageHeight(r.key));
                return;
            }
        }
        r.img.OnFetchFailed();
    }

}
