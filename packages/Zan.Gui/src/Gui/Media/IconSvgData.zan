using System;
using System.Collections.Generic;
using System.Json;
namespace Gui;
public class IconSvgData {
    static List<IconSvgItem> items;
    static void Ensure() {
        if (items != null) { return; }
        List<string> pkgs = IconSvgData.Packages();
        List<IconSvgItem> list = new List<IconSvgItem>();
        for (int i = 0; i < pkgs.Count; i = i + 1) {
            IconSvgData.Merge(list, pkgs[i]);
        }
        if (list.Count == 0) {
            items = list;
            return;
        }
        IconSvgData.SortByNames(list);
        items = list;
    }
    static void Merge(List<IconSvgItem> list, string json) {
        if (json == null || json.Length == 0) { return; }
        JsonValue v = JsonValue.ParseLenient(json);
        if (v == null || v.kind != 5) { return; }
        List<string> keys = v.keys;
        List<JsonValue> vals = v.vals;
        for (int i = 0; i < keys.Count; i = i + 1) {
            JsonValue item = vals[i];
            if (item == null || item.kind != 3) { continue; }
            string body = item.strVal;
            if (body == null || body.Length == 0) { continue; }
            int lo = 0;
            int hi = list.Count - 1;
            int at = -1;
            while (lo <= hi) {
                int mid = (lo + hi) / 2;
                int cmp = keys[i].CompareTo(list[mid].name);
                if (cmp == 0) { at = mid; break; }
                if (cmp < 0) { hi = mid - 1; } else { lo = mid + 1; }
            }
            if (at >= 0) {
                list[at].body = body;
                continue;
            }
            list.Insert(lo, new IconSvgItem(keys[i], body));
        }
    }
    static List<string> Packages() {
        List<string> outp = new List<string>();
        string exe = IconSvgData.ExeDir();
        if (exe != "") {
            IconSvgData.CollectDir(exe + "/icons", outp);
            IconSvgData.CollectDir(exe + "/assets/icons", outp);
        }
        string listing = File.zan_embed_list("icons/");
        if (listing != null && listing.Length > 0) {
            List<string> emb = listing.Split('\n');
            for (int i = 0; i < emb.Count; i = i + 1) {
                if (emb[i].Length == 0) { continue; }
                if (!emb[i].EndsWith(".json")) { continue; }
                string text = zan_embed_read(emb[i]);
                if (text != null && text.Length > 0) { outp.Add(text); }
            }
        }
        if (exe != "") { IconSvgData.CollectDir(exe + "/../packages/Zan.Gui/src/Gui/icons", outp); }
        IconSvgData.CollectDir("packages/Zan.Gui/src/Gui/icons", outp);
        return outp;
    }
    static void CollectDir(string dir, List<string> outp) {
        if (!Directory.Exists(dir)) { return; }
        List<string> fs = Directory.GetFiles(dir);
        for (int i = 0; i < fs.Count; i = i + 1) {
            if (!fs[i].EndsWith(".json")) { continue; }
            string text = IconSvgData.ReadFile(fs[i]);
            if (text.Length > 0) { outp.Add(text); }
        }
    }
    static string Leaf(string path) {
        int cut = 0 - 1;
        for (int i = 0; i < path.Length; i = i + 1) {
            string ch = path.Substring(i, 1);
            if (ch == "/" || ch == "\\") { cut = i; }
        }
        if (cut < 0) { return path; }
        return path.Substring(cut + 1, path.Length - cut - 1);
    }
    static string ReadFile(string path) {
        try {
            string text = File.ReadAllText(path);
            return text == null ? "" : text;
        } catch (Exception _ex) {
            return "";
        }
    }
    static void SortByNames(List<IconSvgItem> list) {
        int n = list.Count;
        for (int i = 1; i < n; i = i + 1) {
            IconSvgItem item = list[i];
            int j = i - 1;
            while (j >= 0 && list[j].name.CompareTo(item.name) > 0) {
                list[j + 1] = list[j];
                j = j - 1;
            }
            list[j + 1] = item;
        }
    }
    [DllImport("crt")]
    static extern string getenv(string name);
    static string Env(string name) {
        string v = getenv(name);
        if (v == null) { return ""; }
        return v;
    }
    static string ExeDir() {
        string p = Environment.ProcessPath;
        int cut = 0 - 1;
        for (int i = 0; i < p.Length; i = i + 1) {
            string ch = p.Substring(i, 1);
            if (ch == "\\" || ch == "/") { cut = i; }
        }
        if (cut < 0) { return ""; }
        return p.Substring(0, cut);
    }
    [DllImport("crt")]
    static extern int zan_embed_has(string name);
    [DllImport("crt")]
    static extern string zan_embed_read(string name);
    static int Count() { IconSvgData.Ensure(); return items.Count; }
    static List<string> Names() {
        IconSvgData.Ensure();
        List<string> res = new List<string>();
        for (int i = 0; i < items.Count; i = i + 1) {
            res.Add(items[i].name);
        }
        return res;
    }
    static int IndexOf(string name) {
        IconSvgData.Ensure();
        int lo = 0;
        int hi = items.Count - 1;
        while (lo <= hi) {
            int mid = (lo + hi) / 2;
            int cmp = name.CompareTo(items[mid].name);
            if (cmp == 0) { return mid; }
            if (cmp < 0) { hi = mid - 1; }
            else { lo = mid + 1; }
        }
        return -1;
    }
    static string Body(int index) { IconSvgData.Ensure(); return items[index].body; }
}
