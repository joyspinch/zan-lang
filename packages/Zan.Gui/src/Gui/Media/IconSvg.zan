using System;
namespace Gui;
public class IconSvg {
    private static string[] keyNames;
    private static int[] keyBoxes;
    private static int[] keyColors;
    private static string[] keyVals;
    private static void EnsureKeyCache() {
        if (keyNames != null) { return; }
        keyNames = new string[256];
        keyBoxes = new int[256];
        keyColors = new int[256];
        keyVals = new string[256];
    }
    static string Alias(string name) {
        if (name == null) { return ""; }
        if (name == "unlock") { return "lock-open"; }
        if (name == "close") { return "x"; }
        if (name == "layers") { return "stack-2"; }
        return name;
    }
    static int InlineHash(string s) {
        if (s == null) { return 0; }
        int h = 5381;
        for (int i = 0; i < s.Length; i = i + 1) {
            h = ((h << 5) + h) ^ (int)s[i];
        }
        return h & 2147483647;
    }
    static void Draw(Canvas c, string name, int x, int y, int box, int color) {
        if (c == null || name == null || name == "") { return; }
        if (box < 4) { box = 4; }
        IconSvg.EnsureKeyCache();
        int slot = (IconSvg.InlineHash(name) ^ (box * 31) ^ color) & 255;
        string cachedKey = keyVals[slot];
        if (cachedKey != null && keyBoxes[slot] == box && keyColors[slot] == color
            && keyNames[slot] == name && Canvas.ImageWidth(cachedKey) > 0) {
            c.BlitImage(cachedKey, x, y, box, box, 0, 0, 0, 0);
            return;
        }
        string col = IconSvg.HexColor(color);
        int a = (color >> 24) & 255;
        if (name.IndexOf("<") >= 0) {
            string inlineKey = "mem:isvg" + IconSvg.InlineHash(name) + "_" + name.Length + "@" + box + "@" + col + "@" + a;
            if (Canvas.ImageWidth(inlineKey) <= 0) {
                string rawSvg = name;
                if (rawSvg.Contains("currentColor")) { rawSvg = rawSvg.Replace("currentColor", col); }
                if (rawSvg.IndexOf("<svg") < 0) {
                    rawSvg = "<svg xmlns='http://www.w3.org/2000/svg'"
                        + " viewBox='0 0 24 24' width='" + box + "' height='" + box
                        + "' fill='none' stroke='" + col + "' stroke-width='2'"
                        + " stroke-linecap='round' stroke-linejoin='round'"
                        + IconSvg.AlphaAttrs(color) + ">" + rawSvg + "</svg>";
                }
                Canvas.ImageLoadSvg(inlineKey, rawSvg, box, box);
            }
            if (Canvas.ImageWidth(inlineKey) > 0) {
                keyNames[slot] = name;
                keyBoxes[slot] = box;
                keyColors[slot] = color;
                keyVals[slot] = inlineKey;
            }
            c.BlitImage(inlineKey, x, y, box, box, 0, 0, 0, 0);
            return;
        }
        int idx = IconSvgData.IndexOf(IconSvg.Alias(name));
        if (idx < 0) { return; }
        string key = "mem:i" + name + "@" + box + "@" + col + "@" + a;
        if (Canvas.ImageWidth(key) <= 0) {
            string body = IconSvgData.Body(idx);
            if (body == null || body == "") { return; }
            if (body.Contains("currentColor")) { body = body.Replace("currentColor", col); }
            string svg = "<svg xmlns='http://www.w3.org/2000/svg'"
                + " viewBox='0 0 24 24' width='" + box + "' height='" + box
                + "' fill='none' stroke='" + col + "' stroke-width='2'"
                + " stroke-linecap='round' stroke-linejoin='round'"
                + IconSvg.AlphaAttrs(color) + ">" + body + "</svg>";
            Canvas.ImageLoadSvg(key, svg, box, box);
        }
        if (Canvas.ImageWidth(key) > 0) {
            keyNames[slot] = name;
            keyBoxes[slot] = box;
            keyColors[slot] = color;
            keyVals[slot] = key;
        }
        c.BlitImage(key, x, y, box, box, 0, 0, 0, 0);
    }
    static void DrawIn(Canvas c, int rx, int ry, int rw, int rh,
                       string name, int color) {
        if (c == null || rw <= 0 || rh <= 0) { return; }
        int box = rw;
        if (rh < box) { box = rh; }
        IconSvg.Draw(c, name, rx + (rw - box) / 2, ry + (rh - box) / 2,
                     box, color);
    }
    static int Count() { return IconSvgData.Count(); }
    static List<string> Names() { return IconSvgData.Names(); }
    static string HexColor(int color) {
        int r = (color >> 16) & 255;
        int g = (color >> 8) & 255;
        int b = color & 255;
        byte[] buf = new byte[7];
        buf[0] = 35; // '#'
        int h = (r >> 4) & 15;
        int l = r & 15;
        buf[1] = (byte)(h < 10 ? h + 48 : h + 87);
        buf[2] = (byte)(l < 10 ? l + 48 : l + 87);
        h = (g >> 4) & 15;
        l = g & 15;
        buf[3] = (byte)(h < 10 ? h + 48 : h + 87);
        buf[4] = (byte)(l < 10 ? l + 48 : l + 87);
        h = (b >> 4) & 15;
        l = b & 15;
        buf[5] = (byte)(h < 10 ? h + 48 : h + 87);
        buf[6] = (byte)(l < 10 ? l + 48 : l + 87);
        return buf.ToStr(0, 7);
    }
    static string AlphaAttrs(int color) {
        int a = (color >> 24) & 255;
        if (a == 255) { return ""; }
        string digits = "0123456789";
        int pct = a * 100 / 255;
        string op = "0." + digits.Substring(pct / 10, 1)
                        + digits.Substring(pct % 10, 1);
        return " fill-opacity='" + op + "' stroke-opacity='" + op + "'";
    }
}
