using System;
using Gui;

namespace Gui.Widget;

// 页面页眉（PageHeader）：纯声明式对象树与 CSS 盒模型（Flex 行排布）。
// 组合返回按钮、标题与副标题容器，彻底物理消除所有画布坐标微绘（DrawText、DrawGlyphIn、bx/by 运算）。
public class PageHeader : Control {
    public Binding<string> Text;
    public Binding<string> Subtitle;
    public string Icon;
    public UiEvent Back;

    public Button backBtn;
    public Label titleLabel;
    public Label subtitleLabel;
    public Control textContainer;

    public override int StyleDisplay() { return 1; } // Flex
    public override int StyleFlexDir() { return 0; } // Row

    private void InitPageHeader(string ttl, string sub) {
        this.InitControl(ttl, 1);
        this.ClassName = "pageheader row align-center gap-medium";
        Text = ttl;
        Subtitle = sub;
        Icon = "arrow-left";
        Back = new UiEvent();
        this.BuildTree();
    }

    public PageHeader() { InitPageHeader("", ""); }
    public PageHeader(string ttl, string sub) { InitPageHeader(ttl, sub); }

    public string Label() {
        if (Text == null) { return ""; }
        return Text.Get();
    }

    public string Sub() {
        if (Subtitle == null) { return ""; }
        return Subtitle.Get();
    }

    public void BuildTree() {
        this.children.Clear();

        // 1. 返回按钮
        if (Icon != "") {
            backBtn = new Button("");
            backBtn.ClassName = "pageheader-back ghost row align-center justify-center";
            backBtn.Add(new IconView(Icon, 18));
            backBtn.Click.Add(() => {
                Back.RaiseS(this);
            });
            this.Add(backBtn);
        }

        // 2. 标题与副标题纵向容器
        textContainer = new Control();
        textContainer.ClassName = "pageheader-text col flex-1 justify-center";

        titleLabel = new Label(this.Label());
        titleLabel.ClassName = "pageheader-title font-large font-bold";
        textContainer.Add(titleLabel);

        string sub = this.Sub();
        if (sub != "") {
            subtitleLabel = new Label(sub);
            subtitleLabel.ClassName = "pageheader-subtitle text-secondary";
            textContainer.Add(subtitleLabel);
        }

        this.Add(textContainer);
    }

    public override void SyncBinding() {
        base.SyncBinding();
        if (titleLabel != null) { titleLabel.Text = this.Label(); }
        if (subtitleLabel != null) { subtitleLabel.Text = this.Sub(); }
    }

    public override void OnPaint(App app) {
        int id = this.CommonId();
        SyncBinding();
        app.focus.RegisterFocusable(id);
        app.hitTester.RegisterRect(id, bx, by, bw, bh, 0);
        On.Fire(app, id, this);
    }

    // 控件类型标识（序列化/设计器用）。
    public override string Kind() { return "PageHeader"; }

    public override List<PropSpec> Props() {
        List<PropSpec> ps = new List<PropSpec>();
        PropSpec text = PropSpec.Text("text", "Text");
        text.str = Text;
        text.AsName();
        ps.Add(text);
        PropSpec sub = PropSpec.Text("subtitle", "Subtitle");
        sub.str = Subtitle;
        ps.Add(sub);
        PropSpec icon = PropSpec.Text("icon", "Back icon");
        icon.str = Icon;
        ps.Add(icon);
        return ps;
    }

    public override List<string> Events() {
        List<string> es = Control.CommonEvents();
        es.Add("Back");
        return es;
    }

    public override void BindEvent(string evt, Action a) {
        if (evt == "Back") { Back.Add(a); return; }
        On.AddByName(evt, a);
    }

    public override void BindEventS(string evt, ControlEvent a) {
        if (evt == "Back") { Back.AddS(a); return; }
        On.AddByNameS(evt, a);
    }
}
