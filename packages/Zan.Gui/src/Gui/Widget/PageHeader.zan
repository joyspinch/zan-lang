using System;
using Gui;
namespace Gui.Widget;
public class PageHeader : Control {
    public override Control CreateCloneShell() { return new PageHeader(); }
    public Binding<string> Text;
    public Binding<string> Subtitle;
    public string Icon;
    [Event]
    public UiEvent Back;
    public Button backBtn;
    public Label titleLabel;
    public Label subtitleLabel;
    public Control textContainer;
    private IconView backIconView;
    private string syncedIcon = "";
    public bool responsive;
    private bool autoCompact;
    public override int StyleDisplay() { return 1; } // Flex
    public override int StyleFlexDir() { return 0; } // Row
    private void InitPageHeader(string ttl, string sub) {
        this.InitControl(ttl);
        this.ClassName = "pageheader row align-center gap-medium";
        Text = ttl;
        Subtitle = sub;
        Icon = "arrow-left";
        responsive = true;
        autoCompact = false;
        Back = new UiEvent();
        this.BuildTree();
    }
    public bool Responsive {
        get { return this.responsive; }
        set { this.responsive = value; this.Invalidate(); }
    }
    public bool IsCompact() { return this.autoCompact; }
    public override void Arrange(int x, int y, int w, int h) {
        if (responsive && w > 0) {
            bool wantCompact = Gui.Responsive.FromLogicalWidth(w, this.FindApp()) == Breakpoint.Compact;
            if (wantCompact != autoCompact) {
                autoCompact = wantCompact;
                this.SwitchClass("compact", wantCompact);
                App app = this.FindApp();
                if (app != null) { this.MeasureTree(app); }
            }
        }
        base.Arrange(x, y, w, h);
    }
    public PageHeader() { InitPageHeader("", ""); }
    public PageHeader(string ttl, string sub) { InitPageHeader(ttl, sub); }
    public string Label() {
        if (Text == null) { return ""; }
        return Text.Get();
    }
    public string Sub() {
        if (Subtitle == null) { return ""; }
        return Subtitle.Get();
    }
    public void BuildTree() {
        this.RemoveAll();
        backBtn = null;
        backIconView = null;
        string iconName = Icon != null ? Icon : "";
        syncedIcon = iconName;
        if (iconName != "") {
            backBtn = new Button("");
            backBtn.ClassName = "pageheader-back ghost row align-center justify-center";
            backIconView = new IconView(iconName, 18);
            backBtn.Add(backIconView);
            PageHeaderAction action = new PageHeaderAction(this);
            backBtn.Click.Add(action.Back);
            this.Add(backBtn);
        }
        textContainer = new Control();
        textContainer.ClassName = "pageheader-text col flex-1 justify-center";
        textContainer.SetInlineStyleCss("min-width: 0;");
        titleLabel = new Label(this.Label());
        titleLabel.ClassName = "pageheader-title font-large font-bold";
        titleLabel.SetInlineStyleCss("min-width: 0;");
        textContainer.Add(titleLabel);
        subtitleLabel = null;
        string sub = this.Sub();
        if (sub != "") {
            subtitleLabel = new Label(sub);
            subtitleLabel.ClassName = "pageheader-subtitle text-secondary";
            subtitleLabel.SetInlineStyleCss("min-width: 0;");
            textContainer.Add(subtitleLabel);
        }
        this.Add(textContainer);
    }
    public void SetIcon(string icon) {
        Icon = icon != null ? icon : "";
        this.SyncIcon();
        this.Invalidate();
    }
    private void SyncIcon() {
        string iconName = Icon != null ? Icon : "";
        if (iconName == syncedIcon) { return; }
        syncedIcon = iconName;
        if (iconName == "") {
            if (backBtn != null) {
                this.Remove(backBtn);
                backBtn = null;
                backIconView = null;
            }
            return;
        }
        if (backBtn == null) {
            backBtn = new Button("");
            backBtn.ClassName = "pageheader-back ghost row align-center justify-center";
            backIconView = new IconView(iconName, 18);
            backBtn.Add(backIconView);
            PageHeaderAction action = new PageHeaderAction(this);
            backBtn.Click.Add(action.Back);
            this.InsertAt(0, backBtn);
        } else if (backIconView != null) {
            backIconView.Name = iconName;
        }
    }
    protected override void OnPropertyChanged(PropSpec spec) {
        this.SyncBinding();
        this.Invalidate();
    }
    public override void SyncBinding() {
        base.SyncBinding();
        this.SyncIcon();
        if (titleLabel != null) { titleLabel.Text = this.Label(); }
        string sub = this.Sub();
        if (sub != "") {
            if (subtitleLabel == null && textContainer != null) {
                subtitleLabel = new Label(sub);
                subtitleLabel.ClassName = "pageheader-subtitle text-secondary";
                subtitleLabel.SetInlineStyleCss("min-width: 0;");
                textContainer.Add(subtitleLabel);
            } else if (subtitleLabel != null) {
                subtitleLabel.Text = sub;
                subtitleLabel.Visible = true;
            }
        } else if (subtitleLabel != null) {
            subtitleLabel.Text = "";
            subtitleLabel.Visible = false;
        }
    }
    public override void CloneContentTo(Control target, CloneTreeFn clone) {
    }
    protected override List<PropSpec> DefineProps() {
        List<PropSpec> ps = new List<PropSpec>();
        ps.Add(PropSpec.TextField("Text"));
        ps.Add(PropSpec.TextField("Subtitle"));
        ps.Add(PropSpec.Text("icon", "Back icon").Field("Icon").Setter("SetIcon"));
        return ps;
    }
}
