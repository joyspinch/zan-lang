using System;
using Gui;
namespace Gui.Widget;
public class Checkbox : ToggleControl {
    public override Control CreateCloneShell() { return new Checkbox(); }
    public string label;
    public Binding<bool> Indeterminate;
    protected override bool UsesBaseFlowOnly() { return this.Kind() == "Checkbox"; }
    public override int StyleDisplay() { return 1; } // CSS display: flex
    public override int StyleFlexDir() { return 0; } // flex-direction: row
    private void InitCheckbox(string lbl, Binding<bool> checkedValue) {
        this.InitToggle(lbl);
        this.wiresOwnEvents = false;
        label = lbl;
        if (checkedValue != null) { Checked = checkedValue; }
        Indeterminate = false;
        this.Add(new CheckboxIndicator(this));
        this.SetLabel(lbl);
    }
    public Checkbox() { InitCheckbox("", false); }
    public Checkbox(string lbl) { InitCheckbox(lbl, false); }
    public Checkbox(string label, Binding<bool> checkedValue) { InitCheckbox(label, checkedValue); }
    public string Str() { return label; }
    public void SetLabel(string v) {
        label = v;
        if (this.ChildCount() > 1 && this.ChildAt(1) is Label) {
            ((Label)this.ChildAt(1)).SetProp("text", v);
        } else if (v != "") {
            this.InsertAt(1, new Label(v));
        }
    }
    public bool IsIndeterminate() { return Indeterminate != null ? Indeterminate.Get() : false; }
    public override void SyncBinding() {
        base.SyncBinding();
        this.ApplySizeClass();
    }
    public override void CloneContentTo(Control target, CloneTreeFn clone) {
    }
    protected override List<PropSpec> DefineProps() {
        List<PropSpec> ps = new List<PropSpec>();
        ps.Add(PropSpec.Text("label", "Label").Field("label").Setter("SetLabel").Also("text"));
        ps.Add(PropSpec.Bool("value", "Checked").DefaultBinding()
            .Field("Checked")
            .Also("checked")
            .Also("data"));
        ps.Add(PropSpec.BoolField("Indeterminate"));
        ps.Add(this.SizeProp());
        return ps;
    }
    public override int InputFocusCapabilities() { return 1; }
    public static void PaintBox(App app, int x, int y, int size, int level) {
        StyleBox box = Style.PartRef(app, "checkbox", "box", "", "", "",
            level > 0 ? Style.SChecked() : Style.SNormal());
        box.Paint(app, x, y, size, size);
        if (level == 500) {
            StyleBox bar = Style.OfRef(app, "control", "checkbox-bar", Style.SNormal());
            int width = bar.WidthOr(app.Scale(10));
            int height = bar.HeightOr(app.Scale(2));
            bar.Paint(app, x + (size - width) / 2, y + (size - height) / 2, width, height);
        } else if (level > 0) {
            StyleBox mark = Style.PartRef(app, "checkbox", "check", "", "", "", Style.SChecked());
            int glyph = Math.Min(size, app.Scale(12));
            IconSvg.Draw(app.canvas, "check", x + (size - glyph) / 2, y + (size - glyph) / 2,
                glyph, mark.FgOr(box.fg));
        }
    }
    internal static void PaintBoxWith(App app, int x, int y, int size, int level,
                                      StyleBox boxNorm, StyleBox boxChecked,
                                      StyleBox barBox, StyleBox checkChecked) {
        StyleBox box = level > 0 ? boxChecked : boxNorm;
        box.Paint(app, x, y, size, size);
        if (level == 500) {
            int width = barBox.WidthOr(app.Scale(10));
            int height = barBox.HeightOr(app.Scale(2));
            barBox.Paint(app, x + (size - width) / 2, y + (size - height) / 2, width, height);
        } else if (level > 0) {
            int glyph = Math.Min(size, app.Scale(12));
            IconSvg.Draw(app.canvas, "check", x + (size - glyph) / 2, y + (size - glyph) / 2,
                glyph, checkChecked.FgOr(box.fg));
        }
    }
    public static void PaintBoxIndeterminate(App app, int x, int y, int size) {
        Checkbox.PaintBox(app, x, y, size, 500);
    }
}
public class CheckboxIndicator : Control {
    private weak Checkbox owner;
    private CheckboxCheckIcon checkIcon;
    private ChoiceMark barNode;
    private ChoiceVisualMotion markMotion = new ChoiceVisualMotion();
    private int markState;
    private int shownMark;
    private int markLevel;
    private bool indSynced;
    private int lastIndState;
    private int lastIndLevel;
    private string lastIndCls;
    protected override bool UsesBaseFlowOnly() { return this.Kind() == "CheckboxIndicator"; }
    public override int StyleDisplay() { return 1; } // CSS display: flex
    public override int StyleFlexDir() { return 0; } // flex-direction: row
    protected override Control SurfaceInputOwner() { return owner; }
    public CheckboxIndicator(Checkbox o) {
        owner = o;
        this.InitControl("box");
        this.ClassName = "checkbox-indicator align-center justify-center";
        checkIcon = new CheckboxCheckIcon();
        barNode = new ChoiceMark { ClassName = "checkbox-bar" };
        this.Add(checkIcon);
        this.Add(barNode);
    }
    public override void SyncBinding() {
        base.SyncBinding();
        Checkbox checkbox = owner;
        if (checkbox == null) { return; }
        markState = checkbox.IsIndeterminate() ? 2 : (checkbox.IsChecked() ? 1 : 0);
        if (indSynced && markState == lastIndState && markLevel == lastIndLevel && Class == lastIndCls) {
            return;
        }
        if (markState == 2) { this.AddClass("indeterminate"); }
        else { this.RemoveClass("indeterminate"); }
        if (markState == 1) { this.AddClass("checked"); }
        else { this.RemoveClass("checked"); }
        this.SetSurfaceTransitionKey(markState + 1);
        if (markState != 0 || markLevel == 0) { shownMark = markState; }
        checkIcon.Visible = shownMark == 1;
        barNode.Visible = shownMark == 2;
        indSynced = true;
        lastIndState = markState;
        lastIndLevel = markLevel;
        lastIndCls = Class;
    }
    public override void OnPaint(App app) {
        if (bw <= 0 || bh <= 0) { return; }
        StyleBox style = paintedStyle != null ? paintedStyle : this.Box(app);
        markLevel = markMotion.Sample(app, markState == 0 ? 0 : 1000,
            this.IsDisabled() ? 0 : style.transitionMs, style.easing);
        checkIcon.Level = markLevel;
        barNode.Level = markLevel;
        if (markMotion.Active()) { app.RequestAnimationFrameIn(bx, by, bw, bh); }
    }
}
class CheckboxCheckIcon : IconView {
    internal int Level;
    protected override bool UsesBaseFlowOnly() { return this.Kind() == "CheckboxCheckIcon"; }
    protected override bool UsesBaseSyncBinding() { return this.Kind() == "CheckboxCheckIcon"; }
    CheckboxCheckIcon() : base("check", 12) { this.ClassName = "checkbox-check"; }
    public override void OnPaint(App app) {
        if (Level >= 1000) { base.OnPaint(app); return; }
        int size = Math.Min(Math.Min(bw, bh), app.Scale(Box)) * Level / 1000;
        if (size <= 0) { return; }
        StyleBox style = paintedStyle != null ? paintedStyle : this.Box(app);
        int color = Color != 0 ? Color : style.FgOr(app.theme.textPrimary);
        IconSvg.Draw(app.canvas, Name, bx + (bw - size) / 2, by + (bh - size) / 2, size, color);
    }
}
class ChoiceMark : Control {
    internal int Level;
    protected override bool UsesBaseFlowOnly() { return this.Kind() == "ChoiceMark"; }
    protected override bool UsesBaseSyncBinding() { return this.Kind() == "ChoiceMark"; }
    ChoiceMark() { styleSurfaceOwned = true; }
    public override void OnPaint(App app) {
        int width = bw * Level / 1000;
        int height = bh * Level / 1000;
        if (width <= 0 || height <= 0) { return; }
        StyleBox style = this.ResolvePaintedSurface(app);
        style.Paint(app, bx + (bw - width) / 2, by + (bh - height) / 2, width, height);
    }
}
class ChoiceVisualMotion {
    private weak App host;
    private int from;
    private int target;
    private int startedMs;
    private int durationMs;
    private int curve;
    internal int Sample(App app, int destination, int duration, int easing) {
        if (host != app || app.reducedMotion || duration <= 0) {
            host = app;
            from = destination;
            target = destination;
            durationMs = 0;
            return target;
        }
        int value = this.ValueAt(app.nowMs);
        if (destination != target) {
            from = value;
            target = destination;
            startedMs = app.nowMs;
            durationMs = from == target ? 0 : duration;
            curve = easing;
        }
        return value;
    }
    internal bool Active() { return durationMs > 0; }
    private int ValueAt(int nowMs) {
        if (durationMs <= 0) { return target; }
        int elapsed = nowMs - startedMs;
        if (elapsed >= durationMs) { durationMs = 0; return target; }
        if (elapsed <= 0) { return from; }
        int progress = (int)((long)elapsed * 1000 / durationMs);
        return App.Lerp(from, target, Style.Curve(curve, progress));
    }
}
