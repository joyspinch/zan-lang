using System;
using Gui;

namespace Gui.Widget;

// 复选框组件。纯 Flex 弹性行容器，支持双向布尔绑定与子组件互嵌。
//
// 基础用法：
//   Checkbox cb = new Checkbox("同意服务条款");
//   cb.Change += () => { OnAgreeChanged(); };
//
// 响应式数据绑定：
//   cb.Checked = model.isAgreed;
//
// 复合互嵌（DOM 组合）：
//   Checkbox custom = new Checkbox().With(new IconView("shield")).With(new Label("高级安全保护"));
//
// 样式类：
//   .tiny .small .medium .large (尺寸档位)
//   .bordered                   (边框变体)
public class Checkbox : ToggleControl {
    public string label;
    public Binding<bool> Indeterminate;

    public override int StyleDisplay() { return 1; } // CSS display: flex
    public override int StyleFlexDir() { return 0; } // flex-direction: row

    private void InitCheckbox(string lbl, Binding<bool> checkedValue) {
        this.InitToggle(lbl);
        label = lbl;
        if (checkedValue != null) { Checked = checkedValue; }
        Indeterminate = false;
        this.Add(new CheckboxIndicator(this));
        this.SetLabel(lbl);
    }

    public Checkbox() {
        InitCheckbox("", false);
    }

    public Checkbox(string lbl) {
        InitCheckbox(lbl, false);
    }

    public Checkbox(string label, Binding<bool> checkedValue) {
        InitCheckbox(label, checkedValue);
    }

    public string Str() { return label; }

    public override void SetProp(string key, string val) {
        if (key == "label" || key == "text") {
            this.SetLabel(val);
            this.Invalidate();
            return;
        }
        base.SetProp(key, val);
    }

    public void SetLabel(string v) {
        label = v;
        if (this.ChildCount() > 1 && this.ChildAt(1) is Label) {
            ((Label)this.ChildAt(1)).SetProp("text", v);
        } else if (v != "") {
            this.InsertAt(1, new Label(v));
        }
    }

    public bool IsIndeterminate() {
        return Indeterminate != null ? Indeterminate.Get() : false;
    }

    public override void CloneContentTo(Control target, CloneTreeFn clone) {
        // Constructor and property replay recreate the generated parts.
    }

    protected override List<PropSpec> DefineProps() {
        List<PropSpec> ps = new List<PropSpec>();
        ps.Add(PropSpec.Text("label", "Label").Field("label").Also("text"));
        ps.Add(PropSpec.Bool("value", "Checked").DefaultBinding()
            .Field("Checked")
            .Also("checked")
            .Also("data"));
        ps.Add(PropSpec.BoolField("Indeterminate"));
        ps.Add(this.SizeProp());
        return ps;
    }

    public override int InputFocusCapabilities() { return 1; }

    // Composite row painters share the indicator skin without allocating a control tree.
    public static void PaintBox(App app, int x, int y, int size, int level) {
        int state = level > 0 ? Style.SChecked() : Style.SNormal();
        StyleBox box = Style.Part(app, "checkbox", "box", "", "", "", state);
        box.Paint(app, x, y, size, size);
        if (level == 500) {
            StyleBox bar = Style.Of(app, "control", "checkbox-bar", Style.SNormal());
            int width = bar.WidthOr(app.Scale(10));
            int height = bar.HeightOr(app.Scale(2));
            bar.Paint(app, x + (size - width) / 2, y + (size - height) / 2, width, height);
        } else if (level > 0) {
            StyleBox mark = Style.Part(app, "checkbox", "check", "", "", "", state);
            int glyph = Math.Min(size, app.Scale(12));
            IconSvg.Draw(app.canvas, "check", x + (size - glyph) / 2, y + (size - glyph) / 2,
                glyph, mark.FgOr(box.fg));
        }
    }

    public static void PaintBoxIndeterminate(App app, int x, int y, int size) {
        Checkbox.PaintBox(app, x, y, size, 500);
    }
}

// 复选框指示器（小方框）：纯 Flex 节点，完全由 CSS 盒模型渲染。
public class CheckboxIndicator : Control {
    weak Checkbox owner;
    IconView checkIcon;
    Control barNode;

    public override int StyleDisplay() { return 1; } // CSS display: flex
    public override int StyleFlexDir() { return 0; } // flex-direction: row
    protected override Control SurfaceInputOwner() { return owner; }

    public CheckboxIndicator(Checkbox o) {
        owner = o;
        this.InitControl("box", 1);
        this.ClassName = "checkbox-indicator align-center justify-center";
        checkIcon = new IconView("check", 12);
        checkIcon.ClassName = "checkbox-check";
        barNode = new Control { ClassName = "checkbox-bar" };
        this.Add(checkIcon);
        this.Add(barNode);
    }

    public override void SyncBinding() {
        base.SyncBinding();
        if (owner == null) { return; }
        if (owner.IsIndeterminate()) {
            this.AddClass("indeterminate");
            this.RemoveClass("checked");
            if (checkIcon != null) { checkIcon.Visible = false; }
            if (barNode != null) { barNode.Visible = true; }
        } else if (owner.IsChecked()) {
            this.AddClass("checked");
            this.RemoveClass("indeterminate");
            if (checkIcon != null) { checkIcon.Visible = true; }
            if (barNode != null) { barNode.Visible = false; }
        } else {
            this.RemoveClass("checked");
            this.RemoveClass("indeterminate");
            if (checkIcon != null) { checkIcon.Visible = false; }
            if (barNode != null) { barNode.Visible = false; }
        }
    }
}
