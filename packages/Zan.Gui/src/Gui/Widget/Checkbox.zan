using System;
using Gui;

namespace Gui.Widget;

// 复选框组件。纯 Flex 弹性行容器，支持双向布尔绑定与子组件互嵌。
//
// 基础用法：
//   Checkbox cb = new Checkbox("同意服务条款");
//   cb.Change += () => { OnAgreeChanged(); };
//
// 响应式数据绑定：
//   cb.data = model.isAgreed;
//
// 复合互嵌（DOM 组合）：
//   Checkbox custom = new Checkbox().With(new IconView("shield")).With(new Label("高级安全保护"));
//
// 样式类：
//   .tiny .small .medium .large (尺寸档位)
//   .bordered                   (边框变体)
public class Checkbox : ToggleControl {
    public string label;
    public SignalBool model { get { return onSig; } set { onSig = value; } }
    public Binding<bool> Indeterminate;

    public override int StyleDisplay() { return 1; } // CSS display: flex
    public override int StyleFlexDir() { return 0; } // flex-direction: row

    private void InitCheckbox(string lbl, SignalBool m) {
        this.InitToggle(lbl);
        label = lbl;
        onSig = m != null ? m : new SignalBool(false);
        Indeterminate = false;
        this.Add(new CheckboxIndicator(this));
        if (lbl != "") {
            this.Add(new Label(lbl));
        }
    }

    public Checkbox() {
        InitCheckbox("", false);
    }

    public Checkbox(string lbl) {
        InitCheckbox(lbl, false);
    }

    public Checkbox(string label, SignalBool model) : this(label) {
        this.model = model;
    }

    public static Checkbox Bind(string label, SignalBool model) {
        return new Checkbox(label, model);
    }

    public string Str() { return label; }

    public void SetLabel(string v) {
        label = v;
        if (children.Count > 1 && children[1] is Label) {
            ((Label)children[1]).Text = v;
        }
    }

    public bool IsIndeterminate() {
        return Indeterminate != null ? Indeterminate.Get() : false;
    }

    public override string Kind() { return "Checkbox"; }

    public override List<PropSpec> Props() {
        List<PropSpec> ps = new List<PropSpec>();
        PropSpec text = PropSpec.Text("label", "Label");
        text.str = label;
        text.Also("text");
        ps.Add(text);
        PropSpec on = PropSpec.Bool("value", "Checked");
        on.sflag = model;
        if (data != null) { on.flag = data; }
        on.Also("checked");
        on.Also("data");
        ps.Add(on);
        PropSpec ind = PropSpec.Bool("indeterminate", "Indeterminate");
        ind.flag = Indeterminate;
        ps.Add(ind);
        ps.Add(this.SizeProp());
        return ps;
    }

    public override void OnPaint(App app) {
        int id = this.CommonId();
        SyncBinding();
        app.focus.RegisterFocusable(id);
        string a11y = this.EffectiveA11yRole("checkbox") + ":" + this.EffectiveA11yLabel(label);
        app.hitTester.RegisterRectL(id, bx, by, bw, bh, 0, a11y);
        On.Fire(app, id, this);
    }

    public static void PaintBox(App app, int x, int y, int size, int level) {
        Checkbox cb = new Checkbox();
        cb.Arrange(x, y, size, size);
        cb.SetChecked(level > 0);
        cb.Indeterminate = (level == 500);
        cb.RenderTree(app);
    }

    public static void PaintBoxIndeterminate(App app, int x, int y, int size) {
        Checkbox.PaintBox(app, x, y, size, 500);
    }
}

// 复选框指示器（小方框）：纯 Flex 节点，完全由 CSS 盒模型渲染。
public class CheckboxIndicator : Control {
    Checkbox owner;
    IconView checkIcon;
    Control barNode;

    public override int StyleDisplay() { return 1; } // CSS display: flex
    public override int StyleFlexDir() { return 0; } // flex-direction: row

    public CheckboxIndicator(Checkbox o) {
        owner = o;
        this.InitControl("box", 1);
        this.ClassName = "checkbox-indicator align-center justify-center";
        checkIcon = new IconView("check", 12);
        checkIcon.ClassName = "checkbox-check";
        barNode = new Control { ClassName = "checkbox-bar" };
        this.Add(checkIcon);
        this.Add(barNode);
    }

    public override void SyncBinding() {
        base.SyncBinding();
        if (owner == null) { return; }
        if (owner.IsIndeterminate()) {
            this.AddClass("indeterminate");
            this.RemoveClass("checked");
            if (checkIcon != null) { checkIcon.Visible = false; }
            if (barNode != null) { barNode.Visible = true; }
        } else if (owner.IsChecked()) {
            this.AddClass("checked");
            this.RemoveClass("indeterminate");
            if (checkIcon != null) { checkIcon.Visible = true; }
            if (barNode != null) { barNode.Visible = false; }
        } else {
            this.RemoveClass("checked");
            this.RemoveClass("indeterminate");
            if (checkIcon != null) { checkIcon.Visible = false; }
            if (barNode != null) { barNode.Visible = false; }
        }
    }
}
