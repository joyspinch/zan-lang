using System;
using System.Collections.Generic;
using Gui;
namespace Gui.Widget;
public class Column : Flex {
    public Column() {
        InitFlex("column");
    }
    public Column(List<Control> items) : this() {
        if (items != null) {
            for (int i = 0; i < items.Count; i = i + 1) {
                this.Add(items[i]);
            }
        }
    }
    public override string Kind() { return "Column"; }
}
