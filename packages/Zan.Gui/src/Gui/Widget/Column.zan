using System;
using System.Collections.Generic;
using Gui;

namespace Gui.Widget;

// 现代化纵向流式排版原语（对齐 Naive UI n-flex / SwiftUI VStack / Flutter Column）。
// 内部使用 Flex 引擎，主轴为 column，子项自上而下排列，
// 支持 Gap() 间距与 Spacer 弹性占位。
public class Column : Flex {
    public Column() {
        InitFlex("column");
        this.layout = 1;
    }

    public Column(List<Control> items) : this() {
        if (items != null) { this.Children(items); }
    }

    // 设置主轴项目间距（像素）
    public Column Gap(int px) {
        this.gap = px;
        return this;
    }

    // 设置交叉轴对齐（start / center / end / stretch）
    public Column Align(string mode) {
        base.Align(mode);
        return this;
    }

    // 交叉轴居中对齐
    public Column AlignCenter() {
        base.AlignCenter();
        return this;
    }

    // 交叉轴起点对齐
    public Column AlignStart() {
        base.AlignStart();
        return this;
    }

    // 交叉轴终点对齐
    public Column AlignEnd() {
        base.AlignEnd();
        return this;
    }

    // 设置主轴对齐（start / center / end / between / around）
    public Column Justify(string mode) {
        base.Justify(mode);
        return this;
    }

    // 批量追加子节点并返回强类型 Column 以维持方法链
    public Column Children(List<Control> items) {
        if (items != null) {
            for (int i = 0; i < items.Count; i = i + 1) {
                this.With(items[i]);
            }
        }
        return this;
    }

    // 流式追加单个子项并返回强类型 Column
    public Column Child(Control c) {
        this.With(c);
        return this;
    }
}
