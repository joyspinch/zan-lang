using System;
using System.Collections.Generic;
using Gui;
namespace Gui.Widget;
public class Column : Flex {
    // 按父类种类上报：序列化与自动化以 "Flex" 识别本控件。
    public override string Kind() { return "Flex"; }
    public Column() {
        InitFlex("column");
    }
    public Column(List<Control> items) : this() {
        if (items != null) { this.Children(items); }
    }
    public Column Gap(int px) { this.gap = px; return this; }
    public Column Align(string mode) { base.Align(mode); return this; }
    public Column AlignCenter() { base.AlignCenter(); return this; }
    public Column AlignStart() { base.AlignStart(); return this; }
    public Column AlignEnd() { base.AlignEnd(); return this; }
    public Column Justify(string mode) { base.Justify(mode); return this; }
    public Column Children(List<Control> items) {
        if (items != null) {
            for (int i = 0; i < items.Count; i = i + 1) {
                this.Add(items[i]);
            }
        }
        return this;
    }
    public Column Child(Control c) { this.Add(c); return this; }
}
