using System;
using System.IO;
using System.Json;
using System.Web;

// role:control 设计稿的运行期宿主基类（B-ID44）：把 HTML 设计稿投影成
// 本控件的子树——DesignerHtml.ToJsonDoc 解出文档模型，FormBuilder.
// ProjectInto 直建 fields/bodyContent（不经 body 包装，宿主自己就是
// 设计根）。命名控件用 accessor 属性寻址（this.Tree 这类成员由设计
// 半件提供，落到 Ctl）；事件由宿主 ChildWindow 的 Handle/Wire 通道
// 接线。对齐生成器时代的 partial class : Control 契约——不再需要
// 编译期生成物，设计稿经 --embed 烘进 exe（File.ReadAllText 内嵌优先，
// 压缩加密存放），开发期读散盘同一行代码。
public class DesignedControl : Control {
    // 投影设计稿进本控件。kindName 是设计稿类名：既是控件 Kind
    // （设计器/样式表按它认），也是文档里引用本控件时的 kind。
    protected void Design(string kindName, string docPath) {
        this.InitControl(kindName, 5);
        string html = File.ReadAllText(docPath);
        JsonValue root = JsonValue.ParseLenient(DesignerHtml.ToJsonDoc(html));
        // 自动布局（layoutMode=0）按生成器口径挂 designroot：内边距/
        // 行距取自样式表，统一间距只有一处定义；自由画布不挂。
        if (root.Int("layoutMode", 0) != 1) { this.AddClass("designroot"); }
        FormBuilder.ProjectInto(this, root);
    }

    // 设计稿 kind：InitControl 落在本控件 name 上，Kind 直接回读。
    override string Kind() { return this.name; }

    // 命名控件解析：找不着当场抛——设计稿改名而半件没跟上时不静默。
    protected Control Ctl(string name) {
        Control c = this.Find(name);
        if (c == null) { throw new Exception("designed control missing: " + name); }
        return c;
    }
}
