using System;
using Gui;
namespace Gui.Widget;
[GuiKind("Table")]
public class Table : Control {
    public override Control CreateCloneShell() { return new Table(); }
    public override int StyleDisplay() { return 1; } // Flex
    public override int StyleFlexDir() { return 1; } // Column
    public Table() {
        this.InitControl("table");
        this.ClassName = "table col";
    }
    public void AddRow(TableRow row) {
        if (row != null) { this.Add(row); }
    }
    public override string Kind() { return "Table"; }
    protected override List<PropSpec> DefineProps() {
        List<PropSpec> ps = new List<PropSpec>();
        ps.Add(this.SizeProp());
        return ps;
    }
}
