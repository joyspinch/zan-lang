using System;
using Gui;

namespace Gui.Widget;

// 数据表格（Table）：纯声明式对象树与 CSS 盒模型（Flex 列排布），包含 TableRow 子节点。
// 彻底物理消除所有画布坐标微绘（DrawText、SubBox.Paint、cx/cy 手工运算）与即时度量。
public class Table : Control {
    public override int StyleDisplay() { return 1; } // Flex
    public override int StyleFlexDir() { return 1; } // Column

    public Table() {
        this.InitControl("table", 1);
        this.ClassName = "table col";
    }

    public Table AddRow(TableRow row) {
        if (row != null) {
            this.Add(row);
        }
        return this;
    }

    public override string Kind() { return "Table"; }

    public override void OnPaint(App app) {
        int id = this.CommonId();
        SyncBinding();
        app.focus.RegisterFocusable(id);
        app.hitTester.RegisterRect(id, bx, by, bw, bh, 0);
        On.Fire(app, id, this);
    }
}
