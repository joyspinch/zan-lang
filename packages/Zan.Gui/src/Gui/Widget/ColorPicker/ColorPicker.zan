using System;
using Gui;
namespace Gui.Widget;
public partial class ColorPicker : Control {
    public override Control CreateCloneShell() { return new ColorPicker(); }
    public Control customPopup;
    public Binding<int> Value;
    public int wid;
    public override int WidgetId() { return wid; }
    public override int PointerCursor() { return 0; }
    public override void OnPointerEnter(RoutedEventArgs e) {
        base.OnPointerEnter(e);
        App a = this.FindApp();
        if (a != null) { a.RequestRedraw(); }
    }
    public override void OnPointerLeave(RoutedEventArgs e) {
        base.OnPointerLeave(e);
        App a = this.FindApp();
        if (a != null) { a.RequestRedraw(); }
    }
    // 值变化时触发（C# 风格：`pick.Change += h;`）。拖动面板/条、
    // 输入行回车提交都会触发；程序化 SetColor 不触发。
    [Event]
    public UiEvent Change;
    public bool open;
    public int hue;
    public int sat;
    public int val;
    public int alpha;
    public bool showAlpha;
    public List<string> modes;
    public Binding<string> Mode;
    public int dragPart;
    public Input inR;
    public Input inG;
    public Input inB;
    public Input inA;
    public Input inHex;
    public Input inHsl;
    public Input inHsb;
    public int inputView;
    public static int SvPanelOff() { return 1; }
    public static int HueOff() { return 2; }
    public static int AlphaOff() { return 3; }
    public bool hsvTouched;
    public int basePacked;
    private void InitPicker(int packed) {
        this.InitControl("colorpicker");
        Value = packed;
        wid = this.CommonId() * 10;
        wiresOwnEvents = true;
        Change = new UiEvent();
        open = false;
        hue = 0;
        sat = 0;
        val = 0;
        alpha = 255;
        hsvTouched = false;
        basePacked = 0xFF000000;
        showAlpha = true;
        modes = new List<string>();
        Mode = "rgb";
        dragPart = 0;
        inR = new Input("0");
        inG = new Input("0");
        inB = new Input("0");
        inA = new Input("100");
        inR.AddClass("colorpicker-channel");
        inG.AddClass("colorpicker-channel");
        inB.AddClass("colorpicker-channel");
        inA.AddClass("colorpicker-channel");
        inHex = new Input("#000000");
        inHsl = new Input("0, 0%, 0%");
        inHsb = new Input("0, 0%, 0%");
        inR.name = "0";
        inG.name = "1";
        inB.name = "2";
        inA.name = "3";
        inHex.name = "4";
        inHsl.name = "5";
        inHsb.name = "6";
        inR.wid = wid + 8;
        inG.wid = wid + 9;
        inB.wid = wid + 10;
        inA.wid = wid + 11;
        inHex.wid = wid + 12;
        inHsl.wid = wid + 13;
        inHsb.wid = wid + 14;
        inputView = 0;
        inR.Submit.Add(ColorPicker.OnChannelSubmit);
        inG.Submit.Add(ColorPicker.OnChannelSubmit);
        inB.Submit.Add(ColorPicker.OnChannelSubmit);
        inA.Submit.Add(ColorPicker.OnChannelSubmit);
        inHex.Submit.Add(ColorPicker.OnChannelSubmit);
        inHsl.Submit.Add(ColorPicker.OnChannelSubmit);
        inHsb.Submit.Add(ColorPicker.OnChannelSubmit);
    }
    public ColorPicker() {
        this.InitPicker(0xFF000000);
        this.ApplyPacked(Value.Get());
    }
    public ColorPicker(int packed) {
        this.InitPicker(packed);
        this.ApplyPacked(packed);
    }
    public int CurrentRgb() {
        int rgb = hsvTouched
            ? ColorPicker.RgbOf(ColorPicker.HsvToRgb(hue, sat, val))
            : ColorPicker.RgbOf(basePacked);
        return ColorMath.WithAlpha(rgb, alpha);
    }
    public void ApplyPacked(int packed) {
        basePacked = packed;
        hsvTouched = false;
        alpha = ColorPicker.AlphaOf(packed);
        if (!showAlpha) { alpha = 255; }
        this.ApplyRgbToHsv(ColorPicker.RgbOf(packed));
    }
    public void SetColor(int packed) {
        this.ApplyPacked(packed);
        Value.Set(this.CurrentRgb());
    }
    public void Commit() {
        int packed = this.CurrentRgb();
        Value.Set(packed);
        Change.Raise(this);
    }
    public override void SyncBinding() {
        base.SyncBinding();
        int packed = Value.Get();
        if (!ColorPicker.SamePacked(packed, this.CurrentRgb())) { this.ApplyPacked(packed); }
    }
    public void SetShowAlpha(bool on) {
        showAlpha = on;
        if (!on) { alpha = 255; }
        if (inA != null) {
            inA.SetShown(on && inputView == 0);
            bool curDis = inA.Disabled != null && inA.Disabled.Get();
            if (curDis != !on) { inA.Disabled = !on; }
        }
    }
    public void SetModes(List<string> list) {
        modes = list;
        if (modes == null) { modes = new List<string>(); }
        if (modes.Count == 1) {
            string m0 = modes[0].ToLower();
            if (m0 == "rgb" || m0 == "hex" || m0 == "hsl" || m0 == "hsb") {
                Mode = m0;
                return;
            }
        }
        string cur = this.ModeName();
        bool ok = modes.Count == 0;
        for (int i = 0; i < modes.Count; i = i + 1) {
            if (modes[i].ToLower() == cur) { ok = true; }
        }
        if (!ok && modes.Count > 0) {
            string first = modes[0].ToLower();
            if (first == "rgb" || first == "hex" || first == "hsl"
                || first == "hsb") {
                Mode = first;
            }
        }
    }
    public void Modes(string a, string b, string c, string d) {
        List<string> list = new List<string>();
        if (a != null && a != "") { list.Add(a); }
        if (b != null && b != "") { list.Add(b); }
        if (c != null && c != "") { list.Add(c); }
        if (d != null && d != "") { list.Add(d); }
        this.SetModes(list);
    }
    public string Text() { return this.FormatAs(this.ModeName()); }
    public string ModeName() {
        string m = Mode != null ? Mode.Get() : "";
        if (m == null) { m = ""; }
        m = m.ToLower();
        if (m != "rgb" && m != "hex" && m != "hsl" && m != "hsb") { m = ""; }
        if (m == "" && modes != null && modes.Count == 1) { m = modes[0].ToLower(); }
        if (m != "rgb" && m != "hex" && m != "hsl" && m != "hsb") { m = "rgb"; }
        return m;
    }
    public string FormatAs(string m) {
        int rgb = ColorPicker.RgbOf(this.CurrentRgb());
        if (m == "hex") {
            if (showAlpha) { return ColorPicker.HexTextAlpha(this.CurrentRgb()); }
            return ColorPicker.HexText(this.CurrentRgb());
        }
        if (m == "hsl" || m == "hsb") {
            string head = m == "hsl" ? "hsl" : "hsb";
            int h;
            int s2;
            int l2;
            if (m == "hsl") {
                int packed = ColorPicker.RgbHsl((rgb / 65536) % 256,
                                                (rgb / 256) % 256, rgb % 256);
                h = packed / 1000000;
                s2 = (packed / 1000) % 1000;
                l2 = packed % 1000;
            } else {
                h = hue;
                s2 = sat;
                l2 = val;
            }
            string txt = head + "(" + Convert.ToString(h) + ", "
                + Convert.ToString(s2 / 10) + "%, "
                + Convert.ToString(l2 / 10) + "%";
            if (showAlpha) { txt = txt + ", " + this.AlphaText(); }
            return txt + ")";
        }
        string kind = showAlpha ? "rgba" : "rgb";
        string parts = Convert.ToString((rgb / 65536) % 256) + ", "
            + Convert.ToString((rgb / 256) % 256) + ", "
            + Convert.ToString(rgb % 256);
        if (showAlpha) { return kind + "(" + parts + ", " + this.AlphaText() + ")"; }
        return kind + "(" + parts + ")";
    }
    public string AlphaText() {
        if (alpha >= 255) { return "1"; }
        int hundredths = alpha * 100 / 255;
        int whole = hundredths / 100;
        int frac = hundredths % 100;
        string fs = Convert.ToString(frac);
        if (frac < 10) { fs = "0" + fs; }
        return Convert.ToString(whole) + "." + fs;
    }
    // ---- 设计器 ----------------------------------------------------

    // 取值格式名（rgb/hex/hsl/hsb）；读回的是生效格式名。
    public void SetModeName(string m) {
        if (Mode != null) { Mode.Set(m); } else { Mode = m; }
    }

    // 设计器属性表：showAlpha 开关与 mode 取值格式枚举。
    protected override List<PropSpec> DefineProps() {
        List<PropSpec> ps = new List<PropSpec>();
        ps.Add(PropSpec.Text("value", "Color").DefaultBinding().Accessor("Text", "SetText").Also("data").Also("color").Also("text"));
        ps.Add(PropSpec.Bool("showAlpha", "Show alpha")
            .Field("showAlpha").Setter("SetShowAlpha")
            .WithTip("Show the alpha slider (Naive UI show-alpha)."));
        PropSpec md = PropSpec.Enum("mode", "Mode",
            new List<string>{ "rgb", "hex", "hsl", "hsb" }).Accessor("ModeName", "SetModeName");
        md.WithTip("Format of the value text (Naive UI modes[0]).");
        ps.Add(md);
        return ps;
    }
    // 从文本赋值（designer / 程序化）："#RRGGBB[AA]" 与
    // rgba()/rgb()/hsl()/hsb() 都接受，非法文本忽略。
    public void SetText(string value) {
        ColorParseResult res = ColorPicker.HexParse(value);
        if (!res.ok) { res = ColorPicker.FuncParse(value); }
        if (res.ok) { this.SetColor(res.packed); }
    }
    public int TriggerH() { return this.TriggerH(this.App); }
    public int TriggerH(App app) {
        app = this.ResolveApp(app);
        if (app == null) { return 32; }
        StyleBox s = this.ResolveStyleCached(app, "colorpicker", Class,
                                             Style.SNormal());
        return s.HeightOr(app.theme.heightMedium);
    }
    private StyleBox triggerPaintBox;
    private int PaintTrigger(App app, int x, int y, int width, int height) {
        int id = wid;
        bool disabled = this.IsDisabled();
        StyleBox root = this.ResolveEasedStyleAsIn(
            app, id, "colorpicker", Class, disabled, false, x, y, width, height);
        root.Paint(app, x, y, width, height);
        StyleBox trgRef = this.ResolveEasedPartRefAsIn(
            app, id, "colorpicker", "trigger", "", Class, disabled, false,
            x, y, width, height);
        int pad = root.BorderWOr(0) + root.PadLOr(app.Scale(3));
        int swW = width - pad * 2;
        int swH = height - pad * 2;
        if (swW > 0 && swH > 0) {
            if (triggerPaintBox == null) { triggerPaintBox = new StyleBox(); }
            triggerPaintBox.CopyFrom(trgRef, false);
            triggerPaintBox.bg = this.CurrentRgb();
            triggerPaintBox.SetRadius(triggerPaintBox.RadiusOr(app.Scale(4)));
            triggerPaintBox.Paint(app, x + pad, y + pad, swW, swH);
        }
        return id;
    }
    public override void OnClick(RoutedEventArgs e) {
        if (defaultPopupCard != null && defaultPopupCard.ContainsInputControl(e.originalSource)) { return; }
        if (!this.IsDisabled()) {
            viewAligned = false;
            this.SetOpen(!open);
            this.RequestRedraw();
            e.Handle();
            return;
        }
        base.OnClick(e);
    }
    public override void OnPopupDismissed() { open = false; }
    public bool IsOpen() { return open; }
    public Card defaultPopupCard;
    public ColorPalettePanel palettePanel;
    public Card EnsurePopupCard() { return this.EnsurePopupCard(this.App); }
    public Card EnsurePopupCard(App app) {
        app = this.ResolveApp(app);
        if (defaultPopupCard == null) {
            defaultPopupCard = new Card("");
            defaultPopupCard.Class = "colorpicker-popup";
            defaultPopupCard.Pad(0);
            palettePanel = new ColorPalettePanel(this);
            defaultPopupCard.With(palettePanel);
        }
        if (app != null) {
            defaultPopupCard.UseApp(app);
            palettePanel.OnMeasure(app);
            defaultPopupCard.prefW = palettePanel.prefW;
            defaultPopupCard.prefH = palettePanel.prefH;
        }
        return defaultPopupCard;
    }
    private bool preparingPopup;
    private void PreparePopup(App app) {
        if (preparingPopup || !this.CanPrepareInputState(app)) { return; }
        preparingPopup = true;
        try {
            if (this.IsDisabled()) { open = false; }
            if (!open) {
                if (OverlayHost.IsActiveAnchor(app, this)) { OverlayHost.DismissPopupFor(app); }
                return;
            }
            if (bw <= 0 || bh <= 0 || OverlayHost.IsActiveAnchor(app, this)) { return; }
            Control pop = customPopup != null ? customPopup : this.EnsurePopupCard(app);
            OverlayHost.ShowPopup(app, this, pop);
        } finally { preparingPopup = false; }
    }
    public void SetOpen(bool want) {
        if (want && this.IsDisabled()) {
            if (!open) { return; }
            want = false;
        }
        if (open != want) { viewAligned = false; }
        open = want;
        this.PreparePopup(this.FindApp());
    }
    public override void Arrange(int x, int y, int w, int h) {
        App owner = this.FindApp();
        Control ownerParent = parent;
        Control root = owner != null ? owner.rootControl : null;
        int generation = this.InputRootRevision(owner);
        long sequence = owner != null ? owner.window.EventSeq() : 0;
        base.Arrange(x, y, w, h);
        if (owner == null || this.FindApp() != owner || parent != ownerParent
                || owner.rootControl != root || this.InputRootRevision(owner) != generation
                || owner.window.EventSeq() != sequence) { return; }
        this.PreparePopup(owner);
    }
    public override bool MountSlot(string slot, Control c) {
        if (slot == "popup" || slot == "dropdown" || slot == "content") {
            this.SetPopupContent(c);
            return true;
        }
        return base.MountSlot(slot, c);
    }
    public void SetPopupContent(Control c) {
        this.customPopup = c;
        if (c != null && this.IndexOf(c) < 0) { this.Add(c); }
    }
    public Control GetPopupContent() { return this.customPopup; }
    public static int ViewOf(string m) {
        if (m == "hex") { return 1; }
        if (m == "hsl") { return 2; }
        if (m == "hsb") { return 3; }
        return 0;
    }
    public static string ViewLabel(int view) {
        if (view == 1) { return "HEX"; }
        if (view == 2) { return "HSL"; }
        if (view == 3) { return "HSB"; }
        return "RGBA";
    }
    public static int NextAllowedView(int start, List<string> modes) {
        int from = start % 4;
        if (from < 0) { from = from + 4; }
        if (modes == null || modes.Count == 0) { return from; }
        for (int k = 0; k < 4; k = k + 1) {
            int cand = (from + k) % 4;
            for (int i = 0; i < modes.Count; i = i + 1) {
                if (ColorPicker.ViewOf(modes[i].ToLower()) == cand) { return cand; }
            }
        }
        return from;
    }
    public static bool Allowed(int view, List<string> modes) {
        if (modes == null || modes.Count == 0) { return true; }
        for (int i = 0; i < modes.Count; i = i + 1) {
            if (ColorPicker.ViewOf(modes[i].ToLower()) == view) { return true; }
        }
        return false;
    }
    public bool viewAligned;
    private static void OnChannelSubmit(Control sender) {
        if (sender == null || sender.parent == null) { return; }
        ColorPalettePanel panel = sender.parent as ColorPalettePanel;
        ColorPicker cp = panel != null ? panel.picker : null;
        if (cp != null) {
            int which = Convert.ToInt32(sender.name);
            cp.SubmitChannel(which);
        }
    }
    private void SubmitChannel(int which) {
        if (this.IsDisabled()) { return; }
        if (which == 3 && !showAlpha) { return; }
        bool ok = false;
        if (which <= 2) {
            string t = which == 0 ? inR.GetText()
                     : which == 1 ? inG.GetText() : inB.GetText();
            int v = ColorPicker.ParseIntSafe(t);
            if (v >= 0) {
                if (v > 255) { v = 255; }
                int rgb = ColorPicker.RgbOf(this.CurrentRgb());
                int r = (rgb / 65536) % 256;
                int g = (rgb / 256) % 256;
                int b = rgb % 256;
                if (which == 0) { r = v; }
                else if (which == 1) { g = v; }
                else { b = v; }
                this.ApplyPacked(ColorMath.WithAlpha(
                    ColorPicker.Opaque(r, g, b), alpha));
                ok = true;
            }
        } else if (which == 3) {
            int v = ColorPicker.ParseIntSafe(inA.GetText());
            if (v >= 0) {
                if (v > 100) { v = 100; }
                alpha = v * 255 / 100;
                ok = true;
            }
        } else if (which == 4) {
            ColorParseResult res = ColorPicker.HexParse(inHex.GetText());
            if (res.ok) {
                this.ApplyPacked(res.packed);
                ok = true;
            }
        } else if (which == 5) {
            ColorParseResult res = ColorPicker.FuncParse(
                "hsl(" + inHsl.GetText() + ")");
            if (res.ok) {
                this.ApplyPacked(res.packed);
                ok = true;
            }
        } else {
            ColorParseResult res = ColorPicker.FuncParse(
                "hsb(" + inHsb.GetText() + ")");
            if (res.ok) {
                this.ApplyPacked(res.packed);
                ok = true;
            }
        }
        if (ok) { this.Commit(); }
    }
    public void ArrangeInputsFromOverlay(App app, int x, int y, int w, int h) {
        if (inA != null) {
            bool curDis = inA.Disabled != null && inA.Disabled.Get();
            if (curDis != !showAlpha) { inA.Disabled = !showAlpha; }
        }
        if (inputView == 0) {
            int gap = app.Scale(4);
            if (showAlpha) {
                int each = (w - gap * 3) / 4;
                this.LayInput(app, inR, x, y, each, h);
                this.LayInput(app, inG, x + each + gap, y, each, h);
                this.LayInput(app, inB, x + (each + gap) * 2, y, each, h);
                this.LayInput(app, inA, x + (each + gap) * 3, y,
                              w - (each + gap) * 3, h);
            } else {
                int each = (w - gap * 2) / 3;
                this.LayInput(app, inR, x, y, each, h);
                this.LayInput(app, inG, x + each + gap, y, each, h);
                this.LayInput(app, inB, x + (each + gap) * 2, y,
                              w - (each + gap) * 2, h);
            }
        } else if (inputView == 1) {
            this.LayInput(app, inHex, x, y, w, h);
        } else if (inputView == 2) {
            this.LayInput(app, inHsl, x, y, w, h);
        } else {
            this.LayInput(app, inHsb, x, y, w, h);
        }
    }
    public void SyncInputsFromOverlay(App app) {
        int rgb = ColorPicker.RgbOf(this.CurrentRgb());
        if (inputView == 0) {
            this.SyncInput(app, inR, Convert.ToString((rgb / 65536) % 256));
            this.SyncInput(app, inG, Convert.ToString((rgb / 256) % 256));
            this.SyncInput(app, inB, Convert.ToString(rgb % 256));
            if (showAlpha) {
                this.SyncInput(app, inA, Convert.ToString(alpha * 100 / 255));
            }
        } else if (inputView == 1) {
            string hex = showAlpha ? ColorPicker.HexTextAlpha(this.CurrentRgb())
                                   : ColorPicker.HexText(this.CurrentRgb());
            this.SyncInput(app, inHex, hex);
        } else if (inputView == 2) {
            int packed = ColorPicker.RgbHsl((rgb / 65536) % 256,
                                            (rgb / 256) % 256, rgb % 256);
            string txt = Convert.ToString(packed / 1000000) + ", "
                + Convert.ToString((packed / 1000) % 1000 / 10) + "%, "
                + Convert.ToString(packed % 1000 / 10) + "%";
            this.SyncInput(app, inHsl, txt);
        } else {
            string txt2 = Convert.ToString(hue) + ", "
                + Convert.ToString(sat / 10) + "%, "
                + Convert.ToString(val / 10) + "%";
            this.SyncInput(app, inHsb, txt2);
        }
    }
    private void LayInput(App app, Input inp, int x, int y, int w, int h) { inp.Arrange(x, y, w, h); }
    private void SyncInput(App app, Input inp, string text) {
        if (app.focus.IsFocused(inp.WidgetId())) { return; }
        if (inp.GetText() == text) { return; }
        inp.SetText(text);
    }
    public override void OnMeasure(App app) {
        StyleBox s = this.ResolveStyleCached(app, "colorpicker", Class,
                                             Style.SNormal());
        prefH = s.HeightOr(app.theme.heightMedium);
        prefW = s.WidthOr(app.Scale(160));
    }
    public override int InputFocusCapabilities() { return 1; }
    public override void OnPaint(App app) { this.PaintTrigger(app, bx, by, bw, bh); }
}
