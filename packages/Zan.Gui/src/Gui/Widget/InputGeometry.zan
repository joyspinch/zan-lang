using System;
using Gui;

namespace Gui.Widget;

// Paint and routed input derive every slot from the same current style and text.
public struct InputGeometry {
    public int x;
    public int y;
    public int width;
    public int height;
    public int innerX;
    public int innerWidth;
    public int scrollX;
    public int textY;
    public int font;
    public int glyph;
    public int iconX;
    public int suffixX;
    public int countX;
    public int padRight;
    public int caretWidth;
    public bool hasTrail;
    public bool showClear;
    public string display;

    public static InputGeometry Build(App app, int x, int y, int width, int height,
            int font, int padLeft, int padRight, int gap, bool prefixIcon,
            int prefixWidth, int suffixWidth, int countWidth, bool trailArea,
            bool showClear, string display, int cursor) {
        InputGeometry g = new InputGeometry();
        g.x = x;
        g.y = y;
        g.width = width;
        g.height = height;
        g.font = font;
        g.glyph = font;
        g.padRight = padRight;
        g.showClear = showClear;
        g.display = display;
        int lead = 0;
        if (prefixIcon) { lead = lead + font + gap; }
        if (prefixWidth > 0) { lead = lead + prefixWidth + gap; }
        int right = x + width - padRight;
        if (trailArea) {
            g.iconX = right - font;
            right = g.iconX - gap;
        }
        if (suffixWidth > 0) {
            g.suffixX = right - suffixWidth;
            right = g.suffixX - gap;
        }
        if (countWidth > 0) {
            g.countX = right - countWidth;
            right = g.countX - gap;
        }
        int trailSlot = x + width - padRight - right;
        if (trailSlot < 0) { trailSlot = 0; }
        g.innerX = x + padLeft + lead;
        g.innerWidth = width - padLeft - padRight - lead - trailSlot;
        if (g.innerWidth < 0) { g.innerWidth = 0; }
        g.textY = Canvas.CenterTextY(y, height, font);
        if (cursor < 0) { cursor = 0; }
        if (cursor > display.Length) { cursor = display.Length; }
        if (display != "") { g.caretWidth = Canvas.MeasureText(Text.Left(display, cursor), font); }
        if (g.caretWidth > g.innerWidth) { g.scrollX = g.caretWidth - g.innerWidth; }
        g.hasTrail = trailArea;
        return g;
    }

    // Password masks preserve byte offsets; never return a UTF-8 continuation
    // byte as an editing boundary when a click lands inside one masked codepoint.
    public int CursorAt(int px, string text) {
        int cursor = this.CursorAt(px);
        if (cursor > text.Length) { cursor = text.Length; }
        while (cursor > 0 && cursor < text.Length && (text[cursor] & 192) == 128) {
            cursor = cursor - 1;
        }
        return cursor;
    }

    public int CursorAt(int px) {
        return Gui.TextWrap.ColFromX(this.display, px - this.innerX + this.scrollX, this.font);
    }

    public bool OnTrail(int px, int py) {
        return this.hasTrail && px >= this.x && px < this.x + this.width
            && px >= this.iconX && px < this.iconX + this.glyph + this.padRight
            && py >= this.y && py < this.y + this.height;
    }
}
