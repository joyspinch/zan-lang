using System;
using Gui;
namespace Gui.Widget;
public class View : Control {
    public override Control CreateCloneShell() { return new View(); }
    public View() {
        this.InitControl("view");
        styleSurfaceOwned = true;
    }
    public View(string name) {
        this.InitControl(name);
        styleSurfaceOwned = true;
    }
    public override int StyleDisplay() {
        if (computedStyle != null && computedStyle.display != 0) {
            return computedStyle.display;
        }
        return 1;
    }
    public override string Kind() { return "View"; }
    public override string StyleType() { return "view"; }
}
