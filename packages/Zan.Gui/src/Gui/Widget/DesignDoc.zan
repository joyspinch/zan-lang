using System;
using System.IO;
using System.Json;
using Gui.Markup;

namespace Gui.Widget;

// 窗口设计稿装载助手（运行期投影通道的入口，B-ID46 形态）：
// 程序入口读设计稿（--embed 烘入的内嵌副本优先，散盘相对路径回退——
// 发布态走内嵌，开发态直接读 src/ 下的文件），经 DesignerHtml.ToJsonDoc
// 转成投影文档交给 FormBuilder.BuildWith。找不到时返回 null，报错方式
// 由调用方决定（窗口程序通常 Console 一行后退出）。
public static class DesignDoc {
    // 装载并解析设计稿。rel 是工程根相对路径（如 "src/App.html"）；
    // 内嵌 VFS 对 File.Exists/ReadAllText 透明，无需特判发布态。
    public static JsonValue Load(string rel) {
        string html = ReadFile(rel);
        if (html == null) { return null; }
        return JsonValue.ParseLenient(DesignerHtml.ToJsonDoc(html));
    }

    // 读设计稿原文（不经解析）——交给 App.LoadHtmlWith 这类自接原文的
    // 装载口时用；找不到（含裸文件名回退）返回 null。
    public static string ReadFile(string rel) {
        string html = ReadText(rel);
        if (html != null) { return html; }
        // 以 build/<名>.exe 直接启动时工作目录不是工程根：退回裸文件名。
        string bare = rel;
        int slash = bare.LastIndexOf("/");
        if (slash >= 0) {
            bare = bare.Substring(slash + 1, bare.Length - slash - 1);
        }
        html = ReadText(bare);
        if (html != null) { return html; }
        // 约定优于配置：在工程 src 目录树中自动递归发现同名设计稿
        string hit = FindInTree("src", bare);
        if (hit != null) { return hit; }
        hit = FindInTree("../src", bare);
        if (hit != null) { return hit; }
        return FindInTree(".build/src", bare);
    }

    static string FindInTree(string dir, string target) {
        try {
            if (!Directory.Exists(dir)) { return null; }
            List<string> files = Directory.GetFiles(dir);
            if (files != null) {
                for (int i = 0; i < files.Count; i = i + 1) {
                    string f = files[i];
                    string name = Path.GetFileName(f);
                    if (name == target) {
                        return ReadText(f);
                    }
                }
            }
            List<string> subdirs = Directory.GetDirectories(dir);
            if (subdirs != null) {
                for (int i = 0; i < subdirs.Count; i = i + 1) {
                    string hit = FindInTree(subdirs[i], target);
                    if (hit != null) { return hit; }
                }
            }
        } catch (Exception) {
            return null;
        }
        return null;
    }

    static string ReadText(string rel) {
        try {
            if (File.Exists(rel)) { return File.ReadAllText(rel); }
        } catch (Exception) {
            return null;
        }
        return null;
    }
}
