namespace Gui;

public class ThemeSettings {
    public static void Enable(App app) {
        if (app == null) { return; }
        app.SetThemeSettingsAction((App host) => host.ThemeMenu.Toggle(0));
    }
    public static void Show(App app) {
        if (app == null) { return; }
        ThemeSettings.Enable(app);
        app.ThemeMenu.Show();
    }
}

internal class ThemeDrawerRelay : AppLoopParticipant, AppPreparationParticipant, AppLoopStopped {
    internal weak App owner;
    internal weak ThemeDrawer drawer;
    internal string command;
    internal int value;
    internal int session;
    internal weak UiEvent actionEvent;
    public void Invoke() {
        App app = owner;
        ThemeDrawer view = drawer;
        if (app != null && view != null && app.isRunning && view.IsSession(session)) {
            if (command == "close") { app.ThemeMenu.Close(view); }
            else { app.ThemeMenu.ChangeSetting(view, command, value); }
        }
    }
    public void Closed() {
        App app = owner;
        ThemeDrawer view = drawer;
        if (app != null && view != null) { app.ThemeMenu.Close(view); }
    }
    public void Tick(App app, int now) { }
    public int NextDeadline() { return -1; }
    public void BeforeInput(App app, int kind) { this.Prepare(app); }
    public void BeforePaint(App app, int frameSequence) { this.Prepare(app); }
    private void Prepare(App app) {
        ThemeDrawer view = drawer;
        if (app == owner && view != null) { view.Prepare(app); }
    }
    public void Stopped(App app) {
        ThemeDrawer view = drawer;
        if (app == owner && view != null) { app.ThemeMenu.Retire(view); }
    }
}

// App 的主题设置抽屉入口（partial class App 放在 Widget 层，避免 Core 向上依赖 ThemeDrawer / ThemeMenuService）。
public partial class App {
    internal object themeDrawer;
    internal Control themeDrawerSurface;
    private ThemeMenuService themeMenuService;

    public ThemeMenuService ThemeMenu {
        get {
            if (themeMenuService == null) { themeMenuService = new ThemeMenuService(this); }
            return themeMenuService;
        }
    }

    public void ToggleThemeMenu(int triggerId) {
        this.ThemeMenu.Toggle(triggerId);
    }

    public void ShowThemeDrawer() {
        this.ThemeMenu.Show();
    }

    internal void CloseThemeDrawer(ThemeDrawer view) {
        this.ThemeMenu.Close(view);
    }

    internal void RetireThemeDrawer(ThemeDrawer view) {
        this.ThemeMenu.Retire(view);
    }

    internal int ThemeDrawerAccent(int index) {
        return this.ThemeMenu.Accent(index);
    }

    internal void ChangeThemeDrawerSetting(ThemeDrawer view, string command, int value) {
        this.ThemeMenu.ChangeSetting(view, command, value);
    }
}
