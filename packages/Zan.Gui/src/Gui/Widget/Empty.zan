using System;
using Gui;

namespace Gui.Widget;

// 空状态占位：大图形加一行说明。两者都通过 CSS
// 部件设置样式，`empty::icon` 和 `empty::label` 控制其大小和
// 颜色，代码侧只需简单赋值：
// e.Icon = "search";
public class Empty : Control {
    // 可绑定标题：`e.Text = vm.emptyHint;` 每帧重新读取模型字段
    // （编译器降级的 Binding）；字面量则存为常量。
    Binding<string> Text;
    // 大图形字形名（默认 "folder"）。
    string Icon;
    string description;
    Control extraSlot;

    // 初始化：标题文本（可绑定），图形默认 "folder"。
    void InitEmpty(string msg) {
        this.InitControl(msg, 5);
        Text = msg;
        Icon = "folder";
        description = "";
        extraSlot = null;
    }

    // 空标题（设计器用）。
    Empty() { InitEmpty(""); }
    // 给定标题文本。
    Empty(string msg) { InitEmpty(msg); }

    static Empty Create(string msg) {
        return new Empty(msg);
    }

    Empty Description(string desc) {
        description = desc;
        return this;
    }

    Empty WithIcon(string icon) {
        Icon = icon;
        return this;
    }

    Empty Extra(Control extra) {
        if (extraSlot != null) { this.Remove(extraSlot); }
        extraSlot = extra;
        if (extra != null) {
            extra.dock = 0;
            this.With(extra);
        }
        return this;
    }

    Control GetExtra() {
        return extraSlot;
    }

    override void Arrange(int x, int y, int w, int h) {
        base.Arrange(x, y, w, h);
        if (extraSlot != null) {
            int ew = extraSlot.prefW > 0 ? extraSlot.prefW : 120;
            int eh = extraSlot.prefH > 0 ? extraSlot.prefH : 32;
            int ex = x + (w - ew) / 2;
            int ey = y + h / 2 + 36;
            extraSlot.Arrange(ex, ey, ew, eh);
        }
    }

    // 当前标题（通过绑定解析）。
    string Label() {
        if (Text == null) { return ""; }
        return Text.Get();
    }

    // 覆写：首选尺寸取 `empty` 样式宽高（默认 240 x 120）。
    override void OnMeasure(App app) {
        StyleBox s = this.ResolveStyleAs(app, "empty", Class, Style.SNormal());
        prefH = s.HeightOr(app.Scale(120));
        prefW = s.WidthOr(app.Scale(240));
        if (extraSlot != null) {
            prefH = prefH + app.Scale(48);
        }
    }

    // 覆写：垂直居中画大图形与标题行（样式部件 empty::icon / ::label）。
    override void OnPaint(App app) {
        string text = this.Label();
        string icon = Icon;
        string cls = Class;

        Canvas c = app.canvas;
        Theme t = app.theme;
        StyleBox gs = Style.Part(app, "empty", "icon", "", cls, "",
                                 Style.SNormal());
        StyleBox ls = Style.Part(app, "empty", "label", "", cls, "",
                                 Style.SNormal());
        int glyph = gs.FontOr(app.Scale(40));
        int fs = ls.FontOr(Style.FontFallback(app, "medium"));
        int cy = by + bh / 2;
        if (extraSlot != null) { cy = cy - app.Scale(20); }

        c.DrawGlyphIn(icon, bx, cy - glyph, bw, glyph, glyph,
                            gs.FgOr(0));
        c.DrawTextCentered(bx, cy + t.gapMedium, bw, Canvas.FontHeight(fs),
                           text, ls.FgOr(0), fs);

        if (description != "") {
            int subFs = Style.FontFallback(app, "small");
            c.DrawTextCentered(bx, cy + t.gapMedium + Canvas.FontHeight(fs) + 4, bw, Canvas.FontHeight(subFs),
                               description, 0x888888, subFs);
        }
    }






    override bool MountSlot(string slot, Control c) {
        if (slot == "extra" || slot == "action" || slot == "actions") {
            this.Extra(c);
            return true;
        }
        return base.MountSlot(slot, c);
    }

    override Control Add(Control child) {
        if (child == null) { return null; }
        if (child.slotName != "" && this.MountSlot(child.slotName, child)) {
            return child;
        }
        this.Extra(child);
        return child;
    }

    override void SetProp(string key, string val) {
        string k = key.ToLower();
        if (k == "text" || k == "title") { this.Text.Set(val); return; }
        if (k == "description" || k == "desc") { this.Description(val); return; }
        if (k == "icon") { this.WithIcon(val); return; }
        base.SetProp(key, val);
    }

    // ---- 设计器 / 序列化模型 ----

    // 控件类型标识（序列化/设计器用）。
    override string Kind() { return "Empty"; }

    // 覆写：返回设计器属性清单（标题 / 图形 / 类）。
    override List<PropSpec> Props() {
        List<PropSpec> ps = new List<PropSpec>();
        PropSpec text = PropSpec.Text("text", "Text");
        text.str = Text;
        text.AsName();
        ps.Add(text);
        PropSpec icon = PropSpec.Text("icon", "Icon");
        icon.str = Icon;
        ps.Add(icon);
        return ps;
    }
}
