using System;
using Gui;

namespace Gui.Widget;

// 空状态占位：纯 Flex 居中纵向容器，由大图标、标题、说明与额外操作栏声明式子节点复合而成。
// 彻底物理消除手算坐标（bx, by, cy, DrawTextCentered）与手动 Arrange 覆写。
public class Empty : Control {
    public Binding<string> Text;
    public string Icon;
    public string description;
    private Control extraSlot;

    public override int StyleDisplay() { return 1; } // CSS display: flex
    public override int StyleFlexDir() { return 1; } // flex-direction: column

    private void InitEmpty(string msg) {
        this.InitControl(msg, 5);
        Text = msg;
        Icon = "folder";
        description = "";
        extraSlot = null;
        Class = "align-center justify-center gap-small";
        this.RebuildStructure();
    }

    public Empty() { InitEmpty(""); }
    public Empty(string msg) { InitEmpty(msg); }

    public Empty Description(string desc) {
        description = desc;
        this.RebuildStructure();
        return this;
    }

    public Empty WithIcon(string icon) {
        Icon = icon;
        this.RebuildStructure();
        return this;
    }

    public Empty Extra(Control extra) {
        extraSlot = extra;
        this.RebuildStructure();
        return this;
    }

    public Control GetExtra() {
        return extraSlot;
    }

    public string Label() {
        if (Text == null) { return ""; }
        return Text.Get();
    }

    public void RebuildStructure() {
        this.children.Clear();

        // 1. 大图标节点
        if (Icon != "") {
            IconView ico = new IconView(Icon, 48);
            ico.ClassName = "empty-icon";
            this.Add(ico);
        }

        // 2. 主标题
        string t = this.Label();
        if (t != "") {
            Label lbl = new Label(t);
            lbl.ClassName = "empty-title";
            this.Add(lbl);
        }

        // 3. 说明副标题
        if (description != "") {
            Label desc = new Label(description);
            desc.ClassName = "empty-desc";
            this.Add(desc);
        }

        // 4. 操作插槽
        if (extraSlot != null) {
            this.Add(extraSlot);
        }
    }

    public override bool MountSlot(string slot, Control c) {
        if (slot == "extra" || slot == "action" || slot == "actions") {
            this.Extra(c);
            return true;
        }
        return base.MountSlot(slot, c);
    }

    public override Control Add(Control child) {
        if (child == null) { return null; }
        if (child.slotName != "" && this.MountSlot(child.slotName, child)) {
            return child;
        }
        this.Extra(child);
        return child;
    }

    public override void SetProp(string key, string val) {
        string k = key.ToLower();
        if (k == "text" || k == "title") { this.Text.Set(val); this.RebuildStructure(); return; }
        if (k == "description" || k == "desc") { this.Description(val); return; }
        if (k == "icon") { this.WithIcon(val); return; }
        base.SetProp(key, val);
    }

    public override string Kind() { return "Empty"; }

    public override List<PropSpec> Props() {
        List<PropSpec> ps = new List<PropSpec>();
        PropSpec text = PropSpec.Text("text", "Text");
        text.str = Text;
        text.AsName();
        ps.Add(text);
        PropSpec icon = PropSpec.Text("icon", "Icon");
        icon.str = Icon;
        ps.Add(icon);
        PropSpec desc = PropSpec.Text("description", "Description");
        desc.str = description;
        ps.Add(desc);
        return ps;
    }
}
