using System;
using Gui;

namespace Gui.Widget;

// 标签/徽章组件。纯 Flex 弹性行容器，外观完全由 CSS 决定，支持图文与子组件互嵌。
//
// 基础用法：
//   Tag t = new Tag("运行中");
//   t.Closable = true;
//   t.Close += () => { OnClosed(); };
//
// 复合互嵌（DOM 组合）：
//   Tag custom = new Tag().With(new IconView("check")).With(new Label("已验证"));
//
// 样式类：
//   .primary .info .success .warning .error (语义角色)
//   .tiny .small .medium .large             (尺寸档位)
//   .round                                  (圆角胶囊形态)
public class Tag : Control {
    public Binding<string> Text;
    public string Icon;
    public bool Closable;
    public bool Checkable;
    public Binding<bool> Checked;
    public int wid { get { return this.WidgetId(); } set { this.commonId = value; } }
    public UiEvent Close;
    public UiEvent Change;
    public Binding<string> Size;

    public override int StyleDisplay() { return 1; } // CSS display: flex
    public override int StyleFlexDir() { return 0; } // flex-direction: row

    private void InitTag(string label) {
        this.InitControl(label, 1);
        Text = label;
        Icon = "";
        Closable = false;
        Checkable = false;
        Checked = false;
        wiresOwnEvents = false;
        Close = new UiEvent();
        Change = new UiEvent();
        Size = "medium";

        if (label != "") {
            this.Add(new Label(label));
        }
    }

    // ---- 内联标签助手（static 纯函数）--------------------------------
    // 供自行管理布局的绘制者复用（StyledText 名称条、Gallery/IDE 行内
    // 标签）：吃与真 Tag 同一套 `tag` 规则，宿主不必自持样式解析。

    // `text` 在 `cls` 样式下占据的宽度。
    public static int Width(App app, string text, string cls) {
        Theme t = app.theme;
        StyleBox s = Style.Of(app, "tag", cls, Style.SNormal());
        int fontPx = s.FontOr(Style.FontFallback(app, "small"));
        int textW = text != "" ? Canvas.MeasureText(text, fontPx) : 0;
        return textW + s.PadLOr(t.paddingSmall) + s.PadROr(t.paddingSmall);
    }

    // `cls` 样式下标签的高度。
    public static int Height(App app, string cls) {
        StyleBox s = Style.Of(app, "tag", cls, Style.SNormal());
        return s.HeightOr(app.theme.heightTiny);
    }

    // 内联标签渲染助手：绘制带样式框的标签文本。
    public static void Chip(App app, int x, int y, string text, string cls) {
        StyleBox s = Style.Of(app, "tag", cls, Style.SNormal());
        int w = Tag.Width(app, text, cls);
        int h = Tag.Height(app, cls);
        s.Paint(app, x, y, w, h);
        int fontPx = s.FontOr(Style.FontFallback(app, "small"));
        Canvas c = app.canvas;
        c.DrawTextCentered(x, y, w, h, text, s.FgOr(0), fontPx);
    }

    public Tag() { InitTag(""); }
    public Tag(string label) { InitTag(label); }

    public string Label() {
        if (Text == null) { return ""; }
        return Text.Get();
    }

    public void SetText(string v) {
        Text = v;
        if (children.Count > 0 && children[0] is Label) {
            ((Label)children[0]).Text = v;
        } else if (v != "") {
            this.Add(new Label(v));
        }
    }

    public bool IsChecked() {
        if (Checked == null) { return false; }
        return Checked.Get();
    }

    public override string Kind() { return "Tag"; }
    public override Binding<string> SizeOf() { return Size; }

    public override List<PropSpec> Props() {
        List<PropSpec> ps = new List<PropSpec>();
        PropSpec text = PropSpec.Text("text", "Text");
        text.str = Text;
        text.AsName();
        ps.Add(text);
        PropSpec icon = PropSpec.Text("icon", "Icon");
        icon.str = Icon;
        ps.Add(icon);
        PropSpec close = PropSpec.Bool("closable", "Closable");
        close.flag = Closable;
        ps.Add(close);
        PropSpec checkable = PropSpec.Bool("checkable", "Checkable");
        checkable.flag = Checkable;
        ps.Add(checkable);
        PropSpec on = PropSpec.Bool("checked", "Checked");
        on.flag = Checked;
        ps.Add(on);
        ps.Add(this.SizeProp());
        return ps;
    }

    public override List<string> Events() {
        List<string> e = Control.CommonEvents();
        e.Add("Close");
        e.Add("Change");
        return e;
    }

    public override void BindEvent(string evt, Action a) {
        if (evt == "Close") { Close.Add(a); return; }
        if (evt == "Change") { Change.Add(a); return; }
        On.AddByName(evt, a);
    }

    public override void BindEventS(string evt, ControlEvent a) {
        if (evt == "Close") { Close.AddS(a); return; }
        if (evt == "Change") { Change.AddS(a); return; }
        On.AddByNameS(evt, a);
    }

    public override void SyncBinding() {
        base.SyncBinding();
        this.ApplySizeClass();
    }

    public override void OnPaint(App app) {
        if (bw <= 0) { return; }
        int id = this.CommonId();
        app.focus.RegisterFocusable(id);

        if (Checkable && Ui.Clicked(app, id)) {
            Checked.Set(!this.IsChecked());
            Change.PostS(this);
            App a = this.FindApp();
            if (a != null && a.window != null) { a.window.Wake(); }
        }
    }
}
