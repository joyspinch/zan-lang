using System;
using Gui;
namespace Gui.Widget;
public class Tag : Control {
    public override Control CreateCloneShell() { return new Tag(); }
    public Binding<string> Text;
    public string Icon;
    private bool closable;
    public bool Closable {
        get { return closable; }
        set {
            closable = value;
            if (closeButton != null) { closeButton.SetShown(value); }
        }
    }
    public bool Checkable;
    public Binding<bool> Checked;
    public int wid { get { return this.WidgetId(); } set { this.commonId = value; } }
    [Event]
    public UiEvent Close;
    [Event]
    public UiEvent Change;
    public Binding<string> Size;
    private Button closeButton;
    private weak IconView iconView;
    private string appliedIcon = "";
    private int appliedIconSize = 0;
    private weak Label textLabel;
    public override int StyleDisplay() { return 1; } // CSS display: flex
    public override int StyleFlexDir() { return 0; } // flex-direction: row
    private void InitTag(string label) {
        this.InitControl(label);
        Text = label;
        Icon = "";
        Closable = false;
        Checkable = false;
        Checked = false;
        wiresOwnEvents = false;
        Close = new UiEvent();
        Change = new UiEvent();
        Size = "medium";
        if (label != "") {
            Label owned = new Label(label);
            textLabel = owned;
            this.Add(owned);
        }
        closeButton = new Button(new IconView("x", 12));
        closeButton.ClassName = "tag-close";
        closeButton.Tip = "Close";
        closeButton.SetShown(false);
        TagAction action = new TagAction(this);
        closeButton.Click.Add(action.Close);
        this.Add(closeButton);
    }
    public Tag() { InitTag(""); }
    public Tag(string label) { InitTag(label); }
    public override Control Add(Control child) {
        if (closeButton == null || child == closeButton) { return base.Add(child); }
        int at = this.IndexOf(closeButton);
        if (at < 0) { return base.Add(child); }
        if (child != null && child.parent == this) {
            int existing = this.IndexOf(child);
            if (existing >= 0) {
                int target = existing < at ? at - 1 : at;
                if (existing == target) { return child; }
                this.InsertAt(target, child);
                return child;
            }
        }
        this.InsertAt(at, child);
        return child;
    }
    public string Label() {
        if (Text == null) { return ""; }
        return Text.Get();
    }
    public void SetText(string v) {
        Text = v;
        if (textLabel != null && this.IndexOf(textLabel) < 0) { textLabel = null; }
        if (textLabel != null) {
            textLabel.Text = v;
        } else if (v != "") {
            Label owned = new Label(v);
            textLabel = owned;
            this.Add(owned);
        }
    }
    public void SetIcon(string icon) {
        Icon = icon != null ? icon : "";
        this.SyncIcon();
    }
    private int IconSizePx() {
        string sc = this.SizeCls();
        if (sc == "tiny") { return 10; }
        if (sc == "large") { return 14; }
        return 12;
    }
    private void SyncIcon() {
        string want = Icon != null ? Icon : "";
        int wantSz = this.IconSizePx();
        if (iconView != null && this.IndexOf(iconView) < 0) { iconView = null; }
        if (want == "") {
            if (iconView != null) {
                this.Remove(iconView);
                iconView = null;
            }
            appliedIcon = "";
            appliedIconSize = 0;
            return;
        }
        if (iconView != null && appliedIcon == want && appliedIconSize == wantSz) { return; }
        if (iconView != null) { this.Remove(iconView); }
        IconView iv = new IconView(want, wantSz);
        iv.ClassName = "tag-icon";
        this.InsertAt(0, iv);
        iconView = iv;
        appliedIcon = want;
        appliedIconSize = wantSz;
    }
    public bool IsChecked() {
        if (Checked == null) { return false; }
        return Checked.Get();
    }
    public override Binding<string> SizeOf() { return Size; }
    protected override void OnPropertyChanged(PropSpec spec) {
        this.SyncIcon();
    }
    protected override List<PropSpec> DefineProps() {
        List<PropSpec> ps = new List<PropSpec>();
        ps.Add(PropSpec.Text("text", "Text").DefaultBinding().Field("Text").Also("data").Also("value"));
        ps.Add(PropSpec.TextField("Icon"));
        ps.Add(PropSpec.BoolField("Closable"));
        ps.Add(PropSpec.BoolField("Checkable"));
        ps.Add(PropSpec.BoolField("Checked"));
        ps.Add(this.SizeProp());
        return ps;
    }

    public override void CloneContentTo(Control target, CloneTreeFn clone) {
        for (int i = 0; i < this.ChildCount(); i = i + 1) {
            Control source = this.ChildAt(i);
            if (source == closeButton) { continue; }
            Control copy = clone(source);
            if (copy == null) { continue; }
            target.Add(copy);
            if (target is Tag) {
                Tag tgt = (Tag)target;
                if (source == iconView && copy is IconView) {
                    tgt.iconView = (IconView)copy;
                    tgt.appliedIcon = appliedIcon;
                    tgt.appliedIconSize = appliedIconSize;
                }
                if (source == textLabel && copy is Label) {
                    tgt.textLabel = (Label)copy;
                }
            }
        }
    }
    public override void SyncBinding() {
        base.SyncBinding();
        this.ApplySizeClass();
        this.SyncIcon();
    }
    public override void TriggerEvent(string evt) {
        if (evt == "Close") {
            if (Closable && !this.IsDisabled()) { Close.Post(this); }
            return;
        }
        base.TriggerEvent(evt);
    }
    public override void OnClick(RoutedEventArgs e) {
        if (this.IsDisabled()) { return; }
        if (Checkable) {
            Checked.Set(!this.IsChecked());
            Change.Post(this);
            App a = this.FindApp();
            if (a != null && a.window != null) { a.window.Wake(); }
            e.Handle();
            return;
        }
        base.OnClick(e);
    }
    public override int InputFocusCapabilities() { return 1; }
    public override void OnPaint(App app) {
        if (bw <= 0) { return; }
        int id = this.CommonId();
    }
}
