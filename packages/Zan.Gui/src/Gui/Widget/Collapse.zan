using System;
using Gui;
namespace Gui.Widget;
public class Collapse : Control {
    public override Control CreateCloneShell() { return new Collapse(); }
    public Binding<int> Active;
    [Event]
    public UiEvent Change;
    public bool Accordion;
    public string ArrowPlacement = "left";
    private bool updatingItems;
    private int appliedActive = -1;
    public override int StyleDisplay() { return 1; } // CSS display: flex
    public override int StyleFlexDir() { return 1; } // flex-direction: column
    private void InitCollapse(Binding<int> active) {
        this.InitControl("collapse");
        Active = -1;
        if (active != null) { Active = active; }
        Accordion = true;
        wiresOwnEvents = true;
        Change = new UiEvent();
    }
    public Collapse() { InitCollapse(null); }
    public Collapse(Binding<int> active) { InitCollapse(active); }
    public int ActiveIndex {
        get { return Active.Get(); }
        set {
            Active.Set(value);
            this.ApplyActiveIndex(value);
        }
    }
    public List<CollapseItem> Items {
        set {
            this.RemoveAll();
            if (value != null) {
                for (int i = 0; i < value.Count; i = i + 1) {
                    this.AddItem(value[i]);
                }
            }
        }
    }
    public override void OnMeasure(App app) {
        this.SyncBinding();
        base.OnMeasure(app);
    }
    public override void OnPaint(App app) {
        this.SyncBinding();
        base.OnPaint(app);
    }
    public void AddItem(CollapseItem item) {
        if (item == null || (this.IndexOf(item) >= 0)) { return; }
        if (Active.Get() == this.ChildCount()) { item.SetExpanded(true); }
        item.SetArrowPlacement(ArrowPlacement);
        CollapseAction action = new CollapseAction(this, item);
        item.Toggle.Add(action.Toggle);
        base.Add(item);
    }
    public void OnItemToggled(CollapseItem item) {
        if (this.IsDisabled() || updatingItems || item == null) { return; }
        int idx = 0 - 1;
        for (int i = 0; i < this.ChildCount(); i = i + 1) {
            if (this.ChildAt(i) == item) { idx = i; }
        }
        if (idx < 0) { return; }
        updatingItems = true;
        try {
            if (item.IsExpanded && Accordion) {
                for (int i = 0; i < this.ChildCount(); i = i + 1) {
                    if (this.ChildAt(i) is CollapseItem && i != idx) {
                        ((CollapseItem)this.ChildAt(i)).SetExpanded(false);
                    }
                }
            }
            int value = item.IsExpanded ? idx : (0 - 1);
            Active.Set(value);
            appliedActive = value;
        } finally {
            updatingItems = false;
        }
        if (Change != null) { Change.Raise(this); }
    }
    public CollapseItem AddPanel(string title, string content) {
        CollapseItem item = new CollapseItem(title);
        item.Content = new Label(content);
        item.RebuildStructure();
        this.AddItem(item);
        return item;
    }
    public CollapseItem AddPanel(string title, Control content) {
        CollapseItem item = new CollapseItem(title);
        item.Content = content;
        item.RebuildStructure();
        this.AddItem(item);
        return item;
    }
    public override Control Add(Control child) {
        if (child is CollapseItem) {
            this.AddItem((CollapseItem)child);
            return child;
        }
        return base.Add(child);
    }
    private void ApplyActiveIndex(int idx) {
        bool wasUpdating = updatingItems;
        updatingItems = true;
        try {
            appliedActive = idx;
            for (int i = 0; i < this.ChildCount(); i = i + 1) {
                if (this.ChildAt(i) is CollapseItem) {
                    ((CollapseItem)this.ChildAt(i)).SetExpanded(i == idx);
                }
            }
        } finally {
            updatingItems = wasUpdating;
        }
    }
    public override void SyncBinding() {
        base.SyncBinding();
        this.SyncArrowPlacement();
        int cur = Active.Get();
        if (cur != appliedActive) { this.ApplyActiveIndex(cur); }
    }
    private string appliedArrowPlacement = "left";
    private void SyncArrowPlacement() {
        string next = ArrowPlacement == "right" ? "right" : "left";
        if (appliedArrowPlacement == next) { return; }
        appliedArrowPlacement = next;
        for (int i = 0; i < this.ChildCount(); i = i + 1) {
            if (this.ChildAt(i) is CollapseItem) { ((CollapseItem)this.ChildAt(i)).SetArrowPlacement(next); }
        }
    }
    public override void CloneContentTo(Control target, CloneTreeFn clone) {
        Collapse copy = (Collapse)target;
        copy.RemoveAll();
        copy.Active.Set(0 - 1);
        for (int i = 0; i < this.ChildCount(); i = i + 1) {
            Control next = clone(this.ChildAt(i));
            if (next != null) { copy.Add(next); }
        }
        copy.Active.Set(Active.Get());
        copy.SyncArrowPlacement();
    }
    // 允许同时展开多个面板（= 非手风琴）。
    public bool Expandable {
        get { return !Accordion; }
        set { Accordion = !value; }
    }

    public void SetArrowPlacement(string val) {
        if (val != "left" && val != "right") { return; }
        ArrowPlacement = val;
        this.SyncArrowPlacement();
    }

    public void SetActiveIndex(int idx) {
        Active.Set(idx);
        this.ApplyActiveIndex(idx);
    }

    // 面板标题 / 正文（逗号分隔，按序对应；多出的值追加新面板）。
    public string TitlesText() { return this.PanelsText(true); }
    public void SetTitlesText(string val) { this.SetPanelsText(true, val); }
    public string BodiesText() { return this.PanelsText(false); }
    public void SetBodiesText(string val) { this.SetPanelsText(false, val); }

    private string PanelsText(bool titles) {
        List<string> values = new List<string>();
        for (int i = 0; i < this.ChildCount(); i = i + 1) {
            if (!(this.ChildAt(i) is CollapseItem)) { continue; }
            CollapseItem item = (CollapseItem)this.ChildAt(i);
            values.Add(titles ? item.Title : (item.Content != null ? item.Content.GetProp("text") : ""));
        }
        return string.Join(",", values);
    }
    private void SetPanelsText(bool titles, string val) {
        if (val == null) { val = ""; }
        if (val == "" && this.ChildCount() == 0) { return; }
        List<string> values = val.Split(",");
        int ordinal = 0;
        for (int i = 0; i < this.ChildCount() && ordinal < values.Count; i = i + 1) {
            if (!(this.ChildAt(i) is CollapseItem)) { continue; }
            CollapseItem item = (CollapseItem)this.ChildAt(i);
            if (titles) { item.SetProp("title", values[ordinal]); }
            else { item.MountSlot("body", new Label(values[ordinal])); }
            ordinal = ordinal + 1;
        }
        while (ordinal < values.Count) {
            this.AddPanel(titles ? values[ordinal] : "", titles ? "" : values[ordinal]);
            ordinal = ordinal + 1;
        }
    }
    protected override List<PropSpec> DefineProps() {
        List<PropSpec> ps = new List<PropSpec>();
        ps.Add(PropSpec.Text("titles", "Panel titles (comma separated)").Accessor("TitlesText", "SetTitlesText"));
        ps.Add(PropSpec.Text("bodies", "Panel bodies (comma separated)").Accessor("BodiesText", "SetBodiesText"));
        PropSpec arrow = PropSpec.Enum("arrowPlacement", "Arrow placement", new List<string>());
        arrow.Option("left"); arrow.Option("right");
        ps.Add(arrow.Field("ArrowPlacement").Setter("SetArrowPlacement"));
        ps.Add(PropSpec.Bool("expandable", "Allow multiple panels open").Field("Expandable"));
        ps.Add(PropSpec.Int("active", "Active").DefaultBinding().Field("Active").Setter("SetActiveIndex").Also("data").Also("value"));
        ps.Add(PropSpec.BoolField("Accordion"));
        return ps;
    }
}
