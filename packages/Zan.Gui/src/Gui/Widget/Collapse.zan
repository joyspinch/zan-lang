using System;
using Gui;

namespace Gui.Widget;

// 折叠面板（手风琴）：纯 Flex 纵向容器，由 CollapseItem 声明式子节点构成。
// 彻底物理消除手算高度、Canvas.DrawText、Canvas.FillRect 与逐帧手动 Arrange。
public class Collapse : Control {
    public SignalInt open;
    public Binding<int> Active;
    public UiEvent Change;
    public bool Accordion;

    public override int StyleDisplay() { return 1; } // CSS display: flex
    public override int StyleFlexDir() { return 1; } // flex-direction: column

    private void InitCollapse(SignalInt m) {
        this.InitControl("collapse", 1);
        open = m != null ? m : new SignalInt(0 - 1);
        Accordion = true;
        wiresOwnEvents = true;
        Change = new UiEvent();
    }

    public Collapse() { InitCollapse(null); }
    public Collapse(SignalInt m) { InitCollapse(m); }

    public void AddItem(CollapseItem item) {
        if (item == null) { return; }
        int idx = this.children.Count;
        item.Toggle.Add(() => {
            if (item.IsExpanded && Accordion) {
                // 手风琴模式：收起其他项
                for (int i = 0; i < this.children.Count; i = i + 1) {
                    if (this.children[i] is CollapseItem && i != idx) {
                        ((CollapseItem)this.children[i]).SetExpanded(false);
                    }
                }
            }
            if (open != null) {
                open.Set(item.IsExpanded ? idx : (0 - 1));
            }
            if (Active != null) {
                Active.Set(item.IsExpanded ? idx : (0 - 1));
            }
            if (Change != null) { Change.RaiseS(this); }
        });
        this.Add(item);
    }

    public override Control Add(Control child) {
        if (child is CollapseItem) {
            this.AddItem((CollapseItem)child);
            return child;
        }
        return base.Add(child);
    }

    public override void SyncBinding() {
        base.SyncBinding();
        if (Active == null) { return; }
        int cur = Active.Get();
        if (cur != open.Get()) {
            open.Set(cur);
            for (int i = 0; i < this.children.Count; i = i + 1) {
                if (this.children[i] is CollapseItem) {
                    ((CollapseItem)this.children[i]).SetExpanded(i == cur);
                }
            }
        }
    }

    public override string Kind() { return "Collapse"; }

    public override List<string> Events() {
        List<string> e = Control.CommonEvents();
        e.Add("Change");
        return e;
    }

    public override void BindEvent(string evt, Action a) {
        if (evt == "Change") { Change.Add(a); return; }
        base.BindEvent(evt, a);
    }

    public override void BindEventS(string evt, ControlEvent a) {
        if (evt == "Change") { Change.AddS(a); return; }
        base.BindEventS(evt, a);
    }
}
