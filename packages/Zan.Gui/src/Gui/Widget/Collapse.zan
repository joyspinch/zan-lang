using System;
using Gui;

namespace Gui.Widget;

// 折叠面板（手风琴）：纯 Flex 纵向容器，由 CollapseItem 声明式子节点构成。
// 彻底物理消除手算高度、Canvas.DrawText、Canvas.FillRect 与逐帧手动 Arrange。
public class Collapse : Control {
    public SignalInt open;
    public Binding<int> Active;
    public Binding<int> data { get { return Active; } set { Active = value; } }
    public UiEvent Change;
    public bool Accordion;
    private bool updatingItems;

    public override int StyleDisplay() { return 1; } // CSS display: flex
    public override int StyleFlexDir() { return 1; } // flex-direction: column

    private void InitCollapse(SignalInt m) {
        this.InitControl("collapse", 1);
        open = m != null ? m : new SignalInt(0 - 1);
        Accordion = true;
        wiresOwnEvents = true;
        Change = new UiEvent();
    }

    public Collapse() { InitCollapse(null); }
    public Collapse(SignalInt m) { InitCollapse(m); }

    public void AddItem(CollapseItem item) {
        if (item == null || this.children.Contains(item)) { return; }
        if (open != null && open.Get() == this.children.Count) {
            item.SetExpanded(true);
        }
        CollapseAction action = new CollapseAction(this, item);
        item.Toggle.Add(action.Toggle);
        base.Add(item);
    }

    // 子项事件经弱引用 action 转发，手风琴收起的联动只发一次 Change。
    public void OnItemToggled(CollapseItem item) {
        if (updatingItems || item == null) { return; }
        int idx = 0 - 1;
        for (int i = 0; i < this.children.Count; i = i + 1) {
            if (this.children[i] == item) { idx = i; }
        }
        if (idx < 0) { return; }
        updatingItems = true;
        try {
            if (item.IsExpanded && Accordion) {
                for (int i = 0; i < this.children.Count; i = i + 1) {
                    if (this.children[i] is CollapseItem && i != idx) {
                        ((CollapseItem)this.children[i]).SetExpanded(false);
                    }
                }
            }
            int value = item.IsExpanded ? idx : (0 - 1);
            if (open != null) { open.Set(value); }
            if (Active != null) { Active.Set(value); }
        } finally {
            updatingItems = false;
        }
        if (Change != null) { Change.RaiseS(this); }
    }

    public CollapseItem AddPanel(string title, string content) {
        CollapseItem item = new CollapseItem(title);
        item.Content = new Label(content);
        item.RebuildStructure();
        this.AddItem(item);
        return item;
    }

    public CollapseItem AddPanel(string title, Control content) {
        CollapseItem item = new CollapseItem(title);
        item.Content = content;
        item.RebuildStructure();
        this.AddItem(item);
        return item;
    }

    public override Control Add(Control child) {
        if (child is CollapseItem) {
            this.AddItem((CollapseItem)child);
            return child;
        }
        return base.Add(child);
    }

    // 模型/属性回填共用静默路径，不把子项 Toggle 反写成用户 Change。
    private void ApplyActiveIndex(int idx) {
        bool wasUpdating = updatingItems;
        updatingItems = true;
        try {
            open.Set(idx);
            for (int i = 0; i < this.children.Count; i = i + 1) {
                if (this.children[i] is CollapseItem) {
                    ((CollapseItem)this.children[i]).SetExpanded(i == idx);
                }
            }
        } finally {
            updatingItems = wasUpdating;
        }
    }

    public override void SyncBinding() {
        base.SyncBinding();
        if (Active == null) { return; }
        int cur = Active.Get();
        if (cur != open.Get()) { this.ApplyActiveIndex(cur); }
    }

    public override string Kind() { return "Collapse"; }

    public override List<string> Events() {
        List<string> e = Control.CommonEvents();
        e.Add("Change");
        return e;
    }

    public override void BindEvent(string evt, Action a) {
        if (evt == "Change") { Change.Add(a); return; }
        base.BindEvent(evt, a);
    }

    public override void BindEventS(string evt, ControlEvent a) {
        if (evt == "Change") { Change.AddS(a); return; }
        base.BindEventS(evt, a);
    }

    public override List<PropSpec> Props() {
        List<PropSpec> ps = new List<PropSpec>();
        PropSpec act = PropSpec.Int("active", "Active");
        act.num = Active;
        act.Also("data");
        act.Also("value");
        ps.Add(act);
        PropSpec acc = PropSpec.Bool("accordion", "Accordion");
        acc.flag = Accordion;
        ps.Add(acc);
        return ps;
    }

    public override string GetProp(string key) {
        if (key == "active" || key == "data" || key == "value") {
            return Convert.ToString(Active != null ? Active.Get() : open.Get());
        }
        return base.GetProp(key);
    }

    public override void SetProp(string key, string val) {
        if (key == "active" || key == "data" || key == "value") {
            int idx = Convert.ToInt32(val);
            if (Active != null) { Active.Set(idx); }
            this.ApplyActiveIndex(idx);
            return;
        }
        base.SetProp(key, val);
    }
}
