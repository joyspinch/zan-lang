using System;
using Gui;
namespace Gui.Widget;
[GuiKind("Flex")]
public class Flex : Control {
    public override Control CreateCloneShell() { return new Flex(); }
    public static string DirGroup() { return "row column"; }
    public static string WrapGroup() { return "wrap nowrap"; }
    public static string JustifyGroup() {
        return "justify-start justify-center justify-end "
            + "justify-between justify-around";
    }
    public static string ContentGroup() {
        return "content-start content-center content-end "
            + "content-between content-around content-stretch";
    }
    public static string AlignGroup() { return "align-stretch align-start align-center align-end"; }
    public static string GapGroup() { return "gap-none gap-small gap-medium gap-large"; }
    private void InitFlex(string dirCls) {
        this.InitControl("flex");
        this.AddClass(dirCls);
    }
    public Flex() { InitFlex("row"); }
    public static Flex Row() { return new Flex(); }
    public static Flex Column() {
        Flex f = new Flex();
        f.SetClassIn(Flex.DirGroup(), "column");
        return f;
    }
    // 横向 + 自动换行（等价于 n-space 的默认行为）。
    public static Flex Wrapped() { return Flex.Row().Wrap(); }

    // 皮肤样式类型键："flex"。
    public override string StyleType() { return "flex"; }
    public int Gap {
        get { return this.gap; }
        set { this.gap = value; }
    }
    public string AlignItems {
        get { return this.GetProp("align"); }
        set { this.Align(value); }
    }
    public string JustifyContent {
        get { return this.GetProp("justify"); }
        set { this.Justify(value); }
    }
    public string Direction {
        get { return this.GetProp("direction"); }
        set { this.SetProp("direction", value); }
    }
    public bool IsWrapped {
        get { return Style.Has(Class, "wrap"); }
        set { if (value) { this.Wrap(); } else { this.NoWrap(); } }
    }
    public Flex Vertical() { this.SetClassIn(Flex.DirGroup(), "column"); return this; }
    public Flex Horizontal() { this.SetClassIn(Flex.DirGroup(), "row"); return this; }
    public Flex Wrap() { this.SetClassIn(Flex.WrapGroup(), "wrap"); return this; }
    public Flex NoWrap() { this.SetClassIn(Flex.WrapGroup(), "nowrap"); return this; }
    public Flex Justify(string mode) {
        string cls = "justify-start";
        if (mode == "center") { cls = "justify-center"; }
        else if (mode == "end" || mode == "right") { cls = "justify-end"; }
        else if (mode == "between" || mode == "space-between") {
            cls = "justify-between";
        } else if (mode == "around" || mode == "space-around"
                   || mode == "evenly") {
            cls = "justify-around";
        }
        this.SetClassIn(Flex.JustifyGroup(), cls);
        return this;
    }
    public Flex Center() { return this.Justify("center"); }
    public Flex End() { return this.Justify("end"); }
    public Flex Between() { return this.Justify("between"); }
    public Flex Align(string mode) {
        string cls = "align-stretch";
        if (mode == "start" || mode == "top") { cls = "align-start"; }
        else if (mode == "center" || mode == "middle") { cls = "align-center"; }
        else if (mode == "end" || mode == "bottom") { cls = "align-end"; }
        this.SetClassIn(Flex.AlignGroup(), cls);
        return this;
    }
    public Flex AlignCenter() { return this.Align("center"); }
    public Flex AlignStart() { return this.Align("start"); }
    public Flex AlignEnd() { return this.Align("end"); }
    public Flex Content(string mode) {
        string cls = "content-start";
        if (mode == "center" || mode == "middle") { cls = "content-center"; }
        else if (mode == "end" || mode == "bottom") { cls = "content-end"; }
        else if (mode == "between" || mode == "space-between") {
            cls = "content-between";
        } else if (mode == "around" || mode == "space-around") {
            cls = "content-around";
        } else if (mode == "stretch") { cls = "content-stretch"; }
        this.SetClassIn(Flex.ContentGroup(), cls);
        return this;
    }
    public void Size(string size) {
        string cls = "gap-medium";
        if (size == "none" || size == "0") { cls = "gap-none"; }
        else if (size == "tiny" || size == "small") { cls = "gap-small"; }
        else if (size == "large") { cls = "gap-large"; }
        this.SetClassIn(Flex.GapGroup(), cls);
    }
    // ---- 设计器 / 多态属性协议 -------------------------------------------
    // 布局属性的文本形式：值即样式类的反读（column/wrap/justify-*/align-*/gap-*）。
    public string DirectionText() { return Style.Has(Class, "column") ? "column" : "row"; }
    public void SetDirectionText(string val) {
        if (val == "column" || val == "vertical") { this.Vertical(); } else { this.Horizontal(); }
    }

    public string WrapText() { return Style.Has(Class, "wrap") ? "true" : "false"; }
    public void SetWrapText(string val) {
        if (val == "true" || val == "1" || val == "wrap") { this.Wrap(); } else { this.NoWrap(); }
    }

    public string JustifyText() {
        if (Style.Has(Class, "justify-center")) { return "center"; }
        if (Style.Has(Class, "justify-end")) { return "end"; }
        if (Style.Has(Class, "justify-between")) { return "between"; }
        if (Style.Has(Class, "justify-around")) { return "around"; }
        return "start";
    }
    public void SetJustifyText(string val) { this.Justify(val); }

    public string AlignText() {
        if (Style.Has(Class, "align-start")) { return "start"; }
        if (Style.Has(Class, "align-center")) { return "center"; }
        if (Style.Has(Class, "align-end")) { return "end"; }
        return "stretch";
    }
    public void SetAlignText(string val) { this.Align(val); }

    public string GapText() {
        if (Style.Has(Class, "gap-none")) { return "none"; }
        if (Style.Has(Class, "gap-small")) { return "small"; }
        if (Style.Has(Class, "gap-large")) { return "large"; }
        return "medium";
    }
    public void SetGapText(string val) { this.Size(val); }

    protected override List<PropSpec> DefineProps() {
        List<PropSpec> ps = new List<PropSpec>();
        ps.Add(PropSpec.Text("direction", "Direction").Accessor("DirectionText", "SetDirectionText"));
        ps.Add(PropSpec.Bool("wrap", "Wrap").Accessor("WrapText", "SetWrapText"));
        ps.Add(PropSpec.Text("justify", "Justify").Accessor("JustifyText", "SetJustifyText"));
        ps.Add(PropSpec.Text("align", "Align").Accessor("AlignText", "SetAlignText"));
        ps.Add(PropSpec.Text("size", "Size").Accessor("GapText", "SetGapText"));
        return ps;
    }
}
