using System;
using System.Collections.Generic;
using Gui;

namespace Gui.Widget;

// SelectBox.Cascader.zan - 级联多列选择、树形选择浮层与层级勾选算法分片
public partial class SelectBox {
    // 设第 col 列滚动偏移（列表按需扩容）。
    public void SetColScroll(int col, int v) {
        if (this.cascadeCols == null) { this.cascadeCols = new List<CascadeColumnScroll>(); }
        while (this.cascadeCols.Count <= col) { this.cascadeCols.Add(new CascadeColumnScroll(0, null)); }
        this.cascadeCols[col].offset = v;
        if (this.cascadeCols[col].signal != null) { this.cascadeCols[col].signal.Set(v); }
    }

    // 第 `col` 列的滚动偏移（像素），按内容高度钳制。
    public int ColScroll(int col, int contentH, int viewH) {
        if (this.cascadeCols == null) { this.cascadeCols = new List<CascadeColumnScroll>(); }
        while (this.cascadeCols.Count <= col) { this.cascadeCols.Add(new CascadeColumnScroll(0, null)); }
        int maxOff = contentH - viewH;
        if (maxOff < 0) { maxOff = 0; }
        int v = this.cascadeCols[col].offset;
        if (v > maxOff) { v = maxOff; }
        if (v < 0) { v = 0; }
        this.cascadeCols[col].offset = v;
        return v;
    }

    // 展开链是否与当前 cascadePath 相同（避免悬停展开反复触发重绘）。
    public bool SameCascadePath(List<int> a) {
        if (this.cascadePath == null) { return a.Count == 0; }
        if (a.Count != this.cascadePath.Count) { return false; }
        for (int i = 0; i < a.Count; i = i + 1) {
            if (a[i] != this.cascadePath[i]) { return false; }
        }
        return true;
    }

    // 级联选中一个节点（平铺下标）：写入触发器（showPath 决定完整
    // 路径还是末级短标签）、同步绑定并关闭。联动开启时只有叶子能
    // 走到这里；关闭时带子级的分支也可以直接选中。
    public void ChooseCascade(int idx) {
        if (idx < 0 || idx >= opts.Count) { return; }
        pathText = this.ValueText(idx);
        selected = idx;
        if (model != null) { model.Set(selected); lastModel = selected; }
        if (data != null) { data.Set(selected); lastData = selected; }
        Change.RaiseS(this);
        this.SetOpen(false);
    }

    // 第 `idx` 个选项的完整路径文本（"浙江省 / 杭州市 / 西湖区"）。
    public string PathOf(int idx) {
        if (idx < 0 || idx >= opts.Count) { return ""; }
        List<int> chain = new List<int>();
        int cur = idx;
        while (cur >= 0 && cur < opts.Count) {
            chain.Insert(0, cur);
            cur = opts[cur].parentIdx;
        }
        string path = "";
        for (int i = 0; i < chain.Count; i = i + 1) {
            if (i > 0) { path = path + " / "; }
            path = path + opts[chain[i]].label;
        }
        return path;
    }

    // 值的显示文本：showPath 决定完整路径还是末级短标签。
    public string ValueText(int idx) {
        if (!showPath) { return this.OptionLabel(idx); }
        return this.PathOf(idx);
    }

    // 勾选策略下的值集合（平铺下标）：all = 全部勾选节点；
    // parent = 没有被更深的勾选祖先盖住的节点（完整勾选子树的顶）；
    // child = 勾选的叶子。
    public List<int> ValueIdxs() {
        List<int> r = new List<int>();
        for (int i = 0; i < opts.Count; i = i + 1) {
            if (!opts[i].chosen || opts[i].grp) { continue; }
            if (checkStrategy == 2) {
                if (!opts[i].HasChildren()) { r.Add(i); }
                continue;
            }
            if (checkStrategy == 1) {
                int p = opts[i].parentIdx;
                bool covered = false;
                while (p >= 0 && p < opts.Count) {
                    if (opts[p].chosen) { covered = true; break; }
                    p = opts[p].parentIdx;
                }
                if (covered) { continue; }
            }
            r.Add(i);
        }
        return r;
    }

    // 值集合的显示标签（配合 ValueText 的 showPath 语义）。
    public List<string> ValueLabels() {
        List<int> vs = this.ValueIdxs();
        List<string> r = new List<string>();
        for (int i = 0; i < vs.Count; i = i + 1) {
            r.Add(this.ValueText(vs[i]));
        }
        return r;
    }

    // 级联多选：把 `idx` 的勾选态设为 `on`。联动开启时带动全部
    // 子孙，再沿父链回推（父级 = 全部子级勾上才算勾上）；
    // 关闭时只改自己。统一触发 Change。
    public void SetChecked(int idx, bool on) {
        if (idx < 0 || idx >= opts.Count) { return; }
        if (opts[idx].grp || opts[idx].disabled) { return; }
        this.ApplyCheck(idx, on);
        this.FixupAncestors(idx);
        Change.RaiseS(this);
    }

    // 递归应用勾选：联动开启时带动全部子孙。
    private void ApplyCheck(int idx, bool on) {
        opts[idx].chosen = on;
        if (cascadeLink && opts[idx].HasChildren()) {
            List<SelectOption> kids = opts[idx].children;
            for (int i = 0; i < kids.Count; i = i + 1) {
                this.ApplyCheck(kids[i].flatIdx, on);
            }
        }
    }

    // 沿父链回推勾选态：全子勾上 → 父勾上，否则父取消。
    // 某层已一致就停——更上层不可能因此变化。
    private void FixupAncestors(int idx) {
        if (!cascadeLink) { return; }
        int p = opts[idx].parentIdx;
        while (p >= 0 && p < opts.Count) {
            bool all = true;
            List<SelectOption> kids = opts[p].children;
            for (int i = 0; i < kids.Count; i = i + 1) {
                if (!kids[i].chosen) { all = false; break; }
            }
            if (opts[p].chosen == all) { break; }
            opts[p].chosen = all;
            p = opts[p].parentIdx;
        }
    }

    // 第 `idx` 个选项的半勾态：自身未勾但有勾选的子孙（联动模式）。
    public bool IsPartial(int idx) {
        if (idx < 0 || idx >= opts.Count) { return false; }
        if (opts[idx].chosen || !cascadeLink) { return false; }
        return this.HasCheckedDescendant(idx);
    }

    // 是否存在已勾选的子孙（递归）。
    private bool HasCheckedDescendant(int idx) {
        if (!opts[idx].HasChildren()) { return false; }
        List<SelectOption> kids = opts[idx].children;
        for (int i = 0; i < kids.Count; i = i + 1) {
            if (kids[i].chosen) { return true; }
            if (this.HasCheckedDescendant(kids[i].flatIdx)) { return true; }
        }
        return false;
    }
}
