using System;
using Gui;
using Gui.Backend;

namespace Gui.Widget;

// 输入过滤回调（Naive UI allow-input）：收到「插入后的完整候选
// 文本」，返回清洗后的文本；返回 null 表示拒绝这次插入。
// 用于「只允许数字」「不许前后空格」这类输入约束。
public delegate string InputFilterFn(string candidate);

// 带光标、占位符和响应式绑定的单行文本输入框。
// 保留式 C# 风格控件：拥有稳定标识（因此焦点在
// 兄弟/弹层变动后仍能保持），焦点/点击由框架解析，并
// 暴露委托事件：
// name.Change += () => { ... };   // 每次编辑时触发
// name.Submit += () => { ... };   // 回车时触发
// app.SetRootControl(name);
// 获得焦点时消费键盘事件（可打印字符、Backspace、
// Delete、Left/Right/Home/End），就地编辑Text 绑定的编辑缓冲，并将
// 光标位置上报给框架，使 IME 组合窗口
// 跟随光标移动。
// 能力面（对齐 Naive UI Input）：`Disabled`（继承自 Control）、
// `SetStatus` 校验态描边、`Prefix`/`Suffix` 文字槽与 `PrefixIcon`、
// `Loading` 转圈、`ShowCount`+`MaxLen`(+`CountGraphemes`) 字数统计、
// `Round` 圆角、`PassiveActivated` 回车激活、`Filter` 输入过滤、
// 以及 Clear/Focus/Blur/SelectAll/ScrollToEnd 手动操作。
public class Input : Control {
    // 编辑草稿在过滤和选区替换完成后一次写回，拒绝的候选值不进入模型。
    private string editText;
    public Binding<string> Text;
    // 占位文本（内容为空时显示）。
    public string hint;
    // 光标位置（字节偏移）。
    public int cursorPos;
    // 选区锚点（固定端；光标是移动端）：无选区时
    // 为 -1。鼠标按下 / Shift 移动时设置，
    // 任何普通光标移动或编辑时清除。
    public int selAnchor;
    // 控件命中 id。
    public int wid;
    // 最近参与布局或输入的宿主；手动操作也可在首次绘制前调用。
    public weak App liveApp;
    // 密码掩码：设置后文本以 `*` 渲染，直到被明文显示。
    public bool password;
    // 掩码字段当前是否显示明文（通过眼睛图标切换）。
    public bool reveal;
    // 可选的前导 / 尾随图标名（Gui.Icon）。密码框
    // 无论 `iconTrail` 如何都会在尾端绘制可点击的眼睛图标。
    public string iconLead;
    public string iconTrail;
    // 文本每次变化时触发（C# 风格：`inp.Change += h;`）。
    [Event]
    public UiEvent Change;
    // 获得焦点时按下回车触发。
    [Event]
    public UiEvent Submit;
    // 校验错误信息；"" 表示有效。SetError 会绘制红色边框，并
    // 在字段下方显示消息；任何编辑都会清除它。
    public string errMsg;
    // 尺寸变体：对应 ClassName = "small" / "large"（Naive UI size prop）。
    // Binding<string> 使 `inp.Size = vm.density;` 可响应式换档，
    // 属性面板（PropSpec.Enum + str 绑定）也能直接读写选项文本。
    public Binding<string> Size;
    // 可清空：文本非空且（获焦或悬停）时在尾端显示 X 按钮，
    // 点击清空内容并触发 Change（Naive UI clearable prop）。
    public bool Clearable;
    // 聚焦时自动全选内容（Naive UI autoselect prop）。适合
    // 地址栏、"搜索并跳转" 等点进来就整段替换的字段。
    public bool Autoselect;
    // 跟踪 autoselect 已执行过（防止每次获焦都全选）。
    public bool autoselected;
    // 输入字符上限（>0 生效）。按码点计——一个 CJK 字符记 1，
    // `CountGraphemes` 打开时按字素簇计（👨‍‍👧 记 1）。
    // 与 `ShowCount` 显示的计数同一口径。0 表示不限。
    public int MaxLen;

    // ---- 增强：Naive UI Input 的能力面（前缀/后缀/字数/校验态/
    // 加载/圆角/被动激活）全部走同一套「类选择器 + ::part」样式
    // 层，控件代码只做几何与输入处理。 --------------------------------

    // 前缀 / 后缀文字槽（Naive UI prefix/suffix）。画在文本与图标
    // 之间，颜色来自 `input::prefix` / `input::suffix`。
    public string Prefix;
    public string Suffix;
    // 自定义图标名（Gui.Icon）：前缀槽用 `PrefixIcon`、后缀槽用
    // `iconTrail`；密码框用 `PasswordIcon`（默认 "eye"），清除钮用
    // `ClearIcon`（默认 "x"）。
    public string PrefixIcon;
    public string PasswordIcon;
    public string ClearIcon;
    // 是否显示字数统计（"当前 / 上限"）。上限来自 MaxLen；未设
    // MaxLen 时按纯显示处理（Naive UI show-count）。
    public bool ShowCount;
    // 字数统计与 MaxLen 是否按字素簇计数（Naive UI count-graphemes）。
    // false 时按码点计数。
    public bool CountGraphemes;
    // 加载态：后缀区画一个转圈指示器，并禁用编辑（Naive UI loading）。
    public bool Loading;
    // 圆角字段：整高半圆角（Naive UI round），走 `.round` 类，
    // 皮肤可覆写。
    public bool Round;
    // 校验状态：""/success/warning/error，映射到 base.css 的
    // 字段状态类。与 errMsg 独立（后者是具体消息文案）。
    public string FieldStatus;
    // 被动激活（Naive UI passively-activated）：聚焦后先不接收
    // 文本输入，按回车才开始编辑——避免误触 Tab 聚焦就吞掉输入。
    public bool PassiveActivated;
    public bool passiveActive;
    // KeyPress 兼容通知按宿主窗口的本地文本事件序号去重。
    public long lastKeyNamedSeq;
    private bool pointerSelecting;
    private bool pointerOnTrail;
    // 0 = decorative slot, 1 = clear, 2 = password reveal.
    private int pointerTrailAction;
    private int pointerClickAction;
    private int pointerX;
    private int pointerY;
    private bool autoselectPending;

    // 输入过滤（Naive UI allow-input）：返回清洗后的候选文本，
    // null 表示原样拒绝。用于「只允许数字」「trim 空白」这类
    // 输入约束。内置 `Input.OnlyDigits` / `Input.NoSpaces`。
    public InputFilterFn Filter;

    // 保留模式构造函数共用的初始化函数：设置 Control 基类，
    // 再设置输入框专属状态。
    public void InitInput(Binding<string> text, string hintText) {
        this.InitControl("input", 1);
        Text = "";
        if (text != null) { Text = text; }
        editText = Text.Get();
        hint = hintText;
        cursorPos = 0;
        selAnchor = -1;
        wid = this.CommonId();
        password = false;
        reveal = false;
        iconLead = "";
        errMsg = "";
        iconTrail = "";
        Size = "medium";
        Clearable = false;
        Autoselect = false;
        autoselected = false;
        Prefix = "";
        Suffix = "";
        PrefixIcon = "";
        PasswordIcon = "";
        ClearIcon = "";
        ShowCount = false;
        CountGraphemes = false;
        Loading = false;
        Round = false;
        FieldStatus = "";
        PassiveActivated = false;
        passiveActive = false;
        lastKeyNamedSeq = 0;
        Filter = null;
        liveApp = null;
        wiresOwnEvents = true;
        Change = new UiEvent();
        Submit = new UiEvent();
    }

    public Input() : this("") { }

    // 保留模式构造函数：`Input name = new Input("Your name");`
    public Input(string hintText) {
        InitInput("", hintText);
    }

    // 一个与 `s` 等长（按字节）的 `*` 字符串，使掩码显示保持
    // 相同的字节布局，光标/选区计算仍然有效。
    private static string Mask(string s) {
        string m = "";
        for (int i = 0; i < s.Length; i = i + 1) { m = m + "*"; }
        return m;
    }

    // 当前文本。
    public string GetText() { this.SyncBinding(); return editText; }

    // 宿主调整占位文字（SelectBox 的筛选框在 Filterable(true) 之后
    // 才由 FilterHint 定文案，晚于构造）。
    public void SetHint(string v) { hint = v; }

    public override int InputFocusCapabilities() { return 3; }
    public override int PointerCursor() { return 1; }

    public override int WidgetId() { return wid; }

    // 覆盖文本：光标收到末尾、清空选区并写回绑定。
    public void SetText(string v) {
        editText = v;
        cursorPos = v.Length;
        selAnchor = -1;
        PushBinding();
    }

    // 选中全部文本（等同于用户按 Ctrl+A），因此下一次输入
    // 直接替换原内容。地址栏之类「点进来就是要换掉它」的
    // 字段在 Focus 事件里调用它。
    public void SelectAll() {
        selAnchor = 0;
        cursorPos = editText.Length;
    }

    // 清空内容（Naive UI ref.clear()）。触发 Change，光标归零。
    public void Clear() {
        if (editText == "") { return; }
        editText = "";
        cursorPos = 0;
        selAnchor = -1;
        Edited();
        if (liveApp != null) { liveApp.RequestRedraw(); }
    }

    // 以编程方式把焦点抢到本输入框（Naive UI ref.focus()）。
    // 禁用态不响应。
    public void Focus() {
        App app = this.FindApp();
        if (app == null) { app = liveApp; }
        if (app == null || this.IsDisabled()) { return; }
        liveApp = app;
        app.focus.SetFocused(wid, this);
        app.RequestRedraw();
    }

    // 交出焦点（Naive UI ref.blur()）。
    public void Blur() {
        if (liveApp == null) { return; }
        if (liveApp.focus.IsFocused(wid)) { liveApp.focus.ClearFocus(); }
        liveApp.RequestRedraw();
    }

    // 光标移到行尾（Naive UI ref.scrollTo 的等价物：渲染沿本来
    // 就会把光标滚进视口）。
    public void ScrollToEnd() {
        cursorPos = editText.Length;
        selAnchor = -1;
        if (liveApp != null) { liveApp.RequestRedraw(); }
    }

    // 光标移到行首。
    public void ScrollToStart() {
        cursorPos = 0;
        selAnchor = -1;
        if (liveApp != null) { liveApp.RequestRedraw(); }
    }

    // 设置校验状态（""/success/warning/error），即 base.css 的
    // 字段状态类。与 errMsg 互不影响：前者描边，后者带消息。
    // 非白名单值归一为 ""（设计器经 PropSpec 直写字段时，渲染沿兜底同见）。
    public void SetStatus(string v) {
        string s = Control.StatusSanitize(v);
        if (s == FieldStatus) { return; }
        FieldStatus = s;
        if (liveApp != null) { liveApp.RequestRedraw(); }
    }

    // ---- 计数与过滤（纯函数，无窗口即可验证） ------------------------

    // 当前文本的计数值（按 CountGraphemes 口径）。
    public int CountOf(string s) {
        if (CountGraphemes) { return Gui.Text.Graphemes(s); }
        return Gui.Text.Chars(s);
    }

    // 当前文本的计数值。
    public int CountValue() { return this.CountOf(this.GetText()); }

    // 字数统计的显示文本："当前 / 上限"；计数超过 99 时上限侧
    // 截为 "99+"（Naive UI 的显示口径）。
    public static string CountText(int count, int max) {
        string cur = "";
        if (count > 99) { cur = "99+"; } else { cur = Convert.ToString(count); }
        if (max <= 0) { return cur; }
        return cur + " / " + Convert.ToString(max);
    }

    // 内置过滤器：只允许数字（Naive UI allow-input 示例一）。
    public static string OnlyDigits(string s) {
        string outStr = "";
        int i = 0;
        while (i < s.Length) {
            int e = Gui.Text.NextCharEnd(s, i);
            string ch = s.Substring(i, e - i);
            if (ch.Length == 1) {
                int b = s[i];
                if (b >= 48 && b <= 57) { outStr = outStr + ch; }
            }
            i = e;
        }
        return outStr;
    }

    // 内置过滤器：不许有前后空格（Naive UI allow-input 示例二，
    // 边输边 trim；词与词之间的空格照常输入）。
    public static string NoSpaces(string s) {
        return TextWrap.Trim(s);
    }

    // 给字段标记校验错误；绘制红色边框，并显示
    // `msg` 于字段下方，直到用户编辑（或调用 ClearError）。
    public void SetError(string msg) {
        errMsg = msg;
    }

    // 清除待处理的校验错误（任何编辑时自动调用）。
    public void ClearError() {
        errMsg = "";
    }

    // 把绑定的模型值拉入编辑缓冲区（model -> UI）。
    public override void SyncBinding() {
        string cur = Text.Get();
        if (cur != editText) {
            editText = cur;
            this.ClampCursor();
        }
    }

    // 把编辑缓冲区通过绑定写回模型（UI -> model）。
    private void PushBinding() {
        Text.Set(editText);
    }

    // 所有 UI 编辑都汇入此处：先写回，再通知；同时清除
    // 任何校验错误——修正正是问题已解决的最强信号。
    private void Edited() {
        errMsg = "";
        PushBinding();
        Change.Raise(this);
    }

    // 光标与选区锚点钳回文本范围内。
    public void ClampCursor() {
        string txt = editText;
        if (cursorPos > txt.Length) { cursorPos = txt.Length; }
        if (cursorPos < 0) { cursorPos = 0; }
        if (selAnchor > txt.Length) { selAnchor = txt.Length; }
    }

    // 是否存在非空选区。
    public bool HasSel() { return selAnchor >= 0 && selAnchor != cursorPos; }
    // 选区起点（较小端；无选区即光标位置）。
    public int SelStart() { if (selAnchor >= 0 && selAnchor < cursorPos) { return selAnchor; } return cursorPos; }
    // 选区终点（较大端）。
    public int SelEnd() { if (selAnchor > cursorPos) { return selAnchor; } return cursorPos; }

    // 选区文本（无选区为 ""）。
    public string SelText() {
        if (!HasSel()) { return ""; }
        return editText.Substring(SelStart(), SelEnd() - SelStart());
    }

    // 删除选中的范围，并把光标收拢到其起点。
    private void DeleteSel() {
        if (!HasSel()) { return; }
        string txt = editText;
        int s = SelStart();
        int e = SelEnd();
        editText = txt.Substring(0, s) + txt.Substring(e, txt.Length - e);
        cursorPos = s;
        selAnchor = -1;
    }

    // 插入的唯一闸门：先替换选区，再过宿主过滤器与字符上限。
    // 被拒绝时完整回滚（选区也还回去）——"30 上限里再敲一个
    // 字"不应有任何可见变化。过滤后整体被改写时（在 "12" 的
    // 数字框中间插 "a" → "12"），光标按净增字节平移，不会被
    // trim 式过滤器甩到文末。上限按 CountOf 口径计，与字数
    // 统计显示同一个数。
    public bool Insert(string s) {
        string orig = editText;
        int origCursor = cursorPos;
        int origAnchor = selAnchor;
        bool hadSel = HasSel();
        if (hadSel) { DeleteSel(); }
        string txt = editText;
        string cand = Gui.Text.InsertAt(txt, cursorPos, s);
        string final = cand;
        if (Filter != null) { final = Filter(cand); }
        if (final == null
            || (MaxLen > 0 && this.CountOf(final) > MaxLen)) {
            editText = orig;
            cursorPos = origCursor;
            selAnchor = origAnchor;
            return false;
        }
        int delta = final.Length - cand.Length;
        int cp = cursorPos + s.Length + delta;
        if (cp < 0) { cp = 0; }
        if (cp > final.Length) { cp = final.Length; }
        if (final == txt && cp == cursorPos && !hadSel) {
            // 净零变化（插入即被过滤掉）：不发 Change、不动状态。
            selAnchor = -1;
            return false;
        }
        editText = final;
        cursorPos = cp;
        selAnchor = -1;
        Edited();
        return true;
    }

    // 退格/删除的候选整体再过一次过滤器：删掉词边界上的字母
    // 可能"暴露"出前后空格（NoSpaces 场景），删除路径也要被
    // 清洗。返回 false 表示过滤器拒绝该结果。
    public bool DeleteCandidate(string cand) {
        string final = cand;
        if (Filter != null) { final = Filter(cand); }
        if (final == null) { return false; }
        if (final == editText) { return false; }
        editText = final;
        if (cursorPos > final.Length) { cursorPos = final.Length; }
        if (selAnchor > final.Length) { selAnchor = final.Length; }
        Edited();
        return true;
    }

    // 路由输入复用原有编辑规则；返回 true 表示该事件已归本控件。
    private bool HandleKeyEvent(App app, int kind, int code, int mods) {
        ClampCursor();
        string txt = editText;
        // 被动激活：聚焦后先用回车"解锁"，解锁前不消费任何编辑键
        // （Naive UI passively-activated：Tab 聚焦不该吞掉输入）。
        if (PassiveActivated && !passiveActive) {
            if (kind == 6 && code == 13) {
                passiveActive = true;
                app.RequestRedraw();
                return true;
            }
            return false;
        }
        if (kind == 6) {
            if (code == 8) {
                if (HasSel()) {
                    DeleteSel();
                    Edited();
                    app.RequestRedraw();
                } else if (cursorPos > 0) {
                    int start = Gui.Text.PrevCharStart(txt, cursorPos);
                    if (this.DeleteCandidate(Gui.Text.DeleteBefore(txt, cursorPos))) {
                        cursorPos = start;
                    }
                    app.RequestRedraw();
                }
                // 退格已归本输入框：事件槽留到下次轮询期间窗口可能再
                // 渲染几帧，不消费就会连删两个字符。
                return true;
            } else if (code == 13) {
                Submit.Raise(this);
                app.RequestRedraw();
                return true;
            } else if (code == 9) {
                // 忽略 Tab（由框架焦点遍历处理）——不消费，Tab 留给框架。
            } else {
                string ch = Gui.Text.CharStr(code);
                if (ch.Length > 0 && app.window.EventSeq() != this.lastKeyNamedSeq) {
                    // 字符键出口：落文本之前通知（DOM keypress 语义）；
                    // 仅 KeyPress 兼容通知在控件内按本地序号去重。
                    this.lastKeyNamedSeq = app.window.EventSeq();
                    this.FireKeyNamed("KeyPress");
                    if (this.IsDisabled() || Loading || !this.IsFocused(app)) { return true; }
                    // IME 组合：直接插入（上限/过滤同样生效）。
                    if (this.Insert(ch)) { app.RequestRedraw(); }
                    // 这个字符已归本输入框：事件槽留到下次轮询期间窗口
                    // 可能再渲染几帧，不消费就会被重复插入（输一个 "4"
                    // 得 "44"）。
                    return true;
                }
            }
        } else if (kind == 4) {
            int kc = code;
            bool shift = Modifiers.HasShift(mods);
            bool ctrl = Modifiers.HasCtrl(mods);
            if (ctrl && kc == 65) {
                // Ctrl+A：全选。
                selAnchor = 0;
                cursorPos = txt.Length;
                app.RequestRedraw();
                return true;
            } else if (ctrl && kc == 67) {
                // Ctrl+C：复制选区（无选区时复制全文）。
                if (HasSel()) { Clipboard.SetText(SelText()); }
                else { Clipboard.SetText(txt); }
                return true;
            } else if (ctrl && kc == 88) {
                // Ctrl+X：剪切。
                if (HasSel()) {
                    Clipboard.SetText(SelText());
                    DeleteSel();
                    Edited();
                    app.RequestRedraw();
                }
                return true;
            } else if (ctrl && kc == 86) {
                // Ctrl+V：粘贴（整段走同一过滤+上限闸门）。
                string clip = Clipboard.GetText();
                if (clip.Length > 0) {
                    if (this.Insert(clip)) { app.RequestRedraw(); }
                }
                return true;
            } else if (kc == 37 || kc == 39 || kc == 36 || kc == 35) {
                // 方向键/Home/End：Shift 从光标处扩展选区；
                // 普通移动则收起选区（方向键收起到选区边缘，
                // 与所有原生文本框一致）。
                if (shift) {
                    if (selAnchor < 0) { selAnchor = cursorPos; }
                } else if (HasSel()) {
                    if (kc == 37) { cursorPos = SelStart(); }
                    else if (kc == 39) { cursorPos = SelEnd(); }
                    selAnchor = -1;
                    if (kc == 36) { cursorPos = 0; }
                    if (kc == 35) { cursorPos = txt.Length; }
                    app.RequestRedraw();
                    return true;
                }
                if (!shift) { selAnchor = -1; }
                if (kc == 37) { if (cursorPos > 0) { cursorPos = Gui.Text.PrevCharStart(txt, cursorPos); } }
                else if (kc == 39) { if (cursorPos < txt.Length) { cursorPos = Gui.Text.NextCharEnd(txt, cursorPos); } }
                else if (kc == 36) { cursorPos = 0; }
                else if (kc == 35) { cursorPos = txt.Length; }
                app.RequestRedraw();
                return true;
            } else if (kc == 46) {
                if (HasSel()) {
                    DeleteSel();
                    Edited();
                    app.RequestRedraw();
                } else if (cursorPos < txt.Length) {
                    if (this.DeleteCandidate(Gui.Text.RemoveAt(txt, cursorPos))) {
                        app.RequestRedraw();
                    }
                }
                return true;
            }
        }
        return false;
    }

    private void HandleRoutedKey(RoutedEventArgs e, int kind) {
        if (e.handled || this.IsDisabled() || Loading) { return; }
        App app = this.FindApp();
        if (app == null) { app = liveApp; }
        if (app == null || !this.IsFocused(app)) { return; }
        if (liveApp != app) { lastKeyNamedSeq = 0; }
        liveApp = app;
        this.SyncBinding();
        if (Autoselect && !autoselected) {
            this.SelectAll();
            autoselected = true;
        }
        autoselectPending = false;
        if (this.HandleKeyEvent(app, kind, e.keyCode, e.modifiers)) { e.Handle(); }
        this.UpdateInputCaret(app);
    }

    private InputGeometry InputGeometryForStyle(App app, StyleBox style, int x, int y, int w, int h) {
        int font = style.FontOr(Style.FontFallback(app, "medium"));
        string text = editText;
        bool clear = Clearable && text != "" && !this.IsDisabled() && !Loading
            && (this.IsFocused(app) || this.isHovered || app.focus.IsHovered(wid));
        bool trail = Loading || clear || password || iconTrail != "";
        int suffixWidth = Suffix != null && Suffix != "" ? Canvas.MeasureText(Suffix, font) : 0;
        int countWidth = 0;
        if (ShowCount) {
            string count = Input.CountText(this.CountOf(text), MaxLen);
            StyleBox countStyle = this.ResolvePartAs(app, "input", "count", "", this.EffectiveClass(), Style.SNormal());
            countWidth = Canvas.MeasureText(count, countStyle.FontOr(Style.FontFallback(app, "small")));
        }
        string prefixIcon = iconLead != "" ? iconLead : PrefixIcon;
        int prefixWidth = Prefix != null && Prefix != "" ? Canvas.MeasureText(Prefix, font) : 0;
        string display = text;
        if (password && !reveal) { display = Input.Mask(text); }
        return InputGeometry.Build(app, x, y, w, h, font,
            style.PadLOr(app.Scale(6)), style.PadROr(app.Scale(6)), app.Scale(4),
            prefixIcon != "", prefixWidth, suffixWidth, countWidth, trail, clear, display, cursorPos);
    }

    public override string EffectiveClass() {
        string cls = this.SizeClassIn(Class);
        cls = Control.ClassWith(cls, Control.StatusSanitize(FieldStatus));
        if (Round) { cls = Control.ClassWith(cls, "round"); }
        return cls;
    }

    private InputGeometry CurrentInputGeometry(App app) {
        // Geometry is cheap derived state, not a snapshot of the last paint.
        // Text, selection, inline styles, slots and bounds can all change between events.
        StyleBox style = this.ResolveEasedStyleAsIn(app, wid, "input", this.EffectiveClass(),
            this.IsDisabled(), false, bx, by, bw, bh);
        return this.InputGeometryForStyle(app, style, bx, by, bw, bh);
    }

    private void UpdateInputCaret(App app) {
        if (!this.IsFocused(app) || this.IsDisabled()) { return; }
        InputGeometry geometry = this.CurrentInputGeometry(app);
        app.SetImeCaret(geometry.innerX - geometry.scrollX + geometry.caretWidth,
            geometry.textY + Canvas.FontHeight(geometry.font));
    }

    private int TrailAction(InputGeometry geometry) {
        if (Loading || this.IsDisabled()) { return 0; }
        if (geometry.showClear) { return 1; }
        if (password) { return 2; }
        return 0;
    }

    private void MovePointerCaret(App app, int x) {
        this.SyncBinding();
        this.ClampCursor();
        InputGeometry geometry = this.CurrentInputGeometry(app);
        cursorPos = geometry.CursorAt(x, editText);
        this.UpdateInputCaret(app);
        app.RequestRedraw();
    }

    public override void OnPointerDown(RoutedEventArgs e) {
        App app = this.FindApp();
        if (e.handled || e.originalSource != this || app == null || this.IsDisabled()
            || Loading || app.window.EventButton() != 0 || !this.IsFocused(app)) { return; }
        liveApp = app;
        this.SyncBinding();
        this.ClampCursor();
        InputGeometry geometry = this.CurrentInputGeometry(app);
        pointerClickAction = 0;
        pointerX = e.x;
        pointerY = e.y;
        pointerOnTrail = geometry.OnTrail(e.x, e.y);
        pointerTrailAction = pointerOnTrail ? this.TrailAction(geometry) : 0;
        pointerSelecting = !pointerOnTrail;
        bool shift = Modifiers.HasShift(e.modifiers);
        if (pointerSelecting) {
            if (shift) {
                if (selAnchor < 0) { selAnchor = cursorPos; }
                cursorPos = geometry.CursorAt(e.x, editText);
            } else if (!autoselectPending) {
                cursorPos = geometry.CursorAt(e.x, editText);
                selAnchor = cursorPos;
            }
        }
        autoselectPending = false;
        base.OnPointerDown(e);
        app.CapturePointer(this, pointerSelecting);
        this.UpdateInputCaret(app);
        app.RequestRedraw();
        e.Handle();
    }

    public override void OnPointerMove(RoutedEventArgs e) {
        App app = this.FindApp();
        if (e.handled || app == null || app.GetCapturedPointer() != this) { return; }
        if (this.IsDisabled() || Loading || !this.IsFocused(app)) { this.OnPointerCancel(e); return; }
        if (pointerSelecting && (e.x != pointerX || e.y != pointerY)) {
            pointerX = e.x;
            pointerY = e.y;
            this.MovePointerCaret(app, e.x);
        }
        e.Handle();
    }

    public override void OnPointerUp(RoutedEventArgs e) {
        App app = this.FindApp();
        if (e.handled || app == null || app.GetCapturedPointer() != this
            || app.window.EventButton() != 0) { return; }
        if (this.IsDisabled() || Loading || !this.IsFocused(app)) {
            this.OnPointerCancel(e);
            e.Handle();
            return;
        }
        this.SyncBinding();
        this.ClampCursor();
        InputGeometry geometry = this.CurrentInputGeometry(app);
        pointerClickAction = pointerOnTrail && geometry.OnTrail(e.x, e.y)
            && pointerTrailAction == this.TrailAction(geometry) ? pointerTrailAction : 0;
        if (pointerSelecting && (e.x != pointerX || e.y != pointerY)) {
            this.MovePointerCaret(app, e.x);
        }
        if (selAnchor == cursorPos) { selAnchor = -1; }
        pointerSelecting = false;
        pointerOnTrail = false;
        pointerTrailAction = 0;
        base.OnPointerUp(e);
        app.ReleasePointerCapture();
        app.RequestRedraw();
        // Leave Up unhandled so App can validate the actual release target and
        // synthesize one Click (including its standard named notification).
    }

    public override void OnClick(RoutedEventArgs e) {
        int action = pointerClickAction;
        pointerClickAction = 0;
        App app = this.FindApp();
        if (e.handled || e.originalSource != this || app == null || this.IsDisabled()
            || Loading || app.window.EventButton() != 0 || !this.IsFocused(app)) { return; }
        this.SyncBinding();
        InputGeometry geometry = this.CurrentInputGeometry(app);
        if (action != 0 && geometry.OnTrail(e.x, e.y) && action == this.TrailAction(geometry)) {
            if (action == 1) { this.Clear(); }
            else { reveal = !reveal; }
        }
        this.UpdateInputCaret(app);
        app.RequestRedraw();
        e.Handle();
    }

    public override void OnPointerCancel(RoutedEventArgs e) {
        base.OnPointerCancel(e);
        pointerSelecting = false;
        pointerOnTrail = false;
        pointerTrailAction = 0;
        pointerClickAction = 0;
        autoselectPending = false;
        if (selAnchor == cursorPos) { selAnchor = -1; }
        App app = this.FindApp();
        if (app != null && app.GetCapturedPointer() == this) { app.ReleasePointerCapture(); }
        if (app != null) { app.RequestRedraw(); }
    }

    public override void OnInputFocusLost() {
        // CancelInputSubtree routes PointerCancel before clearing focus. Focus loss
        // must finish an active gesture, not cancel the same retirement a second time.
        App app = this.FindApp();
        if (this.isPressed || this.isHovered || pointerSelecting || pointerOnTrail
                || pointerTrailAction != 0 || pointerClickAction != 0 || autoselectPending
                || (app != null && app.GetCapturedPointer() == this)) {
            RoutedEventArgs cancel = new RoutedEventArgs("PointerCancel", this, 0, 0);
            this.OnPointerCancel(cancel);
        }
        selAnchor = -1;
        autoselected = false;
        passiveActive = false;
    }

    public override void TriggerEvent(string evt) {
        if (evt == "Focus") {
            App app = this.FindApp();
            if (app != null) {
                liveApp = app;
                this.SyncBinding();
                this.ClampCursor();
                if (Autoselect && !autoselected) {
                    this.SelectAll();
                    autoselected = true;
                    autoselectPending = true;
                }
                this.UpdateInputCaret(app);
                app.RequestRedraw();
            }
        }
        base.TriggerEvent(evt);
    }

    public override void OnKeyDown(RoutedEventArgs e) { this.HandleRoutedKey(e, 4); }
    public override void OnKeyUp(RoutedEventArgs e) { this.HandleRoutedKey(e, 5); }
    public override void OnTextInput(RoutedEventArgs e) { this.HandleRoutedKey(e, 6); }

    // Only visual output; input, focus and IME caret updates run outside paint.
    private int PaintInput(App app, int x, int y, int w, int h) {
        int id = wid;
        Canvas c = app.canvas;
        Theme t = app.theme;
        bool off = this.IsDisabled();
        bool focused = this.IsFocused(app) && !off;

        string cls = this.EffectiveClass();

        string txt = editText;

        // 整个外框（填充、边框、圆角、阴影、hover/focus 淡变）
        // 来自样式层，因此皮肤的 `input:hover / input:focus`
        // 规则即可重设字段样式，无需改动此代码。
        StyleBox s = this.ResolveEasedStyleAsIn(
            app, id, "input", cls, off, false, x, y, w, h);
        s.Paint(app, x, y, w, h);
        int fs = s.FontOr(Style.FontFallback(app, "medium"));
        int accent = s.accent;
        // 校验错误：颜色与线宽来自 `input::error` 部件（在样式层之后
        // 绘制，皮肤可改写该部件但无法被普通边框规则冲淡）。
        StyleBox errorStyle = null;
        if (errMsg != "") {
            errorStyle = this.ResolvePartAs(app, "input", "error", "",
                                            cls, Style.SNormal());
            c.DrawRect(x, y, w, h, errorStyle.BorderOr(errorStyle.fg),
                       errorStyle.BorderWOr(2));
        }

        InputGeometry geometry = this.InputGeometryForStyle(app, s, x, y, w, h);
        int padL = s.PadLOr(app.Scale(6));
        int slotGap = app.Scale(4);
        int glyphSz = geometry.glyph;
        int innerX = geometry.innerX;
        int innerW = geometry.innerWidth;
        int textY = geometry.textY;
        int iconX = geometry.iconX;
        int iconW = geometry.hasTrail ? glyphSz : 0;
        int sfxX = geometry.suffixX;
        int countX = geometry.countX;
        int scrollX = geometry.scrollX;
        int caretW = geometry.caretWidth;
        string disp = geometry.display;
        string preIcon = iconLead;
        if (preIcon == "" && PrefixIcon != "") { preIcon = PrefixIcon; }
        string pfx = Prefix != null ? Prefix : "";
        string sfx = Suffix != null ? Suffix : "";
        string countTxt = ShowCount ? Input.CountText(this.CountOf(txt), MaxLen) : "";
        bool showClear = geometry.showClear;
        string trailIcon = iconTrail;
        if (password && !showClear && !Loading) {
            trailIcon = PasswordIcon != "" ? PasswordIcon : "eye";
        }
        if (showClear) { trailIcon = ClearIcon != "" ? ClearIcon : "x"; }
        bool onTrail = !off && geometry.OnTrail(app.mouseX, app.mouseY);

        StyleBox placeholderStyle = this.ResolveEasedPartAsIn(
            app, id, "input", "placeholder", "", cls, false, false,
            x, y, w, h);
        StyleBox selectionStyle = this.ResolveEasedPartAsIn(
            app, id, "input", "selection", "", cls, false, false,
            x, y, w, h);
        StyleBox caretStyle = this.ResolveEasedPartAsIn(
            app, id, "input", "caret", "", cls, false, false,
            x, y, w, h);
        int placeholderFont = placeholderStyle.FontOr(fs);
        int caretColor = caretStyle.BgOr(caretStyle.FgOr(caretStyle.AccentOr(accent)));

        c.PushClip(innerX, y, innerW, h);
        if (focused && HasSel()) {
            // 文本后的选区高亮。
            int selPx0 = Canvas.MeasureText(Gui.Text.Left(disp, SelStart()), fs);
            int selPx1 = Canvas.MeasureText(Gui.Text.Left(disp, SelEnd()), fs);
            int selH = Canvas.FontHeight(fs);
            c.FillRect(innerX - scrollX + selPx0, textY, selPx1 - selPx0, selH,
                       selectionStyle.BgOr(accent));
        }
        // 组词中（拼音等尚未上屏）不画 placeholder：预览会占住文本
        // 起点，两者叠在一起没法读。桌面端 Composing() 恒为 ""。
        string composing = focused ? Ime.Composing() : "";
        if (txt == "" && composing == "") {
            int placeholderY = Canvas.CenterTextY(y, h, placeholderFont);
            c.DrawText(innerX, placeholderY, hint,
                       placeholderStyle.FgOr(s.fg), placeholderFont);
        } else if (disp != "") {
            c.DrawText(innerX - scrollX, textY, disp, s.fg, fs);
        }

        if (focused) {
            int cursorX = innerX - scrollX + caretW;
            int cursorH = Canvas.FontHeight(fs);
            int cursorWidth = caretStyle.WidthOr(1);
            c.FillRect(cursorX, textY, cursorWidth, cursorH, caretColor);
            // 组词预览：拼音等组合中、尚未上屏的串以 placeholder 色画在
            // 光标右侧；上屏后 native 清空预览，真文本接在原文本后面。
            if (composing != "") {
                c.DrawText(cursorX + cursorWidth + slotGap, textY, composing,
                           placeholderStyle.FgOr(s.fg), fs);
            }
        }
        c.PopClip();

        // 槽位文字/图标位于文本裁剪区之外，在 PopClip 之后绘制。
        // 前后缀文字颜色来自 `input::prefix` / `input::suffix`。
        int slotX = x + padL;
        if (preIcon != "") {
            StyleBox iconStyle = this.ResolvePartAs(
                app, "input", "icon", "", cls, Style.SNormal());
            c.DrawGlyphIn(preIcon, slotX, y, glyphSz, h, glyphSz,
                iconStyle.FgOr(s.fg));
            slotX = slotX + glyphSz + slotGap;
        }
        if (pfx != "") {
            StyleBox pfxStyle = this.ResolvePartAs(
                app, "input", "prefix", "", cls, Style.SNormal());
            c.DrawText(slotX, textY, pfx, pfxStyle.FgOr(s.fg), fs);
        }
        if (sfx != "") {
            StyleBox sfxStyle = this.ResolvePartAs(
                app, "input", "suffix", "", cls, Style.SNormal());
            c.DrawText(sfxX, textY, sfx, sfxStyle.FgOr(s.fg), fs);
        }
        // 字数统计：右对齐在文本与后缀之间（`input::count`，小一号）。
        if (countTxt != "") {
            StyleBox countStyle = this.ResolvePartAs(
                app, "input", "count", "", cls, Style.SNormal());
            int cfs = countStyle.FontOr(Style.FontFallback(app, "small"));
            c.DrawText(countX, Canvas.CenterTextY(y, h, cfs), countTxt,
                       countStyle.FgOr(s.fg), cfs);
        }
        if (Loading) {
            // 与 Spin 共用 720ms 圈速，圆点间连续交接高光。
            int phase = Spin.DotPhase(Window.GetTickMs());
            int spinC = s.AccentOr(accent);
            int faintC = ColorMath.WithAlpha(spinC, 80);
            int dotR = glyphSz / 8;
            if (dotR < app.Scale(1)) { dotR = app.Scale(1); }
            int cx = iconX + glyphSz / 2;
            int cy = y + h / 2;
            int ring = glyphSz / 2 - dotR - app.Scale(1);
            if (ring < 1) { ring = 1; }
            for (int i = 0; i < 8; i = i + 1) {
                int px = cx + (ring * Spin.OffX(i)) / 1000;
                int py = cy + (ring * Spin.OffY(i)) / 1000;
                int head = Spin.DotLevel(phase, i, 0);
                int highlight = Spin.DotLevel(phase, i, 1);
                Spin.PaintDot(c, px, py, dotR, app.Scale(1),
                              ColorMath.LerpColor(faintC, spinC, highlight), head);
            }
            app.RequestAnimationFrameIn(iconX, y, iconW, h);
        } else if (trailIcon != "") {
            // 图标颜色来自 `input::icon`：悬停用 :hover，密码明文
            // （眼睛常亮）用 :selected。
            StyleBox iconStyle = this.ResolvePartAs(
                app, "input", "icon", "", cls, Style.SNormal());
            int iconState = Style.SNormal();
            if (onTrail) { iconState = Style.SHover(); }
            if (password && reveal && !showClear) {
                iconState = iconState + Style.SSelected();
            }
            if (iconState != Style.SNormal()) {
                iconStyle = this.ResolvePartAs(
                    app, "input", "icon", "", cls, iconState);
            }
            c.DrawGlyphIn(trailIcon, iconX, y, glyphSz, h, glyphSz,
                          iconStyle.FgOr(s.fg));
        }
        // 校验消息显示在字段下方（在 PopClip 之后绘制，
        // 文本裁剪区无法截断它）。
        if (errMsg != "") {
            c.DrawText(x, y + h + app.Scale(2), errMsg,
                       errorStyle.FgOr(s.fg),
                       errorStyle.FontOr(Style.FontFallback(app, "small")));
        }

        return id;
    }

    // --- 设计器 / 序列化模型 ---

    // 覆写：返回 Size 绑定字段（设计器经它发现尺寸档位绑定）。
    public override Binding<string> SizeOf() { return Size; }

    // 覆写：返回设计器属性清单（占位 / 文本 / 尺寸 / 前后缀 / 状态 / 长度等）。
    protected override List<PropSpec> DefineProps() {
        List<PropSpec> ps = new List<PropSpec>();
        ps.Add(PropSpec.Text("hint", "Placeholder").Field("hint").Also("placeholder"));
        ps.Add(PropSpec.Text("value", "Value").DefaultBinding().Field("Text").Also("text").Also("data"));
        PropSpec sz = PropSpec.Enum("size", "Size",
            PropSpec.Sizes());
        sz.Field("Size");
        ps.Add(sz);
        ps.Add(PropSpec.BoolField("Clearable"));
        ps.Add(PropSpec.BoolField("Autoselect"));
        ps.Add(PropSpec.TextField("Prefix"));
        ps.Add(PropSpec.TextField("Suffix"));
        PropSpec st = PropSpec.Enum("status", "Status",
            new List<string>{ "", "success", "warning", "error" });
        st.Field("FieldStatus");
        ps.Add(st);
        ps.Add(PropSpec.Int("maxlen", "MaxLen").Field("MaxLen").Step(1, 0, 4096));
        ps.Add(PropSpec.Bool("showCount", "ShowCount").Field("ShowCount"));
        ps.Add(PropSpec.BoolField("Round"));
        ps.Add(PropSpec.BoolField("Loading"));
        ps.Add(PropSpec.Bool("passive", "PassiveActivated").Field("PassiveActivated"));
        ps.Add(PropSpec.Bool("password", "Password").Field("password"));
        ps.Add(PropSpec.Text("iconLead", "Leading icon").Field("iconLead").Also("icon"));
        ps.Add(PropSpec.Text("iconTrail", "Trailing icon").Field("iconTrail"));
        ps.Add(PropSpec.TextField("PrefixIcon").Also("iconLead2"));
        ps.Add(PropSpec.TextField("PasswordIcon"));
        ps.Add(PropSpec.TextField("ClearIcon"));
        ps.Add(PropSpec.BoolField("CountGraphemes"));
        return ps;
    }

    // --- 保留模式钩子（Control） ---

    // 覆写：按尺寸档解析样式，高取样式行高，宽缺省 220。
    public override void OnMeasure(App app) {
        if (liveApp != app) { lastKeyNamedSeq = 0; }
        liveApp = app;
        this.SyncBinding();
        this.ClampCursor();
        Theme t = app.theme;
        StyleBox s = this.Box(app);
        prefH = s.HeightOr(t.heightMedium);
        prefW = s.WidthOr(app.Scale(220));
    }

    // Retained paint consumes the arranged bounds without dispatching input.
    public override void OnPaint(App app) {
        this.PaintInput(app, bx, by, bw, bh);
    }
}
