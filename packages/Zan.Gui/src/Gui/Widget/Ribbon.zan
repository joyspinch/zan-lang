using System;
using Gui;

namespace Gui.Widget;

// Office 风格功能区（Ribbon）：纯声明式对象树与 CSS 盒模型，继承自 Control。
public partial class Ribbon : Control {
    public List<string> tabs;
    public SignalInt activeTab;
    public List<RibbonGroup> groups;
    public List<RibbonCmd> cmds;
    public UiEvent CommandClicked;
    // 最近一次被点的条目下标：宿主在构建 groups/cmds 时把全局动作
    // 序号写进 RibbonItem.act / RibbonCmd.act，点击经 CommandClicked
    // 抛出后从这里读回；重建代次使旧排队动作失效。
    public int lastAct;
    int treeGeneration;

    public override int StyleDisplay() { return 1; } // Flex
    public override int StyleFlexDir() { return 1; } // Column

    public Ribbon() {
        this.InitControl("ribbon", 1);
        this.ClassName = "ribbon col";
        tabs = new List<string>();
        activeTab = new SignalInt(0);
        groups = new List<RibbonGroup>();
        cmds = new List<RibbonCmd>();
        CommandClicked = new UiEvent();
        this.wiresOwnEvents = true;
    }

    public void AddTab(string name) {
        tabs.Add(name);
        this.BuildTree();
    }

    public void AddGroup(RibbonGroup g) {
        groups.Add(g);
        this.BuildTree();
    }

    public void AddCommand(RibbonCmd cmd) {
        cmds.Add(cmd);
        this.BuildTree();
    }

    public void BuildTree() {
        treeGeneration = treeGeneration + 1;
        int session = treeGeneration;
        this.CloseRetainedOverflow();
        if (treeGeneration != session) { return; }
        this.RemoveAll();
        if (treeGeneration != session) { return; }
        this.BeginRetainedTree();

        // 1. 顶部标签条
        if (tabs.Count > 0) {
            Control tabStrip = new Control();
            tabStrip.ClassName = "ribbon-tabs row align-center";
            for (int ti = 0; ti < tabs.Count; ti = ti + 1) {
                int tidx = ti;
                Button tb = new Button(tabs[ti]);
                tb.ClassName = "ribbon-tab " + (activeTab.Get() == ti ? "active" : "");
                RibbonAction action = new RibbonAction();
                action.Owner = this; action.Generation = session; action.Value = tidx; action.Tab = true; action.Source = tb;
                tb.Click.Add(action.Run);
                tabStrip.Add(tb);
            }
            retainedTabs = tabStrip;
            this.Add(tabStrip);
        }

        // 2. 主体命令带
        Control band = new Control();
        band.ClassName = "ribbon-band row align-stretch flex-1";

        if (groups.Count > 0) {
            for (int gi = 0; gi < groups.Count; gi = gi + 1) {
                RibbonGroup grp = groups[gi];
                Control gnode = new Control();
                gnode.ClassName = "ribbon-group col justify-between";

                Control itemsBox = new Control();
                itemsBox.ClassName = "ribbon-group-items row align-center flex-1";
                for (int ii = 0; ii < grp.items.Count; ii = ii + 1) {
                    RibbonItem it = grp.items[ii];
                    int actIdx = it.act;
                    bool compact = it.small || it.tile;
                    Button ibtn = new Button("");
                    ibtn.ClassName = "ribbon-cmd col align-center justify-center "
                        + (compact ? "small" : "large")
                        + (it.toggle && it.on ? " on" : "")
                        + (it.menu ? " has-menu" : "");
                    if (!it.enabled) { ibtn.Disabled = true; }
                    if (it.tip != "") { ibtn.Tip = it.tip; }
                    else if (it.label != "") { ibtn.Tip = it.label; }
                    if (it.icon != "") { ibtn.Add(new IconView(it.icon, compact ? 14 : 20)); }
                    Label caption = null;
                    if (it.label != "" && !it.tile) { caption = new Label(it.label); ibtn.Add(caption); }
                    if (it.menu) { ibtn.Add(new IconView("chevron-down", 8)); }
                    retainedItems.Add(ibtn); retainedLabels.Add(caption);
                    RibbonAction action = new RibbonAction();
                    action.Owner = this; action.Generation = session; action.Value = actIdx; action.Source = ibtn;
                    ibtn.Click.Add(action.Run);
                    itemsBox.Add(ibtn);
                }
                gnode.Add(itemsBox);

                Label groupTitle = null;
                if (grp.title != "") {
                    Label glbl = new Label(grp.title);
                    glbl.ClassName = "ribbon-group-title align-center justify-center";
                    gnode.Add(glbl);
                    groupTitle = glbl;
                }
                retainedGroups.Add(gnode); retainedBoxes.Add(itemsBox); retainedTitles.Add(groupTitle);
                band.Add(gnode);
            }
        } else if (cmds.Count > 0) {
            for (int ci = 0; ci < cmds.Count; ci = ci + 1) {
                RibbonCmd cmd = cmds[ci];
                int actIdx = cmd.act;
                Button cbtn = new Button();
                cbtn.ClassName = "ribbon-cmd col align-center justify-center "
                    + (cmd.compact ? "compact" : "")
                    + (cmd.on ? " on" : "");
                if (!cmd.enabled) { cbtn.Disabled = true; }
                if (cmd.tip != "") { cbtn.Tip = cmd.tip; }
                if (cmd.icon != "") { cbtn.Add(new IconView(cmd.icon, cmd.compact ? 14 : 20)); }
                Label caption = null;
                if (!cmd.compact && cmd.label != "") { caption = new Label(cmd.label); cbtn.Add(caption); }
                retainedItems.Add(cbtn); retainedLabels.Add(caption);
                RibbonAction action = new RibbonAction();
                action.Owner = this; action.Generation = session; action.Value = actIdx; action.Source = cbtn;
                cbtn.Click.Add(action.Run);
                band.Add(cbtn);
                if (cmd.sep) {
                    Control sep = new Control();
                    sep.ClassName = "ribbon-divider";
                    retainedDividers.Add(sep); retainedDividerItems.Add(ci);
                    band.Add(sep);
                }
            }
        }
        retainedMore = new Button();
        retainedMore.ClassName = "ribbon-cmd ghost small";
        retainedMore.Tip = Ribbon.T("More commands", "更多命令");
        retainedMore.Add(new IconView("chevrons-right", 16));
        RibbonAction moreAction = this.RetainedAction(0, false, retainedMore);
        moreAction.Overflow = true;
        retainedMore.Click.Add(moreAction.Run);
        band.Add(retainedMore);
        retainedBand = band;
        this.Add(band);
    }

    public override string Kind() { return "Ribbon"; }

    public override List<PropSpec> Props() {
        List<PropSpec> ps = new List<PropSpec>();
        PropSpec tab = PropSpec.Int("activeTab", "Active Tab");
        tab.num = activeTab != null ? activeTab.Get() : 0;
        tab.Also("data");
        tab.Also("value");
        ps.Add(tab);
        ps.Add(this.SizeProp());
        return ps;
    }

    public override string GetProp(string key) {
        if (key == "activeTab" || key == "data" || key == "value") {
            return Convert.ToString(activeTab != null ? activeTab.Get() : 0);
        }
        return base.GetProp(key);
    }

    public override void SetProp(string key, string val) {
        if (key == "activeTab" || key == "data" || key == "value") {
            if (activeTab != null) {
                activeTab.Set(Convert.ToInt32(val));
                this.BuildTree();
            }
            return;
        }
        base.SetProp(key, val);
    }
}
