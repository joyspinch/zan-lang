using System;
using Gui;
using Gui.Backend;
namespace Gui.Widget;
[GuiKind("Carousel")]
public class Carousel : Control {
    public override Control CreateCloneShell() { return new Carousel(); }
    public List<string> slides;
    public Binding<int> Index;
    public CarouselAnim anim;
    // 当前页变化时触发（点击、GoTo、autoplay）。
    [Event]
    public UiEvent Change;
    public bool autoplay;
    public int intervalMs;
    public string dotPlacement;
    public string direction;
    private int lastTickMs;
    private bool autoplayClockReady;
    private int autoplayDeadline;
    private int animationDeadline;
    internal AppLoopRegistration driverRegistration;
    private int prepFrom;
    private int prepTo;
    private int prepShift;
    private int prepDir;
    public CarouselChrome chrome;
    public List<Control> slideViews;
    private void InitCarousel(Binding<int> index) {
        this.InitControl("carousel");
        slides = new List<string>();
        Index = 0;
        if (index != null) { Index = index; }
        anim = null;
        wiresOwnEvents = true;
        Change = new UiEvent();
        autoplay = false;
        intervalMs = 3000;
        dotPlacement = "bottom";
        direction = "horizontal";
        slideViews = null;
        driverRegistration = null;
        lastTickMs = 0;
        autoplayClockReady = false;
        autoplayDeadline = -1;
        animationDeadline = -1;
        prepFrom = 0;
        prepTo = 0;
        prepShift = 0;
        prepDir = 1;
        chrome = null;
    }
    public Carousel() { InitCarousel(0); }
    public Carousel(Binding<int> index) { InitCarousel(index); }
    public string DirectionMode {
        get { return direction; }
        set { direction = value != null ? value : "horizontal"; }
    }
    public bool IsAutoplay {
        get { return autoplay; }
        set { autoplay = value; }
    }
    public int IntervalMs {
        get { return intervalMs; }
        set { if (value > 0) { intervalMs = value; } }
    }
    public string DotPlacement {
        get { return dotPlacement; }
        set { dotPlacement = value != null ? value : "bottom"; }
    }
    public CarouselAnim AnimState {
        get { return anim; }
        set { anim = value; }
    }
    public bool Vert() { return direction == "vertical"; }
    public void Direction(string d) { direction = d; }
    public void AddSlide(string label) {
        slides.Add(label);
        if (slideViews != null) { slideViews.Add(null); }
    }
    public void AddSlideView(Control v) {
        if (slideViews == null) { slideViews = new List<Control>(); }
        while (slideViews.Count < slides.Count) { slideViews.Add(null); }
        slides.Add("");
        slideViews.Add(v);
        this.Add(v);
        if (chrome != null) { this.MoveChild(chrome, this.ChildCount() - 1); }
    }
    public Carousel(List<string> labels, Binding<int> index) : this(index) {
        if (labels != null) {
            for (int i = 0; i < labels.Count; i = i + 1) {
                this.AddSlide(labels[i]);
            }
        }
    }
    public void Animate(CarouselAnim state) { anim = state; }
    public int CurrentIndex() { return Index.Get(); }
    public void Prev() { this.GoTo(this.App, Index.Get() - 1); }
    public void Next() { this.GoTo(this.App, Index.Get() + 1); }
    public void Prev(App app) { this.GoTo(app, Index.Get() - 1); }
    public void Next(App app) { this.GoTo(app, Index.Get() + 1); }
    public void GoTo(int i) { this.GoTo(this.App, i); }
    public void GoTo(App app, int i) {
        app = this.ResolveApp(app);
        int count = slides.Count;
        if (count == 0) { return; }
        int v = i;
        if (v < 0) { v = count - 1; }
        if (v >= count) { v = 0; }
        if (v == Index.Get()) { return; }
        Index.Set(v);
        this.UpdateTransition(app, v);
        this.PrepareDeadlines(Window.GetTickMs());
        if (driverRegistration != null) { driverRegistration.Reschedule(); }
        Change.Raise(this);
        if (app != null) {
            app.RequestRedraw();
        }
    }
    internal int TransitionMs() { return 160; }
    void UpdateTransition(App app, int cur) {
        if (anim == null || anim.animating || anim.shown == cur) { return; }
        int count = slides.Count;
        if (count == 0) { return; }
        anim.from = anim.shown;
        anim.animating = true;
        anim.startMs = Window.GetTickMs();
        if (cur == (anim.from - 1 + count) % count) { anim.dir = 0 - 1; }
        else { anim.dir = 1; }
        if (app != null) { app.RequestRedraw(); }
    }
    bool HostedBy(App app) {
        if (app == null || !app.isRunning || this.FindApp() != app) { return false; }
        if (app.rootControl != null && app.rootControl.ContainsInputControl(this)) { return true; }
        Control popup = app.overlayHost != null ? app.overlayHost.ActiveRoot() : null;
        return popup != null && popup.ContainsInputControl(this);
    }
    void PrepareDeadlines(int now) {
        if (autoplay && slides.Count > 1) {
            if (!autoplayClockReady) {
                int previous = anim != null ? anim.tickMs : lastTickMs;
                lastTickMs = previous > 0 && previous <= now ? previous : now;
                autoplayClockReady = true;
            }
            autoplayDeadline = lastTickMs + Math.Max(0, intervalMs);
        } else {
            autoplayClockReady = false;
            autoplayDeadline = -1;
        }
        animationDeadline = anim != null && anim.animating
            ? Math.Min(now + 16, anim.startMs + TransitionMs()) : -1;
    }
    void EnsureDriver(App app) {
        if (app == null || !app.isRunning) { return; }
        if (driverRegistration != null && driverRegistration.active) {
            if (driverRegistration.host == app) { return; }
            driverRegistration.Invalidate();
        }
        driverRegistration = app.RegisterLoopParticipant(this, new CarouselDriver(this));
    }
    internal void LoopTick(App app, int now) {
        if (!this.HostedBy(app)) {
            if (driverRegistration != null && driverRegistration.host == app) {
                driverRegistration.Invalidate();
            }
            return;
        }
        this.PrepareDeadlines(now);
        if (autoplayDeadline >= 0 && now >= autoplayDeadline) {
            lastTickMs = now;
            if (anim != null) { anim.tickMs = now; }
            AppLoopRegistration registration = driverRegistration;
            Control ownerParent = parent;
            this.GoTo(app, Index.Get() + 1);
            if (!this.HostedBy(app) || parent != ownerParent || driverRegistration != registration) { return; }
        }
        if (anim != null && anim.animating) {
            if (now - anim.startMs >= TransitionMs()) {
                anim.animating = false;
                anim.shown = Math.Max(0, Math.Min(slides.Count - 1, Index.Get()));
            }
            app.RequestRedraw();
        }
        this.PrepareDeadlines(now);
    }
    internal int LoopDeadline() {
        App app = driverRegistration != null ? driverRegistration.host : null;
        if (!this.HostedBy(app)) { return -1; }
        if (autoplayDeadline < 0) { return animationDeadline; }
        if (animationDeadline < 0) { return autoplayDeadline; }
        return Math.Min(autoplayDeadline, animationDeadline);
    }
    public override void Arrange(int px, int py, int pw, int ph) {
        if (pw < 0) { pw = 0; }
        if (ph < 0) { ph = 0; }
        bx = px;
        by = py;
        bw = pw;
        bh = ph;
        int count = slides.Count;
        App app = this.App;
        int oldDeadline = this.LoopDeadline();
        this.PrepareDeadlines(Window.GetTickMs());
        this.EnsureDriver(app);
        int cur = Index.Get();
        if (cur < 0) { cur = 0; }
        if (cur >= count) { cur = count - 1; }
        this.UpdateTransition(app, cur);
        prepFrom = cur;
        prepTo = cur;
        prepShift = 0;
        prepDir = 1;
        if (anim != null && anim.animating) {
            int prog = (Window.GetTickMs() - anim.startMs) * 1000 / TransitionMs();
            if (prog < 0) { prog = 0; }
            if (prog > 1000) { prog = 1000; }
            int span = this.Vert() ? bh : bw;
            prepFrom = anim.from;
            prepTo = cur;
            prepShift = span * prog / 1000;
            prepDir = anim.dir;
        }
        if (slideViews != null) { this.ShowSlides(prepFrom, prepTo, prepShift, prepDir); }
        if (chrome == null) {
            chrome = new CarouselChrome(this);
            this.Add(chrome);
        }
        chrome.Arrange(px, py, pw, ph);
        this.PrepareDeadlines(Window.GetTickMs());
        if (driverRegistration != null && oldDeadline != this.LoopDeadline()) {
            driverRegistration.Reschedule();
        }
    }
    public override void OnMeasure(App app) {
        string origClass = Class;
        if (dotPlacement == "top") { this.AddClass("dots-top"); }
        else if (dotPlacement == "left") { this.AddClass("dots-left"); }
        else if (dotPlacement == "right") { this.AddClass("dots-right"); }
        if (this.Vert()) { this.AddClass("vertical"); }
        StyleBox s = this.ResolveStyleAs(app, "carousel", Class,
                                        Style.SNormal());
        prefW = s.WidthOr(app.Scale(320));
        prefH = s.HeightOr(app.Scale(160));
        Class = origClass;
    }
    public override void OnPaint(App app) {
        Canvas c = app.canvas;
        if (slides.Count == 0) { return; }
        c.PushClip(bx, by, bw, bh);
        if (prepFrom != prepTo) {
            int outX = bx;
            int outY = by;
            int inX = bx;
            int inY = by;
            if (this.Vert()) {
                outY = by - prepDir * prepShift;
                inY = by + prepDir * (bh - prepShift);
            } else {
                outX = bx - prepDir * prepShift;
                inX = bx + prepDir * (bw - prepShift);
            }
            this.PaintSlide(app, outX, outY, prepFrom);
            this.PaintSlide(app, inX, inY, prepTo);
        } else {
            this.PaintSlide(app, bx, by, prepTo);
        }
        c.PopClip();
    }
    public void ShowSlides(int from, int to, int shift, int dir) {
        if (slideViews == null) { return; }
        int span = this.Vert() ? bh : bw;
        for (int i = 0; i < slideViews.Count; i = i + 1) {
            if (slideViews[i] == null) { continue; }
            if (i == from || i == to) {
                int x = bx;
                int y = by;
                if (from != to && i == from) {
                    if (this.Vert()) { y = by - dir * shift; }
                    else { x = bx - dir * shift; }
                } else if (from != to) {
                    if (this.Vert()) { y = by + dir * (span - shift); }
                    else { x = bx + dir * (span - shift); }
                }
                slideViews[i].Arrange(x, y, bw, bh);
                slideViews[i].SetShown(true);
            } else {
                slideViews[i].SetShown(false);
            }
        }
    }
    private void PaintSlide(App app, int x, int y, int i) {
        if (slideViews != null && i < slideViews.Count
            && slideViews[i] != null) {
            return;
        }
        Canvas c = app.canvas;
        Theme t = app.theme;
        int roleIndex = i % 5;
        string role = "primary";
        if (roleIndex == 1) { role = "info"; }
        else if (roleIndex == 2) { role = "warning"; }
        else if (roleIndex == 3) { role = "error"; }
        else if (roleIndex == 4) { role = "success"; }
        StyleBox s = this.ResolvePartAs(app, "carousel", "slide", "",
                                        Class + " " + role, Style.SNormal());
        StyleBox caption = this.ResolvePartAs(app, "carousel", "caption", "",
                                              Class, Style.SNormal());
        c.PushClip(x, y, bw, bh);
        c.FillRoundRect(x, y, bw, bh, s.RadiusOr(t.borderRadiusLarge), s.BgOr(0));
        int fs = caption.FontOr(
            s.FontOr(Style.FontFallback(app, "huge")));
        int tw = Canvas.MeasureText(slides[i], fs);
        c.DrawText(x + (bw - tw) / 2, y + Canvas.CenterTextY(0, bh, fs),
                   slides[i], caption.FgOr(0), fs);
        c.PopClip();
    }
    // ---- 设计器 / 序列化模型 ----

    // 幻灯片标题（逗号分隔；设计器 / HTML 的 `slides`）。
    public string SlidesText() { return string.Join(",", slides); }
    public void SetSlidesText(string val) { slides = val.Split(","); }

    // 覆写：返回设计器属性清单（slides/index/autoplay/interval/
    // dotPlacement/direction）。
    protected override List<PropSpec> DefineProps() {
        List<PropSpec> ps = new List<PropSpec>();
        ps.Add(PropSpec.Text("slides", "Slide labels (comma separated)").Accessor("SlidesText", "SetSlidesText"));
        PropSpec idx = PropSpec.Int("index", "Active slide");
        // 属性通道优先指向活的外部绑定（§6.1 单协议）。
        idx.Field("Index");
        ps.Add(idx);
        ps.Add(PropSpec.Bool("autoplay", "Autoplay")
            .Field("autoplay")
            .WithTip("Auto-advance every intervalMs (Naive UI autoplay)."));
        ps.Add(PropSpec.Int("interval", "Interval (ms)").Field("intervalMs").Step(100, 500, 60000));
        PropSpec dp = PropSpec.Enum("dotPlacement", "Dot placement",
            new List<string>{ "bottom", "top", "left", "right" });
        dp.Field("dotPlacement");
        ps.Add(dp);
        PropSpec dr = PropSpec.Enum("direction", "Direction",
            new List<string>{ "horizontal", "vertical" });
        dr.Field("direction");
        ps.Add(dr);
        return ps;
    }
}
