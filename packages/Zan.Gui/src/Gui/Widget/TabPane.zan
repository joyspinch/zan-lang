using System;
using Gui;

namespace Gui.Widget;

// TabPane: 标签页面板 DOM 容器组件，用于承载标签页内部任意组件。
public class TabPane : Control {
    string label;
    string key;
    string icon;
    bool closable;
    bool disabled;

    TabPane() {
        this.InitControl("tab-pane", 1);
        label = "";
        key = "";
        icon = "";
        closable = false;
        disabled = false;
    }

    TabPane(string lbl) {
        this.InitControl("tab-pane", 1);
        label = lbl != null ? lbl : "";
        key = "";
        icon = "";
        closable = false;
        disabled = false;
    }

    TabPane(string lbl, Control content) {
        this.InitControl("tab-pane", 1);
        label = lbl != null ? lbl : "";
        key = "";
        icon = "";
        closable = false;
        disabled = false;
        if (content != null) {
            this.Add(content);
        }
    }

    void SetLabel(string l) { label = l != null ? l : ""; }
    string Label() { return label; }

    void SetKey(string k) { key = k != null ? k : ""; }
    string Key() { return key; }

    void SetIcon(string ic) { icon = ic != null ? ic : ""; }
    string Icon() { return icon; }

    void SetClosable(bool c) { closable = c; }
    bool IsClosable() { return closable; }

    void SetDisabled(bool d) { disabled = d; }
    bool IsDisabled() { return disabled; }

    override string Kind() { return "TabPane"; }

    override void OnMeasure(App app) {
        int maxW = 0;
        int totalH = 0;
        for (int i = 0; i < children.Count; i = i + 1) {
            Control c = children[i];
            c.OnMeasure(app);
            if (c.prefW > maxW) { maxW = c.prefW; }
            totalH = totalH + c.prefH;
        }
        prefW = maxW;
        prefH = totalH;
    }

    override void OnPaint(App app) {
        if (bw <= 0 || bh <= 0) { return; }
        // 按流式排布并渲染内部子组件
        int cy = by;
        for (int i = 0; i < children.Count; i = i + 1) {
            Control c = children[i];
            int ch = c.prefH > 0 ? c.prefH : bh;
            c.Arrange(bx, cy, bw, ch);
            c.RenderTree(app);
            cy = cy + ch;
        }
    }
}
