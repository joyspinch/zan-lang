using System;
using Gui;

namespace Gui.Widget;

// 标签页面板（TabPane）：纯声明式 Flex 容器，承载单个标签页内的子节点。
public class TabPane : Control {
    public string label;
    public string key;
    public string icon;
    public bool closable;
    public bool disabled;

    public override int StyleDisplay() { return 1; } // Flex
    public override int StyleFlexDir() { return 1; } // Column

    public TabPane() {
        this.InitControl("tab-pane", 1);
        this.ClassName = "tab-pane col flex-1";
        label = "";
        key = "";
        icon = "";
        closable = false;
        disabled = false;
    }

    public TabPane(string lbl) {
        this.InitControl("tab-pane", 1);
        this.ClassName = "tab-pane col flex-1";
        label = lbl != null ? lbl : "";
        key = "";
        icon = "";
        closable = false;
        disabled = false;
    }

    public TabPane(string lbl, Control content) {
        this.InitControl("tab-pane", 1);
        this.ClassName = "tab-pane col flex-1";
        label = lbl != null ? lbl : "";
        key = "";
        icon = "";
        closable = false;
        disabled = false;
        if (content != null) {
            this.Add(content);
        }
    }

    public void SetLabel(string l) { label = l != null ? l : ""; }
    public string Label() { return label; }

    public void SetKey(string k) { key = k != null ? k : ""; }
    public string Key() { return key; }

    public void SetIcon(string ic) { icon = ic != null ? ic : ""; }
    public string Icon() { return icon; }

    public void SetClosable(bool c) { closable = c; }
    public bool IsClosable() { return closable; }

    public void SetDisabled(bool d) { disabled = d; }
    public bool IsDisabled() { return disabled; }

    public override string Kind() { return "TabPane"; }
}
