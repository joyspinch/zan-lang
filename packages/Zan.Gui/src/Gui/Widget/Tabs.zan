using System;
using System.Collections.Generic;
using Gui;

namespace Gui.Widget;

// 标签页（Tabs）：标准声明式对象树与 CSS 盒模型（Flex 排布）。
// 组合导航标签条与内容页容器，彻底物理删除所有画布微绘与坐标手算。
public partial class Tabs : Control {
    public List<TabItem> tabs;
    public int active;
    public Binding<int> data;
    public int style;
    public int orient; // 0 = Horizontal, 1 = Vertical
    public bool showAdd;
    public bool closableAll;
    public Binding<string> Size;
    public bool hostModel;
    public int ctxIndex;
    public List<Panel> pages;
    public string itemsSpec;
    public Control extraSlot;

    public int changedIndex;
    public int closedIndex;
    public int addedIndex;
    public List<int> closedQueue;

    public Control navStrip;
    public Control contentBox;

    public UiEvent TabChanged;
    public UiEvent TabClosed;
    public UiEvent TabAdded;

    public static int Line() { return 0; }
    public static int Card() { return 1; }
    public static int Segment() { return 2; }
    public static int Horizontal() { return 0; }
    public static int Vertical() { return 1; }

    public static Tabs CreateVertical(int style) {
        return new Tabs(style, 1);
    }

    public Tabs() : this(0, 0) { }
    public Tabs(int style) : this(style, 0) { }

    public Tabs(int style, int orient) {
        this.InitControl("tabs", 1);
        this.tabs = new List<TabItem>();
        this.active = 0;
        this.style = style;
        this.orient = orient;
        this.showAdd = false;
        this.closableAll = false;
        this.Size = "medium";
        this.hostModel = false;
        this.ctxIndex = 0 - 1;
        this.pages = new List<Panel>();
        this.itemsSpec = "";
        this.changedIndex = 0 - 1;
        this.closedIndex = 0 - 1;
        this.addedIndex = 0 - 1;
        this.closedQueue = new List<int>();
        this.TabChanged = new UiEvent();
        this.TabClosed = new UiEvent();
        this.TabAdded = new UiEvent();
        this.wiresOwnEvents = true;

        this.ClassName = "tabs " + (orient == 1 ? "row" : "col");
        this.BuildTree();
    }

    public override int StyleDisplay() { return 1; } // Flex
    public override int StyleFlexDir() { return orient == 1 ? 0 : 1; }

    public void SetShowAdd(bool on) {
        showAdd = on;
        this.BuildTree();
    }

    public void SetHostModel(bool on) { hostModel = on; }

    public int Active() { return active; }

    public void Select(int idx) {
        if (idx != active && idx >= 0 && (tabs.Count == 0 || idx < tabs.Count)) {
            active = idx;
            changedIndex = idx;
            if (data != null) { data.Set(idx); }
            TabChanged.RaiseS(this);
            this.BuildTree();
        }
    }

    public void SetActive(int idx) {
        this.Select(idx);
    }

    public int Count() { return tabs.Count; }

    public void Clear() {
        tabs.Clear();
        pages.Clear();
        active = 0;
        this.BuildTree();
    }

    public Tabs Add(string label) {
        return this.Add(label, closableAll);
    }

    public Tabs Add(string label, bool closable) {
        tabs.Add(new TabItem(label, closable));
        if (active < 0) { active = 0; }
        this.BuildTree();
        return this;
    }

    public Tabs Add(TabItem item) {
        if (item != null) {
            tabs.Add(item);
            if (active < 0) { active = 0; }
            this.BuildTree();
        }
        return this;
    }

    public Tabs AddPane(TabPane pane) {
        if (pane != null) {
            tabs.Add(new TabItem(pane.Label(), pane.IsClosable()));
            this.With(pane);
            if (active < 0) { active = 0; }
            this.BuildTree();
        }
        return this;
    }

    public void CloseTab(int idx) {
        if (idx < 0 || idx >= tabs.Count) { return; }
        closedIndex = idx;
        closedQueue.Add(idx);
        TabClosed.RaiseS(this);
        if (!hostModel) {
            tabs.RemoveAt(idx);
            if (idx < pages.Count) { this.DropPage(idx); }
            if (active >= tabs.Count) { active = tabs.Count - 1; }
            this.BuildTree();
        }
    }

    public void TriggerAdd() {
        addedIndex = tabs.Count;
        TabAdded.RaiseS(this);
    }

    public int TakeChanged() {
        int c = changedIndex;
        changedIndex = 0 - 1;
        return c;
    }

    public int TakeClosed() {
        if (closedQueue.Count > 0) {
            int last = closedQueue[closedQueue.Count - 1];
            closedQueue.RemoveAt(closedQueue.Count - 1);
            return last;
        }
        int c = closedIndex;
        closedIndex = 0 - 1;
        return c;
    }

    public int TakeAdded() {
        int a = addedIndex;
        addedIndex = 0 - 1;
        return a;
    }

    public int TakeContext() {
        int c = ctxIndex;
        ctxIndex = 0 - 1;
        return c;
    }

    public int HeaderHeight(App app) {
        return app != null ? app.theme.heightMedium : 32;
    }

    public void Extra(Control extra) {
        extraSlot = extra;
        this.BuildTree();
    }

    public Panel Page(int i) {
        int want = i;
        if (want < 0) { want = 0; }
        while (pages.Count <= want) {
            Panel p = Panel.Root("page" + Convert.ToString(pages.Count));
            p.Pad(0);
            pages.Add(p);
            this.With(p);
        }
        return pages[want];
    }

    public int PageCount() { return pages.Count; }

    public void DropPage(int i) {
        if (i < 0 || i >= pages.Count) { return; }
        List<Panel> keep = new List<Panel>();
        for (int k = 0; k < pages.Count; k = k + 1) {
            if (k == i) { this.Remove(pages[k]); }
            else { keep.Add(pages[k]); }
        }
        pages = keep;
    }

    public void BuildTree() {
        this.children.Clear();

        // 1. 导航条容器
        navStrip = new Control();
        string orientClass = (orient == 1) ? "col tabs-nav-vertical" : "row tabs-nav-horizontal align-center";
        string styleClass = (style == 1) ? "card" : (style == 2 ? "segment" : "line");
        navStrip.ClassName = "tabs-nav " + orientClass + " " + styleClass;

        for (int i = 0; i < tabs.Count; i = i + 1) {
            int tidx = i;
            TabItem item = tabs[i];
            bool isActive = (i == active);

            Button tabBtn = new Button("");
            tabBtn.ClassName = "tab-item row align-center " + (isActive ? "active" : "") + " " + styleClass;

            if (item.headerSlot != null) {
                tabBtn.Add(item.headerSlot);
            }

            Label lbl = new Label(item.label);
            lbl.ClassName = "tab-item-title";
            tabBtn.Add(lbl);

            if (item.closable || closableAll) {
                Button closeBtn = new Button("×");
                closeBtn.ClassName = "tab-item-close ghost tiny";
                closeBtn.Click.Add(() => {
                    this.CloseTab(tidx);
                });
                tabBtn.Add(closeBtn);
            }

            tabBtn.Click.Add(() => {
                this.Select(tidx);
            });

            navStrip.Add(tabBtn);
        }

        if (showAdd) {
            Button addBtn = new Button("+");
            addBtn.ClassName = "tab-add-btn ghost small";
            addBtn.Click.Add(() => {
                this.TriggerAdd();
            });
            navStrip.Add(addBtn);
        }

        if (extraSlot != null) {
            navStrip.Add(extraSlot);
        }

        this.Add(navStrip);

        // 2. 内容面板容器
        contentBox = new Control();
        contentBox.ClassName = "tabs-content col flex-1";

        for (int pi = 0; pi < pages.Count; pi = pi + 1) {
            pages[pi].Visible = (pi == active);
            contentBox.Add(pages[pi]);
        }

        this.Add(contentBox);
    }

    public override void SyncBinding() {
        base.SyncBinding();
        if (data != null) {
            int cur = data.Get();
            if (cur != active && cur >= 0 && (tabs.Count == 0 || cur < tabs.Count)) {
                this.Select(cur);
            }
        }
    }

    public override void OnPaint(App app) {
        int id = this.CommonId();
        SyncBinding();
        app.focus.RegisterFocusable(id);
        app.hitTester.RegisterRect(id, bx, by, bw, bh, 0);
        On.Fire(app, id, this);
    }

    public override string Kind() { return "Tabs"; }
    public override Binding<string> SizeOf() { return Size; }

    public override List<PropSpec> Props() {
        List<PropSpec> ps = new List<PropSpec>();
        PropSpec act = PropSpec.Int("active", "Active");
        act.num = data;
        act.Also("data");
        act.Also("value");
        ps.Add(act);
        ps.Add(this.SizeProp());
        return ps;
    }

    public override string GetProp(string key) {
        if (key == "active" || key == "data" || key == "value") {
            return Convert.ToString(active);
        }
        return base.GetProp(key);
    }

    public override void SetProp(string key, string val) {
        if (key == "active" || key == "data" || key == "value") {
            this.Select(Convert.ToInt32(val));
            return;
        }
        base.SetProp(key, val);
    }
}
