using System;
using Gui;
using Gui.Backend;
namespace Gui.Widget;
public class RichMenuRow : Control {
    public weak RichMenuPanel panel;
    public MenuItem item;
    public int index;
    int session;
    public RichMenuRow(RichMenuPanel parentPanel, MenuItem model, int row, int generation) {
        this.InitControl("contextmenu");
        this.wiresOwnEvents = true;
        this.WithMinTouchSize(0);
        panel = parentPanel;
        item = model;
        index = row;
        session = generation;
    }
    public override string StyleType() { return "contextmenu"; }
    public override void OnPointerEnter(RoutedEventArgs e) {
        base.OnPointerEnter(e);
        RichMenuPanel parentPanel = panel;
        RichMenu menu = parentPanel != null ? parentPanel.owner : null;
        if (parentPanel == null || menu == null) { return; }
        menu.EnterPanel(parentPanel.level);
        menu.Hover(parentPanel, index, session);
        App app = this.FindApp();
        if (app != null) { app.RequestRedraw(); }
    }
    public override void OnPointerLeave(RoutedEventArgs e) {
        base.OnPointerLeave(e);
        RichMenuPanel parentPanel = panel;
        RichMenu menu = parentPanel != null ? parentPanel.owner : null;
        if (parentPanel != null && menu != null) { menu.LeaveRow(parentPanel.level, index); }
        App app = this.FindApp();
        if (app != null) { app.RequestRedraw(); }
    }
    public override void OnClick(RoutedEventArgs e) {
        e.Handle();
        if (this.IsDisabled() || item == null || item.disabled || item.kind == 1 || item.kind == 2) { return; }
        RichMenuPanel parentPanel = panel;
        RichMenu menu = parentPanel != null ? parentPanel.owner : null;
        if (parentPanel != null && menu != null) { menu.Activate(this, parentPanel, index, session); }
    }
    public override void OnPaint(App app) {
        if (app == null || app.canvas == null || item == null) { return; }
        Canvas canvas = app.canvas;
        int pad = RichMenu.PadH(app);
        if (item.kind == 1) {
            StyleBox separator = this.ResolvePart(app, "separator", "contextmenu", Style.SNormal());
            canvas.FillRect(bx + pad, by + bh / 2, bw - pad * 2, 1, separator.BgOr(0));
            return;
        }
        int font = Style.FontFallback(app, "small");
        int ty = Canvas.CenterTextY(by, bh, font);
        string lbl = item.label != null ? item.label : "";
        if (item.kind == 2) {
            StyleBox header = this.ResolvePart(app, "header", "contextmenu", Style.SNormal());
            int avail = bw - pad * 2;
            if (avail > 0) {
                string fitHdr = Ellipsis.Fit(lbl, avail, font);
                canvas.PushClip(bx + pad, by, avail, bh);
                try { canvas.DrawText(bx + pad, ty, fitHdr, header.FgOr(0), font); }
                finally { canvas.PopClip(); }
            }
            return;
        }
        RichMenuPanel parentPanel = panel;
        RichMenu ownerMenu = parentPanel != null ? parentPanel.owner : null;
        bool activeSub = parentPanel != null && ownerMenu != null && ownerMenu.IsSubOpen(parentPanel.level, index);
        bool lit = !item.disabled && (isHovered || activeSub);
        int state = item.disabled ? Style.SDisabled() : (lit ? Style.SHover() : Style.SNormal());
        string cls = item.danger && !item.disabled ? "danger" : "";
        StyleBox row = this.ResolvePartAs(app, "contextmenu", "item", "contextmenu", cls, state);
        StyleBox menu = this.Box(app);
        int fg = row.FgOr(item.danger ? app.theme.error : 0);
        if (lit) {
            int insetX = RichMenu.PadV(app);
            int insetY = app.Scale(1);
            int outerR = menu != null ? menu.RadiusOr(0) : 0;
            int innerR = 0;
            if (outerR > 0) {
                innerR = outerR - insetX;
                if (innerR < app.Scale(4)) { innerR = app.Scale(4); }
                if (innerR > outerR) { innerR = outerR; }
            }
            int hlW = bw - insetX * 2;
            int hlH = bh - insetY * 2;
            if (hlW > 0 && hlH > 0) {
                canvas.FillRoundRect(bx + insetX, by + insetY, hlW, hlH, innerR, row.BgOr(0));
            }
        }
        int icon = app.theme.iconSizeSmall;
        if (item.swatch != 0) {
            int side = icon - 2;
            if (side < 8) { side = 8; }
            int x = bx + pad + 1;
            int y = by + (bh - side) / 2;
            int radius = app.Scale(3);
            if (radius < 2) { radius = 2; }
            canvas.FillRoundRect(x, y, side, side, radius, item.swatch);
            if (item.swatch2 != 0 && item.swatch2 != item.swatch) {
                canvas.PushClip(x + side / 2, y, side - side / 2, side);
                try { canvas.FillRoundRect(x, y, side, side, radius, item.swatch2); }
                finally { canvas.PopClip(); }
            }
            canvas.DrawRoundRect(x, y, side, side, radius, menu.BorderOr(0), 1);
            if (item.icon != null && item.icon != "") {
                canvas.DrawGlyphIn(item.icon, x, y, side, side, side - 2, ColorMath.ContrastFg(item.swatch));
            }
        } else if (item.icon != null && item.icon != "") {
            canvas.DrawGlyphIn(item.icon, bx + pad, by, icon, bh, icon, fg);
        }
        int gap = app.Scale(8);
        int lblX = bx + pad + icon + gap;
        int rightReserve = pad;
        int scWidth = 0;
        if (item.kind == 3) {
            rightReserve = pad + icon + gap;
        } else if (item.shortcut != null && item.shortcut != "") {
            scWidth = Canvas.MeasureText(item.shortcut, font);
            rightReserve = pad + scWidth + gap;
        }
        int lblAvail = (bx + bw - rightReserve) - lblX;
        if (lblAvail > 0 && lbl != "") {
            string fitLbl = Ellipsis.Fit(lbl, lblAvail, font);
            canvas.PushClip(lblX, by, lblAvail, bh);
            try { canvas.DrawText(lblX, ty, fitLbl, fg, font); }
            finally { canvas.PopClip(); }
        }
        if (item.kind == 3) {
            canvas.DrawGlyphIn("chevron-right", bx + bw - pad - icon, by, icon, bh, icon, fg);
        } else if (item.shortcut != null && item.shortcut != "") {
            StyleBox accel = this.ResolvePart(app, "accel", "contextmenu", Style.SNormal());
            int scX = bx + bw - pad - scWidth;
            if (scX < bx + pad) { scX = bx + pad; }
            int scAvail = bx + bw - pad - scX;
            if (scAvail > 0) {
                canvas.PushClip(scX, by, scAvail, bh);
                try { canvas.DrawText(scX, ty, Ellipsis.Fit(item.shortcut, scAvail, font), accel.FgOr(0), font); }
                finally { canvas.PopClip(); }
            }
        }
    }
}
