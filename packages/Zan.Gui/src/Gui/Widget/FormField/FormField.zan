    public void InitField(int ft) {
        this.InitControl("field");
        ftype = ft;
        kind = FormField.KindForType(ft);
        label = FormField.DefaultLabel(ft);
        fname = "field";
        placeholder = FormField.DefaultPlaceholder(ft);
        required = false;
        disabled = false;
        visible = true;
        tooltipText = "";
        defOn = false;
        wrap = false;
        span = 24;
        fx = 0;
        fy = 0;
        fw = 200;
        fh = FormField.DefaultHFor(ft);
        layoutX = 0;
        layoutY = 0;
        layoutW = 0;
        layoutH = 0;
        layoutReady = false;
        altRects = "";
        locked = false;
        dockSide = 0;
        margin = 0;
        padding = 0;
        gap = 0;
        flexDir = 0;
        justify = 0;
        alignItems = 0;
        flexWrap = false;
        styleText = "";
        customKind = "";
        compRef = false;
        pvPreview = true;
        options = new List<string>();
        kids = new List<FormField>();
        childTab = 0;
        tabOrient = 0;
        uiState = 0;
        extra = null;
        SeedOptions(ft);
    }
