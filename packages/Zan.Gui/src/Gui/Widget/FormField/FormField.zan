    static string PipeSlot(string table, int index, string fallback) {
        if (index < 0) { return fallback; }
        int slot = 0;
        int start = 0;
        for (int i = 0; i <= table.Length; i = i + 1) {
            if (i == table.Length || (table[i] & 255) == 124) {
                if (slot == index) { return table.Substring(start, i - start); }
                slot = slot + 1;
                start = i + 1;
            }
        }
        return fallback;
    }

