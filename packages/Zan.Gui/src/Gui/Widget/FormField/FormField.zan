    public static List<string> SemanticEventsOf(int ft) {
        List<string> e = new List<string>();
        if (ft == 0 || ft == 2 || ft == 3) { e.Add("Change"); e.Add("Submit"); }
        else if (ft == 1 || ft == 4 || ft == 8 || (ft >= 10 && ft <= 14) || ft == 26 || ft == 34 || ft == 37 || ft == 42 || ft == 60) { e.Add("Change"); }
        else if (ft == 5 || ft == 7) { e.Add("Change"); e.Add("Toggle"); }
        else if (ft == 6) { e.Add("Change"); e.Add("SelectionChanged"); }
        else if (ft == 9) { e.Add("Change"); e.Add("DragEnd"); }
        else if (ft == 19 || ft == 52) { e.Add("Click"); e.Add("Close"); }
        else if (ft == 21 || ft == 22 || ft == 49 || ft == 54) { e.Add("Click"); }
        else if (ft == 23 || ft == 41) {
            e.Add("RowClick"); e.Add("RowContext"); e.Add("RowDoubleClick");
            e.Add("CellClick"); e.Add("CellEdit"); e.Add("SelectionChanged");
            e.Add("HeaderClick"); e.Add("Sort"); e.Add("FilterChanged");
            e.Add("ColumnResize"); e.Add("ColumnResizeEnd"); e.Add("ScrollChanged");
        } else if (ft == 25) { e.Add("Expand"); e.Add("Collapse"); e.Add("Select"); }
        else if (ft == 36) { e.Add("TabChanged"); e.Add("TabClosed"); }
        else if (ft == 39) { e.Add("Back"); }
        else if (ft == 40) { e.Add("Select"); e.Add("Activate"); e.Add("Context"); }
        else if (ft == 43) { e.Add("PointClick"); e.Add("LegendClick"); }
        else if (ft == 48) { e.Add("Change"); e.Add("Opened"); e.Add("Closed"); }
        else if (ft == 50) { e.Add("Show"); e.Add("Hide"); }
        else if (ft == 51) { e.Add("Confirm"); e.Add("Cancel"); }
        else if (ft == 56) { e.Add("Open"); e.Add("Close"); }
        else if (ft == 57) { e.Add("Tick"); }
        else if (ft == 58) { e.Add("ItemClick"); }
        else if (ft == 67) { e.Add("Ack"); }
        else if (ft == 68) { e.Add("RowClick"); }
        else if (ft == 69) { e.Add("Enter"); e.Add("Cancel"); }
        else if (ft == 72) { e.Add("NavStart"); e.Add("NavComplete"); e.Add("TitleChanged"); e.Add("LoadingChanged"); }
        return e;
    }
    public override List<string> Events() {
        List<string> e = Control.CommonEvents();
        List<string> sem = FormField.SemanticEventsOf(ftype);
        for (int i = 0; i < sem.Count; i = i + 1) {
            if (!e.Contains(sem[i])) { e.Add(sem[i]); }
        }
        return e;
    }
