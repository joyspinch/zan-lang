    protected override List<PropSpec> DefineProps() {
        List<PropSpec> ps = new List<PropSpec>();
        ps.Add(PropSpec.Text("label", "Label").Field("label"));
        ps.Add(PropSpec.Text("fname", "Name").Field("fname").Setter("SetFieldName"));
        string phLabel = ftype == 72 ? "Start URL" : "Placeholder";
        ps.Add(PropSpec.Text("placeholder", phLabel).Field("placeholder"));
        ps.Add(PropSpec.Bool("required", "Required").Field("required"));
        if (ftype == 15 || ftype == 16) { ps.Add(PropSpec.Bool("wrap", "Wrap").Field("wrap")); }
        ps.Add(PropSpec.Bool("defOn", "Default on").Field("defOn"));
        ps.Add(PropSpec.Int("span", "Span").Field("span"));
        PropSpec pos = PropSpec.Enum("position", "Position", new List<string>());
        pos.Option("flow"); pos.Option("float");
        pos.Field("position");
        ps.Add(pos);
        PropSpec anc = PropSpec.Enum("anchor", "Anchor", new List<string>());
        anc.Option("none"); anc.Option("topLeft"); anc.Option("topCenter");
        anc.Option("topRight"); anc.Option("centerLeft"); anc.Option("center");
        anc.Option("centerRight"); anc.Option("bottomLeft"); anc.Option("bottomCenter");
        anc.Option("bottomRight"); anc.Option("stretch");
        anc.Field("anchor");
        ps.Add(anc);
        ps.Add(PropSpec.Int("flexGrow", "Flex Grow").Field("flexGrow"));
        if (this.IsCustom()) { ps.Add(PropSpec.Text("customKind", "Component").Field("customKind")); }
        ps.Add(PropSpec.Text("options", "Options").Accessor("JoinOptions", "SetOptionsFrom"));
        return ps;
    }
}
