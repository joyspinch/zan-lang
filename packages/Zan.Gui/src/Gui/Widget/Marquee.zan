using System;
using Gui;
using Gui.Backend;
namespace Gui.Widget;
public class Marquee : Control {
    public override Control CreateCloneShell() { return new Marquee(); }
    public Binding<string> Text;
    public int speed;
    public bool autoFill;
    private int phase;
    private int lastMs;
    public MarqueeAnim anim;
    private void InitMarquee(string txt) {
        this.InitControl("marquee");
        Text = txt;
        speed = 48;
        autoFill = false;
        phase = 0;
        lastMs = 0;
        anim = null;
    }
    public Marquee() { InitMarquee(""); }
    public Marquee(string txt) { InitMarquee(txt); }
    public string Str() {
        if (Text == null) { return ""; }
        return Text.Get();
    }
    public int ScrollSpeed {
        get { return speed; }
        set { if (value > 0) { speed = value; } }
    }
    public bool IsAutoFill {
        get { return autoFill; }
        set { autoFill = value; }
    }
    public MarqueeAnim AnimState {
        get { return anim; }
        set { anim = value; }
    }
    public void Speed(int pxPerSec) {
        if (pxPerSec > 0) { speed = pxPerSec; }
    }
    public void AutoFill(bool v) { autoFill = v; }
    public void Animate(MarqueeAnim state) { anim = state; }
    public StyleBox ResolvedStyle() { return this.ResolvedStyle(this.App); }
    public StyleBox ResolvedStyle(App app) {
        app = this.ResolveApp(app);
        return this.ResolveStyleCached(app, "marquee", Class, Style.SNormal());
    }
    public override void OnMeasure(App app) {
        StyleBox s = this.ResolvedStyle(app);
        int fs = s.FontOr(Style.FontFallback(app, "medium"));
        prefH = s.HeightOr(Canvas.FontHeight(fs) + app.theme.gapSmall);
        prefW = s.WidthOr(Canvas.MeasureText(this.Str(), fs));
    }
    public override void OnPaint(App app) {
        StyleBox s = this.ResolvedStyle(app);
        int fs = s.FontOr(Style.FontFallback(app, "medium"));
        string txt = this.Str();
        int cw = Canvas.MeasureText(txt, fs);
        if (cw <= 0 || bw <= 0 || bh <= 0) { return; }
        int gap = s.GapOr(app.theme.gapMedium);
        if (gap < 0) { gap = 0; }
        int fillStep = cw + gap;
        if (fillStep <= 0) { return; }
        bool reduced = app.reducedMotion;
        int ph = phase;
        int last = lastMs;
        if (anim != null) { ph = anim.phase; last = anim.lastMs; }
        if (!reduced) {
            int now = Window.GetTickMs();
            if (last == 0) { last = now; }
            int delta = now - last;
            last = now;
            if (delta > 0 && delta < 1000) { ph = ph + delta * speed / 1000; }
        } else {
            ph = 0;
            last = 0;
        }
        int loop = bw;
        int drawStep = bw;
        if (autoFill) {
            loop = (bw + fillStep - 1) / fillStep * fillStep;
            drawStep = fillStep;
        } else if (fillStep > loop) {
            loop = fillStep;
        }
        if (loop <= 0) { loop = 1; }
        if (drawStep <= 0) { drawStep = 1; }
        ph = ph % loop;
        if (anim != null) { anim.phase = ph; anim.lastMs = last; }
        else { phase = ph; lastMs = last; }
        Canvas c = app.canvas;
        int ty = Canvas.CenterTextY(by, bh, fs);
        int fg = s.FgOr(0);
        c.PushClip(bx, by, bw, bh);
        int k = 0;
        while (k * drawStep < bw + ph) {
            c.DrawText(bx - ph + k * drawStep, ty, txt, fg, fs);
            k = k + 1;
        }
        c.PopClip();
        if (!reduced) { app.RequestRedraw(); }
    }

    // ---- 设计器 / 序列化模型 ----

    // 覆写：返回设计器属性清单（text/speed/autoFill）。
    protected override List<PropSpec> DefineProps() {
        List<PropSpec> ps = new List<PropSpec>();
        PropSpec text = PropSpec.Text("text", "Text");
        text.Field("Text");
        ps.Add(text);
        ps.Add(PropSpec.Int("speed", "Speed (px/s)")
            .Field("speed")
            .Step(8, 1, 1000)
            .WithTip("Scroll speed in pixels per second (Naive UI speed, default 48)."));
        ps.Add(PropSpec.Bool("autoFill", "Auto fill")
            .Field("autoFill")
            .WithTip("Repeat the content to fill the width, so short text loops without a blank gap."));
        return ps;
    }
}
