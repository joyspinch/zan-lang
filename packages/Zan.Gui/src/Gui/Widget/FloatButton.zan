using System;
using System.Collections.Generic;
using Gui;

namespace Gui.Widget;

// 浮动按钮（FloatButton）：圆形快捷操作按钮。
// 遵循保留模式与声明式对象树，外观由 .float-button CSS 盒模型渲染。
public class FloatButton : Control {
    public Binding<string> Icon;
    public Binding<int> Size;
    private IconView iconNode;

    public override int StyleDisplay() { return 1; } // Flex
    public override int StyleFlexDir() { return 0; } // Row

    private void InitFloatButton(string icon) {
        this.InitControl("floatbutton", 1);
        this.ClassName = "float-button align-center justify-center";
        Icon = icon;
        Size = 0;
        wiresOwnEvents = true;
        iconNode = new IconView(icon != "" ? icon : "up", 20);
        this.Add(iconNode);
    }

    public FloatButton() { InitFloatButton(""); }
    public FloatButton(string icon) { InitFloatButton(icon); }

    public int Diameter(App app) {
        int s = Size != null ? Size.Get() : 0;
        if (s > 0) { return s; }
        return app != null ? app.theme.heightLarge : 40;
    }

    public override void OnMeasure(App app) {
        int d = this.Diameter(app);
        prefW = d;
        prefH = d;
    }

    public override void SyncBinding() {
        base.SyncBinding();
        if (iconNode != null && Icon != null) {
            string ic = Icon.Get();
            if (ic != iconNode.Icon) {
                iconNode.Icon = ic;
            }
        }
    }

    public override void OnClick(RoutedEventArgs e) {
        if (this.IsDisabled()) { return; }
        Click.RaiseS(this);
        App a = this.FindApp();
        if (a != null) { a.RequestRedraw(); }
        e.Handle();
    }

    public override void OnPaint(App app) {
        int id = this.CommonId();
        SyncBinding();
        app.focus.RegisterFocusable(id);
        app.hitTester.RegisterRect(id, bx, by, bw, bh, 0);
        On.Fire(app, id, this);
    }

    public override string Kind() { return "FloatButton"; }

    public override List<PropSpec> Props() {
        List<PropSpec> ps = new List<PropSpec>();
        PropSpec ico = PropSpec.Text("icon", "Icon");
        ico.str = Icon;
        ps.Add(ico);
        PropSpec sz = PropSpec.Int("size", "Diameter");
        sz.num = Size;
        ps.Add(sz);
        return ps;
    }

    public override List<string> Events() {
        List<string> e = Control.CommonEvents();
        e.Add("Click");
        return e;
    }

    public override void BindEvent(string evt, Action a) {
        if (evt == "Click") { Click.Add(a); return; }
        On.AddByName(evt, a);
    }

    public override void BindEventS(string evt, ControlEvent a) {
        if (evt == "Click") { Click.AddS(a); return; }
        On.AddByNameS(evt, a);
    }
}
