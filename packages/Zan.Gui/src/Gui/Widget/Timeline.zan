using System;
using Gui;

namespace Gui.Widget;

// 时间线：每个条目一个圆点（或图标）和连接线，旁边是
// 时间 / 标题 / 描述块。圆点、连接线和三行文本都是
// 样式部件（`timeline::dot`、`::line`、`::time`、`::title`、`::desc`），
// 皮肤可重设样式，代码侧只需简单赋值。
// 形态全部走 class/字段，与 Steps 同一套词汇：
// - `Class = "large"` / `Size = "large"`：大小档（medium 默认）。
// - `Class = "right"`：轴线镜像到右侧，文字右对齐。
// - `Class = "horizontal"`：轴线横贯顶部，每条目占一列。
// - 条目 `icon`：圆点换成图标；条目 `pending`：空心圈 + 虚线尾。
public class Timeline : Control {
    // 已添加的条目（AddItem/Add 追加）。
    public List<TimelineItem> items;
    // 尺寸档（small/medium/large），双向可绑定。
    public Binding<string> Size;

    // 初始化：以 "timeline" 注册，置空条目表与中档尺寸。
    private void InitTimeline() {
        this.InitControl("timeline", 1);
        items = new List<TimelineItem>();
        Size = "medium";
    }

    // 空时间线（之后 AddItem/Add）。
    public Timeline() { InitTimeline(); }

    // 追加一个已构建的条目（覆写 Control.Add，保持 ABI 与多态一致）。
    public override Control Add(Control c) {
        if (c is TimelineItem) {
            items.Add((TimelineItem)c);
        }
        return base.Add(c);
    }

    // 基于已构建的条目列表创建时间线。
    public static Timeline Of(List<TimelineItem> its) {
        Timeline tl = new Timeline();
        for (int i = 0; i < its.Count; i = i + 1) { tl.Add(its[i]); }
        return tl;
    }

    // 追加一个默认样式条目（时间 / 标题 / 描述）。
    public void AddItem(string time, string title, string desc) {
        items.Add(new TimelineItem(time, title, desc, "", ""));
    }

    // 带语义类与图标的入口（对齐 Steps 的 AddStepIcon 命名）。
    public void AddItemIcon(string time, string title, string desc,
                            string cls, string icon) {
        items.Add(new TimelineItem(time, title, desc, cls, icon));
    }

    // 条目数（测量与测试用）。
    public int Count() { return items.Count; }

    // 当前形态是否为横排（Class 含 "horizontal"）。
    public bool IsHorizontal() { return Style.Has(Class, "horizontal"); }

    // 轴线是否镜像在右侧（Class 含 "right"）。
    public bool IsRight() { return Style.Has(Class, "right"); }

    // 尺寸档绑定（small/medium/large，默认 medium），供设计器读写。
    public override Binding<string> SizeOf() { return Size; }

    // 参与样式解析的完整类串：用户 class + 尺寸档片段
    // （皮肤用 `timeline.large` 规则改点径/字号）。
    private string FullCls(App app) {
        return Class + " " + this.SizeCls();
    }

    // ---- 样式驱动的几何 ------------------------------------------

    // 圆点半径：皮肤 `timeline::dot { height }` 给物理直径，
    // 否则按尺寸档 small 8 / medium 10 / large 14（app.Scale）。
    public static int DotRadius(App app, string cls) {
        StyleBox dot = Style.Part(app, "timeline", "dot", "", cls, "",
                                  Style.SNormal());
        int d = dot.HeightOr(0);
        if (d > 0) { return d / 2; }
        if (Style.Has(cls, "small")) { return app.Scale(4); }
        if (Style.Has(cls, "large")) { return app.Scale(7); }
        return app.Scale(5);
    }

    // 时间行字号：皮肤 timeline::time { font } 优先，否则 small 档。
    public static int TimeFont(App app, string cls) {
        StyleBox tm = Style.Part(app, "timeline", "time", "", cls, "",
                                 Style.SNormal());
        return tm.FontOr(Style.FontFallback(app, "small"));
    }

    // 标题行字号：皮肤 timeline::title { font } 优先，否则按尺寸档
    // 取 large / medium。
    public static int TitleFont(App app, string cls) {
        StyleBox ti = Style.Part(app, "timeline", "title", "", cls, "",
                                 Style.SNormal());
        return ti.FontOr(Style.FontFallback(app,
            Style.Has(cls, "large") ? "large" : "medium"));
    }

    // 描述行字号：皮肤 timeline::desc { font } 优先，否则 small 档。
    public static int DescFont(App app, string cls) {
        StyleBox de = Style.Part(app, "timeline", "desc", "", cls, "",
                                 Style.SNormal());
        return de.FontOr(Style.FontFallback(app, "small"));
    }

    // 竖排条目行高：三行文本 + 间距 + 兜底（容纳点/图标），
    // 字号随尺寸档变化（按 cls 解析样式）。
    public static int RowHeightFor(App app, string cls) {
        Theme t = app.theme;
        int body = Canvas.FontHeight(TimeFont(app, cls))
                 + Canvas.FontHeight(TitleFont(app, cls))
                 + Canvas.FontHeight(DescFont(app, cls))
                 + t.paddingTiny + t.gapSmall;
        int marker = Timeline.DotRadius(app, cls) * 2 + t.paddingMedium;
        int floor = body > marker ? body : marker;
        return floor + t.paddingMedium;
    }

    // 覆写：竖排按行高累计（末条待办多留半行虚线尾），横排取
    // 列块高度；宽度取样式表或兜底 240。
    public override void OnMeasure(App app) {
        string cls = this.FullCls(app);
        StyleBox s = this.ResolveStyleAs(app, "timeline", cls,
                                         Style.SNormal());
        if (this.IsHorizontal()) {
            prefH = this.HBlockHeight(app, cls);
        } else {
            int totalH = 0;
            for (int i = 0; i < items.Count; i = i + 1) {
                TimelineItem it = items[i];
                it.OnMeasure(app);
                int rh = Timeline.RowHeightFor(app, cls);
                if (it.prefH > rh) { rh = it.prefH; }
                totalH = totalH + rh;
            }
            prefH = totalH > 0 ? totalH : Timeline.RowHeightFor(app, cls) * items.Count;
            // 末条待办的虚线短尾多占半行，画出来才不会顶出盒子。
            if (items.Count > 0 && items[items.Count - 1].pending) {
                prefH = prefH + Timeline.RowHeightFor(app, cls) / 2;
            }
        }
        prefW = s.WidthOr(app.Scale(240));
    }

    // 横排一列的文本块高度（时间/标题/描述逐条换行）。
    private int HBlockHeight(App app, string cls) {
        Theme t = app.theme;
        int r = Timeline.DotRadius(app, cls);
        int fhT = Canvas.FontHeight(Timeline.TimeFont(app, cls));
        int fhA = Canvas.FontHeight(Timeline.TitleFont(app, cls));
        int fhD = Canvas.FontHeight(Timeline.DescFont(app, cls));
        return r * 2 + t.gapLarge
             + fhT + t.paddingTiny + fhA + t.gapSmall + fhD
             + t.paddingMedium;
    }

    public override int StyleDisplay() { return 1; } // Flex
    public override int StyleFlexDir() { return this.IsHorizontal() ? 0 : 1; }

    // 声明式构建时间线对象树
    public void BuildTree() {
        this.children.Clear();
        bool horiz = this.IsHorizontal();
        bool right = this.IsRight();
        int count = items.Count;
        for (int i = 0; i < count; i = i + 1) {
            TimelineItem it = items[i];
            Control itemNode = new Control();
            string role = Style.RoleClass(it.cls);
            if (it.pending && role == "") { role = "grey"; }
            itemNode.ClassName = "timeline-item " + (horiz ? "col" : (right ? "row-reverse" : "row")) + " " + it.cls;

            // 1. 点/图标
            Control dotNode = new Control();
            dotNode.ClassName = "timeline-dot align-center justify-center " + role;
            if (it.icon != "") {
                IconView iv = new IconView(it.icon, 16);
                dotNode.Add(iv);
            }
            itemNode.Add(dotNode);

            // 2. 连接线（除末尾非 pending 外）
            if (i < count - 1 || it.pending) {
                Control lineNode = new Control();
                lineNode.ClassName = "timeline-line " + (it.pending ? "pending" : "done");
                itemNode.Add(lineNode);
            }

            // 3. 内容区
            Control contentNode = new Control();
            contentNode.ClassName = "timeline-content col flex-1";
            if (it.time != "") {
                Label timeLbl = new Label(it.time);
                timeLbl.ClassName = "timeline-time text-tertiary";
                contentNode.Add(timeLbl);
            }
            if (it.children.Count > 0) {
                for (int ci = 0; ci < it.children.Count; ci = ci + 1) {
                    contentNode.Add(it.children[ci]);
                }
            } else {
                if (it.title != "") {
                    Label titleLbl = new Label(it.title);
                    titleLbl.ClassName = "timeline-title";
                    contentNode.Add(titleLbl);
                }
                if (it.description != "") {
                    Label descLbl = new Label(it.description);
                    descLbl.ClassName = "timeline-desc text-secondary";
                    contentNode.Add(descLbl);
                }
            }
            itemNode.Add(contentNode);

            this.Add(itemNode);
        }
    }

    // ---- 设计器 / 序列化模型 -------------------------------------

    // 条目的设计器往返串：`时间;标题;描述;类;图标[;pending]`，
    // 条目间用 `|`（见 ItemsText 注释）。
    public string ItemsText() {
        string s = "";
        for (int i = 0; i < items.Count; i = i + 1) {
            if (s != "") { s = s + "|"; }
            TimelineItem it = items[i];
            s = s + it.time + ";" + it.title + ";" + it.description
                 + ";" + it.cls + ";" + it.icon;
            if (it.pending) { s = s + ";pending"; }
        }
        return s;
    }

    // 从 ItemsText 同格式串重建条目列表（设计器 / 设计文档用）。
    public void SetItemsText(string spec) {
        items = new List<TimelineItem>();
        if (spec == null || spec == "") { return; }
        List<string> parts = spec.Split("|");
        for (int i = 0; i < parts.Count; i = i + 1) {
            string it = parts[i];
            if (it == "") { continue; }
            List<string> f = it.Split(";");
            string time = f.Count > 0 ? f[0] : "";
            string title = f.Count > 1 ? f[1] : "";
            string desc = f.Count > 2 ? f[2] : "";
            string cls = f.Count > 3 ? f[3] : "";
            string icon = f.Count > 4 ? f[4] : "";
            TimelineItem item = new TimelineItem(time, title, desc, cls,
                                                 icon);
            if (f.Count > 5 && f[5] == "pending") { item.pending = true; }
            items.Add(item);
        }
    }

    // 设计器额外键：`items`（条目往返串）。
    public override string GetExtra(string key) {
        if (key == "items") { return this.ItemsText(); }
        return "";
    }

    // 设计器写入 `items`；其他键返回 false 交给基类。
    public override bool SetExtra(string key, string val) {
        if (key == "items") { this.SetItemsText(val); return true; }
        return false;
    }

    // 控件类型标识（序列化/设计器用）。
    public override string Kind() { return "Timeline"; }

    // 覆写：返回设计器属性清单（size）。
    public override List<PropSpec> Props() {
        List<PropSpec> ps = new List<PropSpec>();
        PropSpec sz = PropSpec.Enum("size", "Size",
            PropSpec.Sizes3());
        sz.str = Size;
        ps.Add(sz);
        return ps;
    }
}
