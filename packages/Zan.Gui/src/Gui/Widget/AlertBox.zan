using System;
using Gui;

namespace Gui.Widget;

// 内联警告横幅：纯 Flex 横向容器，由图标、文本内容与操作项声明式子节点复合而成。
// 彻底物理消除手算坐标（bx, by, textX, actW）、FillRect 边条与 DrawText。
public class AlertBox : Control {
    public Binding<string> Text;
    public int typeNo;
    public Control actionControl;
    public Control customContent;

    private IconView iconNode;
    private Flex contentNode;
    private Flex actionNode;

    public override int StyleDisplay() { return 1; } // CSS display: flex
    public override int StyleFlexDir() { return 0; } // flex-direction: row

    private void InitAlertBox(string msg) {
        this.InitControl(msg, 1);
        Text = msg;
        typeNo = 0;
        actionControl = null;
        customContent = null;
        this.RebuildStructure();
    }

    public AlertBox() { InitAlertBox(""); }
    public AlertBox(string msg) { InitAlertBox(msg); }

    public string Label() {
        if (Text == null) { return ""; }
        return Text.Get();
    }

    public void SetText(string msg) {
        Text = msg;
        this.RebuildStructure();
        App a = this.FindApp();
        if (a != null) { a.RequestRedraw(); }
    }

    public void SetType(int t) {
        typeNo = t;
        this.RebuildStructure();
        App a = this.FindApp();
        if (a != null) { a.RequestRedraw(); }
    }

    public void RebuildStructure() {
        this.children.Clear();

        string iconName = "info";
        string cls = "info";
        if (typeNo == 1) { iconName = "success"; cls = "success"; }
        else if (typeNo == 2) { iconName = "warning"; cls = "warning"; }
        else if (typeNo == 3) { iconName = "error"; cls = "error"; }
        this.SetClassIn("info success warning error", cls);

        // 1. 语义图标节点
        iconNode = new IconView(iconName, 18);
        iconNode.ClassName = "alert-icon";
        base.Add(iconNode);

        // 2. 主体内容节点（Flex 列，自动撑开剩余空间）
        contentNode = new Flex();
        contentNode.ClassName = "alert-content flex-1 column justify-center";
        if (customContent != null) {
            contentNode.Add(customContent);
        } else {
            string msg = this.Label();
            if (msg != "") {
                contentNode.Add(new Label(msg) { ClassName = "alert-text" });
            }
        }
        base.Add(contentNode);

        // 3. 操作区插槽
        if (actionControl != null) {
            actionNode = new Flex();
            actionNode.ClassName = "alert-action row align-center";
            actionNode.Add(actionControl);
            base.Add(actionNode);
        }
    }

    public override bool MountSlot(string slot, Control c) {
        if (slot == "action" || slot == "extra") {
            actionControl = c;
            this.RebuildStructure();
            return true;
        }
        if (slot == "content" || slot == "body") {
            customContent = c;
            this.RebuildStructure();
            return true;
        }
        return base.MountSlot(slot, c);
    }

    public override Control Add(Control child) {
        if (child == null) { return null; }
        if (child.slotName != "" && this.MountSlot(child.slotName, child)) {
            return child;
        }
        if (customContent == null) {
            customContent = child;
            this.RebuildStructure();
            return child;
        }
        return base.Add(child);
    }

    public Control GetActionContent() { return actionControl; }
    public Control GetCustomContent() { return customContent; }

    public override void CloneContentTo(Control target, CloneTreeFn clone) {
        AlertBox alert = (AlertBox)target;
        if (customContent != null) {
            Control content = clone(customContent);
            if (content != null) { alert.MountSlot("content", content); }
        }
        if (actionControl != null) {
            Control action = clone(actionControl);
            if (action != null) { alert.MountSlot("action", action); }
        }
    }

    public override string Kind() { return "AlertBox"; }

    public override List<PropSpec> Props() {
        List<PropSpec> ps = new List<PropSpec>();
        PropSpec text = PropSpec.Text("text", "Text");
        text.str = Text;
        ps.Add(text);
        PropSpec tp = PropSpec.Enum("type", "Type", new List<string>());
        tp.Option("info");
        tp.Option("success");
        tp.Option("warning");
        tp.Option("error");
        tp.num = typeNo;
        ps.Add(tp);
        return ps;
    }
}
