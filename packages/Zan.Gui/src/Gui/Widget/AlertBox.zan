using System;
using Gui;

namespace Gui.Widget;

/// 内联警告横幅。不可交互的语义提示条：左侧色条 + 语义图标 +
/// 一行文本，视觉复用 Layer 通知卡片的 `notification` 皮肤规则
/// （info/success/warning/error 四个角色类），因此换肤可一次
/// 性重设所有横幅。
/// AlertBox a = new AlertBox { Text = "已保存", type = 1 };
/// 设计器工具箱的「内联警告横幅」（FormField ftype 28）生成
/// 的就是本控件——此前画布用 Layer.DrawNotify 即时预览、生成
/// 代码却发射不存在的 `Alert` 类，发布即编译失败；本类型补上
/// 后设计承诺闭环（legacy 文档里的 kind "Alert" 由 TypeOf 与
/// ControlFactory 双别名收编）。
class AlertBox : Control {
    /// 横幅文本（Binding&lt;string&gt;，可响应式绑定模型字段）。
    Binding<string> Text;
    /// 语义类型在 type 枚举里的下标：0 info / 1 success /
    /// 2 warning / 3 error。Layer 通知类型 = 下标 + 2
    /// 核心契约与语义定义。
    int typeNo;

    /// 初始化：以横幅文本注册，默认 info 档。
    void InitAlertBox(string msg) {
        this.InitControl(msg, 1);
        Text = msg;
        typeNo = 0;
        // 横幅整块由 OnPaint 经 Layer.DrawNotify 绘制（底、色条、
        // 图标、文本一体），表面不再另画背景。
        styleSurfaceOwned = true;
    }

    /// 空文本横幅（设计器用）。
    AlertBox() { InitAlertBox(""); }
    /// 给定文本的 info 横幅。
    AlertBox(string msg) { InitAlertBox(msg); }

    /// 当前文本；Text 为 null 时返回空串。
    string Label() {
        if (Text == null) { return ""; }
        return Text.Get();
    }

    /// 覆写：首选高度与 Layer 通知卡片一致，宽度铺满父容器。
    override void OnMeasure(App app) {
        prefH = app.theme.heightLarge + app.theme.paddingSmall;
        prefW = 0;
    }

    /// 覆写：整幅委托 Layer.DrawNotify（与设计器画布预览、
    /// 运行期通知共用同一渲染器，所见即所得）。
    override void OnPaint(App app) {
        Layer.DrawNotify(app, bx, by, bw, this.Label(), typeNo + 2);
    }

    // ---- 设计器 / 序列化模型 ----

    /// 控件类型标识（序列化/设计器用）。
    override string Kind() { return "AlertBox"; }

    /// 覆写：返回设计器属性清单（文本 / 语义类型）。
    override List<PropSpec> Props() {
        List<PropSpec> ps = new List<PropSpec>();
        PropSpec text = PropSpec.Text("text", "Text");
        text.str = Text;
        ps.Add(text);
        PropSpec tp = PropSpec.Enum("type", "Type", new List<string>());
        tp.Option("info");
        tp.Option("success");
        tp.Option("warning");
        tp.Option("error");
        tp.num = typeNo;
        ps.Add(tp);
        return ps;
    }
}
