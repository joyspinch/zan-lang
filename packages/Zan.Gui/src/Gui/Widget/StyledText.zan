using System;
using Gui;
namespace Gui.Widget;
public class StyledText : Control {
    public List<TextRun> lines;
    public bool busy;
    public LogState sel;
    public bool interactive;
    public Binding<int> thinkOpen;
    public List<int> toolOpen;
    public string busyText;
    public int maxScroll;
    public Binding<int> scrollBar;
    private StyledTextViewport content;
    private Label busyLabel;
    private List<StyledTextHeader> headers;
    private List<StyledTextPaintRow> paintRows;
    private Rect preparedView;
    private bool scrollReady;
    private bool arrangingScroll;
    private int projectedScroll;
    private int observedScrollVersion;
    private Binding<int> observedScrollBinding;
    private int maximumPixel;
    private int preparationTicket;
    private int preparedTicket;
    public StyledText() {
        this.InitControl("styledText");
        styleSurfaceOwned = true;
        lines = null; busy = false; sel = null; interactive = false;
        thinkOpen = 0; scrollBar = 0;
        toolOpen = null; busyText = ""; maxScroll = 0;
        headers = new List<StyledTextHeader>();
        paintRows = new List<StyledTextPaintRow>();
        content = new StyledTextViewport();
        busyLabel = new Label(""); busyLabel.Class = "hint small";
        busyLabel.SetShown(false); content.Add(busyLabel); this.Add(content);
    }
    public override StyleBox ResolveStyle(App app, int state) {
        StyleBox box = base.ResolveStyle(app, state);
        if (box.overflowCss == 0 - 1) { box.overflowY = 2; box.overflow = 1; }
        return box;
    }
    public override Rect ScrollViewport() {
        Rect view = base.ScrollViewport();
        App app = this.App;
        int pad = app != null ? app.Scale(6) : 6;
        int rowH = app != null ? StyledText.RowH(app) : 1;
        if (rowH < 1) { rowH = 1; }
        int rows = Math.Max(1, (view.height - pad * 2) / rowH);
        return new Rect(view.x, view.y + pad, view.width, Math.Max(0, Math.Min(rows * rowH, view.height - pad)));
    }
    private static long WindowSeq(App app) {
        return (app != null && app.window != null) ? app.window.EventSeq() : 0;
    }
    private bool PreparationCurrent(App app, Control root, int generation, long sequence, int ticket) {
        return this.FindApp() == app && app.rootControl == root && app.inputRootGeneration == generation
        && StyledText.WindowSeq(app) == sequence && preparationTicket == ticket;
    }
    public override void Arrange(int x, int y, int w, int h) {
        preparationTicket = preparationTicket + 1;
        int ticket = preparationTicket;
        bx = x; by = y; bw = Math.Max(0, w); bh = Math.Max(0, h);
        App app = this.App;
        if (app == null) { return; }
        Control root = app.rootControl; int generation = app.inputRootGeneration;
        long sequence = StyledText.WindowSeq(app);
        if (scrollBar == null) { scrollBar = 0; }
        if (thinkOpen == null) { thinkOpen = 0; }
        Binding<int> binding = scrollBar;
        int requested = binding.Get();
        if (!this.PreparationCurrent(app, root, generation, sequence, ticket) || scrollBar != binding) { return; }
        bool external = !scrollReady || binding != observedScrollBinding
        || requested != projectedScroll || binding.Version() != observedScrollVersion;
        int distance = maximumPixel - this.ScrollTop();
        Rect view = this.ScrollViewport();
        int rowH = StyledText.RowH(app);
        int total = lines != null ? lines.Count : 0;
        if (busy) { total = total + 1; }
        scrollExtent = total * rowH; scrollExtentX = view.width;
        maximumPixel = Math.Max(0, scrollExtent - view.height);
        maxScroll = (maximumPixel + rowH - 1) / rowH;
        int rows = Math.Max(0, Math.Min(maxScroll, requested));
        int next = external ? maximumPixel - rows * rowH : maximumPixel - distance;
        scrollReady = true;
        arrangingScroll = true;
        try { this.SetScrollTop(Math.Max(0, Math.Min(maximumPixel, next))); }
        finally { arrangingScroll = false; }
        if (!this.ProjectScroll(app, ticket)
        || !this.PreparationCurrent(app, root, generation, sequence, ticket)) { return; }
        this.PrepareVisuals(app);
    }
    private bool ProjectScroll(App app, int ticket) {
        if (!scrollReady || app == null) { return false; }
        Control root = app.rootControl; int generation = app.inputRootGeneration;
        long sequence = StyledText.WindowSeq(app);
        if (scrollBar == null) { scrollBar = 0; }
        Binding<int> binding = scrollBar;
        int current = binding.Get();
        if (!this.PreparationCurrent(app, root, generation, sequence, ticket) || scrollBar != binding) { return false; }
        int rowH = StyledText.RowH(app);
        int value = Math.Max(0, Math.Min(maxScroll, (maximumPixel - this.ScrollTop() + rowH - 1) / rowH));
        projectedScroll = value; observedScrollBinding = binding;
        observedScrollVersion = binding.Version();
        if (current != value) {
            observedScrollVersion = observedScrollVersion + 1;
            binding.Set(value);
        }
        return this.PreparationCurrent(app, root, generation, sequence, ticket)
        && scrollBar == binding && binding.Version() == observedScrollVersion;
    }
    public override void OnScrollChanged() {
        if (arrangingScroll) { return; }
        preparationTicket = preparationTicket + 1;
        int ticket = preparationTicket;
        App app = this.App;
        if (this.ProjectScroll(app, ticket)) { this.PrepareVisuals(app); }
    }
    public override void OnPreviewRoutedEvent(RoutedEventArgs e) {
        if (e.handled) { return; }
        App app = this.App;
        if (app == null) { return; }
        Control root = app.rootControl; int generation = app.inputRootGeneration;
        long sequence = StyledText.WindowSeq(app);
        int expected = preparationTicket + 1;
        this.Arrange(bx, by, bw, bh);
        if (this.FindApp() != app || app.rootControl != root || app.inputRootGeneration != generation
        || StyledText.WindowSeq(app) != sequence || preparationTicket != expected || preparedTicket != expected
        || !e.GestureRouteCurrent()) { e.Handle(); return; }
        base.OnPreviewRoutedEvent(e);
    }
    private void SelectAt(int x, int y, bool begin) {
        App app = this.App;
        if (app == null || sel == null || lines == null || lines.Count == 0) { return; }
        Rect view = this.ScrollViewport();
        int row = Math.Max(0, Math.Min(lines.Count - 1, (y - view.y + this.ScrollTop()) / StyledText.RowH(app)));
        TextRun run = lines[row];
        string runText = (run != null && run.text != null) ? run.text : "";
        int col = StyledText.ColAt(runText, bx + app.Scale(6) + app.Scale(3) + app.Scale(8), StyledText.FontPx(app), x);
        if (begin) { sel.selR0 = row; sel.selC0 = col; }
        sel.selR1 = row; sel.selC1 = col;
        this.PrepareVisuals(app); app.RequestRedraw();
    }
    public override void OnPointerDown(RoutedEventArgs e) {
        App app = this.App;
        if (e.handled || app == null || app.window == null || app.window.EventButton() != 0 || !interactive
        || this.IsDisabled() || lines == null || lines.Count == 0) { return; }
        Rect view = this.ScrollViewport();
        if (!view.Contains(e.x, e.y)) { return; }
        int row = Math.Max(0, Math.Min(lines.Count - 1, (e.y - view.y + this.ScrollTop()) / StyledText.RowH(app)));
        TextRun line = lines[row];
        if (line == null) { return; }
        if (line.kind == 4) {
            if (thinkOpen == null) { thinkOpen = 0; }
            Binding<int> binding = thinkOpen;
            Control root = app.rootControl; int generation = app.inputRootGeneration;
            long sequence = StyledText.WindowSeq(app);
            int ticket = preparationTicket;
            int value = binding.Get();
            if (!this.PreparationCurrent(app, root, generation, sequence, ticket) || thinkOpen != binding) { e.Handle(); return; }
            e.Handle(); app.RequestRedraw(); binding.Set(1 - value);
            return;
        }
        if (line.kind == 5 && toolOpen != null && line.meta >= 0) {
            int at = toolOpen.IndexOf(line.meta);
            if (at >= 0) { toolOpen.RemoveAt(at); } else { toolOpen.Add(line.meta); }
        } else {
            if (sel == null) { return; }
            this.SelectAt(e.x, e.y, true); sel.selDrag = true; app.CapturePointer(this, true);
        }
        e.Handle(); app.RequestRedraw();
    }
    public override void OnPointerMove(RoutedEventArgs e) {
        App app = this.App;
        if (!e.handled && app != null && sel != null && sel.selDrag && app.GetCapturedPointer() == this) {
            this.SelectAt(e.x, e.y, false); e.Handle();
        }
    }
    public override void OnPointerUp(RoutedEventArgs e) {
        App app = this.App;
        if (e.handled || app == null || app.window == null || app.window.EventButton() != 0 || sel == null || !sel.selDrag
        || app.GetCapturedPointer() != this) { return; }
        this.SelectAt(e.x, e.y, false);
        sel.selDrag = false; app.ReleasePointerCapture(); e.Handle();
    }
    public override void OnPointerCancel(RoutedEventArgs e) {
        if (sel != null) { sel.selDrag = false; }
        base.OnPointerCancel(e);
    }
    public static int BarW(App app) { return app != null ? app.Scale(12) : 12; }
    public static int FontPx(App app) {
        return Style.Of(app, "label", "small", Style.SNormal()).FontOr(Style.FontFallback(app, "small"));
    }
    public static int RowH(App app) {
        if (app == null) { return 20; }
        return Math.Max(1, Math.Max(Canvas.FontHeight(StyledText.FontPx(app)) + app.Scale(3), app.theme.heightTiny));
    }
    public static int SepH(App app) { return app != null ? app.Scale(1) : 1; }
    public static int RowAt(int startY, int pad, int rowH, int start, int count, int mouseY) {
        if (count <= 0) { return 0; }
        if (rowH <= 0) { rowH = 1; }
        return Math.Max(0, Math.Min(count - 1, start + Math.Max(0, (mouseY - startY - pad) / rowH)));
    }
    public static string Initial(string name) {
        if (name == null || name == "") { return "?"; }
        int end = Text.NextCharEnd(name, 0);
        return Text.Left(name, end > 0 ? end : 1).ToUpper();
    }
    public override void OnMeasure(App app) {
        prefW = bw; prefH = bh;
        this.Arrange(bx, by, bw, bh);
    }
    private StyledTextHeader HeaderAt(int index, App app, TextRun line) {
        if (index >= headers.Count) {
            StyledTextHeader added = new StyledTextHeader();
            headers.Add(added); content.Add(added);
        }
        StyledTextHeader header = headers[index];
        header.SetShown(true); header.Prepare(app, line);
        return header;
    }
    private void PrepareVisuals(App app) {
        if (app == null) { return; }
        preparedView = this.ScrollViewport();
        content.Arrange(preparedView.x, preparedView.y, preparedView.width, preparedView.height);
        int rowH = StyledText.RowH(app); int font = StyledText.FontPx(app);
        int textDy = Math.Max(0, (rowH - Canvas.FontHeight(font)) / 2);
        int pad = app.Scale(6); int railW = app.Scale(3);
        int inset = this.StyleOverflowY() >= 2 && maximumPixel > 0 ? StyledText.BarW(app) : 0;
        int blockX = bx + pad; int blockW = Math.Max(0, bw - pad * 2 - inset);
        int textX = blockX + railW + app.Scale(8);
        int sr0 = sel != null ? sel.selR0 : -1; int sc0 = sel != null ? sel.selC0 : 0;
        int sr1 = sel != null ? sel.selR1 : -1; int sc1 = sel != null ? sel.selC1 : 0;
        if (sr0 > sr1 || (sr0 == sr1 && sc0 > sc1)) {
            int swap = sr0; sr0 = sr1; sr1 = swap;
            swap = sc0; sc0 = sc1; sc1 = swap;
        }
        int selection = Style.Part(app, "styledtext", "selection", "", "", "", Style.SNormal()).BgOr(0);
        int code = Style.Part(app, "styledtext", "code", "", "", "", Style.SNormal()).BgOr(0);
        int separator = Style.Part(app, "styledtext", "separator", "", "", "", Style.SNormal()).BgOr(0);
        StyleBox timeStyle = Style.Part(app, "styledtext", "time", "", "", "", Style.SNormal());
        int count = lines != null ? lines.Count : 0;
        int first = Math.Max(0, this.ScrollTop() / rowH);
        int last = Math.Min(count, (this.ScrollTop() + preparedView.height + rowH - 1) / rowH);
        int visible = Math.Max(0, last - first);
        while (paintRows.Count < visible) { paintRows.Add(new StyledTextPaintRow()); }
        while (paintRows.Count > visible) { paintRows.RemoveAt(paintRows.Count - 1); }
        int head = 0;
        for (int i = 0; i < count; i = i + 1) {
            TextRun line = lines[i];
            if (line == null || line.kind != 3) { continue; }
            int right = bx + bw - pad - inset;
            if (line.time != null && line.time != "") {
                int timeWidth = Canvas.MeasureText(line.time, timeStyle.FontOr(Style.FontFallback(app, "small")));
                if (right - timeWidth > textX) { right = right - timeWidth - app.Scale(6); }
            }
            StyledTextHeader header = this.HeaderAt(head, app, line);
            header.Arrange(textX, preparedView.y + i * rowH - this.ScrollTop(), Math.Max(0, right - textX), rowH);
            head = head + 1;
        }
        while (headers.Count > head) {
            StyledTextHeader removed = headers[headers.Count - 1];
            headers.RemoveAt(headers.Count - 1); content.Remove(removed);
        }
        for (int i = first; i < last; i = i + 1) {
            TextRun line = lines[i]; StyledTextPaintRow row = paintRows[i - first];
            if (line == null) {
                row.spacer = true; row.code = false; row.text = ""; row.glyph = ""; row.time = "";
                row.selectionWidth = 0; row.separatorHeight = 0;
                continue;
            }
            string safeText = line.text != null ? line.text : "";
            row.y = preparedView.y + i * rowH - this.ScrollTop(); row.height = rowH;
            row.blockX = blockX; row.blockWidth = blockW; row.railWidth = railW;
            string role = line.owner == 0 ? "primary" : (line.owner == 2 ? "tool" : (line.owner == 3 ? "error" : "success"));
            row.railColor = Style.Part(app, "styledtext", "rail", "", role, "", Style.SNormal()).BgOr(0);
            row.tintColor = Style.Part(app, "styledtext", "tint", "", role, "", Style.SNormal()).BgOr(0);
            row.spacer = line.kind == 6; row.code = line.kind == 1;
            row.codeX = textX - app.Scale(2); row.codeWidth = Math.Max(0, blockW - railW - app.Scale(4)); row.codeColor = code;
            row.selectionX = 0; row.selectionWidth = 0; row.selectionColor = selection;
            row.separatorHeight = line.last ? StyledText.SepH(app) : 0; row.separatorColor = separator;
            row.text = line.kind == 3 ? "" : safeText; row.textX = textX;
            row.textY = row.y + textDy; row.font = font; row.color = line.color;
            row.glyph = ""; row.time = "";
            this.PrepareSelection(row, line, i, sr0, sc0, sr1, sc1, pad);
            if (line.kind == 3) {
                int right = bx + bw - pad - inset;
                if (line.time != null && line.time != "") {
                    row.timeFont = timeStyle.FontOr(Style.FontFallback(app, "small"));
                    int width = Canvas.MeasureText(line.time, row.timeFont);
                    int tx = right - width;
                    if (tx > textX) {
                        row.time = line.time; row.timeX = tx; row.timeY = row.y + Math.Max(0, (rowH - row.timeFont) / 2);
                        row.timeColor = timeStyle.FgOr(0); right = tx - app.Scale(6);
                    }
                }
            } else if (line.kind == 1) { row.textX = textX + app.Scale(4); }
            else if (line.kind == 5 && (safeText.StartsWith("▼ ") || safeText.StartsWith("▶ "))) {
                row.glyph = safeText.StartsWith("▼ ") ? "chevron-down" : "chevron-right";
                row.glyphSize = app.Scale(11); row.glyphX = textX;
                row.glyphY = row.y + (rowH - row.glyphSize) / 2;
                row.textX = textX + row.glyphSize + app.Scale(4);
                int skip = Text.NextCharEnd(safeText, 0) + 1;
                row.text = skip <= safeText.Length ? safeText.Substring(skip) : "";
            }
        }
        bool showBusy = busy && count * rowH < this.ScrollTop() + preparedView.height
        && (count + 1) * rowH > this.ScrollTop();
        busyLabel.SetShown(showBusy);
        if (showBusy) {
            string text = busyText != null ? busyText : "";
            if (busyLabel.GetText() != text) {
                if (busyLabel.Text != null) { busyLabel.Text.Set(text); } else { busyLabel.Text = text; }
            }
            busyLabel.MeasureTree(app);
            busyLabel.Arrange(bx + pad, preparedView.y + count * rowH - this.ScrollTop(),
            Math.Max(0, bw - pad * 2 - inset), rowH);
        }
        preparedTicket = preparationTicket;
    }
    private void PrepareSelection(StyledTextPaintRow row, TextRun line, int index,
    int sr0, int sc0, int sr1, int sc1, int pad) {
        if (line == null || line.text == null || row.spacer || sr0 < 0 || index < sr0 || index > sr1) { return; }
        int len = line.text.Length;
        int from = index == sr0 ? sc0 : 0;
        int to = index == sr1 ? sc1 : len;
        from = Text.ClampCharStart(line.text, Math.Max(0, Math.Min(len, from)));
        to = Text.ClampCharStart(line.text, Math.Max(from, Math.Min(len, to)));
        int x = row.textX + Canvas.MeasureText(Text.Left(line.text, from), row.font);
        int end = row.textX + Canvas.MeasureText(Text.Left(line.text, to), row.font);
        if (index < sr1) { end = end + pad; }
        row.selectionX = x; row.selectionWidth = Math.Max(2, end - x);
    }
    public override void OnPaint(App app) {
        if (app == null || app.canvas == null || preparedView == null) { return; }
        Canvas canvas = app.canvas;
        canvas.PushClip(preparedView.x, preparedView.y, preparedView.width, preparedView.height);
        try {
            for (int i = 0; i < paintRows.Count; i = i + 1) { paintRows[i].Paint(canvas); }
        } finally {
            canvas.PopClip();
        }
    }
    public static int ColAt(string line, int textX, int fontSize, int mouseX) {
        if (line == null) { return 0; }
        for (int i = 0; i < line.Length; ) {
            int next = Text.NextCharEnd(line, i);
            if (next <= i) { break; }
            int left = Canvas.MeasureText(Text.Left(line, i), fontSize);
            int right = Canvas.MeasureText(Text.Left(line, next), fontSize);
            if (mouseX < textX + (left + right) / 2) { return i; }
            i = next;
        }
        return line.Length;
    }

    protected override List<PropSpec> DefineProps() {
        List<PropSpec> props = new List<PropSpec>(); props.Add(this.SizeProp()); return props;
    }
}
