using System;
using System.Collections.Generic;
using Gui;
using Gui.Backend;
namespace Gui.Widget;
internal class GuiWidgetState {
    internal Image.UrlFetchFn urlFetcher;
    internal Image.UrlEnsureFn urlEnsurer;
    internal AppLayerContext layerFallbackContext;

    internal static GuiWidgetState Current() {
        object existing = GuiHostState.WidgetState();
        if (existing != null) { return (GuiWidgetState)existing; }
        GuiWidgetState created = new GuiWidgetState();
        GuiHostState.SetWidgetState(created);
        return created;
    }
}
