using System;
using System.Collections.Generic;
using Gui;
using Gui.Widget.Models;

namespace Gui.Widget;

// 导航菜单（Menu）：纯声明式对象树与 CSS 盒模型（Flex 纵向列排布）。
// 内部完全由标准 Button、Label、IconView 等基础控件组合而成，彻底物理删除所有画布微绘与坐标手算。
public class Menu : Control {
    public List<MenuItem> items;
    public SignalString selectedKey;
    public SignalInt selected;
    public MenuExpandState expandState;
    public UiEvent Select;

    public override int StyleDisplay() { return 1; } // Flex
    public override int StyleFlexDir() { return 1; } // Column

    private void InitMenu() {
        this.InitControl("menu", 1);
        this.ClassName = "menu col";
        items = new List<MenuItem>();
        selectedKey = new SignalString("");
        selected = new SignalInt(0 - 1);
        expandState = new MenuExpandState();
        Select = new UiEvent();
        wiresOwnEvents = true;
    }

    public Menu() {
        InitMenu();
        this.BuildTree();
    }

    public Menu(List<MenuItem> its) {
        InitMenu();
        if (its != null) { items = its; }
        this.BuildTree();
    }

    public static Menu Of(List<string> strItems, SignalInt sel) {
        Menu m = new Menu();
        if (sel != null) { m.selected = sel; }
        if (strItems != null) {
            for (int i = 0; i < strItems.Count; i = i + 1) {
                m.AddItem(strItems[i]);
            }
        }
        m.BuildTree();
        return m;
    }

    public static Menu OfTree(List<MenuItem> treeItems, SignalString selKey) {
        Menu m = new Menu();
        if (selKey != null) { m.selectedKey = selKey; }
        if (treeItems != null) { m.items = treeItems; }
        m.BuildTree();
        return m;
    }

    public Menu AddItem(string label) {
        MenuItem it = MenuItem.Item(label, "", items.Count);
        it.key = label;
        items.Add(it);
        this.BuildTree();
        return this;
    }

    public Menu AddItem(MenuItem it) {
        if (it != null) {
            items.Add(it);
            this.BuildTree();
        }
        return this;
    }

    public Menu AddSeparator() {
        items.Add(MenuItem.Separator());
        this.BuildTree();
        return this;
    }

    public void SelectIndex(int idx) {
        if (selected != null) { selected.Set(idx); }
        if (idx >= 0 && idx < items.Count) {
            string k = items[idx].key;
            if (k != null && k != "") {
                if (selectedKey != null) { selectedKey.Set(k); }
            }
        }
        Select.RaiseS(this);
        this.BuildTree();
    }

    public void SelectKey(string key) {
        if (selectedKey != null) { selectedKey.Set(key); }
        for (int i = 0; i < items.Count; i = i + 1) {
            if (items[i].key == key) {
                if (selected != null) { selected.Set(i); }
            }
        }
        Select.RaiseS(this);
        this.BuildTree();
    }

    public void BuildTree() {
        this.children.Clear();
        string curKey = selectedKey != null ? selectedKey.Get() : "";
        int curIdx = selected != null ? selected.Get() : (0 - 1);

        this.AppendItems(this, items, 0, curKey, curIdx);
    }

    private void AppendItems(Control parent, List<MenuItem> list, int depth, string curKey, int curIdx) {
        if (list == null) { return; }

        for (int i = 0; i < list.Count; i = i + 1) {
            int itemIdx = i;
            MenuItem m = list[i];
            string mKey = m.key != null && m.key != "" ? m.key : m.label;

            if (m.kind == 1) {
                // 分隔线
                Control sep = new Control();
                sep.ClassName = "menu-separator";
                parent.Add(sep);
            } else if (m.kind == 2) {
                // 分组标题
                Label hdr = new Label(m.label);
                hdr.ClassName = "menu-header text-muted";
                parent.Add(hdr);
            } else if (m.kind == 3 || (m.children != null && m.children.Count > 0)) {
                // 子菜单 / 可折叠组
                bool isExpanded = expandState.Contains(mKey);
                Button grpBtn = new Button("");
                grpBtn.ClassName = "menu-item menu-group-header row align-center justify-between";

                Control leftBox = new Control();
                leftBox.ClassName = "row align-center gap-small";
                if (m.icon != null && m.icon != "") {
                    leftBox.Add(new IconView(m.icon, 16));
                }
                leftBox.Add(new Label(m.label));
                grpBtn.Add(leftBox);

                IconView arr = new IconView(isExpanded ? "chevron-down" : "chevron-right", 14);
                arr.ClassName = "menu-arrow text-muted";
                grpBtn.Add(arr);

                grpBtn.Click.Add(() => {
                    expandState.Toggle(mKey);
                    this.BuildTree();
                });
                parent.Add(grpBtn);

                if (isExpanded && m.children != null && m.children.Count > 0) {
                    Control subBox = new Control();
                    subBox.ClassName = "menu-subgroup col";
                    this.AppendItems(subBox, m.children, depth + 1, curKey, curIdx);
                    parent.Add(subBox);
                }
            } else {
                // 普通叶子项
                bool isActive = (curKey != "" && mKey == curKey) || (curIdx >= 0 && itemIdx == curIdx);
                Button btn = new Button("");
                btn.ClassName = "menu-item row align-center gap-small " + (isActive ? "active" : "") + (m.disabled ? " disabled" : "");
                btn.Disabled = m.disabled;

                if (m.icon != null && m.icon != "") {
                    btn.Add(new IconView(m.icon, 16));
                }

                Label lbl = new Label(m.label);
                lbl.ClassName = "menu-item-label flex-1";
                btn.Add(lbl);

                if (m.shortcut != null && m.shortcut != "") {
                    Label sc = new Label(m.shortcut);
                    sc.ClassName = "menu-shortcut text-muted";
                    btn.Add(sc);
                }

                btn.Click.Add(() => {
                    if (!m.disabled) {
                        this.SelectKey(mKey);
                    }
                });
                parent.Add(btn);
            }
        }
    }

    public override void OnPaint(App app) {
        int id = this.CommonId();
        this.SyncBinding();
        app.focus.RegisterFocusable(id);
        app.hitTester.RegisterRect(id, bx, by, bw, bh, 0);
        On.Fire(app, id, this);
    }

    public override string Kind() { return "Menu"; }
}
