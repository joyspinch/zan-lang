using System;
using System.Collections.Generic;
using Gui;

namespace Gui.Widget;

// 导航菜单（Menu）：纯声明式对象树与 CSS 盒模型（Flex 纵向列排布）。
// 内部完全由标准 Button、Label、IconView 等基础控件组合而成，彻底物理删除所有画布微绘与坐标手算。
public class Menu : Control {
    public List<MenuItem> items;
    // 选中项的 key / 下标走统一 Binding<T> 通道（宿主持有模型字段）。
    public Binding<string> selectedKey;
    public Binding<int> selected;
    public MenuExpandState expandState;
    [Event]
    public UiEvent Select;
    internal int treeGeneration;
    private string builtKey;
    private int builtIndex;
    private bool preparingSelection;

    public override int StyleDisplay() { return 1; } // Flex
    public override int StyleFlexDir() { return 1; } // Column

    private void InitMenu() {
        this.InitControl("menu", 1);
        this.ClassName = "menu col";
        items = new List<MenuItem>();
        selectedKey = "";
        selected = 0 - 1;
        expandState = new MenuExpandState();
        Select = new UiEvent();
        wiresOwnEvents = true;
    }

    public Menu() {
        InitMenu();
        this.BuildTree();
    }

    public Menu(List<MenuItem> its) {
        InitMenu();
        if (its != null) { items = its; }
        this.BuildTree();
    }

    public Menu(List<string> strItems, Binding<int> sel) {
        InitMenu();
        if (sel != null) { selected = sel; }
        if (strItems != null) {
            for (int i = 0; i < strItems.Count; i = i + 1) {
                this.AddItem(strItems[i]);
            }
        }
        this.BuildTree();
    }

    public Menu(List<MenuItem> treeItems, Binding<string> selKey) {
        InitMenu();
        if (selKey != null) { selectedKey = selKey; }
        if (treeItems != null) { items = treeItems; }
        this.BuildTree();
    }

    public Menu AddItem(string label) {
        MenuItem it = MenuItem.Item(label, "", items.Count);
        it.key = label;
        items.Add(it);
        this.BuildTree();
        return this;
    }

    public Menu AddItem(MenuItem it) {
        if (it != null) {
            items.Add(it);
            this.BuildTree();
        }
        return this;
    }

    public Menu AddSeparator() {
        items.Add(MenuItem.Separator());
        this.BuildTree();
        return this;
    }

    public void SelectIndex(int idx) {
        selected.Set(idx);
        if (idx >= 0 && idx < items.Count) {
            string k = items[idx].key;
            if (k != null && k != "") { selectedKey.Set(k); }
        }
        this.BuildTree();
        Select.Raise(this);
    }

    public void SelectKey(string key) {
        selectedKey.Set(key);
        for (int i = 0; i < items.Count; i = i + 1) {
            if (items[i].key == key) { selected.Set(i); }
        }
        this.BuildTree();
        Select.Raise(this);
    }

    public void BuildTree() {
        treeGeneration = treeGeneration + 1;
        int ticket = treeGeneration;
        App host = this.FindApp();
        Control ownerParent = parent;
        this.RemoveAll();
        if (ticket != treeGeneration || this.FindApp() != host || parent != ownerParent) { return; }
        string curKey = selectedKey.Get();
        int curIdx = selected.Get();
        if (ticket != treeGeneration || this.FindApp() != host || parent != ownerParent) { return; }
        builtKey = curKey;
        builtIndex = curIdx;
        this.AppendItems(this, items, 0, curKey, curIdx);
    }

    public override void SyncBinding() {
        if (preparingSelection) { return; }
        preparingSelection = true;
        try {
            base.SyncBinding();
            if (selectedKey.Get() != builtKey || selected.Get() != builtIndex) { this.BuildTree(); }
        } finally { preparingSelection = false; }
    }

    private void AppendItems(Control parent, List<MenuItem> list, int depth, string curKey, int curIdx) {
        if (list == null) { return; }

        for (int i = 0; i < list.Count; i = i + 1) {
            int itemIdx = i;
            MenuItem m = list[i];
            string mKey = m.key != null && m.key != "" ? m.key : m.label;

            if (m.kind == 1) {
                // 分隔线
                Control sep = new Control();
                sep.ClassName = "menu-separator";
                parent.Add(sep);
            } else if (m.kind == 2) {
                // 分组标题
                Label hdr = new Label(m.label);
                hdr.ClassName = "menu-header text-muted";
                parent.Add(hdr);
            } else if (m.kind == 3 || (m.children != null && m.children.Count > 0)) {
                // 子菜单 / 可折叠组
                bool isExpanded = expandState.Contains(mKey);
                Button grpBtn = new Button("");
                grpBtn.ClassName = "menu-item menu-group-header row align-center justify-between";
                grpBtn.Disabled = m.disabled;

                Control leftBox = new Control();
                leftBox.ClassName = "menu-group-label row align-center gap-small";
                if (m.icon != null && m.icon != "") {
                    leftBox.Add(new IconView(m.icon, 16));
                }
                leftBox.Add(new Label(m.label));
                grpBtn.Add(leftBox);

                IconView arr = new IconView(isExpanded ? "chevron-down" : "chevron-right", 14);
                arr.ClassName = "menu-arrow text-muted";
                grpBtn.Add(arr);

                MenuItemAction groupAction = new MenuItemAction(this, m, mKey, true);
                grpBtn.Click.Add(groupAction.Invoke);
                parent.Add(grpBtn);

                if (isExpanded && m.children != null && m.children.Count > 0) {
                    Control subBox = new Control();
                    subBox.ClassName = "menu-subgroup col";
                    this.AppendItems(subBox, m.children, depth + 1, curKey, curIdx);
                    parent.Add(subBox);
                }
            } else {
                // 普通叶子项
                bool isActive = curKey != "" ? mKey == curKey
                    : (depth == 0 && curIdx >= 0 && itemIdx == curIdx);
                Button btn = new Button("");
                btn.ClassName = "menu-item row align-center gap-small " + (isActive ? "active" : "") + (m.disabled ? " disabled" : "");
                btn.Disabled = m.disabled;

                if (m.icon != null && m.icon != "") {
                    btn.Add(new IconView(m.icon, 16));
                }

                Label lbl = new Label(m.label);
                lbl.ClassName = "menu-item-label flex-1";
                btn.Add(lbl);

                if (m.shortcut != null && m.shortcut != "") {
                    Label sc = new Label(m.shortcut);
                    sc.ClassName = "menu-shortcut text-muted";
                    btn.Add(sc);
                }

                MenuItemAction selectAction = new MenuItemAction(this, m, mKey, false);
                btn.Click.Add(selectAction.Invoke);
                parent.Add(btn);
            }
        }
    }

    public override int InputFocusCapabilities() { return 1; }

    protected override List<PropSpec> DefineProps() {
        List<PropSpec> ps = new List<PropSpec>();
        ps.Add(PropSpec.Text("selectedKey", "Selected Key").DefaultBinding()
            .ViaExtra()
            .Also("value")
            .Also("data"));
        ps.Add(PropSpec.Int("selected", "Selected Index").DefaultBinding().ViaExtra());
        ps.Add(this.SizeProp());
        return ps;
    }

    public override string GetProp(string key) {
        if (key == "selectedKey" || key == "value" || key == "data") {
            return selectedKey.Get();
        }
        if (key == "selected") {
            return Convert.ToString(selected.Get());
        }
        return base.GetProp(key);
    }

    public override void SetProp(string key, string val) {
        if (key == "selectedKey" || key == "value" || key == "data") {
            selectedKey.Set(val);
            return;
        }
        if (key == "selected") {
            selected.Set(Convert.ToInt32(val));
            return;
        }
        base.SetProp(key, val);
    }
}
