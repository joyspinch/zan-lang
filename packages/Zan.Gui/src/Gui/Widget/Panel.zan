using System;
using Gui;
namespace Gui.Widget;
public class Panel : Control {
    public override Control CreateCloneShell() { return new Panel(); }
    public int style;
    public int layout;
    public int flexFlow;
    public string title;
    public int surfaceColor;
    public FxOptions fx;
    protected void InitPanel(string name, int st) {
        this.InitControl(name);
        styleSurfaceOwned = true;
        style = st;
        layout = 0;
        title = "";
        surfaceColor = 0;
        fx = null;
    }
    public string PanelTitle {
        get { return this.title; }
        set { this.Titled(value); }
    }
    public int SurfaceColor {
        get { return this.surfaceColor; }
        set { this.Plain(value); }
    }
    public FxOptions FxConfig {
        get { return this.fx; }
        set { this.fx = value; }
    }
    public int LayoutMode {
        get { return this.layout; }
        set { this.layout = value; }
    }
    public int PanelStyle {
        get { return this.style; }
        set { this.style = value; }
    }
    public Panel WithFx(FxOptions o) { fx = o; return this; }
    public Panel() { InitPanel("", 3); }
    public Panel(string name) { InitPanel(name, 0); }
    public Panel Plain(int color) {
        style = 1;
        surfaceColor = color;
        return this;
    }
    public Panel Layout() { style = 3; return this; }
    public Panel Titled(string t) {
        style = 2;
        title = t;
        return this;
    }
    public static Panel Column() {
        Panel p = new Panel("column");
        p.style = 3;
        p.layout = 1;
        p.flexFlow = 1;
        return p;
    }
    public static Panel Root(string name) {
        Panel p = new Panel(name);
        p.style = 3;
        p.layout = 0;
        return p;
    }
    public static Panel Row() {
        Panel p = new Panel("row");
        p.style = 3;
        p.layout = 2;
        p.flexFlow = 1;
        return p;
    }
    public override int StyleDisplay() {
        if (flexFlow == 1 || layout == 1 || layout == 2) { return 1; }
        return base.StyleDisplay();
    }
    public override int StyleFlexDir() {
        if (flexFlow == 1 || layout == 1 || layout == 2) { return layout == 2 ? 0 : 1; }
        return base.StyleFlexDir();
    }
    // 流式容器（Panel.Row/Panel.Column）只做布局：不绘制任何表面，
    // 因此也不应继承样式表的 `panel` 规则——
    // 否则皮肤的 `panel { padding: 18px; backdrop-filter: blur(...) }` 会
    // 吃掉 Row 的内容框（使其各行互相重叠）并
    // 给没有内容的容器做毛玻璃。样式表可用 `stack`
    // 定位它们。
    public override string StyleType() {
        if (style == 3) { return "stack"; }
        return "panel";
    }
    protected override List<PropSpec> DefineProps() {
        List<PropSpec> ps = new List<PropSpec>();
        ps.Add(PropSpec.Enum("style", "Style", new List<string>())
            .Option("card").Option("plain").Option("section").Option("layout")
            .Field("style"));
        ps.Add(PropSpec.Enum("layout", "Layout", new List<string>())
            .Option("none").Option("column").Option("row")
            .Field("layout"));
        ps.Add(PropSpec.Text("title", "Title").Field("title"));
        ps.Add(PropSpec.Color("surfaceColor", "Surface color")
            .Field("surfaceColor")
            .WithTip("Panel surface colour override. 0 = theme default."));
        return ps;
    }
    public override void OnMeasure(App app) {
        Theme t = app.theme;
        if (style == 3) { return; }
        if (padSet) { return; }
        padL = t.paddingLarge;
        padR = t.paddingLarge;
        padT = t.paddingLarge;
        padB = t.paddingLarge;
        if (style == 2 && title != "") {
            StyleBox titleStyle = this.ResolvePartAs(app, "panel", "title", "",
                                                     Class, Style.SNormal());
            padT = t.paddingLarge
                + Canvas.FontHeight(titleStyle.FontOr(
                    Style.FontFallback(app, "large")))
                + t.paddingSmall + t.paddingMedium;
        }
        if (style == 1) {
            padL = t.paddingMedium;
            padR = t.paddingMedium;
            padT = t.paddingMedium;
            padB = t.paddingMedium;
        }
    }
    private bool StyledSurface(App app, string type, StyleBox s) {
        StyleBox d = (type == "stack" && app != null)
            ? app.CachedBareStackStyle()
            : Style.FullRef(app, type, "", "", Style.SNormal());
        return s.bg != d.bg || s.bgTo != d.bgTo || s.radius != d.radius
            || s.borderColor != d.borderColor || s.borderW != d.borderW
            || s.shadow != d.shadow || s.blur != d.blur || s.sheen != d.sheen
            || s.opacity != d.opacity || s.tx != d.tx || s.ty != d.ty || s.scale != d.scale;
    }
    protected override bool UsesBaseFlowOnly() { return this.Kind() == "Panel"; }
    protected override bool UsesBaseSyncBinding() { return this.Kind() == "Panel"; }
    protected override bool PaintWithinBounds() {
        return this.Kind() == "Panel" && fx == null && !(style == 2 && title != "");
    }
    public override void OnPaint(App app) {
        Canvas c = app.canvas;
        Theme t = app.theme;
        if (style == 3) {
            StyleBox ls;
            if (paintedStyle != null && computedStyleState == Style.SNormal() && computedStyleType == "stack") {
                ls = paintedStyle;
            } else {
                this.ResolveStyleCached(app, "stack", Class, Style.SNormal());
                ls = this.ResolvePaintedSurface(app);
            }
            if (this.StyledSurface(app, "stack", ls)) { ls.Paint(app, bx, by, bw, bh); }
            return;
        }
        if (app.WindowShape() != 0 && parent != null && parent is WindowRoot) {
            // 异形窗口的窗口根：轮廓就是窗口本身，
            // 全窗口主题表面会填满阴影带并把设计
            // 变方正。设计自身的卡片自行绘制。
            return;
        }
        // 表面完全由样式表决定：base.css 的 `panel` 规则把主题 token
        // 展开成背景/边框/圆角/投影/磨砂，皮肤只要改写那条规则或
        // 它用到的 token 即可，控件这里不再硬编码任何一种画法。
        // 基类 PaintStyleBox 特意跳过面板，好让 `#Card { background:
        // linear-gradient(...) }` 与内联的 Bg()/Gradient()/Radius() 走同一条路。
        StyleBox s;
        if (paintedStyle != null && computedStyleState == Style.SNormal() && computedStyleType == "panel") {
            s = paintedStyle;
        } else {
            this.BoxState(app, Style.SNormal());
            s = this.ResolvePaintedSurface(app);
        }
        if (style == 1) {
            int col = surfaceColor;
            if (col == 0) {
                StyleBox plain = Style.Part(app, "panel", "plain", "",
                                             Class, name, Style.SNormal());
                col = plain.BgOr(0);
            }
            s.bg = col;
            s.bgTo = col;
            s.borderW = 0;
            s.radius = 0;
            s.shadow = 0;
        }
        if (app.IsOpaqueDrawerPartialSurface(this)
            && fx == null && !(style == 2 && title != "")) {
            c.FillRect(app.Damage.presentX, app.Damage.presentY,
                app.Damage.presentW, app.Damage.presentH, s.Fade(s.bg));
            return;
        }
        s.Paint(app, bx, by, bw, bh);
        Fx.Apply(app, bx, by, bw, bh, t.borderRadiusLarge, fx, s.accent);
        if (style == 2 && title != "") {
            StyleBox ts = this.ResolvePartAs(app, "panel", "title", "", Class,
                                             Style.SNormal());
            StyleBox ds = this.ResolvePartAs(app, "panel", "divider", "",
                                             Class, Style.SNormal());
            int pad = t.paddingLarge;
            int titleFont = ts.FontOr(Style.FontFallback(app, "large"));
            int titleH = Canvas.FontHeight(titleFont);
            c.DrawText(bx + pad, by + pad, title, ts.fg, titleFont);
            int dividerY = by + pad + titleH + t.paddingSmall;
            c.FillRect(bx + pad, dividerY, bw - pad * 2, 1, ds.bg);
        }
    }
    public override int StylePadT() {
        int styled = padT;
        if (!padSet && computedStyle != null) { styled = computedStyle.PadTOr(padT); }
        if (style == 2 && title != "" && styled < padT) { return padT; }
        return styled;
    }
    public Rect Inner() {
        int il = this.StylePadL();
        int it = this.StylePadT();
        int ir = this.StylePadR();
        int ib = this.StylePadB();
        return new Rect(bx + il, by + it, bw - il - ir,
                           bh - it - ib);
    }
}
