using System.Collections.Generic;
using System;
using Gui;
using Gui.Backend;
namespace Gui.Widget;
public delegate Control NodeOf(TreeNode node);
[GuiKind("TreeView")]
public partial class TreeView : Control {
    public override Control CreateCloneShell() { return new TreeView(); }
    public List<TreeNode> data;
    public Binding<int> Value;
    public Binding<int> scroll;
    public Input filter;
    public bool checks;
    public bool multi;
    public List<int> marks;
    public NodeOf tpl;
    public bool rowsStale;
    public int builtFor;
    public int ctxRow;
    public int ctxX;
    public int ctxY;
    private int hoveredRow = -1;
    private bool IsRowHovered(int index) { return hoveredRow == index; }
    public string Empty;
    public UiEvent Select;
    public UiEvent Activate;
    public UiEvent Expand;
    public UiEvent Collapse;
    public UiEvent Context;
    public UiEvent Check;
    public UiEvent Press;
    public UiEvent Move;
    public bool reorder;
    public bool pressed;
    public int dragRow;
    public bool dragging;
    public int dropAt;
    public bool dropDone;
    public Rect rowBuf;
    private TreeRowsPanel rowsBody;
    private bool layingRows;
    private bool projectingScroll;
    private int filterRevision;
    private VisibleRowHost rowHost;
    private int fixedRowHeight;
    private int rowsRevision;
    private bool buildingRows;
    private Control DataRow(int index) { return rowHost != null ? rowHost.Row(index) : null; }
    public void WithFixedRowHeight(int height) {
        fixedRowHeight = height > 0 ? height : 0;
        this.RetireRows();
    }
    private void RetireRows() {
        rowsRevision = rowsRevision + 1;
        rowsStale = true;
        builtFor = -1;
        if (rowHost != null) { rowHost.Reset(); }
    }
    private Checkbox treeCheck;
    private Checkbox TreeCheck() {
        if (this.treeCheck == null) { this.treeCheck = new Checkbox(); }
        return this.treeCheck;
    }
    private void InitTree() {
        this.InitControl("tree");
        rowsBody = new TreeRowsPanel(this);
        base.Add(rowsBody);
        rowHost = new VisibleRowHost(this, rowsBody);
        this.rowBuf = new Rect(0, 0, 0, 0);
        data = new List<TreeNode>();
        Value = -1;
        scroll = 0;
        filter = null;
        checks = false;
        multi = false;
        marks = new List<int>();
        tpl = null;
        rowsStale = true;
        builtFor = 0 - 1;
        ctxRow = 0 - 1;
        ctxX = 0;
        ctxY = 0;
        Empty = "";
        wiresOwnEvents = true;
        Select = new UiEvent();
        Activate = new UiEvent();
        Expand = new UiEvent();
        Collapse = new UiEvent();
        Context = new UiEvent();
        Check = new UiEvent();
        Press = new UiEvent();
        Move = new UiEvent();
        reorder = false;
        pressed = false;
        dragRow = 0 - 1;
        dragging = false;
        dropAt = 0 - 1;
        dropDone = false;
    }
    public TreeView() { InitTree(); }
    public TreeView(NodeOf template) {
        InitTree();
        tpl = template;
    }
    public List<TreeNode> ItemsSource {
        get { return data; }
        set { this.Bind(value); }
    }
    public NodeOf NodeTemplate {
        get { return tpl; }
        set { this.NodeSlot(value); }
    }
    public int FixedRowHeight {
        get { return fixedRowHeight; }
        set { this.WithFixedRowHeight(value); }
    }
    public Input FilterInput {
        get { return filter; }
        set { this.WithFilter(value); }
    }
    public bool ShowCheckboxes {
        get { return checks; }
        set { checks = value; }
    }
    public bool IsMultiSelect {
        get { return multi; }
        set { multi = value; }
    }
    public bool AllowReorder {
        get { return reorder; }
        set { reorder = value; }
    }
    public string EmptyMessage {
        get { return Empty; }
        set { Empty = value != null ? value : ""; }
    }
    public int SelectedIndexValue {
        get { return Value.Get(); }
        set { this.SelectIndex(value); }
    }
    private bool layoutBodyActive;
    public override void CloneContentTo(Control target, CloneTreeFn clone) {
        TreeView copy = (TreeView)target;
        copy.Bind(data);
        copy.NodeSlot(tpl);
        copy.WithFixedRowHeight(fixedRowHeight);
        if (filter != null) { copy.WithFilter((Input)clone(filter)); }
    }
    public override StyleBox ResolveStyle(App app, int state) {
        StyleBox box = base.ResolveStyle(app, state);
        box.overflowX = 0;
        box.overflowY = 0;
        box.overflow = 1;
        return box;
    }
    public override Rect ScrollViewport() {
        Rect view = base.ScrollViewport();
        int fixedH = this.FilterHeight(this.App);
        if (fixedH > view.height) { fixedH = view.height; }
        if (fixedH < 0) { fixedH = 0; }
        return new Rect(view.x, view.y + fixedH, view.width, view.height - fixedH);
    }
    public Control RowControl(int index) { return this.DataRow(index); }
    public int RowCount() { return data.Count; }
    public override void Arrange(int x, int y, int w, int h) {
        bx = x; by = y; bw = w > 0 ? w : 0; bh = h > 0 ? h : 0;
        if (layingRows || rowsBody == null) { return; }
        layingRows = true;
        try {
            App app = this.FindApp();
            Control ownerParent = parent;
            this.BuildRows(app);
            if (this.FindApp() != app || parent != ownerParent || rowsStale) { return; }
        if (filter != null) {
            Rect frame = base.ScrollViewport();
            int pad = app != null ? app.Scale(6) : 6;
            int glyph = app != null ? app.Scale(12) : 12;
            int inset = app != null ? app.Scale(2) : 2;
            filter.Arrange(frame.x + pad * 2 + glyph, frame.y + inset,
                frame.width - pad * 3 - glyph, this.FilterHeight(app) - inset * 2);
        }
            int requested = scroll.Get();
            Rect view = this.ScrollViewport();
            int ticket = rowsRevision;
            rowsBody.Arrange(view.x, view.y, view.width, view.height);
            if (ticket != rowsRevision || this.FindApp() != app || parent != ownerParent) { return; }
            if (requested != rowsBody.ScrollTop()) { rowsBody.SetScrollTop(requested); }
            if (ticket != rowsRevision || this.FindApp() != app || parent != ownerParent) { return; }
            this.LayoutBody();
        } finally { layingRows = false; }
    }
    public override void OnScrollChanged() {
        if (projectingScroll || rowsBody == null) { return; }
        App app = this.FindApp();
        Control ownerParent = parent;
        int ticket = rowsRevision;
        int requested = scrollY;
        if (scroll.Get() != requested) { scroll.Set(requested); }
        if (rowsBody.ScrollTop() != requested) { rowsBody.SetScrollTop(requested); }
        if (ticket != rowsRevision || this.FindApp() != app || parent != ownerParent) { return; }
        this.BodyScrolled();
    }
    public void BodyScrolled() {
        if (rowsBody == null || projectingScroll) { return; }
        projectingScroll = true;
        try {
            int value = rowsBody.ScrollTop();
            if (scroll.Get() != value) { scroll.Set(value); }
            if (scrollY != value || scrollX != 0) { this.CommitScrollOffset(0, value); }
        } finally { projectingScroll = false; }
        if (!layingRows) { this.LayoutBody(); }
    }
    public void LayoutBody() {
        if (rowsBody == null || layoutBodyActive) { return; }
        layoutBodyActive = true;
        try {
        App app = this.FindApp();
        Control ownerParent = parent;
        int ticket = rowsRevision;
        Rect view = rowsBody.ScrollViewport();
        rowsBody.scrollExtent = this.ContentHeight(app);
        rowsBody.scrollExtentX = view.width;
        scrollExtent = rowsBody.scrollExtent;
        scrollExtentX = rowsBody.scrollExtentX;
        int max = rowsBody.scrollExtent - view.height;
        if (max < 0) { max = 0; }
        int off = rowsBody.ScrollTop();
        if (off > max) { off = max; }
        if (off < 0) { off = 0; }
        if (off != rowsBody.ScrollTop()) { rowsBody.CommitScrollOffset(0, off); }
        if (ticket != rowsRevision || this.FindApp() != app || parent != ownerParent) { return; }
        int width = view.width;
        if (rowsBody.scrollExtent > view.height) { width = width - (app != null ? app.Scale(12) : 12); }
        if (width < 0) { width = 0; }
        if (fixedRowHeight > 0) {
            if (scroll.Get() != off) { scroll.Set(off); }
            if (ticket != rowsRevision || this.FindApp() != app || parent != ownerParent) { return; }
            this.BuildRows(app);
            if (ticket != rowsRevision || this.FindApp() != app || parent != ownerParent || rowsStale) { return; }
        }
        int y = view.y - off;
        for (int i = 0; i < data.Count; i = i + 1) {
            Control row = this.DataRow(i);
            bool shown = this.Shown(i);
            int rh = row != null ? this.RowExtent(app, row) : this.RowHeight(app);
            bool onscreen = shown && y + rh > view.y && y < view.y + view.height;
            if (row != null) {
                if (!onscreen && app != null) { app.ReleaseInputSubtree(row); }
                if (ticket != rowsRevision || this.FindApp() != app || parent != ownerParent) { return; }
                if (row.parent == rowsBody) {
                    row.Arrange(view.x, shown ? y : view.y - rh - 1, width, rh);
                    if (ticket != rowsRevision || this.FindApp() != app || parent != ownerParent) { return; }
                }
            }
            if (shown) { y = y + rh; }
        }
        this.BodyScrolled();
        } finally { layoutBodyActive = false; }
    }
    private int DataIndexAt(int x, int y) {
        if (rowsBody == null) { return -1; }
        Rect view = rowsBody.ScrollViewport();
        if (!view.Contains(x, y)) { return -1; }
        int top = view.y - rowsBody.ScrollTop();
        for (int i = 0; i < data.Count; i = i + 1) {
            if (!(this.Shown(i))) { continue; }
            Control row = this.DataRow(i);
            int height = row != null ? this.RowExtent(this.App, row) : this.RowHeight(this.App);
            if (y >= top && y < top + height) { return i; }
            top = top + height;
        }
        return -1;
    }
    public override void OnPointerDown(RoutedEventArgs e) {
        base.OnPointerDown(e);
        if (e.handled || this.IsDisabled()) { return; }
        int index = this.DataIndexAt(e.x, e.y);
        if (index < 0) { return; }
        App app = this.App;
        if (app.window.EventButton() == 1) {
            if (!(multi && this.IsMarked(index))) {
                if (multi) { marks = new List<int>(); }
                Value.Set(index);
            }
            ctxRow = index; ctxX = e.x; ctxY = e.y;
            Context.PostS(this);
            e.Handle();
            return;
        }
        if (app.window.EventButton() != 0) { return; }
        dropDone = false;
        if (e.IsTouch()) { dropDone = true; }
        ctxRow = index; ctxX = e.x; ctxY = e.y;
        Press.PostS(this);
        if (reorder) {
            pressed = true; dragRow = index; dragging = false; dropAt = -1;
            app.CapturePointer(this, true);
        }
    }
    private void UpdateRoutedDrop(RoutedEventArgs e) {
        if (!reorder || !pressed || dragRow < 0) { return; }
        Rect view = rowsBody.ScrollViewport();
        dragging = true;
        dropAt = data.Count;
        int top = view.y - rowsBody.ScrollTop();
        for (int i = 0; i < data.Count; i = i + 1) {
            if (!this.Shown(i)) { continue; }
            Control row = this.DataRow(i);
            int height = row != null ? this.RowExtent(this.App, row) : this.RowHeight(this.App);
            if (e.y < top + height / 2) { dropAt = i; break; }
            top = top + height;
        }
        this.NoteSelfDamage(this.App);
    }
    public override void OnPointerMove(RoutedEventArgs e) {
        base.OnPointerMove(e);
        int row = this.DataIndexAt(e.x, e.y);
        if (hoveredRow != row) { hoveredRow = row; this.NoteSelfDamage(this.App); }
        if (!e.handled) { this.UpdateRoutedDrop(e); }
    }
    public override void OnPointerLeave(RoutedEventArgs e) {
        base.OnPointerLeave(e);
        hoveredRow = -1;
    }
    public override void OnPointerUp(RoutedEventArgs e) {
        base.OnPointerUp(e);
        App app = this.App;
        if (e.handled || app.window.EventButton() != 0 || !pressed) { return; }
        if (dragging) { this.UpdateRoutedDrop(e); }
        bool moved = dragging && dropAt >= 0 && dropAt != dragRow && dropAt != dragRow + 1;
        pressed = false; dragging = false;
        if (app.GetCapturedPointer() == this) { app.ReleasePointerCapture(); }
        if (moved) { dropDone = true; Move.PostS(this); }
    }
    public override void OnPointerCancel(RoutedEventArgs e) {
        base.OnPointerCancel(e);
        pressed = false; dragging = false; dropAt = -1;
        App app = this.App;
        if (app != null && app.GetCapturedPointer() == this) { app.ReleasePointerCapture(); }
    }
    public override void OnClick(RoutedEventArgs e) {
        base.OnClick(e);
        if (e.handled || this.IsDisabled() || dropDone) { return; }
        int index = this.DataIndexAt(e.x, e.y);
        if (index < 0) { return; }
        App app = this.App;
        if (checks && e.x >= rowsBody.bx + app.theme.paddingSmall
            && e.x < rowsBody.bx + app.theme.paddingSmall + app.Scale(16)) {
            TreeView.ToggleCheck(data, index);
            ctxRow = index;
            Check.PostS(this);
            this.NoteSelfDamage(app);
            e.Handle();
            return;
        }
            TreeNode n = data[index];
            int mods = e.modifiers;
            if (multi && Modifiers.HasCtrl(mods)) {
                bool was = false;
                for (int mi = 0; mi < marks.Count; mi = mi + 1) {
                    if (marks[mi] == index) { marks.RemoveAt(mi); was = true; break; }
                }
                if (Value.Get() == index) { Value.Set(0 - 1); was = true; }
                if (!was) {
                    if (Value.Get() < 0) { Value.Set(index); }
                    else { marks.Add(index); }
                }
                ctxRow = index;
                this.NoteSelfDamage(app);
                return;
            }
            if (multi && Modifiers.HasShift(mods) && Value.Get() >= 0) {
                int a = Value.Get();
                int b = index;
                if (b < a) { int tmp = a; a = b; b = tmp; }
                int r = a;
                while (r <= b) {
                    if (!this.IsMarked(r) && this.Shown(r)) { marks.Add(r); }
                    r = r + 1;
                }
                ctxRow = index;
                this.NoteSelfDamage(app);
                return;
            }
            bool moved = Value.Get() != index;
            if (multi) { marks = new List<int>(); }
            Value.Set(index);
            ctxRow = index;
            if (n.isDir) {
                n.expanded = !n.expanded;
                this.LayoutBody();
                if (n.expanded) { Expand.PostS(this); } else { Collapse.PostS(this); }
            }
            if (moved) { Select.PostS(this); }
            if (e.isDoubleClick) { Activate.PostS(this); }
            this.NoteSelfDamage(app);
        e.Handle();
    }
    public override void OnRoutedEvent(RoutedEventArgs e) {
        if (!e.handled && e.eventName == "LongPress" && !this.IsDisabled()) {
            int index = this.DataIndexAt(e.x, e.y);
            if (index >= 0) {
                if (!(multi && this.IsMarked(index))) {
                    if (multi) { marks = new List<int>(); }
                    Value.Set(index);
                }
                ctxRow = index; ctxX = e.x; ctxY = e.y;
                pressed = false; dragging = false; dragRow = -1; dropAt = -1;
                App app = this.App;
                if (app.GetCapturedPointer() == this) { app.ReleasePointerCapture(); }
                Context.PostS(this);
                this.NoteSelfDamage(app);
                e.Handle();
            }
        }
        if (!e.handled) { base.OnRoutedEvent(e); }
    }
    public override string Kind() { return "TreeView"; }
    protected override List<PropSpec> DefineProps() {
        List<PropSpec> ps = new List<PropSpec>();
        ps.Add(PropSpec.Int("value", "Selected").DefaultBinding().Field("Value", 1).Also("data").Also("sel"));
        ps.Add(PropSpec.Bool("checks", "Checkboxes").Field("checks", 2));
        ps.Add(PropSpec.Bool("multi", "Multi select").Field("multi", 2));
        ps.Add(PropSpec.Bool("reorder", "Drag reorder").Field("reorder", 2).WithTip("Allow dragging nodes to move or re-parent them."));
        ps.Add(PropSpec.Text("empty", "Empty text").Field("Empty", 0));
        return ps;
    }
    public override string GetProp(string key) {
        if (key == "data" || key == "value" || key == "sel") {
            return Convert.ToString(Value != null ? Value.Get() : -1);
        }
        if (key == "empty") { return Empty; }
        return base.GetProp(key);
    }
    public override void SetProp(string key, string val) {
        if (key == "data" || key == "value" || key == "sel") {
            int idx = Convert.ToInt32(val);
            if (Value != null) { Value.Set(idx); }
            return;
        }
        if (key == "empty") { Empty = val; return; }
        base.SetProp(key, val);
    }
    public override void CollectInputFocus(App app, List<Control> controls) {
        this.Arrange(bx, by, bw, bh);
        base.CollectInputFocus(app, controls);
    }
    public override Control FindInputFocus(App app) {
        this.Arrange(bx, by, bw, bh);
        return base.FindInputFocus(app);
    }
    public override string StyleType() { return "tree"; }
    public void Bind(List<TreeNode> nodes) {
        if (nodes == null) { data = new List<TreeNode>(); }
        else { data = nodes; }
        this.RetireRows();
        if (Value.Get() >= data.Count) { Value.Set(0 - 1); }
        int mi = marks.Count - 1;
        while (mi >= 0) {
            if (marks[mi] >= data.Count) { marks.RemoveAt(mi); }
            mi = mi - 1;
        }
    }
    public void Refresh() {
        if (!Dispatcher.CheckUiThread()) {
            TreeRefreshAction action = new TreeRefreshAction(this);
            Dispatcher.Post(action.Run);
            return;
        }
        this.RetireRows();
    }
    public void WithFilter(Input f) {
        if (filter == f) { return; }
        filterRevision = filterRevision + 1;
        int ticket = filterRevision;
        Input previous = filter;
        filter = null;
        if (previous != null) { this.Remove(previous); }
        if (ticket != filterRevision) { return; }
        if (f != null) {
            base.Add(f);
            if (ticket != filterRevision) { return; }
            if (f.parent == this) { filter = f; }
        }
    }
    protected override Control HitTestCore(int x, int y, int pointerType, List<Control> excludedSubtrees) {
        if (!this.StyleVisible() || !this.ContainsPoint(x, y, pointerType)) { return null; }
        this.Arrange(bx, by, bw, bh);
        return base.HitTestCore(x, y, pointerType, excludedSubtrees);
    }
    public void WithChecks() { checks = true; }
    public void WithMultiSelect() { multi = true; }
    public void WithReorder() { reorder = true; }
    public int MoveFrom() { return dragRow; }
    public int MoveTo() { return dropAt; }
    public int Count() { return data.Count; }
    public void ScrollToEnd() { scroll.Set(1000000000); }
    public List<TreeNode> Nodes() { return data; }
    public bool Has(int row) { return row >= 0 && row < data.Count; }
    public TreeNode NodeAt(int row) { return data[row]; }
    public int SelectedIndex() { return Value.Get(); }
    public bool HasSelection() { return this.Has(Value.Get()); }
    public TreeNode Selected() { return data[Value.Get()]; }
    public void SelectIndex(int row) {
        if (row < 0 - 1 || row >= data.Count) { return; }
        if (Value.Get() == row) { return; }
        Value.Set(row);
        Select.PostS(this);
    }
    public void ClearSelection() {
        Value.Set(0 - 1);
        marks = new List<int>();
    }
    public bool IsMarked(int row) {
        if (row < 0) { return false; }
        if (row == Value.Get()) { return true; }
        for (int i = 0; i < marks.Count; i = i + 1) {
            if (marks[i] == row) { return true; }
        }
        return false;
    }
    public List<int> SelectedIndices() {
        List<int> outp = new List<int>();
        int n = data.Count;
        for (int i = 0; i < n; i = i + 1) {
            if (this.IsMarked(i)) { outp.Add(i); }
        }
        return outp;
    }
    public int SelectionCount() { return this.SelectedIndices().Count; }
    public int ContextRow() { return ctxRow; }
    public int ContextX() { return ctxX; }
    public int ContextY() { return ctxY; }
    public void OnSelect(Action a) { Select.Add(a); }
    public void OnActivate(Action a) { Activate.Add(a); }
    public void OnExpand(Action a) { Expand.Add(a); }
    public void OnCollapse(Action a) { Collapse.Add(a); }
    public void OnContext(Action a) { Context.Add(a); }
    public void OnCheck(Action a) { Check.Add(a); }
    public void OnPress(Action a) { Press.Add(a); }
    public void OnMove(Action a) { Move.Add(a); }
    public void EmptyText(string text) { Empty = text; }
    public void ExpandAll() {
        for (int k = 0; k < data.Count; k = k + 1) {
            if (data[k].isDir) { data[k].expanded = true; }
        }
        this.LayoutBody();
    }
    public void CollapseAll() {
        for (int k = 0; k < data.Count; k = k + 1) {
            if (data[k].isDir) { data[k].expanded = false; }
        }
        this.LayoutBody();
    }
    public void SetAllChecked(bool on) {
        for (int k = 0; k < data.Count; k = k + 1) { data[k].checked = on; }
    }
    public void Toggle(int row) {
        if (!this.Has(row)) { return; }
        TreeView.ToggleCheck(data, row);
    }
    public List<int> CheckedIndices() {
        List<int> res = new List<int>();
        for (int k = 0; k < data.Count; k = k + 1) {
            if (data[k].checked) { res.Add(k); }
        }
        return res;
    }
    public List<string> CheckedLabels() {
        List<string> res = new List<string>();
        for (int k = 0; k < data.Count; k = k + 1) {
            if (data[k].checked && !data[k].isDir) { res.Add(data[k].label); }
        }
        return res;
    }
    public int CheckedCount() { return this.CheckedLabels().Count; }
    public void NodeSlot(NodeOf template) {
        tpl = template;
        this.RetireRows();
    }
    public bool HasExtraNodes() {
        if (data == null) { return false; }
        for (int i = 0; i < data.Count; i = i + 1) {
            if (data[i].extra != null) { return true; }
        }
        return false;
    }
}
