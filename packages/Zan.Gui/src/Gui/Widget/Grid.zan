using System;
using Gui;
namespace Gui.Widget;
[GuiKind("Grid")]
public class Grid : Control {
    public override Control CreateCloneShell() { return new Grid(); }
    private int cols;
    private int minColW;
    private int lastW;
    private int measW;
    private void InitGrid(int n) {
        this.InitControl("grid");
        cols = n;
        minColW = 0;
        lastW = 0;
        measW = 0;
    }
    public Grid() { InitGrid(1); }
    public static Grid Of(int n) {
        Grid g = new Grid();
        g.SetCols(n);
        return g;
    }
    public override string Kind() { return "Grid"; }
    public override string StyleType() { return "grid"; }
    public int ColumnCount {
        get { return this.cols; }
        set { this.SetCols(value); }
    }
    public int MinColumnPx {
        get { return this.minColW; }
        set { this.MinColumn(value); }
    }
    public void SetCols(int n) { cols = n; }
    public void MinColumn(int px) { minColW = px; }
    public int ResolvedCols(int cw) {
        int n = cols;
        if (n < 1) { n = this.StyleColumns(0); }
        if (n < 1) { n = 1; }
        if (minColW > 0 && cw > 0) {
            int fit = (cw + this.ColGapPx()) / (minColW + this.ColGapPx());
            if (fit < 1) { fit = 1; }
            if (fit < n) { n = fit; }
        }
        return n;
    }
    public int ColGapPx() { return this.StyleColGap(this.StyleGap()); }
    public int RowGapPx() { return this.StyleRowGap(this.StyleGap()); }
    public static int SpanOf(Control c) {
        if (c is GridItem) {
            GridItem gi = (GridItem)c;
            return gi.Span();
        }
        return 1;
    }
    public static int OffsetOf(Control c) {
        if (c is GridItem) {
            GridItem gi = (GridItem)c;
            return gi.Offset();
        }
        return 0;
    }
    public static int ColEdge(int cw, int gap, int n, int i) { return (cw + gap) * i / n; }
    public static int SpanWidth(int cw, int gap, int n, int at, int span) {
        int w = Grid.ColEdge(cw, gap, n, at + span) - gap
            - Grid.ColEdge(cw, gap, n, at);
        if (w < 0) { w = 0; }
        return w;
    }
    public int PlaceSlots(int n, List<Control> items, List<GridSlotPlacement> outSlots) {
        int row = 0;
        int cursor = 0;
        for (int i = 0; i < items.Count; i = i + 1) {
            Control c = items[i];
            int span = Grid.SpanOf(c);
            if (span > n) { span = n; }
            int off = Grid.OffsetOf(c);
            if (off > n - span) { off = n - span; }
            if (off < 0) { off = 0; }
            if (cursor > 0 && cursor + off + span > n) {
                row = row + 1;
                cursor = 0;
                off = Grid.OffsetOf(c);
                if (off > n - span) { off = n - span; }
                if (off < 0) { off = 0; }
            }
            if (outSlots != null) { outSlots.Add(new GridSlotPlacement(row, cursor + off, span)); }
            cursor = cursor + off + span;
            if (cursor >= n) {
                row = row + 1;
                cursor = 0;
            }
        }
        if (cursor > 0) { row = row + 1; }
        return row;
    }
    public List<Control> VisibleItems() {
        List<Control> items = new List<Control>();
        for (int i = 0; i < this.ChildCount(); i = i + 1) {
            if (this.ChildAt(i).StyleVisible()) { items.Add(this.ChildAt(i)); }
        }
        return items;
    }
    public override void OnMeasure(App app) {
        List<Control> items = this.VisibleItems();
        if (items.Count == 0) { return; }
        int cw = lastW;
        if (prefSet && prefW > 0) { cw = prefW - this.StylePadL() - this.StylePadR(); }
        int n = this.ResolvedCols(cw);
        List<GridSlotPlacement> slots = new List<GridSlotPlacement>();
        int rows = this.PlaceSlots(n, items, slots);
        List<int> rowHeights = new List<int>();
        for (int r = 0; r < rows; r = r + 1) { rowHeights.Add(0); }
        for (int i = 0; i < items.Count; i = i + 1) {
            int r = slots[i].row;
            int h = items[i].prefH;
            if (h > rowHeights[r]) { rowHeights[r] = h; }
        }
        int declared = this.StyleLineHeight();
        if (declared > 0) {
            for (int r = 0; r < rows; r = r + 1) { rowHeights[r] = declared; }
        }
        int total = 0;
        for (int r = 0; r < rows; r = r + 1) { total = total + rowHeights[r]; }
        if (rows > 1) { total = total + this.RowGapPx() * (rows - 1); }
        if (prefH <= 0 && total > 0) { prefH = total + this.StylePadT() + this.StylePadB(); }
        if (measW != lastW) {
            measW = lastW;
            app.RequestRedraw();
        }
    }
    public override void Arrange(int px, int py, int pw, int ph) {
        if (pw < 0) { pw = 0; }
        if (ph < 0) { ph = 0; }
        bx = px;
        by = py;
        bw = pw;
        bh = ph;
        int cx = px + this.StylePadL();
        int cy = py + this.StylePadT();
        int cw = pw - this.StylePadL() - this.StylePadR();
        int ch = ph - this.StylePadT() - this.StylePadB();
        if (cw < 0) { cw = 0; }
        if (ch < 0) { ch = 0; }
        lastW = cw;
        List<Control> items = this.VisibleItems();
        if (items.Count == 0) { return; }
        int n = this.ResolvedCols(cw);
        int xg = this.ColGapPx();
        int yg = this.RowGapPx();
        List<GridSlotPlacement> slots = new List<GridSlotPlacement>();
        int rows = this.PlaceSlots(n, items, slots);
        List<int> hs = new List<int>();
        for (int r = 0; r < rows; r = r + 1) { hs.Add(0); }
        for (int i = 0; i < items.Count; i = i + 1) {
            int r = slots[i].row;
            int h = items[i].prefH;
            if (h > hs[r]) { hs[r] = h; }
        }
        int declared = this.StyleLineHeight();
        if (declared > 0) {
            for (int r = 0; r < rows; r = r + 1) { hs[r] = declared; }
        }
        List<int> tops = new List<int>();
        int y = 0;
        for (int r = 0; r < rows; r = r + 1) {
            tops.Add(y);
            y = y + hs[r] + yg;
        }
        for (int i = 0; i < items.Count; i = i + 1) {
            Control c = items[i];
            int left = Grid.ColEdge(cw, xg, n, slots[i].col);
            int w = Grid.SpanWidth(cw, xg, n, slots[i].col, slots[i].span);
            c.Arrange(cx + left, cy + tops[slots[i].row], w, hs[slots[i].row]);
        }
    }
    protected override List<PropSpec> DefineProps() {
        List<PropSpec> ps = new List<PropSpec>();
        ps.Add(PropSpec.Int("cols", "Columns").Field("cols", 1).Also("columns"));
        ps.Add(PropSpec.Int("minColumn", "Min Column Width").Field("minColW", 1).Also("min-column"));
        ps.Add(this.SizeProp());
        return ps;
    }
    public override string GetProp(string key) {
        if (key == "cols" || key == "columns") { return Convert.ToString(cols); }
        if (key == "min-column" || key == "minColumn") { return Convert.ToString(minColW); }
        return base.GetProp(key);
    }
    public override void SetProp(string key, string val) {
        if (key == "cols" || key == "columns") {
            cols = Convert.ToInt32(val);
            return;
        }
        if (key == "min-column" || key == "minColumn") {
            minColW = Convert.ToInt32(val);
            return;
        }
        base.SetProp(key, val);
    }
    public override bool SetExtra(string key, string val) {
        if (key == "cols" || key == "columns" || key == "min-column" || key == "minColumn") {
            this.SetProp(key, val);
            return true;
        }
        return base.SetExtra(key, val);
    }
    public override string GetExtra(string key) {
        if (key == "cols" || key == "columns" || key == "min-column" || key == "minColumn") {
            return this.GetProp(key);
        }
        return base.GetExtra(key);
    }
}
