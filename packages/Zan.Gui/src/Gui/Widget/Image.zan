using System;
using System.IO;
using Gui;
namespace Gui.Widget;
public class Image : Control {
    public override Control CreateCloneShell() { return new Image(); }
    public Binding<string> Src;
    public string Alt;
    public string Fit;
    // 图片就绪（已解码并缓存）。工作线程触发时自动封送回 UI 线程。
    [Event]
    public UiEvent Loaded;
    // 解码失败、URL 取回失败或超时。
    [Event]
    public UiEvent Error;
    private string resolvedSrc;  // 已解析过的 Src；null = 尚未解析
    private string imgKey;  // 绘制用 key：文件路径或 mem: 注册 key
    private int imgW;  // 已知像素尺寸
    private int imgH;
    private int loadState;  // 0 占位/加载中，1 已加载，2 失败
    private bool isSvg;
    private string svgText;  // SVG 源文本（文件 / URL / 非 base64 data URI）
    private byte[] svgBytes;  // SVG 源字节（base64 data URI）
    private int svgBytesLen;
    private string svgBaseKey;  // SVG 的固有尺寸注册 key
    private string svgRasterKey;  // 当前按盒子尺寸光栅的注册 key
    private int svgRasterW;
    private int svgRasterH;
    public void InitImage(string src, string alt, string fit) {
        this.InitControl("image");
        styleSurfaceOwned = true;
        Src = src != null ? src : "";
        Alt = alt != null ? alt : "";
        Fit = fit != null ? fit : "";
        Loaded = new UiEvent();
        Error = new UiEvent();
        resolvedSrc = null;
        imgKey = "";
        imgW = 0;
        imgH = 0;
        loadState = 0;
        isSvg = false;
        svgText = "";
        svgBytes = null;
        svgBytesLen = 0;
        svgBaseKey = "";
        svgRasterKey = "";
        svgRasterW = 0;
        svgRasterH = 0;
    }
    public Image() { InitImage("", "", ""); }
    public Image(string src) { InitImage(src, "", ""); }
    public Image(string src, string alt) { InitImage(src, alt, ""); }
    public Image(string src, string alt, string fit) { InitImage(src, alt, fit); }
    public string FitMode() {
        if (Fit == "cover") { return "cover"; }
        if (Fit == "fill") { return "fill"; }
        if (Fit == "none") { return "none"; }
        return "contain";
    }
    private void Resolve(App app) {
        string src = "";
        if (Src != null) { src = Src.Get(); }
        if (src == null) { src = ""; }
        if (resolvedSrc != null && src == resolvedSrc) { return; }
        resolvedSrc = src;
        this.ResetState();
        if (src == "") { return; }
        if (src.StartsWith("data:")) { this.ResolveDataUri(src); return; }
        if (src.StartsWith("http://") || src.StartsWith("https://")) {
            this.ResolveUrl(app, src);
            return;
        }
        if (src.ToLower().EndsWith(".svg")) { this.ResolveSvgFile(src); return; }
        this.ResolveFile(src);
    }
    private void ResetState() {
        loadState = 0;
        imgW = 0;
        imgH = 0;
        imgKey = "";
        isSvg = false;
        svgText = "";
        svgBytes = null;
        svgBytesLen = 0;
        svgBaseKey = "";
        svgRasterKey = "";
        svgRasterW = 0;
        svgRasterH = 0;
    }
    private void MarkLoaded(int w, int h) {
        imgW = w;
        imgH = h;
        loadState = 1;
        if (Loaded != null) { Loaded.Post(this); }
    }
    private void ResolveFile(string src) {
        imgKey = src;
        int w = Canvas.ImageWidth(src);
        if (w > 0) {
            this.MarkLoaded(w, Canvas.ImageHeight(src));
        } else {
            loadState = 2;
        }
    }
    private void ResolveSvgFile(string path) {
        string text = File.ReadAllText(path);
        if (text == null || text.Length == 0) {
            loadState = 2;
            return;
        }
        isSvg = true;
        svgText = text;
        svgBaseKey = "mem:s" + StrHash(path);
        this.RasterSvg(0, 0);
    }
    private void ResolveDataUri(string src) {
        int comma = src.IndexOf(",");
        if (comma < 0) { loadState = 2; return; }
        string head = src.Substring(0, comma).ToLower();
        string payload = src.Substring(comma + 1);
        if (head.Contains("svg")) {
            isSvg = true;
            svgBaseKey = "mem:d" + StrHash(src);
            if (head.Contains(";base64")) {
                svgBytes = Convert.FromBase64String(payload);
                if (svgBytes == null || svgBytes.Length <= 0) {
                    loadState = 2;
                    return;
                }
                svgBytesLen = svgBytes.Length;
            } else {
                svgText = payload;
            }
            this.RasterSvg(0, 0);
            return;
        }
        if (!head.Contains(";base64")) { loadState = 2; return; }
        byte[] bytes = Convert.FromBase64String(payload);
        if (bytes == null || bytes.Length <= 0) { loadState = 2; return; }
        imgKey = "mem:b" + StrHash(src);
        int w = Canvas.ImageLoadMem(imgKey, bytes, bytes.Length);
        if (w > 0) {
            this.MarkLoaded(w, Canvas.ImageHeight(imgKey));
        } else {
            loadState = 2;
        }
    }
    private void ResolveUrl(App app, string src) {
        imgKey = "mem:u" + StrHash(src);
        int w = Canvas.ImageWidth(imgKey);
        if (w > 0) {
            this.MarkLoaded(w, Canvas.ImageHeight(imgKey));
            return;
        }
        loadState = 0;
        UrlFetchFn fetcher = GuiWidgetState.Current().urlFetcher;
        if (fetcher != null) {
            fetcher(app, this, src, imgKey);
        } else {
            loadState = 2;
        }
    }
    public delegate void UrlFetchFn(App app, Image img, string src, string key);
    public static bool HasUrlFetcher() { return GuiWidgetState.Current().urlFetcher != null; }
    public static void SetUrlFetcher(UrlFetchFn fn) { GuiWidgetState.Current().urlFetcher = fn; }
    public delegate string UrlEnsureFn(App app, string url);
    public static void SetUrlEnsurer(UrlEnsureFn fn) { GuiWidgetState.Current().urlEnsurer = fn; }
    public static string EnsureUrl(App app, string url) {
        UrlEnsureFn ensurer = GuiWidgetState.Current().urlEnsurer;
        if (ensurer == null) { return null; }
        return ensurer(app, url);
    }
    private void RasterSvg(int boxW, int boxH) {
        string key = svgBaseKey;
        if (boxW > 0 && boxH > 0) { key = svgBaseKey + "@" + boxW + "x" + boxH; }
        int w = 0;
        if (svgBytes != null) {
            w = Canvas.ImageLoadSvg(key, svgBytes, svgBytesLen, boxW, boxH);
        } else if (svgText != null && svgText != "") {
            w = Canvas.ImageLoadSvg(key, svgText, boxW, boxH);
        }
        if (w <= 0) { loadState = 2; return; }
        if (svgRasterKey != "" && svgRasterKey != key) { Canvas.EvictImage(svgRasterKey); }
        svgRasterKey = key;
        svgRasterW = w;
        svgRasterH = Canvas.ImageHeight(key);
        imgKey = key;
        imgW = w;
        imgH = svgRasterH;
        loadState = 1;
    }
    public void OnFetched(string key, int w, int h) {
        if (key != imgKey || loadState == 1) { return; }
        this.MarkLoaded(w, h);
    }
    public void OnSvgFetched(string text) {
        if (loadState == 1) { return; }
        if (text == null || text == "") {
            loadState = 2;
            if (Error != null) { Error.Post(this); }
            return;
        }
        isSvg = true;
        svgText = text;
        svgBaseKey = imgKey;
        this.RasterSvg(0, 0);
        if (loadState == 1 && Loaded != null) { Loaded.Post(this); }
    }
    public void OnFetchFailed() {
        if (loadState == 1) { return; }
        loadState = 2;
        if (Error != null) { Error.Post(this); }
    }
    public void Reload() {
        if (imgKey != "" && (imgKey.StartsWith("mem:u") || svgRasterKey != "")) { Canvas.EvictImage(imgKey); }
        resolvedSrc = null;
    }
    public static long StrHash(string s) {
        long h = 5381;
        if (s == null) { return h; }
        for (int i = 0; i < s.Length; i = i + 1) {
            h = (h * 33 + (s[i] & 255)) % 2147483647;
        }
        return h;
    }
    public static int ScaleTo(int v, int num, int den) {
        if (den <= 0) { return v; }
        return (int)(((long)v * (long)num * 2 + (long)den) / ((long)den * 2));
    }
    // ---- 保留模式钩子（Control）-------------------------------------

    // 测量：CSS 尺寸优先，缺一边时按已加载图片的纵横比补齐，
    // 未加载时兜底 96x96。
    public override void OnMeasure(App app) {
        if (app == null) { return; }
        this.Resolve(app);
        StyleBox s = this.ResolveStyleCached(app, "image", Class, Style.SNormal());
        int cssW = s.WidthOr(-1);
        int cssH = s.HeightOr(-1);
        int dw = 96;
        int dh = 96;
        if (cssW > 0 && cssH > 0) {
            dw = cssW;
            dh = cssH;
        } else if (loadState == 1 && imgW > 0 && imgH > 0) {
            if (cssW > 0) {
                dw = cssW;
                dh = this.ScaleTo(cssW, imgH, imgW);
            } else if (cssH > 0) {
                dh = cssH;
                dw = this.ScaleTo(cssH, imgW, imgH);
            } else {
                dw = app.Scale(imgW);
                dh = app.Scale(imgH);
            }
        } else {
            if (cssW > 0) { dw = cssW; }
            if (cssH > 0) { dh = cssH; }
        }
        prefW = dw;
        prefH = dh;
    }
    public override void OnPaint(App app) {
        if (app == null || app.canvas == null) { return; }
        this.Resolve(app);
        if (bw <= 0 || bh <= 0) { return; }
        Canvas c = app.canvas;
        StyleBox s = this.ResolveStyleCached(app, "image", Class, Style.SNormal());
        s.Paint(app, bx, by, bw, bh);
        if (loadState == 1 && imgW > 0 && imgH > 0) {
            if (isSvg && (bw != svgRasterW || bh != svgRasterH)) { this.RasterSvg(bw, bh); }
            if (loadState == 1) {
                this.BlitFitted(app, c);
                return;
            }
        }
        this.DrawPlaceholder(app, c, s);
    }
    private void BlitFitted(App app, Canvas c) {
        c.PushClip(bx, by, bw, bh);
        try {
            string fit = this.FitMode();
            if (fit == "fill") {
                c.BlitImage(imgKey, bx, by, bw, bh, 0, 0, 0, 0);
            } else if (fit == "none") {
                int dw = app.Scale(imgW);
                int dh = app.Scale(imgH);
                c.BlitImage(imgKey, bx + (bw - dw) / 2, by + (bh - dh) / 2,
                            dw, dh, 0, 0, 0, 0);
            } else if (fit == "cover") {
                int sw = imgW;
                int sh = imgH;
                int sx = 0;
                int sy = 0;
                if ((long)bw * (long)imgH >= (long)bh * (long)imgW) {
                    sh = this.ScaleTo(imgW, bh, bw);
                    sy = (imgH - sh) / 2;
                } else {
                    sw = this.ScaleTo(imgH, bw, bh);
                    sx = (imgW - sw) / 2;
                }
                c.BlitImage(imgKey, bx, by, bw, bh, sx, sy, sw, sh);
            } else {
                int dw = bw;
                int dh = bh;
                if ((long)bw * (long)imgH <= (long)bh * (long)imgW) {
                    dh = this.ScaleTo(bw, imgH, imgW);
                } else {
                    dw = this.ScaleTo(bh, imgW, imgH);
                }
                c.BlitImage(imgKey, bx + (bw - dw) / 2, by + (bh - dh) / 2,
                            dw, dh, 0, 0, 0, 0);
            }
        } finally {
            c.PopClip();
        }
    }
    private void DrawPlaceholder(App app, Canvas c, StyleBox s) {
        string label = Alt;
        if (label == null) { label = ""; }
        if (label == "" && loadState == 2) { label = "..."; }
        if (label == "") { return; }
        c.DrawTextCentered(bx, by, bw, bh, label, s.FgOr(0),
                           s.FontOr(app.Scale(13)));
    }
    // ---- 设计器 / 序列化模型 ---------------------------------------

    // 换图源：写绑定并作废已解析的路径缓存。
    public void SetSrc(string v) {
        string safe = v != null ? v : "";
        if (Src != null) { Src.Set(safe); } else { Src = safe; }
        resolvedSrc = null;
    }

    // 设计器属性面：src / alt / fit / class。
    protected override List<PropSpec> DefineProps() {
        List<PropSpec> ps = new List<PropSpec>();
        ps.Add(PropSpec.Text("src", "Src").DefaultBinding().Field("Src").Setter("SetSrc"));
        ps.Add(PropSpec.TextField("Alt"));
        PropSpec fit = PropSpec.Enum("fit", "Fit",
            new List<string>{ "contain", "cover", "fill", "none" });
        // 实时绑定 Fit 字段本身（选项文本即取值）。此前绑的是
        // FitIndex() 方法返回值的快照——SetProp 经 PropOf 命中这张
        // 游离 spec，写入永远落不到控件（SetExtra 的活路被
        // PropOf-first 管线挡住）。
        fit.Field("Fit");
        ps.Add(fit);
        return ps;
    }

    // FitMode 的枚举序号（设计器 fit 下拉用）：0 contain / 1 cover /
    // 2 fill / 3 none。
    public int FitIndex() {
        string f = this.FitMode();
        if (f == "cover") { return 1; }
        if (f == "fill") { return 2; }
        if (f == "none") { return 3; }
        return 0;
    }
}
