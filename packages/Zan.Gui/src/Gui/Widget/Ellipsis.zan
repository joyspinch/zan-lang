using System;
using Gui;
namespace Gui.Widget;
public class Ellipsis {
    public static string Fit(string text, int w, int fs) { return Fit(text, w, fs, "...", false); }
    public static string Fit(string text, int w, int fs, string suffix, bool keepOversizeSuffix) {
        if (w <= 0) { return ""; }
        if (Canvas.MeasureText(text, fs) <= w) { return text; }
        return FitOverflow(text, w, fs, suffix, keepOversizeSuffix);
    }
    internal static string FitOverflow(string text, int w, int fs) {
        return FitOverflow(text, w, fs, "...", false);
    }
    internal static string FitOverflow(string text, int w, int fs, string suffix, bool keepOversizeSuffix) {
        int budget = w - Canvas.MeasureText(suffix, fs);
        if (budget <= 0) { return budget == 0 || keepOversizeSuffix ? suffix : ""; }
        int lo = 0;
        int hi = text.Length;
        while (lo < hi) {
            int mid = Text.ClampCharStart(text, hi - (hi - lo) / 2);
            if (mid == lo) { mid = Text.NextCharEnd(text, lo); }
            if (Canvas.MeasureText(Text.Left(text, mid), fs) <= budget) { lo = mid; }
            else { hi = Text.PrevCharStart(text, mid); }
        }
        string result = Text.Left(text, lo) + suffix;
        while (lo > 0 && Canvas.MeasureText(result, fs) > w) {
            lo = Text.PrevCharStart(text, lo);
            result = Text.Left(text, lo) + suffix;
        }
        return result;
    }
}
