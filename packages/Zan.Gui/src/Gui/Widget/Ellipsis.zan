using System;
using Gui;

namespace Gui.Widget;

// 省略号（Ellipsis）：单行文本自适应宽度截断计算算法。
// 纯算法类，彻底物理删除所有画布微绘与即时模式 Render 入口。
public class Ellipsis {
    // 字体大小 `fs` 下若 `text` 能在 `w` 像素内放下则原样返回，
    // 否则返回放得下的最长前缀加尾部 "..."。纯字符串算法。
    public static string Fit(string text, int w, int fs) {
        if (w <= 0) { return ""; }
        if (Canvas.MeasureText(text, fs) <= w) { return text; }
        int dotsW = Canvas.MeasureText("...", fs);
        int budget = w - dotsW;
        if (budget <= 0) { return "..."; }
        int n = text.Length;
        int lo = 0;
        int hi = n;
        while (lo < hi) {
            int mid = (lo + hi + 1) / 2;
            if (Canvas.MeasureText(text.Substring(0, mid), fs) <= budget) { lo = mid; }
            else { hi = mid - 1; }
        }
        lo = Text.ClampCharStart(text, lo);
        return text.Substring(0, lo) + "...";
    }
}
