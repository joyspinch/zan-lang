using System;
using System.Collections.Generic;
using Gui;

namespace Gui.Widget;

// is-date-disabled 回调（Naive UI 的 is-date-disabled prop）：
// 返回 true 表示该日禁用——灰显、不可点选。
public delegate bool DateFilter(DateTime d);

// 日历（Naive UI Calendar）：纯声明式组件对象树与现代盒模型。
// 内部完全由 Header（Button/Label）、星期条（Label 网格）、42 个日期单元格（CalendarCell）
// 以及底部动作栏组合而成，彻底物理消除所有裸画布微绘与离散 HitTester 分配。
public class Calendar : Control {
    // 显示模式：month | panel（Binding<string>，设计器可读写）。
    public Binding<string> Mode;
    // 双向绑定选中日期字符串 (YYYY-MM-DD)
    public Binding<string> data;
    // 选中日期（当天 00:00）；null = 未选。
    public DateTime selected;
    // 视图所在年月：跟随选中日、翻页箭头与"今天"。
    public int viewYear;
    // 视图所在月（1–12）。
    public int viewMonth;
    // 选中变化（on-update:value）。
    public UiEvent Change;
    // 可见月份变化（on-panel-change）。
    public UiEvent PanelChange;
    // 该回调返回 true 的日期不可选（Naive UI is-date-disabled）。
    public DateFilter IsDateDisabled;
    // 逐日议程，见 CalendarMark。
    public List<CalendarMark> marks;

    // 兼容历史调用字段与桩函数
    public int baseId;
    public bool idsReady;

    // 内部声明式子组件
    public Control headerBox;
    public Button prevBtn;
    public Label titleLabel;
    public Button nextBtn;
    public Button todayBtn;

    public Control weekdayBox;
    public List<Label> weekdayLabels;

    public Control gridBox;
    public List<CalendarCell> cells;

    public Control footerBox;
    public Button nowBtn;
    public Button clearBtn;

    // 默认选中今天、视图停在当月。
    public Calendar() {
        this.InitControl("calendar", 5);
        this.ClassName = "calendar col";
        Mode = "month";
        Change = new UiEvent();
        PanelChange = new UiEvent();
        marks = new List<CalendarMark>();
        baseId = 0;
        idsReady = false;
        wiresOwnEvents = false;

        DateTime today = DateTime.Now();
        selected = Calendar.DayOf(today);
        viewYear = today.Year();
        viewMonth = today.Month();

        this.BuildTree();
    }

    // 以选中日期构造（视图带到该月）。
    public Calendar(DateTime value) : this() {
        this.SetDate(value);
    }

    // ---- 纯几何 / 文本助手（无 App，回归测试直接断言）------------

    // 把任意时刻归一化到当天 00:00，使选中值、议程与网格单元
    // 之间的相等比较都落在同一天。
    public static DateTime DayOf(DateTime t) {
        return DateTime.FromDate(t.Year(), t.Month(), t.Day());
    }

    // 今天 00:00。
    public static DateTime TodayRef() {
        return Calendar.DayOf(DateTime.Now());
    }

    // 月视图网格的起始格：本月 1 号落在 7 列里的第几格（0=周日列）。
    public static int GridStart(int year, int month) {
        return DateTime.FromDate(year, month, 1).DayOfWeek();
    }

    // 网格第 index 格（0..41）对应的日期：前导格属于上月、尾部格
    // 属于下月——Naive UI 相邻月日期灰显仍可点的行为。
    public static DateTime CellDate(int year, int month, int index) {
        int start = Calendar.GridStart(year, month);
        int days = DateTime.DaysInMonth(year, month);
        if (index < start) {
            int py = year;
            int pm = month - 1;
            if (pm < 1) { pm = 12; py = py - 1; }
            int pd = DateTime.DaysInMonth(py, pm) - (start - index) + 1;
            return DateTime.FromDate(py, pm, pd);
        }
        if (index >= start + days) {
            int nx = month + 1;
            int ny = year;
            if (nx > 12) { nx = 1; ny = ny + 1; }
            return DateTime.FromDate(ny, nx, index - start - days + 1);
        }
        return DateTime.FromDate(year, month, index - start + 1);
    }

    // 头部标题（Naive UI 的"2026年8月"）。
    public static string MonthLabel(int year, int month) {
        return "" + year + "年" + month + "月";
    }

    // 议程色调对应的类片段（calendar::mark.info 等 CSS 规则）。
    public static string ToneClass(int tone) {
        if (tone == 1) { return "info"; }
        if (tone == 2) { return "success"; }
        if (tone == 3) { return "warning"; }
        if (tone == 4) { return "error"; }
        return "";
    }

    public static int ToneColor(App app, int tone) {
        if (app != null && app.theme != null) {
            if (tone == 1) { return app.theme.info; }
            if (tone == 2) { return app.theme.success; }
            if (tone == 3) { return app.theme.warning; }
            if (tone == 4) { return app.theme.error; }
            return app.theme.primary;
        }
        if (tone == 1) { return -14774017; }
        if (tone == 2) { return -14704595; }
        if (tone == 3) { return -1109761; }
        if (tone == 4) { return -3462610; }
        return -15163304;
    }

    // ---- 取值 / 设值 ------------------------------------------------

    // 选中日期；panel 的"清除"之后为 null。
    public DateTime GetDate() { return selected; }

    // 程序化设值（归一化到当天 00:00 并把视图带到该月），
    // 不触发 Change——与 Input.SetText 的语义一致。
    public void SetDate(DateTime value) {
        if (value == null) { this.ClearDate(); return; }
        DateTime d = Calendar.DayOf(value);
        selected = d;
        viewYear = d.Year();
        viewMonth = d.Month();
        this.SyncCalendarView(null);
    }

    // 清空选中（panel 模式"清除"动作，Naive UI clear）。
    public void ClearDate() {
        if (selected == null) { return; }
        selected = null;
        if (data != null) { data.Set(""); }
        this.SyncCalendarView(null);
        Change.RaiseS(this);
    }

    // 追加一条议程；day 归一化到当天 00:00，调用方传 DateTime.Now()
    // 这类带时刻的值也能正确落到格子上。
    public void AddMark(DateTime day, string text, int tone) {
        marks.Add(new CalendarMark(Calendar.DayOf(day), text, tone));
    }

    // 清空全部议程（数据驱动宿主重填前调用）。
    public void ClearMarks() { marks = new List<CalendarMark>(); }

    // 该日是否不可选：IsDateDisabled 为空时全部可选。
    public bool IsDayDisabled(DateTime d) {
        if (IsDateDisabled == null) { return false; }
        return IsDateDisabled(d);
    }

    // 订阅选中变化（链式）。
    public Calendar OnChange(Action a) {
        Change.Add(a);
        return this;
    }

    // 订阅可见月份变化（链式）。
    public Calendar OnPanelChange(Action a) {
        PanelChange.Add(a);
        return this;
    }

    // ---- 交互 --------------------------------------------------------

    // 翻到上/下个月（delta = ∓1），跨年自动进位。
    public void MoveMonth(int delta) {
        viewMonth = viewMonth + delta;
        if (viewMonth < 1) { viewMonth = viewMonth + 12; viewYear = viewYear - 1; }
        if (viewMonth > 12) { viewMonth = viewMonth - 12; viewYear = viewYear + 1; }
        this.SyncCalendarView(null);
        PanelChange.RaiseS(this);
    }

    // 视图跳回今天所在月份（Naive UI month 头部的"今天"按钮）：
    // 只滚回当月，不改变选中值。
    public void JumpToToday() {
        DateTime now = DateTime.Now();
        if (viewYear == now.Year() && viewMonth == now.Month()) { return; }
        viewYear = now.Year();
        viewMonth = now.Month();
        this.SyncCalendarView(null);
        PanelChange.RaiseS(this);
    }

    // 点选一天：跨月点选把视图带到目标月，相邻月的两次报告
    // （Change + PanelChange）与 Naive UI 保持一致。
    public void PickDate(DateTime picked) {
        if (this.IsDayDisabled(picked)) { return; }
        bool monthChanged = picked.Month() != viewMonth
            || picked.Year() != viewYear;
        bool valueChanged = selected == null || !selected.Equals(picked);
        selected = picked;
        viewYear = picked.Year();
        viewMonth = picked.Month();
        this.SyncCalendarView(null);
        if (valueChanged) {
            if (data != null) { data.Set(selected != null ? selected.ToDateString() : ""); }
            Change.RaiseS(this);
        }
        if (monthChanged) { PanelChange.RaiseS(this); }
    }

    // 首次绘制前分配命中 id 块（兼容保留）。
    public void EnsureIds() {
        if (idsReady) { return; }
        baseId = this.CommonId() * 100;
        idsReady = true;
    }

    // ---- 声明式子树构建与状态同步 -------------------------------------

    public void BuildTree() {
        this.children.Clear();

        // 1. 头部栏
        headerBox = new Control();
        headerBox.ClassName = "calendar-header row justify-between align-center";

        prevBtn = new Button("").Ghost().Small();
        prevBtn.Icon = "chevron-left";
        prevBtn.ClassName = "calendar-prev";
        prevBtn.Click.Add(() => { this.MoveMonth(-1); });
        headerBox.Add(prevBtn);

        titleLabel = new Label(Calendar.MonthLabel(viewYear, viewMonth));
        titleLabel.ClassName = "calendar-title";
        headerBox.Add(titleLabel);

        nextBtn = new Button("").Ghost().Small();
        nextBtn.Icon = "chevron-right";
        nextBtn.ClassName = "calendar-next";
        nextBtn.Click.Add(() => { this.MoveMonth(1); });
        headerBox.Add(nextBtn);

        todayBtn = new Button("今天").Secondary().Small();
        todayBtn.ClassName = "calendar-today-btn";
        todayBtn.Click.Add(() => { this.JumpToToday(); });
        headerBox.Add(todayBtn);
        this.Add(headerBox);

        // 2. 星期条
        weekdayBox = new Control();
        weekdayBox.ClassName = "calendar-weekdays row";
        weekdayLabels = new List<Label>();
        string[] names = new string[]{"日", "一", "二", "三", "四", "五", "六"};
        for (int i = 0; i < 7; i = i + 1) {
            Label wl = new Label(names[i]);
            wl.ClassName = "calendar-weekday-item text-center flex-1";
            weekdayLabels.Add(wl);
            weekdayBox.Add(wl);
        }
        this.Add(weekdayBox);

        // 3. 42 个日期单元格
        gridBox = new Control();
        gridBox.ClassName = "calendar-grid col";
        cells = new List<CalendarCell>();
        for (int i = 0; i < 42; i = i + 1) {
            CalendarCell c = new CalendarCell(this, i);
            cells.Add(c);
            gridBox.Add(c);
        }
        this.Add(gridBox);

        // 4. 面板模式底部操作栏
        footerBox = new Control();
        footerBox.ClassName = "calendar-footer row justify-end align-center gap-medium";
        nowBtn = new Button("今天").Primary().Small();
        nowBtn.Click.Add(() => { this.PickDate(Calendar.TodayRef()); });
        clearBtn = new Button("清除").Secondary().Small();
        clearBtn.Click.Add(() => { this.ClearDate(); });
        footerBox.Add(nowBtn);
        footerBox.Add(clearBtn);
        this.Add(footerBox);

        this.SyncCalendarView(null);
    }

    public void SyncCalendarView(App app) {
        if (titleLabel != null) {
            titleLabel.Text = Calendar.MonthLabel(viewYear, viewMonth);
        }
        bool isPanel = (Mode != null && Mode.Get() == "panel");
        if (todayBtn != null) {
            todayBtn.Visible = !isPanel;
        }
        if (footerBox != null) {
            footerBox.Visible = isPanel;
        }
        if (cells != null) {
            for (int i = 0; i < cells.Count; i = i + 1) {
                DateTime d = Calendar.CellDate(viewYear, viewMonth, i);
                cells[i].date = d;
            }
        }
    }

    // ---- 设计器 / 序列化模型 ----------------------------------------

    // 控件类型标识（序列化/设计器用）。
    public override string Kind() { return "Calendar"; }

    // 覆写：返回设计器属性清单（text/mode/data/value）。
    public override List<PropSpec> Props() {
        List<PropSpec> ps = new List<PropSpec>();
        PropSpec text = PropSpec.Text("text", "Date");
        text.str = data;
        text.Also("value");
        text.Also("data");
        text.WithTip("Selected date in YYYY-MM-DD; empty = none (cleared).");
        ps.Add(text);
        PropSpec mode = PropSpec.Enum("mode", "Mode",
            new List<string>{ "month", "panel" });
        mode.str = Mode;
        ps.Add(mode);
        return ps;
    }

    public override void SyncBinding() {
        base.SyncBinding();
        if (data != null) {
            string val = data.Get();
            if (val == "" || val == null) {
                if (selected != null) { selected = null; }
            } else {
                string cur = selected != null ? selected.ToDateString() : "";
                if (val != cur) {
                    DateTime d = DateTime.ParseDate(val);
                    if (d != null) {
                        selected = d;
                        viewYear = d.Year();
                        viewMonth = d.Month();
                    }
                }
            }
        }
    }

    public override string GetProp(string key) {
        if (key == "data" || key == "value" || key == "text") {
            if (data != null) { return data.Get(); }
            if (selected == null) { return ""; }
            return selected.ToDateString();
        }
        if (key == "mode") { return Mode != null ? Mode.Get() : ""; }
        return base.GetProp(key);
    }

    public override void SetProp(string key, string val) {
        if (key == "data" || key == "value" || key == "text") {
            if (data != null) { data.Set(val); }
            DateTime d = DateTime.ParseDate(val);
            if (d != null) {
                selected = d;
                viewYear = d.Year();
                viewMonth = d.Month();
            } else if (val == "") {
                selected = null;
            }
            this.SyncCalendarView(null);
            return;
        }
        if (key == "mode") {
            if (Mode != null) { Mode.Set(val); } else { Mode = val; }
            this.SyncCalendarView(null);
            return;
        }
        base.SetProp(key, val);
    }

    // 设计器读取选中日期（"text"/"value"/"data" 同键，YYYY-MM-DD；未选返回 ""）。
    public override string GetExtra(string key) {
        if (key == "text" || key == "value" || key == "data") {
            if (selected == null) { return ""; }
            return selected.ToDateString();
        }
        return "";
    }

    // 设计器写入选中日期（"text"/"value"/"data" 同键，解析失败保持原状）；
    // 其他键返回 false 交给基类。
    public override bool SetExtra(string key, string val) {
        if (key == "text" || key == "value" || key == "data") {
            DateTime d = DateTime.ParseDate(val);
            if (d == null) { return true; }
            selected = d;
            viewYear = d.Year();
            viewMonth = d.Month();
            this.SyncCalendarView(null);
            return true;
        }
        return false;
    }

    // 覆写：公共事件之外提供 "Change"/"PanelChange"。
    public override List<string> Events() {
        List<string> e = Control.CommonEvents();
        e.Add("Change");
        e.Add("PanelChange");
        return e;
    }

    // 覆写："Change"/"PanelChange" 挂各自 UiEvent，其余按名称走
    // 通用路由。
    public override void BindEvent(string evt, Action a) {
        if (evt == "Change") { Change.Add(a); return; }
        if (evt == "PanelChange") { PanelChange.Add(a); return; }
        On.AddByName(evt, a);
    }

    // <see cref="BindEvent"/> 的 sender 通道（S = Sender）：
    // 特化事件接本控件的 UiEvent，通用事件按名路由。
    public override void BindEventS(string evt, ControlEvent a) {
        if (evt == "Change") { Change.AddS(a); return; }
        if (evt == "PanelChange") { PanelChange.AddS(a); return; }
        On.AddByNameS(evt, a);
    }

    // ---- 测量与绘制 --------------------------------------------------

    // 覆写：按模式量首选尺寸——面板模式紧凑，月历默认 600x340
    public override void OnMeasure(App app) {
        StyleBox s = this.ResolveStyleCached(app, "calendar", Class,
                                             Style.SNormal());
        if (Mode != null && Mode.Get() == "panel") {
            prefW = s.WidthOr(app.Scale(250));
            prefH = s.HeightOr(app.Scale(32 + 24 + 6 * 28 + 36));
        } else {
            prefW = s.WidthOr(app.Scale(600));
            prefH = s.HeightOr(app.Scale(340));
        }
    }

    public override void Arrange(int px, int py, int pw, int ph) {
        base.Arrange(px, py, pw, ph);
        bool isPanel = (Mode != null && Mode.Get() == "panel");
        int headerH = isPanel ? 32 : 44;
        int weekH = 26;
        int footerH = isPanel ? 36 : 0;
        int pad = 12;

        if (headerBox != null) {
            headerBox.Arrange(px, py, pw, headerH);
            if (isPanel) {
                int arrow = 24;
                prevBtn.Arrange(px + pad, py + (headerH - arrow) / 2, arrow, arrow);
                titleLabel.Arrange(px + (pw - 120) / 2, py, 120, headerH);
                nextBtn.Arrange(px + pw - pad - arrow, py + (headerH - arrow) / 2, arrow, arrow);
                todayBtn.Visible = false;
            } else {
                int arrow = 24;
                int todayW = 52;
                int todayH = 24;
                prevBtn.Arrange(px + pad, py + (headerH - arrow) / 2, arrow, arrow);
                titleLabel.Arrange(px + pad + arrow + 8, py, 120, headerH);
                nextBtn.Arrange(px + pad + arrow + 8 + 120, py + (headerH - arrow) / 2, arrow, arrow);
                todayBtn.Visible = true;
                todayBtn.Arrange(px + pw - pad - todayW, py + (headerH - todayH) / 2, todayW, todayH);
            }
        }

        if (weekdayBox != null) {
            weekdayBox.Arrange(px, py + headerH, pw, weekH);
            int cellW0 = pw / 7;
            if (cellW0 < 1) { cellW0 = 1; }
            for (int i = 0; i < weekdayLabels.Count; i = i + 1) {
                weekdayLabels[i].Arrange(px + i * cellW0, py + headerH, cellW0, weekH);
            }
        }

        int top = py + headerH + weekH;
        int gridH = ph - headerH - weekH - footerH;
        if (gridH < 6) { gridH = 6; }
        int cellH = gridH / 6;
        int cellW = pw / 7;
        if (cellW < 1) { cellW = 1; }

        if (gridBox != null) {
            gridBox.Arrange(px, top, pw, cellH * 6);
        }

        if (cells != null) {
            for (int i = 0; i < 42; i = i + 1) {
                int col = i % 7;
                int row = i / 7;
                int cx = px + col * cellW;
                int cy = top + row * cellH;
                cells[i].Arrange(cx, cy, cellW, cellH);
            }
        }

        if (footerBox != null) {
            if (isPanel) {
                footerBox.Visible = true;
                footerBox.Arrange(px, py + ph - footerH, pw, footerH);
                int bw2 = 52;
                int bh2 = 24;
                int by2 = py + ph - footerH + (footerH - bh2) / 2;
                nowBtn.Arrange(px + pw - pad - bw2 * 2 - 8, by2, bw2, bh2);
                clearBtn.Arrange(px + pw - pad - bw2, by2, bw2, bh2);
            } else {
                footerBox.Visible = false;
            }
        }
    }

    public override void OnPaint(App app) {
        this.SyncBinding();
        this.SyncCalendarView(app);

        // 网格细分割线（按主题 border token 绘制）
        Canvas c = app.canvas;
        bool isPanel = (Mode != null && Mode.Get() == "panel");
        int headerH = isPanel ? app.Scale(32) : app.Scale(44);
        int weekH = app.Scale(26);
        int footerH = isPanel ? app.Scale(36) : 0;
        int top = by + headerH + weekH;
        int gridH = bh - headerH - weekH - footerH;
        if (gridH < 6) { gridH = 6; }
        int cellH = gridH / 6;
        int cellW = bw / 7;
        if (cellW < 1) { cellW = 1; }
        int gridBottom = top + cellH * 6;
        int line = app.theme.borderPrimary;
        for (int v = 1; v < 7; v = v + 1) {
            c.DrawLine(bx + v * cellW, top, bx + v * cellW, gridBottom, line, 1);
        }
        for (int h = 1; h < 6; h = h + 1) {
            c.DrawLine(bx, top + h * cellH, bx + cellW * 7, top + h * cellH, line, 1);
        }
    }

    // 议程色调颜色：`calendar::mark.<tone>` 的 color，未配置时回退主题色
    public int MarkColor(App app, int tone, int fallback) {
        string cls = Class;
        string toneCls = Calendar.ToneClass(tone);
        if (toneCls != "") { cls = Class + " " + toneCls; }
        StyleBox ms = this.ResolvePartAs(app, "calendar", "mark", "", cls,
                                         Style.SNormal());
        return ms.FgOr(fallback != 0 ? fallback : Calendar.ToneColor(app, tone));
    }
}

// 声明式日历日期单元格：保留模式组件树中的原子节点。
// 支持标准 PointerEnter / PointerLeave 悬停与 OnClick 视觉树事件路由。
public class CalendarCell : Control {
    public Calendar calendar;
    public int index;
    public DateTime date;

    public CalendarCell(Calendar cal, int idx) {
        this.InitControl("calendar-cell", 1);
        this.ClassName = "calendar-cell";
        calendar = cal;
        index = idx;
        date = null;
    }

    public override void OnClick(RoutedEventArgs e) {
        if (calendar != null && date != null) {
            if (!calendar.IsDayDisabled(date)) {
                calendar.PickDate(date);
                App app = this.FindApp();
                if (app != null) { app.RequestRedraw(); }
            }
        }
        e.Handle();
    }

    public override void OnPaint(App app) {
        Canvas c = app.canvas;
        if (calendar == null || date == null) { return; }
        Theme t = app.theme;
        bool en = !calendar.IsDisabled();
        bool dis = calendar.IsDayDisabled(date);
        bool inMonth = (date.Month() == calendar.viewMonth && date.Year() == calendar.viewYear);
        bool sel = (calendar.selected != null && calendar.selected.Equals(date));
        bool isToday = date.Equals(Calendar.TodayRef());

        // 选中或悬停底色
        if (sel) {
            c.FillRoundRect(bx + 1, by + 1, bw - 2, bh - 2, app.Scale(3), t.primary);
        } else if (this.isHovered && en && !dis) {
            c.FillRoundRect(bx + 1, by + 1, bw - 2, bh - 2, app.Scale(3), t.bgHover);
        }

        // 日期数字
        int fg = sel ? 0xFFFFFFFF : (dis ? t.textDisabled : (inMonth ? t.textPrimary : t.textSecondary));
        int fs = Style.FontFallback(app, "small");
        int nx = bx + app.Scale(7);
        int ny = by + app.Scale(5);
        StyleBox todayS = calendar.ResolvePartAs(app, "calendar", "today", "", calendar.Class, Style.SNormal());
        int todayBg = todayS.BgOr(0);
        if (isToday && !sel && todayBg != 0) {
            c.FillRoundRect(nx - app.Scale(4), ny - app.Scale(2), app.Scale(26), app.Scale(20), app.Scale(10), todayBg);
        }
        c.DrawText(nx, ny, Convert.ToString(date.Day()), fg, fs);

        // 议程：每格最多两条，紧跟在日期行下面排
        int tinyFs = Style.FontFallback(app, "tiny");
        int lh = tinyFs + tinyFs / 3;
        int my = by + app.Scale(26);
        int drawn = 0;
        for (int k = 0; k < calendar.marks.Count && drawn < 2; k = k + 1) {
            CalendarMark mk = calendar.marks[k];
            if (!mk.day.Equals(date)) { continue; }
            if (my < by + app.Scale(21) || my + lh > by + bh) { break; }
            int mc = calendar.MarkColor(app, mk.tone, fg);
            c.FillRoundRect(bx + app.Scale(7), my + lh / 2 - app.Scale(3), app.Scale(5), app.Scale(5), app.Scale(2), mc);
            c.DrawText(bx + app.Scale(16), my, Ellipsis.Fit(mk.text, bw - app.Scale(26), tinyFs), mc, tinyFs);
            my = my + lh;
            drawn = drawn + 1;
        }
    }
}
