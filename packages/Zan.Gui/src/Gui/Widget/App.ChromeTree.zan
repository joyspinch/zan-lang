using System;
using System.Collections.Generic;
using Gui.Widget;
namespace Gui;
public partial class App {
    Control chromeTree;
    weak ControlInputHost chromeInput;
    ChromeCaptionAction chromeAction;
    Button chromeTheme;
    Button chromePin;
    Button chromeMinimize;
    Button chromeMaximize;
    Button chromeClose;
    bool isolateAppSheet;
    bool chromeCacheValid;
    int chromeCacheW;
    int chromeCacheH;
    int chromeCacheOffX;
    int chromeCacheOffY;
    int chromeCacheBtnW;
    int chromeCacheFlags;
    int chromeCacheThemeGen;
    int chromeCacheScale;
    int chromeCacheDpi;
    int chromeCacheRuleSig;
    void EnsureChromeTree() {
        if (chromeTree != null) { return; }
        chromeTree = Flex.Row();
        chromeTree.AddClass("nowrap");
        chromeTree.AddClass("align-start");
        chromeTree.SetProp("name", "window-caption");
        chromeTree.SetProp("style", "gap:0;padding:0;margin:0;border:0");
        chromeAction = new ChromeCaptionAction(this);
        chromeTheme = ChromeButton("palette", 0, chromeAction);
        chromeTheme.SetProp("name", "window-theme");
        chromePin = ChromeButton("pinned", 1, chromeAction);
        chromeMinimize = ChromeButton("minus", 2, chromeAction);
        chromeMaximize = ChromeButton("square", 3, chromeAction);
        chromeClose = ChromeButton("close", 4, chromeAction);
        chromeClose.ClassName = "caption danger";
        chromeTree.Children.Add(chromeTheme);
        chromeTree.Children.Add(chromePin);
        chromeTree.Children.Add(chromeMinimize);
        chromeTree.Children.Add(chromeMaximize);
        chromeTree.Children.Add(chromeClose);
    }
    static Button ChromeButton(string glyph, int action, ChromeCaptionAction owner) {
        Button button = new Button { Icon = glyph, ClassName = "caption" };
        button.Click.Add(() => owner.Run(action));
        button.SetProp("style", "flex-grow:0;flex-shrink:0;margin:0");
        return button;
    }
    bool PrepareChromeTree() {
        if (window.GetHandle() == 0 && this.CurrentHostLayout() == null) { return true; }
        if (!showChrome) {
            chromeCacheValid = false;
            if (snapshotInputSilenceDepth == 0 && chromeInput != null) { chromeInput.Hide(); }
            return !showChrome;
        }
        this.EnsureChromeTree();
        int offX = ShapeOffX();
        int offY = ShapeOffY();
        int width = canvas.Width() - offX * 2;
        int height = titlebarH;
        if (isChildWindow) { showThemeButton = false; showPinButton = false; }
        int buttonWidth = captionBtnW;
        bool maximized = window.IsMaximized();
        int flags = (showCloseButton ? 1 : 0) | (showMaximizeButton ? 2 : 0)
            | (showMinimizeButton ? 4 : 0) | (showPinButton ? 8 : 0)
            | (showThemeButton ? 16 : 0) | (isTopmost ? 32 : 0) | (maximized ? 64 : 0);
        int rsig = this.CurrentStyleRuleSig();
        bool inputBound = snapshotInputSilenceDepth > 0
            || (chromeInput != null && rootControl is InputRootAdapter
                && ((InputRootAdapter)rootControl).ContainsAdapter(chromeInput));
        if (chromeCacheValid && chromeCacheW == width && chromeCacheH == height
            && chromeCacheOffX == offX && chromeCacheOffY == offY
            && chromeCacheBtnW == buttonWidth && chromeCacheFlags == flags
            && chromeCacheThemeGen == bgThemeGen && chromeCacheScale == metricsScale
            && chromeCacheDpi == dpiScale && chromeCacheRuleSig == rsig && inputBound) {
            return true;
        }
        int stripHeight = height > Scale(36) ? Scale(36) : height;
        this.PrepareCaption(chromeClose, showCloseButton, buttonWidth, stripHeight);
        this.PrepareCaption(chromeMaximize, showMaximizeButton, buttonWidth, stripHeight);
        this.PrepareCaption(chromeMinimize, showMinimizeButton, buttonWidth, stripHeight);
        this.PrepareCaption(chromePin, showPinButton, buttonWidth, stripHeight);
        this.PrepareCaption(chromeTheme, showThemeButton, buttonWidth, stripHeight);
        chromePin.Icon = isTopmost ? "pinned-off" : "pinned";
        chromePin.SetClassIn("selected", isTopmost ? "selected" : "");
        chromeMaximize.Icon = maximized ? "copy" : "square";
        int stripWidth = this.ChromeButtonCount() * buttonWidth;
        bool prevIsolate = isolateAppSheet;
        isolateAppSheet = true;
        try {
            chromeTree.MeasureTree(this);
            chromeTree.Arrange(offX + width - stripWidth, offY, stripWidth, stripHeight);
        } finally {
            isolateAppSheet = prevIsolate;
        }
        if (snapshotInputSilenceDepth == 0) {
            ControlInputHost input = chromeInput;
            if (input == null) {
                input = new ControlInputHost(chromeTree);
                chromeInput = input;
            }
            input.Bind(this);
        }
        int captionZone = stripWidth < width ? stripWidth : width;
        window.SetCaptionZone(captionZone > 0 ? captionZone : 0);
        chromeCacheW = width;
        chromeCacheH = height;
        chromeCacheOffX = offX;
        chromeCacheOffY = offY;
        chromeCacheBtnW = buttonWidth;
        chromeCacheFlags = flags;
        chromeCacheThemeGen = bgThemeGen;
        chromeCacheScale = metricsScale;
        chromeCacheDpi = dpiScale;
        chromeCacheRuleSig = rsig;
        chromeCacheValid = true;
        return showChrome && (snapshotInputSilenceDepth > 0
        || (rootControl is InputRootAdapter
        && ((InputRootAdapter)rootControl).ContainsAdapter(chromeInput)));
    }
    void PrepareCaption(Button button, bool shown, int width, int height) {
        button.SetShown(shown);
        button.Prefer(width, height);
    }
    void PaintChromeTree() {
        if (!showChrome || chromeTree == null) { return; }
        bool prevIsolate = isolateAppSheet;
        isolateAppSheet = true;
        try {
            chromeTree.RenderTree(this);
        } finally {
            isolateAppSheet = prevIsolate;
        }
    }
    int ChromeTooltipAnchor() { return chromeTheme != null ? chromeTheme.WidgetId() : 0; }
    void PaintChromeTooltips() {
        if (!showChrome || chromeTree == null) { return; }
        if (showThemeButton) { this.PaintCaptionTooltip(chromeTheme, themeTipText); }
        if (showPinButton) { this.PaintCaptionTooltip(chromePin, pinTipText); }
        if (showMinimizeButton) { this.PaintCaptionTooltip(chromeMinimize, minimizeTipText); }
        if (showMaximizeButton) {
            this.PaintCaptionTooltip(chromeMaximize,
            window.IsMaximized() ? restoreTipText : maximizeTipText);
        }
        if (showCloseButton) { this.PaintCaptionTooltip(chromeClose, closeTipText); }
    }
    void PaintCaptionTooltip(Button button, string text) {
        int id = button.WidgetId();
        if (!this.CaptionTipShown(id, button.bx, button.bw, button.bh)) { return; }
        Tooltip.RenderAt(this, button.bx + button.bw / 2, button.by + button.bh,
        text, Tooltip.Bottom(), this.Scale(260));
        this.NoteCaptionTip(id, button.bx, button.bw, button.by + button.bh);
    }
}
class ChromeCaptionAction {
    weak App owner;
    public ChromeCaptionAction(App app) { owner = app; }
    public void Run(int action) {
        App app = owner;
        if (app == null || app.window == null) { return; }
        if (action == 0) { app.InvokeThemeSettings(); }
        else if (action == 1) { app.SetTopmost(!app.isTopmost); }
        else if (action == 2) { app.window.Minimize(); }
        else if (action == 3) { app.window.ToggleMaximize(); }
        else if (action == 4) { app.window.Close(); }
        app.RequestRedraw();
    }
}
