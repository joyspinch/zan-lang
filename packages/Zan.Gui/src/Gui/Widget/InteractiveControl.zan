using System;
using Gui;

namespace Gui.Widget;

// 统一交互控件抽象基类：收敛尺寸档位、变更事件通知、键盘无障碍触发与统一事件派发
public abstract class InteractiveControl : Control {
    public Binding<string> Size;
    public UiEvent Change;

    protected void InitInteractive(string kind) {
        this.InitControl(kind);
        this.wiresOwnEvents = true;
        this.Size = "medium";
        this.Change = new UiEvent();
    }

    public override Binding<string> SizeOf() { return Size; }

    public override List<string> Events() {
        List<string> e = Control.CommonEvents();
        e.Add("Change");
        return e;
    }

    public override void BindEvent(string evt, Action a) {
        if (evt == "Change") { Change.Add(a); return; }
        base.BindEvent(evt, a);
    }

    public override void BindEventS(string evt, ControlEvent a) {
        if (evt == "Change") { Change.AddS(a); return; }
        base.BindEventS(evt, a);
    }

    // 统一键盘触发判定：获得焦点时空格键 (32) 或回车键 (13) 激活
    public bool IsKeyTriggered(int id) {
        return this.IsKeyTriggered(this.App, id);
    }
    public bool IsKeyTriggered(App app, int id) {
        app = this.ResolveApp(app);
        if (app == null || app.window == null) { return false; }
        if (!this.IsDisabled() && Ui.Focused(app, id) && app.EventKind() == 4) {
            int kc = app.window.EventKeyCode();
            return kc == 32 || kc == 13;
        }
        return false;
    }
}

// 统一双态开关/复选/单选抽象控件：统筹内部响应式信号、外部双向绑定模型与切换动作
public abstract class ToggleControl : InteractiveControl {
    public SignalBool onSig;
    public Binding<bool> data;
    public Binding<int> dataValue;

    protected void InitToggle(string kind) {
        this.InitInteractive(kind);
        this.onSig = new SignalBool(false);
    }

    // 当前是否处于选中/开启状态
    public virtual bool IsChecked() {
        return this.onSig != null ? this.onSig.Get() : false;
    }

    // 设置选中状态并同步外部双向数据绑定
    public virtual void SetChecked(bool v) {
        if (this.onSig != null) {
            if (this.onSig.Get() == v) { return; }
            this.onSig.Set(v);
        }
        if (this.data != null) { this.data.Set(v); }
    }

    // 状态翻转并统一派发 Change 事件
    public virtual void Toggle() {
        this.SetChecked(!this.IsChecked());
        if (this.Change != null) { this.Change.RaiseS(this); }
        if (this.parent != null) { this.parent.OnChildEvent(this, "Change"); }
    }

    public override List<string> Events() {
        List<string> e = base.Events();
        e.Add("Toggle");
        return e;
    }

    public override void BindEvent(string evt, Action a) {
        if (evt == "Toggle") { Change.Add(a); return; }
        base.BindEvent(evt, a);
    }

    public override void BindEventS(string evt, ControlEvent a) {
        if (evt == "Toggle") { Change.AddS(a); return; }
        base.BindEventS(evt, a);
    }

    public override void SyncBinding() {
        base.SyncBinding();
        if (this.data != null && this.onSig != null) {
            bool v = this.data.Get();
            if (this.onSig.Get() != v) {
                this.onSig.Set(v);
            }
        }
    }

    public override void OnClick(RoutedEventArgs e) {
        if (this.IsDisabled()) { return; }
        this.Toggle();
        App a = this.FindApp();
        if (a != null) { a.RequestRedraw(); }
        e.Handle();
    }

    public override void OnKeyDown(RoutedEventArgs e) {
        if (!this.IsDisabled() && (e.keyCode == 32 || e.keyCode == 13)) {
            this.Toggle();
            App a = this.FindApp();
            if (a != null) { a.RequestRedraw(); }
            e.Handle();
            return;
        }
        base.OnKeyDown(e);
    }
}
