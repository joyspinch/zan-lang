using System;
using Gui;
using Gui.Backend;
namespace Gui.Widget;
// 穿梭框（Transfer）：左右两栏列表，左栏勾选后经中缝按钮「穿梭」
// 到右栏，右栏勾选可移回。每一栏是一块独立的虚拟化面板——头部
// （全选 / 计数 / 清除）、可选搜索框、复选行区与空态占位——所以
// 四万项与一屏同开销。绑定的是调用方自己的两个列表（不拷贝），
// 行文本由 `CellOf<T>` 委托读出（未给时取 `item.ToString()`）。
// t.Bind(model.left, model.right);       // 两个 List<string>
// t.WithSearch();                         // 两栏各加一个过滤框
// t.Change += () => { Save(); };          // 数据移动后触发
// form.Children.Add(t);                    // 挂一次，由父容器布局
// 勾选态是控件的瞬时 UI 状态（不反向写进宿主列表），`Checked()` /
// `CheckedRight()` 随时可读。中缝的移动按钮走保留态 `Button`
// （primary 皮肤、Disabled 联动对应侧的勾选数），因此外观与
// 全库按钮一体，宿主也能经 `MoveRightButton()` 直接拿到引用定制。
// 移动只搬「当前过滤结果里被勾的」行：滚多远都不会丢点。
[ControlKind(Of = "string")]  // 按名构造（HTML/设计文档）造 string 实例
public class Transfer<T> : Control {
    public override Control CreateCloneShell() { return new Transfer<T>(); }
    public override void CloneContentTo(Control target, CloneTreeFn clone) { }
    public List<T> source;
    public List<T> target;
    public TransferPane left;
    public TransferPane right;
    private TransferRegion<T> leftRegion;
    private TransferRegion<T> rightRegion;
    private bool arrangingTransfer;
    public CellOf<T> label;
    public IconOf<T> iconOf;
    public bool searchable;
    public string leftHint;
    public string rightHint;
    public bool oneWay;
    public string emptyText;
    public string selectAllText;
    public string totalText;
    public string selectedText;
    public string clearText;
    public int pendRow;
    public int pendPane;
    public bool pendOn;
    public bool wasPaint;
    public bool lastDrag;
    public Button rightBtn;
    public Button leftBtn;
    public Flex opBox;

    // 数据移动后触发（宿主读回 source/target 或做持久化）。
    [Event]
    public UiEvent Change;
    // 任意一侧勾选集合变化。
    [Event]
    public UiEvent SelectChanged;
    public int opW;
    public int opGap;
    public int opH;
    public int searchH;
    public int headH;
    private void InitTransfer() {
        this.InitControl("transfer");
        source = new List<T>();
        target = new List<T>();
        left = new TransferPane();
        right = new TransferPane();
        leftRegion = new TransferRegion<T>(this, left, true);
        rightRegion = new TransferRegion<T>(this, right, false);
        this.Add(leftRegion);
        this.Add(rightRegion);
        arrangingTransfer = false;
        label = null;
        iconOf = null;
        searchable = false;
        leftHint = "";
        rightHint = "";
        oneWay = false;
        emptyText = "无数据";
        selectAllText = "全选";
        totalText = "共";
        selectedText = "已选";
        clearText = "清除";
        rightBtn = new Button();
        rightBtn.Class = "primary small";
        rightBtn.Icon = "chevron-right";
        leftBtn = new Button();
        leftBtn.Class = "primary small";
        leftBtn.Icon = "chevron-left";
        opBox = new Flex();
        opBox.ClassName = "column align-center justify-center gap-small";
        opBox.Add(rightBtn);
        opBox.Add(leftBtn);
        this.Add(opBox);
        TransferRegionAction<T> rightAction = new TransferRegionAction<T>(leftRegion);
        TransferRegionAction<T> leftAction = new TransferRegionAction<T>(rightRegion);
        rightBtn.Click.Add(rightAction.Operation);
        leftBtn.Click.Add(leftAction.Operation);
        wiresOwnEvents = true;
        Change = new UiEvent();
        SelectChanged = new UiEvent();
        opW = 0;
        opGap = 0;
        opH = 0;
        searchH = 0;
        headH = 0;
    }
    public Transfer() { InitTransfer(); }
    public Transfer(List<T> src, List<T> tgt) {
        InitTransfer();
        this.Bind(src, tgt);
    }
    public List<T> SourceItems {
        get { return source; }
        set { this.Bind(value, target); }
    }
    public List<T> TargetItems {
        get { return target; }
        set { this.Bind(source, value); }
    }
    public CellOf<T> LabelSelector {
        get { return label; }
        set { this.WithLabel(value); }
    }
    public IconOf<T> IconSelector {
        get { return iconOf; }
        set { this.WithIcon(value); }
    }
    public bool IsSearchable {
        get { return searchable; }
        set { searchable = value; }
    }
    public string LeftSearchPlaceholder {
        get { return leftHint; }
        set { searchable = true; leftHint = value != null ? value : ""; }
    }
    public string RightSearchPlaceholder {
        get { return rightHint; }
        set { searchable = true; rightHint = value != null ? value : ""; }
    }
    public bool IsOneWay {
        get { return oneWay; }
        set { oneWay = value; }
    }
    public string EmptyMessage {
        get { return emptyText; }
        set { emptyText = value != null ? value : ""; }
    }

    // 覆写：CSS 类型选择器名（"transfer"）。
    public override string StyleType() { return "transfer"; }
    public void Bind(List<T> src, List<T> tgt) {
        leftRegion.CancelSelection();
        rightRegion.CancelSelection();
        pendRow = 0 - 1; pendPane = 0 - 1;
        pendOn = false; wasPaint = false; lastDrag = false;
        if (src != null) { source = src; }
        if (tgt != null) { target = tgt; }
        this.Invalidate();
    }
    public void Refresh() { this.Invalidate(); }
    public void Invalidate() {
        left.orderFor = 0 - 1;
        right.orderFor = 0 - 1;
        this.SyncOperationButtons();
    }
    public void WithLabel(CellOf<T> text) { label = text; this.Invalidate(); }
    public void WithIcon(IconOf<T> icon) { iconOf = icon; }
    public void WithSearch() { searchable = true; }
    public void WithSearchHint(string hint) {
        searchable = true;
        leftHint = hint;
        rightHint = hint;
    }
    public void WithSearchHints(string lh, string rh) {
        searchable = true;
        leftHint = lh;
        rightHint = rh;
    }
    public void WithOneWay() { oneWay = true; }
    public void WithEmptyText(string text) { emptyText = text; }
    public void WithHeaderText(string selectAll, string total,
                               string selected, string clear) {
        if (selectAll != "") { selectAllText = selectAll; }
        if (total != "") { totalText = total; }
        if (selected != "") { selectedText = selected; }
        if (clear != "") { clearText = clear; }
    }
    public void WithOperationIcons(string rightIcon, string leftIcon) {
        if (rightIcon != "") { rightBtn.Icon = rightIcon; }
        if (leftIcon != "") { leftBtn.Icon = leftIcon; }
    }
    public void WithOperation(string rightLabel, string leftLabel) {
        rightBtn.Text = rightLabel;
        rightBtn.Icon = "";
        leftBtn.Text = leftLabel;
        leftBtn.Icon = "";
    }
    public Button MoveRightButton() { return rightBtn; }
    public Button MoveLeftButton() { return leftBtn; }
    public int SourceCount() { return source.Count; }
    public int TargetCount() { return target.Count; }
    public int VisibleCount(bool isSource) {
        TransferPane p = isSource ? left : right;
        List<T> data = isSource ? source : target;
        return this.Order(p, data).Count;
    }
    public List<T> Source() { return source; }
    public List<T> Target() { return target; }
    public bool IsChecked(T item) {
        int i = source.IndexOf(item);
        if (i >= 0) { return this.FlagAt(left, i); }
        int j = target.IndexOf(item);
        if (j >= 0) { return this.FlagAt(right, j); }
        return false;
    }
    public bool FlagAt(TransferPane p, int i) {
        if (i < 0 || i >= p.flags.Count) { return false; }
        return p.flags[i];
    }
    public void SetChecked(T item, bool on) {
        int i = source.IndexOf(item);
        if (i >= 0) { this.SetFlag(left, i, on, source.Count); return; }
        int j = target.IndexOf(item);
        if (j >= 0) { this.SetFlag(right, j, on, target.Count); }
    }
    public void SetFlag(TransferPane p, int i, bool on, int n) {
        this.SyncFlags(p, n);
        if (i < 0 || i >= p.flags.Count) { return; }
        if (p.flags[i] == on) { return; }
        p.flags[i] = on;
        this.SyncOperationButtons(); SelectChanged.Post(this);
    }
    public List<T> Checked() { return this.CheckedIn(source, left); }
    public List<T> CheckedRight() { return this.CheckedIn(target, right); }
    public int CheckedSource() { return this.CheckedCount(left, source.Count); }
    public int CheckedTarget() { return this.CheckedCount(right, target.Count); }
    public List<T> CheckedIn(List<T> data, TransferPane p) {
        List<T> outp = new List<T>();
        int n = data.Count;
        if (n > p.flags.Count) { n = p.flags.Count; }
        for (int i = 0; i < n; i = i + 1) {
            if (p.flags[i]) { outp.Add(data[i]); }
        }
        return outp;
    }
    public int CheckedCount(TransferPane p, int count) {
        int c = 0;
        int n = count;
        if (n > p.flags.Count) { n = p.flags.Count; }
        for (int i = 0; i < n; i = i + 1) { if (p.flags[i]) { c = c + 1; } }
        return c;
    }
    public void MoveRight() {
        this.Move(left, source, right, target);
        Change.Post(this);
    }
    public void MoveLeft() {
        this.Move(right, target, left, source);
        Change.Post(this);
    }
    public void ClearChecked(bool all) {
        this.ClearPane(left, source, all);
        this.ClearPane(right, target, all);
    }
    public void ClearAll() {
        if (oneWay) { return; }
        this.ClearPane(right, target, true);
    }
    public void ClearPane(TransferPane p, List<T> data, bool all) {
        bool dirty = false;
        if (all) {
            for (int i = 0; i < p.flags.Count; i = i + 1) {
                if (p.flags[i]) { p.flags[i] = false; dirty = true; }
            }
        } else {
            List<int> order = this.Order(p, data);
            for (int k = 0; k < order.Count; k = k + 1) {
                int i = order[k];
                if (i < p.flags.Count && p.flags[i]) {
                    p.flags[i] = false;
                    dirty = true;
                }
            }
        }
        if (dirty) { this.SyncOperationButtons(); SelectChanged.Post(this); }
    }
    public void SelectAll(bool isSource, bool on) {
        if (oneWay && !isSource) { return; }
        TransferPane p = isSource ? left : right;
        List<T> data = isSource ? source : target;
        this.SyncFlags(p, data.Count);
        List<int> order = this.Order(p, data);
        bool dirty = false;
        for (int k = 0; k < order.Count; k = k + 1) {
            int i = order[k];
            if (i < p.flags.Count && p.flags[i] != on) {
                p.flags[i] = on;
                dirty = true;
            }
        }
        if (dirty) { this.SyncOperationButtons(); SelectChanged.Post(this); }
    }
    public void SelectAllVisible(bool isSource) {
        TransferPane p = isSource ? left : right;
        List<T> data = isSource ? source : target;
        int selN = 0;
        int allN = 0;
        List<int> order = this.Order(p, data);
        for (int k = 0; k < order.Count; k = k + 1) {
            int i = order[k];
            if (i < p.flags.Count) {
                allN = allN + 1;
                if (p.flags[i]) { selN = selN + 1; }
            }
        }
        this.SelectAll(isSource, selN < allN);
    }
    public void Move(TransferPane from, List<T> fd, TransferPane to, List<T> td) {
        List<int> order = this.Order(from, fd);
        List<T> moved = new List<T>();
        for (int k = 0; k < order.Count; k = k + 1) {
            int i = order[k];
            if (i < from.flags.Count && from.flags[i]) { moved.Add(fd[i]); }
        }
        if (moved.Count == 0) { return; }
        for (int k = order.Count - 1; k >= 0; k = k - 1) {
            int i = order[k];
            if (i < from.flags.Count && from.flags[i]) {
                fd.RemoveAt(i);
                from.flags.RemoveAt(i);
            }
        }
        for (int k = 0; k < moved.Count; k = k + 1) { td.Add(moved[k]); }
        this.SyncFlags(to, td.Count);
        this.Invalidate();
    }
    public void SyncFlags(TransferPane p, int n) {
        while (p.flags.Count < n) { p.flags.Add(false); }
        while (p.flags.Count > n) { p.flags.RemoveAt(p.flags.Count - 1); }
    }
    public List<int> Order(TransferPane p, List<T> data) {
        if (p.orderFor == data.Count && p.orderQuery == p.query) { return p.order; }
        List<int> res = new List<int>();
        string q = p.query.ToLower();
        for (int i = 0; i < data.Count; i = i + 1) {
            if (q == "" || this.LabelOf(data[i]).ToLower().Contains(q)) { res.Add(i); }
        }
        p.order = res;
        p.orderFor = data.Count;
        p.orderQuery = p.query;
        return res;
    }
    public string LabelOf(T item) {
        if (label != null) { return label(item); }
        return item.ToString();
    }
    public Input SearchBox(bool isSource) { TransferPane p = isSource ? left : right; return p.search; }
    public void SetQuery(bool isSource, string q) {
        TransferPane p = isSource ? left : right;
        string want = q;
        if (want == null) { want = ""; }
        if (p.query == want) { return; }
        p.query = want;
        p.scroll.Set(0);
        if (p.search != null) { p.search.SetText(want); }
    }
    public string Query(bool isSource) { TransferPane p = isSource ? left : right; return p.query; }
    public bool RowCenter(bool isSource, int dataIdx, out int cx, out int cy) {
        TransferPane p = isSource ? left : right;
        cx = 0;
        cy = 0;
        if (p.rowHPx <= 0) { return false; }
        List<int> order = p.order;
        for (int k = 0; k < order.Count; k = k + 1) {
            if (order[k] == dataIdx) {
                cx = p.bodyX + p.bodyW / 2;
                cy = p.bodyY + k * p.rowHPx + p.rowHPx / 2 - p.scroll.Get();
                return true;
            }
        }
        return false;
    }
    public static int PaintRange(TransferPane p, int a, int b, bool val) {
        int lo = a < b ? a : b;
        int hi = a < b ? b : a;
        if (lo < 0) { lo = 0; }
        if (hi > p.flags.Count - 1) { hi = p.flags.Count - 1; }
        int changed = 0;
        for (int i = lo; i <= hi; i = i + 1) {
            if (p.flags[i] != val) { p.flags[i] = val; changed = changed + 1; }
        }
        return changed;
    }
    public int CheckRange(bool isSource, int a, int b, bool val) {
        if (oneWay && !isSource) { return 0; }
        TransferPane p = isSource ? left : right;
        List<T> data = isSource ? source : target;
        this.SyncFlags(p, data.Count);
        int changed = PaintRange(p, a, b, val);
        if (changed > 0) { this.SyncOperationButtons(); SelectChanged.Post(this); }
        return changed;
    }
    private bool InPaintBand(TransferPane p, int i) {
        if (p.paintStart < 0) { return false; }
        int lo = p.paintStart;
        int hi = p.paintEnd;
        if (hi < lo) {
            int tmp = lo; lo = hi; hi = tmp;
        }
        return i >= lo && i <= hi;
    }
    private void PaintTransfer(App app, int x, int y, int w, int h) {
        app = this.ResolveApp(app);
        if (app == null) { return; }
        Canvas c = app.canvas;
        Theme t = app.theme;
        StyleBox root = this.ResolveStyleAs(app, "transfer", Class,
                                            Style.SNormal());
        int pad = root.PadLOr(app.Scale(12));
        int radius = root.RadiusOr(t.borderRadiusMedium);
        c.SurfaceRoundRect(x, y, w, h, radius, root.BgOr(0),
                           root.BorderOr(0),
                           root.BorderWOr(app.Scale(1)));
        int ix = x + pad;
        int iy = y + pad;
        int iw = w - pad * 2;
        int ih = h - pad * 2;
        if (iw < app.Scale(240)) { return; }
        this.ComputeMetrics(app);
        int panelW = (iw - opW - opGap * 2) / 2;
        if (panelW < app.Scale(100)) { panelW = app.Scale(100); }
        bool dirty = this.RenderPane(app, left, source, ix, iy, panelW, ih,
                                     true);
        dirty = this.RenderPane(app, right, target,
                                ix + panelW + opW + opGap * 2, iy,
                                panelW, ih, false) || dirty;
        if (dirty) {
            app.NoteDamage(x, y, w, h);
            app.window.Wake();
        }
    }
    public void ComputeMetrics() { this.ComputeMetrics(this.App); }
    public void ComputeMetrics(App app) {
        app = this.ResolveApp(app);
        if (app == null) { return; }
        Theme t = app.theme;
        opGap = app.Scale(8);
        opH = t.heightSmall;
        searchH = app.Scale(30);
        headH = t.heightSmall;
        opW = app.Scale(40);
        StyleBox op = Style.Part(app, "transfer", "operation", "", Class, "",
                                 Style.SNormal());
        int osw = op.WidthOr(0);
        if (osw > opW) { opW = osw; }
        rightBtn.OnMeasure(app);
        leftBtn.OnMeasure(app);
        int bw = rightBtn.prefW;
        int lw = leftBtn.prefW;
        if (lw > bw) { bw = lw; }
        bw = bw + app.Scale(8);
        if (bw > opW) { opW = bw; }
    }
    private bool HeadSelectAll(App app, TransferPane p, List<int> order,
                       bool isSource, int hx, int iy, int headH,
                       int hy, int fs, int fg) {
        int hbox = app.Scale(16);
        int hby = iy + (headH - hbox) / 2;
        int allN = 0;
        int selN = 0;
        for (int k = 0; k < order.Count; k = k + 1) {
            int i = order[k];
            if (i < p.flags.Count) {
                allN = allN + 1;
                if (p.flags[i]) { selN = selN + 1; }
            }
        }
        if (selN > 0 && selN == allN) {
            Checkbox.PaintBox(app, hx, hby, hbox, 1000);
        } else if (selN > 0) {
            Checkbox.PaintBoxIndeterminate(app, hx, hby, hbox);
        } else {
            Checkbox.PaintBox(app, hx, hby, hbox, 0);
        }
        app.canvas.DrawText(hx + hbox + app.Scale(6), hy, selectAllText, fg, fs);
        return false;
    }
    private bool FlushPaint(TransferPane p) {
        if (p.paintStart < 0) { return false; }
        int a = p.paintStart;
        int b = p.paintEnd;
        bool val = p.paintVal;
        p.paintStart = 0 - 1;
        p.paintEnd = 0 - 1;
        if (this.IsDisabled() || (oneWay && p == right)) { return false; }
        int changed = PaintRange(p, a, b, val);
        if (changed > 0) { this.SyncOperationButtons(); SelectChanged.Post(this); }
        return changed > 0;
    }
    public bool RenderPane(App app, TransferPane p, List<T> data, int x, int y,
                    int w, int h, bool isSource) {
        Canvas c = app.canvas;
        Theme t = app.theme;
        bool dirty = false;
        StyleBox panel = Style.Part(app, "transfer", "panel", "", Class, "",
                                    Style.SNormal());
        StyleBox header = Style.Part(app, "transfer", "header", "", Class, "",
                                     Style.SNormal());
        StyleBox divider = Style.Part(app, "transfer", "divider", "", Class,
                                      "", Style.SNormal());
        StyleBox row = Style.Part(app, "transfer", "row", "", Class, "",
                                  Style.SNormal());
        StyleBox meta = Style.Part(app, "transfer", "meta", "", Class, "",
                                   Style.SNormal());
        StyleBox root = this.ResolveStyleAs(app, "transfer", Class,
                                            Style.SNormal());
        int fs = header.FontOr(Style.FontFallback(app, "small"));
        int rowH = row.HeightOr(app.Scale(36));
        int pad = t.paddingMedium;
        c.SurfaceRoundRect(x, y, w, h, panel.RadiusOr(t.borderRadiusMedium),
                           panel.BgOr(0), panel.BorderOr(0),
                           panel.BorderWOr(1));
        int ix = x + 1;
        int iy = y + 1;
        int iw = w - 2;
        int ih = h - 2;
        int count = data.Count;
        int checkedN = this.CheckedCount(p, count);
        List<int> order = this.Order(p, data);
        c.FillRect(ix, iy, iw, headH, header.BgOr(0));
        c.FillRect(ix, iy + headH - 1, iw, 1, divider.BgOr(0));
        int hx = ix + pad;
        int hy = Canvas.CenterTextY(iy, headH, fs);
        int hbox = app.Scale(16);
        dirty = this.HeadSelectAll(app, p, order, isSource, hx, iy, headH,
                                   hy, fs, header.FgOr(root.fg)) || dirty;
        hx = hx + hbox + app.Scale(6) + Canvas.MeasureText(selectAllText, fs)
             + pad;
        c.DrawText(hx, hy,
                   totalText + " " + Convert.ToString(count) + " 项",
                   meta.FgOr(root.fg), fs);
        hx = hx + Canvas.MeasureText(
                 totalText + " " + Convert.ToString(count) + " 项", fs)
             + pad;
        if (!isSource) {
            bool canClear = !oneWay && checkedN > 0 && !this.IsDisabled();
            StyleBox link = Style.Part(app, "transfer", "link", "", Class, "",
                canClear ? Style.SNormal() : Style.SDisabled());
            c.DrawText(hx, hy, clearText,
                       link.FgOr(root.accent), fs);
            int lw = Canvas.MeasureText(clearText, fs);
            c.DrawText(hx + lw + pad, hy,
                       selectedText + " " + Convert.ToString(checkedN) + " 项",
                       meta.FgOr(root.fg), fs);
        }
        iy = iy + headH;
        ih = ih - headH;
        int n = order.Count;
        int contentH = n * rowH;
        iy = p.bodyY;
        ih = p.bodyH;
        int off = p.scroll.Get();
        bool overflow = contentH > ih;
        int bodyW = p.bodyW;
        int first = off / rowH;
        if (first < 0) { first = 0; }
        int last = (off + ih) / rowH;
        if (last >= n) { last = n - 1; }
        c.PushClip(ix, iy, bodyW, ih);
        int rfs = row.FontOr(Style.FontFallback(app, "medium"));
        int rbox = app.Scale(16);
        int k = first;
        bool painting = p.paintStart >= 0;
        while (k <= last) {
            int i = order[k];
            int ry = iy + k * rowH - off;
            bool over = app.mouseX >= ix && app.mouseX < ix + bodyW
                && app.mouseY >= ry && app.mouseY < ry + rowH
                && app.mouseY >= iy && app.mouseY < iy + ih;
            bool checkedK = i < p.flags.Count && p.flags[i];
            if (this.InPaintBand(p, i)) { checkedK = p.paintVal; }
            if (over) {
                StyleBox hover = Style.Part(app, "transfer", "row", "", Class,
                                            "", Style.SHover());
                c.FillRect(ix, ry, bodyW, rowH, hover.BgOr(0));
            }
            int bx = ix + pad;
            int by = ry + (rowH - rbox) / 2;
            if (!oneWay || isSource) {
                int lvl = 0;
                if (checkedK) { lvl = 1000; }
                Checkbox.PaintBox(app, bx, by, rbox, lvl);
            }
            int tx = bx + rbox + app.Scale(8);
            if (oneWay && !isSource) { tx = ix + pad; }
            string icon = "";
            if (iconOf != null) { icon = iconOf(data[i]); }
            if (icon != "") {
                StyleBox ic = Style.Part(app, "transfer", "icon", "", Class,
                                         "", Style.SNormal());
                c.DrawGlyphIn(icon, tx, ry, rbox, rowH, rbox,
                              ic.FgOr(root.fg));
                tx = tx + rbox + app.Scale(6);
            }
            string text = Ellipsis.Fit(this.LabelOf(data[i]),
                                       ix + bodyW - pad - tx, rfs);
            c.DrawText(tx, Canvas.CenterTextY(ry, rowH, rfs), text,
                       row.FgOr(root.fg), rfs);
            k = k + 1;
        }
        c.PopClip();
        if (n == 0 && emptyText != "") {
            StyleBox empty = Style.Part(app, "transfer", "empty", "", Class,
                                        "", Style.SNormal());
            c.DrawTextCentered(ix, iy, iw, ih, emptyText,
                               empty.FgOr(root.fg),
                               Style.FontFallback(app, "small"));
        }
        return dirty;
    }
    private void SyncOperationButtons() {
        if (rightBtn != null) { rightBtn.Disabled = this.CheckedCount(left, source.Count) == 0 || this.IsDisabled(); }
        if (leftBtn != null) { leftBtn.Disabled = this.CheckedCount(right, target.Count) == 0 || this.IsDisabled(); }
    }
    public override void Arrange(int px, int py, int pw, int ph) {
        if (arrangingTransfer) { return; }
        arrangingTransfer = true;
        bx = px; by = py; bw = pw > 0 ? pw : 0; bh = ph > 0 ? ph : 0;
        App app = this.App;
        if (app == null) { arrangingTransfer = false; return; }
        this.SyncFlags(left, source.Count);
        this.SyncFlags(right, target.Count);
        this.ComputeMetrics(app);
        StyleBox style = this.ResolveStyleAs(app, "transfer", Class, Style.SNormal());
        int pad = style.PadLOr(app.Scale(12));
        int x = bx + pad;
        int y = by + pad;
        int w = bw - pad * 2;
        int h = bh - pad * 2;
        int paneW = (w - opW - opGap * 2) / 2;
        if (paneW < app.Scale(100)) { paneW = app.Scale(100); }
        int opX = x + paneW + opGap;
        rightBtn.Disabled = this.CheckedCount(left, source.Count) == 0 || this.IsDisabled();
        leftBtn.Disabled = this.CheckedCount(right, target.Count) == 0 || this.IsDisabled();
        leftBtn.visible = !oneWay;
        opBox.Arrange(opX, y, opW, h);
        rightBtn.Arrange(opX, y + h / 2 - opH - opGap / 2, opW, opH);
        if (!oneWay) { leftBtn.Arrange(opX, y + h / 2 + opGap / 2, opW, opH); }
        this.ArrangePane(app, leftRegion, source, x, y, paneW, h);
        this.ArrangePane(app, rightRegion, target, x + paneW + opW + opGap * 2, y, paneW, h);
        arrangingTransfer = false;
    }
    private void ArrangePane(App app, TransferRegion<T> region, List<T> data,
                             int x, int y, int w, int h) {
        TransferPane p = region.pane;
        int ix = x + 1;
        int iy = y + 1 + headH;
        int iw = w - 2;
        int ih = h - 2 - headH;
        if (searchable && p.search == null) {
            p.search = new Input(region.isSource ? leftHint : rightHint);
            p.search.iconLead = "search";
            p.search.Class = "small";
            this.Add(p.search);
            TransferRegionAction<T> action = new TransferRegionAction<T>(region);
            p.search.Change.Add(action.SearchChanged);
            p.search.MeasureTree(app);
        }
        if (p.search != null) {
            p.search.visible = searchable;
            if (searchable) {
                string live = p.search.GetText();
                if (live != p.query) { p.query = live; p.scroll.Set(0); }
                int pad = app.theme.paddingMedium;
                p.search.Arrange(ix + pad, iy + app.Scale(6), iw - pad * 2, searchH);
                iy = iy + searchH + app.Scale(10);
                ih = ih - searchH - app.Scale(10);
            }
        }
        StyleBox row = Style.Part(app, "transfer", "row", "", Class, "", Style.SNormal());
        int rowH = row.HeightOr(app.Scale(36));
        if (rowH < 1) { rowH = 1; }
        List<int> order = this.Order(p, data);
        region.Disabled = this.IsDisabled();
        region.LayoutRows(ix, iy, iw, ih, order.Count * rowH);
        p.bodyX = ix; p.bodyY = iy;
        p.bodyW = iw - (order.Count * rowH > ih ? app.Scale(8) : 0);
        p.bodyH = ih > 0 ? ih : 0;
        p.rowHPx = rowH;
    }
    public void SyncRegion(TransferRegion<T> region) {
        App app = this.App;
        if (app != null) { app.NoteScrollDamage(region.bx, region.by, region.bw, region.bh); }
    }
    private int RegionRow(TransferRegion<T> region, int x, int y) {
        TransferPane p = region.pane;
        if (p.rowHPx < 1 || x < p.bodyX || x >= p.bodyX + p.bodyW
            || y < p.bodyY || y >= p.bodyY + p.bodyH) { return 0 - 1; }
        List<int> order = this.Order(p, region.isSource ? source : target);
        int row = (y - p.bodyY + p.scroll.Get()) / p.rowHPx;
        return row >= 0 && row < order.Count ? order[row] : 0 - 1;
    }
    public bool BeginRegionSelection(TransferRegion<T> region, int x, int y) {
        if (this.IsDisabled() || (oneWay && !region.isSource)) { return false; }
        int row = this.RegionRow(region, x, y);
        if (row < 0) { return false; }
        TransferPane p = region.pane;
        p.paintStart = row; p.paintEnd = row;
        p.paintVal = !(row < p.flags.Count && p.flags[row]);
        this.SyncRegion(region);
        return true;
    }
    public void MoveRegionSelection(TransferRegion<T> region, int x, int y) {
        int row = this.RegionRow(region, x, y);
        if (row >= 0) { region.pane.paintEnd = row; this.SyncRegion(region); }
    }
    public void EndRegionSelection(TransferRegion<T> region) {
        this.FlushPaint(region.pane);
        this.SyncOperationButtons();
        this.SyncRegion(region);
    }
    public override void OnClick(RoutedEventArgs e) {
        if (e.handled || e.originalSource != this || this.IsDisabled()) { return; }
        App app = this.App;
        if (app == null) { return; }
        StyleBox root = this.ResolveStyleAs(app, "transfer", Class, Style.SNormal());
        int hy = by + root.PadLOr(app.Scale(12)) + 1;
        if (e.y < hy || e.y >= hy + headH) { return; }
        TransferRegion<T> region = e.x < rightRegion.bx ? leftRegion : rightRegion;
        if (!region.isSource && oneWay) { return; }
        TransferPane p = region.pane;
        List<T> data = region.isSource ? source : target;
        StyleBox header = Style.Part(app, "transfer", "header", "", Class, "", Style.SNormal());
        int fs = header.FontOr(Style.FontFallback(app, "small"));
        int pad = app.theme.paddingMedium;
        int hx = region.bx + pad;
        int selectW = app.Scale(16) + app.Scale(6) + Canvas.MeasureText(selectAllText, fs);
        if (e.x >= hx && e.x < hx + selectW) {
            List<int> order = this.Order(p, data);
            int selected = 0;
            for (int k = 0; k < order.Count; k++) { if (p.flags[order[k]]) { selected++; } }
            bool value = selected < order.Count;
            for (int k = 0; k < order.Count; k++) { p.flags[order[k]] = value; }
            SelectChanged.Post(this);
            e.Handle();
        } else if (!region.isSource) {
            hx = hx + selectW + pad + Canvas.MeasureText(totalText + " " + Convert.ToString(data.Count) + " 项", fs) + pad;
            if (e.x >= hx && e.x < hx + Canvas.MeasureText(clearText, fs)) {
                this.ClearPane(p, data, true);
                e.Handle();
            }
        }
        if (e.handled) { this.Arrange(bx, by, bw, bh); app.NoteDamage(bx, by, bw, bh); }
    }
    public void SearchRegionChanged(TransferRegion<T> region) {
        TransferPane p = region.pane;
        if (p.search == null) { return; }
        string live = p.search.GetText();
        if (live != p.query) {
            p.query = live;
            p.scroll.Set(0);
            this.Arrange(bx, by, bw, bh);
            this.SyncRegion(region);
        }
    }
    public override void OnMeasure(App app) {
        this.SyncBinding();
        app = this.ResolveApp(app);
        this.ComputeMetrics(app);
        if (app == null) { return; }
        int pad = app.Scale(12);
        int head = headH;
        int search = searchable ? searchH + app.Scale(10) : 0;
        prefW = pad * 2 + (app.Scale(160) * 2 + opW + opGap * 2);
        prefH = pad * 2 + 2 + head + search + app.Scale(36) * 6;
    }
    public override void OnPaint(App app) {
        this.SyncBinding();
        app = this.ResolveApp(app);
        this.PaintTransfer(app, bx, by, bw, bh);
    }

    // 覆写：返回设计器属性清单（oneWay/searchable/emptyText/
    // searchHintLeft/searchHintRight）。
    protected override List<PropSpec> DefineProps() {
        List<PropSpec> ps = new List<PropSpec>();
        PropSpec one = PropSpec.Bool("oneWay", "One way");
        one.Field("oneWay");
        one.WithTip("Only move right: the back button disappears and "
                    + "the right column becomes read-only.");
        ps.Add(one);
        ps.Add(PropSpec.Bool("searchable", "Searchable")
            .Field("searchable")
            .WithTip("Add a filter input to the head of each panel."));
        ps.Add(PropSpec.Text("emptyText", "Empty text").Field("emptyText"));
        ps.Add(PropSpec.Text("searchHintLeft", "Left search hint").Field("leftHint"));
        ps.Add(PropSpec.Text("searchHintRight", "Right search hint").Field("rightHint"));
        PropSpec sa = PropSpec.Text("selectAllText", "Select-all label");
        sa.Field("selectAllText");
        sa.WithTip("Footer label; the factory default applies only when "
                   + "never written (writing an empty string renders it blank).");
        ps.Add(sa);
        ps.Add(PropSpec.Text("totalText", "Total label").Field("totalText"));
        ps.Add(PropSpec.Text("selectedText", "Selected label").Field("selectedText"));
        ps.Add(PropSpec.Text("clearText", "Clear label").Field("clearText"));
        return ps;
    }
}
