using System;
using Gui;
using Gui.Backend;

namespace Gui.Widget;

// 穿梭框（Transfer）：左右两栏列表，左栏勾选后经中缝按钮「穿梭」
// 到右栏，右栏勾选可移回。每一栏是一块独立的虚拟化面板——头部
// （全选 / 计数 / 清除）、可选搜索框、复选行区与空态占位——所以
// 四万项与一屏同开销。绑定的是调用方自己的两个列表（不拷贝），
// 行文本由 `CellOf<T>` 委托读出（未给时取 `item.ToString()`）。
// t.Bind(model.left, model.right);       // 两个 List<string>
// t.WithSearch();                         // 两栏各加一个过滤框
// t.Change += () => { Save(); };          // 数据移动后触发
// t.Render(app, x, y, w, h);              // 每帧画进这块框
// 勾选态是控件的瞬时 UI 状态（不反向写进宿主列表），`Checked()` /
// `CheckedRight()` 随时可读。中缝的移动按钮走保留态 `Button`
// （primary 皮肤、Disabled 联动对应侧的勾选数），因此外观与
// 全库按钮一体，宿主也能经 `MoveRightButton()` 直接拿到引用定制。
// 移动只搬「当前过滤结果里被勾的」行：滚多远都不会丢点。
public class Transfer<T> : Control {
    // 绑定的源侧列表（宿主列表本体，不拷贝）。
    public List<T> source;
    // 绑定的目标侧列表（宿主列表本体，不拷贝）。
    public List<T> target;
    // 左 / 右栏各自的瞬时状态（勾选、滚动、过滤）。
    public TransferPane left;
    public TransferPane right;
    // 行文本委托（未设时取 `item.ToString()`）。
    public CellOf<T> label;
    // 行首图标委托（null = 不画图标）。
    public IconOf<T> iconOf;
    // 是否在两栏头部下各显示搜索框。
    public bool searchable;
    // 左 / 右栏搜索框占位文字。
    public string leftHint;
    public string rightHint;
    // 单向模式：只可右移，右栏只读、左移按钮消失。
    public bool oneWay;
    // 空栏占位文案。
    public string emptyText;
    // 表头文案：全选复选框标题 / 计数 / 已选 / 清除。
    public string selectAllText;
    public string totalText;
    public string selectedText;
    public string clearText;
    // 按住拖拽多选：按下行暂存的切换（抬起帧统一入账，保住
    // Ui.Clicked 的单次语义）、拖过即置的目标态，以及「上一次
    // 按下是否成过一次拖动」——双击的第二次按下若紧接一次拖动
    // 后落在同一行，不能把刚入账的切换再翻回去。
    public int pendRow;
    public int pendPane;
    public bool pendOn;
    public bool wasPaint;
    public bool lastDrag;
    // 中缝移动按钮（声明式 Flex 容器，由 Flex 弹性列排布）
    public Button rightBtn;
    public Button leftBtn;
    public Flex opBox;

    // 数据移动后触发（宿主读回 source/target 或做持久化）。
    public UiEvent Change;
    // 任意一侧勾选集合变化。
    public UiEvent SelectChanged;
    // 表头 / 中缝 / 搜索框的布局度量，ComputeMetrics 里算好，
    // OnMeasure 与 Render 共用（保证宿主给的框高第一次就够）。
    public int opW;
    public int opGap;
    public int opH;
    public int searchH;
    public int headH;

    // 初始化：置空双栏数据与默认文案（全选/共/已选/清除/无数据）、
    // 中缝按钮与布局度量。
    private void InitTransfer() {
        this.InitControl("transfer", 5);
        source = new List<T>();
        target = new List<T>();
        left = new TransferPane();
        right = new TransferPane();
        label = null;
        iconOf = null;
        searchable = false;
        leftHint = "";
        rightHint = "";
        oneWay = false;
        emptyText = "无数据";
        selectAllText = "全选";
        totalText = "共";
        selectedText = "已选";
        clearText = "清除";
        rightBtn = new Button();
        rightBtn.Class = "primary small";
        rightBtn.Icon = "chevron-right";
        leftBtn = new Button();
        leftBtn.Class = "primary small";
        leftBtn.Icon = "chevron-left";
        opBox = new Flex();
        opBox.ClassName = "column align-center justify-center gap-small";
        opBox.Add(rightBtn);
        opBox.Add(leftBtn);
        wiresOwnEvents = true;
        Change = new UiEvent();
        SelectChanged = new UiEvent();
        opW = 0;
        opGap = 0;
        opH = 0;
        searchH = 0;
        headH = 0;
    }

    // 默认构造：绑定前两侧都是空列表。
    public Transfer() { InitTransfer(); }

    // 直接带初始数据（宿主通常用 Bind 保留实时视图）。
    public Transfer(List<T> src, List<T> tgt) {
        InitTransfer();
        this.Bind(src, tgt);
    }

    // 控件类型标识（序列化/设计器用）。
    public override string Kind() { return "Transfer"; }

    // 覆写：CSS 类型选择器名（"transfer"）。
    public override string StyleType() { return "transfer"; }

    // ---- 数据 ----

    // 绑定两侧列表。不拷贝：每帧都从中读行，所以宿主改动列表
    // （增删条目）后下一帧即生效；勾选标记按行序自动伸缩。
    public Transfer<T> Bind(List<T> src, List<T> tgt) {
        if (src != null) { source = src; }
        if (tgt != null) { target = tgt; }
        this.Invalidate();
        return this;
    }

    // 标记两侧过滤行序过期（宿主在 Bind 之外改了数据时调用）。
    public void Refresh() { this.Invalidate(); }

    // 使两侧过滤行序缓存失效（下次 Order 重建）。
    public void Invalidate() {
        left.orderFor = 0 - 1;
        right.orderFor = 0 - 1;
    }

    // 行文本委托（未设时取 `item.ToString()`）。
    public Transfer<T> WithLabel(CellOf<T> text) { label = text; this.Invalidate(); return this; }

    // 行首图标委托（返回 Gui.Icon 名）。
    public Transfer<T> WithIcon(IconOf<T> icon) { iconOf = icon; return this; }

    // 两栏头部下各加一个搜索框（按行文本子串过滤，忽略大小写）。
    public Transfer<T> WithSearch() { searchable = true; return this; }

    // 搜索框占位文字（两栏同一文案）。
    public Transfer<T> WithSearchHint(string hint) {
        searchable = true;
        leftHint = hint;
        rightHint = hint;
        return this;
    }

    // 两栏各自的搜索框占位文字。
    public Transfer<T> WithSearchHints(string lh, string rh) {
        searchable = true;
        leftHint = lh;
        rightHint = rh;
        return this;
    }

    // 仅右移：左向按钮彻底消失，右栏变成只读列表（不可回退）。
    public Transfer<T> WithOneWay() {
        oneWay = true;
        return this;
    }

    // 空栏占位文案（默认「无数据」）。
    public Transfer<T> WithEmptyText(string text) { emptyText = text; return this; }

    // 表头文案（按中文默认：全选 / 共 / 已选 / 清除；空参不改）。
    public Transfer<T> WithHeaderText(string selectAll, string total,
                               string selected, string clear) {
        if (selectAll != "") { selectAllText = selectAll; }
        if (total != "") { totalText = total; }
        if (selected != "") { selectedText = selected; }
        if (clear != "") { clearText = clear; }
        return this;
    }

    // 中缝按钮图标（两枚，默认 chevron-right / chevron-left）。
    public Transfer<T> WithOperationIcons(string rightIcon, string leftIcon) {
        if (rightIcon != "") { rightBtn.Icon = rightIcon; }
        if (leftIcon != "") { leftBtn.Icon = leftIcon; }
        return this;
    }

    // 中缝按钮文字（Ant Design operations：给了文字就取代图标）。
    public Transfer<T> WithOperation(string rightLabel, string leftLabel) {
        rightBtn.Text = rightLabel;
        rightBtn.Icon = "";
        leftBtn.Text = leftLabel;
        leftBtn.Icon = "";
        return this;
    }

    // 暴露中缝移动按钮：宿主可继续定制（Text / Icon / Tip /
    // OnClick 追加自己的逻辑）。
    public Button MoveRightButton() { return rightBtn; }

    // 暴露中缝回退按钮（同上；单向模式下不可见）。
    public Button MoveLeftButton() { return leftBtn; }

    // ---- 勾选与移动 ----

    // 源侧 / 目标侧条目数。
    public int SourceCount() { return source.Count; }

    // 目标侧条目数。
    public int TargetCount() { return target.Count; }

    // 某侧在当前过滤关键词下可见的行数（Order 缓存的重建结果）。
    public int VisibleCount(bool isSource) {
        TransferPane p = isSource ? left : right;
        List<T> data = isSource ? source : target;
        return this.Order(p, data).Count;
    }

    // 源侧绑定的列表本体。
    public List<T> Source() { return source; }
    // 目标侧绑定的列表本体。
    public List<T> Target() { return target; }

    // `item` 当前所在一侧是否被勾选。
    public bool IsChecked(T item) {
        int i = source.IndexOf(item);
        if (i >= 0) { return this.FlagAt(left, i); }
        int j = target.IndexOf(item);
        if (j >= 0) { return this.FlagAt(right, j); }
        return false;
    }

    // 某栏第 i 行的勾选标记（越界返回 false）。
    public bool FlagAt(TransferPane p, int i) {
        if (i < 0 || i >= p.flags.Count) { return false; }
        return p.flags[i];
    }

    // `item` 所在一侧的勾选开关；找不到（还没 Bind）则为空操作。
    public void SetChecked(T item, bool on) {
        int i = source.IndexOf(item);
        if (i >= 0) { this.SetFlag(left, i, on, source.Count); return; }
        int j = target.IndexOf(item);
        if (j >= 0) { this.SetFlag(right, j, on, target.Count); }
    }

    // 写某栏第 i 行的勾选标记；变化时 Post SelectChanged。
    public void SetFlag(TransferPane p, int i, bool on, int n) {
        this.SyncFlags(p, n);
        if (i < 0 || i >= p.flags.Count) { return; }
        if (p.flags[i] == on) { return; }
        p.flags[i] = on;
        SelectChanged.PostS(this);
    }

    // 左栏当前被勾选的实体（按行序）。
    public List<T> Checked() { return this.CheckedIn(source, left); }
    // 右栏当前被勾选的实体。
    public List<T> CheckedRight() { return this.CheckedIn(target, right); }

    // 两侧当前被勾选的行数（头部计数与半选态用）。
    public int CheckedSource() { return this.CheckedCount(left, source.Count); }
    // 右栏当前被勾选的行数（单向模式恒 0）。
    public int CheckedTarget() { return this.CheckedCount(right, target.Count); }

    // 收集某栏被勾选的实体（按行序）。
    public List<T> CheckedIn(List<T> data, TransferPane p) {
        List<T> outp = new List<T>();
        int n = data.Count;
        if (n > p.flags.Count) { n = p.flags.Count; }
        for (int i = 0; i < n; i = i + 1) {
            if (p.flags[i]) { outp.Add(data[i]); }
        }
        return outp;
    }

    // 某栏前 count 行中被勾选的行数。
    public int CheckedCount(TransferPane p, int count) {
        int c = 0;
        int n = count;
        if (n > p.flags.Count) { n = p.flags.Count; }
        for (int i = 0; i < n; i = i + 1) { if (p.flags[i]) { c = c + 1; } }
        return c;
    }

    // 编程式移动：把源侧被勾选项搬到目标侧末尾（保持行序），
    // 触发 Change。宿主在自定义移动入口里调用。
    public void MoveRight() {
        this.Move(left, source, right, target);
        Change.PostS(this);
    }
    // 编程式移动：把目标侧被勾选项搬回源侧末尾（保持行序），
    // 触发 Change。单向模式下等价空操作（按钮不可见）。
    public void MoveLeft() {
        this.Move(right, target, left, source);
        Change.PostS(this);
    }

    // 清空两侧的勾选标记（all=false 只清当前过滤结果里的勾选）。
    public void ClearChecked(bool all) {
        this.ClearPane(left, source, all);
        this.ClearPane(right, target, all);
    }

    // 编程式「清除」：与右栏表头清除链接同一实现（清掉右栏全部
    // 勾选；单向模式右栏只读，为空操作）。
    public void ClearAll() {
        if (oneWay) { return; }
        this.ClearPane(right, target, true);
    }

    // 清一栏勾选：all=true 清全部，false 只清当前过滤结果里的。
    public void ClearPane(TransferPane p, List<T> data, bool all) {
        bool dirty = false;
        if (all) {
            for (int i = 0; i < p.flags.Count; i = i + 1) {
                if (p.flags[i]) { p.flags[i] = false; dirty = true; }
            }
        } else {
            List<int> order = this.Order(p, data);
            for (int k = 0; k < order.Count; k = k + 1) {
                int i = order[k];
                if (i < p.flags.Count && p.flags[i]) {
                    p.flags[i] = false;
                    dirty = true;
                }
            }
        }
        if (dirty) { SelectChanged.PostS(this); }
    }

    // 程序化全选/取消勾选某侧（只作用于当前过滤结果的可见行，
    // 与表头全选框同一语义）。单向模式的右栏只读，为空操作。
    public void SelectAll(bool isSource, bool on) {
        if (oneWay && !isSource) { return; }
        TransferPane p = isSource ? left : right;
        List<T> data = isSource ? source : target;
        this.SyncFlags(p, data.Count);
        List<int> order = this.Order(p, data);
        bool dirty = false;
        for (int k = 0; k < order.Count; k = k + 1) {
            int i = order[k];
            if (i < p.flags.Count && p.flags[i] != on) {
                p.flags[i] = on;
                dirty = true;
            }
        }
        if (dirty) { SelectChanged.PostS(this); }
    }

    // 勾选/取消勾选某侧当前过滤结果的全部可见行（表头全选框的
    // 单向对位：on=false 即清空可见勾选）。
    public void SelectAllVisible(bool isSource) {
        TransferPane p = isSource ? left : right;
        List<T> data = isSource ? source : target;
        int selN = 0;
        int allN = 0;
        List<int> order = this.Order(p, data);
        for (int k = 0; k < order.Count; k = k + 1) {
            int i = order[k];
            if (i < p.flags.Count) {
                allN = allN + 1;
                if (p.flags[i]) { selN = selN + 1; }
            }
        }
        this.SelectAll(isSource, selN < allN);
    }

    // 移动核心：按源侧当前可见行序（过滤时只搬看得见的勾选）
    // 把勾选项 append 到目标侧末尾，并从源侧原位删除
    // （倒序删避免行序漂移）。搬完源侧勾选清零。
    public void Move(TransferPane from, List<T> fd, TransferPane to, List<T> td) {
        List<int> order = this.Order(from, fd);
        List<T> moved = new List<T>();
        for (int k = 0; k < order.Count; k = k + 1) {
            int i = order[k];
            if (i < from.flags.Count && from.flags[i]) { moved.Add(fd[i]); }
        }
        if (moved.Count == 0) { return; }
        for (int k = order.Count - 1; k >= 0; k = k - 1) {
            int i = order[k];
            if (i < from.flags.Count && from.flags[i]) {
                fd.RemoveAt(i);
                from.flags.RemoveAt(i);
            }
        }
        for (int k = 0; k < moved.Count; k = k + 1) { td.Add(moved[k]); }
        this.SyncFlags(to, td.Count);
        this.Invalidate();
    }

    // flags 与数据长度对齐（宿主在 Bind 之外改了列表时自愈）。
    public void SyncFlags(TransferPane p, int n) {
        while (p.flags.Count < n) { p.flags.Add(false); }
        while (p.flags.Count > n) { p.flags.RemoveAt(p.flags.Count - 1); }
    }

    // 一栏当前过滤后的行序（缓存：数据计数与关键词都没变就复用）。
    public List<int> Order(TransferPane p, List<T> data) {
        if (p.orderFor == data.Count && p.orderQuery == p.query) {
            return p.order;
        }
        List<int> res = new List<int>();
        string q = p.query.ToLower();
        for (int i = 0; i < data.Count; i = i + 1) {
            if (q == "" || this.LabelOf(data[i]).ToLower().Contains(q)) {
                res.Add(i);
            }
        }
        p.order = res;
        p.orderFor = data.Count;
        p.orderQuery = p.query;
        return res;
    }

    // 行文本：label 委托优先，缺省 `item.ToString()`。
    public string LabelOf(T item) {
        if (label != null) { return label(item); }
        return item.ToString();
    }

    // ---- 布局与渲染 ----

    // 跨帧保留的搜索框（未渲染前为 null）：宿主经它定制
    // Clearable、MaxLen 等 Input 能力。
    public Input SearchBox(bool isSource) {
        TransferPane p = isSource ? left : right;
        return p.search;
    }

    // 程序化设定某侧过滤关键词（远程搜索 / 代码驱动筛选用）：等价于
    // 往那侧搜索框里打字，行序缓存随之失效。渲染过搜索框时同步回显。
    public Transfer<T> SetQuery(bool isSource, string q) {
        TransferPane p = isSource ? left : right;
        string want = q;
        if (want == null) { want = ""; }
        if (p.query == want) { return this; }
        p.query = want;
        p.scroll.Set(0);
        if (p.search != null) { p.search.SetText(want); }
        return this;
    }

    // 某侧当前的过滤关键词（"" 表示未过滤）。
    public string Query(bool isSource) {
        TransferPane p = isSource ? left : right;
        return p.query;
    }

    // 第 `dataIdx` 行（原列表下标）在屏幕上的中心点（cx/cy 出参）。
    // 尚未渲染过（Render 之前的空档）或该行不在该侧时返回 false。
    public bool RowCenter(bool isSource, int dataIdx, out int cx, out int cy) {
        TransferPane p = isSource ? left : right;
        cx = 0;
        cy = 0;
        if (p.rowHPx <= 0) { return false; }
        List<int> order = p.order;
        for (int k = 0; k < order.Count; k = k + 1) {
            if (order[k] == dataIdx) {
                cx = p.bodyX + p.bodyW / 2;
                cy = p.bodyY + k * p.rowHPx + p.rowHPx / 2 - p.scroll.Get();
                return true;
            }
        }
        return false;
    }

    // 覆写：首选尺寸。
    public override void OnMeasure(App app) {
        prefW = 480;
        prefH = 320;
    }

    // 覆写：保留模式绘制——基于自身盒模型与声明式子树统一排布与交互。
    public override void OnPaint(App app) {
        int id = this.CommonId();
        SyncBinding();
        app.focus.RegisterFocusable(id);
        app.hitTester.RegisterRect(id, bx, by, bw, bh, 0);

        rightBtn.Disabled = this.CheckedCount(left, source.Count) == 0 || this.IsDisabled();
        leftBtn.Disabled = this.CheckedCount(right, target.Count) == 0 || this.IsDisabled();

        if (rightBtn.WasClicked()) {
            this.MoveRight();
            Change.RaiseS(this);
            app.RequestRedraw();
        }
        if (!oneWay && leftBtn.WasClicked()) {
            this.MoveLeft();
            Change.RaiseS(this);
            app.RequestRedraw();
        }
        On.Fire(app, id, this);
    }

    // 覆写：公共事件之外提供 "Change"/"SelectChanged"。
    public override List<string> Events() {
        List<string> e = Control.CommonEvents();
        e.Add("Change");
        e.Add("SelectChanged");
        return e;
    }

    // 覆写："Change"/"SelectChanged" 挂各自 UiEvent，其余按名称走
    // 通用路由。
    public override void BindEvent(string evt, Action a) {
        if (evt == "Change") { Change.Add(a); return; }
        if (evt == "SelectChanged") { SelectChanged.Add(a); return; }
        On.AddByName(evt, a);
    }

    // <see cref="BindEvent"/> 的 sender 通道（S = Sender）：
    // 特化事件接本控件的 UiEvent，通用事件按名路由。
    public override void BindEventS(string evt, ControlEvent a) {
        if (evt == "Change") { Change.AddS(a); return; }
        if (evt == "SelectChanged") { SelectChanged.AddS(a); return; }
        On.AddByNameS(evt, a);
    }


    // 覆写：返回设计器属性清单（oneWay/searchable/emptyText/
    // searchHintLeft/searchHintRight）。
    public override List<PropSpec> Props() {
        List<PropSpec> ps = new List<PropSpec>();
        PropSpec one = PropSpec.Bool("oneWay", "One way");
        one.flag = oneWay;
        one.WithTip("Only move right: the back button disappears and "
                    + "the right column becomes read-only.");
        ps.Add(one);
        PropSpec sea = PropSpec.Bool("searchable", "Searchable");
        sea.flag = searchable;
        sea.WithTip("Add a filter input to the head of each panel.");
        ps.Add(sea);
        PropSpec emp = PropSpec.Text("emptyText", "Empty text");
        emp.str = emptyText;
        ps.Add(emp);
        PropSpec lh = PropSpec.Text("searchHintLeft", "Left search hint");
        lh.str = leftHint;
        ps.Add(lh);
        PropSpec rh = PropSpec.Text("searchHintRight", "Right search hint");
        rh.str = rightHint;
        ps.Add(rh);
        PropSpec sa = PropSpec.Text("selectAllText", "Select-all label");
        sa.str = selectAllText;
        sa.WithTip("Footer label; the factory default applies only when "
                   + "never written (writing an empty string renders it blank).");
        ps.Add(sa);
        PropSpec tt = PropSpec.Text("totalText", "Total label");
        tt.str = totalText;
        ps.Add(tt);
        PropSpec st = PropSpec.Text("selectedText", "Selected label");
        st.str = selectedText;
        ps.Add(st);
        PropSpec ct = PropSpec.Text("clearText", "Clear label");
        ct.str = clearText;
        ps.Add(ct);
        return ps;
    }
}
