using System;
using Gui;
using Gui.Backend;
namespace Gui.Widget;
public class TextArea : TextInputBase {
    public override Control CreateCloneShell() { return new TextArea(); }
    public bool skipKeys;
    public string cacheTxt;
    public List<string> cacheLines;
    public List<TextAreaRow> rows;
    public string wrapTxt;
    public int wrapW;
    public int wrapFs;
    public bool readOnly;
    public bool autoHeight;
    private string preparedStatus;
    public void InitTextArea(Binding<string> text, string hintText) {
        this.InitTextInput("textarea", text, hintText);
        scrollY = 0;
        skipKeys = false;
        cacheTxt = "";
        cacheLines = null;
        rows = new List<TextAreaRow>();
        wrapTxt = "";
        wrapW = 0;
        wrapFs = 0;
        readOnly = false;
        autoHeight = false;
    }
    public TextArea() : this("") { }
    public TextArea(string hintText) { InitTextArea("", hintText); }
    public string Placeholder {
        get { return hint; }
        set { hint = value != null ? value : ""; }
    }
    public string ValueText {
        get { return this.GetText(); }
        set { this.SetText(value != null ? value : ""); }
    }
    public bool IsReadOnlyProp {
        get { return readOnly; }
        set { readOnly = value; }
    }
    public bool IsAutoHeight {
        get { return autoHeight; }
        set { autoHeight = value; }
    }
    public void ReadOnly(bool on) { readOnly = on; }
    public bool IsReadOnly() { return readOnly; }
    public void AutoHeight(bool on) { autoHeight = on; }
    public static int LineHeight() { return TextArea.LineHeight(App.FrameApp()); }
    public static int LineHeight(App app) {
        if (app == null) { app = App.FrameApp(); }
        if (app == null) { return 20; }
        StyleBox s = Style.Of(app, "textarea", "", Style.SNormal());
        return Canvas.FontHeight(s.FontOr(Style.FontFallback(app, "medium")))
            + app.Scale(4);
    }
    public int ContentHeight() { return this.ContentHeight(this.App); }
    public int ContentHeight(App app) {
        app = this.ResolveApp(app);
        int n = this.Lines().Count;
        if (wrapTxt == editText && wrapW > 0 && rows.Count > 0) { n = rows.Count; }
        if (n < 1) { n = 1; }
        int sc = app != null ? app.Scale(12) : 12;
        return n * TextArea.LineHeight(app) + sc;
    }
    public int Id() { return wid; }
    public void SkipKeysOnce() { skipKeys = true; }
    public override void SyncBinding() {
        base.SyncBinding();
        App host = this.FindApp();
        if (liveApp != host) { lastKeyNamedSeq = 0; }
        liveApp = host;
        string status = Control.StatusSanitize(FieldStatus);
        if (preparedStatus != status) {
            if (preparedStatus != "") { this.RemoveClass(preparedStatus); }
            if (status != "") { this.AddClass(status); }
            preparedStatus = status;
        }
        if (Round) { this.AddClass("round"); }
        else { this.RemoveClass("round"); }
        this.SyncTextBinding();
    }
    protected override bool IsEditReadOnly() { return readOnly; }
    protected override bool IsSingleLineInput() { return false; }
    int pointerInnerX;
    int pointerInnerY;
    int pointerLineH;
    int pointerFont;
    int pointerInnerW;
    int pointerInnerH;
    int preparedCaretPos = 0 - 1;
    bool preparedFocused;
    public override Rect ScrollViewport() {
        return new Rect(pointerInnerX, pointerInnerY, pointerInnerW, pointerInnerH);
    }
    public override void Arrange(int x, int y, int width, int height) {
        base.Arrange(x, y, width, height);
        App app = this.FindApp();
        if (app == null) { return; }
        StyleBox style = this.ResolveStyleAs(app, "textarea", Class, Style.SNormal());
        int left = style.PadLOr(app.Scale(6));
        int top = style.PadTOr(app.Scale(6));
        pointerInnerX = x + left;
        pointerInnerY = y + top;
        pointerInnerW = Math.Max(0, width - left - style.PadROr(app.Scale(6)));
        pointerInnerH = Math.Max(0, height - this.BottomRowH(app) - top - style.PadBOr(app.Scale(6)));
        pointerLineH = TextArea.LineHeight(app);
        pointerFont = style.FontOr(Style.FontFallback(app, "medium"));
        int wrapWidth = pointerInnerW - app.Scale(10);
        if (wrapWidth < app.Scale(24)) { wrapWidth = pointerInnerW; }
        this.Wrap(wrapWidth, pointerFont);
        this.ClampCursor();
        scrollExtent = rows.Count * pointerLineH;
        scrollExtentX = pointerInnerW;
        bool focused = this.IsFocused(app) && !this.IsDisabled();
        if (focused && (!preparedFocused || preparedCaretPos != cursorPos)) {
            int caretTop = this.RowOfPos(cursorPos) * pointerLineH;
            if (caretTop < scrollY) { scrollY = caretTop; }
            if (caretTop + pointerLineH > scrollY + pointerInnerH) {
                scrollY = caretTop + pointerLineH - pointerInnerH;
            }
        }
        scrollY = Math.Min(Math.Max(0, scrollY), Math.Max(0, scrollExtent - pointerInnerH));
        preparedFocused = focused;
        preparedCaretPos = cursorPos;
        if (!focused && selAnchor >= 0) { selAnchor = 0 - 1; }
        if (focused && !readOnly && rows != null && rows.Count > 0) {
            int row = this.RowOfPos(cursorPos);
            if (row < 0) { row = 0; }
            if (row >= rows.Count) { row = rows.Count - 1; }
            int col = Math.Min(Math.Max(0, cursorPos - rows[row].start), rows[row].len);
            string rowTxt = this.RowText(row);
            if (col > rowTxt.Length) { col = rowTxt.Length; }
            int caretX = pointerInnerX + Canvas.MeasureText(rowTxt.Substring(0, col), pointerFont);
            int caretY = pointerInnerY + row * pointerLineH - scrollY;
            app.SetImeCaret(caretX, caretY + Canvas.FontHeight(pointerFont));
        }
    }
    public override void OnPointerDown(RoutedEventArgs e) {
        base.OnPointerDown(e);
        if (e.handled || this.IsDisabled()) { return; }
        App app = this.FindApp();
        if (app == null) { return; }
        cursorPos = this.PosFromMouse(app, pointerInnerX, pointerInnerY, pointerLineH, pointerFont);
        if (!Modifiers.HasShift(e.modifiers) || selAnchor < 0) { selAnchor = cursorPos; }
        this.ClampCursor(); app.CapturePointer(this); app.RequestRedraw(); e.Handle();
    }
    public override void OnPointerMove(RoutedEventArgs e) {
        base.OnPointerMove(e);
        if (e.handled || this.IsDisabled()) { return; }
        App app = this.FindApp();
        if (app == null || app.GetCapturedPointer() != this) { return; }
        int drag = this.PosFromMouse(app, pointerInnerX, pointerInnerY, pointerLineH, pointerFont);
        if (drag != cursorPos) {
            cursorPos = drag; this.ClampCursor(); app.RequestRedraw();
        }
        e.Handle();
    }
    public override void OnPointerUp(RoutedEventArgs e) {
        base.OnPointerUp(e);
        App app = this.FindApp();
        if (app == null || app.GetCapturedPointer() != this) { return; }
        if (selAnchor == cursorPos) { selAnchor = -1; }
        app.ReleasePointerCapture(); app.RequestRedraw(); e.Handle();
    }
    public List<string> Lines() {
        string txt = editText;
        if (cacheLines == null || cacheTxt != txt) {
            cacheLines = Gui.TextWrap.SplitLines(txt);
            cacheTxt = txt;
        }
        return cacheLines;
    }
    public void Wrap(int maxW, int fs) {
        string txt = editText;
        if (wrapTxt == txt && wrapW == maxW && wrapFs == fs
            && rows.Count > 0) {
            return;
        }
        wrapTxt = txt;
        wrapW = maxW;
        wrapFs = fs;
        rows = new List<TextAreaRow>();
        List<string> lines = this.Lines();
        int abs = 0;
        for (int i = 0; i < lines.Count; i = i + 1) {
            string ln = lines[i];
            this.WrapLine(ln, abs, maxW, fs);
            abs = abs + ln.Length + 1;
        }
        if (rows.Count == 0) { rows.Add(new TextAreaRow(0, 0)); }
    }
    private void WrapLine(string ln, int abs, int maxW, int fs) {
        if (ln.Length == 0 || maxW <= 0) {
            rows.Add(new TextAreaRow(abs, ln.Length));
            return;
        }
        int p = 0;
        while (p < ln.Length) {
            string rest = ln.Substring(p, ln.Length - p);
            if (Canvas.MeasureText(rest, fs) <= maxW) {
                rows.Add(new TextAreaRow(abs + p, rest.Length));
                return;
            }
            int lo = 1;
            int hi = rest.Length;
            while (lo < hi) {
                int mid = (lo + hi + 1) / 2;
                if (Canvas.MeasureText(rest.Substring(0, mid), fs) <= maxW) {
                    lo = mid;
                } else {
                    hi = mid - 1;
                }
            }
            lo = Gui.Text.ClampCharStart(rest, lo);
            if (lo <= 0) { lo = Gui.Text.NextCharEnd(rest, 0); }
            int cut = lo;
            int sp = 0 - 1;
            for (int k = lo - 1; k >= 0; k = k - 1) {
                if ((rest[k] & 255) == 32) {
                    sp = k;
                    break;
                }
            }
            if (sp > 0) { cut = sp + 1; }
            rows.Add(new TextAreaRow(abs + p, cut));
            p = p + cut;
        }
    }
    public int RowOfPos(int pos) {
        for (int i = 0; i < rows.Count; i = i + 1) {
            int e = rows[i].start + rows[i].len;
            if (pos < e) { return i; }
            if (pos == e) {
                if (i + 1 < rows.Count && rows[i + 1].start == e) { return i + 1; }
                return i;
            }
        }
        if (rows.Count == 0) { return 0; }
        return rows.Count - 1;
    }
    public string RowText(int i) {
        if (i < 0 || i >= rows.Count) { return ""; }
        string txt = editText;
        int s = rows[i].start;
        int n = rows[i].len;
        if (s > txt.Length) { return ""; }
        if (s + n > txt.Length) { n = txt.Length - s; }
        return txt.Substring(s, n);
    }
    private void EnsureRows() { this.Wrap(wrapW, wrapFs); }
    protected override int InterceptKeyEvent(App app, int kind, int code, int mods) {
        this.EnsureRows();
        return 0;
    }
    protected override bool HandleSpecialTextChar(App app, int code) {
        if (code == 13) {
            if (this.Insert("\n")) { app.RequestRedraw(); }
            return true;
        }
        if (code == 9) {
            if (this.Insert("  ")) { app.RequestRedraw(); }
            return true;
        }
        return false;
    }
    protected override bool HandleSpecialKeyDown(App app, int code, int mods) {
        if (code == 38 || code == 40 || code == 36 || code == 35) {
            bool shift = Modifiers.HasShift(mods);
            if (shift) {
                if (selAnchor < 0) { selAnchor = cursorPos; }
            } else {
                selAnchor = -1;
            }
            if (rows == null || rows.Count == 0) { return true; }
            if (code == 38 || code == 40) {
                int caretRow = this.RowOfPos(cursorPos);
                if (caretRow < 0) { caretRow = 0; }
                if (caretRow >= rows.Count) { caretRow = rows.Count - 1; }
                int caretCol = cursorPos - rows[caretRow].start;
                int target = code == 40 ? caretRow + 1 : caretRow - 1;
                if (target >= 0 && target < rows.Count) {
                    int col = caretCol > rows[target].len ? rows[target].len : caretCol;
                    if (col < 0) { col = 0; }
                    cursorPos = Gui.Text.ClampCharStart(editText, rows[target].start + col);
                    app.RequestRedraw();
                }
            } else if (code == 36) {
                int caretRow = this.RowOfPos(cursorPos);
                if (caretRow < 0) { caretRow = 0; }
                if (caretRow >= rows.Count) { caretRow = rows.Count - 1; }
                cursorPos = rows[caretRow].start;
                app.RequestRedraw();
            } else if (code == 35) {
                int caretRow = this.RowOfPos(cursorPos);
                if (caretRow < 0) { caretRow = 0; }
                if (caretRow >= rows.Count) { caretRow = rows.Count - 1; }
                cursorPos = rows[caretRow].start + rows[caretRow].len;
                app.RequestRedraw();
            }
            return true;
        }
        return false;
    }
    protected override bool BeforeRoutedKey(App app) {
        if (skipKeys) { skipKeys = false; return false; }
        return true;
    }
    public int PosFromMouse(App app, int innerX, int innerY, int lineH, int fs) {
        if (lineH <= 0 || rows == null || rows.Count == 0) { return 0; }
        int row = (app.mouseY - innerY + scrollY) / lineH;
        if (row < 0) { row = 0; }
        if (row >= rows.Count) { row = rows.Count - 1; }
        int col = Gui.TextWrap.ColFromX(this.RowText(row), app.mouseX - innerX,
                                     fs);
        return Gui.Text.ClampCharStart(editText, rows[row].start + col);
    }
    private int PaintTextArea(App app, int x, int y, int w, int h) {
        int id = wid;
        Canvas c = app.canvas;
        Theme t = app.theme;
        bool off = this.IsDisabled();
        bool focused = app.focus.IsFocused(id) && !off;
        string txt = editText;
        StyleBox s = this.ResolveEasedStyleAsIn(
            app, id, "textarea", Class, off, false, x, y, w, h);
        if (!readOnly) { s.Paint(app, x, y, w, h); }
        int fs = s.FontOr(Style.FontFallback(app, "medium"));
        StyleBox errorStyle = null;
        if (errMsg != "") {
            errorStyle = this.ResolvePartAs(app, "textarea", "error", "",
                                            Class, Style.SNormal());
            c.DrawRect(x, y, w, h, errorStyle.BorderOr(errorStyle.fg),
                       errorStyle.BorderWOr(2));
        }
        int innerX = pointerInnerX;
        int innerY = pointerInnerY;
        int innerW = pointerInnerW;
        int innerH = pointerInnerH;
        int lineH = pointerLineH;
        int caretRow = 0;
        int caretCol = 0;
        bool hasRows = rows != null && rows.Count > 0;
        if (hasRows) {
            caretRow = this.RowOfPos(cursorPos);
            if (caretRow < 0) { caretRow = 0; }
            if (caretRow >= rows.Count) { caretRow = rows.Count - 1; }
            caretCol = cursorPos - rows[caretRow].start;
            if (caretCol < 0) { caretCol = 0; }
            if (caretCol > rows[caretRow].len) { caretCol = rows[caretRow].len; }
        }
        c.PushClip(innerX, innerY, innerW, innerH);
        if (txt == "" && !focused) {
            StyleBox placeholderStyle = this.ResolvePartAs(
                app, "textarea", "placeholder", "", Class, Style.SNormal());
            int phFs = placeholderStyle.FontOr(fs);
            int phFg = placeholderStyle.FgOr(s.fg);
            List<string> phLines = TextWrap.Lines(hint, innerW, phFs);
            int phLh = Canvas.FontHeight(phFs);
            for (int pi = 0; pi < phLines.Count; pi = pi + 1) {
                int py = innerY + pi * phLh;
                if (py >= innerY + innerH) { break; }
                c.DrawText(innerX, py, phLines[pi], phFg, phFs);
            }
        } else {
            if (focused && HasSel()) {
                int selS = SelStart();
                int selE = SelEnd();
                StyleBox selectionStyle = this.ResolvePartAs(
                    app, "textarea", "selection", "", Class, Style.SNormal());
                int selColor = selectionStyle.BgOr(s.accent);
                int nlW = Canvas.MeasureText(" ", fs);
                for (int i = 0; i < rows.Count; i = i + 1) {
                    int lineStart = rows[i].start;
                    int lineEnd = lineStart + rows[i].len;
                    int rs = selS;
                    int re = selE;
                    if (rs < lineStart) { rs = lineStart; }
                    if (re > lineEnd) { re = lineEnd; }
                    if (rs <= re && selE > lineStart && selS <= lineEnd) {
                        string rt = this.RowText(i);
                        int ly = innerY + i * lineH - scrollY;
                        int x0 = Canvas.MeasureText(rt.Substring(0, rs - lineStart), fs);
                        int x1 = Canvas.MeasureText(rt.Substring(0, re - lineStart), fs);
                        int selW = x1 - x0;
                        if (selE > lineEnd) { selW = selW + nlW; }
                        c.FillRect(innerX + x0, ly, selW, Canvas.FontHeight(fs), selColor);
                    }
                }
            }
            for (int i = 0; i < rows.Count; i = i + 1) {
                int ly = innerY + i * lineH - scrollY;
                if (ly + lineH > innerY && ly < innerY + innerH) {
                    c.DrawText(innerX, ly, this.RowText(i), s.fg, fs);
                }
            }
            if (focused && !readOnly && hasRows) {
                StyleBox caretStyle = this.ResolvePartAs(
                    app, "textarea", "caret", "", Class, Style.SNormal());
                string caretRowText = this.RowText(caretRow);
                if (caretCol > caretRowText.Length) { caretCol = caretRowText.Length; }
                int caretX = innerX + Canvas.MeasureText(
                    caretRowText.Substring(0, caretCol), fs);
                int caretY = innerY + caretRow * lineH - scrollY;
                int fh = Canvas.FontHeight(fs);
                c.FillRect(caretX, caretY, caretStyle.WidthOr(1), fh,
                           caretStyle.BgOr(caretStyle.FgOr(s.accent)));
            }
        }
        c.PopClip();
        int countReserve = 0;
        if (ShowCount) {
            StyleBox countStyle = this.ResolvePartAs(
                app, "textarea", "count", "", Class, Style.SNormal());
            int cfs = countStyle.FontOr(Style.FontFallback(app, "small"));
            string countTxt = Input.CountText(this.CountOf(txt), MaxLen);
            int cw = Canvas.MeasureText(countTxt, cfs);
            countReserve = cw + app.Scale(6);
            int cx = x + w - cw;
            if (cx < x) { cx = x; }
            c.DrawText(cx, y + h + app.Scale(2), Ellipsis.Fit(countTxt, w, cfs),
                       countStyle.FgOr(s.fg), cfs);
        }
        if (errMsg != "") {
            int efs = errorStyle.FontOr(Style.FontFallback(app, "small"));
            int errAvail = w - countReserve;
            if (errAvail > 0) {
                c.DrawText(x, y + h + app.Scale(2), Ellipsis.Fit(errMsg, errAvail, efs),
                           errorStyle.FgOr(s.fg), efs);
            }
        }
        return id;
    }
    // --- 设计器 / 序列化模型 ---

    // 覆写：CSS 类型选择器名（"textarea"，皮肤与单行 Input 区分）。
    public override string StyleType() { return "textarea"; }

    // 属性协议写文本：值没变就别碰光标/选区（属性写入可能每帧都来，而
    // SetText 的语义是「换了一段文本」，光标收到末尾）。
    public void SetTextProp(string val) {
        if (val != this.GetText()) { this.SetText(val); }
    }

    // 覆写：返回设计器属性清单（占位 / 文本 / 状态 / 长度 / 计数 / 圆角）。
    protected override List<PropSpec> DefineProps() {
        List<PropSpec> ps = new List<PropSpec>();
        ps.Add(PropSpec.Text("hint", "Placeholder").Field("hint").Also("placeholder"));
        ps.Add(PropSpec.Text("text", "Text").DefaultBinding().Accessor("GetText", "SetTextProp").Also("value"));
        ps.Add(PropSpec.Bool("countGraphemes", "Count graphemes").Field("CountGraphemes"));
        this.AddCommonTextProps(ps);
        ps.Add(PropSpec.Bool("readonly", "ReadOnly").Field("readOnly"));
        ps.Add(PropSpec.Bool("autoHeight", "AutoHeight")
            .Field("autoHeight")
            .WithTip("Grow the box with its content instead of scrolling inside a fixed height."));
        return ps;
    }

    // --- 保留式钩子（Control） ---

    // 框外底行（show-count 文本与校验消息共用同一排，框下沿 2px 起）。
    // 父容器渲染子树时会把自己的矩形作为裁剪带（Control.RenderTree 的
    // PushClip），越出测量高度的绘制会被整条裁掉——所以这一行必须计入
    // 测量高度，框体本身相应只占 bh - 本值，Render 内的描边/命中矩形
    // 仍是框的真实高度。
    public int BottomRowH() { return this.BottomRowH(this.App); }
    public int BottomRowH(App app) {
        if (!ShowCount && errMsg == "") { return 0; }
        app = this.ResolveApp(app);
        if (app == null) { return 18; }
        StyleBox cs = this.ResolvePartAs(app, "textarea", "count", "",
                                         Class, Style.SNormal());
        int cfs = cs.FontOr(Style.FontFallback(app, "small"));
        return app.Scale(2) + Canvas.FontHeight(cfs) + app.Scale(2);
    }
    public override void OnMeasure(App app) {
        this.SyncBinding();
        Theme t = app.theme;
        StyleBox s = this.ResolveStyleAs(app, "textarea", Class, Style.SNormal());
        if (autoHeight) { prefH = this.ContentHeight(app); }
        else { prefH = s.HeightOr(app.Scale(90)); }
        prefH += this.BottomRowH(app);
        prefW = s.WidthOr(app.Scale(220));
    }
    public override void OnPaint(App app) {
        this.SyncBinding();
        this.PaintTextArea(app, bx, by, bw, bh - this.BottomRowH(app));
    }
}
