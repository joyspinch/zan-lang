using System;
using Gui;
using Gui.Backend;
namespace Gui.Widget;
[GuiKind("TextArea")]
public class TextArea : Control {
    public override Control CreateCloneShell() { return new TextArea(); }
    private string editText;
    public Binding<string> Text;
    public string hint;
    public int cursorPos;
    public int selAnchor;
    public int wid;
    public bool skipKeys;
    public long lastKeyNamedSeq;
    public string cacheTxt;
    public List<string> cacheLines;
    public List<TextAreaRow> rows;
    public string wrapTxt;
    public int wrapW;
    public int wrapFs;
    public string errMsg;
    public bool readOnly;
    public bool autoHeight;
    public weak App liveApp;
    public int MaxLen;
    public bool ShowCount;
    public bool CountGraphemes;
    public string FieldStatus;
    private string preparedStatus;
    public bool Round;
    public InputFilterFn Filter;
    public UiEvent Change;
    public void InitTextArea(Binding<string> text, string hintText) {
        this.InitControl("textarea");
        Text = "";
        if (text != null) { Text = text; }
        editText = Text.Get();
        hint = hintText;
        cursorPos = 0;
        selAnchor = -1;
        scrollY = 0;
        wid = this.CommonId();
        skipKeys = false;
        cacheTxt = "";
        cacheLines = null;
        rows = new List<TextAreaRow>();
        wrapTxt = "";
        wrapW = 0;
        wrapFs = 0;
        errMsg = "";
        readOnly = false;
        autoHeight = false;
        liveApp = null;
        MaxLen = 0;
        ShowCount = false;
        CountGraphemes = false;
        FieldStatus = "";
        Round = false;
        Filter = null;
        lastKeyNamedSeq = 0;
        wiresOwnEvents = true;
        Change = new UiEvent();
    }
    public TextArea() : this("") { }
    public TextArea(string hintText) { InitTextArea("", hintText); }
    public string Placeholder {
        get { return hint; }
        set { hint = value != null ? value : ""; }
    }
    public string ValueText {
        get { return this.GetText(); }
        set { this.SetText(value != null ? value : ""); }
    }
    public bool IsReadOnlyProp {
        get { return readOnly; }
        set { readOnly = value; }
    }
    public bool IsAutoHeight {
        get { return autoHeight; }
        set { autoHeight = value; }
    }
    public string GetText() { this.SyncBinding(); return editText; }
    public void ReadOnly(bool on) { readOnly = on; }
    public bool IsReadOnly() { return readOnly; }
    public void AutoHeight(bool on) { autoHeight = on; }
    public static int LineHeight() { return TextArea.LineHeight(App.FrameApp()); }
    public static int LineHeight(App app) {
        if (app == null) { app = App.FrameApp(); }
        if (app == null) { return 20; }
        StyleBox s = Style.Of(app, "textarea", "", Style.SNormal());
        return Canvas.FontHeight(s.FontOr(Style.FontFallback(app, "medium")))
            + app.Scale(4);
    }
    public int ContentHeight() { return this.ContentHeight(this.App); }
    public int ContentHeight(App app) {
        app = this.ResolveApp(app);
        int n = this.Lines().Count;
        if (wrapTxt == editText && wrapW > 0 && rows.Count > 0) { n = rows.Count; }
        if (n < 1) { n = 1; }
        int sc = app != null ? app.Scale(12) : 12;
        return n * TextArea.LineHeight(app) + sc;
    }
    public int Id() { return wid; }
    public void SkipKeysOnce() { skipKeys = true; }
    internal override void SetDocumentText(string text, string placeholder) {
        this.SetText(text);
        cursorPos = 0;
        hint = placeholder;
    }
    public void SetText(string v) {
        editText = v;
        cursorPos = v.Length;
        selAnchor = -1;
        PushBinding();
    }
    public override void SyncBinding() {
        base.SyncBinding();
        App host = this.FindApp();
        if (liveApp != host) { lastKeyNamedSeq = 0; }
        liveApp = host;
        string status = Control.StatusSanitize(FieldStatus);
        if (preparedStatus != status) {
            if (preparedStatus != "") { this.RemoveClass(preparedStatus); }
            if (status != "") { this.AddClass(status); }
            preparedStatus = status;
        }
        if (Round) { this.AddClass("round"); }
        else { this.RemoveClass("round"); }
        string cur = Text.Get();
        if (cur != editText) {
            editText = cur;
            this.ClampCursor();
        }
    }
    private void PushBinding() { Text.Set(editText); }
    private void Edited() {
        if (errMsg != "") { errMsg = ""; }
        PushBinding();
        Change.RaiseS(this);
    }
    public void SetError(string msg) { errMsg = msg; }
    public void ClearError() { errMsg = ""; }
    public void SetStatus(string v) {
        string s = Control.StatusSanitize(v);
        if (s == FieldStatus) { return; }
        FieldStatus = s;
        if (liveApp != null) { liveApp.RequestRedraw(); }
    }
    public int CountOf(string s) {
        if (CountGraphemes) { return Gui.Text.Graphemes(s); }
        return Gui.Text.Chars(s);
    }
    public int CountValue() { return this.CountOf(this.GetText()); }
    public void SelectAll() {
        selAnchor = 0;
        cursorPos = editText.Length;
    }
    public void Clear() {
        if (editText == "") { return; }
        editText = "";
        cursorPos = 0;
        selAnchor = -1;
        Edited();
        if (liveApp != null) { liveApp.RequestRedraw(); }
    }
    public void Focus() {
        if (liveApp == null || this.IsDisabled()) { return; }
        liveApp.focus.SetFocused(wid);
        liveApp.RequestRedraw();
    }
    public void Blur() {
        if (liveApp == null) { return; }
        if (liveApp.focus.IsFocused(wid)) { liveApp.focus.ClearFocus(); }
        liveApp.RequestRedraw();
    }
    public override int InputFocusCapabilities() { return 3; }
    public override int PointerCursor() { return 1; }
    int pointerInnerX;
    int pointerInnerY;
    int pointerLineH;
    int pointerFont;
    int pointerInnerW;
    int pointerInnerH;
    int preparedCaretPos = 0 - 1;
    bool preparedFocused;
    public override Rect ScrollViewport() {
        return new Rect(pointerInnerX, pointerInnerY, pointerInnerW, pointerInnerH);
    }
    public override void Arrange(int x, int y, int width, int height) {
        base.Arrange(x, y, width, height);
        App app = this.FindApp();
        if (app == null) { return; }
        StyleBox style = this.ResolveStyleAs(app, "textarea", Class, Style.SNormal());
        int left = style.PadLOr(app.Scale(6));
        int top = style.PadTOr(app.Scale(6));
        pointerInnerX = x + left;
        pointerInnerY = y + top;
        pointerInnerW = Math.Max(0, width - left - style.PadROr(app.Scale(6)));
        pointerInnerH = Math.Max(0, height - this.BottomRowH(app) - top - style.PadBOr(app.Scale(6)));
        pointerLineH = TextArea.LineHeight(app);
        pointerFont = style.FontOr(Style.FontFallback(app, "medium"));
        int wrapWidth = pointerInnerW - app.Scale(10);
        if (wrapWidth < app.Scale(24)) { wrapWidth = pointerInnerW; }
        this.Wrap(wrapWidth, pointerFont);
        this.ClampCursor();
        scrollExtent = rows.Count * pointerLineH;
        scrollExtentX = pointerInnerW;
        bool focused = this.IsFocused(app) && !this.IsDisabled();
        if (focused && (!preparedFocused || preparedCaretPos != cursorPos)) {
            int caretTop = this.RowOfPos(cursorPos) * pointerLineH;
            if (caretTop < scrollY) { scrollY = caretTop; }
            if (caretTop + pointerLineH > scrollY + pointerInnerH) {
                scrollY = caretTop + pointerLineH - pointerInnerH;
            }
        }
        scrollY = Math.Min(Math.Max(0, scrollY), Math.Max(0, scrollExtent - pointerInnerH));
        preparedFocused = focused;
        preparedCaretPos = cursorPos;
        if (!focused && selAnchor >= 0) { selAnchor = 0 - 1; }
        if (focused && !readOnly) {
            int row = this.RowOfPos(cursorPos);
            int col = Math.Min(Math.Max(0, cursorPos - rows[row].start), rows[row].len);
            int caretX = pointerInnerX + Canvas.MeasureText(this.RowText(row).Substring(0, col), pointerFont);
            int caretY = pointerInnerY + row * pointerLineH - scrollY;
            app.SetImeCaret(caretX, caretY + Canvas.FontHeight(pointerFont));
        }
    }
    public override void OnPointerDown(RoutedEventArgs e) {
        base.OnPointerDown(e);
        if (e.handled || this.IsDisabled()) { return; }
        App app = this.FindApp();
        if (app == null) { return; }
        cursorPos = this.PosFromMouse(app, pointerInnerX, pointerInnerY, pointerLineH, pointerFont);
        if (!Modifiers.HasShift(e.modifiers) || selAnchor < 0) { selAnchor = cursorPos; }
        this.ClampCursor(); app.CapturePointer(this); app.RequestRedraw(); e.Handle();
    }
    public override void OnPointerMove(RoutedEventArgs e) {
        base.OnPointerMove(e);
        if (e.handled || this.IsDisabled()) { return; }
        App app = this.FindApp();
        if (app == null || app.GetCapturedPointer() != this) { return; }
        int drag = this.PosFromMouse(app, pointerInnerX, pointerInnerY, pointerLineH, pointerFont);
        if (drag != cursorPos) {
            cursorPos = drag; this.ClampCursor(); app.RequestRedraw();
        }
        e.Handle();
    }
    public override void OnPointerUp(RoutedEventArgs e) {
        base.OnPointerUp(e);
        App app = this.FindApp();
        if (app == null || app.GetCapturedPointer() != this) { return; }
        if (selAnchor == cursorPos) { selAnchor = -1; }
        app.ReleasePointerCapture(); app.RequestRedraw(); e.Handle();
    }
    public override int WidgetId() { return wid; }
    public void ScrollToEnd() {
        cursorPos = editText.Length;
        selAnchor = -1;
        if (liveApp != null) { liveApp.RequestRedraw(); }
    }
    public void ScrollToStart() {
        cursorPos = 0;
        selAnchor = -1;
        if (liveApp != null) { liveApp.RequestRedraw(); }
    }
    public void ClampCursor() {
        string txt = editText;
        if (cursorPos > txt.Length) { cursorPos = txt.Length; }
        if (cursorPos < 0) { cursorPos = 0; }
        if (selAnchor > txt.Length) { selAnchor = txt.Length; }
    }
    public bool HasSel() { return selAnchor >= 0 && selAnchor != cursorPos; }
    public int SelStart() { if (selAnchor >= 0 && selAnchor < cursorPos) { return selAnchor; } return cursorPos; }
    public int SelEnd() { if (selAnchor > cursorPos) { return selAnchor; } return cursorPos; }
    public string SelText() {
        if (!HasSel()) { return ""; }
        return editText.Substring(SelStart(), SelEnd() - SelStart());
    }
    public void DeleteSel() {
        if (!HasSel()) { return; }
        string txt = editText;
        int s = SelStart();
        int e = SelEnd();
        editText = txt.Substring(0, s) + txt.Substring(e, txt.Length - e);
        cursorPos = s;
        selAnchor = -1;
    }
    public bool Insert(string s) {
        string orig = editText;
        int origCursor = cursorPos;
        int origAnchor = selAnchor;
        bool hadSel = HasSel();
        if (hadSel) { DeleteSel(); }
        string txt = editText;
        string cand = Gui.Text.InsertAt(txt, cursorPos, s);
        string final = cand;
        if (Filter != null) { final = Filter(cand); }
        if (final == null
            || (MaxLen > 0 && this.CountOf(final) > MaxLen)) {
            editText = orig;
            cursorPos = origCursor;
            selAnchor = origAnchor;
            return false;
        }
        int delta = final.Length - cand.Length;
        int cp = cursorPos + s.Length + delta;
        if (cp < 0) { cp = 0; }
        if (cp > final.Length) { cp = final.Length; }
        if (final == txt && cp == cursorPos && !hadSel) {
            selAnchor = -1;
            return false;
        }
        editText = final;
        cursorPos = cp;
        selAnchor = -1;
        Edited();
        return true;
    }
    public bool DeleteCandidate(string cand) {
        string final = cand;
        if (Filter != null) { final = Filter(cand); }
        if (final == null) { return false; }
        if (final == editText) { return false; }
        editText = final;
        if (cursorPos > final.Length) { cursorPos = final.Length; }
        if (selAnchor > final.Length) { selAnchor = final.Length; }
        Edited();
        return true;
    }
    public List<string> Lines() {
        string txt = editText;
        if (cacheLines == null || cacheTxt != txt) {
            cacheLines = Gui.TextWrap.SplitLines(txt);
            cacheTxt = txt;
        }
        return cacheLines;
    }
    public void Wrap(int maxW, int fs) {
        string txt = editText;
        if (wrapTxt == txt && wrapW == maxW && wrapFs == fs
            && rows.Count > 0) {
            return;
        }
        wrapTxt = txt;
        wrapW = maxW;
        wrapFs = fs;
        rows = new List<TextAreaRow>();
        List<string> lines = this.Lines();
        int abs = 0;
        for (int i = 0; i < lines.Count; i = i + 1) {
            string ln = lines[i];
            this.WrapLine(ln, abs, maxW, fs);
            abs = abs + ln.Length + 1;
        }
        if (rows.Count == 0) { rows.Add(new TextAreaRow(0, 0)); }
    }
    private void WrapLine(string ln, int abs, int maxW, int fs) {
        if (ln.Length == 0 || maxW <= 0) {
            rows.Add(new TextAreaRow(abs, ln.Length));
            return;
        }
        int p = 0;
        while (p < ln.Length) {
            string rest = ln.Substring(p, ln.Length - p);
            if (Canvas.MeasureText(rest, fs) <= maxW) {
                rows.Add(new TextAreaRow(abs + p, rest.Length));
                return;
            }
            int lo = 1;
            int hi = rest.Length;
            while (lo < hi) {
                int mid = (lo + hi + 1) / 2;
                if (Canvas.MeasureText(rest.Substring(0, mid), fs) <= maxW) {
                    lo = mid;
                } else {
                    hi = mid - 1;
                }
            }
            lo = Gui.Text.ClampCharStart(rest, lo);
            if (lo <= 0) { lo = Gui.Text.NextCharEnd(rest, 0); }
            int cut = lo;
            int sp = 0 - 1;
            for (int k = lo - 1; k >= 0; k = k - 1) {
                if ((rest[k] & 255) == 32) {
                    sp = k;
                    break;
                }
            }
            if (sp > 0) { cut = sp + 1; }
            rows.Add(new TextAreaRow(abs + p, cut));
            p = p + cut;
        }
    }
    public int RowOfPos(int pos) {
        for (int i = 0; i < rows.Count; i = i + 1) {
            int e = rows[i].start + rows[i].len;
            if (pos < e) { return i; }
            if (pos == e) {
                if (i + 1 < rows.Count && rows[i + 1].start == e) { return i + 1; }
                return i;
            }
        }
        if (rows.Count == 0) { return 0; }
        return rows.Count - 1;
    }
    public string RowText(int i) {
        if (i < 0 || i >= rows.Count) { return ""; }
        string txt = editText;
        int s = rows[i].start;
        int n = rows[i].len;
        if (s > txt.Length) { return ""; }
        if (s + n > txt.Length) { n = txt.Length - s; }
        return txt.Substring(s, n);
    }
    private void EnsureRows() { this.Wrap(wrapW, wrapFs); }
    private bool HandleKeyEvent(App app, int kind, int code, int mods) {
        this.EnsureRows();
        this.ClampCursor();
        string txt = editText;
        if (kind == 6) {
            if (readOnly) { return false; }
            if (code == 8) {
                if (HasSel()) {
                    DeleteSel();
                    Edited();
                    app.RequestRedraw();
                } else if (cursorPos > 0) {
                    int start = Gui.Text.PrevCharStart(txt, cursorPos);
                    if (this.DeleteCandidate(Gui.Text.DeleteBefore(txt, cursorPos))) { cursorPos = start; }
                    app.RequestRedraw();
                }
                return true;
            } else if (code == 13) {
                if (this.Insert("\n")) { app.RequestRedraw(); }
                return true;
            } else if (code == 9) {
                if (this.Insert("  ")) { app.RequestRedraw(); }
                return true;
            } else {
                string ch = Gui.Text.CharStr(code);
                if (ch.Length > 0 && app.window.EventSeq() != this.lastKeyNamedSeq) {
                    this.lastKeyNamedSeq = app.window.EventSeq();
                    this.FireKeyNamed("KeyPress");
                    if (this.IsDisabled() || readOnly || !this.IsFocused(app)) { return true; }
                    if (this.Insert(ch)) { app.RequestRedraw(); }
                    return true;
                }
            }
        } else if (kind == 4) {
            int kc = code;
            bool shift = Modifiers.HasShift(mods);
            bool ctrl = Modifiers.HasCtrl(mods);
            if (ctrl && kc == 65) {
                selAnchor = 0;
                cursorPos = txt.Length;
                app.RequestRedraw();
                return true;
            } else if (ctrl && kc == 67) {
                if (HasSel()) { Clipboard.SetText(SelText()); }
                else { Clipboard.SetText(txt); }
                return true;
            } else if (ctrl && kc == 88) {
                if (readOnly) { return false; }
                if (HasSel()) {
                    Clipboard.SetText(SelText());
                    DeleteSel();
                    Edited();
                    app.RequestRedraw();
                }
                return true;
            } else if (ctrl && kc == 86) {
                if (readOnly) { return false; }
                string clip = Clipboard.GetText();
                if (clip.Length > 0) {
                    if (this.Insert(clip)) { app.RequestRedraw(); }
                }
                return true;
            } else if (kc == 37 || kc == 39 || kc == 38 || kc == 40
                       || kc == 36 || kc == 35) {
                if (shift) {
                    if (selAnchor < 0) { selAnchor = cursorPos; }
                } else {
                    selAnchor = -1;
                }
                if (kc == 37) {
                    if (cursorPos > 0) { cursorPos = Gui.Text.PrevCharStart(txt, cursorPos); }
                    app.RequestRedraw();
                } else if (kc == 39) {
                    if (cursorPos < txt.Length) { cursorPos = Gui.Text.NextCharEnd(txt, cursorPos); }
                    app.RequestRedraw();
                } else if (kc == 38 || kc == 40) {
                    int caretRow = this.RowOfPos(cursorPos);
                    int caretCol = cursorPos - rows[caretRow].start;
                    int target = caretRow - 1;
                    if (kc == 40) { target = caretRow + 1; }
                    if (target >= 0 && target < rows.Count) {
                        int col = caretCol;
                        if (col > rows[target].len) { col = rows[target].len; }
                        cursorPos = rows[target].start + col;
                        app.RequestRedraw();
                    }
                } else if (kc == 36) {
                    cursorPos = rows[this.RowOfPos(cursorPos)].start;
                    app.RequestRedraw();
                } else if (kc == 35) {
                    int caretRow = this.RowOfPos(cursorPos);
                    cursorPos = rows[caretRow].start + rows[caretRow].len;
                    app.RequestRedraw();
                }
                return true;
            } else if (kc == 46) {
                if (readOnly) { return false; }
                if (HasSel()) {
                    DeleteSel();
                    Edited();
                    app.RequestRedraw();
                } else if (cursorPos < txt.Length) {
                    if (this.DeleteCandidate(Gui.Text.RemoveAt(txt, cursorPos))) { app.RequestRedraw(); }
                }
                return true;
            }
        }
        return false;
    }
    private void HandleRoutedKey(RoutedEventArgs e, int kind) {
        if (e.handled || this.IsDisabled()) { return; }
        App app = this.FindApp();
        if (app == null) { app = liveApp; }
        if (app == null || !this.IsFocused(app)) { return; }
        if (liveApp != app) { lastKeyNamedSeq = 0; }
        liveApp = app;
        if (skipKeys) { skipKeys = false; return; }
        this.SyncBinding();
        if (this.HandleKeyEvent(app, kind, e.keyCode, e.modifiers)) { e.Handle(); }
    }
    public override void OnKeyDown(RoutedEventArgs e) { this.HandleRoutedKey(e, 4); }
    public override void OnKeyUp(RoutedEventArgs e) { this.HandleRoutedKey(e, 5); }
    public override void OnTextInput(RoutedEventArgs e) { this.HandleRoutedKey(e, 6); }
    public int PosFromMouse(App app, int innerX, int innerY, int lineH, int fs) {
        int row = (app.mouseY - innerY + scrollY) / lineH;
        if (row < 0) { row = 0; }
        if (row >= rows.Count) { row = rows.Count - 1; }
        if (row < 0) { return 0; }
        int col = Gui.TextWrap.ColFromX(this.RowText(row), app.mouseX - innerX,
                                     fs);
        return rows[row].start + col;
    }
    private int PaintTextArea(App app, int x, int y, int w, int h) {
        int id = wid;
        Canvas c = app.canvas;
        Theme t = app.theme;
        bool off = this.IsDisabled();
        bool focused = app.focus.IsFocused(id) && !off;
        string txt = editText;
        StyleBox s = this.ResolveEasedStyleAsIn(
            app, id, "textarea", Class, off, false, x, y, w, h);
        if (!readOnly) { s.Paint(app, x, y, w, h); }
        int fs = s.FontOr(Style.FontFallback(app, "medium"));
        StyleBox errorStyle = null;
        if (errMsg != "") {
            errorStyle = this.ResolvePartAs(app, "textarea", "error", "",
                                            Class, Style.SNormal());
            c.DrawRect(x, y, w, h, errorStyle.BorderOr(errorStyle.fg),
                       errorStyle.BorderWOr(2));
        }
        int innerX = pointerInnerX;
        int innerY = pointerInnerY;
        int innerW = pointerInnerW;
        int innerH = pointerInnerH;
        int lineH = pointerLineH;
        int caretRow = this.RowOfPos(cursorPos);
        int caretCol = cursorPos - rows[caretRow].start;
        if (caretCol < 0) { caretCol = 0; }
        if (caretCol > rows[caretRow].len) { caretCol = rows[caretRow].len; }
        c.PushClip(innerX, innerY, innerW, innerH);
        if (txt == "" && !focused) {
            StyleBox placeholderStyle = this.ResolvePartAs(
                app, "textarea", "placeholder", "", Class, Style.SNormal());
            c.DrawText(innerX, innerY, hint, placeholderStyle.FgOr(s.fg),
                       placeholderStyle.FontOr(fs));
        } else {
            if (focused && HasSel()) {
                int selS = SelStart();
                int selE = SelEnd();
                StyleBox selectionStyle = this.ResolvePartAs(
                    app, "textarea", "selection", "", Class, Style.SNormal());
                int selColor = selectionStyle.BgOr(s.accent);
                int nlW = Canvas.MeasureText(" ", fs);
                for (int i = 0; i < rows.Count; i = i + 1) {
                    int lineStart = rows[i].start;
                    int lineEnd = lineStart + rows[i].len;
                    int rs = selS;
                    int re = selE;
                    if (rs < lineStart) { rs = lineStart; }
                    if (re > lineEnd) { re = lineEnd; }
                    if (rs <= re && selE > lineStart && selS <= lineEnd) {
                        string rt = this.RowText(i);
                        int ly = innerY + i * lineH - scrollY;
                        int x0 = Canvas.MeasureText(rt.Substring(0, rs - lineStart), fs);
                        int x1 = Canvas.MeasureText(rt.Substring(0, re - lineStart), fs);
                        int selW = x1 - x0;
                        if (selE > lineEnd) { selW = selW + nlW; }
                        c.FillRect(innerX + x0, ly, selW, Canvas.FontHeight(fs), selColor);
                    }
                }
            }
            for (int i = 0; i < rows.Count; i = i + 1) {
                int ly = innerY + i * lineH - scrollY;
                if (ly + lineH > innerY && ly < innerY + innerH) {
                    c.DrawText(innerX, ly, this.RowText(i), s.fg, fs);
                }
            }
            if (focused && !readOnly) {
                StyleBox caretStyle = this.ResolvePartAs(
                    app, "textarea", "caret", "", Class, Style.SNormal());
                int caretX = innerX + Canvas.MeasureText(
                    this.RowText(caretRow).Substring(0, caretCol), fs);
                int caretY = innerY + caretRow * lineH - scrollY;
                int fh = Canvas.FontHeight(fs);
                c.FillRect(caretX, caretY, caretStyle.WidthOr(1), fh,
                           caretStyle.BgOr(caretStyle.FgOr(s.accent)));
            }
        }
        c.PopClip();
        if (errMsg != "") {
            c.DrawText(x, y + h + app.Scale(2), errMsg,
                       errorStyle.FgOr(s.fg),
                       errorStyle.FontOr(Style.FontFallback(app, "small")));
        }
        if (ShowCount) {
            StyleBox countStyle = this.ResolvePartAs(
                app, "textarea", "count", "", Class, Style.SNormal());
            int cfs = countStyle.FontOr(Style.FontFallback(app, "small"));
            string countTxt = Input.CountText(this.CountOf(txt), MaxLen);
            int cw = Canvas.MeasureText(countTxt, cfs);
            c.DrawText(x + w - cw, y + h + app.Scale(2), countTxt,
                       countStyle.FgOr(s.fg), cfs);
        }
        return id;
    }
    public override string Kind() { return "TextArea"; }
    public override string StyleType() { return "textarea"; }
    protected override List<PropSpec> DefineProps() {
        List<PropSpec> ps = new List<PropSpec>();
        ps.Add(PropSpec.Text("hint", "Placeholder").Field("hint", 0).Also("placeholder"));
        ps.Add(PropSpec.Text("text", "Text").DefaultBinding().ViaExtra().Also("value").Also("data"));
        PropSpec st = PropSpec.Enum("status", "Status",
            new List<string>{ "", "success", "warning", "error" });
        st.Field("FieldStatus", 0);
        ps.Add(st);
        ps.Add(PropSpec.Int("maxlen", "MaxLen").Field("MaxLen", 1).Step(1, 0, 4096));
        ps.Add(PropSpec.Bool("showCount", "ShowCount").Field("ShowCount", 2));
        ps.Add(PropSpec.Bool("round", "Round").Field("Round", 2));
        ps.Add(PropSpec.Bool("readonly", "ReadOnly").Field("readOnly", 2));
        ps.Add(PropSpec.Bool("autoHeight", "AutoHeight").Field("autoHeight", 2).WithTip("Grow the box with its content instead of scrolling inside a fixed height."));
        return ps;
    }
    public override string GetExtra(string key) {
        if (key == "text" || key == "value" || key == "data") { return editText; }
        return "";
    }
    public override bool SetExtra(string key, string val) {
        if (key == "text" || key == "value" || key == "data") {
            string next = val != null ? val : "";
            if (next != editText) { this.SetText(next); }
            return true;
        }
        if (key == "countGraphemes") {
            CountGraphemes = (val == "true"); return true;
        }
        return false;
    }
    public override List<string> Events() {
        List<string> e = Control.CommonEvents();
        e.Add("Change");
        return e;
    }
    public override void BindEvent(string evt, Action a) {
        if (evt == "Change") { Change.Add(a); return; }
        base.BindEvent(evt, a);
    }
    public override void BindEventS(string evt, ControlEvent a) {
        if (evt == "Change") { Change.AddS(a); return; }
        base.BindEventS(evt, a);
    }
    public int BottomRowH() { return this.BottomRowH(this.App); }
    public int BottomRowH(App app) {
        if (!ShowCount && errMsg == "") { return 0; }
        app = this.ResolveApp(app);
        if (app == null) { return 18; }
        StyleBox cs = this.ResolvePartAs(app, "textarea", "count", "",
                                         Class, Style.SNormal());
        int cfs = cs.FontOr(Style.FontFallback(app, "small"));
        return app.Scale(2) + Canvas.FontHeight(cfs) + app.Scale(2);
    }
    public override void OnMeasure(App app) {
        this.SyncBinding();
        Theme t = app.theme;
        StyleBox s = this.ResolveStyleAs(app, "textarea", Class, Style.SNormal());
        if (autoHeight) { prefH = this.ContentHeight(app); }
        else { prefH = s.HeightOr(app.Scale(90)); }
        prefH += this.BottomRowH(app);
        prefW = s.WidthOr(app.Scale(220));
    }
    public override void OnPaint(App app) {
        this.SyncBinding();
        this.PaintTextArea(app, bx, by, bw, bh - this.BottomRowH(app));
    }
}
