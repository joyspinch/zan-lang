using System;
using Gui;

namespace Gui.Widget;

// 居中容器原语（对齐 Flutter Center / Naive UI 居中容器）。
// 自动将其单一子节点在可用空间内水平且垂直居中，彻底消灭手算 (w - childW)/2 的繁琐逻辑。
public class Center : Flex {
    public Center() {
        InitFlex("row");
        this.Center();       // justify-center
        this.AlignCenter();  // align-center
        this.grow = true;
    }

    public Center(Control child) : this() {
        if (child != null) {
            this.With(child);
        }
    }

    public static Center Of(Control child) {
        return new Center(child);
    }

    public static Center Create() {
        return new Center();
    }

    public override string Kind() { return "Center"; }
}
