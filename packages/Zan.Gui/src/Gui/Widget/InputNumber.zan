using System;
using Gui;
using Gui.Backend;
namespace Gui.Widget;
public delegate string NumFormatter(string text);
public delegate string NumParser(string text);
public delegate bool NumValidator(int value);
[GuiKind("InputNumber")]
public class InputNumber : Control {
    public override Control CreateCloneShell() { return new InputNumber(); }
    public Binding<int> Value;
    public string hint;
    public int minV;
    public int maxV;
    public int stepV;
    public string editBuf;
    public bool hadFocus;
    public Button minusBtn;
    public Input inputNode;
    public Button plusBtn;
    public override int StyleDisplay() { return 1; } // CSS display: flex
    public override int StyleFlexDir() { return 0; } // flex-direction: row
    public UiEvent Change;
    public UiEvent Submit;
    public UiEvent Invalid;
    public Binding<string> Size;
    public Binding<string> Prefix;
    public Binding<string> Suffix;
    public Binding<string> Placement;
    private bool loading;
    private Spin minusSpin;
    private Spin plusSpin;
    private Binding<bool> editorDisabled;
    public bool Loading {
        get { return loading; }
        set {
            if (loading == value) { return; }
            loading = value;
            if (loading) {
                minusSpin.Visible = minusBtn.Visible;
                plusSpin.Visible = plusBtn.Visible;
                minusBtn.Visible = false;
                plusBtn.Visible = false;
                editorDisabled = inputNode.Disabled;
                inputNode.Disabled = true;
            } else {
                minusBtn.Visible = minusSpin.Visible;
                plusBtn.Visible = plusSpin.Visible;
                minusSpin.Visible = false;
                plusSpin.Visible = false;
                inputNode.Disabled = editorDisabled;
                editorDisabled = null;
            }
            App host = this.FindApp();
            if (host != null) { host.RequestRedraw(); }
        }
    }
    public int Precision;
    public bool GroupDigits;
    public NumFormatter Formatter;
    public NumParser Parser;
    public NumValidator Check;
    public bool invalidFlag;
    private void InitNumber(int lo, int hi) {
        this.InitControl("inputNumber");
        Value = lo;
        minV = lo;
        maxV = hi;
        stepV = 1;
        hint = "";
        editBuf = "";
        hadFocus = false;
        wiresOwnEvents = true;
        Change = new UiEvent();
        Submit = new UiEvent();
        Invalid = new UiEvent();
        Size = "medium";
        Prefix = "";
        Suffix = "";
        Placement = "both";
        Precision = 0;
        GroupDigits = false;
        Formatter = null;
        Parser = null;
        Check = null;
        invalidFlag = false;
        this.ClassName = "input-number row align-center";
        minusBtn = new Button("-");
        minusBtn.Class = "input-number-btn";
        inputNode = new Input();
        inputNode.Class = "input-number-input flex-1";
        plusBtn = new Button("+");
        plusBtn.Class = "input-number-btn";
        minusSpin = new Spin(WidgetSize.Medium);
        minusSpin.Class = "input-number-btn";
        minusSpin.Visible = false;
        plusSpin = new Spin(WidgetSize.Medium);
        plusSpin.Class = "input-number-btn";
        plusSpin.Visible = false;
        InputNumberAction action = new InputNumberAction(this);
        minusBtn.Click.Add(() => { action.StepDown(); });
        plusBtn.Click.Add(() => { action.StepUp(); });
        inputNode.Change.Add(() => { action.InputChange(); });
        inputNode.Submit.Add(() => { action.InputSubmit(); });
        this.Add(minusBtn);
        this.Add(minusSpin);
        this.Add(inputNode);
        this.Add(plusBtn);
        this.Add(plusSpin);
    }
    public InputNumber() { InitNumber(0, 100); }
    public InputNumber(int lo, int hi) { InitNumber(lo, hi); }
    public override void CloneContentTo(Control target, CloneTreeFn clone) {
    }
    public override string Kind() { return "InputNumber"; }
    public override string StyleType() { return "input"; }
    public override Binding<string> SizeOf() { return Size; }
    public void Hint(string text) { hint = text; }
    public void OnChange(Action a) { Change.Add(a); }
    public void OnSubmit(Action a) { Submit.Add(a); }
    public void OnInvalid(Action a) { Invalid.Add(a); }
    public void WithFormatter(NumFormatter f) { Formatter = f; }
    public void WithParser(NumParser p) { Parser = p; }
    public void WithValidator(NumValidator v) { Check = v; }
    public int Step() {
        if (stepV < 1) { return 1; }
        return stepV;
    }
    public int Decimals() {
        if (Precision < 0) { return 0; }
        if (Precision > 6) { return 6; }
        return Precision;
    }
    public static int Pow10(int n) {
        if (n < 0) { n = 0; }
        if (n > 6) { n = 6; }
        int acc = 1;
        for (int i = 0; i < n; i = i + 1) { acc = acc * 10; }
        return acc;
    }
    public static string NumberText(int scaled, int decimals) {
        int scale = InputNumber.Pow10(decimals);
        string sign = "";
        long v = scaled;
        if (v < 0) { sign = "-"; v = 0 - v; }
        string ip = Convert.ToString((int)(v / scale));
        if (decimals == 0) { return sign + ip; }
        string fp = Convert.ToString((int)(v % scale));
        while (fp.Length < decimals) { fp = "0" + fp; }
        return sign + ip + "." + fp;
    }
    public static string GroupThousands(string s) {
        if (s == "") { return s; }
        if (s.IndexOf(",") >= 0) { return s; }
        int dot = s.IndexOf(".");
        string head = s;
        string tail = "";
        if (dot >= 0) {
            head = s.Substring(0, dot);
            tail = s.Substring(dot, s.Length - dot);
        }
        string sign = "";
        if (head.StartsWith("-")) {
            sign = "-";
            head = head.Substring(1, head.Length - 1);
        }
        StringBuilder outp = new StringBuilder();
        int rem = head.Length % 3;
        if (rem == 0) { rem = 3; }
        int start = 0;
        if (rem < head.Length) {
            outp.Append(head.Substring(0, rem));
            start = rem;
            while (start < head.Length) {
                outp.Append(",");
                outp.Append(head.Substring(start, 3));
                start = start + 3;
            }
        } else {
            outp.Append(head);
        }
        return sign + outp.ToString() + tail;
    }
    public string PlainText(int scaled) { return InputNumber.NumberText(scaled, this.Decimals()); }
    public string DisplayText() {
        string s = this.PlainText(Value.Get());
        if (GroupDigits) { s = InputNumber.GroupThousands(s); }
        if (Formatter != null) { s = Formatter(s); }
        return s;
    }
    public static int ParseScaled(string text, int decimals, int def, NumParser parser) {
        if (parser != null) { text = parser(text); }
        if (text == null) { return def; }
        string s = text.Replace(",", "");
        if (s == "" || s == "-" || s == "." || s == "-.") { return def; }
        bool neg = false;
        int i0 = 0;
        if (s.StartsWith("-")) { neg = true; i0 = 1; }
        int dot = s.IndexOf(".");
        string ip = s.Substring(i0, s.Length - i0);
        string fp = "";
        if (dot >= 0) {
            ip = s.Substring(i0, dot - i0);
            fp = s.Substring(dot + 1, s.Length - dot - 1);
        }
        if (ip == "") { ip = "0"; }
        long ipart = 0;
        for (int i = 0; i < ip.Length; i = i + 1) {
            int c = ip[i] & 255;
            if (c < 48 || c > 57) { return def; }
            ipart = ipart * 10 + (c - 48);
            if (ipart > 214748364) { ipart = 214748364; }
        }
        int scale = InputNumber.Pow10(decimals);
        long fpart = 0;
        for (int i = 0; i < fp.Length; i = i + 1) {
            int c = fp[i] & 255;
            if (c < 48 || c > 57) {
                if (c == 46 && i == fp.Length - 1) { break; }
                return def;
            }
            fpart = fpart * 10 + (c - 48);
        }
        int extra = fp.Length - decimals;
        if (extra > 0) {
            long div = InputNumber.Pow10(extra);
            long r = (fpart + div / 2) / div;
            if (r >= scale) { r = r - scale; ipart = ipart + 1; }
            fpart = r;
        } else if (extra < 0) {
            fpart = fpart * InputNumber.Pow10(0 - extra);
        }
        long total = ipart * scale + fpart;
        if (neg) { total = 0 - total; }
        if (total > 2147483647) { total = 2147483647; }
        if (total < 0 - 2147483647) { total = 0 - 2147483647; }
        return Convert.ToInt32(total);
    }
    public int StepUpVal(int v) {
        long next = v;
        next = next + this.Step();
        if (next > int.MaxValue) { return int.MaxValue; }
        return Convert.ToInt32(next);
    }
    public int StepDownVal(int v) {
        long next = v;
        next = next - this.Step();
        if (next < int.MinValue) { return int.MinValue; }
        return Convert.ToInt32(next);
    }
    public int Clamp(int v) {
        if (v < minV) { v = minV; }
        if (v > maxV) { v = maxV; }
        return v;
    }
    private void RunValidator(int v) {
        bool ok = true;
        if (Check != null) { ok = Check(v); }
        invalidFlag = !ok;
        if (!ok) { Invalid.RaiseS(this); }
    }
    public string EditDisplay() {
        string s = editBuf;
        if (GroupDigits) { s = InputNumber.GroupThousands(s); }
        if (Formatter != null) { s = Formatter(s); }
        return s;
    }
    public void SetRaw(int v) {
        v = this.Clamp(v);
        if (Value.Get() == v) { return; }
        Value.Set(v);
        this.RunValidator(v);
        Change.RaiseS(this);
    }
    public void SetValue(int v) {
        this.CommitBuffer();
        this.SetRaw(v);
    }
    public static int ParseInt(string s, int def) {
        if (s == null) { return def; }
        int i = 0;
        bool neg = false;
        if (s.StartsWith("-")) {
            neg = true;
            i = 1;
            if (i >= s.Length) { return def; }
        }
        long acc = 0;
        while (i < s.Length) {
            int c = s[i] & 255;
            if (c < 48 || c > 57) { return def; }
            acc = acc * 10 + (c - 48);
            if (acc > 2147483647) { acc = 2147483647; }
            i = i + 1;
        }
        if (neg) { acc = -acc; }
        return Convert.ToInt32(acc);
    }
    public void CommitBuffer() {
        if (editBuf == "") { return; }
        int v = ParseScaled(editBuf, this.Decimals(), Value.Get(), Parser);
        editBuf = "";
        this.SetRaw(v);
    }
    public void StepDown() {
        if (this.IsDisabled() || Loading) { return; }
        this.SetRaw(this.StepDownVal(Value.Get()));
    }
    public void StepUp() {
        if (this.IsDisabled() || Loading) { return; }
        this.SetRaw(this.StepUpVal(Value.Get()));
    }
    public void OnInputChange() {
        if (Loading || inputNode == null) { return; }
        string t = inputNode.GetText();
        if (t != "") { this.SetRaw(Convert.ToInt32(t)); }
    }
    public void OnInputSubmit() {
        if (Loading) { return; }
        OnInputChange();
        if (Submit != null) { Submit.RaiseS(this); }
    }
    protected override List<PropSpec> DefineProps() {
        List<PropSpec> ps = new List<PropSpec>();
        ps.Add(PropSpec.Int("value", "Value").DefaultBinding().Field("Value", 1).Also("text"));
        PropSpec sz = PropSpec.Enum("size", "Size",
            PropSpec.Sizes());
        sz.Field("Size", 0);
        ps.Add(sz);
        ps.Add(PropSpec.Text("prefix", "Prefix").Field("Prefix", 0));
        ps.Add(PropSpec.Text("suffix", "Suffix").Field("Suffix", 0));
        PropSpec plc = PropSpec.Enum("placement", "Button Placement",
            new List<string>{ "both", "right" });
        plc.Field("Placement", 0);
        ps.Add(plc);
        ps.Add(PropSpec.Int("min", "Min").Field("minV", 1));
        ps.Add(PropSpec.Int("max", "Max").Field("maxV", 1));
        PropSpec stp = PropSpec.Int("step", "Step");
        stp.Field("stepV", 1);
        stp.StepBy(1);
        stp.WithTip("Increment of the +/- buttons, in display units "
                    + "(scaled by precision).");
        ps.Add(stp);
        ps.Add(PropSpec.Text("hint", "Placeholder").Field("hint", 0).Also("placeholder"));
        ps.Add(PropSpec.Int("precision", "Precision").Field("Precision", 1).Step(1, 0, 6).WithTip("Decimal places (fixed-point model: value * 10^precision)."));
        ps.Add(PropSpec.Bool("group", "Group digits").Field("GroupDigits", 2).Also("groupDigits").WithTip("Show thousands separators while displaying."));
        return ps;
    }
    public override string GetProp(string key) {
        if (key == "value" || key == "text") { return this.DisplayText(); }
        if (key == "precision") { return Convert.ToString(this.Decimals()); }
        return base.GetProp(key);
    }
    public override void SetProp(string key, string val) {
        if (key == "value" || key == "text") {
            this.SetRaw(ParseScaled(val, this.Decimals(), Value.Get(), Parser));
            return;
        }
        base.SetProp(key, val);
    }
    public override string GetExtra(string key) {
        if (key == "loading") { return Loading ? "true" : "false"; }
        return "";
    }
    public override bool SetExtra(string key, string val) {
        if (key == "loading") {
            Loading = (val == "true");
            return true;
        }
        return false;
    }
    public override List<string> Events() {
        List<string> e = Control.CommonEvents();
        e.Add("Change");
        e.Add("Submit");
        e.Add("Invalid");
        return e;
    }
    public override void BindEvent(string evt, Action a) {
        if (evt == "Change") { Change.Add(a); return; }
        if (evt == "Submit") { Submit.Add(a); return; }
        if (evt == "Invalid") { Invalid.Add(a); return; }
        base.BindEvent(evt, a);
    }
    public override void BindEventS(string evt, ControlEvent a) {
        if (evt == "Change") { Change.AddS(a); return; }
        if (evt == "Submit") { Submit.AddS(a); return; }
        if (evt == "Invalid") { Invalid.AddS(a); return; }
        base.BindEventS(evt, a);
    }
    public override void SyncBinding() {
        base.SyncBinding();
        int current = Value.Get();
        int clamped = this.Clamp(current);
        if (current != clamped) { Value.Set(clamped); }
        if (inputNode != null) {
            string expected = this.DisplayText();
            if (inputNode.GetText() != expected) { inputNode.SetText(expected); }
        }
    }
}
