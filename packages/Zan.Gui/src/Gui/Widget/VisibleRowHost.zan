using System;
using Gui;

namespace Gui.Widget;

// Data indices belong to the model, never to a viewport slot. The helper owns
// only generated roots; weak host links keep row callbacks from retaining it.
public class VisibleRowHost {
    private weak Control owner;
    private weak Control body;
    private Dictionary<int, Control> rows;
    private List<int> indices;
    private int revision;
    private bool reconciling;
    private List<Control> retired;
    private bool retiring;

    public VisibleRowHost(Control owner, Control body) {
        this.owner = owner;
        this.body = body;
        rows = new Dictionary<int, Control>();
        indices = new List<int>();
        retired = new List<Control>();
    }

    public int Revision() { return revision; }
    public void Invalidate() { revision = revision + 1; }
    public int Count() { return indices.Count; }

    public Control Row(int index) {
        if (body == null || !rows.ContainsKey(index)) { return null; }
        Control row = rows[index];
        if (row == null || row.parent != body || body.IndexOf(row) < 0) { return null; }
        return row;
    }

    private bool Current(int ticket, App app, Control parent, Control root, int rootGeneration) {
        return owner != null && body != null && revision == ticket
            && owner.parent == parent && owner.FindApp() == app
            && owner.ContainsHostedControl(body) && body.FindApp() == app
            && (app == null || (app.rootControl == root && app.inputRootGeneration == rootGeneration));
    }

    // Clear the lookup before cancellation: a reentrant refresh must never
    // rediscover a row being retired. Remove preserves the old input ancestry.
    public void Reset() {
        revision = revision + 1;
        List<int> previous = indices;
        Dictionary<int, Control> old = rows;
        rows = new Dictionary<int, Control>();
        indices = new List<int>();
        for (int i = 0; i < previous.Count; i = i + 1) {
            Control row = old.ContainsKey(previous[i]) ? old[previous[i]] : null;
            if (row != null && !retired.Contains(row)) { retired.Add(row); }
        }
        this.DrainRetired();
    }

    // Cancellation may throw before structural removal. Keep the retirement
    // debt private and retry it before any subsequent construction.
    private void DrainRetired() {
        if (retiring) { return; }
        retiring = true;
        try {
            while (retired.Count > 0) {
                Control row = retired[0];
                Control container = body;
                if (container != null && row.parent == container) { container.Remove(row); }
                retired.RemoveAt(0);
            }
        } finally { retiring = false; }
    }

    // Retire departures before constructing arrivals, retaining the visible
    // intersection. Every user callback is followed by a topology/version fence.
    public bool Reconcile(List<int> wanted, RowAt build, App measureApp) {
        if (reconciling || retiring || owner == null || body == null) { return false; }
        reconciling = true;
        App app = owner.FindApp();
        Control parent = owner.parent;
        Control root = app != null ? app.rootControl : null;
        int rootGeneration = app != null ? app.inputRootGeneration : 0;
        List<int> requested = new List<int>();
        requested.AddRange(wanted);
        wanted = requested;
        int ticket = revision;
        if (!this.Current(ticket, app, parent, root, rootGeneration)) { reconciling = false; return false; }
        try {
            this.DrainRetired();
            if (!this.Current(ticket, app, parent, root, rootGeneration)) { return false; }
            List<int> previous = indices;
            for (int i = 0; i < previous.Count; i = i + 1) {
                int index = previous[i];
                if (wanted.Contains(index)) { continue; }
                Control row = rows.ContainsKey(index) ? rows[index] : null;
                rows.Remove(index);
                if (row != null && !retired.Contains(row)) { retired.Add(row); }
                this.DrainRetired();
                if (!this.Current(ticket, app, parent, root, rootGeneration)) { return false; }
            }
            indices = wanted;
            for (int i = 0; i < wanted.Count; i = i + 1) {
                int index = wanted[i];
                if (rows.ContainsKey(index)) {
                    Control existing = rows[index];
                    if (existing == null || this.Row(index) != null) { continue; }
                    rows.Remove(index);
                }
                Control row = null;
                WidgetId.Push(index);
                try { row = build(index); }
                finally { WidgetId.Pop(); }
                if (!this.Current(ticket, app, parent, root, rootGeneration)) { return false; }
                // An already mounted root cannot represent another model row.
                if (row != null && body.IndexOf(row) < 0 && body.Adoptable(row)) {
                    body.Add(row);
                    if (!this.Current(ticket, app, parent, root, rootGeneration)) {
                        if (owner != null && owner.FindApp() == app && owner.parent == parent
                            && row.parent == body) {
                            if (!retired.Contains(row)) { retired.Add(row); }
                            this.DrainRetired();
                        }
                        return false;
                    }
                    if (row.parent != body) { row = null; }
                } else { row = null; }
                rows[index] = row;
                if (row != null) { row.MeasureTree(measureApp); }
                if (!this.Current(ticket, app, parent, root, rootGeneration)) { return false; }
            }
            // Reordering retained roots must not detach them (which would
            // cancel focus/capture). These containers contain generated rows only.
            List<Control> ordered = new List<Control>();
            for (int i = 0; i < wanted.Count; i = i + 1) {
                Control row = this.Row(wanted[i]);
                if (row != null && !ordered.Contains(row)) { ordered.Add(row); }
            }
            for (int i = 0; i < body.ChildCount(); i = i + 1) {
                Control child = body.ChildAt(i);
                if (!ordered.Contains(child)) { ordered.Add(child); }
            }
            body.ReorderChildren(ordered);
            return true;
        } finally { reconciling = false; }
    }
}
