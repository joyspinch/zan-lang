using System;
using Gui;
namespace Gui.Widget;
public class VisibleRowHost {
    private weak Control owner;
    private weak Control body;
    private Dictionary<int, Control> rows;
    private List<int> indices;
    private int revision;
    private bool reconciling;
    private List<Control> retired;
    private bool retiring;
    public VisibleRowHost(Control owner, Control body) {
        this.owner = owner;
        this.body = body;
        rows = new Dictionary<int, Control>();
        indices = new List<int>();
        retired = new List<Control>();
    }
    public int Revision() { return revision; }
    public void Invalidate() { revision = revision + 1; }
    public int Count() { return indices.Count; }

    // 统一虚拟列表/树的滚动视口同步、偏移裁剪与滚动条留白宽度计算。
    public static int ClampScrollViewport(Control owner, Control rowsBody,
                                          int contentHeight, Rect view,
                                          int scrollbarPx, out int contentWidth) {
        if (rowsBody == null) {
            contentWidth = 0;
            return 0;
        }
        rowsBody.scrollExtent = contentHeight;
        rowsBody.scrollExtentX = view.width;
        if (owner != null) {
            owner.scrollExtent = contentHeight;
            owner.scrollExtentX = view.width;
        }
        int max = contentHeight - view.height;
        if (max < 0) { max = 0; }
        int off = rowsBody.ScrollTop();
        if (off > max) { off = max; }
        if (off < 0) { off = 0; }
        if (off != rowsBody.ScrollTop()) { rowsBody.CommitScrollOffset(0, off); }
        int w = view.width;
        if (contentHeight > view.height) { w = w - scrollbarPx; }
        if (w < 0) { w = 0; }
        contentWidth = w;
        return off;
    }

    // 等高虚拟化可见索引窗口 [first, last)。
    public static void ComputeVisibleWindow(int offset, int viewHeight, int rowHeight,
                                            int count, out int first, out int last) {
        if (count <= 0 || rowHeight <= 0) {
            first = 0;
            last = 0;
            return;
        }
        int off = offset < 0 ? 0 : offset;
        int f = off / rowHeight;
        if (f < 0) { f = 0; }
        if (f > count) { f = count; }
        int l = f + (viewHeight > 0 ? viewHeight / rowHeight : 0) + 2;
        if (l > count) { l = count; }
        first = f;
        last = l;
    }
    public Control Row(int index) {
        Control container = body;
        if (container == null || !rows.ContainsKey(index)) { return null; }
        Control row = rows[index];
        if (row == null || row.parent != container || container.IndexOf(row) < 0) { return null; }
        return row;
    }
    private bool Current(int ticket, App app, Control parent, Control root, int rootGeneration) {
        Control host = owner;
        Control container = body;
        return host != null && container != null && revision == ticket
            && host.parent == parent && host.FindApp() == app
            && host.ContainsHostedControl(container) && container.FindApp() == app
            && (app == null || (app.rootControl == root && app.inputRootGeneration == rootGeneration));
    }
    public void Reset() {
        revision = revision + 1;
        List<int> previous = indices;
        Dictionary<int, Control> old = rows;
        rows = new Dictionary<int, Control>();
        indices = new List<int>();
        for (int i = 0; i < previous.Count; i = i + 1) {
            Control row = old.ContainsKey(previous[i]) ? old[previous[i]] : null;
            if (row != null && !retired.Contains(row)) { retired.Add(row); }
        }
        this.DrainRetired();
    }
    private void DrainRetired() {
        if (retiring) { return; }
        retiring = true;
        try {
            while (retired.Count > 0) {
                Control row = retired[0];
                Control container = body;
                if (row != null && container != null && row.parent == container) { container.Remove(row); }
                retired.RemoveAt(0);
            }
        } finally { retiring = false; }
    }
    public bool Reconcile(List<int> wanted, RowAt build, App measureApp) {
        Control host = owner;
        Control container = body;
        if (reconciling || retiring || host == null || container == null || wanted == null || build == null) { return false; }
        reconciling = true;
        App app = host.FindApp();
        Control parent = host.parent;
        Control root = app != null ? app.rootControl : null;
        int rootGeneration = app != null ? app.inputRootGeneration : 0;
        List<int> requested = new List<int>();
        requested.AddRange(wanted);
        wanted = requested;
        int ticket = revision;
        if (!this.Current(ticket, app, parent, root, rootGeneration)) { reconciling = false; return false; }
        try {
            this.DrainRetired();
            if (!this.Current(ticket, app, parent, root, rootGeneration)) { return false; }
            List<int> previous = indices;
            for (int i = 0; i < previous.Count; i = i + 1) {
                int index = previous[i];
                if (wanted.Contains(index)) { continue; }
                Control row = rows.ContainsKey(index) ? rows[index] : null;
                rows.Remove(index);
                if (row != null && !retired.Contains(row)) { retired.Add(row); }
                this.DrainRetired();
                if (!this.Current(ticket, app, parent, root, rootGeneration)) { return false; }
            }
            indices = wanted;
            for (int i = 0; i < wanted.Count; i = i + 1) {
                int index = wanted[i];
                if (rows.ContainsKey(index)) {
                    Control existing = rows[index];
                    if (existing == null || this.Row(index) != null) { continue; }
                    rows.Remove(index);
                }
                Control row = null;
                WidgetId.Push(index);
                try { row = build(index); }
                finally { WidgetId.Pop(); }
                if (!this.Current(ticket, app, parent, root, rootGeneration)) { return false; }
                container = body;
                host = owner;
                if (row != null && container != null && container.IndexOf(row) < 0 && container.Adoptable(row)) {
                    container.Add(row);
                    if (!this.Current(ticket, app, parent, root, rootGeneration)) {
                        host = owner;
                        container = body;
                        if (host != null && container != null && host.FindApp() == app && host.parent == parent
                            && row.parent == container) {
                            if (!retired.Contains(row)) { retired.Add(row); }
                            this.DrainRetired();
                        }
                        return false;
                    }
                    if (row.parent != container) { row = null; }
                } else { row = null; }
                rows[index] = row;
                if (row != null) {
                    container = body;
                    host = owner;
                    int mw = container != null && container.bw > 0 ? container.bw : (host != null ? host.bw : 0);
                    if (mw > 0) { row.MeasureTree(measureApp, mw); }
                    else { row.MeasureTree(measureApp); }
                }
                if (!this.Current(ticket, app, parent, root, rootGeneration)) { return false; }
            }
            container = body;
            if (container == null) { return false; }
            List<Control> ordered = new List<Control>();
            for (int i = 0; i < wanted.Count; i = i + 1) {
                Control row = this.Row(wanted[i]);
                if (row != null && !ordered.Contains(row)) { ordered.Add(row); }
            }
            for (int i = 0; i < container.ChildCount(); i = i + 1) {
                Control child = container.ChildAt(i);
                if (!ordered.Contains(child)) { ordered.Add(child); }
            }
            container.ReorderChildren(ordered);
            return true;
        } finally { reconciling = false; }
    }
}
