using System;
using System.Collections.Generic;
using Gui;
namespace Gui.Widget;
public class PopupControl : Control {
    public Binding<bool> Opened;
    private bool appliedOpen;
    private weak App popupApp;
    private Control activePopup;
    public int triggerId;
    public int placement; // 0 = Bottom (default), 1 = Top, 2 = Auto
    public int popupWidth;
    public int popupHeight;
    public Control popupPanel;
    public Control customTrigger;
    [Event(Alias = "Open")]
    public UiEvent OpenEvent;
    [Event(Alias = "Close")]
    public UiEvent CloseEvent;
    public override int PointerCursor() { return 0; }
    protected void InitPopup(string kind, int w, int h) {
        this.InitControl(kind != "" ? kind : "popup");
        this.Opened = false;
        this.appliedOpen = false;
        this.popupApp = null;
        this.activePopup = null;
        this.triggerId = this.WidgetId();
        this.placement = 2; // Auto 边缘自适应翻转
        this.popupWidth = w > 0 ? w : 260;
        this.popupHeight = h > 0 ? h : 0;
        this.popupPanel = null;
        this.customTrigger = null;
        this.OpenEvent = new UiEvent();
        this.CloseEvent = new UiEvent();
        this.wiresOwnEvents = true;
    }
    public PopupControl() { this.InitPopup("popup", 260, 0); }
    public PopupControl(string kind, int w, int h) { this.InitPopup(kind, w, h); }
    public bool IsOpened {
        get { return this.IsOpen(); }
        set { this.SetOpen(value); }
    }
    public int PopupWidth {
        get { return this.popupWidth; }
        set { this.popupWidth = value; }
    }
    public int PopupHeight {
        get { return this.popupHeight; }
        set { this.popupHeight = value; }
    }
    public int Placement {
        get { return this.placement; }
        set { this.placement = value; }
    }
    public Control PopupContent {
        get { return this.popupPanel; }
        set { this.SetPopupContent(value); }
    }
    public Control TriggerContent {
        get { return this.customTrigger; }
        set {
            this.customTrigger = value;
            if (value != null && !(this.IndexOf(value) >= 0)) { this.Add(value); }
        }
    }
    public override bool ChildControlsRenderedByOwner() { return true; }
    public override void OnPaint(App app) {
        this.SyncBinding();
        if (this.customTrigger != null) {
            this.customTrigger.Arrange(bx, by, bw, bh);
            this.customTrigger.RenderTree(app);
            return;
        }
        for (int i = 0; i < this.ChildCount(); i = i + 1) {
            Control child = this.ChildAt(i);
            if (child == null || child == this.popupPanel) { continue; }
            child.RenderTree(app);
        }
    }
    public virtual bool IsOpen() { return this.Opened != null ? this.Opened.Get() : false; }
    public virtual void ToggleOpen() { this.SetOpen(!this.IsOpen()); }
    public virtual void DismissPopup() { this.SetOpen(false); }
    public virtual void SetPopupContent(Control content) {
        if (this.popupPanel == content) { return; }
        if (this.popupPanel != null && this.popupPanel.parent == this) {
            this.Remove(this.popupPanel);
        }
        this.popupPanel = content;
        if (content != null && !(this.IndexOf(content) >= 0)) { this.Add(content); }
    }
    public virtual Control GetPopupContent() { return this.popupPanel; }
    public virtual Control BuildDefaultPopup() { return this.BuildDefaultPopup(this.App); }
    public virtual Control BuildDefaultPopup(App app) { return null; }
    public virtual void EnsurePopup() { this.EnsurePopup(this.App); }
    public virtual void EnsurePopup(App app) {
        app = this.ResolveApp(app);
        if (this.popupPanel == null) {
            Control def = this.BuildDefaultPopup(app);
            if (def != null) { this.SetPopupContent(def); }
        }
        if (this.popupPanel != null) {
            if (this.popupWidth > 0) {
                this.popupPanel.prefW = app != null ? app.Scale(this.popupWidth) : this.popupWidth;
            }
            if (this.popupHeight > 0) {
                this.popupPanel.prefH = app != null ? app.Scale(this.popupHeight) : this.popupHeight;
            }
            if (app != null) { this.popupPanel.OnMeasure(app); }
        }
    }
    public virtual void SetOpen(bool want) {
        if (want && this.IsDisabled()) { return; }
        if (this.Opened.Get() != want) { this.Opened.Set(want); }
        this.ApplyOpen(want, true);
    }
    public override void SyncBinding() {
        base.SyncBinding();
        this.ApplyOpen(this.Opened.Get(), false);
    }
    private void ApplyOpen(bool want, bool notify) {
        if (want) {
            if (this.IsDisabled() || this.appliedOpen) { return; }
            App a = this.FindApp();
            if (a == null) { a = App.FrameApp(); }
            if (a == null || a.overlayHost == null) { return; }
            this.EnsurePopup(a);
            if (this.popupPanel == null) { return; }
            this.popupApp = a;
            this.activePopup = this.popupPanel;
            this.appliedOpen = true;
            this.popupPanel.UseApp(a);
            OverlayHost.ShowPopup(a, this, this.popupPanel);
            if (this.appliedOpen && notify && this.OpenEvent != null) { this.OpenEvent.Raise(this); }
            if (a.window != null) { a.window.Wake(); }
        } else {
            if (!this.appliedOpen) { return; }
            App hostApp = this.popupApp;
            Control shown = this.activePopup != null ? this.activePopup : this.popupPanel;
            this.appliedOpen = false;
            this.popupApp = null;
            this.activePopup = null;
            if (hostApp == null) {
                hostApp = this.FindApp();
                if (hostApp == null) { hostApp = App.FrameApp(); }
            }
            if (hostApp != null && hostApp.overlayHost != null && shown != null) {
                hostApp.overlayHost.Hide(shown);
            }
            if (notify && this.CloseEvent != null) { this.CloseEvent.Raise(this); }
            if (hostApp != null && hostApp.window != null) { hostApp.window.Wake(); }
        }
    }
    public override void OnPopupDismissed() {
        if (this.appliedOpen || (this.Opened != null && this.Opened.Get())) {
            this.appliedOpen = false;
            this.popupApp = null;
            this.activePopup = null;
            if (this.Opened != null && this.Opened.Get()) { this.Opened.Set(false); }
            if (this.CloseEvent != null) { this.CloseEvent.Raise(this); }
            App a = this.FindApp();
            if (a != null && a.window != null) { a.window.Wake(); }
        }
    }
    public override bool MountSlot(string slot, Control c) {
        if (slot == "popup" || slot == "dropdown" || slot == "content" || slot == "body") {
            this.SetPopupContent(c);
            return true;
        }
        if (slot == "trigger" || slot == "extra") {
            this.customTrigger = c;
            this.Add(c);
            return true;
        }
        return base.MountSlot(slot, c);
    }
    protected override List<PropSpec> DefineProps() {
        List<PropSpec> ps = new List<PropSpec>();
        ps.Add(PropSpec.Bool("open", "Open").DefaultBinding().Field("Opened").Setter("SetOpen").Also("data").Also("value"));
        ps.Add(PropSpec.Int("popupWidth", "Popup Width").Field("popupWidth"));
        ps.Add(PropSpec.Int("popupHeight", "Popup Height").Field("popupHeight"));
        ps.Add(this.SizeProp());
        return ps;
    }
}
