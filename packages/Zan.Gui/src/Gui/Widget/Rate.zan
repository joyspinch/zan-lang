using System;
using System.Collections.Generic;
using Gui;

namespace Gui.Widget;

// 星级评分（Rate）：标准声明式 Flex 容器对象树。
// 由 maxStars 个星形子控件构成，完全依托 CSS Flex 流式排布与主题样式规则。
public class Rate : Control {
    public Binding<int> Value;
    public int maxStars;
    [Event]
    public UiEvent Change;
    [Event]
    public UiEvent HoverChange;
    public bool allowHalf;
    public bool readOnly;
    public bool clearable;
    public Binding<string> Size;
    public Binding<string> Icon;
    public Binding<string> VoidIcon;
    private int lastHover;
    private List<IconView> starNodes;

    public override int StyleDisplay() { return 1; } // Flex
    public override int StyleFlexDir() { return 0; } // Row

    private void InitRate(int stars) {
        this.InitControl("rate", 1);
        this.ClassName = "rate row align-center";
        Value = 0;
        maxStars = stars > 0 ? stars : 5;
        wiresOwnEvents = true;
        Change = new UiEvent();
        HoverChange = new UiEvent();
        allowHalf = false;
        readOnly = false;
        clearable = false;
        Size = "medium";
        Icon = "star";
        VoidIcon = "star-empty";
        lastHover = 0;
        starNodes = new List<IconView>();
        this.BuildStars();
    }

    public Rate() : this(5) { }

    public Rate(int stars) {
        InitRate(stars);
    }

    public void BuildStars() {
        this.RemoveAll();
        starNodes.Clear();
        string ic = Icon != null && Icon.Get() != "" ? Icon.Get() : "star";
        string vic = VoidIcon != null && VoidIcon.Get() != "" ? VoidIcon.Get() : "star-empty";
        int cur = Value.Get();
        for (int i = 0; i < maxStars; i = i + 1) {
            bool on = i < cur;
            IconView star = new IconView(on ? ic : vic, 20);
            star.ClassName = on ? "rate-star on" : "rate-star off";
            RateAction action = new RateAction(this, i);
            star.Click.Add(action.Click);
            this.Add(star);
            starNodes.Add(star);
        }
    }

    public Rate Max(int stars) {
        if (stars != maxStars && stars > 0) {
            maxStars = stars;
            this.BuildStars();
        }
        return this;
    }

    public int MaxStars() { return maxStars; }
    public override void CloneContentTo(Control target, CloneTreeFn clone) {
        // Constructor and property replay recreate the generated parts.
    }

    public override Binding<string> SizeOf() { return Size; }

    protected override List<PropSpec> DefineProps() {
        List<PropSpec> ps = new List<PropSpec>();
        ps.Add(PropSpec.Int("max", "Maximum stars").Field("maxStars").Step(1, 1, 10));
        ps.Add(PropSpec.Int("value", "Rating").DefaultBinding().Field("Value").Also("data").Step(1, 0, 10));
        ps.Add(PropSpec.Bool("allowHalf", "Allow half").Field("allowHalf"));
        ps.Add(PropSpec.Bool("readonly", "Readonly").Field("readOnly"));
        ps.Add(PropSpec.Bool("clearable", "Clearable").Field("clearable"));
        ps.Add(PropSpec.Enum("size", "Size", PropSpec.Sizes3()).Field("Size"));
        ps.Add(PropSpec.TextField("Icon"));
        ps.Add(PropSpec.TextField("VoidIcon"));
        return ps;
    }

    public void SetStars(int v) {
        if (v < 0) { v = 0; }
        if (v > maxStars) { v = maxStars; }
        Value.Set(v);
        this.SyncBinding();
    }

    public int HoverValue() { return lastHover; }

    public override void SyncBinding() {
        base.SyncBinding();
        int fillTo = Value.Get();
        string ic = Icon != null && Icon.Get() != "" ? Icon.Get() : "star";
        string vic = VoidIcon != null && VoidIcon.Get() != "" ? VoidIcon.Get() : "star-empty";
        for (int i = 0; i < starNodes.Count; i = i + 1) {
            IconView s = starNodes[i];
            bool on = i < fillTo;
            s.Icon = on ? ic : vic;
            if (on) {
                s.AddClass("on");
                s.RemoveClass("off");
            } else {
                s.AddClass("off");
                s.RemoveClass("on");
            }
        }
    }

    public void OnStarClick(int idx) {
        if (readOnly) { return; }
        int newVal = idx + 1;
        if (clearable && Value.Get() == newVal) { newVal = 0; }
        if (newVal != Value.Get()) {
            Value.Set(newVal);
            Change.Raise(this);
            this.SyncBinding();
        }
    }

}
