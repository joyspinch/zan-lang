using System;
using System.Collections.Generic;
using Gui;
namespace Gui.Widget;
public class Rate : Control {
    public override Control CreateCloneShell() { return new Rate(); }
    public Binding<int> Value;
    public int maxStars;
    [Event]
    public UiEvent Change;
    [Event]
    public UiEvent HoverChange;
    public bool allowHalf;
    public bool readOnly;
    public bool clearable;
    public Binding<string> Size;
    public Binding<string> Icon;
    public Binding<string> VoidIcon;
    private int lastHover;
    private List<IconView> starNodes;
    public override int StyleDisplay() { return 1; } // Flex
    public override int StyleFlexDir() { return 0; } // Row
    private void InitRate(int stars) {
        this.InitControl("rate");
        this.ClassName = "rate row align-center";
        Value = 0;
        maxStars = stars > 0 ? stars : 5;
        wiresOwnEvents = true;
        Change = new UiEvent();
        HoverChange = new UiEvent();
        allowHalf = false;
        readOnly = false;
        clearable = false;
        Size = "medium";
        Icon = "star";
        VoidIcon = "star-empty";
        lastHover = 0;
        starNodes = new List<IconView>();
        this.BuildStars();
    }
    public Rate() : this(5) { }
    public Rate(int stars) { InitRate(stars); }
    public int MaximumStars {
        get { return maxStars; }
        set { this.Max(value); }
    }
    public bool AllowHalf {
        get { return allowHalf; }
        set { allowHalf = value; this.Invalidate(); }
    }
    public bool IsReadOnly {
        get { return readOnly; }
        set { readOnly = value; this.BuildStars(); this.Invalidate(); }
    }
    public bool IsClearable {
        get { return clearable; }
        set { clearable = value; this.Invalidate(); }
    }
    public override void SetProp(string key, string val) {
        base.SetProp(key, val);
        this.SyncBinding();
    }
    public override void OnMeasure(App app) {
        this.SyncBinding();
        base.OnMeasure(app);
    }
    private int StarBoxPx() {
        string sc = this.SizeCls();
        if (sc == "tiny") { return 14; }
        if (sc == "small") { return 16; }
        if (sc == "large") { return 26; }
        return 20;
    }
    public void BuildStars() {
        this.RemoveAll();
        starNodes.Clear();
        this.ApplySizeClass();
        int px = this.StarBoxPx();
        string ic = Icon != null && Icon.Get() != "" ? Icon.Get() : "star";
        string vic = VoidIcon != null && VoidIcon.Get() != "" ? VoidIcon.Get() : "star-empty";
        int cur = Value.Get();
        bool locked = readOnly || this.IsDisabled();
        for (int i = 0; i < maxStars; i = i + 1) {
            bool on = i < cur;
            IconView star = new IconView(on ? ic : vic, px);
            star.ClassName = on ? "rate-star on" : "rate-star off";
            star.Disabled = locked;
            RateAction action = new RateAction(this, i);
            star.Click.Add(action.Click);
            this.Add(star);
            starNodes.Add(star);
        }
    }
    public void Max(int stars) {
        if (stars != maxStars && stars > 0) {
            maxStars = stars;
            this.BuildStars();
        }
    }
    public int MaxStars() { return maxStars; }
    public override void CloneContentTo(Control target, CloneTreeFn clone) {
    }
    public override Binding<string> SizeOf() { return Size; }
    protected override List<PropSpec> DefineProps() {
        List<PropSpec> ps = new List<PropSpec>();
        ps.Add(PropSpec.Int("max", "Maximum stars").Field("maxStars").Step(1, 1, 10));
        ps.Add(PropSpec.Int("value", "Rating").DefaultBinding().Field("Value").Also("data").Step(1, 0, 10));
        ps.Add(PropSpec.Bool("allowHalf", "Allow half").Field("allowHalf"));
        ps.Add(PropSpec.Bool("readonly", "Readonly").Field("readOnly"));
        ps.Add(PropSpec.Bool("clearable", "Clearable").Field("clearable"));
        ps.Add(PropSpec.Enum("size", "Size", PropSpec.Sizes3()).Field("Size"));
        ps.Add(PropSpec.TextField("Icon"));
        ps.Add(PropSpec.TextField("VoidIcon"));
        return ps;
    }
    public void SetStars(int v) {
        if (v < 0) { v = 0; }
        if (v > maxStars) { v = maxStars; }
        Value.Set(v);
        this.SyncBinding();
    }
    private bool rateSynced;
    private int lastRateFill;
    private bool lastRateLocked;
    private int lastRateMax;
    private int lastRatePx;
    private string lastRateIc;
    private string lastRateVic;
    private string lastRateSize;
    private string lastRateCls;
    protected override bool UsesBaseFlowOnly() { return this.Kind() == "Rate"; }
    public int HoverValue() { return lastHover; }
    public override void SyncBinding() {
        base.SyncBinding();
        if (maxStars < 1) { maxStars = 1; }
        int fillTo = Value.Get();
        if (fillTo < 0) { fillTo = 0; }
        if (fillTo > maxStars) { fillTo = maxStars; }
        bool locked = readOnly || this.IsDisabled();
        string szVal = Size != null ? Size.Get() : "";
        string ic = Icon != null && Icon.Get() != "" ? Icon.Get() : "star";
        string vic = VoidIcon != null && VoidIcon.Get() != "" ? VoidIcon.Get() : "star-empty";
        int px = this.StarBoxPx();
        if (rateSynced && starNodes != null && starNodes.Count == maxStars
            && fillTo == lastRateFill && locked == lastRateLocked
            && maxStars == lastRateMax && px == lastRatePx
            && ic == lastRateIc && vic == lastRateVic
            && szVal == lastRateSize && Class == lastRateCls) {
            return;
        }
        this.ApplySizeClass();
        if (starNodes == null || starNodes.Count != maxStars) { this.BuildStars(); }
        for (int i = 0; i < starNodes.Count; i = i + 1) {
            IconView s = starNodes[i];
            bool on = i < fillTo;
            s.Icon = on ? ic : vic;
            s.Box = px;
            s.Disabled = locked;
            if (on) {
                s.AddClass("on");
                s.RemoveClass("off");
            } else {
                s.AddClass("off");
                s.RemoveClass("on");
            }
        }
        rateSynced = true;
        lastRateFill = fillTo;
        lastRateLocked = locked;
        lastRateMax = maxStars;
        lastRatePx = px;
        lastRateIc = ic;
        lastRateVic = vic;
        lastRateSize = szVal;
        lastRateCls = Class;
    }
    public void OnStarClick(int idx) {
        if (readOnly || this.IsDisabled() || idx < 0 || idx >= maxStars) { return; }
        int newVal = idx + 1;
        if (clearable && Value.Get() == newVal) { newVal = 0; }
        if (newVal != Value.Get()) {
            Value.Set(newVal);
            Change.Raise(this);
            this.SyncBinding();
        }
    }
}
