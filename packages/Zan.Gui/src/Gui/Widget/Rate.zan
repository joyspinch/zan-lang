using System;
using System.Collections.Generic;
using Gui;

namespace Gui.Widget;

// 星级评分（Rate）：标准声明式 Flex 容器对象树。
// 由 maxStars 个星形子控件构成，完全依托 CSS Flex 流式排布与主题样式规则。
public class Rate : Control {
    public SignalInt model;
    public Binding<int> data;
    public int maxStars;
    public UiEvent Change;
    public UiEvent HoverChange;
    public bool allowHalf;
    public bool readOnly;
    public bool clearable;
    public Binding<string> Size;
    public Binding<string> Icon;
    public Binding<string> VoidIcon;
    private int lastHover;
    private List<IconView> starNodes;

    public override int StyleDisplay() { return 1; } // Flex
    public override int StyleFlexDir() { return 0; } // Row

    private void InitRate(SignalInt m, int stars) {
        this.InitControl("rate", 1);
        this.ClassName = "rate row align-center";
        model = m;
        maxStars = stars > 0 ? stars : 5;
        wiresOwnEvents = true;
        Change = new UiEvent();
        HoverChange = new UiEvent();
        allowHalf = false;
        readOnly = false;
        clearable = false;
        Size = "medium";
        Icon = "star";
        VoidIcon = "star-empty";
        lastHover = 0;
        starNodes = new List<IconView>();
        this.BuildStars();
    }

    public Rate() : this(5) { }

    public Rate(int stars) {
        InitRate(new SignalInt(0), stars);
    }

    public void BuildStars() {
        this.children.Clear();
        starNodes.Clear();
        string ic = Icon != null && Icon.Get() != "" ? Icon.Get() : "star";
        string vic = VoidIcon != null && VoidIcon.Get() != "" ? VoidIcon.Get() : "star-empty";
        int cur = model != null ? model.Get() : 0;
        for (int i = 0; i < maxStars; i = i + 1) {
            bool on = i < cur;
            IconView star = new IconView(on ? ic : vic, 20);
            star.ClassName = on ? "rate-star on" : "rate-star off";
            int idx = i;
            star.Click.Add(() => { this.OnStarClick(idx); });
            this.Add(star);
            starNodes.Add(star);
        }
    }

    public Rate Max(int stars) {
        if (stars != maxStars && stars > 0) {
            maxStars = stars;
            this.BuildStars();
        }
        return this;
    }

    public int MaxStars() { return maxStars; }
    public override string Kind() { return "Rate"; }
    public override Binding<string> SizeOf() { return Size; }

    public override List<PropSpec> Props() {
        List<PropSpec> ps = new List<PropSpec>();
        PropSpec mx = PropSpec.Int("max", "Maximum stars");
        mx.num = maxStars;
        mx.Step(1, 1, 10);
        ps.Add(mx);
        PropSpec val = PropSpec.Int("value", "Rating");
        if (data != null) { val.num = data; } else { val.snum = model; }
        val.Also("data");
        val.Step(1, 0, 10);
        ps.Add(val);
        PropSpec half = PropSpec.Bool("allowHalf", "Allow half");
        half.flag = allowHalf;
        ps.Add(half);
        PropSpec ro = PropSpec.Bool("readonly", "Readonly");
        ro.flag = readOnly;
        ps.Add(ro);
        PropSpec clr = PropSpec.Bool("clearable", "Clearable");
        clr.flag = clearable;
        ps.Add(clr);
        PropSpec sz = PropSpec.Enum("size", "Size", PropSpec.Sizes3());
        sz.str = Size;
        ps.Add(sz);
        PropSpec ico = PropSpec.Text("icon", "Icon");
        ico.str = Icon;
        ps.Add(ico);
        PropSpec vic = PropSpec.Text("voidIcon", "Void icon");
        vic.str = VoidIcon;
        ps.Add(vic);
        return ps;
    }

    public int Value() { return model.Get(); }

    public void SetStars(int v) {
        if (v < 0) { v = 0; }
        if (v > maxStars) { v = maxStars; }
        model.Set(v);
        if (data != null) { data.Set(v); }
        this.SyncBinding();
    }

    public int HoverValue() { return lastHover; }

    public override void SyncBinding() {
        base.SyncBinding();
        if (data != null) {
            int cur = data.Get();
            if (cur != model.Get()) { model.Set(cur); }
        }
        int fillTo = model.Get();
        string ic = Icon != null && Icon.Get() != "" ? Icon.Get() : "star";
        string vic = VoidIcon != null && VoidIcon.Get() != "" ? VoidIcon.Get() : "star-empty";
        for (int i = 0; i < starNodes.Count; i = i + 1) {
            IconView s = starNodes[i];
            bool on = i < fillTo;
            s.Icon = on ? ic : vic;
            if (on) {
                s.AddClass("on");
                s.RemoveClass("off");
            } else {
                s.AddClass("off");
                s.RemoveClass("on");
            }
        }
    }

    private void OnStarClick(int idx) {
        if (readOnly) { return; }
        int newVal = idx + 1;
        if (clearable && model.Get() == newVal) { newVal = 0; }
        if (newVal != model.Get()) {
            model.Set(newVal);
            if (data != null) { data.Set(newVal); }
            Change.RaiseS(this);
            this.SyncBinding();
        }
    }

    public override List<string> Events() {
        List<string> e = Control.CommonEvents();
        e.Add("Change");
        e.Add("HoverChange");
        return e;
    }

    public override void BindEvent(string evt, Action a) {
        if (evt == "Change") { Change.Add(a); return; }
        if (evt == "HoverChange") { HoverChange.Add(a); return; }
        On.AddByName(evt, a);
    }

    public override void BindEventS(string evt, ControlEvent a) {
        if (evt == "Change") { Change.AddS(a); return; }
        if (evt == "HoverChange") { HoverChange.AddS(a); return; }
        On.AddByNameS(evt, a);
    }

    public override void TriggerEvent(string evt) {
        if (evt == "Change") { Change.RaiseS(this); return; }
        if (evt == "HoverChange") { HoverChange.RaiseS(this); return; }
        base.TriggerEvent(evt);
    }
}
