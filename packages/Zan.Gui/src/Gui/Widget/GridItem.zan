using System;
using Gui;

namespace Gui.Widget;

// 栅格里的一格（Naive UI n-gi）：给内容声明跨几列、前面空几列。
// grid.With(new GridItem(2).With(chart));   // 占两列
// grid.With(new GridItem(1, 1).With(note)); // 空一列后占一列
// 只跨一列时不必包这一层，直接把控件加进 Grid 即可。
// 本身是纵向流式的透明容器：多个子控件会自上而下堆叠。
public class GridItem : Control {
    // 跨列数（至少 1；超过栅格总列数时按总列数截断）。
    private int span;
    // 本格之前留空的列数。
    private int offset;

    // 初始化：以 "gridItem" 注册为纵向流式容器，钳制跨列/空列下限。
    private void InitItem(int sp, int off) {
        this.InitControl("gridItem", 1);
        // 纵向流式：With() 的子控件依次向下停靠。
        layout = 1;
        span = sp;
        if (span < 1) { span = 1; }
        offset = off;
        if (offset < 0) { offset = 0; }
    }

    // Default design-time constructor：占一列。
    public GridItem() { InitItem(1, 0); }

    // 占 sp 列（<1 按 1）。
    public GridItem(int sp) { InitItem(sp, 0); }

    // 先空 off 列再占 sp 列（越界按边界钳制）。
    public GridItem(int sp, int off) { InitItem(sp, off); }

    // 控件类型标识（序列化/设计器用）："GridItem"。
    public override string Kind() { return "GridItem"; }
    // 皮肤样式类型键："griditem"。
    public override string StyleType() { return "griditem"; }

    // 跨列数。
    public int Span() { return span; }
    // 前置空列数。
    public int Offset() { return offset; }

    // 改跨列数（<1 按 1），返回自身。
    public GridItem SetSpan(int sp) {
        span = sp;
        if (span < 1) { span = 1; }
        return this;
    }

    // 改前置空列数（<0 按 0），返回自身。
    public GridItem SetOffset(int off) {
        offset = off;
        if (offset < 0) { offset = 0; }
        return this;
    }

    // ---- 多态属性协议 -------------------------------------------
    public override List<PropSpec> Props() {
        List<PropSpec> ps = new List<PropSpec>();
        PropSpec sp = PropSpec.Int("span", "Span");
        sp.num = span;
        ps.Add(sp);
        PropSpec off = PropSpec.Int("offset", "Offset");
        off.num = offset;
        ps.Add(off);
        return ps;
    }

    public override string GetProp(string key) {
        if (key == "span") { return Convert.ToString(span); }
        if (key == "offset") { return Convert.ToString(offset); }
        return base.GetProp(key);
    }

    public override void SetProp(string key, string val) {
        if (key == "span") {
            this.SetSpan(Convert.ToInt32(val));
            return;
        }
        if (key == "offset") {
            this.SetOffset(Convert.ToInt32(val));
            return;
        }
        base.SetProp(key, val);
    }

    public override bool SetExtra(string key, string val) {
        if (key == "span" || key == "offset") {
            this.SetProp(key, val);
            return true;
        }
        return base.SetExtra(key, val);
    }

    public override string GetExtra(string key) {
        if (key == "span" || key == "offset") {
            return this.GetProp(key);
        }
        return base.GetExtra(key);
    }
}
