namespace Gui;
internal class ThemeDrawerRelay : AppLoopParticipant, AppPreparationParticipant, AppLoopStopped {
    internal weak App owner;
    internal weak ThemeDrawer drawer;
    internal string command;
    internal int value;
    internal int session;
    internal weak UiEvent actionEvent;
    public void Invoke() {
        App app = owner;
        ThemeDrawer view = drawer;
        if (app != null && view != null && app.isRunning && view.IsSession(session)) {
            if (command == "close") { app.CloseThemeDrawer(view); }
            else { app.ChangeThemeDrawerSetting(view, command, value); }
        }
    }
    public void Closed() {
        App app = owner;
        ThemeDrawer view = drawer;
        if (app != null && view != null) { app.CloseThemeDrawer(view); }
    }
    public void Tick(App app, int now) { }
    public int NextDeadline() { return -1; }
    public void BeforeInput(App app, int kind) { this.Prepare(app); }
    public void BeforePaint(App app, int frameSequence) { this.Prepare(app); }
    private void Prepare(App app) {
        ThemeDrawer view = drawer;
        if (app == owner && view != null) { view.Prepare(app); }
    }
    public void Stopped(App app) {
        ThemeDrawer view = drawer;
        if (app == owner && view != null) { app.RetireThemeDrawer(view); }
    }
}
