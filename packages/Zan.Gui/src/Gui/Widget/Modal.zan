using System;
using Gui;

namespace Gui.Widget;

// 现代声明式模态对话框：对齐 Naive UI n-modal 与 DevExpress 浮层体系。
// 具备半透明背景遮罩、视觉黄金分割自动居中、标题栏、关闭按钮、内容槽与确认/取消操作栏。
public class Modal : Panel {
    public Card modalBox;
    public Control bodyContent;
    public Button closeBtn;
    public Button okBtn;
    public Button cancelBtn;
    public string titleText;
    public int modalWidth;
    public int modalHeight;
    public bool mask;
    public bool maskClosable;
    public bool isOpen;
    public Binding<bool> data;
    public UiEvent Open;
    public UiEvent Close;
    public UiEvent Ok;
    public UiEvent Cancel;

    public Modal() {
        this.InitPanel("modal-overlay", 3);
        this.Grow();
        modalWidth = 520;
        modalHeight = 0;
        mask = true;
        maskClosable = true;
        isOpen = false;
        titleText = "";

        Open = new UiEvent();
        Close = new UiEvent();
        Ok = new UiEvent();
        Cancel = new UiEvent();

        modalBox = new Card();

        closeBtn = new Button("X").Ghost().Small();
        DialogAction closeBtnAction = new DialogAction();
        closeBtnAction.modal = this;
        closeBtn.Click.Add(closeBtnAction.CloseModal);
        modalBox.HeaderExtra(closeBtn);

        cancelBtn = new Button("取消").Secondary().Small();
        DialogAction cancelBtnAction = new DialogAction();
        cancelBtnAction.modal = this;
        cancelBtn.Click.Add(cancelBtnAction.CancelModal);

        okBtn = new Button("确定").Primary().Small();
        DialogAction okBtnAction = new DialogAction();
        okBtnAction.modal = this;
        okBtn.Click.Add(okBtnAction.AcceptModal);

        modalBox.Actions(new List<Control> { cancelBtn, okBtn });
        base.Add(modalBox);
        this.SetShown(false);
    }

    public Modal(string title) : this() {
        this.Title(title);
    }

    public Modal Title(string t) {
        titleText = t;
        modalBox.Title(t);
        return this;
    }

    public Modal Width(int w) {
        modalWidth = w;
        return this;
    }

    public Modal Height(int h) {
        modalHeight = h;
        return this;
    }

    public Modal Mask(bool enable) {
        mask = enable;
        return this;
    }

    public Modal MaskClosable(bool enable) {
        maskClosable = enable;
        return this;
    }

    public Modal Content(Control content) {
        bodyContent = content;
        modalBox.Content(content);
        return this;
    }

    public Modal Actions(List<Control> actions) {
        modalBox.Actions(actions);
        return this;
    }

    public Modal Action(Control act) {
        modalBox.Action(act);
        return this;
    }

    public Modal OkText(string text) {
        okBtn.Text = text;
        return this;
    }

    public Modal CancelText(string text) {
        cancelBtn.Text = text;
        return this;
    }

    public Modal OnOk(Action h) {
        Ok.Add(h);
        return this;
    }

    public override void CloneContentTo(Control target, CloneTreeFn clone) {
        Modal modal = (Modal)target;
        if (bodyContent != null) { modal.Content(clone(bodyContent)); }
        for (int i = 0; i < modalBox.actions.Count; i = i + 1) {
            Control action = modalBox.actions[i];
            if (action != cancelBtn && action != okBtn) { modal.Action(clone(action)); }
        }
    }

    public override string Kind() { return "Modal"; }

    public override List<PropSpec> Props() {
        List<PropSpec> ps = new List<PropSpec>();
        PropSpec t = PropSpec.Text("title", "Title");
        t.str = titleText;
        ps.Add(t);
        PropSpec op = PropSpec.Bool("open", "Is open");
        if (data != null) { op.flag = data; } else { op.flag = isOpen; }
        op.Also("visible");
        op.Also("data");
        ps.Add(op);
        PropSpec w = PropSpec.Int("width", "Modal width");
        w.num = modalWidth;
        ps.Add(w);
        PropSpec h = PropSpec.Int("height", "Modal height");
        h.num = modalHeight;
        ps.Add(h);
        PropSpec m = PropSpec.Bool("mask", "Show mask");
        m.flag = mask;
        ps.Add(m);
        PropSpec mc = PropSpec.Bool("maskClosable", "Mask closable");
        mc.flag = maskClosable;
        ps.Add(mc);
        return ps;
    }

    public override void SyncBinding() {
        base.SyncBinding();
        if (data != null) {
            bool want = data.Get();
            if (want != isOpen) {
                if (want) { this.Show(); } else { this.Hide(); }
            }
        }
    }

    public override string GetProp(string key) {
        string k = key.ToLower();
        if (k == "open" || k == "visible" || k == "data" || k == "value") {
            if (data != null) { return PropSpec.Flag(data.Get()); }
            return PropSpec.Flag(isOpen);
        }
        if (k == "title") { return titleText; }
        if (k == "width") { return Convert.ToString(modalWidth); }
        if (k == "height") { return Convert.ToString(modalHeight); }
        if (k == "mask") { return PropSpec.Flag(mask); }
        if (k == "mask-closable" || k == "maskclosable") { return PropSpec.Flag(maskClosable); }
        return base.GetProp(key);
    }

    public override bool MountSlot(string slot, Control c) {
        if (slot == "extra" || slot == "header-extra") {
            modalBox.HeaderExtra(c);
            return true;
        }
        if (slot == "action" || slot == "actions" || slot == "footer") {
            modalBox.Action(c);
            return true;
        }
        if (slot == "content" || slot == "body") {
            this.Content(c);
            return true;
        }
        return base.MountSlot(slot, c);
    }

    public override Control Add(Control child) {
        if (child == null) { return null; }
        if (child.slotName != "" && this.MountSlot(child.slotName, child)) {
            return child;
        }
        this.Content(child);
        return child;
    }

    public override void SetProp(string key, string val) {
        string k = key.ToLower();
        if (k == "title") { this.Title(val); return; }
        if (k == "width") { this.Width(int.Parse(val)); return; }
        if (k == "height") { this.Height(int.Parse(val)); return; }
        if (k == "mask") { this.Mask(val != "false" && val != "0"); return; }
        if (k == "mask-closable" || k == "maskclosable") { this.MaskClosable(val != "false" && val != "0"); return; }
        if (k == "ok-text" || k == "oktext") { this.OkText(val); return; }
        if (k == "cancel-text" || k == "canceltext") { this.CancelText(val); return; }
        if (k == "visible" || k == "open") {
            if (val == "true" || val == "1") { this.Show(); } else { this.Hide(); }
            return;
        }
        base.SetProp(key, val);
    }

    public Modal OnCancel(Action h) {
        Cancel.Add(h);
        return this;
    }

    public Modal Show() {
        isOpen = true;
        this.SetShown(true);
        if (data != null) { data.Set(true); }
        Open.Raise();
        return this;
    }

    public Modal Hide() {
        isOpen = false;
        this.SetShown(false);
        if (data != null) { data.Set(false); }
        Close.Raise();
        return this;
    }

    public bool IsOpen() {
        return isOpen;
    }

    public override bool DismissOnOutsideClick() {
        return maskClosable;
    }

    public override void OnPopupDismissed() {
        if (this.isOpen && this.maskClosable) {
            this.Hide();
        }
    }

    public Card Box() {
        return modalBox;
    }

    public override void Arrange(int x, int y, int w, int h) {
        base.Arrange(x, y, w, h);
        if (!isOpen) { return; }

        int boxW = modalWidth;
        if (boxW > w - 40) { boxW = w - 40; }
        if (boxW < 200) { boxW = 200; }

        int boxH = modalHeight > 0 ? modalHeight : (modalBox.prefH >= 240 ? modalBox.prefH : 240);
        if (boxH > h - 60) { boxH = h - 60; }
        if (boxH < 180) { boxH = 180; }

        int boxX = x + (w - boxW) / 2;
        int boxY = y + (h - boxH) / 3;
        if (boxY < y + 20) { boxY = y + 20; }

        modalBox.Arrange(boxX, boxY, boxW, boxH);
    }

    public override void OnPaint(App app) {
        if (!isOpen) { return; }
        if (mask && app != null && app.canvas != null) {
            // 半透明遮罩层 (深色半透明 0x73000000 约 45% 不透明度)
            app.canvas.FillRect(this.bx, this.by, this.bw, this.bh, 0x73000000);
            // 遮罩必须同时注册命中阻挡区：只画不挡的话，遮罩上的
            // 点击会原样落到下层页面——打开一个 Modal，顺手把背景
            // 页面的「删除」也点了；遮罩下的按钮还会继续亮悬停。
            // OnPaint 在子控件绘制之前执行，阻挡区先注册，弹窗
            // 自己的按钮随后注册、盖过它（HitTester 后注册者优先）。
            app.BlockHitsRect(this.bx, this.by, this.bw, this.bh);
        }
        base.OnPaint(app);
    }
}
