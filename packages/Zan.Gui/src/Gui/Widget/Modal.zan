using System;
using Gui;
namespace Gui.Widget;
[GuiKind("Modal")]
public class Modal : Panel {
    public override Control CreateCloneShell() { return new Modal(); }
    public Card modalBox;
    public Control bodyContent;
    public Button closeBtn;
    public Button okBtn;
    public Button cancelBtn;
    public string titleText;
    public int modalWidth;
    public int modalHeight;
    public bool mask;
    public bool maskClosable;
    private bool appliedOpen;
    public Binding<bool> Opened;
    public UiEvent Open;
    public UiEvent Close;
    public UiEvent Ok;
    public UiEvent Cancel;
    public Modal() {
        this.InitPanel("modal-overlay", 3);
        this.Grow();
        modalWidth = 520;
        modalHeight = 0;
        mask = true;
        maskClosable = true;
        appliedOpen = false;
        Opened = false;
        titleText = "";
        Open = new UiEvent();
        Close = new UiEvent();
        Ok = new UiEvent();
        Cancel = new UiEvent();
        modalBox = new Card();
        closeBtn = new Button("X") { ClassName = "ghost small" };
        DialogAction closeBtnAction = new DialogAction();
        closeBtnAction.modal = this;
        closeBtn.Click.Add(closeBtnAction.CloseModal);
        modalBox.HeaderExtra(closeBtn);
        cancelBtn = new Button("取消") { ClassName = "secondary small" };
        DialogAction cancelBtnAction = new DialogAction();
        cancelBtnAction.modal = this;
        cancelBtn.Click.Add(cancelBtnAction.CancelModal);
        okBtn = new Button("确定") { ClassName = "primary small" };
        DialogAction okBtnAction = new DialogAction();
        okBtnAction.modal = this;
        okBtn.Click.Add(okBtnAction.AcceptModal);
        modalBox.Actions(new List<Control> { cancelBtn, okBtn });
        base.Add(modalBox);
        this.SetShown(false);
    }
    public Modal(string title) : this() { this.Title(title); }
    public string TitleText {
        get { return titleText; }
        set { this.Title(value); }
    }
    public int ModalWidth {
        get { return modalWidth; }
        set { modalWidth = value; }
    }
    public int ModalHeight {
        get { return modalHeight; }
        set { modalHeight = value; }
    }
    public bool ShowMask {
        get { return mask; }
        set { mask = value; }
    }
    public bool IsMaskClosable {
        get { return maskClosable; }
        set { maskClosable = value; }
    }
    public Control BodyContent {
        get { return bodyContent; }
        set { this.Content(value); }
    }
    public List<Control> ActionButtons {
        get { return modalBox.actions; }
        set { this.Actions(value); }
    }
    public string OkButtonText {
        get { return okBtn.Text != null ? okBtn.Text.Get() : ""; }
        set { this.OkText(value); }
    }
    public string CancelButtonText {
        get { return cancelBtn.Text != null ? cancelBtn.Text.Get() : ""; }
        set { this.CancelText(value); }
    }
    public bool IsOpened {
        get { return this.IsOpen(); }
        set { if (value) { this.Show(); } else { this.Hide(); } }
    }
    public void Title(string t) {
        titleText = t;
        modalBox.Title(t);
    }
    public void Width(int w) { modalWidth = w; }
    public void Height(int h) { modalHeight = h; }
    public void Mask(bool enable) { mask = enable; }
    public void MaskClosable(bool enable) { maskClosable = enable; }
    public void Content(Control content) {
        bodyContent = content;
        modalBox.Content(content);
    }
    public void Actions(List<Control> actions) { modalBox.Actions(actions); }
    public void Action(Control act) { modalBox.Action(act); }
    public void OkText(string text) { okBtn.Text = text; }
    public void CancelText(string text) { cancelBtn.Text = text; }
    public void OnOk(Action h) { Ok.Add(h); }
    public override void CloneContentTo(Control target, CloneTreeFn clone) {
        Modal modal = (Modal)target;
        if (bodyContent != null) { modal.Content(clone(bodyContent)); }
        for (int i = 0; i < modalBox.actions.Count; i = i + 1) {
            Control action = modalBox.actions[i];
            if (action != cancelBtn && action != okBtn) { modal.Action(clone(action)); }
        }
    }
    // 展开状态（设计器 / HTML 的 open/visible/data）：写入即 Show/Hide。
    public bool OpenState {
        get { return Opened != null ? Opened.Get() : appliedOpen; }
        set { if (value) { this.Show(); } else { this.Hide(); } }
    }

    public void SetTitleText(string t) { this.Title(t); }
    public void SetWidth(int w) { this.Width(w); }
    public void SetHeight(int h) { this.Height(h); }
    public void SetMask(bool on) { this.Mask(on); }
    public void SetMaskClosable(bool on) { this.MaskClosable(on); }

    protected override List<PropSpec> DefineProps() {
        List<PropSpec> ps = new List<PropSpec>();
        ps.Add(PropSpec.Text("title", "Title").Field("titleText").Setter("SetTitleText"));
        ps.Add(PropSpec.Bool("open", "Is open").DefaultBinding().Field("OpenState").Also("visible").Also("data").Also("value"));
        ps.Add(PropSpec.Int("width", "Modal width").Field("modalWidth").Setter("SetWidth"));
        ps.Add(PropSpec.Int("height", "Modal height").Field("modalHeight").Setter("SetHeight"));
        ps.Add(PropSpec.Bool("mask", "Show mask").Field("mask").Setter("SetMask"));
        ps.Add(PropSpec.Bool("maskClosable", "Mask closable").Field("maskClosable").Setter("SetMaskClosable")
            .Also("mask-closable").Also("maskclosable"));
        ps.Add(PropSpec.Text("okText", "OK text").ForwardTo(okBtn, "text").Also("ok-text").Also("oktext"));
        ps.Add(PropSpec.Text("cancelText", "Cancel text").ForwardTo(cancelBtn, "text").Also("cancel-text").Also("canceltext"));
        return ps;
    }
    public override void SyncBinding() {
        base.SyncBinding();
        if (Opened != null) {
            bool want = Opened.Get();
            if (want != appliedOpen) {
                if (want) { this.Show(); } else { this.Hide(); }
            }
        }
    }
    public override bool MountSlot(string slot, Control c) {
        if (slot == "extra" || slot == "header-extra") {
            modalBox.HeaderExtra(c);
            return true;
        }
        if (slot == "action" || slot == "actions" || slot == "footer") {
            modalBox.Action(c);
            return true;
        }
        if (slot == "content" || slot == "body") {
            this.Content(c);
            return true;
        }
        return base.MountSlot(slot, c);
    }
    public override Control Add(Control child) {
        if (child == null) { return null; }
        if (child.slotName != "" && this.MountSlot(child.slotName, child)) { return child; }
        this.Content(child);
        return child;
    }
    public Modal OnCancel(Action h) {
        Cancel.Add(h);
        return this;
    }
    public Modal Show() {
        appliedOpen = true;
        this.SetShown(true);
        if (!Opened.Get()) { Opened.Set(true); }
        Open.Raise(this);
        return this;
    }
    public Modal Hide() {
        appliedOpen = false;
        this.SetShown(false);
        if (Opened.Get()) { Opened.Set(false); }
        Close.Raise(this);
        return this;
    }
    public bool IsOpen() { return Opened.Get(); }
    public override bool DismissOnOutsideClick() { return maskClosable; }
    public override void OnPopupDismissed() {
        if (this.appliedOpen && this.maskClosable) { this.Hide(); }
    }
    public Card Box() { return modalBox; }
    public override void OnMeasure(App app) {
        this.SyncBinding();
        base.OnMeasure(app);
    }
    public override void Arrange(int x, int y, int w, int h) {
        base.Arrange(x, y, w, h);
        if (!appliedOpen) { return; }
        int boxW = modalWidth;
        if (boxW > w - 40) { boxW = w - 40; }
        if (boxW < 200) { boxW = 200; }
        int boxH = modalHeight > 0 ? modalHeight : (modalBox.prefH >= 240 ? modalBox.prefH : 240);
        if (boxH > h - 60) { boxH = h - 60; }
        if (boxH < 180) { boxH = 180; }
        int boxX = x + (w - boxW) / 2;
        int boxY = y + (h - boxH) / 3;
        if (boxY < y + 20) { boxY = y + 20; }
        modalBox.Arrange(boxX, boxY, boxW, boxH);
    }
    public override void OnPaint(App app) {
        this.SyncBinding();
        if (!appliedOpen) { return; }
        if (mask && app != null && app.canvas != null) {
            int maskBg = this.ResolvePartAs(app, "modal", "mask", "", Class,
                                            Style.SNormal()).BgOr(0);
            if (maskBg != 0) {
                app.canvas.FillRect(this.bx, this.by, this.bw, this.bh, maskBg);
            }
        }
        base.OnPaint(app);
    }
}
