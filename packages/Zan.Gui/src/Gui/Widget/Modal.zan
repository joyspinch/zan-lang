using System;
using Gui;
using Gui.Backend;

namespace Gui.Widget;

// 现代声明式模态对话框：对齐 Naive UI n-modal 与 DevExpress 浮层体系。
// 具备半透明背景遮罩、视觉黄金分割自动居中、标题栏、关闭按钮、内容槽与确认/取消操作栏。
public class Modal : Panel {
    Card modalBox;
    Control bodyContent;
    Button closeBtn;
    Button okBtn;
    Button cancelBtn;
    string titleText;
    int modalWidth;
    bool mask;
    bool maskClosable;
    bool isOpen;
    public UiEvent Open;
    public UiEvent Close;
    public UiEvent Ok;
    public UiEvent Cancel;

    Modal() {
        this.InitPanel("modal-overlay", 3);
        this.dock = 5;
        this.layout = 0;
        modalWidth = 520;
        mask = true;
        maskClosable = true;
        isOpen = false;
        titleText = "";

        Open = new UiEvent();
        Close = new UiEvent();
        Ok = new UiEvent();
        Cancel = new UiEvent();

        modalBox = new Card();
        modalBox.dock = 0;

        closeBtn = new Button("X").Ghost().Small();
        closeBtn.Click += () => { this.Hide(); };
        modalBox.HeaderExtra(closeBtn);

        cancelBtn = new Button("取消").Secondary().Small();
        cancelBtn.Click += () => {
            Cancel.Raise();
            this.Hide();
        };

        okBtn = new Button("确定").Primary().Small();
        okBtn.Click += () => {
            Ok.Raise();
        };

        modalBox.Actions(new List<Control> { cancelBtn, okBtn });
        this.With(modalBox);
        this.SetShown(false);
    }

    static Modal Create(string title) {
        Modal m = new Modal();
        m.Title(title);
        return m;
    }

    Modal Title(string t) {
        titleText = t;
        modalBox.Title(t);
        return this;
    }

    Modal Width(int w) {
        modalWidth = w;
        return this;
    }

    Modal Mask(bool enable) {
        mask = enable;
        return this;
    }

    Modal MaskClosable(bool enable) {
        maskClosable = enable;
        return this;
    }

    Modal Content(Control content) {
        bodyContent = content;
        modalBox.Content(content);
        return this;
    }

    Modal Actions(List<Control> actions) {
        modalBox.Actions(actions);
        return this;
    }

    Modal Action(Control act) {
        modalBox.Action(act);
        return this;
    }

    Modal OkText(string text) {
        okBtn.Text = text;
        return this;
    }

    Modal CancelText(string text) {
        cancelBtn.Text = text;
        return this;
    }

    Modal OnOk(Action h) {
        Ok.Add(h);
        return this;
    }

    override string Kind() { return "Modal"; }

    override bool MountSlot(string slot, Control c) {
        if (slot == "extra" || slot == "header-extra") {
            modalBox.HeaderExtra(c);
            return true;
        }
        if (slot == "action" || slot == "actions" || slot == "footer") {
            modalBox.Action(c);
            return true;
        }
        if (slot == "content" || slot == "body") {
            this.Content(c);
            return true;
        }
        return base.MountSlot(slot, c);
    }

    override Control Add(Control child) {
        if (child == null) { return null; }
        if (child.slotName != "" && this.MountSlot(child.slotName, child)) {
            return child;
        }
        this.Content(child);
        return child;
    }

    override void SetProp(string key, string val) {
        string k = key.ToLower();
        if (k == "title") { this.Title(val); return; }
        if (k == "width") { this.Width(int.Parse(val)); return; }
        if (k == "mask") { this.Mask(val != "false" && val != "0"); return; }
        if (k == "mask-closable" || k == "maskclosable") { this.MaskClosable(val != "false" && val != "0"); return; }
        if (k == "ok-text" || k == "oktext") { this.OkText(val); return; }
        if (k == "cancel-text" || k == "canceltext") { this.CancelText(val); return; }
        if (k == "visible" || k == "open") {
            if (val == "true" || val == "1") { this.Show(); } else { this.Hide(); }
            return;
        }
        base.SetProp(key, val);
    }

    Modal OnCancel(Action h) {
        Cancel.Add(h);
        return this;
    }

    Modal Show() {
        isOpen = true;
        this.SetShown(true);
        Open.Raise();
        return this;
    }

    Modal Hide() {
        isOpen = false;
        this.SetShown(false);
        Close.Raise();
        return this;
    }

    bool IsOpen() {
        return isOpen;
    }

    Card Box() {
        return modalBox;
    }

    override void Arrange(int x, int y, int w, int h) {
        base.Arrange(x, y, w, h);
        if (!isOpen) { return; }

        int boxW = modalWidth;
        if (boxW > w - 40) { boxW = w - 40; }
        if (boxW < 200) { boxW = 200; }

        int boxH = modalBox.prefH > 0 ? modalBox.prefH : 260;
        if (boxH > h - 60) { boxH = h - 60; }

        int boxX = x + (w - boxW) / 2;
        int boxY = y + (h - boxH) / 3;
        if (boxY < y + 20) { boxY = y + 20; }

        modalBox.Arrange(boxX, boxY, boxW, boxH);
    }

    override void OnPaint(App app) {
        if (!isOpen) { return; }
        if (mask && app != null && app.canvas != null) {
            // 半透明遮罩层 (深色半透明 0x73000000 约 45% 不透明度)
            app.canvas.FillRect(this.bx, this.by, this.bw, this.bh, 0x73000000);
            // 遮罩必须同时注册命中阻挡区：只画不挡的话，遮罩上的
            // 点击会原样落到下层页面——打开一个 Modal，顺手把背景
            // 页面的「删除」也点了；遮罩下的按钮还会继续亮悬停。
            // OnPaint 在子控件绘制之前执行，阻挡区先注册，弹窗
            // 自己的按钮随后注册、盖过它（HitTester 后注册者优先）。
            app.BlockHitsRect(this.bx, this.by, this.bw, this.bh);
        }
        base.OnPaint(app);
    }
}
