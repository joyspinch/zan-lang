using System;
using System.Collections.Generic;
using Gui;
namespace Gui.Widget;
public class Popover : PopupTrigger {
    private string title;
    private string body;
    private int panelW;
    public int trigId { get { return this.triggerId; } set { this.triggerId = value; } }
    public string TitleText {
        get { return this.title; }
        set { this.title = value; }
    }
    public string BodyText {
        get { return this.body; }
        set { this.body = value; }
    }
    public int PanelWidth {
        get { return this.panelW; }
        set { this.panelW = value > 0 ? value : 260; this.popupWidth = this.panelW; }
    }
    private void InitPopover(string trig, string ti, string bo, int w) {
        int pw = w > 0 ? w : 260;
        this.InitPopupTrigger("popover", trig, pw, 0);
        this.title = ti;
        this.body = bo;
        this.panelW = pw;
    }
    public Popover() { InitPopover("Click", "", "", 260); }
    public Popover(string trig) { InitPopover(trig, "", "", 260); }
    public Popover(string trig, string ti, string bo, int w) { InitPopover(trig, ti, bo, w); }
    public override Control BuildDefaultPopup(App app) {
        Card card = new Card(title);
        card.Class = "popover-card";
        if (body != "") {
            Label lbl = new Label(body);
            lbl.wrap = true;
            card.With(lbl);
        }
        card.prefW = panelW;
        return card;
    }
    protected override List<PropSpec> DefineProps() {
        List<PropSpec> ps = new List<PropSpec>();
        ps.Add(PropSpec.Text("text", "Trigger text").Field("triggerText").Setter("SetTriggerText").Also("triggerText").Also("label"));
        ps.Add(PropSpec.Text("title", "Title").Field("title"));
        ps.Add(PropSpec.Text("body", "Body").Field("body"));
        ps.Add(PropSpec.Int("panelW", "Panel width").Field("panelW").StepBy(8));
        ps.Add(PropSpec.Bool("open", "Open").DefaultBinding().Field("Opened").Also("data").Also("value"));
        return ps;
    }

    // 覆写：触发器默认一行高、120 逻辑像素宽。
    public override void OnMeasure(App app) {
        this.SyncBinding();
        prefH = app != null ? app.theme.heightMedium : 32;
        prefW = app != null ? app.Scale(120) : 120;
    }
}
