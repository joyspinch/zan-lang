using System;
using System.Collections.Generic;
using Gui;

namespace Gui.Widget;

// 气泡卡片（Popover）：标准声明式浮层组件。
// 继承自统一的 PopupControl 浮层基类，接入 OverlayHost 生命周期，
// 天然置于顶层并具备外部点击自动关闭。
public class Popover : PopupControl {
    private string trigLabel;
    private string title;
    private string body;
    private int panelW;
    public int trigId { get { return this.triggerId; } set { this.triggerId = value; } }

    // 初始化：以 "popover" 注册，置触发文本/标题/正文/面板宽并保持关闭。
    private void InitPopover(string trig, string ti, string bo, int w) {
        this.InitPopup("popover", w > 0 ? w : 260, 0);
        this.trigLabel = trig;
        this.title = ti;
        this.body = bo;
        this.panelW = w > 0 ? w : 260;
    }

    public Popover() {
        InitPopover("Click", "", "", 260);
    }

    public Popover(string trig) {
        InitPopover(trig, "", "", 260);
    }

    public Popover(string trig, string ti, string bo, int w) {
        InitPopover(trig, ti, bo, w);
    }

    // 覆写默认浮层构造：生成 Popover 专属的卡片与文本子树
    public override Control BuildDefaultPopup(App app) {
        Card card = new Card(title);
        card.Class = "popover-card";
        if (body != "") {
            Label lbl = new Label(body);
            lbl.wrap = true;
            card.With(lbl);
        }
        card.prefW = panelW;
        return card;
    }

    // 覆写：设计器属性（触发文本/标题/正文/面板宽/开合缺省）。
    public override List<PropSpec> Props() {
        List<PropSpec> ps = new List<PropSpec>();
        PropSpec trig = PropSpec.Text("text", "Trigger text");
        trig.str = trigLabel;
        trig.syncName = true;
        ps.Add(trig);
        PropSpec ti = PropSpec.Text("title", "Title");
        ti.str = title;
        ps.Add(ti);
        PropSpec bo = PropSpec.Text("body", "Body");
        bo.str = body;
        ps.Add(bo);
        PropSpec w = PropSpec.Int("panelW", "Panel width");
        w.num = panelW;
        w.StepBy(8);
        ps.Add(w);
        PropSpec op = PropSpec.Bool("open", "Open");
        op.sflag = open;
        ps.Add(op);
        return ps;
    }

    public override string Kind() { return "Popover"; }

    // 覆写：触发器默认一行高、120 逻辑像素宽。
    public override void OnMeasure(App app) {
        prefH = app != null ? app.theme.heightMedium : 32;
        prefW = app != null ? app.Scale(120) : 120;
    }

    public override void OnClick(RoutedEventArgs e) {
        this.ToggleOpen();
        App a = this.FindApp();
        if (a != null) { a.RequestRedraw(); }
        e.Handle();
    }

    // 覆写：在自身矩形内画触发器。
    public override void OnPaint(App app) {
        int id = this.CommonId();
        DropdownChrome.PaintTrigger(app, id, bx, by, bw, bh, trigLabel, open.Get());
        app.focus.RegisterFocusable(id);
    }
}
