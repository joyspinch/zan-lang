using System;
using Gui;

namespace Gui.Widget;

// 颜色选择器（对齐 Naive UI n-color-picker）：触发条显示当前颜色，
// 点击弹出 SV 面板（饱和度×明度，两层渐变自绘）、色相条（六段
// 渐变）、透明度条（棋盘格打底）与 RGBA/HEX/HSL/HSB 输入行
// （左侧标签点击循环切换格式，回车提交）。所有尺寸按 DPI 缩放，
// 皮肤走 `colorpicker` 规则（`::trigger` / `::panel` / `::checker` /
// `::label`）。
// C# 风格保留式实例：
// pick.Change += () => { ... };   // 值变化时触发
// 模式（Naive UI modes，决定取值文本格式）：
// pick.Modes("rgb", "hex", "", "");  // 限制可选格式
// pick.Mode = "hex";                 // 当前取值文本格式
// string v = pick.Text();            // "#5B3737FF"
// 带透明度（Naive UI show-alpha，默认开）：
// pick.SetShowAlpha(false);          // 隐藏透明度条，alpha 恒 1
// 内部以 HSV（h 0..359、s/v 0..1000）+ alpha（0..255）工作，绑定
// 值是打包的 0xAARRGGBB（`SignalInt` / `Binding<int>` 双向）。Zan
// 的 int 是 32 位，打包色常以负数形式存储——凡提取分量一律走
// RgbOf / AlphaOf（App.LerpColor 同款符号安全写法），禁止裸除。
public class ColorPicker : Control {
    public Control customPopup;
    // 内部当前打包色信号（0xAARRGGBB）；存在双向绑定时与其同步。
    public SignalInt model;
    // 双向绑定值（打包 0xAARRGGBB）：`pick.data = model.color;`
    // 保持模型字段与选择器双向同步。
    public Binding<int> data;
    // 触发条命中 id；+1/+2/+3 为 SV 面板 / 色相条 / 透明度条（WidgetId.Block(8)）。
    public int wid;
    // 值变化时触发（C# 风格：`pick.Change += h;`）。拖动面板/条、
    // 输入行回车提交都会触发；程序化 SetColor 不触发。
    public UiEvent Change;
    // 弹层展开状态。
    public bool open;
    // HSV 内部状态：h 0..359，s/v 0..1000（v=0 纯黑、s=0 灰阶）。
    public int hue;
    // 饱和度 s，0..1000。
    public int sat;
    // 明度 v，0..1000。
    public int val;
    // alpha 通道 0..255。
    public int alpha;
    // 显示透明度条（Naive UI show-alpha，默认开）。
    public bool showAlpha;
    // 可选格式（Naive UI modes）：rgb / hex / hsl / hsb 的子集。
    // 空列表 = 全部四种。取值文本跟随 Mode。
    public List<string> modes;
    // 当前取值文本格式（Naive UI 的 value 格式跟随 modes）。
    public Binding<string> Mode;
    // 正在拖动的部件：0 无 / 1 SV 面板 / 2 色相条 / 3 透明度条。
    public int dragPart;
    // RGBA 四个数字输入框（弹层内保留态，焦点跨帧存活）。
    public Input inR;
    // G 通道输入框。
    public Input inG;
    // B 通道输入框。
    public Input inB;
    // A 通道输入框（0..100%）。
    public Input inA;
    // HEX 十六进制输入框（#RRGGBB 或 #RRGGBBAA）。
    public Input inHex;
    // HSL 三元组输入框（"h, s%, l%"）。
    public Input inHsl;
    // HSB 三元组输入框（"h, s%, v%"）。
    public Input inHsb;
    // 输入行当前显示的格式：0 RGBA / 1 HEX / 2 HSL / 3 HSB，
    // 左侧标签点击循环切换。
    public int inputView;

    // id 段（WidgetId.Block(8)）：wid = 触发条，wid+1 = SV 面板，
    // wid+2 = 色相条，wid+3 = 透明度条。
    public static int SvPanelOff() { return 1; }
    // 色相条命中 id：wid + 2。
    public static int HueOff() { return 2; }
    // 透明度条命中 id：wid + 3。
    public static int AlphaOff() { return 3; }

    // ---- 打包色工具（符号安全；int 为 32 位，0xAARRGGBB 常为负）----

    // 由 8 位 r/g/b 生成"不透明"打包色。255*2^24 在 32 位里回绕成
    // 负数——与 Theme.Rgb 的位型一致，属规范存储形式。
    public static int Opaque(int r, int g, int b) {
        return (int)(((255 & 255) << 24) | ((r & 255) << 16) | ((g & 255) << 8) | (b & 255));
    }

    // 打包色的低 24 位 RGB（0..16777215，负数包也正确）。
    public static int RgbOf(int packed) {
        return packed & 16777215; // 0xFFFFFF，位掩码直接屏蔽负数符号位
    }

    // 打包色的 alpha 通道（0..255，负数包也正确）。
    public static int AlphaOf(int packed) {
        return (packed >> 24) & 255;
    }

    // 两个打包色是否同一个颜色（提取各通道无符号精确比较）。
    public static bool SamePacked(int a, int b) {
        return ColorPicker.RgbOf(a) == ColorPicker.RgbOf(b)
            && ColorPicker.AlphaOf(a) == ColorPicker.AlphaOf(b);
    }

    // HSV → 打包不透明色（h 0..359，s/v 0..1000）。
    public static int HsvToRgb(int h, int s, int v) {
        int r;
        int g;
        int b;
        if (s <= 0) {
            int gray = v * 255 / 1000;
            return ColorPicker.Opaque(gray, gray, gray);
        }
        int sector = h * 6 / 360;
        if (sector > 5) { sector = 5; }
        int rem = h * 6 - sector * 360;
        // rem 0..360 是扇区内 f = rem/360 的千分比展开；q/t 都以
        // ÷360 把 rem 归一到 0..s（写成 ÷1000 会让纯色泄漏出杂色）。
        int p1 = v * (1000 - s) / 1000;
        int p2 = v * (1000 - s * rem / 360) / 1000;
        int p3 = v * (1000 - s * (360 - rem) / 360) / 1000;
        if (sector == 0) { r = v; g = p3; b = p1; }
        else if (sector == 1) { r = p2; g = v; b = p1; }
        else if (sector == 2) { r = p1; g = v; b = p3; }
        else if (sector == 3) { r = p1; g = p2; b = v; }
        else if (sector == 4) { r = p3; g = p1; b = v; }
        else { r = v; g = p1; b = p2; }
        return ColorPicker.Opaque(r * 255 / 1000, g * 255 / 1000,
                                  b * 255 / 1000);
    }

    // RGB（低 24 位）转 HSV：直接更新当前实例的 hue/sat/val，消除全局静态变量污染。
    public void ApplyRgbToHsv(int rgb) {
        int r = (rgb >> 16) & 255;
        int g = (rgb >> 8) & 255;
        int b = rgb & 255;
        int max = r; if (g > max) { max = g; } if (b > max) { max = b; }
        int min = r; if (g < min) { min = g; } if (b < min) { min = b; }
        int d = max - min;
        val = max * 1000 / 255;
        sat = max > 0 ? d * 1000 / max : 0;
        int h = 0;
        if (d > 0) {
            if (max == r) {
                h = (g - b) * 60 / d;
            } else if (max == g) {
                h = 120 + (b - r) * 60 / d;
            } else {
                h = 240 + (r - g) * 60 / d;
            }
            if (h < 0) { h = h + 360; }
            if (h > 359) { h = 359; }
        }
        hue = h;
    }

    // 打包色 → "#RRGGBB"。
    public static string HexText(int color) {
        int rgb = ColorPicker.RgbOf(color);
        string s = "#";
        s = s + ColorPicker.Hex2((rgb >> 16) & 255);
        s = s + ColorPicker.Hex2((rgb >> 8) & 255);
        s = s + ColorPicker.Hex2(rgb & 255);
        return s;
    }

    // 打包色 → "#RRGGBBAA"（alpha 始终写出）。
    public static string HexTextAlpha(int color) {
        return ColorPicker.HexText(color)
            + ColorPicker.Hex2(ColorPicker.AlphaOf(color));
    }

    // 字节 → 两位大写十六进制文本。
    public static string Hex2(int b) {
        string digits = "0123456789ABCDEF";
        byte[] buf = new byte[2];
        buf[0] = (byte)(digits[(b >> 4) & 15] & 255);
        buf[1] = (byte)(digits[b & 15] & 255);
        return buf.ToStr(0, 2);
    }

    // 单个十六进制 ASCII 字节 → 0..15（非法返回 -1；大小写均接受）。
    public static int HexByte(int c) {
        if (c >= 48 && c <= 57) { return c - 48; }
        if (c >= 65 && c <= 70) { return c - 55; }
        if (c >= 97 && c <= 102) { return c - 87; }
        return -1;
    }

    // 单个十六进制字符 → 0..15（非法返回 -1；大小写均接受）。
    public static int HexDigit(string ch) {
        if (ch == null || ch.Length == 0) { return -1; }
        return ColorPicker.HexByte(ch[0] & 255);
    }

    // "#RGB"/"#RRGGBB"/"#RRGGBBAA" → 打包色（以 ColorParseResult 实例返回，消除全局静态污染）。
    public static ColorParseResult HexParse(string s) {
        if (s == null || s.Length < 4 || (s[0] & 255) != 35) { return new ColorParseResult(false, -1); }  // '#'
        int blen = s.Length - 1;
        int r = 0;
        int g = 0;
        int b = 0;
        int a = 255;
        if (blen == 3) {
            int d0 = ColorPicker.HexByte(s[1] & 255);
            int d1 = ColorPicker.HexByte(s[2] & 255);
            int d2 = ColorPicker.HexByte(s[3] & 255);
            if (d0 < 0 || d1 < 0 || d2 < 0) { return new ColorParseResult(false, -1); }
            r = d0 * 17;
            g = d1 * 17;
            b = d2 * 17;
        } else if (blen == 6 || blen == 8) {
            int d0 = ColorPicker.HexByte(s[1] & 255);
            int d1 = ColorPicker.HexByte(s[2] & 255);
            int d2 = ColorPicker.HexByte(s[3] & 255);
            int d3 = ColorPicker.HexByte(s[4] & 255);
            int d4 = ColorPicker.HexByte(s[5] & 255);
            int d5 = ColorPicker.HexByte(s[6] & 255);
            if (d0 < 0 || d1 < 0 || d2 < 0 || d3 < 0 || d4 < 0 || d5 < 0) { return new ColorParseResult(false, -1); }
            r = (d0 << 4) | d1;
            g = (d2 << 4) | d3;
            b = (d4 << 4) | d5;
            if (blen == 8) {
                int d6 = ColorPicker.HexByte(s[7] & 255);
                int d7 = ColorPicker.HexByte(s[8] & 255);
                if (d6 < 0 || d7 < 0) { return new ColorParseResult(false, -1); }
                a = (d6 << 4) | d7;
            }
        } else {
            return new ColorParseResult(false, -1);
        }
        return new ColorParseResult(true, a * 16777216 + r * 65536 + g * 256 + b);
    }

    // "rgba(91, 55, 55, 1)" / "rgb(91, 55, 55)" /
    // "hsl(120, 50%, 40%)" / "hsb(120, 50%, 40%)"（可带第 4 个
    // alpha 参数）→ 打包色（以 ColorParseResult 实例返回，消除全局静态污染）。
    public static ColorParseResult FuncParse(string s) {
        int lp = s.IndexOf("(");
        if (lp < 0) { return new ColorParseResult(false, -1); }
        if (!s.EndsWith(")")) { return new ColorParseResult(false, -1); }
        string head = s.Substring(0, lp).Trim().ToLower();
        string body = s.Substring(lp + 1, s.Length - lp - 2);
        bool isHsl = head == "hsl" || head == "hsla";
        bool isHsb = head == "hsb" || head == "hsv";
        bool rgbish = head == "rgb" || head == "rgba";
        if (!isHsl && !isHsb && !rgbish) { return new ColorParseResult(false, -1); }
        List<string> parts = body.Split(",");
        if (parts.Count < 3) { return new ColorParseResult(false, -1); }
        int a = 255;
        if (parts.Count >= 4) {
            a = ColorPicker.PctOrFrac(parts[3].Trim());
            if (a < 0) { return new ColorParseResult(false, -1); }
        }
        int r;
        int g;
        int b;
        if (isHsl) {
            int h = ColorPicker.ParseIntSafe(parts[0].Trim());
            int ss = ColorPicker.PctNum(parts[1].Trim());
            int ll = ColorPicker.PctNum(parts[2].Trim());
            if (h < 0 || h > 359 || ss < 0 || ll < 0) { return new ColorParseResult(false, -1); }
            int rgb = ColorPicker.RgbOf(ColorPicker.HslToRgb(h, ss, ll));
            r = (rgb / 65536) % 256;
            g = (rgb / 256) % 256;
            b = rgb % 256;
        } else if (isHsb) {
            int h = ColorPicker.ParseIntSafe(parts[0].Trim());
            int ss = ColorPicker.PctNum(parts[1].Trim());
            int vv = ColorPicker.PctNum(parts[2].Trim());
            if (h < 0 || h > 359 || ss < 0 || vv < 0) { return new ColorParseResult(false, -1); }
            int rgb = ColorPicker.RgbOf(ColorPicker.HsvToRgb(h, ss, vv));
            r = (rgb / 65536) % 256;
            g = (rgb / 256) % 256;
            b = rgb % 256;
        } else {
            bool pct = parts[0].Trim().EndsWith("%");
            if (pct) {
                r = ColorPicker.PctNum(parts[0].Trim()) * 255 / 1000;
                g = ColorPicker.PctNum(parts[1].Trim()) * 255 / 1000;
                b = ColorPicker.PctNum(parts[2].Trim()) * 255 / 1000;
            } else {
                r = ColorPicker.ParseIntSafe(parts[0].Trim());
                g = ColorPicker.ParseIntSafe(parts[1].Trim());
                b = ColorPicker.ParseIntSafe(parts[2].Trim());
            }
            if (r < 0 || r > 255 || g < 0 || g > 255 || b < 0 || b > 255) {
                return new ColorParseResult(false, -1);
            }
        }
        return new ColorParseResult(true, a * 16777216 + r * 65536 + g * 256 + b);
    }

    // "1" / "0.5" / "50%" → alpha 0..255（非法 -1）。
    public static int PctOrFrac(string s) {
        if (s.EndsWith("%")) { return ColorPicker.PctNum(s) * 255 / 1000; }
        int dot = s.IndexOf(".");
        if (dot < 0) {
            int v = ColorPicker.ParseIntSafe(s);
            if (v == 1) { return 255; }
            if (v == 0) { return 0; }
            return -1;
        }
        int whole = ColorPicker.ParseIntSafe(s.Substring(0, dot));
        string frac = s.Substring(dot + 1, s.Length - dot - 1);
        while (frac.Length < 3) { frac = frac + "0"; }
        if (frac.Length > 3) { frac = frac.Substring(0, 3); }
        int f = ColorPicker.ParseIntSafe(frac);
        if (whole < 0 || whole > 1 || f < 0) { return -1; }
        return (whole * 1000 + f) * 255 / 1000;
    }

    // "50%" → 0..1000 千分比（非法 -1）。
    public static int PctNum(string s) {
        if (!s.EndsWith("%")) { return -1; }
        int v = ColorPicker.ParseIntSafe(s.Substring(0, s.Length - 1));
        if (v < 0 || v > 100) { return -1; }
        return v * 10;
    }

    // 纯数字串 → int（任何非数字字符返回 -1；防 Convert.ToInt32
    // 对垃圾输入的运行时错误）。
    public static int ParseIntSafe(string s) {
        if (s == null || s.Length == 0) { return -1; }
        int v = 0;
        for (int i = 0; i < s.Length; i = i + 1) {
            int c = s[i] & 255;
            if (c < 48 || c > 57) { return -1; }
            v = v * 10 + (c - 48);
        }
        return v;
    }

    // RGB → HSL（h 0..359 * 1e6 | s 0..1000 * 1e3 | l 0..1000）。
    public static int RgbHsl(int r, int g, int b) {
        int max = r; if (g > max) { max = g; } if (b > max) { max = b; }
        int min = r; if (g < min) { min = g; } if (b < min) { min = b; }
        int d = max - min;
        int h = 0;
        int s = 0;
        int l = (max + min) * 500 / 255;
        if (d > 0) {
            if (max == r) { h = (g - b) * 60 / d; }
            else if (max == g) { h = 120 + (b - r) * 60 / d; }
            else { h = 240 + (r - g) * 60 / d; }
            if (h < 0) { h = h + 360; }
            if (h > 359) { h = 359; }
            if (l > 500) { s = d * 1000 / (510 - max - min); }
            else { s = d * 1000 / (max + min); }
        }
        if (s > 1000) { s = 1000; }
        return h * 1000000 + s * 1000 + l;
    }

    // HSL → 打包不透明色。
    public static int HslToRgb(int h, int s, int l) {
        if (s <= 0) {
            int gray = l * 255 / 1000;
            return ColorPicker.Opaque(gray, gray, gray);
        }
        int c = (l < 500 ? l : 1000 - l) * s * 2 / 1000;
        int hp = h * 6 / 360;
        if (hp > 5) { hp = 5; }
        int rem = h * 6 - hp * 360;
        /* 显式 (int) 转换：编译器按 C# 规则收紧了「double → int 初始化
         * 窄化」，Math.Abs 返回 double，这里必须显式收口（同
         * Gui/Component/Ribbon.zan 的同类写法）。 */
        int xx = (int)(c * (360 - Math.Abs(rem * 2 - 360)) / 360);
        int m = l - c / 2;
        int r1;
        int g1;
        int b1;
        if (hp == 0) { r1 = c; g1 = xx; b1 = 0; }
        else if (hp == 1) { r1 = xx; g1 = c; b1 = 0; }
        else if (hp == 2) { r1 = 0; g1 = c; b1 = xx; }
        else if (hp == 3) { r1 = 0; g1 = xx; b1 = c; }
        else if (hp == 4) { r1 = xx; g1 = 0; b1 = c; }
        else { r1 = c; g1 = 0; b1 = xx; }
        return ColorPicker.Opaque((r1 + m) * 255 / 1000,
                                  (g1 + m) * 255 / 1000,
                                  (b1 + m) * 255 / 1000);
    }

    // ---- 状态 ------------------------------------------------------

    // 正在拖动/已拖动色盘的标志：false 时 CurrentRgb 直接回
    // basePacked（赋值往返精确，不被 HSV 千分比量化磨损）。
    public bool hsvTouched;
    // 最近一次外部赋入的打包色（hsvTouched=false 时的取值基准）。
    public int basePacked;

    // 公共初始化：分配 id 块、建默认输入行并挂 Submit 静态转发。
    private void InitPicker(SignalInt m) {
        this.InitControl("colorpicker", 1);
        model = m;
        wid = WidgetId.Block(8);
        wiresOwnEvents = true;
        Change = new UiEvent();
        open = false;
        hue = 0;
        sat = 0;
        val = 0;
        alpha = 255;
        hsvTouched = false;
        basePacked = 0xFF000000;
        showAlpha = true;
        modes = new List<string>();
        Mode = "rgb";
        dragPart = 0;
        inR = new Input("0");
        inG = new Input("0");
        inB = new Input("0");
        inA = new Input("100");
        inHex = new Input("#000000");
        inHsl = new Input("0, 0%, 0%");
        inHsb = new Input("0, 0%, 0%");
        inR.name = "0";
        inG.name = "1";
        inB.name = "2";
        inA.name = "3";
        inHex.name = "4";
        inHsl.name = "5";
        inHsb.name = "6";
        inR.parent = this;
        inG.parent = this;
        inB.parent = this;
        inA.parent = this;
        inHex.parent = this;
        inHsl.parent = this;
        inHsb.parent = this;
        inputView = 0;
        inR.Submit.AddS(ColorPicker.OnChannelSubmit);
        inG.Submit.AddS(ColorPicker.OnChannelSubmit);
        inB.Submit.AddS(ColorPicker.OnChannelSubmit);
        inA.Submit.AddS(ColorPicker.OnChannelSubmit);
        inHex.Submit.AddS(ColorPicker.OnChannelSubmit);
        inHsl.Submit.AddS(ColorPicker.OnChannelSubmit);
        inHsb.Submit.AddS(ColorPicker.OnChannelSubmit);
    }

    // Default design-time constructor（黑色）。
    public ColorPicker() {
        this.InitPicker(new SignalInt(0xFF000000));
        this.ApplyPacked(model.Get());
    }

    // 自持信号：`ColorPicker pick = new ColorPicker(0xFF5B3737);`
    public ColorPicker(int packed) {
        this.InitPicker(new SignalInt(packed));
        this.ApplyPacked(packed);
    }

    // 当前打包颜色。HSV 分量是 0..1000 的整数量化——纯 HSV 重算会把
    // 外部赋进来的颜色抹掉 1/1000（91,55,55 显示成 90,54,54）。在
    // 用户没动过色盘（hsvTouched=false）时直接回原包，赋值往返精确。
    public int CurrentRgb() {
        int rgb = hsvTouched
            ? ColorPicker.RgbOf(ColorPicker.HsvToRgb(hue, sat, val))
            : ColorPicker.RgbOf(basePacked);
        return App.WithAlpha(rgb, alpha);
    }

    // 从打包色同步内部 HSV/alpha（外部 SetColor、绑定回拉共用）。
    public void ApplyPacked(int packed) {
        basePacked = packed;
        hsvTouched = false;
        alpha = ColorPicker.AlphaOf(packed);
        if (!showAlpha) { alpha = 255; }
        this.ApplyRgbToHsv(ColorPicker.RgbOf(packed));
    }

    // 程序化赋值（同步内部 HSV 与触发条；不触发 Change）。
    public void SetColor(int packed) {
        this.ApplyPacked(packed);
        model.Set(this.CurrentRgb());
        if (data != null) { data.Set(this.CurrentRgb()); }
    }

    // 当前模型值（打包 0xAARRGGBB）。
    public int Value() { return model.Get(); }

    // 用户手势落定：写模型、写回双向绑定、触发 Change。
    public void Commit() {
        int packed = this.CurrentRgb();
        model.Set(packed);
        if (data != null) { data.Set(packed); }
        Change.RaiseS(this);
    }

    // 将绑定的模型值拉入内部状态（model -> UI）。
    public override void SyncBinding() {
        if (data == null) { return; }
        int cur = data.Get();
        if (!ColorPicker.SamePacked(cur, model.Get())) { model.Set(cur); }
    }

    // 显示透明度条（Naive UI show-alpha）。关闭时 alpha 恒 1。
    public void SetShowAlpha(bool on) {
        showAlpha = on;
        if (!on) { alpha = 255; }
    }

    // 设定可选格式（Naive UI modes）。空列表 = 全部。
    // 只配一种时取值格式随之锁定（Naive UI 传单一 modes 的行为），
    // 此处直接改写 Mode，纯计算路径（Text()）与渲染路径同源。
    // 当前 Mode 不在新集合里时改取集合首个（Naive UI 的行为：
    // modes 缩小后 value 格式必须仍是可选格式之一）。
    public void SetModes(List<string> list) {
        modes = list;
        if (modes == null) { modes = new List<string>(); }
        if (modes.Count == 1) {
            string m0 = modes[0].ToLower();
            if (m0 == "rgb" || m0 == "hex" || m0 == "hsl" || m0 == "hsb") {
                Mode = m0;
                return;
            }
        }
        string cur = this.ModeName();
        bool ok = modes.Count == 0;
        for (int i = 0; i < modes.Count; i = i + 1) {
            if (modes[i].ToLower() == cur) { ok = true; }
        }
        if (!ok && modes.Count > 0) {
            string first = modes[0].ToLower();
            if (first == "rgb" || first == "hex" || first == "hsl"
                || first == "hsb") {
                Mode = first;
            }
        }
    }

    // 限制可选格式：Modes("rgb", "hex", "", "")。
    public void Modes(string a, string b, string c, string d) {
        List<string> list = new List<string>();
        if (a != null && a != "") { list.Add(a); }
        if (b != null && b != "") { list.Add(b); }
        if (c != null && c != "") { list.Add(c); }
        if (d != null && d != "") { list.Add(d); }
        this.SetModes(list);
    }

    // 当前取值文本（跟随 Mode / modes 缺省）。rgb →
    // "rgba(91, 55, 55, 1)"（showAlpha=false 时 "rgb(91, 55, 55)"），
    // → "hsl(0, 34%, 29%)"。
    public string Text() {
        return this.FormatAs(this.ModeName());
    }

    // 当前生效的格式名（Mode 绑定值；非法/为空时取 modes 首个，
    // 再缺省 "rgb"）。
    public string ModeName() {
        string m = Mode != null ? Mode.Get() : "";
        if (m == null) { m = ""; }
        m = m.ToLower();
        if (m != "rgb" && m != "hex" && m != "hsl" && m != "hsb") {
            m = "";
        }
        if (m == "" && modes != null && modes.Count == 1) {
            m = modes[0].ToLower();
        }
        if (m != "rgb" && m != "hex" && m != "hsl" && m != "hsb") {
            m = "rgb";
        }
        return m;
    }

    // 按 `m` 格式格式化当前颜色。
    public string FormatAs(string m) {
        int rgb = ColorPicker.RgbOf(this.CurrentRgb());
        if (m == "hex") {
            if (showAlpha) { return ColorPicker.HexTextAlpha(this.CurrentRgb()); }
            return ColorPicker.HexText(this.CurrentRgb());
        }
        if (m == "hsl" || m == "hsb") {
            string head = m == "hsl" ? "hsl" : "hsb";
            int h;
            int s2;
            int l2;
            if (m == "hsl") {
                int packed = ColorPicker.RgbHsl((rgb / 65536) % 256,
                                                (rgb / 256) % 256, rgb % 256);
                h = packed / 1000000;
                s2 = (packed / 1000) % 1000;
                l2 = packed % 1000;
            } else {
                h = hue;
                s2 = sat;
                l2 = val;
            }
            string txt = head + "(" + Convert.ToString(h) + ", "
                + Convert.ToString(s2 / 10) + "%, "
                + Convert.ToString(l2 / 10) + "%";
            if (showAlpha) {
                txt = txt + ", " + this.AlphaText();
            }
            return txt + ")";
        }
        // rgb（缺省）：rgba(r, g, b, a) / rgb(r, g, b)。
        string kind = showAlpha ? "rgba" : "rgb";
        string parts = Convert.ToString((rgb / 65536) % 256) + ", "
            + Convert.ToString((rgb / 256) % 256) + ", "
            + Convert.ToString(rgb % 256);
        if (showAlpha) {
            return kind + "(" + parts + ", " + this.AlphaText() + ")";
        }
        return kind + "(" + parts + ")";
    }

    // alpha 通道的文本形式：255 显示 "1"，其余 0..1 两位小数。
    public string AlphaText() {
        if (alpha >= 255) { return "1"; }
        int hundredths = alpha * 100 / 255;
        int whole = hundredths / 100;
        int frac = hundredths % 100;
        string fs = Convert.ToString(frac);
        if (frac < 10) { fs = "0" + fs; }
        return Convert.ToString(whole) + "." + fs;
    }

    // ---- 设计器 ----------------------------------------------------

    // 设计器控件类型名："ColorPicker"。
    public override string Kind() { return "ColorPicker"; }

    // 设计器属性表：showAlpha 开关与 mode 取值格式枚举。
    public override List<PropSpec> Props() {
        List<PropSpec> ps = new List<PropSpec>();
        PropSpec sm = PropSpec.Bool("showAlpha", "Show alpha");
        sm.flag = showAlpha;
        sm.WithTip("Show the alpha slider (Naive UI show-alpha).");
        ps.Add(sm);
        PropSpec md = PropSpec.Enum("mode", "Mode",
            new List<string>{ "rgb", "hex", "hsl", "hsb" });
        md.str = Mode;
        md.WithTip("Format of the value text (Naive UI modes[0]).");
        ps.Add(md);
        return ps;
    }

    // 覆写：showAlpha 截写走 SetShowAlpha（关闭时重置 alpha=255，
    // spec 直绑字段丢这一副作用——管线开关后 alpha 残留实测）；mode
    // 应答归一化名（原 GetExtra 臂语义，ModeName 校验 + 默认 rgb）。
    public override string GetProp(string key) {
        if (key == "mode") { return this.ModeName(); }
        return base.GetProp(key);
    }

    public override void SetProp(string key, string val) {
        if (key == "showAlpha") { this.SetShowAlpha(val == "true"); return; }
        base.SetProp(key, val);
    }

    // 设计器读取扩展属性：value/color 无 spec（extra-only），返回
    // 当前取值文本；showAlpha/mode 走上面的 GetProp 覆写。
    public override string GetExtra(string key) {
        if (key == "value" || key == "color") { return this.Text(); }
        return "";
    }

    // 设计器写入扩展属性：value/color/text（extra-only）；未知键
    // 返回 false。
    public override bool SetExtra(string key, string val) {
        if (key == "value" || key == "color" || key == "text") {
            this.SetText(val);
            return true;
        }
        return false;
    }

    // 设计器事件列表：通用事件之外提供 "Change"。
    public override List<string> Events() {
        List<string> e = Control.CommonEvents();
        e.Add("Change");
        return e;
    }

    // 设计器事件绑定："Change" 订阅 Change，其余事件走通用 On。
    public override void BindEvent(string evt, Action a) {
        if (evt == "Change") { Change.Add(a); return; }
        On.AddByName(evt, a);
    }

    // <see cref="BindEvent"/> 的 sender 通道（S = Sender）：
    // 特化事件接本控件的 UiEvent，通用事件按名路由。
    public override void BindEventS(string evt, ControlEvent a) {
        if (evt == "Change") { Change.AddS(a); return; }
        On.AddByNameS(evt, a);
    }

    public override void TriggerEvent(string evt) {
        if (evt == "Change") { Change.RaiseS(this); return; }
        base.TriggerEvent(evt);
    }


    // 从文本赋值（designer / 程序化）："#RRGGBB[AA]" 与
    // rgba()/rgb()/hsl()/hsb() 都接受，非法文本忽略。
    public void SetText(string value) {
        ColorParseResult res = ColorPicker.HexParse(value);
        if (!res.ok) { res = ColorPicker.FuncParse(value); }
        if (res.ok) { this.SetColor(res.packed); }
    }

    // ---- 渲染 ------------------------------------------------------

    // 触发条高度（皮肤可写 colorpicker::trigger 的 height 覆盖）。
    public int TriggerH(App app) {
        StyleBox s = this.ResolveStyleAs(app, "colorpicker", Class,
                                          Style.SNormal());
        return s.HeightOr(app.theme.heightMedium);
    }

    // 即时模式兼容入口：统一走标准 DOM Arrange 与 RenderTree 管线。
    public int Render(App app, int x, int y, int width) {
        int h = this.TriggerH(app);
        return this.RenderIn(app, x, y, width, h);
    }

    // 显式盒高版本；即时模式兼容入口：统一走标准 DOM Arrange 与 RenderTree 管线。
    public int RenderIn(App app, int x, int y, int width, int height) {
        if (width <= 0) {
            if (this.prefW <= 0) { this.OnMeasure(app); }
            width = this.prefW;
        }
        if (height <= 0) {
            if (this.prefH <= 0) { this.OnMeasure(app); }
            height = this.prefH > 0 ? this.prefH : this.TriggerH(app);
        }
        this.Arrange(x, y, width, height);
        this.RenderTree(app);
        return wid;
    }

    private int PaintTrigger(App app, int x, int y, int width, int height) {
        int id = wid;
        SyncBinding();
        // 外部写模型（程序化赋值）时把内部 HSV 拉齐。
        int ext = model.Get();
        if (!ColorPicker.SamePacked(ext, this.CurrentRgb())) {
            this.ApplyPacked(ext);
        }
        bool disabled = this.IsDisabled();
        StyleBox root = this.ResolveEasedStyleAsIn(
            app, id, "colorpicker", Class, disabled, false, x, y, width, height);
        root.Paint(app, x, y, width, height);
        // 触发条中央铺当前色块（统一经 SubBox 委托底层盒模型绘制）。
        StyleBox trg = this.ResolveEasedPartAsIn(
            app, id, "colorpicker", "trigger", "", Class, disabled, false,
            x, y, width, height);
        int pad = root.BorderWOr(0) + root.PadLOr(app.Scale(3));
        int swW = width - pad * 2;
        int swH = height - pad * 2;
        if (swW > 0 && swH > 0) {
            trg.bg = this.CurrentRgb();
            trg.SetRadius(trg.RadiusOr(app.Scale(4)));
            SubBox.Paint(app, trg, x + pad, y + pad, swW, swH);
        }
        app.hitTester.RegisterRect(id, x, y, width, height, 3);
        app.focus.RegisterFocusable(id);
        // 点击触发条开/关弹层；开着时触发条与弹层由 OverlayHost 统一管理外部关闭与层级。
        if (!disabled && Ui.Clicked(app, id)) {
            open = !open;
            viewAligned = false;
            if (open) {
                Control pop = this.customPopup != null ? this.customPopup : this.EnsurePopupCard(app);
                OverlayHost.ShowPopup(app, this, pop);
            } else {
                OverlayHost.DismissPopup();
            }
            app.RequestRedraw();
        }
        if (open && !disabled && !OverlayHost.IsActiveAnchor(app, this)) {
            Control pop = this.customPopup != null ? this.customPopup : this.EnsurePopupCard(app);
            OverlayHost.ShowPopup(app, this, pop);
        } else if (!open && OverlayHost.IsActiveAnchor(app, this)) {
            OverlayHost.DismissPopup();
        }
        if (disabled) {
            if (open) { OverlayHost.DismissPopup(); }
            open = false;
        }
        if (this.On.Any()) { On.Fire(app, id, this); }
        return id;
    }

    public override void OnPopupDismissed() {
        open = false;
    }

    public bool IsOpen() {
        return open;
    }

    public Card defaultPopupCard;
    public ColorPalettePanel palettePanel;

    public Card EnsurePopupCard(App app) {
        if (defaultPopupCard == null) {
            defaultPopupCard = new Card("");
            defaultPopupCard.Class = "colorpicker-popup";
            defaultPopupCard.Pad(0);
            defaultPopupCard.parent = this;

            palettePanel = new ColorPalettePanel(this);
            palettePanel.parent = defaultPopupCard;
            defaultPopupCard.With(palettePanel);
        }
        if (app != null) {
            palettePanel.OnMeasure(app);
            defaultPopupCard.prefW = palettePanel.prefW;
            defaultPopupCard.prefH = palettePanel.prefH;
        }
        return defaultPopupCard;
    }

    public void SetOpen(bool want) {
        if (open == want) { return; }
        open = want;
        App a = this.FindApp();
        if (a == null) { a = App.FrameApp(); }
        if (want) {
            Control pop = this.customPopup != null ? this.customPopup : this.EnsurePopupCard(a);
            OverlayHost.ShowPopup(a, this, pop);
        } else {
            OverlayHost.DismissPopup();
        }
    }

    // 插槽支持：支持任意复杂组件（如调色板、预设色块、表格）互嵌到颜色选择器弹层
    public override bool MountSlot(string slot, Control c) {
        if (slot == "popup" || slot == "dropdown" || slot == "content") {
            this.SetPopupContent(c);
            return true;
        }
        return base.MountSlot(slot, c);
    }

    public void SetPopupContent(Control c) {
        this.customPopup = c;
        if (c != null && !children.Contains(c)) {
            this.Add(c);
        }
    }

    public Control GetPopupContent() {
        return this.customPopup;
    }

    // 输入行视图编号：0 RGBA / 1 HEX / 2 HSL / 3 HSB。
    public static int ViewOf(string m) {
        if (m == "hex") { return 1; }
        if (m == "hsl") { return 2; }
        if (m == "hsb") { return 3; }
        return 0;
    }

    // 视图编号 → 输入行左侧标签文字（RGBA / HEX / HSL / HSB）。
    public static string ViewLabel(int view) {
        if (view == 1) { return "HEX"; }
        if (view == 2) { return "HSL"; }
        if (view == 3) { return "HSB"; }
        return "RGBA";
    }

    // 从 `start` 往后找 modes 允许的第一个视图（全空/找不到回 start）。
    public static int NextAllowedView(int start, List<string> modes) {
        int from = start % 4;
        if (from < 0) { from = from + 4; }
        if (modes == null || modes.Count == 0) { return from; }
        for (int k = 0; k < 4; k = k + 1) {
            int cand = (from + k) % 4;
            for (int i = 0; i < modes.Count; i = i + 1) {
                if (ColorPicker.ViewOf(modes[i].ToLower()) == cand) {
                    return cand;
                }
            }
        }
        return from;
    }

    // `view` 是否在允许的 modes 里（空列表 = 全部允许）。
    public static bool Allowed(int view, List<string> modes) {
        if (modes == null || modes.Count == 0) { return true; }
        for (int i = 0; i < modes.Count; i = i + 1) {
            if (ColorPicker.ViewOf(modes[i].ToLower()) == view) {
                return true;
            }
        }
        return false;
    }

    // 弹层打开后是否已把输入行对齐到 Mode（每次打开重新对齐）。
    public bool viewAligned;

    // Input.Submit 的静态回调：经 sender 回溯找到所属 ColorPicker 实例并提交对应通道。
    private static void OnChannelSubmit(Control sender) {
        if (sender == null || sender.parent == null) { return; }
        ColorPicker cp = sender.parent as ColorPicker;
        if (cp != null) {
            int which = Convert.ToInt32(sender.name);
            cp.SubmitChannel(which);
        }
    }

    // 输入行回车提交：0-2 替换单个 R/G/B 通道，3 写 alpha（0..100%），
    // 4-6 整色替换（hex / hsl / hsb）。非法文本忽略。解析成功的一律
    // 走 ApplyPacked 整色替换——单通道补丁会让 CurrentRgb 的
    // hsvTouched 基准停在旧包上。
    private void SubmitChannel(int which) {
        bool ok = false;
        if (which <= 2) {
            string t = which == 0 ? inR.GetText()
                     : which == 1 ? inG.GetText() : inB.GetText();
            int v = ColorPicker.ParseIntSafe(t);
            if (v >= 0) {
                if (v > 255) { v = 255; }
                int rgb = ColorPicker.RgbOf(this.CurrentRgb());
                int r = (rgb / 65536) % 256;
                int g = (rgb / 256) % 256;
                int b = rgb % 256;
                if (which == 0) { r = v; }
                else if (which == 1) { g = v; }
                else { b = v; }
                this.ApplyPacked(App.WithAlpha(
                    ColorPicker.Opaque(r, g, b), alpha));
                ok = true;
            }
        } else if (which == 3) {
            int v = ColorPicker.ParseIntSafe(inA.GetText());
            if (v >= 0) {
                if (v > 100) { v = 100; }
                alpha = v * 255 / 100;
                ok = true;
            }
        } else if (which == 4) {
            ColorParseResult res = ColorPicker.HexParse(inHex.GetText());
            if (res.ok) {
                this.ApplyPacked(res.packed);
                ok = true;
            }
        } else if (which == 5) {
            ColorParseResult res = ColorPicker.FuncParse(
                "hsl(" + inHsl.GetText() + ")");
            if (res.ok) {
                this.ApplyPacked(res.packed);
                ok = true;
            }
        } else {
            ColorParseResult res = ColorPicker.FuncParse(
                "hsb(" + inHsb.GetText() + ")");
            if (res.ok) {
                this.ApplyPacked(res.packed);
                ok = true;
            }
        }
        if (ok) { this.Commit(); }
    }

    // 输入行的保留态子控件排布 + 文本同步。四种格式各一组 Input，
    // 只排当前视图那组（其余不排布即不显示、不吃键盘）。
    public void PaintInputsFromOverlay(App app, int x, int y, int h, int w, bool clicked) {
        if (inputView == 0) {
            int each = (w - app.Scale(6) * 3) / 4;
            this.LayInput(app, inR, x, y, each, h);
            this.LayInput(app, inG, x + each + app.Scale(6), y, each, h);
            this.LayInput(app, inB, x + (each + app.Scale(6)) * 2, y, each, h);
            this.LayInput(app, inA, x + (each + app.Scale(6)) * 3, y,
                          w - (each + app.Scale(6)) * 3, h);
        } else if (inputView == 1) {
            this.LayInput(app, inHex, x, y, w, h);
        } else if (inputView == 2) {
            this.LayInput(app, inHsl, x, y, w, h);
        } else {
            this.LayInput(app, inHsb, x, y, w, h);
        }
        // 内部状态 → 输入框文本（每帧）。正被编辑的字段跳过，
        // 让用户打字不被打断。
        int rgb = ColorPicker.RgbOf(this.CurrentRgb());
        if (inputView == 0) {
            this.SyncInput(app, inR, Convert.ToString((rgb / 65536) % 256));
            this.SyncInput(app, inG, Convert.ToString((rgb / 256) % 256));
            this.SyncInput(app, inB, Convert.ToString(rgb % 256));
            this.SyncInput(app, inA, Convert.ToString(alpha * 100 / 255));
        } else if (inputView == 1) {
            string hex = showAlpha ? ColorPicker.HexTextAlpha(this.CurrentRgb())
                                   : ColorPicker.HexText(this.CurrentRgb());
            this.SyncInput(app, inHex, hex);
        } else if (inputView == 2) {
            int packed = ColorPicker.RgbHsl((rgb / 65536) % 256,
                                            (rgb / 256) % 256, rgb % 256);
            string txt = Convert.ToString(packed / 1000000) + ", "
                + Convert.ToString((packed / 1000) % 1000 / 10) + "%, "
                + Convert.ToString(packed % 1000 / 10) + "%";
            this.SyncInput(app, inHsl, txt);
        } else {
            string txt2 = Convert.ToString(hue) + ", "
                + Convert.ToString(sat / 10) + "%, "
                + Convert.ToString(val / 10) + "%";
            this.SyncInput(app, inHsb, txt2);
        }
    }

    // 子输入框在弹层里的排布（不走树的 Arrange，手动摆）。
    private void LayInput(App app, Input inp, int x, int y, int w, int h) {
        inp.Render(app, x, y, w, h);
    }

    // 文本相同或字段正被编辑就不写，避免每帧重置光标。
    private void SyncInput(App app, Input inp, string text) {
        if (app.focus.IsFocused(inp.WidgetId())) { return; }
        if (inp.GetText() == text) { return; }
        inp.SetText(text);
    }

    // 测量首选尺寸：高取样式 height（缺省 heightMedium），宽取样式 width（缺省 160）。
    public override void OnMeasure(App app) {
        StyleBox s = this.ResolveStyleAs(app, "colorpicker", Class,
                                         Style.SNormal());
        prefH = s.HeightOr(app.theme.heightMedium);
        prefW = s.WidthOr(app.Scale(160));
    }

    // 覆写：保留模式绘制——基于自身盒模型 (bx, by, bw, bh) 完成触发器绘制与事件交互（弹层经 OnPaintOverlay 延迟绘制）。
    public override void OnPaint(App app) {
        this.PaintTrigger(app, bx, by, bw, bh);
    }
}

// 颜色解析结果对象（消除全局 static parseOk 状态污染）
public class ColorParseResult {
    public bool ok;
    public int packed;
    public ColorParseResult(bool ok, int packed) {
        this.ok = ok;
        this.packed = packed;
    }
}
