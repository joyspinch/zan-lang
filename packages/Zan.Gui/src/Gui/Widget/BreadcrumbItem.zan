using System;
using Gui;

namespace Gui.Widget;

// 面包屑项（DOM 容器组件）：纯 Flex 节点，支持文本、链接以及嵌套任意子组件。
// 彻底物理消除手算坐标（cx, cy, cw, ch）、手动 Arrange 循环与逐帧 DrawText。
public class BreadcrumbItem : Control {
    private string text;
    private string href;

    public override int StyleDisplay() { return 1; } // CSS display: flex
    public override int StyleFlexDir() { return 0; } // flex-direction: row

    private void InitItem(string txt, string link) {
        this.InitControl("breadcrumb-item", 1);
        text = txt != null ? txt : "";
        href = link != null ? link : "";
        this.RebuildItem();
    }

    public BreadcrumbItem() { InitItem("", ""); }
    public BreadcrumbItem(string txt) { InitItem(txt, ""); }
    public BreadcrumbItem(string txt, string link) { InitItem(txt, link); }
    public BreadcrumbItem(Control content) {
        this.InitControl("breadcrumb-item", 1);
        text = "";
        href = "";
        if (content != null) {
            this.Add(content);
        }
    }

    public void SetText(string t) {
        text = t != null ? t : "";
        this.RebuildItem();
    }
    public string Text() { return text; }

    public void SetHref(string h) { href = h != null ? h : ""; }
    public string Href() { return href; }

    public void RebuildItem() {
        if (children.Count > 0 && text == "") { return; }
        this.children.Clear();
        if (text != "") {
            Label lbl = new Label(text);
            lbl.ClassName = "breadcrumb-text";
            this.Add(lbl);
        }
    }

    public override string Kind() { return "BreadcrumbItem"; }
}
