using System;
using Gui;

namespace Gui.Widget;

// 面包屑项（DOM 容器组件）：支持文本、链接以及嵌套任意子组件（Icon, Dropdown, Button 等）。
public class BreadcrumbItem : Control {
    string text;
    string href;

    BreadcrumbItem() {
        this.InitControl("breadcrumb-item", 1);
        this.text = "";
        this.href = "";
    }

    BreadcrumbItem(string txt) {
        this.InitControl("breadcrumb-item", 1);
        this.text = txt != null ? txt : "";
        this.href = "";
    }

    BreadcrumbItem(string txt, string link) {
        this.InitControl("breadcrumb-item", 1);
        this.text = txt != null ? txt : "";
        this.href = link != null ? link : "";
    }

    BreadcrumbItem(Control content) {
        this.InitControl("breadcrumb-item", 1);
        this.text = "";
        this.href = "";
        if (content != null) {
            this.Add(content);
        }
    }

    void SetText(string t) { text = t != null ? t : ""; }
    string Text() { return text; }

    void SetHref(string h) { href = h != null ? h : ""; }
    string Href() { return href; }

    override string Kind() { return "BreadcrumbItem"; }

    override void OnMeasure(App app) {
        Theme t = app.theme;
        StyleBox s = this.ResolveStyleAs(app, "breadcrumb", Class, Style.SNormal());
        int fs = s.FontOr(Style.FontFallback(app, "medium"));
        int contentW = 0;
        int contentH = Canvas.FontHeight(fs);

        if (children.Count > 0) {
            contentW = 0;
            contentH = 0;
            for (int i = 0; i < children.Count; i = i + 1) {
                Control c = children[i];
                c.OnMeasure(app);
                contentW = contentW + c.prefW;
                if (c.prefH > contentH) { contentH = c.prefH; }
            }
        } else if (text != "") {
            contentW = Canvas.MeasureText(text, fs);
        }
        prefW = contentW;
        prefH = contentH;
    }

    override void OnPaint(App app) {
        if (bw <= 0 || bh <= 0) { return; }
        if (children.Count > 0) {
            int cx = bx;
            for (int i = 0; i < children.Count; i = i + 1) {
                Control c = children[i];
                int cw = c.prefW > 0 ? c.prefW : bw;
                int ch = c.prefH > 0 ? c.prefH : bh;
                int cy = by + (bh - ch) / 2;
                c.Arrange(cx, cy, cw, ch);
                c.RenderTree(app);
                cx = cx + cw + app.Scale(4);
            }
        } else if (text != "") {
            Canvas c = app.canvas;
            StyleBox s = this.ResolveStyleAs(app, "breadcrumb", Class, Style.SNormal());
            int fs = s.FontOr(Style.FontFallback(app, "medium"));
            int ty = Canvas.CenterTextY(by, bh, fs);
            c.DrawText(bx, ty, text, s.FgOr(0), fs);
        }
    }
}
