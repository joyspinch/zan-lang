using System;
using Gui;

namespace Gui.Widget;

// 铰链与物理折痕感知分割容器：
// 自动避开折叠屏/三折叠设备的物理折痕区域（Hinge Area），
// 将内容精准分割排布在两侧平整屏幕区域，杜绝文字或交互按钮被铰链割裂。
public class HingeSplitPanel : Control {
    private Panel firstPane;
    private Panel secondPane;
    private int hingePadding;
    private HingeArea customHinge;
    private bool hasCustomHinge;
    private int splitRatio; // 0 表示均分，1..99 表示第一格百分比

    public HingeSplitPanel() {
        this.InitControl("hinge_split", 5);
        firstPane = SplitPanel.NewPane("left");
        secondPane = SplitPanel.NewPane("right");
        this.Add(firstPane);
        this.Add(secondPane);
        hingePadding = 8;
        splitRatio = 50;
        hasCustomHinge = false;
    }

    public Panel First()  { return firstPane; }
    public Panel Second() { return secondPane; }
    public Panel Left()   { return firstPane; }
    public Panel Right()  { return secondPane; }

    public HingeSplitPanel WithHingePadding(int pad) {
        if (pad >= 0) { hingePadding = pad; }
        return this;
    }

    public HingeSplitPanel WithRatio(int ratioPercent) {
        if (ratioPercent > 0 && ratioPercent < 100) { splitRatio = ratioPercent; }
        return this;
    }

    // 显式指定折痕矩形（用于模拟或测试特定硬件）
    public HingeSplitPanel WithHinge(int x, int y, int w, int h, bool isVert) {
        customHinge = new HingeArea(x, y, w, h, isVert);
        hasCustomHinge = true;
        return this;
    }

    public override void OnMeasure(App app) {
        if (prefSet) { return; }
        prefW = 0;
        prefH = 0;
    }

    public override void Arrange(int px, int py, int pw, int ph) {
        if (pw < 0) { pw = 0; }
        if (ph < 0) { ph = 0; }
        bx = px;
        by = py;
        bw = pw;
        bh = ph;

        // 检测是否存在贯穿该容器的有效纵向折痕
        bool useHinge = false;
        HingeArea h = customHinge;
        if (hasCustomHinge && !h.IsEmpty() && h.isVertical) {
            if (h.x > px && h.x < px + pw) { useHinge = true; }
        }

        if (useHinge) {
            // 物理折痕避让排布：第一格截止于折痕左侧，第二格起始于折痕右侧
            int leftW = h.x - px - hingePadding;
            if (leftW < 0) { leftW = 0; }

            int rightX = h.x + h.width + hingePadding;
            int rightW = px + pw - rightX;
            if (rightW < 0) { rightW = 0; }

            firstPane.Arrange(px, py, leftW, ph);
            secondPane.Arrange(rightX, py, rightW, ph);
        } else {
            // 平板态或普通大屏：按比例弹性均分排布
            int w1 = pw * splitRatio / 100;
            int w2 = pw - w1;
            firstPane.Arrange(px, py, w1, ph);
            secondPane.Arrange(px + w1, py, w2, ph);
        }
    }
}
