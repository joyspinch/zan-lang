using System;
using System.Collections.Generic;
using Gui;
using Gui.Backend;
namespace Gui.Widget;
public partial class ListView<T> {
    public override bool Templated() { return rowOf != null || this.HasSlotColumns(); }
    public override int RowHeight(App app) {
        app = this.ResolveApp(app);
        if (fixedRowHeight > 0) { return app != null ? app.Scale(fixedRowHeight) : fixedRowHeight; }
        if (app == null) { return 32; }
        StyleBox s = this.ResolveStyleCached(app, "list", Class, Style.SNormal());
        return s.HeightOr(app.theme.heightLarge);
    }
    public int HeaderHeight() { return this.HeaderHeight(this.App); }
    public int HeaderHeight(App app) {
        app = this.ResolveApp(app);
        if (app == null) { return 0; }
        if (cols.Count < 2 || Style.Has(Class, "headless")) { return 0; }
        return app.theme.heightSmall;
    }
    protected override Control CreateRowControl(int index) {
        int ticket = rowsRevision;
        List<T> source = data;
        if (source == null || index < 0 || index >= source.Count) { return null; }
        Control row = rowOf != null ? rowOf(source[index]) : this.BuildCompositeRow(source[index]);
        if (ticket != rowsRevision || source != data) { return null; }
        if (row != null && row.item == null) { row.item = source[index]; }
        if (row != null && onlySelectable != null) {
            bool selectable = onlySelectable(source[index]);
            if (ticket != rowsRevision || source != data) { return null; }
            if (!selectable) { row.Disabled.Set(true); }
        }
        return row;
    }
    protected override void CollectWantedRows(App app, List<int> wanted) {
        int n = this.Count();
        int first = 0;
        int last = n;
        if (fixedRowHeight > 0) {
            VisibleRowHost.ComputeVisibleWindow(
                scroll != null ? scroll.Get() : 0, this.ScrollViewport().height,
                this.RowHeight(app), n, out first, out last);
        }
        for (int i = first; i < last; i = i + 1) { wanted.Add(i); }
    }
    public override int ContentHeight(App app) {
        app = this.ResolveApp(app);
        if (fixedRowHeight > 0) { return this.Count() * this.RowHeight(app); }
        if (this.Templated()) {
            int h = 0;
            for (int i = 0; i < this.Count(); i = i + 1) {
                Control row = this.DataRow(i);
                if (row != null) { h = h + this.RowExtent(app, row); }
            }
            return h;
        }
        return this.Count() * this.RowHeight(app);
    }
    public bool Selectable(int row) {
        if (!this.Has(row)) { return false; }
        if (onlySelectable != null && !onlySelectable(data[row])) { return false; }
        Control control = this.DataRow(row);
        if (control != null && control.IsDisabled()) { return false; }
        return true;
    }
    private void EnsureListPaintStyles(App app) {
        if (lvRowNorm != null && lvStamp != null && lvStamp.IsCurrent(app, Class)) {
            return;
        }
        lvHeader = Style.PartRef(app, "listview", "header", "", Class, "", Style.SNormal());
        lvDivider = Style.PartRef(app, "listview", "divider", "", Class, "", Style.SNormal());
        lvColumn = Style.PartRef(app, "listview", "column", "", Class, "", Style.SNormal());
        lvRowNorm = Style.FullRef(app, "listrow", "", "", Style.SNormal());
        lvRowSel = Style.FullRef(app, "listrow", "", "", Style.SSelected());
        lvRowHover = Style.FullRef(app, "listrow", "", "", Style.SHover());
        lvCell = Style.PartRef(app, "listview", "cell", "", Class, "", Style.SNormal());
        string secCls = Class == "" ? "secondary" : (Class + " secondary");
        lvSecondary = Style.PartRef(app, "listview", "cell", "", secCls, "", Style.SNormal());
        lvCellOff = Style.PartRef(app, "listview", "cell", "", Class, "", Style.SDisabled());
        int dep = StyleCacheStamp.MaxDep(app, 0, "listrow", "");
        dep = StyleCacheStamp.MaxDep(app, dep, "listview", Class);
        dep = StyleCacheStamp.MaxDep(app, dep, "listview", secCls);
        if (lvStamp == null) { lvStamp = new StyleCacheStamp(); }
        lvStamp.Commit(app, Class, dep);
    }
    private List<int> ColumnWidthsBuf(int rowW) {
        if (cachedColWidths == null) { cachedColWidths = new List<int>(); }
        else { cachedColWidths.Clear(); }
        if (cols == null || cols.Count == 0) { return cachedColWidths; }
        if (rowW < 0) { rowW = 0; }
        int total = 0;
        for (int i = 0; i < cols.Count; i = i + 1) {
            int wt = cols[i].weight;
            if (wt <= 0) { wt = 1; }
            total = total + wt;
        }
        if (total <= 0) { return cachedColWidths; }
        int used = 0;
        for (int i = 0; i < cols.Count; i = i + 1) {
            int wt = cols[i].weight;
            if (wt <= 0) { wt = 1; }
            int cw = (int)((long)rowW * (long)wt / (long)total);
            if (i == cols.Count - 1) { cw = rowW - used; }
            used = used + cw;
            cachedColWidths.Add(cw);
        }
        return cachedColWidths;
    }
    public void PaintEmpty() { this.PaintEmpty(this.App); }
    public void PaintEmpty(App app) {
        if (Empty == null || Empty == "") { return; }
        app = this.ResolveApp(app);
        if (app == null || app.canvas == null) { return; }
        Theme t = app.theme;
        int headH = this.HeaderHeight(app);
        int ey = by + headH;
        int eh = bh - headH;
        if (bw <= 0 || eh <= 0) { return; }
        StyleBox empty = Style.PartRef(app, "listview", "empty", "", Class, "",
                                       Style.SNormal());
        int fs = empty.FontOr(Style.FontFallback(app, "small"));
        int pad = t.paddingMedium;
        int maxW = bw - pad * 2;
        if (maxW <= 0) { return; }
        string fit = Ellipsis.Fit(Empty, maxW, fs);
        int fw = Canvas.MeasureText(fit, fs);
        app.canvas.PushClip(bx, ey, bw, eh);
        try {
            app.canvas.DrawText(bx + (bw - fw) / 2,
                Canvas.CenterTextY(ey, eh, fs),
                fit, empty.FgOr(0),
                fs);
        } finally {
            app.canvas.PopClip();
        }
    }
    public List<int> ColumnWidths(int rowW) {
        List<int> res = new List<int>();
        if (cols == null || cols.Count == 0) { return res; }
        if (rowW < 0) { rowW = 0; }
        int total = 0;
        int i = 0;
        for (; i < cols.Count; i = i + 1) {
            int wt = cols[i].weight;
            if (wt <= 0) { wt = 1; }
            total = total + wt;
        }
        if (total <= 0) { return res; }
        int used = 0;
        i = 0;
        while (i < cols.Count) {
            int wt = cols[i].weight;
            if (wt <= 0) { wt = 1; }
            int cw = (int)((long)rowW * (long)wt / (long)total);
            if (i == cols.Count - 1) { cw = rowW - used; }
            used = used + cw;
            res.Add(cw);
            i = i + 1;
        }
        return res;
    }
    public void PaintHeader(int headH) { this.PaintHeader(this.App, headH); }
    public void PaintHeader(App app, int headH) {
        if (headH <= 0) { return; }
        app = this.ResolveApp(app);
        if (app == null || app.canvas == null) { return; }
        Canvas c = app.canvas;
        Theme t = app.theme;
        this.EnsureListPaintStyles(app);
        StyleBox header = lvHeader;
        StyleBox divider = lvDivider;
        StyleBox column = lvColumn;
        int pad = t.paddingMedium;
        bool flat = Style.Has(Class, "flat");
        int inset = flat ? 0 : 1;
        int hx = bx + inset;
        int hy = by + inset;
        int hw = bw - inset * 2;
        int hh = headH - inset;
        if (hw <= 0 || hh <= 0) { return; }
        c.PushClip(hx, hy, hw, hh);
        try {
            c.FillRect(hx, hy, hw, hh, header.BgOr(0));
            c.FillRect(hx, by + headH - 1, hw, 1, divider.BgOr(0));
            int availW = rowsBody != null ? rowsBody.ScrollViewport().width : bw;
            int viewH = rowsBody != null ? rowsBody.ScrollViewport().height : (bh - headH);
            bool overflow = !this.Templated() && viewH > 0 && this.Count() * this.RowHeight(app) > viewH;
            if (overflow) { availW = availW - app.Scale(12); }
            if (availW < 0) { availW = 0; }
            List<int> ws = this.ColumnWidthsBuf(availW - pad * 2);
            int cx = (rowsBody != null ? rowsBody.ScrollViewport().x : bx) + pad;
            int headerFont = column.FontOr(Style.FontFallback(app, "tiny"));
            int ty = Canvas.CenterTextY(by, headH, headerFont);
            for (int i = 0; i < ws.Count; i = i + 1) {
                int cw = ws[i];
                string label = Ellipsis.Fit(cols[i].title, cw - pad, headerFont);
                int tx = cx;
                if (cols[i].right) { tx = cx + cw - pad - Canvas.MeasureText(label, headerFont); }
                c.DrawText(tx, ty, label, column.FgOr(0), headerFont);
                cx = cx + cw;
            }
        } finally {
            c.PopClip();
        }
    }
    public void PaintColumnRows(int headH) { this.PaintColumnRows(this.App, headH); }
    public void PaintColumnRows(App app, int headH) {
        app = this.ResolveApp(app);
        if (app == null || app.canvas == null || rowsBody == null || data == null) { return; }
        Canvas c = app.canvas;
        Theme t = app.theme;
        this.EnsureListPaintStyles(app);
        StyleBox rowNormal = lvRowNorm;
        StyleBox rowSelected = lvRowSel;
        StyleBox rowHover = lvRowHover;
        StyleBox divider = lvDivider;
        StyleBox cell = lvCell;
        StyleBox secondary = lvSecondary;
        StyleBox cellOff = lvCellOff;
        int cellFont = cell.FontOr(Style.FontFallback(app, "small"));
        int secondaryFont = secondary.FontOr(cellFont);
        int cellOffFont = cellOff.FontOr(cellFont);
        int rowH = this.RowHeight(app);
        Rect bodyView = rowsBody.ScrollViewport();
        int viewY = bodyView.y;
        int viewH = bodyView.height;
        if (viewH <= 0 || rowH <= 0) { return; }
        int n = this.Count();
        int contentH = n * rowH;
        int off = rowsBody.ScrollTop();
        bool overflow = contentH > viewH;
        int barW = app.Scale(12);
        int rowW = bodyView.width;
        if (overflow) { rowW = bodyView.width - barW; }
        if (rowW < 0) { rowW = 0; }
        int pad = t.paddingMedium;
        List<int> ws = this.ColumnWidthsBuf(rowW - pad * 2);
        int hotW = rowW;
        if (overflow) { hotW = rowW - app.Scale(4); }
        if (hotW < 0) { hotW = 0; }
        int first = off / rowH;
        if (first < 0) { first = 0; }
        int last = (off + viewH) / rowH;
        if (last >= n) { last = n - 1; }
        bool trivialSelectable = onlySelectable == null && !this.Templated();
        c.PushClip(bodyView.x, viewY, rowW, viewH);
        try {
            int i = first;
            while (i <= last && i < data.Count) {
                int ry = viewY + i * rowH - off;
                bool rowSelectable = trivialSelectable || this.Selectable(i);
                if (i == sel || (multi && this.IsMarked(i))) {
                    c.FillRect(bodyView.x, ry, hotW, rowH, rowSelected.BgOr(rowNormal.BgOr(0)));
                }
                else if (rowSelectable && hover == i) {
                    c.FillRect(bodyView.x, ry, hotW, rowH, rowHover.BgOr(0));
                }
                if (i > first || off > 0) { c.FillRect(bodyView.x, ry, rowW, 1, divider.BgOr(0)); }
                int cx = bodyView.x + pad;
                for (int k = 0; k < ws.Count && cols != null && k < cols.Count; k = k + 1) {
                    int cw = ws[k];
                    StyleBox cs = k > 0 ? secondary : cell;
                    int csFont = k > 0 ? secondaryFont : cellFont;
                    if (!rowSelectable) { cs = cellOff; csFont = cellOffFont; }
                    int ty = Canvas.CenterTextY(ry, rowH, csFont);
                    string s = Ellipsis.Fit(cols[k].TextOf(data[i]), cw - pad,
                                            csFont);
                    int color = cs.FgOr(0);
                    int tx = cx;
                    if (cols[k].right) { tx = cx + cw - pad - Canvas.MeasureText(s, csFont); }
                    c.DrawText(tx, ty, s, color,
                               csFont);
                    cx = cx + cw;
                }
                i = i + 1;
            }
        } finally {
            c.PopClip();
        }
    }
    public void ArrangeRows(int headH) { this.ArrangeRows(this.App, headH); }
    public void ArrangeRows(App app, int headH) {
        app = this.ResolveApp(app);
        if (app == null || app.canvas == null || rowsBody == null) { return; }
        Rect bodyView = rowsBody.ScrollViewport();
        int viewY = bodyView.y;
        int viewH = bodyView.height;
        if (viewH <= 0) { return; }
        int contentH = this.ContentHeight(app);
        int off = rowsBody.ScrollTop();
        bool overflow = contentH > viewH;
        int barW = app.Scale(12);
        int rowW = bodyView.width;
        if (overflow) { rowW = bodyView.width - barW; }
        if (rowW < 0) { rowW = 0; }
        Theme t = app.theme;
        this.EnsureListPaintStyles(app);
        StyleBox rowNormal = lvRowNorm;
        StyleBox rowSelected = lvRowSel;
        StyleBox rowHover = lvRowHover;
        int hotW = rowW;
        if (overflow) { hotW = rowW - app.Scale(4); }
        if (hotW < 0) { hotW = 0; }
        int y = viewY - off;
        for (int i = 0; i < this.Count(); i = i + 1) {
            Control row = this.DataRow(i);
            if (row == null) {
                if (fixedRowHeight > 0) { y = y + this.RowHeight(app); }
                continue;
            }
            int rh = this.RowExtent(app, row);
            bool onscreen = y + rh > viewY && y < viewY + viewH;
            if (onscreen) {
                int id = this.CommonId() + i;
                if (i == sel || (multi && this.IsMarked(i))) {
                    app.canvas.FillRect(bodyView.x, y, hotW, rh,
                        rowSelected.BgOr(rowNormal.BgOr(0)));
                }
                else if (this.Selectable(i) && hover == i) {
                    app.canvas.FillRect(bodyView.x, y, hotW, rh, rowHover.BgOr(0));
                }
            }
            y = y + rh;
        }
    }
    internal override void PaintRowsBody(App app, Rect bodyView) {
        if (this.Templated()) { this.ArrangeRows(app, this.HeaderHeight(app)); }
        else { this.PaintColumnRows(app, this.HeaderHeight(app)); }
    }
    public override void OnPaint(App app) {
        if (app == null || app.canvas == null) { return; }
        this.SyncBinding();
        StyleBox s = this.ResolveStyleCached(app, "list", Class, Style.SNormal());
        if (!Style.Has(Class, "flat") && s.bg != 0) {
            app.canvas.SurfaceRoundRect(bx, by, bw, bh,
                s.RadiusOr(app.theme.borderRadiusMedium),
                s.bg, s.BorderOr(app.theme.borderSecondary), s.BorderWOr(1));
        }
        int headH = this.HeaderHeight(app);
        this.PaintHeader(app, headH);
        if (this.Count() == 0) {
            this.PaintEmpty(app);
            return;
        }
    }
}
