using System;
using Gui;
using Gui.Backend;
namespace Gui.Widget;
[GuiKind("InputOtp")]
public class InputOtp : Control {
    public override Control CreateCloneShell() { return new InputOtp(); }
    private List<string> cells;
    private int active;
    private int length;
    private weak App liveApp;
    public List<Control> cellNodes;
    public List<Label> cellLabels;
    public override int StyleDisplay() { return 1; } // CSS display: flex
    public override int StyleFlexDir() { return 0; } // flex-direction: row
    public Binding<string> Value;
    public Binding<string> Size;
    public bool MaskMode;
    public string MaskChar;
    public bool Block;
    public bool ReadOnly;
    public string FieldStatus;
    public List<int> Groups;
    public string Separator;
    public InputFilterFn Filter;
    public UiEvent Change;
    public UiEvent Complete;
    private bool wasFull;
    private bool completeArmed;
    public static List<string> SplitCps(string s) {
        List<string> outList = new List<string>();
        int i = 0;
        while (i < s.Length) {
            int e = Text.NextCharEnd(s, i);
            outList.Add(s.Substring(i, e - i));
            i = e;
        }
        return outList;
    }
    public static string OnlyLetters(string s) {
        string outStr = "";
        int i = 0;
        while (i < s.Length) {
            int e = Text.NextCharEnd(s, i);
            string ch = s.Substring(i, e - i);
            if (ch.Length == 1) {
                int b = s[i];
                if ((b >= 65 && b <= 90) || (b >= 97 && b <= 122)) { outStr = outStr + ch; }
            }
            i = e;
        }
        return outStr;
    }
    public int SeparatorCount() {
        if (Groups == null || Groups.Count < 2) { return 0; }
        int sum = 0;
        for (int i = 0; i < Groups.Count; i = i + 1) {
            sum = sum + Groups[i];
        }
        if (sum != length) { return 0; }
        return Groups.Count - 1;
    }
    public bool SepAfter(int i) {
        if (this.SeparatorCount() == 0) { return false; }
        int pos = 0;
        for (int g = 0; g < Groups.Count - 1; g = g + 1) {
            pos = pos + Groups[g];
            if (i == pos - 1) { return true; }
        }
        return false;
    }
    public void BuildCells() {
        this.RemoveAll();
        cellNodes = new List<Control>();
        cellLabels = new List<Label>();
        int sepCount = this.SeparatorCount();
        string sep = Separator != "" ? Separator : "-";
        for (int i = 0; i < length; i = i + 1) {
            Control cell = new Control { ClassName = "otp-cell align-center justify-center" };
            Label lbl = new Label("");
            lbl.ClassName = "otp-text";
            cell.Add(lbl);
            cellNodes.Add(cell);
            cellLabels.Add(lbl);
            this.Add(cell);
            if (this.SepAfter(i) && sepCount > 0) {
                Label sepLabel = new Label(sep) { ClassName = "otp-separator" };
                this.Add(sepLabel);
            }
        }
    }
    public void InitOtp(int n) {
        this.InitControl("otp");
        Value = "";
        if (n < 1) { n = 1; }
        length = n;
        cells = new List<string>();
        for (int i = 0; i < length; i = i + 1) { cells.Add(""); }
        active = 0;
        liveApp = null;
        Size = "medium";
        MaskMode = false;
        MaskChar = "";
        Block = false;
        ReadOnly = false;
        FieldStatus = "";
        Groups = new List<int>();
        Separator = "-";
        Filter = null;
        wasFull = false;
        completeArmed = false;
        wiresOwnEvents = true;
        Change = new UiEvent();
        Complete = new UiEvent();
        this.ClassName = "input-otp row align-center";
        this.BuildCells();
    }
    public override int InputFocusCapabilities() { return 3; }
    public InputOtp() { this.InitOtp(6); }
    public InputOtp(int n) { this.InitOtp(n); }
    public void SetLength(int n) {
        if (n < 1) { n = 1; }
        if (n == length) { return; }
        List<string> next = new List<string>();
        for (int i = 0; i < n; i = i + 1) {
            if (i < cells.Count) { next.Add(cells[i]); }
            else { next.Add(""); }
        }
        cells = next;
        length = n;
        if (active > n - 1) { active = n - 1; }
    }
    public int GetLength() { return length; }
    public int ActiveIndex() { return active; }
    public void SetCodeFromModel() { this.SyncBinding(); }
    public string GetCode() {
        string s = "";
        for (int i = 0; i < length; i = i + 1) { s = s + cells[i]; }
        return s;
    }
    public int FilledCount() {
        int n = 0;
        for (int i = 0; i < length; i = i + 1) {
            if (cells[i] != "") { n = n + 1; }
        }
        return n;
    }
    public bool IsFull() { return FilledCount() == length; }
    public bool SetCode(string s) {
        string final = s;
        if (Filter != null) { final = Filter(s); }
        if (final == null) { return false; }
        List<string> cps = InputOtp.SplitCps(final);
        for (int i = 0; i < length; i = i + 1) {
            if (i < cps.Count) { cells[i] = cps[i]; }
            else { cells[i] = ""; }
        }
        active = InputOtp.SplitCps(final).Count;
        if (active > length - 1) { active = length - 1; }
        if (active < 0) { active = 0; }
        return true;
    }
    public bool SetValue(string s) {
        if (this.IsReadOnly()) { return false; }
        string before = this.GetCode();
        if (!this.SetCode(s)) { return false; }
        if (this.GetCode() == before) { return false; }
        this.Edited(true);
        return true;
    }
    public bool IsReadOnly() { return ReadOnly || this.IsDisabled(); }
    public void ClearAll() {
        if (this.IsReadOnly()) { return; }
        if (this.GetCode() == "") { return; }
        for (int i = 0; i < length; i = i + 1) { cells[i] = ""; }
        active = 0;
        this.Edited(false);
        if (liveApp != null) { liveApp.RequestRedraw(); }
    }
    public void Focus() {
        if (liveApp == null || this.IsDisabled()) { return; }
        liveApp.focus.SetFocused(this.WidgetId());
        liveApp.RequestRedraw();
    }
    public void Blur() {
        if (liveApp == null) { return; }
        if (liveApp.focus.IsFocused(this.WidgetId())) { liveApp.focus.ClearFocus(); }
        liveApp.RequestRedraw();
    }
    public void SetStatus(string v) {
        string s = Control.StatusSanitize(v);
        if (s == FieldStatus) { return; }
        FieldStatus = s;
        if (liveApp != null) { liveApp.RequestRedraw(); }
    }
    private void Edited(bool filled) {
        if (Value != null) { Value.Set(this.GetCode()); }
        Change.RaiseS(this);
        bool full = this.IsFull();
        if (full && !wasFull && filled) { Complete.RaiseS(this); }
        wasFull = full;
    }
    public bool TypeChar(string ch) {
        if (this.IsReadOnly() || ch == "") { return false; }
        int next = active;
        if (next > length - 1) { next = length - 1; }
        List<string> cps = InputOtp.SplitCps(ch);
        if (cps.Count == 0) { return false; }
        string before = this.GetCode();
        int idx = next;
        List<string> snapshot = new List<string>();
        for (int i = 0; i < length; i = i + 1) { snapshot.Add(cells[i]); }
        bool didFill = false;
        for (int i = 0; i < cps.Count && idx < length; i = i + 1) {
            if (cells[idx] == "") { didFill = true; }
            cells[idx] = cps[i];
            idx = idx + 1;
        }
        string after = this.GetCode();
        if (Filter != null) {
            string final = Filter(after);
            if (final == null) {
                InputOtp.Restore(cells, snapshot);
                return false;
            }
            if (final == before) {
                InputOtp.Restore(cells, snapshot);
                return false;
            }
            if (!this.SetCode(final)) {
                InputOtp.Restore(cells, snapshot);
                return false;
            }
            if (InputOtp.SplitCps(final).Count > InputOtp.SplitCps(before).Count) { didFill = true; }
            this.Edited(didFill);
            return true;
        }
        if (after == before) { return false; }
        if (idx > length - 1) { idx = length - 1; }
        active = idx;
        this.Edited(didFill);
        return true;
    }
    private static void Restore(List<string> cells, List<string> snapshot) {
        for (int i = 0; i < cells.Count && i < snapshot.Count; i = i + 1) {
            cells[i] = snapshot[i];
        }
    }
    public bool Backspace() {
        if (this.IsReadOnly()) { return false; }
        if (cells[active] != "") {
            cells[active] = "";
        } else if (active > 0) {
            active = active - 1;
            if (cells[active] == "") { return false; }
            cells[active] = "";
        } else {
            return false;
        }
        this.Edited(false);
        return true;
    }
    public bool DeleteForward() {
        if (this.IsReadOnly()) { return false; }
        if (cells[active] == "") { return false; }
        cells[active] = "";
        this.Edited(false);
        return true;
    }
    public void MoveLeft() { if (active > 0) { active = active - 1; } }
    public void MoveRight() { if (active < length - 1) { active = active + 1; } }
    public void MoveHome() { active = 0; }
    public void MoveEnd() {
        int last = 0;
        for (int i = 0; i < length; i = i + 1) {
            if (cells[i] != "") { last = i; }
        }
        active = last;
    }
    public bool Paste(string clip) {
        if (this.IsReadOnly() || clip == "") { return false; }
        return this.TypeChar(clip);
    }
    private bool HandleKeyEvent(App app, int kind, int code, int mods) {
        if (kind == 6) {
            if (ReadOnly) { return false; }
            if (code == 8) {
                if (this.Backspace()) { app.RequestRedraw(); }
                return true;
            } else if (code == 9) {
            } else {
                string ch = Text.CharStr(code);
                if (ch.Length > 0) {
                    if (this.TypeChar(ch)) { app.RequestRedraw(); }
                    return true;
                }
            }
        } else if (kind == 4) {
            int kc = code;
            if (Modifiers.HasCtrl(mods)) {
                if (kc == 86) {
                    if (ReadOnly) { return false; }
                    string clip = Clipboard.GetText();
                    if (clip.Length > 0 && this.Paste(clip)) { app.RequestRedraw(); }
                    return true;
                } else if (kc == 65) {
                    this.MoveHome();
                    app.RequestRedraw();
                    return true;
                }
                return false;
            }
            if (kc == 37) { this.MoveLeft(); app.RequestRedraw(); return true; }
            else if (kc == 39) { this.MoveRight(); app.RequestRedraw(); return true; }
            else if (kc == 46) {
                if (ReadOnly) { return false; }
                if (this.DeleteForward()) { app.RequestRedraw(); }
                return true;
            }
            else if (kc == 36) { this.MoveHome(); app.RequestRedraw(); return true; }
            else if (kc == 35) { this.MoveEnd(); app.RequestRedraw(); return true; }
        }
        return false;
    }
    private void HandleRoutedKey(RoutedEventArgs e, int kind) {
        if (e.handled || this.IsDisabled()) { return; }
        App app = this.FindApp();
        if (app == null) { app = liveApp; }
        if (app == null || !this.IsFocused(app)) { return; }
        liveApp = app;
        this.SyncBinding();
        if (this.HandleKeyEvent(app, kind, e.keyCode, e.modifiers)) { e.Handle(); }
    }
    public override void OnKeyDown(RoutedEventArgs e) { this.HandleRoutedKey(e, 4); }
    public override void OnKeyUp(RoutedEventArgs e) { this.HandleRoutedKey(e, 5); }
    public override void OnTextInput(RoutedEventArgs e) { this.HandleRoutedKey(e, 6); }
    public string CellDisplay(int i) {
        string v = cells[i];
        if (v != "" && MaskMode) {
            string mc = MaskChar;
            if (mc == "") { mc = "•"; }
            return mc;
        }
        return v;
    }
    public override void SyncBinding() {
        base.SyncBinding();
        liveApp = this.FindApp();
        if (Value != null) {
            string cur = Value.Get();
            if (cur != this.GetCode()) {
                int wantActive = active;
                this.SetCode(cur);
                active = wantActive;
                if (active > length - 1) { active = length - 1; }
            }
        }
        if (cellNodes != null && cellLabels != null) {
            for (int i = 0; i < length && i < cellLabels.Count; i = i + 1) {
                cellLabels[i].Text = this.CellDisplay(i);
                if (i == active) {
                    cellNodes[i].AddClass("focused");
                } else {
                    cellNodes[i].RemoveClass("focused");
                }
            }
        }
    }
    public override void CloneContentTo(Control target, CloneTreeFn clone) {
    }
    public override string Kind() { return "InputOtp"; }
    public override Binding<string> SizeOf() { return Size; }
    protected override List<PropSpec> DefineProps() {
        List<PropSpec> ps = new List<PropSpec>();
        ps.Add(PropSpec.Text("value", "Value").DefaultBinding().ViaExtra());
        ps.Add(PropSpec.Int("length", "Length").Field("length", 1).Step(1, 1, 32));
        PropSpec sz = PropSpec.Enum("size", "Size",
            PropSpec.Sizes());
        sz.Field("Size", 0);
        ps.Add(sz);
        ps.Add(PropSpec.Bool("mask", "Mask").Field("MaskMode", 2));
        ps.Add(PropSpec.Bool("block", "Block").Field("Block", 2));
        ps.Add(PropSpec.Bool("readonly", "ReadOnly").Field("ReadOnly", 2));
        PropSpec st = PropSpec.Enum("status", "Status",
            new List<string>{ "", "success", "warning", "error" });
        st.Field("FieldStatus", 0);
        ps.Add(st);
        ps.Add(PropSpec.Text("separator", "Separator").Field("Separator", 0));
        return ps;
    }
    public override string GetExtra(string key) {
        if (key == "value" || key == "code") { return this.GetCode(); }
        if (key == "maskChar") { return MaskChar; }
        if (key == "groups") {
            string s = "";
            if (Groups != null) {
                for (int i = 0; i < Groups.Count; i = i + 1) {
                    if (s != "") { s = s + ","; }
                    s = s + Convert.ToString(Groups[i]);
                }
            }
            return s;
        }
        return "";
    }
    public override bool SetExtra(string key, string val) {
        if (key == "value" || key == "code") {
            if (val != this.GetCode()) { return this.SetValue(val); }
            return true;
        }
        if (key == "maskChar") { MaskChar = val; return true; }
        if (key == "groups") {
            Groups = new List<int>();
            int i = 0;
            while (i < val.Length) {
                int j = i;
                while (j < val.Length && val[j] >= 48 && val[j] <= 57) {
                    j = j + 1;
                }
                if (j > i) {
                    int v = 0;
                    for (int k = i; k < j; k = k + 1) {
                        v = v * 10 + (val[k] - 48);
                    }
                    Groups.Add(v);
                }
                i = j + 1;
            }
            return true;
        }
        return false;
    }
    public override List<string> Events() {
        List<string> e = Control.CommonEvents();
        e.Add("Change");
        e.Add("Complete");
        return e;
    }
    public override void BindEvent(string evt, Action a) {
        if (evt == "Change") { Change.Add(a); return; }
        if (evt == "Complete") { Complete.Add(a); return; }
        base.BindEvent(evt, a);
    }
    public override void BindEventS(string evt, ControlEvent a) {
        if (evt == "Change") { Change.AddS(a); return; }
        if (evt == "Complete") { Complete.AddS(a); return; }
        base.BindEventS(evt, a);
    }
}
