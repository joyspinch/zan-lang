using System;
using Gui;
namespace Gui.Widget;
public class Badge : Control {
    public override Control CreateCloneShell() { return new Badge(); }
    public int Count;
    public int Max;
    public Binding<string> Size;
    private Label labelNode;
    public override int StyleDisplay() { return 1; } // CSS display: flex
    public override int StyleFlexDir() { return 0; } // flex-direction: row
    private void InitBadge(int n) {
        this.InitControl("badge");
        Count = n;
        Max = 99;
        Class = "error";
        Size = "medium";
        this.RebuildBadge();
    }
    public Badge() { InitBadge(0); }
    public Badge(int n) { InitBadge(n); }
    public string Label() {
        if (Count <= 0) { return ""; }
        if (Count > Max) { return Convert.ToString(Max) + "+"; }
        return Convert.ToString(Count);
    }
    public void SetCount(int n) {
        Count = n;
        this.RebuildBadge();
        this.RequestRedraw();
    }
    public void RebuildBadge() {
        this.RemoveAll();
        string text = this.Label();
        if (text != "") {
            labelNode = new Label(text);
            labelNode.ClassName = "badge-text";
            this.Add(labelNode);
            this.RemoveClass("dot");
        } else {
            this.AddClass("dot");
        }
    }
    public override void CloneContentTo(Control target, CloneTreeFn clone) {
    }

    public override Binding<string> SizeOf() { return Size; }

    // 圆点形态：计数归零即显示圆点；关掉圆点时至少显示 1。
    public bool Dot {
        get { return Count <= 0; }
        set {
            if (value) { this.SetCount(0); }
            else if (Count <= 0) { this.SetCount(1); }
        }
    }

    protected override List<PropSpec> DefineProps() {
        List<PropSpec> ps = new List<PropSpec>();
        ps.Add(PropSpec.Int("count", "Count").DefaultBinding().Field("Count"));
        ps.Add(PropSpec.BoolField("Dot"));
        ps.Add(PropSpec.IntField("Max"));
        ps.Add(this.SizeProp());
        return ps;
    }

    public override void SyncBinding() {
        base.SyncBinding();
        this.ApplySizeClass();
    }
}
