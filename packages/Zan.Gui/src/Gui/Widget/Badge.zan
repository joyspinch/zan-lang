using System;
using Gui;

namespace Gui.Widget;

// 徽标组件：纯 Flex 居中容器，支持圆点与数字角标声明式展示。
// 外壳与圆角完全由 CSS 盒模型驱动，彻底物理消除手绘坐标与静态微绘函数。
public class Badge : Control {
    public int Count;
    public int Max;
    public Binding<string> Size;

    private Label labelNode;

    public override int StyleDisplay() { return 1; } // CSS display: flex
    public override int StyleFlexDir() { return 0; } // flex-direction: row

    private void InitBadge(int n) {
        this.InitControl("badge", 1);
        Count = n;
        Max = 99;
        Class = "error";
        Size = "medium";
        this.RebuildBadge();
    }

    public Badge() { InitBadge(0); }
    public Badge(int n) { InitBadge(n); }

    public string Label() {
        if (Count <= 0) { return ""; }
        if (Count > Max) { return Convert.ToString(Max) + "+"; }
        return Convert.ToString(Count);
    }

    public void SetCount(int n) {
        Count = n;
        this.RebuildBadge();
        App a = this.FindApp();
        if (a != null) { a.RequestRedraw(); }
    }

    public void RebuildBadge() {
        this.children.Clear();
        string text = this.Label();
        if (text != "") {
            labelNode = new Label(text);
            labelNode.ClassName = "badge-text";
            this.Add(labelNode);
            this.RemoveClass("dot");
        } else {
            this.AddClass("dot");
        }
    }

    public override void CloneContentTo(Control target, CloneTreeFn clone) {
        // Constructor and property replay recreate the generated parts.
    }

    public override string Kind() { return "Badge"; }
    public override Binding<string> SizeOf() { return Size; }

    public override List<PropSpec> Props() {
        List<PropSpec> ps = new List<PropSpec>();
        PropSpec count = PropSpec.Int("count", "Count");
        count.num = Count;
        ps.Add(count);
        PropSpec max = PropSpec.Int("max", "Max");
        max.num = Max;
        ps.Add(max);
        ps.Add(this.SizeProp());
        return ps;
    }

    public override void SyncBinding() {
        base.SyncBinding();
        this.ApplySizeClass();
    }
}
