using System;
using Gui;

namespace Gui.Widget;

// 标题和正文。与 Label 形状相同——简单赋值，
// 字号和颜色都是皮肤无需一行代码即可重设的类：
// 类：`h1` … `h6` 是标题级别，`paragraph` 是正文，
// `secondary` / `hint` / `inverse` 以及语义角色（`primary` … `error`）
// 决定颜色。文本由 Label 绘制，因此 `label` 规则同样作用于
// 这些控件。
public class Typography : Control {
    // 文本内容（可绑定）。
    public Binding<string> Text;

    // 初始化：以文本注册为控件并绑定文本。
    private void InitTypography(string txt) {
        this.InitControl(txt, 1);
        Text = txt;
    }

    // 空文本（设计器用）。
    public Typography() { InitTypography(""); }
    // 给定初值文本。
    public Typography(string txt) { InitTypography(txt); }

    // 当前文本（通过绑定解析）。
    public string Str() {
        if (Text == null) { return ""; }
        return Text.Get();
    }

    // 文本通道走 Text 绑定：不触发基类 SetProp 的 syncName（"标题即名"
    // 是设计器初始化语义，运行期数据推送不得覆盖寻址名）。
    public override string GetProp(string key) {
        if (key == "text") { return this.Str(); }
        return base.GetProp(key);
    }

    public override void SetProp(string key, string val) {
        if (key == "text") {
            if (Text == null) { Text = val; }
            else { Text.Set(val); }
            return;
        }
        base.SetProp(key, val);
    }

    // 标题级别（1..6）对应的类。
    public static string HeadingClass(int level) {
        switch (level) {
            case 2: return "h2";
            case 3: return "h3";
            case 4: return "h4";
            case 5: return "h5";
            case 6: return "h6";
            default: return "h1";
        }
    }

    // `Typography.H("Title", 2)` —— 该级别的标题。
    public static Typography H(string txt, int level) {
        Typography t = new Typography(txt);
        t.Class = Typography.HeadingClass(level);
        return t;
    }

    // `Typography.P("Body copy")` —— 一个段落。
    public static Typography P(string txt) {
        Typography t = new Typography(txt);
        t.Class = "paragraph";
        return t;
    }

    // 按 label 设置样式，因此 `label.h2` 和 `label.paragraph` 是选择器，
    // 皮肤的文本规则同时作用于标题和正文。
    public override string StyleType() { return "label"; }

    // 按 "label" 规则解析并缓存的样式盒（Class 提供 h1..h6/paragraph 级别）。
    public StyleBox ResolvedStyle(App app) {
        return this.ResolveStyleCached(app, "label", Class, Style.SNormal());
    }

    // 覆写：按样式字号量出行高与文本宽度。
    public override void OnMeasure(App app) {
        int fs = this.ResolvedStyle(app).FontOr(
            Style.FontFallback(app, "medium"));
        prefH = Canvas.FontHeight(fs) + app.theme.gapSmall;
        prefW = Canvas.MeasureText(this.Str(), fs);
    }

    // 覆写：按 `label` 规则的样式绘制文本。
    public override void OnPaint(App app) {
        StyleBox s = this.BoxState(app, Style.SNormal());
        app.canvas.DrawStyledText(
            s,
            bx, by, this.Str(),
            s.FgOr(0), Style.FontFallback(app, "medium"));
    }

    // 立即模式标题；返回其占用的行高。
    public static int Heading(App app, int x, int y, string text, int level) {
        string cls = Typography.HeadingClass(level);
        StyleBox s = Style.Of(app, "label", cls, Style.SNormal());
        app.canvas.DrawStyledText(s, x, y, text, s.FgOr(0),
                                  Style.FontFallback(app, "medium"));
        return Canvas.FontHeight(s.FontOr(Style.FontFallback(app, "huge")));
    }

    // 立即模式段落；返回其占用的行高。
    public static int Paragraph(App app, int x, int y, string text) {
        StyleBox s = Style.Of(app, "label", "paragraph", Style.SNormal());
        app.canvas.DrawStyledText(s, x, y, text, s.FgOr(0),
                                  Style.FontFallback(app, "medium"));
        return Canvas.FontHeight(s.FontOr(Style.FontFallback(app, "medium")));
    }

    // ---- 设计器 / 序列化模型 -------------------------------------

    // 控件类型标识（序列化/设计器用）。
    public override string Kind() { return "Typography"; }

    // 覆写：返回设计器属性清单（text）。
    public override List<PropSpec> Props() {
        List<PropSpec> ps = new List<PropSpec>();
        PropSpec text = PropSpec.Text("text", "Text");
        text.str = Text;
        text.AsName();
        ps.Add(text);
        return ps;
    }
}