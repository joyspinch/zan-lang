using System;
using Gui;
namespace Gui.Widget;
public class IconView : Control {
    public override Control CreateCloneShell() { return new IconView(); }
    public string Name;
    public string Icon {
        get { return Name; }
        set { Name = value != null ? value : ""; }
    }
    public string Content {
        get { return Name; }
        set { Name = value != null ? value : ""; }
    }
    public int Box;
    public int Color;
    private string cachedRawName;
    private string cachedSvgName;
    protected override bool UsesBaseFlowOnly() { return this.Kind() == "IconView"; }
    protected override bool UsesBaseSyncBinding() { return this.Kind() == "IconView"; }
    private void InitIconView(string name, int box, int color) {
        this.InitControl("iconview");
        styleSurfaceOwned = true;
        Name = name != null ? name : "";
        Box = box;
        Color = color;
    }
    public IconView() { InitIconView("", 20, 0); }
    public IconView(string name) { InitIconView(name, 20, 0); }
    public IconView(string name, int box) { InitIconView(name, box, 0); }
    public IconView(string name, int box, int color) { InitIconView(name, box, color); }
    private int BoxPixels(App app) {
        if (app == null) { return Box > 0 ? Box : 20; }
        if (Class != null && Class.Length >= 11 && parent != null && Style.Has(Class, "button-icon")) {
            string cls = parent.EffectiveClass();
            if (Style.Has(cls, "tiny") || Style.Has(cls, "small")) { return app.theme.iconSizeSmall; }
            if (Style.Has(cls, "large")) { return app.theme.iconSizeLarge; }
            return app.theme.iconSizeMedium;
        }
        if (Box == 20 && computedStyle != null) {
            if (computedStyle.width > 0) { return computedStyle.width; }
            if (computedStyle.height > 0) { return computedStyle.height; }
            if (computedStyle.fontPx > 0) { return computedStyle.fontPx; }
        }
        int d = app.Scale(Box);
        return d > 0 ? d : app.Scale(20);
    }
    public override void OnMeasure(App app) {
        if (app == null) { return; }
        int d = this.BoxPixels(app);
        prefW = d;
        prefH = d;
    }
    protected override bool PaintWithinBounds() { return this.Kind() == "IconView"; }
    public override void OnPaint(App app) {
        if (app == null || app.canvas == null) { return; }
        if (bw <= 0 || bh <= 0) { return; }
        StyleBox style = paintedStyle != null ? paintedStyle : this.Box(app);
        int spinDeg = 0;
        if (style != null) {
            int fullDeg = style.SpinDeg(app, bx, by, bw, bh);
            spinDeg = style.layerTransformOwned ? (fullDeg - style.rotate) : fullDeg;
            if (style.bg != 0 || style.bgTo != 0 || style.borderW > 0
                || style.shadow != 0 || style.blur > 0 || style.anim != 0) {
                style.Paint(app, bx, by, bw, bh);
            }
        }
        int d = this.BoxPixels(app);
        if (d > bw) { d = bw; }
        if (d > bh) { d = bh; }
        int fg = Color;
        if (fg == 0) {
            fg = this.PaintedForeground(style, "button-icon");
            if (fg == 0) { fg = app.theme.textPrimary; }
        }
        string iconName = Name != null ? Name : "";
        string drawName;
        if (cachedRawName == iconName && cachedSvgName != null) {
            drawName = cachedSvgName;
        } else {
            drawName = Gui.Icon.SvgName(iconName);
            if (drawName == "") { drawName = iconName; }
            cachedRawName = iconName;
            cachedSvgName = drawName;
        }
        if ((spinDeg % 360) != 0 && app.canvas.PushLayer(bx, by, bw, bh, 1000, 1000, spinDeg)) {
            try {
                IconSvg.Draw(app.canvas, drawName, (bw - d) / 2, (bh - d) / 2, d, fg);
            } finally {
                app.canvas.PopLayer();
            }
            return;
        }
        IconSvg.Draw(app.canvas, drawName, bx + (bw - d) / 2, by + (bh - d) / 2,
            d, fg);
    }
    // ---- 设计器 / 序列化模型 -------------------------------------

    // 覆写：返回设计器属性清单（图标名 / 边长 / 颜色 / 类）。
    protected override List<PropSpec> DefineProps() {
        List<PropSpec> ps = new List<PropSpec>();
        ps.Add(PropSpec.TextField("Name").Also("icon").Also("content"));
        ps.Add(PropSpec.IntField("Box"));
        ps.Add(PropSpec.IntField("Color"));
        return ps;
    }
}
