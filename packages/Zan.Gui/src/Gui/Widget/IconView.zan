using System;
using Gui;

namespace Gui.Widget;

// SVG 图标控件：把 IconSvg 的具名图标当作一个可嵌套的控件放进
// Flex/Panel 组件树，交给布局测量与排列，而不是在 OnPaint 里逐个
// 手绘定位。名字用 Tabler 原名（完整清单见 IconSvg.Names()），
// Box 是图标边长（CSS px）；Color 为 0 时取样式前景色，再退到
// 主题主文字色。
public class IconView : Control {
    // Tabler 图标名；未知名字静默不画（与 IconSvg.Draw 一致）。
    public string Name;
    // 图标名的语义别名：`icon.Icon = "star"` 与 `icon.Name = "star"`
    // 同一真相（Name 是 IconSvg 的底层字段名，Icon 是控件语义名）。
    public string Icon {
        get { return Name; }
        set { Name = value; }
    }
    // 图标边长（CSS px）。
    public int Box;
    // ARGB 覆盖色；0 = 跟随样式前景色 / 主题文字色。
    public int Color;

    // 初始化：图标名、边长与覆盖色；表面自绘（不铺样式底）。
    private void InitIconView(string name, int box, int color) {
        this.InitControl("iconview", 1);
        // 图标本身透明无边框：表面由本控件全权负责（什么都不铺），
        // 框架若代铺样式面会把图标衬进一块实心底。
        styleSurfaceOwned = true;
        Name = name;
        Box = box;
        Color = color;
    }
    // 无名图标（之后设 Name；设计器用）。
    public IconView() { InitIconView("", 20, 0); }
    // 默认 20px 边长。
    public IconView(string name) { InitIconView(name, 20, 0); }
    // 指定边长（CSS px）。
    public IconView(string name, int box) { InitIconView(name, box, 0); }
    // 指定边长与覆盖色（0 = 跟随样式前景色 / 主题文字色）。
    public IconView(string name, int box, int color) { InitIconView(name, box, color); }

    private int BoxPixels(App app) {
        if (Style.Has(Class, "button-icon") && parent != null) {
            string cls = parent.EffectiveClass();
            if (Style.Has(cls, "tiny") || Style.Has(cls, "small")) { return app.theme.iconSizeSmall; }
            if (Style.Has(cls, "large")) { return app.theme.iconSizeLarge; }
            return app.theme.iconSizeMedium;
        }
        int d = app.Scale(Box);
        return d > 0 ? d : app.Scale(20);
    }

    // 测量和绘制共用同一边长。显式 IconView 仍按 Box 缩放。
    public override void OnMeasure(App app) {
        int d = this.BoxPixels(app);
        prefW = d;
        prefH = d;
    }

    // 覆写：盒内居中画图标；颜色取覆盖色，其次样式前景色，再退主题文字色。
    public override void OnPaint(App app) {
        if (bw <= 0 || bh <= 0) { return; }
        int d = this.BoxPixels(app);
        // 不越过布局分配的边界，在盒内居中。
        if (d > bw) { d = bw; }
        if (d > bh) { d = bh; }
        int fg = Color;
        if (fg == 0) {
            StyleBox style = paintedStyle != null ? paintedStyle : this.Box(app);
            fg = style.FgOr(0);
            if (!style.foregroundDeclared && Style.Has(Class, "button-icon")
                && parent != null && parent.paintedStyle != null) {
                fg = parent.paintedStyle.FgOr(fg);
            }
            if (fg == 0) { fg = app.theme.textPrimary; }
        }
        IconSvg.Draw(app.canvas, Name, bx + (bw - d) / 2, by + (bh - d) / 2,
            d, fg);
    }

    // ---- 设计器 / 序列化模型 -------------------------------------

    // 控件类型标识（序列化/设计器用）。
    public override string Kind() { return "IconView"; }

    // 覆写：返回设计器属性清单（图标名 / 边长 / 颜色 / 类）。
    protected override List<PropSpec> DefineProps() {
        List<PropSpec> ps = new List<PropSpec>();
        PropSpec name = PropSpec.Text("name", "Name");
        name.Field("Name", 0);
        name.Also("icon");
        ps.Add(name);
        PropSpec box = PropSpec.Int("box", "Box");
        box.Field("Box", 1);
        ps.Add(box);
        PropSpec color = PropSpec.Int("color", "Color");
        color.Field("Color", 1);
        ps.Add(color);
        return ps;
    }
}
