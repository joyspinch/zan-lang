using System;
using Gui;

namespace Gui.Widget;

public class RadioGroup : ChoiceGroup {
    // 组真相：当前选中选项的 value。
    public SignalInt model;
    // 组级双向绑定：写的是选中选项的 value（越界/禁用的值不生效）。
    public Binding<int> data;
    // 连体按钮段形态开关：true 时子项是段形态 Radio（`radiobutton`
    // 样式族），false 是圆点 Radio。两种形态同一套子项管理。
    public Binding<bool> Buttons;
    // 尺寸档位（Naive UI size prop）。
    public Binding<string> Size;

    // 覆写：返回 Size 绑定字段（设计器经它发现尺寸档位绑定）。
    public override Binding<string> SizeOf() { return Size; }

    // 与 children 对齐的选项元数据实体列表（消除 optionValues / optionDisabled 平行列表反模式）。
    private List<RadioOptionMeta> optionMetas;
    // 组事件：任一选项被用户切换时触发。
    public UiEvent Change;

    // 构造：默认选中 value 0（第 0 项）。
    public RadioGroup() {
        this.InitChoice();
        this.model = new SignalInt(0);
        this.optionMetas = new List<RadioOptionMeta>();
        this.Buttons = false;
        this.Size = "medium";
        this.Change = new UiEvent();
    }

    // 选中信号。默认形态（圆点）且未设自定义 value 时与
    // `SelectedIndex()` 等价（value = 下标）；组真相始终是它，
    // 用 `SelectedValue()` / `SetSelectedValue()` 读写更稳。
    public SignalInt Selected() { return this.model; }

    // 当前选中的选项 value（= model 现值）。
    public int SelectedValue() { return this.model.Get(); }

    // 当前选中项的下标；model 值没有对应选项时回退：value 走
    // 下标语义（没有任何自定义 value）则 model 现值就是下标，
    // 越界时收进最后一项；自定义 value 而无匹配才是 -1。
    public int SelectedIndex() {
        int v = this.model.Get();
        for (int i = 0; i < this.optionMetas.Count; i = i + 1) {
            if (this.optionMetas[i].value == v) { return i; }
        }
        if (this.optionMetas.Count == 0) { return 0 - 1; }
        bool custom = false;
        for (int i = 0; i < this.optionMetas.Count; i = i + 1) {
            if (this.optionMetas[i].value != i) { custom = true; }
        }
        if (!custom) {
            if (v >= 0 && v < this.optionMetas.Count) { return v; }
            return this.optionMetas.Count - 1;
        }
        return 0 - 1;
    }

    // value 对应的选项下标；无此 value 时 -1。
    public int IndexOfValue(int v) {
        for (int i = 0; i < this.optionMetas.Count; i = i + 1) {
            if (this.optionMetas[i].value == v) { return i; }
        }
        return 0 - 1;
    }

    // 程序化选中（静默：不触发组 Change，与 SetChecked 一族一致）。
    // 没有对应选项或选项被禁用时为无操作。
    public void SetSelectedValue(int v) {
        int i = this.IndexOfValue(v);
        if (i < 0) { return; }
        if (i < this.optionMetas.Count && this.optionMetas[i].disabled) { return; }
        if (this.model.Get() == v) { return; }
        this.model.Set(v);
        if (data != null) { data.Set(v); }
    }

    // 程序化选中第 index 个选项（静默）。越界 / 禁用无操作。
    public void SetSelectedIndex(int index) {
        if (index < 0 || index >= this.optionMetas.Count) { return; }
        if (index < this.optionMetas.Count && this.optionMetas[index].disabled) { return; }
        this.SetSelectedValue(this.optionMetas[index].value);
    }

    // 追加一个带自定义 value 的选项（Element Plus options 的对应物；
    // 只给 label 的旧重载 `AddOption(text)` 继承基类，value = 下标）。
    public Control AddOption(string text, int value) {
        return this.AddOption(text, value, false);
    }

    // 追加带 value 与禁用位的选项（元数据入列后交基类构造控件）。
    public Control AddOption(string text, int value, bool disabled) {
        if (text == "") { return null; }
        // 元数据入列后再交给基类：基类 AddOption 只做 MakeItem +
        // labels/children 对齐，MakeItem 里按下标取这里的值。
        this.optionMetas.Add(new RadioOptionMeta(value, disabled));
        Control item = base.AddOption(text);
        return item;
    }

    // 用显式元数据一次性追加一批选项：调用方把自己的记录投影成
    // RadioOption 列表（label-field/value-field 的显式对应物）。
    public void SetOptions(List<RadioOption> opts) {
        for (int i = 0; i < opts.Count; i = i + 1) {
            RadioOption o = opts[i];
            int v = o.hasValue ? o.value : this.children.Count;
            Control item = this.AddOption(o.label, v, o.disabled);
            if (item != null && o.cls != "") { item.AddClass(o.cls); }
        }
    }

    // 每帧（测量/绘制入口）把组级状态同步进选项：data -> model 拉取、
    // 子控件的 value/disabled 元数据下发、尺寸类下发；按钮形态还要
    // 保证段列表与组选项一致并写 seams（行首/行尾）。
    public void SyncGroup() {
        // 文本/JSON 路径（SetOptionsText）只经基类 AddOption，元数据
        // 在这里补齐：value = 下标、不禁用。
        while (this.optionMetas.Count < this.children.Count) {
            this.optionMetas.Add(new RadioOptionMeta(this.optionMetas.Count, false));
        }
        if (data != null) {
            int cur = data.Get();
            if (cur != this.model.Get()) {
                int i = this.IndexOfValue(cur);
                bool ok = this.children.Count == 0;
                if (i >= 0 && i < this.optionMetas.Count
                    && !this.optionMetas[i].disabled) { ok = true; }
                if (ok) { this.model.Set(cur); }
                else {
                    // 绑定字段里是脏值（无此选项/禁用）：回写 model 现值。
                    data.Set(this.model.Get());
                }
            }
        }
        string sizeCls = Control.SizeClass(this.Size.Get());
        bool segForm = this.Buttons.Get();
        for (int i = 0; i < this.children.Count; i = i + 1) {
            Control c = this.children[i];
            if (!(c is Radio)) { continue; }
            Radio r = (Radio)c;
            if (i < this.optionMetas.Count) {
                r.optionValue = this.optionMetas[i].value;
                r.Disabled = this.optionMetas[i].disabled;
            }
            if (sizeCls != "") { r.AddClass(sizeCls); }
            if (segForm) {
                // 连体段接缝：首段恢复左边框、尾段收外侧圆角
                // （`rb-first`/`rb-last` 类，CSS 段规则配套）。
                if (i == 0) { r.AddClass("rb-first"); } else { r.RemoveClass("rb-first"); }
                if (i == this.children.Count - 1) { r.AddClass("rb-last"); } else { r.RemoveClass("rb-last"); }
            }
        }
    }

    // 第 i 个选项的 value（缺元数据时 = 下标）。
    private int valueAt(int i) {
        if (i < this.optionMetas.Count) { return this.optionMetas[i].value; }
        return i;
    }
    // 第 i 个选项是否禁用（缺元数据 false）。
    private bool optionDisabledAt(int i) {
        if (i < this.optionMetas.Count) { return this.optionMetas[i].disabled; }
        return false;
    }

    // 用户切换后把 model 现值回写组级绑定。
    private void PushValue() {
        if (data != null) { data.Set(this.model.Get()); }
    }

    // 清空全部选项（两种形态共用）：用于从文本/JSON 重建选项；
    // 覆写基类以连元数据一起清。
    public override void ClearOptions() {
        this.children.Clear();
        this.labels.Clear();
        this.optionMetas.Clear();
    }

    // 覆写：为下标造一个 Radio（段形态跟组开关，写选项 value，禁用位
    // 与组 Change 冒泡），并把落后的元数据列表就地补齐。
    public override Control MakeItem(int index, string text) {
        // 基类 AddOption 先 MakeItem 再挂子项；子类三参 AddOption 已把
        // 元数据入列，基类单参路径（SetOptionsText）则没有——落后的
        // 下标就地补一条默认元数据（value = 下标、不禁用），此后所有
        // 路径的 optionMetas 都与 children 对齐。
        while (this.optionMetas.Count <= index) {
            this.optionMetas.Add(new RadioOptionMeta(this.optionMetas.Count, false));
        }
        Radio r = new Radio(this.model, this.optionMetas[index].value, text,
            this.Buttons.Get());
        r.Disabled = this.optionMetas[index].disabled;
        // 组级联动经 OnChildEvent 冒泡（见下），不再挂捕获组的闭包
        // ——组→子→事件表→闭包→组是 ARC 不回收的引用环。
        return r;
    }

    // 子项用户切换冒泡（Control.OnChildEvent）：先同步组级绑定，
    // 再触发组 Change——与旧闭包接线同序。
    public override void OnChildEvent(Control child, string evt) {
        if (evt == "Change") {
            this.PushValue();
            this.Change.RaiseS(this);
        }
    }

    // 覆写：先同步组状态；两种形态都是真实子控件，排布走基类。
    public override void OnMeasure(App app) {
        this.SyncGroup();
        base.OnMeasure(app);
    }

    // 覆写：先同步组状态，绘制/命中走基类轨道（段的绘制/命中是
    // 子控件自己的 OnPaint）。
    public override void OnPaint(App app) {
        this.SyncGroup();
        base.OnPaint(app);
    }

    // 设计器写入 `type`/`buttons`（切换按钮段/圆点形态）与 `size`；
    // 其余交给基类。
    public override bool SetExtra(string key, string val) {
        if (key == "type" || key == "buttons") {
            bool want = val == "button" || val == "buttons" || val == "true";
            if (want != this.Buttons.Get()) {
                this.Buttons.Set(want);
                // 形态切换：children 按新形态整体重建（圆点=圆环+标签，
                // 段=单标签），labels 与元数据不动。
                this.children.Clear();
                for (int i = 0; i < this.labels.Count; i = i + 1) {
                    this.Add(this.MakeItem(i, this.labels[i]));
                }
            }
            return true;
        }
        return base.SetExtra(key, val);
    }

    // 设计器读取 `type`（按钮形态返回 "button"）与 `size`；
    // 其余交给基类。
    public override string GetExtra(string key) {
        if (key == "type") {
            if (this.Buttons.Get()) { return "button"; }
            return "";
        }
        return base.GetExtra(key);
    }

    // 选项文本带禁用位：`A|B!|C` 的 `!` 后缀把 B 标成不可点
    // （与 optionMetas 元数据一一对应）。
    public override string OptionsText() {
        string outp = "";
        for (int i = 0; i < this.labels.Count; i = i + 1) {
            if (i > 0) { outp = outp + "|"; }
            outp = outp + this.labels[i];
            if (i < this.optionMetas.Count && this.optionMetas[i].disabled) {
                outp = outp + "!";
            }
        }
        return outp;
    }

    // 按 `A|B!|C` 或 JSON 数组重建：尾缀 `!` 的项以禁用位入列
    // （value = 下标，与文本路径的既定语义一致）。
    public override void SetOptionsText(string text) {
        if (text == null || text.Length == 0) { return; }
        string s = text.Trim();
        if (s.StartsWith("[") && s.EndsWith("]")) {
            JsonValue arr = JsonValue.ParseLenient(s);
            if (arr != null && arr.IsArray()) {
                for (int i = 0; i < arr.Count(); i = i + 1) {
                    JsonValue it = arr.At(i);
                    if (it == null) { continue; }
                    if (it.IsObject()) {
                        string lbl = it.Str("label", "");
                        if (lbl == "") { lbl = it.Str("name", ""); }
                        if (lbl == "") { lbl = it.Str("title", ""); }
                        if (lbl == "") { lbl = it.Str("text", ""); }
                        int val = it.Int("value", this.children.Count);
                        bool dis = it.Bool("disabled", false);
                        this.AddOption(lbl, val, dis);
                    } else {
                        this.AddOption(it.AsString(""), this.children.Count, false);
                    }
                }
                return;
            }
        }
        List<string> parts = text.Split("|");
        for (int i = 0; i < parts.Count; i = i + 1) {
            string current = parts[i];
            bool dis = false;
            if (current.EndsWith("!")) {
                dis = true;
                current = current.Substring(0, current.Length - 1);
            }
            this.AddOption(current, this.children.Count, dis);
        }
    }

    // 覆写：基类清单之外追加 buttons/size/value（value 优先指向
    // 活的外部绑定）。
    public override List<PropSpec> Props() {
        List<PropSpec> ps = base.Props();
        PropSpec btn = PropSpec.Bool("buttons", "Buttons");
        btn.flag = Buttons;
        btn.WithTip("Button-style radio group (Element Plus radio-button)");
        ps.Add(btn);
        PropSpec sz = PropSpec.Enum("size", "Size",
            PropSpec.Sizes());
        sz.str = Size;
        ps.Add(sz);
        // 属性通道优先指向活的外部绑定（§6.1 单协议）。
        PropSpec val = PropSpec.Int("value", "Selected");
        if (data != null) { val.num = data; } else { val.snum = model; }
        val.Also("data");
        ps.Add(val);
        return ps;
    }

    // 覆写："Change" 挂组事件，其余按名称走通用路由。
    public override void BindEvent(string evt, Action a) {
        if (evt == "Change") { Change.Add(a); return; }
        On.AddByName(evt, a);
    }

    // <see cref="BindEvent"/> 的 sender 通道（S = Sender）：
    // 特化事件接本控件的 UiEvent，通用事件按名路由。
    public override void BindEventS(string evt, ControlEvent a) {
        if (evt == "Change") { Change.AddS(a); return; }
        On.AddByNameS(evt, a);
    }


    // 覆写：公共事件之外提供 "Change"。
    public override List<string> Events() {
        List<string> e = Control.CommonEvents();
        e.Add("Change");
        return e;
    }

    // 控件类型标识（序列化/设计器用）。
    public override string Kind() { return "RadioGroup"; }
}
