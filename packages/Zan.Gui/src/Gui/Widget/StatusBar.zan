using System;
using Gui;

namespace Gui.Widget;

// 窗口状态栏：一行停靠的小文本项，靠左或
// 靠右对齐，位于带细顶部分隔线的主题表面上。
// 各项是 Label，文本颜色、省略号和样式与其它控件一样跟随主题；
// 调用方拥有项文本及其含义。
// // 每帧：
public class StatusBar : Control {
    private List<Label> items;
    private Control spacer;
    private int tintBg;  // 0 = 主题表面，否则为纯色着色
    // `options` 的原样文本，供检查器 / 序列化按原样回读。
    private string itemsSpec;

    // 空状态栏（之后 AddLeft/AddRight，或 SetItemsText）。
    public StatusBar() {
        this.InitControl("statusBar");
        items = new List<Label>();
        spacer = new Control("statusSpacer");
        spacer.SetProp("style", "flex:1;min-width:0;order:1");
        this.Add(spacer);
        tintBg = 0;
        itemsSpec = "";
    }

    // 控件类型标识（序列化/设计器用）。
    public override string Kind() { return "StatusBar"; }

    // 覆写：返回设计器属性清单（tint）。
    protected override List<PropSpec> DefineProps() {
        List<PropSpec> ps = new List<PropSpec>();
        ps.Add(PropSpec.Color("tint", "Tint").Field("tintBg"));
        PropSpec it = PropSpec.Text("options", "Items");
        it.Field("itemsSpec");
        it.WithTip("Pipe-separated items; prefix > to right-align "
                   + "(e.g. \"main|>clock\").");
        ps.Add(it);
        return ps;
    }

    // 面板直改 `options` 必须走重建入口（直写字段不会重建状态项）。
    public override void SetProp(string key, string val) {
        if (key == "options") { this.SetItemsText(val); return; }
        base.SetProp(key, val);
    }

    // 建一个 secondary small 文本项并加入条（尚未停靠）。返回标签。
    public Label NewItem(string text) {
        Label l = new Label { Text = text, Class = "secondary small" };
        items.Add(l);
        Add(l);
        return l;
    }

    // 追加一个左对齐项；返回其索引供后续更新。
    public int AddLeft(string text) {
        this.NewItem(text);
        return items.Count - 1;
    }

    // 右侧项按添加顺序从右向左扩展；列表索引保持添加顺序。
    public int AddRight(string text) {
        Label l = this.NewItem(text);
        l.SetProp("style", "order:" + (2147483647 - items.Count).ToString());
        return items.Count - 1;
    }

    // 丢掉所有项。
    public void Clear() {
        items = new List<Label>();
        this.RemoveAll();
        this.Add(spacer);
    }

    // 按序列化文本重建全部项：每条一个标题，`|` 分隔，
    // 前缀 `>` 靠右。设计器与设计文档走这条路径。
    public void SetItemsText(string spec) {
        itemsSpec = spec;
        this.Clear();
        List<string> parts = spec.Split("|");
        for (int i = 0; i < parts.Count; i = i + 1) {
            string it = parts[i];
            if (it == "") { continue; }
            if (it.Length > 0 && (it[0] & 255) == 62) {  // '>'
                this.AddRight(it.Substring(1));
            } else {
                this.AddLeft(it);
            }
        }
    }

    // 项集合是一个列表，不是字段，因此走 extra 属性：
    // 设计器 / 设计文档的 `options` 由此真正建出状态项。
    public override string GetExtra(string key) {
        return "";
    }

    // 设计器写入 `options`（按分隔文本重建状态项，前缀 `>` 靠右）；
    // 其他键返回 false 交给基类。
    public override bool SetExtra(string key, string val) {
        return false;
    }

    // 更新第 index 项文本；越界为空操作。
    public void SetText(int index, string text) {
        if (index < 0 || index >= items.Count) { return; }
        items[index].Text = text;
    }

    // 设置第 index 项文字颜色；越界为空操作。
    public void SetColor(int index, int color) {
        if (index < 0 || index >= items.Count) { return; }
        items[index].TextColor(color);
    }

    // 第 index 项的标签控件；越界返回 null。宿主要在这项上挂命中区
    // （点击重连、跳帮助等）时用它量位置——项的排布由状态栏自己负责，
    // 宿主只能事后读回已排好的矩形。
    public Label ItemAt(int index) {
        if (index < 0 || index >= items.Count) { return null; }
        return items[index];
    }

    // 纯色背景着色，替换默认表面（0 恢复默认），
    // 用于宿主想在整个状态栏传达某种模式时。
    public void SetTint(int bg) { tintBg = bg; }

    // 覆写：量出状态栏固定行高与内边距/间距，并落表面着色
    // （SetTint 或 `statusbar` 样式的纵向渐变）。
    public override void OnMeasure(App app) {
        Theme t = app.theme;
        // Tint is a measured surface result, never an authored inline background.
        // Resolve afresh so clearing tint also drops the previous frame's override.
        StyleBox surface = this.ResolveStyleAs(app, this.StyleType(), this.EffectiveClass(), Style.SNormal());
        padL = surface.PadLOr(t.paddingSmall);
        padR = surface.PadROr(t.paddingSmall);
        padT = surface.PadTOr(0);
        padB = surface.PadBOr(0);
        gap = surface.GapOr(t.gapLarge);
        prefH = surface.HeightOr(t.heightTiny);
        // 窗口圆角契约：当处于圆角窗口（DWM 或异形）且底角未单独显式指定时，
        // 将底部左右圆角半径与窗口轮廓焊合，避免方角状态栏底角刺破窗口圆角轮廓。
        int cr = app.EffectiveCornerRadius();
        if (cr > 0 && (styleCorners == 0 || styleCorners == Corner.Bottom())) {
            styleRadius = cr;
            styleCorners = Corner.Bottom();
            int safePad = cr + app.Scale(4);
            if (padL < safePad) { padL = safePad; }
            if (padR < safePad) { padR = safePad; }
        } else if (cr == 0 && styleCorners == Corner.Bottom()) {
            styleRadius = 0;
            styleCorners = 0;
        }
        // Keep the window-corner adjustment on this frame's resolved surface.
        Style.Inline(surface, this);
        if (tintBg != 0) {
            surface.bg = tintBg;
            surface.bgTo = 0;
        }
    }

    // 表面由基础 CSS 样式层填充；这里只绘制顶部分隔线。
    public override void OnPaint(App app) {
        StyleBox divider = Control.BareBox(app, "divider", Style.SNormal());
        app.canvas.FillRect(bx, by, bw, divider.HeightOr(1),
                            divider.BgOr(0));
    }
}
