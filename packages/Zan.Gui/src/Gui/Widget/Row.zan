using System;
using System.Collections.Generic;
using Gui;

namespace Gui.Widget;

// 现代化横向流式排版原语（对齐 Naive UI n-flex / SwiftUI HStack / Flutter Row）。
// 内部使用 Flex 引擎，默认主轴为 row，交叉轴自动居中对齐，子项可通过 Gap() 分隔，
// 支持 Spacer 弹性自动撑开两端空间。
public class Row : Flex {
    public Row() {
        InitFlex("row");
        this.layout = 2;
        this.AlignCenter();
    }

    public Row(List<Control> items) : this() {
        if (items != null) { this.Children(items); }
    }

    public override string Kind() { return "Row"; }

    // 设置主轴项目间距（像素）
    public Row Gap(int px) {
        this.gap = px;
        return this;
    }

    // 设置交叉轴对齐（start / center / end / stretch）
    public Row Align(string mode) {
        base.Align(mode);
        return this;
    }

    // 交叉轴居中对齐
    public Row AlignCenter() {
        base.AlignCenter();
        return this;
    }

    // 交叉轴起点对齐
    public Row AlignStart() {
        base.AlignStart();
        return this;
    }

    // 交叉轴终点对齐
    public Row AlignEnd() {
        base.AlignEnd();
        return this;
    }

    // 设置主轴对齐（start / center / end / between / around）
    public Row Justify(string mode) {
        base.Justify(mode);
        return this;
    }

    // 批量追加子节点并返回强类型 Row 以维持方法链
    public Row Children(List<Control> items) {
        if (items != null) {
            for (int i = 0; i < items.Count; i = i + 1) {
                this.With(items[i]);
            }
        }
        return this;
    }

    // 流式追加单个子项并返回强类型 Row
    public Row Child(Control c) {
        this.With(c);
        return this;
    }
}
