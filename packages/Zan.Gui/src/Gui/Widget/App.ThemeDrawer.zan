namespace Gui;
public partial class App {
    internal object themeDrawer;
    internal Control themeDrawerSurface;
    public void ToggleThemeMenu(int triggerId) {
        if (themeNames.Count == 0) { return; }
        ThemeDrawer current = themeDrawer != null ? (ThemeDrawer)themeDrawer : null;
        if (current != null && current.IsOpen()) { this.CloseThemeDrawer(current); }
        else { this.ShowThemeDrawer(); }
        this.NoteRedrawWhy("ToggleThemeMenu");
        needsRedraw = true;
    }
    public void ShowThemeDrawer() {
        if (!isRunning || themeNames.Count == 0 || overlayHost == null) { return; }
        if (themeDrawer == null) { themeDrawer = new ThemeDrawer(this); }
        themeDrawerSurface = ((ThemeDrawer)themeDrawer).Box();
        themeMenuOpen.Set(true);
        ((ThemeDrawer)themeDrawer).Present(this);
    }
    internal void CloseThemeDrawer(ThemeDrawer view) {
        if (themeDrawer != view) { return; }
        themeDrawerSurface = null;
        themeMenuOpen.Set(false);
        if (overlayHost != null) { overlayHost.Hide(view); }
        if (view.IsOpen()) { view.Hide(); }
        this.RequestRedraw();
    }
    internal void RetireThemeDrawer(ThemeDrawer view) {
        if (themeDrawer != view) { return; }
        themeDrawer = null;
        themeDrawerSurface = null;
        themeMenuOpen.Set(false);
        view.Retire();
    }
    internal int ThemeDrawerAccent(int index) {
        if (index == 1) { return Theme.Rgb(59, 130, 246); }
        if (index == 2) { return Theme.Rgb(139, 92, 246); }
        if (index == 3) { return Theme.Rgb(236, 72, 153); }
        if (index == 4) { return Theme.Rgb(16, 185, 129); }
        if (index == 5) { return Theme.Rgb(245, 158, 11); }
        if (index == 6) { return Theme.Rgb(239, 68, 68); }
        return 0;
    }
    internal void ChangeThemeDrawerSetting(ThemeDrawer view, string command, int value) {
        if (themeDrawer != view || !view.IsOpen()) { return; }
        if (command == "tab") { view.SelectTab(value); return; }
        if (command == "skin") {
            if (value < 0 || value >= themeNames.Count) { return; }
            int previous = themeMenuModel.Get();
            if (autoSkins) {
                this.ApplySkin(value);
                if (appliedSkin != value) { return; }
            } else { themeMenuModel.Set(value); }
            if (themeMenuModel.Get() != previous) { themeMenuChange.Raise(); }
        } else if (command == "accent") {
            accentOverride = this.ThemeDrawerAccent(value);
            if (autoSkins) { this.ApplySkin(appliedSkin); }
            else if (accentOverride != 0) {
                theme.ApplyAccent(accentOverride);
                this.ApplyAppCss();
            }
        } else if (command == "density") {
            this.SetDensity(value);
        } else if (command == "opacity") {
            this.SetWindowOpacity(view.opacity.Low());
        } else if (command == "wallpaper-pick") {
            this.RequestWallpaperPick();
        } else if (command == "wallpaper-clear") {
            this.ClearWallpaper();
        } else if (command == "wallpaper-opacity") {
            if (this.HasUserWallpaper()) {
                this.SetUserWallpaper(this.UserWallpaperPath(), view.wallpaperOpacity.Low());
            } else { this.SetWallpaper(this.WallpaperPath(), view.wallpaperOpacity.Low()); }
        } else if (command == "animations") {
            this.SetBackdropFx(view.animations.IsChecked());
        } else if (command == "effect") {
            this.SetFxKind(value);
        }
        if (isRunning && themeDrawer == view && view.IsOpen()) { view.Prepare(this); }
        this.RequestRedraw();
    }
}
