using System;
using Gui;

namespace Gui.Widget;

// 复选框组：每个选项一个独立的真实 Checkbox。提供聚合
// 查询（IsChecked/CheckedCount）与组级 Change 事件：任一
// 选项被用户切换时组事件一并触发，便于表单读取全部勾选。
public class CheckboxGroup : ChoiceGroup {
    // 任一子复选框被用户切换时触发（C# 风格：`group.Change += h;`）。
    [Event(Alias = "Toggle")]
    public UiEvent Change;

    // 构造空组。
    public CheckboxGroup() {
        this.InitChoice();
        this.Change = new UiEvent();
    }

    // 覆写：为选项造一个真实 Checkbox，其切换经 OnChildEvent 冒泡为
    // 组级 Change（不挂捕获组的闭包——引用环，逐项泄漏）。
    public override Control MakeItem(int index, string text) {
        Checkbox cb = new Checkbox(text);
        return cb;
    }

    // 子复选框用户切换冒泡（Control.OnChildEvent）：触发组级 Change。
    public override void OnChildEvent(Control child, string evt) {
        if (evt == "Change") { this.Change.Raise(this); }
    }

    // 第 index 个选项的勾选状态；越界或该项不是复选框时返回 false。
    public bool IsChecked(int index) {
        if (index < 0 || index >= this.ChildCount()) { return false; }
        Control c = this.ChildAt(index);
        if (c != null && c is Checkbox) { return ((Checkbox)c).IsChecked(); }
        return false;
    }

    // 程序化设置第 index 个选项的勾选状态（不触发组 Change，
    // 与 Checkbox.SetChecked 的静默语义一致）。
    public void SetChecked(int index, bool v) {
        if (index < 0 || index >= this.ChildCount()) { return; }
        Control c = this.ChildAt(index);
        if (c != null && c is Checkbox) { ((Checkbox)c).SetChecked(v); }
    }

    // 已勾选的选项数。
    public int CheckedCount() {
        int n = 0;
        for (int i = 0; i < this.ChildCount(); i = i + 1) {
            Control c = this.ChildAt(i);
            if (c != null && c is Checkbox && ((Checkbox)c).IsChecked()) { n = n + 1; }
        }
        return n;
    }

    // 全选 / 全不选。
    public void SetAllChecked(bool v) {
        for (int i = 0; i < this.ChildCount(); i = i + 1) {
            Control c = this.ChildAt(i);
            if (c != null && c is Checkbox) { ((Checkbox)c).SetChecked(v); }
        }
    }

    // 控件类型标识（序列化/设计器用）。
    public override string Kind() { return "CheckboxGroup"; }
}
