using System;
using Gui;
namespace Gui.Widget;
[GuiKind("CheckboxGroup")]
public class CheckboxGroup : ChoiceGroup {
    public override Control CreateCloneShell() { return new CheckboxGroup(); }
    public UiEvent Change;
    public CheckboxGroup() {
        this.InitChoice();
        this.Change = new UiEvent();
    }
    public string OptionsSource {
        get { return this.OptionsText(); }
        set { this.ClearOptions(); this.SetOptionsText(value); }
    }
    public string CheckedValues {
        get { return this.GetCheckedValuesText(); }
        set { this.SetCheckedValuesText(value); }
    }
    public string GetCheckedValuesText() {
        string acc = "";
        for (int i = 0; i < this.ChildCount(); i = i + 1) {
            if (this.IsChecked(i)) {
                if (acc != "") { acc = acc + ","; }
                string lbl = i < this.labels.Count ? this.labels[i] : Convert.ToString(i);
                acc = acc + lbl;
            }
        }
        return acc;
    }
    public void SetCheckedValuesText(string val) {
        this.SetAllChecked(false);
        if (val == null || val == "") { return; }
        string sep = val.IndexOf("|") >= 0 ? "|" : ",";
        List<string> parts = val.Split(sep);
        for (int p = 0; p < parts.Count; p = p + 1) {
            string token = parts[p].Trim();
            if (token == "") { continue; }
            bool matched = false;
            for (int i = 0; i < this.labels.Count; i = i + 1) {
                if (this.labels[i] == token) {
                    this.SetChecked(i, true);
                    matched = true;
                }
            }
            if (!matched) {
                int idx = -1;
                if (int.TryParse(token, out idx) && idx >= 0 && idx < this.ChildCount()) {
                    this.SetChecked(idx, true);
                }
            }
        }
    }
    protected override List<PropSpec> DefineProps() {
        List<PropSpec> ps = base.DefineProps();
        ps.Add(PropSpec.Text("value", "Checked values").DefaultBinding().ViaExtra().Also("data"));
        return ps;
    }
    public override string GetExtra(string key) {
        if (key == "value" || key == "data") { return this.GetCheckedValuesText(); }
        return base.GetExtra(key);
    }
    public override bool SetExtra(string key, string val) {
        if (key == "value" || key == "data") {
            this.SetCheckedValuesText(val);
            return true;
        }
        return base.SetExtra(key, val);
    }
    public override void OnMeasure(App app) {
        this.SyncBinding();
        base.OnMeasure(app);
    }
    public override void OnPaint(App app) {
        this.SyncBinding();
        base.OnPaint(app);
    }
    public override Control MakeItem(int index, string text) { Checkbox cb = new Checkbox(text); return cb; }
    public override void OnChildEvent(Control child, string evt) {
        if (evt == "Change") { this.Change.RaiseS(this); }
    }
    public bool IsChecked(int index) {
        if (index < 0 || index >= this.ChildCount()) { return false; }
        Control c = this.ChildAt(index);
        if (c != null && c is Checkbox) { return ((Checkbox)c).IsChecked(); }
        return false;
    }
    public void SetChecked(int index, bool v) {
        if (index < 0 || index >= this.ChildCount()) { return; }
        Control c = this.ChildAt(index);
        if (c != null && c is Checkbox) { ((Checkbox)c).SetChecked(v); }
    }
    public int CheckedCount() {
        int n = 0;
        for (int i = 0; i < this.ChildCount(); i = i + 1) {
            Control c = this.ChildAt(i);
            if (c != null && c is Checkbox && ((Checkbox)c).IsChecked()) { n = n + 1; }
        }
        return n;
    }
    public void SetAllChecked(bool v) {
        for (int i = 0; i < this.ChildCount(); i = i + 1) {
            Control c = this.ChildAt(i);
            if (c != null && c is Checkbox) { ((Checkbox)c).SetChecked(v); }
        }
    }
    public override void BindEvent(string evt, Action a) {
        if (evt == "Change" || evt == "Toggle") { Change.Add(a); return; }
        base.BindEvent(evt, a);
    }
    public override void BindEventS(string evt, ControlEvent a) {
        if (evt == "Change" || evt == "Toggle") { Change.AddS(a); return; }
        base.BindEventS(evt, a);
    }
    public override List<string> Events() {
        List<string> e = Control.CommonEvents();
        e.Add("Change");
        return e;
    }
    public override string Kind() { return "CheckboxGroup"; }
}
