using System;
using Gui;
namespace Gui.Widget;
[GuiKind("Card")]
public class Card : Control {
    public override Control CreateCloneShell() { return new Card(); }
    private Panel addedContent;
    public string title;
    public bool lifted;
    public bool bordered;
    public Binding<string> Size;
    public Control headerExtra;
    public Control bodyContent;
    public List<Control> actions;
    public string HeaderClassName = "";
    public string TitleClassName = "";
    public string BodyClassName = "";
    public string FooterClassName = "";
    public string CardTitle {
        get { return title; }
        set { this.Title(value != null ? value : ""); }
    }
    public Control Header {
        get { return headerExtra; }
        set { this.HeaderExtra(value); }
    }
    public Control Body {
        get { return bodyContent; }
        set { this.Content(value); }
    }
    public List<Control> CardActions {
        get { return actions; }
        set { this.Actions(value); }
    }
    public bool IsLifted {
        get { return lifted; }
        set { lifted = value; }
    }
    public bool IsBordered {
        get { return bordered; }
        set { bordered = value; }
    }
    private Flex headerNode;
    private Flex bodyNode;
    private Flex footerNode;
    private string appliedTitle = "";
    private Control appliedExtra = null;
    private Control appliedBody = null;
    private int appliedActionCount = 0;
    private string appliedHeaderClass = "";
    private string appliedTitleClass = "";
    private string appliedBodyClass = "";
    private string appliedFooterClass = "";
    public override int StyleDisplay() { return 1; } // CSS display: flex
    public override int StyleFlexDir() { return 1; } // flex-direction: column
    private void InitCard(string ttl) {
        this.InitControl("card");
        title = ttl;
        lifted = false;
        bordered = true;
        Size = "medium";
        actions = new List<Control>();
        this.RebuildStructure();
    }
    public Card() { InitCard(""); }
    public Card(string ttl) { InitCard(ttl); }
    public void Title(string ttl) {
        title = ttl;
        this.RebuildStructure();
    }
    public void HeaderExtra(Control extra) {
        headerExtra = extra;
        this.RebuildStructure();
    }
    public void Content(Control body) {
        addedContent = null;
        bodyContent = body;
        this.RebuildStructure();
    }
    public void Actions(List<Control> acts) {
        actions = acts != null ? acts : new List<Control>();
        this.RebuildStructure();
    }
    public void Action(Control act) {
        if (act != null) {
            actions.Add(act);
            this.RebuildStructure();
        }
    }
    public void Lift() { lifted = true; }
    public void RebuildStructure() {
        this.RemoveAll();
        appliedTitle = title;
        appliedExtra = headerExtra;
        appliedBody = bodyContent;
        appliedActionCount = actions != null ? actions.Count : 0;
        appliedHeaderClass = HeaderClassName;
        appliedTitleClass = TitleClassName;
        appliedBodyClass = BodyClassName;
        appliedFooterClass = FooterClassName;
        if (title != "" || headerExtra != null) {
            headerNode = new Flex();
            headerNode.ClassName = Control.ClassWith("card-header row justify-between align-center", HeaderClassName);
            if (title != "") {
                headerNode.Add(new Label(title) { ClassName = Control.ClassWith("card-title", TitleClassName) });
            }
            if (headerExtra != null) { headerNode.Add(headerExtra); }
            base.Add(headerNode);
        }
        if (bodyContent != null) {
            bodyNode = new Flex();
            bodyNode.ClassName = Control.ClassWith("card-body flex-1 column", BodyClassName);
            bodyNode.Add(bodyContent);
            base.Add(bodyNode);
        }
        if (actions != null && actions.Count > 0) {
            footerNode = new Flex();
            footerNode.ClassName = Control.ClassWith("card-footer row justify-end align-center gap-small", FooterClassName);
            for (int i = 0; i < actions.Count; i = i + 1) {
                footerNode.Add(actions[i]);
            }
            base.Add(footerNode);
        }
    }
    public override bool MountSlot(string slot, Control child) {
        if (slot == "extra" || slot == "header-extra") {
            if (child == null || !this.Adoptable(child)) { return false; }
            this.HeaderExtra(child);
            return true;
        }
        return base.MountSlot(slot, child);
    }
    public override Control Add(Control child) {
        if (child == null) { return null; }
        if (!this.Adoptable(child)) { return child; }
        if (child.slotName != "" && this.MountSlot(child.slotName, child)) { return child; }
        if (addedContent == null) {
            addedContent = Panel.Column();
            if (bodyContent != null) { addedContent.Add(bodyContent); }
            bodyContent = addedContent;
        }
        addedContent.Add(child);
        this.RebuildStructure();
        return child;
    }
    public override void CloneContentTo(Control target, CloneTreeFn clone) {
        Card card = (Card)target;
        if (headerExtra != null) { card.HeaderExtra(clone(headerExtra)); }
        if (addedContent != null) {
            for (int i = 0; i < addedContent.ChildCount(); i = i + 1) {
                card.Add(clone(addedContent.ChildAt(i)));
            }
        } else if (bodyContent != null) { card.Content(clone(bodyContent)); }
        for (int i = 0; i < actions.Count; i = i + 1) {
            Control action = clone(actions[i]);
            if (action != null) { card.Action(action); }
        }
    }
    public override Binding<string> SizeOf() { return Size; }
    protected override List<PropSpec> DefineProps() {
        List<PropSpec> ps = new List<PropSpec>();
        ps.Add(PropSpec.Text("title", "Title").Field("title").Setter("Title").Also("data").Also("text").Also("value"));
        ps.Add(PropSpec.Bool("lifted", "Lifted").Field("lifted"));
        ps.Add(PropSpec.Bool("bordered", "Bordered").Field("bordered"));
        ps.Add(this.SizeProp());
        return ps;
    }
    private bool StructureDirty() {
        int actCount = actions != null ? actions.Count : 0;
        return appliedTitle != title
            || appliedExtra != headerExtra
            || appliedBody != bodyContent
            || appliedActionCount != actCount
            || appliedHeaderClass != HeaderClassName
            || appliedTitleClass != TitleClassName
            || appliedBodyClass != BodyClassName
            || appliedFooterClass != FooterClassName;
    }
    public override void SyncBinding() {
        base.SyncBinding();
        if (this.StructureDirty()) {
            this.RebuildStructure();
        }
        this.SwitchClass("bordered-off", !bordered);
        this.ApplySizeClass();
    }
}
