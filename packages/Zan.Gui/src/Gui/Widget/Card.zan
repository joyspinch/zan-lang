using System;
using Gui;

namespace Gui.Widget;

// 卡片容器：纯 Flex 纵向容器，支持标题、内容区与操作栏声明式互嵌。
// 外壳与分隔线全部由 CSS 盒模型驱动，彻底物理消除所有画布坐标微绘。
public class Card : Control {
    public string title;
    public bool lifted;
    public bool bordered;
    public Binding<string> Size;
    public Control headerExtra;
    public Control bodyContent;
    public List<Control> actions;

    private Flex headerNode;
    private Flex bodyNode;
    private Flex footerNode;

    public override int StyleDisplay() { return 1; } // CSS display: flex
    public override int StyleFlexDir() { return 1; } // flex-direction: column

    private void InitCard(string ttl) {
        this.InitControl("card", 5);
        title = ttl;
        lifted = false;
        bordered = true;
        Size = "medium";
        actions = new List<Control>();
        this.RebuildStructure();
    }

    public Card() { InitCard(""); }
    public Card(string ttl) { InitCard(ttl); }

    public Card Title(string ttl) {
        title = ttl;
        this.RebuildStructure();
        return this;
    }

    public Card HeaderExtra(Control extra) {
        headerExtra = extra;
        this.RebuildStructure();
        return this;
    }

    public Card Content(Control body) {
        bodyContent = body;
        this.RebuildStructure();
        return this;
    }

    public Card Actions(List<Control> acts) {
        actions = acts != null ? acts : new List<Control>();
        this.RebuildStructure();
        return this;
    }

    public Card Action(Control act) {
        if (act != null) {
            actions.Add(act);
            this.RebuildStructure();
        }
        return this;
    }

    public Card Lift() {
        lifted = true;
        return this;
    }

    // 重建声明式子节点树：Header + Body + Footer
    public void RebuildStructure() {
        this.children.Clear();

        // 1. 顶部标题栏
        if (title != "" || headerExtra != null) {
            headerNode = new Flex();
            headerNode.ClassName = "card-header row justify-between align-center";
            if (title != "") {
                headerNode.Add(new Label(title) { ClassName = "card-title" });
            }
            if (headerExtra != null) {
                headerNode.Add(headerExtra);
            }
            this.Add(headerNode);
        }

        // 2. 主体内容区
        if (bodyContent != null) {
            bodyNode = new Flex();
            bodyNode.ClassName = "card-body flex-1 column";
            bodyNode.Add(bodyContent);
            this.Add(bodyNode);
        }

        // 3. 底部操作栏
        if (actions != null && actions.Count > 0) {
            footerNode = new Flex();
            footerNode.ClassName = "card-footer row justify-end align-center gap-small";
            for (int i = 0; i < actions.Count; i = i + 1) {
                footerNode.Add(actions[i]);
            }
            this.Add(footerNode);
        }
    }

    public override string Kind() { return "Card"; }
    public override Binding<string> SizeOf() { return Size; }

    public override List<PropSpec> Props() {
        List<PropSpec> ps = new List<PropSpec>();
        PropSpec ttl = PropSpec.Text("title", "Title");
        ttl.str = title;
        ps.Add(ttl);
        PropSpec lift = PropSpec.Bool("lifted", "Lifted");
        lift.flag = lifted;
        ps.Add(lift);
        PropSpec bd = PropSpec.Bool("bordered", "Bordered");
        bd.flag = bordered;
        ps.Add(bd);
        ps.Add(this.SizeProp());
        return ps;
    }

    public override void SyncBinding() {
        base.SyncBinding();
        if (!bordered) { this.AddClass("bordered-off"); }
        this.ApplySizeClass();
    }

    public override void OnPaint(App app) {
        int id = this.CommonId();
        if (lifted) {
            app.hitTester.RegisterRectL(id, bx, by, bw, bh, 0, "");
        }
    }
}
