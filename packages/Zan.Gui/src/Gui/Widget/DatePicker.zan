using System;
using Gui;

namespace Gui.Widget;

// 日期编辑控件：可键盘编辑的取值输入框，右侧带日历按钮。
// 弹层在覆盖层中绘制，取值通过 OnChange 报告。
// Type 字段控制变体（Naive UI type prop）：
// "date"          — 默认，单个日期（YYYY-MM-DD）
// "datetime"      — 含时分；弹层底部 HH:MM 数字区点击递增
// "daterange"     — 起止日期对，弹层为左右双月历（左=选中月，
// 右=下个月），点起始再点结束，悬停实时预览区间
// "datetimerange" — 双月历 + 各面板底部一组 HH:MM（起始时间复用
// hour/minute 字段，结束时间为 endHour/endMinute）
// "week"          — 整周选择：点任意一天选中其所在周（周一~周日），
// 文本 "周一 ~ 周日"
// "month"         — 12 宫格选月，文本 YYYY-MM（取值=当月 1 日）
// "monthrange"    — 双面板选月区间（右面板 = 下一年）
// "quarter"       — Q1-Q4 选季度，文本 YYYY-Qn（取值=季首月 1 日）
// "quarterrange"  — 双面板选季度区间
// "year"          — 12 年一页选年份，取值=当年 1 月 1 日
// "yearrange"     — 双面板选年份区间（右面板 = 下一个 12 年页）
public class DatePicker : Control {
    public Control customPopup;
    public Card defaultPopupCard;
    public Calendar calendarWidget;
    // 取值输入框（键盘编辑路径）。
    public Input editor;
    // 右侧日历按钮（点击开合弹层）。
    public Button trigger;
    // 取值变化后触发（弹层点选、键盘编辑出合法文本）。
    public UiEvent Change;
    // 弹层展开状态。
    public bool open;
    // 弹层左面板当前显示的年月。
    public int viewYear;
    public int viewMonth;
    // 当前取值：单值模式的选中值；range 模式的结束值。
    public DateTime selected;
    // range 模式下第一个点击（pending）；第二次点击后才关闭弹层。
    // week 模式下一次点击即同时写入起（周一）止（周日）。
    public DateTime pendingStart;
    // range/week 模式下是否已有有效区间（pendingStart..selected）。
    public bool hasPending;
    // 已点起始、等待第二个点击。重新打开弹层后复位，
    // 让"再点一次"总是开启一条新区间而不是续接旧区间。
    public bool pickingEnd;
    // 本帧悬停到的取值（仅弹层绘制期间有效），用于区间预览。
    public bool hasHover;
    public DateTime hoverDate;
    // datetime 的时分；datetimerange 里为起始时分。
    public int hour;
    public int minute;
    // datetimerange 的结束时间；起始时间复用 hour/minute。
    public int endHour;
    public int endMinute;
    // 组件命中 id（构造时 WidgetId.Next() 分配）。
    public int wid;
    public string Type;
    // 快捷选项配置列表（为空时不显示侧边栏；由配置项动态驱动）。
    public List<DateShortcut> shortcuts;
    // 映射为 input.small/large 档位 class，支持响应式换档。
    public Binding<string> Size;

    // 构造：内置编辑框与日历按钮，默认取今天。
    public DatePicker() {
        this.InitControl("datePicker", 1);
        editor = new Input("YYYY-MM-DD");
        editor.Class = "date";
        trigger = new Button("");
        trigger.Icon = "calendar";
        trigger.Class = "text small";
        trigger.Tip = "选择日期";
        Change = new UiEvent();
        open = false;
        Type = "date";
        shortcuts = null;
        Size = "medium";
        selected = DateTime.LocalNow();
        viewYear = selected.Year();
        viewMonth = selected.Month();
        pendingStart = null;
        hasPending = false;
        pickingEnd = false;
        hasHover = false;
        hoverDate = null;
        hour = 0;
        minute = 0;
        endHour = 0;
        endMinute = 0;
        wid = this.CommonId();
        wiresOwnEvents = true;
        this.Add(editor);
        this.Add(trigger);
        trigger.Click.AddS(DatePicker.OnTriggerClick);
        this.SetDate(selected);
    }

    // 控件类型标识（序列化/设计器用）。
    public override string Kind() { return "DatePicker"; }
    // 覆写：CSS 类型选择器名（"input"，与输入框共用皮肤规则）。
    public override string StyleType() { return "input"; }
    // 覆写：返回 Size 绑定字段（设计器经它发现尺寸档位绑定）。
    public override Binding<string> SizeOf() { return Size; }

    // 覆写：返回设计器属性清单（日期文本 / 类型 / 尺寸档）。
    public override List<PropSpec> Props() {
        List<PropSpec> ps = new List<PropSpec>();
        PropSpec text = PropSpec.Text("text", "Date");
        text.WithTip("Formats: date 'YYYY-MM-DD'; datetime 'YYYY-MM-DD HH:MM'"
                     + "; ranges 'A ~ B'; month 'YYYY-MM'; quarter 'YYYY-Qn'"
                     + "; year 'YYYY'.");
        ps.Add(text);
        PropSpec type = PropSpec.Enum("type", "Type",
            new List<string>{ "date", "datetime", "daterange",
                "datetimerange", "week", "month", "monthrange",
                "quarter", "quarterrange", "year", "yearrange" });
        /* 有意不绑字段：type 写入要连带重建编辑器文本
         * （SetExtra 里 editor.SetText(FormatText())），绑定 spec 会让
         * PropOf 拦在 SetExtra 之前把写路径吃掉（快照 spec 挡死真写入）。
         * 未绑定 spec 只负责把键带进序列化/schema，读写走 GetExtra/SetExtra。 */
        ps.Add(type);
        PropSpec sz = PropSpec.Enum("size", "Size",
            PropSpec.Sizes());
        sz.str = Size;
        ps.Add(sz);
        return ps;
    }

    // 覆写：应答扩展属性键（日期文本、type 与 shortcuts 配置）。
    public override string GetExtra(string key) {
        if (key == "text" || key == "value") { return this.Text(); }
        if (key == "type") { return Type; }
        if (key == "shortcuts") {
            return (shortcuts != null && shortcuts.Count > 0) ? "true" : "false";
        }
        return "";
    }

    // 覆写：写回扩展属性键（文本经 SetText 解析，type 合法值切换粒度，shortcuts 配置快捷项）。
    public override bool SetExtra(string key, string val) {
        if (key == "text" || key == "value") {
            this.SetText(val);
            return true;
        }
        if (key == "shortcuts") {
            if (val == "true" || val == "default") {
                this.UseDefaultShortcuts();
            } else if (val == "false" || val == "none" || val == "") {
                this.ClearShortcuts();
            }
            return true;
        }
        if (key == "type") {
            if (val == "date" || val == "datetime" || val == "daterange" ||
                val == "datetimerange" || val == "week" || val == "month" ||
                val == "monthrange" || val == "quarter" ||
                val == "quarterrange" || val == "year" ||
                val == "yearrange") {
                Type = val;
                editor.SetText(this.FormatText());
            }
            return true;
        }
        return false;
    }

    // 清空快捷选项。
    public DatePicker ClearShortcuts() {
        this.shortcuts = null;
        return this;
    }

    // 增加一项快捷选项（相对今天的天数偏移，0=今天，-1=昨天）。
    public DatePicker AddShortcut(string label, int startOffset, int endOffset) {
        if (this.shortcuts == null) {
            this.shortcuts = new List<DateShortcut>();
        }
        this.shortcuts.Add(new DateShortcut(label, startOffset, endOffset));
        return this;
    }

    // 一键配置常用电商/广告报表标准快捷选项（今天、昨天、过去7/14/15/30/60/90天）。
    public DatePicker UseDefaultShortcuts() {
        this.ClearShortcuts();
        this.AddShortcut("今天", 0, 0);
        this.AddShortcut("昨天", 0 - 1, 0 - 1);
        this.AddShortcut("过去7天", 0 - 7, 0 - 1);
        this.AddShortcut("过去14天", 0 - 14, 0 - 1);
        this.AddShortcut("过去15天", 0 - 15, 0 - 1);
        this.AddShortcut("过去30天", 0 - 30, 0 - 1);
        this.AddShortcut("过去60天", 0 - 60, 0 - 1);
        this.AddShortcut("过去90天", 0 - 90, 0 - 1);
        return this;
    }

    // 覆写：公共事件之外提供 "Change"。
    public override List<string> Events() {
        List<string> e = Control.CommonEvents();
        e.Add("Change");
        return e;
    }

    // 覆写："Change" 挂 Change 事件，其余按名称走通用路由。
    public override void BindEvent(string evt, Action a) {
        if (evt == "Change") { Change.Add(a); return; }
        On.AddByName(evt, a);
    }

    // <see cref="BindEvent"/> 的 sender 通道（S = Sender）：
    // 特化事件接本控件的 UiEvent，通用事件按名路由。
    public override void BindEventS(string evt, ControlEvent a) {
        if (evt == "Change") { Change.AddS(a); return; }
        On.AddByNameS(evt, a);
    }

    public override void TriggerEvent(string evt) {
        if (evt == "Change") { Change.RaiseS(this); return; }
        base.TriggerEvent(evt);
    }


    // 挂接 Change 回调（链式）。
    public DatePicker OnChange(Action a) {
        Change.Add(a);
        return this;
    }

    // 当前编辑框文本（各 Type 的格式见类文档）。
    public string Text() { return editor.GetText(); }
    // 当前选中值（range 模式为结束值）。
    public DateTime GetDate() { return selected; }
    // range 模式下的起始值；非 range 模式时 == GetDate()。
    public DateTime GetStart() {
        if (this.IsRange() && hasPending) { return pendingStart; }
        return selected;
    }
    // range 模式下的结束值；非 range 模式时 == GetDate()。
    public DateTime GetEnd() { return selected; }
    // 是否为区间/周选择变体（取值为起止对）。
    public bool IsRange() {
        return Type == "daterange" || Type == "datetimerange" ||
            Type == "monthrange" || Type == "quarterrange" ||
            Type == "yearrange" || Type == "week";
    }
    // 是否为 datetime 变体（单值 + 时分）。
    public bool IsDateTime() { return Type == "datetime"; }
    // 是否带时分输入行（datetime / datetimerange）。
    public bool HasTime() { return Type == "datetime" || Type == "datetimerange"; }

    // 面板粒度：day（date/datetime/week/daterange/datetimerange）、
    // month、quarter、year。month/quarter/year 复用同一套宫格绘制。
    public string Granularity() {
        if (Type == "month" || Type == "monthrange") { return "month"; }
        if (Type == "quarter" || Type == "quarterrange") { return "quarter"; }
        if (Type == "year" || Type == "yearrange") { return "year"; }
        return "day";
    }

    // 程序化赋值：同步视图年月与时分并刷新编辑框文本（不触发 Change）。
    public void SetDate(DateTime value) {
        selected = value;
        viewYear = value.Year();
        viewMonth = value.Month();
        if (Type == "datetime") {
            hour = value.Hour();
            minute = value.Minute();
        }
        if (Type == "datetimerange") {
            endHour = value.Hour();
            endMinute = value.Minute();
        }
        editor.SetText(this.FormatText());
    }

    // 程序化按文本赋值：与键盘编辑同一解析路径（非法文本忽略）。
    public void SetText(string value) {
        editor.SetText(value);
        this.Edited();
    }

    // 格式化当前值为编辑框文本，遵循 Type 变体。
    public string FormatText() {
        if (Type == "datetime") {
            return selected.ToDateString() + " " + DateTime.Pad2(hour)
                + ":" + DateTime.Pad2(minute);
        }
        if (Type == "datetimerange") {
            if (!hasPending) {
                return selected.ToDateString() + " " +
                    DateTime.Pad2(endHour) + ":" + DateTime.Pad2(endMinute);
            }
            return pendingStart.ToDateString() + " " +
                DateTime.Pad2(hour) + ":" + DateTime.Pad2(minute) +
                " ~ " + selected.ToDateString() + " " +
                DateTime.Pad2(endHour) + ":" + DateTime.Pad2(endMinute);
        }
        if (this.IsRange() && hasPending) {
            return this.FormatValue(pendingStart) + " ~ " +
                this.FormatValue(selected);
        }
        return this.FormatValue(selected);
    }

    // 单个取值的文本形式（不含时间与范围分隔符）。
    public string FormatValue(DateTime d) {
        string gran = this.Granularity();
        if (gran == "month") {
            return Convert.ToString(d.Year()) + "-" +
                DateTime.Pad2(d.Month());
        }
        if (gran == "quarter") {
            return Convert.ToString(d.Year()) + "-Q" +
                Convert.ToString((d.Month() + 2) / 3);
        }
        if (gran == "year") { return Convert.ToString(d.Year()); }
        return d.ToDateString();
    }

    // 单个数字字符 → 0..9（非法 -1）。
    public static int Digit(string s) {
        if (s == "0") { return 0; }
        if (s == "1") { return 1; }
        if (s == "2") { return 2; }
        if (s == "3") { return 3; }
        if (s == "4") { return 4; }
        if (s == "5") { return 5; }
        if (s == "6") { return 6; }
        if (s == "7") { return 7; }
        if (s == "8") { return 8; }
        if (s == "9") { return 9; }
        return -1;
    }

    // 从 s[at] 起取 count 位数字；任一位非法返回 -1。
    public static int Number(string s, int at, int count) {
        if (s == null || at < 0 || at + count > s.Length) { return -1; }
        int outp = 0;
        for (int i = 0; i < count; i = i + 1) {
            int c = s[at + i] & 255;
            if (c < 48 || c > 57) { return -1; }
            outp = outp * 10 + (c - 48);
        }
        return outp;
    }

    // "YYYY-MM-DD" 严格解析（位数 / 分隔符 / 月日范围全查）；失败 null。
    public static DateTime ParseDate(string value) {
        if (value == null || value.Length != 10) { return null; }
        if ((value[4] & 255) != 45 || (value[7] & 255) != 45) {  // '-'
            return null;
        }
        int y = DatePicker.Number(value, 0, 4);
        int m = DatePicker.Number(value, 5, 2);
        int d = DatePicker.Number(value, 8, 2);
        if (y < 1 || m < 1 || m > 12 || d < 1 ||
            d > DateTime.DaysInMonth(y, m)) { return null; }
        return DateTime.FromDate(y, m, d);
    }

    // 按 Granularity 解析单值文本：month "YYYY-MM"、
    // quarter "YYYY-Qn"、year "YYYY"，day 走 ParseDate。
    public DateTime ParseSingle(string raw) {
        if (raw == null) { return null; }
        string gran = this.Granularity();
        if (gran == "month") {
            if (raw.Length != 7 || (raw[4] & 255) != 45) {
                return null;
            }
            int y = DatePicker.Number(raw, 0, 4);
            int m = DatePicker.Number(raw, 5, 2);
            if (y < 1 || m < 1 || m > 12) { return null; }
            return DateTime.FromDate(y, m, 1);
        }
        if (gran == "quarter") {
            // "YYYY-Qn"：下划线位置 4 是连字符，Q 在 5、季度数字在 6。
            if (raw.Length != 7 || (raw[4] & 255) != 45) {
                return null;
            }
            int q = raw[5] & 255;
            if (q != 81 && q != 113) { return null; }  // 'Q', 'q'
            int y = DatePicker.Number(raw, 0, 4);
            int n = DatePicker.Number(raw, 6, 1);
            if (y < 1 || n < 1 || n > 4) { return null; }
            return DateTime.FromDate(y, n * 3 - 2, 1);
        }
        if (gran == "year") {
            if (raw.Length != 4) { return null; }
            int y = DatePicker.Number(raw, 0, 4);
            if (y < 1) { return null; }
            return DateTime.FromDate(y, 1, 1);
        }
        return DatePicker.ParseDate(raw);
    }

    // "YYYY-MM-DD[ HH:MM]" 解析；start=true 把时分写进 hour/minute
    // （起始时间），否则写进 endHour/endMinute（结束时间）。
    public DateTime ParseTime(string raw, bool start) {
        int sp = raw.IndexOf(" ");
        string datePart = raw;
        if (sp >= 0) { datePart = raw.Substring(0, sp); }
        DateTime d = DatePicker.ParseDate(datePart);
        if (d == null) { return null; }
        int h = hour;
        int mi = minute;
        if (!start) { h = endHour; mi = endMinute; }
        if (sp >= 0) {
            string tail = raw.Substring(sp + 1, raw.Length - sp - 1);
            int colon = tail.IndexOf(":");
            if (colon >= 0) {
                int hh = DatePicker.Number(tail, 0, colon);
                int mm = DatePicker.Number(tail, colon + 1, 2);
                if (hh >= 0) { h = hh; }
                if (mm >= 0) { mi = mm; }
            }
        }
        if (h > 23) { h = 23; }
        if (mi > 59) { mi = 59; }
        if (start) {
            hour = h;
            minute = mi;
        } else {
            endHour = h;
            endMinute = mi;
        }
        return d;
    }

    // 编辑框文本变化的统一收口：按 Type 解析并写回取值（起止颠倒
    // 自动交换），合法且变化才触发 Change。
    public void Edited() {
        string raw = editor.GetText();
        if (Type == "datetimerange") {
            // "YYYY-MM-DD HH:MM ~ YYYY-MM-DD HH:MM"
            int sep = raw.IndexOf("~");
            if (sep < 0) { return; }
            DateTime startV = this.ParseTime(
                raw.Substring(0, sep).Trim(), true);
            DateTime endV = this.ParseTime(
                raw.Substring(sep + 1, raw.Length - sep - 1).Trim(), false);
            if (startV == null || endV == null) { return; }
            if (endV.IsBefore(startV)) {
                // 起止颠倒时连同各自的时分一起交换。
                DateTime td = startV;
                startV = endV;
                endV = td;
                int th = hour;
                hour = endHour;
                endHour = th;
                int tm = minute;
                minute = endMinute;
                endMinute = tm;
            }
            pendingStart = startV;
            hasPending = true;
            if (!selected.Equals(endV)) {
                selected = endV;
                viewYear = endV.Year();
                viewMonth = endV.Month();
                Change.RaiseS(this);
            }
            return;
        }
        if (this.IsRange()) {
            // "A ~ B" / "A~B" / 单值（day: YYYY-MM-DD；month: YYYY-MM；
            // quarter: YYYY-Qn；year: YYYY；week: 周一 ~ 周日）。
            int sep = raw.IndexOf("~");
            DateTime startV = null;
            DateTime endV = null;
            if (sep >= 0) {
                startV = this.ParseSingle(
                    raw.Substring(0, sep).Trim());
                endV = this.ParseSingle(
                    raw.Substring(sep + 1, raw.Length - sep - 1).Trim());
            } else {
                startV = this.ParseSingle(raw);
                endV = startV;
            }
            if (startV == null || endV == null) { return; }
            if (endV.IsBefore(startV)) {
                DateTime td = startV;
                startV = endV;
                endV = td;
            }
            pendingStart = startV;
            hasPending = true;
            if (!selected.Equals(endV)) {
                selected = endV;
                viewYear = endV.Year();
                viewMonth = endV.Month();
                Change.RaiseS(this);
            }
            return;
        }
        if (Type == "datetime") {
            // "YYYY-MM-DD HH:MM"
            int sp = raw.IndexOf(" ");
            DateTime dv = null;
            if (sp >= 0) { dv = DatePicker.ParseDate(raw.Substring(0, sp)); }
            else { dv = DatePicker.ParseDate(raw); }
            if (dv == null) { return; }
            int h = hour; int mi = minute;
            if (sp >= 0) {
                string tail = raw.Substring(sp + 1, raw.Length - sp - 1);
                int colon = tail.IndexOf(":");
                if (colon >= 0) {
                    int hh = DatePicker.Number(tail, 0, colon);
                    int mm = DatePicker.Number(tail, colon + 1, 2);
                    if (hh >= 0) { h = hh; }
                    if (mm >= 0) { mi = mm; }
                }
            }
            if (h > 23) { h = 23; }
            if (mi > 59) { mi = 59; }
            selected = dv;
            hour = h;
            minute = mi;
            viewYear = dv.Year();
            viewMonth = dv.Month();
            Change.RaiseS(this);
            return;
        }
        DateTime value = this.ParseSingle(raw);
        if (value == null) { return; }
        if (!value.Equals(selected)) {
            selected = value;
            viewYear = value.Year();
            viewMonth = value.Month();
            Change.RaiseS(this);
        }
    }

    // 日历按钮的静态回调：经 sender 回溯找到所属 DatePicker 实例并开合弹层。
    private static void OnTriggerClick(Control sender) {
        if (sender == null || sender.parent == null) { return; }
        DatePicker dp = sender.parent as DatePicker;
        if (dp != null) {
            dp.ToggleOpen();
        }
    }

    private static void OnCalendarDateChange(Control sender) {
        if (sender == null || !(sender is Calendar)) { return; }
        Calendar cal = (Calendar)sender;
        Control cur = cal.Parent();
        while (cur != null) {
            if (cur is DatePicker) {
                DatePicker dp = (DatePicker)cur;
                DateTime d = cal.GetDate();
                if (d != null) {
                    dp.selected = d;
                    dp.editor.SetText(dp.FormatText());
                    dp.open = false;
                    dp.Change.RaiseS(dp);
                    OverlayHost.DismissPopup();
                }
                return;
            }
            cur = cur.Parent();
        }
    }

    public Card EnsurePopupCard(App app) {
        if (defaultPopupCard == null) {
            defaultPopupCard = new Card("");
            defaultPopupCard.Class = "datepicker-popup";
            defaultPopupCard.Pad(4);
            defaultPopupCard.parent = this;

            calendarWidget = new Calendar();
            calendarWidget.Mode = "panel";
            calendarWidget.parent = defaultPopupCard;
            calendarWidget.Change.AddS(DatePicker.OnCalendarDateChange);
            defaultPopupCard.With(calendarWidget);
        }
        if (selected != null) {
            calendarWidget.SetDate(selected);
        }
        if (app != null) {
            defaultPopupCard.OnMeasure(app);
        }
        return defaultPopupCard;
    }

    // 开合弹层；打开时把视图对到当前区间起始（range）或
    // 解析编辑框文本（单值）。
    public void ToggleOpen() {
        open = !open;
        if (!open) {
            OverlayHost.DismissPopup();
            return;
        }
        Control pop = this.customPopup != null ? this.customPopup : this.EnsurePopupCard(App.FrameApp());
        OverlayHost.ShowPopup(App.FrameApp(), this, pop);
        pickingEnd = false;
        if (this.IsRange()) {
            // 编辑框文本是 "A ~ B"，ParseSingle 解析不了；左面板
            // 直接对到已有区间的起始（Naive UI 的行为）。
            if (hasPending) {
                viewYear = pendingStart.Year();
                viewMonth = pendingStart.Month();
            }
            return;
        }
        if (Type == "datetime") { return; }
        DateTime value = this.ParseSingle(editor.GetText());
        if (value != null) {
            selected = value;
            viewYear = value.Year();
            viewMonth = value.Month();
        }
    }

    public override void OnPopupDismissed() {
        open = false;
    }

    public bool IsOpen() {
        return open;
    }

    public void SetOpen(bool want) {
        if (open == want) { return; }
        if (want) {
            this.ToggleOpen();
        } else {
            open = false;
            OverlayHost.DismissPopup();
        }
    }

    // 插槽支持：支持任意复杂组件（如自制日程日历卡片、快速选期表格）互嵌到日期弹层
    public override bool MountSlot(string slot, Control c) {
        if (slot == "popup" || slot == "dropdown" || slot == "content") {
            this.SetPopupContent(c);
            return true;
        }
        return base.MountSlot(slot, c);
    }

    public void SetPopupContent(Control c) {
        this.customPopup = c;
        if (c != null && !children.Contains(c)) {
            this.Add(c);
        }
    }

    public Control GetPopupContent() {
        return this.customPopup;
    }

    // 左面板月份翻页（跨年自动进退）。
    public void MoveMonth(int delta) {
        viewMonth = viewMonth + delta;
        if (viewMonth < 1) { viewMonth = 12; viewYear = viewYear - 1; }
        if (viewMonth > 12) { viewMonth = 1; viewYear = viewYear + 1; }
    }

    // 头部箭头的翻页步进：day=±1 个月，month/quarter=±1 年，
    // year=±1 页（12 年）。
    public void MoveView(int delta) {
        string gran = this.Granularity();
        if (gran == "day") { this.MoveMonth(delta); return; }
        if (gran == "year") { viewYear = viewYear + delta * 12; return; }
        viewYear = viewYear + delta;
    }

    // year 粒度页起始（12 年一页，页内年=起..起+11）。
    public int PageStart(int year) { return year - year % 12; }

    // 面板头部标题：day="YYYY-MM"、month="YYYY年"、quarter="YYYY"、
    // year="起 - 止"。
    public string TitleText(int year, int month) {
        string gran = this.Granularity();
        if (gran == "day") {
            return Convert.ToString(year) + "-" + DateTime.Pad2(month);
        }
        if (gran == "month") {
            return Convert.ToString(year) + "年";
        }
        if (gran == "year") {
            int startV = this.PageStart(year);
            return Convert.ToString(startV) + " - " +
                Convert.ToString(startV + 11);
        }
        return Convert.ToString(year);
    }

    // picked 所在周的周一（周一起始；DayOfWeek() 0=周日）。
    public DateTime WeekStart(DateTime d) {
        int offset = d.DayOfWeek() + 6;
        if (offset >= 7) { offset = offset - 7; }
        long back = offset;
        return d.AddDays(-back);
    }

    // 点击左面板第 day 天（按当前视图年月构造取值后走 PickDate）。
    public void PickDay(int day) {
        this.PickDate(DateTime.FromDate(viewYear, viewMonth, day));
    }

    // 取值入口：week 一次点击选整周；range 两次点击成区间
    // （结束 < 起始自动交换）；单值直接落定。落定后写编辑框、
    // 关弹层并触发 Change。
    public void PickDate(DateTime picked) {
        if (Type == "week") {
            // 周选择：一次点击选中整周，起=周一、止=周日。
            DateTime startV = this.WeekStart(picked);
            pendingStart = startV;
            long six = 6;
            selected = startV.AddDays(six);
            hasPending = true;
            pickingEnd = false;
            editor.SetText(this.FormatText());
            open = false;
            Change.RaiseS(this);
            return;
        }
        if (this.IsRange()) {
            // 第一次点击 = 起始；第二次点击 = 结束。结束 < 起始时
            // 自动交换，让用户总能先点开始再点结束。重新打开弹层后
            // pickingEnd 已复位，第一次点击开启的是新区间。
            if (!pickingEnd) {
                pendingStart = picked;
                hasPending = true;
                pickingEnd = true;
                selected = picked;
                editor.SetText(this.FormatText());
                return;
            }
            DateTime startV = pendingStart;
            DateTime endV = picked;
            if (endV.IsBefore(startV)) {
                endV = startV;
                startV = picked;
            }
            pendingStart = startV;
            selected = endV;
            hasPending = true;
            pickingEnd = false;
            editor.SetText(this.FormatText());
            open = false;
            Change.RaiseS(this);
            return;
        }
        selected = picked;
        editor.SetText(this.FormatText());
        open = false;
        Change.RaiseS(this);
    }

    // 覆写：轮询内嵌编辑框。
    public override void OnPaint(App app) {
        this.Edited();
    }

    // 覆写：按尺寸档解析 input 样式给宽高，并保证装下回显文本 + 触发按钮。
    public override void OnMeasure(App app) {
        // 尺寸档生效：input.small/large 的 height 规则给出
        // 28/40 档，不再写死 medium。
        string origClass = Class;
        this.ApplySizeClass();
        StyleBox s = this.BoxState(app, Style.SNormal());
        prefW = s.WidthOr(app.Scale(150));
        // 内容感知兜底：week/daterange/带时分的回显文本比
        // "YYYY-MM-DD" 长一倍以上，面板被短标题撑开时（宽度
        // = max(样式宽, 标题宽)）文本会在框内被裁。用编辑器
        // 同款字号量回显文本，至少装下 文本 + 触发按钮 + 内边距。
        StyleBox es = this.ResolveStyleAs(app, this.StyleType(), "date", Style.SNormal());
        int efs = es.FontOr(Style.FontFallback(app, "medium"));
        int minW = Canvas.MeasureText(editor.GetText(), efs)
            + app.Scale(34 + 16);
        if (prefW < minW) { prefW = minW; }
        prefH = s.HeightOr(app.theme.heightMedium);
        Class = origClass;
    }

    // 覆写：把空间分成编辑框与右侧触发按钮（按钮宽 34）。
    public override void Arrange(int px, int py, int pw, int ph) {
        bx = px; by = py; bw = pw; bh = ph;
        int buttonW = appScale(34);
        if (buttonW > pw) { buttonW = pw; }
        editor.Arrange(px, py, pw - buttonW, ph);
        trigger.Arrange(px + pw - buttonW, py, buttonW, ph);
    }

    // 保留式布局下的缩放占位（当前恒等返回）。
    private int appScale(int n) { return n; }

    // 覆写：弹层由 OverlayHost 与 Calendar 组件全权接管，此处无需重复自绘。
    public override void OnPaintOverlay(App app) {
    }

    // 快捷区间点选应用：按配置的相对今天偏移计算起止日期。
    public void ApplyShortcut(DateShortcut sc) {
        long so = sc.startOffset;
        long eo = sc.endOffset;
        DateTime startV = DateTime.LocalNow().AddDays(so);
        DateTime endV = DateTime.LocalNow().AddDays(eo);
        pendingStart = startV;
        selected = endV;
        hasPending = true;
        pickingEnd = false;
        viewYear = startV.Year();
        viewMonth = startV.Month();
        editor.SetText(this.FormatText());
        open = false;
        Change.RaiseS(this);
    }

    // 按索引应用已配置的快捷选项（供程序化触发与测试）。
    public void ApplyShortcutIndex(int index) {
        if (this.shortcuts != null && index >= 0 && index < this.shortcuts.Count) {
            this.ApplyShortcut(this.shortcuts[index]);
        }
    }
}
