using System;
using Gui;

namespace Gui.Widget;

// TableRow: 表格行 (tr) DOM 容器，持有本行所有 TableCell。
public class TableRow : Control {
    public bool header;
    public bool striped;
    public bool selected;

    public TableRow() {
        this.InitControl("table-row", 1);
        header = false;
        striped = false;
        selected = false;
    }

    public TableRow(bool isHeader) {
        this.InitControl("table-row", 1);
        header = isHeader;
        striped = false;
        selected = false;
        if (isHeader) {
            this.AddClass("table-header");
        }
    }

    public TableRow AddCell(TableCell cell) {
        if (cell != null) {
            this.Add(cell);
        }
        return this;
    }

    public TableRow AddCell(string text) {
        this.Add(new TableCell(text));
        return this;
    }

    public TableRow AddCell(string text, int width) {
        TableCell c = new TableCell(text);
        c.SetWidth(width);
        this.Add(c);
        return this;
    }

    public TableRow AddCell(Control content) {
        this.Add(new TableCell(content));
        return this;
    }

    public TableRow AddCell(Control content, int width) {
        TableCell c = new TableCell(content);
        c.SetWidth(width);
        this.Add(c);
        return this;
    }

    public void SetSelected(bool s) {
        selected = s;
    }

    public bool IsSelected() {
        return selected;
    }

    public void SetHeader(bool h) {
        header = h;
        if (h) {
            this.AddClass("table-header");
        }
    }

    public bool IsHeader() {
        return header;
    }

    public void SetStriped(bool s) {
        striped = s;
    }

    public override string Kind() { return "TableRow"; }

    public override void OnMeasure(App app) {
        Theme t = app.theme;
        int maxH = t.heightMedium;
        int totalW = 0;
        for (int i = 0; i < children.Count; i = i + 1) {
            Control c = children[i];
            c.OnMeasure(app);
            totalW = totalW + c.prefW;
            if (c.prefH > maxH) { maxH = c.prefH; }
        }
        prefW = totalW;
        prefH = maxH;
    }

    public override void OnPaint(App app) {
        if (bw <= 0 || bh <= 0) { return; }
        Theme t = app.theme;

        if (header) {
            StyleBox hStyle = Style.Part(app, "table", "header", "", Class, "", Style.SNormal());
            hStyle.bg = hStyle.BgOr(0);
            SubBox.Paint(app, hStyle, bx, by, bw, bh);
        } else if (selected || striped) {
            StyleBox rStyle = Style.Part(app, "table", "row", "",
                                         selected ? "" : (striped ? "striped" : ""), "",
                                         selected ? Style.SSelected() : Style.SNormal());
            rStyle.bg = rStyle.BgOr(0);
            SubBox.Paint(app, rStyle, bx, by, bw, bh);
        }

        if (selected) {
            StyleBox accent = Style.Part(app, "table", "accent", "", "", "", Style.SNormal());
            accent.bg = accent.BgOr(0);
            SubBox.Paint(app, accent, bx, by, app.Scale(3), bh);
        }

        // 逐个排布并渲染子单元格
        int cx = bx;
        for (int i = 0; i < children.Count; i = i + 1) {
            Control cell = children[i];
            int cw = cell.prefW;
            if (cw <= 0) { cw = app.Scale(100); }
            cell.Arrange(cx, by, cw, bh);
            cell.RenderTree(app);
            cx = cx + cw;
        }

        // 行底部分隔线
        StyleBox divider = Style.Part(app, "table", "divider", "", "", "", Style.SNormal());
        divider.bg = divider.BgOr(0);
        SubBox.Paint(app, divider, bx, by + bh - 1, bw, 1);
    }
}
