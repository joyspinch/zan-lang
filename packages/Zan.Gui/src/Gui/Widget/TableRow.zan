using System;
using Gui;
namespace Gui.Widget;
[GuiKind("TableRow")]
public class TableRow : Control {
    public override Control CreateCloneShell() { return new TableRow(); }
    public bool header;
    public bool striped;
    public bool selected;
    public override int StyleDisplay() { return 1; } // Flex
    public override int StyleFlexDir() { return 0; } // Row
    public TableRow() {
        this.InitControl("table-row");
        this.ClassName = "table-row row align-center";
        header = false;
        striped = false;
        selected = false;
    }
    public TableRow(bool isHeader) {
        this.InitControl("table-row");
        header = isHeader;
        striped = false;
        selected = false;
        this.ClassName = "table-row row align-center " + (isHeader ? "table-header" : "");
    }
    public void AddCell(TableCell cell) {
        if (cell != null) { this.Add(cell); }
    }
    public void AddCell(string text) { this.Add(new TableCell(text)); }
    public void AddCell(string text, int width) {
        TableCell c = new TableCell(text);
        c.SetWidth(width);
        this.Add(c);
    }
    public void AddCell(Control content) { this.Add(new TableCell(content)); }
    public void AddCell(Control content, int width) {
        TableCell c = new TableCell(content);
        c.SetWidth(width);
        this.Add(c);
    }
    public void SetSelected(bool s) {
        selected = s;
        if (s) { this.AddClass("selected"); } else { this.RemoveClass("selected"); }
    }
    public bool IsSelected() { return selected; }
    public void SetHeader(bool h) {
        header = h;
        if (h) { this.AddClass("table-header"); } else { this.RemoveClass("table-header"); }
    }
    public bool IsHeader() { return header; }
    public void SetStriped(bool s) {
        striped = s;
        if (s) { this.AddClass("striped"); } else { this.RemoveClass("striped"); }
    }
    protected override List<PropSpec> DefineProps() {
        List<PropSpec> ps = new List<PropSpec>();
        ps.Add(PropSpec.Bool("header", "Header").Field("header").Setter("SetHeader"));
        ps.Add(PropSpec.Bool("striped", "Striped").Field("striped").Setter("SetStriped"));
        ps.Add(PropSpec.Bool("selected", "Selected").Field("selected").Setter("SetSelected"));
        return ps;
    }

}
