using System;
using Gui;

namespace Gui.Widget;

// 表格行（TableRow）：纯声明式对象树与 CSS 盒模型（Flex 行排布），包含 TableCell 子节点。
public class TableRow : Control {
    public bool header;
    public bool striped;
    public bool selected;

    public override int StyleDisplay() { return 1; } // Flex
    public override int StyleFlexDir() { return 0; } // Row

    public TableRow() {
        this.InitControl("table-row", 1);
        this.ClassName = "table-row row align-center";
        header = false;
        striped = false;
        selected = false;
    }

    public TableRow(bool isHeader) {
        this.InitControl("table-row", 1);
        header = isHeader;
        striped = false;
        selected = false;
        this.ClassName = "table-row row align-center " + (isHeader ? "table-header" : "");
    }

    public TableRow AddCell(TableCell cell) {
        if (cell != null) {
            this.Add(cell);
        }
        return this;
    }

    public TableRow AddCell(string text) {
        this.Add(new TableCell(text));
        return this;
    }

    public TableRow AddCell(string text, int width) {
        TableCell c = new TableCell(text);
        c.SetWidth(width);
        this.Add(c);
        return this;
    }

    public TableRow AddCell(Control content) {
        this.Add(new TableCell(content));
        return this;
    }

    public TableRow AddCell(Control content, int width) {
        TableCell c = new TableCell(content);
        c.SetWidth(width);
        this.Add(c);
        return this;
    }

    public void SetSelected(bool s) {
        selected = s;
        if (s) { this.AddClass("selected"); } else { this.RemoveClass("selected"); }
    }

    public bool IsSelected() {
        return selected;
    }

    public void SetHeader(bool h) {
        header = h;
        if (h) { this.AddClass("table-header"); } else { this.RemoveClass("table-header"); }
    }

    public bool IsHeader() {
        return header;
    }

    public void SetStriped(bool s) {
        striped = s;
        if (s) { this.AddClass("striped"); } else { this.RemoveClass("striped"); }
    }

    public override string Kind() { return "TableRow"; }

    public override void OnPaint(App app) {
        int id = this.CommonId();
        SyncBinding();
        app.focus.RegisterFocusable(id);
        app.hitTester.RegisterRect(id, bx, by, bw, bh, 0);
        On.Fire(app, id, this);
    }
}
