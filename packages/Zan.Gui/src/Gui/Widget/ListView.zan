using System;
using Gui;
using Gui.Backend;

namespace Gui.Widget;

// 从绑定实体中读取某一列的文本：`new ListColumn<File>("Name",`
// f => f.name)`.
// 为某个绑定实体构建一行的控件子树，适用于
// 行是自定义组件而非文本列的列表。
// 回答某个实体所在的行是否可选（可用）。返回 false 的行
// 视为禁用项：点击、Ctrl+点击、Shift+范围、右键、长按
// 全部无反应，悬停/选中带不出现，SelectedIndex 不落在其上。
// 某行被「拖出列表」时回调（行下标）：在某行上按下、拖到列表
// 矩形之外再松开。宿主据此把这一行变成独立窗口（会话拖出成浮窗），
// 列表本身不开窗，也不定义「拖到哪里才算拖出」的下游语义。
public delegate void RowDragOut(int index);

// 绑定到调用方自身数据的列表。只需提供三样东西——行
// 长什么样、数据、处理器——布局一概不用管：
// 控件位于树中，盒子由 CSS 决定，因此调用处无需计算
// 矩形或维护行模型。
// files.Bind(model.files);          // 调用方的 List<FileItem>
// files.OnSelect(OpenSelected);
// side.Add(files);
// 行也可以是独立的组件而非文本列——
// 模板返回任意控件即可：
// 处理器被编排到 UI 线程执行（UiEvent.Post），因此后台
// 任务修改绑定列表并调用 Refresh() 也是安全的。
public class ListView<T> : Control {
    // 调用方的数据。不做任何拷贝：每帧都从中读取行，
    // 所以修改列表后，下一次绘制即可生效。
    public List<T> data;
    // 文本列（列布局模式用）。
    public List<ListColumn<T>> cols;
    // 行模板（模板模式用）；与 cols 二选一。
    public RowOf<T> rowOf;
    // 列表无行时居中显示（"" 则不绘制）。
    public string Empty;
    // 聚焦/选中行号（-1 = 无）。
    public int sel;
    // 本帧悬停的行号（绘制时更新，-1 = 无）。
    public int hover;
    // 多选模式（WithMultiSelect）：Ctrl+点击把行加入/移出
    // `marks`，Shift+点击从锚点扩展。`sel` 仍是聚焦行，
    // 单选调用方不受影响。
    public bool multi;
    // 多选命中的行号集合（Ctrl+点击维护，不含聚焦行）。
    public List<int> marks;
    // 可选行门（WithSelectable）：null = 全部可选。
    public RowGate<T> onlySelectable;
    // 垂直滚动偏移（宿主可读写以驱动/响应滚动）。
    public SignalInt scroll;
    // 模板模式：每个构建的子控件分配一个行 id，因此
    // 未重建任何行的帧里，选择状态也能保留。
    public bool rowsStale;
    // 上次构建模板行时的行数（判断是否需要重建）。
    public int builtFor;
    // 模板行独占的 WidgetId 段起点（-1 = 还没建过行）。
    public int rowSeqBase;
    // 行命中区的稳定 id 块起点与块长（-1/0 = 未预留）：行 i 的命中
    // id = rowHitBase + i。必须整块预留而不能逐帧 AllocId——每帧只有
    // 可见行占号，拖动滚动条时可见行数在 n/n+1 间来回变，其后注册
    // 的滚动条 id 跟着漂移，pressedId 失配后拖动两三像素就停摆
    // （offset 不动 → 可见行数也不翻回 → 直到松手）。
    public int rowHitBase;
    public int rowHitCount;
    // 拖出行手势（OnDragOut）的订阅者，与按下那一刻记住的行下标
    // （-1 = 当前按下的不是行）。指针拖到列表外时命中测试已经
    // 没有行可归属，下标只能在按下那一帧记下。
    public List<RowDragOut> dragOut;
    public int dragOutFrom;

    // 模板行独占的 id 段长度：够放几百行、每行十来个控件。
    public static int RowIdReserve() { return 4096; }

    // 某行被选中（读取 SelectedIndex / Selected）。
    public UiEvent Select;
    // 选中的行再次被点击（打开 / 深入）。
    public UiEvent Activate;
    // 某行被右键点击。
    public UiEvent Context;

    // 公共初始化（各构造共用）。
    // Data indices stay stable even when a template returns null.
    private ListRowsPanel<T> rowsBody;
    private bool layingRows;
    private bool projectingScroll;
    private int filterRevision;
    private List<Control> dataRows;
    private int rowsRevision;
    private bool buildingRows;

    private Control DataRow(int index) {
        if (dataRows == null || index < 0 || index >= dataRows.Count) { return null; }
        Control row = dataRows[index];
        if (row == null || rowsBody == null || row.parent != rowsBody || rowsBody.IndexOf(row) < 0) { return null; }
        return row;
    }

    private void RetireRows() {
        rowsRevision = rowsRevision + 1;
        rowsStale = true;
        builtFor = -1;
        dataRows = null;
        // RemoveAll snapshots; Remove cancels input while the old parent path is valid.
        if (rowsBody != null) { rowsBody.RemoveAll(); }
    }

    private void InitList() {
        this.InitControl("list", 5);
        rowsBody = new ListRowsPanel<T>(this);
        base.Add(rowsBody);
        data = null;
        cols = new List<ListColumn<T>>();
        rowOf = null;
        Empty = "";
        sel = -1;
        hover = -1;
        multi = false;
        marks = new List<int>();
        onlySelectable = null;
        scroll = new SignalInt(0);
        rowsStale = true;
        builtFor = -1;
        rowSeqBase = -1;
        rowHitBase = -1;
        rowHitCount = 0;
        dragOut = new List<RowDragOut>();
        dragOutFrom = -1;
        wiresOwnEvents = true;
        Select = new UiEvent();
        Activate = new UiEvent();
        Context = new UiEvent();
    }

    // 单列纯文本（不假定 `item.ToString()`：当实体不是字符串时，
    // 请绑定一个列）。
    public ListView() { InitList(); }

    // 常见形式：直接传列。
    public ListView(List<ListColumn<T>> columns) {
        InitList();
        if (columns != null) { cols = columns; }
    }

    // 单列，用于简单的标签列表。
    public ListView(ListColumn<T> column) {
        InitList();
        if (column != null) { cols.Add(column); }
    }

    // 自定义行：模板构建每行的控件子树。
    public ListView(RowOf<T> row) {
        InitList();
        rowOf = row;
    }

    // 声明式构造后再给列（设计稿里声明的列表用默认构造函数，
    // 列在代码里补上：列标题多是本地化文本，属于代码而非设计）。
    public ListView<T> WithColumns(List<ListColumn<T>> columns) {
        cols = new List<ListColumn<T>>();
        if (columns != null) { cols = columns; }
        this.RetireRows();
        return this;
    }

    // 声明式构造后再给行模板（设计稿里声明的列表用
    // 默认构造函数，行模板在代码里补上）。
    public ListView<T> WithRow(RowOf<T> row) {
        rowOf = row;
        this.RetireRows();
        return this;
    }

    // 快捷添加一列文本列。
    public ListView<T> Column(string title, CellOf<T> cell) {
        if (cols == null) { cols = new List<ListColumn<T>>(); }
        cols.Add(new ListColumn<T>(title, cell));
        this.RetireRows();
        return this;
    }

    // 快捷添加指定权重的一列文本列。
    public ListView<T> Column(string title, int weight, CellOf<T> cell) {
        if (cols == null) { cols = new List<ListColumn<T>>(); }
        cols.Add(new ListColumn<T>(title, weight, cell));
        this.RetireRows();
        return this;
    }

    // 快捷添加一列控件插槽列（直接塞 Tag / Button / Switch 等任意 Control）。
    public ListView<T> SlotColumn(string title, CellSlotOf<T> slot) {
        if (cols == null) { cols = new List<ListColumn<T>>(); }
        cols.Add(ListColumn<T>.Slot(title, slot));
        this.RetireRows();
        return this;
    }

    // 快捷添加指定权重的控件插槽列。
    public ListView<T> SlotColumn(string title, int weight, CellSlotOf<T> slot) {
        if (cols == null) { cols = new List<ListColumn<T>>(); }
        cols.Add(ListColumn<T>.SlotWithWeight(title, weight, slot));
        this.RetireRows();
        return this;
    }

    // 控件类型标识（序列化/设计器用）。
    private bool layoutBodyActive;
    // Generated body is rebuilt from business declarations, never copied as authored content.
    public override void CloneContentTo(Control target, CloneTreeFn clone) {
        ListView<T> copy = (ListView<T>)target;
        copy.Bind(data);
        copy.WithColumns(cols);
        copy.WithRow(rowOf);
    }

    // Root owns fixed chrome; rowsBody alone consumes shared scrolling input.
    public override StyleBox ResolveStyle(App app, int state) {
        StyleBox box = base.ResolveStyle(app, state);
        box.overflowX = 0;
        box.overflowY = 0;
        box.overflow = 1;
        return box;
    }

    public override Rect ScrollViewport() {
        Rect view = base.ScrollViewport();
        int fixedH = this.HeaderHeight(this.App);
        if (fixedH > view.height) { fixedH = view.height; }
        if (fixedH < 0) { fixedH = 0; }
        return new Rect(view.x, view.y + fixedH, view.width, view.height - fixedH);
    }

    // Original data index, independent of structural filter/body children.
    public Control RowControl(int index) { return this.DataRow(index); }
    public int RowCount() { return this.Count(); }

    public override void Arrange(int x, int y, int w, int h) {
        bx = x; by = y; bw = w > 0 ? w : 0; bh = h > 0 ? h : 0;
        if (layingRows || rowsBody == null) { return; }
        layingRows = true;
        try {
            App app = this.FindApp();
            Control ownerParent = parent;
            this.BuildRows(app);
            if (this.FindApp() != app || parent != ownerParent || rowsStale) { return; }
            int requested = scroll.Get();
            Rect view = this.ScrollViewport();
            int ticket = rowsRevision;
            rowsBody.Arrange(view.x, view.y, view.width, view.height);
            if (ticket != rowsRevision || this.FindApp() != app || parent != ownerParent) { return; }
            if (requested != rowsBody.ScrollTop()) { rowsBody.SetScrollTop(requested); }
            if (ticket != rowsRevision || this.FindApp() != app || parent != ownerParent) { return; }
            this.LayoutBody();
        } finally { layingRows = false; }
    }

    // Compatibility SetScrollTop/ScrollTop project the body's committed value.
    public override void OnScrollChanged() {
        if (projectingScroll || rowsBody == null) { return; }
        App app = this.FindApp();
        Control ownerParent = parent;
        int ticket = rowsRevision;
        int requested = scrollY;
        if (scroll.Get() != requested) { scroll.Set(requested); }
        if (rowsBody.ScrollTop() != requested) { rowsBody.SetScrollTop(requested); }
        if (ticket != rowsRevision || this.FindApp() != app || parent != ownerParent) { return; }
        this.BodyScrolled();
    }

    public void BodyScrolled() {
        if (rowsBody == null || projectingScroll) { return; }
        projectingScroll = true;
        try {
            int value = rowsBody.ScrollTop();
            if (scroll.Get() != value) { scroll.Set(value); }
            if (scrollY != value || scrollX != 0) { this.CommitScrollOffset(0, value); }
        } finally { projectingScroll = false; }
        if (!layingRows) { this.LayoutBody(); }
    }

    public void LayoutBody() {
        if (rowsBody == null || layoutBodyActive) { return; }
        layoutBodyActive = true;
        try {
        App app = this.FindApp();
        Control ownerParent = parent;
        int ticket = rowsRevision;
        Rect view = rowsBody.ScrollViewport();
        rowsBody.scrollExtent = this.ContentHeight(app);
        rowsBody.scrollExtentX = view.width;
        // Read-only compatibility projection; root overflow modes are zero.
        scrollExtent = rowsBody.scrollExtent;
        scrollExtentX = rowsBody.scrollExtentX;
        int max = rowsBody.scrollExtent - view.height;
        if (max < 0) { max = 0; }
        int off = rowsBody.ScrollTop();
        if (off > max) { off = max; }
        if (off < 0) { off = 0; }
        if (off != rowsBody.ScrollTop()) { rowsBody.CommitScrollOffset(0, off); }
        if (ticket != rowsRevision || this.FindApp() != app || parent != ownerParent) { return; }
        int width = view.width;
        if (rowsBody.scrollExtent > view.height) { width = width - (app != null ? app.Scale(12) : 12); }
        if (width < 0) { width = 0; }
        int y = view.y - off;
        for (int i = 0; i < this.Count(); i = i + 1) {
            Control row = this.DataRow(i);
            bool shown = true;
            int rh = row != null ? this.RowExtent(app, row) : 0;
            bool onscreen = shown && y + rh > view.y && y < view.y + view.height;
            if (row != null) {
                if (!onscreen && app != null) { app.ReleaseInputSubtree(row); }
                if (ticket != rowsRevision || this.FindApp() != app || parent != ownerParent) { return; }
                // Reentrant cancellation can move a row; never take it back.
                if (row.parent == rowsBody) {
                    row.Arrange(view.x, shown ? y : view.y - rh - 1, width, rh);
                    if (ticket != rowsRevision || this.FindApp() != app || parent != ownerParent) { return; }
                }
            }
            if (shown) { y = y + rh; }
        }
        this.BodyScrolled();
        } finally { layoutBodyActive = false; }
    }

    private int DataIndexAt(int x, int y) {
        if (rowsBody == null) { return -1; }
        Rect view = rowsBody.ScrollViewport();
        if (!view.Contains(x, y)) { return -1; }
        int top = view.y - rowsBody.ScrollTop();
        for (int i = 0; i < this.Count(); i = i + 1) {
            if (!(true)) { continue; }
            Control row = this.DataRow(i);
            int height = row != null ? this.RowExtent(this.App, row) : (this.Templated() ? 0 : this.RowHeight(this.App));
            if (y >= top && y < top + height) { return i; }
            top = top + height;
        }
        return -1;
    }

    private bool RowEditorOwnsPrimary(Control source) {
        bool editing = false;
        Control node = source;
        while (node != null && node != rowsBody && node != this) {
            if ((node.InputFocusCapabilities() & 2) != 0) { editing = true; }
            node = node.parent;
        }
        return node == rowsBody && editing;
    }

    public override void OnPointerDown(RoutedEventArgs e) {
        base.OnPointerDown(e);
        if (e.handled || this.IsDisabled()) { return; }
        if (this.App.window.EventButton() == 0 && this.RowEditorOwnsPrimary(e.originalSource)) { return; }
        int index = this.DataIndexAt(e.x, e.y);
        if (index < 0 || !this.Selectable(index)) { return; }
        App app = this.App;
        if (app.window.EventButton() == 1) {
            sel = index; Context.PostS(this); this.NoteSelfDamage(app); e.Handle();
        } else if (app.window.EventButton() == 0 && dragOut.Count > 0
                && (app.GetCapturedPointer() == null || app.GetCapturedPointer() == this)) {
            dragOutFrom = index;
            app.CapturePointer(this, true);
        }
    }

    public override void OnPointerUp(RoutedEventArgs e) {
        base.OnPointerUp(e);
        App app = this.App;
        if (e.handled || app.window.EventButton() != 0 || dragOutFrom < 0) { return; }
        int from = dragOutFrom;
        dragOutFrom = -1;
        if (app.GetCapturedPointer() == this) { app.ReleasePointerCapture(); }
        if (!this.ContainsPoint(e.x, e.y, e.pointerType) && this.Has(from)) {
            for (int i = 0; i < dragOut.Count; i = i + 1) { dragOut[i](from); }
        }
    }

    public override void OnPointerCancel(RoutedEventArgs e) {
        base.OnPointerCancel(e);
        dragOutFrom = -1;
        App app = this.App;
        if (app != null && app.GetCapturedPointer() == this) { app.ReleasePointerCapture(); }
    }

    public override void OnClick(RoutedEventArgs e) {
        base.OnClick(e);
        if (e.handled || this.IsDisabled() || this.RowEditorOwnsPrimary(e.originalSource)) { return; }
        int index = this.DataIndexAt(e.x, e.y);
        if (index < 0 || !this.Selectable(index)) { return; }
        App app = this.App;
            int mods = app.window.EventMods();
            if (multi && Modifiers.HasCtrl(mods)) {
                // 把该行加入/移出多选集合。
                bool was = false;
                for (int mi = 0; mi < marks.Count; mi = mi + 1) {
                    if (marks[mi] == index) { marks.RemoveAt(mi); was = true; break; }
                }
                if (sel == index) { sel = -1; was = true; }
                if (!was) { marks.Add(index); if (sel < 0) { sel = index; } }
                Select.PostS(this);
            } else if (multi && Modifiers.HasShift(mods) && sel >= 0) {
                // 把选中项从聚焦行扩展到本行；范围内的禁用行跳过。
                int a = sel;
                int b = index;
                if (b < a) { int tmp = a; a = b; b = tmp; }
                int r = a;
                while (r <= b) {
                    if (this.Selectable(r) && !this.IsMarked(r)) { marks.Add(r); }
                    r = r + 1;
                }
                Select.PostS(this);
            } else {
                // 激活 = 同一行的第二次点击，或者一次真正的双击。
                // 后者也要算，因为两次点击之间行可能被重新绑定（宿主
                // 每次刷新数据都会重建行），那时 sel 已经不等于 index，
                // 只看「又点了同一行」会把双击吞掉。
                bool again = (sel == index) || app.DoubleClickNow();
                if (multi) { marks = new List<int>(); }
                sel = index;
                if (again) { Activate.PostS(this); }
                else { Select.PostS(this); }
            }
            this.NoteSelfDamage(app);
        e.Handle();
    }

    // Uses the existing gesture name; stationary delivery must come from App's
    // shared gesture state machine, never another paint poll or component timer.
    public override void OnRoutedEvent(RoutedEventArgs e) {
        if (!e.handled && e.eventName == "LongPress" && !this.IsDisabled()) {
            int index = this.DataIndexAt(e.x, e.y);
            if (index >= 0 && this.Selectable(index)) {
                sel = index;
                dragOutFrom = -1;
                App app = this.App;
                if (app.GetCapturedPointer() == this) { app.ReleasePointerCapture(); }
                Context.PostS(this);
                this.NoteSelfDamage(app);
                e.Handle();
            }
        }
        if (!e.handled) { base.OnRoutedEvent(e); }
    }

    public override string Kind() { return "ListView"; }

    // 覆写：CSS 类型选择器名（"list"）。
    public override Control HitTest(int x, int y, int pointerType) {
        if (!this.StyleVisible() || !this.ContainsPoint(x, y, pointerType)) { return null; }
        this.Arrange(bx, by, bw, bh);
        return base.HitTest(x, y, pointerType);
    }

    public override string StyleType() { return "list"; }

    // ---- 数据 ----

    // 绑定调用方的列表。列表不拷贝，因此这是其实时视图；
    // 需要重建自定义行的变更之后，调用 Refresh()。
    public ListView<T> Bind(List<T> src) {
        if (data == src) { return this; }
        data = src;
        this.RetireRows();
        if (sel >= this.Count()) { sel = -1; }
        int mi = marks.Count - 1;
        while (mi >= 0) {
            if (marks[mi] >= this.Count()) { marks.RemoveAt(mi); }
            mi = mi - 1;
        }
        return this;
    }

    // 标记绑定数据已变更，自定义行将在下一帧
    // 重建。任意线程调用都安全。
    public void Refresh() {
        if (!Dispatcher.CheckUiThread()) {
            ListRefreshAction<T> action = new ListRefreshAction<T>(this);
            Dispatcher.Post(action.Run);
            return;
        }
        this.RetireRows();
    }

    // 当前绑定数据的行数。
    public int Count() {
        if (data == null) { return 0; }
        return data.Count;
    }

    // 选中行号（-1 = 无选中）。
    public int SelectedIndex() { return sel; }

    // 是否有一行处于选中状态。
    public bool HasSelection() { return sel >= 0 && sel < this.Count(); }

    // 选中的实体；仅在 HasSelection() 为真时有效。
    public T Selected() { return data[sel]; }

    // 当前行总高（模板行 = 实测 prefH 累计，列模式 = 行数×行高）。
    // 滚动条几何与拖拽期望的公共推导点，测试与宿主同式复算用。
    public int ContentHeightForTest() { return this.ContentHeight(this.App); }
    public int ContentHeightForTest(App app) { return this.ContentHeight(app); }

    // `row` 是否在数据范围内。
    public bool Has(int row) { return row >= 0 && row < this.Count(); }

    // `row` 处的实体；仅在 Has(row) 为真时有效。
    public T ItemAt(int row) { return data[row]; }

    // 像点击那样移动选中项，发生变化时触发 Select。
    // 禁用行不接收：与鼠标路径同一道门。
    public void SelectIndex(int row) {
        if (row < -1 || row >= this.Count()) { return; }
        if (row >= 0 && !this.Selectable(row)) { return; }
        if (sel == row) { return; }
        sel = row;
        Select.PostS(this);
    }

    // 清空选中与全部多选标记。
    public void ClearSelection() { sel = -1; marks = new List<int>(); }

    // 启用多选（Ctrl+点击切换、Shift+点击范围选择）。
    public ListView<T> WithMultiSelect() { multi = true; return this; }

    // 声明哪些行可选（分组标题档、条件未满足的禁用项等非选项）。
    // 不可选行对点击/Ctrl+点击/Shift+范围/右键/长按全部无反应，
    // 悬停与选中带不出现，文本以 `disabled` 状态弱色呈现；
    // 模板模式下行控件自带的 `Disabled` 同样生效。
    public ListView<T> WithSelectable(RowGate<T> gate) {
        onlySelectable = gate;
        return this;
    }

    // `row` 属于多选集合（或为聚焦行）时为 true。
    public bool IsMarked(int row) {
        if (row == sel && sel >= 0) { return true; }
        for (int i = 0; i < marks.Count; i = i + 1) {
            if (marks[i] == row) { return true; }
        }
        return false;
    }

    // 所有选中的行索引（标记加聚焦行），升序排列。
    public List<int> SelectedIndices() {
        List<int> outp = new List<int>();
        int n = this.Count();
        for (int i = 0; i < n; i = i + 1) {
            if (this.IsMarked(i)) { outp.Add(i); }
        }
        return outp;
    }

    // 选中的行数。
    public int SelectionCount() { return this.SelectedIndices().Count; }

    // ---- 处理器 ----

    // 某行被选中时回调。
    public ListView<T> OnSelect(Action a) { Select.Add(a); return this; }

    // 选中的行再次被点击（打开 / 深入）时回调。
    public ListView<T> OnActivate(Action a) { Activate.Add(a); return this; }

    // 某行被右键点击时回调。
    public ListView<T> OnContext(Action a) { Context.Add(a); return this; }

    // 订阅「行被拖出列表」手势：在某行上按下、拖到列表矩形之外
    // 松开时回调该行下标。列表只识别手势并报告下标，是否开窗、
    // 开成什么窗口由宿主决定；在列表矩形内松开不算数（那次手势
    // 仍归滚动/选择），右键与长按菜单不受影响。
    public ListView<T> OnDragOut(RowDragOut a) { dragOut.Add(a); return this; }

    // 列表为空时显示的文本。
    public ListView<T> EmptyText(string text) { Empty = text; return this; }


    // 是否拥有自定义插槽列。
    public bool HasSlotColumns() {
        if (cols == null) { return false; }
        for (int i = 0; i < cols.Count; i = i + 1) {
            if (cols[i].slot != null) { return true; }
        }
        return false;
    }

    // 为某一行实体构建基于列配置与插槽的复合控件行。
    public Control BuildCompositeRow(T item) {
        Row r = new Row().AlignCenter();
        r.gap = 8;
        for (int c = 0; c < cols.Count; c = c + 1) {
            ListColumn<T> col = cols[c];
            Control cellWidget = null;
            if (col.slot != null) {
                cellWidget = col.slot(item);
            } else if (col.cell != null) {
                cellWidget = new Label(col.cell(item));
            }
            if (cellWidget != null) {
                if (col.weight > 0) {
                    cellWidget.grow = true;
                }
                r.With(cellWidget);
            }
        }
        return r;
    }

    // 是否为模板（自定义行或含插槽列）模式。
    public bool Templated() { return rowOf != null || this.HasSlotColumns(); }

    // 行高：样式 height 优先，否则主题 large。
    public int RowHeight() { return this.RowHeight(this.App); }
    public int RowHeight(App app) {
        app = this.ResolveApp(app);
        if (app == null) { return 32; }
        StyleBox s = this.ResolveStyleAs(app, "list", Class, Style.SNormal());
        return s.HeightOr(app.theme.heightLarge);
    }

    // 表头高度：≥2 列且未标 headless 时为主题 small，否则 0。
    public int HeaderHeight() { return this.HeaderHeight(this.App); }
    public int HeaderHeight(App app) {
        app = this.ResolveApp(app);
        if (app == null) { return 0; }
        if (cols.Count < 2 || Style.Has(Class, "headless")) { return 0; }
        return app.theme.heightSmall;
    }

    // 通过行模板为每个实体重建一个子控件。子控件
    // 在此测量，因为发现需要重建时，树的测量阶段已越过
    // 它们。
    public void BuildRows() { this.BuildRows(this.App); }
    public void BuildRows(App app) {
        App host = this.FindApp();
        Control ownerParent = parent;
        app = host != null ? host : this.ResolveApp(app);
        if (buildingRows || (!rowsStale && builtFor == this.Count())) { return; }
        buildingRows = true;
        try {
            this.RetireRows();
            if (this.FindApp() != host || parent != ownerParent) { return; }
            int ticket = rowsRevision;
            List<T> source = data;
            RowOf<T> template = rowOf;
            int n = this.Count();
            List<Control> mapped = new List<Control>();
            dataRows = mapped;
            for (int i = 0; i < n; i = i + 1) {
                Control row = null;
                WidgetId.Push(i);
                try {
                    if (template != null) { row = template(source[i]); }
                    else if (this.HasSlotColumns()) { row = this.BuildCompositeRow(source[i]); }
                } finally { WidgetId.Pop(); }
                if (ticket != rowsRevision || this.FindApp() != host || parent != ownerParent) { return; }
                if (row != null && rowsBody.IndexOf(row) < 0 && rowsBody.Adoptable(row)) {
                    rowsBody.Add(row);
                    if (ticket != rowsRevision || this.FindApp() != host || parent != ownerParent) {
                        if (ticket != rowsRevision && this.FindApp() == host && parent == ownerParent
                            && row.parent == rowsBody) { rowsBody.Remove(row); }
                        return;
                    }
                }
                else { row = null; }
                if (row != null && row.parent != rowsBody) { row = null; }
                mapped.Add(row);
                if (row != null) {
                    if (onlySelectable != null && !onlySelectable(source[i])) {
                        row.Disabled.Set(true);
                    }
                    if (ticket != rowsRevision || this.FindApp() != host || parent != ownerParent) { return; }
                    row.MeasureTree(app);
                }
                if (ticket != rowsRevision || this.FindApp() != host || parent != ownerParent) { return; }
            }
            rowsStale = false;
            builtFor = n;
        } finally { buildingRows = false; }
    }

    // 行的总高度；当样式表未声明高度时，列布局用它
    // 来确定列表尺寸。
    public int ContentHeight() { return this.ContentHeight(this.App); }
    public int ContentHeight(App app) {
        app = this.ResolveApp(app);
        if (this.Templated()) {
            int h = 0;
            for (int i = 0; i < this.Count(); i = i + 1) {
                Control row = this.DataRow(i);
                if (row != null) { h = h + this.RowExtent(app, row); }
            }
            return h;
        }
        return this.Count() * this.RowHeight(app);
    }

    // 模板行实际占高（prefH 未测出时退回统一行高）。
    public int RowExtent(Control row) { return this.RowExtent(this.App, row); }
    public int RowExtent(App app, Control row) {
        app = this.ResolveApp(app);
        int h = row.prefH;
        if (h <= 0) { h = this.RowHeight(app); }
        return h;
    }

    // 行命中 id 块：每行一个，基于实例 CommonId 隔离，永不全局冲突。
    private void EnsureRowIds() {
        if (rowHitBase >= 0) { return; }
        rowHitBase = this.CommonId() * 10000;
        rowHitCount = 10000;
    }

    // 处理某行矩形的选择 / 激活 / 右键菜单。返回其注册的 id，
    // 调用方可据此绘制 hover 状态。
    // 每帧一次的「拖出行」判定（OnPaint 顶部调用）：按下帧记下行
    // 下标，松开帧若指针已在列表矩形之外则回调。下标只在按下帧
    // 认，因为拖到窗口外时命中测试里已经没有行可归属。
    private void DragOutTick(App app) {
        if (dragOut.Count == 0) { return; }
        int ek = app.EventKind();
        if (ek == 2) {
            int hit = app.focus.pressedId;
            if (rowHitBase >= 0 && hit >= rowHitBase
                && hit < rowHitBase + rowHitCount) {
                dragOutFrom = hit - rowHitBase;
            } else {
                dragOutFrom = -1;
            }
            return;
        }
        if (ek != 3 || dragOutFrom < 0) { return; }
        int from = dragOutFrom;
        dragOutFrom = -1;
        int mx = app.mouseX;
        int my = app.mouseY;
        bool inside = mx >= bx && mx < bx + bw && my >= by && my < by + bh;
        if (inside || !this.Has(from)) { return; }
        for (int i = 0; i < dragOut.Count; i = i + 1) {
            dragOut[i](from);
        }
    }

    public int RowInteract(int index, int x, int y, int w, int h) {
        return this.RowInteract(this.App, index, x, y, w, h);
    }
    public int RowInteract(App app, int index, int x, int y, int w, int h) {
        app = this.ResolveApp(app);
        if (app == null || app.hitTester == null) { return 0; }
        this.EnsureRowIds();
        int id = rowHitBase + index;
        app.hitTester.RegisterRect(id, x, y, w, h, 0);
        // 禁用行：命中区照常注册（id 块稳定依赖每行都占号），
        // 但五种选择手势全部不认，悬停高亮也不出现。
        bool live = this.Selectable(index);
        if (live && app.focus.IsHovered(id)) { hover = index; }
        // 触摸长按等价右键：按住行上不动打开上下文菜单。行是
        // 真实注册 id，无需哨兵；轮询必须赶在下方 ClickTarget
        // 早退之前——那个目标在按住期间是上一帧的滞留值，会
        // 把还没成为点击目标的行挡在长按之外。
        if (live && app.TouchDevice() && app.PollLongPress(id)) {
            sel = index;
            Context.PostS(this);
            this.NoteSelfDamage(app);
            return id;
        }
        // 点击目标由 App 在事件到达时对着「上一帧完整的」命中区解析，
        // 因此行内的子控件（模板行里的关闭按钮、开关）也在其中。
        // 行若在这里自己再做一次 HitTest，只能看到本帧已经注册的那
        // 一半——子控件是行之后才绘制、才注册的——于是行会抢走本该
        // 属于按钮的那一次点击，按钮看着能按却永远没反应。
        if (app.ClickTarget() != id && app.RightPressTarget() != id) {
            return id;
        }
        if (live && app.RightPressTarget() == id && app.EventKind() == 2
            && app.window.EventButton() == 1) {
            sel = index;
            Context.PostS(this);
            this.NoteSelfDamage(app);
            return id;
        }
        if (live && app.ClickTarget() == id && app.ClickAvailable()) {
            int mods = app.window.EventMods();
            if (multi && Modifiers.HasCtrl(mods)) {
                // 把该行加入/移出多选集合。
                bool was = false;
                for (int mi = 0; mi < marks.Count; mi = mi + 1) {
                    if (marks[mi] == index) { marks.RemoveAt(mi); was = true; break; }
                }
                if (sel == index) { sel = -1; was = true; }
                if (!was) { marks.Add(index); if (sel < 0) { sel = index; } }
                Select.PostS(this);
            } else if (multi && Modifiers.HasShift(mods) && sel >= 0) {
                // 把选中项从聚焦行扩展到本行；范围内的禁用行跳过。
                int a = sel;
                int b = index;
                if (b < a) { int tmp = a; a = b; b = tmp; }
                int r = a;
                while (r <= b) {
                    if (this.Selectable(r) && !this.IsMarked(r)) { marks.Add(r); }
                    r = r + 1;
                }
                Select.PostS(this);
            } else {
                // 激活 = 同一行的第二次点击，或者一次真正的双击。
                // 后者也要算，因为两次点击之间行可能被重新绑定（宿主
                // 每次刷新数据都会重建行），那时 sel 已经不等于 index，
                // 只看「又点了同一行」会把双击吞掉。
                bool again = (sel == index) || app.DoubleClickNow();
                if (multi) { marks = new List<int>(); }
                sel = index;
                if (again) { Activate.PostS(this); }
                else { Select.PostS(this); }
            }
            this.NoteSelfDamage(app);
        }
        return id;
    }

    // 选中一行只改变列表自己的像素，因此把损伤限定在控件矩形
    // 内，而不是整窗重绘（弹层里的列表会自动退回整窗重绘：
    // 覆盖层存在时 NoteDamage 本就不生效）。需要更大范围的宿主
    // 在自己的 Select/Activate 处理器里调用 RequestRedraw。
    private void NoteSelfDamage(App app) {
        app.NoteDamage(bx, by, bw, bh);
        app.window.Wake();
    }

    // `row` 是否可选（可用）：在数据范围内、未被 WithSelectable
    // 的门挡下，且（模板模式）行控件自身没有 Disabled。禁用项
    // 对一切选择途径关闭——鼠标的五种手势、程序化 SelectIndex、
    // 悬停高亮，视觉上以 `disabled` 状态呈现弱色。
    public bool Selectable(int row) {
        if (!this.Has(row)) { return false; }
        if (onlySelectable != null && !onlySelectable(data[row])) { return false; }
        Control control = this.DataRow(row);
        if (control != null && control.IsDisabled()) { return false; }
        return true;
    }

    // 空列表时居中绘制 Empty 提示文本。
    public void PaintEmpty() {
        this.PaintEmpty(this.App);
    }
    public void PaintEmpty(App app) {
        if (Empty == "") { return; }
        app = this.ResolveApp(app);
        if (app == null || app.canvas == null) { return; }
        Theme t = app.theme;
        StyleBox empty = Style.Part(app, "listview", "empty", "", Class, "",
                                    Style.SNormal());
        int fs = empty.FontOr(Style.FontFallback(app, "small"));
        int fw = Canvas.MeasureText(Empty, fs);
        app.canvas.DrawText(bx + (bw - fw) / 2,
            Canvas.CenterTextY(by, bh, fs),
            Empty, empty.FgOr(0),
            fs);
    }

    // 当前盒子的列宽：某列的 weight 是它对整行的占比，
    // 权重全为 0 时均分。
    public List<int> ColumnWidths(int rowW) {
        List<int> res = new List<int>();
        int total = 0;
        int i = 0;
        for (; i < cols.Count; i = i + 1) {
            int wt = cols[i].weight;
            if (wt <= 0) { wt = 1; }
            total = total + wt;
        }
        if (total <= 0) { return res; }
        int used = 0;
        i = 0;
        while (i < cols.Count) {
            int wt = cols[i].weight;
            if (wt <= 0) { wt = 1; }
            int cw = rowW * wt / total;
            if (i == cols.Count - 1) { cw = rowW - used; }
            used = used + cw;
            res.Add(cw);
            i = i + 1;
        }
        return res;
    }

    // 绘制表头：底色、分隔线与各列标题（超宽省略）。
    public void PaintHeader(int headH) {
        this.PaintHeader(this.App, headH);
    }
    public void PaintHeader(App app, int headH) {
        if (headH <= 0) { return; }
        app = this.ResolveApp(app);
        if (app == null || app.canvas == null) { return; }
        Canvas c = app.canvas;
        Theme t = app.theme;
        StyleBox header = Style.Part(app, "listview", "header", "", Class, "",
                                     Style.SNormal());
        StyleBox divider = Style.Part(app, "listview", "divider", "", Class, "",
                                      Style.SNormal());
        StyleBox column = Style.Part(app, "listview", "column", "", Class, "",
                                      Style.SNormal());
        int pad = t.paddingMedium;
        c.FillRect(bx, by, bw, headH, header.BgOr(0));
        c.FillRect(bx, by + headH - 1, bw, 1, divider.BgOr(0));
        List<int> ws = this.ColumnWidths(bw - pad * 2);
        int cx = bx + pad;
        int headerFont = column.FontOr(Style.FontFallback(app, "tiny"));
        int ty = Canvas.CenterTextY(by, headH, headerFont);
        for (int i = 0; i < ws.Count; i = i + 1) {
            int cw = ws[i];
            string label = Ellipsis.Fit(cols[i].title, cw - pad, headerFont);
            int tx = cx;
            if (cols[i].right) {
                tx = cx + cw - pad - Canvas.MeasureText(label, headerFont);
            }
            c.DrawText(tx, ty, label, column.FgOr(0),
                       headerFont);
            cx = cx + cw;
        }
    }

    // 列布局模式的行区：滚轮/滚动条、逐行命中与单元格文本。
    public void PaintColumnRows(int headH) {
        this.PaintColumnRows(this.App, headH);
    }
    public void PaintColumnRows(App app, int headH) {
        app = this.ResolveApp(app);
        if (app == null || app.canvas == null) { return; }
        Canvas c = app.canvas;
        Theme t = app.theme;
        StyleBox rowNormal = this.BareBox(app, "listrow", Style.SNormal());
        StyleBox rowSelected = this.BareBox(app, "listrow", Style.SSelected());
        StyleBox rowHover = this.BareBox(app, "listrow", Style.SHover());
        StyleBox divider = Style.Part(app, "listview", "divider", "", Class, "",
                                      Style.SNormal());
        StyleBox cell = Style.Part(app, "listview", "cell", "", Class, "",
                                   Style.SNormal());
        StyleBox secondary = Style.Part(app, "listview", "cell", "", Class + " secondary",
                                        "", Style.SNormal());
        StyleBox cellOff = Style.Part(app, "listview", "cell", "", Class, "",
                                      Style.SDisabled());
        int cellFont = cell.FontOr(Style.FontFallback(app, "small"));
        int secondaryFont = secondary.FontOr(cellFont);
        int cellOffFont = cellOff.FontOr(cellFont);
        int rowH = this.RowHeight(app);
        Rect bodyView = rowsBody.ScrollViewport();
        int viewY = bodyView.y;
        int viewH = bodyView.height;
        if (viewH <= 0 || rowH <= 0) { return; }
        int n = this.Count();
        int contentH = n * rowH;
        int off = rowsBody.ScrollTop();
        bool overflow = contentH > viewH;
        // 行区给滚动条让位：条带画在视口右缘，行高亮/文本若仍占满
        // 整个盒子宽度，就会被轨道压在下面（选中色一直延伸进条带）。
        int barW = app.Scale(12);
        int rowW = bodyView.width;
        if (overflow) { rowW = bodyView.width - barW; }
        if (rowW < 0) { rowW = 0; }
        int pad = t.paddingMedium;
        List<int> ws = this.ColumnWidths(rowW - pad * 2);
        // 选中/悬停带与轨道之间留一道缝（同 ArrangeRows）：高亮若
        // 正好贴着 rowW 右缘，会和紧随其后的滚动条轨道连成一条色带。
        int hotW = rowW;
        if (overflow) { hotW = rowW - app.Scale(4); }
        if (hotW < 0) { hotW = 0; }

        int first = off / rowH;
        int last = (off + viewH) / rowH;
        if (last >= n) { last = n - 1; }
        c.PushClip(bodyView.x, viewY, rowW, viewH);
        int i = first;
        while (i <= last) {
            int ry = viewY + i * rowH - off;
            int id = this.CommonId() + i;
            if (i == sel || (multi && this.IsMarked(i))) {
                c.FillRect(bodyView.x, ry, hotW, rowH, rowSelected.BgOr(rowNormal.BgOr(0)));
            }
            else if (this.Selectable(i) && app.focus.IsHovered(id)) {
                c.FillRect(bodyView.x, ry, hotW, rowH, rowHover.BgOr(0));
            }
            if (i > first || off > 0) { c.FillRect(bodyView.x, ry, rowW, 1, divider.BgOr(0)); }
            int rowFont = cellFont;
            int ty = Canvas.CenterTextY(ry, rowH, rowFont);
            int cx = bodyView.x + pad;
            for (int k = 0; k < ws.Count; k = k + 1) {
                int cw = ws[k];
                StyleBox cs = k > 0 ? secondary : cell;
                int csFont = k > 0 ? secondaryFont : cellFont;
                if (!this.Selectable(i)) { cs = cellOff; csFont = cellOffFont; }
                string s = Ellipsis.Fit(cols[k].TextOf(data[i]), cw - pad,
                                        csFont);
                int color = cs.FgOr(0);
                int tx = cx;
                if (cols[k].right) {
                    tx = cx + cw - pad - Canvas.MeasureText(s, csFont);
                }
                c.DrawText(tx, ty, s, color,
                           csFont);
                cx = cx + cw;
            }
            i = i + 1;
        }
        c.PopClip();
    }

    // 在此盒子内按滚动偏移量布局模板行；
    // 从 OnPaint 运行，即在子控件绘制自身之前，
    // 因此树依然是它们坐标的唯一所有者。
    public void ArrangeRows(int headH) {
        this.ArrangeRows(this.App, headH);
    }
    public void ArrangeRows(App app, int headH) {
        app = this.ResolveApp(app);
        if (app == null) { return; }
        Rect bodyView = rowsBody.ScrollViewport();
        int viewY = bodyView.y;
        int viewH = bodyView.height;
        if (viewH <= 0) { return; }
        int contentH = this.ContentHeight(app);
        int off = rowsBody.ScrollTop();
        // 行区给滚动条让位（与 PaintColumnRows 同一规则）：模板行
        // 的排布宽度与命中矩形都收窄到滚动条带左侧，行的选中/悬停
        // 高亮就不会延伸进轨道。
        bool overflow = contentH > viewH;
        int barW = app.Scale(12);
        int rowW = bodyView.width;
        if (overflow) { rowW = bodyView.width - barW; }
        if (rowW < 0) { rowW = 0; }
        Theme t = app.theme;
        StyleBox rowNormal = this.BareBox(app, "listrow", Style.SNormal());
        StyleBox rowSelected = this.BareBox(app, "listrow", Style.SSelected());
        StyleBox rowHover = this.BareBox(app, "listrow", Style.SHover());
        // 选中/悬停带与轨道之间留一道缝：高亮若正好贴着 rowW 右缘，
        // 会和紧随其后的滚动条轨道连成一条色带，看着像没让位。
        int hotW = rowW;
        if (overflow) { hotW = rowW - app.Scale(4); }
        if (hotW < 0) { hotW = 0; }
        int y = viewY - off;
        for (int i = 0; i < this.Count(); i = i + 1) {
            Control row = this.DataRow(i);
            if (row == null) { continue; }
            int rh = this.RowExtent(app, row);
            bool onscreen = y + rh > viewY && y < viewY + viewH;
            if (onscreen) {
                int id = this.CommonId() + i;
                if (i == sel || (multi && this.IsMarked(i))) {
                    app.canvas.FillRect(bodyView.x, y, hotW, rh,
                        rowSelected.BgOr(rowNormal.BgOr(0)));
                }
                else if (this.Selectable(i) && app.focus.IsHovered(id)) {
                    app.canvas.FillRect(bodyView.x, y, hotW, rh, rowHover.BgOr(0));
                }
            }
            y = y + rh;
        }
    }

    // ---- 保留模式钩子 ----

    // 覆写：模板行按需重建后，内容高度加表头得出偏好高度。
    public override void OnMeasure(App app) {
        if (this.Templated()) { this.BuildRows(app); }
        prefH = this.ContentHeight(app) + this.HeaderHeight(app);
    }

    // 覆写：按 `list` 样式画可选表面，再画表头与各行
    // （模板行走行控件排布，列模式直接绘制）。
    public override void OnPaint(App app) {
        StyleBox s = this.ResolveStyleAs(app, "list", Class, Style.SNormal());
        // 表面由样式表决定：`list` 默认透明，因此
        // 卡片内的列表会透出卡片（磨砂皮肤下透出玻璃），
        // 而不是盖上一块不透明面板。皮肤若
        // 需要表面，声明背景色即可在此生效。
        if (!Style.Has(Class, "flat") && s.bg != 0) {
            app.canvas.SurfaceRoundRect(bx, by, bw, bh,
                s.RadiusOr(app.theme.borderRadiusMedium),
                s.bg, s.BorderOr(app.theme.borderSecondary), s.BorderWOr(1));
        }

        int headH = this.HeaderHeight(app);
        this.PaintHeader(app, headH);
        if (this.Count() == 0) {
            this.PaintEmpty(app);
            return;
        }
        // Body owns row drawing and shared scrollbar traversal.
    }

    // 覆写：公共事件之外提供 "Select"/"Activate"/"Context"。
    public override List<string> Events() {
        List<string> e = Control.CommonEvents();
        e.Add("Select");
        e.Add("Activate");
        e.Add("Context");
        return e;
    }

    // 将列表的语义事件（Select/Activate/Context）路由到对应的
    // UiEvent 字段；其余事件落入 `On` 上的通用事件包
    // （其 AddByName 忽略不认识的名称，因此 JSON/设计器中的 `onSelect`
    // 处理器不会静默地永远不执行）。
    public override void BindEvent(string evt, Action a) {
        if (evt == "Select") { Select.Add(a); return; }
        if (evt == "Activate") { Activate.Add(a); return; }
        if (evt == "Context") { Context.Add(a); return; }
        On.AddByName(evt, a);
    }

    // <see cref="BindEvent"/> 的 sender 通道（S = Sender）：
    // 特化事件接本控件的 UiEvent，通用事件按名路由。
    public override void BindEventS(string evt, ControlEvent a) {
        if (evt == "Select") { Select.AddS(a); return; }
        if (evt == "Activate") { Activate.AddS(a); return; }
        if (evt == "Context") { Context.AddS(a); return; }
        On.AddByNameS(evt, a);
    }

}

class ListRefreshAction<T> {
    private weak ListView<T> owner;
    public ListRefreshAction(ListView<T> value) { owner = value; }
    public void Run() {
        ListView<T> target = owner;
        if (target != null) { target.Refresh(); }
    }
}

// Structural region only: the inherited Control scroll engine owns all input and bars.
class ListRowsPanel<T> : Panel {
    private weak ListView<T> owner;
    public ListRowsPanel(ListView<T> value) { owner = value; }
    public override StyleBox ResolveStyle(App app, int state) {
        StyleBox box = base.ResolveStyle(app, state);
        box.overflow = 1;
        box.overflowX = 0;
        box.overflowY = 2;
        return box;
    }
    public override void Arrange(int x, int y, int w, int h) {
        bx = x; by = y; bw = w > 0 ? w : 0; bh = h > 0 ? h : 0;
        if (owner != null) { owner.LayoutBody(); }
    }
    public override void OnScrollChanged() {
        if (owner != null) { owner.BodyScrolled(); }
    }
    public override void OnPaint(App app) {
        if (owner == null) { return; }
        if (owner.Templated()) { owner.ArrangeRows(app, owner.HeaderHeight(app)); }
        else { owner.PaintColumnRows(app, owner.HeaderHeight(app)); }
    }
}
