using System.Collections.Generic;
using System;
using Gui;
using Gui.Backend;
namespace Gui.Widget;
public delegate void RowDragOut(int index);
// 绑定到调用方自身数据的列表。只需提供三样东西——行
// 长什么样、数据、处理器——布局一概不用管：
// 控件位于树中，盒子由 CSS 决定，因此调用处无需计算
// 矩形或维护行模型。
// files.Bind(model.files);          // 调用方的 List<FileItem>
// files.OnSelect(OpenSelected);
// side.Add(files);
// 行也可以是独立的组件而非文本列——
// 模板返回任意控件即可：
// 处理器被编排到 UI 线程执行（UiEvent.Post），因此后台
// 任务修改绑定列表并调用 Refresh() 也是安全的。
[ControlKind(Of = "string")]  // 按名构造（HTML/设计文档）造 string 实例
public partial class ListView<T> : RowListBase {
    public override Control CreateCloneShell() { return new ListView<T>(); }
    // 调用方的数据。不做任何拷贝：每帧都从中读取行，
    // 所以修改列表后，下一次绘制即可生效。
    public List<T> data;
    public List<ListColumn<T>> cols;
    public RowOf<T> rowOf;
    public int sel;
    public int hover;
    public RowGate<T> onlySelectable;
    public int rowSeqBase;
    public List<RowDragOut> dragOut;
    public int dragOutFrom;
    public static int RowIdReserve() { return 4096; }
    // 某行被选中（读取 SelectedIndex / Selected）。
    [Event]
    public UiEvent Select;
    private int filterRevision;
    private StyleCacheStamp lvStamp;
    private StyleBox lvHeader;
    private StyleBox lvDivider;
    private StyleBox lvColumn;
    private StyleBox lvRowNorm;
    private StyleBox lvRowSel;
    private StyleBox lvRowHover;
    private StyleBox lvCell;
    private StyleBox lvSecondary;
    private StyleBox lvCellOff;
    private List<int> cachedColWidths;
    private void InitList() {
        this.InitRowList("list");
        Select = new UiEvent();
        data = null;
        cols = new List<ListColumn<T>>();
        rowOf = null;
        sel = -1;
        hover = -1;
        onlySelectable = null;
        rowSeqBase = -1;
        dragOut = new List<RowDragOut>();
        dragOutFrom = -1;
    }
    public ListView() { InitList(); }
    public ListView(List<ListColumn<T>> columns) {
        InitList();
        if (columns != null) { cols = columns; }
    }
    public ListView(ListColumn<T> column) {
        InitList();
        if (column != null) { cols.Add(column); }
    }
    public ListView(RowOf<T> row) {
        InitList();
        rowOf = row;
    }
    public List<T> ItemsSource {
        get { return data; }
        set { this.Bind(value); }
    }
    public List<ListColumn<T>> Columns {
        get { return cols; }
        set { this.WithColumns(value); }
    }
    public RowOf<T> RowTemplate {
        get { return rowOf; }
        set { this.WithRow(value); }
    }
    public RowGate<T> SelectablePredicate {
        get { return onlySelectable; }
        set { onlySelectable = value; }
    }
    public int SelectedIndexValue {
        get { return sel; }
        set { this.SelectIndex(value); }
    }
    public void SetSelectedProp(int idx) {
        if (idx >= -1 && (data == null || idx < this.Count())) { sel = idx; }
        else { sel = -1; }
        this.Invalidate();
    }
    public void SetEmptyProp(string val) {
        Empty = val != null ? val : "";
        this.Invalidate();
    }
    protected override List<PropSpec> DefineProps() {
        List<PropSpec> ps = new List<PropSpec>();
        ps.Add(PropSpec.Int("value", "Selected").DefaultBinding().Field("sel").Setter("SetSelectedProp").Also("sel").Also("selected"));
        ps.Add(PropSpec.Bool("multi", "Multi select").Field("multi"));
        ps.Add(PropSpec.Text("empty", "Empty text").Field("Empty").Setter("SetEmptyProp"));
        return ps;
    }
    public void WithColumns(List<ListColumn<T>> columns) {
        cols = new List<ListColumn<T>>();
        if (columns != null) { cols = columns; }
        this.RetireRows();
    }
    public void WithRow(RowOf<T> row) {
        rowOf = row;
        this.RetireRows();
    }
    public void Column(string title, CellOf<T> cell) {
        if (cols == null) { cols = new List<ListColumn<T>>(); }
        cols.Add(new ListColumn<T>(title, cell));
        this.RetireRows();
    }
    public void Column(string title, int weight, CellOf<T> cell) {
        if (cols == null) { cols = new List<ListColumn<T>>(); }
        cols.Add(new ListColumn<T>(title, weight, cell));
        this.RetireRows();
    }
    public void SlotColumn(string title, CellSlotOf<T> slot) {
        if (cols == null) { cols = new List<ListColumn<T>>(); }
        cols.Add(ListColumn<T>.Slot(title, slot));
        this.RetireRows();
    }
    public void SlotColumn(string title, int weight, CellSlotOf<T> slot) {
        if (cols == null) { cols = new List<ListColumn<T>>(); }
        cols.Add(ListColumn<T>.SlotWithWeight(title, weight, slot));
        this.RetireRows();
    }
    public override void CloneContentTo(Control target, CloneTreeFn clone) {
        ListView<T> copy = (ListView<T>)target;
        copy.Bind(data);
        copy.WithColumns(cols);
        copy.WithRow(rowOf);
        copy.WithFixedRowHeight(fixedRowHeight);
    }
    public override int RowCount() { return this.Count(); }
    protected override int TopChromeHeight(App app) { return this.HeaderHeight(app); }
    protected override int CurrentSelectedIndex() { return sel; }
    protected override int FallbackRowHeight(App app, bool forHitTest) {
        if (forHitTest) { return this.Templated() && fixedRowHeight <= 0 ? 0 : this.RowHeight(app); }
        return fixedRowHeight > 0 ? this.RowHeight(app) : 0;
    }
    protected override bool PrepareLayoutBody(App app, Rect view, int ticket, Control ownerParent) {
        if (this.Templated() && fixedRowHeight <= 0 && app != null) {
            int measureW = view.width > 0 ? view.width : bw;
            for (int mi = 0; mi < this.Count(); mi = mi + 1) {
                Control mrow = this.DataRow(mi);
                if (mrow != null) {
                    if (measureW > 0) { mrow.MeasureTree(app, measureW); }
                    else { mrow.MeasureTree(app); }
                    if (ticket != rowsRevision || this.FindApp() != app || parent != ownerParent) { return false; }
                }
            }
        }
        return true;
    }
    private bool RowEditorOwnsPrimary(Control source) {
        bool editing = false;
        Control node = source;
        while (node != null && node != rowsBody && node != this) {
            if (node.InputFocusCapabilities() != 0 || node.HasClickSubscription()) { editing = true; }
            node = node.parent;
        }
        return node == rowsBody && editing;
    }
    public override void OnPointerDown(RoutedEventArgs e) {
        base.OnPointerDown(e);
        if (e.handled || this.IsDisabled()) { return; }
        if (this.App.window.EventButton() == 0 && this.RowEditorOwnsPrimary(e.originalSource)) { return; }
        int index = this.DataIndexAt(e.x, e.y);
        if (index < 0 || !this.Selectable(index)) { return; }
        App app = this.App;
        if (app.window.EventButton() == 1) {
            sel = index; Context.Post(this); this.NoteSelfDamage(app); e.Handle();
        } else if (app.window.EventButton() == 0 && dragOut.Count > 0
                && (app.GetCapturedPointer() == null || app.GetCapturedPointer() == this)) {
            dragOutFrom = index;
            app.CapturePointer(this, true);
        }
    }
    public override void OnPointerMove(RoutedEventArgs e) {
        base.OnPointerMove(e);
        if (this.IsDisabled()) { return; }
        int row = this.DataIndexAt(e.x, e.y);
        if (row >= 0 && !this.Selectable(row)) { row = -1; }
        if (hover != row) { hover = row; this.NoteSelfDamage(this.App); }
    }
    public override void OnPointerLeave(RoutedEventArgs e) {
        base.OnPointerLeave(e);
        hover = -1;
    }
    public override void OnPointerUp(RoutedEventArgs e) {
        base.OnPointerUp(e);
        App app = this.App;
        if (app == null || app.window.EventButton() != 0 || dragOutFrom < 0) { return; }
        int from = dragOutFrom;
        dragOutFrom = -1;
        if (app.GetCapturedPointer() == this) { app.ReleasePointerCapture(); }
        if (!e.handled && !this.ContainsPoint(e.x, e.y, e.pointerType) && this.Has(from)) {
            for (int i = 0; i < dragOut.Count; i = i + 1) { dragOut[i](from); }
        }
    }
    public override void OnPointerCancel(RoutedEventArgs e) {
        base.OnPointerCancel(e);
        dragOutFrom = -1;
        App app = this.App;
        if (app != null && app.GetCapturedPointer() == this) { app.ReleasePointerCapture(); }
    }
    public override void OnClick(RoutedEventArgs e) {
        base.OnClick(e);
        if (e.handled || this.IsDisabled() || this.RowEditorOwnsPrimary(e.originalSource)) { return; }
        int index = this.DataIndexAt(e.x, e.y);
        if (index < 0 || !this.Selectable(index)) { return; }
        App app = this.App;
            int mods = e.modifiers;
            if (multi && Modifiers.HasCtrl(mods)) {
                sel = selection.ToggleCtrl(index, sel);
                Select.Post(this);
            } else if (multi && Modifiers.HasShift(mods) && sel >= 0) {
                selection.SelectRange(sel, index, sel, (int r) => this.Selectable(r));
                Select.Post(this);
            } else {
                bool again = (sel == index) || (sel < 0 && e.isDoubleClick);
                if (multi) { selection.Clear(); marks = selection.marks; }
                sel = index;
                if (again) { Activate.Post(this); }
                else { Select.Post(this); }
            }
            this.NoteSelfDamage(app);
        e.Handle();
    }
    public override void OnKeyDown(RoutedEventArgs e) {
        base.OnKeyDown(e);
        if (e.handled || this.IsDisabled()) { return; }
        int n = this.Count();
        if (n <= 0) { return; }
        int kc = e.keyCode;
        if (kc == 13 && this.HasSelection()) {
            Activate.Post(this);
            e.Handle();
            return;
        }
        int next = this.ResolveNavKeyTarget(kc, sel, n, (int r) => this.Selectable(r));
        if (next == -2) { return; }
        if (next >= 0 && next != sel) {
            if (multi && Modifiers.HasShift(e.modifiers) && sel >= 0) {
                selection.SelectRange(sel, next, sel, (int r) => this.Selectable(r));
            } else if (multi) {
                selection.Clear();
                marks = selection.marks;
            }
            sel = next;
            Select.Post(this);
            App app = this.FindApp();
            if (app != null) { this.NoteSelfDamage(app); }
        }
        e.Handle();
    }
    public override void OnRoutedEvent(RoutedEventArgs e) {
        if (!e.handled && e.eventName == "LongPress" && !this.IsDisabled()) {
            int index = this.DataIndexAt(e.x, e.y);
            if (index >= 0 && this.Selectable(index)) {
                sel = index;
                dragOutFrom = -1;
                App app = this.App;
                if (app.GetCapturedPointer() == this) { app.ReleasePointerCapture(); }
                Context.Post(this);
                this.NoteSelfDamage(app);
                e.Handle();
            }
        }
        if (!e.handled) { base.OnRoutedEvent(e); }
    }
    // 覆写：CSS 类型选择器名（"list"）。
    public override string StyleType() { return "list"; }
    public void Bind(List<T> src) {
        if (data == src) { return; }
        data = src;
        this.RetireRows();
        if (sel >= this.Count()) { sel = -1; }
        selection.Prune(this.Count());
    }
    public int Count() {
        if (data == null) { return 0; }
        return data.Count;
    }
    public int SelectedIndex() { return sel; }
    public bool HasSelection() { return sel >= 0 && sel < this.Count(); }
    public T Selected() { return data[sel]; }
    public int ContentHeightForTest() { return this.ContentHeight(this.App); }
    public int ContentHeightForTest(App app) { return this.ContentHeight(app); }
    public bool Has(int row) { return row >= 0 && row < this.Count(); }
    public T ItemAt(int row) { return data[row]; }
    public void SelectIndex(int row) {
        if (row < -1 || row >= this.Count()) { return; }
        if (row >= 0 && !this.Selectable(row)) { return; }
        if (sel == row) { return; }
        sel = row;
        Select.Post(this);
    }
    public void ClearSelection() { sel = -1; selection.Clear(); marks = selection.marks; }
    public void WithSelectable(RowGate<T> gate) { onlySelectable = gate; }
    // ---- 处理器 ----

    // 某行被选中时回调。
    public ListView<T> OnSelect(Action a) { Select.Add(a); return this; }

    // 选中的行再次被点击（打开 / 深入）时回调。
    public ListView<T> OnActivate(Action a) { Activate.Add(a); return this; }

    // 某行被右键点击时回调。
    public ListView<T> OnContext(Action a) { Context.Add(a); return this; }

    // 订阅「行被拖出列表」手势：在某行上按下、拖到列表矩形之外
    // 松开时回调该行下标。列表只识别手势并报告下标，是否开窗、
    // 开成什么窗口由宿主决定；在列表矩形内松开不算数（那次手势
    // 仍归滚动/选择），右键与长按菜单不受影响。
    public ListView<T> OnDragOut(RowDragOut a) { dragOut.Add(a); return this; }

    // 列表为空时显示的文本。
    public ListView<T> EmptyText(string text) { Empty = text; return this; }

    // 是否拥有自定义插槽列。
    public bool HasSlotColumns() {
        if (cols == null) { return false; }
        for (int i = 0; i < cols.Count; i = i + 1) {
            if (cols[i].slot != null) { return true; }
        }
        return false;
    }
    public Control BuildCompositeRow(T item) {
        Row r = new Row {
            AlignItems = "center",
            Gap = 8
        };
        for (int c = 0; c < cols.Count; c = c + 1) {
            ListColumn<T> col = cols[c];
            Control cellWidget = null;
            if (col.slot != null) {
                cellWidget = col.slot(item);
            } else if (col.cell != null) {
                cellWidget = new Label(col.cell(item));
            }
            if (cellWidget != null) {
                if (col.weight > 0) { cellWidget.grow = true; }
                r.Children.Add(cellWidget);
            }
        }
        return r;
    }
}
