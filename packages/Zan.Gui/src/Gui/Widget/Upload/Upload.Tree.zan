using System;
using System.Collections.Generic;
using Gui;

namespace Gui.Widget;

public partial class Upload {
    private Control triggerControl;
    private Control listControl;
    private UploadTreeState treeState;
    private bool buildingTree;
    private AppLoopRegistration preparation;

    private Button ActionButton(UploadFile file, bool remove, bool card) {
        Button button = new Button("");
        button.Icon = remove ? "close" : "download";
        button.ClassName = card ? (remove ? "upload-tile-remove" : "upload-tile-download")
            : (remove ? "upload-action-btn remove" : "upload-action-btn download");
        button.SetProp("style", "width:24px;height:24px;flex-shrink:0;padding:0");
        UploadAction action = new UploadAction(this, file);
        if (remove) { button.Click.Add(action.Remove); }
        else { button.Click.Add(action.Download); }
        return button;
    }

    private Control FilePicture(UploadFile file, int size) {
        string source = file.thumb;
        if (source == "" && Upload.IsImageExt(file.ext)) { source = file.path; }
        Control picture;
        if (source != "") {
            picture = new Image(source, file.name, "cover");
        } else {
            picture = new IconView(Upload.IsImageExt(file.ext) ? "image" : "file", size);
        }
        picture.ClassName = "upload-thumb";
        picture.SetProp("style", "width:" + Convert.ToString(size) + "px;height:"
            + Convert.ToString(size) + "px;flex-shrink:0;pointer-events:none");
        return picture;
    }

    private bool CanDownload(UploadFile file) {
        return ShowDownloadButton && file.status == UploadStatus.Success() && file.url != "";
    }

    private void AddStatus(Control parent, UploadFile file, bool card) {
        if (file.status == UploadStatus.Success()) {
            IconView ok = new IconView("check", 14);
            ok.ClassName = card ? "upload-badge-ok text-success" : "upload-ok text-success";
            parent.Add(ok);
        } else if (file.status == UploadStatus.Error()) {
            IconView error = new IconView("close", 14);
            error.ClassName = "upload-err text-error";
            parent.Add(error);
            if (file.message != "") {
                Label message = new Label(file.message);
                message.ClassName = "upload-msg text-error";
                parent.Add(message);
            }
        } else if (file.status == UploadStatus.Uploading()) {
            Progress progress = new Progress(file.percent, 1);
            progress.ClassName = "upload-progress";
            progress.SetProp("style", "width:80px;height:18px;flex-shrink:0");
            parent.Add(progress);
        }
    }

    private void AddName(Control parent, UploadFile file) {
        Label label = new Label(file.name);
        label.ClassName = this.CanDownload(file) ? "upload-name upload-name-link flex-1" : "upload-name flex-1";
        if (this.CanDownload(file)) {
            UploadAction action = new UploadAction(this, file);
            label.Click.Add(action.Download);
        }
        parent.Add(label);
    }

    // One generated retained tree, shared by markup and object construction.
    // RemoveAll retires old input ownership, unlike clearing the children list.
    public void BuildTree() {
        if (buildingTree) { return; }
        buildingTree = true;
        try {
            this.RemoveAll();
            triggerControl = null;
            listControl = null;
            if (Files == null) { Files = new List<UploadFile>(); }
            bool off = this.IsDisabled();
            if (Dragger) {
                Control dragger = new Control();
                dragger.ClassName = "upload-dragger col align-center justify-center";
                dragger.SetProp("style", "height:120px;flex-shrink:0");
                IconView icon = new IconView("upload", 32);
                icon.ClassName = "upload-dragger-icon";
                dragger.Add(icon);
                Label text = new Label(DragText != "" ? DragText : "点击或者拖动文件到该区域来上传");
                text.ClassName = "upload-dragger-text";
                dragger.Add(text);
                if (Tip != "") {
                    Label tip = new Label(Tip);
                    tip.ClassName = "upload-dragger-tip text-tertiary";
                    dragger.Add(tip);
                }
                UploadAction action = new UploadAction(this, null);
                dragger.Click.Add(action.Open);
                triggerControl = dragger;
                this.Add(dragger);
            } else if (ShowTrigger && !PictureCard) {
                Button button = new Button(TriggerText != "" ? TriggerText : "上传文件");
                button.ClassName = "upload-trigger";
                button.SetProp("style", "align-self:flex-start;flex-shrink:0");
                UploadAction action = new UploadAction(this, null);
                button.Click.Add(action.Open);
                triggerControl = button;
                this.Add(button);
            }

            listControl = new Control();
            listControl.ClassName = PictureCard ? "upload-tiles row flex-wrap" : "upload-list col";
            listControl.SetProp("style", PictureCard ? "display:flex;flex-wrap:wrap;gap:8px" : "display:flex;flex-direction:column;gap:4px");
            for (int i = 0; i < Files.Count && i < 128; i = i + 1) {
                UploadFile file = Files[i];
                Control row = PictureCard ? (Control)new UploadTile() : new Control();
                row.ClassName = PictureCard ? "upload-tile col align-center justify-center" : "upload-item row align-center";
                row.SetProp("style", PictureCard ? "width:96px;height:96px;flex-shrink:0;overflow:hidden"
                    : (Thumbnail ? "height:44px;gap:6px;flex-shrink:0" : "height:34px;gap:6px;flex-shrink:0"));
                if (PictureCard || Thumbnail) { row.Add(this.FilePicture(file, PictureCard ? 40 : 30)); }
                else {
                    IconView icon = new IconView(Upload.IsImageExt(file.ext) ? "image" : "file", 18);
                    icon.ClassName = "upload-icon";
                    row.Add(icon);
                }
                this.AddName(row, file);
                this.AddStatus(row, file, PictureCard);
                Control actions = row;
                if (PictureCard) {
                    actions = new Control();
                    actions.ClassName = "upload-tile-actions row align-center justify-center";
                    actions.SetProp("style", "height:24px;flex-shrink:0");
                    row.Add(actions);
                }
                if (this.CanDownload(file)) { actions.Add(this.ActionButton(file, false, PictureCard)); }
                if (ShowRemoveButton && !off) { actions.Add(this.ActionButton(file, true, PictureCard)); }
                listControl.Add(row);
            }
            if (PictureCard && ShowTrigger && !off) {
                Control add = new Control();
                add.ClassName = "upload-tile-add align-center justify-center";
                add.SetProp("style", "width:96px;height:96px;flex-shrink:0");
                add.Add(new IconView("plus", 24));
                UploadAction action = new UploadAction(this, null);
                add.Click.Add(action.Open);
                listControl.Add(add);
            }
            this.Add(listControl);
            treeState = new UploadTreeState(this);
        } finally { buildingTree = false; }
    }

    private void SyncTree() {
        if (treeState == null || !treeState.Matches(this)) { this.BuildTree(); }
    }

    private void EnsurePreparation(App app) {
        if (app == null || !app.isRunning) { return; }
        uiApp = app;
        if (preparation != null && preparation.active && preparation.host == app) { return; }
        if (preparation != null) { preparation.Invalidate(); }
        UploadPreparation participant = new UploadPreparation(this);
        preparation = app.RegisterLoopParticipant(this, participant);
    }

    public override void OnMeasure(App app) {
        this.EnsurePreparation(app);
        UploadTreeState previous = treeState;
        this.SyncTree();
        // OnMeasure follows the generic child walk. Newly generated children
        // must be measured in this pass, before the parent's content sizing.
        if (previous != treeState) {
            for (int i = 0; i < this.ChildCount(); i = i + 1) { this.ChildAt(i).MeasureTree(app); }
        }
        prefW = Dragger ? 420 : 240;
        prefH = 0;
    }

    public override void Arrange(int x, int y, int width, int height) {
        base.Arrange(x, y, width, height);
        Control zone = PictureCard && !Dragger ? listControl : triggerControl;
        dropX = zone != null ? zone.bx : 0;
        dropY = zone != null ? zone.by : 0;
        dropW = zone != null ? zone.bw : 0;
        dropH = zone != null ? zone.bh : 0;
    }

    internal void PrepareUpload(App app, bool input) {
        if (this.FindApp() != app || !this.StyleVisible() || this.IsDisabled()) { return; }
        Control popup = app.overlayHost != null ? app.overlayHost.ActiveRoot() : null;
        Control root = popup != null ? popup : app.rootControl;
        if (!app.BelongsToInputTree(this, root)) { return; }
        if (input && app.window.DropPending()) {
            int x = app.window.EventX();
            int y = app.window.EventY();
            if (!this.WantsDropAt(x, y)) { return; }
            // A sibling or popup above this Upload owns the drop if it owns the hit.
            Control target = root.HitTest(x, y);
            if (target == null || !app.BelongsToInputTree(target, this)) { return; }
            List<string> paths = app.window.TakeDroppedFiles();
            if (paths != null && paths.Count > 0) { this.AddPaths(paths); }
        }
    }
}
