using System;
using System.IO;
using Gui;

namespace Gui.Widget;

// before-upload 钩子：项入列前调用，返回 false 拦截入列
// （Naive UI on-before-upload）。必须是非捕获方法组。
public delegate bool UploadBeforeFn(UploadFile item);

// custom-request 钩子：接管一项的传输（Naive UI custom-request）。
// 组件已把项置为 Uploading，宿主自行推进 SetItemPercent /
// SetItemStatus。必须是非捕获方法组。
public delegate void UploadRequestFn(UploadFile item);

// 文件上传（Naive UI n-upload 对位）：选择/拖拽入列，
// 内置 multipart HTTP POST 或 CustomRequest 自定义传输，
// 列表/缩略图/照片墙三形态渲染，进度/状态/移除/下载。
// up.Action = "http://127.0.0.1:8080/upload";
// up.Change += OnChanged;
// up.Render(app, x, y, w);
// 非受控：组件自建 Files；受控：宿主把自己的
// List&lt;UploadFile&gt; 赋给 Files（或 SetFiles）共享引用。
// 事件（Change/Upload/Finish/Error/Remove/Download/Exceed）
// 处理器读 LastItem 拿当前项。内置选择弹窗按 FilePicker
// 范式路由：OwnsEventWindow → ApplyEventWindow → RenderDialog。
public partial class Upload : Control {
    // 文件列表。null 时组件自建（非受控）；宿主赋入
    // 自己的 List 即受控共享引用（Naive UI file-list 对位）。
    public List<UploadFile> Files;
    // 入列即自动开始上传（Naive UI list-type 的默认行为；false 时
    // 停留在 Pending，等 Submit()）。默认 true。
    public bool AutoUpload;
    // 允许一次选择/拖入多个文件。默认 false（拖入仍逐项过门）。
    public bool Multiple;
    // 列表上限；0 = 不限。超出时触发 Exceed 并拒绝入列。
    public int Max;
    // 触发区形态：大虚线拖放框（Naive UI :default-slot 的
    // dragger 对位）；false 时为普通按钮。
    public bool Dragger;
    // Dragger 主文案。
    public string DragText;
    // 触发按钮文字（Naive UI :trigger 默认槽位）。
    public string TriggerText;
    // 显示触发入口（按钮 / 照片墙“+”块）。默认 true。
    public bool ShowTrigger;
    // 行尾/遮罩显示移除按钮。默认 true。
    public bool ShowRemoveButton;
    // Success 且有 url 时显示下载按钮、名称变主色链接
    // （点击触发 Download）。默认 false。
    public bool ShowDownloadButton;
    // 照片墙形态（Naive UI list-type="image-card"）：方格 + 添加块 +
    // hover 遮罩。
    public bool PictureCard;
    // 文本列表行内缩略图（图片项显示 30 方图）。默认 false。
    public bool Thumbnail;
    // 接受扩展名，逗号分隔（"png,jpg"；可带点/星号）；"" = 不限。
    public string Accept;
    // before-upload 拦截钩子（Naive UI on-before-upload）。方法组
    // 只能在实参位转换，用 WithBeforeUpload 挂接。
    public UploadBeforeFn BeforeUpload;
    // 自定义传输钩子（Naive UI custom-request）；设置后由钩子接管传输。
    // 用 WithCustomRequest 挂接。
    public UploadRequestFn CustomRequest;
    // 列表任何变化时触发（入列/移除/状态写入）。
    public UiEvent Change;
    // 一项开始传输时触发（Naive UI on-before-upload 之后的提交沿）。
    public UiEvent UploadStart;
    // 一项传输成功时触发。
    public UiEvent Finish;
    // 一项失败时触发（message 已写入项）。
    public UiEvent Error;
    // 移除一项时触发。
    public UiEvent Remove;
    // 点击下载按钮/名称链接时触发（宿主自行发起下载）。
    public UiEvent Download;
    // 超出 Max 时触发（LastItem = 被拒项）。
    public UiEvent Exceed;
    // 当前事件对应的文件项（宿主在事件处理器里读它）。
    public UploadFile LastItem;

    // 流水号：实例内唯一（宿主可按 id 反查项，多组件并存不撞号）。
    private int uidCounter;
    // 最近一次渲染所属的 App（重绘用）。
    public App uiApp;
    private FilePicker picker;
    // 本帧拖放落区（Render 时刷新；WantsDropAt 据此判定）。
    private int dropX;
    private int dropY;
    private int dropW;
    private int dropH;

    public override int StyleDisplay() { return 1; } // Flex
    public override int StyleFlexDir() { return 1; } // Column

    // 初始化：非受控空列表、默认文案与三形态开关、七个事件槽。
    public void InitUpload() {
        this.InitControl("upload", 1);
        this.ClassName = "upload col";
        uidCounter = 1;
        wiresOwnEvents = true;
        Files = new List<UploadFile>();
        AutoUpload = true;
        Multiple = false;
        Max = 0;
        Dragger = false;
        DragText = "点击或者拖动文件到该区域来上传";
        Tip = "";
        TriggerText = "上传文件";
        ShowTrigger = true;
        ShowRemoveButton = true;
        ShowDownloadButton = false;
        PictureCard = false;
        Thumbnail = false;
        Accept = "";
        BeforeUpload = null;
        CustomRequest = null;
        Change = new UiEvent();
        UploadStart = new UiEvent();
        Finish = new UiEvent();
        Error = new UiEvent();
        Remove = new UiEvent();
        Download = new UiEvent();
        Exceed = new UiEvent();
        LastItem = null;
        picker = null;
        dropX = 0;
        dropY = 0;
        dropW = 0;
        dropH = 0;
    }

    // 构造：非受控模式，自建空文件列表。
    public Upload() {
        this.InitUpload();
    }

    // 挂 before-upload 拦截钩子（Naive UI on-before-upload）。
    public Upload WithBeforeUpload(UploadBeforeFn f) { this.BeforeUpload = f; return this; }

    // 挂自定义传输钩子（Naive UI custom-request），传 null 解除。
    public Upload WithCustomRequest(UploadRequestFn f) { this.CustomRequest = f; return this; }

    // 控件类型标识（序列化/设计器用）。
    public override string Kind() { return "Upload"; }

    // 本组件的命中 id 标识（对位 CommonId）。
    public int BaseId() { return this.CommonId(); }

    // ---- 设计器属性 ------------------------------------------------------

    // 覆写：返回设计器属性清单（accept/max/autoUpload 等）。
    public override List<PropSpec> Props() {
        List<PropSpec> ps = new List<PropSpec>();
        PropSpec acc = PropSpec.Text("accept", "Accept");
        acc.str = Accept;
        acc.WithTip("Comma-separated extensions (e.g. \"png,jpg\"); empty = all.");
        ps.Add(acc);
        PropSpec mx = PropSpec.Int("max", "Max files");
        mx.num = Max;
        mx.Step(1, 0, 999);
        ps.Add(mx);
        PropSpec au = PropSpec.Bool("autoUpload", "Auto upload");
        au.flag = AutoUpload;
        ps.Add(au);
        PropSpec mu = PropSpec.Bool("multiple", "Multiple");
        mu.flag = Multiple;
        ps.Add(mu);
        PropSpec tt = PropSpec.Text("triggerText", "Trigger text");
        tt.str = TriggerText;
        ps.Add(tt);
        PropSpec sh = PropSpec.Bool("showTrigger", "Show trigger");
        sh.flag = ShowTrigger;
        ps.Add(sh);
        PropSpec sr = PropSpec.Bool("showRemoveButton", "Remove button");
        sr.flag = ShowRemoveButton;
        ps.Add(sr);
        PropSpec sd = PropSpec.Bool("showDownloadButton", "Download button");
        sd.flag = ShowDownloadButton;
        ps.Add(sd);
        PropSpec dr = PropSpec.Bool("dragger", "Dragger");
        dr.flag = Dragger;
        ps.Add(dr);
        PropSpec dt = PropSpec.Text("dragText", "Drag text");
        dt.str = DragText;
        ps.Add(dt);
        PropSpec tp = PropSpec.Text("tip", "Tip");
        tp.str = Tip;
        ps.Add(tp);
        PropSpec pc = PropSpec.Bool("pictureCard", "Picture card");
        pc.flag = PictureCard;
        ps.Add(pc);
        PropSpec th = PropSpec.Bool("thumbnail", "Thumbnail");
        th.flag = Thumbnail;
        ps.Add(th);
        return ps;
    }

    // 覆写：公共事件之外提供 "Change"/"Upload"/"Finish"/"Error"/
    // "Remove"/"Download"/"Exceed"。
    public override List<string> Events() {
        List<string> e = Control.CommonEvents();
        e.Add("Change");
        e.Add("Upload");
        e.Add("Finish");
        e.Add("Error");
        e.Add("Remove");
        e.Add("Download");
        e.Add("Exceed");
        return e;
    }

    // 覆写：语义事件各挂对应 UiEvent（"Upload" 与 "UploadStart"
    // 同槽），其余按名称走通用路由。
    public override void BindEvent(string evt, Action a) {
        if (evt == "Change") { Change.Add(a); return; }
        if (evt == "Upload" || evt == "UploadStart") { UploadStart.Add(a); return; }
        if (evt == "Finish") { Finish.Add(a); return; }
        if (evt == "Error") { Error.Add(a); return; }
        if (evt == "Remove") { Remove.Add(a); return; }
        if (evt == "Download") { Download.Add(a); return; }
        if (evt == "Exceed") { Exceed.Add(a); return; }
        On.AddByName(evt, a);
    }

    // <see cref="BindEvent"/> 的 sender 通道（S = Sender）：
    // 特化事件接本控件的 UiEvent，通用事件按名路由。
    public override void BindEventS(string evt, ControlEvent a) {
        if (evt == "Change") { Change.AddS(a); return; }
        if (evt == "Upload" || evt == "UploadStart") { UploadStart.AddS(a); return; }
        if (evt == "Finish") { Finish.AddS(a); return; }
        if (evt == "Error") { Error.AddS(a); return; }
        if (evt == "Remove") { Remove.AddS(a); return; }
        if (evt == "Download") { Download.AddS(a); return; }
        if (evt == "Exceed") { Exceed.AddS(a); return; }
        On.AddByNameS(evt, a);
    }

    public override void TriggerEvent(string evt) {
        if (evt == "Change") { Change.RaiseS(this); return; }
        if (evt == "Upload" || evt == "UploadStart") { UploadStart.RaiseS(this); return; }
        if (evt == "Finish") { Finish.RaiseS(this); return; }
        if (evt == "Error") { Error.RaiseS(this); return; }
        if (evt == "Remove") { Remove.RaiseS(this); return; }
        if (evt == "Download") { Download.RaiseS(this); return; }
        if (evt == "Exceed") { Exceed.RaiseS(this); return; }
        base.TriggerEvent(evt);
    }


    // ---- 数据入口 --------------------------------------------------------

    // 受控列表：共享宿主 List 引用（非受控时忽略 null）。
    public void SetFiles(List<UploadFile> files) {
        if (files == null) { return; }
        Files = files;
        int i = 0;
        while (i < files.Count) {
            UploadFile f = files[i];
            if (f.id >= uidCounter) { uidCounter = f.id + 1; }
            i = i + 1;
        }
        if (uiApp != null) { uiApp.RequestRedraw(); }
    }

    // 接受一批本地路径（选择/拖拽统一入口）：逐项过
    // Accept → Max → BeforeUpload 门。返回实际入列数。
    public int AddPaths(List<string> paths) {
        if (paths == null) { return 0; }
        if (this.IsDisabled()) { return 0; }
        if (Files == null) { Files = new List<UploadFile>(); }
        int added = 0;
        int i = 0;
        while (i < paths.Count) {
            string p = paths[i];
            if (p != null && p != "" && this.TryAddPath(p)) { added = added + 1; }
            i = i + 1;
        }
        return added;
    }

    // 单个路径造项并过门入列（AddPaths 的内层）。
    public bool TryAddPath(string path) {
        string name = Path.GetFileName(path);
        if (name == "") { name = path; }
        UploadFile f = new UploadFile();
        f.name = name;
        f.path = path;
        f.ext = UploadFile.ExtOf(name);
        if (path != "" && File.Exists(path)) { f.size = File.GetSize(path); }
        return this.Admit(f);
    }

    // 程序化造项（默认文件列表/演示用）：不过 Accept/Max/BeforeUpload
    // 门（宿主显式添加）；url 非空 → Success，AutoUpload 且可启动 →
    // 立即开传。返回新建项。
    public UploadFile AddFile(string name, string path, string url) {
        if (Files == null) { Files = new List<UploadFile>(); }
        UploadFile f = new UploadFile();
        f.name = name;
        f.path = path;
        f.url = url;
        f.ext = UploadFile.ExtOf(name);
        if (path != "" && File.Exists(path)) { f.size = File.GetSize(path); }
        f.id = uidCounter;
        f.owner = this;
        uidCounter = uidCounter + 1;
        if (url != "") {
            f.status = UploadStatus.Success();
            f.percent = 100;
        } else {
            f.status = UploadStatus.Pending();
        }
        Files.Add(f);
        LastItem = f;
        Change.RaiseS(this);
        if (f.status == UploadStatus.Pending() && AutoUpload) {
            this.StartItem(f);
        }
        if (uiApp != null) { uiApp.RequestRedraw(); }
        return f;
    }

    // 入列唯一通路：id 分配 + Accept/Max/BeforeUpload 门 + 自动开传。
    public bool Admit(UploadFile f) {
        if (this.IsDisabled()) { return false; }
        if (Files == null) { Files = new List<UploadFile>(); }
        f.id = uidCounter;
        f.owner = this;
        uidCounter = uidCounter + 1;
        if (Accept != "" && !this.AcceptAllows(f.ext)) { return false; }
        if (Max > 0 && Files.Count >= Max) {
            LastItem = f;
            Exceed.RaiseS(this);
            return false;
        }
        if (BeforeUpload != null && !BeforeUpload(f)) { return false; }
        Files.Add(f);
        LastItem = f;
        Change.RaiseS(this);
        if (AutoUpload) { this.StartItem(f); }
        if (uiApp != null) { uiApp.RequestRedraw(); }
        return true;
    }

    // 扩展名是否命中 Accept 列表（逗号/分号分隔，容忍 "*." 与 "." 前缀；
    // "*" 通配；空扩展名恒通过）。
    public bool AcceptAllows(string ext) {
        if (ext == "") { return true; }
        if (Accept == null || Accept.Length == 0) { return true; }
        string acc = Accept.ToLower();
        int start = 0;
        int len = acc.Length;
        for (int i = 0; i <= len; i = i + 1) {
            if (i == len || (acc[i] & 255) == 44 || (acc[i] & 255) == 59) {
                if (i > start) {
                    string tok = acc.Substring(start, i - start).Trim();
                    if (tok != "") {
                        if (tok.StartsWith("*.")) { tok = tok.Substring(2); }
                        else if (tok.StartsWith(".")) { tok = tok.Substring(1); }
                        if (tok == "*" || tok == ext) { return true; }
                    }
                }
                start = i + 1;
            }
        }
        return false;
    }

    // 扩展名是否为常见图片格式（决定缩略图/图标形态）。
    public static bool IsImageExt(string ext) {
        return ext == "png" || ext == "jpg" || ext == "jpeg" || ext == "gif"
            || ext == "bmp" || ext == "webp" || ext == "ico" || ext == "svg";
    }

    // ---- 传输 ------------------------------------------------------------

    // 把全部 Pending 项启动传输（AutoUpload=false 的手动提交，
    // Naive UI submit() 对位）。
    public void Submit() {
        if (Files == null) { return; }
        int i = 0;
        while (i < Files.Count) {
            UploadFile f = Files[i];
            if (f.status == UploadStatus.Pending()) { this.StartItem(f); }
            i = i + 1;
        }
        if (uiApp != null) { uiApp.RequestRedraw(); }
    }

    // 启动一项：CustomRequest 优先；或者触发 UploadStart 事件由业务侧接管。
    public void StartItem(UploadFile f) {
        if (f == null) { return; }
        if (CustomRequest == null) {
            // 无传输通道时停留在 Pending，不启动传输也不触发 UploadStart
            return;
        }
        f.status = UploadStatus.Uploading();
        f.percent = 0;
        f.message = "";
        LastItem = f;
        UploadStart.RaiseS(this);
        CustomRequest(f);
    }

    // 标记一项失败：写状态与原因，触发 Error + Change。
    public void FailItem(UploadFile f, string message) {
        if (f == null) { return; }
        f.status = UploadStatus.Error();
        f.message = message;
        LastItem = f;
        Error.RaiseS(this);
        Change.RaiseS(this);
        if (uiApp != null) { uiApp.RequestRedraw(); }
    }

    // ---- 项操作 ----------------------------------------------------------

    // 按项 id 查找文件项；未找到返回 null。
    public UploadFile Find(int id) {
        if (Files == null) { return null; }
        int i = 0;
        while (i < Files.Count) {
            if (Files[i].id == id) { return Files[i]; }
            i = i + 1;
        }
        return null;
    }

    // 刷新一项进度（CustomRequest/演示用）。
    public void SetItemPercent(int id, int percent) {
        UploadFile f = this.Find(id);
        if (f == null) { return; }
        if (percent < 0) { percent = 0; }
        if (percent > 100) { percent = 100; }
        f.percent = percent;
        if (uiApp != null) { uiApp.RequestRedraw(); }
    }

    // 写入一项状态：Success → 触发 Finish，Error → 触发 Error，
    // 任一状态变化都触发 Change。
    public void SetItemStatus(int id, int status, string message) {
        UploadFile f = this.Find(id);
        if (f == null) { return; }
        f.status = status;
        if (message != null) { f.message = message; }
        if (status == UploadStatus.Success()) {
            f.percent = 100;
            LastItem = f;
            Finish.RaiseS(this);
        } else if (status == UploadStatus.Error()) {
            LastItem = f;
            Error.RaiseS(this);
        }
        Change.RaiseS(this);
        if (uiApp != null) { uiApp.RequestRedraw(); }
    }

    // 写入一项远端 url（成功回显/下载目标）。
    public void SetItemUrl(int id, string url) {
        UploadFile f = this.Find(id);
        if (f == null) { return; }
        f.url = url;
        Change.RaiseS(this);
        if (uiApp != null) { uiApp.RequestRedraw(); }
    }

    // 写入一项缩略图来源（Naive UI on-create-thumbnail 的宿主替代）。
    public void SetItemThumb(int id, string thumb) {
        UploadFile f = this.Find(id);
        if (f == null) { return; }
        f.thumb = thumb;
        if (uiApp != null) { uiApp.RequestRedraw(); }
    }

    // 按 id 移除一项（触发 Remove + Change）。返回 false = 未找到。
    public bool RemoveItem(int id) {
        UploadFile f = this.Find(id);
        if (f == null) { return false; }
        int idx = Files.IndexOf(f);
        if (idx < 0) { return false; }
        Files.RemoveAt(idx);
        LastItem = f;
        Remove.RaiseS(this);
        Change.RaiseS(this);
        if (uiApp != null) { uiApp.RequestRedraw(); }
        return true;
    }

    // 清空列表（触发 Change）。
    public void Clear() {
        if (Files != null) { Files.Clear(); }
        Change.RaiseS(this);
        if (uiApp != null) { uiApp.RequestRedraw(); }
    }

    // ---- 拖放落区 --------------------------------------------------------

    // 指针 (x, y) 是否落在本组件的拖放落区（Dragger 大框 /
    // 照片墙区域 / 普通模式触发按钮）。宿主可直接用它判定
    // OS 文件拖放的落点（本帧渲染后有效）。
    public bool WantsDropAt(int x, int y) {
        if (dropW <= 0 || dropH <= 0) { return false; }
        return x >= dropX && x < dropX + dropW && y >= dropY && y < dropY + dropH;
    }

    // 接收一批拖入的本地文件（等价 AddPaths，供宿主事件回路调用）。
    public int AcceptDropped(List<string> paths) { return this.AddPaths(paths); }

    // ---- 样式辅助 --------------------------------------------------------

    // 触发区与列表行之间的间距（皮肤 gap 可覆写）。
    public int StyleGap(App app) {
        StyleBox s = this.ResolveStyleAs(app, "upload", Class, Style.SNormal());
        return s.GapOr(app.theme.paddingTiny);
    }

    // 文本列表行高：带缩略图 44，否则 34（按 DPI 缩放）。
    public int RowH(App app) {
        if (Thumbnail) { return app.Scale(44); }
        return app.Scale(34);
    }

    // 触发按钮样式（normal / hover / disabled 三态）。
    public StyleBox TriggerStyle(App app, bool off) {
        bool hover = !off && app.focus.IsHovered(this.CommonId());
        int st = off ? Style.SDisabled() : (hover ? Style.SHover() : Style.SNormal());
        return this.ResolvePartAs(app, "upload", "trigger", "", Class, st);
    }

    // 触发按钮高度（皮肤 height 可覆写）。
    public int TriggerH(App app) {
        return this.TriggerStyle(app, true).HeightOr(app.theme.heightMedium);
    }

    // 触发按钮宽度 = 文字宽 + 左右 padding（TriggerText 空 = 默认文案）。
    public int TriggerW(App app) {
        StyleBox s = this.TriggerStyle(app, true);
        int fs = s.FontOr(Style.FontFallback(app, "medium"));
        string txt = TriggerText == "" ? "上传文件" : TriggerText;
        return Canvas.MeasureText(txt, fs)
            + s.PadLOr(app.theme.paddingLarge) + s.PadROr(app.theme.paddingLarge);
    }

    // Dragger 大框高度：图标圆 + 主文案（+ 可选副文案）装配。
    public int DraggerH(App app) {
        int fs = Style.FontFallback(app, "medium");
        int h = app.Scale(22) + app.Scale(40) + app.Scale(12) + Canvas.FontHeight(fs)
            + app.Scale(22);
        if (Tip != "") {
            h = h + app.Scale(4) + Canvas.FontHeight(Style.FontFallback(app, "small"));
        }
        return h;
    }

    // 超宽文本逐字收缩截断并补「…」；不超宽原样返回。
    public static string Ellipsize(string s, int maxW, int fs) {
        if (s == "" || maxW <= 0) { return s; }
        if (Canvas.MeasureText(s, fs) <= maxW) { return s; }
        string cut = s;
        while (cut.Length > 1 && Canvas.MeasureText(cut + "…", fs) > maxW) {
            cut = cut.Substring(0, cut.Length - 1);
        }
        return cut + "…";
    }

    // 声明式对象树构建：根据当前配置动态组合触发器与文件列表
    public void BuildTree() {
        this.children.Clear();
        if (Files == null) { Files = new List<UploadFile>(); }
        bool off = this.IsDisabled();

        // 1. 触发区
        if (Dragger) {
            Control dragger = new Control();
            dragger.ClassName = "upload-dragger col align-center justify-center";
            IconView icon = new IconView("upload", 32);
            icon.ClassName = "upload-dragger-icon";
            dragger.Add(icon);
            Label mainLbl = new Label(DragText != "" ? DragText : "点击或者拖动文件到该区域来上传");
            mainLbl.ClassName = "upload-dragger-text";
            dragger.Add(mainLbl);
            if (Tip != "") {
                Label tipLbl = new Label(Tip);
                tipLbl.ClassName = "upload-dragger-tip text-tertiary";
                dragger.Add(tipLbl);
            }
            if (!off) {
                dragger.Click.Add(() => { this.OpenDialog(); });
            }
            this.Add(dragger);
        } else if (ShowTrigger && !PictureCard) {
            Button btn = new Button(TriggerText != "" ? TriggerText : "上传文件");
            btn.ClassName = "upload-trigger";
            if (!off) {
                btn.Click.Add(() => { this.OpenDialog(); });
            }
            this.Add(btn);
        }

        // 2. 文件列表区
        Control listContainer = new Control();
        if (PictureCard) {
            listContainer.ClassName = "upload-tiles row flex-wrap";
            for (int i = 0; i < Files.Count && i < 128; i = i + 1) {
                UploadFile f = Files[i];
                Control tile = new Control();
                tile.ClassName = "upload-tile align-center justify-center relative";
                bool isImg = Upload.IsImageExt(f.ext);
                IconView ico = new IconView(isImg ? "image" : "file", 28);
                tile.Add(ico);
                if (f.status == UploadStatus.Success()) {
                    IconView okIco = new IconView("check", 14);
                    okIco.ClassName = "upload-badge-ok";
                    tile.Add(okIco);
                }
                if (ShowRemoveButton && !off) {
                    Button rm = new Button("");
                    rm.ClassName = "upload-tile-remove";
                    int fid = f.id;
                    rm.Click.Add(() => { this.RemoveItem(fid); });
                    tile.Add(rm);
                }
                listContainer.Add(tile);
            }
            if (ShowTrigger && !off) {
                Control addCard = new Control();
                addCard.ClassName = "upload-tile-add align-center justify-center";
                IconView plus = new IconView("plus", 24);
                addCard.Add(plus);
                addCard.Click.Add(() => { this.OpenDialog(); });
                listContainer.Add(addCard);
            }
        } else {
            listContainer.ClassName = "upload-list col";
            for (int i = 0; i < Files.Count && i < 128; i = i + 1) {
                UploadFile f = Files[i];
                Control row = new Control();
                row.ClassName = "upload-item row align-center";
                bool isImg = Upload.IsImageExt(f.ext);
                IconView icon = new IconView(isImg ? "image" : "file", 18);
                row.Add(icon);
                Label nameLbl = new Label(f.name);
                nameLbl.ClassName = "upload-name flex-1";
                row.Add(nameLbl);
                if (f.status == UploadStatus.Success()) {
                    IconView ok = new IconView("check", 14);
                    ok.ClassName = "upload-ok text-success";
                    row.Add(ok);
                } else if (f.status == UploadStatus.Error()) {
                    IconView err = new IconView("close", 14);
                    err.ClassName = "upload-err text-error";
                    row.Add(err);
                    if (f.message != "") {
                        Label msg = new Label(f.message);
                        msg.ClassName = "upload-msg text-error";
                        row.Add(msg);
                    }
                }
                if (ShowDownloadButton && f.status == UploadStatus.Success() && f.url != "") {
                    Button dl = new Button("");
                    dl.ClassName = "upload-action-btn download";
                    UploadFile curF = f;
                    dl.Click.Add(() => { LastItem = curF; Download.RaiseS(this); });
                    row.Add(dl);
                }
                if (ShowRemoveButton && !off) {
                    Button rm = new Button("");
                    rm.ClassName = "upload-action-btn remove";
                    int fid = f.id;
                    rm.Click.Add(() => { this.RemoveItem(fid); });
                    row.Add(rm);
                }
                listContainer.Add(row);
            }
        }
        this.Add(listContainer);
    }

    // ---- 渲染 ------------------------------------------------------------

    public override void SyncBinding() {
        base.SyncBinding();
        int expectedCount = Files != null ? Files.Count : 0;
        if (this.children.Count == 0) {
            this.BuildTree();
        }
    }

    public override void OnMeasure(App app) {
        prefW = Dragger ? 420 : 240;
        int n = Files != null ? Files.Count : 0;
        prefH = (Dragger ? 120 : 36) + n * 36;
    }

    public override void OnPaint(App app) {
        uiApp = app;
        int id = this.CommonId();
        this.SyncBinding();
        app.focus.RegisterFocusable(id);

        if (Dragger) {
            int dh = this.DraggerH(app);
            dropX = bx;
            dropY = by;
            dropW = bw;
            dropH = dh;
            app.hitTester.RegisterRect(id + 1, bx, by, bw, dh, 0);
            if (!this.IsDisabled() && Ui.Clicked(app, id + 1)) {
                this.OpenDialog();
            }
        } else if (ShowTrigger && !PictureCard) {
            int tw = this.TriggerW(app);
            int th = this.TriggerH(app);
            dropX = bx;
            dropY = by;
            dropW = tw;
            dropH = th;
            app.hitTester.RegisterRect(id, bx, by, tw, th, 0);
            if (!this.IsDisabled() && Ui.Clicked(app, id)) {
                this.OpenDialog();
            }
        } else if (PictureCard) {
            int pw = app.Scale(96);
            int ph = app.Scale(96);
            dropX = bx;
            dropY = by;
            dropW = bw;
            dropH = bh;
            if (Files != null) {
                for (int i = 0; i < Files.Count && i < 128; i = i + 1) {
                    int tid = id + 8 + i * 4;
                    app.hitTester.RegisterRect(tid, bx + i * (pw + app.Scale(8)), by, pw, ph, 0);
                }
            }
            if (ShowTrigger) {
                int addX = bx + (Files != null ? Files.Count : 0) * (pw + app.Scale(8));
                app.hitTester.RegisterRect(id + 2, addX, by, pw, ph, 0);
                if (!this.IsDisabled() && Ui.Clicked(app, id + 2)) {
                    this.OpenDialog();
                }
            }
        }

        if (!PictureCard && Files != null) {
            int rowH = this.RowH(app);
            int rowY = by + (ShowTrigger ? (this.TriggerH(app) + this.StyleGap(app)) : 0);
            for (int i = 0; i < Files.Count && i < 128; i = i + 1) {
                UploadFile f = Files[i];
                int rid = id + 8 + i * 4;
                app.hitTester.RegisterRect(rid, bx, rowY, bw, rowH, 0);
                app.hitTester.RegisterRect(rid + 1, bx + app.Scale(30), rowY, app.Scale(100), rowH, 0);
                if (ShowRemoveButton) {
                    app.hitTester.RegisterRect(rid + 2, bx + bw - app.Scale(24), rowY, app.Scale(22), rowH, 0);
                    if (!this.IsDisabled() && Ui.Clicked(app, rid + 2)) {
                        this.RemoveItem(f.id);
                    }
                }
                if (ShowDownloadButton && f.status == UploadStatus.Success() && f.url != "") {
                    app.hitTester.RegisterRect(rid + 3, bx + bw - app.Scale(48), rowY, app.Scale(22), rowH, 0);
                    if (!this.IsDisabled() && (Ui.Clicked(app, rid + 3) || Ui.Clicked(app, rid + 1))) {
                        LastItem = f;
                        Download.RaiseS(this);
                    }
                }
                rowY = rowY + rowH + app.Scale(4);
            }
        }

        if (!this.IsDisabled() && dropW > 0 && dropH > 0
                && (app.EventKind() == 9 || app.window.DropPending())) {
            int dxp = app.window.EventX();
            int dyp = app.window.EventY();
            if (this.WantsDropAt(dxp, dyp)) {
                List<string> drops = app.window.TakeDroppedFiles();
                if (drops != null && drops.Count > 0) { this.AddPaths(drops); }
            }
        }
        On.Fire(app, id, this);
    }
}
