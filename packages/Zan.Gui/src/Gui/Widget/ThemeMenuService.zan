namespace Gui;

// 主题设置抽屉（换肤 / 强调色 / 密度 / 透明度 / 壁纸 / 动效）的协调服务。
// 从 App 拆出：App 只持有一个惰性创建的服务实例（App.ThemeMenu），抽屉视图、开关状态
// 与设置命令的应用都在这里，App 本体不再承载这块可选功能。
public class ThemeMenuService {
    private weak App app;
    // 视图以 object 存放：可选视图类型不进 App 的字段图。
    internal object drawer;

    public ThemeMenuService(App owner) {
        app = owner;
    }

    // 当前抽屉视图（未打开过或已退休时为 null）。
    public ThemeDrawer CurrentDrawer() {
        return drawer != null ? (ThemeDrawer)drawer : null;
    }

    // 开关抽屉。核心外壳只经显式安装的设置动作调用它（见 ThemeSettings）。
    public void Toggle(int triggerId) {
        App host = app;
        if (host == null || host.themeNames == null || host.themeNames.Count == 0) { return; }
        ThemeDrawer current = this.CurrentDrawer();
        if (current != null && current.IsOpen()) { this.Close(current); }
        else { this.Show(); }
        host.Stats.NoteRedrawWhy("ToggleThemeMenu");
        host.needsRedraw = true;
    }

    public void Show() {
        App host = app;
        if (host == null || !host.isRunning || host.themeNames == null || host.themeNames.Count == 0 || host.overlayHost == null) { return; }
        if (drawer == null) { drawer = new ThemeDrawer(host); }
        ThemeDrawer view = (ThemeDrawer)drawer;
        host.themeDrawer = view;
        host.themeDrawerSurface = view.Box();
        host.themeMenuOpen = true;
        view.Present(host);
    }

    internal void Close(ThemeDrawer view) {
        App host = app;
        if (host == null || drawer != view) { return; }
        host.themeDrawerSurface = null;
        host.themeMenuOpen = false;
        if (host.overlayHost != null) { host.overlayHost.Hide(view); }
        if (view.IsOpen()) { view.Hide(); }
        host.RequestRedraw();
    }

    internal void Retire(ThemeDrawer view) {
        App host = app;
        if (host == null || drawer != view) { return; }
        drawer = null;
        host.themeDrawer = null;
        host.themeDrawerSurface = null;
        host.themeMenuOpen = false;
        view.Retire();
    }

    // 强调色色板第 index 项（0 = 跟随皮肤）。
    internal int Accent(int index) {
        if (index == 1) { return Theme.Rgb(59, 130, 246); }
        if (index == 2) { return Theme.Rgb(139, 92, 246); }
        if (index == 3) { return Theme.Rgb(236, 72, 153); }
        if (index == 4) { return Theme.Rgb(16, 185, 129); }
        if (index == 5) { return Theme.Rgb(245, 158, 11); }
        if (index == 6) { return Theme.Rgb(239, 68, 68); }
        return 0;
    }

    // 应用抽屉里的一条设置命令。
    internal void ChangeSetting(ThemeDrawer view, string command, int value) {
        App host = app;
        if (host == null || drawer != view || !view.IsOpen()) { return; }
        if (command == "tab") { view.SelectTab(value); return; }
        if (command == "skin") {
            if (host.themeNames == null || value < 0 || value >= host.themeNames.Count) { return; }
            int previous = host.themeMenuModel;
            if (host.autoSkins) {
                host.ApplySkin(value);
                if (host.appliedSkin != value) { return; }
                ChildWindows.FollowSkin(value);
            } else { host.themeMenuModel = value; }
            if (host.themeMenuModel != previous) { host.themeMenuChange.Raise(); }
        } else if (command == "accent") {
            host.accentOverride = this.Accent(value);
            if (host.autoSkins) { host.ApplySkin(host.appliedSkin); }
            else if (host.skinName != "") {
                host.UseSkin(host.skinName);
                if (host.accentOverride != 0) {
                    host.theme.ApplyAccent(host.accentOverride);
                    host.ApplyAppCss();
                }
            } else {
                Theme baseTheme = host.isDark ? Theme.Dark() : Theme.Light();
                host.theme.ApplyAccent(host.accentOverride != 0 ? host.accentOverride : baseTheme.primary);
                host.ApplyAppCss();
            }
        } else if (command == "density") {
            host.SetDensity(value);
        } else if (command == "opacity") {
            int opacity = view.opacity.Low();
            host.SetWindowOpacity(opacity);
            ChildWindows.FollowOpacity(opacity);
        } else if (command == "wallpaper-pick") {
            host.RequestWallpaperPick();
        } else if (command == "wallpaper-clear") {
            host.ClearWallpaper();
            ChildWindows.FollowWallpaper("", 0);
        } else if (command == "wallpaper-opacity") {
            int wpOpacity = view.wallpaperOpacity.Low();
            if (host.HasUserWallpaper()) {
                host.SetUserWallpaper(host.UserWallpaperPath(), wpOpacity);
                ChildWindows.FollowWallpaper(host.UserWallpaperPath(), wpOpacity);
            } else { host.SetWallpaper(host.WallpaperPath(), wpOpacity); }
        } else if (command == "animations") {
            host.SetBackdropFx(view.animations.IsChecked());
        } else if (command == "effect") {
            host.SetFxKind(value);
        }
        // 设置项既有的通知可能停掉或替换宿主。
        if (host.isRunning && drawer == view && view.IsOpen()) { view.Prepare(host); }
        host.RequestRedraw();
    }
}
