using System;
using Gui;

namespace Gui.Widget;

// 提示输入框（Prompt）：纯声明式对象树与 CSS 盒模型（Flex 列排布）。
// 组合标题、单行输入框与确定/取消操作栏，彻底物理消除所有画布微绘（SubBox.Paint、DrawText、手算宽高）。
public class Prompt : Control {
    public string title;
    public Input input;
    public Button okBtn;
    public Button cancelBtn;
    public UiEvent Submit;
    public UiEvent Cancel;

    public override int StyleDisplay() { return 1; } // Flex
    public override int StyleFlexDir() { return 1; } // Column

    public Prompt() {
        this.InitControl("prompt", 1);
        this.ClassName = "prompt col gap-medium";
        title = "";
        input = new Input();
        okBtn = new Button("确定").Primary();
        cancelBtn = new Button("取消");
        Submit = new UiEvent();
        Cancel = new UiEvent();
        okBtn.Click.Add(() => { Submit.RaiseS(this); });
        cancelBtn.Click.Add(() => { Cancel.RaiseS(this); });
        this.BuildTree();
    }

    public Prompt(string caption) {
        this.InitControl("prompt", 1);
        this.ClassName = "prompt col gap-medium";
        title = caption;
        input = new Input();
        okBtn = new Button("确定").Primary();
        cancelBtn = new Button("取消");
        Submit = new UiEvent();
        Cancel = new UiEvent();
        okBtn.Click.Add(() => { Submit.RaiseS(this); });
        cancelBtn.Click.Add(() => { Cancel.RaiseS(this); });
        this.BuildTree();
    }

    public void BuildTree() {
        this.children.Clear();
        if (title != "") {
            Label lbl = new Label(title);
            lbl.ClassName = "prompt-title font-bold";
            this.Add(lbl);
        }
        this.Add(input);
        Control footer = new Control();
        footer.ClassName = "prompt-footer row justify-end gap-small";
        footer.Add(cancelBtn);
        footer.Add(okBtn);
        this.Add(footer);
    }

    public override string Kind() { return "Prompt"; }

    public override void OnPaint(App app) {
        int id = this.CommonId();
        SyncBinding();
        app.focus.RegisterFocusable(id);
        app.hitTester.RegisterRect(id, bx, by, bw, bh, 0);
        On.Fire(app, id, this);
    }
}
