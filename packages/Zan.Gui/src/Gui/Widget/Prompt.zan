using System;
using Gui;
namespace Gui.Widget;
public class Prompt : Control {
    public string title;
    public Input input;
    public Button okBtn;
    public Button cancelBtn;
    [Event]
    public UiEvent Submit;
    [Event]
    public UiEvent Cancel;
    public override int StyleDisplay() { return 1; } // Flex
    public override int StyleFlexDir() { return 1; } // Column
    public Prompt() {
        this.InitControl("prompt");
        this.ClassName = "prompt col gap-medium";
        title = "";
        input = new Input();
        okBtn = new Button("确定") { ClassName = "primary" };
        cancelBtn = new Button("取消");
        Submit = new UiEvent();
        Cancel = new UiEvent();
        PromptAction okAct = new PromptAction(this, true);
        okBtn.Click.Add(okAct.Invoke);
        PromptAction cancelAct = new PromptAction(this, false);
        cancelBtn.Click.Add(cancelAct.Invoke);
        this.BuildTree();
    }
    public Prompt(string caption) {
        this.InitControl("prompt");
        this.ClassName = "prompt col gap-medium";
        title = caption != null ? caption : "";
        input = new Input();
        okBtn = new Button("确定") { ClassName = "primary" };
        cancelBtn = new Button("取消");
        Submit = new UiEvent();
        Cancel = new UiEvent();
        PromptAction okAct = new PromptAction(this, true);
        okBtn.Click.Add(okAct.Invoke);
        PromptAction cancelAct = new PromptAction(this, false);
        cancelBtn.Click.Add(cancelAct.Invoke);
        this.BuildTree();
    }
    public void BuildTree() {
        this.RemoveAll();
        if (title != null && title != "") {
            Label lbl = new Label(title);
            lbl.ClassName = "prompt-title font-bold";
            this.Add(lbl);
        }
        this.Add(input);
        Control footer = new Control();
        footer.ClassName = "prompt-footer row justify-end gap-small";
        footer.Add(cancelBtn);
        footer.Add(okBtn);
        this.Add(footer);
    }
    public string Value() {
        return input != null ? input.GetText() : "";
    }

    public void SetTitle(string v) {
        title = v != null ? v : "";
        this.BuildTree();
    }

    public void SetValue(string v) {
        if (input != null) { input.SetText(v != null ? v : ""); }
    }

    protected override List<PropSpec> DefineProps() {
        List<PropSpec> ps = new List<PropSpec>();
        ps.Add(PropSpec.Text("title", "Title").Field("title").Setter("SetTitle"));
        ps.Add(PropSpec.Text("value", "Value").DefaultBinding().Accessor("Value", "SetValue").Also("text").Also("data"));
        ps.Add(this.SizeProp());
        return ps;
    }
}
