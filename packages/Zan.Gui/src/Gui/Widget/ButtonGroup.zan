using System;
using Gui;
namespace Gui.Widget;
public class ButtonGroup : Control {
    private int btnType;
    private int btnStyle;
    private int size;
    private bool vertical;
    private int active;
    private int lastSyncedType;
    private int lastSyncedStyle;
    private int lastSyncedSize;
    public UiEvent SelectionChanged;
    private int lastClicked = -1;
    public override int StyleDisplay() { return 1; } // CSS display: flex
    public override int StyleFlexDir() { return (vertical || Style.Has(Class, "column") || Style.Has(Class, "col")) ? 1 : 0; }
    private void InitButtonGroup(int type) {
        this.InitControl("buttongroup");
        btnType = type;
        btnStyle = 0;
        size = 2;
        vertical = false;
        active = 0 - 1;
        lastSyncedType = 0;
        lastSyncedStyle = 0;
        lastSyncedSize = 2;
        SelectionChanged = new UiEvent();
        Class = "row align-center";
    }
    public ButtonGroup() { InitButtonGroup(0); }
    public ButtonGroup(int type) { InitButtonGroup(type); }
    public ButtonGroup(string cls) : this(0) { this.Class = cls; }
    public bool IsOutline {
        get { return btnStyle == 1; }
        set { this.Outline(value); }
    }
    public bool IsVertical {
        get { return vertical; }
        set { this.Vertical(value); }
    }
    public int GroupSize {
        get { return size; }
        set { size = value; this.SyncGroup(); }
    }
    public void Outline(bool o) {
        btnStyle = o ? 1 : 0;
        if (o) { this.AddClass("outline"); }
        else { this.RemoveClass("outline"); }
        this.SyncGroup();
    }
    public void Vertical(bool v) {
        vertical = v;
        if (v) {
            this.AddClass("column");
            this.RemoveClass("row");
        } else {
            this.AddClass("row");
            this.RemoveClass("column");
        }
        this.SyncGroup();
    }
    public void SetSize(int s) { size = s; this.SyncGroup(); }
    public void SyncGroup() {
        bool vert = vertical || Style.Has(Class, "column") || Style.Has(Class, "col");
        if (vertical) {
            this.SwitchClass("column", true);
            this.SwitchClass("row", false);
        }
        this.SwitchClass("outline", btnStyle == 1);
        string sizeCls = "medium";
        if (size == 0) { sizeCls = "tiny"; }
        else if (size == 1) { sizeCls = "small"; }
        else if (size == 3) { sizeCls = "large"; }
        bool syncSize = size != 2 || lastSyncedSize != 2;
        if (syncSize) {
            this.SetClassIn("tiny small medium large", sizeCls);
        }
        string typeCls = "default";
        if (btnType == 1) { typeCls = "primary"; }
        else if (btnType == 2) { typeCls = "info"; }
        else if (btnType == 3) { typeCls = "success"; }
        else if (btnType == 4) { typeCls = "warning"; }
        else if (btnType == 5) { typeCls = "error"; }
        bool syncType = btnType != 0 || lastSyncedType != 0;
        bool syncOutline = btnStyle == 1 || lastSyncedStyle == 1;
        int firstBtn = 0 - 1;
        int lastBtn = 0 - 1;
        for (int i = 0; i < this.ChildCount(); i = i + 1) {
            if (this.ChildAt(i) is Button) {
                if (firstBtn < 0) { firstBtn = i; }
                lastBtn = i;
            }
        }
        for (int i = 0; i < this.ChildCount(); i = i + 1) {
            Control c = this.ChildAt(i);
            if (!(c is Button)) { continue; }
            Button b = (Button)c;
            if (syncType) { b.SetType(typeCls); }
            if (syncOutline) { b.SwitchClass("outline", btnStyle == 1); }
            if (syncSize) { b.SetSize(sizeCls); }
            bool first = (i == firstBtn);
            bool last = (i == lastBtn);
            b.SwitchClass("bg-seg", true);
            b.SwitchClass("bg-h-first", !vert && first);
            b.SwitchClass("bg-h-last", !vert && last);
            b.SwitchClass("bg-h-join", !vert && !first);
            b.SwitchClass("bg-v-first", vert && first);
            b.SwitchClass("bg-v-last", vert && last);
            b.SwitchClass("bg-v-join", vert && !first);
        }
        lastSyncedType = btnType;
        lastSyncedStyle = btnStyle;
        lastSyncedSize = size;
    }
    protected override void OnPropertyChanged(PropSpec spec) {
        this.SyncGroup();
    }
    public override void SyncBinding() {
        base.SyncBinding();
        this.SyncGroup();
    }
    public override void OnMeasure(App app) {
        this.SyncGroup();
        base.OnMeasure(app);
    }
    public override void OnPaint(App app) {
        this.SyncGroup();
        base.OnPaint(app);
    }
    public int SegCount() {
        int n = 0;
        for (int i = 0; i < this.ChildCount(); i = i + 1) {
            if (this.ChildAt(i) is Button) { n = n + 1; }
        }
        return n;
    }
    public void ClearSegs() {
        this.RemoveAll();
        active = 0 - 1;
        lastClicked = -1;
    }
    public void Add(string label) { this.Add(new Button(label)); this.SyncGroup(); }
    public void AddButton(Button b) { this.Add(b); this.SyncGroup(); }
    public Button ButtonAt(int i) {
        if (i >= 0 && i < this.ChildCount() && this.ChildAt(i) is Button) { return (Button)this.ChildAt(i); }
        return null;
    }
    public string ActiveLabel() {
        if (active >= 0 && active < this.ChildCount() && this.ChildAt(active) is Button) {
            Button b = (Button)this.ChildAt(active);
            return b.Label();
        }
        for (int i = 0; i < this.ChildCount(); i = i + 1) {
            if (!(this.ChildAt(i) is Button)) { continue; }
            Button b = (Button)this.ChildAt(i);
            if (Style.Has(b.Class, "active")) { return b.Label(); }
        }
        return "";
    }
    public int Active() { return active; }
    public void SetActiveIndex(int idx) {
        active = idx;
        for (int k = 0; k < this.ChildCount(); k = k + 1) {
            if (!(this.ChildAt(k) is Button)) { continue; }
            Button b = (Button)this.ChildAt(k);
            if (k == idx) { b.AddClass("active"); } else { b.RemoveClass("active"); }
        }
    }
    public void SetActive(string label) {
        if (label == "") { this.SetActiveIndex(0 - 1); return; }
        for (int k = 0; k < this.ChildCount(); k = k + 1) {
            if (!(this.ChildAt(k) is Button)) { continue; }
            Button b = (Button)this.ChildAt(k);
            if (b.Label() == label) { this.SetActiveIndex(k); return; }
        }
    }
    public override void OnChildEvent(Control child, string evt) {
        base.OnChildEvent(child, evt);
        if (evt != "Click" || child == null || child.parent != this || !(child is Button)) { return; }
        int index = this.IndexOf(child);
        if (index < 0) { return; }
        lastClicked = index;
        this.SetActiveIndex(index);
        SelectionChanged.Raise(this);
    }
    internal int TakeSelectionAction() {
        int result = lastClicked;
        lastClicked = -1;
        return result;
    }

    protected override List<PropSpec> DefineProps() {
        List<PropSpec> ps = new List<PropSpec>();
        PropSpec type = PropSpec.Enum("type", "Type",
            new List<string>{ "default", "primary", "info", "success",
                              "warning", "error" });
        type.Field("btnType");
        ps.Add(type);
        PropSpec style = PropSpec.Enum("style", "Style",
            new List<string>{ "solid", "outline" });
        style.Field("btnStyle");
        ps.Add(style);
        PropSpec sz = PropSpec.Enum("size", "Size",
            PropSpec.Sizes());
        sz.Field("size");
        ps.Add(sz);
        ps.Add(PropSpec.Bool("vertical", "Vertical").Field("vertical"));
        return ps;
    }
}
