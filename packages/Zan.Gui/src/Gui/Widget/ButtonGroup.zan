using System;
using Gui;

namespace Gui.Widget;

/// 一个焊接段：其标签和稳定控件 id（用于焦点/命中）。
/// 用一个实体代替并行的标签/id 列表。
class ButtonSegment {
    /// 段标签。
    string label;
    /// 稳定控件 id（命中/焦点）。
    int id;

    /// 构造一段。
    ButtonSegment(string label, int id) {
        this.label = label;
        this.id = id;
    }

    /// 段标签（宿主按值对账时读取）。
    string Label() { return label; }
}

/// <summary>
/// NaiveUI 风格的吸附按钮组：多个按钮焊接在一起，
/// 共享边框（仅组的外角为圆角），段间有 1px 分隔线。
/// 支持横向或纵向。所有颜色来自主题，
/// 可自动跟随皮肤变化。
///
///   ButtonGroup g = new ButtonGroup(1);   // primary（主样式）
///   g.Add("Left"); g.Add("Middle"); g.Add("Right");
///   int hit = g.Render(app, 40, 60);          // 被点击的索引，或 -1
/// </summary>
class ButtonGroup : Control {
    /// 焊接分段（分段模式的内容，Add 追加）。
    List<ButtonSegment> segs;
    /// 按钮类型，决定配色（经 Style.TypeColor/TypeFill 查询）。
    int btnType;
    /// 0 常规 / 1 描边（Outline）。
    int btnStyle;
    /// 尺寸档：0 tiny / 1 small / 2 medium / 3 large（Height/FontSz）。
    int size;
    /// 纵向排列（仅分段模式）。
    bool vertical;

    /// 条状模式（由旧 ButtonBar 吸收而来）：一排常驻的真实
    /// Button 控件，窄时换行，并上报哪个按钮被按下。
    /// 当 `barMode` 为 false 时，该控件即焊接分段
    /// 组，通过 `Render(app, x, y)` 立即渲染。
    bool barMode;
    /// bar 模式的常驻子按钮。
    List<Button> barBtns;
    /// 上一帧按下的按钮索引；-1 无（TakePressed 消费）。
    int pressed;
    /// 上一帧被点击的段索引；-1 无（TakeClicked 消费，分段模式）。
    int clicked;
    /// 当前高亮段（-1 无）——数据驱动用法里表示该行的当前值。
    int active;
    /// bar 模式行高（测量时由按钮高度得出）。
    int lineH;
    /// bar 模式换行后的行数（测量时得出）。
    int lines;

    /// 分段模式构造：type 决定配色，默认 medium 尺寸、横向。
    ButtonGroup(int type) {
        this.InitControl("buttongroup", 5);
        this.segs = new List<ButtonSegment>();
        this.btnType = type;
        this.btnStyle = 0;
        this.size = 2;
        this.vertical = false;
        this.barMode = false;
        this.barBtns = new List<Button>();
        this.pressed = 0 - 1;
        this.clicked = 0 - 1;
        this.active = 0 - 1;
        this.lineH = 0;
        this.lines = 1;
    }

    /// 追加一个段（自动分配稳定控件 id），链式返回自身。
    ButtonGroup Add(string label) {
        segs.Add(new ButtonSegment(label, WidgetId.Next()));
        return this;
    }

    /// 段数（程序化灌入/对账用）。
    int SegCount() { return segs.Count; }

    /// 清空全部段（选项重灌前用；点击态一并复位）。
    void ClearSegs() {
        segs = new List<ButtonSegment>();
        clicked = 0 - 1;
        active = 0 - 1;
    }

    /// 描边样式开关（链式）。
    ButtonGroup Outline(bool o) { if (o) { btnStyle = 1; } else { btnStyle = 0; } return this; }
    /// 纵向排列开关（链式，仅分段模式生效）。
    ButtonGroup Vertical(bool v) { vertical = v; return this; }
    /// 尺寸档（链式）：0 tiny / 1 small / 2 medium / 3 large。
    ButtonGroup SetSize(int s) { size = s; return this; }

    /// 一排常驻的横向 Button 控件条（旧 ButtonBar）。
    /// 用 AddButton() 添加按钮；它会自动布局、窄时换行，
    /// 并通过 TakePressed() 上报按下索引。可作布局子控件。
    static ButtonGroup Bar(string cls) {
        ButtonGroup g = new ButtonGroup(0);
        g.Class = cls;
        g.barMode = true;
        return g;
    }

    /// bar 模式追加一个按钮（链式）。
    ButtonGroup AddButton(Button b) {
        barBtns.Add(b);
        return this;
    }

    /// 第 i 个 bar 按钮（不查越界）。
    Button ButtonAt(int i) { return barBtns[i]; }

    /// 上一帧按下的按钮（-1 为无）。此读取会消耗该状态，
    /// 页面恰好处理一次。
    int TakePressed() {
        int i = pressed;
        pressed = 0 - 1;
        return i;
    }

    /// 上一帧被点击的段（-1 为无），分段模式专用。此读取会
    /// 消耗该状态——保留模式嵌格时由宿主每帧询问一次。
    int TakeClicked() {
        int i = clicked;
        clicked = 0 - 1;
        return i;
    }

    /// 当前高亮段（-1 无）。数据驱动的分段组（表格组件列等）
    /// 用它表达行的当前值。
    int Active() { return active; }

    /// 当前高亮段的标签（无高亮返回空串）。
    string ActiveLabel() {
        if (active < 0 || active >= segs.Count) { return ""; }
        return SegLabel(active);
    }

    /// 按下标设高亮段（-1 清除）；越界静默忽略。
    void SetActiveIndex(int idx) {
        if (idx < 0 - 1 || idx >= segs.Count) { return; }
        active = idx;
    }

    /// 按标签设高亮段；`label` 为空串清除。无匹配项时保留原状
    /// （灌入的是数据文本，比高亮显示更权威）。
    void SetActive(string label) {
        if (label == "") { active = 0 - 1; return; }
        for (int i = 0; i < segs.Count; i = i + 1) {
            if (SegLabel(i) == label) { active = i; return; }
        }
    }

    /// 第 i 段的标签（越界返回空串）。
    string SegLabel(int i) {
        if (i < 0 || i >= segs.Count) { return ""; }
        return segs[i].Label();
    }

    /// 各 bar 按钮的自然宽度（AutoWidth）。
    List<int> BarWidths(App app) {
        List<int> w = new List<int>();
        for (int i = 0; i < barBtns.Count; i = i + 1) {
            w.Add(barBtns[i].AutoWidth(app));
        }
        return w;
    }

    /// 条状按钮之间的间距。默认 0：组的按钮
    /// 焊接成一条（这正是它看起来像组而不是三个散按钮的原因）；
    /// 若样式表给元素设置 `gap`，
    /// 又会把它们分开。
    int BarGap(App app) {
        int g = this.StyleGap();
        if (g < 0) { g = 0; }
        return g;
    }

    /// 焊接行中第 `i` 个按钮保留哪些角：只有行两端
    /// 为圆角，内部接缝为直角。
    static int WeldCorners(bool first, bool last) {
        if (first && last) { return Corner.All(); }
        if (first) { return Corner.Left(); }
        if (last) { return Corner.Right(); }
        return 0;
    }

    /// 控件类型标识（序列化/设计器用）。
    override string Kind() { return "ButtonGroup"; }

    /// 覆写：返回设计器属性清单（类型 / 样式 / 尺寸档 / 纵向 / 类）。
    /// 枚举轴一律 PropSpec.Enum + options：面板出下拉而非裸整数框；
    /// 绑定仍是 num（存序号），PropertyGrid 对旧文档的整数串双向兼容。
    override List<PropSpec> Props() {
        List<PropSpec> ps = new List<PropSpec>();
        PropSpec type = PropSpec.Enum("type", "Type",
            new List<string>{ "default", "primary", "info", "success",
                              "warning", "error" });
        type.num = btnType;
        ps.Add(type);
        PropSpec style = PropSpec.Enum("style", "Style",
            new List<string>{ "solid", "outline" });
        style.num = btnStyle;
        ps.Add(style);
        PropSpec sz = PropSpec.Enum("size", "Size",
            PropSpec.Sizes());
        sz.num = size;
        ps.Add(sz);
        PropSpec vert = PropSpec.Bool("vertical", "Vertical");
        vert.flag = vertical;
        ps.Add(vert);
        return ps;
    }

    /// 覆写：CSS 类型选择器名（"buttongroup"）。
    override string StyleType() { return "buttongroup"; }

    /// 覆写：bar 模式按按钮自然宽与组宽推行数并回写首选高度；
    /// 分段模式首选高度即段高（`bw` 未设时按段数估宽），
    /// 保留态宿主（MeasureTree）据此给足格矩形。
    override void OnMeasure(App app) {
        if (!barMode) {
            if (this.segs.Count > 0) {
                prefH = this.Height(app.theme);
                prefW = this.SegMaxW(app.theme, this.FontSz(app,
                    Style.Of(app, "buttongroup", Class, Style.SNormal())))
                    * this.segs.Count;
            }
            return;
        }
        lineH = app.theme.heightMedium;
        if (barBtns.Count > 0) { lineH = barBtns[0].AutoHeight(app); }
        lines = 1;
        if (bw > 0) {
            List<int> w = this.BarWidths(app);
            int gapPx = this.BarGap(app);
            int used = 0;
            for (int i = 0; i < w.Count; i = i + 1) {
                int step = w[i];
                if (used > 0) { step = step + gapPx; }
                if (used + step > bw && used > 0) {
                    lines = lines + 1;
                    used = w[i];
                } else {
                    used = used + step;
                }
            }
        }
        prefH = lines * lineH + (lines - 1) * this.BarGap(app);
    }

    /// 覆写：保留模式绘制——bar 模式换行排布各按钮（焊接行只在
    /// 行首/行尾保留圆角）、记录按下的索引并画接缝分隔线；
    /// 分段模式转调立即渲染 Render，把点击暂存进 clicked 供
    /// TakeClicked 消费（DataTable 组件列等保留态宿主用）。
    override void OnPaint(App app) {
        if (!barMode) {
            clicked = this.Render(app, bx, by);
            return;
        }
        pressed = 0 - 1;
        int n = barBtns.Count;
        if (n == 0 || bw <= 0) { return; }
        List<int> w = this.BarWidths(app);
        int gapPx = this.BarGap(app);
        bool weld = gapPx == 0;
        StyleBox barStyle = Style.Of(app, "buttongroup", Class,
                                     Style.SNormal());
        int x = bx;
        int y = by;
        for (int i = 0; i < n; i = i + 1) {
            int bwi = w[i];
            bool lineStart = x == bx;
            if (!lineStart && x + bwi > bx + bw) {
                x = bx;
                y = y + lineH + gapPx;
                lineStart = true;
            }
            if (bwi > bw) { bwi = bw; }
            // 焊接行在下一个按钮放不下时结束，因此
            // 每行最后一个按钮保留圆角外角。
            bool lineEnd = i == n - 1;
            if (!lineEnd && x + bwi + w[i + 1] > bx + bw) { lineEnd = true; }
            if (weld) {
                barBtns[i].corners = ButtonGroup.WeldCorners(lineStart, lineEnd);
            }
            int id = barBtns[i].Render(app, x, y, bwi);
            if (Ui.Clicked(app, id)) { pressed = i; }
            // 焊接处留一条分隔线，使相邻两个按钮仍能看出是两个。
            // 线宽取组自身的 border-width，这样它会跟着 DPI 一起
            // 缩放——写死 1px 在 200% 显示下细到几乎看不见。
            if (weld && !lineEnd) {
                int seam = barStyle.BorderWOr(1);
                if (seam > 0) {
                    app.canvas.FillRect(x + bwi - seam,
                                        y + app.theme.paddingTiny, seam,
                                        lineH - app.theme.paddingTiny * 2,
                                        barStyle.BorderOr(0));
                }
            }
            x = x + bwi + gapPx;
        }
    }

    /// 类型对应的主题强调色。
    int TypeColor(Theme t) { return Style.TypeColor(t, btnType); }

    /// 尺寸档对应的主题行高。
    int Height(Theme t) {
        if (size == 0) { return t.heightTiny; }
        if (size == 1) { return t.heightSmall; }
        if (size == 3) { return t.heightLarge; }
        return t.heightMedium;
    }

    /// 尺寸档对应的字号（样式 font 优先）。
    int FontSz(App app, StyleBox s) {
        if (size == 0) { return s.FontOr(Style.FontFallback(app, "tiny")); }
        if (size == 1) { return s.FontOr(Style.FontFallback(app, "small")); }
        if (size == 3) { return s.FontOr(Style.FontFallback(app, "large")); }
        return s.FontOr(Style.FontFallback(app, "medium"));
    }

    /// 立即模式渲染整组：绘制各段并处理点击/悬停/焦点。
    /// 返回被点击的段索引，无点击返回 -1。仅分段模式使用。
    /// 高亮段（active）画填充反色以表达"当前值"。
    int Render(App app, int x, int y) {        Canvas c = app.canvas;
        Theme t = app.theme;
        int h = Height(t);
        int radius = t.borderRadiusMedium;
        int tc = TypeColor(t);
        int n = segs.Count;
        int clicked = 0 - 1;
        StyleBox groupStyle = Style.Of(app, "buttongroup", Class,
                                       Style.SNormal());
        int fs = FontSz(app, groupStyle);

        int cursor = 0;
        for (int i = 0; i < n; i = i + 1) {
            ButtonSegment seg = segs[i];
            int id = seg.id;
            int fsz = fs;
            int segLen = Canvas.MeasureText(seg.label, fsz) + t.paddingMedium * 2;
            int sx = x;
            int sy = y;
            int sw = segLen;
            int sh = h;
            if (vertical) { sy = y + cursor; sw = SegMaxW(t, fsz); }
            else { sx = x + cursor; }

            bool hovered = app.focus.IsHovered(id);
            bool pressed = app.focus.IsPressed(id);
            bool activeSeg = i == active;

            // 表面颜色取自 Button，使焊接组与单个按钮
            // 对悬停/按下/皮肤变化的反应完全一致；
            // 只有下面的圆角焊接是本控件自身的逻辑。
            // 高亮段强制主样式填充，近似 NaiveUI 选中段。
            int fill = activeSeg
                ? TypeColor(t)
                : Style.TypeFill(t, btnType, btnStyle, hovered, pressed);
            int fg = activeSeg ? Style.TypeFg(t, 1, 0)
                               : Style.TypeFg(t, btnType, btnStyle);

            bool first = (i == 0);
            bool last = (i == n - 1);
            FillSeg(c, sx, sy, sw, sh, radius, fill, first, last);

            int textY = Canvas.CenterTextY(sy, sh, fsz);
            int textX = sx + (sw - Canvas.MeasureText(seg.label, fsz)) / 2;
            c.DrawText(textX, textY, seg.label, fg, fsz);

            if (btnStyle == 1) {
                // 整个组的外围圆角边框，按段绘制，
                // 内边用相同的端帽技巧保持直角。
                StrokeSeg(c, sx, sy, sw, sh, radius, tc, first, last, vertical);
            }

            // 相邻段之间的分隔线。
            if (!last) {
                int dv = App.Darken(tc, 60);
                if (btnStyle == 1 || btnType == 0) {
                    dv = groupStyle.BorderOr(0);
                }
                if (vertical) { c.FillRect(sx, sy + sh - 1, sw, 1, dv); }
                else { c.FillRect(sx + sw - 1, sy, 1, sh, dv); }
            }

            app.hitTester.RegisterRect(id, sx, sy, sw, sh, 0);
            app.focus.RegisterFocusable(id);
            if (Ui.Clicked(app, id)) {
                clicked = i;
                // 点击即高亮（数据驱动的分段组用它表达行的当前值）。
                active = i;
            }

            if (vertical) { cursor = cursor + sh; }
            else { cursor = cursor + sw; }
        }
        return clicked;
    }

    /// 最长段的宽度（纵向排列时各段按它等宽对齐）。
    int SegMaxW(Theme t, int fs) {
        int m = 0;
        for (int i = 0; i < segs.Count; i = i + 1) {
            int w = Canvas.MeasureText(segs[i].label, fs) + t.paddingMedium * 2;
            if (w > m) { m = w; }
        }
        return m;
    }

    /// 填充一个段，仅对组的外角做圆角。
    void FillSeg(Canvas c, int x, int y, int w, int h, int r, int col,
            bool first, bool last) {
        if (first && last) {
            c.FillRoundRect(x, y, w, h, r, col);
            return;
        }
        if (vertical) {
            if (first) {
                c.FillRoundRect(x, y, w, h, r, col);
                c.FillRect(x, y + h - r, w, r, col);
            } else if (last) {
                c.FillRoundRect(x, y, w, h, r, col);
                c.FillRect(x, y, w, r, col);
            } else {
                c.FillRect(x, y, w, h, col);
            }
            return;
        }
        if (first) {
            c.FillRoundRect(x, y, w, h, r, col);
            c.FillRect(x + w - r, y, r, h, col);
        } else if (last) {
            c.FillRoundRect(x, y, w, h, r, col);
            c.FillRect(x, y, r, h, col);
        } else {
            c.FillRect(x, y, w, h, col);
        }
    }

    /// 段的描边（外角圆角）。
    void StrokeSeg(Canvas c, int x, int y, int w, int h, int r, int col,
            bool first, bool last, bool vert) {
        if (first && last) { c.DrawRoundRect(x, y, w, h, r, col, 1); return; }
        // 上下边缘始终存在。
        c.FillRect(x, y, w, 1, col);
        c.FillRect(x, y + h - 1, w, 1, col);
        if (!vert) {
            if (first) { c.FillRect(x, y, 1, h, col); }
            if (last) { c.FillRect(x + w - 1, y, 1, h, col); }
        } else {
            c.FillRect(x, y, 1, h, col);
            c.FillRect(x + w - 1, y, 1, h, col);
            if (first) { c.FillRect(x, y, w, 1, col); }
            if (last) { c.FillRect(x, y + h - 1, w, 1, col); }
        }
    }
}
