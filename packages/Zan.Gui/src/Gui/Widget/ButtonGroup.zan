using System;
using Gui;

namespace Gui.Widget;

// 按钮组（ButtonGroup）：纯 Flex 容器，支持声明式装载 Button 子节点。
// 外壳与间隙完全由 CSS 盒模型驱动，彻底物理消除 Render(app, x, y)、SubBox.Paint 与手算坐标。
public class ButtonGroup : Control {
    private int btnType;
    private int btnStyle;
    private int size;
    private bool vertical;

    public override int StyleDisplay() { return 1; } // CSS display: flex
    public override int StyleFlexDir() { return vertical ? 1 : 0; }

    private void InitButtonGroup(int type) {
        this.InitControl("buttongroup", 5);
        btnType = type;
        btnStyle = 0;
        size = 2;
        vertical = false;
        Class = "row align-center";
    }

    public ButtonGroup() { InitButtonGroup(0); }
    public ButtonGroup(int type) { InitButtonGroup(type); }

    public static ButtonGroup Bar(string cls) {
        ButtonGroup g = new ButtonGroup(0);
        g.Class = cls;
        return g;
    }

    public ButtonGroup Outline(bool o) {
        btnStyle = o ? 1 : 0;
        if (o) { this.AddClass("outline"); }
        else { this.RemoveClass("outline"); }
        return this;
    }

    public ButtonGroup Vertical(bool v) {
        vertical = v;
        if (v) {
            this.AddClass("column");
            this.RemoveClass("row");
        } else {
            this.AddClass("row");
            this.RemoveClass("column");
        }
        return this;
    }

    public ButtonGroup SetSize(int s) {
        size = s;
        return this;
    }

    // 段数（段按钮个数）。
    public int SegCount() {
        int n = 0;
        for (int i = 0; i < children.Count; i = i + 1) {
            if (children[i] is Button) { n = n + 1; }
        }
        return n;
    }

    // 清空全部段。
    public void ClearSegs() { this.children.Clear(); }

    // 按标签追加一个段（返回本组，链式）。
    public ButtonGroup Add(string label) {
        this.Add(new Button(label));
        return this;
    }

    public ButtonGroup AddButton(Button b) {
        this.Add(b);
        return this;
    }

    public Button ButtonAt(int i) {
        if (i >= 0 && i < children.Count && children[i] is Button) {
            return (Button)children[i];
        }
        return null;
    }

    // ---- 段选择 conveniences（DataTable 组件列等保留态宿主用）----
    // 高亮以段按钮的 `active` 类为准；点击消费读段按钮的 clicked 逐帧标志。

    // 当前高亮段的标签（无高亮为空串）。
    public string ActiveLabel() {
        for (int i = 0; i < children.Count; i = i + 1) {
            if (!(children[i] is Button)) { continue; }
            Button b = (Button)children[i];
            if (Style.Has(b.Class, "active")) { return b.Label(); }
        }
        return "";
    }

    // 按下标设高亮段（-1 清除）；越界静默忽略。
    public void SetActiveIndex(int idx) {
        for (int k = 0; k < children.Count; k = k + 1) {
            if (!(children[k] is Button)) { continue; }
            Button b = (Button)children[k];
            if (k == idx) { b.AddClass("active"); } else { b.RemoveClass("active"); }
        }
    }

    // 按标签设高亮段；`label` 为空串清除。无匹配项时保留原状。
    public void SetActive(string label) {
        if (label == "") { this.SetActiveIndex(0 - 1); return; }
        for (int k = 0; k < children.Count; k = k + 1) {
            if (!(children[k] is Button)) { continue; }
            Button b = (Button)children[k];
            if (b.Label() == label) { b.AddClass("active"); }
        }
    }

    // 本帧被点击的段索引；-1 无（消费语义：读后即清）。
    public int TakeClicked() {
        for (int k = 0; k < children.Count; k = k + 1) {
            if (!(children[k] is Button)) { continue; }
            Button b = (Button)children[k];
            if (b.clicked) {
                b.clicked = false;
                return k;
            }
        }
        return 0 - 1;
    }

    public override string Kind() { return "ButtonGroup"; }

    public override List<PropSpec> Props() {
        List<PropSpec> ps = new List<PropSpec>();
        PropSpec type = PropSpec.Enum("type", "Type",
            new List<string>{ "default", "primary", "info", "success",
                              "warning", "error" });
        type.num = btnType;
        ps.Add(type);
        PropSpec style = PropSpec.Enum("style", "Style",
            new List<string>{ "solid", "outline" });
        style.num = btnStyle;
        ps.Add(style);
        PropSpec sz = PropSpec.Enum("size", "Size",
            PropSpec.Sizes());
        sz.num = size;
        ps.Add(sz);
        PropSpec vert = PropSpec.Bool("vertical", "Vertical");
        vert.flag = vertical;
        ps.Add(vert);
        return ps;
    }
}
