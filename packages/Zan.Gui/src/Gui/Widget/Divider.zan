using System;
using Gui;

namespace Gui.Widget;

// 分隔线组件：纯 CSS 盒模型驱动的水平或垂直线，支持嵌入居左/居中/居右标题。
// 彻底物理消除 SubBox.Paint、手动坐标微算与 Canvas.DrawText。
public class Divider : Control {
    public Binding<string> Text;

    public override int StyleDisplay() { return 1; } // CSS display: flex
    public override int StyleFlexDir() { return 0; } // flex-direction: row

    private void InitDivider(string title) {
        this.InitControl("divider", 1);
        Text = title;
        this.RebuildStructure();
    }

    public Divider() { InitDivider(""); }
    public Divider(string title) { InitDivider(title); }

    public string Label() {
        if (Text == null) { return ""; }
        return Text.Get();
    }

    public void SetText(string t) {
        Text = t;
        this.RebuildStructure();
        App a = this.FindApp();
        if (a != null) { a.RequestRedraw(); }
    }

    public void RebuildStructure() {
        this.children.Clear();
        string title = this.Label();
        if (title != "") {
            Control leftLine = new Control();
            leftLine.ClassName = "divider-line flex-1";

            Label titleLabel = new Label(title);
            titleLabel.ClassName = "divider-text";

            Control rightLine = new Control();
            rightLine.ClassName = "divider-line flex-1";

            this.Add(leftLine);
            this.Add(titleLabel);
            this.Add(rightLine);
        }
    }

    public override void CloneContentTo(Control target, CloneTreeFn clone) {
        // Constructor and property replay recreate the generated parts.
    }

    public override string Kind() { return "Divider"; }

    public override List<PropSpec> Props() {
        List<PropSpec> ps = new List<PropSpec>();
        PropSpec text = PropSpec.Text("text", "Text");
        text.str = Text;
        ps.Add(text);
        return ps;
    }
}
