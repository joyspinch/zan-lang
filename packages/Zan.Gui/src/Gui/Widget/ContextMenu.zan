using System;
using Gui;

namespace Gui.Widget;

// 悬浮的右键上下文菜单。在 (mx, my) 绘制，位置被限制在
// 窗口内，拦截下层点击，并在本帧报告用户的选择：
// -1 = 尚无选择，-2 = 已关闭（点击外部），或所选
// 标签的索引。内容为 "-" 的条目渲染为分隔线。
class ContextMenu {
    // 上一帧悬停到的行；菜单是即时模式绘制的，用它判断是否值得
    // 为一次鼠标移动重绘。
    static int lastHover;

    // 菜单行：悬停高亮、标签以及可选的右对齐
    // 快捷键/勾选标记。公开出来，使自带菜单的控件
    // （表头菜单、设计器）获得一致的行，而无需重复
    // 绘制。`hovered` 由调用方传入，因为有的菜单按几何
    // 命中测试，有的通过注册的 id。
    static void PaintItem(App app, int x, int y, int w, int h,
                          string label, string accel, bool hovered) {
        Canvas c = app.canvas;
        StyleBox s;
        int state = Style.SNormal();
        if (hovered) { state = Style.SHover(); }
        s = Style.Part(app, "contextmenu", "item", "", "", "", state);
        int fs = s.FontOr(Style.FontFallback(app, "small"));
        int ty = Canvas.CenterTextY(y, h, fs);
        ty = Canvas.CenterTextY(y, h, fs);
        if (hovered && s.bg != 0) { c.FillRect(x, y, w, h, s.bg); }
        c.DrawText(x + app.Scale(12), ty, label, s.fg, fs);
        if (accel.Length > 0) {
            StyleBox asx = Style.Part(app, "contextmenu", "accel", "", "",
                                      "", Style.SNormal());
            int aw = Canvas.MeasureText(accel, fs);
            c.DrawText(x + w - aw - app.Scale(12), ty, accel, asx.fg, fs);
        }
    }

    // 菜单内的分隔行。
    static void PaintSeparator(App app, int x, int y, int w) {
        StyleBox s = Style.Part(app, "contextmenu", "separator", "", "", "",
                                Style.SNormal());
        app.canvas.FillRect(x + app.Scale(6), y, w - app.Scale(12), 1, s.bg);
    }

    // `labels` 将占用的高度，使调用方把菜单锚定在按钮上方时
    // （如面板底部的输入行）能传入正确的 `my`，
    // 而不依赖会把菜单挤到窗口边缘的裁剪逻辑。
    static int Height(App app, List<string> labels) {
        StyleBox s = Style.Part(app, "contextmenu", "item", "", "", "",
                                Style.SNormal());
        int itemH = Canvas.FontHeight(
            s.FontOr(Style.FontFallback(app, "small"))) + app.Scale(5);
        int sepH = app.Scale(5);
        int h = app.Scale(4) * 2;
        for (int i = 0; i < labels.Count; i = i + 1) {
            if (labels[i] == "-") { h = h + sepH; } else { h = h + itemH; }
        }
        return h;
    }

    // 在 (mx, my) 绘制菜单并处理本帧交互：返回 -1 尚无选择、
    // -2 已关闭（点击外部/在菜单外右键），其余为所选条目下标。
    // 宽度按最宽条目自适应，位置钳制到窗口内。
    static int Render(App app, int mx, int my, List<string> labels) {
        Canvas c = app.canvas;
        Theme t = app.theme;
        StyleBox itemStyle = Style.Part(app, "contextmenu", "item", "", "",
                                        "", Style.SNormal());
        int fontSize = itemStyle.FontOr(Style.FontFallback(app, "small"));
        int itemH = Canvas.FontHeight(fontSize) + app.Scale(5);
        int sepH = app.Scale(5);
        int mW = app.Scale(130);
        for (int i = 0; i < labels.Count; i = i + 1) {
            if (labels[i] != "-") {
                int lw = Canvas.MeasureText(labels[i], fontSize) + app.Scale(20);
                if (lw > mW) { mW = lw; }
            }
        }
        int mH = ContextMenu.Height(app, labels);

        int winW = c.Width();
        int winH = c.Height();
        if (mx + mW > winW) { mx = winW - mW - app.Scale(4); }
        if (my + mH > winH) { my = winH - mH - app.Scale(4); }
        if (mx < 0) { mx = 0; }
        if (my < app.titlebarH) { my = app.titlebarH; }

        // 打开的上下文菜单拥有整个窗口：菜单外的按压/点击必须
        // 被全窗遮罩吞掉（右键除外——它解析到菜单下方以便把菜单
        // 挪到新位置重开，Windows 惯例）。只有菜单矩形自身的
        // BlockHitsRect 不够：菜单外的点击会同时把 -2（关闭）送给
        // 调用方、又命中其下的控件——同一个手势先关菜单再点穿到
        // 背后的内容（IDE 外壳菜单已用 BlockHitsMenu 包裹，这是
        // 其余所有调用方共用的同一道防线，且菜单开启期间
        // PointerCaptured 为真，几何悬停也不会漏到下层）。
        app.BlockHitsMenu();

        // 行按几何方式命中测试，而非注册的点击区域，因此指针移动时
        // 若无其他重绘，悬停高亮永远不会跟随。只在悬停到的那一行真的
        // 变了时重绘：菜单一开就每个鼠标移动事件重绘一整帧太贵。
        int hovRow = 0 - 1;
        int hy = my + app.Scale(4);
        for (int hi = 0; hi < labels.Count; hi = hi + 1) {
            int rh = itemH;
            if (labels[hi] == "-") { rh = sepH; }
            else if (app.mouseX >= mx && app.mouseX < mx + mW
                     && app.mouseY >= hy && app.mouseY < hy + rh) {
                hovRow = hi;
            }
            hy = hy + rh;
        }
        if (hovRow != ContextMenu.lastHover) {
            ContextMenu.lastHover = hovRow;
            app.RequestRedraw();
        }

        StyleBox s = Style.Of(app, "contextmenu", "", Style.SNormal());
        c.FillRoundRect(mx + s.shadowDx, my + s.shadowDy, mW, mH,
                        app.Scale(4), s.shadow);
        app.canvas.SurfaceRoundRect(mx, my, mW, mH,
            s.RadiusOr(app.theme.borderRadiusLarge), s.bg,
            s.borderColor, s.BorderWOr(1));
        app.BlockHitsRect(mx, my, mW, mH);

        int ry = my + app.Scale(4);
        for (int ri = 0; ri < labels.Count; ri = ri + 1) {
            if (labels[ri] == "-") {
                ContextMenu.PaintSeparator(app, mx, ry + sepH / 2, mW);
                ry = ry + sepH;
            } else {
                bool hov = app.mouseX >= mx && app.mouseX < mx + mW
                           && app.mouseY >= ry && app.mouseY < ry + itemH;
                ContextMenu.PaintItem(app, mx, ry, mW, itemH, labels[ri], "", hov);
                ry = ry + itemH;
            }
        }

        // 在菜单外右键：菜单让位。若那一下落在某个会开菜单的控件上，
        // 该控件已经在本帧更早把菜单挪到了新位置（此时指针就在新的
        // 矩形里，不会走到这里），所以这里只处理“右键点在别的地方”。
        if (app.EventKind() == 2 && app.window.EventButton() == 1) {
            bool onMenu = app.mouseX >= mx && app.mouseX < mx + mW
                          && app.mouseY >= my && app.mouseY < my + mH;
            if (!onMenu) { return 0 - 2; }
        }

        if (app.ClickAvailable() && app.window.EventButton() == 0) {
            bool inside = app.mouseX >= mx && app.mouseX < mx + mW
                          && app.mouseY >= my && app.mouseY < my + mH;
            if (inside) {
                int cy = my + app.Scale(4);
                for (int ci = 0; ci < labels.Count; ci = ci + 1) {
                    int rh = itemH;
                    if (labels[ci] == "-") { rh = sepH; }
                    if (labels[ci] != "-" && app.mouseY >= cy && app.mouseY < cy + rh) {
                        return ci;
                    }
                    cy = cy + rh;
                }
                return 0 - 1;
            }
            return 0 - 2;
        }
        return 0 - 1;
    }
}
