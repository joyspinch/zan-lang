using System;
using Gui;

namespace Gui.Widget;

// 上下文菜单（ContextMenu）：纯声明式浮层组件，继承自 Control。
// 仅支持声明式对象树与 CSS 盒模型，物理删除所有 Canvas 手动微绘与即时模式 Render 入口。
public class ContextMenu : Control {
    public List<MenuItem> items;
    public UiEvent ActionSelected;

    public override int StyleDisplay() { return 1; } // Flex
    public override int StyleFlexDir() { return 1; } // Column

    public ContextMenu() {
        this.InitControl("contextmenu", 1);
        this.ClassName = "contextmenu col";
        this.items = new List<MenuItem>();
        this.ActionSelected = new UiEvent();
        this.wiresOwnEvents = true;
    }

    // 与 items 平行的动作表：MenuItem.action 是宿主动作码（int），
    // 保留式菜单的动作回调由本类持有，BuildTree 时接到对应按钮。
    List<Action> itemActions;

    public void AddItem(string label, Action a) {
        if (itemActions == null) { itemActions = new List<Action>(); }
        MenuItem mi = MenuItem.Item(label, "", itemActions.Count);
        items.Add(mi);
        itemActions.Add(a);
        this.BuildTree();
    }

    public void AddSeparator() {
        MenuItem sep = MenuItem.Separator();
        items.Add(sep);
        this.BuildTree();
    }

    public void BuildTree() {
        this.children.Clear();
        for (int i = 0; i < items.Count; i = i + 1) {
            MenuItem it = items[i];
            if (it.kind == 1) {
                Control sepNode = new Control();
                sepNode.ClassName = "contextmenu-separator";
                this.Add(sepNode);
                continue;
            }
            if (it.kind == 2) {
                Label header = new Label(it.label);
                header.ClassName = "contextmenu-header";
                this.Add(header);
                continue;
            }
            Button btn = new Button(it.label);
            btn.ClassName = "contextmenu-item row align-center";
            if (it.disabled) { btn.Disabled = true; }
            int ai = it.action;
            if (ai >= 0 && itemActions != null && ai < itemActions.Count) {
                Action act = itemActions[ai];
                btn.Click.Add(act);
            }
            this.Add(btn);
        }
    }

    public override void OnPaint(App app) {
        int id = this.CommonId();
        SyncBinding();
        app.focus.RegisterFocusable(id);
        app.hitTester.RegisterRect(id, bx, by, bw, bh, 0);
        On.Fire(app, id, this);
    }
}
