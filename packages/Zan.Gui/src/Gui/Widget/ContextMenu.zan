using System;
using Gui;

namespace Gui.Widget;

// Retained menus use ShowAt; the ownerless static Render remains legacy compatibility.
public class ContextMenu : Control {
    public List<MenuItem> items;
    public UiEvent ActionSelected;
    List<Action> itemActions;
    bool treeDirty = true;
    bool opened;
    int generation;
    int selectedAction = -1;
    bool resultPending;
    weak App popupApp;

    public override int StyleDisplay() { return 1; }
    public override int StyleFlexDir() { return 1; }

    public ContextMenu() {
        this.InitControl("contextmenu", 1);
        this.ClassName = "contextmenu col";
        items = new List<MenuItem>();
        itemActions = new List<Action>();
        ActionSelected = new UiEvent();
        this.wiresOwnEvents = true;
        this.Pad(Space.XS);
    }

    public void AddItem(string label, Action action) {
        int index = items.Count;
        this.AddItem(MenuItem.Item(ContextMenu.ParseMainLabel(label), "", index));
        items[index].shortcut = ContextMenu.ParseAccel(label);
        itemActions[index] = action;
    }

    public void AddItem(MenuItem item) {
        if (item == null) { return; }
        items.Add(item);
        while (itemActions.Count < items.Count) { itemActions.Add(null); }
        treeDirty = true;
    }

    public void AddSeparator() { this.AddItem(MenuItem.Separator()); }

    public void BuildTree() {
        this.RemoveAll();
        for (int i = 0; i < items.Count; i = i + 1) {
            MenuItem item = items[i];
            if (item.kind == 1) {
                Control separator = new Control("separator");
                separator.ClassName = "contextmenu-separator";
                separator.SetProp("style", "height:var(--gap-small);flex-shrink:0;border-bottom:1px solid var(--divider)");
                this.Add(separator);
            } else if (item.kind == 2) {
                Label header = new Label(item.label);
                header.ClassName = "contextmenu-header";
                this.Add(header);
            } else {
                Button button = new Button();
                button.ClassName = "contextmenu-item row align-center ghost small";
                button.Disabled = item.disabled || item.kind != 0;
                if (item.danger) { button.Danger(); }
                if (item.icon != null && item.icon != "") { button.Add(new IconView(item.icon)); }
                Label text = new Label(ContextMenu.ParseMainLabel(item.label));
                text.Grow();
                button.Add(text);
                string shortcut = item.shortcut;
                if (shortcut == null || shortcut == "") { shortcut = ContextMenu.ParseAccel(item.label); }
                if (shortcut != "") {
                    Label hint = new Label(shortcut);
                    hint.ClassName = "contextmenu-accel";
                    button.Add(hint);
                }
                this.Add(button);
            }
        }
        treeDirty = false;
        this.WireItems();
    }

    void WireItems() {
        for (int i = 0; i < children.Count; i = i + 1) {
            if (children[i] is Button) {
                Button button = (Button)children[i];
                button.Click.Clear();
                ContextMenuAction action = new ContextMenuAction();
                action.owner = this;
                action.generation = generation;
                action.index = i;
                button.Click.Add(action.Run);
            }
        }
    }

    public override void OnMeasure(App app) {
        if (treeDirty || children.Count != items.Count) { this.BuildTree(); }
        int width = app.Scale(140);
        int height = app.Scale(Space.XS * 2);
        for (int i = 0; i < children.Count; i = i + 1) {
            Control child = children[i];
            child.MeasureTree(app);
            if (child.prefW + app.Scale(Space.SM * 2) > width) { width = child.prefW + app.Scale(Space.SM * 2); }
            height = height + child.prefH;
        }
        prefW = width;
        prefH = height;
    }

    public void ShowAt(App app, int x, int y) {
        if (app == null || app.overlayHost == null) { return; }
        App old = popupApp;
        if (opened && old != null && old.overlayHost.ActiveRoot() == this) {
            int previous = generation;
            old.overlayHost.Hide(this);
            if (opened || generation != previous + 1) { return; }
        }
        generation = generation + 1;
        opened = true;
        popupApp = app;
        resultPending = false;
        selectedAction = -1;
        this.UseApp(app);
        this.MeasureTree(app);
        this.WireItems();
        int session = generation;
        app.overlayHost.ShowAt(app, this, x, y);
        if (generation == session && popupApp == app && app.overlayHost.ActiveRoot() != this) {
            this.OnPopupDismissed();
        }
    }

    public bool IsOpen() { return opened; }
    public int SelectedAction() { return selectedAction; }
    public int TakeAction() {
        if (!resultPending) { return -1; }
        resultPending = false;
        return selectedAction;
    }

    void SelectItem(int index, int session) {
        if (!opened || session != generation || index < 0 || index >= items.Count) { return; }
        MenuItem item = items[index];
        App host = popupApp;
        if (host == null || host.overlayHost.ActiveRoot() != this || item.kind != 0 || item.disabled) { return; }
        Action callback = index < itemActions.Count ? itemActions[index] : null;
        UiEvent notification = ActionSelected;
        int action = item.action;
        host.overlayHost.Hide(this);
        // Dismissal callbacks may have reopened this same instance.
        if (opened || generation != session + 1) { return; }
        selectedAction = action;
        resultPending = true;
        int closedGeneration = generation;
        if (callback != null) { callback(); }
        if (opened || generation != closedGeneration) { return; }
        if (notification != null) { notification.RaiseS(this); }
    }

    public override void OnPopupDismissed() {
        opened = false;
        popupApp = null;
        generation = generation + 1;
    }

    // Configured subscriptions survive closing and reopening, like other controls.
    // End their business lifetime explicitly when retaining the menu itself.
    public void ClearCallbacks() {
        for (int i = 0; i < itemActions.Count; i = i + 1) { itemActions[i] = null; }
        ActionSelected.Clear();
    }

    public override string Kind() { return "ContextMenu"; }

    public override List<PropSpec> Props() {
        List<PropSpec> properties = new List<PropSpec>();
        properties.Add(this.SizeProp());
        return properties;
    }

    public static bool IsSep(string s) {
        return s == "-" || s == "" || s == "---";
    }

    public static string ParseMainLabel(string raw) {
        if (raw == null) { return ""; }
        int tabIdx = raw.IndexOf("\t");
        if (tabIdx >= 0) { return raw.Substring(0, tabIdx); }
        int spIdx = raw.IndexOf("  ");
        if (spIdx >= 0) { return raw.Substring(0, spIdx); }
        return raw;
    }

    public static string ParseAccel(string raw) {
        if (raw == null) { return ""; }
        int tabIdx = raw.IndexOf("\t");
        if (tabIdx >= 0) { return raw.Substring(tabIdx + 1, raw.Length - (tabIdx + 1)).Trim(); }
        int spIdx = raw.IndexOf("  ");
        if (spIdx >= 0) { return raw.Substring(spIdx + 2, raw.Length - (spIdx + 2)).Trim(); }
        return "";
    }

    public static void PaintItem(App app, int x, int y, int w, int h,
                                 string label, string accel, bool hovered) {
        Canvas c = app.canvas;
        StyleBox s;
        int state = Style.SNormal();
        if (hovered) { state = Style.SHover(); }
        s = Style.Part(app, "contextmenu", "item", "", "", "", state);
        int fs = s.FontOr(Style.FontFallback(app, "small"));
        int ty = Canvas.CenterTextY(y, h, fs);
        if (hovered && s.bg != 0) {
            c.FillRoundRect(x + app.Scale(3), y, w - app.Scale(6), h, app.Scale(3), s.bg);
        }
        int textX = x + app.Scale(12);
        string drawLbl = label;
        if (drawLbl != null && drawLbl.StartsWith("✓ ")) {
            int gsz = app.Scale(12);
            int gy = y + (h - gsz) / 2;
            c.DrawGlyphIn("check", textX, gy, gsz, gsz, gsz, s.fg);
            textX = textX + gsz + app.Scale(6);
            drawLbl = drawLbl.Substring(2);
        } else if (drawLbl != null && drawLbl.StartsWith("   ")) {
            textX = textX + app.Scale(18);
            drawLbl = drawLbl.Substring(3);
        }
        c.DrawText(textX, ty, drawLbl, s.fg, fs);
        if (accel.Length > 0) {
            if (accel == "✓") {
                int gsz = app.Scale(12);
                int gy = y + (h - gsz) / 2;
                c.DrawGlyphIn("check", x + w - gsz - app.Scale(14), gy, gsz, gsz, gsz, s.fg);
            } else {
                StyleBox asx = Style.Part(app, "contextmenu", "accel", "", "",
                                          "", Style.SNormal());
                int afg = asx.fg != 0 ? asx.fg : Style.Fade(s.fg, 120);
                int aw = Canvas.MeasureText(accel, fs);
                c.DrawText(x + w - aw - app.Scale(14), ty, accel, afg, fs);
            }
        }
    }

    public static void PaintSeparator(App app, int x, int y, int w) {
        StyleBox s = Style.Part(app, "contextmenu", "separator", "", "", "",
                                Style.SNormal());
        int lineCol = s.bg != 0 ? s.bg : app.theme.borderSecondary;
        app.canvas.FillRect(x + app.Scale(8), y, w - app.Scale(16), 1, lineCol);
    }

    public static int Height(App app, List<string> labels) {
        StyleBox s = Style.Part(app, "contextmenu", "item", "", "", "",
                                Style.SNormal());
        int itemH = Canvas.FontHeight(
            s.FontOr(Style.FontFallback(app, "small"))) + app.Scale(8);
        if (itemH < app.Scale(26)) { itemH = app.Scale(26); }
        int sepH = app.Scale(7);
        int h = app.Scale(4) * 2;
        for (int i = 0; i < labels.Count; i = i + 1) {
            if (ContextMenu.IsSep(labels[i])) { h = h + sepH; } else { h = h + itemH; }
        }
        return h;
    }

    public static int Render(App app, int mx, int my, List<string> labels) {
        Canvas c = app.canvas;
        Theme t = app.theme;
        StyleBox itemStyle = Style.Part(app, "contextmenu", "item", "", "",
                                        "", Style.SNormal());
        int fontSize = itemStyle.FontOr(Style.FontFallback(app, "small"));
        int itemH = Canvas.FontHeight(fontSize) + app.Scale(8);
        if (itemH < app.Scale(26)) { itemH = app.Scale(26); }
        int sepH = app.Scale(7);
        int mW = app.Scale(140);
        for (int i = 0; i < labels.Count; i = i + 1) {
            string raw = labels[i];
            if (!ContextMenu.IsSep(raw)) {
                string ml = ContextMenu.ParseMainLabel(raw);
                string ac = ContextMenu.ParseAccel(raw);
                int lw = Canvas.MeasureText(ml, fontSize) + app.Scale(28);
                if (ac.Length > 0) {
                    lw = lw + Canvas.MeasureText(ac, fontSize) + app.Scale(24);
                }
                if (lw > mW) { mW = lw; }
            }
        }
        int mH = ContextMenu.Height(app, labels);

        int winW = c.Width();
        int winH = c.Height();
        if (mx + mW > winW) { mx = winW - mW - app.Scale(4); }
        if (my + mH > winH) { my = winH - mH - app.Scale(4); }
        if (mx < 0) { mx = 0; }
        if (my < app.titlebarH) { my = app.titlebarH; }

        app.BlockHitsMenu();

        int hovRow = 0 - 1;
        int hy = my + app.Scale(4);
        for (int hi = 0; hi < labels.Count; hi = hi + 1) {
            int rh = itemH;
            if (ContextMenu.IsSep(labels[hi])) { rh = sepH; }
            else if (app.mouseX >= mx && app.mouseX < mx + mW
                     && app.mouseY >= hy && app.mouseY < hy + rh) {
                hovRow = hi;
            }
            hy = hy + rh;
        }
        if (hovRow != app.menuHoverRow) {
            app.menuHoverRow = hovRow;
            app.RequestRedraw();
        }

        StyleBox s = Style.Of(app, "contextmenu", "", Style.SNormal());
        c.FillRoundRect(mx + s.shadowDx, my + s.shadowDy, mW, mH,
                        app.Scale(4), s.shadow);
        app.canvas.SurfaceRoundRect(mx, my, mW, mH,
            s.RadiusOr(app.theme.borderRadiusLarge), s.bg,
            s.borderColor, s.BorderWOr(1));
        app.BlockHitsRect(mx, my, mW, mH);

        int ry = my + app.Scale(4);
        for (int ri = 0; ri < labels.Count; ri = ri + 1) {
            string raw = labels[ri];
            if (ContextMenu.IsSep(raw)) {
                ContextMenu.PaintSeparator(app, mx, ry + sepH / 2, mW);
                ry = ry + sepH;
            } else {
                bool hov = app.mouseX >= mx && app.mouseX < mx + mW
                           && app.mouseY >= ry && app.mouseY < ry + itemH;
                string ml = ContextMenu.ParseMainLabel(raw);
                string ac = ContextMenu.ParseAccel(raw);
                ContextMenu.PaintItem(app, mx, ry, mW, itemH, ml, ac, hov);
                ry = ry + itemH;
            }
        }

        if (app.EventKind() == 2 && app.window.EventButton() == 1) {
            bool onMenu = app.mouseX >= mx && app.mouseX < mx + mW
                          && app.mouseY >= my && app.mouseY < my + mH;
            if (!onMenu) { return 0 - 2; }
        }

        if (app.ClickAvailable() && app.window.EventButton() == 0) {
            bool inside = app.mouseX >= mx && app.mouseX < mx + mW
                          && app.mouseY >= my && app.mouseY < my + mH;
            if (inside) {
                int cy = my + app.Scale(4);
                for (int ci = 0; ci < labels.Count; ci = ci + 1) {
                    int rh = itemH;
                    if (ContextMenu.IsSep(labels[ci])) { rh = sepH; }
                    else if (app.mouseY >= cy && app.mouseY < cy + rh) {
                        app.ClaimClick();
                        return ci;
                    }
                    cy = cy + rh;
                }
                app.ClaimClick();
                return 0 - 1;
            }
            app.ClaimClick();
            return 0 - 2;
        }
        return 0 - 1;
    }
}
