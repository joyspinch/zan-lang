using System;
using Gui;

namespace Gui.Widget;

// 数据录入表单的一行（FormCreate / 表单构建器风格）。
// // FormField 是可设计控件，描述收集“什么”，而非
// 如何绘制交互控件：字段类型（`ftype`）、旁边显示的标签、
// 模型键（`fname`）、占位符、必填标记，以及——选择型
// 字段的——选项列表。可视化设计器渲染该行预览，
// 并通过标准 Kind()/Props()/GetProp/SetProp 模型编辑，因此
// 整个表单可无特判地往返 Serialize。
// // 字段类型（ftype）：
// // 显示/布局组件（ftype >= 15）渲染静态内容而非
// 接收输入；占满整行宽度，不带标签列。
// 在设计器面板中按类别分组：
// 26 collapse   27 empty
// 32 spin       33 tooltip
// 38 menu       39 pageheader
public partial class FormField : Control {
    // 规范序列化组件类名（如 "Button"、"TextBox"、"Table" 等）。
    public string kind;
    public int ftype;
    // 字段旁显示的标签文字。
    public string label;
    // 模型键：运行时绑定与提交数据用的字段名。
    public string fname;
    // 占位文本（ftype 72 时为起始 URL）。
    public string placeholder;
    // 项目自定义组件类名，非空时直接序列化以供设计器代码生成。
    public string customKind;
    // 该字段是一个「已保存用户组件」的引用节点（而非项目源码
    // 类）：设计文档里写成 {"kind":名,"ref":名,...}，组件设计
    // 的每次进化自动跟随所有实例；挂载/画布预览都按 ref 展开
    // 组件文档，画布上按组件文档做真控件预览。
    public bool compRef;
    // 引用节点的画布真控件预览开关（false = 显示占位块，
    // 序列化为 "pvOff": true）。
    public bool pvPreview;
    // 是否必填（提交校验标记）。
    public bool required;
    // 禁用态与可见性（企业级组件基础行为属性）。
    public bool disabled;
    public bool visible;
    public string tooltipText;
    // switch 字段的默认开启状态（ftype 7）。
    public bool defOn;      // switch 字段的默认开启状态
    // 显示文本（ftype 15/16）的自动换行：渲染的 Label 换行适应
    // 字段宽度而非省略截断。序列化以便自由布局携带
    // 较长的提示段落。
    public bool wrap;
    // 24 分栏中的列跨度（24 = 整行，12 = 半行，……）。
    public int span;        // 24 分栏中的列跨度（24 = 整行，12 = 半行，……）
    // 自由画布布局（designer layoutMode == 1）：设计空间中的绝对
    // 位置和尺寸（窗口像素）。容器子元素的坐标
    // 相对于容器的内容框（对应运行时的 DockManual + Place
    // ）。流式模式下忽略，此时宽度由 span 决定。
    public int fx;
    public int fy;
    public int fw;
    public int fh;
    // 运行时布局计算结果矩形（停靠/流式布局解析更新）。
    public int layoutX;
    public int layoutY;
    public int layoutW;
    public int layoutH;
    public bool layoutReady;
    // 按设计尺寸存储的备用自由画布矩形（LVGL 风格断点
    // 布局）："WxH:x,y,w,h;WxH:x,y,w,h"。fx/fy/fw/fh 始终保存
    // 当前设计尺寸的矩形；设计器中切换尺寸时把
    // 旧矩形存到这里，存在新矩形时再加载。
    public string altRects;
    // 设计器锁定：锁住的组件仍可选中和改属性，
    // 但画布上拖不动、拉不大（和场景设计器的 Locked() 一致）。
    public bool locked;
    // 停靠边（Dock.Manual/Top/Bottom/Left/Right/Fill 的数字）。
    // 自由画布默认 0（给定的 fx/fy/fw/fh 绝对定位）；在
    // Dock Panel 里改成某一边，就能做出“上工具条 + 左侧栏 +
    // 下状态栏 + 中间填充”这种应用外壳，且能随窗口缩放。
    public int dockSide;
    // 统一排版定位模式：0 = flow (Flex弹性流式排列), 1 = float (自由绝对/浮动定位脱离文档流)。
    public int position;
    // 浮动定位锚点：0=None, 1=TopLeft, 2=TopCenter, 3=TopRight, 4=CenterLeft, 5=Center, 6=CenterRight, 7=BottomLeft, 8=BottomCenter, 9=BottomRight, 10=Stretch。
    public int anchor;
    // 弹性主轴权重（flex: grow），0 = 固定/自适应，>0 伸展。
    public int flexGrow;
    // 盒模型快捷属性（单位：像素）：外边距、内边距、容器子项间距。
    // 在设计器中作为一等公民可视设置，并同步反映至 CSS/运行时排版。
    public int margin;
    public int padding;
    public int gap;
    // 容器 Flex 弹性排版属性（针对 Panel/GroupBox/Card 等容器）：
    // flexDir: 0 = Column (纵向排列，默认), 1 = Row (横向排列)
    // justify: 0 = Start, 1 = Center, 2 = End, 3 = SpaceBetween
    // alignItems: 0 = Start, 1 = Center, 2 = End, 3 = Stretch
    // flexWrap: false = NoWrap, true = Wrap
    public int flexDir;
    public int justify;
    public int alignItems;
    public bool flexWrap;
    // 选项列表：选择型字段的候选项，也复用作表格列、标签页
    // 标题、步骤/菜单/树条目等（见 UsesOptionsOf）。
    public List<string> options;

    // 容器支持。容器（Card / Tabs）在 `kids` 中持有嵌套
    // 子组件；每个子元素在 `childTab` 中记录所属标签页
    // （如 Card 这类单内容体容器恒为 0）。`uiState`
    // 是组合控件绑定的响应式索引——Tabs 的当前标签页、
    // Steps 的当前步骤、Collapse 的展开面板、
    // Pagination 的页码、Menu / Tree 的选中项——让预览实时生效。
    public List<FormField> kids;
    public int childTab;
    public SignalInt uiState;
    // Tabs 容器的标签条方向（0 = 顶部横向，1 = 左侧纵向，
    // 对应运行时 Tabs 的 orient 属性）。序列化为
    // "orient": "horizontal"/"vertical"，纵向时画布与生成
    // 代码都让子级让出左侧轨道。
    public int tabOrient;

    // 字段内联 CSS 声明文本（与元素 style 属性同一语义与优先级：
    // "color:#c00; padding:8px"）。设计文档存 "style" 键（.html
    // 设计稿里就是元素的 style 属性），画布预览与生成代码经
    // SetProp("style") 走 StyleSheet.ApplyInline 通道落地。
    // 名字不叫 Style：与 Gui.Style 类名撞，方法体里裸写 Style.Part
    // 会被这个字段抢走解析。
    public string styleText;

    // 设计器未建模的字段键原样保留(DataGrid 的 "of"/"columns"、
    // 控件的 "props" 直通表等):加载时收集,保存时原样写回,
    // 手写设计稿经设计器往返不丢声明。为 null 表示没有。
    public JsonValue extra;
    // 字段从文档解析出的原始设计源对象引用，供高保真往返与重映射使用。
    public JsonValue designSource;

    // 公共初始化：按字段类型填默认标签 / 占位 / 选项与 24 栅格跨度。
    public void InitField(int ft) {
        this.InitControl("field", 0);
        ftype = ft;
        kind = FormField.KindForType(ft);
        label = FormField.DefaultLabel(ft);
        fname = "field";
        placeholder = FormField.DefaultPlaceholder(ft);
        required = false;
        disabled = false;
        visible = true;
        tooltipText = "";
        defOn = false;
        wrap = false;
        span = 24;
        fx = 0;
        fy = 0;
        fw = 200;
        // 字段高度：内容型控件取类型标准行高（多行文本 62 / 附件 78 /
        // 表格 104），文档会带上它，运行时按声明排；皮肤定高的类型
        // （输入框/下拉/开关…）归尺寸档、容器归内容自适应，文档都不写
        // 高度，这里先给类型标准行高作为设计器里的显示值。
        fh = FormField.DefaultHFor(ft);
        layoutX = 0;
        layoutY = 0;
        layoutW = 0;
        layoutH = 0;
        layoutReady = false;
        altRects = "";
        locked = false;
        dockSide = 0;
        margin = 0;
        padding = 0;
        gap = 0;
        flexDir = 0;
        justify = 0;
        alignItems = 0;
        flexWrap = false;
        styleText = "";
        customKind = "";
        compRef = false;
        pvPreview = true;
        options = new List<string>();
        kids = new List<FormField>();
        childTab = 0;
        tabOrient = 0;
        uiState = new SignalInt(0);
        extra = null;
        SeedOptions(ft);
    }

    // 容器类型拥有嵌套子组件：Card (18) 有单一
    // 内容体；Panel (45) 是独立的容器面板；Tabs (36) 把子元素
    // 分配到各个标签页；Split (60) 分成两个窗格（childTab 0/1
    // 即窗格序号）；Dock Panel (61) 按各子元素自己的 `dock` 边停靠。
    public static bool IsContainerOf(int ft) {
        return ft == 18 || ft == 36 || ft == 45 || ft == 60 || ft == 61;
    }

    // 外壳条通常占哪一边：工具条贴顶、状态栏贴底、停靠面板
    // 吃掉剩下的空间。只是给「停靠」属性的建议值，组件建出来
    // 一律是自由定位（0），不会自己跑去贴边。
    public static int SuggestDockOf(int ft) {
        if (ft == 58) { return 1; }
        if (ft == 59) { return 2; }
        if (ft == 61) { return 5; }
        return 0;
    }

    // 应用外壳类容器 / 条（工具条、状态栏、分栏、停靠面板）。
    // 它们自带表面并在窗口边缘成条，因此设计器不给它们
    // 加标签列。
    public static bool IsShellOf(int ft) {
        return ft == 58 || ft == 59 || ft == 60 || ft == 61;
    }

    // 通栏横幅型控件：工具条、状态栏、菜单栏、分割线等。
    // 在容器或窗口中横跨 100% 全宽呈现，不可随意改变宽度。
    public static bool IsFullWidthBannerOf(int ft) {
        return ft == 58 || ft == 59 || ft == 38 || ft == 17 || ft == 53;
    }

    // 本字段是否为通栏横幅控件（宽度自动充满父容器，锁定横向手柄）。
    public bool IsFullWidthBanner() {
        return FormField.IsFullWidthBannerOf(ftype);
    }

    // 固定单行高度型控件：输入框、单选/多选、开关、下拉框、滑块、分页等。
    // 高度由尺寸档位与标准行高严格决定，禁止垂直随意拖拉变形。
    public static bool IsFixedHeightOf(int ft) {
        return ft == 0 || ft == 2 || ft == 3 || ft == 4 || ft == 5 || ft == 6
            || ft == 7 || ft == 8 || ft == 9 || ft == 10 || ft == 11 || ft == 13
            || ft == 15 || ft == 16 || ft == 17 || ft == 19 || ft == 20
            || ft == 35 || ft == 37 || ft == 48 || ft == 58 || ft == 59
            || ft == 62 || ft == 67 || ft == 77 || ft == 80 || ft == 81;
    }

    // 本字段是否为固定高度控件（锁定垂直手柄）。
    public bool IsFixedHeight() {
        return FormField.IsFixedHeightOf(ftype);
    }

    // 固定宽度/固定正方形型控件（开关、头像、单图标）。
    public static bool IsFixedWidthOf(int ft) {
        return ft == 7 || ft == 21 || ft == 54;
    }

    // 本字段是否为固定宽度控件。
    public bool IsFixedWidth() {
        return FormField.IsFixedWidthOf(ftype);
    }

    // 组件最小安全宽度（设计器自由调整大小时防塌陷阈值）。
    public static int MinSafeWOf(int ft) {
        if (FormField.IsFullWidthBannerOf(ft)) { return 100; }
        if (ft == 7) { return 44; }
        if (ft == 21 || ft == 54) { return 24; }
        if (ft == 23 || ft == 41 || ft == 25) { return 120; }
        if (ft == 1 || ft == 18 || ft == 36 || ft == 43 || ft == 45) { return 80; }
        return 40;
    }

    // 组件最小安全高度。
    public static int MinSafeHOf(int ft) {
        if (FormField.IsFixedHeightOf(ft)) {
            return FormField.DefaultHFor(ft);
        }
        if (ft == 23 || ft == 41 || ft == 25) { return 80; }
        if (ft == 1 || ft == 18 || ft == 36 || ft == 43 || ft == 45) { return 50; }
        return 24;
    }

    // 本字段是否为容器类型（拥有嵌套子组件）。
    public bool IsContainer() {
        return FormField.IsContainerOf(ftype);
    }

    // 嵌套子组件数 / 第 i 个子组件。
    public int KidCount() { return kids.Count; }
    // 返回第 i 个子组件。
    public FormField KidAt(int i) { return kids[i]; }

    // ---- 自由画布定位（designer layoutMode == 1）----

    // 设置设计空间中的绝对位置（容器子元素相对于父内容
    // 框）。
    public FormField PlaceAt(int x, int y) { fx = x; fy = y; return this; }
    // 设置设计空间中的尺寸（自由画布）。
    public FormField FreeSize(int w, int h) { fw = w; fh = h; return this; }
    // 设计空间绝对坐标 / 尺寸（自由画布；未放置时为默认值）。
    public int FreeX() { return fx; }
    // 设计空间 Y 坐标。
    public int FreeY() { return fy; }
    // 设计空间宽度。
    public int FreeW() { return fw; }
    // 设计空间高度。
    public int FreeH() { return fh; }

    // 设计器画布使用的运行时矩形，与文档定义矩形解耦。
    public void SetLayoutRect(int x, int y, int w, int h) {
        layoutX = x;
        layoutY = y;
        layoutW = w;
        layoutH = h;
        layoutReady = true;
    }
    // 清除运行时布局结果（含全部子组件），取值回退到设计矩形。
    public void ResetLayout() {
        layoutReady = false;
        for (int i = 0; i < kids.Count; i = i + 1) {
            kids[i].ResetLayout();
        }
    }
    // 运行时布局矩形（未结算 layoutReady=false 时回退设计矩形）。
    public int LayoutX() { return layoutReady ? layoutX : fx; }
    // 运行时布局 Y（未结算时回退设计 fy）。
    public int LayoutY() { return layoutReady ? layoutY : fy; }
    // 运行时布局宽（未结算时回退设计 fw）。
    public int LayoutW() { return layoutReady ? layoutW : fw; }
    // 运行时布局高（未结算时回退设计 fh）。
    public int LayoutH() { return layoutReady ? layoutH : fh; }

    // 把当前 fx/fy/fw/fh 写入备用矩形表，键为
    // "WxH"（覆盖该尺寸之前的条目）。
    public void StashRect(string key) {
        string entry = key + ":" + Convert.ToString(fx) + "," + Convert.ToString(fy)
            + "," + Convert.ToString(fw) + "," + Convert.ToString(fh);
        string outp = "";
        List<string> parts = altRects.Split(";");
        for (int i = 0; i < parts.Count; i = i + 1) {
            string pt = parts[i];
            if (pt.Length > 0 && !FormField.AltKeyIs(pt, key)) {
                if (outp != "") { outp = outp + ";"; }
                outp = outp + pt;
            }
        }
        if (outp != "") { outp = outp + ";"; }
        altRects = outp + entry;
    }

    // 把 "WxH" 键下保存的备用矩形加载到 fx/fy/fw/fh。
    // 该尺寸无条目时返回 false（矩形保持不变）。
    public bool LoadRect(string key) {
        List<string> parts = altRects.Split(";");
        for (int i = 0; i < parts.Count; i = i + 1) {
            string pt = parts[i];
            if (pt.Length > 0 && FormField.AltKeyIs(pt, key)) {
                List<string> kv = pt.Split(":");
                if (kv.Count == 2) {
                    List<string> nums = kv[1].Split(",");
                    if (nums.Count == 4) {
                        fx = Convert.ToInt32(nums[0]);
                        fy = Convert.ToInt32(nums[1]);
                        fw = Convert.ToInt32(nums[2]);
                        fh = Convert.ToInt32(nums[3]);
                        return true;
                    }
                }
            }
        }
        return false;
    }

    // 备用矩形条目是否为给定 "WxH" 键。
    public static bool AltKeyIs(string entry, string key) {
        return entry.Length > key.Length + 1
            && entry.Substring(0, key.Length + 1) == key + ":";
    }

    // 为组件填充默认选项列表——选项值、表格列、
    // 标签页标题、步骤/菜单/树条目等——使新添加的组件
    // 在预览中不至于空白。
    public void SeedOptions(int ft) {
        // 种子列只给标题、不带 ":字段"：带字段的选项是声明式列，
        // 挂载校验会据此要求 "of"（行实体类型）——新拖出的表格
        // 必须能不配置直接发布。要类型化列时在列编辑器里配 字段+of。
        if (ft == 23) { options.Add("Name"); options.Add("Email"); options.Add("Status"); return; }
        if (ft == 24) { options.Add("Created"); options.Add("Approved"); options.Add("Shipped"); return; }
        if (ft == 25) { options.Add("Root"); options.Add("Child A"); options.Add("Child B"); return; }
        if (ft == 26) { options.Add("Section 1"); options.Add("Section 2"); return; }
        if (ft == 34) { options.Add("Step 1"); options.Add("Step 2"); options.Add("Step 3"); return; }
        if (ft == 35) { options.Add("Home"); options.Add("Library"); options.Add("Data"); return; }
        if (ft == 36) { options.Add("Tab 1"); options.Add("Tab 2"); options.Add("Tab 3"); return; }
        if (ft == 38) { options.Add("Dashboard"); options.Add("Settings"); options.Add("Profile"); return; }
        if (ft == 40) { options.Add("List item one"); options.Add("List item two"); options.Add("List item three"); return; }
        if (ft == 41) { options.Add("Name"); options.Add("Email"); options.Add("Status"); return; }
        if (ft == 42) { options.Add("Slide 1"); options.Add("Slide 2"); options.Add("Slide 3"); return; }
        // 功能区命令 "图标|标题"（生成代码与画布预览同一解析）。
        if (ft == 53) { options.Add("save:保存"); options.Add("copy:复制"); options.Add("folder:打开"); return; }
        if (ft == 58) { options.Add("New:plus"); options.Add("Open:folder"); options.Add("Save:save"); options.Add("-"); options.Add(">Help:info"); return; }
        if (ft == 59) { options.Add("Ready"); options.Add(">UTF-8"); options.Add(">Ln 1, Col 1"); return; }
        // 分栏容器把方向和第一个窗格的尺寸存在通用选项表里，
        // 无需为它单独加设计文档键：options[0]=方向，options[1]=尺寸。
        if (ft == 60) { options.Add("vertical"); options.Add("240"); return; }
        if (FormField.UsesOptionsOf(ft)) {
            options.Add("Option 1");
            options.Add("Option 2");
            options.Add("Option 3");
        }
    }

    // 构造指定类型的字段（默认标签 / 占位 / 选项已种子化）。
    public FormField(int ft) {
        InitField(ft);
    }

    // 构建 `ftype` 字段并生成唯一的默认模型键。
    public static FormField New(int ft, int seq) {
        FormField f = new FormField(ft);
        f.kind = FormField.KindForType(ft);
        f.fname = FormField.TypeKey(ft) + Convert.ToString(seq);
        f.name = f.fname;
        return f;
    }

    // 深拷贝（子元素一并复制）：设计器的「复制」用它，
    // 副本除了模型名之外和原件完全一致。
    public FormField Clone() {
        FormField f = new FormField(ftype);
        f.kind = kind;
        f.label = label;
        f.fname = fname;
        f.name = fname;
        f.placeholder = placeholder;
        f.customKind = customKind;
        f.compRef = compRef;
        f.pvPreview = pvPreview;
        f.required = required;
        f.defOn = defOn;
        f.wrap = wrap;
        f.span = span;
        f.fx = fx;
        f.fy = fy;
        f.fw = fw;
        f.fh = fh;
        f.altRects = altRects;
        f.locked = locked;
        f.dockSide = dockSide;
        f.childTab = childTab;
        f.tabOrient = tabOrient;
        f.options = new List<string>();
        for (int i = 0; i < options.Count; i = i + 1) { f.options.Add(options[i]); }
        f.kids = new List<FormField>();
        for (int k = 0; k < kids.Count; k = k + 1) { f.kids.Add(kids[k].Clone()); }
        return f;
    }

    public static int Custom() { return 100; }

    // 是否为自定义组件字段（customKind 非空）。
    public bool IsCustom() { return customKind != ""; }

    // 构建携带发现的 `kind` 标签的自定义组件字段。
    public static FormField NewCustom(string kind, int seq) {
        FormField f = new FormField(100);
        f.kind = kind;
        f.customKind = kind;
        f.label = kind;
        f.fname = kind + Convert.ToString(seq);
        f.name = f.fname;
        return f;
    }

}
