using System;
using Gui;
namespace Gui.Widget;
public class SafeAreaView : Panel {
    // 按父类种类上报：序列化与自动化以 "Panel" 识别本控件。
    public override string Kind() { return "Panel"; }
    public bool avoidTop;
    public bool avoidBottom;
    public bool avoidLeft;
    public bool avoidRight;
    public SafeAreaView() : base() {
        avoidTop = true;
        avoidBottom = true;
        avoidLeft = true;
        avoidRight = true;
    }
    public SafeAreaView(string name) : base(name) {
        avoidTop = true;
        avoidBottom = true;
        avoidLeft = true;
        avoidRight = true;
    }
    public bool AvoidTop {
        get { return this.avoidTop; }
        set { this.avoidTop = value; this.SyncSafeArea(); this.Invalidate(); }
    }
    public bool AvoidBottom {
        get { return this.avoidBottom; }
        set { this.avoidBottom = value; this.SyncSafeArea(); this.Invalidate(); }
    }
    public bool AvoidLeft {
        get { return this.avoidLeft; }
        set { this.avoidLeft = value; this.SyncSafeArea(); this.Invalidate(); }
    }
    public bool AvoidRight {
        get { return this.avoidRight; }
        set { this.avoidRight = value; this.SyncSafeArea(); this.Invalidate(); }
    }
    public void OnlyTop() {
        avoidTop = true;
        avoidBottom = false;
        avoidLeft = false;
        avoidRight = false;
        this.SyncSafeArea();
        this.Invalidate();
    }
    public void OnlyBottom() {
        avoidTop = false;
        avoidBottom = true;
        avoidLeft = false;
        avoidRight = false;
        this.SyncSafeArea();
        this.Invalidate();
    }
    public void TopAndBottom() {
        avoidTop = true;
        avoidBottom = true;
        avoidLeft = false;
        avoidRight = false;
        this.SyncSafeArea();
        this.Invalidate();
    }
    public override void SyncBinding() {
        base.SyncBinding();
        this.SyncSafeArea(this.FindApp());
    }
    protected override void OnPropertyChanged(PropSpec spec) {
        this.SyncSafeArea(this.FindApp());
        this.Invalidate();
    }
    protected override List<PropSpec> DefineProps() {
        List<PropSpec> ps = base.DefineProps();
        ps.Add(PropSpec.Bool("avoidTop", "Avoid Top").Field("avoidTop"));
        ps.Add(PropSpec.Bool("avoidBottom", "Avoid Bottom").Field("avoidBottom"));
        ps.Add(PropSpec.Bool("avoidLeft", "Avoid Left").Field("avoidLeft"));
        ps.Add(PropSpec.Bool("avoidRight", "Avoid Right").Field("avoidRight"));
        return ps;
    }
    public void SyncSafeArea() { this.SyncSafeArea(this.FindApp()); }
    public void SyncSafeArea(App app) {
        app = this.ResolveApp(app);
        if (app == null) { return; }
        int t = avoidTop ? app.SafeAreaTop() : 0;
        int b = avoidBottom ? app.SafeAreaBottom() : 0;
        int l = avoidLeft ? app.SafeAreaLeft() : 0;
        int r = avoidRight ? app.SafeAreaRight() : 0;
        this.Padding(t, r, b, l);
    }
}
