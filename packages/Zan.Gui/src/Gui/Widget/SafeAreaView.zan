using System;
using Gui;

namespace Gui.Widget;

// 安全区自适应容器：自动根据宿主 App 或设备的实际避让边距
// （刘海、药丸屏、底部手势条、侧边打孔）调整内边距，确保子控件不被物理异形遮挡。
public class SafeAreaView : Panel {
    public bool avoidTop;
    public bool avoidBottom;
    public bool avoidLeft;
    public bool avoidRight;

    public SafeAreaView() : base() {
        avoidTop = true;
        avoidBottom = true;
        avoidLeft = true;
        avoidRight = true;
    }

    public SafeAreaView(string name) : base(name) {
        avoidTop = true;
        avoidBottom = true;
        avoidLeft = true;
        avoidRight = true;
    }

    public SafeAreaView OnlyTop() {
        avoidTop = true;
        avoidBottom = false;
        avoidLeft = false;
        avoidRight = false;
        return this;
    }

    public SafeAreaView OnlyBottom() {
        avoidTop = false;
        avoidBottom = true;
        avoidLeft = false;
        avoidRight = false;
        return this;
    }

    public SafeAreaView TopAndBottom() {
        avoidTop = true;
        avoidBottom = true;
        avoidLeft = false;
        avoidRight = false;
        return this;
    }

    // 动态同步安全区边距至控件内边距
    public void SyncSafeArea() { this.SyncSafeArea(this.App); }
    public void SyncSafeArea(App app) {
        app = this.ResolveApp(app);
        if (app == null) { return; }
        int t = avoidTop ? app.SafeAreaTop() : 0;
        int b = avoidBottom ? app.SafeAreaBottom() : 0;
        int l = avoidLeft ? app.SafeAreaLeft() : 0;
        int r = avoidRight ? app.SafeAreaRight() : 0;
        this.Padding(t, r, b, l);
    }
}
