using System;
using Gui;

namespace Gui.Widget;

// 富文本链接点击回调：action 为 #@标记@…@ 里竖线前的动作原文。
public delegate void RichTextLinkActivated(string action);

// 富文本控件：标记文本进、按真实字体度量换行、逐段绘制。
// 标记语法与 Game.Arpg 同一种（#c/#bg/#f 颜色字体、#W #R #Y #B #G
// #H #L 快捷色、#md/#rt 对齐、#br 变宽、#p/#a/#item/#z 资源段、
// #@动作@内容@ 链接、## 转义 #），解析产物颜色为 0xAARRGGBB。
// 滚动模型仿 StyledText：bottomAnchor=true（默认，聊天用）时
// scroll 是「距底端的行数」，0 = 贴住最新一行；false（文档用）时
// scroll 是「距顶端的行数」。绘制后写出 maxScroll 供调用方回读；
// scrollBar 保留旧的滚动条宽度开关；交互由共享像素滚动处理。滚轮
// 内置。资源段（#p/#a/#item）当前只占位推进排版，不绘制内容。
public class RichText : Control {
    // 标记文本；每帧赋同一串不会重复解析（字符串相等即跳过）。
    public string markup;
    // 解析缓存（markup 变化时重建）。
    private RichTextDocument doc;
    // 排版缓存：行列表与布局键（markup/宽度/字号任一变化才重排）。
    private List<RichTextLine> lines;
    private string laidMarkup;
    private int laidW;
    private int laidFont;
    // 滚动偏移（行数；方向见 bottomAnchor），调用方持有。
    public int scroll;
    // 绘制后写出：本帧的最大滚动偏移（行数）。
    public int maxScroll;
    // true = 底端锚定（聊天），false = 顶端锚定（文档）。
    public bool bottomAnchor;
    // 调用方的滚动条信号；非 null 且有得滚时画纵向滚动条。
    public SignalInt scrollBar;
    // 字号覆盖（像素）；0 = 按 label small 样式解析。
    public int fontPxOverride;
    // 解析初始前景色（0xAARRGGBB）；0 = 取样式表 richtext 前景，
    // 再退白。快捷色/显式颜色标签始终覆盖它。
    public int defaultColor;
    // 行高（排版时算出，绘制与滚动共用）。
    public int rowH;
    // 滚动条要的「像素、从顶算」转换信号（构造时建一次）。
    // 链接点击处理列表（#@动作@…@ 被点下并抬起时逐个调用）。
    private List<RichTextLinkActivated> linkHandlers;
    // 按下时命中的链接动作（抬起时还在同一链接上才算点击）。
    private string pressedAction;
    private RichTextLink hoveredLink;
    private List<int> lineTops;
    private int contentHeight;
    private int projectedScroll;
    private bool projectedBottom;
    private bool scrollReady;
    private int maximumPixel;
    private int maximumLine;


    // 空控件；Markup 赋值后自会解析排版。
    public RichText() {
        this.InitControl("richtext", 1);
        // OnPaint 自行绘制文本与背景，不让框架再铺一层 CSS 表面。
        styleSurfaceOwned = true;
        markup = "";
        doc = null;
        lines = null;
        laidMarkup = null;
        laidW = 0 - 1;
        laidFont = 0 - 1;
        scroll = 0;
        maxScroll = 0;
        bottomAnchor = true;
        scrollBar = null;
        fontPxOverride = 0;
        defaultColor = 0;
        rowH = 0;
        linkHandlers = new List<RichTextLinkActivated>();
        pressedAction = null;
    }

    public RichText(string initialMarkup) {
        this.InitControl("richtext", 1);
        styleSurfaceOwned = true;
        markup = initialMarkup != null ? initialMarkup : "";
        doc = null;
        lines = null;
        laidMarkup = null;
        laidW = 0 - 1;
        laidFont = 0 - 1;
        scroll = 0;
        maxScroll = 0;
        bottomAnchor = true;
        scrollBar = null;
        fontPxOverride = 0;
        defaultColor = 0;
        rowH = 0;
        linkHandlers = new List<RichTextLinkActivated>();
        pressedAction = null;
    }

    // 设置标记文本（每帧赋同一串是廉价的：相等即跳过）。
    public void SetMarkup(string newValue) { this.markup = newValue; }
    // 当前标记文本。
    public string Markup() { return this.markup; }
    // 滚动方向：true 底端锚定（默认），false 顶端锚定。
    public void SetBottomAnchor(bool newValue) { this.bottomAnchor = newValue; }
    // 字号覆盖（像素）；0 = 跟随 label small 样式。
    public void SetFontPx(int newValue) { this.fontPxOverride = newValue; }
    // 解析初始前景色（0xAARRGGBB）；0 = 取样式表，再退白。
    public void SetDefaultColor(int newValue) { this.defaultColor = newValue; }
    // 注册链接点击处理（可多个，按注册顺序调用）。
    public void OnLinkActivated(RichTextLinkActivated handler) {
        this.linkHandlers.Add(handler);
    }

    // 控件类型标识（序列化/设计器用）。
    public override string Kind() { return "RichText"; }

    public override List<PropSpec> Props() {
        List<PropSpec> ps = new List<PropSpec>();
        PropSpec m = PropSpec.Text("markup", "Markup");
        m.str = markup;
        m.Also("text");
        m.Also("value");
        m.Also("data");
        ps.Add(m);
        ps.Add(this.SizeProp());
        return ps;
    }

    public override string GetProp(string key) {
        if (key == "markup" || key == "text" || key == "value" || key == "data") {
            return markup;
        }
        return base.GetProp(key);
    }

    public override void SetProp(string key, string val) {
        if (key == "markup" || key == "text" || key == "value" || key == "data") {
            markup = val;
            this.doc = null;
            return;
        }
        base.SetProp(key, val);
    }

    // A detached diagnostic snapshot; callers cannot mutate the layout cache.
    public RichTextLine LineAt(int index) {
        if (lines == null || index < 0 || index >= lines.Count) { return null; }
        RichTextLine source = lines[index];
        RichTextLine result = new RichTextLine(source.alignment);
        result.width = source.width;
        result.height = source.height;
        for (int i = 0; i < source.segments.Count; i = i + 1) {
            RichTextSegment segment = source.segments[i];
            RichTextLink link = null;
            if (segment.link != null) {
                link = new RichTextLink(segment.link.Raw());
                link.style = segment.link.Style();
                link.normalColor = segment.link.NormalColor();
                link.hoverColor = segment.link.HoverColor();
                link.pressedColor = segment.link.PressedColor();
            }
            RichTextSegment copy = new RichTextSegment(segment.text, segment.color, segment.background, link);
            copy.x = segment.x;
            copy.width = segment.width;
            result.segments.Add(copy);
        }
        return result;
    }

    // 当前排版行数（未排版为 -1）。诊断与测试用。
    public int LineCount() {
        if (this.lines == null) { return 0 - 1; }
        return this.lines.Count;
    }

    // 解析出的实际字号。
    public int ResolveFontPx() { return this.ResolveFontPx(this.App); }
    public int ResolveFontPx(App app) {
        if (this.fontPxOverride > 0) { return this.fontPxOverride; }
        app = this.ResolveApp(app);
        if (app == null) { return 14; }
        return this.ResolvePartAs(app, "label", "", "", "small", Style.SNormal())
            .FontOr(Style.FontFallback(app, "small"));
    }

    // 解析初始前景色：显式 defaultColor 优先，其次样式表 richtext
    // 前景，最后白色。
    public int ResolveDefaultColor() { return this.ResolveDefaultColor(this.App); }
    public int ResolveDefaultColor(App app) {
        if (this.defaultColor != 0) { return this.defaultColor; }
        app = this.ResolveApp(app);
        if (app == null) { return (int)0xFFFFFFFF; }
        StyleBox sb = Style.Part(app, "richtext", "", "", "", "",
            Style.SNormal());
        return sb.FgOr((int)0xFFFFFFFF);
    }

    // 覆写：纯铺满槽位的画布，偏好尺寸取当前边界。
    public override void OnMeasure(App app) {
        prefW = bw;
        prefH = bh;
    }

    // 新建一个空行。
    private RichTextLine NewLine(int alignment) {
        return new RichTextLine(alignment);
    }

    // 行高访问器（面向对象封装）
    public int RowHeight() { return this.rowH; }

    // 排版：把解析产物按真实度量折成行。逐字累加宽度（CJK 无
    // 字距问题；拉丁允许极小偏差），超宽即折行，颜色/背景/链接
    // 随段延续——这正是多色聊天段跨行不断色的关键。
    public void RebuildLayout(int availW, int fp) {
        this.RebuildLayout(this.App, availW, fp);
    }
    public void RebuildLayout(App app, int availW, int fp) {
        app = this.ResolveApp(app);
        int sc3 = app != null ? app.Scale(3) : 3;
        this.lines = new List<RichTextLine>();
        this.rowH = Canvas.FontHeight(fp) + sc3;
        int baseH = this.rowH;
        RichTextLine line = new RichTextLine(0);
        int lineW = 0;
        int lineHeight = baseH;
        // 当前在拼的段：连续同样式字符合并进同一段。
        RichTextSegment seg = null;
        int segStartLineW = 0;
        if (this.doc == null) {
            this.doc = RichTextParser.ParseText(this.markup,
                this.ResolveDefaultColor(app));
        }
        int align = 0;
        for (int i = 0; i < this.doc.RunCount(); i = i + 1) {
            RichTextRun run = this.doc.RunAt(i);
            if (run.Kind() == RichTextRunKind.LineBreak()) {
                if (seg != null) { seg.width = lineW - segStartLineW; }
                this.lines.Add(line);
                line = new RichTextLine(0);
                lineW = 0;
                segStartLineW = 0;
                seg = null;
                lineHeight = baseH;
                continue;
            }
            if (run.Kind() == RichTextRunKind.WrapWidth()) {
                // 语义照 Arpg TextLayout：只改后续换行宽度，不强行断行。
                if (run.Width() > 0) { availW = run.Width(); }
                continue;
            }
            int color = run.Style().Color();
            int background = run.Style().Background();
            RichTextLink link = run.Link();
            if (run.Kind() == RichTextRunKind.Text()) {
                align = run.Style().Alignment();
                string text = run.Text();
                if (text == null || text.Length == 0) { continue; }

                // 整段行内容纳快速通道：若整段文本能够直接排入当前行剩余空间，一次性度量入段，彻底规避逐字符测量与串接开销
                int fullW = Canvas.MeasureText(text, fp);
                if (lineW + fullW <= availW) {
                    if (line.segments.Count == 0) {
                        line.alignment = align;
                    }
                    if (seg == null || seg.color != color
                        || seg.background != background
                        || seg.link != link) {
                        seg = new RichTextSegment(text, color, background, link);
                        seg.x = lineW;
                        segStartLineW = lineW;
                        line.segments.Add(seg);
                    } else {
                        seg.text = seg.text + text;
                    }
                    lineW = lineW + fullW;
                    continue;
                }

                int index = 0;
                int tlen = text.Length;
                while (index < tlen) {
                    int b = text[index] & 255;
                    int next;
                    int gw;
                    string glyph;
                    if (b >= 32 && b <= 126) {
                        next = index + 1;
                        gw = Canvas.MeasureChar(b, fp);
                        glyph = Text.CharStr(b);
                    } else {
                        next = Text.NextCharEnd(text, index);
                        glyph = text.Substring(index, next - index);
                        gw = Canvas.MeasureText(glyph, fp);
                    }

                    if (lineW + gw > availW && lineW > 0) {
                        // 折行：当前段收口，另起一行，字符留在新行。
                        if (seg != null) {
                            seg.width = lineW - segStartLineW;
                        }
                        this.lines.Add(line);
                        line = new RichTextLine(0);
                        lineW = 0;
                        segStartLineW = 0;
                        seg = null;
                    }
                    if (line.segments.Count == 0) {
                        // 行对齐取该行第一个文本段的样式快照。
                        line.alignment = align;
                    }
                    if (seg == null || seg.color != color
                        || seg.background != background
                        || seg.link != link) {
                        seg = new RichTextSegment(glyph, color, background,
                            link);
                        seg.x = lineW;
                        segStartLineW = lineW;
                        line.segments.Add(seg);
                    } else {
                        seg.text = seg.text + glyph;
                    }
                    lineW = lineW + gw;
                    index = next;
                }
            } else {
                if (seg != null) { seg.width = lineW - segStartLineW; }
                // 资源/占位段：当前只推进排版（宽兜底字号），不绘制。
                int w = run.Width();
                int h = run.Height();
                if (w <= 0) { w = fp; }
                if (h <= 0) { h = fp; }
                if (lineW + w > availW && lineW > 0) {
                    this.lines.Add(line);
                    line = new RichTextLine(align);
                    lineW = 0;
                    seg = null;
                    segStartLineW = 0;
                }
                if (h > lineHeight) { lineHeight = h; }
                lineW = lineW + w;
                seg = null;
            }
            if (lineHeight > line.height) { line.height = lineHeight; }
            if (lineW > line.width) { line.width = lineW; }
        }
        if (seg != null) { seg.width = lineW - segStartLineW; }
        this.lines.Add(line);
        for (int k = 0; k < this.lines.Count; k = k + 1) {
            RichTextLine ln = this.lines[k];
            if (ln.height < baseH) { ln.height = baseH; }
            // Keep resource advance already recorded while laying out runs.
            for (int j = 0; j < ln.segments.Count; j = j + 1) {
                RichTextSegment s = ln.segments[j];
                if (s.x + s.width > ln.width) { ln.width = s.x + s.width; }
            }
        }
    }

    // 确保解析与排版缓存对当前 markup/宽度/字号有效。
    private void EnsureLayout(App app, int availW, int fp) {
        if (this.lines == null || this.laidMarkup != this.markup
            || this.laidW != availW || this.laidFont != fp) {
            if (this.laidMarkup != this.markup) {
                this.doc = RichTextParser.ParseText(this.markup,
                    this.ResolveDefaultColor(app));
                this.laidMarkup = this.markup;
            }
            this.RebuildLayout(app, availW, fp);
            this.laidW = availW;
            this.laidFont = fp;
        }
    }

    public override StyleBox ResolveStyle(App app, int state) {
        StyleBox box = base.ResolveStyle(app, state);
        if (box.overflowCss == 0 - 1) { box.overflowY = 2; box.overflow = 1; }
        return box;
    }

    public override Rect ScrollViewport() {
        Rect view = base.ScrollViewport();
        App app = this.App;
        int pad = app != null ? app.Scale(4) : 4;
        int w = view.width - pad * 2;
        int h = view.height - pad * 2;
        return new Rect(view.x + pad, view.y + pad, w > 0 ? w : 0, h > 0 ? h : 0);
    }

    private int LineAtPixel(int pixel) {
        if (lineTops == null || lineTops.Count == 0) { return 0; }
        int index = 0;
        while (index + 1 < lineTops.Count && lineTops[index + 1] <= pixel) { index = index + 1; }
        return index;
    }

    private void ProjectScroll() {
        if (!scrollReady || lineTops == null) { return; }
        int line = this.LineAtPixel(this.ScrollTop());
        int value = bottomAnchor ? maximumLine - line : line;
        if (value < 0) { value = 0; }
        if (value > maxScroll) { value = maxScroll; }
        // The exact bottom is the legacy zero even when it cuts through a line.
        if (bottomAnchor && this.ScrollTop() >= maximumPixel) { value = 0; }
        scroll = value;
        projectedScroll = value;
        projectedBottom = bottomAnchor;
    }

    public override void OnScrollChanged() {
        this.ProjectScroll();
        hoveredLink = null;
    }

    public override void Arrange(int x, int y, int w, int h) {
        bx = x; by = y; bw = w > 0 ? w : 0; bh = h > 0 ? h : 0;
        App app = this.App;
        if (app == null) { return; }
        bool external = !scrollReady || scroll != projectedScroll || bottomAnchor != projectedBottom;
        int requested = scroll;
        int distanceFromBottom = maximumPixel - this.ScrollTop();
        Rect view = this.ScrollViewport();
        int fp = this.ResolveFontPx(app);
        int inset = scrollBar != null ? this.BarW(app) : 0;
        int availW = view.width - inset;
        if (availW < fp) { availW = fp; }
        this.EnsureLayout(app, availW, fp);
        lineTops = new List<int>();
        contentHeight = 0;
        for (int i = 0; i < lines.Count; i = i + 1) {
            lineTops.Add(contentHeight);
            contentHeight = contentHeight + lines[i].height;
        }
        scrollExtent = contentHeight;
        scrollExtentX = view.width;
        maximumPixel = contentHeight - view.height;
        if (maximumPixel < 0) { maximumPixel = 0; }
        maximumLine = this.LineAtPixel(maximumPixel);
        if (lineTops.Count > 0 && lineTops[maximumLine] < maximumPixel) { maximumLine = maximumLine + 1; }
        if (maximumLine >= lines.Count) { maximumLine = lines.Count - 1; }
        maxScroll = maximumLine;
        int next = this.ScrollTop();
        if (external) {
            if (requested < 0) { requested = 0; }
            if (requested > maxScroll) { requested = maxScroll; }
            int index = bottomAnchor ? maximumLine - requested : requested;
            next = lineTops.Count > 0 ? lineTops[index] : 0;
            if (bottomAnchor && requested == 0) { next = maximumPixel; }
        } else if (bottomAnchor) { next = maximumPixel - distanceFromBottom; }
        if (next > maximumPixel) { next = maximumPixel; }
        if (next < 0) { next = 0; }
        scrollReady = true;
        this.ProjectScroll();
        this.SetScrollTop(next);
        // Also projects external changes whose pixel position did not change.
        this.ProjectScroll();
    }

    private RichTextSegment SegmentAt(int x, int y) {
        Rect view = this.ScrollViewport();
        if (lines == null || !view.Contains(x, y) || this.ScrollBarHit(x, y) != 0) { return null; }
        int pixel = y - view.y + this.ScrollTop();
        int index = this.LineAtPixel(pixel);
        if (index >= lines.Count || pixel < lineTops[index] || pixel >= lineTops[index] + lines[index].height) { return null; }
        RichTextLine line = lines[index];
        int offX = line.alignment == 1 ? (laidW - line.width) / 2 : (line.alignment == 2 ? laidW - line.width : 0);
        if (offX < 0) { offX = 0; }
        for (int i = 0; i < line.segments.Count; i = i + 1) {
            RichTextSegment segment = line.segments[i];
            int left = view.x + offX + segment.x;
            if (x >= left && x < left + segment.width) { return segment; }
        }
        return null;
    }

    public override void OnPointerMove(RoutedEventArgs e) {
        if (this.IsDisabled() || !this.StyleVisible()) { return; }
        RichTextSegment segment = this.SegmentAt(e.x, e.y);
        RichTextLink next = segment != null ? segment.link : null;
        if (hoveredLink != next) { hoveredLink = next; if (this.App != null) { this.App.RequestRedraw(); } }
    }

    public override void OnPointerLeave(RoutedEventArgs e) {
        base.OnPointerLeave(e);
        hoveredLink = null;
        if (this.App != null) { this.App.RequestRedraw(); }
    }

    public override void OnPointerDown(RoutedEventArgs e) {
        App app = this.App;
        if (e.originalSource != this || app == null || app.window.EventButton() != 0
            || this.IsDisabled() || !this.StyleVisible()) { return; }
        RichTextSegment segment = this.SegmentAt(e.x, e.y);
        if (segment == null || segment.link == null) { return; }
        pressedAction = segment.link.Raw();
        isPressed = true;
        app.CapturePointer(this);
        e.Handle();
    }

    public override void OnPointerUp(RoutedEventArgs e) {
        App app = this.App;
        if (app == null || app.window.EventButton() != 0 || pressedAction == null) { return; }
        string action = pressedAction;
        RichTextSegment segment = this.SegmentAt(e.x, e.y);
        bool activate = !this.IsDisabled() && this.StyleVisible() && segment != null
            && segment.link != null && segment.link.Raw() == action;
        pressedAction = null;
        isPressed = false;
        if (app.GetCapturedPointer() == this) { app.ReleasePointerCapture(); }
        e.Handle();
        if (activate) {
            for (int i = 0; i < linkHandlers.Count; i = i + 1) { linkHandlers[i](action); }
        }
    }

    public override void OnPointerCancel(RoutedEventArgs e) {
        base.OnPointerCancel(e);
        pressedAction = null;
        hoveredLink = null;
    }

    public override void OnInputFocusLost() {
        pressedAction = null;
        hoveredLink = null;
        isPressed = false;
        App app = this.App;
        if (app != null && app.GetCapturedPointer() == this) { app.ReleasePointerCapture(); }
    }

    // Geometry and interaction state are prepared before painting.
    public override void OnPaint(App app) {
        if (lines == null || lineTops == null) { return; }
        Canvas c = app.canvas;
        Rect view = this.ScrollViewport();
        int fp = this.ResolveFontPx(app);
        int textDy = (rowH - Canvas.FontHeight(fp)) / 2;
        if (textDy < 0) { textDy = 0; }
        c.PushClip(view.x, view.y, view.width, view.height);
        for (int index = this.LineAtPixel(this.ScrollTop()); index < lines.Count; index = index + 1) {
            RichTextLine line = lines[index];
            int y = view.y + lineTops[index] - this.ScrollTop();
            if (y >= view.y + view.height) { break; }
            int offX = line.alignment == 1 ? (laidW - line.width) / 2 : (line.alignment == 2 ? laidW - line.width : 0);
            if (offX < 0) { offX = 0; }
            for (int j = 0; j < line.segments.Count; j = j + 1) {
                RichTextSegment segment = line.segments[j];
                int sx = view.x + offX + segment.x;
                if (segment.background != 0) { c.FillRect(sx, y, segment.width, line.height, segment.background); }
                int color = segment.color;
                if (segment.link != null) {
                    int normal = segment.link.NormalColor();
                    int hover = segment.link.HoverColor();
                    if (((normal >> 24) & 255) == 0) { normal = 0; }
                    if (((hover >> 24) & 255) == 0) { hover = 0; }
                    if (hoveredLink == segment.link && hover != 0) { color = hover; }
                    else if (normal != 0) { color = normal; }
                }
                c.DrawText(sx, y + textDy, segment.text, color, fp);
            }
        }
        c.PopClip();
    }

    // 滚动条占用的宽度（与 StyledText 一致，收窄换行宽用）。
    public int BarW() { return this.BarW(this.App); }
    public int BarW(App app) {
        app = this.ResolveApp(app);
        return app != null ? app.Scale(12) : 12;
    }

}
