using System;
using Gui;

namespace Gui.Widget;

// 富文本链接点击回调：action 为 #@标记@…@ 里竖线前的动作原文。
delegate void RichTextLinkActivated(string action);

// 排版产物的一行：段列表、行宽、对齐（0 左 1 中 2 右）与行高。
// 段是同一渲染样式下连续的文本片段，跨 run 折行时颜色/背景/链接
// 随段延续。字段直接读写（控件内部数据，仿 TextRun 先例）。
class RichTextLine {
    List<RichTextSegment> segments;
    int width;
    int alignment;
    int height;

    // 构造一个空行并指定对齐。
    RichTextLine(int alignment) {
        this.segments = new List<RichTextSegment>();
        this.width = 0;
        this.alignment = alignment;
        this.height = 0;
    }
}

// 行内一个可绘制的文本片段：位置与宽度在排版时定，携带颜色、
// 背景与所在链接（null = 非链接）。
class RichTextSegment {
    string text;
    int x;
    int width;
    int color;
    int background;
    RichTextLink link;

    // 构造一个片段；x/width 由排版回填。
    RichTextSegment(string text, int color, int background,
            RichTextLink link) {
        this.text = text;
        this.x = 0;
        this.width = 0;
        this.color = color;
        this.background = background;
        this.link = link;
    }
}

// 富文本控件：标记文本进、按真实字体度量换行、逐段绘制。
// 标记语法与 Game.Arpg 同一种（#c/#bg/#f 颜色字体、#W #R #Y #B #G
// #H #L 快捷色、#md/#rt 对齐、#br 变宽、#p/#a/#item/#z 资源段、
// #@动作@内容@ 链接、## 转义 #），解析产物颜色为 0xAARRGGBB。
// 滚动模型仿 StyledText：bottomAnchor=true（默认，聊天用）时
// scroll 是「距底端的行数」，0 = 贴住最新一行；false（文档用）时
// scroll 是「距顶端的行数」。绘制后写出 maxScroll 供调用方回读；
// 给了 scrollBar 信号就在右侧画一条可拖动的纵向滚动条。滚轮
// 内置。资源段（#p/#a/#item）当前只占位推进排版，不绘制内容。
class RichText : Control {
    // 标记文本；每帧赋同一串不会重复解析（字符串相等即跳过）。
    string markup;
    // 解析缓存（markup 变化时重建）。
    RichTextDocument doc;
    // 排版缓存：行列表与布局键（markup/宽度/字号任一变化才重排）。
    List<RichTextLine> lines;
    string laidMarkup;
    int laidW;
    int laidFont;
    // 滚动偏移（行数；方向见 bottomAnchor），调用方持有。
    int scroll;
    // 绘制后写出：本帧的最大滚动偏移（行数）。
    int maxScroll;
    // true = 底端锚定（聊天），false = 顶端锚定（文档）。
    bool bottomAnchor;
    // 调用方的滚动条信号；非 null 且有得滚时画纵向滚动条。
    SignalInt scrollBar;
    // 字号覆盖（像素）；0 = 按 label small 样式解析。
    int fontPxOverride;
    // 解析初始前景色（0xAARRGGBB）；0 = 取样式表 richtext 前景，
    // 再退白。快捷色/显式颜色标签始终覆盖它。
    int defaultColor;
    // 行高（排版时算出，绘制与滚动共用）。
    int rowH;
    // 滚动条要的「像素、从顶算」转换信号（构造时建一次）。
    SignalInt barPx;
    // 链接点击处理列表（#@动作@…@ 被点下并抬起时逐个调用）。
    List<RichTextLinkActivated> linkHandlers;
    // 按下时命中的链接动作（抬起时还在同一链接上才算点击）。
    string pressedAction;

    // 空控件；Markup 赋值后自会解析排版。
    RichText() {
        this.InitControl("richtext", 1);
        // OnPaint 自行绘制文本与背景，不让框架再铺一层 CSS 表面。
        styleSurfaceOwned = true;
        markup = "";
        doc = null;
        lines = null;
        laidMarkup = null;
        laidW = 0 - 1;
        laidFont = 0 - 1;
        scroll = 0;
        maxScroll = 0;
        bottomAnchor = true;
        scrollBar = null;
        fontPxOverride = 0;
        defaultColor = 0;
        rowH = 0;
        barPx = new SignalInt(0);
        linkHandlers = new List<RichTextLinkActivated>();
        pressedAction = null;
    }

    // 设置标记文本（每帧赋同一串是廉价的：相等即跳过）。
    void SetMarkup(string newValue) { this.markup = newValue; }
    // 当前标记文本。
    string Markup() { return this.markup; }
    // 滚动方向：true 底端锚定（默认），false 顶端锚定。
    void SetBottomAnchor(bool newValue) { this.bottomAnchor = newValue; }
    // 字号覆盖（像素）；0 = 跟随 label small 样式。
    void SetFontPx(int newValue) { this.fontPxOverride = newValue; }
    // 解析初始前景色（0xAARRGGBB）；0 = 取样式表，再退白。
    void SetDefaultColor(int newValue) { this.defaultColor = newValue; }
    // 注册链接点击处理（可多个，按注册顺序调用）。
    void OnLinkActivated(RichTextLinkActivated handler) {
        this.linkHandlers.Add(handler);
    }

    // 控件类型标识（序列化/设计器用）。
    override string Kind() { return "RichText"; }

    // 当前排版行数（未排版为 -1）。诊断与测试用。
    int LineCount() {
        if (this.lines == null) { return 0 - 1; }
        return this.lines.Count;
    }

    // 解析出的实际字号。
    int ResolveFontPx(App app) {
        if (this.fontPxOverride > 0) { return this.fontPxOverride; }
        return Style.Of(app, "label", "small", Style.SNormal())
            .FontOr(Style.FontFallback(app, "small"));
    }

    // 解析初始前景色：显式 defaultColor 优先，其次样式表 richtext
    // 前景，最后白色。
    int ResolveDefaultColor(App app) {
        if (this.defaultColor != 0) { return this.defaultColor; }
        StyleBox sb = Style.Part(app, "richtext", "", "", "", "",
            Style.SNormal());
        return sb.FgOr((int)0xFFFFFFFF);
    }

    // 覆写：纯铺满槽位的画布，偏好尺寸取当前边界。
    override void OnMeasure(App app) {
        prefW = bw;
        prefH = bh;
    }

    // 新建一个空行。
    RichTextLine NewLine(int alignment) {
        return new RichTextLine(alignment);
    }

    // 排版：把解析产物按真实度量折成行。逐字累加宽度（CJK 无
    // 字距问题；拉丁允许极小偏差），超宽即折行，颜色/背景/链接
    // 随段延续——这正是多色聊天段跨行不断色的关键。
    void RebuildLayout(App app, int availW, int fp) {
        this.lines = new List<RichTextLine>();
        this.rowH = Canvas.FontHeight(fp) + app.Scale(3);
        int baseH = this.rowH;
        RichTextLine line = new RichTextLine(0);
        int lineW = 0;
        int lineHeight = baseH;
        // 当前在拼的段：连续同样式字符合并进同一段。
        RichTextSegment seg = null;
        int segStartLineW = 0;
        if (this.doc == null) {
            this.doc = RichTextParser.ParseText(this.markup,
                this.ResolveDefaultColor(app));
        }
        int align = 0;
        for (int i = 0; i < this.doc.RunCount(); i = i + 1) {
            RichTextRun run = this.doc.RunAt(i);
            if (run.Kind() == RichTextRunKind.LineBreak()) {
                if (seg != null) { seg.width = lineW - segStartLineW; }
                this.lines.Add(line);
                line = new RichTextLine(0);
                lineW = 0;
                segStartLineW = 0;
                seg = null;
                lineHeight = baseH;
                continue;
            }
            if (run.Kind() == RichTextRunKind.WrapWidth()) {
                // 语义照 Arpg TextLayout：只改后续换行宽度，不强行断行。
                if (run.Width() > 0) { availW = run.Width(); }
                continue;
            }
            int color = run.Style().Color();
            int background = run.Style().Background();
            RichTextLink link = run.Link();
            if (run.Kind() == RichTextRunKind.Text()) {
                align = run.Style().Alignment();
                string text = run.Text();
                int index = 0;
                while (index < text.Length) {
                    int next = Text.NextCharEnd(text, index);
                    string glyph = text.Substring(index, next - index);
                    int gw = Canvas.MeasureText(glyph, fp);
                    if (lineW + gw > availW && lineW > 0) {
                        // 折行：当前段收口，另起一行，字符留在新行。
                        if (seg != null) {
                            seg.width = lineW - segStartLineW;
                        }
                        this.lines.Add(line);
                        line = new RichTextLine(0);
                        lineW = 0;
                        segStartLineW = 0;
                        seg = null;
                    }
                    if (line.segments.Count == 0) {
                        // 行对齐取该行第一个文本段的样式快照。
                        line.alignment = align;
                    }
                    if (seg == null || seg.color != color
                        || seg.background != background
                        || seg.link != link) {
                        seg = new RichTextSegment(glyph, color, background,
                            link);
                        seg.x = lineW;
                        segStartLineW = lineW;
                        line.segments.Add(seg);
                    } else {
                        seg.text = seg.text + glyph;
                    }
                    lineW = lineW + gw;
                    index = next;
                }
            } else {
                // 资源/占位段：当前只推进排版（宽兜底字号），不绘制。
                int w = run.Width();
                int h = run.Height();
                if (w <= 0) { w = fp; }
                if (h <= 0) { h = fp; }
                if (lineW + w > availW && lineW > 0) {
                    this.lines.Add(line);
                    line = new RichTextLine(align);
                    lineW = 0;
                    seg = null;
                    segStartLineW = 0;
                }
                if (h > lineHeight) { lineHeight = h; }
                lineW = lineW + w;
                seg = null;
            }
            if (lineHeight > line.height) { line.height = lineHeight; }
        }
        if (seg != null) { seg.width = lineW - segStartLineW; }
        this.lines.Add(line);
        for (int k = 0; k < this.lines.Count; k = k + 1) {
            RichTextLine ln = this.lines[k];
            if (ln.height < baseH) { ln.height = baseH; }
            ln.width = 0;
            for (int j = 0; j < ln.segments.Count; j = j + 1) {
                RichTextSegment s = ln.segments[j];
                if (s.x + s.width > ln.width) { ln.width = s.x + s.width; }
            }
        }
    }

    // 确保解析与排版缓存对当前 markup/宽度/字号有效。
    void EnsureLayout(App app, int availW, int fp) {
        if (this.lines == null || this.laidMarkup != this.markup
            || this.laidW != availW || this.laidFont != fp) {
            if (this.laidMarkup != this.markup) {
                this.doc = RichTextParser.ParseText(this.markup,
                    this.ResolveDefaultColor(app));
                this.laidMarkup = this.markup;
            }
            this.RebuildLayout(app, availW, fp);
            this.laidW = availW;
            this.laidFont = fp;
        }
    }

    // 覆写：解析 → 排版 → 处理滚轮与链接点击 → 逐段绘制背景与
    // 文字 → 写出 maxScroll → 可选滚动条。
    override void OnPaint(App app) {
        Canvas c = app.canvas;
        int pad = app.Scale(4);
        int fp = this.ResolveFontPx(app);
        int inset = 0;
        if (this.scrollBar != null) { inset = this.BarW(app); }
        int availW = bw - pad * 2 - inset;
        if (availW < fp) { availW = fp; }
        this.EnsureLayout(app, availW, fp);
        int count = this.lines.Count;
        int textDy = (this.rowH - Canvas.FontHeight(fp)) / 2;
        if (textDy < 0) { textDy = 0; }
        int viewH = bh - pad * 2;
        int maxRows = viewH / this.rowH;
        if (maxRows < 1) { maxRows = 1; }
        int maxSc = count - maxRows;
        if (maxSc < 0) { maxSc = 0; }
        int sc = this.scroll;
        if (sc > maxSc) { sc = maxSc; }
        if (sc < 0) { sc = 0; }
        this.scroll = sc;
        this.maxScroll = maxSc;
        int start = 0;
        if (this.bottomAnchor) {
            start = count - maxRows - sc;
        } else {
            start = sc;
        }
        if (start < 0) { start = 0; }
        if (start > count) { start = count; }

        // 指针交互：滚轮滚动；链接悬停换色，按下+抬起在同一链接上
        // 触发点击。命中区域先注册，拖拽期间移动事件才持续送达。
        int hid = app.focus.AllocId();
        app.hitTester.RegisterRect(hid, bx, by, bw, bh, 1);
        int kind = app.EventKind();
        // 认领以真溢出为前提（maxSc > 0）：内容放得下时不认领，滚轮
        // 穿透给外层容器/页面——认领了也只是把 sc 钳回 0 白吃一格。
        if (maxSc > 0 && app.CaptureWheel(bx, by, bw, bh) && kind == 13) {
            int wd = app.window.EventKeyCode();
            int step = wd / 120;
            if (step == 0) {
                if (wd > 0) { step = 1; }
                else if (wd < 0) { step = 0 - 1; }
            }
            if (this.bottomAnchor) { sc = sc - step; }
            else { sc = sc + step; }
            if (sc > maxSc) { sc = maxSc; }
            if (sc < 0) { sc = 0; }
            this.scroll = sc;
            app.RequestRedraw();
        }
        bool over = app.mouseX >= bx && app.mouseX < bx + bw
            && app.mouseY >= by && app.mouseY < by + bh;
        RichTextSegment hover = null;
        RichTextSegment hit = null;
        if (over && !app.PointerCaptured()) {
            hit = this.SegmentHit(pad, start, maxRows,
                app.mouseX, app.mouseY);
            if (hit != null && hit.link != null) { hover = hit; }
        }
        if (kind == 2 && over && hit != null && hit.link != null) {
            this.pressedAction = hit.link.Raw();
        }
        if (kind == 3 && this.pressedAction != null) {
            RichTextSegment up = null;
            if (over) {
                up = this.SegmentHit(pad, start, maxRows,
                    app.mouseX, app.mouseY);
            }
            if (up != null && up.link != null
                && up.link.Raw() == this.pressedAction) {
                for (int i = 0; i < this.linkHandlers.Count; i = i + 1) {
                    this.linkHandlers[i](this.pressedAction);
                }
            }
            this.pressedAction = null;
        }

        int barX = bx + bw - pad - inset;
        c.PushClip(bx, by, bw, bh);
        int y = by + pad;
        for (int row = 0; row < maxRows; row = row + 1) {
            int idx = start + row;
            if (idx >= count) { break; }
            RichTextLine line = this.lines[idx];
            int offX = 0;
            if (line.alignment == 1) {
                offX = (availW - line.width) / 2;
            } else if (line.alignment == 2) {
                offX = availW - line.width;
            }
            if (offX < 0) { offX = 0; }
            int lineY = y;
            for (int j = 0; j < line.segments.Count; j = j + 1) {
                RichTextSegment s = line.segments[j];
                int sx = bx + pad + offX + s.x;
                if (s.background != 0) {
                    c.FillRect(sx, lineY, s.width, line.height,
                        s.background);
                }
                int col = s.color;
                if (s.link != null) {
                    // 链接色 alpha 字节为 0 视为未提供（DrawText 把 0
                    // 当不透明，直接比较会把 Arpg 的透明标记色画出来）。
                    int nc = s.link.NormalColor();
                    if (((nc >> 24) & 255) == 0) { nc = 0; }
                    int hc = s.link.HoverColor();
                    if (((hc >> 24) & 255) == 0) { hc = 0; }
                    if (hover != null && hover.link == s.link && hc != 0) {
                        col = hc;
                    } else if (nc != 0) {
                        col = nc;
                    }
                }
                c.DrawText(sx, lineY + textDy, s.text, col, fp);
            }
            y = y + line.height;
        }
        c.PopClip();

        // 纵向滚动条：行数滚动换算成从顶算的像素，拖动结果写回。
        if (this.scrollBar != null && maxSc > 0) {
            int trackH = bh - pad * 2;
            int contentPx = count * this.rowH;
            int top = 0;
            if (this.bottomAnchor) { top = (maxSc - sc) * this.rowH; }
            else { top = sc * this.rowH; }
            this.barPx.Set(top);
            Scrollbar.RenderVerticalScrollIn(app, barX, by + pad,
                trackH, maxRows * this.rowH, contentPx, this.barPx,
                bx, by, bw, bh);
            int want = this.barPx.Get() / this.rowH;
            if (this.bottomAnchor) { want = maxSc - want; }
            if (want < 0) { want = 0; }
            if (want > maxSc) { want = maxSc; }
            if (want != sc) {
                this.scroll = want;
                app.RequestRedraw();
            }
        }
    }

    // 滚动条占用的宽度（与 StyledText 一致，收窄换行宽用）。
    int BarW(App app) { return app.Scale(12); }

    // (mx,my) 落在的可见段；不在任何段上返回 null。
    RichTextSegment SegmentHit(int pad, int start, int maxRows,
            int mx, int my) {
        int y = by + pad;
        for (int row = 0; row < maxRows; row = row + 1) {
            int idx = start + row;
            if (idx >= this.lines.Count) { break; }
            RichTextLine line = this.lines[idx];
            int nextY = y + line.height;
            if (my >= y && my < nextY) {
                int offX = 0;
                if (line.alignment == 1) {
                    offX = (this.laidW - line.width) / 2;
                } else if (line.alignment == 2) {
                    offX = this.laidW - line.width;
                }
                if (offX < 0) { offX = 0; }
                for (int j = 0; j < line.segments.Count; j = j + 1) {
                    RichTextSegment s = line.segments[j];
                    int sx = bx + pad + offX + s.x;
                    if (mx >= sx && mx < sx + s.width) { return s; }
                }
                return null;
            }
            y = nextY;
        }
        return null;
    }
}
