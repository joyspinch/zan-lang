using System;
using Gui;

namespace Gui.Widget;

// 高层、自包含的 select / 下拉框。
// 有状态（创建一次，跨帧保留）。单个 Render() 绘制
// 触发控件和弹出层，并自持开/关、选项列表、单选或
// 多选、可选清除按钮、尺寸和状态变体，以及
// 选项列表较长时自滚动的弹出层（鼠标滚轮 + 滚动条 + 裁剪），
// 因此调用处只需：
// SelectBox city = new SelectBox("Pick a city", false);   // 创建一次
// city.Render(app, x, y, w);                           // 每帧
// int i = city.Selected();          // 无选中时为 -1
// 多选：SelectBox.Multi(hint) + IsChosen(i)。流畅配置：
// 尺寸档另行赋值：`box.Size = "large";`（"small"/"medium"/"large"）。
// 绑定：`sel.data = form.color;` 将选中索引双向绑定到
// 普通字段；`SelectBox.FromOptions(options, hint)` 从标签列表构建，
// 且 `sel.Change += h;` 在每次选择变化时触发。
public partial class SelectBox : Control {
    // 全部选项（平铺：分组标题、禁用项、级联子级都在此列）。
    List<SelectOption> opts;
    Control customPopup;
    // 单选选中下标（-1 无）；多选模式不用。
    int selected;
    // 可选共享选择信号（SelectBox.Bind）。
    SignalInt model;
    // 双向绑定的选中索引：`sel.data = form.color;`（编译器降级的
    // Binding）。新变动的一方生效，弹出层与字段保持同步。
    Binding<int> data;
    // 上次与 model / data 同步的值：SyncBinding 据此判断谁变了。
    int lastModel;
    int lastData;
    // 选择变化时触发（`sel.Change += h;`）。
    UiEvent Change;
    // 选项列表打开/关闭时触发，无论由哪种方式
    // 触发（点击触发控件、选择、外部按压、Esc）。
    UiEvent Open;
    UiEvent Close;
    // 无选中时显示的占位文字。
    string hint;
    // 多选模式（取值为勾选集合）。
    bool multi;
    // 有值且悬停时显示清除按钮。
    bool clearable;
    // 弹层展开状态。
    bool open;
    // 弹层列表滚动偏移（像素）。
    int scrollY;
    // 弹层滚动偏移的信号视图：内嵌 Scrollbar 直接拖它，
    // 每帧与 `scrollY` 互相同步。
    SignalInt scrollSignal;
    // 尺寸档："small" / "medium" / "large"（§6.4 尺寸档统一 string）。
    // Binding<string> 使属性面板的 size 行真正写回；渲染时映射为
    // select.* 档位 class（base.css 的 --height-* token 规则）。
    Binding<string> Size;

    // 覆写：返回 Size 绑定字段（设计器经它发现尺寸档位绑定）。
    override Binding<string> SizeOf() { return Size; }

    // 校验状态（Normal/Success/Warning/Error），经 StyleClass 映射为状态 class。
    int status;
    // 弹层最多直接可见的行数，超出滚动（也决定多选自动分列行数）。
    int maxVisible;
    // 弹出层位置：0 自动（触发控件下方，超出则反向），1 仅下方，2 仅上方。
    // Naive UI `placement` prop。
    int placement;
    // 可搜索：弹出层顶部加搜索框，键入时过滤选项（Naive UI `filterable` prop）。
    bool filterable;
    // 当前搜索关键词。
    string filterText;
    // 筛选搜索框：弹层顶部内嵌的真 Input 组件（不是自绘的假输入条），
    // 焦点、光标、选区、Ctrl+A/C/X/V、清除按钮全部由 Input 自持。
    // 打开弹层期间焦点锁定在它上面，键入才不需要先点一下搜索框。
    Input filterBox;
    // 级联模式：选项带子级，弹层逐列展开（省市区这类层级）。
    bool cascade;
    // 级联当前展开链：每列已展开选项的平铺下标（flatIdx）。
    List<int> cascadePath;
    // 级联顶层选项（AddBranch 建立的那些），弹层第一列渲染它们。
    List<SelectOption> cascRoots;
    // 级联过滤的命中下标（filterable + 关键词非空时重建）：平铺所有
    // 层级里标签命中的节点，行上显示完整路径。
    List<int> cascadeFilter;
    // 级联父子联动（Naive UI `cascade` prop，默认开）：勾选父级带动
    // 全部子孙，父级的勾/半勾由子孙推导；关掉后任何层级的选项都可
    // 独立勾选，单选下也允许直接选中带子级的分支。
    bool cascadeLink;
    // 勾选策略（Naive UI check-strategy）：0 all 全部勾选节点、
    // 1 parent 只算没被更深勾选祖先盖住的节点（完整勾选子树的顶）、
    // 2 child 只算勾选的叶子。
    int checkStrategy;
    // 触发器/标签显示完整路径（"浙江 / 杭州 / 西湖区"，
    // Naive UI show-path）；关掉只显示末级短标签。
    bool showPath;
    // 悬停即展开下一列（Naive UI hover-trigger）；默认点击展开。
    bool hoverExpand;
    // 从过滤结果选中后清掉搜索词（默认清）。
    bool clearFilterAfter;
    // 级联各列的滚动状态实体集合（唯一主表示，彻底消除平行列表反模式）。
    List<CascadeColumnScroll> cascadeCols;
    // 树形模式：弹层内嵌一颗真 TreeView，展开/折叠、滚动、悬停
    // 全部由 TreeView 自持，SelectBox 只负责摆位与收值。
    bool treeMode;
    TreeView treeBox;
    // 树形模式上次见到的选中下标（-1 无），用于每帧轮询选中变化。
    int treeSelSeen;
    // 级联/树形选中的完整路径文本（"浙江 / 杭州"），供 Text() 显示。
    string pathText;
    // 过滤后的选项索引列表（null = 不启用过滤）。每帧根据 filterText 重建。
    List<int> filteredIdx;
    // 每帧暂存锚点几何，使延迟弹出层（OnPaintOverlay、
    // 在覆盖阶段运行）能在触发控件下方自行布局。
    int trigX;
    int trigY;
    int trigW;
    // 稳定控件 id：触发控件注册它，使悬停/按压/焦点（及读取它们的
    // 缓动样式过渡）与任何其他控件一样工作。
    int wid;
    // 上一帧实际绘制的头部高度（尊重显式 RenderIn
    // 高度）；延迟弹出层读取它，使其正好位于触发控件下方。
    int lastH;
    // 上一帧指针悬停的选项（无则 -1）。弹出层在覆盖阶段绘制
    // 且未按行注册命中区域，因此没有其他机制
    // 会请求重绘光标下那行的帧。
    int hoverRow;
    // 悬停的选项变化时触发（`sel.Hover += h;`，用 Hovered() 读是哪一条）。
    // 没有它，调用方就只能靠自己在弹层几何上重算一遍鼠标位置 —— 而弹层
    // 的位置是框架翻转后决定的，外面根本算不准。
    UiEvent Hover;
    // 弹层列数：0 = 自动（多选框选项多于一屏时分成等宽多列，
    // 而不是拉成一条长条），否则固定列数。
    int cols;
    // 表格式下拉列定义实体列表（强类型实体承载，消除平行列表反模式）。
    List<SelectBoxColumn> tableColumns;
    // 搜索框里的提示文字（filterable）。空则用 "Search"。
    string filterHint;
    // 弹层宽度缓存。量一次即可：逐帧测量每条标签在上万条选项时
    // 就是每帧上万次文本测量，比真正的绘制还贵。
    int popupW;
    // 弹层宽度缓存是否失效（选项集 / 过滤词 / 列数变化时置位）。
    bool popupWDirty;
    // 选项原始文本或 JSON 串（防帧级频繁重复解析）。
    string optionsRaw;

    // 校验状态常量（Status 的取值）。
    static int Normal() { return 0; }
    // 校验通过状态。
    static int Success() { return 1; }
    // 校验警告状态。
    static int Warning() { return 2; }
    // 校验错误状态。
    static int Error() { return 3; }

    SelectBox() : this("", false) { }

    // 单选下拉框（多选用 `new SelectBox(hint, true)`）。
    SelectBox(string hintText) : this(hintText, false) { }

    // 主构造：占位提示 + 是否多选；默认弹层最多显示 6 行，级联联动开。
    SelectBox(string hintText, bool isMulti) {
        this.InitControl("selectbox", 0);
        this.opts = new List<SelectOption>();
        this.selected = 0 - 1;
        this.hint = hintText;
        this.multi = isMulti;
        this.clearable = false;
        this.open = false;
        this.scrollY = 0;
        this.Size = "medium";
        this.status = 0;
        this.maxVisible = 6;
        this.cols = 0;
        this.placement = 0;
        this.filterable = false;
        this.filterText = "";
        this.filteredIdx = null;
        this.wid = WidgetId.Next();
        this.lastH = 0;
        this.hoverRow = 0 - 1;
        this.wiresOwnEvents = true;
        this.lastModel = 0 - 1;
        this.lastData = 0 - 1;
        this.tableColumns = null;
        this.filterHint = "";
        this.cascade = false;
        this.cascadePath = null;
        this.cascRoots = null;
        this.cascadeFilter = null;
        this.cascadeLink = true;
        this.checkStrategy = 0;
        this.showPath = true;
        this.hoverExpand = false;
        this.clearFilterAfter = true;
        this.cascadeCols = null;
        this.treeMode = false;
        this.treeBox = null;
        this.treeSelSeen = 0 - 1;
        this.pathText = "";
        this.popupW = 0;
        this.popupWDirty = true;
        this.optionsRaw = "";
        this.Change = new UiEvent();
        this.Open = new UiEvent();
        this.Close = new UiEvent();
        this.Hover = new UiEvent();
    }

    // 当前选中项的数据值（无显式值时返回 label；未选中时返回 ""）。
    string SelectedValue() {
        if (selected >= 0 && selected < opts.Count) {
            string v = opts[selected].val;
            return (v != null && v != "") ? v : opts[selected].label;
        }
        return "";
    }

    // 从普通标签列表构建选择框（JSON / 设计器 / 单行场景使用）。
    static SelectBox FromOptions(List<string> options, string hint) {
        SelectBox s = new SelectBox(hint, false);
        for (int i = 0; i < options.Count; i = i + 1) {
            s.AddOption(options[i]);
        }
        return s;
    }

    // 选项以 `a|b|c` 字符串表示（设计器 / 设计文档属性往返）。
    string OptionsText() {
        string outp = "";
        for (int i = 0; i < opts.Count; i = i + 1) {
            if (i > 0) { outp = outp + "|"; }
            outp = outp + opts[i].label;
        }
        return outp;
    }

    // "a|b|c" 文本或 JSON 数组 → 选项列表（SetExtra 反序列化；滚动复位）。
    void SetOptionsText(string text) {
        if (text == optionsRaw && opts != null && opts.Count > 0) { return; }
        optionsRaw = text != null ? text : "";
        popupWDirty = true;
        opts = new List<SelectOption>();
        if (text == null) {
            selected = 0 - 1;
            scrollY = 0;
            return;
        }
        string s = text.Trim();
        if (s == "") {
            selected = 0 - 1;
            scrollY = 0;
            return;
        }
        if (s.StartsWith("[") && s.EndsWith("]")) {
            JsonValue arr = JsonValue.ParseLenient(s);
            if (arr != null && arr.IsArray()) {
                for (int i = 0; i < arr.Count(); i = i + 1) {
                    JsonValue item = arr.At(i);
                    if (item == null) { continue; }
                    if (item.IsObject()) {
                        string lbl = item.Str("label", "");
                        if (lbl == "") { lbl = item.Str("text", ""); }
                        if (lbl == "") { lbl = item.Str("name", ""); }
                        if (lbl == "") { lbl = item.Str("title", ""); }
                        string v = item.Str("value", "");
                        if (v == "") { v = item.Str("id", ""); }
                        if (v == "") { v = lbl; }
                        if (lbl == "") { lbl = v; }
                        SelectOption opt = new SelectOption(lbl, v, false);
                        opt.disabled = item.Bool("disabled", false);
                        opts.Add(opt);
                    } else {
                        string sv = item.AsString("");
                        opts.Add(new SelectOption(sv, sv, false));
                    }
                }
                if (selected >= opts.Count) { selected = opts.Count - 1; }
                scrollY = 0;
                return;
            }
        }
        List<string> parts = text.Split("|");
        for (int i = 0; i < parts.Count; i = i + 1) {
            string p = parts[i].Trim();
            if (p != "") {
                opts.Add(new SelectOption(p, p, false));
            }
        }
        if (selected >= opts.Count) { selected = opts.Count - 1; }
        scrollY = 0;
    }

    // 固定弹层列数（等宽）；0 恢复自动。选项按列优先填，
    // 先从第一列自上而下。
    SelectBox Columns(int n) {
        if (n < 0) { n = 0; }
        cols = n;
        scrollY = 0;
        popupWDirty = true;
        return this;
    }

    // 表格式下拉（强类型实体入参）：弹层变成一张带列标题的表。
    SelectBox Table(List<SelectBoxColumn> columns) {
        if (columns == null) {
            this.tableColumns = null;
            this.scrollY = 0;
            this.popupWDirty = true;
            return this;
        }
        this.tableColumns = columns;
        this.scrollY = 0;
        this.popupWDirty = true;
        return this;
    }

    // 表格式下拉：弹层变成一张带列标题的表，每个选项占一行、
    // 每行按 `widths` 分列。首列是选项的 label（Text() 仍然返回它），
    // 其余列由 AddRow 提供。
    // 传 null 恢复普通列表。
    SelectBox Table(List<string> titles, List<int> widths) {
        if (titles == null || widths == null) {
            this.tableColumns = null;
            this.scrollY = 0;
            this.popupWDirty = true;
            return this;
        }
        this.tableColumns = new List<SelectBoxColumn>();
        int count = titles.Count < widths.Count ? titles.Count : widths.Count;
        for (int i = 0; i < count; i = i + 1) {
            this.tableColumns.Add(new SelectBoxColumn(titles[i], widths[i]));
        }
        scrollY = 0;
        popupWDirty = true;
        return this;
    }

    // 是否处于表格式下拉模式。
    bool IsTable() {
        return tableColumns != null && tableColumns.Count > 0;
    }

    // 表格式下拉的一行。`cells[0]` 是 label（首列），其余为后续列。
    void AddRow(List<string> cells) {
        if (cells == null || cells.Count == 0) { return; }
        SelectOption o = new SelectOption(cells[0], false);
        List<string> rest = new List<string>();
        for (int i = 1; i < cells.Count; i = i + 1) { rest.Add(cells[i]); }
        o.cells = rest;
        opts.Add(o);
        popupWDirty = true;
    }

    // 表头高度（表格模式下弹层顶部占用的空间）。
    int HeaderH(App app) {
        if (!this.IsTable()) { return 0; }
        return app.Scale(26);
    }

    // 过滤后参与显示的行数。
    int DisplayCount() {
        List<int> vis = this.VisibleOpts();
        if (vis == null) { return opts.Count; }
        return vis.Count;
    }

    // 显示行 -> 真实选项下标。过滤开着时经过滤表转换，否则同一个数。
    // 渲染、命中和悬停三处原本各自内联这段映射，任何一处写歪都表现为
    // 「点中的不是看到的那条」。
    int RowToOpt(int row) {
        List<int> vis = this.VisibleOpts();
        if (vis == null) {
            if (row < 0 || row >= opts.Count) { return 0 - 1; }
            return row;
        }
        if (row < 0 || row >= vis.Count) { return 0 - 1; }
        return vis[row];
    }

    // 悬停中的选项下标，没有则 -1（配合 `Hover` 事件读取）。
    int Hovered() { return hoverRow; }

    // 第 `i` 个选项的标签（越界返回空串）。悬停/选择事件给出的是下标，
    // 调用方要显示的是文字。
    string OptionLabel(int i) {
        if (i < 0 || i >= opts.Count) { return ""; }
        return opts[i].label;
    }

    // 本次开层实际的列数。自动时：单选保持单列（下拉就该是
    // 一条列表）；多选超过一屏时按 maxVisible 分列，最多 4 列，
    // 这样一屏就能成行成列地看完。表格模式恒为一列（列在行内部）。
    int ColumnCount() {
        if (this.IsTable()) { return 1; }
        if (cols > 0) { return cols; }
        if (!multi) { return 1; }
        if (maxVisible <= 0) { return 1; }
        int n = (this.DisplayCount() + maxVisible - 1) / maxVisible;
        if (n < 1) { n = 1; }
        if (n > 4) { n = 4; }
        return n;
    }

    // 当前列数下每列的行数。
    int RowCount() {
        int n = this.ColumnCount();
        int rows = (this.DisplayCount() + n - 1) / n;
        if (rows < 1) { rows = 1; }
        return rows;
    }

    // 当前选中下标（Selected 的别名）。
    int Value() { return selected; }

    // 外部设定选中下标（钳制到有效范围，-1 = 无选择）。
    // 程序化赋值不触发 Change；弹出层与渲染下一帧读到新值。
    void SetIndex(int idx) {
        if (idx >= opts.Count) { idx = opts.Count - 1; }
        if (idx < 0) { idx = 0 - 1; }
        selected = idx;
        lastModel = selected;
    }

    // 按选项文本或值匹配并选中
    void Select(string text) {
        if (text == "" || opts == null) { this.ClearSelection(); return; }
        for (int i = 0; i < opts.Count; i = i + 1) {
            if (opts[i].val == text || opts[i].label == text) {
                this.SetIndex(i);
                return;
            }
        }
    }

    // 清除选择
    void ClearSelection() {
        this.SetIndex(0 - 1);
    }

    // 弹层当前是否打开。
    bool IsOpen() { return open; }

    // 打开/关闭列表，并在实际切换时触发 Open/Close，
    // 使每个入口（触发控件、选择、外部按压、Esc、代码）以相同方式
    // 报告。
    void SetOpen(bool v) {
        if (open == v) { return; }
        open = v;
        if (v) {
            OverlayHost.ShowPopup(App.FrameApp(), this, this);
            scrollY = 0;
            // 级联弹层回到第一列；单选已有选中值时把它的祖先链展开，
            // 重开弹层能直接看到选中路径（多选没有单一选中，回第一列）。
            cascadePath = new List<int>();
            cascadeCols = null;
            if (cascade && !multi && selected >= 0 && selected < opts.Count) {
                List<int> chain = new List<int>();
                int walk = opts[selected].parentIdx;
                while (walk >= 0 && walk < opts.Count && chain.Count < 3) {
                    chain.Insert(0, walk);
                    walk = opts[walk].parentIdx;
                }
                cascadePath = chain;
            }
            // 开层即一次新搜索：清掉上一次的关键词。
            if (filterable && filterBox != null) {
                filterBox.SetText("");
                filterText = "";
                this.RebuildFilter();
            }
            Open.RaiseS(this);
        }
        else {
            OverlayHost.DismissPopup();
            Close.RaiseS(this);
        }
    }

    public override void OnPopupDismissed() {
        if (this.open) {
            this.SetOpen(false);
        }
    }

    // 将共享信号和双向绑定与 `selected` 协调一致。
    // 弹出层直接写 `selected`，因此每一侧都与
    // 上次同步值比较，发生变动的一方生效。
    override void SyncBinding() {
        if (model != null) {
            int m = model.Get();
            if (m != selected) {
                if (selected != lastModel) { model.Set(selected); }
                else { selected = m; }
            }
            lastModel = selected;
        }
        if (data != null) {
            int b = data.Get();
            if (b != selected) {
                if (selected != lastData) { data.Set(selected); }
                else { selected = b; }
            }
            lastData = selected;
        }
    }

    // 应用弹出层作出的选择：将绑定和 Change
    // 事件集中在一处，使所有入口行为一致。
    void Choose(int idx) {
        if (idx < 0 || idx >= opts.Count) { return; }
        // 分组标题与禁用项不是可选项。
        if (opts[idx].grp || opts[idx].disabled) { return; }
        if (multi) {
            opts[idx].chosen = !opts[idx].chosen;
        } else {
            if (selected == idx) { return; }
            selected = idx;
            if (model != null) { model.Set(idx); lastModel = idx; }
            if (data != null) { data.Set(idx); lastData = idx; }
        }
        Change.RaiseS(this);
    }

    // 级联选择模式。层级用 AddBranch / AddChild 建立，
    // 弹层逐列展开，选中叶子时触发器显示完整路径
    // （"浙江 / 杭州 / 西湖区"）。配合 Multi(true) 得到勾选式
    // 多选（父子联动 + 勾选策略 + 标签芯片触发器）。
    SelectBox Cascade() {
        cascade = true;
        return this;
    }

    // 勾选策略常量（CheckStrategy 的取值）。
    static int CheckAll() { return 0; }
    // 策略 1：只有勾选的父级节点计入触发器值集合。
    static int CheckParent() { return 1; }
    // 策略 2：只有勾选的子级节点计入触发器值集合。
    static int CheckChild() { return 2; }

    // 级联父子联动（Naive UI `cascade` prop，默认开）：勾选父级带动
    // 全部子孙；关掉后任何层级的选项独立勾选，单选下也允许直接选中
    // 带子级的分支。
    SelectBox CascadeLink(bool v) {
        cascadeLink = v;
        return this;
    }

    // 勾选策略：CheckAll / CheckParent / CheckChild（Naive UI
    // check-strategy）。决定哪些勾选节点计入触发器的值集合。
    SelectBox CheckStrategy(int v) {
        if (v >= 0 && v <= 2) { checkStrategy = v; }
        return this;
    }

    // 触发器是否显示完整路径；false 只显示末级短标签
    // （Naive UI show-path）。
    SelectBox ShowPath(bool v) {
        showPath = v;
        return this;
    }

    // 悬停即展开下一列（Naive UI hover-trigger）；默认点击展开。
    SelectBox HoverExpand(bool v) {
        hoverExpand = v;
        return this;
    }

    // 从过滤结果里选中后是否清掉搜索词（Naive UI
    // clear-filter-after-select，默认清）。
    SelectBox ClearFilterAfter(bool v) {
        clearFilterAfter = v;
        return this;
    }

    // 加一个顶层分支（级联第一列的条目），返回它的平铺下标
    // （继续 AddChild 时作父下标用）。
    int AddBranch(string label) {
        SelectOption o = new SelectOption(label, false);
        o.flatIdx = opts.Count;
        opts.Add(o);
        if (cascRoots == null) { cascRoots = new List<SelectOption>(); }
        cascRoots.Add(o);
        popupWDirty = true;
        return o.flatIdx;
    }

    // 给第 `parent` 个选项挂一个子级（父下标是 AddBranch /
    // AddChild 的返回值），返回子级的平铺下标。挂在同一父级
    // 下的子级按插入顺序排成一列。
    int AddChild(int parent, string label) {
        if (parent < 0 || parent >= opts.Count) { return 0 - 1; }
        SelectOption o = new SelectOption(label, false);
        o.flatIdx = opts.Count;
        o.parentIdx = parent;
        opts.Add(o);
        opts[parent].Attach(o, o.flatIdx);
        popupWDirty = true;
        return o.flatIdx;
    }

    // 树形选择模式：弹层内嵌一颗真 TreeView。层级用
    // TreeNode.Dir / TreeNode.File 构建，经 TreeNodes 绑定；
    // 叶节点被选中时触发器显示它的 payload（未设则 label）。
    // 树的展开、滚动、悬停全部是 TreeView 自己的行为。
    SelectBox Tree() {
        treeMode = true;
        treeBox = new TreeView();
        treeSelSeen = 0 - 1;
        return this;
    }

    // 绑定树节点（调用方的列表，TreeView.Bind 不复制）。
    SelectBox TreeNodes(List<TreeNode> nodes) {
        if (treeBox == null) { this.Tree(); }
        treeBox.Bind(nodes);
        return this;
    }

    // 工厂：多选下拉框。
    static SelectBox Multi(string hintText) {
        return new SelectBox(hintText, true);
    }

    // 追加一个普通选项。
    void AddOption(string label) {
        opts.Add(new SelectOption(label, false));
        popupWDirty = true;
    }

    // 加一个禁用项：占正常位置、置灰显示，但不响应悬停与点击。
    void AddOption(string label, bool disabled) {
        SelectOption o = new SelectOption(label, false);
        o.flatIdx = opts.Count;
        o.disabled = disabled;
        opts.Add(o);
        popupWDirty = true;
    }

    // 加一个分组标题：随后 AddOption 的条目在视觉上归属该组。
    // 标题行本身不可悬停、不可选择；键入筛选时若组内没有命中
    // 项，标题随组一起隐藏。
    void AddGroup(string title) {
        SelectOption o = new SelectOption(title, false);
        o.flatIdx = opts.Count;
        o.grp = true;
        opts.Add(o);
        popupWDirty = true;
    }

    // 是否显示清除按钮（有值且悬停时）。
    SelectBox Clearable(bool v) {
        clearable = v;
        return this;
    }

    // 设校验状态（Normal/Success/Warning/Error 常量）。
    SelectBox Status(int v) {
        status = v;
        return this;
    }

    // 弹出位置：0=自动（默认），1=下方（Naive UI placement="bottom"），2=上方。
    SelectBox Placement(int v) {
        if (v >= 0 && v <= 2) { placement = v; }
        return this;
    }

    // 启用搜索过滤（Naive UI filterable）。
    SelectBox Filterable(bool v) {
        filterable = v;
        if (v) { filterText = ""; }
        return this;
    }

    // 搜索框的提示文字。不设则用 "Search"。
    SelectBox FilterHint(string s) {
        filterHint = s;
        if (filterBox != null) { filterBox.SetHint(s); }
        return this;
    }

    // 当前搜索关键词（供调用方回显 / 远程搜索用）。
    string FilterText() { return filterText; }

    // 以编程方式设置关键词并重建过滤结果。
    void SetFilterText(string s) {
        filterText = s;
        if (filterBox != null) { filterBox.SetText(s); }
        scrollY = 0;
        this.RebuildFilter();
    }

    // 根据 filterText 重建过滤索引列表（空文本/未启用 → 全量）。
    // 级联模式下平铺所有层级、按标签匹配（行上显示完整路径）；
    // 表格模式匹配整行的所有单元格，否则只匹配 label：一张表里
    // 按代码搜和按名称搜同样自然，只认首列会让另一半列形同虚设。
    void RebuildFilter() {
        popupWDirty = true;
        if (!filterable || filterText == "") {
            filteredIdx = null;
            cascadeFilter = null;
            return;
        }
        List<int> r = new List<int>();
        string q = filterText.ToLower();
        if (cascade) {
            // 级联过滤：所有层级的节点都参与匹配，命中项平铺单列展示，
            // 行文本是完整路径。分组标题不参与。
            for (int i = 0; i < opts.Count; i = i + 1) {
                if (opts[i].grp) { continue; }
                if (opts[i].label.ToLower().Contains(q)) { r.Add(i); }
            }
            cascadeFilter = r;
            cascadeCols = null;
            return;
        }
        bool tbl = this.IsTable();
        // 分组标题不参与匹配：只有当它后面（到下一个标题前）有
        // 命中项时才保留，孤立的标题随组一起隐藏。
        int pendingGrp = 0 - 1;
        for (int i = 0; i < opts.Count; i = i + 1) {
            if (opts[i].grp) { pendingGrp = i; continue; }
            bool hit = opts[i].label.ToLower().Contains(q);
            if (!hit && tbl) {
                for (int j = 1; j < this.tableColumns.Count; j = j + 1) {
                    if (opts[i].Cell(j).ToLower().Contains(q)) { hit = true; break; }
                }
            }
            if (hit) {
                if (pendingGrp >= 0) { r.Add(pendingGrp); pendingGrp = 0 - 1; }
                r.Add(i);
            }
        }
        filteredIdx = r;
    }

    // 当前选中下标（-1 无）。
    int Selected() {
        return selected;
    }

    // 选项总数（程序化灌入/对账用）。
    int SelectCount() {
        return opts.Count;
    }

    // 当前选中项的标签（未选中返回空串）。
    string SelectedLabel() {
        return this.OptionLabel(selected);
    }

    // 返回当前选中项的文本标签（与 VirtualList 接口一致）。
    string SelectedText() {
        return this.SelectedLabel();
    }

    // 按文本标签设置选中项
    void SetSelectedByText(string txt) {
        if (txt == "") {
            this.Select(0 - 1);
            return;
        }
        for (int i = 0; i < opts.Count; i = i + 1) {
            if (opts[i].label == txt) {
                this.Select(i);
                return;
            }
        }
    }

    // 多选模式下第 i 项是否被勾选。
    bool IsChosen(int i) {
        if (i < 0 || i >= opts.Count) { return false; }
        return opts[i].chosen;
    }

    // 是否有有效取值（单选已选 / 多选有勾选 / 级联树形有路径文本）。
    bool HasValue() {
        if (multi) {
            for (int i = 0; i < opts.Count; i = i + 1) {
                if (opts[i].chosen) { return true; }
            }
            return false;
        }
        if (pathText != "") { return true; }
        return selected >= 0 && selected < opts.Count;
    }

    // 以编程方式设置选中索引（-1 清除）。保持绑定的
    // model/data 同步，但不触发 Change（调用方发起的更新）。
    void Select(int idx) {
        if (idx < 0) { selected = 0 - 1; return; }
        if (idx >= opts.Count) { return; }
        selected = idx;
        if (model != null) { model.Set(idx); lastModel = idx; }
        if (data != null) { data.Set(idx); lastData = idx; }
    }

    // 清除取值：单选/级联复位选中与路径，多选清全部勾选，
    // 树形清 TreeView 选中（选项列表保留）。
    void Clear() {
        selected = 0 - 1;
        pathText = "";
        treeSelSeen = 0 - 1;
        cascadeCols = null;
        if (treeBox != null) { treeBox.ClearSelection(); }
        for (int i = 0; i < opts.Count; i = i + 1) {
            opts[i].chosen = false;
        }
    }

    // 清空选项集（连同过滤结果与宽度缓存）。远程搜索每次换一批
    // 候选项时需要它。
    void ClearOptions() {
        opts = new List<SelectOption>();
        selected = 0 - 1;
        scrollY = 0;
        filteredIdx = null;
        popupWDirty = true;
    }

    // 选项总数（含分组标题与禁用项）。
    int Count() { return opts.Count; }

    // 触发器显示文本：多选逗号拼接勾选值；级联按当前 showPath
    // 出完整路径或末级短标签；树形用收值时缓存的 payload 文本。
    string Text() {
        if (multi) {
            // 级联多选：按勾选策略取值集合，显示路径或短标签。
            if (cascade) {
                List<string> labs = this.ValueLabels();
                string acc = "";
                for (int i = 0; i < labs.Count; i = i + 1) {
                    if (i > 0) { acc = acc + ", "; }
                    acc = acc + labs[i];
                }
                return acc;
            }
            string acc = "";
            for (int i = 0; i < opts.Count; i = i + 1) {
                if (opts[i].chosen) {
                    if (acc != "") { acc = acc + ", "; }
                    acc = acc + opts[i].label;
                }
            }
            return acc;
        }
        // 级联按当前 showPath 动态出路径/短标签（选择后切换设置也
        // 立即生效）；树形仍用收值时缓存的 payload 文本。
        if (cascade) {
            if (selected >= 0 && selected < opts.Count) {
                return this.ValueText(selected);
            }
            return pathText;
        }
        if (pathText != "") { return pathText; }
        if (selected >= 0 && selected < opts.Count) { return opts[selected].label; }
        return "";
    }

    // 触发器高度（按尺寸档取主题行高）。
    int HeadHeight(Theme t) {
        int sz = this.SizeIdx();
        if (sz == 0) { return t.heightSmall; }
        if (sz == 2) { return t.heightLarge; }
        return t.heightMedium;
    }

    // 触发器字号（按尺寸档取 small/medium/large 档）。
    int FontSize(App app, StyleBox s) {
        int sz = this.SizeIdx();
        if (sz == 0) { return s.FontOr(Style.FontFallback(app, "small")); }
        if (sz == 2) { return s.FontOr(Style.FontFallback(app, "large")); }
        return s.FontOr(Style.FontFallback(app, "medium"));
    }

    // 尺寸档 string → 渲染下标（0 small / 1 medium / 2 large）。
    int SizeIdx() {
        if (Size == null) { return 1; }
        string s = Size.Get();
        if (s == "tiny" || s == "small") { return 0; }
        if (s == "large") { return 2; }
        return 1;
    }

    // 校验状态以额外 class 的形式进入样式层（base.css 的
    // `select.success/.warning/.error` 规则），绘制代码不再直接
    // 覆盖边框颜色。
    string StyleClass() {
        string extra = "";
        if (status == 1) { extra = "success"; }
        if (status == 2) { extra = "warning"; }
        if (status == 3) { extra = "error"; }
        string sz = "";
        if (Size != null) { sz = Control.SizeClass(Size.Get()); }
        if (sz != "") {
            if (extra == "") { extra = sz; } else { extra = extra + " " + sz; }
        }
        if (extra == "") { return Class; }
        if (Class == "") { return extra; }
        return Class + " " + extra;
    }

    // 覆写：高取样式行高（触发器），宽缺省 200。
    override void OnMeasure(App app) {
        StyleBox s = this.ResolveStyleAs(app, "select", Class, Style.SNormal());
        prefH = s.HeightOr(this.HeadHeight(app.theme));
        prefW = s.WidthOr(app.Scale(200));
    }

    // 覆写：保留模式绘制——基于自身盒模型 (bx, by, bw, bh) 完成触发器绘制与事件交互（弹层经 OnPaintOverlay 延迟绘制）。
    override void OnPaint(App app) {
        this.PaintHead(app, bx, by, bw, bh);
    }

    // 以自然（样式/尺寸）高度绘制触发控件。
    void Render(App app, int x, int y, int w) {
        this.RenderIn(app, x, y, w, 0);
    }

    // 在显式盒子内绘制触发控件；即时模式兼容入口：统一走标准 DOM Arrange 与 RenderTree 管线。
    void RenderIn(App app, int x, int y, int w, int hIn) {
        if (w <= 0) {
            if (this.prefW <= 0) { this.OnMeasure(app); }
            w = this.prefW;
        }
        int h = hIn;
        if (h <= 0) {
            if (this.prefH <= 0) { this.OnMeasure(app); }
            h = this.prefH > 0 ? this.prefH : this.HeadHeight(app.theme);
        }
        this.Arrange(x, y, w, h);
        this.RenderTree(app);
    }

    void PaintHead(App app, int x, int y, int w, int hIn) {
        Canvas c = app.canvas;
        Theme t = app.theme;
        this.SyncBinding();

        string cls = this.StyleClass();
        int h = this.HeadHeight(t);
        if (hIn > 0) { h = hIn; }
        StyleBox s = this.ResolveEasedStyleAsIn(
            app, wid, "select", cls, false, open, x, y, w, h);
        h = s.HeightOr(h);
        this.lastH = h;
        int fs = this.FontSize(app, s);
        app.focus.RegisterFocusable(wid);
        app.hitTester.RegisterRect(wid, x, y, w, h, 1);

        int ek = app.EventKind();
        int eb = app.window.EventButton();
        // 触发器按几何判断悬停/点击，因此必须问过弹层：直接读
        // 原始事件时，画在它上面的下拉/菜单/模态的点击会一路
        // 穿透下来，把这个选择框也打开。
        bool leftUp = app.ClickAvailable() && eb == 0;

        bool overHead = Ui.Over(app, x, y, w, h);

        // 有值时的清除按钮几何（箭头左侧）。
        int partState = Style.StateOf(app, wid, false);
        if (open) { partState = partState + Style.SSelected(); }
        StyleBox arrowStyle = this.ResolvePartAs(app, "select", "arrow", "",
                                                 cls, partState);
        StyleBox clearStyle = this.ResolvePartAs(app, "select", "clear", "",
                                                 cls, partState);
        int pad = s.PadLOr(app.Scale(6));
        int padR = s.PadROr(app.Scale(6));
        int slotGap = app.Scale(4);
        int arrowSize = arrowStyle.FontOr(t.iconSizeSmall);
        int clearSize = clearStyle.FontOr(t.iconSizeSmall);
        int arrowX = x + w - padR - arrowSize;
        int arrowSlot = arrowSize + padR;
        int clearX = arrowX - slotGap - clearSize;
        bool showClear = clearable && this.HasValue() && overHead;
        bool overClear = showClear && app.mouseX >= clearX
            && app.mouseX < clearX + clearSize;

        // ---- 触发控件 ----
        // 从样式层解析为 `select` 控件，使皮肤
        // 像 input 一样为其设置样式（`select:hover`、`select:focus` 等）；
        // 校验状态通过 StyleClass 的额外 class 在 CSS 中着色。
        s.Paint(app, x, y, w, h);

        int textY = Canvas.CenterTextY(y, h, fs);
        int rightAnchor = (showClear ? clearX : arrowX) - slotGap;
        int headMaxW = rightAnchor - (x + pad);
        if (headMaxW < 0) { headMaxW = 0; }
        string shown = this.Text();
        StyleBox placeholderStyle = this.ResolvePartAs(app, "select", "placeholder", "",
                                                        cls, partState);
        if (multi && cascade && shown != "") {
            // 级联多选：勾选值渲染成标签芯片（× 可单独移除，
            // 放不下折叠 +N），而不是一长串逗号文本。
            CascaderOverlay.DrawCascadeTags(this, app, c, t, cls, partState, x, y, w, h,
                                             pad, arrowSlot, showClear, clearSize, fs,
                                             leftUp);
        } else if (shown == "") {
            int hintFs = placeholderStyle.FontOr(fs);
            int hintY = Canvas.CenterTextY(y, h, hintFs);
            c.DrawText(x + pad, hintY,
                Ellipsis.Fit(hint, headMaxW, hintFs),
                placeholderStyle.FgOr(s.fg), hintFs);
        } else {
            c.DrawText(x + pad, textY,
                Ellipsis.Fit(shown, headMaxW, fs), s.fg, fs);
        }

        if (showClear) {
            int clearState = Style.SNormal();
            if (open) { clearState = clearState + Style.SSelected(); }
            if (app.focus.IsFocused(wid)) { clearState = clearState + Style.SFocus(); }
            if (overClear) { clearState = clearState + Style.SHover(); }
            if (overClear && app.focus.IsPressed(wid)) {
                clearState = clearState + Style.SActive();
            }
            clearStyle = this.ResolvePartAs(app, "select", "clear", "",
                                            cls, clearState);
            c.DrawGlyphIn("close", clearX, y, clearSize, h,
                clearSize, clearStyle.FgOr(s.fg));
        }
        c.DrawGlyphIn("chevron-down", x + w - arrowSlot, y,
            arrowSlot, h, arrowSize, arrowStyle.FgOr(s.fg));

        // ---- 触发控件输入（仅关闭状态） ----
        // 弹出层自身的点击（选择选项 / 外部关闭）在
        // OnPaintOverlay 中处理，使其在覆盖阶段解析于内容之上。
        // 芯片 × 移除值的点击已在 DrawCascadeTags 里认领，跳过。
        if (leftUp && !open && !app.ClickClaimed()) {
            if (overClear) {
                this.Clear();
                app.RequestRedraw();
            } else if (overHead) {
                this.SetOpen(true);
                // 认领打开时的点击，使刚显示的弹出层不会把
                // 它当作外部按压而在同一帧立即关闭。
                app.ClaimClick();
                app.RequestRedraw();
            }
        }
        On.Fire(app, wid, this);

        // 将选项列表推迟到覆盖阶段：随后它绘制在所有
        // 在此控件之后绘制的控件（无遮挡），并注册最顶层
        // 命中区域（不穿透点击）。参见 OnPaintOverlay。
        trigX = x;
        trigY = y;
        trigW = w;
        if (open) {
            app.AddOverlay(OverlayPopup.Host(this));
        }
    }

    // 弹层宽度：不窄于触发器，但至少能放下最长的一条；
    // 多列时按列数等宽扩开。按触发器宽度开弹层会把每一条
    // 都截成同一个前缀，选项之间看不出区别。
    // 结果缓存在 popupW 里，只有选项集或过滤词变了才重新量：这段
    // 要遍历全部标签，而它每帧都被调用一次。一万条选项时那是每帧
    // 一万次 MeasureText —— 比画出来的十几行本身贵上三个数量级，
    // 也是长列表下拉「一开就卡」的真正来源（虚表只省了绘制）。
    int PopupWidth(App app, Theme t, int trigWidth, int fs, int arrowSlot) {
        if (this.IsTable()) {
            int sum = t.paddingSmall * 2;
            for (int i = 0; i < this.tableColumns.Count; i = i + 1) {
                sum = sum + this.tableColumns[i].width;
            }
            if (sum < trigWidth) { sum = trigWidth; }
            int roomT = app.canvas.Width() - app.Scale(8);
            if (sum > roomT) { sum = roomT; }
            return sum;
        }
        if (!popupWDirty && popupW > 0) {
            int w0 = popupW;
            if (w0 < trigWidth) { w0 = trigWidth; }
            return w0;
        }
        int n = this.ColumnCount();
        int colW = trigWidth / n;
        int chrome = t.paddingSmall * 2 + arrowSlot;
        for (int i = 0; i < opts.Count; i = i + 1) {
            int tw = Canvas.MeasureText(opts[i].label, fs) + chrome;
            if (tw > colW) { colW = tw; }
        }
        int w = colW * n;
        if (w < trigWidth) { w = trigWidth; }
        int room = app.canvas.Width() - app.Scale(8);
        if (w > room) { w = room; }
        popupW = w;
        popupWDirty = false;
        return w;
    }

    // 搜索框高度（filterable=true 时占用的顶部空间）。
    int FilterBarH(App app) {
        if (!filterable) { return 0; }
        return app.Scale(32);
    }

    // 过滤后参与渲染的选项索引（filterable + 关键词非空才过滤）。
    List<int> VisibleOpts() {
        if (!filterable || filterText == "") { return null; }
        if (filteredIdx == null) { this.RebuildFilter(); }
        if (filteredIdx == null) { return null; }
        return filteredIdx;
    }

    // 延迟弹层：在 App.RunOverlays 中、所有内容绘制完成后绘制并派发事件。
    // 插槽支持：允许在 HTML 或代码中为 SelectBox 注入任意自定义弹层组件（如 Table、TreeView、Card）
    public override bool MountSlot(string slot, Control c) {
        if (slot == "popup" || slot == "dropdown" || slot == "content") {
            this.SetPopupContent(c);
            return true;
        }
        return base.MountSlot(slot, c);
    }

    public void SetPopupContent(Control c) {
        this.customPopup = c;
        if (c != null && !children.Contains(c)) {
            this.Add(c);
        }
    }

    public Control GetPopupContent() {
        return this.customPopup;
    }

    // 覆盖层绘制：如果有自定义插槽内容，直接绘制互嵌组件；
    // 否则按模式分发给 CascaderOverlay、TreeOverlay 或 SelectDropdownOverlay。
    override void OnPaintOverlay(App app) {
        if (!open) { return; }
        if (this.customPopup != null) {
            OverlayHost.ShowPopup(app, this, this.customPopup);
            this.customPopup.RenderTree(app);
            return;
        }

        int h = this.lastH;
        if (h <= 0) { h = computedStyle.HeightOr(this.HeadHeight(app.theme)); }
        int fs = this.FontSize(app, computedStyle);
        StyleBox arrowStyle = this.ResolvePartAs(app, "select", "arrow", "",
                                                 Class, Style.SSelected());
        int arrowSlot = arrowStyle.WidthOr(app.theme.paddingLarge + app.theme.iconSizeSmall);

        if (this.cascade) {
            this.CascadeOverlay(app, trigX, trigY, trigW, h, fs, arrowSlot);
            return;
        }
        if (this.treeMode) {
            this.TreeOverlay(app, trigX, trigY, trigW, h);
            return;
        }
        SelectDropdownOverlay.Render(this, app);
    }
}
