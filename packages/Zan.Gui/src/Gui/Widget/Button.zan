using System;
using Gui;
namespace Gui.Widget;
[GuiKind("Button")]
public class Button : Control {
    public override Control CreateCloneShell() { return new Button(); }
    public Binding<string> Text;
    public string Icon;
    public Binding<bool> Checked;
    public int wid { get { return this.WidgetId(); } set { this.commonId = value; } }
    public int corners;
    public Binding<int> Color;
    public Binding<int> TextColor;
    public bool Tertiary;
    public bool Quaternary;
    public bool Strong;
    public string IconPlacement;
    private Label generatedCaption;
    private IconView generatedIcon;
    private bool ownsColorProjection;
    private bool ownsTextColorProjection;
    public Binding<string> Size;
    public override int StyleDisplay() { return 1; } // CSS display: flex
    public override int PointerCursor() { return 0; }
    public override int StyleFlexDir() {
        return Style.Has(Class, "stacked") ? 1 : 0; // 0=row, 1=column
    }
    private void InitButton(string label) {
        this.InitControl(label);
        Text = label;
        Icon = "";
        Checked = false;
        Tip = "";
        corners = Corner.All();
        wiresOwnEvents = false;
        Color = 0;
        TextColor = 0;
        Tertiary = false;
        Quaternary = false;
        Strong = false;
        IconPlacement = "";
        Size = "medium";
        if (label != "") { this.AddCaption(label); }
    }
    private void AddCaption(string text) {
        generatedCaption = new Label(text);
        generatedCaption.ClassName = "button-caption";
        this.Add(generatedCaption);
    }
    public Button() { InitButton(""); }
    public Button(string label) { InitButton(label); }
    public Button(Control content) : this("") {
        if (content != null) { this.With(content); }
    }
    public void Primary() { this.AddClass("primary"); }
    public void Secondary() { this.AddClass("secondary"); }
    public void Success() { this.AddClass("success"); }
    public void Warning() { this.AddClass("warning"); }
    public void Danger() { this.AddClass("error"); }
    public void Small() { this.AddClass("small"); }
    public void Large() { this.AddClass("large"); }
    public void Ghost() { this.AddClass("ghost"); }
    public string Label() {
        if (Text == null) { return ""; }
        return Text.Get();
    }
    public void SetText(string v) {
        if (Text != null) { Text.Set(v); } else { Text = v; }
        this.SyncRetainedAppearance();
        this.Invalidate();
    }
    public bool IsChecked() { return Checked != null ? Checked.Get() : false; }
    public bool IsToggle() { return Checked != null && Checked.IsLive(); }
    public override string TipText() {
        if (Tip == "") { return this.Label(); }
        if (this.Label() == "") { return Tip; }
        return this.Label() + "\n" + Tip;
    }
    public StyleBox ResolvedStyle() { return this.ResolvedStyle(this.App); }
    public StyleBox ResolvedStyle(App app) { app = this.ResolveApp(app); return this.Box(app); }
    public override string Kind() { return "Button"; }
    public override Binding<string> SizeOf() { return Size; }
    public override string EffectiveClass() { return this.SizeClassIn(Class); }
    protected override List<PropSpec> DefineProps() {
        List<PropSpec> ps = new List<PropSpec>();
        ps.Add(PropSpec.Text("text", "Text").Field("Text", 0).Also("data").Also("value"));
        ps.Add(PropSpec.Text("icon", "Icon").Field("Icon", 0));
        ps.Add(PropSpec.Text("tip", "Tip").Field("Tip", 0));
        ps.Add(PropSpec.Text("tipSide", "Tip side").Field("TipSide", 0));
        ps.Add(PropSpec.Text("iconPlacement", "Icon placement").Field("IconPlacement", 0));
        ps.Add(PropSpec.Color("color", "Color").Field("Color", 1));
        ps.Add(PropSpec.Color("textColor", "Text color").Field("TextColor", 1));
        ps.Add(this.SizeProp());
        ps.Add(PropSpec.Bool("disabled", "Disabled").Field("Disabled", 2));
        ps.Add(PropSpec.Bool("checked", "Checked").Field("Checked", 2));
        ps.Add(PropSpec.Bool("tertiary", "Tertiary").Field("Tertiary", 2));
        ps.Add(PropSpec.Bool("quaternary", "Quaternary").Field("Quaternary", 2));
        ps.Add(PropSpec.Bool("strong", "Strong").Field("Strong", 2));
        return ps;
    }
    public override void CloneContentTo(Control target, CloneTreeFn clone) {
        Button copy = (Button)target;
        copy.RemoveAll();
        copy.generatedCaption = null;
        copy.generatedIcon = null;
        for (int i = 0; i < this.ChildCount(); i = i + 1) {
            Control child = this.ChildAt(i);
            if (child == generatedIcon) { continue; }
            Control next = clone(child);
            if (next == null) { continue; }
            if (child == generatedCaption) { copy.generatedCaption = (Label)next; }
            copy.Add(next);
        }
        copy.SyncRetainedAppearance();
    }
    public override void SetProp(string key, string val) {
        if (key == "text" || key == "data" || key == "value") {
            if (Text != null) { Text.Set(val); } else { Text = val; }
            this.SyncRetainedAppearance();
            this.Invalidate();
            return;
        }
        if (key == "type") {
            this.SetClassIn("default primary info success warning error", val);
            return;
        }
        if (key == "size") {
            this.SetClassIn("tiny small medium large", val);
            return;
        }
        base.SetProp(key, val);
        if (key == "icon" || key == "iconPlacement" || key == "color" || key == "textColor") {
            this.SyncRetainedAppearance();
        }
    }
    public override void OnClick(RoutedEventArgs e) {
        if (this.IsDisabled()) { return; }
        e.Handle();
    }
    public override void OnKeyDown(RoutedEventArgs e) {
        if (e.originalSource == this && !e.handled && !this.IsDisabled()
            && (e.keyCode == 13 || e.keyCode == 32)) {
            this.RouteKeyboardClick(e);
            e.Handle();
            return;
        }
        base.OnKeyDown(e);
    }
    public override void OnPointerDown(RoutedEventArgs e) {
        if (this.IsDisabled()) { return; }
        base.OnPointerDown(e);
        App a = this.FindApp();
        if (a != null && a.GetCapturedPointer() == null) {
            a.CapturePointer(this);
            a.RequestRedraw();
        }
    }
    public override void OnPointerUp(RoutedEventArgs e) {
        base.OnPointerUp(e);
        App a = this.FindApp();
        if (a != null && a.GetCapturedPointer() == this) {
            a.ReleasePointerCapture();
            a.RequestRedraw();
        }
    }
    public override void OnPointerEnter(RoutedEventArgs e) {
        base.OnPointerEnter(e);
        App a = this.FindApp();
        if (a != null) { a.RequestRedraw(); }
    }
    public override void OnPointerLeave(RoutedEventArgs e) {
        base.OnPointerLeave(e);
        App a = this.FindApp();
        if (a != null) { a.RequestRedraw(); }
    }
    public override void TriggerEvent(string evt) {
        if (evt == "Click") {
            if (this.IsDisabled()) { return; }
            if (this.IsToggle()) { Checked.Set(!this.IsChecked()); }
            Click.PostS(this);
            App a = this.FindApp();
            if (a != null && a.window != null) { a.window.Wake(); }
            return;
        }
        base.TriggerEvent(evt);
    }
    private void SyncRetainedAppearance() {
        if (generatedCaption != null && generatedCaption.parent != this) { generatedCaption = null; }
        if (generatedIcon != null && generatedIcon.parent != this) { generatedIcon = null; }
        string caption = this.Label();
        if (generatedCaption == null && caption != "") {
            this.AddCaption(caption);
        } else if (generatedCaption != null && generatedCaption.GetText() != caption) {
            if (generatedCaption.Text != null) { generatedCaption.Text.Set(caption); }
            else { generatedCaption.Text = caption; }
        }
        if (Icon == "") {
            if (generatedIcon != null) {
                this.Remove(generatedIcon);
                generatedIcon = null;
            }
        } else {
            if (generatedIcon == null) {
                generatedIcon = new IconView(Icon);
                generatedIcon.ClassName = "button-icon";
            }
            if (generatedIcon.Name != Icon) { generatedIcon.Name = Icon; }
            int wanted = IconPlacement == "right" ? this.ChildCount() - 1 : 0;
            if (generatedIcon.parent != this) {
                this.InsertAt(IconPlacement == "right" ? this.ChildCount() : 0, generatedIcon);
            } else if (this.IndexOf(generatedIcon) != wanted) {
                this.MoveChild(generatedIcon, wanted);
            }
        }
        int background = Color != null ? Color.Get() : 0;
        int foreground = TextColor != null ? TextColor.Get() : 0;
        if (background != 0 || ownsColorProjection) {
            if (styleBg != background || styleBgTo != 0) {
                styleBg = background; styleBgTo = 0; computedStyle = null;
            }
            ownsColorProjection = background != 0;
        }
        if (foreground != 0 || ownsTextColorProjection) {
            if (styleColor != foreground) { styleColor = foreground; computedStyle = null; }
            if (generatedCaption != null && generatedCaption.styleColor != foreground) {
                generatedCaption.styleColor = foreground; generatedCaption.computedStyle = null;
            }
            if (generatedIcon != null && generatedIcon.styleColor != foreground) {
                generatedIcon.styleColor = foreground; generatedIcon.computedStyle = null;
            }
            ownsTextColorProjection = foreground != 0;
        }
    }
    public override void SyncBinding() {
        base.SyncBinding();
        this.SyncRetainedAppearance();
        if (Tertiary) { this.AddClass("tertiary"); }
        if (Quaternary) { this.AddClass("quaternary"); }
        if (Strong) { this.AddClass("strong"); }
    }
    public override void OnMeasure(App app) {
        if (app == null) { return; }
        string cls = this.EffectiveClass();
        if (Style.Has(cls, "stacked") || Style.Has(cls, "tag-close") || Style.Has(cls, "ribbon-cmd")) { return; }
        if (!this.StyleDeclaresHeight() && prefH <= 0) {
            prefH = app.Scale(app.theme.heightMedium);
            this.fillH = true;
        }
    }
    public override int InputFocusCapabilities() { return 1; }
    public int AutoHeight(App app) {
        if (app == null) { return 28; }
        return app.Scale(28);
    }
    public int AutoWidth(App app) {
        if (app == null) { return 60; }
        return app.Scale(60);
    }
}
