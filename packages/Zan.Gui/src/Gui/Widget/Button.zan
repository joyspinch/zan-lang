using System;
using Gui;

namespace Gui.Widget;

// 按钮组件。纯 Flex 弹性容器，支持图文与子组件自由互嵌。
//
// 基础用法：
//   Button btn = new Button("保存").Primary();
//   btn.Click += () => { Save(); };
//
// 复合互嵌（DOM 组合）：
//   Button custom = new Button().With(new IconView("star")).With(new Label("收藏"));
//
// 样式类（由皮肤控制盒模型与视觉）：
//   .primary .info .success .warning .error  (语义角色)
//   .secondary .ghost .dashed .outline       (视觉变体)
//   .tiny .small .medium .large              (尺寸档位)
//   .stacked                                 (纵向堆叠排布)
public class Button : Control {
    public Binding<string> Text;
    public Binding<string> data { get { return Text; } set { Text = value; } }
    public string Icon;
    public Binding<bool> Checked;
    public int wid { get { return this.WidgetId(); } set { this.commonId = value; } }
    public bool clicked;
    public int corners;

    public Binding<int> Color;
    public Binding<int> TextColor;
    public bool Tertiary;
    public bool Quaternary;
    public bool Strong;
    public string IconPlacement;
    public Binding<string> Size;

    public override int StyleDisplay() { return 1; } // CSS display: flex
    public override int StyleFlexDir() {
        return Style.Has(Class, "stacked") ? 1 : 0; // 0=row, 1=column
    }

    private void InitButton(string label) {
        this.InitControl(label, 1);
        Text = label;
        Icon = "";
        Checked = false;
        Tip = "";
        clicked = false;
        corners = Corner.All();
        wiresOwnEvents = false;
        Color = 0;
        TextColor = 0;
        Tertiary = false;
        Quaternary = false;
        Strong = false;
        IconPlacement = "";
        Size = "medium";

        if (label != "") {
            this.Add(new Label(label));
        }
    }

    public Button() { InitButton(""); }
    public Button(string label) { InitButton(label); }
    public Button(Control content) : this("") {
        if (content != null) {
            this.With(content);
        }
    }

    public Button Primary() { this.AddClass("primary"); return this; }
    public Button Secondary() { this.AddClass("secondary"); return this; }
    public Button Success() { this.AddClass("success"); return this; }
    public Button Warning() { this.AddClass("warning"); return this; }
    public Button Danger() { this.AddClass("error"); return this; }
    public Button Small() { this.AddClass("small"); return this; }
    public Button Large() { this.AddClass("large"); return this; }
    public Button Ghost() { this.AddClass("ghost"); return this; }

    public string Label() {
        if (Text == null) { return ""; }
        return Text.Get();
    }

    public void SetText(string v) {
        Text = v;
        if (children.Count > 0 && children[children.Count - 1] is Label) {
            ((Label)children[children.Count - 1]).Text = v;
        } else if (v != "") {
            this.Add(new Label(v));
        }
    }

    public bool IsChecked() { return Checked != null ? Checked.Get() : false; }
    public bool IsToggle() { return Checked != null && Checked.IsLive(); }
    public bool WasClicked() { return clicked; }
    public override bool Fired() { return clicked; }

    public override string TipText() {
        if (Tip == "") { return this.Label(); }
        if (this.Label() == "") { return Tip; }
        return this.Label() + "\n" + Tip;
    }

    public StyleBox ResolvedStyle() { return this.ResolvedStyle(this.App); }
    public StyleBox ResolvedStyle(App app) {
        app = this.ResolveApp(app);
        string origClass = Class;
        this.ApplySizeClass();
        StyleBox s = this.ResolveStyleCached(app, "button", Class, Style.SNormal());
        Class = origClass;
        return s;
    }

    public override string Kind() { return "Button"; }
    public override Binding<string> SizeOf() { return Size; }

    public override List<PropSpec> Props() {
        List<PropSpec> ps = new List<PropSpec>();
        PropSpec text = PropSpec.Text("text", "Text");
        text.str = Text;
        text.Also("data");
        text.Also("value");
        ps.Add(text);
        PropSpec icon = PropSpec.Text("icon", "Icon");
        icon.str = Icon;
        ps.Add(icon);
        PropSpec tip = PropSpec.Text("tip", "Tip");
        tip.str = Tip;
        ps.Add(tip);
        ps.Add(this.SizeProp());
        PropSpec off = PropSpec.Bool("disabled", "Disabled");
        off.flag = Disabled;
        ps.Add(off);
        PropSpec on = PropSpec.Bool("checked", "Checked");
        on.flag = Checked;
        ps.Add(on);
        PropSpec tri = PropSpec.Bool("tertiary", "Tertiary");
        tri.flag = Tertiary;
        ps.Add(tri);
        PropSpec qua = PropSpec.Bool("quaternary", "Quaternary");
        qua.flag = Quaternary;
        ps.Add(qua);
        PropSpec strg = PropSpec.Bool("strong", "Strong");
        strg.flag = Strong;
        ps.Add(strg);
        return ps;
    }

    public override List<string> Events() {
        return Control.CommonEvents();
    }

    public override void BindEvent(string evt, Action a) {
        if (evt == "Click") { Click.Add(a); return; }
        On.AddByName(evt, a);
    }

    public override void BindEventS(string evt, ControlEvent a) {
        if (evt == "Click") { Click.AddS(a); return; }
        On.AddByNameS(evt, a);
    }

    public override void SetProp(string key, string val) {
        if (key == "type") {
            this.SetClassIn("default primary info success warning error", val);
            return;
        }
        if (key == "size") {
            this.SetClassIn("tiny small medium large", val);
            return;
        }
        base.SetProp(key, val);
    }

    public override void OnClick(RoutedEventArgs e) {
        if (this.IsDisabled()) { return; }
        e.Handle();
    }

    public override void OnPointerDown(RoutedEventArgs e) {
        if (this.IsDisabled()) { return; }
        base.OnPointerDown(e);
        App a = this.FindApp();
        if (a != null) {
            a.CapturePointer(this);
            a.RequestRedraw();
        }
    }

    public override void OnPointerUp(RoutedEventArgs e) {
        base.OnPointerUp(e);
        App a = this.FindApp();
        if (a != null) {
            a.ReleasePointerCapture();
            a.RequestRedraw();
        }
    }

    public override void OnPointerEnter(RoutedEventArgs e) {
        base.OnPointerEnter(e);
        App a = this.FindApp();
        if (a != null) { a.RequestRedraw(); }
    }

    public override void OnPointerLeave(RoutedEventArgs e) {
        base.OnPointerLeave(e);
        App a = this.FindApp();
        if (a != null) { a.RequestRedraw(); }
    }

    public override void FireCommon(App app) {
        if (this.IsDisabled()) { return; }
        if (bw <= 0 || bh <= 0) { return; }
        int id = this.CommonId();
        string a11y = this.EffectiveA11yRole("button") + ":" + this.EffectiveA11yLabel(this.Label());
        app.hitTester.RegisterRectL(id, bx, by, bw, bh, 0, a11y);
        On.Fire(app, id, this);
    }

    public override void TriggerEvent(string evt) {
        if (evt == "Click") {
            if (this.IsDisabled()) { return; }
            clicked = true;
            if (this.IsToggle()) { Checked.Set(!this.IsChecked()); }
            Click.PostS(this);
            App a = this.FindApp();
            if (a != null && a.window != null) { a.window.Wake(); }
            return;
        }
        base.TriggerEvent(evt);
    }

    public override void SyncBinding() {
        base.SyncBinding();
        if (Tertiary) { this.AddClass("tertiary"); }
        if (Quaternary) { this.AddClass("quaternary"); }
        if (Strong) { this.AddClass("strong"); }
        this.ApplySizeClass();
    }

    public override int InputFocusCapabilities() { return 1; }

    public override void OnPaint(App app) {
        int id = this.CommonId();
        app.focus.RegisterFocusable(id, this);
    }

    public int AutoHeight(App app) {
        if (app == null) { return 28; }
        return app.Scale(28);
    }

    public int AutoWidth(App app) {
        if (app == null) { return 60; }
        return app.Scale(60);
    }

    public int Render(App app, int x, int y, int w) {
        return this.Render(app, x, y, w, this.AutoHeight(app));
    }

    public int Render(App app, int x, int y, int w, int h) {
        if (this.children.Count == 0 && this.Text != null && this.Text.Get() != "") {
            this.Add(new Label(this.Text.Get()));
        }
        this.bx = x;
        this.by = y;
        this.bw = w;
        this.bh = h;
        this.Arrange(x, y, w, h);
        this.RenderTree(app);
        return this.CommonId();
    }
}
