using System;
using Gui;

namespace Gui.Widget;

// 弹性占位原语（对齐 SwiftUI Spacer / Flutter Spacer）。
// 放入 Row 或 Column 中自动填满剩余可用空间，实现首尾分离排版（如左标题、右操作），
// 彻底消灭手算坐标与绝对定位。
public class Spacer : Control {
    public Spacer() {
        InitControl("spacer", 5);
        this.grow = true;
        this.AddClass("grow");
    }

    public static Spacer Create() {
        return new Spacer();
    }

    public override string Kind() { return "Spacer"; }

    public override List<PropSpec> Props() {
        List<PropSpec> ps = new List<PropSpec>();
        ps.Add(this.SizeProp());
        return ps;
    }

    // 纯布局弹簧，不产生绘制命令
    public override void OnPaint(App app) { }
}
