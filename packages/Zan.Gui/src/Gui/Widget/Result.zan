using System;
using Gui;
namespace Gui.Widget;
[GuiKind("Result")]
public class Result : Control {
    public override Control CreateCloneShell() { return new Result(); }
    private Panel addedContent;
    public Binding<string> Text;
    public Binding<string> Desc;
    public string Icon;
    public Control extraSlot;
    private string appliedIcon = "";
    private string appliedText = "";
    private string appliedDesc = "";
    private Control appliedExtra = null;
    public override int StyleDisplay() { return 1; } // CSS display: flex
    public override int StyleFlexDir() { return 1; } // flex-direction: column
    private void InitResult(string ttl, string ds) {
        this.InitControl(ttl);
        Text = ttl;
        Desc = ds;
        Icon = "";
        Class = "info align-center justify-center gap-medium";
        extraSlot = null;
        this.RebuildStructure();
    }
    public Result() { InitResult("", ""); }
    public Result(string ttl, string ds) { InitResult(ttl, ds); }
    public static Result Create(string status, string title) {
        Result r = new Result(title, "");
        r.Status(status);
        return r;
    }
    public string StatusKind {
        get { return Class; }
        set { this.Status(value != null ? value : "info"); }
    }
    public string TitleText {
        get { return this.Label(); }
        set { this.Title(value != null ? value : ""); }
    }
    public string DescriptionText {
        get { return this.Description(); }
        set { this.Description(value != null ? value : ""); }
    }
    public Control ExtraContent {
        get { return extraSlot; }
        set { this.Extra(value); }
    }
    public List<Control> ActionButtons {
        get {
            if (extraSlot == null) { return new List<Control>(); }
            return extraSlot.SnapshotChildren();
        }
        set { this.Actions(value); }
    }
    public void Status(string stat) {
        Class = stat + " align-center justify-center gap-medium";
        this.RebuildStructure();
    }
    public void Title(string title) {
        Text = title;
        this.RebuildStructure();
    }
    public void Description(string desc) {
        Desc = desc;
        this.RebuildStructure();
    }
    public void Extra(Control extra) {
        addedContent = null;
        extraSlot = extra;
        this.RebuildStructure();
    }
    public void Actions(List<Control> actions) {
        if (actions == null || actions.Count == 0) { this.Extra(null); return; }
        Flex row = new Flex();
        row.ClassName = "row align-center justify-center gap-medium";
        for (int i = 0; i < actions.Count; i = i + 1) {
            row.Add(actions[i]);
        }
        this.Extra(row);
    }
    public Control GetExtra() { return extraSlot; }
    public string Label() {
        if (Text == null) { return ""; }
        return Text.Get();
    }
    public string Description() {
        if (Desc == null) { return ""; }
        return Desc.Get();
    }
    public void RebuildStructure() {
        this.RemoveAll();
        string glyph = Icon;
        if (glyph == "") { glyph = Result.GlyphOf(Class); }
        string title = this.Label();
        string desc = this.Description();
        appliedIcon = glyph;
        appliedText = title;
        appliedDesc = desc;
        appliedExtra = extraSlot;
        Flex iconCircle = new Flex();
        iconCircle.ClassName = "result-disc row align-center justify-center";
        iconCircle.Add(new IconView(glyph, 36) { ClassName = "result-icon" });
        base.Add(iconCircle);
        if (title != "") {
            Label lbl = new Label(title);
            lbl.ClassName = "result-title";
            base.Add(lbl);
        }
        if (desc != "") {
            Label descLbl = new Label(desc);
            descLbl.ClassName = "result-desc";
            base.Add(descLbl);
        }
        if (extraSlot != null) { base.Add(extraSlot); }
    }
    public static string StatusClass(int status) { return Style.TypeClass(status + 2); }
    public static string GlyphOf(string cls) {
        string role = Style.RoleClass(cls);
        if (role == "" || role == "primary") { return "info"; }
        return role;
    }
    public override bool MountSlot(string slot, Control c) {
        if (slot == "extra" || slot == "action" || slot == "actions") {
            this.Extra(c);
            return true;
        }
        return base.MountSlot(slot, c);
    }
    public override Control Add(Control child) {
        if (child == null) { return null; }
        if (!this.Adoptable(child)) { return child; }
        if (child.slotName != "" && this.MountSlot(child.slotName, child)) { return child; }
        if (addedContent == null) {
            addedContent = Panel.Column();
            if (extraSlot != null) { addedContent.Add(extraSlot); }
            extraSlot = addedContent;
        }
        addedContent.Add(child);
        this.RebuildStructure();
        return child;
    }
    public override void SetProp(string key, string val) {
        string k = key.ToLower();
        if (k == "status") { this.Status(val); return; }
        if (k == "title" || k == "text") { this.Title(val); return; }
        if (k == "description" || k == "desc") { this.Description(val); return; }
        base.SetProp(key, val);
    }
    public override void CloneContentTo(Control target, CloneTreeFn clone) {
        if (addedContent != null) {
            for (int i = 0; i < addedContent.ChildCount(); i = i + 1) {
                target.Add(clone(addedContent.ChildAt(i)));
            }
        } else if (extraSlot != null) {
            Control extra = clone(extraSlot);
            if (extra != null) { ((Result)target).Extra(extra); }
        }
    }
    public override string Kind() { return "Result"; }
    protected override List<PropSpec> DefineProps() {
        List<PropSpec> ps = new List<PropSpec>();
        ps.Add(PropSpec.Text("text", "Text").Field("Text", 0));
        ps.Add(PropSpec.Text("desc", "Description").Field("Desc", 0));
        ps.Add(PropSpec.Text("icon", "Icon").Field("Icon", 0));
        return ps;
    }
    public override bool SetExtra(string key, string val) {
        if (key != "status") { return false; }
        Class = Result.StatusClass(Convert.ToInt32(val));
        this.RebuildStructure();
        return true;
    }
    public override void SyncBinding() {
        base.SyncBinding();
        string glyph = Icon != "" ? Icon : Result.GlyphOf(Class);
        if (appliedIcon != glyph || appliedText != this.Label() || appliedDesc != this.Description() || appliedExtra != extraSlot) {
            this.RebuildStructure();
        }
    }
}
