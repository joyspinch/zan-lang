using System;
using Gui;

namespace Gui.Widget;

// 结果页：纯 Flex 居中纵向容器，由大圆盘图标、标题、描述与操作按钮组声明式子节点复合而成。
// 彻底物理消除手算坐标（bx, by, disc, DrawTextCentered, ActionsY）与手动 Arrange 覆写。
public class Result : Control {
    private Panel addedContent;
    public Binding<string> Text;
    public Binding<string> Desc;
    public string Icon;
    public Control extraSlot;

    public override int StyleDisplay() { return 1; } // CSS display: flex
    public override int StyleFlexDir() { return 1; } // flex-direction: column

    private void InitResult(string ttl, string ds) {
        this.InitControl(ttl, 1);
        Text = ttl;
        Desc = ds;
        Icon = "";
        Class = "info align-center justify-center gap-medium";
        extraSlot = null;
        this.RebuildStructure();
    }

    public Result() { InitResult("", ""); }
    public Result(string ttl, string ds) { InitResult(ttl, ds); }

    public static Result Create(string status, string title) {
        Result r = new Result(title, "");
        r.Status(status);
        return r;
    }

    public Result Status(string stat) {
        Class = stat + " align-center justify-center gap-medium";
        this.RebuildStructure();
        return this;
    }

    public Result Title(string title) {
        Text = title;
        this.RebuildStructure();
        return this;
    }

    public Result Description(string desc) {
        Desc = desc;
        this.RebuildStructure();
        return this;
    }

    public Result Extra(Control extra) {
        addedContent = null;
        extraSlot = extra;
        this.RebuildStructure();
        return this;
    }

    public Result Actions(List<Control> actions) {
        if (actions == null || actions.Count == 0) {
            return this.Extra(null);
        }
        Flex row = new Flex();
        row.ClassName = "row align-center justify-center gap-medium";
        for (int i = 0; i < actions.Count; i = i + 1) {
            row.Add(actions[i]);
        }
        return this.Extra(row);
    }

    public Control GetExtra() {
        return extraSlot;
    }

    public string Label() {
        if (Text == null) { return ""; }
        return Text.Get();
    }

    public string Description() {
        if (Desc == null) { return ""; }
        return Desc.Get();
    }

    public void RebuildStructure() {
        this.RemoveAll();

        string glyph = Icon;
        if (glyph == "") { glyph = Result.GlyphOf(Class); }

        // 1. 图标容器（圆盘底）
        Flex iconCircle = new Flex();
        iconCircle.ClassName = "result-disc row align-center justify-center";
        iconCircle.Add(new IconView(glyph, 36) { ClassName = "result-icon" });
        base.Add(iconCircle);

        // 2. 主标题
        string title = this.Label();
        if (title != "") {
            Label lbl = new Label(title);
            lbl.ClassName = "result-title";
            base.Add(lbl);
        }

        // 3. 描述文本
        string desc = this.Description();
        if (desc != "") {
            Label descLbl = new Label(desc);
            descLbl.ClassName = "result-desc";
            base.Add(descLbl);
        }

        // 4. 操作插槽
        if (extraSlot != null) {
            base.Add(extraSlot);
        }
    }

    public static string StatusClass(int status) {
        return Style.TypeClass(status + 2);
    }

    public static string GlyphOf(string cls) {
        string role = Style.RoleClass(cls);
        if (role == "" || role == "primary") { return "info"; }
        return role;
    }

    public override bool MountSlot(string slot, Control c) {
        if (slot == "extra" || slot == "action" || slot == "actions") {
            this.Extra(c);
            return true;
        }
        return base.MountSlot(slot, c);
    }

    public override Control Add(Control child) {
        if (child == null) { return null; }
        if (!this.Adoptable(child)) { return child; }
        if (child.slotName != "" && this.MountSlot(child.slotName, child)) {
            return child;
        }
        if (addedContent == null) {
            addedContent = Panel.Column();
            if (extraSlot != null) { addedContent.Add(extraSlot); }
            extraSlot = addedContent;
        }
        addedContent.Add(child);
        this.RebuildStructure();
        return child;
    }

    public override void SetProp(string key, string val) {
        string k = key.ToLower();
        if (k == "status") { this.Status(val); return; }
        if (k == "title" || k == "text") { this.Title(val); return; }
        if (k == "description" || k == "desc") { this.Description(val); return; }
        base.SetProp(key, val);
    }

    public override void CloneContentTo(Control target, CloneTreeFn clone) {
        if (addedContent != null) {
            for (int i = 0; i < addedContent.children.Count; i = i + 1) {
                target.Add(clone(addedContent.children[i]));
            }
        } else if (extraSlot != null) {
            Control extra = clone(extraSlot);
            if (extra != null) { ((Result)target).Extra(extra); }
        }
    }

    public override string Kind() { return "Result"; }

    public override List<PropSpec> Props() {
        List<PropSpec> ps = new List<PropSpec>();
        PropSpec text = PropSpec.Text("text", "Text");
        text.str = Text;
        text.AsName();
        ps.Add(text);
        PropSpec desc = PropSpec.Text("desc", "Description");
        desc.str = Desc;
        ps.Add(desc);
        PropSpec icon = PropSpec.Text("icon", "Icon");
        icon.str = Icon;
        ps.Add(icon);
        return ps;
    }

    public override bool SetExtra(string key, string val) {
        if (key != "status") { return false; }
        Class = Result.StatusClass(Convert.ToInt32(val));
        this.RebuildStructure();
        return true;
    }
}
