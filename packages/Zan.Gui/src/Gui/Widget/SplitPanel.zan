using System;
using Gui;

namespace Gui.Widget;

// 保留式两栏容器，中间是可拖拽的分隔条——IDE / 上位机
// 外壳的基本骨架（导航树 | 编辑区，画面 | 报警列表）。
// 与立即模式的 <see cref="Split"/> 不同，它是控件树里的一个
// 节点：两个窗格是它的子控件，宿主（或窗口设计器）往
// `First()` / `Second()` 里添加内容即可，分栏尺寸由控件自己
// 跨帧持有。
// 拖动分隔条改变第一个窗格的尺寸（垂直分隔条改宽度，
// 水平分隔条改高度），受 MinSizes() 限制。
public class SplitPanel : Control {
    // 0 = 垂直分隔条（左 | 右），1 = 水平分隔条（上 | 下）。
    private int orient;
    // 第一个窗格的尺寸（px，未缩放的逻辑像素由调用方决定），
    // 是信号以便别处绑定/持久化。
    private SignalInt firstSize;
    // 两个窗格各自允许的最小尺寸（px，默认 60），拖拽下限。
    private int minFirst;
    private int minSecond;
    private Panel firstPane;
    private Panel secondPane;
    private bool dragging;
    // Arrange 产生的分隔条矩形，绘制与输入共用。
    public int handleX;
    public int handleY;
    public int handleW;
    public int handleH;

    // 分隔条方向常量：0 = 垂直分隔条（左 | 右），1 = 水平（上 | 下）。
    // 传给构造器或 Orient()。
    public static int Vertical() { return 0; }
    // 方向常量：1 = 水平分隔条（上 | 下）。
    public static int Horizontal() { return 1; }

    // 各构造器的公共初始化：注册 "split" 控件、设方向与首格尺寸，
    // 建出两个透明窗格并挂为子项。
    private void InitSplitPanel(int o, int size) {
        this.InitControl("split", 5);
        orient = o;
        firstSize = new SignalInt(size);
        minFirst = 60;
        minSecond = 60;
        dragging = false;
        handleX = 0;
        handleY = 0;
        handleW = 0;
        handleH = 0;
        firstPane = SplitPanel.NewPane("first");
        secondPane = SplitPanel.NewPane("second");
        this.Add(firstPane);
        this.Add(secondPane);
    }

    // 透明窗格：没有自己的表面，子控件按停靠布局排布，
    // 因此设计器放进去的绝对定位控件和停靠控件都能工作。
    public static Panel NewPane(string name) {
        Panel p = Panel.Column();
        p.name = name;
        p.layout = 0;
        p.Pad(0);
        return p;
    }

    // 指定方向与首格尺寸（px）。
    public SplitPanel(int o, int size) { InitSplitPanel(o, size); }
    // 指定方向，首格默认 240px。
    public SplitPanel(int o) { InitSplitPanel(o, 240); }
    // 垂直分隔条 + 默认 240px 首格（设计器用）。
    public SplitPanel() { InitSplitPanel(0, 240); }

    // 两个窗格的内容落点——往 .First()/.Second() 里 Add 子控件，
    // 不要 Add 到 SplitPanel 自身（Arrange 只摆这两个窗格）。
    public Panel First() { return firstPane; }
    // 第二个窗格（分隔条另一侧）的内容落点。
    public Panel Second() { return secondPane; }

    // 第一个窗格的当前尺寸（px，逻辑像素）。
    public int Size() { return firstSize.Get(); }

    // 设置第一个窗格的尺寸（px）；跨帧持有，可绑定/持久化。
    public void SetSize(int px) { firstSize.Set(px); }

    // 拖拽下限：两个窗格各自允许的最小尺寸（px）。
    public SplitPanel MinSizes(int first, int second) {
        minFirst = first;
        minSecond = second;
        return this;
    }

    // 覆盖分隔条方向（0 = 垂直，1 = 水平；常量见 Vertical/Horizontal）。
    public SplitPanel Orient(int o) {
        orient = o;
        return this;
    }

    // ---- 设计器 / 序列化模型 --------------------------------------

    // 控件类型标识（序列化/设计器用）。
    public override void CloneContentTo(Control target, CloneTreeFn clone) {
        SplitPanel split = (SplitPanel)target;
        firstPane.CloneContentTo(split.First(), clone);
        secondPane.CloneContentTo(split.Second(), clone);
    }

    public override string Kind() { return "SplitPanel"; }

    // 覆写：返回设计器属性清单（orient/size/minFirst/minSecond）。
    public override List<PropSpec> Props() {
        List<PropSpec> ps = new List<PropSpec>();
        PropSpec o = PropSpec.Enum("orient", "Orientation", new List<string>());
        o.Option("vertical"); o.Option("horizontal");
        o.num = orient;
        ps.Add(o);
        PropSpec sz = PropSpec.Int("size", "First pane");
        sz.snum = firstSize;
        ps.Add(sz);
        PropSpec mf = PropSpec.Int("minFirst", "Min first");
        mf.num = minFirst;
        ps.Add(mf);
        PropSpec ms = PropSpec.Int("minSecond", "Min second");
        ms.num = minSecond;
        ps.Add(ms);
        return ps;
    }

    // 设计里放进某个窗格的子控件（设计文档的 `childTab`：0 = 第一格，
    // 1 = 第二格）真正的父节点就是那个窗格——否则它们会挂在
    // 分栏容器自己身上，而 Arrange 只摆两个窗格，于是全部消失。
    // 设计时窗格选择：slot 0 → 第一格，slot ≥1 → 第二格。
    // （对应设计文档的 `childTab`。）
    public override Control SlotHost(int slot) {
        if (slot >= 1) { return secondPane; }
        return firstPane;
    }

    public override Control NamedSlotHost(string slot) {
        string s = slot.ToLower();
        if (s == "left" || s == "top" || s == "pane1" || s == "first") {
            return firstPane;
        }
        if (s == "right" || s == "bottom" || s == "pane2" || s == "second") {
            return secondPane;
        }
        return base.NamedSlotHost(slot);
    }

    // 方向与分栏尺寸也可以写成一条 `options`（"vertical|620"），
    // 这是设计器列表型属性的通用写法。
    public override string GetExtra(string key) {
        if (key == "options") {
            string o = "vertical";
            if (orient == 1) { o = "horizontal"; }
            return o + "|" + Convert.ToString(firstSize.Get());
        }
        return "";
    }

    // 设计器写入 `options`：解析 "vertical|620" 形式的方向与
    // 首格尺寸；其他键返回 false 交给基类。
    public override bool SetExtra(string key, string val) {
        if (key != "options") { return false; }
        List<string> parts = val.Split("|");
        for (int i = 0; i < parts.Count; i = i + 1) {
            string p = parts[i];
            if (p == "vertical") { orient = 0; }
            else if (p == "horizontal") { orient = 1; }
            else if (p != "") { firstSize.Set(Convert.ToInt32(p)); }
        }
        return true;
    }

    // ---- 保留式钩子（Control） ---------------------------------------

    // 覆写：自身不主动要尺寸——分栏占满宿主给的矩形
    // （显式声明过首选尺寸时优先）。
    public override void OnMeasure(App app) {
        if (prefSet) { return; }
        prefW = 0;
        prefH = 0;
    }

    // 两个窗格按当前分栏尺寸排布，分隔条占中间的
    // 一条（其宽度按 DPI 缩放，命中区再向两侧放宽）。
    public override void Arrange(int px, int py, int pw, int ph) {
        if (pw < 0) { pw = 0; }
        if (ph < 0) { ph = 0; }
        bx = px;
        by = py;
        bw = pw;
        bh = ph;
        int bar = SplitPanel.BarSize();
        if (orient == 1) {
            int fh = this.Clamp(firstSize.Get(), ph, bar);
            firstPane.Arrange(px, py, pw, fh);
            secondPane.Arrange(px, py + fh + bar, pw, ph - fh - bar);
            handleX = px;
            handleY = py + fh;
            handleW = pw;
            handleH = bar;
        } else {
            int fw = this.Clamp(firstSize.Get(), pw, bar);
            firstPane.Arrange(px, py, fw, ph);
            secondPane.Arrange(px + fw + bar, py, pw - fw - bar, ph);
            handleX = px + fw;
            handleY = py;
            handleW = bar;
            handleH = ph;
        }
    }

    // 逻辑像素的分隔条厚度。静态而非主题值，
    // 因为 Arrange 拿不到 App（布局在测量之后进行）。
    public static int BarSize() { return 5; }

    // 把请求的分栏尺寸夹到两个窗格的最小值之间。
    private int Clamp(int want, int total, int bar) {
        int maxFirst = total - minSecond - bar;
        if (maxFirst < minFirst) { maxFirst = minFirst; }
        if (want < minFirst) { want = minFirst; }
        if (want > maxFirst) { want = maxFirst; }
        if (want < 0) { want = 0; }
        if (want > total) { want = total; }
        return want;
    }

    // The handle's expanded hit area must win before either pane's children.
    private bool HitsHandle(int x, int y, int pointerType) {
        int margin = pointerType == 1 ? 20 : 4;
        if (handleW <= 0 || handleH <= 0) { return false; }
        if (orient == 1) {
            return x >= handleX && x < handleX + handleW && y >= handleY - margin && y < handleY + handleH + margin;
        }
        return x >= handleX - margin && x < handleX + handleW + margin && y >= handleY && y < handleY + handleH;
    }

    public override Control HitTest(int x, int y, int pointerType) {
        if (!this.StyleVisible() || !this.ContainsPoint(x, y, pointerType)) { return null; }
        if (this.HitsHandle(x, y, pointerType)) { return this; }
        return base.HitTest(x, y, pointerType);
    }

    private void DragTo(App app, RoutedEventArgs e) {
        int value = orient == 1 ? e.y - by : e.x - bx;
        int total = orient == 1 ? bh : bw;
        value = this.Clamp(value, total, SplitPanel.BarSize());
        if (value == firstSize.Get()) { return; }
        firstSize.Set(value);
        this.Arrange(bx, by, bw, bh);
        app.RequestRedraw();
    }

    public override void OnPointerDown(RoutedEventArgs e) {
        App app = this.FindApp();
        if (e.handled || this.IsDisabled() || app == null || app.window.EventButton() != 0) { return; }
        if (e.originalSource != this || !this.HitsHandle(e.x, e.y, e.pointerType)) { return; }
        dragging = true;
        base.OnPointerDown(e);
        app.CapturePointer(this, true);
        this.DragTo(app, e);
        app.RequestRedraw();
        e.Handle();
    }

    public override void OnPointerMove(RoutedEventArgs e) {
        App app = this.FindApp();
        if (e.handled || !dragging || app == null || app.GetCapturedPointer() != this) { return; }
        if (this.IsDisabled()) { this.OnPointerCancel(e); return; }
        this.DragTo(app, e);
        e.Handle();
    }

    public override void OnPointerUp(RoutedEventArgs e) {
        App app = this.FindApp();
        if (e.handled || !dragging || app == null || app.window.EventButton() != 0) { return; }
        if (!this.IsDisabled() && app.GetCapturedPointer() == this) { this.DragTo(app, e); }
        base.OnPointerUp(e);
        dragging = false;
        if (app.GetCapturedPointer() == this) { app.ReleasePointerCapture(); }
        app.RequestRedraw();
        e.Handle();
    }

    public override void OnPointerCancel(RoutedEventArgs e) {
        base.OnPointerCancel(e);
        dragging = false;
        App app = this.FindApp();
        if (app != null) {
            if (app.GetCapturedPointer() == this) { app.ReleasePointerCapture(); }
            app.RequestRedraw();
        }
    }

    public override void OnPaint(App app) {
        int state = Style.SNormal();
        if (this.IsDisabled()) { state = Style.SDisabled(); }
        else if (dragging || this.HitsHandle(app.mouseX, app.mouseY, app.GetPointerDeviceType())) { state = Style.SHover(); }
        app.canvas.FillRect(handleX, handleY, handleW, handleH,
            this.ResolveStyleAs(app, "splitter", "", state).bg);
    }
}
