using System;
using Gui;
namespace Gui.Widget;
[GuiKind("Dropdown", typeof(Dropdown<string>))]
public class Dropdown<T> : Control {
    public override Control CreateCloneShell() { return new Dropdown<T>(); }
    private Control customPopup;
    private List<MenuItem> menuItems;
    private List<T> data;
    private CellOf<T> textOf;
    private string hint;
    private T selItem;
    private int selIndex;
    private int lastAction;
    private int maxRows;
    private bool opened;
    private int generation;
    private weak App popupApp;
    private Control activePopup;
    private RichMenu retainedMenu;
    private DropdownSession<T> sessionBridge;
    private AppLoopRegistration registration;
    public UiEvent Change;
    public UiEvent Opened;
    public UiEvent Closed;
    private void InitDropdown() {
        this.InitControl("dropdown");
        styleSurfaceOwned = true;
        wiresOwnEvents = true;
        hint = "";
        maxRows = 8;
        selIndex = -1;
        lastAction = -1;
        Change = new UiEvent();
        Opened = new UiEvent();
        Closed = new UiEvent();
        retainedMenu = new RichMenu();
        sessionBridge = new DropdownSession<T>();
        sessionBridge.owner = this;
        retainedMenu.ActionSelected.AddS(sessionBridge.Selected);
    }
    public Dropdown() { this.InitDropdown(); }
    public Dropdown(CellOf<T> text) { this.InitDropdown(); textOf = text; }
    public List<T> ItemsSource {
        get { return this.data; }
        set { this.Bind(value); }
    }
    public List<MenuItem> MenuItems {
        get { return this.menuItems; }
        set { this.BindMenu(value); }
    }
    public CellOf<T> TextSelector {
        get { return this.textOf; }
        set { this.textOf = value; }
    }
    public string Placeholder {
        get { return this.hint; }
        set { this.hint = value; }
    }
    public int MaxVisibleRows {
        get { return this.maxRows; }
        set { if (value > 0) { this.maxRows = value; } }
    }
    public int SelectedIndexValue {
        get { return this.selIndex; }
        set { this.SelectIndex(value); }
    }
    public Control PopupContent {
        get { return this.customPopup; }
        set { this.SetPopupContent(value); }
    }
    public bool IsOpened {
        get { return this.opened; }
        set { this.SetOpen(value); }
    }
    public override string Kind() { return "Dropdown"; }
    public override string StyleType() { return "select"; }
    public override int InputFocusCapabilities() { return 1; }
    public override bool ChildControlsRenderedByOwner() { return true; }
    public void Bind(List<T> source) {
        data = source;
        menuItems = null;
        selIndex = -1;
    }
    public void BindMenu(List<MenuItem> value) {
        menuItems = value;
        data = null;
        selIndex = -1;
        lastAction = -1;
    }
    public void OnChange(Action callback) { Change.Add(callback); }
    public void OnOpen(Action callback) { Opened.Add(callback); }
    public void OnClose(Action callback) { Closed.Add(callback); }
    public void Hint(string text) { hint = text; }
    public void Label(CellOf<T> text) { textOf = text; }
    public void Rows(int count) { if (count > 0) { maxRows = count; } }
    public int Count() {
        if (menuItems != null) { return menuItems.Count; }
        return data != null ? data.Count : 0;
    }
    public int SelectedIndex() { return selIndex; }
    public bool HasSelection() { return selIndex >= 0; }
    public T Selected() { return selItem; }
    public int Action() { return lastAction; }
    public void SelectIndex(int row) {
        if (menuItems != null && row >= 0 && row < menuItems.Count) {
            selIndex = row;
            lastAction = menuItems[row].action;
            Change.RaiseS(this);
            return;
        }
        if (data == null || row < 0 || row >= data.Count) { return; }
        if (selIndex == row) { return; }
        selIndex = row;
        selItem = data[row];
        Change.RaiseS(this);
    }
    public void Clear() { selIndex = -1; lastAction = -1; }
    public bool IsOpen() { return opened; }
    public int Session() { return generation; }
    public RichMenu MenuControl() { return retainedMenu; }
    public void SetOpen(bool want) {
        if (want == opened) { return; }
        if (!want) {
            App app = popupApp;
            Control popup = activePopup;
            if (app != null && app.overlayHost.ActiveRoot() == popup) { app.overlayHost.Hide(popup); }
            else { this.OnPopupDismissed(); }
            return;
        }
        App app = this.FindApp();
        if (app == null || app.overlayHost == null) { return; }
        generation = generation + 1;
        int session = generation;
        opened = true;
        popupApp = app;
        Control popup = customPopup != null ? customPopup : retainedMenu;
        activePopup = popup;
        if (popup == retainedMenu) {
            retainedMenu.maxRows = maxRows;
            retainedMenu.minWidth = bw;
            retainedMenu.SetItems(this.SyncItems(app));
            retainedMenu.ShowFor(app, this);
        } else {
            popup.UseApp(app);
            app.overlayHost.Show(app, this, popup);
        }
        if (generation != session || !opened || activePopup != popup) { return; }
        if (app.overlayHost.ActiveRoot() != popup) { this.OnPopupDismissed(); return; }
        sessionBridge.session = session;
        registration = app.RegisterLoopParticipant(this, sessionBridge);
        app.RequestRedraw();
        Opened.RaiseS(this);
    }
    public void Open() { this.SetOpen(true); }
    public void Close() { this.SetOpen(false); }
    public override void OnPopupDismissed() {
        if (!opened) { return; }
        if (activePopup == retainedMenu && retainedMenu.IsSelecting()) { return; }
        this.CommitClosed();
        Closed.RaiseS(this);
    }
    private void CommitClosed() {
        opened = false;
        activePopup = null;
        popupApp = null;
        generation = generation + 1;
        if (registration != null) { registration.Invalidate(); registration = null; }
    }
    public void MenuSelected(Control sender) {
        if (!opened || sender != retainedMenu || activePopup != retainedMenu) { return; }
        int action = retainedMenu.TakeAction();
        if (action < 0) { return; }
        App app = popupApp;
        this.CommitClosed();
        int closedSession = generation;
        lastAction = action;
        if (data != null && action < data.Count) {
            selIndex = action;
            selItem = data[action];
        }
        Change.RaiseS(this);
        if (generation != closedSession || opened) { return; }
        Closed.RaiseS(this);
        if (app != null) { app.RequestRedraw(); }
    }
    public void PreparePopup(App app, int session) {
        if (!opened || generation != session || popupApp != app || activePopup != retainedMenu) { return; }
        retainedMenu.maxRows = maxRows;
        retainedMenu.minWidth = bw;
        retainedMenu.RefreshItems(this.SyncItems(app));
        retainedMenu.Prepare(app);
    }
    public string TriggerText() {
        if (selIndex >= 0 && textOf != null) { return textOf(selItem); }
        return hint;
    }
    public override void OnMeasure(App app) {
        this.SyncBinding();
        StyleBox normal = this.Box(app);
        prefH = normal.HeightOr(app.theme.heightMedium);
        prefW = normal.WidthOr(app.Scale(160));
    }
    public override void OnPaint(App app) {
        this.SyncBinding();
        app = this.ResolveApp(app);
        if (app == null || app.canvas == null || bw <= 0 || bh <= 0) { return; }
        StyleBox normal = this.Box(app);
        int state = this.WidgetState(app);
        if (opened || isHovered) { state = state | Style.SHover(); }
        if (opened) { state = state | Style.SSelected(); }
        StyleBox box = this.BoxState(app, state);
        box.Paint(app, bx, by, bw, bh);
        Rect content = DropdownChrome.ContentBounds(this, normal, app.theme.paddingMedium);
        StyleBox arrowNormal = this.ResolvePart(app, "arrow", "", Style.SNormal());
        StyleBox arrow = this.ResolvePart(app, "arrow", "", state);
        int size = DropdownChrome.SlotSize(content, arrowNormal.FontOr(app.theme.iconSizeSmall));
        int font = normal.FontOr(Style.FontFallback(app, "medium"));
        int color = box.fg;
        if (selIndex < 0 || textOf == null) {
            StyleBox placeholder = this.ResolvePart(app, "placeholder", "", state);
            font = placeholder.FontOr(font);
            color = placeholder.FgOr(color);
        }
        DropdownChrome.PaintLabel(app.canvas, content, content.width - size - app.theme.gapSmall,
                                  this.TriggerText(), font, color);
        DropdownChrome.PaintArrow(app.canvas, content, size, arrow.FgOr(box.fg));
    }
    public override void OnClick(RoutedEventArgs e) { e.Handle(); this.SetOpen(!opened); }
    public override void OnKeyDown(RoutedEventArgs e) {
        if (e.keyCode == 13 || e.keyCode == 32) { e.Handle(); this.SetOpen(!opened); return; }
        base.OnKeyDown(e);
    }
    public override void OnPointerEnter(RoutedEventArgs e) {
        base.OnPointerEnter(e);
        if (this.App != null) { this.App.RequestRedraw(); }
    }
    public override void OnPointerLeave(RoutedEventArgs e) {
        base.OnPointerLeave(e);
        if (this.App != null) { this.App.RequestRedraw(); }
    }
    public List<MenuItem> SyncItems() { return this.SyncItems(this.App); }
    public List<MenuItem> SyncItems(App app) {
        if (menuItems != null) { return menuItems; }
        List<MenuItem> result = new List<MenuItem>();
        if (data == null || textOf == null) { return result; }
        for (int i = 0; i < data.Count; i = i + 1) { result.Add(MenuItem.Item(textOf(data[i]), "", i)); }
        return result;
    }
    protected override List<PropSpec> DefineProps() {
        List<PropSpec> ps = new List<PropSpec>();
        ps.Add(PropSpec.Int("value", "Selected Index").DefaultBinding().ViaExtra().Also("data").Also("sel").Also("selected"));
        ps.Add(PropSpec.Text("options", "Options").ViaExtra());
        ps.Add(PropSpec.Text("placeholder", "Placeholder").Field("hint", 0).Also("hint"));
        return ps;
    }
    public override string GetProp(string key) {
        if (key == "value" || key == "data" || key == "sel" || key == "selected") {
            return Convert.ToString(this.selIndex);
        }
        if (key == "placeholder" || key == "hint") { return this.hint; }
        return base.GetProp(key);
    }
    public override void SetProp(string key, string val) {
        if (key == "value" || key == "data" || key == "sel" || key == "selected") {
            this.SelectIndex(Convert.ToInt32(val));
            return;
        }
        if (key == "placeholder" || key == "hint") { this.hint = val; return; }
        base.SetProp(key, val);
    }
    public override string GetExtra(string key) {
        if (key == "value" || key == "data" || key == "sel" || key == "selected") {
            return Convert.ToString(this.selIndex);
        }
        if (key != "options" || menuItems == null) { return ""; }
        string result = "";
        for (int i = 0; i < menuItems.Count; i = i + 1) {
            if (i > 0) { result = result + "|"; }
            result = result + menuItems[i].label;
        }
        return result;
    }
    public override bool SetExtra(string key, string value) {
        if (key == "value" || key == "data" || key == "sel" || key == "selected") {
            this.SelectIndex(Convert.ToInt32(value));
            return true;
        }
        if (key != "options") { return false; }
        List<MenuItem> result = new List<MenuItem>();
        if (value != null && value.Length > 0) {
            List<string> parts = value.Split("|");
            for (int i = 0; i < parts.Count; i = i + 1) { result.Add(MenuItem.Item(parts[i], "", i)); }
        }
        this.BindMenu(result);
        return true;
    }
    public override bool MountSlot(string slot, Control content) {
        if (slot == "popup" || slot == "dropdown" || slot == "content" || slot == "menu") {
            this.SetPopupContent(content); return true;
        }
        return base.MountSlot(slot, content);
    }
    public void SetPopupContent(Control content) {
        if (customPopup == content) { return; }
        if (opened) {
            int session = generation;
            this.Close();
            if (opened || generation != session + 1) { return; }
        }
        customPopup = content;
    }
    public Control GetPopupContent() { return customPopup; }
    public override List<string> Events() {
        List<string> events = Control.CommonEvents();
        events.Add("Change"); events.Add("Opened"); events.Add("Closed");
        return events;
    }
    public override void BindEvent(string name, Action callback) {
        if (name == "Change") { Change.Add(callback); return; }
        if (name == "Opened") { Opened.Add(callback); return; }
        if (name == "Closed") { Closed.Add(callback); return; }
        base.BindEvent(name, callback);
    }
    public override void BindEventS(string name, ControlEvent callback) {
        if (name == "Change") { Change.AddS(callback); return; }
        if (name == "Opened") { Opened.AddS(callback); return; }
        if (name == "Closed") { Closed.AddS(callback); return; }
        base.BindEventS(name, callback);
    }
}
