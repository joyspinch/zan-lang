    // 字段类型的默认占位文本。
    public static string DefaultPlaceholder(int ft) {
        if (ft == 6) { return "请选择"; }
        if (ft == 10) { return "选择日期"; }
        if (ft == 11) { return "选择时间"; }
        if (ft == 12) { return "点击上传"; }
        if (ft == 2) { return "请输入密码"; }
        // 网页视图的文本属性是起始地址（见 WebViewBox 的 `url`）。
        if (ft == 72) { return "https://www.example.com"; }
        return "请输入";
    }

    // 字段类型是否带用户可编辑的选项列表。除
    // 选择型字段外，一些显示/导航组件也复用该选项
    // 这些组件的条目使用列表：表格列(23)、时间线事件(24)、树
    // 节点(25)、折叠区(26)、步骤(34)、面包屑(35)、
    // 标签页标题(36)和菜单项(38)。
    public static bool UsesOptionsOf(int ft) {
        return ft == 4 || ft == 5 || ft == 6
            || ft == 23 || ft == 24 || ft == 25 || ft == 26
            || ft == 34 || ft == 35 || ft == 36 || ft == 38
            || ft == 40 || ft == 41 || ft == 42 || ft == 53
            || ft == 55
            || ft == 58 || ft == 59 || ft == 60
            || ft == 81;
    }

    // 非可视化（行为）组件，WinForms 组件托盘风格：它们
    // 不在设计窗口本身中占空间——设计器把它们显示在
    // 画布下方的托盘条里。Tooltip(33)、
    // Timer(57)。
    public static bool IsNonVisualOf(int ft) {
        return ft == 33 || ft == 47 || ft == 48 || ft == 49 || ft == 50
            || ft == 51 || ft == 52 || ft == 55 || ft == 56 || ft == 57;
    }

    // 本字段是否为非可视（行为）组件（设计器托盘条显示）。
    public bool IsNonVisual() {
        return FormField.IsNonVisualOf(ftype);
    }

    // 本字段类型是否带用户可编辑的选项列表。
    public bool UsesOptions() {
        return FormField.UsesOptionsOf(ftype);
    }

    // 显示 / 布局 / 反馈 / 导航组件（ftype >= 15）渲染
    // 静态内容：它们横跨整行，跳过标签列。
    public static bool IsDisplayOf(int ft) {
        return ft >= 15;
    }

    // 本字段是否为显示/布局组件（ftype >= 15，渲染静态内容）。
    public bool IsDisplay() {
        return FormField.IsDisplayOf(ftype);
    }

    // 行高（未缩放），让较高的输入框（textarea/upload/richtext）和
    // 多选项字段在画布上获得所需空间。
    public int RowUnits() {
        return FormField.DefaultHFor(ftype);
    }

    // 皮肤定高（高度由尺寸档决定：tiny 24 / small 28 / medium 32 /
    // large 40）的类型：设计文档不写这些类型的高度，写了会压掉尺寸档
    // （表单整体改小一号时高度不变）。其余类型的高度由设计文档决定，
    // 运行时按声明走（声明优先于样式表）。
    public static bool SkinSizedType(int ft) {
        return ft == 0 || ft == 2 || ft == 3 || ft == 6 || ft == 7
            || ft == 10 || ft == 11 || ft == 19 || ft == 83;
    }

    // 文档写高度的类型：高度由内容规模决定（多行文本、附件、表格、
    // 树、图表……），样式表没有默认高度，若文档不写，它们就塌成
    // 一行高、和下一行叠在一起。这类字段的设计文档一律带上高度
    // （默认取 DefaultHFor 的类型标准行高）。
    // 皮肤定高的类型（输入框/下拉/开关…）不在此列：它们归尺寸档，
    // 容器（面板/卡片/标签页…）也不在：它们按内容自适应。
    public static bool DocHeightType(int ft) {
        return ft == 1 || ft == 12 || ft == 14 || ft == 22 || ft == 23
            || ft == 24 || ft == 25 || ft == 27 || ft == 30 || ft == 31
            || ft == 34 || ft == 38 || ft == 40 || ft == 41 || ft == 42
            || ft == 43 || ft == 63 || ft == 64 || ft == 65 || ft == 66
            || ft == 68 || ft == 69 || ft == 72 || ft == 75 || ft == 76
            || ft == 78 || ft == 84 || ft == 85;
    }

    // 各组件类型的标准默认高度。
    public static int DefaultHFor(int ft) {
        // 73-85: 新增组件的画布行高——日历/图片/水印/网格/穿梭框/
        // 虚拟列表要高度，流式件（Flex/Tags/OTP/动效数字）矮行即可。
        if (ft == 73) { return 48; }
        if (ft == 74) { return 96; }
        if (ft == 75) { return 96; }
        if (ft == 76) { return 200; }
        if (ft == 77) { return 36; }
        if (ft == 78) { return 110; }
        if (ft == 79) { return 96; }
        if (ft == 80) { return 34; }
        if (ft == 81) { return 34; }
        if (ft == 82) { return 42; }
