        if (ft == 4 || ft == 5) { return 34; }
        if (ft == 15) { return 30; }
        if (ft == 16) { return 26; }
        if (ft == 17) { return 24; }
        if (ft == 18) { return 96; }
        if (ft == 19) { return 34; }
        if (ft == 20) { return 34; }
        if (ft == 21) { return 44; }
        if (ft == 22) { return 60; }
        if (ft == 23) { return 104; }
        if (ft == 24) { return 92; }
        if (ft == 25) { return 92; }
        if (ft == 26) { return 72; }
        if (ft == 27) { return 84; }
        if (ft == 28) { return 40; }
        if (ft == 29) { return 40; }
        if (ft == 30) { return 96; }
        if (ft == 31) { return 70; }
        if (ft == 32) { return 44; }
        if (ft == 33) { return 34; }
        if (ft == 34) { return 56; }
        if (ft == 35) { return 30; }
        if (ft == 36) { return 70; }
        if (ft == 37) { return 34; }
        if (ft == 38) { return 92; }
        if (ft == 39) { return 56; }
        if (ft == 40) { return 96; }
        if (ft == 41) { return 104; }
        if (ft == 42) { return 104; }
        if (ft == 43) { return 140; }
        if (ft == 44) { return 26; }
        if (ft == 45) { return 96; }
        if (ft == 46) { return 96; }
        if (ft == 47) { return 44; }
        if (ft == 48) { return 40; }
        if (ft == 49) { return 56; }
        if (ft == 50) { return 88; }
        if (ft == 51) { return 104; }
        if (ft == 52) { return 52; }
        if (ft == 53) { return 88; }
