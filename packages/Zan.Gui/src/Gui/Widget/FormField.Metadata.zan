        if (ft == 72) { return 300; }
        if (ft == 60) { return 160; }
        if (ft == 61) { return 160; }
        return 34;
    }

    // ---- 选项列表 ----

    // 选项数 / 第 i 个选项 / 追加一个选项。
    public int OptionCount() { return options.Count; }
    // 返回第 i 个选项。
    public string OptionAt(int i) { return options[i]; }
    // 追加一个选项。
    public void AddOption(string s) { options.Add(s); }
    // 通过重建列表来移除一个选项（运行时的列表中段
    // RemoveAt 与列表中段 Insert 一样可能破坏堆）。
    public void RemoveOptionAt(int i) {
        if (i < 0 || i >= options.Count) { return; }
        List<string> nl = new List<string>();
        for (int k = 0; k < options.Count; k = k + 1) {
            if (k != i) { nl.Add(options[k]); }
        }
        options = nl;
    }

    // 原地改写第 i 个选项（设计器弹窗行编辑用）。
    public void SetOptionAt(int i, string s) {
        if (i < 0 || i >= options.Count) { return; }
        List<string> nl = new List<string>();
        for (int k = 0; k < options.Count; k = k + 1) {
            nl.Add(k == i ? s : options[k]);
        }
        options = nl;
    }

    // 把 from 处的选项移动到 to（同为越界安全的中段移动，
    // 通过重建列表完成）。
    public void MoveOption(int from, int to) {
        if (from < 0 || from >= options.Count) { return; }
        if (to < 0) { to = 0; }
        if (to >= options.Count) { to = options.Count - 1; }
        if (from == to) { return; }
        string mv = options[from];
        List<string> nl = new List<string>();
        for (int k = 0; k < options.Count; k = k + 1) {
            if (k == from) { continue; }
            nl.Add(options[k]);
        }
        List<string> fin = new List<string>();
        bool placed = false;
        for (int k = 0; k < nl.Count; k = k + 1) {
            if (k == to && !placed) { fin.Add(mv); placed = true; }
            fin.Add(nl[k]);
        }
        if (!placed) { fin.Add(mv); }
        options = fin;
    }

    // 选项列表 → "a|b|c" 文本（GetExtra 序列化用）。
    public string JoinOptions() {
        string r = "";
        for (int i = 0; i < options.Count; i = i + 1) {
            if (i > 0) { r = r + "|"; }
            r = r + options[i];
        }
        return r;
    }

    // "a|b|c" 文本 → 选项列表（SetExtra 反序列化用）。
    public void SetOptionsFrom(string joined) {
        options = new List<string>();
        if (joined == null || joined.Length == 0) { return; }
        List<string> parts = joined.Split("|");
        for (int i = 0; i < parts.Count; i = i + 1) {
            if (i < parts.Count - 1 || parts[i].Length > 0) {
                options.Add(parts[i]);
            }
        }
    }

    // ---- 设计器 / 序列化模型 ----

    public string KindName() {
        if (this.kind != "") { return this.kind; }
        if (this.IsCustom()) { return this.customKind; }
        return FormField.KindForType(this.ftype);
    }

    // them.
    public static string KindForType(int ft) {
        if (ft == 100) { return ""; }
        if (ft == 1) { return "TextArea"; }
        if (ft == 4) { return "Radio"; }
        if (ft == 5) { return "Checkbox"; }
        if (ft == 6) { return "SelectBox"; }
        if (ft == 7) { return "Switch"; }
        if (ft == 8) { return "Rate"; }
        if (ft == 9) { return "Slider"; }
        if (ft == 14) { return "TextArea"; }
        if (ft == 15 || ft == 16) { return "Label"; }
        if (ft == 17) { return "Divider"; }
        if (ft == 18 || ft == 45) { return "Panel"; }
        if (ft == 19) { return "Tag"; }
        if (ft == 20) { return "Badge"; }
        if (ft == 21) { return "Avatar"; }
        if (ft == 22) { return "Statistic"; }
        // 23 表格与 41 数据表格共用泛型 DataGrid<T>（Table 只是
        // 画布预览的静态表头渲染器，不是 Control）：kind 必须是
        // 可实例化的控件类，否则设计稿生成的 `new Table()` 编不过、
        // kind "DataGrid" 也无法经 TypeForKey 往返回 23/41。
        if (ft == 23 || ft == 41) { return "DataGrid"; }
        if (ft == 24) { return "Timeline"; }
        if (ft == 25) { return "TreeView"; }
        if (ft == 26) { return "Collapse"; }
        if (ft == 27) { return "Empty"; }
        if (ft == 29) { return "Progress"; }
        if (ft == 30) { return "Result"; }
        if (ft == 31) { return "Skeleton"; }
        if (ft == 32 || ft == 47) { return "Spin"; }
        if (ft == 34) { return "Steps"; }
        if (ft == 35) { return "Breadcrumb"; }
        if (ft == 36) { return "Tabs"; }
        if (ft == 37) { return "Pagination"; }
        if (ft == 39) { return "PageHeader"; }
        if (ft == 40) { return "ListView"; }
        if (ft == 48) { return "Dropdown"; }
        if (ft == 42) { return "Carousel"; }
        if (ft == 43) { return "Chart"; }
        if (ft == 44) { return "Ellipsis"; }
        if (ft == 46) { return "Scrollbar"; }
        if (ft == 49) { return "FloatButton"; }
        if (ft == 53) { return "Ribbon"; }
        if (ft == 56) { return "Layer"; }
        if (ft == 58) { return "ToolStrip"; }
        if (ft == 59) { return "StatusBar"; }
        if (ft == 60) { return "SplitPanel"; }
        if (ft == 61) { return "Panel"; }
        if (ft == 62) { return "Led"; }
        if (ft == 63) { return "Digital"; }
        if (ft == 64) { return "Gauge"; }
        if (ft == 65) { return "Bargraph"; }
        if (ft == 66) { return "Trend"; }
        if (ft == 67) { return "AlarmBanner"; }
        if (ft == 68) { return "AlarmList"; }
        if (ft == 69) { return "NumPad"; }
        if (ft == 70) { return "DeviceCard"; }
        if (ft == 71) { return "EquipPanel"; }
        if (ft == 72) { return "WebViewBox"; }
        // 73-85: 补齐后续新增的控件——布局容器（Flex/Grid）、媒体展示
        // （Image/Watermark/Marquee）、数据件（Transfer/VirtualList/
        // DynamicTags）、动效件（Countdown/NumberAnimation）与
        // OTP 输入、月历。全部是 ControlFactory 可实例化的真控件。
        if (ft == 73) { return "Flex"; }
        if (ft == 74) { return "Grid"; }
        if (ft == 75) { return "Image"; }
        if (ft == 76) { return "Calendar"; }
        if (ft == 77) { return "Countdown"; }
        if (ft == 78) { return "QrCode"; }
        if (ft == 79) { return "Watermark"; }
        if (ft == 80) { return "Marquee"; }
        if (ft == 81) { return "DynamicTags"; }
        if (ft == 82) { return "NumberAnimation"; }
        if (ft == 83) { return "InputOtp"; }
        if (ft == 84) { return "Transfer"; }
        if (ft == 85) { return "VirtualList"; }
        if (ft == 3) { return "InputNumber"; }
        if (ft == 10) { return "DatePicker"; }
        if (ft == 12) { return "Upload"; }
        if (ft == 13) { return "ColorPicker"; }
        if (ft == 28 || ft == 33 || ft == 38 || ft == 44 || ft == 50
            || ft == 51 || ft == 52 || ft == 54 || ft == 55 || ft == 57) {
            return "Label";
        }
        if (ft == 43 || ft == 46 || ft == 56) { return "Panel"; }
        return "Input";
    }

    // 控件类型标识（序列化/设计器用）。
    public override string Kind() { return "Field"; }

    // 覆写：返回设计器属性清单（label/fname/placeholder/required/
    // wrap/defOn/span/dock/customKind/options，部分按类型给）。
    public override List<PropSpec> Props() {
        List<PropSpec> ps = new List<PropSpec>();
        PropSpec lbl = PropSpec.Text("label", "Label");
        lbl.str = label;
        ps.Add(lbl);
        PropSpec fld = PropSpec.Text("fname", "Name");
        fld.str = fname;
        fld.AsName();
        ps.Add(fld);
        // 网页视图用这一行存起始地址（它没有占位文本），因此换一个
        // 名字，属性面板不再把地址当成「占位符」。
        string phLabel = "Placeholder";
        if (ftype == 72) { phLabel = "Start URL"; }
        PropSpec ph = PropSpec.Text("placeholder", phLabel);
        ph.str = placeholder;
        ps.Add(ph);
        PropSpec req = PropSpec.Bool("required", "Required");
        req.flag = required;
        ps.Add(req);
        if (ftype == 15 || ftype == 16) {
            PropSpec wr = PropSpec.Bool("wrap", "Wrap");
            wr.flag = wrap;
            ps.Add(wr);
        }
        PropSpec on = PropSpec.Bool("defOn", "Default on");
        on.flag = defOn;
        ps.Add(on);
        PropSpec sp = PropSpec.Int("span", "Span");
        sp.num = span;
        ps.Add(sp);
        PropSpec pos = PropSpec.Enum("position", "Position", new List<string>());
        pos.Option("flow"); pos.Option("float");
        pos.num = position;
        ps.Add(pos);
        PropSpec anc = PropSpec.Enum("anchor", "Anchor", new List<string>());
        anc.Option("none"); anc.Option("topLeft"); anc.Option("topCenter");
        anc.Option("topRight"); anc.Option("centerLeft"); anc.Option("center");
        anc.Option("centerRight"); anc.Option("bottomLeft"); anc.Option("bottomCenter");
        anc.Option("bottomRight"); anc.Option("stretch");
        anc.num = anchor;
        ps.Add(anc);
        PropSpec fg = PropSpec.Int("flexGrow", "Flex Grow");
        fg.num = flexGrow;
        ps.Add(fg);
        if (this.IsCustom()) {
            PropSpec kind = PropSpec.Text("customKind", "Component");
            kind.str = customKind;
            ps.Add(kind);
        }
        ps.Add(PropSpec.Text("options", "Options"));
        return ps;
    }

    // 选项列表存为文本，逗号分隔的每项即一个选项。
    public override string GetExtra(string key) {
        if (key == "options") { return this.JoinOptions(); }
        return "";
    }

    // 设计器写入 `options`（逗号分隔选项文本）；其他键返回 false
    // 交给基类。
    public override bool SetExtra(string key, string val) {
        if (key != "options") { return false; }
        this.SetOptionsFrom(val);
        return true;
    }
}
