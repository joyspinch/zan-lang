    // 某字段类型特有的语义事件（除每个 Control 都继承的通用
    // 指针/焦点/键盘/生命周期事件集之外）。驱动
    // 设计器的事件检查器和 JSON `on*` 处理器约定。
    public static List<string> SemanticEventsOf(int ft) {
        List<string> e = new List<string>();
        // 只承诺生成代码里真的会被触发的事件：以 KindForType 生成
        // 的控件 Events() 为准（契约审计
        // tests/gui/events_contract_test.zan 锁定）。多行 TextArea
        // 生成的也是 Input，没有弹层/文件事件；Timeline/Breadcrumb/
        // Result 是纯展示；menu/contextmenu 走宿主通道生成
        // Label，没有控件级事件。表格列级事件见 23/41 段。
        // --- 表单输入 ---
        if (ft == 0 || ft == 2 || ft == 3) {
            e.Add("Change"); e.Add("Submit");            // Input/Password/Number
        } else if (ft == 1 || ft == 14) {
            e.Add("Change");                              // Textarea / Rich Text
        } else if (ft == 4) {
            e.Add("Change");                              // Radio
        } else if (ft == 5) {
            e.Add("Change"); e.Add("Toggle");             // Checkbox
        } else if (ft == 6) {
            e.Add("Change"); e.Add("SelectionChanged");   // Select
        } else if (ft == 7) {
            e.Add("Change"); e.Add("Toggle");             // Switch
        } else if (ft == 8) {
            e.Add("Change");                              // Rate
        } else if (ft == 9) {
            e.Add("Change"); e.Add("DragEnd");            // Slider
        } else if (ft == 10 || ft == 11 || ft == 12 || ft == 13) {
            e.Add("Change");                              // Date/Time/Upload/Color (Input)
        // --- 显示 ---
        } else if (ft == 19) {
            e.Add("Click"); e.Add("Close");               // Tag（可关闭）
        } else if (ft == 21) {
            e.Add("Click");                               // Avatar
        } else if (ft == 22) {
            e.Add("Click");                               // Statistic
        } else if (ft == 23 || ft == 41) {
            // 与 DataGrid<T>.Events()/引擎 state 的 UiEvent 全集
            // 对齐（每个都经 BindEvent 转发到真实触发点）。
            e.Add("RowClick"); e.Add("RowContext"); e.Add("RowDoubleClick");
            e.Add("CellClick"); e.Add("CellEdit"); e.Add("SelectionChanged");
            e.Add("HeaderClick"); e.Add("Sort"); e.Add("FilterChanged");
            e.Add("ColumnResize"); e.Add("ColumnResizeEnd");
            e.Add("ScrollChanged");
        } else if (ft == 24) {
            // Timeline 是纯展示件，没有控件级事件。
        } else if (ft == 25) {
            e.Add("Expand"); e.Add("Collapse"); e.Add("Select"); // Tree
        } else if (ft == 26) {
            e.Add("Change");                              // Collapse
        // --- 反馈 ---
        } else if (ft == 34) {
            e.Add("Change");                              // Steps
        // --- 导航 ---
        } else if (ft == 36) {
            e.Add("TabChanged"); e.Add("TabClosed");      // Tabs
        } else if (ft == 37) {
            e.Add("Change");                              // Pagination
        } else if (ft == 40) {
            // ListView<T> 的真实事件名（Events()）。
            e.Add("Select"); e.Add("Activate"); e.Add("Context");
        } else if (ft == 42) {
            e.Add("Change");                              // Carousel
        } else if (ft == 48) {
            // Dropdown<T> 的真实事件名（Events()）。
            e.Add("Change"); e.Add("Opened"); e.Add("Closed");
        } else if (ft == 56) {
            e.Add("Open"); e.Add("Close");                // Layer
        } else if (ft == 57) {
            e.Add("Tick");                                // Timer
        } else if (ft == 39) {
            e.Add("Back");                                // Page Header
        // --- 显示/反馈扩展 ---
        } else if (ft == 42) {
            e.Add("Change");                              // Carousel
        } else if (ft == 43) {
            e.Add("PointClick"); e.Add("LegendClick");    // Chart
        } else if (ft == 49) {
            e.Add("Click");                               // Float Button
        } else if (ft == 50) {
            e.Add("Show"); e.Add("Hide");                 // Popover
        } else if (ft == 51) {
            e.Add("Confirm"); e.Add("Cancel");            // Popconfirm
        } else if (ft == 52) {
            e.Add("Click"); e.Add("Close");               // Notification
        } else if (ft == 54) {
            e.Add("Click");                               // Icon
        } else if (ft == 67) {
            e.Add("Ack");
        } else if (ft == 68) {
            e.Add("RowClick");
        } else if (ft == 69) {
            e.Add("Enter");
            e.Add("Cancel");
        } else if (ft == 58) {
            e.Add("ItemClick");                           // Tool Strip
        } else if (ft == 60) {
            e.Add("Change");                              // Split（分栏尺寸）
        } else if (ft == 72) {
            e.Add("NavStart"); e.Add("NavComplete");      // Web View
            e.Add("TitleChanged"); e.Add("LoadingChanged");
        }
        return e;
    }

    // 覆写：公共事件之外并入字段类型（ftype）对应的语义事件集。
    public override List<string> Events() {
        List<string> e = Control.CommonEvents();
        List<string> sem = FormField.SemanticEventsOf(ftype);
        for (int i = 0; i < sem.Count; i = i + 1) {
            if (!e.Contains(sem[i])) { e.Add(sem[i]); }
        }
        return e;
    }

