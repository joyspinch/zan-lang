    // TypeKey 的逆运算：由规范字符串类型（即设计文档的
    // `kind` 字段中所写）求 ftype。"custom" -> 100；未知 -> 0（input）。
    public static int TypeForKey(string key) {
        if (key == "custom") { return 100; }
        // Panel 独立容器控件类型定义。
        if (key == "Panel") { return 45; }
        if (key == "DataGrid" || key == "DataTable") { return 41; }
        if (key == "Chart") { return 43; }
        if (key == "Ellipsis") { return 44; }
        if (key == "Scrollbar") { return 46; }
        if (key == "Ribbon") { return 53; }
        if (key == "Layer") { return 56; }
        for (int ft = 0; ft <= FormField.MaxType(); ft = ft + 1) {
            if (FormField.KindForType(ft) == key) { return ft; }
        }
        for (int ft2 = 0; ft2 <= FormField.MaxType(); ft2 = ft2 + 1) {
            if (FormField.TypeKey(ft2) == key) { return ft2; }
        }
        return 0;
    }

