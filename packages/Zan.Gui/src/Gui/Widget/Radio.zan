using System;
using Gui;
namespace Gui.Widget;
[GuiKind("Radio")]
public class Radio : InteractiveControl {
    [GuiKind("RadioButton")]
    public static Control CreateRadioButton() { return new Radio(null, 0, "", true); }
    public override Control CreateCloneShell() { return new Radio(null, 0, "", buttonForm); }
    public Binding<int> Value;
    public int optionValue;
    public string label;
    public Binding<bool> Bordered;
    public bool buttonForm;
    public override int StyleDisplay() { return 1; } // CSS display: flex
    public override int StyleFlexDir() { return 0; } // flex-direction: row
    private void InitRadio(Binding<int> value, int ov, string lbl, bool button) {
        this.InitInteractive(lbl);
        Value = 0;
        if (value != null) { Value = value; }
        optionValue = ov;
        label = lbl;
        Bordered = false;
        buttonForm = button;
        if (button) { this.ClassName = "radiobutton align-center justify-center"; }
        this.BuildNodes();
    }
    public void BuildNodes() {
        this.RemoveAll();
        if (!buttonForm) { this.Add(new RadioIndicator(this)); }
        this.SetLabel(label);
    }
    public Radio() { InitRadio(null, 0, "", false); }
    public Radio(int ov, string lbl) { InitRadio(null, ov, lbl, false); }
    public Radio(Binding<int> value, int ov, string lbl) { InitRadio(value, ov, lbl, false); }
    public Radio(Binding<int> value, int ov, string lbl, bool button) { InitRadio(value, ov, lbl, button); }
    public bool IsSelected() { return Value.Get() == optionValue; }
    public void SetSelected(bool sel) {
        if (sel) { this.Select(); }
    }
    public void SetLabel(string v) {
        label = v;
        for (int i = 0; i < this.ChildCount(); i = i + 1) {
            if (this.ChildAt(i) is Label) {
                ((Label)this.ChildAt(i)).SetProp("text", v);
                return;
            }
        }
        if (v != "") {
            Label caption = new Label(v);
            if (buttonForm) { caption.ClassName = "radiobutton-label"; }
            this.Add(caption);
        }
    }
    public override void CloneContentTo(Control target, CloneTreeFn clone) {
    }
    public override string Kind() { return buttonForm ? "RadioButton" : "Radio"; }
    private void ApplyVariants() {
        this.ApplySizeClass();
        if (!buttonForm && Bordered != null && Bordered.Get()) { this.AddClass("bordered"); }
        else { this.RemoveClass("bordered"); }
    }
    public override void SyncBinding() {
        base.SyncBinding();
        this.ApplyVariants();
        if (!buttonForm) { return; }
        if (this.IsSelected()) {
            this.AddClass("selected");
        } else {
            this.RemoveClass("selected");
        }
    }
    public void Select() {
        if (Value.Get() == optionValue) { return; }
        Value.Set(optionValue);
        Change.Raise(this);
        if (parent != null) { parent.OnChildEvent(this, "Change"); }
    }
    protected override List<PropSpec> DefineProps() {
        List<PropSpec> ps = new List<PropSpec>();
        ps.Add(PropSpec.Text("label", "Label").Field("label").Setter("SetLabel").Also("text"));
        ps.Add(PropSpec.Int("option", "Option").Field("optionValue"));
        ps.Add(PropSpec.Int("value", "Selected").DefaultBinding().Field("Value").Also("data"));
        ps.Add(this.SizeProp());
        if (!buttonForm) {
            ps.Add(PropSpec.BoolField("Bordered"));
        }
        return ps;
    }
    public override void OnClick(RoutedEventArgs e) {
        if (this.IsDisabled()) { return; }
        if (Value.Get() != optionValue) {
            this.Select();
            App a = this.FindApp();
            if (a != null) { a.RequestRedraw(); }
        }
        e.Handle();
    }
    public override void OnKeyDown(RoutedEventArgs e) {
        if (!this.IsDisabled() && (e.keyCode == 32 || e.keyCode == 13)) {
            if (Value.Get() != optionValue) {
                this.Select();
                App a = this.FindApp();
                if (a != null) { a.RequestRedraw(); }
            }
            e.Handle();
            return;
        }
        base.OnKeyDown(e);
    }
    public override int InputFocusCapabilities() { return 1; }
}
public class RadioIndicator : Control {
    private weak Radio owner;
    private ChoiceMark dotNode;
    private ChoiceVisualMotion dotMotion = new ChoiceVisualMotion();
    private bool selected;
    public override int StyleDisplay() { return 1; } // CSS display: flex
    public override int StyleFlexDir() { return 0; } // flex-direction: row
    protected override Control SurfaceInputOwner() { return owner; }
    public RadioIndicator(Radio o) {
        owner = o;
        this.InitControl("indicator");
        this.ClassName = "radio-indicator align-center justify-center";
        dotNode = new ChoiceMark { ClassName = "radio-dot" };
        this.Add(dotNode);
    }
    public override void SyncBinding() {
        base.SyncBinding();
        selected = owner != null && owner.IsSelected();
        if (selected) { this.AddClass("selected"); }
        else { this.RemoveClass("selected"); }
        this.SetSurfaceTransitionKey(selected ? 2 : 1);
        dotNode.Visible = selected || dotNode.Level > 0;
    }
    public override void OnPaint(App app) {
        if (bw <= 0 || bh <= 0) { return; }
        StyleBox style = this.Box(app);
        dotNode.Level = dotMotion.Sample(app, selected ? 1000 : 0,
            this.IsDisabled() ? 0 : style.transitionMs, style.easing);
        if (dotMotion.Active()) { app.RequestAnimationFrameIn(bx, by, bw, bh); }
    }
}
