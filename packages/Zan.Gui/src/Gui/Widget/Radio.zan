using System;
using Gui;

namespace Gui.Widget;

// 单选按钮组件：一个类、两种形态，形态差异纯 CSS——
// 圆点形态（`radio` 样式族：RadioIndicator 圆环 + 标签）与
// 连体按钮段形态（`radiobutton` 样式族：单标签节点，整段即盒）。
// 组态由 RadioGroup 统一（Buttons 开关），也支持独立使用
// （自持信号 + `data` 双向绑定）。
//
// 基础用法：
//   Radio r = new Radio(1, "选项一");
//   r.Change += () => { OnSelected(); };
//
// 响应式数据绑定：
//   r.data = form.selectedOption;
//
// 复合互嵌（DOM 组合，圆点形态）：
//   Radio custom = new Radio(2, "").With(new Label("VIP会员")).With(new Tag("推荐"));
//
// 样式类：
//   .tiny .small .medium .large (尺寸档位)
//   .bordered                   (边框变体，圆点形态)
public class Radio : InteractiveControl {
    public SignalInt model;
    public Binding<int> data;
    public int optionValue;
    public string label;
    public Binding<bool> Bordered;
    // 连体按钮段形态：true 时 Kind() 报 "RadioButton"（CSS 类型选择器
    // 与序列化 kind 都按段形态走），子节点只有标签，无圆环。
    public bool buttonForm;

    public override int StyleDisplay() { return 1; } // CSS display: flex
    public override int StyleFlexDir() { return 0; } // flex-direction: row

    private void InitRadio(SignalInt m, int ov, string lbl, bool button) {
        this.InitInteractive(lbl);
        model = m != null ? m : new SignalInt(0);
        optionValue = ov;
        label = lbl;
        Bordered = false;
        buttonForm = button;
        if (button) {
            this.ClassName = "radiobutton align-center justify-center";
        }
        this.BuildNodes();
    }

    // 按形态（重）建子节点：圆点 = 圆环 + 标签；按钮段 = 标签。
    // 形态切换与标签变更都经这里保持子树与状态一致。
    public void BuildNodes() {
        this.children.Clear();
        if (buttonForm) {
            if (label != "") {
                Label ln = new Label(label);
                ln.ClassName = "radiobutton-label";
                this.Add(ln);
            }
            return;
        }
        this.Add(new RadioIndicator(this));
        if (label != "") {
            this.Add(new Label(label));
        }
    }

    public Radio() {
        InitRadio(null, 0, "", false);
    }

    public Radio(int ov, string lbl) {
        InitRadio(null, ov, lbl, false);
    }

    public Radio(SignalInt m, int ov, string lbl) {
        InitRadio(m, ov, lbl, false);
    }

    // 连体按钮段形态构造（el-radio-button 对应物；一般由
    // RadioGroup 按钮形态经 MakeItem 造，独立段也可自持信号）。
    public Radio(SignalInt m, int ov, string lbl, bool button) {
        InitRadio(m, ov, lbl, button);
    }

    public bool IsSelected() { return model.Get() == optionValue; }

    public void SetSelected(bool sel) {
        if (sel) { this.Select(); }
    }

    public void SetLabel(string v) {
        label = v;
        for (int i = 0; i < children.Count; i = i + 1) {
            if (children[i] is Label) {
                ((Label)children[i]).Text = v;
                return;
            }
        }
    }

    // 控件类型标识：段形态报 "RadioButton"（HTML `<radiobutton>` 与
    // 设计器 kind 的序列化往返不变），圆点形态报 "Radio"。
    public override string Kind() {
        return buttonForm ? "RadioButton" : "Radio";
    }

    private void ApplyVariants() {
        this.ApplySizeClass();
        if (!buttonForm && Bordered != null && Bordered.Get()) { this.AddClass("bordered"); }
    }

    public override void SyncBinding() {
        base.SyncBinding();
        if (!buttonForm) { return; }
        // 段形态的选中态是自己的类（`.radiobutton.selected`，与
        // `:checked` 双通道并存）；圆点形态的状态类由 RadioIndicator
        // 自己的 SyncBinding 维护。
        if (this.IsSelected()) {
            this.AddClass("selected");
        } else {
            this.RemoveClass("selected");
        }
    }

    public void Select() {
        if (model.Get() == optionValue) { return; }
        model.Set(optionValue);
        if (data != null) { data.Set(optionValue); }
        Change.RaiseS(this);
        if (parent != null) { parent.OnChildEvent(this, "Change"); }
    }

    public override List<PropSpec> Props() {
        List<PropSpec> ps = new List<PropSpec>();
        PropSpec text = PropSpec.Text("label", "Label");
        text.str = label;
        text.Also("text");
        ps.Add(text);
        PropSpec opt = PropSpec.Int("option", "Option");
        opt.num = optionValue;
        ps.Add(opt);
        PropSpec sel = PropSpec.Int("value", "Selected");
        if (data != null) { sel.num = data; } else { sel.snum = model; }
        ps.Add(sel);
        ps.Add(this.SizeProp());
        if (!buttonForm) {
            PropSpec bd = PropSpec.Bool("bordered", "Bordered");
            bd.flag = Bordered;
            ps.Add(bd);
        }
        return ps;
    }

    public override void OnClick(RoutedEventArgs e) {
        if (this.IsDisabled()) { return; }
        if (model.Get() != optionValue) {
            this.Select();
            App a = this.FindApp();
            if (a != null) { a.RequestRedraw(); }
        }
        e.Handle();
    }

    public override void OnKeyDown(RoutedEventArgs e) {
        if (!this.IsDisabled() && (e.keyCode == 32 || e.keyCode == 13)) {
            if (model.Get() != optionValue) {
                this.Select();
                App a = this.FindApp();
                if (a != null) { a.RequestRedraw(); }
            }
            e.Handle();
            return;
        }
        base.OnKeyDown(e);
    }

    public override void OnPaint(App app) {
        int id = this.CommonId();
        bool off = this.IsDisabled();
        this.ApplyVariants();
        SyncBinding();
        if (!off) { app.focus.RegisterFocusable(id); }
        string a11y = this.EffectiveA11yRole("radio") + ":" + this.EffectiveA11yLabel(label);
        app.hitTester.RegisterRectL(id, bx, by, bw, bh, 0, a11y);
        if (!off) { On.Fire(app, id, this); }
    }
}

// 单选框指示器（小圆环）：纯 Flex 节点，完全由 CSS 盒模型渲染。
public class RadioIndicator : Control {
    Radio owner;
    Control dotNode;

    public override int StyleDisplay() { return 1; } // CSS display: flex
    public override int StyleFlexDir() { return 0; } // flex-direction: row

    public RadioIndicator(Radio o) {
        owner = o;
        this.InitControl("indicator", 1);
        this.ClassName = "radio-indicator align-center justify-center";
        dotNode = new Control { ClassName = "radio-dot" };
        this.Add(dotNode);
    }

    public override void SyncBinding() {
        base.SyncBinding();
        if (owner != null && owner.IsSelected()) {
            this.AddClass("selected");
            if (dotNode != null) { dotNode.Visible = true; }
        } else {
            this.RemoveClass("selected");
            if (dotNode != null) { dotNode.Visible = false; }
        }
    }
}
