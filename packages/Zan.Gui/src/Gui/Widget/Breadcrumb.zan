using System;
using Gui;

namespace Gui.Widget;

// 面包屑导航：纯 Flex 横向容器，由 BreadcrumbItem 与分隔符声明式子节点构成。
// 彻底物理消除手算坐标（cx, cy, cw, ch）、逐帧 DrawGlyphIn 与手动 Arrange 循环。
public class Breadcrumb : Control {
    public List<string> items;
    public string Separator;

    public override int StyleDisplay() { return 1; } // CSS display: flex
    public override int StyleFlexDir() { return 0; } // flex-direction: row

    private void InitBreadcrumb() {
        this.InitControl("breadcrumb", 1);
        items = new List<string>();
        Separator = "chevron-right";
    }

    public Breadcrumb() { InitBreadcrumb(); }

    public override Control Add(Control c) {
        if (this.children.Count > 0 && Separator != "") {
            IconView sep = new IconView(Separator, 14);
            sep.ClassName = "breadcrumb-separator";
            base.Add(sep);
        }
        return base.Add(c);
    }

    public Breadcrumb AddItem(BreadcrumbItem it) {
        this.Add(it);
        return this;
    }

    public void AddItem(string label) {
        items.Add(label);
        BreadcrumbItem it = new BreadcrumbItem(label);
        if (items.Count > 1) {
            it.ClassName = "breadcrumb-item";
        }
        this.Add(it);
    }

    public Breadcrumb(List<string> labels) : this() {
        if (labels != null) {
            for (int i = 0; i < labels.Count; i = i + 1) {
                this.AddItem(labels[i]);
            }
        }
    }

    public override void CloneContentTo(Control target, CloneTreeFn clone) {
        Breadcrumb copy = (Breadcrumb)target;
        copy.RemoveAll();
        copy.items = new List<string>();
        for (int i = 0; i < items.Count; i = i + 1) { copy.items.Add(items[i]); }
        for (int i = 0; i < children.Count; i = i + 1) {
            if (!(children[i] is BreadcrumbItem)) { continue; }
            BreadcrumbItem source = (BreadcrumbItem)children[i];
            BreadcrumbItem item = new BreadcrumbItem(source.Text(), source.Href());
            item.name = source.name;
            item.Class = source.Class;
            item.slotName = source.slotName;
            if (source.Text() == "") { source.CloneContentTo(item, clone); }
            copy.Add(item);
        }
    }

    public override string Kind() { return "Breadcrumb"; }

    public override List<PropSpec> Props() {
        List<PropSpec> ps = new List<PropSpec>();
        ps.Add(PropSpec.Text("items", "Items (comma separated)"));
        PropSpec sep = PropSpec.Text("separator", "Separator icon");
        sep.str = Separator;
        ps.Add(sep);
        return ps;
    }

    public override string GetExtra(string key) {
        if (key == "items") { return string.Join(",", items); }
        return "";
    }

    public override bool SetExtra(string key, string val) {
        if (key != "items") { return false; }
        List<string> parts = val.Split(",");
        items = new List<string>();
        this.RemoveAll();
        if (val == "") { return true; }
        for (int i = 0; i < parts.Count; i = i + 1) {
            this.AddItem(parts[i]);
        }
        return true;
    }
}
