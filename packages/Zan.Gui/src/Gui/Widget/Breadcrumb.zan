using System;
using Gui;

namespace Gui.Widget;

// 面包屑导航：同级盒子上的面包屑项用分隔字形连接。
// 面包屑项、当前项和分隔符都是样式部件
// （`breadcrumb::item`、`::current`、`::separator`），皮肤可重设，
// 代码侧只是简单赋值：
// b.Separator = "slash";
public class Breadcrumb : Control {
    // 面包屑文本，按显示顺序；最后一项用 `::current` 样式绘制。
    public List<string> items;
    // 绘制在面包屑项之间的字形。
    public string Separator;

    // 初始化：空清单，分隔符默认右箭头（chevron-right）。
    private void InitBreadcrumb() {
        this.InitControl("breadcrumb", 1);
        items = new List<string>();
        Separator = "chevron-right";
    }

    // 空面包屑（之后 AddItem/Of）。
    public Breadcrumb() { InitBreadcrumb(); }

    // 追加面包屑条目（覆写 Control.Add，保持 ABI 与多态一致）。
    public override Control Add(Control c) {
        return base.Add(c);
    }

    public Breadcrumb AddItem(BreadcrumbItem it) {
        base.Add(it);
        return this;
    }

    // 命名为 AddItem（而非 Add），以免遮蔽 Control.Add(Control)。
    public void AddItem(string label) {
        items.Add(label);
    }

    // 根据现有标签列表构建一个面包屑。
    public static Breadcrumb Of(List<string> labels) {
        Breadcrumb b = new Breadcrumb();
        for (int i = 0; i < labels.Count; i = i + 1) { b.AddItem(labels[i]); }
        return b;
    }

    // 覆写：行高 = 字体高，宽度 = 各项文本宽 + 分隔符与间距之和。
    public override void OnMeasure(App app) {
        Theme t = app.theme;
        StyleBox s = this.ResolveStyleAs(app, "breadcrumb", Class,
                                         Style.SNormal());
        int fs = s.FontOr(Style.FontFallback(app, "medium"));
        int lineH = Canvas.FontHeight(fs);
        int maxH = lineH;
        int w = 0;

        if (children.Count > 0) {
            for (int i = 0; i < children.Count; i = i + 1) {
                Control c = children[i];
                c.OnMeasure(app);
                if (i > 0) { w = w + t.iconSizeSmall + t.gapSmall; }
                w = w + c.prefW;
                if (c.prefH > maxH) { maxH = c.prefH; }
            }
        } else {
            for (int i = 0; i < items.Count; i = i + 1) {
                if (i > 0) { w = w + t.iconSizeSmall + t.gapSmall; }
                w = w + Canvas.MeasureText(items[i], fs);
            }
        }
        prefH = maxH;
        prefW = s.WidthOr(w);
    }

    // 覆写：一行内依次画分隔字形与各项文本/子组件，末项用 current 样式。
    public override void OnPaint(App app) {
        Canvas c = app.canvas;
        Theme t = app.theme;
        string cls = Class;
        StyleBox s = this.ResolveStyleAs(app, this.StyleType(), cls, Style.SNormal());
        StyleBox it = Style.Part(app, "breadcrumb", "item", "", cls, "",
                                 Style.SNormal());
        StyleBox cu = Style.Part(app, "breadcrumb", "item", "", cls + " current",
                                 "", Style.SNormal());
        StyleBox sp = Style.Part(app, "breadcrumb", "separator", "", cls, "",
                                 Style.SNormal());

        int fs = s.FontOr(Style.FontFallback(app, "medium"));
        int lineH = Canvas.FontHeight(fs);
        int gap = s.GapOr(t.gapSmall);
        int sepBox = sp.WidthOr(t.iconSizeSmall + app.Scale(4));
        int cx = bx;

        if (children.Count > 0) {
            for (int i = 0; i < children.Count; i = i + 1) {
                Control kid = children[i];
                if (i > 0) {
                    c.DrawGlyphIn(Separator, cx, by, sepBox, bh,
                                  sp.FontOr(Style.FontFallback(app, "small")),
                                  sp.FgOr(0));
                    cx = cx + sepBox + gap;
                }
                int kw = kid.prefW > 0 ? kid.prefW : app.Scale(60);
                int kh = kid.prefH > 0 ? kid.prefH : bh;
                int ky = by + (bh - kh) / 2;
                kid.Arrange(cx, ky, kw, kh);
                kid.RenderTree(app);
                cx = cx + kw + gap;
            }
            return;
        }

        for (int i = 0; i < items.Count; i = i + 1) {
            if (i > 0) {
                c.DrawGlyphIn(Separator, cx, by, sepBox, lineH,
                              sp.FontOr(Style.FontFallback(app, "small")),
                              sp.FgOr(0));
                cx = cx + sepBox + gap;
            }
            int color = it.FgOr(0);
            if (i == items.Count - 1) { color = cu.FgOr(0); }
            int tw = Canvas.MeasureText(items[i], fs);
            c.DrawTextCentered(cx, by, tw, lineH, items[i], color, fs);
            cx = cx + tw + gap;
        }
    }

    // ---- 设计器 / 序列化模型 -------------------------------------

    // 控件类型标识（序列化/设计器用）。
    public override string Kind() { return "Breadcrumb"; }

    // 覆写：返回设计器属性清单（项清单 / 分隔符 / 类）。
    public override List<PropSpec> Props() {
        List<PropSpec> ps = new List<PropSpec>();
        ps.Add(PropSpec.Text("items", "Items (comma separated)"));
        PropSpec sep = PropSpec.Text("separator", "Separator icon");
        sep.str = Separator;
        ps.Add(sep);
        return ps;
    }

    // 面包屑是列表，因此以逗号分隔的单个值存取。
    public override string GetExtra(string key) {
        if (key == "items") { return string.Join(",", items); }
        return "";
    }

    // 覆写：写回扩展属性，"items" 按逗号拆分为项清单。
    public override bool SetExtra(string key, string val) {
        if (key != "items") { return false; }
        items = val.Split(",");
        return true;
    }
}
