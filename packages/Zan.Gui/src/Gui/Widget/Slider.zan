using System.Collections.Generic;
using System;
using Gui;
namespace Gui.Widget;
public class Slider : Control {
    public override Control CreateCloneShell() { return new Slider(); }
    public int minVal;
    public int maxVal;
    public Binding<int> Value;
    public Binding<int> HighValue;
    public Control trackNode;
    public Control fillNode;
    public Control thumbNode;
    public Control hiThumbNode;
    // 值变化时触发（C# 风格：`s.Change += h;`）。
    [Event]
    public UiEvent Change;
    // 拖拽/定位手势正常松开时触发（捕获允许在控件外完成；取消不触发）。
    [Event]
    public UiEvent DragEnd;
    public int step;
    public bool range;
    public bool vertical;
    public bool reverse;
    public bool tooltip;
    public bool showTooltip;
    public string tipFormat;
    public bool stepMark;
    public bool keyboard;
    public List<SliderMarkItem> marks;
    public string marksSpec;
    public int dragThumb;
    public int lastEdited;
    public static int MarkCap() { return 24; }
    public int Quantize(int v) {
        if (stepMark && marks.Count > 0) {
            v = this.NearestMarkVal(v);
        } else if (step > 0) {
            int k = (v - minVal + step / 2) / step;
            v = minVal + k * step;
        }
        if (v < minVal) { v = minVal; }
        if (v > maxVal) { v = maxVal; }
        return v;
    }
    public int NearestMarkVal(int v) {
        int best = marks[0].value;
        int bd = 2000000000;
        for (int i = 0; i < marks.Count; i = i + 1) {
            int d = marks[i].value - v;
            if (d < 0) { d = 0 - d; }
            if (d < bd) { bd = d; best = marks[i].value; }
        }
        return best;
    }
    public int NextMarkVal(int v, bool up) {
        int best = up ? maxVal : minVal;
        for (int i = 0; i < marks.Count; i = i + 1) {
            int mv = marks[i].value;
            if (up) {
                if (mv > v && mv <= best) { best = mv; }
            } else {
                if (mv < v && mv >= best) { best = mv; }
            }
        }
        return best;
    }
    public int StepUpVal(int v) {
        if (stepMark && marks.Count > 0) { return this.NextMarkVal(v, true); }
        int s = step > 0 ? step : 1;
        return v + s;
    }
    public int StepDownVal(int v) {
        if (stepMark && marks.Count > 0) { return this.NextMarkVal(v, false); }
        int s = step > 0 ? step : 1;
        return v - s;
    }
    public int Span() {
        int r = maxVal - minVal;
        if (r < 1) { r = 1; }
        return r;
    }
    public int FracOf(int v) {
        int f = (v - minVal) * 1000 / Span();
        if (f < 0) { f = 0; }
        if (f > 1000) { f = 1000; }
        return f;
    }
    public int PxAt(int f, int pos, int len) {
        int off = f * len / 1000;
        if (vertical) {
            if (reverse) { return pos + off; }
            return pos + len - off;
        }
        if (reverse) { return pos + len - off; }
        return pos + off;
    }
    public int ValAt(int p, int pos, int len) {
        int rel = p - pos;
        if (rel < 0) { rel = 0; }
        if (rel > len) { rel = len; }
        if (vertical != reverse) { rel = len - rel; }
        if (len <= 0) { return this.Quantize(minVal); }
        int delta = (int)(((long)rel * this.Span() + len / 2) / len);
        return this.Quantize(minVal + delta);
    }
    public string TipText(int v) {
        string num = Convert.ToString(v);
        if (tipFormat == null || tipFormat == "") { return num; }
        return tipFormat.Replace("{v}", num);
    }
    private void InitSlider(int lo, int hi) {
        this.InitControl("slider");
        if (hi < lo) { hi = lo; }
        minVal = lo;
        maxVal = hi;
        Value = lo;
        HighValue = hi;
        wiresOwnEvents = true;
        Change = new UiEvent();
        DragEnd = new UiEvent();
        step = 0;
        range = false;
        vertical = false;
        reverse = false;
        tooltip = true;
        showTooltip = false;
        tipFormat = "";
        stepMark = false;
        keyboard = true;
        marks = new List<SliderMarkItem>();
        marksSpec = "";
        dragThumb = 0;
        lastEdited = 1;
        this.ClassName = "slider";
        trackNode = new Control { ClassName = "slider-track" };
        trackNode.NoOverlapCheck();
        fillNode = new Control { ClassName = "slider-fill" };
        thumbNode = new Control { ClassName = "slider-thumb" };
        thumbNode.NoOverlapCheck();
        trackNode.Add(fillNode);
        this.Add(trackNode);
        this.Add(thumbNode);
    }
    public Slider() : this(0, 100) { }
    public Slider(int lo, int hi) { InitSlider(lo, hi); }
    public int Minimum {
        get { return minVal; }
        set { minVal = value; }
    }
    public int Maximum {
        get { return maxVal; }
        set { maxVal = value; }
    }
    public int Step {
        get { return step; }
        set { step = value; }
    }
    public bool IsRange {
        get { return range; }
        set { range = value; }
    }
    public bool IsVertical {
        get { return vertical; }
        set { vertical = value; }
    }
    public bool IsReverse {
        get { return reverse; }
        set { reverse = value; }
    }
    public bool ShowTooltip {
        get { return showTooltip; }
        set { showTooltip = value; }
    }
    public string TooltipFormat {
        get { return tipFormat; }
        set { tipFormat = value != null ? value : ""; }
    }
    public bool StepOnMarks {
        get { return stepMark; }
        set { stepMark = value; }
    }
    public string MarksSpec {
        get { return this.MarksText(); }
        set { this.SetMarksText(value); }
    }
    public int Low() { return Value.Get(); }
    public int High() { return range ? HighValue.Get() : Value.Get(); }
    public void SetValue(int v) {
        v = this.Quantize(v);
        Value.Set(v);
    }
    public void SetRange(int lo, int hi) {
        lo = this.Quantize(lo);
        hi = this.Quantize(hi);
        if (hi < lo) { int tmp = lo; lo = hi; hi = tmp; }
        Value.Set(lo);
        HighValue.Set(hi);
    }
    public void AddMark(int v, string label) {
        List<SliderMarkItem> ms = new List<SliderMarkItem>();
        bool placed = false;
        for (int i = 0; i < marks.Count; i = i + 1) {
            if (marks[i].value == v) {
                ms.Add(new SliderMarkItem(v, label));
                placed = true;
            } else {
                if (!placed && v < marks[i].value) {
                    ms.Add(new SliderMarkItem(v, label));
                    placed = true;
                }
                ms.Add(marks[i]);
            }
        }
        if (!placed) { ms.Add(new SliderMarkItem(v, label)); }
        marks = ms;
        marksSpec = this.MarksText();
    }
    public void ClearMarks() {
        marks = new List<SliderMarkItem>();
        marksSpec = "";
    }
    public int MarkCount() { return marks.Count; }
    public int MarkValueAt(int i) { return marks[i].value; }
    public string MarkLabelAt(int i) { return marks[i].label; }
    public string MarksText() {
        string s = "";
        for (int i = 0; i < marks.Count; i = i + 1) {
            if (s != "") { s = s + "|"; }
            s = s + Convert.ToString(marks[i].value) + "=" + marks[i].label;
        }
        return s;
    }
    public void SetMarksText(string spec) {
        marks = new List<SliderMarkItem>();
        marksSpec = "";
        if (spec == null || spec == "") { return; }
        List<string> parts = spec.Split("|");
        for (int i = 0; i < parts.Count; i = i + 1) {
            string it = parts[i];
            if (it != "") {
                int eq = it.IndexOf("=");
                if (eq > 0) {
                    int mv = Convert.ToInt32(it.Substring(0, eq));
                    string lab = it.Substring(eq + 1, it.Length - eq - 1);
                    this.AddMark(mv, lab);
                }
            }
        }
    }

    public override string EffectiveClass() {
        string classes = base.EffectiveClass();
        if (vertical) { classes = classes + " vertical"; }
        if (this.IsDisabled()) { classes = classes + " disabled"; }
        return classes;
    }
    public override void SyncBinding() {
        base.SyncBinding();
        if (range && hiThumbNode == null) {
            hiThumbNode = new Control { ClassName = "slider-thumb" };
            hiThumbNode.NoOverlapCheck();
            this.Add(hiThumbNode);
        }
        if (hiThumbNode != null) { hiThumbNode.SetShown(range); }
    }
    public override void Arrange(int x, int y, int width, int height) {
        base.Arrange(x, y, width, height);
        int innerX = bx + this.StyleInsetL();
        int innerY = by + this.StyleInsetT();
        int innerW = Math.Max(0, bw - this.StyleInsetL() - this.StyleInsetR());
        int innerH = Math.Max(0, bh - this.StyleInsetT() - this.StyleInsetB());
        int thumbSize = Math.Min(Math.Min(innerW, innerH), thumbNode.StyleWidthIn(innerW));
        int thickness = vertical ? trackNode.StyleWidthIn(innerW) : trackNode.StyleHeightIn(innerH);
        thickness = Math.Min(thickness, vertical ? innerW : innerH);
        int axisStart = (vertical ? innerY : innerX) + thumbSize / 2;
        int axisLength = (vertical ? innerH : innerW) - thumbSize;
        int pLo = this.PxAt(this.FracOf(Value.Get()), axisStart, axisLength);
        int pHi = this.PxAt(this.FracOf(HighValue.Get()), axisStart, axisLength);
        int fillA = range ? pLo : this.PxAt(0, axisStart, axisLength);
        int fillB = range ? pHi : pLo;
        int fillStart = Math.Min(fillA, fillB);
        int fillLength = Math.Max(fillA, fillB) - fillStart;
        if (vertical) {
            int center = innerX + innerW / 2;
            int trackX = center - thickness / 2;
            trackNode.Arrange(trackX, axisStart, thickness, axisLength);
            fillNode.Arrange(trackX, fillStart, thickness, fillLength);
            thumbNode.Arrange(center - thumbSize / 2, pLo - thumbSize / 2, thumbSize, thumbSize);
            if (range && hiThumbNode != null) {
                hiThumbNode.Arrange(center - thumbSize / 2, pHi - thumbSize / 2, thumbSize, thumbSize);
            }
        } else {
            int center = innerY + innerH / 2;
            int trackY = center - thickness / 2;
            trackNode.Arrange(axisStart, trackY, axisLength, thickness);
            fillNode.Arrange(fillStart, trackY, fillLength, thickness);
            thumbNode.Arrange(pLo - thumbSize / 2, center - thumbSize / 2, thumbSize, thumbSize);
            if (range && hiThumbNode != null) {
                hiThumbNode.Arrange(pHi - thumbSize / 2, center - thumbSize / 2, thumbSize, thumbSize);
            }
        }
    }
    public override void CloneContentTo(Control target, CloneTreeFn clone) {
    }

    // 覆写：返回设计器属性清单（量程 / 值与高值 / 步长 / range、vertical、
    // reverse、标记与气泡等选项）。
    protected override List<PropSpec> DefineProps() {
        List<PropSpec> ps = new List<PropSpec>();
        ps.Add(PropSpec.Int("min", "Minimum").Field("minVal"));
        ps.Add(PropSpec.Int("max", "Maximum").Field("maxVal"));
        PropSpec val = PropSpec.Int("value", "Value").DefaultBinding();
        // 属性通道优先指向活的外部绑定（§6.1 单协议）。
        val.Field("Value");
        val.Also("data");
        ps.Add(val);
        ps.Add(PropSpec.Int("valueHigh", "High value")
            .Field("HighValue")
            .WithTip("Range mode's high thumb (Naive UI range value[1])."));
        ps.Add(PropSpec.Int("step", "Step")
            .Field("step")
            .WithTip("Drag/keyboard increment. 0 = any value (Naive UI step prop)."));
        ps.Add(PropSpec.Bool("range", "Range")
            .Field("range")
            .WithTip("Dual thumbs; value = [Low, High] (Naive UI range)."));
        ps.Add(PropSpec.Bool("vertical", "Vertical")
            .Field("vertical")
            .WithTip("Track stands up; needs a real height (Grow/Prefer)."));
        ps.Add(PropSpec.Bool("reverse", "Reverse")
            .Field("reverse")
            .WithTip("Flip the track: min sits at the right / top end."));
        ps.Add(PropSpec.Bool("stepMark", "Step on marks")
            .Field("stepMark")
            .WithTip("Restrict selectable values to marks (Naive UI step=\"mark\")."));
        ps.Add(PropSpec.Bool("tooltip", "Tooltip")
            .Field("tooltip")
            .WithTip("Show the value bubble while dragging / hovering a thumb."));
        ps.Add(PropSpec.Bool("showTooltip", "Always tooltip")
            .Field("showTooltip")
            .WithTip("Keep the value bubble visible (Naive UI show-tooltip)."));
        ps.Add(PropSpec.Bool("keyboard", "Keyboard")
            .Field("keyboard")
            .WithTip("Arrow keys nudge the focused slider; Home/End jump."));
        ps.Add(PropSpec.Text("tipFormat", "Tooltip format")
            .Field("tipFormat")
            .WithTip("Format-tooltip template; \"{v}\" becomes the value, e.g. \"{v}%\"."));
        ps.Add(PropSpec.Text("marks", "Marks").Field("marksSpec").Setter("SetMarksText")
            .WithTip("Pipe-separated value=label pairs (e.g. \"0=cold|50=warm|100=hot\")."));
        return ps;
    }

    // 覆写：测量首选尺寸。
    public override void OnMeasure(App app) {
        this.SyncBinding();
        prefH = vertical ? 160 : 32;
        prefW = vertical ? 32 : 160;
    }
    protected override Control HitTestCore(int x, int y, int pointerType, List<Control> excludedSubtrees) {
        if (!this.StyleVisible() || !this.ContainsPoint(x, y, pointerType)) { return null; }
        return this;
    }
    private void EditValue(App app, int thumb, int value) {
        bool high = range && thumb == 2;
        if (value < minVal) { value = minVal; }
        if (value > maxVal) { value = maxVal; }
        if (high && value < Value.Get()) { value = Value.Get(); }
        if (!high && range && value > HighValue.Get()) { value = HighValue.Get(); }
        int current = high ? HighValue.Get() : Value.Get();
        lastEdited = high ? 2 : 1;
        if (value == current) { return; }
        if (high) { HighValue.Set(value); } else { Value.Set(value); }
        Change.Raise(this);
        app.RequestRedraw();
    }
    private void EditPointer(App app, RoutedEventArgs e) {
        int start = vertical ? trackNode.by : trackNode.bx;
        int length = vertical ? trackNode.bh : trackNode.bw;
        if (length > 0) { this.EditValue(app, dragThumb, this.ValAt(vertical ? e.y : e.x, start, length)); }
    }
    public override void OnPointerDown(RoutedEventArgs e) {
        App app = this.FindApp();
        if (e.handled || this.IsDisabled() || app == null || app.window.EventButton() != 0) { return; }
        this.SyncBinding();
        dragThumb = 1;
        int pos = vertical ? trackNode.by : trackNode.bx;
        int len = vertical ? trackNode.bh : trackNode.bw;
        if (len <= 0) { dragThumb = 0; return; }
        int point = vertical ? e.y : e.x;
        if (range) {
            int lowDistance = point - this.PxAt(this.FracOf(Value.Get()), pos, len);
            int highDistance = point - this.PxAt(this.FracOf(HighValue.Get()), pos, len);
            if (lowDistance < 0) { lowDistance = 0 - lowDistance; }
            if (highDistance < 0) { highDistance = 0 - highDistance; }
            if (highDistance < lowDistance) { dragThumb = 2; }
        }
        base.OnPointerDown(e);
        app.focus.SetFocused(this.WidgetId());
        app.CapturePointer(this, true);
        this.EditPointer(app, e);
        app.RequestRedraw();
        e.Handle();
    }
    public override void OnPointerMove(RoutedEventArgs e) {
        App app = this.FindApp();
        if (e.handled || dragThumb == 0 || app == null || app.GetCapturedPointer() != this) { return; }
        if (this.IsDisabled()) { this.OnPointerCancel(e); return; }
        this.SyncBinding();
        this.EditPointer(app, e);
        e.Handle();
    }
    public override void OnPointerUp(RoutedEventArgs e) {
        App app = this.FindApp();
        if (e.handled || dragThumb == 0 || app == null || app.window.EventButton() != 0) { return; }
        bool complete = !this.IsDisabled() && app.GetCapturedPointer() == this;
        if (complete) {
            this.SyncBinding();
            this.EditPointer(app, e);
            complete = dragThumb > 0 && !this.IsDisabled() && app.GetCapturedPointer() == this;
        }
        base.OnPointerUp(e);
        dragThumb = 0;
        if (app.GetCapturedPointer() == this) { app.ReleasePointerCapture(); }
        if (complete) { DragEnd.Raise(this); }
        app.RequestRedraw();
        e.Handle();
    }
    public override void OnPointerCancel(RoutedEventArgs e) {
        base.OnPointerCancel(e);
        dragThumb = 0;
        App app = this.FindApp();
        if (app != null) {
            if (app.GetCapturedPointer() == this) { app.ReleasePointerCapture(); }
            app.RequestRedraw();
        }
    }
    public override void OnKeyDown(RoutedEventArgs e) {
        App app = this.FindApp();
        if (e.handled || this.IsDisabled() || !keyboard || app == null || !this.IsFocused(app)) { return; }
        int key = e.keyCode;
        if (key != 37 && key != 40 && key != 39 && key != 38 && key != 36 && key != 35) { return; }
        this.SyncBinding();
        int thumb = range && lastEdited == 2 ? 2 : 1;
        int value = thumb == 2 ? HighValue.Get() : Value.Get();
        if (key == 37 || key == 40) { value = this.StepDownVal(value); }
        if (key == 39 || key == 38) { value = this.StepUpVal(value); }
        if (key == 36) { value = minVal; }
        if (key == 35) { value = maxVal; }
        this.EditValue(app, thumb, value);
        e.Handle();
    }
    public override int InputFocusCapabilities() { return 1; }
    public override void OnPaint(App app) {
        if (app == null || this.IsDisabled()) { return; }
        bool interactiveTip = tooltip && (dragThumb > 0 || this.IsHovered(app));
        if (!interactiveTip && !showTooltip) { return; }
        int place = vertical ? Tooltip.Left() : Tooltip.Top();
        int maxW = app.Scale(200);
        if (interactiveTip) {
            int thumb = dragThumb == 2 && range ? 2 : (dragThumb == 1 ? 1 : lastEdited);
            Control node = (thumb == 2 && hiThumbNode != null) ? hiThumbNode : thumbNode;
            if (node == null || node.bw <= 0 || node.bh <= 0) { return; }
            int val = (thumb == 2 && range) ? HighValue.Get() : Value.Get();
            int ax = vertical ? node.bx : node.bx + node.bw / 2;
            int ay = vertical ? node.by + node.bh / 2 : node.by;
            Tooltip.Request(app, ax, ay, this.TipText(val), place, maxW);
            return;
        }
        if (thumbNode != null && thumbNode.bw > 0 && thumbNode.bh > 0) {
            int ax = vertical ? thumbNode.bx : thumbNode.bx + thumbNode.bw / 2;
            int ay = vertical ? thumbNode.by + thumbNode.bh / 2 : thumbNode.by;
            Tooltip.RenderAt(app, ax, ay, this.TipText(Value.Get()), place, maxW);
        }
        if (range && hiThumbNode != null && hiThumbNode.bw > 0 && hiThumbNode.bh > 0) {
            int ax2 = vertical ? hiThumbNode.bx : hiThumbNode.bx + hiThumbNode.bw / 2;
            int ay2 = vertical ? hiThumbNode.by + hiThumbNode.bh / 2 : hiThumbNode.by;
            Tooltip.RenderAt(app, ax2, ay2, this.TipText(HighValue.Get()), place, maxW);
        }
    }
}
