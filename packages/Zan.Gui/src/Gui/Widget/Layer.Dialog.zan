using System;
using Gui;
using Gui.Backend;

namespace Gui.Widget;

// Layer.Dialog.zan - 浮动窗口、模态对话框与弹窗表面绘制分片
public partial class Layer {
    public static void Render(App app, LayerState s) {
        Layer.RenderActive(app, s, true);
    }

    public static void RenderActive(App app, LayerState s, bool active) {
        if (!s.open) {
            s.ReleaseLayerInput();
            // 关闭沿：无论谁置的 open=false（X、宿主、CloseLast/CloseAll、
            // 自动关闭），第一帧启动出场动画；出场期间继续渲染该层的
            // 收场帧（淡出+上滑），走完触发一次 Closed 并真正摘除。
            Layer.ClosingFrame(app, s);
            return;
        }
        if (s.AutoCloseMs > 0 && s.openMs > 0
            && Window.GetTickMs() - s.openMs >= s.AutoCloseMs) {
            Layer.Close(app, s);
            return;
        }
        if (s.modal) { Layer.RenderDialog(app, s); return; }
        Canvas c = app.canvas;
        Theme t = app.theme;

        int W = c.Width();
        int H = c.Height();
        int top = app.titlebarH;
        int bar = Layer.BarH(app);
        int rad = t.borderRadiusLarge;

        // SizeToContent 的现算：窗口可能在画布/DPI 定型（深链启动、
        // 首帧）前建窗，出生几何不可信。渲染沿按当前画布重新量测定
        // 尺寸并居中；用户拖动/缩放/最大化过一次即让位（此后是用户
        // 自己的摆放）。
        if (s.sizeMinW > 0 && s.state == 0 && !s.dragging && !s.sizing) {
            s.ApplySizeToContent(app);
        }
        if (s.autoCenter && s.state == 0 && !s.dragging && !s.sizing) {
            int cx = (W - s.w) / 2;
            int cy = (H - s.h) / 2;
            if (cy < top) { cy = top; }
            if (s.x != cx || s.y != cy) {
                s.x = cx;
                s.y = cy;
                s.sx = cx;
                s.sy = cy;
                app.RequestRedraw();
            }
        }

        int ex = s.x;
        int ey = s.y;
        int ew = s.w;
        int eh = s.h;
        if (s.state == 1) {
            ex = 0; ey = top; ew = W; eh = H - top;
        } else if (s.state == 2) {
            List<int> mp = new List<int>();
            Layer.MinPos(app, s, mp);
            ex = mp[0]; ey = mp[1];
            ew = app.Scale(260); eh = bar;
        }

        // 入场：上升 + 回稳。出场：继续上升加速离场（位移同曲线反向）。
        int entP = Layer.Entrance(app, s);
        ey = ey - (1000 - entP) * app.Scale(10) / 1000;
        if (entP >= 1000) { Layer.NotifyOpened(s); }

        int mx = app.mouseX;
        int my = app.mouseY;
        int ek = app.EventKind();

        int bw = Layer.BtnW(app);
        int closeX = ex + ew - bw;
        int maxX = closeX - bw;
        int minX = maxX - bw;

        // 对指针不透明：吞掉整个 layer 矩形上的所有命中，
        // 使其后面的页面控件不再响应（“透明层”bug）。
        // 最先注册，因此其下的标题栏按钮以及 app 之后绘入
        // 正文的任何组件后注册，能覆盖它。
        app.BlockHitsRect(ex, ey, ew, eh);

        app.hitTester.RegisterRect(
            // 类型 6 = 四向移动光标（IDC_SIZEALL）。此前错用分割条的
            // 类型 5，标题栏悬停显示的是上下缩放箭头。
            s.barId, ex, ey, ew - bw * 3, bar, 6);
        app.hitTester.RegisterRect(
            s.minId, minX, ey, bw, bar, 0);
        app.hitTester.RegisterRect(
            s.maxId, maxX, ey, bw, bar, 0);
        app.hitTester.RegisterRect(
            s.closeId, closeX, ey, bw, bar, 0);
        app.focus.RegisterFocusable(s.minId);
        app.focus.RegisterFocusable(s.maxId);
        app.focus.RegisterFocusable(s.closeId);

        if (!active) { ek = 0; }

        if (active && s.state == 0 && Ui.PressedDown(app, s.barId)) {
            s.dragging = true;
            s.grabDx = mx - s.x;
            s.grabDy = my - s.y;
            // 用户接手摆放：自动居中/重定尺寸都让位。
            s.autoCenter = false;
            s.sizeMinW = 0;
        }

        if (ek == 1 && s.dragging) {
            s.x = mx - s.grabDx;
            s.y = my - s.grabDy;
            // 模拟窗口属于 page layer，因此要完全保持在
            // 父级客户区内：它绝不会被拖出任何边缘。
            int clampMaxX = W - ew;
            int clampMaxY = H - eh;
            if (clampMaxX < 0) { clampMaxX = 0; }
            if (clampMaxY < top) { clampMaxY = top; }
            if (s.x < 0) { s.x = 0; }
            if (s.x > clampMaxX) { s.x = clampMaxX; }
            if (s.y < top) { s.y = top; }
            if (s.y > clampMaxY) { s.y = clampMaxY; }
            ex = s.x; ey = s.y;
            closeX = ex + ew - bw; maxX = closeX - bw; minX = maxX - bw;
            app.RequestRedraw();
        }

        if (active && Ui.Clicked(app, s.closeId)) {
            Layer.Close(app, s);
            return;
        }
        if (active && Ui.Clicked(app, s.maxId)) {
            if (s.state == 1) {
                s.state = 0;
                s.x = s.sx; s.y = s.sy; s.w = s.sw; s.h = s.sh;
            } else {
                if (s.state == 0) {
                    s.sx = s.x; s.sy = s.y; s.sw = s.w; s.sh = s.h;
                }
                s.state = 1;
                s.autoCenter = false;
                s.sizeMinW = 0;
            }
            app.RequestRedraw();
        } else if (active && Ui.Clicked(app, s.minId)) {
            if (s.state == 2) {
                s.state = 0;
            } else {
                if (s.state == 0) {
                    s.sx = s.x; s.sy = s.y; s.sw = s.w; s.sh = s.h;
                }
                s.state = 2;
            }
            app.RequestRedraw();
        }
        if (active && s.state == 2 && Ui.Clicked(app, s.barId)) {
            // 最小化只剩左下角一条任务条：点标题即还原。
            // 原几何从未被移动（最小化位置是按槽位现算的），直接回 0 态。
            s.state = 0;
            app.RequestRedraw();
        }
        if (Ui.MouseReleased(app) && s.dragging) {
            s.dragging = false;
            app.RequestRedraw();
        }

        // 缩放：按下把手记起始几何与鼠标位（grabDx/Dy 复用为起始
        // 鼠标位），拖动期间由 ApplyResize 从起始几何现推新矩形。
        if (active && s.state == 0 && ek == 2 && !s.dragging) {
            int dir = 0;
            if (Ui.PressedDown(app, s.rsSEId)) { dir = 4; }
            else if (Ui.PressedDown(app, s.rsSWId)) { dir = 5; }
            else if (Ui.PressedDown(app, s.rsLId)) { dir = 1; }
            else if (Ui.PressedDown(app, s.rsRId)) { dir = 2; }
            else if (Ui.PressedDown(app, s.rsBId)) { dir = 3; }
            if (dir > 0) {
                s.sizing = true;
                s.rDir = dir;
                s.rStartX = s.x;
                s.rStartY = s.y;
                s.rStartW = s.w;
                s.rStartH = s.h;
                s.grabDx = mx;
                s.grabDy = my;
                // 用户接手摆放：自动居中/重定尺寸都让位。
                s.autoCenter = false;
                s.sizeMinW = 0;
            }
        }
        if (ek == 1 && s.sizing) {
            Layer.ApplyResize(app, s, mx, my);
            ex = s.x;
            ey = s.y;
            ew = s.w;
            eh = s.h;
            closeX = ex + ew - bw;
            maxX = closeX - bw;
            minX = maxX - bw;
            app.RequestRedraw();
        }
        if (Ui.MouseReleased(app) && s.sizing) {
            s.sizing = false;
        }

        c.FillRoundRect(ex - app.Scale(1), ey + app.Scale(6), ew + app.Scale(2),
                        eh, rad + app.Scale(4), 0x22000000);
        c.FillRoundRect(ex + app.Scale(1), ey + app.Scale(3), ew - app.Scale(2),
                        eh, rad + app.Scale(2), 0x33000000);

        StyleBox win = Style.Of(app, "layer", "", Style.SNormal());
        StyleBox tbs = Style.Part(app, "layer", "titlebar", "", "", "",
                                  Style.SNormal());
        int titleFont = tbs.FontOr(Style.FontFallback(app, "medium"));
        if (s.dragging && t.glass != 0) {
            c.SurfaceRoundRect(ex, ey, ew, eh, rad, win.bg, win.borderColor,
                               win.BorderWOr(1));
        } else {
            if (ek == 1) { app.ReuseBackdrop(); }
            app.FillGlass(ex, ey, ew, eh, rad, win.bg, 1000);
        }

        c.FillRoundRect(ex, ey, ew, bar, rad, tbs.bg);
        c.FillRect(ex, ey + bar - rad, ew, rad, tbs.bg);
        int stripH = tbs.borderBottomW;
        if (stripH <= 0) { stripH = app.Scale(2); }
        c.FillRect(ex, ey + bar - stripH, ew, stripH, tbs.borderBottomColor);

        int icoS = t.iconSizeSmall;
        c.DrawGlyph("grid", ex + app.Scale(14),
                  ey + (bar - icoS) / 2, icoS, tbs.accent);
        c.DrawText(ex + app.Scale(14) + icoS + t.gapSmall,
                   Canvas.CenterTextY(ey, bar, titleFont),
                   s.title, tbs.fg, titleFont);

        int gl = t.iconSizeCaption + app.Scale(2);
        string minGlyph = "minimize";
        if (s.state == 2) { minGlyph = "restore"; }
        string maxGlyph = "maximize";
        if (s.state == 1) { maxGlyph = "restore"; }
        Layer.CapButton(app, minX, ey, bw, bar, minGlyph, gl, false);
        Layer.CapButton(app, maxX, ey, bw, bar, maxGlyph, gl, false);
        Layer.CapButton(app, closeX, ey, bw, bar, "close", gl, true);

        Layer.RenderLayerBody(app, s, ex, ey, ew, eh, bar);

        if (s.state == 0) {
            int g = app.Scale(5);
            int cg = app.Scale(9);
            app.hitTester.RegisterRect(s.rsLId, ex, ey, g, eh - cg, 4);
            app.hitTester.RegisterRect(s.rsRId, ex + ew - g, ey + bar, g,
                                       eh - bar - g, 4);
            app.hitTester.RegisterRect(s.rsBId, ex + cg, ey + eh - g,
                                       ew - cg * 2, g, 5);
            app.hitTester.RegisterRect(s.rsSEId, ex + ew - cg,
                                       ey + eh - cg, cg, cg, 7);
            app.hitTester.RegisterRect(s.rsSWId, ex, ey + eh - cg, cg, cg, 8);
        }
    }

    // 出场收场帧（closing 层专用）：与 RenderActive 的画法同一套
    // 表面/标题栏/正文，但不注册任何命中区（层已在逻辑上关闭，
    // 点击应穿透到页面）、不画交互按钮的点击态，整体按 outP
    // 淡出并加速上滑（layui isOutAnim 的等价物）。
    public static void RenderClosing(App app, LayerState s, int outP) {
        Canvas c = app.canvas;
        Theme t = app.theme;
        int top = app.titlebarH;
        int bar = Layer.BarH(app);
        int rad = t.borderRadiusLarge;
        int ex = s.x;
        int ew = s.w;
        int eh = s.h;
        int ey = s.y;
        if (s.state == 2) {
            List<int> mp = new List<int>();
            Layer.MinPos(app, s, mp);
            ex = mp[0]; ey = mp[1];
            ew = app.Scale(260); eh = bar;
        }
        // 上滑离场：与入场同一曲线同一幅度（outP 越大越接近原位——
        // 这里用 (1000-outP) 反向叠加，出场即向上漂走）。
        ey = ey - outP * app.Scale(10) / 1000;
        // 表面与阴影整体淡出（乘法衰减——阴影/遮罩是预透明色）。
        int a = 1000 - outP;
        c.FillRoundRect(ex - app.Scale(1), ey + app.Scale(6), ew + app.Scale(2),
                        eh, rad + app.Scale(4), Layer.MulAlpha(0x22000000, a));
        c.FillRoundRect(ex + app.Scale(1), ey + app.Scale(3), ew - app.Scale(2),
                        eh, rad + app.Scale(2), Layer.MulAlpha(0x33000000, a));
        StyleBox win = Style.Of(app, "layer", "", Style.SNormal());
        StyleBox tbs = Style.Part(app, "layer", "titlebar", "", "", "",
                                  Style.SNormal());
        app.FillGlass(ex, ey, ew, eh, rad, win.bg, a);
        c.FillRoundRect(ex, ey, ew, bar, rad, Layer.MulAlpha(tbs.bg, a));
        c.FillRect(ex, ey + bar - rad, ew, rad, Layer.MulAlpha(tbs.bg, a));
        int stripH = tbs.borderBottomW;
        if (stripH <= 0) { stripH = app.Scale(2); }
        c.FillRect(ex, ey + bar - stripH, ew, stripH,
                   Layer.MulAlpha(tbs.borderBottomColor, a));
        int icoS = t.iconSizeSmall;
        int titleFont = tbs.FontOr(Style.FontFallback(app, "medium"));
        c.DrawGlyph("grid", ex + app.Scale(14), ey + (bar - icoS) / 2, icoS,
                    Layer.MulAlpha(tbs.accent, a));
        c.DrawText(ex + app.Scale(14) + icoS + t.gapSmall,
                   Canvas.CenterTextY(ey, bar, titleFont),
                   s.title, Layer.MulAlpha(tbs.fg, a), titleFont);
        Layer.RenderLayerBody(app, s, ex, ey, ew, eh, bar);
    }

    // Layer 正文文本 + 可选的底部按钮（最小化时跳过）。
    public static void RenderLayerBody(App app, LayerState s, int ex, int ey, int ew, int eh, int bar) {
        Canvas c = app.canvas;
        Theme t = app.theme;
        if (s.state != 2) {
            int footH = 0;
            if (s.footer) { footH = Layer.FooterH(app); }
            int bodyBottom = ey + eh - footH;
            c.PushClip(ex + 1, ey + bar, ew - 2, bodyBottom - (ey + bar));
            int bx = ex + app.Scale(20);
            int byy = ey + bar + app.Scale(16);
            StyleBox bodyStyle = Style.Part(app, "layer", "body", "", "", "",
                                            Style.SNormal());
            int bodyFont = bodyStyle.FontOr(Style.FontFallback(app, "medium"));
            if (s.body != "") {
                c.DrawText(bx, byy, s.body, bodyStyle.fg, bodyFont);
            }
            if (s.view != null) {
                int vy = byy;
                if (s.body != "") { vy = byy + app.Scale(28); }
                int vw = ew - app.Scale(40);
                int vh = bodyBottom - vy - app.Scale(8);
                if (vh < 0) { vh = 0; }
                Control body = s.view;
                if (s.wrap == null && body.prefH > vh
                    && body.Kind() != "ScrollColumn") {
                    ScrollColumn sc = new ScrollColumn();
                    sc.With(body);
                    s.wrap = sc;
                }
                if (s.wrap != null) {
                    body = s.wrap;
                } else if (body.prefH > vh) {
                    vh = body.prefH;
                }
                body.RenderInside(app, new Rect(bx, vy, vw, vh));
            }
            if (s.action == 1) {
                app.canvas.DrawStyledText(
                    Style.Of(app, "label", "secondary", Style.SNormal()),
                    bx, byy + app.Scale(28), "confirmed",
                    bodyStyle.fg, Style.FontFallback(app, "medium"));
            } else if (s.action == 2) {
                app.canvas.DrawStyledText(
                    Style.Of(app, "label", "secondary", Style.SNormal()),
                    bx, byy + app.Scale(28), "cancelled",
                    bodyStyle.fg, Style.FontFallback(app, "medium"));
            }
            c.PopClip();

            if (s.footer) {
                int fy = ey + eh - footH;
                StyleBox foot = Style.Part(app, "layer", "footer", "", "",
                                           "", Style.SNormal());
                c.FillRect(ex + 1, fy, ew - 2, 1, foot.bg);
                int pad = app.Scale(16);
                s.cancelBtn.SetText(s.cancelText);
                s.cancelBtn.Class = "primary outline";
                s.okBtn.SetText(s.okText);
                s.okBtn.Class = "primary";
                s.windowFooter.RenderInside(app, new Rect(ex + pad, fy + (footH - t.heightMedium) / 2, ew - pad * 2, t.heightMedium));
                int cancelId = s.cancelBtn.CommonId();
                if (s.open && Ui.Clicked(app, cancelId)) { s.action = 2; }
                int okId = s.okBtn.CommonId();
                if (s.open && Ui.Clicked(app, okId)) { s.action = 1; }
            }
        }
        s.SetLayerInput(app, s.wrap != null ? s.wrap : s.view, null,
            s.footer ? s.windowFooter : null, ex, ey, ew, eh);
    }

    // 居中的模态对话框：alert / confirm / prompt。将 s.action 设为
    // 1 (OK)、2 (Cancel) 或 3 (关闭 X)；调用方读取后关闭。
    public static void RenderDialog(App app, LayerState s) {
        Canvas c = app.canvas;
        int W = c.Width();
        int H = c.Height();

        int entP = Layer.Entrance(app, s);
        if (entP >= 1000) { Layer.NotifyOpened(s); }

        if (app.EventKind() == 4 && Layer.IsTopmost(app, s)
            && Window.GetTickMs() - Layer.Context(app).photosTick >= 250) {
            Layer.Key(app, app.window.EventKeyCode());
        }

        int w = app.Scale(s.w);
        int h = app.Scale(s.h);
        int availW = W - app.Scale(16) * 2;
        if (w > availW) { w = availW; }
        int availH = H - app.Scale(16) * 2;
        if (h > availH) { h = availH; }
        int x = (W - w) / 2;
        int y = (H - h) / 2 - (1000 - entP) * app.Scale(12) / 1000;

        StyleBox ov = Style.Part(app, "dialog", "overlay", "", "", "",
                                 Style.SNormal());
        c.FillRect(0, 0, W, H, ov.bg);
        int shadeId = app.BlockHitsBelow();
        NativeLayer.Occlude(app, 0, 0, W, H);
        Layer.PaintDialog(app, s, x, y, w, h, 1000, shadeId);
    }

    // 模态对话框的出场收场帧：整屏遮罩与表面按 outP 淡出并上滑
    // （页面窗口 RenderClosing 的对话框对应物，由 ClosingFrame 驱动）。
    // 不注册命中、不消费点击——对话框逻辑上已关闭，页面立即恢复可点。
    public static void RenderDialogExit(App app, LayerState s, int outP) {
        Canvas c = app.canvas;
        int W = c.Width();
        int H = c.Height();
        int a = 1000 - outP;
        int w = app.Scale(s.w);
        int h = app.Scale(s.h);
        int availW = W - app.Scale(16) * 2;
        if (w > availW) { w = availW; }
        int availH = H - app.Scale(16) * 2;
        if (h > availH) { h = availH; }
        int x = (W - w) / 2;
        int y = (H - h) / 2 - outP * app.Scale(12) / 1000;
        StyleBox ov = Style.Part(app, "dialog", "overlay", "", "", "",
                                 Style.SNormal());
        c.FillRect(0, 0, W, H, Layer.MulAlpha(ov.bg, a));
        NativeLayer.Occlude(app, 0, 0, W, H);
        Layer.PaintDialog(app, s, x, y, w, h, a, 0);
    }

    // 对话框的表面绘制：阴影/玻璃/图标标题/正文/嵌入树/操作条/关闭
    // 钮。打开帧（a=1000）与出场收场帧（a<1000，MulAlpha 乘法衰减
    // 预透明色）共用；shadeId 是打开帧 BlockHitsBelow 的返回值供
    // shadeClose 判定，收场帧传 0。嵌入树/按钮自带配色无法外挂
    // alpha，与入场动画一样按不透明绘制。
    private static void PaintDialog(App app, LayerState s, int x, int y, int w, int h,
                            int a, int shadeId) {
        Canvas c = app.canvas;
        Theme t = app.theme;
        int rad = t.borderRadiusLarge;
        string cls = Layer.RoleClass(s.dtype + 2);
        StyleBox surf = Style.Part(app, "dialog", "surface", "", "", "",
                                   Style.SNormal());
        c.FillRoundRect(x + surf.shadowDx, y + surf.shadowDy, w, h, rad,
                        Layer.MulAlpha(surf.shadow, a));
        app.FillGlass(x, y, w, h, rad, surf.bg, a);

        StyleBox icoStyle = Style.Part(app, "dialog", "icon", "", cls, "",
                                       Style.SNormal());
        StyleBox titleStyle = Style.Part(app, "dialog", "title", "", "", "",
                                         Style.SNormal());
        string iconName = Layer.RoleIcon(s.dtype + 2);
        int titleFont = titleStyle.FontOr(Style.FontFallback(app, "large"));

        int pad = t.paddingLarge;
        int ico = t.iconSizeLarge;
        c.DrawGlyph(iconName, x + pad, y + pad, ico,
                    Layer.MulAlpha(icoStyle.fg, a));
        c.DrawText(x + pad + ico + t.gapMedium, y + pad, s.title,
                   Layer.MulAlpha(titleStyle.fg, a), titleFont);

        int bodyY = y + pad + ico + t.gapMedium;
        if (s.body != "") {
            StyleBox bodyStyle = Style.Part(app, "dialog", "body", "", "",
                                            "", Style.SNormal());
            int bodyFont = bodyStyle.FontOr(Style.FontFallback(app, "medium"));
            c.DrawText(x + pad + ico + t.gapMedium, bodyY, s.body,
                       Layer.MulAlpha(bodyStyle.fg, a), bodyFont);
        }

        Control prompt = null;
        if (s.kind == 2) {
            int iy = bodyY + app.Scale(30);
            if (s.promptArea != null) {
                prompt = s.promptArea;
                int ih = y + h - t.heightMedium - pad * 2 - iy;
                if (ih > 0) { s.promptArea.RenderInside(app, new Rect(x + pad, iy, w - pad * 2, ih)); }
            } else if (s.promptInput != null) {
                prompt = s.promptInput;
                s.promptInput.RenderInside(app, new Rect(x + pad, iy, w - pad * 2, t.heightMedium));
            }
        }

        if (s.view != null) {
            int vy = bodyY;
            if (s.body != "") { vy = bodyY + app.Scale(28); }
            int actionH = s.twoButtons || s.altText != ""
                ? t.heightMedium + app.Scale(24) : 0;
            int vh = y + h - pad - actionH - vy;
            if (vh > 0) {
                c.PushClip(x + pad, vy, w - pad * 2, vh);
                Control bodyRoot = s.wrap != null ? s.wrap : s.view;
                bodyRoot.RenderInside(app, new Rect(x + pad, vy,
                    w - pad * 2, vh));
                c.PopClip();
            }
        }

        int by = y + h - t.heightMedium - pad;
        Button okBtn = s.okBtn;
        okBtn.SetText(s.okText);
        okBtn.Class = "primary";
        Button cancelBtn = s.cancelBtn;
        cancelBtn.SetText(s.cancelText);
        Button altBtn = null;
        if (s.altText != "") {
            altBtn = s.altBtn;
            altBtn.SetText(s.altText);
        }

        bool footerChanged = s.okBtn.parent != s.dialogFooter
            || (s.altText != "") != (s.altBtn.parent == s.dialogFooter)
            || s.twoButtons != (s.cancelBtn.parent == s.dialogFooter);
        if (footerChanged) {
            s.CancelLayerInput();
            s.dialogFooter.RemoveAll();
            if (altBtn != null) { s.dialogFooter.Add(altBtn); }
            if (s.twoButtons) { s.dialogFooter.Add(cancelBtn); }
            s.dialogFooter.Add(okBtn);
        }

        s.dialogFooter.RenderInside(app, new Rect(x + pad, by, w - pad * 2, t.heightMedium));
        s.SetLayerInput(app, s.wrap != null ? s.wrap : s.view, prompt,
            s.dialogFooter, x, y, w, h);
        if (altBtn != null && a >= 1000 && Ui.Clicked(app, altBtn.CommonId())) { s.action = 4; }
        if (s.twoButtons && a >= 1000 && Ui.Clicked(app, cancelBtn.CommonId())) { s.action = 2; }
        if (a >= 1000 && Ui.Clicked(app, okBtn.CommonId())) { s.action = 1; }

        int closeId = s.closeId;
        int closeX = x + w - t.heightMedium;
        int closeY = y;
        int closeState = Style.SNormal();
        if (app.focus.IsHovered(closeId)) { closeState = Style.SHover(); }
        StyleBox closeStyle = Style.Part(app, "dialog", "close", "", "", "",
                                         closeState);
        if (closeStyle.bg != 0) {
            c.FillRoundRect(closeX, closeY, t.heightMedium, t.heightMedium,
                            t.borderRadiusLarge,
                            Layer.MulAlpha(closeStyle.bg, a));
        }
        c.DrawGlyphIn("close", closeX, closeY, t.heightMedium,
                            t.heightMedium, t.iconSizeSmall,
                            Layer.MulAlpha(closeStyle.fg, a));
        if (a >= 1000) {
            app.hitTester.RegisterRect(closeId, closeX, closeY,
                                       t.heightMedium, t.heightMedium, 0);
            if (app.EventKind() == 3
                && app.ClickTarget() == closeId) {
                s.action = 3;
            }
            if (s.shadeClose && app.EventKind() == 3
                && app.ClickTarget() == shadeId
                && app.PressTarget() == shadeId
                && !Layer.Inside(app.mouseX, app.mouseY, x, y, w, h)) {
                s.action = 2;
            }
        }
    }

    // 一个内嵌的标题栏按钮：圆角 hover 背景 + 居中字形。
    private static void CapButton(App app, int x, int y, int w, int h,
                          string glyph, int gl, bool danger) {
        Canvas c = app.canvas;
        Theme t = app.theme;
        bool hover = Ui.Over(app, x, y, w, h);
        int inset = app.Scale(5);
        string cls = "";
        if (danger) { cls = "danger"; }
        int state = Style.SNormal();
        if (hover) { state = Style.SHover(); }
        StyleBox s = Style.Part(app, "layer", "cap", "", cls, "", state);
        if (hover && s.bg != 0) {
            c.FillRoundRect(x + inset, y + inset, w - inset * 2, h - inset * 2,
                            t.borderRadiusMedium, s.bg);
        }
        c.DrawGlyphIn(glyph, x, y, w, h, gl, s.fg);
    }
}
