using System;
using Gui;
using Gui.Backend;
namespace Gui.Widget;
public class Spin : Control {
    public override Control CreateCloneShell() { return new Spin(); }
    public int Size;
    public int Accent;
    public Binding<string> Tip;
    private void InitSpin(int size) {
        this.InitControl("spin");
        Size = size;
        Accent = 0;
        Tip = "";
    }
    public Spin() { InitSpin(36); }
    public Spin(int size) { InitSpin(size); }
    public int Diameter() { return this.Diameter(this.App); }
    public int Diameter(App app) {
        app = this.ResolveApp(app);
        if (app == null) { return Size > 0 ? Size : 36; }
        return this.ResolveStyleAs(app, "spin", Class, Style.SNormal())
            .HeightOr(app.Scale(Size));
    }
    public string Caption() {
        if (Tip == null) { return ""; }
        return Tip.Get();
    }
    public int TipFont() { return this.TipFont(this.App); }
    public int TipFont(App app) {
        app = this.ResolveApp(app);
        return Style.Part(app, "spin", "label", "", "", "", Style.SNormal())
            .FontOr(Style.FontFallback(app, "small"));
    }
    public override void OnMeasure(App app) {
        prefW = this.Diameter(app);
        prefH = prefW;
        if (this.Caption() == "") { return; }
        prefH = prefH + app.theme.gapMedium
              + Canvas.FontHeight(this.TipFont(app));
    }
    public override void OnPaint(App app) {
        Canvas c = app.canvas;
        Theme t = app.theme;
        StyleBox s = this.ResolveStyleAs(app, "spin", Class, Style.SNormal());
        StyleBox accentStyle = Style.Part(app, "spin", "accent", "",
                                          Class, "", Style.SNormal());
        StyleBox restStyle = Style.Part(app, "spin", "rest", "",
                                        Class, "", Style.SNormal());
        StyleBox tailStyle = Style.Part(app, "spin", "tail", "",
                                        Class, "", Style.SNormal());
        StyleBox ringStyle = Style.Part(app, "spin", "ring", "",
                                        Class, "", Style.SNormal());
        StyleBox labelStyle = Style.Part(app, "spin", "label", "", "",
                                         "", Style.SNormal());
        int accent = Accent;
        if (accent == 0) { accent = accentStyle.FgOr(s.AccentOr(0)); }
        int rest = restStyle.BgOr(s.BgOr(0));
        string tip = this.Caption();
        int dots = bh;
        if (tip != "") {
            dots = this.Diameter(app);
            int fs = this.TipFont(app);
            c.DrawTextCentered(bx, by + dots + app.theme.gapMedium, bw,
                               Canvas.FontHeight(fs), tip,
                               labelStyle.FgOr(0), fs);
        }
        int box = bw;
        if (dots < box) { box = dots; }
        int cx = bx + bw / 2;
        int cy = by + dots / 2;
        int dotR = box / 8;
        if (dotR < app.Scale(2)) { dotR = app.Scale(2); }
        int radius = box / 2 - dotR - app.Scale(1);
        if (radius < 1) { radius = 1; }
        int phase = app.reducedMotion ? 0 : Spin.DotPhase(app.nowMs);
        for (int i = 0; i < 8; i = i + 1) {
            int px = cx + PivotSafeMul(Spin.OffX(i), radius);
            int py = cy + PivotSafeMul(Spin.OffY(i), radius);
            int d = (phase / 1000 - i + 8) % 8;
            int dc = App.LerpColor(Spin.DotTone(d, accent, tailStyle.FgOr(0),
                                               ringStyle.FgOr(0), rest),
                                   Spin.DotTone((d + 1) % 8, accent, tailStyle.FgOr(0),
                                               ringStyle.FgOr(0), rest), phase % 1000);
            Spin.PaintDot(c, px, py, dotR, app.Scale(1), dc,
                          Spin.DotLevel(phase, i, 0));
        }
        if (!app.reducedMotion && Spin.OnScreen(app, cx, cy, radius)) {
            int span = radius + dotR + app.Scale(2);
            app.RequestAnimationFrameIn(cx - span, cy - span, span * 2, span * 2);
        }
    }
    public static int DotPhase(int nowMs) {
        int elapsed = nowMs % 720;
        if (elapsed < 0) { elapsed = elapsed + 720; }
        return elapsed * 1000 / 90;
    }
    public static int DotLevel(int phase, int dot, int trail) {
        int d = (phase / 1000 - dot + 8) % 8;
        int from = d <= trail ? 1000 : 0;
        int to = (d + 1) % 8 <= trail ? 1000 : 0;
        return App.Lerp(from, to, phase % 1000);
    }
    public static void PaintDot(Canvas canvas, int x, int y, int radius, int growth,
                         int color, int head) {
        if (head > 0 && growth > 0) { canvas.FillCircle(x, y, radius + growth, App.ScaleAlpha(color, head)); }
        canvas.FillCircle(x, y, radius, color);
    }
    public static int DotTone(int distance, int accent, int tail, int ring, int rest) {
        if (distance <= 1) { return accent; }
        if (distance == 2) { return tail; }
        if (distance == 3) { return ring; }
        return rest;
    }
    public static int OffX(int i) {
        switch (i) {
            case 0: return 0;
            case 1: return 707;
            case 2: return 1000;
            case 3: return 707;
            case 4: return 0;
            case 5: return -707;
            case 6: return -1000;
            default: return -707;
        }
    }
    public static int OffY(int i) {
        switch (i) {
            case 0: return -1000;
            case 1: return -707;
            case 2: return 0;
            case 3: return 707;
            case 4: return 1000;
            case 5: return 707;
            case 6: return 0;
            default: return -707;
        }
    }
    // 指示器包围盒与窗口表面重叠时返回 true。
    public static bool OnScreen(int cx, int cy, int radius) {
        return Spin.OnScreen(App.FrameApp(), cx, cy, radius);
    }
    public static bool OnScreen(App app, int cx, int cy, int radius) {
        if (app == null) { app = App.FrameApp(); }
        if (app == null) { return true; }
        int w = app.canvas.Width();
        int h = app.canvas.Height();
        return cx + radius >= 0 && cx - radius <= w
            && cy + radius >= 0 && cy - radius <= h;
    }
    // (offset_x1000 * radius) / 1000，避免溢出意外。
    public static int PivotSafeMul(int per1000, int radius) {
        return (per1000 * radius) / 1000;
    }

    // ---- 设计器 / 序列化模型 -------------------------------------

    // 覆写：返回设计器属性清单（直径 / 说明文字 / 类）。
    protected override List<PropSpec> DefineProps() {
        List<PropSpec> ps = new List<PropSpec>();
        ps.Add(PropSpec.IntField("Size"));
        ps.Add(PropSpec.TextField("Tip"));
        ps.Add(PropSpec.ColorField("Accent")
            .WithTip("Custom accent colour for the spinner dots. 0 = skin default."));
        return ps;
    }
}
