using System;
using Gui;
using Gui.Backend;
namespace Gui.Widget;
public class Spin : Control {
    public override Control CreateCloneShell() { return new Spin(); }
    public int Size;
    public int Accent;
    public Binding<string> Tip;
    private weak App cachedPartApp;
    private int cachedPartGen;
    private int cachedPartScale;
    private int cachedPartDpi;
    private int cachedPartRuleSig;
    private int cachedPartDep;
    private long cachedPartCtxHash;
    private string cachedPartCls;
    private StyleBox cachedPartAccent;
    private StyleBox cachedPartRest;
    private StyleBox cachedPartTail;
    private StyleBox cachedPartRing;
    private StyleBox cachedPartLabel;
    protected override bool UsesBaseFlowOnly() { return this.Kind() == "Spin"; }
    protected override bool UsesBaseSyncBinding() { return this.Kind() == "Spin"; }
    private void InitSpin(int size) {
        this.InitControl("spin");
        Size = size;
        Accent = 0;
        Tip = "";
    }
    public Spin() { InitSpin(36); }
    public Spin(int size) { InitSpin(size); }
    public int Diameter() { return this.Diameter(this.App); }
    public int Diameter(App app) {
        app = this.ResolveApp(app);
        if (app == null) { return Size > 0 ? Size : 36; }
        StyleBox s = this.ResolveStyleCached(app, "spin", Class, Style.SNormal());
        return s.HeightOr(app.Scale(Size));
    }
    public string Caption() {
        if (Tip == null) { return ""; }
        string s = Tip.Get();
        return s != null ? s : "";
    }
    private void EnsurePartStyles(App app) {
        int rsig = app.CurrentStyleRuleSig();
        bool anyMedia = (rsig & 1) != 0;
        if (cachedPartApp == app && cachedPartGen == app.bgThemeGen
            && cachedPartScale == app.metricsScale && cachedPartDpi == app.dpiScale
            && cachedPartRuleSig == rsig && cachedPartCls == Class
            && cachedPartAccent != null
            && ((cachedPartDep == 0 && !anyMedia)
                || cachedPartCtxHash == Style.ContextHashFast(app, cachedPartDep, anyMedia))) {
            return;
        }
        cachedPartAccent = Style.PartRef(app, "spin", "accent", "", Class, "", Style.SNormal());
        cachedPartRest = Style.PartRef(app, "spin", "rest", "", Class, "", Style.SNormal());
        cachedPartTail = Style.PartRef(app, "spin", "tail", "", Class, "", Style.SNormal());
        cachedPartRing = Style.PartRef(app, "spin", "ring", "", Class, "", Style.SNormal());
        cachedPartLabel = Style.PartRef(app, "spin", "label", "", "", "", Style.SNormal());
        int dep = Style.ContextDependencyFor(app, "spin", Class, "");
        int d1 = Style.ContextDependencyFor(app, "spin", "", "");
        if (d1 > dep) { dep = d1; }
        if (dep < 5) {
            cachedPartApp = app;
            cachedPartGen = app.bgThemeGen;
            cachedPartScale = app.metricsScale;
            cachedPartDpi = app.dpiScale;
            cachedPartRuleSig = rsig;
            cachedPartDep = dep;
            cachedPartCtxHash = Style.ContextHashFast(app, dep, anyMedia);
            cachedPartCls = Class;
        } else {
            cachedPartApp = null;
        }
    }
    public int TipFont() { return this.TipFont(this.App); }
    public int TipFont(App app) {
        app = this.ResolveApp(app);
        if (app == null) { return 12; }
        this.EnsurePartStyles(app);
        return cachedPartLabel.FontOr(Style.FontFallback(app, "small"));
    }
    public override void OnMeasure(App app) {
        if (app == null) { return; }
        prefW = this.Diameter(app);
        prefH = prefW;
        if (this.Caption() == "") { return; }
        prefH = prefH + app.theme.gapMedium
              + Canvas.FontHeight(this.TipFont(app));
    }
    public override void OnPaint(App app) {
        if (app == null || app.canvas == null) { return; }
        if (bw <= 0 || bh <= 0) { return; }
        Canvas c = app.canvas;
        StyleBox s = paintedStyle;
        if (s == null) {
            s = this.ResolveStyleCached(app, "spin", Class, Style.SNormal());
        }
        this.EnsurePartStyles(app);
        StyleBox accentStyle = cachedPartAccent;
        StyleBox restStyle = cachedPartRest;
        StyleBox tailStyle = cachedPartTail;
        StyleBox ringStyle = cachedPartRing;
        StyleBox labelStyle = cachedPartLabel;
        int accent = Accent;
        if (accent == 0) { accent = accentStyle.FgOr(s.AccentOr(0)); }
        int rest = restStyle.BgOr(s.BgOr(0));
        int tailFg = tailStyle.FgOr(0);
        int ringFg = ringStyle.FgOr(0);
        string tip = this.Caption();
        int dots = bh;
        if (tip != "") {
            dots = s.HeightOr(app.Scale(Size));
            int fs = labelStyle.FontOr(Style.FontFallback(app, "small"));
            c.DrawTextCentered(bx, by + dots + app.theme.gapMedium, bw,
                               Canvas.FontHeight(fs), tip,
                               labelStyle.FgOr(0), fs);
        }
        int box = bw;
        if (dots < box) { box = dots; }
        int cx = bx + bw / 2;
        int cy = by + dots / 2;
        int dotR = box / 8;
        int minDotR = app.Scale(2);
        if (dotR < minDotR) { dotR = minDotR; }
        int scale1 = app.Scale(1);
        int radius = box / 2 - dotR - scale1;
        if (radius < 1) { radius = 1; }
        int phase = app.reducedMotion ? 0 : Spin.DotPhase(app.nowMs);
        int pDiv = phase / 1000;
        int pMod = phase % 1000;
        for (int i = 0; i < 8; i = i + 1) {
            int px = cx + PivotSafeMul(Spin.OffX(i), radius);
            int py = cy + PivotSafeMul(Spin.OffY(i), radius);
            int d = (pDiv - i + 8) % 8;
            int dc = ColorMath.LerpColor(Spin.DotTone(d, accent, tailFg, ringFg, rest),
                                   Spin.DotTone((d + 1) % 8, accent, tailFg, ringFg, rest), pMod);
            Spin.PaintDot(c, px, py, dotR, scale1, dc,
                          Spin.DotLevel(phase, i, 0));
        }
        if (!app.reducedMotion && Spin.OnScreen(app, cx, cy, radius)) {
            int span = radius + dotR + minDotR;
            app.RequestAnimationFrameIn(cx - span, cy - span, span * 2, span * 2);
        }
    }
    public static int DotPhase(int nowMs) {
        int elapsed = nowMs % 720;
        if (elapsed < 0) { elapsed = elapsed + 720; }
        return elapsed * 1000 / 90;
    }
    public static int DotLevel(int phase, int dot, int trail) {
        int d = (phase / 1000 - dot + 8) % 8;
        int from = d <= trail ? 1000 : 0;
        int to = (d + 1) % 8 <= trail ? 1000 : 0;
        return App.Lerp(from, to, phase % 1000);
    }
    public static void PaintDot(Canvas canvas, int x, int y, int radius, int growth,
                         int color, int head) {
        if (canvas == null) { return; }
        if (head > 0 && growth > 0) {
            canvas.FillCircle(x, y, radius + growth, ColorMath.ScaleAlpha(color, head));
        }
        canvas.FillCircle(x, y, radius, color);
    }
    public static int DotTone(int distance, int accent, int tail, int ring, int rest) {
        if (distance <= 1) { return accent; }
        if (distance == 2) { return tail; }
        if (distance == 3) { return ring; }
        return rest;
    }
    public static int OffX(int i) {
        switch (i) {
            case 0: return 0;
            case 1: return 707;
            case 2: return 1000;
            case 3: return 707;
            case 4: return 0;
            case 5: return -707;
            case 6: return -1000;
            default: return -707;
        }
    }
    public static int OffY(int i) {
        switch (i) {
            case 0: return -1000;
            case 1: return -707;
            case 2: return 0;
            case 3: return 707;
            case 4: return 1000;
            case 5: return 707;
            case 6: return 0;
            default: return -707;
        }
    }
    // 指示器包围盒与窗口表面重叠时返回 true。
    public static bool OnScreen(int cx, int cy, int radius) {
        return Spin.OnScreen(App.FrameApp(), cx, cy, radius);
    }
    public static bool OnScreen(App app, int cx, int cy, int radius) {
        if (app == null) { app = App.FrameApp(); }
        if (app == null || app.canvas == null) { return true; }
        int w = app.canvas.Width();
        int h = app.canvas.Height();
        return cx + radius >= 0 && cx - radius <= w
            && cy + radius >= 0 && cy - radius <= h;
    }
    // (offset_x1000 * radius) / 1000，避免溢出意外。
    public static int PivotSafeMul(int per1000, int radius) {
        return (per1000 * radius) / 1000;
    }

    // ---- 设计器 / 序列化模型 -------------------------------------

    // 覆写：返回设计器属性清单（直径 / 说明文字 / 类）。
    protected override List<PropSpec> DefineProps() {
        List<PropSpec> ps = new List<PropSpec>();
        ps.Add(PropSpec.IntField("Size"));
        ps.Add(PropSpec.TextField("Tip"));
        ps.Add(PropSpec.ColorField("Accent")
            .WithTip("Custom accent colour for the spinner dots. 0 = skin default."));
        return ps;
    }
}
