using System;
using Gui;

namespace Gui.Widget;

// TableCell: 表格单元格 (td / th) DOM 容器。
// 内部支持直接显示文本，更支持任意子组件互嵌（Button, Switch, Badge, Avatar, Tag, Progress 等）。
public class TableCell : Control {
    string text;
    int colWidth;
    bool header;

    TableCell() {
        this.InitControl("table-cell", 1);
        text = "";
        colWidth = 0;
        header = false;
    }

    TableCell(string txt) {
        this.InitControl("table-cell", 1);
        text = txt != null ? txt : "";
        colWidth = 0;
        header = false;
    }

    TableCell(Control content) {
        this.InitControl("table-cell", 1);
        text = "";
        colWidth = 0;
        header = false;
        if (content != null) {
            this.Add(content);
        }
    }

    TableCell(bool isHeader) {
        this.InitControl("table-cell", 1);
        text = "";
        colWidth = 0;
        header = isHeader;
        if (isHeader) {
            this.AddClass("table-header");
        }
    }

    void SetHeader(bool h) {
        header = h;
        if (h) {
            this.AddClass("table-header");
        }
    }

    bool IsHeader() {
        return header;
    }

    void SetText(string t) {
        text = t != null ? t : "";
    }

    string Text() {
        return text;
    }

    void SetWidth(int w) {
        colWidth = w;
        prefW = w;
    }

    int Width() {
        return colWidth > 0 ? colWidth : prefW;
    }

    override string Kind() { return "TableCell"; }

    override void OnMeasure(App app) {
        Theme t = app.theme;
        string partName = header ? "header" : "cell";
        StyleBox cell = Style.Part(app, "table", partName, "", Class, "", Style.SNormal());
        int cellFont = cell.FontOr(Style.FontFallback(app, "medium"));
        int padH = t.paddingSmall * 2;

        int contentW = 0;
        int contentH = Canvas.FontHeight(cellFont);

        if (children.Count > 0) {
            contentW = 0;
            contentH = 0;
            for (int i = 0; i < children.Count; i = i + 1) {
                Control c = children[i];
                c.OnMeasure(app);
                contentW = contentW + c.prefW;
                if (c.prefH > contentH) { contentH = c.prefH; }
            }
        } else if (text != "") {
            contentW = Canvas.MeasureText(text, cellFont);
        }

        prefW = colWidth > 0 ? colWidth : contentW + padH;
        prefH = contentH;
    }

    override void OnPaint(App app) {
        if (bw <= 0 || bh <= 0) { return; }
        Canvas c = app.canvas;
        Theme t = app.theme;
        string partName = header ? "header" : "cell";
        StyleBox cell = Style.Part(app, "table", partName, "", Class, "", Style.SNormal());
        int cellFont = cell.FontOr(Style.FontFallback(app, "medium"));

        c.PushClip(bx, by, bw, bh);

        if (children.Count > 0) {
            // 子组件互嵌：在单元格包含块内自动排布与渲染
            int cx = bx + t.paddingSmall;
            int availW = bw - t.paddingSmall * 2;
            for (int i = 0; i < children.Count; i = i + 1) {
                Control child = children[i];
                int kw = child.prefW > 0 ? child.prefW : availW;
                int kh = child.prefH > 0 ? child.prefH : bh;
                if (kw > availW) { kw = availW; }
                int ky = by + (bh - kh) / 2;
                child.Arrange(cx, ky, kw, kh);
                child.RenderTree(app);
                cx = cx + kw + app.Scale(4);
            }
        } else if (text != "") {
            int maxW = bw - t.paddingSmall * 2;
            int ty = Canvas.CenterTextY(by, bh, cellFont);
            c.DrawText(bx + t.paddingSmall, ty,
                       Ellipsis.Fit(text, maxW, cellFont),
                       cell.FgOr(0), cellFont);
        }

        c.PopClip();
    }
}
