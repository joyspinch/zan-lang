using System;
using Gui;

namespace Gui.Widget;

// 表格单元格（TableCell）：纯声明式对象树与 CSS 盒模型（Flex 行排布）。
// 支持显示文本，更支持任意子组件互嵌（Button, Switch, Badge, Avatar, Tag, Progress 等）。
public class TableCell : Control {
    public string text;
    public int colWidth;
    public bool header;
    public Label textLabel;

    public override int StyleDisplay() { return 1; } // Flex
    public override int StyleFlexDir() { return 0; } // Row

    public TableCell() {
        this.InitControl("table-cell", 1);
        this.ClassName = "table-cell row align-center";
        text = "";
        colWidth = 0;
        header = false;
    }

    public TableCell(string txt) {
        this.InitControl("table-cell", 1);
        this.ClassName = "table-cell row align-center";
        text = txt != null ? txt : "";
        colWidth = 0;
        header = false;
        if (text != "") {
            textLabel = new Label(text);
            textLabel.ClassName = "table-cell-text";
            this.Add(textLabel);
        }
    }

    public TableCell(Control content) {
        this.InitControl("table-cell", 1);
        this.ClassName = "table-cell row align-center";
        text = "";
        colWidth = 0;
        header = false;
        if (content != null) {
            this.Add(content);
        }
    }

    public TableCell(bool isHeader) {
        this.InitControl("table-cell", 1);
        text = "";
        colWidth = 0;
        header = isHeader;
        this.ClassName = "table-cell row align-center " + (isHeader ? "table-header" : "");
    }

    public void SetHeader(bool h) {
        header = h;
        if (h) { this.AddClass("table-header"); } else { this.RemoveClass("table-header"); }
    }

    public bool IsHeader() {
        return header;
    }

    public void SetText(string t) {
        text = t != null ? t : "";
        if (textLabel != null) {
            textLabel.Text = text;
        } else if (text != "") {
            textLabel = new Label(text);
            textLabel.ClassName = "table-cell-text";
            this.Add(textLabel);
        }
    }

    public string Text() {
        return text;
    }

    public void SetWidth(int w) {
        colWidth = w;
        prefW = w;
    }

    public int Width() {
        return colWidth > 0 ? colWidth : prefW;
    }

    public override string Kind() { return "TableCell"; }

    public override void OnPaint(App app) {
        int id = this.CommonId();
        SyncBinding();
        app.focus.RegisterFocusable(id);
        app.hitTester.RegisterRect(id, bx, by, bw, bh, 0);
        On.Fire(app, id, this);
    }
}
