using System;
using Gui;
namespace Gui.Widget;
[GuiKind("TableCell")]
public class TableCell : Control {
    public override Control CreateCloneShell() { return new TableCell(); }
    public string text;
    public int colWidth;
    public bool header;
    public Control Content;
    public Label textLabel;
    private Control appliedContent;
    private string appliedText = "";
    private int appliedWidth = 0;
    private bool appliedHeader = false;
    public string CellText {
        get { return text; }
        set { this.SetText(value); }
    }
    public int ColWidth {
        get { return colWidth; }
        set { this.SetWidth(value); }
    }
    public string Text() { return text; }
    public override int StyleDisplay() { return 1; } // Flex
    public override int StyleFlexDir() { return 0; } // Row
    public TableCell() {
        this.InitControl("table-cell");
        this.ClassName = "table-cell row align-center";
        text = "";
        colWidth = 0;
        header = false;
        grow = true;
    }
    public TableCell(string txt) {
        this.InitControl("table-cell");
        this.ClassName = "table-cell row align-center";
        text = txt != null ? txt : "";
        colWidth = 0;
        header = false;
        grow = true;
        if (text != "") {
            textLabel = new Label(text);
            textLabel.ClassName = "table-cell-text";
            this.Add(textLabel);
            appliedText = text;
        }
    }
    public TableCell(Control content) {
        this.InitControl("table-cell");
        this.ClassName = "table-cell row align-center";
        text = "";
        colWidth = 0;
        header = false;
        grow = true;
        Content = content;
        appliedContent = content;
        if (content != null) { this.Add(content); }
    }
    public TableCell(bool isHeader) {
        this.InitControl("table-cell");
        text = "";
        colWidth = 0;
        header = isHeader;
        appliedHeader = isHeader;
        grow = true;
        this.ClassName = "table-cell row align-center " + (isHeader ? "table-header" : "");
    }
    public void SetHeader(bool h) {
        header = h;
        appliedHeader = h;
        if (h) { this.AddClass("table-header"); } else { this.RemoveClass("table-header"); }
    }
    public bool IsHeader() { return header; }
    public void SetText(string t) {
        text = t != null ? t : "";
        appliedText = text;
        if (textLabel != null) {
            textLabel.Text = text;
        } else if (text != "") {
            textLabel = new Label(text);
            textLabel.ClassName = "table-cell-text";
            this.Add(textLabel);
        }
    }
    public void SetWidth(int w) {
        colWidth = w;
        appliedWidth = w;
        prefW = w;
        prefSet = w > 0;
        grow = w <= 0;
    }
    public int Width() { return colWidth > 0 ? colWidth : prefW; }
    public override void SyncBinding() {
        base.SyncBinding();
        if (appliedHeader != header) { this.SetHeader(header); }
        if (appliedWidth != colWidth) { this.SetWidth(colWidth); }
        if (appliedText != text) { this.SetText(text); }
        if (appliedContent != Content) {
            if (appliedContent != null && appliedContent.parent == this) { this.Remove(appliedContent); }
            appliedContent = Content;
            if (Content != null && Content.parent != this) { this.Add(Content); }
        }
    }
    public override string Kind() { return "TableCell"; }
    protected override List<PropSpec> DefineProps() {
        List<PropSpec> ps = new List<PropSpec>();
        ps.Add(PropSpec.Text("text", "Text").Field("text", 0).Also("label"));
        ps.Add(PropSpec.Int("colWidth", "Column Width").Field("colWidth", 1).Also("width"));
        ps.Add(PropSpec.Bool("header", "Header").Field("header", 2));
        return ps;
    }
    public override string GetProp(string key) {
        if (key == "text" || key == "label") { return text; }
        if (key == "colWidth" || key == "width") { return Convert.ToString(colWidth); }
        if (key == "header") { return PropSpec.Flag(header); }
        return base.GetProp(key);
    }
    public override void SetProp(string key, string val) {
        if (key == "text" || key == "label") { this.SetText(val); return; }
        if (key == "colWidth" || key == "width") { this.SetWidth(Convert.ToInt32(val)); return; }
        if (key == "header") { this.SetHeader(PropSpec.IsOn(val)); return; }
        base.SetProp(key, val);
    }
}
