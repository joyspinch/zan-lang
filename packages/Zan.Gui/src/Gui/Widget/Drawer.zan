using System;
using Gui;

namespace Gui.Widget;

// 现代声明式抽屉组件：对齐 Naive UI n-drawer 与现代侧边交互容器。
// 支持四向贴边（right/left/top/bottom）、半透明遮罩、标题头与关闭按钮、复合内容插槽及底栏操作区。
public class Drawer : Panel {
    public Panel drawerBox;
    public Row headerRow;
    public Label titleLabel;
    public Button closeBtn;
    public Panel contentBox;
    public Row footerRow;
    public string placement;
    public int drawerSize;
    public bool mask;
    private bool appliedOpen;
    public Binding<bool> Opened;
    public UiEvent Open;
    public UiEvent Close;

    public Drawer() {
        this.InitPanel("drawer-overlay", 3);
        this.Grow();
        placement = "right";
        drawerSize = 360;
        mask = true;
        appliedOpen = false;
        Opened = false;

        Open = new UiEvent();
        Close = new UiEvent();

        drawerBox = new Panel("drawer-surface");
        drawerBox.layout = 1;
        drawerBox.flexFlow = 1;
        drawerBox.Class = "card drawer-surface";

        // Header 栏
        titleLabel = new Label("").Title().Bold();
        closeBtn = new Button().Ghost().Small();
        closeBtn.AddClass("drawer-close");
        closeBtn.Icon = "close";
        closeBtn.Tip = "Close";
        DialogAction closeBtnAction = new DialogAction();
        closeBtnAction.drawer = this;
        closeBtn.Click.Add(closeBtnAction.CloseDrawer);
        headerRow = new Row().AlignCenter().Child(titleLabel).Child(new Spacer()).Child(closeBtn);
        drawerBox.Add(headerRow);

        // 内容槽容器
        contentBox = new Panel();
        contentBox.layout = 1;
        contentBox.grow = true;
        drawerBox.Add(contentBox);

        base.Add(drawerBox);
        this.SetShown(false);
    }

    public Drawer(string title) : this() {
        this.Title(title);
    }

    public Drawer Title(string t) {
        titleLabel.Text = t;
        return this;
    }

    public Drawer Placement(string p) {
        placement = p;
        return this;
    }

    public Drawer Size(int s) {
        drawerSize = s;
        return this;
    }

    public Drawer Width(int w) {
        drawerSize = w;
        return this;
    }

    public Drawer Height(int h) {
        drawerSize = h;
        return this;
    }

    public Drawer Mask(bool enable) {
        mask = enable;
        return this;
    }

    public Drawer Content(Control content) {
        contentBox.RemoveAll();
        if (content != null) {
            contentBox.With(content);
        }
        return this;
    }

    public Drawer Actions(List<Control> actions) {
        if (footerRow != null) {
            drawerBox.Remove(footerRow);
            footerRow = null;
        }
        if (actions != null && actions.Count > 0) {
            footerRow = new Row().Justify("end").Gap(8);
            footerRow.Children(actions);
            drawerBox.With(footerRow);
        }
        return this;
    }

    public Drawer Action(Control act) {
        if (act == null) { return this; }
        if (footerRow == null) {
            footerRow = new Row().Justify("end").Gap(8);
            drawerBox.With(footerRow);
        }
        footerRow.Child(act);
        return this;
    }

    public Drawer Show() {
        appliedOpen = true;
        this.SetShown(true);
        if (!Opened.Get()) { Opened.Set(true); }
        Open.Raise();
        return this;
    }

    public override void CloneContentTo(Control target, CloneTreeFn clone) {
        Drawer drawer = (Drawer)target;
        for (int i = 0; i < contentBox.ChildCount(); i = i + 1) {
            Control child = clone(contentBox.ChildAt(i));
            if (child != null) { drawer.contentBox.Add(child); }
        }
        for (int i = 0; i < headerRow.ChildCount(); i = i + 1) {
            Control child = headerRow.ChildAt(i);
            if (child.slotName == "extra" || child.slotName == "header-extra") {
                drawer.MountSlot(child.slotName, clone(child));
            }
        }
        if (footerRow != null) {
            for (int i = 0; i < footerRow.ChildCount(); i = i + 1) {
                Control child = clone(footerRow.ChildAt(i));
                if (child != null) { drawer.Action(child); }
            }
        }
    }

    public override string Kind() { return "Drawer"; }

    protected override List<PropSpec> DefineProps() {
        List<PropSpec> ps = new List<PropSpec>();
        PropSpec t = PropSpec.Text("title", "Title");
        t.ViaExtra();
        ps.Add(t);
        PropSpec op = PropSpec.Bool("open", "Is open").DefaultBinding();
        op.ViaExtra();
        op.Also("visible");
        op.Also("data");
        ps.Add(op);
        PropSpec plc = PropSpec.Enum("placement", "Placement",
            new List<string>{ "right", "left", "top", "bottom" });
        plc.Field("placement", 0);
        ps.Add(plc);
        PropSpec sz = PropSpec.Int("size", "Drawer size");
        sz.Field("drawerSize", 1);
        ps.Add(sz);
        PropSpec m = PropSpec.Bool("mask", "Show mask");
        m.Field("mask", 2);
        ps.Add(m);
        return ps;
    }

    public override void SyncBinding() {
        base.SyncBinding();
        if (Opened != null) {
            bool want = Opened.Get();
            if (want != appliedOpen) {
                if (want) { this.Show(); } else { this.Hide(); }
            }
        }
    }

    public override string GetProp(string key) {
        string k = key.ToLower();
        if (k == "open" || k == "visible" || k == "data" || k == "value") {
            if (Opened != null) { return PropSpec.Flag(Opened.Get()); }
            return PropSpec.Flag(appliedOpen);
        }
        if (k == "title") { return titleLabel.Text != null ? titleLabel.Text.Get() : ""; }
        if (k == "placement") { return placement; }
        if (k == "size" || k == "width" || k == "height") { return Convert.ToString(drawerSize); }
        if (k == "mask") { return PropSpec.Flag(mask); }
        return base.GetProp(key);
    }

    public override bool MountSlot(string slot, Control c) {
        if (slot == "extra" || slot == "header-extra") {
            int pos = headerRow.ChildCount() - 1;
            if (pos < 0) { pos = 0; }
            headerRow.InsertAt(pos, c);
            return true;
        }
        if (slot == "action" || slot == "actions" || slot == "footer") {
            this.Action(c);
            return true;
        }
        if (slot == "content" || slot == "body") {
            this.Content(c);
            return true;
        }
        return base.MountSlot(slot, c);
    }

    public override Control Add(Control child) {
        if (child == null) { return null; }
        if (child.slotName != "" && this.MountSlot(child.slotName, child)) {
            return child;
        }
        this.Content(child);
        return child;
    }

    public override void SetProp(string key, string val) {
        string k = key.ToLower();
        if (k == "title") { this.Title(val); return; }
        if (k == "placement") { this.Placement(val); return; }
        if (k == "width") { this.Width(int.Parse(val)); return; }
        if (k == "height") { this.Height(int.Parse(val)); return; }
        if (k == "mask") { this.Mask(val != "false" && val != "0"); return; }
        if (k == "visible" || k == "open") {
            if (val == "true" || val == "1") { this.Show(); } else { this.Hide(); }
            return;
        }
        base.SetProp(key, val);
    }

    public Drawer Hide() {
        appliedOpen = false;
        this.SetShown(false);
        if (Opened.Get()) { Opened.Set(false); }
        Close.Raise();
        return this;
    }

    public bool IsOpen() {
        return Opened.Get();
    }

    public override bool DismissOnOutsideClick() {
        return mask;
    }

    public override void OnPopupDismissed() {
        if (this.appliedOpen) {
            this.Hide();
        }
    }

    public Panel Box() {
        return drawerBox;
    }

    public override void Arrange(int x, int y, int w, int h) {
        base.Arrange(x, y, w, h);
        if (!appliedOpen) { return; }

        int bx = x;
        int by = y;
        int bw = w;
        int bh = h;

        if (placement == "right") {
            int targetW = drawerSize;
            if (targetW > w) { targetW = w; }
            bx = x + w - targetW;
            by = y;
            bw = targetW;
            bh = h;
        } else if (placement == "left") {
            int targetW = drawerSize;
            if (targetW > w) { targetW = w; }
            bx = x;
            by = y;
            bw = targetW;
            bh = h;
        } else if (placement == "bottom") {
            int targetH = drawerSize;
            if (targetH > h) { targetH = h; }
            bx = x;
            by = y + h - targetH;
            bw = w;
            bh = targetH;
        } else { // "top"
            int targetH = drawerSize;
            if (targetH > h) { targetH = h; }
            bx = x;
            by = y;
            bw = w;
            bh = targetH;
        }

        int left = drawerBox.StyleMarL();
        int top = drawerBox.StyleMarT();
        drawerBox.Arrange(bx + left, by + top,
            bw - left - drawerBox.StyleMarR(), bh - top - drawerBox.StyleMarB());
    }

    public override void OnPaint(App app) {
        if (!appliedOpen) { return; }
        if (mask && app != null && app.canvas != null) {
            StyleBox maskStyle = Style.Part(app, "drawer", "mask", "", this.EffectiveClass(), name, Style.SNormal());
            this.PaintContentMask(app, maskStyle.bg);
        }
        base.OnPaint(app);
    }
}
