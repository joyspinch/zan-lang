using System;
using Gui;
using Gui.Backend;

namespace Gui.Widget;

// 现代声明式抽屉组件：对齐 Naive UI n-drawer 与现代侧边交互容器。
// 支持四向贴边（right/left/top/bottom）、半透明遮罩、标题头与关闭按钮、复合内容插槽及底栏操作区。
public class Drawer : Panel {
    Panel drawerBox;
    Row headerRow;
    Label titleLabel;
    Button closeBtn;
    Panel contentBox;
    Row footerRow;
    string placement;
    int drawerSize;
    bool mask;
    bool isOpen;
    public UiEvent Open;
    public UiEvent Close;

    Drawer() {
        this.InitPanel("drawer-overlay", 3);
        this.dock = 5;
        this.layout = 0;
        placement = "right";
        drawerSize = 360;
        mask = true;
        isOpen = false;

        Open = new UiEvent();
        Close = new UiEvent();

        drawerBox = new Panel();
        drawerBox.dock = 0;
        drawerBox.layout = 1;
        drawerBox.logGap = 12;
        drawerBox.padL = 16;
        drawerBox.padR = 16;
        drawerBox.padT = 16;
        drawerBox.padB = 16;
        drawerBox.Class = "card";

        // Header 栏
        titleLabel = new Label("").Title().Bold();
        closeBtn = new Button("X").Ghost().Small();
        closeBtn.Click += () => { this.Hide(); };
        headerRow = Row.Create().AlignCenter().Child(titleLabel).Child(new Spacer()).Child(closeBtn);
        drawerBox.With(headerRow);

        // 内容槽容器
        contentBox = new Panel();
        contentBox.layout = 1;
        contentBox.grow = true;
        drawerBox.With(contentBox);

        this.With(drawerBox);
        this.SetShown(false);
    }

    static Drawer Create(string title) {
        Drawer d = new Drawer();
        d.Title(title);
        return d;
    }

    Drawer Title(string t) {
        titleLabel.Text = t;
        return this;
    }

    Drawer Placement(string p) {
        placement = p;
        return this;
    }

    Drawer Size(int s) {
        drawerSize = s;
        return this;
    }

    Drawer Width(int w) {
        drawerSize = w;
        return this;
    }

    Drawer Height(int h) {
        drawerSize = h;
        return this;
    }

    Drawer Mask(bool enable) {
        mask = enable;
        return this;
    }

    Drawer Content(Control content) {
        contentBox.RemoveAll();
        if (content != null) {
            contentBox.With(content);
        }
        return this;
    }

    Drawer Actions(List<Control> actions) {
        if (footerRow != null) {
            drawerBox.Remove(footerRow);
            footerRow = null;
        }
        if (actions != null && actions.Count > 0) {
            footerRow = Row.Create().Justify("end").Gap(8);
            footerRow.Children(actions);
            drawerBox.With(footerRow);
        }
        return this;
    }

    Drawer Action(Control act) {
        if (act == null) { return this; }
        if (footerRow == null) {
            footerRow = Row.Create().Justify("end").Gap(8);
            drawerBox.With(footerRow);
        }
        footerRow.Child(act);
        return this;
    }

    Drawer Show() {
        isOpen = true;
        this.SetShown(true);
        Open.Raise();
        return this;
    }

    override string Kind() { return "Drawer"; }

    override bool MountSlot(string slot, Control c) {
        if (slot == "action" || slot == "actions" || slot == "footer") {
            this.Action(c);
            return true;
        }
        if (slot == "content" || slot == "body") {
            this.Content(c);
            return true;
        }
        return base.MountSlot(slot, c);
    }

    override Control Add(Control child) {
        if (child == null) { return null; }
        if (child.slotName != "" && this.MountSlot(child.slotName, child)) {
            return child;
        }
        this.Content(child);
        return child;
    }

    override void SetProp(string key, string val) {
        string k = key.ToLower();
        if (k == "title") { this.Title(val); return; }
        if (k == "placement") { this.Placement(val); return; }
        if (k == "width") { this.Width(int.Parse(val)); return; }
        if (k == "height") { this.Height(int.Parse(val)); return; }
        if (k == "mask") { this.Mask(val != "false" && val != "0"); return; }
        if (k == "visible" || k == "open") {
            if (val == "true" || val == "1") { this.Show(); } else { this.Hide(); }
            return;
        }
        base.SetProp(key, val);
    }

    Drawer Hide() {
        isOpen = false;
        this.SetShown(false);
        Close.Raise();
        return this;
    }

    bool IsOpen() {
        return isOpen;
    }

    Panel Box() {
        return drawerBox;
    }

    override void Arrange(int x, int y, int w, int h) {
        base.Arrange(x, y, w, h);
        if (!isOpen) { return; }

        int bx = x;
        int by = y;
        int bw = w;
        int bh = h;

        if (placement == "right") {
            int targetW = drawerSize;
            if (targetW > w) { targetW = w; }
            bx = x + w - targetW;
            by = y;
            bw = targetW;
            bh = h;
        } else if (placement == "left") {
            int targetW = drawerSize;
            if (targetW > w) { targetW = w; }
            bx = x;
            by = y;
            bw = targetW;
            bh = h;
        } else if (placement == "bottom") {
            int targetH = drawerSize;
            if (targetH > h) { targetH = h; }
            bx = x;
            by = y + h - targetH;
            bw = w;
            bh = targetH;
        } else { // "top"
            int targetH = drawerSize;
            if (targetH > h) { targetH = h; }
            bx = x;
            by = y;
            bw = w;
            bh = targetH;
        }

        drawerBox.Arrange(bx, by, bw, bh);
    }

    override void OnPaint(App app) {
        if (!isOpen) { return; }
        if (mask && app != null && app.canvas != null) {
            app.canvas.FillRect(this.bx, this.by, this.bw, this.bh, 0x73000000);
        }
        base.OnPaint(app);
    }
}
