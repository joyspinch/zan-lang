using System;
using Gui;
namespace Gui.Widget;
[GuiKind("Drawer")]
public class Drawer : Panel {
    public override Control CreateCloneShell() { return new Drawer(); }
    public Panel drawerBox;
    public Row headerRow;
    public Label titleLabel;
    public Button closeBtn;
    public Panel contentBox;
    public Row footerRow;
    public string placement;
    public int drawerSize;
    public bool mask;
    private bool appliedOpen;
    public Binding<bool> Opened;
    public UiEvent Open;
    public UiEvent Close;
    public Drawer() {
        this.InitPanel("drawer-overlay", 3);
        this.Grow();
        placement = "right";
        drawerSize = 360;
        mask = true;
        appliedOpen = false;
        Opened = false;
        Open = new UiEvent();
        Close = new UiEvent();
        drawerBox = new Panel("drawer-surface");
        drawerBox.layout = 1;
        drawerBox.flexFlow = 1;
        drawerBox.Class = "card drawer-surface";
        titleLabel = new Label("") { ClassName = "title strong" };
        closeBtn = new Button { ClassName = "ghost small drawer-close", Icon = "close", Tip = "Close" };
        DialogAction closeBtnAction = new DialogAction();
        closeBtnAction.drawer = this;
        closeBtn.Click.Add(closeBtnAction.CloseDrawer);
        headerRow = new Row {
            AlignItems = "center",
            Children = [ titleLabel, new Spacer(), closeBtn ]
        };
        drawerBox.Add(headerRow);
        contentBox = new Panel();
        contentBox.layout = 1;
        contentBox.grow = true;
        drawerBox.Add(contentBox);
        base.Add(drawerBox);
        this.SetShown(false);
    }
    public Drawer(string title) : this() { this.Title(title); }
    public string TitleText {
        get { return titleLabel.Text != null ? titleLabel.Text.Get() : ""; }
        set { this.Title(value); }
    }
    public string DrawerPlacement {
        get { return placement; }
        set { this.Placement(value); }
    }
    public int DrawerSize {
        get { return drawerSize; }
        set { this.Size(value); }
    }
    public bool ShowMask {
        get { return mask; }
        set { this.Mask(value); }
    }
    public Control BodyContent {
        get { return contentBox.ChildCount() > 0 ? contentBox.ChildAt(0) : null; }
        set { this.Content(value); }
    }
    public bool IsOpened {
        get { return this.IsOpen(); }
        set { if (value) { this.Show(); } else { this.Hide(); } }
    }
    public void Title(string t) { titleLabel.Text = t; }
    public void Placement(string p) { placement = p; }
    public void Size(int s) { drawerSize = s; }
    public void Width(int w) { drawerSize = w; }
    public void Height(int h) { drawerSize = h; }
    public void Mask(bool enable) { mask = enable; }
    public void Content(Control content) {
        contentBox.RemoveAll();
        if (content != null) { contentBox.With(content); }
    }
    public void Actions(List<Control> actions) {
        if (footerRow != null) {
            drawerBox.Remove(footerRow);
            footerRow = null;
        }
        if (actions != null && actions.Count > 0) {
            footerRow = new Row {
                JustifyContent = "end",
                Gap = 8
            };
            for (int i = 0; i < actions.Count; i = i + 1) {
                footerRow.Children.Add(actions[i]);
            }
            drawerBox.With(footerRow);
        }
    }
    public void Action(Control act) {
        if (act == null) { return; }
        if (footerRow == null) {
            footerRow = new Row {
                JustifyContent = "end",
                Gap = 8
            };
            drawerBox.With(footerRow);
        }
        footerRow.Children.Add(act);
    }
    public void Show() {
        appliedOpen = true;
        this.SetShown(true);
        if (!Opened.Get()) { Opened.Set(true); }
        Open.Raise(this);
    }
    public override void CloneContentTo(Control target, CloneTreeFn clone) {
        Drawer drawer = (Drawer)target;
        for (int i = 0; i < contentBox.ChildCount(); i = i + 1) {
            Control child = clone(contentBox.ChildAt(i));
            if (child != null) { drawer.contentBox.Add(child); }
        }
        for (int i = 0; i < headerRow.ChildCount(); i = i + 1) {
            Control child = headerRow.ChildAt(i);
            if (child.slotName == "extra" || child.slotName == "header-extra") {
                drawer.MountSlot(child.slotName, clone(child));
            }
        }
        if (footerRow != null) {
            for (int i = 0; i < footerRow.ChildCount(); i = i + 1) {
                Control child = clone(footerRow.ChildAt(i));
                if (child != null) { drawer.Action(child); }
            }
        }
    }
    // 展开状态（设计器 / HTML 的 open/visible/data）：写入即 Show/Hide。
    public bool OpenState {
        get { return Opened != null ? Opened.Get() : appliedOpen; }
        set { if (value) { this.Show(); } else { this.Hide(); } }
    }

    public string GetTitleText() { return titleLabel.Text != null ? titleLabel.Text.Get() : ""; }
    public void SetTitleText(string t) { this.Title(t); }
    public void SetPlacementText(string p) { this.Placement(p); }
    public void SetMask(bool on) { this.Mask(on); }

    protected override List<PropSpec> DefineProps() {
        List<PropSpec> ps = new List<PropSpec>();
        ps.Add(PropSpec.Text("title", "Title").Accessor("GetTitleText", "SetTitleText"));
        ps.Add(PropSpec.Bool("open", "Is open").DefaultBinding().Field("OpenState").Also("visible").Also("data").Also("value"));
        PropSpec plc = PropSpec.Enum("placement", "Placement",
            new List<string>{ "right", "left", "top", "bottom" });
        plc.Field("placement").Setter("SetPlacementText");
        ps.Add(plc);
        ps.Add(PropSpec.Int("size", "Drawer size").Field("drawerSize").Also("width").Also("height"));
        ps.Add(PropSpec.Bool("mask", "Show mask").Field("mask").Setter("SetMask"));
        return ps;
    }
    public override void SyncBinding() {
        base.SyncBinding();
        if (Opened != null) {
            bool want = Opened.Get();
            if (want != appliedOpen) {
                if (want) { this.Show(); } else { this.Hide(); }
            }
        }
    }
    public override bool MountSlot(string slot, Control c) {
        if (slot == "extra" || slot == "header-extra") {
            int pos = headerRow.ChildCount() - 1;
            if (pos < 0) { pos = 0; }
            headerRow.InsertAt(pos, c);
            return true;
        }
        if (slot == "action" || slot == "actions" || slot == "footer") {
            this.Action(c);
            return true;
        }
        if (slot == "content" || slot == "body") {
            this.Content(c);
            return true;
        }
        return base.MountSlot(slot, c);
    }
    public override Control Add(Control child) {
        if (child == null) { return null; }
        if (child.slotName != "" && this.MountSlot(child.slotName, child)) { return child; }
        this.Content(child);
        return child;
    }
    public Drawer Hide() {
        appliedOpen = false;
        this.SetShown(false);
        if (Opened.Get()) { Opened.Set(false); }
        Close.Raise(this);
        return this;
    }
    public bool IsOpen() { return Opened.Get(); }
    public override bool DismissOnOutsideClick() { return mask; }
    public override void OnPopupDismissed() {
        if (this.appliedOpen) { this.Hide(); }
    }
    public Panel Box() { return drawerBox; }
    public override void OnMeasure(App app) {
        this.SyncBinding();
        base.OnMeasure(app);
    }
    public override void Arrange(int x, int y, int w, int h) {
        base.Arrange(x, y, w, h);
        if (!appliedOpen) { return; }
        int bx = x;
        int by = y;
        int bw = w;
        int bh = h;
        if (placement == "right") {
            int targetW = drawerSize;
            if (targetW > w) { targetW = w; }
            bx = x + w - targetW;
            by = y;
            bw = targetW;
            bh = h;
        } else if (placement == "left") {
            int targetW = drawerSize;
            if (targetW > w) { targetW = w; }
            bx = x;
            by = y;
            bw = targetW;
            bh = h;
        } else if (placement == "bottom") {
            int targetH = drawerSize;
            if (targetH > h) { targetH = h; }
            bx = x;
            by = y + h - targetH;
            bw = w;
            bh = targetH;
        } else { // "top"
            int targetH = drawerSize;
            if (targetH > h) { targetH = h; }
            bx = x;
            by = y;
            bw = w;
            bh = targetH;
        }
        int left = drawerBox.StyleMarL();
        int top = drawerBox.StyleMarT();
        drawerBox.Arrange(bx + left, by + top,
            bw - left - drawerBox.StyleMarR(), bh - top - drawerBox.StyleMarB());
    }
    public override void OnPaint(App app) {
        this.SyncBinding();
        if (!appliedOpen) { return; }
        if (mask && app != null && app.canvas != null) {
            StyleBox maskStyle = Style.Part(app, "drawer", "mask", "", this.EffectiveClass(), name, Style.SNormal());
            this.PaintContentMask(app, maskStyle.bg);
        }
        base.OnPaint(app);
    }
}
