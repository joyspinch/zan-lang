using System;
using System.Numerics;
using Gui;
using Gui.Backend;
namespace Gui.Widget;
public class Progress : Control {
    public override Control CreateCloneShell() { return new Progress(); }
    public Binding<int> Value;
    public int ptype;
    public int shape;
    public bool showIndicator;
    public int strokeWidth;
    public bool processing;
    internal bool displayCadence;
    public int fillColor;
    public int railColor;
    public string format;
    public int ringSize;
    public List<ProgressRing> rings;
    public Control trackNode;
    public Control fillNode;
    public Label labelNode;
    private bool pctSynced;
    private int lastSyncedPct;
    private string lastSyncedFmt;
    private bool variantSynced;
    private int lastSyncedPtype;
    private string lastSyncedVariantCls;
    private weak App cachedBarApp;
    private int cachedBarGen;
    private int cachedBarScale;
    private int cachedBarDpi;
    private int cachedBarRuleSig;
    private string cachedBarCls;
    private bool cachedBarShowInd;
    private int cachedBarStrokeW;
    private int cachedBarContentH;
    public override int StyleDisplay() { return shape == 0 ? 1 : 0; } // CSS display: flex for bar
    public override int StyleFlexDir() { return 0; } // flex-direction: row
    private void InitProgress(int pct, int pt) {
        this.InitControl("progress");
        Value = pct;
        ptype = pt;
        shape = 0;
        showIndicator = true;
        strokeWidth = 0;
        processing = false;
        fillColor = 0;
        railColor = 0;
        format = "";
        ringSize = 0;
        rings = new List<ProgressRing>();
        this.ClassName = "progress align-center";
        trackNode = new Control { ClassName = "progress-track flex-1" };
        fillNode = new ProgressFill(this) { ClassName = "progress-fill" };
        trackNode.Add(fillNode);
        labelNode = new Label { ClassName = "progress-text" };
        this.Add(trackNode);
        this.Add(labelNode);
    }
    public Progress() : this(0, 1) { }
    public Progress(int pct, int pt) { InitProgress(pct, pt); }
    public int ShapeKind {
        get { return shape; }
        set { shape = value; }
    }
    public int StrokePx {
        get { return strokeWidth; }
        set { strokeWidth = value; }
    }
    public int FillArgb {
        get { return fillColor; }
        set { fillColor = value; }
    }
    public int RailArgb {
        get { return railColor; }
        set { railColor = value; }
    }
    public string FormatText {
        get { return format; }
        set { format = value != null ? value : ""; }
    }
    public int RingPx {
        get { return ringSize; }
        set { ringSize = value; }
    }
    public bool IsShowText {
        get { return showIndicator; }
        set { showIndicator = value; }
    }
    public bool IsProcessing {
        get { return processing; }
        set { this.Processing(value); }
    }
    public void SetPercent(int pct) { Value.Set(pct); }
    public int Percent() { return Value.Get(); }
    public void Ring() { shape = 1; }
    public void Multi() { shape = 2; }
    public void Dashboard() { shape = 3; }
    public void AddCircle(int pct, int pt) {
        if (rings == null) { rings = new List<ProgressRing>(); }
        shape = 2;
        rings.Add(new ProgressRing(pct, pt));
    }
    public void Processing(bool on) {
        if (processing == on) { return; }
        processing = on;
        if (shape == 0 && fillNode != null && fillNode.bw > 0 && fillNode.bh > 0) {
            App host = this.App;
            if (host != null) {
                host.Damage.NoteDamage(fillNode.bx, fillNode.by, fillNode.bw, fillNode.bh);
                host.Wake();
            }
        }
    }
    public void DisplayCadence(bool on) {
        if (displayCadence == on) { return; }
        displayCadence = on;
        App host = this.App;
        if (processing && shape == 0 && host != null) {
            host.RequestRedraw();
            host.Wake();
        }
    }
    public void StrokeWidth(int px) { strokeWidth = px; }
    public void FillColor(int argb) { fillColor = argb; }
    public void RailColor(int argb) { railColor = argb; }
    public void Format(string tmpl) { format = tmpl; }
    public void Size(int px) { ringSize = px; }
    public void ShowText(bool on) { showIndicator = on; }
    public override void CloneContentTo(Control target, CloneTreeFn clone) {
    }
    // 变体号 → 皮肤类：2=info 3=success 4=warning 5=error，
    // 其余为 default（返回 ""）。
    public static string TypeClass(int pt) {
        if (pt == 2) { return "info"; }
        if (pt == 3) { return "success"; }
        if (pt == 4) { return "warning"; }
        if (pt == 5) { return "error"; }
        return "";
    }
    public string VariantClass() { return Progress.TypeClass(ptype); }
    public string PartCls() {
        string c = VariantClass();
        if (Class.Length > 0) { c = c.Length > 0 ? c + " " + Class : Class; }
        return c;
    }
    protected override List<PropSpec> DefineProps() {
        List<PropSpec> ps = new List<PropSpec>();
        ps.Add(PropSpec.Int("percent", "Percent").DefaultBinding().Field("Value").Also("value").Also("data"));
        ps.Add(PropSpec.Enum("type", "Type", new List<string>())
            .Option("default").Option("primary").Option("info").Option("success")
            .Option("warning").Option("error")
            .Field("ptype"));
        ps.Add(PropSpec.Enum("shape", "Shape", new List<string>())
            .Option("bar").Option("ring").Option("multi")
            .Option("dashboard")
            .Field("shape"));
        ps.Add(PropSpec.Bool("showIndicator", "Show indicator")
            .Field("showIndicator")
            .WithTip("Draw the percent label (Naive UI show-indicator)."));
        ps.Add(PropSpec.Int("strokeWidth", "Stroke width")
            .Field("strokeWidth")
            .WithTip("Track height / ring thickness in px (Naive UI stroke-width). 0 = skin default."));
        ps.Add(PropSpec.Bool("processing", "Processing")
            .Field("processing")
            .WithTip("Roll animated stripes over the fill (Naive UI processing)."));
        ps.Add(PropSpec.Color("color", "Fill color")
            .Field("fillColor")
            .WithTip("Custom fill colour (Naive UI color). 0 = skin."));
        ps.Add(PropSpec.Color("railColor", "Rail color")
            .Field("railColor")
            .WithTip("Custom track colour (Naive UI rail-color). 0 = skin."));
        ps.Add(PropSpec.Text("format", "Indicator format")
            .Field("format")
            .WithTip("Indicator text template; {0} becomes the percent (Naive UI indicator). Empty = \"N%\"."));
        ps.Add(PropSpec.Int("ringSize", "Ring size")
            .Field("ringSize")
            .WithTip("Ring diameter in px (ring / multi / dashboard). 0 = default."));
        PropSpec cc = PropSpec.Text("circles", "Circles").Accessor("CirclesSpec", "SetCircles");
        cc.WithTip("Multi-ring values \"72:0,45:2\" (percent:variant, "
                   + "variants default/info/success/warning/error = 0..4). "
                   + "Writing it switches shape to multi.");
        ps.Add(cc);
        return ps;
    }

    // 多圆环环值序列化为 `"72:0,45:2,30:3"`（百分比:变体）。
    public string CirclesSpec() {
        string r = "";
        if (rings == null) { return r; }
        for (int i = 0; i < rings.Count; i = i + 1) {
            if (i > 0) { r = r + ","; }
            r = r + Convert.ToString(rings[i].percent) + ":" + Convert.ToString(rings[i].ringType);
        }
        return r;
    }
    private static bool TryParseCircleInt(string raw, out int value) {
        value = 0;
        if (raw == null) { return false; }
        string s = raw.Trim();
        if (s.Length == 0) { return false; }
        int idx = 0;
        bool neg = false;
        int first = s[0] & 255;
        if (first == 45) { neg = true; idx = 1; }
        else if (first == 43) { idx = 1; }
        if (idx >= s.Length) { return false; }
        long acc = 0;
        for (int i = idx; i < s.Length; i = i + 1) {
            int b = s[i] & 255;
            if (b < 48 || b > 57) { return false; }
            acc = acc * 10 + (long)(b - 48);
            if (acc > 2147483647) {
                value = neg ? (0 - 2147483647) : 2147483647;
                return true;
            }
        }
        value = neg ? (0 - (int)acc) : (int)acc;
        return true;
    }
    public void SetCircles(string spec) {
        rings = new List<ProgressRing>();
        shape = 2;
        if (spec == null || spec == "") { return; }
        List<string> ringStrs = spec.Split(",");
        for (int i = 0; i < ringStrs.Count; i = i + 1) {
            string it = ringStrs[i].Trim();
            if (it == "") { continue; }
            List<string> kv = it.Split(":");
            int pct = 0;
            if (!Progress.TryParseCircleInt(kv[0], out pct)) { continue; }
            int pt = 0;
            if (kv.Count > 1) {
                int parsedPt = 0;
                if (Progress.TryParseCircleInt(kv[1], out parsedPt)) { pt = parsedPt; }
            }
            rings.Add(new ProgressRing(pct, pt));
        }
    }
    public string IndicatorText(int pct) {
        if (format == null || format == "") { return Convert.ToString(pct) + "%"; }
        List<string> parts = format.Split("{0}");
        if (parts.Count == 1) { return format; }
        string r = parts[0] + Convert.ToString(pct);
        for (int i = 1; i < parts.Count; i = i + 1) { r = r + parts[i]; }
        return r;
    }
    public override void SyncBinding() {
        base.SyncBinding();
        bool isBar = shape == 0;
        if (trackNode != null) {
            trackNode.Visible = isBar;
            if (isBar) {
                if (railColor != 0 && trackNode.styleBg != railColor) {
                    trackNode.styleBg = railColor;
                    trackNode.computedStyle = null;
                }
                if (strokeWidth > 0 && trackNode.prefH != strokeWidth) {
                    trackNode.Height(strokeWidth);
                    trackNode.computedStyle = null;
                }
            }
        }
        if (fillNode != null && isBar) {
            if (!variantSynced || lastSyncedPtype != ptype || lastSyncedVariantCls != Class) {
                string vc = this.VariantClass();
                this.SwitchClass("info", vc == "info");
                this.SwitchClass("success", vc == "success");
                this.SwitchClass("warning", vc == "warning");
                this.SwitchClass("error", vc == "error");
                variantSynced = true;
                lastSyncedPtype = ptype;
                lastSyncedVariantCls = Class;
            }
            if (fillColor != 0 && fillNode.styleBg != fillColor) {
                fillNode.styleBg = fillColor;
                fillNode.computedStyle = null;
            }
        }
        if (labelNode != null) {
            bool wantVis = isBar && showIndicator;
            if (labelNode.Visible != wantVis) { labelNode.Visible = wantVis; }
            if (isBar) {
                int pct = MathUtil.Clamp(this.Percent(), 0, 100);
                string fmt = format != null ? format : "";
                if (!pctSynced || lastSyncedPct != pct || lastSyncedFmt != fmt) {
                    pctSynced = true;
                    lastSyncedPct = pct;
                    lastSyncedFmt = fmt;
                    string ind = this.IndicatorText(pct);
                    if (labelNode.Text != null) { labelNode.Text.Set(ind); }
                    else { labelNode.Text = ind; }
                }
            }
        }
    }
    public override void Arrange(int x, int y, int width, int height) {
        base.Arrange(x, y, width, height);
        if (shape == 0 && trackNode != null && fillNode != null) {
            int pct = MathUtil.Clamp(this.Percent(), 0, 100);
            fillNode.Arrange(trackNode.bx, trackNode.by, trackNode.bw * pct / 100, trackNode.bh);
        }
    }
    private void PaintRing(App app, int pct, int startDeg, int totalDeg) {
        Canvas c = app.canvas;
        string variant = this.PartCls();
        StyleBox trackStyle = this.ResolvePartAs(app, "progress", "track", "",
                                                 variant, Style.SNormal());
        StyleBox fillStyle = this.ResolvePartAs(app, "progress", "fill", "",
                                                variant, Style.SNormal());
        StyleBox ringLabelStyle = this.ResolvePartAs(app, "progress",
                                                     "ring-label", "", variant,
                                                     Style.SNormal());
        int size = bw;
        if (bh < size) { size = bh; }
        if (size < 2) { return; }
        int radius = size / 2;
        int cx = bx + bw / 2;
        int cy = by + bh / 2;
        int thick = trackStyle.BorderWOr(app.Scale(7));
        if (strokeWidth > 0) { thick = strokeWidth; }
        if (thick < 1) { thick = 1; }
        if (thick >= radius) { thick = radius - 1; }
        int inner = radius - thick;
        int rail = railColor;
        if (rail == 0) { rail = trackStyle.BgOr(0); }
        c.FillSector(cx, cy, inner, radius, startDeg, startDeg + totalDeg, rail);
        int sweep = totalDeg * pct / 100;
        if (sweep > 0) {
            int fillCol = fillColor;
            if (fillCol == 0) { fillCol = fillStyle.BgOr(0); }
            c.FillSector(cx, cy, inner, radius, startDeg, startDeg + sweep,
                         fillCol);
        }
        if (showIndicator && ringLabelStyle.display != 2
                && ringLabelStyle.visible != 0) {
            int fs = ringLabelStyle.FontOr(Style.FontFallback(app, "medium"));
            c.DrawTextCentered(bx, by, bw, bh, this.IndicatorText(pct),
                               ringLabelStyle.FgOr(0), fs);
        }
    }
    private void PaintMulti(App app) {
        Canvas c = app.canvas;
        int n = 0;
        if (rings != null) { n = rings.Count; }
        if (n == 0) {
            this.PaintRing(app, MathUtil.Clamp(this.Percent(), 0, 100), 0, 360);
            return;
        }
        int size = bw;
        if (bh < size) { size = bh; }
        if (size < 4) { return; }
        int radius = size / 2;
        int cx = bx + bw / 2;
        int cy = by + bh / 2;
        StyleBox ringLabelStyle = this.ResolvePartAs(app, "progress",
                                                     "ring-label", "", "",
                                                     Style.SNormal());
        int fs = ringLabelStyle.FontOr(Style.FontFallback(app, "small"));
        int lineH = Canvas.FontHeight(fs);
        int rowGap = app.Scale(2);
        int totalH = n * lineH + (n - 1) * rowGap;
        if (totalH > bh - app.Scale(4)) {
            fs = Style.FontFallback(app, "tiny");
            lineH = Canvas.FontHeight(fs);
            totalH = n * lineH + (n - 1) * rowGap;
        }
        int clearR = 0;
        if (showIndicator) { clearR = totalH / 2 + app.Scale(4); }
        int step = (radius - clearR) / n;
        int thick;
        if (strokeWidth > 0) {
            thick = strokeWidth;
        } else if (step >= app.Scale(3)) {
            thick = step - app.Scale(2);
        } else {
            step = radius / n;
            if (step < 2) { step = 2; }
            thick = step - app.Scale(2);
        }
        if (thick < 1) { thick = 1; }
        if (step >= 1 && thick >= step) { thick = step - 1; }
        if (thick >= radius) { thick = radius - 1; }
        for (int i = 0; i < n; i = i + 1) {
            int pct = MathUtil.Clamp(rings[i].percent, 0, 100);
            string variant = Progress.TypeClass(this.CircleType(i));
            StyleBox trackStyle = this.ResolvePartAs(app, "progress", "track",
                                                     "", variant,
                                                     Style.SNormal());
            StyleBox fillStyle = this.ResolvePartAs(app, "progress", "fill",
                                                    "", variant,
                                                    Style.SNormal());
            int ro = radius - i * step;
            int ri = ro - thick;
            if (ri < 0) { ri = 0; }
            int rail = railColor;
            if (rail == 0) { rail = trackStyle.BgOr(0); }
            c.FillSector(cx, cy, ri, ro, 0, 360, rail);
            int sweep = 360 * pct / 100;
            if (sweep > 0) {
                int fillCol = fillColor;
                if (fillCol == 0) { fillCol = fillStyle.BgOr(0); }
                c.FillSector(cx, cy, ri, ro, 0, sweep, fillCol);
            }
        }
        if (showIndicator) {
            int y = by + (bh - totalH) / 2;
            for (int i = 0; i < n; i = i + 1) {
                string variant = Progress.TypeClass(this.CircleType(i));
                StyleBox fillStyle = this.ResolvePartAs(app, "progress",
                                                        "fill", "", variant,
                                                        Style.SNormal());
                int col = fillColor;
                if (col == 0) { col = fillStyle.BgOr(0); }
                if (col == 0) { col = ringLabelStyle.FgOr(0); }
                c.DrawTextCentered(bx, y, bw, lineH,
                                   this.IndicatorText(rings[i].percent),
                                   col, fs);
                y = y + lineH + rowGap;
            }
        }
    }
    private int CircleType(int i) {
        if (rings != null && i >= 0 && i < rings.Count) { return rings[i].ringType; }
        return 0;
    }
    protected override bool UsesBaseFlowOnly() { return this.Kind() == "Progress"; }
    public override void OnMeasure(App app) {
        StyleBox root = (computedStyle != null && computedStyleApp == app && computedStyleState == Style.SNormal()
            && computedStyleType == "progress" && computedStyleCls == Class)
            ? computedStyle : this.ResolveStyleCached(app, "progress", Class, Style.SNormal());
        if (shape == 1 || shape == 2 || shape == 3) {
            int def = app.Scale(72);
            if (shape == 2) { def = app.Scale(88); }
            if (shape == 3) { def = app.Scale(96); }
            prefH = root.HeightOr(def);
            prefW = root.WidthOr(def);
            if (ringSize > 0) {
                int s = app.Scale(ringSize);
                prefW = s;
                prefH = s;
            }
            return;
        }
        int rsig = app != null ? app.CurrentStyleRuleSig() : 0;
        int contentH = 0;
        if (cachedBarApp == app && cachedBarGen == (app != null ? app.bgThemeGen : 0)
            && cachedBarScale == (app != null ? app.metricsScale : 100)
            && cachedBarDpi == (app != null ? app.dpiScale : 100)
            && cachedBarRuleSig == rsig && cachedBarCls == Class
            && cachedBarShowInd == showIndicator && cachedBarStrokeW == strokeWidth) {
            contentH = cachedBarContentH;
        } else {
            StyleBox trackStyle = Style.PartRef(app, "progress", "track", "",
                                                Class, name, Style.SNormal());
            contentH = trackStyle.HeightOr(app.Scale(8));
            if (strokeWidth > 0) { contentH = strokeWidth; }
            if (showIndicator) {
                StyleBox labelStyle = Style.PartRef(app, "progress", "label", "", Class, name, Style.SNormal());
                if (labelStyle.display != 2 && labelStyle.visible != 0) {
                    int labelH = Canvas.FontHeight(labelStyle.FontOr(Style.FontFallback(app, "small")));
                    if (labelH > contentH) { contentH = labelH; }
                }
            }
            cachedBarApp = app;
            cachedBarGen = app != null ? app.bgThemeGen : 0;
            cachedBarScale = app != null ? app.metricsScale : 100;
            cachedBarDpi = app != null ? app.dpiScale : 100;
            cachedBarRuleSig = rsig;
            cachedBarCls = Class;
            cachedBarShowInd = showIndicator;
            cachedBarStrokeW = strokeWidth;
            cachedBarContentH = contentH;
        }
        prefH = root.HeightOr(contentH);
        prefW = root.WidthOr(app.Scale(200));
    }
    public override void OnPaint(App app) {
        int pct = MathUtil.Clamp(Percent(), 0, 100);
        if (shape == 2) {
            this.PaintMulti(app);
        } else if (shape == 3) {
            this.PaintRing(app, pct, 135, 270);
        } else if (shape == 1) {
            this.PaintRing(app, pct, 0, 360);
        }
    }
    public static int MixWhite(int c, int num) {
        int a = c / 16777216;
        if (a < 1) { a = 255; }
        int r = c / 65536 % 256;
        int g = c / 256 % 256;
        int b = c % 256;
        r = r + (255 - r) * num / 100;
        g = g + (255 - g) * num / 100;
        b = b + (255 - b) * num / 100;
        return a * 16777216 + r * 65536 + g * 256 + b;
    }
    internal const int StripeStepMs = 33;
    public static double StripePhase(int nowMs, int period) {
        if (period < 1) { return 0.0; }
        long cycle = (long)period * StripeStepMs;
        long elapsed = (long)nowMs % cycle;
        if (elapsed < 0) { elapsed = elapsed + cycle; }
        return (double)elapsed / StripeStepMs;
    }
    public static bool RectOnScreen(App app, int x, int y, int w, int h) {
        int cw = app.canvas.Width();
        int ch = app.canvas.Height();
        return x + w >= 0 && x <= cw && y + h >= 0 && y <= ch;
    }
}
class ProgressFill : Control {
    private weak Progress owner;
    ProgressFill(Progress progress) { owner = progress; }
    public override void OnPaint(App app) {
        Progress progress = owner;
        if (progress == null || !progress.processing || progress.shape != 0
            || bw <= 0 || bh <= 0 || !Progress.RectOnScreen(app, bx, by, bw, bh)) { return; }
        int period = Math.Max(1, app.Scale(12));
        int thickness = Math.Max(2, app.Scale(4));
        bool displayCadence = progress.displayCadence;
        StyleBox style = paintedStyle != null ? paintedStyle : this.Box(app);
        int stripe = Progress.MixWhite(style.BgOr(0), 45);
        Canvas canvas = app.canvas;
        int left = bx;
        int top = by;
        int width = bw;
        int height = bh;
        canvas.PushClip(left, top, width, height);
        try {
            bool capture = !app.reducedMotion && progress.Value != null && !progress.Value.IsLive()
                && progress.fillNode == this && app.CaptureFormRegion(left, top, width, height);
            int now = app.reducedMotion ? 0 : app.nowMs;
            ProgressFill.PaintStripe(canvas, left, top, width, height, period, thickness, stripe, now, displayCadence);
            if (capture) {
                int value = progress.Value.Get();
                app.WatchFormRegion(Progress.StripeStepMs, displayCadence, (Canvas target, int tick) => {
                    ProgressFill.PaintStripe(target, left, top, width, height, period, thickness, stripe, tick, displayCadence);
                }, () => this.StripeCurrent(app, left, top, width, height, value, displayCadence));
            }
        } finally { canvas.PopClip(); }
        if (app.reducedMotion) { return; }
        bool paintOnly = progress.Value != null && !progress.Value.IsLive();
        if (displayCadence) {
            app.RequestAnimationFrameAt(app.DisplayFrameDueMs(), bx, by, bw, bh, paintOnly);
        } else {
            int elapsed = app.nowMs % Progress.StripeStepMs;
            if (elapsed < 0) { elapsed = elapsed + Progress.StripeStepMs; }
            int dueMs = app.nowMs + (Progress.StripeStepMs - elapsed);
            app.RequestAnimationFrameAt(dueMs, bx, by, bw, bh, paintOnly);
        }
    }
    private bool StripeCurrent(App app, int x, int y, int w, int h, int value, bool displayCadence) {
        Progress progress = owner;
        if (progress == null || !progress.processing || progress.shape != 0
            || progress.fillNode != this || progress.Value == null || progress.Value.IsLive()
            || progress.Value.Get() != value || progress.displayCadence != displayCadence
            || bx != x || by != y || bw != w || bh != h) { return false; }
        if (app.rootControl == null || !app.rootControl.ContainsInputControl(this)) { return false; }
        Control node = this;
        while (node != null) {
            if (node.App != app || !node.StyleVisible()) { return false; }
            node = node.parent;
        }
        return true;
    }
    private static void PaintStripe(Canvas canvas, int x, int y, int w, int h,
        int period, int thickness, int color, int now, bool displayCadence) {
        double phase = Progress.StripePhase(now, period);
        if (displayCadence) {
            int phaseFx = (int)(phase * 256.0);
            int heightFx = h * 256;
            int bottom = (y + h) * 256;
            int top = y * 256;
            int step = period * 256;
            int start = (x - h - thickness) * 256 - phaseFx;
            int end = (x + w + thickness) * 256;
            for (int left = start; left < end; left = left + step) {
                canvas.DrawLineFx(left, bottom, left + heightFx, top, color, thickness);
            }
        } else {
            for (int left = x - h - (int)phase; left < x + w; left = left + period) {
                canvas.DrawLine(left, y + h, left + h, y, color, thickness);
            }
        }
    }
}
