using System;
using System.Collections.Generic;
using Gui;
namespace Gui.Widget;
public class PopupTrigger : PopupControl {
    protected string triggerText;
    protected void InitPopupTrigger(string kind, string trigText, int w, int h) {
        this.InitPopup(kind != "" ? kind : "popuptrigger", w, h);
        this.triggerText = trigText;
    }
    public PopupTrigger() { this.InitPopupTrigger("popuptrigger", "Select", 260, 0); }
    public PopupTrigger(string trigText) { this.InitPopupTrigger("popuptrigger", trigText, 260, 0); }
    public PopupTrigger(string kind, string trigText, int w, int h) {
        this.InitPopupTrigger(kind, trigText, w, h);
    }
    public string TriggerText {
        get { return this.triggerText; }
        set { this.SetTriggerText(value); }
    }
    public override void OnMeasure(App app) {
        this.SyncBinding();
        prefH = app != null ? app.theme.heightMedium : 32;
        prefW = app != null ? app.Scale(160) : 160;
    }
    public override void OnClick(RoutedEventArgs e) {
        this.ToggleOpen();
        App a = this.FindApp();
        if (a != null) { a.RequestRedraw(); }
        e.Handle();
    }
    public override int InputFocusCapabilities() { return 1; }
    public override void OnPaint(App app) {
        this.SyncBinding();
        if (customTrigger != null) {
            customTrigger.Arrange(bx, by, bw, bh);
            customTrigger.RenderTree(app);
        } else {
            DropdownChrome.Paint(app, this, triggerText, Opened.Get());
        }
    }
    public virtual void SetTriggerText(string txt) { triggerText = txt; }
    public virtual string GetTriggerText() { return triggerText; }
    public override string Kind() { return "PopupTrigger"; }
    protected override List<PropSpec> DefineProps() {
        List<PropSpec> ps = base.DefineProps();
        ps.Add(PropSpec.Text("triggerText", "Trigger Text").Field("triggerText", 0).Also("text").Also("label"));
        return ps;
    }
    public override string GetProp(string key) {
        if (key == "triggerText" || key == "text" || key == "label") { return triggerText; }
        return base.GetProp(key);
    }
    public override void SetProp(string key, string val) {
        if (key == "triggerText" || key == "text" || key == "label") {
            this.SetTriggerText(val);
            return;
        }
        base.SetProp(key, val);
    }
}
