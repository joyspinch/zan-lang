using System;
using Gui;
using Gui.Backend;
namespace Gui.Widget;
public partial class Layer {
    private static AppLayerContext FallbackContext() {
        GuiWidgetState state = GuiWidgetState.Current();
        if (state.layerFallbackContext == null) { state.layerFallbackContext = new AppLayerContext(); }
        return state.layerFallbackContext;
    }
    public static AppLayerContext Context(App app) {
        if (app != null) {
            if (app.layerContext == null) { app.layerContext = new AppLayerContext(); }
            return (AppLayerContext)app.layerContext;
        }
        App frame = App.FrameApp();
        if (frame != null) {
            if (frame.layerContext == null) { frame.layerContext = new AppLayerContext(); }
            return (AppLayerContext)frame.layerContext;
        }
        return Layer.FallbackContext();
    }
    private static void EnsureZorder(AppLayerContext ctx) {
        if (ctx.zorder == null) { ctx.zorder = new List<LayerState>(); }
    }
    internal static void Open(App app, LayerState s) {
        if (s == null) { return; }
        s.Open(); Layer.RegisterOpen(app, s);
    }
    static void BindInput(App app, LayerState s) {
        AppLayerContext ctx = Layer.Context(app);
        if (ctx.inputRoot == null) { ctx.inputRoot = new LayerInputRoot(ctx); }
        bool added = ctx.zorder.IndexOf(s) < 0;
        if (added) { ctx.zorder.Add(s); }
        ctx.inputRoot.Bind(app);
        if (added && s.open) { ctx.inputRoot.Activate(s); }
    }
    public static void RegisterOpen(App app, LayerState s) {
        AppLayerContext ctx = Layer.Context(app);
        Layer.EnsureZorder(ctx);
        if (app == null) { app = App.FrameApp(); }
        ctx.zorder.Remove(s);
        ctx.zorder.Add(s);
        if (ctx.windowHost != null) {
            ctx.windowHost.models.Remove(s); ctx.windowHost.models.Add(s);
        }
        if (app != null) {
            s.inputApp = app;
            Layer.BindInput(app, s);
            Layer.Context(app).inputRoot.Activate(s);
            if (s.modal) { Layer.SyncDialogs(app); }
            else {
                if (ctx.windowHost == null) {
                    ctx.windowHost = new LayerWindowHost(app);
                    ctx.inputRoot.SetWindowHost(ctx.windowHost);
                    Layer.UpdateRetainedRoots(app, ctx);
                }
                ctx.windowHost.Sync(app, ctx.zorder);
            }
        }
    }
    public static void RegisterOpen(LayerState s) { Layer.RegisterOpen(null, s); }
    private static void PruneZorder(AppLayerContext ctx) {
        Layer.EnsureZorder(ctx);
        int now = Window.GetTickMs();
        for (int i = ctx.zorder.Count - 1; i >= 0; i = i - 1) {
            LayerState s = ctx.zorder[i];
            if (s.open) { continue; }
            if (s.wasOpen && now - s.openMs <= 5000) { continue; }
            if (s.closing && now - s.closeMs <= 2000) { continue; }
            ctx.zorder.RemoveAt(i);
        }
    }
    private static LayerState FindTopmostDialogIn(AppLayerContext ctx) {
        if (ctx == null) { return null; }
        Layer.EnsureZorder(ctx);
        for (int i = ctx.zorder.Count - 1; i >= 0; i = i - 1) {
            LayerState s = ctx.zorder[i];
            if (s.open && s.kind != 0) { return s; }
        }
        return null;
    }
    public static LayerState TopmostDialog(App app) {
        AppLayerContext ctx = Layer.Context(app);
        LayerState top = Layer.FindTopmostDialogIn(ctx);
        if (top != null) { return top; }
        AppLayerContext fb = GuiWidgetState.Current().layerFallbackContext;
        return ctx != fb ? Layer.FindTopmostDialogIn(fb) : null;
    }
    public static LayerState TopmostDialog() { return Layer.TopmostDialog(null); }
    private static LayerState FindTopmostOpenIn(AppLayerContext ctx) {
        if (ctx == null) { return null; }
        Layer.EnsureZorder(ctx);
        for (int i = ctx.zorder.Count - 1; i >= 0; i = i - 1) {
            if (ctx.zorder[i].open) { return ctx.zorder[i]; }
        }
        return null;
    }
    public static bool IsTopmost(App app, LayerState s) {
        AppLayerContext ctx = Layer.Context(app);
        LayerState top = Layer.FindTopmostOpenIn(ctx);
        if (top != null) { return top == s; }
        AppLayerContext fb = GuiWidgetState.Current().layerFallbackContext;
        return ctx != fb && Layer.FindTopmostOpenIn(fb) == s;
    }
    public static bool IsTopmost(LayerState s) { return Layer.IsTopmost(null, s); }
    public static void Close(App app, LayerState s) {
        if (s == null || !s.open) { return; }
        int generation = s.inputGeneration + 1;
        s.open = false;
        if (s.inputGeneration != generation || s.open) { return; }
        s.dragging = false;
        s.sizing = false;
        s.closing = true;
        s.closeMs = Window.GetTickMs();
        if (!s.closedRaised) {
            s.closedRaised = true;
            s.Closed.Raise();
        }
        Layer.Context(app).requestRedraw = true;
    }
    public static void Close(LayerState s) { Layer.Close(null, s); }
    public static void BeginExit(LayerState s) {
        s.wasOpen = false;
        s.closing = true;
        s.closeMs = Window.GetTickMs();
        s.dragging = false;
        s.sizing = false;
    }
    public static void NotifyOpened(LayerState s) {
        if (s.wasOpen && !s.openedRaised) {
            s.openedRaised = true;
            s.Opened.Raise();
        }
    }
    public static bool CloseTopmostDialog(App app) {
        AppLayerContext ctx = Layer.Context(app);
        LayerState top = Layer.TopmostDialog(app);
        if (top != null) {
            top.action = 2;
            ctx.requestRedraw = true;
            return true;
        }
        if (ctx.photoViewer != null && ctx.photoViewer.Active) {
            ctx.photoViewer.Close();
            return true;
        }
        return false;
    }
    public static bool CloseTopmostDialog() { return Layer.CloseTopmostDialog(null); }
    public static bool CloseLast(App app, int kind) {
        AppLayerContext ctx = Layer.Context(app);
        Layer.PruneZorder(ctx);
        int i = ctx.zorder.Count - 1;
        while (i >= 0) {
            LayerState s = ctx.zorder[i];
            if (s.open && (kind < 0 || s.kind == kind)) {
                Layer.Close(app, s);
                return true;
            }
            i = i - 1;
        }
        if (kind < 0 && ctx.photoViewer != null && ctx.photoViewer.Active) {
            ctx.photoViewer.Close();
            return true;
        }
        return false;
    }
    public static bool CloseLast(int kind) { return Layer.CloseLast(null, kind); }
    public static void CloseAll(App app, int kind) {
        AppLayerContext ctx = Layer.Context(app);
        Layer.PruneZorder(ctx);
        List<LayerState> targets = new List<LayerState>();
        for (int i = 0; i < ctx.zorder.Count; i = i + 1) {
            LayerState s = ctx.zorder[i];
            if (s.open && (kind < 0 || s.kind == kind)) {
                targets.Add(s);
            }
        }
        for (int i = 0; i < targets.Count; i = i + 1) {
            Layer.Close(app, targets[i]);
        }
        if (kind < 0) { Layer.ClosePhotos(app); }
    }
    public static void CloseAll(int kind) { Layer.CloseAll(null, kind); }
    public static bool Key(App app, int code) {
        PhotoViewer photos = Layer.Context(app).photoViewer;
        bool ownsPhotos = photos != null && photos.Active && app.overlayHost.ActiveRoot() == photos;
        if (app.HasOverlays() && !Layer.DialogOwnsOverlay(app) && !ownsPhotos) { return false; }
        if (ownsPhotos) {
            if (code == 27) { photos.Close(); return true; }
            if (code == 37 || code == 39) { photos.Step(code == 37 ? -1 : 1); return true; }
            return false;
        }
        AppLayerContext ctx = Layer.Context(app);
        if (code == 27) {
            if (Layer.CloseTopmostDialog(app)) {
                app.RequestRedraw();
                return true;
            }
            return false;
        }
        if (code == 13) {
            LayerState top = Layer.TopmostDialog(app);
            if (top != null && top.promptFormType != 2) {
                top.action = 1;
                app.RequestRedraw();
                return true;
            }
            return false;
        }
        return false;
    }
    private static void EnsureQueues(AppLayerContext ctx) {
        if (ctx.toasts == null) { ctx.toasts = new List<ToastItem>(); }
        if (ctx.notifs == null) { ctx.notifs = new List<ToastItem>(); }
        if (ctx.toastPrev == null) { ctx.toastPrev = new Rect(0, 0, 0, 0); }
        if (ctx.notifPrev == null) { ctx.notifPrev = new Rect(0, 0, 0, 0); }
    }
    internal static void MarkQueueDirty(App app, Rect prev, bool any,
            int rx, int ry, int rw, int rh) {
        if (any) { app.RequestAnimationFrameIn(rx, ry, rw, rh); }
        if (prev != null && prev.width > 0 && prev.height > 0) {
            app.RequestAnimationFrameIn(prev.x, prev.y, prev.width, prev.height);
        }
        if (prev != null) {
            if (any) {
                prev.x = rx; prev.y = ry; prev.width = rw; prev.height = rh;
            } else {
                prev.x = 0; prev.y = 0; prev.width = 0; prev.height = 0;
            }
        }
    }
    public static int Clamp01(int v) {
        if (v < 0) { return 0; }
        if (v > 1000) { return 1000; }
        return v;
    }
    public static string RoleClass(int mtype) {
        if (mtype == 2) { return "info"; }
        if (mtype == 3) { return "success"; }
        if (mtype == 4) { return "warning"; }
        if (mtype == 5) { return "error"; }
        return "";
    }
    public static string RoleIcon(int mtype) {
        if (mtype == 3) { return "success"; }
        if (mtype == 4) { return "warning"; }
        if (mtype == 5) { return "error"; }
        return "info";
    }
    public static void Msg(App app, string text, int type) {
        AppLayerContext ctx = Layer.Context(app);
        Layer.EnsureQueues(ctx);
        int now = Window.GetTickMs();
        for (int i = 0; i < ctx.toasts.Count; i = i + 1) {
            ToastItem it = ctx.toasts[i];
            if (it.text == text && it.type == type && !it.closing) {
                it.lifeMs = now - it.bornMs + 3000;
                return;
            }
        }
        ctx.toasts.Add(new ToastItem(text, type, 3000));
        Layer.EnsureQueueHost(app);
    }
    public static void Msg(string text, int type) { Layer.Msg(null, text, type); }
    public static void Msg(string text) { Layer.Msg(null, text, 1); }
    public static void Notify(App app, string title, int type) {
        AppLayerContext ctx = Layer.Context(app);
        Layer.EnsureQueues(ctx);
        ctx.notifs.Add(new ToastItem(title, type, 4000));
        Layer.EnsureQueueHost(app);
    }
    public static void Notify(string title, int type) { Layer.Notify(null, title, type); }
    public static void Notify(string title) { Layer.Notify(null, title, 1); }
    public static void Tips(App app, int anchorX, int anchorY, string text) {
        if (app == null) { app = App.FrameApp(); }
        Tooltip.Request(app, anchorX, anchorY, text, 0, 0);
    }
    public static void Tips(int anchorX, int anchorY, string text) {
        Layer.Tips(null, anchorX, anchorY, text);
    }
    public static void Tips(string text, int anchorX, int anchorY) {
        Layer.Tips(null, anchorX, anchorY, text);
    }
    public static PhotoViewer OpenPhotos(App app, List<string> slides, Binding<int> idx,
            CarouselAnim animation) {
        if (app == null) { app = App.FrameApp(); }
        if (app == null) { return null; }
        PhotoViewer viewer = new PhotoViewer(slides, idx, animation);
        viewer.Show(app);
        return viewer;
    }
    public static void ClosePhotos(App app) {
        if (app == null) { app = App.FrameApp(); }
        if (app == null) { return; }
        PhotoViewer viewer = Layer.Context(app).photoViewer;
        if (viewer != null) { viewer.Close(); }
    }
    public static int BarH(App app) { return app.theme.heightLarge; }
    public static int FooterH(App app) { return app.theme.heightMedium + app.Scale(20); }
    public static int BtnW(App app) { return app.Scale(46); }
    public static bool Inside(int mx, int my, int x, int y, int w, int h) {
        return mx >= x && mx < x + w && my >= y && my < y + h;
    }
    public static void ApplyResize(App app, LayerState s, int mx, int my) {
        int W = app.canvas.Width();
        int H = app.canvas.Height();
        int minW = app.Scale(220);
        int minH = app.Scale(120);
        int dir = s.rDir;
        int dx = mx - s.grabDx;
        int dy = my - s.grabDy;
        if (dir == 1 || dir == 5) {
            int nx = s.rStartX + dx;
            int nw = s.rStartW - dx;
            if (nw < minW) {
                nw = minW;
                nx = s.rStartX + s.rStartW - minW;
            }
            if (nx < 0) {
                nw = nw + nx;
                nx = 0;
            }
            s.x = nx;
            s.w = nw;
        }
        if (dir == 2 || dir == 4) {
            int nw = s.rStartW + dx;
            if (nw < minW) { nw = minW; }
            if (s.rStartX + nw > W) { nw = W - s.rStartX; }
            s.w = nw;
        }
        if (dir >= 3) {
            int nh = s.rStartH + dy;
            if (nh < minH) { nh = minH; }
            if (s.rStartY + nh > H) { nh = H - s.rStartY; }
            s.h = nh;
        }
    }
    public static void MinPos(App app, LayerState s, List<int> outv) {
        int mw = app.Scale(260);
        int gap = app.Scale(8);
        int margin = app.Scale(8);
        int bar = Layer.BarH(app);
        int W = app.canvas.Width();
        int H = app.canvas.Height();
        int perRow = (W - margin * 2 + gap) / (mw + gap);
        if (perRow < 1) { perRow = 1; }
        int col = s.minSlot % perRow;
        int row = s.minSlot / perRow;
        outv.Add(margin + col * (mw + gap));
        outv.Add(H - margin - bar - row * (bar + gap));
    }
    public static void Bounds(App app, LayerState s, List<int> outv) {
        int top = app.titlebarH;
        int bar = Layer.BarH(app);
        int ex = s.x; int ey = s.y; int ew = s.w; int eh = s.h;
        if (s.state == 1) {
            ex = 0; ey = top; ew = app.canvas.Width(); eh = app.canvas.Height() - top;
        } else if (s.state == 2) {
            List<int> mp = new List<int>();
            Layer.MinPos(app, s, mp);
            ex = mp[0]; ey = mp[1];
            ew = app.Scale(260); eh = bar;
        }
        outv.Add(ex); outv.Add(ey); outv.Add(ew); outv.Add(eh);
    }
    public static bool Contains(App app, LayerState s, int mx, int my) {
        List<int> b = new List<int>();
        Layer.Bounds(app, s, b);
        return Layer.Inside(mx, my, b[0], b[1], b[2], b[3]);
    }
    public static int Entrance(App app, LayerState s) {
        if (s.openMs <= 0) { return 1000; }
        int el = Window.GetTickMs() - s.openMs;
        int p = App.Ease(Layer.Clamp01(el * 1000 / 180));
        if (p < 1000) {
            List<int> b = new List<int>();
            Layer.Bounds(app, s, b);
            app.RequestAnimationFrameIn(b[0], b[1] - app.Scale(16),
                b[2], b[3] + app.Scale(16));
        }
        return p;
    }
    public static int EntranceDy(App app, LayerState s) {
        return (1000 - Layer.Entrance(app, s)) * app.Scale(10) / 1000;
    }
    public static int ExitMs() { return 240; }
    public static int ExitP(LayerState s) {
        if (!s.closing || s.closeMs <= 0) { return 1000; }
        return App.Ease(Layer.Clamp01((Window.GetTickMs() - s.closeMs)
            * 1000 / Layer.ExitMs()));
    }
    public static int MulAlpha(int color, int a) {
        if (a >= 1000) { return color; }
        if (a <= 0) { return 0; }
        int rgb = color % 16777216;
        if (rgb < 0) { rgb = rgb + 16777216; }
        int al = (color - rgb) / 16777216 + 256;
        return (al * a / 1000) * 16777216 + rgb;
    }
    public static void FlushCloseRedraw(App app) {
        AppLayerContext ctx = Layer.Context(app);
        if (ctx.requestRedraw) {
            ctx.requestRedraw = false;
            app.RequestRedraw();
        }
    }
    static LayerInputRoot RetainedInput(App app) {
        AppLayerContext context = Layer.Context(app);
        if (context.inputRoot == null) { context.inputRoot = new LayerInputRoot(context); }
        return context.inputRoot;
    }
    static void SyncDialogs(App app) {
        if (app == null) { app = App.FrameApp(); }
        if (app == null) { return; }
        LayerInputRoot root = Layer.RetainedInput(app);
        if (root.dialogHost == null) { root.dialogHost = new LayerDialogHost(app); }
        root.dialogHost.SyncStates(app);
    }
    static bool DialogOwnsOverlay(App app) {
        if (app == null || app.overlayHost == null) { return false; }
        AppLayerContext context = Layer.Context(app);
        return context.inputRoot != null && context.inputRoot.dialogHost != null
            && app.overlayHost.ActiveRoot() == context.inputRoot.dialogHost;
    }
    static void UpdateRetainedRoots(App app, AppLayerContext context) {
        app.SetRetainedLayerRoots(context.windowHost, context.inputRoot.queueHost);
    }
    static void EnsureQueueHost(App app) {
        if (app == null) { app = App.FrameApp(); }
        if (app == null) { return; }
        LayerInputRoot root = Layer.RetainedInput(app);
        if (root.queueHost == null) {
            root.queueHost = new LayerQueueControl(app);
            Layer.UpdateRetainedRoots(app, Layer.Context(app));
        }
    }
}
