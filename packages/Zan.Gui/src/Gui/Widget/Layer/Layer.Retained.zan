using Gui;

namespace Gui.Widget;

// Retained mounting only.  Rendering belongs to OverlayHost and Control's
// normal tree pipeline, not to public static Layer.Render* entry points.
public partial class Layer {
    static LayerInputRoot RetainedInput(App app) {
        AppLayerContext context = Layer.Context(app);
        if (context.inputRoot == null) { context.inputRoot = new LayerInputRoot(context); }
        return context.inputRoot;
    }

    static void SyncDialogs(App app) {
        if (app == null) { app = App.FrameApp(); }
        if (app == null) { return; }
        LayerInputRoot root = Layer.RetainedInput(app);
        if (root.dialogHost == null) { root.dialogHost = new LayerDialogHost(app); }
        root.dialogHost.SyncStates(app);
    }

    static bool DialogOwnsOverlay(App app) {
        if (app == null || app.overlayHost == null) { return false; }
        AppLayerContext context = Layer.Context(app);
        return context.inputRoot != null && context.inputRoot.dialogHost != null
            && app.overlayHost.ActiveRoot() == context.inputRoot.dialogHost;
    }

    // Frame preparation owns model and layout updates. Presentation consumes
    // these saved trees once, below popups and the modal OverlayHost surface.
    // Engine entry point for App.RunOverlays: public because `internal` stops
    // at the module boundary (namespace prefix before the second '.'), and
    // App lives in module `Gui`, not `Gui.Widget` (SPEC access modifiers).
    public static void PaintRetained(App app) {
        if (app == null || app.layerContext == null) { return; }
        AppLayerContext context = (AppLayerContext)app.layerContext;
        if (context.windowHost != null) {
            context.windowHost.RenderTree(app);
            if (!app.ContinuePreparedFrame()) { return; }
        }
        if (context.inputRoot != null && context.inputRoot.queueHost != null) {
            context.inputRoot.queueHost.RenderTree(app);
        }
    }

    // Its participant prepares newly enqueued models; App presentation owns
    // the queue so callers cannot accidentally paint it a second time.
    static void EnsureQueueHost(App app) {
        if (app == null) { app = App.FrameApp(); }
        if (app == null) { return; }
        LayerInputRoot root = Layer.RetainedInput(app);
        if (root.queueHost == null) { root.queueHost = new LayerQueueControl(app); }
    }
}
