using System;
using Gui;

namespace Gui.Widget;

// 一个下拉选项：其标签及是否被选中（多选）。
// 用一个实体代替平行的选项/选中列表。
public class SelectOption {
    // 选项标签（显示文本）。
    public string label;
    // 选项底层取值（未指定时默认为 label）。
    public string val;
    // 多选勾选态（单选模式不用）。
    public bool chosen;
    // 表格式下拉（SelectBox.Table）里这一行除首列以外的单元格。
    // null 表示这条只有 label —— 普通列表模式下始终如此。
    public List<string> cells;
    // 级联模式的子层级；null = 叶子。
    public List<SelectOption> children;
    // 在 SelectBox.opts 平铺列表中的下标。AddOption / AddBranch /
    // AddChild 都会追加到 opts，级联展开链用它寻址。
    public int flatIdx;
    // 父级的平铺下标（顶层为 -1）。级联多选沿它向上修祖链的勾选态，
    // 过滤结果拼完整路径、重开弹层自动展开选中链也靠它。
    public int parentIdx;
    // 分组标题行：只作小标题展示，不可悬停、不可选择。
    public bool grp;
    // 禁用项：可见、置灰，但不可选择。
    public bool disabled;

    // 构造普通选项（无附加列、非分组、无子级）。
    SelectOption(string label, bool chosen) {
        this.label = label;
        this.val = label;
        this.chosen = chosen;
        this.cells = null;
        this.children = null;
        this.flatIdx = 0 - 1;
        this.parentIdx = 0 - 1;
        this.grp = false;
        this.disabled = false;
    }

    SelectOption(string label, string val, bool chosen) {
        this.label = label;
        this.val = (val != null && val != "") ? val : label;
        this.chosen = chosen;
        this.cells = null;
        this.children = null;
        this.flatIdx = 0 - 1;
        this.parentIdx = 0 - 1;
        this.grp = false;
        this.disabled = false;
    }

    // 级联：给本选项挂一个子级，并回填它的平铺下标。
    void Attach(SelectOption child, int idx) {
        if (children == null) { children = new List<SelectOption>(); }
        child.flatIdx = idx;
        children.Add(child);
    }

    // 是否带子层级（级联模式）。
    bool HasChildren() {
        return children != null && children.Count > 0;
    }

    // 第 `i` 列的文本（0 为 label 列），越界返回空串。
    string Cell(int i) {
        if (i <= 0) { return label; }
        if (cells == null) { return ""; }
        int j = i - 1;
        if (j >= cells.Count) { return ""; }
        return cells[j];
    }
}
