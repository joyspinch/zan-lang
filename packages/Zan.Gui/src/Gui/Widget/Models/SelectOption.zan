using System;
using Gui;
namespace Gui.Widget;
public class SelectOption {
    public string label;
    public string val;
    public bool chosen;
    public List<string> cells;
    public List<SelectOption> children;
    public int flatIdx;
    public int parentIdx;
    public bool grp;
    public bool disabled;
    public SelectOption(string label, bool chosen) {
        this.label = label;
        this.val = label;
        this.chosen = chosen;
        this.cells = null;
        this.children = null;
        this.flatIdx = 0 - 1;
        this.parentIdx = 0 - 1;
        this.grp = false;
        this.disabled = false;
    }
    public SelectOption(string label, string val, bool chosen) {
        this.label = label;
        this.val = (val != null && val != "") ? val : label;
        this.chosen = chosen;
        this.cells = null;
        this.children = null;
        this.flatIdx = 0 - 1;
        this.parentIdx = 0 - 1;
        this.grp = false;
        this.disabled = false;
    }
    public void Attach(SelectOption child, int idx) {
        if (children == null) { children = new List<SelectOption>(); }
        child.flatIdx = idx;
        children.Add(child);
    }
    public bool HasChildren() { return children != null && children.Count > 0; }
    public string Cell(int i) {
        if (i <= 0) { return label; }
        if (cells == null) { return ""; }
        int j = i - 1;
        if (j >= cells.Count) { return ""; }
        return cells[j];
    }
}
