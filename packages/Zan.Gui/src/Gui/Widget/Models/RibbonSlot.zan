using System;
using Gui;
namespace Gui.Widget;
public class RibbonSlot {
    public int flat;
    public int group;
    public int item;
    public RibbonItem cmd;
    public int kind;
    public int x;
    public int y;
    public int w;
    public int h;
    public bool overflow;
    RibbonSlot() {
        this.flat = 0;
        this.group = 0;
        this.item = 0;
        this.cmd = null;
        this.kind = 0;
        this.x = 0;
        this.y = 0;
        this.w = 0;
        this.h = 0;
        this.overflow = false;
    }
}
