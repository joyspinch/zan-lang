using System;
using Gui;

namespace Gui.Widget;

// 条带里一个命令的落位（相对条带左沿 / 内容顶）。
// 排布一次的结果就是这些格子的集合——测量宽度、绘制、判定
// 放不下（进溢出菜单）都读同一份，不再各算一遍。
public class RibbonSlot {
    // 跨组连续编号（宿主用它索引自己的动作表；被降级丢弃的
    // 命令也占号，因此编号与命令清单始终一一对应）。
    public int flat;
    // 组号 / 组内序号。
    public int group;
    public int item;
    // 命令本身。
    public RibbonItem cmd;
    // 形态：0 = 大命令（图标+标题），1 = 小命令（图标+标签行），
    // 2 = 纯图标格。
    public int kind;
    // 落位（相对坐标）。
    public int x;
    public int y;
    // 占位宽高（列宽 / 行高，不是画上去的尺寸——画时还要
    // 扣掉格间距）。
    public int w;
    public int h;
    // 放不下：这条命令被收进溢出菜单，不画在条带上。
    public bool overflow;

    RibbonSlot() {
        this.flat = 0;
        this.group = 0;
        this.item = 0;
        this.cmd = null;
        this.kind = 0;
        this.x = 0;
        this.y = 0;
        this.w = 0;
        this.h = 0;
        this.overflow = false;
    }
}
