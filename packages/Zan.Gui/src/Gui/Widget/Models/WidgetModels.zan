public class CarouselAnim {
    public int shown;
    public int from;
    public int startMs;
    public bool animating;
    public int dir;
    public int tickMs;
    public CarouselAnim() {
        this.shown = 0;
        this.from = 0;
        this.startMs = 0;
        this.animating = false;
        this.dir = 1;
        this.tickMs = 0;
    }
}

public class CarouselChrome : Control {
    public weak Carousel owner;
    public Button prevBtn;
    public Button nextBtn;
    public List<Button> dotBtns;
    private int builtCount;
    private void InitChrome(Carousel c) {
        this.InitControl("carousel-chrome");
        this.ClassName = "carousel-chrome";
        owner = c;
        wiresOwnEvents = false;
        builtCount = 0;
        dotBtns = new List<Button>();
        prevBtn = new Button("") { ClassName = "carousel-arrow carousel-arrow-prev", Icon = "arrow-left" };
        CarouselChromeAction previous = new CarouselChromeAction(c, -1, -1);
        prevBtn.Click.Add(previous.Invoke);
        this.Add(prevBtn);
        nextBtn = new Button("") { ClassName = "carousel-arrow carousel-arrow-next", Icon = "arrow-right" };
        CarouselChromeAction next = new CarouselChromeAction(c, 1, -1);
        nextBtn.Click.Add(next.Invoke);
        this.Add(nextBtn);
        this.SyncDots();
    }
    public CarouselChrome(Carousel c) { InitChrome(c); }
    public void SyncDots() {
        if (owner == null) { return; }
        int count = owner.slides.Count;
        if (count == builtCount) { return; }
        for (int i = 0; i < dotBtns.Count; i = i + 1) {
            this.Remove(dotBtns[i]);
        }
        dotBtns.Clear();
        for (int i = 0; i < count; i = i + 1) {
            Button dot = new Button("") { ClassName = "carousel-dot" };
            CarouselChromeAction select = new CarouselChromeAction(owner, 0, i);
            dot.Click.Add(select.Invoke);
            dotBtns.Add(dot);
            this.Add(dot);
        }
        builtCount = count;
    }
    public override void Arrange(int px, int py, int pw, int ph) {
        base.Arrange(px, py, pw, ph);
        if (owner == null) { return; }
        this.SyncDots();
        int count = owner.slides.Count;
        if (count == 0) { return; }
        int cur = owner.Index.Get();
        if (cur < 0) { cur = 0; }
        if (cur >= count) { cur = count - 1; }
        int pad = 12;
        int ab = 28;
        if (owner.Vert()) {
            prevBtn.Icon = "arrow-up";
            nextBtn.Icon = "arrow-down";
            int prevX = px + (pw - ab) / 2;
            int prevY = py + pad;
            prevBtn.Arrange(prevX, prevY, ab, ab);
            nextBtn.Arrange(prevX, py + ph - ab - pad, ab, ab);
        } else {
            prevBtn.Icon = "arrow-left";
            nextBtn.Icon = "arrow-right";
            int prevY = py + (ph - ab) / 2;
            prevBtn.Arrange(px + pad, prevY, ab, ab);
            nextBtn.Arrange(px + pw - ab - pad, prevY, ab, ab);
        }
        int dot = 8;
        int dotGap = 6;
        int dotsW = count * dot + (count - 1) * dotGap;
        bool dotsCol = (owner.dotPlacement == "left" || owner.dotPlacement == "right");
        int dx = px + (pw - dotsW) / 2;
        int dy = py + ph - 24;
        if (owner.dotPlacement == "top") {
            dy = py + pad;
        } else if (dotsCol) {
            dx = (owner.dotPlacement == "left") ? px + pad : px + pw - pad - dot;
            dy = py + (ph - dotsW) / 2;
        }
        for (int i = 0; i < dotBtns.Count; i = i + 1) {
            int dw = (i == cur) ? dot * 2 : dot;
            dotBtns[i].Arrange(dx, dy, dw, dot);
            if (i == cur) {
                dotBtns[i].AddClass("active");
            } else {
                dotBtns[i].RemoveClass("active");
            }
            if (dotsCol) { dy = dy + dw + dotGap; }
            else { dx = dx + dw + dotGap; }
        }
    }
    public override void OnPaint(App app) { }
    protected override Control HitTestCore(int x, int y, int pointerType, List<Control> excludedSubtrees) {
        Control hit = base.HitTestCore(x, y, pointerType, excludedSubtrees);
        return hit == this ? null : hit;
    }
}
class CarouselChromeAction {
    weak Carousel owner;
    int direction;
    int index;
    public CarouselChromeAction(Carousel carousel, int step, int target) {
        owner = carousel; direction = step; index = target;
    }
    public void Invoke() {
        Carousel carousel = owner;
        if (carousel == null) { return; }
        if (direction < 0) { carousel.Prev(); }
        else if (direction > 0) { carousel.Next(); }
        else { carousel.GoTo(index); }
    }
}

internal class CarouselDriver : AppLoopParticipant {
    internal weak Carousel owner;
    internal CarouselDriver(Carousel carousel) { owner = carousel; }
    public int NextDeadline() {
        Carousel carousel = owner;
        return carousel != null ? carousel.LoopDeadline() : -1;
    }
    public void Tick(App app, int now) {
        Carousel carousel = owner;
        if (carousel != null) { carousel.LoopTick(app, now); }
    }
}

