        this.label = label;
        this.startOffset = startOffset;
        this.endOffset = endOffset;
    }
}

public class DropdownChrome {
    internal static Rect ContentBounds(Control trigger, StyleBox style, int padding) {
        int left = style.PadLOr(padding) + style.BorderLeftPx();
        int right = style.PadROr(padding) + style.BorderRightPx();
        int top = style.PadTOr(0) + style.BorderTopPx();
        int bottom = style.PadBOr(0) + style.BorderBottomPx();
        int width = trigger.bw - left - right;
        int height = trigger.bh - top - bottom;
        return new Rect(trigger.bx + left, trigger.by + top,
                        width > 0 ? width : 0, height > 0 ? height : 0);
    }
    internal static int SlotSize(Rect content, int size) {
        if (size > content.height) { size = content.height; }
        if (size > content.width) { size = content.width; }
        return size;
    }
    internal static void PaintLabel(Canvas canvas, Rect content, int width,
                                    string label, int font, int color) {
        if (width <= 0 || content.height <= 0) { return; }
        canvas.DrawText(content.x, Canvas.CenterTextY(content.y, content.height, font),
                        Ellipsis.Fit(label, width, font), color, font);
    }
    internal static void PaintArrow(Canvas canvas, Rect content, int size, int color) {
        if (size <= 0) { return; }
        canvas.DrawGlyphIn("chevron-down", content.Right() - size, content.y,
                           size, content.height, size, color);
    }
    public static void Paint(App app, Control trigger, string label, bool open) {
        int id = trigger.WidgetId();
        int x = trigger.bx; int y = trigger.by; int w = trigger.bw; int h = trigger.bh;
        Canvas c = app.canvas;
        Theme t = app.theme;
        int hv = app.StyleHoverLevelIn(id, 0, x, y, w, h);
        if (open) { hv = 1000; }
        StyleBox normal = Style.Of(app, "select", "", Style.SNormal());
        StyleBox hover = Style.Of(app, "select", "", Style.SHover());
        StyleBox s = StyleBox.Blend(normal, hover, hv);
        s.Paint(app, x, y, w, h);
        Rect content = DropdownChrome.ContentBounds(trigger, normal, t.paddingMedium);
        int fs = normal.FontOr(Style.FontFallback(app, "medium"));
        StyleBox arrow = Style.Part(app, "select", "arrow", "", "", "", Style.SNormal());
        int size = DropdownChrome.SlotSize(content, arrow.FontOr(t.iconSizeSmall));
        DropdownChrome.PaintLabel(c, content, content.width - size - t.gapSmall, label, fs, s.fg);
        DropdownChrome.PaintArrow(c, content, size, arrow.FgOr(s.fg));
    }
}

public class DropdownSession<T> : AppLoopParticipant, AppPreparationParticipant {
    public weak Dropdown<T> owner;
    public int session;
    public void Selected(Control sender) {
        Dropdown<T> dropdown = owner;
        if (dropdown != null) { dropdown.MenuSelected(sender); }
    }
    public void Tick(App app, int now) { }
    public int NextDeadline() { return -1; }
    public void BeforeInput(App app, int kind) { this.Prepare(app); }
    public void BeforePaint(App app, int frameSequence) { this.Prepare(app); }
    void Prepare(App app) {
        Dropdown<T> dropdown = owner;
        if (dropdown != null) { dropdown.PreparePopup(app, session); }
    }
}

public class FbFlow : Panel {
    // 按父类种类上报：序列化与自动化以 "Panel" 识别本控件。
    public override string Kind() { return "Panel"; }
    // 与 children 平行的列宽表（span 1..24）。
    public List<int> spans;
    public int colGap;
    public int rowGap;
    public int minCell;
    public int mColGap;
    public int mRowGap;
    public int mMinCell;
    public FbFlow() {
        this.InitPanel("fbflow", 3);
        this.spans = new List<int>();
        this.colGap = 12;
        this.rowGap = 6;
        this.minCell = 24;
        this.mColGap = 12;
        this.mRowGap = 6;
        this.mMinCell = 24;
        this.layoutFlow = true;
        this.SetDocumentFactory((string kind) => new FbFlow(), "FbFlow");
    }
    public override void CloneContentTo(Control target, CloneTreeFn clone) {
        FbFlow copy = (FbFlow)target;
        copy.colGap = this.colGap;
        copy.rowGap = this.rowGap;
        copy.minCell = this.minCell;
        for (int i = 0; i < this.ChildCount(); i = i + 1) {
            Control cell = clone(this.ChildAt(i));
            if (cell != null) { copy.AddCell(cell, this.SpanAt(i)); }
        }
    }
    public void AddCell(Control c, int span) {
        this.spans.Add(span);
        this.Add(c);
    }
    public int SpanAt(int i) {
        if (i < this.spans.Count) {
            int s = this.spans[i];
            if (s < 1) { return 1; }
            if (s > 24) { return 24; }
            return s;
        }
        return 24;
    }
    public int RowEnd(int start) {
        int n = this.ChildCount();
        int end = start;
        int cols = 0;
        while (end < n) {
            int sp = this.SpanAt(end);
            if (end > start && cols + sp > 24) { break; }
            cols = cols + sp;
            end = end + 1;
            if (cols >= 24) { break; }
        }
        return end;
    }
    public int RowHeight(int start, int end) {
        int rowH = 0;
        for (int k = start; k < end; k = k + 1) {
            int hk = this.ChildAt(k).prefH;
            if (hk > rowH) { rowH = hk; }
        }
        return rowH;
    }
    public override void OnPaint(App app) {
    }
    public override void OnMeasure(App app) {
        this.mColGap = app.Scale(this.colGap);
        this.mRowGap = app.Scale(this.rowGap);
        this.mMinCell = app.Scale(this.minCell);
        int n = this.ChildCount();
        int i = 0;
        int total = 0;
        int rows = 0;
        while (i < n) {
            int end = this.RowEnd(i);
            total = total + this.RowHeight(i, end);
            rows = rows + 1;
            i = end;
        }
        if (rows > 1) { total = total + this.mRowGap * (rows - 1); }
        this.prefH = total;
        this.prefW = 0;
    }
    public override void Arrange(int px, int py, int pw, int ph) {
        if (pw < 0) { pw = 0; }
        if (ph < 0) { ph = 0; }
        this.bx = px;
        this.by = py;
        this.bw = pw;
        this.bh = ph;
        int cx = px + this.StylePadL();
        int cy = py + this.StylePadT();
        int cw = pw - this.StylePadL() - this.StylePadR();
        if (cw < 0) { cw = 0; }
        int n = this.ChildCount();
        int i = 0;
        int rowY = cy;
        while (i < n) {
            int end = this.RowEnd(i);
            int rowH = this.RowHeight(i, end);
            int acc = 0;
            for (int k = i; k < end; k = k + 1) {
                int xa = cx + cw * acc / 24;
                acc = acc + this.SpanAt(k);
                int xb = cx + cw * acc / 24;
                int wCell = xb - xa;
                if (k < end - 1) { wCell = wCell - this.mColGap; }
                if (wCell < this.mMinCell) { wCell = this.mMinCell; }
                this.ChildAt(k).Arrange(xa, rowY, wCell, rowH);
            }
            rowY = rowY + rowH + this.mRowGap;
            i = end;
        }
    }
}

public class FbStack : Panel {
    // 按父类种类上报：序列化与自动化以 "Panel" 识别本控件。
    public override string Kind() { return "Panel"; }
    public FbStack() {
        this.InitPanel("fbstack", 3);
        this.SetDocumentFactory((string kind) => new FbStack(), "FbStack");
    }
    public FbStack(string caption) : this() {
        Label label = new Label(caption);
        label.SetDocumentFactory((string kind) => new Label(), "Label");
        this.Add(label);
    }
    public override void OnPaint(App app) {
    }
    public override void OnMeasure(App app) {
        int h = 0;
        int w = 0;
        for (int i = 0; i < this.ChildCount(); i = i + 1) {
            h = h + this.ChildAt(i).prefH;
            if (this.ChildAt(i).prefW > w) { w = this.ChildAt(i).prefW; }
        }
        this.prefH = h;
        this.prefW = 0;
    }
    public override void Arrange(int px, int py, int pw, int ph) {
        if (pw < 0) { pw = 0; }
        if (ph < 0) { ph = 0; }
        this.bx = px;
        this.by = py;
        this.bw = pw;
        this.bh = ph;
        int cy = py;
        int rest = ph;
        for (int i = 0; i < this.ChildCount(); i = i + 1) {
            Control c = this.ChildAt(i);
            if (c.grow) {
                c.Arrange(px, cy, pw, rest);
            } else {
                int hh = c.prefH;
                if (hh > rest) { hh = rest; }
                if (hh < 0) { hh = 0; }
                c.Arrange(px, cy, pw, hh);
                cy = cy + hh;
                rest = rest - hh;
            }
        }
    }
}

