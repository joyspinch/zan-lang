public class RadioOption {
    public string label;
    public int value;
    public bool hasValue;
    public bool disabled;
    public string cls;
    public RadioOption(string lbl) {
        label = lbl; value = 0; hasValue = false;
        disabled = false; cls = "";
    }
    public RadioOption(string lbl, int val) {
        label = lbl; value = val; hasValue = true;
        disabled = false; cls = "";
    }
    public RadioOption(string lbl, int val, bool dis) {
        label = lbl; value = val; hasValue = true;
        disabled = dis; cls = "";
    }
}

public class RadioOptionMeta {
    public int value;
    public bool disabled;
    public RadioOptionMeta(int value, bool disabled) {
        this.value = value;
        this.disabled = disabled;
    }
}

public class SliderMarkItem {
    public int value;
    public string label;
    public SliderMarkItem(int value, string label) {
        this.value = value;
        this.label = label;
    }
}

public class Step {
    public string label;
    public string desc;
    public string icon;
    public Step(string label, string desc, string icon) {
        this.label = label;
        this.desc = desc;
        this.icon = icon;
    }
}

internal class TabHeaderButton : Button {
    // 按父类种类上报：序列化与自动化以 "Button" 识别本控件。
    public override string Kind() { return "Button"; }
    public override string StyleType() { return "tab"; }
    public override StyleBox ResolveStyle(App app, int state) {
        if (Style.Has(Class, "active")) { state = state | Style.SSelected(); }
        return base.ResolveStyle(app, state);
    }
}

public class TabItem {
    public string label;
    public bool closable;
    public Control headerSlot;
    public TabItem(string label, bool closable) {
        this.label = label;
        this.closable = closable;
        this.headerSlot = null;
    }
    public TabItem Header(Control header) {
        this.headerSlot = header;
        return this;
    }
}

public class TimelineItem : Control {
    public override Control CreateCloneShell() { return new TimelineItem(); }
    public string time;
    public string title;
    public string description;
    public string cls;
    public string icon;
    public bool pending;
    public TimelineItem() {
        this.InitControl("timeline-item");
        this.time = "";
        this.title = "";
        this.description = "";
        this.cls = "";
        this.icon = "";
        this.pending = false;
    }
    public TimelineItem(Control content) {
        this.InitControl("timeline-item");
        this.time = "";
        this.title = "";
        this.description = "";
        this.cls = "";
        this.icon = "";
        this.pending = false;
        if (content != null) { this.Add(content); }
    }
    public TimelineItem(string time, Control content) {
        this.InitControl("timeline-item");
        this.time = time != null ? time : "";
        this.title = "";
        this.description = "";
        this.cls = "";
        this.icon = "";
        this.pending = false;
        if (content != null) { this.Add(content); }
    }
    public TimelineItem(string time, string title, string description) {
        this.InitControl("timeline-item");
        this.time = time != null ? time : "";
        this.title = title != null ? title : "";
        this.description = description != null ? description : "";
        this.cls = "";
        this.icon = "";
        this.pending = false;
    }
    public TimelineItem(string time, string title, string description, string cls) {
        this.InitControl("timeline-item");
        this.time = time != null ? time : "";
        this.title = title != null ? title : "";
        this.description = description != null ? description : "";
        this.cls = cls != null ? cls : "";
        this.icon = "";
        this.pending = false;
    }
    public TimelineItem(string time, string title, string description,
                        string cls, string icon) {
        this.InitControl("timeline-item");
        this.time = time != null ? time : "";
        this.title = title != null ? title : "";
        this.description = description != null ? description : "";
        this.cls = cls != null ? cls : "";
        this.icon = icon != null ? icon : "";
        this.pending = false;
    }
    protected override List<PropSpec> DefineProps() {
        List<PropSpec> ps = new List<PropSpec>();
        ps.Add(PropSpec.Text("title", "Title").Field("title"));
        ps.Add(PropSpec.Text("time", "Time").Field("time"));
        return ps;
    }
    public override void OnMeasure(App app) {
        int maxW = 0;
        int totalH = 0;
        for (int i = 0; i < this.ChildCount(); i = i + 1) {
            Control c = this.ChildAt(i);
            c.OnMeasure(app);
            if (c.prefW > maxW) { maxW = c.prefW; }
            totalH = totalH + c.prefH;
        }
        prefW = maxW;
        prefH = totalH;
    }
    public override void OnPaint(App app) {
        if (bw <= 0 || bh <= 0) { return; }
        int cy = by;
        for (int i = 0; i < this.ChildCount(); i = i + 1) {
            Control c = this.ChildAt(i);
            int ch = c.prefH > 0 ? c.prefH : bh;
            c.Arrange(bx, cy, bw, ch);
            c.RenderTree(app);
            cy = cy + ch;
        }
    }
}

public class TooltipRequest {
    public string text;
    public int x;
    public int y;
    public int placement;
    public int width;
}
