using System;
using Gui;

namespace Gui.Widget;

// 多选目标标签：标签及其开/关状态（1 = 已选）。
public class WizardTarget {
    public string name;
    public int selected;
    // 目标平台 id（如 "windows-x64"，与宿主的 id 列表同位）。
    // 空串 = 无 id：不参与"按模板支持平台置灰"的判定。
    public string id;

    // 构建目标标签。
    WizardTarget(string n, int s) {
        name = n;
        selected = s;
        id = "";
    }

    // 带平台 id 的构建（New Project 向导用）。
    WizardTarget(string n, int s, string tid) {
        name = n;
        selected = s;
        id = tid;
    }
}
