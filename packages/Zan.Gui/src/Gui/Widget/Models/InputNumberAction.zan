using Gui;

namespace Gui.Widget;

// InputNumber owns its children; their handlers must not own InputNumber in return.
public class InputNumberAction {
    public weak InputNumber owner;

    public InputNumberAction(InputNumber number) {
        owner = number;
    }

    public void StepDown() {
        InputNumber number = owner;
        if (number == null) { return; }
        number.StepDown();
    }

    public void StepUp() {
        InputNumber number = owner;
        if (number == null) { return; }
        number.StepUp();
    }

    public void InputChange() {
        InputNumber number = owner;
        if (number == null) { return; }
        number.OnInputChange();
    }

    public void InputSubmit() {
        InputNumber number = owner;
        if (number == null) { return; }
        number.OnInputSubmit();
    }
}
