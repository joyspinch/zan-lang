using System;
using Gui;

namespace Gui.Widget;

// App 实例私有的弹层与队列运行上下文。
// 彻底隔离多窗口/多实例同屏运行时的 Toast 队列、通知中心、Z-Order 堆叠、
// 照片浏览器活跃状态与序列号游标，杜绝跨窗口竞态与状态互相踩踏。
public class AppLayerContext {
    public List<ToastItem> toasts;
    public List<ToastItem> notifs;
    public Rect toastPrev;
    public Rect notifPrev;
    public List<LayerState> zorder;
    public bool requestRedraw;
    public int photosTick;
    public SignalInt photosIdx;
    public int photoCount;
    public bool photosCloseReq;
    public int savedSeq;
    public int bodySeq;

    public AppLayerContext() {
        this.toasts = new List<ToastItem>();
        this.notifs = new List<ToastItem>();
        this.toastPrev = new Rect(0, 0, 0, 0);
        this.notifPrev = new Rect(0, 0, 0, 0);
        this.zorder = new List<LayerState>();
        this.requestRedraw = false;
        this.photosTick = 0;
        this.photosIdx = null;
        this.photoCount = 0;
        this.photosCloseReq = false;
        this.savedSeq = 0;
        this.bodySeq = 980000;
    }
}
