using System;
using Gui;

namespace Gui.Widget;

// App 实例私有的功能区（Ribbon）运行态上下文。
// 彻底隔离多窗口/多实例同屏运行时的溢出列表、按钮位置、排布几何与菜单开闭状态，
// 杜绝跨窗口竞态与状态互相覆盖。
public class AppRibbonState {
    public List<RibbonSlot> lastOverflow;
    public Rect lastOverflowBtn;
    public RibbonLayout lastLayout;
    public bool overflowMenuOpen;
    public int tipBaseY;

    public AppRibbonState() {
        this.lastOverflow = new List<RibbonSlot>();
        this.lastOverflowBtn = new Rect(0, 0, 0, 0);
        this.lastLayout = new RibbonLayout();
        this.overflowMenuOpen = false;
        this.tipBaseY = 0;
    }
}
