using System;
using System.Collections.Generic;
using Gui;
using Gui.Backend;

namespace Gui.Widget;

// 轮播图覆盖层：以声明式 Button 构成上一张/下一张导航与指示点，
// 彻底消除裸画布微绘与手工 hitTester / EventKind 判定。
public class CarouselChrome : Control {
    public Carousel owner;
    public Button prevBtn;
    public Button nextBtn;
    public List<Button> dotBtns;
    private int builtCount;

    private void InitChrome(Carousel c) {
        this.InitControl("carousel-chrome", 1);
        this.ClassName = "carousel-chrome";
        owner = c;
        wiresOwnEvents = false;
        builtCount = 0;
        dotBtns = new List<Button>();

        prevBtn = new Button("").Ghost().Small();
        prevBtn.ClassName = "carousel-arrow carousel-arrow-prev";
        prevBtn.Icon = "arrow-left";
        prevBtn.Click.Add(() => {
            if (owner != null) {
                App a = this.FindApp();
                owner.Prev(a);
            }
        });
        this.Add(prevBtn);

        nextBtn = new Button("").Ghost().Small();
        nextBtn.ClassName = "carousel-arrow carousel-arrow-next";
        nextBtn.Icon = "arrow-right";
        nextBtn.Click.Add(() => {
            if (owner != null) {
                App a = this.FindApp();
                owner.Next(a);
            }
        });
        this.Add(nextBtn);

        this.SyncDots();
    }

    public CarouselChrome(Carousel c) { InitChrome(c); }

    public void SyncDots() {
        if (owner == null) { return; }
        int count = owner.slides.Count;
        if (count == builtCount) { return; }
        // 移除旧指示点按钮
        for (int i = 0; i < dotBtns.Count; i = i + 1) {
            this.children.Remove(dotBtns[i]);
        }
        dotBtns.Clear();
        for (int i = 0; i < count; i = i + 1) {
            int targetIdx = i;
            Button dot = new Button("").Ghost().Small();
            dot.ClassName = "carousel-dot";
            dot.Click.Add(() => {
                if (owner != null) {
                    App a = this.FindApp();
                    owner.GoTo(a, targetIdx);
                }
            });
            dotBtns.Add(dot);
            this.Add(dot);
        }
        builtCount = count;
    }

    public override void Arrange(int px, int py, int pw, int ph) {
        base.Arrange(px, py, pw, ph);
        if (owner == null) { return; }
        this.SyncDots();
        int count = owner.slides.Count;
        if (count == 0) { return; }
        int cur = owner.model.Get();
        if (cur < 0) { cur = 0; }
        if (cur >= count) { cur = count - 1; }

        int pad = 12;
        int ab = 28;
        if (owner.Vert()) {
            prevBtn.Icon = "arrow-up";
            nextBtn.Icon = "arrow-down";
            int prevX = px + (pw - ab) / 2;
            int prevY = py + pad;
            prevBtn.Arrange(prevX, prevY, ab, ab);
            nextBtn.Arrange(prevX, py + ph - ab - pad, ab, ab);
        } else {
            prevBtn.Icon = "arrow-left";
            nextBtn.Icon = "arrow-right";
            int prevY = py + (ph - ab) / 2;
            prevBtn.Arrange(px + pad, prevY, ab, ab);
            nextBtn.Arrange(px + pw - ab - pad, prevY, ab, ab);
        }

        // 排布指示点
        int dot = 8;
        int dotGap = 6;
        int dotsW = count * dot + (count - 1) * dotGap;
        bool dotsCol = (owner.dotPlacement == "left" || owner.dotPlacement == "right");
        int dx = px + (pw - dotsW) / 2;
        int dy = py + ph - 24;
        if (owner.dotPlacement == "top") {
            dy = py + pad;
        } else if (dotsCol) {
            dx = (owner.dotPlacement == "left") ? px + pad : px + pw - pad - dot;
            dy = py + (ph - dotsW) / 2;
        }

        for (int i = 0; i < dotBtns.Count; i = i + 1) {
            int dw = (i == cur) ? dot * 2 : dot;
            dotBtns[i].Arrange(dx, dy, dw, dot);
            if (i == cur) {
                dotBtns[i].AddClass("active");
            } else {
                dotBtns[i].RemoveClass("active");
            }
            if (dotsCol) { dy = dy + dw + dotGap; }
            else { dx = dx + dw + dotGap; }
        }
    }

    public override void OnPaint(App app) {
        if (owner == null) { return; }
        this.SyncDots();
    }
}
