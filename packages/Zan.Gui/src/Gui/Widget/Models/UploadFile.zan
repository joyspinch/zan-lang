using System;
using System.IO;
using System.Net.External;
using System.Threading;
using Gui;
using Gui.Component;

namespace Gui.Widget;

// Upload 列表中的一个文件项（Naive UI file-list 元素）。
public class UploadFile {
    // 组件内唯一 id（入列时由 Upload 赋值）。
    public int id;
    // 文件名（显示用，含扩展名）。
    public string name;
    // 远端地址：Success 且非空时名称渲染为可点击链接。
    public string url;
    // 缩略图来源（本地路径或 http/https）；空且项为图片时回退 path。
    public string thumb;
    // 本地文件路径（拖拽/选择/内置传输的来源；纯演示项为空）。
    public string path;
    // 状态附言：Error 时为失败原因。
    public string message;
    // 传输响应体（内置 HTTP 成功时填充；CustomRequest 可自填）。
    public string response;
    // 字节大小（已知时 > 0）。
    public int size;
    public int status;
    // 进度百分比（0..100，Uploading 中刷新）。
    public int percent;
    // 小写扩展名（不含点）。
    public string ext;
    // 归属的 Upload 宿主（组件入列路径自动回填；宿主自造的受控项为 null）。
    // 让静态方法组形式的 CustomRequest 能回推 SetItemPercent/SetItemStatus。
    public Upload owner;

    // 构造空白项：Pending 状态、无扩展名、全字段空。
    UploadFile() {
        id = 0;
        name = "";
        url = "";
        thumb = "";
        path = "";
        message = "";
        response = "";
        size = 0;
        status = UploadStatus.Pending();
        percent = 0;
        ext = "";
    }

    // 取小写扩展名（不含点）；无点返回 ""。
    static string ExtOf(string fileName) {
        string low = fileName.ToLower();
        int i = low.Length - 1;
        while (i >= 0) {
            if (low[i] == 46) { return low.Substring(i + 1); }
            i = i - 1;
        }
        return "";
    }
}
