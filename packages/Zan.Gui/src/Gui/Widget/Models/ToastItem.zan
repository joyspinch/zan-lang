using System;
using Gui;
using Gui.Backend;
namespace Gui.Widget;
public class ToastItem {
    public string text;
    public int type;
    public int bornMs;
    public int lifeMs;
    public bool closing;
    public int closeMs;
    public int curY;
    public int curX;
    public ToastItem(string text, int type, int lifeMs) {
        this.text = text;
        this.type = type;
        this.bornMs = Window.GetTickMs();
        this.lifeMs = lifeMs;
        this.closing = false;
        this.closeMs = 0;
        this.curY = 0 - 99999;
        this.curX = 0 - 99999;
    }
}
