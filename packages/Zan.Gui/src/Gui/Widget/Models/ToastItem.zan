using System;
using Gui;
using Gui.Backend;

namespace Gui.Widget;

// 一个短暂的队列项（toast / notification）。队列掌管其诞生
// 时刻，以便淡入、存活 `lifeMs` 后淡出；`curY`/`curX`
// 携带缓动后的屏幕位置，使更早的项被移除时
// 堆栈能平滑收拢。
public class ToastItem {
    public string text;
    public int type;
    public int bornMs;
    public int lifeMs;
    public bool closing;
    public int closeMs;
    public int curY;
    public int curX;

    ToastItem(string text, int type, int lifeMs) {
        this.text = text;
        this.type = type;
        this.bornMs = Window.GetTickMs();
        this.lifeMs = lifeMs;
        this.closing = false;
        this.closeMs = 0;
        this.curY = 0 - 99999;
        this.curX = 0 - 99999;
    }
}
