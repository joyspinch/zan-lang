using System;
using Gui;

namespace Gui.Widget;

// 排版产物的一行：段列表、行宽、对齐（0 左 1 中 2 右）与行高。
// 段是同一渲染样式下连续的文本片段，跨 run 折行时颜色/背景/链接
// 随段延续。字段直接读写（控件内部数据，仿 TextRun 先例）。
public class RichTextLine {
    public List<RichTextSegment> segments;
    public int width;
    public int alignment;
    public int height;

    // 构造一个空行并指定对齐。
    RichTextLine(int alignment) {
        this.segments = new List<RichTextSegment>();
        this.width = 0;
        this.alignment = alignment;
        this.height = 0;
    }
}
