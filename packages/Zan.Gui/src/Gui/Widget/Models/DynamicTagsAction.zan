namespace Gui.Widget;

public class DynamicTagsAction {
    public weak DynamicTags owner;
    private int index;

    public DynamicTagsAction(DynamicTags tags, int itemIndex) { owner = tags; index = itemIndex; }
    public void Close() { DynamicTags tags = owner; if (tags != null) { tags.RemoveAt(index); } }
    public void StartEdit() { DynamicTags tags = owner; if (tags != null) { tags.StartEdit(); } }
}
