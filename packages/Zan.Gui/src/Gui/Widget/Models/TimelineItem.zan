using System;
using Gui;
namespace Gui.Widget;
[GuiKind("TimelineItem")]
public class TimelineItem : Control {
    public override Control CreateCloneShell() { return new TimelineItem(); }
    public string time;
    public string title;
    public string description;
    public string cls;
    public string icon;
    public bool pending;
    public TimelineItem() {
        this.InitControl("timeline-item");
        this.time = "";
        this.title = "";
        this.description = "";
        this.cls = "";
        this.icon = "";
        this.pending = false;
    }
    public TimelineItem(Control content) {
        this.InitControl("timeline-item");
        this.time = "";
        this.title = "";
        this.description = "";
        this.cls = "";
        this.icon = "";
        this.pending = false;
        if (content != null) { this.Add(content); }
    }
    public TimelineItem(string time, Control content) {
        this.InitControl("timeline-item");
        this.time = time != null ? time : "";
        this.title = "";
        this.description = "";
        this.cls = "";
        this.icon = "";
        this.pending = false;
        if (content != null) { this.Add(content); }
    }
    public TimelineItem(string time, string title, string description) {
        this.InitControl("timeline-item");
        this.time = time != null ? time : "";
        this.title = title != null ? title : "";
        this.description = description != null ? description : "";
        this.cls = "";
        this.icon = "";
        this.pending = false;
    }
    public TimelineItem(string time, string title, string description, string cls) {
        this.InitControl("timeline-item");
        this.time = time != null ? time : "";
        this.title = title != null ? title : "";
        this.description = description != null ? description : "";
        this.cls = cls != null ? cls : "";
        this.icon = "";
        this.pending = false;
    }
    public TimelineItem(string time, string title, string description,
                        string cls, string icon) {
        this.InitControl("timeline-item");
        this.time = time != null ? time : "";
        this.title = title != null ? title : "";
        this.description = description != null ? description : "";
        this.cls = cls != null ? cls : "";
        this.icon = icon != null ? icon : "";
        this.pending = false;
    }
    protected override List<PropSpec> DefineProps() {
        List<PropSpec> ps = new List<PropSpec>();
        ps.Add(PropSpec.Text("title", "Title").Field("title"));
        ps.Add(PropSpec.Text("time", "Time").Field("time"));
        return ps;
    }
    public override void OnMeasure(App app) {
        int maxW = 0;
        int totalH = 0;
        for (int i = 0; i < this.ChildCount(); i = i + 1) {
            Control c = this.ChildAt(i);
            c.OnMeasure(app);
            if (c.prefW > maxW) { maxW = c.prefW; }
            totalH = totalH + c.prefH;
        }
        prefW = maxW;
        prefH = totalH;
    }
    public override void OnPaint(App app) {
        if (bw <= 0 || bh <= 0) { return; }
        int cy = by;
        for (int i = 0; i < this.ChildCount(); i = i + 1) {
            Control c = this.ChildAt(i);
            int ch = c.prefH > 0 ? c.prefH : bh;
            c.Arrange(bx, cy, bw, ch);
            c.RenderTree(app);
            cy = cy + ch;
        }
    }
}
