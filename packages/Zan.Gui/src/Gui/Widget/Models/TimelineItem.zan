using System;
using Gui;

namespace Gui.Widget;

// 时间线条目（DOM 容器组件）：支持承载时间/标题/描述文本，更支持嵌入任意子控件（Card/Button/Tag 等）。
public class TimelineItem : Control {
    public string time;
    public string title;
    public string description;
    public string cls;
    public string icon;
    public bool pending;

    public TimelineItem() {
        this.InitControl("timeline-item", 1);
        this.time = "";
        this.title = "";
        this.description = "";
        this.cls = "";
        this.icon = "";
        this.pending = false;
    }

    public TimelineItem(Control content) {
        this.InitControl("timeline-item", 1);
        this.time = "";
        this.title = "";
        this.description = "";
        this.cls = "";
        this.icon = "";
        this.pending = false;
        if (content != null) {
            this.Add(content);
        }
    }

    public TimelineItem(string time, Control content) {
        this.InitControl("timeline-item", 1);
        this.time = time != null ? time : "";
        this.title = "";
        this.description = "";
        this.cls = "";
        this.icon = "";
        this.pending = false;
        if (content != null) {
            this.Add(content);
        }
    }

    // 不带语义类的条目：圆点用默认样式。
    public TimelineItem(string time, string title, string description) {
        this.InitControl("timeline-item", 1);
        this.time = time != null ? time : "";
        this.title = title != null ? title : "";
        this.description = description != null ? description : "";
        this.cls = "";
        this.icon = "";
        this.pending = false;
    }

    // 带语义类的条目（success / error / …，决定圆点配色）。
    public TimelineItem(string time, string title, string description, string cls) {
        this.InitControl("timeline-item", 1);
        this.time = time != null ? time : "";
        this.title = title != null ? title : "";
        this.description = description != null ? description : "";
        this.cls = cls != null ? cls : "";
        this.icon = "";
        this.pending = false;
    }

    // 带自定义图标的条目：`icon` 非空时圆点改画该图标，
    // 颜色取圆点样式的前/背景（随语义角色走）。
    public TimelineItem(string time, string title, string description,
                        string cls, string icon) {
        this.InitControl("timeline-item", 1);
        this.time = time != null ? time : "";
        this.title = title != null ? title : "";
        this.description = description != null ? description : "";
        this.cls = cls != null ? cls : "";
        this.icon = icon != null ? icon : "";
        this.pending = false;
    }

    public override string Kind() { return "TimelineItem"; }

    public override void OnMeasure(App app) {
        int maxW = 0;
        int totalH = 0;
        for (int i = 0; i < children.Count; i = i + 1) {
            Control c = children[i];
            c.OnMeasure(app);
            if (c.prefW > maxW) { maxW = c.prefW; }
            totalH = totalH + c.prefH;
        }
        prefW = maxW;
        prefH = totalH;
    }

    public override void OnPaint(App app) {
        if (bw <= 0 || bh <= 0) { return; }
        int cy = by;
        for (int i = 0; i < children.Count; i = i + 1) {
            Control c = children[i];
            int ch = c.prefH > 0 ? c.prefH : bh;
            c.Arrange(bx, cy, bw, ch);
            c.RenderTree(app);
            cy = cy + ch;
        }
    }
}
