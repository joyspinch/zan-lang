using System;
using Gui;

namespace Gui.Widget;

// 时间线条目：时间/元信息标签、标题、描述、圆点携带的类
// （`success`、`error`、…——共享语义角色）、可选的自定义图标
// （`icon`，图标组件认识的语义名），以及可选的待办态
// （`pending`：空心圈 + 虚线尾）。
public class TimelineItem {
    public string time;
    public string title;
    public string description;
    public string cls;
    public string icon;
    public bool pending;

    // 不带语义类的条目：圆点用默认样式。
    TimelineItem(string time, string title, string description)
        : this(time, title, description, "", "") { }

    // 带语义类的条目（success / error / …，决定圆点配色）。
    TimelineItem(string time, string title, string description,
                 string cls)
        : this(time, title, description, cls, "") { }

    // 带自定义图标的条目：`icon` 非空时圆点改画该图标，
    // 颜色取圆点样式的前/背景（随语义角色走）。
    TimelineItem(string time, string title, string description,
                 string cls, string icon) {
        this.time = time;
        this.title = title;
        this.description = description;
        this.cls = cls;
        this.icon = icon;
    }
}
