using System;
using Gui;
namespace Gui.Widget;
public class TreeNode {
    public string label;
    public int depth;
    public bool isDir;
    public bool expanded;
    public string icon;
    public string path;
    public string payload;
    public bool checked;
    public Control extra;
    public TreeNode() {
        this.label = "";
        this.depth = 0;
        this.isDir = false;
        this.expanded = false;
        this.icon = "";
        this.path = "";
        this.payload = "";
        this.checked = false;
        this.extra = null;
    }
    public static TreeNode Dir(string label, int depth, bool expanded) {
        TreeNode n = new TreeNode();
        n.label = label;
        n.depth = depth;
        n.isDir = true;
        n.expanded = expanded;
        n.icon = "";
        n.path = "";
        n.payload = "";
        n.checked = false;
        n.extra = null;
        return n;
    }
    public static TreeNode File(string label, int depth) {
        TreeNode n = new TreeNode();
        n.label = label;
        n.depth = depth;
        n.isDir = false;
        n.expanded = false;
        n.icon = "";
        n.path = "";
        n.payload = "";
        n.checked = false;
        n.extra = null;
        return n;
    }
    public void Extra(Control ext) { this.extra = ext; }
    public static TreeNode FileIcon(string label, int depth, string icon) {
        TreeNode n = TreeNode.File(label, depth);
        n.icon = icon;
        return n;
    }
    public void WithPayload(string p) { this.payload = p; }
}
