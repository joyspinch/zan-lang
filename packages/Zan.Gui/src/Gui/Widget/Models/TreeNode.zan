using System;
using Gui;
using Gui.Backend;

namespace Gui.Widget;

// 树的一个节点，按先序排列。`depth` 是缩进级别（根 = 0）。
// 目录可展开/折叠；文件是叶节点。`icon` 非空时覆盖
// 默认文件夹/文件字形。`path` 可选地携带该节点表示的
// 真实文件系统路径（纯内存树为空）。
// `checked` 支撑可选的选择复选框列。
public class TreeNode {
    // 节点标题。
    public string label;
    // 缩进级别（根 = 0）。
    public int depth;
    // 是否目录（可展开/折叠；叶节点为 false）。
    public bool isDir;
    // 目录的展开状态。
    public bool expanded;
    // 自定义图标名（"" = 默认文件夹/文件字形）。
    public string icon;
    // 该节点表示的真实文件系统路径（纯内存树为空）。
    public string path;
    // 调用方可选的 payload（例如索引、id），
    // 节点本身不解释它。
    public string payload;
    // 复选框状态（WithChecks 列的数据来源）。
    public bool checked;
    // 节点右侧额外自定义插槽（徽标/状态灯/按钮组等活控件）
    public Control extra;

    // 构造目录节点（`expanded` 决定初始展开状态）。
    static TreeNode Dir(string label, int depth, bool expanded) {
        TreeNode n = new TreeNode();
        n.label = label;
        n.depth = depth;
        n.isDir = true;
        n.expanded = expanded;
        n.icon = "";
        n.path = "";
        n.payload = "";
        n.checked = false;
        n.extra = null;
        return n;
    }

    // 构造叶节点（默认图标）。
    static TreeNode File(string label, int depth) {
        TreeNode n = new TreeNode();
        n.label = label;
        n.depth = depth;
        n.isDir = false;
        n.expanded = false;
        n.icon = "";
        n.path = "";
        n.payload = "";
        n.checked = false;
        n.extra = null;
        return n;
    }

    // 设置右侧扩展插槽控件
    TreeNode Extra(Control ext) {
        this.extra = ext;
        return this;
    }

    // 构造叶节点并指定图标名（覆盖默认文件字形）。
    static TreeNode FileIcon(string label, int depth, string icon) {
        TreeNode n = TreeNode.File(label, depth);
        n.icon = icon;
        return n;
    }

    // 附带调用方自定义标识（索引、id 等），节点不解释它。
    TreeNode WithPayload(string p) {
        this.payload = p;
        return this;
    }
}
