using System;
using Gui;
namespace Gui.Widget;
public class RichMenuModels {
    public static List<MenuItem> Copy(List<MenuItem> source) {
        List<MenuItem> result = new List<MenuItem>();
        if (source == null) { return result; }
        for (int i = 0; i < source.Count; i = i + 1) {
            MenuItem item = source[i];
            MenuItem copy = new MenuItem();
            copy.kind = item.kind;
            copy.label = item.label;
            copy.icon = item.icon;
            copy.shortcut = item.shortcut;
            copy.key = item.key;
            copy.action = item.action;
            copy.disabled = item.disabled;
            copy.danger = item.danger;
            copy.swatch = item.swatch;
            copy.swatch2 = item.swatch2;
            copy.children = item.children != null ? RichMenuModels.Copy(item.children) : null;
            result.Add(copy);
        }
        return result;
    }
    public static bool Equal(List<MenuItem> a, List<MenuItem> b) {
        int ac = a != null ? a.Count : 0;
        int bc = b != null ? b.Count : 0;
        if (ac != bc) { return false; }
        for (int i = 0; i < ac; i = i + 1) {
            MenuItem x = a[i];
            MenuItem y = b[i];
            if (x.kind != y.kind || x.label != y.label || x.icon != y.icon
                || x.shortcut != y.shortcut || x.key != y.key || x.action != y.action
                || x.disabled != y.disabled || x.danger != y.danger
                || x.swatch != y.swatch || x.swatch2 != y.swatch2
                || !RichMenuModels.Equal(x.children, y.children)) { return false; }
        }
        return true;
    }
}
