using System;
using Gui;

namespace Gui.Widget;

// 在按钮下方挂面板的控件们共用的触发器按钮外观
// （Dropdown、Popover、属性编辑器）。
public class DropdownChrome {
    internal static Rect ContentBounds(Control trigger, StyleBox style, int padding) {
        int left = style.PadLOr(padding) + style.BorderLeftPx();
        int right = style.PadROr(padding) + style.BorderRightPx();
        int top = style.PadTOr(0) + style.BorderTopPx();
        int bottom = style.PadBOr(0) + style.BorderBottomPx();
        int width = trigger.bw - left - right;
        int height = trigger.bh - top - bottom;
        return new Rect(trigger.bx + left, trigger.by + top,
                        width > 0 ? width : 0, height > 0 ? height : 0);
    }

    internal static int SlotSize(Rect content, int size) {
        if (size > content.height) { size = content.height; }
        if (size > content.width) { size = content.width; }
        return size;
    }

    internal static void PaintLabel(Canvas canvas, Rect content, int width,
                                    string label, int font, int color) {
        if (width <= 0 || content.height <= 0) { return; }
        canvas.DrawText(content.x, Canvas.CenterTextY(content.y, content.height, font),
                        Ellipsis.Fit(label, width, font), color, font);
    }

    internal static void PaintArrow(Canvas canvas, Rect content, int size, int color) {
        if (size <= 0) { return; }
        canvas.DrawGlyphIn("chevron-down", content.Right() - size, content.y,
                           size, content.height, size, color);
    }

    // 只绘制已挂载触发器的外观；身份和命中来自控件树。
    public static void Paint(App app, Control trigger, string label, bool open) {
        int id = trigger.WidgetId();
        int x = trigger.bx; int y = trigger.by; int w = trigger.bw; int h = trigger.bh;
        Canvas c = app.canvas;
        Theme t = app.theme;
        int hv = app.StyleHoverLevelIn(id, 0, x, y, w, h);
        if (open) { hv = 1000; }
        StyleBox normal = Style.Of(app, "select", "", Style.SNormal());
        StyleBox hover = Style.Of(app, "select", "", Style.SHover());
        StyleBox s = StyleBox.Blend(normal, hover, hv);

        s.Paint(app, x, y, w, h);
        Rect content = DropdownChrome.ContentBounds(trigger, normal, t.paddingMedium);
        int fs = normal.FontOr(Style.FontFallback(app, "medium"));
        StyleBox arrow = Style.Part(app, "select", "arrow", "", "", "", Style.SNormal());
        int size = DropdownChrome.SlotSize(content, arrow.FontOr(t.iconSizeSmall));
        DropdownChrome.PaintLabel(c, content, content.width - size - t.gapSmall, label, fs, s.fg);
        DropdownChrome.PaintArrow(c, content, size, arrow.FgOr(s.fg));
    }
}
