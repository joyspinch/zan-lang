using System;
using Gui;

namespace Gui.Widget;

// 强类型栅格单元槽位实体：把子项的行、起始列、跨列记录在单一结构体中，消除 rowOf/colOf/spanOf 平行列表。
public class GridSlotPlacement {
    public int row;
    public int col;
    public int span;

    public GridSlotPlacement(int row, int col, int span) {
        this.row = row;
        this.col = col;
        this.span = span;
    }
}
