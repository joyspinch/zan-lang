    public string title;
    public int width;
    public SelectBoxColumn(string title, int width) {
        this.title = title;
        this.width = width;
    }
}

public class SelectOption {
    public string label;
    public string val;
    public bool chosen;
    public List<string> cells;
    public List<SelectOption> children;
    public int flatIdx;
    public int parentIdx;
    public bool grp;
    public bool disabled;
    public SelectOption(string label, bool chosen) {
        this.label = label;
        this.val = label;
        this.chosen = chosen;
        this.cells = null;
        this.children = null;
        this.flatIdx = 0 - 1;
        this.parentIdx = 0 - 1;
        this.grp = false;
        this.disabled = false;
    }
    public SelectOption(string label, string val, bool chosen) {
        this.label = label;
        this.val = (val != null && val != "") ? val : label;
        this.chosen = chosen;
        this.cells = null;
        this.children = null;
        this.flatIdx = 0 - 1;
        this.parentIdx = 0 - 1;
        this.grp = false;
        this.disabled = false;
    }
    public void Attach(SelectOption child, int idx) {
        if (children == null) { children = new List<SelectOption>(); }
        child.flatIdx = idx;
        children.Add(child);
    }
    public bool HasChildren() { return children != null && children.Count > 0; }
    public string Cell(int i) {
        if (i <= 0) { return label; }
        if (cells == null) { return ""; }
        int j = i - 1;
        if (j >= cells.Count) { return ""; }
        return cells[j];
    }
}

public class MenuExpandState {
    public List<string> keys;
    public bool initialized;
    public MenuExpandState() {
        this.keys = new List<string>();
        this.initialized = false;
    }
    public bool Contains(string key) { return this.keys.IndexOf(key) >= 0; }
    public void Expand(string key) {
        if (!this.Contains(key)) { this.keys.Add(key); }
    }
    public void Collapse(string key) {
        int i = this.keys.IndexOf(key);
        if (i >= 0) { this.keys.RemoveAt(i); }
    }
    public void Toggle(string key) {
        if (this.Contains(key)) { this.Collapse(key); }
        else { this.Expand(key); }
    }
}

public class MenuRow {
    public MenuItem item;
    public int depth;
    public MenuRow(MenuItem it, int d) {
        this.item = it;
        this.depth = d;
    }
}

public class RichMenuModels {
    public static List<MenuItem> Copy(List<MenuItem> source) {
        List<MenuItem> result = new List<MenuItem>();
        if (source == null) { return result; }
        for (int i = 0; i < source.Count; i = i + 1) {
            MenuItem item = source[i];
            MenuItem copy = new MenuItem();
            copy.kind = item.kind;
            copy.label = item.label;
            copy.icon = item.icon;
            copy.shortcut = item.shortcut;
            copy.key = item.key;
            copy.action = item.action;
            copy.disabled = item.disabled;
            copy.danger = item.danger;
            copy.swatch = item.swatch;
            copy.swatch2 = item.swatch2;
            copy.children = item.children != null ? RichMenuModels.Copy(item.children) : null;
            result.Add(copy);
        }
        return result;
    }
    public static bool Equal(List<MenuItem> a, List<MenuItem> b) {
        int ac = a != null ? a.Count : 0;
        int bc = b != null ? b.Count : 0;
        if (ac != bc) { return false; }
        for (int i = 0; i < ac; i = i + 1) {
            MenuItem x = a[i];
            MenuItem y = b[i];
            if (x.kind != y.kind || x.label != y.label || x.icon != y.icon
                || x.shortcut != y.shortcut || x.key != y.key || x.action != y.action
                || x.disabled != y.disabled || x.danger != y.danger
                || x.swatch != y.swatch || x.swatch2 != y.swatch2
                || !RichMenuModels.Equal(x.children, y.children)) { return false; }
        }
        return true;
    }
}

public class RichMenuSession : AppLoopParticipant, AppPreparationParticipant {
    public weak RichMenu owner;
    public int session;
    public void Tick(App app, int now) {
        RichMenu menu = owner;
        if (menu != null) { menu.Tick(app, now, session); }
    }
    public int NextDeadline() {
        RichMenu menu = owner;
        return menu != null ? menu.NextDeadline(session) : -1;
    }
    public void BeforeInput(App app, int kind) { this.Prepare(app); }
    public void BeforePaint(App app, int frameSequence) { this.Prepare(app); }
    void Prepare(App app) {
        RichMenu menu = owner;
        if (menu != null && menu.IsOpen() && menu.Session() == session && menu.FindApp() == app) {
            menu.Prepare(app);
        }
    }
}

public class CascadeColumnScroll {
    public int offset;
    public SignalInt signal;
    public CascadeColumnScroll() {
        this.offset = 0;
        this.signal = new SignalInt(0);
    }
    public CascadeColumnScroll(int offset, SignalInt signal) {
        this.offset = offset;
        this.signal = signal != null ? signal : new SignalInt(offset);
    }
}

public class CascadePanelColumn : Control {
    private weak SelectBox box;
    private int column;
    public List<int> rows;
    public bool filtering;
    private int rowH;
    public CascadePanelColumn(SelectBox owner, int index) {
        this.InitControl("cascade-column");
        box = owner;
        column = index;
        rows = new List<int>();
    }
    public override StyleBox ResolveStyle(App app, int state) {
        StyleBox style = base.ResolveStyle(app, state);
        if (style.overflowCss == -1) { style.overflowY = 2; style.overflow = 1; }
        return style;
    }
    public override void Arrange(int x, int y, int w, int h) {
        bx = x; by = y; bw = Math.Max(0, w); bh = Math.Max(0, h);
        App app = this.FindApp();
        SelectBox s = box;
        if (app == null || s == null) { return; }
        rowH = s.lastH > 0 ? s.lastH : app.theme.heightMedium;
        scrollExtent = rows.Count * rowH;
        scrollExtentX = bw;
        this.SetScrollTop(s.ColScroll(column, scrollExtent, bh));
    }
    public override void OnScrollChanged() {
        SelectBox s = box;
        if (s != null) { s.SetColScroll(column, this.ScrollTop()); }
    }
    private int OptionAt(int x, int y) {
        if (!new Rect(bx, by, bw, bh).Contains(x, y) || rowH <= 0) { return -1; }
        int index = (y - by + this.ScrollTop()) / rowH;
        if (index < 0 || index >= rows.Count) { return -1; }
        return rows[index];
    }
    private void Expand(SelectBox s, int index) {
        List<int> next = new List<int>();
        for (int i = 0; i < column && i < s.cascadePath.Count; i = i + 1) { next.Add(s.cascadePath[i]); }
        next.Add(index);
        if (!s.SameCascadePath(next)) { s.cascadePath = next; }
    }
    public override void OnPointerMove(RoutedEventArgs e) {
        SelectBox s = box;
        App app = this.FindApp();
        if (e.handled || s == null || app == null || this.IsDisabled()) { return; }
        int index = this.OptionAt(e.x, e.y);
        if (index >= 0 && index < s.opts.Count && !s.opts[index].disabled && !s.opts[index].grp
            && s.hoverExpand && !filtering && s.opts[index].HasChildren()) { this.Expand(s, index); }
        this.UpdateHover(s, app, index);
    }
    public override void OnPointerLeave(RoutedEventArgs e) {
        base.OnPointerLeave(e);
        SelectBox s = box;
        App app = this.FindApp();
        if (s != null && app != null && rows.Contains(s.hoverRow)) { this.UpdateHover(s, app, -1); }
    }
    public override void OnPointerCancel(RoutedEventArgs e) {
        base.OnPointerCancel(e);
        SelectBox s = box;
        App app = this.FindApp();
        if (s != null && app != null && rows.Contains(s.hoverRow)) { this.UpdateHover(s, app, -1); }
    }
    private void UpdateHover(SelectBox s, App app, int index) {
        if (s.hoverRow == index) { return; }
        s.hoverRow = index;
        s.Hover.Raise(s);
        app.RequestRedraw();
    }
    public override void OnClick(RoutedEventArgs e) {
        SelectBox s = box;
        App app = this.FindApp();
        if (e.handled || s == null || app == null || this.IsDisabled()) { return; }
        int index = this.OptionAt(e.x, e.y);
        if (index < 0 || index >= s.opts.Count) { return; }
        SelectOption option = s.opts[index];
        if (option.disabled || option.grp) { return; }
        e.Handle();
        int checkRight = bx + app.theme.paddingSmall + app.Scale(24);
        if (filtering) {
            if (s.multi) { s.SetChecked(index, !option.chosen); }
            else { s.ChooseCascade(index); }
            if (s.clearFilterAfter) { s.SetFilterText(""); }
        } else if (s.multi && (e.x < checkRight || !option.HasChildren() || !s.cascadeLink)) {
            s.SetChecked(index, !option.chosen);
        } else if (!s.multi && (!option.HasChildren() || !s.cascadeLink)) { s.ChooseCascade(index); }
        else { this.Expand(s, index); }
        app.RequestRedraw();
    }
    public override void OnPaint(App app) {
        SelectBox s = box;
        if (s == null || rowH <= 0) { return; }
        Canvas c = app.canvas;
        int first = this.ScrollTop() / rowH;
        int pad = app.Scale(10);
        int fs = Style.FontFallback(app, "medium");
        StyleBox popupBox = s.ResolvePartAs(app, "select", "popup", "popup", s.Class, Style.SNormal());
        int outerR = popupBox != null ? popupBox.RadiusOr(0) : 0;
        int inset = app.Scale(6);
        int innerR = 0;
        if (outerR > 0) {
            innerR = outerR - inset;
            if (innerR < app.Scale(4)) { innerR = app.Scale(4); }
            if (innerR > outerR) { innerR = outerR; }
        }
        int hlInsetX = app.Scale(2);
        int hlInsetY = app.Scale(1);
        StyleBox arrow = s.ResolvePartAs(app, "select", "arrow", "", s.Class, Style.SSelected());
        int arrowSlot = arrow.WidthOr(app.theme.paddingLarge + app.theme.iconSizeSmall);
        c.PushClip(bx, by, bw, bh);
        for (int r = first; r < rows.Count; r = r + 1) {
            int ry = by + r * rowH - this.ScrollTop();
            if (ry >= by + bh) { break; }
            int index = rows[r];
            SelectOption option = s.opts[index];
            int state = option.disabled ? Style.SDisabled() : Style.SNormal();
            if (!option.disabled && !option.grp && s.hoverRow == index) { state = state + Style.SHover(); }
            if (!s.multi && index == s.Value.Get()) { state = state + Style.SSelected(); }
            StyleBox row = s.ResolvePartAs(app, "select", "option", "option", s.Class, state);
            int rowBg = row.BgOr(0);
            if (rowBg != 0 && bw > hlInsetX * 2 && rowH > hlInsetY * 2) {
                c.FillRoundRect(bx + hlInsetX, ry + hlInsetY, bw - hlInsetX * 2, rowH - hlInsetY * 2, innerR, rowBg);
            }
            int textX = bx + pad;
            if (s.multi) {
                int size = CascadePanel.DrawCascadeCheck(s, app, c, app.theme, s.Class, bx, ry, rowH,
                    option.chosen, s.IsPartial(index));
                textX = bx + pad + size + app.Scale(8);
            }
            bool children = option.HasChildren() && !filtering;
            int available = bx + bw - pad - app.Scale(8) - textX - (children ? arrowSlot : 0);
            string label = filtering ? s.PathOf(index) : option.label;
            int font = row.FontOr(fs);
            c.DrawText(textX, Canvas.CenterTextY(ry, rowH, font), Ellipsis.Fit(label, available, font), row.fg, font);
            if (children) { c.DrawGlyphIn("chevron-right", bx + bw - arrowSlot, ry,
                arrowSlot, rowH, arrowSlot - pad, row.fg); }
        }
        if (filtering && rows.Count == 0) {
            StyleBox hint = s.ResolvePartAs(app, "select", "group", "", s.Class, Style.SNormal());
            c.DrawText(bx + pad, Canvas.CenterTextY(by, rowH, fs), Ellipsis.Fit("No matches", bw - pad * 2, fs),
                hint.fg, hint.FontOr(fs));
        }
        c.PopClip();
    }
}

public class TransferPane {
    public List<bool> flags;
    public Binding<int> scroll;
    public List<int> order;
    public Input search;
    public string query;
    public int paintStart;
    public int paintEnd;
    public bool paintVal;
    public int bodyX;
    public int bodyY;
    public int bodyW;
    public int bodyH;
    public int rowHPx;
    public int orderFor;
    public string orderQuery;
    public TransferPane() {
        flags = new List<bool>();
        scroll = 0;
        order = new List<int>();
        search = null;
        query = "";
        paintStart = 0 - 1;
        paintEnd = 0 - 1;
        paintVal = false;
        bodyX = 0;
        bodyY = 0;
        bodyW = 0;
        bodyH = 0;
        rowHPx = 0;
        orderFor = 0 - 1;
        orderQuery = "";
    }
}

public class TransferRegionAction<T> {
    public weak TransferRegion<T> region;
    public TransferRegionAction(TransferRegion<T> value) { region = value; }
    public void SearchChanged(Control sender) {
        TransferRegion<T> value = region;
        if (value != null) { value.SearchChanged(sender); }
    }
    public void Operation(Control sender) {
        TransferRegion<T> value = region;
        if (value != null) { value.Operation(sender); }
    }
}
public class TransferRegion<T> : Control {
    public weak Transfer<T> owner;
    public TransferPane pane;
    public bool isSource;
    private bool arrangingRegion;
    public TransferRegion(Transfer<T> transfer, TransferPane state, bool sourceSide) {
        this.InitControl("transfer-region");
        owner = transfer;
        pane = state;
        isSource = sourceSide;
        arrangingRegion = false;
    }
    public override StyleBox ResolveStyle(App app, int state) {
        StyleBox box = base.ResolveStyle(app, state);
        if (box.overflowCss == 0 - 1) { box.overflowY = 2; box.overflow = 1; }
        return box;
    }
    public void LayoutRows(int x, int y, int w, int h, int contentH) {
        arrangingRegion = true;
        bx = x; by = y; bw = w > 0 ? w : 0; bh = h > 0 ? h : 0;
        scrollExtentX = bw;
        scrollExtent = contentH > bh ? contentH : bh;
        int offset = pane.scroll.Get();
        int maximum = scrollExtent - bh;
        if (offset < 0) { offset = 0; }
        if (offset > maximum) { offset = maximum; }
        this.CommitScrollOffset(0, offset);
        pane.scroll.Set(scrollY);
        if (scroll != null && scroll.Active() && maximum <= 0) {
            RoutedEventArgs cancel = new RoutedEventArgs("PointerCancel", this, x, y);
            this.ScrollPointerCancel(cancel);
        }
        arrangingRegion = false;
    }
    public void SearchChanged(Control sender) {
        Transfer<T> transfer = owner;
        if (transfer != null) { transfer.SearchRegionChanged(this); }
    }
    public void Operation(Control sender) {
        Transfer<T> transfer = owner;
        if (transfer == null || transfer.IsDisabled()) { return; }
        if (isSource) { transfer.MoveRight(); }
        else if (!transfer.oneWay) { transfer.MoveLeft(); }
        transfer.Arrange(transfer.bx, transfer.by, transfer.bw, transfer.bh);
    }
    public override void OnScrollChanged() {
        pane.scroll.Set(scrollY); // Compatibility projection, never a second accumulator.
        Transfer<T> transfer = owner;
        if (!arrangingRegion && transfer != null) { transfer.SyncRegion(this); }
    }
    public override void OnPointerDown(RoutedEventArgs e) {
        base.OnPointerDown(e);
        Transfer<T> transfer = owner;
        App app = this.App;
        if (transfer == null || app == null || e.originalSource != this
            || app.window.EventButton() != 0 || transfer.IsDisabled()) { return; }
        if (transfer.BeginRegionSelection(this, e.x, e.y)) {
            app.CapturePointer(this, true);
            e.Handle();
        }
    }
    public override void OnPointerMove(RoutedEventArgs e) {
        Transfer<T> transfer = owner;
        App app = this.App;
        if (transfer != null && app != null && app.GetCapturedPointer() == this
            && pane.paintStart >= 0) {
            transfer.MoveRegionSelection(this, e.x, e.y);
            e.Handle();
        }
    }
    public override void OnPointerUp(RoutedEventArgs e) {
        Transfer<T> transfer = owner;
        App app = this.App;
        if (transfer == null || app == null || app.window.EventButton() != 0
            || app.GetCapturedPointer() != this || pane.paintStart < 0) { return; }
        transfer.MoveRegionSelection(this, e.x, e.y);
        app.ReleasePointerCapture();
        base.OnPointerUp(e);
        e.Handle();
        transfer.EndRegionSelection(this);
    }
    public void CancelSelection() {
        if (pane.paintStart < 0) { return; }
        pane.paintStart = 0 - 1;
        pane.paintEnd = 0 - 1;
        App app = this.App;
        RoutedEventArgs cancel = new RoutedEventArgs("PointerCancel", this, bx, by);
        base.OnPointerCancel(cancel);
        if (app != null && app.GetCapturedPointer() == this) { app.ReleaseInputSubtree(this); }
    }
    public override void OnPointerCancel(RoutedEventArgs e) {
        if (pane.paintStart >= 0) { this.CancelSelection(); e.Handle(); }
        base.OnPointerCancel(e);
    }
}
