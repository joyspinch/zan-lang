public class StyledTextHeader : Control {
    private Avatar avatar;
    private Tag speaker;
    private Tag status;
    private Tag progress;
    public StyledTextHeader() {
        this.InitControl("styledTextHeader");
        styleSurfaceOwned = true;
        avatar = new Avatar("", 16);
        speaker = new Tag(); status = new Tag(); progress = new Tag();
        this.Add(avatar); this.Add(speaker); this.Add(status); this.Add(progress);
    }
    public void Prepare(App app, TextRun line) {
        string initial = line.ava; string text = line.text;
        string role = line.tagCls; string state = line.status;
        string percent = line.pct >= 0 ? Convert.ToString(line.pct) + "%" : "";
        if (avatar.Label() != initial) { avatar.SetText(initial); }
        avatar.Class = role;
        if (speaker.Label() != text) { speaker.SetText(text); }
        speaker.Class = role;
        if (status.Label() != state) { status.SetText(state); }
        if (progress.Label() != percent) { progress.SetText(percent); }
        progress.Class = "primary";
        speaker.SetShown(true); status.SetShown(state != ""); progress.SetShown(percent != "");
        this.MeasureTree(app);
    }
    public override void OnMeasure(App app) { prefW = 0; prefH = StyledText.RowH(app); }
    private int Place(Tag part, int x, int y, int right) {
        bool shown = part.Label() != "" && x + part.prefW <= right;
        part.SetShown(shown);
        if (!shown) { part.Arrange(x, y, 0, 0); return x; }
        int height = part.prefH > 0 ? part.prefH : this.App.theme.heightTiny;
        part.Arrange(x, by + Math.Max(0, (bh - height) / 2), part.prefW, height);
        return x + part.prefW + this.App.Scale(4);
    }
    public override void Arrange(int x, int y, int w, int h) {
        bx = x; by = y; bw = Math.Max(0, w); bh = Math.Max(0, h);
        App app = this.App;
        if (app == null) { return; }
        int diameter = avatar.Diameter(app);
        avatar.Arrange(x, y + Math.Max(0, (h - diameter) / 2), diameter, diameter);
        int cursor = x + diameter + app.Scale(5);
        int chipY = y + Math.Max(0, (h - app.theme.heightTiny) / 2);
        cursor = this.Place(speaker, cursor, chipY, x + bw);
        cursor = this.Place(status, cursor, chipY, x + bw);
        this.Place(progress, cursor, chipY, x + bw);
    }

}

public class StyledTextPaintRow {
    public int y;
    public int height;
    public int blockX;
    public int blockWidth;
    public int railWidth;
    public int railColor;
    public int tintColor;
    public bool spacer;
    public bool code;
    public int codeX;
    public int codeWidth;
    public int codeColor;
    public int selectionX;
    public int selectionWidth;
    public int selectionColor;
    public int separatorHeight;
    public int separatorColor;
    public string text;
    public int textX;
    public int textY;
    public int font;
    public int color;
    public string glyph;
    public int glyphX;
    public int glyphY;
    public int glyphSize;
    public string time;
    public int timeX;
    public int timeY;
    public int timeFont;
    public int timeColor;
    public void Paint(Canvas canvas) {
        if (spacer) { return; }
        canvas.FillRect(blockX, y, blockWidth, height, tintColor);
        canvas.FillRect(blockX, y, railWidth, height, railColor);
        if (code) { canvas.FillRect(codeX, y, codeWidth, height, codeColor); }
        if (selectionWidth > 0) { canvas.FillRect(selectionX, y, selectionWidth, height, selectionColor); }
        if (separatorHeight > 0) {
            canvas.FillRect(blockX, y + height - separatorHeight, blockWidth, separatorHeight, separatorColor);
        }
        if (glyph != "") { canvas.DrawGlyphIn(glyph, glyphX, glyphY, glyphSize, glyphSize, glyphSize, color); }
        if (text != "") {
            int maxRight = (time != "" && timeX > textX) ? (timeX - 4) : (blockX + blockWidth);
            int avail = maxRight - textX;
            if (avail > 0) {
                canvas.PushClip(textX, y, avail, height);
                try { canvas.DrawText(textX, textY, Ellipsis.Fit(text, avail, font), color, font); }
                finally { canvas.PopClip(); }
            }
        }
        if (time != "") { canvas.DrawText(timeX, timeY, time, timeColor, timeFont); }
    }
}

public class StyledTextViewport : Control {
    public StyledTextViewport() {
        this.InitControl("styledTextViewport");
        styleSurfaceOwned = true;
    }
    public override void OnMeasure(App app) { prefW = bw; prefH = bh; }
    public override void Arrange(int x, int y, int w, int h) {
        bx = x; by = y; bw = Math.Max(0, w); bh = Math.Max(0, h);
    }
    public override bool ChildInViewport(Control child) {
        return child != null && child.bw > 0 && child.bh > 0
        && child.bx < bx + bw && child.bx + child.bw > bx
        && child.by < by + bh && child.by + child.bh > by;
    }
}

