using Gui;
using System;

namespace Gui.Widget;

public class ListColumn<T> {
    public string title;
    public int weight;
    public bool right;
    public CellOf<T> cell;
    public CellSlotOf<T> slot;
    public ListColumn(string title, CellOf<T> cell) {
        this.title = title;
        this.weight = 0;
        this.right = false;
        this.cell = cell;
        this.slot = null;
    }
    public ListColumn(string title, int weight, CellOf<T> cell) {
        this.title = title;
        this.weight = weight;
        this.right = false;
        this.cell = cell;
        this.slot = null;
    }
    public static ListColumn<T> Slot(string title, CellSlotOf<T> slot) {
        ListColumn<T> c = new ListColumn<T>(title, null);
        c.slot = slot;
        return c;
    }
    public static ListColumn<T> SlotWithWeight(string title, int weight, CellSlotOf<T> slot) {
        ListColumn<T> c = new ListColumn<T>(title, weight, null);
        c.slot = slot;
        return c;
    }
    public void Right() { right = true; }
    public string TextOf(T item) {
        if (cell == null) { return ""; }
        return cell(item);
    }
}

public class TreeNode {
    public string label;
    public int depth;
    public bool isDir;
    public bool expanded;
    public string icon;
    public string path;
    public string payload;
    public bool checked;
    public Control extra;
    public TreeNode() {
        this.label = "";
        this.depth = 0;
        this.isDir = false;
        this.expanded = false;
        this.icon = "";
        this.path = "";
        this.payload = "";
        this.checked = false;
        this.extra = null;
    }
    public static TreeNode Dir(string label, int depth, bool expanded) {
        TreeNode n = new TreeNode();
        n.label = label;
        n.depth = depth;
        n.isDir = true;
        n.expanded = expanded;
        n.icon = "";
        n.path = "";
        n.payload = "";
        n.checked = false;
        n.extra = null;
        return n;
    }
    public static TreeNode File(string label, int depth) {
        TreeNode n = new TreeNode();
        n.label = label;
        n.depth = depth;
        n.isDir = false;
        n.expanded = false;
        n.icon = "";
        n.path = "";
        n.payload = "";
        n.checked = false;
        n.extra = null;
        return n;
    }
    public void Extra(Control ext) { this.extra = ext; }
    public static TreeNode FileIcon(string label, int depth, string icon) {
        TreeNode n = TreeNode.File(label, depth);
        n.icon = icon;
        return n;
    }
    public void WithPayload(string p) { this.payload = p; }
}

internal class VirtualListStringRow : Button {
    // 按父类种类上报：序列化与自动化以 "Button" 识别本控件。
    public override string Kind() { return "Button"; }
    private weak VirtualList owner;
    private int index;
    internal VirtualListStringRow(VirtualList list, int rowIndex, string text) : base(text) {
        owner = list;
        index = rowIndex;
        ClassName = "virtual-list-row";
    }
    public override void OnClick(RoutedEventArgs e) {
        if (this.IsDisabled()) { return; }
        base.OnClick(e);
        VirtualList list = owner;
        if (list != null && this.Parent() == list) { list.SelectStringRow(this, index); }
    }
}

