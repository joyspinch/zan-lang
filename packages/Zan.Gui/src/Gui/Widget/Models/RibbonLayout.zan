using System;
using Gui;

namespace Gui.Widget;

// 一组命令在条带里的占位（组标题画在它上方）。
public class RibbonGroupBox {
    // 组号（对应宿主给的组下标）。
    public int group;
    // 组内容的起止 x（相对条带左沿）。
    public int startX;
    public int endX;

    RibbonGroupBox() {
        this.group = 0;
        this.startX = 0;
        this.endX = 0;
    }
}

// 条带的一次排布结果：命令落位 + 各组占位 + 整条带需要的宽度。
// 宽度是"排满"时占的宽度（含左右留白与组间分隔线）。
public class RibbonLayout {
    // 每个命令的落位（按组序、组内序）。
    public List<RibbonSlot> slots;
    // 有内容的组（整组被丢空的组不占位，也不画标题）。
    public List<RibbonGroupBox> boxes;
    // 排满时的总宽。
    public int width;

    RibbonLayout() {
        this.slots = new List<RibbonSlot>();
        this.boxes = new List<RibbonGroupBox>();
        this.width = 0;
    }
}
