using System;
using Gui;

namespace Gui.Widget;

// 展开态：以 key 集合记录当前展开的组。宿主持有，跨帧存活；RenderTree
// 首次调用时按 defaultExpandedKeys / 选中项父级初始化一次。
public class MenuExpandState {
    public List<string> keys;
    public bool initialized;

    // 空展开态：尚未初始化（首次渲染按默认策略展开）。
    MenuExpandState() {
        this.keys = new List<string>();
        this.initialized = false;
    }

    // key 当前是否处于展开态。
    bool Contains(string key) {
        return this.keys.IndexOf(key) >= 0;
    }

    // 展开 key（已展开为空操作）。
    void Expand(string key) {
        if (!this.Contains(key)) { this.keys.Add(key); }
    }

    // 收起 key（不存在为空操作）。
    void Collapse(string key) {
        int i = this.keys.IndexOf(key);
        if (i >= 0) { this.keys.RemoveAt(i); }
    }

    // 切换 key 的展开态。
    void Toggle(string key) {
        if (this.Contains(key)) { this.Collapse(key); }
        else { this.Expand(key); }
    }
}
