using System;
using Gui;

namespace Gui.Widget;

// Wizard 列表中一个可选择的条目：图标、标签和一行
// 描述（当前选中时显示）。取代旧的
// name/icon/description 并行列表约定，改为单一实体。
public class WizardItem {
    public string name;
    public string icon;
    public string desc;

    // 构建条目：名字、图标、描述。
    WizardItem(string n, string ic, string d) {
        name = n;
        icon = ic;
        desc = d;
    }
}
