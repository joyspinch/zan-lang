using Gui;
namespace Gui.Widget;
internal class TabHeaderButton : Button {
    // 按父类种类上报：序列化与自动化以 "Button" 识别本控件。
    public override string Kind() { return "Button"; }
    public override string StyleType() { return "tab"; }
    public override StyleBox ResolveStyle(App app, int state) {
        if (Style.Has(Class, "active")) { state = state | Style.SSelected(); }
        return base.ResolveStyle(app, state);
    }
}
