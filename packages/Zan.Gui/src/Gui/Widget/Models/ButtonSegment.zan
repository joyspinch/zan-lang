using System;
using Gui;

namespace Gui.Widget;

// 一个焊接段：其标签和稳定控件 id（用于焦点/命中）。
// 用一个实体代替并行的标签/id 列表。
public class ButtonSegment {
    // 段标签。
    public string label;
    // 稳定控件 id（命中/焦点）。
    public int id;

    // 构造一段。
    ButtonSegment(string label, int id) {
        this.label = label;
        this.id = id;
    }

    // 段标签（宿主按值对账时读取）。
    string Label() { return label; }
}
