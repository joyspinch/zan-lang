using Gui;
using System;

namespace Gui.Widget;

public class CalendarAction {
    public weak Calendar owner;
    public CalendarAction(Calendar calendar) { owner = calendar; }
    public void Previous() { Calendar calendar = owner; if (calendar != null && !calendar.IsDisabled()) { calendar.MoveMonth(-1); } }
    public void Next() { Calendar calendar = owner; if (calendar != null && !calendar.IsDisabled()) { calendar.MoveMonth(1); } }
    public void Today() { Calendar calendar = owner; if (calendar != null && !calendar.IsDisabled()) { calendar.JumpToToday(); } }
    public void PickToday() { Calendar calendar = owner; if (calendar != null && !calendar.IsDisabled()) { calendar.PickDate(Calendar.TodayRef()); } }
    public void Clear() { Calendar calendar = owner; if (calendar != null && !calendar.IsDisabled()) { calendar.ClearDate(); } }
}

public class CollapseAction {
    public weak Collapse owner;
    public weak CollapseItem item;
    public CollapseAction(Collapse collapse, CollapseItem child) {
        owner = collapse;
        item = child;
    }
    public void Toggle() {
        Collapse collapse = owner;
        CollapseItem child = item;
        if (collapse == null || child == null) { return; }
        collapse.OnItemToggled(child);
    }
}

class ContextMenuAction {
    public weak ContextMenu owner;
    public int generation;
    public int index;
    public void Run() {
        ContextMenu menu = owner;
        if (menu != null) { menu.SelectItem(index, generation); }
    }
}

public class DialogAction {
    public weak Modal modal;
    public weak Drawer drawer;
    public void CloseModal() { Modal owner = modal; if (owner != null) { owner.Hide(); } }
    public void CancelModal() { Modal owner = modal; if (owner != null) { owner.Cancel.Raise(owner); owner.Hide(); } }
    public void AcceptModal() { Modal owner = modal; if (owner != null) { owner.Ok.Raise(owner); } }
    public void CloseDrawer() { Drawer owner = drawer; if (owner != null) { owner.Hide(); } }
}

public class DynamicTagsAction {
    public weak DynamicTags owner;
    private int index;
    private weak Tag source;
    private int generation;
    public DynamicTagsAction(DynamicTags tags, int itemIndex) {
        owner = tags; index = itemIndex;
        if (tags == null) { return; }
        generation = tags.RebuildGeneration();
        if (itemIndex >= 0 && itemIndex < tags.Count() && itemIndex < tags.ChildCount()
        && tags.ChildAt(itemIndex) is Tag) {
            source = (Tag)tags.ChildAt(itemIndex);
        }
    }
    public DynamicTagsAction(DynamicTags tags, int itemIndex, Tag item) {
        owner = tags; index = itemIndex; source = item;
        if (tags != null) { generation = tags.RebuildGeneration(); }
    }
    public bool Current() {
        DynamicTags tags = owner;
        return tags != null && tags.RebuildGeneration() == generation;
    }
    public void Submit() {
        DynamicTags tags = owner;
        if (tags != null && !tags.IsDisabled() && this.Current()) { tags.FinishEdit(true); }
    }
    public void Close() {
        DynamicTags tags = owner;
        Tag item = source;
        if (tags == null || tags.IsDisabled() || !this.Current() || item == null || index < 0 || index >= tags.Count()) { return; }
        if (index < tags.ChildCount() && tags.ChildAt(index) == item) { tags.RemoveAt(index); }
    }
    public void StartEdit() {
        DynamicTags tags = owner;
        if (tags != null && !tags.IsDisabled() && this.Current()) { tags.StartEdit(); }
    }
}

public class InputNumberAction {
    public weak InputNumber owner;
    public InputNumberAction(InputNumber number) { owner = number; }
    public void StepDown() {
        InputNumber number = owner;
        if (number == null) { return; }
        number.StepDown();
    }
    public void StepUp() {
        InputNumber number = owner;
        if (number == null) { return; }
        number.StepUp();
    }
    public void InputChange() {
        InputNumber number = owner;
        if (number == null) { return; }
        number.OnInputChange();
    }
    public void InputSubmit() {
        InputNumber number = owner;
        if (number == null) { return; }
        number.OnInputSubmit();
    }
}

internal class MenuItemAction {
    private weak Menu owner;
    private MenuItem item;
    private string key;
    private bool group;
    private int generation;
    public MenuItemAction(Menu menu, MenuItem model, string itemKey, bool toggle) {
        owner = menu;
        item = model;
        key = itemKey;
        group = toggle;
        generation = menu.treeGeneration;
    }
    public void Invoke() {
        Menu menu = owner;
        if (menu == null || menu.IsDisabled() || menu.treeGeneration != generation || item == null || item.disabled) { return; }
        if (group) {
            if (menu.expandState != null) { menu.expandState.Toggle(key); }
            menu.BuildTree();
        } else {
            menu.SelectKey(key);
        }
    }
}

public class PageHeaderAction {
    public weak PageHeader owner;
    public PageHeaderAction(PageHeader header) { owner = header; }
    public void Back() { PageHeader header = owner; if (header != null && !header.IsDisabled() && header.Back != null) { header.Back.Raise(header); } }
}

public class PaginationAction {
    public weak Pagination owner;
    public weak Input input;
    private int target;
    private int delta;
    public PaginationAction(Pagination pagination, int page, int offset) {
        owner = pagination;
        target = page;
        delta = offset;
    }
    public void Navigate() {
        Pagination pagination = owner;
        if (pagination == null || pagination.IsDisabled()) { return; }
        pagination.GoTo(target > 0 ? target : pagination.CurrentPage() + delta);
    }
    public void Submit() {
        Pagination pagination = owner;
        Input editor = input;
        if (pagination == null || pagination.IsDisabled() || editor == null) { return; }
        string text = editor.GetText().Trim();
        if (text.Length == 0) { return; }
        int page = 0;
        if (FormRule.TryParseInt(text, out page) && page > 0) { pagination.GoTo(page); }
    }
    public void NextSize() {
        Pagination pagination = owner;
        if (pagination == null || pagination.IsDisabled() || pagination.pageSizes == null || pagination.pageSizes.Count == 0) { return; }
        pagination.sizeIdx = (pagination.sizeIdx + 1) % pagination.pageSizes.Count;
        pagination.SetPageSize(pagination.pageSizes[pagination.sizeIdx]);
        if (pagination.SizeChange != null) { pagination.SizeChange.Post(pagination); }
    }
}

// Prompt owns its buttons; their Click handlers hold only this action (weak owner) to avoid a cycle.
public class PromptAction {
    public weak Prompt owner;
    public bool submit;

    public PromptAction(Prompt prompt, bool isSubmit) {
        owner = prompt;
        submit = isSubmit;
    }

    public void Invoke() {
        Prompt prompt = owner;
        if (prompt == null || prompt.IsDisabled()) { return; }
        if (submit) {
            if (prompt.Submit != null) { prompt.Submit.Raise(prompt); }
        } else {
            if (prompt.Cancel != null) { prompt.Cancel.Raise(prompt); }
        }
    }
}

public class RateAction {
    public weak Rate owner;
    private int index;
    public RateAction(Rate rate, int starIndex) {
        owner = rate;
        index = starIndex;
    }
    public void Click() {
        Rate rate = owner;
        if (rate == null) { return; }
        rate.OnStarClick(index);
    }
}

class RibbonAction {
    public weak Ribbon Owner;
    public int Generation;
    public int Value;
    public bool Tab;
    public bool Overflow;
    public int Revision;
    public weak Control Source;
    public void Run() {
        Ribbon ribbon = Owner;
        Control source = Source;
        if (ribbon == null || ribbon.treeGeneration != Generation || ribbon.layoutRevision != Revision) { return; }
        if (Tab) { ribbon.SelectRetainedTab(Value, Generation, source); }
        else if (Overflow) { ribbon.OpenRetainedOverflow(Generation, source); }
        else { ribbon.InvokeRetained(Value, Generation, source); }
    }
}

class RibbonOverflowAction {
    public weak RibbonOverflow Popup;
    public weak Control Source;
    public int Value;
    public void Run() {
        RibbonOverflow popup = Popup;
        Control source = Source;
        if (popup != null) { popup.Select(Value, source); }
    }
}

// Steps owns its step nodes; their Click handlers hold only this action (weak owner) to avoid a cycle.
public class StepsAction {
    public weak Steps owner;
    public int index;

    public StepsAction(Steps steps, int targetIndex) {
        owner = steps;
        index = targetIndex;
    }

    public void Invoke() {
        Steps steps = owner;
        if (steps == null || steps.IsDisabled() || !steps.Clickable) { return; }
        if (index < 0 || index >= steps.steps.Count || index == steps.ErrorIndex) { return; }
        if (steps.Current != null && steps.Current.Get() != index) {
            steps.Current.Set(index);
            steps.Change.Raise(steps);
            steps.BuildSteps();
        }
    }
}

public class TabsAction {
    public weak Tabs owner;
    public int index;
    public bool close;
    private int generation;
    public TabsAction(Tabs tabs, int idx, bool closeTab) {
        owner = tabs;
        index = idx;
        close = closeTab;
        generation = tabs.treeGeneration;
    }
    public void Invoke() {
        Tabs tabs = owner;
        if (tabs == null || tabs.IsDisabled() || tabs.treeGeneration != generation) { return; }
        if (index < 0) { tabs.TriggerAdd(); }
        else if (close) { tabs.CloseTab(index); }
        else { tabs.Select(index); }
    }
}

public class TagAction {
    private weak Tag owner;
    public TagAction(Tag tag) { owner = tag; }
    public void Close() {
        Tag tag = owner;
        if (tag != null) { tag.TriggerEvent("Close"); }
    }
}

class ToolStripItemAction {
    public weak ToolStrip owner;
    public int index;
    public void Run() {
        ToolStrip strip = owner;
        if (strip != null) { strip.FireItem(index); }
    }
}

// Wizard owns its buttons; their Click handlers hold only this action (weak owner) to avoid a cycle.
public class WizardAction {
    public weak Wizard owner;
    public int op; // 0 prev, 1 next, 2 finish

    public WizardAction(Wizard wizard, int operation) {
        owner = wizard;
        op = operation;
    }

    public void Invoke() {
        Wizard wizard = owner;
        if (wizard == null || wizard.IsDisabled()) { return; }
        if (op == 0) { wizard.Prev(); }
        else if (op == 1) { wizard.Next(); }
        else { wizard.OnFinish(); }
    }
}
