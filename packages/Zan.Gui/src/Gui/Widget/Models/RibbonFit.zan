using System;
using Gui;

namespace Gui.Widget;

// 功能区在给定宽度下的降级排布（只描述"这一帧怎么排"，
// 不改宿主的命令对象）：
//   compact[g] —— 第 g 组的小命令是否收成纯图标格；
//   dropped[i] —— 第 i 个命令（跨组连续编号）是否整条不画。
//
// 降级的理由是条带放不下：先收图标格（右边的组先收，左边的
// 主操作区保留文字标签），还不行就丢掉标了 optional 的低价值
// 命令（见 RibbonItem.optional）——宁可少几个命令，也不要把
// 半个图标画在条带边上。
public class RibbonFit {
    // 按组：true = 该组的小命令收成图标格。
    public List<bool> compact;
    // 按命令（跨组连续编号）：true = 该命令整条不画、不占位。
    public List<bool> dropped;

    RibbonFit() {
        this.compact = new List<bool>();
        this.dropped = new List<bool>();
    }
}
