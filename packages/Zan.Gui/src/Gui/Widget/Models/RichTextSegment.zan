using System;
using Gui;

namespace Gui.Widget;

// 行内一个可绘制的文本片段：位置与宽度在排版时定，携带颜色、
// 背景与所在链接（null = 非链接）。
public class RichTextSegment {
    public string text;
    public int x;
    public int width;
    public int color;
    public int background;
    public RichTextLink link;

    // 构造一个片段；x/width 由排版回填。
    RichTextSegment(string text, int color, int background,
            RichTextLink link) {
        this.text = text;
        this.x = 0;
        this.width = 0;
        this.color = color;
        this.background = background;
        this.link = link;
    }
}
