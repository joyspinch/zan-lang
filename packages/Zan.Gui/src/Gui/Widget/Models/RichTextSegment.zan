using System;
using Gui;
namespace Gui.Widget;
public class RichTextSegment {
    public string text;
    public int x;
    public int width;
    public int color;
    public int background;
    public RichTextLink link;
    public RichTextSegment(string text, int color, int background,
            RichTextLink link) {
        this.text = text;
        this.x = 0;
        this.width = 0;
        this.color = color;
        this.background = background;
        this.link = link;
    }
}
