using System;
using Gui;

namespace Gui.Widget;

// 单个功能区命令：图标加下方标题。`sep` 在命令后绘制组
// 分隔线（用于在视觉上分组相关命令）。
public class RibbonCmd {
    // 图标名。
    public string icon;
    // 标题。
    public string label;
    // 本命令之后画一条组分隔线。
    public bool sep;
    // false 时命令变灰绘制、无悬停/手型光标，
    // 且不可点击（Render 永不返回其索引）。
    public bool enabled;
    // 紧凑命令是纯图标方按钮，宽度为通常的一半：
    // 用于开关类（面板可见性、视图选项），它们占用整个
    // 带标题槽位太浪费。
    public bool compact;
    // 开关类命令的当前态（SetOn 每帧驱动；on 时按按下态着色）。
    public bool on;
    // 悬停说明，显示在标题下方；否则只显示标题。
    public string tip;

    // 构造常规命令（默认可用、非紧凑）。
    RibbonCmd(string icon, string label) {
        this.icon = icon;
        this.label = label;
        this.sep = false;
        this.enabled = true;
        this.compact = false;
        this.on = false;
        this.tip = "";
    }

    // 设悬停说明（链式）。
    RibbonCmd SetTip(string text) { tip = text; return this; }

    // 提示文本：有说明时为「标题\n说明」。
    string TipText() {
        if (tip != "") { return label + "\n" + tip; }
        return label;
    }

    // 纯图标开关。`label` 用于提示/无障碍
    // 名称；每帧用 SetOn 驱动状态。
    static RibbonCmd Switch(string icon, string label, bool on) {
        RibbonCmd r = new RibbonCmd(icon, label);
        r.compact = true;
        r.on = on;
        return r;
    }

    // 驱动开关态（紧凑开关命令每帧调用）。
    void SetOn(bool state) { on = state; }

    // 构造组尾命令（其后画组分隔线）。
    static RibbonCmd Group(string icon, string label) {
        RibbonCmd r = new RibbonCmd(icon, label);
        r.sep = true;
        return r;
    }

    // 设可用性。
    void SetEnabled(bool on) { enabled = on; }
}
