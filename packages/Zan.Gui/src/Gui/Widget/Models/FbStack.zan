using System;
using Gui;

namespace Gui.Widget;

// 竖直单元：标签在上、控件填充其余。用于带 caption 的流式字段，
// 无表面。
public class FbStack : Panel {
    // 构造：以 "fbstack" 注册为透明布局面板（标签在上、控件填充）。
    FbStack() {
        this.InitPanel("fbstack", 3);
    }

    // 覆写：不画任何表面（无表面竖直单元）。
    override void OnPaint(App app) {
    }

    // 覆写：子项测量高累计、宽取最宽者（宽随宿主）。
    override void OnMeasure(App app) {
        int h = 0;
        int w = 0;
        for (int i = 0; i < this.children.Count; i = i + 1) {
            h = h + this.children[i].prefH;
            if (this.children[i].prefW > w) { w = this.children[i].prefW; }
        }
        this.prefH = h;
        this.prefW = 0;
    }

    // 覆写：子项自上而下按测量高堆叠，dock-fill（dock==5）的
    // 子项吃掉剩余高度。
    override void Arrange(int px, int py, int pw, int ph) {
        if (pw < 0) { pw = 0; }
        if (ph < 0) { ph = 0; }
        this.bx = px;
        this.by = py;
        this.bw = pw;
        this.bh = ph;
        int cy = py;
        int rest = ph;
        for (int i = 0; i < this.children.Count; i = i + 1) {
            Control c = this.children[i];
            if (c.dock == 5) {
                c.Arrange(px, cy, pw, rest);
            } else {
                int hh = c.prefH;
                if (hh > rest) { hh = rest; }
                if (hh < 0) { hh = 0; }
                c.Arrange(px, cy, pw, hh);
                cy = cy + hh;
                rest = rest - hh;
            }
        }
    }
}
