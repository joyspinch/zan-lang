using System;
using Gui;

namespace Gui.Widget;

// 高层级、自包含的标签页组件。
// 保留式组件（创建一次，跨帧保留），拥有自己的标签页
// 列表、活动索引、可关闭状态和右键上下文菜单。它只绘制
// 标签页 HEADER（标签条）；调用方把活动页渲染到
// 独立的正文区域，因此头部和页面区域完全
// 解耦，可各自独立放置：
// // 一次：
// tabs.SetShowAdd(true);                   // 尾部「+」按钮
// tabs.Add("Overview", false);             // (标签, 是否可关闭)
// // 每帧——头部：
// tabs.Render(app, x, y, width);           // 水平
// // tabs.RenderVertical(app, x, y, w, h); // 垂直轨道
// // ...然后在正文区域为 tabs.Active() 绘制你自己的页面。
// int added = tabs.TakeAdded();    // 本帧追加的索引，或 -1
// int shut  = tabs.TakeClosed();   // 移除的索引（一帧一个），或 -1
// 样式：Line（下划线）、Card（凸起标签）、Segment（胶囊组）。
// 方向：Horizontal（顶部条）或 Vertical（侧边轨道）。
// 一个标签页：其标签以及是否显示关闭按钮。用一个实体代替
// 并行的 label/closable 列表。
public class TabItem {
    // 标签标题。
    public string label;
    // 是否显示关闭按钮（且可被关闭）。
    public bool closable;
    // 自定义 Header 插槽控件（图标/徽标/Tag等活控件）
    public Control headerSlot;

    // 构造一个标签页。
    TabItem(string label, bool closable) {
        this.label = label;
        this.closable = closable;
        this.headerSlot = null;
    }

    // 设置自定义 Header 插槽
    TabItem Header(Control header) {
        this.headerSlot = header;
        return this;
    }
}
