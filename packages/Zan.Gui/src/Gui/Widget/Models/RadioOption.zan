using System;
using Gui;
namespace Gui.Widget;
public class RadioOption {
    public string label;
    public int value;
    public bool hasValue;
    public bool disabled;
    public string cls;
    public RadioOption(string lbl) {
        label = lbl; value = 0; hasValue = false;
        disabled = false; cls = "";
    }
    public RadioOption(string lbl, int val) {
        label = lbl; value = val; hasValue = true;
        disabled = false; cls = "";
    }
    public RadioOption(string lbl, int val, bool dis) {
        label = lbl; value = val; hasValue = true;
        disabled = dis; cls = "";
    }
}
