using System;
using Gui;

namespace Gui.Widget;

// 级联下列滚动状态强类型实体（消除 cascadeScroll 与 cascadeScrollSig 平行列表反模式）。
public class CascadeColumnScroll {
    public int offset;
    public SignalInt signal;

    public CascadeColumnScroll() {
        this.offset = 0;
        this.signal = new SignalInt(0);
    }

    public CascadeColumnScroll(int offset, SignalInt signal) {
        this.offset = offset;
        this.signal = signal != null ? signal : new SignalInt(offset);
    }
}
