using System;
using System.IO;
using System.Net.External;
using System.Threading;
using Gui;
using Gui.Component;

namespace Gui.Widget;

// 文件上传状态取值（对齐 Naive UI status:
public class UploadStatus {
    // 等待上传：已入列但尚未开始（Submit() 或宿主启动）。
    static int Pending() { return 0; }
    // 上传中：percent 为进度（0..100）。
    static int Uploading() { return 1; }
    // 成功：url 可指向远端地址（配合下载/回显）。
    static int Success() { return 2; }
    // 失败：message 携带原因。
    static int Error() { return 3; }
}
