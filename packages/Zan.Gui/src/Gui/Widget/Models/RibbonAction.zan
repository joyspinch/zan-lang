using System;
namespace Gui.Widget;

class RibbonAction {
    public weak Ribbon Owner;
    public int Generation;
    public int Value;
    public bool Tab;
    public bool Overflow;
    public int Revision;
    public weak Control Source;
    public void Run() {
        Ribbon ribbon = Owner;
        if (ribbon == null || ribbon.treeGeneration != Generation || ribbon.layoutRevision != Revision) { return; }
        if (Tab) { ribbon.SelectRetainedTab(Value, Generation, Source); }
        else if (Overflow) { ribbon.OpenRetainedOverflow(Generation, Source); }
        else { ribbon.InvokeRetained(Value, Generation, Source); }
    }
}
