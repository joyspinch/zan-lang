using System;
using System.Collections.Generic;
using Gui;
using Gui.Backend;
namespace Gui.Widget;
public class LayerState {
    public string title;
    public string body;
    public int x;
    public int y;
    public int w;
    public int h;
    public int sx;
    public int sy;
    public int sw;
    public int sh;
    int windowState;
    int inputGeneration;
    public int state {
        get { return windowState; }
        set {
            if (windowState == value) { return; }
            inputGeneration = inputGeneration + 1;
            windowState = value;
            if (!modal && value == 2) { this.ReleaseLayerInput(); }
        }
    }
    bool inputOpen;
    public bool open {
        get { return inputOpen; }
        set {
            if (inputOpen == value) { return; }
            inputGeneration = inputGeneration + 1;
            inputOpen = value;
            App host = inputApp;
            if (!value) { this.ReleaseLayerInput(); }
            if (host != null && modal) { Layer.SyncDialogs(host); }
        }
    }
    public bool dragging;
    public int grabDx;
    public int grabDy;
    public int barId;
    public int closeId;
    public int maxId;
    public int minId;
    public bool footer;
    public int action;
    public int kind;  // 0 窗口，1 对话框，2 提示框
    public bool modal;  // 绘制变暗的背景遮罩并让层居中
    public int dtype;  // 对话框图标：0 信息，1 成功，2 警告，3 错误
    public bool twoButtons;  // confirm/prompt（OK+Cancel）对比 alert（仅 OK）
    public string okText;
    public string cancelText;
    public string altText;
    public Button okBtn;
    public Button cancelBtn;
    public Button altBtn;
    public Flex dialogFooter;
    public Flex windowFooter;
    public Input promptInput;  // kind 2 的文本输入框（其他情况为 null）
    public int openMs;  // layer 打开时的墙钟毫秒数（入场动画用）
    public int minSlot;
    Control bodyView;
    public Control view {
        get { return bodyView; }
        set {
            if (bodyView == value) { return; }
            int generation = inputGeneration + 1;
            inputGeneration = generation;
            this.ReleaseLayerInput();
            if (inputGeneration != generation) { return; }
            if (wrap != null && bodyView != null) { wrap.Remove(bodyView); }
            if (inputGeneration != generation) { return; }
            wrap = null;
            bodyView = value;
        }
    }
    weak App inputApp;
    Control inputBody;
    Control inputPrompt;
    Control inputFooter;
    int inputX;
    int inputY;
    int inputW;
    int inputH;
    void RetireLayerInputs(App app, Control body, Control prompt, Control footerRoot, int generation) {
        if (app == null || (body == null && prompt == null && footerRoot == null)) { return; }
        List<InputRetirementToken> retiring = app.SnapshotInputRetirements(body, null, false);
        retiring.AddRange(app.SnapshotInputRetirements(prompt, null, false));
        retiring.AddRange(app.SnapshotInputRetirements(footerRoot, null, false));
        if (inputGeneration == generation && body != null) { app.CancelInputSubtree(body); }
        if (inputGeneration == generation && prompt != null) { app.CancelInputSubtree(prompt); }
        if (inputGeneration == generation && footerRoot != null) { app.CancelInputSubtree(footerRoot); }
        app.NotifyInputRetirements(retiring, 0, false);
    }
    void CancelLayerInputOnly() {
        App app = inputApp;
        Control body = inputBody; Control prompt = inputPrompt; Control footerRoot = inputFooter;
        int generation = inputGeneration;
        if (app == null) { return; }
        if (body != null) { app.CancelInputSubtree(body); }
        if (inputGeneration != generation) { return; }
        if (prompt != null) { app.CancelInputSubtree(prompt); }
        if (inputGeneration != generation) { return; }
        if (footerRoot != null) { app.CancelInputSubtree(footerRoot); }
    }
    void CancelLayerInput() {
        this.RetireLayerInputs(inputApp, inputBody, inputPrompt, inputFooter, inputGeneration);
    }
    void ReleaseLayerInput() {
        App app = inputApp;
        Control body = inputBody; Control prompt = inputPrompt; Control footerRoot = inputFooter;
        int generation = inputGeneration;
        this.RetireLayerInputs(app, body, prompt, footerRoot, generation);
        if (inputGeneration != generation) { return; }
        inputBody = null; inputPrompt = null; inputFooter = null;
    }
    void SetLayerInput(App app, Control bodyRoot, Control prompt, Control footerRoot,
            int x, int y, int w, int h) {
        bool accepts = open && (modal || state != 2);
        if (inputApp == app && inputBody == (accepts ? bodyRoot : null)
                && inputPrompt == (accepts ? prompt : null)
                && inputFooter == (accepts ? footerRoot : null)) {
            inputX = x; inputY = y; inputW = w; inputH = h;
            if (app != null) {
                AppLayerContext context = Layer.Context(app);
                InputRootAdapter active = app.rootControl is InputRootAdapter ? (InputRootAdapter)app.rootControl : null;
                bool linked = context.inputRoot != null && active != null
                    && active.ContainsAdapter(context.inputRoot) && context.zorder.IndexOf(this) >= 0;
                if (!linked) {
                    inputGeneration = inputGeneration + 1;
                    Layer.BindInput(app, this);
                }
            }
            return;
        }
        int generation = inputGeneration + 1;
        inputGeneration = generation;
        App previousApp = inputApp;
        Control body = inputBody; Control oldPrompt = inputPrompt; Control footerRootOld = inputFooter;
        bool changedApp = previousApp != null && previousApp != app;
        if (!changedApp && accepts) {
            if (body == bodyRoot || (bodyRoot != null && bodyRoot.ContainsHostedControl(body))) { body = null; }
            if (oldPrompt == prompt) { oldPrompt = null; }
            if (footerRootOld == footerRoot) { footerRootOld = null; }
        }
        this.RetireLayerInputs(previousApp, body, oldPrompt, footerRootOld, generation);
        if (inputGeneration != generation) { return; }
        if (changedApp) { Layer.Context(previousApp).zorder.Remove(this); }
        inputBody = accepts ? bodyRoot : null;
        inputPrompt = accepts ? prompt : null;
        inputFooter = accepts ? footerRoot : null;
        inputApp = app;
        inputX = x; inputY = y; inputW = w; inputH = h;
        Layer.BindInput(app, this);
    }
    bool ContainsLayerInput(Control control) {
        if (!open || (!modal && state == 2) || control == null) { return false; }
        return (inputBody != null && inputBody.ContainsInputControl(control))
            || (inputPrompt != null && inputPrompt.ContainsInputControl(control))
            || (inputFooter != null && inputFooter.ContainsInputControl(control));
    }
    void CollectLayerFocus(App app, List<Control> controls) {
        if (!open || (!modal && state == 2)) { return; }
        if (inputPrompt != null) { inputPrompt.CollectInputFocus(app, controls); }
        if (inputBody != null) { inputBody.CollectInputFocus(app, controls); }
        if (inputFooter != null) { inputFooter.CollectInputFocus(app, controls); }
    }
    Control FindLayerFocus(App app) {
        if (!open || (!modal && state == 2)) { return null; }
        Control found = inputPrompt != null ? inputPrompt.FindInputFocus(app) : null;
        if (found == null && inputBody != null) { found = inputBody.FindInputFocus(app); }
        if (found == null && inputFooter != null) { found = inputFooter.FindInputFocus(app); }
        return found;
    }
    Control HitLayerInput(int x, int y, int pointerType, List<Control> excludedSubtrees) {
        if (!open || (!modal && state == 2)) { return null; }
        Control hit = inputFooter != null ? inputFooter.HitTest(x, y, pointerType, excludedSubtrees) : null;
        if (hit == null && inputBody != null) { hit = inputBody.HitTest(x, y, pointerType, excludedSubtrees); }
        if (hit == null && inputPrompt != null) { hit = inputPrompt.HitTest(x, y, pointerType, excludedSubtrees); }
        return hit;
    }
    public bool shadeClose;
    public int promptFormType;
    public int promptMaxLen;
    public TextArea promptArea;  // formType 2 的多行输入框（此时 promptInput 为 null）
    public bool sizing;
    public int rDir;  // 1 左缘，2 右缘，3 下缘，4 右下角，5 左下角
    public int rStartX;
    public int rStartY;
    public int rStartW;
    public int rStartH;
    public int rsLId;
    public int rsRId;
    public int rsBId;
    public int rsSEId;
    public int rsSWId;
    public UiEvent Opened;
    public UiEvent Closed;
    public bool wasOpen;
    public bool openedRaised;
    public int AutoCloseMs;
    public bool closing;
    public int closeMs;
    public bool closedRaised;
    public bool autoCenter;
    public int sizeMinW;
    public int sizeMaxH;
    public Control wrap;
    LayerDialogControl retainedDialog;
    public LayerState(string title, int x, int y, int w, int h) {
        this.title = title;
        this.body = "";
        this.x = x;
        this.y = y;
        this.w = w;
        this.h = h;
        this.sx = x;
        this.sy = y;
        this.sw = w;
        this.sh = h;
        this.state = 0;
        this.open = false;
        this.dragging = false;
        this.grabDx = 0;
        this.grabDy = 0;
        this.barId = WidgetId.Next();
        this.closeId = WidgetId.Next();
        this.maxId = WidgetId.Next();
        this.minId = WidgetId.Next();
        this.footer = true;
        this.action = 0;
        this.kind = 0;
        this.modal = false;
        this.dtype = 0;
        this.twoButtons = true;
        this.okText = "OK";
        this.cancelText = "Cancel";
        this.altText = "";
        this.okBtn = new Button { ClassName = "primary" };
        this.cancelBtn = new Button { };
        this.altBtn = new Button { };
        LayerAction okAction = new LayerAction(this, 1);
        LayerAction cancelAction = new LayerAction(this, 2);
        LayerAction altAction = new LayerAction(this, 4);
        this.okBtn.Click.Add(okAction.Invoke);
        this.cancelBtn.Click.Add(cancelAction.Invoke);
        this.altBtn.Click.Add(altAction.Invoke);
        this.dialogFooter = new Flex();
        this.dialogFooter.ClassName = "row justify-end align-center gap-medium";
        this.windowFooter = new Flex();
        this.windowFooter.ClassName = "row justify-end align-center gap-medium";
        this.windowFooter.Add(this.cancelBtn);
        this.windowFooter.Add(this.okBtn);
        this.promptInput = null;
        this.promptArea = null;
        this.view = null;
        this.shadeClose = false;
        this.promptFormType = 0;
        this.promptMaxLen = 0;
        this.sizing = false;
        this.rDir = 0;
        this.rStartX = 0;
        this.rStartY = 0;
        this.rStartW = 0;
        this.rStartH = 0;
        this.rsLId = WidgetId.Next();
        this.rsRId = WidgetId.Next();
        this.rsBId = WidgetId.Next();
        this.rsSEId = WidgetId.Next();
        this.rsSWId = WidgetId.Next();
        this.Opened = new UiEvent();
        this.Closed = new UiEvent();
        this.wasOpen = false;
        this.openedRaised = false;
        this.AutoCloseMs = 0;
        this.closing = false;
        this.closeMs = 0;
        this.closedRaised = false;
        this.autoCenter = false;
        this.sizeMinW = 0;
        this.sizeMaxH = 0;
        this.wrap = null;
    }
    public static LayerState Confirm(string title, string body, int dtype) {
        LayerState s = new LayerState(title, 0, 0, 420, 200);
        s.body = body;
        s.kind = 1;
        s.modal = true;
        s.dtype = dtype;
        s.twoButtons = true;
        return s;
    }
    public static LayerState Choose(string title, string body, int dtype, string okText,
                             string altText, string cancelText) {
        LayerState s = LayerState.Confirm(title, body, dtype);
        s.okText = okText;
        s.altText = altText;
        s.cancelText = cancelText;
        return s;
    }
    public static LayerState Alert(string title, string body, int dtype) {
        LayerState s = LayerState.Confirm(title, body, dtype);
        s.twoButtons = false;
        return s;
    }
    public static LayerState Prompt(string title, string hint) {
        return LayerState.PromptWith(title, hint, 0, "", 0);
    }
    public static LayerState PromptWith(string title, string hint, int formType,
                                 string value, int maxLen) {
        LayerState s = new LayerState(title, 0, 0, 420,
                                      formType == 2 ? 340 : 220);
        s.kind = 2;
        s.modal = true;
        s.dtype = 0;
        s.twoButtons = true;
        s.promptFormType = formType;
        s.promptMaxLen = maxLen;
        if (formType == 2) {
            s.promptArea = new TextArea(hint);
            if (maxLen > 0) { s.promptArea.MaxLen = maxLen; }
            if (value != "") { s.promptArea.SetText(value); }
        } else {
            s.promptInput = new Input(hint);
            LayerAction submitAction = new LayerAction(s, 1);
            s.promptInput.Submit.Add(submitAction.Invoke);
            if (value != "") { s.promptInput.SetText(value); }
            if (formType == 1) { s.promptInput.password = true; }
            if (maxLen > 0) { s.promptInput.MaxLen = maxLen; }
        }
        return s;
    }
    public void SetBody(Control v) { view = v; }
    public void SizeToContent(int minW, int maxH) { this.SizeToContent(null, minW, maxH); }
    public void SizeToContent(App app, int minW, int maxH) {
        sizeMinW = minW;
        sizeMaxH = maxH;
        this.ApplySizeToContent(app);
    }
    public void ApplySizeToContent() { this.ApplySizeToContent(null); }
    public void ApplySizeToContent(App app) {
        if (view == null) { return; }
        if (app == null) { app = App.Current; }
        if (app == null || app.canvas == null) { return; }
        view.MeasureTree(app);
        int contentW = view.prefW;
        int contentH = view.prefH;
        int aw = app.canvas.Width();
        int ah = app.canvas.Height();
        int bar = Layer.BarH(app);
        int footH = 0;
        if (footer) { footH = Layer.FooterH(app); }
        int padT = app.Scale(16);
        int padB = app.Scale(8);
        int padX = app.Scale(40);
        int textH = 0;
        if (body != "") { textH = app.Scale(28); }
        int availBody = ah - app.titlebarH - app.Scale(32)
            - bar - padT - padB - textH - footH;
        if (availBody < app.Scale(60)) { availBody = app.Scale(60); }
        int maxH = sizeMaxH;
        if (maxH > 0) { maxH = app.Scale(maxH); }
        if (maxH > 0 && availBody > maxH) { availBody = maxH; }
        bool scrolling = contentH > availBody
            && view.Kind() != "ScrollColumn";
        if (scrolling && wrap == null) {
            ScrollColumn sc = new ScrollColumn();
            sc.With(view);
            wrap = sc;
        } else if (!scrolling && wrap != null) {
            int generation = inputGeneration;
            this.ReleaseLayerInput();
            if (inputGeneration != generation) { return; }
            wrap.Remove(view);
            if (inputGeneration != generation) { return; }
            wrap = null;
        }
        int w = contentW + padX;
        int minW = sizeMinW;
        if (minW > 0) { minW = app.Scale(minW); }
        if (w < minW) { w = minW; }
        if (w > aw - app.Scale(32)) { w = aw - app.Scale(32); }
        int bodyH = contentH;
        if (scrolling) { bodyH = availBody; }
        int h = bar + padT + textH + bodyH + padB + footH;
        if (h > ah - app.titlebarH - app.Scale(16)) { h = ah - app.titlebarH - app.Scale(16); }
        int wx = (aw - w) / 2;
        int wy = (ah - h) / 2;
        if (wy < app.titlebarH) { wy = app.titlebarH; }
        if (wy + h > ah) { wy = ah - h; }
        this.w = w;
        this.h = h;
        this.x = wx;
        this.y = wy;
        sx = x;
        sy = y;
        sw = w;
        sh = h;
        autoCenter = true;
    }
    public void Open(App app) {
        inputGeneration = inputGeneration + 1;
        open = true;
        action = 0;
        openMs = Window.GetTickMs();
        wasOpen = true;
        openedRaised = false;
        closedRaised = false;
        closing = false;
        closeMs = 0;
        if (state == 2) { state = 0; }
        Layer.RegisterOpen(app, this);
    }
    public void Open() { this.Open(null); }
    public void Close(App app) { Layer.Close(app, this); }
    public void Close() { Layer.Close(null, this); }
    public bool IsTopmost(App app) { return Layer.IsTopmost(app, this); }
    public bool IsTopmost() { return Layer.IsTopmost(null, this); }
    public string PromptText() {
        if (promptArea != null) { return promptArea.GetText(); }
        if (promptInput == null) { return ""; }
        return promptInput.GetText();
    }
}
