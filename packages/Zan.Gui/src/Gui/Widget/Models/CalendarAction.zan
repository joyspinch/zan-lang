namespace Gui.Widget;

public class CalendarAction {
    public weak Calendar owner;

    public CalendarAction(Calendar calendar) { owner = calendar; }
    public void Previous() { Calendar calendar = owner; if (calendar != null) { calendar.MoveMonth(-1); } }
    public void Next() { Calendar calendar = owner; if (calendar != null) { calendar.MoveMonth(1); } }
    public void Today() { Calendar calendar = owner; if (calendar != null) { calendar.JumpToToday(); } }
    public void PickToday() { Calendar calendar = owner; if (calendar != null) { calendar.PickDate(Calendar.TodayRef()); } }
    public void Clear() { Calendar calendar = owner; if (calendar != null) { calendar.ClearDate(); } }
}
