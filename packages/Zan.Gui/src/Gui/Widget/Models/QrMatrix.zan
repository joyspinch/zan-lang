using System;
using Gui;

namespace Gui.Widget;

// 二维码编码结果：version/size/ecl + 边长 size 的模块矩阵（true = 深色，
// 不含静区）。`Get(x,y)` 按行主序读模块。
public class QrMatrix {
    public int version;
    public int size;
    public QrEcl ecl;
    public bool[] modules;

    // (x,y) 处模块是否深色（行主序，不含静区）。
    public bool Get(int x, int y) { return modules[y * size + x]; }
}
