using System;
using Gui;

namespace Gui.Widget;

// 一个手风琴面板：标题和内容作为一个记录同存。
// 经 `Collapse.AddPanel(title, body)` 或 `Collapse.Of(list, m)` 使用。
public class CollapsePanel {
    public string title;
    public string body;

    // 构建一个面板记录。
    CollapsePanel(string title, string body) {
        this.title = title;
        this.body = body;
    }
}
