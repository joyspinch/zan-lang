using Gui;

namespace Gui.Widget;

// 子项持有委托，委托只弱引用折叠容器和子项。
public class CollapseAction {
    public weak Collapse owner;
    public weak CollapseItem item;

    public CollapseAction(Collapse collapse, CollapseItem child) {
        owner = collapse;
        item = child;
    }

    public void Toggle() {
        Collapse collapse = owner;
        CollapseItem child = item;
        if (collapse == null || child == null) { return; }
        collapse.OnItemToggled(child);
    }
}
