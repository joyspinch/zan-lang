using System;
using Gui;

namespace Gui.Widget;

// One message header owns its actual parts; layout never borrows another row's controls.
public class StyledTextHeader : Control {
    private Avatar avatar;
    private Tag speaker;
    private Tag status;
    private Tag progress;

    public StyledTextHeader() {
        this.InitControl("styledTextHeader", 1);
        styleSurfaceOwned = true;
        avatar = new Avatar("", 16);
        speaker = new Tag(); status = new Tag(); progress = new Tag();
        this.Add(avatar); this.Add(speaker); this.Add(status); this.Add(progress);
    }

    public void Prepare(App app, TextRun line) {
        string initial = line.ava; string text = line.text;
        string role = line.tagCls; string state = line.status;
        string percent = line.pct >= 0 ? Convert.ToString(line.pct) + "%" : "";
        if (avatar.Label() != initial) { avatar.SetText(initial); }
        avatar.Class = role;
        if (speaker.Label() != text) { speaker.SetText(text); }
        speaker.Class = role;
        if (status.Label() != state) { status.SetText(state); }
        if (progress.Label() != percent) { progress.SetText(percent); }
        progress.Class = "primary";
        speaker.SetShown(true); status.SetShown(state != ""); progress.SetShown(percent != "");
        this.MeasureTree(app);
    }

    public override void OnMeasure(App app) { prefW = 0; prefH = StyledText.RowH(app); }

    private int Place(Tag part, int x, int y, int right) {
        bool shown = part.Label() != "" && x + part.prefW <= right;
        part.SetShown(shown);
        if (!shown) { part.Arrange(x, y, 0, 0); return x; }
        int height = part.prefH > 0 ? part.prefH : this.App.theme.heightTiny;
        part.Arrange(x, by + Math.Max(0, (bh - height) / 2), part.prefW, height);
        return x + part.prefW + this.App.Scale(4);
    }

    public override void Arrange(int x, int y, int w, int h) {
        bx = x; by = y; bw = Math.Max(0, w); bh = Math.Max(0, h);
        App app = this.App;
        if (app == null) { return; }
        int diameter = avatar.Diameter(app);
        avatar.Arrange(x, y + Math.Max(0, (h - diameter) / 2), diameter, diameter);
        int cursor = x + diameter + app.Scale(5);
        int chipY = y + Math.Max(0, (h - app.theme.heightTiny) / 2);
        cursor = this.Place(speaker, cursor, chipY, x + bw);
        cursor = this.Place(status, cursor, chipY, x + bw);
        this.Place(progress, cursor, chipY, x + bw);
    }

    public override string Kind() { return "StyledTextHeader"; }
}
