using System;
using Gui;
using Gui.Backend;

namespace Gui.Widget;

// 行首图标委托：返回 Gui.Icon 图标名，"" 表示本行不画图标。
// 穿梭框一栏的瞬时状态：勾选标记、滚动、过滤行序与内嵌搜索框。
// 勾选标记与绑定的列表按行序平行伸缩；order 缓存过滤后的
// 原列表下标，计数与关键词都没变就不重扫。
public class TransferPane {
    // 每行勾选标记，与绑定的列表按行序平行伸缩。
    public List<bool> flags;
    // 行区滚动偏移（像素）。
    public SignalInt scroll;
    // 过滤后的行序缓存（存原列表下标）。
    public List<int> order;
    // 内嵌搜索框（该栏渲染过才有）。
    public Input search;
    // 当前过滤关键词。
    public string query;
    // 按住拖拽多选的锚点：按下行的原列表下标（-1 = 未在拖）与
    // 拖到的最远行下标；两端闭区间内的行取锚点目标态（橡皮筋
    // 只染扫过的带），带外行保持真实勾选。
    public int paintStart;
    public int paintEnd;
    // 锚点按下时暂存的切换（抬起帧统一入账，保住双击=两次翻勾
    // 的既有语义）：拖拽期间行画的是两端闭区间算出的预览态。
    public bool paintVal;
    // 命中区几何缓存（RenderPane 行区开画前记录）：RowCenter 据
    // 此把「第 i 行的屏幕位置」算给宿主拖放对接与无头回归重放。
    public int bodyX;
    public int bodyY;
    public int bodyW;
    public int bodyH;
    // 行高像素（<=0 表示该栏尚未渲染过，RowCenter 直接失败）。
    public int rowHPx;
    // 最近一次量出 order 时数据计数与关键词。
    public int orderFor;
    public string orderQuery;

    // 构造空面板（滚动归零、无搜索框、锚点未按下）。
    TransferPane() {
        flags = new List<bool>();
        scroll = new SignalInt(0);
        order = new List<int>();
        search = null;
        query = "";
        paintStart = 0 - 1;
        paintEnd = 0 - 1;
        paintVal = false;
        bodyX = 0;
        bodyY = 0;
        bodyW = 0;
        bodyH = 0;
        rowHPx = 0;
        orderFor = 0 - 1;
        orderQuery = "";
    }
}
