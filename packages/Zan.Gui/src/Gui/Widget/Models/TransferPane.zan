using System;
using Gui;
namespace Gui.Widget;
public class TransferPane {
    public List<bool> flags;
    public Binding<int> scroll;
    public List<int> order;
    public Input search;
    public string query;
    public int paintStart;
    public int paintEnd;
    public bool paintVal;
    public int bodyX;
    public int bodyY;
    public int bodyW;
    public int bodyH;
    public int rowHPx;
    public int orderFor;
    public string orderQuery;
    public TransferPane() {
        flags = new List<bool>();
        scroll = 0;
        order = new List<int>();
        search = null;
        query = "";
        paintStart = 0 - 1;
        paintEnd = 0 - 1;
        paintVal = false;
        bodyX = 0;
        bodyY = 0;
        bodyW = 0;
        bodyH = 0;
        rowHPx = 0;
        orderFor = 0 - 1;
        orderQuery = "";
    }
}
