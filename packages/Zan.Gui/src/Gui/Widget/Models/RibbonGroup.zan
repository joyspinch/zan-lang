using System;
using Gui;

namespace Gui.Widget;

// 命名的功能区命令组，绘制为带标题的簇，
// 与相邻簇以竖线分隔。
public class RibbonGroup {
    // 组标题。
    public string title;
    // 组内命令。
    public List<RibbonItem> items;

    // 构造空组。
    RibbonGroup(string title) {
        this.title = title;
        this.items = new List<RibbonItem>();
    }
    // 从现成的项列表构建组，例如
    static RibbonGroup Of(string title, List<RibbonItem> items) {
        RibbonGroup g = new RibbonGroup(title);
        g.items = items;
        return g;
    }

    // 追加一个命令（链式）。
    RibbonGroup Add(RibbonItem it) { items.Add(it); return this; }
}
