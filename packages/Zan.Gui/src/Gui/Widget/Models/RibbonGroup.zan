using System;
using Gui;
namespace Gui.Widget;
public class RibbonGroup {
    public string title;
    public List<RibbonItem> items;
    public RibbonGroup(string title) {
        this.title = title;
        this.items = new List<RibbonItem>();
    }
    public static RibbonGroup Of(string title, List<RibbonItem> items) {
        RibbonGroup g = new RibbonGroup(title);
        g.items = items;
        return g;
    }
    public void Add(RibbonItem it) { items.Add(it); }
}
