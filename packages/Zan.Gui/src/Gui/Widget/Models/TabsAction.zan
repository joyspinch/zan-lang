using Gui;

namespace Gui.Widget;

// Tabs owns its buttons; their event handlers must not own Tabs in return.
public class TabsAction {
    public weak Tabs owner;
    public int index;
    public bool close;

    public TabsAction(Tabs tabs, int idx, bool closeTab) {
        owner = tabs;
        index = idx;
        close = closeTab;
    }

    public void Invoke() {
        Tabs tabs = owner;
        if (tabs == null) { return; }
        if (index < 0) { tabs.TriggerAdd(); }
        else if (close) { tabs.CloseTab(index); }
        else { tabs.Select(index); }
    }
}
