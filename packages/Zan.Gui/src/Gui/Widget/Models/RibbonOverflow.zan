using System;
using Gui;

namespace Gui.Widget;

// Anchor retirement, outside Down, Esc, blur and cross-App replacement belong to OverlayHost.
class RibbonOverflow : Control {
    public weak Ribbon Owner;
    public int Generation;
    public int Revision;
    public bool Open = true;

    public RibbonOverflow(Ribbon owner, int generation, int revision) : base("contextmenu") {
        Owner = owner; Generation = generation; Revision = revision;
        this.ClassName = "contextmenu col";
        this.SetProp("style", "display:flex;flex-direction:column;overflow-y:auto;max-height:60vh;padding:var(--space-xs)");
    }

    public override int StyleDisplay() { return 1; }
    public override int StyleFlexDir() { return 1; }

    public override void OnMeasure(App app) {
        int width = app.Scale(140);
        int height = app.Scale(Space.XS * 2);
        for (int i = 0; i < this.Children.Count; i = i + 1) {
            Control child = this.Children[i];
            child.MeasureTree(app);
            width = (int)Math.Max(width, child.prefW + app.Scale(Space.SM * 2));
            height = height + child.prefH;
        }
        prefW = (int)Math.Min(width, Math.Max(1, app.canvas.Width() - app.Scale(Space.XS * 2)));
        prefH = (int)Math.Min(height, Math.Max(1, app.canvas.Height() - app.Scale(Space.XS * 2)));
    }

    public override void OnPopupDismissed() {
        Open = false;
        Ribbon ribbon = Owner;
        if (ribbon != null && ribbon.retainedPopup == this) {
            ribbon.retainedPopup = null;
            if (ribbon.retainedMore != null) { ribbon.retainedMore.Tip = Lang.Tr("More commands", "更多命令"); }
        }
    }

    public void Select(int value, Control source) {
        Ribbon ribbon = Owner;
        App app = this.FindApp();
        if (!Open || ribbon == null || ribbon.treeGeneration != Generation
            || ribbon.layoutRevision != Revision || app == null || ribbon.FindApp() != app
            || app.overlayHost.ActiveRoot() != this || !ribbon.StyleVisible()
            || source == null || !source.StyleVisible()) { return; }
        int epoch = ribbon.overflowEpoch;
        app.overlayHost.Hide(this);
        if (ribbon.overflowEpoch != epoch || ribbon.treeGeneration != Generation || ribbon.layoutRevision != Revision
            || ribbon.FindApp() != app || ribbon.retainedPopup != null
            || !ribbon.StyleVisible() || ribbon.bw <= 0 || ribbon.bh <= 0) { return; }
        ribbon.lastAct = value;
        ribbon.CommandClicked.Raise();
    }
}
