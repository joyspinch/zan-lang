using Gui;

namespace Gui.Widget;

// 标题事件不能反向强持有 CollapseItem。
public class CollapseItemAction {
    public weak CollapseItem owner;

    public CollapseItemAction(CollapseItem item) {
        owner = item;
    }

    public void Click() {
        CollapseItem item = owner;
        if (item == null || item.Disabled) { return; }
        item.SetExpanded(!item.IsExpanded);
    }
}
