using System;
using Gui;

namespace Gui.Widget;

// Pagination owns its parts; delayed callbacks borrow both owner and editor.
public class PaginationAction {
    public weak Pagination owner;
    public weak Input input;
    private int target;
    private int delta;

    public PaginationAction(Pagination pagination, int page, int offset) {
        owner = pagination;
        target = page;
        delta = offset;
    }

    public void Navigate() {
        Pagination pagination = owner;
        if (pagination == null) { return; }
        pagination.GoTo(target > 0 ? target : pagination.CurrentPage() + delta);
    }

    public void Submit() {
        Pagination pagination = owner;
        Input editor = input;
        if (pagination == null || editor == null) { return; }
        string text = editor.GetText().Trim();
        if (text.Length == 0) { return; }
        int page = Convert.ToInt32(text);
        if (page > 0) { pagination.GoTo(page); }
    }

    public void NextSize() {
        Pagination pagination = owner;
        if (pagination == null || pagination.pageSizes.Count == 0) { return; }
        pagination.sizeIdx = (pagination.sizeIdx + 1) % pagination.pageSizes.Count;
        pagination.SetPageSize(pagination.pageSizes[pagination.sizeIdx]);
        pagination.SizeChange.PostS(pagination);
    }
}
