using System;
using Gui;
namespace Gui.Widget;
public class TextRun {
    public string text;
    public int color;
    public int kind;
    public int meta;
    public int owner;
    public string ava;
    public string tagCls;
    public string status;
    public int pct;
    public string time;
    public bool last;
    public static TextRun Create(string text, int color, int kind) {
        TextRun ln = new TextRun();
        ln.text = text;
        ln.color = color;
        ln.kind = kind;
        ln.meta = 0 - 1;
        ln.owner = 0 - 1;
        ln.ava = "";
        ln.tagCls = "";
        ln.status = "";
        ln.pct = 0 - 1;
        ln.time = "";
        ln.last = false;
        return ln;
    }
}
