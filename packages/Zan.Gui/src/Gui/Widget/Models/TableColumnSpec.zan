using System;
using Gui;

namespace Gui.Widget;

// 强类型表格列定义实体：将列标题与宽度绑定，消除平行列表反模式。
public class TableColumnSpec {
    public string title;
    public int width;

    public TableColumnSpec(string title, int width) {
        this.title = title != null ? title : "";
        this.width = width;
    }

    public static TableColumnSpec Of(string title, int width) {
        return new TableColumnSpec(title, width);
    }
}
