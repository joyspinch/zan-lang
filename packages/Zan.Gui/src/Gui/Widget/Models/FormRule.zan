using System;
using Gui;

namespace Gui.Widget;

// 一条字段校验规则。规则是无状态的：每次校验时拿字段的当前值文本
// 重跑一遍，字段隐藏/禁用时整行跳过（见 FormRow.Active）。
public class FormRule {
    public FormCheck check;

    // 构造：包一条校验委托（用 Required/Email 等工厂或直接给 lambda）。
    FormRule(FormCheck c) {
        check = c;
    }

    // 对当前值执行本规则："" = 通过，否则为错误消息。
    string Apply(string value) {
        return check(value);
    }

    // 必填：去空白后不能为空。
    static FormRule Required(string msg) {
        return new FormRule(v => {
            if (v.Trim() == "") { return msg; }
            return "";
        });
    }

    // 最短长度。
    static FormRule MinLen(int n, string msg) {
        return new FormRule(v => {
            if (v.Length < n) { return msg; }
            return "";
        });
    }

    // 最长长度。
    static FormRule MaxLen(int n, string msg) {
        return new FormRule(v => {
            if (v.Length > n) { return msg; }
            return "";
        });
    }

    // 电子邮件格式：`@` 不在首尾，`@` 后还有带点的域名。空值不判
    // （是否可空交给 Required 决定），这样「选填的邮箱」只填一半才报错。
    static FormRule Email(string msg) {
        return new FormRule(v => {
            string s = v.Trim();
            if (s == "") { return ""; }
            int at = s.IndexOf("@");
            if (at < 1 || at == s.Length - 1) { return msg; }
            string host = s.Substring(at + 1);
            int dot = host.IndexOf(".");
            if (dot < 1 || dot == host.Length - 1) { return msg; }
            return "";
        });
    }

    // 整数值域（含端点）。空值不判；非数字按越界处理。
    static FormRule Range(int lo, int hi, string msg) {
        return new FormRule(v => {
            string s = v.Trim();
            if (s == "") { return ""; }
            if (!FormRule.IsInt(s)) { return msg; }
            int n = Convert.ToInt32(s);
            if (n < lo || n > hi) { return msg; }
            return "";
        });
    }

    // 与另一行的值一致（确认密码、再次输入邮箱）。peer 在校验时
    // 实时取值，先填后改都算。
    static FormRule EqualsField(FormRow peer, string msg) {
        return new FormRule(v => {
            if (peer == null) { return ""; }
            if (v != peer.Value()) { return msg; }
            return "";
        });
    }

    // 必须为真（同意条款、开启某前提）。布尔类控件（Checkbox /
    // Switch / Radio）的值是 "true"/"false"，Required 只看非空、
    // 对未勾选的 "false" 无感，所以这类约束用它。
    static FormRule Checked(string msg) {
        return new FormRule(v => {
            if (v != "true") { return msg; }
            return "";
        });
    }

    // 纯数字校验（空值不判，由 Required 决定是否必填）
    static FormRule Numeric(string msg) {
        return new FormRule(v => {
            string s = v.Trim();
            if (s == "") { return ""; }
            if (!FormRule.IsInt(s)) { return msg; }
            return "";
        });
    }

    // 自定义委托校验
    static FormRule Custom(FormCheck check) {
        return new FormRule(check);
    }

    // 十进制整数（允许负号）。手动扫一遍而不是直接 Convert：非法
    // 输入在这里是常态（校验器就是为它存在的），不该走异常路径。
    static bool IsInt(string s) {
        if (s == null || s == "") { return false; }
        int i = 0;
        if (s.StartsWith("-")) { i = 1; }
        if (i >= s.Length) { return false; }
        while (i < s.Length) {
            int c = s[i] & 255;
            if (c < 48 || c > 57) { return false; }
            i = i + 1;
        }
        return true;
    }
}
