using System;
using Gui;
namespace Gui.Widget;
public class FormRule {
    public FormCheck check;
    public FormRule(FormCheck c) { check = c; }
    public string Apply(string value) { return check(value); }
    public static FormRule Required(string msg) {
        return new FormRule(v => {
            if (v.Trim() == "") { return msg; }
            return "";
        });
    }
    public static FormRule MinLen(int n, string msg) {
        return new FormRule(v => {
            if (v.Length < n) { return msg; }
            return "";
        });
    }
    public static FormRule MaxLen(int n, string msg) {
        return new FormRule(v => {
            if (v.Length > n) { return msg; }
            return "";
        });
    }
    public static FormRule Email(string msg) {
        return new FormRule(v => {
            string s = v.Trim();
            if (s == "") { return ""; }
            int at = s.IndexOf("@");
            if (at < 1 || at == s.Length - 1) { return msg; }
            string host = s.Substring(at + 1);
            int dot = host.IndexOf(".");
            if (dot < 1 || dot == host.Length - 1) { return msg; }
            return "";
        });
    }
    public static FormRule Range(int lo, int hi, string msg) {
        return new FormRule(v => {
            string s = v.Trim();
            if (s == "") { return ""; }
            if (!FormRule.IsInt(s)) { return msg; }
            int n = Convert.ToInt32(s);
            if (n < lo || n > hi) { return msg; }
            return "";
        });
    }
    public static FormRule EqualsField(FormRow peer, string msg) {
        return new FormRule(v => {
            if (peer == null) { return ""; }
            if (v != peer.Value()) { return msg; }
            return "";
        });
    }
    public static FormRule Checked(string msg) {
        return new FormRule(v => {
            if (v != "true") { return msg; }
            return "";
        });
    }
    public static FormRule Numeric(string msg) {
        return new FormRule(v => {
            string s = v.Trim();
            if (s == "") { return ""; }
            if (!FormRule.IsInt(s)) { return msg; }
            return "";
        });
    }
    public static FormRule Custom(FormCheck check) { return new FormRule(check); }
    public static bool IsInt(string s) {
        if (s == null || s == "") { return false; }
        int i = 0;
        if (s.StartsWith("-")) { i = 1; }
        if (i >= s.Length) { return false; }
        while (i < s.Length) {
            int c = s[i] & 255;
            if (c < 48 || c > 57) { return false; }
            i = i + 1;
        }
        return true;
    }
}
