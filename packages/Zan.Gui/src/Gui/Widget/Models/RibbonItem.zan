using System;
using Gui;

namespace Gui.Widget;

// Office 风格功能区组中的一个命令。`small` 渲染紧凑的
// 图标+标签行形式（每列三个堆叠）；否则为大的
// 图标+标题按钮。
public class RibbonItem {
    // 图标名。
    public string icon;
    // 标题 / 标签。
    public string label;
    // 紧凑的图标+标签行形式（每列多行堆叠）。
    public bool small;
    // 纯图标小方钮，按 Office 的图标格铺排（一列堆叠多个，
    // 标签只出现在提示里）。用于同一族的一批命令，
    // 例如六个对齐方式。
    public bool tile;
    // 画一个下拉箭头（拆分按钮）：宿主自己在点击后弹菜单，
    // 功能区只负责表达"这个命令还有下一级"。
    public bool menu;
    // 可用性（Disable/SetEnabled 切换）。
    public bool enabled;
    // 低价值命令：条带放不下时可以整条退场（不画、不占位）。
    // 宿主给"帮助""检查更新"这类在别处也有入口的命令标上它，
    // 窄窗口时就少几个按钮，而不是把半个图标画在边上。
    public bool optional;
    // 开关在 `on` 时点亮绘制（强调色填充 + 强调色图标），使一排
    // 看起来像一排开关而非一排命令。
    public bool toggle;
    // 开关当前态（SetOn 每帧驱动）。
    public bool on;
    // 悬停提示；留空时默认取标签。
    public string tip;

    // 构造大命令（图标+标题）。
    static RibbonItem Large(string icon, string label) {
        RibbonItem r = new RibbonItem();
        r.icon = icon;
        r.label = label;
        r.small = false;
        r.tile = false;
        r.menu = false;
        r.enabled = true;
        r.optional = false;
        r.toggle = false;
        r.on = false;
        r.tip = "";
        return r;
    }

    // 构造小命令（图标+标签行）。
    static RibbonItem Small(string icon, string label) {
        RibbonItem r = RibbonItem.Large(icon, label);
        r.small = true;
        return r;
    }

    // 小型开关，例如停靠布局中每个工具面板一个，
    // （见 DockHost.AddSwitchGroup）。
    static RibbonItem Toggle(string icon, string label, bool on) {
        RibbonItem r = RibbonItem.Small(icon, label);
        r.toggle = true;
        r.on = on;
        return r;
    }

    // 纯图标方钮。`label` 只用于提示。
    static RibbonItem Tile(string icon, string label) {
        RibbonItem r = RibbonItem.Large(icon, label);
        r.small = true;
        r.tile = true;
        return r;
    }

    // 标记为拆分按钮（画下拉箭头，链式）。
    RibbonItem SetMenu() { menu = true; return this; }

    // 禁用该命令（链式）。
    RibbonItem Disable() { enabled = false; return this; }

    // 标为低价值命令（链式）：条带放不下时可以整条退场。
    RibbonItem SetOptional() { optional = true; return this; }

    // 设悬停说明（链式）。
    RibbonItem SetTip(string text) { tip = text; return this; }

    // 驱动开关态。
    void SetOn(bool state) { on = state; }

    // 设可用性。
    void SetEnabled(bool state) { enabled = state; }

    // 悬停气泡显示：标题，及下方命令功能的描述
    // （仅标题说明不了新信息）。
    string TipText() {
        if (tip != "") { return label + "\n" + tip; }
        return label;
    }
}
