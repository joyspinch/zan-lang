using System;
using Gui;

namespace Gui.Widget;

// 强类型表格单元格项：单元格文本内容与列宽绑定。
public class TableCellItem {
    public string text;
    public int width;

    public TableCellItem(string text, int width) {
        this.text = text != null ? text : "";
        this.width = width;
    }

    public static TableCellItem Of(string text, int width) {
        return new TableCellItem(text, width);
    }
}
