using System;
using Gui;
namespace Gui.Widget;
internal class LayerWindowPaint {
    bool visible;
    int x; int y; int w; int h; int radius; int bar; int unit; int glyph; int glyphX;
    int background; int titleBackground; int titleBorder; int titleBorderWidth; int accent;
    int shadowOuter; int shadowInner;
    int bodyX; int bodyY; int bodyColor; int bodyFont; int footerY; int footerColor;
    bool footer;
    string body = "";
    Control content;
    Rect clip;
    bool exiting;
    int alpha = 1000;
    string caption = "";
    int captionFont; int captionColor; int captionX;
    Control footerRoot;
    public void Prepare(App app, LayerState state, int px, int py, int pw, int ph, Rect bodyBounds) {
        visible = state.open; exiting = false; alpha = 1000; footerRoot = null;
        x = px; y = py; w = pw; h = ph;
        radius = app.theme.borderRadiusLarge; bar = Layer.BarH(app); unit = app.Scale(1);
        glyph = app.theme.iconSizeSmall; glyphX = app.Scale(14);
        StyleBox window = Control.BareBox(app, "layer", Style.SNormal());
        StyleBox title = Style.Part(app, "layer", "titlebar", "", "", "", Style.SNormal());
        background = window.bg; titleBackground = title.bg; titleBorder = title.borderBottomColor;
        titleBorderWidth = title.borderBottomW; accent = title.accent;
        shadowInner = Style.Part(app, "layer", "shadow", "", "", "", Style.SNormal()).BgOr(0);
        shadowOuter = ColorMath.ScaleAlpha(shadowInner, 667);
        body = state.state != 2 ? state.body : "";
        bodyX = x + app.Scale(20); bodyY = y + bar + app.Scale(16);
        StyleBox text = Style.Part(app, "layer", "body", "", "", "", Style.SNormal());
        bodyColor = text.fg; bodyFont = text.FontOr(Style.FontFallback(app, "medium"));
        content = state.state != 2 ? (state.wrap != null ? state.wrap : state.view) : null;
        clip = new Rect(bodyBounds.x, bodyBounds.y, bodyBounds.width, bodyBounds.height);
        footer = state.state != 2 && state.footer;
        footerY = y + h - Layer.FooterH(app);
        footerColor = Style.Part(app, "layer", "footer", "", "", "", Style.SNormal()).bg;
    }
    public void PrepareExit(App app, LayerState state) {
        List<int> bounds = new List<int>(); Layer.Bounds(app, state, bounds);
        Rect empty = new Rect(0, 0, 0, 0);
        this.Prepare(app, state, bounds[0], bounds[1], bounds[2], bounds[3], empty);
        exiting = true; visible = state.closing;
        int progress = Layer.ExitP(state); alpha = 1000 - progress;
        y = y - progress * app.Scale(10) / 1000;
        titleBackground = Layer.MulAlpha(titleBackground, alpha);
        titleBorder = Layer.MulAlpha(titleBorder, alpha); accent = Layer.MulAlpha(accent, alpha);
        if (titleBorderWidth <= 0) { titleBorderWidth = app.Scale(2); }
        bodyY = y + bar + app.Scale(16);
        caption = state.title; captionX = x + glyphX + glyph + app.theme.gapSmall;
        StyleBox title = Style.Part(app, "layer", "titlebar", "", "", "", Style.SNormal());
        captionFont = title.FontOr(Style.FontFallback(app, "medium")); captionColor = Layer.MulAlpha(title.fg, alpha);
        footerRoot = state.footer && state.state != 2 ? state.windowFooter : null;
    }
    public void Paint(App app) {
        if (!visible) { return; }
        Canvas canvas = app.canvas;
        if (exiting) {
            canvas.FillRoundRect(x - unit, y + unit * 6, w + unit * 2, h, radius + unit * 4, Layer.MulAlpha(shadowOuter, alpha));
        }
        canvas.FillRoundRect(x + unit, y + unit * 3, w - unit * 2, h, radius + unit * 2, Layer.MulAlpha(shadowInner, alpha));
        app.FillGlass(x, y, w, h, radius, background, alpha);
        canvas.FillRoundRect(x, y, w, bar, radius, titleBackground);
        canvas.FillRect(x, y + bar - radius, w, radius, titleBackground);
        canvas.FillRect(x, y + bar - titleBorderWidth, w, titleBorderWidth, titleBorder);
        canvas.DrawGlyph("grid", x + glyphX, y + (bar - glyph) / 2, glyph, accent);
        if (exiting) { canvas.DrawText(captionX, Canvas.CenterTextY(y, bar, captionFont), caption, captionColor, captionFont); }
        if (body != "") { canvas.DrawText(bodyX, bodyY, body, bodyColor, bodyFont); }
        if (w > 0 && h > 0) { NativeLayer.Occlude(app, x, y, w, h); }
        if (content != null) {
            if (!exiting) {
                canvas.PushClip(clip.x, clip.y, clip.width, clip.height);
                NativeLayer.PushClip(app, clip.x, clip.y, clip.width, clip.height);
            } else {
                NativeLayer.PushClip(app, 0, 0, 0, 0);
            }
            try {
                content.RenderTree(app);
            } finally {
                NativeLayer.PopClip(app);
                if (!exiting) { canvas.PopClip(); }
            }
        }
        if (footerRoot != null) { footerRoot.RenderTree(app); }
        if (footer && !exiting) { canvas.FillRect(x + 1, footerY, w - 2, 1, footerColor); }
    }
}
