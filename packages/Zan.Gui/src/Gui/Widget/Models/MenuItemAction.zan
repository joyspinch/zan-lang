using System;
using Gui;

namespace Gui.Widget;

// Retired menu rows cannot act on a later tree or retain their menu owner.
internal class MenuItemAction {
    private weak Menu owner;
    private MenuItem item;
    private string key;
    private bool group;
    private int generation;

    public MenuItemAction(Menu menu, MenuItem model, string itemKey, bool toggle) {
        owner = menu;
        item = model;
        key = itemKey;
        group = toggle;
        generation = menu.treeGeneration;
    }

    public void Invoke() {
        Menu menu = owner;
        if (menu == null || menu.treeGeneration != generation || item.disabled) { return; }
        if (group) {
            menu.expandState.Toggle(key);
            menu.BuildTree();
        } else {
            menu.SelectKey(key);
        }
    }
}
