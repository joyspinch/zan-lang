using Gui;

namespace Gui.Widget;

// Wizard owns its buttons; their Click handlers hold only this action (weak owner) to avoid a cycle.
public class WizardAction {
    public weak Wizard owner;
    public int op; // 0 prev, 1 next, 2 finish

    public WizardAction(Wizard wizard, int operation) {
        owner = wizard;
        op = operation;
    }

    public void Invoke() {
        Wizard wizard = owner;
        if (wizard == null) { return; }
        if (op == 0) { wizard.Prev(); }
        else if (op == 1) { wizard.Next(); }
        else { wizard.OnFinish(); }
    }
}
