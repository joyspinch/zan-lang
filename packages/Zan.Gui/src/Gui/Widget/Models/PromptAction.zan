using Gui;

namespace Gui.Widget;

// Prompt owns its buttons; their Click handlers hold only this action (weak owner) to avoid a cycle.
public class PromptAction {
    public weak Prompt owner;
    public bool submit;

    public PromptAction(Prompt prompt, bool isSubmit) {
        owner = prompt;
        submit = isSubmit;
    }

    public void Invoke() {
        Prompt prompt = owner;
        if (prompt == null) { return; }
        if (submit) { prompt.Submit.Raise(prompt); }
        else { prompt.Cancel.Raise(prompt); }
    }
}
