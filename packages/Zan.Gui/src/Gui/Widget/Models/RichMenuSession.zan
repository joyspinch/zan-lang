using Gui;

namespace Gui.Widget;

// Registration retains the participant, never the popup or its business owner.
public class RichMenuSession : AppLoopParticipant, AppPreparationParticipant {
    public weak RichMenu owner;
    public int session;
    public void Tick(App app, int now) {
        RichMenu menu = owner;
        if (menu != null) { menu.Tick(app, now, session); }
    }
    public int NextDeadline() {
        RichMenu menu = owner;
        return menu != null ? menu.NextDeadline(session) : -1;
    }
    public void BeforeInput(App app, int kind) { this.Prepare(app); }
    public void BeforePaint(App app, int frameSequence) { this.Prepare(app); }
    void Prepare(App app) {
        RichMenu menu = owner;
        if (menu != null && menu.IsOpen() && menu.Session() == session && menu.FindApp() == app) {
            menu.Prepare(app);
        }
    }
}
