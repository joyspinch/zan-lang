namespace Gui.Widget;

public class DialogAction {
    public weak Modal modal;
    public weak Drawer drawer;

    public void CloseModal() { Modal owner = modal; if (owner != null) { owner.Hide(); } }
    public void CancelModal() { Modal owner = modal; if (owner != null) { owner.Cancel.Raise(); owner.Hide(); } }
    public void AcceptModal() { Modal owner = modal; if (owner != null) { owner.Ok.Raise(); } }
    public void CloseDrawer() { Drawer owner = drawer; if (owner != null) { owner.Hide(); } }
}
