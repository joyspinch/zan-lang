using System;
using Gui;
namespace Gui.Widget;
public class FormRow : Panel {
    // 按父类种类上报：序列化与自动化以 "Panel" 识别本控件。
    public override string Kind() { return "Panel"; }
    public Control field;
    public Label label;
    public Label help;
    public Label err;
    public List<FormRule> rules;
    public string placement;
    public int labelWidth;
    public bool isRequired;
    private string origCaption;
    private Column rightBox;
    public FormRow(string caption, Control ctl) {
        this.InitPanel("formrow", 3);
        this.gap = 4;
        field = ctl;
        rules = new List<FormRule>();
        origCaption = caption;
        placement = "top";
        labelWidth = 80;
        isRequired = false;
        if (caption != "") { label = new Label(caption); }
        err = new Label("");
        err.Class = "error";
        err.SetShown(false);
        this.RebuildChildren();
    }
    public virtual void RebuildChildren() {
        this.RemoveAll();
        if (placement == "left") {
            this.layout = 2;
            if (label != null) {
                label.Prefer(labelWidth, 28);
                base.Add(label);
            }
            rightBox = new Column { Gap = 4 };
            if (field != null) { rightBox.Add(field); }
            if (help != null && help.Text.Get() != "") { rightBox.Add(help); }
            rightBox.Add(err);
            base.Add(rightBox);
        } else {
            this.layout = 1;
            if (label != null) { base.Add(label); }
            if (field != null) { base.Add(field); }
            if (help != null && help.Text.Get() != "") { base.Add(help); }
            base.Add(err);
        }
    }
    public string CaptionText {
        get { return this.origCaption; }
        set { this.Caption(value); }
    }
    public Control FieldControl {
        get { return this.field; }
        set { this.SetControl(value); }
    }
    public string LabelPlacement {
        get { return this.placement; }
        set { this.Placement(value); }
    }
    public int LabelWidthPx {
        get { return this.labelWidth; }
        set { this.LabelWidth(value); }
    }
    public string HelpText {
        get { return this.help != null ? this.help.GetText() : ""; }
        set { this.Help(value); }
    }

    // 设置或更新标签标题
    public FormRow Caption(string caption) {
        origCaption = caption;
        if (caption != "") {
            if (label == null) {
                label = new Label(caption);
            } else {
                label.Text = caption;
            }
        } else {
            label = null;
        }
        this.RebuildChildren();
        return this;
    }
    public void SetControl(Control ctl) {
        field = ctl;
        this.RebuildChildren();
    }
    public virtual void Placement(string p) {
        placement = p;
        this.RebuildChildren();
    }
    public virtual void LabelWidth(int w) {
        labelWidth = w;
        if (label != null && placement == "left") { label.Prefer(labelWidth, 28); }
    }
    public virtual void Required(string msg) {
        isRequired = true;
        this.Rule(FormRule.Required(msg));
        if (label != null && !label.GetText().StartsWith("*")) {
            label.Text = "* " + origCaption;
            label.Class = "required";
        }
    }
    public virtual void Help(string text) {
        if (help == null) {
            help = new Label(text);
            help.Muted();
        } else {
            help.Text = text;
        }
        this.RebuildChildren();
    }
    public string Name() {
        if (field == null) { return ""; }
        return field.name;
    }
    public string Value() { return FormGroup.ValueOf(field); }
    public virtual void Rule(FormRule r) { rules.Add(r); }
    public bool Active() {
        if (field == null) { return false; }
        return field.StyleVisible() && !field.IsDisabled();
    }
    string ValidationValue() {
        if (field is SelectBox && !((SelectBox)field).HasValue()) { return ""; }
        return this.Value();
    }
    public string Check() {
        if (!this.Active()) { this.Clear(); return ""; }
        string v = this.ValidationValue();
        for (int i = 0; i < rules.Count; i = i + 1) {
            string msg = rules[i].Apply(v);
            if (msg != "") {
                this.Paint(msg);
                return msg;
            }
        }
        this.Clear();
        return "";
    }
    public string Peek() {
        if (!this.Active()) { return ""; }
        string v = this.ValidationValue();
        for (int i = 0; i < rules.Count; i = i + 1) {
            string msg = rules[i].Apply(v);
            if (msg != "") { return msg; }
        }
        return "";
    }
    public void Clear() {
        if (field != null && field is Input) { ((Input)field).ClearError(); }
        err.SetShown(false);
    }
    public void Paint(string msg) {
        if (field != null && field is Input) {
            ((Input)field).SetError(msg);
            err.Text = "";
            err.SetShown(true);
            return;
        }
        err.Text = msg;
        err.SetShown(true);
    }
}
