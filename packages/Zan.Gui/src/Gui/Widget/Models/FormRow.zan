using System;
using Gui;

namespace Gui.Widget;

// 表单里的一行：标题（可选）+ 字段控件 + 错误消息行，竖直排布。
// 错误画法分两类：Input 自带 SetError（红框 + 字段下小字，编辑即
// 清除），直接用它；其余控件（TextArea / SelectBox / Switch /
// Checkbox / 自定义控件）没有错误态，由行内的 `label.error` 承担。
// 两种画法的消息都落在字段正下方，视觉一致。
public class FormRow : Panel {
    public Control field;
    public Label label;
    public Label help;
    public Label err;
    public List<FormRule> rules;
    public string placement;
    public int labelWidth;
    public bool isRequired;
    string origCaption;
    Column rightBox;

    // 构造一行：标题（可为 ""）+ 字段控件 + 隐藏的错误消息行
    FormRow(string caption, Control ctl) {
        this.InitPanel("formrow", 3);
        this.layout = 1;
        this.logGap = 4;
        field = ctl;
        rules = new List<FormRule>();
        origCaption = caption;
        placement = "top";
        labelWidth = 80;
        isRequired = false;
        
        if (caption != "") {
            label = new Label(caption);
        }
        err = new Label("");
        err.Class = "error";
        err.SetShown(false);
        this.RebuildChildren();
    }

    void RebuildChildren() {
        this.RemoveAll();
        if (placement == "left") {
            this.layout = 2;
            if (label != null) {
                label.Prefer(labelWidth, 28);
                this.Children.Add(label);
            }
            rightBox = Column.Create().Gap(4);
            if (field != null) { rightBox.Child(field); }
            if (help != null && help.Text != "") { rightBox.Child(help); }
            rightBox.Child(err);
            this.Children.Add(rightBox);
        } else {
            this.layout = 1;
            if (label != null) { this.Children.Add(label); }
            if (field != null) { this.Children.Add(field); }
            if (help != null && help.Text != "") { this.Children.Add(help); }
            this.Children.Add(err);
        }
    }

    // 设置或更新标签标题
    FormRow Caption(string caption) {
        origCaption = caption;
        if (caption != "") {
            if (label == null) {
                label = new Label(caption);
            } else {
                label.Text = caption;
            }
        } else {
            label = null;
        }
        this.RebuildChildren();
        return this;
    }

    // 设置或替换内部绑定的字段控件
    FormRow SetControl(Control ctl) {
        field = ctl;
        this.RebuildChildren();
        return this;
    }

    // 设置标签摆放方位："top" (上下堆叠) 或 "left" (左对齐)
    FormRow Placement(string p) {
        placement = p;
        this.RebuildChildren();
        return this;
    }

    // 设置左对齐时标签的固定宽度（像素）
    FormRow LabelWidth(int w) {
        labelWidth = w;
        if (label != null && placement == "left") {
            label.Prefer(labelWidth, 28);
        }
        return this;
    }

    // 快捷声明必填规则，并自动标记必填星号
    FormRow Required(string msg) {
        isRequired = true;
        this.Rule(FormRule.Required(msg));
        if (label != null && !label.GetText().StartsWith("*")) {
            label.Text = "* " + origCaption;
            label.Class = "required";
        }
        return this;
    }

    // 设置字段下方的辅助说明文案
    FormRow Help(string text) {
        if (help == null) {
            help = new Label(text).Muted();
        } else {
            help.Text = text;
        }
        this.RebuildChildren();
        return this;
    }

    // 字段控件名（FormGroup.Field 的查找键）。
    string Name() {
        if (field == null) { return ""; }
        return field.name;
    }

    // 字段当前值（FormGroup.ValueOf 的类型聚合视图）。
    string Value() {
        return FormGroup.ValueOf(field);
    }

    // 追加一条规则（链式）：`form.Add("邮箱", email)
    // .Rule(FormRule.Required("必填")).Rule(FormRule.Email("格式不对"))`。
    FormRow Rule(FormRule r) {
        rules.Add(r);
        return this;
    }

    // 该行是否参与校验：被联动隐藏或禁用的字段不算错误——依赖
    // 表单里「选了配送才出现的地址」在自提时不应阻塞提交。
    bool Active() {
        if (field == null) { return false; }
        return field.StyleVisible() && !field.IsDisabled();
    }

    // 运行全部规则并就地绘制状态；返回第一条错误消息（"" = 通过）。
    string Check() {
        if (!this.Active()) { this.Clear(); return ""; }
        string v = this.Value();
        for (int i = 0; i < rules.Count; i = i + 1) {
            string msg = rules[i].Apply(v);
            if (msg != "") {
                this.Paint(msg);
                return msg;
            }
        }
        this.Clear();
        return "";
    }

    // 静默检查：不改任何显示状态，返回第一条错误消息。
    string Peek() {
        if (!this.Active()) { return ""; }
        string v = this.Value();
        for (int i = 0; i < rules.Count; i = i + 1) {
            string msg = rules[i].Apply(v);
            if (msg != "") { return msg; }
        }
        return "";
    }

    // 清除该行的错误显示。
    void Clear() {
        if (field != null && field is Input) { ((Input)field).ClearError(); }
        err.SetShown(false);
    }

    // 显示一条错误消息。Input 自带错误态（红框 + 字段下消息），但
    // 那条消息画在自身矩形之外（y+h+2 处），行式布局里正好落在下一
    // 行的背景之下会被整条盖掉——留一个空的错误标签占住这一行，
    // 消息就画在预留出的空间里。
    void Paint(string msg) {
        if (field != null && field is Input) {
            ((Input)field).SetError(msg);
            err.Text = "";
            err.SetShown(true);
            return;
        }
        err.Text = msg;
        err.SetShown(true);
    }
}
