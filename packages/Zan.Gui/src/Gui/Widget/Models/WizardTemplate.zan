using System;
using Gui;

namespace Gui.Widget;

// 分类项目向导的模板条目：一个 WizardItem 加上其所属的
// 分类列，以及向导右侧预览所需的形态信息。
// 尺寸不再是分类里的独立模板：产出设计窗口的模板把
// `sizeable` 置为 true，向导据此显示设备尺寸行，宿主用所选
// 尺寸创建项目——手机 / 平板 / 手表只是同一个模板的目标尺寸。
public class WizardTemplate {
    public string cat;
    public string name;
    public string icon;
    public string desc;
    // 该模板产出一个可按设备尺寸创建的设计窗口。
    public bool sizeable;
    // 默认设计尺寸（sizeable 时用于预览与创建）。
    public int defW;
    public int defH;
    // 圆形设计区（智能手表表盘）。
    public bool round;
    // 真实截图的绝对路径，为空时按 `sketch` 画线框。
    public string preview;
    // 线框骨架：逗号分隔的记号，见 Wizard.RenderSketch
    // server / library）。
    public string sketch;
    // 模板声明的目标设备画像 id（manifest `device=`，见
    // DeviceProfile）。空串 = 自由尺寸（桌面），向导的目标
    // 设备行预选桌面并放开分辨率预设与自定义宽高。
    public string deviceId;
    // 模板声明的能力标签（manifest `caps=`，逗号分隔：
    // gui / network / crypto / game / audio / db …）。空串 =
    // 未声明；向导在描述下方原样展示，创建者据此一眼看出
    // 这个模板产出的项目会用到哪些生态面。
    public string caps;
    // 模板声明的支持平台（manifest `platforms=`，OS 前缀逗号
    // 分隔：windows / macos / linux / android / ohos）。空串 =
    // 不限；向导在能力行下方展示，创建者选中模板的当下就
    // 知道它能否跑在所选目标上（CreateProjectT 按它拦截）。
    public string plats;

    // 构造：分类/名称/图标/描述必填，形态与预览信息经
    // Shape/Look 链式补齐。
    WizardTemplate(string c, string n, string ic, string d) {
        cat = c;
        name = n;
        icon = ic;
        desc = d;
        sizeable = false;
        defW = 0;
        defH = 0;
        round = false;
        preview = "";
        sketch = "";
        deviceId = "";
        caps = "";
        plats = "";
    }

    // 链式配置形态信息，让宿主只描述它从清单里读到的内容。
    WizardTemplate Shape(bool canSize, int w, int h, bool isRound) {
        sizeable = canSize;
        defW = w;
        defH = h;
        round = isRound;
        return this;
    }

    // 预览来源：真实截图路径（可为空）与线框记号。
    WizardTemplate Look(string previewPath, string sketchSpec) {
        preview = previewPath;
        sketch = sketchSpec;
        return this;
    }

    // 声明目标设备画像 id（manifest `device=`）。
    WizardTemplate Device(string id) {
        deviceId = id;
        return this;
    }

    // 声明能力标签（manifest `caps=`，逗号分隔原样展示）。
    WizardTemplate Caps(string spec) {
        caps = spec;
        return this;
    }

    // 声明支持平台（manifest `platforms=`，原样展示）。
    WizardTemplate Plats(string spec) {
        plats = spec;
        return this;
    }
}
