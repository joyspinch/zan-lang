using System;
using Gui;
using Gui.Backend;

namespace Gui.Widget;

// 每轮播图一个过渡状态，独立成对象，使每帧重建
// 控件的宿主仍能持有进行中的动画。经 `Carousel.Animate(state)`
// 传入；要 autoplay 的宿主必须传入同一实例（tickMs 也在里面）。
public class CarouselAnim {
    // 已稳定显示的页（过渡完成后的落点）。
    public int shown;
    // 过渡的离开页。
    public int from;
    // 过渡起始帧号（app.frameCount）。
    public int startFrame;
    // 过渡进行中。
    public bool animating;
    // 滑动方向：1 = 翻到下一页，-1 = 上一页。
    public int dir;
    // autoplay 的挂钟：宿主每帧重建控件时实例字段会归零，
    // 计时永远走不完；跟着 anim 一样由宿主持有才能跨帧存活。
    public int tickMs;

    // 初始化：过渡状态全部清零（dir=1 朝下一页）。
    CarouselAnim() {
        this.shown = 0;
        this.from = 0;
        this.startFrame = 0;
        this.animating = false;
        this.dir = 1;
        this.tickMs = 0;
    }
}
