using System;
using Gui;
namespace Gui.Widget;
public class CarouselAnim {
    public int shown;
    public int from;
    public int startMs;
    public bool animating;
    public int dir;
    public int tickMs;
    public CarouselAnim() {
        this.shown = 0;
        this.from = 0;
        this.startMs = 0;
        this.animating = false;
        this.dir = 1;
        this.tickMs = 0;
    }
}
