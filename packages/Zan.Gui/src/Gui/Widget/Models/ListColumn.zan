using System;
using Gui;
using Gui.Backend;

namespace Gui.Widget;

// ListView 的一列：表头显示什么、宽度相对其他列
// 如何（0 = 均分），以及如何从实体读取其文本。
class ListColumn<T> {
    // 表头文本。
    public string title;
    // 相对宽度权重（0 = 均分）。
    public int weight;
    // 文本右对齐（数字、大小、日期）。
    public bool right;
    // 从行实体取单元格文本的回调。
    public CellOf<T> cell;

    // 构造均分宽度的一列。
    ListColumn(string title, CellOf<T> cell) {
        this.title = title;
        this.weight = 0;
        this.right = false;
        this.cell = cell;
    }

    // 构造指定相对宽度的一列。
    ListColumn(string title, int weight, CellOf<T> cell) {
        this.title = title;
        this.weight = weight;
        this.right = false;
        this.cell = cell;
    }

    // 让本列文本右对齐（数字、大小、日期）。
    ListColumn<T> Right() {
        right = true;
        return this;
    }

    // 读取该行实体在本列的文本；无 cell 回调时为空串。
    string TextOf(T item) {
        if (cell == null) { return ""; }
        return cell(item);
    }
}
