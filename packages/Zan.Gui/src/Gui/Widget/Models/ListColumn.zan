using System;
using Gui;
using Gui.Backend;

namespace Gui.Widget;

// ListView 的一列：表头显示什么、宽度相对其他列
// 如何（0 = 均分），以及如何从实体读取其文本。
public class ListColumn<T> {
    // 表头文本。
    public string title;
    // 相对宽度权重（0 = 均分）。
    public int weight;
    // 文本右对齐（数字、大小、日期）。
    public bool right;
    // 从行实体取单元格文本的回调。
    public CellOf<T> cell;
    // 从行实体生成单元格自定义控件的插槽回调（非 null 时优先使用控件渲染）。
    public CellSlotOf<T> slot;

    // 构造均分宽度的文本列。
    ListColumn(string title, CellOf<T> cell) {
        this.title = title;
        this.weight = 0;
        this.right = false;
        this.cell = cell;
        this.slot = null;
    }

    // 构造指定相对宽度的文本列。
    ListColumn(string title, int weight, CellOf<T> cell) {
        this.title = title;
        this.weight = weight;
        this.right = false;
        this.cell = cell;
        this.slot = null;
    }

    // 工厂方法：构造均分宽度的组件插槽列。
    static ListColumn<T> Slot(string title, CellSlotOf<T> slot) {
        ListColumn<T> c = new ListColumn<T>(title, null);
        c.slot = slot;
        return c;
    }

    // 工厂方法：构造指定相对宽度的组件插槽列。
    static ListColumn<T> SlotWithWeight(string title, int weight, CellSlotOf<T> slot) {
        ListColumn<T> c = new ListColumn<T>(title, weight, null);
        c.slot = slot;
        return c;
    }

    // 让本列文本右对齐（数字、大小、日期）。
    ListColumn<T> Right() {
        right = true;
        return this;
    }

    // 读取该行实体在本列的文本；无 cell 回调时为空串。
    string TextOf(T item) {
        if (cell == null) { return ""; }
        return cell(item);
    }
}
