using System;
using Gui;
using Gui.Backend;

namespace Gui.Widget;

// 跑马灯的滚动相位，独立成对象，使每帧重建控件的宿主仍能
// 持有进行中的滚动（同 CarouselAnim 的角色）。
public class MarqueeAnim {
    // 滚动相位（像素，对循环宽取模）。
    public int phase;
    // 上次推进时刻（毫秒时钟）。
    public int lastMs;

    // 构造：相位与时刻归零。
    MarqueeAnim() {
        this.phase = 0;
        this.lastMs = 0;
    }
}
