using Gui;
using System;

namespace Gui.Widget;

public class RibbonCmd {
    public string icon;
    public string label;
    public bool sep;
    public bool enabled;
    public bool compact;
    public bool on;
    public string tip;
    public int act;
    public RibbonCmd(string icon, string label) {
        this.icon = icon;
        this.label = label;
        this.sep = false;
        this.enabled = true;
        this.compact = false;
        this.on = false;
        this.tip = "";
    }
    public void SetTip(string text) { tip = text; }
    public string TipText() {
        if (tip != "") { return label + "\n" + tip; }
        return label;
    }
    public static RibbonCmd Switch(string icon, string label, bool on) {
        RibbonCmd r = new RibbonCmd(icon, label);
        r.compact = true;
        r.on = on;
        return r;
    }
    public void SetOn(bool state) { on = state; }
    public static RibbonCmd Group(string icon, string label) {
        RibbonCmd r = new RibbonCmd(icon, label);
        r.sep = true;
        return r;
    }
    public void SetEnabled(bool on) { enabled = on; }
}

public class RibbonFit {
    public List<bool> compact;
    public List<bool> dropped;
    List<int> widths = new List<int>();
    List<int> tileWidths = new List<int>();
    int overflowWidth;
    RibbonFit() {
        this.compact = new List<bool>();
        this.dropped = new List<bool>();
    }
}

public class RibbonGroup {
    public string title;
    public List<RibbonItem> items;
    public RibbonGroup(string title) {
        this.title = title;
        this.items = new List<RibbonItem>();
    }
    public static RibbonGroup Of(string title, List<RibbonItem> items) {
        RibbonGroup g = new RibbonGroup(title);
        g.items = items;
        return g;
    }
    public void Add(RibbonItem it) { items.Add(it); }
}

public class RibbonItem {
    public string icon;
    public string label;
    public bool small;
    public bool tile;
    public bool menu;
    public bool enabled;
    public bool optional;
    public bool toggle;
    public bool on;
    public string tip;
    public int act;
    public static RibbonItem Large(string icon, string label) {
        RibbonItem r = new RibbonItem();
        r.icon = icon;
        r.label = label;
        r.small = false;
        r.tile = false;
        r.menu = false;
        r.enabled = true;
        r.optional = false;
        r.toggle = false;
        r.on = false;
        r.tip = "";
        return r;
    }
    public static RibbonItem Small(string icon, string label) {
        RibbonItem r = RibbonItem.Large(icon, label);
        r.small = true;
        return r;
    }
    public static RibbonItem Toggle(string icon, string label, bool on) {
        RibbonItem r = RibbonItem.Small(icon, label);
        r.toggle = true;
        r.on = on;
        return r;
    }
    public static RibbonItem Tile(string icon, string label) {
        RibbonItem r = RibbonItem.Large(icon, label);
        r.small = true;
        r.tile = true;
        return r;
    }
    public void SetMenu() { menu = true; }
    public void Disable() { enabled = false; }
    public void SetOptional() { optional = true; }
    public void SetTip(string text) { tip = text; }
    public void SetOn(bool state) { on = state; }
    public void SetEnabled(bool state) { enabled = state; }
    public string TipText() {
        if (tip != "") { return label + "\n" + tip; }
        return label;
    }
}

public class RibbonGroupBox {
    public int group;
    public int startX;
    public int endX;
    RibbonGroupBox() {
        this.group = 0;
        this.startX = 0;
        this.endX = 0;
    }
}
public class RibbonLayout {
    public List<RibbonSlot> slots;
    public List<RibbonGroupBox> boxes;
    public int width;
    RibbonLayout() {
        this.slots = new List<RibbonSlot>();
        this.boxes = new List<RibbonGroupBox>();
        this.width = 0;
    }
}

public class RibbonSlot {
    public int flat;
    public int group;
    public int item;
    public RibbonItem cmd;
    public int kind;
    public int x;
    public int y;
    public int w;
    public int h;
    public bool overflow;
    RibbonSlot() {
        this.flat = 0;
        this.group = 0;
        this.item = 0;
        this.cmd = null;
        this.kind = 0;
        this.x = 0;
        this.y = 0;
        this.w = 0;
        this.h = 0;
        this.overflow = false;
    }
}
