namespace Gui.Widget;
public class RateAction {
    public weak Rate owner;
    private int index;
    public RateAction(Rate rate, int starIndex) {
        owner = rate;
        index = starIndex;
    }
    public void Click() {
        Rate rate = owner;
        if (rate == null) { return; }
        rate.OnStarClick(index);
    }
}
