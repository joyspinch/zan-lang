using System;
using System.Collections.Generic;
using Gui;
namespace Gui.Widget;
[GuiKind("Pagination")]
public class Pagination : Control {
    public override Control CreateCloneShell() { return new Pagination(); }
    public Binding<int> Page;
    public int totalPages;
    public UiEvent Change;
    public UiEvent SizeChange;
    public bool useItemCount;
    public int itemCount;
    public int pageSize;
    public List<int> pageSizes;
    public int sizeIdx;
    public bool sizeOpen;
    public string prefixText;
    public string suffixText;
    public string prevText;
    public string nextText;
    public bool showTotal;
    public bool jumper;
    public string jumperLabel;
    public string jumperSuffix;
    public List<string> order;
    public int pagerCount;
    private int lastBuiltPage;
    private int lastBuiltTotal;
    private bool needsRebuild;
    public override int StyleDisplay() { return 1; } // Flex
    public override int StyleFlexDir() { return 0; } // Row
    private void InitPagination(int total, Binding<int> page) {
        this.InitControl("pagination");
        this.ClassName = "pagination row align-center gap-small";
        totalPages = total;
        if (totalPages < 1) { totalPages = 1; }
        Page = 1;
        if (page != null) { Page = page; }
        wiresOwnEvents = false;
        Change = new UiEvent();
        SizeChange = new UiEvent();
        useItemCount = false;
        itemCount = 0;
        pageSize = 10;
        pageSizes = new List<int>();
        sizeIdx = 0 - 1;
        sizeOpen = false;
        prefixText = "";
        suffixText = "";
        prevText = "";
        nextText = "";
        showTotal = false;
        jumper = false;
        jumperLabel = "";
        jumperSuffix = "";
        order = null;
        pagerCount = 7;
        lastBuiltPage = 0 - 1;
        lastBuiltTotal = 0 - 1;
        needsRebuild = true;
        this.BuildTree();
    }
    public Pagination() : this(1) { }
    public Pagination(int total) { InitPagination(total, 1); }
    public Pagination(int total, Binding<int> page) { InitPagination(total, page); }
    public static Pagination Of(int total, Binding<int> page) { return new Pagination(total, page); }
    public static Pagination WithCount(int items, int size, Binding<int> page) { return new Pagination(items, size, page); }
    public Pagination(int items, int size, Binding<int> page) {
        InitPagination(1, page);
        useItemCount = true;
        itemCount = items;
        this.SetPageSize(size);
    }
    public int TotalPageCount {
        get { return this.TotalPages(); }
        set { this.SetTotal(value); }
    }
    public int TotalItemCount {
        get { return itemCount; }
        set { this.SetItemCount(value); }
    }
    public int PageSizeValue {
        get { return pageSize; }
        set { this.SetPageSize(value); }
    }
    public List<int> PageSizeOptions {
        get { return pageSizes; }
        set { this.SetPageSizes(value); }
    }
    public bool ShowQuickJumper {
        get { return jumper; }
        set { this.Jumper(value); }
    }
    public bool ShowTotalText {
        get { return showTotal; }
        set { this.ShowTotal(value); }
    }
    public int PagerButtonCount {
        get { return pagerCount; }
        set { this.SetPagerCount(value); }
    }
    public void SetTotal(int total) {
        useItemCount = false;
        totalPages = total;
        if (totalPages < 1) { totalPages = 1; }
        this.Normalize();
    }
    public int TotalPages() {
        if (useItemCount) {
            int sz = pageSize;
            if (sz < 1) { sz = 1; }
            int n = (itemCount + sz - 1) / sz;
            if (n < 1) { n = 1; }
            return n;
        }
        return totalPages;
    }
    public int Total() { return this.TotalPages(); }
    public void SetItemCount(int items) {
        useItemCount = true;
        itemCount = items;
        this.Normalize();
    }
    public int ItemCount() { return itemCount; }
    public bool UsesItemCount() { return useItemCount; }
    public void SetPageSize(int size) {
        if (size < 1) { size = 1; }
        pageSize = size;
        sizeIdx = 0 - 1;
        for (int i = 0; i < pageSizes.Count; i = i + 1) {
            if (pageSizes[i] == size) { sizeIdx = i; }
        }
        this.Normalize();
    }
    public int PageSize() { return pageSize; }
    public void SetPageSizes(List<int> sizes) {
        pageSizes = sizes;
        if (pageSizes == null) { pageSizes = new List<int>(); }
        sizeIdx = 0 - 1;
        for (int i = 0; i < pageSizes.Count; i = i + 1) {
            if (pageSizes[i] == pageSize) { sizeIdx = i; }
        }
        needsRebuild = true;
        this.BuildTree();
    }
    public List<int> PageSizes() { return pageSizes; }
    public void SetPageSizesText(string text) {
        List<int> r = new List<int>();
        int i = 0;
        while (i < text.Length) {
            int comma = text.IndexOf(",", i);
            string seg = "";
            if (comma < 0) { seg = text.Substring(i); i = text.Length; }
            else { seg = text.Substring(i, comma - i); i = comma + 1; }
            seg = seg.Trim();
            if (seg.Length == 0) { continue; }
            bool digits = true;
            for (int k = 0; k < seg.Length; k = k + 1) {
                if (seg[k] < 48 || seg[k] > 57) { digits = false; }
            }
            if (!digits) { continue; }
            int v = Convert.ToInt32(seg);
            if (v > 0) { r.Add(v); }
        }
        this.SetPageSizes(r);
    }
    public string PageSizesText() {
        string acc = "";
        for (int i = 0; i < pageSizes.Count; i = i + 1) {
            if (i > 0) { acc = acc + ", "; }
            acc = acc + Convert.ToString(pageSizes[i]);
        }
        return acc;
    }
    public void Jumper(bool v) { jumper = v; needsRebuild = true; this.BuildTree(); }
    public bool HasJumper() { return jumper; }
    public void OpenSizes() { sizeOpen = true; }
    public void CloseSizes() { sizeOpen = false; }
    public bool SizesOpen() { return sizeOpen; }
    public void ShowSizes(bool v) {
        if (v && pageSizes.Count == 0) {
            pageSizes.Add(10);
            pageSizes.Add(20);
            pageSizes.Add(50);
            pageSizes.Add(100);
            sizeIdx = 0 - 1;
            for (int i = 0; i < pageSizes.Count; i = i + 1) {
                if (pageSizes[i] == pageSize) { sizeIdx = i; }
            }
        }
        needsRebuild = true;
        this.BuildTree();
    }
    public bool HasSizes() { return pageSizes.Count > 0; }
    public void Prefix(string t) { prefixText = t; needsRebuild = true; this.BuildTree(); }
    public void Suffix(string t) { suffixText = t; needsRebuild = true; this.BuildTree(); }
    public void PrevText(string t) { prevText = t; needsRebuild = true; this.BuildTree(); }
    public void NextText(string t) { nextText = t; needsRebuild = true; this.BuildTree(); }
    public void ShowTotal(bool v) { showTotal = v; needsRebuild = true; this.BuildTree(); }
    public void JumperLabel(string t) { jumperLabel = t; needsRebuild = true; this.BuildTree(); }
    public void JumperSuffix(string t) { jumperSuffix = t; needsRebuild = true; this.BuildTree(); }
    public void SetPagerCount(int n) {
        if (n < 5) { n = 5; }
        if (n > 21) { n = 21; }
        if (n % 2 == 0) { n = n - 1; }
        pagerCount = n;
        needsRebuild = true;
        this.BuildTree();
    }
    public int PagerCount() { return pagerCount; }
    public List<string> EffOrder() {
        List<string> r = new List<string>();
        if (order != null) {
            for (int i = 0; i < order.Count; i = i + 1) { r.Add(order[i]); }
            bool hasPager = false;
            for (int i = 0; i < r.Count; i = i + 1) {
                if (r[i] == "pager") { hasPager = true; }
            }
            if (!hasPager) { r.Add("pager"); }
            return r;
        }
        if (prefixText != "") { r.Add("prefix"); }
        if (showTotal) { r.Add("total"); }
        r.Add("pager");
        if (suffixText != "") { r.Add("suffix"); }
        if (jumper) { r.Add("jumper"); }
        if (pageSizes.Count > 0) { r.Add("sizes"); }
        return r;
    }
    public void SetOrderText(string text) {
        List<string> r = new List<string>();
        int i = 0;
        while (i < text.Length) {
            int comma = text.IndexOf(",", i);
            string seg = "";
            if (comma < 0) { seg = text.Substring(i); i = text.Length; }
            else { seg = text.Substring(i, comma - i); i = comma + 1; }
            seg = seg.Trim().ToLower();
            if (seg == "prefix" || seg == "total" || seg == "pager"
            || seg == "suffix" || seg == "jumper" || seg == "sizes") {
                r.Add(seg);
            }
        }
        if (r.Count == 0) { order = null; return; }
        order = r;
        needsRebuild = true;
        this.BuildTree();
    }
    public string OrderText() {
        List<string> eff = this.EffOrder();
        string acc = "";
        for (int i = 0; i < eff.Count; i = i + 1) {
            if (i > 0) { acc = acc + ", "; }
            acc = acc + eff[i];
        }
        return acc;
    }
    public int EllipsisStep() { return pagerCount - 2; }
    public static List<int> BuildPages(int totalPages, int current) {
        return Pagination.BuildPagesSlots(totalPages, current, 7);
    }
    public static List<int> BuildPagesSlots(int totalPages, int current, int slots) {
        List<int> r = new List<int>();
        if (totalPages < 1) { totalPages = 1; }
        if (current < 1) { current = 1; }
        if (current > totalPages) { current = totalPages; }
        if (totalPages <= slots) {
            int i = 1;
            while (i <= totalPages) { r.Add(i); i = i + 1; }
            return r;
        }
        int half = (slots - 1) / 2;
        bool prevMore = current > slots - 2;
        bool nextMore = current < totalPages - slots + 3;
        if (prevMore && !nextMore) {
            int start = totalPages - (slots - 2);
            int p = start;
            while (p < totalPages) { r.Add(p); p = p + 1; }
        } else if (!prevMore && nextMore) {
            int p = 2;
            while (p < slots) { r.Add(p); p = p + 1; }
        } else if (prevMore && nextMore) {
            int off = half - 1;
            int p = current - off;
            while (p <= current + off) { r.Add(p); p = p + 1; }
        } else {
            int p = 2;
            while (p < totalPages) { r.Add(p); p = p + 1; }
        }
        List<int> full = new List<int>();
        full.Add(1);
        if (prevMore) { full.Add(0); }
        for (int i = 0; i < r.Count; i = i + 1) { full.Add(r[i]); }
        if (nextMore) { full.Add(0); }
        full.Add(totalPages);
        return full;
    }
    public int CurrentPage() { return Page.Get(); }
    public void SetPage(int p) { this.GoTo(p); }
    public void Normalize() {
        int tot = this.TotalPages();
        int cur = Page.Get();
        if (cur < 1) { Page.Set(1); }
        else if (cur > tot) { Page.Set(tot); }
        needsRebuild = true;
        this.BuildTree();
    }
    public void GoTo(int target) {
        if (target < 1) { target = 1; }
        int total = this.TotalPages();
        if (target > total) { target = total; }
        int cur = this.CurrentPage();
        if (target == cur) { return; }
        Page.Set(target);
        needsRebuild = true;
        this.BuildTree();
        Change.RaiseS(this);
        App a = this.FindApp();
        if (a != null && a.window != null) { a.window.Wake(); }
    }
    public string TotalText() { return "共 " + Convert.ToString(this.TotalPages()) + " 页"; }
    public string JumperLabelText() {
        if (jumperLabel != "") { return jumperLabel; }
        return "跳至";
    }
    public string SizeText(int n) { return Convert.ToString(n) + " / 页"; }
    public void BuildTree() {
        this.RemoveAll();
        int cur = this.CurrentPage();
        int tot = this.TotalPages();
        List<string> segs = this.EffOrder();
        for (int i = 0; i < segs.Count; i = i + 1) {
            string seg = segs[i];
            if (seg == "prefix" && prefixText != "") {
                Label lbl = new Label(prefixText);
                lbl.ClassName = "pagination-prefix";
                this.Add(lbl);
            } else if (seg == "total" && showTotal) {
                Label lbl = new Label(this.TotalText());
                lbl.ClassName = "pagination-total text-muted";
                this.Add(lbl);
            } else if (seg == "pager") {
                Button prev = new Button(prevText != "" ? prevText : "<");
                prev.ClassName = "pagination-prev ghost square";
                if (prevText == "") { prev.Icon = "chevron-left"; }
                if (cur <= 1) { prev.Disabled = true; }
                PaginationAction prevAction = new PaginationAction(this, 0, -1);
                prev.Click.Add(prevAction.Navigate);
                this.Add(prev);
                List<int> slots = Pagination.BuildPagesSlots(tot, cur, pagerCount);
                for (int k = 0; k < slots.Count; k = k + 1) {
                    int pVal = slots[k];
                    if (pVal > 0) {
                        Button pb = new Button(Convert.ToString(pVal));
                        pb.ClassName = "pagination-item square " + (pVal == cur ? "primary" : "ghost");
                        PaginationAction pageAction = new PaginationAction(this, pVal, 0);
                        pb.Click.Add(pageAction.Navigate);
                        this.Add(pb);
                    } else {
                        Button ell = new Button("...");
                        ell.ClassName = "pagination-ellipsis ghost square";
                        int half = slots.Count / 2;
                        int step = this.EllipsisStep();
                        PaginationAction ellAction = new PaginationAction(this, 0, k < half ? -step : step);
                        ell.Click.Add(ellAction.Navigate);
                        this.Add(ell);
                    }
                }
                Button next = new Button(nextText != "" ? nextText : ">");
                next.ClassName = "pagination-next ghost square";
                if (nextText == "") { next.Icon = "chevron-right"; }
                if (cur >= tot) { next.Disabled = true; }
                PaginationAction nextAction = new PaginationAction(this, 0, 1);
                next.Click.Add(nextAction.Navigate);
                this.Add(next);
            } else if (seg == "suffix" && suffixText != "") {
                Label lbl = new Label(suffixText);
                lbl.ClassName = "pagination-suffix";
                this.Add(lbl);
            } else if (seg == "jumper" && jumper) {
                Label lbl = new Label(this.JumperLabelText());
                lbl.ClassName = "pagination-jumper-label text-muted";
                this.Add(lbl);
                Input jin = new Input();
                jin.ClassName = "pagination-jumper-input small";
                PaginationAction jumpAction = new PaginationAction(this, 0, 0);
                jumpAction.input = jin;
                jin.Submit.Add(jumpAction.Submit);
                this.Add(jin);
                if (jumperSuffix != "") {
                    Label sfx = new Label(jumperSuffix);
                    sfx.ClassName = "pagination-jumper-suffix text-muted";
                    this.Add(sfx);
                }
            } else if (seg == "sizes" && pageSizes.Count > 0) {
                Button szBtn = new Button(this.SizeText(pageSize));
                szBtn.ClassName = "pagination-sizes-btn ghost small";
                PaginationAction sizeAction = new PaginationAction(this, 0, 0);
                szBtn.Click.Add(sizeAction.NextSize);
                this.Add(szBtn);
            }
        }
        lastBuiltPage = cur;
        lastBuiltTotal = tot;
        needsRebuild = false;
    }
    private void CheckRebuild() {
        int cur = this.CurrentPage();
        int tot = this.TotalPages();
        if (needsRebuild || cur != lastBuiltPage || tot != lastBuiltTotal || this.ChildCount() == 0) {
            this.BuildTree();
        }
    }
    public override void SyncBinding() {
        base.SyncBinding();
        this.CheckRebuild();
    }
    public override void CloneContentTo(Control target, CloneTreeFn clone) {
    }
    public override string Kind() { return "Pagination"; }
    protected override List<PropSpec> DefineProps() {
        List<PropSpec> ps = new List<PropSpec>();
        ps.Add(PropSpec.Int("total", "Page count").Field("totalPages", 1));
        ps.Add(PropSpec.Int("page", "Current page").DefaultBinding().Field("Page", 1).Also("data").Also("value"));
        ps.Add(PropSpec.Int("itemCount", "Item count").Field("itemCount", 1));
        ps.Add(PropSpec.Int("pageSize", "Page size").Field("pageSize", 1));
        ps.Add(PropSpec.Text("pageSizes", "Page sizes").ViaExtra());
        ps.Add(PropSpec.Text("order", "Order").ViaExtra());
        ps.Add(PropSpec.Bool("showTotal", "Show total").Field("showTotal", 2));
        ps.Add(PropSpec.Bool("jumper", "Jumper").Field("jumper", 2));
        ps.Add(PropSpec.Text("jumperLabel", "Jumper label").Field("jumperLabel", 0));
        ps.Add(PropSpec.Text("jumperSuffix", "Jumper suffix").Field("jumperSuffix", 0));
        ps.Add(PropSpec.Text("prefix", "Prefix").Field("prefixText", 0));
        ps.Add(PropSpec.Text("suffix", "Suffix").Field("suffixText", 0));
        ps.Add(PropSpec.Text("prevText", "Prev text").Field("prevText", 0));
        ps.Add(PropSpec.Text("nextText", "Next text").Field("nextText", 0));
        ps.Add(PropSpec.Int("pagerCount", "Pager count").Field("pagerCount", 1));
        return ps;
    }
    public override string GetProp(string key) {
        if (key == "data" || key == "value" || key == "page") {
            if (Page != null) { return Convert.ToString(Page.Get()); }
            return Convert.ToString(this.CurrentPage());
        }
        if (key == "pageSizes") { return this.PageSizesText(); }
        if (key == "order") { return this.OrderText(); }
        return base.GetProp(key);
    }
    public override void OnMeasure(App app) {
        this.SyncBinding();
        base.OnMeasure(app);
    }
    public override void SetProp(string key, string val) {
        if (key == "data" || key == "value" || key == "page") {
            int p = Convert.ToInt32(val);
            if (p < 1) { p = 1; }
            int tot = this.TotalPages();
            if (p > tot) { p = tot; }
            if (Page != null) { Page.Set(p); }
            needsRebuild = true;
            this.BuildTree();
            return;
        }
        if (key == "pageSizes") { this.SetPageSizesText(val); return; }
        if (key == "order") { this.SetOrderText(val); return; }
        base.SetProp(key, val);
        if (key == "total") { this.SetTotal(Convert.ToInt32(val)); }
        else if (key == "pageSize") { this.SetPageSize(Convert.ToInt32(val)); }
        else if (key == "itemCount") { this.SetItemCount(Convert.ToInt32(val)); }
        else if (key == "pagerCount") { this.SetPagerCount(Convert.ToInt32(val)); }
        else if (key == "jumper") { jumper = val == "true"; needsRebuild = true; this.BuildTree(); }
        else if (key == "showTotal") { showTotal = val == "true"; needsRebuild = true; this.BuildTree(); }
        else if (key == "prefix") { prefixText = val; needsRebuild = true; this.BuildTree(); }
        else if (key == "suffix") { suffixText = val; needsRebuild = true; this.BuildTree(); }
        else if (key == "prevText") { prevText = val; needsRebuild = true; this.BuildTree(); }
        else if (key == "nextText") { nextText = val; needsRebuild = true; this.BuildTree(); }
    }
    public override List<string> Events() {
        List<string> e = Control.CommonEvents();
        e.Add("Change");
        e.Add("SizeChange");
        return e;
    }
    public override void BindEvent(string evt, Action a) {
        if (evt == "Change" || evt == "PageChange" || evt == "PageChanged") { Change.Add(a); return; }
        if (evt == "SizeChange" || evt == "SizeChanged" || evt == "PageSizeChange" || evt == "PageSizeChanged") {
            SizeChange.Add(a);
            return;
        }
        base.BindEvent(evt, a);
    }
    public override void BindEventS(string evt, ControlEvent a) {
        if (evt == "Change" || evt == "PageChange" || evt == "PageChanged") { Change.AddS(a); return; }
        if (evt == "SizeChange" || evt == "SizeChanged" || evt == "PageSizeChange" || evt == "PageSizeChanged") {
            SizeChange.AddS(a);
            return;
        }
        base.BindEventS(evt, a);
    }
    public override void TriggerEvent(string evt) {
        if (evt == "Change" || evt == "PageChange" || evt == "PageChanged") { Change.RaiseS(this); return; }
        if (evt == "SizeChange" || evt == "SizeChanged" || evt == "PageSizeChange" || evt == "PageSizeChanged") { SizeChange.RaiseS(this); return; }
        base.TriggerEvent(evt);
    }
}
