using System;
using System.Collections.Generic;
using Gui;

namespace Gui.Widget;

// 分页组件（Element Plus / Naive UI 对位）：标准 Flex 复合容器。
// 内部完全由标准 Button、Input、Label 等基础控件组合而成，
// 彻底消灭手工画布循环绘制与私有事件状态机，全流程走通用排版与事件管线。
public class Pagination : Control {
    // 内部当前页信号（1 起始）；存在双向绑定时与其保持同步。
    public SignalInt model;
    // 双向绑定的当前页，从 1 开始。不绑定时用构造器给的信号。
    public Binding<int> Page;
    // 显式页数（未启用 item-count 模式时生效）。
    public int totalPages;
    // 页码变化后触发（SetPage/点击翻页）。
    public UiEvent Change;
    // 每页条数变化后触发（ShowSizes 下拉选择）。
    public UiEvent SizeChange;

    // ---- item-count 模式 ----
    public bool useItemCount;
    public int itemCount;
    public int pageSize;
    public List<int> pageSizes;
    public int sizeIdx;
    public bool sizeOpen;

    // ---- 文案与插槽 ----
    public string prefixText;
    public string suffixText;
    public string prevText;
    public string nextText;
    public bool showTotal;

    // ---- 快速跳页段 ----
    public bool jumper;
    public string jumperLabel;
    public string jumperSuffix;

    // ---- 展示顺序 ----
    public List<string> order;
    public int pagerCount;

    // ---- 内部子树构建缓存 ----
    private int lastBuiltPage;
    private int lastBuiltTotal;
    private bool needsRebuild;

    // 初始化：置页数/当前页信号与各段默认值。
    private void InitPagination(int total, SignalInt m) {
        this.InitControl("pagination", 1);
        totalPages = total;
        if (totalPages < 1) { totalPages = 1; }
        model = m;
        wiresOwnEvents = false;
        Change = new UiEvent();
        SizeChange = new UiEvent();
        useItemCount = false;
        itemCount = 0;
        pageSize = 10;
        pageSizes = new List<int>();
        sizeIdx = 0 - 1;
        sizeOpen = false;
        prefixText = "";
        suffixText = "";
        prevText = "";
        nextText = "";
        showTotal = false;
        jumper = false;
        jumperLabel = "";
        jumperSuffix = "";
        order = null;
        pagerCount = 7;
        lastBuiltPage = 0 - 1;
        lastBuiltTotal = 0 - 1;
        needsRebuild = true;
    }

    // 构造：默认 1 页，内部信号从第 1 页开始。
    public Pagination() : this(1) { }
    // 构造：显式页数，内部新建当前页信号。
    public Pagination(int total) { InitPagination(total, new SignalInt(1)); }
    // 构造：显式页数 + 共享当前页信号。
    public Pagination(int total, SignalInt m) { InitPagination(total, m); }

    // 工厂：显式页数 + 共享当前页信号。
    public static Pagination Of(int total, SignalInt m) {
        return new Pagination(total, m);
    }

    // item-count 模式：由条目数与每页条数推导总页数。
    public static Pagination WithCount(int items, int size, SignalInt m) {
        Pagination p = new Pagination(1, m);
        p.useItemCount = true;
        p.itemCount = items;
        p.SetPageSize(size);
        return p;
    }

    // 显式页数（退出 item-count 模式）。
    public void SetTotal(int total) {
        useItemCount = false;
        totalPages = total;
        if (totalPages < 1) { totalPages = 1; }
        this.Normalize();
    }

    // 总页数：item-count 模式推导，否则显式值。
    public int TotalPages() {
        if (useItemCount) {
            int sz = pageSize;
            if (sz < 1) { sz = 1; }
            int n = (itemCount + sz - 1) / sz;
            if (n < 1) { n = 1; }
            return n;
        }
        return totalPages;
    }

    // TotalPages 的别名（Naive UI 的 page-count 惯用名）。
    public int Total() { return this.TotalPages(); }

    // 切到 item-count 模式：给条目数，页数按每页条数推导。
    public void SetItemCount(int items) {
        useItemCount = true;
        itemCount = items;
        this.Normalize();
    }

    public int ItemCount() { return itemCount; }
    public bool UsesItemCount() { return useItemCount; }

    // 每页条数（item-count 模式下决定页数）；当前页随之钳制。
    public void SetPageSize(int size) {
        if (size < 1) { size = 1; }
        pageSize = size;
        sizeIdx = 0 - 1;
        for (int i = 0; i < pageSizes.Count; i = i + 1) {
            if (pageSizes[i] == size) { sizeIdx = i; }
        }
        this.Normalize();
    }

    public int PageSize() { return pageSize; }

    // ShowSizes 的候选条数。
    public void SetPageSizes(List<int> sizes) {
        pageSizes = sizes;
        if (pageSizes == null) { pageSizes = new List<int>(); }
        sizeIdx = 0 - 1;
        for (int i = 0; i < pageSizes.Count; i = i + 1) {
            if (pageSizes[i] == pageSize) { sizeIdx = i; }
        }
        needsRebuild = true;
    }

    public List<int> PageSizes() { return pageSizes; }

    public void SetPageSizesText(string text) {
        List<int> r = new List<int>();
        int i = 0;
        while (i < text.Length) {
            int comma = text.IndexOf(",", i);
            string seg = "";
            if (comma < 0) { seg = text.Substring(i); i = text.Length; }
            else { seg = text.Substring(i, comma - i); i = comma + 1; }
            seg = seg.Trim();
            if (seg.Length == 0) { continue; }
            bool digits = true;
            for (int k = 0; k < seg.Length; k = k + 1) {
                if (seg[k] < 48 || seg[k] > 57) { digits = false; }
            }
            if (!digits) { continue; }
            int v = Convert.ToInt32(seg);
            if (v > 0) { r.Add(v); }
        }
        this.SetPageSizes(r);
    }

    public string PageSizesText() {
        string acc = "";
        for (int i = 0; i < pageSizes.Count; i = i + 1) {
            if (i > 0) { acc = acc + ", "; }
            acc = acc + Convert.ToString(pageSizes[i]);
        }
        return acc;
    }

    public Pagination Jumper(bool v) { jumper = v; needsRebuild = true; return this; }
    public bool HasJumper() { return jumper; }

    public void OpenSizes() { sizeOpen = true; }
    public void CloseSizes() { sizeOpen = false; }
    public bool SizesOpen() { return sizeOpen; }

    public Pagination ShowSizes(bool v) {
        if (v && pageSizes.Count == 0) {
            pageSizes.Add(10);
            pageSizes.Add(20);
            pageSizes.Add(50);
            pageSizes.Add(100);
            sizeIdx = 0 - 1;
            for (int i = 0; i < pageSizes.Count; i = i + 1) {
                if (pageSizes[i] == pageSize) { sizeIdx = i; }
            }
        }
        needsRebuild = true;
        return this;
    }

    public bool HasSizes() { return pageSizes.Count > 0; }

    public Pagination Prefix(string t) { prefixText = t; needsRebuild = true; return this; }
    public Pagination Suffix(string t) { suffixText = t; needsRebuild = true; return this; }
    public Pagination PrevText(string t) { prevText = t; needsRebuild = true; return this; }
    public Pagination NextText(string t) { nextText = t; needsRebuild = true; return this; }
    public Pagination ShowTotal(bool v) { showTotal = v; needsRebuild = true; return this; }
    public Pagination JumperLabel(string t) { jumperLabel = t; needsRebuild = true; return this; }
    public Pagination JumperSuffix(string t) { jumperSuffix = t; needsRebuild = true; return this; }

    public void SetPagerCount(int n) {
        if (n < 5) { n = 5; }
        if (n > 21) { n = 21; }
        if (n % 2 == 0) { n = n - 1; }
        pagerCount = n;
        needsRebuild = true;
    }

    public int PagerCount() { return pagerCount; }

    public List<string> EffOrder() {
        List<string> r = new List<string>();
        if (order != null) {
            for (int i = 0; i < order.Count; i = i + 1) { r.Add(order[i]); }
            bool hasPager = false;
            for (int i = 0; i < r.Count; i = i + 1) {
                if (r[i] == "pager") { hasPager = true; }
            }
            if (!hasPager) { r.Add("pager"); }
            return r;
        }
        if (prefixText != "") { r.Add("prefix"); }
        if (showTotal) { r.Add("total"); }
        r.Add("pager");
        if (suffixText != "") { r.Add("suffix"); }
        if (jumper) { r.Add("jumper"); }
        if (pageSizes.Count > 0) { r.Add("sizes"); }
        return r;
    }

    public void SetOrderText(string text) {
        List<string> r = new List<string>();
        int i = 0;
        while (i < text.Length) {
            int comma = text.IndexOf(",", i);
            string seg = "";
            if (comma < 0) { seg = text.Substring(i); i = text.Length; }
            else { seg = text.Substring(i, comma - i); i = comma + 1; }
            seg = seg.Trim().ToLower();
            if (seg == "prefix" || seg == "total" || seg == "pager"
                || seg == "suffix" || seg == "jumper" || seg == "sizes") {
                r.Add(seg);
            }
        }
        if (r.Count == 0) { order = null; return; }
        order = r;
        needsRebuild = true;
    }

    public string OrderText() {
        List<string> eff = this.EffOrder();
        string acc = "";
        for (int i = 0; i < eff.Count; i = i + 1) {
            if (i > 0) { acc = acc + ", "; }
            acc = acc + eff[i];
        }
        return acc;
    }

    public static int MeasureWidth(App app, int totalPages, int current) {
        Theme t = app.theme;
        int btnSize = t.heightMedium;
        int gap = t.gapSmall;
        List<int> pages = Pagination.BuildPages(totalPages, current);
        int count = pages.Count + 2;
        return count * (btnSize + gap) - gap;
    }

    public int EllipsisStep() { return pagerCount - 2; }

    public static List<int> BuildPages(int totalPages, int current) {
        return Pagination.BuildPagesSlots(totalPages, current, 7);
    }

    public static List<int> BuildPagesSlots(int totalPages, int current, int slots) {
        List<int> r = new List<int>();
        if (totalPages < 1) { totalPages = 1; }
        if (current < 1) { current = 1; }
        if (current > totalPages) { current = totalPages; }
        if (totalPages <= slots) {
            int i = 1;
            while (i <= totalPages) { r.Add(i); i = i + 1; }
            return r;
        }
        int half = (slots - 1) / 2;
        bool prevMore = current > slots - 2;
        bool nextMore = current < totalPages - slots + 3;
        if (prevMore && !nextMore) {
            int start = totalPages - (slots - 2);
            int p = start;
            while (p < totalPages) { r.Add(p); p = p + 1; }
        } else if (!prevMore && nextMore) {
            int p = 2;
            while (p < slots) { r.Add(p); p = p + 1; }
        } else if (prevMore && nextMore) {
            int off = half - 1;
            int p = current - off;
            while (p <= current + off) { r.Add(p); p = p + 1; }
        } else {
            int p = 2;
            while (p < totalPages) { r.Add(p); p = p + 1; }
        }
        List<int> full = new List<int>();
        full.Add(1);
        if (prevMore) { full.Add(0); }
        for (int i = 0; i < r.Count; i = i + 1) { full.Add(r[i]); }
        if (nextMore) { full.Add(0); }
        full.Add(totalPages);
        return full;
    }

    public int CurrentPage() {
        if (model == null) { return 1; }
        return model.Get();
    }

    public void SetPage(int p) {
        this.GoTo(p);
    }

    public void Normalize() {
        int tot = this.TotalPages();
        int cur = model.Get();
        if (cur < 1) { model.Set(1); if (Page != null) { Page.Set(1); } }
        else if (cur > tot) { model.Set(tot); if (Page != null) { Page.Set(tot); } }
        needsRebuild = true;
    }

    // 跳转目标页并通知外界
    public void GoTo(int target) {
        if (target < 1) { target = 1; }
        int total = this.TotalPages();
        if (target > total) { target = total; }
        int cur = this.CurrentPage();
        if (target == cur) { return; }
        model.Set(target);
        if (Page != null) { Page.Set(target); }
        needsRebuild = true;
        Change.RaiseS(this);
        App a = this.FindApp();
        if (a != null && a.window != null) { a.window.Wake(); }
    }

    public string TotalText() {
        return "共 " + Convert.ToString(this.TotalPages()) + " 页";
    }

    public string JumperLabelText() {
        if (jumperLabel != "") { return jumperLabel; }
        return "跳至";
    }

    public string SizeText(int n) {
        return Convert.ToString(n) + " / 页";
    }

    // ---- 事件回调（避免闭包逃逸）---------------------------------

    private static void OnPrevClick(Control sender) {
        if (sender == null || sender.Parent() == null) { return; }
        Pagination pg = (Pagination)sender.Parent();
        pg.GoTo(pg.CurrentPage() - 1);
    }

    private static void OnNextClick(Control sender) {
        if (sender == null || sender.Parent() == null) { return; }
        Pagination pg = (Pagination)sender.Parent();
        pg.GoTo(pg.CurrentPage() + 1);
    }

    private static void OnPageButtonClick(Control sender) {
        if (sender == null || sender.Parent() == null) { return; }
        Pagination pg = (Pagination)sender.Parent();
        if (sender is Button) {
            Button btn = (Button)sender;
            string txt = btn.Label();
            int p = Convert.ToInt32(txt);
            if (p > 0) { pg.GoTo(p); }
        }
    }

    private static void OnEllipsisClick(Control sender) {
        if (sender == null || sender.Parent() == null) { return; }
        Pagination pg = (Pagination)sender.Parent();
        int idx = pg.children.IndexOf(sender);
        int half = pg.children.Count / 2;
        int step = pg.EllipsisStep();
        if (idx < half) {
            pg.GoTo(pg.CurrentPage() - step);
        } else {
            pg.GoTo(pg.CurrentPage() + step);
        }
    }

    private static void OnSizeCycle(Control sender) {
        if (sender == null || sender.Parent() == null) { return; }
        Pagination pg = (Pagination)sender.Parent();
        if (pg.pageSizes.Count == 0) { return; }
        pg.sizeIdx = (pg.sizeIdx + 1) % pg.pageSizes.Count;
        pg.SetPageSize(pg.pageSizes[pg.sizeIdx]);
        pg.SizeChange.PostS(pg);
    }

    private static void OnJumperSubmit(Control sender) {
        if (sender == null || sender.Parent() == null) { return; }
        Pagination pg = (Pagination)sender.Parent();
        if (sender is Input) {
            Input inp = (Input)sender;
            string val = inp.GetText().Trim();
            if (val.Length > 0) {
                int p = Convert.ToInt32(val);
                if (p > 0) { pg.GoTo(p); }
            }
        }
    }

    // ---- DOM 子控件树构建（核心瘦身点）---------------------------

    private void BuildSubtree(App app) {
        children.Clear();
        int cur = this.CurrentPage();
        int tot = this.TotalPages();
        List<string> segs = this.EffOrder();

        for (int i = 0; i < segs.Count; i = i + 1) {
            string seg = segs[i];
            if (seg == "prefix" && prefixText != "") {
                this.Add(new Label(prefixText));
            } else if (seg == "total" && showTotal) {
                this.Add(new Label(this.TotalText()));
            } else if (seg == "pager") {
                // 上一页
                Button prev = new Button(prevText != "" ? prevText : "<");
                if (prevText == "") { prev.Icon = "chevron-left"; }
                if (cur <= 1) { prev.Disabled = true; }
                prev.Click.AddS(Pagination.OnPrevClick);
                this.Add(prev);

                // 页码槽
                List<int> slots = Pagination.BuildPagesSlots(tot, cur, pagerCount);
                for (int k = 0; k < slots.Count; k = k + 1) {
                    int pVal = slots[k];
                    if (pVal > 0) {
                        Button pb = new Button(Convert.ToString(pVal));
                        if (pVal == cur) { pb.AddClass("primary"); }
                        else { pb.AddClass("ghost"); }
                        pb.Click.AddS(Pagination.OnPageButtonClick);
                        this.Add(pb);
                    } else {
                        Button ell = new Button("...");
                        ell.AddClass("ghost");
                        ell.Click.AddS(Pagination.OnEllipsisClick);
                        this.Add(ell);
                    }
                }

                // 下一页
                Button next = new Button(nextText != "" ? nextText : ">");
                if (nextText == "") { next.Icon = "chevron-right"; }
                if (cur >= tot) { next.Disabled = true; }
                next.Click.AddS(Pagination.OnNextClick);
                this.Add(next);
            } else if (seg == "suffix" && suffixText != "") {
                this.Add(new Label(suffixText));
            } else if (seg == "jumper" && jumper) {
                this.Add(new Label(this.JumperLabelText()));
                Input jin = new Input();
                jin.prefW = app != null ? app.Scale(46) : 46;
                jin.Submit.AddS(Pagination.OnJumperSubmit);
                this.Add(jin);
                if (jumperSuffix != "") {
                    this.Add(new Label(jumperSuffix));
                }
            } else if (seg == "sizes" && pageSizes.Count > 0) {
                Button szBtn = new Button(this.SizeText(pageSize));
                szBtn.Click.AddS(Pagination.OnSizeCycle);
                this.Add(szBtn);
            }
        }
        lastBuiltPage = cur;
        lastBuiltTotal = tot;
        needsRebuild = false;
    }

    private void CheckRebuild(App app) {
        int cur = this.CurrentPage();
        int tot = this.TotalPages();
        if (needsRebuild || cur != lastBuiltPage || tot != lastBuiltTotal || children.Count == 0) {
            this.BuildSubtree(app);
        }
    }

    // 覆写：自度量。遍历子控件累加宽度，取最大高度。
    public override void OnMeasure(App app) {
        this.SyncBinding();
        this.CheckRebuild(app);
        int gap = app != null ? app.Scale(6) : 6;
        int defSize = app != null ? app.Scale(32) : 32;
        int totalW = 0;
        int maxH = defSize;

        for (int i = 0; i < children.Count; i = i + 1) {
            Control c = children[i];
            if (app != null) { c.OnMeasure(app); }
            if (i > 0) { totalW = totalW + gap; }
            totalW = totalW + (c.prefW > 0 ? c.prefW : defSize);
            if (c.prefH > maxH) { maxH = c.prefH; }
        }
        prefW = totalW;
        prefH = maxH;
    }

    // 覆写：保留模式容器排版与绘制。
    public override void OnPaint(App app) {
        if (bw <= 0 || bh <= 0) { return; }
        this.SyncBinding();
        this.CheckRebuild(app);
        int gap = app != null ? app.Scale(6) : 6;
        int defSize = app != null ? app.Scale(32) : 32;
        int cx = bx;

        for (int i = 0; i < children.Count; i = i + 1) {
            Control c = children[i];
            int cw = c.prefW > 0 ? c.prefW : defSize;
            int ch = c.prefH > 0 ? c.prefH : bh;
            int cy = by + (bh - ch) / 2;
            c.Arrange(cx, cy, cw, ch);
            c.RenderTree(app);
            cx = cx + cw + gap;
        }
    }

    // ---- 设计器 / 序列化模型 -------------------------------------

    public override string Kind() { return "Pagination"; }

    public override List<PropSpec> Props() {
        List<PropSpec> ps = new List<PropSpec>();
        PropSpec total = PropSpec.Int("total", "Page count");
        total.num = totalPages;
        ps.Add(total);
        PropSpec pg = PropSpec.Int("page", "Current page");
        if (Page != null) { pg.num = Page; } else { pg.snum = model; }
        ps.Add(pg);
        PropSpec items = PropSpec.Int("itemCount", "Item count");
        items.num = itemCount;
        ps.Add(items);
        PropSpec sz = PropSpec.Int("pageSize", "Page size");
        sz.num = pageSize;
        ps.Add(sz);
        PropSpec sizes = PropSpec.Text("pageSizes", "Page sizes");
        sizes.str = this.PageSizesText();
        ps.Add(sizes);
        PropSpec ord = PropSpec.Text("order", "Order");
        ord.str = this.OrderText();
        ps.Add(ord);
        PropSpec sh = PropSpec.Bool("showTotal", "Show total");
        sh.flag = showTotal;
        ps.Add(sh);
        PropSpec jp = PropSpec.Bool("jumper", "Jumper");
        jp.flag = jumper;
        ps.Add(jp);
        PropSpec jl = PropSpec.Text("jumperLabel", "Jumper label");
        jl.str = jumperLabel;
        ps.Add(jl);
        PropSpec jsf = PropSpec.Text("jumperSuffix", "Jumper suffix");
        jsf.str = jumperSuffix;
        ps.Add(jsf);
        PropSpec pre = PropSpec.Text("prefix", "Prefix");
        pre.str = prefixText;
        ps.Add(pre);
        PropSpec suf = PropSpec.Text("suffix", "Suffix");
        suf.str = suffixText;
        ps.Add(suf);
        PropSpec pt = PropSpec.Text("prevText", "Prev text");
        pt.str = prevText;
        ps.Add(pt);
        PropSpec nt = PropSpec.Text("nextText", "Next text");
        nt.str = nextText;
        ps.Add(nt);
        PropSpec pc = PropSpec.Int("pagerCount", "Pager count");
        pc.num = pagerCount;
        ps.Add(pc);
        return ps;
    }

    public override string GetProp(string key) {
        if (key == "pageSizes") { return this.PageSizesText(); }
        if (key == "order") { return this.OrderText(); }
        return base.GetProp(key);
    }

    public override void SetProp(string key, string val) {
        if (key == "pageSizes") { this.SetPageSizesText(val); return; }
        if (key == "order") { this.SetOrderText(val); return; }
        base.SetProp(key, val);
        if (key == "total") { this.SetTotal(Convert.ToInt32(val)); }
        else if (key == "pageSize") { this.SetPageSize(Convert.ToInt32(val)); }
        else if (key == "itemCount") { this.SetItemCount(Convert.ToInt32(val)); }
        else if (key == "pagerCount") { this.SetPagerCount(Convert.ToInt32(val)); }
        else if (key == "jumper") { jumper = val == "true"; needsRebuild = true; }
        else if (key == "showTotal") { showTotal = val == "true"; needsRebuild = true; }
        else if (key == "prefix") { prefixText = val; needsRebuild = true; }
        else if (key == "suffix") { suffixText = val; needsRebuild = true; }
        else if (key == "prevText") { prevText = val; needsRebuild = true; }
        else if (key == "nextText") { nextText = val; needsRebuild = true; }
    }

    public override List<string> Events() {
        List<string> e = Control.CommonEvents();
        e.Add("Change");
        e.Add("SizeChange");
        return e;
    }

    public override void BindEvent(string evt, Action a) {
        if (evt == "Change" || evt == "PageChange" || evt == "PageChanged") { Change.Add(a); return; }
        if (evt == "SizeChange" || evt == "SizeChanged" || evt == "PageSizeChange" || evt == "PageSizeChanged") {
            SizeChange.Add(a);
            return;
        }
        base.BindEvent(evt, a);
    }

    public override void BindEventS(string evt, ControlEvent a) {
        if (evt == "Change" || evt == "PageChange" || evt == "PageChanged") { Change.AddS(a); return; }
        if (evt == "SizeChange" || evt == "SizeChanged" || evt == "PageSizeChange" || evt == "PageSizeChanged") {
            SizeChange.AddS(a);
            return;
        }
        base.BindEventS(evt, a);
    }

    public override void TriggerEvent(string evt) {
        if (evt == "Change" || evt == "PageChange" || evt == "PageChanged") { Change.RaiseS(this); return; }
        if (evt == "SizeChange" || evt == "SizeChanged" || evt == "PageSizeChange" || evt == "PageSizeChanged") { SizeChange.RaiseS(this); return; }
        base.TriggerEvent(evt);
    }
}
