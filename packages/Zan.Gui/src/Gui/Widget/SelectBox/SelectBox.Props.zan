using System;
using System.Collections.Generic;
using Gui;
namespace Gui.Widget;
public partial class SelectBox {
    public override Control CreateCloneShell() { return new SelectBox(); }

    // 控件类型标识（序列化/设计器用）。必须与注册键一致：
    // Serialize/Html 克隆按 `c.Kind()` 写、按同名 kind 重建——
    // 旧自报名 "Select" 在注册表里没有键，下拉框在克隆通道
    // 拿 null 被静默丢弃（注册表探针实证）。

    // 覆写：返回设计器属性清单（占位 / 选项 / 选中值 / 清除 / 尺寸 /
    // 弹层方向 / 过滤与级联选项）。
    // options 读回作者原文（未设原文时按当前选项生成）。
    public string GetOptionsSource() { return optionsRaw != "" ? optionsRaw : this.OptionsText(); }

    public string SelectedIndexText() { return Convert.ToString(Value.Get()); }

    // 按下标选中；空串 = 清空，越界忽略。
    public void SelectIndexText(string val) {
        if (val == null || val == "") { this.Select(0 - 1); return; }
        int idx = 0;
        if (int.TryParse(val, out idx) && idx >= 0 - 1 && idx < opts.Count) { this.Select(idx); }
    }

    // 按选项值（无值时按标签）选中；空串 = 清空，未匹配忽略。
    public void SelectByValue(string val) {
        if (val == null || val == "") { this.Select(0 - 1); return; }
        for (int i = 0; i < opts.Count; i = i + 1) {
            string optionKey = opts[i].val;
            if (optionKey == null || optionKey == "") { optionKey = opts[i].label; }
            if (optionKey == val) { this.Select(i); return; }
        }
    }

    public void SelectByText(string val) {
        if (val == null) { this.Select(0 - 1); return; }
        this.SetSelectedByText(val);
    }

    protected override List<PropSpec> DefineProps() {
        List<PropSpec> ps = new List<PropSpec>();
        ps.Add(PropSpec.Text("hint", "Placeholder").Field("hint").Also("placeholder"));
        ps.Add(PropSpec.Text("options", "Options").Accessor("GetOptionsSource", "SetOptionsText"));
        ps.Add(PropSpec.Text("text", "Selected text").Accessor("Text", "SelectByText").Also("label").Also("selectedText"));
        ps.Add(PropSpec.Text("selectedValue", "Selected value").DefaultBinding().Accessor("SelectedValue", "SelectByValue").Also("val"));
        ps.Add(PropSpec.Int("value", "Selected").DefaultBinding()
            .Field("Value").Accessor("SelectedIndexText", "SelectIndexText")
            .Also("selected")
            .Also("data"));
        ps.Add(PropSpec.Bool("clearable", "Clearable").Field("clearable"));
        PropSpec szp = PropSpec.Enum("size", "Size",
            PropSpec.Sizes3());
        szp.Field("Size");
        ps.Add(szp);
        PropSpec pl = PropSpec.Enum("placement", "Placement",
            new List<string>{ "auto", "bottom", "top" });
        pl.Field("placement");
        ps.Add(pl);
        ps.Add(PropSpec.Bool("filterable", "Filterable").Field("filterable"));
        ps.Add(PropSpec.Bool("showPath", "ShowPath").Field("showPath"));
        PropSpec cs = PropSpec.Enum("checkStrategy", "CheckStrategy",
            new List<string>{ "all", "parent", "child" });
        cs.Field("checkStrategy");
        ps.Add(cs);
        ps.Add(PropSpec.Bool("hoverExpand", "HoverExpand").Field("hoverExpand"));
        return ps;
    }
    public override int WidgetId() { return wid; }
}
