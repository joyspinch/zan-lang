using System;
using Gui;

namespace Gui.Widget;

// The public defaultPopupCard remains a Card. Its actual body owns keyboard rows.
public class SelectBoxOptionPanel : Panel {
    // 按父类种类上报：序列化与自动化以 "Panel" 识别本控件。
    public override string Kind() { return "Panel"; }
    private weak SelectBox owner;
    public List<SelectBoxOptionButton> Rows;
    public SelectBoxOptionPanel(SelectBox box) {
        owner = box; Rows = new List<SelectBoxOptionButton>();
        this.ClassName = "select-option-panel";
        style = 3; layout = 1; flexFlow = 1;
    }
    public void FocusOption(App app, int index, int direction) {
        if (app == null || Rows == null || Rows.Count == 0) { return; }
        if (direction == 0) { direction = 1; }
        int at = direction > 0 ? 0 : Rows.Count - 1;
        for (int i = 0; i < Rows.Count; i = i + 1) {
            if (Rows[i].OptionIndex == index) { at = i; break; }
        }
        while (at >= 0 && at < Rows.Count) {
            SelectBoxOptionButton row = Rows[at];
            if (!row.IsDisabled()) { row.Focus(app); return; }
            at = at + direction;
        }
    }
    public void MoveFocus(App app, int direction) {
        if (app == null || Rows == null || Rows.Count == 0) { return; }
        if (direction == 0) { direction = 1; }
        int at = direction > 0 ? -1 : Rows.Count;
        for (int i = 0; i < Rows.Count; i = i + 1) {
            if (Rows[i].IsFocused(app)) { at = i; break; }
        }
        for (int count = 0; count < Rows.Count; count = count + 1) {
            at = at + direction;
            if (at < 0) { at = Rows.Count - 1; }
            if (at >= Rows.Count) { at = 0; }
            if (!Rows[at].IsDisabled()) { Rows[at].Focus(app); return; }
        }
    }
    public override void OnPreviewRoutedEvent(RoutedEventArgs e) {
        base.OnPreviewRoutedEvent(e);
        if (e.handled || e.eventName != "KeyDown") { return; }
        SelectBox box = owner; App app = this.FindApp();
        if (box == null || app == null || box.FindApp() != app || !box.open || box.IsDisabled()) { return; }
        int key = e.keyCode;
        if (key == 38 || key == 40) { this.MoveFocus(app, key == 40 ? 1 : -1); e.Handle(); }
        else if (key == 36 || key == 35) { this.FocusOption(app, -1, key == 36 ? 1 : -1); e.Handle(); }
        else if (key == 13 || key == 32) {
            for (int i = 0; i < Rows.Count; i = i + 1) {
                if (Rows[i].IsFocused(app)) { Rows[i].CommitKey(app); e.Handle(); return; }
            }
        } else if (key == 9) {
            int session = box.InputSession();
            box.SetOpen(false);
            if (box.FindApp() == app && box.InputSession() == session + 1 && !box.open) {
                box.Focus(app);
                if (app.focus != null) { app.focus.FocusStep(Modifiers.HasShift(e.modifiers) ? -1 : 1); }
            }
            e.Handle();
        }
    }
}

public class SelectBoxOptionButton : Button {
    // 按父类种类上报：序列化与自动化以 "Button" 识别本控件。
    public override string Kind() { return "Button"; }
    private weak SelectBox owner;
    private List<SelectOption> options;
    private SelectOption option;
    private int session;
    private bool armed;
    private string downKey;
    private string downLabel;
    public int OptionIndex;
    public SelectBoxOptionButton(SelectBox box, int index, SelectOption value,
                                 List<SelectOption> source, int opening) : base(value != null && value.label != null ? value.label : "") {
        owner = box; OptionIndex = index; option = value; options = source; session = opening;
    }
    public override void OnPointerDown(RoutedEventArgs e) {
        App app = this.FindApp();
        armed = app != null && app.window != null && app.window.EventButton() == 0 && !this.IsDisabled() && option != null;
        downKey = option != null ? option.val : "";
        downLabel = option != null ? option.label : "";
        base.OnPointerDown(e);
    }
    public override void OnPointerEnter(RoutedEventArgs e) {
        base.OnPointerEnter(e);
        SelectBox box = owner;
        if (!this.IsDisabled() && box != null && box.open && box.hoverRow != OptionIndex) {
            box.hoverRow = OptionIndex;
            box.Hover.Raise(box);
        }
    }
    public override void OnPointerLeave(RoutedEventArgs e) {
        base.OnPointerLeave(e);
        SelectBox box = owner;
        if (box != null && box.hoverRow == OptionIndex) {
            box.hoverRow = -1;
            box.Hover.Raise(box);
        }
    }
    public override void OnPointerCancel(RoutedEventArgs e) {
        armed = false;
        SelectBox box = owner;
        if (box != null && box.hoverRow == OptionIndex) {
            box.hoverRow = -1;
            box.Hover.Raise(box);
        }
        base.OnPointerCancel(e);
    }
    public override void OnClick(RoutedEventArgs e) {
        bool pressed = armed; armed = false;
        if (!pressed || this.IsDisabled() || option == null || option.val != downKey || option.label != downLabel) { return; }
        base.OnClick(e);
        this.CommitKey(this.FindApp());
    }
    public void CommitKey(App app) {
        SelectBox box = owner;
        if (box == null || app == null || this.IsDisabled() || box.IsDisabled()) { return; }
        box.CommitFlatOption(OptionIndex, option, session, app, options);
    }
}
