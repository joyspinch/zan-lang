    public SelectBox() : this("", false) { }
    public SelectBox(string hintText) : this(hintText, false) { }
    public SelectBox(string hintText, bool isMulti) {
        this.InitControl("selectbox");
        styleSurfaceOwned = true;
        this.opts = new List<SelectOption>();
        Value = -1;
        this.hint = hintText;
        this.multi = isMulti;
        this.clearable = false;
        this.open = false;
        this.scrollY = 0;
        this.Size = "medium";
        this.status = 0;
        this.maxVisible = 6;
        this.cols = 0;
        this.placement = 0;
        this.filterable = false;
        this.filterText = "";
        this.filteredIdx = null;
        this.wid = this.CommonId();
        this.lastH = 0;
        this.hoverRow = 0 - 1;
        this.wiresOwnEvents = true;
        this.tableColumns = null;
        this.filterHint = "";
        this.cascade = false;
        this.cascadePath = null;
        this.cascRoots = null;
        this.cascadeFilter = null;
        this.cascadeLink = true;
        this.checkStrategy = 0;
        this.showPath = true;
        this.hoverExpand = false;
        this.clearFilterAfter = true;
        this.cascadeCols = null;
        this.treeMode = false;
        this.treeBox = null;
        this.treeSelSeen = 0 - 1;
        this.pathText = "";
        this.popupW = 0;
        this.popupWDirty = true;
        this.optionsRaw = "";
        this.Change = new UiEvent();
        this.Open = new UiEvent();
        this.Close = new UiEvent();
        this.Hover = new UiEvent();
    }
    public List<SelectOption> Options {
        get { return opts; }
        set { opts = value != null ? value : new List<SelectOption>(); popupWDirty = true; }
    }
