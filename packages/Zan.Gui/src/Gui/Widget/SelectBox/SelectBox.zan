    public string SelectedValue() {
        if (Value.Get() >= 0 && Value.Get() < opts.Count) {
            string v = opts[Value.Get()].val;
            return (v != null && v != "") ? v : opts[Value.Get()].label;
        }
        return "";
    }
    public static SelectBox FromOptions(List<string> options, string hint) {
        SelectBox s = new SelectBox(hint, false);
        for (int i = 0; i < options.Count; i = i + 1) {
            s.AddOption(options[i]);
        }
        return s;
    }
    public string OptionsText() {
        string outp = "";
        for (int i = 0; i < opts.Count; i = i + 1) {
            if (i > 0) { outp = outp + "|"; }
            outp = outp + opts[i].label;
        }
        return outp;
    }
    public void SetOptionsText(string text) {
        if (text == optionsRaw && opts != null && opts.Count > 0) { return; }
        optionsRaw = text != null ? text : "";
        popupWDirty = true;
        opts = new List<SelectOption>();
        if (text == null) {
            Value.Set(0 - 1);
            scrollY = 0;
            return;
        }
        string s = text.Trim();
        if (s == "") {
            Value.Set(0 - 1);
            scrollY = 0;
            return;
        }
        if (s.StartsWith("[") && s.EndsWith("]")) {
            JsonValue arr = JsonValue.ParseLenient(s);
            if (arr != null && arr.IsArray()) {
                for (int i = 0; i < arr.Count(); i = i + 1) {
                    JsonValue item = arr.At(i);
                    if (item == null) { continue; }
                    if (item.IsObject()) {
                        string lbl = item.Str("label", "");
                        if (lbl == "") { lbl = item.Str("text", ""); }
                        if (lbl == "") { lbl = item.Str("name", ""); }
                        if (lbl == "") { lbl = item.Str("title", ""); }
                        string v = item.Str("value", "");
                        if (v == "") { v = item.Str("id", ""); }
                        if (v == "") { v = lbl; }
                        if (lbl == "") { lbl = v; }
                        SelectOption opt = new SelectOption(lbl, v, false);
                        opt.disabled = item.Bool("disabled", false);
                        opts.Add(opt);
                    } else {
                        string sv = item.AsString("");
                        opts.Add(new SelectOption(sv, sv, false));
                    }
                }
                if (Value.Get() >= opts.Count) { Value.Set(opts.Count - 1); }
                scrollY = 0;
                return;
            }
        }
        List<string> parts = text.Split("|");
        for (int i = 0; i < parts.Count; i = i + 1) {
            string p = parts[i].Trim();
            if (p != "") { opts.Add(new SelectOption(p, p, false)); }
        }
        if (Value.Get() >= opts.Count) { Value.Set(opts.Count - 1); }
        scrollY = 0;
    }
    public int DisplayCount() {
        List<int> vis = this.VisibleOpts();
        if (vis == null) { return opts.Count; }
        return vis.Count;
    }
    public int RowToOpt(int row) {
        List<int> vis = this.VisibleOpts();
        if (vis == null) {
            if (row < 0 || row >= opts.Count) { return 0 - 1; }
            return row;
        }
        if (row < 0 || row >= vis.Count) { return 0 - 1; }
        return vis[row];
    }
    public int Hovered() { return hoverRow; }
    public string OptionLabel(int i) {
        if (i < 0 || i >= opts.Count) { return ""; }
        return opts[i].label;
    }
    public int ColumnCount() {
        if (this.IsTable()) { return 1; }
        if (cols > 0) { return cols; }
        if (!multi) { return 1; }
        if (maxVisible <= 0) { return 1; }
        int n = (this.DisplayCount() + maxVisible - 1) / maxVisible;
        if (n < 1) { n = 1; }
        if (n > 4) { n = 4; }
        return n;
    }
    public int RowCount() {
        int n = this.ColumnCount();
        int rows = (this.DisplayCount() + n - 1) / n;
        if (rows < 1) { rows = 1; }
        return rows;
    }
    public void SetIndex(int idx) {
        if (idx >= opts.Count) { idx = opts.Count - 1; }
        if (idx < 0) { idx = 0 - 1; }
        Value.Set(idx);
    }
    public void Select(string text) {
        if (text == "" || opts == null) { this.ClearSelection(); return; }
        for (int i = 0; i < opts.Count; i = i + 1) {
            if (opts[i].val == text || opts[i].label == text) {
                this.SetIndex(i);
                return;
            }
        }
    }
    public void ClearSelection() { this.SetIndex(0 - 1); }
    public bool IsOpen() { return open; }
    private static void OnOptionButtonClick(Control sender) {
        if (sender == null) { return; }
        Control cur = sender.Parent();
        while (cur != null) {
            if (cur is SelectBox) {
                SelectBox sb = (SelectBox)cur;
                int idx = Convert.ToInt32(sender.name);
                if (idx >= 0 && idx < sb.opts.Count) {
                    sb.CommitFlatOption(idx, sb.opts[idx], sb.inputSession, sb.FindApp(), sb.opts);
                }
                return;
            }
            cur = cur.Parent();
        }
    }
    public Card EnsurePopupCard() { return this.EnsurePopupCard(this.App); }
    public Card EnsurePopupCard(App app) {
        app = this.ResolveApp(app);
        if (defaultPopupCard == null) {
            defaultPopupCard = new Card("");
            defaultPopupCard.Class = "select-popup";
            defaultPopupCard.Pad(4);
        }
        int session = inputSession; List<SelectOption> options = opts;
        defaultPopupCard.RemoveAll();
        if (!this.InputSessionCurrent(app, session, options)) { return defaultPopupCard; }
        optionPanel = new SelectBoxOptionPanel(this);
        SelectBoxOptionPanel col = optionPanel;
        col.Gap(2);
        List<int> vis = this.VisibleOpts();
        int count = vis != null ? vis.Count : opts.Count;
        for (int row = 0; row < count; row = row + 1) {
            int i = vis != null ? vis[row] : row;
            if (i < 0 || i >= opts.Count) { continue; }
            SelectOption op = opts[i];
            if (op.grp) {
                Label grp = new Label(op.label) { ClassName = "select-group-header small muted" };
                col.Add(grp);
            } else {
                SelectBoxOptionButton item = new SelectBoxOptionButton(this, i, op, opts, inputSession);
                item.AddClass("align-left");
                item.AddClass("select-option");
                item.name = Convert.ToString(i);
                if (Value.Get() == i || (multi && op.chosen)) { item.AddClass("is-selected"); }
                if (op.disabled) { item.Disabled.Set(true); }
                col.Rows.Add(item);
                col.Add(item);
            }
        }
        defaultPopupCard.Content(col);
        if (app != null) {
            defaultPopupCard.UseApp(app);
            defaultPopupCard.OnMeasure(app);
        }
        return defaultPopupCard;
    }
    public void SetOpen(bool v) {
        if (v && this.IsDisabled()) { return; }
        if (open == v) { return; }
        inputSession = inputSession + 1;
        headPressed = false; headPressOptions = null;
        open = v;
        App app = this.FindApp();
        int session = inputSession; List<SelectOption> options = opts;
        if (v) {
            scrollY = 0;
            cascadePath = new List<int>(); cascadeCols = null;
            if (cascade && !multi && Value.Get() >= 0 && Value.Get() < opts.Count) {
                List<int> chain = new List<int>(); int walk = opts[Value.Get()].parentIdx;
                while (walk >= 0 && walk < opts.Count && chain.Count < 3) {
                    chain.Insert(0, walk); walk = opts[walk].parentIdx;
                }
                cascadePath = chain;
            }
            if (filterable && filterBox != null) {
                filterBox.SetText(""); filterText = ""; this.RebuildFilter();
            }
            this.SyncBinding();
            if (!this.InputSessionCurrent(app, session, options) || !open) { return; }
            if (app != null && bw > 0 && bh > 0) { this.MountInputPopup(app); }
            if (!this.InputSessionCurrent(app, session, options) || !open) { return; }
            Open.Raise(this);
        } else {
            App previous = popupApp; Control popup = inputPopup;
            popupApp = null; inputPopup = null;
            hoverRow = -1;
            if (previous != null && popup != null) { previous.overlayHost.Hide(popup); }
            if (!this.InputSessionCurrent(app, session, options) || open) { return; }
            Close.Raise(this);
        }
        if (this.InputSessionCurrent(app, session, options) && app != null) { app.RequestRedraw(); }
    }
    public override void OnPopupDismissed() {
        if (!open) { return; }
        inputSession = inputSession + 1;
        headPressed = false; headPressOptions = null;
        open = false; popupApp = null; inputPopup = null;
        hoverRow = -1;
        Close.Raise(this);
    }
    public void Choose(int idx) {
        if (idx < 0 || idx >= opts.Count) { return; }
        if (opts[idx].grp || opts[idx].disabled) { return; }
        if (multi) {
            opts[idx].chosen = !opts[idx].chosen;
        } else {
            if (Value.Get() == idx) { return; }
            Value.Set(idx);
        }
        Change.Raise(this);
    }
    public static SelectBox Multi(string hintText) { return new SelectBox(hintText, true); }
    public void AddOption(string label) {
        opts.Add(new SelectOption(label, false));
        popupWDirty = true;
    }
    public void AddOption(string label, bool disabled) {
        SelectOption o = new SelectOption(label, false);
        o.flatIdx = opts.Count;
        o.disabled = disabled;
        opts.Add(o);
        popupWDirty = true;
    }
    public void AddGroup(string title) {
        SelectOption o = new SelectOption(title, false);
        o.flatIdx = opts.Count;
        o.grp = true;
        opts.Add(o);
        popupWDirty = true;
    }
    public void Clearable(bool v) { clearable = v; }
    public void Status(int v) { status = v; }
    public void Placement(int v) {
        if (v >= 0 && v <= 2) { placement = v; }
    }
    public void Filterable(bool v) {
        filterable = v;
        if (v) { filterText = ""; }
    }
    public void FilterHint(string s) {
        filterHint = s;
        if (filterBox != null) { filterBox.SetHint(s); }
    }
    public string FilterText() { return filterText; }
    public void SetFilterText(string s) {
        filterText = s;
        if (filterBox != null) { filterBox.SetText(s); }
        scrollY = 0;
        this.RebuildFilter();
    }
    public void RebuildFilter() {
        popupWDirty = true;
        if (!filterable || filterText == "") {
            filteredIdx = null;
            cascadeFilter = null;
            return;
        }
        List<int> r = new List<int>();
        string q = filterText.ToLower();
        if (cascade) {
            for (int i = 0; i < opts.Count; i = i + 1) {
                if (opts[i].grp) { continue; }
                if (opts[i].label.ToLower().Contains(q)) { r.Add(i); }
            }
            cascadeFilter = r;
            cascadeCols = null;
            return;
        }
        bool tbl = this.IsTable();
        int pendingGrp = 0 - 1;
        for (int i = 0; i < opts.Count; i = i + 1) {
            if (opts[i].grp) { pendingGrp = i; continue; }
            bool hit = opts[i].label.ToLower().Contains(q);
            if (!hit && tbl) {
                for (int j = 1; j < this.tableColumns.Count; j = j + 1) {
                    if (opts[i].Cell(j).ToLower().Contains(q)) { hit = true; break; }
                }
            }
            if (hit) {
                if (pendingGrp >= 0) { r.Add(pendingGrp); pendingGrp = 0 - 1; }
                r.Add(i);
            }
        }
        filteredIdx = r;
    }
    public int Selected() { return Value.Get(); }
    public int SelectCount() { return opts.Count; }
    public string SelectedLabel() { return this.OptionLabel(Value.Get()); }
    public string SelectedText() { return this.SelectedLabel(); }
    public void SetSelectedByText(string txt) {
        if (txt == "") {
            this.Select(0 - 1);
            return;
        }
        for (int i = 0; i < opts.Count; i = i + 1) {
            if (opts[i].label == txt) {
                this.Select(i);
                return;
            }
        }
    }
    public bool IsChosen(int i) {
        if (i < 0 || i >= opts.Count) { return false; }
        return opts[i].chosen;
    }
    public bool HasValue() {
        if (multi) {
            for (int i = 0; i < opts.Count; i = i + 1) {
                if (opts[i].chosen) { return true; }
            }
            return false;
        }
        if (pathText != "") { return true; }
        return Value.Get() >= 0 && Value.Get() < opts.Count;
    }
    public void Select(int idx) {
        if (idx < 0) { Value.Set(0 - 1); return; }
        if (idx >= opts.Count) { return; }
        Value.Set(idx);
    }
    public void Clear() {
        Value.Set(0 - 1);
        pathText = "";
        treeSelSeen = 0 - 1;
        cascadeCols = null;
        if (treeBox != null) { treeBox.ClearSelection(); }
        for (int i = 0; i < opts.Count; i = i + 1) {
            opts[i].chosen = false;
        }
    }
    public void ClearOptions() {
        opts = new List<SelectOption>();
        Value.Set(0 - 1);
        scrollY = 0;
        filteredIdx = null;
        popupWDirty = true;
    }
    public int Count() { return opts.Count; }
    public string Text() {
        if (multi) {
            if (cascade) {
                List<string> labs = this.ValueLabels();
                string acc = "";
                for (int i = 0; i < labs.Count; i = i + 1) {
                    if (i > 0) { acc = acc + ", "; }
                    acc = acc + labs[i];
                }
                return acc;
            }
            string acc = "";
            for (int i = 0; i < opts.Count; i = i + 1) {
                if (opts[i].chosen) {
                    if (acc != "") { acc = acc + ", "; }
                    acc = acc + opts[i].label;
                }
            }
            return acc;
        }
        if (cascade) {
            if (Value.Get() >= 0 && Value.Get() < opts.Count) { return this.ValueText(Value.Get()); }
            return pathText;
        }
        if (pathText != "") { return pathText; }
        if (Value.Get() >= 0 && Value.Get() < opts.Count) { return opts[Value.Get()].label; }
        return "";
    }
    public int HeadHeight(Theme t) {
        string cls = this.SizeClassIn(Class);
        if (Style.Has(cls, "tiny")) { return t.heightTiny; }
        if (Style.Has(cls, "small")) { return t.heightSmall; }
        if (Style.Has(cls, "large")) { return t.heightLarge; }
        return t.heightMedium;
    }
    public int FontSize(StyleBox s) { return this.FontSize(this.App, s); }
    public int FontSize(App app, StyleBox s) {
        app = this.ResolveApp(app);
        int sz = this.SizeIdx();
        if (sz == 0) { return s.FontOr(Style.FontFallback(app, "small")); }
        if (sz == 2) { return s.FontOr(Style.FontFallback(app, "large")); }
        return s.FontOr(Style.FontFallback(app, "medium"));
    }
    public int SizeIdx() {
        string cls = this.SizeClassIn(Class);
        if (Style.Has(cls, "tiny") || Style.Has(cls, "small")) { return 0; }
        if (Style.Has(cls, "large")) { return 2; }
        return 1;
    }
    public override string StyleType() { return "select"; }
    public override string EffectiveClass() { return this.StyleClass(); }
    public override bool ChildControlsRenderedByOwner() { return true; }
    public string StyleClass() {
        string cls = this.SizeClassIn(Class);
        string extra = "";
        if (status == 1) { extra = "success"; }
        if (status == 2) { extra = "warning"; }
        if (status == 3) { extra = "error"; }
        if (extra == "") { return cls; }
        return cls == "" ? extra : cls + " " + extra;
    }
    public override void OnMeasure(App app) {
        this.SyncBinding();
        StyleBox normal = this.Box(app);
        prefH = normal.HeightOr(this.HeadHeight(app.theme));
        prefW = normal.WidthOr(app.Scale(200));
    }
    private int ArrowSize(App app, Rect content) {
        StyleBox arrow = this.ResolvePart(app, "arrow", "", Style.SNormal());
        return DropdownChrome.SlotSize(content, arrow.FontOr(app.theme.iconSizeSmall));
    }
    private Rect ClearBounds(App app, Rect content, int arrowSize) {
        StyleBox clear = this.ResolvePart(app, "clear", "", Style.SNormal());
        int size = DropdownChrome.SlotSize(content, clear.FontOr(app.theme.iconSizeSmall));
        int left = content.Right() - arrowSize - app.theme.gapSmall - size;
        if (left < content.x) { size = 0; }
        return new Rect(left, content.y, size, content.height);
    }
    public override void OnPaint(App app) {
        app = this.ResolveApp(app);
        if (app == null || app.canvas == null || bw <= 0 || bh <= 0) { return; }
        StyleBox normal = this.Box(app);
        Rect content = DropdownChrome.ContentBounds(this, normal, app.theme.paddingMedium);
        int arrowSize = this.ArrowSize(app, content);
        int right = content.Right() - arrowSize;
        bool showClear = !this.IsDisabled() && clearable && this.HasValue() && app.focus != null && app.focus.IsHovered(wid);
        Rect clear = null;
        if (showClear) {
            clear = this.ClearBounds(app, content, arrowSize);
            if (clear.width > 0) { right = clear.x; }
        }
        int textWidth = right - content.x - app.theme.gapSmall;
        int font = this.FontSize(app, normal);
        string cls = this.StyleClass();
        StyleBox box = this.ResolveEasedStyleAsIn(
            app, wid, "select", cls, this.IsDisabled(), open, bx, by, bw, bh);
        box.Paint(app, bx, by, bw, bh);
        int state = this.WidgetState(app);
        if (open) { state = state | Style.SSelected(); }
        string shown = this.Text();
        if (multi && cascade && shown != "") {
            CascadePanel.DrawCascadeTagsIn(this, app.canvas, app, cls, state, content, textWidth, font);
        } else if (shown == "") {
            StyleBox placeholder = this.ResolvePart(app, "placeholder", "", state);
            DropdownChrome.PaintLabel(app.canvas, content, textWidth, hint,
                                      placeholder.FontOr(font), placeholder.FgOr(box.fg));
        } else {
            DropdownChrome.PaintLabel(app.canvas, content, textWidth, shown, font, box.fg);
        }
        if (clear != null && clear.width > 0) {
            int clearState = state & ~(Style.SHover() | Style.SActive());
            if (clear.Contains(app.mouseX, app.mouseY)) { clearState = state; }
            StyleBox clearStyle = this.ResolvePart(app, "clear", "", clearState);
            app.canvas.DrawGlyphIn("close", clear.x, clear.y, clear.width, clear.height,
                                   clear.width, clearStyle.FgOr(box.fg));
        }
        StyleBox arrow = this.ResolvePart(app, "arrow", "", state);
        DropdownChrome.PaintArrow(app.canvas, content, arrowSize, arrow.FgOr(box.fg));
    }
    public int PopupWidth(App app, Theme t, int trigWidth, int fs, int arrowSlot) {
        if (this.IsTable()) {
            int sum = t.paddingSmall * 2;
            for (int i = 0; i < this.tableColumns.Count; i = i + 1) {
                sum = sum + this.tableColumns[i].width;
            }
            if (sum < trigWidth) { sum = trigWidth; }
            int roomT = app.canvas.Width() - app.Scale(8);
            if (sum > roomT) { sum = roomT; }
            return sum;
        }
        if (!popupWDirty && popupW > 0) {
            int w0 = popupW;
            if (w0 < trigWidth) { w0 = trigWidth; }
            return w0;
        }
        int n = this.ColumnCount();
        int colW = trigWidth / n;
        int chrome = t.paddingSmall * 2 + arrowSlot;
        for (int i = 0; i < opts.Count; i = i + 1) {
            int tw = Canvas.MeasureText(opts[i].label, fs) + chrome;
            if (tw > colW) { colW = tw; }
        }
        int w = colW * n;
        if (w < trigWidth) { w = trigWidth; }
        int room = app.canvas.Width() - app.Scale(8);
        if (w > room) { w = room; }
        popupW = w;
        popupWDirty = false;
        return w;
    }
    public int FilterBarH() { return this.FilterBarH(this.App); }
    public int FilterBarH(App app) {
        if (!filterable) { return 0; }
        app = this.ResolveApp(app);
        return app != null ? app.Scale(32) : 32;
    }
    public List<int> VisibleOpts() {
        if (!filterable || filterText == "") { return null; }
        if (filteredIdx == null) { this.RebuildFilter(); }
        if (filteredIdx == null) { return null; }
        return filteredIdx;
    }
    public override bool MountSlot(string slot, Control c) {
        if (slot == "popup" || slot == "dropdown" || slot == "content") {
            this.SetPopupContent(c);
            return true;
        }
        return base.MountSlot(slot, c);
    }
    public void SetPopupContent(Control c) {
        Control previous = customPopup;
        if (previous == c) { return; }
        App app = this.FindApp();
        int session = inputSession; List<SelectOption> options = opts;
        bool reopen = open;
        if (reopen) {
            this.SetOpen(false); session = session + 1;
            if (!this.InputSessionCurrent(app, session, options) || open || customPopup != previous) { return; }
        }
        if (previous != null && previous.parent == this) { this.Remove(previous); }
        if (!this.InputSessionCurrent(app, session, options) || open || customPopup != previous) { return; }
        customPopup = c;
        if (c != null && this.IndexOf(c) < 0) { this.Add(c); }
        if (!this.InputSessionCurrent(app, session, options) || open || customPopup != c) { return; }
        if (reopen) { this.SetOpen(true); }
    }
    public Control GetPopupContent() { return this.customPopup; }
    public override void OnPaintOverlay(App app) {
    }
}
