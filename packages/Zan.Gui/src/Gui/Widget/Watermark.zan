using System;
using Gui;
namespace Gui.Widget;
[GuiKind("Watermark")]
public class Watermark : Control {
    public override Control CreateCloneShell() { return new Watermark(); }
    public Binding<string> Content;
    public string Src;
    public int Color;
    public int FontPx;
    public int Rotate;
    public int GapX;
    public int GapY;
    public int OffsetX;
    public int OffsetY;
    public int LineHeight;
    public int TileW;
    public int TileH;
    public int TextAlign;
    public int Weight;
    public bool NoClip;
    private void InitWatermark() {
        this.InitControl("watermark");
        Content = "";
        Src = "";
        Color = 0;
        FontPx = 0;
        Rotate = 0 - 22;
        GapX = 100;
        GapY = 100;
        OffsetX = 0;
        OffsetY = 0;
        LineHeight = 0;
        TileW = 0;
        TileH = 0;
        TextAlign = 0;
        Weight = 0;
        NoClip = false;
    }
    public Watermark() { this.InitWatermark(); }
    public Watermark(string content) {
        this.InitWatermark();
        Content = content;
    }
    public int RotClamped() {
        int r = Rotate;
        if (r < 0 - 90) { r = 0 - 90; }
        if (r > 90) { r = 90; }
        return r;
    }
    public int EffectiveFont(StyleBox s) { return this.EffectiveFont(this.App, s); }
    public int EffectiveFont(App app, StyleBox s) {
        app = this.ResolveApp(app);
        if (FontPx > 0) { return app != null ? app.Scale(FontPx) : FontPx; }
        return s.FontOr(app != null ? app.Scale(14) : 14);
    }
    public int EffectiveColor(StyleBox s) {
        if (Color != 0) { return Color; }
        return s.FgOr(0);
    }
    public override void OnPaint(App app) {
        if (bw <= 0 || bh <= 0) { return; }
        StyleBox s = this.ResolveStyleCached(app, this.StyleType(), Class,
                                             Style.SNormal());
        string src = Src;
        if (src == null) { src = ""; }
        Canvas c = app.canvas;
        if (!NoClip) { c.PushClip(bx, by, bw, bh); }
        if (src != "") {
            this.PaintImageTiles(app, c, src);
        } else {
            this.PaintTextTiles(app, c, s);
        }
        if (!NoClip) { c.PopClip(); }
    }
    private void PaintTextTiles(App app, Canvas c, StyleBox s) {
        string text = Content.Get();
        if (text == null) { text = ""; }
        if (text == "") { return; }
        List<string> lines = text.Split("\n");
        int fs = this.EffectiveFont(app, s);
        int color = this.EffectiveColor(s);
        int lineH = Canvas.FontHeight(fs);
        if (LineHeight > 0) { lineH = app.Scale(LineHeight); }
        int tileW = 0;
        for (int i = 0; i < lines.Count; i = i + 1) {
            int w = Canvas.MeasureText(lines[i], fs);
            if (w > tileW) { tileW = w; }
        }
        if (TileW > 0) { tileW = app.Scale(TileW); }
        int tileH = lineH * lines.Count;
        if (TileH > 0 && app.Scale(TileH) > tileH) { tileH = app.Scale(TileH); }
        int pitchX = tileW + app.Scale(GapX);
        int pitchY = tileH + app.Scale(GapY);
        if (pitchX <= 0 || pitchY <= 0) { return; }
        int offX = app.Scale(OffsetX);
        int offY = app.Scale(OffsetY);
        int rot = this.RotClamped();
        int bold = Weight >= 600 ? 1 : 0;
        double rad = (double)rot * 3.14159265358979323846 / 180.0;
        double cs = Math.Cos(rad);
        double sn = Math.Sin(rad);
        for (int ty = by - pitchY + offY; ty < by + bh + pitchY + offY;
             ty = ty + pitchY) {
            for (int tx = bx - pitchX + offX; tx < bx + bw + pitchX + offX;
                 tx = tx + pitchX) {
                this.PaintTextTile(c, lines, tx, ty, tileW, lineH, fs, color,
                                   rot, bold, cs, sn);
            }
        }
    }
    private void PaintTextTile(Canvas c, List<string> lines, int tx, int ty,
                               int tileW, int lineH, int fs, int color, int rot,
                               int bold, double cs, double sn) {
        int cx = tx + tileW / 2;
        int cy = ty + lineH * lines.Count / 2;
        for (int i = 0; i < lines.Count; i = i + 1) {
            int lx = tx;
            if (tileW > 0) {
                int lw = Canvas.MeasureText(lines[i], fs);
                if (TextAlign == 1) { lx = tx + (tileW - lw) / 2; }
                else if (TextAlign == 2) { lx = tx + tileW - lw; }
                if (lx < tx) { lx = tx; }
            }
            if (rot == 0) {
                c.DrawText(lx, ty + i * lineH, lines[i], color, fs);
                if (bold == 1) { c.DrawText(lx + 1, ty + i * lineH, lines[i], color, fs); }
                continue;
            }
            int dx = lx - cx;
            int dy = ty + i * lineH - cy;
            int ax = cx + (int)(cs * (double)dx - sn * (double)dy);
            int ay = cy + (int)(sn * (double)dx + cs * (double)dy);
            c.DrawTextRot(ax, ay, lines[i], color, fs, rot);
            if (bold == 1) { c.DrawTextRot(ax + 1, ay, lines[i], color, fs, rot); }
        }
    }
    private void PaintImageTiles(App app, Canvas c, string src) {
        int iw = Canvas.ImageWidth(src);
        int ih = Canvas.ImageHeight(src);
        if (iw <= 0 || ih <= 0) { return; }
        int w = app.Scale(iw);
        int h = app.Scale(ih);
        int pitchX = w + app.Scale(GapX);
        int pitchY = h + app.Scale(GapY);
        if (pitchX <= 0 || pitchY <= 0) { return; }
        int offX = app.Scale(OffsetX);
        int offY = app.Scale(OffsetY);
        for (int ty = by - pitchY + offY; ty < by + bh + pitchY + offY;
             ty = ty + pitchY) {
            for (int tx = bx - pitchX + offX; tx < bx + bw + pitchX + offX;
                 tx = tx + pitchX) {
                c.BlitImage(src, tx, ty, w, h, 0, 0, 0, 0);
            }
        }
    }
    public override string Kind() { return "Watermark"; }
    protected override List<PropSpec> DefineProps() {
        List<PropSpec> ps = new List<PropSpec>();
        ps.Add(PropSpec.Text("content", "Content").Field("Content", 0));
        ps.Add(PropSpec.Text("src", "Image Src").Field("Src", 0));
        ps.Add(PropSpec.Color("color", "Color").Field("Color", 1));
        ps.Add(PropSpec.Int("fontpx", "Font Size").Field("FontPx", 1));
        ps.Add(PropSpec.Int("rotate", "Rotate").Field("Rotate", 1));
        ps.Add(PropSpec.Int("gapx", "Gap X").Field("GapX", 1));
        ps.Add(PropSpec.Int("gapy", "Gap Y").Field("GapY", 1));
        ps.Add(PropSpec.Int("offsetx", "Offset X").Field("OffsetX", 1));
        ps.Add(PropSpec.Int("offsety", "Offset Y").Field("OffsetY", 1));
        ps.Add(PropSpec.Int("lineheight", "Line Height").Field("LineHeight", 1));
        ps.Add(PropSpec.Int("tilew", "Tile Width").Field("TileW", 1));
        ps.Add(PropSpec.Int("tileh", "Tile Height").Field("TileH", 1));
        PropSpec ta = PropSpec.Enum("textalign", "Text Align",
            new List<string> { "left", "center", "right" });
        ta.Field("TextAlign", 1);
        ps.Add(ta);
        ps.Add(PropSpec.Int("weight", "Weight").Field("Weight", 1));
        ps.Add(PropSpec.Bool("noclip", "Cross Boundary").Field("NoClip", 2));
        return ps;
    }
}
