using System;
using Gui;

namespace Gui.Widget;

// 加载占位控件：一个纯色填充框。填充和圆角来自
// `skeleton` CSS 规则，皮肤可一次性重设所有占位符，而
// 代码侧只需简单赋值：
// 类：`text` 是一行文字，`circle` 是圆形标记（头像
// 占位符），`shimmer` 动画类可让任意一种动起来。
public class Skeleton : Control {
    // 占位符尺寸（CSS px）；`width` / `height` 规则优先于此值。
    public int Width;
    public int Height;

    // 初始化：占位尺寸（CSS px）。
    private void InitSkeleton(int w, int h) {
        this.InitControl("skeleton", 1);
        Width = w;
        Height = h;
    }

    // 默认 200×16（设计器用）。
    public Skeleton() { InitSkeleton(200, 16); }
    // 指定尺寸（CSS px）。
    public Skeleton(int w, int h) { InitSkeleton(w, h); }

    // 解析 `skeleton` 样式盒（Class 参与匹配）。
    public StyleBox ResolvedStyle() { return this.ResolvedStyle(this.App); }
    public StyleBox ResolvedStyle(App app) {
        app = this.ResolveApp(app);
        return this.ResolveStyleAs(app, "skeleton", Class, Style.SNormal());
    }

    // 覆写：首选尺寸取样式宽高，缺省用 Width/Height。
    public override void OnMeasure(App app) {
        StyleBox s = this.ResolvedStyle(app);
        prefW = s.WidthOr(app.Scale(Width));
        prefH = s.HeightOr(app.Scale(Height));
    }

    // 占位框本身：填充、圆角和阴影均由基类 PaintStyleBox 盒模型统一接管。
    public override void OnPaint(App app) {
    }

    // 一行 `width` px 宽的占位文字，高度与所代表的文本一致。
    public static Skeleton Line(int width) {
        return Skeleton.Line(App.FrameApp(), width);
    }
    public static Skeleton Line(App app, int width) {
        int h = Canvas.FontHeight(Style.Of(app, "skeleton", "text",
                                           Style.SNormal())
            .FontOr(Style.FontFallback(app, "medium")));
        Skeleton s = new Skeleton(width, h);
        s.Class = "text";
        return s;
    }

    // ---- 设计器 / 序列化模型 -------------------------------------

    // 控件类型标识（序列化/设计器用）。
    public override string Kind() { return "Skeleton"; }

    // 覆写：返回设计器属性清单（宽 / 高 / 类）。
    public override List<PropSpec> Props() {
        List<PropSpec> ps = new List<PropSpec>();
        PropSpec w = PropSpec.Int("width", "Width");
        w.num = Width;
        ps.Add(w);
        PropSpec h = PropSpec.Int("height", "Height");
        h.num = Height;
        ps.Add(h);
        return ps;
    }
}
