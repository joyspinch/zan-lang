using Gui;
using System.Collections.Generic;
using System;

namespace Gui.Widget;

public class Column : Flex {
    // 按父类种类上报：序列化与自动化以 "Flex" 识别本控件。
    public override string Kind() { return "Flex"; }
    public Column() {
        InitFlex("column");
    }
    public Column(List<Control> items) : this() {
        if (items != null) { this.Children(items); }
    }
    public Column Gap(int px) { this.gap = px; return this; }
    public Column Align(string mode) { base.Align(mode); return this; }
    public Column AlignCenter() { base.AlignCenter(); return this; }
    public Column AlignStart() { base.AlignStart(); return this; }
    public Column AlignEnd() { base.AlignEnd(); return this; }
    public Column Justify(string mode) { base.Justify(mode); return this; }
    public Column Children(List<Control> items) {
        if (items != null) {
            for (int i = 0; i < items.Count; i = i + 1) {
                this.Add(items[i]);
            }
        }
        return this;
    }
    public Column Child(Control c) { this.Add(c); return this; }
}

public class Row : Flex {
    public override Control CreateCloneShell() { return new Row(); }
    public Row() {
        InitFlex("row");
        this.AlignItems = "center";
    }
    public Row(List<Control> items) : this() {
        if (items != null) { this.Children(items); }
    }
    public Row Gap(int px) { this.gap = px; return this; }
    public Row Align(string mode) { base.Align(mode); return this; }
    public Row AlignCenter() { base.AlignCenter(); return this; }
    public Row AlignStart() { base.AlignStart(); return this; }
    public Row AlignEnd() { base.AlignEnd(); return this; }
    public Row Justify(string mode) { base.Justify(mode); return this; }
    public Row Children(List<Control> items) {
        if (items != null) {
            for (int i = 0; i < items.Count; i = i + 1) {
                this.Add(items[i]);
            }
        }
        return this;
    }
    public Row Child(Control c) { this.Add(c); return this; }
}

public class Center : Flex {
    public Center() {
        InitFlex("row");
        this.Center();       // justify-center
        this.AlignCenter();  // align-center
        this.grow = true;
    }
    public Center(Control child) : this() {
        if (child != null) { this.Add(child); }
    }

}

public class Spacer : Control {
    public override Control CreateCloneShell() { return new Spacer(); }
    public Spacer() {
        InitControl("spacer");
        this.grow = true;
        this.AddClass("grow");
    }
    public static Spacer Create() {
        return new Spacer();
    }

    protected override List<PropSpec> DefineProps() {
        List<PropSpec> ps = new List<PropSpec>();
        ps.Add(this.SizeProp());
        return ps;
    }
    protected override bool PaintWithinBounds() { return this.Kind() == "Spacer"; }
    public override void OnPaint(App app) { }
}

public class View : Control {
    public override Control CreateCloneShell() { return new View(); }
    public View() {
        this.InitControl("view");
        styleSurfaceOwned = true;
    }
    public View(string name) {
        this.InitControl(name);
        styleSurfaceOwned = true;
    }
    public override int StyleDisplay() {
        if (computedStyle != null && computedStyle.display != 0) {
            return computedStyle.display;
        }
        return 1;
    }
    public override string Kind() { return "View"; }
    public override string StyleType() { return "view"; }
}

public class GridItem : Control {
    public override Control CreateCloneShell() { return new GridItem(); }
    private int span;
    private int offset;
    private void InitItem(int sp, int off) {
        this.InitControl("gridItem");
        span = sp;
        if (span < 1) { span = 1; }
        offset = off;
        if (offset < 0) { offset = 0; }
    }
    public GridItem() { InitItem(1, 0); }
    public GridItem(int sp) { InitItem(sp, 0); }
    public GridItem(int sp, int off) { InitItem(sp, off); }
    // 皮肤样式类型键："griditem"。
    public override string StyleType() { return "griditem"; }
    public int Span() { return span; }
    public int Offset() { return offset; }
    public int SpanCount {
        get { return this.span; }
        set { this.SetSpan(value); }
    }
    public int OffsetCount {
        get { return this.offset; }
        set { this.SetOffset(value); }
    }
    public void SetSpan(int sp) {
        span = sp;
        if (span < 1) { span = 1; }
    }
    public void SetOffset(int off) {
        offset = off;
        if (offset < 0) { offset = 0; }
    }
    protected override List<PropSpec> DefineProps() {
        List<PropSpec> ps = new List<PropSpec>();
        ps.Add(PropSpec.Int("span", "Span").Field("span").Setter("SetSpan"));
        ps.Add(PropSpec.Int("offset", "Offset").Field("offset").Setter("SetOffset"));
        return ps;
    }
}

public class TextBlock : Label {
    public override Control CreateCloneShell() { return new TextBlock(); }
    public TextBlock() : base("") { }
    public TextBlock(string text) : base(text) { }
    public override string Kind() { return "TextBlock"; }
}

public class Typography : Label {
    public override Control CreateCloneShell() { return new Typography(); }
    public Typography() : base("") { }
    public Typography(string txt) : base(txt) { }
    public static string HeadingClass(int level) {
        switch (level) {
            case 2: return "h2";
            case 3: return "h3";
            case 4: return "h4";
            case 5: return "h5";
            case 6: return "h6";
            default: return "h1";
        }
    }
    public static Typography H(string txt, int level) {
        Typography t = new Typography(txt);
        t.Class = Typography.HeadingClass(level);
        return t;
    }
    public static Typography P(string txt) {
        Typography t = new Typography(txt);
        t.Class = "paragraph";
        return t;
    }
    public override string StyleType() { return "label"; }
}
