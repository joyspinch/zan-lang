using System;
using Gui;
namespace Gui.Widget;
internal class StepClickAction {
    private weak Steps owner;
    private int stepIndex;
    internal StepClickAction(Steps steps, int index) {
        owner = steps;
        stepIndex = index;
    }
    internal void Invoke() {
        Steps steps = owner;
        if (steps == null || steps.IsDisabled()) { return; }
        if (steps.Current != null && steps.Current.Get() != stepIndex) {
            steps.Current.Set(stepIndex);
            steps.Change.Raise(steps);
            steps.RequestRedraw();
        }
    }
}
public class Steps : Control {
    public override Control CreateCloneShell() { return new Steps(); }
    public List<Step> steps;
    public Binding<int> Current;
    public int ErrorIndex;
    public Binding<string> Size;
    public string Placement;
    public string Status;
    public string FinishIcon;
    public string ErrorIcon;
    public bool Clickable;
    // 点击已到达步骤时触发（`Clickable` 下命中才触发）。
    [Event]
    public UiEvent Change;
    private int iconPx;
    private int lastBuiltCurrent = -1;
    private int lastBuiltError = -2;
    private void InitSteps(Binding<int> current) {
        this.InitControl("steps");
        steps = new List<Step>();
        Current = 0;
        if (current != null) { Current = current; }
        ErrorIndex = -1;
        Size = "medium";
        Placement = "";
        Status = "";
        FinishIcon = "";
        ErrorIcon = "";
        Clickable = false;
        Change = new UiEvent();
        iconPx = 0;
    }
    public Steps(Binding<int> current) { InitSteps(current); }
    public Steps() { InitSteps(0); }
    public Steps(List<string> labels, Binding<int> current) : this(current) {
        if (labels != null) {
            for (int i = 0; i < labels.Count; i = i + 1) { this.AddStep(labels[i]); }
        }
    }
    public void AddStep(string label) { steps.Add(new Step(label, "", "")); }
    public void AddStepDesc(string label, string desc) { steps.Add(new Step(label, desc, "")); }
    public void AddStepIcon(string label, string icon) { steps.Add(new Step(label, "", icon)); }
    public void AddStepIconDesc(string label, string desc, string icon) {
        steps.Add(new Step(label, desc, icon));
    }
    public bool IsVertical() { return Style.Has(Class, "vertical"); }
    public bool IsRight() { return Placement == "right"; }
    private int RowGap(App app) { return app.Scale(48); }
    public static string StatusNorm(string v) {
        if (v == "success" || v == "error" || v == "warning") { return v; }
        return "";
    }
    public string StatusCls() {
        string st = Steps.StatusNorm(Status);
        if (st == "") { return ""; }
        return " " + st;
    }
    public override void OnMeasure(App app) {
        string origClass = Class;
        this.ApplySizeClass();
        this.AddClass(this.StatusCls());
        this.SwitchClass("right", this.IsRight());
        StyleBox s = this.ResolveStyleAs(app, "steps", Class, Style.SNormal());
        if (this.IsVertical()) {
            int count = steps.Count;
            if (count < 1) { count = 1; }
            prefH = count * this.RowGap(app);
            prefW = s.WidthOr(app.Scale(280));
        } else {
            StyleBox ds = Style.Part(app, "steps", "description", "", Class,
                                     "", Style.SNormal());
            prefH = s.HeightOr(app.Scale(13) * 2 + app.Scale(8)
                + Canvas.FontHeight(ds.FontOr(Style.FontFallback(app, "small"))));
            prefW = s.WidthOr(app.Scale(320));
        }
        Class = origClass;
    }
    public override int StyleDisplay() { return 1; } // Flex
    public override int StyleFlexDir() { return this.IsVertical() ? 1 : 0; }
    public void BuildSteps() {
        this.RemoveAll();
        this.SwitchClass("right", this.IsRight());
        int iconSize = 16;
        string sc = this.SizeCls();
        if (sc == "tiny") { iconSize = 12; }
        else if (sc == "small") { iconSize = 14; }
        else if (sc == "large") { iconSize = 18; }
        bool vert = this.IsVertical();
        bool right = this.IsRight();
        int current = Current != null ? Current.Get() : 0;
        int errorIndex = ErrorIndex;
        lastBuiltCurrent = current;
        lastBuiltError = errorIndex;
        int count = steps.Count;
        for (int i = 0; i < count; i = i + 1) {
            Step st = steps[i];
            string state = "pending";
            if (i == errorIndex) { state = "error"; }
            else if (i < current) { state = "done"; }
            else if (i == current) { state = "active"; }
            Control stepNode = new Control();
            string lastCls = (i == count - 1) ? " last" : "";
            stepNode.ClassName = vert ? ("step-item row " + state + lastCls) : ("step-item row align-center " + state + lastCls);
            Control marker = new Control();
            marker.ClassName = "step-marker align-center justify-center";
            string ic = st.icon;
            if (ic == "" && state == "done") { ic = FinishIcon != "" ? FinishIcon : "check"; }
            if (ic == "" && state == "error") { ic = ErrorIcon != "" ? ErrorIcon : "close"; }
            if (ic != "") {
                IconView iv = new IconView(ic, iconSize);
                marker.Add(iv);
            } else {
                Label numLbl = new Label(Convert.ToString(i + 1));
                numLbl.ClassName = "step-number";
                marker.Add(numLbl);
            }
            Control textNode = new Control();
            textNode.ClassName = right ? "step-content row align-center" : "step-content col";
            Label titleLbl = new Label(st.label);
            titleLbl.ClassName = "step-title";
            textNode.Add(titleLbl);
            if (st.desc != "") {
                Label descLbl = new Label(st.desc);
                descLbl.ClassName = "step-desc text-tertiary";
                textNode.Add(descLbl);
            }
            if (Clickable && i <= current && i != errorIndex) {
                StepClickAction action = new StepClickAction(this, i);
                stepNode.Click.Add(action.Invoke);
            }
            if (vert) {
                Control rail = new Control();
                rail.ClassName = "step-rail col align-center";
                rail.Add(marker);
                if (i < count - 1) {
                    Control conn = new Control();
                    conn.ClassName = "step-connector flex-1 " + (i < current ? "done" : "pending");
                    rail.Add(conn);
                }
                stepNode.Add(rail);
                stepNode.Add(textNode);
            } else {
                stepNode.Add(marker);
                stepNode.Add(textNode);
                if (i < count - 1) {
                    Control conn = new Control();
                    conn.ClassName = "step-connector flex-1 " + (i < current ? "done" : "pending");
                    stepNode.Add(conn);
                }
            }
            this.Add(stepNode);
        }
    }
    public override void CloneContentTo(Control target, CloneTreeFn clone) {
        Steps copy = (Steps)target;
        // 属性重放已按 items 文本写过一遍；这里以完整模型（含图标）为准重建。
        copy.steps = new List<Step>();
        for (int i = 0; i < steps.Count; i = i + 1) {
            copy.steps.Add(new Step(steps[i].label, steps[i].desc, steps[i].icon));
        }
        copy.BuildSteps();
    }
    public override Binding<string> SizeOf() { return Size; }

    public override void SyncBinding() {
        base.SyncBinding();
        this.ApplySizeClass();
        this.SwitchClass("right", this.IsRight());
        this.SwitchClass("success", Steps.StatusNorm(Status) == "success");
        this.SwitchClass("error", Steps.StatusNorm(Status) == "error");
        this.SwitchClass("warning", Steps.StatusNorm(Status) == "warning");
        int cur = Current != null ? Current.Get() : 0;
        if (steps.Count > 0 && (this.ChildCount() == 0 || cur != lastBuiltCurrent || ErrorIndex != lastBuiltError)) {
            lastBuiltCurrent = cur;
            lastBuiltError = ErrorIndex;
            this.BuildSteps();
        }
    }
    protected override void OnPropertyChanged(PropSpec spec) {
        if (this.ChildCount() > 0 && spec != null
            && (spec.key == "placement" || spec.key == "current"
                || spec.key == "error" || spec.key == "finishIcon"
                || spec.key == "errorIcon" || spec.key == "clickable")) {
            this.BuildSteps();
        }
    }

    // 整体状态（规范化为 ""/success/error/warning）。
    public void SetStatus(string v) { Status = Steps.StatusNorm(v); }

    // 覆写：返回设计器属性清单（当前步 / 错误步 / 尺寸 / 位置 / 状态 / 图标 / 可点击 / 类）。
    protected override List<PropSpec> DefineProps() {
        List<PropSpec> ps = new List<PropSpec>();
        PropSpec cur = PropSpec.Int("current", "Current step").DefaultBinding();
        // 属性通道优先指向活的外部绑定（§6.1 单协议）。
        cur.Field("Current");
        cur.Also("value");
        cur.Also("data");
        ps.Add(cur);
        ps.Add(PropSpec.Int("error", "Errored step").Field("ErrorIndex"));
        PropSpec sz = PropSpec.Enum("size", "Size",
            PropSpec.Sizes3());
        sz.Field("Size");
        ps.Add(sz);
        PropSpec plc = PropSpec.Enum("placement", "Placement",
            new List<string>{ "", "right" });
        plc.Field("Placement").WithTip("Right puts the secondary text beside the title instead of below the circles.");
        ps.Add(plc);
        PropSpec st = PropSpec.Enum("status", "Status",
            new List<string>{ "", "success", "error", "warning" });
        st.Field("Status").Setter("SetStatus").WithTip("Whole-flow status overriding per-step states.");
        ps.Add(st);
        ps.Add(PropSpec.Text("items", "Steps").Accessor("ItemsText", "SetItemsText"));
        ps.Add(PropSpec.Text("finishIcon", "Finish icon").Field("FinishIcon").WithTip("Done-state glyph (\"check\" default)."));
        ps.Add(PropSpec.Text("errorIcon", "Error icon").Field("ErrorIcon").WithTip("Error-state glyph (\"!\" default)."));
        ps.Add(PropSpec.Bool("clickable", "Clickable").Field("Clickable"));
        return ps;
    }
    public string ItemsText() {
        string s = "";
        for (int i = 0; i < steps.Count; i = i + 1) {
            if (s != "") { s = s + "|"; }
            s = s + steps[i].label;
            if (steps[i].desc != "") { s = s + "=" + steps[i].desc; }
        }
        return s;
    }
    public void SetItemsText(string spec) {
        steps = new List<Step>();
        if (spec == null || spec == "") { return; }
        List<string> parts = spec.Split("|");
        for (int i = 0; i < parts.Count; i = i + 1) {
            string it = parts[i];
            if (it == "") { continue; }
            int eq = it.IndexOf("=");
            if (eq > 0) {
                this.AddStepDesc(it.Substring(0, eq),
                                 it.Substring(eq + 1, it.Length - eq - 1));
            } else {
                this.AddStep(it);
            }
        }
        this.BuildSteps();
    }
}
