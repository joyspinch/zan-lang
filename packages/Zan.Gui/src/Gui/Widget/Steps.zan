using System;
using Gui;

namespace Gui.Widget;

// 步骤指示器（Naive UI n-steps）：编号圆点由连接线串联，当前
// 步骤从信号读取。圆点、连接线和标签都是样式部件
// （`steps::marker`、`::connector`、`::title`、`::description`），每个部件按
// 步骤状态解析为类，皮肤可重设样式，代码侧只需
// 简单赋值：
// s.AddStep("Details");
// s.ErrorIndex = 1;
// 类：`vertical` 纵向堆叠步骤；语义角色（`primary` … `error`）
// 选择强调色；皮肤可针对每步状态类 `done`、
// `active`、`pending` 和 `error` 设置样式。
public class Steps : Control {
    // 全部步骤（AddStep 一族追加）。
    public List<Step> steps;
    // 当前步骤内部信号（SyncBinding 自 data 拉入，点击写回）。
    public SignalInt model;
    // 双向绑定当前步骤：`steps.data = wizard.step;` 保持模型
    // 字段与指示器同步（编译器降级的 Binding）。可选；
    // 未设置时指示器仅读取内部 SignalInt。
    public Binding<int> data;
    // 标记为出错的步骤；-1 表示无。
    public int ErrorIndex;
    // 尺寸变体：small / medium / large（Naive UI size prop）。
    // Binding<string> 支持响应式换档。
    public Binding<string> Size;
    // 次要文字的摆放（Naive UI placement）：""（默认，标题在圆点行
    // 下方、整列对齐圆点）或 "right"（描述接到标题右列，横向模式的
    // Naive vertical 变体）。
    public string Placement;
    // 整条流程的语义状态（Naive UI status）：success / error /
    // warning 覆盖每步状态解析——所有步骤按该状态的 class 解析
    // （`steps success`），空白 = 按各步与当前步的相对位置（默认）。
    public string Status;
    // 全部完成态的图标名（`finish` 状态的 `finishIcon`），
    // "" = 默认对勾。
    public string FinishIcon;
    // 出错圆点的图标名，"" = 默认 "!"。
    public string ErrorIcon;
    // 允许点击已到达的步骤来切换当前步骤（Naive UI 在
    // `on-update:current` 存在时可点）。true 时每步注册命中矩形，
    // 点击 >= 0 且 < 当前步的落点写入模型。
    public bool Clickable;
    // 点击已到达步骤时触发（`Clickable` 下命中才触发）。
    public UiEvent Change;
    // 步骤图标的兜底尺寸（标题字号）。
    private int iconPx;

    // 公共初始化（各构造共用）。
    private void InitSteps(SignalInt m) {
        this.InitControl("steps", 1);
        steps = new List<Step>();
        model = m;
        ErrorIndex = -1;
        Size = "medium";
        Placement = "";
        Status = "";
        FinishIcon = "";
        ErrorIcon = "";
        Clickable = false;
        Change = new UiEvent();
        iconPx = 0;
    }

    // 由调用方信号驱动当前步骤。
    public Steps(SignalInt m) { InitSteps(m); }

    // 自持信号：`Steps s = new Steps();`，之后通过 `.data` 双向绑定当前
    // 步骤——调用点无需任何信号接线。
    public Steps() { InitSteps(new SignalInt(0)); }

    // 基于标签列表构造步骤指示器。
    public Steps(List<string> labels, SignalInt m) : this(m) {
        if (labels != null) {
            for (int i = 0; i < labels.Count; i = i + 1) { this.AddStep(labels[i]); }
        }
    }

    // 将绑定的模型值拉入本地信号（model -> UI）。
    public override void SyncBinding() {
        if (data == null) { return; }
        int cur = data.Get();
        if (cur != model.Get()) { model.Set(cur); }
    }

    // 添加一步（无描述、默认圆点图标）。
    public void AddStep(string label) {
        steps.Add(new Step(label, "", ""));
    }

    // 添加一个带次要描述行的步骤。
    public void AddStepDesc(string label, string desc) {
        steps.Add(new Step(label, desc, ""));
    }

    // 添加一个自定义图标的步骤（`icon` 为图标组件认识的语义名；
    // 空串 = 按状态绘制默认圆点）。
    public void AddStepIcon(string label, string icon) {
        steps.Add(new Step(label, "", icon));
    }

    // 图标 + 描述一步到位。
    public void AddStepIconDesc(string label, string desc, string icon) {
        steps.Add(new Step(label, desc, icon));
    }

    // 是否为纵向堆叠（Class 含 `vertical`）。
    public bool IsVertical() { return Style.Has(Class, "vertical"); }

    // 次要信息（标题右列 vs 圆点行下方的整列）。
    public bool IsRight() { return Placement == "right"; }

    // 纵向/右列模式的行距。
    private int RowGap(App app) { return app.Scale(48); }

    // `Status` 白名单归一：只认 success / error / warning，脏值回 ""。
    public static string StatusNorm(string v) {
        if (v == "success" || v == "error" || v == "warning") { return v; }
        return "";
    }

    // 流程整体状态的 class 片段（`steps success`）。
    public string StatusCls() {
        string st = Steps.StatusNorm(Status);
        if (st == "") { return ""; }
        return " " + st;
    }

    // 覆写：竖向/right 按行数测高，横向取标题 + 描述两行高；宽取样式或内容兜底。
    public override void OnMeasure(App app) {
        string origClass = Class;
        this.ApplySizeClass();
        this.AddClass(this.StatusCls());
        StyleBox s = this.ResolveStyleAs(app, "steps", Class, Style.SNormal());
        if (this.IsVertical() || this.IsRight()) {
            int count = steps.Count;
            if (count < 1) { count = 1; }
            prefH = count * this.RowGap(app);
            prefW = s.WidthOr(app.Scale(280));
        } else {
            StyleBox ds = Style.Part(app, "steps", "description", "", Class,
                                     "", Style.SNormal());
            prefH = s.HeightOr(app.Scale(13) * 2 + app.Scale(8)
                + Canvas.FontHeight(ds.FontOr(Style.FontFallback(app, "small"))));
            prefW = s.WidthOr(app.Scale(320));
        }
        Class = origClass;
    }

    public override int StyleDisplay() { return 1; } // Flex
    public override int StyleFlexDir() { return this.IsVertical() ? 1 : 0; }

    // 声明式构建步骤条子树
    public void BuildSteps() {
        this.children.Clear();
        int current = model != null ? model.Get() : 0;
        int errorIndex = ErrorIndex;
        int count = steps.Count;
        for (int i = 0; i < count; i = i + 1) {
            Step st = steps[i];
            string state = "pending";
            if (i == errorIndex) { state = "error"; }
            else if (i < current) { state = "done"; }
            else if (i == current) { state = "active"; }

            Control stepNode = new Control();
            stepNode.ClassName = "step-item " + (this.IsVertical() ? "col" : "row") + " align-center " + state;

            // 1. 指示标记（圆点/图标）
            Control marker = new Control();
            marker.ClassName = "step-marker align-center justify-center";
            string ic = st.icon;
            if (ic == "" && state == "done") { ic = FinishIcon != "" ? FinishIcon : "check"; }
            if (ic == "" && state == "error") { ic = ErrorIcon != "" ? ErrorIcon : "close"; }
            if (ic != "") {
                IconView iv = new IconView(ic, 16);
                marker.Add(iv);
            } else {
                Label numLbl = new Label(Convert.ToString(i + 1));
                numLbl.ClassName = "step-number";
                marker.Add(numLbl);
            }
            stepNode.Add(marker);

            // 2. 文本区（标题 + 可选描述）
            Control textNode = new Control();
            textNode.ClassName = "step-content col";
            Label titleLbl = new Label(st.label);
            titleLbl.ClassName = "step-title";
            textNode.Add(titleLbl);
            if (st.desc != "") {
                Label descLbl = new Label(st.desc);
                descLbl.ClassName = "step-desc text-tertiary";
                textNode.Add(descLbl);
            }
            stepNode.Add(textNode);

            // 3. 点击切换
            if (Clickable && i <= current && i != errorIndex) {
                int targetIdx = i;
                stepNode.Click.Add(() => {
                    if (model.Get() != targetIdx) {
                        model.Set(targetIdx);
                        if (data != null) { data.Set(targetIdx); }
                        Change.RaiseS(this);
                        this.BuildSteps();
                    }
                });
            }

            // 4. 连接线（除最后一步外）
            if (i < count - 1) {
                Control conn = new Control();
                conn.ClassName = "step-connector flex-1 " + (i < current ? "done" : "pending");
                stepNode.Add(conn);
            }

            this.Add(stepNode);
        }
    }

    // ---- 设计器 / 序列化模型 -------------------------------------

    // ---- 设计器 / 序列化模型 -------------------------------------

    // 控件类型标识（序列化/设计器用）。
    public override string Kind() { return "Steps"; }
    // 覆写：返回 Size 绑定字段（设计器经它发现尺寸档位绑定）。
    public override Binding<string> SizeOf() { return Size; }

    // 覆写：返回设计器属性清单（当前步 / 错误步 / 尺寸 / 位置 / 状态 / 图标 / 可点击 / 类）。
    public override List<PropSpec> Props() {
        List<PropSpec> ps = new List<PropSpec>();
        PropSpec cur = PropSpec.Int("current", "Current step");
        // 属性通道优先指向活的外部绑定（§6.1 单协议）。
        if (data != null) { cur.num = data; } else { cur.snum = model; }
        cur.Also("value");
        cur.Also("data");
        ps.Add(cur);
        PropSpec err = PropSpec.Int("error", "Errored step");
        err.num = ErrorIndex;
        ps.Add(err);
        PropSpec sz = PropSpec.Enum("size", "Size",
            PropSpec.Sizes3());
        sz.str = Size;
        ps.Add(sz);
        PropSpec plc = PropSpec.Enum("placement", "Placement",
            new List<string>{ "", "right" });
        plc.WithTip("Right puts the secondary text beside the title instead of below the circles.");
        ps.Add(plc);
        PropSpec st = PropSpec.Enum("status", "Status",
            new List<string>{ "", "success", "error", "warning" });
        st.WithTip("Whole-flow status overriding per-step states.");
        ps.Add(st);
        PropSpec fin = PropSpec.Text("finishIcon", "Finish icon");
        fin.WithTip("Done-state glyph (\"check\" default).");
        ps.Add(fin);
        PropSpec eic = PropSpec.Text("errorIcon", "Error icon");
        eic.WithTip("Error-state glyph (\"!\" default).");
        ps.Add(eic);
        PropSpec clk = PropSpec.Bool("clickable", "Clickable");
        ps.Add(clk);
        return ps;
    }

    // designer 往返串："Details|Review=第二阶段|Done"（GetExtra/
    // SetExtra("items")）；"标题=描述" 的步骤带描述行。
    public string ItemsText() {
        string s = "";
        for (int i = 0; i < steps.Count; i = i + 1) {
            if (s != "") { s = s + "|"; }
            s = s + steps[i].label;
            if (steps[i].desc != "") { s = s + "=" + steps[i].desc; }
        }
        return s;
    }

    // 解析 ItemsText 的往返串并整体重建步骤列表。
    public void SetItemsText(string spec) {
        steps = new List<Step>();
        if (spec == null || spec == "") { return; }
        List<string> parts = spec.Split("|");
        for (int i = 0; i < parts.Count; i = i + 1) {
            string it = parts[i];
            if (it == "") { continue; }
            int eq = it.IndexOf("=");
            if (eq > 0) {
                this.AddStepDesc(it.Substring(0, eq),
                                 it.Substring(eq + 1, it.Length - eq - 1));
            } else {
                this.AddStep(it);
            }
        }
        this.BuildSteps();
    }

    // 覆写：应答扩展属性键，"items" 为步骤往返串。
    public override string GetExtra(string key) {
        if (key == "items") { return this.ItemsText(); }
        return "";
    }

    // 覆写：写回扩展属性键，"items" 重建步骤列表。
    public override bool SetExtra(string key, string val) {
        if (key == "items") { this.SetItemsText(val); return true; }
        return false;
    }

    // GetProp/SetProp 挂钩：Placement / Status / FinishIcon /
    // ErrorIcon / Clickable 没有绑定的 Binding 字段，走字符串往返，
    // 让文档与设计器读到实时值。
    public override string GetProp(string key) {
        if (key == "placement") { return Placement; }
        if (key == "status") { return Status; }
        if (key == "finishIcon") { return FinishIcon; }
        if (key == "errorIcon") { return ErrorIcon; }
        if (key == "clickable") { return PropSpec.Flag(Clickable); }
        return base.GetProp(key);
    }

    // 覆写：无绑定字段的键（placement/status/图标/clickable）按字符串直写，
    // 其余交给基类。
    public override void SetProp(string key, string val) {
        if (key == "placement") { Placement = val; return; }
        if (key == "status") { Status = Steps.StatusNorm(val); return; }
        if (key == "finishIcon") { FinishIcon = val; return; }
        if (key == "errorIcon") { ErrorIcon = val; return; }
        if (key == "clickable") { Clickable = PropSpec.IsOn(val); return; }
        base.SetProp(key, val);
    }

    // 覆写：公共事件之外提供 "Change"。
    public override List<string> Events() {
        List<string> e = Control.CommonEvents();
        e.Add("Change");
        return e;
    }

    // 将步骤的 Change 路由到自己的 UiEvent 字段；其余一切落到
    // `On` 的公共事件集（其 AddByName 忽略不认识的名称）。
    public override void BindEvent(string evt, Action a) {
        if (evt == "Change") { Change.Add(a); return; }
        On.AddByName(evt, a);
    }

    // <see cref="BindEvent"/> 的 sender 通道（S = Sender）：
    // 特化事件接本控件的 UiEvent，通用事件按名路由。
    public override void BindEventS(string evt, ControlEvent a) {
        if (evt == "Change") { Change.AddS(a); return; }
        On.AddByNameS(evt, a);
    }

}
