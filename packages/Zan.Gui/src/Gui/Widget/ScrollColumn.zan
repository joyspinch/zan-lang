using System;
using Gui;

namespace Gui.Widget;

// 用于有状态 UiDoc 子树的垂直滚动容器。
// 子控件按各自自然高度自上而下堆叠；
// 当内容总高度超过容器时，按共享的滚动量
// 向上偏移，并裁剪到其边界内（RenderTree
// 已推入裁剪区），隐藏滚出视野的行（使其不响应
// 点击），滚轮与滚动条使用 Control 的保留式滚动状态。
// 在文档中以 "ScrollColumn" 类型注册。
public class ScrollColumn : Control {
    // Arrange 后写出：子控件总内容高度（px），供滚动计算。
    private int contentH;
    // 滚动条预留宽度（缩放后，OnMeasure 刷新）。
    private int barReserve;

    // 初始化：以 "scroll" 注册（子控件自然垂直堆叠），置共享滚动状态
    // 与滚动条预留宽。
    private void InitScrollColumn() {
        this.InitControl("scroll", 0);
        contentH = 0;
        barReserve = 12;
    }

    // 空滚动列（子控件按自然高度依次堆叠）。
    public ScrollColumn() {
        InitScrollColumn();
    }

    // 控件类型标识（序列化/设计器用）。
    public override string Kind() { return "ScrollColumn"; }

    public override StyleBox ResolveStyle(App app, int state) {
        // Style.Full returns an instance clone; explicit stylesheet/inline overflow wins.
        StyleBox box = base.ResolveStyle(app, state);
        if (box.overflowCss == 0 - 1) {
            box.overflowY = 2;
            box.overflow = 1;
        }
        return box;
    }

    // 覆写：按 DPI 刷新滚动条预留宽度。
    public override void OnMeasure(App app) {
        barReserve = app.Scale(12);
    }

    // 按自然高度自上而下堆叠子控件，向上偏移
    // 当前滚动量；完全在视口外的行被隐藏。
    public override void Arrange(int px, int py, int pw, int ph) {
        if (pw < 0) { pw = 0; }
        if (ph < 0) { ph = 0; }
        bx = px;
        by = py;
        bw = pw;
        bh = ph;

        int gapPx = this.StyleGap();
        int padL = this.StylePadL();
        int padT = this.StylePadT();
        int padR = this.StylePadR();
        int padB = this.StylePadB();
        int borderL = computedStyle != null ? computedStyle.BorderLeftPx() : 0;
        int borderT = computedStyle != null ? computedStyle.BorderTopPx() : 0;
        int borderR = computedStyle != null ? computedStyle.BorderRightPx() : 0;
        int borderB = computedStyle != null ? computedStyle.BorderBottomPx() : 0;
        int viewW = pw - borderL - borderR;
        int viewH = ph - borderT - borderB;
        if (viewW < 0) { viewW = 0; }
        if (viewH < 0) { viewH = 0; }
        int innerW = viewW - padL - padR - barReserve;
        if (innerW < 0) { innerW = 0; }

        // Count every natural row before culling: hidden offscreen rows still own extent.
        int total = padT + padB;
        for (int i = 0; i < children.Count; i = i + 1) {
            Control c = children[i];
            int hh = c.StyleHeight();
            if (hh <= 0) { hh = c.prefH; }
            if (hh < 0) { hh = 0; }
            total = total + hh;
            if (i > 0) { total = total + gapPx; }
        }
        contentH = total;
        scrollExtent = total > viewH ? total : viewH;
        scrollExtentX = viewW;
        int maximum = scrollExtent - viewH;
        if (scrollY > maximum) { scrollY = maximum; }
        if (scrollY < 0) { scrollY = 0; }
        scrollX = 0;

        int viewY = py + borderT;
        int cy = viewY + padT - scrollY;
        for (int i = 0; i < children.Count; i = i + 1) {
            Control c = children[i];
            int hh = c.StyleHeight();
            if (hh <= 0) { hh = c.prefH; }
            if (hh < 0) { hh = 0; }
            bool onScreen = (cy + hh) > viewY && cy < (viewY + viewH);
            if (!onScreen && c.visible) {
                App app = this.FindApp();
                if (app != null) { app.ReleaseInputSubtree(c); }
            }
            c.visible = onScreen;
            c.Arrange(px + borderL + padL, cy, innerW, hh);
            cy = cy + hh + gapPx;
        }
    }

    public override List<PropSpec> Props() {
        List<PropSpec> ps = new List<PropSpec>();
        ps.Add(this.SizeProp());
        return ps;
    }
}
