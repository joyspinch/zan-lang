using System;
using System.Text;
using Gui;

namespace Gui.Widget;

// 动态标签：纯 Flex 弹性换行容器，由 Tag 子组件与内联 Input 构成。
public class DynamicTags : Control {
    public List<string> items;
    public bool Closable;
    public int Max;
    public string AddText;
    public string Placeholder;
    public Binding<string> Size;
    public UiEvent Change;

    private Input editor;
    private bool editing;
    private bool takeFocus;
    private bool editorFocused;

    public override int StyleDisplay() { return 1; } // CSS display: flex
    public override int StyleFlexDir() { return 0; } // flex-direction: row

    private static string TT(string en, string zh) {
        return Lang.Tr(en, zh);
    }

    private void InitDynamicTags() {
        this.InitControl("dynamictags", 1);
        this.AddClass("wrap");
        items = new List<string>();
        Closable = true;
        Max = 0;
        AddText = "";
        Placeholder = "";
        Size = "medium";
        editor = new Input("");
        editing = false;
        takeFocus = false;
        editorFocused = false;
        wiresOwnEvents = true;
        Change = new UiEvent();
        this.RebuildChildren();
    }

    public DynamicTags() { InitDynamicTags(); }

    public DynamicTags(List<string> initial) {
        InitDynamicTags();
        if (initial != null) {
            for (int i = 0; i < initial.Count; i = i + 1) {
                items.Add(initial[i]);
            }
        }
        this.RebuildChildren();
    }

    public int Count() { return items.Count; }

    public string TextAt(int i) {
        if (i < 0 || i >= items.Count) { return ""; }
        return items[i];
    }

    public List<string> Items() { return items; }

    public void Add(string text) {
        items.Add(text);
        this.RebuildChildren();
        Change.RaiseS(this);
    }

    public void RemoveAt(int i) {
        if (i < 0 || i >= items.Count) { return; }
        items.RemoveAt(i);
        this.RebuildChildren();
        Change.RaiseS(this);
    }

    public void SetItems(List<string> next) {
        items = new List<string>();
        if (next != null) {
            for (int i = 0; i < next.Count; i = i + 1) {
                items.Add(next[i]);
            }
        }
        this.RebuildChildren();
    }

    public void Clear() {
        items.Clear();
        this.RebuildChildren();
    }

    public bool CanAdd() {
        if (Max <= 0) { return true; }
        return items.Count < Max;
    }

    public string AddLabel() {
        if (AddText != "") { return AddText; }
        return DynamicTags.TT("Add", "新建标签");
    }

    public void StartEdit() {
        if (editing || this.IsDisabled() || !this.CanAdd()) { return; }
        editing = true;
        editor.SetText("");
        takeFocus = true;
        editorFocused = true;
        this.RebuildChildren();
    }

    public void FinishEdit(App app, bool add) {
        if (!editing) { return; }
        string t = editor.GetText();
        editing = false;
        takeFocus = false;
        editorFocused = false;
        editor.SetText("");
        if (add && t != "" && this.CanAdd()) {
            this.Add(t);
        } else {
            this.RebuildChildren();
        }
        if (app != null) { app.RequestRedraw(); }
    }

    public void RebuildChildren() {
        this.children.Clear();
        for (int i = 0; i < items.Count; i = i + 1) {
            int idx = i;
            Tag t = new Tag(items[i]);
            t.Closable = this.Closable;
            t.Close.Add(() => {
                this.RemoveAt(idx);
            });
            this.Add(t);
        }

        if (editing) {
            if (Placeholder != "") { editor.hint = Placeholder; }
            this.Add(editor);
        } else if (this.CanAdd()) {
            Button addBtn = new Button("+ " + this.AddLabel());
            addBtn.AddClass("dashed");
            addBtn.Click.Add(() => {
                this.StartEdit();
            });
            this.Add(addBtn);
        }
    }

    public override string Kind() { return "DynamicTags"; }
    public override Binding<string> SizeOf() { return Size; }

    public override List<PropSpec> Props() {
        List<PropSpec> ps = new List<PropSpec>();
        PropSpec cl = PropSpec.Bool("closable", "Closable");
        cl.flag = Closable;
        ps.Add(cl);
        PropSpec mx = PropSpec.Int("max", "Max");
        mx.num = Max;
        ps.Add(mx);
        PropSpec at = PropSpec.Text("addText", "Add text");
        at.str = AddText;
        ps.Add(at);
        PropSpec ph = PropSpec.Text("placeholder", "Placeholder");
        ph.str = Placeholder;
        ps.Add(ph);
        PropSpec sz = PropSpec.Enum("size", "Size", PropSpec.Sizes());
        sz.str = Size;
        ps.Add(sz);
        return ps;
    }

    public override void SyncBinding() {
        base.SyncBinding();
        this.ApplySizeClass();
    }

    public override void OnPaint(App app) {
        if (editing) {
            if (takeFocus) {
                app.focus.SetFocused(editor.CommonId());
                takeFocus = false;
            }
            int ekind = app.EventKind();
            int ekey = app.window.EventKeyCode();
            if (ekind == 6 && ekey == 13) {
                this.FinishEdit(app, true);
            } else if (ekind == 4 && ekey == 27) {
                this.FinishEdit(app, false);
            }
        }
    }
}
