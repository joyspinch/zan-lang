using System;
using System.Text;
using Gui;
namespace Gui.Widget;
[GuiKind("DynamicTags")]
public class DynamicTags : Control {
    public override Control CreateCloneShell() { return new DynamicTags(); }
    public List<string> items;
    public bool Closable;
    public int Max;
    public string AddText;
    public string Placeholder;
    public Binding<string> Size;
    public UiEvent Change;
    private Input editor;
    private bool editing;
    private bool takeFocus;
    private int rebuildGeneration;
    private DynamicTagsAction editorAction;
    public override int StyleDisplay() { return 1; } // CSS display: flex
    public override int StyleFlexDir() { return 0; } // flex-direction: row
    private static string TT(string en, string zh) { return Lang.Tr(en, zh); }
    private void InitDynamicTags() {
        this.InitControl("dynamictags");
        this.AddClass("wrap");
        items = new List<string>();
        Closable = true;
        Max = 0;
        AddText = "";
        Placeholder = "";
        Size = "medium";
        editor = new Input("");
        editing = false;
        takeFocus = false;
        wiresOwnEvents = true;
        Change = new UiEvent();
        this.RebuildChildren();
    }
    public DynamicTags() { InitDynamicTags(); }
    public DynamicTags(List<string> initial) {
        InitDynamicTags();
        if (initial != null) {
            for (int i = 0; i < initial.Count; i = i + 1) {
                items.Add(initial[i]);
            }
        }
        this.RebuildChildren();
    }
    public int Count() { return items.Count; }
    public string TextAt(int i) {
        if (i < 0 || i >= items.Count) { return ""; }
        return items[i];
    }
    public List<string> Items() { return items; }
    public void Add(string text) {
        items.Add(text);
        this.RebuildChildren();
        Change.RaiseS(this);
    }
    public void RemoveAt(int i) {
        if (i < 0 || i >= items.Count) { return; }
        items.RemoveAt(i);
        this.RebuildChildren();
        Change.RaiseS(this);
    }
    public void SetItems(List<string> next) {
        items = new List<string>();
        if (next != null) {
            for (int i = 0; i < next.Count; i = i + 1) {
                items.Add(next[i]);
            }
        }
        this.RebuildChildren();
    }
    private string OptionsText() {
        string text = "";
        for (int i = 0; i < items.Count; i = i + 1) {
            if (i > 0) { text = text + "|"; }
            text = text + items[i];
        }
        return text;
    }
    private void SetOptionsText(string value) {
        List<string> next = new List<string>();
        string text = value != null ? value : "";
        List<string> labels = text.Split("|");
        for (int i = 0; i < labels.Count; i = i + 1) {
            if (labels[i] != "") { next.Add(labels[i]); }
        }
        this.SetItems(next);
    }
    public void Clear() {
        items.Clear();
        this.RebuildChildren();
    }
    public bool CanAdd() {
        if (Max <= 0) { return true; }
        return items.Count < Max;
    }
    public string AddLabel() {
        if (AddText != "") { return AddText; }
        return DynamicTags.TT("Add", "新建标签");
    }
    public void StartEdit() {
        if (editing || this.IsDisabled() || !this.CanAdd()) { return; }
        editing = true;
        editor.SetText("");
        takeFocus = true;
        this.RebuildChildren();
    }
    public void FinishEdit(bool add) { this.FinishEdit(this.App, add); }
    public void FinishEdit(App app, bool add) {
        app = this.ResolveApp(app);
        if (!editing) { return; }
        string t = editor.GetText();
        editing = false;
        takeFocus = false;
        editor.SetText("");
        if (add && t != "" && this.CanAdd()) {
            this.Add(t);
        } else {
            this.RebuildChildren();
        }
        if (app != null) { app.RequestRedraw(); }
    }
    public int RebuildGeneration() { return rebuildGeneration; }
    public void RebuildChildren() {
        rebuildGeneration = rebuildGeneration + 1;
        DynamicTagsAction proof = new DynamicTagsAction(this, -1);
        this.RemoveChildren(this.SnapshotChildren(), proof.Current);
        if (!proof.Current()) { return; }
        for (int i = 0; i < items.Count; i = i + 1) {
            Tag t = new Tag(items[i]);
            t.Closable = this.Closable;
            DynamicTagsAction closeAction = new DynamicTagsAction(this, i, t);
            t.Close.Add(closeAction.Close);
            this.Add(t);
            if (!proof.Current()) { return; }
        }
        if (editorAction != null) { editor.Submit.Remove(editorAction.Submit); }
        editorAction = null;
        if (editing) {
            if (Placeholder != "") { editor.hint = Placeholder; }
            editorAction = new DynamicTagsAction(this, -1);
            editor.Submit.Add(editorAction.Submit);
            this.Add(editor);
            if (!proof.Current()) { return; }
            this.FocusEditor(this.FindApp());
        } else if (this.CanAdd()) {
            Button addBtn = new Button("+ " + this.AddLabel());
            addBtn.AddClass("dashed");
            DynamicTagsAction addAction = new DynamicTagsAction(this, -1);
            addBtn.Click.Add(addAction.StartEdit);
            this.Add(addBtn);
        }
    }
    public override void CloneContentTo(Control target, CloneTreeFn clone) {
        ((DynamicTags)target).SetItems(items);
    }
    public override string Kind() { return "DynamicTags"; }
    public override Binding<string> SizeOf() { return Size; }
    public override string GetExtra(string key) {
        if (key == "options") { return this.OptionsText(); }
        return base.GetExtra(key);
    }
    public override bool SetExtra(string key, string val) {
        if (key == "options") { this.SetOptionsText(val); return true; }
        return base.SetExtra(key, val);
    }
    protected override List<PropSpec> DefineProps() {
        List<PropSpec> ps = new List<PropSpec>();
        ps.Add(PropSpec.Text("options", "Options").ViaExtra());
        ps.Add(PropSpec.Bool("closable", "Closable").Field("Closable", 2));
        ps.Add(PropSpec.Int("max", "Max").Field("Max", 1));
        ps.Add(PropSpec.Text("addText", "Add text").Field("AddText", 0));
        ps.Add(PropSpec.Text("placeholder", "Placeholder").Field("Placeholder", 0));
        ps.Add(PropSpec.Enum("size", "Size", PropSpec.Sizes()).Field("Size", 0));
        return ps;
    }
    public override void SyncBinding() {
        base.SyncBinding();
        this.ApplySizeClass();
    }
    private void FocusEditor(App app) {
        if (!editing || !takeFocus || app == null || editor.parent != this) { return; }
        takeFocus = false;
        editor.Focus(app);
    }
    public override void OnMeasure(App app) { this.FocusEditor(app); }
    public override void OnKeyDown(RoutedEventArgs e) {
        if (editing && !this.IsDisabled() && e.keyCode == 27) {
            this.FinishEdit(false);
            e.Handle();
            return;
        }
        base.OnKeyDown(e);
    }
}
