using System;
using Gui;

namespace Gui.Widget;

// 软键盘避让模式
public enum KeyboardAvoidMode {
    Padding = 0,
    Position = 1
}

// 移动端软键盘自适应避让容器：
// 监听系统虚拟键盘的弹起高度，通过动态内边距（Padding）或视口平移（Position），
// 自动将输入框或底部交互栏提升至软键盘上方，防止输入遮挡与光标不可见。
public class KeyboardAvoidingView : Panel {
    public KeyboardAvoidMode mode;
    public int extraOffset;
    private int appliedPaddingBottom;
    private int basePaddingBottom;

    public KeyboardAvoidingView() : base() {
        mode = KeyboardAvoidMode.Padding;
        extraOffset = 8;
        appliedPaddingBottom = 0;
        basePaddingBottom = 0;
    }

    public KeyboardAvoidingView(string name) : base(name) {
        mode = KeyboardAvoidMode.Padding;
        extraOffset = 8;
        appliedPaddingBottom = 0;
        basePaddingBottom = 0;
    }

    public KeyboardAvoidingView WithPaddingMode() {
        mode = KeyboardAvoidMode.Padding;
        return this;
    }

    public KeyboardAvoidingView WithPositionMode() {
        mode = KeyboardAvoidMode.Position;
        return this;
    }

    public KeyboardAvoidingView WithExtraOffset(int px) {
        if (px >= 0) { extraOffset = px; }
        return this;
    }

    public KeyboardAvoidingView SetBasePaddingBottom(int pad) {
        if (pad >= 0) { basePaddingBottom = pad; }
        return this;
    }

    // 动态同步键盘高度，自适应调整底部内边距与排版
    public void SyncKeyboard() { this.SyncKeyboard(this.App); }
    public void SyncKeyboard(App app) {
        app = this.ResolveApp(app);
        if (app == null) { return; }

        int kh = app.KeyboardHeight();
        if (mode == KeyboardAvoidMode.Padding) {
            int targetPad = kh > 0 ? (kh + extraOffset + basePaddingBottom) : basePaddingBottom;
            if (appliedPaddingBottom != targetPad) {
                appliedPaddingBottom = targetPad;
                this.Padding(padT, padR, targetPad, padL);
                this.Invalidate();
            }
        } else if (mode == KeyboardAvoidMode.Position) {
            // Position 模式下，直接通知重绘并记录位移
            this.Invalidate();
        }
    }

    public override void OnMeasure(App app) {
        this.SyncKeyboard(app);
        base.OnMeasure(app);
    }
}
