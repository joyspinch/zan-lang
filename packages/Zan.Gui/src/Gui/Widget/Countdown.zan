using System;
using Gui;
using Gui.Backend;

namespace Gui.Widget;

// 倒计时：从 `Duration` 毫秒起倒数，归零时触发 `Finish`。
// `Active` 暂停/恢复，`Format` 用令牌控制显示的位面：
// | 令牌 | 含义                     |
// |------|--------------------------|
// | D    | 总天数（不补零）         |
// | HH   | 时（补零）               |
// | mm   | 分（补零）               |
// | ss   | 秒（补零）               |
// | S    | 十分之一秒（1 位数字）    |
// | SS   | 百分之一秒（补零，2 位）  |
// 时间单位一律双写，其余字符（含单个 h/m/s）原样输出，因此
// `"mm:ss"`、`"ss.S"`、`"D 天 HH:mm:ss"` 都是合法格式，而
// `"T-minus"` 这类字面量不会被吃掉；`"sss"` 渲染成 `"05s"`。
// 时刻由 tick 差值推得（不按帧数累计），掉帧、窗口失焦再回来
// 都不会走慢；走动期间经 `App.RequestAnimationFrameIn` 限速
// 重绘——秒级格式只在对齐秒边界时醒来，含 `S` 以 100ms 节奏、
// 含 `SS` 以 16ms（60fps，显示帧率封顶）节奏刷新。百分位**不**
// 按 10ms 排程：显示值每帧由 tick 差值现算，60fps 下依然逐帧
// 准确，而 100 次唤醒/秒会让事件循环永远睡不成。
// 绘制形态：默认皮肤下套一张圆角卡片（`countdown::box`）+ 底部
// 剩余进度条（`::track`/`::fill`，success/warning/error 角色类给
// 进度条换色）；控件太小（密集布局内嵌）时退化裸文本。暂停或
// 归零时落到 disabled 皮肤，数字与面板一起降调。
// 外部改变 `Duration`（含双向绑定）会自动重摆；`Restart()`
// 手动重摆到当前 `Duration`。
public class Countdown : Control {
    // 总时长（毫秒）。变化即重摆；默认 60000。
    public Binding<int> Duration;
    // 是否走动。false 暂停（保持剩余值），恢复后从剩余值继续。
    public Binding<bool> Active;
    // 显示格式，令牌见类型说明；空串按 `"HH:mm:ss"`。
    public Binding<string> Format;

    // 倒计时归零（仅触发一次，重新走动后再次归零会再触发）。
    public UiEvent Finish;

    // ---- 运行状态（只在 UI 线程触碰） ------------------------------
    private int remainingMs;
    private int lastTickMs;  // 上次 Tick 的时刻；-1 表示下一拍重定基准
    private int lastDuration;  // 探测 Duration 绑定变化
    private bool finished;
    private bool activeNow;
    private int subCad;  // 副秒位面：0 无 / 1 十分位(100ms) / 2 百分位(16ms)

    // 构造器链的公共初始化（控件类型 "countdown"）。
    private void InitCountdown(int durationMs, string fmt) {
        this.InitControl("countdown", 1);
        Duration = durationMs;
        Active = true;
        Format = fmt;
        Finish = new UiEvent();
        remainingMs = durationMs;
        lastTickMs = 0 - 1;
        lastDuration = durationMs;
        finished = false;
        activeNow = true;
        subCad = 0;
    }
    // 60 秒默认倒计时（设计器用）。
    public Countdown() { InitCountdown(60000, ""); }
    // 指定总时长（毫秒），默认格式。
    public Countdown(int durationMs) { InitCountdown(durationMs, ""); }
    // 总时长 + 格式（令牌见类型注释）。
    public Countdown(int durationMs, string format) { InitCountdown(durationMs, format); }

    // 当前剩余毫秒（宿主轮询用；推模式请挂 `Finish`）。
    public int Remaining() { return remainingMs; }

    // 重摆到当前 `Duration` 并从头开始走。暂停态下只清零进度，
    // 不改变 `Active`。
    public void Restart() {
        int dur = lastDuration;
        if (Duration != null) {
            dur = Duration.Get();
            if (dur < 0) { dur = 0; }
            lastDuration = dur;
        }
        this.Arm(dur);
    }

    // 重摆：剩余值置为 `ms`，下一拍重定时间基准，清除已触发标记。
    public void Arm(int ms) {
        remainingMs = ms;
        lastTickMs = 0 - 1;
        finished = false;
    }

    // 推进计时并按需触发 Finish。`nowMs` 由调用方传入
    // （绘制路径传 `Window.GetTickMs()`），测试可注入确定时刻。
    public void Tick(int nowMs) {
        if (lastTickMs < 0) { lastTickMs = nowMs; }
        if (activeNow && remainingMs > 0) {
            int elapsed = nowMs - lastTickMs;
            if (elapsed > 0) {
                remainingMs = remainingMs - elapsed;
                if (remainingMs < 0) { remainingMs = 0; }
            }
        }
        lastTickMs = nowMs;
        if (remainingMs == 0) {
            if (!finished) {
                finished = true;
                Finish.RaiseS(this);
            }
        } else {
            finished = false;
        }
    }

    // 读取绑定的 Duration/Active：Duration 变化即重摆。
    public void SyncProps() {
        int dur = lastDuration;
        if (Duration != null) {
            dur = Duration.Get();
            if (dur < 0) { dur = 0; }
        }
        if (dur != lastDuration) {
            lastDuration = dur;
            this.Arm(dur);
        }
        bool act = true;
        if (Active != null) { act = Active.Get(); }
        activeNow = act;
    }

    // 生效格式：Format 绑定为空/null 时按 "HH:mm:ss"。
    public string Fmt() {
        string f = "";
        if (Format != null) { f = Format.Get(); }
        if (f == null || f == "") { f = "HH:mm:ss"; }
        return f;
    }

    // 当前帧显示文本（按 Fmt() 与剩余毫秒现算）。
    public string DisplayText() { return Countdown.FormatText(this.Fmt(), remainingMs); }

    // 纯函数格式化：`rem` 为剩余毫秒，令牌见类型说明；
    // `fmt` 为空按 `"HH:mm:ss"`。
    public static string FormatText(string fmt, int rem) {
        if (fmt == null || fmt == "") { fmt = "HH:mm:ss"; }
        if (rem < 0) { rem = 0; }
        string outp = "";
        int i = 0;
        while (i < fmt.Length) {
            char ch = fmt[i];
            if (ch == 'D') {
                outp = outp + rem / 86400000;
                i = i + 1;
            } else if (ch == 'H' && i + 1 < fmt.Length && fmt[i + 1] == 'H') {
                outp = outp + Countdown.Pad2(rem % 86400000 / 3600000);
                i = i + 2;
            } else if (ch == 'm' && i + 1 < fmt.Length && fmt[i + 1] == 'm') {
                outp = outp + Countdown.Pad2(rem % 3600000 / 60000);
                i = i + 2;
            } else if (ch == 's' && i + 1 < fmt.Length && fmt[i + 1] == 's') {
                outp = outp + Countdown.Pad2(rem % 60000 / 1000);
                i = i + 2;
            } else if (ch == 'S' && i + 1 < fmt.Length && fmt[i + 1] == 'S') {
                outp = outp + Countdown.Pad2(rem % 1000 / 10);
                i = i + 2;
            } else if (ch == 'S') {
                outp = outp + rem % 1000 / 100;
                i = i + 1;
            } else {
                outp = outp + ch;
                i = i + 1;
            }
        }
        return outp;
    }

    // 两位数字补零（"07"）。
    private static string Pad2(int v) {
        if (v < 10) { return "0" + v; }
        return "" + v;
    }

    public override int StyleDisplay() { return 1; } // Flex
    public override int StyleFlexDir() { return 1; } // Column

    public void BuildTree() {
        this.children.Clear();
        Label valLbl = new Label(this.DisplayText());
        valLbl.ClassName = "countdown-value flex-1 align-center justify-center";
        this.Add(valLbl);

        Control track = new Control();
        track.ClassName = "countdown-track";
        Control fill = new Control();
        fill.ClassName = "countdown-fill";
        track.Add(fill);
        this.Add(track);
    }

    public override void OnMeasure(App app) {
        prefW = 120;
        prefH = 48;
    }

    // 覆写：驱动计时并以纯声明式对象树与 CSS 盒模型渲染倒计时卡片。
    public override void OnPaint(App app) {
        int id = this.CommonId();
        this.SyncProps();
        this.Tick(Window.GetTickMs());
        string fmt = this.Fmt();
        subCad = 0;
        if (fmt.Contains("SS")) { subCad = 2; }
        else if (fmt.Contains("S")) { subCad = 1; }

        if (this.children.Count == 0) {
            this.BuildTree();
        }
        if (this.children.Count > 0 && this.children[0] is Label) {
            ((Label)this.children[0]).Text = this.DisplayText();
        }

        app.focus.RegisterFocusable(id);
        app.hitTester.RegisterRect(id, bx, by, bw, bh, 0);
        On.Fire(app, id, this);

        // 走动时限速重绘：秒级格式睡到下一个秒边界；十分位 100ms；
        // 百分位按显示帧率 16ms 封顶而不是 10ms——显示值绘制时由
        // tick 差值现算，60fps 下逐帧依然准确，100 唤醒/秒却会让
        // 事件循环永远睡不成（空闲功耗与其它动画的调度都被拖累）。
        if (activeNow && remainingMs > 0 && bw > 0 && bh > 0) {
            int wait = remainingMs % 1000 + 1;
            if (subCad == 1) { wait = 100; }
            else if (subCad == 2) { wait = 16; }
            app.RequestAnimationFrameIn(wait, bx, by, bw, bh);
        }
    }

    // ---- 设计器 / 序列化模型 ---------------------------------------

    // 控件类型标识（序列化/设计器用）。
    public override string Kind() { return "Countdown"; }

    // 覆写：返回设计器属性清单（时长 / 启停 / 格式 / 类）。
    public override List<PropSpec> Props() {
        List<PropSpec> ps = new List<PropSpec>();
        PropSpec dur = PropSpec.Int("duration", "Duration (ms)");
        dur.num = Duration;
        dur.Step(1000, 0, 86400000);
        dur.WithTip("Total countdown length; changing it re-arms the timer.");
        ps.Add(dur);
        PropSpec act = PropSpec.Bool("active", "Active");
        act.flag = Active;
        act.WithTip("false pauses the countdown, true resumes it.");
        ps.Add(act);
        PropSpec fmt = PropSpec.Text("format", "Format");
        fmt.str = Format;
        fmt.WithTip("Tokens: D, HH, mm, ss, S; other chars literal.");
        ps.Add(fmt);
        return ps;
    }

    // 设计器事件列表（公共事件 + Finish）。
    public override List<string> Events() {
        List<string> e = Control.CommonEvents();
        e.Add("Finish");
        return e;
    }

    // 设计器/反射绑定：按事件名挂回调。
    public override void BindEvent(string evt, Action a) {
        if (evt == "Finish") { Finish.Add(a); return; }
        On.AddByName(evt, a);
    }

    // <see cref="BindEvent"/> 的 sender 通道（S = Sender）：
    // 特化事件接本控件的 UiEvent，通用事件按名路由。
    public override void BindEventS(string evt, ControlEvent a) {
        if (evt == "Finish") { Finish.AddS(a); return; }
        On.AddByNameS(evt, a);
    }

}
