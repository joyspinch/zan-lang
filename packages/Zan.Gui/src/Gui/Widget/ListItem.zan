using System;
using Gui;
namespace Gui.Widget;
[GuiKind("ListItem")]
public class ListItem : Control {
    public override Control CreateCloneShell() { return new ListItem(); }
    public Binding<string> Text;
    public Binding<string> Desc;
    public bool Selected;
    private void InitItem(string ttl, string desc) {
        this.InitControl(ttl);
        Text = ttl;
        Desc = desc;
        Selected = false;
    }
    public ListItem() { InitItem("", ""); }
    public ListItem(string ttl) { InitItem(ttl, ""); }
    public ListItem(string ttl, string desc) { InitItem(ttl, desc); }
    public ListItem(string ttl, bool isHeader) : this(ttl) {
        if (isHeader) { this.Class = "header"; }
    }
    public static ListItem Header(string ttl) { return new ListItem(ttl, true); }
    public string Label() {
        if (Text == null) { return ""; }
        return Text.Get();
    }
    public string Sub() {
        if (Desc == null) { return ""; }
        return Desc.Get();
    }
    public override string Kind() { return "ListItem"; }
    public override string StyleType() { return "listitem"; }
    public int StateNow() {
        if (this.IsDisabled()) { return Style.SDisabled(); }
        if (Selected) { return Style.SSelected(); }
        return Style.SNormal();
    }
    public StyleBox ResolvedStyle() { return this.ResolvedStyle(this.App); }
    public StyleBox ResolvedStyle(App app) {
        app = this.ResolveApp(app);
        return this.ResolveStyleAs(app, "listitem", Class, this.StateNow());
    }
    public StyleBox TitleStyle() { return this.TitleStyle(this.App); }
    public StyleBox TitleStyle(App app) {
        app = this.ResolveApp(app);
        return Style.Part(app, "listitem", "title", "", Class, "",
                          this.StateNow());
    }
    public StyleBox DescStyle() { return this.DescStyle(this.App); }
    public StyleBox DescStyle(App app) {
        app = this.ResolveApp(app);
        return Style.Part(app, "listitem", "desc", "", Class, "",
                          this.StateNow());
    }
    public override void OnMeasure(App app) {
        StyleBox s = this.ResolvedStyle(app);
        StyleBox ts = this.TitleStyle(app);
        StyleBox ds = this.DescStyle(app);
        int tf = ts.FontOr(Style.FontFallback(app, "small"));
        int titleH = Canvas.FontHeight(tf);
        int textW = Canvas.MeasureText(this.Label(), tf);
        string sub = this.Sub();
        if (sub != "") {
            int df = ds.FontOr(Style.FontFallback(app, "tiny"));
            int dw = Canvas.MeasureText(sub, df);
            if (dw > textW) { textW = dw; }
            prefH = s.PadTOr(0) + titleH
                + s.GapOr(app.theme.gapSmall) + Canvas.FontHeight(df);
        } else {
            prefH = s.PadTOr(0) + titleH;
        }
        prefH = prefH + s.PadBOr(0);
        prefW = s.PadLOr(0) + textW + s.PadROr(0);
    }
    public override void OnPaint(App app) {
        Canvas c = app.canvas;
        StyleBox s = this.ResolvedStyle(app);
        StyleBox ts = this.TitleStyle(app);
        int x = bx + s.PadLOr(0);
        int y = by + s.PadTOr(0);
        int maxW = bw - s.PadLOr(0) - s.PadROr(0);
        int tf = ts.FontOr(Style.FontFallback(app, "small"));
        c.DrawText(x, y, Ellipsis.Fit(this.Label(), maxW, tf),
                   ts.FgOr(0), tf);
        string sub = this.Sub();
        if (sub == "") { return; }
        int titleH = Canvas.FontHeight(tf);
        StyleBox ds = this.DescStyle(app);
        int df = ds.FontOr(Style.FontFallback(app, "tiny"));
        y = y + titleH + s.GapOr(app.theme.gapSmall);
        c.DrawText(x, y, Ellipsis.Fit(sub, maxW, df), ds.FgOr(0), df);
    }
    protected override List<PropSpec> DefineProps() {
        List<PropSpec> ps = new List<PropSpec>();
        ps.Add(PropSpec.Text("text", "Text").Field("Text", 0));
        ps.Add(PropSpec.Text("desc", "Desc").Field("Desc", 0));
        ps.Add(PropSpec.Bool("selected", "Selected").Field("Selected", 2));
        ps.Add(PropSpec.Bool("disabled", "Disabled").Field("Disabled", 2));
        return ps;
    }
}
