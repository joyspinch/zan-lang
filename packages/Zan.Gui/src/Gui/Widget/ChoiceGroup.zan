using System;
using Gui;
namespace Gui.Widget;
public class ChoiceGroup : Panel {
    // 按父类种类上报：序列化与自动化以 "Panel" 识别本控件。
    public override string Kind() { return "Panel"; }
    private int gapX;
    private int gapY;
    private int columns;
    private int rowHeight;
    private int sGapX;
    private int sGapY;
    private int sRowH;
    protected List<string> labels;
    private int mCols;
    private int mColGap;
    private int mRowGap;
    private int mRowH;
    private int mRows;
    private int aRows;
    protected void InitChoice() {
        this.InitPanel("choicegroup", 3);
        this.gapX = 16;
        this.gapY = 4;
        this.columns = 0;
        this.rowHeight = 0;
        this.sGapX = 16;
        this.sGapY = 4;
        this.sRowH = 0;
        this.labels = new List<string>();
        this.mCols = 0;
        this.mColGap = 16;
        this.mRowGap = 4;
        this.mRowH = 0;
        this.mRows = 0;
        this.aRows = 0;
    }
    public ChoiceGroup() { this.InitChoice(); }
    public void SetColumns(int n) {
        if (n < 0) { n = 0; }
        this.columns = n;
    }
    public int Columns() { return this.columns; }
    public void SetRowHeight(int h) {
        if (h < 0) { h = 0; }
        this.rowHeight = h;
        this.sRowH = h;
    }
    public int RowHeight() { return this.rowHeight; }
    public override string StyleType() {
        if (styleTypeLower == "") { styleTypeLower = this.Kind().ToLower(); }
        return styleTypeLower;
    }
    public virtual Control MakeItem(int index, string text) { return null; }
    public virtual string OptionsText() {
        string outp = "";
        for (int i = 0; i < this.labels.Count; i = i + 1) {
            if (i > 0) { outp = outp + "|"; }
            outp = outp + this.labels[i];
        }
        return outp;
    }
    public int Count() { return this.ChildCount(); }
    public Control AddOption(string text) {
        if (text == null || text == "") { return null; }
        Control item = this.MakeItem(this.ChildCount(), text);
        if (item == null) { return null; }
        this.labels.Add(text);
        this.Add(item);
        return item;
    }
    public virtual void SetOptionsText(string text) {
        if (text == null || text.Length == 0) { return; }
        string s = text.Trim();
        if (s.StartsWith("[") && s.EndsWith("]")) {
            JsonValue arr = JsonValue.ParseLenient(s);
            if (arr != null && arr.IsArray()) {
                for (int i = 0; i < arr.Count(); i = i + 1) {
                    JsonValue it = arr.At(i);
                    if (it == null) { continue; }
                    if (it.IsObject()) {
                        string lbl = it.Str("label", "");
                        if (lbl == "") { lbl = it.Str("name", ""); }
                        if (lbl == "") { lbl = it.Str("title", ""); }
                        if (lbl == "") { lbl = it.Str("text", ""); }
                        if (lbl == "") { lbl = it.Str("value", ""); }
                        this.AddOption(lbl);
                    } else {
                        this.AddOption(it.AsString(""));
                    }
                }
                return;
            }
        }
        List<string> parts = text.Split("|");
        for (int i = 0; i < parts.Count; i = i + 1) {
            this.AddOption(parts[i]);
        }
    }

    // 清空全部选项（设计器重复写入 `options` 前调用；子类要连
    // 平行的元数据列表一起清，否则下标错位）。
    public virtual void ClearOptions() {
        this.RemoveAll();
        this.labels.Clear();
    }

    // 面板 / HTML 写入 `options`：先清后建（面板可反复编辑；追加语义只属于
    // 构造期直调 SetOptionsText）。
    public void ReplaceOptionsText(string text) {
        this.ClearOptions();
        this.SetOptionsText(text);
    }
    protected override List<PropSpec> DefineProps() {
        List<PropSpec> ps = new List<PropSpec>();
        PropSpec cols = PropSpec.Int("columns", "Columns")
            .WithTip("每行几个选项，0 = 按宽度自动换行；大于 0 时按可用宽度等分")
            .Step(1, 0, 24);
        cols.Field("columns");
        ps.Add(cols);
        PropSpec rh = PropSpec.Int("rowHeight", "Row height")
            .WithTip("每行的高度，0 = 按最高的选项自适应")
            .Step(2, 0, 200);
        rh.Field("rowHeight");
        ps.Add(rh);
        PropSpec opt = PropSpec.Text("options", "Options").Accessor("OptionsText", "ReplaceOptionsText");
        opt.WithTip("Pipe-separated options, e.g. \"A|B|C\". "
                    + "RadioGroup items may carry a trailing \"!\" to disable.");
        ps.Add(opt);
        return ps;
    }
    public override void OnPaint(App app) {
        if (app == null) { return; }
        if (this.aRows != this.mRows) {
            this.mRows = this.aRows;
            this.prefH = this.RowsHeight(this.aRows);
            app.RequestRedraw();
        }
    }
    protected int InnerW(int pw) {
        int w = pw - this.StylePadL() - this.StylePadR();
        if (w < 0) { return 0; }
        return w;
    }
    private int RowsHeight(int rows) {
        if (rows < 1) { return this.StylePadT() + this.StylePadB(); }
        return this.StylePadT() + this.StylePadB()
             + rows * this.mRowH + (rows - 1) * this.mRowGap;
    }
    private int FlowRows(int avail) {
        int n = this.ChildCount();
        if (n == 0) { return 0; }
        int rows = 1;
        int used = 0;
        for (int i = 0; i < n; i = i + 1) {
            int cwid = this.ChildAt(i).prefW;
            if (cwid < 1) { cwid = avail; }
            if (used > 0 && used + cwid > avail) {
                rows = rows + 1;
                used = 0;
            }
            used = used + cwid + this.mColGap;
        }
        return rows;
    }
    public int RowGapPx() { return this.StyleRowGap(this.sGapY); }
    public int ColGapPx() { return this.StyleColGap(this.sGapX); }

    // 解析行几何（列数 / 行距 / 列距 / 行高）。全部取自已解析的
    // 样式盒与子项尺寸，不需要 App，因此 Arrange 也能自己调（不
    // 依赖先跑过 OnMeasure）。
    private void ResolveMetrics() {
        int n = this.ChildCount();
        this.mColGap = this.StyleColGap(this.sGapX);
        this.mRowGap = this.StyleRowGap(this.sGapY);
        this.mCols = this.columns;
        if (this.mCols < 1) { this.mCols = this.StyleColumns(0); }
        if (this.mCols < 0) { this.mCols = 0; }
        if (this.mCols > n && n > 0) { this.mCols = n; }
        int itemH = 0;
        for (int i = 0; i < n; i = i + 1) {
            int hh = this.ChildAt(i).prefH;
            if (hh > itemH) { itemH = hh; }
        }
        int lineH = this.StyleLineHeight();
        if (lineH < 1) { lineH = this.sRowH; }
        if (lineH > itemH) { itemH = lineH; }
        this.mRowH = itemH;
    }
    public override void OnMeasure(App app) {
        if (app == null) { return; }
        int n = this.ChildCount();
        this.sGapX = app.Scale(this.gapX);
        this.sGapY = app.Scale(this.gapY);
        this.sRowH = app.Scale(this.rowHeight);
        this.ResolveMetrics();
        if (this.mRowH < 1) { this.mRowH = app.Scale(26); }
        int itemW = 0;
        int sumW = 0;
        for (int i = 0; i < n; i = i + 1) {
            int ww = this.ChildAt(i).prefW;
            if (ww > itemW) { itemW = ww; }
            if (i > 0) { sumW = sumW + this.mColGap; }
            sumW = sumW + ww;
        }
        int rows = 0;
        if (n > 0) {
            if (this.mCols > 0) {
                rows = (n + this.mCols - 1) / this.mCols;
            } else {
                int avail = this.InnerW(this.bw);
                if (avail > 0) { rows = this.FlowRows(avail); }
                else { rows = 1; }
            }
        }
        this.mRows = rows;
        this.prefH = this.RowsHeight(rows);
        if (this.mCols > 0) {
            this.prefW = this.StylePadL() + this.StylePadR()
                       + this.mCols * itemW + (this.mCols - 1) * this.mColGap;
        } else {
            this.prefW = this.StylePadL() + this.StylePadR() + sumW;
        }
    }
    public override void Arrange(int px, int py, int pw, int ph) {
        if (pw < 0) { pw = 0; }
        if (ph < 0) { ph = 0; }
        this.bx = px;
        this.by = py;
        this.bw = pw;
        this.bh = ph;
        int n = this.ChildCount();
        if (n == 0) { this.aRows = 0; return; }
        this.ResolveMetrics();
        int cx0 = px + this.StylePadL();
        int cy = py + this.StylePadT();
        int avail = this.InnerW(pw);
        int rowH = this.mRowH;
        if (rowH < 1) { rowH = ph; }
        if (this.mCols > 0) {
            int cols = this.mCols;
            int span = avail - this.mColGap * (cols - 1);
            if (span < 0) { span = 0; }
            int cell = span / cols;
            int extra = span - cell * cols;
            int rows = (n + cols - 1) / cols;
            for (int i = 0; i < n; i = i + 1) {
                int col = i % cols;
                int row = i / cols;
                int x = cx0 + col * (cell + this.mColGap);
                if (col < extra) { x = x + col; } else { x = x + extra; }
                int w = cell;
                if (col < extra) { w = w + 1; }
                int y = cy + row * (rowH + this.mRowGap);
                this.ArrangeItem(this.ChildAt(i), x, y, w, rowH);
            }
            this.aRows = rows;
            return;
        }
        int cx = cx0;
        int rows2 = 1;
        int used = 0;
        for (int i = 0; i < n; i = i + 1) {
            Control c = this.ChildAt(i);
            int cwid = c.prefW;
            if (cwid < 1) { cwid = avail; }
            if (used > 0 && used + cwid > avail) {
                cx = cx0;
                cy = cy + rowH + this.mRowGap;
                used = 0;
                rows2 = rows2 + 1;
            }
            this.ArrangeItem(c, cx, cy, cwid, rowH);
            cx = cx + cwid + this.mColGap;
            used = used + cwid + this.mColGap;
        }
        this.aRows = rows2;
    }
    private void ArrangeItem(Control c, int x, int y, int w, int rowH) {
        int hh = c.prefH;
        if (hh < 1 || hh > rowH) { hh = rowH; }
        int dy = (rowH - hh) / 2;
        c.Arrange(x, y + dy, w, hh);
    }
}
