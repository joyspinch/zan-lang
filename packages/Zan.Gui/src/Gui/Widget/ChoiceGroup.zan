using System;
using Gui;

namespace Gui.Widget;

// 选项组基类：把若干真实选择控件（Radio/Checkbox）按水平流布局排列，
// 超出可用宽度自动换行。设计器预览与运行时窗口经 FormBuilder / formgen
// 共用同一实现，使多选项在两侧真实且一致地渲染。无表面。
public class ChoiceGroup : Panel {
    // 列距 / 行距的回退值：样式表的 `column-gap` / `row-gap` / `gap`
    // 优先。
    int gapX;
    int gapY;
    // 每行放几个（0 = 按可用宽度自动换行）。样式表的 `columns`
    // 优先。大于 0 时该行按可用宽度等分。
    int columns;
    // 行高（0 = 按最高的选项）。样式表的 `line-height` 优先。
    int rowHeight;
    // gapX / gapY / rowHeight 都是逻辑像素（100% 下的样子），这里存
    // 它们在当前缩放下的值：直接拿逻辑值当物理像素用，150% 下行距
    // 和行高都会偏小，相邻选项行互相贴住。OnMeasure 每帧刷新，
    // 拿不到 App 的 Arrange 复用。
    int sGapX;
    int sGapY;
    int sRowH;
    // 与 children 对齐的选项标签，供 OptionsText 往返（子控件
    // 的 label 字段不统一，不能靠 GetProp 读回）。
    List<string> labels;
    // OnMeasure 解析出的行几何，供没有 App 的 Arrange 复用。
    int mCols;
    int mColGap;
    int mRowGap;
    int mRowH;
    // 测量时假定的行数与实际排布出的行数：不一致说明可用宽度
    // 变了（自动换行模式），下一帧按新宽度重新测量。
    int mRows;
    int aRows;

    // 公共初始化：列距 16 / 行距 4 / 自动换行 / 自适应行高（逻辑像素）。
    void InitChoice() {
        this.InitPanel("choicegroup", 3);
        this.gapX = 16;
        this.gapY = 4;
        this.columns = 0;
        this.rowHeight = 0;
        this.sGapX = 16;
        this.sGapY = 4;
        this.sRowH = 0;
        this.labels = new List<string>();
        this.mCols = 0;
        this.mColGap = 16;
        this.mRowGap = 4;
        this.mRowH = 0;
        this.mRows = 0;
        this.aRows = 0;
    }

    // 每行的选项个数（0 = 按宽度自动换行）。设为 N 后该行按可用宽度等分成
    // N 列，最后一行不足 N 个也保持同样的列宽。
    void SetColumns(int n) {
        if (n < 0) { n = 0; }
        this.columns = n;
    }

    // 当前配置的每行选项数（0 = 按宽度自动换行）。
    int Columns() { return this.columns; }

    // 每行的高度（0 = 按最高的选项自适应）。选项在行内垂直居中，
    // 所以调大行高只会拉开行距，不会让相邻行互相压住。
    void SetRowHeight(int h) {
        if (h < 0) { h = 0; }
        this.rowHeight = h;
        // 缩放镜像只在 OnMeasure(app) 里刷新，而排布（ResolveMetrics）读的是
        // 镜像值：不经测量直接 Arrange 时它还是 0，行高与行内居中就都丢了。
        // 这里先按 100% 基准写入，OnMeasure 再按真实缩放覆盖。
        this.sRowH = h;
    }

    // 当前配置的行高（0 = 按最高选项自适应）。
    int RowHeight() { return this.rowHeight; }

    // 选项组是自己的 CSS 类型（`checkboxgroup` / `radiogroup`），而不是
    // Panel 的 `stack`：皮肤要能单独给它写 `columns` / `row-gap` /
    // `column-gap` / `line-height`，而不影响所有布局容器。
    override string StyleType() {
        if (styleTypeLower == "") { styleTypeLower = this.Kind().ToLower(); }
        return styleTypeLower;
    }

    // 供子类实现：为第 index 个选项构造单个选择控件。
    virtual Control MakeItem(int index, string text) {
        return null;
    }

    // 选项以 `a|b|c` 字符串表示（设计器 / 设计文档属性往返）；
    // 子类可扩展语法（RadioGroup 的 `!` 后缀 = 禁用位）。
    virtual string OptionsText() {
        string outp = "";
        for (int i = 0; i < this.labels.Count; i = i + 1) {
            if (i > 0) { outp = outp + "|"; }
            outp = outp + this.labels[i];
        }
        return outp;
    }

    // 追加一个选项，返回新建的选择控件（越界/构造失败时为 null）。
    // 代码里逐项建组用这个：`g.AddOption("Cheese")`——`Add` 是基类
    // 挂子控件用的，选项组要的是「按标签造一个选项」，两回事。
    // 选项个数。聚合查询（"全选" 父项要拿它和 CheckedCount 比）
    // 靠它，调用方不必去数 children。
    int Count() { return this.children.Count; }

    // 按标签构造一个选项控件并对齐 labels（失败返回 null；
    // 详见上方 Count 处的说明——那份文档本属本方法）。
    Control AddOption(string text) {
        if (text == "") { return null; }
        Control item = this.MakeItem(this.children.Count, text);
        if (item == null) { return null; }
        this.labels.Add(text);
        this.Add(item);
        return item;
    }

    // 按 "A|B|C" 或 JSON 数组追加选项（与 SelectBox.SetOptionsText 同一约定）；
    // 子类可覆写以扩展逐项语法。
    virtual void SetOptionsText(string text) {
        if (text == null || text.Length == 0) { return; }
        string s = text.Trim();
        if (s.StartsWith("[") && s.EndsWith("]")) {
            JsonValue arr = JsonValue.ParseLenient(s);
            if (arr != null && arr.IsArray()) {
                for (int i = 0; i < arr.Count(); i = i + 1) {
                    JsonValue it = arr.At(i);
                    if (it == null) { continue; }
                    if (it.IsObject()) {
                        string lbl = it.Str("label", "");
                        if (lbl == "") { lbl = it.Str("name", ""); }
                        if (lbl == "") { lbl = it.Str("title", ""); }
                        if (lbl == "") { lbl = it.Str("text", ""); }
                        if (lbl == "") { lbl = it.Str("value", ""); }
                        this.AddOption(lbl);
                    } else {
                        this.AddOption(it.AsString(""));
                    }
                }
                return;
            }
        }
        List<string> parts = text.Split("|");
        for (int i = 0; i < parts.Count; i = i + 1) {
            this.AddOption(parts[i]);
        }
    }

    // 覆写：`options` 的应答走 OptionsText——选项是结构状态，
    // 文本只是它的视图，不能落 Props() 的快照；其余键交基类。
    override string GetProp(string key) {
        if (key == "options") { return this.OptionsText(); }
        return base.GetProp(key);
    }

    // 清空全部选项（设计器重复写入 `options` 前调用；子类要连
    // 平行的元数据列表一起清，否则下标错位）。
    virtual void ClearOptions() {
        this.children.Clear();
        this.labels.Clear();
    }

    // 覆写：写入 `options` 先清后建（面板可反复编辑，追加语义
    // 只属于构造期的 SetOptionsText 直调）；其余键交基类。
    override void SetProp(string key, string val) {
        if (key == "options") {
            this.ClearOptions();
            this.SetOptionsText(val);
            return;
        }
        base.SetProp(key, val);
    }

    // 覆写：返回设计器属性清单（columns/rowHeight）。
    override List<PropSpec> Props() {
        List<PropSpec> ps = new List<PropSpec>();
        PropSpec cols = PropSpec.Int("columns", "Columns")
            .WithTip("每行几个选项，0 = 按宽度自动换行；大于 0 时按可用宽度等分")
            .Step(1, 0, 24);
        cols.num = columns;
        ps.Add(cols);
        PropSpec rh = PropSpec.Int("rowHeight", "Row height")
            .WithTip("每行的高度，0 = 按最高的选项自适应")
            .Step(2, 0, 200);
        rh.num = rowHeight;
        ps.Add(rh);
        PropSpec opt = PropSpec.Text("options", "Options");
        opt.str = this.OptionsText();
        opt.WithTip("Pipe-separated options, e.g. \"A|B|C\". "
                    + "RadioGroup items may carry a trailing \"!\" to disable.");
        ps.Add(opt);
        return ps;
    }

    // 覆写：自动换行行数随宽度变化时按新行数重测一次，
    // 避免高度停留在旧行数上把选项裁掉。
    override void OnPaint(App app) {
        // 自动换行模式下，测量用的是上一帧的宽度：宽度一变行数就变，
        // 此时按新行数重新测量一次，避免高度停留在旧行数上（选项被裁掉）。
        if (this.aRows != this.mRows) {
            this.mRows = this.aRows;
            this.prefH = this.RowsHeight(this.aRows);
            app.RequestRedraw();
        }
    }

    // 内容区宽度（去掉内边距）。
    int InnerW(int pw) {
        int w = pw - this.StylePadL() - this.StylePadR();
        if (w < 0) { return 0; }
        return w;
    }

    // `rows` 行占用的总高度（含内边距与行距）。
    int RowsHeight(int rows) {
        if (rows < 1) { return this.StylePadT() + this.StylePadB(); }
        return this.StylePadT() + this.StylePadB()
             + rows * this.mRowH + (rows - 1) * this.mRowGap;
    }

    // 自动换行模式下，宽度 `avail` 内能排下的行数。
    int FlowRows(int avail) {
        int n = this.children.Count;
        if (n == 0) { return 0; }
        int rows = 1;
        int used = 0;
        for (int i = 0; i < n; i = i + 1) {
            int cwid = this.children[i].prefW;
            if (cwid < 1) { cwid = avail; }
            if (used > 0 && used + cwid > avail) {
                rows = rows + 1;
                used = 0;
            }
            used = used + cwid + this.mColGap;
        }
        return rows;
    }

    // 像素行距/列距：与 ResolveMetrics 同一解析（CSS row-gap /
    // column-gap，回退到字段配置），供按钮组形态在样式解析后取用。
    int RowGapPx() { return this.StyleRowGap(this.sGapY); }
    // 像素列距（CSS column-gap，回退字段配置）。
    int ColGapPx() { return this.StyleColGap(this.sGapX); }


    // 解析行几何（列数 / 行距 / 列距 / 行高）。全部取自已解析的
    // 样式盒与子项尺寸，不需要 App，因此 Arrange 也能自己调（不
    // 依赖先跑过 OnMeasure）。
    void ResolveMetrics() {
        int n = this.children.Count;
        this.mColGap = this.StyleColGap(this.sGapX);
        this.mRowGap = this.StyleRowGap(this.sGapY);
        // 控件上显式配置的列数优先；没配就听样式表的
        // （皮肤的 `columns` / 原子类 `grid-cols-N`）。
        this.mCols = this.columns;
        if (this.mCols < 1) { this.mCols = this.StyleColumns(0); }
        if (this.mCols < 0) { this.mCols = 0; }
        if (this.mCols > n && n > 0) { this.mCols = n; }

        // 行高：样式表的 line-height 优先（皮肤可整体调大行高），
        // 其次是字段配置的行高，最后才是最高的选项。选项自身的
        // 高度同样来自样式（checkbox 的 height），所以调大控件
        // 高度只会拉开行距，不会让相邻行互相重叠。
        int itemH = 0;
        for (int i = 0; i < n; i = i + 1) {
            int hh = this.children[i].prefH;
            if (hh > itemH) { itemH = hh; }
        }
        int lineH = this.StyleLineHeight();
        if (lineH < 1) { lineH = this.sRowH; }
        if (lineH > itemH) { itemH = lineH; }
        this.mRowH = itemH;
    }

    // 覆写：解析行几何后按固定列数/自动换行算出行数，
    // 得出内容首选宽高。
    override void OnMeasure(App app) {
        int n = this.children.Count;
        this.sGapX = app.Scale(this.gapX);
        this.sGapY = app.Scale(this.gapY);
        this.sRowH = app.Scale(this.rowHeight);
        this.ResolveMetrics();
        if (this.mRowH < 1) { this.mRowH = app.Scale(26); }
        int itemW = 0;
        int sumW = 0;
        for (int i = 0; i < n; i = i + 1) {
            int ww = this.children[i].prefW;
            if (ww > itemW) { itemW = ww; }
            if (i > 0) { sumW = sumW + this.mColGap; }
            sumW = sumW + ww;
        }

        int rows = 0;
        if (n > 0) {
            if (this.mCols > 0) {
                rows = (n + this.mCols - 1) / this.mCols;
            } else {
                // 自动换行：只有已经排布过一次才知道可用宽度。
                int avail = this.InnerW(this.bw);
                if (avail > 0) { rows = this.FlowRows(avail); }
                else { rows = 1; }
            }
        }
        this.mRows = rows;
        this.prefH = this.RowsHeight(rows);
        if (this.mCols > 0) {
            this.prefW = this.StylePadL() + this.StylePadR()
                       + this.mCols * itemW + (this.mCols - 1) * this.mColGap;
        } else {
            this.prefW = this.StylePadL() + this.StylePadR() + sumW;
        }
    }

    // 覆写：固定列数时等分宽排布（余数摊给前几列），否则按选项
    // 自身宽度流式换行；行高统一，选项在格内垂直居中。
    override void Arrange(int px, int py, int pw, int ph) {
        if (pw < 0) { pw = 0; }
        if (ph < 0) { ph = 0; }
        this.bx = px;
        this.by = py;
        this.bw = pw;
        this.bh = ph;
        int n = this.children.Count;
        if (n == 0) { this.aRows = 0; return; }
        this.ResolveMetrics();
        int cx0 = px + this.StylePadL();
        int cy = py + this.StylePadT();
        int avail = this.InnerW(pw);
        int rowH = this.mRowH;
        if (rowH < 1) { rowH = ph; }

        if (this.mCols > 0) {
            int cols = this.mCols;
            int span = avail - this.mColGap * (cols - 1);
            if (span < 0) { span = 0; }
            int cell = span / cols;
            int extra = span - cell * cols;
            int rows = (n + cols - 1) / cols;
            for (int i = 0; i < n; i = i + 1) {
                int col = i % cols;
                int row = i / cols;
                // 余数摊给前几列，各列宽度最多相差 1px。
                int x = cx0 + col * (cell + this.mColGap);
                if (col < extra) { x = x + col; } else { x = x + extra; }
                int w = cell;
                if (col < extra) { w = w + 1; }
                int y = cy + row * (rowH + this.mRowGap);
                this.ArrangeItem(this.children[i], x, y, w, rowH);
            }
            this.aRows = rows;
            return;
        }

        // 自动换行：按选项自身宽度流式排列，行高统一。
        int cx = cx0;
        int rows2 = 1;
        int used = 0;
        for (int i = 0; i < n; i = i + 1) {
            Control c = this.children[i];
            int cwid = c.prefW;
            if (cwid < 1) { cwid = avail; }
            if (used > 0 && used + cwid > avail) {
                cx = cx0;
                cy = cy + rowH + this.mRowGap;
                used = 0;
                rows2 = rows2 + 1;
            }
            this.ArrangeItem(c, cx, cy, cwid, rowH);
            cx = cx + cwid + this.mColGap;
            used = used + cwid + this.mColGap;
        }
        this.aRows = rows2;
    }

    // 把一个选项放进行高为 `rowH` 的单元格里：选项按自身高度
    // 垂直居中，行高调大只会拉开行距，不会让相邻行互相压住。
    void ArrangeItem(Control c, int x, int y, int w, int rowH) {
        int hh = c.prefH;
        if (hh < 1 || hh > rowH) { hh = rowH; }
        int dy = (rowH - hh) / 2;
        c.Arrange(x, y + dy, w, hh);
    }
}
