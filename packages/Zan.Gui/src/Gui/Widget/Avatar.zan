using System;
using Gui;

namespace Gui.Widget;

// 头像组件：纯 Flex 居中容器，支持图标与首字母文字展示。
// 外壳与形状（circle/rounded/square）完全由 CSS 盒模型接管，彻底物理消除 SubBox 与手动微绘。
public class Avatar : Control {
    public Binding<string> Text;
    public string Icon;
    public int Size;
    public string Shape;

    public override int StyleDisplay() { return 1; } // CSS display: flex
    public override int StyleFlexDir() { return 0; } // flex-direction: row

    private void InitAvatar(string label, int size, string icon) {
        this.InitControl("avatar", 1);
        Text = label;
        Icon = icon;
        Size = size;
        Shape = "circle";
        Class = "primary";
        this.RebuildAvatar();
    }

    // 头像直径：显式 Size 与样式行高取大者（测量与行内绘制共用）。
    public int Diameter() { return this.Diameter(this.App); }
    public int Diameter(App app) {
        app = this.ResolveApp(app);
        if (app == null) { return Size > 0 ? Size : 32; }
        return this.ResolveStyleAs(app, "avatar", Class, Style.SNormal())
            .HeightOr(app.Scale(Size));
    }

    public Avatar() { InitAvatar("", 32, ""); }
    public Avatar(string label) { InitAvatar(label, 32, ""); }
    public Avatar(string label, int size) { InitAvatar(label, size, ""); }
    public Avatar(string label, int size, string icon) { InitAvatar(label, size, icon); }

    public string Label() {
        if (Text == null) { return ""; }
        return Text.Get();
    }

    public void SetText(string v) {
        Text = v;
        this.RebuildAvatar();
        App a = this.FindApp();
        if (a != null) { a.RequestRedraw(); }
    }

    public void SetIcon(string ico) {
        Icon = ico;
        this.RebuildAvatar();
        App a = this.FindApp();
        if (a != null) { a.RequestRedraw(); }
    }

    public void RebuildAvatar() {
        this.children.Clear();
        if (Icon != "") {
            this.Add(new IconView(Icon, Size > 0 ? Size / 2 : 16) { ClassName = "avatar-icon" });
        } else {
            string t = this.Label();
            if (t != "") {
                this.Add(new Label(t) { ClassName = "avatar-text" });
            }
        }
    }

    public override void SyncBinding() {
        base.SyncBinding();
        if (Shape == "square") { this.AddClass("square"); }
        else if (Shape == "rounded") { this.AddClass("rounded"); }
        else { this.AddClass("circle"); }
    }

    public override string Kind() { return "Avatar"; }

    public override List<PropSpec> Props() {
        List<PropSpec> ps = new List<PropSpec>();
        PropSpec text = PropSpec.Text("text", "Text");
        text.str = Text;
        ps.Add(text);
        PropSpec icon = PropSpec.Text("icon", "Icon");
        icon.str = Icon;
        ps.Add(icon);
        PropSpec size = PropSpec.Int("size", "Size");
        size.num = Size;
        ps.Add(size);
        PropSpec shape = PropSpec.Enum("shape", "Shape",
            new List<string>{ "circle", "rounded", "square" });
        shape.str = Shape;
        ps.Add(shape);
        return ps;
    }
}
