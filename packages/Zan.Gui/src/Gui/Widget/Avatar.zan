using System;
using Gui;
namespace Gui.Widget;
public class Avatar : Control {
    public override Control CreateCloneShell() { return new Avatar(); }
    public Binding<string> Text;
    public string Icon;
    public int Size;
    public string Shape;
    private string lastSyncedShape;
    private string lastSyncedCls;
    protected override bool UsesBaseFlowOnly() { return this.Kind() == "Avatar"; }
    public override int StyleDisplay() { return 1; } // CSS display: flex
    public override int StyleFlexDir() { return 0; } // flex-direction: row
    private void InitAvatar(string label, int size, string icon) {
        this.InitControl("avatar");
        Text = label;
        Icon = icon;
        Size = size;
        Shape = "circle";
        Class = "primary";
        this.RebuildAvatar();
    }
    public int Diameter() { return this.Diameter(this.App); }
    public int Diameter(App app) {
        app = this.ResolveApp(app);
        if (app == null) { return Size > 0 ? Size : 32; }
        StyleBox s = this.ResolveStyleCached(app, "avatar", Class, Style.SNormal());
        return s.HeightOr(app.Scale(Size));
    }
    public Avatar() { InitAvatar("", 32, ""); }
    public Avatar(string label) { InitAvatar(label, 32, ""); }
    public Avatar(string label, int size) { InitAvatar(label, size, ""); }
    public Avatar(string label, int size, string icon) { InitAvatar(label, size, icon); }
    public string Label() {
        if (Text == null) { return ""; }
        return Text.Get();
    }
    public void SetText(string v) {
        Text = v;
        this.RebuildAvatar();
        this.RequestRedraw();
    }
    public void SetIcon(string ico) {
        Icon = ico;
        this.RebuildAvatar();
        this.RequestRedraw();
    }
    public void RebuildAvatar() {
        this.RemoveAll();
        if (Icon != "") {
            this.Add(new IconView(Icon, Size > 0 ? Size / 2 : 16) { ClassName = "avatar-icon" });
        } else {
            string t = this.Label();
            if (t != "") {
                this.Add(new Label(t) { ClassName = "avatar-text" });
            }
        }
    }
    public override void OnMeasure(App app) {
        int diameter = this.Diameter(app);
        prefW = diameter;
        prefH = diameter;
    }
    public override void SyncBinding() {
        base.SyncBinding();
        string shapeCls = "circle";
        if (Shape == "square") { shapeCls = "square"; }
        else if (Shape == "rounded") { shapeCls = "rounded"; }
        if (lastSyncedShape == shapeCls && lastSyncedCls == Class) { return; }
        this.SetClassIn("circle rounded square", shapeCls);
        lastSyncedShape = shapeCls;
        lastSyncedCls = Class;
    }
    public override void CloneContentTo(Control target, CloneTreeFn clone) {
    }

    protected override List<PropSpec> DefineProps() {
        List<PropSpec> ps = new List<PropSpec>();
        ps.Add(PropSpec.TextField("Text"));
        ps.Add(PropSpec.TextField("Icon"));
        ps.Add(PropSpec.IntField("Size"));
        PropSpec shape = PropSpec.Enum("shape", "Shape",
            new List<string>{ "circle", "rounded", "square" });
        shape.Field("Shape");
        ps.Add(shape);
        return ps;
    }
}
