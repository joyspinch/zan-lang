using System;
using Gui;

namespace Gui.Widget;

// 步骤式向导（Wizard）：组合 Steps 步骤指示器、步骤内容面板与上一步/下一步/完成控制。
// 纯声明式对象树与 CSS 盒模型，无任何应用层业务逻辑与即时微绘。
public class Wizard : Control {
    public Steps steps;
    public Control content;
    public Button prevBtn;
    public Button nextBtn;
    public Button finishBtn;
    public SignalInt currentStep;
    public UiEvent StepChange;
    public UiEvent Finish;

    public override int StyleDisplay() { return 1; } // Flex
    public override int StyleFlexDir() { return 1; } // Column

    public Wizard() {
        this.InitControl("wizard", 1);
        this.ClassName = "wizard col";
        currentStep = new SignalInt(0);
        StepChange = new UiEvent();
        Finish = new UiEvent();
        steps = new Steps(currentStep);
        content = new Control();
        content.ClassName = "wizard-content flex-1 col";

        prevBtn = new Button("上一步");
        prevBtn.ClassName = "wizard-prev";
        prevBtn.Click.Add(() => { this.Prev(); });

        nextBtn = new Button("下一步");
        nextBtn.ClassName = "wizard-next primary";
        nextBtn.Click.Add(() => { this.Next(); });

        finishBtn = new Button("完成");
        finishBtn.ClassName = "wizard-finish primary";
        finishBtn.Click.Add(() => { this.OnFinish(); });

        this.BuildTree();
    }

    public void AddStep(string title, Control pane) {
        steps.AddStep(title);
        content.Add(pane);
        this.SyncStepView();
    }

    public void Prev() {
        int cur = currentStep.Get();
        if (cur > 0) {
            currentStep.Set(cur - 1);
            StepChange.RaiseS(this);
            this.SyncStepView();
        }
    }

    public void Next() {
        int cur = currentStep.Get();
        if (cur < steps.steps.Count - 1) {
            currentStep.Set(cur + 1);
            StepChange.RaiseS(this);
            this.SyncStepView();
        }
    }

    public void OnFinish() {
        Finish.RaiseS(this);
    }

    public void SyncStepView() {
        int cur = currentStep.Get();
        int count = steps.steps.Count;
        prevBtn.Disabled = cur <= 0;
        nextBtn.Visible = cur < count - 1;
        finishBtn.Visible = cur == count - 1;
        for (int i = 0; i < content.children.Count; i = i + 1) {
            content.children[i].Visible = (i == cur);
        }
    }

    public void BuildTree() {
        this.children.Clear();
        this.Add(steps);
        this.Add(content);

        Control footer = new Control();
        footer.ClassName = "wizard-footer row justify-end align-center gap-medium";
        footer.Add(prevBtn);
        footer.Add(nextBtn);
        footer.Add(finishBtn);
        this.Add(footer);

        this.SyncStepView();
    }

    public override string Kind() { return "Wizard"; }

    public override List<PropSpec> Props() {
        List<PropSpec> ps = new List<PropSpec>();
        PropSpec step = PropSpec.Int("step", "Current Step");
        step.num = currentStep != null ? currentStep.Get() : 0;
        step.Also("data");
        step.Also("value");
        ps.Add(step);
        ps.Add(this.SizeProp());
        return ps;
    }

    public override string GetProp(string key) {
        if (key == "step" || key == "data" || key == "value") {
            return Convert.ToString(currentStep.Get());
        }
        return base.GetProp(key);
    }

    public override void SetProp(string key, string val) {
        if (key == "step" || key == "data" || key == "value") {
            currentStep.Set(Convert.ToInt32(val));
            this.SyncStepView();
            return;
        }
        base.SetProp(key, val);
    }
}
