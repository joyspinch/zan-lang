using System;
using System.Collections.Generic;
using System.Json;
using Formats.Csv;
using Gui;
using Gui.Widget;
namespace Gui;
public delegate Control NavPageFactory();
public delegate void NavEnterHandler(NavWindow win, JsonValue args);
public class Nav {
    static NavRoute Define(string name, NavPageFactory make) { return Nav.DefineTitle(name, name, make); }
    static NavRoute DefineTitle(string name, string title, NavPageFactory make) {
        GuiNavState state = GuiNavState.Current();
        if (state.routes == null) { state.routes = new List<NavRoute>(); }
        NavRoute r = Nav.Find(name);
        if (r != null) {
            r.make = make;
            r.title = title;
            return r;
        }
        NavRoute nr = new NavRoute();
        nr.name = name;
        nr.title = title;
        nr.make = make;
        nr.keepAlive = true;
        state.routes.Add(nr);
        return nr;
    }
    static void OnEnter(string name, NavEnterHandler h) {
        NavRoute r = Nav.Find(name);
        if (r != null) { r.enter = h; }
    }
    static void SetKeepAlive(string name, bool on) {
        NavRoute r = Nav.Find(name);
        if (r != null) { r.keepAlive = on; }
    }
    static void SetWindowSize(string name, int width, int height) {
        NavRoute r = Nav.Find(name);
        if (r == null) { return; }
        r.winW = width;
        r.winH = height;
    }
    static NavRoute Find(string name) {
        List<NavRoute> routes = GuiNavState.Current().routes;
        if (routes == null) { return null; }
        for (int i = 0; i < routes.Count; i = i + 1) {
            if (routes[i].name == name) { return routes[i]; }
        }
        return null;
    }
    static void Open(string name, App parent) { Nav.OpenArgs(name, parent, null); }
    static void OpenArgs(string name, App parent, JsonValue args) {
        NavRoute r = Nav.Find(name);
        if (r == null || r.make == null) {
            Console.WriteLine("Nav: undefined route '" + name + "'");
            return;
        }
        if (parent == null) {
            Console.WriteLine("Nav: no parent app for route '" + name + "'");
            return;
        }
        NavWindow w = Nav.FindOpen(name);
        if (w != null) {
            w.Replay(args);
            Nav.Activate(w);
            return;
        }
        w = new NavWindow();
        w.OpenFor(r, parent, args);
        GuiNavState state = GuiNavState.Current();
        if (state.openStack == null) { state.openStack = new List<NavWindow>(); }
        state.openStack.Add(w);
    }
    static NavWindow FindOpen(string name) {
        List<NavWindow> openStack = GuiNavState.Current().openStack;
        if (openStack == null) { return null; }
        for (int i = openStack.Count - 1; i >= 0; i = i - 1) {
            NavWindow w = openStack[i];
            if (w.IsOpen() && w.rt != null && w.rt.name == name) { return w; }
        }
        return null;
    }
    static bool Back() {
        Nav.Prune();
        List<NavWindow> openStack = GuiNavState.Current().openStack;
        if (openStack == null || openStack.Count == 0) { return false; }
        NavWindow w = openStack[openStack.Count - 1];
        openStack.RemoveAt(openStack.Count - 1);
        w.Close();
        return true;
    }
    static void CloseAll() {
        GuiNavState state = GuiNavState.Current();
        if (state.openStack == null) { return; }
        for (int i = 0; i < state.openStack.Count; i = i + 1) {
            if (state.openStack[i].IsOpen()) { state.openStack[i].Close(); }
        }
        state.openStack = new List<NavWindow>();
    }
    static void Embed(Tabs tabs, string routeCsv) {
        if (tabs == null) { return; }
        GuiNavState state = GuiNavState.Current();
        if (state.embeds == null) { state.embeds = new List<NavEmbed>(); }
        List<NavEmbed> embeds = state.embeds;
        for (int i = 0; i < embeds.Count; i = i + 1) {
            if (embeds[i].tabs == tabs) { return; }
        }
        NavEmbed e = new NavEmbed();
        e.tabs = tabs;
        e.names = new List<string>();
        List<string> routes = Csv.ParseRow(routeCsv);
        for (int i = 0; i < routes.Count; i = i + 1) {
            Nav.TryAddEmbedTab(e, routes[i]);
        }
        tabs.BindEventS("TabChanged", Nav.EmbedChanged);
        embeds.Add(e);
        if (tabs.Active() < 0 && tabs.Count() > 0) { tabs.Select(0); }
        int act = tabs.Active();
        if (act >= 0) { Nav.EnsureEmbedPage(e, act); }
    }
    static void Unembed(Tabs tabs) {
        List<NavEmbed> embeds = GuiNavState.Current().embeds;
        if (embeds == null || tabs == null) { return; }
        for (int i = embeds.Count - 1; i >= 0; i = i - 1) {
            if (embeds[i].tabs == tabs) { embeds.RemoveAt(i); }
        }
    }
    static void ClearEmbeds() {
        List<NavEmbed> embeds = GuiNavState.Current().embeds;
        if (embeds != null) { embeds.Clear(); }
    }
    static void EmbedChanged(Control sender) {
        List<NavEmbed> embeds = GuiNavState.Current().embeds;
        if (embeds == null || sender == null) { return; }
        for (int k = 0; k < embeds.Count; k = k + 1) {
            NavEmbed e = embeds[k];
            if (e.tabs != sender) { continue; }
            int idx = e.tabs.Active();
            if (idx < 0) { return; }
            for (int j = 0; j < e.names.Count; j = j + 1) {
                if (j == idx) { continue; }
                NavRoute rj = Nav.Find(e.names[j]);
                if (rj == null || rj.keepAlive) { continue; }
                Panel pj = e.tabs.Page(j);
                if (pj.ChildCount() > 0) { pj.RemoveAll(); }
            }
            Nav.EnsureEmbedPage(e, idx);
            return;
        }
    }
    static void TryAddEmbedTab(NavEmbed e, string name) {
        if (name == "") { return; }
        NavRoute r = Nav.Find(name);
        if (r == null) { return; }
        e.names.Add(name);
        e.tabs.Add(r.title, false);
    }
    static void EnsureEmbedPage(NavEmbed e, int i) {
        if (i < 0 || i >= e.names.Count) { return; }
        NavRoute r = Nav.Find(e.names[i]);
        if (r == null || r.make == null) { return; }
        Panel page = e.tabs.Page(i);
        if (page.ChildCount() > 0) {
            if (r.keepAlive) { return; }
            page.RemoveAll();
        }
        Control ctl = r.make();
        if (ctl == null) { return; }
        page.Add(ctl);
        if (r.enter != null) { r.enter(null, null); }
    }
    static void Prune() {
        List<NavWindow> openStack = GuiNavState.Current().openStack;
        if (openStack == null) { return; }
        for (int i = openStack.Count - 1; i >= 0; i = i - 1) {
            if (!openStack[i].IsOpen()) { openStack.RemoveAt(i); }
        }
    }
    static void Activate(NavWindow w) {
        if (w == null || !w.IsOpen()) { return; }
        if (w.Host() != null) { Gui.Backend.Platform.Window().SetForegroundWindow(w.Host().WindowHandle()); }
    }
    static int NextIdBase() { return WidgetId.Block(1000); }
}
