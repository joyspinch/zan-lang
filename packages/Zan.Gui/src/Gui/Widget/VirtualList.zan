using System;
using Gui;
using Gui.Backend;

namespace Gui.Widget;

// 为虚拟列表构建第 `index` 行的控件子树；数据由调用方的
// 闭包持有，行只在进入视口时才会被构建。
public delegate Control RowAt(int index);

// 高层级虚拟化列表。
// 保留式（创建一次，跨帧保留）。在任意大的条目列表上渲染一个
// 固定高度、带边框的视口，只绘制
// 当前可见的行（行虚拟化），10 万行的开销与
// 一屏相同。它拥有像素滚动、滚动条以及悬停/选择，
// 内部组合了一个 ScrollView——调用点只需：
// VirtualList list = new VirtualList();     // 一次
// list.SetItems(rows);
// list.Render(app, x, y, w, h);                // 每帧
// int sel = list.Selected();                   // -1 表示无
// int hit = list.TakeActivated();              // 本帧点击的行，-1
// 行也可以是自定义组件（模板模式，与 ListView 的行模板同构，
// 但只在行进入视口时才构建）：
// ...                                         // 数据变更后
// list.Refresh();                             // 下一帧重建可见行
// 行内子控件（按钮、开关）照常收自己的点击：每行按行号独占
// 一段 WidgetId，滚动或重建都不改号，上一帧登记的命中区因此
// 始终对得上。行等高（虚拟化的前提）；行内控件的易失状态
// （如开关的本地翻转）放在调用方的数据里，重建后由数据恢复。
// 与 ListView（每行全高布局、无视口）不同，
// 本组件成本恒定且自行滚动。
public class VirtualList : Control {
    private ScrollView scroll;
    private List<string> items;
    private int selected;
    private int rowH;
    private int activated;
    // 模板模式的行构建器；null = 字符串行模式。
    private RowAt rowAt;
    private int rowCount;
    // 模板行待重建标记；可见区间变化时也会重建。
    private bool rowsStale;
    private int builtFirst;
    private int builtLast;
    // 模板行独占的 WidgetId 段起点（-1 = 还没建过行）。
    private int rowSeqBase;
    // 字符串行悬停提示的跟踪状态：正在计时的行号（-1 无）
    // 与指针进入该行的时刻。指针换行或离开即重置。
    private int tipIdx;
    private int tipSinceMs;
    // 视口矩形缓存，消除每帧 Render 中的堆分配
    private Rect viewportArea;

    // 空列表（字符串行模式，之后 SetItems/SetRows）。
    public VirtualList() {
        this.InitControl("virtualList", 5);
        this.scroll = new ScrollView();
        this.items = new List<string>();
        this.selected = 0 - 1;
        this.rowH = 0;
        this.activated = 0 - 1;
        this.rowAt = null;
        this.rowCount = 0;
        this.rowsStale = true;
        this.builtFirst = 0 - 1;
        this.builtLast = 0 - 1;
        this.rowSeqBase = 0 - 1;
        this.tipIdx = 0 - 1;
        this.tipSinceMs = 0;
        this.viewportArea = new Rect(0, 0, 0, 0);
    }

    // 控件类型标识（序列化/设计器用）。
    public override string Kind() { return "VirtualList"; }

    // 覆写：返回设计器属性清单（rowHeight）。
    public override List<PropSpec> Props() {
        List<PropSpec> ps = new List<PropSpec>();
        PropSpec rh = PropSpec.Int("rowHeight", "Row height");
        rh.num = rowH;
        rh.Step(1, 0, 1000);
        rh.WithTip("Fixed row height in logical pixels; zero uses the theme default.");
        ps.Add(rh);
        return ps;
    }

    // 覆写：默认 240x160 的逻辑尺寸（实际占宿主给的矩形）。
    public override void OnMeasure(App app) {
        prefW = app.Scale(240);
        prefH = app.Scale(160);
    }

    // 覆写：保留模式绘制——基于自身盒模型 (bx, by, bw, bh) 统一渲染。
    public override void OnPaint(App app) {
        int rh = this.ResolveRowH(app);
        int n = this.Count();
        int contentH = n * rh;
        this.viewportArea.Set(bx + 1, by + 1, bw - 2, bh - 2);
        Rect area = this.viewportArea;
        int dy = scroll.Begin(app, area, contentH);
        bool templated = rowAt != null;

        int first = dy / rh;
        if (first < 0) { first = 0; }
        int visible = area.height / rh + 2;
        int last = first + visible;
        if (last > n) { last = n; }
        if (templated) { this.BuildVisible(app, first, last); }

        int rowW = area.width;
        if (scroll.Overflowing()) { rowW = rowW - 12; }
        if (rowW < 0) { rowW = 0; }

        int i = first;
        while (i < last) {
            int ry = area.y + i * rh - dy;
            if (templated && i - first < children.Count) {
                Control row = children[i - first];
                row.Arrange(area.x, ry, rowW, rh);
                row.visible = true;
            }
            i = i + 1;
        }
        scroll.End(app, area);
    }

    // 每行独占的 WidgetId 数：够放一行十来个控件还有余。
    // 超出会把段基后移、下一帧整体重建——宁可丢一次点击，
    // 也不能让两行共用同一段 id。
    public static int RowIdStride() { return 64; }

    // 整体替换字符串行数据（模板模式之外的最简用法）；
    // 行数变化后选中行号自动夹回范围内。
    public void SetItems(List<string> rows) {
        items = rows;
        rowAt = null;
        rowCount = 0;
        if (selected >= rows.Count) { selected = rows.Count - 1; }
    }

    // 追加一行字符串数据。
    public void Add(string row) {
        items.Add(row);
    }

    // 模板模式：共 `count` 行，第 `i` 行由 `build(i)` 构建控件
    // 子树，数据由调用方闭包持有。构建器像 ListView 的行模板
    // 一样创建一次即可；行 id 只取决于行号，因此即使每帧传入
    // 新的 lambda（内容相同），行内控件也照常收得到点击。
    // 行数变化或内容变更（Refresh()）后，可见行在下一帧重建。
    public void SetRows(int count, RowAt build) {
        if (build != rowAt) {
            rowAt = build;
            rowsStale = true;
        }
        if (count != rowCount) {
            rowCount = count;
            rowsStale = true;
            // 段长随行数变化：已领出的段外 id 可能已归属别的控件，
            // 换一段（行 id 移动一次，代价与 ListView 重建同量级）。
            rowSeqBase = 0 - 1;
            if (selected >= rowCount) { selected = rowCount - 1; }
        }
    }

    // 标记模板行数据已变更，可见行将在下一帧重建。
    // 任意线程调用都安全。
    public void Refresh() { rowsStale = true; }

    // 固定行高（逻辑 px）；0 = 用主题的 heightLarge。
    public void SetRowHeight(int h) {
        rowH = h;
    }

    // 当前行数：模板模式返回 SetRows 给的 count，
    // 字符串模式返回 items 数。
    public int Count() {
        if (rowAt != null) { return rowCount; }
        return items.Count;
    }

    // 当前选中行号（无选中为 -1）。
    public int Selected() {
        return selected;
    }

    // 选中行的文本；模板模式无文本概念，恒返回 ""。
    public string SelectedText() {
        if (rowAt != null) { return ""; }
        if (selected < 0 || selected >= items.Count) { return ""; }
        return items[selected];
    }

    // 本帧点击的行（或 -1），随后清除。
    public int TakeActivated() {
        int r = activated;
        activated = 0 - 1;
        return r;
    }

    // 实际使用的行高：显式 SetRowHeight 优先，否则主题值。
    public int ResolveRowH() { return this.ResolveRowH(this.App); }
    public int ResolveRowH(App app) {
        if (rowH > 0) { return rowH; }
        app = this.ResolveApp(app);
        return app != null ? app.theme.heightLarge : 32;
    }

    // 为可见区间 [first, last) 重建模板行。行控件的 WidgetId
    // 按「段基 + 行号 × 步长」发号：滚动改变可见集时行内控件
    // 的 id 不变，上一帧登记的命中区依旧对得上号；区间与数据
    // 都没变时不动 children，行内控件跨帧保留。
    private void BuildVisible(App app, int first, int last) {
        if (!rowsStale && first == builtFirst && last == builtLast) { return; }
        children = new List<Control>();
        int i = first;
        while (i < last) {
            WidgetId.Push(i);
            Control row = rowAt(i);
            if (row == null) { row = Panel.Root("vrow"); }
            row.parent = this;
            children.Add(row);
            WidgetId.Pop();
            i = i + 1;
        }
        builtFirst = first;
        builtLast = last;
        rowsStale = false;
        for (int k = 0; k < children.Count; k = k + 1) {
            children[k].MeasureTree(app);
        }
    }

}
