using System;
using System.Collections.Generic;
using Gui;
using Gui.Backend;

namespace Gui.Widget;

// 为虚拟列表构建第 `index` 行的控件子树；数据由调用方的
// 闭包持有，行只在进入视口时才会被构建。
public delegate Control RowAt(int index);

// 保留模式等高虚拟列表。模板行是实际 children；布局维护可见区间，
// 路由输入直接修改共享滚动状态，绘制只读。行内状态应保存在数据模型中；
// 滚动时仍可见的行保留实例，离开视口的行释放输入状态并移除。
public class VirtualList : Control {

    private List<string> items;
    private int selected;
    private int rowH;
    private int activated;
    // 模板模式的行构建器；null = 字符串行模式。
    private RowAt rowAt;
    private int rowCount;
    // 模板行待重建标记；可见区间变化时也会重建。
    private bool rowsStale;
    private int builtFirst;
    private int builtLast;
    // 字符串行悬停提示的跟踪状态：正在计时的行号（-1 无）
    // 与指针进入该行的时刻。指针换行或离开即重置。
    private int tipIdx;
    private int tipSinceMs;
    // 视口矩形缓存，消除每帧 Render 中的堆分配
    private Rect viewportArea;
    private int layoutScrollY;

    // 空列表（字符串行模式，之后 SetItems/SetRows）。
    public VirtualList() {
        this.InitControl("virtualList", 5);

        this.items = new List<string>();
        this.selected = 0 - 1;
        this.rowH = 0;
        this.activated = 0 - 1;
        this.rowAt = null;
        this.rowCount = 0;
        this.rowsStale = true;
        this.builtFirst = 0 - 1;
        this.builtLast = 0 - 1;
        this.tipIdx = 0 - 1;
        this.tipSinceMs = 0;
        this.viewportArea = new Rect(0, 0, 0, 0);
    }

    // 控件类型标识（序列化/设计器用）。
    public override string Kind() { return "VirtualList"; }

    // 覆写：返回设计器属性清单（rowHeight）。
    public override List<PropSpec> Props() {
        List<PropSpec> ps = new List<PropSpec>();
        PropSpec rh = PropSpec.Int("rowHeight", "Row height");
        rh.num = rowH;
        rh.Step(1, 0, 1000);
        rh.WithTip("Fixed row height in logical pixels; zero uses the theme default.");
        ps.Add(rh);
        return ps;
    }

    // 覆写：默认 240x160 的逻辑尺寸（实际占宿主给的矩形）。
    public override void OnMeasure(App app) {
        prefW = app.Scale(240);
        prefH = app.Scale(160);
    }

    public override StyleBox ResolveStyle(App app, int state) {
        StyleBox box = base.ResolveStyle(app, state);
        if (box.overflowCss == 0 - 1) { box.overflowY = 2; box.overflow = 1; }
        return box;
    }

    public override void Arrange(int x, int y, int w, int h) {
        bx = x; by = y; bw = w > 0 ? w : 0; bh = h > 0 ? h : 0;
        App app = this.App;
        int rh = this.ResolveRowH(app);
        if (rh < 1) { rh = 1; }
        Rect view = this.ScrollViewport();
        scrollExtent = this.Count() * rh;
        scrollExtentX = view.width;
        int maximum = scrollExtent - view.height;
        if (maximum < 0) { maximum = 0; }
        if (scrollY > maximum) { scrollY = maximum; }
        if (scrollY < 0) { scrollY = 0; }
        viewportArea.Set(view.x, view.y, view.width, view.height);
        layoutScrollY = scrollY;
        int first = scrollY / rh;
        int last = first + view.height / rh + 2;
        if (last > this.Count()) { last = this.Count(); }
        if (rowAt != null && app != null) { this.BuildVisible(app, first, last); }
        bool hasBar = this.StyleOverflowY() == 3 || (this.StyleOverflowY() == 2 && scrollExtent > view.height);
        int reserve = app != null ? app.Scale(12) : 12;
        int rowW = view.width - (hasBar ? reserve : 0);
        if (rowW < 0) { rowW = 0; }
        for (int i = 0; i < children.Count; i = i + 1) {
            children[i].Arrange(view.x, view.y + (builtFirst + i) * rh - scrollY, rowW, rh);
        }
    }

    // Input may arrive several times before the next paint/layout pass.
    public override Control HitTest(int x, int y, int pointerType) {
        if (!this.StyleVisible() || !this.ContainsPoint(x, y, pointerType)) { return null; }
        this.Arrange(bx, by, bw, bh);
        return base.HitTest(x, y, pointerType);
    }

    public override void OnWheel(RoutedEventArgs e) {
        this.ScrollWheel(e);
        if (layoutScrollY != scrollY) { this.Arrange(bx, by, bw, bh); }
    }

    public override void CollectInputFocus(App app, List<Control> controls) {
        if (layoutScrollY != scrollY) { this.Arrange(bx, by, bw, bh); }
        base.CollectInputFocus(app, controls);
    }

    public override Control FindInputFocus(App app) {
        if (layoutScrollY != scrollY) { this.Arrange(bx, by, bw, bh); }
        return base.FindInputFocus(app);
    }

    // 绘制不重建模板、不布局子树，也不消费输入。
    public override void OnPaint(App app) { /* retained children paint in RenderTree */ }

    private void ReleaseRows(App app) {
        for (int i = 0; i < children.Count; i = i + 1) {
            if (app != null) { app.ReleaseInputSubtree(children[i]); }
        }
        this.RemoveAll();
    }

    // 整体替换字符串行数据（模板模式之外的最简用法）；
    // 行数变化后选中行号自动夹回范围内。
    public void SetItems(List<string> rows) {
        this.ReleaseRows(this.App);
        items = rows;
        rowAt = null;
        rowCount = 0;
        if (selected >= rows.Count) { selected = rows.Count - 1; }
    }

    // 追加一行字符串数据。
    public void Add(string row) {
        items.Add(row);
    }

    // UI-thread data update. Replacing a builder/count immediately retires
    // old editors so queued input cannot continue into detached data.
    public void SetRows(int count, RowAt build) {
        if (count < 0) { count = 0; }
        if (build != rowAt || count != rowCount) {
            this.ReleaseRows(this.App);
            rowAt = build;
            rowCount = count;
            rowsStale = true;
            if (selected >= rowCount) { selected = rowCount - 1; }
        }
    }

    // UI-thread refresh; obsolete editors lose focus/capture immediately.
    public void Refresh() {
        this.ReleaseRows(this.App);
        rowsStale = true;
    }

    // 固定行高（逻辑 px）；0 = 用主题的 heightLarge。
    public void SetRowHeight(int h) {
        rowH = h;
    }

    // 当前行数：模板模式返回 SetRows 给的 count，
    // 字符串模式返回 items 数。
    public int Count() {
        if (rowAt != null) { return rowCount; }
        return items.Count;
    }

    // 当前选中行号（无选中为 -1）。
    public int Selected() {
        return selected;
    }

    // 选中行的文本；模板模式无文本概念，恒返回 ""。
    public string SelectedText() {
        if (rowAt != null) { return ""; }
        if (selected < 0 || selected >= items.Count) { return ""; }
        return items[selected];
    }

    // 本帧点击的行（或 -1），随后清除。
    public int TakeActivated() {
        int r = activated;
        activated = 0 - 1;
        return r;
    }

    // 实际使用的行高：显式 SetRowHeight 优先，否则主题值。
    public int ResolveRowH() { return this.ResolveRowH(this.App); }
    public int ResolveRowH(App app) {
        app = this.ResolveApp(app);
        if (rowH > 0) { return app != null ? app.Scale(rowH) : rowH; }
        return app != null ? app.theme.heightLarge : 32;
    }

    // Keep the overlap alive: scrolling one row must not destroy an editor
    // still visible on screen, or steal its focus/capture.
    private void BuildVisible(App app, int first, int last) {
        if (!rowsStale && first == builtFirst && last == builtLast) { return; }
        List<Control> previous = children;
        int oldFirst = builtFirst;
        int oldLast = builtLast;
        List<Control> next = new List<Control>();
        for (int i = first; i < last; i = i + 1) {
            Control row = null;
            if (!rowsStale && i >= oldFirst && i < oldLast) {
                row = previous[i - oldFirst];
            } else {
                row = rowAt(i);
                if (row == null) { row = Panel.Root("vrow"); }
                this.Add(row);
                row.MeasureTree(app);
            }
            next.Add(row);
        }
        for (int i = previous.Count - 1; i >= 0; i = i - 1) {
            Control row = previous[i];
            if (!next.Contains(row)) {
                app.ReleaseInputSubtree(row);
                this.Remove(row);
            }
        }
        children = next;
        builtFirst = first;
        builtLast = last;
        rowsStale = false;
    }
}
