using System;
using System.Collections.Generic;
using Gui;
using Gui.Backend;
namespace Gui.Widget;
public delegate Control RowAt(int index);
public class VirtualList : Control {
    public override Control CreateCloneShell() { return new VirtualList(); }
    private List<string> items;
    private int selected;
    private int rowH;
    [Event]
    public UiEvent Select;
    [Event]
    public UiEvent Activate;
    private RowAt rowAt;
    private int rowCount;
    private bool rowsStale;
    private int builtFirst;
    private int builtLast;
    private VisibleRowHost rowHost;
    private bool arrangingRows;
    private Rect viewportArea;
    private int layoutScrollY;
    public VirtualList() {
        this.InitControl("virtualList");
        this.rowHost = new VisibleRowHost(this, this);
        this.items = new List<string>();
        this.selected = 0 - 1;
        this.rowH = 0;
        Select = new UiEvent();
        Activate = new UiEvent();
        this.rowAt = null;
        this.rowCount = 0;
        this.rowsStale = true;
        this.builtFirst = 0 - 1;
        this.builtLast = 0 - 1;
        this.viewportArea = new Rect(0, 0, 0, 0);
    }
    // 覆写：返回设计器属性清单（rowHeight）。
    protected override List<PropSpec> DefineProps() {
        List<PropSpec> ps = new List<PropSpec>();
        ps.Add(PropSpec.Int("rowHeight", "Row height")
            .Field("rowH")
            .Step(1, 0, 1000)
            .WithTip("Fixed row height in logical pixels; zero uses the theme default."));
        return ps;
    }
    public override void OnMeasure(App app) {
        prefW = app.Scale(240);
        prefH = app.Scale(160);
    }
    public override StyleBox ResolveStyle(App app, int state) {
        StyleBox box = base.ResolveStyle(app, state);
        if (box.overflowCss == 0 - 1) { box.overflowY = 2; box.overflow = 1; }
        return box;
    }
    public override void Arrange(int x, int y, int w, int h) {
        bx = x; by = y; bw = w > 0 ? w : 0; bh = h > 0 ? h : 0;
        if (arrangingRows) { return; }
        arrangingRows = true;
        try {
        App app = this.App;
        int rh = this.ResolveRowH(app);
        if (rh < 1) { rh = 1; }
        Rect view = this.ScrollViewport();
        scrollExtent = this.Count() * rh;
        scrollExtentX = view.width;
        int maximum = scrollExtent - view.height;
        if (maximum < 0) { maximum = 0; }
        if (scrollY > maximum) { scrollY = maximum; }
        if (scrollY < 0) { scrollY = 0; }
        viewportArea.Set(view.x, view.y, view.width, view.height);
        layoutScrollY = scrollY;
        int first = scrollY / rh;
        int last = first + view.height / rh + 2;
        if (last > this.Count()) { last = this.Count(); }
        if (app != null && !this.BuildVisible(app, first, last)) { return; }
        int ticket = rowHost.Revision();
        bool hasBar = this.StyleOverflowY() == 3 || (this.StyleOverflowY() == 2 && scrollExtent > view.height);
        int reserve = app != null ? app.Scale(12) : 12;
        int rowW = view.width - (hasBar ? reserve : 0);
        if (rowW < 0) { rowW = 0; }
        for (int i = first; i < last; i = i + 1) {
            Control row = rowHost.Row(i);
            if (row != null) { row.Arrange(view.x, view.y + i * rh - scrollY, rowW, rh); }
            if (ticket != rowHost.Revision()) { return; }
        }
        } finally { arrangingRows = false; }
    }
    protected override Control HitTestCore(int x, int y, int pointerType, List<Control> excludedSubtrees) {
        if (!this.StyleVisible() || !this.ContainsPoint(x, y, pointerType)) { return null; }
        this.Arrange(bx, by, bw, bh);
        return base.HitTestCore(x, y, pointerType, excludedSubtrees);
    }
    public override void OnWheel(RoutedEventArgs e) {
        this.ScrollWheel(e);
        if (layoutScrollY != scrollY) { this.Arrange(bx, by, bw, bh); }
    }
    public override void CollectInputFocus(App app, List<Control> controls) {
        if (layoutScrollY != scrollY) { this.Arrange(bx, by, bw, bh); }
        base.CollectInputFocus(app, controls);
    }
    public override Control FindInputFocus(App app) {
        if (layoutScrollY != scrollY) { this.Arrange(bx, by, bw, bh); }
        return base.FindInputFocus(app);
    }
    public override void OnPaint(App app) { /* retained children paint in RenderTree */ }
    private void ReleaseRows(App app) {
        rowsStale = true;
        rowHost.Reset();
    }
    public void SetItems(List<string> rows) {
        items = rows != null ? rows : new List<string>();
        rowAt = null;
        rowCount = 0;
        if (selected >= items.Count) { selected = items.Count - 1; }
        this.ReleaseRows(this.App);
    }
    public void Add(string row) { items.Add(row); }
    public void SetRows(int count, RowAt build) {
        if (count < 0) { count = 0; }
        if (build != rowAt || count != rowCount) {
            rowAt = build;
            rowCount = count;
            rowsStale = true;
            if (selected >= rowCount) { selected = rowCount - 1; }
            this.ReleaseRows(this.App);
        }
    }
    public void Refresh() {
        this.ReleaseRows(this.App);
        rowsStale = true;
    }
    public void SetRowHeight(int h) { rowH = h; }
    public int Count() {
        if (rowAt != null) { return rowCount; }
        return items.Count;
    }
    public int Selected() { return selected; }
    public string SelectedText() {
        if (rowAt != null) { return ""; }
        if (selected < 0 || selected >= items.Count) { return ""; }
        return items[selected];
    }
    internal void SelectStringRow(Control row, int index) {
        if (rowAt != null || index < 0 || index >= items.Count || rowHost.Row(index) != row) { return; }
        App app = this.FindApp();
        Control root = app != null ? app.rootControl : null;
        int generation = app != null ? app.inputRootGeneration : 0;
        bool changed = selected != index;
        selected = index;
        this.SyncStringRows();
        if (changed) { Select.Raise(this); }
        if (rowAt != null || selected != index || rowHost.Row(index) != row
            || (app != null && (!app.isRunning || app.rootControl != root
                || app.inputRootGeneration != generation || this.FindApp() != app))) { return; }
        Activate.Raise(this);
    }
    private void SyncStringRows() {
        if (rowAt != null) { return; }
        for (int i = builtFirst; i < builtLast; i = i + 1) {
            Control control = rowHost.Row(i);
            if (control is Button && i >= 0 && i < items.Count) {
                Button button = (Button)control;
                if (button.Label() != items[i]) { button.SetText(items[i]); }
                if (i == selected) { button.AddClass("selected"); }
                else if (button.HasClass("selected")) { button.RemoveClass("selected"); }
            }
        }
    }
    public int ResolveRowH() { return this.ResolveRowH(this.App); }
    public int ResolveRowH(App app) {
        app = this.ResolveApp(app);
        if (rowH > 0) { return app != null ? app.Scale(rowH) : rowH; }
        return app != null ? app.theme.heightLarge : 32;
    }
    private Control CreateRow(int index) {
        RowAt build = rowAt;
        if (build == null) { return new VirtualListStringRow(this, index, items[index]); }
        Control row = build(index);
        return row != null ? row : Panel.Root("vrow");
    }
    private bool BuildVisible(App app, int first, int last) {
        if (!rowsStale && first == builtFirst && last == builtLast
            && this.ChildCount() == rowHost.Count()) {
            bool complete = true;
            for (int i = first; i < last; i = i + 1) {
                if (rowHost.Row(i) == null) { complete = false; break; }
            }
            if (complete) { this.SyncStringRows(); return true; }
        }
        List<int> wanted = new List<int>();
        for (int i = first; i < last; i = i + 1) { wanted.Add(i); }
        if (!rowHost.Reconcile(wanted, this.CreateRow, app)) { return false; }
        builtFirst = first;
        builtLast = last;
        rowsStale = false;
        this.SyncStringRows();
        return true;
    }
}
