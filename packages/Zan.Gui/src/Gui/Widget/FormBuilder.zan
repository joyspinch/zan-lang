using System;
using Gui;

namespace Gui.Widget;

// 统一的设计文档 -> 真控件树构建器。设计器预览与运行时窗口
// 共用这一套：把设计文档（Designer.SaveJson / formgen 消费的同一 JSON）
// 实例化为真正的 Control 树，按 24 列流式或自由画布布局排布。
// 设计器把它渲染在编辑外框内并叠加选中/handle 覆盖层；运行时把
// 同一棵树放进 Form。因此“所见即所得”天然成立，自定义组件也走
// 同一条实例化路径（HeavyControls 注册工厂 / 注入工厂）。
public class FormBuilder {
    // 每个窗口/离屏 App 在测量前安装文档 CSS。
    // 替换应用层而非合并，避免宿主的同名类进入设计稿。
    public static string ApplyStyles(App app, JsonValue root) {
        string previous = app.appCss;
        string css = root == null ? "" : root.Str("docCss", "");
        if (previous != css) { app.UseAppCss(css); }
        return previous;
    }

    // 窗口形状与外观共用配置；屏幕位置由真实窗口入口单独处理。
    public static void ConfigureWindow(App app, JsonValue root) {
        if (root == null) { return; }
        int width = root.Int("winW", 480);
        int height = root.Int("winH", 520);
        if (width <= 0) { width = 480; }
        if (height <= 0) { height = 520; }
        int shape = root.Int("winShape", 0);
        int radius = root.Int("winShapeRadius", 0);
        if (shape == WindowShapeKind.RoundedRect && radius <= 0) { radius = 12; }
        bool round = root.Bool("winRound", false);
        int shadow = 0;
        JsonValue shadowValue = root.Get("winShadow");
        if (shadowValue != null && shadowValue.IsNumber()) {
            shadow = shadowValue.AsInt(0);
        } else if (shape != 0 || round) {
            shadow = 10;
        }

        WindowShapeDescription shapeDesc = new WindowShapeDescription();
        JsonValue regions = root.Get("winShape");
        if (regions != null && regions.IsArray()) {
            for (int i = 0; i < regions.Count(); i = i + 1) {
                JsonValue region = regions.At(i);
                if (region == null) { continue; }
                int rw = region.Int("w", 0);
                int rh = region.Int("h", 0);
                if (rw <= 0 || rh <= 0) { continue; }
                shapeDesc.AddRegion(
                    region.Int("t", WindowShapeKind.RoundedRect),
                    region.Int("x", 0),
                    region.Int("y", 0),
                    rw,
                    rh,
                    region.Int("r", 0)
                );
            }
        } else if (shape == WindowShapeKind.RoundedRect) {
            shapeDesc = WindowShapeDescription.FromRoundedRect(width, height, radius);
        } else if (shape == WindowShapeKind.Ellipse || round) {
            shapeDesc = WindowShapeDescription.FromEllipse(width, height);
        }

        app.SetWindowShape(shapeDesc);
        if (shadow > 0) {
            app.SetWindowShadow(shadow);
        }
        app.SetChromeVisible(root.Bool("winChrome", true));
        bool resizable = root.Bool("winResizable", true);
        app.SetResizable(resizable);
        app.SetChromeButtons(app.showThemeButton, app.showPinButton,
            app.showMinimizeButton, resizable);
        app.SetToolWindow(root.Bool("winTool", false));
        app.SetNativeGlass(root.Bool("winGlass", false));
        app.SetWindowOpacity(root.Int("winOpacity", 100));
    }

    public static string DefaultSizeClass(JsonValue root) {
        int size = root.Int("formSize", 1);
        if (size == 0) { return "large"; }
        if (size == 2) { return "small"; }
        return "";
    }

    public static bool HasSizeClass(string classes) {
        List<string> xs = classes.Split(" ");
        for (int i = 0; i < xs.Count; i = i + 1) {
            string x = xs[i].Trim();
            if (x == "tiny" || x == "small" || x == "medium" || x == "large") {
                return true;
            }
        }
        return false;
    }

    public static bool IsElement(JsonValue o) {
        return o.Str("htmlTag", "") != "" || FormBuilder.Kind(o) == "Element";
    }


    // 字段的规范 kind：设计文档 `kind` 键优先，旧文档回退 LegacyKind(type)。
    public static string Kind(JsonValue o) {
        string k = o.Str("kind", "");
        if (k == "") { k = FormBuilder.LegacyKind(o.Int("type", -1)); }
        if (k == "Table" || k == "DataTable") { return "DataGrid"; }
        if (k == "Scrollbar" || k == "Layer") { return "Panel"; }
        if (k == "Chart") { return "ChartHost"; }
        if (k == "Ellipsis") { return "Label"; }
        if (k == "Ribbon") { return "ToolStrip"; }
        if (k == "Alert") { return "AlertBox"; }
        return k;
    }

    public static string LegacyKind(int t) {
        if (t == 0) { return "Input"; }
        if (t == 1) { return "TextArea"; }
        if (t == 4) { return "Radio"; }
        if (t == 5) { return "Checkbox"; }
        if (t == 6) { return "SelectBox"; }
        if (t == 7) { return "Switch"; }
        if (t == 8) { return "Rate"; }
        if (t == 9) { return "Slider"; }
        if (t == 18 || t == 45) { return "Panel"; }
        if (t == 29) { return "Progress"; }
        if (t == 36) { return "Tabs"; }
        if (t == 37) { return "Pagination"; }
        if (t == 49) { return "FloatButton"; }
        if (t == 58) { return "ToolStrip"; }
        if (t == 59) { return "StatusBar"; }
        if (t == 60) { return "SplitPanel"; }
        return "";
    }

    // 控件是否自带 `label` 属性（Checkbox / Radio 那样把标题画在框
    // 旁边）。自带的交给控件，不自带的由表单在它上面补一行标题。
    public static bool OwnsLabel(Control ctl) {
        if (ctl == null) { return false; }
        List<PropSpec> ps = ctl.Props();
        if (ps == null) { return false; }
        for (int i = 0; i < ps.Count; i = i + 1) {
            if (ps[i].key == "label") { return true; }
        }
        return false;
    }

    // span 钳制到 [1,24]。
    public static int ClampSpan(int s) {
        if (s < 1) { return 1; }
        if (s > 24) { return 24; }
        return s;
    }

    // 第 i 个选项文本（缺失 / 非字符串回退 def）。
    public static string OptAt(JsonValue o, int i, string def) {
        JsonValue opts = o.Get("options");
        if (opts == null || !opts.IsArray() || i >= opts.Count()) { return def; }
        JsonValue it = opts.At(i);
        if (it == null || !it.IsString()) { return def; }
        return it.AsString(def);
    }

    // 第 i 个选项解析为整数（缺失 / 非数字回退 def）。
    public static int OptInt(JsonValue o, int i, int def) {
        string s = FormBuilder.OptAt(o, i, "");
        if (s == "" || !FormBuilder.IsNumber(s)) { return def; }
        return Convert.ToInt32(s);
    }

    // 是否为（可选负号前缀的）纯整数字符串。
    public static bool IsNumber(string s) {
        if (s == null || s == "") { return false; }
        int i = 0;
        if (s.StartsWith("-")) { i = 1; }
        if (i >= s.Length) { return false; }
        while (i < s.Length) {
            int c = s[i] & 255;
            if (c < 48 || c > 57) { return false; }
            i = i + 1;
        }
        return true;
    }

    // options 数组 → "a|b|c" 文本（空数组返回 ""）。
    public static string JoinOpts(JsonValue o) {
        JsonValue opts = o.Get("options");
        if (opts == null) { return ""; }
        if (opts.IsString()) { return opts.AsString(""); }
        if (!opts.IsArray() || opts.Count() == 0) { return ""; }
        StringBuilder sb = new StringBuilder();
        for (int i = 0; i < opts.Count(); i = i + 1) {
            if (i > 0) { sb.Append("|"); }
            sb.Append(opts.At(i).AsString(""));
        }
        return sb.ToString();
    }


    public static Control MakeControl(JsonValue o, bool free) {
        Control ctl = FormBuilder.CreateControl(o);
        if (ctl != null) { FormBuilder.SetupControl(ctl, o, "", false); }
        return ctl;
    }

    public static Control CreateControl(JsonValue o) {
        if (FormBuilder.IsElement(o)) {
            Element el = new Element();
            return el;
        }
        string kind = FormBuilder.Kind(o);
        if (kind == "") { return null; }
        ControlBootstrap.Install();
        return ControlFactory.Create(kind);
    }

    public static bool IsEventKey(string key) {
        return key.Length > 2 && key.StartsWith("on")
            && key[2] >= 65 && key[2] <= 90;
    }

    public static bool IsModelKey(string key) {
        return key == "kind" || key == "type" || key == "name"
            || key == "tag" || key == "htmlTag" || key == "htmlContent"
            || key == "class" || key == "style" || key == "props"
            || key == "kids" || key == "dock" || key == "dockSide"
            || key == "fx" || key == "fy" || key == "fw" || key == "fh"
            || key == "position" || key == "anchor" || key == "flexGrow" || key == "flex-grow"
            || key == "span" || key == "childTab" || key == "ph"
            || key == "pad" || key == "gap" || key == "bind"
            || key == "bindProp" || key == "if" || key == "for"
            || key == "columns" || key == "of" || key == "options"
            || key == "label" || key == "ref" || key == "compAbs"
            || key == "compAnon" || key == "arg" || key == "rowFactory"
            || key == "locked" || key == "pvOff" || key == "activeTab"
            || key == "zModel" || key == "zShow" || key == "zHide" || key == "zText"
            || key == "bindPath" || key == "bindIf"
            || key == "margin" || key == "padding"
            || key == "flexDir" || key == "flexDirection" || key == "flex-direction"
            || key == "justify" || key == "justifyContent" || key == "justify-content"
            || key == "alignItems" || key == "align-items"
            || key == "alignContent" || key == "align-content"
            || key == "alignSelf" || key == "align-self"
            || key == "flexWrap" || key == "flex-wrap"
            || key == "flexShrink" || key == "flex-shrink"
            || key == "flexBasis" || key == "flex-basis"
            || key == "winShape" || key == "winShapeRadius" || key == "winRound" || key == "winShadow";
    }

    public static string ScalarText(JsonValue value) {
        if (value.IsString()) { return value.AsString(""); }
        if (value.IsBool()) { return value.AsBool(false) ? "true" : "false"; }
        if (value.IsNumber()) { return value.ToJson(); }
        return "";
    }

    // 编辑元数据只有真实绑定属性接受，避免 SetProp 未知键制造类。
    public static bool AcceptScalar(Control ctl, string key) {
        if (key == "locked" || key == "pvOff") { return false; }
        if (key == "activeTab") { return ctl is Tabs && ctl.PropOf(key) != null; }
        if (key == "alt" || key == "defOn" || key == "required") {
            return ctl is Element || ctl.PropOf(key) != null;
        }
        return true;
    }

    // 工厂实例与生成的 typed new 只在构造上不同，所有声明在此消费。
    public static void SetupControl(Control ctl, JsonValue o, string sizeClass, bool anon) {
        if (ctl is Element) {
            Element el = (Element)ctl;
            string tag = o.Str("htmlTag", o.Str("tag", "div"));
            if (tag == "") { tag = "div"; }
            el.InitElement(tag, o.Str("name", ""));
            JsonValue content = o.Get("htmlContent");
            if (content == null || !content.IsArray()) { el.SetText(o.Str("text", "")); }
            string loop = o.Str("for", "");
            if (loop != "") { el.SetAttr("data-for", loop); }
        }
        string cls = o.Str("class", "");
        if (!(ctl is Element) && sizeClass != "" && !FormBuilder.HasSizeClass(cls)) {
            cls = cls == "" ? sizeClass : cls + " " + sizeClass;
        }
        ctl.Class = cls;
        ctl.name = o.Str("name", "");
        string cap = o.Str("label", "");
        if (cap != "") { ctl.SetDesignText(cap); }
        JsonValue props = o.Get("props");
        if (props != null && props.IsObject()) {
            for (int i = 0; i < props.Count(); i = i + 1) {
                JsonValue value = props.ValAt(i);
                string key = props.KeyAt(i);
                if (value == null || !FormBuilder.AcceptScalar(ctl, key)) { continue; }
                if (!value.IsString() && !value.IsBool() && !value.IsNumber()) { continue; }
                ctl.SetProp(key, FormBuilder.ScalarText(value));
            }
        }
        for (int i = 0; i < o.Count(); i = i + 1) {
            string key = o.KeyAt(i);
            JsonValue value = o.ValAt(i);
            if (value == null || (FormBuilder.IsModelKey(key) && key != "activeTab")
                || !FormBuilder.AcceptScalar(ctl, key)) { continue; }
            if (FormBuilder.IsEventKey(key)) {
                if (!anon && value.IsString()) {
                    ctl.SetHandler(key.Substring(2), value.AsString(""));
                }
                continue;
            }
            if (!value.IsString() && !value.IsBool() && !value.IsNumber()) { continue; }
            if (key == "text" && ctl is Element) { continue; }
            string text = FormBuilder.ScalarText(value);
            if (ctl is Element) {
                Element el = (Element)ctl;
                el.SetAttr(key, text);
                if (key == "title") { el.elTitle = text; }
            } else {
                ctl.SetProp(key, text);
            }
        }
        string options = FormBuilder.JoinOpts(o);
        if (options != "") { ctl.SetProp("options", options); }
        JsonValue columns = o.Get("columns");
        if (columns != null && columns.IsNumber()) {
            ctl.SetProp("columns", FormBuilder.ScalarText(columns));
        } else if (columns != null && columns.IsArray()) {
            ctl.SetProp("columns", columns.ToJson());
        }
        if (o.Has("of")) {
            ctl.SetProp("of", o.Str("of", ""));
        }
        if (o.Has("rowFactory")) {
            ctl.SetProp("rowFactory", FormBuilder.ScalarText(o.Get("rowFactory")));
        }
        ctl.name = o.Str("name", "");
        string bind = o.Str("bind", o.Str("zModel", o.Str("bindPath", "")));
        string bindProp = o.Str("bindProp", "");
        if (bind == "" && o.Has("zText")) {
            bind = o.Str("zText", "");
            if (bindProp == "") { bindProp = "text"; }
        }
        ctl.bindPath = bind;
        if (bindProp != "") { ctl.bindProp = bindProp; }
        string bif = o.Str("if", o.Str("zShow", o.Str("bindIf", "")));
        if (bif == "" && o.Has("zHide")) {
            string zh = o.Str("zHide", "");
            if (zh != "") { bif = "!" + zh; }
        }
        ctl.bindIf = bif;
        ctl.handlerArg = anon ? "" : o.Str("arg", "");
        string style = o.Str("style", "");
        // Flexbox 布局属性标准化解析（解耦伪排版，双轨对齐 HTML+CSS）
        if (o.Has("flexGrow") || o.Has("flex-grow")) {
            int fg = o.Int("flexGrow", o.Int("flex-grow", 0));
            style = style + ";flex-grow:" + Convert.ToString(fg);
        }
        if (o.Has("margin")) {
            JsonValue mv = o.Get("margin");
            if (mv != null && mv.IsNumber()) {
                style = style + ";margin:" + Convert.ToString(mv.AsInt(0)) + "px";
            } else if (mv != null && mv.IsString()) {
                string ms = mv.AsString("");
                style = style + ";margin:" + (ms.EndsWith("px") || ms.EndsWith("%") ? ms : ms + "px");
            }
        }
        if (o.Has("padding") || o.Has("pad")) {
            JsonValue pv = o.Get("padding");
            if (pv == null) { pv = o.Get("pad"); }
            if (pv != null && pv.IsNumber()) {
                style = style + ";padding:" + Convert.ToString(pv.AsInt(0)) + "px";
            } else if (pv != null && pv.IsString()) {
                string ps = pv.AsString("");
                style = style + ";padding:" + (ps.EndsWith("px") || ps.EndsWith("%") ? ps : ps + "px");
            }
        }
        if (o.Has("gap")) {
            JsonValue gv = o.Get("gap");
            if (gv != null && gv.IsNumber()) {
                style = style + ";gap:" + Convert.ToString(gv.AsInt(0)) + "px";
            } else if (gv != null && gv.IsString()) {
                string gs = gv.AsString("");
                style = style + ";gap:" + (gs.EndsWith("px") || gs.EndsWith("%") ? gs : gs + "px");
            }
        }
        if (o.Has("flexDir") || o.Has("flexDirection") || o.Has("flex-direction")) {
            style = style + ";display:flex";
            string dirStr = o.Str("flexDirection", o.Str("flex-direction", ""));
            if (dirStr != "") {
                style = style + ";flex-direction:" + dirStr;
            } else {
                int fd = o.Int("flexDir", 0);
                if (fd == 1) { style = style + ";flex-direction:row"; }
                else if (fd == 2) { style = style + ";flex-direction:row-reverse"; }
                else if (fd == 3) { style = style + ";flex-direction:column-reverse"; }
                else { style = style + ";flex-direction:column"; }
            }
        }
        if (o.Has("justify") || o.Has("justifyContent") || o.Has("justify-content")) {
            string jStr = o.Str("justifyContent", o.Str("justify-content", ""));
            if (jStr != "") {
                style = style + ";justify-content:" + jStr;
            } else {
                int ju = o.Int("justify", 0);
                if (ju == 1) { style = style + ";justify-content:center"; }
                else if (ju == 2) { style = style + ";justify-content:flex-end"; }
                else if (ju == 3) { style = style + ";justify-content:space-between"; }
                else if (ju == 4) { style = style + ";justify-content:space-around"; }
                else if (ju == 5) { style = style + ";justify-content:space-evenly"; }
                else { style = style + ";justify-content:flex-start"; }
            }
        }
        if (o.Has("alignItems") || o.Has("align-items")) {
            string aStr = o.Str("alignItems", o.Str("align-items", ""));
            if (aStr != "") {
                if (aStr == "0" || aStr == "1" || aStr == "2" || aStr == "3" || aStr == "4") {
                    int aiNum = Convert.ToInt32(aStr);
                    if (aiNum == 1) { style = style + ";align-items:center"; }
                    else if (aiNum == 2) { style = style + ";align-items:flex-end"; }
                    else if (aiNum == 3) { style = style + ";align-items:stretch"; }
                    else if (aiNum == 4) { style = style + ";align-items:baseline"; }
                    else { style = style + ";align-items:flex-start"; }
                } else {
                    style = style + ";align-items:" + aStr;
                }
            } else {
                int ai = o.Int("alignItems", 0);
                if (ai == 1) { style = style + ";align-items:center"; }
                else if (ai == 2) { style = style + ";align-items:flex-end"; }
                else if (ai == 3) { style = style + ";align-items:stretch"; }
                else if (ai == 4) { style = style + ";align-items:baseline"; }
                else { style = style + ";align-items:flex-start"; }
            }
        }
        if (o.Has("flexWrap") || o.Has("flex-wrap")) {
            string wStr = o.Str("flex-wrap", "");
            if (wStr != "") {
                style = style + ";flex-wrap:" + wStr;
            } else if (o.Bool("flexWrap", false) || o.Int("flexWrap", 0) == 1) {
                style = style + ";flex-wrap:wrap";
            }
        }
        if (style != "") { ctl.SetProp("style", style); }
        if (o.Has("padding")) { ctl.Pad(o.Int("padding", 0)); }
        else if (o.Has("pad")) { ctl.Pad(o.Int("pad", 0)); }
        if (o.Has("gap")) { ctl.gap = o.Int("gap", 0); }
    }

    // DataGrid 的 columns 对象数组压成列头预览串（"宽,标题|…"）。
    // 运行时建树拿不到 "of" 的实体类型，预览只铺列头；类型化取值
    // 由挂载时的绑定通道解析。
    public static string GridColumnsSpec(JsonValue o) {
        JsonValue cols = o.Get("columns");
        if (cols == null || !cols.IsArray()) { return ""; }
        string spec = "";
        for (int i = 0; i < cols.Count(); i = i + 1) {
            JsonValue c = cols.At(i);
            if (c == null || !c.IsObject()) { continue; }
            string title = c.Str("title", "");
            if (title == "") { title = c.Str("field", ""); }
            if (title == "") { continue; }
            if (spec != "") { spec = spec + "|"; }
            spec = spec + Convert.ToString(c.Int("width", 100)) + "," + title;
        }
        return spec;
    }



    // 从设计器的 FormField 构建单个叶子控件（不含标题标签——标题由
    // 设计器/表单布局单独绘制）。设计器预览用它渲染真控件，与运行时的
    // MakeControl 走同一条构造路径，从根上消除“所见非所得”。
    public static Control FromField(FormField f) {
        JsonValue o = JsonValue.NewObject();
        o.Put("label", JsonValue.NewStr(f.label));
        o.Put("name", JsonValue.NewStr(f.fname));
        o.Put("placeholder", JsonValue.NewStr(f.placeholder));
        o.Put("kind", JsonValue.NewStr(f.KindName()));
        o.Put("class", JsonValue.NewStr(f.Class));
        o.Put("style", JsonValue.NewStr(f.styleText));
        if (f.defOn) { o.Put("defOn", JsonValue.NewBool(true)); }
        if (f.wrap) { o.Put("wrap", JsonValue.NewBool(true)); }
        if (f.OptionCount() > 0) {
            JsonValue arr = JsonValue.NewArray();
            for (int i = 0; i < f.OptionCount(); i = i + 1) {
                arr.Append(JsonValue.NewStr(f.OptionAt(i)));
            }
            o.Put("options", arr);
        }
        if (f.extra != null && f.extra.IsObject()) {
            for (int i = 0; i < f.extra.Count(); i = i + 1) {
                string k = f.extra.KeyAt(i);
                if (!o.Has(k)) { o.Put(k, f.extra.ValAt(i)); }
            }
        }
        Control ctl = FormBuilder.MakeControl(o, false);
        if (ctl == null) { return null; }
        ctl.name = f.fname;
        if (f.extra != null) {
            JsonValue props = f.extra.Get("props");
            if (props != null && props.IsObject()) {
                for (int i = 0; i < props.Count(); i = i + 1) {
                    ctl.SetProp(props.KeyAt(i), props.ValAt(i).AsString(""));
                }
            }
        }
        return ctl;
    }

    // data-kind 已废除：kind 别名归一并入 Html.TagToKind 标签映射表。
}

