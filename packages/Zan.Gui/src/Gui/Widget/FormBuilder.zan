using System;
using Gui;
using Gui.Hmi;

namespace Gui.Widget;

// 统一的设计文档 -> 真控件树构建器。设计器预览与运行时窗口
// 共用这一套：把设计文档（Designer.SaveJson / formgen 消费的同一 JSON）
// 实例化为真正的 Control 树，按 24 列流式或自由画布布局排布。

// 设计器把它渲染在编辑外框内并叠加选中/handle 覆盖层；运行时把
// 同一棵树放进 Form。因此“所见即所得”天然成立，自定义组件也走
// 同一条实例化路径（HeavyControls 注册工厂 / 注入工厂）。

    // GUI 控件排版布局与事件分发契约。
    // 核心契约与语义定义。
class FormBuilder {
    // fields/kids 的文档序深度优先；混排的显示次序不改变预建槽序。
    static Control Build(JsonValue root) {
        return FormBuilder.BuildWith(root, null);
    }

    static Control BuildWith(JsonValue root, List<Control> prepared) {
        Control host;
        if (FormBuilder.IsHtmlRoot(root)) {
            Element body = new Element();
            body.InitElement("body", "root");
            host = body;
        } else {
            host = Panel.Root("root");
        }
        FormBuilder.BuildInto(host, root, prepared);
        return host;
    }

    // HTML 文档保留真实 body 根；可嵌入 partial Control 作为其外层宿主。
    static void BuildInto(Control host, JsonValue root, List<Control> prepared) {
        if (!(host is Element) && FormBuilder.IsHtmlRoot(root)) {
            host.Dock(Dock.Fill());
            FormBuilder.AddChild(host, FormBuilder.BuildWith(root, prepared));
            return;
        }
        FormBuilder.SetupRoot(host, root);
        if (root == null) { return; }
        JsonValue arr = root.Get("fields");
        if (arr == null || !arr.IsArray()) { return; }
        FbBuildContext ctx = new FbBuildContext();
        ctx.prepared = prepared;
        if (prepared != null) { FormBuilder.CollectNodes(arr, ctx.originalNodes); }
        string expansionError = FormBuilder.ExpandRefs(arr, 0);
        if (expansionError != "") { throw new Exception(expansionError); }
        ctx.sizeClass = FormBuilder.DefaultSizeClass(root);
        bool free = root.Int("layoutMode", 0) == 1;
        FormBuilder.BuildArray(host, arr, root.Get("bodyContent"), free,
            FormBuilder.IsHtmlRoot(root), false, ctx);
    }

    static bool IsHtmlRoot(JsonValue root) {
        return root != null && (root.Has("docCss") || root.Has("bodyClass")
            || root.Has("bodyStyle") || root.Has("bodyContent"));
    }

    // 不钉死 padding/gap：根和所有子节点都消费同一皮肤/CSS。
    static void SetupRoot(Control host, JsonValue root) {
        host.Dock(Dock.Fill());
        if (root == null) { return; }
        if (root.Int("layoutMode", 0) != 1 && !FormBuilder.IsHtmlRoot(root)) {
            host.AddClass("designroot");
        }
        host.designCss = root.Str("docCss", "");
        string cls = root.Str("bodyClass", "");
        if (cls != "") { host.AddClass(cls); }
        string sty = root.Str("bodyStyle", "");
        if (sty != "") { host.SetProp("style", sty); }
    }

    // 每个窗口/离屏 App 在测量前安装文档 CSS。
    // 替换应用层而非合并，避免宿主的同名类进入设计稿。
    static string ApplyStyles(App app, JsonValue root) {
        string previous = app.appCss;
        string css = root == null ? "" : root.Str("docCss", "");
        if (previous != css) { app.UseAppCss(css); }
        return previous;
    }

    // 窗口形状与外观共用配置；屏幕位置由真实窗口入口单独处理。
    static void ConfigureWindow(App app, JsonValue root) {
        if (root == null) { return; }
        int width = root.Int("winW", 480);
        int height = root.Int("winH", 520);
        if (width <= 0) { width = 480; }
        if (height <= 0) { height = 520; }
        int shape = root.Int("winShape", 0);
        int radius = root.Int("winShapeRadius", 0);
        if (shape == 1 && radius <= 0) { radius = 12; }
        bool round = root.Bool("winRound", false);
        int shadow = 0;
        JsonValue shadowValue = root.Get("winShadow");
        if (shadowValue != null && shadowValue.IsNumber()) {
            shadow = shadowValue.AsInt(0);
        } else if (shape != 0 || round) {
            shadow = 10;
        }
        string spec = "";
        JsonValue regions = root.Get("winShape");
        if (regions != null && regions.IsArray()) {
            for (int i = 0; i < regions.Count(); i = i + 1) {
                JsonValue region = regions.At(i);
                int rw = region.Int("w", 0);
                int rh = region.Int("h", 0);
                if (rw <= 0 || rh <= 0) { continue; }
                if (spec != "") { spec = spec + ";"; }
                spec = spec + Convert.ToString(region.Int("t", 1)) + ","
                    + Convert.ToString(region.Int("x", 0)) + ","
                    + Convert.ToString(region.Int("y", 0)) + ","
                    + Convert.ToString(rw) + "," + Convert.ToString(rh) + ","
                    + Convert.ToString(region.Int("r", 0));
            }
        } else if (shape == 1) {
            spec = "1,0,0," + Convert.ToString(width) + ","
                + Convert.ToString(height) + "," + Convert.ToString(radius);
        } else if (shape == 2 || round) {
            spec = "2,0,0," + Convert.ToString(width) + ","
                + Convert.ToString(height) + ",0";
        }
        app.SetWindowShape(spec);
        app.SetWindowShadow(shadow);
        app.SetChromeVisible(root.Bool("winChrome", true));
        bool resizable = root.Bool("winResizable", true);
        app.SetResizable(resizable);
        app.SetChromeButtons(app.showThemeButton, app.showPinButton,
            app.showMinimizeButton, resizable);
        app.SetToolWindow(root.Bool("winTool", false));
        app.SetNativeGlass(root.Bool("winGlass", false));
        app.SetWindowOpacity(root.Int("winOpacity", 100));
    }

    static string DefaultSizeClass(JsonValue root) {
        int size = root.Int("formSize", 1);
        if (size == 0) { return "large"; }
        if (size == 2) { return "small"; }
        return "";
    }

    static bool HasSizeClass(string classes) {
        List<string> xs = classes.Split(" ");
        for (int i = 0; i < xs.Count; i = i + 1) {
            string x = xs[i].Trim();
            if (x == "tiny" || x == "small" || x == "medium" || x == "large") {
                return true;
            }
        }
        return false;
    }

    static bool IsElement(JsonValue o) {
        return o.Str("htmlTag", "") != "" || FormBuilder.Kind(o) == "Element";
    }

    // 核心契约与语义定义。

    // 字段的规范 kind：设计文档 `kind` 键优先，旧文档回退 LegacyKind(type)。
    static string Kind(JsonValue o) {
        string k = o.Str("kind", "");
        if (k == "") { k = FormBuilder.LegacyKind(o.Int("type", -1)); }
        if (k == "Table" || k == "DataTable") { return "DataGrid"; }
        if (k == "Scrollbar" || k == "Layer") { return "Panel"; }
        if (k == "Chart") { return "ChartHost"; }
        if (k == "Ellipsis") { return "Label"; }
        if (k == "Ribbon") { return "ToolStrip"; }
        if (k == "Alert") { return "AlertBox"; }
        return k;
    }

    // GUI 控件排版布局与事件分发契约。
    // 核心契约与语义定义。
    static string LegacyKind(int t) {
        if (t == 0) { return "Input"; }
        if (t == 1) { return "TextArea"; }
        if (t == 4) { return "Radio"; }
        if (t == 5) { return "Checkbox"; }
        if (t == 6) { return "SelectBox"; }
        if (t == 7) { return "Switch"; }
        if (t == 8) { return "Rate"; }
        if (t == 9) { return "Slider"; }
        if (t == 18 || t == 45) { return "Panel"; }
        if (t == 29) { return "Progress"; }
        if (t == 36) { return "Tabs"; }
        if (t == 37) { return "Pagination"; }
        if (t == 49) { return "FloatButton"; }
        if (t == 58) { return "ToolStrip"; }
        if (t == 59) { return "StatusBar"; }
        if (t == 60) { return "SplitPanel"; }
        return "";
    }

    // 设计对象是否带 kids 数组（即容器）。
    static bool IsContainer(JsonValue o) {
        JsonValue kids = o.Get("kids");
        return kids != null && kids.IsArray();
    }

    // 控件是否自带 `label` 属性（Checkbox / Radio 那样把标题画在框
    // 旁边）。自带的交给控件，不自带的由表单在它上面补一行标题。
    static bool OwnsLabel(Control ctl) {
        if (ctl == null) { return false; }
        List<PropSpec> ps = ctl.Props();
        if (ps == null) { return false; }
        for (int i = 0; i < ps.Count; i = i + 1) {
            if (ps[i].key == "label") { return true; }
        }
        return false;
    }

    // 字段需不需要表单替它画标题。以前这里是一张写死的白名单
    // （Input / TextArea / SelectBox），于是 Switch、Slider、Rate 这些
    // 字段的 label 既没进控件、也没画成标题，直接丢了；Checkbox 和
    // Radio 明明自带 label 属性也拿不到值。改成问控件自己有没有
    // label：没有就由表单补标题，两边都不会再漏。
    static bool NeedsCaption(JsonValue o, Control ctl) {
        // 只有设计文档真的写了 `label` 才由表单补标题行。`Caption` 在没有
        // label 时会回退到 `name`，那是给自带 label 的控件兜底用的——若这里
        // 也认那个回退，任何只写了 `name` 的字段都会被套一层
        // `FbStack{Label, 控件}`，控件树凭空深一层：设计文档里
        // `host.children[0].children[0]` 拿到的就不再是字段控件本身
        // （CheckboxGroup 的聚合 API 因此全部落到 FbStack 上）。
        if (o.Str("label", "") == "") { return false; }
        return !FormBuilder.OwnsLabel(ctl);
    }

    // 字段高度（设计文档 fh；缺省 / 非法 32）。
    static int PrefH(JsonValue o) {
        int h = o.Int("fh", 32);
        return h > 0 ? h : 32;
    }

    // 工具条 / 状态栏的默认停靠边（Top / Bottom），其余 Manual。
    static int DefaultDock(JsonValue o) {
        string k = FormBuilder.Kind(o);
        if (k == "ToolStrip") { return 1; }
        if (k == "StatusBar") { return 2; }
        return 0;
    }

    // span 钳制到 [1,24]。
    static int ClampSpan(int s) {
        if (s < 1) { return 1; }
        if (s > 24) { return 24; }
        return s;
    }

    // 标题文案：label 优先，为空回退 name。
    static string Caption(JsonValue o) {
        string label = o.Str("label", "");
        if (label != "") { return label; }
        return o.Str("name", "");
    }

    // kids 数组长度（非容器 0）。
    static int ChildCount(JsonValue o) {
        JsonValue kids = o.Get("kids");
        if (kids != null && kids.IsArray()) { return kids.Count(); }
        return 0;
    }

    // 第 i 个选项文本（缺失 / 非字符串回退 def）。
    static string OptAt(JsonValue o, int i, string def) {
        JsonValue opts = o.Get("options");
        if (opts == null || !opts.IsArray() || i >= opts.Count()) { return def; }
        JsonValue it = opts.At(i);
        if (it == null || !it.IsString()) { return def; }
        return it.AsString(def);
    }

    // 第 i 个选项解析为整数（缺失 / 非数字回退 def）。
    static int OptInt(JsonValue o, int i, int def) {
        string s = FormBuilder.OptAt(o, i, "");
        if (s == "" || !FormBuilder.IsNumber(s)) { return def; }
        return Convert.ToInt32(s);
    }

    // 是否为（可选负号前缀的）纯整数字符串。
    static bool IsNumber(string s) {
        if (s == null || s == "") { return false; }
        int i = 0;
        if (s.StartsWith("-")) { i = 1; }
        if (i >= s.Length) { return false; }
        while (i < s.Length) {
            int c = s[i] & 255;
            if (c < 48 || c > 57) { return false; }
            i = i + 1;
        }
        return true;
    }

    // options 数组 → "a|b|c" 文本（空数组返回 ""）。
    static string JoinOpts(JsonValue o) {
        JsonValue opts = o.Get("options");
        if (opts == null) { return ""; }
        if (opts.IsString()) { return opts.AsString(""); }
        if (!opts.IsArray() || opts.Count() == 0) { return ""; }
        StringBuilder sb = new StringBuilder();
        for (int i = 0; i < opts.Count(); i = i + 1) {
            if (i > 0) { sb.Append("|"); }
            sb.Append(opts.At(i).AsString(""));
        }
        return sb.ToString();
    }

    // 核心契约与语义定义。

    static Control MakeControl(JsonValue o, bool free) {
        Control ctl = FormBuilder.CreateControl(o);
        if (ctl != null) { FormBuilder.SetupControl(ctl, o, "", false); }
        return ctl;
    }

    static Control CreateControl(JsonValue o) {
        if (FormBuilder.IsElement(o)) {
            Element el = new Element();
            return el;
        }
        string kind = FormBuilder.Kind(o);
        if (kind == "") { return null; }
        ControlBootstrap.Install();
        return ControlFactory.Create(kind);
    }

    static bool IsEventKey(string key) {
        return key.Length > 2 && key.StartsWith("on")
            && key[2] >= 65 && key[2] <= 90;
    }

    static bool IsModelKey(string key) {
        return key == "kind" || key == "type" || key == "name"
            || key == "tag" || key == "htmlTag" || key == "htmlContent"
            || key == "class" || key == "style" || key == "props"
            || key == "kids" || key == "dock" || key == "dockSide"
            || key == "fx" || key == "fy" || key == "fw" || key == "fh"
            || key == "position" || key == "anchor" || key == "flexGrow"
            || key == "span" || key == "childTab" || key == "ph"
            || key == "pad" || key == "gap" || key == "bind"
            || key == "bindProp" || key == "if" || key == "for"
            || key == "columns" || key == "of" || key == "options"
            || key == "label" || key == "ref" || key == "compAbs"
            || key == "compAnon" || key == "arg" || key == "rowFactory"
            || key == "locked" || key == "pvOff" || key == "activeTab";
    }

    static string ScalarText(JsonValue value) {
        if (value.IsString()) { return value.AsString(""); }
        if (value.IsBool()) { return value.AsBool(false) ? "true" : "false"; }
        if (value.IsNumber()) { return value.ToJson(); }
        return "";
    }

    // 编辑元数据只有真实绑定属性接受，避免 SetProp 未知键制造类。
    static bool AcceptScalar(Control ctl, string key) {
        if (key == "locked" || key == "pvOff") { return false; }
        if (key == "activeTab") { return ctl is Tabs && ctl.PropOf(key) != null; }
        if (key == "alt" || key == "defOn" || key == "required") {
            return ctl is Element || ctl.PropOf(key) != null;
        }
        return true;
    }

    // 工厂实例与生成的 typed new 只在构造上不同，所有声明在此消费。
    static void SetupControl(Control ctl, JsonValue o, string sizeClass, bool anon) {
        if (ctl is Element) {
            Element el = (Element)ctl;
            string tag = o.Str("htmlTag", o.Str("tag", "div"));
            if (tag == "") { tag = "div"; }
            el.InitElement(tag, o.Str("name", ""));
            JsonValue content = o.Get("htmlContent");
            if (content == null || !content.IsArray()) { el.SetText(o.Str("text", "")); }
            string loop = o.Str("for", "");
            if (loop != "") { el.SetAttr("data-for", loop); }
        }
        string cls = o.Str("class", "");
        if (!(ctl is Element) && sizeClass != "" && !FormBuilder.HasSizeClass(cls)) {
            cls = cls == "" ? sizeClass : cls + " " + sizeClass;
        }
        ctl.Class = cls;
        ctl.name = o.Str("name", "");
        string cap = o.Str("label", "");
        if (cap != "") { ctl.SetDesignText(cap); }
        JsonValue props = o.Get("props");
        if (props != null && props.IsObject()) {
            for (int i = 0; i < props.Count(); i = i + 1) {
                JsonValue value = props.ValAt(i);
                string key = props.KeyAt(i);
                if (value == null || !FormBuilder.AcceptScalar(ctl, key)) { continue; }
                if (!value.IsString() && !value.IsBool() && !value.IsNumber()) { continue; }
                ctl.SetProp(key, FormBuilder.ScalarText(value));
            }
        }
        for (int i = 0; i < o.Count(); i = i + 1) {
            string key = o.KeyAt(i);
            JsonValue value = o.ValAt(i);
            if (value == null || (FormBuilder.IsModelKey(key) && key != "activeTab")
                || !FormBuilder.AcceptScalar(ctl, key)) { continue; }
            if (FormBuilder.IsEventKey(key)) {
                if (!anon && value.IsString()) {
                    ctl.SetHandler(key.Substring(2), value.AsString(""));
                }
                continue;
            }
            if (!value.IsString() && !value.IsBool() && !value.IsNumber()) { continue; }
            if (key == "text" && ctl is Element) { continue; }
            string text = FormBuilder.ScalarText(value);
            if (ctl is Element) {
                Element el = (Element)ctl;
                el.SetAttr(key, text);
                if (key == "title") { el.elTitle = text; }
            } else {
                ctl.SetProp(key, text);
            }
        }
        string options = FormBuilder.JoinOpts(o);
        if (options != "") { ctl.SetProp("options", options); }
        JsonValue columns = o.Get("columns");
        if (columns != null && columns.IsNumber()) {
            ctl.SetProp("columns", FormBuilder.ScalarText(columns));
        }
        ctl.name = o.Str("name", "");
        ctl.bindPath = o.Str("bind", "");
        string bindProp = o.Str("bindProp", "");
        if (bindProp != "") { ctl.bindProp = bindProp; }
        ctl.bindIf = o.Str("if", "");
        ctl.handlerArg = anon ? "" : o.Str("arg", "");
        string style = o.Str("style", "");
        if (o.Has("flexGrow")) {
            style = style + ";flex-grow:" + Convert.ToString(o.Int("flexGrow", 0));
        }
        if (style != "") { ctl.SetProp("style", style); }
        if (o.Has("pad")) { ctl.logPad = o.Int("pad", 0); }
        if (o.Has("gap")) { ctl.logGap = o.Int("gap", 0); }
    }

    // DataGrid 的 columns 对象数组压成列头预览串（"宽,标题|…"）。
    // 运行时建树拿不到 "of" 的实体类型，预览只铺列头；类型化取值
    // 由编译期 GenForm 生成。
    static string GridColumnsSpec(JsonValue o) {
        JsonValue cols = o.Get("columns");
        if (cols == null || !cols.IsArray()) { return ""; }
        string spec = "";
        for (int i = 0; i < cols.Count(); i = i + 1) {
            JsonValue c = cols.At(i);
            if (c == null || !c.IsObject()) { continue; }
            string title = c.Str("title", "");
            if (title == "") { title = c.Str("field", ""); }
            if (title == "") { continue; }
            if (spec != "") { spec = spec + "|"; }
            spec = spec + Convert.ToString(c.Int("width", 100)) + "," + title;
        }
        return spec;
    }

    static Control SlotOf(Control parent, JsonValue o) {
        if (o.Has("childTab") || parent is Tabs || parent is SplitPanel) {
            int slot = o.Int("childTab", 0);
            if (slot < 0) { slot = 0; }
            return parent.SlotHost(slot);
        }
        return parent;
    }

    static void AddChild(Control parent, Control child) {
        if (parent is Element) { ((Element)parent).AddKid(child); }
        else { parent.Add(child); }
    }

    // 先按字段序建子树，后按混排序装配。重复/越界引用不重复挂树。
    static void BuildArray(Control parent, JsonValue arr, JsonValue content,
                           bool free, bool natural, bool anon, FbBuildContext ctx) {
        List<Control> nodes = new List<Control>();
        for (int i = 0; i < arr.Count(); i = i + 1) {
            JsonValue o = arr.At(i);
            nodes.Add(FormBuilder.BuildNode(o, free, anon, ctx));
        }
        bool[] added = new bool[arr.Count()];
        List<FbSlotFlow> flows = new List<FbSlotFlow>();
        if (content != null && content.IsArray()) {
            for (int i = 0; i < content.Count(); i = i + 1) {
                JsonValue item = content.At(i);
                if (item.IsString()) {
                    if (parent is Element) { ((Element)parent).AddText(item.AsString("")); }
                } else if (item.IsNumber()) {
                    int idx = item.AsInt(0 - 1);
                    if (idx >= 0 && idx < nodes.Count && !added[idx]) {
                        FormBuilder.AttachNode(parent, arr.At(idx), nodes[idx],
                            free, true, flows);
                        added[idx] = true;
                    }
                }
            }
        }
        for (int i = 0; i < nodes.Count; i = i + 1) {
            if (!added[i]) {
                FormBuilder.AttachNode(parent, arr.At(i), nodes[i], free, natural, flows);
            }
        }
    }

    static void CollectNodes(JsonValue arr, List<JsonValue> nodes) {
        for (int i = 0; i < arr.Count(); i = i + 1) {
            JsonValue o = arr.At(i);
            nodes.Add(o);
            JsonValue kids = o.Get("kids");
            if (kids != null && kids.IsArray()) { FormBuilder.CollectNodes(kids, nodes); }
        }
    }

    static Control BuildNode(JsonValue o, bool free, bool anon, FbBuildContext ctx) {
        Control ctl = null;
        if (ctx.prepared != null) {
            for (int i = 0; i < ctx.originalNodes.Count; i = i + 1) {
                if (ctx.originalNodes[i] == o) {
                    if (i < ctx.prepared.Count) { ctl = ctx.prepared[i]; }
                    break;
                }
            }
        }
        bool supplied = ctl != null;
        if (ctl == null) { ctl = FormBuilder.CreateControl(o); }
        if (ctl == null) { return null; }
        FormBuilder.SetupControl(ctl, o, ctx.sizeClass, anon);
        if (!supplied && FormBuilder.Kind(o) == "DataGrid") {
            string spec = FormBuilder.GridColumnsSpec(o);
            if (spec != "") { ctl.SetProp("previewColumns", spec); }
        }
        FormBuilder.SetupLayout(ctl, o, free);
        JsonValue kids = o.Get("kids");
        if (kids != null && kids.IsArray()) {
            bool kidsFree = free;
            if (o.Bool("compAnon", false)) { kidsFree = o.Bool("compAbs", false); }
            if (!free && !FormBuilder.IsElement(o)) { ctl.AddClass("designgroup"); }
            FormBuilder.BuildArray(ctl, kids, o.Get("htmlContent"), kidsFree,
                ctl is Element, anon || o.Bool("compAnon", false), ctx);
        } else {
            JsonValue content = o.Get("htmlContent");
            if (content != null && content.IsArray()) {
                FormBuilder.BuildArray(ctl, JsonValue.NewArray(), content, free, true, anon, ctx);
            }
        }
        return ctl;
    }

    // 只有声明了位置（fx/fy）才算浮动几何：fw/fh 是自然尺寸声明，
    // free 布局里必须留在流内继续参与 flex。曾经把 fh 也算进来，
    // 「声明高的分隔线 + grow 填充行」的带子里分隔线被当成浮动拽出
    // 流外钉在 (0,0)——填充行吃满整条带、两者重叠、总高溢出
    // （RunStrip line=22 rule=3，带高只有 22）。
    static bool HasGeometry(JsonValue o) {
        return o.Has("fx") || o.Has("fy");
    }

    // 无声明不制造默认尺寸。Float 与 CSS absolute 共用定位出口。
    static void SetupLayout(Control ctl, JsonValue o, bool free) {
        ctl.designFloat = false;
        ctl.designAnchor = 0;
        bool floating = false;
        if (o.Has("position")) {
            floating = o.Int("position", 0) == 1;
            if (!floating) {
                ctl.dock = FormBuilder.DefaultDock(o);
                if (ctl.dock == 0) { ctl.dock = Dock.Top(); }
            }
        } else if (o.Has("dock") || o.Has("dockSide")) {
            int dock = o.Int("dock", o.Int("dockSide", 0));
            floating = dock == 0;
            if (!floating) { ctl.dock = dock; }
        } else if (free && FormBuilder.HasGeometry(o)) {
            floating = true;
        }
        if (floating) {
            ctl.Dock(Dock.Manual());
            ctl.designFloat = true;
            ctl.designAnchor = o.Int("anchor", 0);
            ctl.logPlaceSet = true;
            ctl.logX = o.Int("fx", 0);
            ctl.logY = o.Int("fy", 0);
        }
        ctl.grow = o.Int("flexGrow", 0) > 0;
        if (o.Int("fw", 0) > 0) { ctl.logW = o.Int("fw", 0); }
        if (o.Int("fh", 0) > 0) { ctl.logH = o.Int("fh", 0); }
    }

    static void AttachNode(Control parent, JsonValue o, Control ctl,
                           bool free, bool natural, List<FbSlotFlow> flows) {
        if (ctl == null) { return; }
        Control host = FormBuilder.SlotOf(parent, o);
        if (free || natural || ctl.designFloat || parent is Element
                || FormBuilder.IsElement(o) || (!o.Has("position")
                    && (o.Has("dock") || o.Has("dockSide")))) {
            FormBuilder.AddChild(host, ctl);
            return;
        }
        FbFlow flow = null;
        for (int i = 0; i < flows.Count; i = i + 1) {
            if (flows[i].host == host) { flow = flows[i].flow; break; }
        }
        if (flow == null) {
            flow = new FbFlow();
            flow.Dock(Dock.Top());
            flows.Add(new FbSlotFlow(host, flow));
            FormBuilder.AddChild(host, flow);
        }
        int span = FormBuilder.IsContainer(o) ? 24 : FormBuilder.ClampSpan(o.Int("span", 24));
        flow.AddCell(FormBuilder.WrapCell(o, ctl), span);
    }

    static Control WrapCell(JsonValue o, Control ctl) {
        if (FormBuilder.IsContainer(o)) {
            int h = o.Int("ph", o.Int("fh", 0));
            if (h > 0) { ctl.logH = h; }
            return ctl;
        }
        if (ctl is ChoiceGroup) {
            if (o.Int("fh", 0) > 0) { ((ChoiceGroup)ctl).SetRowHeight(o.Int("fh", 0)); }
        } else if (o.Int("fh", 0) > 0) { ctl.logH = o.Int("fh", 0); }
        if (!FormBuilder.NeedsCaption(o, ctl)) { return ctl; }
        FbStack cell = new FbStack();
        Label caption = new Label(FormBuilder.Caption(o));
        caption.Dock(Dock.Top());
        caption.logH = 18;
        cell.Add(caption);
        ctl.Dock(Dock.Fill());
        cell.Add(ctl);
        return cell;
    }

    static void FillKids(Control parent, JsonValue o, bool free) {
        JsonValue kids = o.Get("kids");
        if (kids != null && kids.IsArray()) {
            FormBuilder.BuildArray(parent, kids, o.Get("htmlContent"), free,
                parent is Element, false, new FbBuildContext());
        }
    }

    static void BuildFlow(Control parent, JsonValue arr) {
        FormBuilder.BuildArray(parent, arr, null, false, false, false, new FbBuildContext());
    }

    static Control BuildCell(JsonValue o) {
        Control ctl = FormBuilder.BuildNode(o, false, false, new FbBuildContext());
        if (ctl == null) { return null; }
        return FormBuilder.WrapCell(o, ctl);
    }

    static void BuildFlowOne(Control parent, JsonValue kid) {
        JsonValue arr = JsonValue.NewArray();
        arr.Append(kid);
        FormBuilder.BuildFlow(parent, arr);
    }

    static void BuildFree(Control parent, JsonValue o) {
        Control ctl = FormBuilder.BuildNode(o, true, false, new FbBuildContext());
        if (ctl != null) { FormBuilder.AddChild(FormBuilder.SlotOf(parent, o), ctl); }
    }

    static JsonValue CompDoc(string name) {
        string text = UserComponentRegistry.JsonOf(name);
        if (text == "") { return null; }
        return JsonValue.ParseLenient(text);
    }

    static string CompStr(JsonValue o, string key) { return o.Str(key, ""); }

    static JsonValue DeepCopy(JsonValue v) {
        if (v == null) { return v; }
        if (v.IsObject()) {
            JsonValue r = JsonValue.NewObject();
            for (int i = 0; i < v.Count(); i = i + 1) {
                r.Put(v.KeyAt(i), FormBuilder.DeepCopy(v.ValAt(i)));
            }
            return r;
        }
        if (v.IsArray()) {
            JsonValue r = JsonValue.NewArray();
            for (int i = 0; i < v.Count(); i = i + 1) {
                r.Append(FormBuilder.DeepCopy(v.At(i)));
            }
            return r;
        }
        return v;
    }

    // 展开字段数组里的用户组件引用节点（带 "ref" 键）。就地
    // 改写：引用节点变成 Panel 外壳（名字/几何/停靠/绑定等
    // 自身键全部保留），组件文档的字段匿名挂进 kids——内部名
    // 不进宿主命名空间、内部事件不接线（组件内部是引用的黑
    // 盒；宿主要接的是引用节点自己的 on* 绑定）。组件文档是
    // 流式时，其顶层字段标 dock=1 让生成代码竖排；自由时保持
    // 绝对坐标。组件可引用组件（递归，防环）。返回 "" 或错误。
    static string ExpandRefs(JsonValue arr, int depth) {
        if (depth > 8) {
            return "user component references nested too deeply (cycle?)";
        }
        for (int i = 0; i < arr.Count(); i = i + 1) {
            JsonValue o = arr.At(i);
            if (o == null || !o.IsObject()) { continue; }
            JsonValue kids = o.Get("kids");
            if (kids != null && kids.IsArray()) {
                string e = FormBuilder.ExpandRefs(kids, depth);
                if (e != "") { return e; }
            }
            string rk = FormBuilder.CompStr(o, "ref");
            if (rk == "" || o.Bool("compAnon", false)) { continue; }
            JsonValue doc = FormBuilder.CompDoc(rk);
            if (doc == null) {
                return "unknown component '" + rk + "' (pass components/"
                    + rk + ".zcomp on the compile line)";
            }
            JsonValue cf = doc.Get("fields");
            if (cf == null || !cf.IsArray()) { cf = JsonValue.NewArray(); }
            /* 组件文档是全部实例共享的解析缓存，展开会原地改写字段 （dock、壳名前缀、props 直通）——不深拷贝，第一个实例 的改名会漏进后续实例（第二个拿到 "Card2_Card1_InnerBtn" 这样的叠前缀名）。标量节点不可变，共享无妨。 */
            cf = FormBuilder.DeepCopy(cf);
            string e2 = FormBuilder.ExpandRefs(cf, depth + 1);
            if (e2 != "") { return e2; }
            bool compFree = doc.Int("layoutMode", 0) == 1;
            string shellName = o.Str("name", rk);
            JsonValue anonKids = JsonValue.NewArray();
            for (int k = 0; k < cf.Count(); k = k + 1) {
                JsonValue kid = cf.At(k);
                if (kid == null || !kid.IsObject()) { continue; }
                if (!compFree && !kid.Has("dock")) {
                    /* 流式组件文档的顶层字段：竖排。 */
                    kid.Put("dock", JsonValue.NewNum("1"));
                }
                /* 内部控件保留设计名但加壳名前缀：不与其它实例撞名， 运行期 Find() 仍可达，只是不生成具名声明。改已有键 必须走 Set（Put 是追加不去重，Get 只认第一个）。 */
                string kn = kid.Str("name", "");
                if (kn != "") {
                    kid.Set("name", JsonValue.NewStr(shellName + "_" + kn));
                }
                anonKids.Append(kid);
            }
            /* 组件声明的对外属性（组件文档根上 "props": [{key,target,prop,def}]）：实例值（引用节点自己的 "props" 直通对象，键 = 声明 key）优先，缺省取 def， 落给目标内部控件的 props 直通——EmitField 本来就会 对 kid 的 props 发 SetProp。壳上消费过的实例 props 必须清空，否则 EmitField 把它们发到 Panel 壳上会 退化成样式类。目标控件不存在是组件作者的错，报错 指名道姓。 */
            JsonValue instProps = o.Get("props");
            JsonValue decls = doc.Get("props");
            if (decls != null && decls.IsArray() && decls.Count() > 0) {
                for (int d = 0; d < decls.Count(); d = d + 1) {
                    JsonValue dd = decls.At(d);
                    if (dd == null || !dd.IsObject()) { continue; }
                    string target = dd.Str("target", "");
                    if (target == "") { continue; }
                    string dkey = dd.Str("key", "");
                    string val = instProps != null && instProps.IsObject()
                        ? instProps.Str(dkey, dd.Str("def", ""))
                        : dd.Str("def", "");
                    if (val == "") { continue; }
                    string tn = shellName + "_" + target;
                    JsonValue tk = null;
                    for (int k = 0; k < anonKids.Count(); k = k + 1) {
                        JsonValue kd = anonKids.At(k);
                        if (kd != null && kd.Str("name", "") == tn) { tk = kd; break; }
                    }
                    if (tk == null) {
                        return "component '" + rk + "' prop '" + dkey
                            + "' targets missing control '" + target + "'";
                    }
                    JsonValue tp = tk.Get("props");
                    if (tp == null || !tp.IsObject()) {
                        tp = JsonValue.NewObject();
                        tk.Put("props", tp);
                    }
                    tp.Set(dd.Str("prop", "text"), JsonValue.NewStr(val));
                }
            }
            if (instProps != null && instProps.IsObject()) {
                o.Set("props", JsonValue.NewObject());
            }
            /* 同上：引用节点自身这些键都已存在，一律 Set 覆盖。 */
            o.Set("kind", JsonValue.NewStr("Panel"));
            if (!o.Has("name")) { o.Put("name", JsonValue.NewStr(rk)); }
            if (o.Str("label", "") == "") { o.Set("label", JsonValue.NewStr(rk)); }
            if (!o.Has("fw")) {
                int ww = doc.Int("winW", 240);
                o.Put("fw", JsonValue.NewNum(Convert.ToString(ww)));
            }
            if (!o.Has("fh")) {
                int wh = doc.Int("winH", 0);
                if (wh <= 0) { wh = 48; }
                o.Put("fh", JsonValue.NewNum(Convert.ToString(wh)));
            }
            /* 流式分支的容器高度用组件画布高，而不是 44+44*子数。 */
            o.Set("ph", JsonValue.NewNum(Convert.ToString(doc.Int("winH", 0))));
            o.Set("kids", anonKids);
            /* EmitField 的展开标记：壳自己是具名字段，子树匿名。 */
            o.Set("compAbs", JsonValue.NewBool(compFree));
            o.Set("compAnon", JsonValue.NewBool(true));
        }
        return "";
    }

    // 从设计器的 FormField 构建单个叶子控件（不含标题标签——标题由
    // 设计器/表单布局单独绘制）。设计器预览用它渲染真控件，与运行时的
    // MakeControl 走同一条构造路径，从根上消除“所见非所得”。
    static Control FromField(FormField f) {
        JsonValue o = JsonValue.NewObject();
        o.Put("label", JsonValue.NewStr(f.label));
        o.Put("name", JsonValue.NewStr(f.fname));
        o.Put("placeholder", JsonValue.NewStr(f.placeholder));
        o.Put("kind", JsonValue.NewStr(f.KindName()));
        o.Put("class", JsonValue.NewStr(f.Class));
        o.Put("style", JsonValue.NewStr(f.styleText));
        if (f.defOn) { o.Put("defOn", JsonValue.NewBool(true)); }
        if (f.wrap) { o.Put("wrap", JsonValue.NewBool(true)); }
        if (f.OptionCount() > 0) {
            JsonValue arr = JsonValue.NewArray();
            for (int i = 0; i < f.OptionCount(); i = i + 1) {
                arr.Append(JsonValue.NewStr(f.OptionAt(i)));
            }
            o.Put("options", arr);
        }
        Control ctl = FormBuilder.MakeControl(o, false);
        if (ctl == null) { return null; }
        ctl.name = f.fname;
        return ctl;
    }
}

class FbBuildContext {
    List<Control> prepared;
    List<JsonValue> originalNodes;
    string sizeClass;

    FbBuildContext() {
        prepared = null;
        originalNodes = new List<JsonValue>();
        sizeClass = "";
    }
}

class FbSlotFlow {
    Control host;
    FbFlow flow;

    FbSlotFlow(Control host, FbFlow flow) {
        this.host = host;
        this.flow = flow;
    }
}

// 24 列流式容器（设计器/运行时/FormBuilder 共用的唯一布局原语）。
// 把子节点按各自 span（1..24）贪心打包成多行：一行累计 span 超过 24
// 就换行；每个单元宽度按 span/24 比例分配（与设计器 LayoutFlowList
// 完全一致：按 24 列而非行内总和分配，列间留 colGap，行间留 rowGap），
// 行高取该行子节点 prefH 的最大值。无表面。
class FbFlow : Panel {
    // 与 children 平行的列宽表（span 1..24）。
    List<int> spans;
    // 逻辑像素（100% 下的样子）。
    int colGap;
    int rowGap;
    // 单元最小宽度（逻辑像素，过窄时兜底）。
    int minCell;
    // OnMeasure 按当前缩放解析出的实际间距，供拿不到 App 的
    // Arrange 复用 —— 直接用逻辑值排布，150% 下列间距会偏窄、
    // 行距不足，字段互相贴住。
    int mColGap;
    int mRowGap;
    int mMinCell;

    // 构造：列距 12 / 行距 6 / 最小单元 24（逻辑像素）。
    FbFlow() {
        this.InitPanel("fbflow", 3);
        this.spans = new List<int>();
        this.colGap = 12;
        this.rowGap = 6;
        this.minCell = 24;
        this.mColGap = 12;
        this.mRowGap = 6;
        this.mMinCell = 24;
    }

    // 追加一个单元及其列宽（span，1..24）。
    void AddCell(Control c, int span) {
        this.spans.Add(span);
        this.Add(c);
    }

    // 第 i 单元的列宽（钳制 1..24；越界按 24）。
    int SpanAt(int i) {
        if (i < this.spans.Count) {
            int s = this.spans[i];
            if (s < 1) { return 1; }
            if (s > 24) { return 24; }
            return s;
        }
        return 24;
    }

    // 行结束下标（不含）：从 start 起贪心累计到超过 24 列。
    int RowEnd(int start) {
        int n = this.children.Count;
        int end = start;
        int cols = 0;
        while (end < n) {
            int sp = this.SpanAt(end);
            if (end > start && cols + sp > 24) { break; }
            cols = cols + sp;
            end = end + 1;
            if (cols >= 24) { break; }
        }
        return end;
    }

    // [start,end) 行高 = 行内子节点 prefH 的最大值。
    int RowHeight(int start, int end) {
        int rowH = 0;
        for (int k = start; k < end; k = k + 1) {
            int hk = this.children[k].prefH;
            if (hk > rowH) { rowH = hk; }
        }
        return rowH;
    }

    // 覆写：不画任何表面（画布容器，视觉全由子控件承担）。
    override void OnPaint(App app) {
    }

    // 覆写：按 24 栅格分行的行高累计出首选高（宽随宿主）。
    override void OnMeasure(App app) {
        this.mColGap = app.Scale(this.colGap);
        this.mRowGap = app.Scale(this.rowGap);
        this.mMinCell = app.Scale(this.minCell);
        int n = this.children.Count;
        int i = 0;
        int total = 0;
        int rows = 0;
        while (i < n) {
            int end = this.RowEnd(i);
            total = total + this.RowHeight(i, end);
            rows = rows + 1;
            i = end;
        }
        if (rows > 1) { total = total + this.mRowGap * (rows - 1); }
        this.prefH = total;
        this.prefW = 0;
    }

    // 覆写：按每项 span 把 24 栅格宽折算成单元格矩形逐行摆放。
    override void Arrange(int px, int py, int pw, int ph) {
        if (pw < 0) { pw = 0; }
        if (ph < 0) { ph = 0; }
        this.bx = px;
        this.by = py;
        this.bw = pw;
        this.bh = ph;
        int cx = px + this.StylePadL();
        int cy = py + this.StylePadT();
        int cw = pw - this.StylePadL() - this.StylePadR();
        if (cw < 0) { cw = 0; }
        int n = this.children.Count;
        int i = 0;
        int rowY = cy;
        while (i < n) {
            int end = this.RowEnd(i);
            int rowH = this.RowHeight(i, end);
            int acc = 0;
            for (int k = i; k < end; k = k + 1) {
                int xa = cx + cw * acc / 24;
                acc = acc + this.SpanAt(k);
                int xb = cx + cw * acc / 24;
                int wCell = xb - xa;
                if (k < end - 1) { wCell = wCell - this.mColGap; }
                if (wCell < this.mMinCell) { wCell = this.mMinCell; }
                this.children[k].Arrange(xa, rowY, wCell, rowH);
            }
            rowY = rowY + rowH + this.mRowGap;
            i = end;
        }
    }
}

// 竖直单元：标签在上、控件填充其余。用于带 caption 的流式字段，
// 无表面。
class FbStack : Panel {
    // 构造：以 "fbstack" 注册为透明布局面板（标签在上、控件填充）。
    FbStack() {
        this.InitPanel("fbstack", 3);
    }

    // 覆写：不画任何表面（无表面竖直单元）。
    override void OnPaint(App app) {
    }

    // 覆写：子项测量高累计、宽取最宽者（宽随宿主）。
    override void OnMeasure(App app) {
        int h = 0;
        int w = 0;
        for (int i = 0; i < this.children.Count; i = i + 1) {
            h = h + this.children[i].prefH;
            if (this.children[i].prefW > w) { w = this.children[i].prefW; }
        }
        this.prefH = h;
        this.prefW = 0;
    }

    // 覆写：子项自上而下按测量高堆叠，dock-fill（dock==5）的
    // 子项吃掉剩余高度。
    override void Arrange(int px, int py, int pw, int ph) {
        if (pw < 0) { pw = 0; }
        if (ph < 0) { ph = 0; }
        this.bx = px;
        this.by = py;
        this.bw = pw;
        this.bh = ph;
        int cy = py;
        int rest = ph;
        for (int i = 0; i < this.children.Count; i = i + 1) {
            Control c = this.children[i];
            if (c.dock == 5) {
                c.Arrange(px, cy, pw, rest);
            } else {
                int hh = c.prefH;
                if (hh > rest) { hh = rest; }
                if (hh < 0) { hh = 0; }
                c.Arrange(px, cy, pw, hh);
                cy = cy + hh;
                rest = rest - hh;
            }
        }
    }
}

