using System;
using Gui;
using Gui.Core;

namespace Gui.Widget;

// 移动端与折叠屏多点触控与双指自由缩放容器（PinchZoomView）：
// 支持双指捏合缩放（Pinch-to-zoom）、单指/双指平移（Pan）、双击快速放大/复原（DoubleTap Zoom），
// 专为移动大屏与折叠屏上的图像查看器、思维导图、图纸审阅、复杂图表打造。
public class PinchZoomView : Panel {
    private MultiTouchTracker tracker;
    private float currentScale;
    private float minScale;
    private float maxScale;
    private float transX;
    private float transY;

    public PinchZoomView() : base() {
        InitPinchZoomView();
    }

    public PinchZoomView(string name) : base(name) {
        InitPinchZoomView();
    }

    private void InitPinchZoomView() {
        tracker = new MultiTouchTracker();
        currentScale = 1.0f;
        minScale = 0.5f;
        maxScale = 4.0f;
        transX = 0.0f;
        transY = 0.0f;
    }

    public PinchZoomView WithMinScale(float min) {
        if (min > 0.1f) { minScale = min; }
        return this;
    }

    public PinchZoomView WithMaxScale(float max) {
        if (max > minScale) { maxScale = max; }
        return this;
    }

    public float Scale() { return currentScale; }
    public float TranslationX() { return transX; }
    public float TranslationY() { return transY; }

    // 重置变换状态（回到 1.0x 原始视口）
    public void ResetTransform() {
        currentScale = 1.0f;
        transX = 0.0f;
        transY = 0.0f;
        this.Invalidate();
    }

    // 双击快速复原或放大至 2.0x
    public void HandleDoubleTap(int clickX, int clickY) {
        AudioHaptics.Tap();
        if (currentScale > 1.05f || currentScale < 0.95f) {
            // 当前处于缩放态：双击复位
            ResetTransform();
        } else {
            // 当前处于 1.0x：双击以点击点为中心放大至 2.0x
            currentScale = 2.0f;
            transX = (float)clickX * (1.0f - currentScale);
            transY = (float)clickY * (1.0f - currentScale);
            this.Invalidate();
        }
    }

    // 触控点按下
    public void OnPointerDown(int id, int x, int y) {
        tracker.PointerDown(id, x, y);
    }

    // 触控点移动（驱动双指缩放与平移）
    public void OnPointerMove(int id, int x, int y) {
        tracker.PointerMove(id, x, y);

        int activeCount = tracker.ActiveCount();
        if (activeCount >= 2) {
            // 双指缩放模式
            float delta = tracker.ScaleDelta();
            if (delta > 0.5f && delta < 2.0f) {
                float newScale = currentScale * delta;
                if (newScale < minScale) { newScale = minScale; }
                else if (newScale > maxScale) { newScale = maxScale; }

                float focusX = tracker.FocusX();
                float focusY = tracker.FocusY();
                // 焦点中心补偿：保持双指捏合中心下的像素不发生漂移
                transX = focusX - (focusX - transX) * (newScale / currentScale);
                transY = focusY - (focusY - transY) * (newScale / currentScale);
                currentScale = newScale;

                // 叠加双指共同拖拽的平移量
                transX = transX + tracker.FocusDeltaX();
                transY = transY + tracker.FocusDeltaY();

                this.Invalidate();
            }
        } else if (activeCount == 1) {
            // 单指平移模式（在已放大状态下允许拖动画布）
            if (currentScale > 1.0f) {
                transX = transX + tracker.FocusDeltaX();
                transY = transY + tracker.FocusDeltaY();
                this.Invalidate();
            }
        }
    }

    // 触控点释放
    public void OnPointerUp(int id) {
        tracker.PointerUp(id);
    }
}
