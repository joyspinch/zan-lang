using System;
using Gui;
namespace Gui.Widget;
public class Label : Control {
    public override Control CreateCloneShell() { return new Label(); }
    public Binding<string> Text;
    public bool wrap;
    private int minCharW;
    private string measuredText;
    private int measuredFont;
    private int measuredWidth;
    private int measuredLineH;
    private int measuredRev = 0 - 1;
    private StyleBox lastMeasStyle;
    private int lastMeasGap = 0 - 1;
    private int lastMeasW;
    private int lastMeasH;
    private string ellipsisSrc;
    private int ellipsisAvail;
    private int ellipsisFs;
    private int ellipsisDpi;
    private string ellipsisFit;
    private int ellipsisFitW;
    private string wrapCacheText;
    private int wrapCacheSlotW;
    private int wrapCacheFs;
    private int wrapCacheRev = 0 - 1;
    private List<string> wrapCacheLines;
    private List<int> wrapCacheWidths;
    private int wrapCacheMaxW;
    private int wrapCacheMinCharW;
    private int wrapCacheLineH;
    public void InitLabel(string txt) {
        string safe = txt != null ? txt : "";
        this.InitControl(safe);
        Text = safe;
        wrap = false;
        minCharW = 0;
    }
    public Label() { InitLabel(""); }
    public Label(string txt) { InitLabel(txt); }
    public string GetText() {
        if (Text == null) { return ""; }
        string s = Text.Get();
        return s != null ? s : "";
    }
    public bool IsWrap {
        get { return this.wrap; }
        set { this.wrap = value; }
    }
    // 加粗字体（font-weight: 700 / strong 类）。
    public Label Bold() { this.AddClass("strong"); return this; }

    // 弱化文本颜色（secondary 类）。
    public Label Muted() { this.AddClass("secondary"); return this; }

    // 提示级别弱化（hint 类）。
    public Label Hint() { this.AddClass("hint"); return this; }

    // 标题字号（title 类）。
    public Label Title() { this.AddClass("title"); return this; }

    // 主要颜色角色（primary 类）。
    public Label Primary() { this.AddClass("primary"); return this; }

    // 成功颜色角色（success 类）。
    public Label Success() { this.AddClass("success"); return this; }

    // 警告颜色角色（warning 类）。
    public Label Warning() { this.AddClass("warning"); return this; }

    // 错误颜色角色（error 类）。
    public Label Error() { this.AddClass("error"); return this; }

    // 小字号（small 类）。
    public Label Small() { this.AddClass("small"); return this; }

    // 微型字号（tiny 类）。
    public Label Tiny() { this.AddClass("tiny"); return this; }

    // 大字号（large 类）。
    public Label Large() { this.AddClass("large"); return this; }

    // 允许/禁止自动换行。
    public Label SetWrap(bool w) { this.wrap = w; return this; }

    // 当前文本（通过绑定解析）。
    public string Str() {
        if (Text == null) { return ""; }
        string s = Text.Get();
        return s != null ? s : "";
    }
    public StyleBox ResolvedStyle() { return this.ResolvedStyle(this.App); }
    public StyleBox ResolvedStyle(App app) {
        app = this.ResolveApp(app);
        return this.ResolveStyleCached(app, "label", Class, Style.SNormal());
    }
    private int TextFontSize(App app, StyleBox style) {
        if (style != null && style.fontPx > 0) { return style.fontPx; }
        int fallback = Style.FontFallback(app, "medium");
        if (parent != null && parent.computedStyle != null && parent.computedStyle.fontPx > 0) {
            string cls = Class;
            bool inherit = false;
            if (cls != null && cls.Length > 0) {
                if (cls == "button-caption" || cls == "tab-item-title"
                    || cls == "badge-text" || cls == "radiobutton-label" || cls == "avatar-text"
                    || Style.Has(cls, "button-caption") || Style.Has(cls, "tab-item-title")
                    || Style.Has(cls, "badge-text") || Style.Has(cls, "radiobutton-label")
                    || Style.Has(cls, "avatar-text")) {
                    inherit = true;
                }
            }
            if (!inherit) {
                string ptype = parent.StyleType();
                if (ptype == "tag" || ptype == "badge" || ptype == "checkbox"
                    || ptype == "radio" || ptype == "radiobutton" || ptype == "avatar") {
                    inherit = true;
                }
            }
            if (inherit) {
                fallback = parent.computedStyle.FontOr(fallback);
            }
        }
        return style != null ? style.FontOr(fallback) : fallback;
    }
    private int TextTop(int y, int height, int textHeight, int align) {
        int spare = height - textHeight;
        if (spare <= 0 || align == 0) { return y; }
        return y + (align == 2 ? spare : spare / 2);
    }
    private int MeasureSingleLine(string text, int font) {
        int rev = Canvas.TextMetricsRev();
        if (measuredRev != rev || measuredFont != font || measuredText != text) {
            measuredWidth = Canvas.MeasureText(text, font);
            measuredLineH = Canvas.FontHeight(font);
            measuredFont = font;
            measuredText = text;
            measuredRev = rev;
        }
        return measuredWidth;
    }
    private void EnsureWrapCache(string txt, int contentSlotW, int fs) {
        int rev = Canvas.TextMetricsRev();
        if (wrapCacheLines != null && wrapCacheRev == rev && wrapCacheFs == fs
            && wrapCacheSlotW == contentSlotW && wrapCacheText == txt) {
            return;
        }
        List<string> lines = TextWrap.Lines(txt, contentSlotW, fs);
        int n = lines.Count;
        List<int> widths = wrapCacheWidths;
        if (widths == null) { widths = new List<int>(); }
        else { widths.Clear(); }
        int maxW = 0;
        for (int li = 0; li < n; li = li + 1) {
            int lw = Canvas.MeasureText(lines[li], fs);
            widths.Add(lw);
            if (lw > maxW) { maxW = lw; }
        }
        wrapCacheText = txt;
        wrapCacheSlotW = contentSlotW;
        wrapCacheFs = fs;
        wrapCacheRev = rev;
        wrapCacheLines = lines;
        wrapCacheWidths = widths;
        wrapCacheMaxW = maxW;
        wrapCacheMinCharW = TextWrap.WidestChar(txt, fs);
        wrapCacheLineH = Canvas.FontHeight(fs);
    }
    private bool EffectiveWrap(StyleBox s) {
        if (s != null) {
            if (s.nowrap == 1) { return false; }
            if (s.whiteSpace == 3) { return true; }
        }
        return wrap;
    }
    protected override bool UsesBaseFlowOnly() { return this.Kind() == "Label"; }
    protected override bool UsesBaseSyncBinding() { return this.Kind() == "Label"; }
    protected override bool IsWidthDependentMeasure() { return this.EffectiveWrap(computedStyle); }
    public override void OnMeasure(App app) {
        if (app == null) { return; }
        StyleBox s = (computedStyle != null && computedStyleApp == app && computedStyleState == Style.SNormal()
            && computedStyleType == "label" && computedStyleCls == Class)
            ? computedStyle : this.ResolvedStyle(app);
        string txt = this.Str();
        if (s != null && s.fontPx > 0 && !wrap && s.whiteSpace != 3) {
            int fsFast = s.fontPx;
            int rev = Canvas.TextMetricsRev();
            int gap = app.theme.gapSmall;
            if (lastMeasStyle == s && measuredRev == rev && measuredFont == fsFast
                && measuredText == txt && lastMeasGap == gap) {
                prefW = lastMeasW;
                prefH = lastMeasH;
                return;
            }
            int twFast;
            if (measuredRev == rev && measuredFont == fsFast && measuredText == txt) {
                twFast = measuredWidth;
            } else {
                twFast = this.MeasureSingleLine(txt, fsFast);
            }
            int bwBase = s.borderW >= 0 ? s.borderW : 0;
            int padHFast = (s.padL >= 0 ? s.padL : 0) + (s.padR >= 0 ? s.padR : 0)
                + (s.borderLeftW >= 0 ? s.borderLeftW : bwBase) + (s.borderRightW >= 0 ? s.borderRightW : bwBase);
            int padVFast = (s.padT >= 0 ? s.padT : 0) + (s.padB >= 0 ? s.padB : 0)
                + (s.borderTopW >= 0 ? s.borderTopW : bwBase) + (s.borderBottomW >= 0 ? s.borderBottomW : bwBase);
            prefW = twFast + padHFast;
            prefH = measuredLineH + gap + padVFast;
            lastMeasStyle = s;
            lastMeasGap = gap;
            lastMeasW = prefW;
            lastMeasH = prefH;
            return;
        }
        int fs = this.TextFontSize(app, s);
        int padH = s.PadLOr(0) + s.PadROr(0) + s.BorderLeftPx() + s.BorderRightPx();
        int padV = s.PadTOr(0) + s.PadBOr(0) + s.BorderTopPx() + s.BorderBottomPx();
        if (this.EffectiveWrap(s)) {
            int slotW = measureWidth;
            if (slotW < 0) {
                slotW = hintWrapW;
                if (this.StyleDeclaresWidth()) { slotW = this.StyleWidthIn(slotW); }
                else if (prefSet && prefW > 0) { slotW = prefW; }
            }
            if (slotW <= 0) { slotW = bw; }
            if (slotW <= 0) { slotW = prefW; }
            if (slotW <= 0 && app.canvas != null) { slotW = app.canvas.Width(); }
            int contentSlotW = slotW - padH;
            if (contentSlotW <= 0) { contentSlotW = slotW; }
            this.EnsureWrapCache(txt, contentSlotW, fs);
            prefH = wrapCacheLines.Count * wrapCacheLineH + app.theme.gapSmall + padV;
            prefW = wrapCacheMaxW + padH;
            minCharW = wrapCacheMinCharW + padH;
            return;
        }
        prefW = this.MeasureSingleLine(txt, fs) + padH;
        prefH = measuredLineH + app.theme.gapSmall + padV;
    }
    public override int MinContentMain(bool row) {
        if (row && this.EffectiveWrap(computedStyle) && minCharW > 0) { return minCharW; }
        return base.MinContentMain(row);
    }
    protected override bool PaintWithinBounds() {
        return this.ClipsText() && this.Kind() == "Label";
    }
    private bool ClipsText() {
        if (computedStyle == null) { return wrap; }
        if (computedStyle.overflowX == 1 || computedStyle.overflowY == 1) { return true; }
        return this.EffectiveWrap(computedStyle) && computedStyle.overflow != 0;
    }
    public override void OnPaint(App app) {
        if (app == null || app.canvas == null) { return; }
        if (!this.ClipsText()) { this.PaintText(app); return; }
        if (bw <= 0 || bh <= 0) { return; }
        app.canvas.PushClip(bx, by, bw, bh);
        try { this.PaintText(app); }
        finally { app.canvas.PopClip(); }
    }
    private void PaintText(App app) {
        StyleBox s = paintedStyle != null ? paintedStyle : this.ResolvedStyle(app);
        int foreground;
        if (s != null && s.foregroundDeclared) {
            foreground = s.fg;
        } else if (Class != null && Class.Length > 0 && parent != null && parent.paintedStyle != null) {
            foreground = (Class == "tab-item-title" || Style.Has(Class, "tab-item-title"))
                ? this.PaintedForeground(s, "tab-item-title")
                : this.PaintedForeground(s, "button-caption");
        } else {
            foreground = s != null ? s.fg : 0;
        }
        int fs = (s != null && s.fontPx > 0) ? s.fontPx : this.TextFontSize(app, s);
        string txt = this.Str();
        int padL = 0;
        int padR = 0;
        int padT = 0;
        int padB = 0;
        if (s != null) {
            int bwBase = s.borderW >= 0 ? s.borderW : 0;
            padL = (s.padL >= 0 ? s.padL : 0) + (s.borderLeftW >= 0 ? s.borderLeftW : bwBase);
            padR = (s.padR >= 0 ? s.padR : 0) + (s.borderRightW >= 0 ? s.borderRightW : bwBase);
            padT = (s.padT >= 0 ? s.padT : 0) + (s.borderTopW >= 0 ? s.borderTopW : bwBase);
            padB = (s.padB >= 0 ? s.padB : 0) + (s.borderBottomW >= 0 ? s.borderBottomW : bwBase);
        }
        if ((s != null ? (s.nowrap == 1 ? false : (s.whiteSpace == 3 ? true : wrap)) : wrap)) {
            int slotW = bw;
            if (slotW <= 0) { slotW = Canvas.MeasureText(txt, fs) + padL + padR; }
            int contentSlotW = slotW - padL - padR;
            if (contentSlotW <= 0) { contentSlotW = slotW; }
            this.EnsureWrapCache(txt, contentSlotW, fs);
            List<string> lines = wrapCacheLines;
            int lh = wrapCacheLineH;
            int n = lines.Count;
            int total = n * lh;
            int ty = this.TextTop(by + padT, bh - padT - padB, total, s.valign);
            for (int li = 0; li < n; li = li + 1) {
                int lx = bx + padL;
                if (s.align == 1) {
                    lx += (contentSlotW - wrapCacheWidths[li]) / 2;
                } else if (s.align == 2) {
                    lx = bx + slotW - padR - wrapCacheWidths[li];
                }
                if (lx < bx + padL) { lx = bx + padL; }
                app.canvas.DrawText(lx, ty, lines[li], foreground, fs);
                ty = ty + lh;
            }
            return;
        }
        int avail = bw - padL - padR;
        if (avail <= 0) { return; }
        int contentH = bh - padT - padB;
        if (contentH <= 0) { return; }
        int rev = Canvas.TextMetricsRev();
        int tw;
        if (measuredRev == rev && measuredFont == fs && measuredText == txt) {
            tw = measuredWidth;
        } else {
            tw = this.MeasureSingleLine(txt, fs);
        }
        if (tw > avail) {
            int dpi = app.dpiScale;
            if (ellipsisSrc != txt || ellipsisAvail != avail
                || ellipsisFs != fs || ellipsisDpi != dpi) {
                ellipsisSrc = txt;
                ellipsisAvail = avail;
                ellipsisFs = fs;
                ellipsisDpi = dpi;
                ellipsisFit = Ellipsis.FitOverflow(txt, avail, fs);
                ellipsisFitW = 0 - 1;
            }
            txt = ellipsisFit;
            if (s.align == 1 || s.align == 2) {
                if (ellipsisFitW < 0) { ellipsisFitW = Canvas.MeasureText(txt, fs); }
                tw = ellipsisFitW;
            }
        }
        int tx = bx + padL;
        if (s.align == 1) { tx += (avail - tw) / 2; }
        else if (s.align == 2) { tx += avail - tw; }
        if (tx < bx + padL) { tx = bx + padL; }
        int contentY = by + padT;
        int fh = measuredLineH;
        int ty;
        if (s.valign == 0 || s.valign == 2) {
            ty = this.TextTop(contentY, contentH, fh, s.valign);
        } else {
            int pad = fh - fs;
            if (pad < 0) { pad = 0; }
            ty = contentY + ((contentH - fh - (pad >> 2)) >> 1);
        }
        int deg = (s.anim == 1 || s.rotate != 0) ? s.SpinDeg(app, bx, by, bw, bh) : 0;
        if (deg != 0) { app.canvas.DrawTextRot(tx, ty, txt, foreground, fs, deg); }
        else { app.canvas.DrawText(tx, ty, txt, foreground, fs); }
    }
    // ---- 设计器 / 序列化模型 ----

    // 覆写：返回设计器属性清单（文本 / 换行 / 类）。
    protected override List<PropSpec> DefineProps() {
        List<PropSpec> ps = new List<PropSpec>();
        ps.Add(PropSpec.Text("text", "Text").DefaultBinding().Field("Text").Also("data").Also("value"));
        ps.Add(PropSpec.Bool("wrap", "Wrap").Field("wrap"));
        return ps;
    }
}
