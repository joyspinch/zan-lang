using System;
using Gui;

namespace Gui.Widget;

// 文本标签。颜色与字号来自 `label` CSS 规则，通过
// 与设计系统其余部分共用的类来选择：
// l.Class = "secondary small";       // 弱化的说明文字
// l.Text = vm.status;                // 绑定，每帧重读
// 类：`secondary` / `hint` / `inverse` 以及语义角色
// （`primary` … `error`）决定颜色，`tiny` / `small` / `medium` / `large`
// 和 `title` 决定字号。
public class Label : Control {
    // 可绑定文本：`lbl.Text = vm.status;` 每帧重新读取模型字段
    // （编译器降级的 Binding）；字面量则存为常量。
    Binding<string> Text;
    // 自动换行：为 true 时，标签将文本折成
    // 适合槽宽的若干行，而不是用省略号截断。高度随行数变化。
    bool wrap;

    // 初始化：文本（可绑定），默认不换行。
    void InitLabel(string txt) {
        this.InitControl(txt, 1);
        Text = txt;
        wrap = false;
    }

    // 空标签（设计器用）。
    Label() { InitLabel(""); }
    // 给定初值文本。
    Label(string txt) { InitLabel(txt); }

    // 获取当前标签文本
    string GetText() {
        if (Text == null) { return ""; }
        return Text.Get();
    }

    // 静态便捷工厂
    static Label Of(string txt) { return new Label(txt); }

    // 加粗字体（font-weight: 700 / strong 类）。
    Label Bold() { this.AddClass("strong"); return this; }

    // 弱化文本颜色（secondary 类）。
    Label Muted() { this.AddClass("secondary"); return this; }

    // 提示级别弱化（hint 类）。
    Label Hint() { this.AddClass("hint"); return this; }

    // 标题字号（title 类）。
    Label Title() { this.AddClass("title"); return this; }

    // 主要颜色角色（primary 类）。
    Label Primary() { this.AddClass("primary"); return this; }

    // 成功颜色角色（success 类）。
    Label Success() { this.AddClass("success"); return this; }

    // 警告颜色角色（warning 类）。
    Label Warning() { this.AddClass("warning"); return this; }

    // 错误颜色角色（error 类）。
    Label Error() { this.AddClass("error"); return this; }

    // 小字号（small 类）。
    Label Small() { this.AddClass("small"); return this; }

    // 微型字号（tiny 类）。
    Label Tiny() { this.AddClass("tiny"); return this; }

    // 大字号（large 类）。
    Label Large() { this.AddClass("large"); return this; }

    // 允许/禁止自动换行。
    Label SetWrap(bool w) { this.wrap = w; return this; }

    // 当前文本（通过绑定解析）。
    string Str() {
        if (Text == null) { return ""; }
        return Text.Get();
    }

    // 解析 `label` 样式（带缓存）。
    StyleBox ResolvedStyle(App app) {
        return this.ResolveStyleCached(app, "label", Class, Style.SNormal());
    }

    // 覆写：测文本宽高；wrap 时按槽宽折行，取最大行宽与行数总高。
    override void OnMeasure(App app) {
        StyleBox s = this.ResolvedStyle(app);
        int fs = s.FontOr(Style.FontFallback(app, "medium"));
        string txt = this.Str();
        int padH = s.PadLOr(0) + s.PadROr(0) + s.BorderLeftPx() + s.BorderRightPx();
        int padV = s.PadTOr(0) + s.PadBOr(0) + s.BorderTopPx() + s.BorderBottomPx();
        if (wrap) {
            int slotW = bw;
            if (slotW <= 0) { slotW = prefW; }
            if (slotW <= 0) { slotW = app.canvas.Width(); }
            int contentSlotW = slotW - padH;
            if (contentSlotW <= 0) { contentSlotW = slotW; }
            List<string> lines = TextWrap.Lines(txt, contentSlotW, fs);
            prefH = lines.Count * Canvas.FontHeight(fs) + app.theme.gapSmall + padV;
            int maxW = 0;
            for (int li = 0; li < lines.Count; li = li + 1) {
                int lw = Canvas.MeasureText(lines[li], fs);
                if (lw > maxW) { maxW = lw; }
            }
            prefW = maxW + padH;
            return;
        }
        prefH = Canvas.FontHeight(fs) + app.theme.gapSmall + padV;
        prefW = Canvas.MeasureText(txt, fs) + padH;
    }

    // 覆写：画文本；wrap 时逐行绘制，否则超宽省略号截断并垂直居中。
    // 原生响应 CSS text-align（left/center/right）与内边距/边框。
    override void OnPaint(App app) {
        StyleBox s = this.ResolvedStyle(app);
        int fs = s.FontOr(Style.FontFallback(app, "medium"));
        string txt = this.Str();
        int padL = s.PadLOr(0) + s.BorderLeftPx();
        int padR = s.PadROr(0) + s.BorderRightPx();
        int padT = s.PadTOr(0) + s.BorderTopPx();
        int padB = s.PadBOr(0) + s.BorderBottomPx();
        if (wrap) {
            int slotW = bw;
            if (slotW <= 0) { slotW = Canvas.MeasureText(txt, fs) + padL + padR; }
            int contentSlotW = slotW - padL - padR;
            if (contentSlotW <= 0) { contentSlotW = slotW; }
            List<string> lines = TextWrap.Lines(txt, contentSlotW, fs);
            int lh = Canvas.FontHeight(fs);
            int n = lines.Count;
            int total = n * lh;
            int ty = by + padT + (bh - padT - padB - total) / 2;
            if (ty < by + padT) { ty = by + padT; }
            for (int li = 0; li < n; li = li + 1) {
                int lw = Canvas.MeasureText(lines[li], fs);
                int lx = bx + padL;
                if (s.align == 1) {
                    lx = bx + padL + (contentSlotW - lw) / 2;
                } else if (s.align == 2) {
                    lx = bx + slotW - padR - lw;
                }
                if (lx < bx + padL) { lx = bx + padL; }
                app.canvas.DrawText(lx, ty, lines[li], s.FgOr(0), fs);
                ty = ty + lh;
            }
            return;
        }
        // 填充型标签宽度等于槽宽而非文本宽，因此
        // 很长的值（如项目路径）也不会溢出容器。
        int avail = bw > 0 ? bw - padL - padR : 0;
        int tw = Canvas.MeasureText(txt, fs);
        if (avail > 0 && tw > avail) {
            txt = Ellipsis.Fit(txt, avail, fs);
            tw = Canvas.MeasureText(txt, fs);
        }
        int tx = bx + padL;
        if (avail > 0) {
            if (s.align == 1) {
                tx = bx + padL + (avail - tw) / 2;
            } else if (s.align == 2) {
                tx = bx + bw - padR - tw;
            }
            if (tx < bx + padL) { tx = bx + padL; }
        }
        int ty0 = Canvas.CenterTextY(by, bh, fs);
        if (bh > 0 && padT + padB > 0) {
            int availH = bh - padT - padB;
            int fh = Canvas.FontHeight(fs);
            ty0 = by + padT + (availH - fh) / 2;
            if (ty0 < by + padT) { ty0 = by + padT; }
        }
        app.canvas.DrawText(tx, ty0, txt, s.FgOr(0), fs);
    }

    // ---- 设计器 / 序列化模型 ----

    // 控件类型标识（序列化/设计器用）。
    override string Kind() { return "Label"; }

    // 覆写：返回设计器属性清单（文本 / 换行 / 类）。
    override List<PropSpec> Props() {
        List<PropSpec> ps = new List<PropSpec>();
        PropSpec text = PropSpec.Text("text", "Text");
        text.str = Text;
        text.AsName();
        ps.Add(text);
        PropSpec w = PropSpec.Bool("wrap", "Wrap");
        w.flag = wrap;
        ps.Add(w);
        return ps;
    }
}
