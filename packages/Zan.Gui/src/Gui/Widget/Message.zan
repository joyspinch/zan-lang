using System;
using Gui;
namespace Gui.Widget;
public class Message {
    public static void Show(string text) { Message.Show(null, text); }
    public static void Show(App app, string text) { Layer.Msg(app, text, 1); }
    public static void Info(string text) { Message.Info(null, text); }
    public static void Info(App app, string text) { Layer.Msg(app, text, 2); }
    public static void Success(string text) { Message.Success(null, text); }
    public static void Success(App app, string text) { Layer.Msg(app, text, 3); }
    public static void Warning(string text) { Message.Warning(null, text); }
    public static void Warning(App app, string text) { Layer.Msg(app, text, 4); }
    public static void Error(string text) { Message.Error(null, text); }
    public static void Error(App app, string text) { Layer.Msg(app, text, 5); }
}
