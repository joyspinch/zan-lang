using System;
using Gui;

namespace Gui.Widget;

// 现代全局轻提示门面：对齐 Naive UI message / Element Plus ElMessage。
// 无需手工挂载容器节点，支持全局随时弹出顶部居中自收拢 Toast 提示。
public class Message {
    public static void Show(string text) {
        Message.Show(null, text);
    }
    public static void Show(App app, string text) {
        Layer.Msg(app, text, 1);
    }

    public static void Info(string text) {
        Message.Info(null, text);
    }
    public static void Info(App app, string text) {
        Layer.Msg(app, text, 2);
    }

    public static void Success(string text) {
        Message.Success(null, text);
    }
    public static void Success(App app, string text) {
        Layer.Msg(app, text, 3);
    }

    public static void Warning(string text) {
        Message.Warning(null, text);
    }
    public static void Warning(App app, string text) {
        Layer.Msg(app, text, 4);
    }

    public static void Error(string text) {
        Message.Error(null, text);
    }
    public static void Error(App app, string text) {
        Layer.Msg(app, text, 5);
    }
}
