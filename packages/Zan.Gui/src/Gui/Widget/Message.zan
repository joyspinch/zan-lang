using System;
using Gui;

namespace Gui.Widget;

// 现代全局轻提示门面：对齐 Naive UI message / Element Plus ElMessage。
// 无需手工挂载容器节点，支持全局随时弹出顶部居中自收拢 Toast 提示。
public class Message {
    static void Show(string text) {
        Layer.Msg(text, 1);
    }

    static void Info(string text) {
        Layer.Msg(text, 2);
    }

    static void Success(string text) {
        Layer.Msg(text, 3);
    }

    static void Warning(string text) {
        Layer.Msg(text, 4);
    }

    static void Error(string text) {
        Layer.Msg(text, 5);
    }
}
