using System;
using Gui;

namespace Gui.Widget;

// 移动端多形态折叠主从自适应容器：
// 一套代码无缝支持：
// 1. 单屏合拢态（<600px）：自动降级为单页导航栈（Master ↔ Detail 状态保留与回退）；
// 2. 双屏展开态（600px~999px）：自动升级为双栏主从看板（Master 列表 | Detail 详情）；
// 3. 三折叠完全展开态（>=1000px，如华为 Mate XT）：自动升华为三栏全景看板（Nav 导航 | Master 列表 | Detail 详情）。
public class FoldMasterDetail : Control {
    private Panel navPane;
    private Panel masterPane;
    private Panel detailPane;

    private int navWidth;
    private int masterWidth;
    // 单屏态时的活动页面：0 = Master, 1 = Detail
    private int activePage;

    public FoldMasterDetail() {
        this.InitControl("fold_master_detail", 5);
        navPane = SplitPanel.NewPane("nav");
        masterPane = SplitPanel.NewPane("master");
        detailPane = SplitPanel.NewPane("detail");
        this.Add(navPane);
        this.Add(masterPane);
        this.Add(detailPane);

        navWidth = 220;
        masterWidth = 340;
        activePage = 0;
    }

    public Panel Nav()    { return navPane; }
    public Panel Master() { return masterPane; }
    public Panel Detail() { return detailPane; }

    public FoldMasterDetail WithNavWidth(int w) {
        if (w > 0) { navWidth = w; }
        return this;
    }

    public FoldMasterDetail WithMasterWidth(int w) {
        if (w > 0) { masterWidth = w; }
        return this;
    }

    // 单屏模式下的页面导航状态切换（不丢失窗格内已输入的表单数据）
    public void ShowMaster() {
        activePage = 0;
    }

    public void ShowDetail() {
        activePage = 1;
    }

    public int ActivePage() {
        return activePage;
    }

    public override void OnMeasure(App app) {
        if (prefSet) { return; }
        prefW = 0;
        prefH = 0;
    }

    public override void Arrange(int px, int py, int pw, int ph) {
        if (pw < 0) { pw = 0; }
        if (ph < 0) { ph = 0; }
        bx = px;
        by = py;
        bw = pw;
        bh = ph;

        if (pw >= 1000) {
            // 三折叠展开态或 PC 宽屏：三栏并排全景
            int nw = navWidth;
            if (nw > pw / 3) { nw = pw / 3; }

            int mw = masterWidth;
            if (mw > (pw - nw) / 2) { mw = (pw - nw) / 2; }

            int dw = pw - nw - mw;
            if (dw < 0) { dw = 0; }

            navPane.Arrange(px, py, nw, ph);
            masterPane.Arrange(px + nw, py, mw, ph);
            detailPane.Arrange(px + nw + mw, py, dw, ph);
        } else if (pw >= 600) {
            // 双屏阔折展开态：双栏主从并排（导航栏隐入侧滑抽屉或隐藏）
            navPane.Arrange(px, py, 0, 0);

            int mw = masterWidth;
            if (mw > pw / 2) { mw = pw / 2; }

            int dw = pw - mw;
            if (dw < 0) { dw = 0; }

            masterPane.Arrange(px, py, mw, ph);
            detailPane.Arrange(px + mw, py, dw, ph);
        } else {
            // 单屏合拢态：单列栈导航展示
            navPane.Arrange(px, py, 0, 0);

            if (activePage == 1) {
                masterPane.Arrange(px, py, 0, 0);
                detailPane.Arrange(px, py, pw, ph);
            } else {
                masterPane.Arrange(px, py, pw, ph);
                detailPane.Arrange(px, py, 0, 0);
            }
        }
    }
}
