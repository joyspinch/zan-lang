using System;
using Gui;
namespace Gui.Widget;
public class Tooltip {
    public static int FontSize() { return Tooltip.FontSize(null); }
    public static int FontSize(App app) {
        if (app == null) { app = App.Current; }
        if (app == null) { return 12; }
        StyleBox s = Style.Of(app, "tooltip", "", Style.SNormal());
        return s.FontOr(Style.FontFallback(app, "small"));
    }
    public static int Top() { return 0; }
    public static int Bottom() { return 1; }
    public static int Left() { return 2; }
    public static int Right() { return 3; }
    public static void TriDown(Canvas c, int cx, int topY, int half, int h, int color) {
        for (int r = 0; r < h; r = r + 1) {
            int hw = half - half * r / h;
            if (hw < 1) { hw = 1; }
            c.FillRect(cx - hw, topY + r, hw * 2, 1, color);
        }
    }
    public static void TriUp(Canvas c, int cx, int topY, int half, int h, int color) {
        for (int r = 0; r < h; r = r + 1) {
            int hw = half * r / h;
            if (hw < 1) { hw = 1; }
            c.FillRect(cx - hw, topY + r, hw * 2, 1, color);
        }
    }
    public static void TriLeft(Canvas c, int leftX, int cy, int half, int w, int color) {
        for (int r = 0; r < w; r = r + 1) {
            int hh = half * r / w;
            if (hh < 1) { hh = 1; }
            c.FillRect(leftX + r, cy - hh, 1, hh * 2, color);
        }
    }
    public static void TriRight(Canvas c, int leftX, int cy, int half, int w, int color) {
        for (int r = 0; r < w; r = r + 1) {
            int hh = half - half * r / w;
            if (hh < 1) { hh = 1; }
            c.FillRect(leftX + r, cy - hh, 1, hh * 2, color);
        }
    }
    public static List<string> WrapLines(string text, int fs, int maxW) {
        List<string> lines = new List<string>();
        if (text == null) { lines.Add(""); return lines; }
        if (maxW <= 0) { lines.Add(text); return lines; }
        int n = text.Length;
        string cur = "";
        string word = "";
        for (int i = 0; i <= n; i = i + 1) {
            string ch = "";
            if (i < n) { ch = text.Substring(i, 1); }
            if (i == n || ch == " " || ch == "\n") {
                string cand = cur;
                if (cur == "") { cand = word; } else { cand = cur + " " + word; }
                if (Canvas.MeasureText(cand, fs) <= maxW) {
                    cur = cand;
                } else {
                    if (cur != "") { lines.Add(cur); }
                    while (Canvas.MeasureText(word, fs) > maxW && word.Length > 1) {
                        int lo = 0;
                        int hi = word.Length;
                        while (lo < hi) {
                            int mid = Text.ClampCharStart(word, hi - (hi - lo) / 2);
                            if (mid == lo) { mid = Text.NextCharEnd(word, lo); }
                            if (Canvas.MeasureText(Text.Left(word, mid), fs) <= maxW) { lo = mid; }
                            else { hi = Text.PrevCharStart(word, mid); }
                        }
                        int split = lo;
                        if (split <= 0) { split = Text.NextCharEnd(word, 0); }
                        if (split <= 0) { split = 1; }
                        if (split > word.Length) { split = word.Length; }
                        lines.Add(word.Substring(0, split));
                        word = word.Substring(split, word.Length - split);
                    }
                    cur = word;
                }
                word = "";
                if (ch == "\n") { lines.Add(cur); cur = ""; }
            } else {
                word = word + ch;
            }
        }
        if (cur != "") { lines.Add(cur); }
        if (lines.Count == 0) { lines.Add(""); }
        return lines;
    }
    public static int TipCapH() { return Tooltip.TipCapH(null); }
    public static int TipCapH(App app) {
        if (app == null) { app = App.Current; }
        if (app == null) { return 148; }
        return app.Scale(148);
    }
    public static Rect BoxRect(int anchorX, int anchorY, string text,
                        int placement, int maxW) {
        return Tooltip.BoxRect(null, anchorX, anchorY, text, placement, maxW);
    }
    public static Rect BoxRect(App app, int anchorX, int anchorY, string text,
                        int placement, int maxW) {
        if (app == null) { app = App.Current; }
        if (app == null) { return new Rect(anchorX, anchorY, 0, 0); }
        Canvas c = app.canvas;
        Theme t = app.theme;
        int fs = Tooltip.FontSize(app);
        int pad = app.Scale(8);
        int lineH = Canvas.FontHeight(fs);
        int notch = app.Scale(6);
        int gap = app.Scale(6);
        int margin = app.Scale(4);
        List<string> lines = Tooltip.WrapLines(text, fs, maxW);
        int textW = 0;
        for (int li = 0; li < lines.Count; li = li + 1) {
            int lw = Canvas.MeasureText(lines[li], fs);
            if (lw > textW) { textW = lw; }
        }
        int boxW = textW + pad * 2;
        int fullH = lines.Count * lineH + pad * 2;
        int maxBoxH = Tooltip.TipCapH(app);
        int boxH = fullH;
        if (boxH > maxBoxH) { boxH = maxBoxH; }
        int top = app.titlebarH;
        int cw = c.Width();
        int chh = c.Height();
        int bx = 0;
        int by = 0;
        int place = placement;
        if (place == 0) {
            if (anchorY - gap - notch - boxH < top) { place = 1; }
        } else if (place == 1) {
            if (anchorY + gap + notch + boxH > chh - margin) { place = 0; }
        } else if (place == 2) {
            if (anchorX - gap - notch - boxW < margin) { place = 3; }
        } else if (place == 3) {
            if (anchorX + gap + notch + boxW > cw - margin) { place = 2; }
        }
        if (place == 0) {
            bx = anchorX - boxW / 2;
            by = anchorY - gap - notch - boxH;
        } else if (place == 1) {
            bx = anchorX - boxW / 2;
            by = anchorY + gap + notch;
        } else if (place == 2) {
            bx = anchorX - gap - notch - boxW;
            by = anchorY - boxH / 2;
        } else {
            bx = anchorX + gap + notch;
            by = anchorY - boxH / 2;
        }
        if (bx < margin) { bx = margin; }
        if (bx + boxW > cw - margin) { bx = cw - margin - boxW; }
        if (by < top) { by = top; }
        if (by + boxH > chh - margin) { by = chh - margin - boxH; }
        return new Rect(bx, by, boxW, boxH);
    }
    public static int MaxScroll(string text, int maxW) { return Tooltip.MaxScroll(null, text, maxW); }
    public static int MaxScroll(App app, string text, int maxW) {
        if (app == null) { app = App.Current; }
        if (app == null) { return 0; }
        int fs = Tooltip.FontSize(app);
        int pad = app.Scale(8);
        int lineH = Canvas.FontHeight(fs);
        List<string> lines = Tooltip.WrapLines(text, fs, maxW);
        int fullH = lines.Count * lineH + pad * 2;
        int m = fullH - Tooltip.TipCapH(app);
        if (m < 0) { m = 0; }
        return m;
    }
    public static void RenderScroll(App app, int anchorX, int anchorY, string text,
                             int placement, int maxW, int scrollOff) {
        Canvas c = app.canvas;
        Theme t = app.theme;
        int fs = Tooltip.FontSize(app);
        int pad = app.Scale(8);
        int lineH = Canvas.FontHeight(fs);
        int notch = app.Scale(6);
        List<string> lines = Tooltip.WrapLines(text, fs, maxW);
        int fullH = lines.Count * lineH + pad * 2;
        Rect box = Tooltip.BoxRect(app, anchorX, anchorY, text, placement, maxW);
        int bx = box.x;
        int by = box.y;
        int boxW = box.width;
        int boxH = box.height;
        bool scroll = fullH > boxH;
        int place = placement;
        if (by + boxH <= anchorY) { place = 0; }
        else if (by >= anchorY) { place = 1; }
        else if (bx + boxW <= anchorX) { place = 2; }
        else { place = 3; }
        int off = scrollOff;
        int maxOff = fullH - boxH;
        if (maxOff < 0) { maxOff = 0; }
        if (off > maxOff) { off = maxOff; }
        if (off < 0) { off = 0; }
        StyleBox s = Style.Of(app, "tooltip", "", Style.SNormal());
        int bg = s.BgOr(0);
        int border = s.BorderOr(0);
        int fg = s.FgOr(0);
        if (s.shadow != 0) {
            c.FillRoundRect(bx + s.shadowDx, by + s.shadowDy, boxW, boxH,
                            s.RadiusOr(t.borderRadiusSmall), s.shadow);
        }
        c.SurfaceRoundRect(bx, by, boxW, boxH, s.RadiusOr(t.borderRadiusSmall),
                           bg, border, s.BorderWOr(1));
        NativeLayer.Occlude(app, bx, by, boxW, boxH);
        int cx = anchorX;
        if (cx < bx + notch + 2) { cx = bx + notch + 2; }
        if (cx > bx + boxW - notch - 2) { cx = bx + boxW - notch - 2; }
        int cy = anchorY;
        if (cy < by + notch + 2) { cy = by + notch + 2; }
        if (cy > by + boxH - notch - 2) { cy = by + boxH - notch - 2; }
        if (place == 0) {
            Tooltip.TriDown(c, cx, by + boxH - 1, notch + 1, notch + 1, border);
            Tooltip.TriDown(c, cx, by + boxH - 1, notch, notch, bg);
        } else if (place == 1) {
            Tooltip.TriUp(c, cx, by - notch, notch + 1, notch + 1, border);
            Tooltip.TriUp(c, cx, by - notch + 1, notch, notch, bg);
        } else if (place == 2) {
            Tooltip.TriRight(c, bx + boxW - 1, cy, notch + 1, notch + 1, border);
            Tooltip.TriRight(c, bx + boxW - 1, cy, notch, notch, bg);
        } else {
            Tooltip.TriLeft(c, bx - notch, cy, notch + 1, notch + 1, border);
            Tooltip.TriLeft(c, bx - notch + 1, cy, notch, notch, bg);
        }
        int innerX = bx + pad;
        int innerY = by + pad;
        int innerW = boxW - pad * 2;
        int innerH = boxH - pad * 2;
        c.PushClip(innerX, innerY, innerW, innerH);
        int ty = innerY - off;
        for (int li = 0; li < lines.Count; li = li + 1) {
            c.DrawText(innerX, ty, lines[li], fg, fs);
            ty = ty + lineH;
        }
        c.PopClip();
        if (scroll) {
            int barW = app.Scale(3);
            int barX = bx + boxW - barW - app.Scale(3);
            int barY = by + pad;
            int barH = boxH - pad * 2;
            int thumbH = barH * innerH / (fullH - pad * 2);
            if (thumbH < app.Scale(16)) { thumbH = app.Scale(16); }
            int travel = barH - thumbH;
            int thumbY = barY;
            if (maxOff > 0) { thumbY = barY + travel * off / maxOff; }
            StyleBox trackStyle = Style.Part(app, "tooltip", "scrollbar-track",
                                             "", "", "", Style.SNormal());
            StyleBox thumbStyle = Style.Part(app, "tooltip", "scrollbar", "",
                                             "", "", Style.SNormal());
            c.FillRoundRect(barX, barY, barW, barH, barW / 2, trackStyle.bg);
            c.FillRoundRect(barX, thumbY, barW, thumbH, barW / 2, thumbStyle.bg);
        }
    }
    public static void RenderAt(App app, int anchorX, int anchorY, string text,
                         int placement, int maxW) {
        Tooltip.RenderScroll(app, anchorX, anchorY, text, placement, maxW, 0);
    }
    public static void RenderBox(App app, int x, int y, int w, int h, string text,
                          int placement, int maxW) {
        int ax = x + w / 2;
        int ay = y + h / 2;
        if (placement == 0) { ay = y; }
        else if (placement == 1) { ay = y + h; }
        else if (placement == 2) { ax = x; }
        else { ax = x + w; }
        Tooltip.RenderScroll(app, ax, ay, text, placement, maxW, 0);
    }
    public static void RequestBox(App app, int x, int y, int w, int h, string text,
                           int placement, int maxW) {
        int ax = x + w / 2;
        int ay = y + h / 2;
        if (placement == 0) { ay = y; }
        else if (placement == 1) { ay = y + h; }
        else if (placement == 2) { ax = x; }
        else { ax = x + w; }
        Tooltip.Request(app, ax, ay, text, placement, maxW);
    }
    public static void RenderRich(App app, int x, int y, string title, string desc) {
        Canvas c = app.canvas;
        Theme t = app.theme;
        int fs = Tooltip.FontSize(app);
        int pad = app.Scale(8);
        int lh = Canvas.FontHeight(fs);
        int tw = Canvas.MeasureText(desc, fs);
        int titleW = Canvas.MeasureText(title, fs);
        if (titleW > tw) { tw = titleW; }
        int boxW = tw + pad * 2;
        int boxH = lh * 2 + app.Scale(4) + pad * 2;
        int margin = app.Scale(4);
        if (x + boxW > c.Width() - margin) { x = c.Width() - margin - boxW; }
        if (x < margin) { x = margin; }
        if (y + boxH > c.Height() - margin) { y = c.Height() - margin - boxH; }
        if (y < app.titlebarH) { y = app.titlebarH; }
        StyleBox s = Style.Of(app, "tooltip", "", Style.SNormal());
        int bg = s.BgOr(0);
        int border = s.BorderOr(0);
        int fg = s.FgOr(0);
        int titleColor = Style.Part(app, "tooltip", "title", "", "", "",
                                    Style.SNormal()).FgOr(fg);
        int descColor = Style.Part(app, "tooltip", "desc", "", "", "",
                                   Style.SNormal()).FgOr(fg);
        if (s.shadow != 0) {
            c.FillRoundRect(x + s.shadowDx, y + s.shadowDy, boxW, boxH,
                            s.RadiusOr(t.borderRadiusSmall), s.shadow);
        }
        c.SurfaceRoundRect(x, y, boxW, boxH, s.RadiusOr(t.borderRadiusSmall),
                           bg, border, s.BorderWOr(1));
        c.DrawText(x + pad, y + pad, title, titleColor, fs);
        c.DrawText(x + pad, y + pad + lh + app.Scale(4), desc, descColor, fs);
    }
    public static void Request(App app, int anchorX, int anchorY, string text, int placement,
                        int maxW) {
        if (text == null || text == "") { return; }
        if (app == null) { app = App.FrameApp(); }
        if (app != null) {
            app.tooltipText = text;
            app.tooltipX = anchorX;
            app.tooltipY = anchorY;
            app.tooltipPlace = placement;
            app.tooltipMaxW = maxW;
        }
    }
    public static void Request(int anchorX, int anchorY, string text, int placement,
                        int maxW) {
        Tooltip.Request(null, anchorX, anchorY, text, placement, maxW);
    }
    public static int DefaultDelayMs() { return 500; }
    public static void Cancel(App app) {
        if (app == null) { app = App.FrameApp(); }
        if (app != null) { app.tooltipText = ""; }
    }
    public static void Cancel() { Tooltip.Cancel(null); }
    public static TooltipRequest Suspend(App app) {
        if (app == null) { app = App.FrameApp(); }
        TooltipRequest state = new TooltipRequest();
        if (app != null && app.tooltipText != null && app.tooltipText != "") {
            state.text = app.tooltipText;
            state.x = app.tooltipX;
            state.y = app.tooltipY;
            state.placement = app.tooltipPlace;
            state.width = app.tooltipMaxW;
            app.tooltipText = "";
        } else {
            state.text = "";
            state.x = 0;
            state.y = 0;
            state.placement = 0;
            state.width = 0;
        }
        return state;
    }
    public static TooltipRequest Suspend() { return Tooltip.Suspend(null); }
    public static void Restore(App app, TooltipRequest state) {
        if (state == null) { return; }
        if (app == null) { app = App.FrameApp(); }
        if (app != null) {
            app.tooltipText = state.text;
            app.tooltipX = state.x;
            app.tooltipY = state.y;
            app.tooltipPlace = state.placement;
            app.tooltipMaxW = state.width;
        }
    }
    public static void Restore(TooltipRequest state) { Tooltip.Restore(null, state); }
    public static void Flush() { Tooltip.Flush(null); }
    public static void Flush(App app) {
        if (app == null) { app = App.FrameApp(); }
        if (app == null) { return; }
        string txt = app.tooltipText;
        if (txt == null || txt == "") { return; }
        int px = app.tooltipX;
        int py = app.tooltipY;
        int place = app.tooltipPlace;
        int mw = app.tooltipMaxW;
        Tooltip.RenderAt(app, px, py, txt, place, mw);
        app.tooltipText = "";
    }
}
