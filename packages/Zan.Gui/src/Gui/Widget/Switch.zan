using System;
using Gui;
using Gui.Backend;

namespace Gui.Widget;

// 开关，支持响应式 bool 绑定。
// C# 风格保留式实例：
// dark.Change += () => { ... };
// dark.Render(app, x, y);
// 为现有调用方保留旧版立即模式静态方法。
// 增强能力（对位 Ant Design Switch 文档演示）：
// - 内嵌文字/图标：`CheckedText` / `UncheckedText` / `CheckedIcon` /
// `UncheckedIcon`，有内容时轨道自动加宽；
// - 形状：`Round = false` 得方形轨道 + 圆角方形拇指；
// - 加载中：`Loading = true` 时拇指上叠画弧线 spinner、轨道变暗，
// 且点击/键盘不再切换；
// - 自定义颜色：`CheckedColor` / `UncheckedColor`（0 = 跟随皮肤）；
// - 自定义选中值：`CheckedValue` / `UncheckedValue` + int 辅值绑定轴
// `dataValue`（`sw.dataValue = form.status;`），开关表达
// 「值 == 选中值」。轴优先级：`dataValue`(int) > `data`(bool)。
// 绑定通道（规范 §6）：外部通道 `data`(bool 主值) 与 `dataValue`
// (int 辅值，配 CheckedValue/UncheckedValue 映射)；`onSig` 是内部
// 开关状态缓冲（SignalBool，§6.2），不是绑定协议。
public class Switch : ToggleControl {
    // 兼容别名属性
    public int wid { get { return this.WidgetId(); } set { this.commonId = value; } }

    // 加载中：轨道变暗 + 拇指叠画旋转弧线，且不再响应点击。
    public bool Loading;
    // 圆角轨道 + 圆形 thumb；false 得方形（小圆角）形状。
    public bool Round;
    // 选中/未选中时轨道内嵌文字（空 = 无）；有内容时轨道自动加宽。
    public Binding<string> CheckedText;
    public Binding<string> UncheckedText;
    // 选中/未选中时轨道内嵌图标（Icon.zan glyph 名，空 = 无）。
    public Binding<string> CheckedIcon;
    public Binding<string> UncheckedIcon;
    // 自定义轨道色（Progress fillColor 同款约定：0 = 跟随皮肤）。
    public int CheckedColor;
    public int UncheckedColor;
    // int 轴的选中值/未选中值（默认 1/0，即等价于 bool）。
    public int CheckedValue;
    public int UncheckedValue;

    public Control trackNode;
    public Control thumbNode;

    public override int StyleDisplay() { return 1; } // CSS display: flex
    public override int StyleFlexDir() { return 0; } // flex-direction: row

    // 公共初始化（构造共用）。
    private void InitSwitch(SignalBool m) {
        this.InitToggle("switch");
        if (m != null) { this.onSig = m; }
        Loading = false;
        Round = true;
        CheckedText = "";
        wiresOwnEvents = true;
        Change = new UiEvent();
        Size = "medium";
        UncheckedText = "";
        CheckedIcon = "";
        UncheckedIcon = "";
        CheckedColor = 0;
        UncheckedColor = 0;
        CheckedValue = 1;
        UncheckedValue = 0;
        this.ClassName = "switch align-center";
        trackNode = new Control("switch-track");
        trackNode.ClassName = "switch-track align-center";
        thumbNode = new Control("switch-thumb");
        thumbNode.ClassName = "switch-thumb";
        trackNode.Add(thumbNode);
        this.Add(trackNode);
    }

    // 保留式构造器：`Switch dark = new Switch();`
    public Switch() {
        InitSwitch(false);
    }

    // int 辅值轴是否激活（激活时优先于 bool 轴）。
    public bool HasValueAxis() { return dataValue != null; }

    // 读 int 辅值。
    private int IntGet() {
        return dataValue.Get();
    }

    // 写 int 辅值。
    private void IntSet(int v) {
        dataValue.Set(v);
    }

    // 当前是否处于选中态：int 轴激活时按「值 == CheckedValue」判定，
    // 否则读内部信号缓冲。
    public bool IsOn() {
        if (HasValueAxis()) { return IntGet() == CheckedValue; }
        return onSig.Get();
    }

    // 程序化设置开关状态。int 轴激活时写入 CheckedValue/UncheckedValue，
    // bool 轴激活时同步 `data` 绑定；均同步内部信号缓冲。
    // 不触发 Change 事件（用户交互才触发）。
    public override void SetChecked(bool v) {
        if (HasValueAxis()) {
            if (v) { IntSet(CheckedValue); } else { IntSet(UncheckedValue); }
            if (onSig != null) { onSig.Set(v); }
            return;
        }
        base.SetChecked(v);
    }

    public void SetOn(bool v) {
        this.SetChecked(v);
    }

    // 覆写：公共事件之外提供 "Change" 与 "Toggle"。
    public override List<string> Events() {
        List<string> e = Control.CommonEvents();
        e.Add("Change");
        e.Add("Toggle");
        return e;
    }

    // 控件类型标识（序列化/设计器用）。
    public override string Kind() { return "Switch"; }
    // 覆写：返回 Size 绑定字段（设计器经它发现尺寸档位绑定）。
    public override Binding<string> SizeOf() { return Size; }

    // 覆写：返回设计器属性清单（值 / 尺寸档 / 加载 / 形状 / 内嵌文字图标 / 自定义色与值）。
    public override List<PropSpec> Props() {
        List<PropSpec> ps = new List<PropSpec>();
        PropSpec on = PropSpec.Bool("value", "On");
        // 属性通道优先指向活的外部绑定（§6.1 单协议）：
        // data 轴激活时读写直达模型字段，否则落到内部缓冲。
        if (data != null) { on.flag = data; } else { on.sflag = onSig; }
        on.Also("checked");
        on.Also("on");
        ps.Add(on);
        PropSpec defOn = PropSpec.Bool("defOn", "Default on");
        if (data != null) { defOn.flag = data; } else { defOn.sflag = onSig; }
        defOn.WithTip("Design default-on: FormBuilder/Designer mount projects "
                      + "it as a SetProp, so the switch starts on.");
        ps.Add(defOn);
        PropSpec sz = PropSpec.Enum("size", "Size",
            PropSpec.Sizes());
        sz.str = Size;
        ps.Add(sz);
        PropSpec ld = PropSpec.Bool("loading", "Loading");
        ld.flag = Loading;
        ps.Add(ld);
        PropSpec rd = PropSpec.Bool("round", "Round");
        rd.flag = Round;
        ps.Add(rd);
        PropSpec ct = PropSpec.Text("checkedText", "Checked text");
        ct.str = CheckedText;
        ct.WithTip("Inner text shown while on (Ant Design children); the track widens to fit. Empty = none.");
        ps.Add(ct);
        PropSpec ut = PropSpec.Text("uncheckedText", "Unchecked text");
        ut.str = UncheckedText;
        ut.WithTip("Inner text shown while off; the track widens to fit. Empty = none.");
        ps.Add(ut);
        PropSpec ci = PropSpec.Text("checkedIcon", "Checked icon");
        ci.str = CheckedIcon;
        ci.WithTip("Inner icon (glyph name) shown while on. Empty = none.");
        ps.Add(ci);
        PropSpec ui = PropSpec.Text("uncheckedIcon", "Unchecked icon");
        ui.str = UncheckedIcon;
        ui.WithTip("Inner icon (glyph name) shown while off. Empty = none.");
        ps.Add(ui);
        PropSpec cc = PropSpec.Color("checkedColor", "Checked color");
        cc.num = CheckedColor;
        cc.WithTip("Custom track colour while on. 0 = skin.");
        ps.Add(cc);
        PropSpec uc = PropSpec.Color("uncheckedColor", "Unchecked color");
        uc.num = UncheckedColor;
        uc.WithTip("Custom track colour while off. 0 = skin.");
        ps.Add(uc);
        PropSpec cv = PropSpec.Int("checkedValue", "Checked value");
        cv.num = CheckedValue;
        cv.WithTip("Value stored in the int `dataValue` binding while on.");
        ps.Add(cv);
        PropSpec uv = PropSpec.Int("uncheckedValue", "Unchecked value");
        uv.num = UncheckedValue;
        uv.WithTip("Value stored in the int `dataValue` binding while off.");
        ps.Add(uv);
        return ps;
    }

    // 覆写："Change"/"Toggle" 都挂 Change 事件，其余按名称走通用路由。
    public override void BindEvent(string evt, Action a) {
        if (evt == "Change" || evt == "Toggle") { Change.Add(a); return; }
        On.AddByName(evt, a);
    }

    // <see cref="BindEvent"/> 的 sender 通道（S = Sender）：
    // 特化事件接本控件的 UiEvent，通用事件按名路由。
    public override void BindEventS(string evt, ControlEvent a) {
        if (evt == "Change" || evt == "Toggle") { Change.AddS(a); return; }
        On.AddByNameS(evt, a);
    }

    public override void TriggerEvent(string evt) {
        if (evt == "Change" || evt == "Toggle") { Change.Raise(); return; }
        base.TriggerEvent(evt);
    }


    // int 轴激活时，"value" 键的读写改走值语义（其余仍走基类
    // PropSpec 路径）。写 "true" 落 CheckedValue、"false" 落 UncheckedValue。
    // 覆写：int 轴激活时 "value" 键按值语义应答，其余交给基类。
    public override string GetProp(string key) {
        if (key == "value" && HasValueAxis()) {
            return PropSpec.Flag(IsOn());
        }
        return base.GetProp(key);
    }

    // 覆写：int 轴激活时 "value" 键按选中值语义写入，其余交给基类。
    public override void SetProp(string key, string val) {
        if (key == "value" && HasValueAxis()) {
            SetOn(PropSpec.IsOn(val));
            return;
        }
        base.SetProp(key, val);
    }

    public override void SyncBinding() {
        base.SyncBinding();
        // 将绑定的模型值拉入本地信号（model -> UI）。
        if (HasValueAxis()) {
            bool axisOn = IntGet() == CheckedValue;
            if (axisOn != onSig.Get()) { onSig.Set(axisOn); }
        } else if (data != null) {
            bool cur = data.Get();
            if (cur != onSig.Get()) { onSig.Set(cur); }
        }
        bool on = onSig != null && onSig.Get();
        if (on) {
            this.AddClass("on");
            this.RemoveClass("off");
            if (trackNode != null) {
                trackNode.AddClass("justify-end");
                trackNode.RemoveClass("justify-start");
            }
        } else {
            this.AddClass("off");
            this.RemoveClass("on");
            if (trackNode != null) {
                trackNode.AddClass("justify-start");
                trackNode.RemoveClass("justify-end");
            }
        }
    }

    public override void OnClick(RoutedEventArgs e) {
        if (this.IsDisabled() || Loading) { return; }
        base.OnClick(e);
    }

    public override void OnKeyDown(RoutedEventArgs e) {
        if (this.IsDisabled() || Loading) { return; }
        base.OnKeyDown(e);
    }

    // 覆写：保留模式绘制——基于自身盒模型与通用 CommonId 完成事件交互。
    public override void OnPaint(App app) {
        int id = this.CommonId();
        SyncBinding();
        app.focus.RegisterFocusable(id);
        string a11y = this.EffectiveA11yRole("switch") + ":" + this.EffectiveA11yLabel(name);
        app.hitTester.RegisterRectL(id, bx, by, bw, bh, 0, a11y);
        On.Fire(app, id, this);
    }
}
