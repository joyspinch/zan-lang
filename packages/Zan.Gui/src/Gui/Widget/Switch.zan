using System;
using Gui;
using Gui.Backend;
namespace Gui.Widget;
public class Switch : ToggleControl {
    public override Control CreateCloneShell() { return new Switch(); }
    public int wid { get { return this.WidgetId(); } set { this.commonId = value; } }
    public bool Loading;
    public bool Round;
    public Binding<string> CheckedText;
    public Binding<string> UncheckedText;
    public Binding<string> CheckedIcon;
    public Binding<string> UncheckedIcon;
    public int CheckedColor;
    public int UncheckedColor;
    public Control trackNode;
    public Control thumbNode;
    public override int StyleDisplay() { return 1; } // CSS display: flex
    public override int StyleFlexDir() { return 0; } // flex-direction: row
    private void InitSwitch() {
        this.InitToggle("switch");
        Loading = false;
        Round = true;
        CheckedText = "";
        UncheckedText = "";
        CheckedIcon = "";
        UncheckedIcon = "";
        CheckedColor = 0;
        UncheckedColor = 0;
        this.ClassName = "switch align-center";
        trackNode = new SwitchTrack(this);
        thumbNode = new SwitchThumb(this);
        trackNode.Add(thumbNode);
        this.Add(trackNode);
    }
    public Switch() { InitSwitch(); }
    public bool IsOn() { return Checked.Get(); }
    public void SetOn(bool v) {
        this.SetChecked(v);
    }

    // 控件类型标识（序列化/设计器用）。
    public override void CloneContentTo(Control target, CloneTreeFn clone) {
    }
    // 覆写：返回设计器属性清单（值 / 尺寸档 / 加载 / 形状 / 内嵌文字图标 / 自定义色）。
    // 键与标签由字段名派生，见 PropSpec.*Field。
    protected override List<PropSpec> DefineProps() {
        return new List<PropSpec>{
            PropSpec.Bool("value", "On").Field("Checked").DefaultBinding()
                .Also("checked").Also("on").Also("data"),
            PropSpec.Bool("defOn", "Default on").Field("Checked")
                .WithTip("Design default-on: FormBuilder/Designer mount projects "
                         + "it as a SetProp, so the switch starts on."),
            this.SizeProp(),
            PropSpec.BoolField("Loading"),
            PropSpec.BoolField("Round"),
            PropSpec.TextField("CheckedText")
                .WithTip("Inner text shown while on (Ant Design children); the track widens to fit. Empty = none."),
            PropSpec.TextField("UncheckedText")
                .WithTip("Inner text shown while off; the track widens to fit. Empty = none."),
            PropSpec.TextField("CheckedIcon").WithTip("Inner icon (glyph name) shown while on. Empty = none."),
            PropSpec.TextField("UncheckedIcon").WithTip("Inner icon (glyph name) shown while off. Empty = none."),
            PropSpec.ColorField("CheckedColor").WithTip("Custom track colour while on. 0 = skin."),
            PropSpec.ColorField("UncheckedColor").WithTip("Custom track colour while off. 0 = skin.")
        };
    }

    public override void SyncBinding() {
        base.SyncBinding();
        this.ApplySizeClass();
        bool on = Checked.Get();
        if (on) {
            this.AddClass("on");
            this.RemoveClass("off");
        } else {
            this.AddClass("off");
            this.RemoveClass("on");
        }
        if (!Round) { this.AddClass("round-off"); } else { this.RemoveClass("round-off"); }
        if (Loading) { this.AddClass("loading"); } else { this.RemoveClass("loading"); }
        if (trackNode != null) {
            trackNode.AddClass(on ? "justify-end" : "justify-start");
            trackNode.RemoveClass(on ? "justify-start" : "justify-end");
            int customBg = on ? CheckedColor : UncheckedColor;
            string wantCss = customBg != 0 ? ("background: #" + Style.Hex8(customBg) + ";") : "";
            string ct = CheckedText.Get();
            string ut = UncheckedText.Get();
            string ci = CheckedIcon.Get();
            string ui = UncheckedIcon.Get();
            if (ct != "" || ut != "" || ci != "" || ui != "") {
                App app = this.FindApp();
                int fs = app != null ? Style.FontFallback(app, "tiny") : 12;
                int tw = Math.Max(ct != "" ? Canvas.MeasureText(ct, fs) : 0,
                                  ut != "" ? Canvas.MeasureText(ut, fs) : 0);
                if (app != null && app.dpiScale > 100) {
                    tw = (tw * 100 + app.dpiScale / 2) / app.dpiScale;
                }
                int iw = (ci != "" || ui != "") ? 14 : 0;
                int needW = Math.Max(48, 20 + Math.Max(tw, iw) + 12);
                wantCss = wantCss + " width: " + Convert.ToString(needW) + ";";
            }
            if (trackNode.InlineStyleCss() != wantCss) { trackNode.SetInlineStyleCss(wantCss); }
            if (trackNode is SwitchTrack) { ((SwitchTrack)trackNode).SetOnState(on); }
        }
    }
    public override void OnClick(RoutedEventArgs e) {
        if (this.IsDisabled() || Loading) { return; }
        base.OnClick(e);
    }
    public override void OnKeyDown(RoutedEventArgs e) {
        if (this.IsDisabled() || Loading) { return; }
        base.OnKeyDown(e);
    }
    public override int InputFocusCapabilities() { return 1; }
}
class SwitchTrack : Control {
    private weak Switch owner;
    SwitchTrack(Switch toggle) : base("switch-track") {
        owner = toggle;
        this.ClassName = "switch-track align-center";
    }
    protected override Control SurfaceInputOwner() { return owner; }
    internal void SetOnState(bool on) { this.SetSurfaceTransitionKey(on ? 2 : 1); }
    internal StyleBox TrackStyle() { return computedStyle; }
    internal int SpinnerColor() {
        StyleBox style = paintedStyle != null ? paintedStyle : computedStyle;
        return style.BgOr(style.FgOr(0));
    }
    public override void OnMeasure(App app) {
        base.OnMeasure(app);
        Switch sw = owner;
        if (sw == null || app == null) { return; }
        string ct = sw.CheckedText.Get();
        string ut = sw.UncheckedText.Get();
        string ci = sw.CheckedIcon.Get();
        string ui = sw.UncheckedIcon.Get();
        if (ct == "" && ut == "" && ci == "" && ui == "") { return; }
        int fs = Style.FontFallback(app, "tiny");
        int tw = Math.Max(ct != "" ? Canvas.MeasureText(ct, fs) : 0,
                          ut != "" ? Canvas.MeasureText(ut, fs) : 0);
        int iw = (ci != "" || ui != "") ? app.Scale(14) : 0;
        int thumbW = sw.thumbNode != null ? sw.thumbNode.StyleWidthIn(prefW) : app.Scale(18);
        int needW = thumbW + Math.Max(tw, iw) + app.Scale(12);
        if (needW > prefW) { prefW = needW; }
    }
    public override void OnPaint(App app) {
        Switch sw = owner;
        if (sw == null || app == null || bw <= 0 || bh <= 0) { return; }
        bool on = sw.IsOn();
        string txt = on ? sw.CheckedText.Get() : sw.UncheckedText.Get();
        string ico = on ? sw.CheckedIcon.Get() : sw.UncheckedIcon.Get();
        if (txt == "" && ico == "") { return; }
        int thumbW = sw.thumbNode != null && sw.thumbNode.bw > 0 ? sw.thumbNode.bw : bh - app.Scale(4);
        int pad = app.Scale(4);
        int rx = on ? bx + pad : bx + pad + thumbW;
        int rw = bw - thumbW - pad * 2;
        if (rw <= 0) { return; }
        int fg = on ? app.theme.textInverse : app.theme.onScrim;
        if (ico != "") {
            int sz = Math.Min(rw, Math.Max(app.Scale(10), bh - app.Scale(6)));
            app.canvas.DrawGlyphIn(ico, rx, by, rw, bh, sz, fg);
        } else {
            int fs = Style.FontFallback(app, "tiny");
            app.canvas.DrawTextCentered(rx, by, rw, bh, txt, fg, fs);
        }
    }
}
class SwitchThumb : Control {
    private weak Switch owner;
    private ChoiceVisualMotion travel = new ChoiceVisualMotion();
    private bool lastOn;
    private int lastOffset;
    SwitchThumb(Switch toggle) : base("switch-thumb") {
        owner = toggle;
        this.ClassName = "switch-thumb";
        styleSurfaceOwned = true;
    }
    public override void OnPaint(App app) {
        if (bw <= 0 || bh <= 0) { return; }
        StyleBox thumbStyle = this.ResolvePaintedSurface(app);
        Switch toggle = owner;
        if (toggle == null || !(parent is SwitchTrack)) {
            thumbStyle.Paint(app, bx, by, bw, bh);
            return;
        }
        SwitchTrack track = (SwitchTrack)parent;
        StyleBox trackStyle = track.TrackStyle();
        bool on = toggle.IsOn();
        int offset = bx - track.bx;
        int duration = this.IsDisabled() || (on == lastOn && offset != lastOffset)
            ? 0 : trackStyle.transitionMs;
        int x = track.bx + travel.Sample(app, offset, duration, trackStyle.easing);
        lastOn = on;
        lastOffset = offset;
        thumbStyle.Paint(app, x, by, bw, bh);
        if (travel.Active()) { app.RequestAnimationFrameIn(track.bx, track.by, track.bw, track.bh); }
        if (toggle.Loading) { this.PaintLoading(app, x, track.SpinnerColor()); }
    }
    private void PaintLoading(App app, int x, int color) {
        int cx = x + bw / 2;
        int cy = by + bh / 2;
        int stroke = app.Scale(2);
        int radius = Math.Min(bw, bh) / 2 - stroke;
        if (radius <= stroke || !Spin.OnScreen(app, cx, cy, radius)) { return; }
        int phase = app.reducedMotion ? 0 : Spin.DotPhase(app.nowMs);
        int start = phase * 360 / 8000;
        app.canvas.DrawArc(cx, cy, radius - stroke, radius, start, start + 270, color, stroke);
        if (!app.reducedMotion) { app.RequestAnimationFrameIn(x, by, bw, bh); }
    }
}
