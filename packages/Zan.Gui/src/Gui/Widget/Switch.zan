using System;
using Gui;
using Gui.Backend;

namespace Gui.Widget;

// 开关，支持响应式 bool 绑定。
// C# 风格保留式实例，交互走 Visual Tree 路由事件：
// dark.Change += () => { ... };
// app.SetRootControl(dark);
// 增强能力（对位 Ant Design Switch 文档演示）：
// - 内嵌文字/图标：`CheckedText` / `UncheckedText` / `CheckedIcon` /
// `UncheckedIcon`，有内容时轨道自动加宽；
// - 形状：`Round = false` 得方形轨道 + 圆角方形拇指；
// - 加载中：`Loading = true` 时拇指上叠画弧线 spinner、轨道变暗，
// 且点击/键盘不再切换；
// - 自定义颜色：`CheckedColor` / `UncheckedColor`（0 = 跟随皮肤）；
public class Switch : ToggleControl {
    // 兼容别名属性
    public int wid { get { return this.WidgetId(); } set { this.commonId = value; } }

    // 加载中：轨道变暗 + 拇指叠画旋转弧线，且不再响应点击。
    public bool Loading;
    // 圆角轨道 + 圆形 thumb；false 得方形（小圆角）形状。
    public bool Round;
    // 选中/未选中时轨道内嵌文字（空 = 无）；有内容时轨道自动加宽。
    public Binding<string> CheckedText;
    public Binding<string> UncheckedText;
    // 选中/未选中时轨道内嵌图标（Icon.zan glyph 名，空 = 无）。
    public Binding<string> CheckedIcon;
    public Binding<string> UncheckedIcon;
    // 自定义轨道色（Progress fillColor 同款约定：0 = 跟随皮肤）。
    public int CheckedColor;
    public int UncheckedColor;

    public Control trackNode;
    public Control thumbNode;

    public override int StyleDisplay() { return 1; } // CSS display: flex
    public override int StyleFlexDir() { return 0; } // flex-direction: row

    // 公共初始化（构造共用）。
    private void InitSwitch() {
        this.InitToggle("switch");
        Loading = false;
        Round = true;
        CheckedText = "";
        UncheckedText = "";
        CheckedIcon = "";
        UncheckedIcon = "";
        CheckedColor = 0;
        UncheckedColor = 0;
        this.ClassName = "switch align-center";
        trackNode = new Control("switch-track");
        trackNode.ClassName = "switch-track align-center";
        thumbNode = new Control("switch-thumb");
        thumbNode.ClassName = "switch-thumb";
        trackNode.Add(thumbNode);
        this.Add(trackNode);
    }

    // 保留式构造器：`Switch dark = new Switch();`
    public Switch() {
        InitSwitch();
    }

    public bool IsOn() { return Checked.Get(); }

    public void SetOn(bool v) {
        this.SetChecked(v);
    }

    // 控件类型标识（序列化/设计器用）。
    public override void CloneContentTo(Control target, CloneTreeFn clone) {
        // Constructor and property replay recreate the generated parts.
    }

    public override string Kind() { return "Switch"; }

    // 覆写：返回设计器属性清单（值 / 尺寸档 / 加载 / 形状 / 内嵌文字图标 / 自定义色）。
    // 键与标签由字段名派生，见 PropSpec.*Field。
    protected override List<PropSpec> DefineProps() {
        return new List<PropSpec>{
            PropSpec.Bool("value", "On").Field("Checked").DefaultBinding()
                .Also("checked").Also("on").Also("data"),
            PropSpec.Bool("defOn", "Default on").Field("Checked")
                .WithTip("Design default-on: FormBuilder/Designer mount projects "
                         + "it as a SetProp, so the switch starts on."),
            this.SizeProp(),
            PropSpec.BoolField("Loading"),
            PropSpec.BoolField("Round"),
            PropSpec.TextField("CheckedText")
                .WithTip("Inner text shown while on (Ant Design children); the track widens to fit. Empty = none."),
            PropSpec.TextField("UncheckedText")
                .WithTip("Inner text shown while off; the track widens to fit. Empty = none."),
            PropSpec.TextField("CheckedIcon").WithTip("Inner icon (glyph name) shown while on. Empty = none."),
            PropSpec.TextField("UncheckedIcon").WithTip("Inner icon (glyph name) shown while off. Empty = none."),
            PropSpec.ColorField("CheckedColor").WithTip("Custom track colour while on. 0 = skin."),
            PropSpec.ColorField("UncheckedColor").WithTip("Custom track colour while off. 0 = skin.")
        };
    }

    public override void SyncBinding() {
        base.SyncBinding();
        bool on = Checked.Get();
        if (on) {
            this.AddClass("on");
            this.RemoveClass("off");
            if (trackNode != null) {
                trackNode.AddClass("justify-end");
                trackNode.RemoveClass("justify-start");
            }
        } else {
            this.AddClass("off");
            this.RemoveClass("on");
            if (trackNode != null) {
                trackNode.AddClass("justify-start");
                trackNode.RemoveClass("justify-end");
            }
        }
    }

    public override void OnClick(RoutedEventArgs e) {
        if (this.IsDisabled() || Loading) { return; }
        base.OnClick(e);
    }

    public override void OnKeyDown(RoutedEventArgs e) {
        if (this.IsDisabled() || Loading) { return; }
        base.OnKeyDown(e);
    }

    public override int InputFocusCapabilities() { return 1; }

}
