using System;
using Gui;
using Gui.Backend;
namespace Gui.Widget;
[GuiKind("Switch")]
public class Switch : ToggleControl {
    public override Control CreateCloneShell() { return new Switch(); }
    public int wid { get { return this.WidgetId(); } set { this.commonId = value; } }
    public bool Loading;
    public bool Round;
    public Binding<string> CheckedText;
    public Binding<string> UncheckedText;
    public Binding<string> CheckedIcon;
    public Binding<string> UncheckedIcon;
    public int CheckedColor;
    public int UncheckedColor;
    public Control trackNode;
    public Control thumbNode;
    public override int StyleDisplay() { return 1; } // CSS display: flex
    public override int StyleFlexDir() { return 0; } // flex-direction: row
    private void InitSwitch() {
        this.InitToggle("switch");
        Loading = false;
        Round = true;
        CheckedText = "";
        UncheckedText = "";
        CheckedIcon = "";
        UncheckedIcon = "";
        CheckedColor = 0;
        UncheckedColor = 0;
        this.ClassName = "switch align-center";
        trackNode = new SwitchTrack(this);
        thumbNode = new SwitchThumb(this);
        trackNode.Add(thumbNode);
        this.Add(trackNode);
    }
    public Switch() { InitSwitch(); }
    public bool IsOn() { return Checked.Get(); }
    public void SetOn(bool v) { this.SetChecked(v); }
    public override List<string> Events() {
        List<string> e = Control.CommonEvents();
        e.Add("Change");
        e.Add("Toggle");
        return e;
    }
    public override void CloneContentTo(Control target, CloneTreeFn clone) {
    }
    public override string Kind() { return "Switch"; }
    protected override List<PropSpec> DefineProps() {
        List<PropSpec> ps = new List<PropSpec>();
        ps.Add(PropSpec.Bool("value", "On").DefaultBinding().Field("Checked", 2).Also("checked").Also("on").Also("data"));
        PropSpec defOn = PropSpec.Bool("defOn", "Default on");
        defOn.Field("Checked", 2);
        defOn.WithTip("Design default-on: FormBuilder/Designer mount projects "
                      + "it as a SetProp, so the switch starts on.");
        ps.Add(defOn);
        PropSpec sz = PropSpec.Enum("size", "Size",
            PropSpec.Sizes());
        sz.Field("Size", 0);
        ps.Add(sz);
        ps.Add(PropSpec.Bool("loading", "Loading").Field("Loading", 2));
        ps.Add(PropSpec.Bool("round", "Round").Field("Round", 2));
        PropSpec ct = PropSpec.Text("checkedText", "Checked text");
        ct.Field("CheckedText", 0);
        ct.WithTip("Inner text shown while on (Ant Design children); the track widens to fit. Empty = none.");
        ps.Add(ct);
        PropSpec ut = PropSpec.Text("uncheckedText", "Unchecked text");
        ut.Field("UncheckedText", 0);
        ut.WithTip("Inner text shown while off; the track widens to fit. Empty = none.");
        ps.Add(ut);
        ps.Add(PropSpec.Text("checkedIcon", "Checked icon").Field("CheckedIcon", 0).WithTip("Inner icon (glyph name) shown while on. Empty = none."));
        ps.Add(PropSpec.Text("uncheckedIcon", "Unchecked icon").Field("UncheckedIcon", 0).WithTip("Inner icon (glyph name) shown while off. Empty = none."));
        ps.Add(PropSpec.Color("checkedColor", "Checked color").Field("CheckedColor", 1).WithTip("Custom track colour while on. 0 = skin."));
        ps.Add(PropSpec.Color("uncheckedColor", "Unchecked color").Field("UncheckedColor", 1).WithTip("Custom track colour while off. 0 = skin."));
        return ps;
    }
    public override void BindEvent(string evt, Action a) {
        if (evt == "Change" || evt == "Toggle") { Change.Add(a); return; }
        base.BindEvent(evt, a);
    }
    public override void BindEventS(string evt, ControlEvent a) {
        if (evt == "Change" || evt == "Toggle") { Change.AddS(a); return; }
        base.BindEventS(evt, a);
    }
    public override void TriggerEvent(string evt) {
        if (evt == "Change" || evt == "Toggle") { Change.Raise(); return; }
        base.TriggerEvent(evt);
    }
    public override void SyncBinding() {
        base.SyncBinding();
        bool on = Checked.Get();
        if (on) {
            this.AddClass("on");
            this.RemoveClass("off");
        } else {
            this.AddClass("off");
            this.RemoveClass("on");
        }
        if (trackNode != null) {
            trackNode.AddClass(on ? "justify-end" : "justify-start");
            trackNode.RemoveClass(on ? "justify-start" : "justify-end");
            if (trackNode is SwitchTrack) { ((SwitchTrack)trackNode).SetOnState(on); }
        }
    }
    public override void OnClick(RoutedEventArgs e) {
        if (this.IsDisabled() || Loading) { return; }
        base.OnClick(e);
    }
    public override void OnKeyDown(RoutedEventArgs e) {
        if (this.IsDisabled() || Loading) { return; }
        base.OnKeyDown(e);
    }
    public override int InputFocusCapabilities() { return 1; }
}
class SwitchTrack : Control {
    private weak Switch owner;
    SwitchTrack(Switch toggle) : base("switch-track") {
        owner = toggle;
        this.ClassName = "switch-track align-center";
    }
    protected override Control SurfaceInputOwner() { return owner; }
    internal void SetOnState(bool on) { this.SetSurfaceTransitionKey(on ? 2 : 1); }
    internal StyleBox TrackStyle() { return computedStyle; }
    internal int SpinnerColor() {
        StyleBox style = paintedStyle != null ? paintedStyle : computedStyle;
        return style.BgOr(style.FgOr(0));
    }
}
class SwitchThumb : Control {
    private weak Switch owner;
    private ChoiceVisualMotion travel = new ChoiceVisualMotion();
    private bool lastOn;
    private int lastOffset;
    SwitchThumb(Switch toggle) : base("switch-thumb") {
        owner = toggle;
        this.ClassName = "switch-thumb";
        styleSurfaceOwned = true;
    }
    public override void OnPaint(App app) {
        if (bw <= 0 || bh <= 0) { return; }
        StyleBox thumbStyle = this.ResolvePaintedSurface(app);
        Switch toggle = owner;
        if (toggle == null || !(parent is SwitchTrack)) {
            thumbStyle.Paint(app, bx, by, bw, bh);
            return;
        }
        SwitchTrack track = (SwitchTrack)parent;
        StyleBox trackStyle = track.TrackStyle();
        bool on = toggle.IsOn();
        int offset = bx - track.bx;
        int duration = this.IsDisabled() || (on == lastOn && offset != lastOffset)
            ? 0 : trackStyle.transitionMs;
        int x = track.bx + travel.Sample(app, offset, duration, trackStyle.easing);
        lastOn = on;
        lastOffset = offset;
        thumbStyle.Paint(app, x, by, bw, bh);
        if (travel.Active()) { app.RequestAnimationFrameIn(track.bx, track.by, track.bw, track.bh); }
        if (toggle.Loading) { this.PaintLoading(app, x, track.SpinnerColor()); }
    }
    private void PaintLoading(App app, int x, int color) {
        int cx = x + bw / 2;
        int cy = by + bh / 2;
        int stroke = app.Scale(2);
        int radius = Math.Min(bw, bh) / 2 - stroke;
        if (radius <= stroke || !Spin.OnScreen(app, cx, cy, radius)) { return; }
        int phase = app.reducedMotion ? 0 : Spin.DotPhase(app.nowMs);
        int start = phase * 360 / 8000;
        app.canvas.DrawArc(cx, cy, radius - stroke, radius, start, start + 270, color, stroke);
        if (!app.reducedMotion) { app.RequestAnimationFrameIn(x, by, bw, bh); }
    }
}
