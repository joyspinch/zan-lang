using System;
using Gui;

namespace Gui.Widget;

// 现代声明式表单项：对齐 Naive UI n-form-item 与 DevExpress 表单字段封装。
// 封装了标题标签、字段控件、必填红星、错误提示与辅助说明，支持 top/left 自由排布，
// 全面支持 slot="label"、slot="extra"、slot="help"、slot="field" 统一插槽。
public class FormItem : FormRow {
    private Control customLabel;
    private Control customHelp;
    private Control extraControl;

    public FormItem() : base("", null) {
        customLabel = null;
        customHelp = null;
        extraControl = null;
    }

    public FormItem(string caption, Control ctl) : base(caption, ctl) {
        customLabel = null;
        customHelp = null;
        extraControl = null;
    }

    public override void CloneContentTo(Control target, CloneTreeFn clone) {
        FormItem item = (FormItem)target;
        if (customLabel != null) { item.MountSlot("label", clone(customLabel)); }
        if (customHelp != null) { item.MountSlot("help", clone(customHelp)); }
        if (extraControl != null) { item.MountSlot("extra", clone(extraControl)); }
        if (field != null) { item.MountSlot("field", clone(field)); }
    }

    public override string Kind() { return "FormItem"; }

    public Control GetCustomLabel() { return this.customLabel; }
    public Control GetCustomHelp() { return this.customHelp; }
    public Control GetExtra() { return this.extraControl; }
    public Control GetField() { return this.field; }

    public override bool MountSlot(string slot, Control c) {
        if (slot == "label" || slot == "header") {
            this.customLabel = c;
            this.RebuildItemChildren();
            return true;
        }
        if (slot == "extra" || slot == "action") {
            this.extraControl = c;
            this.RebuildItemChildren();
            return true;
        }
        if (slot == "help") {
            this.customHelp = c;
            this.RebuildItemChildren();
            return true;
        }
        if (slot == "field" || slot == "content" || slot == "default") {
            this.field = c;
            this.RebuildItemChildren();
            return true;
        }
        return base.MountSlot(slot, c);
    }

    // 在 HTML 声明式标记中，子节点作为字段控件或插槽挂入
    public override Control Add(Control child) {
        if (child == null) { return null; }
        if (child.slotName != "" && this.MountSlot(child.slotName, child)) {
            return child;
        }
        if (this.field == null) {
            this.SetControl(child);
            return child;
        }
        return base.Add(child);
    }

    public void RebuildItemChildren() {
        this.RemoveAll();
        Control lbl = this.customLabel != null ? this.customLabel : this.label;
        Control hlp = this.customHelp != null ? this.customHelp : this.help;

        if (this.placement == "left") {
            this.layout = 2; // 水平横排
            if (lbl != null) {
                lbl.Prefer(this.labelWidth, 28);
                this.Children.Add(lbl);
            }
            Column right = new Column().Gap(4);
            if (this.field != null && this.extraControl != null) {
                Row fieldRow = new Row().Gap(8);
                fieldRow.Child(this.field).Child(this.extraControl);
                right.Child(fieldRow);
            } else if (this.field != null) {
                right.Child(this.field);
            } else if (this.extraControl != null) {
                right.Child(this.extraControl);
            }

            if (hlp != null) { right.Child(hlp); }
            if (this.err != null) { right.Child(this.err); }
            this.Children.Add(right);
        } else {
            this.layout = 1; // 纵向竖排
            if (lbl != null && this.extraControl != null) {
                Row headerRow = new Row().Gap(8);
                headerRow.Child(lbl).Child(this.extraControl);
                this.Children.Add(headerRow);
            } else if (lbl != null) {
                this.Children.Add(lbl);
            } else if (this.extraControl != null) {
                this.Children.Add(this.extraControl);
            }

            if (this.field != null) { this.Children.Add(this.field); }
            if (hlp != null) { this.Children.Add(hlp); }
            if (this.err != null) { this.Children.Add(this.err); }
        }
    }

    public override void SetProp(string key, string val) {
        string k = key.ToLower();
        if (k == "label" || k == "caption") {
            this.Caption(val);
            this.RebuildItemChildren();
            return;
        }
        if (k == "placement") {
            this.Placement(val);
            return;
        }
        if (k == "label-width" || k == "labelwidth") {
            this.LabelWidth(int.Parse(val));
            return;
        }
        if (k == "required") {
            if (val == "true" || val == "1" || val == "") {
                this.Required("此项必填");
            }
            return;
        }
        if (k == "help") {
            this.Help(val);
            this.RebuildItemChildren();
            return;
        }
        base.SetProp(key, val);
    }

    public FormItem Placement(string p) {
        base.Placement(p);
        this.RebuildItemChildren();
        return this;
    }

    public FormItem LabelWidth(int w) {
        base.LabelWidth(w);
        this.RebuildItemChildren();
        return this;
    }

    public FormItem Required(string msg) {
        base.Required(msg);
        this.RebuildItemChildren();
        return this;
    }

    public FormItem Help(string text) {
        base.Help(text);
        this.RebuildItemChildren();
        return this;
    }

    public FormItem Rule(FormRule r) {
        base.Rule(r);
        return this;
    }
}
