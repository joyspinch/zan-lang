using System;
using Gui;
namespace Gui.Widget;
public class FormItem : FormRow {
    public override Control CreateCloneShell() { return new FormItem(); }
    // 父类按 "Panel" 上报，本控件须报自己的种类（序列化与 CSS 类型选择器）。
    public override string Kind() { return "FormItem"; }
    private Control customLabel;
    private Control customHelp;
    private Control extraControl;
    public FormItem() : base("", null) {
        customLabel = null;
        customHelp = null;
        extraControl = null;
    }
    public FormItem(string caption, Control ctl) : base(caption, ctl) {
        customLabel = null;
        customHelp = null;
        extraControl = null;
    }
    public override void CloneContentTo(Control target, CloneTreeFn clone) {
        FormItem item = (FormItem)target;
        if (customLabel != null) {
            Control c = clone(customLabel);
            if (c != null) { item.MountSlot("label", c); }
        }
        if (customHelp != null) {
            Control c = clone(customHelp);
            if (c != null) { item.MountSlot("help", c); }
        }
        if (extraControl != null) {
            Control c = clone(extraControl);
            if (c != null) { item.MountSlot("extra", c); }
        }
        if (field != null) {
            Control c = clone(field);
            if (c != null) { item.MountSlot("field", c); }
        }
    }
    public Control GetCustomLabel() { return this.customLabel; }
    public Control GetCustomHelp() { return this.customHelp; }
    public Control GetExtra() { return this.extraControl; }
    public Control GetField() { return this.field; }
    public override bool MountSlot(string slot, Control c) {
        if (slot == "label" || slot == "header") {
            this.customLabel = c;
            this.RebuildItemChildren();
            return true;
        }
        if (slot == "extra" || slot == "action") {
            this.extraControl = c;
            this.RebuildItemChildren();
            return true;
        }
        if (slot == "help") {
            this.customHelp = c;
            this.RebuildItemChildren();
            return true;
        }
        if (slot == "field" || slot == "content" || slot == "default") {
            this.field = c;
            this.RebuildItemChildren();
            return true;
        }
        return base.MountSlot(slot, c);
    }
    public override Control Add(Control child) {
        if (child == null) { return null; }
        if (child.slotName != "" && this.MountSlot(child.slotName, child)) { return child; }
        if (this.field == null) {
            this.SetControl(child);
            return child;
        }
        return base.Add(child);
    }
    public override void RebuildChildren() {
        this.RebuildItemChildren();
    }
    public void RebuildItemChildren() {
        this.RemoveAll();
        Control lbl = this.customLabel != null ? this.customLabel : this.label;
        Control hlp = this.customHelp != null ? this.customHelp : this.help;
        if (this.placement == "left") {
            this.layout = 2; // 水平横排
            if (lbl != null) {
                lbl.Prefer(this.labelWidth, 28);
                base.Add(lbl);
            }
            Column right = new Column { Gap = 4 };
            if (this.field != null && this.extraControl != null) {
                Row fieldRow = new Row {
                    Gap = 8,
                    Children = [ this.field, this.extraControl ]
                };
                right.Add(fieldRow);
            } else if (this.field != null) {
                right.Add(this.field);
            } else if (this.extraControl != null) {
                right.Add(this.extraControl);
            }
            if (hlp != null) { right.Add(hlp); }
            if (this.err != null) { right.Add(this.err); }
            base.Add(right);
        } else {
            this.layout = 1; // 纵向竖排
            if (lbl != null && this.extraControl != null) {
                Row headerRow = new Row {
                    Gap = 8,
                    Children = [ lbl, this.extraControl ]
                };
                base.Add(headerRow);
            } else if (lbl != null) {
                base.Add(lbl);
            } else if (this.extraControl != null) {
                base.Add(this.extraControl);
            }
            if (this.field != null) { base.Add(this.field); }
            if (hlp != null) { base.Add(hlp); }
            if (this.err != null) { base.Add(this.err); }
        }
    }
    public override void Placement(string p) {
        base.Placement(p);
        this.RebuildItemChildren();
    }
    public override void LabelWidth(int w) {
        base.LabelWidth(w);
        this.RebuildItemChildren();
    }
    public override void Required(string msg) {
        base.Required(msg);
        this.RebuildItemChildren();
    }
    public override void Help(string text) {
        base.Help(text);
        this.RebuildItemChildren();
    }
    // 设计器 / HTML 属性：标题、标签位置与宽度、必填、帮助文本（写入后重建条目）。
    protected override List<PropSpec> DefineProps() {
        List<PropSpec> ps = base.DefineProps();
        ps.Add(PropSpec.Text("label", "Label").Accessor("GetCaptionText", "SetCaptionText").Also("caption"));
        ps.Add(PropSpec.Text("placement", "Label placement").Field("placement").Setter("SetPlacementText"));
        ps.Add(PropSpec.Int("labelWidth", "Label width").Field("labelWidth").Setter("SetLabelWidth")
            .Also("label-width").Also("labelwidth"));
        ps.Add(PropSpec.Bool("required", "Required").Accessor("RequiredText", "SetRequiredText"));
        ps.Add(PropSpec.Text("help", "Help").Accessor("GetHelpText", "SetHelpText"));
        return ps;
    }

    public string GetCaptionText() { return this.CaptionText; }
    public void SetCaptionText(string val) {
        this.Caption(val);
        this.RebuildItemChildren();
    }

    public void SetPlacementText(string p) { this.Placement(p); }
    public void SetLabelWidth(int w) { this.LabelWidth(w); }

    // 必填只能开启（附带默认提示）；HTML 布尔属性的空值也算开启。
    public string RequiredText() { return isRequired ? "true" : "false"; }
    public void SetRequiredText(string val) {
        if (!isRequired && (val == "true" || val == "1" || val == "")) { this.Required("此项必填"); }
    }

    public string GetHelpText() {
        if (help == null || help.Text == null) { return ""; }
        string s = help.Text.Get();
        return s != null ? s : "";
    }
    public void SetHelpText(string val) { this.Help(val); }
}
