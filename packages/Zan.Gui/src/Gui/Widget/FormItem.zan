using System;
using Gui;

namespace Gui.Widget;

// 现代声明式表单项：对齐 Naive UI n-form-item 与 DevExpress 表单字段封装。
// 封装了标题标签、字段控件、必填红星、错误提示与辅助说明，支持 top/left 自由排布。
public class FormItem : FormRow {
    FormItem() : base("", null) { }

    FormItem(string caption, Control ctl) : base(caption, ctl) { }

    static FormItem Create(string caption, Control ctl) {
        return new FormItem(caption, ctl);
    }

    override string Kind() { return "FormItem"; }

    // 在 HTML 声明式标记中，子节点作为字段控件挂入
    override Control Add(Control child) {
        if (child == null) { return null; }
        if (this.field == null) {
            this.SetControl(child);
            return child;
        }
        return base.Add(child);
    }

    override void SetProp(string key, string val) {
        string k = key.ToLower();
        if (k == "label" || k == "caption") {
            this.Caption(val);
            return;
        }
        if (k == "placement") {
            this.Placement(val);
            return;
        }
        if (k == "label-width" || k == "labelwidth") {
            this.LabelWidth(int.Parse(val));
            return;
        }
        if (k == "required") {
            if (val == "true" || val == "1" || val == "") {
                this.Required("此项必填");
            }
            return;
        }
        if (k == "help") {
            this.Help(val);
            return;
        }
        base.SetProp(key, val);
    }

    FormItem Placement(string p) {
        base.Placement(p);
        return this;
    }

    FormItem LabelWidth(int w) {
        base.LabelWidth(w);
        return this;
    }

    FormItem Required(string msg) {
        base.Required(msg);
        return this;
    }

    FormItem Help(string text) {
        base.Help(text);
        return this;
    }

    FormItem Rule(FormRule r) {
        base.Rule(r);
        return this;
    }
}
