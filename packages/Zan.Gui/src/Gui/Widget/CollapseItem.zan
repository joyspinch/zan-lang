using System;
using Gui;

namespace Gui.Widget;

// 折叠面板子项：纯 Flex 纵向容器，由 Header 与 Content 声明式复合而成。
// 支持标题、图标、状态绑定与任意复杂子组件互嵌，彻底消除手动 Canvas 微绘。
public class CollapseItem : Control {
    public string ItemKey;
    public string Title;
    public bool IsExpanded;
    public bool Disabled;
    public Control Header;
    public Control Content;
    public UiEvent Toggle;
    public string ArrowPlacement = "left";

    private Flex headerNode;
    private Flex contentNode;
    private IconView arrowIcon;
    private string appliedArrowPlacement = "left";

    public override int StyleDisplay() { return 1; } // CSS display: flex
    public override int StyleFlexDir() { return 1; } // flex-direction: column

    private void InitCollapseItem(string title, bool expanded) {
        this.InitControl("collapseitem", 1);
        Title = title;
        IsExpanded = expanded;
        Disabled = false;
        ItemKey = "";
        Toggle = new UiEvent();
        this.RebuildStructure();
    }

    public CollapseItem() { InitCollapseItem("", false); }
    public CollapseItem(string title) { InitCollapseItem(title, false); }
    public CollapseItem(string title, bool expanded) { InitCollapseItem(title, expanded); }

    public void SetExpanded(bool exp) {
        if (IsExpanded == exp) { return; }
        IsExpanded = exp;
        this.RebuildStructure();
        if (Toggle != null) { Toggle.Raise(this); }
        App a = this.FindApp();
        if (a != null) { a.RequestRedraw(); }
    }

    public void SetArrowPlacement(string placement) {
        string next = placement == "right" ? "right" : "left";
        ArrowPlacement = next;
        if (appliedArrowPlacement == next) { return; }
        this.RebuildStructure();
    }

    public void RebuildStructure() {
        List<Control> customChildren = new List<Control>();
        for (int i = 0; i < this.ChildCount(); i = i + 1) {
            Control child = this.ChildAt(i);
            if (child != headerNode && child != contentNode) { customChildren.Add(child); }
        }
        this.RemoveAll();
        contentNode = null;
        appliedArrowPlacement = ArrowPlacement == "right" ? "right" : "left";

        // 1. 标题头：Flex Row
        headerNode = new Flex();
        headerNode.ClassName = "collapse-header row align-center justify-between gap-small";
        arrowIcon = new IconView(IsExpanded ? "chevron-down" : "chevron-right", 16);
        if (ArrowPlacement != "right") { headerNode.Add(arrowIcon); }

        if (Header != null) {
            headerNode.Add(Header);
        } else if (Title != "") {
            headerNode.Add(new Label(Title) { ClassName = "collapse-title flex-1" });
        }

        if (ArrowPlacement == "right") { headerNode.Add(arrowIcon); }

        CollapseItemAction action = new CollapseItemAction(this);
        headerNode.BindEvent("Click", action.Click);
        base.Add(headerNode);

        // 2. 正文内容区：Flex Column（展开时可见）
        if (IsExpanded && Content != null) {
            contentNode = new Flex();
            contentNode.ClassName = "collapse-content column";
            contentNode.Add(Content);
            base.Add(contentNode);
        }
        for (int i = 0; i < customChildren.Count; i = i + 1) { base.Add(customChildren[i]); }
    }

    public override bool MountSlot(string slot, Control c) {
        if (slot == "header" || slot == "title") {
            Header = c;
            this.RebuildStructure();
            return true;
        }
        if (slot == "content" || slot == "body" || slot == "default") {
            Content = c;
            this.RebuildStructure();
            return true;
        }
        return base.MountSlot(slot, c);
    }

    public override Control Add(Control child) {
        if (child == null) { return null; }
        if (Content == null) {
            Content = child;
            this.RebuildStructure();
            return child;
        }
        return base.Add(child);
    }

    public override void CloneContentTo(Control target, CloneTreeFn clone) {
        CollapseItem copy = (CollapseItem)target;
        copy.ArrowPlacement = ArrowPlacement;
        copy.Header = Header != null ? clone(Header) : null;
        copy.Content = Content != null ? clone(Content) : null;
        copy.RebuildStructure();
        for (int i = 0; i < this.ChildCount(); i = i + 1) {
            Control child = this.ChildAt(i);
            if (child == headerNode || child == contentNode) { continue; }
            Control next = clone(child);
            if (next != null) { copy.InsertAt(copy.ChildCount(), next); }
        }
    }

    public void SetTitle(string t) {
        Title = t;
        this.RebuildStructure();
    }

    public void SetItemDisabled(bool on) {
        Disabled = on;
        this.RebuildStructure();
    }

    protected override List<PropSpec> DefineProps() {
        List<PropSpec> ps = new List<PropSpec>();
        ps.Add(PropSpec.TextField("Title").Also("text").Also("label"));
        ps.Add(PropSpec.Text("title", "Title").Field("Title").Setter("SetTitle").Also("text").Also("label"));
        ps.Add(PropSpec.Bool("expanded", "Expanded").Field("IsExpanded").Setter("SetExpanded"));
        ps.Add(PropSpec.Bool("disabled", "Disabled").Field("Disabled").Setter("SetItemDisabled"));
        ps.Add(PropSpec.BoolField("Disabled"));
        ps.Add(PropSpec.Text("key", "ItemKey").Field("ItemKey"));
        return ps;
    }

    public override void SyncBinding() {
        base.SyncBinding();
        this.SetArrowPlacement(ArrowPlacement);
        if (IsExpanded) {
            this.AddClass("expanded");
        }
    }
}
