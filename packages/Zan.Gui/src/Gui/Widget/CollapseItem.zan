using System;
using Gui;

namespace Gui.Widget;

// 手风琴子项控件（CollapseItem）：
// 对应 HTML <collapse-item title="..."> 或 <collapse-panel>，
// 内部可容纳任意复杂子组件（表单、表格、图表、卡片），
// 支持 slot="extra" 挂载头部右侧操作控件。
public class CollapseItem : Control {
    string title;
    string bodyText;
    Control extraControl;
    Control contentControl;
    bool disabled;

    CollapseItem() : this("") { }

    CollapseItem(string title) {
        this.InitControl("collapseitem", 1);
        this.title = title;
        this.bodyText = "";
        this.extraControl = null;
        this.contentControl = null;
        this.disabled = false;
    }

    public string Title() { return this.title; }
    public CollapseItem SetTitle(string t) { this.title = t; return this; }
    public string BodyText() { return this.bodyText; }
    public CollapseItem SetBodyText(string b) { this.bodyText = b; return this; }

    public Control GetExtra() { return this.extraControl; }
    public Control GetContent() { return this.contentControl; }
    public bool IsDisabledItem() { return this.disabled; }

    public override bool MountSlot(string slot, Control c) {
        if (slot == "extra" || slot == "header-extra") {
            this.extraControl = c;
            if (!children.Contains(c)) { this.Children.Add(c); }
            return true;
        }
        if (slot == "content" || slot == "body" || slot == "default") {
            this.contentControl = c;
            if (!children.Contains(c)) { this.Children.Add(c); }
            return true;
        }
        return base.MountSlot(slot, c);
    }

    public override Control Add(Control child) {
        if (child == null) { return null; }
        if (child.slotName != "" && this.MountSlot(child.slotName, child)) {
            return child;
        }
        if (this.contentControl == null) {
            this.contentControl = child;
        }
        if (!children.Contains(child)) {
            this.Children.Add(child);
        }
        return child;
    }

    override string Kind() { return "CollapseItem"; }

    override void SetProp(string key, string val) {
        string k = key.ToLower();
        if (k == "title" || k == "header" || k == "caption") {
            this.title = val;
            return;
        }
        if (k == "body" || k == "text") {
            this.bodyText = val;
            return;
        }
        if (k == "disabled") {
            this.disabled = val == "true" || val == "1" || val == "";
            return;
        }
        base.SetProp(key, val);
    }
}
