using System;
using Gui;

namespace Gui.Widget;

// 折叠面板子项：纯 Flex 纵向容器，由 Header 与 Content 声明式复合而成。
// 支持标题、图标、状态绑定与任意复杂子组件互嵌，彻底消除手动 Canvas 微绘。
public class CollapseItem : Control {
    public string ItemKey;
    public string Title;
    public bool IsExpanded;
    public bool Disabled;
    public Control Header;
    public Control Content;
    public UiEvent Toggle;

    private Flex headerNode;
    private Flex contentNode;
    private IconView arrowIcon;

    public override int StyleDisplay() { return 1; } // CSS display: flex
    public override int StyleFlexDir() { return 1; } // flex-direction: column

    private void InitCollapseItem(string title, bool expanded) {
        this.InitControl("collapseitem", 1);
        Title = title;
        IsExpanded = expanded;
        Disabled = false;
        ItemKey = "";
        Toggle = new UiEvent();
        this.RebuildStructure();
    }

    public CollapseItem() { InitCollapseItem("", false); }
    public CollapseItem(string title) { InitCollapseItem(title, false); }
    public CollapseItem(string title, bool expanded) { InitCollapseItem(title, expanded); }

    public void SetExpanded(bool exp) {
        if (IsExpanded == exp) { return; }
        IsExpanded = exp;
        this.RebuildStructure();
        if (Toggle != null) { Toggle.RaiseS(this); }
        App a = this.FindApp();
        if (a != null) { a.RequestRedraw(); }
    }

    public void RebuildStructure() {
        this.children.Clear();

        // 1. 标题头：Flex Row
        headerNode = new Flex();
        headerNode.ClassName = "collapse-header row align-center justify-between gap-small";
        arrowIcon = new IconView(IsExpanded ? "chevron-down" : "chevron-right", 16);
        headerNode.Add(arrowIcon);

        if (Header != null) {
            headerNode.Add(Header);
        } else if (Title != "") {
            headerNode.Add(new Label(Title) { ClassName = "collapse-title flex-1" });
        }

        int hid = headerNode.CommonId();
        headerNode.BindEvent("Click", () => {
            if (!Disabled) {
                this.SetExpanded(!IsExpanded);
            }
        });
        this.Add(headerNode);

        // 2. 正文内容区：Flex Column（展开时可见）
        if (IsExpanded && Content != null) {
            contentNode = new Flex();
            contentNode.ClassName = "collapse-content column";
            contentNode.Add(Content);
            this.Add(contentNode);
        }
    }

    public override bool MountSlot(string slot, Control c) {
        if (slot == "header" || slot == "title") {
            Header = c;
            this.RebuildStructure();
            return true;
        }
        if (slot == "content" || slot == "body" || slot == "default") {
            Content = c;
            this.RebuildStructure();
            return true;
        }
        return base.MountSlot(slot, c);
    }

    public override Control Add(Control child) {
        if (child == null) { return null; }
        if (Content == null) {
            Content = child;
            this.RebuildStructure();
            return child;
        }
        return base.Add(child);
    }

    public override string Kind() { return "CollapseItem"; }

    public override void SyncBinding() {
        base.SyncBinding();
        if (IsExpanded) {
            this.AddClass("expanded");
        }
    }
}
