using System;
using System.Barcode;

namespace Gui.Widget;

// QR Code 编码器的**薄适配**。
//
// **实现已经搬到 System.Barcode（Zan.Barcode 包）**：那里是完整的
// ISO/IEC 18004 编码器 + 解码器（能读回图像里的码）。Gui 侧只保留
// 渲染需要的类型转换，公开签名与行为不变：
//
//   `Encode(text, ecl) -> Gui.Widget.QrMatrix`（不含静区）
//   `ParseEcl(s) -> Gui.Widget.QrEcl`
//
// **为什么不留两份编码器**：两份实现迟早会分叉（掩码罚分、版本选择这种
// 细节最容易被改坏），而规则是"公共机制进包"。Gui 的 QrCode 控件只关心
// 模块矩阵长什么样，不关心它怎么算出来的。
//
// 两个命名空间各有一套 `QrEcl` / `QrMatrix`（Gui 面向控件，System.Barcode
// 面向编解码），所以这里做显式转换：级别按枚举值一一对应，矩阵直接搬
// 模块位图（两边都是行主序 bool[]，不需要逐模块拷贝）。
public class QrEncoder {

    // 按级别编码文本，返回不含静区的模块矩阵。
    public static QrMatrix Encode(string text, QrEcl ecl) {
        System.Barcode.QrMatrix m = System.Barcode.QrEncoder.Encode(
            text, QrEncoder.ToBarcodeEcl(ecl));
        QrMatrix outp = new QrMatrix();
        outp.version = m.version;
        outp.size = m.size;
        outp.ecl = ecl;
        outp.modules = m.modules;
        return outp;
    }

    // 级别名 -> 枚举（大小写均可）；未知返回 M（与 layui 默认一致）。
    public static QrEcl ParseEcl(string s) {
        if (s == null || s.Length != 1) { return QrEcl.M; }
        int b = s[0] & 255;
        if (b == 76 || b == 108) { return QrEcl.L; }  // L/l
        if (b == 81 || b == 113) { return QrEcl.Q; }  // Q/q
        if (b == 72 || b == 104) { return QrEcl.H; }  // H/h
        return QrEcl.M;
    }

    // Gui 级别 -> System.Barcode 级别。
    //
    // 两边枚举值一样（L=0/M=1/Q=2/H=3），但**显式逐个映射**：枚举值一旦
    // 有一边调整，这里会立刻暴露，而不是静默编出错级别的码。
    static System.Barcode.QrEcl ToBarcodeEcl(QrEcl ecl) {
        if (ecl == QrEcl.L) { return System.Barcode.QrEcl.L; }
        if (ecl == QrEcl.Q) { return System.Barcode.QrEcl.Q; }
        if (ecl == QrEcl.H) { return System.Barcode.QrEcl.H; }
        return System.Barcode.QrEcl.M;
    }
}
