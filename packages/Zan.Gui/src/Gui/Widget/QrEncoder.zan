using System;
using System.Barcode;

namespace Gui.Widget;

// QR Code 编码器的**薄适配**。
//
// **实现已经搬到 System.Barcode（Zan.Barcode 包）**：那里是完整的
// ISO/IEC 18004 编码器 + 解码器（能读回图像里的码）。Gui 侧只保留
// 渲染需要的类型转换：
//
//   `Encode(text, ecl) -> Gui.Widget.QrMatrix`（不含静区）
//   `ParseEcl(s) -> Gui.Widget.QrEcl`
//
// **为什么不留两份编码器**：两份实现迟早会分叉（掩码罚分、版本选择这种
// 细节最容易被改坏），而规则是"公共机制进包"。Gui 的 QrCode 控件只关心
// 模块矩阵长什么样，不关心它怎么算出来的。
//
// 两个命名空间各有一套 `QrEcl` / `QrMatrix`（Gui 面向控件，System.Barcode
// 面向编解码），所以这里做显式转换：级别按枚举值一一对应，矩阵直接搬
// 模块位图（两边都是行主序 bool[]，不需要逐模块拷贝）。
//
// ---- 兼容面：抽包前本类上的无修饰符静态成员 ------------------------
//
// 抽包前编码器实现在本类上，那些辅助成员**没有修饰符**——而 Zan 里
// "无修饰符"= 默认跨包可访问（只有 private/protected/internal 才拦），
// 所以它们一直是外部项目的既成公开面，不是"内部实现"。仓库自己的
// gui-design 文档与外部项目都用 `QrEncoder.SeqByteLen(s[i] & 255)`
// 逐字节走 UTF-8 宽度，抽包时把它一起删掉就是**公开面断裂**。
//
// 这里只转发**纯函数**（无表、无共享状态），一份实现仍然只写在
// System.Barcode 里；规格表（EC 分块表、GF 表）在 System.Barcode.QrSpec。
// 其余成员用**全限定名**可达：
//
//   `System.Barcode.QrEncoder.MODE_NUMERIC` / `System.Barcode.QrSpec.EcPerBlock(...)`
//
// 全限定名不会撞名——同时 `using Gui.Widget` 和 `using System.Barcode`
// 会让裸 `QrEncoder` 变成歧义名，那才是要避开的坑。
public class QrEncoder {

    // 按级别编码文本，返回不含静区的模块矩阵。
    public static QrMatrix Encode(string text, QrEcl ecl) {
        System.Barcode.QrMatrix m = System.Barcode.QrEncoder.Encode(
            text, QrEncoder.ToBarcodeEcl(ecl));
        QrMatrix outp = new QrMatrix();
        outp.version = m.version;
        outp.size = m.size;
        outp.ecl = ecl;
        outp.modules = m.modules;
        return outp;
    }

    // 级别名 -> 枚举（大小写均可）；未知返回 M（与 layui 默认一致）。
    public static QrEcl ParseEcl(string s) {
        if (s == null || s.Length != 1) { return QrEcl.M; }
        int b = s[0] & 255;
        if (b == 76 || b == 108) { return QrEcl.L; }  // L/l
        if (b == 81 || b == 113) { return QrEcl.Q; }  // Q/q
        if (b == 72 || b == 104) { return QrEcl.H; }  // H/h
        return QrEcl.M;
    }

    // ---- 兼容面（见文件头）------------------------------------------------
    //
    // 抽包前这些成员在本类上且无修饰符 = 跨包可访问，是外部项目的既成
    // 公开面。这里转发纯函数，行为与实现完全一致。

    // 以 lead 为首字节的 UTF-8 码点字节长度（1-4）。
    //
    // 调用方用它逐字节走文本宽度：Zan 的 string 是 UTF-8 字节串，
    // `s.Length` 是**字节数**不是字数，中文一字三字节。
    public static int SeqByteLen(int lead) {
        return System.Barcode.QrEncoder.SeqByteLen(lead);
    }

    // 字节是否为 ASCII 数字 0-9。
    public static bool IsNumeric(int b) {
        return System.Barcode.QrEncoder.IsNumeric(b);
    }

    // ASCII 字节在 QR 字母数字表中的值（0-44），不在表内时 -1。
    public static int AlnumValueByte(int c) {
        return System.Barcode.QrEncoder.AlnumValueByte(c);
    }

    // 字节 b（UTF-8 首字节）-> 该码点的模式（MODE_NUMERIC / MODE_ALNUM /
    // MODE_BYTE；常量用 `System.Barcode.QrEncoder.MODE_*` 取）。
    public static int ModeOfByte(int b, string text, int pos) {
        return System.Barcode.QrEncoder.ModeOfByte(b, text, pos);
    }

    // Gui 级别 -> System.Barcode 级别。
    //
    // 两边枚举值一样（L=0/M=1/Q=2/H=3），但**显式逐个映射**：枚举值一旦
    // 有一边调整，这里会立刻暴露，而不是静默编出错级别的码。
    static System.Barcode.QrEcl ToBarcodeEcl(QrEcl ecl) {
        if (ecl == QrEcl.L) { return System.Barcode.QrEcl.L; }
        if (ecl == QrEcl.Q) { return System.Barcode.QrEcl.Q; }
        if (ecl == QrEcl.H) { return System.Barcode.QrEcl.H; }
        return System.Barcode.QrEcl.M;
    }
}
