using System;
using Gui;

namespace Gui.Widget;

// 统计组件（Statistic）：纯声明式对象树与 CSS 盒模型（Flex 列排布），包含标题与数值子节点。
// 彻底物理删除 Canvas 手动微绘（DrawText、vy 偏移运算）与即时度量。
public class Statistic : Control {
    public Binding<string> Text;
    public Binding<string> Value;
    public Label labelNode;
    public Label valueNode;

    public override int StyleDisplay() { return 1; } // Flex
    public override int StyleFlexDir() { return 1; } // Column

    private void InitStatistic(string label, string amount) {
        this.InitControl(label, 1);
        this.ClassName = "statistic col gap-small";
        Text = label;
        Value = amount;
        labelNode = new Label(label);
        labelNode.ClassName = "statistic-title text-secondary";
        valueNode = new Label(amount);
        valueNode.ClassName = "statistic-value font-huge font-bold";
        this.BuildTree();
    }

    public Statistic() { InitStatistic("", ""); }
    public Statistic(string label, string amount) { InitStatistic(label, amount); }

    public string Label() {
        if (Text == null) { return ""; }
        return Text.Get();
    }

    public string Amount() {
        if (Value == null) { return ""; }
        return Value.Get();
    }

    public void BuildTree() {
        this.RemoveAll();
        if (labelNode != null) {
            labelNode.Text = this.Label();
            this.Add(labelNode);
        }
        if (valueNode != null) {
            valueNode.Text = this.Amount();
            this.Add(valueNode);
        }
    }

    public override void SyncBinding() {
        base.SyncBinding();
        if (labelNode != null) { labelNode.Text = this.Label(); }
        if (valueNode != null) { valueNode.Text = this.Amount(); }
    }

    // 控件类型标识（序列化/设计器用）。
    public override void CloneContentTo(Control target, CloneTreeFn clone) {
        // Constructor and property replay recreate the generated parts.
    }

    public override string Kind() { return "Statistic"; }

    public override List<PropSpec> Props() {
        List<PropSpec> ps = new List<PropSpec>();
        PropSpec text = PropSpec.Text("text", "Text");
        text.str = Text;
        ps.Add(text);
        PropSpec amount = PropSpec.Text("value", "Value");
        amount.str = Value;
        ps.Add(amount);
        return ps;
    }
}
