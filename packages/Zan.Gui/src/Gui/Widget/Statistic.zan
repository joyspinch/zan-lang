using System;
using Gui;
namespace Gui.Widget;
public class Statistic : Control {
    public override Control CreateCloneShell() { return new Statistic(); }
    public Binding<string> Text;
    public Binding<string> Value;
    public Label labelNode;
    public Label valueNode;
    public override int StyleDisplay() { return 1; } // Flex
    public override int StyleFlexDir() { return 1; } // Column
    private void InitStatistic(string label, string amount) {
        string safeLabel = label != null ? label : "";
        string safeAmount = amount != null ? amount : "";
        this.InitControl(safeLabel);
        this.ClassName = "statistic col gap-small";
        Text = safeLabel;
        Value = safeAmount;
        labelNode = new Label(safeLabel);
        labelNode.ClassName = "statistic-title text-secondary";
        valueNode = new Label(safeAmount);
        valueNode.ClassName = "statistic-value font-huge font-bold";
        this.BuildTree();
    }
    public Statistic() { InitStatistic("", ""); }
    public Statistic(string label, string amount) { InitStatistic(label, amount); }
    public string Label() {
        if (Text == null) { return ""; }
        string s = Text.Get();
        return s != null ? s : "";
    }
    public string Amount() {
        if (Value == null) { return ""; }
        string s = Value.Get();
        return s != null ? s : "";
    }
    private static void SyncLabelText(Label node, string text) {
        if (node == null || node.GetText() == text) { return; }
        if (node.Text != null) { node.Text.Set(text); } else { node.Text = text; }
    }
    public void BuildTree() {
        this.RemoveAll();
        if (labelNode != null) {
            Statistic.SyncLabelText(labelNode, this.Label());
            this.Add(labelNode);
        }
        if (valueNode != null) {
            Statistic.SyncLabelText(valueNode, this.Amount());
            this.Add(valueNode);
        }
    }
    public override void SyncBinding() {
        base.SyncBinding();
        Statistic.SyncLabelText(labelNode, this.Label());
        Statistic.SyncLabelText(valueNode, this.Amount());
    }
    public override void CloneContentTo(Control target, CloneTreeFn clone) {
    }

    protected override List<PropSpec> DefineProps() {
        List<PropSpec> ps = new List<PropSpec>();
        ps.Add(PropSpec.TextField("Text"));
        ps.Add(PropSpec.Text("value", "Value").DefaultBinding().Field("Value"));
        return ps;
    }
}
