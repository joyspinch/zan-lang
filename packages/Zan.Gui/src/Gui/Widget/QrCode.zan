using System;
using System.IO;
using System.Drawing.Imaging;
using Gui;
namespace Gui.Widget;
public class QrCode : Control {
    public override Control CreateCloneShell() { return new QrCode(); }
    public Binding<string> Text;
    public Binding<string> Ecl;
    public Binding<int> Size;
    public Binding<int> Dark;
    public Binding<int> Light;
    public Binding<int> Margin;
    public Binding<string> Logo;
    public Binding<int> LogoPct;
    // 内容/属性变化时触发。
    [Event]
    public UiEvent Change;
    private string cacheKey;
    private QrMatrix cacheMx;
    private void InitQr() {
        this.InitControl("qrcode");
        Text = "";
        Ecl = "M";
        Size = 0;
        Dark = 0;
        Light = 0;
        Margin = 4;
        Logo = "";
        LogoPct = 18;
        cacheKey = "";
        cacheMx = null;
        Change = new UiEvent();
        wiresOwnEvents = true;
    }
    public QrCode() { this.InitQr(); }
    public QrCode(string text) {
        this.InitQr();
        Text = text;
    }
    // 覆写：返回设计器属性清单（text/ecl/size/dark/light/margin/
    // logo/logoPct）。
    protected override List<PropSpec> DefineProps() {
        List<PropSpec> ps = new List<PropSpec>();
        ps.Add(PropSpec.Text("text", "Content").Field("Text").WithTip("Encoded content (URL, text, ...)."));
        PropSpec ec = PropSpec.Enum("ecl", "Error level",
        new List<string>{ "L", "M", "Q", "H" });
        ec.Field("Ecl");
        ec.WithTip("Reed-Solomon correction level; raised to H with a logo.");
        ps.Add(ec);
        ps.Add(PropSpec.Int("size", "Size px")
            .Field("Size")
            .Step(8, 0, 2048)
            .WithTip("Edge length in logical px (0 = CSS box / auto)."));
        ps.Add(PropSpec.Color("dark", "Dark color").Field("Dark"));
        ps.Add(PropSpec.Color("light", "Light color").Field("Light"));
        ps.Add(PropSpec.Int("margin", "Margin (modules)").Field("Margin").Step(1, 0, 16));
        ps.Add(PropSpec.Text("logo", "Logo image")
            .Field("Logo")
            .WithTip("Image overlaid at the centre; forces error level H."));
        ps.Add(PropSpec.Int("logoPct", "Logo %").Field("LogoPct").Step(1, 1, 30));
        return ps;
    }

    // ---- 绘制 -----------------------------------------------------------

    // 覆写：按模块数与盒宽量出正方形首选尺寸。
    public override void OnMeasure(App app) {
        int margin = this.Margin.Get();
        if (margin < 0) { margin = 0; }
        int mods = this.Matrix().size + 2 * margin;
        int px = this.BoxPx(app, mods);
        prefW = px;
        prefH = px;
    }
    public override void OnPaint(App app) {
        int x = bx;
        int y = by;
        QrMatrix mx = this.Matrix();
        int margin = this.Margin.Get();
        if (margin < 0) { margin = 0; }
        int mods = mx.size + 2 * margin;
        int box = this.BoxPx(app, mods);
        int cell = box / mods;
        if (cell < 1) { cell = 1; }
        int dark = this.EffectiveDark(app);
        int light = this.EffectiveLight(app);
        Canvas c = app.canvas;
        c.FillRect(x, y, mods * cell, mods * cell, light);
        for (int my = 0; my < mx.size; my = my + 1) {
            int runStart = -1;
            for (int mxp = 0; mxp <= mx.size; mxp = mxp + 1) {
                bool d = mxp < mx.size && mx.Get(mxp, my);
                if (d && runStart < 0) { runStart = mxp; }
                if (!d && runStart >= 0) {
                    c.FillRect(x + (runStart + margin) * cell,
                    y + (my + margin) * cell,
                    (mxp - runStart) * cell, cell, dark);
                    runStart = -1;
                }
            }
        }
        this.PaintLogo(app, c, mx, margin, cell, x, y);
    }
    private void PaintLogo(App app, Canvas c, QrMatrix mx, int margin, int cell,
    int x, int y) {
        string src = Logo.Get();
        if (src == null) { src = ""; }
        if (src == "") { return; }
        if (Canvas.ImageWidth(src) <= 0) { return; }
        int pct = LogoPct.Get();
        if (pct < 1) { pct = 1; }
        if (pct > 30) { pct = 30; }
        int full = mx.size + 2 * margin;
        int side = full * cell * pct / 100;
        if (side < 2) { return; }
        int back = side + 2 * (side / 8 + 1);
        int ox = x + (full * cell - back) / 2;
        int oy = y + (full * cell - back) / 2;
        c.FillRect(ox, oy, back, back, this.EffectiveLight(app));
        c.BlitImage(src, ox + (back - side) / 2, oy + (back - side) / 2,
        side, side, 0, 0, 0, 0);
    }
    private int BoxPx(App app, int mods) {
        if (Size != null && Size.Get() > 0) { return app.Scale(Size.Get()); }
        StyleBox s = this.ResolveStyleCached(app, this.StyleType(), Class,
        Style.SNormal());
        int cssW = s.WidthOr(0);
        if (cssW > 0) { return app.Scale(cssW); }
        return app.Scale(6) * mods;
    }
    private int EffectiveDark(App app) {
        if (Dark != null && Dark.Get() != 0) { return Dark.Get(); }
        StyleBox s = this.ResolveStyleCached(app, this.StyleType(), Class,
        Style.SNormal());
        return s.FgOr(0xFF000000);
    }
    private int EffectiveLight(App app) {
        if (Light != null && Light.Get() != 0) { return Light.Get(); }
        StyleBox s = this.ResolveStyleCached(app, this.StyleType(), Class,
        Style.SNormal());
        return s.BgOr(0xFFFFFFFF);
    }
    private QrEcl EffectiveEcl() {
        QrEcl r = QrEncoder.ParseEcl(Ecl.Get());
        string lg = Logo.Get();
        if (lg != null && lg != "") {
            if ((int)r < (int)QrEcl.H) { r = QrEcl.H; }
        }
        return r;
    }
    public QrMatrix Matrix() {
        string text = Text.Get();
        if (text == null) { text = ""; }
        string logo = Logo.Get();
        if (logo == null) { logo = ""; }
        string key = Convert.ToString(text.Length) + ":" + text
        + "|" + Ecl.Get() + "|" + logo;
        if (key != cacheKey || cacheMx == null) {
            cacheKey = key;
            cacheMx = QrEncoder.Encode(text, this.EffectiveEcl());
        }
        return cacheMx;
    }
    public string ToSvg() {
        int px = this.ExportBox();
        return QrCode.SvgOf(this.Matrix(), this.Margin.Get(),
        this.ExportDark(), this.ExportLight(), px);
    }
    public byte[] ToPngBytes() {
        int px = this.ExportBox();
        return QrCode.PngOf(this.Matrix(), this.Margin.Get(),
        this.ExportDark(), this.ExportLight(), px);
    }
    public int SavePng(string path) {
        byte[] data = this.ToPngBytes();
        File.WriteAllBytes(path, data);
        return data.Length;
    }
    private int ExportBox() {
        QrMatrix mx = this.Matrix();
        int margin = this.Margin.Get();
        if (margin < 0) { margin = 0; }
        int mods = mx.size + 2 * margin;
        if (Size != null && Size.Get() > 0) { return Size.Get(); }
        return mods * 6;
    }
    private int ExportDark() {
        if (Dark != null && Dark.Get() != 0) { return Dark.Get(); }
        return 0xFF000000;
    }
    private int ExportLight() {
        if (Light != null && Light.Get() != 0) { return Light.Get(); }
        return 0xFFFFFFFF;
    }
    public static string SvgOf(QrMatrix mx, int margin, int dark, int light,
    int boxPx) {
        if (margin < 0) { margin = 0; }
        int mods = mx.size + 2 * margin;
        int cell = boxPx / mods;
        if (cell < 1) { cell = 1; }
        int px = mods * cell;
        string svg = "<svg xmlns=\"http:  // www.w3.org/2000/svg\" width=\""
        + Convert.ToString(px) + "\" height=\"" + Convert.ToString(px)
        + "\" viewBox=\"0 0 " + Convert.ToString(px) + " "
        + Convert.ToString(px) + "\">\n";
        svg = svg + "<rect width=\"100%\" height=\"100%\" fill=\""
        + QrCode.HexColor(light) + "\"/>\n";
        svg = svg + "<g fill=\"" + QrCode.HexColor(dark) + "\">\n";
        for (int my = 0; my < mx.size; my = my + 1) {
            int runStart = -1;
            for (int mxp = 0; mxp <= mx.size; mxp = mxp + 1) {
                bool d = mxp < mx.size && mx.Get(mxp, my);
                if (d && runStart < 0) { runStart = mxp; }
                if (!d && runStart >= 0) {
                    svg = svg + "<rect x=\""
                    + Convert.ToString((runStart + margin) * cell)
                    + "\" y=\"" + Convert.ToString((my + margin) * cell)
                    + "\" width=\""
                    + Convert.ToString((mxp - runStart) * cell)
                    + "\" height=\"" + Convert.ToString(cell) + "\"/>\n";
                    runStart = -1;
                }
            }
        }
        svg = svg + "</g>\n</svg>\n";
        return svg;
    }
    public static string HexColor(int argb) {
        string outp = "#";
        int r = (argb >> 16) & 255;
        int g = (argb >> 8) & 255;
        int b = argb & 255;
        outp = outp + QrCode.HexNib(r / 16) + QrCode.HexNib(r % 16);
        outp = outp + QrCode.HexNib(g / 16) + QrCode.HexNib(g % 16);
        outp = outp + QrCode.HexNib(b / 16) + QrCode.HexNib(b % 16);
        return outp;
    }
    public static string HexNib(int v) {
        if (v < 10) { return Convert.ToString(v); }
        if (v == 10) { return "a"; }
        if (v == 11) { return "b"; }
        if (v == 12) { return "c"; }
        if (v == 13) { return "d"; }
        if (v == 14) { return "e"; }
        return "f";
    }
    public static byte[] PngOf(QrMatrix mx, int margin, int dark, int light,
    int boxPx) {
        if (margin < 0) { margin = 0; }
        int mods = mx.size + 2 * margin;
        int cell = boxPx / mods;
        if (cell < 1) { cell = 1; }
        int w = mods * cell;
        int dr = (dark >> 16) & 255;
        int dg = (dark >> 8) & 255;
        int db = dark & 255;
        int lr = (light >> 16) & 255;
        int lg = (light >> 8) & 255;
        int lb = light & 255;
        int stride = w * 3;
        byte[] raw = new byte[stride * w];
        int pos = 0;
        for (int my = 0 - margin; my < mx.size + margin; my = my + 1) {
            for (int rep = 0; rep < cell; rep = rep + 1) {
                for (int mxp = 0; mxp < mods; mxp = mxp + 1) {
                    bool d = false;
                    if (my >= 0 && my < mx.size && mxp >= margin
                    && mxp < mx.size + margin) {
                        d = mx.Get(mxp - margin, my);
                    }
                    int r = d ? dr : lr;
                    int g = d ? dg : lg;
                    int b = d ? db : lb;
                    for (int px = 0; px < cell; px = px + 1) {
                        raw[pos] = (byte)r;
                        raw[pos + 1] = (byte)g;
                        raw[pos + 2] = (byte)b;
                        pos = pos + 3;
                    }
                }
            }
        }
        return Png.EncodeRgb(w, w, raw);
    }
}
