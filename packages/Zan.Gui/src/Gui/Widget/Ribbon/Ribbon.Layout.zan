using System;
using Gui;
namespace Gui.Widget;
public partial class Ribbon {
    private static int OverflowButtonW(App app) { return app.Scale(28); }
    private static string T(string en, string zh) { return Lang.Tr(en, zh); }
    public static int Height(App app) { return app.Scale(72); }
    public static int TabStripHeight(App app) { return app.Scale(30); }
    public static int HeightTabbed(App app) { return Ribbon.TabStripHeight(app) + app.Scale(96); }
    public static int HeightGroups(App app) { return app.Scale(76); }
    private static int SmallColW(App app, RibbonGroup grp, bool compact, RibbonFit fit, int start) {
        Theme t = app.theme;
        StyleBox textStyle = Style.Part(app, "ribbon", "item", "",
                                        "", "", Style.SNormal());
        int fontSize = textStyle.FontOr(Style.FontFallback(app, "small"));
        int smallW = app.Scale(72);
        for (int m = 0; m < grp.items.Count; m = m + 1) {
            RibbonItem mi = grp.items[m];
            if (mi.tile || !mi.small) { continue; }
            if (compact) { continue; }
            int flat = start + m;
            if (fit.dropped.Count > flat && fit.dropped[flat]) { continue; }
            int mw;
            if (fit.widths.Count > flat) { mw = fit.widths[flat]; }
            else {
                mw = Canvas.MeasureText(mi.label, fontSize)
                    + t.iconSizeSmall + app.Scale(22);
                if (mi.menu) { mw = mw + app.Scale(10); }
            }
            if (mw > smallW) { smallW = mw; }
        }
        return smallW;
    }
    public static RibbonLayout Layout(App app, List<RibbonGroup> groups, int bh,
                                      int rows, RibbonFit fit) {
        Theme t = app.theme;
        RibbonLayout lay = new RibbonLayout();
        if (rows < 1) { rows = 1; }
        int titleH = app.Scale(16);
        int contentH = bh - titleH - t.paddingSmall * 2;
        int rowH = contentH / rows;
        int tileW = rowH;
        int cx = t.paddingSmall;
        int flat = 0;
        for (int g = 0; g < groups.Count; g = g + 1) {
            RibbonGroup grp = groups[g];
            bool cp = fit.compact.Count > g ? fit.compact[g] : false;
            int smallW = Ribbon.SmallColW(app, grp, cp, fit, flat);
            int compactW = tileW;
            for (int j = 0; j < grp.items.Count; j = j + 1) {
                int idx = flat + j;
                RibbonItem item = grp.items[j];
                if (!item.tile && !(cp && item.small)) { continue; }
                if (fit.dropped.Count > idx && fit.dropped[idx]) { continue; }
                if (fit.tileWidths.Count > idx && fit.tileWidths[idx] > compactW) { compactW = fit.tileWidths[idx]; }
            }
            int groupStartX = cx;
            int sIdx = 0;
            int curKind = 0 - 1;
            int curW = 0;
            int kept = 0;
            for (int j = 0; j < grp.items.Count; j = j + 1) {
                RibbonItem it = grp.items[j];
                bool gone = fit.dropped.Count > flat ? fit.dropped[flat] : false;
                int myFlat = flat;
                flat = flat + 1;
                if (gone) { continue; }
                kept = kept + 1;
                int kind = 0;
                bool asTile = it.tile || (cp && it.small);
                if (asTile) { kind = 2; }
                else if (it.small) { kind = 1; }
                if (kind != curKind && sIdx % rows != 0) {
                    cx = cx + curW;
                    sIdx = 0;
                }
                curKind = kind;
                RibbonSlot s = new RibbonSlot();
                s.flat = myFlat;
                s.group = g;
                s.item = j;
                s.cmd = it;
                s.kind = kind;
                if (kind == 0) {
                    if (sIdx % rows != 0) { cx = cx + curW; sIdx = 0; }
                    s.x = cx;
                    s.y = 0;
                    s.w = app.Scale(64);
                    if (fit.widths.Count > myFlat && fit.widths[myFlat] > s.w) { s.w = fit.widths[myFlat]; }
                    s.h = contentH;
                    cx = cx + s.w;
                } else {
                    int colW = smallW;
                    if (kind == 2) { colW = compactW; }
                    curW = colW;
                    s.x = cx;
                    s.y = (sIdx % rows) * rowH;
                    s.w = colW;
                    s.h = rowH;
                    sIdx = sIdx + 1;
                    if (sIdx % rows == 0) { cx = cx + colW; }
                }
                lay.slots.Add(s);
            }
            if (kept == 0) { continue; }
            if (sIdx % rows != 0) { cx = cx + curW; }
            RibbonGroupBox box = new RibbonGroupBox();
            box.group = g;
            box.startX = groupStartX;
            box.endX = cx;
            lay.boxes.Add(box);
            cx = cx + t.paddingSmall * 2 + 1;
        }
        lay.width = cx + t.paddingSmall;
        return lay;
    }
    public static int BandWidthFit(App app, List<RibbonGroup> groups, int bh,
                                   int rows, RibbonFit fit) {
        return Ribbon.Layout(app, groups, bh, rows, fit).width;
    }
    public static int BandWidth(App app, List<RibbonGroup> groups, int bh, int rows) {
        return Ribbon.BandWidthFit(app, groups, bh, rows, Ribbon.FitNone(groups));
    }
    public static int BandWidthFitted(App app, List<RibbonGroup> groups, int bh,
                                      int rows, int w) {
        return Ribbon.BandWidthFit(app, groups, bh, rows,
            Ribbon.Fit(app, groups, bh, rows, w));
    }
    private static bool HasLabeledSmall(RibbonGroup grp) {
        for (int m = 0; m < grp.items.Count; m = m + 1) {
            RibbonItem mi = grp.items[m];
            if (mi.small && !mi.tile) { return true; }
        }
        return false;
    }
    private static RibbonItem ItemAt(List<RibbonGroup> groups, int flat) {
        int n = 0;
        for (int g = 0; g < groups.Count; g = g + 1) {
            RibbonGroup grp = groups[g];
            for (int j = 0; j < grp.items.Count; j = j + 1) {
                if (n == flat) { return grp.items[j]; }
                n = n + 1;
            }
        }
        return null;
    }
    private static int GroupStart(List<RibbonGroup> groups, int g) {
        int n = 0;
        int i = 0;
        while (i < g && i < groups.Count) {
            n = n + groups[i].items.Count;
            i = i + 1;
        }
        return n;
    }
    private static int VisibleCount(RibbonGroup grp, int start, RibbonFit fit) {
        int n = 0;
        for (int j = 0; j < grp.items.Count; j = j + 1) {
            bool gone = fit.dropped.Count > start + j ? fit.dropped[start + j] : false;
            if (!gone) { n = n + 1; }
        }
        return n;
    }
    private static RibbonFit FitNone(List<RibbonGroup> groups) {
        RibbonFit fit = new RibbonFit();
        int g = 0;
        while (g < groups.Count) {
            fit.compact.Add(false);
            RibbonGroup grp = groups[g];
            int j = 0;
            while (j < grp.items.Count) { fit.dropped.Add(false); j = j + 1; }
            g = g + 1;
        }
        return fit;
    }
    public static RibbonFit Fit(App app, List<RibbonGroup> groups, int bh,
                                int rows, int w, RibbonFit measured = null) {
        RibbonFit fit = Ribbon.FitNone(groups);
        if (measured != null) { fit.widths = measured.widths; fit.tileWidths = measured.tileWidths; }
        int need = Ribbon.BandWidthFit(app, groups, bh, rows, fit);
        int gi = groups.Count - 1;
        while (gi >= 0 && need > w) {
            RibbonGroup grp = groups[gi];
            int start = Ribbon.GroupStart(groups, gi);
            int idx = start + grp.items.Count - 1;
            while (idx >= start && need > w) {
                RibbonItem it = Ribbon.ItemAt(groups, idx);
                if (it != null && it.optional) {
                    fit.dropped[idx] = true;
                    need = Ribbon.BandWidthFit(app, groups, bh, rows, fit);
                }
                idx = idx - 1;
            }
            if (need > w && Ribbon.HasLabeledSmall(grp)) {
                fit.compact[gi] = true;
                need = Ribbon.BandWidthFit(app, groups, bh, rows, fit);
            }
            gi = gi - 1;
        }
        return fit;
    }
}
