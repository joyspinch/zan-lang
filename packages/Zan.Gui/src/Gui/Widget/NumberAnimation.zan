using System;
using Gui;
using Gui.Backend;
namespace Gui.Widget;
public class NumberAnimation : Control {
    public override Control CreateCloneShell() { return new NumberAnimation(); }
    public Binding<int> From;
    public Binding<int> To;
    public Binding<int> Duration;
    public Binding<bool> Active;
    public Binding<int> Precision;
    public Binding<string> Separator;
    public Binding<string> Decimal;
    public Binding<string> Prefix;
    public Binding<string> Suffix;
    // 动画到位（每轮仅触发一次；Restart 或改 To 重摆后再次到位会
    // 再触发）。
    [Event]
    public UiEvent Finish;
    private int curScaled;  // 当前显示值（scaled）
    private int fromS, toS, durS;  // SyncProps 快照
    private int precS;  // 精度快照
    private string sepS, decS, preS, sufS;  // 展示符快照
    private int elapsedMs;  // 已累计的走动毫秒（Active 为 true 才累加）
    private int lastTickMs;  // 上次 Tick 的时刻；-1 表示下一拍重定基准
    private int lastFrom, lastTo, lastDur;  // 探测 From/To/Duration 绑定变化
    private bool activeNow;
    private bool finished;  // 本轮已触发 Finish
    private void InitNumberAnimation(int from, int to, int dur) {
        this.InitControl("numberanim");
        From = from;
        To = to;
        Duration = dur;
        Active = true;
        Precision = 0;
        Separator = ",";
        Decimal = ".";
        Prefix = "";
        Suffix = "";
        Finish = new UiEvent();
        curScaled = from;
        fromS = from;
        toS = to;
        durS = dur < 1 ? 1 : dur;
        lastFrom = from;
        lastTo = to;
        lastDur = durS;
        precS = 0;
        sepS = ",";
        decS = ".";
        preS = "";
        sufS = "";
        elapsedMs = 0;
        lastTickMs = 0 - 1;
        activeNow = true;
        finished = false;
    }
    public NumberAnimation() { InitNumberAnimation(0, 0, 2000); }
    public NumberAnimation(int to) { InitNumberAnimation(0, to, 2000); }
    public NumberAnimation(int from, int to) { InitNumberAnimation(from, to, 2000); }
    public NumberAnimation(int from, int to, int durationMs) { InitNumberAnimation(from, to, durationMs); }
    public int Value() { return curScaled; }
    public string CurrentText() { return this.DisplayText(); }
    public void SetRange(double from, double to) {
        int p = precS;
        int scale = InputNumber.Pow10(p);
        int f = NumberAnimation.ScaleIt(from, scale);
        int t = NumberAnimation.ScaleIt(to, scale);
        this.Arm(f, t, durS);
    }
    public static int ScaleIt(double v, int scale) {
        long s = (long)scale;
        long x = (long)(v * (double)s + (v < 0.0 ? -0.5 : 0.5));
        if (x > 2147483647) { x = 2147483647; }
        if (x < 0 - 2147483647) { x = 0 - 2147483647; }
        return (int)x;
    }
    public void Restart() {
        this.SyncProps(Window.GetTickMs());
        this.Arm(lastFrom, lastTo, lastDur);
    }
    public void Arm(int from, int to, int dur) {
        fromS = from;
        toS = to;
        durS = dur < 1 ? 1 : dur;
        lastFrom = from;
        lastTo = to;
        lastDur = durS;
        curScaled = fromS;
        elapsedMs = 0;
        lastTickMs = 0 - 1;
        finished = false;
    }
    public void Tick(int nowMs) {
        if (lastTickMs < 0) { lastTickMs = nowMs; }
        if (activeNow) {
            int dt = nowMs - lastTickMs;
            if (dt > 0) { elapsedMs = elapsedMs + dt; }
        }
        lastTickMs = nowMs;
        int p = elapsedMs * 1000 / durS;
        if (p > 1000) { p = 1000; }
        curScaled = NumberAnimation.ValueAt(fromS, toS, App.Ease(p));
        if (p >= 1000) {
            if (!finished) {
                finished = true;
                Finish.Raise(this);
            }
        } else {
            finished = false;
        }
    }
    public void SyncProps(int nowMs) {
        int fr = lastFrom;
        int tt = lastTo;
        int du = lastDur;
        if (From != null) { fr = From.Get(); }
        if (To != null) { tt = To.Get(); }
        if (Duration != null) {
            du = Duration.Get();
            if (du < 1) { du = 1; }
        }
        bool act = true;
        if (Active != null) { act = Active.Get(); }
        if (act != activeNow) {
            if (act) {
                lastTickMs = 0 - 1;
            } else if (lastTickMs >= 0) {
                int dt = nowMs - lastTickMs;
                if (dt > 0) { elapsedMs = elapsedMs + dt; }
                lastTickMs = nowMs;
            }
            activeNow = act;
        }
        int pr = precS;
        if (Precision != null) {
            pr = Precision.Get();
            if (pr < 0) { pr = 0; }
            if (pr > 6) { pr = 6; }
        }
        precS = pr;
        if (Separator != null) { sepS = Separator.Get(); }
        if (Decimal != null) { decS = Decimal.Get(); }
        if (Prefix != null) { preS = Prefix.Get(); }
        if (Suffix != null) { sufS = Suffix.Get(); }
        if (fr != lastFrom || tt != lastTo || du != lastDur) { this.Arm(fr, tt, du); }
    }
    public string DisplayText() {
        string t = NumberAnimation.Format(curScaled, precS, sepS, decS);
        string p = preS; if (p == null) { p = ""; }
        string s = sufS; if (s == null) { s = ""; }
        return p + t + s;
    }
    public static int ValueAt(int from, int to, int e) {
        if (e <= 0) { return from; }
        if (e >= 1000) { return to; }
        long d = (long)to - from;
        long half = d >= 0 ? 500 : -500;
        long v = from + (d * e + half) / 1000;
        if (v > 2147483647) { v = 2147483647; }
        if (v < 0 - 2147483647) { v = 0 - 2147483647; }
        return (int)v;
    }
    public static string Format(int scaled, int precision, string sep, string dec) {
        int pr = precision;
        if (pr < 0) { pr = 0; }
        if (pr > 6) { pr = 6; }
        string d = dec;
        if (d == null || d == "") { d = "."; }
        int scale = InputNumber.Pow10(pr);
        string sign = "";
        long v = scaled;
        if (v < 0) { sign = "-"; v = 0 - v; }
        string ip = Convert.ToString((int)(v / (long)scale));
        if (sep != null && sep != "") { ip = NumberAnimation.GroupWith(ip, sep); }
        string body = ip;
        if (pr > 0) {
            string fp = Convert.ToString((int)(v % (long)scale));
            while (fp.Length < pr) { fp = "0" + fp; }
            body = ip + d + fp;
        }
        return sign + body;
    }
    public static string GroupWith(string s, string sep) {
        if (s == "" || sep == null || sep == "") { return s; }
        int dot = s.IndexOf(".");
        string head = s;
        string tail = "";
        if (dot >= 0) {
            head = s.Substring(0, dot);
            tail = s.Substring(dot, s.Length - dot);
        }
        string sign = "";
        if (head.StartsWith("-")) {
            sign = "-";
            head = head.Substring(1, head.Length - 1);
        }
        StringBuilder outp = new StringBuilder();
        int rem = head.Length % 3;
        if (rem == 0) { rem = 3; }
        int start = 0;
        if (rem < head.Length) {
            outp.Append(head.Substring(0, rem));
            start = rem;
            while (start < head.Length) {
                outp.Append(sep);
                outp.Append(head.Substring(start, 3));
                start = start + 3;
            }
        } else {
            outp.Append(head);
        }
        return sign + outp.ToString() + tail;
    }
    public override void OnMeasure(App app) {
        this.SyncProps(Window.GetTickMs());
        StyleBox s = this.ResolvePartAs(app, "numberanim", "value", "text",
                                        Class, Style.SNormal());
        int f = s.FontOr(Style.FontFallback(app, "large"));
        int pad = app.Scale(12);
        int inset = app.Scale(8);
        int barH = app.Scale(4);
        string a = this.DisplayTextOf(fromS);
        string b = this.DisplayTextOf(toS);
        int wa = Canvas.MeasureText(a, f);
        int wb = Canvas.MeasureText(b, f);
        int wmax = wa > wb ? wa : wb;
        prefW = wmax + pad * 2 + app.Scale(2);
        prefH = Canvas.FontHeight(f) + inset * 2 + barH + inset / 2;
    }
    private string DisplayTextOf(int scaled) {
        string t = NumberAnimation.Format(scaled, precS, sepS, decS);
        string p = preS; if (p == null) { p = ""; }
        string s = sufS; if (s == null) { s = ""; }
        return p + t + s;
    }
    public override void OnPaint(App app) {
        this.SyncProps(Window.GetTickMs());
        this.Tick(Window.GetTickMs());
        Canvas c = app.canvas;
        int st = activeNow ? Style.SNormal() : Style.SDisabled();
        StyleBox fontS = this.ResolvePartAs(app, "numberanim", "value", "text",
                                            Class, Style.SNormal());
        int f = fontS.FontOr(Style.FontFallback(app, "large"));
        StyleBox s = this.ResolvePartAs(app, "numberanim", "value", "text",
                                        Class, st);
        StyleBox box = this.ResolvePartAs(app, "numberanim", "box", "",
                                          Class, st);
        StyleBox trackS = this.ResolvePartAs(app, "numberanim", "track", "",
                                             Class, st);
        StyleBox fillS = this.ResolvePartAs(app, "numberanim", "fill", "",
                                            Class, st);
        int fh = Canvas.FontHeight(f);
        int pad = app.Scale(12);
        int inset = app.Scale(8);
        int barH = app.Scale(4);
        bool card = bw > pad * 2 + app.Scale(48)
            && bh > fh + inset * 2 + barH + inset / 2;
        if (card) {
            int radius = box.RadiusOr(app.Scale(12));
            c.FillRoundRect(bx, by, bw, bh, radius, box.BgOr(0));
            int border = box.BorderOr(0);
            int borderW = box.BorderWOr(0);
            if (borderW > 0 && border != 0) { c.DrawRoundRect(bx, by, bw, bh, radius, border, borderW); }
        }
        int textY = by;
        int textH = bh;
        if (card) {
            textY = by + inset;
            textH = bh - inset * 2 - barH - inset / 2;
        }
        c.DrawTextCentered(bx, textY, bw, textH, this.DisplayText(),
                           s.FgOr(0), f);
        if (card) {
            int trackW = bw - pad * 2;
            int trackY = by + bh - inset - barH;
            c.FillRoundRect(bx + pad, trackY, trackW, barH, barH / 2,
                            trackS.BgOr(0));
            int p = elapsedMs * 1000 / durS;
            if (p > 1000) { p = 1000; }
            long fillW = (long)p * trackW / 1000;
            if (fillW < 0) { fillW = 0; }
            if (fillW > trackW) { fillW = trackW; }
            if (fillW > 0) {
                c.FillRoundRect(bx + pad, trackY, (int)fillW, barH,
                                barH / 2, fillS.BgOr(0));
            }
        }
        if (activeNow && !finished && bw > 0 && bh > 0) { app.RequestAnimationFrameIn(bx, by, bw, bh); }
    }
    // ---- 设计器 / 序列化模型 ---------------------------------------

    // 覆写：返回设计器属性清单（to/from/duration/active/precision/
    protected override List<PropSpec> DefineProps() {
        List<PropSpec> ps = new List<PropSpec>();
        ps.Add(PropSpec.Int("to", "To (scaled)")
            .Field("To")
            .Step(1, 0 - 2147483647, 2147483647)
            .WithTip("End value in scaled units (display * 10^Precision). Changing it re-arms and replays."));
        ps.Add(PropSpec.Int("from", "From (scaled)")
            .Field("From")
            .Step(0 - 2147483647, 0 - 2147483647, 2147483647)
            .WithTip("Start value in scaled units. Changing it re-arms and replays."));
        ps.Add(PropSpec.Int("duration", "Duration (ms)")
            .Field("Duration")
            .Step(100, 1, 600000)
            .WithTip("Roll length in ms (clamped >= 1); changing it re-arms."));
        ps.Add(PropSpec.BoolField("Active")
            .WithTip("false pauses (freeze current value); true resumes without a jump."));
        ps.Add(PropSpec.IntField("Precision")
            .Step(1, 0, 6)
            .WithTip("Decimal places 0..6 (does NOT re-arm; display only)."));
        ps.Add(PropSpec.TextField("Separator")
            .WithTip("Thousands separator; \"\" disables grouping. Default \",\"."));
        ps.Add(PropSpec.TextField("Decimal")
            .WithTip("Decimal point string (ru-RU uses \",\"). Default \".\"."));
        ps.Add(PropSpec.TextField("Prefix")
            .WithTip("Text before the number (e.g. currency sign). Default \"\"."));
        ps.Add(PropSpec.TextField("Suffix").WithTip("Text after the number (e.g. \" 条群消息\"). Default \"\"."));
        return ps;
    }
}
