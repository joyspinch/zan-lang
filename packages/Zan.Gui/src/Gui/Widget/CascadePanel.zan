using System;
using System.Collections.Generic;
using Gui;
namespace Gui.Widget;
public class CascadePanel : Control {
    public weak SelectBox box;
    public CascadePanel(SelectBox sb) {
        this.InitControl("cascade-panel");
        this.box = sb;
    }
    public override void OnMeasure(App app) {
        SelectBox s = box;
        if (app == null || s == null) { return; }
        int optH = s.lastH > 0 ? s.lastH : app.theme.heightMedium;
        int visRows = s.maxVisible;
        if (visRows < 4) { visRows = 4; }
        int fbH = s.FilterBarH(app);
        int sbMargin = app.Scale(8);
        int chrome = 0;
        if (s.filterable && fbH > 0) { chrome = fbH + sbMargin * 2; }
        int viewH = OverlayPopup.FitH(app, visRows * optH + chrome);
        bool filtering = s.filterable && s.filterText != "";
        int nCols = 1;
        int colW = s.bw;
        if (filtering) {
            if (colW < app.Scale(220)) { colW = app.Scale(220); }
            prefW = colW;
        } else {
            int pCount = s.cascadePath != null ? s.cascadePath.Count : 0;
            nCols = pCount + 1;
            if (nCols > 4) { nCols = 4; }
            if (colW < app.Scale(160)) { colW = app.Scale(160); }
            prefW = colW * nCols;
        }
        if (app.canvas != null) {
            int room = app.canvas.Width() - app.Scale(8);
            if (room > 0 && prefW > room) { prefW = room; }
        }
        prefH = viewH;
    }
    private List<CascadePanelColumn> columns;
    public override void Arrange(int px, int py, int pw, int ph) {
        bx = px; by = py; bw = Math.Max(0, pw); bh = Math.Max(0, ph);
        App app = this.App;
        SelectBox s = box;
        if (app == null || s == null) { return; }
        if (s.cascadePath == null) { s.cascadePath = new List<int>(); }
        int margin = app.Scale(8);
        int filterH = s.FilterBarH(app);
        int chrome = s.filterable && filterH > 0 ? filterH + margin * 2 : 0;
        if (s.filterable) {
            if (s.filterBox == null) {
                string hint = (s.filterHint == null || s.filterHint == "") ? "Search" : s.filterHint;
                s.filterBox = new Input(hint);
                s.filterBox.Clearable = true;
            }
            s.filterBox.Disabled = s.IsDisabled();
            if (s.filterBox.parent != this) { this.Add(s.filterBox); }
            s.filterBox.SetShown(true);
            s.filterBox.MeasureTree(app);
            s.filterBox.Arrange(px + margin, py + margin, Math.Max(0, pw - margin * 2), filterH);
            string live = s.filterBox.GetText();
            if (live != s.filterText) { s.SetFilterText(live); }
        } else if (s.filterBox != null && s.filterBox.parent == this) { this.Remove(s.filterBox); }
        bool filtering = s.filterable && s.filterText != "";
        if (filtering && s.cascadeFilter == null) { s.RebuildFilter(); }
        int count = filtering ? 1 : Math.Min(4, s.cascadePath.Count + 1);
        if (columns == null) { columns = new List<CascadePanelColumn>(); }
        while (columns.Count > count) {
            CascadePanelColumn old = columns[columns.Count - 1];
            columns.RemoveAt(columns.Count - 1);
            this.Remove(old);
        }
        while (columns.Count < count) {
            CascadePanelColumn column = new CascadePanelColumn(s, columns.Count);
            columns.Add(column);
            this.Add(column);
        }
        int colW = count > 0 ? pw / count : pw;
        for (int col = 0; col < count; col = col + 1) {
            CascadePanelColumn column = columns[col];
            column.rows = new List<int>();
            column.filtering = filtering;
            if (filtering) {
                if (s.cascadeFilter != null) { column.rows.AddRange(s.cascadeFilter); }
            } else {
                List<SelectOption> current = s.cascRoots;
                if (col > 0 && col - 1 < s.cascadePath.Count) {
                    int index = s.cascadePath[col - 1];
                    current = (s.opts != null && index >= 0 && index < s.opts.Count) ? s.opts[index].children : null;
                }
                if (current != null) {
                    for (int i = 0; i < current.Count; i = i + 1) { column.rows.Add(current[i].flatIdx); }
                }
            }
            column.MeasureTree(app);
            column.Arrange(px + col * colW, py + chrome,
                col == count - 1 ? pw - col * colW : colW, Math.Max(0, ph - chrome));
        }
    }
    public override void OnPaint(App app) {
        SelectBox s = box;
        if (app == null || s == null) { return; }
        StyleBox popup = s.ResolvePartAs(app, "select", "popup", "popup", s.Class, Style.SSelected());
        popup.Paint(app, bx, by, bw, bh);
    }
    public static int DrawCascadeCheck(SelectBox s, App app, Canvas c, Theme t, string cls,
                                       int cx, int ry, int optH, bool on, bool partial) {
        if (s == null || app == null || c == null || t == null) { return 0; }
        int st = Style.SNormal();
        if (on || partial) { st = st + Style.SChecked(); }
        StyleBox box = s.ResolvePartAs(app, "checkbox", "box", "", cls, st);
        int bs = box.WidthOr(app.Scale(16));
        int maxBs = optH - app.Scale(8);
        if (maxBs < app.Scale(10)) { maxBs = app.Scale(10); }
        if (bs > maxBs) { bs = maxBs; }
        int bx = cx + t.paddingSmall;
        int by = ry + (optH - bs) / 2;
        box.Paint(app, bx, by, bs, bs);
        if (on || partial) {
            StyleBox chk = s.ResolvePartAs(app, "checkbox", "check", "", cls, st);
            int gs = bs - app.Scale(8);
            if (gs < app.Scale(8)) { gs = bs - app.Scale(4); }
            string glyph = "minus";
            if (on) { glyph = "check"; }
            c.DrawGlyphIn(glyph, bx, by, bs, bs, gs,
                          chk.FgOr(box.AccentOr(box.fg)));
        }
        return bs;
    }
    public static void DrawCascadeTags(SelectBox s, App app, Canvas c, Theme t, string cls,
                                       int partState, int x, int y, int w, int h,
                                       int pad, int arrowSlot, bool showClear,
                                       int clearSize, int fs) {
        if (s == null || app == null || c == null || t == null) { return; }
        int width = w - 2 * pad - arrowSlot - t.paddingSmall;
        if (showClear) { width = width - clearSize - t.paddingSmall; }
        CascadePanel.DrawCascadeTagsIn(s, c, app, cls, partState,
                                       new Rect(x + pad, y, width, h), width, fs);
    }
    internal static void DrawCascadeTagsIn(SelectBox s, Canvas c, App app, string cls,
                                           int partState, Rect content, int width, int fs) {
        if (s == null || c == null || app == null || width <= 0 || content.height <= app.Scale(4)) { return; }
        List<int> vs = s.ValueIdxs();
        if (vs == null) { return; }
        int rightEdge = content.x + width;
        int h = content.height;
        int chipH = h - app.Scale(8);
        if (chipH > app.Scale(24)) { chipH = app.Scale(24); }
        if (chipH < app.Scale(16)) { chipH = h - app.Scale(4); }
        int chipFs = fs;
        if (chipFs > chipH - app.Scale(8)) { chipFs = chipH - app.Scale(8); }
        if (chipFs < 8) { chipFs = 8; }
        int gap = app.Scale(4);
        int cx = content.x;
        int cy = content.y + (h - chipH) / 2;
        int shownN = 0;
        int chromeW = app.Scale(20) + chipFs;
        c.PushClip(content.x, content.y, width, h);
        try {
            for (int i = 0; i < vs.Count; i = i + 1) {
                string label = s.ValueText(vs[i]);
                int tw = Canvas.MeasureText(label, chipFs);
                int cw = tw + chromeW;
                int availChip = rightEdge - cx;
                if (cw > availChip) {
                    if (shownN == 0 && availChip > chromeW + app.Scale(8)) {
                        cw = availChip;
                    } else {
                        break;
                    }
                }
                int textAvail = cw - chromeW;
                if (textAvail < 0) { textAvail = 0; }
                StyleBox chip = s.ResolvePartAs(app, "select", "tag", "", cls, partState);
                chip.Paint(app, cx, cy, cw, chipH);
                c.DrawText(cx + app.Scale(5),
                    Canvas.CenterTextY(cy, chipH, chipFs),
                    Ellipsis.Fit(label, textAvail, chipFs),
                    chip.fg, chipFs);
                int xx = cx + cw - app.Scale(5) - chipFs;
                c.DrawGlyphIn("close", xx, cy, chipFs + app.Scale(4), chipH,
                              chipFs - 2, chip.fg);
                cx = cx + cw + gap;
                shownN = shownN + 1;
            }
            if (shownN < vs.Count) {
                string more = "+" + Convert.ToString(vs.Count - shownN);
                int mw = Canvas.MeasureText(more, chipFs) + app.Scale(10);
                if (cx + mw <= rightEdge) {
                    StyleBox chip = s.ResolvePartAs(app, "select", "tag", "", cls, partState);
                    chip.Paint(app, cx, cy, mw, chipH);
                    c.DrawText(cx + app.Scale(5),
                        Canvas.CenterTextY(cy, chipH, chipFs), more,
                        chip.fg, chipFs);
                }
            }
        } finally {
            c.PopClip();
        }
    }

    protected override List<PropSpec> DefineProps() {
        List<PropSpec> ps = new List<PropSpec>();
        ps.Add(this.SizeProp());
        return ps;
    }
}
