using System;
using Gui;
namespace Gui.Widget;
public delegate string FormCheck(string value);
public class FormGroup : Panel {
    public override Control CreateCloneShell() { return new FormGroup(); }
    private List<FormRow> rows;
    private int badCount;
    private string defaultPlacement;
    private int defaultLabelWidth;
    public FormGroup() {
        this.InitPanel("formgroup", 3);
        this.layout = 1;
        this.gap = 10;
        rows = new List<FormRow>();
        badCount = 0;
        defaultPlacement = "top";
        defaultLabelWidth = 80;
    }
    public string DefaultLabelPlacement {
        get { return this.defaultPlacement; }
        set { this.LabelPlacement(value); }
    }
    public int DefaultLabelWidth {
        get { return this.defaultLabelWidth; }
        set { this.LabelWidth(value); }
    }

    // 统一设置表单标签对齐方式："top" 或 "left"
    public FormGroup LabelPlacement(string p) {
        defaultPlacement = p != null ? p : "top";
        for (int i = 0; i < rows.Count; i = i + 1) {
            rows[i].Placement(defaultPlacement);
        }
        return this;
    }
    public void LabelWidth(int w) {
        defaultLabelWidth = w;
        for (int i = 0; i < rows.Count; i = i + 1) {
            rows[i].LabelWidth(w);
        }
    }
    public FormRow Add(string caption, Control ctl) {
        FormRow r = new FormRow(caption, ctl);
        if (defaultPlacement != "top") { r.Placement(defaultPlacement); }
        if (defaultLabelWidth != 80) { r.LabelWidth(defaultLabelWidth); }
        rows.Add(r);
        base.Add(r);
        return r;
    }
    public void Item(FormItem it) {
        if (it == null) { return; }
        if (defaultPlacement != "top") { it.Placement(defaultPlacement); }
        if (defaultLabelWidth != 80) { it.LabelWidth(defaultLabelWidth); }
        rows.Add(it);
        base.Add(it);
    }
    public FormItem Item(string caption, Control ctl) {
        FormItem it = new FormItem(caption, ctl);
        if (defaultPlacement != "top") { it.Placement(defaultPlacement); }
        if (defaultLabelWidth != 80) { it.LabelWidth(defaultLabelWidth); }
        rows.Add(it);
        base.Add(it);
        return it;
    }
    public override Control Add(Control child) {
        if (child == null) { return null; }
        if (child is FormItem) {
            this.Item((FormItem)child);
            return child;
        }
        if (child is FormRow) {
            FormRow r = (FormRow)child;
            if (defaultPlacement != "top") { r.Placement(defaultPlacement); }
            if (defaultLabelWidth != 80) { r.LabelWidth(defaultLabelWidth); }
            rows.Add(r);
            base.Add(r);
            return child;
        }
        return base.Add(child);
    }

    // 按字段控件名查行；不存在返回 null。
    public FormRow Field(string name) {
        if (name == null) { return null; }
        for (int i = 0; i < rows.Count; i = i + 1) {
            if (rows[i].Name() == name) { return rows[i]; }
        }
        return null;
    }
    public int Count() { return rows.Count; }
    public bool Validate() {
        badCount = 0;
        for (int i = 0; i < rows.Count; i = i + 1) {
            if (rows[i].Check() != "") { badCount = badCount + 1; }
        }
        return badCount == 0;
    }
    public int ErrorCount() { return badCount; }
    public void ClearErrors() {
        for (int i = 0; i < rows.Count; i = i + 1) {
            rows[i].Clear();
        }
        badCount = 0;
    }
    public bool Valid() {
        for (int i = 0; i < rows.Count; i = i + 1) {
            if (rows[i].Peek() != "") { return false; }
        }
        return true;
    }
    public string FirstError() {
        for (int i = 0; i < rows.Count; i = i + 1) {
            string msg = rows[i].Peek();
            if (msg != "") { return msg; }
        }
        return "";
    }
    public static string ValueOf(Control ctl) {
        if (ctl == null) { return ""; }
        PropSpec spec = ctl.BindingSpec("", false);
        return spec != null ? ctl.GetProp(spec.key) : "";
    }
    public string Value(string name) {
        FormRow r = this.Field(name);
        if (r == null) { return ""; }
        return r.Value();
    }
    public bool BoolValue(string name) { return this.Value(name) == "true"; }
    public int IntValue(string name, int def) {
        string s = this.Value(name).Trim();
        int val = 0;
        if (!FormRule.TryParseInt(s, out val)) { return def; }
        return val;
    }
    public static void SetValueOf(Control ctl, string val) {
        if (ctl == null) { return; }
        PropSpec spec = ctl.BindingSpec("", false);
        if (spec != null) { ctl.SetProp(spec.key, val); }
    }
    public static void ResetValueOf(Control ctl) { FormGroup.SetValueOf(ctl, ""); }
    public Dictionary<string, string> GetValues() {
        Dictionary<string, string> dict = new Dictionary<string, string>();
        for (int i = 0; i < rows.Count; i = i + 1) {
            string name = rows[i].Name();
            if (name != "") { dict[name] = rows[i].Value(); }
        }
        return dict;
    }
    public void SetValues(Dictionary<string, string> data) {
        if (data == null) { return; }
        for (int i = 0; i < rows.Count; i = i + 1) {
            string name = rows[i].Name();
            if (name != "" && data.ContainsKey(name)) { FormGroup.SetValueOf(rows[i].field, data[name]); }
        }
    }
    public void Reset() {
        this.ClearErrors();
        for (int i = 0; i < rows.Count; i = i + 1) {
            FormGroup.ResetValueOf(rows[i].field);
        }
    }

    // 设计器 / HTML 属性：标签位置与宽度（统一作用到全部行）。
    protected override List<PropSpec> DefineProps() {
        List<PropSpec> ps = base.DefineProps();
        ps.Add(PropSpec.Text("labelPlacement", "Label placement").Field("defaultPlacement")
            .Setter("LabelPlacement").Also("placement").Also("label-placement").Also("labelplacement"));
        ps.Add(PropSpec.Int("labelWidth", "Label width").Field("defaultLabelWidth")
            .Setter("LabelWidth").Also("label-width").Also("labelwidth"));
        return ps;
    }
}
