using System;
using Gui;

namespace Gui.Widget;

// 校验规则委托：传入字段当前值文本，返回 "" 表示通过，否则返回要
// 显示的错误消息。内置规则见 FormRule 的静态方法；业务自定义规则
// 直接构造：`new FormRule(v => v == "expected" ? "" : "不一致")`。
public delegate string FormCheck(string value);

// 带校验的表单容器：`Add` 进来的每个字段包成一行（标题 + 控件 +
// 错误行），Validate() 按规则逐行校验并就地显示第一条错误；被联动
// 隐藏/禁用的行自动跳过，因此「radio 切换显隐 + 必填」可以同框工作。
// form.Add("用户名", name)
// .Rule(FormRule.Required("请输入用户名"))
// .Rule(FormRule.MinLen(3, "至少 3 个字符"));
// form.Add("确认密码", pwd2)
// .Rule(FormRule.EqualsField(form.Field("pwd"), "两次输入不一致"));
public class FormGroup : Panel {
    List<FormRow> rows;
    // 上一次 Validate 的失败行数。
    int badCount;
    string defaultPlacement;
    int defaultLabelWidth;

    // 空表单（之后 Add 或 Item）。
    FormGroup() {
        this.InitPanel("formgroup", 3);
        this.layout = 1;
        this.logGap = 10;
        rows = new List<FormRow>();
        badCount = 0;
        defaultPlacement = "top";
        defaultLabelWidth = 80;
    }

    // 控件类型标识（序列化/设计器用）。
    override string Kind() { return "FormGroup"; }

    // 统一设置表单标签对齐方式："top" 或 "left"
    FormGroup LabelPlacement(string p) {
        defaultPlacement = p;
        for (int i = 0; i < rows.Count; i = i + 1) {
            rows[i].Placement(p);
        }
        return this;
    }

    // 统一设置表单标签左对齐时的固定宽度（像素）
    FormGroup LabelWidth(int w) {
        defaultLabelWidth = w;
        for (int i = 0; i < rows.Count; i = i + 1) {
            rows[i].LabelWidth(w);
        }
        return this;
    }

    // 添加一行字段：`caption` 为标题（可为 ""），`ctl` 是任意数据
    // 控件（Input / SelectBox / Switch / Checkbox / DatePicker …）。
    // 返回该行以便链式追加规则。
    FormRow Add(string caption, Control ctl) {
        FormRow r = new FormRow(caption, ctl);
        if (defaultPlacement != "top") { r.Placement(defaultPlacement); }
        if (defaultLabelWidth != 80) { r.LabelWidth(defaultLabelWidth); }
        rows.Add(r);
        this.Children.Add(r);
        return r;
    }

    // 声明式接入配置好的 FormItem
    FormGroup Item(FormItem it) {
        if (it == null) { return this; }
        if (defaultPlacement != "top") { it.Placement(defaultPlacement); }
        if (defaultLabelWidth != 80) { it.LabelWidth(defaultLabelWidth); }
        rows.Add(it);
        this.Children.Add(it);
        return this;
    }

    // 快捷添加并返回 FormItem
    FormItem Item(string caption, Control ctl) {
        FormItem it = FormItem.Create(caption, ctl);
        if (defaultPlacement != "top") { it.Placement(defaultPlacement); }
        if (defaultLabelWidth != 80) { it.LabelWidth(defaultLabelWidth); }
        rows.Add(it);
        this.Children.Add(it);
        return it;
    }

    // 支持通过 HTML 标签树直接挂入 FormItem 或普通子控件
    override Control Add(Control child) {
        if (child == null) { return null; }
        if (child is FormItem) {
            this.Item((FormItem)child);
            return child;
        }
        if (child is FormRow) {
            FormRow r = (FormRow)child;
            if (defaultPlacement != "top") { r.Placement(defaultPlacement); }
            if (defaultLabelWidth != 80) { r.LabelWidth(defaultLabelWidth); }
            rows.Add(r);
            this.Children.Add(r);
            return child;
        }
        return base.Add(child);
    }

    override void SetProp(string key, string val) {
        string k = key.ToLower();
        if (k == "label-placement" || k == "labelplacement" || k == "placement") {
            this.LabelPlacement(val);
            return;
        }
        if (k == "label-width" || k == "labelwidth") {
            this.LabelWidth(int.Parse(val));
            return;
        }
        base.SetProp(key, val);
    }

    // 按字段控件名查行；不存在返回 null。
    FormRow Field(string name) {
        for (int i = 0; i < rows.Count; i = i + 1) {
            if (rows[i].Name() == name) { return rows[i]; }
        }
        return null;
    }

    // 行数。
    int Count() { return rows.Count; }

    // 全量校验：逐行 Check()，失败行就地显示错误。全部通过返回 true。
    bool Validate() {
        badCount = 0;
        for (int i = 0; i < rows.Count; i = i + 1) {
            if (rows[i].Check() != "") { badCount = badCount + 1; }
        }
        return badCount == 0;
    }

    // 上一次 Validate 的失败行数。
    int ErrorCount() { return badCount; }

    // 清除全部错误显示（重置表单时）。
    void ClearErrors() {
        for (int i = 0; i < rows.Count; i = i + 1) {
            rows[i].Clear();
        }
        badCount = 0;
    }

    // 静默检查：不改动任何显示状态，全部有效才为 true。
    bool Valid() {
        for (int i = 0; i < rows.Count; i = i + 1) {
            if (rows[i].Peek() != "") { return false; }
        }
        return true;
    }

    // 静默检查时的第一条错误消息（全部有效为 ""）。
    string FirstError() {
        for (int i = 0; i < rows.Count; i = i + 1) {
            string msg = rows[i].Peek();
            if (msg != "") { return msg; }
        }
        return "";
    }

    // ---- 取值 ----

    // 控件当前值的文本视图：文本类控件给文本，布尔类给
    // "true"/"false"，选项类给选中项文本。未知控件回退到属性
    // 协议的 `value`（GetExtra），再没有就为空串。
    static string ValueOf(Control ctl) {
        if (ctl == null) { return ""; }
        if (ctl is Input) { return ((Input)ctl).GetText(); }
        if (ctl is TextArea) { return ((TextArea)ctl).GetText(); }
        if (ctl is SelectBox) { return ((SelectBox)ctl).Text(); }
        if (ctl is Checkbox) {
            return ((Checkbox)ctl).IsChecked() ? "true" : "false";
        }
        if (ctl is Switch) {
            return ((Switch)ctl).IsOn() ? "true" : "false";
        }
        if (ctl is Radio) {
            return ((Radio)ctl).IsSelected() ? "true" : "false";
        }
        return ctl.GetProp("value");
    }

    // 按字段名取值（控件不存在为 ""）。
    string Value(string name) {
        FormRow r = this.Field(name);
        if (r == null) { return ""; }
        return r.Value();
    }

    // 按字段名取布尔值（"true" 才为真）。
    bool BoolValue(string name) {
        return this.Value(name) == "true";
    }

    // 按字段名取整数值（空/非法/越界回退 `def`）。
    int IntValue(string name, int def) {
        string s = this.Value(name).Trim();
        if (!FormRule.IsInt(s)) { return def; }
        return Convert.ToInt32(s);
    }

    // 设置控件的值：根据控件类型分发到对应的设值方法
    static void SetValueOf(Control ctl, string val) {
        if (ctl == null) { return; }
        if (ctl is Input) { ((Input)ctl).SetText(val); return; }
        if (ctl is TextArea) { ((TextArea)ctl).SetText(val); return; }
        if (ctl is SelectBox) { ((SelectBox)ctl).Select(val); return; }
        if (ctl is Checkbox) { ((Checkbox)ctl).SetChecked(val == "true" || val == "1"); return; }
        if (ctl is Switch) { ((Switch)ctl).SetOn(val == "true" || val == "1"); return; }
        if (ctl is Radio) {
            if (val == "true" || val == "1") { ((Radio)ctl).Select(); }
            return;
        }
        ctl.SetProp("value", val);
    }

    // 重置控件的值为初始状态
    static void ResetValueOf(Control ctl) {
        if (ctl == null) { return; }
        if (ctl is Input) { ((Input)ctl).SetText(""); ((Input)ctl).ClearError(); return; }
        if (ctl is TextArea) { ((TextArea)ctl).SetText(""); return; }
        if (ctl is SelectBox) { ((SelectBox)ctl).ClearSelection(); return; }
        if (ctl is Checkbox) { ((Checkbox)ctl).SetChecked(false); return; }
        if (ctl is Switch) { ((Switch)ctl).SetOn(false); return; }
        if (ctl is Radio) { return; }
        ctl.SetProp("value", "");
    }

    // 批量收集表单内所有具名字段的值，以 Dictionary 返回
    Dictionary<string, string> GetValues() {
        Dictionary<string, string> dict = new Dictionary<string, string>();
        for (int i = 0; i < rows.Count; i = i + 1) {
            string name = rows[i].Name();
            if (name != "") {
                dict[name] = rows[i].Value();
            }
        }
        return dict;
    }

    // 批量按字典数据回填表单（DTO / 数据模型映射）
    FormGroup SetValues(Dictionary<string, string> data) {
        if (data == null) { return this; }
        for (int i = 0; i < rows.Count; i = i + 1) {
            string name = rows[i].Name();
            if (name != "" && data.ContainsKey(name)) {
                FormGroup.SetValueOf(rows[i].field, data[name]);
            }
        }
        return this;
    }

    // 一键重置整个表单：清空所有字段值并清除所有错误提示
    FormGroup Reset() {
        this.ClearErrors();
        for (int i = 0; i < rows.Count; i = i + 1) {
            FormGroup.ResetValueOf(rows[i].field);
        }
        return this;
    }
}
