using System;
using Gui;
using Gui.Backend;

namespace Gui.Widget;

// 统一的 overlay 层——单个组件满足所有弹层需求
// （layui `layer` 风格）：可拖动的页面窗口、模态 alert/confirm/prompt
// 对话框、顶部居中的消息 toast 队列、角落通知、加载
// 遮罩、锚定提示和全屏图片轮播。打开/关闭时均有动画，
// 并在延迟的 overlay 绘制阶段渲染，因此浮在
// 页面内容之上。
public partial class Layer {
    // ---- App 实例隔离与多窗口运行上下文 ----
    private static AppLayerContext fallbackContext;

    public static AppLayerContext Context(App app) {
        if (app != null) {
            if (app.layerContext == null) {
                app.layerContext = new AppLayerContext();
            }
            return (AppLayerContext)app.layerContext;
        }
        App frame = App.FrameApp();
        if (frame != null) {
            if (frame.layerContext == null) {
                frame.layerContext = new AppLayerContext();
            }
            return (AppLayerContext)frame.layerContext;
        }
        if (Layer.fallbackContext == null) {
            Layer.fallbackContext = new AppLayerContext();
        }
        return Layer.fallbackContext;
    }

    private static void EnsureZorder(AppLayerContext ctx) {
        if (ctx.zorder == null) { ctx.zorder = new List<LayerState>(); }
    }

    public static void RegisterOpen(App app, LayerState s) {
        AppLayerContext ctx = Layer.Context(app);
        Layer.EnsureZorder(ctx);
        ctx.zorder.Remove(s);
        ctx.zorder.Add(s);
    }

    public static void RegisterOpen(LayerState s) {
        Layer.RegisterOpen(null, s);
    }

    // 剔除已关闭的注册项（随渲染路径惰性调用）。出场动画没走完
    // （closing）与还没轮到启动出场（wasOpen——宿主刚翻 open=false、
    // 本帧渲染沿才会 BeginExit）的保留——RenderStack 的收场扫描要从
    // 这里找到它们补画淡出帧（宿主驱动的对话框 open=false 后不再被
    // Layer.Render 画到）；先剪后扫会把它们剪没，对话框就瞬间消失。
    // 5 秒兜底：宿主若从此不再渲染该层，注册表也不被永久占用。
    private static void PruneZorder(AppLayerContext ctx) {
        Layer.EnsureZorder(ctx);
        int now = Window.GetTickMs();
        for (int i = ctx.zorder.Count - 1; i >= 0; i = i - 1) {
            LayerState s = ctx.zorder[i];
            if (s.open) { continue; }
            if (s.wasOpen && now - s.openMs <= 5000) { continue; }
            if (s.closing && now - s.closeMs <= 2000) { continue; }
            ctx.zorder.RemoveAt(i);
        }
    }

    // 最上层打开中的对话框（kind 1/2），无则 null。
    public static LayerState TopmostDialog(App app) {
        AppLayerContext ctx = Layer.Context(app);
        Layer.EnsureZorder(ctx);
        int i = ctx.zorder.Count - 1;
        while (i >= 0) {
            LayerState s = ctx.zorder[i];
            if (s.open && s.kind != 0) { return s; }
            i = i - 1;
        }
        if (ctx != Layer.fallbackContext && Layer.fallbackContext != null) {
            AppLayerContext fb = Layer.fallbackContext;
            Layer.EnsureZorder(fb);
            int fi = fb.zorder.Count - 1;
            while (fi >= 0) {
                LayerState fs = fb.zorder[fi];
                if (fs.open && fs.kind != 0) { return fs; }
                fi = fi - 1;
            }
        }
        return null;
    }

    public static LayerState TopmostDialog() {
        return Layer.TopmostDialog(null);
    }

    // `s` 是否是当前最上层打开中的 layer（渲染路径里避免同一键
    // 事件被多个对话框重复消费）。
    public static bool IsTopmost(App app, LayerState s) {
        AppLayerContext ctx = Layer.Context(app);
        Layer.EnsureZorder(ctx);
        int i = ctx.zorder.Count - 1;
        while (i >= 0) {
            if (ctx.zorder[i].open) { return ctx.zorder[i] == s; }
            i = i - 1;
        }
        if (ctx != Layer.fallbackContext && Layer.fallbackContext != null) {
            AppLayerContext fb = Layer.fallbackContext;
            Layer.EnsureZorder(fb);
            int fi = fb.zorder.Count - 1;
            while (fi >= 0) {
                if (fb.zorder[fi].open) { return fb.zorder[fi] == s; }
                fi = fi - 1;
            }
        }
        return false;
    }

    public static bool IsTopmost(LayerState s) {
        return Layer.IsTopmost(null, s);
    }

    // 规范关闭入口（layui isOutAnim:true 的等价物）：open 立即为
    // false（宿主状态机、Esc 往返立刻稳定），层进入 closing 态——
    // 渲染沿还会把它在屏幕上淡出+上滑收场。Closed 仍在关闭沿立即
    // 触发（回调时序与无出场动画时完全一致，出场纯粹是收场动画）。
    // 直接置 open=false 的宿主走同一条路（关闭沿在渲染时启动出场，
    // 并在那里补触发 Closed）。
    public static void Close(App app, LayerState s) {
        if (!s.open) { return; }
        s.open = false;
        s.dragging = false;
        s.sizing = false;
        s.closing = true;
        s.closeMs = Window.GetTickMs();
        if (!s.closedRaised) {
            s.closedRaised = true;
            s.Closed.Raise();
        }
        Layer.Context(app).requestRedraw = true;
    }

    // 关闭沿（!open 且 wasOpen）的第一帧：启动出场动画。
    public static void BeginExit(LayerState s) {
        s.wasOpen = false;
        s.closing = true;
        s.closeMs = Window.GetTickMs();
        s.dragging = false;
        s.sizing = false;
    }

    // 弹出完成回调：入场进度到 1000（或无入场）的第一帧触发一次。
    // 渲染路径在算完 Entrance 后调用。
    public static void NotifyOpened(LayerState s) {
        if (s.wasOpen && !s.openedRaised) {
            s.openedRaised = true;
            s.Opened.Raise();
        }
    }

    // Esc 的语义：最上层对话框报告取消（action 2，由调用方关闭；
    // 与 X 的 action 3、按钮的 1/2 一致）。photos 在屏时请求关闭。
    public static bool CloseTopmostDialog(App app) {
        AppLayerContext ctx = Layer.Context(app);
        LayerState top = Layer.TopmostDialog(app);
        if (top != null) {
            top.action = 2;
            // action 由调用方在同一帧的渲染沿读走并置 open=false，但很多
            // 宿主（gallery 的对话框 pass、IDE 的 RenderDocDialogs）只翻
            // open 标志、不请求重绘。Esc 帧本身渲染时对话框还开着（键盘
            // 消费在 RenderDialog 画遮罩之前，遮罩照画上屏），下一帧若没
            // 人请求，事件循环就睡到 fx 拍——恢复的快照又把遮罩钉在屏上，
            // 直到 500ms 后 HUD/动画拍才真正擦掉，正是「Esc 后蒙版滞留」。
            // 这里置位交 FlushCloseRedraw 兑现。
            ctx.requestRedraw = true;
            return true;
        }
        if (Window.GetTickMs() - ctx.photosTick < 250) {
            ctx.photosCloseReq = true;
            return true;
        }
        return false;
    }

    public static bool CloseTopmostDialog() {
        return Layer.CloseTopmostDialog(null);
    }

    // 关闭最上层打开中的 layer（直接置 open=false，不产生 action）。
    // kind 0 窗口 / 1 对话框 / 2 提示框，-1 不限。无则返回 false。
    public static bool CloseLast(App app, int kind) {
        AppLayerContext ctx = Layer.Context(app);
        Layer.PruneZorder(ctx);
        int i = ctx.zorder.Count - 1;
        while (i >= 0) {
            LayerState s = ctx.zorder[i];
            if (s.open && (kind < 0 || s.kind == kind)) {
                s.open = false;
                // 关闭沿必须有人重绘：遮罩/窗口的像素只会在下一帧的渲染
                // 里消失，这里不请求的话事件循环睡到 fx 拍，快照把旧画面
                // 钉在屏上（与 Close/CloseTopmostDialog 同因）。
                ctx.requestRedraw = true;
                return true;
            }
            i = i - 1;
        }
        if (kind < 0 && Window.GetTickMs() - ctx.photosTick < 250) {
            ctx.photosCloseReq = true;
            return true;
        }
        return false;
    }

    public static bool CloseLast(int kind) {
        return Layer.CloseLast(null, kind);
    }

    // 关闭全部打开中的 layer（不产生 action）。photos 不经注册表，
    // 由 CloseLast(-1) 的兜底分支请求关闭。
    public static void CloseAll(App app, int kind) {
        AppLayerContext ctx = Layer.Context(app);
        Layer.PruneZorder(ctx);
        bool any = false;
        for (int i = 0; i < ctx.zorder.Count; i = i + 1) {
            LayerState s = ctx.zorder[i];
            if (s.open && (kind < 0 || s.kind == kind)) {
                s.open = false;
                any = true;
            }
        }
        if (any) { ctx.requestRedraw = true; }
    }

    public static void CloseAll(int kind) {
        Layer.CloseAll(null, kind);
    }

    // 键盘语义（宿主在 key-down 事件里调用；对话框与 photos 的渲染
    // 路径也经此消费）。Esc 关最上层（对话框优先、photos 次之），
    // Enter 确认最上层对话框（多行 prompt 除外——Enter 是换行），
    // ←/→ 在 photos 里翻页。有下拉/菜单等框架弹层打开时让位
    // （框架自己收 Esc）。返回 true 表示本次按键已被层消费。
    public static bool Key(App app, int code) {
        if (app.HasOverlays()) { return false; }
        AppLayerContext ctx = Layer.Context(app);
        if (code == 27) {
            if (Layer.CloseTopmostDialog(app)) {
                app.RequestRedraw();
                return true;
            }
            return false;
        }
        if (code == 13) {
            LayerState top = Layer.TopmostDialog(app);
            if (top != null && top.promptFormType != 2) {
                top.action = 1;
                // 与 Esc 同理：Enter 确认沿宿主可能只翻 open 标志，
                // 这里替它把下一帧的整窗重绘挂上，遮罩不当屏。
                app.RequestRedraw();
                return true;
            }
            return false;
        }
        if ((code == 37 || code == 39)
            && Window.GetTickMs() - ctx.photosTick < 250) {
            SignalInt idx = ctx.photosIdx;
            if (idx != null && ctx.photoCount > 0) {
                int v = idx.Get() + (code == 39 ? 1 : 0 - 1);
                if (v < 0) { v = ctx.photoCount - 1; }
                if (v >= ctx.photoCount) { v = 0; }
                idx.Set(v);
                app.RequestRedraw();
                return true;
            }
        }
        return false;
    }

    // 历史保留签名，保持二进制兼容，内部已全面接入统一对象树，无全局数字发号器副作用。
    public static void BeginBody(App app) {}
    public static void BeginBody() {}
    public static void EndBody(App app) {}
    public static void EndBody() {}

    private static void EnsureQueues(AppLayerContext ctx) {
        if (ctx.toasts == null) { ctx.toasts = new List<ToastItem>(); }
        if (ctx.notifs == null) { ctx.notifs = new List<ToastItem>(); }
        if (ctx.toastPrev == null) { ctx.toastPrev = new Rect(0, 0, 0, 0); }
        if (ctx.notifPrev == null) { ctx.notifPrev = new Rect(0, 0, 0, 0); }
    }

    // 声明这条队列这一帧的脏区，并把上一帧的脏区一起交上去。
    // 队列里的东西一直在动（滑入、淡出、幸存者上移收拢），只声明「它现在
    // 在哪」的话，上一帧它占过、这一帧已经离开的那几行像素没人重画，留在
    // 屏幕上就是残影；最后一条消失的那一帧更是连一次重绘都不会请求，于是
    // 那条 toast 会一直挂在屏幕上直到下一次整窗重绘。
    private static void MarkQueueDirty(App app, Rect prev, bool any,
            int rx, int ry, int rw, int rh) {
        if (any) { app.RequestAnimationFrameIn(rx, ry, rw, rh); }
        if (prev != null && prev.width > 0 && prev.height > 0) {
            app.RequestAnimationFrameIn(prev.x, prev.y, prev.width, prev.height);
        }
        if (prev != null) {
            if (any) {
                prev.x = rx; prev.y = ry; prev.width = rw; prev.height = rh;
            } else {
                prev.x = 0; prev.y = 0; prev.width = 0; prev.height = 0;
            }
        }
    }

    // 对话框操作按钮宽度：取标签自然宽度，不低于
    // 标准对话框按钮宽度，使一排按钮保持齐整。
    private static int ActionWidth(App app, Button b, int minW) {
        b.OnMeasure(app);
        int w = b.prefW;
        if (w < minW) { w = minW; }
        return w;
    }

    public static int Clamp01(int v) {
        if (v < 0) { return 0; }
        if (v > 1000) { return 1000; }
        return v;
    }

    // toast/notification/dialog 类型到 CSS 角色类（1/默认无类）。
    public static string RoleClass(int mtype) {
        if (mtype == 2) { return "info"; }
        if (mtype == 3) { return "success"; }
        if (mtype == 4) { return "warning"; }
        if (mtype == 5) { return "error"; }
        return "";
    }

    public static string RoleIcon(int mtype) {
        if (mtype == 3) { return "success"; }
        if (mtype == 4) { return "warning"; }
        if (mtype == 5) { return "error"; }
        return "info";
    }

    // 消息 toast 队列（顶部居中、自动消失、向上收拢）

    // 入队一条短暂的顶部居中 toast。type：1 默认，2 信息，
    // 3 成功，4 警告，5 错误。
    public static void Msg(App app, string text, int type) {
        AppLayerContext ctx = Layer.Context(app);
        Layer.EnsureQueues(ctx);
        int now = Window.GetTickMs();
        for (int i = 0; i < ctx.toasts.Count; i = i + 1) {
            ToastItem it = ctx.toasts[i];
            if (it.text == text && it.type == type && !it.closing) {
                it.lifeMs = now - it.bornMs + 3000;
                return;
            }
        }
        ctx.toasts.Add(new ToastItem(text, type, 3000));
    }

    public static void Msg(string text, int type) {
        Layer.Msg(null, text, type);
    }

    // 绘制并推进 toast 队列。在 overlay 阶段每帧调用一次。
    // 条目从槽位正上方淡入/滑入，短暂停留后
    // 淡出；幸存者缓动上移，填补空隙。
    public static void RenderToasts(App app) {
        AppLayerContext ctx = Layer.Context(app);
        Layer.EnsureQueues(ctx);
        Theme t = app.theme;
        int now = Window.GetTickMs();

        int i = 0;
        while (i < ctx.toasts.Count) {
            ToastItem it = ctx.toasts[i];
            if (it.closing && now - it.closeMs >= 240) {
                ctx.toasts.RemoveAt(i);
            } else {
                i = i + 1;
            }
        }

        int h = t.heightMedium;
        int gap = app.Scale(8);
        int slotH = h + gap;
        int topY = app.titlebarH + app.Scale(10);
        int n = ctx.toasts.Count;
        int rx = 0;
        int ry = app.titlebarH;
        int rw = app.canvas.Width();
        int rh = app.canvas.Height() - app.titlebarH;
        for (int j = 0; j < n; j = j + 1) {
            ToastItem it = ctx.toasts[j];
            if (!it.closing && now - it.bornMs >= it.lifeMs) {
                it.closing = true;
                it.closeMs = now;
            }
            int ty = topY + j * slotH;
            if (it.curY < 0 - 9000) { it.curY = ty - app.Scale(14); }
            else { it.curY = it.curY + (ty - it.curY) / 3; }

            int enterP = App.Ease(Layer.Clamp01((now - it.bornMs) * 1000 / 220));
            int exitP = 0;
            if (it.closing) {
                exitP = App.Ease(Layer.Clamp01((now - it.closeMs) * 1000 / 240));
            }
            int a = enterP * (1000 - exitP) / 1000;
            Rect toastRect = Layer.DrawToast(
                app, it.curY, a, it.text, it.type);
            if (j == 0) {
                rx = toastRect.x;
                ry = toastRect.y;
                rw = toastRect.width;
                rh = toastRect.height;
            } else {
                if (toastRect.x < rx) {
                    rw = rw + rx - toastRect.x;
                    rx = toastRect.x;
                }
                if (toastRect.y < ry) {
                    rh = rh + ry - toastRect.y;
                    ry = toastRect.y;
                }
                if (toastRect.x + toastRect.width > rx + rw) {
                    rw = toastRect.x + toastRect.width - rx;
                }
                if (toastRect.y + toastRect.height > ry + rh) {
                    rh = toastRect.y + toastRect.height - ry;
                }
            }
        }
        Layer.MarkQueueDirty(app, ctx.toastPrev, n > 0, rx, ry, rw, rh);
    }

    private static Rect DrawToast(App app, int y, int a, string text, int mtype) {
        Canvas c = app.canvas;
        Theme t = app.theme;

        string cls = Layer.RoleClass(mtype);
        StyleBox s = Style.Of(app, "toast", cls, Style.SNormal());
        StyleBox icoStyle = Style.Part(app, "toast", "icon", "", cls, "",
                                       Style.SNormal());
        string iconName = Layer.RoleIcon(mtype);
        int fontSize = s.FontOr(Style.FontFallback(app, "medium"));

        int ico = t.iconSizeSmall;
        int h = t.heightMedium;
        int textW = Canvas.MeasureText(text, fontSize);
        int w = t.paddingMedium * 2 + ico + t.gapSmall + textW;
        int x = (c.Width() - w) / 2;

        int sh = 34 * a / 1000;
        c.FillRoundRect(x + 1, y + 2, w, h, t.borderRadiusMedium, sh * 16777216);
        app.FillGlass(x, y, w, h, t.borderRadiusMedium, s.bg, a);
        c.DrawRoundRect(x, y, w, h, t.borderRadiusMedium,
                        Style.Fade(s.borderColor, a), s.BorderWOr(1));
        c.DrawGlyphIn(iconName, x + t.paddingMedium, y, ico, h, ico,
                            Style.Fade(icoStyle.fg, a));
        c.DrawText(x + t.paddingMedium + ico + t.gapSmall,
                   Canvas.CenterTextY(y, h, fontSize),
                   text, Style.Fade(s.fg, a), fontSize);
        return new Rect(x, y, w + 1, h + 2);
    }

    // 通知队列（右上角、自动消失、向上收拢）

    // 入队一条角落通知。type：1 默认，2 信息，3 成功，
    // 4 警告，5 错误。
    public static void Notify(App app, string title, int type) {
        AppLayerContext ctx = Layer.Context(app);
        Layer.EnsureQueues(ctx);
        ctx.notifs.Add(new ToastItem(title, type, 4000));
    }

    public static void Notify(string title, int type) {
        Layer.Notify(null, title, type);
    }

    public static void RenderNotifs(App app) {
        AppLayerContext ctx = Layer.Context(app);
        Layer.EnsureQueues(ctx);
        Canvas c = app.canvas;
        Theme t = app.theme;
        int now = Window.GetTickMs();

        int i = 0;
        while (i < ctx.notifs.Count) {
            ToastItem it = ctx.notifs[i];
            if (it.closing && now - it.closeMs >= 260) {
                ctx.notifs.RemoveAt(i);
            } else {
                i = i + 1;
            }
        }

        int w = app.Scale(300);
        int h = t.heightLarge + t.paddingSmall;
        int gap = app.Scale(10);
        int slotH = h + gap;
        int margin = app.Scale(16);
        int tx = c.Width() - w - margin;
        int topY = app.titlebarH + app.Scale(12);
        int n = ctx.notifs.Count;
        int rx = tx;
        int ry = topY;
        int rw = w;
        int rh = h;
        for (int j = 0; j < n; j = j + 1) {
            ToastItem it = ctx.notifs[j];
            if (!it.closing && now - it.bornMs >= it.lifeMs) {
                it.closing = true;
                it.closeMs = now;
            }
            int ty = topY + j * slotH;
            if (it.curY < 0 - 9000) { it.curY = ty; }
            else { it.curY = it.curY + (ty - it.curY) / 3; }

            int enterP = App.Ease(Layer.Clamp01((now - it.bornMs) * 1000 / 240));
            int exitP = 0;
            if (it.closing) {
                exitP = App.Ease(Layer.Clamp01((now - it.closeMs) * 1000 / 260));
            }
            int a = enterP * (1000 - exitP) / 1000;
            int cx = tx + (1000 - a) * app.Scale(24) / 1000;
            Layer.DrawNotifyCard(app, cx, it.curY, w, a, it.text, it.type);
            if (j == 0) {
                rx = cx; ry = it.curY; rw = w; rh = h;
            } else {
                if (cx < rx) { rw = rw + rx - cx; rx = cx; }
                if (it.curY < ry) { rh = rh + ry - it.curY; ry = it.curY; }
                if (cx + w > rx + rw) { rw = cx + w - rx; }
                if (it.curY + h > ry + rh) {
                    rh = it.curY + h - ry;
                }
            }
        }
        Layer.MarkQueueDirty(app, ctx.notifPrev, n > 0, rx, ry, rw, rh);
    }

    // 单条通知 / 内联横幅卡片的高度。
    public static int NotifyH(App app) {
        return app.theme.heightLarge + app.theme.paddingSmall;
    }

    // 绘制通知卡片（不透明）。也复用作静态预览渲染器。
    public static void DrawNotify(App app, int x, int y, int w, string message, int ntype) {
        Layer.DrawNotifyCard(app, x, y, w, 1000, message, ntype);
    }

    private static void DrawNotifyCard(App app, int x, int y, int w, int a,
                               string message, int ntype) {
        Canvas c = app.canvas;
        Theme t = app.theme;
        int h = t.heightLarge + t.paddingSmall;

        string cls = Layer.RoleClass(ntype);
        StyleBox s = Style.Of(app, "notification", cls, Style.SNormal());
        StyleBox barStyle = Style.Part(app, "notification", "bar", "", cls,
                                       "", Style.SNormal());
        string iconName = Layer.RoleIcon(ntype);
        int fontSize = s.FontOr(Style.FontFallback(app, "medium"));

        int sh = 34 * a / 1000;
        c.FillRoundRect(x + 1, y + 2, w, h, t.borderRadiusMedium, sh * 16777216);
        app.FillGlass(x, y, w, h, t.borderRadiusMedium, s.bg, a);
        c.DrawRoundRect(x, y, w, h, t.borderRadiusMedium,
                        Style.Fade(s.borderColor, a), s.BorderWOr(1));

        int barColor = barStyle.bg;
        c.FillRect(x, y, barStyle.WidthOr(3), h, Style.Fade(barColor, a));

        c.DrawGlyphIn(iconName, x + t.paddingMedium, y,
                            t.iconSizeMedium, h, t.iconSizeMedium,
                            Style.Fade(barColor, a));
        c.DrawText(x + t.paddingMedium + t.iconSizeMedium + t.gapSmall,
                   Canvas.CenterTextY(y, h, fontSize),
                   message, Style.Fade(s.fg, a), fontSize);
    }

    // 加载遮罩 + 锚定提示

    // 覆盖某区域的加载遮罩：变暗的圆角面板，中央是
    // 旋转指示器和可选的说明文字。
    public static void RenderLoad(App app, int x, int y, int w, int h, string tip) {
        Canvas c = app.canvas;
        Theme t = app.theme;
        StyleBox mask = Style.Part(app, "layer", "mask", "", "", "",
                                   Style.SNormal());
        c.FillRoundRect(x, y, w, h, t.borderRadiusLarge, mask.bg);
        app.BlockHitsRect(x, y, w, h);
        int d = app.Scale(36);
        int cy = y + h / 2 - app.Scale(10);
        new Spin(36).RenderInside(app,
            new Rect(x + (w - d) / 2, cy - d / 2, d, d));
        if (tip == "") { return; }
        StyleBox ls = Style.Part(app, "layer", "load-label", "", "", "",
                                 Style.SNormal());
        int fs = ls.FontOr(Style.FontFallback(app, "small"));
        c.DrawTextCentered(x, cy + app.Scale(30), w, Canvas.FontHeight(fs), tip,
                           ls.FgOr(0), fs);
    }

    // 小型的锚定提示气泡（入队 Tooltip 悬停请求）。
    public static void Tips(App app, int anchorX, int anchorY, string text) {
        Tooltip.Request(app, anchorX, anchorY, text, 0, 0);
    }

    // 静态辅助函数

    // 居中的模态面板，带标题栏 + 关闭按钮。返回
    // 关闭按钮的命中 id。
    public static int Modal(App app, int w, int h, string title) {
        Canvas c = app.canvas;
        Theme t = app.theme;

        StyleBox ov = Style.Part(app, "dialog", "overlay", "", "", "",
                                 Style.SNormal());
        StyleBox surf = Style.Part(app, "dialog", "surface", "", "", "",
                                   Style.SNormal());
        c.FillRect(0, 0, c.Width(), c.Height(), ov.bg);
        app.BlockHitsBelow();
        NativeLayer.Occlude(app, 0, 0, c.Width(), c.Height());
        // 同 RenderDialog：调用方给的桌面定宽在窄视口上钳到可视区内。
        int mw = w;
        int mh = h;
        int mAvailW = c.Width() - app.Scale(16) * 2;
        if (mw > mAvailW) { mw = mAvailW; }
        int mAvailH = c.Height() - app.Scale(16) * 2;
        if (mh > mAvailH) { mh = mAvailH; }
        int x = (c.Width() - mw) / 2;
        int y = (c.Height() - mh) / 2;

        c.FillRoundRect(x + surf.shadowDx, y + surf.shadowDy, mw, mh,
                        t.borderRadiusLarge, surf.shadow);
        c.FillRoundRect(x, y, mw, mh, t.borderRadiusLarge, surf.bg);

        if (title != "") {
            StyleBox ts = Style.Part(app, "dialog", "title", "", "", "",
                                     Style.SNormal());
            StyleBox ds = Style.Part(app, "dialog", "divider", "", "", "",
                                     Style.SNormal());
            int titleFont = ts.FontOr(Style.FontFallback(app, "large"));
            c.DrawText(x + t.paddingLarge, y + t.paddingLarge, title,
                       ts.fg, titleFont);
            c.FillRect(x + 1, y + t.paddingLarge + t.heightMedium, mw - 2, 1,
                       ds.bg);
        }

        int closeId = app.focus.AllocId();
        int closeX = x + mw - t.heightMedium;
        int closeY = y;
        int closeState = Style.SNormal();
        if (app.focus.IsHovered(closeId)) { closeState = Style.SHover(); }
        StyleBox cs = Style.Part(app, "dialog", "close", "", "", "",
                                 closeState);
        if (cs.bg != 0) {
            c.FillRoundRect(closeX, closeY, t.heightMedium, t.heightMedium,
                            t.borderRadiusLarge, cs.bg);
        }
        c.DrawGlyphIn("close", closeX, closeY, t.heightMedium,
                            t.heightMedium, t.iconSizeSmall, cs.fg);
        app.hitTester.RegisterRect(closeId, closeX, closeY, t.heightMedium, t.heightMedium, 0);
        return closeId;
    }

    // 锚定在触发器下方的小型确认弹出框。返回 0 无，
    // 1 确认，2 取消。
    public static int DrawPopconfirm(App app, int anchorX, int anchorY, string message,
                              string okText, string cancelText) {
        Canvas c = app.canvas;
        Theme t = app.theme;

        int ico = t.iconSizeSmall;
        StyleBox s = Style.Of(app, "popconfirm", "", Style.SNormal());
        int fontSize = s.FontOr(Style.FontFallback(app, "medium"));
        int msgW = Canvas.MeasureText(message, fontSize);
        int pad = t.paddingMedium;
        int w = pad * 2 + ico + t.gapSmall + msgW;
        int bw = app.Scale(64);
        int minW = pad * 2 + bw * 2 + t.gapSmall;
        if (w < minW) { w = minW; }
        int h = pad * 2 + Canvas.FontHeight(fontSize) + t.gapMedium + t.heightSmall;

        int x = anchorX - w / 2;
        int y = anchorY + app.Scale(8);
        if (x < app.Scale(4)) { x = app.Scale(4); }

        StyleBox icoStyle = Style.Part(app, "popconfirm", "icon", "", "", "",
                                       Style.SNormal());
        int notch = app.Scale(6);
        c.FillRoundRect(x + s.shadowDx, y + s.shadowDy, w, h,
                        t.borderRadiusMedium, s.shadow);
        app.FillGlass(x, y, w, h, t.borderRadiusMedium, s.bg, 1000);
        c.DrawRoundRect(x, y, w, h, t.borderRadiusMedium, s.borderColor,
                        s.BorderWOr(1));
        Tooltip.TriUp(c, anchorX, y - notch, notch, notch, s.bg);
        app.BlockHitsRect(x, y, w, h);

        // 点气泡外面 = 取消（与返回值 2 同义）。此前气泡没有关闭
        // 途径，只能点确定/取消，用户被卡在气泡上。
        // 这里不铺全窗阻挡区：设计器的控件图鉴把气泡当静态样例
        // 画在画布里，铺全窗会让整个设计器在那张样例期间失去
        // 交互。代价是「点外面」这一次点击仍会落到下层内容上
        // （气泡本身那块已被上面的阻挡区护住）。
        if (app.EventKind() == 2 && app.window.EventButton() == 0
            && !Layer.Inside(app.mouseX, app.mouseY, x, y, w, h)) {
            return 2;
        }

        c.DrawGlyph("warning", x + pad, y + pad, ico, icoStyle.fg);
        c.DrawText(x + pad + ico + t.gapSmall, y + pad, message, s.fg, fontSize);

        int by = y + h - t.heightSmall - pad;
        int okX = x + w - pad - bw;
        int cancelX = okX - t.gapSmall - bw;

        int result = 0;
        Button cancelBtn = new Button { Text = cancelText, Class = "primary outline" };
        cancelBtn.RenderAt(app, cancelX, by, bw);
        int cancelId = cancelBtn.CommonId();
        if (Ui.Clicked(app, cancelId)) { result = 2; }
        Button okBtn = new Button { Text = okText, Class = "primary" };
        okBtn.RenderAt(app, okX, by, bw);
        int okId = okBtn.CommonId();
        if (Ui.Clicked(app, okId)) { result = 1; }
        return result;
    }

    // 全屏图片轮播（layui `photos` layer）

    // 全屏变暗的图片查看器，包装共享的 Carousel。每张 slide 是一个
    // 图片源（文件 / data URI / http(s) URL / SVG），由 Gui.Widget.Image
    // 以 cover 填满观看框——photos 层不自己画占位。
    // 关闭按钮被点击的那一帧返回 true。
    public static bool RenderPhotos(App app, List<string> slides, SignalInt idx,
                             CarouselAnim anim) {
        Canvas c = app.canvas;
        Theme t = app.theme;
        int W = c.Width();
        int H = c.Height();
        int top = app.titlebarH;

        // 键盘会话：记录当前索引/张数与活跃时刻（Key 判断照片层
        // 是否顶屏），消费宿主或上帧转来的关闭请求。
        AppLayerContext ctx = Layer.Context(app);
        ctx.photosTick = Window.GetTickMs();
        ctx.photosIdx = idx;
        ctx.photoCount = slides.Count;
        bool wantClose = ctx.photosCloseReq;
        ctx.photosCloseReq = false;
        if (app.EventKind() == 4) {
            Layer.Key(app, app.window.EventKeyCode());
        }

        StyleBox s = Style.Of(app, "photos", "", Style.SNormal());
        int fontSize = s.FontOr(Style.FontFallback(app, "medium"));
        c.FillRect(0, top, W, H - top, s.bg);
        int scrimId = app.BlockHitsRect(0, top, W, H - top);

        int pw = W * 7 / 10;
        int ph = (H - top) * 7 / 10;
        int px = (W - pw) / 2;
        int py = top + ((H - top) - ph) / 2;

        Carousel car = new Carousel(idx);
        for (int i = 0; i < slides.Count; i = i + 1) {
            car.AddSlideView(new Image(slides[i], "", "cover"));
        }
        car.Animate(anim)
            .RenderInside(app, new Rect(px, py, pw, ph));

        c.DrawText(px, py - app.Scale(28),
                   "Photo " + Convert.ToString(idx.Get() + 1) + " / "
                   + Convert.ToString(slides.Count), s.fg, fontSize);

        int bw = app.Scale(36);
        int bx = px + pw - bw;
        int byy = py - app.Scale(42);
        if (byy < top + app.Scale(6)) { byy = top + app.Scale(6); }
        int closeId = app.focus.AllocId();
        bool hover = Ui.Over(app, bx, byy, bw, bw);
        int chipState = Style.SNormal();
        if (hover) { chipState = Style.SHover(); }
        StyleBox chip = Style.Part(app, "photos", "chip", "", "", "",
                                   chipState);
        c.FillRoundRect(bx, byy, bw, bw, bw / 2, chip.bg);
        c.DrawGlyphIn("close", bx, byy, bw, bw, t.iconSizeSmall, chip.fg);
        app.hitTester.RegisterRect(closeId, bx, byy, bw, bw, 0);
        if (app.EventKind() == 3
            && app.ClickTarget() == closeId) {
            return true;
        }
        // 点观看框外的遮罩空白处关闭（naive UI 图片预览的惯例，全屏
        // 看图不该逼用户瞄准右上角的小 X）。要求按下与释放都落在
        // 遮罩上：从观看框里拖出去的翻页手势不得误判成关闭。
        if (app.EventKind() == 3
            && app.PressTarget() == scrimId
            && app.ClickTarget() == scrimId) {
            return true;
        }
        // Esc（Layer.Key 置的关闭请求）：下一帧在渲染开头兑现。
        // 返回 true 前把重绘挂上：宿主收到 true 才会翻 photosOpen，
        // 但它不一定自己请求重绘；photos 全屏像素的消失必须由下一帧
        // 渲染兑现，否则 fx 快照把照片层钉在屏上直到某个无关动画拍。
        if (wantClose) {
            app.RequestRedraw();
            return true;
        }
        return false;
    }

    // 可拖动的页面窗口 + 模态对话框

    public static int BarH(App app) {
        return app.theme.heightLarge;
    }

    public static int FooterH(App app) {
        return app.theme.heightMedium + app.Scale(20);
    }

    public static int BtnW(App app) {
        return app.Scale(46);
    }

    // 状态 `s` 下，调用方正文内容应开始的绝对 Y 坐标。
    public static int BodyTop(App app, LayerState s) {
        int top = app.titlebarH;
        if (s.state == 1) { return top + Layer.BarH(app) + app.Scale(16); }
        return s.y + Layer.BarH(app) + app.Scale(16);
    }

    // 正文内容应开始的绝对 X 坐标。
    public static int BodyLeft(App app, LayerState s) {
        if (s.state == 1) { return app.Scale(20); }
        return s.x + app.Scale(20);
    }

    public static bool Inside(int mx, int my, int x, int y, int w, int h) {
        return mx >= x && mx < x + w && my >= y && my < y + h;
    }

    // 缩放拖拽的几何推导：从 rStart* 起始几何与当前鼠标位推出新的
    // x/y/w/h（含最小尺寸与客户区钳制）。dir 与 s.rDir 同义：
    // 1 左缘，2 右缘，3 下缘，4 右下角，5 左下角。渲染拖动与
    // 无窗口回归共用这一份推导。
    public static void ApplyResize(App app, LayerState s, int mx, int my) {
        int W = app.canvas.Width();
        int H = app.canvas.Height();
        int minW = app.Scale(220);
        int minH = app.Scale(120);
        int dir = s.rDir;
        int dx = mx - s.grabDx;
        int dy = my - s.grabDy;
        if (dir == 1 || dir == 5) {
            // 左缘：x/w 联动，最小宽度时钉住左缘，钳到客户区左界。
            int nx = s.rStartX + dx;
            int nw = s.rStartW - dx;
            if (nw < minW) {
                nw = minW;
                nx = s.rStartX + s.rStartW - minW;
            }
            if (nx < 0) {
                nw = nw + nx;
                nx = 0;
            }
            s.x = nx;
            s.w = nw;
        }
        if (dir == 2 || dir == 4) {
            // 右缘：只动宽度，最小宽度与客户区右界钳制。
            int nw = s.rStartW + dx;
            if (nw < minW) { nw = minW; }
            if (s.rStartX + nw > W) { nw = W - s.rStartX; }
            s.w = nw;
        }
        if (dir >= 3) {
            // 下缘/两角：只动高度，最小高度与客户区底界钳制。
            int nh = s.rStartH + dy;
            if (nh < minH) { nh = minH; }
            if (s.rStartY + nh > H) { nh = H - s.rStartY; }
            s.h = nh;
        }
    }

    // 最小化窗口在左下角任务条上的位置（仅剩一条标题栏，宽 260）：
    // 槽位从左往右横排，一行放不下向上折行。命中区（Bounds）与
    // 绘制（RenderActive）都从这里取位，保证两者始终一致。
    public static void MinPos(App app, LayerState s, List<int> outv) {
        int mw = app.Scale(260);
        int gap = app.Scale(8);
        int margin = app.Scale(8);
        int bar = Layer.BarH(app);
        int W = app.canvas.Width();
        int H = app.canvas.Height();
        int perRow = (W - margin * 2 + gap) / (mw + gap);
        if (perRow < 1) { perRow = 1; }
        int col = s.minSlot % perRow;
        int row = s.minSlot / perRow;
        outv.Add(margin + col * (mw + gap));
        outv.Add(H - margin - bar - row * (bar + gap));
    }

    // `s` 实际在屏幕上的边界（考虑最大化 / 最小化），
    // 写入 4 元素 int 列表 [x, y, w, h]。
    public static void Bounds(App app, LayerState s, List<int> outv) {
        int top = app.titlebarH;
        int bar = Layer.BarH(app);
        int ex = s.x; int ey = s.y; int ew = s.w; int eh = s.h;
        if (s.state == 1) {
            ex = 0; ey = top; ew = app.canvas.Width(); eh = app.canvas.Height() - top;
        } else if (s.state == 2) {
            List<int> mp = new List<int>();
            Layer.MinPos(app, s, mp);
            ex = mp[0]; ey = mp[1];
            ew = app.Scale(260); eh = bar;
        }
        outv.Add(ex); outv.Add(ey); outv.Add(ew); outv.Add(eh);
    }

    public static bool Contains(App app, LayerState s, int mx, int my) {
        List<int> b = new List<int>();
        Layer.Bounds(app, s, b);
        return Layer.Inside(mx, my, b[0], b[1], b[2], b[3]);
    }

    // layer 打开以来的入场进度（千分比）；仍在缓入时
    // 会重新启动动画计时。
    public static int Entrance(App app, LayerState s) {
        if (s.openMs <= 0) { return 1000; }
        int el = Window.GetTickMs() - s.openMs;
        int p = App.Ease(Layer.Clamp01(el * 1000 / 180));
        if (p < 1000) {
            List<int> b = new List<int>();
            Layer.Bounds(app, s, b);
            // 损伤区要盖住整个入场行程：窗口/对话框从终点上方 10/12px（DPI 缩放后更大）滑下来，
            // 只申终点矩形的话，动画帧按矩形并集局部出图，顶部会留下一条谁也不再重画的残影条。
            app.RequestAnimationFrameIn(b[0], b[1] - app.Scale(16),
                b[2], b[3] + app.Scale(16));
        }
        return p;
    }

    // 入场动画当前的竖直上移量（px）：外框（RenderWindow）画的时候把窗口 y 上移这么多，宿主自绘正文的窗口（设计器大编辑器）必须用同一偏移定位正文，否则入场那 180ms 只有外框在动、内容停在终点不动。
    public static int EntranceDy(App app, LayerState s) {
        return (1000 - Layer.Entrance(app, s)) * app.Scale(10) / 1000;
    }

    // 出场动画时长（layui isOutAnim ~300ms 的量级）。
    public static int ExitMs() { return 240; }

    // 出场进度（0..1000）：closing 层在关闭沿之后的淡出/位移进度，
    // 非 closing 层恒 1000。渲染路径用它衰减 shade 与表面。
    public static int ExitP(LayerState s) {
        if (!s.closing || s.closeMs <= 0) { return 1000; }
        return App.Ease(Layer.Clamp01((Window.GetTickMs() - s.closeMs)
            * 1000 / Layer.ExitMs()));
    }

    // 出场衰减：按 a‰ 乘法衰减颜色的既有 alpha（a=1000 原样返回）。
    // Style.Fade 是「设为 a‰」的绝对语义，对 0x22000000 阴影、遮罩
    // ov.bg 这类预透明色，a=1000 时会跳成全不透明——淡出必须用
    // 乘法衰减。
    public static int MulAlpha(int color, int a) {
        if (a >= 1000) { return color; }
        if (a <= 0) { return 0; }
        int rgb = color % 16777216;
        if (rgb < 0) { rgb = rgb + 16777216; }
        int al = (color - rgb) / 16777216 + 256;
        return (al * a / 1000) * 16777216 + rgb;
    }

    // !open 层的关闭沿：第一帧启动出场并补触发 Closed（Layer.Close
    // 路径已在 Close 里触发过，closedRaised 拦住二次触发），其后画
    // 淡出/上滑收场帧（模态对话框走整屏遮罩+表面，页面窗口走窗口
    // 自身），走完请求整帧重绘擦净。返回 true 表示本帧处理了该层
    // （调用方不必再画它）。
    public static bool ClosingFrame(App app, LayerState s) {
        if (s.wasOpen) {
            Layer.BeginExit(s);
            if (!s.closedRaised) {
                s.closedRaised = true;
                s.Closed.Raise();
            }
        }
        if (!s.closing) { return false; }
        int outP = Layer.ExitP(s);
        if (outP < 1000) {
            if (s.modal) { Layer.RenderDialogExit(app, s, outP); }
            else { Layer.RenderClosing(app, s, outP); }
            // 遮罩淡出覆盖整屏，动画损伤区按整画布申请（窗口矩形
            // 不够——下一帧遮罩变浅的每一处像素都要重画）。
            app.RequestAnimationFrameIn(0, 0,
                                        app.canvas.Width(), app.canvas.Height());
            return true;
        }
        s.closing = false;
        app.RequestRedraw();
        return true;
    }

    // 从后往前绘制页面窗口堆栈（最后一个 = 最顶层）。点击
    // 任一窗口都会将其置顶；只有指针下最顶层的窗口（或被拖动者）
    // 才消费鼠标事件。
    public static void RenderStack(App app, List<LayerState> list) {
        AppLayerContext ctx = Layer.Context(app);
        Layer.PruneZorder(ctx);
        int ek = app.EventKind();
        int mx = app.mouseX;
        int my = app.mouseY;

        int drag = 0 - 1;
        for (int j = 0; j < list.Count; j = j + 1) {
            if (list[j].dragging || list[j].sizing) { drag = j; }
        }

        int active = drag;
        if (active < 0) {
            int i = list.Count - 1;
            while (i >= 0) {
                LayerState s = list[i];
                if (s.open && Layer.Contains(app, s, mx, my)) { active = i; i = 0 - 1; }
                else { i = i - 1; }
            }
        }

        if (ek == 2 && active >= 0 && active < list.Count - 1) {
            LayerState s = list[active];
            list.RemoveAt(active);
            list.Add(s);
            active = list.Count - 1;
        }

        // 最小化窗口按当前堆叠顺序领取左下角任务条槽位；
        // 某个窗口还原离场后，余者自动向左收拢。
        int minIdx = 0;
        for (int k = 0; k < list.Count; k = k + 1) {
            LayerState ms = list[k];
            if (ms.open && ms.state == 2) {
                ms.minSlot = minIdx;
                minIdx = minIdx + 1;
            }
        }

        for (int k = 0; k < list.Count; k = k + 1) {
            Layer.RenderActive(app, list[k], k == active);
        }
        // 宿主驱动的模态对话框（Layer.Render 单层路径）关闭后宿主不再
        // 调 Render；这里从打开注册表把尚在出场的对话框补画收场帧
        // （页面之上、toast 之下），走完由 ClosingFrame 触发 Closed。
        if (ctx.zorder != null) {
            for (int k = 0; k < ctx.zorder.Count; k = k + 1) {
                LayerState zs = ctx.zorder[k];
                if (!zs.open && zs.modal && (zs.closing || zs.wasOpen)) {
                    Layer.ClosingFrame(app, zs);
                }
            }
        }
        Layer.FlushCloseRedraw(app);
    }

    // CloseLast/CloseAll 翻开 open 标志时没有 App 可请求重绘；渲染沿
    // 结束后在这里兑现（无论该层走的是哪条渲染路径——宿主可能只渲染
    // 这一个层就返回）。CloseTopmostDialog/Key/Close 已就地请求。
    public static void FlushCloseRedraw(App app) {
        AppLayerContext ctx = Layer.Context(app);
        if (ctx.requestRedraw) {
            ctx.requestRedraw = false;
            app.RequestRedraw();
        }
    }

}
