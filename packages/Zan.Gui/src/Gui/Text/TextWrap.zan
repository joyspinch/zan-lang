using System;
using System.Collections.Generic;
using Gui;
namespace Gui;
public class TextWrap {
    static string Trim(string s) {
        if (s == null) { return ""; }
        int len = s.Length;
        int a = 0;
        for (; a < len; a = a + 1) {
            int b = s[a] & 255;
            if (b != 32 && b != 9 && b != 13 && b != 10) { break; }
        }
        int z = len;
        while (z > a) {
            int b = s[z - 1] & 255;
            if (b != 32 && b != 9 && b != 13 && b != 10) { break; }
            z = z - 1;
        }
        if (a == 0 && z == len) { return s; }
        return s.Substring(a, z - a);
    }
    static WrappedText LinesAt(string s, int maxW, int fs) {
        WrappedText wrapped = new WrappedText();
        Wrap(s, maxW, fs, null, wrapped);
        return wrapped;
    }
    static List<string> Lines(string s, int maxW, int fs) {
        List<string> lines = new List<string>();
        Wrap(s, maxW, fs, lines, null);
        return lines;
    }
    private static void Wrap(string s, int maxW, int fs, List<string> lines, WrappedText wrapped) {
        if (s == null) { s = ""; }
        if (maxW <= 0) { maxW = 1; }
        int len = s.Length;
        int start = 0;
        do {
            int width = 0;
            int end = start;
            int lastSpace = -1;
            while (end < len && (s[end] & 255) != 10) {
                int b = s[end] & 255;
                int next;
                int charWidth;
                if (b >= 32 && b <= 126) {
                    next = end + 1;
                    charWidth = Canvas.MeasureChar(b, fs);
                } else {
                    next = Text.NextCharEnd(s, end);
                    if (next <= end) { next = end + 1; }
                    charWidth = Canvas.MeasureText(s.Substring(end, next - end), fs);
                }
                if (width + charWidth > maxW && end > start) { break; }
                width = width + charWidth;
                end = next;
                if (b == 32) { lastSpace = end; }
            }
            if (end < len && (s[end] & 255) != 10 && lastSpace > start) { end = lastSpace; }
            string line = end == start ? "" : s.Substring(start, end - start);
            if (wrapped != null) { wrapped.Add(line, start); }
            else if (lines != null) { lines.Add(line); }
            start = end;
            if (start < len && (s[start] & 255) == 10) { start = start + 1; }
        } while (start < len);
    }
    static int WidestChar(string s, int fs) {
        if (s == null) { return 0; }
        int mc = 0;
        int i = 0;
        while (i < s.Length) {
            int b = s[i] & 255;
            int cw;
            if (b >= 32 && b <= 126) {
                cw = Canvas.MeasureChar(b, fs);
                i = i + 1;
            } else {
                int e = Text.NextCharEnd(s, i);
                if (e <= i) { e = i + 1; }
                cw = Canvas.MeasureText(s.Substring(i, e - i), fs);
                i = e;
            }
            if (cw > mc) { mc = cw; }
        }
        return mc;
    }
    static List<string> SplitLines(string s) {
        List<string> lines = new List<string>();
        if (s == null) {
            lines.Add("");
            return lines;
        }
        int len = s.Length;
        if (len == 0) {
            lines.Add("");
            return lines;
        }
        int start = 0;
        int i = 0;
        while (i < len) {
            int b = s[i] & 255;
            if (b == 10) {  // '\n'
                int end = i;
                if (end > start && (s[end - 1] & 255) == 13) {  // '\r'
                    end = end - 1;
                }
                lines.Add(s.Substring(start, end - start));
                start = i + 1;
            }
            i = i + 1;
        }
        int lastEnd = len;
        if (lastEnd > start && (s[lastEnd - 1] & 255) == 13) { lastEnd = lastEnd - 1; }
        lines.Add(s.Substring(start, lastEnd - start));
        return lines;
    }
    static int ColFromX(string s, int px, int fontSize) {
        if (px <= 0) { return 0; }
        if (s == null || s.Length == 0) { return 0; }
        int len = s.Length;
        bool isAscii = true;
        int i = 0;
        while (i < len) {
            if ((s[i] & 255) >= 128) {
                isAscii = false;
                break;
            }
            i = i + 1;
        }
        if (isAscii) {
            int lo = 0;
            int hi = len - 1;
            int ansIdx = -1;
            while (lo <= hi) {
                int mid = (lo + hi) >> 1;
                int endPos = mid + 1;
                int w = Canvas.MeasureText(s.Substring(0, endPos), fontSize);
                if (w >= px) { ansIdx = mid; hi = mid - 1; }
                else { lo = mid + 1; }
            }
            if (ansIdx < 0) { return len; }
            return ansIdx + 1;
        }
        List<int> ends = new List<int>();
        int p = Text.NextCharEnd(s, 0);
        while (p <= len) {
            ends.Add(p);
            if (p >= len) { break; }
            int nextP = Text.NextCharEnd(s, p);
            if (nextP <= p) { break; }
            p = nextP;
        }
        int lo2 = 0;
        int hi2 = ends.Count - 1;
        int ansIdx2 = -1;
        while (lo2 <= hi2) {
            int mid2 = (lo2 + hi2) >> 1;
            int w2 = Canvas.MeasureText(Text.Left(s, ends[mid2]), fontSize);
            if (w2 >= px) { ansIdx2 = mid2; hi2 = mid2 - 1; }
            else { lo2 = mid2 + 1; }
        }
        if (ansIdx2 < 0) { return len; }
        return ends[ansIdx2];
    }
}
