using System;
using System.Collections.Generic;
using Gui;
using Gui.Backend;

namespace Gui;

public class RichTextDocument {
    string sourceText;
    List<RichTextRun> runs;

    RichTextDocument(string sourceText) {
        this.sourceText = sourceText;
        this.runs = new List<RichTextRun>();
    }

    // 解析前的原始输入。
    string SourceText() { return this.sourceText; }
    // run 总数。
    int RunCount() { return this.runs.Count; }
    // 第 index 个 run（不查越界）。
    RichTextRun RunAt(int index) { return this.runs[index]; }
    // 追加一个 run 到末尾。
    void Add(RichTextRun run) { this.runs.Add(run); }
}
