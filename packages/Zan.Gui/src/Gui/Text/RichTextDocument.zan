using System;
using System.Text;

namespace Gui;

// 富文本 run 类型常量：Text=0 纯文本、Image=1 图片（#p）、
// Animation=2 动画（#a）、Spacer=3 空白占位（#z）、
// Item=4 物品片段（#item）、LineBreak=5 换行（源文本 \n）、
// WrapWidth=6 换行宽度段（#br(宽度) 或 #md/#rt 携带宽度时）。
class RichTextRunKind {
    // 纯文本 run 类型常量（0）。
    static int Text() { return 0; }
    // 图片 run 类型常量（1），由 #p(资源,x,y,宽,高) 产生。
    static int Image() { return 1; }
    // 动画 run 类型常量（2），由 #a(资源,动作,缩放,宽,高,x,y) 产生。
    static int Animation() { return 2; }
    // 空白占位 run 类型常量（3），由 #z(宽,高) 产生。
    static int Spacer() { return 3; }
    // 物品片段 run 类型常量（4），由 #item(资源,数量) 产生。
    static int Item() { return 4; }
    // 换行 run 类型常量（5），源文本中的每个 \n 产生一个。
    static int LineBreak() { return 5; }
    // 换行宽度 run 类型常量（6）；携带宽度时改变后续换行宽度，宽度 0 仅切换对齐。
    static int WrapWidth() { return 6; }
}

// 富文本链接（#@标记@内容@ 语法中标记部分的类型化表示）。
// 标记格式为 "action|参数列表"：竖线前是链接动作文本，竖线后
// 可带逗号分隔的 1~4 个参数：样式编号、常态色、悬停色、按下色。
// 颜色参数按 0xRRGGBBAA 书写，存为 Gui 的 0xAARRGGBB 打包 int；
// 未提供的颜色为 0（全透明）。
class RichTextLink {
    string raw;
    int style;
    int normalColor;
    int hoverColor;
    int pressedColor;

    RichTextLink(string marker) {
        this.raw = marker;
        this.style = 0;
        this.normalColor = 0;
        this.hoverColor = 0;
        this.pressedColor = 0;

        int pipe = RichTextParser.FindIn(marker, "|", 0);
        string action = marker;
        if (pipe >= 0) {
            action = marker.Substring(0, pipe);
            string styleArgs = marker.Substring(pipe + 1);
            int styleCount = RichTextParser.ArgCount(styleArgs);
            if (styleCount > 0) {
                this.style = RichTextParser.ParseInt(
                    RichTextParser.ArgAt(styleArgs, 0));
            }
            if (styleCount > 1) {
                this.normalColor =
                    RichTextParser.ParseColor(
                    RichTextParser.ArgAt(styleArgs, 1));
            }
            if (styleCount > 2) {
                this.hoverColor =
                    RichTextParser.ParseColor(
                    RichTextParser.ArgAt(styleArgs, 2));
            }
            if (styleCount > 3) {
                this.pressedColor =
                    RichTextParser.ParseColor(
                    RichTextParser.ArgAt(styleArgs, 3));
            }
        }
        this.raw = action;
    }

    // 链接动作原文（标记中竖线前的部分）。
    string Raw() { return this.raw; }
    // 动作参数个数（按逗号分隔；无参数为 0）。
    int Count() { return RichTextParser.ArgCount(this.raw); }
    // 第 index 个动作参数（两侧去空白）；越界返回空串。
    string At(int index) {
        return RichTextParser.ArgAt(this.raw, index);
    }
    // 样式编号（标记第 1 个参数，未提供为 0）。
    int Style() { return this.style; }
    // 常态颜色（0xAARRGGBB，未提供时为 0）。
    int NormalColor() { return this.normalColor; }
    // 悬停颜色（0xAARRGGBB，未提供时为 0）。
    int HoverColor() { return this.hoverColor; }
    // 按下颜色（0xAARRGGBB，未提供时为 0）。
    int PressedColor() { return this.pressedColor; }
}

// 富文本样式快照：前景/背景色、字体名与水平对齐。
// 解析过程中随 #c/#bg/#f/#md/#rt 等标签变化，并拷贝进
// 后续创建的 run。颜色均为 Gui 的 0xAARRGGBB 打包 int；
// 对齐取值：0=左，1=中（#md），2=右（#rt）。
class RichTextStyle {
    int color;
    int background;
    string font;
    int alignment;

    RichTextStyle(int color, int background, string font, int alignment) {
        this.color = color;
        this.background = background;
        this.font = font;
        this.alignment = alignment;
    }

    // 默认样式：白字、透明背景、空字体名、左对齐。
    static RichTextStyle Default() {
        return new RichTextStyle((int)0xFFFFFFFF, 0, "", 0);
    }

    // 返回独立副本（修改副本不影响原样式）。
    RichTextStyle Clone() {
        return new RichTextStyle(
            this.color, this.background, this.font, this.alignment);
    }

    // 当前前景色（0xAARRGGBB）。
    int Color() { return this.color; }
    // 当前背景色（0xAARRGGBB，0 = 无背景）。
    int Background() { return this.background; }
    // 当前字体名（空串表示默认字体）。
    string Font() { return this.font; }
    // 当前水平对齐：0=左，1=中（#md），2=右（#rt）。
    int Alignment() { return this.alignment; }
    // 设置前景色（0xAARRGGBB；影响后续创建的 run）。
    void SetColor(int newValue) { this.color = newValue; }
    // 设置背景色（0xAARRGGBB）。
    void SetBackground(int newValue) { this.background = newValue; }
    // 设置字体名。
    void SetFont(string newValue) { this.font = newValue; }
    // 设置水平对齐（0=左 1=中 2=右）。
    void SetAlignment(int newValue) { this.alignment = newValue; }
}

// 富文本解析产物的单个片段（run）：一段文本、一张图片、一个
// 动画、一个占位或一次换行。携带创建时刻的样式快照与所在链接
// （非链接 run 的 Link 为 null），布局/绘制层按 Kind 分派处理。
class RichTextRun {
    int kind;
    string text;
    string resource;
    string action;
    int quantity;
    int offsetX;
    int offsetY;
    int width;
    int height;
    double scale;
    RichTextStyle style;
    RichTextLink link;

    RichTextRun(int kind, RichTextStyle style, RichTextLink link) {
        this.kind = kind;
        this.text = "";
        this.resource = "";
        this.action = "";
        this.quantity = 0;
        this.offsetX = 0;
        this.offsetY = 0;
        this.width = 0;
        this.height = 0;
        this.scale = 1.0;
        this.style = style.Clone();
        this.link = link;
    }

    // 创建一个默认样式、无链接的纯文本 run。
    static RichTextRun CreateText(string text) {
        RichTextRun run = new RichTextRun(
            RichTextRunKind.Text(), RichTextStyle.Default(), null);
        run.text = text;
        return run;
    }

    // run 类型（RichTextRunKind 常量）。
    int Kind() { return this.kind; }
    // 文本内容（仅 Text run 有意义，其他为空串）。
    string Text() { return this.text; }
    // 资源 Id（Image/Animation/Item run）。
    string Resource() { return this.resource; }
    // 动画动作名（仅 Animation run 有意义）。
    string Action() { return this.action; }
    // 物品数量（仅 Item run 有意义）。
    int Quantity() { return this.quantity; }
    // 相对排版位置的 X 偏移（像素）。
    int OffsetX() { return this.offsetX; }
    // 相对排版位置的 Y 偏移（像素）。
    int OffsetY() { return this.offsetY; }
    // 宽度（像素；图片/动画未指定时布局按字号兜底）。
    int Width() { return this.width; }
    // 高度（像素；未指定时布局按字号兜底）。
    int Height() { return this.height; }
    // 动画缩放（默认 1.0）。
    double Scale() { return this.scale; }
    // 创建时刻的样式快照（独立副本，修改不影响其他 run）。
    RichTextStyle Style() { return this.style; }
    // 所在链接；非链接 run 返回 null。
    RichTextLink Link() { return this.link; }
    // 该 run 是否位于超链接内。
    bool IsLink() { return this.link != null; }

    // 设置文本内容。
    void SetText(string newValue) { this.text = newValue; }
    // 设置资源 Id。
    void SetResource(string newValue) { this.resource = newValue; }
    // 设置动画动作名。
    void SetAction(string newValue) { this.action = newValue; }
    // 设置物品数量。
    void SetQuantity(int newValue) { this.quantity = newValue; }
    // 同时设置 X/Y 偏移（像素）。
    void SetOffset(int x, int y) {
        this.offsetX = x;
        this.offsetY = y;
    }
    // 同时设置宽高（像素）。
    void SetSize(int width, int height) {
        this.width = width;
        this.height = height;
    }
    // 设置动画缩放。
    void SetScale(double newValue) { this.scale = newValue; }
}

// 富文本解析结果：原始输入与按序排列的 run 列表。绘制/布局层
// 遍历 runs 并按各 run 的 Kind 分派处理。
class RichTextDocument {
    string sourceText;
    List<RichTextRun> runs;

    RichTextDocument(string sourceText) {
        this.sourceText = sourceText;
        this.runs = new List<RichTextRun>();
    }

    // 解析前的原始输入。
    string SourceText() { return this.sourceText; }
    // run 总数。
    int RunCount() { return this.runs.Count; }
    // 第 index 个 run（不查越界）。
    RichTextRun RunAt(int index) { return this.runs[index]; }
    // 追加一个 run 到末尾。
    void Add(RichTextRun run) { this.runs.Add(run); }
}

// 富文本解析器：把标签化文本切分为类型化 run 流。支持颜色
// 快捷标记（#W #R #Y #B #G #H #L）、#c()/#bg()/#f() 样式标签、
// #p()/#a()/#z()/#item() 资源标签、#br(宽度)/#md/#rt/#lf 排版标签
// 与 #@标记@内容@ 超链接。无法识别的 # 按普通文本保留；
// ## 转义为字面 #（聊天正文里出现 # 时用）。颜色书写遵循
// 0xRRGGBBAA（与 Game.Arpg 同一种标记语言），内部统一存为
// Gui 的 0xAARRGGBB。
class RichTextParser {
    string input;
    int position;
    RichTextDocument document;
    RichTextStyle style;
    RichTextLink link;

    RichTextParser(string input, RichTextStyle style, RichTextLink link) {
        this.input = input;
        this.position = 0;
        this.document = new RichTextDocument(input);
        this.style = style;
        this.link = link;
    }

    // 便捷入口：按默认样式解析整段标记文本。
    static RichTextDocument ParseText(string input) {
        RichTextParser parser = new RichTextParser(
            input, RichTextStyle.Default(), null);
        return parser.Parse();
    }

    // `defaultColor` 是没写色码段落的初始前景（0xAARRGGBB）：
    // 控件把皮肤 `richtext` 规则的前景传进来，亮色皮肤才能有
    // 深色默认段——Default() 的纯白是深色游戏底的习惯。
    static RichTextDocument ParseText(string input, int defaultColor) {
        RichTextParser parser = new RichTextParser(
            input, new RichTextStyle(defaultColor, 0, "", 0), null);
        return parser.Parse();
    }

    // 在 text 中从 start 起查找 token 首次出现的位置；未找到返回 -1。
    static int FindIn(string text, string token, int start) {
        int i = start;
        while (i + token.Length <= text.Length) {
            if (text.Substring(i, token.Length) == token) { return i; }
            i = i + 1;
        }
        return -1;
    }

    // 按逗号分隔的参数个数（空串为 0，"a,,b" 计 3）。
    static int ArgCount(string text) {
        if (text == "") { return 0; }
        int count = 1;
        for (int i = 0; i < text.Length; i = i + 1) {
            if (text.Substring(i, 1) == ",") { count = count + 1; }
        }
        return count;
    }

    // 第 index 个逗号分隔参数（两侧去空白）；越界返回空串。
    static string ArgAt(string text, int index) {
        int current = 0;
        int start = 0;
        string result = "";
        for (int i = 0; i <= text.Length; i = i + 1) {
            if (i == text.Length || text.Substring(i, 1) == ",") {
                if (current == index) {
                    string segment = text.Substring(start, i - start);
                    result = RichTextParser.TrimText(segment);
                    i = text.Length + 1;
                } else {
                    current = current + 1;
                    start = i + 1;
                }
            }
        }
        return result;
    }

    // 单个字符是否为空白（空格/制表/回车/换行）。
    static bool IsSpace(string ch) {
        return ch == " " || ch == "\t" || ch == "\r" || ch == "\n";
    }

    // 两侧去空白。
    static string TrimText(string s) {
        int start = 0;
        int end = s.Length;
        while (start < end && RichTextParser.IsSpace(s.Substring(start, 1))) {
            start = start + 1;
        }
        while (end > start
            && RichTextParser.IsSpace(s.Substring(end - 1, 1))) {
            end = end - 1;
        }
        return s.Substring(start, end - start);
    }

    // 当前位置是否以 token 开头（不消费）。
    static bool StartsAt(string text, int pos, string token) {
        if (pos + token.Length > text.Length) { return false; }
        return text.Substring(pos, token.Length) == token;
    }

    // 单个十六进制字符的数值（0-9/a-f/A-F）；其他字符返回 0。
    static int HexDigit(string digit) {
        if (digit >= "0" && digit <= "9") {
            return Encoding.ParseInt(digit);
        }
        if (digit == "a" || digit == "A") { return 10; }
        if (digit == "b" || digit == "B") { return 11; }
        if (digit == "c" || digit == "C") { return 12; }
        if (digit == "d" || digit == "D") { return 13; }
        if (digit == "e" || digit == "E") { return 14; }
        if (digit == "f" || digit == "F") { return 15; }
        return 0;
    }

    // 解析整数：支持十进制与 0x 前缀十六进制（可带负号），
    // 两侧去空白；无有效数字时返回 0（不置错）。
    static int ParseInt(string text) {
        string newValue = RichTextParser.TrimText(text);
        bool negative = false;
        int start = 0;
        if (newValue.Length > 0 && newValue.Substring(0, 1) == "-") {
            negative = true;
            start = 1;
        }
        if (newValue.Length >= start + 2
            && newValue.Substring(start, 2) == "0x") {
            int number = 0;
            int i = start + 2;
            while (i < newValue.Length) {
                number = number * 16 + HexDigit(newValue.Substring(i, 1));
                i = i + 1;
            }
            if (negative) { return -number; }
            return number;
        }
        return Encoding.ParseInt(newValue);
    }

    // 解析 0xRRGGBBAA 颜色为 Gui 的 0xAARRGGBB 打包 int；
    // 空串、"0" 或格式不符返回 0（全透明）。
    static int ParseColor(string text) {
        string newValue = RichTextParser.TrimText(text);
        if (newValue == "" || newValue == "0") { return 0; }
        if (newValue.Length >= 2 && newValue.Substring(0, 2) == "0x") {
            string digits = newValue.Substring(2);
            if (digits.Length == 8) {
                int red = HexDigit(digits.Substring(0, 1)) * 16
                    + HexDigit(digits.Substring(1, 1));
                int green = HexDigit(digits.Substring(2, 1)) * 16
                    + HexDigit(digits.Substring(3, 1));
                int blue = HexDigit(digits.Substring(4, 1)) * 16
                    + HexDigit(digits.Substring(5, 1));
                int alpha = HexDigit(digits.Substring(6, 1)) * 16
                    + HexDigit(digits.Substring(7, 1));
                return (alpha << 24) | (red << 16) | (green << 8) | blue;
            }
        }
        return 0;
    }

    // 解析颜色参数串：1 个参数按 0xRRGGBBAA，4 个参数按
    // r,g,b,a 十进制；其他情况返回 0（全透明）。
    static int ParseColorArgs(string args) {
        int count = ArgCount(args);
        if (count == 1) { return ParseColor(ArgAt(args, 0)); }
        if (count >= 4) {
            int red = ParseInt(ArgAt(args, 0));
            int green = ParseInt(ArgAt(args, 1));
            int blue = ParseInt(ArgAt(args, 2));
            int alpha = ParseInt(ArgAt(args, 3));
            return (alpha << 24) | (red << 16) | (green << 8) | blue;
        }
        return 0;
    }

    // 当前位置是否以 token 开头（不消费）。
    bool Starts(string token) {
        return RichTextParser.StartsAt(
            this.input, this.position, token);
    }

    // 读取当前位置起 prefixLength 个字符之后的括号体并消费到
    // ')' 之后；找不到闭括号返回 null 且不消费。
    string Parenthesized(int prefixLength) {
        int close = FindIn(this.input, ")", this.position + prefixLength);
        if (close < 0) { return null; }
        string newValue = this.input.Substring(
            this.position + prefixLength,
            close - this.position - prefixLength);
        this.position = close + 1;
        return newValue;
    }

    // 追加一个文本 run（空串忽略），携带当前样式与链接。
    void AddText(string text) {
        if (text == "") { return; }
        RichTextRun run = new RichTextRun(
            RichTextRunKind.Text(), this.style, this.link);
        run.SetText(text);
        this.document.Add(run);
    }

    // 追加一个指定类型的 run，携带当前样式与链接。
    void AddSimple(int kind) {
        this.document.Add(new RichTextRun(kind, this.style, this.link));
    }

    // 以给定链接嵌套解析 text（样式为当前样式的副本），把结果
    // run 依次并入本文档；用于 #@标记@内容@ 的内容部分。
    void AddNested(string text, RichTextLink nestedLink) {
        RichTextParser parser = new RichTextParser(
            text, this.style.Clone(), nestedLink);
        RichTextDocument nested = parser.Parse();
        for (int i = 0; i < nested.RunCount(); i = i + 1) {
            this.document.Add(nested.RunAt(i));
        }
    }

    // 尝试解析当前位置的颜色快捷标记（#W #R #Y #B #G #H #L）；
    // 命中则设置样式颜色并消费 2 字符返回 true。
    bool ParseColorShortcut() {
        if (this.position + 2 > this.input.Length) { return false; }
        string tag = this.input.Substring(this.position, 2);
        bool found = false;
        int color = 0;
        if (tag == "#W") { color = (int)0xFFFFFFFF; found = true; }
        if (tag == "#R") { color = (int)0xFFFF0000; found = true; }
        if (tag == "#Y") { color = (int)0xFFFFFF00; found = true; }
        if (tag == "#B") { color = (int)0xFF0000FF; found = true; }
        if (tag == "#G") { color = (int)0xFF00FF00; found = true; }
        if (tag == "#H") { color = (int)0xFF808080; found = true; }
        if (tag == "#L") { color = (int)0xFF60C0FF; found = true; }
        if (!found) { return false; }
        this.style.SetColor(color);
        this.position = this.position + 2;
        return true;
    }

    // 尝试解析当前位置的任一标签并消费输入；命中返回 true，
    // 未命中返回 false（调用方把 '#' 按普通文本处理）。
    bool ParseTag() {
        bool parsed = false;
        if (this.ParseColorShortcut()) {
            parsed = true;
        } else if (this.Starts("#c(")) {
            string body = this.Parenthesized(3);
            if (body != null) {
                this.style.SetColor(ParseColorArgs(body));
                parsed = true;
            }
        } else if (this.Starts("#bg(")) {
            string body = this.Parenthesized(4);
            if (body != null) {
                this.style.SetBackground(ParseColorArgs(body));
                parsed = true;
            }
        } else if (this.Starts("#f(")) {
            string body = this.Parenthesized(3);
            if (body != null) {
                this.style.SetFont(body);
                parsed = true;
            }
        } else if (this.Starts("#p(")) {
            string body = this.Parenthesized(3);
            if (body != null) {
                RichTextRun run = new RichTextRun(
                    RichTextRunKind.Image(), this.style, this.link);
                int count = ArgCount(body);
                if (count > 0) { run.SetResource(ArgAt(body, 0)); }
                int x = 0;
                int y = 0;
                int width = 0;
                int height = 0;
                if (count > 1) { x = ParseInt(ArgAt(body, 1)); }
                if (count > 2) { y = ParseInt(ArgAt(body, 2)); }
                if (count > 3) { width = ParseInt(ArgAt(body, 3)); }
                if (count > 4) { height = ParseInt(ArgAt(body, 4)); }
                run.SetOffset(x, y);
                run.SetSize(width, height);
                this.document.Add(run);
                parsed = true;
            }
        } else if (this.Starts("#a(")) {
            string body = this.Parenthesized(3);
            if (body != null) {
                RichTextRun run = new RichTextRun(
                    RichTextRunKind.Animation(), this.style, this.link);
                int count = ArgCount(body);
                if (count > 0) { run.SetResource(ArgAt(body, 0)); }
                if (count > 1) { run.SetAction(ArgAt(body, 1)); }
                if (count > 2) {
                    run.SetScale(Encoding.ParseDouble(ArgAt(body, 2)));
                }
                int width = 0;
                int height = 0;
                int x = 0;
                int y = 0;
                if (count > 3) { width = ParseInt(ArgAt(body, 3)); }
                if (count > 4) { height = ParseInt(ArgAt(body, 4)); }
                if (count > 5) { x = ParseInt(ArgAt(body, 5)); }
                if (count > 6) { y = ParseInt(ArgAt(body, 6)); }
                run.SetSize(width, height);
                run.SetOffset(x, y);
                this.document.Add(run);
                parsed = true;
            }
        } else if (this.Starts("#z(")) {
            string body = this.Parenthesized(3);
            if (body != null) {
                RichTextRun run = new RichTextRun(
                    RichTextRunKind.Spacer(), this.style, this.link);
                int count = ArgCount(body);
                int width = 0;
                int height = 0;
                if (count > 0) { width = ParseInt(ArgAt(body, 0)); }
                if (count > 1) { height = ParseInt(ArgAt(body, 1)); }
                run.SetSize(width, height);
                this.document.Add(run);
                parsed = true;
            }
        } else if (this.Starts("#item(")) {
            string body = this.Parenthesized(6);
            if (body != null) {
                RichTextRun run = new RichTextRun(
                    RichTextRunKind.Item(), this.style, this.link);
                int count = ArgCount(body);
                if (count > 0) { run.SetResource(ArgAt(body, 0)); }
                if (count > 1) {
                    run.SetQuantity(ParseInt(ArgAt(body, 1)));
                }
                this.document.Add(run);
                parsed = true;
            }
        } else if (this.Starts("#br(")) {
            string body = this.Parenthesized(4);
            if (body != null) {
                RichTextRun run = new RichTextRun(
                    RichTextRunKind.WrapWidth(), this.style, this.link);
                run.SetSize(ParseInt(body), 0);
                this.document.Add(run);
                parsed = true;
            }
        } else if (this.Starts("#md(") || this.Starts("#rt(")) {
            bool centered = this.Starts("#md(");
            string body = this.Parenthesized(4);
            if (body != null) {
                if (centered) {
                    this.style.SetAlignment(1);
                } else {
                    this.style.SetAlignment(2);
                }
                if (body != "") {
                    RichTextRun run = new RichTextRun(
                        RichTextRunKind.WrapWidth(),
                        this.style,
                        this.link);
                    run.SetSize(ParseInt(body), 0);
                    this.document.Add(run);
                }
                parsed = true;
            }
        } else if (this.Starts("#md")) {
            this.style.SetAlignment(1);
            this.position = this.position + 3;
            parsed = true;
        } else if (this.Starts("#rt")) {
            this.style.SetAlignment(2);
            this.position = this.position + 3;
            parsed = true;
        } else if (this.Starts("#lf")) {
            this.style.SetAlignment(0);
            this.position = this.position + 3;
            parsed = true;
        } else if (this.Starts("#@")) {
            int markerEnd = FindIn(this.input, "@", this.position + 2);
            if (markerEnd >= 0) {
                int contentEnd = FindIn(this.input, "@", markerEnd + 1);
                if (contentEnd >= 0) {
                    string marker = this.input.Substring(
                        this.position + 2,
                        markerEnd - this.position - 2);
                    string content = this.input.Substring(
                        markerEnd + 1, contentEnd - markerEnd - 1);
                    this.position = contentEnd + 1;
                    this.AddNested(content, new RichTextLink(marker));
                    parsed = true;
                }
            }
        }
        return parsed;
    }

    // 解析全部输入并返回文档：\n 产生 LineBreak，'#' 触发标签
    // 解析（未识别时按普通文本保留，## 转义为字面 '#'），
    // 其余字符累积为文本 run。
    RichTextDocument Parse() {
        StringBuilder text = new StringBuilder();
        while (this.position < this.input.Length) {
            string ch = this.input.Substring(this.position, 1);
            if (ch == "\n") {
                this.AddText(text.ToString());
                text = new StringBuilder();
                this.AddSimple(RichTextRunKind.LineBreak());
                this.position = this.position + 1;
            } else if (ch == "#") {
                if (this.Starts("##")) {
                    text.Append("#");
                    this.position = this.position + 2;
                    continue;
                }
                this.AddText(text.ToString());
                text = new StringBuilder();
                if (!this.ParseTag()) {
                    text.Append("#");
                    this.position = this.position + 1;
                }
            } else {
                text.Append(ch);
                this.position = this.position + 1;
            }
        }
        this.AddText(text.ToString());
        return this.document;
    }
}
