using System;
using System.Collections.Generic;
using Gui;
namespace Gui;
public class RichTextDocument {
    string sourceText;
    List<RichTextRun> runs;
    RichTextDocument(string sourceText) {
        this.sourceText = sourceText != null ? sourceText : "";
        this.runs = new List<RichTextRun>();
    }
    string SourceText() { return this.sourceText; }
    int RunCount() { return this.runs.Count; }
    RichTextRun RunAt(int index) {
        if (index < 0 || index >= this.runs.Count) { return RichTextRun.CreateText(""); }
        return this.runs[index];
    }
    void Add(RichTextRun run) {
        if (run != null) { this.runs.Add(run); }
    }
}
