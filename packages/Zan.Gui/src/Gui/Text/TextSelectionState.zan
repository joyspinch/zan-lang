using System;
using Gui;

namespace Gui;

// 文本滚动与多行文本选择状态模型。
public class TextSelectionState {
    public int scroll;  // 滚动行偏移
    public int selR0;   // 选择锚点行，无选择时为 -1
    public int selC0;   // 选择锚点列
    public int selR1;   // 选择端点行
    public int selC1;   // 选择端点列
    public bool selDrag;
    public bool barDrag;

    public TextSelectionState() {
        this.scroll = 0;
        this.selR0 = 0 - 1; this.selC0 = 0;
        this.selR1 = 0 - 1; this.selC1 = 0;
        this.selDrag = false;
        this.barDrag = false;
    }

    // 取消选择（保留滚动位置）。
    public void ClearSelection() {
        selR0 = 0 - 1; selC0 = 0;
        selR1 = 0 - 1; selC1 = 0;
    }

    // 选择至少跨越一个字符时为 true。
    public bool HasSelection() {
        if (selR0 < 0) { return false; }
        return !(selR0 == selR1 && selC0 == selC1);
    }

    // 回到最新一行并取消选择。
    public void Reset() {
        scroll = 0;
        ClearSelection();
    }
}

// 兼容别名
public class LogState : TextSelectionState {
}
