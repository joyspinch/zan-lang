using System;
using System.Collections.Generic;
using Gui;
using Gui.Backend;

namespace Gui;

public class RichTextStyle {
    public int color;
    public int background;
    public string font;
    public int alignment;

    RichTextStyle(int color, int background, string font, int alignment) {
        this.color = color;
        this.background = background;
        this.font = font;
        this.alignment = alignment;
    }

    // 默认样式：白字、透明背景、空字体名、左对齐。
    static RichTextStyle Default() {
        return new RichTextStyle((int)0xFFFFFFFF, 0, "", 0);
    }

    // 返回独立副本（修改副本不影响原样式）。
    RichTextStyle Clone() {
        return new RichTextStyle(
            this.color, this.background, this.font, this.alignment);
    }

    // 当前前景色（0xAARRGGBB）。
    int Color() { return this.color; }
    // 当前背景色（0xAARRGGBB，0 = 无背景）。
    int Background() { return this.background; }
    // 当前字体名（空串表示默认字体）。
    string Font() { return this.font; }
    // 当前水平对齐：0=左，1=中（#md），2=右（#rt）。
    int Alignment() { return this.alignment; }
    // 设置前景色（0xAARRGGBB；影响后续创建的 run）。
    void SetColor(int newValue) { this.color = newValue; }
    // 设置背景色（0xAARRGGBB）。
    void SetBackground(int newValue) { this.background = newValue; }
    // 设置字体名。
    void SetFont(string newValue) { this.font = newValue; }
    // 设置水平对齐（0=左 1=中 2=右）。
    void SetAlignment(int newValue) { this.alignment = newValue; }
}

// 富文本解析产物的单个片段（run）：一段文本、一张图片、一个
// 动画、一个占位或一次换行。携带创建时刻的样式快照与所在链接
// （非链接 run 的 Link 为 null），布局/绘制层按 Kind 分派处理。
