using System;
using System.Collections.Generic;
using Gui;
using Gui.Backend;

namespace Gui;

// 换行展示行实体：封装单行展示文本及其在原文字符串中的字节起始偏移（start），
// 用于精准进行行列与字节位置反算及选中文本高亮像素区间计算。
public class WrappedLine {
    public string text;
    public int start;

    public WrappedLine(string text, int start) {
        this.text = text;
        this.start = start;
    }
}
