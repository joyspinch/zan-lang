using System;
using System.Collections.Generic;
using Gui;
using Gui.Backend;

namespace Gui;

public class RichTextParser {
    string input;
    int position;
    RichTextDocument document;
    RichTextStyle style;
    RichTextLink link;

    RichTextParser(string input, RichTextStyle style, RichTextLink link) {
        this.input = input;
        this.position = 0;
        this.document = new RichTextDocument(input);
        this.style = style;
        this.link = link;
    }

    // 便捷入口：按默认样式解析整段标记文本。
    static RichTextDocument ParseText(string input) {
        RichTextParser parser = new RichTextParser(
            input, RichTextStyle.Default(), null);
        return parser.Parse();
    }

    // `defaultColor` 是没写色码段落的初始前景（0xAARRGGBB）：
    // 控件把皮肤 `richtext` 规则的前景传进来，亮色皮肤才能有
    // 深色默认段——Default() 的纯白是深色游戏底的习惯。
    static RichTextDocument ParseText(string input, int defaultColor) {
        RichTextParser parser = new RichTextParser(
            input, new RichTextStyle(defaultColor, 0, "", 0), null);
        return parser.Parse();
    }

    // 在 text 中从 start 起查找 token 首次出现的位置；未找到返回 -1。
    // 在 text 中从 start 起查找 token 首次出现的位置；未找到返回 -1（纯字符/字节匹配，消除逐位置切片分配）。
    static int FindIn(string text, string token, int start) {
        if (text == null || token == null) { return -1; }
        int tlen = token.Length;
        int tMax = text.Length - tlen;
        if (tlen == 0) { return start <= text.Length ? start : -1; }
        int first = token[0];
        int i = start;
        while (i <= tMax) {
            if (text[i] == first) {
                bool match = true;
                for (int k = 1; k < tlen; k = k + 1) {
                    if (text[i + k] != token[k]) {
                        match = false;
                        break;
                    }
                }
                if (match) { return i; }
            }
            i = i + 1;
        }
        return -1;
    }

    // 按逗号分隔的参数个数（空串为 0，"a,,b" 计 3）。
    static int ArgCount(string text) {
        if (text == null || text == "") { return 0; }
        int count = 1;
        int len = text.Length;
        for (int i = 0; i < len; i = i + 1) {
            if (text[i] == ',') { count = count + 1; }
        }
        return count;
    }

    // 第 index 个逗号分隔参数（两侧去空白）；越界返回空串。
    static string ArgAt(string text, int index) {
        if (text == null) { return ""; }
        int current = 0;
        int start = 0;
        int len = text.Length;
        for (int i = 0; i <= len; i = i + 1) {
            if (i == len || text[i] == ',') {
                if (current == index) {
                    string segment = text.Substring(start, i - start);
                    return RichTextParser.TrimText(segment);
                }
                current = current + 1;
                start = i + 1;
            }
        }
        return "";
    }

    // 单个字符是否为空白（空格/制表/回车/换行）。
    static bool IsSpaceByte(int b) {
        return b == 32 || b == 9 || b == 13 || b == 10;
    }

    // 两侧去空白（基于纯字符索引检测，消除循环内子串分配）。
    static string TrimText(string s) {
        if (s == null) { return ""; }
        int start = 0;
        int end = s.Length;
        while (start < end && RichTextParser.IsSpaceByte(s[start])) {
            start = start + 1;
        }
        while (end > start && RichTextParser.IsSpaceByte(s[end - 1])) {
            end = end - 1;
        }
        if (start == 0 && end == s.Length) { return s; }
        return s.Substring(start, end - start);
    }

    // 当前位置是否以 token 开头（不消费，逐字符匹配零分配）。
    static bool StartsAt(string text, int pos, string token) {
        if (text == null || token == null) { return false; }
        int tlen = token.Length;
        if (pos + tlen > text.Length) { return false; }
        for (int i = 0; i < tlen; i = i + 1) {
            if (text[pos + i] != token[i]) { return false; }
        }
        return true;
    }

    // 单个十六进制字符的数值（0-9/a-f/A-F）；其他字符返回 0。
    static int HexDigit(int b) {
        if (b >= 48 && b <= 57) { return b - 48; } // '0'..'9'
        if (b >= 97 && b <= 102) { return b - 87; } // 'a'..'f'
        if (b >= 65 && b <= 70) { return b - 55; } // 'A'..'F'
        return 0;
    }

    static int HexDigit(string digit) {
        if (digit == null || digit.Length == 0) { return 0; }
        return HexDigit(digit[0] & 255);
    }

    // 解析整数：支持十进制与 0x 前缀十六进制（可带负号），
    // 两侧去空白；无有效数字时返回 0（不置错）。
    static int ParseInt(string text) {
        string newValue = RichTextParser.TrimText(text);
        bool negative = false;
        int start = 0;
        int len = newValue.Length;
        if (len > 0 && newValue[0] == '-') {
            negative = true;
            start = 1;
        }
        if (len >= start + 2 && newValue[start] == '0' && (newValue[start + 1] == 'x' || newValue[start + 1] == 'X')) {
            int number = 0;
            int i = start + 2;
            while (i < len) {
                number = (number << 4) | HexDigit(newValue[i]);
                i = i + 1;
            }
            if (negative) { return -number; }
            return number;
        }
        return Encoding.ParseInt(newValue);
    }

    // 解析 0xRRGGBBAA 颜色为 Gui 的 0xAARRGGBB 打包 int；
    // 空串、"0" 或格式不符返回 0（全透明）。
    static int ParseColor(string text) {
        string newValue = RichTextParser.TrimText(text);
        if (newValue == "" || newValue == "0") { return 0; }
        if (newValue.Length >= 10 && newValue[0] == '0' && (newValue[1] == 'x' || newValue[1] == 'X')) {
            int red = (HexDigit(newValue[2]) << 4) | HexDigit(newValue[3]);
            int green = (HexDigit(newValue[4]) << 4) | HexDigit(newValue[5]);
            int blue = (HexDigit(newValue[6]) << 4) | HexDigit(newValue[7]);
            int alpha = (HexDigit(newValue[8]) << 4) | HexDigit(newValue[9]);
            return (alpha << 24) | (red << 16) | (green << 8) | blue;
        }
        return 0;
    }

    // 解析颜色参数串：1 个参数按 0xRRGGBBAA，4 个参数按
    // r,g,b,a 十进制；其他情况返回 0（全透明）。
    static int ParseColorArgs(string args) {
        int count = ArgCount(args);
        if (count == 1) { return ParseColor(ArgAt(args, 0)); }
        if (count >= 4) {
            int red = ParseInt(ArgAt(args, 0));
            int green = ParseInt(ArgAt(args, 1));
            int blue = ParseInt(ArgAt(args, 2));
            int alpha = ParseInt(ArgAt(args, 3));
            return (alpha << 24) | (red << 16) | (green << 8) | blue;
        }
        return 0;
    }

    // 当前位置是否以 token 开头（不消费）。
    bool Starts(string token) {
        return RichTextParser.StartsAt(
            this.input, this.position, token);
    }

    // 读取当前位置起 prefixLength 个字符之后的括号体并消费到
    // ')' 之后；找不到闭括号返回 null 且不消费。
    string Parenthesized(int prefixLength) {
        int close = FindIn(this.input, ")", this.position + prefixLength);
        if (close < 0) { return null; }
        string newValue = this.input.Substring(
            this.position + prefixLength,
            close - this.position - prefixLength);
        this.position = close + 1;
        return newValue;
    }

    // 追加一个文本 run（空串忽略），携带当前样式与链接。
    void AddText(string text) {
        if (text == "") { return; }
        RichTextRun run = new RichTextRun(
            RichTextRunKind.Text(), this.style, this.link);
        run.SetText(text);
        this.document.Add(run);
    }

    // 追加一个指定类型的 run，携带当前样式与链接。
    void AddSimple(int kind) {
        this.document.Add(new RichTextRun(kind, this.style, this.link));
    }

    // 以给定链接嵌套解析 text（样式为当前样式的副本），把结果
    // run 依次并入本文档；用于 #@标记@内容@ 的内容部分。
    void AddNested(string text, RichTextLink nestedLink) {
        RichTextParser parser = new RichTextParser(
            text, this.style.Clone(), nestedLink);
        RichTextDocument nested = parser.Parse();
        for (int i = 0; i < nested.RunCount(); i = i + 1) {
            this.document.Add(nested.RunAt(i));
        }
    }

    // 尝试解析当前位置的颜色快捷标记（#W #R #Y #B #G #H #L）；
    // 命中则设置样式颜色并消费 2 字符返回 true。
    bool ParseColorShortcut() {
        if (this.position + 2 > this.input.Length) { return false; }
        string tag = this.input.Substring(this.position, 2);
        bool found = false;
        int color = 0;
        if (tag == "#W") { color = (int)0xFFFFFFFF; found = true; }
        if (tag == "#R") { color = (int)0xFFFF0000; found = true; }
        if (tag == "#Y") { color = (int)0xFFFFFF00; found = true; }
        if (tag == "#B") { color = (int)0xFF0000FF; found = true; }
        if (tag == "#G") { color = (int)0xFF00FF00; found = true; }
        if (tag == "#H") { color = (int)0xFF808080; found = true; }
        if (tag == "#L") { color = (int)0xFF60C0FF; found = true; }
        if (!found) { return false; }
        this.style.SetColor(color);
        this.position = this.position + 2;
        return true;
    }

    // 尝试解析当前位置的任一标签并消费输入；命中返回 true，
    // 未命中返回 false（调用方把 '#' 按普通文本处理）。
    bool ParseTag() {
        bool parsed = false;
        if (this.ParseColorShortcut()) {
            parsed = true;
        } else if (this.Starts("#c(")) {
            string body = this.Parenthesized(3);
            if (body != null) {
                this.style.SetColor(ParseColorArgs(body));
                parsed = true;
            }
        } else if (this.Starts("#bg(")) {
            string body = this.Parenthesized(4);
            if (body != null) {
                this.style.SetBackground(ParseColorArgs(body));
                parsed = true;
            }
        } else if (this.Starts("#f(")) {
            string body = this.Parenthesized(3);
            if (body != null) {
                this.style.SetFont(body);
                parsed = true;
            }
        } else if (this.Starts("#p(")) {
            string body = this.Parenthesized(3);
            if (body != null) {
                RichTextRun run = new RichTextRun(
                    RichTextRunKind.Image(), this.style, this.link);
                int count = ArgCount(body);
                if (count > 0) { run.SetResource(ArgAt(body, 0)); }
                int x = 0;
                int y = 0;
                int width = 0;
                int height = 0;
                if (count > 1) { x = ParseInt(ArgAt(body, 1)); }
                if (count > 2) { y = ParseInt(ArgAt(body, 2)); }
                if (count > 3) { width = ParseInt(ArgAt(body, 3)); }
                if (count > 4) { height = ParseInt(ArgAt(body, 4)); }
                run.SetOffset(x, y);
                run.SetSize(width, height);
                this.document.Add(run);
                parsed = true;
            }
        } else if (this.Starts("#a(")) {
            string body = this.Parenthesized(3);
            if (body != null) {
                RichTextRun run = new RichTextRun(
                    RichTextRunKind.Animation(), this.style, this.link);
                int count = ArgCount(body);
                if (count > 0) { run.SetResource(ArgAt(body, 0)); }
                if (count > 1) { run.SetAction(ArgAt(body, 1)); }
                if (count > 2) {
                    run.SetScale(Encoding.ParseDouble(ArgAt(body, 2)));
                }
                int width = 0;
                int height = 0;
                int x = 0;
                int y = 0;
                if (count > 3) { width = ParseInt(ArgAt(body, 3)); }
                if (count > 4) { height = ParseInt(ArgAt(body, 4)); }
                if (count > 5) { x = ParseInt(ArgAt(body, 5)); }
                if (count > 6) { y = ParseInt(ArgAt(body, 6)); }
                run.SetSize(width, height);
                run.SetOffset(x, y);
                this.document.Add(run);
                parsed = true;
            }
        } else if (this.Starts("#z(")) {
            string body = this.Parenthesized(3);
            if (body != null) {
                RichTextRun run = new RichTextRun(
                    RichTextRunKind.Spacer(), this.style, this.link);
                int count = ArgCount(body);
                int width = 0;
                int height = 0;
                if (count > 0) { width = ParseInt(ArgAt(body, 0)); }
                if (count > 1) { height = ParseInt(ArgAt(body, 1)); }
                run.SetSize(width, height);
                this.document.Add(run);
                parsed = true;
            }
        } else if (this.Starts("#item(")) {
            string body = this.Parenthesized(6);
            if (body != null) {
                RichTextRun run = new RichTextRun(
                    RichTextRunKind.Item(), this.style, this.link);
                int count = ArgCount(body);
                if (count > 0) { run.SetResource(ArgAt(body, 0)); }
                if (count > 1) {
                    run.SetQuantity(ParseInt(ArgAt(body, 1)));
                }
                this.document.Add(run);
                parsed = true;
            }
        } else if (this.Starts("#br(")) {
            string body = this.Parenthesized(4);
            if (body != null) {
                RichTextRun run = new RichTextRun(
                    RichTextRunKind.WrapWidth(), this.style, this.link);
                run.SetSize(ParseInt(body), 0);
                this.document.Add(run);
                parsed = true;
            }
        } else if (this.Starts("#md(") || this.Starts("#rt(")) {
            bool centered = this.Starts("#md(");
            string body = this.Parenthesized(4);
            if (body != null) {
                if (centered) {
                    this.style.SetAlignment(1);
                } else {
                    this.style.SetAlignment(2);
                }
                if (body != "") {
                    RichTextRun run = new RichTextRun(
                        RichTextRunKind.WrapWidth(),
                        this.style,
                        this.link);
                    run.SetSize(ParseInt(body), 0);
                    this.document.Add(run);
                }
                parsed = true;
            }
        } else if (this.Starts("#md")) {
            this.style.SetAlignment(1);
            this.position = this.position + 3;
            parsed = true;
        } else if (this.Starts("#rt")) {
            this.style.SetAlignment(2);
            this.position = this.position + 3;
            parsed = true;
        } else if (this.Starts("#lf")) {
            this.style.SetAlignment(0);
            this.position = this.position + 3;
            parsed = true;
        } else if (this.Starts("#@")) {
            int markerEnd = FindIn(this.input, "@", this.position + 2);
            if (markerEnd >= 0) {
                int contentEnd = FindIn(this.input, "@", markerEnd + 1);
                if (contentEnd >= 0) {
                    string marker = this.input.Substring(
                        this.position + 2,
                        markerEnd - this.position - 2);
                    string content = this.input.Substring(
                        markerEnd + 1, contentEnd - markerEnd - 1);
                    this.position = contentEnd + 1;
                    this.AddNested(content, new RichTextLink(marker));
                    parsed = true;
                }
            }
        }
        return parsed;
    }

    // 解析全部输入并返回文档：\n 产生 LineBreak，'#' 触发标签
    // 解析（未识别时按普通文本保留，## 转义为字面 '#'），
    // 其余字符累积为文本 run。
    RichTextDocument Parse() {
        StringBuilder text = new StringBuilder();
        while (this.position < this.input.Length) {
            string ch = this.input.Substring(this.position, 1);
            if (ch == "\n") {
                this.AddText(text.ToString());
                text = new StringBuilder();
                this.AddSimple(RichTextRunKind.LineBreak());
                this.position = this.position + 1;
            } else if (ch == "#") {
                if (this.Starts("##")) {
                    text.Append("#");
                    this.position = this.position + 2;
                    continue;
                }
                this.AddText(text.ToString());
                text = new StringBuilder();
                if (!this.ParseTag()) {
                    text.Append("#");
                    this.position = this.position + 1;
                }
            } else {
                text.Append(ch);
                this.position = this.position + 1;
            }
        }
        this.AddText(text.ToString());
        return this.document;
    }
}
