using System;

namespace Gui;

/// <summary>
/// 文本编辑控件（Input、CodeEditor、
/// 过滤器输入框）共用的纯字符串小工具。放在这里意味着每个控件无需重复实现
/// 字符解码和编辑原语。
/// 字符串是 UTF-8 字节数组，下文所有索引均为字节偏移。字符
/// 辅助函数让这些偏移始终位于 UTF-8 序列边界，使多
/// 字节字符（CJK、带变音拉丁字母、emoji）能被整体
/// 插入、删除和导航，而不是按原始字节处理。
/// </summary>
class Text {
    /// 单个字节值（0..255）转为单字节字符串。通过字节缓冲区
    /// 写入，而不是 sprintf("%c")：sprintf 是变参函数，而变参
    /// 参数在 Darwin arm64 上遵循不同的 ABI（栈上传递，而非
    /// 寄存器），因此那里的字节会变成垃圾值。
    static string ByteChar(int b) {
        byte[] buf = new byte[2];
        buf[0] = (byte)(b & 255);
        return buf.ToStr(0, 1);
    }

    /// 将 Unicode 码点编码为 UTF-8 字符串。控制
    /// 码、DEL、孤立代理项和越界值返回“”，以便调用方忽略
    /// 非文本输入（运行时以码点形式交付键入的字符）。
    static string CharStr(int code) {
        if (code < 32) { return ""; }
        if (code == 127) { return ""; }
        if (code >= 55296 && code <= 57343) { return ""; }
        if (code > 1114111) { return ""; }
        if (code < 127) {
            string tbl = " !\"#$%&'()*+,-./0123456789:;<=>?@ABCDEFGHIJKLMNOPQRSTUVWXYZ[\\]^_`abcdefghijklmnopqrstuvwxyz{|}~";
            return tbl.Substring(code - 32, 1);
        }
        if (code < 2048) {
            return ByteChar(192 + code / 64) + ByteChar(128 + code % 64);
        }
        if (code < 65536) {
            return ByteChar(224 + code / 4096)
                 + ByteChar(128 + (code / 64) % 64)
                 + ByteChar(128 + code % 64);
        }
        return ByteChar(240 + code / 262144)
             + ByteChar(128 + (code / 4096) % 64)
             + ByteChar(128 + (code / 64) % 64)
             + ByteChar(128 + code % 64);
    }

    /// `code` 为可打印字符（任何非控制码点）时为 true。
    static bool IsPrintable(int code) {
        if (code < 32) { return false; }
        if (code == 127) { return false; }
        return true;
    }

    /// 以 `b` 为引导字节的 UTF-8 序列的字节数。
    static int SeqLen(int b) {
        if (b < 128) { return 1; }
        if (b < 224) { return 2; }
        if (b < 240) { return 3; }
        return 4;
    }

    /// 恰好在 `pos` 之前结束的字符的起始字节索引（向后扫描
    /// UTF-8 连续字节）。限制到 0。
    static int PrevCharStart(string s, int pos) {
        if (pos <= 0) { return 0; }
        int i = pos - 1;
        while (i > 0) {
            int b = s[i];
            if (b >= 128 && b < 192) { i = i - 1; }
            else { return i; }
        }
        return 0;
    }

    /// 从 `pos` 开始的字符之后的第一个字节索引。限制到字符串长度。
    static int NextCharEnd(string s, int pos) {
        int len = s.Length;
        if (pos >= len) { return len; }
        int end = pos + Text.SeqLen(s[pos]);
        if (end > len) { return len; }
        return end;
    }

    /// 将字节偏移回退到它所在的 UTF-8 字符
    /// 的起点，因此按结果切片永远不会切开多字节字符
    /// （被切开的字符会渲染为替换字形）。已在
    /// 边界上的偏移原样返回。
    static int ClampCharStart(string s, int pos) {
        if (pos <= 0) { return 0; }
        int len = s.Length;
        if (pos >= len) { return len; }
        int b = s[pos];
        if (b < 128 || b >= 192) { return pos; }
        return Text.PrevCharStart(s, pos);
    }

    /// 移除 `s` 的最后一个字符（空字符串保持为空）。
    static string DropLast(string s) {
        if (s.Length <= 1) { return ""; }
        return Text.Left(s, Text.PrevCharStart(s, s.Length));
    }

    /// `s` 的左切片 [0, pos)，限制到有效边界。
    static string Left(string s, int pos) {
        if (pos <= 0) { return ""; }
        if (pos >= s.Length) { return s; }
        return s.Substring(0, pos);
    }

    /// `s` 的右切片 [pos, len)，限制到有效边界。
    static string Right(string s, int pos) {
        if (pos <= 0) { return s; }
        if (pos >= s.Length) { return ""; }
        return s.Substring(pos, s.Length - pos);
    }

    /// 在字节索引 `pos`（0..len）处将 `ins` 插入 `s`。
    static string InsertAt(string s, int pos, string ins) {
        return Text.Left(s, pos) + ins + Text.Right(s, pos);
    }

    /// 移除从字节索引 `pos` 开始的整个字符（越界时
    /// 无操作）。
    static string RemoveAt(string s, int pos) {
        if (pos < 0) { return s; }
        if (pos >= s.Length) { return s; }
        return Text.Left(s, pos) + Text.Right(s, Text.NextCharEnd(s, pos));
    }

    /// 移除恰好在字节索引 `pos` 之前结束的整个字符（退格键）。
    static string DeleteBefore(string s, int pos) {
        if (pos <= 0) { return s; }
        return Text.Left(s, Text.PrevCharStart(s, pos)) + Text.Right(s, pos);
    }

    /// `s` 里的码点个数（一个 CJK 字 / 一个基础 emoji 记 1，与字节数
    /// 无关）。字符上限与字数统计都按这个口径。
    static int Chars(string s) {
        int n = 0;
        int i = 0;
        while (i < s.Length) { i = Text.NextCharEnd(s, i); n = n + 1; }
        return n;
    }

    /// `pos` 处码点的数值（越界返回 -1）。按 UTF-8 前导字节还原：
    /// n 字节序列取前导字节低 7-n 位，续字节各取低 6 位。
    static int CpAt(string s, int pos) {
        int len = s.Length;
        if (pos < 0 || pos >= len) { return -1; }
        int b = s[pos];
        int n = Text.SeqLen(b);
        if (n == 1) { return b; }
        int mask = 0xFF >> (n + 1);
        int cp = b & mask;
        int k = 1;
        while (k < n) { cp = cp * 64 + (s[pos + k] & 63); k = k + 1; }
        return cp;
    }

    /// 码点是否属于"并入前一簇"的扩展集（简化规则，覆盖 emoji 与
    /// 带音拉丁字母的常见情形）：Mn 组合段、符号组合段、变体选择符、
    /// 半标记、组合键帽、肤色修饰符、emoji tag、韩文字母尾音段。
    static bool IsExtend(int cp) {
        if (cp >= 0x0300 && cp <= 0x036F) { return true; }
        if (cp >= 0x20D0 && cp <= 0x20FF) { return true; }
        if (cp >= 0xFE00 && cp <= 0xFE0F) { return true; }
        if (cp >= 0xFE20 && cp <= 0xFE2F) { return true; }
        if (cp == 0x20E3) { return true; }
        if (cp >= 0x1F3FB && cp <= 0x1F3FF) { return true; }
        if (cp >= 0xE0020 && cp <= 0xE007F) { return true; }
        if (cp >= 0x1160 && cp <= 0x11FF) { return true; }
        if (cp >= 0xD7B0 && cp <= 0xD7FF) { return true; }
        return false;
    }

    /// `s` 里的字素簇个数（Naive UI `count-graphemes` 的口径）。在码点
    /// 计数上合并扩展簇：区域指示符成对（🇨🇳=1）、零宽连接符把后一个
    /// 码点并入同簇（👨‍👩‍👧=1）、其余组合标记/变体/肤色/tag
    /// 并入当前簇（💐️=1、🥷🏿=1）。
    static int Graphemes(string s) {
        int n = 0;
        int len = s.Length;
        int i = 0;
        while (i < len) {
            int cp = Text.CpAt(s, i);
            int p = Text.NextCharEnd(s, i);
            // 区域指示符：恰好吞掉紧随的第二个。
            if (cp >= 0x1F1E6 && cp <= 0x1F1FF && p < len) {
                int cp2 = Text.CpAt(s, p);
                if (cp2 >= 0x1F1E6 && cp2 <= 0x1F1FF) {
                    p = Text.NextCharEnd(s, p);
                }
            }
            // 吞掉扩展段：组合标记直接并；ZWJ 再把后一个码点并进来。
            while (p < len) {
                int q = Text.CpAt(s, p);
                if (q == 0x200D) {
                    p = Text.NextCharEnd(s, p);
                    if (p < len) { p = Text.NextCharEnd(s, p); }
                    continue;
                }
                if (Text.IsExtend(q)) { p = Text.NextCharEnd(s, p); continue; }
                break;
            }
            i = p;
            n = n + 1;
        }
        return n;
    }
}

/// <summary>换行展示行实体（消除 lines / starts 平行列表反模式）。</summary>
class WrappedLine {
    public string text;
    public int start;

    public WrappedLine(string text, int start) {
        this.text = text;
        this.start = start;
    }
}

/// 换行结果：以结构化 WrappedLine 实体列表管理每一行及其起始偏移。
/// lines / starts 保留兼容调用。
/// 偏移不是可有可无的：鼠标落点要先换算成「第几行第几列」再折回原文的
/// 字节位置，选中高亮又要反着算回每行的像素区间。只留行文本的话，这条
/// 展示行 ↔ 原文的映射每个调用方都得自己再扫一遍，硬换行被吃掉的那一
/// 个字节还会各算各的（选中文本多一个/少一个换行）。
class WrappedText {
    List<WrappedLine> items;
    List<string> lines;
    List<int> starts;

    WrappedText() {
        this.items = new List<WrappedLine>();
        this.lines = new List<string>();
        this.starts = new List<int>();
    }

    void Add(string line, int start) {
        this.items.Add(new WrappedLine(line, start));
        this.lines.Add(line);
        this.starts.Add(start);
    }
}

/// 位于 `Text` 类之外的文本辅助函数，这样声明了同名
/// `Text` 成员（Label）的控件仍能调用它们，而不被成员遮蔽
/// 类名。对字符串的纯函数，外加基于像素的换行。
class TextWrap {
    /// 去除首尾的 ASCII 空白（空格、制表符、CR、LF）。
    static string Trim(string s) {
        int len = s.Length;
        int a = 0;
        for (; a < len; a = a + 1) {
            int b = s[a];
            if (b != 32 && b != 9 && b != 13 && b != 10) { break; }
        }
        int z = len;
        while (z > a) {
            int b = s[z - 1];
            if (b != 32 && b != 9 && b != 13 && b != 10) { break; }
            z = z - 1;
        }
        if (a == 0 && z == len) { return s; }
        return s.Substring(a, z - a);
    }

    /// 换行并记录每行在原文里的起始字节偏移（`Lines` 的带账版本）。
    /// 换行规则与 `Lines` 逐字一致（调用方按行绘制时两者结果必须同一
    /// 份）；差别只在这里把每行的起点也留下来。硬换行（字节 10）不计
    /// 入行文本，因此下一行的起点要跳过它——偏移口径与 `Lines` 拼回
    /// 原文时丢掉的正是那一个换行符，两处一致才对得上。
    static WrappedText LinesAt(string s, int maxW, int fs) {
        // `out` 是语言关键字（out 参数），局部变量不能叫它。
        WrappedText acc = new WrappedText();
        if (maxW <= 0) { maxW = 1; }
        int len = s.Length;
        int i = 0;
        while (i < len) {
            if (s[i] == 10) {
                acc.Add("", i);
                i = i + 1;
                continue;
            }
            int w = 0;
            int k = i;
            int lastSpace = -1;
            int end = i;
            while (k < len && s[k] != 10) {
                int kk = Text.NextCharEnd(s, k);
                int cw = Canvas.MeasureText(s.Substring(k, kk - k), fs);
                if (w + cw > maxW && end > i) { break; }
                w = w + cw;
                end = kk;
                if (s[k] == 32) { lastSpace = kk; }
                k = kk;
            }
            int take = end;
            if (k < len && s[k] != 10 && lastSpace > i) { take = lastSpace; }
            if (take <= i) { take = Text.NextCharEnd(s, i); }
            acc.Add(s.Substring(i, take - i), i);
            i = take;
            if (i < len && s[i] == 10) { i = i + 1; }
        }
        if (acc.lines.Count == 0) {
            acc.Add("", 0);
            return acc;
        }
        return acc;
    }

    /// 将 `s` 拆成行，每行在 `fs` 磅下都能放进 `maxW` 像素，
    /// 尽可能在空格处换行，否则在任意字符处换行（因此无空格的 CJK
    /// 文本也能换行）。硬换行（字节 10）始终断行。
    /// 至少返回一行；结尾换行不会增加空行。
    static List<string> Lines(string s, int maxW, int fs) {
        List<string> lines = new List<string>();
        if (maxW <= 0) { maxW = 1; }
        int len = s.Length;
        int i = 0;
        while (i < len) {
            if (s[i] == 10) { lines.Add(""); i = i + 1; continue; }
            int w = 0;
            int k = i;
            int lastSpace = -1;
            int end = i;
            while (k < len && s[k] != 10) {
                int kk = Text.NextCharEnd(s, k);
                int cw = Canvas.MeasureText(s.Substring(k, kk - k), fs);
                if (w + cw > maxW && end > i) { break; }
                w = w + cw;
                end = kk;
                if (s[k] == 32) { lastSpace = kk; }
                k = kk;
            }
            int take = end;
            // 超宽但行内更早有空格断点时：回退到那里，
            // 让完整单词保持在一起（跳过前导空格）。
            if (k < len && s[k] != 10 && lastSpace > i) { take = lastSpace; }
            if (take <= i) { take = Text.NextCharEnd(s, i); }
            lines.Add(s.Substring(i, take - i));
            i = take;
            if (i < len && s[i] == 10) { i = i + 1; }
        }
        if (lines.Count == 0) { lines.Add(""); }
        return lines;
    }

    /// 按 '\n' 把字符串拆分为行（去除 '\r'）。至少返回一行。
    static List<string> SplitLines(string s) {
        return s.Replace("\r", "").Split("\n");
    }

    /// 把像素 x 偏移（相对文本原点）映射为列索引：
    /// 即测量前缀宽度达到 `px` 的第一个字符边界。
    /// 前缀宽度随边界单调递增，因此对边界二分查找只需
    /// O(log n) 次 MeasureText 调用，而非每字符一次。
    /// 这两个原语住在这里而不是 CodeEditor：Input/TextArea
    /// 的鼠标定位只依赖文本布局，不必拖入整个代码编辑器。
    static int ColFromX(string s, int px, int fontSize) {
        if (px <= 0) { return 0; }
        List<int> ends = new List<int>();
        int p = Text.NextCharEnd(s, 0);
        while (p <= s.Length) {
            ends.Add(p);
            if (p >= s.Length) { break; }
            p = Text.NextCharEnd(s, p);
        }
        int lo = 0;
        int hi = ends.Count - 1;
        int ansIdx = -1;
        while (lo <= hi) {
            int mid = (lo + hi) / 2;
            int w = Canvas.MeasureText(Text.Left(s, ends[mid]), fontSize);
            if (w >= px) { ansIdx = mid; hi = mid - 1; }
            else { lo = mid + 1; }
        }
        if (ansIdx < 0) { return s.Length; }
        return ends[ansIdx];
    }
}
