using System;

namespace Gui;

// 字符串版内部状态缓冲：可变值 + 单调递增版本号，
// 渲染帧轮询 Version() 检测变化（契约同 SignalInt）。
public class SignalString {
    string val;
    int version;

    SignalString(string initial) {
        this.val = initial;
        this.version = 0;
    }

    // 当前值。
    string Get() { return val; }

    // 写入。版本号无条件 +1，轮询方一律以版本号变化为准。
    void Set(string v) {
        val = v;
        version = version + 1;
    }

    // 写入次数，用于帧轮询检测变化。
    int Version() { return version; }
}

