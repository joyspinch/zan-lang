using System;
using System.Collections.Generic;

namespace Gui;

// 反序列化时根据 Kind() 标签重建 Control，并为
// 设计器的组件面板提供数据。统一由 ControlFactory 维护注册表。
public class ControlFactory {
    private static Dict<string, ControlFactoryFn> registry;
    private static List<string> registeredKinds;

    public static void Register(string kind, ControlFactoryFn fn) {
        if (registry == null) {
            registry = new Dict<string, ControlFactoryFn>();
            registeredKinds = new List<string>();
        }
        if (!registry.ContainsKey(kind)) {
            registeredKinds.Add(kind);
        }
        registry[kind] = fn;
    }

    public static bool Has(string kind) {
        if (registry == null) { return false; }
        return registry.ContainsKey(kind);
    }

    public static List<string> Kinds() {
        if (registeredKinds == null) {
            return new List<string>();
        }
        return registeredKinds;
    }

    public static Control Create(string kind) {
        if (registry == null || !registry.ContainsKey(kind)) {
            return null;
        }
        ControlFactoryFn fn = registry[kind];
        return fn != null ? fn(kind) : null;
    }
}
