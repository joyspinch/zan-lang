using System;
using System.Collections.Generic;

namespace Gui;

// Parsed tracks and placement are independent of child identity and geometry.
// Compare the exact text and the six placement inputs in CURRENT order before
// reuse; neither public StyleBox mutation nor naked children mutation has a
// trustworthy invalidation generation. No control references survive Prepare.
internal class GridLayoutPlan {
    public List<GridTrack> colDefs;
    public List<GridTrack> rowDefs;
    public List<GridTrack> autoCols;
    public List<GridTrack> autoRows;
    public GridPlace placement;
    public int parses;
    public int placements;
    private string cols = "";
    private string rows = "";
    private string implicitCols = "";
    private string implicitRows = "";
    private List<int> placementKeys = new List<int>();
    // 轨道里的 px 是逻辑像素，与其它长度（StyleBox.ResolveLength）一样按 DPI 换成设备
    // 像素；换算比例是缓存键的一部分——运行期换 DPI（拖到别的显示器）要重新解析。
    private int trackDpi = 0;

    private static int PlacementKey(StyleBox sb, int field) {
        if (sb == null) { return 0; }
        if (field == 0) { return sb.gColStart; }
        if (field == 1) { return sb.gColEnd; }
        if (field == 2) { return sb.gColSpan; }
        if (field == 3) { return sb.gRowStart; }
        if (field == 4) { return sb.gRowEnd; }
        return sb.gRowSpan;
    }

    private bool SameKeys(List<Control> items) {
        if (placementKeys.Count != items.Count * 6) { return false; }
        for (int i = 0; i < items.Count; i = i + 1) {
            for (int field = 0; field < 6; field = field + 1) {
                if (placementKeys[i * 6 + field] != GridLayoutPlan.PlacementKey(items[i].computedStyle, field)) {
                    return false;
                }
            }
        }
        return true;
    }

    private static List<GridTrack> Parse(string v, int dpi) {
        List<GridTrack> tracks = CssGrid.ParseTracks(v);
        if (dpi == 100) { return tracks; }
        for (int i = 0; i < tracks.Count; i = i + 1) {
            GridTrack t = tracks[i];
            if (t.kind == 0) { t.val = t.val * dpi / 100; }
            if (t.kind == 4) {
                if (t.minKind == 0) { t.minVal = t.minVal * dpi / 100; }
                if (t.maxKind == 0) { t.maxVal = t.maxVal * dpi / 100; }
            }
        }
        return tracks;
    }

    public void Prepare(StyleBox style, List<Control> items) {
        string c = style != null ? style.gridCols : "";
        string r = style != null ? style.gridRows : "";
        string ac = style != null ? style.gridAutoCols : "";
        string ar = style != null ? style.gridAutoRows : "";
        int dpi = style != null && style.envDpiScale > 0 ? style.envDpiScale : 100;
        bool rescale = dpi != trackDpi;
        trackDpi = dpi;
        bool tracksChanged = false;
        if (colDefs == null || cols != c || rescale) {
            colDefs = GridLayoutPlan.Parse(c, dpi); cols = c; tracksChanged = true; parses = parses + 1;
        }
        if (rowDefs == null || rows != r || rescale) {
            rowDefs = GridLayoutPlan.Parse(r, dpi); rows = r; tracksChanged = true; parses = parses + 1;
        }
        if (autoCols == null || implicitCols != ac || rescale) {
            autoCols = GridLayoutPlan.Parse(ac, dpi); implicitCols = ac; parses = parses + 1;
        }
        if (autoRows == null || implicitRows != ar || rescale) {
            autoRows = GridLayoutPlan.Parse(ar, dpi); implicitRows = ar; parses = parses + 1;
        }
        if (placement == null || tracksChanged || !this.SameKeys(items)) {
            List<int> current = new List<int>();
            for (int i = 0; i < items.Count; i = i + 1) {
                for (int field = 0; field < 6; field = field + 1) {
                    current.Add(GridLayoutPlan.PlacementKey(items[i].computedStyle, field));
                }
            }
            placement = CssGrid.Place(items, colDefs.Count, rowDefs.Count);
            placement.items = null;
            placementKeys = current;
            placements = placements + 1;
        }
    }
}
