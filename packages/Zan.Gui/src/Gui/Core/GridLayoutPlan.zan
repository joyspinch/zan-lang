using System;
using System.Collections.Generic;
namespace Gui;
internal class GridLayoutPlan {
    public List<GridTrack> colDefs;
    public List<GridTrack> rowDefs;
    public List<GridTrack> autoCols;
    public List<GridTrack> autoRows;
    public GridPlace placement;
    public int parses;
    public int placements;
    private string cols = "";
    private string rows = "";
    private string implicitCols = "";
    private string implicitRows = "";
    private int lastColAvail = 0 - 2;
    private int lastColGap = 0 - 1;
    private int lastAutoFitItems = 0 - 1;
    private bool colsAutoRepeat = false;
    private bool colsAutoFit = false;
    private List<int> placementKeys = new List<int>();
    // 轨道里的 px 是逻辑像素，与其它长度（StyleBox.ResolveLength）一样按 DPI 换成设备
    // 像素；换算比例是缓存键的一部分——运行期换 DPI（拖到别的显示器）要重新解析。
    private int trackDpi = 0;
    private static int PlacementKey(StyleBox sb, int field) {
        if (sb == null) { return 0; }
        if (field == 0) { return sb.gColStart; }
        if (field == 1) { return sb.gColEnd; }
        if (field == 2) { return sb.gColSpan; }
        if (field == 3) { return sb.gRowStart; }
        if (field == 4) { return sb.gRowEnd; }
        return sb.gRowSpan;
    }
    private bool SameKeys(List<Control> items) {
        int count = items != null ? items.Count : 0;
        if (placementKeys.Count != count * 6) { return false; }
        int baseIdx = 0;
        for (int i = 0; i < count; i = i + 1) {
            Control item = items[i];
            StyleBox sb = item != null ? item.computedStyle : null;
            if (sb == null) {
                if (placementKeys[baseIdx] != 0 || placementKeys[baseIdx + 1] != 0
                    || placementKeys[baseIdx + 2] != 0 || placementKeys[baseIdx + 3] != 0
                    || placementKeys[baseIdx + 4] != 0 || placementKeys[baseIdx + 5] != 0) {
                    return false;
                }
            } else {
                if (placementKeys[baseIdx] != sb.gColStart
                    || placementKeys[baseIdx + 1] != sb.gColEnd
                    || placementKeys[baseIdx + 2] != sb.gColSpan
                    || placementKeys[baseIdx + 3] != sb.gRowStart
                    || placementKeys[baseIdx + 4] != sb.gRowEnd
                    || placementKeys[baseIdx + 5] != sb.gRowSpan) {
                    return false;
                }
            }
            baseIdx = baseIdx + 6;
        }
        return true;
    }
    private static List<GridTrack> ScaleTracks(List<GridTrack> tracks, int dpi) {
        if (dpi == 100 || tracks == null) { return tracks; }
        List<GridTrack> scaled = new List<GridTrack>();
        for (int i = 0; i < tracks.Count; i = i + 1) {
            GridTrack src = tracks[i];
            GridTrack t = new GridTrack();
            t.kind = src.kind;
            t.val = src.kind == 0 ? src.val * dpi / 100 : src.val;
            t.minKind = src.minKind;
            t.minVal = (src.kind == 4 && src.minKind == 0) ? src.minVal * dpi / 100 : src.minVal;
            t.maxKind = src.maxKind;
            t.maxVal = (src.kind == 4 && src.maxKind == 0) ? src.maxVal * dpi / 100 : src.maxVal;
            scaled.Add(t);
        }
        return scaled;
    }

    private static List<GridTrack> Parse(string v, int dpi) {
        return GridLayoutPlan.ScaleTracks(CssGrid.ParseTracks(v), dpi);
    }
    public void Prepare(StyleBox style, List<Control> items) {
        this.Prepare(style, items, 0 - 1, 0);
    }
    public void Prepare(StyleBox style, List<Control> items, int colAvail, int colGap) {
        string c = style != null ? style.gridCols : "";
        string r = style != null ? style.gridRows : "";
        string ac = style != null ? style.gridAutoCols : "";
        string ar = style != null ? style.gridAutoRows : "";
        int dpi = style != null && style.envDpiScale > 0 ? style.envDpiScale : 100;
        bool rescale = dpi != trackDpi;
        trackDpi = dpi;
        bool colsTextChanged = colDefs == null || cols != c;
        if (colsTextChanged) {
            colsAutoRepeat = CssGrid.HasAutoRepeat(c);
            colsAutoFit = colsAutoRepeat && CssGrid.HasAutoFit(c);
        }
        int itemCount = items != null ? items.Count : 0;
        bool tracksChanged = false;
        if (colsTextChanged || rescale
            || (colsAutoRepeat && (lastColAvail != colAvail || lastColGap != colGap))
            || (colsAutoFit && lastAutoFitItems != itemCount)) {
            if (colsAutoRepeat) {
                int logicalAvail = (dpi != 100 && colAvail > 0) ? colAvail * 100 / dpi : colAvail;
                int logicalGap = (dpi != 100 && colGap > 0) ? colGap * 100 / dpi : colGap;
                colDefs = GridLayoutPlan.ScaleTracks(
                    CssGrid.ParseTracksForWidth(c, logicalAvail, logicalGap), dpi);
            } else {
                colDefs = GridLayoutPlan.Parse(c, dpi);
            }
            if (colsAutoFit && itemCount > 0 && colDefs.Count > itemCount) {
                while (colDefs.Count > itemCount) { colDefs.RemoveAt(colDefs.Count - 1); }
            }
            cols = c;
            lastColAvail = colAvail;
            lastColGap = colGap;
            lastAutoFitItems = itemCount;
            tracksChanged = true;
            parses = parses + 1;
        }
        if (rowDefs == null || rows != r || rescale) {
            rowDefs = GridLayoutPlan.Parse(r, dpi); rows = r; tracksChanged = true; parses = parses + 1;
        }
        if (autoCols == null || implicitCols != ac || rescale) {
            autoCols = GridLayoutPlan.Parse(ac, dpi); implicitCols = ac; parses = parses + 1;
        }
        if (autoRows == null || implicitRows != ar || rescale) {
            autoRows = GridLayoutPlan.Parse(ar, dpi); implicitRows = ar; parses = parses + 1;
        }
        if (placement == null || tracksChanged || !this.SameKeys(items)) {
            List<int> current = new List<int>();
            List<StyleBox> itemStyles = new List<StyleBox>();
            if (items != null) {
                for (int i = 0; i < items.Count; i = i + 1) {
                    StyleBox itemStyle = items[i] != null ? items[i].computedStyle : null;
                    itemStyles.Add(itemStyle);
                    for (int field = 0; field < 6; field = field + 1) {
                        current.Add(GridLayoutPlan.PlacementKey(itemStyle, field));
                    }
                }
            }
            placement = CssGrid.Place(itemStyles, colDefs.Count, rowDefs.Count);
            placementKeys = current;
            placements = placements + 1;
        }
    }
}
