using System;
using System.Collections.Generic;

namespace Gui;

public class ControlExtra {
    public string bindPath;
    public string bindProp;
    public string bindIf;
    public string bindClass;
    public string bindDisabled;
    public List<BindPropEntry> bindProps;
    public string bindTpl;
    public string baseClass;
    public string handlerArg;
    public string slotName;
    public bool bindLazy;
    public bool bindNumber;
    public bool bindTrim;
    public List<EventBinding> events;

    public int styleBg;
    public int styleBgTo;
    public int styleRadius;
    public int styleCorners;
    public int styleBorderColor;
    public int styleBorderWidth;
    public int styleShadow;
    public int styleShadowDy;
    public int styleColor;
    public int styleFontPx;
    public int styleTransitionMs;
    public string inlineStyleCss;

    public UiEvent Paint;
    public UiEvent Resize;
    public UiEvent Show;
    public UiEvent Hide;

    public int flexWrapMain;
    public int flexMeasMain;
    public int hintWrapW;
    public List<FloatIntrusion> hostFloats;
    public bool designFloat;
    public int designAnchor;
    public bool layoutFlow;
    public string designCss;

    public string a11yRole;
    public string a11yLabel;

    public ControlExtra() {
        this.bindPath = "";
        this.bindProp = "";
        this.bindIf = "";
        this.bindClass = "";
        this.bindDisabled = "";
        this.bindTpl = "";
        this.baseClass = "";
        this.handlerArg = "";
        this.slotName = "";
        this.inlineStyleCss = "";
        this.designCss = "";
        this.a11yRole = "";
        this.a11yLabel = "";
    }
}
