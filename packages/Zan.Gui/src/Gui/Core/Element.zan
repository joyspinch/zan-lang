using System;
using System.Collections.Generic;
using Gui;
using Gui.Backend;
namespace Gui;
public class Element : Control {
    string elTag;
    string elText;
    List<ElementRun> elRuns;
    bool elRunsFresh;  // 本帧行盒是否落位过（防陈旧 run 重画）
    List<FlowEntry> elOrder;  // 文档序（AddText/AddKid 交错记录）
    Dict<string, string> elAttrs;
    string elBefore;
    string elAfter;
    string elTitle;
    public delegate void TipPaintFn(Control el, string title);
    public static TipPaintFn TipPainter() { return GuiCoreState.Current().tipPainter; }
    public static void SetTipPainter(TipPaintFn fn) { GuiCoreState.Current().tipPainter = fn; }
    void InitElement(string tag, string nodeName) {
        this.InitControl(nodeName);
        elTag = tag;
        elRuns = new List<ElementRun>();
    }
    void SetAttr(string k, string v) {
        string key = Css.Lower(k);
        if (elAttrs == null) { elAttrs = new Dict<string, string>(); }
        if (elAttrs.ContainsKey(key)) { elAttrs.Remove(key); }
        elAttrs.Add(key, v);
        computedStyle = null;
    }
    override string CssAttr(string key) {
        if (elAttrs != null) {
            string v = "";
            if (elAttrs.TryGetValue(Css.Lower(key), out v)) { return v; }
        }
        return base.CssAttr(key);
    }
    override bool CssHasAttr(string key) {
        if (elAttrs != null && elAttrs.ContainsKey(Css.Lower(key))) { return true; }
        if (key == "id") { return name != ""; }
        return false;
    }
    // 文本含内联子段（elOrder 的文本片段按序拼接）。
    public string FullText() {
        string t = this.Text();
        if (elOrder != null) {
            for (int i = 0; i < elOrder.Count; i = i + 1) {
                if (elOrder[i].text != null) { t = t + elOrder[i].text; }
            }
        }
        return t;
    }

    public void SetTitleAttr(string val) {
        elTitle = val;
        this.SetAttr("title", val);
    }

    protected override List<PropSpec> DefineProps() {
        List<PropSpec> ps = new List<PropSpec>();
        ps.Add(PropSpec.Text("text", "Text").DefaultBinding().Accessor("FullText", "SetText"));
        ps.Add(PropSpec.Text("title", "Title").Field("elTitle").Setter("SetTitleAttr").Also("tip"));
        return ps;
    }
    // 从同类元素拷贝原始属性表（Html.Clone 的 template 行展开用：
    // data-for/data-if 等声明随行复制）。src 无表时本元素
    // 保持原状；键已折小写，直接平移。
    void CopyAttrsFrom(Element src) {
        if (src.elTitle != "") { elTitle = src.elTitle; }
        if (src.elAttrs == null) { return; }
        if (elAttrs == null) { elAttrs = new Dict<string, string>(); }
        List<string> ks = src.elAttrs.Keys;
        for (int i = 0; i < ks.Count; i = i + 1) {
            string v = "";
            src.elAttrs.TryGetValue(ks[i], out v);
            elAttrs.Add(ks[i], v);
        }
    }
    override StyleBox ResolveStyle(App app, int state) {
        if (computedStyle != null && computedStyleState == state
            && this.ComputedStyleCurrent(app)) {
            return computedStyle;
        }
        StyleBox sb = base.ResolveStyle(app, state);
        StyleBox pb = Style.Part(app, this.StyleType(), "before", "", Class,
                                 name, state);
        elBefore = Css.PseudoContent(pb == null ? "" : pb.contentRaw, this);
        StyleBox pa = Style.Part(app, this.StyleType(), "after", "", Class,
                                 name, state);
        elAfter = Css.PseudoContent(pa == null ? "" : pa.contentRaw, this);
        return sb;
    }
    override string Kind() { return elTag; }
    protected override string PropertySchemaId() { return "Element"; }
    public string TextContent {
        get { return this.elText; }
        set { this.SetText(value); }
    }
    public void SetText(string t) {
        if (elOrder != null) {
            for (int i = elOrder.Count - 1; i >= 0; i = i - 1) {
                if (elOrder[i].kid == null) { elOrder.RemoveAt(i); }
            }
        }
        elText = t;
    }
    public string Text() { return elText; }
    public void AddText(string t) {
        if (elOrder == null) { elOrder = new List<FlowEntry>(); }
        FlowEntry e = new FlowEntry();
        e.text = t;
        elOrder.Add(e);
    }
    public void AddKid(Control c) {
        this.Add(c);
        if (elOrder == null) { elOrder = new List<FlowEntry>(); }
        FlowEntry e = new FlowEntry();
        e.kid = c;
        elOrder.Add(e);
    }
    public void DropKid(Control c) {
        if (elOrder != null) {
            for (int i = 0; i < elOrder.Count; i = i + 1) {
                if (elOrder[i].kid == c) { elOrder.RemoveAt(i); break; }
            }
        }
        this.Remove(c);
    }
    public void ClearKids() {
        if (elOrder != null) { elOrder.Clear(); }
        this.RemoveAll();
    }
    FlowEntry TextEntry(string t) {
        FlowEntry e = new FlowEntry();
        e.text = t;
        return e;
    }
    override List<FlowEntry> FlowEntries() {
        List<FlowEntry> es = new List<FlowEntry>();
        if (elBefore != "") { es.Add(this.TextEntry(elBefore)); }
        if (elText != "") { es.Add(this.TextEntry(elText)); }
        if (elOrder == null || elOrder.Count == 0) {
            if (this.ChildCount() == 0) {
                if (elAfter != "") { es.Add(this.TextEntry(elAfter)); }
                return es;
            }
            List<Control> kids = this.FlexKids();
            for (int i = 0; i < kids.Count; i = i + 1) {
                FlowEntry e = new FlowEntry();
                e.kid = kids[i];
                es.Add(e);
            }
            if (elAfter != "") { es.Add(this.TextEntry(elAfter)); }
            return es;
        }
        List<Control> tracked = new List<Control>();
        for (int i = 0; i < elOrder.Count; i = i + 1) {
            FlowEntry o = elOrder[i];
            if (o.kid != null) {
                if (!o.kid.StyleVisible() || o.kid.StylePosition() >= 2) { continue; }
                tracked.Add(o.kid);
            }
            es.Add(o);
        }
        List<Control> kids2 = this.FlexKids();
        for (int i = 0; i < kids2.Count; i = i + 1) {
            bool seen = false;
            for (int k = 0; k < tracked.Count; k = k + 1) {
                if (tracked[k] == kids2[i]) { seen = true; break; }
            }
            if (seen) { continue; }
            FlowEntry e = new FlowEntry();
            e.kid = kids2[i];
            es.Add(e);
        }
        if (elAfter != "") { es.Add(this.TextEntry(elAfter)); }
        return es;
    }
    int ElFontSize() {
        StyleBox sb = computedStyle;
        if (sb == null) { return 14; }
        if (sb.fontPx > 0) { return sb.fontPx; }
        return sb.envRemPx > 0 ? sb.envRemPx : 14;
    }
    override string FlowText() {
        if (elText != "") { return elBefore + elText + elAfter; }
        if (elOrder == null || elOrder.Count == 0) {
            if (elBefore != "" || elAfter != "") { return elBefore + elAfter; }
            return "";
        }
        string joined = "";
        for (int i = 0; i < elOrder.Count; i = i + 1) {
            FlowEntry o = elOrder[i];
            if (o.kid != null) { return ""; }
            joined = joined + o.text;
        }
        return elBefore + joined + elAfter;
    }
    override void InlineRunsBegin() {
        elRuns.Clear();
        elRunsFresh = true;
    }
    override void InlineRunPlace(int x, int topY, int w, int h, int drawOff,
                                 int fs, string text) {
        ElementRun r = new ElementRun();
        r.text = text;
        r.x = x;
        r.topY = topY;
        r.w = w;
        r.h = h;
        r.drawOff = drawOff;
        r.fs = fs;
        elRuns.Add(r);
    }
    override void ShiftTree(int dx, int dy) {
        base.ShiftTree(dx, dy);
        if (elRuns != null && (dx != 0 || dy != 0)) {
            for (int i = 0; i < elRuns.Count; i = i + 1) {
                ElementRun r = elRuns[i];
                r.x = r.x + dx;
                r.topY = r.topY + dy;
            }
        }
    }
    override void OnPaint(App app) {
        TipPaintFn tipPainter = Element.TipPainter();
        if (elTitle != "" && tipPainter != null) { tipPainter(this, elTitle); }
        if (elRuns.Count == 0) { return; }
        if (!elRunsFresh) { elRuns.Clear(); return; }
        StyleBox sb = computedStyle;
        if (sb == null) { return; }
        int col = sb.Fade(sb.FgOr(app.theme.textPrimary));
        for (int i = 0; i < elRuns.Count; i = i + 1) {
            ElementRun r = elRuns[i];
            sb.DrawRun(app.canvas, r.x, r.topY + r.drawOff, r.text, col, r.fs);
        }
        elRunsFresh = false;
    }
    // 通用 HTML 元素是开放属性袋：任意属性名原样存取（未声明的键不落样式类）。
    // 这是属性协议里唯一保留的按名重写；具名属性（text/title）走上面的声明。
    override string GetProp(string key) {
        if (elAttrs != null && this.PropOf(key) == null) {
            string v = "";
            if (elAttrs.TryGetValue(Css.Lower(key), out v)) { return v; }
        }
        return base.GetProp(key);
    }
    override void SetProp(string key, string val) {
        if (this.PropOf(key) == null) { this.SetAttr(key, val); }
        base.SetProp(key, val);
    }
}
