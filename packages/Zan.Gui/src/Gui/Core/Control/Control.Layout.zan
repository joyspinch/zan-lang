using System;
using System.Collections.Generic;
using Gui;
namespace Gui;
public partial class Control {
    protected int measureWidth = 0 - 1;
    internal bool measureDependsOnWidth;
    private bool measureIntrinsic;
    protected virtual bool UsesBaseFlowOnly() { return this.Kind() == "Control"; }
    protected virtual bool UsesBaseSyncBinding() { return this.Kind() == "Control"; }
    protected virtual bool IsWidthDependentMeasure() { return false; }
    private bool measuringTree;
    private int measuringPass;
    private weak App measuringApp;
    private List<App> measuringAncestors;
    private int styleValidatedPass;
    private weak App styleValidatedApp;
    private bool syncingBinding;
    private bool PrepareBindings(App app) {
        if (syncingBinding) { return false; }
        if (this.extra == null && this.UsesBaseSyncBinding()) { return true; }
        Control ownerParent = parent;
        Control root = app != null ? app.rootControl : null;
        int generation = app != null ? app.inputRootGeneration : 0;
        long sequence = app != null && app.window != null ? app.window.EventSeq() : 0;
        syncingBinding = true;
        try {
            if (this.extra != null && this.extra.declarativeBindings != null) { this.SyncDeclarativeBindings(); }
            this.SyncBinding();
        }
        finally { syncingBinding = false; }
        return parent == ownerParent && (this.app == app || (this.app == null && this.FindApp() == app))
        && (app == null || (app.rootControl == root && app.inputRootGeneration == generation
        && (app.window == null || app.window.EventSeq() == sequence)));
    }
    private void PrepareMeasureStyle(App app) {
        this.PrepareMeasureStylePass(app, 0, 0, false, 0L, 0);
    }
    private void PrepareMeasureStylePass(App app, int passId, int passRuleSig, bool passAnyMedia, long passMediaHash, int passChainSeq) {
        Control previous = app.styleCtx;
        app.styleCtx = this;
        if (this.app != app) { this.InheritApp(app); }
        if (this.extra == null && this.UsesBaseSyncBinding()) {
            if (!syncingBinding) {
                bool styleOk = computedStyleState == 0 && (passChainSeq != 0 && Style.chainActiveSeq == passChainSeq
                    ? this.ComputedStyleCurrentPass(app, passRuleSig, passAnyMedia, passMediaHash, passChainSeq)
                    : this.ComputedStyleCurrent(app));
                if (!styleOk) {
                    this.ResolveStyle(app, 0);
                }
                if (passId != 0 && computedStyle != null && computedStyleState == 0 && computedStyleApp == app) {
                    styleValidatedPass = passId;
                    styleValidatedApp = app;
                }
            }
            app.styleCtx = previous;
            return;
        }
        try {
            if (!this.PrepareBindings(app)) { return; }
            bool styleOk = computedStyleState == 0 && (passChainSeq != 0 && Style.chainActiveSeq == passChainSeq
                ? this.ComputedStyleCurrentPass(app, passRuleSig, passAnyMedia, passMediaHash, passChainSeq)
                : this.ComputedStyleCurrent(app));
            if (!styleOk) {
                this.ResolveStyle(app, 0);
            }
            if (passId != 0 && computedStyle != null && computedStyleState == 0 && computedStyleApp == app) {
                styleValidatedPass = passId;
                styleValidatedApp = app;
            }
        } finally {
            app.styleCtx = previous;
        }
    }
    public virtual bool SelfManagesOverlayLayout() { return false; }
    void MeasureTree(App app) { this.MeasureTreeEntry(app, -1, false, false); }
    private void MeasureTreeEntry(App app, int available, bool clamp, bool intrinsic) {
        bool ownChainPass = Style.chainPassDepth == 0 || Style.chainApp != app;
        if (ownChainPass) { Style.BeginChainPass(app); }
        app.measurePassSeq = app.measurePassSeq + 1;
        if (app.measurePassSeq == 0) { app.measurePassSeq = 1; }
        int passId = app.measurePassSeq;
        Control root = app.rootControl;
        int generation = app.inputRootGeneration;
        long sequence = app.window != null ? app.window.EventSeq() : 0;
        int passRuleSig = app.CurrentStyleRuleSig();
        bool passAnyMedia = (passRuleSig & 1) != 0;
        long passMediaHash = passAnyMedia ? Style.PassMediaHash(app) : 0L;
        int passChainSeq = Style.chainApp == app ? Style.chainActiveSeq : 0;
        Control prevCtx = app.styleCtx;
        try {
            this.MeasureTreeNode(app, available, clamp, intrinsic, passId, root, generation, sequence,
                passRuleSig, passAnyMedia, passMediaHash, passChainSeq);
        } finally {
            app.measurePassSeq = app.measurePassSeq + 1;
            if (app.measurePassSeq == 0) { app.measurePassSeq = 1; }
            if (ownChainPass) { Style.EndChainPass(); }
            app.styleCtx = prevCtx;
        }
    }
    private void MeasureTreeNode(App app, int available, bool clamp, bool intrinsic,
                                 int passId, Control root, int generation, long sequence,
                                 int passRuleSig, bool passAnyMedia, long passMediaHash, int passChainSeq) {
        if ((measuringPass == passId && measuringApp == app)
            || (measuringTree && (measuringApp == app
                || (measuringAncestors != null && measuringAncestors.Contains(app))))) { return; }
        if (measuringTree || (measuringPass != 0 && measuringApp != app)) {
            this.MeasureTreeSlow(app, available, clamp, intrinsic, passId, root, generation, sequence,
                passRuleSig, passAnyMedia, passMediaHash, passChainSeq);
            return;
        }
        Control prevCtx = app.styleCtx;
        int previousWidth = measureWidth;
        bool prevIntrinsic = measureIntrinsic;
        int prevPass = measuringPass;
        app.styleCtx = this;
        measuringPass = passId;
        measuringApp = app;
        measureIntrinsic = intrinsic;
        this.MeasureTreeInner(app, available, clamp, passId, root, generation, sequence,
            passRuleSig, passAnyMedia, passMediaHash, passChainSeq);
        measureWidth = previousWidth;
        measureIntrinsic = prevIntrinsic;
        measuringPass = prevPass;
        measuringApp = null;
        app.styleCtx = prevCtx;
    }
    private void MeasureTreeSlow(App app, int available, bool clamp, bool intrinsic,
                                 int passId, Control root, int generation, long sequence,
                                 int passRuleSig, bool passAnyMedia, long passMediaHash, int passChainSeq) {
        App previousApp = measuringApp;
        bool previous = measuringTree;
        if (previous) {
            if (measuringAncestors == null) { measuringAncestors = new List<App>(); }
            measuringAncestors.Add(previousApp);
        }
        Control prevCtx = app.styleCtx;
        int previousWidth = measureWidth;
        bool prevIntrinsic = measureIntrinsic;
        int prevPass = measuringPass;
        app.styleCtx = this;
        measuringTree = true;
        measuringPass = passId;
        measuringApp = app;
        measureIntrinsic = intrinsic;
        try {
            this.MeasureTreeInner(app, available, clamp, passId, root, generation, sequence,
                passRuleSig, passAnyMedia, passMediaHash, passChainSeq);
        } finally {
            measureWidth = previousWidth;
            measureIntrinsic = prevIntrinsic;
            measuringTree = previous;
            measuringPass = prevPass;
            measuringApp = previousApp;
            if (previous) {
                measuringAncestors.RemoveAt(measuringAncestors.Count - 1);
                if (measuringAncestors.Count == 0) { measuringAncestors = null; }
            }
            app.styleCtx = prevCtx;
        }
    }
    public void MeasureTree(App app, int width) {
        int previous = measureWidth;
        measureWidth = width > 0 ? width : 0;
        try {
            this.MeasureTreeEntry(app, -1, false, false);
        } finally {
            measureWidth = previous;
        }
    }
    private void MeasureTreeInner(App app, int available, bool clamp,
                                  int passId, Control root, int generation, long sequence,
                                  int passRuleSig, bool passAnyMedia, long passMediaHash, int passChainSeq) {
        if (app != null && this.app != app) { this.InheritApp(app); }
        if (this.extra != null || !this.UsesBaseSyncBinding()) {
            if (!this.PrepareBindings(app)) { return; }
        } else if (syncingBinding) {
            return;
        }
        Control ownerParent = parent;
        if (this.fillW) { prefW = 0; this.fillW = false; }
        if (this.fillH) { prefH = 0; this.fillH = false; }
        bool styleOk;
        if (passId != 0 && styleValidatedPass == passId && styleValidatedApp == app
            && computedStyle != null && computedStyleState == 0 && computedStyleApp == app) {
            styleValidatedPass = 0;
            styleOk = true;
        } else {
            styleValidatedPass = 0;
            styleOk = computedStyleState == 0 && (passChainSeq != 0 && Style.chainActiveSeq == passChainSeq
                ? this.ComputedStyleCurrentPass(app, passRuleSig, passAnyMedia, passMediaHash, passChainSeq)
                : this.ComputedStyleCurrent(app));
        }
        if (!styleOk) {
            this.ResolveStyle(app, 0);
        }
        StyleBox cs = computedStyle;
        if (available >= 0) {
            int ml = marSet ? marL : (cs != null && cs.marL > 0 ? cs.marL : 0);
            int mr = marSet ? marR : (cs != null && cs.marR > 0 ? cs.marR : 0);
            int room = available - ml - mr;
            if (room < 0) { room = 0; }
            bool declW = cs != null && (cs.width >= 0 || cs.widthPm >= 0);
            int width = declW ? this.StyleWidthIn(available) : room;
            if (clamp && width > room) { width = room; }
            measureWidth = width > 0 ? width : 0;
        }
        if (!visible || (cs != null && (cs.display == 2 || cs.visible == 0))) {
            measureDependsOnWidth = false;
            return;
        }
        int display = this.StyleDisplay();
        int wrapMode = cs != null ? cs.wrap : 0;
        bool dep = this.IsWidthDependentMeasure() || display == 4
            || (display == 1 && wrapMode != 0)
            || (cs != null && cs.aspect != 0);
        int childCount = childNodes.Count;
        List<Control> preGridItems = null;
        GridLayoutPlan preGridPlan = null;
        int preGridAvail = 0 - 2;
        if (childCount > 0) {
            bool row = display == 1 && this.StyleFlexDir() != 1;
            bool intrinsicKids = measureIntrinsic || display == 4 || (row && wrapMode == 0);
            bool deferGridKids = false;
            int childWidth = !intrinsicKids && !row ? this.WrapContentWidth() : 0;
            if (childCount == 1 && !(display == 4 && !measureIntrinsic)) {
                Control child = childNodes[0];
                if (child.parent == this) {
                    if (intrinsicKids) {
                        child.MeasureTreeNode(app, -1, false, true, passId, root, generation, sequence,
                            passRuleSig, passAnyMedia, passMediaHash, passChainSeq);
                    } else if (!row && childWidth > 0) {
                        child.MeasureTreeNode(app, childWidth, display == 1, false, passId, root, generation, sequence,
                            passRuleSig, passAnyMedia, passMediaHash, passChainSeq);
                    } else {
                        child.MeasureTreeNode(app, -1, false, false, passId, root, generation, sequence,
                            passRuleSig, passAnyMedia, passMediaHash, passChainSeq);
                    }
                    if (child.measureDependsOnWidth) { dep = true; }
                    if (parent != ownerParent || (this.app != app && this.FindApp() != app) || app.rootControl != root
                    || app.inputRootGeneration != generation
                    || (app.window != null && app.window.EventSeq() != sequence)) { return; }
                }
            } else {
                List<Control> children = this.SnapshotChildrenCached();
                if (display == 4 && !measureIntrinsic) {
                    for (int i = 0; i < children.Count; i = i + 1) {
                        Control child = children[i];
                        if (child.parent != this) { continue; }
                        child.PrepareMeasureStylePass(app, passId, passRuleSig, passAnyMedia, passMediaHash, passChainSeq);
                        if (parent != ownerParent || (this.app != app && this.FindApp() != app) || app.rootControl != root
                        || app.inputRootGeneration != generation
                        || (app.window != null && app.window.EventSeq() != sequence)) { return; }
                    }
                    preGridItems = this.GridItems();
                    preGridAvail = this.GridMeasureWidth();
                    int baseGap = cs != null && cs.gap >= 0 ? cs.gap : gap;
                    int gridGap = cs != null && cs.colGap >= 0 ? cs.colGap : baseGap;
                    preGridPlan = this.PlanGrid(preGridItems, preGridAvail, gridGap);
                    deferGridKids = this.GridColumnsDefinite(preGridPlan, preGridAvail);
                }
                for (int i = 0; i < children.Count; i = i + 1) {
                    Control child = children[i];
                    if (child.parent != this) { continue; }
                    if (deferGridKids) {
                        StyleBox ccs = child.computedStyle;
                        if (child.visible && (ccs == null || (ccs.display != 2 && ccs.visible != 0 && ccs.position < 2))) { continue; }
                        child.MeasureTreeNode(app, -1, false, false, passId, root, generation, sequence,
                            passRuleSig, passAnyMedia, passMediaHash, passChainSeq);
                    } else if (intrinsicKids) {
                        child.MeasureTreeNode(app, -1, false, true, passId, root, generation, sequence,
                            passRuleSig, passAnyMedia, passMediaHash, passChainSeq);
                    } else if (!row && childWidth > 0) {
                        child.MeasureTreeNode(app, childWidth, display == 1, false, passId, root, generation, sequence,
                            passRuleSig, passAnyMedia, passMediaHash, passChainSeq);
                    } else {
                        child.MeasureTreeNode(app, -1, false, false, passId, root, generation, sequence,
                            passRuleSig, passAnyMedia, passMediaHash, passChainSeq);
                    }
                    if (child.measureDependsOnWidth) { dep = true; }
                    if (parent != ownerParent || (this.app != app && this.FindApp() != app) || app.rootControl != root
                    || app.inputRootGeneration != generation
                    || (app.window != null && app.window.EventSeq() != sequence)) { return; }
                }
            }
        }
        measureDependsOnWidth = dep;
        int keepW = prefW;
        int keepH = prefH;
        bool keepSet = prefSet;
        OnMeasure(app);
        if (childCount == 0 && !keepSet && this.UsesBaseFlowOnly()) { return; }
        if (parent != ownerParent || (this.app != app && this.FindApp() != app) || app.rootControl != root
        || app.inputRootGeneration != generation
        || (app.window != null && app.window.EventSeq() != sequence)) { return; }
        if (keepSet) {
            if (keepW > 0) { prefW = keepW; }
            if (keepH > 0) { prefH = keepH; }
            prefSet = true;
        }
        this.MeasureContentPass(app, preGridItems, preGridPlan, preGridAvail,
            passId, root, generation, sequence, passRuleSig, passAnyMedia, passMediaHash, passChainSeq);
    }
    private void MeasureInWidthPass(App app, int available, bool clamp,
                                    int passId, Control root, int generation, long sequence,
                                    int passRuleSig, bool passAnyMedia, long passMediaHash, int passChainSeq) {
        if (passId != 0 && app != null && app.measurePassSeq == passId && Style.chainPassDepth > 0 && Style.chainApp == app) {
            this.MeasureTreeNode(app, available > 0 ? available : 0, clamp, false, passId, root, generation, sequence,
                passRuleSig, passAnyMedia, passMediaHash, passChainSeq);
            return;
        }
        this.MeasureInWidth(app, available, clamp);
    }
    private void MeasureInWidth(App app, int available, bool clamp) {
        int passId = app != null ? app.measurePassSeq : 0;
        if (passId != 0 && Style.chainPassDepth > 0 && Style.chainApp == app) {
            Control root = app.rootControl;
            int generation = app.inputRootGeneration;
            long sequence = app.window != null ? app.window.EventSeq() : 0;
            int passRuleSig = app.CurrentStyleRuleSig();
            bool passAnyMedia = (passRuleSig & 1) != 0;
            long passMediaHash = passAnyMedia ? Style.PassMediaHash(app) : 0L;
            int passChainSeq = Style.chainApp == app ? Style.chainActiveSeq : 0;
            this.MeasureTreeNode(app, available > 0 ? available : 0, clamp, false, passId, root, generation, sequence,
                passRuleSig, passAnyMedia, passMediaHash, passChainSeq);
            return;
        }
        this.MeasureTreeEntry(app, available > 0 ? available : 0, clamp, false);
    }
    protected virtual int WrapContentWidth() {
        int width = measureWidth;
        if (width < 0) {
            width = hintWrapW;
            if (this.StyleDeclaresWidth()) { width = this.StyleWidthIn(width); }
            else if (prefSet && prefW > 0) { width = prefW; }
            else if (width <= 0) { width = prefW; }
        }
        return width - this.StyleInsetL() - this.StyleInsetR();
    }
    void PropagateWrapHint() {
        int inner = this.WrapContentWidth();
        if (inner <= 0) { return; }
        bool flex = this.StyleDisplay() == 1;
        bool flexRow = flex && this.StyleFlexDir() != 1;
        for (int i = 0; i < childNodes.Count; i = i + 1) {
            Control c = childNodes[i];
            if (c.hintWrapW > 0) { continue; }
            if (flex && flexRow) { continue; }
            c.hintWrapW = inner;
        }
    }
    static int CollapseMargins(int a, int b) {
        if (a >= 0 && b >= 0) { return a > b ? a : b; }
        if (a < 0 && b < 0) { return a < b ? a : b; }
        int hi = a > b ? a : b;
        int lo = a < b ? a : b;
        return hi + lo;
    }
    bool FlowSepT() {
        StyleBox sb = computedStyle;
        if (sb == null) { return true; }
        if (sb.bfc != 0 || sb.overflowCss == 1 || sb.position >= 2) { return true; }
        if (sb.display != 3) { return true; }
        return this.StyleInsetT() > 0;
    }
    bool FlowSepB() {
        StyleBox sb = computedStyle;
        if (sb == null) { return true; }
        if (sb.bfc != 0 || sb.overflowCss == 1 || sb.position >= 2) { return true; }
        if (sb.display != 3) { return true; }
        return this.StyleInsetB() > 0;
    }
    int FlowMarT(Control c) {
        int m = c.StyleMarT();
        if (c.StyleDisplay() != 3 || c.FlowSepT()) { return m; }
        List<Control> kk = c.FlexKids();
        if (kk.Count == 0) { return m; }
        return CollapseMargins(m, this.FlowMarT(kk[0]));
    }
    int FlowMarB(Control c) {
        int m = c.StyleMarB();
        if (c.StyleDisplay() != 3 || c.FlowSepB()) { return m; }
        List<Control> kk = c.FlexKids();
        if (kk.Count == 0) { return m; }
        return CollapseMargins(m, this.FlowMarB(kk[kk.Count - 1]));
    }
    bool IsEmptyFlowBlock(Control c) {
        if (c.StyleDisplay() != 3) { return false; }
        if (c.FlowEntries().Count > 0) { return false; }
        StyleBox sb = c.computedStyle;
        if (sb != null) {
            if (sb.height > 0 || sb.heightPm > 0
            || sb.minH > 0 || sb.minHPm > 0) { return false; }
            if (sb.BorderTopPx() > 0 || sb.BorderBottomPx() > 0) { return false; }
            if (c.StyleInsetT() > 0 || c.StyleInsetB() > 0) { return false; }
        }
        return true;
    }
    public virtual string FlowText() { return ""; }
    public virtual void InlineRunsBegin() { }
    public virtual void InlineRunPlace(int x, int topY, int w, int h, int drawOff,
    int fs, string text) { }
    void MeasureFlow(App app) {
        if (prefW > 0 && prefH > 0) { return; }
        this.MeasureFlowEntries(app, this.FlowEntries());
    }
    private void MeasureFlowEntries(App app, List<FlowEntry> es) {
        if (es.Count == 0 || (prefW > 0 && prefH > 0)) { return; }
        int sumH = 0;
        int maxW = 0;
        int rows = 0;
        bool sepT = this.FlowSepT();
        bool sepB = this.FlowSepB();
        int pending = 0 - 1;  // 待结算的塌陷链（-1 = 还没有占高块）
        int wrapW = this.WrapContentWidth();
        List<FlowEntry> seg = null;
        List<FloatIntrusion> floats = null;
        int ownFloats = 0;
        if (this.hostFloats != null && this.hostFloats.Count > 0) {
            measureDependsOnWidth = true;
            floats = new List<FloatIntrusion>();
            for (int fi = 0; fi < this.hostFloats.Count; fi = fi + 1) {
                floats.Add(this.hostFloats[fi]);
            }
            ownFloats = floats.Count;
        }
        int segY = 0;
        for (int i = 0; i <= es.Count; i = i + 1) {
            FlowEntry e = i < es.Count ? es[i] : null;
            Control c = e != null ? e.kid : null;
            if (e != null && (c == null || c.StyleInlineLevel() == 1)) {
                if (seg == null) {
                    seg = new List<FlowEntry>();
                    segY = sumH + (pending > 0 ? pending : 0);
                }
                seg.Add(e);
                continue;
            }
            if (seg != null && seg.Count > 0) {
                measureDependsOnWidth = true;
                FlowSegment fs2 = this.FlowLayoutSegment(
                seg, wrapW > 0 ? wrapW : 0, 0, floats, segY);
                seg = null;
                if (fs2.lines.Count > 0) {
                    if (pending >= 0) { sumH = sumH + CollapseMargins(pending, 0); }
                    pending = 0;
                    sumH = sumH + fs2.height;
                    int lw = 0;
                    for (int li = 0; li < fs2.lines.Count; li = li + 1) {
                        int w2 = fs2.lines[li].xOff + fs2.lines[li].width;
                        if (w2 > lw) { lw = w2; }
                    }
                    if (lw > maxW) { maxW = lw; }
                    rows = rows + 1;
                }
            }
            if (c == null) { break; }
            if (c.StyleFloat() != 0) {
                measureDependsOnWidth = true;
                if (floats == null) { floats = new List<FloatIntrusion>(); }
                int fy = sumH + (pending > 0 ? pending : 0);
                for (int oi = ownFloats; oi < floats.Count; oi = oi + 1) {
                    if (floats[oi].yTop > fy) { fy = floats[oi].yTop; }
                }
                int fw = c.StyleDeclaresWidthAbs()
                ? c.StyleWidthIn(wrapW) : c.prefW;
                int fwm = (fw > 0 ? fw : 0) + c.StyleMarL() + c.StyleMarR();
                if (fwm > maxW) { maxW = fwm; }
                this.PlaceFloatKid(floats, c, wrapW > 0 ? wrapW : 0, fy,
                0, 0, false);
                continue;
            }
            bool empty = this.IsEmptyFlowBlock(c);
            int kmt = empty ? c.StyleMarT() : this.FlowMarT(c);
            int kmb = empty ? c.StyleMarB() : this.FlowMarB(c);
            int clr = c.StyleClear();
            int clear = 0;
            if (clr != 0) {
                int clearY = LineBox.ClearY(
                floats, clr, sumH + (pending > 0 ? pending : 0));
                int need = clearY - sumH;
                if (need > 0) { clear = need; }
            }
            int h = 0;
            if (!empty) {
                h = c.StyleHeightIn(0);
                if (h < 0) { h = 0; }
            }
            int w = 0;
            if (c.StyleDeclaresWidthAbs()) { w = c.StyleWidthIn(0); }
            else { w = c.prefW; }
            w = w + c.MarMain(true);  // 水平 margin 不塌陷，照常计宽
            if (w > maxW) { maxW = w; }
            if (empty) {
                int withMt = pending < 0 ? kmt : CollapseMargins(pending, kmt);
                pending = CollapseMargins(withMt, kmb);
                continue;
            }
            int withMt2 = pending < 0 ? kmt : CollapseMargins(pending, kmt);
            if (floats != null && floats.Count > 0) {
                this.SetHostFloats(c, floats,
                c.StyleMarL() + c.StyleInsetL(),
                sumH + withMt2 + c.StyleInsetT());
                if (!c.StyleDeclaresHeightAbs()) {
                    c.prefH = 0;
                    c.fillH = false;
                    c.MeasureFlow(null);
                    h = c.prefH;
                    if (h < 0) { h = 0; }
                }
            } else {
                c.hostFloats = null;
            }
            if (pending < 0) {
                if (sepT) { sumH = sumH + withMt2; }
            } else {
                sumH = sumH + withMt2;
            }
            pending = kmb;
            sumH = sumH + clear;
            sumH = sumH + h;
            rows = rows + 1;
        }
        if (floats != null && floats.Count > ownFloats && computedStyle != null
        && computedStyle.bfc != 0) {
            for (int i = ownFloats; i < floats.Count; i = i + 1) {
                if (floats[i].yBot > sumH) { sumH = floats[i].yBot; }
            }
        }
        if (rows > 1) { sumH = sumH + this.StyleGap() * (rows - 1); }
        if (pending > 0 && sepB && rows > 0) { sumH = sumH + pending; }
        else if (pending > 0 && sepT && sepB && rows == 0) { sumH = sumH + pending; }
        if (prefH <= 0 && sumH > 0) {
            prefH = sumH + this.StyleInsetT() + this.StyleInsetB();
            this.fillH = true;
        }
        if (prefW <= 0 && maxW > 0) {
            prefW = maxW + this.StyleInsetL() + this.StyleInsetR();
            this.fillW = true;
        }
    }
    void MeasureContent(App app) {
        this.MeasureContentPass(app, null, null, 0 - 2, 0, null, 0, 0L, 0, false, 0L, 0);
    }
    void MeasureContentPass(App app, List<Control> preGridItems, GridLayoutPlan preGridPlan, int preGridAvail,
                            int passId, Control root, int generation, long sequence,
                            int passRuleSig, bool passAnyMedia, long passMediaHash, int passChainSeq) {
        List<FlowEntry> entries = null;
        if (childNodes.Count == 0) {
            if (this.UsesBaseFlowOnly()) { return; }
            entries = this.FlowEntries();
            if (entries.Count == 0) { return; }
        }
        int disp = this.StyleDisplay();
        if (disp == 1) {
            this.MeasureFlexContent(app);
            return;
        }
        if (disp == 4) {
            this.MeasureGridContentPass(app, preGridItems, preGridPlan, preGridAvail,
                passId, root, generation, sequence, passRuleSig, passAnyMedia, passMediaHash, passChainSeq);
            return;
        }
        if (entries != null) { this.MeasureFlowEntries(app, entries); }
        else { this.MeasureFlow(app); }
    }
    static int FitSize(int requested, int available) {
        if (requested < 0) { return 0; }
        if (available < 0) { return 0; }
        if (requested > available) { return available; }
        return requested;
    }
    static int FitGap(int requested, int available) {
        if (requested < 0 || available <= 0) { return 0; }
        if (requested > available) { return available; }
        return requested;
    }
    void ArrangeScrollTail() {
        if (!this.IsScrollContainer()) { return; }
        Rect view = this.ScrollViewport();
        int previousX = scrollX;
        int previousY = scrollY;
        int bottom = view.y;
        int right = view.x;
        for (int i = 0; i < childNodes.Count; i = i + 1) {
            Control c = childNodes[i];
            if (!c.StyleVisible() || c.StylePosition() >= 2) { continue; }
            int b = c.by + c.bh;
            if (b > bottom) { bottom = b; }
            int r = c.bx + c.bw;
            if (r > right) { right = r; }
        }
        int width = Math.Max(0, view.width);
        int height = Math.Max(0, view.height);
        scrollExtent = Math.Max(height, bottom + this.StylePadB() - view.y);
        scrollExtentX = Math.Max(width, right + this.StylePadR() - view.x);
        scrollY = Math.Max(0, Math.Min(scrollY, scrollExtent - height));
        scrollX = Math.Max(0, Math.Min(scrollX, scrollExtentX - width));
        int dy = 0 - this.scrollY;
        int dx = 0 - this.scrollX;
        if (dy != 0 || dx != 0) {
            for (int i = 0; i < childNodes.Count; i = i + 1) {
                if (childNodes[i].StylePosition() == 3) { continue; }
                childNodes[i].ShiftTree(dx, dy);
            }
        }
        this.NotifyScrollChanged(previousX, previousY);
    }
    public virtual void ShiftTree(int dx, int dy) {
        this.bx = this.bx + dx;
        this.by = this.by + dy;
        for (int i = 0; i < childNodes.Count; i = i + 1) {
            if (childNodes[i].StylePosition() == 3) { continue; }
            childNodes[i].ShiftTree(dx, dy);
        }
    }
    public virtual void Arrange(int px, int py, int pw, int ph) {
        if (pw < 0) { pw = 0; }
        if (ph < 0) { ph = 0; }
        bx = px;
        by = py;
        bw = pw;
        bh = ph;
        if (!everLaidOut || bw != lastBw || bh != lastBh) {
            App host = this.app;
            if (host != null) { host.layoutEventsDirty = true; }
        }
        StyleBox cs = computedStyle;
        if ((childNodes == null || childNodes.Count == 0) && this.UsesBaseFlowOnly()) {
            if (cs != null && (cs.overflowX != 0 || cs.overflowY != 0)) {
                this.ArrangeScrollTail();
            }
            return;
        }
        int innerPadL = this.StyleInsetL();
        int innerPadT = this.StyleInsetT();
        int innerPadR = this.StyleInsetR();
        int innerPadB = this.StyleInsetB();
        int innerGap = cs != null && cs.gap >= 0 ? cs.gap : gap;
        int cx = px + innerPadL;
        int cy = py + innerPadT;
        int cw = pw - innerPadL - innerPadR;
        int ch = ph - innerPadT - innerPadB;
        if (cw < 0) { cw = 0; }
        if (ch < 0) { ch = 0; }
        int pbx = px;
        int pby = py;
        int pbw = pw;
        int pbh = ph;
        int dispBox = this.StyleDisplay();
        bool needPositioned = true;
        if (dispBox == 1) {
            needPositioned = this.ArrangeFlex(cx, cy, cw, ch, innerGap);
        } else if (dispBox == 4) {
            this.ArrangeGrid(cx, cy, cw, ch);
        } else {
            this.ArrangeFlow(cx, cy, cw, ch, innerGap);
        }
        if (needPositioned) { this.ArrangePositioned(pbx, pby, pbw, pbh); }
        if (LayoutLintDiagnostics.AnyActive()) { this.CheckKidsLayout(); }
        if (cs != null && (cs.overflowX != 0 || cs.overflowY != 0)) {
            this.ArrangeScrollTail();
        }
    }
    void ArrangePositioned(int cx, int cy, int cw, int ch) {
        if (childNodes == null || childNodes.Count == 0) { return; }
        int count = childNodes.Count;
        for (int i = 0; i < count; i = i + 1) {
            Control c = childNodes[i];
            if (!c.visible) { continue; }
            StyleBox sb = c.computedStyle;
            int pos = 0;
            if (sb != null) {
                if (sb.display == 2 || sb.visible == 0) { continue; }
                pos = sb.position;
            }
            if (pos != 1 && pos != 2 && pos != 3) {
                if (c.mx != 0 || c.my != 0) {
                    pos = 2;
                } else {
                    continue;
                }
            }
            int posT = sb == null ? 0 - 1 : sb.posT;
            int posR = sb == null ? 0 - 1 : sb.posR;
            int posB = sb == null ? 0 - 1 : sb.posB;
            int posL = sb == null ? 0 - 1 : sb.posL;
            if (posL == 0 - 1 && c.mx != 0) { posL = c.mx; }
            if (posT == 0 - 1 && c.my != 0) { posT = c.my; }
            if (pos == 1) {
                int dx = posL != 0 - 1 ? posL
                : (posR != 0 - 1 ? 0 - posR : 0);
                int dy = posT != 0 - 1 ? posT
                : (posB != 0 - 1 ? 0 - posB : 0);
                if (dx != 0 || dy != 0) { c.Arrange(c.bx + dx, c.by + dy, c.bw, c.bh); }
                continue;
            }
            int cbx = cx;
            int cby = cy;
            int cbw = cw;
            int cbh = ch;
            if (pos == 3) {
                App hostApp = this.App;
                if (hostApp != null) {
                    hostApp.ContentBounds(out cbx, out cby, out cbw, out cbh);
                } else {
                    Control root = this;
                    while (root.parent != null) { root = root.parent; }
                    cbx = root.bx; cby = root.by; cbw = root.bw; cbh = root.bh;
                }
            }
            int w = c.StyleWidthIn(cbw);
            int h = c.StyleHeightIn(cbh);
            if (posL != 0 - 1 && posR != 0 - 1) { w = cbw - posL - posR; }
            if (posT != 0 - 1 && posB != 0 - 1) { h = cbh - posT - posB; }
            if (w < 0) { w = 0; }
            if (h < 0) { h = 0; }
            int x = cbx;
            int y = cby;
            if (posL != 0 - 1) { x = cbx + posL; }
            else if (posR != 0 - 1) { x = cbx + cbw - posR - w; }
            if (posT != 0 - 1) { y = cby + posT; }
            else if (posB != 0 - 1) { y = cby + cbh - posB - h; }
            c.Arrange(x, y, w, h);
        }
    }
}
