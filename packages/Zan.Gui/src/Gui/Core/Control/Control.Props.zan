using System;
using System.Collections.Generic;
using System.Json;
using Gui;

namespace Gui;

// Control.Props.zan - 控件设计器属性、插槽挂载、数据绑定契约与状态尺寸档位
public partial class Control {
    // --- 设计器/序列化模型（通过虚方法统一、免强转）---

    // 用于重建此节点的稳定类型标签（见 ControlFactory），默认即类名（泛型去掉
    // 类型实参）。只有标签与类名不同的控件（别名、按父类种类上报的内部件）
    // 才重写它。
    public virtual string Kind() {
        string name = this.GetType().Name;
        int lt = name.IndexOf("<");
        return lt > 0 ? name.Substring(0, lt) : name;
    }

    // Copy business content only; composite widgets rebuild their generated parts.
    public virtual void CloneContentTo(Control target, CloneTreeFn clone) {
        for (int i = 0; i < childNodes.Count; i = i + 1) {
            Control child = clone(childNodes[i]);
            if (child == null) { continue; }
            if (child.slotName != "" && target.MountSlot(child.slotName, child)) { continue; }
            target.Add(child);
        }
    }

    // Build a schema once per instance. Field descriptors resolve the current
    // Binding at access time; replacing a Binding never invalidates metadata.
    public List<PropSpec> Props() {
        int schemaKey = this.PropertySchemaKey();
        ControlExtra state = this.EnsureExtra();
        if (state.propertySpecs == null || state.propertySchemaKey != schemaKey) {
            List<PropSpec> specs = this.DefineProps();
            // 字段型属性按本类型的声明类型解析值类型（string/int/bool 或 Binding<T>）。
            for (int i = 0; i < specs.Count; i = i + 1) { specs[i].Resolve(this); }
            state.propertySpecs = specs;
            state.propertySchemaKey = schemaKey;
        }
        return state.propertySpecs;
    }

    protected virtual int PropertySchemaKey() { return 0; }

    protected virtual List<PropSpec> DefineProps() {
        return new List<PropSpec>();
    }

    // 元数据只决定绑定目标与值类型，实际访问保留 GetProp/SetProp 的转换与失效语义。
    public PropSpec BindingSpec(string prop, bool numeric) {
        List<PropSpec> ps = this.Props();
        if (prop != "") {
            for (int i = 0; i < ps.Count; i = i + 1) {
                if (ps[i].Answers(prop)) { return ps[i]; }
            }
            return null;
        }
        PropSpec first = null;
        for (int i = 0; i < ps.Count; i = i + 1) {
            PropSpec p = ps[i];
            if (!p.defaultBinding) { continue; }
            if (first == null) { first = p; }
            if ((p.ValueKind() == PropValueKind.Int) == numeric) { return p; }
        }
        return first;
    }

    // 设计里放进容器某个“位”的子控件（标签页的页、分栏的
    // 窗格）真正的父节点。容器重写它，把设计文档的 `childTab`
    // 映射到自己的内部容器；普通容器直接收下子节点。
    public virtual Control SlotHost(int slot) {
        return this;
    }

    // 具名插槽宿主容器：复合组件（Tabs/SplitPanel/Card/Dialog 等）根据 slot 名字
    // 映射到具体的内部容器（如 "header"、"footer"、"left"、"right" 或数字页码）。
    public virtual Control NamedSlotHost(string slot) {
        if (slot == "" || slot == "default") { return this; }
        if (Control.IsNumericSlot(slot)) {
            return this.SlotHost(Convert.ToInt32(slot));
        }
        return null;
    }

    // 将子控件挂载到指定具名槽位：若成功消费槽位则返回 true。
    public virtual bool MountSlot(string slot, Control c) {
        Control host = this.NamedSlotHost(slot);
        if (host != null && host != this) {
            host.Add(c);
            return true;
        }
        return false;
    }

    public static bool IsNumericSlot(string s) {
        if (s == "") { return false; }
        for (int i = 0; i < s.Length; i = i + 1) {
            int ch = (int)s[i];
            if (ch < 48 || ch > 57) { return false; }
        }
        return true;
    }

    // Aliases resolve against the cached schema; field access follows the current Binding.
    private PropSpec ResolveProperty(string key) {
        return PropSpec.Find(this.Props(), key, false);
    }

    // 通过控件在 Props() 中绑定的访问器，按键以文本形式读取属性——
    // 这样控件只需发布每个属性一次，无需自己的
    // 字符串映射。`class`、`name` 和 `disabled` 对所有控件都有应答。
    public virtual string GetProp(string key) {
        if (key == "class") { return Class; }
        if (key == "visible") { return PropSpec.Flag(this.Visible); }
        if (key == "name") {
            // Match SetProp: a bound widget name is distinct from the node ID.
            PropSpec np = this.PropOf(key);
            if (np != null && np.IsBound()) { return np.ReadFrom(this); }
            return name;
        }
        PropSpec p = this.ResolveProperty(key);
        if (p != null && p.IsBound()) { return p.ReadFrom(this); }
        // `disabled` 是基类字段（沿树继承的禁用标志）——每个控件都
        // 有这个状态，属性协议必须应答它。控件自己没声明该属性时，
        // 设计器写进去的"禁用"落不到控件上（基类兜底会把它当样式
        // 类，控件本身没被禁用）。
        if (key == "disabled") { return PropSpec.Flag(this.Disabled.Get()); }
        if (p != null) { return p.ReadFrom(this); }
        return "";
    }

    // 从文本按键写入属性（GetProp 的逆操作）。未知的
    // 键改指样式类，要么是标志（`"round": true`），要么是
    // 变体名（`"size": "small"`），文档正是借此设置
    // 控件没有字段对应的视觉变体。
    // 属性经通用协议（设计器、HTML、模型绑定）写入之后的回调。属性变化后需要
    // 重建内部结构的控件覆写它；不按 spec.key 分派——单个属性的副作用写在
    // 该属性的 setter 里。
    protected virtual void OnPropertyChanged(PropSpec spec) {
    }

    public virtual void SetProp(string key, string val) {
        if (key == "class") { Class = val; this.Invalidate(); return; }
        if (key == "visible") { this.Visible = PropSpec.IsOn(val); this.Invalidate(); return; }
        if (key == "style") {
            // 内联 CSS 声明即时落控件（布局键落字段、视觉键落 style*
            // 覆盖字段）。清掉常态样式缓存：SetProp 可能发生在首绘
            // 之后，不清缓存下一帧还会拿旧的解析结果画。
            StyleSheet.ApplyInline(this, val);
            computedStyle = null;
            this.Invalidate();
            return;
        }
        if (key == "name") {
            // 组件自带同名属性（IconView 的图标名等）优先于控件
            // 标识名：直接写标识名会让这类属性在任何声明通道
            // （data-x-props/原生属性）下永远喂不进去。
            PropSpec np = this.PropOf(key);
            if (np != null && np.IsBound()) {
                np.WriteTo(this, val);
                this.Invalidate();
                return;
            }
            name = val;
            this.Invalidate();
            return;
        }
        PropSpec p = this.ResolveProperty(key);
        if (p != null && p.IsBound()) {
            p.WriteTo(this, val);
            this.Invalidate();
            this.OnPropertyChanged(p);
            return;
        }
        if (p != null) {
            p.WriteTo(this, val);
            this.Invalidate();
            return;
        }
        // `disabled` 落基类字段（见 GetProp 的同名分支）。控件自
        // 己声明了 disabled 属性时走上面的 spec——同一个字段。
        if (key == "disabled") {
            this.Disabled.Set(PropSpec.IsOn(val));
            this.Invalidate();
            return;
        }
        if (val == "true") { this.AddClass(key); this.Invalidate(); }
        else if (val != "" && val != "false") { this.AddClass(val); this.Invalidate(); }
    }

    // 应用设计器里的标题文本。只有声明了 `text` 属性的控件
    // 会接受它：容器的 label 是设计期说明，不是内容，所以
    // 不能像 SetProp 那样退化成样式类。
    void SetDesignText(string txt) {
        if (txt == "") { return; }
        PropSpec p = this.PropOf("text");
        if (p == null) { return; }
        // Preserve the widget setter's retained projection before first measure.
        this.SetProp(p.key, txt);
    }

    // Declare a model path against a component property. An empty property uses
    // the component's DefaultBinding metadata; no expression evaluator is involved.
    internal ModelBindingDeclaration DeclareBinding(string path, string property, bool twoWay) {
        if (!ModelBindingDeclaration.ValidPath(path)) {
            throw new ArgumentException("Binding path must be a dotted identifier path");
        }
        if (property != "" && (property.IndexOf(".") >= 0 || !ModelBindingDeclaration.ValidPath(property))) {
            throw new ArgumentException("Binding property must be an identifier");
        }
        ControlExtra e = this.EnsureExtra();
        if (e.bindings == null) { e.bindings = new List<ModelBindingDeclaration>(); }
        for (int i = 0; i < e.bindings.Count; i = i + 1) {
            ModelBindingDeclaration existing = e.bindings[i];
            if (existing.property == property) {
                throw new InvalidOperationException("Duplicate binding for property '" + property + "'");
            }
        }
        ModelBindingDeclaration declaration = new ModelBindingDeclaration(path, property, twoWay);
        e.bindings.Add(declaration);
        Control.NoteBindingStructureChanged();
        return declaration;
    }

    public Control BindPath(string path) {
        this.DeclareBinding(path, "", true);
        return this;
    }

    public Control BindPath(string path, string property) {
        if (property == "") { throw new ArgumentException("Binding property cannot be empty"); }
        this.DeclareBinding(path, property, true);
        return this;
    }

    public Control BindOneWay(string path, string property) {
        if (property == "") { throw new ArgumentException("Binding property cannot be empty"); }
        this.DeclareBinding(path, property, false);
        return this;
    }

    public int BindingCount {
        get { return this.bindings != null ? this.bindings.Count : 0; }
    }

    public ModelBindingDeclaration BindingAt(int index) {
        if (this.bindings == null || index < 0 || index >= this.bindings.Count) {
            throw new ArgumentException("Binding index out of range");
        }
        return this.bindings[index];
    }

    public void SetBindingPath(int index, string path) {
        if (!ModelBindingDeclaration.ValidPath(path)) {
            throw new ArgumentException("Binding path must be a dotted identifier path");
        }
        ModelBindingDeclaration declaration = this.BindingAt(index);
        if (declaration.path == path) { return; }
        declaration.path = path;
        Control.NoteBindingStructureChanged();
    }

    public void SetBindingProperty(int index, string property) {
        if (property != "" && (property.IndexOf(".") >= 0 || !ModelBindingDeclaration.ValidPath(property))) {
            throw new ArgumentException("Binding property must be an identifier");
        }
        ModelBindingDeclaration declaration = this.BindingAt(index);
        if (!declaration.twoWay && property == "") {
            throw new ArgumentException("One-way binding requires a component property");
        }
        for (int i = 0; i < this.bindings.Count; i = i + 1) {
            if (i != index && this.bindings[i].property == property) {
                throw new InvalidOperationException("Duplicate binding for property '" + property + "'");
            }
        }
        if (declaration.property == property) { return; }
        declaration.property = property;
        Control.NoteBindingStructureChanged();
    }

    public void RemoveBindingAt(int index) {
        this.BindingAt(index);
        this.bindings.RemoveAt(index);
        Control.NoteBindingStructureChanged();
    }

    public void ClearBindings() {
        if (this.bindings != null && this.bindings.Count > 0) {
            this.bindings.Clear();
            Control.NoteBindingStructureChanged();
        }
    }

    // Designer documents use one canonical array for both HTML and code-tree export.
    public JsonValue BindingsJson() {
        JsonValue result = JsonValue.NewArray();
        for (int i = 0; i < this.BindingCount; i = i + 1) {
            ModelBindingDeclaration binding = this.BindingAt(i);
            JsonValue item = JsonValue.NewObject();
            item.PutStr("path", binding.Path);
            item.PutStr("property", binding.Property);
            item.PutBool("twoWay", binding.TwoWay);
            result.Append(item);
        }
        return result;
    }

    public void ReadBindingsJson(JsonValue source) {
        this.ClearBindings();
        if (source == null) { return; }
        if (!source.IsArray()) { throw new ArgumentException("Bindings must be an array"); }
        for (int i = 0; i < source.Count(); i = i + 1) {
            JsonValue item = source.At(i);
            if (item == null || !item.IsObject()) {
                throw new ArgumentException("Binding declaration must be an object");
            }
            string path = item.Str("path", "");
            string property = item.Str("property", "");
            bool twoWay = item.Bool("twoWay", true);
            if (!twoWay && property == "") {
                throw new ArgumentException("One-way binding requires a component property");
            }
            this.DeclareBinding(path, property, twoWay);
        }
    }

    public void CopyBindingsTo(Control target) {
        if (target == null) { throw new ArgumentException("Binding copy target is required"); }
        target.ClearBindings();
        for (int i = 0; i < this.BindingCount; i = i + 1) {
            ModelBindingDeclaration binding = this.BindingAt(i);
            target.DeclareBinding(binding.Path, binding.Property, binding.TwoWay);
        }
    }

    public bool BindingsEqual(Control other) {
        if (other == null || this.BindingCount != other.BindingCount) { return false; }
        for (int i = 0; i < this.BindingCount; i = i + 1) {
            ModelBindingDeclaration a = this.BindingAt(i);
            ModelBindingDeclaration b = other.BindingAt(i);
            if (a.Path != b.Path || a.Property != b.Property || a.TwoWay != b.TwoWay) { return false; }
        }
        return true;
    }

    static string ClassWith(string source, string cls) {
        if (source == null) { source = ""; }
        if (cls == null || cls == "" || Style.Has(source, cls)) { return source; }
        return source == "" ? cls : source + " " + cls;
    }

    // 若样式类尚不存在则添加它。
    void AddClass(string cls) { Class = Control.ClassWith(Class, cls); }

    // 把 `cls` 从 `Class` 里移除（不存在则原样；类列表以空格分隔）。
    // 与 AddClass 成对：新控件的状态类（selected/checked/indeterminate…）
    // 每帧用这对方法翻转，不必手写字符串拼接。
    void RemoveClass(string cls) {
        if (cls == "" || Class == null || Class == "") { return; }
        List<string> drop = Style.Classes(cls);
        List<string> cur = Style.Classes(Class);
        string kept = "";
        for (int i = 0; i < cur.Count; i = i + 1) {
            bool hit = false;
            for (int j = 0; j < drop.Count; j = j + 1) {
                if (cur[i] == drop[j]) { hit = true; }
            }
            if (hit) { continue; }
            if (kept == "") { kept = cur[i]; } else { kept = kept + " " + cur[i]; }
        }
        Class = kept;
    }

    // 判断控件是否包含指定的样式类。
    bool HasClass(string cls) {
        if (cls == "" || Class == null || Class == "") { return false; }
        return Style.Has(Class, cls);
    }

    // 把 `Class` 里属于 `group`（空格分隔的候选集）的类全部去掉，
    // 再加上 `cls`（`cls` 为空则只做清除）。
    // 同一根轴上的变体是互斥的：`justify-center` 与 `justify-end`
    // 同时挂着时，最终生效的是样式表里靠后那条规则，作者每换一次
    // 对齐方式都得自己先去清掉上一次留下的类。这个方法把互斥
    // 关系收在一处，供 Flex/Grid 这类有多组变体的容器使用。
    void SetClassIn(string group, string cls) {
        Class = Control.ClassIn(Class, group, cls);
    }

    static string ClassIn(string source, string group, string cls) {
        List<string> drop = Style.Classes(group);
        List<string> cur = Style.Classes(source);
        string kept = "";
        for (int i = 0; i < cur.Count; i = i + 1) {
            bool inGroup = false;
            for (int j = 0; j < drop.Count; j = j + 1) {
                if (cur[i] == drop[j]) { inGroup = true; }
            }
            if (inGroup) { continue; }
            if (kept == "") { kept = cur[i]; } else { kept = kept + " " + cur[i]; }
        }
        return Control.ClassWith(kept, cls);
    }

    // Naive UI `size` prop 值对应的 class 片段：四档一一对应
    // （tiny/small/medium/large），空串表示"不附加"（默认档）。
    //
    // 过去 tiny 被并进 small，于是 base.css 里写好的 `.tiny` 规则
    // （button.tiny / switch.tiny / tag.tiny / radio.tiny）永远不可达，
    // "同一档在不同组件上不是一个量"。现在四档各自成类，档位几何
    // 统一取自 Style.RootFromTheme 导出的 --height-* / --font-size-*
    // 令牌；没有 `.medium` 规则的组件落在默认档，与 medium 等价。
    static string SizeClass(string size) {
        if (size == "tiny" || size == "small" || size == "medium"
            || size == "large") {
            return size;
        }
        return "";
    }

    // 实例侧便捷：解析本控件的 `Size` 绑定字段并映射为档位
    // class 片段。Binding<string> 型的 Size 字段直接调用即可。
    string SizeCls() {
        Binding<string> sz = this.SizeOf();
        if (sz == null) { return ""; }
        return Control.SizeClass(sz.Get());
    }

    // 把尺寸档落到样式类上——控件支持尺寸档时的**统一入口**。
    //
    // 档位类互斥：挂新档之前先把 Class 里其它档位去掉，所以
    // `Class = "small"` 与 `Size = "large"` 同时存在时是 large 说了算，
    // 不会留下两个高度规则互相打架。用户手写的其它类（primary /
    // ghost / outline…）不受影响。
    //
    // **medium 是默认档，不覆盖用户写的档位**：设计器的尺寸行默认
    // 选中 medium，若它也去覆盖，`Class = "primary small"` 这种既有
    // 写法会被无声改成 medium 档（按钮集体变大）。所以：
    //   - 绑定为空 → 什么都不做（Class 原样）；
    //   - 绑定为 medium（默认）或非法值 → 什么都不做；
    //   - 绑定为 tiny/small/large → 挂上该档并清掉其它档。
    //
    // 控件在解析样式前调用它，并在解析后把 Class 还原——档位因此
    // 只是"这一帧的排布"，不会污染作者写下的 Class。
    void ApplySizeClass() {
        Class = this.SizeClassIn(Class);
    }

    // Project a size binding without consuming the author's class declaration.
    string SizeClassIn(string source) {
        Binding<string> sz = this.SizeOf();
        if (sz == null) { return source; }
        string cls = Control.SizeClass(sz.Get());
        if (cls == "" || cls == "medium") { return source; }
        return Control.ClassIn(source, "tiny small medium large", cls);
    }

    // 设计器属性：尺寸档。控件在 Props() 里加一行
    // `ps.Add(this.SizeProp())` 即可，与各控件自己拼 PropSpec 的
    // 写法一致。
    PropSpec SizeProp() {
        PropSpec sz = PropSpec.Enum("size", "Size", PropSpec.Sizes());
        if (this.SizeOf() != null) { sz.Field("Size"); }
        return sz;
    }

    // 校验状态类名（Naive UI status prop）。输入族控件
    // （Input/TextArea）把 `FieldStatus` 映射为这些 class，
    // base.css 的 `.success/.warning/.error` 规则负责描边。
    // 校验成功状态类名（"success"）。
    static string StatusSuccess() { return "success"; }
    // 校验警告状态类名（"warning"）。
    static string StatusWarning() { return "warning"; }
    // 校验错误状态类名（"error"）。
    static string StatusError() { return "error"; }

    // 校验状态白名单归一：只认 success/warning/error，其余一律
    // 落回 ""（无状态）。设计器/绑定路径写进来的任意字符串先过
    // 这里，脏值不会长出一个没人认识的 class。
    static string StatusSanitize(string v) {
        if (v == Control.StatusSuccess() || v == Control.StatusWarning()
            || v == Control.StatusError()) { return v; }
        return "";
    }

    // 反射在 Zan 里没有：子类用 `new` 覆写 SizeOf 返回自己的
    // Size 绑定字段；基类返回 null。
    public virtual Binding<string> SizeOf() { return null; }

    // 双向绑定的统一拉取点：把外部 `Binding<T>` 的当前值拉进
    // 控件内部状态（model -> UI）。基类空实现；有绑定通道的
    // 控件 override。由 RenderTree 在每帧 OnPaint 前统一调用，
    // 控件不必在 OnPaint 开头自调（事件时机的回写仍走
    // `data.Set(...)`，与本契约无关）。契约见
    public virtual void SyncBinding() { }
}
