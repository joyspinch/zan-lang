    void InitControl(string n) {
        name = n;
        Class = "";
        prefW = 0;
        prefH = 0;
        mx = 0;
        my = 0;
        padL = 0;
        padT = 0;
        padR = 0;
        padB = 0;
        padSet = false;
        marL = 0;
        marT = 0;
        marR = 0;
        marB = 0;
        marSet = false;
        prefSet = false;
        gap = 0;
        visible = true;
        bx = 0;
        by = 0;
        bw = 0;
        bh = 0;
        parent = null;
        childNodes = new List<Control>();
        On = new WidgetEvents();
        commonId = 0;
        wiresOwnEvents = false;
        Tip = "";
        TipSide = "";
        lastBw = 0;
        lastBh = 0;
        lastVisible = false;
        everLaidOut = false;
        grow = false;
        Class = "";
        Disabled = false;
        computedStyle = null;
        computedStyleGen = 0 - 1;
        computedStyleScale = 0 - 1;
        computedStyleType = "";
        computedStyleClass = "";
        computedStyleCls = "";
        computedStyleId = "";
        computedStyleState = 0 - 1;
        computedStyleDep = 0;
        computedStyleRuleSig = 0 - 1;
        computedStyleCtxHash = 0L;
        childIndex = 0 - 1;
        styleTypeLower = "";
        styleSurfaceOwned = false;
    }
    public Control() { this.InitControl(""); }
    public Control(string n) { this.InitControl(n); }
    public virtual Control Add(Control c) {
        if (c != null && c.parent == this && this.IndexOf(c) >= 0) { return c; }
        if (!this.Adoptable(c)) { return c; }
        if (!this.Adopt(c)) { return c; }
        c.childIndex = childNodes.Count;
        childNodes.Add(c);
        childSnapCache = null;
        Control.NoteBindingStructureChanged();
        this.Invalidate();
        return c;
    }
    Control With(Control c) { this.Add(c); return this; }
    Control AddChildren(List<Control> list) {
        if (list == null) { return this; }
        for (int i = 0; i < list.Count; i = i + 1) {
            this.With(list[i]);
        }
        return this;
    }
    Control Width(int w) { return this.Prefer(w, prefH); }
    Control Height(int h) { return this.Prefer(prefW, h); }
    bool Adoptable(Control c) {
        if (c == null || c == this) { return false; }
        /* c 是本节点的祖先：挂进去就成环 */
        Control up = parent;
        for (int guard = 0; up != null && guard < 4096; guard = guard + 1) {
            if (up == c) { return false; }
            up = up.parent;
        }
        return true;
    }
    bool Adopt(Control c) {
        if (c.parent == this) { return true; }
        if (c.parent != null) { c.parent.Remove(c); }
        if (c.parent != null || !this.Adoptable(c)) { return false; }
        c.parent = this;
        c.InheritApp(this.FindApp());
        c.SpreadHostForm(this.HostForm());
        this.SpreadScopeTo(c);
        return true;
    }
    public virtual bool OwnsInnerScope() { return false; }
    public virtual string OwnScopeClass() { return ""; }
    string ScopeClass() {
        Control cur = this;
        while (cur != null) {
            if (cur.OwnsInnerScope()) { return cur.OwnScopeClass(); }
            if (cur.Class != "") {
                List<string> parts = Style.Classes(cur.Class);
                for (int i = 0; i < parts.Count; i = i + 1) {
                    string p = parts[i];
                    if (p.Length >= 3 && p[0] == 122 && p[1] == 115 && p[2] == 45) { return p; }
                }
            }
            cur = cur.parent;
        }
        return "";
    }
    void SpreadScopeTo(Control c) {
        if (c == null) { return; }
        string zs = this.ScopeClass();
        if (zs == "") { return; }
        c.InheritScope(zs);
    }
    void InheritScope(string zs) {
        if (this.Class != "" && Style.Has(this.Class, zs)) { return; }
        bool hasOtherScope = false;
        if (this.Class != "") {
            List<string> parts = Style.Classes(this.Class);
            for (int i = 0; i < parts.Count; i = i + 1) {
                string p = parts[i];
                if (p.Length >= 3 && p[0] == 122 && p[1] == 115 && p[2] == 45) {
                    hasOtherScope = true;
                    break;
                }
            }
        }
        if (!hasOtherScope) { this.AddClass(zs); }
        if (this.OwnsInnerScope()) { return; }
        for (int i = 0; i < childNodes.Count; i = i + 1) {
            childNodes[i].InheritScope(zs);
        }
    }
    // 本节点所在的窗口，尚未挂到任何窗口下时为 null。
    WindowRoot HostForm() {
        Control up = this;
        for (int guard = 0; up != null && guard < 4096; guard = guard + 1) {
            if (up is WindowRoot) { return (WindowRoot)up; }
            up = up.parent;
        }
        return null;
    }

    // 类 C# WinForms / WPF 风格的窗口与应用上下文上溯：挂树控件直接通过
    // this.FindForm() / this.FindApp() 访问宿主，无需外界手动 UseApp(app) 传递。
    WindowRoot FindForm() {
        return this.HostForm();
    }
    App FindApp() {
        if (this.app != null) { return this.app; }
        Control up = this.parent;
        for (int guard = 0; up != null && guard < 4096; guard = guard + 1) {
            if (up.app != null) { return up.app; }
            if (up is WindowRoot) {
                WindowRoot f = (WindowRoot)up;
                if (f.GetApp() != null) { return f.GetApp(); }
            }
            up = up.parent;
        }
        return null;
    }
    public App ResolveApp(App fallback) {
        if (fallback != null) { return fallback; }
        if (this.app != null) { return this.app; }
        App a = this.FindApp();
        if (a != null) { return a; }
        return App.FrameApp();
    }
    public Control UseApp(App host) {
        this.explicitApp = host != null;
        App inherited = host;
        if (inherited == null && this.parent != null) { inherited = this.parent.FindApp(); }
        this.SetHostApp(inherited);
        return this;
    }
    void SetHostApp(App host) {
        if (this.app != host) {
            this.app = host;
            this.computedStyle = null;
            this.paintedStyle = null;
            this.surfaceNormal = null;
            this.surfaceTarget = null;
            this.surfaceFrom = null;
            this.surfaceBlend = null;
            this.surfaceState = 0;
        }
        for (int i = 0; i < childNodes.Count; i = i + 1) {
            childNodes[i].InheritApp(host);
        }
    }
    void InheritApp(App host) {
        if (this.explicitApp) { return; }
        if (this.parent != null) {
            App parentHost = this.parent.FindApp();
            if (parentHost != null || host == null) { host = parentHost; }
        }
        this.SetHostApp(host);
    }
    // 挂到窗口树上时同步自动继承的上下文；显式覆盖由 UseApp 管理。
    public virtual void OnHostForm(WindowRoot f) {
        if (f != null && this.app == null) {
            this.InheritApp(f.GetApp());
        }
    }

    // 把宿主窗口沿子树发下去（收养时自动调用，一棵先建好的子树在
    // 挂上来的那一刻整棵都收到宿主）。
    void SpreadHostForm(WindowRoot f) {
        if (f == null) { return; }
        this.OnHostForm(f);
        for (int i = 0; i < childNodes.Count; i = i + 1) {
            childNodes[i].SpreadHostForm(f);
        }
    }
    Control Grow() {
        grow = true;
        computedStyle = null;
        this.Invalidate();
        return this;
    }
    Control Float(int left, int top) { return this.Place(left, top); }
    Control Named(string n) {
        name = n;
        computedStyle = null;
        Style.InvalidateChainCache();
        return this;
    }
    int IndexOf(Control c) {
        if (c == null) { return -1; }
        int hint = c.childIndex;
        if (hint >= 0 && hint < childNodes.Count && childNodes[hint] == c) {
            return hint;
        }
        for (int i = 0; i < childNodes.Count; i = i + 1) {
            if (childNodes[i] == c) {
                c.childIndex = i;
                return i;
            }
        }
        return -1;
    }
    private bool DetachChildIfOwned(Control c) {
        int idx = IndexOf(c);
        if (idx < 0 || c.parent != this) { return false; }
        childNodes.RemoveAt(idx);
        childSnapCache = null;
        c.parent = null;
        c.InheritApp(null);
        Control.NoteBindingStructureChanged();
        this.Invalidate();
        return true;
    }
    void Remove(Control c) {
        if (c == null || c.parent != this || IndexOf(c) < 0) { return; }
        App host = this.FindApp();
        List<InputRetirementToken> retiring = host != null
            ? host.SnapshotInputRetirements(c, null, false) : null;
        if (host != null) { host.CancelInputSubtree(c); }
        if (!this.DetachChildIfOwned(c)) { return; }
        if (host != null) {
            if (host.focus != null) { host.focus.ReconcileFocus(c); }
            host.NotifyInputRetirements(retiring, 0, false);
        }
    }
    public void RemoveChildren(List<Control> selected, Func<bool> canCommit) {
        List<Control> previous = new List<Control>();
        List<List<InputRetirementToken>> snapshots = new List<List<InputRetirementToken>>();
        App host = this.FindApp();
        for (int i = 0; i < selected.Count; i = i + 1) {
            Control child = selected[i];
            if (child == null || child.parent != this || IndexOf(child) < 0 || previous.Contains(child)) { continue; }
            previous.Add(child);
            if (host != null) { snapshots.Add(host.SnapshotInputRetirements(child, null, false)); }
        }
        for (int i = 0; i < previous.Count; i = i + 1) {
            if (canCommit != null && !canCommit()) { return; }
            Control child = previous[i];
            if (host != null && child.parent == this && IndexOf(child) >= 0) { host.CancelInputSubtree(child); }
            if (canCommit != null && !canCommit()) { return; }
        }
        List<InputRetirementToken> retiring = new List<InputRetirementToken>();
        for (int i = 0; i < previous.Count; i = i + 1) {
            if (this.DetachChildIfOwned(previous[i]) && host != null) { retiring.AddRange(snapshots[i]); }
        }
        if (host != null) {
            if (host.focus != null) { host.focus.ReconcileFocus(previous); }
            host.NotifyInputRetirements(retiring, 0, false);
        }
    }
    void RemoveAll() { this.RemoveChildren(childNodes, null); }
    void InsertAt(int idx, Control c) {
        if (c != null && c.parent == this && this.IndexOf(c) >= 0) {
            this.MoveChild(c, idx);
            return;
        }
        if (!this.Adoptable(c)) { return; }
        if (!this.Adopt(c)) { return; }
        int at = idx;
        if (at < 0) { at = 0; }
        if (at > childNodes.Count) { at = childNodes.Count; }
        childNodes.Insert(at, c);
        childSnapCache = null;
        Control.NoteBindingStructureChanged();
        this.Invalidate();
    }
    void MoveChild(Control c, int to) {
        int idx = IndexOf(c);
        if (idx < 0) { return; }
        childNodes.RemoveAt(idx);
        int at = to;
        if (at < 0) { at = 0; }
        if (at > childNodes.Count) { at = childNodes.Count; }
        childNodes.Insert(at, c);
        childSnapCache = null;
        Control.NoteBindingStructureChanged();
        this.Invalidate();
    }
    public void ReorderChildren(List<Control> ordered) {
        if (ordered == null || ordered.Count != childNodes.Count) {
            throw new ArgumentException("Child order must contain every current child once.");
        }
        bool changed = false;
        for (int i = 0; i < ordered.Count; i = i + 1) {
            if (childNodes[i] != ordered[i]) { changed = true; break; }
        }
        if (!changed) { return; }
        Dict<Control, bool> remaining = new Dict<Control, bool>();
        for (int i = 0; i < childNodes.Count; i = i + 1) { remaining.Add(childNodes[i], true); }
        for (int i = 0; i < ordered.Count; i = i + 1) {
            Control child = ordered[i];
            if (child == null || child.parent != this || !remaining.ContainsKey(child)) {
                throw new ArgumentException("Child order must contain every current child once.");
            }
            remaining.Remove(child);
        }
        for (int i = 0; i < ordered.Count; i = i + 1) {
            childNodes[i] = ordered[i];
            ordered[i].childIndex = i;
        }
        childSnapCache = null;
        Control.NoteBindingStructureChanged();
        this.Invalidate();
    }
    public virtual bool ChildInViewport(Control child) { return true; }
    public Control HitTest(int x, int y) { return this.HitTest(x, y, 0, null); }
    public Control HitTest(int x, int y, int pointerType) { return this.HitTest(x, y, pointerType, null); }
    public Control HitTest(int x, int y, List<Control> excludedSubtrees) {
        return this.HitTest(x, y, 0, excludedSubtrees);
    }
    public Control HitTest(int x, int y, int pointerType, List<Control> excludedSubtrees) {
        if (Control.HitTestExcluded(this, excludedSubtrees)) { return null; }
        Control hit = this.HitTestCore(x, y, pointerType, excludedSubtrees);
        return Control.HitTestExcluded(hit, excludedSubtrees) ? null : hit;
    }
    protected static bool HitTestExcluded(Control control, List<Control> excludedSubtrees) {
        if (control == null || excludedSubtrees == null || excludedSubtrees.Count == 0) { return false; }
        Control node = control;
        while (node != null) {
            if (excludedSubtrees.Contains(node)) { return true; }
            node = node.parent;
        }
        return false;
    }
    protected virtual Control HitTestCore(int x, int y, int pointerType, List<Control> excludedSubtrees) {
        if (!this.StyleVisible()) { return null; }
        if (!this.ContainsPoint(x, y, pointerType)) { return null; }
        if (this.ScrollBarHit(x, y) != 0) { return this; }
        int count = childNodes.Count;
        Control onlyChild = count == 1 ? childNodes[0] : null;
        List<Control> ordered = count > 1 ? this.PaintChildrenFast() : null;
        for (int i = count - 1; i >= 0; i = i - 1) {
            Control child = ordered != null ? ordered[i] : onlyChild;
            if (!this.ChildInViewport(child)) { continue; }
            Control hit = child.HitTest(x, y, pointerType, excludedSubtrees);
            if (hit != null) { return hit; }
        }
        return this;
    }
    public Control FindByName(string n) {
        if (n == "" || n == null) { return null; }
        if (name == n) { return this; }
        for (int i = 0; i < childNodes.Count; i = i + 1) {
            Control r = childNodes[i].FindByName(n);
            if (r != null) { return r; }
        }
        return null;
    }
    public Control Find(string n) {
        if (n == "" || n == null) { return null; }
        Control byName = this.FindByName(n);
        if (byName != null) { return byName; }
        return this.FindByText(n);
    }
    Control FindByText(string t) {
        if (this.GetProp("text") == t) { return this; }
        for (int i = 0; i < childNodes.Count; i = i + 1) {
            Control r = childNodes[i].FindByText(t);
            if (r != null) { return r; }
        }
        return null;
    }
    public int ChildCount() { return childNodes.Count; }
    public Control ChildAt(int index) { return childNodes[index]; }
    public List<Control> SnapshotChildren() {
        List<Control> snapshot = new List<Control>();
        snapshot.AddRange(childNodes);
        return snapshot;
    }
    internal List<Control> SnapshotChildrenCached() {
        if (childSnapCache == null) {
            List<Control> snapshot = new List<Control>();
            snapshot.AddRange(childNodes);
            childSnapCache = snapshot;
        }
        return childSnapCache;
    }
    public Control Parent() { return parent; }
    public virtual void OnPaint() { this.OnPaint(this.App); }
    public virtual void OnPaint(App app) {
    }
    public virtual void OnPaintOverlay() { this.OnPaintOverlay(this.App); }
    public virtual void OnPaintOverlay(App app) {
    }
    public virtual bool OnPopupEscape(App app) { return false; }
    public virtual void OnPopupDismissed() {
    }
    public virtual bool DismissOnOutsideClick() { return true; }
    public virtual bool NativePopupSelfOccludes() { return false; }
    public virtual void OnMeasure() { this.OnMeasure(this.App); }
    public virtual void OnMeasure(App app) {
    }
}
