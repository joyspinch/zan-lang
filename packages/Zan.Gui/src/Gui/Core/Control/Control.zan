    // 请求宿主整帧重绘（控件未挂到宿主时空操作）。控件不必自己 FindApp 再判空。
    public void RequestRedraw() {
        App owner = this.FindApp();
        if (owner != null) { owner.RequestRedraw(); }
    }

    // 精细化局部失效：仅将本控件当前占用的屏幕绝对矩形登记为脏区，
    // 激活局部帧条带管线（partialFrame），避免 3K/折叠大屏整窗无效重绘。
    public void Invalidate() {
        if (!visible || bw <= 0 || bh <= 0) { return; }
        App app = App.FrameApp();
        if (app == null) { return; }
        int outset = (this.extra != null && this.extra.styleShadow > 0) ? 8 : 2;
        app.Damage.NoteDamage(bx - outset, by - outset, bw + outset * 2, bh + outset * 2);
    }
    public void InvalidateRect(int rx, int ry, int rw, int rh) {
        if (!visible || rw <= 0 || rh <= 0) { return; }
        App app = App.FrameApp();
        if (app == null) { return; }
        int x = bx + rx;
        int y = by + ry;
        app.Damage.NoteDamage(x - 2, y - 2, rw + 4, rh + 4);
    }
    public string EffectiveA11yRole(string fallback) {
        if (this.extra != null && this.extra.a11yRole.Length > 0) { return this.extra.a11yRole; }
        return fallback;
    }
    public string EffectiveA11yLabel(string fallback) {
        if (this.extra != null && this.extra.a11yLabel.Length > 0) { return this.extra.a11yLabel; }
        return fallback;
    }
