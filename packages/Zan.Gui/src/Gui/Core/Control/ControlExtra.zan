using System;
using System.Collections.Generic;

namespace Gui;

public class ControlExtra {
    public ControlChildren childrenView;
    public int popupEpoch;
    public List<ModelBindingDeclaration> bindings;
    public List<PropSpec> propertySpecs;
    public int propertySchemaKey;
    public string baseClass;
    public string handlerArg;
    public string slotName;
    public string bindMount;
    public List<EventBinding> events;

    public int styleBg;
    public int styleBgTo;
    public int styleRadius;
    public int styleCorners;
    public int styleBorderColor;
    public int styleBorderWidth;
    public int styleShadow;
    public int styleShadowDy;
    public int styleColor;
    public int styleFontPx;
    public int styleTransitionMs;
    public string inlineStyleCss;

    public UiEvent Paint;
    public UiEvent Resize;
    public UiEvent Show;
    public UiEvent Hide;
    public UiEvent Click;

    public int flexWrapMain;
    public int flexMeasMain;
    public int hintWrapW;
    public List<FloatIntrusion> hostFloats;
    public bool layoutFlow;

    public string a11yRole;
    public string a11yLabel;

    public int hitSlopT;
    public int hitSlopR;
    public int hitSlopB;
    public int hitSlopL;
    public int minTouchSize;

    public ControlExtra() {
        this.baseClass = "";
        this.handlerArg = "";
        this.slotName = "";
        this.bindMount = "";
        this.inlineStyleCss = "";
        this.a11yRole = "";
        this.a11yLabel = "";
        this.hitSlopT = 0;
        this.hitSlopR = 0;
        this.hitSlopB = 0;
        this.hitSlopL = 0;
        this.minTouchSize = 0;
    }
}
