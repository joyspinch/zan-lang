using System;
using System.Collections.Generic;
using Gui;
namespace Gui;
public partial class Control {
    private List<int> flexSizeBuf;
    private List<int> flexFloorBuf;
    void MeasureFlexContent(App app) {
        if (prefW > 0 && prefH > 0) { return; }
        bool row = this.StyleFlexDir() != 1;
        StyleBox cs = computedStyle;
        int baseGap = cs != null && cs.gap >= 0 ? cs.gap : gap;
        int colGap = cs != null && cs.colGap >= 0 ? cs.colGap : baseGap;
        int rowGap = cs != null && cs.rowGap >= 0 ? cs.rowGap : baseGap;
        int mainGap = row ? colGap : rowGap;
        int crossGap = row ? rowGap : colGap;
        int wrapMode = cs != null ? cs.wrap : 0;
        int wrapMain = 0;
        if (wrapMode != 0) {
            wrapMain = flexWrapMain;
            if (row && hintWrapW > 0) { wrapMain = hintWrapW - this.StyleInsetL() - this.StyleInsetR(); }
            if (row && prefW > 0) {
                wrapMain = prefW - this.StyleInsetL() - this.StyleInsetR();
            } else if (!row && prefH > 0) {
                wrapMain = prefH - this.StyleInsetT() - this.StyleInsetB();
            }
            if (row && measureWidth >= 0) { wrapMain = this.WrapContentWidth(); }
        }
        int onLine = 0;
        int lineMain = 0;
        int lineCross = 0;
        int mainMax = 0;
        int crossSum = 0;
        int lines = 0;
        List<Control> flexKids = this.FlexKids();
        int kidCount = flexKids.Count;
        if (app != null && !measureIntrinsic && row && wrapMode == 0 && measureWidth >= 0) {
            bool anyDep = false;
            for (int k = 0; k < kidCount; k = k + 1) {
                if (flexKids[k].measureDependsOnWidth) { anyDep = true; break; }
            }
            if (anyDep) {
                int available = this.WrapContentWidth();
                if (available < 0) { available = 0; }
                List<int> allocated = this.FlexLineSizes(flexKids, 0, kidCount, available, 0, mainGap, true);
                bool widthChanged = false;
                for (int k = 0; k < kidCount; k = k + 1) {
                    if (flexKids[k].measureDependsOnWidth) {
                        int prevW = flexKids[k].prefW;
                        flexKids[k].MeasureTree(app, allocated[k]);
                        if (flexKids[k].prefW != prevW) { widthChanged = true; }
                    }
                }
                if (widthChanged) {
                    List<int> settled = this.FlexLineSizes(flexKids, 0, kidCount, available, 0, mainGap, true);
                    for (int k = 0; k < kidCount; k = k + 1) {
                        if (flexKids[k].measureDependsOnWidth && settled[k] != allocated[k]) {
                            flexKids[k].MeasureTree(app, settled[k]);
                        }
                    }
                }
            }
        }
        for (int i = 0; i < kidCount; i = i + 1) {
            Control c = flexKids[i];
            StyleBox ccs = c.computedStyle;
            int m = row ? c.prefW : c.prefH;
            int cr = row ? c.prefH : c.prefW;
            if (ccs != null) {
                if (ccs.basis >= 0 || ccs.basisPm >= 0) {
                    int bs = ccs.BasisIn(wrapMain);
                    if (bs >= 0) { m = bs; }
                } else if (row) {
                    if (ccs.width >= 0 || ccs.widthPm >= 0 || ccs.minW >= 0 || ccs.minWPm >= 0 || ccs.maxW >= 0 || ccs.maxWPm >= 0) {
                        int bs = c.StyleWidthIn(wrapMain);
                        if (bs >= 0) { m = bs; }
                    }
                } else {
                    if (ccs.height >= 0 || ccs.heightPm >= 0 || ccs.minH >= 0 || ccs.minHPm >= 0 || ccs.maxH >= 0 || ccs.maxHPm >= 0) {
                        int bs = c.StyleHeightIn(wrapMain);
                        if (bs >= 0) { m = bs; }
                    }
                }
                if (row) {
                    if (ccs.height >= 0 || ccs.heightPm >= 0 || ccs.minH >= 0 || ccs.minHPm >= 0 || ccs.maxH >= 0 || ccs.maxHPm >= 0) {
                        int ch2 = c.StyleHeightIn(0);
                        if (ch2 >= 0) { cr = ch2; }
                    }
                } else {
                    if (ccs.width >= 0 || ccs.widthPm >= 0 || ccs.minW >= 0 || ccs.minWPm >= 0 || ccs.maxW >= 0 || ccs.maxWPm >= 0) {
                        int cw2 = c.StyleWidthIn(0);
                        if (cw2 >= 0) { cr = cw2; }
                    }
                }
            }
            int marH = c.marSet ? (c.marL + c.marR) : (ccs != null ? ((ccs.marL > 0 ? ccs.marL : 0) + (ccs.marR > 0 ? ccs.marR : 0)) : 0);
            int marV = c.marSet ? (c.marT + c.marB) : (ccs != null ? ((ccs.marT > 0 ? ccs.marT : 0) + (ccs.marB > 0 ? ccs.marB : 0)) : 0);
            m = m + (row ? marH : marV);
            cr = cr + (row ? marV : marH);
            int need = m;
            if (onLine > 0) { need = need + mainGap; }
            if (wrapMain > 0 && onLine > 0 && lineMain + need > wrapMain) {
                if (lineMain > mainMax) { mainMax = lineMain; }
                crossSum = crossSum + lineCross;
                lines = lines + 1;
                lineMain = m;
                lineCross = cr;
                onLine = 1;
            } else {
                lineMain = lineMain + need;
                if (cr > lineCross) { lineCross = cr; }
                onLine = onLine + 1;
            }
        }
        if (onLine == 0) { return; }
        if (lineMain > mainMax) { mainMax = lineMain; }
        crossSum = crossSum + lineCross;
        lines = lines + 1;
        int lh = cs != null ? (cs.lineHeightKind == 2 ? (int)((long)cs.lineHeight * (long)(cs.fontPx > 0 ? cs.fontPx : cs.envRemPx) / 1000) : cs.lineHeight) : 0;
        if (lh > 0 && lh * lines > crossSum) { crossSum = lh * lines; }
        if (lines > 1) { crossSum = crossSum + crossGap * (lines - 1); }
        int bwBase = cs != null && cs.borderW >= 0 ? cs.borderW : 0;
        if (row) {
            if (prefW <= 0 && mainMax > 0) {
                int inL = (padSet ? padL : (cs != null && cs.padL >= 0 ? cs.padL : padL)) + (cs != null ? (cs.borderLeftW >= 0 ? cs.borderLeftW : bwBase) : 0);
                int inR = (padSet ? padR : (cs != null && cs.padR >= 0 ? cs.padR : padR)) + (cs != null ? (cs.borderRightW >= 0 ? cs.borderRightW : bwBase) : 0);
                prefW = mainMax + inL + inR;
                this.fillW = true;
            }
            if (prefH <= 0 && crossSum > 0) {
                int inT = this.StylePadT() + (cs != null ? (cs.borderTopW >= 0 ? cs.borderTopW : bwBase) : 0);
                int inB = (padSet ? padB : (cs != null && cs.padB >= 0 ? cs.padB : padB)) + (cs != null ? (cs.borderBottomW >= 0 ? cs.borderBottomW : bwBase) : 0);
                prefH = crossSum + inT + inB;
                this.fillH = true;
            }
        } else {
            if (prefH <= 0 && mainMax > 0) {
                int inT = this.StylePadT() + (cs != null ? (cs.borderTopW >= 0 ? cs.borderTopW : bwBase) : 0);
                int inB = (padSet ? padB : (cs != null && cs.padB >= 0 ? cs.padB : padB)) + (cs != null ? (cs.borderBottomW >= 0 ? cs.borderBottomW : bwBase) : 0);
                prefH = mainMax + inT + inB;
                this.fillH = true;
            }
            if (prefW <= 0 && crossSum > 0) {
                int inL = (padSet ? padL : (cs != null && cs.padL >= 0 ? cs.padL : padL)) + (cs != null ? (cs.borderLeftW >= 0 ? cs.borderLeftW : bwBase) : 0);
                int inR = (padSet ? padR : (cs != null && cs.padR >= 0 ? cs.padR : padR)) + (cs != null ? (cs.borderRightW >= 0 ? cs.borderRightW : bwBase) : 0);
                prefW = crossSum + inL + inR;
                this.fillW = true;
            }
        }
        if (wrapMode != 0 && flexMeasMain != flexWrapMain) {
            flexMeasMain = flexWrapMain;
            app.RequestRedraw();
        }
    }
    List<Control> FlexKids() { return this.PlannedChildren(false, false); }
    bool ArrangeFlex(int cx, int cy, int cw, int ch, int gapPx) {
        bool row = this.StyleFlexDir() != 1;
        StyleBox cs = computedStyle;
        int colGap = cs != null && cs.colGap >= 0 ? cs.colGap : (cs != null && cs.gap >= 0 ? cs.gap : gapPx);
        int rowGap = cs != null && cs.rowGap >= 0 ? cs.rowGap : (cs != null && cs.gap >= 0 ? cs.gap : gapPx);
        int mainBox = row ? cw : ch;
        int crossBox = row ? ch : cw;
        int mainGap = row ? colGap : rowGap;
        int crossGap = row ? rowGap : colGap;
        bool anyPos;
        List<Control> items = this.FlexKidsAndPos(out anyPos);
        int n = items.Count;
        if (n == 0) { return anyPos; }
        if (cs == null || cs.wrap == 0) {
            this.ArrangeFlexLine(items, cx, cy, cw, ch, mainGap, row, 0, crossBox);
            return anyPos;
        }
        flexWrapMain = mainBox;
        List<int> lineFrom = new List<int>();
        List<int> lineTo = new List<int>();
        List<int> lineCross = new List<int>();
        int declaredLineH = this.StyleLineHeight();
        int idx = 0;
        while (idx < n) {
            int start = idx;
            int lineMain = 0;
            int maxCross = 0;
            while (idx < n) {
                Control c = items[idx];
                int m = c.StyleHeightIn(ch);
                int cr = c.StyleWidthIn(cw);
                if (row) {
                    m = c.StyleWidthIn(cw);
                    cr = c.StyleHeightIn(ch);
                }
                if (m < 0) { m = 0; }
                m = m + c.MarMain(row);
                cr = cr + c.MarCross(row);
                int need = m;
                if (idx > start) { need = need + mainGap; }
                if (idx > start && lineMain + need > mainBox) { break; }
                lineMain = lineMain + need;
                if (cr > maxCross) { maxCross = cr; }
                idx = idx + 1;
            }
            if (declaredLineH > maxCross) { maxCross = declaredLineH; }
            lineFrom.Add(start);
            lineTo.Add(idx);
            lineCross.Add(maxCross);
        }
        int lines = lineFrom.Count;
        int crossUsed = 0;
        for (int li = 0; li < lines; li = li + 1) {
            crossUsed = crossUsed + lineCross[li];
        }
        if (lines > 1) { crossUsed = crossUsed + crossGap * (lines - 1); }
        int crossFree = crossBox - crossUsed;
        if (crossFree < 0) { crossFree = 0; }
        int crossOff = 0;
        int between = crossGap;
        int stretch = 0;
        int ac = this.StyleAlignContent();
        if (ac == 1) { crossOff = crossFree / 2; }
        else if (ac == 2) { crossOff = crossFree; }
        else if (ac == 3 && lines > 1) {
            between = between + crossFree / (lines - 1);
        } else if (ac == 4 && lines > 0) {
            int slot = crossFree / lines;
            crossOff = slot / 2;
            between = between + slot;
        } else if (ac == 5) { stretch = crossFree / lines; }
        else if (ac == 6) {
            crossOff = crossFree / (lines + 1);
            between = between + crossOff;
        }
        for (int li = 0; li < lines; li = li + 1) {
            int lc = lineCross[li] + stretch;
            this.ArrangeFlexLineSlice(items, lineFrom[li], lineTo[li], cx, cy, cw, ch, mainGap, row, crossOff, lc);
            crossOff = crossOff + lc + between;
        }
        return anyPos;
    }
    void ArrangeFlexLine(List<Control> items, int cx, int cy, int cw, int ch,
                         int gapPx, bool row, int crossOff, int crossBox) {
        if (items == null) { return; }
        this.ArrangeFlexLineSlice(items, 0, items.Count, cx, cy, cw, ch, gapPx, row, crossOff, crossBox);
    }
    private List<int> FlexLineSizes(List<Control> items, int start, int end, int cw, int ch, int gapPx, bool row) {
        List<int> sizes = new List<int>();
        this.FlexLineSizesInto(items, start, end, cw, ch, gapPx, row, sizes);
        return sizes;
    }
    private void FlexLineSizesInto(List<Control> items, int start, int end, int cw, int ch, int gapPx, bool row, List<int> sizes) {
        int n = end - start;
        int mainBox = row ? cw : ch;
        sizes.Clear();
        int used = 0;
        int totalGrow = 0;
        int i = 0;
        while (i < n) {
            Control c = items[start + i];
            StyleBox ccs = c.computedStyle;
            int sz;
            if (ccs == null) {
                sz = row ? c.prefW : c.prefH;
            } else if (ccs.basis >= 0 || ccs.basisPm >= 0) {
                sz = ccs.BasisIn(mainBox);
                if (sz < 0) { sz = row ? c.StyleWidthIn(cw) : c.StyleHeightIn(ch); }
            } else if (row) {
                sz = (ccs.width < 0 && ccs.widthPm < 0 && ccs.minW < 0 && ccs.minWPm < 0 && ccs.maxW < 0 && ccs.maxWPm < 0)
                    ? c.prefW : c.StyleWidthIn(cw);
            } else {
                sz = (ccs.height < 0 && ccs.heightPm < 0 && ccs.minH < 0 && ccs.minHPm < 0 && ccs.maxH < 0 && ccs.maxHPm < 0)
                    ? c.prefH : c.StyleHeightIn(ch);
            }
            if (sz < 0) { sz = 0; }
            sizes.Add(sz);
            int marM = row
                ? (c.marSet ? (c.marL + c.marR) : (ccs != null ? ((ccs.marL > 0 ? ccs.marL : 0) + (ccs.marR > 0 ? ccs.marR : 0)) : 0))
                : (c.marSet ? (c.marT + c.marB) : (ccs != null ? ((ccs.marT > 0 ? ccs.marT : 0) + (ccs.marB > 0 ? ccs.marB : 0)) : 0));
            used = used + sz + marM;
            if (ccs != null) { totalGrow = totalGrow + ccs.grow; }
            i = i + 1;
        }
        int gaps = 0;
        if (n > 1) { gaps = (n - 1) * gapPx; }
        int free = mainBox - used - gaps;
        if (free > 0 && totalGrow > 0) {
            int pass = 0;
            while (pass < 2 && free > 0) {
                int share = free;
                int growable = 0;
                int lastGrow = 0 - 1;
                i = 0;
                while (i < n) {
                    int g = items[start + i].StyleGrow();
                    if (g > 0) { growable = growable + g; lastGrow = i; }
                    i = i + 1;
                }
                if (growable == 0) { pass = 2; }
                else {
                    int taken = 0;
                    int handed = 0;
                    i = 0;
                    while (i < n) {
                        Control ci = items[start + i];
                        int g = ci.StyleGrow();
                        if (g > 0) {
                            int add = share * g / growable;
                            if (i == lastGrow) { add = share - handed; }
                            handed = handed + add;
                            int want = sizes[i] + add;
                            int got = want;
                            if (row) { got = ci.StyleClampW(cw, want); }
                            else { got = ci.StyleClampH(ch, want); }
                            taken = taken + got - sizes[i];
                            sizes[i] = got;
                        }
                        i = i + 1;
                    }
                    free = free - taken;
                    if (taken == 0) { pass = 2; }
                    pass = pass + 1;
                }
            }
            if (free < 0) { free = 0; }
        } else if (free < 0 && used > 0) {
            bool canScrollMain = row ? (this.StyleOverflowX() >= 2) : (this.StyleOverflowY() >= 2);
            if (!canScrollMain) {
                int marTotal = 0;
                int fixedMain = 0;
                int flexMain = 0;
                i = 0;
                while (i < n) {
                    Control ci = items[start + i];
                    marTotal = marTotal + ci.MarMain(row);
                    if (ci.StyleShrink() == 0) {
                        fixedMain = fixedMain + sizes[i];
                    } else {
                        flexMain = flexMain + sizes[i];
                    }
                    i = i + 1;
                }
                int room = mainBox - gaps - marTotal - fixedMain;
                if (room < 0) { room = 0; }
                if (flexMain > 0) {
                    List<int> floors = flexFloorBuf;
                    flexFloorBuf = null;
                    if (floors == null) { floors = new List<int>(); }
                    else { floors.Clear(); }
                    int give = room;
                    i = 0;
                    while (i < n) {
                        int f = 0;
                        Control child = items[start + i];
                        if (child.StyleShrink() != 0) {
                            StyleBox style = child.computedStyle;
                            bool explicitMin = style != null && (row
                                ? (style.minW >= 0 || style.minWPm >= 0)
                                : (style.minH >= 0 || style.minHPm >= 0));
                            int minimum = explicitMin ? 0 : child.MinContentMain(row);
                            if (row) { f = child.StyleClampW(cw, minimum); }
                            else { f = child.StyleClampH(ch, minimum); }
                            if (f > sizes[i]) { f = sizes[i]; }
                            give = give - sizes[i];
                        }
                        floors.Add(f);
                        i = i + 1;
                    }
                    int guard = 0;
                    while (give < 0 && guard <= n) {
                        guard = guard + 1;
                        int pool = 0;
                        int lastGive = 0 - 1;
                        i = 0;
                        while (i < n) {
                            if (items[start + i].StyleShrink() != 0
                                && sizes[i] - floors[i] > 0) {
                                pool = pool + sizes[i] - floors[i];
                                lastGive = i;
                            }
                            i = i + 1;
                        }
                        if (pool <= 0) { break; }
                        int taken = 0;
                        i = 0;
                        while (i < n) {
                            if (items[start + i].StyleShrink() != 0
                                && sizes[i] - floors[i] > 0) {
                                int cut = give * (sizes[i] - floors[i]) / pool;
                                if (i == lastGive) { cut = give + taken; }
                                int want = sizes[i] + cut;
                                if (want < floors[i]) { want = floors[i]; }
                                taken = taken + sizes[i] - want;
                                sizes[i] = want;
                            }
                            i = i + 1;
                        }
                        give = give + taken;
                    }
                    if (flexFloorBuf == null) {
                        floors.Clear();
                        flexFloorBuf = floors;
                    }
                }
            }
            free = 0;
        }
    }
    void ArrangeFlexLineSlice(List<Control> items, int start, int end, int cx, int cy, int cw, int ch,
                              int gapPx, bool row, int crossOff, int crossBox) {
        int n = end - start;
        if (n <= 0) { return; }
        int mainBox = cw;
        if (!row) { mainBox = ch; }
        List<int> sizes = flexSizeBuf;
        flexSizeBuf = null;
        if (sizes == null) { sizes = new List<int>(); }
        this.FlexLineSizesInto(items, start, end, cw, ch, gapPx, row, sizes);
        int used = n > 1 ? (n - 1) * gapPx : 0;
        for (int k = 0; k < n; k = k + 1) {
            Control ck = items[start + k];
            StyleBox ckcs = ck.computedStyle;
            int marK = row
                ? (ck.marSet ? (ck.marL + ck.marR) : (ckcs != null ? ((ckcs.marL > 0 ? ckcs.marL : 0) + (ckcs.marR > 0 ? ckcs.marR : 0)) : 0))
                : (ck.marSet ? (ck.marT + ck.marB) : (ckcs != null ? ((ckcs.marT > 0 ? ckcs.marT : 0) + (ckcs.marB > 0 ? ckcs.marB : 0)) : 0));
            used = used + sizes[k] + marK;
        }
        int free = mainBox - used;
        if (free < 0) { free = 0; }
        int i = 0;
        int offset = 0;
        int between = gapPx;
        StyleBox cs = computedStyle;
        int justify = cs != null ? cs.justify : 0;
        if (justify == 1) { offset = free / 2; }
        else if (justify == 2) { offset = free; }
        else if (justify == 3 && n > 1) { between = between + free / (n - 1); }
        else if (justify == 4 && n > 0) {
            int slot = free / n;
            offset = slot / 2;
            between = between + slot;
        } else if (justify == 5) {
            int slots = n + 1;
            offset = free / slots;
            between = between + offset;
        }
        int align = cs != null ? cs.alignItems : 0;
        bool rev = this.StyleFlexReverse();
        int pos = offset;
        i = 0;
        while (i < n) {
            Control c = items[start + i];
            StyleBox ccs = c.computedStyle;
            int main = sizes[i];
            int ml = c.marSet ? c.marL : (ccs != null && ccs.marL > 0 ? ccs.marL : 0);
            int mr = c.marSet ? c.marR : (ccs != null && ccs.marR > 0 ? ccs.marR : 0);
            int mt = c.marSet ? c.marT : (ccs != null && ccs.marT > 0 ? ccs.marT : 0);
            int mb = c.marSet ? c.marB : (ccs != null && ccs.marB > 0 ? ccs.marB : 0);
            int marMain = row ? (ml + mr) : (mt + mb);
            int marCross = row ? (mt + mb) : (ml + mr);
            int crossAvail = crossBox - marCross;
            if (crossAvail < 0) { crossAvail = 0; }
            int cross;
            bool declaresCross;
            if (ccs == null) {
                cross = row ? c.prefH : c.prefW;
                declaresCross = false;
            } else if (row) {
                declaresCross = ccs.height >= 0 || ccs.heightPm >= 0;
                cross = (declaresCross || ccs.minH >= 0 || ccs.minHPm >= 0 || ccs.maxH >= 0 || ccs.maxHPm >= 0)
                    ? c.StyleHeightIn(ch) : c.prefH;
            } else {
                declaresCross = ccs.width >= 0 || ccs.widthPm >= 0;
                cross = (declaresCross || ccs.minW >= 0 || ccs.minWPm >= 0 || ccs.maxW >= 0 || ccs.maxWPm >= 0)
                    ? c.StyleWidthIn(cw) : c.prefW;
            }
            int ratio = ccs != null ? ccs.aspect : 0;
            if (ratio > 0 && !declaresCross) {
                if (row) { cross = main * 1000 / ratio; }
                else { cross = main * ratio / 1000; }
                declaresCross = true;
            }
            int al = ccs != null ? ccs.alignSelf : (0 - 1);
            if (al < 0) { al = align; }
            if (cross > crossAvail) { cross = crossAvail; }
            if (al == 0 && !declaresCross) { cross = crossAvail; }
            if (cross <= 0) { cross = crossAvail; }
            int crossPos = 0;
            if (al == 2) { crossPos = (crossAvail - cross) / 2; }
            else if (al == 3) { crossPos = crossAvail - cross; }
            int itemPos = rev ? (mainBox - pos - main - marMain) : pos;
            if (row) {
                c.Arrange(cx + itemPos + ml, cy + crossOff + crossPos + mt, main, cross);
            } else {
                c.Arrange(cx + crossOff + crossPos + ml, cy + itemPos + mt, cross, main);
            }
            pos = pos + main + marMain + between;
            i = i + 1;
        }
        if (flexSizeBuf == null) {
            sizes.Clear();
            flexSizeBuf = sizes;
        }
    }
    int StyleClampW(int avail, int v) {
        if (computedStyle == null) { return v; }
        return computedStyle.ClampWIn(avail, v);
    }
    int StyleClampH(int avail, int v) {
        if (computedStyle == null) { return v; }
        return computedStyle.ClampHIn(avail, v);
    }
    int MarMain(bool row) {
        if (row) { return this.StyleMarL() + this.StyleMarR(); }
        return this.StyleMarT() + this.StyleMarB();
    }
    int MarCross(bool row) {
        if (row) { return this.StyleMarT() + this.StyleMarB(); }
        return this.StyleMarL() + this.StyleMarR();
    }
}
