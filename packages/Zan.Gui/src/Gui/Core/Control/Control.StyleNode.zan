using System;
namespace Gui;
public partial class Control {
    public override StyleNode StyleParentNode() { return parent; }
    public override int StyleChildCount() { return this.ChildCount(); }
    public override StyleNode StyleChildNodeAt(int index) { return this.ChildAt(index); }
    public override int StyleIndexOfNode(StyleNode child) {
        Control c = child != null ? (Control)child : null;
        return this.IndexOf(c);
    }
    public override string StyleNodeName() { return name; }
    public override int StyleSurfaceState() { return this.SurfaceState(this.App); }
    public override string InlineStyleCss() { return inlineStyleCss; }
    public override void SetInlineStyleCss(string css) {
        inlineStyleCss = css;
        computedStyle = null;
    }
    public override void SetStylePad(int p) { this.Pad(p); }
    public override void SetStyleGap(int g) { gap = g; }
    public override void SetStyleX(int x) { mx = x; }
    public override void SetStyleY(int y) { my = y; }
    public override void SetStylePrefW(int w) { prefW = w; }
    public override void SetStylePrefH(int h) { prefH = h; }
    public override void ApplyVisualStyleBox(StyleBox b) {
        if (b == null) { return; }
        if (b.bg != 0) { styleBg = b.bg; }
        if (b.bgTo != 0) { styleBgTo = b.bgTo; }
        if (b.radius >= 0) { styleRadius = b.radius; }
        if (b.borderColor != 0) { styleBorderColor = b.borderColor; }
        if (b.borderW >= 0) { styleBorderWidth = b.borderW; }
        if (b.shadow != 0) {
            styleShadow = b.shadow;
            styleShadowDy = b.shadowDy;
            if (styleShadowDy == 0) { styleShadowDy = 2; }
        }
        if (b.fg != 0) { styleColor = b.fg; }
        if (b.fontPx > 0) { styleFontPx = b.fontPx; }
        if (b.transitionMs >= 0) { styleTransitionMs = b.transitionMs; }
    }
    public override void ApplyInlineOverridesTo(StyleBox b) {
        if (b == null) { return; }
        if (grow) { b.grow = 1; }
        if (!this.HasExtra()) { return; }
        if (styleBg != 0) { b.bg = styleBg; b.bgTo = styleBgTo; }
        if (styleRadius != 0) {
            b.SetRadius(b.ScaleLogical(styleRadius));
            b.SetPrescaled(StyleBox.SourceRadius() | StyleBox.SourceRadiusTL()
                | StyleBox.SourceRadiusTR() | StyleBox.SourceRadiusBR()
                | StyleBox.SourceRadiusBL(), true);
        }
        if (styleCorners != 0) { b.SetCorners(styleCorners); }
        if (styleBorderColor != 0) { b.borderColor = styleBorderColor; }
        if (styleBorderWidth != 0) {
            b.borderW = b.ScaleLogical(styleBorderWidth);
            b.SetPrescaled(StyleBox.SourceBorder(), true);
        }
        if (styleShadow != 0) {
            b.shadow = styleShadow;
            b.shadowDy = styleShadowDy;
            b.SetPrescaled(StyleBox.SourceShadowDy(), false);
        }
        if (styleColor != 0) { b.fg = styleColor; b.foregroundDeclared = true; }
        if (styleFontPx != 0) {
            b.fontPx = b.ScaleLogical(styleFontPx);
            b.SetPrescaled(StyleBox.SourceFont(), true);
        }
        if (styleTransitionMs != 0) { b.transitionMs = styleTransitionMs; }
    }
    public override void ApplyMotionOverridesTo(StyleBox b) {
        if (b == null || this.extra == null || !this.extra.motionActive) { return; }
        b.tx = b.tx + this.extra.motionTx;
        b.ty = b.ty + this.extra.motionTy;
        if (this.extra.motionScale != 1000 && this.extra.motionScale > 0) {
            int sc = (int)((long)b.scale * (long)this.extra.motionScale / 1000);
            b.scale = sc > 50 ? sc : 50;
        }
        b.rotate = b.rotate + this.extra.motionRotate;
        if (this.extra.motionOpacity < 1000) {
            int op = this.extra.motionOpacity;
            if (op < 0) { op = 0; }
            b.opacity = (int)((long)b.opacity * (long)op / 1000);
        }
    }
    public override void SetInlineBg(int bg, int bgTo) {
        styleBg = bg;
        styleBgTo = bgTo;
    }
    public override void SetInlineBorder(int width, int color) {
        styleBorderWidth = width;
        styleBorderColor = color;
    }
}
