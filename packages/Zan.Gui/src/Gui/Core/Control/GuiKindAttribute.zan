using System;

namespace Gui;

public class GuiKindAttribute {
    public string Kind { get; set; }
    public TypeInfo TargetType { get; set; }

    public GuiKindAttribute(string kind) {
        this.Kind = kind;
    }

    public GuiKindAttribute(string kind, TypeInfo targetType) {
        this.Kind = kind;
        this.TargetType = targetType;
    }
}

public class GuiKindManifestAttribute {
    public string Mode { get; set; }

    public GuiKindManifestAttribute(string mode) {
        this.Mode = mode;
    }
}
