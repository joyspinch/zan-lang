using System;
using System.Collections.Generic;
using Gui;
using Gui.Diagnostics;
namespace Gui;
public partial class Control {
    public static void SetDebugOverlap(bool enabled) { LayoutLintDiagnostics.SetDebugOverlap(enabled); }
    public static void SetDebugLayoutLint(bool enabled) { LayoutLintDiagnostics.SetDebugLayoutLint(enabled); }
    static bool OverlapActive() { return LayoutLintDiagnostics.OverlapActive(); }
    bool overlapExempt;
    void NoOverlapCheck() { overlapExempt = true; }
    static int OverlapHits() { return LayoutLintDiagnostics.OverlapHits(); }
    static void ResetOverlapHits() { LayoutLintDiagnostics.ResetOverlapHits(); }
    void CheckOverlapKids() {
        if (!OverlapActive()) { return; }
        if (childNodes == null || childNodes.Count == 0) { return; }
        int n = childNodes.Count;
        for (int i = 0; i < n; i = i + 1) {
            Control a = childNodes[i];
            if (!a.StyleVisible() || a.overlapExempt) { continue; }
            int ar = a.bx + a.bw;
            int ab = a.by + a.bh;
            for (int j = i + 1; j < n; j = j + 1) {
                Control b = childNodes[j];
                if (!b.StyleVisible() || b.overlapExempt) { continue; }
                int ix = (ar < b.bx + b.bw ? ar : b.bx + b.bw)
                    - (a.bx > b.bx ? a.bx : b.bx);
                int iy = (ab < b.by + b.bh ? ab : b.by + b.bh)
                    - (a.by > b.by ? a.by : b.by);
                if (ix > 1 && iy > 1) { this.ReportOverlap(a, b, ix, iy); }
            }
        }
    }
    void ReportOverlap(Control a, Control b, int ix, int iy) {
        string sig = this.Kind()
            + "|" + a.Kind() + "@" + Convert.ToString(a.bx) + ","
            + Convert.ToString(a.by) + "+" + Convert.ToString(a.bw)
            + "x" + Convert.ToString(a.bh)
            + "|" + b.Kind() + "@" + Convert.ToString(b.bx) + ","
            + Convert.ToString(b.by) + "+" + Convert.ToString(b.bw)
            + "x" + Convert.ToString(b.bh);
        LayoutLintDiagnostics.RecordOverlap(sig, this.Kind(), a.Kind(), a.bx, a.by, a.bw, a.bh,
                                            b.Kind(), b.bx, b.by, b.bw, b.bh, ix, iy);
    }
    static bool LintActive() { return LayoutLintDiagnostics.LintActive(); }
    void FreeLayout() { overlapExempt = true; }
    public virtual bool LintLeafSize() { return false; }
    void CheckKidsLayout() {
        this.CheckOverlapKids();
        this.CheckKidsSizes();
        this.CheckInvalidManualCoords();
    }
    void CheckInvalidManualCoords() {
        if (!LintActive()) { return; }
        if (childNodes == null || childNodes.Count == 0) { return; }
        for (int i = 0; i < childNodes.Count; i = i + 1) {
            Control c = childNodes[i];
            if (!c.StyleVisible() || c.overlapExempt) { continue; }
            if (c.mx == 0 && c.my == 0) { continue; }
            if (c.StylePosition() == 2) { continue; } // absolute/fixed 脱流合法
            bool autoParent = this.StyleDisplay() != 0;
            if (autoParent) {
                this.ReportLint(c, "无效坐标",
                    "在自动容器下手动设置了 (x="
                    + Convert.ToString(c.mx) + ", y=" + Convert.ToString(c.my)
                    + ")，坐标被完全忽略。请移除 Place()/Float()，改用父级 Gap、Padding 或对齐");
            }
        }
    }
    static int LintHits() { return LayoutLintDiagnostics.LintHits(); }
    static void ResetLintHits() { LayoutLintDiagnostics.ResetLintHits(); }
    void CheckKidsSizes() {
        if (!LintActive()) { return; }
        if (childNodes == null || childNodes.Count == 0) { return; }
        for (int i = 0; i < childNodes.Count; i = i + 1) {
            Control c = childNodes[i];
            if (!c.StyleVisible() || c.overlapExempt
                || !c.LintLeafSize()) { continue; }
            if (c.prefSet) {
                this.ReportLint(c, "固定尺寸",
                    "宽高被 Prefer()/文档钉死成 "
                    + Convert.ToString(c.prefW) + "x"
                    + Convert.ToString(c.prefH)
                    + ",应让文字+皮肤内边距自算");
                continue;
            }
            if (c.prefW <= 0 || c.prefH <= 0) { continue; }
            if (c.bh > c.prefH + 12 && c.bh * 10 > c.prefH * 14) {
                this.ReportLint(c, "拉高",
                    "分到 " + Convert.ToString(c.bh) + " 高,内容只要 "
                    + Convert.ToString(c.prefH) + ",巨块按钮");
                continue;
            }
            if (c.bw < c.prefW - 2 || c.bh < c.prefH - 2) {
                this.ReportLint(c, "裁剪",
                    "矩形 " + Convert.ToString(c.bw) + "x"
                    + Convert.ToString(c.bh) + " 装不下内容 "
                    + Convert.ToString(c.prefW) + "x"
                    + Convert.ToString(c.prefH) + ",文字会被切");
            }
        }
    }
    void ReportLint(Control c, string rule, string detail) {
        string sig = this.Kind() + "|" + rule + "|" + c.Kind()
            + "@" + Convert.ToString(c.bx) + ","
            + Convert.ToString(c.by) + "+" + Convert.ToString(c.bw)
            + "x" + Convert.ToString(c.bh);
        LayoutLintDiagnostics.RecordLint(sig, this.Kind(), c.Kind(), c.bx, c.by, c.bw, c.bh, rule, detail);
    }
}
