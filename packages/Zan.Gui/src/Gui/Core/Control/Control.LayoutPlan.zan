using System;
using System.Collections.Generic;
namespace Gui;
public partial class Control {
    private ChildOrderPlan flowOrderPlan;
    private ChildOrderPlan paintOrderPlan;
    private GridLayoutPlan gridLayoutPlan;
    private List<Control> PlannedChildren(bool paint, bool grid) {
        ChildOrderPlan plan = paint ? paintOrderPlan : flowOrderPlan;
        if (plan == null) {
            plan = new ChildOrderPlan();
            if (paint) { paintOrderPlan = plan; }
            else { flowOrderPlan = plan; }
        }
        plan.Prepare(this, paint, grid);
        return plan.Project(this);
    }
    private List<Control> PaintChildren() { return this.PlannedChildren(true, false); }
    private GridLayoutPlan PlanGrid(List<Control> items) {
        return this.PlanGrid(items, 0 - 1, 0);
    }
    private GridLayoutPlan PlanGrid(List<Control> items, int colAvail, int colGap) {
        if (gridLayoutPlan == null) { gridLayoutPlan = new GridLayoutPlan(); }
        gridLayoutPlan.Prepare(computedStyle, items, colAvail, colGap);
        return gridLayoutPlan;
    }
    private bool GridColumnsDefinite(GridLayoutPlan plan, int avail) {
        if (plan == null || plan.placement == null || plan.colDefs == null || plan.autoCols == null) { return false; }
        for (int i = 0; i < plan.placement.nCols; i = i + 1) {
            GridTrack track = null;
            if (i < plan.colDefs.Count) { track = plan.colDefs[i]; }
            else if (plan.autoCols.Count > 0) {
                track = plan.autoCols[(i - plan.colDefs.Count) % plan.autoCols.Count];
            }
            if (track == null) { return false; }
            if (track.kind == 0 || (track.kind == 1 && avail >= 0)) { continue; }
            if (track.kind != 4) { return false; }
            bool definiteMin = track.minKind == 0 || (track.minKind == 1 && avail >= 0);
            bool definiteMax = track.maxKind == 0 || track.maxKind == 3
                || (track.maxKind == 1 && avail >= 0);
            if (!definiteMin || !definiteMax) { return false; }
        }
        return true;
    }
    private List<int> GridColumns(GridLayoutPlan plan, List<Control> items, int avail, int gap) {
        List<int> at = new List<int>();
        List<int> sz = new List<int>();
        if (plan == null || plan.placement == null) { return new List<int>(); }
        if (items != null && plan.placement.slots != null) {
            int limit = items.Count < plan.placement.slots.Count ? items.Count : plan.placement.slots.Count;
            for (int i = 0; i < limit; i = i + 1) {
                GridItemSlot slot = plan.placement.slots[i];
                if (slot == null || slot.colSpan != 1) { continue; }
                at.Add(slot.colStart);
                sz.Add(this.GridOuterW(items[i]));
            }
        }
        return CssGrid.SizeTracks(plan.colDefs, plan.autoCols, plan.placement.nCols,
                                  at, sz, avail, gap);
    }
    private List<int> GridRows(App host, GridLayoutPlan plan, List<Control> items,
                               List<int> colW, int avail, int colGap, int rowGap) {
        List<int> at = new List<int>();
        List<int> sz = new List<int>();
        if (plan == null || plan.placement == null) { return new List<int>(); }
        if (items != null && plan.placement.slots != null) {
            int limit = items.Count < plan.placement.slots.Count ? items.Count : plan.placement.slots.Count;
            for (int i = 0; i < limit; i = i + 1) {
                Control c = items[i];
                GridItemSlot slot = plan.placement.slots[i];
                if (c == null || slot == null) { continue; }
                int spanWidth = CssGrid.SpanSum(colW, colGap, slot.colStart, slot.colSpan);
                if (host != null && !measureIntrinsic) {
                    c.MeasureInWidth(host, spanWidth, false);
                } else if (host == null && !c.StyleDeclaresHeightAbs() && c.StyleDisplay() == 3) {
                    int previous = c.measureWidth;
                    c.measureWidth = spanWidth - c.StyleMarL() - c.StyleMarR();
                    if (c.measureWidth < 0) { c.measureWidth = 0; }
                    try {
                        c.prefH = 0;
                        c.fillH = false;
                        c.MeasureFlow(null);
                    } finally {
                        c.measureWidth = previous;
                    }
                }
                if (slot.rowSpan != 1) { continue; }
                at.Add(slot.rowStart);
                sz.Add(this.GridOuterH(c));
            }
        }
        return CssGrid.SizeTracks(plan.rowDefs, plan.autoRows, plan.placement.nRows,
                                  at, sz, avail, rowGap);
    }
}
