using System;
using System.Collections.Generic;
using Gui;
namespace Gui;
public partial class Control {
    // --- 可链式事件订阅（BindEvent 的类 C# 替代写法；
    // 一个处理器并返回 THIS，保持设置流程连贯。---
    // 订阅 Click 事件并返回 this。
    Control OnClick(Action a) { BindEvent("Click", a); return this; }
    // 订阅 DoubleClick 事件并返回 this。
    Control OnDoubleClick(Action a) { BindEvent("DoubleClick", a); return this; }
    // 订阅 RightClick 事件并返回 this。
    Control OnRightClick(Action a) { BindEvent("RightClick", a); return this; }
    // 订阅 RightDoubleClick 事件并返回 this。
    Control OnRightDoubleClick(Action a) { BindEvent("RightDoubleClick", a); return this; }
    // 订阅 KeyPress 事件并返回 this。
    Control OnKeyPress(Action a) { BindEvent("KeyPress", a); return this; }
    // 订阅 DragStart 事件并返回 this。
    Control OnDragStart(Action a) { BindEvent("DragStart", a); return this; }
    // 订阅 Change 事件并返回 this。
    Control OnChange(Action a) { BindEvent("Change", a); return this; }
    // 订阅 Enter（指针进入）事件并返回 this。
    Control OnEnter(Action a) { BindEvent("Enter", a); return this; }
    // 订阅 Leave（指针离开）事件并返回 this。
    Control OnLeave(Action a) { BindEvent("Leave", a); return this; }
    // 订阅 MouseDown 事件并返回 this。
    Control OnMouseDown(Action a) { BindEvent("MouseDown", a); return this; }
    // 订阅 MouseUp 事件并返回 this。
    Control OnMouseUp(Action a) { BindEvent("MouseUp", a); return this; }
    // 订阅 Wheel 事件并返回 this。
    Control OnWheel(Action a) { BindEvent("Wheel", a); return this; }
    // 订阅 Focus 事件并返回 this。
    Control OnFocus(Action a) { BindEvent("Focus", a); return this; }
    // 订阅 Blur 事件并返回 this。
    Control OnBlur(Action a) { BindEvent("Blur", a); return this; }
    // 订阅 KeyDown 事件并返回 this。
    Control OnKeyDown(Action a) { BindEvent("KeyDown", a); return this; }
    // 订阅 KeyUp 事件并返回 this。
    Control OnKeyUp(Action a) { BindEvent("KeyUp", a); return this; }
    // Explicit ownership only: generic routing/hit testing does not opt in.
    // Migrated intrinsic consumers may override this capability.
    public virtual bool AcceptsRetainedLongPress() {
        return On != null && On.HasLongPress();
    }

    // 订阅 LongPress 事件并返回 this。
    Control OnLongPress(Action a) { BindEvent("LongPress", a); return this; }
    // 订阅 Swipe 事件并返回 this。
    Control OnSwipe(Action a) { BindEvent("Swipe", a); return this; }
    // 订阅 Drag 事件并返回 this。
    Control OnDrag(Action a) { BindEvent("Drag", a); return this; }
    // 订阅 Drop 事件并返回 this。
    Control OnDrop(Action a) { BindEvent("Drop", a); return this; }
    // 订阅生命周期事件 Resize（解析尺寸变化时触发）并返回 this。
    Control OnResize(Action a) { Resize.Add(a); return this; }
    // 订阅生命周期事件 Show（可见性翻转为可见时触发）并返回 this。
    Control OnShow(Action a) { Show.Add(a); return this; }
    // 订阅生命周期事件 Hide（可见性翻转为隐藏时触发）并返回 this。
    Control OnHide(Action a) { Hide.Add(a); return this; }

    // --- sender 形状重载：处理器多收一个参数（触发事件的控件），
    // 与上面的无参版本同名，按 lambda 形状选择。---
    Control OnClick(ControlEvent h) { BindEvent("Click", h); return this; }
    Control OnDoubleClick(ControlEvent h) { BindEvent("DoubleClick", h); return this; }
    Control OnRightClick(ControlEvent h) { BindEvent("RightClick", h); return this; }
    Control OnRightDoubleClick(ControlEvent h) { BindEvent("RightDoubleClick", h); return this; }
    Control OnKeyPress(ControlEvent h) { BindEvent("KeyPress", h); return this; }
    Control OnDragStart(ControlEvent h) { BindEvent("DragStart", h); return this; }
    Control OnChange(ControlEvent h) { BindEvent("Change", h); return this; }
    Control OnEnter(ControlEvent h) { BindEvent("Enter", h); return this; }
    Control OnLeave(ControlEvent h) { BindEvent("Leave", h); return this; }
    Control OnMouseDown(ControlEvent h) { BindEvent("MouseDown", h); return this; }
    Control OnMouseUp(ControlEvent h) { BindEvent("MouseUp", h); return this; }
    Control OnWheel(ControlEvent h) { BindEvent("Wheel", h); return this; }
    Control OnFocus(ControlEvent h) { BindEvent("Focus", h); return this; }
    Control OnBlur(ControlEvent h) { BindEvent("Blur", h); return this; }
    Control OnKeyDown(ControlEvent h) { BindEvent("KeyDown", h); return this; }
    Control OnKeyUp(ControlEvent h) { BindEvent("KeyUp", h); return this; }
    Control OnLongPress(ControlEvent h) { BindEvent("LongPress", h); return this; }
    Control OnSwipe(ControlEvent h) { BindEvent("Swipe", h); return this; }
    Control OnDrag(ControlEvent h) { BindEvent("Drag", h); return this; }
    Control OnDrop(ControlEvent h) { BindEvent("Drop", h); return this; }
    Control OnResize(ControlEvent h) { Resize.Add(h); return this; }
    Control OnShow(ControlEvent h) { Show.Add(h); return this; }
    Control OnHide(ControlEvent h) { Hide.Add(h); return this; }

    // 当控件自身被禁用或位于被禁用的祖先之下时为 true，
    // 控件正是据此解析其 `:disabled` 样式及其
    // （缺失的）交互——禁用一个组即禁用了它的命令，
    // 而无需逐个修改。
    internal bool SelfDisabled() {
        Binding<bool> d = Disabled;
        if (d == null) { return false; }
        return d.live ? d.getter(d.target) : d.constVal;
    }
    bool IsDisabled() {
        if (this.SelfDisabled()) { return true; }
        Control p = parent;
        while (p != null) {
            if (p.SelfDisabled()) { return true; }
            p = p.parent;
        }
        return false;
    }
    int CommonId() {
        if (commonId == 0) { commonId = Gui.WidgetId.Next(); }
        return commonId;
    }
    public virtual int WidgetId() { return this.CommonId(); }
    public virtual bool HasFocus() { return this.HasFocus(this.App); }
    public virtual bool HasFocus(App app) {
        app = this.ResolveApp(app);
        if (app == null || app.focus == null) { return false; }
        int id = this.WidgetId();
        if (id > 0 && app.focus.IsFocused(id)) { return true; }
        if (commonId > 0 && app.focus.IsFocused(commonId)) { return true; }
        return false;
    }
    public virtual bool IsActive() { return this.IsActive(this.App); }
    public virtual bool IsActive(App app) {
        app = this.ResolveApp(app);
        if (app == null) { return false; }
        int id = this.WidgetId();
        if (app.focus != null) {
            if (id > 0 && app.focus.IsPressed(id) && app.focus.IsHovered(id)) { return true; }
            if (commonId > 0 && app.focus.IsPressed(commonId) && app.focus.IsHovered(commonId)) { return true; }
        }
        return false;
    }
    public virtual void Focus() { this.Focus(this.App); }
    public virtual void Focus(App app) {
        app = this.ResolveApp(app);
        if (app == null || app.focus == null) { return; }
        int id = this.WidgetId();
        if (id > 0) { app.focus.SetFocused(id, this); return; }
        if (commonId > 0) { app.focus.SetFocused(commonId, this); }
    }
    public virtual void Blur() { this.Blur(this.App); }
    public virtual void Blur(App app) {
        app = this.ResolveApp(app);
        if (app == null || app.focus == null) { return; }
        int id = this.WidgetId();
        if ((id > 0 && app.focus.IsFocused(id)) || (commonId > 0 && app.focus.IsFocused(commonId))) {
            app.focus.ClearFocus();
        }
    }
    // 按名称触发已绑定的事件（测试或合成事件调度通道）。名称解析同
    // BindEvent（含 [Event(Alias=…)] 别名）；无订阅时不分配事件对象。
    // 需要附带交互语义（禁用门控、切换状态）的控件覆写它。
    public virtual void TriggerEvent(string evt) {
        UiEvent e = this.EventOf(evt, false);
        if (e != null) { e.Raise(this); }
    }

    // 输入控件在键盘/焦点路由中使用同一命名事件表；空订阅不分配。
    void FireKeyNamed(string evt) {
        UiEvent e = On.Find(evt);
        if (e != null) { e.Raise(this); }
    }

    // 子控件事件冒泡钩子：子控件的用户切换在自己的 Change 之后经
    // weak parent 反向通知到这里，容器按需覆写。取代「子事件表挂
    // 捕获容器的闭包」的旧接线——那构成 容器→子→事件表→闭包→容器
    // 引用环，ARC 不回收，逐选项泄漏（leakcheck_checkbox_group /
    // radio_group）。默认无操作；evt 目前只有 "Change"。
    public virtual void OnChildEvent(Control child, string evt) {
    }
    string GetHandler(string evt) {
        if (this.extra == null || this.extra.events == null) { return ""; }
        List<EventBinding> evs = this.extra.events;
        for (int i = 0; i < evs.Count; i = i + 1) {
            if (evs[i].key == evt) { return evs[i].val; }
        }
        return "";
    }
    void SetHandler(string evt, string h) {
        ControlExtra e = this.EnsureExtra();
        if (e.events == null) { e.events = new List<EventBinding>(); }
        for (int i = 0; i < e.events.Count; i = i + 1) {
            if (e.events[i].key == evt) { e.events[i].val = h; return; }
        }
        e.events.Add(new EventBinding(evt, h));
    }
    static List<string> CommonEvents() {
        List<string> e = WidgetEvents.Names();
        e.Insert(0, "Click");
        e.Add("Resize");
        e.Add("Show");
        e.Add("Hide");
        return e;
    }
    // 供设计器事件检查器使用的声明事件名：通用事件包 + 本类型以
    // [Event] 标注的 UiEvent 成员（声明顺序）。事件集随字段类型变化
    // 的控件（FormField）覆写它。
    public virtual List<string> Events() {
        List<string> e = Control.CommonEvents();
        List<string> own = EventTable.Of(this).Listed();
        for (int i = 0; i < own.Count; i = i + 1) {
            if (!e.Contains(own[i])) { e.Add(own[i]); }
        }
        return e;
    }

    // 名称 → 事件对象：本类型的 UiEvent 成员（含 [Event(Alias=…)] 别名）、
    // 生命周期四事件（Click/Resize/Show/Hide）与通用事件包 `On`。
    // create=false 只查已存在的对象，不做惰性分配；未知名称返回 null。
    public UiEvent EventOf(string evt, bool create) {
        if (evt == "Click" || evt == "Resize" || evt == "Show" || evt == "Hide") {
            if (create) { return (UiEvent)this.GetFieldObject(evt); }
            if (this.extra == null) { return null; }
            if (evt == "Click") { return this.extra.Click; }
            if (evt == "Resize") { return this.extra.Resize; }
            if (evt == "Show") { return this.extra.Show; }
            return this.extra.Hide;
        }
        string member = EventTable.Of(this).MemberOf(evt);
        if (member != "") {
            UiEvent e = (UiEvent)this.GetFieldObject(member);
            if (e == null && create) {
                e = new UiEvent();
                this.SetFieldObject(member, e);
            }
            return e;
        }
        if (create) { return On.Named(evt); }
        return On.Find(evt);
    }

    // HTML、设计器和代码的按名接线共用此入口；未知名称静默忽略。
    public void BindEvent(string evt, Action a) {
        UiEvent e = this.EventOf(evt, true);
        if (e != null) { e.Add(a); }
    }

    public void BindEvent(string evt, ControlEvent h) {
        UiEvent e = this.EventOf(evt, true);
        if (e != null) { e.Add(h); }
    }
    public PropSpec PropOf(string key) { return PropSpec.Find(this.Props(), key, true); }
    public void StopPropagation() { this.EnsureExtra().stopBubble = true; }
    public bool HasClickSubscription() {
        return this.extra != null && (this.extra.Click != null
            || (this.extra.events != null && this.extra.events.Count > 0));
    }
}
