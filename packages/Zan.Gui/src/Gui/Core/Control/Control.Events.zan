using System;
using System.Collections.Generic;
using Gui;
namespace Gui;
public partial class Control {
    void OnClick(Action a) { BindEvent("Click", a); }
    void OnDoubleClick(Action a) { BindEvent("DoubleClick", a); }
    void OnRightClick(Action a) { BindEvent("RightClick", a); }
    void OnChange(Action a) { BindEvent("Change", a); }
    void OnEnter(Action a) { BindEvent("Enter", a); }
    void OnLeave(Action a) { BindEvent("Leave", a); }
    void OnMouseDown(Action a) { BindEvent("MouseDown", a); }
    void OnMouseUp(Action a) { BindEvent("MouseUp", a); }
    void OnWheel(Action a) { BindEvent("Wheel", a); }
    void OnFocus(Action a) { BindEvent("Focus", a); }
    void OnBlur(Action a) { BindEvent("Blur", a); }
    void OnKeyDown(Action a) { BindEvent("KeyDown", a); }
    void OnKeyUp(Action a) { BindEvent("KeyUp", a); }
    public virtual bool AcceptsRetainedLongPress() { return On != null && On.HasLongPress(); }
    void OnLongPress(Action a) { BindEvent("LongPress", a); }
    void OnSwipe(Action a) { BindEvent("Swipe", a); }
    void OnDrag(Action a) { BindEvent("Drag", a); }
    void OnDrop(Action a) { BindEvent("Drop", a); }
    void OnResize(Action a) { Resize.Add(a); }
    void OnShow(Action a) { Show.Add(a); }
    void OnHide(Action a) { Hide.Add(a); }
    void OnClickS(ControlEvent h) { BindEventS("Click", h); }
    void OnDoubleClickS(ControlEvent h) { BindEventS("DoubleClick", h); }
    void OnRightClickS(ControlEvent h) { BindEventS("RightClick", h); }
    void OnChangeS(ControlEvent h) { BindEventS("Change", h); }
    void OnEnterS(ControlEvent h) { BindEventS("Enter", h); }
    void OnLeaveS(ControlEvent h) { BindEventS("Leave", h); }
    void OnMouseDownS(ControlEvent h) { BindEventS("MouseDown", h); }
    void OnMouseUpS(ControlEvent h) { BindEventS("MouseUp", h); }
    void OnWheelS(ControlEvent h) { BindEventS("Wheel", h); }
    void OnFocusS(ControlEvent h) { BindEventS("Focus", h); }
    void OnBlurS(ControlEvent h) { BindEventS("Blur", h); }
    void OnKeyDownS(ControlEvent h) { BindEventS("KeyDown", h); }
    void OnKeyUpS(ControlEvent h) { BindEventS("KeyUp", h); }
    void OnLongPressS(ControlEvent h) { BindEventS("LongPress", h); }
    void OnSwipeS(ControlEvent h) { BindEventS("Swipe", h); }
    void OnDragS(ControlEvent h) { BindEventS("Drag", h); }
    void OnDropS(ControlEvent h) { BindEventS("Drop", h); }
    void OnResizeS(ControlEvent h) { Resize.AddS(h); }
    void OnShowS(ControlEvent h) { Show.AddS(h); }
    void OnHideS(ControlEvent h) { Hide.AddS(h); }
    bool IsDisabled() {
        if (Disabled.Get()) { return true; }
        if (parent != null) { return parent.IsDisabled(); }
        return false;
    }
    int CommonId() {
        if (commonId == 0) { commonId = Gui.WidgetId.Next(); }
        return commonId;
    }
    public virtual int WidgetId() { return this.CommonId(); }
    public virtual bool HasFocus() { return this.HasFocus(this.App); }
    public virtual bool HasFocus(App app) {
        app = this.ResolveApp(app);
        if (app == null || app.focus == null) { return false; }
        int id = this.WidgetId();
        if (id > 0 && app.focus.IsFocused(id)) { return true; }
        if (commonId > 0 && app.focus.IsFocused(commonId)) { return true; }
        return false;
    }
    public virtual bool IsActive() { return this.IsActive(this.App); }
    public virtual bool IsActive(App app) {
        app = this.ResolveApp(app);
        if (app == null) { return false; }
        int id = this.WidgetId();
        if (app.focus != null) {
            if (id > 0 && app.focus.IsPressed(id) && app.focus.IsHovered(id)) { return true; }
            if (commonId > 0 && app.focus.IsPressed(commonId) && app.focus.IsHovered(commonId)) { return true; }
        }
        return false;
    }
    public virtual void Focus() { this.Focus(this.App); }
    public virtual void Focus(App app) {
        app = this.ResolveApp(app);
        if (app == null || app.focus == null) { return; }
        int id = this.WidgetId();
        if (id > 0) { app.focus.SetFocused(id, this); return; }
        if (commonId > 0) { app.focus.SetFocused(commonId, this); }
    }
    public virtual void Blur() { this.Blur(this.App); }
    public virtual void Blur(App app) {
        app = this.ResolveApp(app);
        if (app == null || app.focus == null) { return; }
        int id = this.WidgetId();
        if ((id > 0 && app.focus.IsFocused(id)) || (commonId > 0 && app.focus.IsFocused(commonId))) {
            app.focus.ClearFocus();
        }
    }
    public virtual void TriggerEvent(string evt) {
        if (evt == "Click") {
            if (this.extra != null && this.extra.Click != null) { this.extra.Click.RaiseS(this); }
            return;
        }
        if (evt == "Resize") {
            if (this.extra != null && this.extra.Resize != null) { this.extra.Resize.RaiseS(this); }
            return;
        }
        if (evt == "Show") {
            if (this.extra != null && this.extra.Show != null) { this.extra.Show.RaiseS(this); }
            return;
        }
        if (evt == "Hide") {
            if (this.extra != null && this.extra.Hide != null) { this.extra.Hide.RaiseS(this); }
            return;
        }
        On.FireByName(evt, this);
    }
    void FireKeyNamed(string evt) { On.FireByName(evt, this); }
    public virtual void OnChildEvent(Control child, string evt) {
    }
    string GetHandler(string evt) {
        if (this.extra == null || this.extra.events == null) { return ""; }
        List<EventBinding> evs = this.extra.events;
        for (int i = 0; i < evs.Count; i = i + 1) {
            if (evs[i].key == evt) { return evs[i].val; }
        }
        return "";
    }
    void SetHandler(string evt, string h) {
        ControlExtra e = this.EnsureExtra();
        if (e.events == null) { e.events = new List<EventBinding>(); }
        for (int i = 0; i < e.events.Count; i = i + 1) {
            if (e.events[i].key == evt) { e.events[i].val = h; return; }
        }
        e.events.Add(new EventBinding(evt, h));
    }
    static List<string> CommonEvents() {
        List<string> e = WidgetEvents.Names();
        e.Insert(0, "Click");
        e.Add("Resize");
        e.Add("Show");
        e.Add("Hide");
        return e;
    }
    public virtual List<string> Events() { return Control.CommonEvents(); }
    public virtual void BindEvent(string evt, Action a) {
        if (evt == "Click") { Click.Add(a); return; }
        if (evt == "Resize") { Resize.Add(a); return; }
        if (evt == "Show") { Show.Add(a); return; }
        if (evt == "Hide") { Hide.Add(a); return; }
        On.AddByName(evt, a);
    }
    public virtual void BindEventS(string evt, ControlEvent h) {
        if (evt == "Click") { Click.AddS(h); return; }
        if (evt == "Resize") { Resize.AddS(h); return; }
        if (evt == "Show") { Show.AddS(h); return; }
        if (evt == "Hide") { Hide.AddS(h); return; }
        On.AddByNameS(evt, h);
    }
    public PropSpec PropOf(string key) { return PropSpec.Find(this.Props(), key, true); }
    public void StopPropagation() { this.EnsureExtra().stopBubble = true; }
    public bool HasClickSubscription() {
        return this.extra != null && (this.extra.Click != null
            || (this.extra.events != null && this.extra.events.Count > 0));
    }
}
