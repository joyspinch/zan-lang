using System;
using System.Collections.Generic;
using Gui;
using Gui.Backend;
namespace Gui;
public partial class Control {
    public virtual bool ChildControlsRenderedByOwner() { return false; }
    protected virtual bool PaintWithinBounds() { return false; }
    private bool CanBoundsCull(App host, bool needClippedChildren) {
        if (host.Damage == null || !host.Damage.partialFrame) { return false; }
        bool formCulled = host.SkipFormPaintBounds(bx, by, bw, bh);
        bool generalPartial = !formCulled && !host.Damage.forceFullNext
            && (!PaintHash.On || host.paintingSteadyDrawer)
            && !NativeLayer.HasTrackedFor(host)
            && !host.Damage.FrameDamageIntersects(bx, by, bw, bh);
        if (!formCulled && !generalPartial) { return false; }
        if (this.app != host || Tip != "" || surfaceFrom != null
            || host.paintOffsetX != 0 || host.paintOffsetY != 0 || host.canvas.opacityPm != 1000
            || this.ChildControlsRenderedByOwner()
            || (extra != null && ((extra.Paint != null && extra.Paint.Count() > 0)
                || extra.surfaceTransitionKey != 0))
            || !this.PaintWithinBounds()) { return false; }
        StyleBox style = computedStyle;
        if (style == null || !this.ComputedStyleCurrent(host)
            || this.SurfaceState(host) != computedStyleState
            || style.shadow != 0 || style.blur != 0 || style.tx != 0 || style.ty != 0
            || style.scale > 1000 || (style.rotate % 360) != 0 || style.opacity < 1000
            || style.emboss != 0 || style.anim != 0) { return false; }
        if (formCulled && (this.StyleOverflowX() > 1 || this.StyleOverflowY() > 1)) { return false; }
        if (!needClippedChildren) { return true; }
        return childNodes.Count == 0
            || (!formCulled && (this.IsScrollContainer() || style.overflow != 0));
    }
    private bool SkipBoundedPaint(App host) {
        if (!this.CanBoundsCull(host, true)) { return false; }
        host.culledControlPaints = host.culledControlPaints + 1;
        return true;
    }
    protected void PaintContentMask(App host, int color) { host.Backdrop.PaintContentMask(bx, by, bw, bh, color); }
    void RenderInside(App app, Rect area) {
        if (area == null || area.width <= 0 || area.height <= 0 || area.x <= -1000 || area.y <= -1000) { return; }
        this.MeasureTree(app, area.width);
        int escT = 0;
        StyleBox sbR = computedStyle;
        if (sbR != null && sbR.display == 3 && !this.FlowSepT()) {
            escT = this.FlowMarT(this);
            if (escT < 0) { escT = 0; }
            if (escT > area.height) { escT = area.height; }
        }
        this.Arrange(area.x, area.y + escT, area.width, area.height - escT);
        this.RenderTree(app);
    }
    void RenderTree(App app) {
        if (!app.ContinuePreparedFrame()) { return; }
        bool ownChainPass = Style.chainPassDepth == 0 || Style.chainApp != app;
        if (ownChainPass) { Style.BeginChainPass(app); }
        Control prevCtx = app.styleCtx;
        bool ancestorDisabled = parent != null && parent.IsDisabled();
        bool partialFrame = app.Damage != null && app.Damage.partialFrame;
        bool perfOn = App.PerfOn();
        bool paintHashOn = PaintHash.On;
        Control frameRoot = app.rootControl;
        int frameGen = app.inputRootGeneration;
        long frameSeq = app.window.EventSeq();
        int framePhase = app.inputPreparationTicket;
        int frameNum = app.frameSeq;
        int frameStructRev = Control.BindingStructureRevision();
        int passRuleSig = app.CurrentStyleRuleSig();
        bool passAnyMedia = (passRuleSig & 1) != 0;
        long passMediaHash = passAnyMedia ? Style.PassMediaHash(app) : 0L;
        int passChainSeq = Style.chainApp == app ? Style.chainActiveSeq : 0;
        try {
            this.RenderTreeNode(app, ancestorDisabled, partialFrame, perfOn, paintHashOn,
                frameRoot, frameGen, frameSeq, framePhase, frameNum, frameStructRev,
                passRuleSig, passAnyMedia, passMediaHash, passChainSeq);
        } finally {
            if (ownChainPass) { Style.EndChainPass(); }
            paintedStyle = null;
            app.styleCtx = prevCtx;
        }
    }
    private bool PaintNodeCurrent(App host, Control ownerParent, int revision, int structRev,
    Control root, int generation, long sequence, int phase, int frame) {
        if (host.preparationFrameAborted || !host.isRunning) { return false; }
        if (host.preparedHostFrameValid && !host.ContinuePreparedFrame()) { return false; }
        if (host.rootControl != root || host.inputRootGeneration != generation
            || host.inputPreparationTicket != phase || host.frameSeq != frame) { return false; }
        if (parent == ownerParent && this.app == host && preparingLayoutOwner == null
            && Control.BindingStructureRevision() == structRev
            && this.LayoutRevision() == revision && this.StyleVisible()) {
            return host.window.EventSeq() == sequence;
        }
        return this.LayoutPhaseCurrent(host, root, generation, sequence, phase, frame)
        && this.LayoutNodeCurrent(host, ownerParent, revision) && this.StyleVisible()
        && (ownerParent == null || ownerParent.OwnsLayoutChild(this));
    }
    private void RenderTreeNode(App app, bool ancestorDisabled, bool partialFrame,
                                bool perfOn, bool paintHashOn,
                                Control frameRoot, int frameGen, long frameEventSeq,
                                int framePhase, int frameNum, int frameStructRev,
                                int passRuleSig, bool passAnyMedia, long passMediaHash, int passChainSeq) {
        if (app.preparationFrameAborted) { return; }
        if (app.preparedHostFrameValid && !app.ContinuePreparedFrame()) { return; }
        if (partialFrame && this.app == app && this.SkipBoundedPaint(app)) { return; }
        Control prevCtx = app.styleCtx;
        app.styleCtx = this;
        if (this.app != app) { this.InheritApp(app); }
        bool styleOk = (passChainSeq != 0 && Style.chainActiveSeq == passChainSeq)
            ? this.ComputedStyleCurrentPass(app, passRuleSig, passAnyMedia, passMediaHash, passChainSeq)
            : this.ComputedStyleCurrent(app);
        if (!styleOk) { this.ResolveStyle(app, 0); }
        if (!this.StyleVisible()) {
            app.styleCtx = prevCtx;
            return;
        }
        bool selfDisabled = ancestorDisabled || this.SelfDisabled();
        bool prevCompositing = treeCompositing;
        treeCompositing = true;
        StyleBox surface = this.ResolvePaintedSurfaceKnown(app, selfDisabled);
        bool simpleNode = !partialFrame && !perfOn && !paintHashOn
            && app.paintOffsetX == 0 && app.paintOffsetY == 0
            && app.canvas.opacityPm == 1000
            && (surface == null || (surface.tx == 0 && surface.ty == 0
                && surface.anim != 5 && surface.opacity >= 1000
                && (surface.scale == 1000 || surface.scale <= 0)
                && (surface.rotate % 360) == 0));
        if (simpleNode) {
            this.RenderTreeNodeSimple(app, surface, selfDisabled, prevCompositing, prevCtx,
                frameRoot, frameGen, frameEventSeq, framePhase, frameNum, frameStructRev,
                passRuleSig, passAnyMedia, passMediaHash, passChainSeq);
            return;
        }
        try {
            this.RenderTreeInner(app, surface, selfDisabled, partialFrame, perfOn, paintHashOn,
                frameRoot, frameGen, frameEventSeq, framePhase, frameNum, frameStructRev,
                passRuleSig, passAnyMedia, passMediaHash, passChainSeq);
        } finally {
            treeCompositing = prevCompositing;
            paintedStyle = null;
            app.styleCtx = prevCtx;
        }
    }
    private void RenderTreeNodeSimple(App app, StyleBox surface, bool selfDisabled,
                                      bool prevCompositing, Control prevCtx,
                                      Control root, int generation, long sequence,
                                      int phase, int frame, int structRev,
                                      int passRuleSig, bool passAnyMedia, long passMediaHash, int passChainSeq) {
        int count = childNodes.Count;
        StyleBox cs = computedStyle;
        bool scrollC = cs != null && (cs.overflowX != 0 || cs.overflowY != 0);
        if (count == 0 && !scrollC && (Tip == null || Tip.Length == 0)
            && (this.extra == null || this.extra.Paint == null)) {
            if (!wiresOwnEvents && !styleSurfaceOwned && surface != null) {
                surface.PaintFast(app, app.canvas, app.nativeLayers.Count > 0, bx, by, bw, bh);
            }
            OnPaint(app);
            if (surface != null) {
                surface.treeComposite = false;
                surface.layerTransformOwned = false;
            }
            if (paintedStyle != null) {
                paintedStyle.treeComposite = false;
                paintedStyle.layerTransformOwned = false;
            }
            paintedStyle = null;
            treeCompositing = prevCompositing;
            app.styleCtx = prevCtx;
            return;
        }
        Control ownerParent = parent;
        int revision = this.LayoutRevision();
        if (!wiresOwnEvents && !styleSurfaceOwned && surface != null) {
            surface.PaintFast(app, app.canvas, app.nativeLayers.Count > 0, bx, by, bw, bh);
        }
        OnPaint(app);
        if (!this.PaintNodeCurrent(app, ownerParent, revision, structRev, root, generation, sequence, phase, frame)) {
            if (surface != null) { surface.treeComposite = false; surface.layerTransformOwned = false; }
            if (paintedStyle != null) { paintedStyle.treeComposite = false; paintedStyle.layerTransformOwned = false; }
            paintedStyle = null;
            treeCompositing = prevCompositing;
            app.styleCtx = prevCtx;
            return;
        }
        if (Tip != null && Tip.Length > 0 && (app.ShouldShowTip(this, bx, by, bw, bh)
            || app.HoldTip(this))) {
            int place = Widget.Tooltip.Bottom();
            if (TipSide == "top") { place = Widget.Tooltip.Top(); }
            else if (TipSide == "left") { place = Widget.Tooltip.Left(); }
            else if (TipSide == "right") { place = Widget.Tooltip.Right(); }
            Widget.Tooltip.RequestBox(app, bx, by, bw, bh, this.TipText(), place, app.Scale(260));
        }
        if (this.extra != null && this.extra.Paint != null && this.extra.Paint.Count() > 0) {
            this.extra.Paint.Raise(this);
            if (!this.PaintNodeCurrent(app, ownerParent, revision, structRev, root, generation, sequence, phase, frame)) {
                if (surface != null) { surface.treeComposite = false; surface.layerTransformOwned = false; }
                if (paintedStyle != null) { paintedStyle.treeComposite = false; paintedStyle.layerTransformOwned = false; }
                paintedStyle = null;
                treeCompositing = prevCompositing;
                app.styleCtx = prevCtx;
                return;
            }
        }
        count = childNodes.Count;
        cs = computedStyle;
        scrollC = cs != null && (cs.overflowX != 0 || cs.overflowY != 0);
        if (count > 0 && !this.ChildControlsRenderedByOwner()) {
            bool clipKids = scrollC || cs == null || cs.overflow != 0;
            if (clipKids) {
                if (scrollC) {
                    Rect viewport = this.ScrollViewport();
                    app.canvas.PushClip(viewport.x, viewport.y, viewport.width, viewport.height);
                    app.PushNativeClip(viewport.x, viewport.y, viewport.width, viewport.height);
                } else {
                    app.canvas.PushClip(bx, by, bw, bh);
                    app.PushNativeClip(bx, by, bw, bh);
                }
                try {
                    this.RenderSimpleChildren(app, count, selfDisabled, ownerParent, revision, structRev,
                        root, generation, sequence, phase, frame,
                        passRuleSig, passAnyMedia, passMediaHash, passChainSeq);
                } finally {
                    app.PopNativeClip();
                    app.canvas.PopClip();
                }
            } else {
                this.RenderSimpleChildren(app, count, selfDisabled, ownerParent, revision, structRev,
                    root, generation, sequence, phase, frame,
                    passRuleSig, passAnyMedia, passMediaHash, passChainSeq);
            }
        }
        if (scrollC) { this.PaintScrollBars(app); }
        if (surface != null) {
            surface.treeComposite = false;
            surface.layerTransformOwned = false;
        }
        if (paintedStyle != null) {
            paintedStyle.treeComposite = false;
            paintedStyle.layerTransformOwned = false;
        }
        paintedStyle = null;
        treeCompositing = prevCompositing;
        app.styleCtx = prevCtx;
    }
    private void RenderSimpleChildren(App app, int count, bool selfDisabled, Control ownerParent,
                                      int revision, int structRev, Control root, int generation,
                                      long sequence, int phase, int frame,
                                      int passRuleSig, bool passAnyMedia, long passMediaHash, int passChainSeq) {
        if (count == 1) {
            Control child = childNodes[0];
            if (this.OwnsLayoutChild(child) && this.ChildInViewport(child)) {
                child.RenderTreeNode(app, selfDisabled, false, false, false,
                    root, generation, sequence, phase, frame, structRev,
                    passRuleSig, passAnyMedia, passMediaHash, passChainSeq);
            }
            return;
        }
        List<Control> ordered = this.PaintChildrenFast();
        bool liveList = ordered == childNodes;
        int i = 0;
        while (i < count) {
            if (liveList && i >= ordered.Count) { break; }
            Control child = ordered[i];
            if (!this.OwnsLayoutChild(child) || !this.ChildInViewport(child)) { i = i + 1; continue; }
            child.RenderTreeNode(app, selfDisabled, false, false, false,
                root, generation, sequence, phase, frame, structRev,
                passRuleSig, passAnyMedia, passMediaHash, passChainSeq);
            if (!this.PaintNodeCurrent(app, ownerParent, revision, structRev, root, generation, sequence, phase, frame)) { return; }
            if (liveList && (i >= ordered.Count || ordered[i] != child)) {
                if (child.parent != this) { count = count - 1; continue; }
            }
            i = i + 1;
        }
    }
    private void RenderTreeInner(App app, StyleBox surface, bool selfDisabled,
                                 bool partialFrame, bool perfOn, bool paintHashOn,
                                 Control frameRoot, int frameGen, long frameEventSeq,
                                 int framePhase, int frameNum, int frameStructRev,
                                 int passRuleSig, bool passAnyMedia, long passMediaHash, int passChainSeq) {
        int origX = bx;
        int origY = by;
        int prevOffX = app.paintOffsetX;
        int prevOffY = app.paintOffsetY;
        int prevOpacity = app.canvas.opacityPm;
        int localDx = surface != null ? surface.tx : 0;
        int localDy = surface != null ? surface.ty + (surface.anim == 5 ? surface.FloatOffset(app, origX + prevOffX, origY + prevOffY, bw, bh) : 0) : 0;
        int offX = prevOffX + localDx;
        int offY = prevOffY + localDy;
        int localOpacity = surface != null ? surface.opacity : 1000;
        int localScale = surface != null && surface.scale > 0 ? surface.scale : 1000;
        int localRotate = surface != null ? surface.rotate : 0;
        bool hasTransform = localScale != 1000 || (localRotate % 360) != 0;
        bool hasBackdropBlur = surface != null && surface.blur > 0;
        bool wantGroupOpacity = localOpacity < 1000 && localOpacity > 0 && childNodes.Count > 0 && !hasBackdropBlur;
        bool pushedLayer = false;
        if ((hasTransform || wantGroupOpacity) && bw > 0 && bh > 0 && prevOpacity > 0) {
            pushedLayer = app.canvas.PushLayer(origX + offX, origY + offY, bw, bh,
                localOpacity, localScale, localRotate);
        }
        int effOpacity = pushedLayer
            ? 1000
            : (localOpacity >= 1000 ? prevOpacity : (prevOpacity * localOpacity) / 1000);
        if (pushedLayer) {
            if (surface != null) { surface.layerTransformOwned = true; }
            app.paintOffsetX = 0 - origX;
            app.paintOffsetY = 0 - origY;
            app.canvas.opacityPm = 1000;
            bx = 0;
            by = 0;
        } else {
            app.paintOffsetX = offX;
            app.paintOffsetY = offY;
            app.canvas.opacityPm = effOpacity;
            bx = origX + offX;
            by = origY + offY;
        }
        try {
            if (effOpacity <= 0) { return; }
            Control ownerParent = parent;
            int revision = this.LayoutRevision();
            int structRev = frameStructRev;
            Control root = frameRoot;
            int generation = frameGen;
            long sequence = frameEventSeq;
            int phase = framePhase;
            int frame = frameNum;
            int selfT0 = 0;
            if (perfOn) { selfT0 = Window.GetTickUs(); }
            bool skipSelf = partialFrame && !pushedLayer && this.CanBoundsCull(app, false);
            if (skipSelf) {
                app.culledControlPaints = app.culledControlPaints + 1;
            } else {
                if (paintHashOn) {
                    PaintHashToken hashSeg = PaintHash.BeginScope();
                    try {
                        PaintStyleBox(app);
                        OnPaint(app);
                        if (!this.PaintNodeCurrent(app, ownerParent, revision, structRev, root, generation, sequence, phase, frame)) { return; }
                        app.CommitPaintHash(hashSeg, this.CommonId(), bx, by, bw, bh);
                    } finally {
                        PaintHash.Restore(hashSeg);
                    }
                } else {
                    if (!wiresOwnEvents && !styleSurfaceOwned && surface != null) {
                        surface.PaintFast(app, app.canvas, app.nativeLayers.Count > 0, bx, by, bw, bh);
                    }
                    OnPaint(app);
                    if (!this.PaintNodeCurrent(app, ownerParent, revision, structRev, root, generation, sequence, phase, frame)) { return; }
                }
                if (perfOn) {
                    app.Stats.Node(this.Kind(), name, Window.GetTickUs() - selfT0);
                }
                if (Tip != null && Tip.Length > 0 && (app.ShouldShowTip(this, origX, origY, bw, bh)
                || app.HoldTip(this))) {
                    int place = Widget.Tooltip.Bottom();
                    if (TipSide == "top") { place = Widget.Tooltip.Top(); }
                    else if (TipSide == "left") { place = Widget.Tooltip.Left(); }
                    else if (TipSide == "right") { place = Widget.Tooltip.Right(); }
                    Widget.Tooltip.RequestBox(app, origX, origY, bw, bh, this.TipText(), place, app.Scale(260));
                }
                if (this.extra != null && this.extra.Paint != null && this.extra.Paint.Count() > 0) {
                    this.extra.Paint.Raise(this);
                    if (!this.PaintNodeCurrent(app, ownerParent, revision, structRev, root, generation, sequence, phase, frame)) { return; }
                }
            }
            bool scrollC = this.IsScrollContainer();
            if (childNodes.Count > 0 && !this.ChildControlsRenderedByOwner()) {
                bool clipKids = scrollC || computedStyle == null || computedStyle.overflow != 0;
                if (clipKids) {
                    if (scrollC) {
                        Rect viewport = this.ScrollViewport();
                        app.canvas.PushClip(viewport.x, viewport.y, viewport.width, viewport.height);
                        app.PushNativeClip(viewport.x, viewport.y, viewport.width, viewport.height);
                    } else {
                        app.canvas.PushClip(bx, by, bw, bh);
                        app.PushNativeClip(bx, by, bw, bh);
                    }
                }
                try {
                    int count = childNodes.Count;
                    Control onlyChild = count == 1 ? childNodes[0] : null;
                    List<Control> ordered = count > 1 ? this.PaintChildrenFast() : null;
                    bool restoreBounds = pushedLayer || offX != 0 || offY != 0;
                    int paintX = pushedLayer ? 0 : origX + offX;
                    int paintY = pushedLayer ? 0 : origY + offY;
                    bool liveList = ordered != null && ordered == childNodes;
                    int i = 0;
                    while (i < count) {
                        if (liveList && i >= ordered.Count) { break; }
                        Control child = ordered != null ? ordered[i] : onlyChild;
                        if (!this.OwnsLayoutChild(child)) { i = i + 1; continue; }
                        bool inView;
                        if (restoreBounds) {
                            bx = origX;
                            by = origY;
                            inView = this.ChildInViewport(child);
                            bx = paintX;
                            by = paintY;
                        } else {
                            inView = this.ChildInViewport(child);
                        }
                        if (!inView) { i = i + 1; continue; }
                        child.RenderTreeNode(app, selfDisabled, partialFrame, perfOn, paintHashOn,
                            root, generation, sequence, phase, frame, structRev,
                            passRuleSig, passAnyMedia, passMediaHash, passChainSeq);
                        if (!this.PaintNodeCurrent(app, ownerParent, revision, structRev, root, generation, sequence, phase, frame)) { return; }
                        if (liveList && (i >= ordered.Count || ordered[i] != child)) {
                            if (child.parent != this) { count = count - 1; continue; }
                        }
                        i = i + 1;
                    }
                } finally {
                    if (clipKids) {
                        app.PopNativeClip();
                        app.canvas.PopClip();
                    }
                }
            }
            if (scrollC) { this.PaintScrollBars(app); }
        } finally {
            if (surface != null) {
                surface.treeComposite = false;
                surface.layerTransformOwned = false;
            }
            if (paintedStyle != null) {
                paintedStyle.treeComposite = false;
                paintedStyle.layerTransformOwned = false;
            }
            if (pushedLayer) { app.canvas.PopLayer(); }
            bx = origX;
            by = origY;
            app.paintOffsetX = prevOffX;
            app.paintOffsetY = prevOffY;
            app.canvas.opacityPm = prevOpacity;
        }
    }
}
