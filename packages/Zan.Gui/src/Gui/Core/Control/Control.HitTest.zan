using System;
using System.Collections.Generic;
using Gui;
namespace Gui;
public partial class Control {
    public bool ContainsPoint(int x, int y) { return this.ContainsPoint(x, y, 0); }
    public bool ContainsPoint(int x, int y, int pointerType) {
        if (this.bw <= 0 || this.bh <= 0) { return false; }
        if (pointerType == 1) { // 触控模式：引入指腹 44px 最小热区补齐与 HitSlop 外扩容差
            int slopT = 0;
            int slopR = 0;
            int slopB = 0;
            int slopL = 0;
            int minSz = 44; // 触屏交互行业基准：Apple HIG 44pt / Material Design 48dp
            if (this.extra != null) {
                slopT = this.extra.hitSlopT;
                slopR = this.extra.hitSlopR;
                slopB = this.extra.hitSlopB;
                slopL = this.extra.hitSlopL;
                if (this.extra.minTouchSize > 0) { minSz = this.extra.minTouchSize; }
            }
            if (slopT == 0 && slopB == 0 && this.bh < minSz) {
                int padH = (minSz - this.bh) / 2;
                slopT = padH;
                slopB = padH;
            }
            if (slopL == 0 && slopR == 0 && this.bw < minSz) {
                int padW = (minSz - this.bw) / 2;
                slopL = padW;
                slopR = padW;
            }
            return x >= (this.bx - slopL) && x < (this.bx + this.bw + slopR) &&
                   y >= (this.by - slopT) && y < (this.by + this.bh + slopB);
        }
        return x >= this.bx && x < (this.bx + this.bw) &&
               y >= this.by && y < (this.by + this.bh);
    }
    public void WithHitSlop(int uniform) {
        ControlExtra ex = this.EnsureExtra();
        ex.hitSlopT = uniform;
        ex.hitSlopR = uniform;
        ex.hitSlopB = uniform;
        ex.hitSlopL = uniform;
    }
    public void WithHitSlop(int top, int right, int bottom, int left) {
        ControlExtra ex = this.EnsureExtra();
        ex.hitSlopT = top;
        ex.hitSlopR = right;
        ex.hitSlopB = bottom;
        ex.hitSlopL = left;
    }
    public void WithMinTouchSize(int minSize) {
        ControlExtra ex = this.EnsureExtra();
        ex.minTouchSize = minSize;
    }
    public virtual int InputFocusCapabilities() { return 0; }
    public virtual int PointerCursor() { return -1; }
    public bool InputFocusEligible(App app, Control root) {
        if (app == null || root == null || this.FindApp() != app
            || !root.StyleVisible() || root.IsDisabled()
            || !root.ContainsInputControl(this)) { return false; }
        Control node = this;
        while (node != null) {
            if (!node.StyleVisible() || node.IsDisabled()) { return false; }
            Control owner = node.parent;
            if (owner != null && !owner.ChildInViewport(node)) { return false; }
            node = owner;
        }
        return true;
    }
    public virtual void CollectInputFocus(App app, List<Control> controls) {
        if (app == null || !this.StyleVisible() || this.IsDisabled()) { return; }
        if (this.FindApp() == app && (this.InputFocusCapabilities() & 1) != 0) { controls.Add(this); }
        if (childNodes != null) {
            for (int i = 0; i < childNodes.Count; i = i + 1) {
                Control child = childNodes[i];
                if (this.ChildInViewport(child)) { child.CollectInputFocus(app, controls); }
            }
        }
    }
    // Like CollectInputFocus, these queries are public for automation backends in other namespaces.
    // Click subscriptions declare pointer behavior independently of Tab capability.
    // Read the existing slot: observing a decorative node must not allocate an event.
    public bool HasInputClick() {
        return extra != null && extra.Click != null && extra.Click.Count() > 0;
    }

    // Borrowing hosts expose their trees through LayoutChildren, but only the live
    // routed root can admit an endpoint. Layout ownership alone grants no input.
    public void CollectInputClicks(App app, Control root, List<Control> controls) {
        if (app == null || root == null || !this.StyleVisible() || this.IsDisabled()) { return; }
        if (this.HasInputClick() && this.InputFocusEligible(app, root) && !controls.Contains(this)) {
            controls.Add(this);
        }
        List<Control> children = this.LayoutChildren();
        if (children == null) { return; }
        for (int i = 0; i < children.Count; i = i + 1) {
            Control child = children[i];
            if (this.OwnsLayoutChild(child) && this.LayoutChildVisible(child) && this.ChildInViewport(child)) {
                child.CollectInputClicks(app, root, controls);
            }
        }
    }
    public virtual bool ContainsHostedControl(Control control) {
        if (control == null) { return false; }
        Control node = control;
        while (node != null && node != this) { node = node.parent; }
        return node == this;
    }
    public virtual bool ContainsInputControl(Control control) {
        Control node = control;
        while (node != null && node != this) { node = node.parent; }
        return node == this;
    }
    public virtual Control FindInputFocus(App app) {
        if (app == null || !this.StyleVisible() || this.IsDisabled()) { return null; }
        if (this.IsFocused(app)) { return this; }
        if (this.childNodes != null) {
            for (int i = 0; i < this.childNodes.Count; i = i + 1) {
                Control child = this.childNodes[i];
                if (!this.ChildInViewport(child)) { continue; }
                Control found = child.FindInputFocus(app);
                if (found != null) { return found; }
            }
        }
        return null;
    }
    public List<Control> BuildVisualTreePath() { return this.BuildVisualTreePathTo(null); }
    public List<Control> BuildVisualTreePathTo(Control stopBefore) {
        List<Control> path = new List<Control>();
        Control curr = this;
        while (curr != null && curr != stopBefore) {
            path.Insert(0, curr);
            curr = curr.parent;
        }
        return path;
    }
    public static void DispatchTunnel(List<Control> path, RoutedEventArgs e) {
        if (path == null) { return; }
        for (int i = 0; i < path.Count; i = i + 1) {
            if (e.handled || !e.RouteCurrent()) { return; }
            Control node = path[i];
            e.source = node;
            node.OnPreviewRoutedEvent(e);
        }
    }
    public void DispatchBubble(RoutedEventArgs e) { Control.DispatchBubble(this, e); }
    public static void DispatchBubble(Control target, RoutedEventArgs e) {
        Control.DispatchBubbleTo(target, e, null);
    }
    public static void DispatchBubbleTo(Control target, RoutedEventArgs e, Control stopBefore) {
        Control curr = target;
        while (curr != null && curr != stopBefore) {
            if (e.handled || !e.RouteCurrent()) { return; }
            e.source = curr;
            if (curr.HasExtra()) { curr.extra.stopBubble = false; }
            curr.ScrollRoutedEvent(e);
            if (!e.handled && e.RouteCurrent()) { curr.OnRoutedEvent(e); }
            if (curr.HasExtra() && curr.extra.stopBubble) {
                curr.extra.stopBubble = false;
                e.Handle();
            }
            if (!e.handled && e.eventName == "Wheel") { curr.ScrollWheel(e); }
            if (!e.RouteCurrent()) { return; }
            curr = curr.parent;
        }
    }
    public void RouteEvent(RoutedEventArgs e) { Control.RouteEvent(this, e); }
    public static void RouteEvent(Control target, RoutedEventArgs e) {
        Control.RouteEventTo(target, e, null);
    }
    public static void RouteEventTo(Control target, RoutedEventArgs e, Control stopBefore) {
        if (target == null || e == null || target == stopBefore) { return; }
        List<Control> path = target.BuildVisualTreePathTo(stopBefore);
        Control.DispatchTunnel(path, e);
        if (e.handled) { return; }
        Control.DispatchBubbleTo(target, e, stopBefore);
    }
    protected void RouteKeyboardClick(RoutedEventArgs key) {
        RoutedEventArgs click = new RoutedEventArgs("Click", this, key.x, key.y, key.pointerType);
        click.modifiers = key.modifiers;
        click.CopyKeyboardRoute(key);
        Control.RouteEvent(this, click);
    }
    public RoutedEventHandler routedHandler;
    public RoutedEventHandler previewRoutedHandler;
    public void OnRouted(RoutedEventHandler handler) { this.routedHandler = handler; }
    public void OnPreviewRouted(RoutedEventHandler handler) {
        this.previewRoutedHandler = handler;
    }
    protected bool isHovered;
    protected bool isPressed;
    public bool IsHovered() {
        return this.IsHovered(this.App);
    }
    public bool IsHovered(App app) {
        app = this.ResolveApp(app);
        if (app != null && !app.IsPointerEligible(this)) { return false; }
        if (this.isHovered) { return true; }
        if (app == null || app.focus == null) { return false; }
        int id = this.WidgetId();
        if (id > 0 && app.focus.IsHovered(id)) { return true; }
        if (commonId > 0 && app.focus.IsHovered(commonId)) { return true; }
        return false;
    }
    public bool IsPressed() {
        return this.IsPressed(this.App);
    }
    public bool IsPressed(App app) {
        app = this.ResolveApp(app);
        if (app != null && !app.IsPointerEligible(this)) { return false; }
        if (this.isPressed) { return true; }
        if (app == null || app.focus == null) { return false; }
        int id = this.WidgetId();
        if (id > 0 && app.focus.IsPressed(id)) { return true; }
        if (commonId > 0 && app.focus.IsPressed(commonId)) { return true; }
        return false;
    }
    public bool IsFocused() { return this.IsFocused(this.App); }
    public bool IsFocused(App app) {
        app = this.ResolveApp(app);
        if (app == null) { return false; }
        int id = this.WidgetId();
        if (app.focus != null) {
            if (id > 0 && app.focus.IsFocused(id)) { return true; }
            if (commonId > 0 && app.focus.IsFocused(commonId)) { return true; }
        }
        return false;
    }
    public virtual void OnPointerEnter(RoutedEventArgs e) { this.isHovered = true; }
    public virtual void OnPointerLeave(RoutedEventArgs e) {
        this.isHovered = false;
        this.isPressed = false;
    }
    public virtual void OnPointerDown(RoutedEventArgs e) { this.isPressed = true; }
    public virtual void OnPointerUp(RoutedEventArgs e) { this.isPressed = false; }
    public virtual void OnPointerCancel(RoutedEventArgs e) {
        this.isHovered = false;
        this.isPressed = false;
    }
    public virtual void OnPointerMove(RoutedEventArgs e) { }
    public virtual void OnClick(RoutedEventArgs e) {}
    public virtual void OnKeyDown(RoutedEventArgs e) { }
    public virtual void OnKeyUp(RoutedEventArgs e) { }
    public virtual void OnInputFocusLost() { }
    public virtual void OnTextInput(RoutedEventArgs e) { }
    public virtual void OnWheel(RoutedEventArgs e) { }
    public virtual void OnPreviewRoutedEvent(RoutedEventArgs e) {
        if (this.previewRoutedHandler != null) { this.previewRoutedHandler(this, e); }
    }
    public virtual void OnRoutedEvent(RoutedEventArgs e) {
        if (e.handled || !e.RouteCurrent()) { return; }
        if (this.routedHandler != null) { this.routedHandler(this, e); }
        if (e.handled || !e.RouteCurrent()) { return; }
        if (e.originalSource != null && e.originalSource != this) {
            this.OnChildEvent(e.originalSource, e.eventName);
        }
        if (e.handled || !e.RouteCurrent()) { return; }
        string ev = e.eventName;
        if (ev == "PointerEnter" || ev == "MouseEnter") { this.OnPointerEnter(e); this.TriggerEvent("Enter"); }
        else if (ev == "PointerLeave" || ev == "MouseLeave") { this.OnPointerLeave(e); this.TriggerEvent("Leave"); }
        else if (ev == "PointerDown" || ev == "MouseDown") { this.OnPointerDown(e); this.TriggerEvent("MouseDown"); }
        else if (ev == "PointerUp" || ev == "MouseUp") {
            this.OnPointerUp(e);
            if (!e.RouteCurrent()) { return; }
            this.TriggerEvent("MouseUp");
        }
        else if (ev == "PointerMove" || ev == "MouseMove") { this.OnPointerMove(e); this.TriggerEvent("Move"); }
        else if (ev == "Click") {
            this.OnClick(e);
            if (e.RouteCurrent()) { this.TriggerEvent("Click"); }
        }
        else if (ev == "KeyDown") {
            this.OnKeyDown(e);
            if (e.RouteCurrent()) { this.TriggerEvent("KeyDown"); }
        }
        else if (ev == "KeyUp") { this.OnKeyUp(e); this.TriggerEvent("KeyUp"); }
        else if (ev == "TextInput") {
            this.OnTextInput(e);
            if (e.RouteCurrent()) {
                this.TriggerEvent("TextInput");
                if (!e.handled && e.keyCode >= 32 && e.keyCode != 127) {
                    this.TriggerEvent("KeyPress");
                }
            }
        }
        else if (ev == "Wheel") { this.OnWheel(e); this.TriggerEvent("Wheel"); }
        else if (ev == "PointerCancel" || ev == "MouseCancel") { this.OnPointerCancel(e); this.TriggerEvent("Cancel"); }
        else if (e.eventName != "") { this.TriggerEvent(e.eventName); }
    }
}
