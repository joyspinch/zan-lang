    }
    public int TransitionMs(int fallback) {
        if (computedStyle != null && computedStyle.transitionMs >= 0) { return computedStyle.transitionMs; }
        if (styleTransitionMs > 0) { return styleTransitionMs; }
        return fallback;
    }
    public override string StyleType() {
        if (styleTypeLower == "") { styleTypeLower = this.Kind().ToLower(); }
        return styleTypeLower;
    }
    public override string CssAttr(string key) {
        if (key == "id") { return name; }
        return "";
    }
    public override bool CssHasAttr(string key) {
        if (key == "id") { return name != ""; }
        return false;
    }
    public override string EffectiveClass() { return Class; }
    public virtual StyleBox ResolveStyle(int state) { return this.ResolveStyle(this.App, state); }
    public virtual StyleBox ResolveStyle(App app, int state) {
        app = this.ResolveApp(app);
        if (computedStyle != null && computedStyleState == state
            && this.ComputedStyleCurrent(app)) {
            return computedStyle;
        }
        return this.ResolveStyleAs(app, this.StyleType(), this.EffectiveClass(), state);
    }
    public StyleBox Box() { return this.BoxState(this.App, Style.SNormal()); }
    public StyleBox BoxState(int state) { return this.BoxState(this.App, state); }
    public StyleBox Box(App app) { return this.BoxState(app, Style.SNormal()); }
    public StyleBox BoxState(App app, int state) {
        app = this.ResolveApp(app);
        return this.ResolveStyleCached(app, this.StyleType(), this.EffectiveClass(), state);
    }
    protected StyleBox UncachedStyleAs(App app, string type, string cls, int state) {
        app = this.ResolveApp(app);
        StyleBox box = Style.Full(app, type, cls, name, state);
        Style.Inline(box, this);
        return box;
    }
    StyleBox ResolveStyleAs(App app, string type, string cls, int state) {
        app = this.ResolveApp(app);
        return this.RememberComputedStyle(
            app, this.UncachedStyleAs(app, type, cls, state), type, cls, state);
    }
    public static StyleBox BareBox(App app, string type, int state) {
        return Style.Full(app, type, "", "", state);
    }
    StyleBox ResolveStyleCached(App app, string type, string cls, int state) {
        app = this.ResolveApp(app);
        if (computedStyleState == state && this.ComputedStyleCurrentAs(app, type, cls)) {
            return computedStyle;
        }
        return this.ResolveStyleAs(app, type, cls, state);
    }
    protected int WidgetState(App app) {
        if (this.IsDisabled()) { return Style.SDisabled(); }
        if (app == null || app.focus == null) { return 0; }
        int id = this.WidgetId();
        int st = app.focus.IsHovered(id) ? (Style.SHover() | (app.focus.IsPressed(id) ? Style.SActive() : 0)) : 0;
        if (app.focus.IsFocused(id)) { st = st | Style.SFocus(); }
        return st;
    }
    private StyleBox ResolveEasedBlendIn(App app, int id, string type, string part,
                                         string fallbackType, string cls,
                                         bool disabled, bool selected, bool isPart,
                                         int x, int y, int w, int h) {
        int latched = selected ? Style.SSelected() : 0;
        if (disabled) {
            int disState = Style.SDisabled() + latched;
            return isPart ? Style.Part(app, type, part, fallbackType, cls, name, disState)
                          : Style.Full(app, type, cls, name, disState);
        }
        app = this.ResolveApp(app);
        StyleBox base0 = isPart ? Style.Part(app, type, part, fallbackType, cls, name, latched)
                                : Style.Full(app, type, cls, name, latched);
        if (!isPart) { base0.fxId = id; }
        int ms = base0.TransitionOr(0 - 1);
        int hv = app == null ? 0 : app.StyleHoverLevelIn(id, ms, x, y, w, h);
        int pv = app == null ? 0 : app.StylePressLevelIn(id, ms, x, y, w, h);
        int fv = app == null ? 0 : app.StyleFocusLevelIn(id, ms, x, y, w, h);
        StyleBox cur = base0;
        if (hv > 0) {
            int hState = latched + Style.SHover();
            StyleBox hover = isPart ? Style.Part(app, type, part, fallbackType, cls, name, hState)
                                    : Style.Full(app, type, cls, name, hState);
            cur = StyleBox.Blend(cur, hover, Style.Curve(base0.easing, hv));
        }
        if (pv > 0) {
            int aState = latched + Style.SHover() + Style.SActive();
            StyleBox act = isPart ? Style.Part(app, type, part, fallbackType, cls, name, aState)
                                  : Style.Full(app, type, cls, name, aState);
            cur = StyleBox.Blend(cur, act, Style.Curve(base0.easing, pv));
        }
        if (fv > 0) {
            int fState = latched + Style.SFocus();
            StyleBox foc = isPart ? Style.Part(app, type, part, fallbackType, cls, name, fState)
                                  : Style.Full(app, type, cls, name, fState);
            cur = StyleBox.Blend(cur, foc, Style.Curve(base0.easing, fv));
        }
        if (!isPart) { cur.fxId = id; }
        return cur;
    }
    StyleBox ResolveEasedStyleAsIn(App app, int id, string type, string cls,
                                   bool disabled, bool selected,
                                   int x, int y, int w, int h) {
        StyleBox box = this.ResolveEasedBlendIn(app, id, type, "", "", cls,
                                                disabled, selected, false, x, y, w, h);
        Style.Inline(box, this);
        return this.RememberComputedStyle(app, box, type, cls, 0 - 1);
    }
    StyleBox ResolvePart(App app, string part, string fallbackType, int state) {
        return this.ResolvePartAs(app, this.StyleType(), part,
                                  fallbackType, this.EffectiveClass(), state);
    }
    StyleBox ResolvePartAs(App app, string type, string part,
                           string fallbackType, string cls, int state) {
        return Style.Part(app, type, part, fallbackType, cls, name, state);
    }
    StyleBox ResolveEasedPartAsIn(App app, int id, string type, string part,
                                  string fallbackType, string cls,
                                  bool disabled, bool selected,
                                  int x, int y, int w, int h) {
        return this.ResolveEasedBlendIn(app, id, type, part, fallbackType, cls,
                                        disabled, selected, true, x, y, w, h);
    }
    weak App computedStyleApp;
    int computedStyleDpi;
    bool computedStyleSys;
    private long ContextHashForControl(App app, int dep, bool anyMedia, string type, string effCls) {
        if (app == null) { return 0L; }
        if (dep == 0 && !anyMedia) { return 0L; }
        if (app.styleCtx == this) {
            Control par = parent;
            int idx = 0;
            if (dep == 1 && par != null) {
                int hint = childIndex;
                List<Control> siblings = par.childNodes;
                idx = (hint >= 0 && hint < siblings.Count && siblings[hint] == this)
                    ? hint : par.IndexOf(this);
            }
            return Style.ContextHashForNode(app, this, par, idx, dep, anyMedia, type, effCls, name);
        }
        return Style.ContextHashFast(app, dep, anyMedia);
    }
    StyleBox RememberComputedStyle(App app, StyleBox box, string type, string cls, int state) {
        int gen = app == null ? 0 : app.bgThemeGen;
        int scale = app == null ? 100 : app.metricsScale;
        int dpi = app == null ? 100 : app.dpiScale;
        if (computedStyleApp != app || computedStyleGen != gen
            || computedStyleScale != scale || computedStyleDpi != dpi) {
            surfaceNormal = null;
            surfaceTarget = null;
            surfaceFrom = null;
            surfaceBlend = null;
            surfaceState = 0;
        }
        bool prevVis = this.StyleVisible();
        computedStyle = box;
        if (app != null && prevVis != this.StyleVisible()) { app.layoutEventsDirty = true; }
        computedStyleApp = app;
        computedStyleGen = gen;
        computedStyleScale = scale;
        computedStyleDpi = dpi;
        computedStyleSys = app != null && app.isolateAppSheet;
        computedStyleType = type;
        string effCls = this.EffectiveClass();
        computedStyleClass = effCls;
        computedStyleCls = cls;
        computedStyleId = name;
        computedStyleState = state;
        int dep = Style.ContextDependencyFor(app, type, cls, name);
        computedStyleDep = dep;
        int rsig = app != null ? app.CurrentStyleRuleSig() : 0;
        computedStyleRuleSig = rsig;
        computedSelfHash = Style.SelfNodeHashKnown(this, type, effCls, name);
        computedStyleCtxHash = this.ContextHashForControl(app, dep, (rsig & 1) != 0, type, effCls);
        return box;
    }
    internal bool ComputedStyleCurrentPass(App app, int ruleSig, bool anyMedia, long mediaHash, int chainSeq) {
        if (computedStyle == null || computedStyleApp != app
            || computedStyleGen != app.bgThemeGen
            || computedStyleScale != app.metricsScale
            || computedStyleDpi != app.dpiScale
            || computedStyleSys != app.isolateAppSheet) { return false; }
        if (computedStyleRuleSig != ruleSig) {
            return this.ComputedStyleCurrent(app);
        }
        string type = this.StyleType();
        string effCls = this.EffectiveClass();
        if (computedStyleType != type || computedStyleClass != effCls
            || computedStyleCls != effCls || computedStyleId != name) { return false; }
        int dependency = computedStyleDep;
        if (dependency == 2) { return false; }
        if (dependency == 0 && !anyMedia) { return true; }
        long h = 1469598103934665603L;
        if (dependency == 1) {
            Control par = parent;
            int idx = 0;
            if (par != null) {
                h = (chainSeq != 0 && par.chSeq == chainSeq)
                    ? par.chVal : Style.AncestorChainHashFrom(par, app, chainSeq);
                int hint = childIndex;
                List<Control> siblings = par.childNodes;
                idx = (hint >= 0 && hint < siblings.Count && siblings[hint] == this)
                    ? hint : par.IndexOf(this);
            }
            h = (h ^ computedSelfHash) * 1099511628211L;
            h = (h ^ (long)idx) * 1099511628211L;
        }
        if (anyMedia) {
            h = (h ^ mediaHash) * 1099511628211L;
        }
        return computedStyleCtxHash == h;
    }
    bool ComputedStyleCurrentCore(App app, string type, string effCls, string cls) {
        if (computedStyle == null || computedStyleApp != app
            || computedStyleGen != (app == null ? 0 : app.bgThemeGen)
            || computedStyleScale != (app == null ? 100 : app.metricsScale)
            || computedStyleDpi != (app == null ? 100 : app.dpiScale)
            || computedStyleSys != (app != null && app.isolateAppSheet)
            || computedStyleType != type || computedStyleClass != effCls
            || (cls != effCls && computedStyleCls != cls)
            || computedStyleId != name) { return false; }
        int ruleSig = app != null ? app.CurrentStyleRuleSig() : 0;
        int dependency = computedStyleDep;
        if (ruleSig != computedStyleRuleSig) {
            dependency = Style.ContextDependencyFor(app, type, cls, name);
            computedStyleDep = dependency;
            computedStyleRuleSig = ruleSig;
        }
        if (dependency == 2 && app != null && app.styleCtx != null) { return false; }
        bool anyMedia = (ruleSig & 1) != 0;
        if (dependency == 0 && !anyMedia) { return true; }
        return computedStyleCtxHash == this.ContextHashForControl(app, dependency, anyMedia, type, effCls);
    }
    bool ComputedStyleCurrentAs(App app, string type, string cls) {
        return this.ComputedStyleCurrentCore(app, type, this.EffectiveClass(), cls);
    }
    bool ComputedStyleCurrent(App app) {
        string effCls = this.EffectiveClass();
        return this.ComputedStyleCurrentCore(app, this.StyleType(), effCls, effCls);
    }
