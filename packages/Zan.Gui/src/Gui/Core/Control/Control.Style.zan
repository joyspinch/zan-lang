    int StyleMarR() {
        if (marSet) { return marR; }
        if (computedStyle == null) { return 0; }
        int v = computedStyle.marR; return v < 0 ? 0 : v;
    }
    int StyleMarB() {
        if (marSet) { return marB; }
        if (computedStyle == null) { return 0; }
        int v = computedStyle.marB; return v < 0 ? 0 : v;
    }
    int StyleGap() {
        if (computedStyle != null) { return computedStyle.GapOr(gap); }
        return gap;
    }
    int StyleRowGap(int fb) {
        if (computedStyle != null) { return computedStyle.RowGapOr(fb); }
        return fb;
    }
    int StyleColGap(int fb) {
        if (computedStyle != null) { return computedStyle.ColGapOr(fb); }
        return fb;
    }
    int StyleColumns(int fb) {
        if (computedStyle != null) { return computedStyle.ColumnsOr(fb); }
        return fb;
    }
    int StyleLineHeight() {
        if (computedStyle != null && computedStyle.lineHeightKind == 2) {
            int fs = computedStyle.fontPx > 0
                ? computedStyle.fontPx : computedStyle.envRemPx;
            return (int)((long)computedStyle.lineHeight * (long)fs / 1000);
        }
        if (computedStyle != null) { return computedStyle.lineHeight; }
        return 0;
    }
    bool StyleVisible() {
        if (!visible) { return false; }
        if (computedStyle == null) { return true; }
        return computedStyle.display != 2 && computedStyle.visible != 0;
    }
    internal bool treeCompositing;
    void PaintStyleBox(App app) {
        StyleBox s = paintedStyle != null ? paintedStyle : this.ResolvePaintedSurface(app);
        if (wiresOwnEvents || styleSurfaceOwned || s == null) { return; }
        s.Paint(app, bx, by, bw, bh);
    }
    protected StyleBox ResolvePaintedSurface(App app) {
        return this.ResolvePaintedSurfaceWithState(app, this.SurfaceState(app));
    }
    internal StyleBox ResolvePaintedSurfaceKnown(App app, bool selfDisabled) {
        return this.ResolvePaintedSurfaceWithState(app, this.SurfaceStateKnown(app, selfDisabled));
    }
    private StyleBox ResolvePaintedSurfaceWithState(App app, int state) {
        StyleBox box = computedStyle;
        int normalState = computedStyleState < 0 ? 0 : computedStyleState;
        int key = extra != null ? extra.surfaceTransitionKey : 0;
        if (state == normalState && key == 0 && surfaceFrom == null
            && (surfaceNormal == box || surfaceNormal == null)) {
            if (surfaceNormal == null) {
                surfaceNormal = box;
                surfaceTarget = box;
                surfaceState = state;
            }
            if (box != null && box.motion != null) {
                box = this.ApplyKeyframeAnimation(app, box);
            } else if (kfAnimName != null && kfAnimName.Length > 0) {
                kfAnimName = "";
                kfWasPaused = false;
            }
            paintedStyle = box;
            if (box != null) { box.treeComposite = treeCompositing; }
            return box;
        }
        box = this.PaintSurface(app, box, normalState, state, key);
        if (box != null && box.motion != null) {
            box = this.ApplyKeyframeAnimation(app, box);
        } else if (kfAnimName != null && kfAnimName.Length > 0) {
            kfAnimName = "";
            kfWasPaused = false;
        }
        paintedStyle = box;
        if (box != null) { box.treeComposite = treeCompositing; }
        return box;
    }
    protected StyleBox paintedStyle;
    protected int PaintedForeground(StyleBox style, string ownerClass) {
        if (style == null) { return 0; }
        int foreground = style.FgOr(0);
        if (!style.foregroundDeclared && Class != null && Class.Length > 0
            && Style.Has(Class, ownerClass)
            && parent != null && parent.paintedStyle != null) {
            return parent.paintedStyle.FgOr(foreground);
        }
        return foreground;
    }
    protected virtual Control SurfaceInputOwner() { return this.InputFocusCapabilities() != 0 ? this : null; }
    internal int cachedPassStateSeq;
    internal int cachedPassStateVal;
    internal int SurfaceStateKnown(App app, bool selfDisabled) {
        int state = computedStyleState < 0 ? 0 : computedStyleState;
        if (app == null) { return state; }
        int result;
        if (selfDisabled) {
            result = state | Style.SDisabled();
        } else if (!app.SurfaceInteractiveActive()) {
            result = state;
        } else {
            Control owner = this.SurfaceInputOwner();
            if (owner == null || owner == this) {
                result = state | app.RetainedSurfaceStateKnown(this, false);
            } else {
                result = state | app.RetainedSurfaceState(owner);
            }
        }
        int seq = Style.chainActiveSeq;
        if (seq != 0 && Style.chainApp == app) {
            cachedPassStateSeq = seq;
            cachedPassStateVal = result;
        }
        return result;
    }
    internal int SurfaceState(App app) {
        int state = computedStyleState < 0 ? 0 : computedStyleState;
        if (app == null) { return state; }
        Control owner = this.SurfaceInputOwner();
        return state | app.RetainedSurfaceState(owner != null ? owner : this);
    }
    private StyleBox surfaceNormal;
    private StyleBox surfaceTarget;
    private StyleBox surfaceFrom;
    private StyleBox surfaceBlend;
    private int surfaceDuration;
    private int surfaceDelay;
    private int surfacePropMask;
    private int surfaceState;
    private int surfaceStartMs;
    private string kfAnimName;
    private int kfStartMs;
    private int kfPausedElapsed;
    private bool kfWasPaused;
    protected void SetSurfaceTransitionKey(int key) {
        if (key == 0 && this.extra == null) { return; }
        this.EnsureExtra().surfaceTransitionKey = key;
    }
    private StyleBox PaintSurface(App app, StyleBox normal, int normalState, int state, int key) {
        if (app == null) { return normal; }
        int paintedKey = extra != null ? extra.paintedSurfaceTransitionKey : 0;
        bool keyChanged = key != 0 && key != paintedKey;
        bool stateChanged = state != surfaceState || keyChanged;
        bool hadSurface = surfaceNormal != null;
        bool normalChanged = surfaceNormal != normal;
        if (normalChanged || stateChanged || surfaceTarget == null) {
            StyleBox target = normal;
            if (state != normalState) {
                target = Style.Full(app, computedStyleType, computedStyleCls, name, state);
                Style.Inline(target, this);
            }
            if (target == null) {
                surfaceFrom = null;
                surfaceBlend = null;
                surfaceNormal = normal;
                surfaceTarget = null;
                surfaceState = state;
                return normal;
            }
            StyleBox previous = surfaceTarget == null
                ? (surfaceNormal != null ? surfaceNormal : normal)
                : this.SurfaceSample(app);
            surfaceDuration = target.transitionMs;
            surfaceDelay = target.motion != null ? target.motion.transitionDelayMs : 0;
            surfacePropMask = target.motion != null ? target.motion.transitionPropMask : 0;
            bool allowTrans = hadSurface && previous != null && surfaceDuration > 0 && surfacePropMask != MotionSpec.PropNone()
                && !app.reducedMotion && (state & Style.SDisabled()) == 0
                && (surfaceState & Style.SDisabled()) == 0
                && !previous.SameSurface(target);
            surfaceFrom = allowTrans ? previous : null;
            surfaceStartMs = app.nowMs;
            surfaceBlend = null;
            surfaceNormal = normal;
            surfaceTarget = target;
            surfaceState = state;
            if (keyChanged) { this.EnsureExtra().paintedSurfaceTransitionKey = key; }
        }
        StyleBox result = this.SurfaceSample(app);
        if (surfaceFrom != null && surfaceTarget != null && result != null) {
            int padX = (int)Math.Max(Math.Abs(surfaceFrom.tx), Math.Abs(surfaceTarget.tx)) + (int)Math.Abs(result.tx);
            int padY = (int)Math.Max(Math.Abs(surfaceFrom.ty), Math.Abs(surfaceTarget.ty)) + (int)Math.Abs(result.ty);
            app.RequestAnimationFrameIn(bx - padX, by - padY, bw + padX * 2, bh + padY * 2);
        }
        return result;
    }
    private StyleBox SurfaceSample(App app) {
        StyleBox target = surfaceTarget;
        if (surfaceFrom == null || target == null || app == null) { return target; }
        int elapsed = app.nowMs - surfaceStartMs;
        if (elapsed < 0) { elapsed = 0; }
        if (surfaceDuration <= 0 || app.reducedMotion || elapsed >= surfaceDelay + surfaceDuration) {
            surfaceFrom = null;
            surfaceBlend = null;
            return target;
        }
        if (elapsed <= surfaceDelay) {
            if (surfacePropMask == 0) { return surfaceFrom; }
            if (surfaceBlend == null) { surfaceBlend = target.Clone(); }
            StyleBox.BlendSurfaceInto(surfaceBlend, surfaceFrom, target, 0, surfacePropMask);
            return surfaceBlend;
        }
        int activeElapsed = elapsed - surfaceDelay;
        int progress = (int)((long)activeElapsed * 1000 / surfaceDuration);
        int curved = target.motion != null
            ? target.motion.EvalTransitionCurve(target.easing, progress)
            : Style.Curve(target.easing, progress);
        if (surfaceBlend == null) { surfaceBlend = target.Clone(); }
        StyleBox.BlendSurfaceInto(surfaceBlend, surfaceFrom, target, curved, surfacePropMask);
        return surfaceBlend;
    }
    private StyleBox ApplyKeyframeAnimation(App app, StyleBox box) {
        if (box == null || box.motion == null || box.motion.animName == "" || app == null) {
            kfAnimName = "";
            kfWasPaused = false;
            return box;
        }
        MotionSpec m = box.motion;
        CssKeyframeRule rule = Style.FindKeyframes(app, m.animName);
        if (rule == null || rule.stops.Count == 0) {
            return box;
        }
        if (kfAnimName != m.animName) {
            kfAnimName = m.animName;
            kfStartMs = app.nowMs;
            kfPausedElapsed = 0;
            kfWasPaused = false;
        }
        int elapsed = 0;
        if (m.animPaused) {
            if (!kfWasPaused) {
                kfPausedElapsed = app.nowMs - kfStartMs;
                kfWasPaused = true;
            }
            elapsed = kfPausedElapsed;
        } else {
            if (kfWasPaused) {
                kfStartMs = app.nowMs - kfPausedElapsed;
                kfWasPaused = false;
            }
            elapsed = app.nowMs - kfStartMs;
        }
        if (elapsed < 0) { elapsed = 0; }
        int delay = m.animDelayMs;
        int dur = box.animMs;
        int iters = m.animIterations;
        int dir = m.animDirection;
        int fill = m.animFillMode;

        if (app.reducedMotion) {
            if (fill == 1 || fill == 3) {
                int endP = (dir == 1 || (dir == 3 && (iters < 0 || (iters % 2) == 1))
                    || (dir == 2 && iters > 0 && (iters % 2) == 0)) ? 0 : 1000;
                return rule.Evaluate(box, endP);
            }
            return box;
        }

        if (iters == 0) { return box; }

        if (elapsed < delay) {
            if (!m.animPaused) { app.RequestAnimationFrameIn(bx, by, bw, bh); }
            if (fill == 2 || fill == 3) {
                int startP = (dir == 1 || dir == 3) ? 1000 : 0;
                return rule.Evaluate(box, startP);
            }
            return box;
        }

        int active = elapsed - delay;
        if (dur <= 0) {
            if (fill == 1 || fill == 3) {
                int endP = (dir == 1 || (dir == 3 && (iters < 0 || (iters % 2) == 1))
                    || (dir == 2 && iters > 0 && (iters % 2) == 0)) ? 0 : 1000;
                return rule.Evaluate(box, endP);
            }
            return box;
        }

        int cycle = active / dur;
        bool finished = iters > 0 && cycle >= iters;
        if (finished) {
            if (fill == 1 || fill == 3) {
                int lastCycle = iters - 1;
                bool rev = dir == 1 || (dir == 2 && (lastCycle % 2) == 1) || (dir == 3 && (lastCycle % 2) == 0);
                return rule.Evaluate(box, rev ? 0 : 1000);
            }
            return box;
        }

        int inCycle = active % dur;
        int rawP = (int)((long)inCycle * 1000 / dur);
        bool reverse = dir == 1 || (dir == 2 && (cycle % 2) == 1) || (dir == 3 && (cycle % 2) == 0);
        int directedP = reverse ? 1000 - rawP : rawP;
        int curvedP = m.EvalAnimCurve(box.easing, directedP);
        StyleBox sampled = rule.Evaluate(box, curvedP);
        if (!m.animPaused && sampled != null) {
            int padX = (int)Math.Abs(sampled.tx) + 8;
            int padY = (int)Math.Abs(sampled.ty) + 8;
            app.RequestAnimationFrameIn(bx - padX, by - padY, bw + padX * 2, bh + padY * 2);
        }
        return sampled;
    }
    Control Prefer(int w, int h) {
        prefW = w;
        prefH = h;
        prefSet = true;
        fillW = false;
        fillH = false;
        return this;
    }
    Control Place(int x, int y) {
        mx = x;
        my = y;
        this.inlineStyleCss = "position: absolute; left: " + x + "px; top: " + y + "px;";
        return this;
    }
    Control Pad(int p) {
        padL = p;
        padT = p;
        padR = p;
        padB = p;
        padSet = true;
        return this;
    }
    Control Padding(int top, int right, int bottom, int left) {
        padT = top;
        padR = right;
        padB = bottom;
        padL = left;
        padSet = true;
        return this;
    }
    Control Margin(int m) {
        marL = m;
        marT = m;
        marR = m;
        marB = m;
        marSet = true;
        return this;
    }
    Control Margin(int top, int right, int bottom, int left) {
        marT = top;
        marR = right;
        marB = bottom;
        marL = left;
        marSet = true;
        return this;
    }
    Control Gap(int g) { gap = g; return this; }
    Control SetShown(bool v) { visible = v; return this; }
    Control HintWrapWidth(int px) {
        if (px < 0) { px = 0; }
        hintWrapW = px;
        return this;
    }
}
