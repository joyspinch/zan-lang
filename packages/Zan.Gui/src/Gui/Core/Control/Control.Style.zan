    public void InlineStyle(string css) {
        StyleSheet.ApplyInline(this, css != null ? css : "");
    }
    public void AddStyle(string css) {
        if (css == null || css == "") { return; }
        string cur = this.inlineStyleCss;
        StyleSheet.ApplyInline(this, cur == "" ? css : cur + "; " + css);
    }
    public void TransitionEase(int ms, string easing) {
        styleTransitionMs = ms;
        computedStyle = null;
        if (easing != null && easing != "") { this.AddStyle("transition-timing-function: " + easing); }
    }
    public void Opacity(int pct) { this.SetMotionOpacity(pct * 10); }
    public void Transform(string expr) {
        if (expr == null || expr == "") { return; }
        this.AddStyle("transform: " + expr);
    }
    public void Translate(int dx, int dy) { this.SetMotionOffset(dx, dy); }
    public void ScalePct(int pct) {
        ControlExtra ex = this.EnsureExtra();
        int sc = pct > 0 ? pct * 10 : 1000;
        if (ex.motionScale == sc) { return; }
        ex.motionScale = sc;
        ex.motionActive = ex.motionTx != 0 || ex.motionTy != 0 || sc != 1000
            || ex.motionRotate != 0 || ex.motionOpacity != 1000;
        computedStyle = null;
    }
    public void Rotate(int deg) {
        ControlExtra ex = this.EnsureExtra();
        if (ex.motionRotate == deg) { return; }
        ex.motionRotate = deg;
        ex.motionActive = ex.motionTx != 0 || ex.motionTy != 0 || ex.motionScale != 1000
            || deg != 0 || ex.motionOpacity != 1000;
        computedStyle = null;
    }
    public void SetMotionOffset(int dx, int dy) {
        ControlExtra ex = this.EnsureExtra();
        if (ex.motionActive && ex.motionTx == dx && ex.motionTy == dy) { return; }
        ex.motionTx = dx;
        ex.motionTy = dy;
        ex.motionActive = dx != 0 || dy != 0 || ex.motionScale != 1000
            || ex.motionRotate != 0 || ex.motionOpacity != 1000;
        computedStyle = null;
    }
    public void SetMotionTransform(int dx, int dy, int scalePm, int rotateDeg) {
        ControlExtra ex = this.EnsureExtra();
        int sc = scalePm > 0 ? scalePm : 1000;
        if (ex.motionActive && ex.motionTx == dx && ex.motionTy == dy
            && ex.motionScale == sc && ex.motionRotate == rotateDeg) { return; }
        ex.motionTx = dx;
        ex.motionTy = dy;
        ex.motionScale = sc;
        ex.motionRotate = rotateDeg;
        ex.motionActive = dx != 0 || dy != 0 || sc != 1000
            || rotateDeg != 0 || ex.motionOpacity != 1000;
        computedStyle = null;
    }
    public void SetMotionOpacity(int opacityPm) {
        ControlExtra ex = this.EnsureExtra();
        int op = opacityPm < 0 ? 0 : (opacityPm > 1000 ? 1000 : opacityPm);
        if (ex.motionOpacity == op) { return; }
        ex.motionOpacity = op;
        ex.motionActive = ex.motionTx != 0 || ex.motionTy != 0 || ex.motionScale != 1000
            || ex.motionRotate != 0 || op != 1000;
        computedStyle = null;
    }
    public void ResetMotion() {
        if (this.extra == null || !this.extra.motionActive) { return; }
        this.extra.motionTx = 0;
        this.extra.motionTy = 0;
        this.extra.motionScale = 1000;
        this.extra.motionRotate = 0;
        this.extra.motionOpacity = 1000;
        this.extra.motionActive = false;
        computedStyle = null;
    }
    public bool HasMotion() { return this.extra != null && this.extra.motionActive; }
    public int MotionTx() { return this.extra != null && this.extra.motionActive ? this.extra.motionTx : 0; }
    public int MotionTy() { return this.extra != null && this.extra.motionActive ? this.extra.motionTy : 0; }
    public void BackdropBlur(int px) { this.AddStyle("backdrop-filter: blur(" + Convert.ToString(px) + "px)"); }
    public void Sheen(int pct) { this.AddStyle("-zan-sheen: " + Convert.ToString(pct) + "%"); }
    public void Keyframe(string animName, int durationMs) {
        if (animName == null || animName == "") { return; }
        this.AddStyle("animation: " + animName + " " + Convert.ToString(durationMs) + "ms");
    }
    public void Anim(string animName, int durationMs) { this.Keyframe(animName, durationMs); }
