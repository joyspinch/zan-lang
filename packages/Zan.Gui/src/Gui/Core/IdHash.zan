using System;
namespace Gui;
public class IdHash {
    public static int HashString(string key, int seed) {
        int h = seed;
        if (h == 0) { h = 0x811C9DC5; }
        int start = 0;
        int sep = key.IndexOf("###");
        if (sep >= 0) { start = sep + 3; }
        int len = key.Length;
        for (int i = start; i < len; i = i + 1) {
            int b = (int)key[i] & 255;
            h = (h ^ b) * 16777619;
        }
        int id = 10000000 + (h & 1073741823);
        return id;
    }
    public static int HashString(string key) { return IdHash.HashString(key, 0); }
    public static int HashStr(string key) { return IdHash.HashString(key, 0); }
    public static int HashInt(int key, int seed) {
        int h = seed;
        if (h == 0) { h = 0x811C9DC5; }
        h = (h ^ (key & 255)) * 16777619;
        h = (h ^ ((key >>> 8) & 255)) * 16777619;
        h = (h ^ ((key >>> 16) & 255)) * 16777619;
        h = (h ^ ((key >>> 24) & 255)) * 16777619;
        int id = 10000000 + (h & 1073741823);
        return id;
    }
    public static int HashInt(int key) { return IdHash.HashInt(key, 0); }
}
