using System;

namespace Gui;

// 32 位 FNV-1a 路径哈希算法实现。
// 用于现代即时模式 UI 的层级路径 ID（Path Hash ID Stack）计算。
public class IdHash {
    // 对字符串 key 进行 FNV-1a 哈希。
    // 支持 "Label###CustomId" 语法：若包含 "###"，则仅对其后半部分进行哈希。
    static int HashString(string key, int seed) {
        int h = seed;
        if (h == 0) {
            h = 0x811C9DC5;
        }
        int start = 0;
        int sep = key.IndexOf("###");
        if (sep >= 0) {
            start = sep + 3;
        }
        int len = key.Length;
        for (int i = start; i < len; i = i + 1) {
            int b = (int)key[i] & 255;
            h = (h ^ b) * 16777619;
        }
        // 将哈希输出安全映射至 [10_000_000, 1_083_741_823]
        int id = 10000000 + (h & 1073741823);
        return id;
    }

    // 对 32 位整型 key 进行 FNV-1a 哈希（展开 4 字节）。
    static int HashInt(int key, int seed) {
        int h = seed;
        if (h == 0) {
            h = 0x811C9DC5;
        }
        h = (h ^ (key & 255)) * 16777619;
        h = (h ^ ((key >>> 8) & 255)) * 16777619;
        h = (h ^ ((key >>> 16) & 255)) * 16777619;
        h = (h ^ ((key >>> 24) & 255)) * 16777619;
        int id = 10000000 + (h & 1073741823);
        return id;
    }
}
