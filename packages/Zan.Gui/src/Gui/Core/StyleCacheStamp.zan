using System;
namespace Gui;

// 组件级局部样式缓存戳：统一承载 App/主题/缩放/DPI/规则集/上下文依赖/类名/name 的失效校验，
// 仅持 weak App 引用，消除各控件手写 8-9 个缓存字段带来的重复样板与强引用环。
public class StyleCacheStamp {
    private weak App host;
    private int gen;
    private int scale;
    private int dpi;
    private int ruleSig;
    private int dep;
    private long ctxHash;
    private string cls;
    private string nm;

    public bool IsCurrent(App app, string clsVal, string nameVal) {
        if (app == null || host != app || gen != app.bgThemeGen
            || scale != app.metricsScale || dpi != app.dpiScale) {
            return false;
        }
        int rsig = app.CurrentStyleRuleSig();
        if (ruleSig != rsig || cls != clsVal || nm != nameVal) {
            return false;
        }
        bool anyMedia = (rsig & 1) != 0;
        if (dep == 0 && !anyMedia) { return true; }
        return ctxHash == Style.ContextHashFast(app, dep, anyMedia);
    }

    public bool IsCurrent(App app, string clsVal) {
        return this.IsCurrent(app, clsVal, "");
    }

    public void Commit(App app, string clsVal, string nameVal, int maxDep) {
        if (app == null || maxDep >= 5) {
            host = null;
            return;
        }
        int rsig = app.CurrentStyleRuleSig();
        bool anyMedia = (rsig & 1) != 0;
        host = app;
        gen = app.bgThemeGen;
        scale = app.metricsScale;
        dpi = app.dpiScale;
        ruleSig = rsig;
        dep = maxDep;
        ctxHash = (maxDep == 0 && !anyMedia) ? 0L : Style.ContextHashFast(app, maxDep, anyMedia);
        cls = clsVal;
        nm = nameVal;
    }

    public void Commit(App app, string clsVal, int maxDep) {
        this.Commit(app, clsVal, "", maxDep);
    }

    public static int MaxDep(App app, int current, string type, string clsVal, string nameVal) {
        int d = Style.ContextDependencyFor(app, type, clsVal, nameVal);
        return d > current ? d : current;
    }

    public static int MaxDep(App app, int current, string type, string clsVal) {
        return StyleCacheStamp.MaxDep(app, current, type, clsVal, "");
    }
}
