namespace Gui;

// The App retains active records; every borrowed endpoint remains weak.
public class InputRetirementToken {
    weak App host;
    weak Control scope;
    weak InputRetirementObserver owner;
    bool active;

    // Reports the registration bit. Weak endpoint death is pruned on the next
    // Watch/retirement operation; this query does not establish endpoint liveness.
    public bool IsActive() { return active; }

    public void Invalidate() {
        if (!active) { return; }
        active = false;
        App app = host;
        host = null; scope = null; owner = null;
        if (app != null) { app.ForgetInputRetirement(this); }
    }

    void Notify() {
        if (!active) { return; }
        InputRetirementObserver observer = scope != null ? owner : null;
        this.Invalidate();
        if (observer != null) { observer.OnInputRetired(this); }
    }
}
