using System;

namespace Gui;

// 脏区与受损条带追踪器（Damage / Dirty Region Tracker）。
// 负责管理即时模式与局部帧渲染过程中的矩形求并、边界裁剪、外扩防羽化、
// 面积估算以及像素欠账（Dirty Debt）回升逻辑，彻底从 App.zan 中抽离纯几何算法。
class DamageTracker {
    int x;
    int y;
    int w;
    int h;
    bool hasDamage;
    int debtCount;

    DamageTracker() {
        this.Reset();
        this.debtCount = 0;
    }

    int X() { return this.x; }
    int Y() { return this.y; }
    int Width() { return this.w; }
    int Height() { return this.h; }
    bool HasDamage() { return this.hasDamage && this.w > 0 && this.h > 0; }

    // 清空当前损伤矩形。
    void Reset() {
        this.x = 0;
        this.y = 0;
        this.w = 0;
        this.h = 0;
        this.hasDamage = false;
    }

    // 直接设置当前的损伤矩形。
    void Set(int nx, int ny, int nw, int nh) {
        this.x = nx;
        this.y = ny;
        this.w = nw > 0 ? nw : 0;
        this.h = nh > 0 ? nh : 0;
        this.hasDamage = (this.w > 0 && this.h > 0);
    }

    // 向当前受损矩形并入另一个矩形（Union）。
    void Union(int ox, int oy, int ow, int oh) {
        if (ow <= 0 || oh <= 0) { return; }
        if (!this.hasDamage || this.w <= 0 || this.h <= 0) {
            this.Set(ox, oy, ow, oh);
            return;
        }
        int x0 = this.x < ox ? this.x : ox;
        int y0 = this.y < oy ? this.y : oy;
        int x1 = (this.x + this.w) > (ox + ow) ? (this.x + this.w) : (ox + ow);
        int y1 = (this.y + this.h) > (oy + oh) ? (this.y + this.h) : (oy + oh);
        this.x = x0;
        this.y = y0;
        this.w = x1 - x0;
        this.h = y1 - y0;
        this.hasDamage = true;
    }

    // 外扩当前损伤矩形（防羽化、抗锯齿或外阴影残留）。
    void Pad(int padX, int padY) {
        if (!this.hasDamage) { return; }
        this.x = this.x - padX;
        this.y = this.y - padY;
        this.w = this.w + padX * 2;
        this.h = this.h + padY * 2;
    }

    // 将当前损伤矩形限制在画布/窗口边界之内。
    void ClampTo(int boundW, int boundH) {
        if (!this.hasDamage) { return; }
        if (this.x < 0) {
            this.w = this.w + this.x;
            this.x = 0;
        }
        if (this.y < 0) {
            this.h = this.h + this.y;
            this.y = 0;
        }
        if (this.x + this.w > boundW) {
            this.w = boundW - this.x;
        }
        if (this.y + this.h > boundH) {
            this.h = boundH - this.y;
        }
        if (this.w <= 0 || this.h <= 0) {
            this.Reset();
        }
    }

    // 计算当前受损矩形的像素面积。
    int Area() {
        if (!this.hasDamage || this.w <= 0 || this.h <= 0) { return 0; }
        return this.w * this.h;
    }

    // 判断受损矩形是否占满或接近整窗（例如面积超过总面积的一半），
    // 当面积过大时，条带局部呈现不再合算，建议退回整窗呈现。
    bool IsFullWindow(int totalW, int totalH) {
        if (!this.hasDamage) { return false; }
        if (totalW <= 0 || totalH <= 0) { return false; }
        int area = this.Area();
        // 面积超过一半 (area * 2 >= totalW * totalH)
        return (area * 2) >= (totalW * totalH);
    }

    // 记录一次条带欠账（例如由于遮挡或重叠导致的局部脏区丢失）。
    void NoteDebt() {
        this.debtCount = this.debtCount + 1;
    }

    // 是否存在未补偿的脏区欠账。
    bool HasDebt() {
        return this.debtCount > 0;
    }

    // 清空欠账计数。
    void ClearDebt() {
        this.debtCount = 0;
    }
}
