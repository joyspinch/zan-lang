namespace Gui;

// Borrows one existing tree into the shared adapter chain without adopting it.
// The caller owns content and controls its visible lifetime explicitly.
public class ControlInputHost : InputRootAdapter {
    weak Control root;
    bool shown;
    int lifetime;

    public ControlInputHost(Control contentRoot) : base("control_input_host") { root = contentRoot; }
    public Control ContentRoot() { return root; }

    public override void Bind(App app) {
        if (app == null) { return; }
        if (inputApp != null && inputApp != app) {
            int before = lifetime;
            this.Hide();
            if (inputApp != null || lifetime != before + 1) { return; }
        }
        lifetime = lifetime + 1;
        shown = true;
        Control control = root;
        if (control != null) { control.InheritApp(app); }
        base.Bind(app);
    }

    public void Hide() {
        if (!shown && inputApp == null) { return; }
        int session = lifetime + 1; lifetime = session;
        shown = false;
        Control control = root;
        App app = inputApp;
        if (app != null && control != null) { app.ReleaseInputSubtree(control); }
        if (lifetime != session || shown) { return; }
        this.Detach();
    }

    public override Control HitTest(int x, int y, int pointerType) {
        Control control = root;
        Control hit = shown && control != null ? control.HitTest(x, y, pointerType) : null;
        if (hit != null) { return hit; }
        return content != null ? content.HitTest(x, y, pointerType) : null;
    }

    public override bool ContainsHostedControl(Control control) {
        if (control == null) { return false; }
        if (base.ContainsHostedControl(control)) { return true; }
        Control borrowed = root;
        return shown && borrowed != null && borrowed.ContainsHostedControl(control);
    }

    public override bool ContainsInputControl(Control control) {
        if (control == this) { return true; }
        Control borrowed = root;
        if (shown && borrowed != null && borrowed.StyleVisible() && borrowed.ContainsInputControl(control)) { return true; }
        return content != null && content.ContainsInputControl(control);
    }

    public override Control FindInputFocus(App app) {
        Control control = root;
        Control focused = shown && control != null ? control.FindInputFocus(app) : null;
        if (focused != null) { return focused; }
        return content != null ? content.FindInputFocus(app) : null;
    }

    public override void CollectInputFocus(App app, List<Control> controls) {
        Control control = root;
        if (shown && control != null) { control.CollectInputFocus(app, controls); }
        base.CollectInputFocus(app, controls);
    }

    protected override void OnReleaseInput(App app) {
        Control control = root;
        if (control != null) { app.ReleaseInputSubtree(control); }
    }
}
