using System;
using System.Json;
using Gui;
using Gui.Backend;
using Gui.Widget;
using Gui.Component;

namespace Gui;

// 独立泵的停止条件（返回 true 即结束 PumpStandaloneUntil 循环）。
delegate bool ChildWindowStop();

// GUI 控件排版布局与事件分发契约。
// 核心契约与语义定义。
// GUI 控件排版布局与事件分发契约。
// 接口数据协议与执行契约。
// GUI 控件排版布局与事件分发契约。
// 接口数据协议与执行契约。
// 核心契约与语义定义。
// 接口数据协议与执行契约。
// 核心契约与语义定义。
// 接口数据协议与执行契约。
// 控件属性绑定快照实体（消除 boundKeys/boundSnaps 平行列表反模式）。
class ChildBoundSnapshot {
    public Control control;
    public string snapshot;

    ChildBoundSnapshot(Control control, string snapshot) {
        this.control = control;
        this.snapshot = snapshot;
    }
}

// 模板原型展开元数据实体（消除 tmplKeys/tmplCounts 平行列表反模式）。
class ChildTemplateMeta {
    public Control template;
    public int lastCount;

    ChildTemplateMeta(Control template, int lastCount) {
        this.template = template;
        this.lastCount = lastCount;
    }
}

// 展开行与归属模板关联实体（消除 rowRoots/rowTmpl 平行列表反模式）。
class ChildExpandedRow {
    public Control rowRoot;
    public Control template;

    ChildExpandedRow(Control rowRoot, Control template) {
        this.rowRoot = rowRoot;
        this.template = template;
    }
}

// 行内控件绑定作用域实体（消除 scopeKeys/scopeVals 平行列表反模式）。
class ChildScopeBinding {
    public Control control;
    public JsonValue item;

    ChildScopeBinding(Control control, JsonValue item) {
        this.control = control;
        this.item = item;
    }
}

// 核心契约与语义定义。
class ChildWindow {
    App host;
    Control root;
    HandlerRegistry handlers;
    JsonValue model;
    bool open;
    bool destroyed;
    int idBase;
    Action renderCb;
    // 绑定快照旁表：SyncFromNode 记录"模型侧确认的控件值"，
    // SyncChangedNode 据此判断用户是否编辑过。
    List<ChildBoundSnapshot> boundSnapshots;
    // `<template data-for>` 原型展开状态列表。
    List<ChildTemplateMeta> tmplMetas;
    // 已展开的行根（原型子项克隆）及其归属模板。
    List<ChildExpandedRow> expandedRows;
    // 行内绑定作用域（行内声明了 bind/bindIf 的控件 → 本项 JsonValue）。
    List<ChildScopeBinding> scopeBindings;

    // 构造：全部字段置空/默认（idBase 基线 900000）。
    ChildWindow() {
        host = null;
        root = null;
        handlers = null;
        model = null;
        open = false;
        destroyed = false;
        idBase = 900000;
        renderCb = null;
        boundSnapshots = null;
        tmplMetas = null;
        expandedRows = null;
        scopeBindings = null;
    }

    // 核心契约与执行状态转移规范。
    virtual string Title() { return "Zan"; }

    // 核心契约与语义定义。
    virtual int Width() { return 560; }
    // 初始客户区高度（未缩放像素）。
    virtual int Height() { return 560; }

    // 子窗口标题栏按钮集合（不可调整尺寸的对话框自动隐藏最大化按钮）。
    virtual bool ShowMinimize() { return true; }
    // 是否保留最大化按钮。
    virtual bool ShowMaximize() { return true; }

    // 子窗口控件 ID 分配基线，避免跨窗口 ID 冲突。
    virtual int IdBase() { return 900000; }

    // 底层宿主应用实例句柄，供即时渲染模式分发帧。
    App Host() { return host; }

    // 即时渲染模式回调；设置后主循环直接分发绘制回调而非遍历控件树。
    void SetRender(Action a) {
        renderCb = a;
    }

    // GUI 控件排版布局与事件分发契约。
    // 核心契约与执行状态转移规范。
    void SetRoot(Control tree, JsonValue m) {
        root = tree;
        model = m;
        handlers = new HandlerRegistry();
        // 独立泵的窗口不经过 Control.Run（那里登记驱动根），这里补
        // 登记：ZAN_UI_SCRIPT 会话才能 dump tree 这棵保留树。
        UiDriver.SetRoot(tree);
    }

    // 接口数据协议与执行契约。
    void Handle(string name, Action a) {
        if (handlers == null) { handlers = new HandlerRegistry(); }
        handlers.Set(name, a);
    }

    // 接口数据协议与执行契约。
    // GUI 控件排版布局与事件分发契约。
    // passed as the argument (Html.WireArg / WireNode 闭包捕获)。
    void HandleArg(string name, Action<string> a) {
        if (handlers == null) { handlers = new HandlerRegistry(); }
        handlers.SetArg(name, a);
    }

    // 注册绑定到 `name` 的带 sender 处理器（平行通道）：Wire() 解析到
    // 具体控件时，把该控件作为实参交给处理器——一个 HandleSender
    // 可以服务整棵树上的多个绑定，处理器按 sender 区分来源。
    // 与 Handle 相互独立；同名两槽都注册时各建一条订阅（多播）。
    void HandleSender(string name, ControlEvent a) {
        if (handlers == null) { handlers = new HandlerRegistry(); }
        handlers.SetSender(name, a);
    }

    // 接口数据协议与执行契约。
    // GUI 控件排版布局与事件分发契约。
    // 核心契约与语义定义。
    void Wire() {
        if (root == null) { return; }
        WireNode(root);
        RegisterTemplates(root);
        SyncFromModel();
    }

    // 递归解析控件树上的 `on<Event>` 处理器名并绑定到已注册的 Action。
    // sender 槽（HandleSender）绑定闭包捕获被接线控件；带 `data-arg`
    // 声明的控件优先走带参槽（实参闭包捕获 = 值快照）；带参槽未注册
    // 时回落无参解析。各槽独立成订阅，同名多槽注册时多播。
    void WireNode(Control c) {
        for (int i = 0; i < c.events.Count; i = i + 1) {
            string evt = c.events[i].key;
            string hname = c.events[i].val;
            if (hname == "" || handlers == null) { continue; }
            ControlEvent sa = handlers.GetSender(hname);
            if (sa != null) {
                Control sc = c;
                c.BindEvent(evt, () => { sa(sc); });
            }
            if (c.handlerArg != "") {
                Action<string> aa = handlers.GetArg(hname);
                if (aa != null) {
                    string arg = c.handlerArg;
                    c.BindEvent(evt, () => { aa(arg); });
                    continue;
                }
            }
            Action a = handlers.Get(hname);
            if (a != null) {
                c.BindEvent(evt, a);
            }
        }
        // <a href> 的缺省导航（P5 链接语义）：模板行克隆等二次接线
        // 的元素在这里补上；已有 Click 监听即宿主接管（AutoLink
        // 内部幂等）。编译通道生成的树挂在子窗口时也走这条补齐。
        // 扫描实现在 Gui.Html（未安装 = 空操作），App 编译图不背它。
        App.AutoLinkTree(c, host);
        for (int j = 0; j < c.children.Count; j = j + 1) {
            WireNode(c.children[j]);
        }
    }

    // 核心契约与执行状态转移规范。
    // GUI 控件排版布局与事件分发契约。
    // 核心契约与执行状态转移规范。

    // 把绑定的状态实体值推入每个声明了 `bind` 路径的控件
    // （state -> UI）。不通过 SetProp 暴露 “value”/“text” 的控件
    // 会忽略写入，因此对所有控件类型都安全。
    void SyncFromModel() {
        if (model == null || root == null) { return; }
        this.EnsureExpanded();
        SyncFromNode(root);
    }

    // 递归把模型值推入声明了 bind 路径的控件（值变化才写），
    // 按 bindIf 声明插拔显示，并记录绑定快照。`template` 原型子树
    // 不参与同步/回写（它是克隆底版，不是活界面）。
    void SyncFromNode(Control c) {
        if (c.Kind() == "template") { return; }
        if (c.bindIf != "") {
            c.SetShown(ChildWindow.Truthy(this.ValueFor(c, c.bindIf)));
        }
        if (c.bindPath != "") {
            JsonValue v = this.ValueFor(c, c.bindPath);
            if (v != null) {
                string s = v.AsString("");
                // 只在值真的变了才写：文本框收到一次写入就把光标收到末尾
                // （SetText 的语义），而这段每帧都跑——无条件写下去的话，
                // 方向键刚把光标挪开，下一帧就被同一个值弹回行尾。
                // Element 的缺省绑定属性是 text（SetText 通道），不是
                // value——后者对元素是"非空值当样式类"的基类兜底。
                string prop = c.bindProp;
                if (prop == "") {
                    prop = "value";
                    if (c is Element) { prop = "text"; }
                }
                if (c.GetProp(prop) != s) { c.SetProp(prop, s); }
            }
            RecordSnapshot(c, BoundValue(c));
        }
        for (int j = 0; j < c.children.Count; j = j + 1) {
            SyncFromNode(c.children[j]);
        }
    }

    // 把每个绑定控件的当前值读回状态实体（UI -> state）。
    void SyncChangedNode(Control c) {
        if (c.Kind() == "template") { return; }
        if (c.bindPath != "") {
            string s = BoundValue(c);
            if (s != SnapshotOf(c)) { WriteBoundValue(c, s); }
        }
        for (int i = 0; i < c.children.Count; i = i + 1) {
            SyncChangedNode(c.children[i]);
        }
    }

    // 绑定路径取值：控件在模板行作用域里（scopeKeys 有登记）先查
    // 本项 JsonValue，未命中回落根模型——行内相对路径（"name"）与
    // 绝对路径（"vm.title"）因此可以在同一行混用。
    JsonValue ValueFor(Control c, string path) {
        JsonValue item = this.ScopeOf(c);
        if (item != null) {
            JsonValue v = item.PathGet(path);
            if (v != null) { return v; }
        }
        return model.PathGet(path);
    }

    // 记录（或更新）控件绑定属性的模型侧确认值——上次由模型
    // 写入/确认时 `BoundValue` 的读数，作为"用户是否编辑过"的基准。
    void RecordSnapshot(Control c, string v) {
        if (boundSnapshots == null) {
            boundSnapshots = new List<ChildBoundSnapshot>();
        }
        for (int i = 0; i < boundSnapshots.Count; i = i + 1) {
            if (boundSnapshots[i].control == c) {
                boundSnapshots[i].snapshot = v;
                return;
            }
        }
        boundSnapshots.Add(new ChildBoundSnapshot(c, v));
    }

    // 控件的上一次模型侧确认值；从未记录（新绑定控件首次回写
    // 前的防御路径）按被拆字段的原初始值语义返回 ""。
    string SnapshotOf(Control c) {
        if (boundSnapshots == null) { return ""; }
        for (int i = 0; i < boundSnapshots.Count; i = i + 1) {
            if (boundSnapshots[i].control == c) {
                return boundSnapshots[i].snapshot;
            }
        }
        return "";
    }

    // 控件绑定属性的当前值：显式 bindProp 优先，否则取 value、
    // 再取 text。
    string BoundValue(Control c) {
        if (c.bindProp != "") { return c.GetProp(c.bindProp); }
        string s = c.GetProp("value");
        if (s == "") { s = c.GetProp("text"); }
        return s;
    }

    // 把字符串值写回模型节点：按现有节点的类型转换为
    // bool / 数值 / 字符串，保持模型原有的形状。行作用域控件写到
    // 本项 JsonValue（数组元素的引用，就地生效）。
    void WriteBoundValue(Control c, string s) {
        JsonValue scope = this.ScopeOf(c);
        if (scope != null) {
            JsonValue cur = scope.PathGet(c.bindPath);
            if (cur != null && cur.IsBool()) {
                scope.PathSetValue(c.bindPath, JsonValue.NewBool(s == "true"));
            } else if (cur != null && cur.IsNumber()) {
                scope.PathSetValue(c.bindPath, JsonValue.NewNum(s));
            } else {
                scope.PathSet(c.bindPath, s);
            }
            return;
        }
        JsonValue cur0 = model.PathGet(c.bindPath);
        if (cur0 != null && cur0.IsBool()) {
            model.PathSetValue(c.bindPath, JsonValue.NewBool(s == "true"));
        } else if (cur0 != null && cur0.IsNumber()) {
            model.PathSetValue(c.bindPath, JsonValue.NewNum(s));
        } else {
            model.PathSet(c.bindPath, s);
        }
    }

    // ---- <template data-for> 行展开 ---------------------------------------
    // 原型被 UA 样式表 display:none；挂模型的窗口每帧（SyncFromModel
    // 开头）核对源数组长度，变了才整组重建：逐原型子项 Html.Clone 成
    // 行，普通 InsertAt 插在模板紧后（不走 Element.AddKid——克隆行
    // 不进原型父的文档序表，撤除也不留幽灵占位）。行内 bind/bindIf
    // 以本项 JsonValue 为第一作用域。

    // Wire 期登记静态树上的模板原型（v1 不支持嵌套模板：原型子树
    // 不再下扫）。未挂模型时登记了也惰性——展开只发生在
    // SyncFromModel。
    void RegisterTemplates(Control c) {
        if (c.Kind() == "template") {
            if (tmplMetas == null) {
                tmplMetas = new List<ChildTemplateMeta>();
            }
            bool known = false;
            for (int i = 0; i < tmplMetas.Count; i = i + 1) {
                if (tmplMetas[i].template == c) { known = true; break; }
            }
            if (!known) {
                tmplMetas.Add(new ChildTemplateMeta(c, 0 - 1));  // 强制首帧展开
            }
            return;
        }
        for (int j = 0; j < c.children.Count; j = j + 1) {
            RegisterTemplates(c.children[j]);
        }
    }

    // 每帧核对各模板的源数组长度；与上帧一致就什么都不做（行是活
    // 控件，绑定照常同步），变了才整组重建。
    void EnsureExpanded() {
        if (tmplMetas == null) { return; }
        for (int i = 0; i < tmplMetas.Count; i = i + 1) {
            Control t = tmplMetas[i].template;
            string path = t.CssAttr("data-for");
            if (path == "" || t.children.Count == 0) { continue; }
            JsonValue arr = model.PathGet(path);
            int n = (arr != null && arr.IsArray()) ? arr.Count() : 0;
            if (tmplMetas[i].lastCount == n) { continue; }
            this.RemoveRows(t);
            tmplMetas[i].lastCount = n;
            if (n == 0) { continue; }
            Control p = t.parent;
            if (p == null) { continue; }
            int cur = p.IndexOf(t) + 1;
            for (int k = 0; k < n; k = k + 1) {
                JsonValue item = arr.At(k);
                for (int j = 0; j < t.children.Count; j = j + 1) {
                    // 原型深拷贝经 App 克隆槽（Html.Install 注册）；
                    // 未装 HTML 声明层就不会有 template 原型到这里。
                    Control row = App.CloneTree(t.children[j]);
                    if (row == null) { continue; }
                    p.InsertAt(cur, row);
                    cur = cur + 1;
                    WireNode(row);
                    this.ScopeRow(row, item);
                    if (expandedRows == null) {
                        expandedRows = new List<ChildExpandedRow>();
                    }
                    expandedRows.Add(new ChildExpandedRow(row, t));
                }
            }
        }
    }

    // 撤除模板 `t` 的全部行（数组重建前调）：从各自的父节点摘下
    // 并清掉行内控件的作用域登记。
    void RemoveRows(Control t) {
        if (expandedRows == null) { return; }
        for (int i = expandedRows.Count - 1; i >= 0; i = i - 1) {
            if (expandedRows[i].template != t) { continue; }
            Control row = expandedRows[i].rowRoot;
            this.DetachRow(row);
            this.ScopeDropRow(row);
            expandedRows.RemoveAt(i);
        }
    }

    // 行根脱父：Element 父走 DropKid（文档序表一并清，不留幽灵
    // 占位），控件父走普通 Remove。
    void DetachRow(Control row) {
        Control p = row.parent;
        if (p == null) { return; }
        if (p is Element) {
            ((Element)p).DropKid(row);
        } else {
            p.Remove(row);
        }
    }

    // 登记行子树里所有声明了 bind/bindIf 的控件的作用域（本项
    // JsonValue）。只登记声明了绑定的控件——表按引用线性查，登记
    // 面越小每帧越便宜。
    void ScopeRow(Control c, JsonValue item) {
        if (c.bindPath != "" || c.bindIf != "") { this.ScopePut(c, item); }
        for (int j = 0; j < c.children.Count; j = j + 1) {
            this.ScopeRow(c.children[j], item);
        }
    }

    void ScopePut(Control c, JsonValue item) {
        if (scopeBindings == null) {
            scopeBindings = new List<ChildScopeBinding>();
        }
        for (int i = 0; i < scopeBindings.Count; i = i + 1) {
            if (scopeBindings[i].control == c) {
                scopeBindings[i].item = item;
                return;
            }
        }
        scopeBindings.Add(new ChildScopeBinding(c, item));
    }

    // 控件的行作用域；不在任何行里返回 null。
    JsonValue ScopeOf(Control c) {
        if (scopeBindings == null) { return null; }
        for (int i = 0; i < scopeBindings.Count; i = i + 1) {
            if (scopeBindings[i].control == c) {
                return scopeBindings[i].item;
            }
        }
        return null;
    }

    // 撤行时清作用域登记：行子树里声明了绑定的控件逐个摘除（就地
    // 压缩，尾部截断）。残留条目永不命中（键是引用），但数组频繁
    // 重建的窗口靠这一步封住增长。
    void ScopeDropRow(Control c) {
        if (c.bindPath != "" || c.bindIf != "") { this.ScopeDropOne(c); }
        for (int j = 0; j < c.children.Count; j = j + 1) {
            this.ScopeDropRow(c.children[j]);
        }
    }

    void ScopeDropOne(Control c) {
        if (scopeBindings == null) { return; }
        int keep = 0;
        for (int i = 0; i < scopeBindings.Count; i = i + 1) {
            if (scopeBindings[i].control == c) { continue; }
            scopeBindings[keep] = scopeBindings[i];
            keep = keep + 1;
        }
        if (keep == scopeBindings.Count) { return; }
        while (scopeBindings.Count > keep) {
            scopeBindings.RemoveAt(scopeBindings.Count - 1);
        }
    }

    // data-if 路径取值的真值裁决：null 假；布尔原样；数字非 0；
    // 字符串非空且不为 "false"。比 AsBool 的严格 "true" 宽——HTML
    // 侧路径值多是字符串状态名（"on"/"done"）。
    static bool Truthy(JsonValue v) {
        if (v == null) { return false; }
        if (v.IsBool()) { return v.AsBool(false); }
        if (v.IsNumber()) { return v.AsInt(0) != 0; }
        string s = v.AsString("");
        return s != "" && s != "false";
    }

    // 接口数据协议与执行契约。
    // 核心契约与语义定义。
    virtual bool Pending() { return false; }

    // GUI 控件排版布局与事件分发契约。
    virtual void AfterFrame() { }

    // 语言切换广播：宿主把 UI 语言切到 `lang`（"zh" / "en" 语言码）后，
    // 对每个开着的子窗口调用一次。子类在这里重填设计文档的设计期
    // 文案（ApplyTexts 模式）并刷新依赖语言的静态扇出字段；窗口
    // 标题由基类重取 Title() 处理，子类无需关心。
    virtual void OnLanguageChanged(string lang) { }

    // GUI 控件排版布局与事件分发契约。
    void OpenHost(App parent) {
        open = true;
        idBase = this.IdBase();
        host = App.CreateDark(this.Title(), this.Width(), this.Height());
        if (parent != null) {
            string parentSkin = parent.SkinName();
            if (parentSkin != "") {
                host.ApplySkinName(parentSkin);
            } else {
                host.ApplySkin(parent.ThemeMenuIndex());
            }
            if (parent.Density() != host.Density()) {
                host.SetDensity(parent.Density());
            }
            string parentCss = parent.AppCss();
            if (parentCss != "") {
                host.UseAppCss(parentCss);
            }
        }
        // 接口数据协议与执行契约。
        // GUI 控件排版布局与事件分发契约。
        // 核心契约与语义定义。
        host.SetChromeButtons(false, false, this.ShowMinimize(),
                              this.ShowMaximize());
        if (parent != null) {
            host.FollowCaptionTips(parent);
            host.SetWindowOpacity(parent.WindowOpacity());
            host.SetUserWallpaper(parent.UserWallpaperPath(),
                                  parent.UserWallpaperOpacity());
        }
        host.Show();
        host.RequestRedraw();
        ChildWindows.Register(this);
    }

    // GUI 控件排版布局与事件分发契约。
    // 接口数据协议与执行契约。
    // 核心契约与语义定义。
    void OpenStandalone() {
        open = true;
        idBase = this.IdBase();
        host = App.CreateDark(this.Title(), this.Width(), this.Height());
        host.ApplySkinName(this.StandaloneSkin());
        host.SetChromeButtons(false, false, this.ShowMinimize(),
                              this.ShowMaximize());
        host.Show();
        host.RequestRedraw();
    }

    // 接口数据协议与执行契约。
    // GUI 控件排版布局与事件分发契约。
    // 接口数据协议与执行契约。
    virtual string StandaloneSkin() { return "light"; }

    // 接口数据协议与执行契约。
    // 注意：仅用于无主窗口循环的单机独立控制台场景；在包含 App.Run 的 GUI 程序中
    // 请优先使用普通子窗口或协程 await 驱动，禁止使用嵌套独立泵打断主界面渲染。
    void PumpStandaloneUntil(ChildWindowStop stop) {
        this.PumpStandaloneUntilMode(stop, true);
    }

    // GUI 控件排版布局与事件分发契约。
    // 接口数据协议与执行契约。
    void PumpStandaloneUntilKeepOpen(ChildWindowStop stop) {
        this.PumpStandaloneUntilMode(stop, false);
    }

    // 独立事件泵的公共实现：泵宿主事件并逐帧渲染，直到窗口关闭
    // 或 stop() 为真；closeWhenDone 决定结束时是否顺带 Close()。
    void PumpStandaloneUntilMode(ChildWindowStop stop, bool closeWhenDone) {
        while (this.IsOpen() && (stop == null || !stop())) {
            if (!host.PumpSafe()) {
                this.Close();
                break;
            }
            if (this.IsOpen()) { this.Render(); }
        }
        if (closeWhenDone && this.IsOpen()) { this.Close(); }
    }

    // GUI 控件排版布局与事件分发契约。
    void Render() {
        if (!this.NeedsRedraw()) { return; }
        int saved = WidgetId.SeqValue();
        WidgetId.SetSeq(idBase);
        if (renderCb != null) {
            renderCb();
        } else {
            host.BeginFrame();
            int top = host.ContentTop();
            if (root != null) {
                SyncFromModel();
                root.MeasureTree(host);
                // 阴影带外扩的异形宿主把内容轮廓推离画布原点
                // (ShapeOffX, ShapeOffY)：保留树从内容原点起摆，绘制、
                // 命中区与画布坐标三方才对齐（普通宿主两值恒 0，无感）。
                // 弹窗统一四周 5px 外边距（随宿主 DPI 缩放）：内容树
                // 不顶满客户区，贴边留一线呼吸空隙。
                int pad = host.Scale(5);
                root.Arrange(host.ShapeOffX() + pad,
                             top + host.ShapeOffY() + pad,
                             host.ClientWidth() - pad * 2,
                             host.ClientHeight() - top - pad * 2);
                root.RenderTree(host);
            }
            host.RenderChrome(this.Title());
            host.PresentFrame();
            // 回写在弹层之后：下拉/弹出层的选择是在 PresentFrame 里的
            // RunOverlays 阶段才发生的，在它之前读回控件值只会读到旧值，
            // 而下一帧的 SyncFromModel 又把旧值写回控件——绑定了状态实体
            // 的下拉框因此永远切不动（不带 bind、由代码读 Value() 的下拉
            // 不受影响，这就是「有的能切有的不能」）。
            if (root != null) { SyncChangedNode(root); }
        }
        WidgetId.SetSeq(saved);
        this.AfterFrame();
    }

    // 窗口开着且有帧要出（宿主标脏或 Pending()）时为 true。
    bool NeedsRedraw() {
        return open && (host.needsRedraw || this.Pending());
    }

    // 窗口是否仍开着。
    bool IsOpen() { return open; }

    // 该 OS 窗口句柄是否归本窗口所有。
    bool OwnsWindow(nint hwnd) {
        return open && hwnd == host.WindowHandle();
    }

    // GUI 控件排版布局与事件分发契约。
    // 接口数据协议与执行契约。
    void ApplyEvent(nint hwnd) {
        if (!this.OwnsWindow(hwnd)) { return; }
        if (host.EventKind() == 8) {
            this.OnCloseRequested();
            open = false;
            this.Teardown();
            return;
        }
        host.ApplyEvent(hwnd);
    }

    // GUI 控件排版布局与事件分发契约。
    // 接口数据协议与执行契约。
    virtual void OnCloseRequested() { }

    // 关闭窗口：向 OS 发送关闭请求、标记关闭并立即 Teardown
    // （幂等，见 Teardown）。
    void Close() {
        if (open) { host.window.Close(); }
        open = false;
        this.Teardown();
    }

    // 接口数据协议与执行契约。
    // GUI 控件排版布局与事件分发契约。
    // 接口数据协议与执行契约。
    void Teardown() {
        if (destroyed) { return; }
        destroyed = true;
        if (host != null) {
            host.window.Destroy();
            // 光栅 surface 与 OS 窗口是两份资源：销毁窗口只释放
            // X11/Win32 侧，surface 槽位（及其模糊/快照缓存）要
            // 显式归还，否则每开关一个副窗口就漏一块帧缓冲。
            host.canvas.Destroy();
        }
    }

    // 请求宿主重绘（窗口开着时）。
    void RequestRedraw() {
        if (open) { host.RequestRedraw(); }
    }

    // GUI 控件排版布局与事件分发契约。

    // 转发给宿主换肤（窗口开着时）。
    void ApplySkin(int i) {
        if (open) { host.ApplySkin(i); }
    }

    // 转发给宿主设置窗口不透明度（0-100，窗口开着时）。
    void SetWindowOpacity(int percent) {
        if (open) { host.SetWindowOpacity(percent); }
    }

    // 转发给宿主设置用户壁纸与不透明度（窗口开着时）。
    void SetUserWallpaper(string path, int opacity) {
        if (open) { host.SetUserWallpaper(path, opacity); }
    }

    // 宿主窗口的 OS 句柄。
    nint WindowHandle() { return host.WindowHandle(); }

    // 主窗口换肤后同步本副窗口并重绘。
    void FollowSkin(int i) {
        if (!open) { return; }
        host.ApplySkin(i);
        host.RequestRedraw();
    }

    // 主窗口换了界面语言：已经开着的副窗口的标题提示也得跟上。
    void FollowCaptionTips(App src) {
        if (!open) { return; }
        host.FollowCaptionTips(src);
        host.RequestRedraw();
    }

    // 主窗口调不透明度后同步本副窗口。
    void FollowOpacity(int percent) {
        if (!open) { return; }
        host.SetWindowOpacity(percent);
    }

    // 主窗口换壁纸后同步本副窗口。
    void FollowWallpaper(string path, int opacity) {
        if (!open) { return; }
        host.SetUserWallpaper(path, opacity);
    }

    // 宿主的下一次动画截止时刻（毫秒时钟；窗口关闭返回 -1）。
    int AnimNextMs() {
        if (!open) { return 0 - 1; }
        return host.animNextMs;
    }

    // 宿主的下一次特效截止时刻（毫秒时钟；窗口关闭返回 -1）。
    int FxNextMs() {
        if (!open) { return 0 - 1; }
        return host.fxNextMs;
    }
}

// GUI 控件排版布局与事件分发契约。
// 接口数据协议与执行契约。
// GUI 控件排版布局与事件分发契约。
// 接口数据协议与执行契约。
class ChildWindows {
    static List<ChildWindow> wins;
    static FilePicker picker;
    // 最近一次已路由的事件序号与结果（`RouteEvent` 幂等）。标准循环
    // `Form.Run` 与自带帧钩子的宿主（ZanIDE 外壳）都会按 hwnd 路由，
    // 同一事件经两处必然把一次按压/释放重放一遍——双击计数、长按
    // 计时、拖拽起点都会被算两遍。事件序号是"每投递一个新事件 +1"，
    // 正好是那件事件的身份证；它同时挡住动画帧里 `EventKind()` 的
    // 陈旧回读（没有新事件时序号不变）。
    static long routedSeq;
    static bool routedHandled;
    // 组件自建的附加选择器（Upload 内建选文件弹窗等）。单一 `picker`
    // 槽归应用 shell 注册的共享选择器所有（IDE 的 pathPicker）；这批
    // 由组件按需登记，数量不限。PumpAll/RouteEvent/Wants 统一照顾两处。
    static List<FilePicker> pickers;

    // 注册表（惰性创建）。
    static List<ChildWindow> All() {
        if (ChildWindows.wins == null) {
            ChildWindows.wins = new List<ChildWindow>();
        }
        return ChildWindows.wins;
    }

    // 把窗口加入主循环驱动队列（OpenHost 自动调用）。
    static void Register(ChildWindow w) {
        ChildWindows.All().Add(w);
    }

    // 语言切换广播：对每个开着的子窗口调用 OnLanguageChanged，并把
    // 自绘标题栏的文字按新语言的 Title() 重设。宿主（IDE 外壳）在
    // 设置窗回报语言变更时调用一次（lang 为 "zh"/"en" 语言码）；
    // 之后开的新窗口自然用新语言。
    static void ApplyLanguage(string lang) {
        foreach (ChildWindow w in ChildWindows.All()) {
            if (!w.IsOpen()) { continue; }
            w.OnLanguageChanged(lang);
            if (w.host != null) { w.host.SetWindowTitle(w.Title()); }
        }
    }

    // GUI 控件排版布局与事件分发契约。
    // 接口数据协议与执行契约。
    static void RegisterPicker(FilePicker p) {
        ChildWindows.picker = p;
    }

    // 登记一个组件自建的选择器（Upload 内建弹窗）。同一实例重复登记
    // 是无操作；`PrunePickers` 在它关闭后移出，因此宿主应在每次打开
    // 时重新登记（组件复用同一 picker 实例）。返回 true = 首次登记。
    static bool RegisterComponentPicker(FilePicker p) {
        if (ChildWindows.pickers == null) {
            ChildWindows.pickers = new List<FilePicker>();
        }
        if (ChildWindows.pickers.Contains(p)) { return false; }
        ChildWindows.pickers.Add(p);
        return true;
    }

    // 核心契约与语义定义。
    static void Prune() {
        List<ChildWindow> all = ChildWindows.All();
        List<ChildWindow> keep = new List<ChildWindow>();
        foreach (ChildWindow w in all) {
            if (w.IsOpen()) { keep.Add(w); }
            else { w.Teardown(); }
        }
        ChildWindows.wins = keep;
    }

    // 是否还有开着的子窗口。
    static bool AnyOpen() {
        foreach (ChildWindow w in ChildWindows.All()) {
            if (w.IsOpen()) { return true; }
        }
        return false;
    }

    // GUI 控件排版布局与事件分发契约。
    // instead of blocking).
    static bool Wants() {
        foreach (ChildWindow w in ChildWindows.All()) {
            if (w.NeedsRedraw()) { return true; }
        }
        if (ChildWindows.AnyPickerWants()) { return true; }
        return false;
    }

    // 任一组件选择器开着且要求重绘（轮询判据；FilePicker 文档约定：
    // 弹窗开着时主循环不得阻塞在 WaitEvent 上）。
    static bool AnyPickerWants() {
        if (ChildWindows.pickers == null) { return false; }
        for (int i = 0; i < ChildWindows.pickers.Count; i = i + 1) {
            FilePicker p = ChildWindows.pickers[i];
            if (p.IsOpen() && p.NeedsRedraw()) { return true; }
        }
        return false;
    }

    // 任一组件选择器开着（主循环用它收紧阻塞等待）。
    static bool AnyPickerOpen() {
        if (ChildWindows.pickers == null) { return false; }
        for (int i = 0; i < ChildWindows.pickers.Count; i = i + 1) {
            if (ChildWindows.pickers[i].IsOpen()) { return true; }
        }
        return false;
    }

    // 接口数据协议与执行契约。
    static int Deadline(int deadline) {
        int d = deadline;
        foreach (ChildWindow w in ChildWindows.All()) {
            int a = w.AnimNextMs();
            if (a >= 0 && (d < 0 || a < d)) { d = a; }
            int f = w.FxNextMs();
            if (f >= 0 && (d < 0 || f < d)) { d = f; }
        }
        return d;
    }

    // 组件选择器开着时把它的重绘需求折叠进主应用：轮询判据（开着时
    // 不得阻塞在 WaitEvent 上）+ 弹窗要出帧时唤醒主循环。
    static bool PumpPickers(App main) {
        if (ChildWindows.pickers == null) { return false; }
        bool woken = false;
        for (int i = 0; i < ChildWindows.pickers.Count; i = i + 1) {
            FilePicker p = ChildWindows.pickers[i];
            if (!p.IsOpen()) { continue; }
            if (p.NeedsRedraw() && !woken) {
                main.RequestRedraw();
                woken = true;
            }
        }
        return woken;
    }

    // GUI 控件排版布局与事件分发契约。
    static void PrunePickers() {
        if (ChildWindows.pickers == null) { return; }
        List<FilePicker> keep = new List<FilePicker>();
        for (int i = 0; i < ChildWindows.pickers.Count; i = i + 1) {
            FilePicker p = ChildWindows.pickers[i];
            if (p.IsOpen()) { keep.Add(p); }
        }
        ChildWindows.pickers = keep;
    }

    // GUI 控件排版布局与事件分发契约。
    // 核心契约与语义定义。
    static bool TickDue(int now) {
        bool due = false;
        foreach (ChildWindow w in ChildWindows.All()) {
            int a = w.AnimNextMs();
            int f = w.FxNextMs();
            if (a >= 0 && now >= a) { due = true; w.RequestRedraw(); }
            if (f >= 0 && now >= f) { due = true; w.RequestRedraw(); }
        }
        return due;
    }

    // 把事件交给它所属的那扇顶层窗口（子窗口 / 共享选择器 / 组件
    // 选择器）；都不属于时返回 false（那是主窗口自己的事件）。
    // 由事件泵 `App.ProcessEvent` 对每一件非本窗口事件调用一次，
    // 宿主循环因此不必知道 hwnd 路由这回事。幂等（按事件序号）：
    // 自带循环/帧钩子的宿主若再调一次，同一件事件不会被送第二遍。
    static bool RouteEvent(nint hwnd) {
        // 幂等：同一件事件（序号相同）只交付一次，重复调用返回上次结果。
        long seq = Window.EventSeqGlobal();
        if (seq == ChildWindows.routedSeq) { return ChildWindows.routedHandled; }
        ChildWindows.routedSeq = seq;
        ChildWindows.routedHandled = false;
        foreach (ChildWindow w in ChildWindows.All()) {
            if (w.OwnsWindow(hwnd)) {
                w.ApplyEvent(hwnd);
                ChildWindows.routedHandled = true;
                // 正常窗口交互：事件到达并处理后，若窗口产生重绘需求，立即就地渲染出帧
                if (w.NeedsRedraw()) {
                    w.Render();
                }
                return true;
            }
        }
        // 共享文件选择器（应用外壳注册的 pathPicker）：它的弹窗也是
        // 独立顶层窗口，路由由这里一并负责，外壳不必自己再判断一遍。
        if (ChildWindows.picker != null
            && ChildWindows.picker.OwnsWindow(hwnd)) {
            ChildWindows.picker.ApplyEvent(hwnd);
            ChildWindows.routedHandled = true;
            return true;
        }
        if (ChildWindows.pickers != null) {
            for (int i = 0; i < ChildWindows.pickers.Count; i = i + 1) {
                FilePicker p = ChildWindows.pickers[i];
                if (p.OwnsWindow(hwnd)) {
                    p.ApplyEvent(hwnd);
                    ChildWindows.routedHandled = true;
                    return true;
                }
            }
        }
        return false;
    }

    // GUI 控件排版布局与事件分发契约。
    // 核心契约与语义定义。
    static bool PaintForResize(nint hwnd) {
        foreach (ChildWindow w in ChildWindows.All()) {
            if (w.OwnsWindow(hwnd)) {
                w.host.SyncSurface();
                w.Render();
                return true;
            }
        }
        return false;
    }

    // GUI 控件排版布局与事件分发契约。
    // 接口数据协议与执行契约。
    // 核心契约与语义定义。
    static void PumpAll() {
        foreach (ChildWindow w in ChildWindows.All()) {
            if (w.IsOpen()) { w.Render(); }
        }
        if (ChildWindows.picker != null) {
            if (ChildWindows.picker.IsOpen() && ChildWindows.picker.NeedsRedraw()) {
                ChildWindows.picker.RenderWindow();
            }
        }
        // 组件自建的选择器（Upload 内建弹窗）：开着就出一帧。RenderWindow
        // 内部自会跳过不需要重绘的帧。
        if (ChildWindows.pickers != null) {
            for (int i = 0; i < ChildWindows.pickers.Count; i = i + 1) {
                FilePicker p = ChildWindows.pickers[i];
                if (p.IsOpen()) { p.RenderWindow(); }
            }
        }
        ChildWindows.Prune();
        ChildWindows.PrunePickers();
    }

    // GUI 控件排版布局与事件分发契约。
    // deadline).
    static void FoldDeadlines(App main) {
        int dl = ChildWindows.Deadline(-1);
        if (dl >= 0) { main.RequestWakeAt(dl); }
        int now = Window.GetTickMs();
        if (ChildWindows.TickDue(now)) { main.RequestRedraw(); }
        // 任何子窗口有帧要画时唤醒主循环并保持出帧，所有窗口画完自然休眠
        if (ChildWindows.Wants()) {
            main.RequestRedraw();
        }
        // 组件选择器开着时保持主循环轮询（needsRedraw 常挂），否则
        // Form.Run 会阻塞在 WaitEvent 上，弹窗永远出不了帧。
        if (ChildWindows.AnyPickerOpen()) {
            main.RequestRedraw();
        }
    }

    // 主窗口换肤时同步每个开着的子窗口。
    static void FollowSkin(int i) {
        foreach (ChildWindow w in ChildWindows.All()) { w.FollowSkin(i); }
    }

    // 主窗口调整不透明度时同步每个开着的子窗口。
    static void FollowOpacity(int percent) {
        foreach (ChildWindow w in ChildWindows.All()) {
            w.FollowOpacity(percent);
        }
    }

    // 把主窗口当前的标题提示文案推给每个开着的副窗口。
    static void FollowCaptionTips(App main) {
        foreach (ChildWindow w in ChildWindows.All()) {
            w.FollowCaptionTips(main);
        }
    }

    // 主窗口更换用户壁纸时同步每个开着的子窗口。
    static void FollowWallpaper(string path, int opacity) {
        foreach (ChildWindow w in ChildWindows.All()) {
            w.FollowWallpaper(path, opacity);
        }
    }

    // GUI 控件排版布局与事件分发契约。
    // 接口数据协议与执行契约。
    static void RequestRedrawAll() {
        foreach (ChildWindow w in ChildWindows.All()) { w.RequestRedraw(); }
    }
}
