using System;
using System.Collections.Generic;
using System.Json;
using Gui;
using Gui.Backend;
using Gui.Widget;

namespace Gui;

public class ChildWindow {
    App host;
    App parentApp;
    Control root;
    // 模型宿主：绑定逻辑（模型→UI 同步、UI→模型回写、模板行展开）
    // 住在 ModelBinder 里，不住在窗口类里——主窗口（Form）里的页面
    // 分区也要挂模型，那条路没有窗口，只能共用同一个宿主。
    ModelBinder binder;
    // 对外仍保留 model 字段壳（与 Binder().SetRoot 收到的引用同步）：
    // 既有调用方（IDE 对话框等）先 `w.model = JsonValue.NewObject()`
    // 再逐键 Set、最后 SetRoot(content, model)，字段与 binder 持同一
    // 引用，挂树前后的改动两边都看得见。
    JsonValue model;
    bool open;
    bool destroyed;
    int idBase;
    Action renderCb;
    // 本帧该子窗的渲染耗时（微秒）。没渲染（不脏）时为 0。
    // ChildWindows 的单帧预算按它累计：超预算就把剩下的子窗留给
    // 下一帧，别让子窗把主帧顶死。
    long lastRenderUs = 0;

    // 构造：全部字段置空/默认（idBase 基线 900000）。
    ChildWindow() {
        host = null;
        root = null;
        binder = new ModelBinder();
        open = false;
        destroyed = false;
        idBase = 900000;
        renderCb = null;
    }

    virtual string Title() { return "Zan"; }

    virtual int Width() { return 560; }
    // 初始客户区高度（未缩放像素）。
    virtual int Height() { return 560; }

    // 子窗口标题栏按钮集合（子窗口默认禁用皮肤选择与固顶操作；不可调整尺寸的对话框自动隐藏最大化按钮）。
    virtual bool ShowTheme() { return false; }
    virtual bool ShowPin() { return false; }
    virtual bool ShowMinimize() { return true; }
    // 是否保留最大化按钮。
    virtual bool ShowMaximize() { return true; }

    // 子窗口控件 ID 分配基线，避免跨窗口 ID 冲突。
    virtual int IdBase() { return 900000; }

    // 底层宿主应用实例句柄，供即时渲染模式分发帧。
    App Host() { return host; }

    // 即时渲染模式回调；设置后主循环直接分发绘制回调而非遍历控件树。
    void SetRender(Action a) {
        renderCb = a;
    }

    // 模型宿主（惰性建）：Zan 的子类构造不跑父构造，父构造里的字段
    // 初始化在子类实例上不生效——首次用到时再补，否则 binder 是 null。
    ModelBinder Binder() {
        if (binder == null) { binder = new ModelBinder(); }
        return binder;
    }

    // 挂树与模型。模型为 null 时绑定声明惰性（纯命令式子窗口照旧）。
    void SetRoot(Control tree, JsonValue m) {
        root = tree;
        model = m;
        this.Binder().SetRoot(tree, m);
        // 独立泵的窗口不经过 Control.Run（那里登记驱动根），这里补
        // 登记：ZAN_UI_SCRIPT 会话才能 dump tree 这棵保留树。
        UiDriver.SetRoot(tree);
    }

    void Handle(string name, Action a) {
        this.Binder().Handle(name, a);
    }

    // passed as the argument (Html.WireArg / WireNode 闭包捕获)。
    void HandleArg(string name, Action<string> a) {
        this.Binder().HandleArg(name, a);
    }

    // 注册绑定到 `name` 的带 sender 处理器（平行通道）：Wire() 解析到
    // 具体控件时，把该控件作为实参交给处理器——一个 HandleSender
    // 可以服务整棵树上的多个绑定，处理器按 sender 区分来源。
    // 与 Handle 相互独立；同名两槽都注册时各建一条订阅（多播）。
    void HandleSender(string name, ControlEvent a) {
        this.Binder().HandleSender(name, a);
    }

    void Wire() {
        this.Binder().SetApp(host);
        this.Binder().Wire();
    }

    // 模型同步转发（绑定实现见 ModelBinder）：窗口每帧在渲染前把
    // 模型推入控件、渲染后把控件回写模型；这两个入口也供宿主手动
    // 驱动（离屏渲染、自定义帧循环）。
    void SyncFromModel() {
        this.Binder().SyncFromModel();
    }

    void SyncChangedNode(Control c) {
        this.Binder().SyncChangedNode(c);
    }
    virtual bool Pending() { return false; }

    virtual void AfterFrame() { }

    // 语言切换广播：宿主把 UI 语言切到 `lang`（"zh" / "en" 语言码）后，
    // 对每个开着的子窗口调用一次。子类在这里重填设计文档的设计期
    // 文案（ApplyTexts 模式）并刷新依赖语言的静态扇出字段；窗口
    // 标题由基类重取 Title() 处理，子类无需关心。
    virtual void OnLanguageChanged(string lang) { }

    void OpenHost(App parent) {
        this.parentApp = parent;
        open = true;
        idBase = this.IdBase();
        host = App.CreateDark(this.Title(), this.Width(), this.Height());
        host.SetChildMode(true);
        if (parent != null) {
            string parentSkin = parent.SkinName();
            if (parentSkin != "") {
                host.ApplySkinName(parentSkin);
            } else {
                host.ApplySkin(parent.ThemeMenuIndex());
            }
            if (parent.Density() != host.Density()) {
                host.SetDensity(parent.Density());
            }
            string parentCss = parent.AppCss();
            if (parentCss != "") {
                host.UseAppCss(parentCss);
            }
        }
        host.SetChromeButtons(this.ShowTheme(), this.ShowPin(), this.ShowMinimize(),
                              this.ShowMaximize());
        if (parent != null) {
            host.FollowCaptionTips(parent);
            host.SetWindowOpacity(parent.WindowOpacity());
            host.SetUserWallpaper(parent.UserWallpaperPath(),
                                  parent.UserWallpaperOpacity());
        }
        host.Show();
        host.RequestRedraw();
        ChildWindows.Register(this);
    }

    void OpenStandalone() {
        open = true;
        idBase = this.IdBase();
        host = App.CreateDark(this.Title(), this.Width(), this.Height());
        host.SetChildMode(true);
        host.ApplySkinName(this.StandaloneSkin());
        host.SetChromeButtons(this.ShowTheme(), this.ShowPin(), this.ShowMinimize(),
                              this.ShowMaximize());
        host.Show();
        host.RequestRedraw();
    }

    virtual string StandaloneSkin() { return "light"; }

    // 注意：仅用于无主窗口循环的单机独立控制台场景；在包含 App.Run 的 GUI 程序中
    // 请优先使用普通子窗口或协程 await 驱动，禁止使用嵌套独立泵打断主界面渲染。
    void PumpStandaloneUntil(ChildWindowStop stop) {
        this.PumpStandaloneUntilMode(stop, true);
    }

    void PumpStandaloneUntilKeepOpen(ChildWindowStop stop) {
        this.PumpStandaloneUntilMode(stop, false);
    }

    // 独立事件泵的公共实现：泵宿主事件并逐帧渲染，直到窗口关闭
    // 或 stop() 为真；closeWhenDone 决定结束时是否顺带 Close()。
    void PumpStandaloneUntilMode(ChildWindowStop stop, bool closeWhenDone) {
        while (this.IsOpen() && (stop == null || !stop())) {
            if (!host.PumpSafe()) {
                this.Close();
                break;
            }
            if (this.IsOpen()) { this.Render(); }
        }
        if (closeWhenDone && this.IsOpen()) { this.Close(); }
    }

    void Render() {
        this.lastRenderUs = 0;
        if (!this.NeedsRedraw()) { return; }
        long t0 = Stopwatch.GetMicroseconds();
        this.RenderContent();
        long us = Stopwatch.GetMicroseconds() - t0;
        this.lastRenderUs = us;
        // 单个子窗就慢到能顶掉一帧（甚至几帧）时自己报出来：告警格式
        // 与 UiWatchdog 一致，同一套 grep 规则就能捞出"谁把帧堵死了"。
        ChildWindows.ReportRenderCost(this, (int)(us / 1000));
    }

    // 本帧该子窗的渲染耗时（微秒）。
    long LastRenderUs() { return this.lastRenderUs; }

    // 真正的绘制（Render 的计时包装之外的部分）。
    void RenderContent() {
        int saved = WidgetId.SeqValue();
        WidgetId.SetSeq(idBase);
        if (renderCb != null) {
            renderCb();
        } else {
            host.BeginFrame();
            int top = host.ContentTop();
            if (root != null) {
                SyncFromModel();
                root.MeasureTree(host);
                // 阴影带外扩的异形宿主把内容轮廓推离画布原点
                // (ShapeOffX, ShapeOffY)：保留树从内容原点起摆，绘制、
                // 命中区与画布坐标三方才对齐（普通宿主两值恒 0，无感）。
                // 弹窗统一四周 5px 外边距（随宿主 DPI 缩放）：内容树
                // 不顶满客户区，贴边留一线呼吸空隙。
                int pad = host.Scale(5);
                root.Arrange(host.ShapeOffX() + pad,
                             top + host.ShapeOffY() + pad,
                             host.ClientWidth() - pad * 2,
                             host.ClientHeight() - top - pad * 2);
                root.RenderTree(host);
            }
            host.RenderChrome(this.Title());
            host.PresentFrame();
            // 回写在弹层之后：下拉/弹出层的选择是在 PresentFrame 里的
            // RunOverlays 阶段才发生的，在它之前读回控件值只会读到旧值，
            // 而下一帧的 SyncFromModel 又把旧值写回控件——绑定了状态实体
            // 的下拉框因此永远切不动（不带 bind、由代码读 Value() 的下拉
            // 不受影响，这就是「有的能切有的不能」）。
            if (root != null) { SyncChangedNode(root); }
        }
        WidgetId.SetSeq(saved);
        this.AfterFrame();
    }

    // 窗口开着且有帧要出（宿主标脏、Pending() 或动画时钟到期）时为 true。
    bool NeedsRedraw() {
        if (!open) { return false; }
        if (host.needsRedraw || this.Pending()) { return true; }
        int now = Window.GetTickMs();
        if (host.animNextMs >= 0 && now >= host.animNextMs) { return true; }
        if (host.fxNextMs >= 0 && now >= host.fxNextMs) { return true; }
        return false;
    }

    // 窗口是否仍开着。
    bool IsOpen() { return open; }

    // 该 OS 窗口句柄是否归本窗口所有。
    bool OwnsWindow(nint hwnd) {
        return open && hwnd == host.WindowHandle();
    }

    void ApplyEvent(nint hwnd) {
        if (!this.OwnsWindow(hwnd)) { return; }
        if (host.EventKind() == 8) {
            this.Close();
            return;
        }
        host.ApplyEvent(hwnd);
    }

    virtual void OnCloseRequested() { }

    // 关闭窗口：向 OS 发送关闭请求、标记关闭并立即 Teardown
    // （幂等，见 Teardown）。
    void Close() {
        if (!open) { return; }
        this.OnCloseRequested();
        host.window.Close();
        open = false;
        this.Teardown();
        if (this.parentApp != null) {
            this.parentApp.RequestRedraw();
        }
    }

    void Teardown() {
        if (destroyed) { return; }
        destroyed = true;
        if (host != null) {
            host.window.Destroy();
            // 光栅 surface 与 OS 窗口是两份资源：销毁窗口只释放
            // X11/Win32 侧，surface 槽位（及其模糊/快照缓存）要
            // 显式归还，否则每开关一个副窗口就漏一块帧缓冲。
            host.canvas.Destroy();
        }
    }

    // 请求宿主重绘（窗口开着时）。
    void RequestRedraw() {
        if (open) { host.RequestRedraw(); }
    }


    // 转发给宿主换肤（窗口开着时）。
    void ApplySkin(int i) {
        if (open) { host.ApplySkin(i); }
    }

    // 转发给宿主设置窗口不透明度（0-100，窗口开着时）。
    void SetWindowOpacity(int percent) {
        if (open) { host.SetWindowOpacity(percent); }
    }

    // 转发给宿主设置用户壁纸与不透明度（窗口开着时）。
    void SetUserWallpaper(string path, int opacity) {
        if (open) { host.SetUserWallpaper(path, opacity); }
    }

    // 宿主窗口的 OS 句柄。
    nint WindowHandle() { return host.WindowHandle(); }

    // 主窗口换肤后同步本副窗口并重绘。
    void FollowSkin(int i) {
        if (!open) { return; }
        host.ApplySkin(i);
        host.RequestRedraw();
    }

    // 主窗口换了界面语言：已经开着的副窗口的标题提示也得跟上。
    void FollowCaptionTips(App src) {
        if (!open) { return; }
        host.FollowCaptionTips(src);
        host.RequestRedraw();
    }

    // 主窗口调不透明度后同步本副窗口。
    void FollowOpacity(int percent) {
        if (!open) { return; }
        host.SetWindowOpacity(percent);
    }

    // 主窗口换壁纸后同步本副窗口。
    void FollowWallpaper(string path, int opacity) {
        if (!open) { return; }
        host.SetUserWallpaper(path, opacity);
    }

    // 宿主的下一次动画截止时刻（毫秒时钟；窗口关闭返回 -1）。
    int AnimNextMs() {
        if (!open) { return 0 - 1; }
        return host.animNextMs;
    }

    // 宿主的下一次特效截止时刻（毫秒时钟；窗口关闭返回 -1）。
    int FxNextMs() {
        if (!open) { return 0 - 1; }
        return host.fxNextMs;
    }
}
