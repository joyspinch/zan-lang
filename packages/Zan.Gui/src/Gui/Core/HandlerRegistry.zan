using System;
using System.Collections.Generic;
using Gui;
namespace Gui;
public class HandlerRegistry {
    List<HandlerEntry> entries;
    HandlerRegistry() {
        this.entries = new List<HandlerEntry>();
    }
    void Set(string name, Action a) {
        for (int i = 0; i < entries.Count; i = i + 1) {
            if (entries[i].name == name) { entries[i].action = a; return; }
        }
        entries.Add(new HandlerEntry(name, a));
    }
    bool Has(string name) {
        for (int i = 0; i < entries.Count; i = i + 1) {
            if (entries[i].name == name) { return true; }
        }
        return false;
    }
    Action Get(string name) {
        for (int i = 0; i < entries.Count; i = i + 1) {
            if (entries[i].name == name) { return entries[i].action; }
        }
        return null;
    }
    void SetArg(string name, Action<string> a) {
        for (int i = 0; i < entries.Count; i = i + 1) {
            if (entries[i].name == name) { entries[i].argAction = a; return; }
        }
        HandlerEntry e = new HandlerEntry(name, null);
        e.argAction = a;
        entries.Add(e);
    }
    Action<string> GetArg(string name) {
        for (int i = 0; i < entries.Count; i = i + 1) {
            if (entries[i].name == name) { return entries[i].argAction; }
        }
        return null;
    }
    void SetSender(string name, ControlEvent a) {
        for (int i = 0; i < entries.Count; i = i + 1) {
            if (entries[i].name == name) { entries[i].senderAction = a; return; }
        }
        HandlerEntry e = new HandlerEntry(name, null);
        e.senderAction = a;
        entries.Add(e);
    }
    ControlEvent GetSender(string name) {
        for (int i = 0; i < entries.Count; i = i + 1) {
            if (entries[i].name == name) { return entries[i].senderAction; }
        }
        return null;
    }
    void SetItem(string name, ControlItemEvent a) {
        for (int i = 0; i < entries.Count; i = i + 1) {
            if (entries[i].name == name) { entries[i].itemAction = a; return; }
        }
        HandlerEntry e = new HandlerEntry(name, null);
        e.itemAction = a;
        entries.Add(e);
    }
    ControlItemEvent GetItem(string name) {
        for (int i = 0; i < entries.Count; i = i + 1) {
            if (entries[i].name == name) { return entries[i].itemAction; }
        }
        return null;
    }
}
