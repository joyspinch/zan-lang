using System;

namespace Gui.Core;

// 触控移动轨迹采样点
class TouchSample {
    public int timeMs;
    public int x;
    public int y;

    public TouchSample(int t, int x, int y) {
        this.timeMs = t;
        this.x = x;
        this.y = y;
    }
}

// 触控速度与动量追踪器（VelocityTracker）：
// 实时记录触控移动的时间戳与坐标样本，计算手指脱手瞬间的瞬时速度（px/s），
// 供惯性滚动（Inertia Fling）与滑动手势判断使用。
public class VelocityTracker {
    private TouchSample[] samples;
    private int count;
    private int head;
    private float vx;
    private float vy;

    public VelocityTracker() {
        samples = new TouchSample[16];
        count = 0;
        head = 0;
        vx = 0.0f;
        vy = 0.0f;
    }

    public void Clear() {
        count = 0;
        head = 0;
        vx = 0.0f;
        vy = 0.0f;
    }

    // 录入一个新的触控移动采样点
    public void AddMovement(int timeMs, int x, int y) {
        samples[head] = new TouchSample(timeMs, x, y);
        head = (head + 1) % 16;
        if (count < 16) { count = count + 1; }
    }

    // 计算瞬时速度（units 常用 1000 表示 像素/秒，1 表示 像素/毫秒）
    public void ComputeCurrentVelocity(int units, float maxVelocity) {
        if (count < 2) {
            vx = 0.0f;
            vy = 0.0f;
            return;
        }

        // 取最新的样本作为基准
        int lastIdx = (head - 1 + 16) % 16;
        TouchSample latest = samples[lastIdx];
        if (latest == null) { return; }

        // 回溯在 150ms 窗口内的最早样本
        TouchSample earliest = latest;
        int validSamples = 0;
        for (int i = 1; i < count; i = i + 1) {
            int idx = (head - 1 - i + 32) % 16;
            TouchSample s = samples[idx];
            if (s == null) { break; }
            int age = latest.timeMs - s.timeMs;
            if (age > 150) { break; }
            earliest = s;
            validSamples = validSamples + 1;
        }

        int dt = latest.timeMs - earliest.timeMs;
        if (dt <= 10) {
            vx = 0.0f;
            vy = 0.0f;
            return;
        }

        float scale = (float)units / (float)dt;
        float rawVx = (float)(latest.x - earliest.x) * scale;
        float rawVy = (float)(latest.y - earliest.y) * scale;

        // 钳制在最大速率以内
        if (rawVx > maxVelocity) { rawVx = maxVelocity; }
        else if (rawVx < 0.0f - maxVelocity) { rawVx = 0.0f - maxVelocity; }

        if (rawVy > maxVelocity) { rawVy = maxVelocity; }
        else if (rawVy < 0.0f - maxVelocity) { rawVy = 0.0f - maxVelocity; }

        vx = rawVx;
        vy = rawVy;
    }

    public float XVelocity() { return vx; }
    public float YVelocity() { return vy; }
}
