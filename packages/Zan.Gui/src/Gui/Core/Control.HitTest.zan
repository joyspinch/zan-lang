using System;
using System.Collections.Generic;
using Gui;

namespace Gui;

// Control.HitTest.zan - Visual Tree 空间命中测试与路由派发管线
public partial class Control {

    // 判断屏幕坐标 (x, y) 是否落在本控件的边界盒内
    public bool ContainsPoint(int x, int y) {
        if (this.bw <= 0 || this.bh <= 0) { return false; }
        return x >= this.bx && x < (this.bx + this.bw) &&
               y >= this.by && y < (this.by + this.bh);
    }

    // 构建从根节点到本节点的 Visual Tree 路径（用于 Preview/Tunneling 阶段）
    public List<Control> BuildVisualTreePath() {
        List<Control> path = new List<Control>();
        Control curr = this;
        while (curr != null) {
            path.Insert(0, curr);
            curr = curr.parent;
        }
        return path;
    }

    // 派发隧穿（Preview）事件：从根节点下沉到目标叶子节点
    public static void DispatchTunnel(List<Control> path, RoutedEventArgs e) {
        if (path == null) { return; }
        for (int i = 0; i < path.Count; i = i + 1) {
            if (e.handled) { return; }
            Control node = path[i];
            e.source = node;
            node.OnPreviewRoutedEvent(e);
        }
    }

    // 派发冒泡（Bubble）事件：从目标叶子节点向上传播至根节点
    public static void DispatchBubble(Control target, RoutedEventArgs e) {
        Control curr = target;
        while (curr != null) {
            if (e.handled) { return; }
            e.source = curr;
            curr.OnRoutedEvent(e);
            curr = curr.parent;
        }
    }

    // 标准路由事件完整管线：
    // 1. 隧穿阶段（Tunnel/Preview）：Root -> Target
    // 2. 冒泡阶段（Bubble）：Target -> Root
    public static void RouteEvent(Control target, RoutedEventArgs e) {
        if (target == null || e == null) { return; }
        List<Control> path = target.BuildVisualTreePath();

        // 阶段 1：隧穿下沉
        Control.DispatchTunnel(path, e);
        if (e.handled) { return; }

        // 阶段 2：冒泡上升
        Control.DispatchBubble(target, e);
    }

    public RoutedEventHandler routedHandler;
    public RoutedEventHandler previewRoutedHandler;

    public Control OnRouted(RoutedEventHandler handler) {
        this.routedHandler = handler;
        return this;
    }

    public Control OnPreviewRouted(RoutedEventHandler handler) {
        this.previewRoutedHandler = handler;
        return this;
    }

    // 标准内生交互状态位（WPF/Avalonia 对齐）
    protected bool isHovered;
    protected bool isPressed;

    public bool IsHovered() { return this.isHovered; }
    public bool IsPressed() { return this.isPressed; }

    // 标准物理输入虚方法钩子（供具体组件重写以实现固有状态机与手势合成）
    public virtual void OnPointerEnter(RoutedEventArgs e) {
        this.isHovered = true;
    }

    public virtual void OnPointerLeave(RoutedEventArgs e) {
        this.isHovered = false;
        this.isPressed = false;
    }

    public virtual void OnPointerDown(RoutedEventArgs e) {
        this.isPressed = true;
    }

    public virtual void OnPointerUp(RoutedEventArgs e) {
        this.isPressed = false;
    }

    public virtual void OnPointerMove(RoutedEventArgs e) { }
    public virtual void OnClick(RoutedEventArgs e) {
        if (this.extra != null && this.extra.Click != null) {
            this.extra.Click.RaiseS(this);
        }
    }
    public virtual void OnKeyDown(RoutedEventArgs e) { }
    public virtual void OnKeyUp(RoutedEventArgs e) { }
    public virtual void OnWheel(RoutedEventArgs e) { }

    // 隧穿事件虚方法，容器可在下沉阶段提前截获或处理（如遮罩、全局手势）
    public virtual void OnPreviewRoutedEvent(RoutedEventArgs e) {
        if (this.previewRoutedHandler != null) {
            this.previewRoutedHandler(this, e);
        }
    }

    // 冒泡事件虚方法，节点消费事件后可调用 e.Handle() 阻止继续向上冒泡
    public virtual void OnRoutedEvent(RoutedEventArgs e) {
        if (this.routedHandler != null) {
            this.routedHandler(this, e);
        }
        if (e.source != this) {
            this.OnChildEvent(e.source, e.eventName);
        }

        string ev = e.eventName;
        if (ev == "PointerEnter" || ev == "MouseEnter") { this.OnPointerEnter(e); this.TriggerEvent("Enter"); }
        else if (ev == "PointerLeave" || ev == "MouseLeave") { this.OnPointerLeave(e); this.TriggerEvent("Leave"); }
        else if (ev == "PointerDown" || ev == "MouseDown") { this.OnPointerDown(e); this.TriggerEvent("MouseDown"); }
        else if (ev == "PointerUp" || ev == "MouseUp") { this.OnPointerUp(e); this.TriggerEvent("MouseUp"); }
        else if (ev == "PointerMove" || ev == "MouseMove") { this.OnPointerMove(e); this.TriggerEvent("Move"); }
        else if (ev == "Click") { this.OnClick(e); this.TriggerEvent("Click"); }
        else if (ev == "KeyDown") { this.OnKeyDown(e); this.TriggerEvent("KeyDown"); }
        else if (ev == "KeyUp") { this.OnKeyUp(e); this.TriggerEvent("KeyUp"); }
        else if (ev == "Wheel") { this.OnWheel(e); this.TriggerEvent("Wheel"); }
        else if (e.eventName != "") {
            this.TriggerEvent(e.eventName);
        }
    }
}
