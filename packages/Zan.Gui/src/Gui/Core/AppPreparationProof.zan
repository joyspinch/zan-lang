namespace Gui;
internal class AppPreparationProof {
    private weak AppLoopRegistration ticket;
    private weak AppLoopOwner owner;
    private weak AppLoopParticipant participant;
    private int generation;
    internal AppPreparationProof(AppLoopRegistration registration) {
        ticket = registration;
        owner = registration.owner;
        participant = registration.participant;
        generation = registration.generation;
    }
    internal bool Current(App app) {
        AppLoopRegistration registration = ticket;
        return registration != null && owner != null && participant != null
            && app.LiveLoopRegistration(registration) && registration.host == app
            && registration.generation == generation && registration.owner == owner
            && registration.participant == participant;
    }
}
