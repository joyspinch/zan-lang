using System;
using Gui.Backend;

namespace Gui;

// 触觉反馈类型（物理马达微振与触感反馈模式）
public enum HapticFeedbackType {
    Light = 0,      // 0: 轻触，虚拟按键打字、轻按
    Medium = 1,     // 1: 中度，开关切换、选项步进
    Heavy = 2,      // 2: 重度，长按弹窗、拖拽释手
    Selection = 3,  // 3: 滚动选择器步进微振
    Success = 4,    // 4: 操作成功双跳微振
    Warning = 5,    // 5: 警告提醒微振
    Error = 6       // 6: 错误操作三连阻尼振
}

// 跨平台移动端触觉反馈服务：
// 自动分发至各端 NDK 原生马达服务：
// - OpenHarmony: libvibrator.so 动态绑定 (OH_Vibrator_PlayVibration)
// - iOS: UIImpactFeedbackGenerator / UINotificationFeedbackGenerator
// - Android: NDK Vibrator 驱动
// - 桌面端: 安全零开销空操作
public class DeviceFeedback {
    public static void Vibrate(HapticFeedbackType type) {
        Platform.Shell().HapticFeedback((int)type);
    }

    public static void Light()     { DeviceFeedback.Vibrate(HapticFeedbackType.Light); }
    public static void Medium()    { DeviceFeedback.Vibrate(HapticFeedbackType.Medium); }
    public static void Heavy()     { DeviceFeedback.Vibrate(HapticFeedbackType.Heavy); }
    public static void Selection() { DeviceFeedback.Vibrate(HapticFeedbackType.Selection); }
    public static void Success()   { DeviceFeedback.Vibrate(HapticFeedbackType.Success); }
    public static void Warning()   { DeviceFeedback.Vibrate(HapticFeedbackType.Warning); }
    public static void Error()     { DeviceFeedback.Vibrate(HapticFeedbackType.Error); }
}
