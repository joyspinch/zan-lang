using System;
using System.Collections.Generic;

namespace Gui;

// 统一控件标识与作用域管理系统：
// 支持全局稳定计数器与分层作用域 Hash 栈（Push/Pop）。
// 容器与复合控件进入子域时调用 Push(name/index)，离开时 Pop()，
// 局部 ID 自动通过父级 Hash + 局部槽位派生，彻底消灭硬编码号段魔数。
public class WidgetId {
    static int seq;
    static int frameBase;

    // 作用域 Hash 栈
    static List<int> idStack;
    // 对应各层作用域的局部序列号栈
    static List<int> seqStack;
    // 当前作用域内的局部序列号
    static int localSeq;

    static void EnsureStack() {
        if (idStack == null) { idStack = new List<int>(); }
        if (seqStack == null) { seqStack = new List<int>(); }
    }

    // 获取当前作用域的基准哈希种子
    public static int CurrentScope() {
        WidgetId.EnsureStack();
        if (idStack.Count > 0) {
            return idStack[idStack.Count - 1];
        }
        return 0x811C9DC5;
    }

    // 压入字符串命名的子作用域（如 "table_row", "dialog_header"）
    public static void Push(string name) {
        WidgetId.EnsureStack();
        int parentHash = WidgetId.CurrentScope();
        int nextHash = IdHash.HashString(name, parentHash);
        idStack.Add(nextHash);
        seqStack.Add(localSeq);
        localSeq = 0;
    }

    // 压入整数命名的子作用域（如行索引 rowIndex, 单元格列号 colIndex）
    public static void Push(int index) {
        WidgetId.EnsureStack();
        int parentHash = WidgetId.CurrentScope();
        int nextHash = IdHash.HashInt(index, parentHash);
        idStack.Add(nextHash);
        seqStack.Add(localSeq);
        localSeq = 0;
    }

    // 弹出当前作用域并恢复上层计数器
    public static void Pop() {
        WidgetId.EnsureStack();
        if (idStack.Count > 0) {
            idStack.RemoveAt(idStack.Count - 1);
        }
        if (seqStack.Count > 0) {
            localSeq = seqStack[seqStack.Count - 1];
            seqStack.RemoveAt(seqStack.Count - 1);
        } else {
            localSeq = 0;
        }
    }

    // 新的进程唯一或局部作用域唯一的控件 id。
    public static int Next() {
        WidgetId.EnsureStack();
        if (idStack.Count > 0) {
            // 在作用域栈内时，基于当前作用域 Hash + 局部序列派生正数 ID
            int baseHash = idStack[idStack.Count - 1] & 0x3FFFFFFF;
            int scopedId = 2000000 + baseHash + localSeq;
            localSeq = localSeq + 1;
            return scopedId;
        }
        seq = seq + 1;
        return 1000000 + seq;
    }

    // 将当前计数器记录为逐帧基线。
    public static void Mark() {
        frameBase = seq;
    }

    // 将 id 计数器回退到帧基线。
    public static void ResetFrame() {
        seq = frameBase;
        if (idStack != null) { idStack.Clear(); }
        if (seqStack != null) { seqStack.Clear(); }
        localSeq = 0;
    }

    // 当前原始计数器。
    public static int SeqValue() { return seq; }

    // 强制将计数器设为 `v`（保留向后兼容老代码）。
    public static void SetSeq(int v) { seq = v; }

    // 预留 `n` 个连续的稳定 id 并返回第一个。
    public static int Block(int n) {
        WidgetId.EnsureStack();
        if (idStack.Count > 0) {
            int baseHash = idStack[idStack.Count - 1] & 0x3FFFFFFF;
            int first = 2000000 + baseHash + localSeq;
            localSeq = localSeq + n;
            return first;
        }
        int f = 1000000 + seq + 1;
        seq = seq + n;
        return f;
    }
}

