using System;
using System.Collections.Generic;

namespace Gui;

// 统一控件标识与作用域管理系统：
// 支持全局稳定计数器与分层作用域 Hash 栈（Push/Pop）。
// 容器与复合控件进入子域时调用 Push(name/index)，离开时 Pop()，
// 局部 ID 自动通过父级 Hash + 局部槽位派生，彻底消灭硬编码号段魔数。
public class WidgetId {
    static int seq;

    // 纯单调递增控件 ID 生成器（退役全局静态作用域栈，彻底杜绝跨实例/跨帧污染与串号）
    public static int Next() {
        seq = seq + 1;
        return 1000000 + seq;
    }

    // 预留 n 个连续的唯一 ID 并返回首个 ID
    public static int Block(int n) {
        int first = 1000000 + seq + 1;
        seq = seq + n;
        return first;
    }

    // 当前原始计数器（只读）
    public static int SeqValue() { return seq; }

    // 历史兼容空操作（静态作用域栈与逐帧回滚已彻底退役）
    public static int CurrentScope() { return 0x811C9DC5; }
    public static void Push(string name) { }
    public static void Push(int index) { }
    public static void Pop() { }
    public static void Mark() { }
    public static void ResetFrame() { }
    public static void SetSeq(int v) { seq = v; }
}

