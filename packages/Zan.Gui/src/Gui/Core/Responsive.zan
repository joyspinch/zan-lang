using System;

namespace Gui;

// 响应式栅格断点分类
public enum Breakpoint {
    Compact  = 0, // < 600px 移动窄屏/直板手机
    Medium   = 1, // 600px ~ 840px 折叠屏展开态 / 平板
    Expanded = 2  // >= 840px 桌面宽屏 / 大屏终端
}

// 响应式布局与媒体特征辅助
public class Responsive {
    public const int CompactMax = 599;
    public const int MediumMax = 839;

    public static Breakpoint FromWidth(int width) {
        if (width < 600) { return Breakpoint.Compact; }
        if (width < 840) { return Breakpoint.Medium; }
        return Breakpoint.Expanded;
    }

    public static Breakpoint Current(App app) {
        if (app == null) { return Breakpoint.Expanded; }
        return FromWidth(app.ClientWidth());
    }

    public static int Match(Breakpoint bp, int compactVal, int mediumVal, int expandedVal) {
        if (bp == Breakpoint.Compact) { return compactVal; }
        if (bp == Breakpoint.Medium) { return mediumVal; }
        return expandedVal;
    }

    public static int Match(App app, int compactVal, int mediumVal, int expandedVal) {
        return Match(Current(app), compactVal, mediumVal, expandedVal);
    }
}
