using System;
namespace Gui;
public enum Breakpoint {
    Compact  = 0, // < 600px 移动窄屏/直板手机
    Medium   = 1, // 600px ~ 840px 折叠屏展开态 / 平板
    Expanded = 2  // >= 840px 桌面宽屏 / 大屏终端
}
public class Responsive {
    public const int CompactMax = 599;
    public const int MediumMax = 839;
    public static int LogicalWidth(int physicalPx, App app) {
        if (physicalPx <= 0) { return 0; }
        if (app == null || app.dpiScale <= 0 || app.dpiScale == 100) { return physicalPx; }
        return (int)(((long)physicalPx * 100L + (long)app.dpiScale / 2L) / (long)app.dpiScale);
    }
    public static Breakpoint FromWidth(int width) {
        if (width < 600) { return Breakpoint.Compact; }
        if (width < 840) { return Breakpoint.Medium; }
        return Breakpoint.Expanded;
    }
    public static Breakpoint FromLogicalWidth(int physicalPx, App app) {
        return FromWidth(LogicalWidth(physicalPx, app));
    }
    public static Breakpoint ForControl(Control c, App app) {
        if (c != null && c.bw > 0) {
            return FromLogicalWidth(c.bw, app != null ? app : c.FindApp());
        }
        return Current(app != null ? app : (c != null ? c.FindApp() : null));
    }
    public static Breakpoint Current(App app) {
        if (app == null) { return Breakpoint.Expanded; }
        return FromLogicalWidth(app.ClientWidth(), app);
    }
    public static int ColumnsFor(int availPx, int minColPx, int gapPx, int maxCols) {
        if (maxCols < 1) { maxCols = 1; }
        if (minColPx <= 0 || availPx <= 0) { return 1; }
        if (gapPx < 0) { gapPx = 0; }
        int cols = (availPx + gapPx) / (minColPx + gapPx);
        if (cols < 1) { cols = 1; }
        if (cols > maxCols) { cols = maxCols; }
        return cols;
    }
    public static int Match(Breakpoint bp, int compactVal, int mediumVal, int expandedVal) {
        if (bp == Breakpoint.Compact) { return compactVal; }
        if (bp == Breakpoint.Medium) { return mediumVal; }
        return expandedVal;
    }
    public static int Match(App app, int compactVal, int mediumVal, int expandedVal) {
        return Match(Current(app), compactVal, mediumVal, expandedVal);
    }
}
