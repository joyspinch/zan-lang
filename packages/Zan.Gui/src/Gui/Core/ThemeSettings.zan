namespace Gui;

public class ThemeSettings {
    // Keep the callback owned by the App free of an App capture. The drawer's
    // existing loop registration owns teardown and reentrant setting changes.
    public static void Enable(App app) {
        if (app == null) { return; }
        app.SetThemeSettingsAction((App host) => host.ToggleThemeMenu(0));
    }

    public static void Show(App app) {
        if (app == null) { return; }
        ThemeSettings.Enable(app);
        app.ShowThemeDrawer();
    }
}
