using System;
using System.Collections.Generic;
using System.Threading;
using Gui.Backend;

namespace Gui;

// 框架拥有的浮动选项列表弹窗（由 Select / SelectBox /
// Dropdown / Menu 使用）。Zan 委托无法捕获局部变量或绑定 `this`，因此
// 弹窗以*数据*形式描述：控件在主渲染阶段将其交给 <c>App.AddOverlay</c>，
// <c>App.RunOverlays</c> 在所有内容之后绘制并分发它，
// 因此它始终绘制在最上层，并拥有最顶部的命中
// 区域（HitTester 后注册者优先）。选择选项会写入
// 绑定的模型、触发 <see cref="onChange"/> 并关闭弹窗；
// 在其它任何位置按压都会关闭它（单一、集中式分发——没有逐控件事件
// 抓取，应用代码中也没有 z-order 取巧）。
public class OverlayPopup {
    // 富菜单上一帧悬停到的行（即时模式绘制，用它判断是否值得
    // 为一次鼠标移动重绘）。
    static int lastRichHover;
    // 面板层叠遮挡（RenderRich 专用）：后面板绘制前，把画在它之上
    // 的面板矩形登记进来，行悬停判定跳过遮挡区内的落点。子/孙面板
    // 左翻（贴右缘放不下时翻到父面板之上）或上钳后与后面板重叠，
    // 鼠标落点同时落在两层行上；不遮挡的话被盖住的行照样点亮、
    // 切换子菜单、响应点击——表观正是「指针在前面板上移动，后面
    // 的菜单被激活」。宽 0 视为无遮挡；设值→绘制→清零成对出现，
    // 不跨帧留存。两条矩形是因为主面板之上可能同时叠着子与孙两级。
    static int occlAx;
    static int occlAy;
    static int occlAw;
    static int occlAh;
    static int occlBx;
    static int occlBy;
    static int occlBw;
    static int occlBh;
    // 子菜单悬停宽限：指针从父行斜穿父面板其它行去子面板
    // （子面板贴边被上钳，必然要掠过别行）的途中，掠过的
    // 那几帧不该立刻关掉已开的子菜单——记下开始掠过的行与
    // 时刻，满宽限仍停在非子菜单行上才关/换。第二组同义，
    // 用于孙级面板。
    static int subGraceRow;
    static int subGraceMs;
    static int subGraceRow2;
    static int subGraceMs2;
    int x;
    int y;
    int w;
    List<string> options;
    int baseId;
    SignalInt model;
    int triggerId;
    SignalBool openFlag;
    SignalInt scrollModel;
    UiEvent onChange;
    bool showCheck;

    // 富上下文菜单模式（图标 / 分隔线 / 分组标题 / 子菜单）。
    bool rich;
    // 外观抽屉模式（框架外观/效果/强调色设置面板）。
    bool themeDrawerMode;
    List<MenuItem> menuItems;
    SignalInt result;
    SignalInt subOpen;
    // 孙级子菜单（子面板里 kind=3 行再展开的一层）。宿主不传时
    // 指向私有哑信号（写它无人读），richSub2 才是「启用孙级」
    // 的门；偏移由宿主跨帧持有，与 subOpen 同寿命。
    SignalInt subOpen2;
    bool richSub2;

    // 富菜单滚动：弹窗每帧重建，偏移由宿主跨帧持有。richMaxRows
    // 限制主面板可见的可点击行数，长菜单出滚动条（滚轮 + 拖动）；
    // null / <=0 时面板保持整高不滚（与旧版一致）。richMinW 是
    // 面板宽度下限（Dropdown 让面板不窄于触发器），0 时不生效。
    SignalInt richScroll;
    int richMaxRows;
    int richMinW;

    // 自定义宿主模式：弹窗由 Control 的
    // OnPaintOverlay 绘制并分发（参见 Host），适用于需要定制
    // 面板而非内置选项列表/菜单/抽屉类型的浮动控件。
    Control host;

    // 富上下文菜单：包含 `items`（参见 MenuItem）的浮动面板，
    // 支持图标、分隔线、分组标题和两层悬停展开的
    // 子菜单。选中的叶子 `action` 写入 `result`；
    // 选择、外部按压或 Escape 都会关闭面板。`baseId` 必须是稳定的
    // 至少 256 个 id 的连续块（WidgetId.Block(256)）；走孙级扩展版
    // 时要 384（主面板 +128 = 子面板，+256 = 孙面板）。
    static OverlayPopup RichMenu(int x, int y, List<MenuItem> items, int baseId,
                                 SignalInt result, SignalBool openFlag,
                                 SignalInt subOpen) {
        return OverlayPopup.RichMenu(x, y, items, baseId, result, openFlag,
            subOpen, null, 0, 0);
    }

    // 滚动/宽度扩展版富菜单：`scroll` + `maxRows` 让长菜单只显示
    // maxRows 行并出滚动条（偏移由宿主跨帧持有）；`minW` 给面板
    // 宽度下限。其余同上。
    static OverlayPopup RichMenu(int x, int y, List<MenuItem> items, int baseId,
                                 SignalInt result, SignalBool openFlag,
                                 SignalInt subOpen, SignalInt scroll,
                                 int maxRows, int minW) {
        return OverlayPopup.RichMenu(x, y, items, baseId, result, openFlag,
            subOpen, scroll, maxRows, minW, null);
    }

    // 孙级扩展版：`subOpen2` 持有子面板里展开的孙级行
    // （-1 无，宿主跨帧持有并在菜单开/关时复位）。子面板里的
    // kind=3 行悬停时再展开一层面板；不用孙级传 null。
    static OverlayPopup RichMenu(int x, int y, List<MenuItem> items, int baseId,
                                 SignalInt result, SignalBool openFlag,
                                 SignalInt subOpen, SignalInt scroll,
                                 int maxRows, int minW, SignalInt subOpen2) {
        // 终点重载：就地构造。不能委托回 10 参版——两个重载
        // 会互相调用成死递归，菜单一开即栈溢出。
        OverlayPopup p = new OverlayPopup();
        p.rich = true;
        p.x = x;
        p.y = y;
        p.w = 0;
        p.options = new List<string>();
        p.menuItems = items;
        p.baseId = baseId;
        p.result = result;
        p.openFlag = openFlag;
        p.subOpen = subOpen;
        p.triggerId = 0 - 1;
        p.showCheck = false;
        p.richScroll = scroll;
        p.richMaxRows = maxRows;
        p.richMinW = minW;
        p.subOpen2 = subOpen2 != null ? subOpen2 : new SignalInt(0 - 1);
        p.richSub2 = subOpen2 != null;
        return p;
    }

    // 外观抽屉：右侧停靠的设置面板，包含外观
    // 列表、一键动画开/关开关、背景特效选择器和
    // 强调色色板。`baseId` 必须是至少
    // PresetCount + 24 个 id 的稳定块；状态存放在 App 上（themeMenuModel、
    // fxKindOverride、accentOverride、fxEnabled）。
    static OverlayPopup ThemeDrawer(int baseId, int triggerId,
                                    SignalBool openFlag, SignalInt scrollModel) {
        OverlayPopup p = new OverlayPopup();
        p.themeDrawerMode = true;
        p.x = 0;
        p.y = 0;
        p.w = 0;
        p.options = new List<string>();
        p.baseId = baseId;
        p.triggerId = triggerId;
        p.openFlag = openFlag;
        p.scrollModel = scrollModel;
        p.showCheck = false;
        return p;
    }

    // 完全自定义的浮动层：`h` 通过 OnPaintOverlay 重写绘制自己的弹窗（chrome、选项
    // 及输入分发）。让任何浮动控件
    // （Select 框、Popover、Tooltip 等）将整个弹窗交给
    // 覆盖层阶段处理——绘制在所有内容之上，命中区域最后注册——
    // 而无需专门的 OverlayPopup 类型。控件在主阶段将
    // 锚点几何存入自己的字段，并在打开时
    // 调用 `app.AddOverlay(OverlayPopup.Host(this))`。
    static OverlayPopup Host(Control h) {
        OverlayPopup p = new OverlayPopup();
        p.host = h;
        p.options = new List<string>();
        p.triggerId = 0 - 1;
        return p;
    }

    // 将锚定在 `x`、宽度为 `w` 的弹窗保持在窗口内。
    static int FitX(App app, int x, int w) {
        int margin = app.Scale(4);
        int right = app.canvas.Width() - margin - w;
        int px = x;
        if (px > right) { px = right; }
        if (px < margin) { px = margin; }
        return px;
    }

    // 将弹窗高度限制在窗口可显示范围内。
    static int FitH(App app, int h) {
        int margin = app.Scale(4);
        int avail = app.canvas.Height() - margin * 2;
        if (avail < 1) { avail = 1; }
        if (h > avail) { h = avail; }
        return h;
    }

    // 触发控件下方弹窗的垂直定位：`anchorY` 是
    // 首选顶部（触发控件底部加间距），`trigH` 是触发控件
    // 高度。会超出底部的弹窗翻转到触发控件上方，
    // 只有那里也放不下时才会被限制在窗口内
    // ——因此靠近底部边缘的下拉框会向上展开，而不是被
    // 窗口截断。
    static int FitY(App app, int anchorY, int trigH, int h) {
        int margin = app.Scale(4);
        int gap = app.Scale(4);
        int bottom = app.canvas.Height() - margin;
        int y = anchorY;
        if (y + h > bottom) {
            int above = anchorY - trigH - gap * 2 - h;
            if (above >= margin) { y = above; }
            else { y = bottom - h; }
        }
        if (y < margin) { y = margin; }
        return y;
    }

    // 带选中对勾的选项列表弹窗：点击选项写入 `model`、触发
    // `onChange` 并关闭；在弹窗和触发控件之外按压或 Escape 也关闭。
    // 第 i 个选项的命中 id 为 `baseId + i`，滚动偏移存于 `scrollModel`。
    static OverlayPopup OptionList(int x, int y, int w, List<string> options,
                                   int baseId, SignalInt model, int triggerId,
                                   SignalBool openFlag, SignalInt scrollModel,
                                   UiEvent onChange) {
        OverlayPopup p = new OverlayPopup();
        p.x = x;
        p.y = y;
        p.w = w;
        p.options = options;
        p.baseId = baseId;
        p.model = model;
        p.triggerId = triggerId;
        p.openFlag = openFlag;
        p.scrollModel = scrollModel;
        p.onChange = onChange;
        p.showCheck = true;
        return p;
    }

    // 操作菜单（如 Dropdown）：与 OptionList 相同的锚定、遮罩、外部点击关闭
    // 弹窗，但没有常驻的选中对勾。
    // 选中的索引写入 `model` 并触发 `onChange`。
    static OverlayPopup Menu(int x, int y, int w, List<string> options,
                             int baseId, SignalInt model, int triggerId,
                             SignalBool openFlag, SignalInt scrollModel,
                             UiEvent onChange) {
        OverlayPopup p = OverlayPopup.OptionList(x, y, w, options, baseId, model,
            triggerId, openFlag, scrollModel, onChange);
        p.showCheck = false;
        return p;
    }

    // 绘制并分发弹窗（由 App.RunOverlays 在覆盖层阶段调用）：
    // 按构造模式分流——宿主控件的 OnPaintOverlay、富菜单、
    // 外观抽屉，或内置选项列表（样式取 `popup` / `popup.option`
    // 规则），并集中处理选择、外部按压关闭与 Escape。
    void Render(App app) {
        if (host != null) {
            host.OnPaintOverlay(app);
            return;
        }
        if (rich) {
            this.RenderRich(app);
            return;
        }
        if (themeDrawerMode) {
            this.RenderThemeDrawer(app);
            return;
        }
        Canvas c = app.canvas;
        Theme t = app.theme;
        int count = options.Count;
        int optH = t.heightMedium;
        int totalH = count * optH;
        int margin = app.Scale(4);
        int popupW = w;
        int maxW = c.Width() - margin * 2;
        if (maxW < 1) { maxW = 1; }
        if (popupW < app.Scale(48)) { popupW = app.Scale(48); }
        if (popupW > maxW) { popupW = maxW; }
        int popupX = OverlayPopup.FitX(app, x, popupW);

        int maxViewH = OverlayPopup.FitH(app, optH * 8);
        int viewH = totalH;
        if (viewH > maxViewH) { viewH = maxViewH; }
        int popupY = OverlayPopup.FitY(app, y, t.heightMedium, viewH);

        int maxScroll = totalH - viewH;
        if (maxScroll < 0) { maxScroll = 0; }
        int scrollY = scrollModel.Get();
        int selectedIdx = model.Get();
        if (scrollY == 0 && selectedIdx * optH >= viewH) {
            scrollY = selectedIdx * optH - viewH + optH;
        }
        if (scrollY < 0) { scrollY = 0; }
        if (scrollY > maxScroll) { scrollY = maxScroll; }

        bool pointerInside = app.mouseX >= popupX && app.mouseX < popupX + popupW
            && app.mouseY >= popupY && app.mouseY < popupY + viewH;
        bool ownsWheel = app.CaptureWheel(popupX, popupY, popupW, viewH);
        if (ownsWheel && maxScroll > 0) {
            int oldScroll = scrollY;
            scrollY = scrollY - app.window.EventKeyCode() * optH / 120;
            if (scrollY < 0) { scrollY = 0; }
            if (scrollY > maxScroll) { scrollY = maxScroll; }
            if (scrollY != oldScroll) {
                scrollModel.Set(scrollY);
                app.RequestRedraw();
            }
        }
        StyleBox popupStyle = Control.BareBox(app, "popup", Style.SNormal());
        StyleBox optionStyle = Style.Part(app, "popup", "option", "", "", "",
                                          Style.SNormal());
        StyleBox optionHover = Style.Part(app, "popup", "option", "", "", "",
                                          Style.SHover());
        StyleBox optionSelected = Style.Part(app, "popup", "option", "", "", "",
                                             Style.SSelected());
        StyleBox scrollbarStyle = Style.Part(app, "popup", "scrollbar", "",
                                             "", "", Style.SNormal());
        int popupRadius = popupStyle.RadiusOr(t.borderRadiusMedium);
        int popupShadow = popupStyle.shadow;
        int popupBg = popupStyle.BgOr(0);
        int popupBorder = popupStyle.BorderOr(0);
        int popupBorderW = popupStyle.BorderWOr(1);
        int optionHoverBg = optionHover.BgOr(0);
        int optionText = optionStyle.FgOr(0);
        int optionSelectedText = optionSelected.FgOr(optionText);
        int scrollbarBg = scrollbarStyle.BgOr(0);
        // 阴影 + 主体。柔和投影用圆角 SDF 一次出图（Canvas.ShadowRoundRect）：
        // 衰减连续，角部无线状缝，每个像素只写一次（box-shadow
        // 0 4 10，见 base.css select::popup）。
        app.BlockHitsBelow();
        if (popupShadow != 0) {
            int sdBlur = popupStyle.shadowBlur > 0
                ? popupStyle.shadowBlur : 10;
            int sdDx = popupStyle.shadowDx;
            int sdDy = popupStyle.shadowDy;
            c.ShadowRoundRect(popupX + sdDx, popupY + sdDy, popupW, viewH,
                              popupRadius, app.Scale(sdBlur),
                              popupStyle.Fade(popupShadow));
        }
        c.FillRoundRect(popupX, popupY, popupW, viewH, popupRadius, popupBg);
        c.DrawRoundRect(popupX, popupY, popupW, viewH, popupRadius,
                        popupBorder, popupBorderW);
        app.BlockHitsRect(popupX, popupY, popupW, viewH);

        c.PushClip(popupX, popupY, popupW, viewH);
        for (int i = 0; i < count; i = i + 1) {
            int optId = baseId + i;
            int optY = popupY + i * optH - scrollY;
            if (optY + optH > popupY && optY < popupY + viewH) {
                bool hovered = app.focus.IsHovered(optId);
                bool selected = showCheck && i == selectedIdx;
                if (hovered) {
                    c.FillRect(popupX + 1, optY, popupW - 2, optH, optionHoverBg);
                }
                int textColor = optionText;
                if (selected) { textColor = optionSelectedText; }
                int optMaxW = popupW - t.paddingSmall - t.paddingLarge - t.iconSizeSmall - t.paddingSmall;
                int optFs = Style.FontFallback(app, "medium");
                c.DrawText(popupX + t.paddingSmall, Canvas.CenterTextY(optY, optH, optFs),
                           Ellipsis.Fit(options[i], optMaxW, optFs), textColor, optFs);
                if (selected) {
                    c.DrawGlyphIn("check", popupX + popupW - t.paddingLarge - t.iconSizeSmall,
                                        optY, t.iconSizeSmall, optH,
                                        t.iconSizeSmall, optionSelectedText);
                }
                app.hitTester.RegisterRect(optId, popupX, optY, popupW, optH, 0);
            }
        }
        c.PopClip();
        if (maxScroll > 0 && viewH > 0) {
            int barW = app.Scale(5);
            int thumbH = viewH * viewH / totalH;
            int minThumb = app.Scale(18);
            if (thumbH < minThumb) { thumbH = minThumb; }
            if (thumbH > viewH) { thumbH = viewH; }
            int travel = viewH - thumbH;
            int thumbY = popupY;
            if (maxScroll > 0) { thumbY = popupY + scrollY * travel / maxScroll; }
            c.FillRoundRect(popupX + popupW - barW - app.Scale(2), thumbY,
                            barW, thumbH, barW / 2, scrollbarBg);
        }

        // 集中分发：点击落在选项上（按上一帧区域解析，
        // 上一帧区域已把弹窗置顶）则选择；
        // 在弹窗和触发控件之外任意位置按压则关闭。
        int kind = app.EventKind();
        if (kind == 3) {
            int hit = app.ClickTarget();
            if (hit >= baseId && hit < baseId + count) {
                int idx = hit - baseId;
                // 操作菜单（无对勾）每次选择都会触发，包括
                // 再次选择当前索引；选择列表仅在变更时触发。
                if (!showCheck || idx != model.Get()) {
                    model.Set(idx);
                    onChange.Raise();
                }
                app.ClaimClick();
                openFlag.Set(false);
                app.RequestRedraw();
            }
        }
        if (kind == 2) {
            int pt = app.PressTarget();
            bool insideOption = pt >= baseId && pt < baseId + count;
            if (pt != triggerId && !insideOption) {
                app.ClaimClick();
                openFlag.Set(false);
                app.RequestRedraw();
            }
        }
        if (kind == 4 && app.window.EventKeyCode() == 27) {
            openFlag.Set(false);
            app.RequestRedraw();
        }
    }

    // 委托给独立外观抽屉组件 ThemeDrawer 进行渲染与交互处理。
    void RenderThemeDrawer(App app) {
        ThemeDrawer.Render(app, baseId, triggerId, openFlag, scrollModel);
    }

    // 强调色色板的候选色（0 = 跟随外观默认值，转发至 ThemeDrawer）。
    public static List<int> DrawerAccents() {
        return ThemeDrawer.DrawerAccents();
    }

    // 整窗/壁纸不透明度的候选档位（百分比，转发至 ThemeDrawer）。
    public static List<int> DrawerOpLevels() {
        return ThemeDrawer.DrawerOpLevels();
    }

    // 动效标签页的背景特效选项名（转发至 ThemeDrawer）。
    public static List<string> DrawerKinds() {
        return ThemeDrawer.DrawerKinds();
    }

    // 富项目列表的面板宽度：最宽标签加上图标列和
    // 右侧留白（快捷键文本 / 子菜单箭头），并限制最小宽度。
    static int RichWidth(App app, List<MenuItem> items) {
        Theme t = app.theme;
        int padH = OverlayPopup.MenuPadH(app);
        int iconCol = t.iconSizeSmall + app.Scale(6);
        int maxLbl = 0;
        int maxRight = 0;
        for (int i = 0; i < items.Count; i = i + 1) {
            MenuItem m = items[i];
            if (m.kind == 0 || m.kind == 2 || m.kind == 3) {
                int lw = Canvas.MeasureText(m.label, Style.FontFallback(app, "small"));
                if (lw > maxLbl) { maxLbl = lw; }
            }
            if (m.kind == 0 && m.shortcut != "") {
                int sw = Canvas.MeasureText(m.shortcut, Style.FontFallback(app, "small"));
                if (sw > maxRight) { maxRight = sw; }
            }
            if (m.kind == 3 && t.iconSizeSmall > maxRight) { maxRight = t.iconSizeSmall; }
        }
        int w = padH + iconCol + maxLbl + app.Scale(16) + maxRight + padH;
        int minW = app.Scale(140);
        if (w < minW) { w = minW; }
        return w;
    }

    // 富菜单行高与间距：比表单控件（heightMedium）紧凑，
    // 整体缩小菜单体积以提升桌面端操作信息密度与轻量感。
    static int MenuRowH(App app) { return app.Scale(23); }
    static int MenuPadV(App app) { return app.Scale(4); }
    static int MenuPadH(App app) { return app.Scale(6); }
    static int MenuSepH(App app) { return app.Scale(6); }
    static int MenuHdrH(App app) { return app.Scale(18); }

    // 富项目列表的可视高度：窗口装得下全部条目时整高显示
    // （行数上限只是小窗口的兜底，不该在满屏窗口里制造滚动条）；
    // 内容高过窗口时取行数上限与窗口可用高的较小者——两种
    // 情况都出滚动条而不是把面板截出屏。定位与渲染共用同一
    // 口径，宿主传进来的 y 才不会按整高翻转到触发器上方。
    static int RichViewH(App app, List<MenuItem> items, int maxRows) {
        int fullH = OverlayPopup.RichHeight(app, items);
        if (maxRows <= 0) { return fullH; }
        int avail = app.canvas.Height() - app.Scale(8);
        if (fullH <= avail) { return fullH; }
        int cap = OverlayPopup.MenuPadV(app) * 2 + maxRows * OverlayPopup.MenuRowH(app);
        if (cap < avail) { return cap; }
        return avail;
    }

    // 富项目列表的面板高度（分隔线和标题比
    // 可点击行更矮）。
    static int RichHeight(App app, List<MenuItem> items) {
        int rowH = OverlayPopup.MenuRowH(app);
        int sepH = OverlayPopup.MenuSepH(app);
        int hdrH = OverlayPopup.MenuHdrH(app);
        int h = OverlayPopup.MenuPadV(app) * 2;
        for (int i = 0; i < items.Count; i = i + 1) {
            int k = items[i].kind;
            if (k == 1) { h = h + sepH; }
            else if (k == 2) { h = h + hdrH; }
            else { h = h + rowH; }
        }
        return h;
    }

    // `upto` 处项目在面板内的 Y 偏移，按行类型计算。
    static int RichRowTop(App app, List<MenuItem> items, int upto, int startY) {
        int rowH = OverlayPopup.MenuRowH(app);
        int sepH = OverlayPopup.MenuSepH(app);
        int hdrH = OverlayPopup.MenuHdrH(app);
        int yy = startY;
        for (int i = 0; i < upto; i = i + 1) {
            int k = items[i].kind;
            if (k == 1) { yy = yy + sepH; }
            else if (k == 2) { yy = yy + hdrH; }
            else { yy = yy + rowH; }
        }
        return yy;
    }

    // 登记本帧绘制的遮挡矩形（宽 0 = 无）。每次 PaintRichPanel
    // 绘制前由 RenderRich 按面板 z 序设置，绘制后立即清零。
    static void SetOccluders(int ax, int ay, int aw, int ah,
                             int bx, int by, int bw, int bh) {
        OverlayPopup.occlAx = ax;
        OverlayPopup.occlAy = ay;
        OverlayPopup.occlAw = aw;
        OverlayPopup.occlAh = ah;
        OverlayPopup.occlBx = bx;
        OverlayPopup.occlBy = by;
        OverlayPopup.occlBw = bw;
        OverlayPopup.occlBh = bh;
    }

    // 落点是否在本帧登记的遮挡矩形内——被画在更上层面板盖住的
    // 区域里，后面板的行不得再响应悬停（激活用的是同一批悬停
    // 结果，随之一起被挡住）。
    static bool PointOccluded(int mx, int my) {
        if (OverlayPopup.occlAw > 0
            && mx >= OverlayPopup.occlAx
            && mx < OverlayPopup.occlAx + OverlayPopup.occlAw
            && my >= OverlayPopup.occlAy
            && my < OverlayPopup.occlAy + OverlayPopup.occlAh) { return true; }
        if (OverlayPopup.occlBw > 0
            && mx >= OverlayPopup.occlBx
            && mx < OverlayPopup.occlBx + OverlayPopup.occlBw
            && my >= OverlayPopup.occlBy
            && my < OverlayPopup.occlBy + OverlayPopup.occlBh) { return true; }
        return false;
    }

    // 在 (px,py) 处绘制一个富菜单面板（图标 / 分隔线 / 标题 / 子菜单
    // 箭头），并为每个可点击 / 子菜单行注册命中 id `idBase + rowIndex`。
    // `ph` 是可视高度，行按 `scrollY` 上移并裁进面板（可滚动主面板
    // 用，子菜单面板传 0）。返回光标所在的行索引，没有则为 -1。
    // `barW` 是面板右缘滚动条条带的宽度（无可滚动时为 0）：
    // 行悬停不含条带——条带归滚动条，悬停伸进去会让拖动滑块
    // 的指针扫出子菜单父行，子面板开合顶漂覆盖层 AllocId，
    // 滚动条 IsPressed 失配后拖动中断、恢复时瞬移。
    static int PaintRichPanel(App app, List<MenuItem> items, int px, int py,
                              int pw, int ph, int idBase, int scrollY,
                              int barW) {
        Canvas c = app.canvas;
        Theme t = app.theme;
        int rowH = OverlayPopup.MenuRowH(app);
        int sepH = OverlayPopup.MenuSepH(app);
        int hdrH = OverlayPopup.MenuHdrH(app);
        int padV = OverlayPopup.MenuPadV(app);
        int padH = OverlayPopup.MenuPadH(app);
        int iconCol = t.iconSizeSmall + app.Scale(6);

        StyleBox menuStyle = Style.Full(app, "contextmenu", "", "",
                                        Style.SNormal());
        StyleBox itemStyle = Style.Part(app, "contextmenu", "item", "", "",
                                        "", Style.SNormal());
        StyleBox itemHover = Style.Part(app, "contextmenu", "item", "", "",
                                        "", Style.SHover());
        StyleBox itemDanger = Style.Part(app, "contextmenu", "item", "",
                                         "danger", "", Style.SNormal());
        StyleBox dangerHover = Style.Part(app, "contextmenu", "item", "",
                                          "danger", "", Style.SHover());
        StyleBox itemDisabled = Style.Part(app, "contextmenu", "item", "",
                                           "", "", Style.SDisabled());
        StyleBox headerStyle = Style.Part(app, "contextmenu", "header", "",
                                          "", "", Style.SNormal());
        StyleBox accelStyle = Style.Part(app, "contextmenu", "accel", "", "",
                                         "", Style.SNormal());
        StyleBox separatorStyle = Style.Part(app, "contextmenu", "separator", "",
                                             "", "", Style.SNormal());
        int menuRadius = menuStyle.RadiusOr(t.borderRadiusMedium);
        int menuShadow = menuStyle.shadow;
        int menuBg = menuStyle.BgOr(0);
        int menuBorder = menuStyle.BorderOr(0);
        int menuBorderW = menuStyle.BorderWOr(1);
        int separatorBg = separatorStyle.BgOr(0);
        int itemFg = itemStyle.FgOr(0);
        int itemHoverBg = itemHover.BgOr(0);
        int itemDangerFg = itemDanger.FgOr(app.theme.error);
        int dangerHoverBg = dangerHover.BgOr(itemHoverBg);
        int itemDisabledFg = itemDisabled.FgOr(itemFg);
        int headerFg = headerStyle.FgOr(0);
        int accelFg = accelStyle.FgOr(0);

        // 右键/命令菜单柔和投影（box-shadow 0 4 10，同 select::popup）：
        // 圆角 SDF 一次出图（Canvas.ShadowRoundRect）。
        if (menuShadow != 0) {
            int mBlur = menuStyle.shadowBlur > 0 ? menuStyle.shadowBlur : 10;
            int mDx = menuStyle.shadowDx;
            int mDy = menuStyle.shadowDy;
            c.ShadowRoundRect(px + mDx, py + mDy, pw, ph, menuRadius,
                              app.Scale(mBlur),
                              menuStyle.Fade(menuShadow));
        }
        c.FillRoundRect(px, py, pw, ph, menuRadius, menuBg);
        c.DrawRoundRect(px, py, pw, ph, menuRadius, menuBorder, menuBorderW);
        app.BlockHitsRect(px, py, pw, ph);

        int hoverRow = 0 - 1;
        int hoverMaxX = px + pw - barW;
        int rowY = py + padV - scrollY;
        c.PushClip(px, py, pw, ph);
        for (int i = 0; i < items.Count; i = i + 1) {
            MenuItem m = items[i];
            if (m.kind == 1) {
                if (rowY + sepH > py && rowY < py + ph) {
                    c.FillRect(px + padH, rowY + sepH / 2, pw - padH * 2, 1,
                               separatorBg);
                }
                rowY = rowY + sepH;
            } else if (m.kind == 2) {
                if (rowY + hdrH > py && rowY < py + ph) {
                    int ty = Canvas.CenterTextY(rowY, hdrH, Style.FontFallback(app, "small"));
                    c.DrawText(px + padH, ty, m.label, headerFg, Style.FontFallback(app, "small"));
                }
                rowY = rowY + hdrH;
            } else {
                bool vis = rowY + rowH > py && rowY < py + ph;
                bool hovered = vis
                    && app.mouseX >= px && app.mouseX < hoverMaxX
                    && app.mouseY >= rowY && app.mouseY < rowY + rowH
                    && !OverlayPopup.PointOccluded(app.mouseX, app.mouseY);
                int fg = itemFg;
                int hoverBg = itemHoverBg;
                if (m.disabled) { fg = itemDisabledFg; }
                else if (m.danger) {
                    fg = itemDangerFg;
                    hoverBg = dangerHoverBg;
                }
                if (vis && hovered && !m.disabled) {
                    c.FillRect(px + 1, rowY, pw - 2, rowH, hoverBg);
                }
                if (vis) {
                    if (m.swatch != 0) {
                        // 色块（替代图标位，占同一列）：单色一枚圆角
                        // 块；swatch2 非 0 时右半覆盖第二色（clip 出
                        // 直边拼缝，两角仍是圆的），读作双色渐变预设。
                        int chipS = t.iconSizeSmall - 2;
                        if (chipS < 8) { chipS = 8; }
                        int chipX = px + padH + 1;
                        int chipY = rowY + (rowH - chipS) / 2;
                        int chipR = app.Scale(3);
                        if (chipR < 2) { chipR = 2; }
                        c.FillRoundRect(chipX, chipY, chipS, chipS, chipR,
                                        m.swatch);
                        if (m.swatch2 != 0 && m.swatch2 != m.swatch) {
                            c.PushClip(chipX + chipS / 2, chipY,
                                       chipS - chipS / 2, chipS);
                            c.FillRoundRect(chipX, chipY, chipS, chipS, chipR,
                                            m.swatch2);
                            c.PopClip();
                        }
                        c.DrawRoundRect(chipX, chipY, chipS, chipS, chipR,
                                        menuBorder, 1);
                        if (m.icon != "") {
                            c.DrawGlyphIn(m.icon, chipX, chipY, chipS, chipS, chipS - 2, 0xFFFFFF);
                        }
                    } else if (m.icon != "") {
                        c.DrawGlyphIn(m.icon, px + padH, rowY,
                            t.iconSizeSmall, rowH, t.iconSizeSmall, fg);
                    }
                    int ty = Canvas.CenterTextY(rowY, rowH, Style.FontFallback(app, "small"));
                    c.DrawText(px + padH + iconCol, ty, m.label, fg, Style.FontFallback(app, "small"));
                    if (m.kind == 3) {
                        c.DrawGlyphIn("chevron-right",
                            px + pw - padH - t.iconSizeSmall, rowY,
                            t.iconSizeSmall, rowH, t.iconSizeSmall, fg);
                    } else if (m.shortcut != "") {
                        int sw = Canvas.MeasureText(m.shortcut, Style.FontFallback(app, "small"));
                        c.DrawText(px + pw - padH - sw, ty, m.shortcut,
                            accelFg, Style.FontFallback(app, "small"));
                    }
                    if (hovered) { hoverRow = i; }
                    // 命中区裁到可视范围：滚动时首尾的半行只以可见
                    // 部分响应点击，面板边缘外的不可见部分不拦截。
                    int vy0 = rowY;
                    if (vy0 < py) { vy0 = py; }
                    int vy1 = rowY + rowH;
                    if (vy1 > py + ph) { vy1 = py + ph; }
                    app.hitTester.RegisterRect(idBase + i, px, vy0, pw,
                                               vy1 - vy0, 0);
                }
                rowY = rowY + rowH;
            }
        }
        c.PopClip();
        return hoverRow;
    }

    // 绘制并分发富菜单：主面板（可按 richMaxRows 出滚动条）加
    // 悬停展开的一层子菜单。叶子项在左键松开时把 `action` 写入
    // `result` 并关闭；面板外按压、Escape 或窗口失焦也关闭。
    // 行悬停按几何解析，仅悬停行变化时请求重绘。
    void RenderRich(App app) {
        Canvas c = app.canvas;
        Theme t = app.theme;
        List<MenuItem> items = menuItems;
        int n = items.Count;
        int margin = app.Scale(4);
        int cw = c.Width();
        int ch = c.Height();

        int pw = OverlayPopup.RichWidth(app, items);
        if (richMinW > pw) { pw = richMinW; }
        int fullH = OverlayPopup.RichHeight(app, items);
        int px = x;
        if (px + pw > cw - margin) { px = cw - margin - pw; }
        if (px < margin) { px = margin; }
        // 可滚动主面板：可视高度按 richMaxRows 收口，超出部分滚轮
        // 和拖动滚动条都可用。
        int viewH = fullH;
        int scrollY = 0;
        int maxScroll = 0;
        int py = y;
        if (richScroll != null && richMaxRows > 0) {
            viewH = OverlayPopup.RichViewH(app, items, richMaxRows);
            maxScroll = fullH - viewH;
            if (maxScroll < 0) { maxScroll = 0; }
        }
        if (py + viewH > ch - margin) { py = ch - margin - viewH; }
        if (py < margin) { py = margin; }
        if (maxScroll > 0) {
            // 滚轮直接按几何认领（CaptureWheel 仲裁），不走
            // Ui.Over：本弹层已铺全屏遮罩，PointerCaptured 恒为
            // 真，经 Ui.Over 的 HandleWheel 在弹层里永远拿不到
            // 滚轮事件。
            bool ownsWheel = app.CaptureWheel(px, py, pw, viewH);
            if (ownsWheel && app.EventKind() == 13) {
                int wdelta = app.window.EventKeyCode();
                int cur = richScroll.Get() - wdelta * app.scrollSpeed / 120;
                if (cur < 0) { cur = 0; }
                if (cur > maxScroll) { cur = maxScroll; }
                if (cur != richScroll.Get()) {
                    richScroll.Set(cur);
                    app.NoteScrollDamage(px, py, pw, viewH);
                }
            }
            scrollY = richScroll.Get();
            if (scrollY < 0) { scrollY = 0; }
            if (scrollY > maxScroll) { scrollY = maxScroll; }
            richScroll.Set(scrollY);
        }

        app.BlockHitsBelow();
        // 富菜单行由几何驱动：悬停/激活都按几何解析，只在悬停行
        // 真的变了时重绘。几何解析不感知层叠，重叠面板（子/孙面板
        // 左翻或上钳盖住后面板）里同一落点会同时命中两层行——
        // 所以后面板绘制前，先把画在它之上的面板矩形登记为遮挡
        // （SetOccluders），被盖住的行不再点亮/切换/激活。
        int barW = 0;
        if (maxScroll > 0) { barW = app.Scale(10); }
        // 主面板最先绘制。子/孙面板矩形只依赖当前打开状态与面板
        // 几何，这里按 curSub/curSub2 预先算出（稳态下与本帧实际
        // 绘制位置一致），供遮挡与后面的悬停判定共用。
        int curSub = subOpen.Get();
        int childX = 0;
        int childY = 0;
        int childW = 0;
        int childH = 0;
        bool haveChild = false;
        if (curSub >= 0 && curSub < n && items[curSub].kind == 3) {
            List<MenuItem> ckids = items[curSub].children;
            childW = OverlayPopup.RichWidth(app, ckids);
            childH = OverlayPopup.RichHeight(app, ckids);
            childX = px + pw - app.Scale(4);
            if (childX + childW > cw - margin) { childX = px - childW + app.Scale(4); }
            childY = OverlayPopup.RichRowTop(app, items, curSub, py + OverlayPopup.MenuPadV(app))
                - scrollY;
            if (childY + childH > ch - margin) { childY = ch - margin - childH; }
            if (childY < margin) { childY = margin; }
            haveChild = true;
        }
        int occGx = 0;
        int occGy = 0;
        int occGw = 0;
        int occGh = 0;
        if (richSub2 && haveChild) {
            int occSub2 = subOpen2.Get();
            List<MenuItem> ckids = items[curSub].children;
            if (occSub2 >= 0 && occSub2 < ckids.Count
                && ckids[occSub2].kind == 3) {
                List<MenuItem> okids = ckids[occSub2].children;
                occGw = OverlayPopup.RichWidth(app, okids);
                occGh = OverlayPopup.RichHeight(app, okids);
                occGx = childX + childW - app.Scale(4);
                if (occGx + occGw > cw - margin) { occGx = childX - occGw + app.Scale(4); }
                occGy = OverlayPopup.RichRowTop(app, ckids, occSub2,
                    childY + OverlayPopup.MenuPadV(app));
                if (occGy + occGh > ch - margin) { occGy = ch - margin - occGh; }
                if (occGy < margin) { occGy = margin; }
            }
        }
        OverlayPopup.SetOccluders(childX, childY, childW, childH,
            occGx, occGy, occGw, occGh);
        // 声明原生浮层遮挡区：主面板与各级子面板盖住的区域从 WKWebView/WebView2 中裁掉
        NativeLayer.Occlude(app, px, py, pw, viewH);
        if (haveChild) {
            NativeLayer.Occlude(app, childX, childY, childW, childH);
        }
        if (occGw > 0 && occGh > 0) {
            NativeLayer.Occlude(app, occGx, occGy, occGw, occGh);
        }
        int overRow = OverlayPopup.PaintRichPanel(app, items, px, py, pw, viewH,
            baseId, scrollY, barW);
        OverlayPopup.SetOccluders(0, 0, 0, 0, 0, 0, 0, 0);
        if (overRow != OverlayPopup.lastRichHover) {
            OverlayPopup.lastRichHover = overRow;
            app.RequestRedraw();
        }

        // 跟踪当前打开的（若有）子菜单。悬停子菜单
        // 父项时打开；光标位于父项或其子面板上时保持打开；
        // 光标移到其它（非子菜单）行时关闭。
        bool overParentSub = overRow >= 0 && overRow < n && items[overRow].kind == 3;
        bool overOtherRow = overRow >= 0 && !overParentSub;

        bool overChild = haveChild
            && app.mouseX >= childX && app.mouseX < childX + childW
            && app.mouseY >= childY && app.mouseY < childY + childH;

        int newSub = curSub;
        if (overParentSub) {
            newSub = overRow;
            OverlayPopup.subGraceRow = 0 - 1;
        } else if (overChild) {
            newSub = curSub;
            OverlayPopup.subGraceRow = 0 - 1;
        } else if (overOtherRow) {
            // 立即关会把「斜穿父面板去子面板」的路径打断：指针
            // 掠过别的行只是路过，满宽限还停在这行上才是真要关。
            if (curSub < 0) { newSub = 0 - 1; }
            else if (OverlayPopup.subGraceRow == overRow
                     && Window.GetTickMs() - OverlayPopup.subGraceMs >= 400) {
                newSub = 0 - 1;
            } else {
                if (OverlayPopup.subGraceRow != overRow) {
                    OverlayPopup.subGraceRow = overRow;
                    OverlayPopup.subGraceMs = Window.GetTickMs();
                }
                newSub = curSub;
            }
        }
        if (newSub == 0 - 1) { OverlayPopup.subGraceRow = 0 - 1; }
        if (newSub != curSub) {
            subOpen.Set(newSub);
            app.RequestRedraw();
        }

        int childOver = 0 - 1;
        int cx = 0;
        int cy = 0;
        int cwd = 0;
        int chd = 0;
        bool childOpen = false;
        List<MenuItem> childKids = null;
        // 已开孙面板的矩形（按 curSub2 的几何摆位）：既在子面板
        // 绘制时作遮挡（孙面板盖住子面板时，被盖住的子面板行不得
        // 再响应悬停/点击），也在下方 richSub2 段做「指针进面板
        // 即保持」的判定。必须在子面板 PaintRichPanel 之前算好。
        bool hadGrand = false;
        int hx = 0;
        int hy = 0;
        int hw = 0;
        int hh = 0;
        if (newSub >= 0 && newSub < n && items[newSub].kind == 3) {
            childKids = items[newSub].children;
            cwd = OverlayPopup.RichWidth(app, childKids);
            chd = OverlayPopup.RichHeight(app, childKids);
            cx = px + pw - app.Scale(4);
            if (cx + cwd > cw - margin) { cx = px - cwd + app.Scale(4); }
            cy = OverlayPopup.RichRowTop(app, items, newSub, py + OverlayPopup.MenuPadV(app))
                - scrollY;
            if (cy + chd > ch - margin) { cy = ch - margin - chd; }
            if (cy < margin) { cy = margin; }
            childOpen = true;
            int occSub2 = subOpen2.Get();
            hadGrand = richSub2 && occSub2 >= 0 && occSub2 < childKids.Count
                && childKids[occSub2].kind == 3;
            if (hadGrand) {
                List<MenuItem> hk = childKids[occSub2].children;
                hw = OverlayPopup.RichWidth(app, hk);
                hh = OverlayPopup.RichHeight(app, hk);
                hx = cx + cwd - app.Scale(4);
                if (hx + hw > cw - margin) { hx = cx - hw + app.Scale(4); }
                hy = OverlayPopup.RichRowTop(app, childKids, occSub2,
                    cy + OverlayPopup.MenuPadV(app));
                if (hy + hh > ch - margin) { hy = ch - margin - hh; }
                if (hy < margin) { hy = margin; }
            }
            // 无孙面板时 hw=0，PointOccluded 视为无遮挡。
            OverlayPopup.SetOccluders(hx, hy, hw, hh, 0, 0, 0, 0);
            childOver = OverlayPopup.PaintRichPanel(app, childKids, cx, cy, cwd, chd,
                baseId + 128, 0, 0);
            OverlayPopup.SetOccluders(0, 0, 0, 0, 0, 0, 0, 0);
        } else {
            // 子面板没开也要占掉它的 barrier id：覆盖层 AllocId 按
            // 注册顺序发号，子面板开/关增减一个命中区会把其后注册
            // 的滚动条 id 顶得漂移，拖动中 IsPressed 突然失配中断
            // 拖动，等 id 回来又按 jump-to-mouse 瞬移——来回跳跃。
            app.focus.AllocId();
        }

        // ---- 孙级面板（richSub2 门控）：子面板里的
        // kind=3 行悬停再展开一层。开合状态由宿主跨帧持有；子面板
        // 没开或换了父行就地关闭。关闭时同样烧掉一个 barrier id，
        // 保持覆盖层 id 流稳定（理由同子面板）。----
        int grandOver = 0 - 1;
        int gx = 0;
        int gy = 0;
        int gw = 0;
        int gh = 0;
        bool grandOpen = false;
        List<MenuItem> grandKids = null;
        if (richSub2) {
            int curSub2 = subOpen2.Get();
            bool overChildSub = childOpen && childOver >= 0
                && childOver < childKids.Count && childKids[childOver].kind == 3;
            // 当前已开的孙面板矩形（hadGrand + hx/hy/hw/hh）已在
            // 子面板绘制前算好（兼作那次绘制的遮挡）；指针进面板
            // 即保持——与子面板「悬停父项或其子面板都保持」同一条
            // 规则。
            bool overGrand = hadGrand && app.mouseX >= hx
                && app.mouseX < hx + hw && app.mouseY >= hy
                && app.mouseY < hy + hh;

            int newSub2 = curSub2;
            if (!childOpen || newSub != curSub) { newSub2 = 0 - 1; }
            else if (overChildSub) {
                newSub2 = childOver;
                OverlayPopup.subGraceRow2 = 0 - 1;
            } else if (overGrand) {
                newSub2 = curSub2;
                OverlayPopup.subGraceRow2 = 0 - 1;
            } else if (childOver >= 0) {
                // 与子面板同一条宽限规则：从孙父行斜穿子面板
                // 其它行去孙面板的途中不立刻收起孙面板。
                if (curSub2 < 0) { newSub2 = 0 - 1; }
                else if (OverlayPopup.subGraceRow2 == childOver
                         && Window.GetTickMs() - OverlayPopup.subGraceMs2 >= 400) {
                    newSub2 = 0 - 1;
                } else {
                    if (OverlayPopup.subGraceRow2 != childOver) {
                        OverlayPopup.subGraceRow2 = childOver;
                        OverlayPopup.subGraceMs2 = Window.GetTickMs();
                    }
                    newSub2 = curSub2;
                }
            }
            if (newSub2 == 0 - 1) { OverlayPopup.subGraceRow2 = 0 - 1; }
            if (newSub2 != curSub2) {
                subOpen2.Set(newSub2);
                app.RequestRedraw();
            }

            if (childOpen && newSub2 >= 0 && newSub2 < childKids.Count
                && childKids[newSub2].kind == 3) {
                grandKids = childKids[newSub2].children;
                gw = OverlayPopup.RichWidth(app, grandKids);
                gh = OverlayPopup.RichHeight(app, grandKids);
                gx = cx + cwd - app.Scale(4);
                if (gx + gw > cw - margin) { gx = cx - gw + app.Scale(4); }
                gy = OverlayPopup.RichRowTop(app, childKids, newSub2,
                    cy + OverlayPopup.MenuPadV(app));
                if (gy + gh > ch - margin) { gy = ch - margin - gh; }
                if (gy < margin) { gy = margin; }
                grandOver = OverlayPopup.PaintRichPanel(app, grandKids, gx, gy,
                    gw, gh, baseId + 256, 0, 0);
                grandOpen = true;
            } else {
                app.focus.AllocId();
            }
        }

        // 滚动条：画在行之上，命中区在行之后注册，拖动优先于行点击。
        if (maxScroll > 0) {
            Widget.Scrollbar.RenderVerticalScrollIn(app,
                px + pw - app.Scale(10), py, viewH, viewH, fullH, richScroll,
                px, py, pw, viewH);
        }

        // 交互由几何驱动（右键目标不会填充
        // 主点击/按压 id）。叶子项在左键于其行上松开时激活；
        // 在两个面板之外点击（或 Escape）则关闭。菜单
        // 锚定在打开点，因此打开时的右键松开落在
        // 其内部，不会立即自我关闭。
        int kind = app.EventKind();
        int btn = app.window.EventButton();
        bool inMain = app.mouseX >= px && app.mouseX < px + pw
            && app.mouseY >= py && app.mouseY < py + viewH;
        bool inChild = childOpen
            && app.mouseX >= cx && app.mouseX < cx + cwd
            && app.mouseY >= cy && app.mouseY < cy + chd;
        // 滚动条条带上的按下/松开属于滚动交互（拖动中常越出
        // 面板底部）：既不算叶子行激活，也不关闭菜单。
        bool onBar = maxScroll > 0 && app.mouseX >= px + pw - app.Scale(10)
            && app.mouseX < px + pw;

        // 叶子激活只认「本帧首次到达、未被认领」的释放：打开
        // 菜单的那次触发器释放已在同帧被 ClaimClick 认领，若这里
        // 直接读原始事件，会把同一次释放当成行点击（触发器与
        // 首行重叠），菜单开了即选第 0 项。EventKind 在空闲帧
        // 停留不变，ClickFrameCurrent 同时挡住陈旧释放的重放。
        if (kind == 3 && btn == 0 && !onBar && app.ClickFrameCurrent()
            && !app.ClickClaimed()) {
            if (grandOpen && grandOver >= 0 && grandOver < grandKids.Count) {
                MenuItem gcm = grandKids[grandOver];
                if (gcm.kind == 0 && !gcm.disabled) {
                    result.Set(gcm.action);
                    openFlag.Set(false);
                    subOpen.Set(0 - 1);
                    subOpen2.Set(0 - 1);
                    app.ClaimClick();
                    app.RequestRedraw();
                }
            } else if (childOpen && childOver >= 0
                && childOver < items[newSub].children.Count) {
                MenuItem hcm = items[newSub].children[childOver];
                if (hcm.kind == 0 && !hcm.disabled) {
                    result.Set(hcm.action);
                    openFlag.Set(false);
                    subOpen.Set(0 - 1);
                    subOpen2.Set(0 - 1);
                    app.ClaimClick();
                    app.RequestRedraw();
                }
            } else if (overRow >= 0 && overRow < n) {
                MenuItem hm = items[overRow];
                if (hm.kind == 0 && !hm.disabled) {
                    result.Set(hm.action);
                    openFlag.Set(false);
                    subOpen.Set(0 - 1);
                    subOpen2.Set(0 - 1);
                    app.ClaimClick();
                    app.RequestRedraw();
                }
            }
        }
        bool leftEvt = (kind == 2 || kind == 3) && btn == 0;
        // 释放引发的关闭只认本帧首次到达且未被认领的释放：打开
        // 菜单的那次触发器释放（已被认领）落在面板之外，直接读
        // 原始事件会在同帧把刚打开的菜单关掉；EventKind 在空闲
        // 帧停留不变，ClickFrameCurrent 同时挡住陈旧释放重放。
        bool releaseOwned = kind == 2
            || (app.ClickFrameCurrent() && !app.ClickClaimed());
        bool inGrand = grandOpen && app.mouseX >= gx && app.mouseX < gx + gw
            && app.mouseY >= gy && app.mouseY < gy + gh;
        if (leftEvt && releaseOwned && !inMain && !inChild && !inGrand
            && !onBar) {
            app.ClaimClick();
            openFlag.Set(false);
            subOpen.Set(0 - 1);
            subOpen2.Set(0 - 1);
            app.RequestRedraw();
        }
        if (kind == 4 && app.window.EventKeyCode() == 27) {
            openFlag.Set(false);
            subOpen.Set(0 - 1);
            subOpen2.Set(0 - 1);
            app.RequestRedraw();
        }
        // 窗口失焦（事件 9）时关闭：切到别的窗口后菜单不该悬在
        // 非活动窗口上。只认事件、不再逐帧轮询焦点：从未持有
        // 焦点的窗口（后台启动、自动化注入驱动的会话）会被轮询
        // 误判成「刚失焦」，菜单连同其子菜单链开一帧即关——
        // 表观正是「悬停展开子菜单时整条菜单自动消失」。真实
        // 失焦在 Windows 与 X11 都有失焦事件（kind 9）兜底。
        if (kind == 9) {
            openFlag.Set(false);
            subOpen.Set(0 - 1);
            subOpen2.Set(0 - 1);
            app.RequestRedraw();
        }
    }
}
