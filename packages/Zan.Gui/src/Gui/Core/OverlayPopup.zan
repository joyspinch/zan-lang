using Gui.Backend;

namespace Gui;

// Legacy custom paint adapter. Retained popup controls register with OverlayHost;
// this adapter has no menu model, geometry, scrolling or input implementation.
public class OverlayPopup {
    Control host;

    static OverlayPopup Host(Control control) {
        OverlayPopup popup = new OverlayPopup();
        popup.host = control;
        return popup;
    }

    static int FitX(App app, int x, int width) {
        int margin = app.Scale(4);
        int right = app.canvas.Width() - margin - width;
        if (x > right) { x = right; }
        if (x < margin) { x = margin; }
        return x;
    }

    static int FitH(App app, int height) {
        int available = app.canvas.Height() - app.Scale(8);
        if (available < 1) { available = 1; }
        return height > available ? available : height;
    }

    static int FitY(App app, int anchorY, int triggerHeight, int height) {
        int margin = app.Scale(4);
        int gap = app.Scale(4);
        int bottom = app.canvas.Height() - margin;
        int y = anchorY;
        if (y + height > bottom) {
            int above = anchorY - triggerHeight - gap * 2 - height;
            y = above >= margin ? above : bottom - height;
        }
        return y < margin ? margin : y;
    }

    void PaintOverlay(App app) {
        if (host != null) { host.OnPaintOverlay(app); }
    }
}
