using System;
using System.Collections.Generic;
using Gui;
using Gui.Backend;
using Gui.Widget;

namespace Gui;

// Control.Events.zan - 控件事件订阅、交互触发、焦点、冒泡与反射绑定
public partial class Control {
    // --- 可链式事件订阅（BindEvent 的类 C# 替代写法；
    // 一个处理器并返回 THIS，保持设置流程连贯。---
    // 订阅 Click 事件并返回 this。
    Control OnClick(Action a) { BindEvent("Click", a); return this; }
    // 订阅 DoubleClick 事件并返回 this。
    Control OnDoubleClick(Action a) { BindEvent("DoubleClick", a); return this; }
    // 订阅 RightClick 事件并返回 this。
    Control OnRightClick(Action a) { BindEvent("RightClick", a); return this; }
    // 订阅 Change 事件并返回 this。
    Control OnChange(Action a) { BindEvent("Change", a); return this; }
    // 订阅 Enter（指针进入）事件并返回 this。
    Control OnEnter(Action a) { BindEvent("Enter", a); return this; }
    // 订阅 Leave（指针离开）事件并返回 this。
    Control OnLeave(Action a) { BindEvent("Leave", a); return this; }
    // 订阅 MouseDown 事件并返回 this。
    Control OnMouseDown(Action a) { BindEvent("MouseDown", a); return this; }
    // 订阅 MouseUp 事件并返回 this。
    Control OnMouseUp(Action a) { BindEvent("MouseUp", a); return this; }
    // 订阅 Wheel 事件并返回 this。
    Control OnWheel(Action a) { BindEvent("Wheel", a); return this; }
    // 订阅 Focus 事件并返回 this。
    Control OnFocus(Action a) { BindEvent("Focus", a); return this; }
    // 订阅 Blur 事件并返回 this。
    Control OnBlur(Action a) { BindEvent("Blur", a); return this; }
    // 订阅 KeyDown 事件并返回 this。
    Control OnKeyDown(Action a) { BindEvent("KeyDown", a); return this; }
    // 订阅 KeyUp 事件并返回 this。
    Control OnKeyUp(Action a) { BindEvent("KeyUp", a); return this; }
    // 订阅 LongPress 事件并返回 this。
    Control OnLongPress(Action a) { BindEvent("LongPress", a); return this; }
    // 订阅 Swipe 事件并返回 this。
    Control OnSwipe(Action a) { BindEvent("Swipe", a); return this; }
    // 订阅 Drag 事件并返回 this。
    Control OnDrag(Action a) { BindEvent("Drag", a); return this; }
    // 订阅 Drop 事件并返回 this。
    Control OnDrop(Action a) { BindEvent("Drop", a); return this; }
    // 订阅生命周期事件 Resize（解析尺寸变化时触发）并返回 this。
    Control OnResize(Action a) { Resize.Add(a); return this; }
    // 订阅生命周期事件 Show（可见性翻转为可见时触发）并返回 this。
    Control OnShow(Action a) { Show.Add(a); return this; }
    // 订阅生命周期事件 Hide（可见性翻转为隐藏时触发）并返回 this。
    Control OnHide(Action a) { Hide.Add(a); return this; }

    // --- 平行 sender 通道（S = Sender）。每个方法与同名 On* 一一
    // 对应，区别仅在处理器多收一个参数：触发事件的控件。编译器
    // 按名称解析调用（无重载），因此这是平行方法族而非重载；
    // 旧 On* 与 += 通道不受影响，两通道可混用，先无参后带 sender。---
    // 订阅 Click 事件（处理器收到本控件）并返回 this。
    Control OnClickS(ControlEvent h) { BindEventS("Click", h); return this; }
    // 订阅 DoubleClick 事件（处理器收到本控件）并返回 this。
    Control OnDoubleClickS(ControlEvent h) { BindEventS("DoubleClick", h); return this; }
    // 订阅 RightClick 事件（处理器收到本控件）并返回 this。
    Control OnRightClickS(ControlEvent h) { BindEventS("RightClick", h); return this; }
    // 订阅 Change 事件（处理器收到本控件）并返回 this。
    Control OnChangeS(ControlEvent h) { BindEventS("Change", h); return this; }
    // 订阅 Enter（指针进入）事件（处理器收到本控件）并返回 this。
    Control OnEnterS(ControlEvent h) { BindEventS("Enter", h); return this; }
    // 订阅 Leave（指针离开）事件（处理器收到本控件）并返回 this。
    Control OnLeaveS(ControlEvent h) { BindEventS("Leave", h); return this; }
    // 订阅 MouseDown 事件（处理器收到本控件）并返回 this。
    Control OnMouseDownS(ControlEvent h) { BindEventS("MouseDown", h); return this; }
    // 订阅 MouseUp 事件（处理器收到本控件）并返回 this。
    Control OnMouseUpS(ControlEvent h) { BindEventS("MouseUp", h); return this; }
    // 订阅 Wheel 事件（处理器收到本控件）并返回 this。
    Control OnWheelS(ControlEvent h) { BindEventS("Wheel", h); return this; }
    // 订阅 Focus 事件（处理器收到本控件）并返回 this。
    Control OnFocusS(ControlEvent h) { BindEventS("Focus", h); return this; }
    // 订阅 Blur 事件（处理器收到本控件）并返回 this。
    Control OnBlurS(ControlEvent h) { BindEventS("Blur", h); return this; }
    // 订阅 KeyDown 事件（处理器收到本控件）并返回 this。
    Control OnKeyDownS(ControlEvent h) { BindEventS("KeyDown", h); return this; }
    // 订阅 KeyUp 事件（处理器收到本控件）并返回 this。
    Control OnKeyUpS(ControlEvent h) { BindEventS("KeyUp", h); return this; }
    // 订阅 LongPress 事件（处理器收到本控件）并返回 this。
    Control OnLongPressS(ControlEvent h) { BindEventS("LongPress", h); return this; }
    // 订阅 Swipe 事件（处理器收到本控件）并返回 this。
    Control OnSwipeS(ControlEvent h) { BindEventS("Swipe", h); return this; }
    // 订阅 Drag 事件（处理器收到本控件）并返回 this。
    Control OnDragS(ControlEvent h) { BindEventS("Drag", h); return this; }
    // 订阅 Drop 事件（处理器收到本控件）并返回 this。
    Control OnDropS(ControlEvent h) { BindEventS("Drop", h); return this; }
    // 订阅生命周期事件 Resize（处理器收到本控件）并返回 this。
    Control OnResizeS(ControlEvent h) { Resize.AddS(h); return this; }
    // 订阅生命周期事件 Show（处理器收到本控件）并返回 this。
    Control OnShowS(ControlEvent h) { Show.AddS(h); return this; }
    // 订阅生命周期事件 Hide（处理器收到本控件）并返回 this。
    Control OnHideS(ControlEvent h) { Hide.AddS(h); return this; }

    // 当控件自身被禁用或位于被禁用的祖先之下时为 true，
    // 控件正是据此解析其 `:disabled` 样式及其
    // （缺失的）交互——禁用一个组即禁用了它的命令，
    // 而无需逐个修改。
    bool IsDisabled() {
        if (Disabled.Get()) { return true; }
        if (parent != null) { return parent.IsDisabled(); }
        return false;
    }

    // 此控件通用事件包的稳定 id（见 FireCommon）。
    int CommonId() {
        if (commonId == 0) { commonId = Gui.WidgetId.Next(); }
        return commonId;
    }

    // 控件的交互命中或焦点标识（自持 wid 的组件如 Input/TextArea 覆写返回 wid）
    public virtual int WidgetId() {
        return this.CommonId();
    }

    // 判断控件当前是否在宿主应用中持有输入焦点
    public virtual bool HasFocus(App app) {
        if (app == null || app.focus == null) { return false; }
        int id = this.WidgetId();
        if (id > 0 && app.focus.IsFocused(id)) { return true; }
        if (commonId > 0 && app.focus.IsFocused(commonId)) { return true; }
        return false;
    }

    // 把已解析的矩形注册为命中区域并触发通用事件包，
    // 使指针/焦点/键盘事件对所有控件生效，而不只是
    // 自行接线 `On` 的那几个。控件自行接线
    // 自己的事件或无人监听时跳过——未使用的容器不能
    // 抢走画在它下面的内容的指针。
    void FireCommon(App app) {
        if (wiresOwnEvents) { return; }
        if (!On.Any()) { return; }
        if (bw <= 0 || bh <= 0) { return; }
        int id = this.CommonId();
        string a11y = this.EffectiveA11yRole("control") + ":" + this.EffectiveA11yLabel(name);
        app.hitTester.RegisterRectL(id, bx, by, bw, bh, 0, a11y);
        On.Fire(app, id, this);
    }

    // 按名称触发已绑定的事件（测试或合成事件调度通道）
    public virtual void TriggerEvent(string evt) {
        if (evt == "Resize") { Resize.Raise(); return; }
        if (evt == "Show") { Show.Raise(); return; }
        if (evt == "Hide") { Hide.Raise(); return; }
        On.FireByName(evt, this);
    }

    // 子控件事件冒泡钩子：子控件的用户切换在自己的 Change 之后经
    // weak parent 反向通知到这里，容器按需覆写。取代「子事件表挂
    // 捕获容器的闭包」的旧接线——那构成 容器→子→事件表→闭包→容器
    // 引用环，ARC 不回收，逐选项泄漏（leakcheck_checkbox_group /
    // radio_group）。默认无操作；evt 目前只有 "Change"。
    public virtual void OnChildEvent(Control child, string evt) {
    }

    // 绑定到 `evt` 的处理器，无则为 ""。供事件检查器使用。
    string GetHandler(string evt) {
        for (int i = 0; i < events.Count; i = i + 1) {
            if (events[i].key == evt) { return events[i].val; }
        }
        return "";
    }

    // 把处理器标识符绑定（或重新绑定）到 `evt`。
    void SetHandler(string evt, string h) {
        ControlExtra e = this.EnsureExtra();
        if (e.events == null) { e.events = new List<EventBinding>(); }
        for (int i = 0; i < e.events.Count; i = i + 1) {
            if (e.events[i].key == evt) { e.events[i].val = h; return; }
        }
        e.events.Add(new EventBinding(evt, h));
    }


    // 本帧此控件是否触发了它的主动作（按钮被按下、菜单项被选中）。
    // 这是 Click 一类事件的*轮询*版本：每帧重建控件树的宿主留不住
    // 处理器，而按一排按钮各挂一个处理器也说明不了任何事情——它们
    // 只想在排完版之后问一句「刚才谁被按了」。默认 false；有主动作
    // 的控件覆写它，宿主便可以遍历整棵子树一次问遍所有控件。
    public virtual bool Fired() {
        return false;
    }

    // 子树里本帧触发了主动作的第一个控件（深度优先，绘制顺序），
    // 没有则为 null。
    Control FiredIn() {
        if (this.Fired()) { return this; }
        for (int i = 0; i < children.Count; i = i + 1) {
            Control hit = children[i].FiredIn();
            if (hit != null) { return hit; }
        }
        return null;
    }

    // 所有控件暴露的通用事件名（指针/焦点/键盘/
    // 触摸/拖拽/生命周期），按检查器顺序。控件将其前置到自己的
    // 语义事件之前（在 Events() 中）。
    static List<string> CommonEvents() {
        List<string> e = new List<string>{
            "Click",
            "DoubleClick",
            "RightClick",
            "RightDoubleClick",
            "MouseDown",
            "MouseUp",
            "Enter",
            "Leave",
            "Move",
            "Wheel",
            "Focus",
            "Blur",
            "KeyDown",
            "KeyUp",
            "KeyPress",
            "Tap",
            "LongPress",
            "Swipe",
            "DragStart",
            "Drag",
            "Drop",
            "Resize",
            "Show",
            "Hide" };
        return e;
    }

    // 供设计器事件检查器使用的声明事件名。基类返回
    // 通用事件包；控件重写以追加自己的语义事件（并
    // 仍包含 CommonEvents()）。
    public virtual List<string> Events() {
        return Control.CommonEvents();
    }

    // 把解析出的 Action 订阅到指定事件。基类把通用事件包
    // （Click/Enter/.../Drop）映射到 `On`；控件重写以把
    // 自己的语义事件（Change/Submit/RowClick/...）路由到正确的
    // UiEvent 字段，然后为通用事件集调用基类。JSON
    // 加载器用它附加经注册表解析的 `on<Event>` 处理器。
    public virtual void BindEvent(string evt, Action a) {
        if (evt == "Resize") { Resize.Add(a); return; }
        if (evt == "Show") { Show.Add(a); return; }
        if (evt == "Hide") { Hide.Add(a); return; }
        On.AddByName(evt, a);
    }

    // <see cref="BindEvent"/> 的 sender 通道：处理器在触发时收到
    // 本控件。基类按事件名路由到 <see cref="WidgetEvents.AddByNameS"/>；
    // 为 <see cref="BindEvent"/> 特化过事件（如 Change/Toggle）的
    // 控件同样重写本方法，把对应名字接进自己的 UiEvent。
    public virtual void BindEventS(string evt, ControlEvent h) {
        if (evt == "Resize") { Resize.AddS(h); return; }
        if (evt == "Show") { Show.AddS(h); return; }
        if (evt == "Hide") { Hide.AddS(h); return; }
        On.AddByNameS(evt, h);
    }

    // `key` 对应的规格；若此控件未发布该绑定
    // 属性则返回 null。
    public PropSpec PropOf(string key) {
        List<PropSpec> ps = this.Props();
        for (int i = 0; i < ps.Count; i = i + 1) {
            if (ps[i].Answers(key) && ps[i].IsBound()) { return ps[i]; }
        }
        return null;
    }

    // 为无法用字段表达的属性提供的挂钩——逗号连接的条目列表、
    // 或多个字段派生的值。有此类属性的控件重写这一对方法；
}
