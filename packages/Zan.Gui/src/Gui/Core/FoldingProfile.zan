using System;

namespace Gui;

// 设备屏幕物理折叠形态
public enum FoldState {
    Flat        = 0, // 普通直板屏 / 无折痕
    Folded      = 1, // 单屏合拢态（约 20:9 窄屏，~380vp）
    HalfFolded  = 2, // 半折叠悬停态（笔记本形态）
    Expanded    = 3, // 双屏阔折展开态（约 16:11 宽屏，~760vp）
    TriFold     = 4  // 三折叠完全展开态（华为 Mate XT 模式，~1140vp）
}

// 物理折痕避让区域（铰链位置）
public struct HingeArea {
    public int x;
    public int y;
    public int width;
    public int height;
    public bool isVertical; // true 为垂直折痕，false 为水平折痕

    public HingeArea(int x0, int y0, int w0, int h0, bool isVert) {
        x = x0;
        y = y0;
        width = w0;
        height = h0;
        isVertical = isVert;
    }

    public bool IsEmpty() {
        return width <= 0 || height <= 0;
    }
}
