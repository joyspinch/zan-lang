using System;
namespace Gui;

// App owns the ticket; the ticket borrows its App and business owner.
public class AppLoopRegistration {
    public weak App host;
    public weak AppLoopOwner owner;
    public AppLoopParticipant participant;
    public bool active;
    public int generation;

    void Retire() {
        active = false;
        generation = generation + 1;
        participant = null;
    }

    public void Invalidate() {
        if (!active) { return; }
        Retire();
        App app = host;
        if (app != null) { app.WakeLoopParticipants(); }
    }

    public void Reschedule() {
        App app = host;
        if (active && app != null) { app.WakeLoopParticipants(); }
    }
}
