using System;
using System.Threading;
namespace Gui;
public class MenuItem {
    int kind;
    string label;
    string icon;
    string shortcut;
    string key;
    int action;
    bool disabled;
    bool danger;
    bool selected;
    int swatch;
    int swatch2;
    List<MenuItem> children;
    static MenuItem Item(string label, string icon, int action) {
        MenuItem m = new MenuItem();
        m.kind = 0;
        m.label = label;
        m.icon = icon;
        m.shortcut = "";
        m.key = "";
        m.action = action;
        m.disabled = false;
        m.danger = false;
        m.children = new List<MenuItem>();
        return m;
    }
    static MenuItem SwatchItem(string label, string icon, int action,
                               int c0, int c1) {
        MenuItem m = MenuItem.Item(label, icon, action);
        m.swatch = c0;
        m.swatch2 = c1;
        return m;
    }
    static MenuItem Shortcut(string label, string icon, string sc, int action) {
        MenuItem m = MenuItem.Item(label, icon, action);
        m.shortcut = sc;
        return m;
    }
    static MenuItem Disabled(string label, string icon, int action) {
        MenuItem m = MenuItem.Item(label, icon, action);
        m.disabled = true;
        return m;
    }
    static MenuItem Danger(string label, string icon, int action) {
        MenuItem m = MenuItem.Item(label, icon, action);
        m.danger = true;
        return m;
    }
    static MenuItem DangerShortcut(string label, string icon, string sc,
                                   int action) {
        MenuItem m = MenuItem.Danger(label, icon, action);
        m.shortcut = sc;
        return m;
    }
    static MenuItem Separator() {
        MenuItem m = new MenuItem();
        m.kind = 1;
        m.label = "";
        m.icon = "";
        m.shortcut = "";
        m.key = "";
        m.action = 0 - 1;
        m.disabled = false;
        m.danger = false;
        m.children = new List<MenuItem>();
        return m;
    }
    static MenuItem Header(string label) {
        MenuItem m = new MenuItem();
        m.kind = 2;
        m.label = label;
        m.icon = "";
        m.shortcut = "";
        m.key = "";
        m.action = 0 - 1;
        m.disabled = false;
        m.danger = false;
        m.children = new List<MenuItem>();
        return m;
    }
    static MenuItem Submenu(string label, string icon, List<MenuItem> children) {
        MenuItem m = new MenuItem();
        m.kind = 3;
        m.label = label;
        m.icon = icon;
        m.shortcut = "";
        m.key = "";
        m.action = 0 - 1;
        m.disabled = false;
        m.danger = false;
        m.children = children != null ? children : new List<MenuItem>();
        return m;
    }
}
