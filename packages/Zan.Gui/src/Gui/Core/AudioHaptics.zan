using System;
using Gui;

namespace Gui.Core;

// 视听触三维统一交互反馈门面（AudioHaptics）：
// 在移动端和桌面端将「微秒级触觉马达振动」与「低延迟即时音效」联合调度，
// 形成媲美 Apple Taptic Engine 与鸿蒙超级触感的全感官交互体验。
public class AudioHaptics {
    public static bool SoundEnabled = true;
    public static bool HapticEnabled = true;

    // 1. 轻触反馈（按键微触、键盘打字）：轻度微振 + 微咔哒声
    public static void Tap() {
        if (HapticEnabled) {
            DeviceFeedback.Light();
        }
        if (SoundEnabled) {
            SoundPool.PlayTick();
        }
    }

    // 2. 选择器步进反馈（滚动轮滑过、选项吸附）：微步进微振 + 弱音效
    public static void Selection() {
        if (HapticEnabled) {
            DeviceFeedback.Selection();
        }
        if (SoundEnabled) {
            SoundPool.Play("tick", 0.3);
        }
    }

    // 3. 成功反馈（操作完成、提交成功、支付达成）：双跳振 + 清脆和声鸣音
    public static void Success() {
        if (HapticEnabled) {
            DeviceFeedback.Success();
        }
        if (SoundEnabled) {
            SoundPool.PlayChime();
        }
    }

    // 4. 警告反馈（输入超限、电量低提示）：中度阻尼提示振
    public static void Warning() {
        if (HapticEnabled) {
            DeviceFeedback.Warning();
        }
    }

    // 5. 错误反馈（操作被拒、校验失败）：三连阻尼震颤
    public static void Error() {
        if (HapticEnabled) {
            DeviceFeedback.Error();
        }
    }
}
