using Gui;
using Gui.Widget;
using Gui.Component;

namespace Gui;

// 标准保留控件的显式注册入口。只有调用 Install 的宿主才把全部标准控件
// 拉入编译图；手写 new Button() 等入口仍只编译自身引用的控件。
// kind 与构造器在同一处声明，避免名单与构造分支漂移。
public class ControlBootstrap {
    static bool installed;

    // 幂等安装。泛型 DataGrid/Transfer 与 ChartHost 由各自包的 bootstrap
    // 注册；HTML 标签别名仍由声明层解析，不跨包引入实现。
    static void Install() {
        if (installed) { return; }
        installed = true;
        ControlFactory.Register("Panel", (string k) => new Panel());
        ControlFactory.Register("Label", (string k) => new Label());
        ControlFactory.Register("Button", (string k) => new Button());
        ControlFactory.Register("Progress", (string k) => new Progress());
        ControlFactory.Register("Input", (string k) => new Input());
        ControlFactory.Register("TextArea", (string k) => new TextArea());
        ControlFactory.Register("Typography", (string k) => new Typography());
        ControlFactory.Register("Element", (string k) => new Element());
        ControlFactory.Register("InputOtp", (string k) => new InputOtp());
        ControlFactory.Register("InputNumber", (string k) => new InputNumber());
        ControlFactory.Register("Switch", (string k) => new Switch());
        ControlFactory.Register("Checkbox", (string k) => new Checkbox());
        ControlFactory.Register("Radio", (string k) => new Radio());
        ControlFactory.Register("RadioButton", (string k) => new Radio(null, 0, "", true));
        ControlFactory.Register("Slider", (string k) => new Slider());
        ControlFactory.Register("SelectBox", (string k) => new SelectBox());
        ControlFactory.Register("Rate", (string k) => new Rate());
        ControlFactory.Register("Pagination", (string k) => new Pagination());
        ControlFactory.Register("Tabs", (string k) => new Tabs());
        ControlFactory.Register("DatePicker", (string k) => new DatePicker());
        ControlFactory.Register("ColorPicker", (string k) => new ColorPicker());
        ControlFactory.Register("VirtualList", (string k) => new VirtualList());
        ControlFactory.Register("SplitPanel", (string k) => new SplitPanel());
        ControlFactory.Register("ToolStrip", (string k) => new ToolStrip());
        ControlFactory.Register("StatusBar", (string k) => new StatusBar());
        ControlFactory.Register("AlertBox", (string k) => new AlertBox());
        ControlFactory.Register("FloatButton", (string k) => new FloatButton());
        ControlFactory.Register("RadioGroup", (string k) => new RadioGroup());
        ControlFactory.Register("CheckboxGroup", (string k) => new CheckboxGroup());
        ControlFactory.Register("ScrollColumn", (string k) => new ScrollColumn());
        ControlFactory.Register("Divider", (string k) => new Divider());
        ControlFactory.Register("Flex", (string k) => new Flex());
        ControlFactory.Register("Grid", (string k) => new Grid());
        ControlFactory.Register("GridItem", (string k) => new GridItem());
        ControlFactory.Register("Image", (string k) => new Image());
        ControlFactory.Register("Watermark", (string k) => new Watermark());
        ControlFactory.Register("Countdown", (string k) => new Countdown());
        ControlFactory.Register("QrCode", (string k) => new QrCode());
        ControlFactory.Register("Upload", (string k) => new Upload());
        ControlFactory.Register("NumberAnimation", (string k) => new NumberAnimation());
        ControlFactory.Register("Marquee", (string k) => new Marquee());
        ControlFactory.Register("DynamicTags", (string k) => new DynamicTags());
        ControlFactory.Register("Calendar", (string k) => new Calendar());
        ControlFactory.Register("Card", (string k) => new Card());
        ControlFactory.Register("Tag", (string k) => new Tag());
        ControlFactory.Register("Badge", (string k) => new Badge());
        ControlFactory.Register("Avatar", (string k) => new Avatar());
        ControlFactory.Register("Statistic", (string k) => new Statistic());
        ControlFactory.Register("Timeline", (string k) => new Timeline());
        ControlFactory.Register("TreeView", (string k) => new TreeView());
        ControlFactory.Register("Collapse", (string k) => new Collapse());
        ControlFactory.Register("Empty", (string k) => new Empty());
        ControlFactory.Register("Result", (string k) => new Result());
        ControlFactory.Register("Skeleton", (string k) => new Skeleton());
        ControlFactory.Register("Spin", (string k) => new Spin());
        ControlFactory.Register("Steps", (string k) => new Steps());
        ControlFactory.Register("Breadcrumb", (string k) => new Breadcrumb());
        ControlFactory.Register("PageHeader", (string k) => new PageHeader());
        ControlFactory.Register("ListView", (string k) => new ListView<string>());
        ControlFactory.Register("Dropdown", (string k) => new Dropdown<string>());
        ControlFactory.Register("Carousel", (string k) => new Carousel());
        ControlFactory.Register("Row", (string k) => new Row());
        ControlFactory.Register("Spacer", (string k) => new Spacer());
        ControlFactory.Register("FormGroup", (string k) => new FormGroup());
        ControlFactory.Register("FormItem", (string k) => new FormItem());
        ControlFactory.Register("Modal", (string k) => new Modal());
        ControlFactory.Register("Drawer", (string k) => new Drawer());
        ControlFactory.Register("Ribbon", (string k) => new Ribbon());
        ControlFactory.Register("BandGrid", (string k) => new BandGrid());
        ControlFactory.Register("GraphView", (string k) => new GraphView());
    }
}
