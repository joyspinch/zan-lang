using System;
using System.Json;
using System.Collections.Generic;
using Gui;
using Gui.Widget;
using Gui.Designer;

namespace Gui;

// 用户组件的运行期注册表。编译期展开（GenForm
// ExpandRefs）覆盖设计器/声明式用法；这里是动态一侧：
// 应用不重编译就能按名实例化 components/*.zcomp（WinForms
// UserControl 的动态加载形态）。构建用 FormBuilder.Build，
// 属性应用与设计器预览、生成器展开三者共用同一语义：
// 实例值优先，缺省取声明的 def，落到声明的目标控件上。
class UserComponentRegistry {
    static List<UserComponent> components;

    static void EnsureInit() {
        if (components == null) {
            components = new List<UserComponent>();
        }
    }

    // 注册/替换一个组件文档（.zcomp 原文）。
    static void Register(string name, string json) {
        EnsureInit();
        for (int i = 0; i < components.Count; i = i + 1) {
            if (components[i].name == name) { components[i].json = json; return; }
        }
        components.Add(new UserComponent(name, json));
    }

    // 批量装载（与 Designer.SetUserComponents 同源）。
    static void SetAll(List<UserComponent> comps) {
        EnsureInit();
        components.Clear();
        for (int i = 0; i < comps.Count; i = i + 1) {
            components.Add(comps[i]);
        }
    }

    // 组件名对应的文档原文；未注册返回 ""。
    static string JsonOf(string name) {
        EnsureInit();
        for (int i = 0; i < components.Count; i = i + 1) {
            if (components[i].name == name) { return components[i].json; }
        }
        return "";
    }

    // 实例化：按组件文档建整棵控件树并应用声明
    // 属性（无实例值时用默认值）。未注册/解析
    // 失败返回 null。instanceProps 键 = 声明的 key，可为 null。
    static Control Build(string name, JsonValue instanceProps) {
        string doc = JsonOf(name);
        if (doc == "") { return null; }
        JsonValue root = JsonValue.ParseLenient(doc);
        if (root == null) { return null; }
        Control ctl = FormBuilder.Build(root);
        ApplyProps(ctl, root, instanceProps);
        return ctl;
    }

    static Control Build(string name) {
        return Build(name, null);
    }

    // 属性应用：遍历组件文档根的 "props" 声明，
    // 实例值优先，缺省取 def，SetProp 到目标控件
    // （按组件文档里的原始名查找）。与设计器预览
    // 同用此入口。
    static void ApplyProps(Control root, JsonValue compRoot,
                           JsonValue instanceProps) {
        JsonValue decls = compRoot.Get("props");
        if (decls == null || !decls.IsArray()) { return; }
        for (int i = 0; i < decls.Count(); i = i + 1) {
            JsonValue dd = decls.At(i);
            if (dd == null || !dd.IsObject()) { continue; }
            string target = dd.Str("target", "");
            if (target == "") { continue; }
            string def = dd.Str("def", "");
            string val = instanceProps != null && instanceProps.IsObject()
                ? instanceProps.Str(dd.Str("key", ""), def) : def;
            if (val == "") { continue; }
            Control t = root.Find(target);
            if (t != null) { t.SetProp(dd.Str("prop", "text"), val); }
        }
    }
}
