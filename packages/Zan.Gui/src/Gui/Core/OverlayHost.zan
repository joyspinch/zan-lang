using System;
using Gui;

namespace Gui;

// 同一 App 的单个活动弹层；绘制、命中与遮挡共用同一份登记。
public class OverlayHost {
    private Control activePopup;
    private weak Control activeAnchor;
    private weak App ownerApp;
    private bool anchored;
    private bool positioned;
    private int pointX;
    private int pointY;
    private int revision;

    public OverlayHost() {
    }

    private bool VisibleTree(Control control) {
        if (control == null || control.bw <= 0 || control.bh <= 0) { return false; }
        Control node = control;
        while (node != null) {
            if (!node.StyleVisible()) { return false; }
            node = node.parent;
        }
        return true;
    }

    public bool HasActive() {
        return ownerApp != null && this.VisibleTree(activePopup)
            && (!anchored || this.VisibleTree(activeAnchor));
    }

    public bool IsAnchorActive(Control anchor) {
        return this.HasActive() && activeAnchor == anchor;
    }

    public Control ActiveRoot() {
        return this.HasActive() ? activePopup : null;
    }

    public Control HitTest(int x, int y, int pointerType) {
        if (!this.HasActive()) { return null; }
        return activePopup.HitTest(x, y, pointerType);
    }

    private void ArrangePopup(App app) {
        if (activePopup == null) { return; }
        if (positioned) {
            int margin = app.Scale(Space.XS);
            int availableW = app.canvas.Width() - margin * 2;
            int availableH = app.canvas.Height() - margin * 2;
            if (availableW < 1) { availableW = 1; }
            if (availableH < 1) { availableH = 1; }
            int width = activePopup.prefW;
            int height = activePopup.prefH;
            if (width > availableW) { width = availableW; }
            if (height > availableH) { height = availableH; }
            if (width < 1) { width = 1; }
            if (height < 1) { height = 1; }
            int x = pointX;
            int y = pointY;
            if (x + width > app.canvas.Width() - margin) { x = app.canvas.Width() - margin - width; }
            if (y + height > app.canvas.Height() - margin) { y = app.canvas.Height() - margin - height; }
            if (x < margin) { x = margin; }
            if (y < margin) { y = margin; }
            activePopup.Arrange(x, y, width, height);
            return;
        }
        if (activeAnchor == null) { return; }
        activePopup.MeasureTree(app);
        int popW = activePopup.prefW > 0 ? activePopup.prefW : activeAnchor.bw;
        int popH = activePopup.prefH > 0 ? activePopup.prefH : app.Scale(200);
        int popX = OverlayPopup.FitX(app, activeAnchor.bx, popW);
        int popY = OverlayPopup.FitY(app, activeAnchor.by + activeAnchor.bh + app.Scale(4), activeAnchor.bh, popH);
        activePopup.Arrange(popX, popY, popW, popH);
    }

    public void Show(App app, Control anchor, Control popup) {
        this.ShowCore(app, anchor, popup, false, 0, 0);
    }

    public void ShowAt(App app, Control popup, int x, int y) {
        this.ShowCore(app, null, popup, true, x, y);
    }

    private void ShowCore(App app, Control anchor, Control popup, bool atPoint, int x, int y) {
        if (app == null || popup == null) { return; }
        if (activePopup != null && (activePopup != popup || activeAnchor != anchor || ownerApp != app)) {
            bool sameAnchor = activeAnchor == anchor && ownerApp == app;
            int before = revision;
            this.CloseActive(!sameAnchor);
            // A close/cancel callback that opened a new popup owns the host now.
            if (revision != before + 1) { return; }
        }
        revision = revision + 1;
        popup.EnsureExtra().popupEpoch = popup.EnsureExtra().popupEpoch + 1;
        if (anchor != null && anchor != popup) {
            anchor.EnsureExtra().popupEpoch = anchor.EnsureExtra().popupEpoch + 1;
        }
        ownerApp = app;
        activePopup = popup;
        activeAnchor = anchor;
        anchored = anchor != null;
        positioned = atPoint;
        pointX = x;
        pointY = y;
        this.ArrangePopup(app);
        app.RequestRedraw();
    }

    public void Hide(Control popup) {
        if (popup != null && popup == activePopup) { this.Dismiss(); }
    }

    // Root replacement preserves anchored overlays reachable through input adapters.
    // Point popups have no anchor and keep their explicit caller-owned lifetime.
    internal void RetireAnchorOutside(Control nextRoot, int expectedRevision) {
        if (revision != expectedRevision) { return; }
        Control anchor = activeAnchor;
        if (activePopup == null || !anchored || anchor == null) { return; }
        if (nextRoot == null || !nextRoot.ContainsInputControl(anchor)) {
            this.CloseActive(true);
        }
    }

    internal int RetirementRevision() { return revision; }

    // Only the registration snapshotted before input retirement may be closed.
    internal void RetireAnchorIn(Control retiredRoot, int expectedRevision) {
        if (revision != expectedRevision) { return; }
        Control anchor = activeAnchor;
        if (activePopup == null || !anchored || anchor == null || retiredRoot == null) { return; }
        if (retiredRoot.ContainsInputControl(anchor)) { this.CloseActive(true); }
    }

    public void Dismiss() { this.CloseActive(true); }

    private void CloseActive(bool notifyAnchor) {
        Control anchor = activeAnchor;
        App app = ownerApp;
        Control popup = activePopup;
        bool hadPopup = popup != null;
        int popupEpoch = hadPopup && popup.extra != null ? popup.extra.popupEpoch : 0;
        int anchorEpoch = anchor != null && anchor.extra != null ? anchor.extra.popupEpoch : 0;
        activePopup = null;
        activeAnchor = null;
        ownerApp = null;
        anchored = false;
        positioned = false;
        revision = revision + 1;
        // 先注销再通知：关闭回调允许重入；只释放旧弹层内的输入状态。
        if (hadPopup && app != null) {
            app.ReleaseInputSubtree(popup);
            app.RequestRedraw();
        }
        if (hadPopup && activePopup != popup && popup.extra.popupEpoch == popupEpoch) {
            popup.OnPopupDismissed();
        }
        // Cancellation or popup notification may have reopened the same anchor.
        if (hadPopup && notifyAnchor && anchor != null && anchor != popup && activeAnchor != anchor
                && anchor.extra.popupEpoch == anchorEpoch) {
            anchor.OnPopupDismissed();
        }
    }

    // true 表示本次关闭或遮罩已消费输入，调用方不得继续派发给底层树。
    public bool HandleInput(App app, int kind, int x, int y, int key) {
        if (app == null || ownerApp != app || activePopup == null) { return false; }
        if (!this.HasActive()) {
            this.Dismiss();
            return false;
        }
        if (kind == 9) {
            this.Dismiss();
            return true;
        }
        if (kind == 4 && key == 27) {
            int ticket = revision;
            Control popup = activePopup;
            App popupApp = popup.App;
            App sessionApp = ownerApp;
            bool handled = popup.OnPopupEscape(app);
            // A callback may close/reopen, replace the popup, or move it to another App.
            // The old Escape is consumed but cannot dismiss the callback's new session.
            if (revision != ticket || activePopup != popup || ownerApp != sessionApp
                    || sessionApp != app || popup.App != popupApp || app.overlayHost != this) {
                return true;
            }
            if (!handled) { this.Dismiss(); }
            return true;
        }
        if (kind == 2 && this.HitTest(x, y, app.GetPointerDeviceType()) == null) {
            Control anchor = activeAnchor;
            if (anchor == null || anchor.DismissOnOutsideClick()) { this.Dismiss(); }
            return true;
        }
        return false;
    }

    public void Update(App app) {
        if (app == null || ownerApp != app || activePopup == null) { return; }
        int kind = app.EventKind();
        int key = app.window != null ? app.window.EventKeyCode() : 0;
        if (this.HandleInput(app, kind, app.mouseX, app.mouseY, key)) {
            if (kind == 4) { app.ClaimKey(); }
            if (kind == 2) { app.ClaimClick(); }
            return;
        }
        // 即时表面的既有释放点击也走相同关闭状态；不另存一套事件仲裁。
        if (!this.HasActive() || !app.ClickAvailable()) { return; }
        Control anchor = activeAnchor;
        if (anchor != null && !anchor.DismissOnOutsideClick()) { return; }
        bool inAnchor = anchor != null && anchor.ContainsPoint(app.mouseX, app.mouseY, app.GetPointerDeviceType());
        if (!inAnchor && this.HitTest(app.mouseX, app.mouseY, app.GetPointerDeviceType()) == null) {
            this.Dismiss();
            app.ClaimClick();
        }
    }

    public void RenderAll(App app) {
        if (app == null || ownerApp != app || activePopup == null) { return; }
        // Point popups are already laid out; paint must not replay opening input.
        if (!positioned) { this.Update(app); }
        else if (!this.HasActive()) { this.Dismiss(); }
        if (!this.HasActive()) { return; }
        if (!positioned) { this.ArrangePopup(app); }
        if (!this.HasActive()) { this.Dismiss(); return; }
        Control popup = activePopup;
        app.BlockHitsBelow();
        app.BlockHitsRect(popup.bx, popup.by, popup.bw, popup.bh);
        popup.RenderTree(app);
    }

    public static void ShowPopup(App app, Control anchor, Control popup) {
        if (app == null) { app = App.FrameApp(); }
        if (app != null && app.overlayHost != null) {
            app.overlayHost.Show(app, anchor, popup);
        }
    }

    public static void DismissPopup() {
        App app = App.FrameApp();
        if (app != null && app.overlayHost != null) {
            app.overlayHost.Dismiss();
        }
    }

    public static void DismissPopupFor(App app) {
        if (app == null) { app = App.FrameApp(); }
        if (app != null && app.overlayHost != null) {
            app.overlayHost.Dismiss();
        }
    }

    public static bool IsActiveAnchor(App app, Control anchor) {
        if (app == null) { app = App.FrameApp(); }
        if (app != null && app.overlayHost != null) {
            return app.overlayHost.IsAnchorActive(anchor);
        }
        return false;
    }
}
