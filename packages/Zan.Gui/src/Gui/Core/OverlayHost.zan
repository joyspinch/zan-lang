using System;
using System.Collections.Generic;
using Gui;

namespace Gui;

// OverlayHost.zan - 统一浮层与弹窗宿主（消灭各组件手搓弹层与事件阻断）
// 所有下拉列表、日期卡片、取色板、右键菜单统一作为保留组件挂载于此。
// 具备以下核心保证：
// 1. 天然置于视觉最顶层（无需逐控件硬调 z-order）；
// 2. 外部点击自动关闭（DismissOnOutsideClick）；
// 3. 浮层内事件正常捕获，消除 BlockHitsRect 与 ClaimClick；
// 4. 彻底实例绑定于 App 实例，杜绝全局静态多窗口竞态与 ARC 强引用内存泄漏。
public class OverlayHost {
    private List<Control> overlays;
    private Control activePopup;
    private Control activeAnchor;

    public OverlayHost() {
        this.overlays = new List<Control>();
    }

    public bool HasActive() {
        return activePopup != null || (overlays != null && overlays.Count > 0);
    }

    public void Show(App app, Control anchor, Control popup) {
        if (app == null || popup == null) { return; }
        if (overlays == null) { overlays = new List<Control>(); }
        activePopup = popup;
        activeAnchor = anchor;
        if (!overlays.Contains(popup)) {
            overlays.Add(popup);
        }
        if (anchor != null) {
            int popW = popup.prefW > 0 ? popup.prefW : anchor.bw;
            int popH = popup.prefH > 0 ? popup.prefH : app.Scale(200);
            int popX = OverlayPopup.FitX(app, anchor.bx, popW);
            int popY = OverlayPopup.FitY(app, anchor.by + anchor.bh + app.Scale(4), anchor.bh, popH);
            popup.Arrange(popX, popY, popW, popH);
        }
    }

    public void Dismiss() {
        if (activeAnchor != null) {
            activeAnchor.OnPopupDismissed();
        }
        if (activePopup != null && overlays != null) {
            overlays.Remove(activePopup);
        }
        activePopup = null;
        activeAnchor = null;
    }

    public void Update(App app) {
        if (activePopup == null || app == null) { return; }
        if (app.ClickAvailable()) {
            int mx = app.mouseX;
            int my = app.mouseY;
            bool inPopup = mx >= activePopup.bx && mx < activePopup.bx + activePopup.bw
                        && my >= activePopup.by && my < activePopup.by + activePopup.bh;
            bool inAnchor = false;
            if (activeAnchor != null) {
                inAnchor = mx >= activeAnchor.bx && mx < activeAnchor.bx + activeAnchor.bw
                        && my >= activeAnchor.by && my < activeAnchor.by + activeAnchor.bh;
            }
            if (!inPopup && !inAnchor) {
                this.Dismiss();
            }
        }
    }

    public void RenderAll(App app) {
        if (overlays == null || overlays.Count == 0) { return; }
        this.Update(app);
        if (activePopup != null) {
            app.BlockHitsBelow();
            app.BlockHitsRect(activePopup.bx, activePopup.by, activePopup.bw, activePopup.bh);
        }
        for (int i = 0; i < overlays.Count; i = i + 1) {
            Control pop = overlays[i];
            if (pop != null && pop.StyleVisible()) {
                pop.RenderTree(app);
            }
        }
    }

    // ---- 静态转发门面：保证各控件已有调用代码平滑运行，底层完全委托至对应 App 实例 ----

    public static void ShowPopup(App app, Control anchor, Control popup) {
        if (app == null) { app = App.FrameApp(); }
        if (app != null && app.overlayHost != null) {
            app.overlayHost.Show(app, anchor, popup);
        }
    }

    public static void DismissPopup() {
        App app = App.FrameApp();
        if (app != null && app.overlayHost != null) {
            app.overlayHost.Dismiss();
        }
    }

    public static void DismissPopupFor(App app) {
        if (app == null) { app = App.FrameApp(); }
        if (app != null && app.overlayHost != null) {
            app.overlayHost.Dismiss();
        }
    }
}
