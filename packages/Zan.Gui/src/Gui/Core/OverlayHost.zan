using System;
using Gui;
namespace Gui;
public class OverlayHost {
    private Control activePopup;
    private weak Control activeAnchor;
    private weak App ownerApp;
    private bool anchored;
    private bool positioned;
    private int pointX;
    private int pointY;
    private int revision;
    private long openedEventSeq;
    private bool openedEventValid;
    public OverlayHost() {
    }
    private bool VisibleTree(Control control) {
        if (control == null || control.bw <= 0 || control.bh <= 0) { return false; }
        Control node = control;
        while (node != null) {
            if (!node.StyleVisible()) { return false; }
            node = node.parent;
        }
        return true;
    }
    public bool HasActive() {
        return ownerApp != null && this.VisibleTree(activePopup)
            && (!anchored || this.VisibleTree(activeAnchor));
    }
    public bool IsAnchorActive(Control anchor) { return this.HasActive() && activeAnchor == anchor; }
    public Control ActiveRoot() { return this.HasActive() ? activePopup : null; }
    public Control HitTest(int x, int y, int pointerType) {
        if (!this.HasActive()) { return null; }
        return activePopup.HitTest(x, y, pointerType);
    }
    private bool PopupLayoutCurrent(App app, Control popup, Control anchor, int ticket,
    Control root, int generation, long sequence, int phase, int frame) {
        return app.isRunning && ownerApp == app && app.overlayHost == this
        && activePopup == popup && activeAnchor == anchor && revision == ticket
        && app.rootControl == root && app.inputRootGeneration == generation
        && app.window.EventSeq() == sequence && app.inputPreparationTicket == phase
        && app.frameSeq == frame;
    }
    private bool ArrangePopup(App app) {
        if (activePopup == null) { return true; }
        Control popup = activePopup;
        Control anchor = activeAnchor;
        int ticket = revision;
        Control root = app.rootControl;
        int generation = app.inputRootGeneration;
        long sequence = app.window.EventSeq();
        int phase = app.inputPreparationTicket;
        int frame = app.frameSeq;
        popup.InheritApp(app);
        popup.MeasureTree(app);
        if (!this.PopupLayoutCurrent(app, popup, anchor, ticket, root, generation, sequence, phase, frame)) { return false; }
        if (positioned || anchor != null) {
            int margin = app.Scale(Space.XS);
            int contentX = 0;
            int contentY = 0;
            int contentW = 0;
            int contentH = 0;
            app.ContentBounds(out contentX, out contentY, out contentW, out contentH);
            int left = contentX + margin;
            int top = contentY + margin;
            int right = contentX + contentW - margin;
            int bottom = contentY + contentH - margin;
            int availableW = right - left;
            int availableH = bottom - top;
            if (availableW < 1) { availableW = 1; }
            if (availableH < 1) { availableH = 1; }
            int width = popup.prefW;
            int height = popup.prefH;
            if (!positioned && anchor != null) {
                if (width <= 0) { width = anchor.bw; }
                if (height <= 0) { height = app.Scale(200); }
            }
            if (width > availableW) { width = availableW; }
            if (height > availableH) { height = availableH; }
            if (width < 1) { width = 1; }
            if (height < 1) { height = 1; }
            int x = pointX;
            int y = pointY;
            if (!positioned && anchor != null) {
                x = anchor.bx;
                y = anchor.by + anchor.bh + margin;
                if (y + height > bottom) {
                    int above = anchor.by - margin - height;
                    y = above >= top ? above : bottom - height;
                }
            }
            if (x + width > right) { x = right - width; }
            if (y + height > bottom) { y = bottom - height; }
            if (x < left) { x = left; }
            if (y < top) { y = top; }
            popup.Arrange(x, y, width, height);
        }
        return this.PopupLayoutCurrent(app, popup, anchor, ticket, root, generation, sequence, phase, frame);
    }
    public void Show(App app, Control anchor, Control popup) {
        this.ShowCore(app, anchor, popup, false, 0, 0);
    }
    public void ShowAt(App app, Control popup, int x, int y) { this.ShowCore(app, null, popup, true, x, y); }
    public void ShowAtAnchor(App app, Control anchor, Control popup, int x, int y) {
        this.ShowCore(app, anchor, popup, true, x, y);
    }
    private void ShowCore(App app, Control anchor, Control popup, bool atPoint, int x, int y) {
        if (app == null || popup == null) { return; }
        if (activePopup != null && (activePopup != popup || activeAnchor != anchor || ownerApp != app)) {
            bool sameAnchor = activeAnchor == anchor && ownerApp == app;
            int before = revision;
            this.CloseActive(!sameAnchor);
            if (revision != before + 1) { return; }
        }
        revision = revision + 1;
        popup.EnsureExtra().popupEpoch = popup.EnsureExtra().popupEpoch + 1;
        if (anchor != null && anchor != popup) {
            anchor.EnsureExtra().popupEpoch = anchor.EnsureExtra().popupEpoch + 1;
        }
        ownerApp = app;
        activePopup = popup;
        activeAnchor = anchor;
        anchored = anchor != null;
        positioned = atPoint;
        pointX = x;
        pointY = y;
        openedEventValid = app.window != null;
        openedEventSeq = openedEventValid ? app.window.EventSeq() : 0;
        this.ArrangePopup(app);
        app.RequestRedraw();
    }
    public void Hide(Control popup) {
        if (popup != null && popup == activePopup) { this.Dismiss(); }
    }
    internal void RetireAnchorOutside(Control nextRoot, int expectedRevision) {
        if (revision != expectedRevision) { return; }
        Control anchor = activeAnchor;
        if (activePopup == null || !anchored || anchor == null) { return; }
        if (nextRoot == null || !nextRoot.ContainsInputControl(anchor)) { this.CloseActive(true); }
    }
    internal int RetirementRevision() { return revision; }
    internal void RetireAnchorIn(Control retiredRoot, int expectedRevision) {
        if (revision != expectedRevision) { return; }
        Control anchor = activeAnchor;
        if (activePopup == null || !anchored || anchor == null || retiredRoot == null) { return; }
        if (retiredRoot.ContainsInputControl(anchor)) { this.CloseActive(true); }
    }
    public void Dismiss() { this.CloseActive(true); }
    private void CloseActive(bool notifyAnchor) {
        Control anchor = activeAnchor;
        App app = ownerApp;
        Control popup = activePopup;
        bool hadPopup = popup != null;
        int popupEpoch = hadPopup && popup.extra != null ? popup.extra.popupEpoch : 0;
        int anchorEpoch = anchor != null && anchor.extra != null ? anchor.extra.popupEpoch : 0;
        activePopup = null;
        activeAnchor = null;
        ownerApp = null;
        anchored = false;
        positioned = false;
        revision = revision + 1;
        if (hadPopup && app != null) {
            app.ReleaseInputSubtree(popup);
            app.RequestRedraw();
        }
        if (hadPopup && activePopup != popup && popup.extra.popupEpoch == popupEpoch) {
            popup.OnPopupDismissed();
        }
        if (hadPopup && notifyAnchor && anchor != null && anchor != popup && activeAnchor != anchor
                && anchor.extra.popupEpoch == anchorEpoch) {
            anchor.OnPopupDismissed();
        }
    }
    public bool HandleInput(App app, int kind, int x, int y, int key) {
        if (app == null || ownerApp != app || activePopup == null) { return false; }
        if (!this.HasActive()) {
            this.Dismiss();
            return false;
        }
        if (kind == 9) {
            this.Dismiss();
            return true;
        }
        if (kind == 4 && key == 27) {
            int ticket = revision;
            Control popup = activePopup;
            App popupApp = popup.App;
            App sessionApp = ownerApp;
            bool handled = popup.OnPopupEscape(app);
            if (revision != ticket || activePopup != popup || ownerApp != sessionApp
                    || sessionApp != app || popup.App != popupApp || app.overlayHost != this) {
                return true;
            }
            if (!handled) { this.Dismiss(); }
            return true;
        }
        if (kind == 2 && this.HitTest(x, y, app.GetPointerDeviceType()) == null) {
            Control anchor = activeAnchor;
            if (anchor == null || anchor.DismissOnOutsideClick()) { this.Dismiss(); }
            return true;
        }
        return false;
    }
    public void Update(App app) {
        if (app != null && app.snapshotInputSilenceDepth > 0) { return; }
        if (app == null || ownerApp != app || activePopup == null) { return; }
        int kind = app.EventKind();
        int key = app.window != null ? app.window.EventKeyCode() : 0;
        if (this.HandleInput(app, kind, app.mouseX, app.mouseY, key)) {
            if (kind == 4) { app.MarkKeyHandled(); }
            if (kind == 2) { app.MarkClickHandled(); }
            return;
        }
        if (openedEventValid && app.window != null && app.window.EventSeq() == openedEventSeq) { return; }
        if (!this.HasActive() || !app.CanDismissOverlayOnClick()) { return; }
        Control anchor = activeAnchor;
        if (anchor != null && !anchor.DismissOnOutsideClick()) { return; }
        bool inAnchor = anchor != null && anchor.ContainsPoint(app.mouseX, app.mouseY, app.GetPointerDeviceType());
        if (!inAnchor && this.HitTest(app.mouseX, app.mouseY, app.GetPointerDeviceType()) == null) {
            this.Dismiss();
            app.MarkClickHandled();
        }
    }
    internal bool PrepareLayout(App app) {
        if (app == null || ownerApp != app || activePopup == null) { return true; }
        int ticket = revision;
        Control popup = activePopup;
        Control anchor = activeAnchor;
        Control root = app.rootControl;
        int generation = app.inputRootGeneration;
        long sequence = app.window.EventSeq();
        int phase = app.inputPreparationTicket;
        int frame = app.frameSeq;
        if (!this.HasActive()) {
            this.Dismiss();
            return revision == ticket + 1 && activePopup == null;
        }
        if (!this.ArrangePopup(app)) { return false; }
        return this.PopupLayoutCurrent(app, popup, anchor, ticket, root, generation, sequence, phase, frame)
        && popup.PrepareLayoutEvents(app, true)
        && this.PopupLayoutCurrent(app, popup, anchor, ticket, root, generation, sequence, phase, frame);
    }
    public void RenderAll(App app) {
        if (app == null || ownerApp != app || !this.HasActive()) { return; }
        Control popup = activePopup;
        popup.RenderTree(app);
    }
    public static void ShowPopup(App app, Control anchor, Control popup) {
        if (app == null) { app = App.FrameApp(); }
        if (app != null && app.overlayHost != null) { app.overlayHost.Show(app, anchor, popup); }
    }
    public static void DismissPopup() {
        App app = App.FrameApp();
        if (app != null && app.overlayHost != null) { app.overlayHost.Dismiss(); }
    }
    public static void DismissPopupFor(App app) {
        if (app == null) { app = App.FrameApp(); }
        if (app != null && app.overlayHost != null) { app.overlayHost.Dismiss(); }
    }
    public static bool IsActiveAnchor(App app, Control anchor) {
        if (app == null) { app = App.FrameApp(); }
        if (app != null && app.overlayHost != null) { return app.overlayHost.IsAnchorActive(anchor); }
        return false;
    }
}
