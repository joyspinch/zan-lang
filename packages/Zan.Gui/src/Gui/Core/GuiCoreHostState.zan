using System;
using System.Collections.Generic;
using Gui.Backend;
namespace Gui;
internal class AppGuardFrame {
    internal App app;
    internal FrameBody body;
    internal int what;
    internal bool pumpAlive;
    internal AppGuardFrame previous;
}
internal class GuiCoreState {
    internal App frameApp;
    internal AppGuardFrame guardFrame;
    internal LinkScanFn linkScanner;
    internal CloneTreeFn cloneTree;
    internal List<AppHookFn> presentTails;
    internal Element.TipPaintFn tipPainter;
    internal List<NativeLayerReq> nativeLayerTracked;
    internal ChildWindowManager childWindows;
    internal Dict<string, ControlFactoryFn> controlFactoryRegistry;
    internal List<string> controlFactoryKinds;
    internal List<string> controlFactoryCatalogKinds;
    internal List<UserComponent> userComponents;
    internal List<string> userComponentBuilding;

    internal static GuiCoreState Current() {
        object existing = GuiHostState.CoreState();
        if (existing != null) { return (GuiCoreState)existing; }
        GuiCoreState created = new GuiCoreState();
        GuiHostState.SetCoreState(created);
        return created;
    }
}
