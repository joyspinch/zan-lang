namespace Gui;

// Scalar observations keep formatting, raster dumps and file output out of the
// normal presentation graph. Only explicit diagnostic clients install a sink.
public interface AppFrameDiagnostics {
    void FlushLoop(App app, int now);
    void RecordFrame(App app, int beginMs, int preMs, int endMs, bool partial);
    void Snapshot();
    void Partial(int x, int y, int w, int h, int blurMiss);
    void Damage(bool scroll, int x, int y, int w, int h);
    void FxRepair(bool full, int count);
}
