using System;
using System.Collections.Generic;
namespace Gui;
public class WidgetEvents {
    private const int eventCount = 20;
    private UiEvent[] slots;
    public UiEvent DoubleClick { get { return this.Ensure(0); } set { this.Store(0, value); } }
    public UiEvent RightClick { get { return this.Ensure(1); } set { this.Store(1, value); } }
    public UiEvent RightDoubleClick { get { return this.Ensure(2); } set { this.Store(2, value); } }
    public UiEvent MouseDown { get { return this.Ensure(3); } set { this.Store(3, value); } }
    public UiEvent MouseUp { get { return this.Ensure(4); } set { this.Store(4, value); } }
    public UiEvent Enter { get { return this.Ensure(5); } set { this.Store(5, value); } }
    public UiEvent Leave { get { return this.Ensure(6); } set { this.Store(6, value); } }
    public UiEvent Move { get { return this.Ensure(7); } set { this.Store(7, value); } }
    public UiEvent Wheel { get { return this.Ensure(8); } set { this.Store(8, value); } }
    public UiEvent Focus { get { return this.Ensure(9); } set { this.Store(9, value); } }
    public UiEvent Blur { get { return this.Ensure(10); } set { this.Store(10, value); } }
    public UiEvent KeyDown { get { return this.Ensure(11); } set { this.Store(11, value); } }
    public UiEvent KeyUp { get { return this.Ensure(12); } set { this.Store(12, value); } }
    public UiEvent KeyPress { get { return this.Ensure(13); } set { this.Store(13, value); } }
    public UiEvent Tap { get { return this.Ensure(14); } set { this.Store(14, value); } }
    public UiEvent LongPress { get { return this.Ensure(15); } set { this.Store(15, value); } }
    public UiEvent Swipe { get { return this.Ensure(16); } set { this.Store(16, value); } }
    public UiEvent DragStart { get { return this.Ensure(17); } set { this.Store(17, value); } }
    public UiEvent Drag { get { return this.Ensure(18); } set { this.Store(18, value); } }
    public UiEvent Drop { get { return this.Ensure(19); } set { this.Store(19, value); } }
    private static string NameAt(int index) {
        if (index == 0) { return "DoubleClick"; }
        if (index == 1) { return "RightClick"; }
        if (index == 2) { return "RightDoubleClick"; }
        if (index == 3) { return "MouseDown"; }
        if (index == 4) { return "MouseUp"; }
        if (index == 5) { return "Enter"; }
        if (index == 6) { return "Leave"; }
        if (index == 7) { return "Move"; }
        if (index == 8) { return "Wheel"; }
        if (index == 9) { return "Focus"; }
        if (index == 10) { return "Blur"; }
        if (index == 11) { return "KeyDown"; }
        if (index == 12) { return "KeyUp"; }
        if (index == 13) { return "KeyPress"; }
        if (index == 14) { return "Tap"; }
        if (index == 15) { return "LongPress"; }
        if (index == 16) { return "Swipe"; }
        if (index == 17) { return "DragStart"; }
        if (index == 18) { return "Drag"; }
        if (index == 19) { return "Drop"; }
        return "";
    }
    private static int IndexOf(string evt) {
        for (int i = 0; i < eventCount; i = i + 1) {
            if (WidgetEvents.NameAt(i) == evt) { return i; }
        }
        return -1;
    }
    public static List<string> Names() {
        List<string> names = new List<string>();
        for (int i = 0; i < eventCount; i = i + 1) {
            names.Add(WidgetEvents.NameAt(i));
        }
        return names;
    }
    private UiEvent Ensure(int index) {
        if (slots == null) { slots = new UiEvent[eventCount]; }
        if (slots[index] == null) { slots[index] = new UiEvent(); }
        return slots[index];
    }
    private void Store(int index, UiEvent value) {
        if (slots == null) {
            if (value == null) { return; }
            slots = new UiEvent[eventCount];
        }
        slots[index] = value;
    }
    private UiEvent Peek(int index) {
        if (slots == null || index < 0) { return null; }
        return slots[index];
    }
    public bool AddByName(string evt, Action a) {
        int index = WidgetEvents.IndexOf(evt);
        if (index < 0) { return false; }
        UiEvent ev = this.Ensure(index);
        ev.Add(a);
        return true;
    }
    public bool AddByNameS(string evt, ControlEvent a) {
        int index = WidgetEvents.IndexOf(evt);
        if (index < 0) { return false; }
        UiEvent ev = this.Ensure(index);
        ev.AddS(a);
        return true;
    }
    public bool Any() {
        if (slots == null) { return false; }
        for (int i = 0; i < eventCount; i = i + 1) {
            UiEvent ev = slots[i];
            if (ev != null && ev.CountAll() > 0) { return true; }
        }
        return false;
    }
    public bool HasLongPress() { UiEvent ev = this.Peek(15); return ev != null && ev.CountAll() > 0; }
    public void FireByName(string evt, Control sender) {
        UiEvent ev = this.Peek(WidgetEvents.IndexOf(evt));
        if (ev != null) { ev.RaiseS(sender); }
    }
}
