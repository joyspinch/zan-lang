using System;

namespace Gui;

public class WidgetEvents {
    // 指针事件。
    UiEvent Click;
    UiEvent DoubleClick;
    UiEvent RightClick;
    UiEvent RightDoubleClick;
    UiEvent MouseDown;
    UiEvent MouseUp;
    UiEvent Enter;
    UiEvent Leave;
    UiEvent Move;
    UiEvent Wheel;
    // 焦点 + 键盘事件。
    UiEvent Focus;
    UiEvent Blur;
    UiEvent KeyDown;
    UiEvent KeyUp;
    UiEvent KeyPress;
    // 触摸 / 手势事件。
    UiEvent Tap;
    UiEvent LongPress;
    UiEvent Swipe;
    // 拖放（由单指指针合成）。
    UiEvent DragStart;
    UiEvent Drag;
    UiEvent Drop;

    WidgetEvents() {
        Click = new UiEvent();
        DoubleClick = new UiEvent();
        RightClick = new UiEvent();
        RightDoubleClick = new UiEvent();
        MouseDown = new UiEvent();
        MouseUp = new UiEvent();
        Enter = new UiEvent();
        Leave = new UiEvent();
        Move = new UiEvent();
        Wheel = new UiEvent();
        Focus = new UiEvent();
        Blur = new UiEvent();
        KeyDown = new UiEvent();
        KeyUp = new UiEvent();
        KeyPress = new UiEvent();
        Tap = new UiEvent();
        LongPress = new UiEvent();
        Swipe = new UiEvent();
        DragStart = new UiEvent();
        Drag = new UiEvent();
        Drop = new UiEvent();
    }

    // 将 `a` 订阅到名为 `evt` 的通用事件（该名称由
    // Control.CommonEvents 返回，也用于设计器的 `on<Event>` JSON 键）。
    // 未知名称会被忽略，这样引用特定控件
    // 事件（在别处接线）的文档不会在此报错。匹配时返回 true。
    bool AddByName(string evt, Action a) {
        if (evt == "Click") { Click.Add(a); return true; }
        if (evt == "DoubleClick") { DoubleClick.Add(a); return true; }
        if (evt == "RightClick") { RightClick.Add(a); return true; }
        if (evt == "RightDoubleClick") { RightDoubleClick.Add(a); return true; }
        if (evt == "MouseDown") { MouseDown.Add(a); return true; }
        if (evt == "MouseUp") { MouseUp.Add(a); return true; }
        if (evt == "Enter") { Enter.Add(a); return true; }
        if (evt == "Leave") { Leave.Add(a); return true; }
        if (evt == "Move") { Move.Add(a); return true; }
        if (evt == "Wheel") { Wheel.Add(a); return true; }
        if (evt == "Focus") { Focus.Add(a); return true; }
        if (evt == "Blur") { Blur.Add(a); return true; }
        if (evt == "KeyDown") { KeyDown.Add(a); return true; }
        if (evt == "KeyUp") { KeyUp.Add(a); return true; }
        if (evt == "KeyPress") { KeyPress.Add(a); return true; }
        if (evt == "Tap") { Tap.Add(a); return true; }
        if (evt == "LongPress") { LongPress.Add(a); return true; }
        if (evt == "Swipe") { Swipe.Add(a); return true; }
        if (evt == "DragStart") { DragStart.Add(a); return true; }
        if (evt == "Drag") { Drag.Add(a); return true; }
        if (evt == "Drop") { Drop.Add(a); return true; }
        return false;
    }

    // <see cref="AddByName"/> 的 sender 通道形式：按事件名订阅，
    // 触发时处理器收到触发事件的控件（<see cref="Control.BindEventS"/>
    // 的基类路由）。
    bool AddByNameS(string evt, ControlEvent a) {
        if (evt == "Click") { Click.AddS(a); return true; }
        if (evt == "DoubleClick") { DoubleClick.AddS(a); return true; }
        if (evt == "RightClick") { RightClick.AddS(a); return true; }
        if (evt == "RightDoubleClick") { RightDoubleClick.AddS(a); return true; }
        if (evt == "MouseDown") { MouseDown.AddS(a); return true; }
        if (evt == "MouseUp") { MouseUp.AddS(a); return true; }
        if (evt == "Enter") { Enter.AddS(a); return true; }
        if (evt == "Leave") { Leave.AddS(a); return true; }
        if (evt == "Move") { Move.AddS(a); return true; }
        if (evt == "Wheel") { Wheel.AddS(a); return true; }
        if (evt == "Focus") { Focus.AddS(a); return true; }
        if (evt == "Blur") { Blur.AddS(a); return true; }
        if (evt == "KeyDown") { KeyDown.AddS(a); return true; }
        if (evt == "KeyUp") { KeyUp.AddS(a); return true; }
        if (evt == "KeyPress") { KeyPress.AddS(a); return true; }
        if (evt == "Tap") { Tap.AddS(a); return true; }
        if (evt == "LongPress") { LongPress.AddS(a); return true; }
        if (evt == "Swipe") { Swipe.AddS(a); return true; }
        if (evt == "DragStart") { DragStart.AddS(a); return true; }
        if (evt == "Drag") { Drag.AddS(a); return true; }
        if (evt == "Drop") { Drop.AddS(a); return true; }
        return false;
    }

    // 当内置事件中至少有一个监听器时返回 true。允许
    // 容器跳过命中区域的注册（从而不抢占
    // 下方内容的指针），直到有人监听。
    bool Any() {
        if (Click.CountAll() > 0) { return true; }
        if (DoubleClick.CountAll() > 0) { return true; }
        if (RightClick.CountAll() > 0) { return true; }
        if (RightDoubleClick.CountAll() > 0) { return true; }
        if (MouseDown.CountAll() > 0) { return true; }
        if (MouseUp.CountAll() > 0) { return true; }
        if (Enter.CountAll() > 0) { return true; }
        if (Leave.CountAll() > 0) { return true; }
        if (Move.CountAll() > 0) { return true; }
        if (Wheel.CountAll() > 0) { return true; }
        if (Focus.CountAll() > 0) { return true; }
        if (Blur.CountAll() > 0) { return true; }
        if (KeyDown.CountAll() > 0) { return true; }
        if (KeyUp.CountAll() > 0) { return true; }
        if (KeyPress.CountAll() > 0) { return true; }
        if (Tap.CountAll() > 0) { return true; }
        if (LongPress.CountAll() > 0) { return true; }
        if (Swipe.CountAll() > 0) { return true; }
        if (DragStart.CountAll() > 0) { return true; }
        if (Drag.CountAll() > 0) { return true; }
        if (Drop.CountAll() > 0) { return true; }
        return false;
    }

    // 本帧对 `id` 满足条件的已注册处理器都会触发，
    // 在控件注册命中区域后每帧调用一次。
    // <paramref name="sender"/> 是触发事件的控件（两通道都会收到，
    // 无参处理器忽略它）；自行接线的控件传 <c>this</c>。
    // 全部事件以有无监听器为门槛（Ui.* 查询是纯谓词，读的焦点/
    // 悬停快照由 App.PresentFrame 统一翻转，跳过调用不影响状态
    // 推进）——保留树里大量的静态控件（无任何订阅者）不再为
    // 点击族/焦点族/进入离开族每帧付出完整的谓词求值与分发路径。
    void Fire(App app, int id, Control sender) {
        if (Click.CountAll() > 0) { Click.RaiseIfS(Ui.Clicked(app, id), sender); }
        if (DoubleClick.CountAll() > 0) { DoubleClick.RaiseIfS(Ui.DoubleClicked(app, id), sender); }
        if (MouseDown.CountAll() > 0) { MouseDown.RaiseIfS(Ui.PressedDown(app, id), sender); }
        if (MouseUp.CountAll() > 0) { MouseUp.RaiseIfS(Ui.MouseUpOn(app, id), sender); }
        if (Enter.CountAll() > 0) { Enter.RaiseIfS(Ui.Entered(app, id), sender); }
        if (Leave.CountAll() > 0) { Leave.RaiseIfS(Ui.Left(app, id), sender); }
        if (Focus.CountAll() > 0) { Focus.RaiseIfS(Ui.FocusGained(app, id), sender); }
        if (Blur.CountAll() > 0) { Blur.RaiseIfS(Ui.FocusLost(app, id), sender); }
        if (Tap.CountAll() > 0) { Tap.RaiseIfS(Ui.Tapped(app, id), sender); }
        if (RightClick.CountAll() > 0) { RightClick.RaiseIfS(Ui.RightClicked(app, id), sender); }
        if (Move.CountAll() > 0) { Move.RaiseIfS(Ui.MovedOver(app, id), sender); }
        if (Wheel.CountAll() > 0) { Wheel.RaiseIfS(Ui.Wheeled(app, id), sender); }
        if (KeyDown.CountAll() > 0) { KeyDown.RaiseIfS(Ui.KeyDownOn(app, id), sender); }
        if (KeyUp.CountAll() > 0) { KeyUp.RaiseIfS(Ui.KeyUpOn(app, id), sender); }
        if (KeyPress.CountAll() > 0) { KeyPress.RaiseIfS(Ui.KeyDownOn(app, id), sender); }
        if (Swipe.CountAll() > 0) { Swipe.RaiseIfS(Ui.SwipedAny(app, id), sender); }
        if (DragStart.CountAll() > 0) { DragStart.RaiseIfS(Ui.PressedDown(app, id), sender); }
        if (Drag.CountAll() > 0) { Drag.RaiseIfS(Ui.Dragging(app, id), sender); }
        if (Drop.CountAll() > 0) { Drop.RaiseIfS(Ui.Dropped(app, id), sender); }
        // 仅在有人监听时才轮询长按计时器：
        // 轮询会在按住期间调度低频率的后续帧，跳过它可保持
        // 不使用长按的控件在空闲/按压时零 CPU 开销。
        if (LongPress.CountAll() > 0) {
            LongPress.RaiseIfS(Ui.LongPressed(app, id), sender);
        }
    }

    // 按名称触发通用事件（测试或合成事件调度通道）
    void FireByName(string evt, Control sender) {
        if (evt == "Click") { Click.RaiseS(sender); return; }
        if (evt == "DoubleClick") { DoubleClick.RaiseS(sender); return; }
        if (evt == "RightClick") { RightClick.RaiseS(sender); return; }
        if (evt == "RightDoubleClick") { RightDoubleClick.RaiseS(sender); return; }
        if (evt == "MouseDown") { MouseDown.RaiseS(sender); return; }
        if (evt == "MouseUp") { MouseUp.RaiseS(sender); return; }
        if (evt == "Enter") { Enter.RaiseS(sender); return; }
        if (evt == "Leave") { Leave.RaiseS(sender); return; }
        if (evt == "Move") { Move.RaiseS(sender); return; }
        if (evt == "Wheel") { Wheel.RaiseS(sender); return; }
        if (evt == "Focus") { Focus.RaiseS(sender); return; }
        if (evt == "Blur") { Blur.RaiseS(sender); return; }
        if (evt == "KeyDown") { KeyDown.RaiseS(sender); return; }
        if (evt == "KeyUp") { KeyUp.RaiseS(sender); return; }
        if (evt == "KeyPress") { KeyPress.RaiseS(sender); return; }
        if (evt == "Tap") { Tap.RaiseS(sender); return; }
        if (evt == "LongPress") { LongPress.RaiseS(sender); return; }
        if (evt == "Swipe") { Swipe.RaiseS(sender); return; }
        if (evt == "DragStart") { DragStart.RaiseS(sender); return; }
        if (evt == "Drag") { Drag.RaiseS(sender); return; }
        if (evt == "Drop") { Drop.RaiseS(sender); return; }
    }
}
