using System;
using System.Json;
using System.Collections.Generic;
using Gui;
namespace Gui;
public partial class UserComponentRegistry {
    static List<UserComponent> Components() {
        GuiCoreState state = GuiCoreState.Current();
        if (state.userComponents == null) { state.userComponents = new List<UserComponent>(); }
        return state.userComponents;
    }
    public static void RegisterDefinition(string name, string doc) {
        if (name == null || name == "") { return; }
        string jsonDoc = doc != null ? doc : "";
        string key = name.ToLower();
        List<UserComponent> components = UserComponentRegistry.Components();
        for (int i = 0; i < components.Count; i = i + 1) {
            if (components[i] != null && components[i].name != null && components[i].name.ToLower() == key) {
                components[i].json = jsonDoc;
                return;
            }
        }
        components.Add(new UserComponent(name, jsonDoc));
    }
    static string JsonOf(string name) {
        if (name == null || name == "") { return ""; }
        string key = name.ToLower();
        List<UserComponent> components = UserComponentRegistry.Components();
        for (int i = 0; i < components.Count; i = i + 1) {
            if (components[i] != null && components[i].name != null && components[i].name.ToLower() == key) {
                return components[i].json != null ? components[i].json : "";
            }
        }
        return "";
    }
    static void ApplyProps(Control root, JsonValue compRoot,
                           JsonValue instanceProps) {
        if (root == null || compRoot == null) { return; }
        JsonValue decls = compRoot.Get("props");
        if (decls == null || !decls.IsArray()) { return; }
        for (int i = 0; i < decls.Count(); i = i + 1) {
            JsonValue dd = decls.At(i);
            if (dd == null || !dd.IsObject()) { continue; }
            string target = dd.Str("target", "");
            if (target == "") { continue; }
            string def = dd.Str("def", "");
            string val = instanceProps != null && instanceProps.IsObject()
                ? instanceProps.Str(dd.Str("key", ""), def) : def;
            Control t = root.Find(target);
            if (t != null) { t.SetProp(dd.Str("prop", "text"), val); }
        }
    }
}
