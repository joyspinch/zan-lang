using System;
using Gui;

namespace Gui;

// SubBox.zan - 通用伪元素子盒渲染器（消灭复合控件手搓几何与硬编码渲染）
// 复合控件（Switch/Progress/Checkbox/Slider/Radio）的轨道、滑块、指示条与选框
// 统一通过 SubBox 委托底层的 StyleBox.Paint 绘制，享有完整的单色/渐变背景、
// 四边独立边框、四角独立圆角、阴影与滤镜能力。
public class SubBox {
    // 绘制矩形子部件盒（如 track, fill, box）
    public static void Paint(App app, StyleBox s, int x, int y, int w, int h) {
        if (app == null || s == null || w <= 0 || h <= 0) { return; }
        s.Paint(app, x, y, w, h);
    }

    // 绘制圆形/胶囊子部件盒（如 thumb, radio circle, dot）
    public static void PaintCircle(App app, StyleBox s, int cx, int cy, int r) {
        if (app == null || s == null || r <= 0) { return; }
        int d = r * 2;
        int x = cx - r;
        int y = cy - r;
        s.SetRadius(r);
        s.Paint(app, x, y, d, d);
    }
}
