using System;
using System.Collections.Generic;
using Gui;

namespace Gui;

// Control.LayoutFlex.zan - CSS Flex 弹性盒尺寸度量与排布
public partial class Control {
    // 按内容测量一个 `display: flex` 容器：主轴取各子项之和（换行时
    // 取最长那一行），交叉轴取各行之和。只填补作者留空的那根轴，
    // 因此 Prefer() 与样式表的 width/height 依然优先。
    // 少了这一步，一个 flex 容器的 prefW/prefH 会停在 0：停靠进
    // 一列里就是零高，作者只能给每个容器写死一个像素高度——
    // 换行的一排按钮也就永远只能是一行。
    void MeasureFlexContent(App app) {
        if (prefW > 0 && prefH > 0) { return; }
        bool row = true;
        if (this.StyleFlexDir() == 1) { row = false; }
        int baseGap = this.StyleGap();
        int mainGap = this.StyleColGap(baseGap);
        int crossGap = this.StyleRowGap(baseGap);
        if (!row) {
            mainGap = this.StyleRowGap(baseGap);
            crossGap = this.StyleColGap(baseGap);
        }

        // 断行宽度：作者给过固定主轴尺寸就用它，否则用上一帧
        // Arrange 记下的实际内容框长度。仍为 0（首帧）时按单行测量，
        // 下面会再要一帧来收敛。
        int wrapMain = 0;
        if (this.StyleWrap() != 0) {
            wrapMain = flexWrapMain;
            // 宿主给过宽度就用它：每帧重建的容器没有上一帧的
            // flexWrapMain 可用，这是它唯一能算准行数的依据。
            // 纵向容器的主轴是高度，这个提示不适用。
            if (row && hintWrapW > 0) {
                wrapMain = hintWrapW - this.StyleInsetL() - this.StyleInsetR();
            }
            if (row && prefW > 0) {
                wrapMain = prefW - this.StyleInsetL() - this.StyleInsetR();
            } else if (!row && prefH > 0) {
                wrapMain = prefH - this.StyleInsetT() - this.StyleInsetB();
            }
        }

        int onLine = 0;
        int lineMain = 0;
        int lineCross = 0;
        int mainMax = 0;
        int crossSum = 0;
        int lines = 0;
        List<Control> flexKids = this.FlexKids();
        for (int i = 0; i < flexKids.Count; i = i + 1) {
            Control c = flexKids[i];
            // 主轴尺寸和排布时用同一个来源：flex-basis 优先，其次
            // 才是测量偏好，否则断行数会和实际排布不一致。这里的
            // 包含块尚未确定，因此百分比 basis 按 auto 回落（断行
            // 计算里 % basis 取测量偏好/width 声明）。
            int m = c.prefH;
            int cr = c.prefW;
            if (row) { m = c.prefW; cr = c.prefH; }
            int bs = c.StyleBasisIn(wrapMain);
            if (bs < 0) {
                if (row) { bs = c.StyleWidthIn(wrapMain); }
                else { bs = c.StyleHeightIn(wrapMain); }
            }
            if (bs >= 0) { m = bs; }
            if (row) {
                int ch = c.StyleHeightIn(0);
                if (ch >= 0) { cr = ch; }
            } else {
                int cw = c.StyleWidthIn(0);
                if (cw >= 0) { cr = cw; }
            }
            m = m + c.MarMain(row);
            cr = cr + c.MarCross(row);
            int need = m;
            if (onLine > 0) { need = need + mainGap; }
            if (wrapMain > 0 && onLine > 0 && lineMain + need > wrapMain) {
                if (lineMain > mainMax) { mainMax = lineMain; }
                crossSum = crossSum + lineCross;
                lines = lines + 1;
                lineMain = m;
                lineCross = cr;
                onLine = 1;
            } else {
                lineMain = lineMain + need;
                if (cr > lineCross) { lineCross = cr; }
                onLine = onLine + 1;
            }
        }
        if (onLine == 0) { return; }
        if (lineMain > mainMax) { mainMax = lineMain; }
        crossSum = crossSum + lineCross;
        lines = lines + 1;

        int lh = this.StyleLineHeight();
        if (lh > 0 && lh * lines > crossSum) { crossSum = lh * lines; }
        if (lines > 1) { crossSum = crossSum + crossGap * (lines - 1); }

        if (row) {
            if (prefW <= 0 && mainMax > 0) {
                prefW = mainMax + this.StyleInsetL() + this.StyleInsetR();
                this.fillW = true;
            }
            if (prefH <= 0 && crossSum > 0) {
                prefH = crossSum + this.StyleInsetT() + this.StyleInsetB();
                this.fillH = true;
            }
        } else {
            if (prefH <= 0 && mainMax > 0) {
                prefH = mainMax + this.StyleInsetT() + this.StyleInsetB();
                this.fillH = true;
            }
            if (prefW <= 0 && crossSum > 0) {
                prefW = crossSum + this.StyleInsetL() + this.StyleInsetR();
                this.fillW = true;
            }
        }

        // 首帧（或宿主刚改过宽度）时断行宽度还是上一轮的值，算出的
        // 高度就是过时的。Arrange 拿到真实宽度后会更新 flexWrapMain，
        // 这里主动再要一帧，让高度在下一帧收敛后就地稳定下来。
        if (this.StyleWrap() != 0 && flexMeasMain != flexWrapMain) {
            flexMeasMain = flexWrapMain;
            app.RequestRedraw();
        }
    }

    // 把子节点作为一个 CSS flex 容器排布在本节点的内容框内。
    // `flex-wrap: nowrap`（默认）时全部子节点排成一条 flex 行。
    // `wrap` 时按各项自然主轴尺寸断行——一行至少容纳一项，因此
    // 比整框还长的子项只会自己占满一行，不会卡住断行——行与行
    // 之间用交叉轴间距（row 容器取 `row-gap`，column 容器取
    // `column-gap`，都回退到 `gap`）分隔，多余的交叉轴空间按
    // `align-content` 分配。每一行内部的规则见 ArrangeFlexLine。
    // flex 容器参与排布的子项：可见、非 absolute（absolute 脱离
    // 常规流）、按 CSS `order` 稳定排序（同 order 保持文档序）。
    // 测量（MeasureFlexContent）与排布（ArrangeFlex）共用同一份
    // 顺序，断行行数才一致。
    static List<Control> emptyKids = new List<Control>();

    List<Control> FlexKids() {
        if (children == null || children.Count == 0) { return Control.emptyKids; }
        List<Control> items = new List<Control>();
        for (int k = 0; k < children.Count; k = k + 1) {
            Control c = children[k];
            if (!c.StyleVisible() || c.StylePosition() == 2 || (c.StylePosition() == 0 && (c.mx != 0 || c.my != 0))) { continue; }
            int ord = c.StyleOrder();
            if (ord == 0) {
                items.Add(c);
                continue;
            }
            int ins = items.Count;
            while (ins > 0 && items[ins - 1].StyleOrder() > ord) {
                ins = ins - 1;
            }
            items.Insert(ins, c);
        }
        if (items.Count == 0) { return Control.emptyKids; }
        return items;
    }

    void ArrangeFlex(int cx, int cy, int cw, int ch, int gapPx) {
        bool row = true;
        if (this.StyleFlexDir() == 1) { row = false; }
        int mainBox = cw;
        int crossBox = ch;
        int mainGap = this.StyleColGap(gapPx);
        int crossGap = this.StyleRowGap(gapPx);
        if (!row) {
            mainBox = ch;
            crossBox = cw;
            mainGap = this.StyleRowGap(gapPx);
            crossGap = this.StyleColGap(gapPx);
        }

        List<Control> items = this.FlexKids();
        int n = items.Count;
        if (n == 0) { return; }

        // 记下真正用来断行的主轴框长：下一次测量据此算出行数，
        // 换行容器的高度才能收敛（见 MeasureFlexContent）。
        flexWrapMain = mainBox;

        if (this.StyleWrap() == 0) {
            this.ArrangeFlexLine(items, cx, cy, cw, ch, mainGap, row, 0, crossBox);
            return;
        }

        List<int> lineFrom = new List<int>();
        List<int> lineTo = new List<int>();
        List<int> lineCross = new List<int>();
        int declaredLineH = this.StyleLineHeight();
        int idx = 0;
        while (idx < n) {
            int start = idx;
            int lineMain = 0;
            int maxCross = 0;
            while (idx < n) {
                Control c = items[idx];
                int m = c.StyleHeightIn(ch);
                int cr = c.StyleWidthIn(cw);
                if (row) {
                    m = c.StyleWidthIn(cw);
                    cr = c.StyleHeightIn(ch);
                }
                if (m < 0) { m = 0; }
                m = m + c.MarMain(row);
                cr = cr + c.MarCross(row);
                int need = m;
                if (idx > start) { need = need + mainGap; }
                if (idx > start && lineMain + need > mainBox) { break; }
                lineMain = lineMain + need;
                if (cr > maxCross) { maxCross = cr; }
                idx = idx + 1;
            }
            if (declaredLineH > maxCross) { maxCross = declaredLineH; }
            lineFrom.Add(start);
            lineTo.Add(idx);
            lineCross.Add(maxCross);
        }

        int lines = lineFrom.Count;
        int crossUsed = 0;
        for (int li = 0; li < lines; li = li + 1) {
            crossUsed = crossUsed + lineCross[li];
        }
        if (lines > 1) { crossUsed = crossUsed + crossGap * (lines - 1); }
        int crossFree = crossBox - crossUsed;
        if (crossFree < 0) { crossFree = 0; }

        int crossOff = 0;
        int between = crossGap;
        int stretch = 0;
        int ac = this.StyleAlignContent();
        if (ac == 1) { crossOff = crossFree / 2; }
        else if (ac == 2) { crossOff = crossFree; }
        else if (ac == 3 && lines > 1) {
            between = between + crossFree / (lines - 1);
        } else if (ac == 4) {
            crossOff = crossFree / (lines + 1);
            between = between + crossOff;
        } else if (ac == 5) { stretch = crossFree / lines; }

        for (int li = 0; li < lines; li = li + 1) {
            int lc = lineCross[li] + stretch;
            this.ArrangeFlexLineSlice(items, lineFrom[li], lineTo[li], cx, cy, cw, ch, mainGap, row, crossOff, lc);
            crossOff = crossOff + lc + between;
        }
    }

    // 排布一条 flex 行：每个子节点取声明的主轴尺寸（px 或框的
    // 百分比），未声明时取测量偏好；`flex-grow` 分配剩余空间；
    // `justify-content` 安排剩余部分，`align-items` 决定交叉轴
    // 尺寸（默认 stretch）。支持 margins 和 `gap`，溢出的一行
    // 会按比例收缩而不是溢出框外。
    // `crossOff` 是该行在交叉轴上相对内容框的偏移，`crossBox`
    // 是该行的交叉轴尺寸——单行容器就是整个内容框，换行容器
    // 则由 ArrangeFlex 逐行给出。
    void ArrangeFlexLine(List<Control> items, int cx, int cy, int cw, int ch,
                         int gapPx, bool row, int crossOff, int crossBox) {
        if (items == null) { return; }
        this.ArrangeFlexLineSlice(items, 0, items.Count, cx, cy, cw, ch, gapPx, row, crossOff, crossBox);
    }

    // ArrangeFlexLine 的切片版本：直接在主项列表中按 [start, end) 索引进行排布，
    // 避免多行换行排布时每行动态分配中间 List<Control>。
    void ArrangeFlexLineSlice(List<Control> items, int start, int end, int cx, int cy, int cw, int ch,
                              int gapPx, bool row, int crossOff, int crossBox) {
        int n = end - start;
        if (n <= 0) { return; }
        int mainBox = cw;
        if (!row) { mainBox = ch; }

        List<int> sizes = new List<int>();
        int used = 0;
        int totalGrow = 0;
        int i = 0;
        while (i < n) {
            Control c = items[start + i];
            // flex-basis 优先于 width/height 与测量偏好（CSS 的顺序）：
            // `flex: 1 1 0` 的一组子项因此从 0 起分空间，得到真正等宽的
            // 列，而不是各自的自然宽度加上剩余空间的份额。
            int sz = c.StyleBasisIn(mainBox);
            if (sz < 0) {
                if (row) { sz = c.StyleWidthIn(cw); } else { sz = c.StyleHeightIn(ch); }
            }
            if (sz < 0) { sz = 0; }
            sizes.Add(sz);
            used = used + sz + c.MarMain(row);
            totalGrow = totalGrow + c.StyleGrow();
            i = i + 1;
        }
        int gaps = 0;
        if (n > 1) { gaps = (n - 1) * gapPx; }
        int free = mainBox - used - gaps;

        if (free > 0 && totalGrow > 0) {
            // 两遍处理：先按 flex-grow 分配剩余空间并把结果
            // 钳制到 max-width/height，再把被钳制项让出的空间
            // 分给还能接受的项目。
            int pass = 0;
            while (pass < 2 && free > 0) {
                int share = free;
                int growable = 0;
                i = 0;
                while (i < n) {
                    int g = items[start + i].StyleGrow();
                    if (g > 0) { growable = growable + g; }
                    i = i + 1;
                }
                if (growable == 0) { pass = 2; }
                else {
                    // 整除剩下的那几个像素全给最后一个可增长项：按
                    // `share * g / growable` 逐项分配会把余数丢掉，
                    // 一行三等分因此总短 1~2 px，右边缘和上下相邻的
                    // 行对不齐——正是排版看起来"没对准"的来源。
                    int lastGrow = 0 - 1;
                    i = 0;
                    while (i < n) {
                        if (items[start + i].StyleGrow() > 0) { lastGrow = i; }
                        i = i + 1;
                    }
                    int taken = 0;
                    int handed = 0;
                    i = 0;
                    while (i < n) {
                        int g = items[start + i].StyleGrow();
                        if (g > 0) {
                            int add = share * g / growable;
                            if (i == lastGrow) { add = share - handed; }
                            handed = handed + add;
                            int want = sizes[i] + add;
                            int got = want;
                            if (row) { got = items[start + i].StyleClampW(cw, want); }
                            else { got = items[start + i].StyleClampH(ch, want); }
                            taken = taken + got - sizes[i];
                            sizes[i] = got;
                        }
                        i = i + 1;
                    }
                    free = free - taken;
                    if (taken == 0) { pass = 2; }
                    pass = pass + 1;
                }
            }
            if (free < 0) { free = 0; }
        } else if (free < 0 && used > 0) {
            // 溢出的一行：当容器为主轴滚动容器（overflow-x/y >= 2 即 auto/scroll）时，
            // 子项不应被强制收缩压扁，而应保持自然尺寸溢出供滚动；
            // 只有非滚动或 overflow:hidden 容器才按比例收缩（flex-shrink 默认 1）。
            // 声明了 `flex-shrink: 0` 的子项保持自身尺寸不参与。
            bool canScrollMain = row ? (this.StyleOverflowX() >= 2) : (this.StyleOverflowY() >= 2);
            if (!canScrollMain) {
                int marTotal = 0;
                int fixedMain = 0;
                int flexMain = 0;
                i = 0;
                while (i < n) {
                    marTotal = marTotal + items[start + i].MarMain(row);
                    if (items[start + i].StyleShrink() == 0) {
                        fixedMain = fixedMain + sizes[i];
                    } else {
                        flexMain = flexMain + sizes[i];
                    }
                    i = i + 1;
                }
                int room = mainBox - gaps - marTotal - fixedMain;
                if (room < 0) { room = 0; }
                if (flexMain > 0) {
                    // min-content 下限（CSS 的 min-width:auto，A545）：收缩
                    // 不把内容不可重排的子项压扁——下限由 MinContentMain
                    // 逐件给出，声明了的 min/max 经 StyleClampW/H 套上，
                    // 再钳到基准尺寸内（flex-basis:0 的子项按 CSS 的
                    // specified-size 建议钳到 0）。顶到下限的子项冻结，
                    // 缺口按「可让空间」（尺寸-下限）转摊给还能让位的
                    // 子项，每轮至少冻结一件故至多 n 轮收敛；全都顶住时
                    // 整行按自然尺寸溢出——溢出可见好过压成 0 宽（看不
                    // 见也点不着）。
                    List<int> floors = new List<int>();
                    int give = room;
                    i = 0;
                    while (i < n) {
                        int f = 0;
                        if (items[start + i].StyleShrink() != 0) {
                            if (row) { f = items[start + i].StyleClampW(cw, items[start + i].MinContentMain(row)); }
                            else { f = items[start + i].StyleClampH(ch, items[start + i].MinContentMain(row)); }
                            if (f > sizes[i]) { f = sizes[i]; }
                            give = give - sizes[i];
                        }
                        floors.Add(f);
                        i = i + 1;
                    }
                    int guard = 0;
                    while (give < 0 && guard <= n) {
                        guard = guard + 1;
                        int pool = 0;
                        i = 0;
                        while (i < n) {
                            if (items[start + i].StyleShrink() != 0
                                && sizes[i] - floors[i] > 0) { pool = pool + sizes[i] - floors[i]; }
                            i = i + 1;
                        }
                        if (pool <= 0) { break; }
                        int taken = 0;
                        int lastGive = 0 - 1;
                        i = 0;
                        while (i < n) {
                            if (items[start + i].StyleShrink() != 0
                                && sizes[i] - floors[i] > 0) { lastGive = i; }
                            i = i + 1;
                        }
                        i = 0;
                        while (i < n) {
                            if (items[start + i].StyleShrink() != 0
                                && sizes[i] - floors[i] > 0) {
                                int cut = give * (sizes[i] - floors[i]) / pool;
                                if (i == lastGive) { cut = give + taken; }
                                int want = sizes[i] + cut;
                                if (want < floors[i]) { want = floors[i]; }
                                taken = taken + sizes[i] - want;
                                sizes[i] = want;
                            }
                            i = i + 1;
                        }
                        give = give + taken;
                    }
                }
            }
            free = 0;
        }

        int offset = 0;
        int between = gapPx;
        int justify = 0;
        if (computedStyle != null) { justify = computedStyle.justify; }
        if (justify == 1) { offset = free / 2; }
        else if (justify == 2) { offset = free; }
        else if (justify == 3 && n > 1) { between = between + free / (n - 1); }
        else if (justify == 4) {
            int slots = n + 1;
            offset = free / slots;
            between = between + offset;
        }

        int align = 0;
        if (computedStyle != null) { align = computedStyle.alignItems; }
        int pos = offset;
        i = 0;
        while (i < n) {
            Control c = items[start + i];
            int main = sizes[i];
            int crossAvail = crossBox - c.MarCross(row);
            if (crossAvail < 0) { crossAvail = 0; }
            int cross;
            if (row) { cross = c.StyleHeightIn(ch); } else { cross = c.StyleWidthIn(cw); }
            bool declaresCross = row ? c.StyleDeclaresHeight() : c.StyleDeclaresWidth();
            // aspect-ratio：交叉轴没有被显式声明时由主轴尺寸推出，
            // 这样一张 16/9 的缩略图只需要给宽度。
            int ratio = c.StyleAspect();
            if (ratio > 0 && !declaresCross) {
                if (row) { cross = main * 1000 / ratio; }
                else { cross = main * ratio / 1000; }
                declaresCross = true;
            }
            // align-self 覆盖容器的 align-items（未声明为 -1）。
            int al = c.StyleAlignSelf();
            if (al < 0) { al = align; }
            if (cross > crossAvail) { cross = crossAvail; }
            if (al == 0 && !declaresCross) { cross = crossAvail; }
            if (cross <= 0) { cross = crossAvail; }
            int crossPos = 0;
            if (al == 2) { crossPos = (crossAvail - cross) / 2; }
            else if (al == 3) { crossPos = crossAvail - cross; }
            if (row) {
                c.Arrange(cx + pos + c.StyleMarL(),
                          cy + crossOff + crossPos + c.StyleMarT(), main, cross);
            } else {
                c.Arrange(cx + crossOff + crossPos + c.StyleMarL(),
                          cy + pos + c.StyleMarT(), cross, main);
            }
            pos = pos + main + c.MarMain(row) + between;
            i = i + 1;
        }
    }

    // 把此节点的 min/max-width（或 -height）应用到 `v`，
    // 百分比边界按 `avail` 的包含块解析。
    int StyleClampW(int avail, int v) {
        if (computedStyle == null) { return v; }
        return computedStyle.ClampWIn(avail, v);
    }

    // 把 `v` 限制在本节点的 min/max-height 内（百分比边界按
    // `avail` 的包含块解析），同 StyleClampW。
    int StyleClampH(int avail, int v) {
        if (computedStyle == null) { return v; }
        return computedStyle.ClampHIn(avail, v);
    }

    // 沿/跨 flex 行的总外边距。
    int MarMain(bool row) {
        if (row) { return this.StyleMarL() + this.StyleMarR(); }
        return this.StyleMarT() + this.StyleMarB();
    }

    // 交叉方向上的总外边距（行容器为上下，列容器为左右）。
    int MarCross(bool row) {
        if (row) { return this.StyleMarT() + this.StyleMarB(); }
        return this.StyleMarL() + this.StyleMarR();
    }
}
