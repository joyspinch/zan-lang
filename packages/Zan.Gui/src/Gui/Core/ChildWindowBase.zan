namespace Gui;

// 子窗口在 Core 层的契约：ChildWindows 注册表（App 主循环的多窗口泵）只经
// 这层驱动，具体窗口（Forms 层 ChildWindow）继承并实现。
public class ChildWindowBase : AppLoopOwner {
    App host;
    weak App parentApp;

    public virtual Control View() { return null; }
    virtual string Title() { return "Zan"; }
    virtual void OnLanguageChanged(string lang) { }
    virtual void Render() { }
    virtual long LastRenderUs() { return 0; }
    virtual bool NeedsRedraw() { return false; }
    virtual bool IsOpen() { return false; }
    virtual bool OwnsWindow(nint hwnd) { return false; }
    virtual void ApplyEvent(nint hwnd) { }
    virtual void Teardown() { }
    virtual void RequestRedraw() { }
    virtual void FollowSkin(int i) { }
    virtual void FollowCaptionTips(App src) { }
    virtual void FollowOpacity(int percent) { }
    virtual void FollowWallpaper(string path, int opacity) { }
    virtual int AnimNextMs() { return -1; }
    virtual void TickInputGestures() { }
    virtual int FxNextMs() { return -1; }
}
