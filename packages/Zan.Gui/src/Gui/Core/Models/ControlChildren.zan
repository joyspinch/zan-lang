using System;
using System.Collections.Generic;

namespace Gui;

// Borrowed collection view: mutations use the retained tree ownership contract.
public class ControlChildren : IEnumerable<Control> {
    private weak Control owner;

    public ControlChildren(Control control) { owner = control; }

    public int Count { get { return owner != null ? owner.children.Count : 0; } }

    public Control this[int index] {
        get {
            Control control = owner;
            if (control == null) { throw new InvalidOperationException("Children owner is no longer alive."); }
            return control.children[index];
        }
    }

    public void Add(Control child) {
        Control control = owner;
        if (control != null && child != null) { control.With(child); }
    }

    public bool Remove(Control child) {
        Control control = owner;
        if (control == null || child == null || control.IndexOf(child) < 0) { return false; }
        control.Remove(child);
        return true;
    }

    public void Clear() {
        Control control = owner;
        if (control != null) { control.RemoveAll(); }
    }

    // A snapshot retains children while iterating, never their owner.
    public IEnumerator<Control> GetEnumerator() {
        Control control = owner;
        List<Control> snapshot = new List<Control>();
        if (control != null) { snapshot.AddRange(control.children); }
        return new ArrayEnumerator<Control>(snapshot.ToArray());
    }
}
