using System;
using System.Collections.Generic;
using Gui;
using Gui.Backend;
using Gui.Widget;

namespace Gui;

// 因此每次 `new` 都是一次性的薄包装，不值得持有。
public class ControlChildren {
    public weak Control owner;

    // 一次性包装：持有目标容器（弱引用）。
    ControlChildren(Control o) { owner = o; }

    // 返回 void 而非子节点：集合初始化器逐个调用 Add 后丢弃返回值，
    // 若返回子节点（+1 所有权），每次初始化都会丢一个必须显式释放的
    // 引用；需要内联持有时用 `panel.Add(c)`（返回子节点）。
    void Add(Control c) {
        owner.With(c);
    }
}

