using System;

namespace Gui;

// 窗口轮廓几何区域类型枚举定义（标准化 HTML+CSS / 跨平台几何协议）
public class WindowShapeKind {
    public const int Default = 0;       // 默认标准矩形
    public const int RoundedRect = 1;   // 矩形 / 圆角矩形（radius > 0 为圆角）
    public const int Ellipse = 2;       // 椭圆（width / height 为外接包围盒）
    public const int ShadowBand = 3;    // 阴影外扩保护带（全窗口外扩带，不接收点击）
}
