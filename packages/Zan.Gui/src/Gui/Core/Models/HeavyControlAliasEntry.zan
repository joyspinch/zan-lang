using System;
using System.Collections.Generic;
using Gui;

namespace Gui;

// 重尾控件序列化别名条目实体（消除 aliasFrom / aliasTo 平行列表反模式）。
public class HeavyControlAliasEntry {
    public string from;
    public string to;

    HeavyControlAliasEntry(string from, string to) {
        this.from = from;
        this.to = to;
    }
}

