using System;
using System.Json;

namespace Gui;

// JsonDoc 槽位轻量只读游标：把零拷贝 tape 的某一个对象/元素槽位包装成作用域实体，
// 用于 ModelBinder 零堆分配渲染只读复杂结构与 <template data-for> 行展开。
public class JsonDocCursor {
    public JsonDoc doc;
    public int slot;

    public JsonDocCursor(JsonDoc doc, int slot) {
        this.doc = doc;
        this.slot = slot;
    }
}
