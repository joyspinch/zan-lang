using System;
using System.Collections.Generic;
using Gui;
using Gui.Backend;
using Gui.Widget;

namespace Gui;

// 处理器标识符。用单个实体取代并行的键/值列表。
public class EventBinding {
    public string key;
    public string val;

    // 构造一条绑定（事件名 -> 处理器标识符）。
    EventBinding(string key, string val) {
        this.key = key;
        this.val = val;
    }
}

