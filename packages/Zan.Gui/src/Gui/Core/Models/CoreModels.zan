using Gui;
using System.Collections.Generic;
using System;

namespace Gui;

public class AnimSlot {
    public int key;
    public int cur;
    public int dst;
    public int src;
    public int startMs;
    public int dur;
    AnimSlot(int k, int c, int d, int s, int st, int du) {
        key = k;
        cur = c;
        dst = d;
        src = s;
        startMs = st;
        dur = du;
    }
}

public class AppPostWork {
    public weak App owner;
    public weak AppPostWork prev;
    public weak AppPostWork next;
    public Action handler;
    public void Run() {
        App app = owner;
        if (app != null) { app.RunPost(this); }
    }
}

public class BlurSlot {
    public int key;  // 占用槽的元素身份（0=空槽）
    public int lastUse;  // 最后被用到的帧号
    public int lastNew;  // 最后一次换手（分配给新身份）的帧号
    BlurSlot() {
        this.key = 0;
        this.lastUse = 0;
        this.lastNew = -1;
    }
}

public class ChildExpandedRow {
    public Control rowRoot;
    public Control template;
    public string key;
    ChildExpandedRow(Control rowRoot, Control template) {
        this.rowRoot = rowRoot;
        this.template = template;
        this.key = "";
    }
    ChildExpandedRow(Control rowRoot, Control template, string key) {
        this.rowRoot = rowRoot;
        this.template = template;
        this.key = key;
    }
}

public class ChildTemplateMeta {
    public Control template;
    public int lastCount;
    public string sourcePath;
    public string alias;
    public object source;
    public List<object> items;
    ChildTemplateMeta(Control template, int lastCount) {
        this.template = template;
        this.lastCount = lastCount;
        this.sourcePath = "";
        this.alias = "";
    }
    ChildTemplateMeta(Control template, int lastCount, string sourcePath, string alias) {
        this.template = template;
        this.lastCount = lastCount;
        this.sourcePath = sourcePath;
        this.alias = alias;
    }
}

public class ControlChildren : IEnumerable<Control> {
    private weak Control owner;
    public ControlChildren(Control control) { owner = control; }
    public int Count { get { return owner != null ? owner.ChildCount() : 0; } }
    public Control this[int index] {
        get {
            Control control = owner;
            if (control == null) { throw new InvalidOperationException("Children owner is no longer alive."); }
            return control.ChildAt(index);
        }
    }
    public void Add(Control child) {
        Control control = owner;
        if (control != null && child != null) { control.With(child); }
    }
    public bool Remove(Control child) {
        Control control = owner;
        if (control == null || child == null || control.IndexOf(child) < 0) { return false; }
        control.Remove(child);
        return true;
    }
    public void Clear() {
        Control control = owner;
        if (control != null) { control.RemoveAll(); }
    }
    public IEnumerator<Control> GetEnumerator() {
        Control control = owner;
        int count = control != null ? control.ChildCount() : 0;
        Control[] snapshot = new Control[count];
        for (int i = 0; i < count; i = i + 1) { snapshot[i] = control.ChildAt(i); }
        return new ArrayEnumerator<Control>(snapshot);
    }
}

public class ElementRun {
    public string text;
    public int x;  // run 左（含对齐偏移）
    public int topY;  // piece 顶（基线 − asc，含半行距）
    public int w;
    public int h;  // 行高（inline 盒矩形的高）
    public int drawOff;  // DrawText y = topY + drawOff（半行距下移）
    public int fs;
}

public class EventBinding {
    public string key;
    public string val;
    EventBinding(string key, string val) {
        this.key = key;
        this.val = val;
    }
}

public class FlowEntry {
    public string text;
    public Control kid;
}

public class HandlerEntry {
    public string name;
    public Action action;
    public Action<string> argAction;
    public ControlEvent senderAction;
    public ControlItemEvent itemAction;
    HandlerEntry(string name, Action action) {
        this.name = name;
        this.action = action;
    }
}

public class HitRegion {
    public int id;
    public int x;
    public int y;
    public int width;
    public int height;
    public int widgetType;
    public string label;
    HitRegion(int id, int x, int y, int w, int h, int wtype) {
        this.id = id;
        this.x = x;
        this.y = y;
        this.width = w;
        this.height = h;
        this.widgetType = wtype;
        this.label = "";
    }
    bool Contains(int px, int py) {
        if (px < x) { return false; }
        if (px >= x + width) { return false; }
        if (py < y) { return false; }
        if (py >= y + height) { return false; }
        return true;
    }
    void Set(int id, int x, int y, int w, int h, int wtype) {
        this.id = id;
        this.x = x;
        this.y = y;
        this.width = w;
        this.height = h;
        this.widgetType = wtype;
        this.label = "";
    }
}

public class ModelBindingDeclaration {
    string path;
    string property;
    bool twoWay;
    public string Path { get { return path; } }
    public string Property { get { return property; } }
    public bool TwoWay { get { return twoWay; } }
    public ModelBindingDeclaration(string modelPath, string targetProperty, bool writeBack) {
        this.path = modelPath;
        this.property = targetProperty;
        this.twoWay = writeBack;
    }
    public static bool ValidPath(string path) {
        if (path == null || path == "") { return false; }
        int segment = 0;
        for (int i = 0; i < path.Length; i = i + 1) {
            int ch = path[i] & 255;
            if (ch == 46) {
                if (segment == 0) { return false; }
                segment = 0;
                continue;
            }
            bool identifier = (ch >= 97 && ch <= 122) || (ch >= 65 && ch <= 90)
                || (ch >= 48 && ch <= 57) || ch == 95 || ch >= 128;
            if (!identifier || (segment == 0 && ch >= 48 && ch <= 57)) { return false; }
            segment = segment + 1;
        }
        return segment > 0;
    }
}

// OverlayHost 弹层栈中的单层条目，支持多层嵌套弹层、模态屏障与独立定位模式。
public class OverlayEntry {
    public Control popup;
    public weak Control anchor;
    public bool anchored;
    public bool positioned;
    public bool modal;
    public int pointX;
    public int pointY;
    public long openedEventSeq;
    public bool openedEventValid;

    public OverlayEntry(Control popup, Control anchor, bool anchored, bool positioned,
                        int pointX, int pointY, bool modal,
                        bool openedEventValid, long openedEventSeq) {
        this.popup = popup;
        this.anchor = anchor;
        this.anchored = anchored;
        this.positioned = positioned;
        this.pointX = pointX;
        this.pointY = pointY;
        this.modal = modal;
        this.openedEventValid = openedEventValid;
        this.openedEventSeq = openedEventSeq;
    }
}

public class UserComponent {
    public string name;
    public string json;
    public UserComponent(string name, string json) {
        this.name = name;
        this.json = json;
    }
}
