using System;
using System.Collections.Generic;
using Gui;
using Gui.Backend;
using Gui.Widget;

namespace Gui;

// 窗口上的一个周期任务（Form.Every 登记）。工控画面、
// 监控看板这类“定时重扫”的屏幕靠它驱动，不必自己
// 写事件循环。
public class FormTask {
    public int periodMs;
    // 下次到期的时刻（App 的动画时钟）。
    public int dueMs;
    public Action work;

    // 构造任务：周期钳制到 >= 1 毫秒，首次到期时刻由 Schedule 设定。
    FormTask(int ms, Action a) {
        periodMs = ms;
        if (periodMs < 1) { periodMs = 1; }
        work = a;
        dueMs = 0;
    }

    // 任务周期（毫秒，最小 1）。
    int Period() { return periodMs; }
    // 下次到期时刻（App 动画时钟毫秒）。
    int Due() { return dueMs; }
    // 安排下次到期时刻（由 Form.Every/PumpTasks 维护）。
    void Schedule(int atMs) { dueMs = atMs; }
    // 执行任务体。
    void Fire() { work(); }
}

// 保留模式 UI 的根：窗口本身作为一个组件。拥有 App
