using System;
using System.Collections.Generic;
using Gui;
namespace Gui;
public class FormTask {
    public int periodMs;
    public int dueMs;
    public Action work;
    FormTask(int ms, Action a) {
        periodMs = ms;
        if (periodMs < 1) { periodMs = 1; }
        work = a;
        dueMs = 0;
    }
    int Period() { return periodMs; }
    int Due() { return dueMs; }
    void Schedule(int atMs) { dueMs = atMs; }
    void Fire() { work(); }
}
