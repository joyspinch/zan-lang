using System;
using Gui.Backend;

namespace Gui;

// 模糊缓存槽状态实体（消除 blurSlotKey / blurSlotUse / blurSlotNew 平行列表反模式）。
public class BlurSlot {
    public int key;  // 占用槽的元素身份（0=空槽）
    public int lastUse;  // 最后被用到的帧号
    public int lastNew;  // 最后一次换手（分配给新身份）的帧号

    BlurSlot() {
        this.key = 0;
        this.lastUse = 0;
        this.lastNew = -1;
    }
}

