using System;
using System.Collections.Generic;
using Gui;
namespace Gui;
public class HitRegion {
    public int id;
    public int x;
    public int y;
    public int width;
    public int height;
    public int widgetType;
    public string label;
    HitRegion(int id, int x, int y, int w, int h, int wtype) {
        this.id = id;
        this.x = x;
        this.y = y;
        this.width = w;
        this.height = h;
        this.widgetType = wtype;
        this.label = "";
    }
    bool Contains(int px, int py) {
        if (px < x) { return false; }
        if (px >= x + width) { return false; }
        if (py < y) { return false; }
        if (py >= y + height) { return false; }
        return true;
    }
    void Set(int id, int x, int y, int w, int h, int wtype) {
        this.id = id;
        this.x = x;
        this.y = y;
        this.width = w;
        this.height = h;
        this.widgetType = wtype;
        this.label = "";
    }
}
