using System;
using System.Collections.Generic;
using Gui;

namespace Gui;

// UiDriver 的 `clickid @name` 也按它当场解析（指针命中
// 解析仍只用几何，不读标签）；未标注时为空串。
public class HitRegion {
    public int id;
    public int x;
    public int y;
    public int width;
    public int height;
    public int widgetType;
    public string label;

    // 构造：逐字段赋值（池化复用改走 Set）。
    HitRegion(int id, int x, int y, int w, int h, int wtype) {
        this.id = id;
        this.x = x;
        this.y = y;
        this.width = w;
        this.height = h;
        this.widgetType = wtype;
        this.label = "";
    }

    // 点 (px, py) 是否落在矩形内（左闭右开）。
    bool Contains(int px, int py) {
        if (px < x) { return false; }
        if (px >= x + width) { return false; }
        if (py < y) { return false; }
        if (py >= y + height) { return false; }
        return true;
    }

    // 就地改写（供 HitTester 复用池中的对象）。
    void Set(int id, int x, int y, int w, int h, int wtype) {
        this.id = id;
        this.x = x;
        this.y = y;
        this.width = w;
        this.height = h;
        this.widgetType = wtype;
        this.label = "";
    }
}

