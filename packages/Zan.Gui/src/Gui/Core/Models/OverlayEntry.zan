using System;
using Gui;

namespace Gui;

// OverlayHost 弹层栈中的单层条目，支持多层嵌套弹层、模态屏障与独立定位模式。
public class OverlayEntry {
    public Control popup;
    public weak Control anchor;
    public bool anchored;
    public bool positioned;
    public bool modal;
    public int pointX;
    public int pointY;
    public long openedEventSeq;
    public bool openedEventValid;

    public OverlayEntry(Control popup, Control anchor, bool anchored, bool positioned,
                        int pointX, int pointY, bool modal,
                        bool openedEventValid, long openedEventSeq) {
        this.popup = popup;
        this.anchor = anchor;
        this.anchored = anchored;
        this.positioned = positioned;
        this.pointX = pointX;
        this.pointY = pointY;
        this.modal = modal;
        this.openedEventValid = openedEventValid;
        this.openedEventSeq = openedEventSeq;
    }
}
