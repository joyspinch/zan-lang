using System;
using System.Collections.Generic;
using Gui;
using Gui.Backend;

namespace Gui;

// （窗口根相对），绘制端直接用。
public class ElementRun {
    public string text;
    public int x;  // run 左（含对齐偏移）
    public int topY;  // piece 顶（基线 − asc，含半行距）
    public int w;
    public int h;  // 行高（inline 盒矩形的高）
    public int drawOff;  // DrawText y = topY + drawOff（半行距下移）
    public int fs;
}

