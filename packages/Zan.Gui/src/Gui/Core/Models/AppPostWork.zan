using System;

namespace Gui;

// Only the queued closure owns this node; App and sibling links are indexes.
// Keeping the handler here lets StopLoop release captures before the UI drains.
public class AppPostWork {
    public weak App owner;
    public weak AppPostWork prev;
    public weak AppPostWork next;
    public Action handler;

    public void Run() {
        App app = owner;
        if (app != null) { app.RunPost(this); }
    }
}
