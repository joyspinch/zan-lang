using System;
using System.Collections.Generic;
using Gui;
namespace Gui;
public class NativeLayerReq {
    public App owner;
    public int handle;
    public int x;
    public int y;
    public int w;
    public int h;
    public NativeClipFn apply;
    NativeLayerReq(App owner, int handle, int x, int y, int w, int h,
                   NativeClipFn apply) {
        this.owner = owner;
        this.handle = handle;
        this.x = x;
        this.y = y;
        this.w = w;
        this.h = h;
        this.apply = apply;
    }
}
