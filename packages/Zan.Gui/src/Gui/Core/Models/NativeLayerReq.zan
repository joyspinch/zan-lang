using System;
using System.Collections.Generic;
using Gui;

namespace Gui;


// 一个原生浮层本帧申请占用的矩形，以及下发裁剪结果的回调。
public class NativeLayerReq {
    // 登记它的窗口：一个进程可以开多个窗口，结算某个窗口这一帧时
    // 不能去动别的窗口的浮层。
    public App owner;
    public int handle;
    public int x;
    public int y;
    public int w;
    public int h;
    public NativeClipFn apply;

    NativeLayerReq(App owner, int handle, int x, int y, int w, int h,
                   NativeClipFn apply) {
        this.owner = owner;
        this.handle = handle;
        this.x = x;
        this.y = y;
        this.w = w;
        this.h = h;
        this.apply = apply;
    }
}

