using System;
using System.Collections.Generic;
using Gui;

namespace Gui;

// 动态属性绑定（`:attr` / `data-bind-attr` / `v-bind:attr`）：属性名 -> 表达式
public class BindPropEntry {
    public string prop;
    public string expr;

    BindPropEntry(string prop, string expr) {
        this.prop = prop;
        this.expr = expr;
    }
}

