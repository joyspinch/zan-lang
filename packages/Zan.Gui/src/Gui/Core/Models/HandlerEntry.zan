using System;
using System.Collections.Generic;
using Gui;

namespace Gui;

// 控件的事件（见 UiDoc.Wire）。保持设计器/JSON 与代码解耦：
// 双方都不直接引用对方，只共享字符串名称。
public class HandlerEntry {
    public string name;
    public Action action;
    // 带参变体（`data-arg` / HandleArg 通道）：与 action 并行——
    // 同一名字通常只注册其一；带参槽非空时 Wire 期闭包捕获实参。
    public Action<string> argAction;
    // sender 变体（HandleSender 通道）：Wire 期闭包捕获被接线控件。
    public ControlEvent senderAction;
    // item 变体（HandleItem 通道）：Wire 期将触发控件与当前行原生对象实例透传给业务方法。
    public ControlItemEvent itemAction;

    HandlerEntry(string name, Action action) {
        this.name = name;
        this.action = action;
    }
}

