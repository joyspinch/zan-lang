using System;
using Gui.Backend;

namespace Gui;

// type: 1 矩形/圆角矩形, 2 椭圆, 3 阴影带
public class WindowShapeRegion {
    public int kind;
    public int x;
    public int y;
    public int width;
    public int height;
    public int radius;

    public WindowShapeRegion() {
        this.kind = 1;
        this.x = 0;
        this.y = 0;
        this.width = 0;
        this.height = 0;
        this.radius = 0;
    }

    public WindowShapeRegion(int kind, int x, int y, int width, int height, int radius) {
        this.kind = kind;
        this.x = x;
        this.y = y;
        this.width = width;
        this.height = height;
        this.radius = radius;
    }
}

