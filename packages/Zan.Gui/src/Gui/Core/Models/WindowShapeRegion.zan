using System;
using Gui.Backend;

namespace Gui;

// 窗口形状几何子区域描述（标准化 HTML+CSS / 跨平台几何协议）
// kind: 1 矩形/圆角矩形, 2 椭圆, 3 阴影带
public class WindowShapeRegion {
    public int kind;
    public int x;
    public int y;
    public int width;
    public int height;
    public int radius;

    public WindowShapeRegion() {
        this.kind = WindowShapeKind.RoundedRect;
        this.x = 0;
        this.y = 0;
        this.width = 0;
        this.height = 0;
        this.radius = 0;
    }

    public WindowShapeRegion(int kind, int x, int y, int width, int height, int radius) {
        this.kind = kind;
        this.x = x;
        this.y = y;
        this.width = width;
        this.height = height;
        this.radius = radius;
    }

    public bool IsRoundedRect() {
        return this.kind == WindowShapeKind.RoundedRect;
    }

    public bool IsEllipse() {
        return this.kind == WindowShapeKind.Ellipse;
    }

    public bool IsShadowBand() {
        return this.kind == WindowShapeKind.ShadowBand;
    }

    public WindowShapeRegion Clone() {
        return new WindowShapeRegion(this.kind, this.x, this.y, this.width, this.height, this.radius);
    }

    public WindowShapeRegion Translate(int dx, int dy) {
        return new WindowShapeRegion(this.kind, this.x + dx, this.y + dy, this.width, this.height, this.radius);
    }

    public string ToSpecPart() {
        return Convert.ToString(this.kind) + ","
            + Convert.ToString(this.x) + ","
            + Convert.ToString(this.y) + ","
            + Convert.ToString(this.width) + ","
            + Convert.ToString(this.height) + ","
            + Convert.ToString(this.radius);
    }
}
