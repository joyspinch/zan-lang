using System;
using System.Collections.Generic;
using Gui;

namespace Gui;

// 目标锚点信息实体（消除 anchorId / anchorX / anchorY / anchorW / anchorH / anchorType / anchorSet 平行列表反模式）。
public class HitAnchor {
    public int id;
    public int x;
    public int y;
    public int width;
    public int height;
    public int widgetType;
    public int isSet;

    HitAnchor() {
        this.id = -1;
        this.x = 0;
        this.y = 0;
        this.width = 0;
        this.height = 0;
        this.widgetType = 0;
        this.isSet = 0;
    }

    void Set(int id, int x, int y, int w, int h, int wtype) {
        this.id = id;
        this.x = x;
        this.y = y;
        this.width = w;
        this.height = h;
        this.widgetType = wtype;
        this.isSet = 1;
    }

    void Clear() {
        this.id = -1;
        this.isSet = 0;
    }
}

