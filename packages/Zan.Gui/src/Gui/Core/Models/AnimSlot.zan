using System;
namespace Gui;
public class AnimSlot {
    public int key;
    public int cur;
    public int dst;
    public int src;
    public int startMs;
    public int dur;
    AnimSlot(int k, int c, int d, int s, int st, int du) {
        key = k;
        cur = c;
        dst = d;
        src = s;
        startMs = st;
        dur = du;
    }
}
