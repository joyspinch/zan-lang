using System;
using Gui.Backend;

namespace Gui;

// 六个按索引对齐的 animKeys/animVals/animTarget/animFrom/animStart/animDur
// 并行列表：`键`=稳定 id，`cur`=当前值，`dst`=目标值，
// `src`=补间起始值，`startMs`=补间开始时间，`dur`=时长（毫秒）。
public class AnimSlot {
    public int key;
    public int cur;
    public int dst;
    public int src;
    public int startMs;
    public int dur;

    AnimSlot(int k, int c, int d, int s, int st, int du) {
        key = k;
        cur = c;
        dst = d;
        src = s;
        startMs = st;
        dur = du;
    }
}

