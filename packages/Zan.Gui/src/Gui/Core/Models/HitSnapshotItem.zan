using System;
using System.Collections.Generic;
using Gui;

namespace Gui;

// 整帧命中区快照项实体（消除 snapId / snapX / snapY / snapW / snapH / snapType 平行列表反模式）。
public class HitSnapshotItem {
    public int id;
    public int x;
    public int y;
    public int width;
    public int height;
    public int widgetType;

    HitSnapshotItem(int id, int x, int y, int w, int h, int wtype) {
        this.id = id;
        this.x = x;
        this.y = y;
        this.width = w;
        this.height = h;
        this.widgetType = wtype;
    }

    void Set(int id, int x, int y, int w, int h, int wtype) {
        this.id = id;
        this.x = x;
        this.y = y;
        this.width = w;
        this.height = h;
        this.widgetType = wtype;
    }
}

