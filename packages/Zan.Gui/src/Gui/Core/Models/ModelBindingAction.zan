using System;

namespace Gui;

// The control/queue owns this token; neither weak endpoint retains a binding tree.
public class ModelBindingAction {
    public weak ModelBinder binder;
    public weak Control control;
    public string evt;
    public string hname;
    public string arg;
    public bool active;

    public void Run() {
        ModelBinder owner = this.binder;
        if (!this.active || owner == null) { return; }
        owner.InvokeBindingAction(this);
    }
}
