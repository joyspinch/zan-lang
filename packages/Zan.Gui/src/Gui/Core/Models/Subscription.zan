using System;

namespace Gui;

// 叠加在即时模式控件上。处理器只需注册一次（在帧
// 循环之前，按稳定的整数 key 注册），然后每帧把即时模式的点击
// 通过 <see cref="RaiseIf"/> 桥接进来：
// <code>
// </code>
// 同一 key 的多次 <see cref="On"/> 调用都会被执行（多播）；
// <see cref="Off"/> 清除它们（相当于对整个 key 执行 <c>OnClick -= handler</c>）。
public class Subscription {
    public int key;
    public Action handler;

    Subscription(int key, Action handler) {
        this.key = key;
        this.handler = handler;
    }
}

