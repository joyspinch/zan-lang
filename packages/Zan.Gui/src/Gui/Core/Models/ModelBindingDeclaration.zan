using System;
namespace Gui;
public class ModelBindingDeclaration {
    string path;
    string property;
    bool twoWay;
    public string Path { get { return path; } }
    public string Property { get { return property; } }
    public bool TwoWay { get { return twoWay; } }
    public ModelBindingDeclaration(string modelPath, string targetProperty, bool writeBack) {
        this.path = modelPath;
        this.property = targetProperty;
        this.twoWay = writeBack;
    }
    public static bool ValidPath(string path) {
        if (path == null || path == "") { return false; }
        int segment = 0;
        for (int i = 0; i < path.Length; i = i + 1) {
            int ch = path[i] & 255;
            if (ch == 46) {
                if (segment == 0) { return false; }
                segment = 0;
                continue;
            }
            bool identifier = (ch >= 97 && ch <= 122) || (ch >= 65 && ch <= 90)
                || (ch >= 48 && ch <= 57) || ch == 95 || ch >= 128;
            if (!identifier || (segment == 0 && ch >= 48 && ch <= 57)) { return false; }
            segment = segment + 1;
        }
        return segment > 0;
    }
}
