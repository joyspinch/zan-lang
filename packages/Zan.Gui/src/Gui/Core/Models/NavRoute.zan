using System;
using Gui;
using Gui.Widget;

namespace Gui;

// 一条路由：名字（键）+ 标题（窗口/标签文案）+ 页面工厂 + 进入钩子。
public class NavRoute {
    public string name;
    public string title;
    public NavPageFactory make;
    public NavEnterHandler enter;
    // Embed 出口的存活策略：true（默认）切走保留，false 切走销毁。
    public bool keepAlive;
    // 窗口尺寸（逻辑像素；<=0 用 NavWindow 的 560 缺省）。
    public int winW;
    public int winH;
}

