using System;
using System.Collections.Generic;
using System.Text.Json;
using Gui;
using Gui.Backend;
using Gui.Widget;

namespace Gui;

// 展开行与归属模板关联实体（消除 rowRoots/rowTmpl 平行列表反模式）。
public class ChildExpandedRow {
    public Control rowRoot;
    public Control template;
    public string key;

    ChildExpandedRow(Control rowRoot, Control template) {
        this.rowRoot = rowRoot;
        this.template = template;
        this.key = "";
    }

    ChildExpandedRow(Control rowRoot, Control template, string key) {
        this.rowRoot = rowRoot;
        this.template = template;
        this.key = key;
    }
}

