using System;
using System.Collections.Generic;
using System.Json;
using Gui;
using Gui.Backend;
using Gui.Widget;

namespace Gui;

// 行内控件绑定作用域实体（消除 scopeKeys/scopeVals 平行列表反模式）。
public class ChildScopeBinding {
    public Control control;
    public JsonValue item;

    ChildScopeBinding(Control control, JsonValue item) {
        this.control = control;
        this.item = item;
    }
}

