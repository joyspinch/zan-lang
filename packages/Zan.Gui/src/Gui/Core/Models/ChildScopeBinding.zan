using System;
using System.Collections.Generic;
using System.Json;
using Gui;
using Gui.Backend;
using Gui.Widget;

namespace Gui;

// 行内控件绑定作用域实体（消除 scopeKeys/scopeVals 平行列表反模式）。
// item 升级为通用 object：支持 JsonValue、JsonDocCursor 及强类型 POCO 实体对象。
public class ChildScopeBinding {
    public Control control;
    public object item;
    public string alias;

    public ChildScopeBinding(Control control, object item) {
        this.control = control;
        this.item = item;
        this.alias = "";
    }

    public ChildScopeBinding(Control control, object item, string alias) {
        this.control = control;
        this.item = item;
        this.alias = alias;
    }
}
