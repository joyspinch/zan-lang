using System;
using System.Collections.Generic;
using Gui;
using Gui.Backend;
using Gui.Widget;

namespace Gui;

// 模板原型展开元数据实体（消除 tmplKeys/tmplCounts 平行列表反模式）。
public class ChildTemplateMeta {
    public Control template;
    public int lastCount;
    public string sourcePath;
    public string alias;

    ChildTemplateMeta(Control template, int lastCount) {
        this.template = template;
        this.lastCount = lastCount;
        this.sourcePath = "";
        this.alias = "";
    }

    ChildTemplateMeta(Control template, int lastCount, string sourcePath, string alias) {
        this.template = template;
        this.lastCount = lastCount;
        this.sourcePath = sourcePath;
        this.alias = alias;
    }
}

