using System;
using System.Collections.Generic;

namespace Gui;

// UI 线程的分发队列。
public class UiEvent {
    List<Action> handlers;
    // 平行 sender 通道（S = Sender）：注册在这里的处理器在触发时
    // 收到触发事件的控件。与无参通道相互独立、可混用；同一事件
    // 内先无参后带 sender，各自保持注册顺序。编译器按名称解析
    // 调用（无重载），因此带 sender 通道是平行方法而非重载。
    List<ControlEvent> senderHandlers;

    UiEvent() {
        this.handlers = new List<Action>();
        this.senderHandlers = new List<ControlEvent>();
    }

    // 支持 <c>event += handler</c> 的运算符（追加，多播）。
    static UiEvent op_add(UiEvent self, Action handler) {
        self.handlers.Add(handler);
        return self;
    }

    // 支持 <c>event -= handler</c> 的运算符（移除最近的
    // 相同注册项；若从未添加则为空操作）。
    static UiEvent op_sub(UiEvent self, Action handler) {
        int i = self.handlers.Count - 1;
        while (i >= 0) {
            if (self.handlers[i] == handler) {
                self.handlers.RemoveAt(i);
                return self;
            }
            i = i - 1;
        }
        return self;
    }

    // 注册一个处理器（等同 <c>+=</c>）。
    void Add(Action handler) { handlers.Add(handler); }

    // ---- 平行 sender 通道（S = Sender）----
    // 注册带 sender 的处理器：触发时收到触发本事件的控件。
    // 等价旧通道的 <see cref="Add"/>，存进独立的表。
    void AddS(ControlEvent h) { senderHandlers.Add(h); }

    // 移除 sender 通道最近的相同注册项；从未添加则为空操作。
    void RemoveS(ControlEvent h) {
        int i = senderHandlers.Count - 1;
        while (i >= 0) {
            if (senderHandlers[i] == h) {
                senderHandlers.RemoveAt(i);
                return;
            }
            i = i - 1;
        }
    }

    // sender 通道已注册的处理器数量。
    int CountS() { return senderHandlers.Count; }

    // 两个通道的处理器合计数——"有没有人监听"类门控用它，
    // 只看 <see cref="Count"/> 会漏掉仅注册 sender 通道的控件。
    int CountAll() { return handlers.Count + senderHandlers.Count; }

    // 清空所有处理器。
    void Clear() { handlers = new List<Action>(); }

    // 已注册的处理器数量。
    int Count() { return handlers.Count; }

    // 在当前线程上调用所有处理器。
    void Raise() {
        for (int i = 0; i < handlers.Count; i = i + 1) {
            Action h = handlers[i];
            h();
        }
    }

    // 全通道触发：先调用无参处理器，再把 <paramref name="sender"/>
    // 传给 sender 通道。这是控件事件每帧的标准触发路径；
    // <see cref="Raise"/> 只触发无参通道，供无 sender 语境的
    // 非控件 UiEvent（如 DataTable 的列宽事件）继续使用。
    void RaiseS(Control sender) {
        for (int i = 0; i < handlers.Count; i = i + 1) {
            Action h = handlers[i];
            h();
        }
        for (int i = 0; i < senderHandlers.Count; i = i + 1) {
            ControlEvent h = senderHandlers[i];
            h(sender);
        }
    }

    // 仅当 <paramref name="fire"/> 为 true 时才调用处理器。
    void RaiseIf(bool fire) {
        if (fire) { this.Raise(); }
    }

    // <see cref="RaiseIf"/> 的全通道形式。
    void RaiseIfS(bool fire, Control sender) {
        if (fire) { this.RaiseS(sender); }
    }

    // 将所有处理器调度到 UI 线程的分发队列。可从
    // 任何线程安全调用；处理器稍后在 UI 线程上执行（参见 App.DrainPosts）。
    void Post() {
        for (int i = 0; i < handlers.Count; i = i + 1) {
            Action h = handlers[i];
            Dispatcher.Post(h);
        }
    }

    // <see cref="Post"/> 的全通道形式：sender 在入队时就地捕获，
    // 处理器稍后在 UI 线程上收到该控件。
    void PostS(Control sender) {
        for (int i = 0; i < handlers.Count; i = i + 1) {
            Action h = handlers[i];
            Dispatcher.Post(h);
        }
        for (int i = 0; i < senderHandlers.Count; i = i + 1) {
            ControlEvent h = senderHandlers[i];
            Dispatcher.Post(() => { h(sender); });
        }
    }
}

// 常用控件事件的可复用集合。保留式控件内嵌
// 一个 <c>WidgetEvents</c> 字段，每帧调用一次 <see cref="Fire"/>
// （在渲染完并注册命中区域之后），而不必手动
// 推导每次状态转换，应用代码因此呈声明式风格：
// <code>
// btn.On.Enter += () =&gt; { ... };
// btn.On.Click += () =&gt; { ... };
// </code>
// 触屏安全：在触摸屏上，单次触摸会作为合成的鼠标
// 事件序列到达，因此 <c>Click</c> 相当于轻点，<c>MouseDown</c>/<c>MouseUp</c> 框住
// 整个触摸过程；没有真正的悬停，所以 <c>Enter</c>/<c>Leave</c> 只在按压期间触发
// 且不会误触发。
