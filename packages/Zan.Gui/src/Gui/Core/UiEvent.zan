using System;
using System.Collections.Generic;
namespace Gui;
public class UiEvent {
    List<Action> handlers;
    List<ControlEvent> senderHandlers;
    public static UiEvent op_add(UiEvent self, Action handler) { self.Add(handler); return self; }
    public static UiEvent op_sub(UiEvent self, Action handler) { self.Remove(handler); return self; }
    public void Add(Action handler) {
        if (handlers == null) { handlers = new List<Action>(); }
        handlers.Add(handler);
    }
    public void Remove(Action handler) {
        if (handlers == null) { return; }
        int i = handlers.Count - 1;
        while (i >= 0) {
            if (handlers[i] == handler) {
                handlers.RemoveAt(i);
                return;
            }
            i = i - 1;
        }
    }
    public void AddS(ControlEvent h) {
        if (senderHandlers == null) { senderHandlers = new List<ControlEvent>(); }
        senderHandlers.Add(h);
    }
    public void RemoveS(ControlEvent h) {
        if (senderHandlers == null) { return; }
        int i = senderHandlers.Count - 1;
        while (i >= 0) {
            if (senderHandlers[i] == h) {
                senderHandlers.RemoveAt(i);
                return;
            }
            i = i - 1;
        }
    }
    public int CountS() {
        if (senderHandlers == null) { return 0; }
        return senderHandlers.Count;
    }
    public int CountAll() { return this.Count() + this.CountS(); }
    public void Clear() {
        handlers = null;
        senderHandlers = null;
    }
    public int Count() {
        if (handlers == null) { return 0; }
        return handlers.Count;
    }
    public void Raise() {
        for (int i = 0; handlers != null && i < handlers.Count; i = i + 1) {
            Action h = handlers[i];
            h();
        }
    }
    public void RaiseS(Control sender) {
        this.Raise();
        for (int i = 0; senderHandlers != null && i < senderHandlers.Count; i = i + 1) {
            ControlEvent h = senderHandlers[i];
            h(sender);
        }
    }
    public void RaiseIf(bool fire) {
        if (fire) { this.Raise(); }
    }
    public void RaiseIfS(bool fire, Control sender) {
        if (fire) { this.RaiseS(sender); }
    }
    public void Post() {
        for (int i = 0; handlers != null && i < handlers.Count; i = i + 1) {
            Action h = handlers[i];
            Dispatcher.Post(h);
        }
    }
    public void PostS(Control sender) {
        if (this.CountAll() == 0) { return; }
        App app = null;
        if (sender != null) { app = sender.FindApp(); }
        for (int i = 0; handlers != null && i < handlers.Count; i = i + 1) {
            Action h = handlers[i];
            if (app != null) { app.Post(h); }
            else { Dispatcher.Post(h); }
        }
        if (this.CountS() > 0) { this.PostSenderHandlers(app, sender); }
    }
    private void PostSenderHandlers(App app, Control sender) {
        for (int i = 0; senderHandlers != null && i < senderHandlers.Count; i = i + 1) {
            ControlEvent h = senderHandlers[i];
            Action invoke = () => { h(sender); };
            if (app != null) { app.Post(invoke); }
            else { Dispatcher.Post(invoke); }
        }
    }
}
