using System;
using System.Collections.Generic;
using Gui;
using Gui.Backend;
using Gui.Widget;

namespace Gui;

// 保留模式组件树（与即时模式控件共存）。
// 每个节点都是一个 `Control`：有稳定的 `name`、父节点、有序的
// 子节点列表、停靠提示和已解析的边界矩形。容器用 `Add` 追加
// 子节点；任何节点都可用 `Find(name)` 定位后代。
// 布局是 WinForms 风格的停靠（见 `Arrange`）：停靠的子节点吸附到
// 边缘并按插入顺序占用空间，`Fill` 子节点占据剩余部分，
// `Manual` 子节点位于父节点内的显式偏移处。绘制是
// 多态的——子类重写 `OnPaint`，框架通过 `Paint` 递归，
// 把每个子树裁剪到父节点的矩形内，内容不会
// 溢出（复用原生裁剪栈）。
// 注意：基类方法名刻意不寻常（Paint/Arrange/
// MeasureTree/InitControl/OnPaint/OnMeasure），以免与
// 继承 Control 的控件自身的方法冲突——编译器仅按名称
// 解析调用（无重载），因此子类若以不同签名复用基类名称
// 会编译出错。
public partial class Control {
    string name;
    // 0 手动，1 顶部，2 底部，3 左侧，4 右侧，5 填充。
    int dock;
    // 通过 With() 添加的子节点的自动流式布局：0 无，1 列，2 行。
    // 容器（见 Panel.Column/Row）设置此项，使每个 With() 子节点
    // 自动沿流式布局轴停靠。
    int layout;
    // 为 true 时，此节点应增长以填满其流式父节点的
    // 剩余主轴空间（dock == fill），覆盖流式布局的默认停靠。
    bool grow;
    // 停靠时使用的首选主轴尺寸（top/bottom 为高度，
    // left/right 为宽度）。对 Fill 子节点忽略。控件的 OnMeasure
    // 通常根据主题设置这些值。
    int prefW;
    int prefH;
    // dock == 0 时在父内容框内的手动偏移。
    int mx;
    int my;
    int padL;
    int padT;
    int padR;
    int padB;
    // 由 Pad()/Padding() 设置：调用方固定了内边距，因此控件的
    // OnMeasure 不得用其主题默认值覆盖它。
    bool padSet;
    int marL;
    int marT;
    int marR;
    int marB;
    bool marSet;
    // 由 Prefer()（以及 UiDoc 的 `width`/`height`）设置：调用方固定了
    // 首选尺寸，因此根据子节点自测量的容器
    // 会保留给定的那个轴。
    bool prefSet;
    // 该轴的 prefW/prefH 是容器按内容补齐的（MeasureDocked /
    // MeasureFlexContent），不是作者或控件自定的。这类值每帧
    // 先清零再重算：首帧样式或缩放还没就位时算出的错值，靠
    // 钉死在 20px，33px 的徽标被行裁掉底部）。
    bool fillW;
    bool fillH;
    // 文档声明尺寸均为逻辑像素，度量时统一按 DPI 缩放换算。
    int logW;
    int logH;
    // 作者（设计文档）声明的高度（换算后的设备像素，0 = 未声明）。
    // 声明高度优先于样式表的 height（CSS：内联 > 样式表）：
    // 否则设计文档里的字段高度被皮肤的默认高度（`input { height: 32px }`）
    // 压住——设计器里改了高度不生效，行高也按样式表的高度排，
    // 多行文本 / 上传这类"皮肤不定高"的类型被压成一行高，
    // 和下一行叠在一起。
    // 只有走 DeclareHeight 通道（设计文档 → 运行时/预览）才置位：
    // 代码里手搭的 logH/logW 仍按"测量偏好"处理，尺寸档照旧说话。
    int declaredH;
    bool authorSized;
    int logGap;
    int logPad;
    int logMar;
    int logX;
    int logY;
    bool logPlaceSet;
    int gap;
    ControlExtra extra;

    ControlExtra EnsureExtra() {
        if (this.extra == null) {
            this.extra = new ControlExtra();
        }
        return this.extra;
    }

    public bool designFloat {
        get { return this.extra != null ? this.extra.designFloat : false; }
        set { this.EnsureExtra().designFloat = value; }
    }
    public int designAnchor {
        get { return this.extra != null ? this.extra.designAnchor : 0; }
        set { this.EnsureExtra().designAnchor = value; }
    }
    public bool layoutFlow {
        get { return this.extra != null ? this.extra.layoutFlow : false; }
        set { this.EnsureExtra().layoutFlow = value; }
    }
    public string designCss {
        get { return this.extra != null ? this.extra.designCss : ""; }
        set { this.EnsureExtra().designCss = value; }
    }
    public int flexWrapMain {
        get { return this.extra != null ? this.extra.flexWrapMain : 0; }
        set { this.EnsureExtra().flexWrapMain = value; }
    }
    public int flexMeasMain {
        get { return this.extra != null ? this.extra.flexMeasMain : 0; }
        set { this.EnsureExtra().flexMeasMain = value; }
    }
    public int hintWrapW {
        get { return this.extra != null ? this.extra.hintWrapW : 0; }
        set { this.EnsureExtra().hintWrapW = value; }
    }
    public List<FloatIntrusion> hostFloats {
        get { return this.extra != null ? this.extra.hostFloats : null; }
        set { this.EnsureExtra().hostFloats = value; }
    }
    bool visible;
    // 画布坐标下的已解析边界（由 Arrange 设置）。
    int bx;
    int by;
    int bw;
    int bh;
    // CSS 滚动容器（P6）：当前滚动偏移与最近一次排布出的内容延伸
    // （padding-box 坐标，px）。偏移在 Arrange 期按延伸钳制并把
    // 子树平移 -scrollY / -scrollX；交互状态（滚轮/拖动）惰性建。
    int scrollY;
    int scrollExtent;
    // 水平轴（P6 横滚）：overflow-x auto/scroll 与纵向同语义。
    int scrollX;
    int scrollExtentX;
    ScrollState scroll;
    weak Control parent;
    List<Control> children;
    private static List<EventBinding> emptyEvents = new List<EventBinding>();
    // 供设计器/序列化器使用的事件处理器绑定：把事件名
    // （见 Events()）映射到处理器标识符。未绑定时为空。
    public List<EventBinding> events {
        get {
            if (this.extra != null && this.extra.events != null) {
                return this.extra.events;
            }
            return Control.emptyEvents;
        }
        set { this.EnsureExtra().events = value; }
    }
    // 每个控件通用的事件包（指针/焦点/键盘/触摸/拖拽），
    // 所有控件继承。拥有稳定 id 的交互控件
    // 自行接线（注册命中区域后调用 On.Fire(app, id)）；
    // 其余控件由 RenderTree 通过 FireCommon 接线。
    WidgetEvents On;
    // 为不自持 id 的控件（容器和仅显示控件）提供支撑 `On` 的稳定 id。
    // 首次使用时分配；0 = 从未需要。
    int commonId;
    // 由自行注册命中区域并调用 On.Fire 的控件（Button、Input 等）设置，
    // 这样 RenderTree 就不会在另一个 id 上第二次
    // 触发该事件包。
    bool wiresOwnEvents;
    // 由 RenderTree 触发的生命周期事件：Paint 在节点每帧绘制时触发，
    // Resize 在解析尺寸变化时触发，Show/Hide 在可见性翻转时触发。
    public UiEvent Paint {
        get {
            ControlExtra e = this.EnsureExtra();
            if (e.Paint == null) { e.Paint = new UiEvent(); }
            return e.Paint;
        }
        set { this.EnsureExtra().Paint = value; }
    }
    public UiEvent Resize {
        get {
            ControlExtra e = this.EnsureExtra();
            if (e.Resize == null) { e.Resize = new UiEvent(); }
            return e.Resize;
        }
        set { this.EnsureExtra().Resize = value; }
    }
    public UiEvent Show {
        get {
            ControlExtra e = this.EnsureExtra();
            if (e.Show == null) { e.Show = new UiEvent(); }
            return e.Show;
        }
        set { this.EnsureExtra().Show = value; }
    }
    public UiEvent Hide {
        get {
            ControlExtra e = this.EnsureExtra();
            if (e.Hide == null) { e.Hide = new UiEvent(); }
            return e.Hide;
        }
        set { this.EnsureExtra().Hide = value; }
    }
    int lastBw;
    int lastBh;
    bool lastVisible;
    bool everLaidOut;
    public string bindPath {
        get { return this.extra != null ? this.extra.bindPath : ""; }
        set { this.EnsureExtra().bindPath = value; }
    }
    public string bindProp {
        get { return this.extra != null ? this.extra.bindProp : ""; }
        set { this.EnsureExtra().bindProp = value; }
    }
    public string bindIf {
        get { return this.extra != null ? this.extra.bindIf : ""; }
        set { this.EnsureExtra().bindIf = value; }
    }
    public string bindClass {
        get { return this.extra != null ? this.extra.bindClass : ""; }
        set { this.EnsureExtra().bindClass = value; }
    }
    public string bindDisabled {
        get { return this.extra != null ? this.extra.bindDisabled : ""; }
        set { this.EnsureExtra().bindDisabled = value; }
    }
    public List<BindPropEntry> bindProps {
        get { return this.extra != null ? this.extra.bindProps : null; }
        set { this.EnsureExtra().bindProps = value; }
    }
    public string handlerArg {
        get { return this.extra != null ? this.extra.handlerArg : ""; }
        set { this.EnsureExtra().handlerArg = value; }
    }
    public string slotName {
        get { return this.extra != null ? this.extra.slotName : ""; }
        set { this.EnsureExtra().slotName = value; }
    }
    public bool bindLazy {
        get { return this.extra != null ? this.extra.bindLazy : false; }
        set { this.EnsureExtra().bindLazy = value; }
    }
    public bool bindNumber {
        get { return this.extra != null ? this.extra.bindNumber : false; }
        set { this.EnsureExtra().bindNumber = value; }
    }
    public bool bindTrim {
        get { return this.extra != null ? this.extra.bindTrim : false; }
        set { this.EnsureExtra().bindTrim = value; }
    }
    public string bindTpl {
        get { return this.extra != null ? this.extra.bindTpl : ""; }
        set { this.EnsureExtra().bindTpl = value; }
    }
    // 控件关联的原生业务对象/行项实例（由模板循环展开自动注入，供 @click 处理器与业务直接消费）
    public object item;
    // 循环展开作用域别名（如 "row"，O(1) 直通寻址）
    public string itemAlias;
    public string baseClass {
        get { return this.extra != null ? this.extra.baseClass : ""; }
        set { this.EnsureExtra().baseClass = value; }
    }
    public string a11yRole {
        get { return this.extra != null ? this.extra.a11yRole : ""; }
        set { this.EnsureExtra().a11yRole = value; }
    }
    public string a11yLabel {
        get { return this.extra != null ? this.extra.a11yLabel : ""; }
        set { this.EnsureExtra().a11yLabel = value; }
    }

    // 声明式无障碍与自动化测试语义绑定（可链式调用）。
    public Control A11y(string role, string label) {
        this.a11yRole = role;
        this.a11yLabel = label;
        return this;
    }

    // 解析有效无障碍角色
    public string EffectiveA11yRole(string fallback) {
        if (this.extra != null && this.extra.a11yRole.Length > 0) {
            return this.extra.a11yRole;
        }
        return fallback;
    }

    // 解析有效无障碍标签
    public string EffectiveA11yLabel(string fallback) {
        if (this.extra != null && this.extra.a11yLabel.Length > 0) {
            return this.extra.a11yLabel;
        }
        return fallback;
    }
    // 可选样式类（JSON `class`），供 StyleSheet 通过 `.class` 选择器
    // 把声明级联到此控件。空 = 无。
    // 以空格分隔的 CSS 类：`btn.Class = "primary small";`（直接赋值，
    // 无 setter）——控件拥有的每个视觉变体都对应其中一个类。
    string Class;
    // 双向禁用标志，沿树向下继承：`grp.Disabled = vm.busy;`
    // 会置灰并禁用整个子树（见 IsDisabled）。
    Binding<bool> Disabled;
    StyleBox computedStyle;
    int computedStyleGen;
    // computedStyle 是在哪个主题度量缩放下解析的（App.metricsScale）：
    // 设计器预览会临时整体缩放度量，换了缩放的缓存不能复用。
    int computedStyleScale;
    string computedStyleType;
    string computedStyleClass;
    // 解析时**实际传入**的类（借用别的组件外观时与控件自身的 Class
    // 不同）。旧实现只记控件自身的 Class，缓存键里因此少了这一维：
    // 同一控件用同一个类型、两个不同类各解析一次，第二次会拿到第一次
    // 的盒子。
    string computedStyleCls;
    string computedStyleId;
    // 记住 computedStyle 是按哪个状态解析出来的（-1 = 由
    // 悬停/按下插值出的过渡态，不可复用）。测量按常态进行，
    // 有了它，一帧里没有变化的节点就不必重新走一遍样式解析。
    int computedStyleState;
    // computedStyle 是在哪个树上下文签名（Style.CtxSig）下解析的：
    // 组合器/结构性伪类让样式随节点位置变化，控件被挪到别的容器后
    // 必须重解析。"" = 无树上下文（immediate 或表内无此类规则）。
    string computedStyleCtx;
    // Kind() 的小写形式（默认的类型选择器）。每帧每节点都要问
    // 好几次，现算就是每次一个新字符串。
    string styleTypeLower;
    bool styleSurfaceOwned;

    // --- 类 CSS 样式层（全 0 = 未设置）。PaintStyleBox 对表面生效，
    // 文本控件对颜色/字体生效。可通过流式的
    // StyleSheet/皮肤级联。颜色打包为 0xAARRGGBB 整数（同 Theme）。
    public int styleBg {
        get { return this.extra != null ? this.extra.styleBg : 0; }
        set { this.EnsureExtra().styleBg = value; }
    }
    public int styleBgTo {
        get { return this.extra != null ? this.extra.styleBgTo : 0; }
        set { this.EnsureExtra().styleBgTo = value; }
    }
    public int styleRadius {
        get { return this.extra != null ? this.extra.styleRadius : 0; }
        set { this.EnsureExtra().styleRadius = value; }
    }
    public int styleCorners {
        get { return this.extra != null ? this.extra.styleCorners : 0; }
        set { this.EnsureExtra().styleCorners = value; }
    }
    public int styleBorderColor {
        get { return this.extra != null ? this.extra.styleBorderColor : 0; }
        set { this.EnsureExtra().styleBorderColor = value; }
    }
    public int styleBorderWidth {
        get { return this.extra != null ? this.extra.styleBorderWidth : 0; }
        set { this.EnsureExtra().styleBorderWidth = value; }
    }
    public int styleShadow {
        get { return this.extra != null ? this.extra.styleShadow : 0; }
        set { this.EnsureExtra().styleShadow = value; }
    }
    public int styleShadowDy {
        get { return this.extra != null ? this.extra.styleShadowDy : 0; }
        set { this.EnsureExtra().styleShadowDy = value; }
    }
    public int styleColor {
        get { return this.extra != null ? this.extra.styleColor : 0; }
        set { this.EnsureExtra().styleColor = value; }
    }
    public int styleFontPx {
        get { return this.extra != null ? this.extra.styleFontPx : 0; }
        set { this.EnsureExtra().styleFontPx = value; }
    }
    public int styleTransitionMs {
        get { return this.extra != null ? this.extra.styleTransitionMs : 0; }
        set { this.EnsureExtra().styleTransitionMs = value; }
    }
    public string inlineStyleCss {
        get { return this.extra != null ? this.extra.inlineStyleCss : ""; }
        set { this.EnsureExtra().inlineStyleCss = value; }
    }

    // 所有子类在工厂/构造函数中调用的基础初始化方法。
    void InitControl(string n, int d) {
        name = n;
        dock = d;
        prefW = 0;
        prefH = 0;
        mx = 0;
        my = 0;
        padL = 0;
        padT = 0;
        padR = 0;
        padB = 0;
        padSet = false;
        marL = 0;
        marT = 0;
        marR = 0;
        marB = 0;
        marSet = false;
        prefSet = false;
        logW = 0;
        logH = 0;
        logGap = 0 - 1;
        logPad = 0 - 1;
        logMar = 0 - 1;
        logX = 0;
        logY = 0;
        logPlaceSet = false;
        gap = 0;
        visible = true;
        bx = 0;
        by = 0;
        bw = 0;
        bh = 0;
        parent = null;
        children = new List<Control>();
        On = new WidgetEvents();
        commonId = 0;
        wiresOwnEvents = false;
        lastBw = 0;
        lastBh = 0;
        lastVisible = false;
        everLaidOut = false;
        layout = 0;
        grow = false;
        Class = "";
        Disabled = false;
        computedStyle = null;
        computedStyleGen = 0 - 1;
        computedStyleScale = 0 - 1;
        computedStyleType = "";
        computedStyleClass = "";
        computedStyleCls = "";
        computedStyleId = "";
        computedStyleState = 0 - 1;
        computedStyleCtx = "";
        styleTypeLower = "";
        styleSurfaceOwned = false;
    }

    // --- 类 CSS 流式样式设置器（可链式调用）。名称在整个控件集合中唯一，
    // 不会与子类方法冲突。---
    // 设置纯色背景并清掉渐变终点（styleBg = c，styleBgTo = 0；
    // 传 0 即回到未设置），并使样式缓存失效；返回 this。
    Control Bg(int c) { styleBg = c; styleBgTo = 0; computedStyle = null; return this; }
    // 设置垂直渐变背景（top -> bottom），并使样式缓存失效；返回 this。
    Control Gradient(int top, int bottom) { styleBg = top; styleBgTo = bottom; computedStyle = null; return this; }
    // 设置圆角半径（px），并使样式缓存失效；返回 this。
    Control Radius(int r) { styleRadius = r; computedStyle = null; return this; }
    // 设置起效圆角掩码（Corner.TL/TR/BL/BR 组合），并使样式缓存失效；返回 this。
    Control Corners(int m) { styleCorners = m; computedStyle = null; return this; }
    // 获取当前起效圆角掩码。
    int Corners() { return styleCorners; }
    // 设置边框颜色与宽度（px），并使样式缓存失效；返回 this。
    Control Border(int color, int w) { styleBorderColor = color; styleBorderWidth = w; computedStyle = null; return this; }
    // 设置阴影颜色与垂直偏移（px），并使样式缓存失效；返回 this。
    Control Shadow(int color, int dy) { styleShadow = color; styleShadowDy = dy; computedStyle = null; return this; }
    // 设置文字/前景颜色，并使样式缓存失效；返回 this。
    Control TextColor(int c) { styleColor = c; computedStyle = null; return this; }
    // 设置字号（px），并使样式缓存失效；返回 this。
    Control FontPx(int px) { styleFontPx = px; computedStyle = null; return this; }
    // 设置状态过渡时长（毫秒），并使样式缓存失效；返回 this。
    Control Transition(int ms) { styleTransitionMs = ms; computedStyle = null; return this; }


    // 生效的文本颜色：设置了 CSS `styleColor` 则用它，否则用控件
    // 从其变体/主题解析的回退值。文本控件调用此方法。
    public int StyleTextColor(int fallback) {
        if (styleColor != 0) { return styleColor; }
        return fallback;
    }

    // 生效的字体大小：设置了 CSS `styleFontPx` 则用它，否则用回退值。
    public int StyleFontSize(int fallback) {
        if (styleFontPx != 0) { return styleFontPx; }
        return fallback;
    }

    // 生效的 CSS 过渡时长（毫秒）：控件的 `transition`
    // （styleTransitionMs）已设置时用它，否则用 `fallback`。控件把它传给
    // Ui.HoverLevelMs/PressLevelMs，使 `transition` 属性真正
    // 决定悬停/按下状态通过 App.AnimTo 交叉淡化的速度。
    public int TransitionMs(int fallback) {
        if (computedStyle != null && computedStyle.transitionMs >= 0) {
            return computedStyle.transitionMs;
        }
        if (styleTransitionMs > 0) { return styleTransitionMs; }
        return fallback;
    }

    // 此控件响应的 CSS 类型选择器。默认为其 Kind，但
    // Kind 指代表面而实例仅是布局节点的控件会覆盖它，
    // 这样针对表面的样式表规则
    // （内边距、背景、模糊）不会作用于布局节点。
    public virtual string StyleType() {
        if (styleTypeLower == "") { styleTypeLower = this.Kind().ToLower(); }
        return styleTypeLower;
    }


    // CSS 属性选择器的取值源（`[type="text"]`/`[data-x]`/`[href]`）。
    // 基类只认 `id`（=设计器名 name）；带真实属性表的节点（HTML 层
    // 的 Element）覆写它。返回 "" 表示属性不存在——存在性条件
    // `[attr]` 不命中，与"没有树上下文就不命中"同一约定。
    public virtual string CssAttr(string key) {
        if (key == "id") { return name; }
        return "";
    }

    // 属性存在性（`[attr]` 无操作符条件）：与 CssAttr 并行的口径——
    // 属性可以在表里但值为空串（HTML 布尔属性 `<div hidden>`），
    // 那种情况存在性要成立，而取值比较对空串本就没有意义。
    public virtual bool CssHasAttr(string key) {
        if (key == "id") { return name != ""; }
        return false;
    }

    // 按本控件的 StyleType/Class/name 解析 `state` 状态的样式
    // （含 inline 覆盖），并记入 computedStyle。虚方法：Element
    // 覆写以在宿主盒解析后顺带取 ::before/::after 伪文本。
    public virtual StyleBox ResolveStyle(App app, int state) {
        if (computedStyle != null && computedStyleState == state
            && this.ComputedStyleCurrent(app)) {
            return computedStyle;
        }
        return this.ResolveStyleAs(app, this.StyleType(), Class, state);
    }

    // 控件解析**自己**样式的统一入口（常态）。
    //
    // 控件作者不要手写 `Style.Of(app, "button", Class, ...)`：那条路
    // 漏掉两件事——行内样式（控件上显式设的 Bg/Radius/Font）不生效，
    // 每帧还要重新克隆一份 StyleBox。走基类则两者都统一，类型名
    // 也由 StyleType() 给出，不必在每个控件里手抄一遍。
    public StyleBox Box(App app) {
        return this.BoxState(app, Style.SNormal());
    }

    // 同上，但可指定状态位（常态/悬停/按下/选中/禁用）。
    public StyleBox BoxState(App app, int state) {
        return this.ResolveStyleCached(app, this.StyleType(), Class, state);
    }

    // ResolveStyle 的显式类型/类版本（部件或借用其他类型外观的
    // 控件用），id 仍取本控件的 name。
    StyleBox ResolveStyleAs(App app, string type, string cls, int state) {
        StyleBox box = Style.Full(app, type, cls, name, state);
        Style.Inline(box, this);
        computedStyle = box;
        computedStyleGen = app.bgThemeGen;
        computedStyleScale = app.metricsScale;
        computedStyleType = type;
        computedStyleClass = Class;
        computedStyleCls = cls;
        computedStyleId = name;
        computedStyleState = state;
        computedStyleCtx = Style.ContextSig(app);
        return box;
    }

    // 解析**某个类型的基线外观**：不带本控件的 Class、不带 id、
    // 不套行内覆盖。
    //
    // 部件表面走这条——列表行、树行、滚动条轨道、弹层、分割线这些
    // 是"别的类型"的外观：套上本控件的 Class 会串味（列表写成
    // `.primary` 就把每一行都染成主色），套行内覆盖同样不该发生。
    // 但它们是**样式解析**，仍归基类一处出口：控件作者不再手写
    // `Style.Of(app, "listrow", "", ...)`，也不必各自判断要不要
    // 带 Class——规则写在这里，调用方只说"要哪个类型的哪一档"。
    //
    // 静态：非 Control 的宿主（OverlayPopup/ScrollState/DockHost…）
    // 也要解析部件表面，用 `Control.BareBox(app, ...)`。
    public static StyleBox BareBox(App app, string type, int state) {
        return Style.Full(app, type, "", "", state);
    }

    // 与 ResolveStyleAs 相同，但上一次解析仍然有效时直接复用它。
    // 控件在一帧里往往要问同一份样式两次（OnMeasure 一次、OnPaint
    // 一次），每次都要拼缓存键、查表并克隆一个 StyleBox。
    StyleBox ResolveStyleCached(App app, string type, string cls, int state) {
        if (computedStyle != null && computedStyleGen == app.bgThemeGen
            && computedStyleScale == app.metricsScale
            && computedStyleState == state && computedStyleType == type
            && computedStyleClass == Class && computedStyleCls == cls
            && computedStyleId == name
            && computedStyleCtx == Style.ContextSig(app)) {
            return computedStyle;
        }
        return this.ResolveStyleAs(app, type, cls, state);
    }

    // 解析 hover/press/focus 三态缓动样式（Style.EasedId，含 inline
    // 覆盖），selected 为锁定选中位。结果是过渡混合态，不可作常态
    // 缓存复用（computedStyleState 记为 -1）。
    StyleBox ResolveEasedStyleAs(App app, int id, string type, string cls,
                                 bool disabled, bool selected) {
        StyleBox box = Style.EasedId(app, id, type, cls, name, disabled, selected);
        Style.Inline(box, this);
        computedStyle = box;
        computedStyleGen = app.bgThemeGen;
        computedStyleScale = app.metricsScale;
        computedStyleType = type;
        computedStyleClass = Class;
        computedStyleCls = cls;
        computedStyleId = name;
        computedStyleState = 0 - 1;
        computedStyleCtx = Style.ContextSig(app);
        return box;
    }

    // ResolveEasedStyleAs 的按矩形版本：交互程度按 (x, y, w, h)
    // 测量（Ui.*LevelMsIn），用于命中区域与绘制矩形不一致的控件。
    StyleBox ResolveEasedStyleAsIn(App app, int id, string type, string cls,
                                   bool disabled, bool selected,
                                   int x, int y, int w, int h) {
        StyleBox box = Style.EasedIdIn(app, id, type, cls, name, disabled,
                                       selected, x, y, w, h);
        Style.Inline(box, this);
        computedStyle = box;
        computedStyleGen = app.bgThemeGen;
        computedStyleScale = app.metricsScale;
        computedStyleType = type;
        computedStyleClass = Class;
        computedStyleCls = cls;
        computedStyleId = name;
        computedStyleState = 0 - 1;
        computedStyleCtx = Style.ContextSig(app);
        return box;
    }

    // 在 latched（选中/勾选一类锁定状态位）的 on/off 两套缓动样式
    // 之间按 progress（0..1000 千分比）混合——开关/滑块类控件由
    // 位置驱动外观。同样记为过渡态（不可作常态缓存）。
    StyleBox ResolveEasedLatchedStyleAs(App app, int id, string type, string cls,
                                        bool disabled, int latched, int progress) {
        StyleBox off = Style.EasedStateId(app, id, type, cls, name, disabled, 0);
        StyleBox on = Style.EasedStateId(app, id, type, cls, name, disabled, latched);
        Style.Inline(off, this);
        Style.Inline(on, this);
        StyleBox box = StyleBox.Blend(off, on, progress);
        computedStyle = box;
        computedStyleGen = app.bgThemeGen;
        computedStyleScale = app.metricsScale;
        computedStyleType = type;
        computedStyleClass = Class;
        computedStyleCls = cls;
        computedStyleId = name;
        computedStyleState = 0 - 1;
        computedStyleCtx = Style.ContextSig(app);
        return box;
    }

    // ResolveEasedLatchedStyleAs 的按矩形版本。
    StyleBox ResolveEasedLatchedStyleAsIn(App app, int id, string type, string cls,
                                          bool disabled, int latched, int progress,
                                          int x, int y, int w, int h) {
        StyleBox off = Style.EasedStateIdIn(app, id, type, cls, name, disabled,
                                            0, x, y, w, h);
        StyleBox on = Style.EasedStateIdIn(app, id, type, cls, name, disabled,
                                           latched, x, y, w, h);
        Style.Inline(off, this);
        Style.Inline(on, this);
        StyleBox box = StyleBox.Blend(off, on, progress);
        computedStyle = box;
        computedStyleGen = app.bgThemeGen;
        computedStyleScale = app.metricsScale;
        computedStyleType = type;
        computedStyleClass = Class;
        computedStyleCls = cls;
        computedStyleId = name;
        computedStyleState = 0 - 1;
        computedStyleCtx = Style.ContextSig(app);
        return box;
    }

    // 解析本控件 `StyleType::part` 部件的样式（无 inline 覆盖）。
    StyleBox ResolvePart(App app, string part, string fallbackType, int state) {
        return this.ResolvePartAs(app, this.StyleType(), part,
                                  fallbackType, Class, state);
    }

    // 解析 `type::part` 部件样式：fallbackType 非空时提供整套
    // 回退规则（见 Style.Part）；id 取本控件的 name。
    StyleBox ResolvePartAs(App app, string type, string part,
                           string fallbackType, string cls, int state) {
        return Style.Part(app, type, part, fallbackType, cls, name, state);
    }

    // 部件版三态缓动解析（Style.EasedPartId，无 inline 覆盖）。
    StyleBox ResolveEasedPartAs(App app, int id, string type, string part,
                                string fallbackType, string cls,
                                bool disabled, bool selected) {
        return Style.EasedPartId(app, id, type, part, fallbackType, cls, name,
                                 disabled, selected);
    }

    // 部件版三态缓动解析的按矩形版本（无 inline 覆盖）。
    StyleBox ResolveEasedPartAsIn(App app, int id, string type, string part,
                                  string fallbackType, string cls,
                                  bool disabled, bool selected,
                                  int x, int y, int w, int h) {
        return Style.EasedPartIdIn(app, id, type, part, fallbackType, cls, name,
                                   disabled, selected, x, y, w, h);
    }

    // 部件版 latched 混合解析（无 inline 覆盖）。
    StyleBox ResolveEasedLatchedPartAs(App app, int id, string type, string part,
                                       string fallbackType, string cls,
                                       bool disabled, int latched, int progress) {
        StyleBox off = Style.EasedPartStateId(app, id, type, part, fallbackType,
                                              cls, name, disabled, 0);
        StyleBox on = Style.EasedPartStateId(app, id, type, part, fallbackType,
                                             cls, name, disabled, latched);
        return StyleBox.Blend(off, on, progress);
    }

    // 部件版 latched 混合解析的按矩形版本（无 inline 覆盖）。
    StyleBox ResolveEasedLatchedPartAsIn(App app, int id, string type, string part,
                                         string fallbackType, string cls,
                                         bool disabled, int latched, int progress,
                                         int x, int y, int w, int h) {
        StyleBox off = Style.EasedPartStateIdIn(
            app, id, type, part, fallbackType, cls, name, disabled, 0,
            x, y, w, h);
        StyleBox on = Style.EasedPartStateIdIn(
            app, id, type, part, fallbackType, cls, name, disabled, latched,
            x, y, w, h);
        return StyleBox.Blend(off, on, progress);
    }

    // computedStyle 是否仍对当前主题代次/度量缩放/类型/类/名有效
    // （不比对状态位）。Bg()/Class 等改动使缓存失效后为 false。
    bool ComputedStyleCurrent(App app) {
        string type = this.StyleType();
        return computedStyle != null && computedStyleGen == app.bgThemeGen
            && computedStyleScale == app.metricsScale
            && computedStyleType == type && computedStyleClass == Class
            && computedStyleCls == Class
            && computedStyleId == name
            && computedStyleCtx == Style.ContextSig(app);
    }

    // 生效宽度：样式的声明宽度（px 或已解析的百分比）夹到
    // min/max 后返回；无样式时回退测量偏好 prefW。
    int StyleWidth() {
        if (computedStyle == null) { return prefW; }
        return computedStyle.ClampW(computedStyle.WidthOr(prefW));
    }

    // 生效高度：同 StyleWidth，沿高度轴（回退 prefH）。
    int StyleHeight() {
        if (computedStyle == null) { return prefH; }
        return computedStyle.ClampH(computedStyle.HeightOr(prefH));
    }

    // 内容框的左侧内边距。显式的 Pad()/Padding() 优先于
    // 解析样式携带的主题默认值（自由画布根节点将其固定为 0）；
    // 未调用时由样式表决定。
    int StylePadL() {
        if (padSet) { return padL; }
        if (computedStyle != null) { return computedStyle.PadLOr(padL); }
        return padL;
    }

    // 内容框的顶部内边距。之所以是虚方法，是因为绘制自身
    // 装饰的容器（如 Card 的标题行）无论样式表如何规定
    // 内边距都必须为此预留空间。
    public virtual int StylePadT() {
        if (padSet) { return padT; }
        if (computedStyle != null) { return computedStyle.PadTOr(padT); }
        return padT;
    }

    // 内容框右内边距：显式 Pad()/Padding() 优先于样式表（同 StylePadL）。
    int StylePadR() {
        if (padSet) { return padR; }
        if (computedStyle != null) { return computedStyle.PadROr(padR); }
        return padR;
    }

    // 内容框底部内边距：显式 Pad()/Padding() 优先于样式表（同 StylePadL）。
    int StylePadB() {
        if (padSet) { return padB; }
        if (computedStyle != null) { return computedStyle.PadBOr(padB); }
        return padB;
    }

    // 内容框内衬 = border + padding（WEB_GUI_ROADMAP P0 起 border 参与
    // 布局：box-sizing: border-box 的声明尺寸含边框）。布局端（Arrange/
    // Measure*/PropagateWrapHint）一律用 Inset 而不是裸 pad。
    int StyleInsetL() {
        if (computedStyle == null) { return this.StylePadL(); }
        return this.StylePadL() + computedStyle.BorderLeftPx();
    }
    int StyleInsetT() {
        if (computedStyle == null) { return this.StylePadT(); }
        return this.StylePadT() + computedStyle.BorderTopPx();
    }
    int StyleInsetR() {
        if (computedStyle == null) { return this.StylePadR(); }
        return this.StylePadR() + computedStyle.BorderRightPx();
    }
    int StyleInsetB() {
        if (computedStyle == null) { return this.StylePadB(); }
        return this.StylePadB() + computedStyle.BorderBottomPx();
    }

    // 此节点的 CSS `display`：0 block（子节点停靠），1 flex（子节点沿
    // flex-direction 排列），2 none。
    public virtual int StyleDisplay() {
        if (computedStyle == null) { return 0; }
        return computedStyle.display;
    }

    // 此节点 flex 路径的主轴方向：0 row / 1 column。控件可覆写——
    // flex 性来自控件本身（而非样式表）时，方向也得有个不依赖
    // 样式解析时机的来源：宽度提示下传、按内容测量与排布三处
    // 都要在 computedStyle 尚未落定时就能问方向（A542②）。
    public virtual int StyleFlexDir() {
        if (computedStyle == null) { return 0; }
        return computedStyle.flexDir;
    }

    // CSS overflow 的 per-axis 计算值（P6）：0 visible / 1 hidden /
    // 2 auto / 3 scroll。单轴声明时另一根的 visible 按规范计算成
    // auto（CSS Overflow——混合 visible 会让 visible 轴变 auto）。
    int StyleOverflowX() {
        if (computedStyle == null) { return 0; }
        int x = computedStyle.overflowX;
        if (computedStyle.overflowY != 0 && x == 0) { x = 2; }
        return x;
    }
    int StyleOverflowY() {
        if (computedStyle == null) { return 0; }
        int y = computedStyle.overflowY;
        if (computedStyle.overflowX != 0 && y == 0) { y = 2; }
        return y;
    }

    // 是否为滚动容器：任一轴声明了非 visible 的 overflow。
    bool IsScrollContainer() {
        return this.StyleOverflowX() != 0 || this.StyleOverflowY() != 0;
    }

    // 程序性滚动（等价 el.scrollTop = v）：下一帧 Arrange 钳制并把
    // 子树平移。overflow:hidden 的容器同样可程序滚动（Chrome 同款，
    // 只是没有滚轮/滚动条交互）。
    void SetScrollTop(int v) {
        this.scrollY = v;
        if (this.scroll == null) { this.scroll = new ScrollState(); }
    }
    // 当前滚动偏移（px，钳制后）。
    int ScrollTop() { return this.scrollY; }
    // 最近一次排布出的内容延伸（padding-box 坐标，px；
    // 等价 DOM scrollHeight 与 clientHeight 取大）。
    int ScrollExtent() { return this.scrollExtent; }

    // 程序性横向滚动（等价 el.scrollLeft = v，P6 横滚）：钳制与
    // 子树平移同 SetScrollTop，下一帧 Arrange 收口。
    void SetScrollLeft(int v) {
        this.scrollX = v;
        if (this.scroll == null) { this.scroll = new ScrollState(); }
    }
    // 当前水平滚动偏移（px，钳制后）。
    int ScrollLeft() { return this.scrollX; }
    // 最近一次排布出的水平内容延伸（padding-box 坐标，px；
    // 等价 DOM scrollWidth 与 clientWidth 取大）。
    int ScrollExtentX() { return this.scrollExtentX; }

    // 在 `avail` 像素的包含块内声明的主/交叉轴尺寸，
    // 百分比已解析、min/max 已应用；样式未声明尺寸时
    // 回退到测量偏好（prefW/prefH）。
    int StyleWidthIn(int avail) {
        if (computedStyle == null) { return prefW; }
        int w = computedStyle.ClampWIn(avail, computedStyle.WidthIn(avail, prefW));
        // box-sizing: content-box 的声明宽度只含内容——布局要的是
        // 框宽，反推加上 border 与 padding。
        if (computedStyle.boxSizing == 1 && computedStyle.width >= 0) {
            w = w + computedStyle.BorderLeftPx() + computedStyle.BorderRightPx()
                + this.StylePadL() + this.StylePadR();
        } else if (computedStyle.width >= 0) {
            // border-box：内容区不为负——声明尺寸小于 border+padding
            // 之和时，框被钳到 border+padding（Chrome 同款行为）。
            int minBox = computedStyle.BorderLeftPx() + computedStyle.BorderRightPx()
                + this.StylePadL() + this.StylePadR();
            if (w < minBox) { w = minBox; }
        }
        return w;
    }

    // 生效高度：在 `avail` 像素包含块内解析样式声明的高度
    // （百分比、min/max 同 StyleWidthIn），未声明时回退 prefH。
    int StyleHeightIn(int avail) {
        // 作者声明的高度优先于样式表（CSS：内联 > 样式表）：设计文档里
        // 的字段高度不该被皮肤的默认高度（`input { height: 32px }`）压住，
        // 否则设计器里改了高度不生效、行高按样式表排，字段互相叠。
        // 声明高度是边框盒外框尺寸（设计器画布就是按它画框的），
        // 因此直接返回，不再套 content-box 的"内容高 + 内边距"换算。
        if (this.declaredH > 0) { return this.declaredH; }
        if (computedStyle == null) { return prefH; }
        int h = computedStyle.ClampHIn(avail, computedStyle.HeightIn(avail, prefH));
        if (computedStyle.boxSizing == 1 && computedStyle.height >= 0) {
            h = h + computedStyle.BorderTopPx() + computedStyle.BorderBottomPx()
                + this.StylePadT() + this.StylePadB();
        } else if (computedStyle.height >= 0) {
            int minBox = computedStyle.BorderTopPx() + computedStyle.BorderBottomPx()
                + this.StylePadT() + this.StylePadB();
            if (h < minBox) { h = minBox; }
        }
        return h;
    }

    // 样式表声明了宽度/高度（如 `button.large` 这样的尺寸类）时为 true，
    // 区别于测量偏好。百分比声明（width:50%）也算——调用方必须传入
    // 真实包含块基准（avail），% 才有定义；包含块未定的测量期调用方
    // （grid 轨道、float 重测、内在宽）请用 *Abs 变体，让 % 按 auto
    // 回落测量偏好（css-sizing：内在尺寸计算中百分比视作 auto）。
    bool StyleDeclaresWidth() {
        return computedStyle != null
            && (computedStyle.width >= 0 || computedStyle.widthPm >= 0);
    }

    // 样式表声明了高度时为 true（与 StyleDeclaresWidth 配对使用）。
    bool StyleDeclaresHeight() {
        return computedStyle != null
            && (computedStyle.height >= 0 || computedStyle.heightPm >= 0);
    }

    // 只认绝对值（px）声明的宽度：包含块未定的测量期判定用。
    bool StyleDeclaresWidthAbs() {
        return computedStyle != null && computedStyle.width >= 0;
    }

    // 只认绝对值（px）声明的高度，同 StyleDeclaresWidthAbs。
    bool StyleDeclaresHeightAbs() {
        return computedStyle != null && computedStyle.height >= 0;
    }

    // 此节点的 CSS `flex-grow`（0 = 保持自身尺寸）。
    int StyleGrow() {
        if (computedStyle == null) { return 0; }
        return computedStyle.grow;
    }

    // CSS `flex-wrap`（0 单行，1 换行）。
    int StyleWrap() {
        if (computedStyle == null) { return 0; }
        return computedStyle.wrap;
    }

    // CSS `align-content`：换行容器里各行在交叉轴上的分布
    int StyleAlignContent() {
        if (computedStyle == null) { return 0; }
        return computedStyle.alignContent;
    }

    // CSS `align-self`：本子项自己的交叉轴对齐，-1 表示未声明
    // （跟随容器的 align-items）。
    int StyleAlignSelf() {
        if (computedStyle == null) { return 0 - 1; }
        return computedStyle.alignSelf;
    }

    // CSS `flex-shrink`：行溢出时是否参与收缩（1 参与，0 不参与）。
    // 未声明按 1——CSS 的默认值。
    int StyleShrink() {
        if (computedStyle == null) { return 1; }
        if (computedStyle.shrink < 0) { return 1; }
        return computedStyle.shrink;
    }

    // flex 收缩的 min-content 下限（A545，CSS `min-width:auto` 的近似）：
    // 溢出行按比例收缩时，内容不可重排的控件不被压扁——按钮/图标以
    // 测量偏好（内容尺寸）为下限，非折行文本以整段文本宽为下限
    // （Label 覆写）。作者声明的尺寸（Prefer/SetSize/文档宽高，
    // prefSet）是"指定尺寸"而非内容下限——CSS 里它照样向
    // min-content 收缩，这里没有单独的内容测量可依，按可协商处理，
    // 返回 0 照旧按比例收缩。由流内容定尺寸的容器（fillW/fillH，
    // 宽度随槽重排）同样无内在下限。声明了的 min/max 由调用方经
    // StyleClampW/H 套上。
    virtual int MinContentMain(bool row) {
        if (this.prefSet) { return 0; }
        if (row) { return this.fillW ? 0 : this.prefW; }
        return this.fillH ? 0 : this.prefH;
    }

    // CSS `flex-basis` 在 `avail` 像素主轴包含块内的值，
    // 未声明时返回 -1。
    int StyleBasisIn(int avail) {
        if (computedStyle == null) { return 0 - 1; }
        return computedStyle.BasisIn(avail);
    }

    // CSS `aspect-ratio` 的千分比（0 = 未声明）。
    int StyleAspect() {
        if (computedStyle == null) { return 0; }
        return computedStyle.aspect;
    }

    // 此节点的 CSS `position`：0 static，1 relative，2 absolute/fixed。
    // absolute 子项脱离常规流（测量与排布两端都跳过），由
    // ArrangePositioned 按偏移边定位。
    int StylePosition() {
        if (designFloat) { return 2; }
        if (computedStyle == null) { return 0; }
        return computedStyle.position;
    }

    // CSS `z-index`（0 = 文档序；有非零值时兄弟绘制与命中
    // 都按值稳定排序）。
    int StyleZIndex() {
        if (computedStyle == null) { return 0; }
        return computedStyle.zIndex;
    }

    // CSS `order`（flex 排布顺序；0 保持文档序，同值稳定）。
    int StyleOrder() {
        if (computedStyle == null) { return 0; }
        return computedStyle.order;
    }

    // 样式表声明的外边距（px；未解析样式时为 0）。
    // 行内级（P2 行盒）：`inline`/`inline-block`/`inline-flex` 置 1，
    // 块流容器把它排进行盒而不是当独立块。
    int StyleInlineLevel() {
        return computedStyle != null ? computedStyle.inlineLevel : 0;
    }

    // 块流 float（P3）：0 无 / 1 left / 2 right——非零时子项脱离
    // 垂直堆叠、行盒绕排（CSS 2.1 §9.5）。
    int StyleFloat() {
        return computedStyle != null ? computedStyle.floatSide : 0;
    }

    // clear（P3）：0 无 / 1 left / 2 right / 3 both——顶边被推到
    // 相关 float 底边之下。
    int StyleClear() {
        return computedStyle != null ? computedStyle.clearSide : 0;
    }

    // 块流内容序列（P2）：按此序列分段/排布——默认只有子项
    // （FlexKids 过滤）；Element 覆写为文档序的 文本/子项 混合
    // 序列（AddText/AddKid 交错）。
    public virtual List<FlowEntry> FlowEntries() {
        List<Control> kids = this.FlexKids();
        List<FlowEntry> es = new List<FlowEntry>();
        for (int i = 0; i < kids.Count; i = i + 1) {
            FlowEntry e = new FlowEntry();
            e.kid = kids[i];
            es.Add(e);
        }
        return es;
    }

    int StyleMarL() {
        if (marSet) { return marL; }
        if (computedStyle == null) { return 0; }
        int v = computedStyle.marL; return v < 0 ? 0 : v;
    }
    // 样式表声明的外边距（px；未解析样式时为 0）。
    int StyleMarT() {
        if (marSet) { return marT; }
        if (computedStyle == null) { return 0; }
        int v = computedStyle.marT; return v < 0 ? 0 : v;
    }
    // 样式表声明的外边距（px；未解析样式时为 0）。
    int StyleMarR() {
        if (marSet) { return marR; }
        if (computedStyle == null) { return 0; }
        int v = computedStyle.marR; return v < 0 ? 0 : v;
    }
    // 样式表声明的外边距（px；未解析样式时为 0）。
    int StyleMarB() {
        if (marSet) { return marB; }
        if (computedStyle == null) { return 0; }
        int v = computedStyle.marB; return v < 0 ? 0 : v;
    }

    // 生效的子项间距：样式表的 `gap` 优先，其次 Gap() 设置值。
    int StyleGap() {
        if (computedStyle != null) { return computedStyle.GapOr(gap); }
        return gap;
    }

    // 行距 / 列距（CSS `row-gap` / `column-gap`，未声明时回退到 `gap`，
    // 再回退到调用方给的默认值）：换行的容器两个方向的间距不同。
    int StyleRowGap(int fb) {
        if (computedStyle != null) { return computedStyle.RowGapOr(fb); }
        return fb;
    }

    // 列距（CSS `column-gap`，未声明回退 `gap`，再回退 `fb`）。
    int StyleColGap(int fb) {
        if (computedStyle != null) { return computedStyle.ColGapOr(fb); }
        return fb;
    }

    // 每行的等分列数（CSS `columns`）。
    // 未声明时返回 `fb`（0 = 按可用宽度自动换行）。
    int StyleColumns(int fb) {
        if (computedStyle != null) { return computedStyle.ColumnsOr(fb); }
        return fb;
    }

    // 行高（CSS `line-height`，0 = 未声明：由该行最高的子项决定）。
    int StyleLineHeight() {
        if (computedStyle != null && computedStyle.lineHeightKind == 2) {
            int fs = computedStyle.fontPx > 0
                ? computedStyle.fontPx : computedStyle.envRemPx;
            return computedStyle.lineHeight * fs / 1000;
        }
        if (computedStyle != null) { return computedStyle.lineHeight; }
        return 0;
    }

    // 本控件及样式均可见时为 true：visible 标志、CSS `display`
    // 非 none 且 `visibility` 非 hidden。Arrange/Render/命中都以此为准。
    bool StyleVisible() {
        if (!visible) { return false; }
        if (computedStyle == null) { return true; }
        return computedStyle.display != 2 && computedStyle.visible != 0;
    }

    // 把此节点的 CSS 表面（阴影、背景/渐变、边框）
    // 绘制进其已解析边界，遵循 styleRadius。由 RenderTree 在
    // OnPaint 之前调用，使所有控件获得统一的 CSS 样式，控件的
    // OnPaint 只需在之上绘制自己的内容。未设置任何样式时为空操作，
    // 因此自行绘制表面的既有控件不受影响。
    void PaintStyleBox(App app) {
        if (wiresOwnEvents || styleSurfaceOwned) { return; }
        if (!this.ComputedStyleCurrent(app)) {
            this.ResolveStyle(app, Style.SNormal());
        }
        computedStyle.Paint(app, bx, by, bw, bh);
    }

    // 针对 `id` 触发此节点的通用事件包。控件在
    // 注册命中区域后每帧调用一次；等价于
    // On.Fire(app, id, this)，但调用点更统一。
    void FireOn(App app, int id) {
        On.Fire(app, id, this);
    }

    // 设置停靠方式（Dock.* 值）；返回 this。
    Control Dock(int d) {
        dock = d;
        return this;
    }

    // 设置测量偏好尺寸（px）：布局优先于 OnMeasure 的自测量与
    // 样式回退；返回 this。
    Control Prefer(int w, int h) {
        prefW = w;
        prefH = h;
        prefSet = true;
        return this;
    }

    // 设置 dock == Manual 时在父内容框内的偏移（px）；返回 this。
    Control Place(int x, int y) {
        mx = x;
        my = y;
        return this;
    }

    // 四边统一设置内边距并锁定（OnMeasure 不得再用主题默认值
    // 覆盖，见 padSet）；返回 this。
    Control Pad(int p) {
        padL = p;
        padT = p;
        padR = p;
        padB = p;
        padSet = true;
        return this;
    }

    // 按 CSS 顺序（上、右、下、左）设置内边距并锁定（同 Pad）；
    // 返回 this。
    Control Padding(int top, int right, int bottom, int left) {
        padT = top;
        padR = right;
        padB = bottom;
        padL = left;
        padSet = true;
        return this;
    }

    // 四边统一设置外边距并锁定；返回 this。
    Control Margin(int m) {
        marL = m;
        marT = m;
        marR = m;
        marB = m;
        marSet = true;
        return this;
    }

    // 按 CSS 顺序（上、右、下、左）设置外边距并锁定；返回 this。
    Control Margin(int top, int right, int bottom, int left) {
        marT = top;
        marR = right;
        marB = bottom;
        marL = left;
        marSet = true;
        return this;
    }

    // 设置流式/停靠子项间距（px）；返回 this。
    Control Gap(int g) {
        gap = g;
        return this;
    }

    // 设置可见性（Show/Hide 生命周期事件据此在下一帧触发）；
    // 返回 this。
    Control SetShown(bool v) {
        visible = v;
        return this;
    }

    // 告知本容器它将在多宽的框里断行（设备像素）。换行的 flex
    // 容器有多高取决于它有多宽，而测量在分配尺寸之前发生；宿主
    // 已经知道目标宽度时（把子树排进一个已知矩形），在 MeasureTree
    // 之前调用这个，行数与高度第一次测量就是对的，不必等下一帧。
    Control HintWrapWidth(int px) {
        if (px < 0) { px = 0; }
        hintWrapW = px;
        return this;
    }

    // 追加一个子节点，返回该子节点本身，调用方可内联持有引用，
    // 如 `Button b = panel.Add(save)`。注意：Add 不做停靠归一化——
    // 子项保持手摆（dock=0），在流式容器（列/行）里会全部叠在原点。
    // 要自动沿流式轴停靠请用 With()（或集合初始化器，它走的也是 With）。
    public virtual Control Add(Control c) {
        if (!this.Adoptable(c)) { return c; }
        this.Adopt(c);
        children.Add(c);
        return c;
    }

    // 流式子节点追加：添加 `c` 并返回 THIS 容器（而非子节点），
    // 因此多个子节点可链式追加——`panel.With(a).With(b).With(c)`。若
    // 此节点有流式布局（列/行），子节点会自动沿
    // 流式轴停靠，除非它选择了 Grow()。
    Control With(Control c) {
        if (!this.Adoptable(c)) { return this; }
        if (layout != 0 && !c.grow) {
            if (layout == 2) { c.dock = 3; } else { c.dock = 1; }
        }
        this.Adopt(c);
        children.Add(c);
        return this;
    }

    // 批量追加子节点（流式追加，自动维护父子拓扑与作用域）。
    Control AddChildren(List<Control> list) {
        if (list == null) { return this; }
        for (int i = 0; i < list.Count; i = i + 1) {
            this.With(list[i]);
        }
        return this;
    }

    // 快捷固定首选宽度（逻辑像素）。
    Control Width(int w) {
        return this.Prefer(w, prefH);
    }

    // 快捷固定首选高度（逻辑像素）。
    Control Height(int h) {
        return this.Prefer(prefW, h);
    }

    // 一个控件在树里只能有一个位置。宿主保留控件（画廊、文档预览、
    // 设计出来的静态字段）会在重建时被挂到新的父节点上，旧父节点若还
    // 留着它，同一个节点就出现在两处；把祖先挂进自己的后代更糟——树
    // 成环，任何递归遍历（Wire/RenderTree/Measure）都会无限递归，栈溢
    // 出表现为读非法地址的崩溃。因此收养前先判断能不能收养。
    bool Adoptable(Control c) {
        if (c == null || c == this) { return false; }
        /* c 是本节点的祖先：挂进去就成环 */
        Control up = parent;
        for (int guard = 0; up != null && guard < 4096; guard = guard + 1) {
            if (up == c) { return false; }
            up = up.parent;
        }
        return true;
    }

    // 收养一个子节点：先从原父节点摘下（含本节点，重复 Add 不会让
    // 同一个控件在 children 里出现两次），再指向本节点。
    void Adopt(Control c) {
        if (c.parent != null) { c.parent.Remove(c); }
        c.parent = this;
        c.SpreadHostForm(this.HostForm());
        this.SpreadScopeTo(c);
    }

    // 提取作用域类（HTML scoping 约定的 `zs-*` 类标记）：
    // 若本节点（或祖先链）携带有 `zs-*` 作用域，子树被收养时自动继承。
    string ScopeClass() {
        Control cur = this;
        while (cur != null) {
            if (cur.Class != "") {
                List<string> parts = Style.Classes(cur.Class);
                for (int i = 0; i < parts.Count; i = i + 1) {
                    string p = parts[i];
                    if (p.Length >= 3 && p[0] == 122 && p[1] == 115 && p[2] == 45) {
                        return p;
                    }
                }
            }
            cur = cur.parent;
        }
        return "";
    }

    void SpreadScopeTo(Control c) {
        if (c == null) { return; }
        string zs = this.ScopeClass();
        if (zs == "") { return; }
        c.InheritScope(zs);
    }

    void InheritScope(string zs) {
        if (this.Class != "" && Style.Has(this.Class, zs)) { return; }
        bool hasOtherScope = false;
        if (this.Class != "") {
            List<string> parts = Style.Classes(this.Class);
            for (int i = 0; i < parts.Count; i = i + 1) {
                string p = parts[i];
                if (p.Length >= 3 && p[0] == 122 && p[1] == 115 && p[2] == 45) {
                    hasOtherScope = true;
                    break;
                }
            }
        }
        if (!hasOtherScope) {
            this.AddClass(zs);
        }
        for (int i = 0; i < children.Count; i = i + 1) {
            children[i].InheritScope(zs);
        }
    }

    // 本节点所在的窗口，尚未挂到任何窗口下时为 null。
    Form HostForm() {
        Control up = this;
        for (int guard = 0; up != null && guard < 4096; guard = guard + 1) {
            if (up is Form) { return (Form)up; }
            up = up.parent;
        }
        return null;
    }

    // 类 C# WinForms / WPF 风格的窗口与应用上下文上溯：挂树控件直接通过
    // this.FindForm() / this.FindApp() 访问宿主，无需外界手动 UseApp(app) 传递。
    Form FindForm() {
        return this.HostForm();
    }

    App FindApp() {
        Form f = this.HostForm();
        if (f != null) { return f.GetApp(); }
        return null;
    }

    // 挂到窗口树上时由框架下发：设计出来的控件用它记住自己的事件
    // 宿主，因此宿主代码不需要手动接线。
    public virtual void OnHostForm(Form f) {
    }

    // 把宿主窗口沿子树发下去（收养时自动调用，一棵先建好的子树在
    // 挂上来的那一刻整棵都收到宿主）。
    void SpreadHostForm(Form f) {
        if (f == null) { return; }
        this.OnHostForm(f);
        for (int i = 0; i < children.Count; i = i + 1) {
            children[i].SpreadHostForm(f);
        }
    }

    // 给定父节点剩余空间时，此子节点停靠的主轴尺寸：
    // 由样式表决定，因此停靠面板上的 `width: 34%; min-width: 260px`
    // 与浏览器中的行为完全一致；没有样式尺寸的子节点
    // 保持其测量尺寸。
    int DockSize(int avail, bool horizontal) {
        if (horizontal) { return this.StyleWidthIn(avail); }
        return this.StyleHeightIn(avail);
    }

    // 标记此节点填满其流式父节点的剩余主轴空间。
    Control Grow() {
        grow = true;
        dock = 5;
        return this;
    }

    // 停靠到顶部（占用整行宽度，按插入顺序自上而下）；返回 this。
    Control DockTop() { dock = 1; return this; }
    // 停靠到底部；返回 this。
    Control DockBottom() { dock = 2; return this; }
    // 停靠到左侧（占用整列高度）；返回 this。
    Control DockLeft() { dock = 3; return this; }
    // 停靠到右侧；返回 this。
    Control DockRight() { dock = 4; return this; }
    // 停靠为填充：占据其余停靠子节点用剩的空间；返回 this。
    Control DockFill() { dock = 5; return this; }
    // 取消停靠，回到 Manual（用 Place() 定位）；返回 this。
    Control DockManual() { dock = 0; return this; }

    // 现代 Float / Absolute 与 Anchor 锚定原语。
    // Float 必须同时退出停靠（dock = 0）：`Place()` 的 mx/my 只在 Manual
    // 模式下被 Arrange 读取，而控件默认 dock = 5（Fill），只写坐标的
    // Float 会被父容器按 fill 拉伸成整块（legend 页 18 弹窗整个铺满窗口、
    // 页 31 全屏错位的根因——一次自动重构把 `DockManual(); Place(...)`
    // 折成了 `Float(...)`，语义丢在半路）。
    Control Float(int left, int top) {
        dock = 0;
        return this.Place(left, top);
    }
    Control AnchorTop() { dock = 1; return this; }
    Control AnchorBottom() { dock = 2; return this; }
    Control AnchorLeft() { dock = 3; return this; }
    Control AnchorRight() { dock = 4; return this; }

    // 流式 id 设置器，内联构建的节点之后仍可用
    // Find() 定位，或被设计器/序列化器定位。
    Control Named(string n) {
        name = n;
        computedStyle = null;
        return this;
    }

    // `c` 在 children 中的下标；不是本节点的子节点时返回 -1。
    int IndexOf(Control c) {
        for (int i = 0; i < children.Count; i = i + 1) {
            if (children[i] == c) { return i; }
        }
        return -1;
    }

    // 移除一个子节点（若它不是本节点的子节点则为空操作）。
    void Remove(Control c) {
        int idx = IndexOf(c);
        if (idx >= 0) {
            children.RemoveAt(idx);
            c.parent = null;
        }
    }

    // 移除所有子节点：数据驱动的容器在按数据重填前调用。
    void RemoveAll() {
        for (int i = 0; i < children.Count; i = i + 1) {
            children[i].parent = null;
        }
        children = new List<Control>();
    }

    // 在某个位置插入子节点，索引被钳制在范围内。会重新父化 `c`。
    void InsertAt(int idx, Control c) {
        if (!this.Adoptable(c)) { return; }
        this.Adopt(c);
        int at = idx;
        if (at < 0) { at = 0; }
        if (at > children.Count) { at = children.Count; }
        children.Insert(at, c);
    }

    // 把已有子节点移动到新索引（供设计器拖拽排序用）。
    void MoveChild(Control c, int to) {
        int idx = IndexOf(c);
        if (idx < 0) { return; }
        children.RemoveAt(idx);
        int at = to;
        if (at < 0) { at = 0; }
        if (at > children.Count) { at = children.Count; }
        children.Insert(at, c);
    }

    // 其已解析边界包含该点的最深层可见后代，
    // 优先选择更靠后（最上层）的子节点。用于设计器命中选择。
    // 子项带非零 z-index 时按绘制序的逆序试命中（值大的先试，
    // 同值保持文档序靠后者优先），与 RenderTree 的绘制顺序一致。
    Control HitTest(int x, int y) {
        if (!this.StyleVisible()) { return null; }
        if (x < bx || y < by || x >= bx + bw || y >= by + bh) { return null; }
        bool anyZ = false;
        for (int i = 0; i < children.Count; i = i + 1) {
            if (children[i].StyleZIndex() != 0) { anyZ = true; break; }
        }
        if (!anyZ) {
            int i = children.Count - 1;
            while (i >= 0) {
                Control hit = children[i].HitTest(x, y);
                if (hit != null) { return hit; }
                i = i - 1;
            }
            return this;
        }
        List<Control> ordered = new List<Control>();
        for (int i = 0; i < children.Count; i = i + 1) {
            Control c = children[i];
            int z = c.StyleZIndex();
            int ins = ordered.Count;
            while (ins > 0 && ordered[ins - 1].StyleZIndex() <= z) {
                ins = ins - 1;
            }
            ordered.Insert(ins, c);
        }
        for (int i = 0; i < ordered.Count; i = i + 1) {
            Control hit = ordered[i].HitTest(x, y);
            if (hit != null) { return hit; }
        }
        return this;
    }

    // 按名称快速深度优先搜索，包括本节点。仅比对控件标识名，不触发属性反射/字典查询。
    public Control FindByName(string n) {
        if (n == "" || n == null) { return null; }
        if (name == n) { return this; }
        for (int i = 0; i < children.Count; i = i + 1) {
            Control r = children[i].FindByName(n);
            if (r != null) { return r; }
        }
        return null;
    }

    // 按名称或标题文本深度优先搜索，包括本节点。找不到返回 null。
    // 优先快速按 name 匹配（零属性查询开销）；仅当整树未按名称命中时，
    // 才回退穿透按标题文本匹配（兼顾无 name 控件的文本寻址）。
    public Control Find(string n) {
        if (n == "" || n == null) { return null; }
        Control byName = this.FindByName(n);
        if (byName != null) { return byName; }
        return this.FindByText(n);
    }

    Control FindByText(string t) {
        if (this.GetProp("text") == t) { return this; }
        for (int i = 0; i < children.Count; i = i + 1) {
            Control r = children[i].FindByText(t);
            if (r != null) { return r; }
        }
        return null;
    }

    // 子节点数。
    int ChildCount() {
        return children.Count;
    }

    // 返回父控件（顶层控件或未挂树时返回 null）。
    public Control Parent() {
        return parent;
    }

    // 子节点集合门面（getter-only 属性）：对象初始化器
    // `new Panel.Row() { Children = { a, b, c } }` 对它逐个 Add，
    // 每次 Add 都走 `With` 的完整收养语义；这是唯一预期的用法，
    // 返回的包装对象是一次性的，不值得在初始化器之外持有。
    ControlChildren Children {
        get { return new ControlChildren(this); }
    }

    // 作者声明控件高度（设计文档的 fh，逻辑像素）。走这条通道的
    // 高度优先于样式表的 height：文档是设计器的唯一真相，样式表
    // 的默认高度（`input { height: 32px }`）不该把作者定下的行高
    // 压回去——那正是"改了高度不生效、行与行叠在一起"的根源。
    // 代码里手搭控件时直接用 logH / SetSize，走的是"测量偏好"通道，
    // 尺寸档（tiny/small/medium/large）依然说了算。
    void DeclareHeight(int h) {
        if (h <= 0) { return; }
        this.logH = h;
        this.authorSized = true;
    }

    // 让节点自下而上从主题设置首选尺寸（子节点
    // 优先）。子类重写 OnMeasure。在 Arrange 之前运行。
    void ApplyDeclaredUnits(App app) {
        if (logW > 0) { prefW = app.Scale(logW); prefSet = true; }
        if (logH > 0) { prefH = app.Scale(logH); prefSet = true; }
        // 作者声明的高度只认 DeclareHeight 通道：代码里手搭的
        // logH 只是"测量偏好"，样式表（尺寸档）仍然说话。
        declaredH = (logH > 0 && authorSized) ? prefH : 0;
        if (logGap >= 0) { gap = app.Scale(logGap); }
        if (logPad >= 0) { this.Pad(app.Scale(logPad)); }
        if (logMar >= 0) { this.Margin(app.Scale(logMar)); }
        if (logPlaceSet) {
            mx = app.Scale(logX);
            my = app.Scale(logY);
        }
    }

    // 绘制此节点自身的视觉。基类不绘制；子类重写。
    public virtual void OnPaint(App app) {
    }

    // 在延迟的覆盖层阶段绘制此控件的浮动/覆盖层（弹出菜单、选项列表、
    // 提示），使其绘制在所有页面内容之上
    // 并注册最顶层的命中区域——永不被遮挡，
    // 也绝不把点击漏给其后绘制的控件。基类
    // 不绘制；浮动控件重写此方法，打开期间用
    // `app.AddOverlay(OverlayPopup.Host(this))` 延迟自身，
    // 而不是在主阶段内联绘制弹窗。
    public virtual void OnPaintOverlay(App app) {
    }

    // 根据内容/主题设置 prefW/prefH。基类为空操作；叶节点重写。
    public virtual void OnMeasure(App app) {
    }

    // --- 设计器/序列化模型（通过虚方法统一、免强转）---

    // 用于重建此节点的稳定类型标签（见 ControlFactory）。每个
    // 具体控件都重写它；基类标签只是回退。
    public virtual string Kind() {
        return "Control";
    }

    // 供检查器和序列化器使用的控件专属可编辑属性。
    // 通用几何（dock/pad/gap/size/pos/name）由 Serialize 处理，
    // 因此这里只返回控件独有的属性。基类没有。
    public virtual List<PropSpec> Props() {
        return new List<PropSpec>();
    }

    // 一切由字段支撑的属性仅由 Props() 提供。
    public virtual string GetExtra(string key) {
        return "";
    }

    // 写入一个额外属性；控件没有该键时返回 false，
    // 基类此时回退为把它当作样式类处理。
    public virtual bool SetExtra(string key, string val) {
        return false;
    }

    // 设计里放进容器某个“位”的子控件（标签页的页、分栏的
    // 窗格）真正的父节点。容器重写它，把设计文档的 `childTab`
    // 映射到自己的内部容器；普通容器直接收下子节点。
    public virtual Control SlotHost(int slot) {
        return this;
    }

    // 具名插槽宿主容器：复合组件（Tabs/SplitPanel/Card/Dialog 等）根据 slot 名字
    // 映射到具体的内部容器（如 "header"、"footer"、"left"、"right" 或数字页码）。
    public virtual Control NamedSlotHost(string slot) {
        if (slot == "" || slot == "default") { return this; }
        if (Control.IsNumericSlot(slot)) {
            return this.SlotHost(Convert.ToInt32(slot));
        }
        return null;
    }

    // 将子控件挂载到指定具名槽位：若成功消费槽位则返回 true。
    public virtual bool MountSlot(string slot, Control c) {
        Control host = this.NamedSlotHost(slot);
        if (host != null && host != this) {
            host.Add(c);
            return true;
        }
        return false;
    }

    public static bool IsNumericSlot(string s) {
        if (s == "") { return false; }
        for (int i = 0; i < s.Length; i = i + 1) {
            int ch = (int)s[i];
            if (ch < 48 || ch > 57) { return false; }
        }
        return true;
    }

    // 通过控件在 Props() 中绑定的访问器，按键以文本形式读取属性——
    // 这样控件只需发布每个属性一次，无需自己的
    // 字符串映射。`class`、`name` 和 `disabled` 对所有控件都有应答。
    public virtual string GetProp(string key) {
        if (key == "class") { return Class; }
        if (key == "name") { return name; }
        PropSpec p = this.PropOf(key);
        if (p != null) { return p.Read(); }
        // `disabled` 是基类字段（沿树继承的禁用标志）——每个控件都
        // 有这个状态，属性协议必须应答它。控件自己没声明该属性时，
        // 设计器写进去的"禁用"落不到控件上（基类兜底会把它当样式
        // 类，控件本身没被禁用）。
        if (key == "disabled") { return PropSpec.Flag(this.Disabled.Get()); }
        return this.GetExtra(key);
    }

    // 从文本按键写入属性（GetProp 的逆操作）。未知的
    // 键改指样式类，要么是标志（`"round": true`），要么是
    // 变体名（`"size": "small"`），文档正是借此设置
    // 控件没有字段对应的视觉变体。
    public virtual void SetProp(string key, string val) {
        if (key == "class") { Class = val; return; }
        if (key == "style") {
            // 内联 CSS 声明即时落控件（布局键落字段、视觉键落 style*
            // 覆盖字段）。清掉常态样式缓存：SetProp 可能发生在首绘
            // 之后，不清缓存下一帧还会拿旧的解析结果画。
            StyleSheet.ApplyInline(this, val);
            computedStyle = null;
            return;
        }
        if (key == "name") {
            // 组件自带同名属性（IconView 的图标名等）优先于控件
            // 标识名：直接写标识名会让这类属性在任何声明通道
            // （data-x-props/原生属性）下永远喂不进去。
            PropSpec np = this.PropOf(key);
            if (np != null) {
                np.Write(val);
                if (np.syncName) { name = val; }
                return;
            }
            name = val;
            return;
        }
        PropSpec p = this.PropOf(key);
        if (p != null) {
            p.Write(val);
            if (p.syncName) { name = val; }
            return;
        }
        // `disabled` 落基类字段（见 GetProp 的同名分支）。控件自
        // 己声明了 disabled 属性时走上面的 spec——同一个字段。
        if (key == "disabled") {
            this.Disabled.Set(PropSpec.IsOn(val));
            return;
        }
        if (this.SetExtra(key, val)) { return; }
        if (val == "true") { this.AddClass(key); }
        else if (val != "" && val != "false") { this.AddClass(val); }
    }

    // 应用设计器里的标题文本。只有声明了 `text` 属性的控件
    // 会接受它：容器的 label 是设计期说明，不是内容，所以
    // 不能像 SetProp 那样退化成样式类。
    void SetDesignText(string txt) {
        if (txt == "") { return; }
        PropSpec p = this.PropOf("text");
        if (p == null) { return; }
        p.Write(txt);
        if (p.syncName) { name = txt; }
    }

    // 添加动态属性绑定规则
    void AddBindProp(string prop, string expr) {
        if (bindProps == null) {
            bindProps = new List<BindPropEntry>();
        }
        bindProps.Add(new BindPropEntry(prop, expr));
    }

    // 若样式类尚不存在则添加它。
    void AddClass(string cls) {
        if (cls == "" || Style.Has(Class, cls)) { return; }
        if (Class == "") { Class = cls; return; }
        Class = Class + " " + cls;
    }

    // 判断控件是否包含指定的样式类。
    bool HasClass(string cls) {
        if (cls == "" || Class == null || Class == "") { return false; }
        return Style.Has(Class, cls);
    }

    // 把 `Class` 里属于 `group`（空格分隔的候选集）的类全部去掉，
    // 再加上 `cls`（`cls` 为空则只做清除）。
    // 同一根轴上的变体是互斥的：`justify-center` 与 `justify-end`
    // 同时挂着时，最终生效的是样式表里靠后那条规则，作者每换一次
    // 对齐方式都得自己先去清掉上一次留下的类。这个方法把互斥
    // 关系收在一处，供 Flex/Grid 这类有多组变体的容器使用。
    void SetClassIn(string group, string cls) {
        List<string> drop = Style.Classes(group);
        List<string> cur = Style.Classes(Class);
        string kept = "";
        for (int i = 0; i < cur.Count; i = i + 1) {
            bool inGroup = false;
            for (int j = 0; j < drop.Count; j = j + 1) {
                if (cur[i] == drop[j]) { inGroup = true; }
            }
            if (inGroup) { continue; }
            if (kept == "") { kept = cur[i]; } else { kept = kept + " " + cur[i]; }
        }
        Class = kept;
        this.AddClass(cls);
    }

    // Naive UI `size` prop 值对应的 class 片段：四档一一对应
    // （tiny/small/medium/large），空串表示"不附加"（默认档）。
    //
    // 过去 tiny 被并进 small，于是 base.css 里写好的 `.tiny` 规则
    // （button.tiny / switch.tiny / tag.tiny / radio.tiny）永远不可达，
    // "同一档在不同组件上不是一个量"。现在四档各自成类，档位几何
    // 统一取自 Style.RootFromTheme 导出的 --height-* / --font-size-*
    // 令牌；没有 `.medium` 规则的组件落在默认档，与 medium 等价。
    static string SizeClass(string size) {
        if (size == "tiny" || size == "small" || size == "medium"
            || size == "large") {
            return size;
        }
        return "";
    }

    // 实例侧便捷：解析本控件的 `Size` 绑定字段并映射为档位
    // class 片段。Binding<string> 型的 Size 字段直接调用即可。
    string SizeCls() {
        Binding<string> sz = this.SizeOf();
        if (sz == null) { return ""; }
        return Control.SizeClass(sz.Get());
    }

    // 把尺寸档落到样式类上——控件支持尺寸档时的**统一入口**。
    //
    // 档位类互斥：挂新档之前先把 Class 里其它档位去掉，所以
    // `Class = "small"` 与 `Size = "large"` 同时存在时是 large 说了算，
    // 不会留下两个高度规则互相打架。用户手写的其它类（primary /
    // ghost / outline…）不受影响。
    //
    // **medium 是默认档，不覆盖用户写的档位**：设计器的尺寸行默认
    // 选中 medium，若它也去覆盖，`Class = "primary small"` 这种既有
    // 写法会被无声改成 medium 档（按钮集体变大）。所以：
    //   - 绑定为空 → 什么都不做（Class 原样）；
    //   - 绑定为 medium（默认）或非法值 → 什么都不做；
    //   - 绑定为 tiny/small/large → 挂上该档并清掉其它档。
    //
    // 控件在解析样式前调用它，并在解析后把 Class 还原——档位因此
    // 只是"这一帧的排布"，不会污染作者写下的 Class。
    void ApplySizeClass() {
        Binding<string> sz = this.SizeOf();
        if (sz == null) { return; }
        string cls = Control.SizeClass(sz.Get());
        if (cls == "" || cls == "medium") { return; }
        this.SetClassIn("tiny small medium large", cls);
    }

    // 设计器属性：尺寸档。控件在 Props() 里加一行
    // `ps.Add(this.SizeProp())` 即可，与各控件自己拼 PropSpec 的
    // 写法一致。
    PropSpec SizeProp() {
        PropSpec sz = PropSpec.Enum("size", "Size", PropSpec.Sizes());
        sz.str = this.SizeOf();
        return sz;
    }

    // 校验状态类名（Naive UI status prop）。输入族控件
    // （Input/TextArea）把 `FieldStatus` 映射为这些 class，
    // base.css 的 `.success/.warning/.error` 规则负责描边。
    // 校验成功状态类名（"success"）。
    static string StatusSuccess() { return "success"; }
    // 校验警告状态类名（"warning"）。
    static string StatusWarning() { return "warning"; }
    // 校验错误状态类名（"error"）。
    static string StatusError() { return "error"; }

    // 校验状态白名单归一：只认 success/warning/error，其余一律
    // 落回 ""（无状态）。设计器/绑定路径写进来的任意字符串先过
    // 这里，脏值不会长出一个没人认识的 class。
    static string StatusSanitize(string v) {
        if (v == Control.StatusSuccess() || v == Control.StatusWarning()
            || v == Control.StatusError()) { return v; }
        return "";
    }

    // 反射在 Zan 里没有：子类用 `new` 覆写 SizeOf 返回自己的
    // Size 绑定字段；基类返回 null。
    public virtual Binding<string> SizeOf() { return null; }

    // 双向绑定的统一拉取点：把外部 `Binding<T>` 的当前值拉进
    // 控件内部状态（model -> UI）。基类空实现；有绑定通道的
    // 控件 override。由 RenderTree 在每帧 OnPaint 前统一调用，
    // 控件不必在 OnPaint 开头自调（事件时机的回写仍走
    // `data.Set(...)`，与本契约无关）。契约见
    public virtual void SyncBinding() { }
}

