using Gui;
namespace Gui.Backend;

internal class UiDriverSession : AppAutomationSession {
    public void Shown(App app) { UiDriver.Start(app); }
    public void Tick(App app) {
        if (UiDriver.app == app) { UiDriver.Tick(); }
    }
    public void Presented(App app) { UiDriver.NotifyPresented(app); }
    public void TracePresent(App app, int stage, bool enter) {
        UiDriver.TraceFullPresent(app, stage, enter);
    }
    public bool PreparationReasonPending(App app) { return UiDriver.PreparationReasonPending(app); }
    public void TracePreparationReason(App app, string reason) { UiDriver.TracePreparationReason(app, reason); }
    public void Stopped(App app) {
        if (UiDriver.app != app) { return; }
        UiDriver.active = false;
        UiDriver.app = null;
    }
}
