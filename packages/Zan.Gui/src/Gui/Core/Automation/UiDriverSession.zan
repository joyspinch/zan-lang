using System;
using System.Collections.Generic;
using Gui;
namespace Gui.Backend;
internal class UiDriverSession : AppAutomationSession {
    internal bool active;
    internal bool finished;
    internal App app;
    internal List<string> cmds;
    internal int pc;
    internal int waitUntilUs;  // 绝对微秒；仅在 waitArmed 时有效
    internal bool waitArmed;  // 是否有挂起等待（时钟会回绕，不能用 0 判断）
    internal bool waitFullPresent;
    internal bool traceFullPresent;
    internal int traceOwner;
    internal int traceRequest;
    internal int traceEnterMask;
    internal int traceLeaveMask;
    internal bool tracePreparationReason;
    internal string outDir;
    internal string resultsPath;
    internal int passCount;
    internal int failCount;
    internal List<UiProbe> probes;
    internal int commandErrors;
    internal int commandLine;

    public void Shown(App app) { UiDriver.StartSession(this, app); }
    public void Tick(App app) {
        if (this.app == app) { UiDriver.TickSession(this); }
    }
    public void Presented(App app) { UiDriver.NotifyPresented(this, app); }
    public void TracePresent(App app, int stage, bool enter) { UiDriver.TraceFullPresent(this, app, stage, enter); }
    public bool PreparationReasonPending(App app) { return UiDriver.PreparationReasonPending(this, app); }
    public void TracePreparationReason(App app, string reason) { UiDriver.TracePreparationReason(this, app, reason); }
    public void Stopped(App app) {
        if (this.app != app) { return; }
        this.active = false;
        this.app = null;
        if (GuiHostState.AutomationSession() == this) { GuiHostState.SetAutomationSession(null); }
    }
}
