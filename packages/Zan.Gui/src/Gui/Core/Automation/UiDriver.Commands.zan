using System;

namespace Gui.Backend;

public partial class UiDriver {
    static int commandErrors;
    static int commandLine;

    // Script dispatch supplies its physical 1-based line; direct Exec uses 0.
    // Observe exceptional exits without catching/rethrowing the original type.
    static bool ExecuteCommand(string line, int sourceLine) {
        int previousLine = commandLine;
        int previousErrors = commandErrors;
        commandLine = sourceLine;
        bool completed = false;
        try {
            bool yield = UiDriver.ExecCore(line);
            completed = true;
            return yield;
        } finally {
            try {
                if (!completed && commandErrors == previousErrors) {
                    // A diagnostic write must not replace the command exception.
                    try { UiDriver.CommandError("command threw"); }
                    catch (Exception diagnosticError) { }
                }
            } finally { commandLine = previousLine; }
        }
    }

    static void CommandError(string reason) {
        commandErrors = commandErrors + 1;
        UiDriver.Note("COMMAND ERROR line=" + Convert.ToString(commandLine) + " " + reason);
    }
}
