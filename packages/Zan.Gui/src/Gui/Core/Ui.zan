using System;

namespace Gui;

// 为 immediate-mode 控件提供的统一交互查询辅助函数。
// 每个控件的 Render() 返回一个 int id（从 App 的 focus
// 管理器分配并注册为命中区域）。这些静态辅助函数在一个地方
// 回答有关此类 id 的常见交互问题，每个控件
// 不再需要自己的 WasClicked/IsHovered 样板代码，应用
// 代码也能统一阅读：
// if (Ui.Clicked(app, save)) { ... }
public class Ui {
    private static App ResolveApp(App app) {
        if (app != null) { return app; }
        return App.FrameApp();
    }

    // 在鼠标主键于 `id` 上释放的那一帧返回 true
    // （即点击在控件上完成）。使用 App 一次性解析的
    // 点击目标（指针下最顶层的控件，含弹出层），因此
    // 点击只投递给一个控件，而不是每一个与其重叠的控件。
    // 重新读取原始事件，修复遮挡/重复处理。
    public static bool Clicked(App app, int id) {
        app = Ui.ResolveApp(app);
        if (app == null) { return false; }
        return app.Clicked(id);
    }
    public static bool Clicked(int id) {
        return Ui.Clicked(null, id);
    }

    // 精确自绘命中在矩形候选 owner 上的点击所有权。
    // 几何命中仍由调用方完成；此处只保证不会穿透上层控件。
    public static bool OwnsClick(App app, int id) {
        app = Ui.ResolveApp(app);
        if (app == null) { return false; }
        return app.OwnsClick(id);
    }
    public static bool OwnsClick(int id) {
        return Ui.OwnsClick(null, id);
    }

    // 按下（鼠标按下）落在 `id`（最上层目标）的帧为 true。
    public static bool PressedDown(App app, int id) {
        app = Ui.ResolveApp(app);
        if (app == null) { return false; }
        return app.PressedDown(id);
    }
    public static bool PressedDown(int id) {
        return Ui.PressedDown(null, id);
    }

    // 本帧鼠标按下落在其他控件上时为 true，
    // 弹窗据此在外部点击时自动关闭。
    public static bool PressedOutside(App app, int id) {
        app = Ui.ResolveApp(app);
        if (app == null) { return false; }
        return app.PressedOutside(id);
    }
    public static bool PressedOutside(int id) {
        return Ui.PressedOutside(null, id);
    }

    // 指针悬停在控件上时为 true。
    public static bool Hovered(App app, int id) {
        app = Ui.ResolveApp(app);
        if (app == null) { return false; }
        return app.Hovered(id);
    }
    public static bool Hovered(int id) {
        return Ui.Hovered(null, id);
    }

    // 指针落在矩形 [x,y,w,h] 内且没有被上层弹层/遮罩接管时
    // 为 true。凡是按几何自己算悬停的即时模式表面都该走这里：
    // 直接比较 app.mouseX/mouseY 的写法看不见画在它上面的
    // 下拉弹层，点击就会穿透到下面那一层。
    public static bool Over(App app, int x, int y, int w, int h) {
        app = Ui.ResolveApp(app);
        if (app == null) { return false; }
        return app.Over(x, y, w, h);
    }
    public static bool Over(int x, int y, int w, int h) {
        return Ui.Over(null, x, y, w, h);
    }

    // 本帧的主键释放落在 [x,y,w,h] 内，且该点击既未被认领
    // 也不属于上层弹层时为 true（按几何处理点击的表面用它
    // 代替 `EventKind() == 3` + 自己比坐标）。
    public static bool ClickedIn(App app, int x, int y, int w, int h) {
        app = Ui.ResolveApp(app);
        if (app == null) { return false; }
        return app.ClickedIn(x, y, w, h);
    }
    public static bool ClickedIn(int x, int y, int w, int h) {
        return Ui.ClickedIn(null, x, y, w, h);
    }

    // 控件作为按下（mouse-down）目标时为 true。
    public static bool Pressed(App app, int id) {
        app = Ui.ResolveApp(app);
        if (app == null) { return false; }
        return app.Pressed(id);
    }
    public static bool Pressed(int id) {
        return Ui.Pressed(null, id);
    }

    // 控件持有键盘焦点时为 true。
    public static bool Focused(App app, int id) {
        app = Ui.ResolveApp(app);
        if (app == null) { return false; }
        return app.Focused(id);
    }
    public static bool Focused(int id) {
        return Ui.Focused(null, id);
    }

    // 按钮按住且指针仍停留在其上时为 true，
    // 即绘制按下外观所用的“armed”（待触发）状态。
    public static bool Active(App app, int id) {
        app = Ui.ResolveApp(app);
        if (app == null) { return false; }
        return app.Active(id);
    }
    public static bool Active(int id) {
        return Ui.Active(null, id);
    }

    // 当前指针下方的控件 id，无则 -1。
    public static int HotId(App app) {
        app = Ui.ResolveApp(app);
        if (app == null) { return -1; }
        return app.HotId();
    }
    public static int HotId() {
        return Ui.HotId(null);
    }

    // 本帧任意左键释放时为 true（与目标无关）。
    public static bool MouseReleased(App app) {
        app = Ui.ResolveApp(app);
        if (app == null) { return false; }
        return app.MouseReleased();
    }
    public static bool MouseReleased() {
        return Ui.MouseReleased(null);
    }

    // 本帧任意左键按下时为 true。
    public static bool MousePressed(App app) {
        app = Ui.ResolveApp(app);
        if (app == null) { return false; }
        return app.MousePressed();
    }
    public static bool MousePressed() {
        return Ui.MousePressed(null);
    }

    // ---- 过渡 + 键盘 + 触摸事件 -------------------------------
    // 这些函数把实时焦点/悬停状态与上一渲染帧的
    // 快照（FocusManager.RollFrame，在 App.PresentFrame 中调用）对比，
    // 因此每个事件恰好会在状态翻转的那一帧触发。

    // 指针首次移入 `id`（mouse-enter）的帧为 true。触摸屏上
    // 没有悬停，故该事件与按下重合。
    public static bool Entered(App app, int id) {
        app = Ui.ResolveApp(app);
        if (app == null) { return false; }
        return app.Entered(id);
    }
    public static bool Entered(int id) {
        return Ui.Entered(null, id);
    }

    // 指针首次离开 `id`（mouse-leave）的帧为 true。
    public static bool Left(App app, int id) {
        app = Ui.ResolveApp(app);
        if (app == null) { return false; }
        return app.Left(id);
    }
    public static bool Left(int id) {
        return Ui.Left(null, id);
    }

    // `id` 获得键盘焦点的帧为 true。
    public static bool FocusGained(App app, int id) {
        app = Ui.ResolveApp(app);
        if (app == null) { return false; }
        return app.FocusGained(id);
    }
    public static bool FocusGained(int id) {
        return Ui.FocusGained(null, id);
    }

    // `id` 失去键盘焦点的帧为 true。
    public static bool FocusLost(App app, int id) {
        app = Ui.ResolveApp(app);
        if (app == null) { return false; }
        return app.FocusLost(id);
    }
    public static bool FocusLost(int id) {
        return Ui.FocusLost(null, id);
    }

    // `id` 上完成双击/双触的帧为 true
    // （双击窗口内对同一控件的两次点击）。
    public static bool DoubleClicked(App app, int id) {
        app = Ui.ResolveApp(app);
        if (app == null) { return false; }
        return app.DoubleClicked(id);
    }
    public static bool DoubleClicked(int id) {
        return Ui.DoubleClicked(null, id);
    }

    // 本帧按键按下事件的键码，没有则为 0。（事件
    // 类型 4 为按键按下；键码为平台虚拟键值。）
    public static int KeyDown(App app) {
        app = Ui.ResolveApp(app);
        if (app == null) { return 0; }
        return app.KeyDown();
    }
    public static int KeyDown() {
        return Ui.KeyDown(null);
    }

    // 本帧按下指定键码的按键时为 true。
    public static bool KeyPressed(App app, int code) {
        app = Ui.ResolveApp(app);
        if (app == null) { return false; }
        return app.KeyPressed(code);
    }
    public static bool KeyPressed(int code) {
        return Ui.KeyPressed(null, code);
    }

    // 触摸/指针轻点：等同于 `id` 上的完成点击。命名
    // 为触摸代码的清晰；单指轻点以合成点击送达。
    public static bool Tapped(App app, int id) {
        app = Ui.ResolveApp(app);
        if (app == null) { return false; }
        return app.Tapped(id);
    }
    public static bool Tapped(int id) {
        return Ui.Tapped(null, id);
    }

    // 本释放帧完成的滑动/轻扫方向：0 无，
    // 1 左、2 右、3 上、4 下。支持鼠标拖拽与单点触摸。
    public static int Swipe(App app) {
        app = Ui.ResolveApp(app);
        if (app == null) { return 0; }
        return app.Swipe();
    }
    public static int Swipe() {
        return Ui.Swipe(null);
    }

    // 方向为 `dir`（1 左 / 2 右 / 3 上 / 4 下）的滑动
    // 在手势起始控件 `id` 上完成时为 true。
    public static bool SwipedOn(App app, int id, int dir) {
        app = Ui.ResolveApp(app);
        if (app == null) { return false; }
        return app.SwipedOn(id, dir);
    }
    public static bool SwipedOn(int id, int dir) {
        return Ui.SwipedOn(null, id, dir);
    }

    // `id` 上触发长按/长触的帧为 true（按住超过
    // 阈值且未大幅移动）。每次按下只触发一次。
    public static bool LongPressed(App app, int id) {
        app = Ui.ResolveApp(app);
        if (app == null) { return false; }
        return app.LongPressed(id);
    }
    public static bool LongPressed(int id) {
        return Ui.LongPressed(null, id);
    }

    // ---- 指针抬起 / 移动 / 滚轮 ------------------------------------------

    // 在 `id` 上按下后松开按钮的帧为 true，
    // （即使指针移开，mouse-up 仍送达按下所属控件）。
    public static bool MouseUpOn(App app, int id) {
        app = Ui.ResolveApp(app);
        if (app == null) { return false; }
        return app.MouseUpOn(id);
    }
    public static bool MouseUpOn(int id) {
        return Ui.MouseUpOn(null, id);
    }

    // 指针悬停 `id` 期间发生移动的帧为 true（mouse-move）。
    public static bool MovedOver(App app, int id) {
        app = Ui.ResolveApp(app);
        if (app == null) { return false; }
        return app.focus.IsHovered(id) && app.EventKind() == 1;
    }
    public static bool MovedOver(int id) {
        return Ui.MovedOver(null, id);
    }

    // 指针在 `id` 上时滚轮帧为 true。用 WheelDelta(app)
    // 读取有符号格数（>0 表示向上/远离用户）。
    public static bool Wheeled(App app, int id) {
        app = Ui.ResolveApp(app);
        if (app == null) { return false; }
        return app.focus.IsHovered(id) && app.EventKind() == 13;
    }
    public static bool Wheeled(int id) {
        return Ui.Wheeled(null, id);
    }

    // 本帧的有符号滚轮增量（非滚轮帧为 0）。运行时
    // 将格数打包进滚轮事件的键码槽位。
    public static int WheelDelta(App app) {
        app = Ui.ResolveApp(app);
        if (app == null || app.EventKind() != 13) { return 0; }
        return app.window.EventKeyCode();
    }
    public static int WheelDelta() {
        return Ui.WheelDelta(null);
    }

    // ---- 键盘（焦点目标）------------------------------------------

    // 本帧有按键按下且 `id` 持有焦点时为 true。用
    // KeyDown(app) 读取键码。
    public static bool KeyDownOn(App app, int id) {
        app = Ui.ResolveApp(app);
        if (app == null || app.EventKind() != 4) { return false; }
        return app.focus.IsFocused(id);
    }
    public static bool KeyDownOn(int id) {
        return Ui.KeyDownOn(null, id);
    }

    // 本帧按键释放事件的键码，没有则为 0。（事件类型 5
    // 为按键释放；键码为平台虚拟键值。）
    public static int KeyUp(App app) {
        app = Ui.ResolveApp(app);
        if (app == null || app.EventKind() != 5) { return 0; }
        return app.window.EventKeyCode();
    }
    public static int KeyUp() {
        return Ui.KeyUp(null);
    }

    // 本帧释放指定键码的按键时为 true。
    public static bool KeyReleased(App app, int code) {
        return Ui.KeyUp(app) == code;
    }
    public static bool KeyReleased(int code) {
        return Ui.KeyReleased(null, code);
    }

    // 焦点控件上的按键释放（事件类型 5）。用 KeyUp(app)
    // 读取键码。
    public static bool KeyUpOn(App app, int id) {
        app = Ui.ResolveApp(app);
        if (app == null || app.EventKind() != 5) { return false; }
        return app.focus.IsFocused(id);
    }
    public static bool KeyUpOn(int id) {
        return Ui.KeyUpOn(null, id);
    }

    // ---- 右键 / 上下文菜单 ----------------------------------------

    // `id` 上的次键（右键）点击：右
    // 鼠标按钮在其按下的控件上松开时为 true。App
    // 只解析一次右键目标（指针下最上层），因此
    // 只送达一个控件，且不会触发主 Clicked。
    public static bool RightClicked(App app, int id) {
        app = Ui.ResolveApp(app);
        if (app == null) { return false; }
        return app.RightClicked(id);
    }
    public static bool RightClicked(int id) {
        return Ui.RightClicked(null, id);
    }

    // `id` 上按下右键的帧为 true。
    public static bool RightPressedDown(App app, int id) {
        app = Ui.ResolveApp(app);
        if (app == null) { return false; }
        return app.RightPressedDown(id);
    }
    public static bool RightPressedDown(int id) {
        return Ui.RightPressedDown(null, id);
    }

    // ---- 手势 / 拖拽（单指针合成）-----------------------

    // 松开时，任意方向滑动在
    // 手势起始控件 `id` 上完成则为 true。
    public static bool SwipedAny(App app, int id) {
        app = Ui.ResolveApp(app);
        if (app == null) { return false; }
        return app.SwipedAny(id);
    }
    public static bool SwipedAny(int id) {
        return Ui.SwipedAny(null, id);
    }

    // `id` 为按下目标且指针在移动时为 true（拖拽进行中）。
    // 与 DragStart（按下）/ Drop（松开）搭配使用。
    public static bool Dragging(App app, int id) {
        app = Ui.ResolveApp(app);
        if (app == null) { return false; }
        return app.Dragging(id);
    }
    public static bool Dragging(int id) {
        return Ui.Dragging(null, id);
    }

    // 在 `id` 上按下后松开时为 true（drop / 拖拽结束）。
    public static bool Dropped(App app, int id) {
        app = Ui.ResolveApp(app);
        if (app == null) { return false; }
        return app.Dropped(id);
    }
    public static bool Dropped(int id) {
        return Ui.Dropped(null, id);
    }

    // ---- 缓动交互等级（平滑悬停 / 按下 / 焦点动画）--
    // 这些函数返回缓动的 0..1000 强度，跟随布尔悬停 /
    // 按下 / 焦点状态在短时间内过渡，控件即可交叉淡化
    // 颜色、辉光或偏移，而不是在指针进入/离开的帧硬切换。
    // 由 App 动画时钟（App.AnimTo）驱动，它持续
    // 请求重绘直到补间收敛，因此即使指针已离开，
    // 淡出也会播放。键位于保留的高区间（每个 id 为
    // 悬停/按下/焦点各留一个槽位），以免与控件自身的补间冲突
    // （Switch 用 id，Checkbox 200000+id，Tabs 600000+..）。这些 id 是
    // 每帧的小型控件句柄，远低于这些偏移量。

    // 交互 `kind` 的默认缓动过渡时长（ms）
    // （0 悬停 / 1 按下 / 2 焦点），取自当前皮肤的动画
    // 令牌，使主题掌控全局交互手感。按下比悬停更干脆，
    // 焦点则稍慢。无主题/令牌时回退到
    // 120/80/140 ms 默认值。
    static int ThemeMs(App app, int kind) {
        app = Ui.ResolveApp(app);
        if (app == null) {
            if (kind == 1) { return 80; }
            if (kind == 2) { return 140; }
            return 120;
        }
        Theme t = app.theme;
        if (t == null) {
            if (kind == 1) { return 80; }
            if (kind == 2) { return 140; }
            return 120;
        }
        if (kind == 1) {
            int m = t.animFastMs * 4 / 5;
            if (m <= 0) { m = 80; }
            return m;
        }
        if (kind == 2) {
            int m = t.animMediumMs * 7 / 10;
            if (m <= 0) { m = 140; }
            return m;
        }
        int h = t.animFastMs;
        if (h <= 0) { h = 120; }
        return h;
    }

    // 缓动悬停等级（0..1000），过渡时长取主题令牌（ThemeMs kind 0）。
    public static int HoverLevel(App app, int id) {
        return Ui.HoverLevelMs(app, id, Ui.ThemeMs(app, 0));
    }
    public static int HoverLevel(int id) {
        return Ui.HoverLevel(null, id);
    }

    // 带显式过渡时长的缓动悬停等级，使控件的
    // CSS `transition`（Control.styleTransitionMs）可以覆盖默认的
    // 120ms 交叉淡化。`ms <= 0` 时回退默认。
    public static int HoverLevelMs(App app, int id, int ms) {
        app = Ui.ResolveApp(app);
        if (app == null) { return 0; }
        int target = 0;
        if (app.focus.IsHovered(id)) { target = 1000; }
        if (ms <= 0) { ms = 120; }
        return app.AnimTo(IdHash.HashInt(id, 301), target, ms);
    }
    public static int HoverLevelMs(int id, int ms) {
        return Ui.HoverLevelMs(null, id, ms);
    }

    // 同 HoverLevelMs，但补间期间的动画重绘请求限定在矩形
    // [x,y,w,h] 内（见 App.AnimToIn）。
    public static int HoverLevelMsIn(App app, int id, int ms,
                                     int x, int y, int w, int h) {
        app = Ui.ResolveApp(app);
        if (app == null) { return 0; }
        int target = 0;
        if (app.focus.IsHovered(id)) { target = 1000; }
        if (ms <= 0) { ms = 120; }
        return app.AnimToIn(IdHash.HashInt(id, 301), target, ms, x, y, w, h);
    }
    public static int HoverLevelMsIn(int id, int ms, int x, int y, int w, int h) {
        return Ui.HoverLevelMsIn(null, id, ms, x, y, w, h);
    }

    // 触摸长按等价的提示门控：触摸设备上正按住 `id`、指针
    // 仍在矩形内且按住已达 900ms（与悬停提示阈值一致）时为真。
    // 桌面恒假——提示继续走悬停通道。阈值前安排低频唤醒帧，
    // 静止按住（没有输入事件）也能推进到阈值并绘制气泡。
    // 与长按菜单共存的原则：已有长按语义的区域不加此门控。
    public static bool HoldTipIn(App app, int id, int x, int y, int w, int h) {
        app = Ui.ResolveApp(app);
        if (app == null || !app.TouchDevice()) { return false; }
        if (!app.focus.IsPressed(id)) { return false; }
        if (app.mouseX < x || app.mouseX >= x + w
            || app.mouseY < y || app.mouseY >= y + h) { return false; }
        int held = app.HeldPressMs();
        if (held >= 900) { return true; }
        app.RequestWakeFrameIn(80);
        return false;
    }
    public static bool HoldTipIn(int id, int x, int y, int w, int h) {
        return Ui.HoldTipIn(null, id, x, y, w, h);
    }

    // 缓动的“armed”等级：仅当按下且指针仍停留在控件上时为 1000，
    // 松开时缓动回落（比悬停更干脆）。
    // 缓动 armed 等级（0..1000），过渡时长取主题令牌（ThemeMs kind 1）。
    public static int PressLevel(App app, int id) {
        return Ui.PressLevelMs(app, id, Ui.ThemeMs(app, 1));
    }
    public static int PressLevel(int id) {
        return Ui.PressLevel(null, id);
    }

    // 带显式过渡时长的 armed 等级（ms <= 0 回退 80ms）。
    public static int PressLevelMs(App app, int id, int ms) {
        app = Ui.ResolveApp(app);
        if (app == null) { return 0; }
        int target = 0;
        if (app.focus.IsPressed(id) && app.focus.IsHovered(id)) { target = 1000; }
        if (ms <= 0) { ms = 80; }
        return app.AnimTo(IdHash.HashInt(id, 302), target, ms);
    }
    public static int PressLevelMs(int id, int ms) {
        return Ui.PressLevelMs(null, id, ms);
    }

    // 同 PressLevelMs，但补间期间的动画重绘请求限定在矩形内。
    public static int PressLevelMsIn(App app, int id, int ms,
                                     int x, int y, int w, int h) {
        app = Ui.ResolveApp(app);
        if (app == null) { return 0; }
        int target = 0;
        if (app.focus.IsPressed(id) && app.focus.IsHovered(id)) { target = 1000; }
        if (ms <= 0) { ms = 80; }
        return app.AnimToIn(IdHash.HashInt(id, 302), target, ms, x, y, w, h);
    }
    public static int PressLevelMsIn(int id, int ms, int x, int y, int w, int h) {
        return Ui.PressLevelMsIn(null, id, ms, x, y, w, h);
    }

    // 缓动焦点等级（0..1000），过渡时长取主题令牌（ThemeMs kind 2）。
    public static int FocusLevel(App app, int id) {
        return Ui.FocusLevelMs(app, id, Ui.ThemeMs(app, 2));
    }
    public static int FocusLevel(int id) {
        return Ui.FocusLevel(null, id);
    }

    // 带显式过渡时长的焦点等级（ms <= 0 回退 140ms）。
    public static int FocusLevelMs(App app, int id, int ms) {
        app = Ui.ResolveApp(app);
        if (app == null) { return 0; }
        int target = 0;
        if (app.focus.IsFocused(id)) { target = 1000; }
        if (ms <= 0) { ms = 140; }
        return app.AnimTo(IdHash.HashInt(id, 303), target, ms);
    }
    public static int FocusLevelMs(int id, int ms) {
        return Ui.FocusLevelMs(null, id, ms);
    }

    // 同 FocusLevelMs，但补间期间的动画重绘请求限定在矩形内。
    public static int FocusLevelMsIn(App app, int id, int ms,
                                     int x, int y, int w, int h) {
        app = Ui.ResolveApp(app);
        if (app == null) { return 0; }
        int target = 0;
        if (app.focus.IsFocused(id)) { target = 1000; }
        if (ms <= 0) { ms = 140; }
        return app.AnimToIn(IdHash.HashInt(id, 303), target, ms, x, y, w, h);
    }
    public static int FocusLevelMsIn(int id, int ms, int x, int y, int w, int h) {
        return Ui.FocusLevelMsIn(null, id, ms, x, y, w, h);
    }

    // 缓动的悬停抬升像素：静止为 0，悬停时缓动升至 `maxPx`
    // （离开时回落）。悬停时按此值上移控件视觉，
    // 形成轻微浮起；命中区域保持静止矩形，悬停才稳定。
    public static int LiftLevel(App app, int id, int maxPx) {
        return maxPx * Ui.HoverLevel(app, id) / 1000;
    }
    public static int LiftLevel(int id, int maxPx) {
        return Ui.LiftLevel(null, id, maxPx);
    }

    // 让一个矩形可交互并上报本帧激活：注册
    // 命中区域和焦点停靠点，然后响应指针点击或 Enter/Space
    // （聚焦时）。所有可点击控件共用此逻辑，键盘激活
    // 与命中注册就不会被重复实现（或遗漏）。
    static bool Activate(App app, int id, int x, int y, int w, int h) {
        return Ui.ActivateL(app, id, x, y, w, h, "");
    }

    // 带无障碍与语义标签的激活注册。
    static bool ActivateL(App app, int id, int x, int y, int w, int h, string label) {
        app = Ui.ResolveApp(app);
        if (app == null) { return false; }
        if (label != "") {
            app.hitTester.RegisterRectL(id, x, y, w, h, 0, label);
        } else {
            app.hitTester.RegisterRect(id, x, y, w, h, 0);
        }
        app.focus.RegisterFocusable(id);
        if (Ui.Clicked(app, id)) { return true; }
        if (Ui.Focused(app, id) && app.EventKind() == 4) {
            int kc = app.window.EventKeyCode();
            if (kc == 13 || kc == 32) {
                app.RequestRedraw();
                return true;
            }
        }
        return false;
    }

    // Material 风格点击涟漪：从按下瞬间捕获的起点向外扩张并
    // 淡出的圆盘（480ms），裁剪在控件矩形内。仅当 `id` 是本帧
    // 按下目标时绘制，动画期间按宿主显示刷新率调度重绘帧。
    public static void Ripple(App app, int id, int x, int y, int w, int h, int color) {
        app = Ui.ResolveApp(app);
        if (app == null) { return; }
        if (app.SwipeTarget() != id) { return; }
        int dur = 480;
        int el = app.nowMs - app.pressStartMs;
        if (el < 0 || el >= dur) { return; }
        int p = el * 1000 / dur;
        int ease = App.Ease(p);
        int ox = app.pressStartX;
        int oy = app.pressStartY;
        // 用最远边距约束圆盘，使其始终覆盖整个矩形。
        int dl = ox - x; int dr = x + w - ox;
        int dt = oy - y; int db = y + h - oy;
        int mx = dl; if (dr > mx) { mx = dr; }
        int my = dt; if (db > my) { my = db; }
        int reach = mx + my;
        int rr = reach * ease / 1000;
        int a = App.Lerp(70, 0, p);
        Canvas c = app.canvas;
        c.PushClip(x, y, w, h);
        c.FillCircle(ox, oy, rr, App.WithAlpha(color, a));
        c.PopClip();
        app.RequestAnimationFrameIn(x, y, w, h);
    }
    public static void Ripple(int id, int x, int y, int w, int h, int color) {
        Ui.Ripple(null, id, x, y, w, h, color);
    }
}
