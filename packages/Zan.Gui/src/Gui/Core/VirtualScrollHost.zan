using System;

namespace Gui;

// 虚拟滚动与视口计算原语（VirtualScrollHost）。
// 为 VirtualList、DataTable、Tree 等虚拟化视口组件提供统一、零堆分配的
// 视口切片、滚动距离裁剪、行号映射与分页计算。
public class VirtualScrollHost {
    // 根据总项数、可见视口高度与单项高度计算可见行数（向上取整 + 1 缓冲行）
    public static int CalcVisibleCount(int viewHeight, int itemHeight) {
        if (itemHeight <= 0 || viewHeight <= 0) { return 0; }
        return (viewHeight + itemHeight - 1) / itemHeight + 1;
    }

    // 裁剪起始行号，确保不超出 [0, max(0, total - visibleCount)]
    public static int ClampStartRow(int requestedStart, int totalCount, int visibleCount) {
        if (totalCount <= 0) { return 0; }
        int maxStart = totalCount - visibleCount;
        if (maxStart < 0) { maxStart = 0; }
        if (requestedStart > maxStart) { return maxStart; }
        if (requestedStart < 0) { return 0; }
        return requestedStart;
    }

    // 计算分页模式下的总页数
    public static int CalcTotalPages(int totalCount, int pageSize) {
        if (totalCount <= 0 || pageSize <= 0) { return 1; }
        return (totalCount + pageSize - 1) / pageSize;
    }

    // 裁剪当前页码到合法区间 [1, totalPages]
    public static int ClampPage(int currentPage, int totalPages) {
        if (currentPage > totalPages) { return totalPages; }
        if (currentPage < 1) { return 1; }
        return currentPage;
    }

    // 计算指定行在视口中的 Y 坐标（考虑像素滚动或行滚动偏移）
    public static int RowY(int viewportY, int rowIndex, int startRow, int itemHeight) {
        return viewportY + (rowIndex - startRow) * itemHeight;
    }

    // 计算鼠标点击的 Y 坐标落在哪个项索引上（-1 表示不在合法项内）
    public static int HitIndex(int clickY, int viewportY, int startRow, int itemHeight, int totalCount) {
        if (itemHeight <= 0 || clickY < viewportY) { return -1; }
        int idx = startRow + (clickY - viewportY) / itemHeight;
        if (idx < 0 || idx >= totalCount) { return -1; }
        return idx;
    }
}
