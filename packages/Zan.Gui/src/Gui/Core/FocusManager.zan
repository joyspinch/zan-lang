using System;
using System.Collections.Generic;
using Gui.Backend;
namespace Gui;
public class FocusManager {
    int focusedId;
    weak App owner;
    weak Control focusedControl;
    private long focusRevision;
    private List<Control> retiringFocusRoots;
    void BindApp(App app) { owner = app; }
    bool FocusBelongsTo(Control root) {
        Control control = focusedControl;
        return root != null && control != null && root.ContainsInputControl(control);
    }
    Control ResolveFocusedControl() {
        App app = owner;
        if (app == null) { return null; }
        Control popup = app.overlayHost != null ? app.overlayHost.ActiveRoot() : null;
        Control found = app.FindFocusedControl(popup);
        return found != null ? found : app.FindFocusedControl(app.rootControl);
    }
    int hoveredId;
    int pressedId;
    int hoverStartMs;
    int nextId;
    List<int> scopeReturn;
    int imeSessionId;
    List<int> idStack;
    List<int> seqStack;
    int scopeAutoSeq;
    FocusManager() {
        focusedId = -1;
        hoveredId = -1;
        pressedId = -1;
        hoverStartMs = 0;
        nextId = 0;
        scopeReturn = new List<int>();
        imeSessionId = -1;
        idStack = new List<int>();
        seqStack = new List<int>();
        scopeAutoSeq = 0;
    }
    int CurrentScopeId() {
        if (idStack != null && idStack.Count > 0) { return idStack[idStack.Count - 1]; }
        return 0x811C9DC5;
    }
    int GetId(string strKey) { return IdHash.HashString(strKey, this.CurrentScopeId()); }
    int GetId(int intKey) { return IdHash.HashInt(intKey, this.CurrentScopeId()); }
    void PushId(string strKey) {
        int id = this.GetId(strKey);
        idStack.Add(id);
        seqStack.Add(scopeAutoSeq);
        scopeAutoSeq = 0;
    }
    void PushId(int intKey) {
        int id = this.GetId(intKey);
        idStack.Add(id);
        seqStack.Add(scopeAutoSeq);
        scopeAutoSeq = 0;
    }
    void PopId() {
        if (idStack != null && idStack.Count > 0) { idStack.RemoveAt(idStack.Count - 1); }
        if (seqStack != null && seqStack.Count > 0) {
            scopeAutoSeq = seqStack[seqStack.Count - 1];
            seqStack.RemoveAt(seqStack.Count - 1);
        } else {
            scopeAutoSeq = 0;
        }
    }
    int AllocId() {
        if (idStack != null && idStack.Count > 0) {
            int baseId = this.CurrentScopeId();
            int id = baseId + scopeAutoSeq;
            scopeAutoSeq = scopeAutoSeq + 1;
            return id;
        }
        int id = nextId;
        nextId = nextId + 1;
        return id;
    }
    void PushIds(int first) {
        scopeReturn.Add(nextId);
        nextId = first;
        this.PushId(first);
    }
    void PopIds() {
        if (scopeReturn.Count == 0) { return; }
        nextId = scopeReturn[scopeReturn.Count - 1];
        scopeReturn.RemoveAt(scopeReturn.Count - 1);
        this.PopId();
    }
    void ResetIds() {
        nextId = 0;
        if (scopeReturn != null) { scopeReturn.Clear(); } else { scopeReturn = new List<int>(); }
        if (idStack != null) { idStack.Clear(); }
        if (seqStack != null) { seqStack.Clear(); }
        scopeAutoSeq = 0;
    }
    Control CurrentInputRoot() {
        App app = owner;
        if (app == null) { return null; }
        Control popup = app.overlayHost != null ? app.overlayHost.ActiveRoot() : null;
        return popup != null ? popup : app.rootControl;
    }
    bool CurrentEndpoint(Control control, Control root) {
        return control != null && control.InputFocusEligible(owner, root);
    }
    void FocusStep(int dir) {
        Control root = this.CurrentInputRoot();
        if (root == null) { return; }
        List<Control> controls = new List<Control>();
        root.CollectInputFocus(owner, controls);
        List<int> ids = new List<int>();
        List<Control> endpoints = new List<Control>();
        for (int i = 0; i < controls.Count; i = i + 1) {
            Control control = controls[i];
            if (!this.CurrentEndpoint(control, root)) { continue; }
            int id = control.WidgetId();
            if (ids.Contains(id)) { continue; }
            ids.Add(id); endpoints.Add(control);
        }
        if (ids.Count == 0 || this.CurrentInputRoot() != root) { return; }
        int idx = ids.IndexOf(focusedId);
        int next = 0;
        if (idx < 0) {
            next = dir >= 0 ? 0 : ids.Count - 1;
        } else {
            int raw = (idx + dir) % ids.Count;
            next = raw < 0 ? raw + ids.Count : raw;
        }
        this.SetFocused(ids[next], endpoints[next]);
    }
    bool IsFocused(int id) { return focusedId == id; }
    bool IsHovered(int id) { return hoveredId == id; }
    bool IsPressed(int id) { return pressedId == id; }
    void UpdateImeSession() {
        int want = -1;
        Control control = focusedControl;
        if (control != null && this.CurrentEndpoint(control, this.CurrentInputRoot())
        && control.WidgetId() == focusedId
        && (control.InputFocusCapabilities() & 2) != 0) { want = focusedId; }
        if (want == imeSessionId) { return; }
        imeSessionId = want;
        Ime.SetOpen(want >= 0);
    }
    void SetFocused(int id) { this.SetFocused(id, null); }
    private bool HostedEndpoint(Control control) {
        App app = owner;
        if (app == null) { return false; }
        Control popup = app.overlayHost != null ? app.overlayHost.ActiveRoot() : null;
        return this.CurrentEndpoint(control, app.rootControl) || this.CurrentEndpoint(control, popup);
    }
    private bool InsideRetiredFocus(Control control, List<Control> roots) {
        if (control == null || roots == null) { return false; }
        for (int i = 0; i < roots.Count; i = i + 1) {
            if (roots[i] != null && roots[i].ContainsHostedControl(control)) { return true; }
        }
        return false;
    }
    void ReconcileFocus(Control retired) {
        if (retired == null || !retired.ContainsHostedControl(focusedControl)
        || this.HostedEndpoint(focusedControl)) { return; }
        List<Control> roots = new List<Control>(); roots.Add(retired);
        this.ReconcileFocus(roots);
    }
    void ReconcileFocus(List<Control> retired) {
        Control current = focusedControl;
        if (!this.InsideRetiredFocus(current, retired) || this.HostedEndpoint(current)) { return; }
        List<Control> previous = retiringFocusRoots;
        List<Control> roots = retired;
        if (previous != null) {
            roots = new List<Control>(); roots.AddRange(previous); roots.AddRange(retired);
        }
        retiringFocusRoots = roots;
        try { this.ClearFocus(); }
        finally { retiringFocusRoots = previous; }
    }
    void SetFocused(int id, Control control) {
        if (this.InsideRetiredFocus(control, retiringFocusRoots) && !this.HostedEndpoint(control)) { return; }
        if (focusedId == id && (control == null || focusedControl == control)) {
            this.UpdateImeSession();
            return;
        }
        Control previous = focusedControl;
        focusRevision = focusRevision + 1;
        long revision = focusRevision;
        focusedId = id;
        Control current = id >= 0 ? (control != null ? control : this.ResolveFocusedControl()) : null;
        focusedControl = current;
        this.UpdateImeSession();
        if (previous != null) {
            if (previous.ResolveApp(null) == owner) { previous.OnInputFocusLost(); }
            if (previous.ResolveApp(null) == owner) { previous.TriggerEvent("Blur"); }
            if (focusRevision != revision) { return; }
        }
        if (current != null && focusedControl == current && focusedId == id
        && this.HostedEndpoint(current)) {
            current.TriggerEvent("Focus");
        }
    }
    void SetHovered(int id) {
        if (id != hoveredId) { hoverStartMs = Window.GetTickMs(); }
        hoveredId = id;
    }
    int HoveredMs() { return Window.GetTickMs() - hoverStartMs; }
    void SetPressed(int id) { pressedId = id; }
    void ClearHover() { hoveredId = -1; }
    void ClearPress() { pressedId = -1; }
    void ClearFocus() { this.SetFocused(0 - 1); }
}
