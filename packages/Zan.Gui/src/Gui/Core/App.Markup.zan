using System;
using Gui.Backend;

namespace Gui;

public partial class App {
    // 链接扫描槽（声明层 <a href> 接线）：Gui.Html.Install() 注册
    // Html.AutoLinkTree；ModelBinder.WireNode 二次接线经 App.AutoLinkTree
    // 走这里（Core 不向上认识 Markup，靠委托槽反转）。
    public static LinkScanFn linkScanner;
    public static void SetLinkScanner(LinkScanFn fn) { linkScanner = fn; }

    // 对一棵树做 <a href> 缺省导航接线（P5）。静态：无宿主进程
    // （headless 测试）也能走，app 为 null 时扫描器自行容忍。
    // 未安装 HTML 声明层时空操作——树里没有声明层 <a> 可扫。
    static void AutoLinkTree(Control root, App app) {
        if (linkScanner != null) { linkScanner(root, app); }
    }

    // 模板行克隆槽：ModelBinder.For 展开声明层 `data-for` 模板行时经
    // 这里取原型深拷贝（Gui.Html.Install() 注册 Html.Clone）。
    // 未安装 HTML 声明层时返回 null——那时也没有 template 原型
    // 可展开，调用方按空行跳过。静态：无宿主也能走空槽语义。
    static Control CloneTree(Control root) {
        if (cloneTree != null) { return cloneTree(root); }
        return null;
    }

    // 克隆后端槽：由 Gui.Html.Install() 注册，业务代码不要直接调。
    static CloneTreeFn cloneTree;
    static void SetCloneTree(CloneTreeFn fn) { cloneTree = fn; }

    // 帧呈现尾段挂点表（AppHookFn）：重家族在自身入口处自挂
    // （如 ChartView 首帧渲染时挂 ChartView.FlushTooltips）。
    static List<AppHookFn> presentTails;

    // 注册帧呈现尾段回调（重复注册以一次为准由调用方自行保证）。
    static void AddPresentTail(AppHookFn fn) {
        if (presentTails == null) { presentTails = new List<AppHookFn>(); }
        presentTails.Add(fn);
    }

    // 装载作用域类名（zs-load-<序>）由装载后端领取：每次装载唯一，
    // 多次装载的同名类互不串（Gui.Markup.HtmlScope 共用实现）。
    string NextLoadScope() {
        string zs = "zs-load-" + Convert.ToString(htmlLoadSeq);
        htmlLoadSeq = htmlLoadSeq + 1;
        return zs;
    }

    // 装载后端的落树收尾：作用域 CSS 并进 appCss 链、整树补作用
    // 域类（Html.Load 建树后调用；App 只提供作用域设施，不背装载）。
    void ApplyScopedTree(Control root, string scopedCss, string zs) {
        string merged = appCss == "" ? scopedCss : appCss + "\n" + scopedCss;
        this.UseAppCss(merged);
        this.MarkScope(root, zs);
    }

    // 给装载树每个元素补作用域类（编译通道由生成码逐节点 AddClass，
    // 运行期树建好了，走一遍后处理）。
    void MarkScope(Control n, string zs) {
        n.AddClass(zs);
        for (int i = 0; i < n.ChildCount(); i = i + 1) {
            this.MarkScope(n.children[i], zs);
        }
    }



































    // 将壁纸快速拷贝到 [x,y,w,h]，居中裁剪覆盖，使图片
    // 保持宽高比，然后淡入到下方皮肤背景中。
    void RenderWallpaperImage(int x, int y, int w, int h) {
        if (bgImagePath == "") { return; }
        int iw = Canvas.ImageWidth(bgImagePath);
        int ih = Canvas.ImageHeight(bgImagePath);
        if (iw <= 0 || ih <= 0) { return; }
        // 目标尺寸为零会在下面的覆盖比例中除零。
        if (w <= 0 || h <= 0) { return; }
        // 覆盖：与目标宽高比一致的最大居中源矩形。
        int sw = iw;
        int sh = ih;
        if (iw * h > w * ih) {
            sw = w * ih / h;
        } else {
            sh = h * iw / w;
        }
        if (sw < 1) { sw = 1; }
        if (sh < 1) { sh = 1; }
        canvas.BlitImage(bgImagePath, x, y, w, h,
                         (iw - sw) / 2, (ih - sh) / 2, sw, sh);
        // 向皮肤背景淡出：以页面色绘制遮罩，强度为
        // 所请求不透明度的补值。皮肤自身的美术
        // 本就是为背景设计的——它以全强度呈现，由
        // 半透明表面完成混合——因此只有用户选择的
        // 壁纸才加遮罩。
        int fade = 100 - this.WallpaperOpacity();
        if (fade > 0 && !this.SkinArtWallpaper()) {
            StyleBox fadeStyle = Style.Part(this, "windowbg", "fade", "",
                                            "", "", Style.SNormal());
            int fadeBg = fadeStyle.BgOr(0);
            int rgb = fadeBg % 16777216;
            if (rgb < 0) { rgb = rgb + 16777216; }
            canvas.FillRect(x, y, w, h, (fade * 255 / 100) * 16777216 + rgb);
        }
    }

    // ---- 主题化窗口背景（内置，所有窗口共用） ---------
    // 让渐变/玻璃/霓虹皮肤显得真实的壁纸：
    // 垂直渐变加上磨砂面板模糊掉的柔和色斑。
    // 它位于框架中，使 IDE、画廊与任何窗口渲染出相同的
    // 皮肤——应用只需在内容后面调用 RenderBackground。

    // 单个柔和壁纸光晕：平滑径向渐隐到明亮的中心（无
    // 生硬边缘），为背景模糊提供可柔化的真实色彩。
    void BackdropBlob(int cx, int cy, int r, int cr, int cg, int cb) {
        // 一次逐像素径向渐隐（Canvas.FillRadial），而非叠加多个
        // 半透明圆盘：叠加的圆盘会在边缘形成可见的"靶心"环带，
        // 而这是一次拷贝而不是 20 次。
        canvas.FillRadial(cx, cy, r, Theme.Rgb(cr, cg, cb), 150);
    }

    // 由打包 ARGB 主题强调色着色的柔和光晕。
    void BackdropDrift(int cx, int cy, int r, int color) {
        int cr = (color / 65536) % 256;
        int cg = (color / 256) % 256;
        int cb = color % 256;
        this.BackdropBlob(cx, cy, r, cr, cg, cb);
    }

    // 在垂直渐变上叠加来自主题强调色的色斑
    // （非玻璃渐变预设），使渐变更像壁纸。
    void BackdropGradientWallpaper(int ax, int ay, int aw, int ah) {
        StyleBox primaryStyle = Style.Part(this, "windowbg", "blob", "",
                                            "", "", Style.SNormal());
        StyleBox infoStyle = Style.Part(this, "windowbg", "blob", "",
                                        "info", "", Style.SNormal());
        StyleBox successStyle = Style.Part(this, "windowbg", "blob", "",
                                           "success", "", Style.SNormal());
        StyleBox errorStyle = Style.Part(this, "windowbg", "blob", "",
                                         "error", "", Style.SNormal());
        int r = this.Scale(340);
        this.BackdropDrift(ax + aw * 20 / 100, ay + ah * 24 / 100, r,
                           primaryStyle.BgOr(0));
        this.BackdropDrift(ax + aw * 74 / 100, ay + ah * 18 / 100, r,
                           infoStyle.BgOr(0));
        this.BackdropDrift(ax + aw * 82 / 100, ay + ah * 72 / 100, r,
                           successStyle.BgOr(0));
        this.BackdropDrift(ax + aw * 30 / 100, ay + ah * 84 / 100, r,
                           errorStyle.BgOr(0));
    }

    // 为磨砂玻璃预设准备的 iOS 风格多彩壁纸。
    void BackdropGlassWallpaper(int ax, int ay, int aw, int ah) {
        this.BackdropBlob(ax + aw * 14 / 100, ay + ah * 20 / 100,
            this.Scale(320), 128, 96, 245);
        this.BackdropBlob(ax + aw * 40 / 100, ay + ah * 34 / 100,
            this.Scale(300), 236, 120, 175);
        this.BackdropBlob(ax + aw * 78 / 100, ay + ah * 16 / 100,
            this.Scale(320), 96, 156, 255);
        this.BackdropBlob(ax + aw * 62 / 100, ay + ah * 72 / 100,
            this.Scale(340), 240, 112, 196);
        this.BackdropBlob(ax + aw * 30 / 100, ay + ah * 86 / 100,
            this.Scale(300), 96, 222, 208);
        this.BackdropBlob(ax + aw * 90 / 100, ay + ah * 58 / 100,
            this.Scale(280), 156, 120, 250);
    }

    // 将当前皮肤的窗口背景绘制到 [x,y,w,h]：渐变 +
    // 柔和色斑（用于渐变/玻璃预设，使磨砂面板能模糊
    // 真实色彩），否则为纯色 bgPrimary 填充。每次重绘缓存——
    // 仅动画的帧用一次拷贝恢复像素，而非
    // 重绘（昂贵的）色斑。`slot` 是调用方
    // 为其背景预留的快照缓存槽。
    void RenderBackground(int x, int y, int w, int h, int slot) {
        Canvas c = canvas;
        Theme t = theme;
        // 异形窗口：表面在 BeginFrame 里被清成 alpha 0，操作系统
        // 只负责按轮廓合成，轮廓内的像素仍要自己画——所以这里
        // 用皮肤底色铺满每个形状区域（先画投影，再铺底），
        // 设计里没有铺满窗口的背景控件时，窗口才不会整个透明。
        // 参数是内容区坐标（调用方按 ContentTop/ClientWidth 布局），
        // 这里忽略：轮廓与阴影带覆盖整幅表面，按画布坐标一次画完。
        if (shapeMode != 0) {
            if (shapeShadow > 0) { this.PaintShapeShadow(); }
            this.PaintShapeFill();
            return;
        }
        // 原生玻璃：窗口是一张扁平的半透明薄片（在
        // BeginFrame 中清除），覆盖在 OS 模糊的桌面之上。加上柔和的从上到下
        // 光泽，使玻璃具有纵深（顶部更亮），如同真实的
        // 亚克力而非一块平板。
        if (glassNative) {
            StyleBox sheenStyle = Style.Part(this, "windowbg", "sheen", "",
                                             "", "", Style.SNormal());
            int hi = sheenStyle.BgOr(0) % 16777216;
            if (hi < 0) { hi = hi + 16777216; }
            int bands = 18;
            int bh = h / 3 / bands;
            if (bh < 1) { bh = 1; }
            for (int i = 0; i < bands; i = i + 1) {
                int a = 15 - (15 * i / bands);
                c.FillRect(x, y + i * bh, w, bh, a * 16777216 + hi);
            }
            return;
        }
        if (t.gradient != 0 || bgImagePath != "") {
            // 壁纸（渐变 + 柔和色斑）对每个皮肤+尺寸是静态的，因此
            // 每帧从快照恢复——包括脏帧——
            // 只要皮肤代次匹配。只有皮肤变更
            // （bgThemeGen 递增）或尺寸变化（RestoreRect 几何不匹配）
            // 才触发昂贵的重绘。这使玻璃/渐变皮肤在
            // 滚动或输入时保持流畅，而非每帧重新绘制色斑。
            bool restored = false;
            if (bgSnapGen == bgThemeGen) {
                restored = c.RestoreRect(x, y, w, h, slot);
            }
            if (!restored) {
                if (t.gradient != 0) {
                    c.FillVGrad(x, y, w, h, t.bgGradTop, t.bgGradBottom);
                    if (t.glass != 0) {
                        this.BackdropGlassWallpaper(x, y, w, h);
                    } else {
                        this.BackdropGradientWallpaper(x, y, w, h);
                    }
                } else {
                    StyleBox bgStyle = Style.Full(this, "windowbg", "", "",
                                                  Style.SNormal());
                    c.FillRect(x, y, w, h, bgStyle.BgOr(0));
                }
                this.RenderWallpaperImage(x, y, w, h);
                c.SnapshotRect(x, y, w, h, slot);
                bgSnapGen = bgThemeGen;
            }
        } else {
            StyleBox bgStyle = Style.Full(this, "windowbg", "", "",
                                          Style.SNormal());
            c.FillRect(x, y, w, h, bgStyle.BgOr(0));
        }
    }

    // 用皮肤底色铺满异形窗口的轮廓（见 RenderBackground）。
    // 类型 3 的阴影带只是把系统表面撑大，不参与填充。
    // 填充铺满整个轮廓：内容贴着窗口边缘，投影从轮廓边缘向外
    // 衰减到阴影带里（见 PaintShapeShadow）；落在轮廓内的那半圈
    // 衰减带被这张不透明底色盖住，不会脏到内容。
    void PaintShapeFill() {
        if (shapeRegions == null || shapeRegions.Count == 0) {
            return;
        }
        Canvas c = canvas;
        StyleBox shapeStyle = Style.Part(this, "windowbg", "shape", "",
                                          "", "", Style.SNormal());
        int col = shapeStyle.BgOr(0);
        if (col == 0) {
            StyleBox bgStyle = Style.Full(this, "windowbg", "", "",
                                          Style.SNormal());
            col = bgStyle.BgOr(0);
        }
        if (col == 0) {
            StyleBox winStyle = Style.Part(this, "window", "base", "", "", "", Style.SNormal());
            col = winStyle.BgOr(0xFF2D2D30);
        }
        if (col == 0) { col = 0xFF2D2D30; }

        for (int ri = 0; ri < shapeRegions.Count; ri = ri + 1) {
            WindowShapeRegion reg = shapeRegions[ri];
            if (reg.kind != 3) {
                int x = this.Scale(reg.x);
                int y = this.Scale(reg.y);
                int w = this.Scale(reg.width);
                int h = this.Scale(reg.height);
                int r = this.Scale(reg.radius);
                if (r < 0) { r = 0; }
                if (w > 0 && h > 0) {
                    if (reg.kind == 2) {
                        this.FillEllipse(x, y, w, h, col);
                    } else if (r > 0) {
                        c.FillRoundRect(x, y, w, h, r, col);
                    } else {
                        c.FillRect(x, y, w, h, col);
                    }
                }
            }
        }
    }

    // 椭圆填充（渲染器只有正圆），按行扫描：轮廓由
    // 操作系统裁剪，这里只要把里面填实。
    void FillEllipse(int x, int y, int w, int h, int col) {
        if (w <= 0 || h <= 0) { return; }
        Canvas c = canvas;
        int rx = w / 2;
        int ry = h / 2;
        if (rx <= 0 || ry <= 0) { return; }
        int cx = x + rx;
        int cy = y + ry;
        for (int dy = 0 - ry; dy <= ry; dy = dy + 1) {
            int inside = ry * ry - dy * dy;
            if (inside <= 0) { continue; }
            int hw = rx * App.ISqrt(inside) / ry;
            if (hw <= 0) { continue; }
            c.FillRect(cx - hw, cy + dy, hw * 2, 1, col);
        }
    }

    // 整数平方根（向下取整）。
    static int ISqrt(int v) {
        if (v <= 0) { return 0; }
        int r = 0;
        int bit = 1073741824;
        int rest = v;
        while (bit > rest) { bit = bit / 4; }
        while (bit != 0) {
            if (rest >= r + bit) {
                rest = rest - r - bit;
                r = (r / 2) + bit;
            } else {
                r = r / 2;
            }
            bit = bit / 4;
        }
        return r;
    }

    // 将异形轮廓的柔和投影绘制到表面，
    // 位于控件树之下（由 RenderBackground 调用）。每个非阴影带区域
    // 以圆角 SDF 一次出图（Canvas.ShadowRoundRect）——外轮廓到
    // 圆角形状的有符号距离在 blur 带上做 smoothstep 衰减，每个像素
    // 只写一次，半透明阴影色合成到标称 alpha，角部衰减连续。
    // 类型 3 阴影带区域（由 formgen 为 winShadow 添加）只扩展
    // OS 表面，不投射阴影。
    void PaintShapeShadow() {
        if (shapeRegions == null || shapeRegions.Count == 0 || shapeShadow <= 0) {
            return;
        }
        Canvas c = canvas;
        int blur = this.Scale(shapeShadow);
        if (blur <= 0) { return; }
        StyleBox shadowStyle = Style.Part(this, "windowbg", "shape-shadow",
                                           "", "", "", Style.SNormal());
        int baseCol = shadowStyle.BgOr(0);
        if (baseCol == 0) { baseCol = 0x55000000; }
        // 峰值 alpha：主题的阴影着色。火绒及现代桌面贴边约三到四成黑，
        // 向外自然平滑衰减。
        int peak = (baseCol >> 24) & 255;
        if (peak < 80) { peak = 80; }
        if (peak > 110) { peak = 110; }
        int rgb = baseCol % 16777216;
        if (rgb < 0) { rgb = rgb + 16777216; }

        for (int ri = 0; ri < shapeRegions.Count; ri = ri + 1) {
            WindowShapeRegion reg = shapeRegions[ri];
            if (reg.kind == 3) { continue; }
            int x = this.Scale(reg.x);
            int y = this.Scale(reg.y);
            int w = this.Scale(reg.width);
            int h = this.Scale(reg.height);
            int r = this.Scale(reg.radius);
            if (r < 0) { r = 0; }
            if (w <= 0 || h <= 0) { continue; }
            c.ShadowRoundRect(x, y, w, h, r, blur * 2, (peak << 24) | rgb);
        }
    }

    // 当前生效的背景效果类型：设置了绘制器覆盖项则用覆盖项，
    // 否则用皮肤自身的效果。0 = 无。
    int EffectiveFx() {
        if (fxKindOverride >= 0) { return fxKindOverride; }
        return theme.fx;
    }

    // 当前皮肤的动画背景效果运行中时为 true。
    // 异形窗口上绝不运行：效果层会合成到整个
    // 表面，粒子会点亮轮廓之外
    // 的透明像素而非设计本身。
    bool FxActive() {
        return fxEnabled && this.EffectiveFx() != 0 && !glassNative
            && shapeMode == 0;
    }

    // 启用/禁用此窗口皮肤的动态背景效果。
    void SetBackdropFx(bool on) {
        fxEnabled = on;
        fxSnapValid = false;
        fxTouched = null;
        fxTouchedFull = false;
        if (!on) { fxNextMs = -1; }
        this.NoteRedrawWhy("SetBackdropFx");
        needsRedraw = true;
    }

    // 从 Gui 动画库（Gui.BackdropFx）中选择动态背景效果：
    // 传 KindXxx() 常量覆盖皮肤自带效果，传 0 关闭，
    // 传 -1 恢复跟随当前皮肤。
    void SetFxKind(int kind) {
        if (fxKindOverride == kind) { return; }
        fxKindOverride = kind;
        fxSnapValid = false;
        fxTouched = null;
        fxTouchedFull = false;
        this.NoteRedrawWhy("SetFxKind");
        needsRedraw = true;
    }

    // 纯效果帧：恢复上次完整渲染帧的快照，
    // 在其上重新合成皮肤效果并呈现。当
    // 无有效快照时返回 false（调用方回退为完整渲染），
    // 例如在尺寸变化之后。
    bool FxPresent() { return this.FxPresent(true); }

    bool FxPresent(bool present) {
        // 纯特效拍与局部帧无关：它不渲染控件树，只是整窗恢复快照 +
        // 重合成特效 + 整窗提交，partialFrames 关闭（默认）时同样正确。
        // 此前按 ForceFullFrames 一票否决，等于在默认配置下把快速路径
        // 整个废掉——背景动画每拍都退回整窗控件重栅（实测首帧 36ms），
        // 任何持续动画（如倒计时）加入后 CPU 光栅饱和，一卡一卡。
        if (!fxSnapValid || !this.FxActive()) { fxNextMs = -1; return false; }
        int perfFxT0 = 0;
        int perfFxRestoreT0 = 0;
        int perfFxRenderT0 = 0;
        int perfFxPresentT0 = 0;
        if (App.PerfOn()) {
            perfFxT0 = Window.GetTickUs();
            perfFxRestoreT0 = perfFxT0;
        }
        if (!window.IsVisible()) {
            // 窗口不可见（最小化或完全被遮挡）：停止
            // 计时。仅失去焦点的窗口仍在屏幕上，
            // 其背景继续动画。任何事件——包括
            // 可见性唤醒——都会重新武装效果（ProcessEvent /
            // ApplyEvent）。
            fxNextMs = -1;
            return true;
        }
        Canvas fc = canvas;
        int cw = fc.Width();
        int chh = fc.Height();
        // 修复自快照以来特效触及过的全部区域（fxTouched），而不是
        // 只有上一拍的矩形：光斑在移动，只修上一拍会让更早各拍的
        // 像素以幽灵色块的形式留在画布与屏幕上。
        bool fullRepair = fxTouchedFull || fxTouched == null;
        bool ok;
        if (App.PerfOn()) {
            File.AppendAllText("zan_frame_perf.log",
                "fxp full=" + (fullRepair ? 1 : 0)
                + " n=" + (fxTouched == null ? 0 : fxTouched.Count / 4)
                + "\n");
        }
        if (fullRepair) {
            ok = fc.RestoreRect(0, 0, cw, chh, App.FxSnapSlot());
        } else {
            ok = true;
            int i = 0;
            while (ok && i + 3 < fxTouched.Count) {
                ok = fc.RestoreSubRect(fxTouched[i], fxTouched[i + 1],
                                       fxTouched[i + 2], fxTouched[i + 3],
                                       App.FxSnapSlot());
                i = i + 4;
            }
        }
        if (!ok) {
            fxSnapValid = false;
            return false;
        }
        if (App.PerfOn()) {
            perfFxRestoreUs = perfFxRestoreUs
                + (Window.GetTickUs() - perfFxRestoreT0);
            perfFxRenderT0 = Window.GetTickUs();
        }
        int fxPhaseMs = Window.GetTickMs();
        BackdropFx.PaintFx(this, fc, this.EffectiveFx(), 0, 0, cw, chh,
                          fxPhaseMs, theme, dpiScale);
        // 本拍把屏幕上的特效相位推进到了 fxPhaseMs：记入 fxFrameMs，
        // 否则随后的损伤裁剪帧（悬停条带）仍按上一整帧的旧相位在
        // 条带内重合成特效，与条带外已在屏幕上的新相位错开——
        // 条带边界处就会出现一块矩形鬼影。
        fxFrameMs = fxPhaseMs;
        List<int> fresh = BackdropFx.TakeDamage();
        fxDamage = fresh;
        // 并入本拍损伤，得到下一拍的修复清单；累计过大时改走
        // 全帧恢复（本拍已经全恢复了就直接以本拍损伤重新起算）。
        if (fullRepair) {
            fxTouched = fresh;
            fxTouchedFull = false;
            if (fresh != null && fresh.Count / 4 > 1024) { fxTouchedFull = true; }
        } else {
            int i = 0;
            while (i + 3 < fresh.Count) {
                fxTouched.Add(fresh[i]);
                fxTouched.Add(fresh[i + 1]);
                fxTouched.Add(fresh[i + 2]);
                fxTouched.Add(fresh[i + 3]);
                i = i + 4;
            }
            long area = 0;
            i = 0;
            while (i + 3 < fxTouched.Count) {
                area = area + (long)fxTouched[i + 2] * fxTouched[i + 3];
                i = i + 4;
            }
            if (fxTouched.Count / 4 > 1024
                || area * 2 > (long)cw * chh) {
                fxTouchedFull = true;
            }
        }
        // 损伤声明直到原生 Present 才消费。页面同拍时仍推进整窗 Fx，
        // 但只登记新旧损伤；页面保持自己的裁剪，帧尾一次上传并集。
        if (fullRepair) {
            window.PresentDirty(0, 0, cw, chh);
        } else {
            this.MarkPresentDirty(fxTouched);
        }
        if (App.PerfOn()) { perfFxPresentT0 = Window.GetTickUs(); }
        if (present) {
            window.Present(canvas);
        } else {
            fxPagePending = true;
        }
        if (App.PerfOn()) {
            int perfFxEndUs = Window.GetTickUs();
            perfFxRenderUs = perfFxRenderUs
                + (perfFxPresentT0 - perfFxRenderT0);
            if (present) {
                perfFxPresentUs = perfFxPresentUs
                    + (perfFxEndUs - perfFxPresentT0);
                perfFxOnlyTicks = perfFxOnlyTicks + 1;
            }
            perfFxTickUs = perfFxTickUs + (perfFxEndUs - perfFxT0);
            perfFxTicks = perfFxTicks + 1;
            perfFxTickMs = perfFxTickMs
                + (perfFxEndUs - perfFxT0) / 1000;
            this.PerfMaybeFlushLoop(Window.GetTickMs());
        }
        if (present) {
            lastPresentMs = Window.GetTickMs();
            this.ScheduleFxFrame();
        }
        return true;
    }

    int FxIntervalMs() {
        return (int)Math.Ceiling(1000.0 / frameCadence.Rate());
    }

    void ScheduleFxFrame() {
        frameCadence.SetRate(window.RefreshRate());
        frameCadence.Begin(Stopwatch.GetMicroseconds());
        displayFxPending = window.RequestDisplayFrame();
        int wait = displayFxPending
            ? 100 : frameCadence.WaitMilliseconds(Stopwatch.GetMicroseconds());
        fxNextMs = Window.GetTickMs() + wait;
    }

    // 将下次重绘标记为损伤裁剪帧，覆盖指针
    // 离开的控件与进入的控件（带内边距，使焦点环与细线
    // 位于命中区外侧时也包含在内）。同一事件处理中
    // 任何其他重绘原因都会通过 CancelPartialFrame() 取消它。
}
