using System;

namespace Gui;

// 为可视化设计器和序列化器描述 Control 的一个可编辑属性，
// 以及读写它的方式。控件从 Props() 返回其列表，
// 并把每个 spec 指向它编辑的字段：
// icon.str = Icon;            // 编译器合成的访问器对
// ps.Add(icon);
// 因为 spec 携带访问器对，`Control.GetProp/SetProp` 就能
// 泛化地读写每个属性——控件只声明一次属性，
// 而不必在三个字符串匹配方法里重复。
// kind：0 文本，1 整数，2 布尔，3 枚举（见 `options`），4 颜色，5 分组标题。
public class PropSpec {
    string key;
    // 同一属性在文档中应答的附加键（布尔标志的 "checked on"、
    // "value" 等）；序列化器从不回写它们。
    string alias;
    string label;
    int kind;
    List<string> options;
    // 绑定的字段，按 `kind` 三者取其一。在这里给字段赋值
    // 即成为实时绑定，值会直接读写
    // 到控件；给已有 Binding 赋值则共享它。
    Binding<string> str;
    Binding<int> num;
    Binding<bool> flag;
    // A control schema names its field, without capturing the current Binding.
    // Editor rows may still hold their own local Binding above.
    private string member;
    private int memberKind;
    private int memberStorage;

    public PropSpec Field(string name, int valueKind) {
        if (name == null || name == "" || valueKind < 0 || valueKind > 2) {
            throw new ArgumentException("A property field requires a name and a string, int or bool value kind.");
        }
        member = name;
        memberKind = valueKind;
        memberStorage = -1;
        return this;
    }

    private int Storage(Control owner) {
        if (memberStorage >= 0) { return memberStorage; }
        TypeInfo type = owner.GetType();
        for (int i = 0; i < type.FieldCount; i = i + 1) {
            if (type.GetFieldName(i) != member) { continue; }
            string declared = type.GetFieldType(i);
            string scalar = "string";
            if (memberKind == 1) { scalar = "int"; }
            else if (memberKind == 2) { scalar = "bool"; }
            if (declared == scalar) { memberStorage = 0; return 0; }
            if (declared == "System.Binding<" + scalar + ">" || declared == "Binding<" + scalar + ">") {
                memberStorage = 1;
                return 1;
            }
            throw new InvalidOperationException("Property field has an incompatible type: " + member);
        }
        throw new InvalidOperationException("Property field does not exist: " + member);
    }

    public string ReadFrom(Control owner) {
        if (ExtraAccess) { return owner.GetProp(key); }
        if (member == "") { return this.Read(); }
        bool binding = this.Storage(owner) == 1;
        if (memberKind == 0) {
            if (!binding) { return owner.GetFieldString(member); }
            Binding<string> value = (Binding<string>)owner.GetFieldObject(member);
            return value != null ? value.Get() : "";
        }
        if (memberKind == 1) {
            if (!binding) { return Convert.ToString(owner.GetFieldInt(member)); }
            Binding<int> value = (Binding<int>)owner.GetFieldObject(member);
            return Convert.ToString(value != null ? value.Get() : 0);
        }
        if (!binding) { return PropSpec.Flag(owner.GetFieldBool(member)); }
        Binding<bool> value = (Binding<bool>)owner.GetFieldObject(member);
        return PropSpec.Flag(value != null && value.Get());
    }

    public void WriteTo(Control owner, string val) {
        if (ExtraAccess) { owner.SetProp(key, val); return; }
        if (member == "") { this.Write(val); return; }
        bool binding = this.Storage(owner) == 1;
        if (memberKind == 0) {
            if (!binding) { owner.SetFieldString(member, val); return; }
            Binding<string> value = (Binding<string>)owner.GetFieldObject(member);
            if (value != null) { value.Set(val); }
            else { Binding<string> created = val; owner.SetFieldObject(member, created); }
            return;
        }
        if (memberKind == 1) {
            if (!this.AcceptNumber(val)) { return; }
            int number = this.NumberValue(val);
            if (!binding) { owner.SetFieldInt(member, number); return; }
            Binding<int> value = (Binding<int>)owner.GetFieldObject(member);
            if (value != null) { value.Set(number); }
            else { Binding<int> created = number; owner.SetFieldObject(member, created); }
            return;
        }
        bool flagValue = PropSpec.IsOn(val);
        if (!binding) { owner.SetFieldBool(member, flagValue); return; }
        Binding<bool> value = (Binding<bool>)owner.GetFieldObject(member);
        if (value != null) { value.Set(flagValue); }
        else { Binding<bool> created = flagValue; owner.SetFieldObject(member, created); }
    }

    private bool AcceptNumber(string val) {
        if (kind == 4 || PropSpec.IsIntText(val)) { return true; }
        if (kind == 3) {
            for (int i = 0; i < options.Count; i = i + 1) {
                if (options[i] == val) { return true; }
            }
        }
        return false;
    }

    private int NumberValue(string val) {
        if (kind == 4) { return PropSpec.ColorInt(val); }
        if (kind == 3) {
            for (int i = 0; i < options.Count; i = i + 1) {
                if (options[i] == val) { return i; }
            }
        }
        return Convert.ToInt32(val);
    }
    // 属性的说明文字：在属性面板中悬停该行时以气泡提示展示，
    // 解释这个属性的作用。为空则不显示提示。
    string tip;
    // 整数属性(kind==1)的步进配置：`step` 为 +/- 按钮每次增减量，
    // `lo`/`hi` 为取值范围。`hasRange` 为 true 时才做范围钳制。
    int step;
    int lo;
    int hi;
    bool hasRange;
    // 属性的默认值（"恢复默认值"用，VS 口径）：值用文档形态的字符串
    // （与 Read() 同一表示）。`hasDef` 为 false 时该属性不提供复位
    // 入口——"没有默认值"与"默认值恰好是空串"是两回事，不能混。
    string defVal;
    bool hasDef;
    public bool halfRow;
    // 默认模型属性可有文本/数字两个投影；访问仍由 Control 的虚属性协议完成。
    bool defaultBinding;
    // Computed projections keep their semantic setter/getter in Control's Extra hooks.
    // This is descriptor metadata only: never cache an instance Binding globally.
    public bool ExtraAccess;

    public PropSpec ViaExtra() {
        ExtraAccess = true;
        return this;
    }

    // Resolve aliases against one freshly obtained descriptor list. PropOf keeps
    // its historical bound-only contract; property dispatch may include Extra projections.
    public static PropSpec Find(List<PropSpec> specs, string key, bool boundOnly) {
        for (int i = 0; i < specs.Count; i = i + 1) {
            PropSpec p = specs[i];
            if (p.Answers(key) && (p.IsBound() || (!boundOnly && p.ExtraAccess))) { return p; }
        }
        return null;
    }

    public PropSpec DefaultBinding() {
        defaultBinding = true;
        return this;
    }

    // 编辑器 kind 不等于值类型：枚举可能绑定字符串，也可能绑定数字。
    // 无字段的计算属性沿用声明的 kind。
    public int ValueKind() {
        if (member != "") { return memberKind; }
        if (str != null) { return 0; }
        if (flag != null) { return 2; }
        if (num != null) { return 1; }
        if (kind == 1 || kind == 4) { return 1; }
        if (kind == 2) { return 2; }
        return 0;
    }

    PropSpec(string k, string lbl, int kd) {
        key = k;
        alias = "";
        label = lbl;
        kind = kd;
        options = new List<string>();
        str = null;
        member = "";
        memberKind = 0;
        memberStorage = -1;
        tip = "";
        step = 1;
        lo = 0;
        hi = 0;
        hasRange = false;
        defVal = "";
        hasDef = false;
        halfRow = false;
    }

    // 声明该属性的默认值（返回 this，便于链式调用）。属性网格在
    // "当前值 ≠ 默认值"时给出复位入口。
    public PropSpec Default(string v) {
        defVal = v != null ? v : "";
        hasDef = true;
        return this;
    }

    // 该属性是否声明了默认值。
    public bool HasDefault() { return hasDef; }

    // 声明的默认值（文档形态字符串；未声明时为 ""）。
    public string DefaultValue() { return defVal; }

    // 标记该属性占半行：与同组的下一个 halfRow 属性合并在一行内等分布局，消除纵向堆叠和过高遮挡
    public PropSpec Half() {
        halfRow = true;
        return this;
    }

    bool IsBound() {
        return member != "" || str != null || num != null || flag != null;
    }

    // 当 `key` 命名该属性（自身键或某个别名）时为 true。
    bool Answers(string k) {
        return key == k || Style.Has(alias, k);
    }

    // 给属性挂一段说明（返回 this，便于链式调用）。属性面板
    // 悬停该行时以气泡提示展示。
    PropSpec WithTip(string t) {
        tip = t;
        return this;
    }

    // 配置整数属性的 +/- 步进与范围（返回 this，便于链式调用）。
    // `s` 为每次步进量，`min`/`max` 为钳制范围。
    PropSpec Step(int s, int min, int max) {
        step = s;
        lo = min;
        hi = max;
        hasRange = true;
        return this;
    }

    // 只配置步进量、不做范围钳制。
    PropSpec StepBy(int s) {
        step = s;
        return this;
    }

    // 把 `v` 钳制到已配置范围内（未配置范围时原样返回）。
    int Clamp(int v) {
        if (!hasRange) { return v; }
        if (v < lo) { return lo; }
        if (v > hi) { return hi; }
        return v;
    }

    // 在文档中也应答 `k`（返回 this，便于链式调用）。
    PropSpec Also(string k) {
        if (alias == "") { alias = k; }
        else { alias = alias + " " + k; }
        return this;
    }

    // 属性值的字符串形式，即设计器与文档格式交换所用的形式
    // （标志为 `"true"`/`"false"`，数字为十进制）。
    string Read() {
        if (str != null) { return str.Get(); }
        if (num != null) { return Convert.ToString(num.Get()); }
        if (flag != null) { return PropSpec.Flag(flag.Get()); }
        return "";
    }

    // 按 `val` 字符串写回绑定：数字/布尔做解析（IsOn/ToInt32），
    // 文本原样写入；未绑定任何字段/signal 时为空操作。
    // 枚举属性（kind 3）还收选项文本：`SetProp("orient",
    // "vertical")` 写入的是该选项的下标。只认数字序号的话，
    // strtoll 对非数字串静默返回 0，"vertical" 会无声落回第一项。
    void Write(string val) {
        if (str != null) { str.Set(val); return; }
        if (num != null) {
            if (this.AcceptNumber(val)) { num.Set(this.NumberValue(val)); }
            return;
        }
        if (flag != null) { flag.Set(PropSpec.IsOn(val)); }
    }

    // 颜色属性的文档值 → 打包 0xAARRGGBB。整数字面（历史形态）
    // 按打包色直读，其余按 CSS 颜色文本解析；解析不出来落 0
    // （= 未设置，与既有"垃圾值落 0"一致）。
    static int ColorInt(string val) {
        if (val == null) { return 0; }
        string t = val.Trim();
        if (t == "") { return 0; }
        if (PropSpec.IsIntText(t)) { return Convert.ToInt32(t); }
        Color c = Color.Parse(t);
        return c.ToARGB();
    }

    // 是否十进制整数字面（可带前导负号）。
    static bool IsIntText(string s) {
        if (s == null || s.Length == 0) { return false; }
        int i = 0;
        if ((s[0] & 255) == 45) {
            if (s.Length == 1) { return false; }
            i = 1;
        }
        for (; i < s.Length; i = i + 1) {
            int c = s[i] & 255;
            if (c < 48 || c > 57) { return false; }
        }
        return true;
    }

    // 布尔的文档字符串形式（"true"/"false"）。
    static string Flag(bool on) {
        if (on) { return "true"; }
        return "false";
    }

    // 文档字符串是否表示开启（"true" 或 "1"）。
    static bool IsOn(string val) {
        return val == "true" || val == "1";
    }

    // 工厂：文本属性（kind 0）。
    static PropSpec Text(string k, string lbl) { return new PropSpec(k, lbl, 0); }
    // 工厂：整数属性（kind 1）。
    static PropSpec Int(string k, string lbl) { return new PropSpec(k, lbl, 1); }
    // 工厂：布尔属性（kind 2）。
    static PropSpec Bool(string k, string lbl) { return new PropSpec(k, lbl, 2); }
    // 工厂：颜色属性（kind 4）。
    static PropSpec Color(string k, string lbl) { return new PropSpec(k, lbl, 4); }

    // 字段即属性：键与标签从字段名派生（`CheckedText` → 键 `checkedText`、
    // 标签 `Checked text`），控件不必再把同一个名字写三遍。键或标签与
    // 字段名不一致时仍用上面的显式工厂加 `Field()`。
    public static PropSpec TextField(string field) {
        return PropSpec.Text(PropSpec.KeyOf(field), PropSpec.LabelOf(field)).Field(field, 0);
    }
    public static PropSpec IntField(string field) {
        return PropSpec.Int(PropSpec.KeyOf(field), PropSpec.LabelOf(field)).Field(field, 1);
    }
    public static PropSpec BoolField(string field) {
        return PropSpec.Bool(PropSpec.KeyOf(field), PropSpec.LabelOf(field)).Field(field, 2);
    }
    // 颜色字段按打包 ARGB 整数存储（0 = 跟随皮肤）。
    public static PropSpec ColorField(string field) {
        return PropSpec.Color(PropSpec.KeyOf(field), PropSpec.LabelOf(field)).Field(field, 1);
    }

    // 字段名 → 文档键：首字母小写。
    public static string KeyOf(string field) {
        if (field == null || field.Length == 0) { return ""; }
        return field.Substring(0, 1).ToLower() + field.Substring(1);
    }

    // 字段名 → 属性面板标签：在小写/数字后的大写处断词，后续单词转小写；
    // 连续大写（缩写）保持原样（`MaxURL` → `Max URL`）。
    public static string LabelOf(string field) {
        if (field == null || field.Length == 0) { return ""; }
        string s = field.Substring(0, 1);
        for (int i = 1; i < field.Length; i = i + 1) {
            int c = field[i] & 255;
            int prev = field[i - 1] & 255;
            bool upper = c >= 65 && c <= 90;
            bool prevLowerOrDigit = (prev >= 97 && prev <= 122) || (prev >= 48 && prev <= 57);
            string ch = field.Substring(i, 1);
            if (upper && prevLowerOrDigit) {
                bool nextUpper = false;
                if (i + 1 < field.Length) {
                    int nx = field[i + 1] & 255;
                    nextUpper = nx >= 65 && nx <= 90;
                }
                s = s + " " + (nextUpper ? ch : ch.ToLower());
            } else {
                s = s + ch;
            }
        }
        return s;
    }

    // 尺寸四档选项表（tiny/small/medium/large），给
    // `PropSpec.Enum("size", "Size", PropSpec.Sizes())` 用——全库
    // 统一从这里取，免得十六处字面量各自漂移。每次调用新建列表：
    // PropSpec 持有 options 引用且 `Option()` 会追加，共享实例会串台。
    static List<string> Sizes() {
        return new List<string>{ "tiny", "small", "medium", "large" };
    }

    // 尺寸三档选项表（small/medium/large）：不带 tiny 档的控件用。
    static List<string> Sizes3() {
        return new List<string>{ "small", "medium", "large" };
    }

    // 枚举属性，值为 `opts` 之一（以其标签文本存储）。
    // 分组标题行（只有标题文字，没有值也没有编辑器）。
    static PropSpec Section(string lbl) {
        return new PropSpec("", lbl, 5);
    }

    // 枚举属性工厂，值为 `opts` 之一（以其标签文本存储）。
    static PropSpec Enum(string k, string lbl, List<string> opts) {
        PropSpec p = new PropSpec(k, lbl, 3);
        p.options = opts;
        return p;
    }

    // 追加一个枚举选项（返回 this，便于链式调用）。
    PropSpec Option(string o) {
        options.Add(o);
        return this;
    }
}
