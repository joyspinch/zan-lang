using System;
using System.Collections.Generic;
namespace Gui;
public class PropSpec {
    private static Dictionary<string, List<PropSpec>> schemaCache = new Dictionary<string, List<PropSpec>>();
    internal static List<PropSpec> FindCachedSchema(string typeName) {
        if (schemaCache == null || typeName == null || typeName == "") { return null; }
        List<PropSpec> cached = null;
        return schemaCache.TryGetValue(typeName, out cached) ? cached : null;
    }
    internal static void StoreCachedSchema(string typeName, List<PropSpec> specs) {
        if (typeName == null || typeName == "" || specs == null) { return; }
        if (schemaCache == null) { schemaCache = new Dictionary<string, List<PropSpec>>(); }
        if (schemaCache.ContainsKey(typeName)) { schemaCache.Remove(typeName); }
        schemaCache.Add(typeName, specs);
    }
    string key;
    string alias;
    string label;
    int kind;
    List<string> options;
    Binding<string> str;
    Binding<int> num;
    Binding<bool> flag;
    private string member;
    private int memberKind;
    private int memberStorage;
    public PropSpec Field(string name, int valueKind) {
        if (name == null || name == "" || valueKind < 0 || valueKind > 2) {
            throw new ArgumentException("A property field requires a name and a string, int or bool value kind.");
        }
        member = name;
        memberKind = valueKind;
        memberStorage = -1;
        return this;
    }
    private int Storage(Control owner) {
        if (memberStorage >= 0) { return memberStorage; }
        TypeInfo type = owner.GetType();
        for (int i = 0; i < type.FieldCount; i = i + 1) {
            if (type.GetFieldName(i) != member) { continue; }
            string declared = type.GetFieldType(i);
            string scalar = "string";
            if (memberKind == 1) { scalar = "int"; }
            else if (memberKind == 2) { scalar = "bool"; }
            if (declared == scalar) { memberStorage = 0; return 0; }
            if (declared == "System.Binding<" + scalar + ">" || declared == "Binding<" + scalar + ">") {
                memberStorage = 1;
                return 1;
            }
            throw new InvalidOperationException("Property field has an incompatible type: " + member);
        }
        throw new InvalidOperationException("Property field does not exist: " + member);
    }
    public string ReadFrom(Control owner) {
        if (ExtraAccess) { return owner.GetProp(key); }
        if (member == "") { return this.Read(); }
        bool binding = this.Storage(owner) == 1;
        if (memberKind == 0) {
            if (!binding) { return owner.GetFieldString(member); }
            Binding<string> value = (Binding<string>)owner.GetFieldObject(member);
            return value != null ? value.Get() : "";
        }
        if (memberKind == 1) {
            if (!binding) { return Convert.ToString(owner.GetFieldInt(member)); }
            Binding<int> value = (Binding<int>)owner.GetFieldObject(member);
            return Convert.ToString(value != null ? value.Get() : 0);
        }
        if (!binding) { return PropSpec.Flag(owner.GetFieldBool(member)); }
        Binding<bool> value = (Binding<bool>)owner.GetFieldObject(member);
        return PropSpec.Flag(value != null && value.Get());
    }
    public void WriteTo(Control owner, string val) {
        if (ExtraAccess) { owner.SetProp(key, val); return; }
        if (member == "") { this.Write(val); return; }
        bool binding = this.Storage(owner) == 1;
        if (memberKind == 0) {
            if (!binding) { owner.SetFieldString(member, val); return; }
            Binding<string> value = (Binding<string>)owner.GetFieldObject(member);
            if (value != null) { value.Set(val); }
            else { Binding<string> created = val; owner.SetFieldObject(member, created); }
            return;
        }
        if (memberKind == 1) {
            if (!this.AcceptNumber(val)) { return; }
            int number = this.NumberValue(val);
            if (!binding) { owner.SetFieldInt(member, number); return; }
            Binding<int> value = (Binding<int>)owner.GetFieldObject(member);
            if (value != null) { value.Set(number); }
            else { Binding<int> created = number; owner.SetFieldObject(member, created); }
            return;
        }
        bool flagValue = PropSpec.IsOn(val);
        if (!binding) { owner.SetFieldBool(member, flagValue); return; }
        Binding<bool> value = (Binding<bool>)owner.GetFieldObject(member);
        if (value != null) { value.Set(flagValue); }
        else { Binding<bool> created = flagValue; owner.SetFieldObject(member, created); }
    }
    private bool AcceptNumber(string val) {
        if (kind == 4 || PropSpec.IsIntText(val)) { return true; }
        if (kind == 3) {
            for (int i = 0; i < options.Count; i = i + 1) {
                if (options[i] == val) { return true; }
            }
        }
        return false;
    }
    private int NumberValue(string val) {
        if (kind == 4) { return PropSpec.ColorInt(val); }
        if (kind == 3) {
            for (int i = 0; i < options.Count; i = i + 1) {
                if (options[i] == val) { return i; }
            }
        }
        return Convert.ToInt32(val);
    }
    string tip;
    int step;
    int lo;
    int hi;
    bool hasRange;
    string defVal;
    bool hasDef;
    public bool halfRow;
    bool defaultBinding;
    public bool ExtraAccess;
    public PropSpec ViaExtra() { ExtraAccess = true; return this; }
    public static PropSpec Find(List<PropSpec> specs, string key, bool boundOnly) {
        for (int i = 0; i < specs.Count; i = i + 1) {
            PropSpec p = specs[i];
            if (p.Answers(key) && (p.IsBound() || (!boundOnly && p.ExtraAccess))) { return p; }
        }
        return null;
    }
    public PropSpec DefaultBinding() { defaultBinding = true; return this; }
    public int ValueKind() {
        if (member != "") { return memberKind; }
        if (str != null) { return 0; }
        if (flag != null) { return 2; }
        if (num != null) { return 1; }
        if (kind == 1 || kind == 4) { return 1; }
        if (kind == 2) { return 2; }
        return 0;
    }
    PropSpec(string k, string lbl, int kd) {
        key = k;
        alias = "";
        label = lbl;
        kind = kd;
        options = new List<string>();
        str = null;
        member = "";
        memberKind = 0;
        memberStorage = -1;
        tip = "";
        step = 1;
        lo = 0;
        hi = 0;
        hasRange = false;
        defVal = "";
        hasDef = false;
        halfRow = false;
    }
    public PropSpec Default(string v) {
        defVal = v != null ? v : "";
        hasDef = true;
        return this;
    }
    public bool HasDefault() { return hasDef; }
    public string DefaultValue() { return defVal; }
    public PropSpec Half() { halfRow = true; return this; }
    bool IsBound() { return member != "" || str != null || num != null || flag != null; }
    bool Answers(string k) { return key == k || Style.Has(alias, k); }
    PropSpec WithTip(string t) { tip = t; return this; }
    PropSpec Step(int s, int min, int max) {
        step = s;
        lo = min;
        hi = max;
        hasRange = true;
        return this;
    }
    PropSpec StepBy(int s) { step = s; return this; }
    int Clamp(int v) {
        if (!hasRange) { return v; }
        if (v < lo) { return lo; }
        if (v > hi) { return hi; }
        return v;
    }
    PropSpec Also(string k) {
        if (alias == "") { alias = k; }
        else { alias = alias + " " + k; }
        return this;
    }
    string Read() {
        if (str != null) { return str.Get(); }
        if (num != null) { return Convert.ToString(num.Get()); }
        if (flag != null) { return PropSpec.Flag(flag.Get()); }
        return "";
    }
    void Write(string val) {
        if (str != null) { str.Set(val); return; }
        if (num != null) {
            if (this.AcceptNumber(val)) { num.Set(this.NumberValue(val)); }
            return;
        }
        if (flag != null) { flag.Set(PropSpec.IsOn(val)); }
    }
    static int ColorInt(string val) {
        if (val == null) { return 0; }
        string t = val.Trim();
        if (t == "") { return 0; }
        if (PropSpec.IsIntText(t)) { return Convert.ToInt32(t); }
        Color c = Color.Parse(t);
        return c.ToARGB();
    }
    static bool IsIntText(string s) {
        if (s == null || s.Length == 0) { return false; }
        int i = 0;
        if ((s[0] & 255) == 45) {
            if (s.Length == 1) { return false; }
            i = 1;
        }
        for (; i < s.Length; i = i + 1) {
            int c = s[i] & 255;
            if (c < 48 || c > 57) { return false; }
        }
        return true;
    }
    static string Flag(bool on) {
        if (on) { return "true"; }
        return "false";
    }
    static bool IsOn(string val) { return val == "true" || val == "1"; }
    static PropSpec Text(string k, string lbl) { return new PropSpec(k, lbl, 0); }
    static PropSpec Int(string k, string lbl) { return new PropSpec(k, lbl, 1); }
    static PropSpec Bool(string k, string lbl) { return new PropSpec(k, lbl, 2); }
    static PropSpec Color(string k, string lbl) { return new PropSpec(k, lbl, 4); }
    static List<string> Sizes() {
        return new List<string>{ "tiny", "small", "medium", "large" };
    }
    static List<string> Sizes3() {
        return new List<string>{ "small", "medium", "large" };
    }
    static PropSpec Section(string lbl) { return new PropSpec("", lbl, 5); }
    static PropSpec Enum(string k, string lbl, List<string> opts) {
        PropSpec p = new PropSpec(k, lbl, 3);
        p.options = opts;
        return p;
    }
    PropSpec Option(string o) { options.Add(o); return this; }
}
