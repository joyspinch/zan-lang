using System;
using System.Collections.Generic;

namespace Gui;

// 发布都是安全的，也不会在非 UI 线程触碰 Zan 堆。
public class Dispatcher {
    [DllImport("crt", EntryPoint = "zan_dispatch_init")]
    static extern void PlatInit();

    [DllImport("crt", EntryPoint = "zan_dispatch_post")]
    static extern int PlatPost(Action handler);

    [DllImport("crt", EntryPoint = "zan_dispatch_take")]
    static extern Action PlatTake();

    [DllImport("crt", EntryPoint = "zan_dispatch_clear")]
    static extern void PlatClear();

    [DllImport("crt", EntryPoint = "zan_ui_thread_set")]
    static extern void PlatSetUiThread();

    [DllImport("crt", EntryPoint = "zan_ui_thread_check")]
    static extern int PlatCheckUiThread();

    [DllImport("crt", EntryPoint = "zan_ui_thread_assert")]
    static extern void PlatAssertUiThread(string msg);

    // 重置队列。在 UI 线程上、创建 worker 之前调用一次。
    static void Init() {
        Dispatcher.PlatSetUiThread();
        Dispatcher.PlatInit();
    }

    // Native queue storage/locking initializes lazily. App construction must
    // register the UI thread without resetting another window's pending work.
    // CheckUiThread also succeeds before registration: concurrent first native
    // App construction is unsupported, and offscreen Apps do not register it.
    static void EnsureInitialized() {
        Dispatcher.AssertUiThread("App construction must run on the UI thread");
        Dispatcher.PlatSetUiThread();
    }

    // 把当前线程显式注册为主 UI 线程。
    static void SetUiThread() { Dispatcher.PlatSetUiThread(); }

    // 检查当前线程是否为主 UI 线程。
    static bool CheckUiThread() { return Dispatcher.PlatCheckUiThread() != 0; }

    // 断言当前线程必须为主 UI 线程，否则中止进程并报错。
    static void AssertUiThread(string msg) { Dispatcher.PlatAssertUiThread(msg); }

    // 把要在 UI 线程运行的委托加入队列。线程安全。
    static bool Post(Action handler) { return Dispatcher.PlatPost(handler) != 0; }

    // 取出下一个排队的委托（UI 线程），为空时返回 null。
    static Action Take() { return Dispatcher.PlatTake(); }

    // 显式清空进程级队列；只供全局重置/测试，不能用于单窗口关闭。
    static void Clear() { Dispatcher.PlatClear(); }
}

