using System.Collections.Generic;

namespace Gui;

// Composes borrowed input roots without changing their parents or layout.
// Structural membership is separate from modal-sensitive input membership.
public class InputRootAdapter : Control {
    protected Control content;
    protected weak App inputApp;
    int inputLifetime;

    public InputRootAdapter(string kind) : base(kind) { }

    public bool ContainsAdapter(InputRootAdapter adapter) {
        if (adapter == null) { return false; }
        Control cursor = this;
        while (cursor is InputRootAdapter) {
            InputRootAdapter root = (InputRootAdapter)cursor;
            if (root == adapter) { return true; }
            cursor = root.content;
        }
        return false;
    }

    InputRootAdapter InputOwner(App app) {
        Control cursor = app.rootControl;
        while (cursor is InputRootAdapter) {
            InputRootAdapter owner = (InputRootAdapter)cursor;
            if (owner.content == this) { return owner; }
            cursor = owner.content;
        }
        return null;
    }

    bool OwnsInputSlot(App app, InputRootAdapter owner) {
        if (owner == null) { return app.rootControl == this; }
        InputRootAdapter active = app.rootControl is InputRootAdapter ? (InputRootAdapter)app.rootControl : null;
        return active != null && active.ContainsAdapter(owner) && owner.content == this;
    }

    public override bool ContainsHostedControl(Control control) {
        if (control == null) { return false; }
        if (base.ContainsHostedControl(control)) { return true; }
        return content != null && content.ContainsHostedControl(control);
    }

    public override void CollectInputFocus(App app, List<Control> controls) {
        if (content != null) { content.CollectInputFocus(app, controls); }
    }

    // Overlay adapters precede ordinary content/HUD adapters regardless of bind order.
    public virtual int InputPriority() { return 0; }

    public virtual void Bind(App app) {
        if (app == null) { return; }
        inputLifetime = inputLifetime + 1;
        int session = inputLifetime;
        if (inputApp != null && inputApp != app) {
            this.Detach();
            // Detach advances once; any additional advance belongs to a callback.
            if (inputLifetime != session + 1 || inputApp != null) { return; }
            session = inputLifetime;
        }
        inputApp = app;
        Control incoming = app.rootControl;
        // Reclaiming an unchanged chain must supersede an older root installation.
        // The App helper is inert outside a callback-bearing SetRootControl.
        app.FenceInputRootChange(incoming);
        if (incoming is InputRootAdapter) {
            if (((InputRootAdapter)incoming).ContainsAdapter(this)) { return; }
        }
        InputRootAdapter owner = null;
        Control slot = incoming;
        while (slot is InputRootAdapter) {
            InputRootAdapter root = (InputRootAdapter)slot;
            if (root.InputPriority() <= this.InputPriority()) { break; }
            owner = root;
            slot = root.content;
        }
        // Retain the displaced fallback before replacing its owning link.
        content = slot;
        if (owner != null) { owner.content = this; }
        else {
            app.SetRootControl(this);
            if (inputLifetime != session || inputApp != app || content != slot) { return; }
            // An unrelated replacement can reject this installation without rebinding us.
            if (app.rootControl != this) { content = null; inputApp = null; }
        }
    }

    // Replace only the ordinary content at the end of the existing adapter chain.
    // Adapters must enter through Bind so priority and cycle checks stay centralized.
    public bool SetContentRoot(Control root) {
        if (root is InputRootAdapter) { return false; }
        InputRootAdapter tail = this;
        while (true) {
            Control ancestor = tail;
            while (ancestor != null) {
                if (ancestor == root) { return false; }
                ancestor = ancestor.parent;
            }
            if (!(tail.content is InputRootAdapter)) { break; }
            tail = (InputRootAdapter)tail.content;
        }
        if (tail.content == root) { return true; }
        Control previous = tail.content;
        App app = inputApp;
        int session = inputLifetime;
        int tailSession = tail.inputLifetime;
        if (app != null && previous != null) { app.ReleaseInputSubtree(previous); }
        if (inputLifetime != session || tail.inputLifetime != tailSession
                || inputApp != app || tail.content != previous) { return false; }
        if (app != null) {
            InputRootAdapter active = app.rootControl is InputRootAdapter ? (InputRootAdapter)app.rootControl : null;
            if (active == null || !active.ContainsAdapter(this) || !active.ContainsAdapter(tail)) { return false; }
        }
        tail.content = root;
        return true;
    }

    // Release only this adapter's borrowed members, never its fallback content.
    protected virtual void OnReleaseInput(App app) { }

    public void Detach() {
        inputLifetime = inputLifetime + 1;
        int session = inputLifetime;
        App app = inputApp;
        if (app == null) { content = null; return; }
        Control fallback = content;
        Control oldRoot = app.rootControl;
        InputRootAdapter owner = this.InputOwner(app);
        bool linked = this.OwnsInputSlot(app, owner);
        int ownerSession = owner != null ? owner.inputLifetime : 0;
        // Also supersede a pending Bind installation which has not linked us yet.
        app.FenceInputRootChange(oldRoot);
        this.OnReleaseInput(app);
        if (inputLifetime != session || inputApp != app || content != fallback) { return; }
        if (linked) {
            if (!this.OwnsInputSlot(app, owner)
                    || (owner != null && owner.inputLifetime != ownerSession)) { return; }
            if (owner != null) { owner.content = fallback; }
            else {
                app.SetRootControl(fallback);
                if (inputLifetime != session || inputApp != app || content != fallback
                        || app.rootControl != fallback) { return; }
            }
        } else {
            // A pending Bind may not yet own a slot. Never unlink some later chain.
            if (app.rootControl != oldRoot || this.OwnsInputSlot(app, this.InputOwner(app))) { return; }
        }
        content = null;
        inputApp = null;
    }
}
