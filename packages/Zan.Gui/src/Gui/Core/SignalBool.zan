using System;

namespace Gui;

// 布尔版内部状态缓冲：可变值 + 单调递增版本号，
// 渲染帧轮询 Version() 检测变化（契约同 SignalInt）。
public class SignalBool {
    bool val;
    int version;

    SignalBool(bool initial) {
        this.val = initial;
        this.version = 0;
    }

    // 当前值。
    bool Get() { return val; }

    // 写入。版本号无条件 +1，轮询方一律以版本号变化为准。
    void Set(bool v) {
        val = v;
        version = version + 1;
    }

    // 取反写入。版本号无条件 +1。
    void Toggle() {
        val = !val;
        version = version + 1;
    }

    // 写入次数，用于帧轮询检测变化。
    int Version() { return version; }
}

