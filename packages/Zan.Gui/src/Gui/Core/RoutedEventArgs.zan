using System;
using Gui;
namespace Gui;
public delegate void RoutedEventHandler(Control sender, RoutedEventArgs e);
public class RoutedEventArgs {
    public Control originalSource;
    public Control source;
    public string eventName;
    public bool handled;
    public int x;
    public int y;
    public int delta;
    public int keyCode;
    public int modifiers;
    public int pointerType;
    public int button;
    public bool isDoubleClick;
    public weak App gestureApp;
    public int gestureTicket;
    internal weak App keyboardApp;
    internal weak Control keyboardRoot;
    internal int keyboardRootGeneration;
    internal void CopyKeyboardRoute(RoutedEventArgs source) {
        this.keyboardApp = source.keyboardApp;
        this.keyboardRoot = source.keyboardRoot;
        this.keyboardRootGeneration = source.keyboardRootGeneration;
    }
    internal bool RouteCurrent() {
        App app = this.keyboardApp;
        return (app == null || app.KeyboardRouteCurrent(this)) && this.GestureRouteCurrent();
    }
    bool GestureRouteCurrent() {
        if (gestureApp == null) { return true; }
        if (eventName == "LongPress") { return gestureApp.LongPressRouteCurrent(this); }
        return gestureApp.PointerRouteCurrent(this);
    }
    public bool IsTouch() { return this.pointerType == 1; }
    public bool IsMouse() { return this.pointerType == 0; }
    public bool IsPen() { return this.pointerType == 2; }
    public RoutedEventArgs(string eventName) {
        this.eventName = eventName;
        this.originalSource = null;
        this.source = null;
        this.handled = false;
        this.x = 0;
        this.y = 0;
        this.delta = 0;
        this.keyCode = 0;
        this.modifiers = 0;
        this.pointerType = 0;
    }
    public RoutedEventArgs(string eventName, Control originalSource) {
        this.eventName = eventName;
        this.originalSource = originalSource;
        this.source = originalSource;
        this.handled = false;
        this.x = 0;
        this.y = 0;
        this.delta = 0;
        this.keyCode = 0;
        this.modifiers = 0;
        this.pointerType = 0;
    }
    public RoutedEventArgs(string eventName, Control originalSource, int x, int y) {
        this.eventName = eventName;
        this.originalSource = originalSource;
        this.source = originalSource;
        this.handled = false;
        this.x = x;
        this.y = y;
        this.delta = 0;
        this.keyCode = 0;
        this.modifiers = 0;
        this.pointerType = 0;
    }
    public RoutedEventArgs(string eventName, Control originalSource, int x, int y, int pointerType) {
        this.eventName = eventName;
        this.originalSource = originalSource;
        this.source = originalSource;
        this.handled = false;
        this.x = x;
        this.y = y;
        this.delta = 0;
        this.keyCode = 0;
        this.modifiers = 0;
        this.pointerType = pointerType;
    }
    public void Handle() { this.handled = true; }
}
