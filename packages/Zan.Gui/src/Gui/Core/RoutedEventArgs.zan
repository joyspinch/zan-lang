using System;
using Gui;

namespace Gui;

// 路由事件委托：携带 sender（当前处理节点）与标准路由上下文 e
public delegate void RoutedEventHandler(Control sender, RoutedEventArgs e);

// 标准 Visual Tree 路由事件参数
public class RoutedEventArgs {
    // 原始命中的最深层叶子控件
    public Control originalSource;
    // 当前正在处理事件的节点（随着冒泡/隧穿逐级更新）
    public Control source;
    // 事件名称（如 "Click", "PointerDown", "PointerUp", "PointerMove", "KeyDown", "Wheel" 等）
    public string eventName;
    // 是否已被消费处理。任何节点置为 true 后，冒泡流程即刻终止
    public bool handled;

    // 屏幕绝对坐标
    public int x;
    public int y;

    // 滚轮步长或位移增量
    public int delta;
    // 键码（键盘事件专用）
    public int keyCode;
    // 修饰键状态位（Shift, Ctrl, Alt）
    public int modifiers;

    public RoutedEventArgs(string eventName, Control originalSource) {
        this.eventName = eventName;
        this.originalSource = originalSource;
        this.source = originalSource;
        this.handled = false;
        this.x = 0;
        this.y = 0;
        this.delta = 0;
        this.keyCode = 0;
        this.modifiers = 0;
    }

    public RoutedEventArgs(string eventName, Control originalSource, int x, int y) {
        this.eventName = eventName;
        this.originalSource = originalSource;
        this.source = originalSource;
        this.handled = false;
        this.x = x;
        this.y = y;
        this.delta = 0;
        this.keyCode = 0;
        this.modifiers = 0;
    }

    // 标记事件已被消费
    public void Handle() {
        this.handled = true;
    }
}
