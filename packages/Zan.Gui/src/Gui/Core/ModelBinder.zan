using System;
using System.Collections.Generic;
using System.Json;
using Gui;
using Gui.Widget;

namespace Gui;

// 模型宿主：把「控件树 ↔ 数据模型（POCO 实体 / JsonDoc / JsonValue）」的双向绑定从窗口层
// 剥离出来，让任何一棵控件树（不只是一扇子窗口）都能挂模型。
//
// 为什么抽出来：绑定原语（data-bind / data-if / <template data-for>）
// 在编译期只落成 Control 上的声明字段（bindPath / bindIf / SetAttr("data-for")）——
// 它们自己不兑现任何行为。真正把它们兑现成「模型→UI 每帧同步」与「UI→模型 回写」的，
// 一直是 ChildWindow 的渲染循环（SyncFromModel / SyncChangedNode）。
//
// 架构升级：
// - 突破单一 JsonValue 限制，原生支持 POCO 强类型实体对象（Class/Entity）直接挂载；
// - 利用 Zan 内建原生反射（HasField / GetField* / SetField* / 属性 Getter/Setter）实现零 JSON 开销的强类型双向绑定；
// - 原生支持 Dictionary 字典（Dict<string, string>、Dict<string, double> 等）直接挂载与双向写回，免除 JSON 树转换开销；
// - 原生支持 JsonDoc 零拷贝平铺 Tape 结构，只读列表/复杂界面零节点堆分配极速渲染；
// - 100% 向后兼容既有的 JsonValue 体系。
public class ModelBinder {
    Control root;
    object model;
    HandlerRegistry handlers;
    // 宿主 App（可空）：AutoLink 扫描与 .lazy 绑定的获焦判定都要它。
    App app;
    // 绑定快照旁表：SyncFromNode 记录"模型侧确认的控件值"，
    // SyncChangedNode 据此判断用户是否编辑过。
    List<ChildBoundSnapshot> boundSnapshots;
    // `<template data-for>` 原型展开状态列表。
    List<ChildTemplateMeta> tmplMetas;
    // 已展开的行根（原型子项克隆）及其归属模板。
    List<ChildExpandedRow> expandedRows;
    // 行内绑定作用域（行内声明了 bind/bindIf 的控件 → 本项数据对象）。
    List<ChildScopeBinding> scopeBindings;
    // 响应式脏标记：当数据变动、事件触发或数组长度变化时标记为 true。
    // 静止帧为 false 时 SyncFromModel 直接跳过，0 CPU 消耗。
    public bool dirty;

    public void MarkDirty() {
        this.dirty = true;
    }

    // 构造：全部字段置空/默认。
    public ModelBinder() {
        this.root = null;
        this.model = null;
        this.handlers = null;
        this.app = null;
        this.boundSnapshots = null;
        this.tmplMetas = null;
        this.expandedRows = null;
        this.scopeBindings = null;
        this.dirty = true;
    }

    // 挂树与模型。支持 POCO 强类型实体、JsonDoc 以及 JsonValue。
    public void SetRoot(Control tree, object m) {
        this.root = tree;
        this.model = m;
        this.dirty = true;
        if (this.handlers == null) { this.handlers = new HandlerRegistry(); }
    }

    public void SetRoot(Control tree, JsonValue m) {
        this.SetRoot(tree, (object)m);
    }

    // 破环解绑：清空内部控件引用与展开节点，杜绝 ARC 闭包循环引用泄漏。
    public void Detach() {
        if (this.expandedRows != null) {
            for (int i = this.expandedRows.Count - 1; i >= 0; i = i - 1) {
                Control row = this.expandedRows[i].rowRoot;
                this.DetachRow(row);
                this.ScopeDropRow(row, true);
            }
            this.expandedRows.Clear();
            this.expandedRows = null;
        }
        if (this.scopeBindings != null) {
            this.scopeBindings.Clear();
            this.scopeBindings = null;
        }
        if (this.boundSnapshots != null) {
            this.boundSnapshots.Clear();
            this.boundSnapshots = null;
        }
        if (this.tmplMetas != null) {
            this.tmplMetas.Clear();
            this.tmplMetas = null;
        }
        this.handlers = null;
        this.root = null;
        this.app = null;
        this.model = null;
    }

    // 宿主 App（AutoLink 扫描 / 获焦判定用；可后设）。
    public void SetApp(App a) {
        this.app = a;
    }

    // 根树与模型（宿主要遍历/回写时用）。
    public Control Root() { return this.root; }
    public object Model() { return this.model; }
    public JsonValue JsonModel() { return this.model is JsonValue ? (JsonValue)this.model : null; }

    // 注册处理器（事件 → 处理器注册表）。
    public void Handle(string name, Action a) {
        if (this.handlers == null) { this.handlers = new HandlerRegistry(); }
        this.handlers.Set(name, a);
    }

    // 带参处理器：实参经 data-arg 声明，以值快照闭包捕获。
    public void HandleArg(string name, Action<string> a) {
        if (this.handlers == null) { this.handlers = new HandlerRegistry(); }
        this.handlers.SetArg(name, a);
    }

    // 注册带 item 处理器：绑定到具体的行作用域对象（如 users 里的每一项）。
    public void HandleItem(string name, ControlItemEvent a) {
        if (this.handlers == null) { this.handlers = new HandlerRegistry(); }
        this.handlers.SetItem(name, a);
    }

    // 注册绑定到 `name` 的带 sender 处理器（平行通道）。
    public void HandleSender(string name, ControlEvent a) {
        if (this.handlers == null) { this.handlers = new HandlerRegistry(); }
        this.handlers.SetSender(name, a);
    }

    // 接线：解析事件声明 + 登记模板原型 + 首帧同步。
    public void Wire() {
        if (this.root == null) { return; }
        this.WireNode(this.root);
        this.RegisterTemplates(this.root);
        this.SyncFromModel();
    }

    // 递归解析控件树上的 `on<Event>` 处理器名并绑定到已注册的 Action。
    public void WireNode(Control c) {
        for (int i = 0; i < c.events.Count; i = i + 1) {
            string evt = c.events[i].key;
            string hname = c.events[i].val;
            if (hname == "" || this.handlers == null) { continue; }
            ControlItemEvent ia = this.handlers.GetItem(hname);
            if (ia != null) {
                Control sc = c;
                c.BindEvent(evt, () => {
                    ia(sc, sc.item);
                    this.MarkDirty();
                    if (this.app != null) { this.app.RequestRedraw(); this.app.Wake(); }
                });
                continue;
            }
            ControlEvent sa = this.handlers.GetSender(hname);
            if (sa != null) {
                Control sc = c;
                c.BindEvent(evt, () => {
                    sa(sc);
                    this.MarkDirty();
                    if (this.app != null) { this.app.RequestRedraw(); this.app.Wake(); }
                });
                continue;
            }
            if (c.handlerArg != "") {
                Action<string> aa = this.handlers.GetArg(hname);
                if (aa != null) {
                    string arg = c.handlerArg;
                    c.BindEvent(evt, () => {
                        aa(arg);
                        this.MarkDirty();
                        if (this.app != null) { this.app.RequestRedraw(); this.app.Wake(); }
                    });
                    continue;
                }
            }
            Action a = this.handlers.Get(hname);
            if (a != null) {
                c.BindEvent(evt, () => {
                    a();
                    this.MarkDirty();
                    if (this.app != null) { this.app.RequestRedraw(); this.app.Wake(); }
                });
            }
        }
        App.AutoLinkTree(c, this.app);
        for (int j = 0; j < c.children.Count; j = j + 1) {
            this.WireNode(c.children[j]);
        }
    }

    // 把绑定的状态实体值推入每个声明了 `bind` 路径的控件（state -> UI）。
    public void SyncFromModel() {
        if (this.model == null || this.root == null) { return; }
        this.EnsureExpanded();
        this.SyncFromNode(this.root);
        this.dirty = false;
    }

    // 递归把模型值推入声明了 bind 路径的控件（值变化才写），
    // 按 bindIf 声明插拔显示，并记录绑定快照。
    public void SyncFromNode(Control c) {
        if (c.Kind() == "template") { return; }
        if (c.bindIf != "") {
            c.SetShown(this.EvalExpr(c, c.bindIf));
        }
        if (c.bindDisabled != "") {
            bool dis = this.EvalExpr(c, c.bindDisabled);
            if (c.Disabled.Get() != dis) { c.Disabled = dis; }
        }
        if (c.bindClass != "") {
            string dyn = this.EvalClassExpr(c, c.bindClass).Trim();
            string full = dyn;
            if (c.baseClass != "") {
                if (dyn != "") { full = c.baseClass + " " + dyn; }
                else { full = c.baseClass; }
            }
            if (c.Class != full) {
                c.Class = full;
                c.computedStyle = null;
            }
        }
        if (c.bindProps != null) {
            for (int pi = 0; pi < c.bindProps.Count; pi = pi + 1) {
                BindPropEntry bp = c.bindProps[pi];
                string pv = this.EvalAttrExpr(c, bp.expr);
                if (c.GetProp(bp.prop) != pv) {
                    c.SetProp(bp.prop, pv);
                }
            }
        }
        if (c.bindTpl != "") {
            string interpolated = this.EvalInterpolation(c, c.bindTpl);
            string curText = c.GetProp("text");
            if (curText == "") { curText = c.GetProp("value"); }
            if (interpolated != curText) {
                c.SetProp("text", interpolated);
                c.computedStyle = null;
            }
        }
        if (c.bindPath != "") {
            string s = "";
            bool hasVal = this.TryResolveString(c, c.bindPath, out s);
            if (hasVal) {
                string prop = c.bindProp;
                if (prop == "") {
                    prop = "value";
                    if (c is Element) { prop = "text"; }
                }
                string cur = this.BoundValue(c);
                if (!this.HasSnapshot(c) || cur == this.SnapshotOf(c)) {
                    if (c.GetProp(prop) != s) { c.SetProp(prop, s); }
                    this.RecordSnapshot(c, this.BoundValue(c));
                }
            }
        }
        for (int j = 0; j < c.children.Count; j = j + 1) {
            this.SyncFromNode(c.children[j]);
        }
    }

    // 把每个绑定控件的当前值读回状态实体（UI -> state）。
    public void SyncChangedNode(Control c) {
        if (c.Kind() == "template") { return; }
        if (c.bindPath != "") {
            if (c.bindLazy && this.app != null && c.HasFocus(this.app)) {
                // .lazy 修饰符：获焦输入期间暂不回写模型
            } else {
                string s = this.BoundValue(c);
                if (s != this.SnapshotOf(c)) { this.WriteBoundValue(c, s); }
            }
        }
        for (int i = 0; i < c.children.Count; i = i + 1) {
            this.SyncChangedNode(c.children[i]);
        }
    }

    // 去除作用域别名前缀（如 "row.name" 在 alias 为 "row" 时脱糖为 "name"）
    public static string StripAlias(string path, string alias) {
        if (alias != "" && path.StartsWith(alias + ".")) {
            return path.Substring(alias.Length + 1);
        }
        return path;
    }

    public object ScopeItemOf(Control c) {
        if (c != null && c.item != null) {
            return c.item;
        }
        ChildScopeBinding sb = this.ScopeBindingOf(c);
        if (sb != null && sb.item != null) {
            return sb.item;
        }
        return this.model;
    }

    public string ScopeAliasOf(Control c) {
        if (c != null && c.itemAlias != "") {
            return c.itemAlias;
        }
        ChildScopeBinding sb = this.ScopeBindingOf(c);
        if (sb != null) {
            return sb.alias;
        }
        return "";
    }

    // 解析嵌套对象路径（如 "user.addr.city"），返回最内层承载对象与叶子字段名。
    static object ResolveFieldScope(object scope, string path, out string leafField) {
        leafField = path;
        if (scope == null || path == "") { return null; }
        int dot = path.IndexOf(".");
        if (dot < 0) { return scope; }
        object cur = scope;
        int start = 0;
        while (dot >= 0) {
            string segment = path.Substring(start, dot - start);
            if (!cur.HasField(segment)) { return null; }
            cur = cur.GetFieldObject(segment);
            if (cur == null) { return null; }
            start = dot + 1;
            dot = path.IndexOf(".", start);
        }
        leafField = path.Substring(start);
        return cur;
    }

    // 从任意多态模型（JsonValue、JsonDocCursor、JsonDoc 或强类型 POCO 实体）解析字符串
    public bool TryResolveString(Control c, string path, out string result) {
        result = "";
        if (path == "") { return false; }
        object scope = this.ScopeItemOf(c);
        string alias = this.ScopeAliasOf(c);
        string actualPath = ModelBinder.StripAlias(path, alias);

        if (scope == null) { return false; }

        if (scope is JsonValue) {
            JsonValue jv = ((JsonValue)scope).PathGet(actualPath);
            if (jv != null) {
                result = jv.AsString("");
                return true;
            }
            if (scope != this.model && this.model != null && this.model is JsonValue) {
                JsonValue mv = ((JsonValue)this.model).PathGet(path);
                if (mv != null) {
                    result = mv.AsString("");
                    return true;
                }
            }
            return false;
        }

        if (scope is JsonDocCursor) {
            JsonDocCursor cur = (JsonDocCursor)scope;
            int slot = cur.doc.Path(cur.slot, actualPath);
            if (slot >= 0) {
                result = cur.doc.StrAt(slot, "");
                return true;
            }
            return false;
        }

        if (scope is JsonDoc) {
            JsonDoc doc = (JsonDoc)scope;
            int slot = doc.Path(doc.root, actualPath);
            if (slot >= 0) {
                result = doc.StrAt(slot, "");
                return true;
            }
            return false;
        }

        // 字典模型高性能直读（零 JSON 堆分配）
        if (scope is Dictionary<string, string>) {
            Dictionary<string, string> dict = (Dictionary<string, string>)scope;
            if (dict.ContainsKey(actualPath)) {
                result = dict[actualPath];
                return true;
            }
            if (scope != this.model && this.model != null && this.model is Dictionary<string, string>) {
                Dictionary<string, string> mdict = (Dictionary<string, string>)this.model;
                if (mdict.ContainsKey(path)) {
                    result = mdict[path];
                    return true;
                }
            }
            return false;
        }

        // POCO 强类型实体反射（支持点号级联导航如 user.addr.city）
        string leaf = "";
        object target = ModelBinder.ResolveFieldScope(scope, actualPath, out leaf);
        if (target != null && target.HasField(leaf)) {
            result = target.GetFieldString(leaf);
            if (result == "") {
                double d = target.GetFieldDouble(leaf);
                if (d != 0.0) {
                    result = Convert.ToString(d);
                } else if (target.GetFieldBool(leaf)) {
                    result = "true";
                }
            }
            return true;
        }

        if (scope != this.model && this.model != null) {
            string mleaf = "";
            object mtarget = ModelBinder.ResolveFieldScope(this.model, path, out mleaf);
            if (mtarget != null && mtarget.HasField(mleaf)) {
                result = mtarget.GetFieldString(mleaf);
                return true;
            }
        }
        return false;
    }

    // 从任意多态模型解析数值
    public bool TryResolveDouble(Control c, string path, out double result) {
        result = 0.0;
        if (path == "") { return false; }
        object scope = this.ScopeItemOf(c);
        string alias = this.ScopeAliasOf(c);
        string actualPath = ModelBinder.StripAlias(path, alias);

        if (scope == null) { return false; }

        if (scope is JsonValue) {
            JsonValue jv = ((JsonValue)scope).PathGet(actualPath);
            if (jv != null && jv.IsNumber()) {
                result = jv.AsDouble(0.0);
                return true;
            }
            if (scope != this.model && this.model != null && this.model is JsonValue) {
                JsonValue mv = ((JsonValue)this.model).PathGet(path);
                if (mv != null && mv.IsNumber()) {
                    result = mv.AsDouble(0.0);
                    return true;
                }
            }
            return false;
        }

        if (scope is JsonDocCursor) {
            JsonDocCursor cur = (JsonDocCursor)scope;
            int slot = cur.doc.Path(cur.slot, actualPath);
            if (slot >= 0) {
                result = cur.doc.DoubleAt(slot, 0.0);
                return true;
            }
            return false;
        }

        if (scope is JsonDoc) {
            JsonDoc doc = (JsonDoc)scope;
            int slot = doc.Path(doc.root, actualPath);
            if (slot >= 0) {
                result = doc.DoubleAt(slot, 0.0);
                return true;
            }
            return false;
        }

        // 字典模型高性能数值直读
        if (scope is Dictionary<string, double>) {
            Dictionary<string, double> ddict = (Dictionary<string, double>)scope;
            if (ddict.ContainsKey(actualPath)) {
                result = ddict[actualPath];
                return true;
            }
            if (scope != this.model && this.model != null && this.model is Dictionary<string, double>) {
                Dictionary<string, double> mddict = (Dictionary<string, double>)this.model;
                if (mddict.ContainsKey(path)) {
                    result = mddict[path];
                    return true;
                }
            }
            return false;
        }

        if (scope is Dictionary<string, string>) {
            Dictionary<string, string> sdict = (Dictionary<string, string>)scope;
            if (sdict.ContainsKey(actualPath)) {
                string sv = sdict[actualPath];
                result = sv != "" ? sv.ToDouble() : 0.0;
                return true;
            }
            if (scope != this.model && this.model != null && this.model is Dictionary<string, string>) {
                Dictionary<string, string> msdict = (Dictionary<string, string>)this.model;
                if (msdict.ContainsKey(path)) {
                    string msv = msdict[path];
                    result = msv != "" ? msv.ToDouble() : 0.0;
                    return true;
                }
            }
            return false;
        }

        string leaf = "";
        object target = ModelBinder.ResolveFieldScope(scope, actualPath, out leaf);
        if (target != null && target.HasField(leaf)) {
            result = target.GetFieldDouble(leaf);
            return true;
        }

        if (scope != this.model && this.model != null) {
            string mleaf = "";
            object mtarget = ModelBinder.ResolveFieldScope(this.model, path, out mleaf);
            if (mtarget != null && mtarget.HasField(mleaf)) {
                result = mtarget.GetFieldDouble(mleaf);
                return true;
            }
        }
        return false;
    }

    // 从任意多态模型解析真值（用于 data-if / 逻辑判断）
    public bool ResolveTruthy(Control c, string path) {
        if (path == "") { return false; }
        object scope = this.ScopeItemOf(c);
        string alias = this.ScopeAliasOf(c);
        string actualPath = ModelBinder.StripAlias(path, alias);

        if (scope == null) { return false; }

        if (scope is JsonValue) {
            JsonValue jv = ((JsonValue)scope).PathGet(actualPath);
            if (jv == null && scope != this.model && this.model != null && this.model is JsonValue) {
                jv = ((JsonValue)this.model).PathGet(path);
            }
            return ModelBinder.Truthy(jv);
        }

        if (scope is JsonDocCursor) {
            JsonDocCursor cur = (JsonDocCursor)scope;
            int slot = cur.doc.Path(cur.slot, actualPath);
            if (slot >= 0) {
                return cur.doc.BoolAt(slot, false) || (cur.doc.IntAt(slot, 0) != 0) || (cur.doc.StrAt(slot, "") != "" && cur.doc.StrAt(slot, "") != "false");
            }
            return false;
        }

        if (scope is JsonDoc) {
            JsonDoc doc = (JsonDoc)scope;
            int slot = doc.Path(doc.root, actualPath);
            if (slot >= 0) {
                return doc.BoolAt(slot, false) || (doc.IntAt(slot, 0) != 0) || (doc.StrAt(slot, "") != "" && doc.StrAt(slot, "") != "false");
            }
            return false;
        }

        // 字典真值直判（用于 data-if）
        if (scope is Dictionary<string, bool>) {
            Dictionary<string, bool> bdict = (Dictionary<string, bool>)scope;
            if (bdict.ContainsKey(actualPath)) {
                return bdict[actualPath];
            }
            if (scope != this.model && this.model != null && this.model is Dictionary<string, bool>) {
                Dictionary<string, bool> mbdict = (Dictionary<string, bool>)this.model;
                if (mbdict.ContainsKey(path)) {
                    return mbdict[path];
                }
            }
            return false;
        }

        if (scope is Dictionary<string, string>) {
            Dictionary<string, string> sdict = (Dictionary<string, string>)scope;
            if (sdict.ContainsKey(actualPath)) {
                string s = sdict[actualPath];
                return s != "" && s != "false" && s != "0";
            }
            if (scope != this.model && this.model != null && this.model is Dictionary<string, string>) {
                Dictionary<string, string> msdict = (Dictionary<string, string>)this.model;
                if (msdict.ContainsKey(path)) {
                    string ms = msdict[path];
                    return ms != "" && ms != "false" && ms != "0";
                }
            }
            return false;
        }

        if (scope.HasField(actualPath)) {
            if (scope.GetFieldBool(actualPath)) { return true; }
            if (scope.GetFieldDouble(actualPath) != 0.0) { return true; }
            string s = scope.GetFieldString(actualPath);
            return s != "" && s != "false";
        }
        return false;
    }

    // 绑定路径取值：控件在模板行作用域里先查
    // 本项数据实体，未命中回落根模型。为兼容既有使用端，若非 JsonValue 模型则按字符串构造包装。
    public JsonValue ValueFor(Control c, string path) {
        object scope = this.ScopeItemOf(c);
        string alias = this.ScopeAliasOf(c);
        string actualPath = ModelBinder.StripAlias(path, alias);

        if (scope != null && scope is JsonValue) {
            JsonValue jv = ((JsonValue)scope).PathGet(actualPath);
            if (jv != null) { return jv; }
            if (actualPath != path) { return null; }
        }
        if (this.model != null && this.model is JsonValue) {
            return ((JsonValue)this.model).PathGet(path);
        }
        string s = "";
        if (this.TryResolveString(c, path, out s)) {
            return JsonValue.NewStr(s);
        }
        return null;
    }

    // 记录（或更新）控件绑定属性的模型侧确认值。
    void RecordSnapshot(Control c, string v) {
        if (this.boundSnapshots == null) {
            this.boundSnapshots = new List<ChildBoundSnapshot>();
        }
        for (int i = 0; i < this.boundSnapshots.Count; i = i + 1) {
            if (this.boundSnapshots[i].control == c) {
                this.boundSnapshots[i].snapshot = v;
                return;
            }
        }
        this.boundSnapshots.Add(new ChildBoundSnapshot(c, v));
    }

    string SnapshotOf(Control c) {
        if (this.boundSnapshots == null) { return ""; }
        for (int i = 0; i < this.boundSnapshots.Count; i = i + 1) {
            if (this.boundSnapshots[i].control == c) {
                return this.boundSnapshots[i].snapshot;
            }
        }
        return "";
    }

    bool HasSnapshot(Control c) {
        if (this.boundSnapshots == null) { return false; }
        for (int i = 0; i < this.boundSnapshots.Count; i = i + 1) {
            if (this.boundSnapshots[i].control == c) { return true; }
        }
        return false;
    }

    // 控件绑定属性的当前值：显式 bindProp 优先，否则取 value、再取 text。
    string BoundValue(Control c) {
        if (c.bindProp != "") { return c.GetProp(c.bindProp); }
        string k = c.Kind();
        if (k == "SelectBox") {
            double numVal = 0.0;
            if (this.TryResolveDouble(c, c.bindPath, out numVal)) {
                return c.GetProp("value");
            }
            string sv = c.GetProp("selectedValue");
            if (sv != "") { return sv; }
            string txt = c.GetProp("text");
            if (txt != "") { return txt; }
        }
        string s = c.GetProp("value");
        if (s == "") { s = c.GetProp("text"); }
        return s;
    }

    // 把字符串值写回模型节点：支持 JsonValue 与 POCO 实体强类型双向写回。
    void WriteBoundValue(Control c, string s) {
        if (c.bindTrim) {
            s = s.Trim();
        }
        string k = c.Kind();
        bool isBoolCtrl = (k == "Checkbox" || k == "Switch");
        bool isNumCtrl = (k == "Slider" || k == "InputNumber" || k == "Progress" || k == "Rate" || c.bindNumber);

        object scope = this.ScopeItemOf(c);
        string alias = this.ScopeAliasOf(c);
        string actualPath = ModelBinder.StripAlias(c.bindPath, alias);

        if (scope != null) {
            if (scope is JsonValue) {
                JsonValue jscope = (JsonValue)scope;
                JsonValue cur = jscope.PathGet(actualPath);
                if (isNumCtrl || (cur != null && cur.IsNumber())) {
                    string ns = s.Trim();
                    if (ns == "") { ns = "0"; }
                    jscope.PathSetValue(actualPath, JsonValue.NewNum(ns));
                } else if (isBoolCtrl || (cur != null && cur.IsBool())) {
                    jscope.PathSetValue(actualPath, JsonValue.NewBool(s == "true"));
                } else {
                    jscope.PathSet(actualPath, s);
                }
            } else if (scope is JsonDocCursor || scope is JsonDoc) {
                // JsonDoc 为只读零分配数据源，不参与回写
            } else if (scope is Dictionary<string, string>) {
                Dictionary<string, string> dict = (Dictionary<string, string>)scope;
                dict[actualPath] = s;
            } else if (scope is Dictionary<string, double>) {
                Dictionary<string, double> dict = (Dictionary<string, double>)scope;
                dict[actualPath] = s != "" ? s.ToDouble() : 0.0;
            } else if (scope is Dictionary<string, bool>) {
                Dictionary<string, bool> dict = (Dictionary<string, bool>)scope;
                dict[actualPath] = (s == "true");
            } else {
                // POCO 强类型实体双向写回（支持嵌套字段）
                string leaf = "";
                object target = ModelBinder.ResolveFieldScope(scope, actualPath, out leaf);
                if (target != null) {
                    if (isNumCtrl) {
                        double numVal = s != "" ? s.ToDouble() : 0.0;
                        target.SetFieldDouble(leaf, numVal);
                        target.SetFieldInt(leaf, (int)numVal);
                    } else if (isBoolCtrl) {
                        target.SetFieldBool(leaf, s == "true");
                    } else {
                        target.SetFieldString(leaf, s);
                    }
                }
            }
            this.RecordSnapshot(c, s);
            this.dirty = true;
            return;
        }

        if (this.model != null) {
            if (this.model is JsonValue) {
                JsonValue jm = (JsonValue)this.model;
                JsonValue cur0 = jm.PathGet(c.bindPath);
                if (isNumCtrl || (cur0 != null && cur0.IsNumber())) {
                    string ns0 = s.Trim();
                    if (ns0 == "") { ns0 = "0"; }
                    jm.PathSetValue(c.bindPath, JsonValue.NewNum(ns0));
                } else if (isBoolCtrl || (cur0 != null && cur0.IsBool())) {
                    jm.PathSetValue(c.bindPath, JsonValue.NewBool(s == "true"));
                } else {
                    jm.PathSet(c.bindPath, s);
                }
            } else if (this.model is Dictionary<string, string>) {
                Dictionary<string, string> mdict = (Dictionary<string, string>)this.model;
                mdict[c.bindPath] = s;
            } else if (this.model is Dictionary<string, double>) {
                Dictionary<string, double> mdict = (Dictionary<string, double>)this.model;
                mdict[c.bindPath] = s != "" ? s.ToDouble() : 0.0;
            } else if (this.model is Dictionary<string, bool>) {
                Dictionary<string, bool> mdict = (Dictionary<string, bool>)this.model;
                mdict[c.bindPath] = (s == "true");
            } else if (!(this.model is JsonDoc)) {
                string mleaf = "";
                object mtarget = ModelBinder.ResolveFieldScope(this.model, c.bindPath, out mleaf);
                if (mtarget != null) {
                    if (isNumCtrl) {
                        double numVal = s != "" ? s.ToDouble() : 0.0;
                        mtarget.SetFieldDouble(mleaf, numVal);
                        mtarget.SetFieldInt(mleaf, (int)numVal);
                    } else if (isBoolCtrl) {
                        mtarget.SetFieldBool(mleaf, s == "true");
                    } else {
                        mtarget.SetFieldString(mleaf, s);
                    }
                }
            }
            this.RecordSnapshot(c, s);
            this.dirty = true;
        }
    }

    // ---- <template data-for> 行展开 ---------------------------------------

    static void ParseForAttr(string expr, out string sourcePath, out string alias) {
        sourcePath = "";
        alias = "";
        if (expr == null || expr == "") { return; }
        string s = expr.Trim();
        int asIdx = s.IndexOf(" as ");
        if (asIdx > 0) {
            sourcePath = s.Substring(0, asIdx).Trim();
            string r = s.Substring(asIdx + 4).Trim();
            if (r.StartsWith("(") && r.EndsWith(")")) {
                r = r.Substring(1, r.Length - 2).Trim();
            }
            int comma = r.IndexOf(",");
            if (comma > 0) {
                alias = r.Substring(0, comma).Trim();
            } else {
                alias = r;
            }
            return;
        }
        int inIdx = s.IndexOf(" in ");
        if (inIdx > 0) {
            sourcePath = s.Substring(inIdx + 4).Trim();
            string l = s.Substring(0, inIdx).Trim();
            if (l.StartsWith("(") && l.EndsWith(")")) {
                l = l.Substring(1, l.Length - 2).Trim();
            }
            int comma = l.IndexOf(",");
            if (comma > 0) {
                alias = l.Substring(0, comma).Trim();
            } else {
                alias = l;
            }
            return;
        }
        sourcePath = s;
        alias = "";
    }

    void RegisterTemplates(Control c) {
        if (c.Kind() == "template") {
            if (this.tmplMetas == null) {
                this.tmplMetas = new List<ChildTemplateMeta>();
            }
            bool known = false;
            for (int i = 0; i < this.tmplMetas.Count; i = i + 1) {
                if (this.tmplMetas[i].template == c) { known = true; break; }
            }
            if (!known) {
                string rawFor = c.CssAttr("data-for");
                string srcPath = "";
                string alias = "";
                ModelBinder.ParseForAttr(rawFor, out srcPath, out alias);
                this.tmplMetas.Add(new ChildTemplateMeta(c, 0 - 1, srcPath, alias));
            }
            return;
        }
        for (int j = 0; j < c.children.Count; j = j + 1) {
            this.RegisterTemplates(c.children[j]);
        }
    }

    void EnsureExpanded() {
        if (this.tmplMetas == null) { return; }
        for (int i = 0; i < this.tmplMetas.Count; i = i + 1) {
            Control t = this.tmplMetas[i].template;
            string path = this.tmplMetas[i].sourcePath;
            if (path == "") {
                string a = "";
                ModelBinder.ParseForAttr(t.CssAttr("data-for"), out path, out a);
                this.tmplMetas[i].sourcePath = path;
                this.tmplMetas[i].alias = a;
            }
            if (path == "" || t.children.Count == 0) { continue; }
            JsonValue arr = null;
            JsonDoc doc = null;
            List<object> objList = null;
            int docArrSlot = -1;
            int n = 0;

            if (this.model != null) {
                if (this.model is JsonValue) {
                    arr = ((JsonValue)this.model).PathGet(path);
                    n = (arr != null && arr.IsArray()) ? arr.Count() : 0;
                } else if (this.model is JsonDoc) {
                    doc = (JsonDoc)this.model;
                    docArrSlot = doc.Path(doc.root, path);
                    if (docArrSlot >= 0 && doc.KindAt(docArrSlot) == 4) {
                        n = doc.Count(docArrSlot);
                    }
                } else if (this.model is List<object>) {
                    objList = (List<object>)this.model;
                    n = objList.Count;
                } else if (this.model is Dictionary<string, object>) {
                    Dictionary<string, object> d = (Dictionary<string, object>)this.model;
                    if (d.ContainsKey(path) && d[path] is List<object>) {
                        objList = (List<object>)d[path];
                        n = objList.Count;
                    }
                } else {
                    string pleaf = "";
                    object ptarget = ModelBinder.ResolveFieldScope(this.model, path, out pleaf);
                    if (ptarget != null && ptarget.HasField(pleaf)) {
                        object fo = ptarget.GetFieldObject(pleaf);
                        if (fo != null && fo is List<object>) {
                            objList = (List<object>)fo;
                            n = objList.Count;
                        }
                    }
                }
            }

            string keyAttr = t.CssAttr("data-key");

            if (keyAttr != "" && (arr != null || (doc != null && docArrSlot >= 0) || objList != null)) {
                if (!this.dirty && this.tmplMetas[i].lastCount == n) { continue; }
                this.EnsureExpandedKeyed(t, arr, doc, docArrSlot, objList, n, keyAttr, this.tmplMetas[i]);
            } else {
                if (this.tmplMetas[i].lastCount == n) { continue; }
                this.RemoveRows(t);
                this.tmplMetas[i].lastCount = n;
                if (n == 0) { continue; }
                Control p = t.parent;
                if (p == null) { continue; }
                int cur = p.IndexOf(t) + 1;
                for (int k = 0; k < n; k = k + 1) {
                    object item = null;
                    if (arr != null) {
                        item = arr.At(k);
                    } else if (doc != null && docArrSlot >= 0) {
                        item = new JsonDocCursor(doc, doc.At(docArrSlot, k));
                    } else if (objList != null) {
                        item = objList[k];
                    }
                    for (int j = 0; j < t.children.Count; j = j + 1) {
                        Control row = App.CloneTree(t.children[j]);
                        if (row == null) { continue; }
                        p.InsertAt(cur, row);
                        cur = cur + 1;
                        this.ScopeRow(row, item, this.tmplMetas[i].alias, true);
                        this.WireNode(row);
                        if (this.expandedRows == null) {
                            this.expandedRows = new List<ChildExpandedRow>();
                        }
                        this.expandedRows.Add(new ChildExpandedRow(row, t));
                    }
                }
            }
        }
    }

    void EnsureExpandedKeyed(Control t, JsonValue arr, JsonDoc doc, int docArrSlot, List<object> objList, int n, string keyAttr, ChildTemplateMeta meta) {
        Control p = t.parent;
        if (p == null) { return; }
        meta.lastCount = n;

        List<ChildExpandedRow> oldRows = new List<ChildExpandedRow>();
        Dict<string, ChildExpandedRow> oldRowMap = new Dict<string, ChildExpandedRow>();
        if (this.expandedRows != null) {
            for (int i = 0; i < this.expandedRows.Count; i = i + 1) {
                if (this.expandedRows[i].template == t) {
                    oldRows.Add(this.expandedRows[i]);
                    string rk = this.expandedRows[i].key;
                    if (rk != "") {
                        oldRowMap[rk] = this.expandedRows[i];
                    }
                }
            }
        }

        List<string> newKeys = new List<string>();
        Dict<string, bool> newKeySet = new Dict<string, bool>();
        string actualKey = keyAttr;
        if (meta.alias != "" && actualKey.StartsWith(meta.alias + ".")) {
            actualKey = actualKey.Substring(meta.alias.Length + 1);
        }

        for (int k = 0; k < n; k = k + 1) {
            string keyVal = "";
            if (arr != null) {
                JsonValue item = arr.At(k);
                if (item != null) {
                    JsonValue kv = item.PathGet(actualKey);
                    if (kv != null) { keyVal = kv.AsString(""); }
                }
            } else if (doc != null && docArrSlot >= 0) {
                int itemSlot = doc.At(docArrSlot, k);
                if (itemSlot >= 0) {
                    int kSlot = doc.Path(itemSlot, actualKey);
                    if (kSlot >= 0) {
                        keyVal = doc.StrAt(kSlot, "");
                        if (keyVal == "") {
                            double d = doc.DoubleAt(kSlot, 0.0);
                            if (d != 0.0) { keyVal = Convert.ToString(d); }
                        }
                    }
                }
            } else if (objList != null) {
                object item = objList[k];
                if (item != null) {
                    if (item is Dictionary<string, string>) {
                        Dictionary<string, string> d = (Dictionary<string, string>)item;
                        if (d.ContainsKey(actualKey)) { keyVal = d[actualKey]; }
                    } else if (item is Dictionary<string, object>) {
                        Dictionary<string, object> d = (Dictionary<string, object>)item;
                        if (d.ContainsKey(actualKey)) {
                            object v = d[actualKey];
                            if (v != null) { keyVal = Convert.ToString(v); }
                        }
                    } else {
                        string leaf = "";
                        object target = ModelBinder.ResolveFieldScope(item, actualKey, out leaf);
                        if (target != null && target.HasField(leaf)) {
                            keyVal = target.GetFieldString(leaf);
                            if (keyVal == "") {
                                double d = target.GetFieldDouble(leaf);
                                if (d != 0.0) { keyVal = Convert.ToString(d); }
                            }
                        }
                    }
                }
            }
            if (keyVal == "") { keyVal = k.ToString(); }
            newKeys.Add(keyVal);
            newKeySet[keyVal] = true;
        }

        for (int i = oldRows.Count - 1; i >= 0; i = i - 1) {
            string oldKey = oldRows[i].key;
            if (!newKeySet.ContainsKey(oldKey)) {
                Control row = oldRows[i].rowRoot;
                this.DetachRow(row);
                this.ScopeDropRow(row, true);
                this.RemoveExpandedRowEntry(oldRows[i]);
                oldRows.RemoveAt(i);
                oldRowMap.Remove(oldKey);
            }
        }

        int insertPos = p.IndexOf(t) + 1;
        for (int k = 0; k < n; k = k + 1) {
            object item = null;
            if (arr != null) {
                item = arr.At(k);
            } else if (doc != null && docArrSlot >= 0) {
                item = new JsonDocCursor(doc, doc.At(docArrSlot, k));
            } else if (objList != null) {
                item = objList[k];
            }
            string keyVal = newKeys[k];

            ChildExpandedRow matched = null;
            if (oldRowMap.TryGetValue(keyVal, out matched)) {
                this.ScopeRow(matched.rowRoot, item, meta.alias, true);
                insertPos = insertPos + 1;
            } else {
                for (int j = 0; j < t.children.Count; j = j + 1) {
                    Control row = App.CloneTree(t.children[j]);
                    if (row == null) { continue; }
                    p.InsertAt(insertPos, row);
                    insertPos = insertPos + 1;
                    this.ScopeRow(row, item, meta.alias, true);
                    this.WireNode(row);
                    ChildExpandedRow entry = new ChildExpandedRow(row, t, keyVal);
                    if (this.expandedRows == null) {
                        this.expandedRows = new List<ChildExpandedRow>();
                    }
                    this.expandedRows.Add(entry);
                    oldRows.Add(entry);
                    oldRowMap[keyVal] = entry;
                }
            }
        }
    }

    void RemoveExpandedRowEntry(ChildExpandedRow entry) {
        if (this.expandedRows == null) { return; }
        for (int i = 0; i < this.expandedRows.Count; i = i + 1) {
            if (this.expandedRows[i] == entry) {
                this.expandedRows.RemoveAt(i);
                return;
            }
        }
    }

    void RemoveRows(Control t) {
        if (this.expandedRows == null) { return; }
        for (int i = this.expandedRows.Count - 1; i >= 0; i = i - 1) {
            if (this.expandedRows[i].template != t) { continue; }
            Control row = this.expandedRows[i].rowRoot;
            this.DetachRow(row);
            this.ScopeDropRow(row, true);
            this.expandedRows.RemoveAt(i);
        }
    }

    void DetachRow(Control row) {
        Control p = row.parent;
        if (p == null) { return; }
        if (p is Element) {
            ((Element)p).DropKid(row);
        } else {
            p.Remove(row);
        }
    }

    void ScopeRow(Control c, object item, string alias, bool rowRoot) {
        c.item = item;
        c.itemAlias = alias;
        if (rowRoot || c.bindPath != "" || c.bindIf != "" || c.bindClass != "" || c.bindDisabled != "" || c.bindTpl != "" || (c.bindProps != null && c.bindProps.Count > 0)) {
            this.ScopePut(c, item, alias);
        }
        for (int j = 0; j < c.children.Count; j = j + 1) {
            this.ScopeRow(c.children[j], item, alias, false);
        }
    }

    void ScopePut(Control c, object item, string alias) {
        if (this.scopeBindings == null) {
            this.scopeBindings = new List<ChildScopeBinding>();
        }
        for (int i = 0; i < this.scopeBindings.Count; i = i + 1) {
            if (this.scopeBindings[i].control == c) {
                this.scopeBindings[i].item = item;
                this.scopeBindings[i].alias = alias;
                return;
            }
        }
        this.scopeBindings.Add(new ChildScopeBinding(c, item, alias));
    }

    ChildScopeBinding ScopeBindingOf(Control c) {
        if (this.scopeBindings == null) { return null; }
        for (int i = 0; i < this.scopeBindings.Count; i = i + 1) {
            if (this.scopeBindings[i].control == c) {
                return this.scopeBindings[i];
            }
        }
        return null;
    }

    public object ScopeOf(Control c) {
        ChildScopeBinding sb = this.ScopeBindingOf(c);
        return sb != null ? sb.item : null;
    }

    void ScopeDropRow(Control c, bool rowRoot) {
        c.item = null;
        c.itemAlias = "";
        if (rowRoot || c.bindPath != "" || c.bindIf != "" || c.bindClass != "" || c.bindDisabled != "" || c.bindTpl != "" || (c.bindProps != null && c.bindProps.Count > 0)) {
            this.ScopeDropOne(c);
        }
        for (int j = 0; j < c.children.Count; j = j + 1) {
            this.ScopeDropRow(c.children[j], false);
        }
    }

    void ScopeDropOne(Control c) {
        if (this.scopeBindings == null) { return; }
        int keep = 0;
        for (int i = 0; i < this.scopeBindings.Count; i = i + 1) {
            if (this.scopeBindings[i].control == c) { continue; }
            this.scopeBindings[keep] = this.scopeBindings[i];
            keep = keep + 1;
        }
        if (keep == this.scopeBindings.Count) { return; }
        while (this.scopeBindings.Count > keep) {
            this.scopeBindings.RemoveAt(this.scopeBindings.Count - 1);
        }
    }

    static bool Truthy(JsonValue v) {
        if (v == null) { return false; }
        if (v.IsBool()) { return v.AsBool(false); }
        if (v.IsNumber()) { return v.AsInt(0) != 0; }
        string s = v.AsString("");
        return s != "" && s != "false";
    }

    bool EvalExpr(Control c, string expr) {
        if (expr == "") { return false; }
        string s = expr.Trim();
        if (s == "") { return false; }

        int orIdx = s.IndexOf("||");
        if (orIdx >= 0) {
            string left = s.Substring(0, orIdx);
            string right = s.Substring(orIdx + 2);
            return this.EvalExpr(c, left) || this.EvalExpr(c, right);
        }

        int andIdx = s.IndexOf("&&");
        if (andIdx >= 0) {
            string left = s.Substring(0, andIdx);
            string right = s.Substring(andIdx + 2);
            return this.EvalExpr(c, left) && this.EvalExpr(c, right);
        }

        if (s.StartsWith("!")) {
            return !this.EvalExpr(c, s.Substring(1));
        }

        string op = "";
        int opIdx = -1;
        int opLen = 0;

        int idx = s.IndexOf("==");
        if (idx >= 0) { op = "=="; opIdx = idx; opLen = 2; }
        else {
            idx = s.IndexOf("!=");
            if (idx >= 0) { op = "!="; opIdx = idx; opLen = 2; }
            else {
                idx = s.IndexOf(">=");
                if (idx >= 0) { op = ">="; opIdx = idx; opLen = 2; }
                else {
                    idx = s.IndexOf("<=");
                    if (idx >= 0) { op = "<="; opIdx = idx; opLen = 2; }
                    else {
                        idx = s.IndexOf(">");
                        if (idx >= 0) { op = ">"; opIdx = idx; opLen = 1; }
                        else {
                            idx = s.IndexOf("<");
                            if (idx >= 0) { op = "<"; opIdx = idx; opLen = 1; }
                        }
                    }
                }
            }
        }

        if (op != "") {
            string leftStr = s.Substring(0, opIdx).Trim();
            string rightStr = s.Substring(opIdx + opLen).Trim();
            return this.EvalCompare(c, leftStr, op, rightStr);
        }

        return this.ResolveTruthy(c, s);
    }

    bool EvalCompare(Control c, string leftStr, string op, string rightStr) {
        bool isLeftNum = false;
        bool isRightNum = false;
        double leftNum = this.ParseOperandNum(c, leftStr, out isLeftNum);
        double rightNum = this.ParseOperandNum(c, rightStr, out isRightNum);

        if (isLeftNum && isRightNum) {
            switch (op) {
                case "==": return leftNum == rightNum;
                case "!=": return leftNum != rightNum;
                case ">":  return leftNum > rightNum;
                case "<":  return leftNum < rightNum;
                case ">=": return leftNum >= rightNum;
                case "<=": return leftNum <= rightNum;
                default:   return false;
            }
        }

        string leftVal = this.ResolveOperandStr(c, leftStr);
        string rightVal = this.ResolveOperandStr(c, rightStr);
        switch (op) {
            case "==": return leftVal == rightVal;
            case "!=": return leftVal != rightVal;
            case ">":  return leftVal > rightVal;
            case "<":  return leftVal < rightVal;
            case ">=": return leftVal >= rightVal;
            case "<=": return leftVal <= rightVal;
            default:   return false;
        }
    }

    double ParseOperandNum(Control c, string operand, out bool isNum) {
        isNum = false;
        if (operand == "") { return 0.0; }
        if (operand.StartsWith("'") || operand.StartsWith("\"")) {
            return 0.0;
        }
        if (operand == "true" || operand == "false") {
            return 0.0;
        }
        if (IsNumericLiteral(operand)) {
            isNum = true;
            return operand.ToDouble();
        }
        double d = 0.0;
        if (this.TryResolveDouble(c, operand, out d)) {
            isNum = true;
            return d;
        }
        return 0.0;
    }

    static bool IsNumericLiteral(string s) {
        if (s == "") { return false; }
        int start = 0;
        if (s.StartsWith("-") || s.StartsWith("+")) {
            start = 1;
            if (s.Length <= 1) { return false; }
        }
        bool hasDot = false;
        for (int i = start; i < s.Length; i = i + 1) {
            int ch = (int)s[i];
            if (ch == 46) {
                if (hasDot) { return false; }
                hasDot = true;
            } else if (ch < 48 || ch > 57) {
                return false;
            }
        }
        return true;
    }

    string ResolveOperandStr(Control c, string operand) {
        if (operand == "") { return ""; }
        if ((operand.StartsWith("'") && operand.EndsWith("'")) ||
            (operand.StartsWith("\"") && operand.EndsWith("\""))) {
            if (operand.Length >= 2) {
                return operand.Substring(1, operand.Length - 2);
            }
            return "";
        }
        if (operand == "true") { return "true"; }
        if (operand == "false") { return "false"; }
        if (operand == "null") { return ""; }
        string sval = "";
        if (this.TryResolveString(c, operand, out sval)) {
            return sval;
        }
        return "";
    }

    string EvalAttrExpr(Control c, string expr) {
        if (expr == "") { return ""; }
        string s = expr.Trim();
        if (s == "") { return ""; }
        int qIdx = 0 - 1;
        int colonIdx = 0 - 1;
        bool inQuote = false;
        int quoteChar = 0;
        for (int i = 0; i < s.Length; i = i + 1) {
            int ch = (int)s[i];
            if (ch == 39 || ch == 34) {
                if (!inQuote) {
                    inQuote = true;
                    quoteChar = ch;
                } else if (quoteChar == ch) {
                    inQuote = false;
                }
            } else if (!inQuote) {
                if (ch == 63 && qIdx < 0) {
                    qIdx = i;
                } else if (ch == 58 && qIdx >= 0 && colonIdx < 0) {
                    colonIdx = i;
                    break;
                }
            }
        }
        if (qIdx >= 0 && colonIdx > qIdx) {
            string cond = s.Substring(0, qIdx).Trim();
            string trueBranch = s.Substring(qIdx + 1, colonIdx - (qIdx + 1)).Trim();
            string falseBranch = s.Substring(colonIdx + 1).Trim();
            bool condVal = this.EvalExpr(c, cond);
            string chosen = condVal ? trueBranch : falseBranch;
            return this.ResolveOperandStr(c, chosen);
        }
        return this.ResolveOperandStr(c, s);
    }

    string EvalClassExpr(Control c, string expr) {
        return this.EvalAttrExpr(c, expr);
    }

    string EvalInterpolation(Control c, string tpl) {
        if (tpl == "" || tpl.IndexOf("{{") < 0) { return tpl; }
        StringBuilder sb = new StringBuilder();
        int cur = 0;
        while (cur < tpl.Length) {
            int open = tpl.IndexOf("{{", cur);
            if (open < 0) {
                sb.Append(tpl.Substring(cur));
                break;
            }
            if (open > cur) {
                sb.Append(tpl.Substring(cur, open - cur));
            }
            int close = tpl.IndexOf("}}", open + 2);
            if (close < 0) {
                sb.Append(tpl.Substring(open));
                break;
            }
            string expr = tpl.Substring(open + 2, close - (open + 2)).Trim();
            string val = this.EvalAttrExpr(c, expr);
            sb.Append(val);
            cur = close + 2;
        }
        return sb.ToString();
    }
}
