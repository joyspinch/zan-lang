using System;
using System.Collections.Generic;
using Gui;

namespace Gui;

// 通用列表/树/表格行选择与键盘导航模型（Layer 4 Core）：
// 统一单选主项、Ctrl 切换多选、Shift 区间连选、越界裁剪与方向键/翻页/首尾跳转。
public class SelectionModel {
    public List<int> marks;

    public SelectionModel() {
        this.marks = new List<int>();
    }

    public void Clear() {
        this.marks = new List<int>();
    }

    public void Prune(int count) {
        int i = this.marks.Count - 1;
        while (i >= 0) {
            if (this.marks[i] < 0 || this.marks[i] >= count) {
                this.marks.RemoveAt(i);
            }
            i = i - 1;
        }
    }

    public bool IsMarked(int row, int primary) {
        if (row < 0) { return false; }
        if (row == primary && primary >= 0) { return true; }
        for (int i = 0; i < this.marks.Count; i = i + 1) {
            if (this.marks[i] == row) { return true; }
        }
        return false;
    }

    public List<int> SelectedIndices(int count, int primary) {
        List<int> outp = new List<int>();
        for (int i = 0; i < count; i = i + 1) {
            if (this.IsMarked(i, primary)) { outp.Add(i); }
        }
        return outp;
    }

    // Ctrl+Click 切换单个索引；返回更新后的主选中索引。
    public int ToggleCtrl(int index, int primary) {
        bool was = false;
        for (int i = 0; i < this.marks.Count; i = i + 1) {
            if (this.marks[i] == index) {
                this.marks.RemoveAt(i);
                was = true;
                break;
            }
        }
        if (primary == index) {
            primary = 0 - 1;
            was = true;
        }
        if (!was) {
            if (primary < 0) { primary = index; }
            else { this.marks.Add(index); }
        }
        return primary;
    }

    // Shift+Click 区间连选（仅添加满足 canSelect 的行）。
    public void SelectRange(int anchor, int target, int primary, Predicate<int> canSelect) {
        if (anchor < 0 || target < 0) { return; }
        int lo = anchor < target ? anchor : target;
        int hi = anchor < target ? target : anchor;
        for (int r = lo; r <= hi; r = r + 1) {
            bool ok = canSelect == null || canSelect(r);
            if (ok && !this.IsMarked(r, primary)) {
                this.marks.Add(r);
            }
        }
    }

    // 从 current 出发按步长 delta（如 -1 / +1 / -10 / +10）查找下一个可选行。
    public static int StepIndex(int current, int delta, int count, Predicate<int> canSelect) {
        if (count <= 0 || delta == 0) { return 0 - 1; }
        int dir = delta > 0 ? 1 : (0 - 1);
        int steps = delta > 0 ? delta : (0 - delta);
        int pos = current;
        if (pos < 0 || pos >= count) {
            pos = dir > 0 ? (0 - 1) : count;
        }
        int lastValid = 0 - 1;
        int taken = 0;
        int probe = pos + dir;
        while (probe >= 0 && probe < count) {
            if (canSelect == null || canSelect(probe)) {
                lastValid = probe;
                taken = taken + 1;
                if (taken >= steps) { return probe; }
            }
            probe = probe + dir;
        }
        return lastValid;
    }

    // 查找首行或末行可选索引（Home / End）。
    public static int EdgeIndex(bool toEnd, int count, Predicate<int> canSelect) {
        if (count <= 0) { return 0 - 1; }
        if (!toEnd) {
            for (int i = 0; i < count; i = i + 1) {
                if (canSelect == null || canSelect(i)) { return i; }
            }
            return 0 - 1;
        }
        for (int i = count - 1; i >= 0; i = i - 1) {
            if (canSelect == null || canSelect(i)) { return i; }
        }
        return 0 - 1;
    }
}
