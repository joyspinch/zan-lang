using System;
using System.Text.Json;
using Gui;
using Gui.Widget;

namespace Gui;

// 一帧的绘制体（参见 App.RunLoop / App.SafeFrame）。
public delegate void FrameBody();

// <a href> 内嵌导航器（App.linkNavigator）：由 WebView 家族经
// App.SetLinkNavigator 注册；app=发起导航的宿主。返回 true =
// 已处理（含 WebView 不可用时转交系统浏览器的内部回落）。
public delegate bool LinkNavigateFn(App app, string url);

// HTML 装载后端（App.LoadHtmlWith 的实现，Gui.Html 经
// App.SetHtmlLoader 注册）。
public delegate Control HtmlLoadFn(App app, string html, HtmlHandlers handlers, string baseDir);

// 帧呈现尾段挂点（App.PresentFrame：弹层/提示绘制之后、原生浮层
// 结算之前）。重家族的跨帧收尾经 App.AddPresentTail 注册（Chart
// 的延迟提示刷新），App 编译图不背这些家族。
public delegate void AppHookFn(App app);

// <a href> 链接扫描（HTML 声明层 P5 语义：把声明 <a> 接到
// App.OpenLink），由 Gui.Html.Install() 经 App.SetLinkScanner 注册。
// 未安装 = 树里没有声明层 <a>，扫描空操作。
public delegate void LinkScanFn(Control root, App app);

// 深拷贝一棵控件树（HTML 模板行展开的原型复制），由
// Gui.Html.Install() 经 App.SetCloneTree 注册。未安装 = 没有
// 声明层模板原型可拷，返回 null（调用方跳过该行）。
public delegate Control CloneTreeFn(Control root);

// 子窗口挂起轮询退出谓词
public delegate bool ChildWindowStop();

// 控件事件委托（带 sender）
public delegate void ControlEvent(Control sender);

// 重型控件工厂委托
public delegate Control ControlFactoryFn(string kind);

// 原生浮层剪切委托
public delegate void NativeClipFn(int handle, string spec);

// 导航页面工厂与进入处理器
public delegate Control NavPageFactory();
public delegate void NavEnterHandler(NavWindow win, JsonValue args);
