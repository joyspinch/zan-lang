using System;

namespace Gui;

// 设计器属性的编辑器种类（PropSpec.kind）。
public enum PropKind {
    Text = 0,    // 文本框
    Int = 1,     // 数字步进框
    Bool = 2,    // 开关
    Enum = 3,    // 下拉选项（见 PropSpec.options）
    Color = 4,   // 颜色拾取（值为打包 ARGB 整数）
    Section = 5  // 分组标题行（无值、无编辑器）
}

// 属性绑定的值类型（与编辑器种类无关：枚举可绑定字符串或整数）。
public enum PropValueKind {
    Text = 0,
    Int = 1,
    Bool = 2
}
