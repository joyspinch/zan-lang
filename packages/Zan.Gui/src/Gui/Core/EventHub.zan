using System;
using System.Collections.Generic;

namespace Gui;

// 整数 key 的多播事件注册表。应用以任意整数常量作事件名，
// 在帧循环前用 <see cref="On"/> 常驻订阅一次，之后每帧经
// <see cref="RaiseIf"/> 把即时模式的布尔条件（如 Ui.Clicked）
// 桥接为事件。
public class EventHub {
    List<Subscription> subs;

    EventHub() {
        this.subs = new List<Subscription>();
    }

    // 为事件 key 追加一个处理器（类似 <c>event += handler</c>）。
    void On(int key, Action handler) {
        subs.Add(new Subscription(key, handler));
    }

    // 移除某 key 注册的全部处理器（相当于清空事件）。
    void Off(int key) {
        int i = subs.Count - 1;
        while (i >= 0) {
            if (subs[i].key == key) {
                subs.RemoveAt(i);
            }
            i = i - 1;
        }
    }

    // 某 key 注册的处理器数量。
    int Count(int key) {
        int n = 0;
        for (int i = 0; i < subs.Count; i = i + 1) {
            if (subs[i].key == key) { n = n + 1; }
        }
        return n;
    }

    // 调用某 key 注册的全部处理器（多播）。
    void Raise(int key) {
        for (int i = 0; i < subs.Count; i = i + 1) {
            if (subs[i].key == key) {
                Action h = subs[i].handler;
                h();
            }
        }
    }

    // 仅当 <paramref name="fire"/> 为 true 时触发某 key 的处理器
    // （例如传入 <c>Ui.Clicked(app, id)</c> 在点击时触发）。
    void RaiseIf(int key, bool fire) {
        if (fire) { Raise(key); }
    }
}

