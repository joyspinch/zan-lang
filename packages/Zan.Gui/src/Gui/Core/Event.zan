using System;
using System.Threading;

namespace Gui;

/// <summary>
/// 无参数的 GUI 事件处理器，类似 C# 的 <c>Action</c> / <c>EventHandler</c>。
/// 可赋值为 lambda（<c>() =&gt; { ... }</c>）或静态方法组。
/// </summary>
delegate void Action();

/// <summary>
/// sender 通道专用委托：处理器收到触发事件的控件。
/// 独立命名而非复用 <c>Action&lt;Control&gt;</c>（后者住在
/// System.Linq，且与 <see cref="Action"/> 同名，子命名空间下
/// 名字解析歧义），也让注册点读起来明确是控件事件。
/// </summary>
delegate void ControlEvent(Control sender);

/// <summary>
/// 对运行时 UI 线程调度队列的轻量封装。后台线程
/// 调用 <see cref="Post"/> 把委托交回 UI 线程；UI 线程
/// 每帧清空一次队列（见 <c>App.Post</c> / <c>App.DrainPosts</c>）。
/// 队列本身由运行时内部的 OS 互斥锁保护，因此从任何线程
/// 发布都是安全的，也不会在非 UI 线程触碰 Zan 堆。
/// </summary>
class Dispatcher {
    [DllImport("crt", EntryPoint = "zan_dispatch_init")]
    static extern void PlatInit();

    [DllImport("crt", EntryPoint = "zan_dispatch_post")]
    static extern int PlatPost(Action handler);

    [DllImport("crt", EntryPoint = "zan_dispatch_take")]
    static extern Action PlatTake();

    [DllImport("crt", EntryPoint = "zan_dispatch_clear")]
    static extern void PlatClear();

    /// <summary>重置队列。在 UI 线程上、创建 worker 之前调用一次。</summary>
    static void Init() { Dispatcher.PlatInit(); }

    /// <summary>把要在 UI 线程运行的委托加入队列。线程安全。</summary>
    static bool Post(Action handler) { return Dispatcher.PlatPost(handler) != 0; }

    /// <summary>取出下一个排队的委托（UI 线程），为空时返回 null。</summary>
    static Action Take() { return Dispatcher.PlatTake(); }

    /// <summary>清空所有排队的委托。请在 UI 线程上调用，当
    /// 窗口关闭时，这样为已失效窗口派发的后台任务
    /// 就不会在下一个窗口的第一帧执行。</summary>
    static void Clear() { Dispatcher.PlatClear(); }
}

/// <summary>
/// 一个保留式多播事件注册表，将 C# 风格的委托事件
/// 叠加在即时模式控件上。处理器只需注册一次（在帧
/// 循环之前，按稳定的整数 key 注册），然后每帧把即时模式的点击
/// 通过 <see cref="RaiseIf"/> 桥接进来：
/// <code>
/// EventHub hub = new EventHub();
/// hub.On(BTN_SAVE, () =&gt; { ... });   // like  OnClick += handler
/// // per frame:
/// int id = Button.Render(app, x, y, "Save");
/// hub.RaiseIf(BTN_SAVE, Ui.Clicked(app, id));
/// </code>
/// 同一 key 的多次 <see cref="On"/> 调用都会被执行（多播）；
/// <see cref="Off"/> 清除它们（相当于对整个 key 执行 <c>OnClick -= handler</c>）。
/// </summary>
class Subscription {
    int key;
    Action handler;

    Subscription(int key, Action handler) {
        this.key = key;
        this.handler = handler;
    }
}

/// <summary>
/// 整数 key 的多播事件注册表。应用以任意整数常量作事件名，
/// 在帧循环前用 <see cref="On"/> 常驻订阅一次，之后每帧经
/// <see cref="RaiseIf"/> 把即时模式的布尔条件（如 Ui.Clicked）
/// 桥接为事件。
/// </summary>
class EventHub {
    List<Subscription> subs;

    EventHub() {
        this.subs = new List<Subscription>();
    }

    /// <summary>为事件 key 追加一个处理器（类似 <c>event += handler</c>）。</summary>
    void On(int key, Action handler) {
        subs.Add(new Subscription(key, handler));
    }

    /// <summary>移除某 key 注册的全部处理器（相当于清空事件）。</summary>
    void Off(int key) {
        int i = subs.Count - 1;
        while (i >= 0) {
            if (subs[i].key == key) {
                subs.RemoveAt(i);
            }
            i = i - 1;
        }
    }

    /// <summary>某 key 注册的处理器数量。</summary>
    int Count(int key) {
        int n = 0;
        for (int i = 0; i < subs.Count; i = i + 1) {
            if (subs[i].key == key) { n = n + 1; }
        }
        return n;
    }

    /// <summary>调用某 key 注册的全部处理器（多播）。</summary>
    void Raise(int key) {
        for (int i = 0; i < subs.Count; i = i + 1) {
            if (subs[i].key == key) {
                Action h = subs[i].handler;
                h();
            }
        }
    }

    /// <summary>仅当 <paramref name="fire"/> 为 true 时触发某 key 的处理器
    /// （例如传入 <c>Ui.Clicked(app, id)</c> 在点击时触发）。</summary>
    void RaiseIf(int key, bool fire) {
        if (fire) { Raise(key); }
    }
}

/// <summary>
/// C# 风格的多播事件。与 <see cref="EventHub"/>（按键轮询）不同，
/// UiEvent 是控件上的一个一等字段，支持委托
/// <c>+=</c> / <c>-=</c> 运算符，因此注册处理器的方式与 C# 完全一致：
/// C#：
/// <code>
/// Button save = new Button { Text = "Save" };   // retained
/// save.Click += () =&gt; { Console.WriteLine("saved"); };
/// save.Click += Store.Commit;            // method group
/// // per frame:
/// save.Render(app, x, y, 120);           // fires Click on click
/// </code>
/// 内置控件事件在 <c>Render</c> 内部触发，即在 UI 线程上，
/// 因此处理器访问 UI 始终是安全的。要从工作线程触发，
/// 可使用 <see cref="Post"/>，它会将所有处理器调度回
/// UI 线程的分发队列。
/// </summary>
class UiEvent {
    List<Action> handlers;
    /// 平行 sender 通道（S = Sender）：注册在这里的处理器在触发时
    /// 收到触发事件的控件。与无参通道相互独立、可混用；同一事件
    /// 内先无参后带 sender，各自保持注册顺序。编译器按名称解析
    /// 调用（无重载），因此带 sender 通道是平行方法而非重载。
    List<ControlEvent> senderHandlers;

    UiEvent() {
        this.handlers = new List<Action>();
        this.senderHandlers = new List<ControlEvent>();
    }

    /// 支持 <c>event += handler</c> 的运算符（追加，多播）。
    static UiEvent op_add(UiEvent self, Action handler) {
        self.handlers.Add(handler);
        return self;
    }

    /// 支持 <c>event -= handler</c> 的运算符（移除最近的
    /// 相同注册项；若从未添加则为空操作）。
    static UiEvent op_sub(UiEvent self, Action handler) {
        int i = self.handlers.Count - 1;
        while (i >= 0) {
            if (self.handlers[i] == handler) {
                self.handlers.RemoveAt(i);
                return self;
            }
            i = i - 1;
        }
        return self;
    }

    /// 注册一个处理器（等同 <c>+=</c>）。
    void Add(Action handler) { handlers.Add(handler); }

    /// ---- 平行 sender 通道（S = Sender）----
    /// 注册带 sender 的处理器：触发时收到触发本事件的控件。
    /// 等价旧通道的 <see cref="Add"/>，存进独立的表。
    void AddS(ControlEvent h) { senderHandlers.Add(h); }

    /// 移除 sender 通道最近的相同注册项；从未添加则为空操作。
    void RemoveS(ControlEvent h) {
        int i = senderHandlers.Count - 1;
        while (i >= 0) {
            if (senderHandlers[i] == h) {
                senderHandlers.RemoveAt(i);
                return;
            }
            i = i - 1;
        }
    }

    /// sender 通道已注册的处理器数量。
    int CountS() { return senderHandlers.Count; }

    /// 两个通道的处理器合计数——"有没有人监听"类门控用它，
    /// 只看 <see cref="Count"/> 会漏掉仅注册 sender 通道的控件。
    int CountAll() { return handlers.Count + senderHandlers.Count; }

    /// 清空所有处理器。
    void Clear() { handlers = new List<Action>(); }

    /// 已注册的处理器数量。
    int Count() { return handlers.Count; }

    /// 在当前线程上调用所有处理器。
    void Raise() {
        for (int i = 0; i < handlers.Count; i = i + 1) {
            Action h = handlers[i];
            h();
        }
    }

    /// 全通道触发：先调用无参处理器，再把 <paramref name="sender"/>
    /// 传给 sender 通道。这是控件事件每帧的标准触发路径；
    /// <see cref="Raise"/> 只触发无参通道，供无 sender 语境的
    /// 非控件 UiEvent（如 DataTable 的列宽事件）继续使用。
    void RaiseS(Control sender) {
        for (int i = 0; i < handlers.Count; i = i + 1) {
            Action h = handlers[i];
            h();
        }
        for (int i = 0; i < senderHandlers.Count; i = i + 1) {
            ControlEvent h = senderHandlers[i];
            h(sender);
        }
    }

    /// 仅当 <paramref name="fire"/> 为 true 时才调用处理器。
    void RaiseIf(bool fire) {
        if (fire) { this.Raise(); }
    }

    /// <see cref="RaiseIf"/> 的全通道形式。
    void RaiseIfS(bool fire, Control sender) {
        if (fire) { this.RaiseS(sender); }
    }

    /// 将所有处理器调度到 UI 线程的分发队列。可从
    /// 任何线程安全调用；处理器稍后在 UI 线程上执行（参见 App.DrainPosts）。
    void Post() {
        for (int i = 0; i < handlers.Count; i = i + 1) {
            Action h = handlers[i];
            Dispatcher.Post(h);
        }
    }

    /// <see cref="Post"/> 的全通道形式：sender 在入队时就地捕获，
    /// 处理器稍后在 UI 线程上收到该控件。
    void PostS(Control sender) {
        for (int i = 0; i < handlers.Count; i = i + 1) {
            Action h = handlers[i];
            Dispatcher.Post(h);
        }
        for (int i = 0; i < senderHandlers.Count; i = i + 1) {
            ControlEvent h = senderHandlers[i];
            Dispatcher.Post(() => { h(sender); });
        }
    }
}

/// <summary>
/// 常用控件事件的可复用集合。保留式控件内嵌
/// 一个 <c>WidgetEvents</c> 字段，每帧调用一次 <see cref="Fire"/>
/// （在渲染完并注册命中区域之后），而不必手动
/// 推导每次状态转换，应用代码因此呈声明式风格：
/// <code>
/// btn.On.Enter += () =&gt; { ... };
/// btn.On.Click += () =&gt; { ... };
/// </code>
/// 触屏安全：在触摸屏上，单次触摸会作为合成的鼠标
/// 事件序列到达，因此 <c>Click</c> 相当于轻点，<c>MouseDown</c>/<c>MouseUp</c> 框住
/// 整个触摸过程；没有真正的悬停，所以 <c>Enter</c>/<c>Leave</c> 只在按压期间触发
/// 且不会误触发。
/// </summary>
class WidgetEvents {
    // 指针事件。
    UiEvent Click;
    UiEvent DoubleClick;
    UiEvent RightClick;
    UiEvent MouseDown;
    UiEvent MouseUp;
    UiEvent Enter;
    UiEvent Leave;
    UiEvent Move;
    UiEvent Wheel;
    // 焦点 + 键盘事件。
    UiEvent Focus;
    UiEvent Blur;
    UiEvent KeyDown;
    UiEvent KeyUp;
    UiEvent KeyPress;
    // 触摸 / 手势事件。
    UiEvent Tap;
    UiEvent LongPress;
    UiEvent Swipe;
    // 拖放（由单指指针合成）。
    UiEvent DragStart;
    UiEvent Drag;
    UiEvent Drop;

    WidgetEvents() {
        Click = new UiEvent();
        DoubleClick = new UiEvent();
        RightClick = new UiEvent();
        MouseDown = new UiEvent();
        MouseUp = new UiEvent();
        Enter = new UiEvent();
        Leave = new UiEvent();
        Move = new UiEvent();
        Wheel = new UiEvent();
        Focus = new UiEvent();
        Blur = new UiEvent();
        KeyDown = new UiEvent();
        KeyUp = new UiEvent();
        KeyPress = new UiEvent();
        Tap = new UiEvent();
        LongPress = new UiEvent();
        Swipe = new UiEvent();
        DragStart = new UiEvent();
        Drag = new UiEvent();
        Drop = new UiEvent();
    }

    /// 将 `a` 订阅到名为 `evt` 的通用事件（该名称由
    /// Control.CommonEvents 返回，也用于设计器的 `on<Event>` JSON 键）。
    /// 未知名称会被忽略，这样引用特定控件
    /// 事件（在别处接线）的文档不会在此报错。匹配时返回 true。
    bool AddByName(string evt, Action a) {
        if (evt == "Click") { Click.Add(a); return true; }
        if (evt == "DoubleClick") { DoubleClick.Add(a); return true; }
        if (evt == "RightClick") { RightClick.Add(a); return true; }
        if (evt == "MouseDown") { MouseDown.Add(a); return true; }
        if (evt == "MouseUp") { MouseUp.Add(a); return true; }
        if (evt == "Enter") { Enter.Add(a); return true; }
        if (evt == "Leave") { Leave.Add(a); return true; }
        if (evt == "Move") { Move.Add(a); return true; }
        if (evt == "Wheel") { Wheel.Add(a); return true; }
        if (evt == "Focus") { Focus.Add(a); return true; }
        if (evt == "Blur") { Blur.Add(a); return true; }
        if (evt == "KeyDown") { KeyDown.Add(a); return true; }
        if (evt == "KeyUp") { KeyUp.Add(a); return true; }
        if (evt == "KeyPress") { KeyPress.Add(a); return true; }
        if (evt == "Tap") { Tap.Add(a); return true; }
        if (evt == "LongPress") { LongPress.Add(a); return true; }
        if (evt == "Swipe") { Swipe.Add(a); return true; }
        if (evt == "DragStart") { DragStart.Add(a); return true; }
        if (evt == "Drag") { Drag.Add(a); return true; }
        if (evt == "Drop") { Drop.Add(a); return true; }
        return false;
    }

    /// <see cref="AddByName"/> 的 sender 通道形式：按事件名订阅，
    /// 触发时处理器收到触发事件的控件（<see cref="Control.BindEventS"/>
    /// 的基类路由）。
    bool AddByNameS(string evt, ControlEvent a) {
        if (evt == "Click") { Click.AddS(a); return true; }
        if (evt == "DoubleClick") { DoubleClick.AddS(a); return true; }
        if (evt == "RightClick") { RightClick.AddS(a); return true; }
        if (evt == "MouseDown") { MouseDown.AddS(a); return true; }
        if (evt == "MouseUp") { MouseUp.AddS(a); return true; }
        if (evt == "Enter") { Enter.AddS(a); return true; }
        if (evt == "Leave") { Leave.AddS(a); return true; }
        if (evt == "Move") { Move.AddS(a); return true; }
        if (evt == "Wheel") { Wheel.AddS(a); return true; }
        if (evt == "Focus") { Focus.AddS(a); return true; }
        if (evt == "Blur") { Blur.AddS(a); return true; }
        if (evt == "KeyDown") { KeyDown.AddS(a); return true; }
        if (evt == "KeyUp") { KeyUp.AddS(a); return true; }
        if (evt == "KeyPress") { KeyPress.AddS(a); return true; }
        if (evt == "Tap") { Tap.AddS(a); return true; }
        if (evt == "LongPress") { LongPress.AddS(a); return true; }
        if (evt == "Swipe") { Swipe.AddS(a); return true; }
        if (evt == "DragStart") { DragStart.AddS(a); return true; }
        if (evt == "Drag") { Drag.AddS(a); return true; }
        if (evt == "Drop") { Drop.AddS(a); return true; }
        return false;
    }

    /// 当内置事件中至少有一个监听器时返回 true。允许
    /// 容器跳过命中区域的注册（从而不抢占
    /// 下方内容的指针），直到有人监听。
    bool Any() {
        if (Click.CountAll() > 0) { return true; }
        if (DoubleClick.CountAll() > 0) { return true; }
        if (RightClick.CountAll() > 0) { return true; }
        if (MouseDown.CountAll() > 0) { return true; }
        if (MouseUp.CountAll() > 0) { return true; }
        if (Enter.CountAll() > 0) { return true; }
        if (Leave.CountAll() > 0) { return true; }
        if (Move.CountAll() > 0) { return true; }
        if (Wheel.CountAll() > 0) { return true; }
        if (Focus.CountAll() > 0) { return true; }
        if (Blur.CountAll() > 0) { return true; }
        if (KeyDown.CountAll() > 0) { return true; }
        if (KeyUp.CountAll() > 0) { return true; }
        if (KeyPress.CountAll() > 0) { return true; }
        if (Tap.CountAll() > 0) { return true; }
        if (LongPress.CountAll() > 0) { return true; }
        if (Swipe.CountAll() > 0) { return true; }
        if (DragStart.CountAll() > 0) { return true; }
        if (Drag.CountAll() > 0) { return true; }
        if (Drop.CountAll() > 0) { return true; }
        return false;
    }

    /// 本帧对 `id` 满足条件的已注册处理器都会触发，
    /// 在控件注册命中区域后每帧调用一次。
    /// <paramref name="sender"/> 是触发事件的控件（两通道都会收到，
    /// 无参处理器忽略它）；自行接线的控件传 <c>this</c>。
    /// 全部事件以有无监听器为门槛（Ui.* 查询是纯谓词，读的焦点/
    /// 悬停快照由 App.PresentFrame 统一翻转，跳过调用不影响状态
    /// 推进）——保留树里大量的静态控件（无任何订阅者）不再为
    /// 点击族/焦点族/进入离开族每帧付出完整的谓词求值与分发路径。
    void Fire(App app, int id, Control sender) {
        if (Click.CountAll() > 0) { Click.RaiseIfS(Ui.Clicked(app, id), sender); }
        if (DoubleClick.CountAll() > 0) { DoubleClick.RaiseIfS(Ui.DoubleClicked(app, id), sender); }
        if (MouseDown.CountAll() > 0) { MouseDown.RaiseIfS(Ui.PressedDown(app, id), sender); }
        if (MouseUp.CountAll() > 0) { MouseUp.RaiseIfS(Ui.MouseUpOn(app, id), sender); }
        if (Enter.CountAll() > 0) { Enter.RaiseIfS(Ui.Entered(app, id), sender); }
        if (Leave.CountAll() > 0) { Leave.RaiseIfS(Ui.Left(app, id), sender); }
        if (Focus.CountAll() > 0) { Focus.RaiseIfS(Ui.FocusGained(app, id), sender); }
        if (Blur.CountAll() > 0) { Blur.RaiseIfS(Ui.FocusLost(app, id), sender); }
        if (Tap.CountAll() > 0) { Tap.RaiseIfS(Ui.Tapped(app, id), sender); }
        if (RightClick.CountAll() > 0) { RightClick.RaiseIfS(Ui.RightClicked(app, id), sender); }
        if (Move.CountAll() > 0) { Move.RaiseIfS(Ui.MovedOver(app, id), sender); }
        if (Wheel.CountAll() > 0) { Wheel.RaiseIfS(Ui.Wheeled(app, id), sender); }
        if (KeyDown.CountAll() > 0) { KeyDown.RaiseIfS(Ui.KeyDownOn(app, id), sender); }
        if (KeyUp.CountAll() > 0) { KeyUp.RaiseIfS(Ui.KeyUpOn(app, id), sender); }
        if (KeyPress.CountAll() > 0) { KeyPress.RaiseIfS(Ui.KeyDownOn(app, id), sender); }
        if (Swipe.CountAll() > 0) { Swipe.RaiseIfS(Ui.SwipedAny(app, id), sender); }
        if (DragStart.CountAll() > 0) { DragStart.RaiseIfS(Ui.PressedDown(app, id), sender); }
        if (Drag.CountAll() > 0) { Drag.RaiseIfS(Ui.Dragging(app, id), sender); }
        if (Drop.CountAll() > 0) { Drop.RaiseIfS(Ui.Dropped(app, id), sender); }
        // 仅在有人监听时才轮询长按计时器：
        // 轮询会在按住期间调度低频率的后续帧，跳过它可保持
        // 不使用长按的控件在空闲/按压时零 CPU 开销。
        if (LongPress.CountAll() > 0) {
            LongPress.RaiseIfS(Ui.LongPressed(app, id), sender);
        }
    }
}

