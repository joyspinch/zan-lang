using System;
using Gui.Backend;
namespace Gui;
public partial class App {
    // 压入字符串命名的 ID 作用域（Path Hash ID Stack）。
    void PushId(string strKey) { if (focus != null) { focus.PushId(strKey); } }
    void PushId(int intKey) { if (focus != null) { focus.PushId(intKey); } }
    void PopId() { if (focus != null) { focus.PopId(); } }

    int ChromeButtonCount() {
        int count = this.showCloseButton ? 1 : 0;
        if (showThemeButton) { count = count + 1; }
        if (showPinButton) { count = count + 1; }
        if (showMinimizeButton) { count = count + 1; }
        if (showMaximizeButton) { count = count + 1; }
        return count;
    }
    void SetChromeButtons(
        bool themeButton,
        bool pinButton,
        bool minimizeButton,
        bool maximizeButton
    ) {
        if (isChildWindow) {
            themeButton = false;
            pinButton = false;
        }
        showThemeButton = themeButton && themeSettingsAction != null;
        showPinButton = pinButton;
        showMinimizeButton = minimizeButton;
        showMaximizeButton = maximizeButton;
        window.SetCaptionButtons(ChromeButtonCount());
        window.SetMaximizable(maximizeButton);
        this.Stats.NoteRedrawWhy("SetChromeButtons");
        needsRedraw = true;
    }
    void SetChildMode(bool child) {
        isChildWindow = child;
        if (child) {
            showThemeButton = false;
            showPinButton = false;
            window.SetCaptionButtons(ChromeButtonCount());
        }
    }
    bool IsChildMode() { return isChildWindow; }
    bool CaptionTipShown(int id, int bx, int bw, int hbar) {
        if (focus == null || !focus.IsHovered(id)) { return false; }
        if (this.PointerCaptured()) { return false; }
        return Window.GetTickMs() - focus.hoverStartMs >= 900;
    }
    int CaptionTipX(int bx, int bw) { return bx + bw / 2 - this.Scale(300) / 2; }
    void NoteCaptionTip(int id, int bx, int bw, int hbar) {
        if (id == capTipId) { return; }
        int tipW = this.Scale(300);
        int tipH = hbar + this.Scale(80);
        if (capTipId != 0) { this.RequestAnimationFrameIn(capTipX, 0, tipW, tipH); }
        if (id != 0) {
            int nx = this.CaptionTipX(bx, bw);
            this.RequestAnimationFrameIn(nx, 0, tipW, tipH);
            capTipX = nx;
        }
        capTipId = id;
    }
    void SetCaptionTips(
        string theme,
        string pin,
        string minimize,
        string maximize,
        string restore,
        string close
    ) {
        themeTipText = theme != null ? theme : "";
        pinTipText = pin != null ? pin : "";
        minimizeTipText = minimize != null ? minimize : "";
        maximizeTipText = maximize != null ? maximize : "";
        restoreTipText = restore != null ? restore : "";
        closeTipText = close != null ? close : "";
    }
    void FollowCaptionTips(App src) {
        if (src == null) { return; }
        this.SetCaptionTips(src.themeTipText, src.pinTipText,
            src.minimizeTipText, src.maximizeTipText, src.restoreTipText,
            src.closeTipText);
    }
    public void SetWindowPos(int x, int y) { window.SetPosition(x, y); }
    public void SetClientSize(int w, int h) { window.SetClientSize(w, h); }
    public void SetClientSizeDev(int wDev, int hDev) { window.SetClientSizeDev(wDev, hDev); }
    public void CenterWindow() { window.Center(); }
    void SwapCanvas(int w, int h) {
        if (w < 1) { w = 1; }
        if (h < 1) { h = 1; }
        Canvas old = canvas;
        canvas = new Canvas(w, h);
        if (old != null) { old.Destroy(); }
        bgThemeGen = bgThemeGen + 1;
        Damage.partialPending = false;
        Damage.partialFrame = false;
        Damage.dmgW = 0;
        Damage.dmgH = 0;
        animRectValid = false;
        animRectAll = false;
        inputNeedsFrame = false;
        animPrevValid = false;
        fxSnapValid = false;
        fxDamage = null;
        fxTouched = null;
        fxTouchedFull = false;
    }
}
