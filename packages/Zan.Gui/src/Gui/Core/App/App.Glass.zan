using System;
using Gui.Backend;
namespace Gui;
public partial class App {
    void NoteHoverDamage(Control oldControl, Control newControl) {
        if (this.ForceFullFrames()) { partialPending = false; return; }
        if (partialBlocked) {
            this.NoteRedrawWhy("hover-blocked");
            partialPending = false;
            return;
        }
        if (this.HasOverlays() || this.PointerCaptured()) {
            this.NoteRedrawWhy("hover-blocked");
            partialPending = false;
            return;
        }
        bool hasRa = oldControl != null && oldControl.bw > 0 && oldControl.bh > 0;
        bool hasRb = newControl != null && newControl.bw > 0 && newControl.bh > 0;
        if (!hasRa && !hasRb) {
            this.NoteRedrawWhy("hover-norect");
            partialPending = false;
            return;
        }
        int pad = this.Scale(6);
        int x0 = canvas.Width();
        int y0 = canvas.Height();
        int x1 = 0;
        int y1 = 0;
        if (hasRa) {
            if (oldControl.bx < x0) { x0 = oldControl.bx; }
            if (oldControl.by < y0) { y0 = oldControl.by; }
            if (oldControl.bx + oldControl.bw > x1) { x1 = oldControl.bx + oldControl.bw; }
            if (oldControl.by + oldControl.bh > y1) { y1 = oldControl.by + oldControl.bh; }
        }
        if (hasRb) {
            if (newControl.bx < x0) { x0 = newControl.bx; }
            if (newControl.by < y0) { y0 = newControl.by; }
            if (newControl.bx + newControl.bw > x1) { x1 = newControl.bx + newControl.bw; }
            if (newControl.by + newControl.bh > y1) { y1 = newControl.by + newControl.bh; }
        }
        x0 = x0 - pad;
        y0 = y0 - pad;
        x1 = x1 + pad;
        y1 = y1 + pad;
        if (partialPending) {
            if (dmgX < x0) { x0 = dmgX; }
            if (dmgY < y0) { y0 = dmgY; }
            if (dmgX + dmgW > x1) { x1 = dmgX + dmgW; }
            if (dmgY + dmgH > y1) { y1 = dmgY + dmgH; }
        }
        if (x0 < 0) { x0 = 0; }
        if (y0 < 0) { y0 = 0; }
        if (x1 > canvas.Width()) { x1 = canvas.Width(); }
        if (y1 > canvas.Height()) { y1 = canvas.Height(); }
        if (x1 - x0 <= 0 || y1 - y0 <= 0) {
            partialPending = false;
            return;
        }
        dmgX = x0;
        dmgY = y0;
        dmgW = x1 - x0;
        dmgH = y1 - y0;
        partialPending = true;
    }
    void PushId(string strKey) { focus.PushId(strKey); }
    void PushId(int intKey) { focus.PushId(intKey); }
    void PopId() { focus.PopId(); }
    void NoteGlassRect(int x, int y, int w, int h) {
        if (glassPanels != null && glassPanels.Count >= 64) { return; }
        if (glassPanels == null) { glassPanels = new List<Rect>(); }
        glassPanels.Add(new Rect(x, y, w, h));
        if (glassRects.Count < 256) {
            glassRects.Add(x);
            glassRects.Add(y);
            glassRects.Add(w);
            glassRects.Add(h);
        }
    }
    bool WidenDamageToGlass() {
        int x0 = dmgX;
        int y0 = dmgY;
        int x1 = dmgX + dmgW;
        int y1 = dmgY + dmgH;
        bool any = false;
        if (glassPanels != null && glassPanels.Count > 0) {
            for (int p = 0; p < glassPanels.Count; p = p + 1) {
                Rect r = glassPanels[p];
                if (r == null) { continue; }
                int gx = r.x;
                int gy = r.y;
                int gw = r.width;
                int gh = r.height;
                if (gx + gw <= x0 || x1 <= gx) { continue; }
                if (gy + gh <= y0 || y1 <= gy) { continue; }
                if (gx < x0) { x0 = gx; }
                if (gy < y0) { y0 = gy; }
                if (gx + gw > x1) { x1 = gx + gw; }
                if (gy + gh > y1) { y1 = gy + gh; }
                any = true;
            }
        } else {
            int i = 0;
            while (i + 3 < glassRects.Count) {
                int gx = glassRects[i];
                int gy = glassRects[i + 1];
                int gw = glassRects[i + 2];
                int gh = glassRects[i + 3];
                i = i + 4;
                if (gx + gw <= x0 || x1 <= gx) { continue; }
                if (gy + gh <= y0 || y1 <= gy) { continue; }
                if (gx < x0) { x0 = gx; }
                if (gy < y0) { y0 = gy; }
                if (gx + gw > x1) { x1 = gx + gw; }
                if (gy + gh > y1) { y1 = gy + gh; }
                any = true;
            }
        }
        if (!any) { return false; }
        if (x0 < 0) { x0 = 0; }
        if (y0 < 0) { y0 = 0; }
        if (x1 > canvas.Width()) { x1 = canvas.Width(); }
        if (y1 > canvas.Height()) { y1 = canvas.Height(); }
        int w = x1 - x0;
        int h = y1 - y0;
        if (w <= 0 || h <= 0) { return false; }
        if (w * h * 2 > canvas.Width() * canvas.Height()) { return false; }
        dmgX = x0;
        dmgY = y0;
        dmgW = w;
        dmgH = h;
        partialPending = true;
        return true;
    }
    void SettleGlassRefresh() {
        if (!partialFrame) {
            glassRefreshOwe = false;
            glassRefreshArmedAt = 0 - 1;
            if (glassDeferredPanels != null) { glassDeferredPanels.Clear(); }
            glassDeferredRects.Clear();
            glassDeferred = false;
            return;
        }
        if (glassDeferred) { return; }
        if (!glassRefreshOwe || this.ScrollBurstActive()) { return; }
        if (glassRefreshArmedAt >= 0) {
            if (glassRefreshArmedAt != frameCount) {
                glassRefreshOwe = false;
                glassRefreshArmedAt = 0 - 1;
                if (glassDeferredPanels != null) { glassDeferredPanels.Clear(); }
                glassDeferredRects.Clear();
            }
            return;
        }
        int x0 = dmgX;
        int y0 = dmgY;
        int x1 = dmgX + dmgW;
        int y1 = dmgY + dmgH;
        if (glassDeferredPanels != null && glassDeferredPanels.Count > 0) {
            for (int p = 0; p < glassDeferredPanels.Count; p = p + 1) {
                Rect r = glassDeferredPanels[p];
                if (r == null) { continue; }
                int gx = r.x;
                int gy = r.y;
                int gw = r.width;
                int gh = r.height;
                if (gx < x0) { x0 = gx; }
                if (gy < y0) { y0 = gy; }
                if (gx + gw > x1) { x1 = gx + gw; }
                if (gy + gh > y1) { y1 = gy + gh; }
            }
        } else {
            int i = 0;
            while (i + 3 < glassDeferredRects.Count) {
                int gx = glassDeferredRects[i];
                int gy = glassDeferredRects[i + 1];
                int gw = glassDeferredRects[i + 2];
                int gh = glassDeferredRects[i + 3];
                i = i + 4;
                if (gx < x0) { x0 = gx; }
                if (gy < y0) { y0 = gy; }
                if (gx + gw > x1) { x1 = gx + gw; }
                if (gy + gh > y1) { y1 = gy + gh; }
            }
        }
        if (x0 < 0) { x0 = 0; }
        if (y0 < 0) { y0 = 0; }
        if (x1 > canvas.Width()) { x1 = canvas.Width(); }
        if (y1 > canvas.Height()) { y1 = canvas.Height(); }
        int w = x1 - x0;
        int h = y1 - y0;
        needsRedraw = true;
        if (w <= 0 || h <= 0
            || w * h * 2 > canvas.Width() * canvas.Height()) {
            partialBlocked = true;
            forceFullNext = true;
            this.NoteRedrawWhy("glass-partial-blur");
            return;
        }
        dmgX = x0;
        dmgY = y0;
        dmgW = w;
        dmgH = h;
        partialPending = true;
        glassRefreshArmedAt = frameCount;
        this.NoteRedrawWhy("glass-refresh");
    }
    public bool FrameDamageContains(int x, int y, int w, int h) {
        if (!partialFrame) { return true; }
        return w >= 0 && h >= 0 && x >= presentX && y >= presentY
        && (long)x + w <= (long)presentX + presentW
        && (long)y + h <= (long)presentY + presentH;
    }
    public void RequireFullFrame() { forceFullNext = true; }
    public void NoteDamage(int x, int y, int w, int h) {
        if (w <= 0 || h <= 0) { return; }
        this.InvalidateFormPaint();
        if (this.ForceFullFrames()) { partialBlocked = true; }
        needsRedraw = true;
        if (partialBlocked || this.HasOverlays()) {
            if (partialBlocked) { this.NoteRedrawWhy("dmg-blocked"); }
            else { this.NoteRedrawWhy("dmg-overlay"); }
            partialPending = false;
            return;
        }
        this.NoteRedrawWhy("dmg");
        int x0 = x;
        int y0 = y;
        int x1 = x + w;
        int y1 = y + h;
        if (partialPending) {
            if (dmgX < x0) { x0 = dmgX; }
            if (dmgY < y0) { y0 = dmgY; }
            if (dmgX + dmgW > x1) { x1 = dmgX + dmgW; }
            if (dmgY + dmgH > y1) { y1 = dmgY + dmgH; }
        }
        if (x0 < 0) { x0 = 0; }
        if (y0 < 0) { y0 = 0; }
        if (x1 > canvas.Width()) { x1 = canvas.Width(); }
        if (y1 > canvas.Height()) { y1 = canvas.Height(); }
        if (x1 - x0 <= 0 || y1 - y0 <= 0) {
            partialPending = false;
            return;
        }
        int dw = x1 - x0;
        int dh = y1 - y0;
        int totalArea = canvas.Width() * canvas.Height();
        if (totalArea > 0 && (long)dw * (long)dh * 10 > (long)totalArea * 6) {
            partialPending = false;
            return;
        }
        dmgX = x0;
        dmgY = y0;
        dmgW = dw;
        dmgH = dh;
        partialPending = true;
        if (frameDiagnostics != null) { frameDiagnostics.Damage(false, dmgX, dmgY, dmgW, dmgH); }
    }
    void NoteScrollDamage(int x, int y, int w, int h) {
        scrollBusyUntilMs = nowMs + 140;
        if (frameDiagnostics != null) { frameDiagnostics.Damage(true, x, y, w, h); }
        this.NoteDamage(x, y, w, h);
    }
    void CancelPartialFrame() { partialPending = false; }
    void MarkPresentDirty(List<int> rects) {
        if (rects == null) { return; }
        int i = 0;
        while (i + 3 < rects.Count) {
            window.PresentDirty(rects[i], rects[i + 1], rects[i + 2], rects[i + 3]);
            i = i + 4;
        }
    }
    int ChromeButtonCount() {
        int count = this.showCloseButton ? 1 : 0;
        if (showThemeButton) { count = count + 1; }
        if (showPinButton) { count = count + 1; }
        if (showMinimizeButton) { count = count + 1; }
        if (showMaximizeButton) { count = count + 1; }
        return count;
    }
    void SetChromeButtons(
        bool themeButton,
        bool pinButton,
        bool minimizeButton,
        bool maximizeButton
    ) {
        if (isChildWindow) {
            themeButton = false;
            pinButton = false;
        }
        showThemeButton = themeButton && themeSettingsAction != null;
        showPinButton = pinButton;
        showMinimizeButton = minimizeButton;
        showMaximizeButton = maximizeButton;
        window.SetCaptionButtons(ChromeButtonCount());
        window.SetMaximizable(maximizeButton);
        this.NoteRedrawWhy("SetChromeButtons");
        needsRedraw = true;
    }
    void SetChildMode(bool child) {
        isChildWindow = child;
        if (child) {
            showThemeButton = false;
            showPinButton = false;
            window.SetCaptionButtons(ChromeButtonCount());
        }
    }
    bool IsChildMode() { return isChildWindow; }
    bool CaptionTipShown(int id, int bx, int bw, int hbar) {
        if (focus == null || !focus.IsHovered(id)) { return false; }
        if (this.PointerCaptured()) { return false; }
        return Window.GetTickMs() - focus.hoverStartMs >= 900;
    }
    int CaptionTipX(int bx, int bw) { return bx + bw / 2 - this.Scale(300) / 2; }
    void NoteCaptionTip(int id, int bx, int bw, int hbar) {
        if (id == capTipId) { return; }
        int tipW = this.Scale(300);
        int tipH = hbar + this.Scale(80);
        if (capTipId != 0) { this.RequestAnimationFrameIn(capTipX, 0, tipW, tipH); }
        if (id != 0) {
            int nx = this.CaptionTipX(bx, bw);
            this.RequestAnimationFrameIn(nx, 0, tipW, tipH);
            capTipX = nx;
        }
        capTipId = id;
    }
    void SetCaptionTips(
        string theme,
        string pin,
        string minimize,
        string maximize,
        string restore,
        string close
    ) {
        themeTipText = theme;
        pinTipText = pin;
        minimizeTipText = minimize;
        maximizeTipText = maximize;
        restoreTipText = restore;
        closeTipText = close;
    }
    void FollowCaptionTips(App src) {
        this.SetCaptionTips(src.themeTipText, src.pinTipText,
            src.minimizeTipText, src.maximizeTipText, src.restoreTipText,
            src.closeTipText);
    }
    public void SetWindowPos(int x, int y) { window.SetPosition(x, y); }
    public void SetClientSize(int w, int h) { window.SetClientSize(w, h); }
    public void SetClientSizeDev(int wDev, int hDev) { window.SetClientSizeDev(wDev, hDev); }
    public void CenterWindow() { window.Center(); }
    void SwapCanvas(int w, int h) {
        Canvas old = canvas;
        canvas = new Canvas(w, h);
        old.Destroy();
        bgThemeGen = bgThemeGen + 1;
        partialPending = false;
        partialFrame = false;
        dmgW = 0;
        dmgH = 0;
        animRectValid = false;
        animRectAll = false;
        inputNeedsFrame = false;
        animPrevValid = false;
        fxSnapValid = false;
        fxDamage = null;
        fxTouched = null;
        fxTouchedFull = false;
    }
}
