using System;
using Gui.Backend;
namespace Gui;
public partial class App {
    private int cachedChromeGen = 0 - 1;
    private int cachedChromeScale = 0 - 1;
    private int cachedChromeDpi = 0 - 1;
    private int cachedChromeRuleSig = 0 - 1;
    private bool cachedChromeSys;
    private StyleBox cachedChromeStyle;
    private StyleBox cachedChromeTopStyle;
    private int cachedChromeTopCr = 0 - 1;
    private StyleBox cachedBrandStyle;
    private StyleBox cachedTitleStyle;
    private StyleBox cachedGlassStyle;
    private StyleBox cachedSheenStyle;
    private StyleBox cachedEdgeStyle;
    private StyleBox cachedEdgeHiStyle;
    private StyleBox cachedWinBgStyle;
    private StyleBox cachedWinGlassStyle;
    private StyleBox cachedBareStackStyle;
    private bool cachedRuleSigValid;
    private int cachedRuleSigGen;
    private int cachedRuleSigScale;
    private bool cachedRuleSigIso;
    private int cachedRuleSigSheet;
    private int cachedRuleSigChart;
    private int cachedRuleSigVal;
    public int CurrentStyleRuleSig() {
        int sheetRules = (isolateAppSheet || sheet == null) ? 0 : sheet.ContextRuleSig();
        int chartRules = chartSheet == null ? 0 : chartSheet.ContextRuleSig();
        if (cachedRuleSigValid && cachedRuleSigGen == bgThemeGen
            && cachedRuleSigScale == metricsScale && cachedRuleSigIso == isolateAppSheet
            && cachedRuleSigSheet == sheetRules && cachedRuleSigChart == chartRules) {
            return cachedRuleSigVal;
        }
        cachedRuleSigValid = true;
        cachedRuleSigGen = bgThemeGen;
        cachedRuleSigScale = metricsScale;
        cachedRuleSigIso = isolateAppSheet;
        cachedRuleSigSheet = sheetRules;
        cachedRuleSigChart = chartRules;
        cachedRuleSigVal = Style.ContextRuleSig(this);
        return cachedRuleSigVal;
    }
    private void EnsureCachedChromeStyles() {
        int rsig = this.CurrentStyleRuleSig();
        bool sys = this.HostIsolateAppSheet();
        if (cachedChromeStyle != null && cachedChromeGen == bgThemeGen
            && cachedChromeScale == metricsScale && cachedChromeDpi == dpiScale
            && cachedChromeRuleSig == rsig && cachedChromeSys == sys) {
            return;
        }
        cachedChromeGen = bgThemeGen;
        cachedChromeScale = metricsScale;
        cachedChromeDpi = dpiScale;
        cachedChromeRuleSig = rsig;
        cachedChromeSys = sys;
        cachedChromeStyle = Style.Full(this, "titlebar", "", "", Style.SNormal());
        cachedChromeTopStyle = null;
        cachedChromeTopCr = 0 - 1;
        cachedBrandStyle = Style.Part(this, "titlebar", "brand", "", "", "", Style.SNormal());
        cachedTitleStyle = Style.Part(this, "titlebar", "title", "", "", "", Style.SNormal());
        cachedGlassStyle = Style.Part(this, "titlebar", "glass", "", "", "", Style.SNormal());
        cachedSheenStyle = Style.Part(this, "titlebar", "sheen", "", "", "", Style.SNormal());
        cachedEdgeStyle = Style.Part(this, "titlebar", "edge", "", "", "", Style.SNormal());
        cachedEdgeHiStyle = Style.Part(this, "titlebar", "edge-highlight", "", "", "", Style.SNormal());
        cachedWinBgStyle = Style.Full(this, "windowbg", "", "", Style.SNormal());
        cachedWinGlassStyle = Style.Part(this, "windowbg", "glass", "", "", "", Style.SNormal());
        cachedBareStackStyle = Style.FullRef(this, "stack", "", "", Style.SNormal());
    }
    internal StyleBox CachedWindowBgStyle() {
        this.EnsureCachedChromeStyles();
        return cachedWinBgStyle;
    }
    internal StyleBox CachedWindowGlassStyle() {
        this.EnsureCachedChromeStyles();
        return cachedWinGlassStyle;
    }
    public StyleBox CachedBareStackStyle() {
        this.EnsureCachedChromeStyles();
        return cachedBareStackStyle;
    }
    public void RenderChrome(string title) {
        if (!showChrome) { return; }
        if (drawerOpaquePartial && Damage.presentY >= this.ContentTop() + this.ShapeOffY()) { return; }
        this.EnsureCachedChromeStyles();
        StyleBox chromeStyle = cachedChromeStyle;
        StyleBox brandStyle = cachedBrandStyle;
        StyleBox titleStyle = cachedTitleStyle;
        StyleBox glassStyle = cachedGlassStyle;
        StyleBox sheenStyle = cachedSheenStyle;
        StyleBox edgeStyle = cachedEdgeStyle;
        StyleBox edgeHighlightStyle = cachedEdgeHiStyle;
        Canvas c = canvas;
        Theme t = theme;
        int offX = this.ShapeOffX();
        int offY = this.ShapeOffY();
        int W = c.Width() - offX * 2;
        int hbar = titlebarH;
        NativeLayer.Occlude(this, offX, offY, W, hbar);
        int cr = this.EffectiveCornerRadius();
        bool shapeTop = cr > 0;
        if (shapeTop) {
            if (cachedChromeTopStyle == null || cachedChromeTopCr != cr) {
                StyleBox topCopy = chromeStyle.Clone();
                topCopy.SetRadius(cr);
                topCopy.SetCorners(Corner.Top());
                topCopy.shadow = 0;
                topCopy.blur = 0;
                cachedChromeTopStyle = topCopy;
                cachedChromeTopCr = cr;
            }
            chromeStyle = cachedChromeTopStyle;
        }
        if (t.glass != 0) {
            int tslot = this.BlurSlotFor(1);
            bool dirty = this.BackdropDirtyIn(tslot, offX, offY, W, hbar);
            if (shapeTop) {
                c.BlurRoundCached(offX, offY, W, hbar, Scale(22),
                    tslot, dirty, cr, Corner.Top());
                c.FillRoundRectIn(offX, offY, W, hbar, cr, Corner.Top(),
                                  glassStyle.BgOr(0));
                c.FillRoundRectIn(offX, offY, W, hbar, cr, Corner.Top(),
                                  sheenStyle.BgOr(0));
                if (chromeStyle.borderBottomW > 0) {
                    c.FillRect(offX + cr, offY + hbar - chromeStyle.borderBottomW,
                               W - cr * 2, chromeStyle.borderBottomW,
                               chromeStyle.borderBottomColor);
                }
            } else {
                c.BlurRectCached(offX, offY, W, hbar, Scale(22), tslot, dirty);
                c.FillRect(offX, offY, W, hbar, glassStyle.BgOr(0));
                c.FillRect(offX, offY, W, hbar, sheenStyle.BgOr(0));
                if (chromeStyle.borderBottomW > 0) {
                    c.FillRect(offX, offY + hbar - chromeStyle.borderBottomW, W,
                               chromeStyle.borderBottomW, chromeStyle.borderBottomColor);
                }
            }
        } else {
            chromeStyle.Paint(this, offX, offY, W, hbar);
        }
        int pad = t.paddingLarge + offX;
        int brand = t.iconSizeSmall;
        if (brandStyle.fontPx > 0) { brand = brandStyle.fontPx; }
        int brandY = offY + (hbar - brand) / 2;
        if (chromeBrandIcon != "") {
            c.DrawGlyph(chromeBrandIcon, pad, brandY, brand,
                        brandStyle.FgOr(0));
        } else {
            string brandKey = this.BrandImageKey();
            if (brandKey != "") {
                c.BlitImage(brandKey, pad, brandY, brand, brand, 0, 0, 0, 0);
            } else {
                c.DrawGlyph("home", pad, brandY, brand, brandStyle.FgOr(0));
            }
        }
        int titleFs = titleStyle.FontOr(Style.FontFallback(this, "medium"));
        int txtY = Canvas.CenterTextY(offY, hbar, titleFs);
        int titleX = pad + brand + t.gapSmall;
        c.DrawText(titleX, txtY, title,
                   titleStyle.FgOr(0), titleFs);
        if (chromeStatus != "" || chromeAccent != "") {
            StyleBox statusStyle = Style.Part(this, "titlebar", "status", "",
                                              "", "", Style.SNormal());
            StyleBox accentStyle = Style.Part(this, "titlebar", "status-accent",
                                              "", "", "", Style.SNormal());
            int fsS = statusStyle.FontOr(titleFs);
            int sy = Canvas.CenterTextY(offY, hbar, fsS);
            int sx = titleX + Canvas.MeasureText(title, titleFs)
                     + t.gapLarge;
            int limit = offX + W - t.paddingLarge;
            if (showChrome) { limit = limit - ChromeButtonCount() * captionBtnW; }
            if (chromeStatus != "") {
                int sw = Canvas.MeasureText(chromeStatus, fsS);
                if (sx + sw <= limit) {
                    c.DrawText(sx, sy, chromeStatus, statusStyle.FgOr(0), fsS);
                    sx = sx + sw + t.gapLarge;
                }
            }
            if (chromeAccent != "") {
                int aw = Canvas.MeasureText(chromeAccent, fsS);
                if (sx + aw <= limit) { c.DrawText(sx, sy, chromeAccent, accentStyle.FgOr(0), fsS); }
            }
        }

        this.PaintChromeTree();
        this.PaintChromeTooltips();
        if (glassNative) {
            int H = c.Height() - offY * 2;
            c.DrawRect(offX, offY, W, H, edgeStyle.BgOr(0), 1);
            c.FillRect(offX, offY, W, 1, edgeHighlightStyle.BgOr(0));
        }
    }
}
