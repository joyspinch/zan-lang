using System;
using Gui.Backend;
namespace Gui;
public partial class App {
    void RenderFrameOverlays() {
        if (!this.ContinuePreparedFrame()) { return; }
        RunOverlays();
        if (!this.ContinuePreparedFrame()) { return; }
        Widget.Tooltip.Flush(this);
        if (!this.ContinuePreparedFrame()) { return; }
        List<AppHookFn> presentTails = App.PresentTails();
        if (presentTails != null) {
            for (int i = 0; i < presentTails.Count; i = i + 1) {
                if (!this.ContinuePreparedFrame()) { return; }
                presentTails[i](this);
                if (!this.ContinuePreparedFrame()) { return; }
            }
        }
        if (preparedHostFrameValid && preparedHostTicket == null) {
            if (!this.WriteBackModelHosts()) { this.AbortPreparationFrame(); return; }
            if (!this.ContinuePreparedFrame()) { return; }
        }
    }
    void PresentFrame() {
        this.TraceFullPresent(21, true);
        if (!this.ContinuePreparedFrame()) {
            this.TraceFullPresent(22, true);
            return;
        }
        if (window.GetHandle() == 0) { this.EndOffscreenFrame(); return; }
        int perfT0 = 0;
        if (App.PerfOn()) { perfT0 = Window.RawTickMs(); }
        this.TraceFullPresent(23, true);
        this.RenderFrameOverlays();
        this.TraceFullPresent(23, false);
        if (!this.ContinuePreparedFrame()) {
            this.TraceFullPresent(22, true);
            return;
        }
        this.TraceFullPresent(24, true);
        NativeLayer.Flush(this);
        this.TraceFullPresent(24, false);
        if (formPaintFrame) {
            this.SyncNativeDpi();
            if (!this.FormPaintGeometryCurrent() || forceFullNext
                || window.ClientWidth() != canvas.Width() || window.ClientHeight() != canvas.Height()) {
                this.AbortPreparationFrame();
                return;
            }
        }
        if (!this.ContinuePreparedFrame()) {
            this.TraceFullPresent(22, true);
            return;
        }
        this.TraceFullPresent(25, true);
        int perfT1 = 0;
        if (App.PerfOn()) { perfT1 = Window.RawTickMs(); }
        if (this.FxActive()) {
            Canvas fc = canvas;
            int fxNow = Window.GetTickMs();
            if (partialFrame) {
                if (fxSnapValid) {
                    fc.SnapshotPatchRect(presentX, presentY, presentW,
                                         presentH, App.FxSnapSlot());
                }
                this.PaintBackdropFx(fxFrameMs);
                BackdropFx.TakeDamage();
                if (!fxPagePending) {
                    fxDamage = null;
                    fxTouched = null;
                    fxTouchedFull = false;
                    if (fxNextMs < 0 || fxNow >= fxNextMs) { fxNextMs = fxNow; }
                }
            } else {
            bool burst = lastFullFrameMs > 0
                && fxNow - lastFullFrameMs < 120;
            if (burst) {
                fxSnapValid = false;
                fxDamage = null;
                fxTouched = null;
                fxTouchedFull = false;
                this.ScheduleFxFrame();
            } else {
                fc.SnapshotRect(0, 0, fc.Width(), fc.Height(),
                                App.FxSnapSlot());
                fxSnapValid = true;
                if (frameDiagnostics != null) { frameDiagnostics.Snapshot(); }
            }
            this.PaintBackdropFx(fxNow);
            if (!burst) {
                fxDamage = BackdropFx.TakeDamage();
                fxTouched = fxDamage;
                fxTouchedFull = fxDamage.Count / 4 > 1024;
                this.ScheduleFxFrame();
            } else {
                BackdropFx.TakeDamage();
            }
            fxFrameMs = fxNow;
            if (!window.IsVisible()) { fxNextMs = -1; }
            }
        } else {
            fxNextMs = -1;
        }
        int perfPreMs = 0;
        if (App.PerfOn()) {
            perfPreMs = Window.RawTickMs();
            perfOverlayMs = perfOverlayMs + (perfT1 - perfT0);
            perfFxMs = perfFxMs + (perfPreMs - perfT1);
        }
        this.TraceFullPresent(25, false);
        this.TraceFullPresent(26, true);
        int blurMiss = Canvas.TakeBlurPartialMiss();
        if (partialFrame) {
            canvas.PopClip();
            if (blurMiss > 0) {
                blurMissStreak = blurMissStreak + 1;
                if (!this.WidenDamageToGlass() || blurMissStreak >= 2) {
                    partialBlocked = true;
                    forceFullNext = true;
                    blurMissStreak = 0;
                    this.NoteRedrawWhy("glass-partial-blur");
                } else {
                    this.NoteRedrawWhy("glass-strip-widen");
                }
                needsRedraw = true;
            } else {
                blurMissStreak = 0;
            }
            if (frameDiagnostics != null) {
                frameDiagnostics.Partial(presentX, presentY, presentW, presentH, blurMiss);
            }
            window.PresentDirty(presentX, presentY, presentW, presentH);
        } else {
            window.PresentFull();
            #if !WINDOWS
            if (fxPagePending) { window.PresentDirty(0, 0, canvas.Width(), canvas.Height()); }
            #endif
            lastFullFrameMs = Window.GetTickMs();
        }
        this.SettleGlassRefresh();
        this.TraceFullPresent(26, false);
        if (!this.ContinuePreparedFrame()) {
            this.TraceFullPresent(22, false);
            return;
        }
        if (window.DpiRevision() != frameDpiRevision) {
            this.SyncNativeDpi();
            this.AbortPreparationFrame();
            return;
        }
        this.SealFormRegion();
        this.TraceFullPresent(27, true);
        window.PresentSurface(canvas.surfaceId, partialFrame ? -1 : frameDpiRevision);
        this.TraceFullPresent(27, false);
        this.TraceFullPresent(28, true);
        if (fxPagePending) {
            fxPagePending = false;
            if (partialFrame && this.FxActive() && window.IsVisible()) { this.ScheduleFxFrame(); }
        }
        this.TraceFullPresent(28, false);
        this.TraceFullPresent(21, false);
        this.AutomationPresented();
        if (App.PerfOn()) {
            int endMs = Window.RawTickMs();
            this.RecordFramePerf(perfBeginMs, perfPreMs, endMs, partialFrame);
        }
        frameCount = frameCount + 1;
        lastPresentMs = Window.GetTickMs();
        focus.UpdateImeSession();
        this.RefreshScrollHover();
        if (!isChildWindow && window != null && window.GetHandle() != 0) { ChildWindows.FoldDeadlines(this); }
    }
    Widget.TooltipRequest offscreenTooltip;
    App offscreenFrameParent;
    bool offscreenFrameActive;
    void BeginFrame() {
        this.CheckPreparationFrameEntry();
        this.ResetFormRegion();
        displayAnimationPending = false;
        if (window.GetHandle() == 0) { this.BeginOffscreenFrame(); return; }
        frameCadence.SetRate(window.RefreshRate());
        frameCadence.Begin(Stopwatch.GetMicroseconds());
        this.SyncNativeDpi();
        frameDpiRevision = nativeDpiRevision;
        if (window.DpiFramePending()) { forceFullNext = true; }
        if (App.PerfOn()) { perfBeginMs = Window.RawTickMs(); }
        if (App.PerfOn()) { Canvas.TextStatEnable(true); }
        this.SyncSkin();
        if (freezeAnimClock) {
            lastFrameMs = nowMs;
        } else {
            lastFrameMs = nowMs;
            nowMs = Window.GetTickMs();
        }
        if (App.PerfOn()) {
            if (redrawWhy == "") {
                if (needsRedraw) { redrawWhy = "silent"; }
                else { redrawWhy = "unrequested"; }
            }
            if (frameWhy != "" && redrawWhy == "") {
                frameWhy = "rebegin:" + frameWhy;
            } else {
                frameWhy = redrawWhy;
                frameWhyN = redrawCount;
            }
            redrawWhy = "";
            redrawCount = 0;
        }
        needsRedraw = false;
        animNextMs = -1;
        animRequestCount = 0;
        paintAnimRequestCount = 0;
        wakeNextMs = -1;
        wakeFrameNextMs = -1;
        this.TickRoutedLongPress();
        animRectValid = false;
        animRectAll = false;
        blurSlotSeq = 0;
        inputBlockPrevious = blocksInputBelow;
        blocksInputBelow = false;
        frameSeq = frameSeq + 1;
        clickClaimed = false;
        glassRects.Clear();
        window.ClearHitGuards();
        focus.ResetIds();
        overlays.Clear();
        nativeLayers.Clear();
        nativeOccluders.Clear();
        hitOnlyBlockers.Clear();
        partialFrame = false;
        partialBlocked = false;
        glassDeferred = false;
        Canvas.paintHashOn = this.PartialFrames();
        if (inputNeedsFrame) { partialPending = false; }
        this.CheckFormPaintClip();
        if (partialPending && dmgW > 0 && dmgH > 0) { partialFrame = true; }
        partialPending = false;
        if (forceFullNext) {
            partialFrame = false;
            forceFullNext = false;
            this.NoteRedrawWhy("force-full");
        }
        inputNeedsFrame = false;
        wheelScrollInput = false;
        if (!partialFrame) { animPrevValid = false; }
        if (!partialFrame) { fxSnapValid = false; }
        if (partialFrame) {
            canvas.PushClip(dmgX, dmgY, dmgW, dmgH);
            presentX = dmgX;
            presentY = dmgY;
            presentW = dmgW;
            presentH = dmgH;
        }
        if (shapeMode != 0) {
            int resizeBg = 0;
            if (resizeBg != lastResizeBg) {
                lastResizeBg = resizeBg;
                Window.SetResizeBackground(resizeBg);
            }
            if (partialFrame) {
                canvas.ClearRect(dmgX, dmgY, dmgW, dmgH, 0);
            } else {
                canvas.Clear(0);
            }
        } else {
            StyleBox bgStyle = Style.Full(this, "windowbg", "", "",
                                          Style.SNormal());
            int resizeBg = bgStyle.BgOr(0);
            if (resizeBg != lastResizeBg) {
                lastResizeBg = resizeBg;
                Window.SetResizeBackground(resizeBg);
            }
            if (glassNative) {
                StyleBox glassStyle = Style.Part(this, "windowbg", "glass", "",
                                                 "", "", Style.SNormal());
                if (partialFrame) {
                    canvas.ClearRect(dmgX, dmgY, dmgW, dmgH,
                                     glassStyle.BgOr(0));
                } else {
                    canvas.Clear(glassStyle.BgOr(0));
                }
            } else {
                if (partialFrame) {
                    canvas.ClearRect(dmgX, dmgY, dmgW, dmgH, bgStyle.BgOr(0));
                } else {
                    canvas.Clear(bgStyle.BgOr(0));
                }
            }
        }
    }
    void AddOverlay(OverlayPopup p) {
        overlays.Add(p);
        if (partialFrame) {
            this.NoteRedrawWhy("overlay-in-partial");
            needsRedraw = true;
        }
    }
    private Control retainedLayerWindows;
    private Control retainedLayerQueue;
    public void SetRetainedLayerRoots(Control windows, Control queue) {
        retainedLayerWindows = windows;
        retainedLayerQueue = queue;
    }
    void RunOverlays() {
        if (!this.ContinuePreparedFrame()) { return; }
        if (retainedLayerWindows != null) {
            retainedLayerWindows.RenderTree(this);
            if (!this.ContinuePreparedFrame()) { return; }
        }
        if (retainedLayerQueue != null) { retainedLayerQueue.RenderTree(this); }
        if (!this.ContinuePreparedFrame()) { return; }
        for (int i = 0; i < overlays.Count; i = i + 1) {
            if (!this.ContinuePreparedFrame()) { return; }
            OverlayPopup p = overlays[i];
            focus.PushId("App.Overlay");
            focus.PushId(i);
            try { p.PaintOverlay(this); }
            finally {
                focus.PopId();
                focus.PopId();
            }
            if (!this.ContinuePreparedFrame()) { return; }
        }
        if (!this.ContinuePreparedFrame()) { return; }
        if (this.overlayHost != null) {
            this.overlayHost.RenderAll(this);
            if (!this.ContinuePreparedFrame()) { return; }
        }
    }
    bool HasOverlays() { return overlays.Count > 0 || (overlayHost != null && overlayHost.HasActive()); }
    bool PointerCaptured() {
        if (blocksInputBelow || inputBlockPrevious) { return true; }
        return overlayHost != null && overlayHost.HasActive();
    }
    public int OccludeHitsBelow() {
        bool firstBlock = !blocksInputBelow;
        blocksInputBelow = true;
        int id = focus.AllocId();
        hitOnlyBlockers.Add(id);
        if (firstBlock && !inputBlockPrevious && snapshotInputSilenceDepth == 0) {
            focus.SetFocused(id);
            clickClaimed = true;
        }
        return id;
    }
    int NormalizedKind() {
        int k = window.EventKind();
        if (k == 13 && this.DoesPressOwnWheel()) { return 1; }
        return k;
    }
    bool DoesPressOwnWheel() {
        if (focus.pressedId < 0) { return false; }
        if (!this.TouchDevice()) { return true; }
        if (this.dragClaimId == focus.pressedId) { return true; }
        int wt = hitTester.GetWidgetType(focus.pressedId);
        return wt == 1 || (wt >= 4 && wt <= 8);
    }
    bool keyClaimed;
    long keyClaimSeq;
    internal void MarkKeyHandled() {
        this.keyClaimed = true;
        this.keyClaimSeq = this.window.EventSeq();
    }
    public bool IsKeyHandled() {
        return this.keyClaimed &&
            this.keyClaimSeq == this.window.EventSeq();
    }
    bool IsKeySequenceBlocked(int kind) { return (kind == 4 || kind == 5 || kind == 6) && this.IsKeyHandled(); }
    int EventKind() {
        if (snapshotInputSilenceDepth > 0) { return 0; }
        if (window.GetHandle() == 0) {
            int kind0 = this.NormalizedKind();
            return this.IsKeySequenceBlocked(kind0) ? 0 : kind0;
        }
        nint evh = Window.EventHwnd();
        if (evh != window.GetHandle()) { return 0; }
        int kind = this.NormalizedKind();
        /* 已被控件消费掉的键盘事件不再重复投递（见 MarkKeyHandled）。 */
        return this.IsKeySequenceBlocked(kind) ? 0 : kind;
    }
    bool EventIsMine() { return window.GetHandle() == 0 || Window.EventHwnd() == window.GetHandle(); }
    bool ClickFrameCurrent() {
        if (routedWindowSequenceValid && routedWindowSequence == window.EventSeq()
                && routedWindowHandled) { return false; }
        if (this.clickSeenSeq < 0) { this.clickSeenSeq = this.frameSeq; }
        return this.clickSeenSeq == this.frameSeq;
    }
    int FrameSeq() { return frameSeq; }
    internal bool CanDismissOverlayOnClick() {
        if (this.EventKind() != 3 || clickClaimed) { return false; }
        if (this.window.EventFlag() == 1) { return false; }
        if (this.longPressFired) { return false; }
        if (this.pressOnBlocker && !this.hitTester.BlockerAt(this.mouseX, this.mouseY)) { return false; }
        if (!this.ClickFrameCurrent()) { return false; }
        if (window.EventButton() != 0) { return false; }
        if (inputBlockPrevious && !blocksInputBelow) { return false; }
        if (hitTester.PrevBlockerAt(mouseX, mouseY)
            && !hitTester.BlockerAt(mouseX, mouseY)) { return false; }
        return true;
    }
    internal void MarkClickHandled() { clickClaimed = true; }
    public bool IsDoubleClickNow() { return doubleClickNow; }
    long clickSnapshotSequence;
    bool clickSnapshotSequenceValid;
    bool clickHistorySuppressed;
    void NoteClickAt(int id, int x, int y) {
        if (id < 0 || window.EventButton() != 0 || clickHistorySuppressed || this.HasLongPressFired()) { return; }
        long sequence = window.EventSeq();
        if (clickSnapshotSequenceValid && clickSnapshotSequence == sequence) { return; }
        clickSnapshotSequence = sequence; clickSnapshotSequenceValid = true;
        int t = Window.GetTickMs();
        int dx = x - lastClickX; if (dx < 0) { dx = 0 - dx; }
        int dy = y - lastClickY; if (dy < 0) { dy = 0 - dy; }
        if (id >= 0 && id == lastClickId && (t - lastClickMs) <= 400 && dx <= 6 && dy <= 6) {
            doubleClickNow = true;
        } else {
            doubleClickNow = false;
        }
        lastClickId = id;
        lastClickMs = t;
        lastClickX = x;
        lastClickY = y;
    }
    void NotePressStart(int id, int x, int y) {
        long sequence = window.EventSeq();
        if (pressSnapshotSequenceValid && pressSnapshotSequence == sequence) { return; }
        pressSnapshotSequenceValid = true;
        pressSnapshotSequence = sequence;
        clickHistorySuppressed = false;
        pointerGestureTicket = pointerGestureTicket + 1;
        retainedLongPressOwner = null;
        retainedLongPressRoot = null;
        retainedLongPressTicket = 0;
        retainedLongPressReserved = false;
        pressStartId = id;
        pressStartX = x;
        pressStartY = y;
        pressStartMs = Window.GetTickMs();
        longPressFired = false;
        dragClaimId = 0 - 1;
    }
    void NotePressSentinel(int id) {
        if (longPressFired || this.RetainedLongPressOwnsGesture()) { return; }
        pressStartId = id;
    }
    bool TouchDevice() {
        #if ANDROID || OHOS || IOS
        return true;
        #else
        return false;
        #endif
    }
    bool PollLongPress(int id) {
        if (this.RetainedLongPressOwnsGesture()) { return false; }
        if (longPressFired) { return false; }
        if (id < 0) {
            if (!pointerDown) { return false; }
        } else if (focus.pressedId != id) { return false; }
        if (pressStartId != id) { return false; }
        return this.ClaimLongPress();
    }
    bool ClaimLongPress() {
        if (longPressFired) { return false; }
        int mdx = mouseX - pressStartX; if (mdx < 0) { mdx = -mdx; }
        int mdy = mouseY - pressStartY; if (mdy < 0) { mdy = -mdy; }
        if (mdx > 12 || mdy > 12) { longPressFired = true; return false; }
        int t = Window.GetTickMs();
        if ((t - pressStartMs) >= 500) {
            longPressFired = true;
            RequestRedraw();
            return true;
        }
        RequestWakeFrameIn(80);
        return false;
    }
    bool HasLongPressFired() { return longPressFired; }
    int CurrentPressHeldMs() { return Window.GetTickMs() - pressStartMs; }
    public int StyleHoverLevelIn(int id, int ms, int x, int y, int w, int h) {
        int target = focus != null && focus.IsHovered(id) ? 1000 : 0;
        if (ms <= 0) { ms = 120; }
        return this.AnimToIn(IdHash.HashInt(id, 301), target, ms, x, y, w, h);
    }
    int StylePressLevelIn(int id, int ms, int x, int y, int w, int h) {
        int target = focus != null && focus.IsPressed(id) && focus.IsHovered(id) ? 1000 : 0;
        if (ms <= 0) { ms = 80; }
        return this.AnimToIn(IdHash.HashInt(id, 302), target, ms, x, y, w, h);
    }
    int StyleFocusLevelIn(int id, int ms, int x, int y, int w, int h) {
        int target = focus != null && focus.IsFocused(id) ? 1000 : 0;
        if (ms <= 0) { ms = 140; }
        return this.AnimToIn(IdHash.HashInt(id, 303), target, ms, x, y, w, h);
    }
    bool HoldTip(Control control) {
        if (control == null || !this.TouchDevice() || focus == null) { return false; }
        Control pressed = capturedPointerControl != null ? capturedPointerControl : pointerDownTarget;
        if (pressed != control || !focus.IsPressed(control.WidgetId())) { return false; }
        if (mouseX < control.bx || mouseX >= control.bx + control.bw
            || mouseY < control.by || mouseY >= control.by + control.bh) { return false; }
        if (this.CurrentPressHeldMs() >= 900) { return true; }
        this.RequestWakeFrameIn(80);
        return false;
    }
}
