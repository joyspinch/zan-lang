using System;
using System.Collections.Generic;
namespace Gui;
public partial class App : StyleHost {
    public int HostDpiScale() { return dpiScale; }
    public int HostMetricsScale() { return metricsScale; }
    public int HostBgThemeGen() { return bgThemeGen; }
    public void HostBumpBgThemeGen() {
        bgThemeGen = bgThemeGen + 1;
        needsRedraw = true;
    }
    public Theme HostTheme() { return theme; }
    public StyleSheet HostSheet() { return sheet; }
    public void HostSetSheet(StyleSheet s) { sheet = s; }
    public bool HostIsolateAppSheet() { return isolateAppSheet; }
    public StyleSheet HostChartSheet() { return chartSheet; }
    public Dict<string, StyleBox> HostStyleCache() { return styleCache; }
    public int HostStyleCacheGen() { return styleCacheGen; }
    public void HostSetStyleCache(Dict<string, StyleBox> cache, int gen) {
        styleCache = cache;
        styleCacheGen = gen;
    }
    public Dict<int, StyleSheet> HostBaseSheets() { return baseSheets; }
    public int HostBaseSheetGen() { return baseSheetGen; }
    public void HostSetBaseSheets(Dict<int, StyleSheet> sheets, int gen) {
        baseSheets = sheets;
        baseSheetGen = gen;
    }
    public StyleNode HostStyleCtx() { return styleCtx; }
    public bool HostIsDark() { return isDark; }
    public bool HostReducedMotion() { return reducedMotion; }
    public void HostSetSkinName(string name) { skinName = name; }
    public bool HostSkinArtWallpaper() { return this.SkinArtWallpaper(); }
    public bool HostHasUserWallpaper() { return this.HasUserWallpaper(); }
    public void HostSetSkinArt(string art, int opacity) {
        skinArt = art;
        skinArtOpacity = opacity;
    }
    public void HostSetWallpaper(string path, int opacity) { this.SetWallpaper(path, opacity); }
    public void HostClearWallpaper() { this.ClearWallpaper(); }
    public void HostNoteGlassRect(int x, int y, int w, int h) { this.NoteGlassRect(x, y, w, h); }
    public int HostBlurKeyId(int id) { return this.BlurKeyId(id); }
    public int HostBlurKey(int kind, int x, int y, int w, int h) { return this.BlurKey(kind, x, y, w, h); }
    public int HostBlurSlotFor(int key) { return this.BlurSlotFor(key); }
    public bool HostBackdropDirtyIn(int slot, int x, int y, int w, int h) {
        return this.BackdropDirtyIn(slot, x, y, w, h);
    }
}
