using System;
using System.Collections.Generic;
using Gui.Backend;
namespace Gui;
public partial class App {
    List<AnimSlot> anims;
    bool freezeAnimClock;
    int animNextMs;
    int animRequestCount;
    private int paintAnimRequestCount;
    bool animRectValid;
    bool animRectAll;
    int animRX;
    int animRY;
    int animRW;
    int animRH;
    bool animPrevValid;
    int animPX;
    int animPY;
    int animPW;
    int animPH;
    void InitAnimation() {
        this.anims = new List<AnimSlot>();
        this.freezeAnimClock = false;
        this.animNextMs = -1;
        this.animRectValid = false;
        this.animRectAll = false;
        this.animRX = 0;
        this.animRY = 0;
        this.animRW = 0;
        this.animRH = 0;
        this.animPrevValid = false;
        this.animPX = 0;
        this.animPY = 0;
        this.animPW = 0;
        this.animPH = 0;
        this.displayAnimationPending = false;
    }
    public void RequestAnimationFrame() { this.RequestFullAnimationFrameAt(this.DisplayFrameDueMs()); }
    public void RequestAnimationFrameIn(int x, int y, int w, int h) {
        this.RequestAnimationFrameAt(this.DisplayFrameDueMs(), x, y, w, h);
    }
    public void RequestAnimationFrame(int minIntervalMs) {
        this.RequestFullAnimationFrameAt(Window.GetTickMs() + minIntervalMs);
    }
    private void RequestFullAnimationFrameAt(int dueMs) {
        animRequestCount = animRequestCount + 1;
        if (animNextMs < 0 || dueMs < animNextMs) { animNextMs = dueMs; }
        animRectAll = true;
    }
    void RequestAnimationFrameIn(int minIntervalMs, int x, int y, int w, int h) {
        this.RequestAnimationFrameAt(Window.GetTickMs() + minIntervalMs, x, y, w, h);
    }
    void RequestAnimationFrameAt(int dueMs, int x, int y, int w, int h, bool paintOnly = false) {
        if (paintOnly) { paintAnimRequestCount = paintAnimRequestCount + 1; }
        animRequestCount = animRequestCount + 1;
        if (animNextMs < 0 || dueMs < animNextMs) { animNextMs = dueMs; }
        if (canvas == null || w <= 0 || h <= 0) { animRectAll = true; return; }
        int pad = this.Scale(6);
        int x0 = x - pad;
        int y0 = y - pad;
        int x1 = x + w + pad;
        int y1 = y + h + pad;
        if (x1 <= 0 || y1 <= 0 || x0 >= canvas.Width() || y0 >= canvas.Height()) {
            x0 = 0;
            y0 = 0;
            x1 = 1;
            y1 = 1;
        }
        if (animRectValid) {
            if (animRX < x0) { x0 = animRX; }
            if (animRY < y0) { y0 = animRY; }
            if (animRX + animRW > x1) { x1 = animRX + animRW; }
            if (animRY + animRH > y1) { y1 = animRY + animRH; }
        }
        if (x0 < 0) { x0 = 0; }
        if (y0 < 0) { y0 = 0; }
        if (x1 > canvas.Width()) { x1 = canvas.Width(); }
        if (y1 > canvas.Height()) { y1 = canvas.Height(); }
        if (x1 - x0 <= 0 || y1 - y0 <= 0) { animRectAll = true; return; }
        animRX = x0;
        animRY = y0;
        animRW = x1 - x0;
        animRH = y1 - y0;
        animRectValid = true;
    }
    int AnimIndex(int key) {
        for (int i = 0; i < anims.Count; i = i + 1) {
            if (anims[i].key == key) { return i; }
        }
        return -1;
    }
    void AnimAdd(int key, int val, int target, int durMs) {
        anims.Add(new AnimSlot(key, val, target, val, nowMs, durMs));
    }
    int StateGet(int key, int dflt) {
        int idx = AnimIndex(key);
        if (idx < 0) { return dflt; }
        return anims[idx].cur;
    }
    void StateSet(int key, int val) {
        int idx = AnimIndex(key);
        if (idx < 0) { AnimAdd(key, val, val, 1); return; }
        AnimSlot a = anims[idx];
        a.cur = val;
        a.dst = val;
        a.src = val;
    }
    int AnimToValue(int key, int target, int durMs) {
        bool active;
        return this.AnimToCore(key, target, durMs, out active);
    }
    private int AnimToCore(int key, int target, int durMs, out bool active) {
        int idx = AnimIndex(key);
        if (idx < 0) {
            AnimAdd(key, target, target, durMs);
            active = false;
            return target;
        }
        AnimSlot a = anims[idx];
        if (a.dst != target) {
            a.src = a.cur;
            a.dst = target;
            a.startMs = nowMs;
            a.dur = durMs;
        }
        int val = this.EvalAnimationSlot(a);
        active = a.cur != a.dst;
        return val;
    }
    private int EvalAnimationSlot(AnimSlot a) {
        int from = a.src;
        int tgt = a.dst;
        if (from == tgt) { a.cur = tgt; return tgt; }
        int dur = a.dur;
        if (dur < 1) { dur = 1; }
        int elapsed = nowMs - a.startMs;
        if (elapsed < 0) { elapsed = 0; }
        long pLong = (long)elapsed * 1000 / (long)dur;
        int p = pLong > 1000 ? 1000 : (int)pLong;
        int e = App.Ease(p);
        int val = from + (int)(((long)tgt - (long)from) * (long)e / 1000);
        a.cur = p >= 1000 ? tgt : val;
        return a.cur;
    }
    bool AnimActive(int key) {
        int idx = AnimIndex(key);
        if (idx < 0) { return false; }
        return anims[idx].cur != anims[idx].dst;
    }
    void AnimRestart(int key, int durMs) {
        int idx = AnimIndex(key);
        if (durMs < 1) { durMs = 1; }
        if (idx < 0) {
            this.anims.Add(new AnimSlot(key, 0, 1000, 0, this.nowMs, durMs));
            return;
        }
        AnimSlot a = this.anims[idx];
        a.src = 0;
        a.cur = 0;
        a.dst = 1000;
        a.startMs = this.nowMs;
        a.dur = durMs;
    }
    public int AnimTo(int key, int target, int durMs) {
        bool active;
        int value = this.AnimToCore(key, target, durMs, out active);
        if (active) {
            this.Stats.NoteRedrawWhy("anim");
            needsRedraw = true;
        }
        return value;
    }
    public int AnimToIn(int key, int target, int durMs,
                 int x, int y, int w, int h) {
        bool active;
        int value = this.AnimToCore(key, target, durMs, out active);
        if (active) { this.RequestAnimationFrameIn(0, x, y, w, h); }
        return value;
    }
    private weak Control surfaceHoverHit;
    private weak Control surfacePressHit;
    private weak Control surfaceHoverOwner;
    private weak Control surfacePressOwner;
    private int surfaceEndpointFrame = -1;
    private bool surfaceHasHoverOrPress;
    private static Control SurfaceEndpoint(Control hit) {
        int depth = 0;
        while (hit != null && hit.InputFocusCapabilities() == 0 && depth < 256) {
            hit = hit.parent;
            depth = depth + 1;
        }
        return hit;
    }
    internal int RetainedSurfaceState(Control owner) {
        if (owner == null) { return 0; }
        Control hover = lastHoveredControl;
        Control press = capturedPointerControl != null ? capturedPointerControl : pointerDownTarget;
        if (surfaceEndpointFrame != frameSeq || surfaceHoverHit != hover || surfacePressHit != press) {
            surfaceEndpointFrame = frameSeq;
            surfaceHoverHit = hover;
            surfacePressHit = press;
            surfaceHasHoverOrPress = hover != null || press != null;
            surfaceHoverOwner = hover != null ? App.SurfaceEndpoint(hover) : null;
            surfacePressOwner = press != null ? App.SurfaceEndpoint(press) : null;
        }
        if (owner.IsDisabled()) { return Style.SDisabled(); }
        if (!surfaceHasHoverOrPress && (focus == null || focus.focusedId <= 0)) { return 0; }
        int state = focus != null && focus.focusedId > 0 && focus.IsFocused(owner.WidgetId())
            ? Style.SFocus() : 0;
        if (surfaceHasHoverOrPress && (surfaceHoverOwner == owner || hover == owner)
            && owner.ContainsPoint(mouseX, mouseY, currentPointerType)) {
            state = state | Style.SHover();
            if (surfacePressOwner == owner || press == owner) { state = state | Style.SActive(); }
        }
        return state;
    }
    public int AnimIntroValue(int key, int durMs) {
        bool active;
        return this.AnimIntroCore(key, durMs, out active);
    }
    private int AnimIntroCore(int key, int durMs, out bool active) {
        int idx = AnimIndex(key);
        if (idx < 0) {
            anims.Add(new AnimSlot(key, 0, 1000, 0, nowMs, durMs));
            active = true;
            return 0;
        }
        AnimSlot a = anims[idx];
        int val = this.EvalAnimationSlot(a);
        active = a.cur != a.dst;
        return val;
    }
    public int AnimIntro(int key, int durMs) {
        bool active;
        int value = this.AnimIntroCore(key, durMs, out active);
        if (active) {
            this.Stats.NoteRedrawWhy("anim-intro");
            needsRedraw = true;
        }
        return value;
    }
    public int AnimIntroIn(int key, int durMs, int x, int y, int w, int h) {
        bool active;
        int value = this.AnimIntroCore(key, durMs, out active);
        if (active) { this.RequestAnimationFrameIn(x, y, w, h); }
        return value;
    }
    int AnimPxValue(int key, int target, int tauMs) {
        bool active;
        return this.AnimPxCore(key, target, tauMs, out active);
    }
    private int AnimPxCore(int key, int target, int tauMs, out bool active) {
        int idx = AnimIndex(key);
        if (idx < 0) {
            AnimAdd(key, target, target, tauMs);
            active = false;
            return target;
        }
        AnimSlot a = anims[idx];
        a.dst = target;
        int cur = a.cur;
        if (cur == target) { active = false; return cur; }
        int dt = nowMs - lastFrameMs;
        if (dt < 1) { dt = 1; }
        if (dt > 64) { dt = 64; }
        if (tauMs < 1) { tauMs = 1; }
        int f = (int)((long)dt * 1000 / ((long)dt + (long)tauMs));
        int delta = (int)(((long)target - (long)cur) * (long)f / 1000);
        if (delta == 0) {
            if (target > cur) { delta = 1; } else { delta = -1; }
        }
        int next = cur + delta;
        if (delta > 0 && next > target) { next = target; }
        if (delta < 0 && next < target) { next = target; }
        a.cur = next;
        active = next != target;
        return next;
    }
    int AnimPx(int key, int target, int tauMs) {
        bool active;
        int value = this.AnimPxCore(key, target, tauMs, out active);
        if (active) {
            this.Stats.NoteRedrawWhy("anim-step");
            needsRedraw = true;
        }
        return value;
    }
    int AnimPxIn(int key, int target, int tauMs,
                 int x, int y, int w, int h) {
        bool active;
        int value = this.AnimPxCore(key, target, tauMs, out active);
        if (active) { this.RequestAnimationFrameIn(0, x, y, w, h); }
        return value;
    }
    static int Ease(int p) { return Fx.Ease(p); }
    void FreezeAnimClock(int fixedMs) {
        Window.FreezeTick(fixedMs);
        nowMs = Window.GetTickMs();
        freezeAnimClock = true;
        lastFrameMs = nowMs;
        lastPresentMs = nowMs;
        animNextMs = -1;
        wakeNextMs = -1;
        wakeFrameNextMs = -1;
        fxNextMs = -1;
    }
    void UnfreezeAnimClock() {
        Window.UnfreezeTick();
        freezeAnimClock = false;
        nowMs = Window.GetTickMs();
        lastFrameMs = nowMs;
    }
}
