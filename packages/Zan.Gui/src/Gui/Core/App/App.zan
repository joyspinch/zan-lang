    public static App CreateDark(string title, int width, int height) {
        App app = new App(title, width, height);
        app.theme = Theme.Dark();
        app.isDark = true;
        app.EnableSkins(1);
        #if ANDROID || OHOS || IOS
        app.SetChromeVisible(false);
        #endif
        return app;
    }
    public static App CreateDarkStage(string title, int width, int height) {
        App app = new App(title, width, height, true);
        app.theme = Theme.Dark();
        app.isDark = true;
        app.EnableSkins(1);
        app.showThemeButton = false;
        app.SetBackdropFx(false);
        #if ANDROID || OHOS || IOS
        app.SetChromeVisible(false);
        #endif
        return app;
    }
    static int ResolveDefaultRenderBackend(bool offscreen) {
        string env = Environment.GetEnvironmentVariable("ZAN_GUI_BACKEND");
        if (env != null && env != "") {
            string lower = env.ToLower();
            if (lower == "cpu" || lower == "0") { return RenderBackend.Cpu(); }
            if (lower == "gpu" || lower == "1") { return RenderBackend.Gpu(); }
            if (lower == "auto" || lower == "2") { return RenderBackend.Auto(); }
        }
        return offscreen ? RenderBackend.Cpu() : RenderBackend.Auto();
    }
