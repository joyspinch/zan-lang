using System;
using Gui.Backend;

namespace Gui;

// 窗口背景绘制服务（App.Backdrop）：皮肤壁纸（渐变 + 柔和色斑 / 玻璃彩斑）、
// 用户壁纸图淡入、异形窗口的投影与底色铺满，以及按槽缓存的背景快照。
// 从 App 拆出（B-ID174）；App 只留 RenderBackground 门面。
public class BackdropPainter {
    private weak App app;

    public BackdropPainter(App owner) {
        app = owner;
    }

    // 将壁纸快速拷贝到 [x,y,w,h]，居中裁剪覆盖，使图片
    // 保持宽高比，然后淡入到下方皮肤背景中。
    public void RenderWallpaperImage(int x, int y, int w, int h) {
        App host = app;
        if (host == null || host.canvas == null || host.bgImagePath == null || host.bgImagePath == "") { return; }
        int iw = Canvas.ImageWidth(host.bgImagePath);
        int ih = Canvas.ImageHeight(host.bgImagePath);
        if (iw <= 0 || ih <= 0) { return; }
        // 目标尺寸为零会在下面的覆盖比例中除零。
        if (w <= 0 || h <= 0) { return; }
        // 覆盖：与目标宽高比一致的最大居中源矩形。
        int sw = iw;
        int sh = ih;
        if ((long)iw * (long)h > (long)w * (long)ih) {
            sw = (int)((long)w * (long)ih / (long)h);
        } else {
            sh = (int)((long)h * (long)iw / (long)w);
        }
        if (sw < 1) { sw = 1; }
        if (sh < 1) { sh = 1; }
        host.canvas.BlitImage(host.bgImagePath, x, y, w, h,
                         (iw - sw) / 2, (ih - sh) / 2, sw, sh);
        // 向皮肤背景淡出：以页面色绘制遮罩，强度为
        // 所请求不透明度的补值。皮肤自身的美术
        // 本就是为背景设计的——它以全强度呈现，由
        // 半透明表面完成混合——因此只有用户选择的
        // 壁纸才加遮罩。
        int fade = 100 - host.WallpaperOpacity();
        if (fade > 0 && !host.SkinArtWallpaper()) {
            StyleBox fadeStyle = Style.Part(host, "windowbg", "fade", "",
                                            "", "", Style.SNormal());
            int fadeBg = fadeStyle.BgOr(0);
            int rgb = fadeBg % 16777216;
            if (rgb < 0) { rgb = rgb + 16777216; }
            host.canvas.FillRect(x, y, w, h, (fade * 255 / 100) * 16777216 + rgb);
        }
    }

    // ---- 主题化窗口背景（内置，所有窗口共用） ---------
    // 让渐变/玻璃/霓虹皮肤显得真实的壁纸：
    // 垂直渐变加上磨砂面板模糊掉的柔和色斑。
    // 它位于框架中，使 IDE、画廊与任何窗口渲染出相同的
    // 皮肤——应用只需在内容后面调用 RenderBackground。

    // 单个柔和壁纸光晕：平滑径向渐隐到明亮的中心（无
    // 生硬边缘），为背景模糊提供可柔化的真实色彩。
    public void BackdropBlobAlpha(int cx, int cy, int r, int cr, int cg, int cb, int alpha) {
        App host = app;
        if (host == null || host.canvas == null) { return; }
        host.canvas.FillRadial(cx, cy, r, Theme.Rgb(cr, cg, cb), alpha);
    }

    public void BackdropBlob(int cx, int cy, int r, int cr, int cg, int cb) {
        this.BackdropBlobAlpha(cx, cy, r, cr, cg, cb, 150);
    }

    // 由打包 ARGB 主题强调色着色的柔和光晕（位运算拆包，避免有符号 ARGB 负数除法）。
    public void BackdropDriftAlpha(int cx, int cy, int r, int color, int alpha) {
        int cr = (color >> 16) & 255;
        int cg = (color >> 8) & 255;
        int cb = color & 255;
        this.BackdropBlobAlpha(cx, cy, r, cr, cg, cb, alpha);
    }

    public void BackdropDrift(int cx, int cy, int r, int color) {
        this.BackdropDriftAlpha(cx, cy, r, color, 150);
    }

    // 在垂直渐变上叠加来自主题强调色的色斑
    // （非玻璃渐变预设），使渐变更像壁纸。
    public void BackdropGradientWallpaper(int ax, int ay, int aw, int ah) {
        App host = app;
        if (host == null) { return; }
        StyleBox primaryStyle = Style.Part(host, "windowbg", "blob", "",
                                            "", "", Style.SNormal());
        StyleBox infoStyle = Style.Part(host, "windowbg", "blob", "",
                                        "info", "", Style.SNormal());
        StyleBox successStyle = Style.Part(host, "windowbg", "blob", "",
                                           "success", "", Style.SNormal());
        StyleBox errorStyle = Style.Part(host, "windowbg", "blob", "",
                                         "error", "", Style.SNormal());
        int r = host.Scale(340);
        this.BackdropDriftAlpha(ax + aw * 18 / 100, ay + ah * 22 / 100, r,
                                primaryStyle.BgOr(0), 125);
        this.BackdropDriftAlpha(ax + aw * 76 / 100, ay + ah * 18 / 100, r,
                                infoStyle.BgOr(0), 115);
        this.BackdropDriftAlpha(ax + aw * 82 / 100, ay + ah * 74 / 100, r,
                                successStyle.BgOr(0), 110);
        this.BackdropDriftAlpha(ax + aw * 28 / 100, ay + ah * 84 / 100, r,
                                errorStyle.BgOr(0), 120);
    }

    // 为磨砂玻璃/液态玻璃预设准备的多彩折射壁纸：
    // 亮色液态玻璃（liquid）用高对比日光棱镜彩斑（蔚蓝/青碧/紫罗兰/珊瑚橙），让上层透明液态玻璃清晰折射；
    // 暗色玻璃（frosted / aurora / starlight）读取皮肤自身语义色斑，呈现琉璃/极光/星云专属折射色彩。
    public void BackdropGlassWallpaper(int ax, int ay, int aw, int ah) {
        App host = app;
        if (host == null) { return; }
        if (host.theme != null && host.theme.IsLightBg()) {
            this.BackdropBlobAlpha(ax + aw * 12 / 100, ay + ah * 18 / 100,
                host.Scale(360), 38, 132, 255, 205);
            this.BackdropBlobAlpha(ax + aw * 46 / 100, ay + ah * 20 / 100,
                host.Scale(340), 146, 98, 255, 185);
            this.BackdropBlobAlpha(ax + aw * 86 / 100, ay + ah * 22 / 100,
                host.Scale(360), 20, 206, 214, 195);
            this.BackdropBlobAlpha(ax + aw * 76 / 100, ay + ah * 78 / 100,
                host.Scale(370), 255, 114, 178, 185);
            this.BackdropBlobAlpha(ax + aw * 24 / 100, ay + ah * 82 / 100,
                host.Scale(360), 56, 178, 255, 195);
            this.BackdropBlobAlpha(ax + aw * 52 / 100, ay + ah * 56 / 100,
                host.Scale(320), 255, 188, 108, 165);
            return;
        }
        StyleBox primaryStyle = Style.Part(host, "windowbg", "blob", "", "", "", Style.SNormal());
        StyleBox infoStyle = Style.Part(host, "windowbg", "blob", "", "info", "", Style.SNormal());
        StyleBox successStyle = Style.Part(host, "windowbg", "blob", "", "success", "", Style.SNormal());
        StyleBox errorStyle = Style.Part(host, "windowbg", "blob", "", "error", "", Style.SNormal());
        int cPrimary = primaryStyle.BgOr(Theme.Rgb(124, 196, 255));
        int cInfo = infoStyle.BgOr(Theme.Rgb(96, 156, 255));
        int cSuccess = successStyle.BgOr(Theme.Rgb(96, 222, 208));
        int cError = errorStyle.BgOr(Theme.Rgb(240, 112, 196));
        this.BackdropDriftAlpha(ax + aw * 16 / 100, ay + ah * 18 / 100, host.Scale(350), cPrimary, 175);
        this.BackdropDriftAlpha(ax + aw * 48 / 100, ay + ah * 30 / 100, host.Scale(330), cSuccess, 160);
        this.BackdropDriftAlpha(ax + aw * 82 / 100, ay + ah * 20 / 100, host.Scale(340), cInfo, 170);
        this.BackdropDriftAlpha(ax + aw * 70 / 100, ay + ah * 76 / 100, host.Scale(360), cError, 165);
        this.BackdropDriftAlpha(ax + aw * 26 / 100, ay + ah * 82 / 100, host.Scale(340), cPrimary, 155);
        this.BackdropDriftAlpha(ax + aw * 90 / 100, ay + ah * 62 / 100, host.Scale(300), cSuccess, 145);
    }

    // 与壁纸共用调用方的背景槽；只在完整帧捕获形状与阴影的透明基面。
    // 保存区域值而非列表身份，使原地改几何也能使缓存失效。
    WindowShapeDescription bgShapeSnapshot;
    Theme bgShapeTheme;
    string bgShapeSpec;
    int bgShapeWidth;
    int bgShapeHeight;
    int bgShapeDpi;
    int bgShapeMetrics;
    int bgShapeRadius;
    int bgShapeMode;
    int bgShapeSlot;
    int bgShapeGradient;
    int bgShapeGradTop;
    int bgShapeGradBottom;
    int bgShapeGlass;

    public bool ShapeBackgroundMatches(int width, int height, int slot) {
        App host = app;
        if (host == null || host.theme == null || bgShapeSnapshot == null || bgShapeTheme != host.theme
        || bgShapeWidth != width || bgShapeHeight != height
        || bgShapeDpi != host.dpiScale || bgShapeMetrics != host.metricsScale
        || bgShapeRadius != host.shapeRadius || bgShapeMode != host.shapeMode
        || bgShapeSlot != slot
        || bgShapeSpec != host.shapeSpec
        || bgShapeSnapshot.shadow != host.shapeShadow
        || bgShapeSnapshot.offsetX != host.shapeOffX
        || bgShapeSnapshot.offsetY != host.shapeOffY
        || bgShapeGradient != host.theme.gradient
        || bgShapeGradTop != host.theme.bgGradTop
        || bgShapeGradBottom != host.theme.bgGradBottom
        || bgShapeGlass != host.theme.glass) { return false; }
        int count = host.shapeRegions == null ? 0 : host.shapeRegions.Count;
        if (bgShapeSnapshot.regions.Count != count) { return false; }
        for (int i = 0; i < count; i = i + 1) {
            WindowShapeRegion a = bgShapeSnapshot.regions[i];
            WindowShapeRegion b = host.shapeRegions[i];
            if (a.kind != b.kind || a.x != b.x || a.y != b.y
            || a.width != b.width || a.height != b.height
            || a.radius != b.radius) { return false; }
        }
        return true;
    }

    public void RememberShapeBackground(int width, int height, int slot) {
        App host = app;
        if (host == null || host.theme == null) { return; }
        WindowShapeDescription snapshot = new WindowShapeDescription();
        snapshot.shadow = host.shapeShadow;
        snapshot.offsetX = host.shapeOffX;
        snapshot.offsetY = host.shapeOffY;
        if (host.shapeRegions != null) {
            for (int i = 0; i < host.shapeRegions.Count; i = i + 1) {
                snapshot.regions.Add(host.shapeRegions[i].Clone());
            }
        }
        bgShapeSnapshot = snapshot;
        bgShapeTheme = host.theme;
        bgShapeSpec = host.shapeSpec;
        bgShapeWidth = width;
        bgShapeHeight = height;
        bgShapeDpi = host.dpiScale;
        bgShapeMetrics = host.metricsScale;
        bgShapeRadius = host.shapeRadius;
        bgShapeMode = host.shapeMode;
        bgShapeSlot = slot;
        bgShapeGradient = host.theme.gradient;
        bgShapeGradTop = host.theme.bgGradTop;
        bgShapeGradBottom = host.theme.bgGradBottom;
        bgShapeGlass = host.theme.glass;
        host.bgSnapGen = host.bgThemeGen;
    }

    public void RenderBackground(int x, int y, int w, int h, int slot) {
        App host = app;
        if (host == null || host.canvas == null || host.theme == null) { return; }
        Canvas c = host.canvas;
        Theme t = host.theme;
        // 异形窗口：表面在 BeginFrame 里被清成 alpha 0，操作系统
        // 只负责按轮廓合成，轮廓内的像素仍要自己画——所以这里
        // 用皮肤底色铺满每个形状区域（先画投影，再铺底），
        // 设计里没有铺满窗口的背景控件时，窗口才不会整个透明。
        // 参数是内容区坐标（调用方按 ContentTop/ClientWidth 布局），
        // 这里忽略：轮廓与阴影带覆盖整幅表面，按画布坐标一次画完。
        if (host.shapeMode != 0) {
            int width = c.Width();
            int height = c.Height();
            bool matches = this.ShapeBackgroundMatches(width, height, slot);
            if (matches && host.bgSnapGen == host.bgThemeGen
            && c.RestoreRect(0, 0, width, height, slot)) { return; }
            // RestoreRect 只写当前 clip；SnapshotRect 却读取整个矩形。
            // 局部 miss 时不能捕获 clip 外上一帧的控件，也不能扩张 draw clip。
            host.bgSnapGen = 0;
            if (host.shapeShadow > 0) { this.PaintShapeShadow(); }
            this.PaintShapeFill();
            // 异形背景与单圆角渐变/玻璃壁纸均在此缓存；记录主题渐变参数，
            // 防止切换渐变/玻璃状态后复用旧主题基面。
            if (!host.Damage.partialFrame) {
                c.SnapshotRect(0, 0, width, height, slot);
                this.RememberShapeBackground(width, height, slot);
            }
            return;
        }
        if (bgShapeSnapshot != null) {
            // 壁纸和形状可能恰好同尺寸、同槽、同主题代次，不能互相恢复。
            bgShapeSnapshot = null;
            bgShapeTheme = null;
            host.bgSnapGen = 0;
        }
        // 原生玻璃：窗口是一张扁平的半透明薄片（在
        // BeginFrame 中清除），覆盖在 OS 模糊的桌面之上。加上柔和的从上到下
        // 光泽，使玻璃具有纵深（顶部更亮），如同真实的
        // 亚克力而非一块平板。
        if (host.glassNative) {
            StyleBox sheenStyle = Style.Part(host, "windowbg", "sheen", "",
                                             "", "", Style.SNormal());
            int hi = sheenStyle.BgOr(0) % 16777216;
            if (hi < 0) { hi = hi + 16777216; }
            int bands = 18;
            int bh = h / 3 / bands;
            if (bh < 1) { bh = 1; }
            for (int i = 0; i < bands; i = i + 1) {
                int a = 15 - (15 * i / bands);
                c.FillRect(x, y + i * bh, w, bh, a * 16777216 + hi);
            }
            return;
        }
        if (t.gradient != 0 || host.bgImagePath != "") {
            // 壁纸（渐变 + 柔和色斑）对每个皮肤+尺寸是静态的，因此
            // 每帧从快照恢复——包括脏帧——
            // 只要皮肤代次匹配。只有皮肤变更
            // （bgThemeGen 递增）或尺寸变化（RestoreRect 几何不匹配）
            // 才触发昂贵的重绘。这使玻璃/渐变皮肤在
            // 滚动或输入时保持流畅，而非每帧重新绘制色斑。
            bool restored = false;
            if (host.bgSnapGen == host.bgThemeGen) {
                restored = c.RestoreRect(x, y, w, h, slot);
            }
            if (!restored) {
                host.bgSnapGen = 0;
                // 径向色斑可越出背景矩形；限制到快照范围，使冷帧和恢复帧
                // 对矩形之外的像素保持一致。PushClip 与已有损伤裁剪取交集。
                c.PushClip(x, y, w, h);
                try {
                    if (t.gradient != 0) {
                        c.FillVGrad(x, y, w, h, t.bgGradTop, t.bgGradBottom);
                        if (t.glass != 0) {
                            this.BackdropGlassWallpaper(x, y, w, h);
                        } else {
                            this.BackdropGradientWallpaper(x, y, w, h);
                        }
                    } else {
                        StyleBox bgStyle = Style.FullRef(host, "windowbg", "", "", Style.SNormal());
                        c.FillRect(x, y, w, h, bgStyle.BgOr(0));
                    }
                    this.RenderWallpaperImage(x, y, w, h);
                } finally { c.PopClip(); }
                if (!host.Damage.partialFrame) {
                    c.SnapshotRect(x, y, w, h, slot);
                    host.bgSnapGen = host.bgThemeGen;
                }
            }
        } else {
            StyleBox bgStyle = host.CachedWindowBgStyle();
            c.FillRect(x, y, w, h, bgStyle.BgOr(0));
        }
    }

    private void PaintBackdropOverlay(int x, int y, int w, int h) {
        App host = app;
        if (host == null || host.theme == null) { return; }
        Theme t = host.theme;
        if (t.gradient != 0) {
            if (t.glass != 0) {
                this.BackdropGlassWallpaper(x, y, w, h);
            } else {
                this.BackdropGradientWallpaper(x, y, w, h);
            }
        }
        this.RenderWallpaperImage(x, y, w, h);
    }

    private void PaintRoundedShapeOverlay(int px, int py, int pw, int ph, int pr) {
        App host = app;
        if (host == null || host.canvas == null || pw <= 0 || ph <= 0) { return; }
        Canvas c = host.canvas;
        if (pr <= 0) {
            c.PushClip(px, py, pw, ph);
            try { this.PaintBackdropOverlay(px, py, pw, ph); }
            finally { c.PopClip(); }
            return;
        }
        int midH = ph - pr * 2;
        if (midH > 0) {
            c.PushClip(px, py + pr, pw, midH);
            try { this.PaintBackdropOverlay(px, py, pw, ph); }
            finally { c.PopClip(); }
        }
        for (int dy = 0; dy < pr; dy = dy + 1) {
            int ry = pr - dy;
            int inside = pr * pr - ry * ry;
            int dx = inside > 0 ? App.ISqrt(inside) : 0;
            int inset = pr - dx;
            int spanW = pw - inset * 2;
            if (spanW <= 0) { continue; }
            int yTop = py + dy;
            c.PushClip(px + inset, yTop, spanW, 1);
            try { this.PaintBackdropOverlay(px, py, pw, ph); }
            finally { c.PopClip(); }
            int yBot = py + ph - 1 - dy;
            if (yBot != yTop) {
                c.PushClip(px + inset, yBot, spanW, 1);
                try { this.PaintBackdropOverlay(px, py, pw, ph); }
                finally { c.PopClip(); }
            }
        }
    }

    // 用皮肤底色或圆角渐变/玻璃壁纸铺满异形窗口的轮廓（见 RenderBackground）。
    // 类型 3 的阴影带只是把系统表面撑大，不参与填充。
    // 填充铺满整个轮廓：内容贴着窗口边缘，投影从轮廓边缘向外
    // 衰减到阴影带里（见 PaintShapeShadow）；落在轮廓内的那半圈
    // 衰减带被这张不透明底色盖住，不会脏到内容。
    public void PaintShapeFill() {
        App host = app;
        if (host == null || host.canvas == null || host.shapeRegions == null || host.shapeRegions.Count == 0) {
            return;
        }
        StyleBox shapeStyle = Style.PartRef(host, "windowbg", "shape", "",
                                            "", "", Style.SNormal());
        int col = shapeStyle.BgOr(0);
        if (col == 0) {
            StyleBox bgStyle = Style.FullRef(host, "windowbg", "", "", Style.SNormal());
            col = bgStyle.BgOr(0);
        }
        if (col == 0) {
            StyleBox winStyle = Style.PartRef(host, "window", "base", "", "", "", Style.SNormal());
            col = winStyle.BgOr(0);
        }

        // 单圆角异形窗口（如 ZanIDE 12px 圆角框）：若皮肤启用了渐变或壁纸，
        // 按圆角轮廓绘制垂直渐变与裁切在轮廓内的玻璃/渐变彩斑与壁纸，
        // 避免与普通矩形窗口出现质感落差，同时保持外圈阴影带零污染。
        if (host.theme != null && (host.theme.gradient != 0 || host.bgImagePath != "")) {
            WindowShapeRegion shape = host.BackdropShape();
            if (shape != null) {
                int px = host.Scale(shape.x);
                int py = host.Scale(shape.y);
                int pw = host.Scale(shape.width);
                int ph = host.Scale(shape.height);
                int pr = host.Scale(shape.radius);
                if (pr < 0) { pr = 0; }
                if (pr * 2 > pw) { pr = pw / 2; }
                if (pr * 2 > ph) { pr = ph / 2; }
                if (pw > 0 && ph > 0) {
                    if (host.theme.gradient != 0) {
                        host.canvas.FillVGradMask(px, py, pw, ph, pr, 15,
                            host.theme.bgGradTop, host.theme.bgGradBottom);
                    } else {
                        this.PaintShapeRegions(col, !host.Damage.partialFrame && host.shapeShadow == 0);
                    }
                    this.PaintRoundedShapeOverlay(px, py, pw, ph, pr);
                    return;
                }
            }
        }

        // Only a full, single-region background without shadow is an initial layer.
        // Native also checks destination alpha; ordinary callers keep source-over.
        int solidRegions = 0;
        for (int i = 0; i < host.shapeRegions.Count; i = i + 1) {
            if (host.shapeRegions[i].kind != 3) { solidRegions = solidRegions + 1; }
        }
        this.PaintShapeRegions(col, !host.Damage.partialFrame && host.shapeShadow == 0 && solidRegions == 1);
    }

    public void PaintContentMask(int x, int y, int width, int height, int color) {
        App host = app;
        if (host == null || host.canvas == null || width <= 0 || height <= 0 || color == 0) { return; }
        if (host.shapeMode == 0 || host.shapeRegions == null || host.shapeRegions.Count == 0) {
            host.canvas.FillRect(x, y, width, height, color);
            return;
        }
        host.canvas.PushClip(x, y, width, height);
        try { this.PaintShapeRegions(color, false); }
        finally { host.canvas.PopClip(); }
    }

    private void PaintShapeRegions(int col, bool initial) {
        App host = app;
        if (host == null || host.canvas == null || host.shapeRegions == null) { return; }
        Canvas c = host.canvas;
        for (int ri = 0; ri < host.shapeRegions.Count; ri = ri + 1) {
            WindowShapeRegion reg = host.shapeRegions[ri];
            if (reg.kind != 3) {
                int x = host.Scale(reg.x);
                int y = host.Scale(reg.y);
                int w = host.Scale(reg.width);
                int h = host.Scale(reg.height);
                int r = host.Scale(reg.radius);
                if (r < 0) { r = 0; }
                if (w > 0 && h > 0) {
                    if (reg.kind == 2) {
                        this.FillEllipse(x, y, w, h, col);
                    } else if (initial) {
                        c.FillInitialShape(x, y, w, h, r, col);
                    } else if (r > 0) {
                        c.FillRoundRect(x, y, w, h, r, col);
                    } else {
                        c.FillRect(x, y, w, h, col);
                    }
                }
            }
        }
    }

    // 椭圆填充（渲染器只有正圆），按行扫描：轮廓由
    // 操作系统裁剪，这里只要把里面填实。
    public void FillEllipse(int x, int y, int w, int h, int col) {
        App host = app;
        if (host == null || host.canvas == null || w <= 0 || h <= 0) { return; }
        Canvas c = host.canvas;
        int rx = w / 2;
        int ry = h / 2;
        if (rx <= 0 || ry <= 0) { return; }
        int cx = x + rx;
        int cy = y + ry;
        for (int dy = 0 - ry; dy <= ry; dy = dy + 1) {
            long insideL = (long)ry * (long)ry - (long)dy * (long)dy;
            if (insideL <= 0) { continue; }
            int sq = insideL <= 2147483647 ? App.ISqrt((int)insideL) : (int)Math.Sqrt((double)insideL);
            int hw = (int)((long)rx * (long)sq / (long)ry);
            if (hw <= 0) { continue; }
            c.FillRect(cx - hw, cy + dy, hw * 2, 1, col);
        }
    }

    public void PaintShapeShadow() {
        App host = app;
        if (host == null || host.canvas == null || host.shapeRegions == null || host.shapeRegions.Count == 0 || host.shapeShadow <= 0) {
            return;
        }
        Canvas c = host.canvas;
        int blur = host.Scale(host.shapeShadow);
        if (blur <= 0) { return; }
        StyleBox shadowStyle = Style.Part(host, "windowbg", "shape-shadow",
                                           "", "", "", Style.SNormal());
        int baseCol = shadowStyle.BgOr(0);
        if (baseCol == 0) { return; }
        // 峰值 alpha：主题的阴影着色。火绒及现代桌面贴边约三到四成黑，
        // 向外自然平滑衰减。
        int peak = (baseCol >> 24) & 255;
        if (peak < 80) { peak = 80; }
        if (peak > 110) { peak = 110; }
        int rgb = baseCol % 16777216;
        if (rgb < 0) { rgb = rgb + 16777216; }

        for (int ri = 0; ri < host.shapeRegions.Count; ri = ri + 1) {
            WindowShapeRegion reg = host.shapeRegions[ri];
            if (reg.kind == 3) { continue; }
            int x = host.Scale(reg.x);
            int y = host.Scale(reg.y);
            int w = host.Scale(reg.width);
            int h = host.Scale(reg.height);
            int r = host.Scale(reg.radius);
            if (r < 0) { r = 0; }
            if (w <= 0 || h <= 0) { continue; }
            c.ShadowRoundRect(x, y, w, h, r, blur * 2, (peak << 24) | rgb);
        }
    }
}
