using System;
using Gui.Backend;
namespace Gui;
public partial class App {
    public void Show() {
        window.Show();
        int realW = window.ClientWidth();
        int realH = window.ClientHeight();
        if (realW != canvas.Width() || realH != canvas.Height()) { this.SwapCanvas(realW, realH); }
        dpiScale = window.GetDpiScale();
        #if ANDROID || OHOS || IOS
        if (realW > 0 && realH > 0 && designW > 0 && designH > 0) {
            int wantW = designW * dpiScale / 100;
            int wantH = designH * dpiScale / 100;
            if (wantW > realW || wantH > realH) {
                int fitX = realW * 100 / designW;
                int fitY = realH * 100 / designH;
                int fit = fitX < fitY ? fitX : fitY;
                if (fit < 50) { fit = 50; }
                if (fit > 400) { fit = 400; }
                if (fit < dpiScale) { fit = dpiScale; }
                if (fit < dpiScale) { dpiScale = fit; }
            }
        }
        #endif
        if (physicalStage) { dpiScale = window.GetDpiScale(); }
        this.ScaleThemeMetrics();
        scrollSpeed = 40 * dpiScale / 100;
        titlebarH = window.GetTitlebarHeight();
        captionBtnW = window.GetCaptionButtonWidth();
        if (titlebarH < 24) { titlebarH = Scale(32); }
        if (captionBtnW < 24) { captionBtnW = Scale(32); }
        int nCap = 0;
        if (showChrome) { nCap = ChromeButtonCount(); }
        window.SetCaptionButtons(nCap);
        this.AutomationShown();
    }
    public void Run(string title) {
        this.RunLoop(() => { this.RenderChrome(title); });
    }
    private int nativeDpiRevision;
    private int frameDpiRevision;
    void SyncNativeDpi() {
        #if WINDOWS || MACOS
        if (window.GetHandle() == 0) { return; }
        int scale = window.GetDpiScale();
        int bar = window.GetTitlebarHeight();
        int button = window.GetCaptionButtonWidth();
        int revision = window.DpiRevision();
        bool metricsChanged = dpiScale != scale;
        if (!metricsChanged && nativeDpiRevision == revision && titlebarH == bar && captionBtnW == button) { return; }
        nativeDpiRevision = revision;
        this.InvalidateFormPaint();
        dpiScale = scale;
        titlebarH = bar;
        captionBtnW = button;
        scrollSpeed = 40 * scale / 100;
        if (metricsChanged) {
            Canvas.InvalidateTextMetrics();
            this.ScaleThemeMetrics();
            bgThemeGen = bgThemeGen + 1;
        }
        backdropDirty = true;
        fxSnapValid = false;
        Damage.partialPending = false;
        Damage.forceFullNext = true;
        this.Stats.NoteRedrawWhy("SyncNativeDpi");
        needsRedraw = true;
        #endif
    }
    void SyncSurface() {
        this.SyncNativeDpi();
        int curW = window.ClientWidth();
        int curH = window.ClientHeight();
        if (curW <= 0 || curH <= 0) { return; }
        if (window.IsMaximized()) {
            if (shapeMode != 0) {
                maxSavedShapeSpec = shapeSpec;
                maxSavedShapeDesc = shapeDescription != null ? shapeDescription.Clone() : null;
                maxSavedShapeShadow = shapeShadow;
                shapeShadow = 0;
                this.SetWindowShape("");
            }
        } else {
            if (maxSavedShapeDesc != null && !maxSavedShapeDesc.IsEmpty()) {
                WindowShapeDescription restoreDesc = maxSavedShapeDesc;
                int restoreShadow = maxSavedShapeShadow;
                maxSavedShapeDesc = null;
                maxSavedShapeSpec = "";
                maxSavedShapeShadow = 0;
                this.SetWindowShape(restoreDesc);
                if (restoreShadow > 0 && !restoreDesc.HasShadowBand()) {
                    this.SetWindowShadow(restoreShadow);
                }
            } else if (maxSavedShapeSpec != "") {
                string restoreSpec = maxSavedShapeSpec;
                int restoreShadow = maxSavedShapeShadow;
                maxSavedShapeDesc = null;
                maxSavedShapeSpec = "";
                maxSavedShapeShadow = 0;
                this.SetWindowShape(restoreSpec);
                if (restoreShadow > 0) { this.SetWindowShadow(restoreShadow); }
            } else if (shapeMode == 0) {
                this.ApplyRoundCorners();
            }
        }
        if (curW == canvas.Width() && curH == canvas.Height()) { return; }
        this.SwapCanvas(curW, curH);
        this.Stats.NoteRedrawWhy("SyncSurface");
        needsRedraw = true;
    }
    public void SetFrameBody(FrameBody body) {
        this.ResetFormRegion();
        this.InvalidateFormPaint();
        frameBody = body;
        App.SetFrameApp(this);
        Window.SetSizePaint(() => { App.PaintFromWndProc(); });
    }
    public static void PaintFromWndProc() {
        if (App.WndProcPainting()) { return; }
        nint hwnd = Window.SizePaintWindow();
        if (ChildWindows.PaintForResize(hwnd)) { return; }
        App a = App.FrameApp();
        if (a == null || a.frameBody == null) { return; }
        if (hwnd != a.WindowHandle()) { return; }
        bool priorPainting = App.WndProcPainting();
        App.SetWndProcPainting(true);
        try {
            a.FrameGuarded(a.frameBody);
        } finally { App.SetWndProcPainting(priorPainting); }
    }
    public void RunLoop(FrameBody body) {
        Show();
        if (frameBody == null) { this.SetFrameBody(body); }
        while (isRunning) {
            if (!this.PumpGuarded()) { break; }
            if (!needsRedraw) { continue; }
            if (!window.IsVisible()) { continue; }
            this.FrameGuarded(body);
        }
    }
    static void GuardBody(nint arg) {
        AppGuardFrame frame = GuiCoreState.Current().guardFrame;
        if (frame == null || frame.app == null) { return; }
        if (frame.what == 0) { frame.pumpAlive = frame.app.PumpSafe(); }
        else { frame.app.SafeFrame(frame.body); }
    }
    bool PumpGuarded() {
        GuiCoreState state = GuiCoreState.Current();
        AppGuardFrame frame = new AppGuardFrame();
        frame.app = this;
        frame.what = 0;
        frame.pumpAlive = isRunning;
        frame.previous = state.guardFrame;
        bool priorPainting = App.WndProcPainting();
        int priorSnapshotSilence = snapshotInputSilenceDepth;
        state.guardFrame = frame;
        bool complete = Window.GuardCall((nint)App.GuardBody, 0);
        bool alive = frame.pumpAlive;
        state.guardFrame = frame.previous;
        App.SetWndProcPainting(priorPainting);
        snapshotInputSilenceDepth = priorSnapshotSilence;
        if (!complete) {
            this.RecoverPreparationFault();
            this.NoteFrameError("event", "native fault recovered");
            return isRunning;
        }
        return alive;
    }
    bool FrameGuarded(FrameBody body) {
        GuiCoreState state = GuiCoreState.Current();
        AppGuardFrame frame = new AppGuardFrame();
        frame.app = this;
        frame.what = 1;
        frame.body = body;
        frame.previous = state.guardFrame;
        bool priorPainting = App.WndProcPainting();
        int priorSnapshotSilence = snapshotInputSilenceDepth;
        state.guardFrame = frame;
        bool complete = Window.GuardCall((nint)App.GuardBody, 0);
        state.guardFrame = frame.previous;
        App.SetWndProcPainting(priorPainting);
        snapshotInputSilenceDepth = priorSnapshotSilence;
        if (!complete) {
            this.RecoverPreparationFault();
            this.NoteFrameError("frame", "native fault recovered");
            return false;
        }
        return !preparationFrameAborted;
    }
    static int NativeFaultCount() { return Window.GuardRecovered(); }
    bool PumpSafe() {
        try {
            return ProcessEvent();
        } catch (Exception ex) {
            this.NoteFrameError("event", ex.Message);
            return isRunning;
        }
    }
    bool SafeFrame(FrameBody body, AppLoopRegistration formPaintTicket = null) {
        try {
            this.TraceFullPresent(13, true);
            this.SyncSurface();
            this.BeginFormPaint(formPaintTicket);
            this.TraceFullPresent(13, false);
            this.TraceFullPresent(14, true);
            BeginFrame();
            this.TraceFullPresent(14, false);
            this.TraceFullPresent(15, true);
            if (this.CurrentHostLayout() != null && !this.PrepareStandardHostFrame()) {
                this.TraceFullPresent(16, true);
                return false;
            }
            this.TraceFullPresent(15, false);
            this.TraceFullPresent(17, true);
            body();
            this.TraceFullPresent(17, false);
            if (!this.ContinuePreparedFrame()) {
                this.TraceFullPresent(18, true);
                return false;
            }
            this.TraceFullPresent(19, true);
            PresentFrame();
            this.TraceFullPresent(19, false);
            if (!this.ContinuePreparedFrame()) {
                this.TraceFullPresent(18, false);
                return false;
            }
            if (formPaintTicket != null) { this.CommitFormPaintGeometry(formPaintTicket); }
            return true;
        } catch (Exception ex) {
            this.TraceFullPresent(20, true);
            this.AbortPreparationFrame();
            this.NoteFrameError("frame", ex.Message);
            // 这一帧残缺：丢掉那个脏区裁剪，下一帧全重绘。
            this.Damage.CancelPartialFrame();
            this.RequestRedraw();
            return false;
        } finally {
            formPaintFrame = false;
            drawerOpaquePartial = false;
            paintingSteadyDrawer = false;
        }
    }
    void RefreshScrollHover() {
        if (!this.scrollHoverDirty) { return; }
        this.scrollHoverDirty = false;
        if (this.overlayPressBlocked) { return; }
        Control previous = this.lastHoveredControl;
        bool hasOverlay = overlayHost != null && overlayHost.HasActive();
        Control next = hasOverlay ? overlayHost.HitTest(mouseX, mouseY, currentPointerType)
                                  : (rootControl != null ? rootControl.HitTest(mouseX, mouseY, currentPointerType) : null);
        if (next == previous) { return; }
        Control hoverLca = App.CommonHoverAncestor(previous, next);
        this.lastHoveredControl = null;
        if (previous != null && previous != hoverLca) {
            RoutedEventArgs leave = new RoutedEventArgs("PointerLeave", previous, mouseX, mouseY, currentPointerType);
            Control.RouteEventTo(previous, leave, hoverLca);
        }
        this.lastHoveredControl = next;
        if (next != null && next != hoverLca) {
            RoutedEventArgs enter = new RoutedEventArgs("PointerEnter", next, mouseX, mouseY, currentPointerType);
            Control.RouteEventTo(next, enter, hoverLca);
        }
        Control hoverFocus = this.HoverFocusTarget(next);
        focus.SetHovered(hoverFocus != null ? hoverFocus.WidgetId() : -1);
        this.Stats.NoteRedrawWhy("scroll-hover");
        if (!needsRedraw) { this.Damage.NoteHoverDamage(previous, next); }
        needsRedraw = true;
    }
    void NoteFrameError(string origin, string message) {
        lastFrameError = origin + ": " + message;
        frameErrors = UiErrorLog.Record(origin, message);
    }
    int FrameErrorCount() { return frameErrors; }
    string LastFrameError() { return lastFrameError; }
