    public int ClientWidth() { return canvas.Width() - this.ShapeOffX() * 2; }
    public int ClientHeight() { return canvas.Height() - this.ShapeOffY() * 2; }
    internal void ContentBounds(out int x, out int y, out int width, out int height) {
        int top = this.ContentTop();
        x = this.ShapeOffX();
        y = this.ShapeOffY() + top;
        width = Math.Max(0, this.ClientWidth());
        height = Math.Max(0, this.ClientHeight() - top);
    }
    public int CssViewportWidth() {
        if (window.GetHandle() == 0) { return designW; }
        int scale = dpiScale > 0 ? dpiScale : 100;
        return (this.ClientWidth() * 100 + scale / 2) / scale;
    }
    public int CssViewportHeight() {
        if (window.GetHandle() == 0) { return designH; }
        int scale = dpiScale > 0 ? dpiScale : 100;
        return (this.ClientHeight() * 100 + scale / 2) / scale;
    }
    // 获取整窗重绘原因（分析器与测试使用）。
    public string RedrawWhy() { return Stats.RedrawWhy; }
    public void RequestRedraw() {
        cleanHostLayoutValid = false;
        this.RequestHoverFullRedraw();
    }
    public void RequestHoverFullRedraw() {
        this.InvalidateFormPaint();
        if (App.PerfOn()) {
            string why = Stats.MarkNow;
            if (why == "") { why = "ev@" + Convert.ToString(Stats.ScopeId); }
            this.Stats.NoteRedrawWhy(why);
        }
        Damage.partialBlocked = true;
        // 由状态（而非单纯悬停移动）请求的重绘可能触及任意
        // 像素，因此它会取消悬停移动在同一事件处理中
        // 早些时候武装的损伤裁剪帧。
        Damage.partialPending = false;
        needsRedraw = true;
        fxSnapValid = false;
    }
    int DisplayFrameDueMs() {
        if (window.RequestDisplayFrame()) {
            displayAnimationPending = true;
            return Window.GetTickMs() + 100;
        }
        int now = Window.GetTickMs();
        int wait = frameCadence.WaitMilliseconds(Stopwatch.GetMicroseconds());
        if (Window.frozenTick && wait < 1) { wait = 1; }
        return now + wait;
    }
    public double RefreshRate() { return window.RefreshRate(); }
    public void Wake() {
        if (window != null) { window.Wake(); }
    }
    public void RequestWakeIn(int minIntervalMs) {
        int due = Window.GetTickMs() + minIntervalMs;
        if (wakeNextMs < 0 || due < wakeNextMs) { wakeNextMs = due; }
    }
    void RequestWakeAt(int dueMs) {
        if (wakeNextMs < 0 || dueMs < wakeNextMs) { wakeNextMs = dueMs; }
    }
    void RequestWakeFrameIn(int minIntervalMs) {
        int due = Window.GetTickMs() + minIntervalMs;
        if (wakeFrameNextMs < 0 || due < wakeFrameNextMs) { wakeFrameNextMs = due; }
    }
    bool BackdropDirty() { return backdropDirty; }
    bool BackdropDirtyIn(int slot, int x, int y, int w, int h) {
        if (slot < 0) { return true; }
        bool clipCovers = !Damage.partialFrame || this.RectInDamage(x, y, w, h);
        if (freezeAnimClock) { return clipCovers; }
        if (slot < blurSlots.Count && blurSlots[slot].lastNew == frameCount) {
            return true;
        }
        if (Damage.glassRefreshOwe && Damage.partialFrame && !this.ScrollBurstActive()
            && this.RectHitsDamage(x, y, w, h)) {
            return true;
        }
        if (!backdropDirty) { return false; }
        if (!Damage.partialFrame) { return true; }
        if (!this.RectHitsDamage(x, y, w, h)) { return false; }
        if (!clipCovers || this.ScrollBurstActive()) {
            this.NoteGlassDeferred(x, y, w, h);
            return false;
        }
        return true;
    }

    bool ScrollBurstActive() {
        return nowMs < Damage.scrollBusyUntilMs;
    }

    bool RectHitsDamage(int x, int y, int w, int h) {
        if (x + w <= Damage.dmgX || Damage.dmgX + Damage.dmgW <= x) { return false; }
        if (y + h <= Damage.dmgY || Damage.dmgY + Damage.dmgH <= y) { return false; }
        return true;
    }
    bool RectInDamage(int x, int y, int w, int h) {
        if (Damage.dmgW <= 0 || Damage.dmgH <= 0) { return false; }
        return x >= Damage.dmgX && y >= Damage.dmgY
            && x + w <= Damage.dmgX + Damage.dmgW && y + h <= Damage.dmgY + Damage.dmgH;
    }
    void NoteGlassDeferred(int x, int y, int w, int h) {
        Damage.glassDeferred = true;
        Damage.glassRefreshOwe = true;
        // 串里又欠了新的：之前武装过的还账帧不再算数（它没罩住
        // 这块新面板），串结束后按更全的清单重新武装。
        Damage.glassRefreshArmedAt = 0 - 1;
        if (Damage.glassDeferredRects.Count >= 128) { return; }
        Damage.glassDeferredRects.Add(x);
        Damage.glassDeferredRects.Add(y);
        Damage.glassDeferredRects.Add(w);
        Damage.glassDeferredRects.Add(h);
    }
    void ReuseBackdrop() { backdropDirty = false; }
    bool PointerPressed() { return focus.pressedId >= 0; }
    int NextBlurSlot() { blurSlotSeq = blurSlotSeq + 1; return this.BlurSlotFor(0 - blurSlotSeq); }
    int BlurKeyId(int id) {
        if (id == 0) { return 0; }
        int k = id;
        if (k < 0) { k = 0 - k; }
        return k * 2 + 1;
    }
    int BlurKey(int kind, int x, int y, int w, int h) {
        int k = kind * 1000003 + x * 9176 + y * 313 + w * 31 + h;
        if (k < 0) { k = 0 - k; }
        return k * 2 + 2;
    }
    int BlurSlotFor(int key) {
        if (key == 0) { return this.NextBlurSlot(); }
        int free = -1;
        int lru = 0;
        int lruUse = -1;
        int i = 0;
        while (i < 64) {
            BlurSlot s = blurSlots[i];
            if (s.key == key) {
                s.lastUse = frameCount;
                return i;
            }
            if (s.key == 0) {
                if (free < 0) { free = i; }
            } else if (s.lastUse != frameCount
                       && (lruUse < 0 || s.lastUse < lruUse)) {
                lru = i;
                lruUse = s.lastUse;
            }
            i = i + 1;
        }
        int slot = free;
        if (slot < 0) {
            if (lruUse < 0) { return -1; }
            slot = lru;
        }
        BlurSlot target = blurSlots[slot];
        target.key = key;
        target.lastUse = frameCount;
        target.lastNew = frameCount;
        return slot;
    }
    void SetImeCaret(int x, int y) {
        if (window.GetHandle() == 0) { return; }
        Ime.SetCaret(x, y);
    }
    public void Post(Action handler) { this.TryPost(handler); }
    public void Post(Action handler, string tag) { this.Post(handler); }
    public bool TryPost(Action handler) {
        bool accepted = false;
        lock (this) {
            if (isRunning && handler != null) {
                AppPostWork work = new AppPostWork();
                work.owner = this;
                work.handler = handler;
                work.prev = postTail;
                AppPostWork tail = postTail;
                if (tail != null) { tail.next = work; }
                else { postHead = work; }
                postTail = work;
                accepted = Dispatcher.Post(() => { work.Run(); });
                if (!accepted) {
                    this.UnlinkPost(work);
                    work.handler = null;
                }
            }
        }
        if (accepted) { this.Wake(); }
        return accepted;
    }
    void UnlinkPost(AppPostWork work) {
        AppPostWork before = work.prev;
        AppPostWork after = work.next;
        if (before != null) { before.next = after; }
        else { postHead = after; }
        if (after != null) { after.prev = before; }
        else { postTail = before; }
        work.prev = null;
        work.next = null;
        work.owner = null;
    }
    void RunPost(AppPostWork work) {
        Action handler = null;
        bool run = false;
        lock (this) {
            if (work.owner == this) {
                this.UnlinkPost(work);
                handler = work.handler;
                work.handler = null;
                run = isRunning;
            }
        }
        if (run && handler != null) {
            handler();
            cleanHostLayoutValid = false;
            this.Stats.NoteRedrawWhy("handler");
            needsRedraw = true;
        }
    }
    public void StopLoop() {
        lock (this) { isRunning = false; }
        closeRequest = null;
        closeGuard = null;
        this.SetAutomationSession(null);
        Exception loopError = null;
        try { this.ClearLoopParticipants(); }
        catch (Exception error) { loopError = error; }
        bool done = false;
        while (!done) {
            Action handler = null;
            lock (this) {
                AppPostWork work = postHead;
                if (work == null) { done = true; }
                else {
                    this.UnlinkPost(work);
                    handler = work.handler;
                    work.handler = null;
                }
            }
            handler = null;
        }
        if (loopError != null) { throw loopError; }
    }
    Action closeRequest;
    bool closePending;
    Func<bool> closeGuard;
    public void OnCloseRequest(Action handler) {
        closeRequest = handler;
        closePending = false;
    }
    public void OnCloseGuard(Func<bool> handler) {
        closeGuard = handler;
        if (handler != null) { this.window.SetCloseIntercept(true); }
    }
    bool HandleCloseRequest() {
        Func<bool> guard = closeGuard;
        if (guard != null) {
            if (!guard()) { return true; }
            this.window.Destroy();
            this.closeGuard = null;
        }
        if (closeRequest == null) {
            this.StopLoop();
            return false;
        }
        if (!closePending) {
            closePending = true;
            Action handler = closeRequest;
            handler();
        }
        return isRunning;
    }
    public void RequestClose() { window.Close(); }
    public void MinimizeWindow() {
        if (window != null) { window.Minimize(); }
    }
    public void ToggleMaximizeWindow() {
        if (window != null) { window.ToggleMaximize(); }
    }
    void DrainPosts() {
        Action handler = Dispatcher.Take();
        while (handler != null) {
            handler();
            cleanHostLayoutValid = false;
            this.Stats.NoteRedrawWhy("handler");
            needsRedraw = true;
            handler = Dispatcher.Take();
        }
    }
    // 按千分值 p (0..1000) 在 a 和 b 之间线性插值。
    static int Lerp(int a, int b, int p) {
        return a + (b - a) * p / 1000;
    }

    int ViewportHeight() {
        return canvas.Height();
    }

    int Scale(int v) {
        return v * dpiScale / 100;
    }

    // SetWindowShadow 外扩时内容轮廓相对画布原点的偏移
    // （物理像素）。异形窗口的阴影/填充/自绘标题栏都以
    // 它为基准定位；矩形窗口恒为 0。
    int ShapeOffX() { return shapeOffX * dpiScale / 100; }
    int ShapeOffY() { return shapeOffY * dpiScale / 100; }
    void FillChrome(int x, int y, int w, int h, int radius, int color) {
        if (theme.glass != 0) {
            this.FillGlass(x, y, w, h, radius, color, 1000);
        } else if (radius > 0) {
            canvas.FillRoundRect(x, y, w, h, radius, color);
        } else {
            canvas.FillRect(x, y, w, h, color);
        }
    }
    void FillGlass(int x, int y, int w, int h, int radius, int color, int a) {
        if (glassNative && a >= 900) {
            canvas.FillRoundRect(x, y, w, h, radius, Style.Fade(color, 300));
        } else if (theme.glass != 0 && a >= 900) {
            int gslot = this.BlurSlotFor(this.BlurKey(1, x, y, w, h));
            bool gdirty = this.BackdropDirtyIn(gslot, x, y, w, h);
            if (radius > 0) {
                canvas.BlurRoundCached(x, y, w, h, this.Scale(36),
                                       gslot, gdirty, radius, 15);
            } else {
                canvas.BlurRectCached(x, y, w, h, this.Scale(36),
                                      gslot, gdirty);
            }
            int fillCol = StyleBox.AlphaOf(color) < 255 ? color : Style.Fade(color, 780);
            canvas.FillRoundRect(x, y, w, h, radius, fillCol);
        } else {
            canvas.FillRoundRect(x, y, w, h, radius, Style.Fade(color, a));
        }
    }
    bool TakeDueFrame(int now) {
        bool fxOnly = animNextMs < 0 || now < animNextMs;
        bool fxDue = fxNextMs >= 0 && now >= fxNextMs;
        bool serviceDue = wakeNextMs >= 0 && now >= wakeNextMs;
        if (serviceDue) { wakeNextMs = -1; }
        bool frameWakeDue = wakeFrameNextMs >= 0 && now >= wakeFrameNextMs;
        bool pageDue = !fxOnly || needsRedraw || this.inputNeedsFrame || frameWakeDue;
        if (fxDue && !pageDue && this.FxPresent()) { return false; }
        if (serviceDue && !pageDue && !fxDue) { return false; }
        if (this.QueueFormRegion(!fxOnly, frameWakeDue, fxDue)) { return false; }
        if (!pageDue && fxOnly && animNextMs >= 0
            && animNextMs - now <= this.FxIntervalMs()
            && (this.ForceFullFrames() || !animRectValid || animRectAll
                || this.HasOverlays() || blocksInputBelow)) {
            return false;
        }
        this.QueueFormPaint(!fxOnly, frameWakeDue || fxDue || serviceDue);
        if (!fxOnly || frameWakeDue || serviceDue) { cleanHostLayoutValid = false; }
        if (frameWakeDue) { wakeFrameNextMs = -1; }
        this.Stats.NoteRedrawWhy(fxOnly && frameWakeDue ? "wake" : "ProcessEvent");
        needsRedraw = true;
        if (!fxOnly && animRectValid && !animRectAll
            && !this.inputNeedsFrame
            && !this.ForceFullFrames()
            && !this.HasOverlays() && !blocksInputBelow) {
            int adX = animRX;
            int adY = animRY;
            int adR = animRX + animRW;
            int adB = animRY + animRH;
            if (animPrevValid) {
                if (animPX < adX) { adX = animPX; }
                if (animPY < adY) { adY = animPY; }
                if (animPX + animPW > adR) { adR = animPX + animPW; }
                if (animPY + animPH > adB) { adB = animPY + animPH; }
            }
            Damage.dmgX = adX;
            Damage.dmgY = adY;
            Damage.dmgW = adR - adX;
            Damage.dmgH = adB - adY;
            // 记下的是这一帧*声明*的范围，不是刚算出的并集。存并集会
            // 让「上一帧画过的」逐帧吞进更早各帧的范围而永不收缩：几十
            // 帧之后裁剪矩形就是全窗，于是每个动画帧都整窗光栅一遍 ——
            // 名义上是局部帧，代价却是整窗帧。
            animPrevValid = true;
            animPX = animRX;
            animPY = animRY;
            animPW = animRW;
            animPH = animRH;
            Damage.partialPending = true;
        }
        // 整窗页在 PresentFrame 直接合成当前 Fx；局部页先推进条带外，
        // 只声明损伤，页面帧尾合成条带并呈现一次。快照失效时重建整页。
        if (fxDue && Damage.partialPending && !Damage.forceFullNext
            && !this.inputNeedsFrame && !fxPagePending) {
            if (!this.FxPresent(false)) { Damage.partialPending = false; }
        }
        return true;
    }
    void PumpDueFrame() {
        this.TickRoutedLongPress();
        int now = Window.GetTickMs();
        int deadline = animNextMs;
        if (deadline < 0 || (wakeNextMs >= 0 && wakeNextMs < deadline)) { deadline = wakeNextMs; }
        if (deadline < 0
            || (wakeFrameNextMs >= 0 && wakeFrameNextMs < deadline)) {
            deadline = wakeFrameNextMs;
        }
        if (deadline < 0 || (fxNextMs >= 0 && fxNextMs < deadline)) { deadline = fxNextMs; }
        if (deadline < 0 || now < deadline) { return; }
        this.TakeDueFrame(now);
    }
}
