using System;
using Gui.Backend;
namespace Gui;
public partial class App {
    public void SetWindowOpacity(int percent) {
        if (percent < 10) { percent = 10; }
        if (percent > 100) { percent = 100; }
        windowOpacity = percent;
        window.SetOpacity(percent);
    }
    public void SetResizable(bool on) {
        windowResizable = on;
        window.SetResizable(on);
        if (!on && showMaximizeButton) {
            this.SetChromeButtons(showThemeButton, showPinButton,
                showMinimizeButton, false);
        }
        this.Stats.NoteRedrawWhy("SetResizable");
        needsRedraw = true;
    }
    public bool Resizable() { return windowResizable; }
    public int WindowOpacity() {
        if (windowOpacity <= 0) { return 100; }
        return windowOpacity;
    }
    public void SetCursorVisible(bool visible) { Window.SetCursorVisible(visible); }
    public bool IsCursorVisible() { return Window.IsCursorVisible(); }
    public void SetPointerLock(bool locked) {
        if (window != null) { window.SetPointerLock(locked); }
    }
    public bool IsPointerLock() {
        return window != null && window.IsPointerLock();
    }
    public void ConsumeMouseDelta() {
        if (window != null) { window.ConsumeMouseDelta(); }
    }
    public double MouseDeltaX() {
        return window != null ? window.MouseDeltaX() : 0.0;
    }
    public double MouseDeltaY() {
        return window != null ? window.MouseDeltaY() : 0.0;
    }
    void SetWindowShape(WindowShapeDescription desc) {
        if (desc == null || desc.IsEmpty()) {
            shapeDescription = WindowShapeDescription.Empty();
            shapeSpec = "";
            shapeRegions = new List<WindowShapeRegion>();
            shapeMode = 0;
            shapeRadius = 0;
            shapeShadow = 0;
            shapeOffX = 0;
            shapeOffY = 0;
        } else {
            int pendingShadow = shapeMode == 0 ? shapeShadow : 0;
            shapeDescription = desc.Clone();
            if (pendingShadow > 0 && shapeDescription.shadow == 0
            && !shapeDescription.HasShadowBand()) {
                shapeDescription = shapeDescription.WithShadow(pendingShadow);
            }
            shapeSpec = shapeDescription.ToSpec();
            shapeRegions = shapeDescription.regions;
            shapeMode = 1;
            shapeRadius = shapeDescription.GetEffectiveRadius();
            shapeShadow = shapeDescription.shadow;
            shapeOffX = shapeDescription.offsetX;
            shapeOffY = shapeDescription.offsetY;
        }
        if (shapeMode != 0 && glassNative) {
            window.DisableGlass();
            glassNative = false;
        }
        window.SetShapeDescription(shapeDescription);
        if (shapeMode == 0) { this.ApplyRoundCorners(); }
        this.Stats.NoteRedrawWhy("SetWindowShape");
        this.RequestRedraw();
    }
    void SetWindowShape(string spec) { this.SetWindowShape(WindowShapeDescription.ParseSpec(spec)); }
    void SetWindowShadow(int px) {
        if (px < 0) { px = 0; }
        shapeShadow = px;
        if (shapeDescription == null) { shapeDescription = WindowShapeDescription.ParseSpec(shapeSpec); }
        if (px > 0 && shapeMode != 0 && !shapeDescription.IsEmpty()) {
            WindowShapeDescription withShadow = shapeDescription.WithShadow(px);
            this.SetWindowShape(withShadow);
        } else if (px == 0 && shapeMode != 0 && shapeDescription.HasShadowBand()) {
            WindowShapeDescription clean = new WindowShapeDescription();
            int offX = shapeOffX;
            int offY = shapeOffY;
            for (int i = 0; i < shapeDescription.regions.Count; i = i + 1) {
                WindowShapeRegion reg = shapeDescription.regions[i];
                if (reg.kind == WindowShapeKind.ShadowBand) { continue; }
                clean.regions.Add(new WindowShapeRegion(reg.kind, reg.x - offX, reg.y - offY, reg.width, reg.height, reg.radius));
            }
            this.SetWindowShape(clean);
        }
        this.Stats.NoteRedrawWhy("SetWindowShadow");
        needsRedraw = true;
    }
    bool HasShadowBand() {
        if (shapeDescription != null) { return shapeDescription.HasShadowBand(); }
        if (shapeRegions != null) {
            for (int ri = 0; ri < shapeRegions.Count; ri = ri + 1) {
                if (shapeRegions[ri].kind == WindowShapeKind.ShadowBand) { return true; }
            }
        }
        return false;
    }
    void ParseShapeSpec(string spec) {
        WindowShapeDescription desc = WindowShapeDescription.ParseSpec(spec);
        shapeRegions = desc.regions;
    }
    int WindowShadow() { return shapeShadow; }
    string WindowShapeSpec() { return shapeSpec; }
    int WindowShape() { return shapeMode; }
    int WindowShapeRadius() { return shapeRadius; }
    int EffectiveCornerRadius() {
        if (window != null && window.IsMaximized()) { return 0; }
        if (shapeMode != 0 && shapeRadius > 0) { return this.Scale(shapeRadius); }
        if (windowRound) { return this.Scale(4); }
        return 0;
    }
    void SetChromeVisible(bool on) {
        showChrome = on;
        int n = 0;
        if (on) { n = ChromeButtonCount(); }
        window.SetCaptionButtons(n);
        this.Stats.NoteRedrawWhy("SetChromeVisible");
        needsRedraw = true;
    }
    bool ChromeVisible() { return showChrome; }
    void SetChromeStatus(string text, string accent) {
        if (text == null) { text = ""; }
        if (accent == null) { accent = ""; }
        if (chromeStatus == text && chromeAccent == accent) { return; }
        chromeStatus = text;
        chromeAccent = accent;
        this.RequestRedraw();
    }
    void SetChromeBrandIcon(string icon) {
        if (icon == null) { icon = ""; }
        if (chromeBrandIcon == icon) { return; }
        chromeBrandIcon = icon;
        this.RequestRedraw();
    }
    private bool chromeBrandProbed;
    public void SetChromeBrandImage(string imageKey) {
        if (imageKey == null) { imageKey = ""; }
        if (this.chromeBrandImageKey == imageKey) { return; }
        this.chromeBrandImageKey = imageKey;
        this.chromeBrandProbed = imageKey != "";
        this.RequestRedraw();
    }
    string BrandImageKey() {
        if (this.chromeBrandImageKey != "") { return this.chromeBrandImageKey; }
        if (this.chromeBrandProbed) { return ""; }
        this.chromeBrandProbed = true;
        int[] pixels = AppIcon.Pixels();
        int side = AppIcon.Side();
        if (pixels != null && side > 0) {
            string key = "mem:zan-app-icon";
            if (Canvas.ImageRegisterArgb(key, pixels, side, side) == side) {
                this.chromeBrandImageKey = key;
                return key;
            }
        }
        string[] candidates = new string[] {
            "app.png",
            "../Resources/app.png",
            "Resources/app.png",
            "app.ico",
            "../Resources/app.ico",
            "Resources/app.ico",
            "1.ico"
        };
        for (int i = 0; i < candidates.Length; i = i + 1) {
            string cand = candidates[i];
            if (File.Exists(cand)) {
                if (Canvas.ImageWidth(cand) > 0) {
                    this.chromeBrandImageKey = cand;
                    return cand;
                }
            }
        }
        return "";
    }
    void SetTitlebarHeight(int devicePx) {
        if (devicePx <= titlebarH) { return; }
        titlebarH = devicePx;
        window.SetTitlebarHeight(devicePx);
        this.RequestRedraw();
    }

    // 当前标题栏状态文本（常规段）。
    string ChromeStatus() { return chromeStatus; }
    public string ChromeAccent() { return chromeAccent; }
    public void SetWindowTitle(string text) { if (window != null) { window.SetTitle(text != null ? text : ""); } }
    public void SetTopmost(bool on) {
        this.isTopmost = on;
        window.SetTopmost(on);
    }
    public bool IsTopmost() { return this.isTopmost; }
    // 开启或关闭纯逐像素透明窗口（无系统亚克力模糊、无实色底）。
    public void SetTransparent(bool on) {
        this.isTransparent = on;
        if (on && this.glassNative) {
            window.DisableGlass();
            this.glassNative = false;
        }
        window.SetTransparent(on);
        this.Stats.NoteRedrawWhy("SetTransparent");
        needsRedraw = true;
    }
    public bool IsTransparent() { return this.isTransparent; }
    // 开启或关闭整窗鼠标穿透（WS_EX_TRANSPARENT / ignoresMouseEvents）。
    public void SetClickThrough(bool on) {
        this.isClickThrough = on;
        window.SetClickThrough(on);
    }
    public bool IsClickThrough() { return this.isClickThrough; }
    // 在无标题栏客户区按下鼠标时触发系统级窗口拖拽。
    public void StartWindowDrag() { window.StartWindowDrag(); }
    // 一键应用桌面挂机/桌宠窗口预设（隐藏系统标题栏/可选任务栏隐藏/透明/置顶/穿透）。
    public void ApplyCompanionMode(bool topmost, bool transparent, bool clickThrough, bool toolWindow) {
        if (transparent) { this.SetChromeVisible(false); }
        this.SetToolWindow(toolWindow);
        this.SetTransparent(transparent);
        this.SetTopmost(topmost);
        this.SetClickThrough(clickThrough);
    }
    public void SetMinSize(int w, int h) { window.SetMinSize(w, h); }
    void SetNativeGlass(bool on) {
        if (on) {
            if (shapeMode != 0) { this.SetWindowShape(""); }
            window.EnableGlass(this.GlassTint());
            glassNative = true;
        } else {
            window.DisableGlass();
            glassNative = false;
        }
        this.Stats.NoteRedrawWhy("SetNativeGlass");
        needsRedraw = true;
    }
    bool NativeGlass() { return glassNative; }
    void SetWindowRoundCorners(bool on) {
        windowRound = on;
        windowRoundSet = true;
        this.ApplyRoundCorners();
        this.Stats.NoteRedrawWhy("SetWindowRoundCorners");
        needsRedraw = true;
    }
    void ApplyRoundCorners() {
        if (!windowRoundSet) { return; }
        if (shapeMode != 0) { return; }
        window.SetRoundCorners(windowRound);
    }
    public void SetToolWindow(bool on) { window.SetToolWindow(on); }
    public bool ToolWindow() { return window.ToolWindow(); }
}
