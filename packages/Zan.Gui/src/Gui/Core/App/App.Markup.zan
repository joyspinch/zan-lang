using System;
using Gui.Backend;
namespace Gui;
public partial class App {
    public static LinkScanFn LinkScanner() { return GuiCoreState.Current().linkScanner; }
    public static void SetLinkScanner(LinkScanFn fn) { GuiCoreState.Current().linkScanner = fn; }
    static void AutoLinkTree(Control root, App app) {
        LinkScanFn fn = GuiCoreState.Current().linkScanner;
        if (fn != null) { fn(root, app); }
    }
    static Control CloneTree(Control root) {
        CloneTreeFn fn = GuiCoreState.Current().cloneTree;
        if (fn != null) { return fn(root); }
        return null;
    }
    static CloneTreeFn CloneTree() { return GuiCoreState.Current().cloneTree; }
    static void SetCloneTree(CloneTreeFn fn) { GuiCoreState.Current().cloneTree = fn; }
    static void SetCssScoper(CssScopeFn fn) { GuiCoreState.Current().cssScoper = fn; }
    static string ScopeCss(string css, string scope) {
        if (css == "") { return ""; }
        CssScopeFn fn = GuiCoreState.Current().cssScoper;
        if (fn != null) { return fn(css, scope); }
        return css;
    }
    static List<AppHookFn> PresentTails() { return GuiCoreState.Current().presentTails; }
    static void SetPresentTails(List<AppHookFn> tails) { GuiCoreState.Current().presentTails = tails; }
    static void AddPresentTail(AppHookFn fn) {
        if (fn == null) { return; }
        GuiCoreState state = GuiCoreState.Current();
        if (state.presentTails == null) { state.presentTails = new List<AppHookFn>(); }
        state.presentTails.Add(fn);
    }
    string NextLoadScope() {
        string zs = "zs-load-" + Convert.ToString(htmlLoadSeq);
        htmlLoadSeq = htmlLoadSeq + 1;
        return zs;
    }
    void ApplyScopedTree(Control root, string scopedCss, string zs) {
        string merged = appCss == "" ? scopedCss : appCss + "\n" + scopedCss;
        this.UseAppCss(merged);
        this.MarkScope(root, zs);
    }
    void MarkScope(Control n, string zs) {
        this.MarkScopeNode(n, n, zs);
    }
    void MarkScopeNode(Control root, Control n, string zs) {
        if (n == null) { return; }
        n.AddClass(zs);
        if (n != root && n.OwnsInnerScope()) { return; }
        for (int i = 0; i < n.ChildCount(); i = i + 1) {
            this.MarkScopeNode(root, n.ChildAt(i), zs);
        }
    }
    // 整数平方根（向下取整）。
    static int ISqrt(int v) {
        if (v <= 0) { return 0; }
        int r = 0;
        int bit = 1073741824;
        int rest = v;
        while (bit > rest) { bit = bit / 4; }
        while (bit != 0) {
            if (rest >= r + bit) {
                rest = rest - r - bit;
                r = (r / 2) + bit;
            } else {
                r = r / 2;
            }
            bit = bit / 4;
        }
        return r;
    }
    // 窗口背景绘制服务（首次使用时创建）。
    private BackdropPainter backdropPainter;
    public BackdropPainter Backdrop {
        get {
            if (backdropPainter == null) { backdropPainter = new BackdropPainter(this); }
            return backdropPainter;
        }
    }

    // 将当前皮肤的窗口背景绘制到 [x,y,w,h]（见 BackdropPainter.RenderBackground）。
    public void RenderBackground(int x, int y, int w, int h, int slot) {
        this.Backdrop.RenderBackground(x, y, w, h, slot);
    }


    // 当前生效的背景效果类型：设置了绘制器覆盖项则用覆盖项，
    // 否则用皮肤自身的效果。0 = 无。
    int EffectiveFx() {
        if (fxKindOverride >= 0) { return fxKindOverride; }
        return theme != null ? theme.fx : 0;
    }
    bool FxActive() {
        return fxEnabled && this.EffectiveFx() != 0 && !glassNative
            && (shapeMode == 0 || this.BackdropShape() != null);
    }
    internal WindowShapeRegion BackdropShape() {
        if (shapeRegions == null) { return null; }
        WindowShapeRegion content = null;
        for (int i = 0; i < shapeRegions.Count; i = i + 1) {
            WindowShapeRegion region = shapeRegions[i];
            if (region.kind == WindowShapeKind.ShadowBand) { continue; }
            if (region.kind != WindowShapeKind.RoundedRect || content != null) { return null; }
            content = region;
        }
        return content;
    }
    void PaintBackdropFx(int phaseMs) {
        if (canvas == null || theme == null) { return; }
        int x = 0;
        int y = 0;
        int width = canvas.Width();
        int height = canvas.Height();
        if (shapeMode != 0) {
            WindowShapeRegion shape = this.BackdropShape();
            if (shape == null) { return; }
            PreparedShapeItem pixels = new PreparedShapeItem(shape, dpiScale);
            x = pixels.in1X1;
            y = pixels.in1Y1;
            width = pixels.in1X2 - x;
            height = pixels.in1Y2 - y;
        }
        BackdropFx.PaintFx(this, canvas, this.EffectiveFx(), x, y, width, height,
            phaseMs, theme, dpiScale);
    }
    void SetBackdropFx(bool on) {
        fxEnabled = on;
        fxSnapValid = false;
        fxTouched = null;
        fxTouchedFull = false;
        if (!on) { fxNextMs = -1; }
        this.Stats.NoteRedrawWhy("SetBackdropFx");
        this.RequestRedraw();
    }
    void SetFxKind(int kind) {
        if (fxKindOverride == kind) { return; }
        fxKindOverride = kind;
        fxSnapValid = false;
        fxTouched = null;
        fxTouchedFull = false;
        this.Stats.NoteRedrawWhy("SetFxKind");
        this.RequestRedraw();
    }
    bool IsSoftwareRender() {
        string be = Canvas.Backend();
        return be == null || be == "" || be == "cpu";
    }
    bool ShouldPauseFxForSoftwareOverlay() {
        return !Window.frozenTick && !this.freezeAnimClock
            && window != null && window.GetHandle() != 0
            && this.IsSoftwareRender() && this.HasActiveFxOverlays();
    }
    bool FxPresent() { return this.FxPresent(true); }
    bool FxPresent(bool present) {
        if (!fxSnapValid || !this.FxActive()) { fxNextMs = -1; return false; }
        if (present && this.ShouldPauseFxForSoftwareOverlay()) {
            displayFxPending = false;
            fxNextMs = -1;
            return true;
        }
        int perfFxT0 = 0;
        int perfFxRestoreT0 = 0;
        int perfFxRenderT0 = 0;
        int perfFxPresentT0 = 0;
        if (App.PerfOn()) {
            perfFxT0 = Window.GetTickUs();
            perfFxRestoreT0 = perfFxT0;
        }
        if (window == null || canvas == null || !window.IsVisible()) {
            fxNextMs = -1;
            return true;
        }
        Canvas fc = canvas;
        int cw = fc.Width();
        int chh = fc.Height();
        bool hasOverlays = this.HasActiveFxOverlays();
        bool fullRepair = hasOverlays || fxTouchedFull || fxTouched == null;
        bool ok;
        if (frameDiagnostics != null) {
            frameDiagnostics.FxRepair(fullRepair, fxTouched == null ? 0 : fxTouched.Count / 4);
        }
        if (fullRepair) {
            ok = fc.RestoreRect(0, 0, cw, chh, App.FxSnapSlot());
        } else {
            ok = true;
            int i = 0;
            while (ok && i + 3 < fxTouched.Count) {
                ok = fc.RestoreSubRect(fxTouched[i], fxTouched[i + 1],
                                       fxTouched[i + 2], fxTouched[i + 3],
                                       App.FxSnapSlot());
                i = i + 4;
            }
        }
        if (!ok) {
            fxSnapValid = false;
            return false;
        }
        if (App.PerfOn()) {
            Stats.FxRestoreUs = Stats.FxRestoreUs
                + (Window.GetTickUs() - perfFxRestoreT0);
            perfFxRenderT0 = Window.GetTickUs();
        }
        int fxPhaseMs = Window.GetTickMs();
        this.PaintBackdropFx(fxPhaseMs);
        fxFrameMs = fxPhaseMs;
        List<int> fresh = BackdropFx.TakeDamage();
        if (hasOverlays) { this.RenderFxOverlays(); }
        fxDamage = fresh;
        if (fullRepair) {
            fxTouched = fresh;
            fxTouchedFull = false;
            if (fresh != null && fresh.Count / 4 > 1024) { fxTouchedFull = true; }
        } else {
            if (fresh != null) {
                int i = 0;
                while (i + 3 < fresh.Count) {
                    fxTouched.Add(fresh[i]);
                    fxTouched.Add(fresh[i + 1]);
                    fxTouched.Add(fresh[i + 2]);
                    fxTouched.Add(fresh[i + 3]);
                    i = i + 4;
                }
            }
            long area = 0;
            int j = 0;
            while (j + 3 < fxTouched.Count) {
                area = area + (long)fxTouched[j + 2] * fxTouched[j + 3];
                j = j + 4;
            }
            if (fxTouched.Count / 4 > 1024
                || area * 2 > (long)cw * chh) {
                fxTouchedFull = true;
            }
        }
        if (fullRepair) {
            window.PresentDirty(0, 0, cw, chh);
        } else {
            this.Damage.MarkPresentDirty(fxTouched);
        }
        if (App.PerfOn()) { perfFxPresentT0 = Window.GetTickUs(); }
        if (present) {
            window.PresentSurface(canvas.surfaceId);
        } else {
            fxPagePending = true;
        }
        if (App.PerfOn()) {
            int perfFxEndUs = Window.GetTickUs();
            Stats.FxRenderUs = Stats.FxRenderUs
                + (perfFxPresentT0 - perfFxRenderT0);
            if (present) {
                Stats.FxPresentUs = Stats.FxPresentUs
                    + (perfFxEndUs - perfFxPresentT0);
                Stats.FxOnlyTicks = Stats.FxOnlyTicks + 1;
            }
            Stats.FxTickUs = Stats.FxTickUs + (perfFxEndUs - perfFxT0);
            Stats.FxTicks = Stats.FxTicks + 1;
            Stats.FxTickMs = Stats.FxTickMs
                + (perfFxEndUs - perfFxT0) / 1000;
            this.PerfMaybeFlushLoop(Window.GetTickMs());
        }
        if (present) {
            lastPresentMs = Window.GetTickMs();
            this.ScheduleFxFrame();
        }
        return true;
    }
    int FxIntervalMs() {
        if (shapeMode != 0) { return BackdropFx.IntervalMs(this.EffectiveFx()); }
        if (!Window.frozenTick && !this.freezeAnimClock && this.IsSoftwareRender()) {
            return Math.Max(BackdropFx.IntervalMs(this.EffectiveFx()), 100);
        }
        return (int)Math.Ceiling(1000.0 / frameCadence.Rate());
    }
    void ScheduleFxFrame() {
        if (this.ShouldPauseFxForSoftwareOverlay()) {
            displayFxPending = false;
            fxNextMs = -1;
            return;
        }
        if (shapeMode != 0 || (!Window.frozenTick && !this.freezeAnimClock && this.IsSoftwareRender())) {
            displayFxPending = false;
            int interval = this.FxIntervalMs();
            if (!fxSnapValid) { interval = Math.Max(interval, 120); }
            fxNextMs = Window.GetTickMs() + interval;
            return;
        }
        frameCadence.SetRate(window.RefreshRate());
        frameCadence.Begin(Stopwatch.GetMicroseconds());
        displayFxPending = window.RequestDisplayFrame();
        int wait = displayFxPending
            ? 100 : frameCadence.WaitMilliseconds(Stopwatch.GetMicroseconds());
        fxNextMs = Window.GetTickMs() + wait;
    }
}
