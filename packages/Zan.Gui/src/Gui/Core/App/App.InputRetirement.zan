using System.Collections.Generic;
namespace Gui;
public partial class App {
    List<InputRetirementToken> inputRetirements;
    public InputRetirementToken WatchInputRetirement(Control scope, InputRetirementObserver owner) {
        if (scope == null || owner == null) { return null; }
        this.PruneInputRetirements();
        if (inputRetirements == null) { inputRetirements = new List<InputRetirementToken>(); }
        InputRetirementToken token = new InputRetirementToken();
        token.host = this; token.scope = scope; token.owner = owner; token.active = true;
        inputRetirements.Add(token);
        return token;
    }
    void ForgetInputRetirement(InputRetirementToken token) {
        if (inputRetirements != null) { inputRetirements.Remove(token); }
    }
    void PruneInputRetirements() {
        if (inputRetirements == null) { return; }
        for (int i = inputRetirements.Count - 1; i >= 0; i = i - 1) {
            InputRetirementToken token = inputRetirements[i];
            if (!token.active || token.scope == null || token.owner == null) { token.Invalidate(); }
        }
    }
    List<InputRetirementToken> SnapshotInputRetirements(Control retired, Control next, bool rootChange) {
        List<InputRetirementToken> snapshot = new List<InputRetirementToken>();
        this.PruneInputRetirements();
        if (retired == null || inputRetirements == null) { return snapshot; }
        for (int i = 0; i < inputRetirements.Count; i = i + 1) {
            InputRetirementToken token = inputRetirements[i];
            Control scope = token.scope;
            if (scope != null && retired.ContainsHostedControl(scope)
                    && (!rootChange || next == null || !next.ContainsHostedControl(scope))) {
                snapshot.Add(token);
            }
        }
        return snapshot;
    }
    void NotifyInputRetirements(List<InputRetirementToken> snapshot, int rootTicket, bool rootChange) {
        for (int i = 0; i < snapshot.Count; i = i + 1) {
            if (rootChange && inputRootGeneration != rootTicket) { return; }
            snapshot[i].Notify();
        }
    }
}
