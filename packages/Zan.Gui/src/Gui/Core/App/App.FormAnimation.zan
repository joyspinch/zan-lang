using System;
using Gui.Backend;
namespace Gui;
public partial class App {
    #if WINDOWS && X86_64
    [DllImport("zan_gui")]
    static extern int zan_gui_region_capture(int id, int x, int y, int w, int h,
        ref int left, ref int top, ref int width, ref int height);
    [DllImport("zan_gui")]
    static extern void zan_gui_region_watch(int id);
    [DllImport("zan_gui")]
    static extern int zan_gui_region_seal(int id);
    [DllImport("zan_gui")]
    static extern int zan_gui_region_restore(int id);
    [DllImport("zan_gui")]
    static extern void zan_gui_region_cancel(int id);
    private bool formRegionCapture;
    private bool formRegionReady;
    private bool formRegionDue;
    private Canvas formRegionCanvas;
    private nint formRegionWindow;
    private int formRegionDpi;
    private int formRegionRoot;
    private int formRegionLayout;
    private int formRegionStructure;
    private int formRegionTheme;
    private int formRegionFrame;
    private int formRegionX;
    private int formRegionY;
    private int formRegionW;
    private int formRegionH;
    private int formRegionInterval;
    private bool formRegionDisplayCadence;
    private Action<Canvas, int> formRegionPaint;
    private Func<bool> formRegionCurrent;
    #endif
    internal void BeginFormRegionCapture(bool enabled) {
        #if WINDOWS && X86_64
        formRegionCapture = enabled && window.GetHandle() != 0 && shapeMode == 0
            && !this.FxActive() && automationSession == null;
        #endif
    }
    internal bool CapturingFormRegion() {
        #if WINDOWS && X86_64
        return formRegionCapture && formRegionCanvas == null && !canvas.SurfaceIdExposed();
        #else
        return false;
        #endif
    }
    bool CaptureFormRegion(int x, int y, int w, int h) {
        #if WINDOWS && X86_64
        if (!this.CapturingFormRegion() || !this.Damage.FrameDamageContains(x, y, w, h)) { return false; }
        int left = 0;
        int top = 0;
        int width = 0;
        int height = 0;
        if (zan_gui_region_capture(canvas.surfaceId, x, y, w, h,
            ref left, ref top, ref width, ref height) == 0) { return false; }
        formRegionCanvas = canvas;
        formRegionWindow = window.GetHandle();
        formRegionDpi = dpiScale;
        formRegionRoot = inputRootGeneration;
        formRegionLayout = hostLayoutRevision;
        formRegionStructure = Control.BindingStructureRevision();
        formRegionTheme = bgThemeGen;
        formRegionFrame = frameSeq;
        formRegionX = left;
        formRegionY = top;
        formRegionW = width;
        formRegionH = height;
        return true;
        #else
        return false;
        #endif
    }
    void WatchFormRegion(int interval, bool displayCadence, Action<Canvas, int> paint, Func<bool> current) {
        #if WINDOWS && X86_64
        if (formRegionCanvas == null) { return; }
        formRegionInterval = interval;
        formRegionDisplayCadence = displayCadence;
        formRegionPaint = paint;
        formRegionCurrent = current;
        zan_gui_region_watch(formRegionCanvas.surfaceId);
        #endif
    }
    internal void InvalidateFormRegionForScroll() {
        this.InvalidateFormPaintForScroll();
        #if WINDOWS && X86_64
        if (formRegionCanvas == null) { return; }
        if (formRegionReady) { this.RequestRedraw(); }
        this.ResetFormRegion();
        #endif
    }
    private void ResetFormRegion() {
        #if WINDOWS && X86_64
        if (formRegionCanvas != null && formRegionCanvas == canvas) {
            zan_gui_region_cancel(formRegionCanvas.surfaceId);
        }
        formRegionCapture = false;
        formRegionReady = false;
        formRegionDue = false;
        formRegionCanvas = null;
        formRegionPaint = null;
        formRegionCurrent = null;
        #endif
    }
    private void SealFormRegion() {
        #if WINDOWS && X86_64
        formRegionCapture = false;
        if (formRegionPaint == null) { return; }
        formRegionReady = !needsRedraw && !Damage.forceFullNext && animRequestCount == 1
            && this.FormRegionCurrent() && zan_gui_region_seal(canvas.surfaceId) != 0;
        if (!formRegionReady) { this.ResetFormRegion(); }
        #endif
    }
    #if WINDOWS && X86_64
    private bool FormRegionCurrent() {
        return isRunning && formRegionCanvas == canvas
            && !canvas.SurfaceIdExposed() && formRegionWindow == window.GetHandle()
            && formRegionDpi == dpiScale && formRegionRoot == inputRootGeneration
            && formRegionLayout == hostLayoutRevision && formRegionStructure == Control.BindingStructureRevision()
            && formRegionTheme == bgThemeGen && formRegionFrame == frameSeq
            && !reducedMotion && !this.HasOverlays() && !blocksInputBelow
            && !this.FxActive() && automationSession == null && nativeLayers.Count == 0
            && !this.ModelHostsNeedFrameSync() && formRegionCurrent();
    }
    #endif
    private bool QueueFormRegion(bool animationDue, bool frameWakeDue, bool fxDue) {
        #if WINDOWS && X86_64
        if (!formRegionReady || !animationDue || frameWakeDue || fxDue
            || needsRedraw || inputNeedsFrame || wheelScrollInput || Damage.forceFullNext
            || this.EventKind() != 0 || animRequestCount != 1) { return false; }
        formRegionDue = true;
        return true;
        #else
        return false;
        #endif
    }
    internal bool PresentFormRegion() {
        #if WINDOWS && X86_64
        if (!formRegionDue) { return false; }
        formRegionDue = false;
        if (needsRedraw) { return false; }
        this.SyncNativeDpi();
        int now = Window.GetTickMs();
        if (needsRedraw || inputNeedsFrame || wheelScrollInput || Damage.forceFullNext || window.DpiFramePending()
            || (wakeFrameNextMs >= 0 && now >= wakeFrameNextMs)
            || (fxNextMs >= 0 && now >= fxNextMs)
            || animRequestCount != 1 || this.EventKind() != 0 || !this.FormRegionCurrent()
            || window.ClientWidth() != canvas.Width() || window.ClientHeight() != canvas.Height()
            || !window.IsVisible() || zan_gui_region_restore(canvas.surfaceId) == 0) {
            this.ResetFormRegion();
            this.RequestRedraw();
            return false;
        }
        try {
            if (formRegionDisplayCadence) {
                frameCadence.SetRate(window.RefreshRate());
                frameCadence.Begin(Stopwatch.GetMicroseconds());
            }
            canvas.PushClip(formRegionX, formRegionY, formRegionW, formRegionH);
            try { formRegionPaint(canvas, now); }
            finally { canvas.PopClip(); }
            zan_gui_region_watch(canvas.surfaceId);
            if (zan_gui_region_seal(canvas.surfaceId) == 0) {
                this.ResetFormRegion();
                this.RequestRedraw();
                return false;
            }
            window.PresentDirty(formRegionX, formRegionY, formRegionW, formRegionH);
            window.PresentSurface(canvas.surfaceId);
            if (formRegionDisplayCadence) {
                animNextMs = this.DisplayFrameDueMs();
            } else {
                int elapsed = now % formRegionInterval;
                if (elapsed < 0) { elapsed = elapsed + formRegionInterval; }
                animNextMs = now + (formRegionInterval - elapsed);
            }
            frameCount = frameCount + 1;
            lastPresentMs = Window.GetTickMs();
            return true;
        } catch (Exception ex) {
            this.ResetFormRegion();
            this.RequestRedraw();
            this.NoteFrameError("form-region", ex.Message);
        }
        #endif
        return false;
    }
}
