using Gui.Backend;
namespace Gui;
public partial class App {
    private bool formPaintReady;
    private bool formPaintDue;
    private bool formPaintFrame;
    private Canvas formPaintCanvas;
    private int formPaintRoot;
    private int formPaintLayout;
    private int formPaintStructure;
    private int formPaintInput;
    private int formPaintTheme;
    private int formPaintScale;
    private int formPaintDpi;
    internal void InvalidateFormPaint() {
        formPaintReady = false;
        formPaintCanvas = null;
    }
    private void InvalidateFormPaintForScroll() {
        if (formPaintReady) { this.RequestRedraw(); }
    }
    private bool FormPaintGeometryCurrent() {
        return formPaintReady && formPaintCanvas == canvas
            && formPaintRoot == inputRootGeneration && formPaintLayout == hostLayoutRevision
            && formPaintStructure == Control.BindingStructureRevision()
            && formPaintInput == inputPreparationTicket && formPaintTheme == bgThemeGen
            && formPaintScale == metricsScale && formPaintDpi == dpiScale;
    }
    private bool FormPaintSupported() {
        List<AppHookFn> presentTails = App.PresentTails();
        if (window.GetHandle() == 0 || shapeMode != 0 || automationSession != null
            || this.HasOverlays() || blocksInputBelow || nativeLayers.Count != 0
            || retainedLayerWindows != null || retainedLayerQueue != null
            || (presentTails != null && presentTails.Count != 0)
            || this.FxActive() || this.ModelHostsNeedFrameSync()) { return false; }
        if (loopParticipants != null) {
            for (int i = 0; i < loopParticipants.Count; i = i + 1) {
                AppLoopRegistration ticket = loopParticipants[i];
                if (this.LiveLoopRegistration(ticket) && ticket.participant is AppPreparationParticipant) {
                    return false;
                }
            }
        }
        return true;
    }
    private void QueueFormPaint(bool animationDue, bool otherDue) {
        if (needsRedraw) { return; }
        formPaintDue = formPaintReady && animationDue && !otherDue
            && !inputNeedsFrame && !wheelScrollInput && this.EventKind() == 0
            && animRequestCount > 0 && animRequestCount == paintAnimRequestCount;
    }
    private void BeginFormPaint(AppLoopRegistration ticket) {
        formPaintFrame = false;
        bool due = formPaintDue;
        formPaintDue = false;
        if (!due || ticket == null || !partialPending) { return; }
        int now = Window.GetTickMs();
        if (!this.FormPaintGeometryCurrent() || !this.FormPaintSupported()
            || this.CurrentHostLayout() != ticket || this.EventKind() != 0
            || animRequestCount != paintAnimRequestCount
            || (wakeFrameNextMs >= 0 && wakeFrameNextMs <= now)
            || (wakeNextMs >= 0 && wakeNextMs <= now)) {
            partialPending = false;
            return;
        }
        formPaintFrame = true;
    }
    private void CheckFormPaintClip() {
        if (formPaintFrame && (!this.FormPaintGeometryCurrent() || inputNeedsFrame
            || wheelScrollInput || forceFullNext || !partialPending || needsRedraw
            || this.ForceFullFrames())) {
            formPaintFrame = false;
            partialPending = false;
        }
    }
    private void CommitFormPaintGeometry(AppLoopRegistration ticket) {
        if (ticket == null || needsRedraw || forceFullNext || !this.HostLayoutPrepared(ticket)
            || !this.FormPaintSupported()) {
            this.InvalidateFormPaint();
            return;
        }
        formPaintCanvas = canvas;
        formPaintRoot = inputRootGeneration;
        formPaintLayout = hostLayoutRevision;
        formPaintStructure = Control.BindingStructureRevision();
        formPaintInput = inputPreparationTicket;
        formPaintTheme = bgThemeGen;
        formPaintScale = metricsScale;
        formPaintDpi = dpiScale;
        formPaintReady = true;
    }
    internal bool SkipFormPaintBounds(int x, int y, int w, int h) {
        return formPaintFrame && partialFrame
            && (w <= 0 || h <= 0 || (long)x + w <= presentX || (long)y + h <= presentY
                || x >= (long)presentX + presentW || y >= (long)presentY + presentH);
    }
}
