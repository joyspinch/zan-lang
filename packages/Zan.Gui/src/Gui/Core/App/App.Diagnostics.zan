using System;
using System.Collections.Generic;
using Gui.Backend;
namespace Gui;
public partial class App {
    // 帧统计（诊断数据），见 FrameStats。
    public FrameStats Stats = new FrameStats();
    int lastPresentMs;
    FrameCadence frameCadence = new FrameCadence();
    bool displayAnimationPending;
    bool displayFxPending;
    int lastFullFrameMs;
    int lastInputMs;
    int lastInX;
    int lastInY;
    Dictionary<int, long> paintHashStore;
    AppFrameDiagnostics frameDiagnostics;
    public void SetFrameDiagnostics(AppFrameDiagnostics sink) {
        frameDiagnostics = sink;
        if (sink != null) { GuiFrameProfiler.SetPerfOn(true); }
    }
    public AppFrameDiagnostics FrameDiagnostics() { return frameDiagnostics; }
    public static bool PerfOn() { return GuiFrameProfiler.PerfOn(); }
    void PerfLoopTick(int t0, int path) {
        int now = Window.GetTickMs();
        Stats.Loops = Stats.Loops + 1;
        Stats.LoopMs = Stats.LoopMs + (now - t0);
        if (path == 0) { Stats.PollPath = Stats.PollPath + 1; }
        else if (path == 1) { Stats.AnimPath = Stats.AnimPath + 1; }
        else { Stats.WaitPath = Stats.WaitPath + 1; }
        int ek = window.EventKind();
        if (ek == 0) { Stats.EvNone = Stats.EvNone + 1; }
        else if (ek == 1) { Stats.EvMove = Stats.EvMove + 1; }
        else { Stats.EvOther = Stats.EvOther + 1; }
        this.PerfMaybeFlushLoop(now);
    }
    void PerfMaybeFlushLoop(int now) {
        AppFrameDiagnostics sink = frameDiagnostics;
        if (sink != null) { sink.FlushLoop(this, now); }
    }
    public bool ForceFullFrames() { return !partialFrames; }
    public bool PartialFrames() { return partialFrames; }
    internal bool AllowsSteadyDrawerPartial() {
        return window != null && window.GetHandle() != 0
            && themeDrawer != null && overlayHost != null
            && overlayHost.ActiveRoot() == themeDrawer
            && overlayHost.Depth() == 1
            && overlays.Count == 0
            && !blocksInputBelow && !inputBlockPrevious;
    }
    public bool AllowsPartialDamage() {
        return partialFrames || this.AllowsSteadyDrawerPartial();
    }
    public bool AllowsHoverPartialDamage(Control c) {
        return this.AllowsPartialDamage() && tooltipText == "" && c != null && c.Tip == "";
    }
    public bool IsDrawerOpaquePartial() { return drawerOpaquePartial; }
    public bool IsOpaqueDrawerPartialSurface(Control c) {
        return drawerOpaquePartial && c != null && c == themeDrawerSurface;
    }
    public void SetPartialFrames(bool on) {
        this.partialFrames = on;
        if (!on) {
            Damage.partialPending = false;
            needsRedraw = true;
        }
    }
    // End commits only a successfully painted segment. Always Restore in finally;
    // an exceptional segment must not replace its last successful fingerprint.
    public void CommitPaintHash(PaintHashToken token, int id, int x, int y, int w, int h) {
        long cur = PaintHash.Acc;
        PaintHash.Restore(token);
        if (!token.armed) { return; }
        if (paintHashStore == null) { paintHashStore = new Dictionary<int, long>(); }
        long prev = 0;
        bool had = paintHashStore.TryGetValue(id, out prev);
        if (had && prev == cur) { return; }
        if (had) { paintHashStore.Remove(id); }
        paintHashStore.Add(id, cur);
        if (!Damage.partialFrame || this.Damage.FrameDamageContains(x, y, w, h)) { return; }
        this.Damage.NoteDamage(x, y, w, h);
    }
    public int RenderBackendMode() { return renderBackendMode; }
    public string RenderBackendName() { return Canvas.Backend(); }
    public int SetRenderBackend(int mode) {
        this.renderBackendMode = mode;
        int got = Canvas.SetBackend(mode);
        Damage.forceFullNext = true;
        needsRedraw = true;
        return got;
    }
    public static int FxSnapSlot() { return 384; }
    public static string RasterLine(int frames) {
        List<string> names = new List<string>{
            "fill",
            "blend",
            "grad",
            "round",
            "radial",
            "blur",
            "blurhit",
            "img",
            "snap",
            "restore",
            "glyph",
            "bsimd",
            "bscalar" };
        string line = "";
        for (int i = 0; i < names.Count; i = i + 1) {
            int calls = Canvas.RasterStat(i, 0);
            int kpx = Canvas.RasterStat(i, 1);
            if (calls > 0 || kpx > 0) {
                line = line + names[i] + "=" + Convert.ToString(calls / frames)
                    + "/" + Convert.ToString(kpx / frames) + "kpx ";
            }
        }
        int styleN = Style.StatRead(0);
        int styleHit = Style.StatRead(1);
        line = line + "style=" + Convert.ToString(styleN / frames) + "/"
            + Convert.ToString((styleN - styleHit) / frames) + "miss ";
        for (int rank = 0; rank < 6; rank = rank + 1) {
            int kpx = Canvas.RasterTopBlend(rank, 0);
            int bx = Canvas.RasterTopBlend(rank, 1);
            int by = Canvas.RasterTopBlend(rank, 2);
            int bw = Canvas.RasterTopBlend(rank, 3);
            int ba = Canvas.RasterTopBlend(rank, 5);
            int bh = Canvas.RasterTopBlend(rank, 4);
            if (kpx > 0) {
                line = line + "top" + Convert.ToString(rank) + "="
                    + Convert.ToString(kpx) + "kpx@" + Convert.ToString(bx)
                    + "," + Convert.ToString(by) + "+" + Convert.ToString(bw)
                    + "x" + Convert.ToString(bh) + "a" + Convert.ToString(ba)
                    + " ";
            }
        }
        for (int rank = 0; rank < 6; rank = rank + 1) {
            int kpx = Canvas.RasterTopFill(rank, 0);
            int fx = Canvas.RasterTopFill(rank, 1);
            int fy = Canvas.RasterTopFill(rank, 2);
            int fw = Canvas.RasterTopFill(rank, 3);
            int fh = Canvas.RasterTopFill(rank, 4);
            if (kpx > 0) {
                line = line + "op" + Convert.ToString(rank) + "="
                    + Convert.ToString(kpx) + "kpx@" + Convert.ToString(fx)
                    + "," + Convert.ToString(fy) + "+" + Convert.ToString(fw)
                    + "x" + Convert.ToString(fh) + " ";
            }
        }
        return line;
    }
    void RecordFramePerf(int beginMs, int preMs, int endMs, bool partialFrame) {
        AppFrameDiagnostics sink = frameDiagnostics;
        if (sink != null) { sink.RecordFrame(this, beginMs, preMs, endMs, partialFrame); }
    }
}
public class WhyTally {
    public string why;
    public int n;
    public WhyTally(string why) {
        this.why = why;
        this.n = 1;
    }
}
