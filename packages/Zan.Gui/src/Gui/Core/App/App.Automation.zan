namespace Gui;

public partial class App {
    AppAutomationSession automationSession;

    public void SetAutomationSession(AppAutomationSession session) {
        this.CheckLoopThread();
        if (automationSession == session) { return; }
        AppAutomationSession previous = automationSession;
        automationSession = session;
        if (previous != null) { previous.Stopped(this); }
    }

    public AppAutomationSession AutomationSession() { return automationSession; }

    // Optional backends observe the current host tree without retaining a global root.
    public Control AutomationRoot() {
        AppLoopRegistration ticket = this.CurrentHostLayout();
        if (ticket != null) {
            Control tree = ticket.owner as Control;
            if (tree != null) { return tree; }
        }
        return rootControl;
    }

    void AutomationShown() {
        AppAutomationSession session = automationSession;
        if (session != null) { session.Shown(this); }
    }

    void TickAutomation() {
        AppAutomationSession session = automationSession;
        if (session != null) { session.Tick(this); }
    }

    void AutomationPresented() {
        AppAutomationSession session = automationSession;
        if (session != null) { session.Presented(this); }
    }

    internal void TraceFullPresent(int stage, bool enter) {
        AppAutomationSession session = automationSession;
        if (session != null) { session.TracePresent(this, stage, enter); }
    }

    bool AutomationPreparationPending() {
        AppAutomationSession session = automationSession;
        return session != null && session.PreparationReasonPending(this);
    }

    void TraceAutomationPreparation(string reason) {
        AppAutomationSession session = automationSession;
        if (session != null) { session.TracePreparationReason(this, reason); }
    }
}
