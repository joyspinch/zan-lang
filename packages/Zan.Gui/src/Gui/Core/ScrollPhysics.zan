using System;
namespace Gui.Core;
public class FlingState {
    public float velocity;
    public FlingState(float v) { this.velocity = ScrollPhysics.IsFinite(v) ? v : 0.0f; }
    public float Step(int dtMs) {
        if (dtMs <= 0) { return 0.0f; }
        if (!ScrollPhysics.IsFinite(this.velocity)) { this.velocity = 0.0f; return 0.0f; }
        float dtSec = (float)dtMs / 1000.0f;
        if (dtSec > 0.1f) { dtSec = 0.1f; }
        // 帧率无关指数衰减：60Hz 与 144Hz 下的总滑行距离一致。
        float rate = ScrollPhysics.Friction * 1000.0f;
        float decay = (float)Math.Exp((double)(-rate * dtSec));
        float nextV = this.velocity * decay;
        float delta = (this.velocity + nextV) * 0.5f * dtSec;
        if (!ScrollPhysics.IsFinite(nextV) || !ScrollPhysics.IsFinite(delta)) {
            this.velocity = 0.0f;
            return 0.0f;
        }
        this.velocity = nextV;
        float absV = this.velocity < 0.0f ? (0.0f - this.velocity) : this.velocity;
        if (absV < ScrollPhysics.MinVelocity) { this.velocity = 0.0f; }
        return delta;
    }
}
public class SpringState {
    public float displacement;
    public float velocity;
    public SpringState(float disp) {
        this.displacement = ScrollPhysics.IsFinite(disp) ? disp : 0.0f;
        this.velocity = 0.0f;
    }
    public bool Step(int dtMs) {
        if (dtMs <= 0) { return false; }
        if (!ScrollPhysics.IsFinite(this.displacement) || !ScrollPhysics.IsFinite(this.velocity)) {
            this.displacement = 0.0f;
            this.velocity = 0.0f;
            return true;
        }
        float totalDt = (float)dtMs / 1000.0f;
        if (totalDt > 0.05f) { totalDt = 0.05f; }
        // 按 4ms 固定子步做半隐式积分，确保大 dt 下依然无发散且收敛平滑。
        int steps = (int)(totalDt / 0.004f) + 1;
        if (steps > 16) { steps = 16; }
        float dt = totalDt / (float)steps;
        for (int i = 0; i < steps; i = i + 1) {
            float force = (0.0f - ScrollPhysics.SpringStiffness) * this.displacement
                - (ScrollPhysics.SpringDamping * this.velocity);
            this.velocity = this.velocity + force * dt;
            this.displacement = this.displacement + this.velocity * dt;
            if (!ScrollPhysics.IsFinite(this.displacement) || !ScrollPhysics.IsFinite(this.velocity)) {
                this.displacement = 0.0f;
                this.velocity = 0.0f;
                return true;
            }
        }
        float absD = this.displacement < 0.0f ? (0.0f - this.displacement) : this.displacement;
        float absV = this.velocity < 0.0f ? (0.0f - this.velocity) : this.velocity;
        if (absD < 0.5f && absV < 5.0f) {
            this.displacement = 0.0f;
            this.velocity = 0.0f;
            return true;
        }
        return false;
    }
}
public class ScrollPhysics {
    public const float Friction = 0.0025f;
    public const float MinVelocity = 15.0f;
    public const float SpringStiffness = 180.0f;
    public const float SpringDamping = 22.0f;
    internal static bool IsFinite(float v) { return v == v && (v - v) == 0.0f; }
    public static float RubberBandClamp(float overRaw, float dimension) {
        if (!ScrollPhysics.IsFinite(overRaw)) { return 0.0f; }
        if (!ScrollPhysics.IsFinite(dimension) || dimension <= 0.0f) { dimension = 300.0f; }
        bool neg = overRaw < 0.0f;
        float absOver = neg ? (0.0f - overRaw) : overRaw;
        float factor = (absOver * 0.55f) / dimension;
        float rubber = (1.0f - (1.0f / (factor + 1.0f))) * dimension;
        return neg ? (0.0f - rubber) : rubber;
    }
    public static float StepFlingState(FlingState state, int dtMs) {
        if (state == null) { return 0.0f; }
        return state.Step(dtMs);
    }
    public static bool StepSpringState(SpringState state, int dtMs) {
        if (state == null) { return false; }
        return state.Step(dtMs);
    }
}
