using System;
namespace Gui.Core;
public class FlingState {
    public float velocity;
    public FlingState(float v) { this.velocity = v; }
    public float Step(int dtMs) {
        if (dtMs <= 0) { return 0.0f; }
        float dtSec = (float)dtMs / 1000.0f;
        float delta = this.velocity * dtSec;
        float decay = 1.0f - (ScrollPhysics.Friction * (float)dtMs);
        if (decay < 0.0f) { decay = 0.0f; }
        this.velocity = this.velocity * decay;
        float absV = this.velocity < 0.0f ? (0.0f - this.velocity) : this.velocity;
        if (absV < ScrollPhysics.MinVelocity) { this.velocity = 0.0f; }
        return delta;
    }
}
public class SpringState {
    public float displacement;
    public float velocity;
    public SpringState(float disp) {
        this.displacement = disp;
        this.velocity = 0.0f;
    }
    public bool Step(int dtMs) {
        if (dtMs <= 0) { return false; }
        float dt = (float)dtMs / 1000.0f;
        if (dt > 0.05f) { dt = 0.05f; } // 防止极端大卡顿产生数值发散
        float force = (0.0f - ScrollPhysics.SpringStiffness) * this.displacement - (ScrollPhysics.SpringDamping * this.velocity);
        this.velocity = this.velocity + force * dt;
        this.displacement = this.displacement + this.velocity * dt;
        float absD = this.displacement < 0.0f ? (0.0f - this.displacement) : this.displacement;
        float absV = this.velocity < 0.0f ? (0.0f - this.velocity) : this.velocity;
        if (absD < 0.5f && absV < 5.0f) {
            this.displacement = 0.0f;
            this.velocity = 0.0f;
            return true; // 已经静止
        }
        return false;
    }
}
public class ScrollPhysics {
    public const float Friction = 0.0025f;
    public const float MinVelocity = 15.0f;
    public const float SpringStiffness = 180.0f;
    public const float SpringDamping = 22.0f;
    public static float RubberBandClamp(float overRaw, float dimension) {
        if (dimension <= 0.0f) { dimension = 300.0f; }
        bool neg = overRaw < 0.0f;
        float absOver = neg ? (0.0f - overRaw) : overRaw;
        float factor = (absOver * 0.55f) / dimension;
        float rubber = (1.0f - (1.0f / (factor + 1.0f))) * dimension;
        return neg ? (0.0f - rubber) : rubber;
    }
    public static float StepFlingState(FlingState state, int dtMs) {
        if (state == null) { return 0.0f; }
        return state.Step(dtMs);
    }
    public static bool StepSpringState(SpringState state, int dtMs) {
        if (state == null) { return false; }
        return state.Step(dtMs);
    }
}
