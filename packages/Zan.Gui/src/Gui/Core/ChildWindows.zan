using System;
using System.Collections.Generic;
using Gui;
using Gui.Backend;
namespace Gui;
internal class ChildWindowManager {
    internal List<ChildWindowBase> wins;
    internal IModalWindow picker;
    internal long routedSeq;
    internal bool routedHandled;
    internal List<IModalWindow> pickers;
    internal int renderBudgetMs = 50;
    internal int slowRenderWarnMs = 200;
    internal Action<string> slowSink = null;
    internal int renderCursor = 0;
    internal int lastRenderMs = 0;
    internal int slowRenderCount = 0;
    internal int lastDeferred = 0;
}
public class ChildWindows {
    static ChildWindowManager Mgr() {
        GuiCoreState state = GuiCoreState.Current();
        if (state.childWindows == null) { state.childWindows = new ChildWindowManager(); }
        return state.childWindows;
    }
    // 单帧子窗渲染总预算（毫秒）。0 = 不限（回退到"每帧全画"）。
    public static void SetRenderBudgetMs(int ms) { ChildWindows.Mgr().renderBudgetMs = ms < 0 ? 0 : ms; }
    // 当前单帧子窗渲染预算（毫秒）。
    public static int RenderBudgetMs() { return ChildWindows.Mgr().renderBudgetMs; }
    // 单个子窗渲染的耗时告警阈值（毫秒）。0 = 不告警。
    public static void SetSlowRenderWarnMs(int ms) { ChildWindows.Mgr().slowRenderWarnMs = ms < 0 ? 0 : ms; }
    // 当前耗时告警阈值（毫秒）。
    public static int SlowRenderWarnMs() { return ChildWindows.Mgr().slowRenderWarnMs; }
    // 接管告警出口（传 null 恢复打控制台）。
    public static void SetSlowRenderSink(Action<string> s) { ChildWindows.Mgr().slowSink = s; }
    // 最近一次子窗渲染耗时（毫秒）。
    public static int LastRenderMs() { return ChildWindows.Mgr().lastRenderMs; }
    // 超阈值告警累计次数。
    public static int SlowRenderCount() { return ChildWindows.Mgr().slowRenderCount; }
    // 最近一帧因预算用尽而推迟的子窗数。
    public static int LastDeferredCount() { return ChildWindows.Mgr().lastDeferred; }
    // 子窗渲染耗时记账 + 超阈值告警。告警格式与 UiWatchdog 一致，
    // 同一套 grep 规则就能把"谁把帧堵死了"捞出来。
    static void ReportRenderCost(ChildWindowBase w, int ms) {
        ChildWindowManager m = ChildWindows.Mgr();
        m.lastRenderMs = ms;
        int warn = m.slowRenderWarnMs;
        if (warn <= 0 || ms < warn) { return; }
        m.slowRenderCount = m.slowRenderCount + 1;
        string title = "";
        if (w != null) { title = w.Title(); }
        string msg = "UIWATCHDOG stall stage=child-window blocked=" + "" + ms
            + "ms title=" + title;
        if (m.slowSink != null) { m.slowSink(msg); return; }
        Console.WriteLine(msg);
    }
    // 注册表（惰性创建）。
    static List<ChildWindowBase> All() {
        ChildWindowManager m = ChildWindows.Mgr();
        if (m.wins == null) { m.wins = new List<ChildWindowBase>(); }
        return m.wins;
    }
    // 把窗口加入主循环驱动队列（OpenHost 自动调用）。
    static void Register(ChildWindowBase w) {
        if (!ChildWindows.All().Contains(w)) {
            List<ChildWindowBase> next = new List<ChildWindowBase>();
            foreach (ChildWindowBase current in ChildWindows.All()) { next.Add(current); }
            next.Add(w);
            ChildWindows.Mgr().wins = next;
        }
    }
    static void ApplyLanguage(string lang) {
        foreach (ChildWindowBase w in ChildWindows.All()) {
            if (!w.IsOpen()) { continue; }
            w.OnLanguageChanged(lang);
            if (w.host != null) { w.host.SetWindowTitle(w.Title()); }
        }
    }
    static void RegisterPicker(IModalWindow p) { ChildWindows.Mgr().picker = p; }
    static bool RegisterComponentPicker(IModalWindow p) {
        ChildWindowManager m = ChildWindows.Mgr();
        if (m.pickers == null) { m.pickers = new List<IModalWindow>(); }
        if (m.pickers.Contains(p)) { return false; }
        m.pickers.Add(p);
        return true;
    }
    static void Prune() {
        List<ChildWindowBase> all = ChildWindows.All();
        List<ChildWindowBase> keep = new List<ChildWindowBase>();
        foreach (ChildWindowBase w in all) {
            if (w.IsOpen()) { keep.Add(w); }
            else { w.Teardown(); }
        }
        ChildWindows.Mgr().wins = keep;
    }
    static bool AnyOpen() {
        foreach (ChildWindowBase w in ChildWindows.All()) {
            if (w.IsOpen()) { return true; }
        }
        return false;
    }
    static bool Wants() {
        foreach (ChildWindowBase w in ChildWindows.All()) {
            if (w.NeedsRedraw()) { return true; }
        }
        if (ChildWindows.AnyPickerWants()) { return true; }
        return false;
    }
    static bool AnyPickerWants() {
        ChildWindowManager m = ChildWindows.Mgr();
        if (m.picker != null && m.picker.IsOpen() && m.picker.NeedsRedraw()) {
            return true;
        }
        if (m.pickers == null) { return false; }
        for (int i = 0; i < m.pickers.Count; i = i + 1) {
            IModalWindow p = m.pickers[i];
            if (p.IsOpen() && p.NeedsRedraw()) { return true; }
        }
        return false;
    }
    static bool AnyPickerOpen() {
        ChildWindowManager m = ChildWindows.Mgr();
        if (m.picker != null && m.picker.IsOpen()) { return true; }
        if (m.pickers == null) { return false; }
        for (int i = 0; i < m.pickers.Count; i = i + 1) {
            if (m.pickers[i].IsOpen()) { return true; }
        }
        return false;
    }
    static App LoopRoot(App app) {
        foreach (ChildWindowBase child in ChildWindows.All()) {
            if (!child.IsOpen() || child.host != app || child.parentApp == null) { continue; }
            return ChildWindows.LoopRoot(child.parentApp);
        }
        return app;
    }
    static int LoopDeadline(App parent, int deadline) {
        foreach (ChildWindowBase child in ChildWindows.All()) {
            if (!child.IsOpen() || child.parentApp != parent) { continue; }
            int due = child.host.MinLoopDeadline();
            due = ChildWindows.LoopDeadline(child.host, due);
            if (due >= 0 && (deadline < 0 || due < deadline)) { deadline = due; }
        }
        return deadline;
    }
    static void WakeLoopParent(App childApp) {
        foreach (ChildWindowBase child in ChildWindows.All()) {
            if (!child.IsOpen() || child.host != childApp) { continue; }
            App parent = child.parentApp;
            if (parent != null) { parent.WakeLoopParticipants(); }
            return;
        }
    }
    static void ServiceLoopParticipants(App parent, int turn, int now) {
        List<ChildWindowBase> snapshot = ChildWindows.All();
        foreach (ChildWindowBase child in snapshot) {
            if (!child.IsOpen() || child.parentApp != parent) { continue; }
            child.host.SyncSurface();
            child.host.DrainPosts();
            if (!child.IsOpen() || !child.host.isRunning) { continue; }
            child.host.TickLoopParticipantsForTurn(turn, now);
            if (child.IsOpen()) { ChildWindows.ServiceLoopParticipants(child.host, turn, now); }
        }
    }
    static int Deadline(int deadline) {
        foreach (ChildWindowBase w in ChildWindows.All()) {
            int a = w.AnimNextMs();
            if (a >= 0 && (deadline < 0 || a < deadline)) { deadline = a; }
            int f = w.FxNextMs();
            if (f >= 0 && (deadline < 0 || f < deadline)) { deadline = f; }
        }
        return deadline;
    }
    static bool PumpPickers(App main) {
        ChildWindowManager m = ChildWindows.Mgr();
        bool woken = false;
        if (m.picker != null && m.picker.IsOpen()) {
            if (m.picker.NeedsRedraw()) {
                main.RequestRedraw();
                woken = true;
            }
        }
        if (m.pickers == null) { return woken; }
        for (int i = 0; i < m.pickers.Count; i = i + 1) {
            IModalWindow p = m.pickers[i];
            if (!p.IsOpen()) { continue; }
            if (p.NeedsRedraw() && !woken) {
                main.RequestRedraw();
                woken = true;
            }
        }
        return woken;
    }
    static void PrunePickers() {
        ChildWindowManager m = ChildWindows.Mgr();
        if (m.pickers == null) { return; }
        List<IModalWindow> keep = new List<IModalWindow>();
        for (int i = 0; i < m.pickers.Count; i = i + 1) {
            IModalWindow p = m.pickers[i];
            if (p.IsOpen()) { keep.Add(p); }
        }
        m.pickers = keep;
    }
    static void TickDue(int now) {
        foreach (ChildWindowBase w in ChildWindows.All()) {
            w.TickInputGestures();
            int a = w.AnimNextMs();
            int f = w.FxNextMs();
            if ((a >= 0 && now >= a) || (f >= 0 && now >= f)) { w.host.RequestRedraw(); }
        }
    }
    static bool RouteEvent(nint hwnd) {
        ChildWindowManager m = ChildWindows.Mgr();
        long seq = Window.EventSeqGlobal();
        if (seq == m.routedSeq) { return m.routedHandled; }
        m.routedSeq = seq;
        m.routedHandled = false;
        foreach (ChildWindowBase w in ChildWindows.All()) {
            if (w.OwnsWindow(hwnd)) {
                w.ApplyEvent(hwnd);
                m.routedHandled = true;
                if (w.NeedsRedraw()) { w.Render(); }
                return true;
            }
        }
        if (m.picker != null
            && m.picker.OwnsWindow(hwnd)) {
            m.picker.ApplyEvent(hwnd);
            m.routedHandled = true;
            if (m.picker.NeedsRedraw()) { m.picker.RenderWindow(); }
            return true;
        }
        if (m.pickers != null) {
            for (int i = 0; i < m.pickers.Count; i = i + 1) {
                IModalWindow p = m.pickers[i];
                if (p.OwnsWindow(hwnd)) {
                    p.ApplyEvent(hwnd);
                    m.routedHandled = true;
                    if (p.NeedsRedraw()) { p.RenderWindow(); }
                    return true;
                }
            }
        }
        return false;
    }
    static bool PaintForResize(nint hwnd) {
        foreach (ChildWindowBase w in ChildWindows.All()) {
            if (w.OwnsWindow(hwnd)) {
                w.host.SyncSurface();
                w.Render();
                return true;
            }
        }
        return false;
    }
    static void PumpAll() {
        ChildWindowManager m = ChildWindows.Mgr();
        int now = Window.GetTickMs();
        ChildWindows.TickDue(now);
        ChildWindows.PumpChildren();
        if (m.picker != null) {
            if (m.picker.IsOpen() && m.picker.NeedsRedraw()) {
                m.picker.RenderWindow();
            }
        }
        if (m.pickers != null) {
            for (int i = 0; i < m.pickers.Count; i = i + 1) {
                IModalWindow p = m.pickers[i];
                if (p.IsOpen()) { p.RenderWindow(); }
            }
        }
        ChildWindows.Prune();
        ChildWindows.PrunePickers();
    }
    static void PumpChildren() {
        ChildWindowManager m = ChildWindows.Mgr();
        List<ChildWindowBase> all = ChildWindows.All();
        int n = all.Count;
        m.lastDeferred = 0;
        if (n == 0) { return; }
        int start = m.renderCursor;
        if (start < 0 || start >= n) { start = 0; }
        long budgetUs = (long)m.renderBudgetMs * 1000;
        long spentUs = 0;
        bool deferred = false;
        for (int k = 0; k < n; k = k + 1) {
            int i = (start + k) % n;
            ChildWindowBase w = all[i];
            if (w == null || !w.IsOpen()) { continue; }
            if (budgetUs > 0 && spentUs >= budgetUs) {
                m.renderCursor = i;
                int left = 0;
                for (int j = k; j < n; j = j + 1) {
                    ChildWindowBase rest = all[(start + j) % n];
                    if (rest != null && rest.IsOpen()) { left = left + 1; }
                }
                m.lastDeferred = left;
                deferred = true;
                break;
            }
            w.Render();
            spentUs = spentUs + w.LastRenderUs();
        }
        if (!deferred) { m.renderCursor = 0; }
    }
    static void FoldDeadlines(App main) {
        int dl = ChildWindows.Deadline(-1);
        if (dl >= 0) { main.RequestWakeAt(dl); }
        int now = Window.GetTickMs();
        if (ChildWindows.AnyOpen() || ChildWindows.AnyPickerOpen()) { main.RequestWakeAt(now + 16); }
    }
    static void FollowSkin(int i) {
        foreach (ChildWindowBase w in ChildWindows.All()) { w.FollowSkin(i); }
    }
    static void FollowOpacity(int percent) {
        foreach (ChildWindowBase w in ChildWindows.All()) {
            w.FollowOpacity(percent);
        }
    }
    static void FollowCaptionTips(App main) {
        foreach (ChildWindowBase w in ChildWindows.All()) {
            w.FollowCaptionTips(main);
        }
    }
    static void FollowWallpaper(string path, int opacity) {
        foreach (ChildWindowBase w in ChildWindows.All()) {
            w.FollowWallpaper(path, opacity);
        }
    }
    static void RequestRedrawAll() {
        foreach (ChildWindowBase w in ChildWindows.All()) { w.RequestRedraw(); }
    }
}
