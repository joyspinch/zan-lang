using System;
namespace Gui;
public class UiCommand {
    private weak UiCommandOwner owner;
    public int Key;
    public string Text;
    public int ShortcutKey;
    public int ShortcutModifiers;
    public int ShortcutEvent;
    public UiCommand(UiCommandOwner owner, int key, string text) {
        this.owner = owner;
        this.Key = key;
        this.Text = text;
        this.ShortcutKey = 0;
        this.ShortcutModifiers = 0;
        this.ShortcutEvent = 5;
    }
    public void Shortcut(int key, int modifiers, int eventKind) {
        this.ShortcutKey = key;
        this.ShortcutModifiers = modifiers;
        this.ShortcutEvent = eventKind;
    }
    public bool CanExecute() {
        UiCommandOwner current = this.owner;
        int key = this.Key;
        if (current == null || !current.CanExecuteCommand(key)) { return false; }
        return this.owner == current && this.Key == key;
    }
    public bool IsChecked() {
        UiCommandOwner current = this.owner;
        int key = this.Key;
        if (current == null || !current.IsCommandChecked(key)) { return false; }
        return this.owner == current && this.Key == key;
    }
    public bool TryExecute() {
        UiCommandOwner current = this.owner;
        int key = this.Key;
        if (current == null || !current.CanExecuteCommand(key)) { return false; }
        if (this.owner != current || this.Key != key) { return false; }
        current.ExecuteCommand(key);
        return true;
    }
    public void Invoke() { this.TryExecute(); }
    public void Bind(UiEvent endpoint) { if (endpoint != null) { endpoint.Add(this.Invoke); } }
    public bool HandleShortcut(int eventKind, int key, int modifiers) {
        if (this.ShortcutKey == 0 || eventKind != this.ShortcutEvent
            || key != this.ShortcutKey || modifiers != this.ShortcutModifiers) { return false; }
        this.TryExecute();
        return true;
    }
    public void Detach() { this.owner = null; }
}
