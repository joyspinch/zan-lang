    // 启用可选帧分析器（ZAN_FRAME_PROF=1）时为真。
    public static bool PerfOn() {
        if (App.perfMode == 0) {
            App.perfMode = 2;
            if (Interop.EnvVar("ZAN_FRAME_PROF") == "1") { App.perfMode = 1; }
        }
        return App.perfMode == 1;
    }

    // 帧分析器的空闲侧：记一圈事件循环走了哪条等待路径、被什么
    // 唤醒、在循环体外花了多少毫秒，每 2 秒往同一个日志追一行。
    void PerfLoopTick(int t0, int path) {
        int now = Window.GetTickMs();
        perfLoops = perfLoops + 1;
        perfLoopMs = perfLoopMs + (now - t0);
        if (path == 0) { perfPollPath = perfPollPath + 1; }
        else if (path == 1) { perfAnimPath = perfAnimPath + 1; }
        else { perfWaitPath = perfWaitPath + 1; }
        int ek = window.EventKind();
        if (ek == 0) { perfEvNone = perfEvNone + 1; }
        else if (ek == 1) { perfEvMove = perfEvMove + 1; }
        else { perfEvOther = perfEvOther + 1; }
        this.PerfMaybeFlushLoop(now);
    }

    // 把累计的循环/特效计数按 2 秒窗口落盘。除了事件循环本身，
    // 纯特效 tick（FxPresent 在等待循环内就地呈现，不经过
    // PerfLoopTick）也调用这里，否则安静的效果层会让日志整段
    // 缺行，看起来像循环根本没在跑。
    void PerfMaybeFlushLoop(int now) {
        if (perfLoopAt == 0) { perfLoopAt = now; }
        int span = now - perfLoopAt;
        if (span < 2000) { return; }
        File.AppendAllText("zan_frame_perf.log",
            "loops=" + Convert.ToString(perfLoops)
            + " over_ms=" + Convert.ToString(span)
            + " frames=" + Convert.ToString(perfFrames)
            + " wait_ms=" + Convert.ToString(perfLoopMs)
            + " path_poll=" + Convert.ToString(perfPollPath)
            + " path_anim=" + Convert.ToString(perfAnimPath)
            + " path_block=" + Convert.ToString(perfWaitPath)
            + " ev_none=" + Convert.ToString(perfEvNone)
            + " ev_move=" + Convert.ToString(perfEvMove)
            + " ev_other=" + Convert.ToString(perfEvOther)
            + " fx_ticks=" + Convert.ToString(perfFxTicks)
            + " fx_only=" + Convert.ToString(perfFxOnlyTicks)
            + " fx_tick_ms=" + Convert.ToString(perfFxTickMs)
            + " fx_tick_us=" + Convert.ToString(perfFxTickUs)
            + " fx_restore_us=" + Convert.ToString(perfFxRestoreUs)
            + " fx_render_us=" + Convert.ToString(perfFxRenderUs)
            + " fx_present_us=" + Convert.ToString(perfFxPresentUs)
            + " fx_kind=" + Convert.ToString(this.EffectiveFx())
            + " anim_armed=" + Convert.ToString(animNextMs)
            + " fx_armed=" + Convert.ToString(fxNextMs) + "\n");
        perfLoopAt = now;
        perfLoops = 0;
        perfLoopMs = 0;
        perfPollPath = 0;
        perfAnimPath = 0;
        perfWaitPath = 0;
        perfEvNone = 0;
        perfEvMove = 0;
        perfEvOther = 0;
        perfFxTicks = 0;
        perfFxOnlyTicks = 0;
        perfFxTickMs = 0;
        perfFxTickUs = 0;
        perfFxRestoreUs = 0;
        perfFxRenderUs = 0;
        perfFxPresentUs = 0;
    }

    // 宿主在一大段绘制里埋的标记点：把自上一个标记以来的时间
    // 记到 `name` 头上（空名字只重置起点），分析器关着时不做事。
    public void PerfMark(string name) {
        if (!App.PerfOn()) { return; }
        int now = Window.GetTickUs();
        int d = now - markAtUs;
        bool first = markAtUs == 0;
        markAtUs = now;
        if (name != "") { markNow = name; }
        if (name == "" || first) { return; }
        if (d > phaseMarkTopUs) {
            phaseMarkTopUs = d;
            phaseMarkTop = name;
        }
    }

    public void PerfScopeBegin(int id) {
        if (!App.PerfOn()) { return; }
        scopeId = id;
        scopeAtUs = Window.GetTickUs();
    }

    public void PerfScopeEnd(int id) {
        if (!App.PerfOn()) { return; }
        int now = Window.GetTickUs();
        int d = now - scopeAtUs;
        scopeEndUs = now;
        scopeEndId = id;
        if (d <= phaseSecTopUs) { return; }
        phaseSecTopUs = d;
        phaseSecTop = Convert.ToString(id);
    }

    public void NoteRedrawWhy(string why) {
        if (!App.PerfOn()) { return; }
        if (redrawWhy == "") {
            string ctx = markNow;
            if (ctx == "") { ctx = "ev"; }
            redrawWhy = ctx + ":" + why;
            redrawCount = 1;
        } else {
            redrawCount = redrawCount + 1;
        }
    }

    void NoteFullFrameWhy() {
        if (!App.PerfOn()) { return; }
        if (fullWhy == null) { fullWhy = new List<WhyTally>(); }
        string key = frameWhy;
        if (key == "") { key = "unspecified"; }
        for (int i = 0; i < fullWhy.Count; i = i + 1) {
            if (fullWhy[i].why == key) {
                fullWhy[i].n = fullWhy[i].n + 1;
                return;
            }
        }
        WhyTally t = new WhyTally(key);
        fullWhy.Add(t);
    }

    string FullFrameWhyTop(int top) {
        if (fullWhy == null || fullWhy.Count == 0) { return "-"; }
        List<int> left = new List<int>();
        for (int i = 0; i < fullWhy.Count; i = i + 1) {
            left.Add(fullWhy[i].n);
        }
        string outp = "";
        int taken = 0;
        while (taken < top) {
            int best = 0 - 1;
            for (int i = 0; i < left.Count; i = i + 1) {
                if (left[i] <= 0) { continue; }
                if (best < 0 || left[i] > left[best]) { best = i; }
            }
            if (best < 0) { break; }
            if (outp != "") { outp = outp + ","; }
            outp = outp + fullWhy[best].why + ":"
                + Convert.ToString(fullWhy[best].n);
            left[best] = 0;
            taken = taken + 1;
        }
        if (outp == "") { return "-"; }
        return outp;
    }

    public void PerfNode(string kind, string nm, int us) {
        if (us <= phaseTopUs) { return; }
        phaseTopUs = us;
        phaseTopNode = kind + "#" + nm;
    }

    public void PhaseBegin() {
        if (!App.PerfOn()) { return; }
        phaseAtUs = Window.GetTickUs();
    }

    public void PhaseEnd(int slot) {
        if (!App.PerfOn()) { return; }
        int now = Window.GetTickUs();
        int d = now - phaseAtUs;
        phaseAtUs = now;
        if (d < 0) { return; }
        if (slot == 0) { phaseBgUs = phaseBgUs + d; }
        else if (slot == 1) { phaseMeasUs = phaseMeasUs + d; }
        else if (slot == 2) { phaseArrUs = phaseArrUs + d; }
        else { phaseTreeUs = phaseTreeUs + d; }
    }

    public static string UsAvg(int us, int n) {
        if (n <= 0) { n = 1; }
        int tenths = us / n / 100;
        return Convert.ToString(tenths / 10) + "."
            + Convert.ToString(tenths % 10);
    }

    public static string MsAvg(int total, int n) {
        if (n <= 0) { n = 1; }
        int tenths = total * 10 / n;
        return Convert.ToString(tenths / 10) + "."
            + Convert.ToString(tenths % 10);
    }

    public bool ForceFullFrames() { return !partialFrames; }
    public bool PartialFrames() { return partialFrames; }

    public void SetPartialFrames(bool on) {
        this.partialFrames = on;
        if (!on) {
            partialPending = false;
            needsRedraw = true;
        }
    }

    public bool PaintHashBegin() {
        if (!paintHashOn) { return false; }
        paintHashSaved = paintHashAcc;
        paintHashAcc = 5381;
        return true;
    }

    public void PaintHashEndSelf(int id, int x, int y, int w, int h) {
        long cur = paintHashAcc;
        paintHashAcc = paintHashSaved;
        if (paintHashStore == null) {
            paintHashStore = new Dictionary<int, long>();
        }
        long prev = 0;
        bool had = paintHashStore.TryGetValue(id, out prev);
        if (had && prev == cur) { return; }
        if (had) { paintHashStore.Remove(id); }
        paintHashStore.Add(id, cur);
        if (!partialFrame || this.RectInDamage(x, y, w, h)) { return; }
        this.NoteDamage(x, y, w, h);
    }

    public static void PaintHashOp(int op, int a, int b, int c, int d) {
        if (!paintHashOn) { return; }
        long h = paintHashAcc;
        h = (h * 1099511628211) ^ op;
        h = (h * 1099511628211) ^ a;
        h = (h * 1099511628211) ^ b;
        h = (h * 1099511628211) ^ c;
        h = (h * 1099511628211) ^ d;
        paintHashAcc = h;
    }

    public static void PaintHashText(int op, int a, int b, int c, int d, string text) {
        if (!paintHashOn) { return; }
        long h = paintHashAcc;
        h = (h * 1099511628211) ^ op;
        h = (h * 1099511628211) ^ a;
        h = (h * 1099511628211) ^ b;
        h = (h * 1099511628211) ^ c;
        h = (h * 1099511628211) ^ d;
        int n = text.Length;
        h = (h * 1099511628211) ^ n;
        for (int i = 0; i < n; i = i + 1) {
            h = (h * 1099511628211) ^ text[i];
        }
        paintHashAcc = h;
    }

    public static void PaintHashList(List<int> xs) {
        if (!paintHashOn) { return; }
        long h = paintHashAcc;
        int n = xs.Count;
        h = (h * 1099511628211) ^ n;
        for (int i = 0; i < n; i = i + 1) {
            h = (h * 1099511628211) ^ xs[i];
        }
        paintHashAcc = h;
    }

    public static bool PaintHashArmed() {
        return paintHashOn;
    }

    public int RenderBackendMode() { return renderBackendMode; }

