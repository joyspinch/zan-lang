    public int SetRenderBackend(int mode) {
        this.renderBackendMode = mode;
        int got = Canvas.SetBackend(mode);
        forceFullNext = true;
        needsRedraw = true;
        return got;
    }

    public static int FxSnapSlot() { return 384; }

    public static string RasterLine(int frames) {
        List<string> names = new List<string>{
            "fill",
            "blend",
            "grad",
            "round",
            "radial",
            "blur",
            "blurhit",
            "img",
            "snap",
            "restore",
            "glyph",
            "bsimd",
            "bscalar" };
        string line = "";
        for (int i = 0; i < names.Count; i = i + 1) {
            int calls = Canvas.RasterStat(i, 0);
            int kpx = Canvas.RasterStat(i, 1);
            if (calls > 0 || kpx > 0) {
                line = line + names[i] + "=" + Convert.ToString(calls / frames)
                    + "/" + Convert.ToString(kpx / frames) + "kpx ";
            }
        }
        int styleN = Style.StatRead(0);
        int styleHit = Style.StatRead(1);
        line = line + "style=" + Convert.ToString(styleN / frames) + "/"
            + Convert.ToString((styleN - styleHit) / frames) + "miss ";
        for (int rank = 0; rank < 6; rank = rank + 1) {
            int kpx = Canvas.RasterTopBlend(rank, 0);
            int bx = Canvas.RasterTopBlend(rank, 1);
            int by = Canvas.RasterTopBlend(rank, 2);
            int bw = Canvas.RasterTopBlend(rank, 3);
            int ba = Canvas.RasterTopBlend(rank, 5);
            int bh = Canvas.RasterTopBlend(rank, 4);
            if (kpx > 0) {
                line = line + "top" + Convert.ToString(rank) + "="
                    + Convert.ToString(kpx) + "kpx@" + Convert.ToString(bx)
                    + "," + Convert.ToString(by) + "+" + Convert.ToString(bw)
                    + "x" + Convert.ToString(bh) + "a" + Convert.ToString(ba)
                    + " ";
            }
        }
        for (int rank = 0; rank < 6; rank = rank + 1) {
            int kpx = Canvas.RasterTopFill(rank, 0);
            int fx = Canvas.RasterTopFill(rank, 1);
            int fy = Canvas.RasterTopFill(rank, 2);
            int fw = Canvas.RasterTopFill(rank, 3);
            int fh = Canvas.RasterTopFill(rank, 4);
            if (kpx > 0) {
                line = line + "op" + Convert.ToString(rank) + "="
                    + Convert.ToString(kpx) + "kpx@" + Convert.ToString(fx)
                    + "," + Convert.ToString(fy) + "+" + Convert.ToString(fw)
                    + "x" + Convert.ToString(fh) + " ";
            }
        }
        return line;
    }

    void RecordFramePerf(int perfBeginMs, int perfPreMs, int endMs, bool partialFrame) {
        int wholeMs = endMs - perfBeginMs;
        if (wholeMs > perfWorstMs) { perfWorstMs = wholeMs; }
        if (wholeMs > 16) { perfSlowFrames = perfSlowFrames + 1; }
        int styleNow = Style.StatPeek(0);
        int styleMissNow = styleNow - Style.StatPeek(1);
        int spikePart = 0;
        if (partialFrame) { spikePart = 1; }
        int pxFill = Canvas.RasterStat(0, 2);
        int pxBlend = Canvas.RasterStat(1, 2);
        int pxBlur = Canvas.RasterStat(5, 2);
        int pxGlyph = Canvas.RasterStat(10, 2);
        int pxSnap = Canvas.RasterStat(8, 2);
        if (frameCount == 0) {
            int pxRound = Canvas.RasterStat(3, 2);
            int pxGrad = Canvas.RasterStat(2, 2);
            int pxRestore = Canvas.RasterStat(9, 2);
            File.AppendAllText("zan_frame_perf.log",
                "firstframe whole_ms=" + Convert.ToString(wholeMs)
                + " render_ms=" + Convert.ToString(perfPreMs - perfBeginMs)
                + " present_ms=" + Convert.ToString(endMs - perfPreMs)
                + " bg_ms=" + App.UsAvg(phaseBgUs, 1)
                + " measure_ms=" + App.UsAvg(phaseMeasUs, 1)
                + " arrange_ms=" + App.UsAvg(phaseArrUs, 1)
                + " tree_ms=" + App.UsAvg(phaseTreeUs, 1)
                + " fill=" + Convert.ToString(pxFill) + "kpx"
                + " blend=" + Convert.ToString(pxBlend) + "kpx"
                + " round=" + Convert.ToString(pxRound) + "kpx"
                + " grad=" + Convert.ToString(pxGrad) + "kpx"
                + " restore=" + Convert.ToString(pxRestore) + "kpx"
                + " blur=" + Convert.ToString(pxBlur) + "kpx"
                + " glyph=" + Convert.ToString(pxGlyph) + "kpx"
                + " snap=" + Convert.ToString(pxSnap) + "kpx"
                + " style=" + Convert.ToString(styleNow)
                + "/" + Convert.ToString(styleMissNow) + "miss"
                + " text_draw_n=" + Convert.ToString(Canvas.TextStat(0))
                + " text_measure_n=" + Convert.ToString(Canvas.TextStat(1))
                + " text_height_n=" + Convert.ToString(Canvas.TextStat(2))
                + " text_font_create_n=" + Convert.ToString(Canvas.TextStat(3))
                + " text_font_hit_n=" + Convert.ToString(Canvas.TextStat(4))
                + " text_draw_hit_n=" + Convert.ToString(Canvas.TextStat(5))
                + " text_draw_miss_n=" + Convert.ToString(Canvas.TextStat(6))
                + " text_measure_hit_n=" + Convert.ToString(Canvas.TextStat(7))
                + " text_measure_miss_n=" + Convert.ToString(Canvas.TextStat(8))
                + " text_draw_us=" + Convert.ToString(Canvas.TextStat(9))
                + " text_measure_us=" + Convert.ToString(Canvas.TextStat(10))
                + " text_height_us=" + Convert.ToString(Canvas.TextStat(11))
                + "\n");
        }
        if (wholeMs > 16) {
            File.AppendAllText("zan_frame_perf.log",
                "spike whole_ms=" + Convert.ToString(wholeMs)
                + " render_ms=" + Convert.ToString(perfPreMs - perfBeginMs)
                + " present_ms=" + Convert.ToString(endMs - perfPreMs)
                + " partial=" + Convert.ToString(spikePart)
                + " style=" + Convert.ToString(styleNow - perfStyleAt)
                + "/" + Convert.ToString(styleMissNow - perfStyleMissAt)
                + "miss fill=" + Convert.ToString(pxFill - perfPxFillAt)
                + "kpx blend=" + Convert.ToString(pxBlend - perfPxBlendAt)
                + "kpx blur=" + Convert.ToString(pxBlur - perfPxBlurAt)
                + "kpx glyph=" + Convert.ToString(pxGlyph - perfPxGlyphAt)
                + " snap=" + Convert.ToString(pxSnap - perfPxSnapAt)
                + "kpx bg=" + App.UsAvg(phaseBgUs, 1)
                + " measure=" + App.UsAvg(phaseMeasUs, 1)
                + " arrange=" + App.UsAvg(phaseArrUs, 1)
                + " tree=" + App.UsAvg(phaseTreeUs, 1)
                + " top=" + phaseTopNode
                + " top_ms=" + App.UsAvg(phaseTopUs, 1)
                + " scope=" + phaseSecTop
                + " scope_ms=" + App.UsAvg(phaseSecTopUs, 1)
                + " mark=" + phaseMarkTop
                + " mark_ms=" + App.UsAvg(phaseMarkTopUs, 1)
                + " redraw=" + Convert.ToString(frameWhyN)
                + "/" + frameWhy
                + " frame=" + Convert.ToString(frameCount) + "\n");
        }
        phaseTopNode = "";
        phaseTopUs = 0;
        phaseSecTop = "";
        phaseSecTopUs = 0;
        scopeEndUs = 0;
        phaseMarkTop = "";
        phaseMarkTopUs = 0;
        markAtUs = 0;
        markNow = "";
        perfBgUs = perfBgUs + phaseBgUs;
        perfMeasUs = perfMeasUs + phaseMeasUs;
        perfArrUs = perfArrUs + phaseArrUs;
        perfTreeUs = perfTreeUs + phaseTreeUs;
        phaseBgUs = 0;
        phaseMeasUs = 0;
        phaseArrUs = 0;
        phaseTreeUs = 0;
        perfPxFillAt = pxFill;
        perfPxBlendAt = pxBlend;
        perfPxBlurAt = pxBlur;
        perfPxGlyphAt = pxGlyph;
        perfPxSnapAt = pxSnap;
        perfStyleAt = styleNow;
        perfStyleMissAt = styleMissNow;
        if (partialFrame) {
            perfPartFrames = perfPartFrames + 1;
            perfPartRenderMs = perfPartRenderMs + (perfPreMs - perfBeginMs);
            perfPartPresentMs = perfPartPresentMs + (endMs - perfPreMs);
        } else {
            perfRenderMs = perfRenderMs + (perfPreMs - perfBeginMs);
            perfPresentMs = perfPresentMs + (endMs - perfPreMs);
            this.NoteFullFrameWhy();
        }
        frameWhy = "";
        perfFrames = perfFrames + 1;
        if (perfFrames >= 30) {
            int fullN = perfFrames - perfPartFrames;
            if (fullN <= 0) { fullN = 1; }
            int partN = perfPartFrames;
            if (partN <= 0) { partN = 1; }
            File.AppendAllText("zan_frame_perf.log",
                "frames=" + Convert.ToString(perfFrames)
                + " full=" + Convert.ToString(perfFrames - perfPartFrames)
                + " render_ms=" + App.MsAvg(perfRenderMs, fullN)
                + " present_ms=" + App.MsAvg(perfPresentMs, fullN)
                + " partial=" + Convert.ToString(perfPartFrames)
                + " part_render_ms=" + App.MsAvg(perfPartRenderMs, partN)
                + " part_present_ms=" + App.MsAvg(perfPartPresentMs, partN)
                + " bg_ms=" + App.UsAvg(perfBgUs, perfFrames)
                + " meas_ms=" + App.UsAvg(perfMeasUs, perfFrames)
                + " arr_ms=" + App.UsAvg(perfArrUs, perfFrames)
                + " tree_ms=" + App.UsAvg(perfTreeUs, perfFrames)
                + " slow=" + Convert.ToString(perfSlowFrames)
                + " worst_ms=" + Convert.ToString(perfWorstMs)
                + " " + App.RasterLine(perfFrames)
                + "whytop=" + this.FullFrameWhyTop(3)
                + "\n");
            perfFrames = 0;
            perfRenderMs = 0;
            perfPresentMs = 0;
            perfPartFrames = 0;
            perfPartRenderMs = 0;
            perfPartPresentMs = 0;
            perfSlowFrames = 0;
            perfWorstMs = 0;
            perfBgUs = 0;
            perfMeasUs = 0;
            perfArrUs = 0;
            perfTreeUs = 0;
        }
    }
}
