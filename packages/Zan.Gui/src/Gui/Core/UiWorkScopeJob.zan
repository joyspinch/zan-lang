using System;
using System.Threading;
namespace Gui;
public class UiWorkScopeJob<TOwner, TSnapshot, TResult> {
    private weak UiWorkScope<TOwner, TSnapshot, TResult> scope;
    private weak App host;
    private TSnapshot snapshot;
    private Func<TSnapshot, CancellationToken, TResult> compute;
    private Func<TOwner, bool> current;
    private Action<TOwner, TResult> apply;
    private Action<TOwner, Exception> failed;
    private TResult result;
    private Exception error;
    private bool retired;
    private bool cancellationSent;
    private bool cancellationInProgress;
    private bool releaseRequested;
    private bool resourcesReleased;
    private CancellationTokenSource cancellation = new CancellationTokenSource();
    private long worker;
    internal UiWorkScopeJob(UiWorkScope<TOwner, TSnapshot, TResult> scope, App host, TSnapshot snapshot,
        Func<TSnapshot, CancellationToken, TResult> compute, Func<TOwner, bool> current,
        Action<TOwner, TResult> apply, Action<TOwner, Exception> failed) {
        this.scope = scope; this.host = host; this.snapshot = snapshot;
        this.compute = compute; this.current = current; this.apply = apply; this.failed = failed;
    }
    public bool IsWorkerDrained { get { return this.worker != 0 && Task.IsDone(this.worker) != 0; } }
    public bool IsRetired { get { lock (this) { return this.retired; } } }
    public Exception Error { get { lock (this) { return this.error; } } }
    internal void Start() { this.worker = Task.Run(this.Run()); }
    private async void Run() {
        try {
            bool run = false;
            lock (this) { run = !this.retired; }
            if (!run) { return; }
            TResult prepared = this.compute(this.snapshot, this.cancellation.Token);
            lock (this) { if (!this.retired) { this.result = prepared; } }
        } catch (Exception failure) {
            lock (this) { if (!this.retired) { this.error = failure; } }
        } finally {
            this.compute = null;
            this.snapshot = null;
            App target = this.host;
            bool post = false;
            lock (this) { post = !this.retired; }
            if (post && target != null) {
                UiWorkScopeJob<TOwner, TSnapshot, TResult> job = this;
                if (!target.TryPost(() => { job.Deliver(); })) { this.Retire(); }
            } else { this.Retire(); }
        }
    }
    private void Deliver() {
        UiWorkScope<TOwner, TSnapshot, TResult> target = this.scope;
        if (target != null) { target.Deliver(this); }
        else { this.Retire(); }
    }
    internal Func<TOwner, bool> CopyCurrent() {
        lock (this) { return this.retired ? null : this.current; }
    }
    internal void ApplyTo(TOwner target) {
        Action<TOwner, TResult> apply = null;
        Action<TOwner, Exception> failed = null;
        TResult prepared = null;
        Exception failure = null;
        lock (this) {
            if (this.retired) { return; }
            apply = this.apply; failed = this.failed;
            prepared = this.result; failure = this.error;
            this.result = null;
        }
        if (failure != null) { if (failed != null) { failed(target, failure); } }
        else { if (apply != null) { apply(target, prepared); } }
    }
    internal void Retire() {
        bool cancel = false;
        lock (this) {
            this.retired = true;
            this.result = null;
            this.current = null;
            this.apply = null;
            this.failed = null;
            if (!this.cancellationSent) {
                this.cancellationSent = true;
                this.cancellationInProgress = true;
                cancel = true;
            }
        }
        if (cancel) {
            try { this.cancellation.Cancel(); }
            finally {
                lock (this) {
                    this.cancellationInProgress = false;
                    this.ReleaseResourcesLocked();
                }
            }
        }
    }
    public async void WaitForWorkerAsync() {
        if (this.worker == 0) { return; }
        List<long> handles = new List<long>();
        handles.Add(this.worker);
        await Task.WhenAll(handles);
    }
    internal void ReleaseResources() {
        lock (this) {
            this.releaseRequested = true;
            this.ReleaseResourcesLocked();
        }
    }
    private void ReleaseResourcesLocked() {
        if (!this.releaseRequested || this.cancellationInProgress || this.resourcesReleased) { return; }
        this.resourcesReleased = true;
        this.cancellation.Dispose();
    }
}
