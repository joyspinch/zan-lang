using System;
using Gui;
using Gui.Backend;
using Gui.Core;
namespace Gui;
public class ScrollState : AppLoopOwner, AppLoopParticipant, AppLoopStopped {
    int dragAxis;
    int dragMouse0;
    int dragOffset0;
    int dragMax0;
    int dragTravel0;
    int barW;
    internal SpringState smoothX;
    internal SpringState smoothY;
    internal int smoothTargetX;
    internal int smoothTargetY;
    internal FlingState flingX;
    internal FlingState flingY;
    internal float flingPosX;
    internal float flingPosY;
    weak Control animHost;
    weak App animApp;
    weak AppLoopRegistration animReg;
    FrameCadence animCadence;
    int animLastMs;
    int animNextMs;
    ScrollState() {
        barW = 4;
        animNextMs = 0 - 1;
    }
    internal bool HasMotion() {
        return smoothX != null || smoothY != null
            || (flingX != null && flingX.velocity != 0.0f)
            || (flingY != null && flingY.velocity != 0.0f);
    }
    internal void AttachMotion(Control host) {
        if (host == null) { return; }
        animHost = host;
        App app = host.App;
        if (app == null || !app.isRunning) { return; }
        if (animApp != app || animReg == null) {
            this.DetachLoop();
            animApp = app;
            if (animCadence == null) { animCadence = new FrameCadence(); }
            animCadence.Reset();
            animCadence.SetRate(app.RefreshRate());
            int now = Window.GetTickMs();
            animLastMs = now;
            long nowUs = (long)now * 1000;
            animCadence.Begin(nowUs);
            animNextMs = now + animCadence.WaitMilliseconds(nowUs);
            animReg = app.RegisterLoopParticipant(this, this);
        }
        app.RequestRedraw();
    }
    void DetachLoop() {
        if (animReg != null) { animReg.Invalidate(); }
        animReg = null;
        animApp = null;
        animNextMs = 0 - 1;
    }
    internal void StopMotion() {
        smoothX = null;
        smoothY = null;
        flingX = null;
        flingY = null;
        this.DetachLoop();
    }
    public void Stopped(App app) {
        if (app == animApp) { this.StopMotion(); }
    }
    public int NextDeadline() { return animNextMs; }
    public void Tick(App app, int now) {
        if (app != animApp || animNextMs < 0) { return; }
        Control c = animHost;
        if (c == null || !this.HasMotion()) {
            this.StopMotion();
            return;
        }
        int dt = now - animLastMs;
        if (dt <= 0) { dt = 16; }
        if (dt > 50) { dt = 50; }
        animLastMs = now;
        Rect view = c.ScrollViewport();
        int nextX = c.scrollX;
        int nextY = c.scrollY;
        if (smoothX != null) {
            bool done = ScrollPhysics.StepSpringState(smoothX, dt);
            int curX = smoothTargetX + (int)(smoothX.displacement + (smoothX.displacement >= 0.0f ? 0.5f : -0.5f));
            nextX = this.Clamp(curX, c.scrollExtentX, view.width);
            if (done) { nextX = this.Clamp(smoothTargetX, c.scrollExtentX, view.width); smoothX = null; }
        } else if (flingX != null && flingX.velocity != 0.0f) {
            float dx = ScrollPhysics.StepFlingState(flingX, dt);
            flingPosX = flingPosX + dx;
            int clampedX = this.Clamp((int)(flingPosX + 0.5f), c.scrollExtentX, view.width);
            int maxX = this.Clamp(c.scrollExtentX, c.scrollExtentX, view.width);
            if ((float)clampedX != flingPosX && (clampedX == 0 || clampedX == maxX)) {
                flingX.velocity = 0.0f;
                flingPosX = (float)clampedX;
            }
            nextX = clampedX;
            if (flingX.velocity == 0.0f) { flingX = null; }
        }
        if (smoothY != null) {
            bool done = ScrollPhysics.StepSpringState(smoothY, dt);
            int curY = smoothTargetY + (int)(smoothY.displacement + (smoothY.displacement >= 0.0f ? 0.5f : -0.5f));
            nextY = this.Clamp(curY, c.scrollExtent, view.height);
            if (done) { nextY = this.Clamp(smoothTargetY, c.scrollExtent, view.height); smoothY = null; }
        } else if (flingY != null && flingY.velocity != 0.0f) {
            float dy = ScrollPhysics.StepFlingState(flingY, dt);
            flingPosY = flingPosY + dy;
            int clampedY = this.Clamp((int)(flingPosY + 0.5f), c.scrollExtent, view.height);
            int maxY = this.Clamp(c.scrollExtent, c.scrollExtent, view.height);
            if ((float)clampedY != flingPosY && (clampedY == 0 || clampedY == maxY)) {
                flingY.velocity = 0.0f;
                flingPosY = (float)clampedY;
            }
            nextY = clampedY;
            if (flingY.velocity == 0.0f) { flingY = null; }
        }
        if (nextX != c.scrollX || nextY != c.scrollY) {
            c.ScrollDamage(app);
            c.CommitScrollOffset(nextX, nextY);
        }
        if (!this.HasMotion()) {
            this.DetachLoop();
            return;
        }
        animCadence.SetRate(app.RefreshRate());
        long nowUs = (long)now * 1000;
        animCadence.Begin(nowUs);
        animNextMs = now + animCadence.WaitMilliseconds(nowUs);
        app.RequestRedraw();
    }
    bool WantsBar(int extent, int client, int mode) { return mode == 3 || (mode == 2 && extent > client); }
    int Clamp(int offset, int extent, int client) {
        int maximum = extent - client;
        if (maximum < 0) { maximum = 0; }
        if (offset > maximum) { return maximum; }
        if (offset < 0) { return 0; }
        return offset;
    }
    bool WheelDelta(App app, int delta, int modifiers, int w, int h,
    Control host, int oxMode, int oyMode) {
        bool xCan = oxMode >= 2 && host.scrollExtentX > w && w > 0;
        bool yCan = oyMode >= 2 && host.scrollExtent > h && h > 0;
        int step = delta * app.scrollSpeed / 120;
        if (Modifiers.HasShift(modifiers) && xCan) {
            int nextX = this.Clamp(host.scrollX - step, host.scrollExtentX, w);
            if (nextX == host.scrollX) { return false; }
            host.scrollX = nextX;
            return true;
        }
        if (!yCan) { return false; }
        int nextY = this.Clamp(host.scrollY - step, host.scrollExtent, h);
        if (nextY == host.scrollY) { return false; }
        host.scrollY = nextY;
        return true;
    }
    Rect Track(App app, int x, int y, int w, int h, bool horizontal) {
        int cross = horizontal ? h : w;
        int width = app.Scale(barW);
        if (width > cross) { width = cross; }
        if (width < 1) { width = 1; }
        int inset = app.Scale(2);
        if (horizontal) {
            int top = y + h - width - inset;
            if (top < y) { top = y; }
            return new Rect(x, top, w, width);
        }
        int left = x + w - width - inset;
        if (left < x) { left = x; }
        return new Rect(left, y, width, h);
    }
    int ThumbLength(App app, int client, int extent) {
        if (client <= 0) { return 0; }
        if (extent <= client) { return client; }
        int minimum = app.Scale(24);
        if (minimum > client) { minimum = client; }
        int length = (int)((long)client * client / extent);
        if (length < minimum) { length = minimum; }
        if (length > client) { length = client; }
        return length;
    }
    int ThumbStart(App app, int start, int client, int extent, int offset) {
        int travel = client - this.ThumbLength(app, client, extent);
        int maximum = extent - client;
        if (maximum <= 0) { return start; }
        return start + (int)((long)this.Clamp(offset, extent, client) * travel / maximum);
    }
    bool Active() { return dragAxis != 0; }
    bool Horizontal() { return dragAxis == 2; }
    void Cancel() { dragAxis = 0; }
    int BeginDrag(App app, bool horizontal, int pointer, int start,
    int client, int extent, int offset) {
        int length = this.ThumbLength(app, client, extent);
        int thumb = this.ThumbStart(app, start, client, extent, offset);
        int travel = client - length;
        int off = this.Clamp(offset, extent, client);
        if ((pointer < thumb || pointer >= thumb + length) && travel > 0) {
            off = this.Clamp((int)((long)(pointer - start - length / 2)
            * (extent - client) / travel), extent, client);
        }
        dragAxis = horizontal ? 2 : 1;
        dragMouse0 = pointer;
        dragOffset0 = off;
        dragMax0 = extent - client;
        dragTravel0 = travel;
        return off;
    }
    int MoveDrag(App app, int pointer, int client, int extent, int offset) {
        int maximum = extent - client;
        int travel = client - this.ThumbLength(app, client, extent);
        int off = this.Clamp(offset, extent, client);
        if (maximum != dragMax0 || travel != dragTravel0) {
            dragMouse0 = pointer;
            dragOffset0 = off;
            dragMax0 = maximum;
            dragTravel0 = travel;
            return off;
        }
        if (travel <= 0 || maximum <= 0) { return off; }
        return this.Clamp(dragOffset0 + (int)((long)(pointer - dragMouse0)
        * maximum / travel), extent, client);
    }
    void PaintBar(App app, int x, int y, int w, int h, int offset,
    int extent, int mode, bool horizontal, bool hovered) {
        int client = horizontal ? w : h;
        if (w <= 0 || h <= 0 || !this.WantsBar(extent, client, mode)) { return; }
        Rect track = this.Track(app, x, y, w, h, horizontal);
        int length = this.ThumbLength(app, client, extent);
        int start = this.ThumbStart(app, horizontal ? x : y, client, extent, offset);
        Rect thumb = horizontal ? new Rect(start, track.y, length, track.height)
        : new Rect(track.x, start, track.width, length);
        bool overThumb = hovered && thumb.Contains(app.mouseX, app.mouseY);
        bool overBar = hovered && track.Contains(app.mouseX, app.mouseY);
        bool dragging = dragAxis == (horizontal ? 2 : 1);
        StyleBox trackStyle = Control.BareBox(app, "scrollbar", Style.SNormal());
        int state = dragging || overThumb ? Style.SHover() : Style.SNormal();
        StyleBox thumbStyle = Style.Part(app, "scrollbar", "thumb", "", "", "", state);
        int radius = (horizontal ? track.height : track.width) / 2;
        Canvas c = app.canvas;
        c.PushClip(x, y, w, h);
        if (trackStyle.bg != 0 && (dragging || overBar)) {
            c.FillRoundRect(track.x, track.y, track.width, track.height, radius, trackStyle.bg);
        }
        c.FillRoundRect(thumb.x, thumb.y, thumb.width, thumb.height, radius, thumbStyle.bg);
        c.PopClip();
    }
}
