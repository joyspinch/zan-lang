namespace Gui;

/// <summary>
/// 重尾控件的宿主注册表（先注册后可用）。
/// ControlFactory 的单一 switch 会把每个 kind 分支的静态构造链拉进编译
/// 图：设计稿/运行期文档只要经它建树，"CefBrowserBox" 分支就让整个
/// CEF 家族（CefBrowserBox → CefBrowser → CefHost → CefBackend）、
/// "WebViewBox" 分支就让 WebView 家族跟着存活——几行代码的演示程序
/// 也被 zanc 判定"图里有 CefBackend_ 符号"，发布时 zan_cef/zan_cef109/
/// WebView2Loader 全部跟随（bundle 的 "if 前缀" 条件是符号存在性判定）。
/// 把这两类控件移出主 switch、改为宿主启动时注册工厂，不注册的程序
/// globaldce 把整个家族删光，DLL 不再进发布目录。
/// 注册入口：CEF 侧 CefBootstrap.Install()、WebView 侧 WebViewBootstrap.
/// Install()（IDE、gui_cef_browser 等真正用到它们的宿主在启动时调用）。
/// </summary>
delegate Control ControlFactoryFn(string kind);

/// 重尾控件工厂项实体（消除 names / fns 平行列表反模式）。
class HeavyControlFactoryEntry {
    string kind;
    ControlFactoryFn fn;

    HeavyControlFactoryEntry(string kind, ControlFactoryFn fn) {
        this.kind = kind;
        this.fn = fn;
    }
}

/// 重尾控件序列化别名条目实体（消除 aliasFrom / aliasTo 平行列表反模式）。
class HeavyControlAliasEntry {
    string from;
    string to;

    HeavyControlAliasEntry(string from, string to) {
        this.from = from;
        this.to = to;
    }
}

class HeavyControls {
    static List<HeavyControlFactoryEntry> entries;
    static List<HeavyControlAliasEntry> aliases;

    /// 注册一个重尾 kind 的工厂（重复注册以最后一次为准）。
    static void Register(string kind, ControlFactoryFn fn) {
        if (entries == null) {
            entries = new List<HeavyControlFactoryEntry>();
        }
        for (int i = 0; i < entries.Count; i = i + 1) {
            if (entries[i].kind == kind) { entries[i].fn = fn; return; }
        }
        entries.Add(new HeavyControlFactoryEntry(kind, fn));
    }

    /// 注册 legacy 序列化 kind 的归一化别名（from → to）。别名不进
    /// Kinds() 名单——名单只列现行 kind，别名只服务旧文档读侧。
    static void RegisterAlias(string from, string to) {
        if (aliases == null) {
            aliases = new List<HeavyControlAliasEntry>();
        }
        aliases.Add(new HeavyControlAliasEntry(from, to));
    }

    /// kind 是否已注册（ControlFactory.Kinds 的名单扩展）。
    static bool Has(string kind) {
        if (entries == null) { return false; }
        for (int i = 0; i < entries.Count; i = i + 1) {
            if (entries[i].kind == kind) { return true; }
        }
        return false;
    }

    /// 已注册 kind 的名字快照（设计器调色板/名单对齐用）。
    static List<string> HeavyKinds() {
        List<string> k = new List<string>();
        if (entries != null) {
            for (int i = 0; i < entries.Count; i = i + 1) {
                k.Add(entries[i].kind);
            }
        }
        return k;
    }

    /// 已注册 kind 的工厂调用；legacy 别名先归一化再查表。未注册
    /// 返回 null（与主 switch 的 "miss 即 null" 契约一致——文档里的
    /// kind 拼错仍显式失败）。
    static Control Create(string kind) {
        if (aliases != null) {
            for (int i = 0; i < aliases.Count; i = i + 1) {
                if (aliases[i].from == kind) { kind = aliases[i].to; break; }
            }
        }
        if (entries == null) { return null; }
        for (int i = 0; i < entries.Count; i = i + 1) {
            if (entries[i].kind == kind) { return entries[i].fn(kind); }
        }
        return null;
    }
}
