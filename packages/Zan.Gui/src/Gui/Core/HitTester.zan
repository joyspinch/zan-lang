using System;
using System.Collections.Generic;
using Gui;
namespace Gui;
public class HitTester {
    List<HitRegion> regions;
    List<HitRegion> blockers;
    List<HitRegion> prevBlockers;
    List<HitRegion> blockersA;
    List<HitRegion> blockersB;
    List<HitRegion> poolA;
    List<HitRegion> poolB;
    bool useA;
    int used;
    HitTester() {
        poolA = new List<HitRegion>();
        poolB = new List<HitRegion>();
        useA = true;
        used = 0;
        regions = poolA;
        blockersA = new List<HitRegion>();
        blockersB = new List<HitRegion>();
        blockers = blockersA;
        prevBlockers = blockersB;
    }
    void Clear() {
        useA = !useA;
        if (useA) {
            regions = poolA;
            blockers = blockersA;
            prevBlockers = blockersB;
        } else {
            regions = poolB;
            blockers = blockersB;
            prevBlockers = blockersA;
        }
        blockers.Clear();
        used = 0;
    }
    int RegionCount() { return used; }
    HitRegion RegionAt(int i) { return regions[i]; }
    void RegisterRect(int id, int x, int y, int w, int h, int wtype) {
        this.RegisterRectL(id, x, y, w, h, wtype, "");
    }
    void RegisterRectL(int id, int x, int y, int w, int h, int wtype, string label) {
        HitRegion r;
        if (used < regions.Count) {
            r = regions[used];
            r.Set(id, x, y, w, h, wtype);
        } else {
            r = new HitRegion(id, x, y, w, h, wtype);
            regions.Add(r);
        }
        r.label = label != null ? label : "";
        used = used + 1;
        if (wtype == -1) { blockers.Add(r); }
    }
    void Register(HitRegion region) {
        if (region == null) { return; }
        this.RegisterRect(region.id, region.x, region.y,
            region.width, region.height, region.widgetType);
    }
    bool BlockerAt(int px, int py) {
        int i = blockers.Count - 1;
        while (i >= 0) {
            HitRegion r = blockers[i];
            if (px >= r.x && px < r.x + r.width && py >= r.y && py < r.y + r.height) { return true; }
            i = i - 1;
        }
        return false;
    }
    bool PrevBlockerAt(int px, int py) {
        int i = prevBlockers.Count - 1;
        while (i >= 0) {
            HitRegion r = prevBlockers[i];
            if (px >= r.x && px < r.x + r.width && py >= r.y && py < r.y + r.height) { return true; }
            i = i - 1;
        }
        return false;
    }
    int HitTest(int px, int py) {
        int i = used - 1;
        while (i >= 0) {
            HitRegion r = regions[i];
            if (px >= r.x && px < r.x + r.width && py >= r.y && py < r.y + r.height) { return r.id; }
            i = i - 1;
        }
        return -1;
    }
    int HitTestBelowBlockers(int px, int py) {
        int i = used - 1;
        while (i >= 0) {
            HitRegion r = regions[i];
            if (r.widgetType != -1 && px >= r.x && px < r.x + r.width && py >= r.y && py < r.y + r.height) {
                return r.id;
            }
            i = i - 1;
        }
        return -1;
    }
    bool TryGetRect(int id, out int rx, out int ry, out int rw, out int rh) {
        rx = 0; ry = 0; rw = 0; rh = 0;
        if (id < 0) { return false; }
        for (int i = 0; i < used; i = i + 1) {
            HitRegion r = regions[i];
            if (r.id == id) {
                rx = r.x; ry = r.y; rw = r.width; rh = r.height;
                return true;
            }
        }
        return false;
    }
    List<int> RectOf(int id) {
        if (id < 0) { return null; }
        for (int i = 0; i < used; i = i + 1) {
            HitRegion r = regions[i];
            if (r.id == id) {
                List<int> box = new List<int>{
                    r.x,
                    r.y,
                    r.width,
                    r.height };
                return box;
            }
        }
        return null;
    }
    int GetWidgetType(int id) {
        for (int i = 0; i < used; i = i + 1) {
            if (regions[i].id == id) { return regions[i].widgetType; }
        }
        return -1;
    }
}
