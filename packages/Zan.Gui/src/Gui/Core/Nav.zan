using System;
using System.Json;
using Gui;
using Gui.Widget;

namespace Gui;

/// 项目级导航层：把"打开哪个页"从窗口 code-behind 里收拢成一张路由表。
///
/// 三种呈现共用一张表（Route = 名字 + 标题 + 页面工厂）：
///   - `Nav.Open`：独立副窗口（ChildWindow 家族，主循环泵着，非模态——
///     与桌面工具"473 次 Show 对 7 次 ShowDialog"的主流形态一致）；
///     同名路由已开则复用同一个窗口（单例）并重放参数，等价于原版
///     标签壳的"已开聚焦 + 重新 Navigate"。
///   - `Nav.Embed`：把一个 Tabs 变成路由出口——每条路由一个标签页，
///     首次选中才实例化（惰性），默认 keepAlive（切走保留），可按路由
///     配成临态（切走销毁、再进重建）。
///   - 窗口关闭栈：`Nav.Back()` 关掉最近打开的导航窗口，供安卓
///     AC_BACK（kind-8）和界面返回键复用。
///
/// 页面工厂是纯函数指针（Zan 委托无捕获），所以参数经 `OnEnter` 钩子
/// 回注：窗口在打开与每次重放时调用，页面用它拉取 `Nav` 传入的数据。
/// 设计器 / GenForm / 本层互不依赖——路由表就是普通 Zan 代码。
///
/// 限制（有意为之的 v1 范围）：
///   - 一个 Tabs 只 Embed 一次（出口状态按 Tabs 实例记录）；
///   - 模态弹窗请继续走 Layer（alert/confirm/prompt），这里只管
///     非模态副窗口与页内出口。

/// 页面工厂：返回页面根控件。纯函数指针，页面自身的数据逻辑放 code-behind。
delegate Control NavPageFactory();

/// 进入钩子：窗口打开 / 已开重放 / 出口页构建时调用。
/// `win` 为承载窗口；页内出口（Embed）没有窗口，传 null。
delegate void NavEnterHandler(NavWindow win, JsonValue args);

/// 一条路由：名字（键）+ 标题（窗口/标签文案）+ 页面工厂 + 进入钩子。
class NavRoute {
    string name;
    string title;
    NavPageFactory make;
    NavEnterHandler enter;
    /// Embed 出口的存活策略：true（默认）切走保留，false 切走销毁。
    bool keepAlive;
    /// 窗口尺寸（逻辑像素；<=0 用 NavWindow 的 560 缺省）。
    int winW;
    int winH;
}

/// Nav 打开的副窗口：把路由的标题/尺寸钉到 ChildWindow 的虚约定上，
/// 页面树来自路由工厂，参数经 OnEnter 回注。
class NavWindow : ChildWindow {
    NavRoute rt;
    int w;
    int h;
    int idBase;

    /// 构造：缺省尺寸 560x560（路由可用 SetWindowSize 覆盖）。
    NavWindow() {
        rt = null;
        w = 560;
        h = 560;
        idBase = 910000;
    }

    override string Title() {
        if (rt != null) { return rt.title; }
        return "Zan";
    }

    override int Width() { return w; }

    override int Height() { return h; }

    /// 每个窗口一枚固定的 WidgetId 基线（主窗口不回卷进程级计数，
    /// 子窗口不钉基线则按钮 hover/press 每帧错位）。
    override int IdBase() { return idBase; }

    /// 用路由的工厂建树、挂根并按父窗口的皮肤/不透明度约定打开。
    /// 打开后回调一次 OnEnter。
    void OpenFor(NavRoute r, App parent, JsonValue args) {
        rt = r;
        if (r.winW > 0) { w = r.winW; }
        if (r.winH > 0) { h = r.winH; }
        idBase = Nav.NextIdBase();
        Control tree = r.make();
        this.SetRoot(tree, null);
        this.OpenHost(parent);
        if (r.enter != null) { r.enter(this, args); }
    }

    /// 已开窗口被再次 Open：只重放参数（原版对已开网页标签重新
    /// Navigate 的语义），不重建树。
    void Replay(JsonValue args) {
        if (rt != null && rt.enter != null) { rt.enter(this, args); }
    }
}

/// 一个 Embed 出口：标签条 + 各标签对应的路由名（下标对齐）。
class NavEmbed {
    Tabs tabs;
    List<string> names;
}

class Nav {
    static List<NavRoute> routes;
    static List<NavWindow> openStack;
    static List<NavEmbed> embeds;
    static int nextIdBase;

    /// 登记路由（同名重登记=覆盖工厂/标题，钩子与 keepAlive 保留）。
    static NavRoute Define(string name, NavPageFactory make) {
        return Nav.DefineTitle(name, name, make);
    }

    /// 登记路由并指定标题（窗口标题 / 标签文案）。
    static NavRoute DefineTitle(string name, string title, NavPageFactory make) {
        if (routes == null) { routes = new List<NavRoute>(); }
        NavRoute r = Nav.Find(name);
        if (r != null) {
            r.make = make;
            r.title = title;
            return r;
        }
        NavRoute nr = new NavRoute();
        nr.name = name;
        nr.title = title;
        nr.make = make;
        nr.keepAlive = true;
        routes.Add(nr);
        return nr;
    }

    /// 挂进入钩子（窗口打开 / 参数重放 / 出口页构建时回调）。
    static void OnEnter(string name, NavEnterHandler h) {
        NavRoute r = Nav.Find(name);
        if (r != null) { r.enter = h; }
    }

    /// 配出口存活策略：false = 切走销毁、再进重建（重页面按需开）。
    static void SetKeepAlive(string name, bool on) {
        NavRoute r = Nav.Find(name);
        if (r != null) { r.keepAlive = on; }
    }

    /// 配窗口尺寸（逻辑像素）。
    static void SetWindowSize(string name, int width, int height) {
        NavRoute r = Nav.Find(name);
        if (r == null) { return; }
        r.winW = width;
        r.winH = height;
    }

    /// 查路由（未登记返回 null）。
    static NavRoute Find(string name) {
        if (routes == null) { return null; }
        for (int i = 0; i < routes.Count; i = i + 1) {
            if (routes[i].name == name) { return routes[i]; }
        }
        return null;
    }

    /// 打开路由（单例）：已开则激活 + 重放参数；未开则建副窗口。
    /// parent 是属主应用（换肤/不透明度跟随它），通常传
    /// `MyForm.__form.GetApp()`。
    static void Open(string name, App parent) {
        Nav.OpenArgs(name, parent, null);
    }

    /// 打开路由并携带参数（进入钩子收到）。
    static void OpenArgs(string name, App parent, JsonValue args) {
        NavRoute r = Nav.Find(name);
        if (r == null || r.make == null) {
            Console.WriteLine("Nav: undefined route '" + name + "'");
            return;
        }
        if (parent == null) {
            Console.WriteLine("Nav: no parent app for route '" + name + "'");
            return;
        }
        NavWindow w = Nav.FindOpen(name);
        if (w != null) {
            w.Replay(args);
            Nav.Activate(w);
            return;
        }
        w = new NavWindow();
        w.OpenFor(r, parent, args);
        if (openStack == null) { openStack = new List<NavWindow>(); }
        openStack.Add(w);
    }

    /// 查某路由当前打开的窗口（后开者优先；未开返回 null）。
    static NavWindow FindOpen(string name) {
        if (openStack == null) { return null; }
        for (int i = openStack.Count - 1; i >= 0; i = i - 1) {
            NavWindow w = openStack[i];
            if (w.IsOpen() && w.rt != null && w.rt.name == name) { return w; }
        }
        return null;
    }

    /// 返回：关掉最近打开的导航窗口（栈顶）。没有导航窗口时空操作，
    /// 调用方（安卓 AC_BACK 的 kind-8 分支）据此自行决定退应用。
    static bool Back() {
        Nav.Prune();
        if (openStack == null || openStack.Count == 0) { return false; }
        NavWindow w = openStack[openStack.Count - 1];
        openStack.RemoveAt(openStack.Count - 1);
        w.Close();
        return true;
    }

    /// 关闭全部导航窗口。
    static void CloseAll() {
        if (openStack == null) { return; }
        for (int i = 0; i < openStack.Count; i = i + 1) {
            if (openStack[i].IsOpen()) { openStack[i].Close(); }
        }
        openStack = new List<NavWindow>();
    }

    /// 把标签条绑成路由出口：csv 里的每条路由一个标签（按序），
    /// 首个标签立即建页，其余首次选中才建（惰性）。keepAlive 默认开，
    /// `SetKeepAlive(name, false)` 配成临态。一条 Tabs 只绑一次。
    static void Embed(Tabs tabs, string routeCsv) {
        if (embeds == null) { embeds = new List<NavEmbed>(); }
        NavEmbed e = new NavEmbed();
        e.tabs = tabs;
        e.names = new List<string>();
        string cur = "";
        for (int i = 0; i < routeCsv.Length; i = i + 1) {
            string ch = routeCsv.Substring(i, 1);
            if (ch == ",") {
                Nav.TryAddEmbedTab(e, cur);
                cur = "";
            } else {
                cur = cur + ch;
            }
        }
        Nav.TryAddEmbedTab(e, cur);
        tabs.BindEvent("TabChanged", Nav.EmbedChanged);
        embeds.Add(e);
        if (tabs.Active() < 0 && tabs.Count() > 0) { tabs.Select(0); }
        int act = tabs.Active();
        if (act >= 0) { Nav.EnsureEmbedPage(e, act); }
    }

    /// TabChanged 的统一处理：遍历全部出口领走选中变化（TakeChanged
    /// 是一次性读数，只有真变了的标签条领得到），先按临态策略清理
    /// 别的页，再惰性建当前页。
    static void EmbedChanged() {
        if (embeds == null) { return; }
        for (int k = 0; k < embeds.Count; k = k + 1) {
            NavEmbed e = embeds[k];
            int idx = e.tabs.TakeChanged();
            if (idx < 0) { continue; }
            for (int j = 0; j < e.names.Count; j = j + 1) {
                if (j == idx) { continue; }
                NavRoute rj = Nav.Find(e.names[j]);
                if (rj == null || rj.keepAlive) { continue; }
                Panel pj = e.tabs.Page(j);
                if (pj.ChildCount() > 0) { pj.RemoveAll(); }
            }
            Nav.EnsureEmbedPage(e, idx);
        }
    }

    // ---- internals -------------------------------------------------

    /// 出口加一个标签：路由存在才加（名字表与标签下标保持对齐）。
    static void TryAddEmbedTab(NavEmbed e, string name) {
        if (name == "") { return; }
        NavRoute r = Nav.Find(name);
        if (r == null) { return; }
        e.names.Add(name);
        e.tabs.Add(r.title, false);
    }

    /// 保证第 i 个标签的页面已构建：keepAlive 且已有内容直接复用；
    /// 临态页重建。构建后回调进入钩子（无窗口，win 传 null）。
    static void EnsureEmbedPage(NavEmbed e, int i) {
        if (i < 0 || i >= e.names.Count) { return; }
        NavRoute r = Nav.Find(e.names[i]);
        if (r == null || r.make == null) { return; }
        Panel page = e.tabs.Page(i);
        if (page.ChildCount() > 0) {
            if (r.keepAlive) { return; }
            page.RemoveAll();
        }
        Control ctl = r.make();
        if (ctl == null) { return; }
        page.Add(ctl);
        if (r.enter != null) { r.enter(null, null); }
    }

    /// 清理栈里已被用户点标题栏关掉的窗口。
    static void Prune() {
        if (openStack == null) { return; }
        for (int i = openStack.Count - 1; i >= 0; i = i - 1) {
            if (!openStack[i].IsOpen()) { openStack.RemoveAt(i); }
        }
    }

    /// 激活窗口（置前台）。只有 Windows 有现成的原生入口；其它平台
    /// 交给宿主窗口管理器，属主泵循环会把它带上来。
    static void Activate(NavWindow w) {
        if (w == null || !w.IsOpen()) { return; }
        #if WINDOWS
        if (w.Host() != null) {
            Gui.Backend.Win32Shell.SetForegroundWindow(w.Host().WindowHandle());
        }
        #endif
    }

    static int NextIdBase() {
        if (Nav.nextIdBase < 910000) { Nav.nextIdBase = 910000; }
        int id = Nav.nextIdBase;
        Nav.nextIdBase = Nav.nextIdBase + 1000;
        return id;
    }
}
