using System;

namespace Gui;

// 泛型响应式状态容器（Reactive State Container）。
// 封装任意类型的数据并记录单调递增版本号；当绑定了 App 时，值发生赋值修改
// 会自动触发界面的重绘请求（App.RequestRedraw），彻底摆脱手动处处调用 RequestRedraw 的负担。
public class State<T> {
    T val;
    int version;
    App hostApp;

    State(T initial) {
        this.val = initial;
        this.version = 0;
        this.hostApp = null;
    }

    // 绑定当前的 GUI 宿主，变更时自动触发重绘。
    void BindApp(App app) {
        this.hostApp = app;
    }

    // 获取当前值。
    T Get() { return this.val; }

    // 写入新值。版本号递增，若绑定了 App 自动请求刷新。
    void Set(T v) {
        this.val = v;
        this.version = this.version + 1;
        if (this.hostApp != null) {
            this.hostApp.RequestRedraw();
        }
    }

    // 写入次数，供帧轮询比对。
    int Version() { return this.version; }
}
