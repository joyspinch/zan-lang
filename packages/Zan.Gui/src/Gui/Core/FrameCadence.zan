using System;

namespace Gui;

// 使用绝对微秒截止时间，保留 60/120/144Hz 的小数周期，并跳过已错过的帧。
public class FrameCadence {
    double rate = 60.0;
    double periodUs = 1000000.0 / 60.0;
    double nextUs;

    void SetRate(double hz) {
        if (!(hz >= 24.0 && hz <= 1000.0)) { hz = 60.0; }
        if (rate == hz) { return; }
        rate = hz;
        periodUs = 1000000.0 / hz;
        nextUs = 0.0;
    }

    double Rate() { return rate; }

    void Begin(long nowUs) {
        if (nextUs <= 0.0) {
            nextUs = (double)nowUs + periodUs;
            return;
        }
        // 输入触发的提前帧不推迟已排定的动画帧。
        if (nextUs <= (double)nowUs) {
            long skipped = (long)(((double)nowUs - nextUs) / periodUs) + 1;
            nextUs = nextUs + (double)skipped * periodUs;
        }
    }

    long DeadlineUs() { return (long)Math.Ceiling(nextUs); }

    int WaitMilliseconds(long nowUs) {
        long left = this.DeadlineUs() - nowUs;
        if (left <= 0) { return 0; }
        return (int)((left + 999) / 1000);
    }
}
