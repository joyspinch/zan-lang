namespace Gui;

// The App ticket owns this adapter, never the binder or its model/tree.
internal class ModelHostParticipant : AppLoopParticipant, AppLoopStopped {
    internal weak AppModelHost binder;
    public void Tick(App app, int now) { }
    public int NextDeadline() { return -1; }
    public void Stopped(App app) {
        AppModelHost current = binder;
        if (current != null && current.HostApp() == app) { current.Detach(); }
    }
}
