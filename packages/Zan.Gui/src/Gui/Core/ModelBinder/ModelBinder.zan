using System;
using System.Collections.Generic;
using System.Json;
using Gui;
namespace Gui;
public partial class ModelBinder : AppLoopOwner, AppModelHost {
    internal AppLoopRegistration hostRegistration;
    Control root;
    object model;
    HandlerRegistry handlers;
    List<ModelBindingAction> wiredActions;
    List<ModelValueBinding> valueBindings;
    int collectedStructureRevision;
    weak App app;
    List<ChildTemplateMeta> tmplMetas;
    List<ChildExpandedRow> expandedRows;
    List<ChildExpandedRow> retiringRows;
    bool retiringRowsBusy;
    List<ChildScopeBinding> scopeBindings;
    public ModelBinder() {
        this.root = null;
        this.model = null;
        this.handlers = null;
        this.app = null;
        this.valueBindings = null;
        this.collectedStructureRevision = -1;
        this.tmplMetas = null;
        this.expandedRows = null;
        this.scopeBindings = null;
    }
    public void SetRoot(Control tree, object m) {
        if (this.root == tree && this.model != m && this.tmplMetas != null) {
            this.model = m;
            this.valueBindings = null;
            this.collectedStructureRevision = -1;
            return;
        }
        if (this.root != tree || this.model != m) {
            HandlerRegistry registry = this.handlers;
            App host = this.app;
            bool registered = this.hostRegistration != null && this.hostRegistration.active;
            this.Detach();
            if (this.root != null || this.model != null || this.hostRegistration != null) { return; }
            this.handlers = registry;
            this.app = host;
            if (registered && host != null && host.isRunning) { host.RegisterModelHost(this); }
        }
        this.root = tree;
        this.model = m;
        if (this.handlers == null) { this.handlers = new HandlerRegistry(); }
    }
    public void SetRoot(Control tree, JsonValue m) { this.SetRoot(tree, (object)m); }
    public void Detach() {
        this.RetireHostRegistration();
        List<ModelBindingAction> actions = this.wiredActions;
        List<ChildExpandedRow> rows = this.expandedRows;
        List<ChildScopeBinding> scopes = this.scopeBindings;
        this.wiredActions = null;
        this.expandedRows = null;
        this.scopeBindings = null;
        this.valueBindings = null;
        this.collectedStructureRevision = -1;
        this.tmplMetas = null;
        this.handlers = null;
        this.root = null;
        this.app = null;
        this.model = null;
        if (actions != null) {
            for (int i = 0; i < actions.Count; i = i + 1) { actions[i].active = false; }
            actions.Clear();
        }
        if (scopes != null) {
            for (int i = 0; i < scopes.Count; i = i + 1) {
                Control control = scopes[i].control;
                if (control != null) { control.item = null; control.itemAlias = ""; }
            }
            scopes.Clear();
        }
        if (rows != null) {
            if (retiringRows == null) { retiringRows = new List<ChildExpandedRow>(); }
            retiringRows.AddRange(rows);
            rows.Clear();
        }
        this.DrainRetiringRows();
    }
    private void DrainRetiringRows() {
        if (retiringRowsBusy || retiringRows == null) { return; }
        retiringRowsBusy = true;
        try {
            while (retiringRows.Count > 0) {
                int index = retiringRows.Count - 1;
                ChildExpandedRow row = retiringRows[index];
                this.DetachRow(row.rowRoot);
                retiringRows.RemoveAt(index);
            }
            retiringRows = null;
        } finally { retiringRowsBusy = false; }
    }
    public void SetApp(App a) {
        if (this.app != a) { this.RetireHostRegistration(); }
        this.app = a;
    }
    public App HostApp() { return this.app; }
    public AppLoopRegistration HostRegistration() { return this.hostRegistration; }
    public void Attach(App host) {
        if (host == null) { this.Detach(); return; }
        host.CheckLoopThread();
        if (!host.isRunning) { throw new InvalidOperationException("App loop has stopped"); }
        AppLoopRegistration old = this.hostRegistration;
        if (old != null && old.host == host && host.LiveLoopRegistration(old)) { return; }
        this.RetireHostRegistration();
        this.SetApp(host);
        ModelHostParticipant participant = new ModelHostParticipant();
        participant.binder = this;
        this.hostRegistration = host.RegisterLoopParticipant(this, participant);
        host.hostLayoutRevision = host.hostLayoutRevision + 1;
    }
    internal void RetireHostRegistration() {
        AppLoopRegistration previous = this.hostRegistration;
        this.hostRegistration = null;
        if (previous == null) { return; }
        App host = previous.host;
        if (previous.active && host != null) { host.hostLayoutRevision = host.hostLayoutRevision + 1; }
        previous.Invalidate();
    }
    private bool HostBindingCurrent(AppLoopRegistration ticket, int generation, Control tree, object state) {
        if (this.root != tree || this.model != state || this.hostRegistration != ticket) { return false; }
        if (ticket == null) { return true; }
        App host = this.app;
        return host != null && host.isRunning && ticket.active && ticket.generation == generation
            && ticket.host == host && ticket.owner != null;
    }
    public Control Root() { return this.root; }
    public object Model() { return this.model; }
    public JsonValue JsonModel() { return this.model is JsonValue ? (JsonValue)this.model : null; }
    public void Handle(string name, Action a) {
        if (this.handlers == null) { this.handlers = new HandlerRegistry(); }
        this.handlers.Set(name, a);
    }
    public void HandleArg(string name, Action<string> a) {
        if (this.handlers == null) { this.handlers = new HandlerRegistry(); }
        this.handlers.SetArg(name, a);
    }
    public void HandleItem(string name, ControlItemEvent a) {
        if (this.handlers == null) { this.handlers = new HandlerRegistry(); }
        this.handlers.SetItem(name, a);
    }
    public void HandleSender(string name, ControlEvent a) {
        if (this.handlers == null) { this.handlers = new HandlerRegistry(); }
        this.handlers.SetSender(name, a);
    }
    public bool HasHandler(string name) {
        return this.handlers != null && (this.handlers.Get(name) != null
            || this.handlers.GetArg(name) != null || this.handlers.GetSender(name) != null
            || this.handlers.GetItem(name) != null);
    }
    public void Wire() {
        if (this.root == null) { return; }
        AppLoopRegistration ticket = this.hostRegistration;
        int generation = ticket != null ? ticket.generation : 0;
        Control tree = this.root;
        object state = this.model;
        this.WireNodeCurrent(tree, ticket, generation, tree, state);
        if (!this.HostBindingCurrent(ticket, generation, tree, state)) { return; }
        this.RegisterTemplates(tree);
        if (!this.HostBindingCurrent(ticket, generation, tree, state)) { return; }
        this.RebuildValueBindings(tree);
        this.collectedStructureRevision = Control.BindingStructureRevision();
        if (!this.HostBindingCurrent(ticket, generation, tree, state)) { return; }
        this.SyncFromModel();
    }
    public void WireNode(Control c) {
        AppLoopRegistration ticket = this.hostRegistration;
        this.WireNodeCurrent(c, ticket, ticket != null ? ticket.generation : 0, this.root, this.model);
        this.CollectValueBindings(c);
    }
    private bool RefreshStructure(AppLoopRegistration ticket, int generation, Control tree, object state) {
        if (tree == null || this.collectedStructureRevision == Control.BindingStructureRevision()) { return true; }
        this.PruneDetachedTemplates(tree);
        this.WireNodeCurrent(tree, ticket, generation, tree, state);
        if (!this.HostBindingCurrent(ticket, generation, tree, state)) { return false; }
        this.PruneDetachedActions(tree);
        this.RegisterTemplates(tree);
        if (!this.HostBindingCurrent(ticket, generation, tree, state)) { return false; }
        this.RebuildValueBindings(tree);
        this.collectedStructureRevision = Control.BindingStructureRevision();
        return this.HostBindingCurrent(ticket, generation, tree, state);
    }
    private void RebuildValueBindings(Control tree) {
        List<ModelValueBinding> previous = this.valueBindings;
        this.valueBindings = null;
        this.CollectValueBindings(tree);
        if (previous == null || this.valueBindings == null) { return; }
        for (int i = 0; i < this.valueBindings.Count; i = i + 1) {
            ModelValueBinding binding = this.valueBindings[i];
            for (int j = 0; j < previous.Count; j = j + 1) {
                ModelValueBinding old = previous[j];
                if (old.control == binding.control && old.path == binding.path
                    && old.property == binding.property && old.twoWay == binding.twoWay) {
                    binding.snapshot = old.snapshot;
                    binding.hasSnapshot = old.hasSnapshot;
                    break;
                }
            }
        }
    }
    private bool InRoot(Control control, Control tree) {
        Control current = control;
        while (current != null) {
            if (current == tree) { return true; }
            current = current.parent;
        }
        return false;
    }
    private void PruneDetachedActions(Control tree) {
        if (this.wiredActions == null) { return; }
        for (int i = this.wiredActions.Count - 1; i >= 0; i = i - 1) {
            ModelBindingAction action = this.wiredActions[i];
            if (action.control == null || !this.InRoot(action.control, tree)) {
                action.active = false;
                this.wiredActions.RemoveAt(i);
            }
        }
    }
    private void PruneDetachedTemplates(Control tree) {
        if (this.tmplMetas == null) { return; }
        for (int i = this.tmplMetas.Count - 1; i >= 0; i = i - 1) {
            Control template = this.tmplMetas[i].template;
            if (template == null || !this.InRoot(template, tree)) { this.tmplMetas.RemoveAt(i); }
        }
    }
    private void CollectValueBindings(Control tree) {
        if (tree == null) { return; }
        this.CollectValueBindingsCurrent(tree);
    }
    private void CollectValueBindingsCurrent(Control c) {
        if (c == null || c.Kind() == "template") { return; }
        if (c.bindings != null) {
            for (int i = 0; i < c.bindings.Count; i = i + 1) {
                ModelBindingDeclaration declaration = c.bindings[i];
                if (this.FindValueBinding(c, declaration.path, declaration.property) == null) {
                    ModelValueBinding binding = new ModelValueBinding(c, declaration);
                    this.ValidateValueBinding(binding);
                    if (this.valueBindings == null) { this.valueBindings = new List<ModelValueBinding>(); }
                    this.valueBindings.Add(binding);
                }
            }
        }
        for (int j = 0; j < c.ChildCount(); j = j + 1) {
            this.CollectValueBindingsCurrent(c.ChildAt(j));
        }
    }
    private void ValidateValueBinding(ModelValueBinding binding) {
        Control c = binding.control;
        object scope = this.ScopeItemOf(c);
        if (binding.twoWay && (scope is JsonDoc || scope is JsonDocCursor)) {
            throw new InvalidOperationException("Two-way binding requires a writable model: " + binding.path);
        }
        if (binding.twoWay && scope != null && !(scope is JsonValue)
            && !(scope is Dictionary<string, string>) && !(scope is Dictionary<string, double>)
            && !(scope is Dictionary<string, bool>)) {
            string actualPath = ModelBinder.StripAlias(binding.path, this.ScopeAliasOf(c));
            string leaf = "";
            object target = ModelBinder.ResolveFieldScope(scope, actualPath, out leaf);
            if (target != null && target.HasField(leaf) && !ModelBinder.WritableField(target, leaf)) {
                throw new InvalidOperationException("Two-way binding requires a writable target: " + binding.path);
            }
        }
        int modelKind = this.ModelValueKind(c, binding.path);
        PropSpec spec = c.BindingSpec(binding.property, modelKind == 1);
        bool common = binding.property == "class" || binding.property == "disabled" || binding.property == "visible";
        if (binding.property != "" && spec != null && !spec.Answers(binding.property)) { spec = null; }
        if (spec == null && !common) {
            throw new ArgumentException("Unknown binding property '" + binding.property + "' on " + c.Kind());
        }
        int valueKind = spec != null ? spec.ValueKind() : (binding.property == "class" ? 0 : 2);
        if ((modelKind == 1 && valueKind == 2) || (modelKind == 2 && valueKind == 1)) {
            throw new ArgumentException("Binding type mismatch for '" + binding.path + "' on " + c.Kind());
        }
        string resolved = spec != null ? spec.key : binding.property;
        binding.modelKind = modelKind;
        if (this.valueBindings != null) {
            for (int i = 0; i < this.valueBindings.Count; i = i + 1) {
                ModelValueBinding other = this.valueBindings[i];
                if (other.control == c && this.BoundProperty(other) == resolved) {
                    throw new InvalidOperationException("Duplicate binding for property '" + resolved + "' on " + c.Kind());
                }
            }
        }
        binding.resolvedProperty = resolved;
        binding.valueKind = valueKind;
    }
    private ModelValueBinding FindValueBinding(Control c, string path, string property) {
        if (this.valueBindings == null) { return null; }
        for (int i = 0; i < this.valueBindings.Count; i = i + 1) {
            ModelValueBinding binding = this.valueBindings[i];
            if (binding.control == c && binding.path == path && binding.property == property) { return binding; }
        }
        return null;
    }
    private void WireNodeCurrent(Control c, AppLoopRegistration ticket, int generation, Control tree, object state) {
        if (c == null || !this.HostBindingCurrent(ticket, generation, tree, state)) { return; }
        for (int i = 0; i < c.events.Count; i = i + 1) {
            string evt = c.events[i].key;
            string hname = c.events[i].val;
            if (this.wiredActions == null) { this.wiredActions = new List<ModelBindingAction>(); }
            ModelBindingAction found = null;
            for (int k = 0; k < this.wiredActions.Count; k = k + 1) {
                ModelBindingAction candidate = this.wiredActions[k];
                if (candidate.control == c && candidate.evt == evt) { found = candidate; break; }
            }
            if (found != null) {
                found.hname = hname;
                found.arg = c.handlerArg;
                continue;
            }
            if (hname == "") { continue; }
            ModelBindingAction action = new ModelBindingAction();
            action.binder = this;
            action.control = c;
            action.evt = evt;
            action.hname = hname;
            action.arg = c.handlerArg;
            action.active = true;
            this.wiredActions.Add(action);
            c.BindEvent(evt, () => { action.Run(); });
            if (!this.HostBindingCurrent(ticket, generation, tree, state)) { return; }
        }
        App.AutoLinkTree(c, this.app);
        if (!this.HostBindingCurrent(ticket, generation, tree, state)) { return; }
        for (int j = 0; j < c.ChildCount(); j = j + 1) {
            this.WireNodeCurrent(c.ChildAt(j), ticket, generation, tree, state);
            if (!this.HostBindingCurrent(ticket, generation, tree, state)) { return; }
        }
    }
    void InvokeBindingAction(ModelBindingAction token) {
        Control c = token.control;
        if (!token.active || c == null || this.handlers == null || token.hname == "") { return; }
        ControlItemEvent itemAction = this.handlers.GetItem(token.hname);
        ControlEvent senderAction = this.handlers.GetSender(token.hname);
        Action<string> argAction = this.handlers.GetArg(token.hname);
        Action plainAction = this.handlers.Get(token.hname);
        if (itemAction != null) { itemAction(c, c.item); }
        else if (senderAction != null) { senderAction(c); }
        else if (token.arg != "" && argAction != null) { argAction(token.arg); }
        else if (plainAction != null) { plainAction(); }
        else { return; }
        if (!token.active) { return; }
        if (this.app != null) { this.app.RequestRedraw(); this.app.Wake(); }
    }
    internal bool NeedsFrameSync() {
        return this.root != null && (this.collectedStructureRevision != Control.BindingStructureRevision()
            || (this.valueBindings != null && this.valueBindings.Count > 0)
            || (this.tmplMetas != null && this.tmplMetas.Count > 0));
    }
    public void SyncFromModel() {
        if (this.model == null || this.root == null) { return; }
        AppLoopRegistration ticket = this.hostRegistration;
        int generation = ticket != null ? ticket.generation : 0;
        Control tree = this.root;
        object state = this.model;
        if (!this.HostBindingCurrent(ticket, generation, tree, state)) { return; }
        if (!this.RefreshStructure(ticket, generation, tree, state)) { return; }
        this.EnsureExpanded();
        if (!this.HostBindingCurrent(ticket, generation, tree, state)) { return; }
        if (!this.RefreshStructure(ticket, generation, tree, state)) { return; }
        this.SyncValuesFromModel(ticket, generation, tree, state);
    }
    public void SyncChangedNode(Control c) { this.SyncChangedValues(); }
    public void SyncChangedValues() {
        AppLoopRegistration ticket = this.hostRegistration;
        int generation = ticket != null ? ticket.generation : 0;
        Control tree = this.root;
        object state = this.model;
        if (!this.RefreshStructure(ticket, generation, tree, state)) { return; }
        if (this.valueBindings == null) { return; }
        for (int i = 0; i < this.valueBindings.Count; i = i + 1) {
            if (!this.HostBindingCurrent(ticket, generation, tree, state)) { return; }
            ModelValueBinding binding = this.valueBindings[i];
            Control c = binding.control;
            if (c == null || !binding.twoWay) { continue; }
            if (!binding.hasSnapshot) { continue; }
            string value = this.BoundValue(binding);
            if (!this.HostBindingCurrent(ticket, generation, tree, state)) { return; }
            if (!binding.hasSnapshot || value != binding.snapshot) {
                this.WriteBoundValue(binding, value);
                if (!this.HostBindingCurrent(ticket, generation, tree, state)) { return; }
                    }
        }
    }
    private void SyncValuesFromModel(AppLoopRegistration ticket, int generation, Control tree, object state) {
        if (this.valueBindings == null) { return; }
        for (int i = 0; i < this.valueBindings.Count; i = i + 1) {
            if (!this.HostBindingCurrent(ticket, generation, tree, state)) { return; }
            ModelValueBinding binding = this.valueBindings[i];
            Control c = binding.control;
            if (c == null) { continue; }
            string value = "";
            bool hasValue = this.TryResolveString(c, binding.path, out value);
            if (!this.HostBindingCurrent(ticket, generation, tree, state)) { return; }
            if (!hasValue) {
                throw new InvalidOperationException("Cannot resolve binding path '" + binding.path + "' on " + c.Kind());
            }
            string current = this.BoundValue(binding);
            if (!this.HostBindingCurrent(ticket, generation, tree, state)) { return; }
            if (!binding.twoWay || !binding.hasSnapshot || current == binding.snapshot) {
                string property = this.BoundProperty(binding);
                if (current != value) { c.SetProp(property, value); }
                if (!this.HostBindingCurrent(ticket, generation, tree, state)) { return; }
                binding.snapshot = this.BoundValue(binding);
                binding.hasSnapshot = true;
                if (!this.HostBindingCurrent(ticket, generation, tree, state)) { return; }
            }
        }
    }
    public static string StripAlias(string path, string alias) {
        if (alias != "" && path.StartsWith(alias + ".")) { return path.Substring(alias.Length + 1); }
        return path;
    }
    static string StrListJson(List<string> items) {
        JsonValue arr = JsonValue.NewArray();
        for (int i = 0; i < items.Count; i++) {
            arr.Append(JsonValue.NewStr(items[i]));
        }
        return arr.ToJson();
    }
    public object ScopeItemOf(Control c) {
        if (c != null && c.item != null) { return c.item; }
        ChildScopeBinding sb = this.ScopeBindingOf(c);
        if (sb != null && sb.item != null) { return sb.item; }
        return this.model;
    }
    public string ScopeAliasOf(Control c) {
        if (c != null && c.itemAlias != "") { return c.itemAlias; }
        ChildScopeBinding sb = this.ScopeBindingOf(c);
        if (sb != null) { return sb.alias; }
        return "";
    }
    static object ResolveFieldScope(object scope, string path, out string leafField) {
        leafField = path;
        if (scope == null || path == "") { return null; }
        int dot = path.IndexOf(".");
        if (dot < 0) { return scope; }
        object cur = scope;
        int start = 0;
        while (dot >= 0) {
            string segment = path.Substring(start, dot - start);
            if (!cur.HasField(segment)) { return null; }
            cur = cur.GetFieldObject(segment);
            if (cur == null) { return null; }
            start = dot + 1;
            dot = path.IndexOf(".", start);
        }
        leafField = path.Substring(start);
        return cur;
    }
    public bool TryResolveString(Control c, string path, out string result) {
        result = "";
        if (path == "") { return false; }
        object scope = this.ScopeItemOf(c);
        string alias = this.ScopeAliasOf(c);
        string actualPath = ModelBinder.StripAlias(path, alias);
        if (scope == null) { return false; }
        if (scope is JsonValue) {
            JsonValue jv = ((JsonValue)scope).PathGet(actualPath);
            if (jv != null) {
                if (jv.kind == 4 || jv.kind == 5) {
                    result = jv.ToJson();
                } else {
                    result = jv.AsString("");
                }
                return true;
            }
            if (scope != this.model && this.model != null && this.model is JsonValue) {
                JsonValue mv = ((JsonValue)this.model).PathGet(path);
                if (mv != null) {
                    if (mv.kind == 4 || mv.kind == 5) {
                        result = mv.ToJson();
                    } else {
                        result = mv.AsString("");
                    }
                    return true;
                }
            }
            return false;
        }
        if (scope is JsonDocCursor) {
            JsonDocCursor cur = (JsonDocCursor)scope;
            int slot = cur.doc.Path(cur.slot, actualPath);
            if (slot >= 0) {
                int k = cur.doc.KindAt(slot);
                if (k == 4 || k == 5) {
                    result = cur.doc.ToJson(slot);
                } else {
                    result = cur.doc.StrAt(slot, "");
                }
                return true;
            }
            return false;
        }
        if (scope is JsonDoc) {
            JsonDoc doc = (JsonDoc)scope;
            int slot = doc.Path(doc.root, actualPath);
            if (slot >= 0) {
                int k = doc.KindAt(slot);
                if (k == 4 || k == 5) {
                    result = doc.ToJson(slot);
                } else {
                    result = doc.StrAt(slot, "");
                }
                return true;
            }
            return false;
        }
        if (scope is Dictionary<string, string>) {
            Dictionary<string, string> dict = (Dictionary<string, string>)scope;
            if (dict.ContainsKey(actualPath)) {
                result = dict[actualPath];
                return true;
            }
            if (scope != this.model && this.model != null && this.model is Dictionary<string, string>) {
                Dictionary<string, string> mdict = (Dictionary<string, string>)this.model;
                if (mdict.ContainsKey(path)) {
                    result = mdict[path];
                    return true;
                }
            }
            return false;
        }
        if (scope is Dictionary<string, double>) {
            Dictionary<string, double> dict = (Dictionary<string, double>)scope;
            if (!dict.ContainsKey(actualPath)) { return false; }
            result = Convert.ToString(dict[actualPath]);
            return true;
        }
        if (scope is Dictionary<string, bool>) {
            Dictionary<string, bool> dict = (Dictionary<string, bool>)scope;
            if (!dict.ContainsKey(actualPath)) { return false; }
            result = PropSpec.Flag(dict[actualPath]);
            return true;
        }
        string leaf = "";
        object target = ModelBinder.ResolveFieldScope(scope, actualPath, out leaf);
        if (target != null && target.HasField(leaf)) {
            int valueKind = ModelBinder.FieldValueKind(target, leaf);
            if (valueKind == 1) {
                result = Convert.ToString(target.GetFieldDouble(leaf));
                return true;
            }
            if (valueKind == 2) {
                result = PropSpec.Flag(target.GetFieldBool(leaf));
                return true;
            }
            result = target.GetFieldString(leaf);
            if (result == "") {
                object fo = target.GetFieldObject(leaf);
                if (fo != null && fo is List<string>) {
                    result = ModelBinder.StrListJson((List<string>)fo);
                    return true;
                }
                if (fo != null && fo is JsonValue) {
                    JsonValue fj = (JsonValue)fo;
                    result = (fj.kind == 4 || fj.kind == 5) ? fj.ToJson() : fj.AsString("");
                    return true;
                }
                double d = target.GetFieldDouble(leaf);
                if (d != 0.0) {
                    result = Convert.ToString(d);
                } else if (target.GetFieldBool(leaf)) {
                    result = "true";
                }
            }
            return true;
        }
        if (scope != this.model && this.model != null) {
            string mleaf = "";
            object mtarget = ModelBinder.ResolveFieldScope(this.model, path, out mleaf);
            if (mtarget != null && mtarget.HasField(mleaf)) {
                result = mtarget.GetFieldString(mleaf);
                return true;
            }
        }
        return false;
    }
    static int TypeNameKind(string name) {
        if (name == "bool") { return 2; }
        if (name == "int" || name == "long" || name == "double"
            || name == "float" || name == "byte" || name == "short"
            || name == "uint" || name == "ulong" || name == "ushort") { return 1; }
        return 0;
    }
    static int FieldValueKind(object target, string leaf) {
        TypeInfo type = target.GetType();
        for (int i = 0; i < type.FieldCount; i = i + 1) {
            if (type.GetFieldName(i) == leaf) { return ModelBinder.TypeNameKind(type.GetFieldType(i)); }
        }
        for (int i = 0; i < type.MethodCount; i = i + 1) {
            if (type.GetMethodName(i) == "get_" + leaf) {
                return ModelBinder.TypeNameKind(type.GetMethodReturnType(i));
            }
        }
        return 0;
    }
    static bool WritableField(object target, string leaf) {
        TypeInfo type = target.GetType();
        bool getter = false;
        for (int i = 0; i < type.MethodCount; i = i + 1) {
            string method = type.GetMethodName(i);
            if (method == "set_" + leaf) { return true; }
            if (method == "get_" + leaf) { getter = true; }
        }
        if (getter) { return false; }
        for (int i = 0; i < type.FieldCount; i = i + 1) {
            if (type.GetFieldName(i) == leaf) { return true; }
        }
        return false;
    }
    int ModelValueKind(Control c, string bindingPath) {
        object scope = this.ScopeItemOf(c);
        if (scope == null) { return 0; }
        string path = ModelBinder.StripAlias(bindingPath, this.ScopeAliasOf(c));
        if (scope is JsonValue) {
            JsonValue v = ((JsonValue)scope).PathGet(path);
            if (v == null && scope != this.model && this.model is JsonValue) {
                v = ((JsonValue)this.model).PathGet(bindingPath);
            }
            if (v != null && v.IsNumber()) { return 1; }
            if (v != null && v.IsBool()) { return 2; }
            return 0;
        }
        if (scope is JsonDocCursor) {
            JsonDocCursor cur = (JsonDocCursor)scope;
            int slot = cur.doc.Path(cur.slot, path);
            if (slot < 0) { return 0; }
            int kind = cur.doc.KindAt(slot);
            return kind == 2 ? 1 : (kind == 1 ? 2 : 0);
        }
        if (scope is JsonDoc) {
            JsonDoc doc = (JsonDoc)scope;
            int slot = doc.Path(doc.root, path);
            if (slot < 0) { return 0; }
            int kind = doc.KindAt(slot);
            return kind == 2 ? 1 : (kind == 1 ? 2 : 0);
        }
        if (scope is Dictionary<string, double>) { return 1; }
        if (scope is Dictionary<string, bool>) { return 2; }
        if (scope is Dictionary<string, string>) { return 0; }
        string leaf = "";
        object target = ModelBinder.ResolveFieldScope(scope, path, out leaf);
        if (target != null && target.HasField(leaf)) { return ModelBinder.FieldValueKind(target, leaf); }
        if (scope != this.model && this.model != null) {
            target = ModelBinder.ResolveFieldScope(this.model, bindingPath, out leaf);
            if (target != null && target.HasField(leaf)) { return ModelBinder.FieldValueKind(target, leaf); }
        }
        return 0;
    }
    string BoundProperty(ModelValueBinding binding) { return binding.resolvedProperty; }
    string BoundValue(ModelValueBinding binding) {
        Control c = binding.control;
        return c != null ? c.GetProp(this.BoundProperty(binding)) : "";
    }
    void WriteBoundValue(ModelValueBinding binding, string s) {
        Control c = binding.control;
        if (c == null) { return; }
        AppLoopRegistration ticket = this.hostRegistration;
        int generation = ticket != null ? ticket.generation : 0;
        Control tree = this.root;
        object state = this.model;
        int valueKind = binding.valueKind;
        int modelKind = binding.modelKind;
        bool numericInput = valueKind == 1 || modelKind == 1;
        bool boolInput = valueKind == 2 || modelKind == 2;
        if (numericInput && s.Trim() != "") {
            double parsed = 0.0;
            if (!double.TryParse(s.Trim(), out parsed)) {
                throw new ArgumentException("Invalid numeric value for binding '" + binding.path + "'");
            }
        }
        if (boolInput && s != "true" && s != "false") {
            throw new ArgumentException("Invalid Boolean value for binding '" + binding.path + "'");
        }
        object scope = this.ScopeItemOf(c);
        string alias = this.ScopeAliasOf(c);
        string actualPath = ModelBinder.StripAlias(binding.path, alias);
        if (scope != null) {
            if (scope is JsonValue) {
                JsonValue jscope = (JsonValue)scope;
                if (modelKind == 1) {
                    string ns = s.Trim();
                    if (ns == "") { ns = "0"; }
                    jscope.PathSetValue(actualPath, JsonValue.NewNum(ns));
                } else if (modelKind == 2) {
                    jscope.PathSetValue(actualPath, JsonValue.NewBool(s == "true"));
                } else {
                    jscope.PathSet(actualPath, s);
                }
            } else if (scope is JsonDocCursor || scope is JsonDoc) {
            } else if (scope is Dictionary<string, string>) {
                Dictionary<string, string> dict = (Dictionary<string, string>)scope;
                dict[actualPath] = s;
            } else if (scope is Dictionary<string, double>) {
                Dictionary<string, double> dict = (Dictionary<string, double>)scope;
                dict[actualPath] = s != "" ? s.ToDouble() : 0.0;
            } else if (scope is Dictionary<string, bool>) {
                Dictionary<string, bool> dict = (Dictionary<string, bool>)scope;
                dict[actualPath] = (s == "true");
            } else {
                string leaf = "";
                object target = ModelBinder.ResolveFieldScope(scope, actualPath, out leaf);
                if (target != null) {
                    bool wrote = false;
                    if (modelKind == 1) {
                        double numVal = s != "" ? s.ToDouble() : 0.0;
                        wrote = target.SetFieldDouble(leaf, numVal);
                    } else if (modelKind == 2) {
                        wrote = target.SetFieldBool(leaf, s == "true");
                    } else {
                        wrote = target.SetFieldString(leaf, s);
                    }
                    if (!wrote) {
                        throw new InvalidOperationException("Binding target is unknown, read-only or type-incompatible: " + binding.path);
                    }
                } else {
                    throw new InvalidOperationException("Cannot resolve binding target: " + binding.path);
                }
            }
            if (!this.HostBindingCurrent(ticket, generation, tree, state)) { return; }
            binding.snapshot = s;
            binding.hasSnapshot = true;
                return;
        }
    }
}
