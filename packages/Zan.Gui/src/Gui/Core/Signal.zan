using System;

namespace Gui;

// 控件内部状态缓冲快捷工厂。
public class Signal {
    public static SignalInt Int(int initial) { return new SignalInt(initial); }
    public static SignalBool Bool(bool initial) { return new SignalBool(initial); }
    public static SignalString String(string initial) { return new SignalString(initial); }
}

// 语义：可变值 + 单调递增版本号。渲染帧轮询 `Version()`（或直接
// 比对值）即可检测变化——Gui 的变更路径是帧轮询，不是事件订阅。
// 对外数据绑定统一走 `System/Binding.zan` 的 `Binding<T>`
// （`control.data = model.field;` 编译器降级为实时存取器对）。
// 通道契约见 docs/STDLIB_COMPONENT_STANDARDS.md §6。
public class SignalInt {
    int val;
    int version;

    public SignalInt(int initial) {
        this.val = initial;
        this.version = 0;
    }

    public int Get() { return val; }

    public void Set(int v) {
        val = v;
        version = version + 1;
    }

    public int Version() { return version; }
}

// 布尔版内部状态缓冲：可变值 + 单调递增版本号，
// 渲染帧轮询 Version() 检测变化（契约同 SignalInt）。
public class SignalBool {
    bool val;
    int version;

    public SignalBool(bool initial) {
        this.val = initial;
        this.version = 0;
    }

    public bool Get() { return val; }

    public void Set(bool v) {
        val = v;
        version = version + 1;
    }

    public void Toggle() {
        val = !val;
        version = version + 1;
    }

    public int Version() { return version; }
}

// 字符串版内部状态缓冲：可变值 + 单调递增版本号，
// 渲染帧轮询 Version() 检测变化（契约同 SignalInt）。
public class SignalString {
    string val;
    int version;

    public SignalString(string initial) {
        this.val = initial;
        this.version = 0;
    }

    public string Get() { return val; }

    public void Set(string v) {
        val = v;
        version = version + 1;
    }

    public int Version() { return version; }
}
