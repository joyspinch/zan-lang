using System;
namespace Gui.Backend;
public partial class UiDriver {
    static bool ExecuteCommand(UiDriverSession s, string line, int sourceLine) {
        int previousLine = s.commandLine;
        int previousErrors = s.commandErrors;
        s.commandLine = sourceLine;
        bool completed = false;
        try {
            bool yield = UiDriver.ExecCore(s, line);
            completed = true;
            return yield;
        } finally {
            try {
                if (!completed && s.commandErrors == previousErrors) {
                    try { UiDriver.CommandError(s, "command threw"); }
                    catch (Exception diagnosticError) { }
                }
            } finally { s.commandLine = previousLine; }
        }
    }
    static void CommandError(UiDriverSession s, string reason) {
        s.commandErrors = s.commandErrors + 1;
        UiDriver.Note(s, "COMMAND ERROR line=" + Convert.ToString(s.commandLine) + " " + reason);
    }
}
