using System;

namespace Gui.Animation;

/// <summary>
/// 缓动类型常量（A356 P0 动画引擎基座）。
/// 包含常用曲线族：线性、二次、三次、四次、正弦、指数、圆弧、回弹、弹跳与弹性。
/// </summary>
class EaseType {
    public const int Linear = 0;
    public const int QuadIn = 1;
    public const int QuadOut = 2;
    public const int QuadInOut = 3;
    public const int CubicIn = 4;
    public const int CubicOut = 5;
    public const int CubicInOut = 6;
    public const int QuartIn = 7;
    public const int QuartOut = 8;
    public const int QuartInOut = 9;
    public const int SineIn = 10;
    public const int SineOut = 11;
    public const int SineInOut = 12;
    public const int ExpoIn = 13;
    public const int ExpoOut = 14;
    public const int ExpoInOut = 15;
    public const int CircIn = 16;
    public const int CircOut = 17;
    public const int CircInOut = 18;
    public const int BackIn = 19;
    public const int BackOut = 20;
    public const int BackInOut = 21;
    public const int BounceOut = 22;
    public const int BounceIn = 23;
    public const int BounceInOut = 24;
    public const int ElasticOut = 25;
    public const int ElasticIn = 26;
    public const int ElasticInOut = 27;
}

/// <summary>
/// 标准缓动方程求值器。将 [0, 1] 的归一化进度映射为指定曲线的插值因子。
/// </summary>
class Easing {
    const float PI = 3.14159265f;
    const float HALF_PI = 1.57079632f;

    /// <summary>
    /// 对指定缓动类型计算归一化时间 t 在 [0, 1] 上的插值因子。
    /// </summary>
    public static float Evaluate(int easeType, float t) {
        if (t <= 0.0f) { return 0.0f; }
        if (t >= 1.0f) { return 1.0f; }

        if (easeType == EaseType.Linear) { return t; }

        // Quad
        if (easeType == EaseType.QuadIn) { return t * t; }
        if (easeType == EaseType.QuadOut) { return t * (2.0f - t); }
        if (easeType == EaseType.QuadInOut) {
            if (t < 0.5f) { return 2.0f * t * t; }
            return -1.0f + (4.0f - 2.0f * t) * t;
        }

        // Cubic
        if (easeType == EaseType.CubicIn) { return t * t * t; }
        if (easeType == EaseType.CubicOut) {
            float f = t - 1.0f;
            return f * f * f + 1.0f;
        }
        if (easeType == EaseType.CubicInOut) {
            if (t < 0.5f) { return 4.0f * t * t * t; }
            float f = 2.0f * t - 2.0f;
            return 0.5f * f * f * f + 1.0f;
        }

        // Quart
        if (easeType == EaseType.QuartIn) { return t * t * t * t; }
        if (easeType == EaseType.QuartOut) {
            float f = t - 1.0f;
            return 1.0f - f * f * f * f;
        }
        if (easeType == EaseType.QuartInOut) {
            if (t < 0.5f) { return 8.0f * t * t * t * t; }
            float f = t - 1.0f;
            return 1.0f - 8.0f * f * f * f * f;
        }

        // Sine
        if (easeType == EaseType.SineIn) {
            return 1.0f - (float)Math.Cos(t * HALF_PI);
        }
        if (easeType == EaseType.SineOut) {
            return (float)Math.Sin(t * HALF_PI);
        }
        if (easeType == EaseType.SineInOut) {
            return 0.5f * (1.0f - (float)Math.Cos(PI * t));
        }

        // Expo
        if (easeType == EaseType.ExpoIn) {
            return (float)Math.Pow(2.0, 10.0 * (t - 1.0));
        }
        if (easeType == EaseType.ExpoOut) {
            return 1.0f - (float)Math.Pow(2.0, -10.0 * t);
        }
        if (easeType == EaseType.ExpoInOut) {
            if (t < 0.5f) {
                return 0.5f * (float)Math.Pow(2.0, 10.0 * (2.0 * t - 1.0));
            }
            return 0.5f * (2.0f - (float)Math.Pow(2.0, -10.0 * (2.0 * t - 1.0)));
        }

        // Circ
        if (easeType == EaseType.CircIn) {
            return 1.0f - (float)Math.Sqrt(1.0 - (double)(t * t));
        }
        if (easeType == EaseType.CircOut) {
            float f = t - 1.0f;
            return (float)Math.Sqrt(1.0 - (double)(f * f));
        }
        if (easeType == EaseType.CircInOut) {
            if (t < 0.5f) {
                return 0.5f * (1.0f - (float)Math.Sqrt(1.0 - 4.0 * (double)(t * t)));
            }
            float f = 2.0f * t - 2.0f;
            return 0.5f * ((float)Math.Sqrt(1.0 - (double)(f * f)) + 1.0f);
        }

        // Back
        float s = 1.70158f;
        if (easeType == EaseType.BackIn) {
            return t * t * ((s + 1.0f) * t - s);
        }
        if (easeType == EaseType.BackOut) {
            float f = t - 1.0f;
            return f * f * ((s + 1.0f) * f + s) + 1.0f;
        }
        if (easeType == EaseType.BackInOut) {
            float s2 = s * 1.525f;
            float t2 = t * 2.0f;
            if (t2 < 1.0f) {
                return 0.5f * (t2 * t2 * ((s2 + 1.0f) * t2 - s2));
            }
            float f = t2 - 2.0f;
            return 0.5f * (f * f * ((s2 + 1.0f) * f + s2) + 2.0f);
        }

        // Bounce
        if (easeType == EaseType.BounceOut) {
            return Easing.BounceOutCore(t);
        }
        if (easeType == EaseType.BounceIn) {
            return 1.0f - Easing.BounceOutCore(1.0f - t);
        }
        if (easeType == EaseType.BounceInOut) {
            if (t < 0.5f) {
                return 0.5f * (1.0f - Easing.BounceOutCore(1.0f - 2.0f * t));
            }
            return 0.5f * Easing.BounceOutCore(2.0f * t - 1.0f) + 0.5f;
        }

        // Elastic
        if (easeType == EaseType.ElasticOut) {
            double p = 0.3;
            return (float)(Math.Pow(2.0, -10.0 * (double)t) * Math.Sin(((double)t - p / 4.0) * (2.0 * 3.1415926535) / p) + 1.0);
        }
        if (easeType == EaseType.ElasticIn) {
            double p = 0.3;
            double f = (double)t - 1.0;
            return (float)(-Math.Pow(2.0, 10.0 * f) * Math.Sin((f - p / 4.0) * (2.0 * 3.1415926535) / p));
        }

        return t;
    }

    static float BounceOutCore(float t) {
        if (t < 1.0f / 2.75f) {
            return 7.5625f * t * t;
        }
        if (t < 2.0f / 2.75f) {
            float f = t - 1.5f / 2.75f;
            return 7.5625f * f * f + 0.75f;
        }
        if (t < 2.5f / 2.75f) {
            float f = t - 2.25f / 2.75f;
            return 7.5625f * f * f + 0.9375f;
        }
        float f2 = t - 2.625f / 2.75f;
        return 7.5625f * f2 * f2 + 0.984375f;
    }
}
