using System;
using Gui;
namespace Gui.Animation;
public class Easing {
    const float PI = 3.14159265f;
    const float HALF_PI = 1.57079632f;
    public static float Evaluate(int easeType, float t) {
        if (t != t || t <= 0.0f) { return 0.0f; }
        if (t >= 1.0f) { return 1.0f; }
        if (easeType == EaseType.Linear) { return t; }
        if (easeType == EaseType.QuadIn) { return t * t; }
        if (easeType == EaseType.QuadOut) { return t * (2.0f - t); }
        if (easeType == EaseType.QuadInOut) {
            if (t < 0.5f) { return 2.0f * t * t; }
            return -1.0f + (4.0f - 2.0f * t) * t;
        }
        if (easeType == EaseType.CubicIn) { return t * t * t; }
        if (easeType == EaseType.CubicOut) {
            float f = t - 1.0f;
            return f * f * f + 1.0f;
        }
        if (easeType == EaseType.CubicInOut) {
            if (t < 0.5f) { return 4.0f * t * t * t; }
            float f = 2.0f * t - 2.0f;
            return 0.5f * f * f * f + 1.0f;
        }
        if (easeType == EaseType.QuartIn) { return t * t * t * t; }
        if (easeType == EaseType.QuartOut) {
            float f = t - 1.0f;
            return 1.0f - f * f * f * f;
        }
        if (easeType == EaseType.QuartInOut) {
            if (t < 0.5f) { return 8.0f * t * t * t * t; }
            float f = t - 1.0f;
            return 1.0f - 8.0f * f * f * f * f;
        }
        if (easeType == EaseType.SineIn) { return 1.0f - (float)Math.Cos(t * HALF_PI); }
        if (easeType == EaseType.SineOut) { return (float)Math.Sin(t * HALF_PI); }
        if (easeType == EaseType.SineInOut) { return 0.5f * (1.0f - (float)Math.Cos(PI * t)); }
        if (easeType == EaseType.ExpoIn) { return (float)Math.Pow(2.0, 10.0 * (t - 1.0)); }
        if (easeType == EaseType.ExpoOut) { return 1.0f - (float)Math.Pow(2.0, -10.0 * t); }
        if (easeType == EaseType.ExpoInOut) {
            if (t < 0.5f) { return 0.5f * (float)Math.Pow(2.0, 10.0 * (2.0 * t - 1.0)); }
            return 0.5f * (2.0f - (float)Math.Pow(2.0, -10.0 * (2.0 * t - 1.0)));
        }
        if (easeType == EaseType.CircIn) { return 1.0f - (float)Math.Sqrt(Math.Max(0.0, 1.0 - (double)(t * t))); }
        if (easeType == EaseType.CircOut) {
            float f = t - 1.0f;
            return (float)Math.Sqrt(Math.Max(0.0, 1.0 - (double)(f * f)));
        }
        if (easeType == EaseType.CircInOut) {
            if (t < 0.5f) { return 0.5f * (1.0f - (float)Math.Sqrt(Math.Max(0.0, 1.0 - 4.0 * (double)(t * t)))); }
            float f = 2.0f * t - 2.0f;
            return 0.5f * ((float)Math.Sqrt(Math.Max(0.0, 1.0 - (double)(f * f))) + 1.0f);
        }
        float s = 1.70158f;
        if (easeType == EaseType.BackIn) { return t * t * ((s + 1.0f) * t - s); }
        if (easeType == EaseType.BackOut) {
            float f = t - 1.0f;
            return f * f * ((s + 1.0f) * f + s) + 1.0f;
        }
        if (easeType == EaseType.BackInOut) {
            float s2 = s * 1.525f;
            float t2 = t * 2.0f;
            if (t2 < 1.0f) { return 0.5f * (t2 * t2 * ((s2 + 1.0f) * t2 - s2)); }
            float f = t2 - 2.0f;
            return 0.5f * (f * f * ((s2 + 1.0f) * f + s2) + 2.0f);
        }
        if (easeType == EaseType.BounceOut) { return Easing.BounceOutCore(t); }
        if (easeType == EaseType.BounceIn) { return 1.0f - Easing.BounceOutCore(1.0f - t); }
        if (easeType == EaseType.BounceInOut) {
            if (t < 0.5f) { return 0.5f * (1.0f - Easing.BounceOutCore(1.0f - 2.0f * t)); }
            return 0.5f * Easing.BounceOutCore(2.0f * t - 1.0f) + 0.5f;
        }
        if (easeType == EaseType.ElasticOut) {
            double p = 0.3;
            return (float)(Math.Pow(2.0, -10.0 * (double)t) * Math.Sin(((double)t - p / 4.0) * (2.0 * 3.1415926535) / p) + 1.0);
        }
        if (easeType == EaseType.ElasticIn) {
            double p = 0.3;
            double f = (double)t - 1.0;
            return (float)(-Math.Pow(2.0, 10.0 * f) * Math.Sin((f - p / 4.0) * (2.0 * 3.1415926535) / p));
        }
        if (easeType == EaseType.ElasticInOut) {
            double p = 0.45;
            double t2 = (double)t * 2.0;
            if (t2 < 1.0) {
                double f = t2 - 1.0;
                return (float)(-0.5 * Math.Pow(2.0, 10.0 * f) * Math.Sin((f - p / 4.0) * (2.0 * 3.1415926535) / p));
            }
            double f2 = t2 - 1.0;
            return (float)(Math.Pow(2.0, -10.0 * f2) * Math.Sin((f2 - p / 4.0) * (2.0 * 3.1415926535) / p) * 0.5 + 1.0);
        }
        if (easeType == EaseType.CssEase) { return Easing.CubicBezier(0.25f, 0.1f, 0.25f, 1.0f, t); }
        if (easeType == EaseType.CssEaseIn) { return Easing.CubicBezier(0.42f, 0.0f, 1.0f, 1.0f, t); }
        if (easeType == EaseType.CssEaseOut) { return Easing.CubicBezier(0.0f, 0.0f, 0.58f, 1.0f, t); }
        if (easeType == EaseType.CssEaseInOut) { return Easing.CubicBezier(0.42f, 0.0f, 0.58f, 1.0f, t); }
        return t;
    }
    public static float CubicBezier(float x1, float y1, float x2, float y2, float x) {
        return MotionSpec.CubicBezier(x1, y1, x2, y2, x);
    }
    public static float Steps(int count, bool jumpEnd, float t) {
        return MotionSpec.Steps(count, jumpEnd, t);
    }
    static float BounceOutCore(float t) {
        if (t < 1.0f / 2.75f) { return 7.5625f * t * t; }
        if (t < 2.0f / 2.75f) {
            float f = t - 1.5f / 2.75f;
            return 7.5625f * f * f + 0.75f;
        }
        if (t < 2.5f / 2.75f) {
            float f = t - 2.25f / 2.75f;
            return 7.5625f * f * f + 0.9375f;
        }
        float f2 = t - 2.625f / 2.75f;
        return 7.5625f * f2 * f2 + 0.984375f;
    }
}
