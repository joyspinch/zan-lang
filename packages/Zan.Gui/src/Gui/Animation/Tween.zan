using System;

namespace Gui.Animation;

// 值动画更新回调。
delegate void TweenUpdate(float value);

// 值动画完成回调。
delegate void TweenCallback();

// 通用值动画（动画引擎基座）：把浮点值从 from 缓动到 to。
// 既可由 Timeline 自动按需出帧调度，也可脱机手动 Step(dt)。
class Tween {
    public float fromVal;
    public float toVal;
    public int durationMs;
    public int elapsedMs;
    public int easeType;
    public bool active;
    public bool finished;
    public TweenUpdate updateAction;
    public TweenCallback completeAction;

    public Tween() {
        this.fromVal = 0.0f;
        this.toVal = 1.0f;
        this.durationMs = 300;
        this.elapsedMs = 0;
        this.easeType = EaseType.QuadOut;
        this.active = false;
        this.finished = false;
    }

    // 便捷创建并配置值动画。
    public static Tween Create(float fromVal, float toVal, int durationMs,
                                int easeType, TweenUpdate onUpdate) {
        Tween t = new Tween();
        t.fromVal = fromVal;
        t.toVal = toVal;
        t.durationMs = durationMs > 0 ? durationMs : 1;
        t.easeType = easeType;
        t.updateAction = onUpdate;
        return t;
    }

    // 配置完成时的回调。
    public Tween OnComplete(TweenCallback onComplete) {
        this.completeAction = onComplete;
        return this;
    }

    // 开始播放动画。
    public Tween Play() {
        this.active = true;
        this.finished = false;
        this.elapsedMs = 0;
        if (this.updateAction != null) {
            float k = Easing.Evaluate(this.easeType, 0.0f);
            this.updateAction(this.fromVal + (this.toVal - this.fromVal) * k);
        }
        return this;
    }

    // 暂停动画。
    public void Pause() {
        this.active = false;
    }

    // 恢复播放。
    public void Resume() {
        if (!this.finished) { this.active = true; }
    }

    // 停止并重置动画。
    public void Stop() {
        this.active = false;
        this.finished = false;
        this.elapsedMs = 0;
    }

    // 推进时间 deltaMs。返回是否仍在活跃播放。
    public bool Step(int deltaMs) {
        if (!this.active || this.finished) { return false; }
        this.elapsedMs = this.elapsedMs + deltaMs;
        float progress = (float)this.elapsedMs / (float)this.durationMs;
        if (progress >= 1.0f) {
            progress = 1.0f;
            this.finished = true;
            this.active = false;
        }
        float factor = Easing.Evaluate(this.easeType, progress);
        float current = this.fromVal + (this.toVal - this.fromVal) * factor;
        if (this.updateAction != null) {
            this.updateAction(current);
        }
        if (this.finished && this.completeAction != null) {
            this.completeAction();
        }
        return !this.finished;
    }
}
