using System;
namespace Gui.Animation;
public delegate void TweenUpdate(float value);
public delegate void TweenCallback();
public class Tween {
    public float fromVal;
    public float toVal;
    public int durationMs;
    public float invDurationMs;
    public int elapsedMs;
    public int easeType;
    public bool active;
    public bool finished;
    public TweenUpdate updateAction;
    public TweenCallback completeAction;
    int playback;
    public Tween() {
        this.fromVal = 0.0f;
        this.toVal = 1.0f;
        this.durationMs = 300;
        this.invDurationMs = 1.0f / 300.0f;
        this.elapsedMs = 0;
        this.easeType = EaseType.QuadOut;
        this.active = false;
        this.finished = false;
    }
    public static Tween Create(float fromVal, float toVal, int durationMs,
                                int easeType, TweenUpdate onUpdate) {
        Tween t = new Tween();
        t.fromVal = fromVal;
        t.toVal = toVal;
        int dur = durationMs > 0 ? durationMs : 1;
        t.durationMs = dur;
        t.invDurationMs = 1.0f / (float)dur;
        t.easeType = easeType;
        t.updateAction = onUpdate;
        return t;
    }
    public void OnComplete(TweenCallback onComplete) { this.completeAction = onComplete; }
    public void Play() {
        this.playback = this.playback + 1;
        this.active = true;
        this.finished = false;
        this.elapsedMs = 0;
        if (this.updateAction != null) {
            float k = Easing.Evaluate(this.easeType, 0.0f);
            this.updateAction(this.fromVal + (this.toVal - this.fromVal) * k);
        }
    }
    public void Pause() { this.active = false; }
    public void Resume() {
        if (!this.finished) { this.active = true; }
    }
    public void Stop() {
        this.playback = this.playback + 1;
        this.active = false;
        this.finished = false;
        this.elapsedMs = 0;
    }
    public bool Step(int deltaMs) {
        if (!this.active || this.finished) { return false; }
        long elapsed = (long)this.elapsedMs + deltaMs;
        this.elapsedMs = elapsed >= this.durationMs ? this.durationMs : (int)elapsed;
        float progress = (float)this.elapsedMs * this.invDurationMs;
        if (elapsed >= this.durationMs || progress >= 1.0f) {
            this.finished = true;
            this.active = false;
        }
        int run = this.playback;
        if (this.updateAction != null) {
            float current = this.finished ? this.toVal
                : this.fromVal + (this.toVal - this.fromVal) * Easing.Evaluate(this.easeType, progress);
            this.updateAction(current);
        }
        if (this.playback == run && this.finished && this.completeAction != null) { this.completeAction(); }
        return this.active && !this.finished;
    }
}
