using System;
using Gui;
namespace Gui.Animation;
public delegate void Spring2DUpdate(float x, float y);
// 二维速度连续阻尼弹簧：适用于拖拽松手、悬浮卡片跟随、2D FLIP 位移等场景。
public class Spring2D {
    public SpringAnim x;
    public SpringAnim y;
    public Spring2DUpdate updateAction;
    public TweenCallback completeAction;
    public bool active;
    public bool finished;
    int playback;
    public Spring2D(SpringAnim sx, SpringAnim sy, Spring2DUpdate onUpdate) {
        this.x = sx != null ? sx : new SpringAnim();
        this.y = sy != null ? sy : new SpringAnim();
        this.updateAction = onUpdate;
        this.active = false;
        this.finished = false;
    }
    public static Spring2D Create(float fromX, float fromY, float toX, float toY,
                                  float stiffness, float damping, float mass,
                                  Spring2DUpdate onUpdate) {
        SpringAnim sx = SpringAnim.Create(fromX, toX, stiffness, damping, mass, null);
        SpringAnim sy = SpringAnim.Create(fromY, toY, stiffness, damping, mass, null);
        return new Spring2D(sx, sy, onUpdate);
    }
    public static Spring2D FromDurationBounce(float fromX, float fromY, float toX, float toY,
                                              float durationSec, float bounce,
                                              Spring2DUpdate onUpdate) {
        float k = 260.0f; float c = 22.0f;
        MotionSpec.SpringFromBounce(durationSec, bounce, out k, out c);
        return Spring2D.Create(fromX, fromY, toX, toY, k, c, 1.0f, onUpdate);
    }
    public static Spring2D Snappy(float fromX, float fromY, float toX, float toY, Spring2DUpdate onUpdate) {
        return Spring2D.Create(fromX, fromY, toX, toY, 420.0f, 28.0f, 1.0f, onUpdate);
    }
    public static Spring2D Smooth(float fromX, float fromY, float toX, float toY, Spring2DUpdate onUpdate) {
        return Spring2D.Create(fromX, fromY, toX, toY, 220.0f, 26.0f, 1.0f, onUpdate);
    }
    public static Spring2D Bouncy(float fromX, float fromY, float toX, float toY, Spring2DUpdate onUpdate) {
        return Spring2D.Create(fromX, fromY, toX, toY, 280.0f, 15.0f, 1.0f, onUpdate);
    }
    public Spring2D WithVelocity(float vx, float vy) {
        if (this.x != null) { this.x.WithVelocity(vx); }
        if (this.y != null) { this.y.WithVelocity(vy); }
        return this;
    }
    public void OnComplete(TweenCallback onComplete) { this.completeAction = onComplete; }
    public void Play() {
        this.playback = this.playback + 1;
        this.active = true;
        this.finished = false;
        if (this.x != null) { this.x.Play(); }
        if (this.y != null) { this.y.Play(); }
        Spring2DUpdate onUpd = this.updateAction;
        if (onUpd != null && this.x != null && this.y != null) { onUpd(this.x.value, this.y.value); }
    }
    public void Retarget(float toX, float toY) {
        this.playback = this.playback + 1;
        this.active = true;
        this.finished = false;
        if (this.x != null) { this.x.Retarget(toX); }
        if (this.y != null) { this.y.Retarget(toY); }
    }
    public void Stop() {
        this.playback = this.playback + 1;
        this.active = false;
        this.finished = false;
        if (this.x != null) { this.x.Stop(); }
        if (this.y != null) { this.y.Stop(); }
    }
    public bool Step(int deltaMs) {
        if (!this.active || this.finished || deltaMs <= 0) { return false; }
        if (this.x == null || this.y == null) {
            this.active = false;
            this.finished = true;
            return false;
        }
        int run = this.playback;
        bool rx = this.x.Step(deltaMs);
        bool ry = this.y.Step(deltaMs);
        if (this.playback != run) { return this.active && !this.finished; }
        Spring2DUpdate onUpd = this.updateAction;
        if (onUpd != null) { onUpd(this.x.value, this.y.value); }
        if (this.playback != run) { return this.active && !this.finished; }
        if (!rx && !ry) {
            this.active = false;
            this.finished = true;
            TweenCallback cb = this.completeAction;
            if (cb != null) { cb(); }
            return false;
        }
        return true;
    }
}
