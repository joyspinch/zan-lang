using System;
using System.Collections.Generic;
using Gui;
using Gui.Backend;
namespace Gui.Animation;
internal struct TimelineTween {
    internal Tween tween;
    internal int addedAtMs;
    internal TimelineTween(Tween tween, int addedAtMs) {
        this.tween = tween;
        this.addedAtMs = addedAtMs;
    }
}
public class AnimationTimeline : AppLoopOwner, AppLoopParticipant, AppLoopStopped {
    static AnimationTimeline shared;
    public static AnimationTimeline Shared {
        get {
            if (shared == null) { shared = new AnimationTimeline(); }
            return shared;
        }
    }
    List<TimelineTween> tweens = new List<TimelineTween>();
    FrameCadence cadence = new FrameCadence();
    weak App boundApp;
    weak AppLoopRegistration registration;
    int lastTickMs;
    int nextTickMs = -1;
    bool ticking;
    public void BindApp(App app) {
        if (app != null && !app.isRunning) { app = null; }
        if (this.boundApp == app) { return; }
        this.Unregister();
        this.boundApp = app;
        if (app != null && this.HasActive()) {
            this.EnsureRegistration();
            app.RequestRedraw();
        }
    }
    private void EnsureRegistration() {
        App app = this.boundApp;
        if (app == null || !app.isRunning || this.registration != null) { return; }
        this.ResetClock(app, Window.GetTickMs());
        this.registration = app.RegisterLoopParticipant(this, this);
    }
    private void Unregister() {
        if (this.registration != null) { this.registration.Invalidate(); }
        this.registration = null;
        this.nextTickMs = -1;
    }
    public void Stopped(App app) {
        if (app != this.boundApp) { return; }
        this.boundApp = null;
        this.Clear();
    }
    public bool HasActive() {
        for (int i = 0; i < this.tweens.Count; i = i + 1) {
            Tween t = this.tweens[i].tween;
            if (t != null && t.active && !t.finished) { return true; }
        }
        return false;
    }
    private void ResetClock(App app, int now) {
        this.cadence.Reset();
        this.lastTickMs = now;
        for (int i = 0; i < this.tweens.Count; i = i + 1) {
            TimelineTween entry = this.tweens[i];
            entry.addedAtMs = now;
            this.tweens[i] = entry;
        }
        this.Schedule(app, now);
    }
    private void Schedule(App app, int now) {
        this.cadence.SetRate(app.RefreshRate());
        long nowUs = (long)now * 1000;
        this.cadence.Begin(nowUs);
        this.nextTickMs = now + this.cadence.WaitMilliseconds(nowUs);
    }
    public void Tick(App app, int now) {
        if (app != this.boundApp || this.nextTickMs < 0 || this.ticking) { return; }
        if (now < this.lastTickMs) {
            this.ResetClock(app, now);
            return;
        }
        if (now < this.nextTickMs || now == this.lastTickMs) { return; }
        int delta = now - this.lastTickMs;
        this.lastTickMs = now;
        this.Schedule(app, now);
        this.Advance(delta, now, true);
    }
    public int NextDeadline() { return this.nextTickMs; }
    public Tween ObtainTween(float fromVal, float toVal, int durationMs,
                             int easeType, TweenUpdate onUpdate) {
        return Tween.Create(fromVal, toVal, durationMs, easeType, onUpdate);
    }
    public static Tween To(float fromVal, float toVal, int durationMs,
                           int easeType, TweenUpdate onUpdate) {
        AnimationTimeline timeline = AnimationTimeline.Shared;
        Tween t = timeline.ObtainTween(fromVal, toVal, durationMs, easeType, onUpdate);
        timeline.Add(t);
        try { t.Play(); }
        catch (Exception error) { timeline.Remove(t); throw error; }
        return t;
    }
    private int FindTween(Tween tween) {
        for (int i = 0; i < this.tweens.Count; i = i + 1) {
            if (this.tweens[i].tween == tween) { return i; }
        }
        return -1;
    }
    public void Add(Tween t) {
        if (t == null) { return; }
        if (this.FindTween(t) < 0) { this.tweens.Add(new TimelineTween(t, Window.GetTickMs())); }
        this.EnsureRegistration();
        App app = this.boundApp;
        if (!this.ticking && app != null && app.isRunning) { app.RequestRedraw(); }
    }
    public void Remove(Tween t) {
        if (t == null) { return; }
        int index = this.FindTween(t);
        if (index < 0) { return; }
        t.Stop();
        if (this.ticking) { this.tweens[index] = new TimelineTween(null, 0); }
        else {
            this.tweens.RemoveAt(index);
            if (this.tweens.Count == 0) { this.Unregister(); }
        }
    }
    public void Clear() {
        for (int i = 0; i < this.tweens.Count; i = i + 1) {
            Tween t = this.tweens[i].tween;
            if (t != null) { t.Stop(); }
            if (this.ticking) { this.tweens[i] = new TimelineTween(null, 0); }
        }
        if (!this.ticking) { this.tweens.Clear(); }
        this.Unregister();
    }
    public void Tick(int deltaMs) { this.Advance(deltaMs, 0, false); }
    private void Advance(int deltaMs, int now, bool appClock) {
        if (deltaMs <= 0 || this.ticking || this.tweens.Count == 0) { return; }
        App app = this.boundApp;
        bool updated = false;
        this.ticking = true;
        try {
            for (int i = this.tweens.Count - 1; i >= 0 && this.boundApp == app; i = i - 1) {
                TimelineTween entry = this.tweens[i];
                Tween t = entry.tween;
                if (t == null) { continue; }
                if (t.active && !t.finished) {
                    int stepMs = appClock ? now - Math.Max(now - deltaMs, entry.addedAtMs) : deltaMs;
                    if (stepMs > 0) {
                        updated = true;
                        t.Step(stepMs);
                    }
                }
                if (!t.active || t.finished) { this.tweens[i] = new TimelineTween(null, 0); }
            }
        } finally {
            this.ticking = false;
            this.Compact();
            if (this.tweens.Count == 0) { this.Unregister(); }
            if (updated && app != null && app.isRunning) { app.RequestRedraw(); }
        }
    }
    private void Compact() {
        int count = 0;
        for (int i = 0; i < this.tweens.Count; i = i + 1) {
            TimelineTween entry = this.tweens[i];
            if (entry.tween == null) { continue; }
            if (count != i) { this.tweens[count] = entry; }
            count = count + 1;
        }
        while (this.tweens.Count > count) { this.tweens.RemoveAt(this.tweens.Count - 1); }
    }
}
