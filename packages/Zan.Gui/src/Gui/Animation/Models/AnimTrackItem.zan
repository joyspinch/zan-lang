using System;
namespace Gui.Animation;
internal class AnimTrackItem {
    internal Tween tween;
    internal SpringAnim spring;
    internal AnimGroup group;
    internal int offsetMs;
    internal bool started;
    internal bool done;
    internal void Reset() {
        this.started = false;
        this.done = false;
        if (this.tween != null) { this.tween.Stop(); }
        if (this.spring != null) { this.spring.Stop(); }
        if (this.group != null) { this.group.Stop(); }
    }
    internal void Start() {
        this.started = true;
        this.done = false;
        if (this.tween != null) { this.tween.Play(); }
        else if (this.spring != null) { this.spring.Play(); }
        else if (this.group != null) { this.group.Play(); }
    }
    internal void Pause() {
        if (!this.started || this.done) { return; }
        if (this.tween != null) { this.tween.Pause(); }
        else if (this.spring != null) { this.spring.Pause(); }
        else if (this.group != null) { this.group.Pause(); }
    }
    internal void Resume() {
        if (!this.started || this.done) { return; }
        if (this.tween != null) { this.tween.Resume(); }
        else if (this.spring != null) { this.spring.Resume(); }
        else if (this.group != null) { this.group.Resume(); }
    }
    internal bool Step(int deltaMs) {
        if (this.done) { return false; }
        bool running = false;
        if (this.tween != null) { running = this.tween.Step(deltaMs); }
        else if (this.spring != null) { running = this.spring.Step(deltaMs); }
        else if (this.group != null) { running = this.group.Step(deltaMs); }
        if (!running) { this.done = true; }
        return running;
    }
}
