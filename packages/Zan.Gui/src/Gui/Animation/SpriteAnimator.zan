using System;
using Gui;

namespace Gui.Animation;

/// <summary>
/// 精灵序列帧动画（A356 P0 动画引擎基座）：
/// 支持图集网格切片（行列网格）或自定义帧序列。
/// 与 <see cref="SpriteBatch"/> 协同，当前帧零额外分配直接提交。
/// </summary>
class SpriteAnimator {
    public int spriteHandle;
    public int cols;
    public int rows;
    public float cellW;
    public float cellH;
    public int startFrame;
    public int frameCount;
    public int frameDurationMs;
    public bool loop;

    public int currentFrame;
    public int elapsedInFrame;
    public bool active;
    public bool finished;
    public Action completeAction;

    public SpriteAnimator() {
        this.spriteHandle = 0;
        this.cols = 1;
        this.rows = 1;
        this.cellW = 0.0f;
        this.cellH = 0.0f;
        this.startFrame = 0;
        this.frameCount = 1;
        this.frameDurationMs = 100;
        this.loop = true;
        this.currentFrame = 0;
        this.elapsedInFrame = 0;
        this.active = false;
        this.finished = false;
    }

    /// <summary>创建规则网格序列帧动画。</summary>
    public static SpriteAnimator CreateGrid(int handle, int cols, int rows,
                                            float cellW, float cellH,
                                            int startFrame, int frameCount,
                                            int frameDurationMs, bool loop) {
        SpriteAnimator a = new SpriteAnimator();
        a.spriteHandle = handle;
        a.cols = cols > 0 ? cols : 1;
        a.rows = rows > 0 ? rows : 1;
        a.cellW = cellW;
        a.cellH = cellH;
        a.startFrame = startFrame >= 0 ? startFrame : 0;
        a.frameCount = frameCount > 0 ? frameCount : 1;
        a.frameDurationMs = frameDurationMs > 0 ? frameDurationMs : 16;
        a.loop = loop;
        a.currentFrame = a.startFrame;
        return a;
    }

    /// <summary>播放动画。</summary>
    public void Play() {
        this.active = true;
        this.finished = false;
        this.currentFrame = this.startFrame;
        this.elapsedInFrame = 0;
    }

    /// <summary>停止并重置动画。</summary>
    public void Stop() {
        this.active = false;
        this.finished = false;
        this.currentFrame = this.startFrame;
        this.elapsedInFrame = 0;
    }

    /// <summary>推进时间 deltaMs。返回是否仍在播放。</summary>
    public bool Step(int deltaMs) {
        if (!this.active || this.finished) { return false; }
        this.elapsedInFrame = this.elapsedInFrame + deltaMs;
        while (this.elapsedInFrame >= this.frameDurationMs) {
            this.elapsedInFrame = this.elapsedInFrame - this.frameDurationMs;
            int next = this.currentFrame + 1;
            if (next >= this.startFrame + this.frameCount) {
                if (this.loop) {
                    this.currentFrame = this.startFrame;
                } else {
                    this.currentFrame = this.startFrame + this.frameCount - 1;
                    this.finished = true;
                    this.active = false;
                    if (this.completeAction != null) { this.completeAction(); }
                    return false;
                }
            } else {
                this.currentFrame = next;
            }
        }
        return true;
    }

    /// <summary>把当前帧装入 SpriteBatch。</summary>
    public void Draw(SpriteBatch sb, float dx, float dy, float dw, float dh, int tint) {
        if (sb == null || this.spriteHandle <= 0) { return; }
        int col = this.currentFrame % this.cols;
        int row = this.currentFrame / this.cols;
        float sx = (float)col * this.cellW;
        float sy = (float)row * this.cellH;
        sb.Add(dx, dy, dw, dh, sx, sy, this.cellW, this.cellH, tint);
    }
}
