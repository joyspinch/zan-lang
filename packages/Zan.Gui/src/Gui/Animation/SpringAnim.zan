using System;
using Gui;
namespace Gui.Animation;
// 速度连续的可打断阻尼弹簧动画（半隐式子步积分，支持 duration/bounce 参数化与中途 Retarget）。
public class SpringAnim {
    public float value;
    public float target;
    public float velocity;
    public float stiffness;
    public float damping;
    public float mass;
    public float restDisplacement;
    public float restVelocity;
    public int delayMs;
    public int delayRemainingMs;
    public bool active;
    public bool paused;
    public bool finished;
    public TweenUpdate updateAction;
    public TweenCallback completeAction;
    int playback;
    public SpringAnim() {
        this.value = 0.0f;
        this.target = 1.0f;
        this.velocity = 0.0f;
        this.stiffness = 220.0f;
        this.damping = 24.0f;
        this.mass = 1.0f;
        this.restDisplacement = 0.001f;
        this.restVelocity = 0.001f;
        this.delayMs = 0;
        this.delayRemainingMs = 0;
        this.active = false;
        this.paused = false;
        this.finished = false;
    }
    static bool IsFinite(float v) { return v == v && (v - v) == 0.0f; }
    public static SpringAnim Create(float fromVal, float toVal, float stiffness,
                                    float damping, float mass, TweenUpdate onUpdate) {
        SpringAnim s = new SpringAnim();
        float f = SpringAnim.IsFinite(fromVal) ? fromVal : 0.0f;
        float t = SpringAnim.IsFinite(toVal) ? toVal : f;
        s.value = f;
        s.target = t;
        s.stiffness = (SpringAnim.IsFinite(stiffness) && stiffness > 1.0f) ? stiffness : 1.0f;
        s.damping = (SpringAnim.IsFinite(damping) && damping >= 0.0f) ? damping : 0.0f;
        s.mass = (SpringAnim.IsFinite(mass) && mass > 0.01f) ? mass : 1.0f;
        s.updateAction = onUpdate;
        s.AutoRestThresholds(f, t);
        return s;
    }
    // SwiftUI 风格参数化：durationSec（感知时长）+ bounce（-1 过阻尼，0 临界阻尼，0..0.95 回弹）。
    public static SpringAnim FromDurationBounce(float fromVal, float toVal, float durationSec,
                                                float bounce, TweenUpdate onUpdate) {
        float k = 260.0f; float c = 22.0f;
        MotionSpec.SpringFromBounce(durationSec, bounce, out k, out c);
        return SpringAnim.Create(fromVal, toVal, k, c, 1.0f, onUpdate);
    }
    public static SpringAnim Snappy(float fromVal, float toVal, TweenUpdate onUpdate) {
        return SpringAnim.Create(fromVal, toVal, 420.0f, 28.0f, 1.0f, onUpdate);
    }
    public static SpringAnim Smooth(float fromVal, float toVal, TweenUpdate onUpdate) {
        return SpringAnim.Create(fromVal, toVal, 220.0f, 26.0f, 1.0f, onUpdate);
    }
    public static SpringAnim Bouncy(float fromVal, float toVal, TweenUpdate onUpdate) {
        return SpringAnim.Create(fromVal, toVal, 280.0f, 15.0f, 1.0f, onUpdate);
    }
    public static SpringAnim Gentle(float fromVal, float toVal, TweenUpdate onUpdate) {
        return SpringAnim.Create(fromVal, toVal, 140.0f, 20.0f, 1.0f, onUpdate);
    }
    void AutoRestThresholds(float fromVal, float toVal) {
        float span = toVal - fromVal;
        if (span < 0.0f) { span = -span; }
        if (span >= 10.0f) {
            this.restDisplacement = 0.25f;
            this.restVelocity = 1.0f;
        } else {
            this.restDisplacement = 0.001f;
            this.restVelocity = 0.005f;
        }
    }
    public SpringAnim WithVelocity(float initialVelocity) {
        this.velocity = SpringAnim.IsFinite(initialVelocity) ? initialVelocity : 0.0f;
        return this;
    }
    public SpringAnim WithDelay(int ms) {
        this.delayMs = ms > 0 ? ms : 0;
        return this;
    }
    public SpringAnim WithPrecision(float displacementEps, float velocityEps) {
        if (SpringAnim.IsFinite(displacementEps) && displacementEps > 0.0f) { this.restDisplacement = displacementEps; }
        if (SpringAnim.IsFinite(velocityEps) && velocityEps > 0.0f) { this.restVelocity = velocityEps; }
        return this;
    }
    public void OnComplete(TweenCallback onComplete) { this.completeAction = onComplete; }
    public void Play() {
        this.playback = this.playback + 1;
        this.active = true;
        this.paused = false;
        this.finished = false;
        this.delayRemainingMs = this.delayMs;
        TweenUpdate onUpd = this.updateAction;
        if (this.delayRemainingMs == 0 && onUpd != null) {
            onUpd(this.value);
        }
    }
    // 中途改目标：完整保留当前位置与速度，实现无跳变的可打断手势/状态衔接。
    public void Retarget(float newTarget) {
        if (!SpringAnim.IsFinite(newTarget)) { return; }
        this.playback = this.playback + 1;
        this.target = newTarget;
        this.finished = false;
        this.paused = false;
        this.active = true;
        this.delayRemainingMs = 0;
    }
    public void Pause() {
        if (this.active && !this.finished) {
            this.active = false;
            this.paused = true;
        }
    }
    public void Resume() {
        if (this.paused && !this.finished) {
            this.paused = false;
            this.active = true;
        }
    }
    public void Stop() {
        this.playback = this.playback + 1;
        this.active = false;
        this.paused = false;
        this.finished = false;
        this.velocity = 0.0f;
        this.delayRemainingMs = 0;
    }
    public bool Step(int deltaMs) {
        if (!this.active || this.finished || deltaMs <= 0) { return false; }
        int rem = deltaMs;
        if (this.delayRemainingMs > 0) {
            if (rem < this.delayRemainingMs) {
                this.delayRemainingMs = this.delayRemainingMs - rem;
                return true;
            }
            rem = rem - this.delayRemainingMs;
            this.delayRemainingMs = 0;
            if (rem == 0) { return true; }
        }
        float m = (SpringAnim.IsFinite(this.mass) && this.mass > 0.01f) ? this.mass : 1.0f;
        float k = (SpringAnim.IsFinite(this.stiffness) && this.stiffness > 1.0f) ? this.stiffness : 1.0f;
        float c = (SpringAnim.IsFinite(this.damping) && this.damping >= 0.0f) ? this.damping : 0.0f;
        if (!SpringAnim.IsFinite(this.target)) { this.target = 0.0f; }
        if (!SpringAnim.IsFinite(this.value) || !SpringAnim.IsFinite(this.velocity)) {
            this.value = this.target;
            this.velocity = 0.0f;
        }
        float totalDt = (float)rem / 1000.0f;
        if (totalDt > 0.1f) { totalDt = 0.1f; }
        // 按 4ms 固定子步做半隐式欧拉积分，避免高刚度弹簧在低帧率下能量爆炸。
        int subSteps = (int)(totalDt / 0.004f) + 1;
        if (subSteps > 32) { subSteps = 32; }
        float dt = totalDt / (float)subSteps;
        float invMass = 1.0f / m;
        for (int i = 0; i < subSteps; i = i + 1) {
            float disp = this.value - this.target;
            float accel = (-k * disp - c * this.velocity) * invMass;
            this.velocity = this.velocity + accel * dt;
            this.value = this.value + this.velocity * dt;
            if (!SpringAnim.IsFinite(this.value) || !SpringAnim.IsFinite(this.velocity)) {
                this.value = this.target;
                this.velocity = 0.0f;
                break;
            }
        }
        float absDisp = this.value - this.target;
        if (absDisp < 0.0f) { absDisp = -absDisp; }
        float absVel = this.velocity < 0.0f ? -this.velocity : this.velocity;
        float rDisp = (SpringAnim.IsFinite(this.restDisplacement) && this.restDisplacement > 0.0f) ? this.restDisplacement : 0.001f;
        float rVel = (SpringAnim.IsFinite(this.restVelocity) && this.restVelocity > 0.0f) ? this.restVelocity : 0.001f;
        if (absDisp <= rDisp && absVel <= rVel) {
            this.value = this.target;
            this.velocity = 0.0f;
            this.finished = true;
            this.active = false;
            this.paused = false;
        }
        int run = this.playback;
        TweenUpdate onUpd = this.updateAction;
        if (onUpd != null) { onUpd(this.value); }
        TweenCallback onDone = this.completeAction;
        if (this.playback == run && this.finished && onDone != null) { onDone(); }
        return this.active && !this.finished;
    }
}
