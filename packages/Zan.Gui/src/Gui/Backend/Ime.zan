using System;
using System.Collections.Generic;
namespace Gui.Backend;
public class Ime {
    static void SetCaret(int x, int y) { Platform.Shell().ImeSetCaret(x, y); }
    static void SetOpen(bool on) { Platform.Shell().ImeSetOpen(on); }
    static string Composing() { return Platform.Shell().ImeComposing(); }
}
