namespace Gui.Backend;
public class GuiHostState {
    static int widgetIdSeq;
    static int bindingStructureRevision;
    static bool wndProcPainting;
    static object automationSession;
    static object coreState;
    static object widgetState;
    static object navState;

    public static int NextWidgetId() {
        widgetIdSeq = widgetIdSeq + 1;
        return 1000000 + widgetIdSeq;
    }

    public static int AllocWidgetIdBlock(int count) {
        int first = 1000000 + widgetIdSeq + 1;
        widgetIdSeq = widgetIdSeq + count;
        return first;
    }

    public static int WidgetIdSeq() { return widgetIdSeq; }
    public static void SetWidgetIdSeq(int value) { widgetIdSeq = value; }

    public static int BindingStructureRevision() { return bindingStructureRevision; }
    public static void NextBindingStructureRevision() { bindingStructureRevision = bindingStructureRevision + 1; }

    public static bool WndProcPainting() { return wndProcPainting; }
    public static void SetWndProcPainting(bool value) { wndProcPainting = value; }

    public static object AutomationSession() { return automationSession; }
    public static void SetAutomationSession(object session) { automationSession = session; }

    public static object CoreState() { return coreState; }
    public static void SetCoreState(object state) { coreState = state; }

    public static object WidgetState() { return widgetState; }
    public static void SetWidgetState(object state) { widgetState = state; }

    public static object NavState() { return navState; }
    public static void SetNavState(object state) { navState = state; }
}
