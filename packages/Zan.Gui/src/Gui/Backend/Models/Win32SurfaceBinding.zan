using System;
using System.Collections.Generic;
using Gui;

namespace Gui.Backend;

// 窗口表面绑定条目实体（消除 surfHwnd 与 surfId 平行列表反模式）。
public class Win32SurfaceBinding {
    public nint hwnd;
    public int surfaceId;

    public Win32SurfaceBinding(nint hwnd, int surfaceId) {
        this.hwnd = hwnd;
        this.surfaceId = surfaceId;
    }
}
