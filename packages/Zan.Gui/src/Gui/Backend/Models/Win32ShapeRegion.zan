using System;
using System.Collections.Generic;
using System.Runtime.InteropServices;
using Gui;

namespace Gui.Backend;

public class Win32ShapeRegion {
    public int kind;
    public int x;
    public int y;
    public int w;
    public int h;
    public int r;

    public Win32ShapeRegion(int k, int x, int y, int w, int h, int r) {
        this.kind = k;
        this.x = x;
        this.y = y;
        this.w = w;
        this.h = h;
        this.r = r;
    }
}

// Win32 窗口脏矩形条目实体（消除 dirty 平铺四元组整数列表反模式）。
