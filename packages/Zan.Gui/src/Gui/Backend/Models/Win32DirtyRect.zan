using System;
using System.Collections.Generic;
using Gui;

namespace Gui.Backend;

public class Win32DirtyRect {
    public int x;
    public int y;
    public int w;
    public int h;

    public Win32DirtyRect(int x, int y, int w, int h) {
        this.x = x;
        this.y = y;
        this.w = w;
        this.h = h;
    }
}
