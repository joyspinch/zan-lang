using System;
using System.Collections.Generic;
using Gui;

namespace Gui.Backend;

public class Win32QueuedEvent {
    public nint hwnd;
    public int kind;
    public int x;
    public int y;
    public int button;
    public int keycode;
    public int mods;

    public Win32QueuedEvent(nint hwnd, int kind, int x, int y, int button, int keycode, int mods) {
        this.hwnd = hwnd;
        this.kind = kind;
        this.x = x;
        this.y = y;
        this.button = button;
        this.keycode = keycode;
        this.mods = mods;
    }
}
