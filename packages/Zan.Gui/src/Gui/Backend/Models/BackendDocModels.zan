using System;
using System.Collections.Generic;
using Gui;
namespace Gui.Backend;

public class ControlNode {
    public string kind;
    public string name;
    public int visible;
    public int id;
    public int focused;
    public int pointerHit;
    public int x;
    public int y;
    public int w;
    public int h;
    public int prefW;
    public int prefH;
    public List<ControlNode> kids;
}

public class ControlTreeDoc {
    public ControlNode root;
    public List<ControlNode> inputTargets;
}

public class HitRegionDoc {
    public int z;
    public int id;
    public int x;
    public int y;
    public int w;
    public int h;
    public int type;
    public string label;
}

public class HitRegionsDoc {
    public int count;
    public List<HitRegionDoc> regions;
}

public class ThemeDoc {
    public int scale;
    public int textPrimary;
    public int textSecondary;
    public int textTertiary;
    public int textDisabled;
    public int bgPrimary;
    public int bgSecondary;
    public int bgTertiary;
    public int borderPrimary;
    public int borderSecondary;
    public int divider;
    public int primary;
    public int shadowColor;
    public int borderRadiusSmall;
    public int borderRadiusMedium;
    public int borderRadiusLarge;
    public int borderWidth;
    public int fontSizeTiny;
    public int fontSizeSmall;
    public int fontSizeMedium;
    public int fontSizeLarge;
    public int fontSizeHuge;
    public int heightTiny;
    public int heightSmall;
    public int heightMedium;
    public int heightLarge;
    public int paddingTiny;
    public int paddingSmall;
    public int paddingMedium;
    public int paddingLarge;
    public int gapSmall;
    public int gapMedium;
    public int gapLarge;
    public int glass;
    public int gradient;
    public int neu;
    public int brutal;
}
