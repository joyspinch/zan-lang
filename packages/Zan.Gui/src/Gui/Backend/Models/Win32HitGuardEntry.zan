using System;
using System.Collections.Generic;
using Gui;

namespace Gui.Backend;

public class Win32HitGuardEntry {
    public nint hwnd;
    public int x;
    public int y;
    public int w;
    public int h;

    public Win32HitGuardEntry(nint hwnd, int x, int y, int w, int h) {
        this.hwnd = hwnd;
        this.x = x;
        this.y = y;
        this.w = w;
        this.h = h;
    }
}
