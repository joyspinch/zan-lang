using System;
using System.Collections.Generic;
using Gui;

namespace Gui.Backend;

public class ThemeDoc {
    public int scale;

    public int textPrimary;
    public int textSecondary;
    public int textTertiary;
    public int textDisabled;
    public int bgPrimary;
    public int bgSecondary;
    public int bgTertiary;
    public int borderPrimary;
    public int borderSecondary;
    public int divider;
    public int primary;
    public int shadowColor;

    public int borderRadiusSmall;
    public int borderRadiusMedium;
    public int borderRadiusLarge;
    public int borderWidth;

    public int fontSizeTiny;
    public int fontSizeSmall;
    public int fontSizeMedium;
    public int fontSizeLarge;
    public int fontSizeHuge;

    public int heightTiny;
    public int heightSmall;
    public int heightMedium;
    public int heightLarge;

    public int paddingTiny;
    public int paddingSmall;
    public int paddingMedium;
    public int paddingLarge;

    public int gapSmall;
    public int gapMedium;
    public int gapLarge;

    // 皮肤模式标志：同一控件根据这些标志以边框、压纹或
    // 硬偏移阴影绘制，因此样式检查在称边框"多余"之前
    // 必须先知道它面对的是哪个系列。
    public int glass;
    public int gradient;
    public int neu;
    public int brutal;
}

