using System;
using System.Collections.Generic;
using Gui;

namespace Gui.Backend;

public class ControlNode {
    public string kind;
    public string name;
    public int visible;
    // Input snapshot metadata; pointerHit observes the nearest endpoint at its center.
    public int id;
    public int focused;
    public int pointerHit;
    public int x;
    public int y;
    public int w;
    public int h;
    public int prefW;
    public int prefH;
    // S21 语义状态（docs/ZAN_STANDARD.md §5）：经属性协议 GetProp 读出的文本、值、
    // 勾选态（控件不发布该属性时为空串），enabled 按祖先链折算（禁用的组禁用其下全部）。
    public string text;
    public string value;
    public string isChecked;
    public int enabled;
    public List<ControlNode> kids;
}
