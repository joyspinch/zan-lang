using System;
using System.Collections.Generic;
using Gui;

namespace Gui.Backend;

public class ControlNode {
    public string kind;
    public string name;
    public int visible;
    // Input snapshot metadata; pointerHit observes the nearest endpoint at its center.
    public int id;
    public int focused;
    public int pointerHit;
    public int x;
    public int y;
    public int w;
    public int h;
    public int prefW;
    public int prefH;
    public List<ControlNode> kids;
}
