using System;
using System.Collections.Generic;
using Gui;

namespace Gui.Backend;

public class ControlNode {
    public string kind;
    public string name;
    public int dock;
    public int visible;
    public int x;
    public int y;
    public int w;
    public int h;
    public int prefW;
    public int prefH;
    public List<ControlNode> kids;
}

