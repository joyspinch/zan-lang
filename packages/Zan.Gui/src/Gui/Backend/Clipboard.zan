using System;
using System.Collections.Generic;
namespace Gui.Backend;
public class Clipboard {
    static string last;
    static bool SetText(string text) { Clipboard.last = text; return Platform.Shell().ClipboardSet(text); }
    static string GetText() {
        string text = Platform.Shell().ClipboardGet();
        if (text == "" && Clipboard.last != null) { return Clipboard.last; }
        return text;
    }
}
