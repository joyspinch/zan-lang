    // 在窗口后启用系统原生半透明玻璃（Win11 亚克力、
    // macOS NSVisualEffectView、Linux 合成器模糊），
    // 凡表面透明处生效。tint 为打包的 ARGB 颜色；alpha 控制磨砂强度。
    // 在没有原生背景的平台上安全地空操作。
    [DllImport("zan_gui")]
    static extern int zan_gui_enable_glass(nint hwnd, int tintArgb);
    // 将窗口恢复不透明（移除原生半透明合成）。
    [DllImport("zan_gui")]
    static extern int zan_gui_disable_glass(nint hwnd);
    // 以百分比（10..100）设置整个窗口的不透明度；100 恢复不透明。
    [DllImport("zan_gui")]
    static extern int zan_gui_set_opacity(nint hwnd, int percent);
    #if !WINDOWS && !MACOS
    // 将窗口左上角移动到屏幕工作区的 (x, y) 像素位置。
    [DllImport("zan_gui")]
    static extern int zan_gui_set_window_pos(nint hwnd, int x, int y);
    #endif
    // 在显示器工作区上重新居中窗口。
    [DllImport("zan_gui")]
    static extern int zan_gui_center_window(nint hwnd);
    // 清除上一帧注册的所有客户端优先条带。
    [DllImport("zan_gui")]
    static extern int zan_gui_clear_hit_guards(nint hwnd);
    // 为客户端像素矩形抢占边框的边缘缩放区域。
    [DllImport("zan_gui")]
    static extern int zan_gui_add_hit_guard(nint hwnd, int x, int y, int w, int h);
    #endif


    nint handle;
    #if WINDOWS
    nint refreshMonitor;
    int refreshDisplaySerial;
    long refreshCheckedUs;
    double refreshHz;
    #endif
    int width;
    int height;
    int localKind;
    int localX;
    int localY;
    int localButton;
    int localKey;
    int localMods;
    int localFlag;
    long localSeq;



    // 创建新的平台窗口（96 DPI 逻辑像素；Windows 上按显示
    // 器 DPI 放大客户区，其余平台原样）。
    Window(string title, int width, int height) : this(title, width, height, false) { }

    // physical=true 时 width/height 为内容区物理像素，任何
    // 平台都不做 DPI 放大（Windows 上客户区额外加标准标题条高度，
    // 内容区从 App.ContentTop() 之下开始）。
    Window(string title, int width, int height, bool physical) {
        #if WINDOWS
        if (physical) {
            this.handle = Win32Shell.CreateWindowPhysical(title, width, height);
        } else {
            this.handle = Win32Shell.CreateWindow(title, width, height);
        }
        #else
        this.handle = zan_gui_create_window(title, width, height);
        #endif
        this.width = width;
        this.height = height;
    }

    // physical=true 时 width/height 为内容区（游戏舞台）的
    // 物理像素，运行时不做 DPI 放大；Windows 上客户区 = 舞台 + 标准
    // 标题条（内容从 App.ContentTop() 之下开始）——游戏舞台契约：
    // 画布舞台区尺寸恒等于请求值，与显示器 DPI 无关，输入坐标 1:1。
    // 非 Windows 后端原样创建（全屏表面，无标题条预留）。
    static Window CreatePhysical(string title, int width, int height) {
        Window w = new Window(title, width, height, true);
        return w;
    }

    // 离屏窗口只保存画布尺寸，不创建平台窗口或登记全局事件。
    static Window Offscreen(int width, int height) {
        return new Window(width, height);
    }

    Window(int width, int height) {
        this.handle = 0;
        this.width = width;
        this.height = height;
    }

    // 离屏输入仅存本实例；不会向平台队列投递或覆盖进程事件。
    void SetLocalEvent(int kind, int x, int y, int button, int key, int mods, int flag) {
        if (handle != 0) { return; }
        localKind = kind;
        localX = x;
        localY = y;
        localButton = button;
        localKey = key;
        localMods = mods;
        localFlag = flag;
        if (kind != 0) { localSeq = localSeq + 1; }
    }

    // 注册一个在系统模态尺寸调整循环里被调用的帧体。
    // 拖动窗口边框时消息循环停在 OS 内部，应用自己的循环拿不到
    // 控制权，表面会一直停在旧尺寸上，新露出的一条是空白，直到
    // 松手为止；窗口过程收到 WM_SIZE 时回调它，就能就地画出
    // 新尺寸的一帧。
    static void SetSizePaint(SizePaintBody body) {
        #if WINDOWS
        Win32Shell.SetSizePaint(body);
        #else
        // 模态调整尺寸循环由平台窗口事件驱动，应用循环
        // 自己就能画下一帧，无需从窗口过程回调。
        Window.sizePaintUnused = body;
        #endif
    }

    #if !WINDOWS
    static SizePaintBody sizePaintUnused;
    #endif

    // 实时缩放时用来填充新露出边距的颜色。窗口先被
    // OS 放大、应用才画出新尺寸的一帧，这段空隙里那条边距按此色
    // 填充；默认 0（黑）会在拖动边框时闪黑边，因此每帧清屏色
    // 变化时都要同步过来。
    static void SetResizeBackground(int color) {
        #if WINDOWS
        Win32Shell.SetBackground(color);
        #endif
    }

    // 在屏幕上显示窗口。
    void Show() {
        if (handle == 0) { return; }
        #if WINDOWS
        Win32Shell.ShowWindowNow((nint)handle);
        #else
        zan_gui_show_window(handle);
        #endif
    }

    // 开/关关窗拦截。
    //
    // 开了以后「请求关闭」不再当场销毁窗口：窗口过程只投递关闭
    // 事件，等应用同意（App.OnCloseGuard 的处理器返回 true）后
    // 再真正关掉；否决（返回 false）则窗口继续存在。
    //
    // 跨平台一致：
    //   * Windows 需要这个开关（否则 WM_CLOSE 落 DefWindowProcW
    //     会当场 DestroyWindow，应用来不及问）；
    //   * macOS/X11 的原生层本来就只投递关闭事件、不销毁窗口，
    //     这里只是显式声明意图，行为不变。
    void SetCloseIntercept(bool on) {
        #if WINDOWS
        Win32Shell.SetCloseIntercept(handle, on);
        #endif
    }

    // 将窗口左上角移动到屏幕工作区的 (x, y) 像素位置。
    void SetPosition(int x, int y) {
        if (handle == 0) { return; }
        #if WINDOWS
        Win32Shell.SetWindowPosition((nint)handle, x, y);
        #elif MACOS
        return;
        #else
        zan_gui_set_window_pos(handle, x, y);
        #endif
    }

    // 本 HWND 的 DPI 百分比；不借用另一个窗口的显示器或度量。
    int GetDpiScale() {
        if (handle == 0) { return 100; }
        #if WINDOWS
        return Win32Shell.DpiScale(handle);
        #else
        return Canvas.GetDpiScale();
        #endif
    }

    int GetTitlebarHeight() {
        #if WINDOWS
        return Win32Shell.TitlebarHeight(handle);
        #else
        return Window.TitlebarHeight();
        #endif
    }

    int GetCaptionButtonWidth() {
        #if WINDOWS
        return Win32Shell.CaptionButtonWidth(handle);
        #else
        return Window.CaptionButtonWidth();
        #endif
    }

    // 把窗口客户区调整为 (w, h) 逻辑像素，外框随之伸缩、
    // 位置不变。登录小窗 → 主窗口这类形态切换用；WM_SIZE 走正常
    // 路径，画布与布局下一帧自动跟上。
    void SetClientSize(int w, int h) {
        if (handle == 0) { return; }
        #if WINDOWS
        int scale = this.GetDpiScale();
        Win32Shell.ResizeClient((nint)handle, w * scale / 100, h * scale / 100);
        #endif
    }

    // 把客户区调整为 (wDev, hDev) 设备像素，不进行 DPI 换算。
    // 需要精确物理尺寸时使用；SetClientSize 则接受逻辑像素，按窗口 DPI
    // 换算后使用相同的无边框客户区尺寸契约。
    void SetClientSizeDev(int wDev, int hDev) {
        if (handle == 0) { return; }
        #if WINDOWS
        Win32Shell.ResizeClientExact((nint)handle, wDev, hDev);
        #endif
    }

    // 在显示器工作区上居中窗口。
    void Center() {
        if (handle == 0) { return; }
        #if WINDOWS
        Win32Shell.CenterWindow((nint)handle);
        #else
        zan_gui_center_window(handle);
        #endif
    }

    #if ANDROID
    // 静态 APK 的驱动导出在 libmain.so 中；共享驱动只加载一次并保活。
    static nint OptionalGuiEntry(string symbol) {
        nint entry = Interop.PosixSymbol(0, symbol);
        if (entry != 0) { return entry; }
        if (!Window.optionalGuiDriverResolved) {
            Window.optionalGuiDriverResolved = true;
            Window.optionalGuiDriver = Interop.Load("libzan_gui.so");
        }
        return Interop.Symbol(Window.optionalGuiDriver, symbol);
    }

    static void ResolveDisplayFrame() {
        if (Window.displayFrameResolved) { return; }
        Window.displayFrameResolved = true;
        Window.displayFrameRequest = Window.OptionalGuiEntry("zan_gui_request_display_frame");
        Window.displayFrameTake = Window.OptionalGuiEntry("zan_gui_take_display_frame");
    }
    #endif

    // 所在显示器当前模式的刷新率（Hz），查询不可用时返回 60。
    // 这是动画节奏提示，不保证与垂直同步相位对齐；周期应保留小数。
    double RefreshRate() {
        if (handle == 0) { return 60.0; }
        #if WINDOWS
        nint monitor = Win32Shell.MonitorFromWindow(handle, 2);
        long nowUs = Stopwatch.GetMicroseconds();
        int serial = Win32Shell.displayChangeSerial;
        if (refreshHz > 0 && monitor == refreshMonitor &&
            serial == refreshDisplaySerial && nowUs - refreshCheckedUs < 1000000) {
            return refreshHz;
        }
        refreshHz = Win32Shell.MonitorRefreshRate(monitor);
        refreshMonitor = monitor;
        refreshDisplaySerial = serial;
        refreshCheckedUs = nowUs;
        return refreshHz;
        #else
        #if ANDROID
        if (!Window.refreshQueryResolved) {
            Window.refreshQueryResolved = true;
            Window.refreshQuery = Window.OptionalGuiEntry("zan_gui_refresh_rate");
        }
        if (Window.refreshQuery != 0) {
            WindowRefreshRateFn query = (WindowRefreshRateFn)Window.refreshQuery;
            double hz = query(handle);
            if (hz > 1.0 && hz <= 1000.0) { return hz; }
        }
        #endif
        // X11 驱动没有 XRandR 依赖，其余后端尚无显示模式查询。
        return 60.0;
        #endif
    }

    // 仅 UI/Looper 线程：按需请求下一显示帧，重复请求合并。
    // true 表示已排期或已有未消费信号；false 时使用计时器回退。
    // 不会持续订阅显示帧，必须在消费并决定继续动画后再次请求。
    bool RequestDisplayFrame() {
        if (handle == 0) { return false; }
        #if ANDROID
        Window.ResolveDisplayFrame();
        if (Window.displayFrameRequest != 0 && Window.displayFrameTake != 0) {
            WindowDisplayFrameFn request = (WindowDisplayFrameFn)Window.displayFrameRequest;
            return request(handle) != 0;
        }
        #endif
        return false;
    }

    // 仅 UI/Looper 线程：一次性消费显示帧信号，不修改输入事件记录。
    bool TakeDisplayFrame() {
        if (handle == 0) { return false; }
        #if ANDROID
        Window.ResolveDisplayFrame();
        if (Window.displayFrameRequest != 0 && Window.displayFrameTake != 0) {
            WindowDisplayFrameFn take = (WindowDisplayFrameFn)Window.displayFrameTake;
            return take(handle) != 0;
        }
        #endif
        return false;
    }

    // 阻塞直到下一个 OS 事件到达。成功返回 0，退出返回 -1。
    int WaitEvent() {
        if (handle == 0) { return 0; }
        #if WINDOWS
        return Win32Shell.WaitEvent();
        #else
        return zan_gui_wait_event();
        #endif
    }

    // 阻塞直到 OS 事件到达或 `ms` 毫秒过去。
    // 返回 0=收到事件、1=超时、-1=退出。在内核中空闲，
    // 等待下一帧截止时间的动画循环不消耗 CPU。
    int WaitEventTimeout(int ms) {
        if (handle == 0) { return 0; }
        #if WINDOWS
        return Win32Shell.WaitEventTimeout(ms);
        #else
        return zan_gui_wait_event_timeout(ms);
        #endif
    }

    // 不阻塞地轮询事件。返回 0=收到事件、1=无事件、-1=退出。
    int PollEvent() {
        if (handle == 0) { return 0; }
        #if WINDOWS
        return Win32Shell.PollEvent();
        #else
        return zan_gui_poll_event();
        #endif
    }

    // 从任意线程唤醒阻塞在 WaitEvent 中的 UI 线程，使其能排空
    // App 分发队列。线程安全。由 App.Post 使用。
    void Wake() {
        if (handle == 0) { return; }
        #if WINDOWS
        Win32Shell.Wake();
        #else
        zan_gui_wake();
        #endif
    }

    // 为此窗口排队一个合成输入事件，由
    // 下一次 PollEvent/WaitEvent 与真实 OS 事件一样取出。
    // UI 自动化驱动（Gui.UiDriver）用它驱动应用，
    // 无需移动系统鼠标或合成系统按键。`kind`/`button`/`keycode`/`mods`
    // 与 EventKind()/EventButton()/EventKeyCode()/
    // EventMods() 使用相同的编码。
    void InjectEvent(int kind, int x, int y, int button, int keycode, int mods) {
        if (handle == 0) { return; }
        #if WINDOWS
        Win32Shell.InjectEvent((nint)handle, kind, x, y, button, keycode, mods);
        #else
        zan_gui_inject_event(handle, kind, x, y, button, keycode, mods);
        #endif
    }

    // 仍排队的合成事件数量（事件循环
    // 完全消费驱动器最后一批后为 0）。
    static int InjectPending() {
        #if WINDOWS
        return Win32Shell.InjectPending();
        #else
        return zan_gui_inject_pending();
        #endif
    }

    // 上次文件拖放事件（kind 9）携带的文件路径，
    // 取出即从队列移除：应用看到该事件时调用一次。
    // 拖放位置为 EventX()/EventY()（客户端像素），应用可将
    // 文件路由到光标下的控件。
    List<string> TakeDroppedFiles() {
        #if WINDOWS
        return Win32Shell.TakeDropped();
        #elif MACOS
        return new List<string>();
        #else
        List<string> outp = new List<string>();
        string p = zan_gui_drop_take();
        while (p != "") {
            outp.Add(p);
            p = zan_gui_drop_take();
        }
        return outp;
        #endif
    }

    // 拖放后队列中是否有尚未被 TakeDroppedFiles 取走的路径
    // （只看不删）。kind 9 兼作 blur，应用据此在当前事件帧上
    // 区分真拖放与失焦，避免 EventKind 被后续事件覆盖而漏收。
    bool DropPending() {
        if (handle == 0) { return false; }
        #if WINDOWS
        return Win32Shell.DropPending();
        #elif MACOS
        return false;
        #else
        return zan_gui_drop_pending() != 0;
        #endif
    }

    // 返回最近一次事件类型（0=无、1=鼠标移动、2=鼠标按下、3=鼠标释放、4=按键按下、5=按键释放、6=文本输入、7=调整大小、8=关闭、9=文件拖放、13=滚动、14=表面还原/重露（移动端：表面被系统重建，需整帧重画））。
    int EventKind() {
        if (handle == 0) { return localKind; }
        #if WINDOWS
        return Win32Shell.EventKindValue();
        #else
        return zan_gui_event_kind();
        #endif
    }

    // 最近投递事件的单调序号：每投递一个新事件 +1，
    // 没有新事件时保持不变。EventKind()/EventX() 等在没有新
    // 事件的循环迭代里返回上一次的旧值（动画分支不泵就退出），
    // 应用要区分"新事件"与"陈旧回读"时比对这里。
    long EventSeq() { return handle == 0 ? localSeq : Window.EventSeqGlobal(); }

    // 最近投递事件的进程级序号（不依赖某个窗口实例）。多顶层
    // 窗口的事件路由需要一个「这件事件处理过没有」的幂等键，
    // 而路由器（ChildWindows.Route）手里只有 hwnd、没有窗口对象。
    static long EventSeqGlobal() {
        #if WINDOWS
        return Win32Shell.EventSeqValue();
        #else
        return zan_gui_event_seq();
        #endif
    }
    // 最近事件的 X 坐标：鼠标/滚轮/拖放为客户端像素，键盘类为 0。
    int EventX() {
        if (handle == 0) { return localX; }
        #if WINDOWS
        return Win32Shell.EventXValue();
        #else
        return zan_gui_event_x();
        #endif
    }
    // 最近事件的 Y 坐标：鼠标/滚轮/拖放为客户端像素，键盘类为 0。
    int EventY() {
        if (handle == 0) { return localY; }
        #if WINDOWS
        return Win32Shell.EventYValue();
        #else
        return zan_gui_event_y();
        #endif
    }
    // 最近事件的鼠标键：0 左键、1 右键；非鼠标事件为 0。
    int EventButton() {
        if (handle == 0) { return localButton; }
        #if WINDOWS
        return Win32Shell.EventButtonValue();
        #else
        return zan_gui_event_button();
        #endif
    }
    // 最近事件的键码：KeyDown/KeyUp 为虚拟键码，TextInput 为
    // 字符码，Scroll 为滚动 delta。
    int EventKeyCode() {
        if (handle == 0) { return localKey; }
        #if WINDOWS
        return Win32Shell.EventKeyCodeValue();
        #else
        return zan_gui_event_keycode();
        #endif
    }
    // 最近事件按下时的修饰键组合（Modifiers 位掩码）。
    int EventMods() {
        if (handle == 0) { return localMods; }
        #if WINDOWS
        return Win32Shell.EventModsValue();
        #else
        return zan_gui_event_mods();
        #endif
    }
    // 事件标记通道：1 = 本次释放是一次触摸拖拽的收尾（手指落点
    // 随拖动走到哪算哪），App 据此不把它当作点击分发。Windows
    // 外壳经系统合成鼠标自带同坐标 down/up，无此标记恒为 0。
    int EventFlag() {
        if (handle == 0) { return localFlag; }
        #if WINDOWS
        return 0;
        #else
        return zan_gui_event_flag();
        #endif
    }

    // 最近一次收到调整大小事件的窗口客户区宽（设备像素）。外壳
    // 全局只记一个“当前窗口”，多窗口应用要按句柄精确查询时用
    // ClientWidth/ClientHeight。
    int GetWidth() {
        if (handle == 0) { return width; }
        #if WINDOWS
        return Win32Shell.WindowWidth();
        #else
        return zan_gui_window_width();
        #endif
    }
    // 最近一次收到调整大小事件的窗口客户区高（设备像素），同 GetWidth。
    int GetHeight() {
        if (handle == 0) { return height; }
        #if WINDOWS
        return Win32Shell.WindowHeight();
        #else
        return zan_gui_window_height();
        #endif
    }

    // 此窗口的原生句柄（不透明；用于事件路由）。
    nint GetHandle() { return handle; }

    // 产生最近一次事件的窗口句柄，
    // 拥有多个顶层窗口的应用可据此正确路由事件。
    static nint EventHwnd() {
        #if WINDOWS
        return Win32Shell.EventWindow();
        #else
        return zan_gui_event_hwnd();
        #endif
    }

    // 窗口过程当前正在处理的消息所属的窗口句柄。
    // 模态尺寸调整循环期间应用不泵事件（EventHwnd 停留在旧值），
    // sizePaint 回调须用这一个路由"正在缩放的窗口"。
    static nint SizePaintWindow() {
        #if WINDOWS
        return Win32Shell.WndProcWindow();
        #else
        return zan_gui_event_hwnd();
        #endif
    }

    // 本窗口客户区宽/高（设备像素），按窗口查询
    // （不同于反映最近调整大小的窗口的 GetWidth）。
    int ClientWidth() {
        if (handle == 0) { return width; }
        #if WINDOWS
        return Win32Shell.ClientWidth((nint)handle);
        #else
        return zan_gui_client_width(handle);
        #endif
    }
    // 本窗口客户区高（设备像素），按窗口查询（同 ClientWidth）。
    int ClientHeight() {
        if (handle == 0) { return height; }
        #if WINDOWS
        return Win32Shell.ClientHeight((nint)handle);
        #else
        return zan_gui_client_height(handle);
        #endif
    }

    // 将 Canvas（表面）呈现到窗口。
    void Present(Canvas canvas) {
        if (handle == 0) { return; }
        #if WINDOWS
        Win32Shell.Present((nint)handle, canvas.surfaceId);
        #else
        zan_gui_present(handle, canvas.surfaceId);
        #endif
    }

    // 将下一次 Present 限制在声明的像素上：
    // 只重绘了几个小矩形的帧只需几次小
    // 上传，而非整个表面。声明每个变化的矩形
    // ——遗漏的部分保留先前呈现的像素。
    // 不声明（默认）则呈现全部。
    void PresentDirty(int x, int y, int w, int h) {
        if (handle == 0) { return; }
        #if WINDOWS
        Win32Shell.PresentDirty((nint)handle, x, y, w, h);
        #else
        zan_gui_present_dirty_add(x, y, w, h);
        #endif
    }

    // 整窗帧的呈现声明：本帧重画了窗口的每个像素，
    // 下一次 Present 对整个窗口上传，不做任何差分。
    // 整窗帧若不声明，呈现范围就交给运行时的差分影子——
    // 影子与屏幕失步时旧帧内容会永久留在屏上（见
    void PresentFull() {
        if (handle == 0) { return; }
        #if WINDOWS
        Win32Shell.PresentFull((nint)handle);
        #else
        /* 非 Windows 平台脏矩形队列标记：通知全量重绘，忽略排队脏区 */
        zan_gui_present_full();
        #endif
    }

    // 设置窗口标题。
    void SetTitle(string title) {
        if (handle == 0) { return; }
        #if WINDOWS
        Win32Shell.SetTitle((nint)handle, title);
        #else
        zan_gui_set_title(handle, title);
        #endif
    }

    // 设置鼠标光标类型。
    static void SetCursor(int cursorType) {
        #if WINDOWS
        Win32Shell.SetCursorShape(cursorType);
        #else
        zan_gui_set_cursor(cursorType);
        #endif
    }

    // 在故障护栏下执行 `fn(arg)`：正常跑完返回 true；
    // 期间的硬故障（越界、空指针、除零……）已记入
    // &lt;exe 目录&gt;\zan_crash.log 并放弃这段工作时返回 false，
    // 进程继续运行。`fn` 必须是 `static void f(nint)` 的函数指针。
    static bool GuardCall(nint fn, nint arg) {
        return Window.zan_gui_guard_call(fn, arg) != 0;
    }

    // 用护栏包住窗口过程 `proc`（`static nint f(nint, int, nint, nint)`），
    // 返回改为注册的地址。一条消息内的硬故障在回调内部就地恢复，只丢这
    // 一条消息；窗口消息状态由 Win32 正常收尾，不会卡住消息循环。
    static nint GuardWndProc(nint proc) {
        return Window.zan_gui_guard_wndproc(proc);
    }

    // 本次运行被护栏吞掉的硬故障次数。
    static int GuardRecovered() {
        return Window.zan_gui_guard_recovered();
    }

    // 未冻结的真实单调毫秒时钟：FreezeTick 只影响 GetTickMs，
    // 经此读取的时钟照走。
    static int RawTickMs() {
        #if WINDOWS
        return Win32Shell.TickMs();
        #else
        return zan_gui_get_tick_ms();
        #endif
    }

    // 返回当前时间（毫秒）。
    static int GetTickMs() {
        if (frozenTick) { return frozenTickMs; }
        return Window.RawTickMs();
    }

    // 测试专用：冻结所有经过 Window.GetTickMs() 的时间读取。
    static void FreezeTick(int fixedMs) {
        frozenTickMs = fixedMs;
        frozenTick = true;
    }

    // 测试专用：恢复真实单调时钟。
    static void UnfreezeTick() {
        frozenTick = false;
    }

    // 返回当前时间（微秒），用于一帧之内的分相位计时。
    // 每 1000 秒回绕一次，只可用来算差值。
    static int GetTickUs() {
        #if WINDOWS
        return Win32Shell.TickUs();
        #else
        return zan_gui_get_tick_ms() * 1000;
        #endif
    }

    // 让调用线程休眠指定的毫秒数（帧节奏控制）。
    static void SleepMs(int ms) {
        #if WINDOWS
        Win32Shell.Sleep(ms);
        #else
        zan_gui_sleep_ms(ms);
        #endif
    }

    // 最小化窗口。
    void Minimize() {
        if (handle == 0) { return; }
        #if WINDOWS
        Win32Shell.Minimize((nint)handle);
        #else
        zan_gui_minimize(handle);
        #endif
    }

    // 在最大化与还原之间切换。
    void ToggleMaximize() {
        if (handle == 0) { return; }
        #if WINDOWS
        Win32Shell.ToggleMaximize((nint)handle);
        #else
        zan_gui_toggle_maximize(handle);
        #endif
    }

    // 请求关闭窗口。
    void Close() {
        if (handle == 0) { return; }
        #if WINDOWS
        Win32Shell.CloseWindow((nint)handle);
        #else
        zan_gui_close_window(handle);
        #endif
    }

    // 彻底拆除窗口（销毁 OS 窗口）。
    // 在响应关闭事件后调用，避免对话框作为
    // 孤儿滞留；在主窗口上为空操作。
    void Destroy() {
        if (handle == 0) { return; }
        #if WINDOWS
        Win32Shell.Destroy((nint)handle);
        #else
        zan_gui_destroy_window(handle);
        #endif
    }

    // 窗口当前处于最大化状态时为真。
    bool IsMaximized() {
        if (handle == 0) { return false; }
        #if WINDOWS
        return Win32Shell.Maximized((nint)handle);
        #else
        return zan_gui_is_maximized(handle) != 0;
        #endif
    }

    // 窗口任意部分可见时（未最小化
    // 且未被其他窗口完全遮挡）为真。环境动画
    // 在该值为假时暂停。
    bool IsVisible() {
        if (handle == 0) { return false; }
        #if WINDOWS
        return Win32Shell.Visible((nint)handle);
        #else
        return zan_gui_window_visible(handle) != 0;
        #endif
    }

    // 此窗口持有输入焦点时为真。
    // 此时环境动画会减速至心跳节奏。
    bool IsFocused() {
        if (handle == 0) { return false; }
        #if WINDOWS
        return Win32Shell.Focused((nint)handle);
        #else
        return zan_gui_window_focused(handle) != 0;
        #endif
    }

    // 在此窗口后启用系统原生半透明玻璃，
    // 由打包的 ARGB `tint` 着色。渲染器必须将表面清为
    // 透明，效果才能透出。
    void EnableGlass(int tint) {
        if (handle == 0) { return; }
        #if WINDOWS
        Win32Shell.EnableGlass((nint)handle, tint);
        #else
        zan_gui_enable_glass(handle, tint);
        #endif
    }

    // 恢复为不透明窗口。
    void DisableGlass() {
        if (handle == 0) { return; }
        #if WINDOWS
        Win32Shell.DisableGlass((nint)handle);
        #else
        zan_gui_disable_glass(handle);
        #endif
    }

    // 整个窗口的不透明度（百分比），限制在 10..100。100 = 完全不透明。
    void SetOpacity(int percent) {
        if (handle == 0) { return; }
        #if WINDOWS
        Win32Shell.SetOpacity((nint)handle, percent);
        #else
        zan_gui_set_opacity(handle, percent);
        #endif
    }

    // 窗口轮廓为形状区域的并集，`spec` 格式：
    // "t,x,y,w,h,r;t,x,y,w,h,r;..."（逻辑像素；1 = 圆角矩形、2 =
    // 椭圆）。"" 恢复为普通不透明矩形。DWM 开启时以逐像素
    // alpha（分层窗口）合成，DWM 关闭时以合并区域
    // 合成，因此异形窗口在 Windows 7 上也能工作。轮廓
    // 具有抗锯齿边缘（DWM），外部区域对
    // 绘制和鼠标输入都透明。不应用亚克力模糊。仅限 Windows；
    // 其他平台为安全空操作。
    void SetShape(string spec) {
        if (handle == 0) { return; }
        #if WINDOWS
        Win32Shell.SetShape((nint)handle, spec);
        #endif
    }

    // 窗口外轮廓圆角（Windows 11 22000+ 由 DWM 合成：
    // 一致、抗锯齿、与系统投影匹配；旧系统安全空操作）。`on`
    // 为 false 时恢复系统默认方角/策略。无边框窗口需要保持
    // 1px DWM 框架扩展（创建时已加）圆角才可见。
    void SetRoundCorners(bool on) {
        if (handle == 0) { return; }
        #if WINDOWS
        Win32Shell.SetRoundCorners((nint)handle, on);
        #endif
    }

    // 启用或禁用窗口置顶（topmost）。
    void SetTopmost(bool on) {
        if (handle == 0) { return; }
        int v = 0;
        if (on) { v = 1; }
        #if WINDOWS
        Win32Shell.SetTopmost((nint)handle, on);
        #else
        zan_gui_set_topmost(handle, v);
        #endif
    }

    // 设置窗口最小允许尺寸（逻辑像素，仅限 Windows）。
    void SetMinSize(int minW, int minH) {
        if (handle == 0) { return; }
        #if WINDOWS
        Win32Shell.SetMinTrackSize((nint)handle, minW, minH);
        #endif
    }

    // 窗口是否可由用户改变大小。关闭后边框不再
    // 充当尺寸手柄，双击标题栏与最大化也不再放大窗口。
    // 仅限 Windows；其他平台为安全空操作。
    void SetResizable(bool on) {
        if (handle == 0) { return; }
        #if WINDOWS
        Win32Shell.SetResizable((nint)handle, on);
        #endif
    }

    // 窗口是否允许最大化（默认允许）。标题栏不画最大化
    // 按钮的窗口应关闭它，否则双击标题栏与 Win+Up 仍会放大窗口。
    // 仅限 Windows；其他平台为安全空操作。
    void SetMaximizable(bool on) {
        if (handle == 0) { return; }
        #if WINDOWS
        Win32Shell.SetMaximizable((nint)handle, on);
        #endif
    }

    // 工具窗口样式（WS_EX_TOOLWINDOW）：细标题栏、
    // 不占任务栏与 Alt-Tab 列表。仅限 Windows；
    // 其他平台为安全空操作。
    void SetToolWindow(bool on) {
        if (handle == 0) { return; }
        #if WINDOWS
        Win32Shell.SetToolWindow((nint)handle, on);
        #endif
    }

    // 本窗口此前是否被 SetToolWindow(true) 标记过。
    bool ToolWindow() {
        if (handle == 0) { return false; }
        #if WINDOWS
        return Win32Shell.IsToolWindow((nint)handle);
        #else
        return false;
        #endif
    }

    // 告知运行时框架绘制多少个标题按钮，
    // 使可拖拽标题栏区域排除它们。
    void SetCaptionButtons(int count) {
        if (handle == 0) { return; }
        #if WINDOWS
        Win32Shell.SetCaptionButtons(handle, count);
        #else
        zan_gui_set_caption_buttons(handle, count);
        #endif
    }

    // 清除上一帧声明的客户端优先条带（见
    // <see cref="AddHitGuard"/>）。由应用每帧调用一次。
    void ClearHitGuards() {
        if (handle == 0) { return; }
        #if WINDOWS
        Win32Shell.ClearHitGuards((nint)handle);
        #else
        zan_gui_clear_hit_guards(handle);
        #endif
    }

    // 为客户端区域抢占一个矩形（客户端像素），
    // 使边框边缘缩放手柄不遮挡紧贴窗口边缘绘制的控件。
    // 角手柄保持优先。
    void AddHitGuard(int x, int y, int w, int h) {
        if (handle == 0) { return; }
        #if WINDOWS
        Win32Shell.AddHitGuard((nint)handle, x, y, w, h);
        #else
        zan_gui_add_hit_guard(handle, x, y, w, h);
        #endif
    }

    // 为自定义标题栏保留的高度（设备像素）。
    static int TitlebarHeight() {
        #if WINDOWS
        return Win32Shell.TitlebarHeight();
        #else
        return zan_gui_titlebar_height();
        #endif
    }

    // 运行期加高自绘标题栏保留带（设备像素，只增不减）：
    // 原生拖动条带与标题按钮布局同步加高。仅 Windows 后端支持
    // 运行期加高；其余后端维持启动时的缺省保留带。
    void SetTitlebarHeight(int devicePx) {
        if (handle == 0) { return; }
        #if WINDOWS
        Win32Shell.SetTitlebarHeight(handle, devicePx);
        #endif
    }

    // 登记标题栏右侧客户区保护带宽度（设备像素）：标题栏
    // 高度以内、窗口右缘向左 width 的条带 [w-width, w) 内的按下
    // 交给客户区（应用按钮/胶囊命中区），不当作窗口拖动。
    // 仅 Windows 后端实现。
    void SetCaptionZone(int width) {
        if (handle == 0) { return; }
        #if WINDOWS
        Win32Shell.SetCaptionZone((nint)handle, width);
        #endif
    }

    // 单个标题按钮的宽度（设备像素）。
    static int CaptionButtonWidth() {
        #if WINDOWS
        return Win32Shell.CaptionButtonWidth();
        #else
        return zan_gui_caption_button_width();
        #endif
    }

    // 屏幕安全区边距（设备像素，避开刘海/灵动岛与底部手势横条）
    int GetSafeAreaTop() {
        #if WINDOWS
        return 0;
        #else
        return zan_gui_safe_area_top();
        #endif
    }

    int GetSafeAreaBottom() {
        #if WINDOWS
        return 0;
        #else
        return zan_gui_safe_area_bottom();
        #endif
    }

    int GetSafeAreaLeft() {
        #if WINDOWS
        return 0;
        #else
        return zan_gui_safe_area_left();
        #endif
    }

    int GetSafeAreaRight() {
        #if WINDOWS
        return 0;
        #else
        return zan_gui_safe_area_right();
        #endif
    }
}

