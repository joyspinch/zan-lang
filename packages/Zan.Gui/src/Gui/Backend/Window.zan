using System;
using System.Collections.Generic;
using Gui;
namespace Gui.Backend;
public class Window {
    static bool frozenTick;
    static int frozenTickMs;
    [DllImport("zan_gui")]
    static extern int zan_gui_guard_call(nint fn, nint arg);
    [DllImport("zan_gui")]
    static extern nint zan_gui_guard_wndproc(nint proc);
    [DllImport("zan_gui")]
    static extern int zan_gui_guard_recovered();
    nint handle;
    WindowLifetime lifetime;
    int width;
    int height;
    int localKind;
    int localX;
    int localY;
    int localButton;
    int localKey;
    int localMods;
    int localFlag;
    long localSeq;
    Window(string title, int width, int height) : this(title, width, height, false) { }
    Window(string title, int width, int height, bool physical) {
        if (physical) {
            this.handle = Platform.Window().CreateWindowPhysical(title, width, height);
        } else {
            this.handle = Platform.Window().CreateWindow(title, width, height);
        }
        this.lifetime = Platform.CaptureWindowLifetime(this.handle);
        this.width = width;
        this.height = height;
    }
    static Window CreatePhysical(string title, int width, int height) {
        Window w = new Window(title, width, height, true);
        return w;
    }
    static Window Offscreen(int width, int height) { return new Window(width, height); }
    Window(int width, int height) {
        this.handle = 0;
        this.width = width;
        this.height = height;
    }
    void SetLocalEvent(int kind, int x, int y, int button, int key, int mods, int flag) {
        if (handle != 0) { return; }
        localKind = kind;
        localX = x;
        localY = y;
        localButton = button;
        localKey = key;
        localMods = mods;
        localFlag = flag;
        if (kind != 0) { localSeq = localSeq + 1; }
    }
    static void SetSizePaint(SizePaintBody body) { Platform.Shell().SetSizePaint(body); }
    static void SetResizeBackground(int color) { Platform.Shell().SetResizeBackground(color); }
    void Show() {
        if (handle == 0) { return; }
        Platform.Window().ShowWindow(handle);
    }
    void SetCloseIntercept(bool on) { Platform.Window().SetCloseIntercept(handle, on); }
    void SetPosition(int x, int y) {
        if (handle == 0) { return; }
        Platform.Window().SetPosition(handle, x, y);
    }
    int GetDpiScale() {
        if (handle == 0) { return 100; }
        return Platform.Window().DpiScale(handle);
    }
    int GetTitlebarHeight() { return Platform.Window().TitlebarHeight(handle); }
    int GetCaptionButtonWidth() { return Platform.Window().CaptionButtonWidth(handle); }
    void SetClientSize(int w, int h) {
        if (handle == 0) { return; }
        int scale = this.GetDpiScale();
        Platform.Window().ResizeClient(handle, w * scale / 100, h * scale / 100);
    }
    void SetClientSizeDev(int wDev, int hDev) {
        if (handle == 0) { return; }
        Platform.Window().ResizeClientExact(handle, wDev, hDev);
    }
    void Center() {
        if (handle == 0) { return; }
        Platform.Window().Center(handle);
    }
    double RefreshRate() {
        if (handle == 0) { return 60.0; }
        return Platform.Window().RefreshRate(handle);
    }
    bool RequestDisplayFrame() {
        if (handle == 0) { return false; }
        return Platform.Window().RequestDisplayFrame(handle);
    }
    bool TakeDisplayFrame() {
        if (handle == 0) { return false; }
        return Platform.Window().TakeDisplayFrame(handle);
    }
    bool NativeClosed() { return lifetime != null && lifetime.closed; }
    int CompleteWindowEvent(int result) {
        if (result >= 0 && this.NativeClosed()
        && (result == 1 || Window.EventHwnd() == 0 || Window.EventHwnd() == handle)) { return 0 - 1; }
        return result;
    }
    int WaitEvent() {
        if (this.NativeClosed()) { return 0 - 1; }
        if (handle == 0) { return 0; }
        return this.CompleteWindowEvent(Platform.Shell().WaitEvent());
    }
    int WaitEventTimeout(int ms) {
        if (this.NativeClosed()) { return 0 - 1; }
        if (handle == 0) { return 0; }
        return this.CompleteWindowEvent(Platform.Shell().WaitEventTimeout(ms));
    }
    int PollEvent() {
        if (this.NativeClosed()) { return 0 - 1; }
        if (handle == 0) { return 0; }
        return this.CompleteWindowEvent(Platform.Shell().PollEvent());
    }
    void Wake() {
        if (handle == 0) { return; }
        Platform.Shell().Wake();
    }
    void InjectEvent(int kind, int x, int y, int button, int keycode, int mods) {
        if (handle == 0) { return; }
        Platform.Shell().InjectEvent(handle, kind, x, y, button, keycode, mods);
    }
    static int InjectPending() { return Platform.Shell().InjectPending(); }
    List<string> TakeDroppedFiles() { return Platform.Shell().TakeDroppedFiles(); }
    bool DropPending() {
        if (handle == 0) { return false; }
        return Platform.Shell().DropPending();
    }
    int EventKind() {
        if (handle == 0) { return localKind; }
        return Platform.Shell().EventKind();
    }
    long EventSeq() { return handle == 0 ? localSeq : Window.EventSeqGlobal(); }
    static long EventSeqGlobal() {
        #if WINDOWS
        return Win32Shell.EventSeqValue();
        #else
        return Platform.Shell().EventSeq();
        #endif
    }
    int EventX() {
        if (handle == 0) { return localX; }
        return Platform.Shell().EventX();
    }
    int EventY() {
        if (handle == 0) { return localY; }
        return Platform.Shell().EventY();
    }
    int EventButton() {
        if (handle == 0) { return localButton; }
        return Platform.Shell().EventButton();
    }
    int EventKeyCode() {
        if (handle == 0) { return localKey; }
        return Platform.Shell().EventKeyCode();
    }
    int EventMods() {
        if (handle == 0) { return localMods; }
        return Platform.Shell().EventMods();
    }
    int EventFlag() {
        if (handle == 0) { return localFlag; }
        return Platform.Shell().EventFlag();
    }
    int GetWidth() {
        if (handle == 0) { return width; }
        return Platform.Shell().WindowWidth();
    }
    int GetHeight() {
        if (handle == 0) { return height; }
        return Platform.Shell().WindowHeight();
    }
    nint GetHandle() { return handle; }
    static nint EventHwnd() { return Platform.Shell().EventHwnd(); }
    static nint SizePaintWindow() { return Platform.Shell().SizePaintWindow(); }
    int ClientWidth() {
        if (handle == 0) { return width; }
        return Platform.Window().ClientWidth(handle);
    }
    int ClientHeight() {
        if (handle == 0) { return height; }
        return Platform.Window().ClientHeight(handle);
    }
    int DpiRevision() {
        if (handle == 0) { return 0; }
        return Platform.Window().DpiRevision(handle);
    }
    bool DpiFramePending() {
        #if WINDOWS
        if (handle != 0) {
            Win32CaptionConfig caption = Win32Shell.DpiConfigOf(handle);
            return caption.dpiRevision != caption.presentedDpiRevision;
        }
        #endif
        return false;
    }
    void PresentSurface(int surfaceId, int fullFrameDpiRevision = -1) {
        if (handle == 0) { return; }
        #if WINDOWS
        if (fullFrameDpiRevision > 0 && this.DpiFramePending()) {
            Win32Shell.Present(handle, surfaceId, fullFrameDpiRevision);
            return;
        }
        #endif
        Platform.Window().Present(handle, surfaceId);
    }
    void PresentDirty(int x, int y, int w, int h) {
        if (handle == 0) { return; }
        Platform.Window().PresentDirty(handle, x, y, w, h);
    }
    void PresentFull() {
        if (handle == 0) { return; }
        Platform.Window().PresentFull(handle);
    }
    void SetTitle(string title) {
        if (handle == 0) { return; }
        Platform.Window().SetTitle(handle, title);
    }
    static void SetCursor(int cursorType) { Platform.Shell().SetCursor(cursorType); }
    static bool GuardCall(nint fn, nint arg) { return Window.zan_gui_guard_call(fn, arg) != 0; }
    static nint GuardWndProc(nint proc) { return Window.zan_gui_guard_wndproc(proc); }
    static int GuardRecovered() { return Window.zan_gui_guard_recovered(); }
    static int RawTickMs() { return Platform.Shell().RawTickMs(); }
    static int GetTickMs() {
        if (frozenTick) { return frozenTickMs; }
        return Window.RawTickMs();
    }
    static void FreezeTick(int fixedMs) {
        frozenTickMs = fixedMs;
        frozenTick = true;
    }
    static void UnfreezeTick() { frozenTick = false; }
    static int GetTickUs() { return Platform.Shell().GetTickUs(); }
    static void SleepMs(int ms) { Platform.Shell().SleepMs(ms); }
    void Minimize() {
        if (handle == 0) { return; }
        Platform.Window().Minimize(handle);
    }
    void ToggleMaximize() {
        if (handle == 0) { return; }
        Platform.Window().ToggleMaximize(handle);
    }
    void Close() {
        if (handle == 0) { return; }
        Platform.Window().Close(handle);
    }
    void Destroy() {
        if (handle == 0 || this.NativeClosed()) { return; }
        Platform.Window().Destroy(handle);
    }
    bool IsMaximized() {
        if (handle == 0) { return false; }
        return Platform.Window().IsMaximized(handle);
    }
    bool IsVisible() {
        if (handle == 0) { return false; }
        return Platform.Window().IsVisible(handle);
    }
    bool IsFocused() {
        if (handle == 0) { return false; }
        return Platform.Window().IsFocused(handle);
    }
    void EnableGlass(int tint) {
        if (handle == 0) { return; }
        Platform.Window().EnableGlass(handle, tint);
    }
    void DisableGlass() {
        if (handle == 0) { return; }
        Platform.Window().DisableGlass(handle);
    }
    void SetOpacity(int percent) {
        if (handle == 0) { return; }
        Platform.Window().SetOpacity(handle, percent);
    }
    void SetShape(string spec) {
        if (handle == 0) { return; }
        Platform.Window().SetShape(handle, spec);
    }
    void SetShapeDescription(WindowShapeDescription desc) {
        if (handle == 0) { return; }
        Platform.Window().SetShapeDescription(handle, desc);
    }
    void SetRoundCorners(bool on) {
        if (handle == 0) { return; }
        Platform.Window().SetRoundCorners(handle, on);
    }
    void SetTopmost(bool on) {
        if (handle == 0) { return; }
        Platform.Window().SetTopmost(handle, on);
    }
    void SetTransparent(bool on) {
        if (handle == 0) { return; }
        Platform.Window().SetTransparent(handle, on);
    }
    void SetClickThrough(bool on) {
        if (handle == 0) { return; }
        Platform.Window().SetClickThrough(handle, on);
    }
    void StartWindowDrag() {
        if (handle == 0) { return; }
        Platform.Window().StartWindowDrag(handle);
    }
    void SetMinSize(int minW, int minH) {
        if (handle == 0) { return; }
        Platform.Window().SetMinSize(handle, minW, minH);
    }
    void SetResizable(bool on) {
        if (handle == 0) { return; }
        Platform.Window().SetResizable(handle, on);
    }
    void SetMaximizable(bool on) {
        if (handle == 0) { return; }
        Platform.Window().SetMaximizable(handle, on);
    }
    void SetToolWindow(bool on) {
        if (handle == 0) { return; }
        Platform.Window().SetToolWindow(handle, on);
    }
    bool ToolWindow() {
        if (handle == 0) { return false; }
        return Platform.Window().ToolWindow(handle);
    }
    void SetCaptionButtons(int count) {
        if (handle == 0) { return; }
        Platform.Window().SetCaptionButtons(handle, count);
    }
    void ClearHitGuards() {
        if (handle == 0) { return; }
        Platform.Window().ClearHitGuards(handle);
    }
    void AddHitGuard(int x, int y, int w, int h) {
        if (handle == 0) { return; }
        Platform.Window().AddHitGuard(handle, x, y, w, h);
    }
    static int TitlebarHeight() { return Platform.Shell().DefaultTitlebarHeight(); }
    void SetTitlebarHeight(int devicePx) {
        if (handle == 0) { return; }
        Platform.Window().SetTitlebarHeight(handle, devicePx);
    }
    void SetCaptionZone(int width) {
        if (handle == 0) { return; }
        Platform.Window().SetCaptionZone(handle, width);
    }
    static int CaptionButtonWidth() { return Platform.Shell().DefaultCaptionButtonWidth(); }
    int GetSafeAreaTop() { return Platform.Shell().SafeAreaTop(); }
    int GetSafeAreaBottom() { return Platform.Shell().SafeAreaBottom(); }
    int GetSafeAreaLeft() { return Platform.Shell().SafeAreaLeft(); }
    int GetSafeAreaRight() { return Platform.Shell().SafeAreaRight(); }
    int GetKeyboardHeight() { return Platform.Shell().KeyboardHeight(); }
    void HapticFeedback(int type) { Platform.Shell().HapticFeedback(type); }
    public int SensorGet(int sensorType, float[] outVec) {
        return Platform.Shell().SensorGet(sensorType, outVec);
    }
    public int SensorSet(int sensorType, float x, float y, float z) {
        return Platform.Shell().SensorSet(sensorType, x, y, z);
    }
    public int NotificationSend(string title, string body, string action, int badge, string sound) {
        return Platform.Shell().NotificationSend(title, body, action, badge, sound);
    }
    public int NetworkType() { return Platform.Shell().NetworkType(); }
    public void SetNetworkType(int type) { Platform.Shell().SetNetworkType(type); }
    public bool IsDarkMode() { return Platform.Shell().IsDarkMode(); }
    public void SetDarkMode(bool isDark) { Platform.Shell().SetDarkMode(isDark); }
    public int ShareText(string text, string title) { return Platform.Shell().ShareText(text, title); }
    public string PickFile(string filter) { return Platform.Shell().PickFile(filter); }
    public int PermissionCheck(int permType) { return Platform.Shell().PermissionCheck(permType); }
    public int PermissionRequest(int permType) { return Platform.Shell().PermissionRequest(permType); }
    public void SetPermission(int permType, int status) { Platform.Shell().SetPermission(permType, status); }
    public void ScreenKeepAwake(bool enable) { Platform.Shell().ScreenKeepAwake(enable); }
    public bool ScreenIsKeepAwake() { return Platform.Shell().ScreenIsKeepAwake(); }
    public void ScreenSetBrightness(float brightness) { Platform.Shell().ScreenSetBrightness(brightness); }
    public float ScreenGetBrightness() { return Platform.Shell().ScreenGetBrightness(); }
    public int LocationGet(double[] outCoords, float[] outMetrics) {
        return Platform.Shell().LocationGet(outCoords, outMetrics);
    }
    public void LocationSet(double lat, double lon, double alt, float acc, float speed) {
        Platform.Shell().LocationSet(lat, lon, alt, acc, speed);
    }
    public string DeviceInfoGet(int infoKey) { return Platform.Shell().DeviceInfoGet(infoKey); }
    public bool DeviceIsFoldable() { return Platform.Shell().DeviceIsFoldable(); }
    public void DeviceInfoSet(int infoKey, string val) { Platform.Shell().DeviceInfoSet(infoKey, val); }
    public bool BiometricsCanAuthenticate() { return Platform.Shell().BiometricsCanAuthenticate(); }
    public int BiometricsType() { return Platform.Shell().BiometricsType(); }
    public bool BiometricsAuthenticate(string title, string subtitle) {
        return Platform.Shell().BiometricsAuthenticate(title, subtitle);
    }
    public void BiometricsSetMock(bool canAuth, int bioType, bool authResult) {
        Platform.Shell().BiometricsSetMock(canAuth, bioType, authResult);
    }
    public void SystemBarSetStatus(bool visible, int style, int color) {
        Platform.Shell().SystemBarSetStatus(visible, style, color);
    }
    public bool SystemBarIsStatusVisible() { return Platform.Shell().SystemBarIsStatusVisible(); }
    public int SystemBarStyle() { return Platform.Shell().SystemBarStyle(); }
    public int SystemBarColor() { return Platform.Shell().SystemBarColor(); }
    public void SystemBarSetNavVisible(bool visible) { Platform.Shell().SystemBarSetNavVisible(visible); }
    public bool SystemBarIsNavVisible() { return Platform.Shell().SystemBarIsNavVisible(); }
    public string TakeOpenUrl() { return Platform.Shell().TakeOpenUrl(); }
    public void InjectOpenUrl(string url) { Platform.Shell().InjectOpenUrl(url); }
}
