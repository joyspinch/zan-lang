    // 该表面上是否已经画过一帧（整表面清屏）。缩放时表面被销毁重建，
    // 而表面 id 会立即被回收复用：WM_PAINT/WM_SIZE 拿着 SurfaceOf(hwnd)
    // 记下的旧 id 去呈现，正好命中那块尚未绘制的新表面——里面是分配器
    // 交还的上一块表面内容，按旧 stride 排列，于是整窗都是斜切重影。
    [DllImport("zan_gui")]
    static extern int zan_gui_surface_painted(int surfaceId);

    static bool ready;
    static nint instance;
    static nint className;
    static nint mainHwnd;
    static nint eventHwnd;
    // 关窗拦截的窗口句柄：登记后，这个窗口收到 WM_CLOSE 时只投递
    // kind-8 事件、**不**销毁窗口，等 App 层同意（App.OnCloseGuard
    // 的处理器返回 true）再由 App 调 Destroy 真关掉；否决则窗口
    // 继续存在。
    //
    // 只登记一个窗口：主窗口。子窗口（对话框/文件选择器）不受影响，
    // 它们的关闭流程仍按原样走（见 ChildWindow.ApplyEvent 的
    // kind-8 分支与 FilePicker 的 ApplyEvent）。
    static nint closeInterceptHwnd;
    // Post 当前发布的事件所属的窗口。
    static nint evHwnd;

    // 上次 WM_DROPFILES 投递的文件路径，由
    // 应用看到 kind-9 事件时的 Window.TakeDroppedFiles() 取走。
    static List<string> dropped;

    // 最近上报的事件：kind、x、y、button、keycode、mods。
    static int evKind;
    static int evX;
    static int evY;
    static int evButton;
    static int evKeyCode;
    static int evMods;
    static bool hasEvent;
    // 每投递一个真实事件递增一次。EventKind() 在没有新事件的
    // 迭代里返回上一次的旧值（自定义循环的动画分支不泵就退出），
    // 应用据此区分"新事件"与"陈旧回读"——点击的帧绑定只能
    // 由新事件解除，否则一次释放会被每一帧当成新点击。
    static long evSeq;
    // 窗口过程投递的事件队列，使用 Win32QueuedEvent 实体消除 postQ/postHwnd 平行列表。
    static List<Win32QueuedEvent> postEvents;

    static int windowWidth;
    static int windowHeight;
    // 主框架可被拖到的最小物理尺寸（0 = 还没建窗口，用默认值）。
    static int minTrackW;
    static int minTrackH;
    static int dpi;
    static int titlebarH;
    static int buttonW;
    // 每个窗口在标题栏右侧保留的客户端绘制标题按钮数与保护带，
    // 使用 Win32CaptionConfig 强类型实体统一管理，消除 capHwnd/capCount 与 zoneHwnd/zoneWidth 平行列表。
    static List<Win32CaptionConfig> captionConfigs;
    // 不可调整大小的窗口（设计里的 resizable = false）。外壳是无
    // 边框的，尺寸手柄全靠 WM_NCHITTEST 给出，所以“不能拉”
    // 就是不再把边缘报成手柄，并挡住双击标题栏 / 最大化。
    static List<nint> fixedHwnd;
    // 关闭了最大化按钮的窗口。标题按钮画在客户区，外壳看不到
    // 哪个按钮存在，而双击标题栏与 SC_MAXIMIZE（Win+Up、系统
    // 菜单）会被 DefWindowProc 兜底成最大化——没有最大化按钮的
    // 窗口也照放大不误。App 显式登记到这里：不在表内才允许放大。
    static List<nint> noMaxHwnd;
    static int imeX;
    static int imeY;

    static bool glassOn;
    static int glassTint;
    // 异形窗口模式：0 = 矩形，1 = 异形。异形窗口的
    // 轮廓是 shapeRegionList 的并集（Win32ShapeRegion 实体，
    // 逻辑像素：kind 1 = 圆角矩形，kind 2 = 椭圆，kind 3 = 阴影带）。
    // DWM 合成开启（含 Windows 7）时以逐像素 alpha 合成
    // （WS_EX_LAYERED + UpdateLayeredWindow）实现，
    // DWM 关闭时用合并的 SetWindowRgn，因此即使 Win7
    // 没有 DWM 也能工作。所有区域之外的像素点击穿透。
    static int shapeMode;
    static List<Win32ShapeRegion> shapeRegionList;
    static int winOpacityPercent;
    static bool hasShadowBand;
    // 后端只转换一次规格；coverage 与最终 alpha 语义和离屏快照共享，
    // 缓存匹配包含物理尺寸、DPI 与全部区域标量。
    static WindowShapeMask shapeMask;
    static List<WindowShapeRegion> shapeMaskRegions;

    // 每窗口最近呈现的表面（使用 Win32SurfaceBinding 强类型实体消除 surfHwnd/surfId 平行列表）。
    static List<Win32SurfaceBinding> surfaceBindings;
    static int lastSurface;

    // 为下一次呈现声明的脏矩形（使用 Win32DirtyRect 实体集合为唯一主表示，彻底消除平行四元组反模式）。
    static List<Win32DirtyRect> dirtyRects;
    static bool dirtyOverflow;
    static nint dirtyHwnd;
    static List<nint> dirtyLost;

    // 诊断：ZAN_PRESENT_LOG 非空时把每次 Blit 的脏矩形状态追加到
    // present_log.txt（见 Blit 开头）。
    static bool presentLog;
    static extern string getenv(string name);

    // WM_PAINT 分支正在呈现：OS 判定重定向表面失效，差分阴影不再可信，
    // 这次 Blit 必须整窗上传（zan_gui_gdi_present 的 rectCount=-1 语义）。
    static bool wmPaintBlit;

    // 应用声明“这一帧重画了每一个像素”：下一次该窗口的 Blit 整窗上传。
    // 整窗帧不经过 PresentDirty，此前落进瓦片差分（阴影比对）——阴影
    // 与重定向表面一旦失步（上传过却没上屏的块），差异比对会永远认为
    // 那块没变，旧帧内容就永久留在屏上。整窗帧的上传范围由应用自己
    // 说清楚，不依赖任何影子。
    static bool forceFullUpload;
    static nint forceFullHwnd;

    // 自动化驱动排队的合成事件，由临界区保护，使用 Win32QueuedEvent 实体消除 injectQ/injectHwnd 平行队列。
    static List<Win32QueuedEvent> injectEvents;
    static nint injectCs;

    // 缓存的分层窗口呈现表面（玻璃），尺寸变化时重建。
    static nint lwDc;
    static nint lwBitmap;
    static nint lwOld;
    static nint lwBits;
    static int lwW;
    static int lwH;

    // 客户端优先条带（使用 Win32HitGuardEntry 强类型实体消除 hitGuards/hitGuardWins 平行列表反模式）。
    static List<Win32HitGuardEntry> hitGuardEntries;

    static nint scratchRect;
    static nint scratchRects;
    static nint scratchMsg;
    static nint bitmapInfo;
    static int bgColor;
    static int displayChangeSerial;
    // 读取 32 位字段。Win32 RECT / POINT 坐标在
    // 多显示器布局下会为负，因此该值保持有符号。
    static int S32(nint p, int off) {
        return new Span<int>(p + off, 1)[0];
    }
}
