    // GPU 直通呈现：光栅化器把帧直接交换到该窗口上，返回 1 表示
    // 屏幕已经是这一帧、外壳不要再贴位图；返回 0 表示照旧走位图
    // （CPU 后端、拿不到 GL 的机器、以及分层玻璃窗都是 0）。
    [DllImport("zan_gui")]
    static extern int zan_gui_present_window(int surfaceId, nint nativeWindow);
    // 窗口即将销毁：让光栅化器释放挂在这个句柄上的东西。
