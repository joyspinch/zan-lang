using System;
using System.Collections.Generic;
namespace Gui.Backend;
public partial class Win32Shell {
    static List<WindowLifetime> windowLifetimes;
    [DllImport("kernel32", EntryPoint = "GetCurrentThreadId")]
    static extern int GetCurrentThreadId();
    [DllImport("user32", EntryPoint = "PostThreadMessageW")]
    static extern int PostThreadMessageW(int threadId, int message, nint wp, nint lp);
    static void WakeClosedWindow() {
        Win32Shell.PostThreadMessageW(Win32Shell.GetCurrentThreadId(), 0, 0, 0);
    }
    internal static WindowLifetime FindWindowLifetime(nint hwnd) {
        if (Win32Shell.windowLifetimes != null) {
            foreach (WindowLifetime lifetime in Win32Shell.windowLifetimes) {
                if (lifetime.handle == hwnd) { return lifetime; }
            }
        }
        return null;
    }
    static void BeginWindowLifetime(nint hwnd) {
        if (Win32Shell.windowLifetimes == null) { Win32Shell.windowLifetimes = new List<WindowLifetime>(); }
        Win32Shell.windowLifetimes.Add(new WindowLifetime(hwnd));
    }
    static void CloseWindowLifetime(nint hwnd) {
        WindowLifetime lifetime = Win32Shell.FindWindowLifetime(hwnd);
        if (lifetime != null) { lifetime.closed = true; }
        if (Win32Shell.closeInterceptHwnd == hwnd) { Win32Shell.closeInterceptHwnd = 0; }
    }
    static void EndWindowLifetime(nint hwnd) {
        if (Win32Shell.windowLifetimes == null) { return; }
        for (int i = Win32Shell.windowLifetimes.Count - 1; i >= 0; i--) {
            WindowLifetime lifetime = Win32Shell.windowLifetimes[i];
            if (lifetime.handle == hwnd) {
                lifetime.closed = true;
                Win32Shell.windowLifetimes.RemoveAt(i);
                return;
            }
        }
    }
    static bool PostedLifetimeCurrent(Win32QueuedEvent ev) {
        WindowLifetime lifetime = ev.lifetime;
        if (lifetime == null) { return true; }
        WindowLifetime current = Win32Shell.FindWindowLifetime(ev.hwnd);
        if (lifetime.closed) { return ev.kind == 8 && current == null; }
        return current == lifetime;
    }
}
