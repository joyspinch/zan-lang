    static void ShellOpenUrl(string url) {
        nint wOp = Wide.Of("open");
        nint wUrl = Wide.Of(url);
        WinShellExecuteW(0, wOp, wUrl, 0, 0, 1 /* SW_SHOWNORMAL */);
        Wide.Free(wOp);
        Wide.Free(wUrl);
    }
