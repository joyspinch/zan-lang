using System;
using System.Collections.Generic;
using Gui;
namespace Gui.Backend;

public class Win32CaptionConfig {
    public nint hwnd;
    public int capCount;
    public int zoneWidth;
    public int dpi;
    internal int dpiRevision;
    internal int presentedDpiRevision;
    public int titlebarLogical;
    public int titlebarH;
    public int buttonW;
    public int minTrackLogicalW;
    public int minTrackLogicalH;
    public int minTrackPhysicalW;
    public int minTrackPhysicalH;
    public bool physicalStage;
    public bool roundCorner;
    internal int appliedDwmRound;
    public Win32CaptionConfig(nint hwnd, int capCount, int zoneWidth) {
        this.hwnd = hwnd;
        this.capCount = capCount;
        this.zoneWidth = zoneWidth;
        this.titlebarLogical = 32;
        this.roundCorner = true;
        this.appliedDwmRound = 0 - 1;
    }
}

public class Win32DirtyRect {
    public int x;
    public int y;
    public int w;
    public int h;
    public Win32DirtyRect(int x, int y, int w, int h) {
        this.x = x;
        this.y = y;
        this.w = w;
        this.h = h;
    }
}

public class Win32HitGuardEntry {
    public nint hwnd;
    public int x;
    public int y;
    public int w;
    public int h;
    public Win32HitGuardEntry(nint hwnd, int x, int y, int w, int h) {
        this.hwnd = hwnd;
        this.x = x;
        this.y = y;
        this.w = w;
        this.h = h;
    }
}

public class Win32QueuedEvent {
    public nint hwnd;
    internal WindowLifetime lifetime;
    public int kind;
    public int x;
    public int y;
    public int button;
    public int keycode;
    public int mods;
    public Win32QueuedEvent(nint hwnd, int kind, int x, int y, int button, int keycode, int mods) {
        this.hwnd = hwnd;
        this.kind = kind;
        this.x = x;
        this.y = y;
        this.button = button;
        this.keycode = keycode;
        this.mods = mods;
    }
}

public class Win32ShapeRegion {
    public int kind;
    public int x;
    public int y;
    public int w;
    public int h;
    public int r;
    public Win32ShapeRegion(int k, int x, int y, int w, int h, int r) {
        this.kind = k;
        this.x = x;
        this.y = y;
        this.w = w;
        this.h = h;
        this.r = r;
    }
}

public class Win32SurfaceBinding {
    public nint hwnd;
    public int surfaceId;
    public Win32SurfaceBinding(nint hwnd, int surfaceId) {
        this.hwnd = hwnd;
        this.surfaceId = surfaceId;
    }
}
