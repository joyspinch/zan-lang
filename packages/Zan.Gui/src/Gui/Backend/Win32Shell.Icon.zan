using System;
using System.Collections.Generic;
using Gui;

namespace Gui.Backend;

public partial class Win32Shell {
    static bool appIconReady;

    // 从 exe 文件取程序图标（图标组索引 0）。只取一次。
    static void LoadAppIcon() {
        if (Win32Shell.appIconReady) { return; }
        Win32Shell.appIconReady = true;
        string exe = Environment.ProcessPath;
        if (exe == null || exe == "") { return; }
        nint wpath = Wide.Of(exe);
        nint slots = NativeMemory.Alloc(16);
        try {
            NativeMemory.Fill(slots, 0, 16);
            // ExtractIconExW 的两个输出参数是 HICON*：各写一个句柄。
            Win32Shell.ExtractIconExW(wpath, 0, slots, slots + 8, 1);
            Win32Shell.appIconBig = new Span<long>(slots, 1)[0];
            Win32Shell.appIconSmall = new Span<long>(slots + 8, 1)[0];
        } finally {
            NativeMemory.Free(slots);
            Wide.Free(wpath);
        }
        if (Win32Shell.appIconBig == 0) { return; }
        int[] px = Win32Shell.IconPixels(Win32Shell.appIconBig);
        if (px == null) { return; }
        Win32Shell.appIconPixels = px;
        Win32Shell.appIconSide = Win32Shell.IconSide(px);
    }

    // HICON → ARGB 像素（0xAARRGGBB，顶行优先）。取不到返回 null。
    //
    // 走 GDI：GetIconInfo 拿颜色位图，GetDIBits 用 BITMAPV4 头
    // （BI_BITFIELDS + alpha 掩码）才能把图标自带的透明通道取回来；
    // 普通 32bpp BI_RGB 取回来的 alpha 全 0（图标会整块变透明）。
    static int[] IconPixels(nint hIcon) {
        // ICONINFO（x64）：fIcon@0 xHotspot@4 yHotspot@8 hbmMask@16
        // hbmColor@24
        nint ii = NativeMemory.Alloc(32);
        nint bmp = NativeMemory.Alloc(32);
        nint hdr = NativeMemory.Alloc(124);
        nint bits = 0;
        int[] result = null;
        try {
            NativeMemory.Fill(ii, 0, 32);
            if (Win32Shell.GetIconInfo(hIcon, ii) == 0) { return null; }
            nint hbmColor = new Span<long>(ii + 24, 1)[0];
            if (hbmColor == 0) { return null; }
            // BITMAP：bmType@0 bmWidth@4 bmHeight@8
            NativeMemory.Fill(bmp, 0, 32);
            if (Win32Shell.GetObjectW(hbmColor, 32, bmp) == 0) { return null; }
            int w = new Span<int>(bmp + 4, 1)[0];
            int h = new Span<int>(bmp + 8, 1)[0];
            if (w <= 0 || h <= 0 || w > 512 || h > 512) { return null; }
            // BITMAPV4HEADER（124 字节）
            NativeMemory.Fill(hdr, 0, 124);
            new Span<int>(hdr, 1)[0] = 124;          // bV4Size
            new Span<int>(hdr + 4, 1)[0] = w;         // bV4Width
            new Span<int>(hdr + 8, 1)[0] = 0 - h;    // bV4Height：负=顶行优先
            // planes@12 / bitCount@14 各 16 位：1 与 32
            new Span<int>(hdr + 12, 1)[0] = 1 | (32 << 16);
            new Span<int>(hdr + 16, 1)[0] = 3;       // BI_BITFIELDS
            new Span<int>(hdr + 40, 1)[0] = 0x00FF0000;   // red
            new Span<int>(hdr + 44, 1)[0] = 0x0000FF00;   // green
            new Span<int>(hdr + 48, 1)[0] = 0x000000FF;   // blue
            new Span<int>(hdr + 52, 1)[0] = 0 - 16777216; // alpha 0xFF000000
            int count = w * h;
            bits = NativeMemory.Alloc(count * 4);
            if (bits == 0) { return null; }
            nint dc = Win32Shell.GetDC(0);
            int lines = Win32Shell.GetDIBits(dc, hbmColor, 0, h, bits, hdr, 0);
            Win32Shell.ReleaseDC(0, dc);
            if (lines != h) { return null; }
            // BGRA → ARGB；alpha 全 0 说明这份图标没有透明通道，
            // 画出来是一块黑方块，宁可退回占位字形。
            Span<byte> src = new Span<byte>(bits, count * 4);
            int[] pixels = new int[count];
            int visible = 0;
            for (int i = 0; i < count; i = i + 1) {
                int o = i * 4;
                int a = src[o + 3];
                int r = src[o + 2];
                int g = src[o + 1];
                int b = src[o];
                pixels[i] = (a << 24) | (r << 16) | (g << 8) | b;
                if (a != 0) { visible = visible + 1; }
            }
            if (visible == 0) { return null; }
            result = pixels;
            return result;
        } finally {
            if (bits != 0) { NativeMemory.Free(bits); }
            NativeMemory.Free(ii);
            NativeMemory.Free(bmp);
            NativeMemory.Free(hdr);
        }
    }

    // 方形像素数组的边长；不是正方形返回 0。
    static int IconSide(int[] pixels) {
        if (pixels == null) { return 0; }
        int n = pixels.Length;
        int side = 0;
        for (int i = 1; i <= 256; i = i + 1) {
            if (i * i == n) { side = i; break; }
        }
        return side;
    }

    // 程序图标像素（0xAARRGGBB，顶行优先）；没有图标返回 null。
    static int[] AppIconPixels() {
        Win32Shell.LoadAppIcon();
        return Win32Shell.appIconPixels;
    }

    // 程序图标像素边长；没有图标返回 0。
    static int AppIconSide() {
        Win32Shell.LoadAppIcon();
        return Win32Shell.appIconSide;
    }

}
