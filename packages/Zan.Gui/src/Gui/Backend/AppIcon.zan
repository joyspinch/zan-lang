using System;

namespace Gui.Backend;

// 程序（exe）自己的图标。
//
// zanc 编译时把图标（--icon 指定的 .ico，或内置默认图标）写进
// Windows 资源（图标组 id=1），所以运行中的进程能取回"程序图标"：
// 自绘标题栏画它，窗口类也用它（任务栏、Alt+Tab）。Windows 走 GDI
// 把 HICON 栅格化成带 alpha 的像素；其它平台取不到，返回空，由调用
// 方回落到占位字形。
public class AppIcon {
    static int[] pixels;
    static int side;
    static bool loaded;

    // 程序图标像素（0xAARRGGBB，顶行优先）；没有图标返回 null。
    public static int[] Pixels() {
        if (!AppIcon.loaded) {
            AppIcon.loaded = true;
            #if WINDOWS
            AppIcon.pixels = Win32Shell.AppIconPixels();
            AppIcon.side = Win32Shell.AppIconSide();
            #endif
        }
        return AppIcon.pixels;
    }

    // 程序图标边长（正方形像素）；没有图标返回 0。
    public static int Side() {
        AppIcon.Pixels();
        return AppIcon.side;
    }
}
