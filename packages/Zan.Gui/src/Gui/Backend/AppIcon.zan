using System;
namespace Gui.Backend;
public class AppIcon {
    static int[] pixels;
    static int side;
    static bool loaded;
    public static int[] Pixels() {
        if (!AppIcon.loaded) {
            AppIcon.loaded = true;
            AppIcon.pixels = Platform.Shell().AppIconPixels();
            AppIcon.side = Platform.Shell().AppIconSide();
        }
        return AppIcon.pixels;
    }
    public static int Side() { AppIcon.Pixels(); return AppIcon.side; }
}
