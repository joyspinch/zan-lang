using System;
using System.Collections.Generic;

namespace Gui.Backend;

public class SysFile {
    // 将内容写入 path，覆盖已有文件。成功返回 true。
    static bool Write(string path, string content) {
        #if WINDOWS
        return Win32Shell.WriteTextFile(path, content);
        #else
        try {
            File.WriteAllText(path, content);
            return true;
        } catch (Exception e) {
            return false;
        }
        #endif
    }
}

// 与运行时事件编码一致的事件类型常量。
