using System;
using System.Collections.Generic;
namespace Gui.Backend;
public interface IPlatformShell {
    int WaitEvent();
    int WaitEventTimeout(int ms);
    int PollEvent();
    void Wake();
    int EventKind();
    long EventSeq();
    int EventX();
    int EventY();
    int EventButton();
    int EventKeyCode();
    int EventMods();
    int EventFlag();
    nint EventHwnd();
    nint SizePaintWindow();
    int WindowWidth();
    int WindowHeight();
    void InjectEvent(nint hwnd, int kind, int x, int y, int button,
    int keycode, int mods);
    int InjectPending();
    List<string> TakeDroppedFiles();
    bool DropPending();
    int RawTickMs();
    int GetTickUs();
    void SleepMs(int ms);
    void SetCursor(int cursorType);
    void SetSizePaint(SizePaintBody body);
    void SetResizeBackground(int color);
    int DefaultTitlebarHeight();
    int DefaultCaptionButtonWidth();
    int DpiScale();
    int SafeAreaTop();
    int SafeAreaBottom();
    int SafeAreaLeft();
    int SafeAreaRight();
    int KeyboardHeight();
    void HapticFeedback(int type);
    int SensorGet(int sensorType, float[] outVec);
    int SensorSet(int sensorType, float x, float y, float z);
    int NotificationSend(string title, string body, string action, int badge, string sound);
    int NetworkType();
    void SetNetworkType(int type);
    bool IsDarkMode();
    void SetDarkMode(bool isDark);
    int ShareText(string text, string title);
    string PickFile(string filter);
    int PermissionCheck(int permType);
    int PermissionRequest(int permType);
    void SetPermission(int permType, int status);
    void ScreenKeepAwake(bool enable);
    bool ScreenIsKeepAwake();
    void ScreenSetBrightness(float brightness);
    float ScreenGetBrightness();
    int LocationGet(double[] outCoords, float[] outMetrics);
    void LocationSet(double lat, double lon, double alt, float acc, float speed);
    string DeviceInfoGet(int infoKey);
    bool DeviceIsFoldable();
    void DeviceInfoSet(int infoKey, string val);
    bool BiometricsCanAuthenticate();
    int BiometricsType(); // 0: None, 1: Fingerprint, 2: Face
    bool BiometricsAuthenticate(string title, string subtitle);
    void BiometricsSetMock(bool canAuth, int bioType, bool authResult);
    void SystemBarSetStatus(bool visible, int style, int color);
    bool SystemBarIsStatusVisible();
    int SystemBarStyle();
    int SystemBarColor();
    void SystemBarSetNavVisible(bool visible);
    bool SystemBarIsNavVisible();
    string TakeOpenUrl();
    void InjectOpenUrl(string url);
    bool SweepLayered();
    bool ClipboardSet(string text);
    string ClipboardGet();
    void ImeSetCaret(int x, int y);
    void ImeSetOpen(bool on);
    string ImeComposing();
    int[] AppIconPixels();
    int AppIconSide();
}
