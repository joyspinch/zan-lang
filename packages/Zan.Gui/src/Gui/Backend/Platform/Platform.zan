using System;
using System.Collections.Generic;

namespace Gui.Backend;

// 平台后端选择点（进程唯一）：整个 Zan.Gui 对操作系统的访问只经由
// IPlatformWindow / IPlatformShell 两个契约，这里按编译目标把实现
// 挂上——Windows 走 Win32Platform（委托 Win32Shell），其余平台走
// CapiPlatform（委托 zan_gui_* C 驱动）。新增平台时在 Select 里加
// 一个分支即可，调用点零改动。
public class Platform {
    static IPlatformWindow window;
    static IPlatformShell shell;

    // 窗口级平台后端（创建/呈现/外观等句柄级操作）。
    public static IPlatformWindow Window() {
        if (Platform.window == null) { Platform.Select(); }
        return Platform.window;
    }

    // 进程级平台后端（事件泵/事件状态/时钟/系统能力）。
    public static IPlatformShell Shell() {
        if (Platform.shell == null) { Platform.Select(); }
        return Platform.shell;
    }

    static void Select() {
        #if WINDOWS
        Win32Platform w32 = new Win32Platform();
        Platform.window = w32;
        Platform.shell = w32;
        #else
        CapiPlatform capi = new CapiPlatform();
        Platform.window = capi;
        Platform.shell = capi;
        #endif
    }

    // ---- 链接锚（原 Window.zan 携带，随平台选择点迁到这里）----------

    // 这些导入确保链接器包含 gui_runtime 所需的系统库。
    [DllImport("user32")]
    static extern nint GetModuleHandleA(nint reserved);

    [DllImport("gdi32")]
    static extern nint GetStockObject(int fnObject);

    [DllImport("kernel32")]
    static extern int GetTickCount();
}
