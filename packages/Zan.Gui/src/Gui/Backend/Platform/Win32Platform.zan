    private int winNetworkType = 1; // 1: Wifi
    private bool winDarkMode = false;
    private int[] winPermissions = new int[] { 0, 0, 0, 0, 0, 0, 0, 0 };
    public int NetworkType() { return winNetworkType; }
    public void SetNetworkType(int type) {
        if (type >= 0 && type <= 3) { winNetworkType = type; }
    }
