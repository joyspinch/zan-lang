    public string PickFile(string filter) { return ""; }
    public int PermissionCheck(int permType) {
        if (permType >= 0 && permType < 8) { return winPermissions[permType]; }
        return 0; // 桌面环境默认完全授权
    }
    public int PermissionRequest(int permType) {
        if (permType >= 0 && permType < 8) { return winPermissions[permType]; }
        return 0;
    }
    public void SetPermission(int permType, int status) {
        if (permType >= 0 && permType < 8) { winPermissions[permType] = status; }
    }
