    private float[] winSensorAccel = new float[] { 0.0f, 9.8f, 0.0f };
    private float[] winSensorGyro  = new float[] { 0.0f, 0.0f, 0.0f };
    private float   winSensorCompass = 0.0f;
    public int SensorGet(int sensorType, float[] outVec) {
        if (outVec == null || outVec.Length < 3) { return -1; }
        if (sensorType == 1) {
            outVec[0] = winSensorAccel[0];
            outVec[1] = winSensorAccel[1];
            outVec[2] = winSensorAccel[2];
            return 0;
        } else if (sensorType == 2) {
            outVec[0] = winSensorGyro[0];
            outVec[1] = winSensorGyro[1];
            outVec[2] = winSensorGyro[2];
            return 0;
        } else if (sensorType == 3) {
            outVec[0] = winSensorCompass;
            outVec[1] = 0.0f;
            outVec[2] = 0.0f;
            return 0;
        }
        return -1;
    }
    public int SensorSet(int sensorType, float x, float y, float z) {
        if (sensorType == 1) {
            winSensorAccel[0] = x; winSensorAccel[1] = y; winSensorAccel[2] = z;
            return 0;
        } else if (sensorType == 2) {
            winSensorGyro[0] = x; winSensorGyro[1] = y; winSensorGyro[2] = z;
            return 0;
        } else if (sensorType == 3) {
            winSensorCompass = x;
            return 0;
        }
        return -1;
    }
