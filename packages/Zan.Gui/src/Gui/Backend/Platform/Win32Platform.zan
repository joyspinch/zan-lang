#if WINDOWS
using System;
using System.Collections.Generic;
using Gui;

namespace Gui.Backend;

// IPlatformWindow / IPlatformShell 的 Windows 实现：全部委托既有
// Win32Shell 静态面，逐条对应原 Window.zan 的 #if WINDOWS 分支——
// 行为与抽象前完全一致，只是换到接口后面。
public class Win32Platform : IPlatformWindow, IPlatformShell {
    // RefreshRate 的按显示器缓存：串行号/显示器没变且 1 秒内查过
    // 就直接回缓存值（原 Window 实例字段，随实现类迁到这里）。
    static nint refreshMonitor;
    static int refreshDisplaySerial;
    static long refreshCheckedUs;
    static double refreshHz;

    // ---- IPlatformWindow：生命周期 ------------------------------------

    public nint CreateWindow(string title, int width, int height) {
        return Win32Shell.CreateWindow(title, width, height);
    }

    public nint CreateWindowPhysical(string title, int width, int height) {
        return Win32Shell.CreateWindowPhysical(title, width, height);
    }

    public void ShowWindow(nint hwnd) {
        Win32Shell.ShowWindowNow(hwnd);
    }

    public void SetCloseIntercept(nint hwnd, bool on) {
        Win32Shell.SetCloseIntercept(hwnd, on);
    }

    public void SetPosition(nint hwnd, int x, int y) {
        Win32Shell.SetWindowPosition(hwnd, x, y);
    }

    public int DpiScale(nint hwnd) {
        return Win32Shell.DpiScale(hwnd);
    }

    public int TitlebarHeight(nint hwnd) {
        return Win32Shell.TitlebarHeight(hwnd);
    }

    public int CaptionButtonWidth(nint hwnd) {
        return Win32Shell.CaptionButtonWidth(hwnd);
    }

    public void ResizeClient(nint hwnd, int w, int h) {
        Win32Shell.ResizeClient(hwnd, w, h);
    }

    public void ResizeClientExact(nint hwnd, int wDev, int hDev) {
        Win32Shell.ResizeClientExact(hwnd, wDev, hDev);
    }

    public void Center(nint hwnd) {
        Win32Shell.CenterWindow(hwnd);
    }

    public double RefreshRate(nint hwnd) {
        nint monitor = Win32Shell.MonitorFromWindow(hwnd, 2);
        long nowUs = Stopwatch.GetMicroseconds();
        int serial = Win32Shell.displayChangeSerial;
        if (Win32Platform.refreshHz > 0 && monitor == Win32Platform.refreshMonitor &&
        serial == Win32Platform.refreshDisplaySerial &&
        nowUs - Win32Platform.refreshCheckedUs < 1000000) {
            return Win32Platform.refreshHz;
        }
        Win32Platform.refreshHz = Win32Shell.MonitorRefreshRate(monitor);
        Win32Platform.refreshMonitor = monitor;
        Win32Platform.refreshDisplaySerial = serial;
        Win32Platform.refreshCheckedUs = nowUs;
        return Win32Platform.refreshHz;
    }

    public bool RequestDisplayFrame(nint hwnd) {
        // 显示帧信号目前只有 Android 可选驱动提供；Windows 用计时器回退。
        return false;
    }

    public bool TakeDisplayFrame(nint hwnd) {
        return false;
    }

    public int ClientWidth(nint hwnd) {
        return Win32Shell.ClientWidth(hwnd);
    }

    public int ClientHeight(nint hwnd) {
        return Win32Shell.ClientHeight(hwnd);
    }

    // ---- 呈现 ----------------------------------------------------------

    public void Present(nint hwnd, int surfaceId) {
        Win32Shell.Present(hwnd, surfaceId);
    }

    public void PresentDirty(nint hwnd, int x, int y, int w, int h) {
        Win32Shell.PresentDirty(hwnd, x, y, w, h);
    }

    public void PresentFull(nint hwnd) {
        Win32Shell.PresentFull(hwnd);
    }

    // ---- 生命周期（续）--------------------------------------------------

    public void SetTitle(nint hwnd, string title) {
        Win32Shell.SetTitle(hwnd, title);
    }

    public void Minimize(nint hwnd) {
        Win32Shell.Minimize(hwnd);
    }

    public void ToggleMaximize(nint hwnd) {
        Win32Shell.ToggleMaximize(hwnd);
    }

    public void Close(nint hwnd) {
        Win32Shell.CloseWindow(hwnd);
    }

    public void Destroy(nint hwnd) {
        Win32Shell.Destroy(hwnd);
    }

    public bool IsMaximized(nint hwnd) {
        return Win32Shell.Maximized(hwnd);
    }

    public bool IsVisible(nint hwnd) {
        return Win32Shell.Visible(hwnd);
    }

    public bool IsFocused(nint hwnd) {
        return Win32Shell.Focused(hwnd);
    }

    // ---- 外观 -----------------------------------------------------------

    public void EnableGlass(nint hwnd, int tint) {
        Win32Shell.EnableGlass(hwnd, tint);
    }

    public void DisableGlass(nint hwnd) {
        Win32Shell.DisableGlass(hwnd);
    }

    public void SetOpacity(nint hwnd, int percent) {
        Win32Shell.SetOpacity(hwnd, percent);
    }

    public void SetShape(nint hwnd, string spec) {
        Win32Shell.SetShape(hwnd, spec);
    }

    public void SetShapeDescription(nint hwnd, WindowShapeDescription desc) {
        Win32Shell.SetShapeDescription(hwnd, desc);
    }

    public void SetRoundCorners(nint hwnd, bool on) {
        Win32Shell.SetRoundCorners(hwnd, on);
    }

    public void SetTopmost(nint hwnd, bool on) {
        Win32Shell.SetTopmost(hwnd, on);
    }

    public void SetMinSize(nint hwnd, int minW, int minH) {
        Win32Shell.SetMinTrackSize(hwnd, minW, minH);
    }

    public void SetResizable(nint hwnd, bool on) {
        Win32Shell.SetResizable(hwnd, on);
    }

    public void SetMaximizable(nint hwnd, bool on) {
        Win32Shell.SetMaximizable(hwnd, on);
    }

    public void SetToolWindow(nint hwnd, bool on) {
        Win32Shell.SetToolWindow(hwnd, on);
    }

    public bool ToolWindow(nint hwnd) {
        return Win32Shell.IsToolWindow(hwnd);
    }

    public void SetCaptionButtons(nint hwnd, int count) {
        Win32Shell.SetCaptionButtons(hwnd, count);
    }

    public void ClearHitGuards(nint hwnd) {
        Win32Shell.ClearHitGuards(hwnd);
    }

    public void AddHitGuard(nint hwnd, int x, int y, int w, int h) {
        Win32Shell.AddHitGuard(hwnd, x, y, w, h);
    }

    public void SetTitlebarHeight(nint hwnd, int devicePx) {
        Win32Shell.SetTitlebarHeight(hwnd, devicePx);
    }

    public void SetCaptionZone(nint hwnd, int width) {
        Win32Shell.SetCaptionZone(hwnd, width);
    }

    public void ForbidLayered(nint hwnd) {
        Win32Shell.ForbidLayered(hwnd);
    }

    public void SetForegroundWindow(nint hwnd) {
        Win32Shell.SetForegroundWindow(hwnd);
    }

    // ---- IPlatformShell：事件泵 -----------------------------------------

    public int WaitEvent() {
        return Win32Shell.WaitEvent();
    }

    public int WaitEventTimeout(int ms) {
        return Win32Shell.WaitEventTimeout(ms);
    }

    public int PollEvent() {
        return Win32Shell.PollEvent();
    }

    public void Wake() {
        Win32Shell.Wake();
    }

    // ---- 最近事件状态 ----------------------------------------------------

    public int EventKind() {
        return Win32Shell.EventKindValue();
    }

    public long EventSeq() {
        return Win32Shell.EventSeqValue();
    }

    public int EventX() {
        return Win32Shell.EventXValue();
    }

    public int EventY() {
        return Win32Shell.EventYValue();
    }

    public int EventButton() {
        return Win32Shell.EventButtonValue();
    }

    public int EventKeyCode() {
        return Win32Shell.EventKeyCodeValue();
    }

    public int EventMods() {
        return Win32Shell.EventModsValue();
    }

    public int EventFlag() {
        // Windows 外壳经系统合成鼠标自带同坐标 down/up，无触摸拖拽标记。
        return 0;
    }

    public nint EventHwnd() {
        return Win32Shell.EventWindow();
    }

    public nint SizePaintWindow() {
        return Win32Shell.WndProcWindow();
    }

    public int WindowWidth() {
        return Win32Shell.WindowWidth();
    }

    public int WindowHeight() {
        return Win32Shell.WindowHeight();
    }

    // ---- 合成输入与拖放 ---------------------------------------------------

    public void InjectEvent(nint hwnd, int kind, int x, int y, int button,
    int keycode, int mods) {
        Win32Shell.InjectEvent(hwnd, kind, x, y, button, keycode, mods);
    }

    public int InjectPending() {
        return Win32Shell.InjectPending();
    }

    public List<string> TakeDroppedFiles() {
        return Win32Shell.TakeDropped();
    }

    public bool DropPending() {
        return Win32Shell.DropPending();
    }

    // ---- 时钟与节奏 -------------------------------------------------------

    public int RawTickMs() {
        return Win32Shell.TickMs();
    }

    public int GetTickUs() {
        return Win32Shell.TickUs();
    }

    public void SleepMs(int ms) {
        Win32Shell.Sleep(ms);
    }

    // ---- 进程级设置 --------------------------------------------------------

    public void SetCursor(int cursorType) {
        Win32Shell.SetCursorShape(cursorType);
    }

    public void SetSizePaint(SizePaintBody body) {
        Win32Shell.SetSizePaint(body);
    }

    public void SetResizeBackground(int color) {
        Win32Shell.SetBackground(color);
    }

    public int DefaultTitlebarHeight() {
        return Win32Shell.TitlebarHeight();
    }

    public int DefaultCaptionButtonWidth() {
        return Win32Shell.CaptionButtonWidth();
    }

    public int DpiScale() {
        return Win32Shell.DpiScale();
    }

    public int SafeAreaTop() {
        return 0;
    }

    public int SafeAreaBottom() {
        return 0;
    }

    public int SafeAreaLeft() {
        return 0;
    }

    public int SafeAreaRight() {
        return 0;
    }

    public int KeyboardHeight() {
        return 0;
    }

    public void HapticFeedback(int type) {
        // 桌面环境无触觉振动马达，安全空操作
    }

    public bool SweepLayered() {
        return Win32Shell.SweepLayered();
    }

    // ---- 系统能力 -----------------------------------------------------------

    public bool ClipboardSet(string text) {
        return Win32Shell.SetClipboard(text);
    }

    public string ClipboardGet() {
        return Win32Shell.GetClipboard();
    }

    public void ImeSetCaret(int x, int y) {
        Win32Shell.SetImePos(x, y);
    }

    public void ImeSetOpen(bool on) {
        // 桌面 IME 会话在建窗时已常开且跟随硬件焦点，空操作。
    }

    public string ImeComposing() {
        // 桌面 IME 自带组合 UI，应用内预览不需要。
        return "";
    }

    public bool WriteTextFile(string path, string content) {
        return Win32Shell.WriteTextFile(path, content);
    }

    public int[] AppIconPixels() {
        return Win32Shell.AppIconPixels();
    }

    public int AppIconSide() {
        return Win32Shell.AppIconSide();
    }
}
#endif
