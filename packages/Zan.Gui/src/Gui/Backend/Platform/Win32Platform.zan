    private double[] winLocationCoords = new double[] { 39.9042, 116.4074, 50.0 };
    private float[] winLocationMetrics = new float[] { 5.0f, 0.0f };
    public int LocationGet(double[] outCoords, float[] outMetrics) {
        if (outCoords != null && outCoords.Length >= 3) {
            outCoords[0] = winLocationCoords[0];
            outCoords[1] = winLocationCoords[1];
            outCoords[2] = winLocationCoords[2];
        }
        if (outMetrics != null && outMetrics.Length >= 2) {
            outMetrics[0] = winLocationMetrics[0];
            outMetrics[1] = winLocationMetrics[1];
        }
        return 0;
    }
    public void LocationSet(double lat, double lon, double alt, float acc, float speed) {
        winLocationCoords[0] = lat;
        winLocationCoords[1] = lon;
        winLocationCoords[2] = alt;
        winLocationMetrics[0] = acc;
        winLocationMetrics[1] = speed;
    }
    private string winDevModel = "PC Desktop";
    private string winDevManufacturer = "PC Architecture";
    private string winDevPlatform = "Windows";
    private string winDevOSVersion = "10.0.19044";
    private bool winDevIsFoldable = false;
    public string DeviceInfoGet(int infoKey) {
        if (infoKey == 1) { return winDevModel; }
        if (infoKey == 2) { return winDevManufacturer; }
        if (infoKey == 3) { return winDevPlatform; }
        if (infoKey == 4) { return winDevOSVersion; }
        return "";
    }
    public bool DeviceIsFoldable() { return winDevIsFoldable; }
    public void DeviceInfoSet(int infoKey, string val) {
        if (val == null) { return; }
        if (infoKey == 1) { winDevModel = val; }
        else if (infoKey == 2) { winDevManufacturer = val; }
        else if (infoKey == 3) { winDevPlatform = val; }
        else if (infoKey == 4) { winDevOSVersion = val; }
        else if (infoKey == 5) { winDevIsFoldable = (val == "1" || val == "true"); }
    }
