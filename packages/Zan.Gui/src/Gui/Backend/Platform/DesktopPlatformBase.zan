using System;
namespace Gui.Backend;

// 桌面平台共用的移动端/设备模拟桩基类，收敛 Win32Platform 与桌面 CapiPlatform 重复代码。
public class DesktopPlatformBase {
    protected float[] desktopSensorAccel = new float[] { 0.0f, 9.8f, 0.0f };
    protected float[] desktopSensorGyro  = new float[] { 0.0f, 0.0f, 0.0f };
    protected float   desktopSensorCompass = 0.0f;
    protected int desktopNetworkType = 1; // 1: Wifi
    protected bool desktopDarkMode = false;
    protected bool desktopDarkModeOverridden = false;
    protected int[] desktopPermissions = new int[] { 0, 0, 0, 0, 0, 0, 0, 0 };
    protected bool desktopScreenKeepAwake = false;
    protected float desktopScreenBrightness = -1.0f;
    protected double[] desktopLocationCoords = new double[] { 39.9042, 116.4074, 50.0 };
    protected float[] desktopLocationMetrics = new float[] { 5.0f, 0.0f };
    protected string desktopDevModel = "PC Desktop";
    protected string desktopDevManufacturer = "PC Architecture";
    protected string desktopDevPlatform = "Desktop";
    protected string desktopDevOSVersion = "1.0";
    protected bool desktopDevIsFoldable = false;
    protected bool desktopBioCanAuth = true;
    protected int desktopBioType = 1;
    protected bool desktopBioAuthResult = true;
    protected bool desktopStatusBarVisible = true;
    protected int desktopStatusBarStyle = 0;
    protected int desktopStatusBarColor = 0;
    protected bool desktopNavBarVisible = true;
    protected string desktopPendingOpenUrl = "";

    public virtual int SafeAreaTop() { return 0; }
    public virtual int SafeAreaBottom() { return 0; }
    public virtual int SafeAreaLeft() { return 0; }
    public virtual int SafeAreaRight() { return 0; }
    public virtual int KeyboardHeight() { return 0; }
    public virtual void HapticFeedback(int type) { }

    public virtual int SensorGet(int sensorType, float[] outVec) {
        if (outVec == null || outVec.Length < 3) { return -1; }
        if (sensorType == 1) {
            outVec[0] = desktopSensorAccel[0];
            outVec[1] = desktopSensorAccel[1];
            outVec[2] = desktopSensorAccel[2];
            return 0;
        } else if (sensorType == 2) {
            outVec[0] = desktopSensorGyro[0];
            outVec[1] = desktopSensorGyro[1];
            outVec[2] = desktopSensorGyro[2];
            return 0;
        } else if (sensorType == 3) {
            outVec[0] = desktopSensorCompass;
            outVec[1] = 0.0f;
            outVec[2] = 0.0f;
            return 0;
        }
        return -1;
    }

    public virtual int SensorSet(int sensorType, float x, float y, float z) {
        if (sensorType == 1) {
            desktopSensorAccel[0] = x; desktopSensorAccel[1] = y; desktopSensorAccel[2] = z;
            return 0;
        } else if (sensorType == 2) {
            desktopSensorGyro[0] = x; desktopSensorGyro[1] = y; desktopSensorGyro[2] = z;
            return 0;
        } else if (sensorType == 3) {
            desktopSensorCompass = x;
            return 0;
        }
        return -1;
    }

    public virtual int NotificationSend(string title, string body, string action, int badge, string sound) {
        return 0;
    }
    public virtual int NetworkType() { return desktopNetworkType; }
    public virtual void SetNetworkType(int type) {
        if (type >= 0 && type <= 3) { desktopNetworkType = type; }
    }
    public virtual bool IsDarkMode() { return desktopDarkMode; }
    public virtual void SetDarkMode(bool isDark) {
        desktopDarkModeOverridden = true;
        desktopDarkMode = isDark;
    }
    public virtual string PickFile(string filter) { return ""; }
    public virtual int PermissionCheck(int permType) {
        if (permType >= 0 && permType < 8) { return desktopPermissions[permType]; }
        return 0;
    }
    public virtual int PermissionRequest(int permType) {
        if (permType >= 0 && permType < 8) { return desktopPermissions[permType]; }
        return 0;
    }
    public virtual void SetPermission(int permType, int status) {
        if (permType >= 0 && permType < 8) { desktopPermissions[permType] = status; }
    }
    public virtual void ScreenKeepAwake(bool enable) { desktopScreenKeepAwake = enable; }
    public virtual bool ScreenIsKeepAwake() { return desktopScreenKeepAwake; }
    public virtual void ScreenSetBrightness(float brightness) { desktopScreenBrightness = brightness; }
    public virtual float ScreenGetBrightness() { return desktopScreenBrightness; }

    public virtual int LocationGet(double[] outCoords, float[] outMetrics) {
        if (outCoords != null && outCoords.Length >= 3) {
            outCoords[0] = desktopLocationCoords[0];
            outCoords[1] = desktopLocationCoords[1];
            outCoords[2] = desktopLocationCoords[2];
        }
        if (outMetrics != null && outMetrics.Length >= 2) {
            outMetrics[0] = desktopLocationMetrics[0];
            outMetrics[1] = desktopLocationMetrics[1];
        }
        return 0;
    }
    public virtual void LocationSet(double lat, double lon, double alt, float acc, float speed) {
        desktopLocationCoords[0] = lat;
        desktopLocationCoords[1] = lon;
        desktopLocationCoords[2] = alt;
        desktopLocationMetrics[0] = acc;
        desktopLocationMetrics[1] = speed;
    }

    public virtual string DeviceInfoGet(int infoKey) {
        if (infoKey == 1) { return desktopDevModel; }
        if (infoKey == 2) { return desktopDevManufacturer; }
        if (infoKey == 3) { return desktopDevPlatform; }
        if (infoKey == 4) { return desktopDevOSVersion; }
        return "";
    }
    public virtual bool DeviceIsFoldable() { return desktopDevIsFoldable; }
    public virtual void DeviceInfoSet(int infoKey, string val) {
        if (val == null) { return; }
        if (infoKey == 1) { desktopDevModel = val; }
        else if (infoKey == 2) { desktopDevManufacturer = val; }
        else if (infoKey == 3) { desktopDevPlatform = val; }
        else if (infoKey == 4) { desktopDevOSVersion = val; }
        else if (infoKey == 5) { desktopDevIsFoldable = (val == "1" || val == "true"); }
    }

    public virtual bool BiometricsCanAuthenticate() { return desktopBioCanAuth; }
    public virtual int BiometricsType() { return desktopBioType; }
    public virtual bool BiometricsAuthenticate(string title, string subtitle) { return desktopBioAuthResult; }
    public virtual void BiometricsSetMock(bool canAuth, int bioType, bool authResult) {
        desktopBioCanAuth = canAuth;
        desktopBioType = bioType;
        desktopBioAuthResult = authResult;
    }

    public virtual void SystemBarSetStatus(bool visible, int style, int color) {
        desktopStatusBarVisible = visible;
        if (style >= 0 && style <= 2) { desktopStatusBarStyle = style; }
        desktopStatusBarColor = color;
    }
    public virtual bool SystemBarIsStatusVisible() { return desktopStatusBarVisible; }
    public virtual int SystemBarStyle() { return desktopStatusBarStyle; }
    public virtual int SystemBarColor() { return desktopStatusBarColor; }
    public virtual void SystemBarSetNavVisible(bool visible) { desktopNavBarVisible = visible; }
    public virtual bool SystemBarIsNavVisible() { return desktopNavBarVisible; }

    public virtual string TakeOpenUrl() {
        string url = desktopPendingOpenUrl;
        desktopPendingOpenUrl = "";
        return url;
    }
    public virtual void InjectOpenUrl(string url) { desktopPendingOpenUrl = url; }
}
