    public void Destroy(nint hwnd) {
        #if MACOS
        if (CapiPlatform.macTitlebarLogical != null) { CapiPlatform.macTitlebarLogical.Remove(hwnd); }
        #endif
        zan_gui_destroy_window(hwnd);
    }
