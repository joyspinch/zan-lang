    #if !WASM
    static nint OptionalGuiEntry(string symbol) {
        if (!CapiPlatform.optionalGuiDriverResolved) {
            CapiPlatform.optionalGuiDriverResolved = true;
            #if MACOS
            string dir = ProcessHost.AppDir();
            if (dir != "") {
                CapiPlatform.optionalGuiDriver = Interop.Load(dir + "/libzan_gui.dylib");
            }
            if (CapiPlatform.optionalGuiDriver == 0) {
                CapiPlatform.optionalGuiDriver = Interop.Load("libzan_gui.dylib");
            }
            #elif ANDROID || OHOS
            CapiPlatform.optionalGuiDriver = Interop.Load("libzan_gui.so");
            #elif LINUX
            string dir = ProcessHost.AppDir();
            if (dir != "") {
                CapiPlatform.optionalGuiDriver = Interop.Load(dir + "/libzan_gui.so");
            }
            if (CapiPlatform.optionalGuiDriver == 0) {
                CapiPlatform.optionalGuiDriver = Interop.Load("libzan_gui.so");
            }
            #endif
            if (CapiPlatform.optionalGuiDriver == 0) {
                CapiPlatform.optionalGuiDriver = Interop.PosixLoad(null, Interop.RtldNowLocal());
            }
        }
        if (CapiPlatform.optionalGuiDriver == 0) { return 0; }
        return Interop.Symbol(CapiPlatform.optionalGuiDriver, symbol);
    }
    static void ResolveDisplayFrame() {
        if (CapiPlatform.displayFrameResolved) { return; }
        CapiPlatform.displayFrameResolved = true;
        CapiPlatform.displayFrameRequest = CapiPlatform.OptionalGuiEntry("zan_gui_request_display_frame");
        CapiPlatform.displayFrameTake = CapiPlatform.OptionalGuiEntry("zan_gui_take_display_frame");
    }
    #endif
    #if MACOS
    static void ResolveMacOptional() {
        if (CapiPlatform.macOptionalResolved) { return; }
        CapiPlatform.macOptionalResolved = true;
        CapiPlatform.fnDpiScaleWin = CapiPlatform.OptionalGuiEntry("zan_gui_get_dpi_scale_win");
        CapiPlatform.fnDpiRevision = CapiPlatform.OptionalGuiEntry("zan_gui_dpi_revision");
        CapiPlatform.fnSetRoundCorners = CapiPlatform.OptionalGuiEntry("zan_gui_set_round_corners");
        CapiPlatform.fnSetMinSize = CapiPlatform.OptionalGuiEntry("zan_gui_set_min_size");
        CapiPlatform.fnSetResizable = CapiPlatform.OptionalGuiEntry("zan_gui_set_resizable");
        CapiPlatform.fnSetMaximizable = CapiPlatform.OptionalGuiEntry("zan_gui_set_maximizable");
        CapiPlatform.fnSetTitlebarHeight = CapiPlatform.OptionalGuiEntry("zan_gui_set_titlebar_height");
        CapiPlatform.fnSetCaptionZone = CapiPlatform.OptionalGuiEntry("zan_gui_set_caption_zone");
        CapiPlatform.fnGetTickUs = CapiPlatform.OptionalGuiEntry("zan_gui_get_tick_us");
    }
    #endif
    public nint CreateWindow(string title, int width, int height) {
        #if MACOS
        int scale = zan_gui_get_dpi_scale();
        if (scale < 100) { scale = 100; }
        return zan_gui_create_window(title, width * scale / 100, height * scale / 100);
        #else
        return zan_gui_create_window(title, width, height);
        #endif
    }
    public nint CreateWindowPhysical(string title, int width, int height) {
        return zan_gui_create_window(title, width, height);
    }
    public void ShowWindow(nint hwnd) { zan_gui_show_window(hwnd); }
    public void SetCloseIntercept(nint hwnd, bool on) {
    }
    public void SetPosition(nint hwnd, int x, int y) { zan_gui_set_window_pos(hwnd, x, y); }
    public int DpiScale(nint hwnd) {
        #if MACOS
        if (hwnd != 0) {
            CapiPlatform.ResolveMacOptional();
            if (CapiPlatform.fnDpiScaleWin != 0) {
                WindowIntFn fn = (WindowIntFn)CapiPlatform.fnDpiScaleWin;
                int s = fn(hwnd);
                if (s >= 100) { return s; }
            }
        }
        #endif
        return zan_gui_get_dpi_scale();
    }
    public int DpiRevision(nint hwnd) {
        #if MACOS
        if (hwnd != 0) {
            CapiPlatform.ResolveMacOptional();
            if (CapiPlatform.fnDpiRevision != 0) {
                WindowIntFn fn = (WindowIntFn)CapiPlatform.fnDpiRevision;
                return fn(hwnd);
            }
        }
        #endif
        return 0;
    }
    public int TitlebarHeight(nint hwnd) {
        #if MACOS
        int scale = this.DpiScale(hwnd);
        if (scale < 100) { scale = 100; }
        int logical = 32;
        if (hwnd != 0 && CapiPlatform.macTitlebarLogical != null && CapiPlatform.macTitlebarLogical.ContainsKey(hwnd)) {
            logical = CapiPlatform.macTitlebarLogical[hwnd];
        }
        return logical * scale / 100;
        #else
        return zan_gui_titlebar_height();
        #endif
    }
    public int CaptionButtonWidth(nint hwnd) {
        #if MACOS
        int scale = this.DpiScale(hwnd);
        if (scale < 100) { scale = 100; }
        return 46 * scale / 100;
        #else
        return zan_gui_caption_button_width();
        #endif
    }
    public void ResizeClient(nint hwnd, int w, int h) {
        #if (LINUX && !ANDROID && !OHOS) || MACOS
        zan_gui_resize_client(hwnd, w, h);
        #endif
    }
    public void ResizeClientExact(nint hwnd, int wDev, int hDev) { this.ResizeClient(hwnd, wDev, hDev); }
    public void Center(nint hwnd) { zan_gui_center_window(hwnd); }
    public double RefreshRate(nint hwnd) {
        #if !WASM
        if (!CapiPlatform.refreshQueryResolved) {
            CapiPlatform.refreshQueryResolved = true;
            CapiPlatform.refreshQuery = CapiPlatform.OptionalGuiEntry("zan_gui_refresh_rate");
        }
        if (CapiPlatform.refreshQuery != 0) {
            WindowRefreshRateFn query = (WindowRefreshRateFn)CapiPlatform.refreshQuery;
            double hz = query(hwnd);
            if (hz > 1.0 && hz <= 1000.0) { return hz; }
        }
        #endif
        return 60.0;
    }
    public bool RequestDisplayFrame(nint hwnd) {
        #if !WASM
        CapiPlatform.ResolveDisplayFrame();
        if (CapiPlatform.displayFrameRequest != 0 && CapiPlatform.displayFrameTake != 0) {
            WindowDisplayFrameFn request = (WindowDisplayFrameFn)CapiPlatform.displayFrameRequest;
            return request(hwnd) != 0;
        }
        #endif
        return false;
    }
    public bool TakeDisplayFrame(nint hwnd) {
        #if !WASM
        CapiPlatform.ResolveDisplayFrame();
        if (CapiPlatform.displayFrameRequest != 0 && CapiPlatform.displayFrameTake != 0) {
            WindowDisplayFrameFn take = (WindowDisplayFrameFn)CapiPlatform.displayFrameTake;
            return take(hwnd) != 0;
        }
        #endif
        return false;
    }
