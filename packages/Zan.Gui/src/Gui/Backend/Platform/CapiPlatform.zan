    #if ANDROID
    [DllImport("zan_gui")]
    static extern void zan_gui_set_ime_open(int on);

    [DllImport("zan_gui")]
    static extern string zan_gui_ime_composing();

    // Android：静态 APK 的驱动导出在 libmain.so；共享驱动只加载一次。
    static bool refreshQueryResolved;
    static nint refreshQuery;
    static bool optionalGuiDriverResolved;
    static nint optionalGuiDriver;
    static bool displayFrameResolved;
    static nint displayFrameRequest;
    static nint displayFrameTake;
    #endif

    // SetSizePaint 的存根（没有模态尺寸调整循环的平台存而不用，
    // 保持"参数被消费"的形态）。
    static SizePaintBody sizePaintUnused;

    #if ANDROID
    static nint OptionalGuiEntry(string symbol) {
        if (!CapiPlatform.optionalGuiDriverResolved) {
            CapiPlatform.optionalGuiDriverResolved = true;
            CapiPlatform.optionalGuiDriver = Interop.Load("libzan_gui.so");
        }
        return Interop.Symbol(CapiPlatform.optionalGuiDriver, symbol);
    }

    static void ResolveDisplayFrame() {
        if (CapiPlatform.displayFrameResolved) { return; }
        CapiPlatform.displayFrameResolved = true;
        CapiPlatform.displayFrameRequest = CapiPlatform.OptionalGuiEntry("zan_gui_request_display_frame");
        CapiPlatform.displayFrameTake = CapiPlatform.OptionalGuiEntry("zan_gui_take_display_frame");
    }
    #endif

    // ---- IPlatformWindow：生命周期 ------------------------------------

    public nint CreateWindow(string title, int width, int height) {
        return zan_gui_create_window(title, width, height);
    }

    public nint CreateWindowPhysical(string title, int width, int height) {
        // 非 Windows 后端原样创建（全屏表面，无标题条预留）。
        return zan_gui_create_window(title, width, height);
    }

    public void ShowWindow(nint hwnd) {
        zan_gui_show_window(hwnd);
    }

    public void SetCloseIntercept(nint hwnd, bool on) {
        // macOS/X11 的原生层本来就只投递关闭事件、不销毁窗口，
        // 这里只是显式声明意图，行为不变。
    }

    public void SetPosition(nint hwnd, int x, int y) {
        #if MACOS
        // 没有自由定位概念的平台。
        #else
        zan_gui_set_window_pos(hwnd, x, y);
        #endif
    }

    public int DpiScale(nint hwnd) {
        return zan_gui_get_dpi_scale();
    }

    public int TitlebarHeight(nint hwnd) {
        return zan_gui_titlebar_height();
    }

    public int CaptionButtonWidth(nint hwnd) {
        return zan_gui_caption_button_width();
    }

    public void ResizeClient(nint hwnd, int w, int h) {
        // 驱动尚无客户区缩放通道；安全空操作。
    }

    public void ResizeClientExact(nint hwnd, int wDev, int hDev) {
        // 同 ResizeClient。
    }

    public void Center(nint hwnd) {
        zan_gui_center_window(hwnd);
    }

    public double RefreshRate(nint hwnd) {
        #if ANDROID
        if (!CapiPlatform.refreshQueryResolved) {
            CapiPlatform.refreshQueryResolved = true;
            CapiPlatform.refreshQuery = CapiPlatform.OptionalGuiEntry("zan_gui_refresh_rate");
        }
        if (CapiPlatform.refreshQuery != 0) {
            WindowRefreshRateFn query = (WindowRefreshRateFn)CapiPlatform.refreshQuery;
            double hz = query(hwnd);
            if (hz > 1.0 && hz <= 1000.0) { return hz; }
        }
        #endif
        // X11 驱动没有 XRandR 依赖，其余后端尚无显示模式查询。
        return 60.0;
    }

    public bool RequestDisplayFrame(nint hwnd) {
        #if ANDROID
        CapiPlatform.ResolveDisplayFrame();
        if (CapiPlatform.displayFrameRequest != 0 && CapiPlatform.displayFrameTake != 0) {
            WindowDisplayFrameFn request = (WindowDisplayFrameFn)CapiPlatform.displayFrameRequest;
            return request(hwnd) != 0;
        }
        #endif
        return false;
    }

    public bool TakeDisplayFrame(nint hwnd) {
        #if ANDROID
        CapiPlatform.ResolveDisplayFrame();
        if (CapiPlatform.displayFrameRequest != 0 && CapiPlatform.displayFrameTake != 0) {
            WindowDisplayFrameFn take = (WindowDisplayFrameFn)CapiPlatform.displayFrameTake;
            return take(hwnd) != 0;
        }
        #endif
        return false;
    }

    public int ClientWidth(nint hwnd) {
        return zan_gui_client_width(hwnd);
    }

    public int ClientHeight(nint hwnd) {
        return zan_gui_client_height(hwnd);
    }

    // ---- 呈现 ----------------------------------------------------------

    public void Present(nint hwnd, int surfaceId) {
        zan_gui_present(hwnd, surfaceId);
    }

    public void PresentDirty(nint hwnd, int x, int y, int w, int h) {
        zan_gui_present_dirty_add(x, y, w, h);
    }

    public void PresentFull(nint hwnd) {
        // 非 Windows 平台脏矩形队列标记：通知全量重绘，忽略排队脏区。
        zan_gui_present_full();
    }

