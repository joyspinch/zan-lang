    public List<string> TakeDroppedFiles() {
        List<string> outp = new List<string>();
        string p = zan_gui_drop_take();
        while (p != "") {
            outp.Add(p);
            p = zan_gui_drop_take();
        }
        return outp;
    }
    public bool DropPending() { return zan_gui_drop_pending() != 0; }
    public int RawTickMs() { return (int)zan_gui_get_tick_ms(); }
    public int GetTickUs() {
        #if MACOS
        CapiPlatform.ResolveMacOptional();
        if (CapiPlatform.fnGetTickUs != 0) {
            GuiGetTickUsFn fn = (GuiGetTickUsFn)CapiPlatform.fnGetTickUs;
            return (int)fn();
        }
        #endif
        return (int)zan_gui_get_tick_ms() * 1000;
    }
    public void SleepMs(int ms) { zan_gui_sleep_ms(ms); }
