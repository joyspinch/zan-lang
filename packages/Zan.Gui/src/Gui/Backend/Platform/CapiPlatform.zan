    // ---- 合成输入与拖放 ---------------------------------------------------

    public void InjectEvent(nint hwnd, int kind, int x, int y, int button,
    int keycode, int mods) {
        zan_gui_inject_event(hwnd, kind, x, y, button, keycode, mods);
    }

    public int InjectPending() {
        return zan_gui_inject_pending();
    }

    public List<string> TakeDroppedFiles() {
        List<string> outp = new List<string>();
        #if MACOS
        return outp;
        #else
        string p = zan_gui_drop_take();
        while (p != "") {
            outp.Add(p);
            p = zan_gui_drop_take();
        }
        return outp;
        #endif
    }

    public bool DropPending() {
        #if MACOS
        return false;
        #else
        return zan_gui_drop_pending() != 0;
        #endif
    }

