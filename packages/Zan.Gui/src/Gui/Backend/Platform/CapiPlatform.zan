    public void SetTitlebarHeight(nint hwnd, int devicePx) {
        #if MACOS
        if (hwnd != 0 && devicePx > 0) {
            int scale = this.DpiScale(hwnd);
            if (scale < 100) { scale = 100; }
            int logical = (devicePx * 100 + scale - 1) / scale;
            if (logical > 32) {
                if (CapiPlatform.macTitlebarLogical == null) {
                    CapiPlatform.macTitlebarLogical = new Dict<nint, int>();
                }
                CapiPlatform.macTitlebarLogical[hwnd] = logical;
            }
        }
        CapiPlatform.ResolveMacOptional();
        if (CapiPlatform.fnSetTitlebarHeight != 0) {
            WindowSetIntFn fn = (WindowSetIntFn)CapiPlatform.fnSetTitlebarHeight;
            fn(hwnd, devicePx);
        }
        #endif
    }
    public void SetCaptionZone(nint hwnd, int width) {
        #if MACOS
        CapiPlatform.ResolveMacOptional();
        if (CapiPlatform.fnSetCaptionZone != 0) {
            WindowSetIntFn fn = (WindowSetIntFn)CapiPlatform.fnSetCaptionZone;
            fn(hwnd, width);
        }
        #endif
    }
