    public void SetShapeDescription(nint hwnd, WindowShapeDescription desc) {
        if (desc == null || desc.IsEmpty()) {
            this.SetShape(hwnd, "");
        } else {
            this.SetShape(hwnd, desc.ToSpec());
        }
    }
    public void SetRoundCorners(nint hwnd, bool on) {
        #if MACOS
        CapiPlatform.ResolveMacOptional();
        if (CapiPlatform.fnSetRoundCorners != 0) {
            WindowSetIntFn fn = (WindowSetIntFn)CapiPlatform.fnSetRoundCorners;
            fn(hwnd, on ? 1 : 0);
        }
        #endif
    }
    public void SetTopmost(nint hwnd, bool on) {
        int v = 0;
        if (on) { v = 1; }
        zan_gui_set_topmost(hwnd, v);
    }
    public void SetMinSize(nint hwnd, int minW, int minH) {
        #if MACOS
        CapiPlatform.ResolveMacOptional();
        if (CapiPlatform.fnSetMinSize != 0) {
            int scale = this.DpiScale(hwnd);
            if (scale < 100) { scale = 100; }
            int pw = minW > 0 ? minW * scale / 100 : 0;
            int ph = minH > 0 ? minH * scale / 100 : 0;
            WindowSetTwoIntFn fn = (WindowSetTwoIntFn)CapiPlatform.fnSetMinSize;
            fn(hwnd, pw, ph);
        }
        #endif
    }
    public void SetResizable(nint hwnd, bool on) {
        #if MACOS
