using System;
using System.Diagnostics;
using System.Json;
using Gui.Markup;
using Gui.Widget;
using Gui.Backend;

namespace Gui;

public partial class Html {
    public static bool IsIntText(string s) {
        if (s == null || s == "") { return false; }
        int i = 0;
        if (s[0] == 45) { i = 1; }
        if (i >= s.Length) { return false; }
        while (i < s.Length) {
            int ch = s[i] & 255;
            if (ch < 48 || ch > 57) { return false; }
            i = i + 1;
        }
        return true;
    }

    // data-<kebab> → camelCase 属性键（row-factory → rowFactory）。
    public static string UnkebabKey(string s) {
        string outp = "";
        bool up = false;
        for (int i = 0; i < s.Length; i = i + 1) {
            char ch = s[i];
            if (ch == 45) { up = true; continue; }
            if (up && ch >= 97 && ch <= 122) { outp = outp + (char)(ch - 32); }
            else { outp = outp + ch; }
            up = false;
        }
        return outp;
    }

    // 设计方言结构键：语义在构造/装配层消费，不落属性表。
    public static bool IsDialectKey(string k) {
        switch (k) {
            case "kind":
            case "span":
            case "child-tab":
            case "ph":
            case "fx":
            case "fy":
            case "fw":
            case "fh":
            case "anchor":
            case "position":
            case "padding":
            case "pad":
            case "gap":
            case "margin":
            case "label":
            case "text":
            case "layout-mode":
            case "for":
            case "html-tag":
                return true;
            default:
                return false;
        }
    }

    // data-x-<key> 复合值（PutAttr 同语义）：options 数组拼 "a|b|c"，
    // columns 数组拼 "width,title|..."，props 对象逐键落属性，其余
    // JSON 序列化直落。
    public static void ApplyXProp(Control c, string key, string v) {
        if (v == "" || (v[0] != 123 && v[0] != 91)) { c.SetProp(key, v); return; }
        JsonValue parsed = null;
        try { parsed = JsonValue.Parse(v); } catch (Exception ex) {
            parsed = null;
        }
        if (parsed == null) { c.SetProp(key, v); return; }
        if (key == "options" && parsed.IsArray()) {
            c.SetProp("options", Html.JsonJoinOpts(parsed));
            return;
        }
        if (key == "columns" && parsed.IsArray()) {
            string spec = Html.JsonGridSpec(parsed);
            if (spec != "") { c.SetProp("previewColumns", spec); }
            c.SetProp("columns", v);
            return;
        }
        if (key == "props" && parsed.IsObject()) {
            for (int i = 0; i < parsed.Count(); i = i + 1) {
                JsonValue val = parsed.ValAt(i);
                if (val == null) { continue; }
                if (val.IsString()) { c.SetProp(parsed.KeyAt(i), val.AsString("")); }
                else if (val.IsBool()) { c.SetProp(parsed.KeyAt(i), val.AsBool(false) ? "true" : "false"); }
                else if (val.IsNumber()) { c.SetProp(parsed.KeyAt(i), val.ToJson()); }
            }
            return;
        }
        c.SetProp(key, parsed.ToJson());
    }

    public static string JsonJoinOpts(JsonValue opts) {
        if (opts.IsString()) { return opts.AsString(""); }
        if (!opts.IsArray() || opts.Count() == 0) { return ""; }
        string outp = "";
        for (int i = 0; i < opts.Count(); i = i + 1) {
            outp = outp + (i > 0 ? "|" : "") + opts.At(i).AsString("");
        }
        return outp;
    }

    public static string JsonGridSpec(JsonValue cols) {
        string spec = "";
        for (int i = 0; i < cols.Count(); i = i + 1) {
            JsonValue col = cols.At(i);
            if (col == null || !col.IsObject()) { continue; }
            string title = col.Str("title", "");
            if (title == "") { title = col.Str("field", ""); }
            if (title == "") { continue; }
            spec = spec + (spec != "" ? "|" : "")
                + Convert.ToString(col.Int("width", 100)) + "," + title;
        }
        return spec;
    }

    // 一条记录 → 一个控件（构造 + 属性协议）。容器自己的文本不在这
    // 里加——装配阶段按 items 文档序与子控件交错加入。
    public static Control Build(WDoc wd, WNode n, HtmlDoc doc, HtmlHandlers handlers) {
        Install();
        string tag = n.tag;
        string id = HtmlText.NodeAttr(n.attrs, "id");
        string type = HtmlText.NodeAttr(n.attrs, "type").ToLower();
        Control c = null;

        switch (tag) {
            case "label": {
                // 与设计器导入路径 TagKind("label")→Label 同语义（A546①）：
                // 普通路径此前建成裸 Element，无 display 归类，文字一字不画。
                // 文本三通道：设计稿 data-label / 精确文本 data-text / 正文。
                Label lb = new Label();
                string lt = HtmlText.NodeAttr(n.attrs, "data-label");
                if (lt == "") { lt = HtmlText.NodeAttr(n.attrs, "data-text"); }
                if (lt == "") { lt = n.text; }
                lb.InitLabel(lt);
                c = lb;
                break;
            }
            case "button": {
                Button b = new Button(n.text);
                c = b;
                break;
            }
            case "textarea": {
                TextArea ta = new TextArea();
                ta.InitTextArea(new SignalString(n.text), "");
                c = ta;
                break;
            }
            case "input": {
                if (type == "checkbox") {
                    Checkbox cb = new Checkbox();
                    c = cb;
                } else if (type == "radio") {
                    Radio rb = new Radio();
                    c = rb;
                } else if (type == "number") {
                    InputNumber inpn = new InputNumber();
                    c = inpn;
                } else if (type == "range") {
                    Slider sl = new Slider();
                    c = sl;
                } else if (type == "color") {
                    ColorPicker cp = new ColorPicker();
                    c = cp;
                } else if (type == "date" || type == "datetime-local") {
                    DatePicker dp = new DatePicker();
                    c = dp;
                } else if (type == "file") {
                    Upload up = new Upload();
                    c = up;
                } else {
                    Input inp = new Input();
                    inp.InitInput(
                        new SignalString(HtmlText.NodeAttr(n.attrs, "value")),
                        HtmlText.NodeAttr(n.attrs, "placeholder"));
                    if (type == "password") {
                        inp.SetProp("password", "true");
                    }
                    c = inp;
                }
                break;
            }
            case "img": {
                Image img = new Image();
                img.InitImage(HtmlText.NodeAttr(n.attrs, "src"),
                              HtmlText.NodeAttr(n.attrs, "alt"),
                              "cover");
                c = img;
                break;
            }
            case "select":
            case "selectbox":
            case "select-box":
            case "zan-select-box": {
                SelectBox sb = new SelectBox();
                string opts = "";
                int selIdx = 0 - 1;
                int oi = 0;
                bool hasCustomVal = false;
                for (int i = 0; i < n.items.Count; i = i + 1) {
                    WItem it = n.items[i];
                    if (it.kid < 0) { continue; }
                    WNode cn = wd.nodes[it.kid];
                    if (cn.tag != "option") { continue; }
                    string vAttr = HtmlText.NodeAttr(cn.attrs, "value");
                    if (vAttr != "") { hasCustomVal = true; break; }
                }
                if (hasCustomVal) {
                    JsonValue arr = JsonValue.NewArray();
                    for (int i = 0; i < n.items.Count; i = i + 1) {
                        WItem it = n.items[i];
                        if (it.kid < 0) { continue; }
                        WNode cn = wd.nodes[it.kid];
                        if (cn.tag != "option") { continue; }
                        string ot = cn.text;
                        if (ot == "") {
                            for (int k = 0; k < cn.items.Count; k = k + 1) {
                                WItem cit = cn.items[k];
                                if (cit.kid >= 0 || cit.text == "") { continue; }
                                ot = ot + cit.text;
                            }
                        }
                        ot = ot.Trim();
                        string valAttr = HtmlText.NodeAttr(cn.attrs, "value");
                        if (valAttr == "") { valAttr = ot; }
                        for (int q = 0; q < cn.attrs.Count; q = q + 1) {
                            if (cn.attrs[q].name == "selected") { selIdx = oi; }
                        }
                        JsonValue optObj = JsonValue.NewObject();
                        optObj.Set("label", JsonValue.NewStr(ot));
                        optObj.Set("value", JsonValue.NewStr(valAttr));
                        arr.Append(optObj);
                        oi = oi + 1;
                    }
                    if (arr.Count() > 0) {
                        sb.SetProp("options", arr.ToJson());
                    }
                } else {
                    for (int i = 0; i < n.items.Count; i = i + 1) {
                        WItem it = n.items[i];
                        if (it.kid < 0) { continue; }
                        WNode cn = wd.nodes[it.kid];
                        if (cn.tag != "option") { continue; }
                        string ot = cn.text;
                        if (ot == "") {
                            for (int k = 0; k < cn.items.Count; k = k + 1) {
                                WItem cit = cn.items[k];
                                if (cit.kid >= 0 || cit.text == "") { continue; }
                                ot = ot + cit.text;
                            }
                        }
                        ot = ot.Trim();
                        for (int q = 0; q < cn.attrs.Count; q = q + 1) {
                            if (cn.attrs[q].name == "selected") { selIdx = oi; }
                        }
                        if (ot != "") {
                            if (oi > 0) { opts = opts + "|"; }
                            opts = opts + ot;
                        }
                        oi = oi + 1;
                    }
                    if (opts != "") { sb.SetProp("options", opts); }
                }
                if (selIdx < 0 && (opts != "" || hasCustomVal)) { selIdx = 0; }
                if (selIdx >= 0) { sb.Select(selIdx); }
                c = sb;
                break;
            }
            case "progress":
            case "zan-progress": {
                Progress p = new Progress();
                string maxVal = HtmlText.NodeAttr(n.attrs, "max");
                if (maxVal != "") { p.SetProp("max", maxVal); }
                string curVal = HtmlText.NodeAttr(n.attrs, "value");
                if (curVal != "") { p.SetProp("value", curVal); }
                c = p;
                break;
            }
            case "tabs":
            case "tab-control":
            case "zan-tabs": {
                Tabs tb = new Tabs();
                string opts = "";
                for (int i = 0; i < n.items.Count; i = i + 1) {
                    WItem it = n.items[i];
                    if (it.kid < 0) { continue; }
                    WNode cn = wd.nodes[it.kid];
                    if (cn.tag != "tab" && cn.tag != "tab-pane" && cn.tag != "tabpane") { continue; }
                    string tTitle = HtmlText.NodeAttr(cn.attrs, "title");
                    if (tTitle == "") { tTitle = HtmlText.NodeAttr(cn.attrs, "label"); }
                    if (tTitle == "") { tTitle = HtmlText.NodeAttr(cn.attrs, "name"); }
                    if (tTitle == "") { tTitle = cn.text.Trim(); }
                    if (tTitle != "") {
                        if (opts != "") { opts = opts + "|"; }
                        opts = opts + tTitle;
                    }
                }
                if (opts != "") { tb.SetProp("options", opts); }
                c = tb;
                break;
            }
            case "table": {
                Table tbl = new Table();
                c = tbl;
                break;
            }
            case "tr": {
                TableRow tr = new TableRow();
                c = tr;
                break;
            }
            case "th": {
                TableCell th = new TableCell();
                th.SetHeader(true);
                c = th;
                break;
            }
            case "td": {
                TableCell td = new TableCell();
                c = td;
                break;
            }
            case "tab-pane":
            case "tabpane": {
                TabPane tp = new TabPane();
                string t = HtmlText.NodeAttr(n.attrs, "label");
                if (t == "") { t = HtmlText.NodeAttr(n.attrs, "title"); }
                if (t != "") { tp.SetLabel(t); }
                c = tp;
                break;
            }
            case "breadcrumb-item": {
                BreadcrumbItem bi = new BreadcrumbItem();
                string href = HtmlText.NodeAttr(n.attrs, "href");
                if (href != "") { bi.SetHref(href); }
                c = bi;
                break;
            }
            case "timeline-item": {
                TimelineItem ti = new TimelineItem();
                string tm = HtmlText.NodeAttr(n.attrs, "time");
                if (tm != "") { ti.time = tm; }
                string ttl = HtmlText.NodeAttr(n.attrs, "title");
                if (ttl != "") { ti.title = ttl; }
                c = ti;
                break;
            }
            case "collapse-item":
            case "collapseitem":
            case "collapse-panel": {
                CollapseItem ci = new CollapseItem();
                string ttl = HtmlText.NodeAttr(n.attrs, "title");
                if (ttl == "") { ttl = HtmlText.NodeAttr(n.attrs, "header"); }
                if (ttl != "") { ci.SetTitle(ttl); }
                string bd = HtmlText.NodeAttr(n.attrs, "body");
                if (bd != "") { ci.SetBodyText(bd); }
                c = ci;
                break;
            }
            default: {
                // 通用动态解析：优先通过 ControlFactory 与已注册组件族（ControlBootstrap,
                // DataTableBootstrap, ChartBootstrap 等）实例化，杜绝死硬编码
                // 控件 kind 一律由标签承载（映射表 + zan-<kebab> 帕斯卡
                // 还原 + 自定义族标签直通），没有属性旁路。
                string kind = TagToKind(tag);
                Control created = ControlFactory.Create(kind);
                if (created != null) {
                    c = created;
                } else {
                    Element el = new Element();
                    el.InitElement(tag, id);
                    for (int i = 0; i < n.attrs.Count; i = i + 1) {
                        el.SetAttr(n.attrs[i].name, n.attrs[i].val);
                    }
                    c = el;
                }
                break;
            }
        }
        // 真控件的 id 不进 nodeName（那是 Element 的），走选择器名
        if (id != "" && !(c is Element)) { c.SetProp("name", id); }
        // data-arg 预扫：属性顺序不保证（data-arg 可写在 data-on-*
        // 之后），先取出来供本节点全部事件共用；同时落 handlerArg
        // 字段，ChildWindow.WireNode 的二次接线同源。
        string darg = HtmlText.NodeAttr(n.attrs, "data-arg");
        if (darg != "") { c.handlerArg = darg; }
        if (n.text != "" && n.text.IndexOf("{{") >= 0 && c.bindTpl == "") {
            c.bindTpl = n.text;
        }
        // 属性协议（与 Designer 导入的建树代码同一套语义）
        for (int i = 0; i < n.attrs.Count; i = i + 1) {
            string k = n.attrs[i].name;
            string v = n.attrs[i].val;
            if (k == "id" || k == "type" || k == "value"
                || k == "placeholder" || k == "src" || k == "alt") {
                continue;   // 构造时已用
            }
            if (k == "class") {
                List<string> cs = HtmlText.SplitClass(v);
                for (int j = 0; j < cs.Count; j = j + 1) {
                    c.AddClass(cs[j]);
                }
                c.baseClass = c.Class;
                continue;
            }
            if (k == "style") {
                Html.AddInlineCss(doc, c, v);
                continue;
            }
            if (k == "slot" || k == "data-slot") {
                c.slotName = v;
                continue;
            }
            if (k == "z-mount" || k == "data-mount") {
                c.bindMount = v;
                continue;
            }
            if (k == "data-bind" || k == "z-model" || k == "v-model"
                || HtmlText.StartsWith(k, "v-model.") || HtmlText.StartsWith(k, "z-model.")
                || HtmlText.StartsWith(k, "data-bind.")) {
                c.bindPath = v;
                if (k.IndexOf(".lazy") >= 0) { c.bindLazy = true; }
                if (k.IndexOf(".number") >= 0) { c.bindNumber = true; }
                if (k.IndexOf(".trim") >= 0) { c.bindTrim = true; }
                continue;
            }
            if (k == ":class" || k == "data-bind-class" || k == "z-class" || k == "v-bind:class") {
                c.bindClass = v;
                continue;
            }
            if (k == ":disabled" || k == "data-bind-disabled" || k == "z-disabled" || k == "v-bind:disabled") {
                c.bindDisabled = v;
                continue;
            }
            if (k == "data-if" || k == "z-show" || k == "v-show") {
                c.bindIf = v;
                continue;
            }
            if (k == "z-hide" || k == "v-hide") {
                c.bindIf = "!" + v;
                continue;
            }
            if (k == "z-text" || k == "v-text") {
                c.bindPath = v;
                c.bindProp = "text";
                continue;
            }
            // 通用动态属性绑定（:prop / v-bind:prop / z-bind:prop）
            string bindAttr = "";
            if (k.Length > 1 && k[0] == 58) { // ':'
                bindAttr = k.Substring(1);
            } else if (k.Length > 7 && HtmlText.StartsWith(k, "v-bind:")) {
                bindAttr = k.Substring(7);
            } else if (k.Length > 7 && HtmlText.StartsWith(k, "z-bind:")) {
                bindAttr = k.Substring(7);
            }
            if (bindAttr != "") {
                c.AddBindProp(bindAttr, v);
                continue;
            }
            // 事件语法糖解析（data-on-*, @*, v-on:*, z-on:*, on*）
            string evt = "";
            string suffix = "";
            if (k.Length > 8 && HtmlText.StartsWith(k, "data-on-")) {
                suffix = k.Substring(8, k.Length - 8);
                evt = HtmlText.EventKind(suffix);
            } else if (k.Length > 1 && k[0] == 64) { // '@'
                suffix = k.Substring(1);
                evt = HtmlText.EventKind(suffix);
            } else if (k.Length > 5 && (HtmlText.StartsWith(k, "v-on:") || HtmlText.StartsWith(k, "z-on:"))) {
                suffix = k.Substring(5);
                evt = HtmlText.EventKind(suffix);
            } else if (k.Length > 2 && HtmlText.StartsWith(k, "on")) {
                suffix = k.Substring(2);
                evt = HtmlText.EventKind(suffix);
            }
            if (evt != "") {
                string mod = "";
                int dotIdx = suffix.IndexOf(".");
                if (dotIdx >= 0) {
                    mod = suffix.Substring(dotIdx + 1);
                }
                string hname = v;
                int pOpen = v.IndexOf("(");
                if (pOpen >= 0 && v.EndsWith(")")) {
                    hname = v.Substring(0, pOpen).Trim();
                    string argExpr = v.Substring(pOpen + 1, v.Length - pOpen - 2).Trim();
                    if (darg == "" && argExpr != "") {
                        darg = argExpr;
                    }
                }
                if (darg != "") {
                    Html.WireArg(handlers, c, evt, hname, darg, mod);
                } else {
                    Html.Wire(handlers, c, evt, hname, mod);
                }
                continue;
            } else if (suffix != "") {
                Console.WriteLine("HTML_WIRE_WARN unknown event '"
                    + suffix + "' on <" + n.tag + (id != ""
                        ? " id=" + id : "") + ">");
                continue;
            }
            string klow = k.ToLower();
            switch (klow) {
                case "icon": {
                    if (c is Button) {
                        ((Button)c).Icon = v;
                    }
                    c.SetProp("icon", v);
                    continue;
                }
                case "tip":
                case "title": {
                    if (c is Button) {
                        ((Button)c).Tip = v;
                    }
                    if (c is Element) {
                        ((Element)c).elTitle = v;
                    }
                    c.SetProp("tip", v);
                    continue;
                }
                case "tip-side":
                case "tipside":
                case "tip-pos": {
                    if (c is Button) {
                        ((Button)c).TipSide = v;
                    }
                    c.SetProp("tip-side", v);
                    continue;
                }
                case "data-label": {
                    // 设计稿标题通道：控件自画或装配层补标题行
                    //（FormBuilder.WrapCell 同语义）。
                    if (!(c is Element)) { c.SetDesignText(v); }
                    continue;
                }
                case "data-text": {
                    // 设计稿精确文案：防空白塌缩，直落控件 text。
                    if (!(c is Element)) { c.SetProp("text", v); }
                    continue;
                }
                case "data-layout-mode": {
                    // 自由画布（旧管线 layoutMode=1 同语义）。
                    if (v == "1") { c.FreeLayout(); }
                    continue;
                }
                case "free-layout":
                case "data-free-layout": {
                    c.FreeLayout();
                    continue;
                }
                case "disabled": {
                    c.SetProp("disabled", "true");
                    continue;
                }
                case "readonly": {
                    // 裸布尔属性：readonly 出现即生效，与 disabled 同语义。
                    c.SetProp("readonly", "true");
                    continue;
                }
                case "dock":
                case "data-dock": {
                    string dlow = v.ToLower();
                    if (dlow == "fill" || dlow == "5") { c.Grow(); }
                    else if (dlow == "top" || dlow == "1") { Html.AddInlineCss(doc, c, "width: 100%;"); }
                    continue;
                }
                case "data-fx": {
                    if (Html.IsIntText(v)) {
                        Html.AddInlineCss(doc, c, "position: absolute; left: " + v + "px;");
                    }
                    continue;
                }
                case "data-fy": {
                    if (Html.IsIntText(v)) {
                        Html.AddInlineCss(doc, c, "position: absolute; top: " + v + "px;");
                    }
                    continue;
                }
                case "data-fw": {
                    if (Html.IsIntText(v)) {
                        Html.AddInlineCss(doc, c, "width: " + v + "px;");
                    }
                    continue;
                }
                case "data-fh": {
                    if (Html.IsIntText(v)) {
                        Html.AddInlineCss(doc, c, "height: " + v + "px;");
                    }
                    continue;
                }
                case "data-padding": {
                    if (Html.IsIntText(v)) {
                        Html.AddInlineCss(doc, c, "padding: " + v + "px;");
                    }
                    continue;
                }
                case "data-gap": {
                    if (Html.IsIntText(v)) {
                        Html.AddInlineCss(doc, c, "gap: " + v + "px;");
                    }
                    continue;
                }
                case "data-margin": {
                    if (Html.IsIntText(v)) {
                        Html.AddInlineCss(doc, c, "margin: " + v + "px;");
                    }
                    continue;
                }
                case "visible": {
                    if (v == "false" || v == "0") { c.visible = false; }
                    else if (v == "true" || v == "1") { c.visible = true; }
                    continue;
                }
                default: {
                    if (c is Element) { break; }
                    // 设计稿复合值：data-x-options/x-props/x-columns（JSON
                    // 直落 options/columns/props，PutAttr 同语义）。
                    if (k.Length > 7 && HtmlText.StartsWith(k, "data-x-")) {
                        Html.ApplyXProp(c, Html.UnkebabKey(k.Substring(7)), v);
                        break;
                    }
                    if (k.Length > 5 && HtmlText.StartsWith(k, "data-")) {
                        string dkey = k.Substring(5);
                        // 方言结构键：语义在构造/装配层消费，不落属性表。
                        if (Html.IsDialectKey(dkey)) { break; }
                        // 其余 data-<kebab> 解包成 camelCase 属性键
                        // （data-placeholder → placeholder）。
                        c.SetProp(Html.UnkebabKey(dkey), v);
                        break;
                    }
                    c.SetProp(k, v);
                    break;
                }
            }
        }
        if (id != "" && !(c is Element)) {
            c.SetProp("name", id);
            c.name = id;
        }
        if (!(c is Element) && doc != null && doc.sizeClass != "" && !Html.HasSizeClass(c.Class)) {
            c.AddClass(doc.sizeClass);
        }
        return c;
    }


    public static bool IsMetaChild(string ptag, string ctag) {
        switch (ptag) {
            case "table":
            case "zan-table":
                return ctag == "thead" || ctag == "tbody" || ctag == "tfoot";
            case "select":
            case "selectbox":
            case "zan-select-box":
                return ctag == "option";
            case "tabs":
            case "tab-control":
            case "zan-tabs":
                return ctag == "tab" || ctag == "tab-pane" || ctag == "tabpane";
            case "datatable":
            case "grid":
            case "data-grid":
            case "zan-data-grid":
            case "zan-datatable":
                return ctag == "col" || ctag == "column";
            default:
                return false;
        }
    }


    // zan-<kebab> → PascalCase kind（ide-surface → IdeSurface）。
    public static string ZanKind(string kebab) {
        string outp = "";
        bool up = true;
        for (int i = 0; i < kebab.Length; i = i + 1) {
            char ch = kebab[i];
            if (ch == 45) { up = true; continue; }
            if (up && ch >= 97 && ch <= 122) { outp = outp + (char)(ch - 32); }
            else { outp = outp + ch; }
            up = false;
        }
        return outp;
    }

    // HTML 标签到控件 Kind 类型的归一化映射
    public static string TagToKind(string tag) {
        if (tag == "") { return ""; }
        string t = tag.ToLower();
        bool zan = HtmlText.StartsWith(t, "zan-");
        if (zan) {
            t = t.Substring(4, t.Length - 4);
        }
        switch (t) {
            case "datatable":
            case "grid":
            case "data-grid":
                return "DataGrid";
            case "table":
                return "Table";
            case "tr":
            case "table-row":
                return "TableRow";
            case "td":
            case "th":
            case "table-cell":
                return "TableCell";
            case "tabs":
            case "tab-control":
                return "Tabs";
            case "tab-pane":
            case "tabpane":
            case "tab":
                return "TabPane";
            case "breadcrumb-item":
                return "BreadcrumbItem";
            case "timeline-item":
                return "TimelineItem";
            case "splitpanel":
            case "split-panel":
            case "splitter":
                return "SplitPanel";
            case "treeview":
            case "tree":
                return "TreeView";
            case "pagination":
            case "pager":
                return "Pagination";
            case "checkbox":
            case "check-box":
                return "Checkbox";
            case "inputnumber":
            case "input-number":
                return "InputNumber";
            case "choicegroup":
            case "choice-group":
                // ChoiceGroup 是无表面的流布局基类（CheckboxGroup/
                // RadioGroup 的父），工厂不注册裸基类——标签不进表，
                // 落 Element 兜底即诚实。
                return "ChoiceGroup";
            case "radiogroup":
            case "radio-group":
                return "RadioGroup";
            case "switch":
                return "Switch";
            case "radio":
                return "Radio";
            case "radiobutton":
            case "radio-button":
                return "RadioButton";
            case "slider":
                return "Slider";
            case "colorpicker":
            case "color-picker":
                return "ColorPicker";
            case "datepicker":
            case "date-picker":
                return "DatePicker";
            case "upload":
                return "Upload";
            case "listview":
            case "list":
                return "ListView";
            case "listitem":
            case "list-item":
                return "ListItem";
            case "virtuallist":
            case "virtual-list":
                return "VirtualList";
            case "rate":
                return "Rate";
            case "chart":
                return "ChartHost";
            case "avatar":
                return "Avatar";
            case "badge":
                return "Badge";
            case "card":
                return "Card";
            case "alert":
            case "alert-box":
            case "alertbox":
                return "AlertBox";
            case "tag":
                return "Tag";
            case "divider":
            case "hr":
                return "Divider";
            case "toolstrip":
            case "toolbar":
            case "tool-strip":
                return "ToolStrip";
            case "statusbar":
            case "status-bar":
                return "StatusBar";
            case "collapse":
                return "Collapse";
            case "collapse-item":
            case "collapseitem":
            case "collapse-panel":
                return "CollapseItem";
            case "breadcrumb":
                return "Breadcrumb";
            case "steps":
                return "Steps";
            case "timeline":
                return "Timeline";
            case "carousel":
                return "Carousel";
            case "qrcode":
            case "qr-code":
                return "QrCode";
            case "statistic":
                return "Statistic";
            case "countdown":
                return "Countdown";
            case "empty":
                return "Empty";
            case "result":
                return "Result";
            case "skeleton":
                return "Skeleton";
            case "spin":
                return "Spin";
            case "watermark":
                return "Watermark";
            case "flex":
                return "Flex";
            case "row":
                return "Row";
            case "spacer":
                return "Spacer";
            case "form":
            case "form-group":
            case "formgroup":
                return "FormGroup";
            case "form-item":
            case "formitem":
            case "form-row":
            case "formrow":
                return "FormItem";
            case "modal":
            case "dialog":
                return "Modal";
            case "drawer":
                return "Drawer";
            case "panel":
            case "scrollbar":
            case "layer":
                return "Panel";
            case "ellipsis":
            case "label":
                return "Label";
            case "p":
            case "h1":
            case "h2":
            case "h3":
            case "h4":
            case "h5":
            case "h6":
            case "typography":
                return "Typography";
            case "iconview":
            case "icon-view":
                return "IconView";
            case "ribbon":
                return "ToolStrip";
            case "checkbox-group":
            case "checkboxgroup":
                return "CheckboxGroup";
            case "select":
            case "selectbox":
            case "select-box":
                return "SelectBox";
            default:
                // zan-<kebab> 自定义族：还原 PascalCase kind 供工厂查表。
                if (zan) { return ZanKind(t); }
                return tag;
        }
    }

}
