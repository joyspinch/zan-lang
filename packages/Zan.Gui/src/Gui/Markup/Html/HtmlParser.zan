using System;
using System.IO;
using System.Json;
using System.Text;
namespace Gui.Markup;
public class HtmlParser {
    private static List<string> s_emptyList;
    private static List<string> EmptyList() {
        if (HtmlParser.s_emptyList == null) {
            HtmlParser.s_emptyList = new List<string>();
        }
        return HtmlParser.s_emptyList;
    }
    private static void AppendHeadNode(WDoc doc, string tag,
                                       List<string> an, List<string> av, string text) {
        WNode hn = new WNode();
        hn.tag = tag;
        hn.parent = 0 - 1;
        hn.attrs = new List<WAttr>();
        hn.items = new List<WItem>();
        hn.text = text;
        if (an != null) {
            for (int i = 0; i < an.Count; i = i + 1) {
                string v = av != null && i < av.Count ? av[i] : "";
                hn.attrs.Add(new WAttr(an[i], v));
            }
        }
        doc.headNodes.Add(hn);
    }
    private static void LoadStylesheetLink(WDoc doc, List<string> an,
                                           List<string> av, string baseDir) {
        string rel = HtmlText.Attr(an, av, "rel").ToLower();
        string href = HtmlText.Attr(an, av, "href");
        if (rel == "stylesheet" && href != "" && baseDir != "") {
            string path = baseDir + "/" + href;
            if (File.Exists(path)) {
                try {
                    string css = File.ReadAllText(path);
                    if (css != null) { doc.css = doc.css + css + "\n"; }
                } catch (Exception ex) {
                    // ignore unreadable external stylesheet
                }
            }
        }
    }
    private JsonValue pendingHeadAttr;
    private bool inHead;
    public HtmlParser() {
        this.pendingHeadAttr = JsonValue.NewObject();
        this.inHead = false;
    }
    public static WDoc Parse(string html, string baseDir) {
        HtmlParser parser = new HtmlParser();
        return parser.ParseDoc(html, baseDir);
    }
    public WDoc ParseDoc(string html, string baseDir) {
        if (html == null) { html = ""; }
        if (baseDir == null) { baseDir = ""; }
        WDoc doc = new WDoc();
        doc.css = "";
        doc.nodes = new List<WNode>();
        doc.headNodes = new List<WNode>();
        this.pendingHeadAttr = JsonValue.NewObject();
        this.inHead = false;
        List<WFrame> st = new List<WFrame>();
        List<string> tagAn = new List<string>();
        List<string> tagAv = new List<string>();
        int n = html.Length;
        int i = 0;
        while (i < n) {
            if (st.Count > 0) {
                WFrame top = st[st.Count - 1];
                if (top.mode == 2 || top.mode == 3) {
                    int close = HtmlText.FindCloseTag(html, top.tag, i);
                    if (close < 0) {
                        if (top.mode == 2 && i < n) {
                            top.label = top.label + html.Substring(i, n - i);
                        }
                        i = n;
                        break;
                    }
                    if (close > i) {
                        if (top.mode == 2) {
                            top.label = top.label + html.Substring(i, close - i);
                        }
                        i = close;
                        continue;
                    }
                }
            }
            if ((html[i] & 255) == 60) {  // '<'
                if (i + 3 < n && (html[i + 1] & 255) == 33 && (html[i + 2] & 255) == 45
                    && (html[i + 3] & 255) == 45) {
                    int end = HtmlText.FindFrom(html, "-->", i + 4);
                    i = end < 0 ? n : end + 3;
                    continue;
                }
                if (i + 1 < n && (html[i + 1] & 255) == 33) {
                    int gt = HtmlText.FindFrom(html, ">", i);
                    i = gt < 0 ? n : gt + 1;
                    continue;
                }
                if (i + 1 < n && (html[i + 1] & 255) == 47) {
                    int j = i + 2;
                    int ns = j;
                    while (j < n && HtmlText.IsNameChar(html[j] & 255)) { j = j + 1; }
                    string name = html.Substring(ns, j - ns).ToLower();
                    while (j < n && (html[j] & 255) != 62) { j = j + 1; }
                    i = j < n ? j + 1 : n;
                    HtmlParser.CloseTag(st, doc, name);
                    continue;
                }
                if (i + 1 < n && HtmlText.IsAlpha(html[i + 1] & 255)) {
                    tagAn.Clear();
                    tagAv.Clear();
                    WOpenResult r = HtmlParser.OpenTag(html, i, tagAn, tagAv);
                    i = r.next > i ? r.next : i + 1;
                    this.HandleOpen(st, doc, r.name, tagAn, tagAv, r.selfClose,
                                    baseDir);
                    continue;
                }
            }
            int lt = i;
            while (lt < n && (html[lt] & 255) != 60) { lt = lt + 1; }
            if (lt > i) {
                HtmlParser.FeedText(st, html.Substring(i, lt - i));
                i = lt;
            } else {
                i = i + 1;  // 游离 '<'：按文本丢弃，防死循环
            }
        }
        while (st.Count > 0) { HtmlParser.CloseTop(st, doc); }
        if (doc.nodes.Count == 0) {
            List<string> empty = HtmlParser.EmptyList();
            HtmlParser.PushNode(doc, "body", 0 - 1, empty, empty);
        }
        return doc;
    }
    public static WOpenResult OpenTag(string html, int i,
                                      List<string> an, List<string> av) {
        WOpenResult r = new WOpenResult();
        if (html == null) { r.name = ""; r.next = i; return r; }
        int n = html.Length;
        int j = i + 1;
        int ns = j;
        while (j < n && HtmlText.IsNameChar(html[j] & 255)) { j = j + 1; }
        r.name = j > ns ? html.Substring(ns, j - ns).ToLower() : "";
        r.selfClose = false;
        while (j < n) {
            int prevJ = j;
            int ch = html[j] & 255;
            if (ch == 62) { j = j + 1; break; }
            if (ch == 47) {
                if (j + 1 < n && (html[j + 1] & 255) == 62) {
                    r.selfClose = true;
                    j = j + 2;
                    break;
                }
                j = j + 1;
                continue;
            }
            if (HtmlText.IsSpaceChar(ch)) { j = j + 1; continue; }
            int asn = j;
            while (j < n && !HtmlText.IsSpaceChar(html[j] & 255) && (html[j] & 255) != 61
                   && (html[j] & 255) != 62 && (html[j] & 255) != 47) {
                j = j + 1;
            }
            string aname = html.Substring(asn, j - asn).ToLower();
            while (j < n && HtmlText.IsSpaceChar(html[j] & 255)) { j = j + 1; }
            string aval = "";
            if (j < n && (html[j] & 255) == 61) {
                j = j + 1;
                while (j < n && HtmlText.IsSpaceChar(html[j] & 255)) { j = j + 1; }
                if (j < n && ((html[j] & 255) == 34 || (html[j] & 255) == 39)) {
                    int q = html[j] & 255;
                    j = j + 1;
                    int vs = j;
                    while (j < n && (html[j] & 255) != q) { j = j + 1; }
                    aval = html.Substring(vs, j - vs);
                    if (j < n) { j = j + 1; }
                } else {
                    int vs = j;
                    while (j < n && !HtmlText.IsSpaceChar(html[j] & 255)
                           && (html[j] & 255) != 62) {
                        j = j + 1;
                    }
                    aval = html.Substring(vs, j - vs);
                }
            }
            if (aname != "") {
                an.Add(aname);
                av.Add(HtmlText.DecodeEntities(aval));
            }
            if (j == prevJ) { j = j + 1; }
        }
        r.next = j;
        return r;
    }
    private void HandleOpen(List<WFrame> st, WDoc doc, string name,
                            List<string> an, List<string> av, bool selfClose,
                            string baseDir) {
        if (st.Count > 0) {
            WFrame top = st[st.Count - 1];
            if (top.mode == 1) {
                return;  // 捕获帧（button/textarea）内嵌元素：忽略
            }
        }
        if (name == "html") { return; }  // 透明容器
        if (name == "head") {
            for (int hi = 0; hi < an.Count; hi = hi + 1) {
                if (HtmlText.StartsWith(an[hi], "data-")) {
                    this.pendingHeadAttr.Put(an[hi], JsonValue.NewStr(av[hi]));
                }
            }
            this.inHead = true;
            return;
        }
        if (this.inHead) {
            if (name == "meta" || name == "base") {
                HtmlParser.AppendHeadNode(doc, name, an, av, "");
                return;
            }
            if (name == "link") {
                HtmlParser.AppendHeadNode(doc, name, an, av, "");
                HtmlParser.LoadStylesheetLink(doc, an, av, baseDir);
                return;
            }
            if (name == "style") {
                if (!selfClose && st.Count < 512) { st.Add(HtmlParser.Frame(doc, 0 - 1, "style", 2)); }
                return;
            }
            if (name == "title") {
                if (!selfClose && st.Count < 512) { st.Add(HtmlParser.Frame(doc, 0 - 1, "title", 1)); }
                return;
            }
            if (name == "script") {
                if (!selfClose && st.Count < 512) { st.Add(HtmlParser.Frame(doc, 0 - 1, name, 3)); }
                return;
            }
            this.inHead = false;  // head 之外的其他标签：当正文
        }
        if (name == "body") {
            if (doc.nodes.Count > 0) { return; }  // 重复/迟到 body 忽略
            for (int hi = 0; hi < this.pendingHeadAttr.Count(); hi = hi + 1) {
                string hk = this.pendingHeadAttr.KeyAt(hi);
                bool dup = false;
                for (int bi = 0; bi < an.Count; bi = bi + 1) {
                    if (an[bi] == hk) { dup = true; break; }
                }
                if (!dup) {
                    an.Add(hk);
                    av.Add(this.pendingHeadAttr.ValAt(hi).AsString(""));
                }
            }
            HtmlParser.PushNode(doc, "body", 0 - 1, an, av);
            st.Add(HtmlParser.Frame(doc, doc.nodes.Count - 1, "body", 0));
            return;
        }
        if (doc.nodes.Count == 0) {
            List<string> empty = HtmlParser.EmptyList();
            HtmlParser.PushNode(doc, "body", 0 - 1, empty, empty);
            st.Add(HtmlParser.Frame(doc, doc.nodes.Count - 1, "body", 0));
        }
        if (st.Count == 0) { return; }
        WFrame parent = st[st.Count - 1];
        bool isInl = HtmlText.IsInlineTag(name);
        if (name == "style") {
            HtmlParser.Flush(doc, parent, false);
            parent.prevInline = false;
            if (!selfClose && st.Count < 512) {
                WFrame f = HtmlParser.Frame(doc, 0 - 1, "style", 2);
                st.Add(f);
            }
            return;
        }
        if (name == "script" || name == "title") {
            HtmlParser.Flush(doc, parent, false);
            parent.prevInline = false;
            if (!selfClose && st.Count < 512) {
                st.Add(HtmlParser.Frame(doc, 0 - 1, name, 3));
            }
            return;
        }
        if (name == "link") {
            HtmlParser.LoadStylesheetLink(doc, an, av, baseDir);
            return;
        }
        if (name == "meta" || name == "base") { return; }
        if (name == "button" || name == "textarea" || name == "label") {
            HtmlParser.Flush(doc, parent, true);
            parent.prevInline = true;
            int rec = HtmlParser.PushNode(doc, name, parent.rec, an, av);
            if (!selfClose && st.Count < 512) {
                st.Add(HtmlParser.Frame(doc, rec, name, 1));
            }
            return;
        }
        if (name == "input" || name == "img") {
            HtmlParser.Flush(doc, parent, true);
            HtmlParser.PushNode(doc, name, parent.rec, an, av);
            parent.prevInline = true;
            return;
        }
        if (name == "br" || name == "hr") {
            HtmlParser.Flush(doc, parent, name == "br");
            HtmlParser.PushNode(doc, name, parent.rec, an, av);
            parent.prevInline = name == "br";
            return;
        }
        HtmlParser.Flush(doc, parent, isInl);
        int crec = HtmlParser.PushNode(doc, name, parent.rec, an, av);
        if (!selfClose && !HtmlText.IsVoidTag(name) && st.Count < 512) {
            st.Add(HtmlParser.Frame(doc, crec, name, 0));
        } else {
            parent.prevInline = isInl;
        }
    }
    public static WFrame Frame(WDoc doc, int rec, string tag, int mode) {
        WFrame f = new WFrame();
        f.rec = rec;
        f.tag = tag;
        f.mode = mode;
        f.pending = "";
        f.prevInline = false;
        f.label = "";
        return f;
    }
    public static int PushNode(WDoc doc, string tag, int parent,
                               List<string> an, List<string> av) {
        WNode n = new WNode();
        n.tag = tag;
        n.parent = parent;
        n.attrs = new List<WAttr>();
        n.items = new List<WItem>();
        n.text = "";
        for (int i = 0; i < an.Count; i = i + 1) {
            string v = "";
            if (i < av.Count) { v = av[i]; }
            n.attrs.Add(new WAttr(an[i], v));
        }
        doc.nodes.Add(n);
        if (parent >= 0) {
            WItem it = new WItem();
            it.kid = doc.nodes.Count - 1;
            it.text = "";
            doc.nodes[parent].items.Add(it);
        }
        return doc.nodes.Count - 1;
    }
    public static void CloseTag(List<WFrame> st, WDoc doc, string name) {
        int at = 0 - 1;
        for (int k = st.Count - 1; k >= 0; k = k - 1) {
            if (st[k].tag == name) { at = k; break; }
        }
        if (at < 0) { return; }  // 游离闭标签忽略
        while (st.Count - 1 > at) { HtmlParser.CloseTop(st, doc); }
        HtmlParser.CloseTop(st, doc);
        if (st.Count > 0) { st[st.Count - 1].prevInline = HtmlText.IsInlineTag(name); }
    }
    public static void CloseTop(List<WFrame> st, WDoc doc) {
        if (st == null || st.Count == 0) { return; }
        WFrame f = st[st.Count - 1];
        st.RemoveAt(st.Count - 1);
        if (f.mode == 2) {
            doc.css = doc.css + f.label + "\n";
            return;
        }
        if (f.mode == 3) { return; }
        if (f.mode == 1) {
            string txt = HtmlText.CollapseSpace(f.label).Trim();
            if (f.rec >= 0 && f.rec < doc.nodes.Count) {
                doc.nodes[f.rec].text = txt;
            } else if (f.tag == "title") {
                HtmlParser.AppendHeadNode(doc, "title", null, null, txt);
            }
            return;
        }
        HtmlParser.Flush(doc, f, HtmlText.IsInlineTag(f.tag));
    }
    public static void FeedText(List<WFrame> st, string raw) {
        if (st.Count == 0) { return; }
        WFrame top = st[st.Count - 1];
        if (top.mode == 1) {
            top.label = top.label + HtmlText.DecodeEntities(raw);
            return;
        }
        if (top.mode != 0) { return; }
        string s = HtmlText.CollapseSpace(HtmlText.DecodeEntities(raw));
        if (s == "") { return; }
        if (top.pending == "" && !top.prevInline && s[0] == 32) { s = HtmlText.TrimLead(s); }
        top.pending = top.pending + s;
    }
    public static void Flush(WDoc doc, WFrame f, bool nextInline) {
        string s = f.pending;
        f.pending = "";
        if (s == "") { return; }
        bool wasPrev = f.prevInline;
        if (!nextInline) { s = HtmlText.TrimTrail(s); }
        if (s == "") { return; }  // 纯空白且块边界：整体丢
        if (s == " ") {
            if (wasPrev && nextInline && f.rec >= 0) {
                WItem it = new WItem();
                it.kid = 0 - 1;
                it.text = " ";
                doc.nodes[f.rec].items.Add(it);
                f.prevInline = true;
            }
            return;
        }
        if (f.rec >= 0) {
            WItem it = new WItem();
            it.kid = 0 - 1;
            it.text = s;
            doc.nodes[f.rec].items.Add(it);
        }
        f.prevInline = true;
    }
}
