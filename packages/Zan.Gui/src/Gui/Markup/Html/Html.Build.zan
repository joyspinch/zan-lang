using System;
using System.Json;
using Gui.Markup;
namespace Gui;
public partial class Html {
    public static bool IsIntText(string s) {
        if (s == null || s == "") { return false; }
        int i = 0;
        if ((s[0] & 255) == 45) { i = 1; }
        if (i >= s.Length) { return false; }
        while (i < s.Length) {
            int ch = s[i] & 255;
            if (ch < 48 || ch > 57) { return false; }
            i = i + 1;
        }
        int parsed = 0;
        return int.TryParse(s, out parsed);
    }
    public static string UnkebabKey(string s) { return HtmlText.UnkebabKey(s); }
    public static bool IsDialectKey(string k) {
        switch (k) {
            case "kind":
            case "span":
            case "child-tab":
            case "position":
            case "padding":
            case "pad":
            case "gap":
            case "margin":
            case "label":
            case "text":
            case "layout-mode":
            case "for":
            case "html-tag":
                return true;
            default:
                return false;
        }
    }
    public static void ApplyXProp(Control c, string key, string v) {
        if (c == null || key == null) { return; }
        if (v == null || v == "" || ((v[0] & 255) != 123 && (v[0] & 255) != 91)) { c.SetProp(key, v != null ? v : ""); return; }
        JsonValue parsed = null;
        try { parsed = JsonValue.Parse(v); } catch (Exception ex) {
            parsed = null;
        }
        if (parsed == null) { c.SetProp(key, v); return; }
        if (key == "options" && parsed.IsArray()) {
            c.SetProp("options", Html.JsonJoinOpts(parsed));
            return;
        }
        if (key == "columns" && parsed.IsArray()) {
            string spec = Html.JsonGridSpec(parsed);
            if (spec != "") { c.SetProp("previewColumns", spec); }
            c.SetProp("columns", v);
            return;
        }
        if (key == "props" && parsed.IsObject()) {
            for (int i = 0; i < parsed.Count(); i = i + 1) {
                JsonValue val = parsed.ValAt(i);
                if (val == null) { continue; }
                if (val.IsString()) { c.SetProp(parsed.KeyAt(i), val.AsString("")); }
                else if (val.IsBool()) { c.SetProp(parsed.KeyAt(i), val.AsBool(false) ? "true" : "false"); }
                else if (val.IsNumber()) { c.SetProp(parsed.KeyAt(i), val.ToJson()); }
            }
            return;
        }
        c.SetProp(key, parsed.ToJson());
    }
    public static string JsonJoinOpts(JsonValue opts) {
        if (opts == null) { return ""; }
        if (opts.IsString()) { return opts.AsString(""); }
        if (!opts.IsArray() || opts.Count() == 0) { return ""; }
        string outp = "";
        for (int i = 0; i < opts.Count(); i = i + 1) {
            outp = outp + (i > 0 ? "|" : "") + opts.At(i).AsString("");
        }
        return outp;
    }
    public static string JsonGridSpec(JsonValue cols) {
        if (cols == null) { return ""; }
        string spec = "";
        for (int i = 0; i < cols.Count(); i = i + 1) {
            JsonValue col = cols.At(i);
            if (col == null || !col.IsObject()) { continue; }
            string title = col.Str("title", "");
            if (title == "") { title = col.Str("field", ""); }
            if (title == "") { continue; }
            spec = spec + (spec != "" ? "|" : "")
                + Convert.ToString(col.Int("width", 100)) + "," + title;
        }
        return spec;
    }
    public static Control Build(WDoc wd, WNode n, HtmlDoc doc, HtmlHandlers handlers) {
        Install();
        SetCloneFallback(ControlFactory.Create);
        return Html.BuildNode(wd, n, doc, handlers, ControlFactory.Create);
    }
    private static Control BuildNode(WDoc wd, WNode n, HtmlDoc doc, HtmlHandlers handlers,
                                     ControlFactoryFn factory) {
        string tag = n.tag;
        string id = HtmlText.NodeAttr(n.attrs, "id");
        string type = HtmlText.NodeAttr(n.attrs, "type").ToLower();
        string nativeKind = Html.NativeKind(tag, type);
        string kind = nativeKind != "" ? nativeKind : TagToKind(tag);
        Control c = factory != null ? factory(kind) : null;
        if (c == null) {
            Element el = new Element();
            el.InitElement(tag, id);
            if (n.text != "") { el.AddText(n.text); }
            for (int i = 0; i < n.attrs.Count; i = i + 1) {
                el.SetAttr(n.attrs[i].name, n.attrs[i].val);
            }
            c = el;
        } else {
            c.SetDocumentFactory(factory, kind);
            if (nativeKind != "") { Html.InitializeNative(wd, n, c, nativeKind, type); }
        }
        if (id != "" && !(c is Element)) { c.name = id; }
        string darg = HtmlText.NodeAttr(n.attrs, "data-arg");
        if (darg != "") { c.handlerArg = darg; }
        for (int i = 0; i < n.attrs.Count; i = i + 1) {
            string k = n.attrs[i].name;
            string v = n.attrs[i].val;
            if (k == "id" || (tag == "input" && k == "type")
                || (tag == "input" && nativeKind == "Input" && (k == "value" || k == "placeholder"))
                || (tag == "img" && (k == "src" || k == "alt"))
                || ((tag == "progress" || tag == "zan-progress") && k == "value")) {
                continue;
            }
            if (k == "class") {
                List<string> cs = HtmlText.SplitClass(v);
                for (int j = 0; j < cs.Count; j = j + 1) {
                    c.AddClass(cs[j]);
                }
                c.baseClass = c.Class;
                continue;
            }
            if (k == "style") {
                Html.AddInlineCss(doc, c, v);
                continue;
            }
            if (k == "slot" || k == "data-slot") {
                c.slotName = v;
                continue;
            }
            if (k == "data-child-tab") {
                if (c.slotName == "") { c.slotName = v; }
                continue;
            }
            if (k == "z-mount" || k == "data-mount") {
                c.bindMount = v;
                continue;
            }
            if (k == "bind" || HtmlText.StartsWith(k, "bind:")) {
                string boundProperty = k == "bind" ? "" : k.Substring(5);
                if (boundProperty == "" && k != "bind") {
                    throw new ArgumentException("bind: requires a component property");
                }
                c.DeclareBinding(v, boundProperty, true);
                continue;
            }
            if (k.Length > 1 && k[0] == 58) { // ':'
                c.DeclareBinding(v, k.Substring(1), false);
                continue;
            }
            string evt = "";
            string suffix = "";
            if (k.Length > 8 && HtmlText.StartsWith(k, "data-on-")) {
                suffix = k.Substring(8, k.Length - 8);
                evt = HtmlText.EventKind(suffix, c.Events());
            } else if (k.Length > 1 && k[0] == 64) { // '@'
                suffix = k.Substring(1);
                evt = HtmlText.EventKind(suffix, c.Events());
            } else if (k.Length > 5 && (HtmlText.StartsWith(k, "v-on:") || HtmlText.StartsWith(k, "z-on:"))) {
                suffix = k.Substring(5);
                evt = HtmlText.EventKind(suffix, c.Events());
            } else if (k.Length > 2 && HtmlText.StartsWith(k, "on")) {
                suffix = k.Substring(2);
                evt = HtmlText.EventKind(suffix, c.Events());
            }
            if (evt != "") {
                string mod = "";
                int dotIdx = suffix.IndexOf(".");
                if (dotIdx >= 0) { mod = suffix.Substring(dotIdx + 1); }
                string hname = v;
                int pOpen = v.IndexOf("(");
                if (pOpen >= 0 && v.EndsWith(")")) {
                    hname = v.Substring(0, pOpen).Trim();
                    string argExpr = v.Substring(pOpen + 1, v.Length - pOpen - 2).Trim();
                    if (darg == "" && argExpr != "") { darg = argExpr; }
                }
                if (darg != "") {
                    Html.WireArg(handlers, c, evt, hname, darg, mod);
                } else {
                    Html.Wire(handlers, c, evt, hname, mod);
                }
                continue;
            } else if (suffix != "") {
                Console.WriteLine("HTML_WIRE_WARN unknown event '"
                    + suffix + "' on <" + n.tag + (id != ""
                        ? " id=" + id : "") + ">");
                continue;
            }
            string klow = k.ToLower();
            switch (klow) {
                case "icon": {
                    c.SetProp("icon", v);
                    continue;
                }
                case "tip": {
                    c.SetProp("tip", v);
                    continue;
                }
                case "title": {
                    c.SetProp(c.Kind() == "Button" ? "tip" : "title", v);
                    continue;
                }
                case "tip-side":
                case "tipside":
                case "tip-pos": {
                    c.SetProp(c.Kind() == "Button" ? "tipSide" : "tip-side", v);
                    continue;
                }
                case "data-label": {
                    if (!(c is Element)) { c.SetDesignText(v); }
                    continue;
                }
                case "data-text": {
                    if (!(c is Element)) { c.SetProp("text", v); }
                    continue;
                }
                case "data-layout-mode": {
                    if (v == "1") { c.FreeLayout(); }
                    continue;
                }
                case "free-layout":
                case "data-free-layout": {
                    c.FreeLayout();
                    continue;
                }
                case "disabled": {
                    c.SetProp("disabled", "true");
                    continue;
                }
                case "readonly": {
                    c.SetProp("readonly", "true");
                    continue;
                }
                case "data-padding": {
                    if (Html.IsIntText(v)) {
                        Html.AddInlineCss(doc, c, "padding: " + v + "px;");
                    }
                    continue;
                }
                case "data-gap": {
                    if (Html.IsIntText(v)) {
                        Html.AddInlineCss(doc, c, "gap: " + v + "px;");
                    }
                    continue;
                }
                case "data-margin": {
                    if (Html.IsIntText(v)) {
                        Html.AddInlineCss(doc, c, "margin: " + v + "px;");
                    }
                    continue;
                }
                case "visible": {
                    if (v == "false" || v == "0") { c.visible = false; }
                    else if (v == "true" || v == "1") { c.visible = true; }
                    continue;
                }
                default: {
                    if (c is Element) { break; }
                    if (k.Length > 7 && HtmlText.StartsWith(k, "data-x-")) {
                        Html.ApplyXProp(c, Html.UnkebabKey(k.Substring(7)), v);
                        break;
                    }
                    if (k.Length > 5 && HtmlText.StartsWith(k, "data-")) {
                        string dkey = k.Substring(5);
                        if (Html.IsDialectKey(dkey)) { break; }
                        c.SetProp(Html.UnkebabKey(dkey), v);
                        break;
                    }
                    c.SetProp(k, v);
                    break;
                }
            }
        }
        if (id != "" && !(c is Element)) { c.name = id; }
        if (!(c is Element) && doc != null && doc.sizeClass != "" && !Html.HasSizeClass(c.Class)) {
            c.AddClass(doc.sizeClass);
        }
        return c;
    }
    public static bool IsMetaChild(string ptag, string ctag) {
        switch (ptag) {
            case "table":
            case "zan-table":
                return ctag == "thead" || ctag == "tbody" || ctag == "tfoot";
            case "select":
            case "selectbox":
            case "zan-select-box":
                return ctag == "option";
            case "tabs":
            case "tab-control":
            case "zan-tabs":
                return ctag == "tab" || ctag == "tab-pane" || ctag == "tabpane";
            case "datatable":
            case "grid":
            case "data-grid":
            case "zan-data-grid":
            case "zan-datatable":
                return ctag == "col" || ctag == "column";
            default:
                return false;
        }
    }
    public static string ZanKind(string kebab) {
        if (kebab == null) { return ""; }
        string outp = "";
        bool up = true;
        for (int i = 0; i < kebab.Length; i = i + 1) {
            int ch = kebab[i] & 255;
            if (ch == 45) { up = true; continue; }
            if (up && ch >= 97 && ch <= 122) { outp = outp + (char)(ch - 32); }
            else { outp = outp + (char)ch; }
            up = false;
        }
        return outp;
    }
    public static string TagToKind(string tag) {
        if (tag == null || tag == "") { return ""; }
        string t = tag.ToLower();
        bool zan = HtmlText.StartsWith(t, "zan-");
        if (zan) { t = t.Substring(4, t.Length - 4); }
        switch (t) {
            case "datatable":
            case "grid":
            case "data-grid":
                return "DataGrid";
            case "table":
                return "Table";
            case "tr":
            case "table-row":
                return "TableRow";
            case "td":
            case "th":
            case "table-cell":
                return "TableCell";
            case "tabs":
            case "tab-control":
                return "Tabs";
            case "tab-pane":
            case "tabpane":
            case "tab":
                return "TabPane";
            case "breadcrumb-item":
                return "BreadcrumbItem";
            case "timeline-item":
                return "TimelineItem";
            case "splitpanel":
            case "split-panel":
            case "splitter":
                return "SplitPanel";
            case "treeview":
            case "tree":
                return "TreeView";
            case "pagination":
            case "pager":
                return "Pagination";
            case "checkbox":
            case "check-box":
                return "Checkbox";
            case "inputnumber":
            case "input-number":
                return "InputNumber";
            case "choicegroup":
            case "choice-group":
                return "ChoiceGroup";
            case "radiogroup":
            case "radio-group":
                return "RadioGroup";
            case "switch":
                return "Switch";
            case "radio":
                return "Radio";
            case "radiobutton":
            case "radio-button":
                return "RadioButton";
            case "slider":
                return "Slider";
            case "colorpicker":
            case "color-picker":
                return "ColorPicker";
            case "datepicker":
            case "date-picker":
                return "DatePicker";
            case "upload":
                return "Upload";
            case "listview":
            case "list":
                return "ListView";
            case "listitem":
            case "list-item":
                return "ListItem";
            case "virtuallist":
            case "virtual-list":
                return "VirtualList";
            case "rate":
                return "Rate";
            case "chart":
                return "ChartHost";
            case "avatar":
                return "Avatar";
            case "badge":
                return "Badge";
            case "card":
                return "Card";
            case "alert":
            case "alert-box":
            case "alertbox":
                return "AlertBox";
            case "tag":
                return "Tag";
            case "divider":
            case "hr":
                return "Divider";
            case "toolstrip":
            case "toolbar":
            case "tool-strip":
                return "ToolStrip";
            case "statusbar":
            case "status-bar":
                return "StatusBar";
            case "collapse":
                return "Collapse";
            case "collapse-item":
            case "collapseitem":
            case "collapse-panel":
                return "CollapseItem";
            case "breadcrumb":
                return "Breadcrumb";
            case "steps":
                return "Steps";
            case "timeline":
                return "Timeline";
            case "carousel":
                return "Carousel";
            case "qrcode":
            case "qr-code":
                return "QrCode";
            case "statistic":
                return "Statistic";
            case "countdown":
                return "Countdown";
            case "empty":
                return "Empty";
            case "result":
                return "Result";
            case "skeleton":
                return "Skeleton";
            case "spin":
                return "Spin";
            case "watermark":
                return "Watermark";
            case "flex":
                return "Flex";
            case "row":
                return "Row";
            case "spacer":
                return "Spacer";
            case "form":
            case "form-group":
            case "formgroup":
                return "FormGroup";
            case "form-item":
            case "formitem":
            case "form-row":
            case "formrow":
                return "FormItem";
            case "modal":
            case "dialog":
                return "Modal";
            case "drawer":
                return "Drawer";
            case "calendar":
                return "Calendar";
            case "panel":
            case "scrollbar":
            case "layer":
                return "Panel";
            case "ellipsis":
            case "label":
                return "Label";
            case "p":
            case "h1":
            case "h2":
            case "h3":
            case "h4":
            case "h5":
            case "h6":
            case "typography":
                return "Typography";
            case "iconview":
            case "icon-view":
                return "IconView";
            case "ribbon":
                return "Ribbon";
            case "checkbox-group":
            case "checkboxgroup":
                return "CheckboxGroup";
            case "select":
            case "selectbox":
            case "select-box":
                return "SelectBox";
            default:
                if (zan) { return ZanKind(t); }
                return tag;
        }
    }
}
