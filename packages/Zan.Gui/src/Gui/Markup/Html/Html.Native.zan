using System;
using System.Json;
using Gui.Markup;
namespace Gui;
public partial class Html {
    private static string NativeKind(string tag, string type) {
        switch (tag) {
            case "label":
            case "text-block":
            case "textblock": return "Label";
            case "view": return "View";
            case "button": return "Button";
            case "textarea": return "TextArea";
            case "input": {
                switch (type) {
                    case "checkbox": return "Checkbox";
                    case "radio": return "Radio";
                    case "number": return "InputNumber";
                    case "range": return "Slider";
                    case "color": return "ColorPicker";
                    case "date": return "DatePicker";
                    case "datetime-local": return "DatePicker";
                    case "file": return "Upload";
                    default: return "Input";
                }
            }
            case "img": return "Image";
            case "select":
            case "selectbox":
            case "select-box":
            case "zan-select-box": return "SelectBox";
            case "progress":
            case "zan-progress": return "Progress";
            case "tabs":
            case "tab-control":
            case "zan-tabs": return "Tabs";
            case "table": return "Table";
            case "tr": return "TableRow";
            case "th":
            case "td": return "TableCell";
            case "tab-pane":
            case "tabpane": return "TabPane";
            case "breadcrumb-item": return "BreadcrumbItem";
            case "timeline-item": return "TimelineItem";
            case "collapse-item":
            case "collapseitem":
            case "collapse-panel":
            case "collapsepanel":
            case "ui-collapse-panel":
            case "uicollapsepanel": return "CollapseItem";
            default: return "";
        }
    }
    private static void InitializeNative(WDoc wd, WNode n, Control c, string kind, string type) {
        switch (kind) {
            case "Label": {
                string text = HtmlText.NodeAttr(n.attrs, "data-label");
                if (text == "") { text = HtmlText.NodeAttr(n.attrs, "data-text"); }
                if (text == "") { text = n.text; }
                c.SetProp("text", text);
                c.name = text;
                break;
            }
            case "Button": {
                c.SetProp("text", n.text);
                c.name = n.text;
                break;
            }
            case "TextArea": {
                c.SetDocumentText(n.text, "");
                break;
            }
            case "Input": {
                string value = HtmlText.NodeAttr(n.attrs, "value");
                string placeholder = HtmlText.NodeAttr(n.attrs, "placeholder");
                c.SetDocumentText(value, placeholder);
                if (type == "password") { c.SetProp("password", "true"); }
                break;
            }
            case "Image": {
                c.SetProp("src", HtmlText.NodeAttr(n.attrs, "src"));
                c.SetProp("alt", HtmlText.NodeAttr(n.attrs, "alt"));
                c.SetProp("fit", "cover");
                break;
            }
            case "SelectBox": {
                Html.InitializeSelect(wd, n, c);
                break;
            }
            case "Progress": {
                string maxValue = HtmlText.NodeAttr(n.attrs, "max");
                if (maxValue != "") { c.SetProp("max", maxValue); }
                string valueText = HtmlText.NodeAttr(n.attrs, "value");
                if (valueText != "") { c.SetProp("value", valueText); }
                break;
            }
            case "Tabs": {
                string opts = "";
                for (int i = 0; i < n.items.Count; i = i + 1) {
                    WItem it = n.items[i];
                    if (it.kid < 0 || it.kid >= wd.nodes.Count) { continue; }
                    WNode cn = wd.nodes[it.kid];
                    if (cn.tag != "tab" && cn.tag != "tab-pane" && cn.tag != "tabpane") { continue; }
                    string tTitle = HtmlText.NodeAttr(cn.attrs, "title");
                    if (tTitle == "") { tTitle = HtmlText.NodeAttr(cn.attrs, "label"); }
                    if (tTitle == "") { tTitle = HtmlText.NodeAttr(cn.attrs, "name"); }
                    if (tTitle == "") { tTitle = cn.text.Trim(); }
                    if (tTitle != "") {
                        if (opts != "") { opts = opts + "|"; }
                        opts = opts + tTitle;
                    }
                }
                if (opts != "") { c.SetProp("options", opts); }
                break;
            }
            case "TableCell": {
                if (n.tag == "th") { c.SetProp("header", "true"); }
                break;
            }
            case "TabPane": {
                string title = HtmlText.NodeAttr(n.attrs, "label");
                if (title == "") { title = HtmlText.NodeAttr(n.attrs, "title"); }
                if (title != "") { c.SetProp("label", title); }
                break;
            }
            case "CollapseItem": {
                string title = HtmlText.NodeAttr(n.attrs, "title");
                if (title == "") { title = HtmlText.NodeAttr(n.attrs, "header"); }
                if (title != "") { c.SetProp("title", title); }
                string body = HtmlText.NodeAttr(n.attrs, "body");
                if (body != "") { c.SetDocumentBody(body); }
                break;
            }
        }
    }
    private static void InitializeSelect(WDoc wd, WNode n, Control c) {
        string opts = "";
        int selIdx = 0 - 1;
        int oi = 0;
        bool hasCustomVal = false;
        for (int i = 0; i < n.items.Count; i = i + 1) {
            WItem it = n.items[i];
            if (it.kid < 0 || it.kid >= wd.nodes.Count) { continue; }
            WNode cn = wd.nodes[it.kid];
            if (cn.tag != "option") { continue; }
            string vAttr = HtmlText.NodeAttr(cn.attrs, "value");
            if (vAttr != "") { hasCustomVal = true; break; }
        }
        if (hasCustomVal) {
            JsonValue arr = JsonValue.NewArray();
            for (int i = 0; i < n.items.Count; i = i + 1) {
                WItem it = n.items[i];
                if (it.kid < 0 || it.kid >= wd.nodes.Count) { continue; }
                WNode cn = wd.nodes[it.kid];
                if (cn.tag != "option") { continue; }
                string ot = cn.text;
                if (ot == "") {
                    for (int k = 0; k < cn.items.Count; k = k + 1) {
                        WItem cit = cn.items[k];
                        if (cit.kid >= 0 || cit.text == "") { continue; }
                        ot = ot + cit.text;
                    }
                }
                ot = ot.Trim();
                string valAttr = HtmlText.NodeAttr(cn.attrs, "value");
                if (valAttr == "") { valAttr = ot; }
                for (int q = 0; q < cn.attrs.Count; q = q + 1) {
                    if (cn.attrs[q].name == "selected") { selIdx = oi; }
                }
                JsonValue optObj = JsonValue.NewObject();
                optObj.Set("label", JsonValue.NewStr(ot));
                optObj.Set("value", JsonValue.NewStr(valAttr));
                arr.Append(optObj);
                oi = oi + 1;
            }
            if (arr.Count() > 0) { c.SetProp("options", arr.ToJson()); }
        } else {
            for (int i = 0; i < n.items.Count; i = i + 1) {
                WItem it = n.items[i];
                if (it.kid < 0 || it.kid >= wd.nodes.Count) { continue; }
                WNode cn = wd.nodes[it.kid];
                if (cn.tag != "option") { continue; }
                string ot = cn.text;
                if (ot == "") {
                    for (int k = 0; k < cn.items.Count; k = k + 1) {
                        WItem cit = cn.items[k];
                        if (cit.kid >= 0 || cit.text == "") { continue; }
                        ot = ot + cit.text;
                    }
                }
                ot = ot.Trim();
                for (int q = 0; q < cn.attrs.Count; q = q + 1) {
                    if (cn.attrs[q].name == "selected") { selIdx = oi; }
                }
                if (ot != "") {
                    if (oi > 0) { opts = opts + "|"; }
                    opts = opts + ot;
                }
                oi = oi + 1;
            }
            if (opts != "") { c.SetProp("options", opts); }
        }
        if (selIdx < 0 && (opts != "" || hasCustomVal)) { selIdx = 0; }
        if (selIdx >= 0) { c.SetProp("selected", Convert.ToString(selIdx)); }
    }
}
