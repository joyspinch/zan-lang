using System;
namespace Gui.Markup;
public class HtmlScope {
    public static string Styles(string css, string zs) {
        return StylesDepth(css, zs, 0);
    }
    private static string StylesDepth(string css, string zs, int depth) {
        if (css == null || css == "") { return ""; }
        if (zs == null || zs == "" || depth >= 32) { return css; }
        int n = css.Length;
        StringBuilder outp = new StringBuilder();
        int i = 0;
        while (i < n) {
            if (i + 1 < n && css.Substring(i, 2) == "/*") {
                int e = FindFrom(css, "*/", i + 2);
                int stop = e < 0 ? n : e + 2;
                outp.Append(css.Substring(i, stop - i));
                i = stop;
                continue;
            }
            if ((css[i] & 255) == 64) {
                i = ScopeAtDepth(css, i, zs, outp, depth);
                continue;
            }
            int b = i;
            bool real = false;
            bool atStart = false;
            while (b < n) {
                b = SkipNoise(css, b);
                if (b >= n) { break; }
                int cb = css[b] & 255;
                if (cb == 123 || cb == 59 || cb == 125) { break; }
                if (cb == 64 && !real) { atStart = true; break; }
                if (cb != 32 && cb != 9 && cb != 13 && cb != 10) { real = true; }
                b = b + 1;
            }
            if (b >= n) { outp.Append(css.Substring(i)); break; }
            if (atStart) {
                outp.Append(css.Substring(i, b - i));
                i = b;
                continue;
            }
            if ((css[b] & 255) != 123) {
                outp.Append(css.Substring(i, b + 1 - i));
                i = b + 1;
                continue;
            }
            outp.Append(ScopePrelude(css.Substring(i, b - i), zs));
            int close = MatchBrace(css, b);
            if (close < 0) { outp.Append(css.Substring(b)); break; }
            outp.Append(css.Substring(b, close + 1 - b));
            i = close + 1;
        }
        return outp.ToString();
    }
    public static int ScopeAt(string css, int i, string zs, StringBuilder outp) {
        return ScopeAtDepth(css, i, zs, outp, 0);
    }
    private static int ScopeAtDepth(string css, int i, string zs, StringBuilder outp, int depth) {
        if (css == null || i < 0 || i >= css.Length) { return css != null ? css.Length : 0; }
        int n = css.Length;
        int k = i + 1;
        while (k < n && NameByte(css[k] & 255)) { k = k + 1; }
        string atName = css.Substring(i + 1, k - i - 1).ToLower();
        int j = k;
        int parenDepth = 0;
        while (j < n) {
            j = SkipNoise(css, j);
            if (j >= n) { break; }
            int cj = css[j] & 255;
            if (cj == 40) { parenDepth = parenDepth + 1; }
            else if (cj == 41) {
                if (parenDepth > 0) { parenDepth = parenDepth - 1; }
            } else if (parenDepth == 0 && (cj == 123 || cj == 59)) {
                break;
            }
            j = j + 1;
        }
        if (j >= n) { outp.Append(css.Substring(i)); return n; }
        if ((css[j] & 255) == 59) {
            outp.Append(css.Substring(i, j + 1 - i));
            return j + 1;
        }
        int close = MatchBrace(css, j);
        if (close < 0) { outp.Append(css.Substring(i)); return n; }
        if (atName == "media" || atName == "supports") {
            outp.Append(css.Substring(i, j + 1 - i));
            outp.Append(StylesDepth(css.Substring(j + 1, close - j - 1), zs, depth + 1));
            outp.Append("}");
        } else {
            outp.Append(css.Substring(i, close + 1 - i));
        }
        return close + 1;
    }
    public static string ScopePrelude(string sel, string zs) {
        if (sel == null) { return ""; }
        if (zs == null || zs == "") { return sel; }
        List<string> parts = new List<string>();
        int n = sel.Length;
        int start = 0;
        int i = 0;
        while (i < n) {
            i = SkipNoise(sel, i);
            if (i >= n) { break; }
            int c = sel[i] & 255;
            if (c == 40 || c == 91) {
                int close = MatchChunk(sel, i);
                i = close < 0 ? n : close + 1;
                continue;
            }
            if (c == 44) {
                parts.Add(sel.Substring(start, i - start));
                start = i + 1;
            }
            i = i + 1;
        }
        parts.Add(sel.Substring(start));
        string outp = "";
        for (int p = 0; p < parts.Count; p = p + 1) {
            if (p > 0) { outp = outp + ","; }
            outp = outp + ScopeOne(parts[p].Trim(), zs);
        }
        return outp;
    }
    public static string ScopeOne(string piece, string zs) {
        if (piece == null) { return ""; }
        if (zs == null || zs == "") { return piece; }
        List<string> outp = new List<string>();
        string cur = "";
        string pend = "";
        int n = piece.Length;
        int i = 0;
        while (i < n) {
            int j = SkipNoise(piece, i);
            if (j > i) { i = j; continue; }
            int c = piece[i] & 255;
            if (c == 32 || c == 9 || c == 13 || c == 10) {
                if (cur != "" && pend == "") { pend = " "; }
                i = i + 1;
                continue;
            }
            if (c == 62) {
                pend = ">";
                i = i + 1;
                continue;
            }
            if (c == 43) {
                pend = "+";
                i = i + 1;
                continue;
            }
            if (c == 126) {
                pend = "~";
                i = i + 1;
                continue;
            }
            if (c == 123 || c == 125 || c == 59) {
                break;  // 防御：块边界终止 piece（正常到不了这里）
            }
            if (cur != "" && pend != "") {
                outp.Add(ScopeCompound(cur, zs));
                outp.Add(pend);
                cur = "";
                pend = "";
            }
            if (c == 40 || c == 91 || c == 34 || c == 39) {
                int close = MatchChunk(piece, i);
                int stop = close < 0 ? n : close + 1;
                cur = cur + piece.Substring(i, stop - i);
                i = stop;
                continue;
            }
            cur = cur + piece.Substring(i, 1);
            i = i + 1;
        }
        if (cur != "" || outp.Count == 0) { outp.Add(ScopeCompound(cur, zs)); }
        string s = "";
        for (int k = 0; k < outp.Count; k = k + 1) { s = s + outp[k]; }
        return s;
    }
    public static string ScopeCompound(string chunk, string zs) {
        if (chunk == null || chunk == "") { return ""; }
        if (zs == null || zs == "") { return chunk; }
        if (chunk == ":root") { return chunk; }
        if (HasClsToken(chunk, zs)) { return chunk; }
        int at = 0 - 1;
        int n = chunk.Length;
        int i = 0;
        while (i < n) {
            int j = SkipNoise(chunk, i);
            if (j > i) { i = j; continue; }
            int c = chunk[i] & 255;
            if (c == 58 || c == 91) { at = i; break; }
            if (c == 40) {
                int close = MatchChunk(chunk, i);
                if (close < 0) { i = n; break; }
                i = close + 1;
                continue;
            }
            i = i + 1;
        }
        if (at < 0) { at = n; }
        string ins = at == 0 ? "*." + zs : "." + zs;
        return chunk.Substring(0, at) + ins + chunk.Substring(at);
    }
    public static int SkipNoise(string s, int i) {
        if (s == null) { return 0; }
        if (i < 0) { i = 0; }
        int n = s.Length;
        while (i < n) {
            if (i + 1 < n && s.Substring(i, 2) == "/*") {
                int e = FindFrom(s, "*/", i + 2);
                i = e < 0 ? n : e + 2;
                continue;
            }
            int c = s[i] & 255;
            if (c == 34 || c == 39) {
                int q = MatchChunk(s, i);
                i = q < 0 ? n : q + 1;
                continue;
            }
            break;
        }
        return i;
    }
    public static int MatchChunk(string s, int open) {
        if (s == null || open < 0 || open >= s.Length) { return 0 - 1; }
        int o = s[open] & 255;
        if (o == 34 || o == 39) {
            int n2 = s.Length;
            int i2 = open + 1;
            while (i2 < n2) {
                int c2 = s[i2] & 255;
                if (c2 == 92) { i2 = i2 + 2; continue; }
                if (c2 == o) { return i2; }
                i2 = i2 + 1;
            }
            return 0 - 1;
        }
        int cl = o == 40 ? 41 : 93;
        int depth = 0;
        int n = s.Length;
        int i = open + 1;
        while (i < n) {
            i = SkipNoise(s, i);
            if (i >= n) { return 0 - 1; }
            int c = s[i] & 255;
            if (c == 34 || c == 39) {
                int q = MatchChunk(s, i);
                i = q < 0 ? n : q + 1;
                continue;
            }
            if (c == o) { depth = depth + 1; }
            else if (c == cl) {
                if (depth == 0) { return i; }
                depth = depth - 1;
            }
            i = i + 1;
        }
        return 0 - 1;
    }
    public static int MatchBrace(string s, int open) {
        if (s == null || open < 0 || open >= s.Length) { return 0 - 1; }
        int depth = 0;
        int n = s.Length;
        int i = open;
        while (i < n) {
            i = SkipNoise(s, i);
            if (i >= n) { return 0 - 1; }
            int c = s[i] & 255;
            if (c == 123) { depth = depth + 1; }
            else if (c == 125) {
                depth = depth - 1;
                if (depth == 0) { return i; }
            }
            i = i + 1;
        }
        return 0 - 1;
    }
    public static bool HasClsToken(string chunk, string zs) {
        if (chunk == null || zs == null || zs == "") { return false; }
        string needle = "." + zs;
        int n = chunk.Length;
        int m = needle.Length;
        for (int k = 0; k + m <= n; k = k + 1) {
            if (!StartsWithAt(chunk, k, needle)) { continue; }
            if (k + m >= n) { return true; }
            int c = chunk[k + m] & 255;
            if (!NameByte(c)) { return true; }
        }
        return false;
    }
    public static int FindFrom(string s, string needle, int start) {
        if (s == null || needle == null) { return 0 - 1; }
        if (start < 0) { start = 0; }
        if (start > s.Length) { return 0 - 1; }
        return s.IndexOf(needle, start);
    }
    public static bool StartsWithAt(string s, int at, string needle) {
        if (s == null || needle == null || at < 0) { return false; }
        int m = needle.Length;
        if (at + m > s.Length) { return false; }
        return s.IndexOf(needle, at) == at;
    }
    public static bool NameByte(int v) {
        return (v >= 48 && v <= 57) || (v >= 65 && v <= 90)
            || (v >= 97 && v <= 122) || v == 45 || v == 95;
    }
    public static bool NameChar(string c) {
        if (c == null || c.Length != 1) { return false; }
        return NameByte(c[0] & 255);
    }
}
