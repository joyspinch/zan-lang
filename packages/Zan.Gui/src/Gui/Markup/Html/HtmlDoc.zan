using System;
using System.Collections.Generic;
using Gui;
namespace Gui;
public class HtmlDoc {
    Control root;
    string css;
    int gen;  // style 属性合成类的计数器（zgen-N）
    WDoc src;
    List<Control> built;
    string sizeClass;
    Control Get(string id) {
        if (root == null || id == null || id == "") { return null; }
        return root.Find(id);
    }
}
