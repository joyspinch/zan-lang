using System;
using System.Diagnostics;
using System.IO;
using System.Json;
using Gui.Markup;
using Gui.Widget;
using Gui.Backend;
namespace Gui;
internal delegate HtmlDoc WindowDocumentLoader(string html);
public partial class Html {
    private static bool loaderInstalled;
    private static ControlFactoryFn cloneFallback;
    internal static void SetCloneFallback(ControlFactoryFn fn) {
        if (fn != null) { cloneFallback = fn; }
    }
    public static void Install() {
        Html.InstallDocument();
        ImageHttp.Install();
    }
    internal static void InstallDocument() {
        if (loaderInstalled) { return; }
        loaderInstalled = true;
        App.SetLinkScanner(AutoLinkTree);
        Element.SetTipPainter(Html.PaintTip);
        App.SetCloneTree(Html.Clone);
    }
    public static Control Load(App app, string html) { return Html.Load(app, html, null, ""); }
    public static Control Load(App app, string html, HtmlHandlers handlers,
                              string baseDir) {
        return Html.ApplyDocument(app, Html.Parse(html, baseDir, handlers));
    }
    public static Control LoadWith(App app, string html, HtmlHandlers handlers,
                                   string baseDir, ControlFactoryFn factory) {
        return Html.ApplyDocument(app, Html.ParseWith(html, baseDir, handlers, factory));
    }
    private static Control ApplyDocument(App app, HtmlDoc doc) {
        string zs = app.NextLoadScope();
        string scoped = doc.css == "" ? "" : HtmlScope.Styles(doc.css, zs);
        app.ApplyScopedTree(doc.root, scoped, zs);
        Html.AutoLinkTree(doc.root, app);
        return doc.root;
    }

    // ---- <include> 组合（B-ID149②）：把一个窗口拆成多份 html 复用 ----
    //
    // html 是数据：组合发生在装载期，`<include src="Views/Nav.html" />`
    // 装载前展开为被引文件内容（整文档取 body 内层，片段原样），递归
    // 展开（深度 8 封顶防环）。查找口与窗口文档同源（HtmlDocs.Read：
    // 工程根直引 → 裸名 → src/），发布态走同一份内嵌 VFS。注释、
    // <style>、<script> 内不展开——那里出现 include 字样是文案不是
    // 组合指令。

    public static string ExpandIncludes(string html, int depth) {
        return Html.ExpandIncludes(html, depth, HtmlDocs.Read);
    }
    private static string ExpandIncludes(string html, int depth, Func<string, string> readInclude) {
        if (depth > 8) { return html; }
        string outp = "";
        int i = 0;
        while (i < html.Length) {
            int nxt = i;
            int kind = 0;   // 0 文本尾, 1 include, 2 注释, 3 style/script
            int scan = i;
            while (scan < html.Length) {
                if (html[scan] != 60) { scan = scan + 1; continue; }   // '<'
                if (html.IndexOf("<!--", scan) == scan) {
                    nxt = html.IndexOf("-->", scan + 4);
                    kind = 2;
                    break;
                }
                if (html.IndexOf("<include", scan) == scan) {
                    nxt = scan;
                    kind = 1;
                    break;
                }
                if (html.IndexOf("<style", scan) == scan || html.IndexOf("<script", scan) == scan) {
                    int nameEnd = html.IndexOf(">", scan);
                    if (nameEnd < 0) { nxt = html.Length; kind = 3; break; }
                    string tag = html.Substring(scan + 1, nameEnd - scan - 1).Trim();
                    string close = "</" + tag.Split(" ")[0] + ">";
                    int ce = html.IndexOf(close, nameEnd);
                    nxt = ce < 0 ? html.Length : ce + close.Length;
                    kind = 3;
                    break;
                }
                scan = scan + 1;
            }
            if (kind == 0 || nxt < i || (kind != 1 && nxt == i)) {
                outp = outp + html.Substring(i);
                break;
            }
            if (kind != 1) {
                outp = outp + html.Substring(i, nxt - i);
                i = nxt;
                continue;
            }
            int lt = nxt;
            int gt = html.IndexOf(">", lt);
            if (gt < 0) {
                outp = outp + html.Substring(i);
                break;
            }
            string srcVal = Html.IncludeSrc(html.Substring(lt, gt - lt + 1));
            outp = outp + html.Substring(i, lt - i);
            if (srcVal == "") {
                Console.WriteLine("HTML include without src");
            } else {
                string frag = readInclude(srcVal);
                if (frag == null) {
                    Console.WriteLine("HTML include not found: " + srcVal);
                } else {
                    outp = outp + Html.ExpandIncludes(Html.BodyInner(frag), depth + 1, readInclude);
                }
            }
            i = gt + 1;
        }
        return outp;
    }
    public static string IncludeSrc(string tag) {
        int a = tag.IndexOf("src=");
        if (a < 0) { return ""; }
        int vs = a + 4;
        if (vs >= tag.Length) { return ""; }
        char q = tag[vs];
        if (q == 34 || q == 39) {
            int ve = tag.IndexOf(q, vs + 1);
            if (ve < 0) { return ""; }
            return tag.Substring(vs + 1, ve - vs - 1).Trim();
        }
        int e = vs;
        while (e < tag.Length) {
            char ch = tag[e];
            if (ch == 32 || ch == 62 || ch == 47) { break; }
            e = e + 1;
        }
        return tag.Substring(vs, e - vs).Trim();
    }
    public static string BodyInner(string html) {
        int bs = html.IndexOf("<body");
        if (bs < 0) { return html; }
        int contentStart = html.IndexOf(">", bs);
        int be = html.IndexOf("</body>", contentStart);
        if (contentStart < 0 || be < 0) { return html; }
        return html.Substring(contentStart + 1, be - contentStart - 1);
    }
    internal static HtmlDoc ParseComponent(string html) { return Html.Parse(html, "", null); }
    public static HtmlDoc Parse(string html, string baseDir, HtmlHandlers handlers) {
        Html.Install();
        Html.SetCloneFallback(ControlFactory.Create);
        return Html.ParseDocument(html, baseDir, handlers, ControlFactory.Create, HtmlDocs.Read);
    }
    public static HtmlDoc ParseWith(string html, string baseDir, HtmlHandlers handlers,
                                    ControlFactoryFn factory) {
        if (factory == null) { throw new ArgumentNullException("factory"); }
        return Html.ParseDocument(html, baseDir, handlers, factory, HtmlDocs.Read);
    }
    internal static HtmlDoc ParseEmbedded(string document, ControlFactoryFn factory) {
        if (factory == null) { throw new ArgumentNullException("factory"); }
        return Html.ParseDocument(Html.ReadEmbeddedDoc(document), "", null, factory,
                                  Html.ReadEmbeddedDoc);
    }
    private static string ReadEmbeddedDoc(string path) {
        if (!File.EmbedExists(path)) {
            throw new FileNotFoundException("Embedded window document not found: " + path);
        }
        return File.ReadAllText(path);
    }
    private static HtmlDoc ParseDocument(string html, string baseDir, HtmlHandlers handlers,
                                          ControlFactoryFn factory,
                                          Func<string, string> readInclude) {
        Html.InstallDocument();
        html = Html.ExpandIncludes(html, 0, readInclude);
        WDoc wd = HtmlParser.Parse(html, baseDir);
        HtmlDoc doc = new HtmlDoc();
        doc.css = wd.css;
        doc.gen = 0;
        string sizeClass = "";
        bool designFields = false;
        for (int i = 0; i < wd.nodes.Count; i = i + 1) {
            if (wd.nodes[i].tag != "body") { continue; }
            for (int j = 0; j < wd.nodes[i].attrs.Count; j = j + 1) {
                if (wd.nodes[i].attrs[j].name == "data-zan-design") { designFields = true; }
            }
        }
        for (int i = 0; i < wd.nodes.Count; i = i + 1) {
            string fs = HtmlText.NodeAttr(wd.nodes[i].attrs, "data-form-size");
            if (fs == "0") { sizeClass = "large"; break; }
            if (fs == "2") { sizeClass = "small"; break; }
        }
        doc.sizeClass = sizeClass;
        List<Control> built = new List<Control>();
        for (int i = 0; i < wd.nodes.Count; i = i + 1) {
            built.Add(Html.BuildNode(wd, wd.nodes[i], doc, handlers, factory));
        }
        bool[] consumed = new bool[wd.nodes.Count];
        for (int i = 0; i < wd.nodes.Count; i = i + 1) {
            if (consumed[i]) { continue; }
            WNode n = wd.nodes[i];
            Control c = built[i];
            FbFlow fieldFlow = null;
            for (int k = 0; k < n.items.Count; k = k + 1) {
                WItem it = n.items[k];
                if (it.kid < 0) {
                    if (it.text.Trim() != "") { fieldFlow = null; }
                    Html.AddDocumentText(c, it.text);
                } else {
                    WNode kidNode = wd.nodes[it.kid];
                    if (!(c is Element) && IsMetaChild(n.tag, kidNode.tag)) {
                        fieldFlow = null;
                        consumed[it.kid] = Html.AddMetaChild(c, kidNode, built[it.kid], built);
                        continue;
                    }
                    Control kidCtl = built[it.kid];
                    if (designFields) { fieldFlow = Html.AddFieldChild(c, kidCtl, kidNode, fieldFlow); }
                    else { Html.AddChild(c, kidCtl); }
                }
            }
        }
        doc.root = built.Count > 0 ? built[0] : null;
        doc.src = wd;
        doc.built = built;
        return doc;
    }
    private static void AddDocumentText(Control c, string text) {
        if (c is Element) {
            ((Element)c).AddText(text);
            return;
        }
        string value = text.Trim();
        if (value == "") { return; }
        switch (c.Kind()) {
            case "TableCell": c.SetProp("text", value); break;
            case "TabPane":
            case "BreadcrumbItem":
                if (c.GetProp("text") == "") { c.SetProp("text", value); }
                break;
            case "TimelineItem":
                if (c.GetProp("title") == "") { c.SetProp("title", value); }
                break;
        }
    }
    private static bool AddMetaChild(Control parent, WNode node, Control child, List<Control> built) {
        string tag = node.tag;
        if (parent.Kind() == "Table" && (tag == "thead" || tag == "tbody" || tag == "tfoot")) {
            for (int i = 0; i < node.items.Count; i = i + 1) {
                int index = node.items[i].kid;
                if (index < 0) { continue; }
                Control row = built[index];
                if (tag == "thead" && row.Kind() == "TableRow") { row.SetProp("header", "true"); }
                Html.AddChild(parent, row);
            }
        } else if (parent.Kind() == "Tabs" && (tag == "tab" || tag == "tab-pane" || tag == "tabpane")) {
            string title = HtmlText.NodeAttr(node.attrs, "title");
            if (title == "") { title = HtmlText.NodeAttr(node.attrs, "label"); }
            if (title == "") { title = HtmlText.NodeAttr(node.attrs, "name"); }
            if (parent.MountDocumentPane(child, title)) { return false; }
            for (int i = 0; i < node.items.Count; i = i + 1) {
                int index = node.items[i].kid;
                if (index < 0) { continue; }
                Control content = built[index];
                if (content.slotName == "" && title != "") { content.slotName = title; }
                Html.AddChild(parent, content);
            }
        }
        return true;
    }
    public static void ProjectBody(Control host, HtmlDoc doc) {
        Html.InstallDocument();
        if (host == null || doc == null || doc.root == null
            || doc.src == null || doc.built == null) { return; }
        WDoc wd = doc.src;
        if (wd.nodes.Count == 0) { return; }
        WNode body = wd.nodes[0];
        Control bodyCtl = doc.built[0];
        List<Control> kids = new List<Control>();
        for (int k = 0; k < body.items.Count; k = k + 1) {
            WItem it = body.items[k];
            if (it.kid < 0) {
                if (host is Element) { ((Element)host).AddText(it.text); }
                continue;
            }
            kids.Add(doc.built[it.kid]);
        }
        bodyCtl.RemoveAll();
        if (kids.Count == 0) { return; }
        for (int i = 0; i < kids.Count; i = i + 1) {
            Html.AddChild(host, kids[i]);
        }
    }
    public static bool HasSizeClass(string classes) {
        if (classes == null || classes == "") { return false; }
        List<string> xs = classes.Split(" ");
        for (int i = 0; i < xs.Count; i = i + 1) {
            string x = xs[i].Trim();
            if (x == "tiny" || x == "small" || x == "medium" || x == "large") { return true; }
        }
        return false;
    }
    public static void PaintTip(Control c, string tip) {
        App app = App.FrameApp();
        if (app == null || c == null) { return; }
        if (!c.IsHovered(app)) { return; }
        if (app.focus.HoveredMs() < Tooltip.DefaultDelayMs()) {
            app.RequestWakeFrameIn(80);
            return;
        }
        Tooltip.RequestBox(app, c.bx, c.by, c.bw, c.bh, tip,
            Tooltip.Bottom(), app.Scale(260));
    }
    public static void AddInlineCss(HtmlDoc doc, Control c, string decl) {
        if (c == null || decl == "") { return; }
        if (doc != null) {
            string gen = "zgen-" + Convert.ToString(doc.gen);
            doc.gen = doc.gen + 1;
            c.AddClass(gen);
            doc.css = doc.css + "." + gen + " { " + decl + " }\n";
        } else {
            c.inlineStyleCss = c.inlineStyleCss + "; " + decl;
        }
    }
    public static FbFlow AddFieldChild(Control parent, Control c, WNode node, FbFlow flow) {
        string spanText = HtmlText.NodeAttr(node.attrs, "data-span");
        string caption = HtmlText.NodeAttr(node.attrs, "data-label");
        string position = HtmlText.NodeAttr(node.attrs, "data-position");
        if (parent is Element || c is Element) {
            Html.AddChild(parent, c);
            return null;
        }
        Control host = parent;
        if (c.slotName != "") {
            Control slot = parent.NamedSlotHost(c.slotName);
            if (slot == null) {
                Html.AddChild(parent, c);
                return null;
            }
            host = slot;
        } else {
            Control slot = parent.NamedSlotHost("default");
            if (slot != null) { host = slot; }
        }
        if (position == "1" || position == "Float" || c.StylePosition() == 2
            || !Html.IsIntText(spanText)) {
            Html.AddChild(host, c);
            return null;
        }
        if (flow == null || flow.parent != host) {
            flow = new FbFlow();
            host.Add(flow);
        }
        int span = Convert.ToInt32(spanText);
        if (span < 1) { span = 1; }
        if (span > 24) { span = 24; }
        Control cell = c;
        string kind = c.Kind();
        if (caption != "" && kind != "Label" && kind != "Button"
            && kind != "Checkbox" && kind != "Radio" && kind != "RadioButton") {
            FbStack stack = new FbStack(caption);
            stack.Add(c);
            cell = stack;
        }
        flow.AddCell(cell, span);
        return flow;
    }
    public static void AddChild(Control parent, Control c) {
        if (c.slotName != "" && parent.MountSlot(c.slotName, c)) { return; }
        if (parent is Element) {
            ((Element)parent).AddKid(c);
            return;
        }
        parent.Add(c);
    }
    public static Control Clone(Control c) {
        Html.InstallDocument();
        if (c is Element) {
            Element src = (Element)c;
            Element el = new Element();
            el.InitElement(src.Kind(), src.name);
            el.CopyAttrsFrom(src);
            el.SetText(src.Text());
            el.Class = src.Class;
            el.prefW = src.prefW;
            el.prefH = src.prefH;
            if (src.bindings != null) {
                for (int bi = 0; bi < src.bindings.Count; bi = bi + 1) {
                    ModelBindingDeclaration binding = src.bindings[bi];
                    el.DeclareBinding(binding.path, binding.property, binding.twoWay);
                }
            }
            el.baseClass = src.baseClass;
            el.handlerArg = src.handlerArg;
            el.slotName = src.slotName;
            for (int ei = 0; ei < src.events.Count; ei = ei + 1) {
                el.SetHandler(src.events[ei].key, src.events[ei].val);
            }
            if (src.elOrder != null) {
                for (int i = 0; i < src.elOrder.Count; i = i + 1) {
                    FlowEntry o = src.elOrder[i];
                    if (o.kid != null) {
                        Control kid = Html.Clone(o.kid);
                        if (kid != null) { el.AddKid(kid); }
                    } else {
                        el.AddText(o.text);
                    }
                }
            } else {
                List<Control> kids = src.SnapshotChildren();
                for (int i = 0; i < kids.Count; i = i + 1) {
                    Control kid = Html.Clone(kids[i]);
                    if (kid != null) { el.AddKid(kid); }
                }
            }
            return el;
        }
        ControlFactoryFn factory = c.DocumentFactory();
        string kind = factory != null ? c.DocumentFactoryKind() : c.Kind();
        Control n = factory != null ? factory(kind) : c.CreateCloneShell();
        if (n == null && factory == null && cloneFallback != null) {
            n = cloneFallback(kind);
        }
        if (n == null) { return null; }
        n.SetDocumentFactory(factory, kind);
        List<PropSpec> ps = c.Props();
        for (int i = 0; i < ps.Count; i = i + 1) {
            n.SetProp(ps[i].key, c.GetProp(ps[i].key));
        }
        n.name = c.name;
        n.Class = c.Class;
        n.prefW = c.prefW;
        n.prefH = c.prefH;
        if (c.bindings != null) {
            for (int bi = 0; bi < c.bindings.Count; bi = bi + 1) {
                ModelBindingDeclaration binding = c.bindings[bi];
                n.DeclareBinding(binding.path, binding.property, binding.twoWay);
            }
        }
        n.baseClass = c.baseClass;
        n.handlerArg = c.handlerArg;
        n.slotName = c.slotName;
        for (int ei = 0; ei < c.events.Count; ei = ei + 1) {
            n.SetHandler(c.events[ei].key, c.events[ei].val);
        }
        c.CloneContentTo(n, Html.Clone);
        return n;
    }
    static ControlEvent WrapModifier(Action a, string mod) {
        bool hasStop = mod.IndexOf("stop") >= 0;
        bool hasEnter = mod.IndexOf("enter") >= 0;
        return (Control sender) => {
            App app = sender != null ? sender.FindApp() : App.FrameApp();
            if (hasEnter && app != null && app.window != null) {
                if (app.window.EventKeyCode() != 13) { return; }
            }
            if (hasStop && sender != null) { sender.StopPropagation(); }
            a();
        };
    }
    static ControlEvent WrapModifierArg(Action<string> a, string arg, string mod) {
        bool hasStop = mod.IndexOf("stop") >= 0;
        bool hasEnter = mod.IndexOf("enter") >= 0;
        string captured = arg;
        return (Control sender) => {
            App app = sender != null ? sender.FindApp() : App.FrameApp();
            if (hasEnter && app != null && app.window != null) {
                if (app.window.EventKeyCode() != 13) { return; }
            }
            if (hasStop && sender != null) { sender.StopPropagation(); }
            a(captured);
        };
    }
    public static void Wire(HtmlHandlers handlers, Control c, string evt,
                     string name) {
        Wire(handlers, c, evt, name, "");
    }
    public static void Wire(HtmlHandlers handlers, Control c, string evt,
                     string name, string mod) {
        if (evt == "") { return; }
        c.SetHandler(evt, name);
        if (handlers == null) { return; }
        Action a = handlers.Find(name);
        if (a != null) {
            if (mod == "") { c.BindEvent(evt, a); }
            else { c.BindEvent(evt, WrapModifier(a, mod)); }
        } else {
            Console.WriteLine("HTML_WIRE_WARN handler '" + name
                + "' not registered (" + evt + " on " + c.name + ")");
        }
    }
    public static void WireArg(HtmlHandlers handlers, Control c, string evt,
                        string name, string arg) {
        WireArg(handlers, c, evt, name, arg, "");
    }
    public static void WireArg(HtmlHandlers handlers, Control c, string evt,
                        string name, string arg, string mod) {
        if (evt == "") { return; }
        c.SetHandler(evt, name);
        c.handlerArg = arg;
        if (handlers == null) { return; }
        Action<string> a = handlers.FindArg(name);
        if (a == null) { return; }
        if (mod == "") {
            string captured = arg;
            c.BindEvent(evt, () => { a(captured); });
        } else {
            c.BindEvent(evt, WrapModifierArg(a, arg, mod));
        }
    }
    public static void AutoLink(Control c, App app) {
        if (app == null) { return; }
        if (!(c is Element)) { return; }
        string href = c.CssAttr("href");
        if (!Html.Navigable(href)) { return; }
        if (c.Click.Count() > 0) { return; }
        bool blank = c.CssAttr("target") == "_blank";
        c.BindEvent("Click", () => { Html.OpenLink(app, href, blank); });
    }
    public static void AutoLinkTree(Control root, App app) {
        Html.InstallDocument();
        if (root == null) { return; }
        Html.AutoLink(root, app);
        for (int i = 0; i < root.ChildCount(); i = i + 1) {
            Html.AutoLinkTree(root.ChildAt(i), app);
        }
    }
    public static bool Navigable(string href) {
        if (href == "") { return false; }
        string low = href.ToLower();
        return HtmlText.StartsWith(low, "http://")
            || HtmlText.StartsWith(low, "https://");
    }
    public static void OpenLink(App app, string url, bool newWindow) {
        if (!newWindow && linkNavigator != null) {
            linkNavigator(app, url);
            return;
        }
        Html.OpenInSystemBrowser(url);
    }
    public static void OpenInSystemBrowser(string url) { Process.OpenUrl(url); }
    static LinkNavigateFn linkNavigator;
    public static void SetLinkNavigator(LinkNavigateFn fn) { linkNavigator = fn; }
}
public delegate bool LinkNavigateFn(App app, string url);
