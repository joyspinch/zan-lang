using System;
using System.Collections.Generic;
using Gui;

namespace Gui;

// body 标签时包一层隐式 body（对齐 Chrome 的文档语义）。
public class HtmlDoc {
    Control root;
    string css;
    int gen;  // style 属性合成类的计数器（zgen-N）
    // 解析中间态（ProjectBody 设计半件直挂用）：节点模型与已建控件表。
    WDoc src;
    List<Control> built;
    string sizeClass;

    // 查找文档树中具有指定 id/name 的控件节点
    Control Get(string id) {
        if (root == null) { return null; }
        return root.Find(id);
    }
}
