using System;
using System.Diagnostics;
using System.Web;
// 控件映射用的是裸 Button/TextArea/Checkbox/Input/Image——这些类型在
// Gui.Widget 命名空间里，必须显式 import；不写的话只靠 binder 的全局
// 唯一简单名兜底才能编过，一旦用户项目定义了同名全局类（如 class
// TextArea）这里就会编译报错。
using Gui.Widget;
// 链接的系统浏览器回落通道（ShellOpenUrl）在 Gui.Backend。
using Gui.Backend;

namespace Gui;

// WEB_GUI_ROADMAP P5：HTML 声明层的 Gui 侧——把 System.Web.HtmlParser
// 的声明记录构建成控件树。解析/空白/实体/记录全在纯层（Designer
// 导入也吃同一份记录，设计器与运行期同构）；本文件只负责
// tag→控件映射与属性协议（事件接线、绑定路径、样式类）。
// // tag 映射：容器 tag → Element（UA 样式表给 web 缺省语义），
// img → Image；select 等未映射 tag 落 Element 占位。
// // 属性协议：id → 选择器名（nodeName），class → AddClass，
// style → 合成 .zgen-N 规则（复用整套级联与 !important 机制），
// data-on-<evt>="名" 经 HtmlHandlers 注册表接 BindEvent，
// data-bind → bindPath，data-if → bindIf。其余属性（Element 进
// 原始属性表；真控件忽略）。
// // 与 App 的解耦（auto-stdlib 按需拉取，活名才入编译图）：契约类型
// HtmlDoc/HtmlHandlers 在 Gui.HtmlApi（App.LoadHtml 的签名只背它们），
// 装载实现在本文件，经 <see cref="Install"/> 注册进 App 的装载槽。
// 只经 `app.LoadHtml(...)` 用 HTML 的宿主需在启动时调用一次 Install；
// 拼写了任何 Html.* 构建入口的程序会被自动安装。不安装的程序
// App 编译图不背解析器/渲染器/System.Web。
public class Html {
    static bool loaderInstalled;

    // 向 App 注册 HTML 装载与链接扫描实现（App.LoadHtmlWith 的
    // 后端、ChildWindow.WireNode 的扫描通道），并补齐 Element 的
    // title 提示、模板行克隆与远端图片三个通道。
    static void Install() {
        if (loaderInstalled) { return; }
        loaderInstalled = true;
        ControlBootstrap.Install();
        App.SetHtmlLoader(LoadForApp);
        App.SetLinkScanner(AutoLinkTree);
        Element.SetTipPainter(Html.PaintTip);
        App.SetCloneTree(Html.Clone);
        ImageHttp.Install();
    }

    static Control LoadForApp(App app, string html, HtmlHandlers handlers,
                              string baseDir) {
        HtmlDoc doc = Html.Parse(html, baseDir, handlers);
        string zs = app.NextLoadScope();
        string scoped = doc.css == "" ? "" : HtmlScope.Styles(doc.css, zs);
        app.ApplyScopedTree(doc.root, scoped, zs);
        App.AutoLinkTree(doc.root, app);
        return doc.root;
    }

    // 解析 `html`（整文档或片段）并建树。`baseDir` 是 `<link>`
    // 相对路径的基目录（空 = 不解析 link）。`handlers` 可为 null。
    static HtmlDoc Parse(string html, string baseDir, HtmlHandlers handlers) {
        Install();
        WDoc wd = HtmlParser.Parse(html, baseDir);
        HtmlDoc doc = new HtmlDoc();
        doc.css = wd.css;
        doc.gen = 0;
        List<Control> built = new List<Control>();
        for (int i = 0; i < wd.nodes.Count; i = i + 1) {
            built.Add(Html.Build(wd, wd.nodes[i], doc, handlers));
        }
        // 装配：逐父按 items 文档序走一遍——AddText 与 AddChild 的
        // 交错顺序就是 HTML 的行内内容顺序（混排行盒依赖）。
        for (int i = 0; i < wd.nodes.Count; i = i + 1) {
            WNode n = wd.nodes[i];
            Control c = built[i];
            if (n.tag == "tab" || n.tag == "tab-pane" || n.tag == "tabpane" || n.tag == "option") {
                continue;
            }
            for (int k = 0; k < n.items.Count; k = k + 1) {
                WItem it = n.items[k];
                if (it.kid < 0) {
                    // 真控件下的游离文本无处安放（映射控件的文本走
                    // 自己的协议——button 吃捕获文本）
                    if (c is Element) {
                        ((Element)c).AddText(it.text);
                        if (it.text.IndexOf("{{") >= 0 && c.bindTpl == "") {
                            c.bindTpl = it.text;
                        }
                    }
                } else {
                    WNode kidNode = wd.nodes[it.kid];
                    if (IsMetaChild(n.tag, kidNode.tag)) {
                        // 若父容器是 Tabs 且子项是 tab/tab-pane 元节点，把 tab 内部的子控件转挂到对应标签页
                        if (c is Tabs && (kidNode.tag == "tab" || kidNode.tag == "tab-pane" || kidNode.tag == "tabpane")) {
                            string tTitle = HtmlText.NodeAttr(kidNode.attrs, "title");
                            if (tTitle == "") { tTitle = HtmlText.NodeAttr(kidNode.attrs, "label"); }
                            if (tTitle == "") { tTitle = HtmlText.NodeAttr(kidNode.attrs, "name"); }
                            for (int ti = 0; ti < kidNode.items.Count; ti = ti + 1) {
                                WItem tit = kidNode.items[ti];
                                if (tit.kid >= 0) {
                                    Control grandKid = built[tit.kid];
                                    if (grandKid != null) {
                                        if (grandKid.slotName == "" && tTitle != "") {
                                            grandKid.slotName = tTitle;
                                        }
                                        Html.AddChild(c, grandKid);
                                    }
                                }
                            }
                        }
                        continue;
                    }
                    Html.AddChild(c, built[it.kid]);
                }
            }
        }
        doc.root = built.Count > 0 ? built[0] : null;
        return doc;
    }

    // 一条记录 → 一个控件（构造 + 属性协议）。容器自己的文本不在这
    // 里加——装配阶段按 items 文档序与子控件交错加入。
    static Control Build(WDoc wd, WNode n, HtmlDoc doc, HtmlHandlers handlers) {
        Install();
        string tag = n.tag;
        string id = HtmlText.NodeAttr(n.attrs, "id");
        string type = HtmlText.NodeAttr(n.attrs, "type").ToLower();
        Control c = null;

        switch (tag) {
            case "label": {
                // 与设计器导入路径 TagKind("label")→Label 同语义（A546①）：
                // 普通路径此前建成裸 Element，无 display 归类，文字一字不画。
                // 文本三通道：设计稿 data-label / 精确文本 data-text / 正文。
                Label lb = new Label();
                string lt = HtmlText.NodeAttr(n.attrs, "data-label");
                if (lt == "") { lt = HtmlText.NodeAttr(n.attrs, "data-text"); }
                if (lt == "") { lt = n.text; }
                lb.InitLabel(lt);
                c = lb;
                break;
            }
            case "button": {
                Button b = new Button();
                b.InitButton(n.text);
                c = b;
                break;
            }
            case "textarea": {
                TextArea ta = new TextArea();
                ta.InitTextArea(new SignalString(n.text), "");
                c = ta;
                break;
            }
            case "input": {
                if (type == "checkbox") {
                    Checkbox cb = new Checkbox();
                    cb.InitCheckbox("", new SignalBool(false));
                    c = cb;
                } else if (type == "radio") {
                    Radio rb = new Radio();
                    c = rb;
                } else if (type == "number") {
                    InputNumber inpn = new InputNumber();
                    c = inpn;
                } else if (type == "range") {
                    Slider sl = new Slider();
                    c = sl;
                } else if (type == "color") {
                    ColorPicker cp = new ColorPicker();
                    c = cp;
                } else if (type == "date" || type == "datetime-local") {
                    DatePicker dp = new DatePicker();
                    c = dp;
                } else {
                    Input inp = new Input();
                    inp.InitInput(
                        new SignalString(HtmlText.NodeAttr(n.attrs, "value")),
                        HtmlText.NodeAttr(n.attrs, "placeholder"));
                    if (type == "password") {
                        inp.SetProp("password", "true");
                    }
                    c = inp;
                }
                break;
            }
            case "img": {
                Image img = new Image();
                img.InitImage(HtmlText.NodeAttr(n.attrs, "src"),
                              HtmlText.NodeAttr(n.attrs, "alt"),
                              "cover");
                c = img;
                break;
            }
            case "select": {
                SelectBox sb = new SelectBox();
                string opts = "";
                int selIdx = 0 - 1;
                int oi = 0;
                bool hasCustomVal = false;
                for (int i = 0; i < n.items.Count; i = i + 1) {
                    WItem it = n.items[i];
                    if (it.kid < 0) { continue; }
                    WNode cn = wd.nodes[it.kid];
                    if (cn.tag != "option") { continue; }
                    string vAttr = HtmlText.NodeAttr(cn.attrs, "value");
                    if (vAttr != "") { hasCustomVal = true; break; }
                }
                if (hasCustomVal) {
                    JsonValue arr = JsonValue.NewArray();
                    for (int i = 0; i < n.items.Count; i = i + 1) {
                        WItem it = n.items[i];
                        if (it.kid < 0) { continue; }
                        WNode cn = wd.nodes[it.kid];
                        if (cn.tag != "option") { continue; }
                        string ot = cn.text;
                        if (ot == "") {
                            for (int k = 0; k < cn.items.Count; k = k + 1) {
                                WItem cit = cn.items[k];
                                if (cit.kid >= 0 || cit.text == "") { continue; }
                                ot = ot + cit.text;
                            }
                        }
                        ot = ot.Trim();
                        string valAttr = HtmlText.NodeAttr(cn.attrs, "value");
                        if (valAttr == "") { valAttr = ot; }
                        for (int q = 0; q < cn.attrs.Count; q = q + 1) {
                            if (cn.attrs[q].name == "selected") { selIdx = oi; }
                        }
                        JsonValue optObj = JsonValue.NewObject();
                        optObj.Set("label", JsonValue.NewStr(ot));
                        optObj.Set("value", JsonValue.NewStr(valAttr));
                        arr.Append(optObj);
                        oi = oi + 1;
                    }
                    if (arr.Count() > 0) {
                        sb.SetProp("options", arr.ToJson());
                    }
                } else {
                    for (int i = 0; i < n.items.Count; i = i + 1) {
                        WItem it = n.items[i];
                        if (it.kid < 0) { continue; }
                        WNode cn = wd.nodes[it.kid];
                        if (cn.tag != "option") { continue; }
                        string ot = cn.text;
                        if (ot == "") {
                            for (int k = 0; k < cn.items.Count; k = k + 1) {
                                WItem cit = cn.items[k];
                                if (cit.kid >= 0 || cit.text == "") { continue; }
                                ot = ot + cit.text;
                            }
                        }
                        ot = ot.Trim();
                        for (int q = 0; q < cn.attrs.Count; q = q + 1) {
                            if (cn.attrs[q].name == "selected") { selIdx = oi; }
                        }
                        if (ot != "") {
                            if (oi > 0) { opts = opts + "|"; }
                            opts = opts + ot;
                        }
                        oi = oi + 1;
                    }
                    if (opts != "") { sb.SetProp("options", opts); }
                }
                if (selIdx < 0 && (opts != "" || hasCustomVal)) { selIdx = 0; }
                if (selIdx >= 0) { sb.Select(selIdx); }
                c = sb;
                break;
            }
            case "progress":
            case "zan-progress": {
                Progress p = new Progress();
                string maxVal = HtmlText.NodeAttr(n.attrs, "max");
                if (maxVal != "") { p.SetProp("max", maxVal); }
                string curVal = HtmlText.NodeAttr(n.attrs, "value");
                if (curVal != "") { p.SetProp("value", curVal); }
                c = p;
                break;
            }
            case "tabs":
            case "tab-control":
            case "zan-tabs": {
                Tabs tb = new Tabs();
                string opts = "";
                for (int i = 0; i < n.items.Count; i = i + 1) {
                    WItem it = n.items[i];
                    if (it.kid < 0) { continue; }
                    WNode cn = wd.nodes[it.kid];
                    if (cn.tag != "tab" && cn.tag != "tab-pane" && cn.tag != "tabpane") { continue; }
                    string tTitle = HtmlText.NodeAttr(cn.attrs, "title");
                    if (tTitle == "") { tTitle = HtmlText.NodeAttr(cn.attrs, "label"); }
                    if (tTitle == "") { tTitle = HtmlText.NodeAttr(cn.attrs, "name"); }
                    if (tTitle == "") { tTitle = cn.text.Trim(); }
                    if (tTitle != "") {
                        if (opts != "") { opts = opts + "|"; }
                        opts = opts + tTitle;
                    }
                }
                if (opts != "") { tb.SetProp("options", opts); }
                c = tb;
                break;
            }
            default: {
                // 通用动态解析：优先通过 ControlFactory 与已注册组件族（ControlBootstrap,
                // DataTableBootstrap, ChartBootstrap 等）实例化，杜绝死硬编码
                string kind = TagToKind(tag);
                Control created = ControlFactory.Create(kind);
                if (created != null) {
                    c = created;
                } else {
                    Element el = new Element();
                    el.InitElement(tag, id);
                    for (int i = 0; i < n.attrs.Count; i = i + 1) {
                        el.SetAttr(n.attrs[i].name, n.attrs[i].val);
                    }
                    c = el;
                }
                break;
            }
        }
        // 真控件的 id 不进 nodeName（那是 Element 的），走选择器名
        if (id != "" && !(c is Element)) { c.SetProp("name", id); }
        // data-arg 预扫：属性顺序不保证（data-arg 可写在 data-on-*
        // 之后），先取出来供本节点全部事件共用；同时落 handlerArg
        // 字段，ChildWindow.WireNode 的二次接线同源。
        string darg = HtmlText.NodeAttr(n.attrs, "data-arg");
        if (darg != "") { c.handlerArg = darg; }
        if (n.text != "" && n.text.IndexOf("{{") >= 0 && c.bindTpl == "") {
            c.bindTpl = n.text;
        }
        // 属性协议（与 Designer 导入的建树代码同一套语义）
        for (int i = 0; i < n.attrs.Count; i = i + 1) {
            string k = n.attrs[i].name;
            string v = n.attrs[i].val;
            if (k == "id" || k == "type" || k == "value"
                || k == "placeholder" || k == "src" || k == "alt") {
                continue;   // 构造时已用
            }
            if (k == "class") {
                List<string> cs = HtmlText.SplitClass(v);
                for (int j = 0; j < cs.Count; j = j + 1) {
                    c.AddClass(cs[j]);
                }
                c.baseClass = c.Class;
                continue;
            }
            if (k == "style") {
                // 行内样式合成专属类规则，复用整套级联/!important 机制
                string gen = "zgen-" + Convert.ToString(doc.gen);
                doc.gen = doc.gen + 1;
                c.AddClass(gen);
                doc.css = doc.css + "." + gen + " { " + v + " }\n";
                continue;
            }
            if (k == "slot" || k == "data-slot") {
                c.slotName = v;
                continue;
            }
            if (k == "data-bind" || k == "z-model" || k == "v-model"
                || HtmlText.StartsWith(k, "v-model.") || HtmlText.StartsWith(k, "z-model.")
                || HtmlText.StartsWith(k, "data-bind.")) {
                c.bindPath = v;
                if (k.IndexOf(".lazy") >= 0) { c.bindLazy = true; }
                if (k.IndexOf(".number") >= 0) { c.bindNumber = true; }
                if (k.IndexOf(".trim") >= 0) { c.bindTrim = true; }
                continue;
            }
            if (k == ":class" || k == "data-bind-class" || k == "z-class" || k == "v-bind:class") {
                c.bindClass = v;
                continue;
            }
            if (k == ":disabled" || k == "data-bind-disabled" || k == "z-disabled" || k == "v-bind:disabled") {
                c.bindDisabled = v;
                continue;
            }
            if (k == "data-if" || k == "z-show" || k == "v-show") {
                c.bindIf = v;
                continue;
            }
            if (k == "z-hide" || k == "v-hide") {
                c.bindIf = "!" + v;
                continue;
            }
            if (k == "z-text" || k == "v-text") {
                c.bindPath = v;
                c.bindProp = "text";
                continue;
            }
            // 通用动态属性绑定（:prop / v-bind:prop / z-bind:prop）
            string bindAttr = "";
            if (k.Length > 1 && k[0] == 58) { // ':'
                bindAttr = k.Substring(1);
            } else if (k.Length > 7 && HtmlText.StartsWith(k, "v-bind:")) {
                bindAttr = k.Substring(7);
            } else if (k.Length > 7 && HtmlText.StartsWith(k, "z-bind:")) {
                bindAttr = k.Substring(7);
            }
            if (bindAttr != "") {
                c.AddBindProp(bindAttr, v);
                continue;
            }
            // 事件语法糖解析（data-on-*, @*, v-on:*, z-on:*, on*）
            string evt = "";
            string suffix = "";
            if (k.Length > 8 && HtmlText.StartsWith(k, "data-on-")) {
                suffix = k.Substring(8, k.Length - 8);
                evt = HtmlText.EventKind(suffix);
            } else if (k.Length > 1 && k[0] == 64) { // '@'
                suffix = k.Substring(1);
                evt = HtmlText.EventKind(suffix);
            } else if (k.Length > 5 && (HtmlText.StartsWith(k, "v-on:") || HtmlText.StartsWith(k, "z-on:"))) {
                suffix = k.Substring(5);
                evt = HtmlText.EventKind(suffix);
            } else if (k.Length > 2 && HtmlText.StartsWith(k, "on")) {
                suffix = k.Substring(2);
                evt = HtmlText.EventKind(suffix);
            }
            if (evt != "") {
                string mod = "";
                int dotIdx = suffix.IndexOf(".");
                if (dotIdx >= 0) {
                    mod = suffix.Substring(dotIdx + 1);
                }
                string hname = v;
                int pOpen = v.IndexOf("(");
                if (pOpen >= 0 && v.EndsWith(")")) {
                    hname = v.Substring(0, pOpen).Trim();
                    string argExpr = v.Substring(pOpen + 1, v.Length - pOpen - 2).Trim();
                    if (darg == "" && argExpr != "") {
                        darg = argExpr;
                    }
                }
                if (darg != "") {
                    Html.WireArg(handlers, c, evt, hname, darg, mod);
                } else {
                    Html.Wire(handlers, c, evt, hname, mod);
                }
                continue;
            } else if (suffix != "") {
                Console.WriteLine("HTML_WIRE_WARN unknown event '"
                    + suffix + "' on <" + n.tag + (id != ""
                        ? " id=" + id : "") + ">");
                continue;
            }
            string klow = k.ToLower();
            switch (klow) {
                case "icon": {
                    if (c is Button) {
                        ((Button)c).Icon = v;
                    }
                    c.SetProp("icon", v);
                    continue;
                }
                case "tip":
                case "title": {
                    if (c is Button) {
                        ((Button)c).Tip = v;
                    }
                    if (c is Element) {
                        ((Element)c).elTitle = v;
                    }
                    c.SetProp("tip", v);
                    continue;
                }
                case "tip-side":
                case "tipside":
                case "tip-pos": {
                    if (c is Button) {
                        ((Button)c).TipSide = v;
                    }
                    c.SetProp("tip-side", v);
                    continue;
                }
                case "free-layout":
                case "data-free-layout": {
                    c.FreeLayout();
                    continue;
                }
                case "disabled": {
                    c.SetProp("disabled", "true");
                    continue;
                }
                case "dock":
                case "data-dock": {
                    string dlow = v.ToLower();
                    switch (dlow) {
                        case "fill":   c.DockFill(); break;
                        case "left":   c.DockLeft(); break;
                        case "right":  c.DockRight(); break;
                        case "top":    c.DockTop(); break;
                        case "bottom": c.DockBottom(); break;
                    }
                    continue;
                }
                case "visible": {
                    if (v == "false" || v == "0") { c.visible = false; }
                    else if (v == "true" || v == "1") { c.visible = true; }
                    continue;
                }
                default: {
                    if (!(c is Element)) {
                        c.SetProp(k, v);
                    }
                    break;
                }
            }
        }
        return c;
    }

    // title 属性的渲染期轮询（Element.OnPaint 每帧调用）：本元素
    // 正被悬停且停稳达 DefaultDelayMs 时，向帧末提示队列登记
    // （Request 幂等，重复登记无害）。指针挪走/悬停目标一变即
    // 失效——气泡生命周期与浏览器一致。命中矩形来自 FireCommon
    // （链接/带事件的元素）或宿主注册；纯展示容器无人监听时没有
    // 命中区，也就无提示（不给静态内容开指针）。App 从静态
    // FrameApp 取（渲染帧内即当前 App；无帧体的探针直接跳过）。
    static void PaintTip(Control c, string tip) {
        App app = App.FrameApp();
        if (app == null) { return; }
        if (!app.focus.IsHovered(c.CommonId())) { return; }
        if (app.focus.HoveredMs() < Tooltip.DefaultDelayMs()) {
            app.RequestWakeFrameIn(80);
            return;
        }
        Tooltip.RequestBox(app, c.bx, c.by, c.bw, c.bh, tip,
            Tooltip.Bottom(), app.Scale(260));
    }

    static bool IsMetaChild(string ptag, string ctag) {
        switch (ptag) {
            case "select":
            case "selectbox":
            case "zan-select-box":
                return ctag == "option";
            case "tabs":
            case "tab-control":
            case "zan-tabs":
                return ctag == "tab" || ctag == "tab-pane" || ctag == "tabpane";
            case "datatable":
            case "grid":
            case "data-grid":
            case "zan-data-grid":
            case "zan-datatable":
                return ctag == "col" || ctag == "column";
            default:
                return false;
        }
    }

    // 挂子节点：支持 slot 具名插槽路由分发；Element 父走 AddKid（与 AddText 的文档序交错，
    // 行盒混排依赖），控件父走普通 Add。
    static void AddChild(Control parent, Control c) {
        if (c.slotName != "" && parent.MountSlot(c.slotName, c)) {
            return;
        }
        if (parent is Element) {
            ((Element)parent).AddKid(c);
            return;
        }
        parent.Add(c);
    }

    // 深拷贝一棵控件树（`<template data-for>` 行展开用）。Element
    // 走同构克隆——Props() 没有覆写、Serialize 无法往返，标签/文本/
    // 原始属性表必须特判搬运；Class 原样带上（行内 style 的 zgen-N
    // 规则已在应用样式表里，克隆件挂同名类即生效）。其余控件按注册
    // kind 重建（未注册返回 null，调用侧跳过不占位），Props 声明槽
    // 与事件名照搬；几何与绑定声明逐项复制，子树递归。
    static Control Clone(Control c) {
        Install();
        if (c is Element) {
            Element src = (Element)c;
            Element el = new Element();
            el.InitElement(src.Kind(), src.name);
            el.CopyAttrsFrom(src);
            el.SetText(src.Text());
            el.Class = src.Class;
            el.dock = src.dock;
            el.padL = src.padL;
            el.padT = src.padT;
            el.padR = src.padR;
            el.padB = src.padB;
            el.gap = src.gap;
            el.mx = src.mx;
            el.my = src.my;
            el.prefW = src.prefW;
            el.prefH = src.prefH;
            el.logW = src.logW;
            el.logH = src.logH;
            el.logX = src.logX;
            el.logY = src.logY;
            el.logGap = src.logGap;
            el.logPad = src.logPad;
            el.logPlaceSet = src.logPlaceSet;
            el.designFloat = src.designFloat;
            el.designAnchor = src.designAnchor;
            el.designCss = src.designCss;
            el.bindPath = src.bindPath;
            el.bindProp = src.bindProp;
            el.bindIf = src.bindIf;
            el.bindClass = src.bindClass;
            el.bindDisabled = src.bindDisabled;
            el.baseClass = src.baseClass;
            el.handlerArg = src.handlerArg;
            el.slotName = src.slotName;
            el.bindLazy = src.bindLazy;
            el.bindNumber = src.bindNumber;
            el.bindTrim = src.bindTrim;
            el.bindTpl = src.bindTpl;
            if (src.bindProps != null) {
                for (int bpi = 0; bpi < src.bindProps.Count; bpi = bpi + 1) {
                    el.AddBindProp(src.bindProps[bpi].prop, src.bindProps[bpi].expr);
                }
            }
            for (int ei = 0; ei < src.events.Count; ei = ei + 1) {
                el.SetHandler(src.events[ei].key, src.events[ei].val);
            }
            // 文档序重放（AddText/AddKid 交错是行盒混排的依据）
            if (src.elOrder != null) {
                for (int i = 0; i < src.elOrder.Count; i = i + 1) {
                    FlowEntry o = src.elOrder[i];
                    if (o.kid != null) {
                        Control kid = Html.Clone(o.kid);
                        if (kid != null) { el.AddKid(kid); }
                    } else {
                        el.AddText(o.text);
                    }
                }
            } else {
                List<Control> kids = src.children;
                for (int i = 0; i < kids.Count; i = i + 1) {
                    Control kid = Html.Clone(kids[i]);
                    if (kid != null) { el.AddKid(kid); }
                }
            }
            return el;
        }
        Control n = ControlFactory.Create(c.Kind());
        if (n == null) { return null; }
        n.name = c.name;
        n.Class = c.Class;
        n.dock = c.dock;
        n.padL = c.padL;
        n.padT = c.padT;
        n.padR = c.padR;
        n.padB = c.padB;
        n.gap = c.gap;
        n.mx = c.mx;
        n.my = c.my;
        n.prefW = c.prefW;
        n.prefH = c.prefH;
        n.logW = c.logW;
        n.logH = c.logH;
        n.logX = c.logX;
        n.logY = c.logY;
        n.logGap = c.logGap;
        n.logPad = c.logPad;
        n.logPlaceSet = c.logPlaceSet;
        n.designFloat = c.designFloat;
        n.designAnchor = c.designAnchor;
        n.designCss = c.designCss;
        n.bindPath = c.bindPath;
        n.bindProp = c.bindProp;
        n.bindIf = c.bindIf;
        n.bindClass = c.bindClass;
        n.bindDisabled = c.bindDisabled;
        n.baseClass = c.baseClass;
        n.handlerArg = c.handlerArg;
        n.slotName = c.slotName;
        n.bindLazy = c.bindLazy;
        n.bindNumber = c.bindNumber;
        n.bindTrim = c.bindTrim;
        n.bindTpl = c.bindTpl;
        if (c.bindProps != null) {
            for (int bpi = 0; bpi < c.bindProps.Count; bpi = bpi + 1) {
                n.AddBindProp(c.bindProps[bpi].prop, c.bindProps[bpi].expr);
            }
        }
        List<PropSpec> ps = c.Props();
        for (int i = 0; i < ps.Count; i = i + 1) {
            n.SetProp(ps[i].key, c.GetProp(ps[i].key));
        }
        for (int ei = 0; ei < c.events.Count; ei = ei + 1) {
            n.SetHandler(c.events[ei].key, c.events[ei].val);
        }
        for (int i = 0; i < c.children.Count; i = i + 1) {
            Control kid = Html.Clone(c.children[i]);
            if (kid != null) { n.Add(kid); }
        }
        return n;
    }

    static Action WrapModifier(Action a, string mod) {
        if (mod == "") { return a; }
        bool hasStop = mod.IndexOf("stop") >= 0;
        bool hasEnter = mod.IndexOf("enter") >= 0;
        return () => {
            App app = App.FrameApp();
            if (hasEnter && app != null && app.window != null) {
                if (app.window.EventKeyCode() != 13) {
                    return;
                }
            }
            if (hasStop && app != null) {
                app.ClaimClick();
            }
            a();
        };
    }

    static Action<string> WrapModifierArg(Action<string> a, string mod) {
        if (mod == "") { return a; }
        bool hasStop = mod.IndexOf("stop") >= 0;
        bool hasEnter = mod.IndexOf("enter") >= 0;
        return (arg) => {
            App app = App.FrameApp();
            if (hasEnter && app != null && app.window != null) {
                if (app.window.EventKeyCode() != 13) {
                    return;
                }
            }
            if (hasStop && app != null) {
                app.ClaimClick();
            }
            a(arg);
        };
    }

    // data-on-* 接线的公开钩子：生成的/手写的建树代码统一走这里，
    // 由它消化"名字 → 注册表 Action → BindEvent"与 Button 等控件
    // 把事件路由到专属槽位的差异（BindEvent 多态分派）。名字无论
    // 有没有注册表都落控件（SetHandler）——与 FormBuilder 挂载
    // 同一契约，ChildWindow.Wire 等宿主才能二次解析。
    static void Wire(HtmlHandlers handlers, Control c, string evt,
                     string name) {
        Wire(handlers, c, evt, name, "");
    }

    static void Wire(HtmlHandlers handlers, Control c, string evt,
                     string name, string mod) {
        if (evt == "") { return; }
        c.SetHandler(evt, name);
        if (handlers == null) { return; }
        Action a = handlers.Find(name);
        if (a != null) {
            Action wrapped = WrapModifier(a, mod);
            c.BindEvent(evt, wrapped);
        } else {
            // 名字没注册 = 处理器漏写/拼错（宿主侧）——同一“点了没
            // 反应”家族，同样一行警告点名。注册表晚于装载补充的
            // 二次接线（ChildWindow.WireNode）不受影响：名字已落
            // 控件，那路命中照样接。
            Console.WriteLine("HTML_WIRE_WARN handler '" + name
                + "' not registered (" + evt + " on " + c.name + ")");
        }
    }

    // 带参接线（`data-arg`）：按名查带参槽，把实参闭包进无参
    // Action 再 BindEvent（实参是只读捕获的局部——创建时值快照，
    // 语义即"这个控件永远带着它的参数"）。名字照落控件；带参槽
    // 未命中时静默不接（与 Wire 同一契约）。
    static void WireArg(HtmlHandlers handlers, Control c, string evt,
                        string name, string arg) {
        WireArg(handlers, c, evt, name, arg, "");
    }

    static void WireArg(HtmlHandlers handlers, Control c, string evt,
                        string name, string arg, string mod) {
        if (evt == "") { return; }
        c.SetHandler(evt, name);
        c.handlerArg = arg;
        if (handlers == null) { return; }
        Action<string> a = handlers.FindArg(name);
        if (a == null) { return; }
        string captured = arg;
        Action<string> wrapped = WrapModifierArg(a, mod);
        c.BindEvent(evt, () => { wrapped(captured); });
    }

    // ---- <a> 链接导航（P5 链接语义） --------------------------------
    // 桌面映射：<a href="http..."> 缺省路由到 App.linkNavigator（
    // WebView 家族经 WebViewBootstrap.Install 注册：宿主经
    // WebViewBootstrap.UseAsLinkTarget 登记的就地图优先，没有就
    // App 级链接窗口；未安装 WebView 家族的程序直开系统浏览器），
    // target="_blank"（新弹窗）直接弹系统浏览器。三个入口共用
    // AutoLink：LoadHtmlWith 装载扫描、ChildWindow.WireNode 二次
    // 接线（模板行克隆等）、宿主对手搭/生成树的 AutoLinkTree。

    // 给一个元素接上缺省导航。已有 Click 监听（data-on-click 或
    // 宿主程序化 OnClick）即宿主接管，不再叠加；app 为 null 不接
    // （编译期生成的树没有 App 上下文，由挂载它的窗口 WireNode
    // 或宿主 AutoLinkTree 补）。幂等：已接 Click 的元素跳过。
    static void AutoLink(Control c, App app) {
        if (app == null) { return; }
        if (!(c is Element)) { return; }
        if (c.On.Click.Count() > 0) { return; }
        string href = c.CssAttr("href");
        if (!Html.Navigable(href)) { return; }
        bool blank = c.CssAttr("target") == "_blank";
        c.BindEvent("Click", () => { app.OpenLink(href, blank); });
    }

    // 对一棵树做链接扫描（LoadHtmlWith / 宿主自挂的手搭或生成树）。
    static void AutoLinkTree(Control root, App app) {
        Install();
        if (root == null) { return; }
        Html.AutoLink(root, app);
        for (int i = 0; i < root.children.Count; i = i + 1) {
            Html.AutoLinkTree(root.children[i], app);
        }
    }

    // href 可路由：仅 http/https（大小写不敏感）。相对路径没有
    // base 可解析；# 锚在保留树上无滚动目标；javascript:/mailto:
    // 等其它 scheme 涉及脚本执行或 shell 关联程序——本版一律
    // 不路由（宁缺毋滥，AI 生成的 UI 不至于误触系统处理器）。
    static bool Navigable(string href) {
        if (href == "") { return false; }
        string low = href.ToLower();
        return HtmlText.StartsWith(low, "http://")
            || HtmlText.StartsWith(low, "https://");
    }

    // HTML 标签到控件 Kind 类型的归一化映射
    static string TagToKind(string tag) {
        if (tag == "") { return ""; }
        string t = tag.ToLower();
        if (HtmlText.StartsWith(t, "zan-")) {
            t = t.Substring(4, t.Length - 4);
        }
        switch (t) {
            case "datatable":
            case "grid":
            case "data-grid":
                return "DataGrid";
            case "tabs":
            case "tab-control":
                return "Tabs";
            case "splitpanel":
            case "split-panel":
            case "splitter":
                return "SplitPanel";
            case "treeview":
            case "tree":
                return "TreeView";
            case "pagination":
            case "pager":
                return "Pagination";
            case "checkbox":
            case "check-box":
                return "Checkbox";
            case "inputnumber":
            case "input-number":
                return "InputNumber";
            case "choicegroup":
            case "choice-group":
            case "radiogroup":
            case "radio-group":
                return "ChoiceGroup";
            case "switch":
                return "Switch";
            case "radio":
                return "Radio";
            case "slider":
                return "Slider";
            case "colorpicker":
            case "color-picker":
                return "ColorPicker";
            case "datepicker":
            case "date-picker":
                return "DatePicker";
            case "upload":
                return "Upload";
            case "listview":
            case "list":
                return "ListView";
            case "virtuallist":
            case "virtual-list":
                return "VirtualList";
            case "rate":
                return "Rate";
            case "chart":
                return "ChartHost";
            case "avatar":
                return "Avatar";
            case "badge":
                return "Badge";
            case "card":
                return "Card";
            case "alert":
            case "alert-box":
            case "alertbox":
                return "AlertBox";
            case "tag":
                return "Tag";
            case "divider":
                return "Divider";
            case "toolstrip":
            case "toolbar":
            case "tool-strip":
                return "ToolStrip";
            case "statusbar":
            case "status-bar":
                return "StatusBar";
            case "collapse":
                return "Collapse";
            case "breadcrumb":
                return "Breadcrumb";
            case "steps":
                return "Steps";
            case "timeline":
                return "Timeline";
            case "carousel":
                return "Carousel";
            case "qrcode":
            case "qr-code":
                return "QrCode";
            case "statistic":
                return "Statistic";
            case "countdown":
                return "Countdown";
            case "empty":
                return "Empty";
            case "result":
                return "Result";
            case "skeleton":
                return "Skeleton";
            case "spin":
                return "Spin";
            case "watermark":
                return "Watermark";
            case "flex":
                return "Flex";
            case "row":
                return "Row";
            case "spacer":
                return "Spacer";
            case "form":
            case "form-group":
            case "formgroup":
                return "FormGroup";
            case "form-item":
            case "formitem":
            case "form-row":
            case "formrow":
                return "FormItem";
            case "modal":
            case "dialog":
                return "Modal";
            case "drawer":
                return "Drawer";
            case "panel":
                return "Panel";
            default:
                return tag;
        }
    }
}

