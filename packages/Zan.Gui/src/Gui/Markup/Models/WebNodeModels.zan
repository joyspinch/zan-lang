using System.IO;
using System.Json;
using System.Text;
using System;

namespace Gui.Markup;

public class WAttr {
    public string name;
    public string val;
    public WAttr(string name, string val) {
        this.name = name;
        this.val = val;
    }
}

public class WDoc {
    public List<WNode> nodes;
    public string css;
    public List<WNode> headNodes;
}

public class WFrame {
    public int rec;
    public string tag;
    public int mode;
    public string pending;  // 已塌缩、前后空白待裁决的文本
    public bool prevInline;  // pending 之前最近一个兄弟是否行内级
    public string label;  // mode 1/2 的累计文本
}

public class WItem {
    public int kid;
    public string text;
}

public class WNode {
    public string tag;
    public int parent;
    public List<WAttr> attrs;
    public List<WItem> items;
    public string text;
}

public class WOpenResult {
    public string name;
    public int next;
    public bool selfClose;
}
