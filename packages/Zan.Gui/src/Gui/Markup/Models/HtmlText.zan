using System;
using System.IO;
using System.Json;
using System.Text;
namespace Gui.Markup;
public class HtmlText {
    public static string EventKind(string suffix, List<string> events) {
        if (suffix == null || events == null) { return ""; }
        string key = EventKey(suffix);
        for (int i = 0; i < events.Count; i = i + 1) {
            if (EventKey(events[i]) == key) { return events[i]; }
        }
        return "";
    }
    public static string EventKey(string name) {
        if (name == null) { return ""; }
        int dot = name.IndexOf(".");
        if (dot >= 0) { name = name.Substring(0, dot); }
        string key = name.ToLower().Replace("-", "");
        key = key.Replace("dblclick", "doubleclick");
        if (key == "contextmenu") { return "rightclick"; }
        if (key == "mouseenter" || key == "mouseover") { return "enter"; }
        if (key == "mouseleave" || key == "mouseout") { return "leave"; }
        return key;
    }
    public static string EventName(string name) {
        if (name == null) { return ""; }
        int dot = name.IndexOf(".");
        if (dot >= 0) { name = name.Substring(0, dot); }
        string key = EventKey(name);
        if (key == "doubleclick") { return "DoubleClick"; }
        if (key == "rightclick") { return "RightClick"; }
        if (key == "rightdoubleclick") { return "RightDoubleClick"; }
        if (key == "mousedown") { return "MouseDown"; }
        if (key == "mouseup") { return "MouseUp"; }
        if (key == "keydown") { return "KeyDown"; }
        if (key == "keyup") { return "KeyUp"; }
        if (key == "keypress") { return "KeyPress"; }
        if (key == "enter") { return "Enter"; }
        if (key == "leave") { return "Leave"; }
        List<string> parts = name.Split("-");
        string result = "";
        for (int i = 0; i < parts.Count; i = i + 1) {
            string part = parts[i];
            if (part.Length == 0) { continue; }
            int first = part[0] & 255;
            result = result + (first >= 97 && first <= 122
                ? (char)(first - 32) + part.Substring(1) : part);
        }
        return result;
    }
    public static string UnkebabKey(string s) {
        if (s == null) { return ""; }
        int dash = s.IndexOf("-");
        if (dash < 0) { return s; }
        StringBuilder key = new StringBuilder();
        if (dash > 0) { key.Append(new StringView((nint)s, dash)); }
        int start = dash + 1;
        int len = s.Length;
        for (int end = start; end <= len; end = end + 1) {
            if (end < len && s[end] != 45) { continue; }
            if (start < end && s[start] >= 97 && s[start] <= 122) {
                key.Append((char)(s[start] - 32));
                start = start + 1;
            }
            if (start < end) { key.Append(new StringView((nint)s + (nint)start, end - start)); }
            start = end + 1;
        }
        return key.ToString();
    }
    public static string Attr(List<string> an, List<string> av, string name) {
        if (an == null || av == null || name == null) { return ""; }
        int cnt = an.Count < av.Count ? an.Count : av.Count;
        for (int i = 0; i < cnt; i = i + 1) {
            if (an[i] == name) { return av[i]; }
        }
        return "";
    }
    public static string NodeAttr(List<WAttr> attrs, string name) {
        if (attrs == null || name == null) { return ""; }
        for (int i = 0; i < attrs.Count; i = i + 1) {
            if (attrs[i].name == name) { return attrs[i].val; }
        }
        return "";
    }
    public static List<string> SplitClass(string v) {
        List<string> outp = new List<string>();
        if (v == null) { return outp; }
        int i = 0;
        int n = v.Length;
        while (i < n) {
            while (i < n && IsSpaceChar(v[i] & 255)) { i = i + 1; }
            int s = i;
            while (i < n && !IsSpaceChar(v[i] & 255)) { i = i + 1; }
            if (i > s) { outp.Add(v.Substring(s, i - s)); }
        }
        return outp;
    }
    public static bool StartsWith(string s, string p) {
        if (s == null || p == null || s.Length < p.Length) { return false; }
        for (int i = 0; i < p.Length; i = i + 1) {
            if (s[i] != p[i]) { return false; }
        }
        return true;
    }
    public static string CollapseSpace(string s) {
        if (s == null || s.Length == 0) { return ""; }
        StringBuilder outp = new StringBuilder();
        bool inSpace = false;
        int start = 0;
        int n = s.Length;
        for (int i = 0; i < n; i = i + 1) {
            int c = s[i] & 255;
            if (c == 32 || c == 10 || c == 13 || c == 9) {
                if (!inSpace) {
                    if (i > start) { outp.Append(s.Substring(start, i - start)); }
                    inSpace = true;
                }
                start = i + 1;
                continue;
            }
            if (inSpace) {
                outp.Append(" ");
                inSpace = false;
                start = i;
            }
        }
        if (start < n) { outp.Append(s.Substring(start, n - start)); }
        if (inSpace) { outp.Append(" "); }
        return outp.ToString();
    }
    public static string TrimLead(string s) {
        if (s == null) { return ""; }
        int i = 0;
        while (i < s.Length && (s[i] & 255) == 32) { i = i + 1; }
        return i == 0 ? s : s.Substring(i, s.Length - i);
    }
    public static string TrimTrail(string s) {
        if (s == null) { return ""; }
        int e = s.Length;
        while (e > 0 && (s[e - 1] & 255) == 32) { e = e - 1; }
        return e == s.Length ? s : s.Substring(0, e);
    }
    public static string DecodeEntities(string s) {
        if (s == null) { return ""; }
        if (s.IndexOf("&") < 0) { return s; }
        StringBuilder outp = new StringBuilder();
        int i = 0;
        int start = 0;
        int n = s.Length;
        while (i < n) {
            if ((s[i] & 255) != 38) {
                i = i + 1;
                continue;
            }
            int semi = FindFrom(s, ";", i + 1);
            if (semi < 0 || semi - i > 10) {
                i = i + 1;
                continue;
            }
            string ent = s.Substring(i + 1, semi - i - 1);
            string dec = "";
            if (ent == "amp") { dec = "&"; }
            else if (ent == "lt") { dec = "<"; }
            else if (ent == "gt") { dec = ">"; }
            else if (ent == "quot") { dec = "\""; }
            else if (ent == "apos") { dec = "'"; }
            else if (ent == "nbsp") { dec = " "; }
            else if (ent.Length > 1 && (ent[0] & 255) == 35) {
                int code = 0 - 1;
                if (ent.Length > 2 && ((ent[1] & 255) == 120 || (ent[1] & 255) == 88)) {
                    code = ParseHex(ent.Substring(2, ent.Length - 2));
                } else {
                    code = ParseIntOr(ent.Substring(1, ent.Length - 1),
                                      0 - 1);
                }
                if (code > 0 && code <= 1114111 && !(code >= 55296 && code <= 57343)) {
                    dec = Encoding.Utf8FromCodePoint(code);
                }
            }
            if (dec == "") {
                i = i + 1;
                continue;
            }
            if (i > start) { outp.Append(s.Substring(start, i - start)); }
            outp.Append(dec);
            i = semi + 1;
            start = i;
        }
        if (start < n) { outp.Append(s.Substring(start, n - start)); }
        return outp.ToString();
    }
    public static int ParseIntOr(string s, int dflt) {
        if (s == null || s.Length == 0) { return dflt; }
        int i = 0;
        int sign = 1;
        if (i < s.Length && (s[i] & 255) == 45) { sign = 0 - 1; i = i + 1; }
        if (i >= s.Length) { return dflt; }
        long v = 0;
        long maxMag = sign < 0 ? 2147483648L : 2147483647L;
        while (i < s.Length) {
            int c = s[i] & 255;
            if (c < 48 || c > 57) { return dflt; }
            v = v * 10L + (long)(c - 48);
            if (v > maxMag) { return dflt; }
            i = i + 1;
        }
        return (int)(sign < 0 ? 0L - v : v);
    }
    public static int ParseHex(string s) {
        if (s == null || s.Length == 0) { return 0 - 1; }
        int v = 0;
        for (int i = 0; i < s.Length; i = i + 1) {
            int c = s[i] & 255;
            int d = 0 - 1;
            if (c >= 48 && c <= 57) { d = c - 48; }
            else if (c >= 97 && c <= 102) { d = c - 87; }
            else if (c >= 65 && c <= 70) { d = c - 55; }
            if (d < 0) { return 0 - 1; }
            v = v * 16 + d;
            if (v > 1114111) { return 0 - 1; }
        }
        return v;
    }
    public static bool IsAlpha(int c) { return (c >= 97 && c <= 122) || (c >= 65 && c <= 90); }
    public static bool IsNameChar(int c) {
        return IsAlpha(c) || (c >= 48 && c <= 57) || c == 45 || c == 95
            || c == 58 || c == 46;
    }
    public static bool IsSpaceChar(int c) { return c == 32 || c == 10 || c == 13 || c == 9; }
    public static int FindFrom(string s, string sub, int from) {
        if (s == null || sub == null || sub.Length == 0) { return 0 - 1; }
        if (from < 0) { from = 0; }
        if (from >= s.Length) { return 0 - 1; }
        int first = sub[0];
        int limit = s.Length - sub.Length;
        for (int i = from; i <= limit; i = i + 1) {
            if (s[i] != first) { continue; }
            bool ok = true;
            for (int k = 1; k < sub.Length; k = k + 1) {
                if (s[i + k] != sub[k]) { ok = false; break; }
            }
            if (ok) { return i; }
        }
        return 0 - 1;
    }
    public static int FindCloseTag(string s, string tag, int from) {
        if (s == null || tag == null || tag.Length == 0) { return 0 - 1; }
        if (from < 0) { from = 0; }
        int limit = s.Length - tag.Length - 2;
        for (int i = from; i <= limit; i = i + 1) {
            if ((s[i] & 255) != 60 || (s[i + 1] & 255) != 47) { continue; }
            bool ok = true;
            for (int k = 0; k < tag.Length; k = k + 1) {
                int a = s[i + 2 + k] & 255;
                if (a >= 65 && a <= 90) { a = a + 32; }
                int b = tag[k] & 255;
                if (b >= 65 && b <= 90) { b = b + 32; }
                if (a != b) { ok = false; break; }
            }
            if (ok) {
                int after = i + 2 + tag.Length;
                if (after >= s.Length) { return i; }
                int nb = s[after] & 255;
                if (nb == 62 || nb == 47 || IsSpaceChar(nb)) { return i; }
            }
        }
        return 0 - 1;
    }
    public static bool IsInlineTag(string t) { return !IsBlockTag(t); }
    public static bool IsBlockTag(string t) {
        if (t == "div" || t == "p" || t == "section" || t == "article"
            || t == "header" || t == "footer" || t == "nav" || t == "aside"
            || t == "main" || t == "ul" || t == "ol" || t == "li"
            || t == "dl" || t == "dt" || t == "dd" || t == "blockquote"
            || t == "figure" || t == "figcaption" || t == "pre"
            || t == "address" || t == "body" || t == "html" || t == "head"
            || t == "hr" || t == "form" || t == "table" || t == "tr"
            || t == "td" || t == "th" || t == "thead" || t == "tbody"
            || t == "tfoot" || t == "h1" || t == "h2" || t == "h3"
            || t == "h4" || t == "h5" || t == "h6" || t == "style"
            || t == "script" || t == "title" || t == "meta" || t == "link"
            || t == "template") {
            return true;
        }
        return false;
    }
    public static bool IsVoidTag(string t) {
        return t == "br" || t == "hr" || t == "img" || t == "input"
            || t == "meta" || t == "link" || t == "base" || t == "area"
            || t == "col" || t == "embed" || t == "source" || t == "track"
            || t == "wbr" || t == "param";
    }
}
