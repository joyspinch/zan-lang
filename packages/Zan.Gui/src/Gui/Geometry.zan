using System;

namespace Gui;

public class Point {
    public int x;
    public int y;
    public Point(int x, int y) {
        this.x = x;
        this.y = y;
    }
}

public class Size {
    public int width;
    public int height;
    public Size(int w, int h) {
        this.width = w;
        this.height = h;
    }
}

public class Insets {
    int top;
    int right;
    int bottom;
    int left;
    Insets(int top, int right, int bottom, int left) {
        this.top = top;
        this.right = right;
        this.bottom = bottom;
        this.left = left;
    }
    static Insets Uniform(int val) { return new Insets(val, val, val, val); }
    static Insets Symmetric(int vertical, int horizontal) {
        return new Insets(vertical, horizontal, vertical, horizontal);
    }
    int Horizontal() { return left + right; }
    int Vertical() { return top + bottom; }
}

public class Rect {
    int x;
    int y;
    int width;
    int height;
    Rect(int x, int y, int w, int h) {
        this.x = x;
        this.y = y;
        this.width = w;
        this.height = h;
    }
    void Set(int x, int y, int w, int h) {
        this.x = x;
        this.y = y;
        this.width = w;
        this.height = h;
    }
    int Right() { return x + width; }
    int Bottom() { return y + height; }
    bool Contains(int px, int py) {
        if (px < x) { return false; }
        if (px >= x + width) { return false; }
        if (py < y) { return false; }
        if (py >= y + height) { return false; }
        return true;
    }
    bool Intersects(int ox, int oy, int ow, int oh) {
        if (x + width <= ox) { return false; }
        if (ox + ow <= x) { return false; }
        if (y + height <= oy) { return false; }
        if (oy + oh <= y) { return false; }
        return true;
    }
    static Rect Inflate(int rx, int ry, int rw, int rh, int amount) {
        return new Rect(rx - amount, ry - amount, rw + amount * 2, rh + amount * 2);
    }
}

public class Cursor {
    static int Arrow() { return 0; }
    static int Hand() { return 1; }
    static int IBeam() { return 2; }
    static int ResizeH() { return 3; }
    static int ResizeV() { return 4; }
}

public class WindowShapeKind {
    public const int Default = 0;       // 默认标准矩形
    public const int RoundedRect = 1;   // 矩形 / 圆角矩形（radius > 0 为圆角）
    public const int Ellipse = 2;       // 椭圆（width / height 为外接包围盒）
    public const int ShadowBand = 3;    // 阴影外扩保护带（全窗口外扩带，不接收点击）
}

public class WindowShapeRegion {
    public int kind;
    public int x;
    public int y;
    public int width;
    public int height;
    public int radius;
    public WindowShapeRegion() {
        this.kind = WindowShapeKind.RoundedRect;
        this.x = 0;
        this.y = 0;
        this.width = 0;
        this.height = 0;
        this.radius = 0;
    }
    public WindowShapeRegion(int kind, int x, int y, int width, int height, int radius) {
        this.kind = kind;
        this.x = x;
        this.y = y;
        this.width = width;
        this.height = height;
        this.radius = radius;
    }
    public bool IsRoundedRect() { return this.kind == WindowShapeKind.RoundedRect; }
    public bool IsEllipse() { return this.kind == WindowShapeKind.Ellipse; }
    public bool IsShadowBand() { return this.kind == WindowShapeKind.ShadowBand; }
    public WindowShapeRegion Clone() {
        return new WindowShapeRegion(this.kind, this.x, this.y, this.width, this.height, this.radius);
    }
    public WindowShapeRegion Translate(int dx, int dy) {
        return new WindowShapeRegion(this.kind, this.x + dx, this.y + dy, this.width, this.height, this.radius);
    }
    public string ToSpecPart() {
        return Convert.ToString(this.kind) + ","
            + Convert.ToString(this.x) + ","
            + Convert.ToString(this.y) + ","
            + Convert.ToString(this.width) + ","
            + Convert.ToString(this.height) + ","
            + Convert.ToString(this.radius);
    }
}
