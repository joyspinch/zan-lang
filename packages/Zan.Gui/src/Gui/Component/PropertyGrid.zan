using System;
using Gui;
using Gui.Widget;

namespace Gui.Component;

// 属性表：把一组 PropSpec 画成可编辑的属性行，值直接读写 spec 绑定
// 的字段 / signal。行的标签、编辑器、滚动、裁剪都由控件自己完成，
// 宿主只提供 spec 列表：
// 编辑器按 PropSpec.kind 选：0/4 文本 Input，1 整数 Input，2 Switch，
// 3 SelectBox，5 分组标题（PropSpec.Section，只有文字没有编辑器）。
public class PropertyGrid : Control {
    // 当前绑定的属性行（Bind 每帧灌入，不拷贝）。
    List<PropSpec> data;
    // 每行一个强类型行编辑器实体（包含对应的 Input/Switch/SelectBox/按键ID/影子值）。
    List<PropertyGridRow> rows;
    // 当前绑定对象的标识，变化时重建编辑器。
    string key;
    // 纵向滚动偏移（像素）。
    SignalInt scroll;
    // 自定义标签列宽（逻辑像素，0 = 自动根据内容自适应）。
    public int LabelWidth;
    // 没有属性时显示的文本（"" 不画）。
    string Empty;
    // 某一行被用户改动后触发（读 ChangedKey 得知是哪一个）。
    UiEvent Change;
    // 某一行即将被用户改动前触发（写前会话钩子，传 key；用于撤销栈捕获修改前快照）。
    Action<string> BeforeChange;
    // 最近被用户改动的行号（-1 = 尚无改动；Rebuild 后复位）。
    int hitRow;
    // 已折叠的分组标题集合（支持一键折叠收起不常用大类）。
    List<string> collapsedSections;
    // 分组点击命中的部件ID池。
    List<int> sectionClickIds;

    // 构造空属性表：未绑定任何行，空态文本为 ""（不画）。
    PropertyGrid() {
        this.InitControl("props", 5);
        data = new List<PropSpec>();
        rows = new List<PropertyGridRow>();
        key = "";
        scroll = new SignalInt(0);
        Empty = "";
        hitRow = 0 - 1;
        collapsedSections = new List<string>();
        sectionClickIds = new List<int>();
        wiresOwnEvents = true;
        Change = new UiEvent();
    }

    public bool IsSectionCollapsed(string sec) {
        if (sec == null || collapsedSections == null) { return false; }
        for (int i = 0; i < collapsedSections.Count; i = i + 1) {
            if (collapsedSections[i] == sec) { return true; }
        }
        return false;
    }

    public void ToggleSection(string sec) {
        if (sec == null) { return; }
        if (collapsedSections == null) { collapsedSections = new List<string>(); }
        for (int i = 0; i < collapsedSections.Count; i = i + 1) {
            if (collapsedSections[i] == sec) {
                collapsedSections.RemoveAt(i);
                return;
            }
        }
        collapsedSections.Add(sec);
    }

    // 控件类型标识（"PropertyGrid"）。
    override string Kind() { return "PropertyGrid"; }

    // 订阅属性改动事件（回调里读 ChangedKey/ChangedRow）。
    PropertyGrid OnChange(Action a) {
        Change.Add(a);
        return this;
    }

    // 设置属性写前钩子（在 p.Write 之前触发，传递属性 key，供宿主保存快照到撤销栈）。
    PropertyGrid OnBeforeChange(Action<string> a) {
        this.BeforeChange = a;
        return this;
    }

    // 最近被用户改动的行号 / 属性键。
    int ChangedRow() { return hitRow; }
    // 最近被用户改动的属性键（无效时为 ""）。
    string ChangedKey() {
        if (hitRow < 0 || hitRow >= data.Count) { return ""; }
        return data[hitRow].key;
    }

    // 按属性键获取当前编辑器的值
    string Value(string k) {
        for (int i = 0; i < data.Count; i = i + 1) {
            if (data[i].key == k) {
                return this.Editor(i);
            }
        }
        return "";
    }

    // 按属性键获取整数值
    int GetInt(string k, int defVal) {
        string s = this.Value(k);
        if (PropertyGrid.IsNumber(s)) { return Convert.ToInt32(s); }
        return defVal;
    }

    // 绑定一组属性。`k` 标识当前对象（如 "Field:btn0"）：它变化时
    // 才重建编辑器，否则沿用现有的，输入焦点和光标不会每帧丢失。
    void Bind(string k, List<PropSpec> specs) {
        if (k == key && specs.Count == data.Count) {
            data = specs;
            return;
        }
        key = k;
        data = specs;
        this.Rebuild();
    }

    // 强制丢弃现有编辑器并按当前 specs 重建（切对象后 Bind 会自动调）。
    void Rebuild() {
        rows = new List<PropertyGridRow>();
        for (int i = 0; i < data.Count; i = i + 1) {
            PropSpec p = data[i];
            string cur = p.Read();
            PropertyGridRow r = new PropertyGridRow();
            r.shadow = cur;
            if (p.kind == 5) {
                // 分组标题：没有编辑器。
            } else if (p.kind == 2) {
                // 动态宿主不走 Binding<T>（无编译期字段可指），
                // 统一经控件的属性协议驱动（§6.1）。
                Switch sw = new Switch();
                sw.Size = "small";
                sw.SetOn(PropSpec.IsOn(cur));
                r.flag = sw;
            } else if (p.kind == 3) {
                SelectBox sb = SelectBox.FromOptions(p.options, "");
                sb.SetIndex(this.IndexOfValue(p, cur));
                r.pick = sb;
                for (int si = 0; si < p.options.Count; si = si + 1) {
                    r.pickSegIds.Add(WidgetId.Next());
                }
            } else {
                Input inp = new Input("");
                inp.SetText(cur);
                r.text = inp;
            }
            r.minusId = WidgetId.Next();
            r.plusId = WidgetId.Next();
            rows.Add(r);
        }
        hitRow = 0 - 1;
    }

    // 枚举值（可能存的是序号，也可能是选项文本）对应的选项下标。
    int IndexOfValue(PropSpec p, string val) {
        for (int i = 0; i < p.options.Count; i = i + 1) {
            if (p.options[i] == val) { return i; }
        }
        if (PropertyGrid.IsNumber(val)) {
            int n = Convert.ToInt32(val);
            if (n >= 0 && n < p.options.Count) { return n; }
        }
        return 0;
    }

    // 枚举行当前选择在模型里的字符串形式：绑定到 int 的存序号，
    // 绑定到字符串的存选项文本。
    string PickValue(PropSpec p, int idx) {
        if (p.num != null || p.snum != null) { return Convert.ToString(idx); }
        if (idx >= 0 && idx < p.options.Count) { return p.options[idx]; }
        return "";
    }

    // 整数属性编辑器判可解析（允许前导 -）。
    static bool IsNumber(string s) {
        if (s == null || s.Length == 0) { return false; }
        int len = s.Length;
        int i = 0;
        if ((s[0] & 255) == 45) {
            if (len == 1) { return false; }
            i = 1;
        }
        for (; i < len; i = i + 1) {
            int c = s[i] & 255;
            if (c < 48 || c > 57) { return false; }
        }
        return true;
    }

    // 编辑器当前值的字符串形式（与 PropSpec.Read 同一种表示）。
    string Editor(int i) {
        PropSpec p = data[i];
        PropertyGridRow r = rows[i];
        if (p.kind == 2) { return r.flag.IsOn() ? "true" : "false"; }
        if (p.kind == 3) { return this.PickValue(p, r.pick.Value()); }
        return r.text.GetText();
    }

    // 把模型值灌回编辑器（外部改了属性时）。
    void Load(int i, string val) {
        PropSpec p = data[i];
        PropertyGridRow r = rows[i];
        if (p.kind == 2) { r.flag.SetOn(PropSpec.IsOn(val)); return; }
        if (p.kind == 3) { r.pick.SetIndex(this.IndexOfValue(p, val)); return; }
        r.text.SetText(val);
    }

    // 一行的双向同步：外部改动优先灌回编辑器，否则把编辑器的新值
    // 写进模型并广播 Change。整数行在输入合法前不写。
    // 提交时请求重绘：Change 经 Dispatcher 延迟到 UI 队列，若不保证
    // 下一帧，即时模式下循环会空转，处理器不排空、预览慢半拍。
    void Sync(App app, int i) {
        PropSpec p = data[i];
        if (p.kind == 5 || !p.IsBound()) { return; }
        PropertyGridRow r = rows[i];
        string cur = p.Read();
        if (cur != r.shadow) {
            this.Load(i, cur);
            r.shadow = cur;
            return;
        }
        string ui = this.Editor(i);
        if (ui == cur) { return; }
        if (p.kind == 1 && !PropertyGrid.IsNumber(ui)) { return; }
        if (this.BeforeChange != null) {
            this.BeforeChange(p.key);
        }
        p.Write(ui);
        r.shadow = p.Read();
        hitRow = i;
        Change.PostS(this);
        app.RequestRedraw();
    }

    // 整数属性的 -/+ 步进：按 spec 配置的步长增减、钳制到范围，
    // 直接写回模型与编辑器，并立即请求重绘，预览同帧跟新。
    void Step(App app, int i, int delta) {
        PropSpec p = data[i];
        if (!p.IsBound()) { return; }
        PropertyGridRow r = rows[i];
        int cur = 0;
        string readVal = p.Read();
        if (PropertyGrid.IsNumber(readVal)) { cur = Convert.ToInt32(readVal); }
        int nv = p.Clamp(cur + delta);
        string s = Convert.ToString(nv);
        if (this.BeforeChange != null) {
            this.BeforeChange(p.key);
        }
        p.Write(s);
        r.text.SetText(s);
        r.shadow = p.Read();
        hitRow = i;
        Change.PostS(this);
        app.RequestRedraw();
    }

    // 画一个步进小按钮（方形，中间一个字符字形），注册命中区，
    // 返回本帧是否被点击。
    bool StepBtn(App app, int id, int x, int y, int sz, string glyph,
                 StyleBox normalStyle, StyleBox hoverStyle) {
        Canvas c = app.canvas;
        Theme t = app.theme;
        app.hitTester.RegisterRect(id, x, y, sz, sz, 0);
        int hv = Ui.HoverLevelMsIn(app, id, 0, x, y, sz, sz);
        int state = Style.SNormal();
        if (hv != 0) { state = Style.SHover(); }
        StyleBox step = normalStyle;
        if (state == Style.SHover()) { step = hoverStyle; }
        c.FillRoundRect(x, y, sz, sz, t.borderRadiusSmall, step.BgOr(0));
        c.DrawRoundRect(x, y, sz, sz, t.borderRadiusSmall,
                        step.BorderOr(0), 1);
        int fs = Style.FontFallback(app, "small");
        int gw = Canvas.MeasureText(glyph, fs);
        c.DrawText(x + (sz - gw) / 2, Canvas.CenterTextY(y, sz, fs),
            glyph, step.FgOr(0), fs);
        return Ui.Clicked(app, id);
    }

    // 单行高度（逻辑像素，绘制时按 DPI 缩放）。
    int RowHeight(App app) { return app.Scale(32); }

    // 全部行的高度（宿主据此在自己的滚动区里给出槽位，折叠分组下的项不占高，等分配对半行合并计算）。
    int ContentHeight(App app) {
        int rowH = this.RowHeight(app);
        int totalH = 0;
        string curSec = "";
        bool curCollapsed = false;
        for (int i = 0; i < data.Count; i = i + 1) {
            PropSpec p = data[i];
            if (p.kind == 5) {
                curSec = p.label;
                curCollapsed = this.IsSectionCollapsed(curSec);
                totalH = totalH + rowH;
            } else {
                if (!curCollapsed) {
                    totalH = totalH + rowH;
                    if (p.halfRow && (i + 1 < data.Count) && data[i + 1].halfRow && data[i + 1].kind != 5) {
                        i = i + 1;
                    }
                }
            }
        }
        return totalH;
    }

    // 绘制单个属性项的标签与编辑器（支持全宽行或等分列单元格内排版）
    void RenderPropField(App app, Canvas c, Theme t, int i, int cx, int cy, int cw, int ch,
                         int flabelW, int fs, StyleBox valueStyle, StyleBox accentStyle,
                         StyleBox rowHoverStyle, StyleBox stepStyle, StyleBox stepHoverStyle) {
        if (i < 0 || i >= data.Count || i >= rows.Count) { return; }
        PropSpec p = data[i];
        PropertyGridRow r = rows[i];
        int ex = cx + flabelW;
        int ew = cw - flabelW;
        int eh = app.Scale(24);
        int ey = cy + (ch - eh) / 2;

        c.DrawText(cx, Canvas.CenterTextY(cy, ch, fs),
            Ellipsis.Fit(p.label, flabelW - t.gapSmall, fs),
            valueStyle.FgOr(0), fs);

        if (p.kind == 2) {
            int swH = app.Scale(18);
            int swY = cy + (ch - swH) / 2;
            r.flag.Render(app, ex, swY);
        } else if (p.kind == 3) {
            int optCount = p.options.Count;
            bool useSegmented = optCount >= 2 && optCount <= 4 && !p.halfRow;
            if (useSegmented) {
                int segW = ew / optCount;
                for (int si = 0; si < optCount; si = si + 1) {
                    int tw = Canvas.MeasureText(p.options[si], fs);
                    if (tw + app.Scale(16) > segW) {
                        useSegmented = false;
                        break;
                    }
                }
                if (segW < app.Scale(24)) { useSegmented = false; }
            }

            if (useSegmented) {
                int curIdx = r.pick.Value();
                int segW = ew / optCount;
                int br = app.Scale(4);
                c.FillRoundRect(ex, ey, ew, eh, br, valueStyle.BgOr(0));
                c.DrawRoundRect(ex, ey, ew, eh, br, valueStyle.BorderOr(0), 1);

                for (int si = 0; si < optCount; si = si + 1) {
                    int sx = ex + si * segW;
                    int sw = (si == optCount - 1) ? (ex + ew - sx) : segW;
                    bool isSel = (si == curIdx);
                    bool segHover = Ui.Over(app, sx, ey, sw, eh);
                    int segId = (si < r.pickSegIds.Count)
                        ? r.pickSegIds[si] : WidgetId.Next();
                    app.hitTester.RegisterRect(segId, sx, ey, sw, eh, 0);

                    if (Ui.Clicked(app, segId)) {
                        if (!isSel) {
                            r.pick.SetIndex(si);
                            if (this.BeforeChange != null) {
                                this.BeforeChange(p.key);
                            }
                            p.Write(this.PickValue(p, si));
                            r.shadow = p.Read();
                            hitRow = i;
                            Change.PostS(this);
                            app.RequestRedraw();
                        }
                    }

                    if (isSel) {
                        int accBg = accentStyle.BgOr(t.primary);
                        int accFg = accentStyle.FgOr(t.textInverse);
                        c.FillRoundRect(sx + app.Scale(1), ey + app.Scale(1),
                            sw - app.Scale(2), eh - app.Scale(2), app.Scale(3), accBg);
                        int tw = Canvas.MeasureText(p.options[si], fs);
                        c.DrawText(sx + (sw - tw) / 2, Canvas.CenterTextY(ey, eh, fs),
                            p.options[si], accFg, fs);
                    } else {
                        if (segHover) {
                            c.FillRoundRect(sx + app.Scale(1), ey + app.Scale(1),
                                sw - app.Scale(2), eh - app.Scale(2), app.Scale(3), rowHoverStyle.BgOr(0));
                        }
                        int tw = Canvas.MeasureText(p.options[si], fs);
                        c.DrawText(sx + (sw - tw) / 2, Canvas.CenterTextY(ey, eh, fs),
                            p.options[si], valueStyle.FgOr(0), fs);
                        if (si > 0 && !isSel && (si - 1 != curIdx)) {
                            c.DrawLine(sx, ey + app.Scale(3), sx, ey + eh - app.Scale(3), valueStyle.BorderOr(0), 1);
                        }
                    }
                }
            } else {
                r.pick.RenderIn(app, ex, ey, ew, eh);
            }
        } else if (p.kind == 1) {
            int gap = app.Scale(4);
            int minStepW = (eh + gap) * 2 + app.Scale(32);
            if (ew >= minStepW) {
                int inW = ew - (eh + gap) * 2;
                if (this.StepBtn(app, r.minusId, ex, ey, eh, "-",
                        stepStyle, stepHoverStyle)) {
                    this.Step(app, i, 0 - p.step);
                }
                r.text.Render(app, ex + eh + gap, ey, inW, eh);
                if (this.StepBtn(app, r.plusId, ex + ew - eh,
                        ey, eh, "+", stepStyle, stepHoverStyle)) {
                    this.Step(app, i, p.step);
                }
            } else {
                r.text.Render(app, ex, ey, ew, eh);
            }
        } else {
            r.text.Render(app, ex, ey, ew, eh);
        }
        this.Sync(app, i);
        if (p.tip != "" && Ui.Over(app, cx, cy, cw, ch)) {
            Tooltip.RequestBox(app, cx, cy, cw, ch, p.tip,
                Tooltip.Left(), app.Scale(240));
        }
    }

    // 布局测量：首选高度 = 全部行高之和。
    override void OnMeasure(App app) {
        prefH = this.ContentHeight(app);
    }

    // 绘制：处理滚轮并钳制滚动偏移，逐行画标签与编辑器
    // （整数行带 -/+ 步进按钮），每行做一次双向同步；
    // 悬停行有说明时请求气泡提示，内容溢出时画纵向滚动条。
    override void OnPaint(App app) {
        Canvas c = app.canvas;
        Theme t = app.theme;
        int fs = Style.FontFallback(app, "small");
        StyleBox emptyStyle = Style.Part(app, "propertygrid", "empty", "",
                                         "", "", Style.SNormal());
        StyleBox sectionStyle = Style.Part(app, "propertygrid", "section", "",
                                           "", "", Style.SNormal());
        StyleBox sectionHoverStyle = Style.Part(app, "propertygrid", "section", "",
                                                "", "", Style.SHover());
        StyleBox rowHoverStyle = Style.Part(app, "propertygrid", "row", "",
                                            "", "", Style.SHover());
        StyleBox accentStyle = Style.Part(app, "propertygrid", "accent", "",
                                          "", "", Style.SNormal());
        StyleBox labelStyle = Style.Part(app, "propertygrid", "label", "",
                                         "", "", Style.SNormal());
        StyleBox valueStyle = Style.Part(app, "propertygrid", "value", "",
                                         "", "", Style.SNormal());
        StyleBox stepStyle = Style.Part(app, "propertygrid", "step", "",
                                        "", "", Style.SNormal());
        StyleBox stepHoverStyle = Style.Part(app, "propertygrid", "step", "",
                                             "", "", Style.SHover());
        if (data.Count == 0) {
            if (Empty != "") {
                c.DrawText(bx, by + t.paddingSmall, Ellipsis.Fit(Empty, bw, fs),
                    emptyStyle.FgOr(0), fs);
            }
            return;
        }
        int rowH = this.RowHeight(app);
        int contentH = this.ContentHeight(app);
        Scrollbar.HandleWheel(app, bx, by, bw, bh, contentH, scroll);
        int maxOff = contentH - bh;
        if (maxOff < 0) { maxOff = 0; }
        if (scroll.Get() > maxOff) { scroll.Set(maxOff); }
        if (scroll.Get() < 0) { scroll.Set(0); }
        bool overflow = contentH > bh;
        int barW = app.Scale(6);
        int rowW = bw;
        if (overflow) { rowW = bw - barW; }
        int labelW = 0;
        if (LabelWidth > 0) {
            labelW = app.Scale(LabelWidth);
        } else {
            int maxNeed = 0;
            for (int li = 0; li < data.Count; li = li + 1) {
                if (data[li].kind != 5 && data[li].label != "") {
                    int lw = Canvas.MeasureText(data[li].label, fs);
                    if (lw > maxNeed) { maxNeed = lw; }
                }
            }
            maxNeed = maxNeed + t.gapSmall * 2;
            int minW = app.Scale(110);
            int maxW = rowW * 52 / 100;
            labelW = maxNeed;
            if (labelW < minW) { labelW = minW; }
            if (labelW > maxW) { labelW = maxW; }
        }
        if (rowW - labelW < app.Scale(60)) { labelW = rowW - app.Scale(60); }
        if (labelW < app.Scale(40)) { labelW = app.Scale(40); }
        int y = by - scroll.Get();

        c.PushClip(bx, by, bw, bh);
        string curSec = "";
        bool curCollapsed = false;
        for (int i = 0; i < data.Count; i = i + 1) {
            PropSpec p = data[i];
            if (p.kind == 5) {
                curSec = p.label;
                curCollapsed = this.IsSectionCollapsed(curSec);
            } else {
                if (curCollapsed) {
                    continue;
                }
            }

            bool onscreen = y + rowH > by && y < by + bh;
            if (onscreen) {
                bool rowHover = Ui.Over(app, bx, y, rowW, rowH)
                    && app.mouseY >= by && app.mouseY < by + bh;
                if (rowHover && p.kind != 5) {
                    c.FillRoundRect(bx, y, rowW, rowH, app.Scale(4), rowHoverStyle.BgOr(0));
                }
                if (p.kind == 5) {
                    int secBarH = app.Scale(24);
                    int secY = y + (rowH - secBarH) / 2;
                    bool secHover = Ui.Over(app, bx, secY, rowW, secBarH)
                        && app.mouseY >= by && app.mouseY < by + bh;
                    if (secHover) {
                        c.FillRoundRect(bx, secY, rowW, secBarH, app.Scale(3), sectionHoverStyle.BgOr(0));
                    } else {
                        c.FillRoundRect(bx, secY, rowW, secBarH, app.Scale(3), sectionStyle.BgOr(0));
                    }
                    c.DrawRoundRect(bx, secY, rowW, secBarH, app.Scale(3), sectionStyle.BorderOr(0), 1);
                    if (Ui.ClickedIn(app, bx, secY, rowW, secBarH)) {
                        this.ToggleSection(curSec);
                        app.RequestRedraw();
                    }
                    int indW = app.Scale(3);
                    int indH = app.Scale(12);
                    int indY = secY + (secBarH - indH) / 2;
                    c.FillRoundRect(bx + app.Scale(6), indY, indW, indH, app.Scale(1), accentStyle.BgOr(sectionStyle.FgOr(0)));
                    int arrowSz = app.Scale(12);
                    int arrowX = bx + app.Scale(13);
                    int arrowY = secY + (secBarH - arrowSz) / 2;
                    c.DrawGlyphIn(curCollapsed ? "chevron-right" : "chevron-down",
                        arrowX, arrowY, arrowSz, arrowSz, arrowSz, sectionStyle.FgOr(0));
                    c.DrawText(bx + app.Scale(28), Canvas.CenterTextY(secY, secBarH, fs),
                        Ellipsis.Fit(p.label, rowW - app.Scale(38), fs), sectionStyle.FgOr(0), fs);
                } else {
                    bool isPair = p.halfRow && (i + 1 < data.Count) && data[i + 1].halfRow && data[i + 1].kind != 5;
                    if (isPair) {
                        int pGap = app.Scale(6);
                        int colW = (rowW - pGap) / 2;
                        PropSpec p2 = data[i + 1];

                        int lW1 = Canvas.MeasureText(p.label, fs) + app.Scale(6);
                        if (lW1 > colW * 45 / 100) { lW1 = colW * 45 / 100; }
                        if (lW1 < app.Scale(20)) { lW1 = app.Scale(20); }

                        int lW2 = Canvas.MeasureText(p2.label, fs) + app.Scale(6);
                        if (lW2 > colW * 45 / 100) { lW2 = colW * 45 / 100; }
                        if (lW2 < app.Scale(20)) { lW2 = app.Scale(20); }

                        this.RenderPropField(app, c, t, i, bx, y, colW, rowH, lW1, fs,
                            valueStyle, accentStyle, rowHoverStyle, stepStyle, stepHoverStyle);

                        this.RenderPropField(app, c, t, i + 1, bx + colW + pGap, y, colW, rowH, lW2, fs,
                            valueStyle, accentStyle, rowHoverStyle, stepStyle, stepHoverStyle);

                        i = i + 1;
                    } else {
                        this.RenderPropField(app, c, t, i, bx, y, rowW, rowH, labelW, fs,
                            valueStyle, accentStyle, rowHoverStyle, stepStyle, stepHoverStyle);
                    }
                }
            }
            y = y + rowH;
        }
        c.PopClip();

        if (overflow) {
            Scrollbar.RenderVerticalScrollIn(app, bx + bw - barW, by, bh, bh,
                contentH, scroll, bx, by, bw, bh);
        }
    }

    // 控件事件清单：公共事件之外提供 "Change"。
    override List<string> Events() {
        List<string> e = Control.CommonEvents();
        e.Add("Change");
        return e;
    }

    // 绑定事件："Change" 接 UiEvent，其余按名称走通用路由。
    override void BindEvent(string evt, Action a) {
        if (evt == "Change") { Change.Add(a); return; }
        On.AddByName(evt, a);
    }

    // <see cref="BindEvent"/> 的 sender 通道（S = Sender）：
    // 特化事件接本控件的 UiEvent，通用事件按名路由。
    override void BindEventS(string evt, ControlEvent a) {
        if (evt == "Change") { Change.AddS(a); return; }
        On.AddByNameS(evt, a);
    }

}
