using System;
using Gui;
using Gui.Widget;

namespace Gui.Component;

// 具名停靠边，布局中写 `DockSide.Left()` 而不是魔法整数。
// Left/Right 是通高列，Bottom 是中央区域下方的条，
// Center 是其他所有面板围绕停靠的区域。
public class DockSide {
    // 左侧通高列。
    static int Left() { return 0; }
    // 右侧通高列。
    static int Right() { return 1; }
    // 中央区域下方的横向条。
    static int Bottom() { return 2; }
    // 其他面板围绕停靠的中央区域。
    static int Center() { return 3; }
}
