using System;
using System.Globalization;
using System.IO;
using Gui;
namespace Gui.Component;
public class FilePickerItem {
    public string name;
    public string path;
    public int kind;
    public string icon;
    public FilePickerItem(string name, string path, int kind) {
        this.name = name;
        this.path = path;
        this.kind = kind;
        this.icon = "";
    }
    public FilePickerItem(string name, string path, int kind, string icon) {
        this.name = name;
        this.path = path;
        this.kind = kind;
        this.icon = icon;
    }
}
