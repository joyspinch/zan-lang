using System;
using System.Globalization;
using System.IO;
using Gui;
using Gui.Backend;
using Gui.Widget;

namespace Gui.Component;

// 列表条目实体（名称 + 路径 + 类型 0:文件 1:文件夹），保证数据一致性。
public class FilePickerItem {
    public string name;
    public string path;
    public int kind;

    public FilePickerItem(string name, string path, int kind) {
        this.name = name;
        this.path = path;
        this.kind = kind;
    }
}
