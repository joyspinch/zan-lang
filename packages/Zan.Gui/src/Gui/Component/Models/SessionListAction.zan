using System;
using Gui;
using Gui.Widget;

namespace Gui.Component;

// SessionList 在单帧内报告的内容：切换、删除或新建聊天点击中至多一个。
// 索引指向调用方自己的标题列表，
// 宿主可直接将它们映射回自己的会话。
public class SessionListAction {
    public int selected;  // 用户点击以切换到的索引，或 -1
    int deleted;  // 其删除按钮 (x) 被点击的索引，或 -1
    public int archived;  // 其归档框被点击的索引，或 -1
    public bool created;  // "新建"按钮被点击
    public int renamed;  // 用户刚为其输入新名称的索引，或 -1
    public string title;  // 该新名称（仅与 `renamed` 一起有意义）

    // 无任何交互发生（所有索引 -1、created=false）。
    static SessionListAction None() {
        SessionListAction a = new SessionListAction();
        a.selected = 0 - 1;
        a.deleted = 0 - 1;
        a.archived = 0 - 1;
        a.created = false;
        a.renamed = 0 - 1;
        a.title = "";
        return a;
    }

    // 本帧有交互需要宿主处理时为 true。
    bool Any() {
        return selected >= 0 || deleted >= 0 || archived >= 0 || created
            || renamed >= 0;
    }
}
