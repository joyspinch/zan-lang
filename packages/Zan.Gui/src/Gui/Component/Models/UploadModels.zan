using System;
using Gui;
using System.IO;
using System.Net.External;
using System.Threading;
using System.Collections.Generic;
namespace Gui.Widget;

internal class UploadAction {
    private weak Upload owner;
    private weak UploadFile item;
    public UploadAction(Upload owner, UploadFile item) {
        this.owner = owner;
        this.item = item;
    }
    public void Open() {
        Upload current = owner;
        if (current != null) { current.OpenDialog(); }
    }
    public void Remove() {
        Upload current = owner;
        UploadFile file = item;
        if (current == null || file == null || current.IsDisabled() || !current.ShowRemoveButton) { return; }
        if (current.Files != null && current.Files.IndexOf(file) >= 0) { current.RemoveItem(file.id); }
    }
    public void Download() {
        Upload current = owner;
        UploadFile file = item;
        if (current == null || file == null || current.IsDisabled() || !current.ShowDownloadButton) { return; }
        if (current.Files == null || current.Files.IndexOf(file) < 0
            || file.status != UploadStatus.Success() || file.url == "") { return; }
        current.LastItem = file;
        current.Download.Raise(current);
    }
    public void Picked() {
        Upload current = owner;
        if (current != null) { current.OnPicked(); }
    }
}

public class UploadFile {
    public int id;
    public string name;
    public string url;
    public string thumb;
    public string path;
    public string message;
    public string response;
    public int size;
    public int status;
    public int percent;
    public string ext;
    public weak Upload owner;
    public UploadFile() {
        id = 0;
        name = "";
        url = "";
        thumb = "";
        path = "";
        message = "";
        response = "";
        size = 0;
        status = UploadStatus.Pending();
        percent = 0;
        ext = "";
    }
    public static string ExtOf(string fileName) {
        string low = fileName.ToLower();
        int i = low.Length - 1;
        while (i >= 0) {
            if (low[i] == 46) { return low.Substring(i + 1); }
            i = i - 1;
        }
        return "";
    }
}

internal class UploadItemState {
    private UploadFile item;
    private int id;
    private string name;
    private string url;
    private string thumb;
    private string path;
    private string ext;
    private string message;
    private int status;
    private int percent;
    public UploadItemState(UploadFile file) {
        item = file; id = file.id; name = file.name; url = file.url;
        thumb = file.thumb; path = file.path; ext = file.ext;
        message = file.message; status = file.status; percent = file.percent;
    }
    public bool Matches(UploadFile file) {
        return item == file && id == file.id && name == file.name && url == file.url
            && thumb == file.thumb && path == file.path && ext == file.ext
            && message == file.message && status == file.status && percent == file.percent;
    }
}

internal class UploadPreparation : AppLoopParticipant, AppPreparationParticipant {
    private weak Upload owner;
    public UploadPreparation(Upload owner) { this.owner = owner; }
    public void Tick(App app, int now) { }
    public int NextDeadline() { return -1; }
    public void BeforeInput(App app, int kind) {
        Upload current = owner;
        if (current != null) { current.PrepareUpload(app, true); }
    }
    public void BeforePaint(App app, int frameSequence) { }
}

public class UploadStatus {
    public static int Pending() { return 0; }
    public static int Uploading() { return 1; }
    public static int Success() { return 2; }
    public static int Error() { return 3; }
}

internal class UploadTile : Control {
    internal Control actions;
    public UploadTile() : base("upload-tile") { }
    internal void SetMask(bool visible) {
        if (actions == null) { return; }
        actions.SetProp("style", "position:absolute;left:0;top:0;width:100%;height:100%;"
            + "display:flex;align-items:center;justify-content:center;background:var(--scrim);"
            + (visible ? "opacity:1;pointer-events:auto" : "opacity:0;pointer-events:none"));
        this.RequestRedraw();
    }
    public override void OnPointerEnter(RoutedEventArgs e) {
        base.OnPointerEnter(e);
        this.SetMask(true);
    }
    public override void OnPointerLeave(RoutedEventArgs e) {
        base.OnPointerLeave(e);
        if (e.x < bx || e.x >= bx + bw || e.y < by || e.y >= by + bh) { this.SetMask(false); }
    }
    public override void OnPointerCancel(RoutedEventArgs e) {
        base.OnPointerCancel(e);
        this.SetMask(false);
    }
}

internal class UploadTreeState {
    private List<UploadFile> files;
    private List<UploadItemState> items;
    private bool disabled;
    private bool dragger;
    private bool pictureCard;
    private bool thumbnail;
    private bool showTrigger;
    private bool showRemove;
    private bool showDownload;
    private string dragText;
    private string triggerText;
    private string tip;
    public UploadTreeState(Upload owner) {
        files = owner.Files;
        items = new List<UploadItemState>();
        for (int i = 0; i < files.Count; i = i + 1) {
            items.Add(new UploadItemState(files[i]));
        }
        disabled = owner.IsDisabled(); dragger = owner.Dragger;
        pictureCard = owner.PictureCard; thumbnail = owner.Thumbnail;
        showTrigger = owner.ShowTrigger; showRemove = owner.ShowRemoveButton;
        showDownload = owner.ShowDownloadButton;
        dragText = owner.DragText; triggerText = owner.TriggerText; tip = owner.Tip;
    }
    public bool Matches(Upload owner) {
        if (files != owner.Files || disabled != owner.IsDisabled() || dragger != owner.Dragger
            || pictureCard != owner.PictureCard || thumbnail != owner.Thumbnail
            || showTrigger != owner.ShowTrigger || showRemove != owner.ShowRemoveButton
            || showDownload != owner.ShowDownloadButton || dragText != owner.DragText
            || triggerText != owner.TriggerText || tip != owner.Tip) { return false; }
        int count = files != null ? files.Count : 0;
        if (items.Count != count) { return false; }
        for (int i = 0; i < count; i = i + 1) {
            if (!items[i].Matches(files[i])) { return false; }
        }
        return true;
    }
}
