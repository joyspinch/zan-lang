namespace Gui.Component;

public class GraphPanAction {
    public weak GraphView owner;

    public GraphPanAction(GraphView graph) { owner = graph; }
    public void Begin() { GraphView graph = owner; if (graph != null) { graph.BeginPan(); } }
    public void End() { GraphView graph = owner; if (graph != null) { graph.EndPan(); } }
}
