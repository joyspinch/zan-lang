using System;
using System.Globalization;
using System.IO;
using Gui;
using Gui.Backend;
using Gui.Widget;

namespace Gui.Component;

// 一个底部扩展名过滤器：显示标签和其以 ";" 分隔的模式
// （"" 匹配所有文件）。用单个实体取代并行的标签/模式列表。
public class FileFilter {
    public string label;
    public string pattern;

    FileFilter(string label, string pattern) {
        this.label = label;
        this.pattern = pattern;
    }
}
