using System;
using System.IO;
using System.Net.External;
using System.Threading;
using Gui;
namespace Gui.Widget;
public class UploadFile {
    public int id;
    public string name;
    public string url;
    public string thumb;
    public string path;
    public string message;
    public string response;
    public int size;
    public int status;
    public int percent;
    public string ext;
    public weak Upload owner;
    public UploadFile() {
        id = 0;
        name = "";
        url = "";
        thumb = "";
        path = "";
        message = "";
        response = "";
        size = 0;
        status = UploadStatus.Pending();
        percent = 0;
        ext = "";
    }
    public static string ExtOf(string fileName) {
        string low = fileName.ToLower();
        int i = low.Length - 1;
        while (i >= 0) {
            if (low[i] == 46) { return low.Substring(i + 1); }
            i = i - 1;
        }
        return "";
    }
}
