using System;
using Gui;
using Gui.Widget;

namespace Gui.Component;

// 一个可停靠面板：稳定 id（用于持久化和查找）、
// 标签页上显示的标题，以及上次布局解析出的内容矩形。
// `headerless` 面板（如 IDE 的文档区）不绘制标签页，也不能被
// 拖拽或关闭——其他面板围绕它们停靠。
public class DockPanel {
    public string id;
    public string title;
    // 宿主面板切换器的图标名（见 DockHost.AddSwitches）。
    public string icon;
    // 一行说明面板用途的文字，显示在其切换器的悬停提示中。
    public string tip;
    public bool closable;
    public bool headerless;
    public bool hidden;
    // 面板上次停靠的边——Show() 将其放回的地方。
    public int home;
    // 关闭时所在分组的 key、在该分组里的标签序号，以及该分组
    // 在同侧分组中的序号——Show() 据此把面板放回原来的位置，
    // 而不是简单地并到该侧最后一个分组的末尾。
    public int homeKey;
    public int homeAt;
    public int homeSideIdx;
    public Rect body;

    // 图标默认 "grid"，初始停靠边为左侧。
    DockPanel(string id, string title, bool closable) {
        this.id = id;
        this.title = title;
        this.icon = "grid";
        this.tip = "";
        this.closable = closable;
        this.headerless = false;
        this.hidden = false;
        this.home = DockSide.Left();
        this.homeKey = 0;
        this.homeAt = 0;
        this.homeSideIdx = 0;
        this.body = new Rect(0, 0, 0, 0);
    }
}
