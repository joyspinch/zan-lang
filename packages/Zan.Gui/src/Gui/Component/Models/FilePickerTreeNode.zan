using System;
using System.Globalization;
using System.IO;
using Gui;
using Gui.Backend;
using Gui.Widget;

namespace Gui.Component;

// 目录树节点实体（路径 + 缩进层级），保证数据一致性。
public class FilePickerTreeNode {
    public string path;
    public int depth;

    public FilePickerTreeNode(string path, int depth) {
        this.path = path;
        this.depth = depth;
    }
}
