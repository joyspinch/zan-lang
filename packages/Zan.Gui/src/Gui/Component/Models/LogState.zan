using System;
using Gui;
using Gui.Widget;

namespace Gui.Component;

// LogView 的滚动和文本选择状态，由调用方持有，
// 使视图在帧间保持位置。
public class LogState {
    public int scroll;  // 从末尾向上滚动的行数；0 表示跟随最新一行
    public int selR0;  // 选择锚点行，无选择时为 -1
    public int selC0;
    public int selR1;  // 选择端点的行/列（可能位于锚点之前）
    public int selC1;
    public bool selDrag;
    public bool barDrag;

    LogState() {
        this.scroll = 0;
        this.selR0 = 0 - 1; this.selC0 = 0;
        this.selR1 = 0 - 1; this.selC1 = 0;
        this.selDrag = false;
        this.barDrag = false;
    }

    // 取消选择（保留滚动位置）。
    void ClearSelection() {
        selR0 = 0 - 1; selC0 = 0;
        selR1 = 0 - 1; selC1 = 0;
    }

    // 选择至少跨越一个字符时为 true。
    bool HasSelection() {
        if (selR0 < 0) { return false; }
        return !(selR0 == selR1 && selC0 == selC1);
    }

    // 回到最新一行并取消选择。
    void Reset() {
        scroll = 0;
        ClearSelection();
    }
}
