using System;
using Gui;
using Gui.Widget;

namespace Gui.Component;

// 结构化日志单行实体（文本 + 可选颜色，消除 lines/colors 平行列表反模式）。
public class LogLine {
    public string text;
    public int color;  // 0 = 主题默认

    public LogLine(string text, int color) {
        this.text = text != null ? text : "";
        this.color = color;
    }

    public static LogLine Of(string text, int color) {
        return new LogLine(text, color);
    }

    public static LogLine OfText(string text) {
        return new LogLine(text, 0);
    }
}
