using System;
using System.Collections.Generic;
using Gui;

namespace Gui.Component;

public class ChatSpeaker {
    public string name;
    public int tint;
    public string tagCls;

    // 组装一位发言者外观。
    public static ChatSpeaker Of(string name, int tint, string tagCls) {
        ChatSpeaker s = new ChatSpeaker();
        s.name = name;
        s.tint = tint;
        s.tagCls = tagCls;
        return s;
    }
}
