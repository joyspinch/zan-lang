using System;
using Gui;
using Gui.Widget;

namespace Gui.Component;

// PropertyGrid 属性行编辑器强类型实体（消除平行列表索引对齐反模式）。
public class PropertyGridRow {
    public Input text;
    public Switch flag;
    public SelectBox pick;
    public List<int> pickSegIds;
    public int minusId;
    public int plusId;
    public string shadow;

    PropertyGridRow() {
        this.text = null;
        this.flag = null;
        this.pick = null;
        this.pickSegIds = new List<int>();
        this.minusId = 0;
        this.plusId = 0;
        this.shadow = "";
    }
}
