using System;
using System.Globalization;
using System.IO;
using Gui;
using Gui.Widget;
namespace Gui.Component;

public class BandGridCell {
    public string text;
    public int num;
    public int mark;
    public BandGridCell(string text, int num, int mark) {
        this.text = text != null ? text : "";
        this.num = num;
        this.mark = mark;
    }
}

public class FileFilter {
    public string label;
    public string pattern;
    public FileFilter(string label, string pattern) {
        this.label = label != null ? label : "";
        this.pattern = pattern != null ? pattern : "";
    }
}

public class FilePickerItem {
    public string name;
    public string path;
    public int kind;
    public string icon;
    public FilePickerItem(string name, string path, int kind) {
        this.name = name != null ? name : "";
        this.path = path != null ? path : "";
        this.kind = kind;
        this.icon = "";
    }
    public FilePickerItem(string name, string path, int kind, string icon) {
        this.name = name != null ? name : "";
        this.path = path != null ? path : "";
        this.kind = kind;
        this.icon = icon != null ? icon : "";
    }
}

public class FilePickerTreeNode {
    public string path;
    public int depth;
    public FilePickerTreeNode(string path, int depth) {
        this.path = path != null ? path : "";
        this.depth = depth;
    }
}

public class GraphCardAction {
    public weak GraphView owner;
    public int row;
    public GraphCardAction(GraphView graph, int index) { owner = graph; row = index; }
    public void Click(Control sender) {
        GraphView graph = owner;
        if (graph != null) { graph.DispatchCardEvent(row, "Click"); }
    }
    public void DoubleClick(Control sender) {
        GraphView graph = owner;
        if (graph != null) { graph.DispatchCardEvent(row, "DoubleClick"); }
    }
    public void RightClick(Control sender) {
        GraphView graph = owner;
        if (graph != null) { graph.DispatchCardEvent(row, "RightClick"); }
    }
}

public class GraphCardSlot {
    public Control card;
    public Tag lockMark;
    public GraphCardSlot(Control card, Tag lockMark) {
        this.card = card;
        this.lockMark = lockMark;
    }
}

public class GraphNode {
    public string id;
    public string title;
    public string tag;
    public string tagClass;
    public string state;
    public string stateClass;
    public int progress;
    public bool done;
    public List<string> deps;
    public string payload;
    public int depth;
    public int lx;
    public int ly;
    public int lw;
    public int lh;
    public static GraphNode Of(string id, string title) {
        GraphNode n = new GraphNode();
        n.id = id != null ? id : "";
        n.title = title != null ? title : "";
        n.tag = "";
        n.tagClass = "";
        n.state = "";
        n.stateClass = "";
        n.progress = 0 - 1;
        n.done = false;
        n.deps = new List<string>();
        n.payload = "";
        n.depth = 0;
        n.lx = 0;
        n.ly = 0;
        n.lw = 0;
        n.lh = 0;
        return n;
    }
    public void After(string depId) {
        if (depId != null && depId != "") { this.deps.Add(depId); }
    }
    public void WithTag(string text, string cls) {
        this.tag = text != null ? text : "";
        this.tagClass = cls != null ? cls : "";
    }
    public void WithState(string text, string cls) {
        this.state = text != null ? text : "";
        this.stateClass = cls != null ? cls : "";
    }
    public void WithProgress(int pct) { this.progress = pct; }
    public void WithPayload(string p) { this.payload = p != null ? p : ""; }
    public void Finished() { this.done = true; }
}
