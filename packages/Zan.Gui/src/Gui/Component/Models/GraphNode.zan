using System;
using Gui;
using Gui.Widget;

namespace Gui.Component;

// 依赖图里的一个节点。
// `deps` 里放前置节点的 id，图的层次、连线和解锁都从它推出来：
// 前置全部 `done` 的节点才可以开工，未满足的节点由图自己标成锁住的
// ——调用方不需要再维护一份「谁可以开始」的并行状态。
// 布局字段（`depth`/`lx`/`ly`/`lw`/`lh`）由 GraphView 每帧写回，读它们
// 可以把浮层、菜单锚到节点上。
public class GraphNode {
    // 调用方命名的稳定 id；deps 引用与 SelectId/IndexOfId 都用它。
    public string id;
    // 卡片标题文本。
    public string title;
    // 负责人之类的短标签，画在标题下方。
    public string tag;
    // 上面那个标签的语义类（`primary`/`success`…），由皮肤取色。
    public string tagClass;
    // 状态短语（进行中 / 待办 / 阻塞…）。
    public string state;
    // 状态短语的语义类（`primary`/`success`…），由皮肤取色。
    public string stateClass;
    // 0..100 的进度；负数表示这个节点不显示进度条。
    public int progress;
    // 该节点已完成：后继节点据此解锁。
    public bool done;
    // 前置节点的 id。
    public List<string> deps;
    // 调用方自己的 payload（索引、路径…），图不解释它。
    public string payload;

    // 布局结果：层号与节点卡片的屏幕矩形。
    public int depth;
    public int lx;
    public int ly;
    public int lw;
    public int lh;

    // 构造节点：id/title 必填；progress = -1（不显示进度条），
    // 未完成、无前置。
    static GraphNode Of(string id, string title) {
        GraphNode n = new GraphNode();
        n.id = id;
        n.title = title;
        n.tag = "";
        n.tagClass = "";
        n.state = "";
        n.stateClass = "";
        n.progress = 0 - 1;
        n.done = false;
        n.deps = new List<string>();
        n.payload = "";
        n.depth = 0;
        n.lx = 0;
        n.ly = 0;
        n.lw = 0;
        n.lh = 0;
        return n;
    }

    // 声明一个前置节点。
    GraphNode After(string depId) {
        if (depId != "") { this.deps.Add(depId); }
        return this;
    }

    // 设置负责人短标签及其语义类（链式）。
    GraphNode WithTag(string text, string cls) {
        this.tag = text;
        this.tagClass = cls;
        return this;
    }

    // 设置状态短语及其语义类（链式）。
    GraphNode WithState(string text, string cls) {
        this.state = text;
        this.stateClass = cls;
        return this;
    }

    // 设置进度（0..100；负数隐藏进度条）。链式。
    GraphNode WithProgress(int pct) {
        this.progress = pct;
        return this;
    }

    // 附带调用方 payload（图不解释其内容）。链式。
    GraphNode WithPayload(string p) {
        this.payload = p;
        return this;
    }

    // 标记完成（后继节点据此解锁）。链式。
    GraphNode Finished() {
        this.done = true;
        return this;
    }
}
