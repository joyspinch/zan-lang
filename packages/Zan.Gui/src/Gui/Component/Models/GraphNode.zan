using System;
using Gui;
namespace Gui.Component;
public class GraphNode {
    public string id;
    public string title;
    public string tag;
    public string tagClass;
    public string state;
    public string stateClass;
    public int progress;
    public bool done;
    public List<string> deps;
    public string payload;
    public int depth;
    public int lx;
    public int ly;
    public int lw;
    public int lh;
    public static GraphNode Of(string id, string title) {
        GraphNode n = new GraphNode();
        n.id = id;
        n.title = title;
        n.tag = "";
        n.tagClass = "";
        n.state = "";
        n.stateClass = "";
        n.progress = 0 - 1;
        n.done = false;
        n.deps = new List<string>();
        n.payload = "";
        n.depth = 0;
        n.lx = 0;
        n.ly = 0;
        n.lw = 0;
        n.lh = 0;
        return n;
    }
    public void After(string depId) {
        if (depId != "") { this.deps.Add(depId); }
    }
    public void WithTag(string text, string cls) {
        this.tag = text;
        this.tagClass = cls;
    }
    public void WithState(string text, string cls) {
        this.state = text;
        this.stateClass = cls;
    }
    public void WithProgress(int pct) { this.progress = pct; }
    public void WithPayload(string p) { this.payload = p; }
    public void Finished() { this.done = true; }
}
