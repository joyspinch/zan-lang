using System;
using Gui;
using Gui.Widget;

namespace Gui.Component;

// 共享同一区域的面板堆栈：顶部是标签条，
// 下方是活动面板的内容。同一侧的分组沿该侧的
// 交叉轴排列（left/right 垂直堆叠，bottom/center 并排），
// 相邻分组之间有可拖拽的分隔条。
public class DockGroup {
    // 在列表变动中保持稳定的身份（停靠时分组会被移动和移除），
    // 代码可以跨一次变更持有一个分组。
    public int key;
    static int nextKey;

    public int side;
    public List<string> ids;
    public int active;
    // 交叉轴尺寸（像素）。首次布局得出实际值前 <= 0
    // `weight`；此后由拖拽分隔手柄决定。
    public int extent;
    public int weight;
    public Rect bounds;
    public Rect header;
    public Rect body;

    // `weight` 是交叉轴的初始占比（各组具体化尺寸前生效）。
    DockGroup(int side, int weight) {
        DockGroup.nextKey = DockGroup.nextKey + 1;
        this.key = DockGroup.nextKey;
        this.side = side;
        this.ids = new List<string>();
        this.active = 0;
        this.extent = 0;
        this.weight = weight;
        this.bounds = new Rect(0, 0, 0, 0);
        this.header = new Rect(0, 0, 0, 0);
        this.body = new Rect(0, 0, 0, 0);
    }
}
