using System;
using System.Collections.Generic;
namespace Gui.Widget;
internal class UploadTreeState {
    private List<UploadFile> files;
    private List<UploadItemState> items;
    private bool disabled;
    private bool dragger;
    private bool pictureCard;
    private bool thumbnail;
    private bool showTrigger;
    private bool showRemove;
    private bool showDownload;
    private string dragText;
    private string triggerText;
    private string tip;
    public UploadTreeState(Upload owner) {
        files = owner.Files;
        items = new List<UploadItemState>();
        for (int i = 0; i < files.Count && i < 128; i = i + 1) {
            items.Add(new UploadItemState(files[i]));
        }
        disabled = owner.IsDisabled(); dragger = owner.Dragger;
        pictureCard = owner.PictureCard; thumbnail = owner.Thumbnail;
        showTrigger = owner.ShowTrigger; showRemove = owner.ShowRemoveButton;
        showDownload = owner.ShowDownloadButton;
        dragText = owner.DragText; triggerText = owner.TriggerText; tip = owner.Tip;
    }
    public bool Matches(Upload owner) {
        if (files != owner.Files || disabled != owner.IsDisabled() || dragger != owner.Dragger
            || pictureCard != owner.PictureCard || thumbnail != owner.Thumbnail
            || showTrigger != owner.ShowTrigger || showRemove != owner.ShowRemoveButton
            || showDownload != owner.ShowDownloadButton || dragText != owner.DragText
            || triggerText != owner.TriggerText || tip != owner.Tip) { return false; }
        int count = files != null ? files.Count : 0;
        if (count > 128) { count = 128; }
        if (items.Count != count) { return false; }
        for (int i = 0; i < count; i = i + 1) {
            if (!items[i].Matches(files[i])) { return false; }
        }
        return true;
    }
}
