using System;

namespace Gui.Component;

public class RibbonSec {
    public int p1x; public int p1y;
    public int p2x; public int p2y;
    public int p3x; public int p3y;
    public int color;
    public double delay;
    public double phase;
    public int dir;

    public double AlphaOf() {
        double sa = Math.Sin(phase);
        return sa <= 0.0 ? 0.0 : sa;
    }
}
