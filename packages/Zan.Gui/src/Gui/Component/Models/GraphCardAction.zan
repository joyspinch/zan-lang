using Gui;

namespace Gui.Component;

public class GraphCardAction {
    public weak GraphView owner;
    public int row;
    public GraphCardAction(GraphView graph, int index) { owner = graph; row = index; }
    public void Click(Control sender) {
        GraphView graph = owner;
        if (graph != null) { graph.DispatchCardEvent(row, "Click"); }
    }
    public void DoubleClick(Control sender) {
        GraphView graph = owner;
        if (graph != null) { graph.DispatchCardEvent(row, "DoubleClick"); }
    }
    public void RightClick(Control sender) {
        GraphView graph = owner;
        if (graph != null) { graph.DispatchCardEvent(row, "RightClick"); }
    }
}
