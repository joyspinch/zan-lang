using System;
using Gui;

namespace Gui;

// 单元格强类型数据实体（替代 texts, nums, marks 三个平行列表反模式）。
public class BandGridCell {
    public string text;
    public int num;
    public int mark;

    BandGridCell(string text, int num, int mark) {
        this.text = text != null ? text : "";
        this.num = num;
        this.mark = mark;
    }
}
