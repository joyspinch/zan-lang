using System;
using System.IO;
using Gui;
using Gui.Widget;

namespace Gui.Component;

/// <summary>
/// 磁盘目录 -> TreeView 节点的薄封装：遍历本身由 System.IO.DirectoryTree
/// 完成，这里只负责把名字变成带真实路径的 TreeNode，让资源管理器、示例
/// 面板、资产面板共用同一份树：
///
///     tree.Bind(FileTree.Nodes(root, "src",
///         PathFilter.Any().Skip(".build"), true, true));
/// </summary>
class FileTree {
    /// 扫描 `dirPath`，目录在前、文件在后，按前序加入 `nodes`。
    /// `withRoot` 为 true 时先加一个代表 `dirPath` 自身的目录节点，
    /// 其内容缩进一级；为 false 时内容直接落在 `depth` 上。
    /// `expandAll` 让所有子目录节点默认展开（示例面板那种一眼看全的树）。
    static void Into(List<TreeNode> nodes, string dirPath, string dirName,
                     int depth, bool expanded, PathFilter f, bool withRoot,
                     bool expandAll) {
        if (!Directory.Exists(dirPath)) { return; }
        int inner = depth;
        if (withRoot) {
            TreeNode d = TreeNode.Dir(dirName, depth, expanded);
            d.path = dirPath;
            nodes.Add(d);
            inner = depth + 1;
        }
        List<string> subs = DirectoryTree.SubNames(dirPath, f);
        for (int i = 0; i < subs.Count; i = i + 1) {
            FileTree.Into(nodes, dirPath + "/" + subs[i], subs[i],
                inner, expandAll, f, true, expandAll);
        }
        List<string> files = DirectoryTree.Names(dirPath, f);
        for (int j = 0; j < files.Count; j = j + 1) {
            TreeNode n = TreeNode.File(files[j], inner);
            n.path = dirPath + "/" + files[j];
            nodes.Add(n);
        }
    }

    /// `Into` 的便捷形式：新建列表返回，可直接 TreeView.Bind。
    static List<TreeNode> Nodes(string dirPath, string dirName, PathFilter f,
                                bool withRoot, bool expanded) {
        List<TreeNode> nodes = new List<TreeNode>();
        FileTree.Into(nodes, dirPath, dirName, 0, expanded, f, withRoot, false);
        return nodes;
    }
}
