using System;
using System.Collections.Generic;
using System.IO;
using Gui;
using Gui.Backend;
using Gui.Widget;

namespace Gui.Component;

// 文件选择器渲染分片：纯声明式对象树与 Flex/Grid 现代盒模型。
// 彻底物理消除所有 Canvas 手工即时模式绘制、AllocId 扁平号段与逐像素排版。
public partial class FilePicker {
    public void RenderWindow() {
        if (!open || popup == null || !popup.needsRedraw) { return; }
        popup.BeginFrame();
        RenderContent(popup);
        popup.RenderChrome(title);
        popup.PresentFrame();
    }

    public void RenderOverlay(App host) {
        if (!open || !inlineMode) { return; }
        Canvas hc = host.canvas;
        StyleBox ov = Style.Part(host, "dialog", "overlay", "", "", "",
                                 Style.SNormal());
        hc.FillRect(0, 0, hc.Width(), hc.Height(), ov.bg);
        host.BlockHitsBelow();
        NativeLayer.Occlude(host, 0, 0, hc.Width(), hc.Height());
        RenderContent(host);
    }

    public void RenderContent(App app) {
        if (this.viewTree == null || this.dirty) {
            this.BuildViewTree(app);
            this.dirty = false;
        }
        int W = app.canvas.Width();
        int H = app.canvas.Height();
        app.RenderBackground(0, 0, W, H, 6);
        int top = app.ContentTop();
        viewTree.MeasureTree(app);
        viewTree.Arrange(0, top, W, H - top);
        viewTree.RenderTree(app);
    }

    public void BuildViewTree(App app) {
        Control root = new Control();
        root.ClassName = "filepicker-root col flex-1";

        string dir = FilePicker.Normalize(pathInput.GetText());
        bool valid = Directory.ExistsUtf8(dir);

        // 1. 顶部导航与搜索栏
        Control header = new Control();
        header.ClassName = "filepicker-header row align-center gap-small";

        Button btnUp = new Button("");
        btnUp.ClassName = "filepicker-icon-btn";
        btnUp.Add(new IconView("arrow-up", 16));
        btnUp.Click.Add(() => {
            string p = FilePicker.ParentDirectory(FilePicker.Normalize(pathInput.GetText()));
            this.Navigate(p);
        });
        header.Add(btnUp);

        Button btnRefresh = new Button("");
        btnRefresh.ClassName = "filepicker-icon-btn";
        btnRefresh.Add(new IconView("refresh", 16));
        btnRefresh.Click.Add(() => {
            this.Navigate(pathInput.GetText());
        });
        header.Add(btnRefresh);

        pathInput.ClassName = "filepicker-path flex-1";
        header.Add(pathInput);

        Input sBox = this.SearchBox();
        sBox.ClassName = "filepicker-search";
        sBox.hint = FilePicker.T("Filter by name...", "按名称筛选...");
        sBox.Submit.Add(() => { this.MarkDirty(); });
        header.Add(sBox);

        Button btnNew = new Button(FilePicker.T("New Folder", "新建文件夹"));
        btnNew.ClassName = "filepicker-btn-new";
        btnNew.Add(new IconView("folder-plus", 16));
        btnNew.Click.Add(() => {
            creatingFolder = !creatingFolder;
            if (creatingFolder) {
                folderInput.SetText(FilePicker.T("New Folder", "新建文件夹"));
            }
            this.MarkDirty();
        });
        header.Add(btnNew);

        root.Add(header);

        // 2. 新建文件夹输入栏
        if (creatingFolder) {
            Control newBar = new Control();
            newBar.ClassName = "filepicker-new-folder row align-center gap-small";
            Label newLbl = new Label(FilePicker.T("Folder name", "文件夹名称"));
            newBar.Add(newLbl);
            folderInput.ClassName = "flex-1";
            newBar.Add(folderInput);
            Button createBtn = new Button(FilePicker.T("Create", "创建"));
            createBtn.ClassName = "primary";
            createBtn.Click.Add(() => { this.OnFolderSubmit(); });
            newBar.Add(createBtn);
            Button cancelCreateBtn = new Button(FilePicker.T("Cancel", "取消"));
            cancelCreateBtn.Click.Add(() => {
                creatingFolder = false;
                this.MarkDirty();
            });
            newBar.Add(cancelCreateBtn);
            root.Add(newBar);
        }

        // 3. 中间区域：左侧快捷导航 + 右侧文件网格/列表
        Control body = new Control();
        body.ClassName = "filepicker-body row flex-1 align-stretch gap-medium";

        // 左侧侧边栏 (Sidebar)
        Control sidebar = new Control();
        sidebar.ClassName = "filepicker-sidebar col";

        Label quickLbl = new Label(FilePicker.T("QUICK ACCESS", "快捷访问"));
        quickLbl.ClassName = "filepicker-section-title";
        sidebar.Add(quickLbl);

        List<FilePickerItem> quickItems = FilePicker.QuickAccessItems();
        for (int qi = 0; qi < quickItems.Count; qi = qi + 1) {
            FilePickerItem qit = quickItems[qi];
            string qpath = qit.path;
            Button qb = new Button(qit.name);
            qb.ClassName = "filepicker-sidebar-item row align-center " + (FilePicker.SamePath(qpath, dir) ? "active" : "");
            qb.Add(new IconView(qit.icon != "" ? qit.icon : "folder", 16));
            qb.Click.Add(() => { this.Navigate(qpath); });
            sidebar.Add(qb);
        }

        Label storageLbl = new Label(FilePicker.T("STORAGE", "此电脑"));
        storageLbl.ClassName = "filepicker-section-title";
        sidebar.Add(storageLbl);

        List<string> roots = Directory.GetRootsUtf8();
        for (int ri = 0; ri < roots.Count; ri = ri + 1) {
            string rpath = roots[ri];
            Button rb = new Button(rpath);
            rb.ClassName = "filepicker-sidebar-item row align-center " + (FilePicker.SamePath(rpath, dir) ? "active" : "");
            rb.Add(new IconView("device-desktop", 16));
            rb.Click.Add(() => { this.Navigate(rpath); });
            sidebar.Add(rb);
        }

        body.Add(sidebar);

        // 右侧文件列表 (Main file area)
        Control mainArea = new Control();
        mainArea.ClassName = "filepicker-main col flex-1";

        List<FilePickerItem> items = new List<FilePickerItem>();
        if (valid) {
            string nameFilter = this.SearchBox().GetText();
            List<string> dirs = Directory.GetDirectoriesFiltered(dir, showHidden.Get());
            for (int di = 0; di < dirs.Count; di = di + 1) {
                if (FilePicker.ContainsText(dirs[di], nameFilter)) {
                    items.Add(new FilePickerItem(dirs[di], FilePicker.Join(dir, dirs[di]), 1));
                }
            }
            if (mode != 0) {
                List<string> files = Directory.GetFilesFiltered(dir, showHidden.Get());
                for (int fi = 0; fi < files.Count; fi = fi + 1) {
                    if (MatchesCurrentFilter(files[fi]) && FilePicker.ContainsText(files[fi], nameFilter)) {
                        items.Add(new FilePickerItem(files[fi], FilePicker.Join(dir, files[fi]), 0));
                    }
                }
            }
        }

        if (items.Count == 0) {
            Control emptyBox = new Control();
            emptyBox.ClassName = "filepicker-empty col align-center justify-center flex-1";
            emptyBox.Add(new Label(FilePicker.T("This folder is empty.", "此文件夹为空。")));
            mainArea.Add(emptyBox);
        } else {
            VirtualList vList = new VirtualList();
            vList.ClassName = "filepicker-vlist flex-1";
            vList.SetRows(items.Count, (idx) => {
                FilePickerItem it = items[idx];
                string itemPath = it.path;
                string itemName = it.name;
                bool isDir = it.kind == 1;
                bool multiPicked = allowMulti && this.InMultiSelection(idx, items);
                bool isSel = selectedPath == itemPath || multiPicked;

                Button rowBtn = new Button("");
                rowBtn.ClassName = "filepicker-row row align-center " + (isSel ? "selected" : "");

                if (allowMulti && !isDir) {
                    Checkbox cb = new Checkbox();
                    cb.SetChecked(multiPicked);
                    rowBtn.Add(cb);
                }

                string icon = isDir ? "folder" : FilePicker.FileIconFor(itemName);
                rowBtn.Add(new IconView(icon, 16));

                Label nameLbl = new Label(itemName);
                nameLbl.ClassName = "flex-1 text-ellipsis";
                rowBtn.Add(nameLbl);

                rowBtn.Click.Add(() => {
                    if (isDir) {
                        if (mode == 0) {
                            nameInput.SetText(itemName);
                            selectedPath = itemPath;
                        }
                    } else {
                        if (allowMulti) {
                            if (multiPicked) {
                                this.RemoveSelectedPath(itemPath);
                            } else {
                                this.selectedPaths.Add(itemPath);
                            }
                        } else {
                            nameInput.SetText(itemName);
                            selectedPath = itemPath;
                        }
                    }
                    this.MarkDirty();
                });

                rowBtn.OnDoubleClick(() => {
                    if (isDir) {
                        this.Navigate(itemPath);
                    } else if (mode == 1) {
                        selectedPath = itemPath;
                        this.TryAccept();
                    }
                });

                return rowBtn;
            });
            mainArea.Add(vList);
        }

        body.Add(mainArea);
        root.Add(body);

        // 4. 底部状态与操作栏
        Control footer = new Control();
        footer.ClassName = "filepicker-footer row align-center gap-medium";

        Label fnLbl = new Label(FilePicker.T("File name", "文件名"));
        footer.Add(fnLbl);

        nameInput.ClassName = "filepicker-name flex-1";
        footer.Add(nameInput);

        Checkbox chkHidden = new Checkbox(FilePicker.T("Show hidden files", "显示隐藏文件"));
        chkHidden.SetChecked(showHidden.Get());
        chkHidden.Change.Add(() => {
            showHidden.Set(chkHidden.IsChecked());
            this.MarkDirty();
        });
        footer.Add(chkHidden);

        if (statusText != "") {
            Label stLbl = new Label(statusText);
            stLbl.ClassName = "filepicker-status";
            footer.Add(stLbl);
        }

        acceptBtn.Text = mode == 1 ? FilePicker.T("Open", "打开") : (mode == 2 ? FilePicker.T("Save", "保存") : FilePicker.T("Select", "选择"));
        acceptBtn.ClassName = "primary";
        acceptBtn.Click.Add(() => { this.TryAccept(); });
        footer.Add(acceptBtn);

        cancelBtn.Text = FilePicker.T("Cancel", "取消");
        cancelBtn.ClassName = "secondary";
        cancelBtn.Click.Add(() => { this.Close(); });
        footer.Add(cancelBtn);

        root.Add(footer);

        this.viewTree = root;
        if (popup != null) {
            popup.SetRootControl(root);
        }
    }
}
