using System;
using System.Collections.Generic;
using Gui;
using Gui.Widget;

namespace Gui.Component;

/// 彩色低多边形飘带背景动画 —— 经典网页彩带（ribbon.js）的移植，
/// 作为 Gui 组件库的一员供应用直接声明使用：
///
///   Ribbon ribbon = new Ribbon(3);
///   // 每帧一次：
///   ribbon.Render(app, x, y, w, h, 40);
///
/// 每条飘带预生成一串三角形分段（p1/p2/p3 顶点），整体从矩形
/// 一侧流向另一侧；每个分段按 sin(phase) 淡入淡出，相位追上后
/// 整条飘带结束、补一条新飘带，保持恒定条数。组件自包含：
/// 按 App 帧时钟推进相位（与调用频率无关），绘制始终裁剪在
/// 矩形内部（顶点越界安全），尺寸变化时按新尺寸重新生成，
/// 并自行重排动画帧——调用方不需要管理计时或重绘。
/// alphaPercent 建议取 26~90（对应原版 colorAlpha 0.1~0.35）。
class Ribbon {
    /// 单个分段：三角形 p1->p2->p3，phase 0..2π 驱动 sin 透明度。
    class Sec {
        internal int p1x; internal int p1y;
        internal int p2x; internal int p2y;
        internal int p3x; internal int p3y;
        internal int color;       // 0xRRGGBB
        internal double delay;    // 出场延迟（每帧 -0.5，<=0 才开始）
        internal double phase;    // 0..2π+
        internal int dir;         // +1 向右 / -1 向左

        /// sin 透明度 0..1（负半周为 0）。
        double AlphaOf() {
            double sa = Math.Sin(phase);
            return sa <= 0.0 ? 0.0 : sa;
        }
    }

    List<List<Sec>> ribbons;
    Random rng;
    int ribbonCount = 3;
    int colorSat = 80;        // HSL 饱和度 %
    int colorLum = 60;        // HSL 亮度 %
    int colorCycle = 6;       // 每段色相步进（0..360）
    double alpha = 0.25;      // 全局不透明度 0..1
    double horizSpeed = 200;  // 水平流速
    double speed = 1.6;       // 相位推进倍率（1 = 原版步进）
    int w;
    int h;
    int lastMs = -1;

    /// 构造：bandCount 条飘带。
    public Ribbon(int bandCount) {
        ribbonCount = bandCount;
        ribbons = new List<List<Sec>>();
        rng = Random.Seeded(20000906);
        w = 0;
        h = 0;
    }

    /// 选择飘带速度倍率（1 = 原版网页步进；默认 1.6 更快）。
    public void SetSpeed(double factor) {
        if (factor <= 0) { return; }
        speed = factor;
    }

    /// 每帧声明一次：推进动画并绘制在 [x,y,w,h] 内部，
    /// 随后自行续接动画帧。调用方先铺好自己的不透明底色。
    public void Render(App app, int x, int y, int w, int h, int alphaPercent) {
        alpha = (double)alphaPercent / 255.0;
        if (w != this.w || h != this.h) {
            this.w = w;
            this.h = h;
            ribbons.Clear();
        }
        int now = app.nowMs;
        int dt = lastMs < 0 ? 33 : now - lastMs;
        lastMs = now;
        if (dt < 0) { dt = 0; }
        if (dt > 100) { dt = 33; }
        // 33ms 一帧时与原版步进一致：phase +0.02 / delay -0.5，
        // 再乘以可选的速度倍率。
        double dPhase = (double)dt * 0.02 * speed / 33.0;
        double dDelay = (double)dt * 0.5 * speed / 33.0;
        for (int a = 0; a < ribbons.Count; a = a + 1) {
            List<Sec> rb = ribbons[a];
            for (int b = 0; b < rb.Count; b = b + 1) {
                Sec s = rb[b];
                if (s.delay > 0) {
                    s.delay = s.delay - dDelay;
                } else {
                    s.phase = s.phase + dPhase;
                }
            }
        }
        // 移除已完成的飘带，维持恒定条数。
        for (int i = ribbons.Count - 1; i >= 0; i = i - 1) {
            if (RibbonDone(ribbons[i])) { ribbons.RemoveAt(i); }
        }
        while (ribbons.Count < ribbonCount) {
            ribbons.Add(NewRibbon());
        }
        Canvas c = app.canvas;
        c.PushClip(x, y, w, h);
        for (int a = 0; a < ribbons.Count; a = a + 1) {
            List<Sec> rb = ribbons[a];
            for (int b = 0; b < rb.Count; b = b + 1) {
                DrawSection(c, rb[b], x, y);
            }
        }
        c.PopClip();
        app.RequestAnimationFrameIn(33, x, y, w, h);
    }

    /// 预生成一条完整飘带（从左/右边缘流向另一侧）。
    List<Sec> NewRibbon() {
        int dir = rng.NextBool() ? 1 : 0 - 1;
        int hide = 200;
        int min = 0 - hide;
        int max = w + hide;
        int startx = dir > 0 ? min : max;
        int syMax = h > 1 ? h : 1;
        int starty = rng.NextBelow(syMax);
        List<Sec> ribbon = new List<Sec>();
        int p1x = startx; int p1y = starty;
        int p2x = startx; int p2y = starty;
        int color = rng.NextBelow(360);
        double delay = 0;
        int stop = 1000;
        while (stop > 0) {
            stop = stop - 1;
            double mv = rng.NextDouble();
            int movex = (int)Math.Round((mv - 0.2) * (double)horizSpeed);
            double mv2 = rng.NextDouble();
            int movey = (int)Math.Round((mv2 - 0.5) * ((double)h * 0.25));
            int p3x = p2x;
            int p3y = p2y;
            if (dir > 0) {
                p3x = p3x + movex;
                p3y = p3y + movey;
                if (p2x >= max) { break; }
            } else {
                p3x = p3x - movex;
                p3y = p3y - movey;
                if (p2x <= min) { break; }
            }
            Sec s = new Sec();
            s.p1x = p1x; s.p1y = p1y;
            s.p2x = p2x; s.p2y = p2y;
            s.p3x = p3x; s.p3y = p3y;
            s.color = Hsl(color, colorSat, colorLum);
            s.delay = delay;
            s.phase = 0;
            s.dir = dir;
            ribbon.Add(s);
            p1x = p2x; p1y = p2y;
            p2x = p3x; p2y = p3y;
            delay = delay + 4;
            color = color + colorCycle;
        }
        return ribbon;
    }

    /// 飘带是否全部淡出。
    bool RibbonDone(List<Sec> ribbon) {
        for (int i = 0; i < ribbon.Count; i = i + 1) {
            Sec s = ribbon[i];
            if (s.phase < 1.0 || s.AlphaOf() > 0.0) { return false; }
        }
        return true;
    }

    /// 画一个分段：纯绘制（相位推进在 Render 中按时间统一做）。
    void DrawSection(Canvas c, Sec s, int ox, int oy) {
        double sa = Math.Sin(s.phase);
        if (sa <= 0.0) { return; }
        if (sa >= 1.0) { sa = 1.0; }
        int alpha255 = (int)(sa * alpha * 255.0);
        if (alpha255 <= 0) { return; }
        int col = ((alpha255 & 255) << 24) | (s.color & 0xFFFFFF);
        FillTriangle(c, s.p1x + ox, s.p1y + oy, s.p2x + ox, s.p2y + oy, s.p3x + ox, s.p3y + oy, col);
    }

    /// 扫描线填充三角形（半透明色逐行 FillRect，跨行重心插值）。
    static void FillTriangle(Canvas c, int x0, int y0, int x1, int y1,
            int x2, int y2, int color) {
        int minY = y0; if (y1 < minY) { minY = y1; } if (y2 < minY) { minY = y2; }
        int maxY = y0; if (y1 > maxY) { maxY = y1; } if (y2 > maxY) { maxY = y2; }
        int ch = c.Height();
        int cw = c.Width();
        if (minY < 0) { minY = 0; }
        if (maxY > ch) { maxY = ch; }
        if (minY >= maxY) { return; }
        int denom = (y1 - y2) * (x0 - x2) + (x2 - x1) * (y0 - y2);
        if (denom == 0) { return; }
        for (int yy = minY; yy <= maxY; yy = yy + 1) {
            int left = cw; int right = 0;
            for (int e = 0; e < 3; e = e + 1) {
                int ax; int ay; int bx; int by;
                if (e == 0) { ax = x0; ay = y0; bx = x1; by = y1; }
                else if (e == 1) { ax = x1; ay = y1; bx = x2; by = y2; }
                else { ax = x2; ay = y2; bx = x0; by = y0; }
                if ((ay <= yy && by > yy) || (by <= yy && ay > yy)) {
                    int xx = ax + (yy - ay) * (bx - ax) / (by - ay);
                    if (xx < left) { left = xx; }
                    if (xx > right) { right = xx; }
                }
            }
            if (right <= left) { continue; }
            if (left < 0) { left = 0; }
            if (right > cw) { right = cw; }
            if (right > left) { c.FillRect(left, yy, right - left, 1, color); }
        }
    }

    /// HSL(0..360, 0..100, 0..100) -> 0xRRGGBB。
    static int Hsl(int hh, int ss, int ll) {
        int c = (100 - Math.Abs(2 * ll - 100)) * ss / 100;
        int hp = hh % 360;
        if (hp < 0) { hp = hp + 360; }
        int x = c * (1 - Math.Abs((hp / 60) % 2 - 1));
        int m = ll - c / 2;
        int r = 0; int g = 0; int b = 0;
        if (hp < 60) { r = c; g = x; }
        else if (hp < 120) { r = x; g = c; }
        else if (hp < 180) { g = c; b = x; }
        else if (hp < 240) { g = x; b = c; }
        else if (hp < 300) { r = x; b = c; }
        else { r = c; b = x; }
        return (((r + m) * 255 / 100) << 16) | (((g + m) * 255 / 100) << 8)
            | ((b + m) * 255 / 100);
    }
}
