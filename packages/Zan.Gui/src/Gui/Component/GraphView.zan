using System;
using System.Collections.Generic;
using Gui;
using Gui.Widget;

namespace Gui.Component;

// 为一个节点构建卡片控件，供节点长相由调用方决定的图使用。
public delegate Control GraphCardOf(GraphNode node);

// 前置未全部完成的节点是锁住的：仍可点开查看，但双击不会触发
// Activate，而是触发 Blocked，让宿主说明还差哪一步。
// 现代架构：PanZoom 画布 + 平滑贝塞尔连线 + 声明式 Card 节点对象树。
// 彻底物理消除底层 AllocId 扁平号段与 RegisterRect 手动命中测试。
public class GraphView : Control {

    // 组件自注册（B-ID44 约定）：注册表由 gen_design_halves.py 扫描
    // 文档引用自动生成，这里声明自己的工厂；重复注册以最后一次为准。
    public static void Install() {
        Gui.ControlFactory.Register("GraphView", (string k) => new GraphView());
    }

    // 调用方的节点，每帧读取；卡片需要重建时调用 Refresh()。
    private List<GraphNode> data;
    private SignalInt sel;
    private bool arrangingGraph;
    private int graphVersion;
    private GraphCardOf tpl;
    // 每个节点一个卡片槽位（包含卡片控件与可选锁标记）。
    private List<GraphCardSlot> slots;
    private bool cardsStale;
    private int builtFor;

    // Pan & Zoom 画布状态
    public int panX;
    public int panY;
    public double zoom;
    private bool dragging;
    private int dragStartX;
    private int dragStartY;
    private int panStartX;
    private int panStartY;

    // 图没有节点时居中显示（"" 不画）。
    public string Empty;

    // 处理器运行期间设置：事件涉及的节点与指针位置。
    private int ctxRow;
    private int ctxX;
    private int ctxY;

    // 节点被选中时（读 SelectedIndex / Selected）。
    public UiEvent Select;
    // 节点被双击且已解锁时（开工）。
    public UiEvent Activate;
    // 双击了锁住的节点时（读 ContextRow，说明还差哪些前置）。
    public UiEvent Blocked;
    // 节点被右键点击时（读 ContextRow / ContextX / ContextY）。
    public UiEvent Context;

    // 构造内部状态：空数据、未选中、默认卡片模板与四个交互事件。
    private void InitGraph() {
        this.InitControl("graph", 5);
        data = new List<GraphNode>();
        sel = new SignalInt(0 - 1);
        arrangingGraph = false;
        tpl = null;
        slots = new List<GraphCardSlot>();
        cardsStale = true;
        builtFor = 0 - 1;
        Empty = "";
        ctxRow = 0 - 1;
        ctxX = 0;
        ctxY = 0;
        panX = 0;
        panY = 0;
        zoom = 1.0;
        dragging = false;
        wiresOwnEvents = false;
        Select = new UiEvent();
        Activate = new UiEvent();
        Blocked = new UiEvent();
        Context = new UiEvent();

        // Pan is a routed content gesture; shared scroll chrome runs first.
    }

    public void BeginPan() {
        if (this.IsDisabled() || !this.StyleVisible()
            || (scroll != null && scroll.Active())) { return; }
        App frame = this.App;
        if (frame == null) { return; }
        dragging = true;
        dragStartX = frame.mouseX;
        dragStartY = frame.mouseY;
        panStartX = panX;
        panStartY = panY;
        frame.CapturePointer(this, true);
    }

    public void EndPan() {
        dragging = false;
        App app = this.App;
        if (app != null && app.GetCapturedPointer() == this
            && (scroll == null || !scroll.Active())) { app.ReleasePointerCapture(); }
    }
    public bool IsPanning() { return dragging; }

    public override void OnPointerDown(RoutedEventArgs e) {
        base.OnPointerDown(e);
        App app = this.App;
        if (e.handled || e.originalSource != this || app == null
            || app.window.EventButton() != 0) { return; }
        this.BeginPan();
        if (dragging) { e.Handle(); }
    }

    private void MovePan(RoutedEventArgs e) {
        App app = this.App;
        if (!dragging || app == null || app.GetCapturedPointer() != this) { return; }
        if (this.IsDisabled() || !this.StyleVisible()) { this.OnPointerCancel(e); return; }
        panX = panStartX + e.x - dragStartX;
        panY = panStartY + e.y - dragStartY;
        this.Arrange(bx, by, bw, bh);
        this.NoteSelfDamage(app);
        e.Handle();
    }

    public override void OnPointerMove(RoutedEventArgs e) { this.MovePan(e); }
    public override void OnPointerUp(RoutedEventArgs e) {
        base.OnPointerUp(e);
        App app = this.App;
        if (app == null || app.window.EventButton() != 0 || !dragging) { return; }
        this.MovePan(e); // The final Up coordinate is authoritative.
        this.EndPan();
    }
    public override void OnPointerCancel(RoutedEventArgs e) {
        if (dragging) { this.EndPan(); e.Handle(); }
        base.OnPointerCancel(e);
    }

    // 默认构造：节点卡片用内置标准控件拼装。
    public GraphView() { InitGraph(); }

    // 自定义节点卡片。
    public GraphView(GraphCardOf template) {
        InitGraph();
        tpl = template;
    }

    // 控件类型标识（序列化/设计器用）。
    public override string Kind() { return "GraphView"; }

    // 覆写：CSS 类型选择器名（"graph"）。
    public override string StyleType() { return "graph"; }

    // 覆写：返回设计器属性清单（empty, panX, panY, zoom）。
    public override List<PropSpec> Props() {
        List<PropSpec> ps = new List<PropSpec>();
        PropSpec empty = PropSpec.Text("empty", "Empty text");
        empty.str = Empty;
        ps.Add(empty);

        PropSpec px = PropSpec.Int("panX", "Pan X");
        px.num = panX;
        ps.Add(px);

        PropSpec py = PropSpec.Int("panY", "Pan Y");
        py.num = panY;
        ps.Add(py);

        return ps;
    }

    public override string GetProp(string key) {
        if (key == "empty") { return Empty; }
        if (key == "panX") { return Convert.ToString(panX); }
        if (key == "panY") { return Convert.ToString(panY); }
        if (key == "zoom") { return Convert.ToString(zoom); }
        return base.GetProp(key);
    }

    public override void SetProp(string key, string val) {
        if (key == "empty") { Empty = val; return; }
        if (key == "panX") { panX = Convert.ToInt32(val); return; }
        if (key == "panY") { panY = Convert.ToInt32(val); return; }
        if (key == "zoom") { zoom = Convert.ToDouble(val); return; }
        base.SetProp(key, val);
    }

    // 覆写：公共事件之外提供 "Select"/"Activate"/"Blocked"/"Context"。
    public override List<string> Events() {
        List<string> e = Control.CommonEvents();
        e.Add("Select");
        e.Add("Activate");
        e.Add("Blocked");
        e.Add("Context");
        return e;
    }

    // 覆写：四个语义事件各挂对应 UiEvent，其余按名称走通用路由。
    public override void BindEvent(string evt, Action a) {
        if (evt == "Select") { Select.Add(a); return; }
        if (evt == "Activate") { Activate.Add(a); return; }
        if (evt == "Blocked") { Blocked.Add(a); return; }
        if (evt == "Context") { Context.Add(a); return; }
        On.AddByName(evt, a);
    }

    // <see cref="BindEvent"/> 的 sender 通道（S = Sender）：
    // 特化事件接本控件的 UiEvent，通用事件按名路由。
    public override void BindEventS(string evt, ControlEvent a) {
        if (evt == "Select") { Select.AddS(a); return; }
        if (evt == "Activate") { Activate.AddS(a); return; }
        if (evt == "Blocked") { Blocked.AddS(a); return; }
        if (evt == "Context") { Context.AddS(a); return; }
        On.AddByNameS(evt, a);
    }

    // ---- 数据 ---------------------------------------------------------------

    // 绑定调用方的节点列表；不复制任何内容。
    public GraphView Bind(List<GraphNode> nodes) {
        graphVersion = graphVersion + 1;
        if (nodes == null) { data = new List<GraphNode>(); }
        else { data = nodes; }
        cardsStale = true;
        if (sel.Get() >= data.Count) { sel.Set(0 - 1); }
        return this;
    }

    // 节点内容变了：下一帧重建卡片。
    public void Refresh() { graphVersion = graphVersion + 1; cardsStale = true; }

    // 共享调用方的选择信号，供在列表重建后保持选择的宿主使用。
    public GraphView BindSel(SignalInt s) {
        if (s != null) { sel = s; }
        return this;
    }

    // 设置空图提示文案（链式）。
    public GraphView EmptyText(string text) { Empty = text; return this; }

    // 订阅选中/激活/拦截/右键事件（链式；组文档覆盖以下四个）。
    public GraphView OnSelect(Action a) { Select.Add(a); return this; }
    // 订阅激活事件：双击未锁定节点时触发（锁定节点走 Blocked）。
    public GraphView OnActivate(Action a) { Activate.Add(a); return this; }
    // 订阅拦截事件：双击锁定的节点时触发，由宿主提示还差哪一步。
    public GraphView OnBlocked(Action a) { Blocked.Add(a); return this; }
    // 订阅右键事件：右键按下节点时触发。
    public GraphView OnContext(Action a) { Context.Add(a); return this; }

    // 节点总数。
    public int Count() { return data.Count; }

    // 行号是否在节点列表范围内。
    public bool Has(int row) { return row >= 0 && row < data.Count; }

    // 第 row 行的节点（越界行为未定义，调用方先用 Has 判断）。
    public GraphNode NodeAt(int row) { return data[row]; }

    // 底层节点列表（调用方的引用，未复制）。
    public List<GraphNode> Nodes() { return data; }

    // 当前选中行号；未选中为 -1。
    public int SelectedIndex() { return sel.Get(); }

    // 是否有有效选中。
    public bool HasSelection() { return this.Has(sel.Get()); }

    // 选中的节点；仅在 HasSelection() 时有效。
    public GraphNode Selected() { return data[sel.Get()]; }

    // 事件处理器涉及的节点行号与指针位置。
    public int ContextRow() { return ctxRow; }
    // 最近一次节点点击/右键记录的指针 X（app 坐标）。
    public int ContextX() { return ctxX; }
    // 最近一次节点点击/右键记录的指针 Y（app 坐标）。
    public int ContextY() { return ctxY; }

    // 按 id 查节点行号；空 id 或未命中返回 -1。
    public int IndexOfId(string id) { return GraphView.IndexOf(data, id); }

    // 按 id 选中节点，并触发 Select（宿主恢复上次选择时用）。
    // 空 id ＝ 取消选择：宿主离开某个节点（回到全局视图）时，图上不该
    // 还高亮着它。
    public void SelectId(string id) {
        if (id == "") { this.Deselect(); return; }
        int i = this.IndexOfId(id);
        if (i < 0 || sel.Get() == i) { return; }
        sel.Set(i);
        Select.PostS(this);
    }

    // 取消选择。不触发 Select（没有节点可读），只清掉高亮。
    public void Deselect() { sel.Set(0 - 1); }

    // 按 id 线性查找行号；空 id 或未命中返回 -1。
    public static int IndexOf(List<GraphNode> ns, string id) {
        if (id == "") { return 0 - 1; }
        for (int i = 0; i < ns.Count; i = i + 1) {
            if (ns[i].id == id) { return i; }
        }
        return 0 - 1;
    }

    // ---- 依赖与解锁 ---------------------------------------------------------

    // `row` 的前置里还没做完的那些 id。空表示它可以开工了。
    // 指向不存在节点的前置被忽略：图只为自己画得出的关系负责，
    // 半截的引用留给宿主自己校验，而不是在这里把节点永久锁死。
    public List<string> PendingDeps(int row) {
        List<string> miss = new List<string>();
        if (!this.Has(row)) { return miss; }
        GraphNode n = data[row];
        for (int i = 0; i < n.deps.Count; i = i + 1) {
            int d = GraphView.IndexOf(data, n.deps[i]);
            if (d < 0 || data[d].done) { continue; }
            miss.Add(n.deps[i]);
        }
        return miss;
    }

    // 前置没做完 —— 节点锁住，双击只会触发 Blocked。
    public bool LockedAt(int row) { return this.PendingDeps(row).Count > 0; }

    // 层号 = 到某个无前置节点的最长路径。用逐轮松弛算，轮数以节点
    // 数为上限：依赖成环时不再变化就停下，图仍然画得出来（环上的边
    // 会同层相连），而不是无限递归下去。
    private void ComputeDepth() {
        for (int i = 0; i < data.Count; i = i + 1) { data[i].depth = 0; }
        int rounds = 0;
        bool moved = true;
        while (moved && rounds < data.Count) {
            moved = false;
            rounds = rounds + 1;
            for (int i = 0; i < data.Count; i = i + 1) {
                GraphNode n = data[i];
                int want = 0;
                for (int k = 0; k < n.deps.Count; k = k + 1) {
                    int d = GraphView.IndexOf(data, n.deps[k]);
                    if (d < 0) { continue; }
                    if (data[d].depth + 1 > want) { want = data[d].depth + 1; }
                }
                if (want > n.depth) {
                    n.depth = want;
                    moved = true;
                }
            }
        }
    }

    // ---- 卡片 ---------------------------------------------------------------

    // 是否使用调用方提供的自定义卡片模板。
    private bool Templated() { return tpl != null; }

    // 每个节点一张卡片。卡片是本控件的子节点，因此由框架测量、
    // 绘制、换肤，画布自己只摆位置、画连线和标记选中/锁住。
    // 纯声明式对象树与标准事件路由，杜绝 AllocId 与 HitTester 手动扁平查表。
    private void BuildCards(App app) {
        if (!cardsStale && builtFor == data.Count) { return; }
        this.RemoveAll();
        slots = new List<GraphCardSlot>();
        for (int i = 0; i < data.Count; i = i + 1) {
            int nodeIndex = i;
            Control card = null;
            Tag mark = null;
            if (this.Templated()) {
                card = tpl(data[i]);
            } else {
                mark = GraphView.LockMark();
                card = GraphView.DefaultCard(data[i], mark);
            }
            if (card == null) { continue; }

            // 挂接 Visual Tree 标准事件驱动
            GraphCardAction action = new GraphCardAction(this, nodeIndex);
            card.Click.AddS(action.Click);
            card.BindEventS("DoubleClick", action.DoubleClick);
            card.BindEventS("RightClick", action.RightClick);

            this.Add(card);
            slots.Add(new GraphCardSlot(card, mark));
        }
        cardsStale = false;
        builtFor = data.Count;
        for (int k = 0; k < slots.Count; k = k + 1) {
            slots[k].card.MeasureTree(app);
        }
    }

    public void DispatchCardEvent(int row, string eventName) {
        if (!this.Has(row)) { return; }
        App app = this.App;
        if (eventName == "Click") { this.OnNodeClick(row, app); }
        else if (eventName == "DoubleClick") { this.OnNodeDoubleClick(row, app); }
        else if (eventName == "RightClick") { this.OnNodeRightClick(row, app); }
    }

    private void OnNodeClick(int index, App app) {
        if (sel.Get() != index) {
            sel.Set(index);
            Select.PostS(this);
        }
        ctxRow = index;
        if (app != null) {
            ctxX = app.mouseX;
            ctxY = app.mouseY;
            this.NoteSelfDamage(app);
        }
    }

    private void OnNodeDoubleClick(int index, App app) {
        ctxRow = index;
        if (app != null) {
            ctxX = app.mouseX;
            ctxY = app.mouseY;
        }
        if (this.LockedAt(index)) {
            Blocked.PostS(this);
        } else {
            Activate.PostS(this);
        }
        if (app != null) { this.NoteSelfDamage(app); }
    }

    private void OnNodeRightClick(int index, App app) {
        if (sel.Get() != index) {
            sel.Set(index);
            Select.PostS(this);
        }
        ctxRow = index;
        if (app != null) {
            ctxX = app.mouseX;
            ctxY = app.mouseY;
            Context.PostS(this);
            this.NoteSelfDamage(app);
        }
    }

    // 内置节点卡片：标题（右上角锁标记）+ 负责人/状态标签 + 进度条，
    // 全是标准控件，卡面本身是标准 Card，`card.graphnode` 及其状态类
    // 在皮肤里。
    private static Card DefaultCard(GraphNode n, Tag mark) {
        Card box = new Card();
        box.Class = "graphnode";
        Panel head = Panel.Row();
        head.Class = "graphnodehead";
        if (mark != null) {
            head.Add(mark);
        }
        Label title = new Label(n.title);
        title.Class = "strong";
        head.Add(title);
        box.Add(head);
        if (n.tag != "" || n.state != "") {
            Panel row = Panel.Row();
            row.Class = "graphnodetags";
            if (n.tag != "") {
                Tag owner = new Tag(n.tag);
                owner.Class = GraphView.TagClass(n.tagClass);
                row.Add(owner);
            }
            if (n.state != "") {
                Tag st = new Tag(n.state);
                st.Class = GraphView.TagClass(n.stateClass);
                row.Add(st);
            }
            box.Add(row);
        }
        if (n.progress >= 0) {
            Progress bar = new Progress(n.progress, 0);
            bar.Class = "graphnodebar";
            box.Add(bar);
        }
        return box;
    }

    // 节点标签一律用小号，语义类由调用方给。
    private static string TagClass(string cls) {
        if (cls == "") { return "small"; }
        return cls + " small";
    }

    // 锁标记：前置没做完时显示的标准标签（默认卡片专用）。
    private static Tag LockMark() {
        Tag mark = new Tag("");
        mark.Icon = "lock";
        mark.Class = "graphnodelock tiny";
        mark.visible = false;
        return mark;
    }

    // ---- 布局 ---------------------------------------------------------------

    // 节点卡片间距（皮肤 graph 件的 gap，缺省 gapLarge）。
    public int Gap() { return this.Gap(this.App); }
    private int Gap(App app) {
        app = this.ResolveApp(app);
        if (app == null) { return 16; }
        StyleBox s = this.ResolveStyle(app, Style.SNormal());
        return s.GapOr(app.theme.gapLarge);
    }

    // 所有卡片统一宽度：图要读的是层次，宽度参差不齐会让同层
    // 的卡片看着像不同的东西。取最宽的那张，再收进可用宽度。
    public int CardWidth(int areaW) { return this.CardWidth(this.App, areaW); }
    private int CardWidth(App app, int areaW) {
        app = this.ResolveApp(app);
        int w = app != null ? app.Scale(140) : 140;
        for (int i = 0; i < slots.Count; i = i + 1) {
            if (slots[i].card.prefW > w) { w = slots[i].card.prefW; }
        }
        if (w > areaW && areaW > 0) { w = areaW; }
        return w;
    }

    // 所有卡片统一高度：取最高的那张（下限 48px 的缩放值）。
    public int CardHeight() { return this.CardHeight(this.App); }
    private int CardHeight(App app) {
        app = this.ResolveApp(app);
        int h = app != null ? app.Scale(48) : 48;
        for (int i = 0; i < slots.Count; i = i + 1) {
            if (slots[i].card.prefH > h) { h = slots[i].card.prefH; }
        }
        return h;
    }

    // 按层排布，写回每个节点的矩形，返回内容总高度。`areaX/areaY`
    // 是内容区左上角（已含滚动偏移）。
    public int Layout(int areaX, int areaY, int areaW) { return this.Layout(this.App, areaX, areaY, areaW); }
    private int Layout(App app, int areaX, int areaY, int areaW) {
        this.ComputeDepth();
        int gap = this.Gap(app);
        int cw = this.CardWidth(app, areaW);
        int ch = this.CardHeight(app);
        int perRow = (areaW + gap) / (cw + gap);
        if (perRow < 1) { perRow = 1; }
        int maxDepth = 0;
        for (int i = 0; i < data.Count; i = i + 1) {
            if (data[i].depth > maxDepth) { maxDepth = data[i].depth; }
        }
        int y = areaY;
        List<int> layer = new List<int>();
        for (int d = 0; d <= maxDepth; d = d + 1) {
            layer.Clear();
            for (int i = 0; i < data.Count; i = i + 1) {
                if (data[i].depth == d) { layer.Add(i); }
            }
            if (layer.Count == 0) { continue; }
            int placed = 0;
            while (placed < layer.Count) {
                int cnt = layer.Count - placed;
                if (cnt > perRow) { cnt = perRow; }
                int rowW = cnt * cw + (cnt - 1) * gap;
                int x = areaX + (areaW - rowW) / 2;
                for (int k = 0; k < cnt; k = k + 1) {
                    GraphNode n = data[layer[placed + k]];
                    n.lx = x + k * (cw + gap);
                    n.ly = y;
                    n.lw = cw;
                    n.lh = ch;
                }
                placed = placed + cnt;
                y = y + ch + gap;
            }
        }
        int total = y - areaY;
        if (total > 0) { total = total - gap; }
        return total;
    }

    // ---- 绘制 ---------------------------------------------------------------

    // 覆写：按需重建节点卡片后量出流式布局的首选高度。
    public override void OnMeasure(App app) {
        this.BuildCards(app);
        int gap = this.Gap(app);
        int areaW = bw - gap * 2;
        if (areaW <= 0) { areaW = app.Scale(320); }
        prefH = this.Layout(app, 0, 0, areaW) + gap * 2;
    }

    public override StyleBox ResolveStyle(App app, int state) {
        StyleBox box = base.ResolveStyle(app, state);
        if (box.overflowCss == 0 - 1) {
            box.overflowY = panX == 0 && panY == 0 ? 2 : 1;
            box.overflow = 1;
        }
        return box;
    }

    public override void OnScrollChanged() {
        if (!arrangingGraph) { this.Arrange(bx, by, bw, bh); }
    }

    public override void Arrange(int px, int py, int pw, int ph) {
        if (arrangingGraph) { return; }
        arrangingGraph = true;
        bx = px; by = py;
        bw = pw > 0 ? pw : 0;
        bh = ph > 0 ? ph : 0;
        App app = this.App;
        if (app == null) { arrangingGraph = false; return; }
        this.BuildCards(app);
        int gap = this.Gap(app);
        Rect view = this.ScrollViewport();
        int areaW = view.width - gap * 2;
        if (areaW < app.Scale(40)) { areaW = app.Scale(40); }
        int contentH = this.Layout(app, view.x + gap, view.y + gap, areaW);
        bool scrolling = panX == 0 && panY == 0;
        if (scrolling && contentH + gap * 2 > view.height) {
            // Shared ScrollState: 4px thumb plus 2px inset, with content margin.
            areaW = areaW - app.Scale(8);
            if (areaW < 1) { areaW = 1; }
            contentH = this.Layout(app, view.x + gap, view.y + gap, areaW);
        }
        scrollExtentX = view.width;
        scrollExtent = scrolling && contentH + gap * 2 > view.height
            ? contentH + gap * 2 : view.height;
        int maximum = scrollExtent - view.height;
        int nextY = scrollY;
        if (nextY < 0) { nextY = 0; }
        if (nextY > maximum) { nextY = maximum; }
        this.CommitScrollOffset(0, nextY);
        this.Layout(app, view.x + gap + panX, view.y + gap + panY - scrollY, areaW);
        if (!this.ArrangeNodes(app)) { arrangingGraph = false; return; }
        // Shrinking out of scroll mode retires an active shared chrome gesture.
        if (scroll != null && scroll.Active() && maximum <= 0) {
            RoutedEventArgs cancel = new RoutedEventArgs("PointerCancel", this, px, py);
            this.ScrollPointerCancel(cancel);
        }
        arrangingGraph = false;
    }

    public override void OnPaint(App app) {
        Canvas c = app.canvas;
        StyleBox s = this.ResolveStyle(app, Style.SNormal());
        s.Paint(app, bx, by, bw, bh);
        if (data.Count == 0) { this.PaintEmpty(app); return; }
        Rect view = this.ScrollViewport();
        c.PushClip(view.x, view.y, view.width, view.height);
        this.PaintEdges(app);
        c.PopClip();
        // Cards and shared chrome are rendered by Control.RenderTree afterwards.
    }

    // 依赖连线：前置卡片底边中点 -> 本节点顶边中点。
    // 采用高品质平滑三次贝塞尔曲线（Cubic Bézier）或平滑折线绘制，末端带指向箭头。
    // 已完成的前置用强调色，未完成的用分隔线色。
    private void PaintEdges(App app) {
        Canvas c = app.canvas;
        int th = app.Scale(1);
        StyleBox edge = Style.Part(app, "graphview", "edge", "", "",
                                   "", Style.SNormal());
        StyleBox doneEdge = Style.Part(app, "graphview", "edge", "", "done",
                                       "", Style.SNormal());
        int edgeCol = edge.BgOr(0);
        int doneEdgeCol = doneEdge.BgOr(0);
        int arrowSz = app.Scale(4);

        for (int i = 0; i < data.Count; i = i + 1) {
            GraphNode n = data[i];
            int nDeps = n.deps.Count;
            if (nDeps == 0) { continue; }
            int x1 = n.lx + (n.lw >> 1);
            int y1 = n.ly;
            int x1_minus_a = x1 - arrowSz;
            int x1_plus_a = x1 + arrowSz;
            int y1_minus_a = y1 - arrowSz;

            for (int k = 0; k < nDeps; k = k + 1) {
                int d = GraphView.IndexOf(data, n.deps[k]);
                if (d < 0) { continue; }
                GraphNode p = data[d];
                int col = p.done ? doneEdgeCol : edgeCol;
                int x0 = p.lx + (p.lw >> 1);
                int y0 = p.ly + p.lh;

                // 平滑三次贝塞尔曲线连接
                GraphView.DrawCubicBezier(c, x0, y0, x1, y1, col, th);

                // 终点箭头
                c.DrawLine(x1_minus_a, y1_minus_a, x1, y1, col, th);
                c.DrawLine(x1_plus_a, y1_minus_a, x1, y1, col, th);
            }
        }
    }

    // 16 阶平滑三次贝塞尔曲线细分算法
    private static void DrawCubicBezier(Canvas c, int x0, int y0, int x1, int y1, int col, int thickness) {
        int dy = y1 - y0;
        int ext = dy > 30 ? (dy / 2) : 25;
        int cy0 = y0 + ext;
        int cy1 = y1 - ext;
        int prevX = x0;
        int prevY = y0;

        for (int step = 1; step <= 16; step = step + 1) {
            double t = (double)step / 16.0;
            double it = 1.0 - t;
            double it2 = it * it;
            double it3 = it2 * it;
            double t2 = t * t;
            double t3 = t2 * t;

            int curX = (int)(it3 * (double)x0 + 3.0 * it2 * t * (double)x0 + 3.0 * it * t2 * (double)x1 + t3 * (double)x1);
            int curY = (int)(it3 * (double)y0 + 3.0 * it2 * t * (double)cy0 + 3.0 * it * t2 * (double)cy1 + t3 * (double)y1);

            c.DrawLine(prevX, prevY, curX, curY, col, thickness);
            prevX = curX;
            prevY = curY;
        }
    }

    // 节点：把卡片摆到算出来的矩形上，并按选中/悬停/锁住换类 ——
    // 选中态、悬停态和锁住态的长相在皮肤里，由卡片自主渲染与处理点击。
    private bool ArrangeNodes(App app) {
        int version = graphVersion;
        List<GraphNode> arrangedData = data;
        List<GraphCardSlot> arrangedSlots = slots;
        int selRow = sel.Get();
        int viewportBottom = by + bh;
        for (int i = 0; i < data.Count; i = i + 1) {
            GraphNode n = data[i];
            bool onscreen = n.ly + n.lh > by && n.ly < viewportBottom;
            Control card = null;
            Tag mark = null;
            if (i < slots.Count) {
                card = slots[i].card;
                mark = slots[i].lockMark;
            }
            if (card == null) { continue; }
            if (this.App != app || graphVersion != version || data != arrangedData
                || slots != arrangedSlots || i >= slots.Count || slots[i].card != card
                || card.parent != this || card.App != app || this.IndexOf(card) < 0) { return false; }
            if (!onscreen && card.visible) {
                app.ReleaseInputSubtree(card);
                // Cancellation may rebind the graph or move this card to another App.
                if (this.App != app || graphVersion != version || data != arrangedData
                    || slots != arrangedSlots || i >= slots.Count || slots[i].card != card
                    || card.parent != this || card.App != app || this.IndexOf(card) < 0) { return false; }
            }
            card.visible = onscreen;

            bool locked = this.LockedAt(i);
            bool isHovered = card.IsHovered();
            if (!this.Templated()) {
                card.Class = GraphView.NodeClass(i == selRow, isHovered, locked);
                if (mark != null) {
                    mark.visible = locked;
                }
            }
            card.MeasureTree(app);
            card.Arrange(n.lx, n.ly, n.lw, n.lh);
        }
        return true;
    }

    // 节点卡片的状态类（预定义常量静态分支，消除每帧临时字符串拼接）。
    private static string NodeClass(bool selected, bool hovered, bool locked) {
        if (selected) {
            return locked ? "graphnode graphnodesel graphnodelocked" : "graphnode graphnodesel";
        }
        if (hovered) {
            return locked ? "graphnode graphnodehover graphnodelocked" : "graphnode graphnodehover";
        }
        return locked ? "graphnode graphnodelocked" : "graphnode";
    }

    // 选中与滚动只改画布自己那块像素，损伤限定在控件矩形内。
    private void NoteSelfDamage(App app) {
        if (!arrangingGraph) { this.Arrange(bx, by, bw, bh); }
        app.NoteDamage(bx, by, bw, bh);
        app.window.Wake();
    }

    // 空图提示（Empty 为空串时不画）。
    private void PaintEmpty(App app) {
        if (Empty == "") { return; }
        StyleBox s = Style.Part(app, "graphview", "empty", "", Class, "",
                                Style.SNormal());
        app.canvas.DrawTextCentered(bx, by, bw, bh, Empty, s.FgOr(0),
            s.FontOr(Style.FontFallback(app, "medium")));
    }
}
