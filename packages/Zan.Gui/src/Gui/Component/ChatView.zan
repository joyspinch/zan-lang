using System;
using System.Collections.Generic;
using Gui;
using Gui.Backend;

namespace Gui.Component;

public delegate void ChatAvatarClick(int msgIndex);
public delegate void ChatQuote(int msgIndex, string text);
public delegate void ChatBubbleMenu(int msgIndex, string selText);
public delegate ChatSpeaker ChatSpeakerOf(string agent);
public delegate string ChatKindLabel(string kind);
public delegate string ChatClock(long at);

public partial class ChatView : Control {

    // 组件自注册（B-ID44 约定）：注册表由 gen_design_halves.py 扫描
    // 文档引用自动生成，这里声明自己的工厂；重复注册以最后一次为准。
    public static void Install() {
        Gui.HeavyControls.Register("ChatView", (string k) => new ChatView());
    }

    // 调用方的消息列表（实时视图，不拷贝）。
    private List<ChatMessage> data;
    private ChatStrings str;
    private ChatSpeakerOf speakerOf;
    private ChatKindLabel kindLabelOf;
    // 排版模式（ChatStyle.Log / ChatStyle.Bubble）。
    private int style;
    // 时刻格式化钩子（null = 组件内置的本机时区 HH:MM）。
    private ChatClock clockOf;
    // 气泡头像被点中时的宿主回调（bubble 模式专用，见 AvatarHit）。
    private ChatAvatarClick avatarClick;
    // 气泡上右键的宿主回调（bubble 模式；null = 不响应右键）。
    private ChatBubbleMenu bubbleMenu;
    // 卡片消息（msg.card）左键单击的宿主回调（null = 卡片不响应单击）。
    private ChatBubbleMenu bubbleActivate;
    // 卡片单击的按下状态：命中消息下标与按下点（未拖动即视为单击）。
    private int actMsg;
    private int actX;
    private int actY;
    // 命中测试要从鼠标坐标换算气泡几何，而点击事件到达时手里没有
    // App 参数——OnPaint 把当帧的 app 缓存下来供 AvatarHit 用。
    private App uiApp;

    // 正在排的那份行表，以及增量重排用的水位线：`cacheTurns` 之前的
    // 轮次已定型，`cachePrefix` 是它们占的行数。
    private List<TextRun> cache;
    private int cacheTurns;
    private int cachePrefix;
    private string cacheKey;
    private string cacheSig;
    // 画出来的那份行表：整份重排要跨好几帧，把半成品直接画出去，看到的
    // 就是「底端锚定的最后一行」一帧一帧往下长——改一次窗口大小，记录就
    // 自己从头滚到底一遍。所以排好的那一份才换上来。
    private List<TextRun> show;
    // 这次重排是整份重排（行号会全部重映射，换上来时要丢掉选区）。
    private bool showStale;

    // 展开的消息下标（工具结果与长代码块共用一份）。
    private List<int> toolOpen;
    private SignalInt thinkOpen;
    private SignalInt scrollSig;
    private LogState sel;
    private bool busy;
    // 记录网格与空态提示：常驻子控件，绘制全在它们内部。
    private StyledText grid;
    private Label emptyLbl;

    // ---- 气泡模式（ChatStyle.Bubble）----------------------------------
    // 气泡不是等高行：每条消息是一个宽度按内容、高度按换行结果的可变
    // 盒子，所以它不走 StyledText 的行网格，而是在这里量一遍、
    // 在 OnPaint 里按同一份几何画。几何按「宽度 + 字号 + 数据签名」
    // 缓存，只在真正变了的那一帧重算——否则每帧重新量一遍
    // MeasureText 会把一段长会话的帧预算吃光。
    // 量好的气泡几何（内容坐标，不含滚动偏移）。
    private List<ChatBubble> bub;
    // 几何缓存对应的输入签名（"" = 还没量过）。
    private string bubKey;
    // 几何的总高度（内容坐标），滚动条的界限由它和视口高算出。
    public int bubH;
    // 本次几何是整份重排（会丢弃选区）。
    private bool bubStale;
    // 气泡模式的像素滚动信号（0 = 贴住最新一条）。
    private SignalInt bscr;
    // 气泡正文的最大宽度比例（千分比），由 `WithBubbleWidth` 给。
    private int bubWMille;
    // 上次量气泡用的布局签名（`BubbleLayoutSig`），变了就是整份重排。
    private string bubSig;
    // 别人的气泡上方显示发言人名字（群聊）。自己发的永远不显示。
    private bool showNames;

    // ---- 气泡模式的文本选择（跨消息）--------------------------------
    // 记录模式的选择走 StyledText 的等高行网格（LogState + 行/列）；
    // 气泡模式的行不是等高的，同一套行列索引在这里没有意义，所以选择
    // 按「消息下标 + 正文内字节偏移」记：(selMsg0, selOff0) 是拖拽起点，
    // (selMsg1, selOff1) 是当前端点，两者谁前谁后由取值比较决定。
    // 偏移是正文（msg.text）里的字节位置，不是展示行里的位置——展示行
    // 随窗口宽度重排，正文偏移不会；窗口一改宽，选区仍框住同一段文字。
    private int selMsg0;
    private int selOff0;
    private int selMsg1;
    private int selOff1;
    private bool selDrag;
    // 宿主回调：用户对某条消息选择「引用」。文本是选中部分（没有选区
    // 就是整条），宿主据此在输入区拉起引用条。
    private ChatQuote quoteCb;

    // 空视图：英文默认文案，常驻的记录网格与空态提示都已建好
    // （是否显示由每帧绘制决定）。
    public ChatView() {
        this.InitControl("chat", 5);
        this.Pad(0);
        this.gap = 0;
        data = null;
        str = ChatStrings.Default();
        speakerOf = null;
        kindLabelOf = null;
        style = 0;
        clockOf = null;
        // 气泡模式的点击落在子网格 StyledText 上，到不了这里；整条
        // 点击链由 AvatarHit 用当帧几何自己判（日志模式它自会退出）。
        // 双击同样由几何判定：气泡的行不是等高的，StyledText 的
        // 行/列命中在气泡模式下没有意义。
        this.OnClick(() => { this.AvatarHit(); });
        this.OnDoubleClick(() => {
            if (uiApp != null && style == ChatStyle.Bubble()) {
                this.BubbleDoubleClick(uiApp);
            }
        });
        cache = new List<TextRun>();
        cacheTurns = 0;
        cachePrefix = 0;
        cacheKey = "";
        cacheSig = "";
        show = new List<TextRun>();
        showStale = false;
        toolOpen = new List<int>();
        thinkOpen = new SignalInt(0);
        scrollSig = new SignalInt(0);
        bub = new List<ChatBubble>();
        bubKey = "";
        bubH = 0;
        bubStale = false;
        bscr = new SignalInt(0);
        bubWMille = 620;
        bubSig = "";
        showNames = false;
        sel = new LogState();
        selMsg0 = 0 - 1; selOff0 = 0;
        selMsg1 = 0 - 1; selOff1 = 0;
        selDrag = false;
        quoteCb = null;
        bubbleMenu = null;
        busy = false;
        grid = new StyledText();
        grid.Grow();
        // 两个子控件按数据互斥显示：显示与否由 OnPaint 决定，而绘制发生在
        // 同一帧的排版之后，所以出生时先都收起来——否则首帧排版会看到两个
        // 满框的兄弟叠在一起（重叠自检会把它报成手打布局事故）。
        grid.SetShown(false);
        this.Add(grid);
        emptyLbl = new Label();
        emptyLbl.wrap = true;
        emptyLbl.Class = "hint small";
        emptyLbl.Grow();
        emptyLbl.SetShown(false);
        this.Add(emptyLbl);
    }

    // 控件类型标识（序列化/设计器用）。
    public override string Kind() { return "ChatView"; }

    // 覆写：CSS 类型选择器名（"log"）。
    public override string StyleType() { return "log"; }

    // ---- 宿主接口 ---------------------------------------------------

    // 绑定调用方的消息列表（实时视图，不拷贝）。
    public ChatView Bind(List<ChatMessage> msgs) {
        data = msgs;
        return this;
    }

    // 全部可见文案（宿主已本地化）。
    public ChatView WithStrings(ChatStrings s) {
        if (s != null) { str = s; }
        this.Invalidate();
        return this;
    }

    // 多智能体会话的外观解析钩子（单助手程序不必调用）。
    public ChatView WithSpeakers(ChatSpeakerOf who, ChatKindLabel kindLabel) {
        speakerOf = who;
        kindLabelOf = kindLabel;
        this.Invalidate();
        return this;
    }

    // 排版模式（ChatStyle.Log / ChatStyle.Bubble）。换了模式要整份重排。
    public ChatView WithStyle(int st) {
        style = st;
        this.Invalidate();
        return this;
    }

    // 时刻格式化钩子（气泡模式的时刻分隔与气泡尾巴小字都走它）。
    public ChatView WithClock(ChatClock c) {
        clockOf = c;
        this.Invalidate();
        return this;
    }

    // 气泡正文的最大宽度（占视口宽的千分比，默认 620 = 六成）。窗口
    // 很宽时一条短消息拉满整屏并不好读，这个上限就是「一句话最长能
    // 占多宽」；窗口变窄时气泡仍然按可用宽度收窄，不会溢出。
    public ChatView WithBubbleWidth(int mille) {
        if (mille < 250) { mille = 250; }
        if (mille > 1000) { mille = 1000; }
        bubWMille = mille;
        this.Invalidate();
        return this;
    }

    // 当前排版模式。
    public int Style() { return style; }

    // 别人的气泡上方是否显示发言人名字（群聊场景）。一对一聊天关掉它：
    // 左边永远只有一个人，名字行只是白占一行高度。
    public ChatView WithSpeakerNames(bool on) {
        showNames = on;
        this.Invalidate();
        return this;
    }

    // 本机时区下这条消息的显示文本；没有记时间的旧消息返回 ""。
    public string Clock(long at) {
        if (clockOf != null) { return clockOf(at); }
        if (at <= 0) { return ""; }
        DateTime d = DateTime.FromUnixSeconds(at).ToLocalTime();
        return Text.Left(d.ToTimeString(), 5);
    }

    // 一条消息头行右侧的本机时区时刻（HH:MM）；没有记时间的旧消息返回 ""。
    public static string ClockText(long at) {
        if (at <= 0) { return ""; }
        DateTime d = DateTime.FromUnixSeconds(at).ToLocalTime();
        return Text.Left(d.ToTimeString(), 5);
    }

    // 模型正在回答：记录末尾显示 busy 行。
    public void SetBusy(bool on) { busy = on; }

    // 选区状态（宿主可持久化或复位）。
    public LogState Selection() { return sel; }

    // 底端锚定的滚动偏移信号（0 = 贴住最新一行）。
    public SignalInt Scroll() { return scrollSig; }

    // 气泡模式的像素滚动偏移信号（0 = 贴住最新一条）。宿主把它接到
    // 自己的滚动记忆上时用；不接也不影响滚轮与拖动。
    public SignalInt BubbleScroll() { return bscr; }

    // 换掉一整份记录（切换会话）：缓存、折叠、选区与滚动全部归零。
    public void Reset() {
        cache = new List<TextRun>();
        cacheTurns = 0;
        cachePrefix = 0;
        cacheKey = "";
        cacheSig = "";
        show = new List<TextRun>();
        showStale = false;
        toolOpen = new List<int>();
        bub = new List<ChatBubble>();
        bubKey = "";
        bubH = 0;
        bubStale = false;
        bscr.Set(0);
        sel.Reset();
        scrollSig.Set(0);
    }

    // 下一帧整份重排（文案、字号或钩子变了）。
    public void Invalidate() {
        cacheKey = "";
        cacheSig = "";
        bubKey = "";
    }

    // 当前选中的文本（未选中则 ""）。气泡模式下回答气泡选区，
    // 记录模式下回答行网格选区——宿主两个模式都可能用。
    public string SelectedText() {
        if (style == ChatStyle.Bubble()) { return this.BubbleSelectionText(); }
        return ChatView.SelectionText(show, sel);
    }

    // 气泡模式下是否有选区（宿主菜单据此决定「复制」是灰的还是亮的）。
    public bool HasSelection() {
        if (style == ChatStyle.Bubble()) { return this.HasBubbleSelection(); }
        return sel.HasSelection();
    }

    // 清空当前选择（气泡/记录两模式通用）。
    public void ClearSelection() {
        if (style == ChatStyle.Bubble()) { this.ClearBubbleSelection(); return; }
        sel.ClearSelection();
    }

    // ---- retained 钩子 ----------------------------------------------

    // 绘制：按有无消息在记录网格与空态提示间切换；消费滚轮、做
    // 增量重排（受时间预算约束），把排好的行、滚动、选区与折叠
    // 状态交给常驻的 StyledText 呈现。
    public override void OnPaint(App app) {
        uiApp = app;
        bool has = data != null && data.Count > 0;
        bool bubMode = style == ChatStyle.Bubble();
        emptyLbl.SetShown(!has && !busy);
        // 记录网格只在记录模式下出现：气泡模式的行不是等高的展示行，
        // 走的是这里自己的几何，网格留着只会把上一份记录又画一遍。
        grid.SetShown(!bubMode && (has || busy));
        if (!has && !busy) {
            emptyLbl.Text = str.empty;
            return;
        }
        if (bubMode) {
            this.TakeBubbleWheel(app);
            this.BuildBubble(app);
            this.BubbleMouse(app);
            this.PaintBubbles(app);
            this.TakeBubbleCopy(app);
            return;
        }
        this.TakeWheel(app);
        this.Build(app);
        grid.lines = show;
        grid.scroll = scrollSig.Get();
        grid.busy = busy;
        grid.sel = sel;
        grid.interactive = true;
        grid.thinkOpen = thinkOpen;
        grid.toolOpen = toolOpen;
        grid.busyText = str.busy;
        // 记录网格自己画纵向滚动条（它才知道行高与可见行数），这里只把同一个
        // 滚动信号交给它，滚轮与拖动于是动的是同一个量。
        grid.scrollBar = scrollSig;
        // StyledText 在绘制时算出最大滚动，绘制发生在子控件那一步，
        // 因此这里读到的是上一帧的界限——足够用来夹住滚动值。
        int max = grid.maxScroll;
        if (scrollSig.Get() > max) { scrollSig.Set(max); }
        if (scrollSig.Get() < 0) { scrollSig.Set(0); }
        this.TakeCopy(app);
    }

    // 宿主注册「气泡头像被点」回调；链式返回自己。
    public ChatView OnAvatarClick(ChatAvatarClick cb) {
        avatarClick = cb;
        return this;
    }

    // 点击命中测试：只有 bubble 模式响应。点击坐标来自缓存的
    // uiApp（事件到达在两帧之间，没有 app 参数），气泡几何与
    // PaintBubbles 同一套换算：先滚动态偏移出每条气泡的 y，
    // 头像在气泡同行一侧（我方在右、对方在左），直径 34 缩放像素。
    public void AvatarHit() {
        if (avatarClick == null || uiApp == null) { return; }
        if (style != ChatStyle.Bubble() || bubKey == "") { return; }
        App app = uiApp;
        if (app.mouseX < bx || app.mouseX >= bx + bw) { return; }
        if (app.mouseY < by || app.mouseY >= by + bh) { return; }
        int pad = app.Scale(12); int padV = app.Scale(10); int avaD = app.Scale(34);
        int viewH = bh - padV * 2; if (viewH < 0) { viewH = 0; }
        int over = bubH - viewH; if (over < 0) { over = 0; }
        int y0 = by + padV - (over - bscr.Get());
        for (int i = 0; i < bub.Count; i = i + 1) {
            ChatBubble b = bub[i];
            if (b.waiting) { continue; }
            int ry = y0 + b.top;
            if (app.mouseY < ry || app.mouseY >= ry + avaD) { continue; }
            int avaX = bx + pad;
            if (b.mine) { avaX = bx + bw - pad - avaD; }
            if (app.mouseX >= avaX && app.mouseX < avaX + avaD) {
                avatarClick(b.idx);
                return;
            }
        }
    }

    /* ---- 气泡模式的正文落点与选择 ---- */

    // 把视口坐标换成「第几条消息、正文第几个字节」。
    // `clamp` 为真时越界的 y 收进最近的一条（拖选时指针拖出视口上下的
    // 常用语义），为假时返回 msg = -1（右键/按键只认真实落点）。
    public ChatHit HitBubble(App app, int mx, int my, bool clamp) {
        ChatHit h = new ChatHit();
        if (bubKey == "" || bub == null || bub.Count == 0) { return h; }
        int pad = app.Scale(12);
        int padV = app.Scale(10);
        int avaD = app.Scale(34);
        int gapA = app.Scale(8);
        int tailW = app.Scale(6);
        int padX = app.Scale(12);
        int padY = app.Scale(9);
        int fontPx = ChatView.BubbleFont(app);
        int lineH = Canvas.FontHeight(fontPx) + app.Scale(3);
        int viewH = bh - padV * 2;
        if (viewH < 0) { viewH = 0; }
        int over = bubH - viewH;
        if (over < 0) { over = 0; }
        int y0 = by + padV - (over - bscr.Get());
        int fallMsg = 0 - 1;
        int fallOff = 0;
        for (int i = 0; i < bub.Count; i = i + 1) {
            ChatBubble b = bub[i];
            if (b.waiting) { continue; }
            int ry = y0 + b.top;
            int rowH = avaD;
            if (b.bh > rowH) { rowH = b.bh; }
            // 纵向含气泡上方的名字/回执行与时刻分隔：落在它们上面也算
            // 落在这条消息上（拖选经过时间分隔不该断掉）。
            int top = ry - b.nameH - b.divH;
            int bottom = ry + rowH;
            if (my < top || my >= bottom) {
                if (!clamp) { continue; }
                // 拖选钳位：指针在第一条之上 → 这条的开头；越过某条
                // 下沿先记成「这条的结尾」，全部走完仍未命中就取它
                // （指针拖到最末条之下 = 选到结尾）。
                if (my < top) { h.msg = b.idx; h.off = 0; return h; }
                fallMsg = b.idx;
                fallOff = 0;
                if (b.linesAt != null && b.linesAt.lines.Count > 0) {
                    int ll = b.linesAt.lines.Count - 1;
                    fallOff = b.linesAt.starts[ll] + b.linesAt.lines[ll].Length;
                }
                continue;
            }
            h.msg = b.idx;
            int bx0 = 0;
            if (b.mine) {
                int avaX = bx + bw - pad - avaD;
                bx0 = avaX - gapA - tailW - b.bw;
            } else {
                int avaX = bx + pad;
                bx0 = avaX + avaD + gapA + tailW;
            }
            // 横向也要落在气泡上：头像、气泡与头像之间的空隙、气泡外侧
            // 的空白都不算「点了这条消息的正文」——否则点头像会顺带
            // 建立起一个空选区。
            if (mx < bx0 || mx >= bx0 + b.bw) { h.msg = 0 - 1; return h; }
            if (b.imgW > 0) { h.off = 0; return h; }
            int tx = bx0 + padX;
            int ty = ry + padY + b.quoteH;
            if (my < ty) { h.off = 0; return h; }
            int li = (my - ty) / lineH;
            if (b.linesAt == null || b.linesAt.lines.Count == 0) { h.off = 0; return h; }
            if (li < 0) { li = 0; }
            int lastLine = b.linesAt.lines.Count - 1;
            if (li >= b.linesAt.lines.Count) {
                h.off = b.linesAt.starts[lastLine] + b.linesAt.lines[lastLine].Length;
                return h;
            }
            string ln = b.linesAt.lines[li];
            int col = LogView.ColAt(ln, tx, fontPx, mx);
            col = Text.ClampCharStart(ln, col);
            h.off = b.linesAt.starts[li] + col;
            return h;
        }
        if (clamp && fallMsg >= 0) { h.msg = fallMsg; h.off = fallOff; }
        return h;
    }

    // 选择区间归一化后的两端（谁在文档里靠前谁当起点）。
    public void SelRange(out int m0, out int o0, out int m1, out int o1) {
        m0 = selMsg0; o0 = selOff0; m1 = selMsg1; o1 = selOff1;
        if (m0 < 0) { return; }
        if (m1 < 0) { m1 = m0; o1 = o0; return; }
        bool swap = m1 < m0 || (m1 == m0 && o1 < o0);
        if (swap) {
            int tm = m0; m0 = m1; m1 = tm;
            int to = o0; o0 = o1; o1 = to;
        }
    }

    // 气泡模式下选中的文本（跨消息拼接，未选中为 ""）。
    public string BubbleSelectionText() {
        if (selMsg0 < 0 || data == null) { return ""; }
        int m0 = 0; int o0 = 0; int m1 = 0; int o1 = 0;
        this.SelRange(out m0, out o0, out m1, out o1);
        if (m0 == m1 && o0 == o1) { return ""; }
        string outp = "";
        int last = m1;
        if (last >= data.Count) { last = data.Count - 1; }
        for (int m = m0; m <= last; m = m + 1) {
            if (m < 0) { continue; }
            string t = data[m].text;
            int s = 0;
            int e = t.Length;
            if (m == m0) { s = o0; }
            if (m == m1) { e = o1; }
            s = Text.ClampCharStart(t, s);
            e = Text.ClampCharStart(t, e);
            if (s < 0) { s = 0; }
            if (e > t.Length) { e = t.Length; }
            if (s > e) { s = e; }
            if (outp.Length > 0) { outp = outp + "\n"; }
            outp = outp + t.Substring(s, e - s);
        }
        return outp;
    }

    // 有选区（跨一个字符即算）。
    public bool HasBubbleSelection() {
        if (selMsg0 < 0 || selMsg1 < 0) { return false; }
        return !(selMsg0 == selMsg1 && selOff0 == selOff1);
    }

    // 清掉气泡选区。
    public void ClearBubbleSelection() {
        selMsg0 = 0 - 1; selOff0 = 0;
        selMsg1 = 0 - 1; selOff1 = 0;
        selDrag = false;
    }

    // 起始偏移落在某个字符中间时钳到边界（拖选端点不得切开多字节字符）。
    public ChatHit SnapHit(ChatHit h) {
        if (h.msg < 0 || data == null || h.msg >= data.Count) { return h; }
        h.off = Text.ClampCharStart(data[h.msg].text, h.off);
        return h;
    }

    // 气泡模式的鼠标处理：按下起选、移动续选、松开收尾、双击选整条、
    // 右键把落点交给宿主菜单。滚动拖动与头像点击优先，命中不了正文
    // 的落点不建立选区。
    public void BubbleMouse(App app) {
        if (bubKey == "") { return; }
        int kind = app.EventKind();
        bool inside = app.mouseX >= bx && app.mouseX < bx + bw
            && app.mouseY >= by && app.mouseY < by + bh;
        if (kind == 1) {
            if (selDrag) {
                ChatHit h = this.SnapHit(this.HitBubble(app, app.mouseX, app.mouseY, true));
                if (h.msg >= 0) {
                    selMsg1 = h.msg;
                    selOff1 = h.off;
                    app.RequestRedraw();
                }
            }
            return;
        }
        if (kind == 2 && app.window.EventButton() == 0) {
            if (app.PointerCaptured()) { return; }
            ChatHit h = this.SnapHit(this.HitBubble(app, app.mouseX, app.mouseY, false));
            if (h.msg < 0) {
                // 点在空白/头像上：清掉旧选区（头像点击由 Click 那条链管）。
                if (this.HasBubbleSelection()) {
                    this.ClearBubbleSelection();
                    app.RequestRedraw();
                }
                this.actMsg = -1;
                return;
            }
            // 卡片消息：按下只记命中与落点，不建选区——单击（未拖出
            // 按下泡）在松开帧交给宿主 OnBubbleActivate。
            if (data[h.msg].card) {
                this.actMsg = h.msg;
                this.actX = app.mouseX;
                this.actY = app.mouseY;
                return;
            }
            this.actMsg = -1;
            selMsg0 = h.msg; selOff0 = h.off;
            selMsg1 = h.msg; selOff1 = h.off;
            selDrag = true;
            app.RequestRedraw();
            return;
        }
        if (kind == 3) {
            if (app.window.EventButton() == 0 && selDrag) {
                selDrag = false;
                app.RequestRedraw();
                return;
            }
            // 浮层（宿主气泡菜单）开着时释放不得再触发卡片激活与
            // 右键菜单：按下那一步已被 PointerCaptured 收走，释放
            // 这一步必须同源收走，否则点在浮层上会顺手激活它下面
            // 的那张卡片。
            if (app.PointerCaptured()) {
                this.actMsg = -1;
                return;
            }
            // 卡片单击：松开还在同一泡、且基本没挪动才算（拖动手势
            // 不触发，交给滚动/选区语义）。
            if (app.window.EventButton() == 0 && this.actMsg >= 0
                    && bubbleActivate != null && inside) {
                ChatHit h = this.SnapHit(this.HitBubble(app, app.mouseX, app.mouseY, false));
                int dx = app.mouseX - this.actX;
                int dy = app.mouseY - this.actY;
                if (h.msg == this.actMsg && dx * dx + dy * dy <= 64) {
                    this.actMsg = -1;
                    bubbleActivate(h.msg, data[h.msg].text);
                    app.RequestRedraw();
                    return;
                }
            }
            this.actMsg = -1;
            // 右键：把落点与当前选中交给宿主菜单。组件不带菜单文案。
            if (app.window.EventButton() == 1 && bubbleMenu != null && inside) {
                ChatHit h = this.SnapHit(this.HitBubble(app, app.mouseX, app.mouseY, false));
                if (h.msg >= 0) {
                    string selTxt = this.BubbleSelectionText();
                    if (selTxt == "") { selTxt = data[h.msg].text; }
                    bubbleMenu(h.msg, selTxt);
                    app.RequestRedraw();
                }
            }
            return;
        }
    }

    // 双击选整条（IM 惯例：双击一条消息选中它，右键即可引用/复制）。
    public void BubbleDoubleClick(App app) {
        if (bubKey == "" || data == null) { return; }
        ChatHit h = this.HitBubble(app, app.mouseX, app.mouseY, false);
        if (h.msg < 0 || h.msg >= data.Count) { return; }
        if (data[h.msg].card) { return; }
        selMsg0 = h.msg; selOff0 = 0;
        selMsg1 = h.msg; selOff1 = data[h.msg].text.Length;
        app.RequestRedraw();
    }

    // 宿主注册「气泡被右键」回调（复制/引用/转发一类菜单由宿主出）。
    public ChatView OnBubbleMenu(ChatBubbleMenu cb) {
        bubbleMenu = cb;
        return this;
    }

    // 宿主注册「卡片消息被单击」回调（任务卡片一类整体即入口的消息；
    // 只对 msg.card = true 的消息生效，见 BubbleMouse）。
    public ChatView OnBubbleActivate(ChatBubbleMenu cb) {
        bubbleActivate = cb;
        return this;
    }

    // 宿主注册「引用了一条消息」回调（选中部分或整条）。
    public ChatView OnQuote(ChatQuote cb) {
        quoteCb = cb;
        return this;
    }

    // 消息的显示名（引用块里标「引用谁」用；与气泡上方的发言人同一口径）。
    public string NameOf(int idx) {
        if (data == null || idx < 0 || idx >= data.Count) { return ""; }
        ChatMessage m = data[idx];
        if (m.role == "user") { return str.you; }
        return this.SpeakerName(m);
    }

    // 指针在气泡区上时滚轮滚动：气泡是像素滚动的，一档滚 40px（约一
    // 行多一点），而不是记录模式的一整行。
    public void TakeBubbleWheel(App app) {
        // 认领以真溢出为前提：内容放得下视口时不认领，滚轮穿透给
        // 外层容器/页面（认领了 bscr 也只会被钳回 0 白吃一格）。
        int padV = app.Scale(10);
        int viewH = bh - padV * 2;
        int over = bubH - viewH;
        if (over <= 0) { return; }
        if (!app.CaptureWheel(bx, by, bw, bh)) { return; }
        int d = app.window.EventKeyCode();
        int step = d / 120;
        if (step == 0) {
            if (d > 0) { step = 1; }
            else if (d < 0) { step = 0 - 1; }
        }
        // bscr 是「离底部多少像素」（与记录模式的 scrollSig 同一语义：
        // 0 = 贴住最新一条）。滚轮向上 = step 为正 = 要看更旧的内容 =
        // 离底部更远，所以是加不是减——此前这里写成减号，滚轮方向整个
        // 反了（向上滚反而跳到最新）。
        bscr.Set(bscr.Get() + step * app.Scale(40));
        if (bscr.Get() > over) { bscr.Set(over); }
        if (bscr.Get() < 0) { bscr.Set(0); }
        app.RequestRedraw();
    }

    // 指针在记录上时滚轮滚动。
    public void TakeWheel(App app) {
        // 认领以真溢出为前提：grid.maxScroll 是上一帧绘制算出的界限
        // （本帧绘制在子控件那步才更新），跨界时认领晚一帧，无害；
        // 记录放得下时不认领，滚轮穿透给外层。
        if (grid.maxScroll <= 0) { return; }
        if (!app.CaptureWheel(bx, by, bw, bh)) { return; }
        int d = app.window.EventKeyCode();
        int step = d / 120;
        if (step == 0) {
            if (d > 0) { step = 1; }
            else if (d < 0) { step = 0 - 1; }
        }
        scrollSig.Set(scrollSig.Get() + step);
        app.RequestRedraw();
    }

    // 指针在记录上时 Ctrl+C 复制选中的文本。
    public void TakeCopy(App app) {
        if (app.EventKind() != 4) { return; }
        if (app.window.EventKeyCode() != 67) { return; }
        if (!Modifiers.HasCtrl(app.window.EventMods())) { return; }
        if (!sel.HasSelection()) { return; }
        if (app.mouseX < bx || app.mouseX > bx + bw) { return; }
        if (app.mouseY < by || app.mouseY > by + bh) { return; }
        Clipboard.SetText(this.SelectedText());
        app.RequestRedraw();
    }

    // 气泡模式下 Ctrl+C 复制选区、Ctrl+A 全选当前会话。
    // 按键是窗口级事件，不要求指针正悬在控件上（记录模式那条
    // 旧口径要求鼠标在框内，是当年点选语义的遗留；键盘复制不该
    // 因为鼠标恰好移开了就失效）。命中区间用本控件的矩形限定：
    // 一个窗口里叠着多个 ChatView 时不让它们一起响应。
    public void TakeBubbleCopy(App app) {
        if (app.EventKind() != 4) { return; }
        if (!Modifiers.HasCtrl(app.window.EventMods())) { return; }
        int code = app.window.EventKeyCode();
        if (code == 67) {  // Ctrl+C
            if (!this.HasBubbleSelection()) { return; }
            if (app.mouseX < bx || app.mouseX > bx + bw) { return; }
            if (app.mouseY < by || app.mouseY > by + bh) { return; }
            Clipboard.SetText(this.BubbleSelectionText());
            app.RequestRedraw();
            return;
        }
        if (code == 65) {  // Ctrl+A：全选
            if (data == null || data.Count == 0) { return; }
            if (app.mouseX < bx || app.mouseX > bx + bw) { return; }
            if (app.mouseY < by || app.mouseY > by + bh) { return; }
            selMsg0 = 0; selOff0 = 0;
            selMsg1 = data.Count - 1;
            selOff1 = data[data.Count - 1].text.Length;
            app.RequestRedraw();
        }
    }
}
