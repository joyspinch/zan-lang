using System;
using System.Collections.Generic;
using Gui;
using Gui.Component;
namespace Gui.Widget;
public partial class Upload {
    private void EnsurePicker() {
        if (picker != null) { return; }
        picker = new FilePicker();
        UploadAction action = new UploadAction(this, null);
        picker.Accepted.Add(action.Picked);
    }
    public void OpenDialog() {
        if (this.IsDisabled()) { return; }
        this.EnsurePicker();
        ChildWindows.RegisterComponentPicker(picker);
        App app = this.App;
        if (app != null) { picker.ApplySkin(app.ThemeMenuIndex()); }
        picker.SetMaxSelect(Max);
        if (Multiple || Max > 1) {
            picker.BeginOpenFileFiltersMulti("", this.BuildFilters(), "选择文件");
        } else {
            picker.BeginOpenFileFilters("", this.BuildFilters(), "选择文件");
        }
        if (app != null) { app.RequestRedraw(); }
    }
    public void CloseDialog() {
        if (picker != null) { picker.Close(); }
    }
    public FilePicker Picker() { return picker; }
    internal void OnPicked() {
        if (this.IsDisabled() || picker == null) { return; }
        if (Multiple || Max > 1) {
            List<string> many = picker.SelectedPaths();
            if (many != null && many.Count > 0) { this.AddPaths(many); }
            return;
        }
        string p = picker.SelectedPath();
        if (p == null || p == "") { return; }
        List<string> one = new List<string>();
        one.Add(p);
        this.AddPaths(one);
    }
    private List<FileFilter> BuildFilters() {
        List<FileFilter> items = new List<FileFilter>();
        if (Accept != null && Accept != "") {
            string acc = Accept.ToLower();
            StringBuilder pats = new StringBuilder();
            int start = 0;
            int len = acc.Length;
            for (int i = 0; i <= len; i = i + 1) {
                if (i == len || (acc[i] & 255) == 44 || (acc[i] & 255) == 59) {
                    if (i > start) {
                        string tok = acc.Substring(start, i - start).Trim();
                        if (tok != "") {
                            if (tok.StartsWith("*.")) { }
                            else if (tok.StartsWith(".")) { tok = "*" + tok; }
                            else { tok = "*." + tok; }
                            if (pats.Length > 0) { pats.Append(";"); }
                            pats.Append(tok);
                        }
                    }
                    start = i + 1;
                }
            }
            if (pats.Length > 0) {
                string patStr = pats.ToString();
                items.Add(new FileFilter("接受的文件 (" + patStr + ")", patStr));
            }
        }
        items.Add(new FileFilter("所有文件 (*.*)", ""));
        return items;
    }
    public bool DialogOpen() { return picker != null && picker.IsOpen(); }
    public bool DialogNeedsRedraw() { return picker != null && picker.NeedsRedraw(); }
    public bool OwnsEventWindow(nint evh) { return picker != null && picker.OwnsWindow(evh); }
    public nint DialogWindowHandle() { return picker != null ? picker.PopupWindowHandle() : 0; }
    public bool ApplyEventWindow(nint evh) {
        if (picker == null || !picker.OwnsWindow(evh)) { return false; }
        return picker.ApplyEvent(evh);
    }
    public void RenderDialog() {
        if (picker != null) { picker.RenderWindow(); }
    }
    public int TakeDialogResult() {
        if (picker == null) { return 0; }
        return picker.TakeResult();
    }
    public void SweepDialogClosed() {
        if (picker != null) { picker.SweepClosed(); }
    }
}
