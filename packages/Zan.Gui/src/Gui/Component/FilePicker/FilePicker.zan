    public void MarkDirty() {
        this.dirty = true;
        this.viewRevision = this.viewRevision + 1;
        if (inputHost != null) { inputHost.MarkDirty(); }
        else if (popup != null) { popup.RequestRedraw(); }
    }
    public FilePicker() {
        this.pathInput = new Input("path");
        this.pathInput.Submit.Add(new FilePickerAction(this).SubmitPath);
        this.nameInput = new Input("file name");
        this.nameInput.Submit.Add(new FilePickerAction(this).Accept);
        this.folderInput = new Input("folder name");
        this.folderInput.Submit.Add(new FilePickerAction(this).SubmitFolder);
        this.searchInput = null;
        this.treeScroll = new SignalInt(0);
        this.listScroll = new SignalInt(0);
        this.showHidden = new SignalBool(false);
        this.popup = null;
        this.acceptBtn = new Button { Class = "primary" };
        this.cancelBtn = new Button { Class = "secondary" };
        this.acceptBtn.Click.Add(new FilePickerAction(this).Accept);
        this.cancelBtn.Click.Add(new FilePickerAction(this).Close);
        this.footerBar = new Flex();
        this.footerBar.ClassName = "row justify-end align-center gap-medium";
        this.footerBar.Add(this.cancelBtn);
        this.footerBar.Add(this.acceptBtn);
        this.inlineMode = false;
        this.open = false;
        this.closing = false;
        this.creatingFolder = false;
        this.treeDragging = false;
        this.listDragging = false;
        this.treeDragOffset = 0;
        this.listDragOffset = 0;
        this.mode = 0;
        this.result = 0;
        this.skinIndex = 0;
        this.title = "";
        this.suffix = "";
        this.selectedPath = "";
        this.selectedPaths = new List<string>();
        this.anchorIdx = 0 - 1;
        this.allowMulti = false;
        this.maxSelect = 0;
        this.statusText = "";
        this.lastFilter = "";
        this.lastDir = "";
        this.expanded = new List<string>();
        this.filters = new List<FileFilter>();
        this.filterSel = new SignalInt(0);
        this.filterOpen = false;
        this.filtersCustom = false;
        this.Accepted = new UiEvent();
        this.Cancelled = new UiEvent();
        this.Closed = new UiEvent();
        this.PathChanged = new UiEvent();
        this.FilterChanged = new UiEvent();
    }
    public void SetFilters(List<FileFilter> items) {
        filters = items;
        filtersCustom = true;
        filterSel.Set(0);
    }
    public Input SearchBox() {
        if (searchInput == null) {
            searchInput = new Input(
                FilePicker.T("Filter by name...", "按名称筛选..."));
            searchInput.Submit.Add(new FilePickerAction(this).Filter);
        }
        return searchInput;
    }
    public static string T(string en, string zh) { return Lang.Tr(en, zh); }
    public static string Normalize(string path) {
        if (path == null) { return ""; }
        string resultText = path.Replace("\\", "/");
        while (resultText.Length > 3
               && (resultText[resultText.Length - 1] & 255) == 47) {
            resultText = resultText.Substring(0, resultText.Length - 1);
        }
        return resultText;
    }
    public static string LowerAscii(string text) {
        if (text == null) { return ""; }
        return text.ToLower();
    }
    public static bool EndsWith(string text, string ending) {
        if (ending == null || ending == "") { return true; }
        if (text == null) { return false; }
        return text.ToLower().EndsWith(ending.ToLower());
    }
    public static string Join(string dir, string name) {
        if (dir == null) { return name == null ? "" : name; }
        if (name == null) { return dir; }
        if (dir.Length > 0 && (dir[dir.Length - 1] & 255) == 47) { return dir + name; }
        return dir + "/" + name;
    }
    public static string ParentDirectory(string dir) {
        string parent = FilePicker.Normalize(Path.GetDirectoryName(dir));
        if (parent.Length == 2
            && (parent[1] & 255) == 58) {
            parent = parent + "/";
        }
        return parent;
    }
    public static string ValidDirectory(string initial) {
        string dir = FilePicker.Normalize(initial);
        if (Directory.FileExistsUtf8(dir)) { dir = FilePicker.ParentDirectory(dir); }
        if (Directory.ExistsUtf8(dir)) { return dir; }
        if (Directory.ExistsUtf8(".")) {
            string cwd = Directory.GetCurrentDirectory();
            return cwd == "" ? "." : FilePicker.Normalize(cwd);
        }
        return "";
    }
    public static string RootOf(string dir) {
        dir = FilePicker.Normalize(dir);
        if (dir.Length >= 3 && (dir[1] & 255) == 58 && (dir[2] & 255) == 47) { return dir.Substring(0, 3); }
        if (dir.Length > 0 && (dir[0] & 255) == 47) { return "/"; }
        return dir;
    }
    public static bool ValidFolderName(string name) {
        if (name == null || name == "" || name == "." || name == "..") { return false; }
        for (int i = 0; i < name.Length; i = i + 1) {
            int c = name[i] & 255;
            if (c == 47 || c == 92) { return false; }
        }
        return true;
    }
    public static bool SamePath(string a, string b) {
        return FilePicker.LowerAscii(a) == FilePicker.LowerAscii(b);
    }
    public bool IsExpanded(string path) {
        for (int i = 0; i < expanded.Count; i = i + 1) {
            if (FilePicker.SamePath(expanded[i], path)) { return true; }
        }
        return false;
    }
    public void Expand(string path) {
        if (!IsExpanded(path)) { expanded.Add(path); }
    }
    public void Collapse(string path) {
        List<string> keep = new List<string>();
        for (int i = 0; i < expanded.Count; i = i + 1) {
            if (!FilePicker.SamePath(expanded[i], path)) { keep.Add(expanded[i]); }
        }
        expanded = keep;
    }
    public void ExpandAncestors(string dir) {
        string current = FilePicker.Normalize(dir);
        for (int guard = 0; current != "" && guard < 128; guard = guard + 1) {
            Expand(current);
            string parent = FilePicker.ParentDirectory(current);
            if (parent == "" || parent == current) { break; }
            current = parent;
        }
    }
    public static List<FilePickerItem> QuickAccessItems() {
        List<FilePickerItem> items = new List<FilePickerItem>();
        AddQuickIfValid(items, FilePicker.T("Desktop", "桌面"), KnownFolders.Desktop(), "device-desktop");
        AddQuickIfValid(items, FilePicker.T("Downloads", "下载"), KnownFolders.Downloads(), "download");
        string home = KnownFolders.Home();
        if (home != "") {
            string pics = Path.Combine(home, "Pictures");
            AddQuickIfValid(items, FilePicker.T("Pictures", "图片"), pics, "photo");
        }
        AddQuickIfValid(items, FilePicker.T("Documents", "文档"), KnownFolders.Documents(), "file-text");
        AddQuickIfValid(items, FilePicker.T("Home", "主目录"), home, "home");
        return items;
    }
    public static void AddQuickIfValid(List<FilePickerItem> items, string label, string path, string icon) {
        if (path != null && path != "" && Directory.ExistsUtf8(path)) {
            items.Add(new FilePickerItem(label, FilePicker.Normalize(path), 2, icon));
        }
    }
    public static string FileIconFor(string name) {
        if (name == null) { return "file"; }
        string lower = name.ToLower();
        if (lower.EndsWith(".png") || lower.EndsWith(".jpg") || lower.EndsWith(".jpeg")
                || lower.EndsWith(".webp") || lower.EndsWith(".gif") || lower.EndsWith(".bmp")
                || lower.EndsWith(".svg") || lower.EndsWith(".ico")) {
            return "photo";
        }
        if (lower.EndsWith(".txt") || lower.EndsWith(".md") || lower.EndsWith(".json")
                || lower.EndsWith(".zan") || lower.EndsWith(".js") || lower.EndsWith(".ts")
                || lower.EndsWith(".html") || lower.EndsWith(".css") || lower.EndsWith(".xml")
                || lower.EndsWith(".yaml") || lower.EndsWith(".yml") || lower.EndsWith(".log")) {
            return "file-text";
        }
        return "file";
    }
    public void BuildTree(
        string dir,
        int depth,
        List<FilePickerTreeNode> nodes
    ) {
        if (nodes.Count >= 400 || !Directory.ExistsUtf8(dir)) { return; }
        nodes.Add(new FilePickerTreeNode(dir, depth));
        if (!IsExpanded(dir)) { return; }
        List<string> dirs = Directory.GetDirectoriesFiltered(
            dir, showHidden.Get());
        for (int i = 0; i < dirs.Count && nodes.Count < 400; i = i + 1) {
            string child = FilePicker.Join(dir, dirs[i]);
            BuildTree(child, depth + 1, nodes);
        }
    }
    public void Begin(
        int pickerMode,
        string initial,
        string extension,
        string defaultName,
        string dialogTitle
    ) {
        App host = inlineMode && inputHost != null ? inputHost.HostApp() : App.FrameApp();
        this.BeginCore(pickerMode, initial, extension, defaultName, dialogTitle, host, false);
    }
    private void BeginCore(int pickerMode, string initial, string extension,
            string defaultName, string dialogTitle, App host, bool forceInline) {
        int session = inputSession + 1; inputSession = session;
        open = false;
        App previous = popup; popup = null;
        bool current = this.RetireInputHost(session);
        if (previous != null) {
            previous.StopLoop();
            previous.window.Close();
            previous.window.Destroy();
        }
        if (!current || inputSession != session) { return; }
        mode = pickerMode;
        title = dialogTitle;
        suffix = extension;
        selectedPath = "";
        selectedPaths = new List<string>();
        anchorIdx = 0 - 1;
        statusText = "";
        lastFilter = "";
        creatingFolder = false;
        treeDragging = false;
        listDragging = false;
        filterOpen = false;
        filterSel.Set(0);
        if (!filtersCustom) { filters = new List<FileFilter>(); }
        if (pickerMode != 0 && filters.Count == 0) {
            if (extension != "") {
                filters.Add(new FileFilter(FilePicker.T("Files", "文件")
                    + " (*" + extension + ")", extension));
            }
            filters.Add(new FileFilter(FilePicker.T("All files", "所有文件")
                + " (*.*)", ""));
        }
        result = 0;
        string dir = "";
        if (initial != "") { dir = FilePicker.ValidDirectory(initial); }
        if (dir == "" && lastDir != "") { dir = FilePicker.ValidDirectory(lastDir); }
        #if ANDROID || OHOS
        if (dir == "" || dir == "." || dir == "/") {
            string filesDir = zan_gui_android_files_dir();
            if (filesDir != null && filesDir != ""
                    && Directory.ExistsUtf8(filesDir)) {
                dir = FilePicker.Normalize(filesDir);
            }
        }
        if (dir == "" || dir == "." || dir == "/") {
            string unpacked = Directory.ReadPath(".");
            if (unpacked != "" && unpacked != "."
                    && Directory.ExistsUtf8(unpacked)) {
                dir = FilePicker.Normalize(unpacked);
            }
        }
        if (dir == "" || dir == "." || dir == "/") {
            string home = KnownFolders.Home();
            if (home != "" && Directory.ExistsUtf8(home)) { dir = FilePicker.Normalize(home); }
        }
        #else
        if (dir == "") { dir = FilePicker.ValidDirectory(""); }
        #endif
        if (dir == "" || dir == "." || dir == "/") {
            statusText = FilePicker.T(
                "Cannot list the working folder — type a path above.",
                "无法列出当前目录——请在上方输入路径。");
        } else {
            statusText = "";
        }
        lastDir = dir;
        pathInput.SetText(dir);
        nameInput.SetText(defaultName);
        folderInput.SetText(FilePicker.T("New Folder", "新建文件夹"));
        treeScroll.Set(0);
        listScroll.Set(0);
        showHidden.Set(false);
        expanded = new List<string>();
        ExpandAncestors(dir);
        #if ANDROID || OHOS
        inlineMode = true;
        popup = null;
        #else
        inlineMode = forceInline;
        popup = forceInline ? null : App.CreateDark(dialogTitle, 760, 500);
        if (popup == null) { inlineMode = true; }
        #endif
        if (popup != null) {
            popup.ApplySkin(skinIndex);
            popup.SetChromeButtons(false, false, true, false);
            popup.Show();
            popup.RequestRedraw();
        }
        open = true;
        closing = false;
        this.InstallInputHost(popup != null ? popup : host);
        this.MarkDirty();
    }
    public void BeginFolder(string initial, string dialogTitle) { Begin(0, initial, "", "", dialogTitle); }
    public void BeginOpenFile(string initial, string extension, string dialogTitle) {
        Begin(1, initial, extension, "", dialogTitle);
    }
    public void BeginOpenFileFilters(
        string initial,
        List<FileFilter> items,
        string dialogTitle
    ) {
        SetFilters(items);
        string first = "";
        if (items.Count > 0) {
            first = FilePicker.FilterTokenToSuffix(
                FilePicker.FirstExt(items[0].pattern));
        }
        Begin(1, initial, first, "", dialogTitle);
    }
    public void BeginOpenFileMulti(string initial, string extension, string dialogTitle) {
        allowMulti = true;
        Begin(1, initial, extension, "", dialogTitle);
    }
    public void SetMaxSelect(int n) {
        maxSelect = n;
        if (maxSelect < 0) { maxSelect = 0; }
    }
    public int MaxSelect() { return maxSelect; }
    public void BeginOpenFileFiltersMulti(
        string initial,
        List<FileFilter> items,
        string dialogTitle
    ) {
        allowMulti = true;
        BeginOpenFileFilters(initial, items, dialogTitle);
    }
    public static string FirstExt(string pattern) {
        if (pattern == null || pattern == "") { return ""; }
        int semi = pattern.IndexOf(";");
        if (semi >= 0) { return pattern.Substring(0, semi); }
        return pattern;
    }
    public static bool ContainsText(string text, string needle) {
        if (needle == null || needle == "") { return true; }
        if (text == null) { return false; }
        return text.ToLower().IndexOf(needle.ToLower()) >= 0;
    }
    public static string FilterTokenToSuffix(string ext) {
        string t = ext.Trim();
        while (t.StartsWith("*")) { t = t.Substring(1, t.Length - 1); }
        if (t == "" || t == ".") { return ""; }
        if (!t.StartsWith(".")) { t = "." + t; }
        return t;
    }
    public bool MatchesCurrentFilter(string name) {
        if (filters.Count == 0) { return this.PatternMatches(name, suffix); }
        int sel = filterSel.Get();
        if (sel < 0 || sel >= filters.Count) { return true; }
        return this.PatternMatches(name, filters[sel].pattern);
    }
    public bool PatternMatches(string name, string pattern) {
        if (pattern == null || pattern == "") { return true; }
        int start = 0;
        int len = pattern.Length;
        for (int i = 0; i <= len; i = i + 1) {
            bool end = i == len;
            if (end || (pattern[i] & 255) == 59) {
                string ext = FilePicker.FilterTokenToSuffix(
                    pattern.Substring(start, i - start));
                if (ext != "" && FilePicker.EndsWith(name, ext)) { return true; }
                start = i + 1;
            }
        }
        return false;
    }
    public void BeginSaveFile(
        string initial,
        string extension,
        string defaultName,
        string dialogTitle
    ) {
        Begin(2, initial, extension, defaultName, dialogTitle);
    }
    public void ApplySkin(int index) {
        if (skinIndex == index) { return; }
        skinIndex = index;
        if (popup != null) { popup.ApplySkin(index); }
    }
    public int SkinIndex() { return skinIndex; }
    public bool IsOpen() { return open; }
    public bool WindowModeOpen() { return open && popup != null; }
    public bool NeedsRedraw() { return open && popup != null && popup.needsRedraw; }
    public bool OwnsWindow(nint hwnd) { return popup != null && hwnd == popup.WindowHandle(); }
    public nint PopupWindowHandle() { return popup != null ? popup.WindowHandle() : 0; }
    public string SelectedPath() { return selectedPath; }
    public List<string> SelectedPaths() { return selectedPaths; }
    public string LastDirectory() { return lastDir; }
    public string CurrentDirectory() { return FilePicker.Normalize(pathInput.GetText()); }
    public void RaiseFilterChanged() { FilterChanged.Raise(); }
    public void Finish(int action) {
        if (!open) { return; }
        result = action;
        if (action == 1 && allowMulti) {
            if (selectedPaths.Count == 0 && selectedPath != ""
                    && Directory.FileExistsUtf8(selectedPath)) {
                selectedPaths.Add(selectedPath);
            }
        } else if (action != 1) {
            selectedPaths = new List<string>();
        }
        open = false;
        closing = true;
        int session = inputSession + 1; inputSession = session;
        App previous = popup;
        if (!this.RetireInputHost(session)) { return; }
        if (previous != null && popup == previous) { previous.window.Close(); }
        if (action == 1) { Accepted.Raise(); } else { Cancelled.Raise(); }
        if (inputSession != session) { return; }
        Closed.Raise();
    }
    public bool InMultiSelection(int idx, List<FilePickerItem> items) {
        if (idx < 0 || idx >= items.Count) { return false; }
        return selectedPaths.Contains(items[idx].path);
    }
    public void RemoveSelectedPath(string path) {
        int i = 0;
        while (i < selectedPaths.Count) {
            if (selectedPaths[i] == path) { selectedPaths.RemoveAt(i); return; }
            i = i + 1;
        }
    }
    public void Close() {
        selectedPath = "";
        Finish(2);
    }
    public bool ApplyEvent(nint evHwnd) {
        if (!OwnsWindow(evHwnd)) { return true; }
        App app = popup;
        int kind = app.EventKind();
        if (kind == 8) {
            if (open && !closing) { this.Close(); }
            if (popup != app) { return false; }
            popup = null;
            app.StopLoop();
            app.window.Destroy();
            closing = false;
            return false;
        }
        bool keep = app.ApplyEvent(evHwnd);
        if (kind == 13 && popup == app) { app.RequestRedraw(); }
        return keep;
    }
    public void SweepClosed() {
        if (popup != null && !open) {
            App previous = popup; popup = null;
            previous.StopLoop();
            previous.window.Destroy();
        }
    }
    public int TakeResult() {
        int resultCode = result;
        result = 0;
        return resultCode;
    }
    public void Navigate(string dir) {
        dir = FilePicker.Normalize(dir);
        if (!Directory.ExistsUtf8(dir)) {
            statusText = FilePicker.T("Folder not found.", "找不到文件夹。");
            this.MarkDirty();
            return;
        }
        pathInput.SetText(dir);
        selectedPath = "";
        selectedPaths = new List<string>();
        anchorIdx = 0 - 1;
        statusText = "";
        listScroll.Set(0);
        lastDir = dir;
        PathChanged.Raise();
        ExpandAncestors(dir);
        this.MarkDirty();
    }
    public void OnPathSubmit() { this.Navigate(pathInput.GetText()); }
    public void OnFolderSubmit() {
        if (!creatingFolder) { return; }
        string dir = FilePicker.Normalize(pathInput.GetText());
        bool valid = Directory.ExistsUtf8(dir);
        string folderName = folderInput.GetText();
        if (!valid) {
            statusText = FilePicker.T(
                "Choose a valid parent folder.",
                "请选择有效的父文件夹。");
        } else if (!FilePicker.ValidFolderName(folderName)) {
            statusText = FilePicker.T(
                "Enter a valid folder name.",
                "请输入有效的文件夹名称。");
        } else {
            string created = FilePicker.Join(dir, folderName);
            if (!Directory.ExistsUtf8(created)) { Directory.CreateDirectoryUtf8(created); }
            if (Directory.ExistsUtf8(created)) {
                creatingFolder = false;
                Navigate(created);
            } else {
                statusText = FilePicker.T(
                    "Could not create the folder.",
                    "无法创建文件夹。");
            }
        }
        this.MarkDirty();
    }
    public void TryAccept() {
        string dir = FilePicker.Normalize(pathInput.GetText());
        bool valid = Directory.ExistsUtf8(dir);
        if (mode == 0 && valid) {
            selectedPath = dir;
            Finish(1);
        } else if (mode == 1 && (Directory.FileExistsUtf8(selectedPath) || (allowMulti && selectedPaths.Count > 0))) {
            Finish(1);
        } else if (mode == 1) {
            string typed = nameInput.GetText();
            if (typed != "") {
                string typedPath = FilePicker.Join(dir, typed);
                if (Directory.FileExistsUtf8(typedPath)) {
                    selectedPath = typedPath;
                    Finish(1);
                } else if (Directory.ExistsUtf8(typedPath)) {
                    selectedPath = "";
                    Navigate(typedPath);
                } else {
                    statusText = FilePicker.T(
                        "No such file or folder.", "没有此文件或文件夹。");
                    if (popup != null) { popup.RequestRedraw(); }
                }
            } else {
                statusText = FilePicker.T(
                    "Select a file first.", "请先选择文件。");
                if (popup != null) { popup.RequestRedraw(); }
            }
        } else if (mode == 2 && valid && nameInput.GetText() != "") {
            string name = nameInput.GetText();
            string wantSuffix = "";
            if (filters.Count > 0 && filterSel.Get() >= 0 && filterSel.Get() < filters.Count) {
                wantSuffix = FilePicker.FilterTokenToSuffix(FilePicker.FirstExt(filters[filterSel.Get()].pattern));
            } else {
                wantSuffix = FilePicker.FilterTokenToSuffix(FilePicker.FirstExt(suffix));
            }
            if (wantSuffix != "" && !this.MatchesCurrentFilter(name)) { name = name + wantSuffix; }
            selectedPath = FilePicker.Join(dir, name);
            Finish(1);
        }
    }
}
