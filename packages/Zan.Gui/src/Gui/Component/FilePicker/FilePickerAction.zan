using System;
using System.Collections.Generic;
using Gui;
using Gui.Widget;

namespace Gui.Component;

// Child callbacks and row factories borrow the picker; queued work cannot keep it alive.
internal class FilePickerAction {
    private weak FilePicker owner;
    private weak Checkbox check;
    private string path;
    private string name;
    private bool directory;
    private bool picked;
    private List<FilePickerItem> items;

    internal FilePickerAction(FilePicker picker) { owner = picker; }
    internal FilePickerAction(FilePicker picker, string targetPath) { owner = picker; path = targetPath; }
    internal FilePickerAction(FilePicker picker, Checkbox checkbox) { owner = picker; check = checkbox; }
    internal FilePickerAction(FilePicker picker, List<FilePickerItem> rows) { owner = picker; items = rows; }
    internal FilePickerAction(FilePicker picker, FilePickerItem item, bool selected) {
        owner = picker; path = item.path; name = item.name; directory = item.kind == 1; picked = selected;
    }
    internal void SubmitPath() {
        FilePicker picker = owner;
        if (picker != null) { picker.OnPathSubmit(); }
    }
    internal void Accept() {
        FilePicker picker = owner;
        if (picker != null) { picker.TryAccept(); }
    }
    internal void SubmitFolder() {
        FilePicker picker = owner;
        if (picker != null) { picker.OnFolderSubmit(); }
    }
    internal void Filter() {
        FilePicker picker = owner;
        if (picker != null) { picker.MarkDirty(); }
    }
    internal void Up() {
        FilePicker picker = owner;
        if (picker != null) { picker.Navigate(FilePicker.ParentDirectory(picker.CurrentDirectory())); }
    }
    internal void Refresh() {
        FilePicker picker = owner;
        if (picker != null) { picker.OnPathSubmit(); }
    }
    internal void ToggleFolder() {
        FilePicker picker = owner;
        if (picker != null) { picker.ToggleFolderCreation(); }
    }
    internal void CancelFolder() {
        FilePicker picker = owner;
        if (picker != null) { picker.CancelFolderCreation(); }
    }
    internal void Navigate() {
        FilePicker picker = owner;
        if (picker != null) { picker.Navigate(path); }
    }
    internal void ChangeHidden() {
        FilePicker picker = owner;
        Checkbox checkbox = check;
        if (picker != null && checkbox != null) { picker.ChangeHiddenFiles(checkbox.IsChecked()); }
    }
    internal void Close() {
        FilePicker picker = owner;
        if (picker != null) { picker.Close(); }
    }
    internal void SelectRow() {
        FilePicker picker = owner;
        if (picker != null) { picker.SelectFileRow(path, name, directory, picked); }
    }
    internal void ActivateRow() {
        FilePicker picker = owner;
        if (picker != null) { picker.ActivateFileRow(path, directory); }
    }
    internal Control Row(int index) {
        FilePicker picker = owner;
        return picker != null ? picker.BuildFileRow(index, items) : new Control();
    }
}

public partial class FilePicker {
    internal void ToggleFolderCreation() {
        creatingFolder = !creatingFolder;
        if (creatingFolder) { folderInput.SetText(FilePicker.T("New Folder", "新建文件夹")); }
        this.MarkDirty();
    }
    internal void CancelFolderCreation() { creatingFolder = false; this.MarkDirty(); }
    internal void ChangeHiddenFiles(bool hidden) { showHidden.Set(hidden); this.MarkDirty(); }
    internal void SelectFileRow(string path, string name, bool directory, bool picked) {
        if (directory) {
            if (mode == 0) { nameInput.SetText(name); selectedPath = path; }
        } else if (allowMulti) {
            if (picked) { this.RemoveSelectedPath(path); }
            else { selectedPaths.Add(path); }
        } else { nameInput.SetText(name); selectedPath = path; }
        this.MarkDirty();
    }
    internal void ActivateFileRow(string path, bool directory) {
        if (directory) { this.Navigate(path); }
        else if (mode == 1) { selectedPath = path; this.TryAccept(); }
    }
    internal Control BuildFileRow(int index, List<FilePickerItem> items) {
        FilePickerItem item = items[index];
        bool directory = item.kind == 1;
        bool picked = allowMulti && this.InMultiSelection(index, items);
        bool selected = selectedPath == item.path || picked;
        Button row = new Button("");
        row.ClassName = "filepicker-row row align-center " + (selected ? "selected" : "");
        if (allowMulti && !directory) {
            Checkbox checkbox = new Checkbox(); checkbox.SetChecked(picked); row.Add(checkbox);
        }
        row.Add(new IconView(directory ? "folder" : FilePicker.FileIconFor(item.name), 16));
        Label label = new Label(item.name); label.ClassName = "flex-1 text-ellipsis"; row.Add(label);
        // Both events use the values captured when this row was built, including multi-selection.
        FilePickerAction action = new FilePickerAction(this, item, picked);
        row.Click.Add(action.SelectRow);
        row.OnDoubleClick(action.ActivateRow);
        return row;
    }
}
