using System;
using System.Collections.Generic;
using Gui;
using Gui.Backend;
using Gui.Widget;
namespace Gui.Component;
public delegate int BandGridColorOf(int row, int col, string text, int num);
public class BandGrid : Control {
    public override Control CreateCloneShell() { return new BandGrid(); }
    private int rows;
    private int cols;
    private List<BandGridCell> cells;
    private List<string> rowLabels;
    private List<string> bandLabels;
    private int bandSpan;
    private BandGridColorOf colorOf;
    private int cellW;
    private int cellH;
    private int hoverR;
    private int hoverC;
    private int anchorR;
    private int anchorC;
    private bool dragSet;
    private int ctxR;
    private int ctxC;
    private int actR;
    private int actC;
    private int lastUpMs;
    private int lastUpR;
    private int lastUpC;
    private int barMax;
    private int accent;
    private int heatDeep;
    private Rect viewportArea;
    [Event(Alias = "Change")]
    public UiEvent Changed;
    [Event]
    public UiEvent Context;
    [Event(Alias = "Activate")]
    public UiEvent CellActivate;
    public BandGrid() {
        this.InitControl("bandgrid");
        rows = 0;
        cols = 0;
        cells = new List<BandGridCell>();
        rowLabels = new List<string>();
        bandLabels = new List<string>();
        bandSpan = 0;
        colorOf = null;
        cellW = 14;
        cellH = 18;
        hoverR = 0 - 1;
        hoverC = 0 - 1;
        anchorR = 0 - 1;
        anchorC = 0 - 1;
        dragSet = true;
        ctxR = 0 - 1;
        ctxC = 0 - 1;
        actR = 0 - 1;
        actC = 0 - 1;
        lastUpMs = 0;
        lastUpR = 0 - 1;
        lastUpC = 0 - 1;
        barMax = 0;
        heatDeep = 0;
        accent = 0;
        viewportArea = new Rect(0, 0, 0, 0);
        Changed = new UiEvent();
        Context = new UiEvent();
        CellActivate = new UiEvent();
        wiresOwnEvents = true;
    }
    // 行列数；单元格为空文本、无数值（-1）。
    public BandGrid Bind(int r, int c) {
        App app = this.App;
        if (app != null) { app.ReleaseInputSubtree(this); }
        anchorR = 0 - 1; anchorC = 0 - 1;
        hoverR = 0 - 1; hoverC = 0 - 1;
        rows = r > 0 ? r : 0;
        cols = c > 0 ? c : 0;
        cells = new List<BandGridCell>();
        for (int i = 0; i < rows * cols; i = i + 1) {
            cells.Add(new BandGridCell("", 0 - 1, 0));
        }
    }
    public void BindInit(int r, int c, int initNum) {
        this.Bind(r, c);
        string initText = Convert.ToString(initNum);
        for (int i = 0; i < cells.Count; i = i + 1) {
            cells[i].num = initNum;
            cells[i].text = initText;
        }
    }
    public void RowLabels(List<string> labels) { rowLabels = labels != null ? labels : new List<string>(); }
    public void BandLabels(List<string> labels, int span) {
        bandLabels = labels != null ? labels : new List<string>();
        bandSpan = span > 0 ? span : 0;
    }
    public void ColorOf(BandGridColorOf d) { colorOf = d; }
    public void Heat(int deepColor) { heatDeep = deepColor; }
    public void CellSize(int w, int h) { cellW = w; cellH = h > 0 ? h : 1; }
    public void BarMax(int v) { barMax = v; }
    public void Accent(int argb) { accent = argb; }
    public void OnChanged(Action a) { Changed.Add(a); }
    public void OnContext(Action a) { Context.Add(a); }
    public void OnCellActivate(Action a) { CellActivate.Add(a); }
    public int ContextRow() { return ctxR; }
    public int ContextCol() { return ctxC; }
    public int CellRow() { return actR; }
    public int CellCol() { return actC; }
    public string TextAt(int r, int c) {
        if (r < 0 || r >= rows || c < 0 || c >= cols) { return ""; }
        int idx = r * cols + c;
        if (idx < 0 || idx >= cells.Count) { return ""; }
        return cells[idx].text;
    }
    public void SetText(int r, int c, string s) {
        if (r < 0 || r >= rows || c < 0 || c >= cols) { return; }
        int idx = r * cols + c;
        if (idx < 0 || idx >= cells.Count) { return; }
        cells[idx].text = s != null ? s : "";
    }
    public int NumAt(int r, int c) {
        if (r < 0 || r >= rows || c < 0 || c >= cols) { return 0 - 1; }
        int idx = r * cols + c;
        if (idx < 0 || idx >= cells.Count) { return 0 - 1; }
        return cells[idx].num;
    }
    public void SetNum(int r, int c, int v) {
        if (r < 0 || r >= rows || c < 0 || c >= cols) { return; }
        int idx = r * cols + c;
        if (idx < 0 || idx >= cells.Count) { return; }
        cells[idx].num = v;
        cells[idx].text = Convert.ToString(v);
    }
    public void SetAllNum(int v) {
        string s = Convert.ToString(v);
        for (int i = 0; i < cells.Count; i = i + 1) {
            cells[i].num = v;
            cells[i].text = s;
        }
        this.Poke();
    }
    public int SelectedCount() {
        if (cells == null) { return 0; }
        int n = 0;
        for (int i = 0; i < cells.Count; i = i + 1) {
            if (cells[i].mark != 0) { n = n + 1; }
        }
        return n;
    }
    public void SelectAll() {
        if (cells == null) { return; }
        for (int i = 0; i < cells.Count; i = i + 1) { cells[i].mark = 1; }
        this.Poke();
    }
    public void ClearMarks() {
        if (cells == null) { return; }
        for (int i = 0; i < cells.Count; i = i + 1) { cells[i].mark = 0; }
        this.Poke();
    }
    public void SetSelectedNum(int v) {
        if (cells == null) { return; }
        string s = Convert.ToString(v);
        for (int i = 0; i < cells.Count; i = i + 1) {
            if (cells[i].mark != 0) {
                cells[i].num = v;
                cells[i].text = s;
            }
        }
        this.Poke();
    }
    public void SetSelectedText(string s) {
        if (cells == null) { return; }
        string val = s != null ? s : "";
        for (int i = 0; i < cells.Count; i = i + 1) {
            if (cells[i].mark != 0) { cells[i].text = val; }
        }
        this.Poke();
    }
    public void Poke() {
        App app = this.App;
        if (app != null) { app.RequestRedraw(); }
    }
    public override void OnMeasure(App app) {
        int bandH = this.BandH(app);
        int labW = this.LabelW(app);
        int cw = cellW > 0 ? app.Scale(cellW) : app.Scale(8);
        int ch = cellH > 0 ? app.Scale(cellH) : app.Scale(1);
        prefW = labW + cols * cw + app.Scale(2);
        prefH = bandH + rows * ch + app.Scale(2);
    }
    public int BandH() { return this.BandH(this.App); }
    public int BandH(App app) {
        if (bandLabels.Count == 0) { return 0; }
        app = this.ResolveApp(app);
        int sc11 = app != null ? app.Scale(11) : 11;
        int sc8 = app != null ? app.Scale(8) : 8;
        return Canvas.FontHeight(sc11) + sc8;
    }
    public int LabelW() { return this.LabelW(this.App); }
    public int LabelW(App app) {
        app = this.ResolveApp(app);
        int w = app != null ? app.Scale(6) : 6;
        int fs = app != null ? app.Scale(11) : 11;
        for (int i = 0; i < rowLabels.Count; i = i + 1) {
            int tw = Canvas.MeasureText(rowLabels[i], fs);
            if (tw > w) { w = tw; }
        }
        int sc12 = app != null ? app.Scale(12) : 12;
        return w + sc12;
    }
    private void Damage() { this.Damage(this.App); }
    private void Damage(App app) {
        app = this.ResolveApp(app);
        if (app != null) {
            app.Damage.NoteDamage(bx, by, bw, bh);
            if (app.window != null) { app.window.Wake(); }
        }
    }
    protected override List<PropSpec> DefineProps() {
        List<PropSpec> ps = new List<PropSpec>();
        ps.Add(PropSpec.Int("bandSpan", "Band span")
            .Field("bandSpan")
            .StepBy(1)
            .WithTip("Rows per band (0 = auto from the band labels)."));
        ps.Add(PropSpec.Int("cellW", "Cell width").Field("cellW").Step(1, 4, 96));
        ps.Add(PropSpec.Int("cellH", "Cell height").Field("cellH").Step(1, 4, 96));
        ps.Add(PropSpec.Int("barMax", "Bar max").Field("barMax"));
        ps.Add(PropSpec.Color("accent", "Accent")
            .Field("accent")
            .WithTip("Band / selection accent colour. 0 = skin default."));
        return ps;
    }

    public override StyleBox ResolveStyle(App app, int state) {
        StyleBox box = base.ResolveStyle(app, state);
        if (box.overflowCss == 0 - 1) { box.overflowY = 2; box.overflow = 1; }
        return box;
    }
    public override Rect ScrollViewport() {
        Rect view = base.ScrollViewport();
        int header = this.BandH(this.App);
        if (header > view.height) { header = view.height; }
        return new Rect(view.x, view.y + header, view.width, view.height - header);
    }
    public override void Arrange(int x, int y, int w, int h) {
        bx = x; by = y; bw = w > 0 ? w : 0; bh = h > 0 ? h : 0;
        App app = this.App;
        Rect view = this.ScrollViewport();
        int ch = app != null ? app.Scale(cellH) : cellH;
        if (ch < 1) { ch = 1; }
        scrollExtent = rows * ch;
        scrollExtentX = view.width;
        int maximum = scrollExtent - view.height;
        if (maximum < 0) { maximum = 0; }
        if (scrollY > maximum) { scrollY = maximum; }
        if (scrollY < 0) { scrollY = 0; }
        viewportArea.Set(view.x, view.y, view.width, view.height);
    }
    private int ColumnWidth(App app) {
        int cw = app.Scale(cellW);
        int labW = this.LabelW(app);
        if (cellW <= 0 && cols > 0) {
            int avail = viewportArea.width - labW;
            cw = avail > 0 ? (avail / cols) : app.Scale(8);
            if (cw < app.Scale(8)) { cw = app.Scale(8); }
        }
        if (cw < 1) { cw = 1; }
        return cw;
    }
    private bool LocateCell(int x, int y) {
        App app = this.App;
        hoverR = 0 - 1; hoverC = 0 - 1;
        if (app == null || rows <= 0 || cols <= 0 || !viewportArea.Contains(x, y)) { return false; }
        if (this.ScrollBarHit(x, y) != 0) { return false; }
        int cw = this.ColumnWidth(app);
        int ch = app.Scale(cellH);
        int left = viewportArea.x + this.LabelW(app);
        if (cw <= 0 || ch <= 0 || x < left) { return false; }
        int r = (y - viewportArea.y + scrollY) / ch;
        int c = (x - left) / cw;
        if (r < 0 || r >= rows || c < 0 || c >= cols) { return false; }
        hoverR = r; hoverC = c;
        return true;
    }
    private void ExtendSelection(int x, int y) {
        if (anchorR < 0 || !this.LocateCell(x, y)) { return; }
        int loR = anchorR < hoverR ? anchorR : hoverR;
        int hiR = anchorR > hoverR ? anchorR : hoverR;
        int loC = anchorC < hoverC ? anchorC : hoverC;
        int hiC = anchorC > hoverC ? anchorC : hoverC;
        for (int r = loR; r <= hiR; r = r + 1) {
            for (int c = loC; c <= hiC; c = c + 1) {
                int idx = r * cols + c;
                if (idx >= 0 && idx < cells.Count) { cells[idx].mark = dragSet ? 1 : 0; }
            }
        }
        this.Damage();
    }
    public override void OnPointerDown(RoutedEventArgs e) {
        App app = this.App;
        if (app == null || app.window == null || this.IsDisabled() || !this.LocateCell(e.x, e.y)) { return; }
        if (app.window.EventButton() == 1) {
            ctxR = hoverR; ctxC = hoverC;
            Context.Post(this);
            this.Damage();
            e.Handle();
            return;
        }
        if (app.window.EventButton() != 0) { return; }
        int idx = hoverR * cols + hoverC;
        if (idx < 0 || idx >= cells.Count) { return; }
        anchorR = hoverR; anchorC = hoverC;
        dragSet = cells[idx].mark == 0;
        cells[idx].mark = dragSet ? 1 : 0;
        app.CapturePointer(this, true);
        this.Damage();
        e.Handle();
    }
    public override void OnPointerMove(RoutedEventArgs e) {
        if (this.IsDisabled()) { this.OnPointerCancel(e); return; }
        App app = this.App;
        if (app == null) { return; }
        if (anchorR >= 0 && app.GetCapturedPointer() == this) {
            this.ExtendSelection(e.x, e.y);
            e.Handle();
        } else {
            this.LocateCell(e.x, e.y);
            this.Damage();
        }
    }
    public override void OnPointerLeave(RoutedEventArgs e) {
        hoverR = 0 - 1; hoverC = 0 - 1;
        this.Damage();
    }
    public override void OnPointerUp(RoutedEventArgs e) {
        App app = this.App;
        if (app == null || app.window == null || app.window.EventButton() != 0 || anchorR < 0
            || app.GetCapturedPointer() != this) { return; }
        if (this.IsDisabled()) { this.OnPointerCancel(e); return; }
        this.ExtendSelection(e.x, e.y);
        if (this.LocateCell(e.x, e.y)) {
            int now = Window.GetTickMs();
            if (hoverR == lastUpR && hoverC == lastUpC && lastUpMs > 0 && (now - lastUpMs) <= 400) {
                actR = hoverR; actC = hoverC;
                CellActivate.Post(this);
                lastUpMs = 0; lastUpR = 0 - 1; lastUpC = 0 - 1;
            } else {
                lastUpMs = now; lastUpR = hoverR; lastUpC = hoverC;
            }
        }
        anchorR = 0 - 1; anchorC = 0 - 1;
        app.ReleasePointerCapture();
        Changed.Post(this);
        this.Damage();
        e.Handle();
    }
    public override void OnPointerCancel(RoutedEventArgs e) {
        anchorR = 0 - 1; anchorC = 0 - 1;
        App app = this.App;
        if (app != null && app.GetCapturedPointer() == this) { app.ReleasePointerCapture(); }
        this.Damage();
    }
    public override void OnPaint(App app) {
        if (app == null || app.canvas == null || rows <= 0 || cols <= 0 || cells.Count < rows * cols) { return; }
        Canvas c = app.canvas;
        int labW = this.LabelW(app);
        int cw = this.ColumnWidth(app);
        int ch = app.Scale(cellH);
        if (ch < 1) { ch = 1; }
        int fs = app.Scale(11);
        int bandH = this.BandH(app);
        Rect frame = base.ScrollViewport();
        int ox = frame.x + labW;
        StyleBox head = Style.PartRef(app, "bandgrid", "head", "panel",
                                      "", "", Style.SNormal());
        StyleBox body = Style.PartRef(app, "bandgrid", "body", "panel",
                                      "", "", Style.SNormal());
        int headBg = head.BgOr(0);
        int bodyBg = body.BgOr(0);
        int fg = head.FgOr(0);
        if (fg == 0) { fg = body.FgOr(0); }
        if (fg == 0) { fg = app.theme.textPrimary; }
        if (headBg == 0) { headBg = bodyBg != 0 ? bodyBg : app.theme.bgTertiary; }
        if (bodyBg == 0) { bodyBg = app.theme.bgPrimary; }
        int themedAccent = accent;
        if (themedAccent == 0) {
            int themed = Style.PartRef(app, "bandgrid", "accent", "panel",
                                       "", "", Style.SNormal()).BgOr(0);
            themedAccent = themed != 0 ? themed : app.theme.primary;
        }
        int heatLo = 0;
        int heatZero = bodyBg;
        if (heatDeep != 0 && colorOf == null) {
            heatLo = ColorMath.LerpColor(bodyBg, heatDeep, 160);
            heatZero = ColorMath.LerpColor(bodyBg, app.theme.bgTertiary, 650);
        }
        int contentW = labW + cols * cw;
        int contentH = bandH + rows * ch;
        int paintW = contentW < frame.width ? contentW : frame.width;
        int paintH = contentH < frame.height ? contentH : frame.height;
        if (paintW <= 0 || paintH <= 0) { return; }
        c.FillRect(frame.x, frame.y, paintW, paintH, bodyBg);
        if (bandH > 0) {
            c.FillRect(frame.x, frame.y, labW < paintW ? labW : paintW, bandH, headBg);
            int span = bandSpan > 0 ? bandSpan : (bandLabels.Count > 0 && cols >= bandLabels.Count ? cols / bandLabels.Count : 1);
            for (int i = 0; i < bandLabels.Count; i = i + 1) {
                int x0 = ox + i * span * cw;
                int spanW = span * cw;
                c.FillRect(x0, frame.y, spanW, bandH, headBg);
                c.DrawTextCentered(x0, frame.y, spanW, bandH,
                                   bandLabels[i], fg, fs);
            }
            c.DrawLine(frame.x, frame.y + bandH - 1, frame.x + paintW, frame.y + bandH - 1, app.theme.divider, 1);
        }
        int viewX = viewportArea.x;
        int viewY = viewportArea.y;
        int viewW = viewportArea.width;
        int viewH = viewportArea.height;
        if (viewH <= 0) { return; }
        int clipW = paintW < viewW ? paintW : viewW;
        int clipH = (paintH - bandH) < viewH ? (paintH - bandH) : viewH;
        if (clipW <= 0 || clipH <= 0) { return; }
        c.PushClip(viewX, viewY, clipW, clipH);
        int r0 = scrollY / ch;
        if (r0 < 0) { r0 = 0; }
        int r1 = (scrollY + viewH) / ch + 1;
        if (r1 > rows) { r1 = rows; }
        bool showText = cw >= app.Scale(22);
        for (int r = r0; r < r1; r = r + 1) {
            int y0 = viewY + r * ch - scrollY;
            c.FillRect(viewX, y0, labW, ch, headBg);
            if (r < rowLabels.Count) { c.DrawTextCentered(viewX, y0, labW, ch, rowLabels[r], fg, fs); }
            for (int k = 0; k < cols; k = k + 1) {
                int idx = r * cols + k;
                int x0 = ox + k * cw;
                int colBg = bodyBg;
                if (colorOf != null) {
                    colBg = colorOf(r, k, cells[idx].text, cells[idx].num);
                    if (colBg == 0) { colBg = bodyBg; }
                } else if (heatDeep != 0) {
                    int hv = cells[idx].num;
                    if (hv > 0) {
                        int scaleMax = barMax > 0 ? barMax : 5;
                        int clampedH = hv > scaleMax ? scaleMax : hv;
                        colBg = ColorMath.LerpColor(heatLo, heatDeep, clampedH * 1000 / scaleMax);
                    } else {
                        colBg = heatZero;
                    }
                }
                c.FillRect(x0, y0, cw - 1, ch - 1, colBg);
                int nv = cells[idx].num;
                if (nv > 0 && barMax > 0) {
                    int clamped = nv > barMax ? barMax : nv;
                    int barW = cw * clamped / barMax;
                    if (barW > cw - 1) { barW = cw - 1; }
                    if (barW < 2) { barW = 2; }
                    c.FillRect(x0, y0 + ch - 1 - app.Scale(3), barW,
                               app.Scale(3), themedAccent);
                }
                if (showText && cells[idx].text != "") {
                    int cellFg = fg;
                    if (colBg != bodyBg) {
                        int cr = (colBg >> 16) & 255;
                        int cg = (colBg >> 8) & 255;
                        int cb = colBg & 255;
                        int lum = (cr * 299 + cg * 587 + cb * 114) / 1000;
                        cellFg = lum < 145 ? 0xFFFFFFFF : 0xFF181C24;
                    }
                    c.DrawTextCentered(x0, y0, cw - 1, ch - 1,
                                       cells[idx].text, cellFg, fs);
                }
                if (cells[idx].mark != 0) {
                    c.DrawRect(x0, y0, cw - 1, ch - 1, themedAccent, 2);
                } else if (hoverR == r && hoverC == k) {
                    c.DrawRect(x0, y0, cw - 1, ch - 1, fg, 1);
                }
            }
        }
        c.PopClip();
        c.DrawRect(frame.x, frame.y, paintW, paintH, app.theme.divider, 1);
    }
}
