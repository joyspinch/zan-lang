using Gui.Markup;

namespace Gui;

// Form 文档查找兼容垫片：实际扫描逻辑在 Markup/Html/HtmlDocs.zan（低层不向上依赖 Forms）。
public partial class Form {
    public static string FindDoc(string cls) {
        return HtmlDocs.Find(cls);
    }

    public static string ReadDoc(string rel) {
        return HtmlDocs.Read(rel);
    }
}
