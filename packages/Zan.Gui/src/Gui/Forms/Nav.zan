using System;
using System.Collections.Generic;
using System.Json;
using Formats.Csv;
using Gui;
using Gui.Widget;

namespace Gui;

// 项目级导航层：把"打开哪个页"从窗口 code-behind 里收拢成一张路由表。
// 三种呈现共用一张表（Route = 名字 + 标题 + 页面工厂）：
// - `Nav.Open`：独立副窗口（ChildWindow 家族，主循环泵着，非模态——
// 与桌面工具"473 次 Show 对 7 次 ShowDialog"的主流形态一致）；
// 同名路由已开则复用同一个窗口（单例）并重放参数，等价于原版
// 标签壳的"已开聚焦 + 重新 Navigate"。
// - `Nav.Embed`：把一个 Tabs 变成路由出口——每条路由一个标签页，
// 首次选中才实例化（惰性），默认 keepAlive（切走保留），可按路由
// 配成临态（切走销毁、再进重建）。
// - 窗口关闭栈：`Nav.Back()` 关掉最近打开的导航窗口，供安卓
// AC_BACK（kind-8）和界面返回键复用。
public class Nav {
    // 登记路由（同名重登记=覆盖工厂/标题，钩子与 keepAlive 保留）。
    static NavRoute Define(string name, NavPageFactory make) {
        return Nav.DefineTitle(name, name, make);
    }

    // 登记路由并指定标题（窗口标题 / 标签文案）。
    static NavRoute DefineTitle(string name, string title, NavPageFactory make) {
        if (name == null) { name = ""; }
        if (title == null) { title = ""; }
        GuiNavState state = GuiNavState.Current();
        if (state.routes == null) { state.routes = new List<NavRoute>(); }
        NavRoute r = Nav.Find(name);
        if (r != null) {
            r.make = make;
            r.title = title;
            return r;
        }
        NavRoute nr = new NavRoute();
        nr.name = name;
        nr.title = title;
        nr.make = make;
        nr.keepAlive = true;
        state.routes.Add(nr);
        return nr;
    }

    // 挂进入钩子（窗口打开 / 参数重放 / 出口页构建时回调）。
    static void OnEnter(string name, NavEnterHandler h) {
        NavRoute r = Nav.Find(name);
        if (r != null) { r.enter = h; }
    }

    // 配出口存活策略：false = 切走销毁、再进重建（重页面按需开）。
    static void SetKeepAlive(string name, bool on) {
        NavRoute r = Nav.Find(name);
        if (r != null) { r.keepAlive = on; }
    }

    // 配窗口尺寸（逻辑像素）。
    static void SetWindowSize(string name, int width, int height) {
        NavRoute r = Nav.Find(name);
        if (r == null) { return; }
        r.winW = width;
        r.winH = height;
    }

    // 查路由（未登记返回 null）。
    static NavRoute Find(string name) {
        if (name == null) { return null; }
        List<NavRoute> routes = GuiNavState.Current().routes;
        if (routes == null) { return null; }
        for (int i = 0; i < routes.Count; i = i + 1) {
            if (routes[i].name == name) { return routes[i]; }
        }
        return null;
    }

    // 打开路由（单例）：已开则激活 + 重放参数；未开则建副窗口。
    static void Open(string name, App parent) {
        Nav.OpenArgs(name, parent, null);
    }

    // 打开路由并携带参数（进入钩子收到）。
    static void OpenArgs(string name, App parent, JsonValue args) {
        if (name == null) { return; }
        NavRoute r = Nav.Find(name);
        if (r == null || r.make == null) {
            Console.WriteLine("NAV: unknown route '" + name + "'");
            return;
        }
        Nav.Prune();
        NavWindow w = Nav.FindOpen(name);
        if (w != null) {
            Nav.Activate(w);
            w.Replay(args);
            return;
        }
        w = new NavWindow();
        w.OpenFor(r, parent, args);
        GuiNavState state = GuiNavState.Current();
        if (state.openStack == null) { state.openStack = new List<NavWindow>(); }
        state.openStack.Add(w);
    }

    // 查某路由当前打开的窗口（后开者优先；未开返回 null）。
    static NavWindow FindOpen(string name) {
        List<NavWindow> openStack = GuiNavState.Current().openStack;
        if (openStack == null) { return null; }
        for (int i = openStack.Count - 1; i >= 0; i = i - 1) {
            NavWindow w = openStack[i];
            if (w.IsOpen() && w.rt != null && w.rt.name == name) { return w; }
        }
        return null;
    }

    // 返回：关掉最近打开的导航窗口（栈顶）。
    static bool Back() {
        Nav.Prune();
        List<NavWindow> openStack = GuiNavState.Current().openStack;
        if (openStack == null || openStack.Count == 0) { return false; }
        NavWindow w = openStack[openStack.Count - 1];
        openStack.RemoveAt(openStack.Count - 1);
        w.Close();
        return true;
    }

    // 关闭全部导航窗口。
    static void CloseAll() {
        GuiNavState state = GuiNavState.Current();
        if (state.openStack == null) { return; }
        List<NavWindow> toClose = state.openStack;
        state.openStack = new List<NavWindow>();
        for (int i = toClose.Count - 1; i >= 0; i = i - 1) {
            if (toClose[i].IsOpen()) { toClose[i].Close(); }
        }
    }

    // 把标签条绑成路由出口：csv 里的每条路由一个标签（按序），
    // 首个标签立即建页，其余首次选中才建（惰性）。
    static void Embed(Tabs tabs, string routeCsv) {
        if (tabs == null || routeCsv == null) { return; }
        GuiNavState state = GuiNavState.Current();
        if (state.embeds == null) { state.embeds = new List<NavEmbed>(); }
        List<NavEmbed> embeds = state.embeds;
        for (int i = embeds.Count - 1; i >= 0; i = i - 1) {
            Tabs existing = embeds[i].tabs;
            if (existing == null) { embeds.RemoveAt(i); }
            else if (existing == tabs) { return; }
        }
        NavEmbed e = new NavEmbed();
        e.tabs = tabs;
        e.names = new List<string>();
        List<string> routes = Csv.ParseRow(routeCsv);
        for (int i = 0; i < routes.Count; i = i + 1) {
            Nav.TryAddEmbedTab(e, routes[i]);
        }
        tabs.BindEvent("TabChanged", Nav.EmbedChanged);
        embeds.Add(e);
        if (tabs.Active() < 0 && tabs.Count() > 0) { tabs.Select(0); }
        int act = tabs.Active();
        if (act >= 0) { Nav.EnsureEmbedPage(e, act); }
    }

    // 解除标签条与路由出口的绑定，防止动态创建的 Tabs 及其页面长期驻留。
    static void Unembed(Tabs tabs) {
        List<NavEmbed> embeds = GuiNavState.Current().embeds;
        if (embeds == null || tabs == null) { return; }
        for (int i = embeds.Count - 1; i >= 0; i = i - 1) {
            Tabs existing = embeds[i].tabs;
            if (existing == null || existing == tabs) {
                embeds.RemoveAt(i);
            }
        }
    }

    // 清空所有页内出口登记。
    static void ClearEmbeds() {
        List<NavEmbed> embeds = GuiNavState.Current().embeds;
        if (embeds != null) {
            embeds.Clear();
        }
    }

    // TabChanged 的统一处理：sender 即发起切换的出口。
    static void EmbedChanged(Control sender) {
        List<NavEmbed> embeds = GuiNavState.Current().embeds;
        if (embeds == null || sender == null) { return; }
        for (int k = embeds.Count - 1; k >= 0; k = k - 1) {
            NavEmbed e = embeds[k];
            Tabs tabBar = e.tabs;
            if (tabBar == null) { embeds.RemoveAt(k); continue; }
            if (tabBar != sender) { continue; }
            int idx = tabBar.Active();
            if (idx < 0) { return; }
            for (int j = 0; j < e.names.Count; j = j + 1) {
                if (j == idx) { continue; }
                NavRoute rj = Nav.Find(e.names[j]);
                if (rj == null || rj.keepAlive) { continue; }
                Panel pj = tabBar.Page(j);
                if (pj != null && pj.ChildCount() > 0) { pj.RemoveAll(); }
            }
            Nav.EnsureEmbedPage(e, idx);
            return;
        }
    }

    // ---- internals -------------------------------------------------

    static void TryAddEmbedTab(NavEmbed e, string name) {
        if (name == null) { return; }
        name = name.Trim();
        if (name == "") { return; }
        Tabs tabBar = e.tabs;
        if (tabBar == null) { return; }
        NavRoute r = Nav.Find(name);
        if (r == null) { return; }
        e.names.Add(name);
        tabBar.Add(r.title, false);
    }

    static void EnsureEmbedPage(NavEmbed e, int i) {
        if (i < 0 || i >= e.names.Count) { return; }
        Tabs tabBar = e.tabs;
        if (tabBar == null) { return; }
        NavRoute r = Nav.Find(e.names[i]);
        if (r == null || r.make == null) { return; }
        Panel page = tabBar.Page(i);
        if (page == null) { return; }
        if (page.ChildCount() > 0) {
            if (r.keepAlive) { return; }
            page.RemoveAll();
        }
        Control ctl = r.make();
        if (ctl == null) { return; }
        page.Add(ctl);
        if (r.enter != null) { r.enter(null, null); }
    }

    static void Prune() {
        List<NavWindow> openStack = GuiNavState.Current().openStack;
        if (openStack == null) { return; }
        for (int i = openStack.Count - 1; i >= 0; i = i - 1) {
            if (!openStack[i].IsOpen()) { openStack.RemoveAt(i); }
        }
    }

    static void Activate(NavWindow w) {
        if (w == null || !w.IsOpen()) { return; }
        if (w.Host() != null) {
            Gui.Backend.Platform.Window().SetForegroundWindow(w.Host().WindowHandle());
        }
    }

    static int NextIdBase() {
        return WidgetId.Block(1000);
    }
}
