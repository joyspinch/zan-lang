using System;
using System.IO;
using Gui.Markup;
namespace Gui;
public partial class Form {
    public void ShowStaticWith(ControlFactoryFn factory, Action<HandlerRegistry> register,
                               Action<Form> onLoad = null) {
        string name = this.GetType().Name;
        string html = Form.FindDoc(name);
        if (html == null) { throw new FileNotFoundException("Window document not found: " + name); }
        this.MountStaticDocument(false, Html.ParseWith(html, "", null, factory), register, onLoad);
        this.RunWiredDocument();
    }
    public void ShowStaticWith(string document, ControlFactoryFn factory,
                               Action<HandlerRegistry> register, Action<Form> onLoad = null) {
        this.MountStaticDocument(false, Html.ParseEmbedded(document, factory), register, onLoad);
        this.RunWiredDocument();
    }
    public void ShowOffscreenStaticWith(string document, ControlFactoryFn factory,
                                        Action<HandlerRegistry> register, Action<Form> onLoad = null) {
        this.MountStaticDocument(true, Html.ParseEmbedded(document, factory), register, onLoad);
    }
    private void MountStaticDocument(bool offscreen, HtmlDoc doc, Action<HandlerRegistry> register,
                                     Action<Form> onLoad) {
        if (register == null) { throw new ArgumentNullException("register"); }
        HandlerRegistry actions = new HandlerRegistry();
        register(actions);
        Form.CheckStaticDocument(doc.root, actions);
        Form.WireDocNode(doc.root, actions);
        this.MountDocument(offscreen, doc);
        if (onLoad != null) { onLoad(this); }
    }
    private static void CheckStaticDocument(Control control, HandlerRegistry actions) {
        if ((control.bindings != null && control.bindings.Count > 0)
            || control.CssAttr("data-for") != "" || control.CssAttr("data-if") != "" || control.bindMount != "") {
            throw new InvalidOperationException("WINDOW: model directives require ShowWith on " + control.name);
        }
        for (int i = 0; i < control.events.Count; i = i + 1) {
            string name = control.events[i].val;
            if (name == "") { continue; }
            if (actions.Get(name) == null && actions.GetItem(name) == null && actions.GetSender(name) == null
                && (control.handlerArg == "" || actions.GetArg(name) == null)) {
                throw new InvalidOperationException("WINDOW: handler declared in doc but unregistered: " + name);
            }
        }
        for (int i = 0; i < control.ChildCount(); i = i + 1) {
            Form.CheckStaticDocument(control.ChildAt(i), actions);
        }
    }
}
