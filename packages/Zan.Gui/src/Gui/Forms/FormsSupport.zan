using Gui.Backend;
using Gui.Markup;
using Gui.Widget;
using Gui;
using System.Collections.Generic;
using System;

namespace Gui;

internal class ChildHostLayout : AppHostLayout {
    private weak ChildWindow owner;
    internal ChildHostLayout(ChildWindow child) { owner = child; }
    internal override bool SyncLayout(App app, bool forInput) {
        ChildWindow child = owner;
        return child != null && child.SyncHostLayout(app, forInput);
    }
}

internal class FormHostLayout : AppHostLayout {
    private weak Form owner;
    internal FormHostLayout(Form form) { owner = form; }
    internal override bool SyncLayout(App app, bool forInput) {
        Form form = owner;
        return form != null && form.SyncHostLayout(app, forInput);
    }
}

// Form 文档查找兼容垫片：实际扫描逻辑在 Markup/Html/HtmlDocs.zan（低层不向上依赖 Forms）。
public partial class Form {
    public static string FindDoc(string cls) {
        return HtmlDocs.Find(cls);
    }

    public static string ReadDoc(string rel) {
        return HtmlDocs.Read(rel);
    }
}

internal class GuiNavState {
    internal List<NavRoute> routes;
    internal List<NavWindow> openStack;
    internal List<NavEmbed> embeds;

    internal static GuiNavState Current() {
        object existing = GuiHostState.NavState();
        if (existing != null) { return (GuiNavState)existing; }
        GuiNavState created = new GuiNavState();
        GuiHostState.SetNavState(created);
        return created;
    }
}

public class FormTask {
    public int periodMs;
    public int dueMs;
    public Action work;
    FormTask(int ms, Action a) {
        periodMs = ms;
        if (periodMs < 1) { periodMs = 1; }
        work = a;
        dueMs = 0;
    }
    int Period() { return periodMs; }
    int Due() { return dueMs; }
    void Schedule(int atMs) { dueMs = atMs; }
    void Fire() {
        if (work != null) { work(); }
    }
}

public class NavEmbed {
    public weak Tabs tabs;
    public List<string> names;
}

// 一条路由：名字（键）+ 标题（窗口/标签文案）+ 页面工厂 + 进入钩子。
public class NavRoute {
    public string name;
    public string title;
    public NavPageFactory make;
    public NavEnterHandler enter;
    // Embed 出口的存活策略：true（默认）切走保留，false 切走销毁。
    public bool keepAlive;
    // 窗口尺寸（逻辑像素；<=0 用 NavWindow 的 560 缺省）。
    public int winW;
    public int winH;
}
