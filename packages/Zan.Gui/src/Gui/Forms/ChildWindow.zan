using System;
using System.Collections.Generic;
using System.Json;
using Gui;
using Gui.Animation;
using Gui.Backend;
namespace Gui;
public partial class ChildWindow : ChildWindowBase {
    internal AppLoopRegistration hostLayoutRegistration;
    Control root;
    AppModelHost binder;
    bool open;
    bool destroyed;
    bool designAssembled;
    string designCss;
    int idBase;
    Action renderCb;
    long lastRenderUs = 0;
    ChildWindow() {
        host = null;
        root = null;
        binder = null;
        open = false;
        destroyed = false;
        idBase = WidgetId.Block(1000);
        renderCb = null;
    }
    override string Title() { return "Zan"; }
    virtual int Width() { return 560; }
    virtual int Height() { return 560; }
    virtual bool ShowTheme() { return false; }
    virtual bool ShowPin() { return false; }
    virtual bool ShowMinimize() { return true; }
    virtual bool ShowMaximize() { return true; }
    virtual int IdBase() { return this.idBase; }
    App Host() { return host; }
    void SetRender(Action a) { renderCb = a; }
    private ModelBinder Binder() {
        if (binder == null) { binder = new ModelBinder(); }
        return (ModelBinder)binder;
    }
    public void SetView(Control tree, object m) {
        root = tree;
        ModelBinder current = this.Binder();
        current.SetRoot(tree, m);
        if (host != null) {
            host.SetRootControl(tree);
            if (open && tree != null) {
                host.RegisterModelHost(current);
                current.Wire();
            }
        }
    }
    public override Control View() { return root; }

    // 业务初始化钩子：框架在设计稿装载后、宿主创建与声明式接线之前
    // 调用一次（时序同旧"先 Build 再 OpenHost"，Title()/IdBase() 能看到
    // 这里算出的状态）。在这里算绑定字段的初值、建 z-mount 要挂的
    // 复合控件；不装载、不 Find、不手工接线。
    protected virtual void OnCreate() { }
    protected virtual object ViewModel() { return null; }
    public virtual string DesignName() { return ""; }
    void Handle(string name, Action a) { this.Binder().Handle(name, a); }
    void HandleArg(string name, Action<string> a) { this.Binder().HandleArg(name, a); }
    void HandleSender(string name, ControlEvent a) { this.Binder().HandleSender(name, a); }
    void HandleItem(string name, ControlItemEvent a) { this.Binder().HandleItem(name, a); }
    virtual bool Pending() { return false; }
    virtual void AfterFrame() { }
    // 语言切换广播：宿主把 UI 语言切到 `lang`（"zh" / "en" 语言码）后，
    // 对每个开着的子窗口调用一次。子类在这里重填设计文档的设计期
    // 文案（ApplyTexts 模式）并刷新依赖语言的静态扇出字段；窗口
    // 标题由基类重取 Title() 处理，子类无需关心。
    override void OnLanguageChanged(string lang) { }
    private void OpenHostView(App parent, bool explicitHandlers) {
        if (open) { this.Close(); }
        else if (host != null) { this.Teardown(); }
        destroyed = false;
        this.parentApp = parent;
        open = true;
        idBase = this.IdBase();
        host = App.CreateDark(this.Title(), this.Width(), this.Height());
        if (host == null) {
            open = false;
            return;
        }
        host.SetRootControl(root);
        host.SetChildMode(true);
        if (parent != null) {
            string parentSkin = parent.SkinName();
            if (parentSkin != "") {
                host.ApplySkinName(parentSkin);
            } else {
                host.ApplySkin(parent.ThemeMenuIndex());
            }
            if (parent.Density() != host.Density()) { host.SetDensity(parent.Density()); }
            string parentCss = parent.AppCss();
            if (parentCss != "") { host.UseAppCss(parentCss); }
        }
        host.SetChromeButtons(this.ShowTheme(), this.ShowPin(), this.ShowMinimize(),
                              this.ShowMaximize());
        if (parent != null) {
            host.FollowCaptionTips(parent);
            host.SetWindowOpacity(parent.WindowOpacity());
            host.SetUserWallpaper(parent.UserWallpaperPath(),
                                  parent.UserWallpaperOpacity());
        }
        this.AssembleDoc(explicitHandlers);
        if (root != null) { root.InheritApp(host); }
        this.EnsureHostLayoutRegistration();
        host.Show();
        host.RequestRedraw();
        ChildWindows.Register(this);
        if (parent != null) {
            parent.RequestRedraw();
            parent.Wake();
        }
        if (root != null) { this.Render(); }
    }
    private void OpenStandaloneView(bool explicitHandlers) {
        if (open) { this.Close(); }
        else if (host != null) { this.Teardown(); }
        destroyed = false;
        open = true;
        idBase = this.IdBase();
        host = App.CreateDark(this.Title(), this.Width(), this.Height());
        if (host == null) {
            open = false;
            return;
        }
        host.SetRootControl(root);
        host.SetChildMode(true);
        host.ApplySkinName(this.StandaloneSkin());
        host.SetChromeButtons(this.ShowTheme(), this.ShowPin(), this.ShowMinimize(),
                              this.ShowMaximize());
        this.AssembleDoc(explicitHandlers);
        if (root != null) { root.InheritApp(host); }
        this.EnsureHostLayoutRegistration();
        AnimationTimeline.Shared.AutoBind(host);
        host.Show();
        host.RequestRedraw();
    }
    virtual string StandaloneSkin() { return Skin.DefaultName(); }
    void PumpStandaloneUntil(ChildWindowStop stop) { this.PumpStandaloneUntilMode(stop, true); }
    void PumpStandaloneUntilKeepOpen(ChildWindowStop stop) { this.PumpStandaloneUntilMode(stop, false); }
    void PumpStandaloneUntilMode(ChildWindowStop stop, bool closeWhenDone) {
        while (this.IsOpen() && (stop == null || !stop())) {
            if (host == null || !host.PumpSafe()) {
                this.Close();
                break;
            }
            if (this.IsOpen()) { this.Render(); }
        }
        if (closeWhenDone && this.IsOpen()) { this.Close(); }
    }
    override void Render() {
        this.lastRenderUs = 0;
        if (!this.NeedsRedraw()) { return; }
        long t0 = Stopwatch.GetMicroseconds();
        this.RenderContent();
        long us = Stopwatch.GetMicroseconds() - t0;
        this.lastRenderUs = us;
        ChildWindows.ReportRenderCost(this, (int)(us / 1000));
    }

    // 本帧该子窗的渲染耗时（微秒）。
    override long LastRenderUs() { return this.lastRenderUs; }
    internal void EnsureHostLayoutRegistration() {
        if (host == null || !open) { return; }
        if (root != null && binder != null) { host.RegisterModelHost(binder); }
        if (hostLayoutRegistration != null && hostLayoutRegistration.active && hostLayoutRegistration.host == host) { return; }
        AppLoopRegistration previous = hostLayoutRegistration;
        hostLayoutRegistration = null;
        if (previous != null) { previous.Invalidate(); }
        hostLayoutRegistration = host.RegisterLoopParticipant(this, new ChildHostLayout(this));
    }
    private bool ChildLayoutCurrent(App app, Control tree, AppLoopRegistration ticket,
            AppPreparationProof proof, int revision, int phase, long sequence, bool forInput) {
        bool member = !forInput || tree == null || (app.rootControl != null && app.rootControl.ContainsInputControl(tree));
        return member && open && !destroyed && host == app && root == tree && renderCb == null
            && hostLayoutRegistration == ticket && app.PreparationInputCurrent(phase, sequence)
            && app.HostPhaseCurrent(ticket, proof, revision);
    }
    internal bool SyncHostLayout(App app, bool forInput) {
        if (renderCb != null) { return true; }
        AppLoopRegistration ticket = hostLayoutRegistration;
        Control tree = root;
        if (app == null || app != host || app.window == null || !open || destroyed || ticket == null || !app.LiveLoopRegistration(ticket)) { return false; }
        AppPreparationProof proof = new AppPreparationProof(ticket);
        int revision = app.hostLayoutRevision;
        int phase = app.inputPreparationTicket;
        long sequence = app.window.EventSeq();
        if (tree == null) { return ChildLayoutCurrent(app, tree, ticket, proof, revision, phase, sequence, forInput); }
        if (!app.SyncModelHosts()) { return false; }
        if (!ChildLayoutCurrent(app, tree, ticket, proof, revision, phase, sequence, forInput)) { return false; }
        tree.MeasureTree(app);
        if (!ChildLayoutCurrent(app, tree, ticket, proof, revision, phase, sequence, forInput)) { return false; }
        int pad = app.Scale(5);
        tree.Arrange(app.ShapeOffX() + pad, app.ContentTop() + app.ShapeOffY() + pad,
            app.ClientWidth() - pad * 2, app.ClientHeight() - app.ContentTop() - pad * 2);
        return ChildLayoutCurrent(app, tree, ticket, proof, revision, phase, sequence, forInput);
    }
    private bool ContinueChildFrame(App app, Control tree, AppLoopRegistration ticket) {
        if (open && !destroyed && host == app && root == tree && renderCb == null
            && hostLayoutRegistration == ticket && app.HostLayoutPrepared(ticket)) { return true; }
        app.AbortPreparationFrame();
        return false;
    }
    void RenderContent() {
        WidgetId.Push("child_window");
        bool pushedId = idBase != 0;
        if (pushedId) { WidgetId.Push(idBase); }
        App frameHost = host;
        try {
            if (renderCb != null) {
                renderCb();
            } else {
                if (frameHost == null) { return; }
                if (frameHost.window != null && !frameHost.window.IsVisible()) { return; }
                frameHost.SyncSurface();
                frameHost.BeginFrame();
                if (!frameHost.PrepareStandardHostFrame()) { return; }
                AppLoopRegistration ticket = hostLayoutRegistration;
                Control tree = root;
                if (!ContinueChildFrame(frameHost, tree, ticket)) { return; }
                if (frameHost.shapeMode != 0 && frameHost.canvas != null) {
                    frameHost.RenderBackground(0, 0, frameHost.canvas.Width(),
                    frameHost.canvas.Height(), 0);
                    if (!ContinueChildFrame(frameHost, tree, ticket)) { return; }
                }
                if (tree != null) { tree.RenderTree(frameHost); }
                if (!ContinueChildFrame(frameHost, tree, ticket)) { return; }
                string caption = this.Title();
                if (!ContinueChildFrame(frameHost, tree, ticket)) { return; }
                frameHost.RenderChrome(caption);
                if (!ContinueChildFrame(frameHost, tree, ticket)) { return; }
                frameHost.PresentFrame();
                if (!ContinueChildFrame(frameHost, tree, ticket)) { return; }
                if (!frameHost.WriteBackModelHosts()) { frameHost.AbortPreparationFrame(); return; }
                if (!ContinueChildFrame(frameHost, tree, ticket)) { return; }
            }
        } catch (Exception error) {
            if (frameHost != null) { frameHost.AbortPreparationFrame(); }
            throw error;
        } finally {
            if (pushedId) { WidgetId.Pop(); }
            WidgetId.Pop();
        }
        this.AfterFrame();
    }
    // 窗口开着且有帧要出（宿主标脏、Pending() 或动画时钟到期）时为 true。
    override bool NeedsRedraw() {
        if (!open || host == null) { return false; }
        if (host.needsRedraw || this.Pending()) { return true; }
        int now = Window.GetTickMs();
        if (host.animNextMs >= 0 && now >= host.animNextMs) { return true; }
        if (host.fxNextMs >= 0 && now >= host.fxNextMs) { return true; }
        if (host.wakeFrameNextMs >= 0 && now >= host.wakeFrameNextMs) { return true; }
        return false;
    }

    // 窗口是否仍开着。
    override bool IsOpen() { return open; }

    // 该 OS 窗口句柄是否归本窗口所有。
    override bool OwnsWindow(nint hwnd) {
        return open && host != null && hwnd == host.WindowHandle();
    }

    override void ApplyEvent(nint hwnd) {
        if (!this.OwnsWindow(hwnd) || host == null) { return; }
        if (host.EventKind() == 8) {
            this.Close();
            return;
        }
        host.ApplyEvent(hwnd);
    }
    virtual void OnCloseRequested() { }
    void Close() {
        if (!open) { return; }
        open = false;
        App parent = this.parentApp;
        this.OnCloseRequested();
        if (host != null && host.window != null) { host.window.Close(); }
        this.Teardown();
        if (parent != null) {
            parent.RequestRedraw();
            parent.Wake();
        }
    }
    override void Teardown() {
        if (destroyed) { return; }
        destroyed = true;
        open = false;
        AppLoopRegistration oldLayout = hostLayoutRegistration;
        hostLayoutRegistration = null;
        if (oldLayout != null) { oldLayout.Invalidate(); }
        renderCb = null;
        AppModelHost oldBinder = binder;
        binder = null;
        if (oldBinder != null) { oldBinder.Detach(); }
        App oldHost = host;
        host = null;
        this.parentApp = null;
        if (oldHost != null) {
            oldHost.StopLoop();
            oldHost.SetRootControl(null);
        }
        root = null;
        if (oldHost != null) {
            if (oldHost.window != null) { oldHost.window.Destroy(); }
            if (oldHost.canvas != null) { oldHost.canvas.Destroy(); }
        }
    }
    // 请求宿主重绘（窗口开着时）。
    override void RequestRedraw() {
        if (open && host != null) {
            host.RequestRedraw();
            App parent = this.parentApp;
            if (parent != null) {
                parent.RequestRedraw();
                parent.Wake();
            }
        }
    }

    // 转发给宿主换肤（窗口开着时）。
    void ApplySkin(int i) {
        if (open && host != null) { host.ApplySkin(i); }
    }
    void SetWindowOpacity(int percent) {
        if (open && host != null) { host.SetWindowOpacity(percent); }
    }
    void SetUserWallpaper(string path, int opacity) {
        if (open && host != null) { host.SetUserWallpaper(path, opacity); }
    }
    nint WindowHandle() { return host != null ? host.WindowHandle() : 0; }
    // 主窗口换肤后同步本副窗口并重绘。
    override void FollowSkin(int i) {
        if (!open || host == null) { return; }
        host.ApplySkin(i);
        host.RequestRedraw();
    }

    // 主窗口换了界面语言：已经开着的副窗口的标题提示也得跟上。
    override void FollowCaptionTips(App src) {
        if (!open || host == null) { return; }
        host.FollowCaptionTips(src);
        host.RequestRedraw();
    }

    // 主窗口调不透明度后同步本副窗口。
    override void FollowOpacity(int percent) {
        if (!open || host == null) { return; }
        host.SetWindowOpacity(percent);
    }

    // 主窗口换壁纸后同步本副窗口。
    override void FollowWallpaper(string path, int opacity) {
        if (!open || host == null) { return; }
        host.SetUserWallpaper(path, opacity);
    }

    // 宿主的下一次动画截止时刻（毫秒时钟；窗口关闭返回 -1）。
    override int AnimNextMs() {
        if (!open || host == null) { return 0 - 1; }
        int due = host.animNextMs;
        int participantDue = host.MinLoopDeadline();
        if (participantDue >= 0 && (due < 0 || participantDue < due)) { due = participantDue; }
        if (host.wakeFrameNextMs >= 0 && (due < 0 || host.wakeFrameNextMs < due)) {
            due = host.wakeFrameNextMs;
        }
        return due;
    }

    override void TickInputGestures() {
        if (open && host != null) { host.TickRoutedLongPress(); }
    }

    // 宿主的下一次特效截止时刻（毫秒时钟；窗口关闭返回 -1）。
    override int FxNextMs() {
        if (!open || host == null) { return 0 - 1; }
        return host.fxNextMs;
    }
}
