using System;
using System.Collections.Generic;
using Gui;

namespace Gui;

// 响应式副作用与派生组合器（Binding 层，基于 Core/Signal 推送原语）。
public class Reactive {
    private class EffectRunner : ISignalObserver {
        private Action body;
        private bool running;

        public EffectRunner(Action body) {
            this.body = body;
            this.running = false;
        }

        public void OnSignalChanged() {
            if (this.running || this.body == null) { return; }
            this.running = true;
            try {
                this.body();
            } finally {
                this.running = false;
            }
        }
    }

    public static SignalSub Effect(List<ISignalSource> deps, Action body) {
        if (body == null) { return new SignalSub(null); }
        EffectRunner runner = new EffectRunner(body);
        List<ISignalSource> bound = new List<ISignalSource>();
        if (deps != null) {
            for (int i = 0; i < deps.Count; i = i + 1) {
                if (deps[i] != null) {
                    deps[i].AddObserver(runner);
                    bound.Add(deps[i]);
                }
            }
        }
        runner.OnSignalChanged();
        return new SignalSub(bound, runner);
    }

    public static SignalSub Watch<T>(State<T> sig, Action<T> handler, bool immediate) {
        if (sig == null || handler == null) { return new SignalSub(null); }
        if (immediate) { handler(sig.Get()); }
        return sig.Subscribe(handler);
    }

    public static Computed<T> Derive<T>(List<ISignalSource> deps, Func<T> compute) {
        return new Computed<T>(deps, compute);
    }
}
