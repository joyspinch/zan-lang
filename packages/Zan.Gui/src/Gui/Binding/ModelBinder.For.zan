using System;
using System.Collections.Generic;
using System.Json;
using Gui;

namespace Gui;

// ModelBinder.For.zan - <template data-for> 列表行展开、key 去重复用与作用域上下文管理
public partial class ModelBinder {
    // ---- <template data-for> 行展开 ---------------------------------------

    static void ParseForAttr(string expr, out string sourcePath, out string alias) {
        sourcePath = "";
        alias = "";
        if (expr == null || expr == "") { return; }
        string s = expr.Trim();
        int asIdx = s.IndexOf(" as ");
        if (asIdx > 0) {
            sourcePath = s.Substring(0, asIdx).Trim();
            string r = s.Substring(asIdx + 4).Trim();
            if (r.StartsWith("(") && r.EndsWith(")")) {
                r = r.Substring(1, r.Length - 2).Trim();
            }
            int comma = r.IndexOf(",");
            if (comma > 0) {
                alias = r.Substring(0, comma).Trim();
            } else {
                alias = r;
            }
            return;
        }
        int inIdx = s.IndexOf(" in ");
        if (inIdx > 0) {
            sourcePath = s.Substring(inIdx + 4).Trim();
            string l = s.Substring(0, inIdx).Trim();
            if (l.StartsWith("(") && l.EndsWith(")")) {
                l = l.Substring(1, l.Length - 2).Trim();
            }
            int comma = l.IndexOf(",");
            if (comma > 0) {
                alias = l.Substring(0, comma).Trim();
            } else {
                alias = l;
            }
            return;
        }
        sourcePath = s;
        alias = "";
    }

    void RegisterTemplates(Control c) {
        AppLoopRegistration ticket = this.hostRegistration;
        int generation = ticket != null ? ticket.generation : 0;
        Control tree = this.root;
        object state = this.model;
        this.RegisterTemplatesCurrent(c, ticket, generation, tree, state);
    }

    private void RegisterTemplatesCurrent(Control c, AppLoopRegistration ticket, int generation, Control tree, object state) {
        if (!this.HostBindingCurrent(ticket, generation, tree, state)) { return; }
        string kind = c.Kind();
        if (!this.HostBindingCurrent(ticket, generation, tree, state)) { return; }
        if (kind == "template") {
            if (this.tmplMetas == null) { this.tmplMetas = new List<ChildTemplateMeta>(); }
            for (int i = 0; i < this.tmplMetas.Count; i = i + 1) {
                if (this.tmplMetas[i].template == c) { return; }
            }
            string rawFor = c.CssAttr("data-for");
            if (!this.HostBindingCurrent(ticket, generation, tree, state)) { return; }
            string srcPath = "";
            string alias = "";
            ModelBinder.ParseForAttr(rawFor, out srcPath, out alias);
            this.tmplMetas.Add(new ChildTemplateMeta(c, 0 - 1, srcPath, alias));
            return;
        }
        for (int j = 0; j < c.ChildCount(); j = j + 1) {
            this.RegisterTemplatesCurrent(c.ChildAt(j), ticket, generation, tree, state);
            if (!this.HostBindingCurrent(ticket, generation, tree, state)) { return; }
        }
    }

    private object TemplateSource(JsonValue arr, JsonDoc doc, List<object> objList, object strongList) {
        if (arr != null) { return arr; }
        if (doc != null) { return doc; }
        if (objList != null) { return objList; }
        return strongList;
    }

    private object TemplateItem(JsonValue arr, List<object> objList, object strongList, int index) {
        if (arr != null) { return arr.At(index); }
        if (objList != null) { return objList[index]; }
        if (strongList != null) { return strongList.InvokeObject("Get", index); }
        return null;
    }

    private bool TemplateChanged(ChildTemplateMeta meta, object source, JsonValue arr, JsonDoc doc,
            List<object> objList, object strongList, int n) {
        if (meta.lastCount != n || meta.source != source) { return true; }
        // JsonDoc is immutable; a new document is caught by source identity.
        if (doc != null) { return false; }
        if (meta.items == null || meta.items.Count != n) { return true; }
        for (int k = 0; k < n; k = k + 1) {
            object item = this.TemplateItem(arr, objList, strongList, k);
            if (meta.items[k] != item) { return true; }
        }
        return false;
    }

    private void RememberTemplate(ChildTemplateMeta meta, object source, JsonValue arr, JsonDoc doc,
            List<object> objList, object strongList, int n) {
        meta.lastCount = n;
        meta.source = source;
        if (doc != null) {
            meta.items = null;
            return;
        }
        if (meta.items == null) { meta.items = new List<object>(); }
        else { meta.items.Clear(); }
        for (int k = 0; k < n; k = k + 1) {
            object item = this.TemplateItem(arr, objList, strongList, k);
            meta.items.Add(item);
        }
    }

    void EnsureExpanded() {
        AppLoopRegistration ticket = this.hostRegistration;
        int generation = ticket != null ? ticket.generation : 0;
        Control tree = this.root;
        object state = this.model;
        if (!this.HostBindingCurrent(ticket, generation, tree, state)) { return; }
        if (this.tmplMetas == null) { return; }
        for (int i = 0; i < this.tmplMetas.Count; i = i + 1) {
            if (!this.HostBindingCurrent(ticket, generation, tree, state)) { return; }
            Control t = this.tmplMetas[i].template;
            string path = this.tmplMetas[i].sourcePath;
            if (path == "") {
                string a = "";
                string rawFor = t.CssAttr("data-for");
                if (!this.HostBindingCurrent(ticket, generation, tree, state)) { return; }
                ModelBinder.ParseForAttr(rawFor, out path, out a);
                this.tmplMetas[i].sourcePath = path;
                this.tmplMetas[i].alias = a;
            }
            if (path == "" || t.ChildCount() == 0) { continue; }
            JsonValue arr = null;
            JsonDoc doc = null;
            List<object> objList = null;
            object strongList = null;
            int docArrSlot = -1;
            int n = 0;

            if (this.model != null) {
                if (this.model is JsonValue) {
                    arr = ((JsonValue)this.model).PathGet(path);
                    n = (arr != null && arr.IsArray()) ? arr.Count() : 0;
                } else if (this.model is JsonDoc) {
                    doc = (JsonDoc)this.model;
                    docArrSlot = doc.Path(doc.root, path);
                    if (docArrSlot >= 0 && doc.KindAt(docArrSlot) == 4) {
                        n = doc.Count(docArrSlot);
                    }
                } else if (this.model is List<object>) {
                    objList = (List<object>)this.model;
                    n = objList.Count;
                } else if (this.model is Dictionary<string, object>) {
                    Dictionary<string, object> d = (Dictionary<string, object>)this.model;
                    if (d.ContainsKey(path) && d[path] is List<object>) {
                        objList = (List<object>)d[path];
                        n = objList.Count;
                    }
                } else {
                    string pleaf = "";
                    object ptarget = this.ResolveTemplateFieldScope(state, path, out pleaf, ticket, generation, tree, state);
                    if (!this.HostBindingCurrent(ticket, generation, tree, state)) { return; }
                    if (ptarget != null && ptarget.HasField(pleaf)) {
                        object fo = ptarget.GetFieldObject(pleaf);
                        if (!this.HostBindingCurrent(ticket, generation, tree, state)) { return; }
                        if (fo != null && fo is List<object>) {
                            objList = (List<object>)fo;
                            n = objList.Count;
                        } else if (fo != null && fo.HasMethod("Count") && fo.HasMethod("Get")) {
                            // 强类型 List<T>（B-ID154）：反射 Count 数行，展开循环逐行
                            // InvokeObject("Get", k) 取元素；行对象为用户类实例，
                            // 行内 bind 与 data-key 走既有反射字段通道。
                            strongList = fo;
                            n = fo.InvokeInt("Count");
                            if (!this.HostBindingCurrent(ticket, generation, tree, state)) { return; }
                        }
                    }
                }
            }

            string keyAttr = t.CssAttr("data-key");
            if (!this.HostBindingCurrent(ticket, generation, tree, state)) { return; }
            ChildTemplateMeta meta = this.tmplMetas[i];
            object source = this.TemplateSource(arr, doc, objList, strongList);
            bool templateChanged = this.TemplateChanged(meta, source, arr, doc, objList, strongList, n);
            if (!this.HostBindingCurrent(ticket, generation, tree, state)) { return; }
            if (!templateChanged) { continue; }

            if (keyAttr != "" && (arr != null || (doc != null && docArrSlot >= 0) || objList != null || strongList != null)) {
                this.EnsureExpandedKeyed(t, arr, doc, docArrSlot, objList, strongList, n, keyAttr, meta, ticket, generation, tree, state);
                if (!this.HostBindingCurrent(ticket, generation, tree, state)) { return; }
            } else {
                this.RemoveRows(t);
                if (!this.HostBindingCurrent(ticket, generation, tree, state)) { return; }
                if (n == 0) {
                    this.RememberTemplate(meta, source, arr, doc, objList, strongList, n);
                    continue;
                }
                Control p = t.parent;
                if (p == null) { continue; }
                int cur = p.IndexOf(t) + 1;
                for (int k = 0; k < n; k = k + 1) {
                    object item = null;
                    if (arr != null) {
                        item = arr.At(k);
                    } else if (doc != null && docArrSlot >= 0) {
                        item = new JsonDocCursor(doc, doc.At(docArrSlot, k));
                    } else if (objList != null) {
                        item = objList[k];
                    } else if (strongList != null) {
                        item = strongList.InvokeObject("Get", k);
                        if (!this.HostBindingCurrent(ticket, generation, tree, state)) { return; }
                    }
                    for (int j = 0; j < t.ChildCount(); j = j + 1) {
                        Control row = App.CloneTree(t.ChildAt(j));
                        if (!this.HostBindingCurrent(ticket, generation, tree, state)) { return; }
                        if (row == null) { continue; }
                        p.InsertAt(cur, row);
                        if (!this.HostBindingCurrent(ticket, generation, tree, state)) { return; }
                        cur = cur + 1;
                        this.ScopeRow(row, item, meta.alias, true);
                        if (this.expandedRows == null) {
                            this.expandedRows = new List<ChildExpandedRow>();
                        }
                        this.expandedRows.Add(new ChildExpandedRow(row, t));
                        this.WireNode(row);
                        if (!this.HostBindingCurrent(ticket, generation, tree, state)) { return; }
                    }
                }
            }
            this.RememberTemplate(meta, source, arr, doc, objList, strongList, n);
        }
    }

    void EnsureExpandedKeyed(Control t, JsonValue arr, JsonDoc doc, int docArrSlot, List<object> objList, object strongList, int n, string keyAttr, ChildTemplateMeta meta, AppLoopRegistration ticket, int generation, Control tree, object state) {
        if (!this.HostBindingCurrent(ticket, generation, tree, state)) { return; }
        Control p = t.parent;
        if (p == null) { return; }

        List<ChildExpandedRow> oldRows = new List<ChildExpandedRow>();
        Dict<string, ChildExpandedRow> oldRowMap = new Dict<string, ChildExpandedRow>();
        if (this.expandedRows != null) {
            for (int i = 0; i < this.expandedRows.Count; i = i + 1) {
                if (this.expandedRows[i].template == t) {
                    oldRows.Add(this.expandedRows[i]);
                    string rk = this.expandedRows[i].key;
                    if (rk != "") {
                        oldRowMap[rk] = this.expandedRows[i];
                    }
                }
            }
        }

        List<string> newKeys = new List<string>();
        Dict<string, bool> newKeySet = new Dict<string, bool>();
        string actualKey = keyAttr;
        if (meta.alias != "" && actualKey.StartsWith(meta.alias + ".")) {
            actualKey = actualKey.Substring(meta.alias.Length + 1);
        }

        for (int k = 0; k < n; k = k + 1) {
            string keyVal = "";
            if (arr != null) {
                JsonValue item = arr.At(k);
                if (item != null) {
                    JsonValue kv = item.PathGet(actualKey);
                    if (kv != null) { keyVal = kv.AsString(""); }
                }
            } else if (doc != null && docArrSlot >= 0) {
                int itemSlot = doc.At(docArrSlot, k);
                if (itemSlot >= 0) {
                    int kSlot = doc.Path(itemSlot, actualKey);
                    if (kSlot >= 0) {
                        keyVal = doc.StrAt(kSlot, "");
                        if (keyVal == "") {
                            double d = doc.DoubleAt(kSlot, 0.0);
                            if (d != 0.0) { keyVal = Convert.ToString(d); }
                        }
                    }
                }
            } else if (objList != null || strongList != null) {
                object item = objList != null ? objList[k] : strongList.InvokeObject("Get", k);
                if (!this.HostBindingCurrent(ticket, generation, tree, state)) { return; }
                if (item != null) {
                    if (item is Dictionary<string, string>) {
                        Dictionary<string, string> d = (Dictionary<string, string>)item;
                        if (d.ContainsKey(actualKey)) { keyVal = d[actualKey]; }
                    } else if (item is Dictionary<string, object>) {
                        Dictionary<string, object> d = (Dictionary<string, object>)item;
                        if (d.ContainsKey(actualKey)) {
                            object v = d[actualKey];
                            if (v != null) { keyVal = Convert.ToString(v); }
                        }
                    } else {
                        string leaf = "";
                        object target = this.ResolveTemplateFieldScope(item, actualKey, out leaf, ticket, generation, tree, state);
                        if (!this.HostBindingCurrent(ticket, generation, tree, state)) { return; }
                        if (target != null && target.HasField(leaf)) {
                            keyVal = target.GetFieldString(leaf);
                            if (!this.HostBindingCurrent(ticket, generation, tree, state)) { return; }
                            if (keyVal == "") {
                                double d = target.GetFieldDouble(leaf);
                                if (!this.HostBindingCurrent(ticket, generation, tree, state)) { return; }
                                if (d != 0.0) { keyVal = Convert.ToString(d); }
                            }
                        }
                    }
                }
            }
            if (keyVal == "") { keyVal = k.ToString(); }
            newKeys.Add(keyVal);
            newKeySet[keyVal] = true;
        }

        for (int i = oldRows.Count - 1; i >= 0; i = i - 1) {
            string oldKey = oldRows[i].key;
            if (!newKeySet.ContainsKey(oldKey)) {
                Control row = oldRows[i].rowRoot;
                this.DetachRow(row);
                if (!this.HostBindingCurrent(ticket, generation, tree, state)) { return; }
                this.ScopeDropRow(row, true);
                this.RemoveExpandedRowEntry(oldRows[i]);
                oldRows.RemoveAt(i);
                oldRowMap.Remove(oldKey);
            }
        }

        int insertPos = p.IndexOf(t) + 1;
        for (int k = 0; k < n; k = k + 1) {
            object item = null;
            if (arr != null) {
                item = arr.At(k);
            } else if (doc != null && docArrSlot >= 0) {
                item = new JsonDocCursor(doc, doc.At(docArrSlot, k));
            } else if (objList != null) {
                item = objList[k];
            } else if (strongList != null) {
                item = strongList.InvokeObject("Get", k);
                if (!this.HostBindingCurrent(ticket, generation, tree, state)) { return; }
            }
            string keyVal = newKeys[k];

            ChildExpandedRow matched = null;
            if (oldRowMap.TryGetValue(keyVal, out matched)) {
                this.ScopeRow(matched.rowRoot, item, meta.alias, true);
                insertPos = insertPos + 1;
            } else {
                for (int j = 0; j < t.ChildCount(); j = j + 1) {
                    Control row = App.CloneTree(t.ChildAt(j));
                    if (!this.HostBindingCurrent(ticket, generation, tree, state)) { return; }
                    if (row == null) { continue; }
                    p.InsertAt(insertPos, row);
                    if (!this.HostBindingCurrent(ticket, generation, tree, state)) { return; }
                    insertPos = insertPos + 1;
                    this.ScopeRow(row, item, meta.alias, true);
                    ChildExpandedRow entry = new ChildExpandedRow(row, t, keyVal);
                    if (this.expandedRows == null) {
                        this.expandedRows = new List<ChildExpandedRow>();
                    }
                    this.expandedRows.Add(entry);
                    oldRows.Add(entry);
                    oldRowMap[keyVal] = entry;
                    this.WireNode(row);
                    if (!this.HostBindingCurrent(ticket, generation, tree, state)) { return; }
                }
            }
        }
    }

    void RemoveExpandedRowEntry(ChildExpandedRow entry) {
        if (this.expandedRows == null) { return; }
        for (int i = 0; i < this.expandedRows.Count; i = i + 1) {
            if (this.expandedRows[i] == entry) {
                this.expandedRows.RemoveAt(i);
                return;
            }
        }
    }

    void RemoveRows(Control t) {
        AppLoopRegistration ticket = this.hostRegistration;
        int generation = ticket != null ? ticket.generation : 0;
        Control tree = this.root;
        object state = this.model;
        if (!this.HostBindingCurrent(ticket, generation, tree, state) || this.expandedRows == null) { return; }
        for (int i = this.expandedRows.Count - 1; i >= 0; i = i - 1) {
            if (this.expandedRows[i].template != t) { continue; }
            Control row = this.expandedRows[i].rowRoot;
            // DropKid may remove document order before Remove throws: keep the row
            // entry and scope until successful retirement so the next pass can retry.
            this.DetachRow(row);
            if (!this.HostBindingCurrent(ticket, generation, tree, state)) { return; }
            this.ScopeDropRow(row, true);
            this.expandedRows.RemoveAt(i);
        }
    }

    // Resolve nested POCO paths without calling another old getter after rebinding.
    private object ResolveTemplateFieldScope(object scope, string path, out string leafField,
            AppLoopRegistration ticket, int generation, Control tree, object state) {
        leafField = path;
        if (scope == null || path == "") { return null; }
        object cursor = scope;
        int start = 0;
        int dot = path.IndexOf(".");
        while (dot >= 0) {
            string segment = path.Substring(start, dot - start);
            if (!cursor.HasField(segment)) { return null; }
            cursor = cursor.GetFieldObject(segment);
            if (!this.HostBindingCurrent(ticket, generation, tree, state) || cursor == null) { return null; }
            start = dot + 1;
            dot = path.IndexOf(".", start);
        }
        leafField = path.Substring(start);
        return cursor;
    }

    void DetachRow(Control row) {
        Control p = row.parent;
        if (p == null) { return; }
        if (p is Element) {
            ((Element)p).DropKid(row);
        } else {
            p.Remove(row);
        }
    }

    void ScopeRow(Control c, object item, string alias, bool rowRoot) {
        c.item = item;
        c.itemAlias = alias;
        if (rowRoot || (c.bindings != null && c.bindings.Count > 0)) {
            this.ScopePut(c, item, alias);
        }
        for (int j = 0; j < c.ChildCount(); j = j + 1) {
            this.ScopeRow(c.ChildAt(j), item, alias, false);
        }
    }

    void ScopePut(Control c, object item, string alias) {
        if (this.scopeBindings == null) {
            this.scopeBindings = new List<ChildScopeBinding>();
        }
        for (int i = 0; i < this.scopeBindings.Count; i = i + 1) {
            if (this.scopeBindings[i].control == c) {
                this.scopeBindings[i].item = item;
                this.scopeBindings[i].alias = alias;
                return;
            }
        }
        this.scopeBindings.Add(new ChildScopeBinding(c, item, alias));
    }

    ChildScopeBinding ScopeBindingOf(Control c) {
        if (this.scopeBindings == null) { return null; }
        for (int i = 0; i < this.scopeBindings.Count; i = i + 1) {
            if (this.scopeBindings[i].control == c) {
                return this.scopeBindings[i];
            }
        }
        return null;
    }

    public object ScopeOf(Control c) {
        ChildScopeBinding sb = this.ScopeBindingOf(c);
        return sb != null ? sb.item : null;
    }

    void ScopeDropRow(Control c, bool rowRoot) {
        c.item = null;
        c.itemAlias = "";
        if (rowRoot || (c.bindings != null && c.bindings.Count > 0)) {
            this.ScopeDropOne(c);
        }
        for (int j = 0; j < c.ChildCount(); j = j + 1) {
            this.ScopeDropRow(c.ChildAt(j), false);
        }
    }

    void ScopeDropOne(Control c) {
        if (this.scopeBindings == null) { return; }
        int keep = 0;
        for (int i = 0; i < this.scopeBindings.Count; i = i + 1) {
            if (this.scopeBindings[i].control == c) { continue; }
            this.scopeBindings[keep] = this.scopeBindings[i];
            keep = keep + 1;
        }
        if (keep == this.scopeBindings.Count) { return; }
        while (this.scopeBindings.Count > keep) {
            this.scopeBindings.RemoveAt(this.scopeBindings.Count - 1);
        }
    }
}
