using System;
using System.Collections.Generic;
namespace Gui;
class DocWireRelay {
    private ModelRef target;
    private string evt;
    public DocWireRelay(ModelRef target, string evt) {
        this.target = target;
        this.evt = evt;
    }
    public void Run() {
        object t = this.target != null ? this.target.Get() : null;
        if (t != null) { t.Invoke(this.evt); }
    }
    public void RunArg(string s) {
        object t = this.target != null ? this.target.Get() : null;
        if (t != null) { t.Invoke(this.evt, s); }
    }
}
public class DocWire {
    public static bool AutoWire(Control tree, object vm, ModelBinder b) {
        if (tree == null || vm == null || b == null) { return false; }
        List<string> names = new List<string>();
        DocWire.CollectHandlers(tree, names);
        List<string> missing = new List<string>();
        // 处理器闭包经绑定器登记表被窗体间接持有：直接捕获 vm（通常就是窗体）
        // 会成环，改为捕获 ModelRef（窗体弱持、独立 ViewModel 强持）。
        ModelRef target = new ModelRef(vm);
        for (int i = 0; i < names.Count; i++) {
            string h = names[i];
            if (b.HasHandler(h)) { continue; }
            if (!vm.HasMethod(h)) { missing.Add(h); continue; }
            DocWireRelay relay = new DocWireRelay(target, h);
            b.Handle(h, relay.Run);
            b.HandleArg(h, relay.RunArg);
        }
        if (missing.Count > 0) {
            Console.WriteLine("WINDOW: handlers declared in doc but missing on " +
                              vm.GetType().Name + ": " + string.Join(", ", missing));
            Environment.Exit(1);
        }
        return true;
    }
    internal static void CheckHandlers(Control tree, ModelBinder binder, string ownerName) {
        if (tree == null || binder == null) { return; }
        List<string> names = new List<string>();
        DocWire.CollectHandlers(tree, names);
        List<string> missing = new List<string>();
        for (int i = 0; i < names.Count; i++) {
            if (!binder.HasHandler(names[i])) { missing.Add(names[i]); }
        }
        if (missing.Count > 0) {
            throw new InvalidOperationException("WINDOW: handlers declared in doc but unregistered on " +
                (ownerName != null ? ownerName : "") + ": " + string.Join(", ", missing));
        }
    }
    public static void CheckBinds(Control tree, object vm, string ownerName) {
        if (tree == null || vm == null) { return; }
        List<string> bad = new List<string>();
        DocWire.CollectBinds(tree, vm, bad);
        if (bad.Count > 0) {
            string list = "";
            for (int i = 0; i < bad.Count; i++) {
                list = list + (i > 0 ? ", " : "") + bad[i];
            }
            Console.WriteLine("WINDOW: bind paths not found on " +
                              (ownerName != null ? ownerName : "") + ": " + list);
            Environment.Exit(1);
        }
    }
    public static void CollectHandlers(Control c, List<string> names) {
        if (c == null || names == null) { return; }
        if (c.events != null) {
            for (int i = 0; i < c.events.Count; i++) {
                string h = c.events[i].val;
                if (h != null && h != "" && !names.Contains(h)) { names.Add(h); }
            }
        }
        for (int j = 0; j < c.ChildCount(); j++) {
            DocWire.CollectHandlers(c.ChildAt(j), names);
        }
    }
    public static void CollectBinds(Control c, object vm, List<string> bad) {
        if (c == null || vm == null || bad == null || c.Kind() == "template") { return; }
        if (c.bindings != null) {
            for (int i = 0; i < c.bindings.Count; i = i + 1) {
                string path = c.bindings[i].path;
                if (!DocWire.FieldExists(vm, path)) { bad.Add(path); }
            }
        }
        for (int j = 0; j < c.ChildCount(); j++) {
            DocWire.CollectBinds(c.ChildAt(j), vm, bad);
        }
    }
    public static void MountSlots(Control tree, object owner) {
        if (tree == null || owner == null) { return; }
        List<Control> slots = new List<Control>();
        DocWire.CollectMounts(tree, slots);
        List<string> bad = new List<string>();
        for (int i = 0; i < slots.Count; i++) {
            Control slot = slots[i];
            string f = slot.bindMount;
            object o = owner.HasField(f) ? owner.GetFieldObject(f) : null;
            if (o == null || !(o is Control)) {
                bad.Add(f);
                continue;
            }
            slot.With((Control)o);
        }
        if (bad.Count > 0) {
            string list = "";
            for (int i = 0; i < bad.Count; i++) {
                list = list + (i > 0 ? ", " : "") + bad[i];
            }
            Console.WriteLine("WINDOW: z-mount fields missing, null or not a Control on " +
                              owner.GetType().Name + ": " + list);
            Environment.Exit(1);
        }
    }
    static void CollectMounts(Control c, List<Control> slots) {
        if (c == null || slots == null || c.Kind() == "template") { return; }
        if (c.bindMount != null && c.bindMount != "") { slots.Add(c); }
        for (int j = 0; j < c.ChildCount(); j++) {
            DocWire.CollectMounts(c.ChildAt(j), slots);
        }
    }
    public static bool IsFieldRef(string s) {
        if (!DocWire.IsPlainPath(s)) { return false; }
        char ch = s[0];
        if (!((ch >= 'a' && ch <= 'z') || (ch >= 'A' && ch <= 'Z') || ch == '_')) { return false; }
        return s != "true" && s != "false" && s != "null";
    }
    public static bool FieldExists(object vm, string path) {
        if (vm == null || path == null || path == "") { return false; }
        // 与 ModelBinder 同一取值协议：标量字典的键是整条路径（含点号）。
        return ModelAccessor.For(vm).Has(vm, path);
    }
    public static bool IsPlainPath(string s) {
        if (s == null || s == "") { return false; }
        for (int i = 0; i < s.Length; i++) {
            char ch = s[i];
            bool ok = (ch >= 'a' && ch <= 'z') || (ch >= 'A' && ch <= 'Z') ||
                      (ch >= '0' && ch <= '9') || ch == '_' || ch == '.';
            if (!ok) { return false; }
        }
        return true;
    }
}
