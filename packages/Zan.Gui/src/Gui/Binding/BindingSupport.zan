using Gui;
using System.Collections.Generic;
using System.Json;
using System;

namespace Gui;

public interface UiViewOwner {
    void PrepareView(UiViewScope view, App app);
    void ViewAction(string name, Control sender);
    void ViewPointer(Control sender, RoutedEventArgs args);
}

internal class ModelHostParticipant : AppLoopParticipant, AppLoopStopped, AppModelFrameSync {
    internal weak ModelBinder binder;
    public void Tick(App app, int now) { }
    public int NextDeadline() { return -1; }
    public bool NeedsFrameSync() {
        ModelBinder current = binder;
        return current == null || current.NeedsFrameSync();
    }
    public void Stopped(App app) {
        AppModelHost current = binder;
        if (current != null && current.HostApp() == app) { current.Detach(); }
    }
}

internal class UiViewParticipant : AppLoopParticipant, AppPreparationParticipant, AppLoopStopped {
    internal weak UiViewScope view;
    public void Tick(App app, int now) { }
    public int NextDeadline() { return -1; }
    public void BeforeInput(App app, int kind) {
        UiViewScope current = view;
        if (current != null) { current.Prepare(app); }
    }
    public void BeforePaint(App app, int frameSequence) {
        UiViewScope current = view;
        if (current != null) { current.Prepare(app); }
    }
    public void Stopped(App app) {
        UiViewScope current = view;
        if (current != null) { current.Retire(); }
    }
}

public class UiViewActions {
    internal weak UiViewScope view;
    internal weak Control sender;
    internal string name;
    internal bool active;
    public void Run() {
        UiViewScope current = view;
        if (active && current != null) { current.InvokeAction(name, sender); }
    }
    public void Send(Control source) {
        UiViewScope current = view;
        if (active && current != null) { current.InvokeAction(name, source); }
    }
    public void Pointer(Control source, RoutedEventArgs args) {
        UiViewScope current = view;
        if (active && current != null) { current.InvokePointer(source, args); }
    }
}

public class ChildScopeBinding {
    public weak Control control;
    public object item;
    public string alias;
    public ChildScopeBinding(Control control, object item) {
        this.control = control;
        this.item = item;
        this.alias = "";
    }
    public ChildScopeBinding(Control control, object item, string alias) {
        this.control = control;
        this.item = item;
        this.alias = alias;
    }
}

public class JsonDocCursor {
    public JsonDoc doc;
    public int slot;
    public JsonDocCursor(JsonDoc doc, int slot) {
        this.doc = doc;
        this.slot = slot;
    }
}

public class ModelBindingAction {
    public weak ModelBinder binder;
    public weak Control control;
    public string evt;
    public string hname;
    public string arg;
    public bool active;
    public void Run() {
        ModelBinder owner = this.binder;
        if (!this.active || owner == null) { return; }
        owner.InvokeBindingAction(this);
    }
}

class ModelValueBinding {
    public weak Control control;
    public string path;
    public string property;
    public bool twoWay;
    public string resolvedProperty;
    public int valueKind;
    public int modelKind;
    public bool hasSnapshot;
    public string snapshot;
    public ModelValueBinding(Control owner, ModelBindingDeclaration declaration) {
        this.control = owner;
        this.path = declaration.path;
        this.property = declaration.property;
        this.twoWay = declaration.twoWay;
        this.hasSnapshot = false;
        this.snapshot = "";
    }
}
