namespace Gui;
public class UiViewActions {
    internal weak UiViewScope view;
    internal weak Control sender;
    internal string name;
    internal bool active;
    public void Run() {
        UiViewScope current = view;
        if (active && current != null) { current.InvokeAction(name, sender); }
    }
    public void Send(Control source) {
        UiViewScope current = view;
        if (active && current != null) { current.InvokeAction(name, source); }
    }
    public void Pointer(Control source, RoutedEventArgs args) {
        UiViewScope current = view;
        if (active && current != null) { current.InvokePointer(source, args); }
    }
}
