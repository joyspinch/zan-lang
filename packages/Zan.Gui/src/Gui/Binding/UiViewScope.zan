using System;
using System.Collections.Generic;
namespace Gui;
public class UiViewScope : AppLoopOwner {
    private weak UiViewOwner owner;
    private weak App app;
    private weak Control root;
    private weak Control mountParent;
    private AppLoopRegistration ticket;
    private AppModelHost binder;
    private List<UiViewActions> actions;
    private bool retired;
    public UiViewScope(App app, UiViewOwner owner, Control root) {
        if (app == null || owner == null || root == null) { throw new ArgumentException("view App, owner and root required"); }
        this.app = app; this.owner = owner; this.root = root;
        this.actions = new List<UiViewActions>();
        UiViewParticipant participant = new UiViewParticipant(); participant.view = this;
        this.ticket = app.RegisterLoopParticipant(this, participant);
    }
    public bool IsActive() {
        App host = app;
        return !retired && host != null && host.isRunning && owner != null && root != null
            && ticket != null && ticket.active && ticket.host == host;
    }
    public Control Root() { return root; }
    internal ModelBinder Binder() { return binder != null ? (ModelBinder)binder : null; }
    public void Mount(Control parent) {
        if (!this.IsActive() || parent == null) { return; }
        if (mountParent == parent && root.parent == parent) { return; }
        if (mountParent != null) { throw new InvalidOperationException("view already mounted"); }
        mountParent = parent;
        Control tree = root;
        parent.Add(tree);
        if (!this.IsActive() && tree.parent == parent) { parent.Remove(tree); }
    }
    public void Bind(object model) {
        if (!this.IsActive()) { return; }
        App host = app; Control tree = root;
        AppPreparationProof proof = new AppPreparationProof(ticket);
        AppModelHost previous = binder;
        binder = null;
        if (previous != null) {
            try { previous.Detach(); }
            catch (Exception error) { if (binder == null) { binder = previous; } throw error; }
        }
        AppModelHost installed = binder;
        if (!this.IsActive() || !proof.Current(host) || app != host || root != tree || installed != null) {
            return;
        }
        ModelBinder current = new ModelBinder(); binder = current;
        current.SetRoot(tree, model);
        if (!BindingCurrent(host, proof, tree, current)) { return; }
        host.RegisterModelHost(current);
        if (!BindingCurrent(host, proof, tree, current)) { return; }
        current.Wire();
    }
    private bool BindingCurrent(App host, AppPreparationProof proof, Control tree, ModelBinder current) {
        return this.IsActive() && proof.Current(host) && app == host && root == tree && binder == current;
    }
    public UiViewActions Action(string name, Control sender) {
        UiViewActions action = new UiViewActions();
        action.view = this; action.name = name; action.sender = sender; action.active = this.IsActive();
        if (actions != null) { actions.Add(action); }
        return action;
    }
    public void Handle(string name) {
        if (binder == null || !this.IsActive()) { return; }
        UiViewActions action = this.Action(name, null);
        ModelBinder current = this.Binder();
        if (current == null) { return; }
        current.Handle(name, action.Run);
        current.HandleSender(name, action.Send);
    }
    private void Invalidate() {
        if (!this.IsActive()) { return; }
        App host = app;
        if (host == null) { return; }
        host.RequestRedraw(); host.Wake();
    }
    internal void InvokeAction(string name, Control sender) {
        if (!this.IsActive()) { return; }
        App host = app;
        UiViewOwner current = owner;
        if (host == null || current == null) { return; }
        AppPreparationProof proof = new AppPreparationProof(ticket);
        current.ViewAction(name, sender);
        if (proof.Current(host) && this.IsActive()) { this.Invalidate(); }
    }
    internal void InvokePointer(Control sender, RoutedEventArgs args) {
        if (!this.IsActive()) { return; }
        UiViewOwner current = owner;
        if (current == null) { return; }
        current.ViewPointer(sender, args);
    }
    internal void Prepare(App host) {
        if (!this.IsActive() || app != host) { return; }
        UiViewOwner current = owner;
        if (current == null) { return; }
        current.PrepareView(this, host);
    }
    private bool LayoutCurrent(App host, AppPreparationProof proof, Control tree, Control inputRoot,
            int phase, int rootGeneration, long sequence, int width, int height) {
        return this.IsActive() && app == host && root == tree && proof.Current(host)
            && host.canvas != null && host.rootControl == inputRoot && host.inputRootGeneration == rootGeneration
            && host.PreparationInputCurrent(phase, sequence)
            && host.canvas.Width() == width && host.canvas.Height() == height;
    }
    public bool Layout(int x, int y, int width, int height) {
        if (!this.IsActive()) { return false; }
        App host = app; Control tree = root;
        if (host == null || tree == null || host.window == null || host.canvas == null) { return false; }
        Control inputRoot = host.rootControl;
        AppPreparationProof proof = new AppPreparationProof(ticket);
        int phase = host.inputPreparationTicket;
        int rootGeneration = host.inputRootGeneration;
        long sequence = host.window.EventSeq();
        int canvasWidth = host.canvas.Width(); int canvasHeight = host.canvas.Height();
        if (!LayoutCurrent(host, proof, tree, inputRoot, phase, rootGeneration, sequence, canvasWidth, canvasHeight)) { return false; }
        tree.MeasureTree(host, width);
        if (!LayoutCurrent(host, proof, tree, inputRoot, phase, rootGeneration, sequence, canvasWidth, canvasHeight)) {
            host.hostLayoutRevision = host.hostLayoutRevision + 1;
            return false;
        }
        tree.Arrange(x, y, width, height);
        if (!LayoutCurrent(host, proof, tree, inputRoot, phase, rootGeneration, sequence, canvasWidth, canvasHeight)) {
            host.hostLayoutRevision = host.hostLayoutRevision + 1;
            return false;
        }
        return true;
    }
    public void Retire() {
        if (!retired) {
            retired = true;
            AppLoopRegistration previous = ticket; ticket = null;
            if (previous != null) { previous.Invalidate(); }
            if (actions != null) {
                for (int i = 0; i < actions.Count; i = i + 1) { actions[i].active = false; }
                actions = null;
            }
            owner = null;
        }
        AppModelHost oldBinder = binder;
        binder = null;
        if (oldBinder != null) { oldBinder.Detach(); }
        Control parent = mountParent; Control tree = root;
        mountParent = null; root = null; app = null;
        if (parent != null && tree != null && tree.parent == parent) { parent.Remove(tree); }
    }
}
