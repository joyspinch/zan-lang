using System;

namespace Gui;

// 绑定模型 / 处理器目标的引用：控件（窗体把自己当模型，Form.Show 与
// ChildWindow 的缺省路径）弱持，其余（独立 ViewModel、JsonValue）强持。
// 窗体持有 ModelBinder、ModelBinder 的处理器闭包与 model 字段再强指回窗体
// 就成环（S10 泄漏门禁实测 4 万个对象）；控件总由窗口树/应用持有，弱持不丢。
// 独立 ViewModel 往往只有绑定器这一个持有人，必须强持。
public class ModelRef {
    object strong;
    weak Control control;

    public ModelRef(object m) {
        this.Set(m);
    }

    public void Set(object m) {
        if (m is Control) {
            this.control = (Control)m;
            this.strong = null;
        } else {
            this.strong = m;
            this.control = null;
        }
    }

    // 控件已释放时为 null。
    public object Get() {
        if (this.strong != null) { return this.strong; }
        return this.control;
    }
}
