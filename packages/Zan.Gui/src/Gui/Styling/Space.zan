using System;

namespace Gui;

// 8pt 网格间距系统档位（标准界面排版节奏，杜绝魔数）。
//
// **全库唯一的间距真源**：Theme 的内边距/间距默认值从这里取
// （Theme.Dflt / Theme.Dark），CSS 侧的 `--space-*` 令牌由
// Style.RootFromTheme 按同一组数导出，皮肤与 IDE 壳层只引用
// 令牌或本文件的常量，不写裸像素。
//
// 镜像到 CSS：--space-xxs/-xs/-s/-sm/-m/-l/-xl/-xxl
// （见 Style.RootFromTheme）。
public class Space {
    // 0px: 无间距
    const int None = 0;
    // 2px: 微小缝隙（分割线偏移、密集状态指示微调）
    const int XXS  = 2;
    // 4px: 紧凑间距（图文并排微小间隔、Tag 内边距）
    const int XS   = 4;
    // 8px: 基础单元（标准小间距、表单项行距、控件内间距）
    const int S    = 8;
    // 12px: 次级中等间距（卡片紧凑内衬）
    const int SM   = 12;
    // 16px: 标准中等间距（模块常规内衬、卡片内边距 Padding）
    const int M    = 16;
    // 24px: 呼吸感大间距（主内容区边距、分块大间距）
    const int L    = 24;
    // 32px: 视差特大间距（模态框外留白、页面分段大空隙）
    const int XL   = 32;
    // 48px: 巨型间距（Hero 区域留白）
    const int XXL  = 48;
}
