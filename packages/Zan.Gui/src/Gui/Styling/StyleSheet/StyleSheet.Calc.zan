using System;
using System.Collections.Generic;
using Gui;
namespace Gui;
public partial class StyleSheet {
    static bool IsNumeric(string tok) {
        string s = StyleSheet.Trim(tok);
        int len = s.Length;
        if (len == 0) { return false; }
        int b0 = s[0] & 255;
        if (b0 == 45 || b0 == 43 || b0 == 46) {
            if (len < 2) { return false; }
            int b1 = s[1] & 255;
            return b1 >= 48 && b1 <= 57;
        }
        return b0 >= 48 && b0 <= 57;
    }
    static int Num(string val) {
        string s = StyleSheet.Trim(val);
        int len = s.Length;
        if (len == 0) { return 0; }
        int sign = 1;
        int i = 0;
        int b0 = s[0] & 255;
        if (b0 == 45) { sign = -1; i = 1; }
        else if (b0 == 43) { i = 1; }
        int acc = 0;
        bool any = false;
        while (i < len) {
            int b = s[i] & 255;
            if (b >= 48 && b <= 57) {
                acc = acc * 10 + (b - 48);
                any = true;
                i = i + 1;
            } else {
                break;
            }
        }
        if (!any) { return 0; }
        return sign * acc;
    }
    static int Perm(string val) {
        string s = StyleSheet.Trim(val);
        if (s.Length == 0) { return 1000; }
        if (StyleSheet.IndexOf(s, "%") >= 0) { return StyleSheet.Num(s) * 10; }
        int dot = StyleSheet.IndexOf(s, ".");
        if (dot < 0) {
            int n = StyleSheet.Num(s);
            if (n <= 1) { return n * 1000; }
            return n;
        }
        int whole = StyleSheet.Num(s.Substring(0, dot));
        int frac = 0;
        int scale = 100;
        int fStart = dot + 1;
        int fMax = fStart + 3;
        if (fMax > s.Length) { fMax = s.Length; }
        for (int i = fStart; i < fMax; i = i + 1) {
            int b = s[i] & 255;
            if (b < 48 || b > 57) { break; }
            frac = frac + (b - 48) * scale;
            scale = scale / 10;
        }
        int sign = 1;
        if (whole < 0) { sign = -1; whole = -whole; }
        return sign * (whole * 1000 + frac);
    }
    static int Ms(string val) {
        string s = StyleSheet.Trim(val);
        if (s.Length == 0) { return 0; }
        string lo = StyleSheet.Lower(s);
        if (StyleSheet.IndexOf(lo, "ms") >= 0) { return StyleSheet.Num(s); }
        if (StyleSheet.IndexOf(lo, "s") >= 0) { return StyleSheet.Perm(s); }
        return StyleSheet.Num(s);
    }
    static int Len(StyleBox b, string val) {
        string v = StyleSheet.Trim(val);
        b.lengthPhysical = false;
        if (v == "") { return 0; }
        bool previousMath = b.lengthMath;
        b.lengthMath = StyleSheet.HasMath(v);
        int n = b.lengthMath ? StyleSheet.CssMath(b, v) : StyleSheet.UnitPx(b, v);
        b.lengthMath = previousMath;
        return n;
    }
    static int LenField(StyleBox b, string val, long source) {
        bool previous = b.lengthDevice;
        b.lengthDevice = true;
        int n = StyleSheet.Len(b, val);
        b.lengthDevice = previous;
        b.SetPrescaled(source, b.lengthPhysical);
        return n;
    }
    static int LenStored(StyleBox b, string val, long source) {
        bool previous = b.lengthDevice;
        b.lengthDevice = StyleSheet.HasMath(val);
        int n = StyleSheet.Len(b, val);
        b.lengthDevice = previous;
        b.SetPrescaled(source, b.lengthPhysical);
        return n;
    }
    static int UnitResult(StyleBox b, int n, bool physical) {
        if (physical) { b.lengthPhysical = true; return n; }
        if (b.lengthDevice && b.envDpiScale != 100) {
            b.lengthPhysical = true;
            return b.ScaleLogical(n);
        }
        return n;
    }
    static int FontUnit(StyleBox b, bool root) {
        bool useFont = !root && b.fontPx > 0;
        int rootFont = b.envRootFontPx > 0 ? b.envRootFontPx : b.envRemPx;
        int f = useFont ? b.fontPx : (rootFont > 0 ? rootFont : 16);
        bool physical = useFont ? b.IsPrescaled(StyleBox.SourceFont()) : b.envRemPhysical;
        if (b.lengthDevice && !physical && b.envDpiScale != 100) {
            f = b.ScaleLogical(f);
            physical = true;
        }
        if (physical) { b.lengthPhysical = true; }
        return f;
    }
    static bool HasMath(string v) {
        if (v == null || v.IndexOf("(") < 0) { return false; }
        string s = StyleSheet.Lower(v);
        return Css.IndexFrom(s, "calc(", 0) >= 0
            || Css.IndexFrom(s, "min(", 0) >= 0
            || Css.IndexFrom(s, "max(", 0) >= 0
            || Css.IndexFrom(s, "clamp(", 0) >= 0;
    }
    static int Round1000(int perm) {
        if (perm >= 0) { return (perm + 500) / 1000; }
        return 0 - ((0 - perm + 500) / 1000);
    }
    static int NumPerm(string numStr) {
        if (numStr == null) { return 0; }
        int len = numStr.Length;
        if (len == 0) { return 0; }
        int sign = 1;
        int i = 0;
        int b0 = numStr[0] & 255;
        if (b0 == 45) {
            sign = -1;
            i = 1;
        } else if (b0 == 43) {
            i = 1;
        }
        int whole = 0;
        while (i < len) {
            int b = numStr[i] & 255;
            if (b >= 48 && b <= 57) {
                whole = whole * 10 + (b - 48);
                i = i + 1;
            } else {
                break;
            }
        }
        int frac = 0;
        if (i < len && (numStr[i] & 255) == 46) {
            i = i + 1;
            if (i < len) {
                int b1 = numStr[i] & 255;
                if (b1 >= 48 && b1 <= 57) {
                    frac = frac + (b1 - 48) * 100;
                    i = i + 1;
                    if (i < len) {
                        int b2 = numStr[i] & 255;
                        if (b2 >= 48 && b2 <= 57) {
                            frac = frac + (b2 - 48) * 10;
                            i = i + 1;
                            if (i < len) {
                                int b3 = numStr[i] & 255;
                                if (b3 >= 48 && b3 <= 57) { frac = frac + (b3 - 48); }
                            }
                        }
                    }
                }
            }
        }
        return sign * (whole * 1000 + frac);
    }
    static int UnitPx(StyleBox b, string tok) {
        string s = StyleSheet.Trim(tok);
        int len = s.Length;
        if (len == 0) { return 0; }
        int i = 0;
        int b0 = s[0] & 255;
        if (b0 == 45 || b0 == 43) { i = 1; }
        while (i < len) {
            int ch = s[i] & 255;
            if ((ch >= 48 && ch <= 57) || ch == 46) { i = i + 1; }
            else { break; }
        }
        string numStr = s.Substring(0, i);
        string unit = StyleSheet.Lower(s.Substring(i, len - i));
        if (numStr == "" || numStr == "-" || numStr == "+") { return StyleSheet.Num(s); }
        int perm = StyleSheet.NumPerm(numStr);
        int n = StyleSheet.Round1000(perm);
        if (unit == "dpx" || b.declPrescaled) { return StyleSheet.UnitResult(b, n, true); }
        if (unit == "" && b.lengthMath) { return n; }
        if (unit == "" || unit == "px") { return StyleSheet.UnitResult(b, n, false); }
        if (unit == "em" || unit == "rem" || unit == "ex" || unit == "ch") {
            int font = StyleSheet.FontUnit(b, unit == "rem");
            if (unit == "ex" || unit == "ch") { return StyleSheet.Round1000(perm * font / 2); }
            return StyleSheet.Round1000(perm * font);
        }
        if (unit == "pt") { n = StyleSheet.Round1000(perm * 4 / 3); }
        else if (unit == "pc") { n = StyleSheet.Round1000(perm * 16); }
        else if (unit == "in") { n = StyleSheet.Round1000(perm * 96); }
        else if (unit == "cm") { n = StyleSheet.Round1000(perm * 37795 / 1000); }
        else if (unit == "mm") { n = StyleSheet.Round1000(perm * 37795 / 10000); }
        else if (unit == "q") { n = StyleSheet.Round1000(perm * 37795 / 40000); }
        else if (unit == "vw") {
            int w = b.envVw > 0 ? b.envVw : 1280;
            n = StyleSheet.Round1000(perm * w / 100);
        } else if (unit == "vh") {
            int h = b.envVh > 0 ? b.envVh : 720;
            n = StyleSheet.Round1000(perm * h / 100);
        } else if (unit == "vmin" || unit == "vmax") {
            int w2 = b.envVw > 0 ? b.envVw : 1280;
            int h2 = b.envVh > 0 ? b.envVh : 720;
            int base2 = unit == "vmin" ? (w2 < h2 ? w2 : h2) : (w2 > h2 ? w2 : h2);
            n = StyleSheet.Round1000(perm * base2 / 100);
        } else if (unit == "%") {
            return n;
        }
        return StyleSheet.UnitResult(b, n, false);
    }
    static int CssMath(StyleBox b, string val) {
        string v = StyleSheet.Trim(val);
        string lo = StyleSheet.Lower(v);
        if (StyleSheet.StartsWith(lo, "clamp(")) {
            int open = StyleSheet.IndexOf(v, "(");
            int close = v.Length - 1;
            while (close > open && v.Substring(close, 1) != ")") { close = close - 1; }
            List<string> a = Css.SplitTopTrim(
                v.Substring(open + 1, close - open - 1), ",");
            if (a.Count < 3) { return 0; }
            int mn = StyleSheet.CssMath(b, a[0]);
            int mid = StyleSheet.CssMath(b, a[1]);
            int mx = StyleSheet.CssMath(b, a[2]);
            return mn > mx ? mn : (mid < mn ? mn : (mid > mx ? mx : mid));
        }
        if (StyleSheet.StartsWith(lo, "min(") || StyleSheet.StartsWith(lo, "max(")) {
            bool isMin = StyleSheet.StartsWith(lo, "min(");
            int open2 = StyleSheet.IndexOf(v, "(");
            int close2 = v.Length - 1;
            while (close2 > open2 && v.Substring(close2, 1) != ")") { close2 = close2 - 1; }
            List<string> a2 = Css.SplitTopTrim(
                v.Substring(open2 + 1, close2 - open2 - 1), ",");
            if (a2.Count == 0) { return 0; }
            int best = StyleSheet.CssMath(b, a2[0]);
            for (int i = 1; i < a2.Count; i = i + 1) {
                int cur = StyleSheet.CssMath(b, a2[i]);
                if (isMin ? cur < best : cur > best) { best = cur; }
            }
            return best;
        }
        int op = Css.IndexFrom(lo, "calc(", 0);
        string expr = op >= 0
            ? v.Substring(op + 5, v.Length - op - 5) : v;
        int endI = expr.Length - 1;
        while (endI >= 0 && expr.Substring(endI, 1) != ")") { endI = endI - 1; }
        if (endI >= 0 && op >= 0) { expr = expr.Substring(0, endI); }
        List<string> toks = StyleSheet.MathTokens(expr);
        MathCursor cur2 = new MathCursor();
        cur2.toks = toks;
        cur2.pos = 0;
        int val2 = StyleSheet.MathExpr(b, cur2);
        return val2;
    }
    static List<string> MathTokens(string s) {
        List<string> outp = new List<string>();
        int n = s.Length;
        int i = 0;
        while (i < n) {
            int b = s[i] & 255;
            if (Css.IsSpaceByte(b)) { i = i + 1; continue; }
            if (b == 40 || b == 41 || b == 43 || b == 45 || b == 42 || b == 47) {
                outp.Add(s.Substring(i, 1));
                i = i + 1;
                continue;
            }
            int st = i;
            while (i < n) {
                int b2 = s[i] & 255;
                if (Css.IsSpaceByte(b2) || b2 == 40 || b2 == 41 || b2 == 43
                    || b2 == 45 || b2 == 42 || b2 == 47) {
                    break;
                }
                i = i + 1;
            }
            outp.Add(s.Substring(st, i - st));
        }
        return outp;
    }
    static int MathExpr(StyleBox b, MathCursor c) {
        int v = StyleSheet.MathTerm(b, c);
        while (c.pos < c.toks.Count) {
            string op = c.toks[c.pos];
            if (op != "+" && op != "-") { break; }
            c.pos = c.pos + 1;
            int r = StyleSheet.MathTerm(b, c);
            v = op == "+" ? v + r : v - r;
        }
        return v;
    }
    static int MathTerm(StyleBox b, MathCursor c) {
        int v = StyleSheet.MathFactor(b, c);
        while (c.pos < c.toks.Count) {
            string op = c.toks[c.pos];
            if (op != "*" && op != "/") { break; }
            c.pos = c.pos + 1;
            int r = StyleSheet.MathFactor(b, c);
            if (op == "*") { v = v * r; }
            else { v = r == 0 ? 0 : v / r; }
        }
        return v;
    }
    static int MathFactor(StyleBox b, MathCursor c) {
        if (c.pos >= c.toks.Count) { return 0; }
        string tok = c.toks[c.pos];
        if (tok == "(") {
            c.pos = c.pos + 1;
            int v = StyleSheet.MathExpr(b, c);
            if (c.pos < c.toks.Count && c.toks[c.pos] == ")") { c.pos = c.pos + 1; }
            return v;
        }
        if (tok == "-") {
            c.pos = c.pos + 1;
            return 0 - StyleSheet.MathFactor(b, c);
        }
        if (tok == "+") {
            c.pos = c.pos + 1;
            return StyleSheet.MathFactor(b, c);
        }
        c.pos = c.pos + 1;
        return StyleSheet.UnitPx(b, tok);
    }
    static int ParseInt(string s) { return StyleSheet.Num(s); }
    static List<string> Tokens(string val) {
        List<string> outp = new List<string>();
        if (val == null || val.Length == 0) { return outp; }
        int n = val.Length;
        int depth = 0;
        int start = 0;
        for (int i = 0; i < n; i = i + 1) {
            int b = val[i] & 255;
            if (b == 40) { depth = depth + 1; }
            else if (b == 41) { depth = depth - 1; }
            else if (depth == 0 && Css.IsSpaceByte(b)) {
                if (i > start) { outp.Add(val.Substring(start, i - start)); }
                start = i + 1;
            }
        }
        if (n > start) { outp.Add(val.Substring(start, n - start)); }
        return outp;
    }
    static bool StartsWith(string s, string prefix) {
        if (s == null || prefix == null) { return false; }
        return s.StartsWith(prefix);
    }
    static int IndexOf(string s, string ch) { return Css.IndexFrom(s, ch, 0); }
    static bool EndsWith(string s, string suffix) {
        if (s == null || suffix == null) { return false; }
        return s.EndsWith(suffix);
    }
    static int LastIndexOf(string s, string ch) {
        if (s == null || ch == null) { return -1; }
        return s.LastIndexOf(ch);
    }
    static string Lower(string s) { return s.ToLower(); }
    static string Trim(string s) { return Css.Trim(s); }
    static string Scalar(JsonValue v) {
        if (v.IsString()) { return v.AsString(""); }
        if (v.IsNumber()) { return v.AsString(""); }
        if (v.IsBool()) { if (v.AsBool(false)) { return "true"; } return "false"; }
        return "";
    }
}
