using System;
using System.Collections.Generic;
using Gui;
namespace Gui;
public partial class StyleSheet {
    static bool DeclMotion(StyleBox b, string k, string v) {
        if (k == "transition") {
            StyleSheet.DeclTransition(b, v);
            return true;
        }
        if (k == "transition-duration") {
            int ms = StyleSheet.Ms(v);
            b.transitionMs = ms < 0 ? 0 : ms;
            return true;
        }
        if (k == "transition-delay") {
            b.EnsureMotion().transitionDelayMs = StyleSheet.Ms(v);
            return true;
        }
        if (k == "transition-property") {
            b.EnsureMotion().transitionPropMask = MotionSpec.ParsePropMask(v);
            return true;
        }
        if (k == "transition-timing-function") {
            StyleSheet.ApplyTimingFunction(b, v, false);
            return true;
        }
        if (k == "transform") { StyleSheet.DeclTransform(b, v); return true; }
        if (k == "rotate") { b.rotate = StyleSheet.Num(v); return true; }
        if (k == "scale") { b.scale = StyleSheet.Perm(v); return true; }
        if (k == "translate") {
            List<string> t = StyleSheet.Tokens(v);
            if (t.Count >= 1) { b.tx = StyleSheet.LenField(b, t[0], StyleBox.SourceTx()); }
            b.ty = StyleSheet.LenField(b, t.Count >= 2 ? t[1] : "0", StyleBox.SourceTy());
            return true;
        }
        if (k == "animation") {
            StyleSheet.DeclAnimation(b, v);
            return true;
        }
        if (k == "animation-name") {
            StyleSheet.DeclAnimationName(b, v);
            return true;
        }
        if (k == "animation-duration") {
            int ms = StyleSheet.Ms(v);
            b.animMs = ms < 0 ? 0 : ms;
            return true;
        }
        if (k == "animation-delay") { b.EnsureMotion().animDelayMs = StyleSheet.Ms(v); return true; }
        if (k == "animation-timing-function") {
            StyleSheet.ApplyTimingFunction(b, v, true);
            return true;
        }
        if (k == "animation-iteration-count") {
            string lo = StyleSheet.Lower(StyleSheet.Trim(v));
            if (lo == "infinite") { b.EnsureMotion().animIterations = 0 - 1; }
            else {
                int cnt = StyleSheet.Num(lo);
                b.EnsureMotion().animIterations = cnt >= 0 ? cnt : 1;
            }
            return true;
        }
        if (k == "animation-direction") {
            b.EnsureMotion().animDirection = StyleSheet.ParseAnimDirection(v);
            return true;
        }
        if (k == "animation-fill-mode") {
            b.EnsureMotion().animFillMode = StyleSheet.ParseAnimFillMode(v);
            return true;
        }
        if (k == "animation-play-state") {
            b.EnsureMotion().animPaused = StyleSheet.Lower(StyleSheet.Trim(v)) == "paused";
            return true;
        }
        return false;
    }
    static void DeclBackground(StyleBox b, string val) {
        if (b == null || val == null) { return; }
        string s = val;
        string lo = StyleSheet.Lower(s);
        if (StyleSheet.StartsWith(lo, "linear-gradient(")) {
            int close = StyleSheet.LastIndexOf(s, ")");
            if (close < 16) { close = s.Length; }
            string inner = s.Substring(16, close - 16);
            List<string> parts = Css.SplitTopTrim(inner, ",");
            List<string> stops = new List<string>();
            bool leftward = false;
            int i = 0;
            while (i < parts.Count) {
                string p = parts[i];
                i = i + 1;
                if (p == "") { continue; }
                if (StyleSheet.IsLeftward(p)) { leftward = true; }
                int dir = StyleSheet.GradientDir(p);
                if (dir >= 0) { b.bgDir = dir; continue; }
                stops.Add(p);
            }
            if (stops.Count >= 2) {
                b.bg = StyleSheet.ParseColor(StyleSheet.StopColor(stops[0]));
                if (stops.Count >= 3) {
                    b.bgVia = StyleSheet.ParseColor(StyleSheet.StopColor(stops[1]));
                    b.bgTo = StyleSheet.ParseColor(StyleSheet.StopColor(stops[2]));
                } else {
                    b.bgVia = 0;
                    b.bgTo = StyleSheet.ParseColor(StyleSheet.StopColor(stops[1]));
                }
                if (leftward) {
                    int cs = b.bg; b.bg = b.bgTo; b.bgTo = cs;
                }
                return;
            }
        }
        if (lo == "none" || lo == "transparent") {
            b.bg = 0;
            b.bgTo = 0;
            b.bgVia = 0;
            return;
        }
        b.bg = StyleSheet.ParseColor(s);
        b.bgTo = 0;
        b.bgVia = 0;
    }
    static int GradientDir(string tok) {
        string s = StyleSheet.Lower(tok);
        if (s == "to bottom" || s == "180deg") { return 0; }
        if (s == "to right" || s == "90deg" || s == "to left"
            || s == "270deg") { return 1; }
        if (s == "to bottom right" || s == "135deg" || s == "to right bottom") { return 2; }
        if (s == "to top" || s == "0deg" || s == "360deg") { return 3; }
        if (s == "to bottom left" || s == "225deg" || s == "to left bottom") { return 4; }
        if (StyleSheet.EndsWith(s, "deg")) {
            int deg = StyleSheet.Num(tok);
            int d = deg % 360;
            if (d < 0) { d = d + 360; }
            int best = 0;
            int bestDist = 1000;
            for (int ci = 0; ci < 5; ci = ci + 1) {
                int a = 0;
                int dir = 0;
                if (ci == 0) { a = 180; dir = 0; }  // 底
                else if (ci == 1) { a = 0; dir = 3; }  // 顶
                else if (ci == 2) { a = 90; dir = 1; }  // 右
                else if (ci == 3) { a = 135; dir = 2; }  // 右下
                else { a = 225; dir = 4; }  // 左下
                int dist = a - d;
                if (dist < 0) { dist = 0 - dist; }
                if (dist > 180) { dist = 360 - dist; }
                if (dist < bestDist) {
                    bestDist = dist;
                    best = dir;
                }
            }
            return best;
        }
        return 0 - 1;
    }
    static bool IsLeftward(string tok) {
        string s = StyleSheet.Lower(tok);
        return s == "to left" || s == "270deg";
    }
    static void DeclTextShadow(StyleBox b, string val) {
        if (b == null || val == null) { return; }
        if (StyleSheet.Lower(StyleSheet.Trim(val)) == "none") {
            b.tsColor = 0; b.tsDx = 0; b.tsDy = 0; b.tsOutline = 0;
            return;
        }
        List<string> layers = Css.SplitTopTrim(val, ",");
        if (layers.Count == 0) { return; }
        List<string> toks = StyleSheet.Tokens(layers[0]);
        List<int> nums = new List<int>();
        int col = 0;
        int i = 0;
        while (i < toks.Count) {
            string tk = toks[i];
            i = i + 1;
            if (StyleSheet.IsNumeric(tk)) { nums.Add(StyleSheet.Len(b, tk)); continue; }
            col = StyleSheet.ParseColor(tk);
        }
        if (col != 0) { b.tsColor = col; }
        if (nums.Count >= 1) { b.tsDx = nums[0]; }
        if (nums.Count >= 2) { b.tsDy = nums[1]; }
        if (layers.Count >= 3 && b.tsColor != 0
            && (b.tsDx != 0 || b.tsDy != 0)) {
            b.tsOutline = 1;
        }
    }
    static string StopColor(string stop) {
        string s = StyleSheet.Trim(stop);
        string lo = StyleSheet.Lower(s);
        if (StyleSheet.StartsWith(lo, "rgb") || StyleSheet.StartsWith(lo, "hsl")
            || StyleSheet.StartsWith(lo, "hwb(") || StyleSheet.StartsWith(lo, "oklab(")
            || StyleSheet.StartsWith(lo, "oklch(") || StyleSheet.StartsWith(lo, "lab(")
            || StyleSheet.StartsWith(lo, "lch(") || StyleSheet.StartsWith(lo, "color-mix(")) {
            int open = StyleSheet.IndexOf(s, "(");
            int close = open >= 0 ? Css.MatchParen(s, open) : -1;
            if (close > 0) { return s.Substring(0, close + 1); }
            return s;
        }
        int sp = StyleSheet.IndexOf(s, " ");
        if (sp > 0) { return s.Substring(0, sp); }
        return s;
    }
    static void DeclBorder(StyleBox b, string val, int side) {
        List<string> toks = StyleSheet.Tokens(val);
        long source = StyleBox.SourceBorder();
        if (side == 1) { source = StyleBox.SourceBorderTop(); }
        else if (side == 2) { source = StyleBox.SourceBorderRight(); }
        else if (side == 3) { source = StyleBox.SourceBorderBottom(); }
        else if (side == 4) { source = StyleBox.SourceBorderLeft(); }
        int w = StyleSheet.LenField(b, "1px", source);
        int col = 0;
        bool haveW = false;
        bool haveStyle = false;
        bool haveColor = false;
        int style = 0;
        int i = 0;
        while (i < toks.Count) {
            string tk = toks[i];
            i = i + 1;
            string lo = StyleSheet.Lower(tk);
            if (lo == "solid" || lo == "dashed" || lo == "dotted"
                || lo == "double" || lo == "groove" || lo == "ridge"
                || lo == "inset" || lo == "outset" || lo == "none") {
                haveStyle = true;
                if (lo == "dashed" || lo == "dotted") { style = 1; }
                if (lo == "none") { w = 0; haveW = true; }
                continue;
            }
            if (StyleSheet.IsNumeric(tk) || StyleSheet.HasMath(tk)) {
                w = StyleSheet.LenField(b, tk, source);
                haveW = true;
                continue;
            }
            col = StyleSheet.ParseColor(tk);
            haveColor = col != 0 || lo == "transparent";
        }
        if (!haveW) { w = StyleSheet.LenField(b, "1px", source); }
        if (w < 0) { w = 0; }
        if (haveStyle) { b.borderStyle = style; }
        if (side == 0) {
            b.borderW = w;
            if (haveColor) { b.borderColor = col; }
            b.borderTopW = 0 - 1; b.borderRightW = 0 - 1;
            b.borderBottomW = 0 - 1; b.borderLeftW = 0 - 1;
        } else if (side == 1) {
            b.borderTopW = w; b.borderTopColor = col;
        } else if (side == 2) {
            b.borderRightW = w; b.borderRightColor = col;
        } else if (side == 3) {
            b.borderBottomW = w; b.borderBottomColor = col;
        } else {
            b.borderLeftW = w; b.borderLeftColor = col;
        }
    }
    static void DeclRadius(StyleBox b, string val) {
        List<string> toks = StyleSheet.Tokens(val);
        if (toks.Count == 0) { return; }
        b.radiusTL = StyleSheet.LenField(b, StyleSheet.SideToken(toks, 0), StyleBox.SourceRadiusTL());
        b.radiusTR = StyleSheet.LenField(b, StyleSheet.SideToken(toks, 1), StyleBox.SourceRadiusTR());
        b.radiusBR = StyleSheet.LenField(b, StyleSheet.SideToken(toks, 2), StyleBox.SourceRadiusBR());
        b.radiusBL = StyleSheet.LenField(b, StyleSheet.SideToken(toks, 3), StyleBox.SourceRadiusBL());
        if (b.radiusTL < 0) { b.radiusTL = 0; }
        if (b.radiusTR < 0) { b.radiusTR = 0; }
        if (b.radiusBR < 0) { b.radiusBR = 0; }
        if (b.radiusBL < 0) { b.radiusBL = 0; }
        int r = b.radiusTL;
        long source = StyleBox.SourceRadiusTL();
        if (b.radiusTR > r) { r = b.radiusTR; source = StyleBox.SourceRadiusTR(); }
        if (b.radiusBR > r) { r = b.radiusBR; source = StyleBox.SourceRadiusBR(); }
        if (b.radiusBL > r) { r = b.radiusBL; source = StyleBox.SourceRadiusBL(); }
        b.radius = r;
        b.SetPrescaled(StyleBox.SourceRadius(), b.IsPrescaled(source));
    }
    static void CornerRadius(StyleBox b, int which, int v) {
        if (v < 0) { v = 0; }
        long source = StyleBox.SourceRadiusTL();
        if (which == 1) { source = StyleBox.SourceRadiusTR(); }
        else if (which == 2) { source = StyleBox.SourceRadiusBR(); }
        else if (which == 3) { source = StyleBox.SourceRadiusBL(); }
        bool physical = b.IsPrescaled(source);
        int fb = b.radius;
        if (fb < 0) { fb = 0; }
        bool inherited = b.IsPrescaled(StyleBox.SourceRadius());
        if (b.radiusTL < 0) { b.radiusTL = fb; b.SetPrescaled(StyleBox.SourceRadiusTL(), inherited); }
        if (b.radiusTR < 0) { b.radiusTR = fb; b.SetPrescaled(StyleBox.SourceRadiusTR(), inherited); }
        if (b.radiusBR < 0) { b.radiusBR = fb; b.SetPrescaled(StyleBox.SourceRadiusBR(), inherited); }
        if (b.radiusBL < 0) { b.radiusBL = fb; b.SetPrescaled(StyleBox.SourceRadiusBL(), inherited); }
        b.SetPrescaled(source, physical);
        if (which == 0) { b.radiusTL = v; }
        else if (which == 1) { b.radiusTR = v; }
        else if (which == 2) { b.radiusBR = v; }
        else { b.radiusBL = v; }
        int max = b.radiusTL;
        if (b.radiusTR > max) { max = b.radiusTR; }
        if (b.radiusBR > max) { max = b.radiusBR; }
        if (b.radiusBL > max) { max = b.radiusBL; }
        b.radius = max;
        long maxSource = StyleBox.SourceRadiusTL();
        if (b.radiusTR == max) { maxSource = StyleBox.SourceRadiusTR(); }
        if (b.radiusBR == max) { maxSource = StyleBox.SourceRadiusBR(); }
        if (b.radiusBL == max) { maxSource = StyleBox.SourceRadiusBL(); }
        b.SetPrescaled(StyleBox.SourceRadius(), b.IsPrescaled(maxSource));
    }
    static void DeclShadow(StyleBox b, string val) {
        if (StyleSheet.Lower(val) == "none") {
            b.shadow = 0;
            b.shadow2 = 0;
            b.shadowInset = 0;
            return;
        }
        List<string> layers = Css.SplitTopTrim(val, ",");
        b.shadow2 = 0;
        b.shadow2Dx = 0;
        b.shadow2Dy = 0;
        b.shadow2Blur = 0;
        b.shadowInset = 0;
        for (int li = 0; li < layers.Count && li < 2; li = li + 1) {
            List<string> toks = StyleSheet.Tokens(layers[li]);
            List<string> nums = new List<string>();
            int col = 0;
            bool isInset = false;
            int i = 0;
            while (i < toks.Count) {
                string tk = toks[i];
                i = i + 1;
                if (StyleSheet.Lower(tk) == "inset") { isInset = true; continue; }
                if (StyleSheet.IsNumeric(tk) || StyleSheet.HasMath(tk)) { nums.Add(tk); continue; }
                col = StyleSheet.ParseColor(tk);
            }
            if (li == 0) {
                if (isInset) { b.shadowInset = 1; }
                if (col != 0) { b.shadow = col; }
                if (nums.Count >= 2) {
                    b.shadowDx = StyleSheet.LenStored(b, nums[0], StyleBox.SourceShadowDx());
                    b.shadowDy = StyleSheet.LenStored(b, nums[1], StyleBox.SourceShadowDy());
                    if (nums.Count >= 3) {
                        int sb1 = StyleSheet.LenStored(b, nums[2], StyleBox.SourceShadowBlur());
                        b.shadowBlur = sb1 < 0 ? 0 : sb1;
                    }
                    else { b.shadowBlur = 0; b.SetPrescaled(StyleBox.SourceShadowBlur(), false); }
                } else if (nums.Count == 1) {
                    b.shadowDx = 0;
                    b.shadowDy = StyleSheet.LenStored(b, nums[0], StyleBox.SourceShadowDy());
                } else if (b.shadowDy == 0) {
                    b.shadowDy = 2;
                    b.SetPrescaled(StyleBox.SourceShadowDy(), false);
                }
            } else if (!isInset && col != 0) {
                b.shadow2 = col;
                if (nums.Count >= 2) {
                    b.shadow2Dx = StyleSheet.LenStored(b, nums[0], StyleBox.SourceShadow2Dx());
                    b.shadow2Dy = StyleSheet.LenStored(b, nums[1], StyleBox.SourceShadow2Dy());
                    if (nums.Count >= 3) {
                        int sb2 = StyleSheet.LenStored(b, nums[2], StyleBox.SourceShadow2Blur());
                        b.shadow2Blur = sb2 < 0 ? 0 : sb2;
                    }
                    else { b.shadow2Blur = 0; b.SetPrescaled(StyleBox.SourceShadow2Blur(), false); }
                } else if (nums.Count == 1) {
                    b.shadow2Dx = 0;
                    b.shadow2Dy = StyleSheet.LenStored(b, nums[0], StyleBox.SourceShadow2Dy());
                }
            }
        }
    }
    static void DeclSheen(StyleBox b, string val) {
        if (StyleSheet.Lower(val) == "none") {
            b.sheen = 0;
            return;
        }
        List<string> toks = StyleSheet.Tokens(val);
        int i = 0;
        int str = 0 - 1;
        while (i < toks.Count) {
            string tk = toks[i];
            i = i + 1;
            if (StyleSheet.IsNumeric(tk)) {
                if (str < 0) { str = StyleSheet.Perm(tk); }
                continue;
            }
            b.sheenColor = StyleSheet.ParseColor(tk);
        }
        if (str < 0) { str = 1000; }
        if (str > 1000) { str = 1000; }
        b.sheen = str;
    }
    static void DeclSpotlight(StyleBox b, string val) {
        string lo = StyleSheet.Lower(StyleSheet.Trim(val));
        if (lo == "none" || lo == "0" || lo == "off" || lo == "false") {
            b.specular = b.specular & ~2;
            b.spotlightStrength = 0;
            return;
        }
        b.specular = b.specular | 2;
        if (lo == "1" || lo == "on" || lo == "true" || lo == "auto") {
            b.spotlightStrength = 580;
            return;
        }
        List<string> toks = StyleSheet.Tokens(val);
        int i = 0;
        int str = 0 - 1;
        while (i < toks.Count) {
            string tk = toks[i];
            i = i + 1;
            if (StyleSheet.IsNumeric(tk)) {
                if (str < 0) {
                    int n = StyleSheet.Perm(tk);
                    str = (tk == "1") ? 580 : n;
                }
                continue;
            }
            b.spotlightColor = StyleSheet.ParseColor(tk);
        }
        if (str <= 0) { str = 580; }
        if (str > 1000) { str = 1000; }
        b.spotlightStrength = str;
    }
    static int SideVal(StyleBox b, string tok, bool margin) {
        if (tok == "auto") { return margin ? 0 - 1 : 0; }
        return StyleSheet.Len(b, tok);
    }
    static string SideToken(List<string> toks, int side) {
        if (toks == null || toks.Count == 0) { return ""; }
        if (side == 0) { return toks[0]; }
        if (side == 1) { return toks.Count >= 2 ? toks[1] : toks[0]; }
        if (side == 2) { return toks.Count >= 3 ? toks[2] : toks[0]; }
        return toks.Count >= 4 ? toks[3] : (toks.Count >= 2 ? toks[1] : toks[0]);
    }
    static int SideLength(StyleBox b, string tok, bool margin, long source) {
        if (tok == "auto") {
            b.SetPrescaled(source, false);
            return margin ? StyleBox.Unset() : 0;
        }
        int v = StyleSheet.LenField(b, tok, source);
        if (!margin && v < 0) { v = 0; }
        return v;
    }
    static void DeclSides(StyleBox b, string val, int which) {
        List<string> toks = StyleSheet.Tokens(val);
        if (toks.Count == 0) { return; }
        if (which == 0) {
            b.padT = StyleSheet.SideLength(b, StyleSheet.SideToken(toks, 0), false, StyleBox.SourcePadT());
            b.padR = StyleSheet.SideLength(b, StyleSheet.SideToken(toks, 1), false, StyleBox.SourcePadR());
            b.padB = StyleSheet.SideLength(b, StyleSheet.SideToken(toks, 2), false, StyleBox.SourcePadB());
            b.padL = StyleSheet.SideLength(b, StyleSheet.SideToken(toks, 3), false, StyleBox.SourcePadL());
        } else {
            b.marT = StyleSheet.SideLength(b, StyleSheet.SideToken(toks, 0), true, StyleBox.SourceMarT());
            b.marR = StyleSheet.SideLength(b, StyleSheet.SideToken(toks, 1), true, StyleBox.SourceMarR());
            b.marB = StyleSheet.SideLength(b, StyleSheet.SideToken(toks, 2), true, StyleBox.SourceMarB());
            b.marL = StyleSheet.SideLength(b, StyleSheet.SideToken(toks, 3), true, StyleBox.SourceMarL());
        }
    }
    static List<string> SplitSpaceTop(string val) {
        List<string> outp = new List<string>();
        if (val == null) { return outp; }
        int depth = 0;
        int start = 0 - 1;
        for (int i = 0; i < val.Length; i = i + 1) {
            int ch = val[i] & 255;
            if (ch == 40) { depth = depth + 1; }
            else if (ch == 41 && depth > 0) { depth = depth - 1; }
            bool ws = depth == 0 && (ch == 32 || ch == 9 || ch == 10 || ch == 13);
            if (ws) {
                if (start >= 0) {
                    outp.Add(val.Substring(start, i - start));
                    start = 0 - 1;
                }
            } else if (start < 0) {
                start = i;
            }
        }
        if (start >= 0) { outp.Add(val.Substring(start, val.Length - start)); }
        return outp;
    }
    static bool ApplyTimingFunction(StyleBox b, string raw, bool forAnim) {
        string s = StyleSheet.Lower(StyleSheet.Trim(raw));
        int e = StyleSheet.Easing(s);
        if (e >= 0) {
            if (forAnim) { b.EnsureMotion().animEasing = e; }
            else { b.easing = e; }
            return true;
        }
        if (s == "step-start" || s == "step-end") {
            MotionSpec m = b.EnsureMotion();
            bool jumpEnd = s == "step-end";
            if (forAnim) {
                m.animEasing = 6; m.animStepsCount = 1; m.animStepsJumpEnd = jumpEnd;
            } else {
                b.easing = 6; m.stepsCount = 1; m.stepsJumpEnd = jumpEnd;
            }
            return true;
        }
        if (StyleSheet.StartsWith(s, "cubic-bezier(") && StyleSheet.EndsWith(s, ")")) {
            string inner = s.Substring(13, s.Length - 14);
            List<string> args = Css.SplitTopTrim(inner, ",");
            if (args.Count == 4) {
                float x1 = 0.0f; float y1 = 0.0f; float x2 = 0.0f; float y2 = 0.0f;
                if (float.TryParse(args[0], out x1) && float.TryParse(args[1], out y1)
                    && float.TryParse(args[2], out x2) && float.TryParse(args[3], out y2)) {
                    MotionSpec m = b.EnsureMotion();
                    if (forAnim) {
                        m.animEasing = 5;
                        m.animBezX1 = x1; m.animBezY1 = y1; m.animBezX2 = x2; m.animBezY2 = y2;
                    } else {
                        b.easing = 5;
                        m.bezX1 = x1; m.bezY1 = y1; m.bezX2 = x2; m.bezY2 = y2;
                    }
                    return true;
                }
            }
        }
        if (StyleSheet.StartsWith(s, "steps(") && StyleSheet.EndsWith(s, ")")) {
            string inner = s.Substring(6, s.Length - 7);
            List<string> args = Css.SplitTopTrim(inner, ",");
            if (args.Count >= 1) {
                int cnt = StyleSheet.Num(args[0]);
                if (cnt < 1) { cnt = 1; }
                bool jumpEnd = true;
                if (args.Count >= 2) {
                    string mode = StyleSheet.Lower(args[1]);
                    if (mode == "start" || mode == "jump-start") { jumpEnd = false; }
                }
                MotionSpec m = b.EnsureMotion();
                if (forAnim) {
                    m.animEasing = 6; m.animStepsCount = cnt; m.animStepsJumpEnd = jumpEnd;
                } else {
                    b.easing = 6; m.stepsCount = cnt; m.stepsJumpEnd = jumpEnd;
                }
                return true;
            }
        }
        if (s == "spring" || s == "spring-snappy" || s == "spring-smooth"
            || s == "spring-bouncy" || s == "spring-gentle") {
            float k = 260.0f; float c = 22.0f;
            if (s == "spring-snappy") { k = 420.0f; c = 28.0f; }
            else if (s == "spring-smooth") { k = 220.0f; c = 26.0f; }
            else if (s == "spring-bouncy") { k = 280.0f; c = 15.0f; }
            else if (s == "spring-gentle") { k = 140.0f; c = 20.0f; }
            StyleSheet.SetSpringTiming(b, forAnim, k, c, 1.0f);
            return true;
        }
        if (StyleSheet.StartsWith(s, "spring(") && StyleSheet.EndsWith(s, ")")) {
            string inner = s.Substring(7, s.Length - 8);
            List<string> args = Css.SplitTopTrim(inner, ",");
            if (args.Count == 1) {
                float bounce = 0.25f;
                if (float.TryParse(args[0], out bounce)) {
                    float k = 260.0f; float c = 22.0f;
                    MotionSpec.SpringFromBounce(0.5f, bounce, out k, out c);
                    StyleSheet.SetSpringTiming(b, forAnim, k, c, 1.0f);
                    return true;
                }
            } else if (args.Count >= 2) {
                float k = 260.0f; float c = 22.0f; float mass = 1.0f;
                if (float.TryParse(args[0], out k) && float.TryParse(args[1], out c)) {
                    if (args.Count >= 3) { float.TryParse(args[2], out mass); }
                    if (mass <= 0.01f) { mass = 1.0f; }
                    StyleSheet.SetSpringTiming(b, forAnim, k, c, mass);
                    return true;
                }
            }
        }
        return false;
    }
    static void SetSpringTiming(StyleBox b, bool forAnim, float k, float c, float mass) {
        MotionSpec m = b.EnsureMotion();
        if (forAnim) {
            m.animEasing = 7;
            m.animSpringStiffness = k; m.animSpringDamping = c; m.animSpringMass = mass;
        } else {
            b.easing = 7;
            m.springStiffness = k; m.springDamping = c; m.springMass = mass;
        }
    }
    static int ParseAnimDirection(string val) {
        string lo = StyleSheet.Lower(StyleSheet.Trim(val));
        if (lo == "reverse") { return 1; }
        if (lo == "alternate") { return 2; }
        if (lo == "alternate-reverse") { return 3; }
        return 0;
    }
    static int ParseAnimFillMode(string val) {
        string lo = StyleSheet.Lower(StyleSheet.Trim(val));
        if (lo == "forwards") { return 1; }
        if (lo == "backwards") { return 2; }
        if (lo == "both") { return 3; }
        return 0;
    }
    static void DeclTransition(StyleBox b, string val) {
        string trimmed = StyleSheet.Lower(StyleSheet.Trim(val));
        if (trimmed == "none") {
            b.transitionMs = 0;
            b.EnsureMotion().transitionPropMask = MotionSpec.PropNone();
            return;
        }
        List<string> items = Css.SplitTopTrim(val, ",");
        int propMask = 0;
        bool hasExplicitProp = false;
        bool hasAll = false;
        for (int it = 0; it < items.Count; it = it + 1) {
            List<string> toks = StyleSheet.SplitSpaceTop(items[it]);
            int timeIdx = 0;
            for (int i = 0; i < toks.Count; i = i + 1) {
                string tk = toks[i];
                if (StyleSheet.IsNumeric(tk)) {
                    int ms = StyleSheet.Ms(tk);
                    if (timeIdx == 0) {
                        if (ms < 0) { ms = 0; }
                        if (it == 0 || ms > b.transitionMs) { b.transitionMs = ms; }
                    } else if (timeIdx == 1) {
                        b.EnsureMotion().transitionDelayMs = ms;
                    }
                    timeIdx = timeIdx + 1;
                    continue;
                }
                if (StyleSheet.ApplyTimingFunction(b, tk, false)) { continue; }
                int bit = MotionSpec.PropBit(tk);
                if (bit == MotionSpec.PropAll()) {
                    hasAll = true;
                } else if (bit == MotionSpec.PropNone()) {
                    b.transitionMs = 0;
                    propMask = MotionSpec.PropNone();
                    hasExplicitProp = true;
                } else if (bit > 0) {
                    propMask = propMask | bit;
                    hasExplicitProp = true;
                }
            }
        }
        if (hasAll) {
            if (b.motion != null) { b.motion.transitionPropMask = MotionSpec.PropAll(); }
        } else if (hasExplicitProp) {
            b.EnsureMotion().transitionPropMask = propMask;
        }
    }
    static void DeclTransform(StyleBox b, string val) {
        string s = val;
        if (StyleSheet.Lower(s) == "none") {
            b.tx = 0; b.ty = 0; b.scale = 1000; b.rotate = 0;
            b.SetPrescaled(StyleBox.SourceTx() | StyleBox.SourceTy(), false);
            return;
        }
        int i = 0;
        while (i < s.Length) {
            int open = Css.IndexFrom(s, "(", i);
            if (open < 0) { return; }
            int close = Css.MatchParen(s, open);
            if (close < 0) { return; }
            string name = StyleSheet.Lower(StyleSheet.Trim(s.Substring(i, open - i)));
            string args = s.Substring(open + 1, close - open - 1);
            i = close + 1;
            List<string> a = Css.SplitTopTrim(args, ",");
            if (name == "translate") {
                if (a.Count >= 1) { b.tx = StyleSheet.LenField(b, a[0], StyleBox.SourceTx()); }
                if (a.Count >= 2) { b.ty = StyleSheet.LenField(b, a[1], StyleBox.SourceTy()); }
            } else if (name == "translatex") {
                if (a.Count >= 1) { b.tx = StyleSheet.LenField(b, a[0], StyleBox.SourceTx()); }
            } else if (name == "translatey") {
                if (a.Count >= 1) { b.ty = StyleSheet.LenField(b, a[0], StyleBox.SourceTy()); }
            } else if (name == "scale") {
                if (a.Count >= 1) { b.scale = StyleSheet.Perm(a[0]); }
            } else if (name == "rotate") {
                if (a.Count >= 1) { b.rotate = StyleSheet.Num(a[0]); }
            }
        }
    }
    static void DeclAnimationName(StyleBox b, string val) {
        string trimmed = StyleSheet.Trim(val);
        string lo = StyleSheet.Lower(trimmed);
        if (lo == "" || lo == "none") {
            b.anim = 0;
            if (b.motion != null) { b.motion.animName = ""; }
            return;
        }
        int kind = Style.AnimKind(lo);
        if (kind != 0) {
            b.anim = kind;
            if (b.motion != null) { b.motion.animName = ""; }
            return;
        }
        b.anim = 0;
        b.EnsureMotion().animName = trimmed;
    }
    static bool IsTimeToken(string tk) {
        string lo = StyleSheet.Lower(tk);
        return StyleSheet.EndsWith(lo, "ms") || StyleSheet.EndsWith(lo, "s");
    }
    static void DeclAnimation(StyleBox b, string val) {
        List<string> toks = StyleSheet.SplitSpaceTop(val);
        int timeIdx = 0;
        int i = 0;
        while (i < toks.Count) {
            string tk = toks[i];
            i = i + 1;
            string lo = StyleSheet.Lower(tk);
            if (lo == "none") {
                b.anim = 0;
                if (b.motion != null) { b.motion.animName = ""; }
                continue;
            }
            if (lo == "infinite") {
                b.EnsureMotion().animIterations = 0 - 1;
                continue;
            }
            if (lo == "normal" || lo == "reverse" || lo == "alternate" || lo == "alternate-reverse") {
                b.EnsureMotion().animDirection = StyleSheet.ParseAnimDirection(lo);
                continue;
            }
            if (lo == "forwards" || lo == "backwards" || lo == "both") {
                b.EnsureMotion().animFillMode = StyleSheet.ParseAnimFillMode(lo);
                continue;
            }
            if (lo == "running" || lo == "paused") {
                b.EnsureMotion().animPaused = lo == "paused";
                continue;
            }
            if (StyleSheet.ApplyTimingFunction(b, tk, true)) {
                int e = StyleSheet.Easing(lo);
                if (e >= 0) { b.easing = e; }
                continue;
            }
            if (StyleSheet.IsNumeric(tk)) {
                if (StyleSheet.IsTimeToken(tk)) {
                    int ms = StyleSheet.Ms(tk);
                    if (timeIdx == 0) { b.animMs = ms < 0 ? 0 : ms; }
                    else if (timeIdx == 1) { b.EnsureMotion().animDelayMs = ms; }
                    timeIdx = timeIdx + 1;
                } else {
                    int cnt = StyleSheet.Num(tk);
                    b.EnsureMotion().animIterations = cnt >= 0 ? cnt : 1;
                }
                continue;
            }
            int kind = Style.AnimKind(lo);
            if (kind != 0) {
                b.anim = kind;
                if (b.motion != null) { b.motion.animName = ""; }
            } else {
                b.anim = 0;
                b.EnsureMotion().animName = tk;
            }
        }
    }
    static int BlurArg(StyleBox b, string val) {
        int at = Css.IndexFrom(StyleSheet.Lower(val), "blur(", 0);
        if (at < 0) { return 0; }
        int close = Css.IndexFrom(val, ")", at);
        if (close < 0) { return 0; }
        int v = StyleSheet.LenStored(b, val.Substring(at + 5, close - at - 5), StyleBox.SourceBlur());
        return v < 0 ? 0 : v;
    }
    static int Easing(string val) {
        string s = StyleSheet.Lower(val);
        if (s == "ease") { return 0; }
        if (s == "linear") { return 1; }
        if (s == "ease-in") { return 2; }
        if (s == "ease-out") { return 3; }
        if (s == "ease-in-out") { return 4; }
        return 0 - 1;
    }
    static int Weight(string val) {
        string s = StyleSheet.Lower(val);
        if (s == "bold" || s == "bolder") { return 700; }
        if (s == "normal") { return 400; }
        if (s == "light" || s == "lighter") { return 300; }
        return StyleSheet.Num(s);
    }
    static int CursorCode(string val) {
        string s = StyleSheet.Lower(val);
        if (s == "pointer" || s == "hand" || s == "grab") { return Cursor.Hand(); }
        if (s == "text") { return Cursor.IBeam(); }
        if (s == "ew-resize" || s == "col-resize"
            || s == "e-resize" || s == "w-resize") { return Cursor.ResizeH(); }
        if (s == "ns-resize" || s == "row-resize"
            || s == "n-resize" || s == "s-resize") { return Cursor.ResizeV(); }
        if (s == "grabbing" || s == "zoom-in") { return Cursor.Hand(); }
        return Cursor.Arrow();
    }
}
