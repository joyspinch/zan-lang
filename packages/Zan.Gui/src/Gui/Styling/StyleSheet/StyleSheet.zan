using System;
using System.Collections.Generic;
using Gui;
namespace Gui;
public partial class StyleSheet {
    JsonValue rules;
    JsonValue vars;
    string state;
    List<StyleRuleEntry> ruleEntries;
    int indexedCount;
    Dict<string, List<int>> byType;
    Dict<string, List<int>> byId;
    Dict<string, List<int>> byClass;
    List<int> anyFallback;
    int atRulesDropped;
    Dict<string, int> atRuleKinds;
    int atGuardsSkipped;
    Dict<string, int> atRuleGuards;
    List<string> lintDropped;
    List<string> lintNever;
    List<string> lintUnused;
    List<string> lintValue;
    List<string> lintInert;
    int lintGen;
    bool relational;
    bool hasImportant;
    bool hasMediaImportant;
    List<int> importantRules;
    List<StyleMediaEntry> mediaEntries;
    int mediaCount;
    Dict<string, CssKeyframeRule> keyframes;
    StyleSheet() {
        this.rules = JsonValue.NewObject();
        this.vars = JsonValue.NewObject();
        this.state = "";
        this.indexedCount = 0 - 1;
        this.atRulesDropped = 0;
        this.atRuleKinds = new Dict<string, int>();
        this.atGuardsSkipped = 0;
        this.atRuleGuards = new Dict<string, int>();
        this.lintGen = 0 - 1;
        this.hasImportant = false;
        this.hasMediaImportant = false;
        this.importantRules = new List<int>();
        this.anyFallback = new List<int>();
    }
    void NoteAtRule(string name) {
        this.atRulesDropped = this.atRulesDropped + 1;
        if (this.atRuleKinds == null) { this.atRuleKinds = new Dict<string, int>(); }
        int cur = 0;
        if (this.atRuleKinds.TryGetValue(name, out cur)) {
            this.atRuleKinds[name] = cur + 1;
        } else {
            this.atRuleKinds.Add(name, 1);
        }
    }
    void NoteGuard(string cond) {
        this.atGuardsSkipped = this.atGuardsSkipped + 1;
        if (this.atRuleGuards == null) { this.atRuleGuards = new Dict<string, int>(); }
        string name = Css.Trim(cond);
        int cur = 0;
        if (this.atRuleGuards.TryGetValue(name, out cur)) {
            this.atRuleGuards[name] = cur + 1;
        } else {
            this.atRuleGuards.Add(name, 1);
        }
    }
    void AddKeyframes(CssKeyframeRule rule) {
        if (rule == null || rule.name == "") { return; }
        if (this.keyframes == null) { this.keyframes = new Dict<string, CssKeyframeRule>(); }
        if (this.keyframes.ContainsKey(rule.name)) {
            this.keyframes[rule.name] = rule;
        } else {
            this.keyframes.Add(rule.name, rule);
        }
    }
    CssKeyframeRule FindKeyframes(string name) {
        if (this.keyframes == null || name == "") { return null; }
        CssKeyframeRule found;
        if (this.keyframes.TryGetValue(name, out found)) { return found; }
        string lo = StyleSheet.Lower(name);
        if (lo != name && this.keyframes.TryGetValue(lo, out found)) { return found; }
        return null;
    }
    static StyleSheet FromCss(string src) { return Css.Parse(src); }
    void AddMediaRule(string sel, JsonValue block, MediaCond cond) {
        Selector p = Selector.Parse(sel);
        if (p == null) {
            if (this.lintDropped == null) { this.lintDropped = new List<string>(); }
            this.lintDropped.Add(sel);
            return;
        }
        if (p.Relational()) { this.relational = true; }
        if (this.mediaEntries == null) { this.mediaEntries = new List<StyleMediaEntry>(); }
        JsonValue imp = block == null ? null : block.Get("__zan_important");
        if (imp != null && imp.IsObject() && imp.Count() > 0) { this.hasMediaImportant = true; }
        this.mediaEntries.Add(new StyleMediaEntry(p, block, imp, cond));
        this.mediaCount = this.mediaCount + 1;
    }
    bool HasMedia() { return this.mediaEntries != null && this.mediaEntries.Count > 0; }
    void ApplyMedia(StyleBox b, string type, List<string> want, string cls,
                    string id, string part, int stateBits, StyleNode node,
                    bool importantPass) {
        if (this.mediaEntries == null) { return; }
        for (int i = 0; i < this.mediaEntries.Count; i = i + 1) {
            StyleMediaEntry entry = this.mediaEntries[i];
            if (!entry.condition.True(b)) { continue; }
            if (!entry.selector.MatchNodeCtx(type, want, cls, id, part,
                                                stateBits, node)) {
                continue;
            }
            if (importantPass) {
                if (entry.compiledImportant != null) {
                    StyleSheet.ApplyCompiledList(b, entry.compiledImportant);
                }
            } else {
                if (entry.compiledNormal != null) {
                    StyleSheet.ApplyCompiledList(b, entry.compiledNormal);
                }
            }
        }
    }
    void MergeSheet(StyleSheet other) {
        if (other == null) { return; }
        for (int i = 0; i < other.rules.Count(); i = i + 1) {
            Css.MergeInto(this, other.rules.KeyAt(i), other.rules.ValAt(i));
        }
        for (int j = 0; j < other.vars.Count(); j = j + 1) {
            vars.Set(other.vars.KeyAt(j), other.vars.ValAt(j));
        }
        this.atRulesDropped = this.atRulesDropped + other.atRulesDropped;
        if (other.atRuleKinds != null && other.atRuleKinds.Count > 0) {
            List<string> kinds = other.atRuleKinds.Keys;
            for (int a = 0; a < kinds.Count; a = a + 1) {
                string kind = kinds[a];
                int add = 0;
                other.atRuleKinds.TryGetValue(kind, out add);
                int cur = 0;
                if (this.atRuleKinds.TryGetValue(kind, out cur)) {
                    this.atRuleKinds[kind] = cur + add;
                } else {
                    this.atRuleKinds.Add(kind, add);
                }
            }
        }
        this.atGuardsSkipped = this.atGuardsSkipped + other.atGuardsSkipped;
        if (other.atRuleGuards != null && other.atRuleGuards.Count > 0) {
            List<string> conds = other.atRuleGuards.Keys;
            for (int c = 0; c < conds.Count; c = c + 1) {
                string cond = conds[c];
                int add = 0;
                other.atRuleGuards.TryGetValue(cond, out add);
                int cur = 0;
                if (this.atRuleGuards.TryGetValue(cond, out cur)) {
                    this.atRuleGuards[cond] = cur + add;
                } else {
                    this.atRuleGuards.Add(cond, add);
                }
            }
        }
        if (other.mediaEntries != null && other.mediaEntries.Count > 0) {
            if (this.mediaEntries == null) { this.mediaEntries = new List<StyleMediaEntry>(); }
            for (int m = 0; m < other.mediaEntries.Count; m = m + 1) {
                StyleMediaEntry me = other.mediaEntries[m];
                this.mediaEntries.Add(new StyleMediaEntry(me.selector, me.block, me.important, me.condition));
            }
            this.mediaCount = this.mediaCount + other.mediaCount;
            if (other.relational) { this.relational = true; }
        }
        if (other.keyframes != null && other.keyframes.Count > 0) {
            List<string> kfNames = other.keyframes.Keys;
            for (int kf = 0; kf < kfNames.Count; kf = kf + 1) {
                CssKeyframeRule kr;
                if (other.keyframes.TryGetValue(kfNames[kf], out kr) && kr != null) {
                    this.AddKeyframes(kr);
                }
            }
        }
        this.indexedCount = 0 - 1;
    }
    static StyleSheet FromJson(string src) {
        StyleSheet s = new StyleSheet();
        JsonValue v = JsonValue.ParseLenient(src);
        if (v != null && v.IsObject()) { s.rules = v; }
        return s;
    }
    bool IsEmpty() { return rules == null || rules.Count() == 0; }
    List<string> Audit() { return this.Lint(); }
    string Var(string name) {
        if (vars == null) { return ""; }
        JsonValue v = vars.Get(name);
        if (v == null) { return ""; }
        return v.AsString("");
    }
    JsonValue Block(string selector) {
        if (rules == null) { return null; }
        JsonValue block = rules.Get(selector);
        if (block == null || !block.IsObject()) { return null; }
        return block;
    }
    void ApplyBox(StyleBox b, string selector) {
        JsonValue block = this.Block(selector);
        if (block == null) { return; }
        for (int i = 0; i < block.Count(); i = i + 1) {
            string k = block.KeyAt(i);
            if (StyleSheet.InternalKey(k)) { continue; }
            JsonValue v = block.ValAt(i);
            StyleSheet.DeclBlock(b, block, k, false);
        }
        JsonValue imp = block.Get("__zan_important");
        if (imp != null && imp.IsObject()) {
            for (int j = 0; j < imp.Count(); j = j + 1) {
                string k = imp.KeyAt(j);
                StyleSheet.DeclBlock(b, block, k, true);
            }
        }
        StyleSheet.ResolveCurrentColor(b);
    }
    void ApplyMatch(StyleBox b, string type, string cls, string id, string part,
                    int stateBits) {
        this.ApplyMatchCtx(b, type, cls, id, part, stateBits, null);
    }
    void ApplyMatchCtx(StyleBox b, string type, string cls, string id,
                       string part, int stateBits, StyleNode node) {
        this.Index();
        this.ApplyCascadeCtx(b, type, cls, id, part, stateBits, node);
        this.ApplyImportantCtx(b, type, cls, id, part, stateBits, node);
        StyleSheet.ResolveCurrentColor(b);
    }
    void ApplyCascade(StyleBox b, string type, string cls, string id, string part,
                      int stateBits) {
        this.ApplyCascadeCtx(b, type, cls, id, part, stateBits, null);
    }
    void ApplyCascadeBucket(StyleBox b, List<int> bucket, string type,
                            List<string> want, string cls, string id,
                            string part, int stateBits, StyleNode node) {
        int n = bucket.Count;
        for (int k = 0; k < n; k = k + 1) {
            int i = bucket[k];
            if (this.MatchesCtx(i, type, want, id, part, stateBits, cls, node)) {
                if (this.ruleEntries != null && i < this.ruleEntries.Count) {
                    StyleSheet.ApplyCompiledList(b, this.ruleEntries[i].compiledNormal);
                }
            }
        }
    }
    void ApplyCascadePair(StyleBox b, List<int> ba, List<int> bb, string type,
                          List<string> want, string cls, string id,
                          string part, int stateBits, StyleNode node) {
        int a = 0;
        int c = 0;
        int aLen = ba.Count;
        int cLen = bb.Count;
        while (a < aLen || c < cLen) {
            int i;
            if (a >= aLen) {
                i = bb[c];
                c = c + 1;
            } else if (c >= cLen) {
                i = ba[a];
                a = a + 1;
            } else {
                int ia = ba[a];
                int ic = bb[c];
                if (ia < ic) { i = ia; a = a + 1; }
                else { i = ic; c = c + 1; }
            }
            if (this.MatchesCtx(i, type, want, id, part, stateBits, cls, node)) {
                if (this.ruleEntries != null && i < this.ruleEntries.Count) {
                    StyleSheet.ApplyCompiledList(b, this.ruleEntries[i].compiledNormal);
                }
            }
        }
    }
    void ApplyCascadeCtx(StyleBox b, string type, string cls, string id,
                         string part, int stateBits, StyleNode node) {
        List<int> b0 = null;
        List<int> b1 = null;
        List<List<int>> extra = null;
        int bCount = 0;

        if (type != "" && this.byType != null) {
            List<int> typed;
            if (this.byType.TryGetValue(type, out typed) && typed != null && typed.Count > 0) {
                b0 = typed;
                bCount = 1;
            }
        }
        if (id != "" && this.byId != null) {
            List<int> idBucket;
            if (this.byId.TryGetValue(id, out idBucket) && idBucket != null && idBucket.Count > 0) {
                if (bCount == 0) { b0 = idBucket; bCount = 1; }
                else if (bCount == 1) { b1 = idBucket; bCount = 2; }
                else {
                    if (extra == null) { extra = new List<List<int>>(); extra.Add(b0); extra.Add(b1); }
                    extra.Add(idBucket);
                    bCount = bCount + 1;
                }
            }
        }
        if (this.anyFallback != null && this.anyFallback.Count > 0) {
            if (bCount == 0) { b0 = this.anyFallback; bCount = 1; }
            else if (bCount == 1) { b1 = this.anyFallback; bCount = 2; }
            else {
                if (extra == null) { extra = new List<List<int>>(); extra.Add(b0); extra.Add(b1); }
                extra.Add(this.anyFallback);
                bCount = bCount + 1;
            }
        }
        List<string> want = null;
        if (cls != "") {
            want = Style.Classes(cls);
            if (this.byClass != null && want != null && want.Count > 0) {
                int wc = want.Count;
                for (int ci = 0; ci < wc; ci = ci + 1) {
                    string cn = want[ci];
                    bool dup = false;
                    for (int pi = 0; pi < ci; pi = pi + 1) {
                        if (want[pi] == cn) { dup = true; break; }
                    }
                    if (dup) { continue; }
                    List<int> clsBucket;
                    if (this.byClass.TryGetValue(cn, out clsBucket)
                        && clsBucket != null && clsBucket.Count > 0) {
                        if (bCount == 0) { b0 = clsBucket; bCount = 1; }
                        else if (bCount == 1) { b1 = clsBucket; bCount = 2; }
                        else {
                            if (extra == null) {
                                extra = new List<List<int>>();
                                extra.Add(b0);
                                extra.Add(b1);
                            }
                            extra.Add(clsBucket);
                            bCount = bCount + 1;
                        }
                    }
                }
            }
        }
        if (bCount == 0) {
            if (this.mediaEntries != null && this.mediaEntries.Count > 0) {
                if (want == null) { want = Style.Classes(cls); }
                this.ApplyMedia(b, type, want, cls, id, part, stateBits, node, false);
            }
            return;
        }
        if (want == null) { want = Style.Classes(cls); }
        if (bCount == 1) {
            this.ApplyCascadeBucket(b, b0, type, want, cls, id, part, stateBits, node);
        } else if (bCount == 2) {
            this.ApplyCascadePair(b, b0, b1, type, want, cls, id, part, stateBits, node);
        } else {
            int kCount = extra.Count;
            List<int> pos = new List<int>();
            for (int k = 0; k < kCount; k = k + 1) { pos.Add(0); }
            while (true) {
                int bestK = 0 - 1;
                int bestIdx = 2147483647;
                for (int k = 0; k < kCount; k = k + 1) {
                    int p = pos[k];
                    List<int> bk = extra[k];
                    if (p < bk.Count) {
                        int v = bk[p];
                        if (v < bestIdx) {
                            bestIdx = v;
                            bestK = k;
                        }
                    }
                }
                if (bestK < 0) { break; }
                pos[bestK] = pos[bestK] + 1;
                if (this.MatchesCtx(bestIdx, type, want, id, part, stateBits, cls, node)) {
                    if (this.ruleEntries != null && bestIdx < this.ruleEntries.Count) {
                        StyleSheet.ApplyCompiledList(b, this.ruleEntries[bestIdx].compiledNormal);
                    }
                }
            }
        }
        if (this.mediaEntries != null && this.mediaEntries.Count > 0) {
            this.ApplyMedia(b, type, want, cls, id, part, stateBits, node, false);
        }
    }
    void ApplyImportant(StyleBox b, string type, string cls, string id,
                        string part, int stateBits) {
        this.ApplyImportantCtx(b, type, cls, id, part, stateBits, null);
    }
    void ApplyImportantCtx(StyleBox b, string type, string cls, string id,
                           string part, int stateBits, StyleNode node) {
        if (!this.hasImportant && !this.hasMediaImportant) { return; }
        int impCount = (this.hasImportant && this.importantRules != null)
            ? this.importantRules.Count : 0;
        if (impCount == 0 && !this.hasMediaImportant) { return; }
        List<string> want = Style.Classes(cls);
        if (impCount > 0) {
            for (int idx = 0; idx < impCount; idx = idx + 1) {
                int i = this.importantRules[idx];
                if (this.ruleEntries == null || i >= this.ruleEntries.Count) { continue; }
                if (!this.MatchesCtx(i, type, want, id, part, stateBits, cls, node)) { continue; }
                StyleSheet.ApplyCompiledList(b, this.ruleEntries[i].compiledImportant);
            }
        }
        if (this.hasMediaImportant) { this.ApplyMedia(b, type, want, cls, id, part, stateBits, node, true); }
    }
    void ApplyDecls(StyleBox b, JsonValue block) {
        if (block == null) { return; }
        for (int i = 0; i < block.Count(); i = i + 1) {
            string k = block.KeyAt(i);
            if (StyleSheet.InternalKey(k)) { continue; }
            StyleSheet.DeclBlock(b, block, k, false);
        }
    }
    bool Matches(int i, string type, List<string> classes, string id,
                 string part, int stateBits, string cls) {
        return this.MatchesCtx(i, type, classes, id, part, stateBits, cls, null);
    }
    bool MatchesCtx(int i, string type, List<string> classes, string id,
                    string part, int stateBits, string cls, StyleNode node) {
        if (this.ruleEntries != null && i < this.ruleEntries.Count) {
            return this.ruleEntries[i].selector.MatchNodeCtx(type, classes, cls, id, part,
                                                            stateBits, node);
        }
        return false;
    }
    bool HasRelational() { this.Index(); return this.relational; }
    static bool Holds(List<string> list, string name) {
        for (int i = 0; i < list.Count; i = i + 1) {
            if (list[i] == name) { return true; }
        }
        return false;
    }
    static void StableSortRules(List<StyleRuleEntry> entries, List<int> specs) {
        int n = entries.Count;
        if (n <= 1) { return; }
        bool sorted = true;
        for (int i = 1; i < n; i = i + 1) {
            if (specs[i - 1] > specs[i]) { sorted = false; break; }
        }
        if (sorted) { return; }
        List<StyleRuleEntry> tmpE = new List<StyleRuleEntry>();
        List<int> tmpS = new List<int>();
        for (int i = 0; i < n; i = i + 1) {
            tmpE.Add(entries[i]);
            tmpS.Add(specs[i]);
        }
        int width = 1;
        while (width < n) {
            int left = 0;
            while (left < n) {
                int mid = left + width;
                if (mid > n) { mid = n; }
                int right = left + width + width;
                if (right > n) { right = n; }
                int i = left;
                int j = mid;
                int k = left;
                while (i < mid && j < right) {
                    if (specs[i] <= specs[j]) {
                        tmpE[k] = entries[i];
                        tmpS[k] = specs[i];
                        i = i + 1;
                    } else {
                        tmpE[k] = entries[j];
                        tmpS[k] = specs[j];
                        j = j + 1;
                    }
                    k = k + 1;
                }
                while (i < mid) {
                    tmpE[k] = entries[i];
                    tmpS[k] = specs[i];
                    i = i + 1;
                    k = k + 1;
                }
                while (j < right) {
                    tmpE[k] = entries[j];
                    tmpS[k] = specs[j];
                    j = j + 1;
                    k = k + 1;
                }
                for (int m = left; m < right; m = m + 1) {
                    entries[m] = tmpE[m];
                    specs[m] = tmpS[m];
                }
                left = right;
            }
            width = width + width;
        }
    }
    void Index() {
        if (rules == null) { return; }
        if (indexedCount == rules.Count()) { return; }
        ruleEntries = new List<StyleRuleEntry>();
        List<int> selSpecs = new List<int>();
        this.relational = false;
        int total = rules.Count();
        for (int i = 0; i < total; i = i + 1) {
            string sel = rules.KeyAt(i);
            Selector p = Selector.Parse(sel);
            if (p == null) { continue; }
            if (p.Relational()) { this.relational = true; }
            JsonValue blk = this.rules.ValAt(i);
            JsonValue imp = blk == null ? null : blk.Get("__zan_important");
            ruleEntries.Add(new StyleRuleEntry(sel, p, blk, imp));
            selSpecs.Add(p.Specificity());
        }
        StyleSheet.StableSortRules(ruleEntries, selSpecs);
        this.byType = new Dict<string, List<int>>();
        this.byId = new Dict<string, List<int>>();
        this.byClass = new Dict<string, List<int>>();
        this.anyFallback = new List<int>();
        this.hasImportant = false;
        this.importantRules = new List<int>();
        for (int k = 0; k < ruleEntries.Count; k = k + 1) {
            StyleRuleEntry re = ruleEntries[k];
            if (re.important != null && re.important.IsObject() && re.important.Count() > 0) {
                this.hasImportant = true;
                this.importantRules.Add(k);
            }
            Selector s = re.selector;
            if (s.type != "") {
                List<int> bucket;
                if (!byType.TryGetValue(s.type, out bucket)) {
                    bucket = new List<int>();
                    byType.Add(s.type, bucket);
                }
                bucket.Add(k);
            } else if (s.id != "") {
                List<int> bucket;
                if (!byId.TryGetValue(s.id, out bucket)) {
                    bucket = new List<int>();
                    byId.Add(s.id, bucket);
                }
                bucket.Add(k);
            } else if (s.classList != null && s.classList.Count > 0) {
                string key = s.classList[0];
                List<int> bucket;
                if (!byClass.TryGetValue(key, out bucket)) {
                    bucket = new List<int>();
                    byClass.Add(key, bucket);
                }
                bucket.Add(k);
            } else {
                this.anyFallback.Add(k);
            }
        }
        indexedCount = total;
    }
    static void ApplyBlock(StyleNode c, JsonValue block) {
        StyleBox box = new StyleBox();
        bool visual = false;
        JsonValue imp = block.Get("__zan_important");
        int i = 0;
        while (i < block.Count()) {
            string k = block.KeyAt(i);
            JsonValue v = block.ValAt(i);
            i = i + 1;
            if (StyleSheet.InternalKey(k)) { continue; }
            if (k == "pad" || k == "padding") {
                c.SetStylePad(StyleSheet.Num(StyleSheet.ValStr(v)));
                continue;
            }
            if (k == "gap") { c.SetStyleGap(v.AsInt(0)); continue; }
            if (k == "x") { c.SetStyleX(v.AsInt(0)); continue; }
            if (k == "y") { c.SetStyleY(v.AsInt(0)); continue; }
            if (k == "width") { c.SetStylePrefW(StyleSheet.Num(StyleSheet.ValStr(v))); continue; }
            if (k == "height") { c.SetStylePrefH(StyleSheet.Num(StyleSheet.ValStr(v))); continue; }
            if (StyleSheet.DeclBlock(box, block, k, false)) {
                visual = true;
                continue;
            }
            c.SetProp(k, StyleSheet.Scalar(v));
        }
        if (imp != null && imp.IsObject()) {
            for (int j = 0; j < imp.Count(); j = j + 1) {
                string k = imp.KeyAt(j);
                if (StyleSheet.DeclBlock(box, block, k, true)) { visual = true; }
            }
        }
        if (visual) { StyleSheet.CopyToControl(box, c); }
    }
    static void ApplyInline(StyleNode c, string decls) {
        if (c == null || decls == null) { return; }
        string inlineCss = StyleSheet.Trim(decls);
        c.SetInlineStyleCss(inlineCss);
        if (inlineCss == "") { return; }
        StyleSheet sheet = Css.Parse(".zan-inline { " + inlineCss + " }");
        JsonValue block = sheet.Block(".zan-inline");
        if (block == null) { return; }
        JsonValue w = block.Get("width");
        if (w != null) { c.SetStylePrefW(StyleSheet.Num(StyleSheet.ValStr(w))); }
        JsonValue h = block.Get("height");
        if (h != null) { c.SetStylePrefH(StyleSheet.Num(StyleSheet.ValStr(h))); }
        JsonValue gap = block.Get("gap");
        if (gap != null) { c.SetStyleGap(gap.AsInt(0)); }
    }
    static void ReplayInline(StyleBox b, StyleNode c, int resolvedFont, bool fontPhysical) {
        string decls = c.InlineStyleCss();
        if (decls == null || decls == "") { return; }
        List<CssVarDecl> vars = b.envTheme == null ? new List<CssVarDecl>()
            : Style.VarsFromTheme(b.envTheme);
        int physicalCount = vars.Count;
        if (b.envSheet != null && b.envSheet.vars != null) {
            for (int i = 0; i < b.envSheet.vars.Count(); i = i + 1) {
                vars.Add(new CssVarDecl(b.envSheet.vars.KeyAt(i),
                    StyleSheet.ValStr(b.envSheet.vars.ValAt(i))));
            }
        }
        StyleSheet sheet = Css.ParseWithSources(".zan-inline { " + decls + " }", vars, physicalCount);
        JsonValue block = sheet.Block(".zan-inline");
        if (block == null) { return; }
        JsonValue imp = block.Get("__zan_important");
        bool setsFont = block.Get("font-size") != null || block.Get("font") != null;
        if (imp != null) { setsFont = setsFont || imp.Get("font-size") != null || imp.Get("font") != null; }
        if (setsFont) {
            b.fontPx = resolvedFont;
            b.SetPrescaled(StyleBox.SourceFont(), fontPhysical);
        }
        sheet.ApplyBox(b, ".zan-inline");
        Style.ScaleBox(b);
    }
    static void CopyToControl(StyleBox b, StyleNode c) {
        if (c != null) { c.ApplyVisualStyleBox(b); }
    }
    static void ApplyBackground(StyleNode c, string val) {
        StyleBox b = new StyleBox();
        StyleSheet.DeclBackground(b, StyleSheet.Trim(val));
        if (c != null) { c.SetInlineBg(b.bg, b.bgTo); }
    }
    static void ApplyBorder(StyleNode c, string val) {
        StyleBox b = new StyleBox();
        StyleSheet.DeclBorder(b, StyleSheet.Trim(val), 0);
        if (c != null) { c.SetInlineBorder(b.borderW, b.borderColor); }
    }
}
