using System.Collections.Generic;
namespace Gui;
public partial class StyleSheet {
    List<StyleRuleEntry> contextRules;
    int contextMediaCount;
    int contextDependency;
    bool contextCached;
    List<Selector> contextLiveRules;
    List<Selector> contextRelRules;
    Dict<string, int> contextScopeDep;
    void RefreshContextCache() {
        this.Index();
        int mediaSize = mediaEntries == null ? 0 : mediaEntries.Count;
        if (contextCached && contextRules == ruleEntries && contextMediaCount == mediaSize) { return; }
        int dependency = 0;
        if (contextLiveRules != null) { contextLiveRules.Clear(); }
        if (contextRelRules != null) { contextRelRules.Clear(); }
        if (ruleEntries != null) {
            for (int i = 0; i < ruleEntries.Count; i = i + 1) {
                Selector selector = ruleEntries[i] != null ? ruleEntries[i].selector : null;
                if (selector == null) { continue; }
                if (selector.NeedsLiveContext()) {
                    dependency = 2;
                    if (contextLiveRules == null) { contextLiveRules = new List<Selector>(); }
                    contextLiveRules.Add(selector);
                } else if (selector.Relational()) {
                    if (dependency < 1) { dependency = 1; }
                    if (contextRelRules == null) { contextRelRules = new List<Selector>(); }
                    contextRelRules.Add(selector);
                }
            }
        }
        for (int i = 0; i < mediaSize; i = i + 1) {
            Selector selector = mediaEntries[i] != null ? mediaEntries[i].selector : null;
            if (selector == null) { continue; }
            if (selector.NeedsLiveContext()) {
                dependency = 2;
                if (contextLiveRules == null) { contextLiveRules = new List<Selector>(); }
                contextLiveRules.Add(selector);
            } else if (selector.Relational()) {
                if (dependency < 1) { dependency = 1; }
                if (contextRelRules == null) { contextRelRules = new List<Selector>(); }
                contextRelRules.Add(selector);
            }
        }
        contextRules = ruleEntries;
        contextMediaCount = mediaSize;
        contextDependency = dependency;
        contextCached = true;
        if (contextScopeDep != null) { contextScopeDep.Clear(); }
    }
    static bool SelectorCanMatch(Selector s, string type, string cls, string id) {
        if (s == null) { return false; }
        string t = type == null ? "" : type;
        string c = cls == null ? "" : cls;
        string idv = id == null ? "" : id;
        if (s.type != "" && !s.universal && s.type != "*" && t != "" && s.type != t) {
            return false;
        }
        if (s.id != "" && idv != s.id) { return false; }
        if (s.classList != null && s.classList.Count > 0) {
            if (c == "") { return false; }
            for (int i = 0; i < s.classList.Count; i = i + 1) {
                if (!Style.Has(c, s.classList[i])) { return false; }
            }
        }
        return true;
    }
    int ContextDependency() {
        this.RefreshContextCache();
        return contextDependency;
    }
    int ContextDependencyFor(string type, string cls, string id) {
        this.RefreshContextCache();
        if (contextDependency == 0) { return 0; }
        string t = type == null ? "" : type;
        string c = cls == null ? "" : cls;
        string idv = id == null ? "" : id;
        bool cacheKeyed = idv == "";
        string key = "";
        if (cacheKeyed) {
            if (contextScopeDep == null) { contextScopeDep = new Dict<string, int>(); }
            key = c == "" ? t : (t + "|" + c);
            int cached = 0;
            if (contextScopeDep.TryGetValue(key, out cached)) { return cached; }
        }
        int dep = 0;
        if (contextLiveRules != null) {
            for (int i = 0; i < contextLiveRules.Count; i = i + 1) {
                if (StyleSheet.SelectorCanMatch(contextLiveRules[i], t, c, idv)) {
                    dep = 2;
                    break;
                }
            }
        }
        if (dep < 2 && contextRelRules != null) {
            for (int i = 0; i < contextRelRules.Count; i = i + 1) {
                if (StyleSheet.SelectorCanMatch(contextRelRules[i], t, c, idv)) {
                    dep = 1;
                    break;
                }
            }
        }
        if (cacheKeyed && contextScopeDep.Count < 512) {
            contextScopeDep.Add(key, dep);
        }
        return dep;
    }
}
