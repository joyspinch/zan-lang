using System.Collections.Generic;

namespace Gui;

public partial class StyleSheet {
    // Classification belongs to this sheet's parsed index, never to a tree
    // mutation generation. Public Control fields/children and virtual CssAttr
    // may change without notifying the sheet or the owning App.
    List<StyleRuleEntry> contextRules;
    int contextMediaCount;
    int contextDependency;

    // 0 = no node dependency; 1 = ancestor path is sufficient;
    // 2 = evaluate live (attributes, siblings, structure, descendants).
    int ContextDependency() {
        this.Index();
        int mediaSize = mediaEntries == null ? 0 : mediaEntries.Count;
        if (contextRules == ruleEntries && contextMediaCount == mediaSize) {
            return contextDependency;
        }
        int dependency = 0;
        if (ruleEntries != null) {
            for (int i = 0; i < ruleEntries.Count; i = i + 1) {
                Selector selector = ruleEntries[i].selector;
                if (selector.NeedsLiveContext()) { dependency = 2; break; }
                if (selector.Relational()) { dependency = 1; }
            }
        }
        for (int i = 0; i < mediaSize && dependency < 2; i = i + 1) {
            Selector selector = mediaEntries[i].selector;
            if (selector.NeedsLiveContext()) { dependency = 2; break; }
            if (selector.Relational()) { dependency = 1; }
        }
        contextRules = ruleEntries;
        contextMediaCount = mediaSize;
        contextDependency = dependency;
        return dependency;
    }
}
