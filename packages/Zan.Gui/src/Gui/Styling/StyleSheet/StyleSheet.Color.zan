using System;
using System.Collections.Generic;
using Gui;
namespace Gui;
public partial class StyleSheet {
    static Dict<string, int> colorCache = new Dict<string, int>();
    static int ParseColor(string val) {
        if (val == null || val == "") { return 0; }
        int cached;
        if (StyleSheet.colorCache.TryGetValue(val, out cached)) { return cached; }
        int col = StyleSheet.ParseColorRawDepth(val, 0);
        if (StyleSheet.colorCache.Count < 1024) { StyleSheet.colorCache.Add(val, col); }
        return col;
    }
    static int ParseColorRaw(string val) { return StyleSheet.ParseColorRawDepth(val, 0); }
    static int ParseColorRawDepth(string val, int depth) {
        if (val == null || depth > 8) { return 0; }
        string s = StyleSheet.Trim(val);
        if (s.Length == 0) { return 0; }
        int b0 = s[0] & 255;
        if (b0 == 35) {
            int slen = s.Length;
            if (slen == 4) {
                int r = StyleSheet.HexDigitByte(s[1] & 255);
                int g = StyleSheet.HexDigitByte(s[2] & 255);
                int b = StyleSheet.HexDigitByte(s[3] & 255);
                if (r < 0 || g < 0 || b < 0) { return 0; }
                int rr = (r << 4) | r;
                int gg = (g << 4) | g;
                int bb = (b << 4) | b;
                return (255 << 24) | (rr << 16) | (gg << 8) | bb;
            } else if (slen == 5) {
                int r = StyleSheet.HexDigitByte(s[1] & 255);
                int g = StyleSheet.HexDigitByte(s[2] & 255);
                int b = StyleSheet.HexDigitByte(s[3] & 255);
                int a = StyleSheet.HexDigitByte(s[4] & 255);
                if (r < 0 || g < 0 || b < 0 || a < 0) { return 0; }
                int aa = (a << 4) | a;
                int rr = (r << 4) | r;
                int gg = (g << 4) | g;
                int bb = (b << 4) | b;
                return (aa << 24) | (rr << 16) | (gg << 8) | bb;
            } else if (slen == 7) {
                int r0 = StyleSheet.HexDigitByte(s[1] & 255);
                int r1 = StyleSheet.HexDigitByte(s[2] & 255);
                int g0 = StyleSheet.HexDigitByte(s[3] & 255);
                int g1 = StyleSheet.HexDigitByte(s[4] & 255);
                int b0c = StyleSheet.HexDigitByte(s[5] & 255);
                int b1c = StyleSheet.HexDigitByte(s[6] & 255);
                if (r0 < 0 || r1 < 0 || g0 < 0 || g1 < 0 || b0c < 0 || b1c < 0) { return 0; }
                int rr = (r0 << 4) | r1;
                int gg = (g0 << 4) | g1;
                int bb = (b0c << 4) | b1c;
                return (255 << 24) | (rr << 16) | (gg << 8) | bb;
            } else if (slen == 9) {
                int acc = 0;
                for (int i = 1; i < 9; i = i + 1) {
                    int d = StyleSheet.HexDigitByte(s[i] & 255);
                    if (d < 0) { return 0; }
                    acc = (acc << 4) | d;
                }
                return acc;
            }
            return 0;
        }
        if (s.Length > 2 && b0 == 48 && ((s[1] & 255) == 120 || (s[1] & 255) == 88)) {
            int acc = 0;
            int slen = s.Length;
            for (int i = 2; i < slen; i = i + 1) {
                int d = StyleSheet.HexDigitByte(s[i] & 255);
                if (d < 0) { return 0; }
                acc = (acc << 4) | d;
            }
            return acc;
        }
        if (b0 >= 48 && b0 <= 57) { return StyleSheet.ParseInt(s); }
        string lo = StyleSheet.Lower(s);
        if (StyleSheet.StartsWith(lo, "rgb")) { return StyleSheet.ParseRgb(s); }
        if (StyleSheet.StartsWith(lo, "hsl")) { return StyleSheet.ParseHsl(s); }
        if (StyleSheet.StartsWith(lo, "hwb(")) { return StyleSheet.ParseHwb(s); }
        if (StyleSheet.StartsWith(lo, "oklab(")) { return StyleSheet.ParseOklabLike(s, false); }
        if (StyleSheet.StartsWith(lo, "oklch(")) { return StyleSheet.ParseOklabLike(s, true); }
        if (StyleSheet.StartsWith(lo, "lab(")) { return StyleSheet.ParseCielabLike(s, false); }
        if (StyleSheet.StartsWith(lo, "lch(")) { return StyleSheet.ParseCielabLike(s, true); }
        if (StyleSheet.StartsWith(lo, "color-mix(")) { return StyleSheet.ParseColorMixDepth(s, depth + 1); }
        if (lo == "transparent" || lo == "none" || lo == "currentcolor") { return 0; }
        int named = StyleSheet.NamedColor(lo);
        if (named != 0) { return named; }
        return StyleSheet.ParseInt(s);
    }
    static int ParseRgb(string val) {
        List<string> a = StyleSheet.FuncArgs(val);
        if (a.Count < 3) { return 0; }
        int r = StyleSheet.Chan(a[0]);
        int g = StyleSheet.Chan(a[1]);
        int b = StyleSheet.Chan(a[2]);
        int al = a.Count >= 4 ? StyleSheet.Alpha255(a[3]) : 255;
        return StyleSheet.Pack(al, r, g, b);
    }
    static List<string> FuncArgs(string val) {
        if (val == null) { return new List<string>(); }
        int open = StyleSheet.IndexOf(val, "(");
        int close = StyleSheet.LastIndexOf(val, ")");
        if (open < 0 || close <= open) { return new List<string>(); }
        string inner = val.Substring(open + 1, close - open - 1);
        string main = inner;
        string alpha = "";
        int slash = Css.IndexFrom(inner, "/", 0);
        if (slash >= 0) {
            main = Css.Trim(inner.Substring(0, slash));
            alpha = Css.Trim(inner.Substring(slash + 1,
                                             inner.Length - slash - 1));
        }
        List<string> outp = new List<string>();
        List<string> parts = Css.IndexFrom(main, ",", 0) >= 0
            ? Css.SplitTrim(main, ",")
            : Css.SplitTopTrim(main, " ");
        for (int i = 0; i < parts.Count; i = i + 1) {
            if (parts[i] != "") { outp.Add(parts[i]); }
        }
        if (alpha != "") { outp.Add(alpha); }
        return outp;
    }
    static int Alpha255(string tok) {
        if (Css.IndexFrom(tok, "%", 0) >= 0) {
            return StyleSheet.Clamp255((int)((long)StyleSheet.Perm(tok) * 255L / 1000L));
        }
        double d = StyleSheet.ParseDbl(tok);
        if (d <= 0.0) { return 0; }
        if (d >= 1.0) { return 255; }
        return StyleSheet.Clamp255((int)(d * 255.0));
    }
    static double DblChan(string tok, double pctDiv) {
        string t = Css.Trim(tok);
        if (Css.IndexFrom(t, "%", 0) >= 0) { return StyleSheet.Perm(t) / pctDiv; }
        return StyleSheet.ParseDbl(t);
    }
    static double ParseDbl(string tok) {
        if (tok == null) { return 0.0; }
        string t = Css.Trim(tok);
        int n = t.Length;
        if (n == 0) { return 0.0; }
        double sign = 1.0;
        int i = 0;
        int c0 = t[0] & 255;
        if (c0 == 45 || c0 == 43) {
            if (c0 == 45) { sign = 0.0 - 1.0; }
            i = 1;
            while (i < n && Css.IsSpaceByte(t[i] & 255)) { i = i + 1; }
        }
        double v = 0.0;
        while (i < n) {
            int b = t[i] & 255;
            if (b < 48 || b > 57) { break; }
            if (v < 1e12) { v = v * 10.0 + (double)(b - 48); }
            i = i + 1;
        }
        if (i < n && (t[i] & 255) == 46) {
            i = i + 1;
            double fr = 1.0;
            while (i < n) {
                int b = t[i] & 255;
                if (b < 48 || b > 57) { break; }
                fr = fr / 10.0;
                v = v + fr * (double)(b - 48);
                i = i + 1;
            }
        }
        return sign * v;
    }
    static int Hue360(string tok) {
        string lo2 = StyleSheet.Lower(Css.Trim(tok));
        double v = StyleSheet.ParseDbl(lo2);
        double deg = v;
        if (StyleSheet.EndsWith(lo2, "grad")) { deg = v * 0.9; }
        else if (StyleSheet.EndsWith(lo2, "rad")) { deg = v * 57.2957795; }
        else if (StyleSheet.EndsWith(lo2, "turn")) { deg = v * 360.0; }
        deg = deg % 360.0;
        if (deg < 0.0) { deg = deg + 360.0; }
        int d = (int)deg;
        d = d % 360;
        if (d < 0) { d = d + 360; }
        return d;
    }
    static void Hexcone(int h, int c, out int r, out int g, out int b) {
        int hp = h * 1000 / 60;
        int mod2 = hp % 2000;
        int xm = mod2 - 1000;
        if (xm < 0) { xm = 0 - xm; }
        int x = c * (1000 - xm) / 1000;
        r = 0; g = 0; b = 0;
        if (h < 60) { r = c; g = x; }
        else if (h < 120) { r = x; g = c; }
        else if (h < 180) { g = c; b = x; }
        else if (h < 240) { g = x; b = c; }
        else if (h < 300) { r = x; b = c; }
        else { r = c; b = x; }
    }
    static int ParseHsl(string val) {
        List<string> a = StyleSheet.FuncArgs(val);
        if (a.Count < 3) { return 0; }
        int h = StyleSheet.Hue360(a[0]);
        int sat = StyleSheet.Perm(a[1]);
        if (sat < 0) { sat = 0; }
        if (sat > 1000) { sat = 1000; }
        int lit = StyleSheet.Perm(a[2]);
        if (lit < 0) { lit = 0; }
        if (lit > 1000) { lit = 1000; }
        int al = a.Count >= 4 ? StyleSheet.Alpha255(a[3]) : 255;
        int d2l = 2 * lit - 1000;
        if (d2l < 0) { d2l = 0 - d2l; }
        int chroma = (1000 - d2l) * sat / 1000;
        int r; int g; int b;
        StyleSheet.Hexcone(h, chroma, out r, out g, out b);
        int m = lit - chroma / 2;
        return StyleSheet.Pack(al, (r + m) * 255 / 1000,
                               (g + m) * 255 / 1000,
                               (b + m) * 255 / 1000);
    }
    static int ParseHwb(string val) {
        List<string> a = StyleSheet.FuncArgs(val);
        if (a.Count < 3) { return 0; }
        int h = StyleSheet.Hue360(a[0]);
        int w = StyleSheet.Perm(a[1]);
        if (w < 0) { w = 0; }
        int bk = StyleSheet.Perm(a[2]);
        if (bk < 0) { bk = 0; }
        int al = a.Count >= 4 ? StyleSheet.Alpha255(a[3]) : 255;
        long sum = (long)w + (long)bk;
        if (sum > 1000L) {
            w = (int)((long)w * 1000L / sum);
            bk = 1000 - w;
            sum = 1000L;
        }
        long keep = 1000L - sum;
        int r; int g; int b;
        StyleSheet.Hexcone(h, 1000, out r, out g, out b);
        return StyleSheet.Pack(al, (int)((long)r * keep * 255L / 1000000L + (long)w * 255L / 1000L),
                               (int)((long)g * keep * 255L / 1000000L + (long)w * 255L / 1000L),
                               (int)((long)b * keep * 255L / 1000000L + (long)w * 255L / 1000L));
    }
    static bool ParseLabCoords(string val, bool polar, double pctDiv,
                               out double L, out double ax, out double bx, out int alpha) {
        L = 0.0; ax = 0.0; bx = 0.0; alpha = 255;
        List<string> a = StyleSheet.FuncArgs(val);
        if (a.Count < 3) { return false; }
        L = StyleSheet.DblChan(a[0], pctDiv);
        alpha = a.Count >= 4 ? StyleSheet.Alpha255(a[3]) : 255;
        if (polar) {
            double c = StyleSheet.DblChan(a[1], pctDiv);
            double hd = StyleSheet.Hue360(a[2]);
            ax = c * StyleSheet.CosD(hd);
            bx = c * StyleSheet.SinD(hd);
        } else {
            ax = StyleSheet.DblChan(a[1], pctDiv);
            bx = StyleSheet.DblChan(a[2], pctDiv);
        }
        return true;
    }
    static int ParseOklabLike(string val, bool polar) {
        double L; double ax; double bx; int alpha;
        if (!StyleSheet.ParseLabCoords(val, polar, 1000.0, out L, out ax, out bx, out alpha)) {
            return 0;
        }
        return StyleSheet.OklabToRgb(L, ax, bx, alpha);
    }
    static int OklabToRgb(double L, double ax, double bx, int alpha) {
        return ColorMath.OklabToRgb(StyleSheet.Clamp255(alpha), L, ax, bx);
    }
    static int ParseCielabLike(string val, bool polar) {
        double L; double ax; double bx; int alpha;
        if (!StyleSheet.ParseLabCoords(val, polar, 10.0, out L, out ax, out bx, out alpha)) {
            return 0;
        }
        return StyleSheet.LabToRgb(L, ax, bx, alpha);
    }
    static int LabToRgb(double L, double ax, double bx, int alpha) {
        double e = 216.0 / 24389.0;
        double k = 24389.0 / 27.0;
        double fy = (L + 16.0) / 116.0;
        double fx = fy + ax / 500.0;
        double fz = fy - bx / 200.0;
        double fx3 = fx * fx * fx;
        double fz3 = fz * fz * fz;
        double fy3 = fy * fy * fy;
        double xr = fx3 > e ? fx3 : (116.0 * fx - 16.0) / k;
        double yr = L > k * e ? fy3 : L / k;
        double zr = fz3 > e ? fz3 : (116.0 * fz - 16.0) / k;
        double X = xr * 0.96422;
        double Y = yr;
        double Z = zr * 0.82521;
        double xd = 0.9555766 * X - 0.0230393 * Y + 0.0631636 * Z;
        double yd = -0.0282895 * X + 1.0099416 * Y + 0.0210077 * Z;
        double zd = 0.0122982 * X - 0.0204830 * Y + 1.3299098 * Z;
        double rl = 3.2404542 * xd - 1.5371385 * yd - 0.4985314 * zd;
        double gl = -0.9692660 * xd + 1.8760108 * yd + 0.0415560 * zd;
        double bl = 0.0556434 * xd - 0.2040259 * yd + 1.0572252 * zd;
        return StyleSheet.Pack(alpha, StyleSheet.Gamma255(rl),
                               StyleSheet.Gamma255(gl),
                               StyleSheet.Gamma255(bl));
    }
    static int ByteOf(int c, int shift) { return (c >> shift) & 255; }
    static int Gamma255(double c) {
        if (c <= 0.0) { return 0; }
        if (c >= 1.0) { return 255; }
        double v;
        if (c <= 0.0031308) { v = 12.92 * c; }
        else { v = 1.055 * Math.Pow(c, 1.0 / 2.4) - 0.055; }
        if (v <= 0.0) { return 0; }
        if (v >= 1.0) { return 255; }
        return StyleSheet.Clamp255((int)Math.Round(v * 255.0));
    }
    static double CosD(double deg) {
        double x = deg % 360.0;
        if (x < 0.0) { x = x + 360.0; }
        double rad = x * 3.14159265358979 / 180.0;
        double sign = 1.0;
        if (rad > 3.14159265358979) { rad = 6.28318530717958 - rad; }
        if (rad > 1.57079632679490) {
            rad = 3.14159265358979 - rad;
            sign = 0.0 - sign;
        }
        double x2 = rad * rad;
        return sign * (1.0 - x2 / 2.0 + x2 * x2 / 24.0
                       - x2 * x2 * x2 / 720.0
                       + x2 * x2 * x2 * x2 / 40320.0
                       - x2 * x2 * x2 * x2 * x2 / 3628800.0);
    }
    static double SinD(double deg) { return CosD(deg - 90.0); }
    static int ParseColorMix(string val) {
        return StyleSheet.ParseColorMixDepth(val, 0);
    }
    static int ParseColorMixDepth(string val, int depth) {
        if (val == null || depth > 8) { return 0; }
        int open = StyleSheet.IndexOf(val, "(");
        int close = StyleSheet.LastIndexOf(val, ")");
        if (open < 0 || close <= open) { return 0; }
        List<string> parts = Css.SplitTopTrim(
            val.Substring(open + 1, close - open - 1), ",");
        int idx = 0;
        if (parts.Count > 0
            && StyleSheet.StartsWith(StyleSheet.Lower(parts[0]), "in ")) {
            idx = 1;
        }
        if (parts.Count - idx < 2) { return 0; }
        int p1 = 0 - 1; int p2 = 0 - 1;
        string s1 = StyleSheet.TakePct(parts[idx], out p1);
        string s2 = StyleSheet.TakePct(parts[idx + 1], out p2);
        if (p1 < 0) { p1 = 500; }
        if (p2 < 0) { p2 = 500; }
        if (p1 > 1000) { p1 = 1000; }
        if (p2 > 1000) { p2 = 1000; }
        int c1 = StyleSheet.ParseColorRawDepth(s1, depth + 1);
        int c2 = StyleSheet.ParseColorRawDepth(s2, depth + 1);
        long sum = (long)p1 + (long)p2;
        if (sum <= 0L) { p1 = 500; p2 = 500; sum = 1000L; }
        p1 = (int)((long)p1 * 1000L / sum);
        p2 = 1000 - p1;
        int r = (StyleSheet.ByteOf(c1, 16) * p1
                 + StyleSheet.ByteOf(c2, 16) * p2) / 1000;
        int g = (StyleSheet.ByteOf(c1, 8) * p1
                 + StyleSheet.ByteOf(c2, 8) * p2) / 1000;
        int b = (StyleSheet.ByteOf(c1, 0) * p1
                 + StyleSheet.ByteOf(c2, 0) * p2) / 1000;
        int a1 = (c1 >> 24) & 255;
        int a2 = (c2 >> 24) & 255;
        int al = (a1 * p1 + a2 * p2) / 1000;
        return StyleSheet.Pack(al, r, g, b);
    }
    static string TakePct(string s, out int pct) {
        pct = 0 - 1;
        string t = Css.Trim(s);
        int i = t.Length;
        while (i > 0 && t.Substring(i - 1, 1) != " ") { i = i - 1; }
        if (i <= 0) { return t; }
        string tail = Css.Trim(t.Substring(i, t.Length - i));
        if (StyleSheet.EndsWith(tail, "%") && tail.Length >= 2) {
            string digits = tail.Substring(0, tail.Length - 1);
            bool ok = digits.Length > 0;
            for (int k = 0; k < digits.Length; k = k + 1) {
                string d = digits.Substring(k, 1);
                if (!StyleSheet.Digit(d) && d != "."
                    && d != "-" && d != "+") { ok = false; }
            }
            if (ok) {
                pct = StyleSheet.Perm(tail);
                return Css.Trim(t.Substring(0, i));
            }
        }
        return t;
    }
    static int Chan(string tok) {
        string s = StyleSheet.Trim(tok);
        if (StyleSheet.IndexOf(s, "%") >= 0) {
            return StyleSheet.Clamp255((int)((long)StyleSheet.Perm(s) * 255L / 1000L));
        }
        return StyleSheet.Clamp255(StyleSheet.Num(s));
    }
    static int Clamp255(int v) {
        if (v < 0) { return 0; }
        if (v > 255) { return 255; }
        return v;
    }
    static int Pack(int a, int r, int g, int b) {
        int av = StyleSheet.Clamp255(a);
        int rv = StyleSheet.Clamp255(r);
        int gv = StyleSheet.Clamp255(g);
        int bv = StyleSheet.Clamp255(b);
        return (int)(((uint)av << 24) | ((uint)rv << 16) | ((uint)gv << 8) | (uint)bv);
    }
    static Dict<string, int> namedColorMap;
    static void EnsureNamedColors() {
        if (StyleSheet.namedColorMap != null) { return; }
        Dict<string, int> m = new Dict<string, int>();
        string table =
            "aliceblue:f0f8ff;antiquewhite:faebd7;aqua:00ffff;cyan:00ffff;aquamarine:7fffd4;azure:f0ffff;"
            + "beige:f5f5dc;bisque:ffe4c4;black:000000;blanchedalmond:ffebcd;blue:0000ff;blueviolet:8a2be2;"
            + "brown:a52a2a;burlywood:deb887;cadetblue:5f9ea0;chartreuse:7fff00;chocolate:d2691e;coral:ff7f50;"
            + "cornflowerblue:6495ed;cornsilk:fff8dc;crimson:dc143c;darkblue:00008b;darkcyan:008b8b;"
            + "darkgoldenrod:b8860b;darkgray:a9a9a9;darkgrey:a9a9a9;darkgreen:006400;darkkhaki:bdb76b;"
            + "darkmagenta:8b008b;darkolivegreen:556b2f;darkorange:ff8c00;darkorchid:9932cc;darkred:8b0000;"
            + "darksalmon:e9967a;darkseagreen:8fbc8f;darkslateblue:483d8b;darkslategray:2f4f4f;darkslategrey:2f4f4f;"
            + "darkturquoise:00ced1;darkviolet:9400d3;deeppink:ff1493;deepskyblue:00bfff;dimgray:696969;dimgrey:696969;"
            + "dodgerblue:1e90ff;firebrick:b22222;floralwhite:fffaf0;forestgreen:228b22;fuchsia:ff00ff;magenta:ff00ff;"
            + "gainsboro:dcdcdc;ghostwhite:f8f8ff;gold:ffd700;goldenrod:daa520;gray:808080;grey:808080;green:008000;"
            + "greenyellow:adff2f;honeydew:f0fff0;hotpink:ff69b4;indianred:cd5c5c;indigo:4b0082;ivory:fffff0;"
            + "khaki:f0e68c;lavender:e6e6fa;lavenderblush:fff0f5;lawngreen:7cfc00;lemonchiffon:fffacd;"
            + "lightblue:add8e6;lightcoral:f08080;lightcyan:e0ffff;lightgoldenrodyellow:fafad2;lightgray:d3d3d3;"
            + "lightgrey:d3d3d3;lightgreen:90ee90;lightpink:ffb6c1;lightsalmon:ffa07a;lightseagreen:20b2aa;"
            + "lightskyblue:87cefa;lightslategray:778899;lightslategrey:778899;lightsteelblue:b0c4de;"
            + "lightyellow:ffffe0;lime:00ff00;limegreen:32cd32;linen:faf0e6;maroon:800000;mediumaquamarine:66cdaa;"
            + "mediumblue:0000cd;mediumorchid:ba55d3;mediumpurple:9370db;mediumseagreen:3cb371;mediumslateblue:7b68ee;"
            + "mediumspringgreen:00fa9a;mediumturquoise:48d1cc;mediumvioletred:c71585;midnightblue:191970;"
            + "mintcream:f5fffa;mistyrose:ffe4e1;moccasin:ffe4b5;navajowhite:ffdead;navy:000080;oldlace:fdf5e6;"
            + "olive:808000;olivedrab:6b8e23;orange:ffa500;orangered:ff4500;orchid:da70d6;palegoldenrod:eee8aa;"
            + "palegreen:98fb98;paleturquoise:afeeee;palevioletred:db7093;papayawhip:ffefd5;peachpuff:ffdab9;"
            + "peru:cd853f;pink:ffc0cb;plum:dda0dd;powderblue:b0e0e6;purple:800080;rebeccapurple:663399;"
            + "red:ff0000;rosybrown:bc8f8f;royalblue:4169e1;saddlebrown:8b4513;salmon:fa8072;sandybrown:f4a460;"
            + "seagreen:2e8b57;seashell:fff5ee;sienna:a0522d;silver:c0c0c0;skyblue:87ceeb;slateblue:6a5acd;"
            + "slategray:708090;slategrey:708090;snow:fffafa;springgreen:00ff7f;steelblue:4682b4;tan:d2b48c;"
            + "teal:008080;thistle:d8bfd8;tomato:ff6347;turquoise:40e0d0;violet:ee82ee;wheat:f5deb3;white:ffffff;"
            + "whitesmoke:f5f5f5;yellow:ffff00;yellowgreen:9acd32";
        int i = 0;
        int n = table.Length;
        while (i < n) {
            int colon = table.IndexOf(":", i);
            if (colon < 0) { break; }
            int semi = table.IndexOf(";", colon + 1);
            if (semi < 0) { semi = n; }
            string k = table.Substring(i, colon - i);
            int rgb = StyleSheet.HexToInt(table.Substring(colon + 1, semi - colon - 1));
            m.Add(k, (255 << 24) | rgb);
            i = semi + 1;
        }
        StyleSheet.namedColorMap = m;
    }
    static int NamedColor(string name) {
        StyleSheet.EnsureNamedColors();
        int col = 0;
        if (StyleSheet.namedColorMap.TryGetValue(name, out col)) { return col; }
        return 0;
    }
    static int HexDigitByte(int b) {
        if (b >= 48 && b <= 57) { return b - 48; }
        if (b >= 97 && b <= 102) { return b - 87; }
        if (b >= 65 && b <= 70) { return b - 55; }
        return -1;
    }
    static int HexToInt(string h) {
        if (h == null) { return 0; }
        int acc = 0;
        int len = h.Length;
        for (int i = 0; i < len; i = i + 1) {
            int d = StyleSheet.HexDigitByte(h[i] & 255);
            if (d < 0) { return 0; }
            acc = (acc << 4) | d;
        }
        return acc;
    }
    static int HexDigit(string ch) {
        if (ch == null || ch.Length == 0) { return -1; }
        return StyleSheet.HexDigitByte(ch[0] & 255);
    }
    static bool Digit(string ch) {
        if (ch == null || ch.Length == 0) { return false; }
        int b = ch[0] & 255;
        return b >= 48 && b <= 57;
    }
}
