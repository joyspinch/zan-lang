using System;

namespace Gui;

// 统一圆角档位系统。
public class Radius {
    // 0px: 直角/硬边（平铺表格、贴边分栏）
    const int None = 0;
    // 2px: 微圆角
    const int XS   = 2;
    // 4px: 小圆角（紧凑按钮、Tag、Badge、代码块）
    const int S    = 4;
    // 8px: 标准圆角（标准按钮、文本框、下拉框、常规卡片）
    const int M    = 8;
    // 12px: 柔和中圆角（浮层面板、主工作区卡片、Dialog）
    const int L    = 12;
    // 16px: 大圆角（弹窗外框、特色大卡片）
    const int XL   = 16;
    // 9999px: 完全胶囊圆角（Pill 按钮、圆形头像）
    const int Full = 9999;
}
