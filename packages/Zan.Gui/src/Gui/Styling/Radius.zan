using System;

namespace Gui;

// 统一圆角档位系统。
//
// **全库唯一的圆角真源**：Theme 的圆角默认值从这里取，CSS 侧的
// `--radius-*` 令牌由 Style.RootFromTheme 按同一组数导出。
// 皮肤与 IDE 壳层只引用令牌或本文件的常量，不写裸像素。
//
// 镜像到 CSS：--radius-none/-xs/-s/-m/-l/-xl/-full
public class Radius {
    // 0px: 直角/硬边（平铺表格、贴边分栏）
    const int None = 0;
    // 1px: 极细微角
    const int XS   = 1;
    // 2px: 小圆角（紧凑按钮、Tag、Badge、代码块、输入框）
    const int S    = 2;
    // 4px: 标准圆角（标准按钮、文本框、下拉框、常规卡片）
    const int M    = 4;
    // 6px: 柔和中圆角（浮层面板、主工作区卡片、Dialog）
    const int L    = 6;
    // 8px: 大圆角（弹窗外框、特色大卡片）
    const int XL   = 8;
    // 9999px: 完全胶囊圆角（Pill 按钮、圆形头像）
    const int Full = 9999;
}
