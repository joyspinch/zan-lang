using System;
using System.IO;
using System.Json;
using System.Diagnostics;
namespace Gui;
public class Skin {
    string name;
    string dir;
    StyleSheet sheet;
    string cssText;
    Theme theme;
    bool dark;
    string art;
    int artOpacity;
    bool loaded;
    static Dict<string, Skin> cache;
    public Skin() : this("") {}
    public Skin(string skinName) {
        this.name = skinName;
        this.dir = "";
        this.sheet = new StyleSheet();
        this.cssText = "";
        this.theme = null;
        this.dark = true;
        this.art = "";
        this.artOpacity = 100;
        this.loaded = false;
        if (skinName != null && skinName != "") { this.LoadFromDiskOrEmbed(); }
    }
    public void LoadFromDiskOrEmbed() {
        this.dir = Skin.FindDir(this.name);
        string css = "";
        if (this.dir != "") { css = Css.ResolveImports(this.dir + "/skin.css"); }
        if (css == "") { css = Skin.EmbedRead("skins/" + this.name + "/skin.css"); }
        if (css != "") {
            this.loaded = true;
            this.cssText = css;
            this.sheet = StyleSheet.FromCss(css);
            this.art = Skin.FindArt(this.dir);
            this.theme = Skin.ThemeOf(this.sheet);
            this.dark = Skin.DarkOf(this.sheet);
            string op = this.sheet.Var("--art-opacity");
            if (op != "") { this.artOpacity = StyleSheet.Num(op); }
        }
    }
    public static Skin Load(string name) {
        if (Skin.cache == null) { Skin.cache = new Dict<string, Skin>(); }
        if (Skin.cache.ContainsKey(name)) { return Skin.cache[name]; }
        Skin s = new Skin(name);
        Skin.cache[name] = s;
        return s;
    }
    public static void ClearCache() { Skin.cache = null; }
    static Skin Reload(string name) {
        if (Skin.cache != null && Skin.cache.ContainsKey(name)) { Skin.cache.Remove(name); }
        return Skin.Load(name);
    }
    bool IsLoaded() { return loaded; }
    StyleSheet SheetWithVars(List<CssVarDecl> vars, int physicalCount) {
        if (cssText == "") { return sheet; }
        return Css.ParseWithSources(cssText, vars, physicalCount);
    }
    internal StyleSheet SheetWithVars(List<CssVarDecl> vars, int physicalCount, int accent) {
        if (accent == 0) { return this.SheetWithVars(vars, physicalCount); }
        string overrides = "\n:root {\n" + Style.Tok("primary", accent)
        + Style.Tok("border-focus", accent) + Style.Tok("border-hover", accent) + "}\n";
        return Css.ParseWithSources(cssText + overrides, vars, physicalCount);
    }
    string ArtPath() { return art; }
    Theme NewTheme() {
        if (theme == null) { return null; }
        return Skin.ThemeOf(sheet);
    }
    void Apply(StyleHost app) {
        app.HostSetSheet(sheet);
        app.HostSetSkinName(name);
        Theme fresh = this.NewTheme();
        if (fresh != null) { app.ApplyTheme(fresh, dark); }
        bool hadArt = app.HostSkinArtWallpaper();
        bool hadUser = app.HostHasUserWallpaper();
        app.HostSetSkinArt(art, artOpacity);
        if (art != "" && !hadUser) {
            app.HostSetWallpaper(art, artOpacity);
        } else if (hadArt && art == "" && !hadUser) {
            app.HostClearWallpaper();
        }
        app.HostBumpBgThemeGen();
    }
    public static string DefaultName() { return "porcelain"; }
    public static List<string> BuiltInNames() {
        return new List<string>{ Skin.DefaultName(), "graphite", "navy" };
    }
    static List<string> Roots() {
        List<string> r = new List<string>();
        string exe = Skin.ExeDir();
        if (exe != "") {
            r.Add(exe + "/skins");
            r.Add(exe + "/packages/Zan.Gui/skins");
        }
        r.Add("skins");
        r.Add("packages/Zan.Gui/skins");
        return r;
    }
    static string ExeDir() {
        string p = Environment.ProcessPath;
        int cut = 0 - 1;
        for (int i = 0; i < p.Length; i = i + 1) {
            string ch = p.Substring(i, 1);
            if (ch == "\\" || ch == "/") { cut = i; }
        }
        if (cut < 0) { return ""; }
        return p.Substring(0, cut);
    }
    static string FindDir(string name) {
        List<string> roots = Skin.Roots();
        int i = 0;
        while (i < roots.Count) {
            string cand = roots[i] + "/" + name;
            i = i + 1;
            if (File.Exists(cand + "/skin.css")) { return cand; }
        }
        return "";
    }
    static List<string> Available() {
        List<string> names = new List<string>();
        List<string> roots = Skin.Roots();
        int i = 0;
        while (i < roots.Count) {
            string root = roots[i];
            i = i + 1;
            if (!Directory.Exists(root)) { continue; }
            List<string> dirs = Directory.GetDirectories(root);
            int k = 0;
            while (k < dirs.Count) {
                string nm = Skin.Leaf(dirs[k]);
                string d = root + "/" + nm;
                k = k + 1;
                if (!File.Exists(d + "/skin.css")) { continue; }
                if (Skin.Contains(names, nm)) { continue; }
                names.Add(nm);
            }
        }
        string emb = Skin.EmbedList("skins/");
        int start = 0;
        for (int p = 0; p <= emb.Length; p = p + 1) {
            bool brk = false;
            if (p == emb.Length) { brk = true; }
            else if (emb[p] == '\n') { brk = true; }
            if (brk) {
                if (p > start) {
                    string line = emb.Substring(start, p - start);
                    string nm = Skin.EmbedSkinName(line);
                    if (nm != "" && !Skin.Contains(names, nm)) { names.Add(nm); }
                }
                start = p + 1;
            }
        }
        return names;
    }
    static string EmbedSkinName(string line) {
        string pre = "skins/";
        if (line.Length <= pre.Length) { return ""; }
        if (line.Substring(0, pre.Length) != pre) { return ""; }
        string rest = line.Substring(pre.Length, line.Length - pre.Length);
        int slash = -1;
        int i = 0;
        while (i < rest.Length) {
            if (rest[i] == '/') { slash = i; i = rest.Length; }
            else { i = i + 1; }
        }
        if (slash <= 0) { return ""; }
        return rest.Substring(0, slash);
    }
    static string KindOf(string name) {
        Skin s = Skin.Load(name);
        if (s.sheet == null) { return "ui"; }
        string v = s.sheet.Var("--kind");
        if (v == "") { return "ui"; }
        return Skin.Unquote(v);
    }
    static List<string> Names() {
        List<string> names = Skin.Available();
        for (int f = names.Count - 1; f >= 0; f = f - 1) {
            if (Skin.KindOf(names[f]) != "ui") { names.RemoveAt(f); }
        }
        List<string> outp = new List<string>();
        while (names.Count > 0) {
            int best = 0;
            int i = 1;
            while (i < names.Count) {
                if (Skin.OrderOf(names[i]) < Skin.OrderOf(names[best])) { best = i; }
                i = i + 1;
            }
            outp.Add(names[best]);
            names.RemoveAt(best);
        }
        return outp;
    }
    static int OrderOf(string name) {
        Skin s = Skin.Load(name);
        string v = s.sheet.Var("--order");
        if (v == "") { return 1000; }
        return StyleSheet.Num(v);
    }
    static string LabelOf(string name) {
        Skin s = Skin.Load(name);
        string v = s.sheet.Var("--name");
        if (v == "") { return name; }
        return Skin.Unquote(v);
    }
    static List<string> Labels(List<string> names) {
        List<string> outp = new List<string>();
        for (int i = 0; i < names.Count; i = i + 1) {
            outp.Add(Skin.LabelOf(names[i]));
        }
        return outp;
    }
    static string FindArt(string dir) {
        List<string> cands = new List<string>{
            dir + "/banner.png",
            dir + "/banner.jpg",
            dir + "/backdrop.png",
            dir + "/backdrop.jpg" };
        for (int i = 0; i < cands.Count; i = i + 1) {
            if (File.Exists(cands[i])) { return cands[i]; }
        }
        return "";
    }
    static Theme ThemeOf(StyleSheet sheet) {
        if (sheet == null || sheet.vars == null || sheet.vars.Count() == 0) { return null; }
        Theme t = Skin.BaseOf(sheet);
        int i = 0;
        while (i < sheet.vars.Count()) {
            string key = sheet.vars.KeyAt(i);
            JsonValue v = sheet.vars.ValAt(i);
            i = i + 1;
            string tok = Skin.TokenName(key);
            if (tok == "base" || tok == "dark" || tok == "art"
                || tok == "artOpacity" || tok == "density") { continue; }
            t.SetToken(tok, v);
        }
        return t;
    }
    static Theme BaseOf(StyleSheet sheet) {
        if (sheet.Var("--base").ToLower() == "light") { return Theme.Light(); }
        return Theme.Dark();
    }
    static int DensityOf(StyleSheet sheet) {
        string v = sheet.Var("--density");
        if (v == "") { return 0 - 1; }
        return Theme.DensityOf(Skin.Unquote(v));
    }
    static bool DarkOf(StyleSheet sheet) {
        string d = sheet.Var("--dark");
        if (d != "") { return StyleSheet.Num(d) != 0; }
        return sheet.Var("--base").ToLower() != "light";
    }
    static string TokenName(string key) {
        string k = key;
        if (k.Length >= 2 && k.Substring(0, 2) == "--") { k = k.Substring(2, k.Length - 2); }
        string outp = "";
        bool up = false;
        int i = 0;
        while (i < k.Length) {
            string ch = k.Substring(i, 1);
            i = i + 1;
            if (ch == "-" || ch == "_") { up = true; continue; }
            if (up) { outp = outp + ch.ToUpper(); up = false; }
            else { outp = outp + ch; }
        }
        return outp;
    }
    static string Unquote(string v) {
        if (v.Length >= 2) {
            string q = v.Substring(0, 1);
            if (q == "\"" || q == "'") {
                if (v.Substring(v.Length - 1, 1) == q) { return v.Substring(1, v.Length - 2); }
            }
        }
        return v;
    }
    static string ReadIfExists(string path) {
        if (!File.Exists(path)) { return ""; }
        return File.ReadAllText(path);
    }
    static string BaseCss() {
        List<string> roots = Skin.Roots();
        int i = 0;
        while (i < roots.Count) {
            string cand = roots[i] + "/base.css";
            i = i + 1;
            if (File.Exists(cand)) { return File.ReadAllText(cand); }
        }
        return Skin.EmbedRead("skins/base.css");
    }
    static string Leaf(string path) {
        int cut = -1;
        for (int i = 0; i < path.Length; i = i + 1) {
            string ch = path.Substring(i, 1);
            if (ch == "/" || ch == "\\") { cut = i; }
        }
        if (cut < 0) { return path; }
        return path.Substring(cut + 1, path.Length - cut - 1);
    }
    static bool Contains(List<string> list, string v) {
        for (int i = 0; i < list.Count; i = i + 1) {
            if (list[i] == v) { return true; }
        }
        return false;
    }
    static extern string getenv(string name);
    static string Env(string name) {
        string v = getenv(name);
        if (v == null) { return ""; }
        return v;
    }
    static extern string zan_embed_read(string name);
    static extern int zan_embed_has(string name);
    static string EmbedRead(string name) {
        string v = Skin.zan_embed_read(name);
        if (v == null) { return ""; }
        return v;
    }
    static bool EmbedHas(string name) { return Skin.zan_embed_has(name) != 0; }
    static string EmbedList(string prefix) { return File.zan_embed_list(prefix); }
}
