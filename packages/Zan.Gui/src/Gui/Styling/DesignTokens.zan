using System;

namespace Gui;

// 8pt 网格间距系统档位（标准界面排版节奏，杜绝魔数）。
class Space {
    // 0px: 无间距
    const int None = 0;
    // 2px: 微小缝隙（分割线偏移、密集状态指示微调）
    const int XXS  = 2;
    // 4px: 紧凑间距（图文并排微小间隔、Tag 内边距）
    const int XS   = 4;
    // 8px: 基础单元（标准小间距、表单项行距、控件内间距）
    const int S    = 8;
    // 12px: 次级中等间距（卡片紧凑内衬）
    const int SM   = 12;
    // 16px: 标准中等间距（模块常规内衬、卡片内边距 Padding）
    const int M    = 16;
    // 24px: 呼吸感大间距（主内容区边距、分块大间距）
    const int L    = 24;
    // 32px: 视差特大间距（模态框外留白、页面分段大空隙）
    const int XL   = 32;
    // 48px: 巨型间距（Hero 区域留白）
    const int XXL  = 48;
}

// 统一圆角档位系统。
class Radius {
    // 0px: 直角/硬边（平铺表格、贴边分栏）
    const int None = 0;
    // 2px: 微圆角
    const int XS   = 2;
    // 4px: 小圆角（紧凑按钮、Tag、Badge、代码块）
    const int S    = 4;
    // 8px: 标准圆角（标准按钮、文本框、下拉框、常规卡片）
    const int M    = 8;
    // 12px: 柔和中圆角（浮层面板、主工作区卡片、Dialog）
    const int L    = 12;
    // 16px: 大圆角（弹窗外框、特色大卡片）
    const int XL   = 16;
    // 9999px: 完全胶囊圆角（Pill 按钮、圆形头像）
    const int Full = 9999;
}

// 标准文字层级阶梯（Type Scale）。桌面端排版仅允许在此 6 档中选择。
class FontScale {
    // 10pt: 辅助说明、状态栏次级信息、时间戳
    const int Caption  = 10;
    // 11pt: 密集列表项、辅助标签、次级侧栏文字
    const int Small    = 11;
    // 12pt: 标准正文、常规按钮文字、表单标签与输入
    const int Body     = 12;
    // 14pt: 卡片副标题、加重列表标题、二级区块头
    const int Subhead  = 14;
    // 16pt: 面板主标题、弹窗标题、主要功能区头部
    const int Title    = 16;
    // 20pt: 页面主标题、大卡片核心 KPI 指标数字
    const int Hero     = 20;
    // 26pt: 巨型展示数字
    const int Display  = 26;
}

// 统一控件尺寸与交互高度档位。
class WidgetSize {
    // 24px: 紧凑微型控件（紧凑工具条图标按钮、密集列表操作按键）
    const int Mini   = 24;
    // 28px: 次紧凑控件（工具栏标准项、表格内嵌按钮）
    const int Small  = 28;
    // 32px: 桌面端标准控件高度（常规 Button、Input、SelectBox）
    const int Medium = 32;
    // 40px: 强调型大控件（全局搜索框、呼吁操作主按钮）
    const int Large  = 40;
}

// 常用高质感现代语义色板（ARGB: 0xAARRGGBB）。
// 经典 Slate/Zinc 质感，远离高饱和度刺眼配色。
class Palette {
    // 现代暗黑工作台 (Modern Dark Slate)
    const int BgDark         = unchecked((int)0xFF0F172A);  // Slate-900 (深邃底色)
    const int SurfaceDark    = unchecked((int)0xFF1E293B);  // Slate-800 (工作区卡片表面)
    const int SurfaceHover   = unchecked((int)0xFF334155);  // Slate-700 (鼠标悬浮高亮)
    const int BorderDark     = unchecked((int)0xFF334155);  // Slate-700 (低对比细描边)
    const int TextHigh       = unchecked((int)0xFFF8FAFC);  // Slate-50 (高对比正文)
    const int TextMed        = unchecked((int)0xFF94A3B8);  // Slate-400 (次级中灰文字)
    const int TextLow        = unchecked((int)0xFF64748B);  // Slate-500 (低优先级弱文字)

    // 经典品牌与功能色
    const int PrimaryBrand   = unchecked((int)0xFF3B82F6);  // 科技蓝 Blue-500
    const int PrimaryHover   = unchecked((int)0xFF2563EB);  // Blue-600
    const int Success        = unchecked((int)0xFF10B981);  // 翠绿 Emerald-500
    const int Warning        = unchecked((int)0xFFF59E0B);  // 琥珀 Amber-500
    const int Danger         = unchecked((int)0xFFEF4444);  // 珊瑚红 Rose-500
}
