using System;
using System.Collections.Generic;
using Gui;
namespace Gui;
public partial class Css {
    static StyleSheet Parse(string src) { return Css.ParseWith(src, null); }
    static StyleSheet ParseWith(string src, List<CssVarDecl> extraVars) {
        int physicalCount = extraVars == null ? 0 : extraVars.Count;
        return Css.ParseWithSources(src, extraVars, physicalCount);
    }
    static string ResolveImports(string path) { return Css.ResolveImportsDepth(path, new List<string>(), 0); }
    static string ResolveImportsDepth(string path, List<string> seen, int depth) {
        if (depth > 8 || path == null) { return ""; }
        if (seen == null) { seen = new List<string>(); }
        string real = Css.Trim(path);
        if (real == "" || !File.Exists(real)) { return ""; }
        string key = Css.NormalizeKey(real);
        for (int i = 0; i < seen.Count; i = i + 1) {
            if (seen[i] == key) { return ""; }
        }
        seen.Add(key);
        string text = "";
        try {
            text = File.ReadAllText(real);
        } catch (Exception _ex) {
            return "";
        }
        if (text == null) { return ""; }
        text = Css.StripComments(text);
        int pos = 0;
        int at = Css.IndexOfImportFrom(text, pos);
        if (at < 0) { return text; }
        StringBuilder outp = new StringBuilder();
        string baseDir = "";
        bool baseDirInit = false;
        while (at >= 0) {
            int semi = Css.MatchImportEnd(text, at);
            if (semi < 0) { break; }
            string stmt = Css.Trim(text.Substring(at + 7, semi - at - 7));
            if (at > pos) { outp.Append(text.Substring(pos, at - pos)); }
            pos = semi + 1;
            if (stmt == "") { at = Css.IndexOfImportFrom(text, pos); continue; }
            string target = "";
            string media = "";
            int firstB = stmt[0] & 255;
            if (firstB == 34 || firstB == 39) {
                string q = firstB == 34 ? "\"" : "'";
                int end2 = Css.IndexFrom(stmt, q, 1);
                if (end2 < 0) { at = Css.IndexOfImportFrom(text, pos); continue; }
                target = Css.Trim(stmt.Substring(1, end2 - 1));
                media = Css.Trim(stmt.Substring(
                    end2 + 1, stmt.Length - end2 - 1));
            } else if (Css.StartsWithStr(Css.Lower(stmt), "url(")) {
                int open = Css.IndexFrom(stmt, "(", 0);
                int close = Css.IndexFrom(stmt, ")", open);
                if (close < 0) { at = Css.IndexOfImportFrom(text, pos); continue; }
                target = Css.Trim(stmt.Substring(open + 1, close - open - 1));
                if (target.Length >= 2) {
                    int tb0 = target[0] & 255;
                    if (tb0 == 34 || tb0 == 39) {
                        target = target.Substring(1, target.Length - 2);
                    }
                }
                media = Css.Trim(stmt.Substring(
                    close + 1, stmt.Length - close - 1));
            } else {
                outp.Append("@import ");
                outp.Append(stmt);
                outp.Append(";");
                at = Css.IndexOfImportFrom(text, pos);
                continue;
            }
            if (target == "") { at = Css.IndexOfImportFrom(text, pos); continue; }
            if (!baseDirInit) {
                baseDirInit = true;
                int slash = -1;
                for (int k = real.Length - 1; k >= 0; k = k - 1) {
                    int c = real[k] & 255;
                    if (c == 47 || c == 92) { slash = k; break; }
                }
                if (slash >= 0) { baseDir = real.Substring(0, slash); }
            }
            string sub = target;
            if (baseDir != "" && !File.Exists(sub)) { sub = baseDir + "/" + target; }
            if (media != "") {
                MediaCond mc = Css.ParseMedia(media);
                if (mc == null || !mc.True(new StyleBox())) {
                    at = Css.IndexOfImportFrom(text, pos);
                    continue;
                }
            }
            outp.Append(Css.ResolveImportsDepth(sub, seen, depth + 1));
            at = Css.IndexOfImportFrom(text, pos);
        }
        if (pos < text.Length) { outp.Append(text.Substring(pos, text.Length - pos)); }
        return outp.ToString();
    }
    static int IndexOfImport(string s) { return Css.IndexOfImportFrom(s, 0); }
    static int IndexOfImportFrom(string s, int start) {
        if (s == null) { return 0 - 1; }
        int i = start < 0 ? 0 : start;
        int n = s.Length;
        int quote = 0;
        while (i < n) {
            int ch = s[i] & 255;
            if (quote != 0) {
                if (ch == 92 && i + 1 < n) { i = i + 2; continue; }
                if (ch == quote) { quote = 0; }
                i = i + 1;
                continue;
            }
            if (ch == 34 || ch == 39) { quote = ch; i = i + 1; continue; }
            if (ch == 64 && i + 7 <= n
                && Css.StartsWithStr(Css.Lower(s.Substring(i, 7)), "@import")) {
                return i;
            }
            i = i + 1;
        }
        return 0 - 1;
    }
    static int MatchImportEnd(string s, int at) {
        if (s == null) { return 0 - 1; }
        int quote = 0;
        int i = at < 0 ? 0 : at;
        int n = s.Length;
        while (i < n) {
            int ch = s[i] & 255;
            if (quote != 0) {
                if (ch == 92 && i + 1 < n) { i = i + 2; continue; }
                if (ch == quote) { quote = 0; }
                i = i + 1;
                continue;
            }
            if (ch == 34 || ch == 39) { quote = ch; i = i + 1; continue; }
            if (ch == 59) { return i; }
            if (ch == 123) { return 0 - 1; }
            i = i + 1;
        }
        return 0 - 1;
    }
    static string NormalizeKey(string path) {
        if (path == null) { return ""; }
        List<string> parts = new List<string>();
        int i = 0;
        int n = path.Length;
        while (i < n) {
            int segStart = i;
            while (i < n) {
                int c = path[i] & 255;
                if (c == 47 || c == 92) { break; }
                i = i + 1;
            }
            string seg = i > segStart ? path.Substring(segStart, i - segStart) : "";
            while (i < n) {
                int c = path[i] & 255;
                if (c != 47 && c != 92) { break; }
                i = i + 1;
            }
            if (seg == "" || seg == ".") { continue; }
            if (seg == ".." && parts.Count > 0
                && parts[parts.Count - 1] != "..") {
                parts.RemoveAt(parts.Count - 1);
                continue;
            }
            parts.Add(seg);
        }
        if (parts.Count == 0) { return ""; }
        if (parts.Count == 1) { return parts[0]; }
        StringBuilder sb = new StringBuilder();
        for (int k = 0; k < parts.Count; k = k + 1) {
            if (k > 0) { sb.Append("/"); }
            sb.Append(parts[k]);
        }
        return sb.ToString();
    }
    static StyleSheet ParseWithSources(string src, List<CssVarDecl> extraVars,
                                       int physicalCount) {
        StyleSheet sheet = new StyleSheet();
        string s = Css.StripComments(src);
        List<CssVarDecl> ownVars = Css.CollectVarDecls(s);
        List<CssVarDecl> allVars = new List<CssVarDecl>();
        if (extraVars != null) {
            for (int ei = 0; ei < extraVars.Count; ei = ei + 1) {
                allVars.Add(extraVars[ei]);
            }
        }
        int externalCount = physicalCount < allVars.Count ? physicalCount : allVars.Count;
        for (int vi = 0; vi < ownVars.Count; vi = vi + 1) {
            sheet.vars.Set(ownVars[vi].name, JsonValue.NewStr(ownVars[vi].val));
            allVars.Add(ownVars[vi]);
        }
        Dict<string, int> varIdx = Css.BuildVarIndex(allVars);
        Css.ParseRulesIntoM(sheet, s, allVars, varIdx, externalCount, null);
        return sheet;
    }
    static void ParseRulesInto(StyleSheet sheet, string s, List<CssVarDecl> allVars,
                               int externalCount) {
        Css.ParseRulesIntoM(sheet, s, allVars, Css.BuildVarIndex(allVars), externalCount, null);
    }
    static void ParseRulesIntoM(StyleSheet sheet, string s, List<CssVarDecl> allVars,
                                Dict<string, int> varIdx, int externalCount, MediaCond outer) {
        Css.ParseRulesIntoMDepth(sheet, s, allVars, varIdx, externalCount, outer, 0);
    }
    static void ParseRulesIntoMDepth(StyleSheet sheet, string s, List<CssVarDecl> allVars,
                                     Dict<string, int> varIdx, int externalCount, MediaCond outer,
                                     int depth) {
        if (sheet == null || s == null || depth > 32) { return; }
        int i = 0;
        while (i < s.Length) {
            int open = Css.IndexFrom(s, "{", i);
            if (open < 0) { break; }
            int close = Css.MatchBrace(s, open);
            if (close < 0) { break; }
            string selectors = Css.Trim(s.Substring(i, open - i));
            string body = s.Substring(open + 1, close - open - 1);
            i = close + 1;
            while (selectors.Length > 0 && (selectors[0] & 255) == 64) {
                int semi = Css.IndexFrom(selectors, ";", 0);
                if (semi < 0) { break; }
                selectors = Css.Trim(selectors.Substring(
                    semi + 1, selectors.Length - semi - 1));
            }
            if (selectors.Length == 0) { continue; }
            if ((selectors[0] & 255) == 64) {
                string at = Css.AtName(selectors);
                if (at == "supports") {
                    string cond = Css.AtPrelude(selectors);
                    if (Css.SupportsCondition(cond)) {
                        Css.ParseRulesIntoMDepth(sheet, body, allVars, varIdx,
                                                 externalCount, outer, depth + 1);
                    } else {
                        sheet.NoteGuard(cond);
                    }
                } else if (at == "media") {
                    string mcond = Css.AtPrelude(selectors);
                    MediaCond mc = Css.ParseMedia(mcond);
                    if (mc == null) {
                        sheet.NoteGuard(mcond);
                    } else if (outer != null) {
                        mc = MediaCond.And(outer, mc);
                        Css.ParseRulesIntoMDepth(sheet, body, allVars, varIdx,
                                                 externalCount, mc, depth + 1);
                    } else {
                        Css.ParseRulesIntoMDepth(sheet, body, allVars, varIdx,
                                                 externalCount, mc, depth + 1);
                    }
                } else if (at == "layer") {
                    Css.ParseRulesIntoMDepth(sheet, body, allVars, varIdx,
                                             externalCount, outer, depth + 1);
                } else if (at == "keyframes" || at == "-webkit-keyframes" || at == "-moz-keyframes") {
                    Css.ParseKeyframesInto(sheet, Css.AtPrelude(selectors), body, allVars, varIdx, externalCount);
                } else {
                    sheet.NoteAtRule(at);
                }
                continue;
            }
            List<string> sels = Css.SplitTopTrim(selectors, ",");
            JsonValue block = Css.ParseBlockIndexed(body, allVars, varIdx, externalCount);
            if (block.Count() == 0) { continue; }
            int k = 0;
            while (k < sels.Count) {
                string sel = sels[k];
                k = k + 1;
                if (sel.Length == 0) { continue; }
                if (sel == ":root") { continue; }
                if (outer != null) {
                    sheet.AddMediaRule(sel, block, outer);
                } else {
                    Css.MergeInto(sheet, sel, block);
                }
            }
        }
    }
    static string AtName(string prelude) {
        if (prelude == null || prelude.Length <= 1) { return ""; }
        int sp = Css.IndexFrom(prelude, " ", 0);
        int par = Css.IndexFrom(prelude, "(", 0);
        int end = prelude.Length;
        if (sp >= 0 && sp < end) { end = sp; }
        if (par >= 0 && par < end) { end = par; }
        if (end <= 1) { return ""; }
        return Css.Lower(Css.Trim(prelude.Substring(1, end - 1)));
    }
    static void ParseKeyframesInto(StyleSheet sheet, string prelude, string body,
                                   List<CssVarDecl> allVars, Dict<string, int> varIdx,
                                   int externalCount) {
        if (sheet == null || body == null) { return; }
        string name = Css.Trim(prelude);
        if (name.Length >= 2) {
            int q0 = name[0] & 255;
            int q1 = name[name.Length - 1] & 255;
            if ((q0 == 34 && q1 == 34) || (q0 == 39 && q1 == 39)) {
                name = Css.Trim(name.Substring(1, name.Length - 2));
            }
        }
        if (name == "") { return; }
        CssKeyframeRule rule = new CssKeyframeRule(name);
        int k = 0;
        while (k < body.Length) {
            int open = Css.IndexFrom(body, "{", k);
            if (open < 0) { break; }
            int close = Css.MatchBrace(body, open);
            if (close < 0) { break; }
            string stopSel = Css.Trim(body.Substring(k, open - k));
            string stopBody = body.Substring(open + 1, close - open - 1);
            k = close + 1;
            if (stopSel == "") { continue; }
            List<string> parts = Css.SplitTopTrim(stopSel, ",");
            JsonValue stopBlock = null;
            bool parsedStop = false;
            for (int p = 0; p < parts.Count; p = p + 1) {
                int off = Css.ParseKeyframeOffset(parts[p]);
                if (off < 0) { continue; }
                if (!parsedStop) {
                    stopBlock = Css.ParseBlockIndexed(stopBody, allVars, varIdx, externalCount);
                    parsedStop = true;
                }
                if (stopBlock != null && stopBlock.Count() > 0) {
                    rule.AddStop(off, stopBlock);
                }
            }
        }
        if (rule.stops.Count > 0) {
            sheet.AddKeyframes(rule);
        }
    }
    static int ParseKeyframeOffset(string tok) {
        string s = Css.Lower(Css.Trim(tok));
        if (s == "from") { return 0; }
        if (s == "to") { return 1000; }
        if (s.Length >= 2 && s.Substring(s.Length - 1, 1) == "%") {
            string numStr = Css.Trim(s.Substring(0, s.Length - 1));
            float pct = 0.0f;
            if (!float.TryParse(numStr, out pct)) { return 0 - 1; }
            int pm = (int)(pct * 10.0f + 0.5f);
            if (pm < 0) { pm = 0; }
            if (pm > 1000) { pm = 1000; }
            return pm;
        }
        return 0 - 1;
    }
    static string AtPrelude(string prelude) {
        if (prelude == null) { return ""; }
        int sp = Css.IndexFrom(prelude, " ", 0);
        int par = Css.IndexFrom(prelude, "(", 0);
        int at = prelude.Length;
        if (sp >= 0) { at = sp; }
        if (par >= 0 && par < at) { at = par; }
        if (at >= prelude.Length) { return ""; }
        return Css.Trim(prelude.Substring(at, prelude.Length - at));
    }
    static MediaCond ParseMedia(string prelude) {
        string p = Css.Trim(prelude);
        if (p == "") { return null; }
        MediaCond outC = new MediaCond();
        outC.alts = new List<MediaAlt>();
        List<string> alts = Css.SplitTopTrim(p, ",");
        for (int i = 0; i < alts.Count; i = i + 1) {
            MediaAlt a = Css.ParseMediaAlt(alts[i]);
            if (a == null) { return null; }
            outC.alts.Add(a);
        }
        return outC;
    }
    static MediaAlt ParseMediaAlt(string alt) {
        string s = Css.Trim(alt);
        string lo = Css.Lower(s);
        MediaAlt a = new MediaAlt();
        a.feats = new List<MediaFeat>();
        a.neg = false;
        if (Css.StartsWithStr(lo, "not ")) {
            a.neg = true;
            s = Css.Trim(s.Substring(4, s.Length - 4));
            lo = Css.Lower(s);
        }
        if (Css.StartsWithStr(lo, "only ")) {
            s = Css.Trim(s.Substring(5, s.Length - 5));
            lo = Css.Lower(s);
        }
        if (s == "") { return null; }
        List<string> parts = Css.SplitKeyword(s, " and ");
        for (int i = 0; i < parts.Count; i = i + 1) {
            if (!Css.ParseMediaFeatInto(parts[i], a.feats)) { return null; }
        }
        return a;
    }
    static bool ParseMediaFeatInto(string part, List<MediaFeat> acc) {
        string p2 = Css.Trim(part);
        if (p2 == "") { return false; }
        if (p2.Substring(0, 1) != "(") {
            MediaFeat tf = new MediaFeat();
            tf.name = Css.Lower(p2);
            tf.val = "";
            if (!Css.IsMediaName(tf.name)) { return false; }
            acc.Add(tf);
            return true;
        }
        if (p2.Substring(p2.Length - 1, 1) != ")") { return false; }
        string inner = Css.Trim(p2.Substring(1, p2.Length - 2));
        List<MediaOp> ops = new List<MediaOp>();
        int i = 0;
        while (i < inner.Length) {
            string c = inner.Substring(i, 1);
            if (c == "<" || c == ">") {
                string tx = c;
                if (i + 1 < inner.Length
                    && inner.Substring(i + 1, 1) == "=") { tx = tx + "="; }
                ops.Add(new MediaOp(i, tx));
                i = i + tx.Length;
                continue;
            }
            i = i + 1;
        }
        if (ops.Count > 2) { return false; }
        if (ops.Count == 2) {
            MediaOp op0 = ops[0];
            MediaOp op1 = ops[1];
            string mid = Css.Lower(Css.Trim(inner.Substring(
                op0.at + op0.tx.Length,
                op1.at - op0.at - op0.tx.Length)));
            string v1 = Css.Trim(inner.Substring(0, op0.at));
            string v2 = Css.Trim(inner.Substring(
                op1.at + op1.tx.Length,
                inner.Length - op1.at - op1.tx.Length));
            bool up = op0.tx == "<" || op0.tx == "<=";
            bool up2 = op1.tx == "<" || op1.tx == "<=";
            if (!Css.IsMediaName(mid) || v1 == "" || v2 == ""
                || up != up2) { return false; }
            MediaFeat f1 = new MediaFeat();
            f1.name = up ? Css.MinFeatName(mid) : Css.MaxFeatName(mid);
            f1.val = v1;
            MediaFeat f2 = new MediaFeat();
            f2.name = up ? Css.MaxFeatName(mid) : Css.MinFeatName(mid);
            f2.val = v2;
            acc.Add(f1);
            acc.Add(f2);
            return true;
        }
        MediaFeat pf = new MediaFeat();
        if (ops.Count == 1) {
            MediaOp op2 = ops[0];
            string left = Css.Trim(inner.Substring(0, op2.at));
            string right = Css.Trim(inner.Substring(
                op2.at + op2.tx.Length, inner.Length - op2.at - op2.tx.Length));
            string lo2 = Css.Lower(left);
            string ro = Css.Lower(right);
            bool nameLeft = Css.IsMediaName(lo2);
            string name = nameLeft ? lo2 : ro;
            string val = nameLeft ? right : left;
            if (!Css.IsMediaName(name)) { return false; }
            bool up = op2.tx == ">" || op2.tx == ">=";
            pf.name = (nameLeft == up) ? Css.MinFeatName(name)
                                        : Css.MaxFeatName(name);
            pf.val = val;
            acc.Add(pf);
            return true;
        }
        int colon = Css.IndexFrom(inner, ":", 0);
        if (colon < 0) {
            pf.name = Css.Lower(Css.Trim(inner));
            pf.val = "";
            if (!Css.IsMediaName(pf.name)) { return false; }
            acc.Add(pf);
            return true;
        }
        pf.name = Css.Lower(Css.Trim(inner.Substring(0, colon)));
        pf.val = Css.Trim(inner.Substring(colon + 1, inner.Length - colon - 1));
        if (pf.val == "" || !Css.IsMediaName(pf.name)) { return false; }
        acc.Add(pf);
        return true;
    }
    static string MinFeatName(string name) {
        if (name == "width") { return "min-width"; }
        if (name == "height") { return "min-height"; }
        if (name == "aspect-ratio") { return "min-aspect-ratio"; }
        return name;
    }
    static string MaxFeatName(string name) {
        if (name == "width") { return "max-width"; }
        if (name == "height") { return "max-height"; }
        if (name == "aspect-ratio") { return "max-aspect-ratio"; }
        return name;
    }
    static bool IsMediaName(string name) {
        if (name == "screen" || name == "all" || name == "print"
            || name == "speech" || name == "tv" || name == "tty"
            || name == "projection" || name == "handheld") { return true; }
        if (name == "width" || name == "height" || name == "aspect-ratio"
            || name == "min-width" || name == "max-width"
            || name == "min-height" || name == "max-height"
            || name == "min-aspect-ratio" || name == "max-aspect-ratio") { return true; }
        if (name == "orientation" || name == "prefers-color-scheme"
            || name == "prefers-reduced-motion" || name == "pointer"
            || name == "any-pointer" || name == "hover" || name == "any-hover"
            || name == "grid" || name == "resolution" || name == "display-mode") {
            return true;
        }
        return false;
    }
    static List<string> SplitKeyword(string s, string kw) {
        List<string> outR = new List<string>();
        if (s == null) { return outR; }
        if (kw == null || kw.Length == 0) { outR.Add(Css.Trim(s)); return outR; }
        int depth = 0;
        int start = 0;
        int i = 0;
        while (i < s.Length) {
            string ch = s.Substring(i, 1);
            if (ch == "(") { depth = depth + 1; i = i + 1; continue; }
            if (ch == ")") { if (depth > 0) { depth = depth - 1; } i = i + 1; continue; }
            if (depth == 0 && i + kw.Length <= s.Length
                && Css.Lower(s.Substring(i, kw.Length)) == kw) {
                outR.Add(Css.Trim(s.Substring(start, i - start)));
                i = i + kw.Length;
                start = i;
                continue;
            }
            i = i + 1;
        }
        outR.Add(Css.Trim(s.Substring(start, s.Length - start)));
        return outR;
    }
    static bool SupportsCondition(string cond) {
        return Css.SupportsConditionDepth(cond, 0);
    }
    static bool SupportsConditionDepth(string cond, int depth) {
        if (depth > 32) { return false; }
        string c = Css.Trim(cond);
        if (c == "") { return false; }
        int o = Css.FindTopKeyword(c, "or");
        if (o >= 0) {
            return Css.SupportsConditionDepth(c.Substring(0, o), depth + 1)
                || Css.SupportsConditionDepth(c.Substring(o + 2, c.Length - o - 2), depth + 1);
        }
        int a = Css.FindTopKeyword(c, "and");
        if (a >= 0) {
            return Css.SupportsConditionDepth(c.Substring(0, a), depth + 1)
                && Css.SupportsConditionDepth(c.Substring(a + 3, c.Length - a - 3), depth + 1);
        }
        string lo = Css.Lower(c);
        if (Css.StartsWithStr(lo, "not ")) {
            return !Css.SupportsConditionDepth(c.Substring(4, c.Length - 4), depth + 1);
        }
        if (c.Length >= 2 && c.Substring(0, 1) == "(" && c.Substring(c.Length - 1, 1) == ")") {
            string inner = Css.Trim(c.Substring(1, c.Length - 2));
            int colon = Css.TopToken(inner, ":");
            if (colon > 0) {
                string prop = Css.Trim(inner.Substring(0, colon));
                string val = Css.Trim(inner.Substring(
                    colon + 1, inner.Length - colon - 1));
                return StyleSheet.SupportsDecl(prop, val);
            }
            return Css.SupportsConditionDepth(inner, depth + 1);
        }
        return false;
    }
    static int FindTopKeyword(string s, string kw) {
        if (s == null || kw == null || kw.Length == 0) { return -1; }
        int depth = 0;
        int i = 0;
        int n = s.Length;
        int kwLen = kw.Length;
        string kwLower = kw.ToLower();
        int firstByte = kwLower[0] & 255;
        while (i < n) {
            int c = s[i] & 255;
            if (c == 40) { depth = depth + 1; i = i + 1; continue; }
            if (c == 41) { if (depth > 0) { depth = depth - 1; } i = i + 1; continue; }
            int cLower = (c >= 65 && c <= 90) ? c + 32 : c;
            if (depth == 0 && cLower == firstByte
                && i + kwLen <= n
                && s.Substring(i, kwLen).ToLower() == kwLower) {
                bool before = (i == 0) || Css.IsSpaceByte(s[i - 1] & 255);
                int after = i + kwLen;
                bool okAfter = (after >= n) || Css.IsSpaceByte(s[after] & 255);
                if (before && okAfter) { return i; }
            }
            i = i + 1;
        }
        return -1;
    }
    static int TopToken(string s, string tok) {
        if (s == null || tok == null || tok.Length == 0) { return -1; }
        int depth = 0;
        int len = s.Length;
        if (tok.Length == 1) {
            int target = tok[0] & 255;
            for (int i = 0; i < len; i = i + 1) {
                int c = s[i] & 255;
                if (c == 40) { depth = depth + 1; }
                else if (c == 41) { if (depth > 0) { depth = depth - 1; } }
                else if (c == target && depth == 0) { return i; }
            }
            return -1;
        }
        int tokLen = tok.Length;
        for (int i = 0; i + tokLen <= len; i = i + 1) {
            int c = s[i] & 255;
            if (c == 40) { depth = depth + 1; }
            else if (c == 41) { if (depth > 0) { depth = depth - 1; } }
            else if (depth == 0 && s.Substring(i, tokLen) == tok) { return i; }
        }
        return -1;
    }
    static bool StartsWithStr(string s, string prefix) {
        if (s == null || prefix == null) { return false; }
        return s.StartsWith(prefix);
    }
    static int MatchBrace(string s, int open) {
        if (s == null || open < 0 || open >= s.Length) { return -1; }
        int depth = 0;
        int i = open;
        int quote = 0;
        int len = s.Length;
        while (i < len) {
            int ch = s[i] & 255;
            if (quote != 0) {
                if (ch == 92) { i = i + 2; continue; }
                if (ch == quote) { quote = 0; }
                i = i + 1;
                continue;
            }
            if (ch == 34 || ch == 39) { quote = ch; }
            else if (ch == 123) { depth = depth + 1; }
            else if (ch == 125) {
                depth = depth - 1;
                if (depth == 0) { return i; }
            }
            i = i + 1;
        }
        return -1;
    }
}
