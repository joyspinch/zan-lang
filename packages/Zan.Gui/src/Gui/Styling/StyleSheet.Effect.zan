using System;
using System.Collections.Generic;
using Gui;

namespace Gui;

public partial class StyleSheet {
    static bool DeclMotion(StyleBox b, string k, string v) {
        if (k == "transition" || k == "transition-duration") {
            StyleSheet.DeclTransition(b, v);
            return true;
        }
        if (k == "transition-timing-function") {
            b.easing = StyleSheet.Easing(v);
            return true;
        }
        if (k == "transform") { StyleSheet.DeclTransform(b, v); return true; }
        // 现代 CSS 里 translate/rotate/scale 也可以脱离 transform 单独
        // 声明，写起来短得多（`rotate: 90` 而不是 `transform: rotate(90)`）。
        if (k == "rotate") { b.rotate = StyleSheet.Num(v); return true; }
        if (k == "scale") { b.scale = StyleSheet.Perm(v); return true; }
        if (k == "translate") {
            List<string> t = StyleSheet.Tokens(v);
            if (t.Count >= 1) { b.tx = StyleSheet.LenField(b, t[0], StyleBox.SourceTx()); }
            b.ty = StyleSheet.LenField(b, t.Count >= 2 ? t[1] : "0", StyleBox.SourceTy());
            return true;
        }
        if (k == "animation" || k == "animation-name") {
            StyleSheet.DeclAnimation(b, v);
            return true;
        }
        if (k == "animation-duration") { b.animMs = StyleSheet.Ms(v); return true; }
        return false;
    }

    // 停靠点上的位置（`#fff 40%`）在解析时被丢掉：运行时的
    // `grad_sample` 只采样 0/500/1000 三个位置，任意停靠点
    // 没有对应的绘制原语（见 StopColor）。
    static void DeclBackground(StyleBox b, string val) {
        string s = val;
        if (StyleSheet.StartsWith(s, "linear-gradient(")) {
            int close = StyleSheet.LastIndexOf(s, ")");
            if (close < 0) { close = s.Length; }
            string inner = s.Substring(16, close - 16);
            List<string> parts = Css.SplitTopTrim(inner, ",");
            List<string> stops = new List<string>();
            bool leftward = false;
            int i = 0;
            while (i < parts.Count) {
                string p = parts[i];
                i = i + 1;
                if (p == "") { continue; }
                if (StyleSheet.IsLeftward(p)) { leftward = true; }
                int dir = StyleSheet.GradientDir(p);
                if (dir >= 0) { b.bgDir = dir; continue; }
                stops.Add(p);
            }
            if (stops.Count >= 2) {
                b.bg = StyleSheet.ParseColor(StyleSheet.StopColor(stops[0]));
                if (stops.Count >= 3) {
                    b.bgVia = StyleSheet.ParseColor(StyleSheet.StopColor(stops[1]));
                    b.bgTo = StyleSheet.ParseColor(StyleSheet.StopColor(stops[2]));
                } else {
                    b.bgVia = 0;
                    b.bgTo = StyleSheet.ParseColor(StyleSheet.StopColor(stops[1]));
                }
                // `to left` / `270deg`：方向码只有"向右"，把两端
                // 停靠点对调，渲染出来就是向左。
                if (leftward) {
                    int cs = b.bg; b.bg = b.bgTo; b.bgTo = cs;
                }
                return;
            }
        }
        if (s == "none" || s == "transparent") {
            b.bg = 0;
            b.bgTo = 0;
            b.bgVia = 0;
            return;
        }
        b.bg = StyleSheet.ParseColor(s);
        b.bgTo = 0;
        b.bgVia = 0;
    }

    // 渐变方向关键字/角度作为 StyleBox.bgDir，当该
    // token 是颜色停靠点（color stop）时返回 -1。
    // 五个方向码（StyleBox.bgDir）：0 向下、1 向右、2 右下、
    // 3 向上、4 左下。CSS 的 `to left` 是横向的另一个朝向，没有
    // 独立的码——它等价于「向右的渐变把两端调过来」，所以这里
    // 返回 1 由 DeclBackground 交换首末停靠点（见那里的 sw）。
    // 以前 `to left` 落到 -1，整条 gradient 被当成纯色：背景不是渐变。
    static int GradientDir(string tok) {
        string s = StyleSheet.Lower(tok);
        if (s == "to bottom" || s == "180deg") { return 0; }
        if (s == "to right" || s == "90deg" || s == "to left"
            || s == "270deg") { return 1; }
        if (s == "to bottom right" || s == "135deg" || s == "to right bottom") { return 2; }
        if (s == "to top" || s == "0deg" || s == "360deg") { return 3; }
        if (s == "to bottom left" || s == "225deg" || s == "to left bottom") { return 4; }
        // 任意角度：吸附到最近的支持方向。CSS 角度
        // 从 12 点位置开始顺时针旋转（0=上、90=右、180=下），
        // 因此 “165deg”（略偏离正下方）吸附到底部。
        // 没有这个处理时，角度 token 会被解析为颜色停靠点，
        // 渐变会从透明的起始色开始。
        if (StyleSheet.EndsWith(s, "deg")) {
            int deg = StyleSheet.Num(tok);
            int d = deg % 360;
            if (d < 0) { d = d + 360; }
            int best = 0;
            int bestDist = 1000;
            for (int ci = 0; ci < 5; ci = ci + 1) {
                int a = 0;
                int dir = 0;
                if (ci == 0) { a = 180; dir = 0; }  // 底
                else if (ci == 1) { a = 0; dir = 3; }  // 顶
                else if (ci == 2) { a = 90; dir = 1; }  // 右
                else if (ci == 3) { a = 135; dir = 2; }  // 右下
                else { a = 225; dir = 4; }  // 左下
                int dist = a - d;
                if (dist < 0) { dist = 0 - dist; }
                if (dist > 180) { dist = 360 - dist; }
                if (dist < bestDist) {
                    bestDist = dist;
                    best = dir;
                }
            }
            return best;
        }
        return 0 - 1;
    }

    // 停靠点是不是镜像的横向渐变（`to left` / `270deg`）。
    static bool IsLeftward(string tok) {
        string s = StyleSheet.Lower(tok);
        return s == "to left" || s == "270deg";
    }

    // `text-shadow: <dx> <dy> [blur] <color>[, ...]`——只取第一层
    // （CSS 里它画在最上面），模糊半径无对应绘制原语、忽略几何
    // 只保留偏移；层数 ≥3 且偏移非零、`0` 模糊时按描边处理，
    // 这正是 `1px 1px 0 #000, -1px -1px 0 #000, 1px -1px 0 #000, …`
    // 那圈四向描边的意图。
    static void DeclTextShadow(StyleBox b, string val) {
        if (StyleSheet.Lower(StyleSheet.Trim(val)) == "none") {
            b.tsColor = 0; b.tsDx = 0; b.tsDy = 0; b.tsOutline = 0;
            return;
        }
        List<string> layers = Css.SplitTopTrim(val, ",");
        List<string> toks = StyleSheet.Tokens(layers[0]);
        List<int> nums = new List<int>();
        int col = 0;
        int i = 0;
        while (i < toks.Count) {
            string tk = toks[i];
            i = i + 1;
            if (StyleSheet.IsNumeric(tk)) { nums.Add(StyleSheet.Len(b, tk)); continue; }
            col = StyleSheet.ParseColor(tk);
        }
        if (col != 0) { b.tsColor = col; }
        if (nums.Count >= 1) { b.tsDx = nums[0]; }
        if (nums.Count >= 2) { b.tsDy = nums[1]; }
        // ≥3 层、零模糊、非零偏移 = 描边惯用法。
        if (layers.Count >= 3 && b.tsColor != 0
            && (b.tsDx != 0 || b.tsDy != 0)) {
            b.tsOutline = 1;
        }
    }

    // 去掉停靠点的位置（`#fff 40%` -> `#fff`）。
    static string StopColor(string stop) {
        string s = StyleSheet.Trim(stop);
        if (StyleSheet.StartsWith(s, "rgb") || StyleSheet.StartsWith(s, "hsl")) {
            int close = StyleSheet.IndexOf(s, ")");
            if (close > 0) { return s.Substring(0, close + 1); }
            return s;
        }
        int sp = StyleSheet.IndexOf(s, " ");
        if (sp > 0) { return s.Substring(0, sp); }
        return s;
    }

    // `border[-side]: <width> [style] <color>`（顺序任意，宽度可选）。
    // style 词（`dashed`/`dotted`）以前被 `continue` 掉、不落到任何
    // 字段上：`border: 1 dashed var(--border-secondary)` 解析成实线，
    // 作者看到的是「虚线写了没反应」。这里把它记进 borderStyle，
    // 绘制侧（StyleBox.PaintBorders）已经会据此走 Fx.DashedBorder。
    static void DeclBorder(StyleBox b, string val, int side) {
        List<string> toks = StyleSheet.Tokens(val);
        long source = StyleBox.SourceBorder();
        if (side == 1) { source = StyleBox.SourceBorderTop(); }
        else if (side == 2) { source = StyleBox.SourceBorderRight(); }
        else if (side == 3) { source = StyleBox.SourceBorderBottom(); }
        else if (side == 4) { source = StyleBox.SourceBorderLeft(); }
        int w = StyleSheet.LenField(b, "1px", source);
        int col = 0;
        bool haveW = false;
        bool haveStyle = false;
        int style = 0;
        int i = 0;
        while (i < toks.Count) {
            string tk = toks[i];
            i = i + 1;
            string lo = StyleSheet.Lower(tk);
            if (lo == "solid" || lo == "dashed" || lo == "dotted"
                || lo == "double" || lo == "groove" || lo == "ridge"
                || lo == "inset" || lo == "outset" || lo == "none") {
                haveStyle = true;
                if (lo == "dashed" || lo == "dotted") { style = 1; }
                if (lo == "none") { w = 0; haveW = true; }
                continue;
            }
            if (StyleSheet.IsNumeric(tk) || StyleSheet.HasMath(tk)) {
                w = StyleSheet.LenField(b, tk, source);
                haveW = true;
                continue;
            }
            col = StyleSheet.ParseColor(tk);
        }
        if (!haveW) { w = StyleSheet.LenField(b, "1px", source); }
        // 只有整盒简写才带 style 语义：`border-top: 1 dashed x` 里
        // 引擎只画统一虚线框（各边线型没有独立字段），写成整体
        // 比「悄悄变实线」更接近作者意图。
        if (haveStyle) { b.borderStyle = style; }
        if (side == 0) {
            b.borderW = w;
            if (col != 0) { b.borderColor = col; }
            b.borderTopW = 0 - 1; b.borderRightW = 0 - 1;
            b.borderBottomW = 0 - 1; b.borderLeftW = 0 - 1;
        } else if (side == 1) {
            b.borderTopW = w; b.borderTopColor = col;
        } else if (side == 2) {
            b.borderRightW = w; b.borderRightColor = col;
        } else if (side == 3) {
            b.borderBottomW = w; b.borderBottomColor = col;
        } else {
            b.borderLeftW = w; b.borderLeftColor = col;
        }
    }

    // `border-radius: all | tl tr br bl`（`999`/`50%` 将形状完全圆化）。
    static void DeclRadius(StyleBox b, string val) {
        List<string> toks = StyleSheet.Tokens(val);
        if (toks.Count == 0) { return; }
        b.radiusTL = StyleSheet.LenField(b, StyleSheet.SideToken(toks, 0), StyleBox.SourceRadiusTL());
        b.radiusTR = StyleSheet.LenField(b, StyleSheet.SideToken(toks, 1), StyleBox.SourceRadiusTR());
        b.radiusBR = StyleSheet.LenField(b, StyleSheet.SideToken(toks, 2), StyleBox.SourceRadiusBR());
        b.radiusBL = StyleSheet.LenField(b, StyleSheet.SideToken(toks, 3), StyleBox.SourceRadiusBL());
        int r = b.radiusTL;
        long source = StyleBox.SourceRadiusTL();
        if (b.radiusTR > r) { r = b.radiusTR; source = StyleBox.SourceRadiusTR(); }
        if (b.radiusBR > r) { r = b.radiusBR; source = StyleBox.SourceRadiusBR(); }
        if (b.radiusBL > r) { r = b.radiusBL; source = StyleBox.SourceRadiusBL(); }
        b.radius = r;
        b.SetPrescaled(StyleBox.SourceRadius(), b.IsPrescaled(source));
    }

    // 单个角的圆角（`border-top-left-radius` 等，`which`：0 TL、
    // 1 TR、2 BR、3 BL）。
    // 未被声明过的角先继承当前的 `radius`：StyleBox 用"四个角都
    // 未声明"表示全圆角，只写一个角的话另外三个必须落成具体值，
    // 否则 Corners() 会把它们当成直角，一条
    // `border-top-left-radius: 0` 就会把整个盒子削成方的。
    static void CornerRadius(StyleBox b, int which, int v) {
        long source = StyleBox.SourceRadiusTL();
        if (which == 1) { source = StyleBox.SourceRadiusTR(); }
        else if (which == 2) { source = StyleBox.SourceRadiusBR(); }
        else if (which == 3) { source = StyleBox.SourceRadiusBL(); }
        bool physical = b.IsPrescaled(source);
        int fb = b.radius;
        if (fb < 0) { fb = 0; }
        bool inherited = b.IsPrescaled(StyleBox.SourceRadius());
        if (b.radiusTL < 0) { b.radiusTL = fb; b.SetPrescaled(StyleBox.SourceRadiusTL(), inherited); }
        if (b.radiusTR < 0) { b.radiusTR = fb; b.SetPrescaled(StyleBox.SourceRadiusTR(), inherited); }
        if (b.radiusBR < 0) { b.radiusBR = fb; b.SetPrescaled(StyleBox.SourceRadiusBR(), inherited); }
        if (b.radiusBL < 0) { b.radiusBL = fb; b.SetPrescaled(StyleBox.SourceRadiusBL(), inherited); }
        b.SetPrescaled(source, physical);
        if (which == 0) { b.radiusTL = v; }
        else if (which == 1) { b.radiusTR = v; }
        else if (which == 2) { b.radiusBR = v; }
        else { b.radiusBL = v; }
        int max = b.radiusTL;
        if (b.radiusTR > max) { max = b.radiusTR; }
        if (b.radiusBR > max) { max = b.radiusBR; }
        if (b.radiusBL > max) { max = b.radiusBL; }
        b.radius = max;
        long maxSource = StyleBox.SourceRadiusTL();
        if (b.radiusTR == max) { maxSource = StyleBox.SourceRadiusTR(); }
        if (b.radiusBR == max) { maxSource = StyleBox.SourceRadiusBR(); }
        if (b.radiusBL == max) { maxSource = StyleBox.SourceRadiusBL(); }
        b.SetPrescaled(StyleBox.SourceRadius(), b.IsPrescaled(maxSource));
    }

    // `box-shadow: [inset] <dx> <dy> [blur] <color>`（或仅一个颜色）。
    static void DeclShadow(StyleBox b, string val) {
        if (StyleSheet.Lower(val) == "none") {
            b.shadow = 0;
            return;
        }
        List<string> toks = StyleSheet.Tokens(val);
        List<string> nums = new List<string>();
        int col = 0;
        int i = 0;
        while (i < toks.Count) {
            string tk = toks[i];
            i = i + 1;
            if (StyleSheet.Lower(tk) == "inset") { b.shadowInset = 1; continue; }
            if (StyleSheet.IsNumeric(tk) || StyleSheet.HasMath(tk)) { nums.Add(tk); continue; }
            col = StyleSheet.ParseColor(tk);
        }
        if (col != 0) { b.shadow = col; }
        if (nums.Count >= 2) {
            b.shadowDx = StyleSheet.LenStored(b, nums[0], StyleBox.SourceShadowDx());
            b.shadowDy = StyleSheet.LenStored(b, nums[1], StyleBox.SourceShadowDy());
            if (nums.Count >= 3) { b.shadowBlur = StyleSheet.LenStored(b, nums[2], StyleBox.SourceShadowBlur()); }
        } else if (nums.Count == 1) {
            b.shadowDy = StyleSheet.LenStored(b, nums[0], StyleBox.SourceShadowDy());
        } else if (b.shadowDy == 0) {
            b.shadowDy = 2;
            b.SetPrescaled(StyleBox.SourceShadowDy(), false);
        }
    }

    // `-zan-sheen: none | <strength> [color]`：玻璃光泽强度（`0.35`、
    // `35%` 或千分比 `350`），可选高光颜色（默认白）。绘制由
    // StyleBox 统一完成，因此任何画 box 的控件都能被皮肤点亮。
    static void DeclSheen(StyleBox b, string val) {
        if (StyleSheet.Lower(val) == "none") {
            b.sheen = 0;
            return;
        }
        List<string> toks = StyleSheet.Tokens(val);
        int i = 0;
        int str = 0 - 1;
        while (i < toks.Count) {
            string tk = toks[i];
            i = i + 1;
            if (StyleSheet.IsNumeric(tk)) {
                if (str < 0) { str = StyleSheet.Perm(tk); }
                continue;
            }
            b.sheenColor = StyleSheet.ParseColor(tk);
        }
        if (str < 0) { str = 1000; }
        if (str > 1000) { str = 1000; }
        b.sheen = str;
    }

    // `padding/margin: all | v h | t h b | t r b l`。
    // margin/padding 单边值：margin 的 `auto` 记哨兵 -1（布局端做
    // 水平居中/贴边），padding 的 `auto` 按 0。
    static int SideVal(StyleBox b, string tok, bool margin) {
        if (tok == "auto") { return margin ? 0 - 1 : 0; }
        return StyleSheet.Len(b, tok);
    }

    static string SideToken(List<string> toks, int side) {
        if (side == 0) { return toks[0]; }
        if (side == 1) { return toks.Count >= 2 ? toks[1] : toks[0]; }
        if (side == 2) { return toks.Count >= 3 ? toks[2] : toks[0]; }
        return toks.Count >= 4 ? toks[3] : (toks.Count >= 2 ? toks[1] : toks[0]);
    }

    static int SideLength(StyleBox b, string tok, bool margin, long source) {
        if (tok == "auto") {
            b.SetPrescaled(source, false);
            return margin ? StyleBox.Unset() : 0;
        }
        return StyleSheet.LenField(b, tok, source);
    }

    static void DeclSides(StyleBox b, string val, int which) {
        List<string> toks = StyleSheet.Tokens(val);
        if (toks.Count == 0) { return; }
        if (which == 0) {
            b.padT = StyleSheet.SideLength(b, StyleSheet.SideToken(toks, 0), false, StyleBox.SourcePadT());
            b.padR = StyleSheet.SideLength(b, StyleSheet.SideToken(toks, 1), false, StyleBox.SourcePadR());
            b.padB = StyleSheet.SideLength(b, StyleSheet.SideToken(toks, 2), false, StyleBox.SourcePadB());
            b.padL = StyleSheet.SideLength(b, StyleSheet.SideToken(toks, 3), false, StyleBox.SourcePadL());
        } else {
            b.marT = StyleSheet.SideLength(b, StyleSheet.SideToken(toks, 0), true, StyleBox.SourceMarT());
            b.marR = StyleSheet.SideLength(b, StyleSheet.SideToken(toks, 1), true, StyleBox.SourceMarR());
            b.marB = StyleSheet.SideLength(b, StyleSheet.SideToken(toks, 2), true, StyleBox.SourceMarB());
            b.marL = StyleSheet.SideLength(b, StyleSheet.SideToken(toks, 3), true, StyleBox.SourceMarL());
        }
    }

    // `transition: [prop] <duration> [timing]`——这里只有时长和 timing
    // 有意义（所有可动画属性一起缓动）。
    static void DeclTransition(StyleBox b, string val) {
        List<string> toks = StyleSheet.Tokens(val);
        int i = 0;
        while (i < toks.Count) {
            string tk = toks[i];
            i = i + 1;
            if (StyleSheet.IsNumeric(tk)) { b.transitionMs = StyleSheet.Ms(tk); continue; }
            int e = StyleSheet.Easing(tk);
            if (e >= 0) { b.easing = e; }
        }
    }

    static void DeclTransform(StyleBox b, string val) {
        string s = val;
        if (StyleSheet.Lower(s) == "none") {
            b.tx = 0; b.ty = 0; b.scale = 1000; b.rotate = 0;
            b.SetPrescaled(StyleBox.SourceTx() | StyleBox.SourceTy(), false);
            return;
        }
        int i = 0;
        while (i < s.Length) {
            int open = Css.IndexFrom(s, "(", i);
            if (open < 0) { return; }
            int close = Css.MatchParen(s, open);
            if (close < 0) { return; }
            string name = StyleSheet.Lower(StyleSheet.Trim(s.Substring(i, open - i)));
            string args = s.Substring(open + 1, close - open - 1);
            i = close + 1;
            List<string> a = Css.SplitTopTrim(args, ",");
            if (name == "translate") {
                if (a.Count >= 1) { b.tx = StyleSheet.LenField(b, a[0], StyleBox.SourceTx()); }
                if (a.Count >= 2) { b.ty = StyleSheet.LenField(b, a[1], StyleBox.SourceTy()); }
            } else if (name == "translatex") {
                if (a.Count >= 1) { b.tx = StyleSheet.LenField(b, a[0], StyleBox.SourceTx()); }
            } else if (name == "translatey") {
                if (a.Count >= 1) { b.ty = StyleSheet.LenField(b, a[0], StyleBox.SourceTy()); }
            } else if (name == "scale") {
                if (a.Count >= 1) { b.scale = StyleSheet.Perm(a[0]); }
            } else if (name == "rotate") {
                if (a.Count >= 1) { b.rotate = StyleSheet.Num(a[0]); }
            }
        }
    }

    // `animation: <name> <duration> [timing] [infinite]`。名称映射到
    // 内置关键帧（spin、pulse、breath、shimmer、float、glow、aurora、
    // motes），由 Fx 绘制。
    static void DeclAnimation(StyleBox b, string val) {
        List<string> toks = StyleSheet.Tokens(val);
        int i = 0;
        while (i < toks.Count) {
            string tk = toks[i];
            i = i + 1;
            string lo = StyleSheet.Lower(tk);
            if (lo == "none") { b.anim = 0; continue; }
            if (lo == "infinite" || lo == "linear" || lo == "ease"
                || lo == "ease-in" || lo == "ease-out" || lo == "ease-in-out"
                || lo == "alternate" || lo == "forwards") {
                int e = StyleSheet.Easing(lo);
                if (e >= 0) { b.easing = e; }
                continue;
            }
            if (StyleSheet.IsNumeric(tk)) { b.animMs = StyleSheet.Ms(tk); continue; }
            int kind = Style.AnimKind(lo);
            if (kind != 0) { b.anim = kind; }
        }
    }

    // 滤镜值中的 `blur(20px)` -> 20（无时为 0）。长度走 Len
    // （`blur(0.2em)` 这类也能解析）。
    static int BlurArg(StyleBox b, string val) {
        int at = Css.IndexFrom(StyleSheet.Lower(val), "blur(", 0);
        if (at < 0) { return 0; }
        int close = Css.IndexFrom(val, ")", at);
        if (close < 0) { return 0; }
        return StyleSheet.LenStored(b, val.Substring(at + 5, close - at - 5), StyleBox.SourceBlur());
    }

    // 缓动函数名转枚举码：ease/linear/ease-in/ease-out/ease-in-out，
    // 不认识返回 -1。
    static int Easing(string val) {
        string s = StyleSheet.Lower(val);
        if (s == "ease") { return 0; }
        if (s == "linear") { return 1; }
        if (s == "ease-in") { return 2; }
        if (s == "ease-out") { return 3; }
        if (s == "ease-in-out") { return 4; }
        return 0 - 1;
    }

    // 字重关键词转数值：bold=700 / normal=400 / light=300，
    // 其余按数字解析。
    static int Weight(string val) {
        string s = StyleSheet.Lower(val);
        if (s == "bold" || s == "bolder") { return 700; }
        if (s == "normal") { return 400; }
        if (s == "light" || s == "lighter") { return 300; }
        return StyleSheet.Num(s);
    }

    // cursor 关键词转系统光标码（pointer/text/resize 等，
    // 不认识回退箭头）。
    static int CursorCode(string val) {
        string s = StyleSheet.Lower(val);
        if (s == "pointer" || s == "hand" || s == "grab") { return Cursor.Hand(); }
        if (s == "text") { return Cursor.IBeam(); }
        if (s == "ew-resize" || s == "col-resize"
            || s == "e-resize" || s == "w-resize") { return Cursor.ResizeH(); }
        if (s == "ns-resize" || s == "row-resize"
            || s == "n-resize" || s == "s-resize") { return Cursor.ResizeV(); }
        if (s == "grabbing" || s == "zoom-in") { return Cursor.Hand(); }
        return Cursor.Arrow();
    }

}
