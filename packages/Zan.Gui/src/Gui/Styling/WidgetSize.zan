using System;

namespace Gui;

// 统一控件尺寸与交互高度档位。
public class WidgetSize {
    // 24px: 紧凑微型控件（紧凑工具条图标按钮、密集列表操作按键）
    const int Mini   = 24;
    // 28px: 次紧凑控件（工具栏标准项、表格内嵌按钮）
    const int Small  = 28;
    // 32px: 桌面端标准控件高度（常规 Button、Input、SelectBox）
    const int Medium = 32;
    // 40px: 强调型大控件（全局搜索框、呼吁操作主按钮）
    const int Large  = 40;
}
