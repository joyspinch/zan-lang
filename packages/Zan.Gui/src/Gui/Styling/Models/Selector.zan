using System;
using System.Collections.Generic;
using Gui;

namespace Gui;


public class Selector {
    public string type;
    // `*` 通配：匹配任意类型（权重 0）。
    public bool universal;
    public string classes;   // 以空格分隔，无类时为 ""
    // classes 的预切分形式（匹配热路径上不再分配）。
    public List<string> classList;
    public string id;
    public string part;
    // 以空格分隔的伪类名（`:hover:selected` -> "hover selected"），
    // 无状态时为 ""。多个伪类是与关系，因此"选中且悬停"
    // 这类组合外观能写在 CSS 里，而不必回到代码里分支。
    public string state;
    // `[class*="frag"]` 里的 frag：class 属性原文的子串匹配，
    // 用于 `custom-{hex}` 这类复合 class 片段（无该条件时为 ""）。
    // 大小写敏感的子串条件才走这个快路径，其余走 attrs。
    public string clsContains;
    // class 上的属性条件（`[class^="x"]` 等）。
    public List<AttrCond> attrs;
    // 必须置位的状态位（`:hover`、`[disabled]`）。
    public int reqMask;
    // 必须清零的状态位（`:enabled`、`[disabled="false"]`）。
    public int forbidMask;
    // `:not(...)`：其中任一命中则本选择器不匹配。
    public List<Selector> nots;
    // `:is(...)` / `:where(...)`：任一命中即命中（前者计特异性，后者不计）。
    public List<Selector> ises;
    public List<Selector> wheres;
    // `:has(...)`：宿主的相对范围内存在候选命中内层选择器即命中。
    public List<HasCond> hasList;
    // 主体左侧的复合块（null = 没有链，主体就是整个选择器）。
    // 链上的状态/伪类按被匹配祖先自身最近一次解析的状态求值。
    public Selector up;
    // `up` 与本块之间的连接器：0 后代（空隙）、1 子（`>`）、
    // 2 相邻兄弟（`+`）、3 通用兄弟（`~`）。
    public int combo;
    // 结构性伪类码（StructCode：1 first-child … 12 root），0 无。
    // 要兄弟/父子信息，仅在带树上下文的匹配里可判定。
    public int structCode;
    // `:nth-child(an+b)` 系参数（结构码 4/5/9/10 时有效）。
    public int anbA;
    public int anbB;
    // 语法接受但引擎无法判定（行级伪元素、无法求值的 `:not()`、
    // `:lang()` 等）时置位，永不匹配。
    public bool never;
    // never 的原因（Lint 用它把"写了没反应"说清楚）。
    public string why;

    // 解析一个选择器：先按组合器切成复合块序列（从右往左挂链），
    // 再逐块走 ParseCompound。引擎无法建模的块按约定返回 null
    // （丢弃整条规则）或置 never（永不匹配），二者都不静默。
    static Selector Parse(string sel) {
        string s = Css.Trim(sel);
        if (s == "" || s == ":root") { return null; }
        List<string> items = Css.SelectorTokens(s);
        List<SelectorTokenChunk> chunks = new List<SelectorTokenChunk>();
        int conn = 0 - 1;
        for (int i = 0; i < items.Count; i = i + 1) {
            string it = items[i];
            if (it == ">") { conn = 1; }
            else if (it == "+") { conn = 2; }
            else if (it == "~") { conn = 3; }
            else if (it == " ") { if (conn < 0) { conn = 0; } }
            else {
                chunks.Add(new SelectorTokenChunk(it, conn < 0 ? 0 : conn));
                conn = 0 - 1;
            }
        }
        if (chunks.Count == 0) { return null; }
        Selector subject = Selector.ParseCompound(chunks[chunks.Count - 1].chunk);
        if (subject == null) { return null; }
        Selector cur = subject;
        int k = chunks.Count - 1;
        while (k >= 1) {
            Selector link = Selector.ParseCompound(chunks[k - 1].chunk);
            if (link == null) { return null; }
            cur.up = link;
            cur.combo = chunks[k].combinator;
            cur = link;
            k = k - 1;
        }
        return subject;
    }

    // 解析单个复合选择器（不含组合器）：`button.ghost.primary::icon:hover`。
    // 引擎不建模的形式按约定返回 null 或置 never。
    static Selector ParseCompound(string sel) {
        string s = Css.Trim(sel);
        if (s == "" || s == ":root") { return null; }
        Selector p = new Selector();
        p.type = "";
        p.universal = false;
        p.classes = "";
        p.classList = new List<string>();
        p.id = "";
        p.part = "";
        p.state = "";
        p.clsContains = "";
        p.attrs = new List<AttrCond>();
        p.reqMask = 0;
        p.forbidMask = 0;
        p.nots = new List<Selector>();
        p.ises = new List<Selector>();
        p.wheres = new List<Selector>();
        p.hasList = new List<HasCond>();
        p.up = null;
        p.combo = 0;
        p.structCode = 0;
        p.anbA = 0;
        p.anbB = 0;
        p.never = false;
        p.why = "";
        int i = 0;
        int n = s.Length;
        if (n > 0 && (s[0] & 255) == 42) { p.universal = true; i = 1; }
        else {
            int tStart = i;
            while (i < n && Selector.NameCharByte(s[i] & 255)) { i = i + 1; }
            if (i > tStart) { p.type = s.Substring(tStart, i - tStart); }
            // type 选择器大小写不敏感地匹配控件类型：StyleType()
            // 给的是 Kind() 的小写形式，CSS 侧同样折到小写
            // （class/id 仍严格区分大小写）。
            p.type = p.type.ToLower();
        }
        while (i < n) {
            int ch = s[i] & 255;
            if (ch == 91) { // '['
                int close = Css.IndexFrom(s, "]", i);
                if (close < 0) { return null; }
                if (!p.AddAttr(Css.Trim(s.Substring(i + 1, close - i - 1)))) {
                    return null;
                }
                i = close + 1;
                continue;
            }
            if (ch == 58) { // ':'
                int ni = p.Pseudo(s, i);
                if (ni < 0) { return null; }
                i = ni;
                continue;
            }
            if (ch == 46 || ch == 35) { // '.' or '#'
                int j = i + 1;
                int nameStart = j;
                while (j < n && Selector.NameCharByte(s[j] & 255)) {
                    j = j + 1;
                }
                if (j == nameStart) { return null; }
                string name = s.Substring(nameStart, j - nameStart);
                if (ch == 46) {
                    if (p.classes == "") { p.classes = name; }
                    else { p.classes = p.classes + " " + name; }
                    p.classList.Add(name);
                } else {
                    p.id = name;
                }
                i = j;
                continue;
            }
            return null;
        }
        return p;
    }

    // 处理 `at` 处的 `:`：`::part`、`:state`、`[pseudo-element]`、
    // `:not()/:is()/:where()` 或结构性伪类（`:nth-child()` 等）。
    // 返回下一个下标，硬错误（无法配对）返回 -1。
    int Pseudo(string s, int at) {
        int n = s.Length;
        int start = at + 1;
        bool isPart = false;
        if (start < n && (s[start] & 255) == 58) { isPart = true; start = start + 1; }
        int j = start;
        int nameStart = j;
        while (j < n && Selector.NameCharByte(s[j] & 255)) {
            j = j + 1;
        }
        if (j == nameStart) { return -1; }
        string name = s.Substring(nameStart, j - nameStart);
        if (isPart) {
            if (Selector.IsGenerated(name)) {
                // `::first-line`/`::first-letter` 是行级伪元素，行盒
                // 模型没有对应绘制原语：按永不匹配报出（Lint 点名）。
                never = true;
                why = "pseudo-element '" + name + "' is not supported";
                return j;
            }
            // `::before`/`::after` 走部件通道：宿主以 part="before"/
            // "after" 解析出伪盒（Style.Part），content 文本由
            // Element 合成进流内容。部件本身不匹配宿主盒
            // （part != ""），不会串到普通规则里。
            part = name;
            return j;
        }
        bool func = (j < n && (s[j] & 255) == 40);
        if (func) {
            int close = Css.MatchParen(s, j);
            if (close < 0) { return -1; }
            string inner = s.Substring(j + 1, close - j - 1);
            string lo = Css.Lower(name);
            if (lo == "not") {
                List<Selector> sub = Selector.ParseList(inner);
                bool determinate = sub.Count > 0;
                for (int q = 0; q < sub.Count; q = q + 1) {
                    if (sub[q] == null || sub[q].never) { determinate = false; }
                }
                // 内层带树条件（`:not(:first-child)`）时不再保守置 never：
                // 匹配期的 MatchNodeCtx 会带上下文递归求值。只有解析不出
                // 或内层永不匹配（`:not(#nope)` 恒真除外）才落 never。
                if (!determinate) {
                    never = true;
                    why = "':not()' argument cannot be evaluated";
                }
                for (int q = 0; q < sub.Count; q = q + 1) {
                    if (sub[q] != null) { nots.Add(sub[q]); }
                }
            } else if (lo == "is" || lo == "where") {
                List<Selector> sub = Selector.ParseList(inner);
                bool any = false;
                for (int q = 0; q < sub.Count; q = q + 1) {
                    if (sub[q] != null && !sub[q].never) {
                        any = true;
                        if (lo == "is") { ises.Add(sub[q]); }
                        else { wheres.Add(sub[q]); }
                    }
                }
                if (!any) {
                    never = true;
                    why = "':" + lo + "()' has no matchable alternative";
                }
            } else if (lo == "has") {
                // :has(相对选择器)：逗号分隔多个候选条件，任一成立即
                // 命中。内层解析不出、含伪元素部件、再嵌 :has()（防
                // 组合爆炸）或本身永不匹配的，整体落 never。
                List<string> alts = Css.SplitTopTrim(inner, ",");
                bool ok = alts.Count > 0;
                for (int h = 0; h < alts.Count && ok; h = h + 1) {
                    string alt = Css.Trim(alts[h]);
                    int lead = 0;
                    if (alt != "" && (alt[0] == 62 || alt[0] == 43
                                      || alt[0] == 126)) {
                        lead = alt[0] == 62 ? 1 : (alt[0] == 43 ? 2 : 3);
                        alt = Css.Trim(alt.Substring(1));
                    }
                    Selector isel = alt == "" ? null : Selector.Parse(alt);
                    if (isel == null || isel.never || isel.part != ""
                        || isel.hasList.Count > 0) {
                        ok = false;
                        break;
                    }
                    HasCond hc = new HasCond();
                    hc.inner = isel;
                    hc.lead = lead;
                    hasList.Add(hc);
                }
                if (!ok) {
                    never = true;
                    why = "':has()' argument cannot be evaluated";
                }
            } else {
                int sc = Selector.StructCode(name);
                if (sc == 0) {
                    // `:lang()` 等：语法接受，但本引擎没有对应信息
                    // 可判定，永不匹配。
                    never = true;
                    why = "functional pseudo-class ':" + name
                        + "()' cannot be evaluated";
                    return close + 1;
                }
                if (sc == 4 || sc == 5 || sc == 9 || sc == 10) {
                    if (!SetAnB(inner)) {
                        never = true;
                        why = "':" + lo + "(" + inner + ")' is not an an+b argument";
                        return close + 1;
                    }
                }
                structCode = sc;
            }
            return close + 1;
        }
        if (Selector.IsPseudoElement(name)) {
            if (Selector.IsGenerated(name)) {
                // `::first-line`/`::first-letter`（含单冒号旧拼写）要
                // 行级盒，retained/immediate 控件模型没有对应绘制
                // 原语，语法接受但永不匹配（Lint 报出来）。
                never = true;
                why = "pseudo-element '" + name + "' is not supported";
                return j;
            }
            // `::before`/`::after` 与其余标准伪元素（`:placeholder` 是
            // `::placeholder` 的旧拼写）统一归到部件：部件存在就命中，
            // 伪元素内容按部件通道单独解析。
            part = name;
            return j;
        }
        int bit = Style.StateBit(name);
        if (bit != 0) {
            if (state == "") { state = name; }
            else { state = state + " " + name; }
            reqMask = reqMask | bit;
            return j;
        }
        if (name == "enabled") {
            forbidMask = forbidMask | Style.SDisabled();
            if (state == "") { state = name; } else { state = state + " " + name; }
            return j;
        }
        int sc2 = Selector.StructCode(name);
        if (sc2 != 0) {
            // 结构性伪类（`:first-child`/`:last-child`/`:empty`…）：
            // 要兄弟/父子信息，匹配期在 retained 树上求值。
            structCode = sc2;
            return j;
        }
        // 拼错的伪类：无信息可判定，标记 never（而不是当无状态规则
        // 误命中）。
        never = true;
        why = "pseudo-class ':" + name + "' cannot be evaluated";
        return j;
    }

    // 结构性伪类名 -> 码。0 = 不是结构性伪类。
    static int StructCode(string name) {
        if (name == "first-child") { return 1; }
        if (name == "last-child") { return 2; }
        if (name == "only-child") { return 3; }
        if (name == "nth-child") { return 4; }
        if (name == "nth-last-child") { return 5; }
        if (name == "first-of-type") { return 6; }
        if (name == "last-of-type") { return 7; }
        if (name == "only-of-type") { return 8; }
        if (name == "nth-of-type") { return 9; }
        if (name == "nth-last-of-type") { return 10; }
        if (name == "empty") { return 11; }
        if (name == "root") { return 12; }
        return 0;
    }

    // 解析 `an+b` 参数（空格容忍）：odd/even/`3`/`n`/`-n+3`/`2n-1`。
    bool SetAnB(string arg) {
        string s = Css.Lower(Css.Trim(arg));
        string t = "";
        for (int i = 0; i < s.Length; i = i + 1) {
            string ch = s.Substring(i, 1);
            if (ch != " ") { t = t + ch; }
        }
        if (t == "odd") { anbA = 2; anbB = 1; return true; }
        if (t == "even") { anbA = 2; anbB = 0; return true; }
        int nAt = Css.IndexFrom(t, "n", 0);
        if (nAt < 0) {
            int v = 0;
            if (!Selector.SignedInt(t, out v)) { return false; }
            anbA = 0;
            anbB = v;
            return true;
        }
        string aPart = t.Substring(0, nAt);
        string bPart = t.Substring(nAt + 1, t.Length - nAt - 1);
        int a = 1;
        if (aPart == "-") { a = 0 - 1; }
        else if (aPart != "" && aPart != "+") {
            if (!Selector.SignedInt(aPart, out a)) { return false; }
        }
        int b = 0;
        if (bPart != "") {
            if (!Selector.SignedInt(bPart, out b)) { return false; }
        }
        anbA = a;
        anbB = b;
        return true;
    }

    // 带符号十进制整数（`-3`/`+7`/`12`），坏文本返回 false。
    static bool SignedInt(string s, out int v) {
        v = 0;
        if (s.Length == 0) { return false; }
        string t = s;
        int sign = 1;
        if (t.Substring(0, 1) == "+") { t = t.Substring(1, t.Length - 1); }
        else if (t.Substring(0, 1) == "-") {
            sign = 0 - 1;
            t = t.Substring(1, t.Length - 1);
        }
        if (t.Length == 0) { return false; }
        for (int i = 0; i < t.Length; i = i + 1) {
            if (!StyleSheet.Digit(t.Substring(i, 1))) { return false; }
        }
        v = sign * StyleSheet.Num(t);
        return true;
    }

    // 1 基序号是否落在 `anA*n + anbB` 的序列里（n = 0,1,2,…）。
    bool MatchAnB(int idx) {
        if (anbA == 0) { return idx == anbB; }
        int d = idx - anbB;
        if (anbA > 0) { return d >= 0 && d % anbA == 0; }
        return d <= 0 && d % anbA == 0;
    }

    // 逗号分隔的选择器列表（`:not(a, b)` 内层）；无法解析的项留 null。
    static List<Selector> ParseList(string text) {
        List<Selector> outR = new List<Selector>();
        List<string> parts = Css.SplitTopTrim(text, ",");
        for (int i = 0; i < parts.Count; i = i + 1) {
            outR.Add(Selector.Parse(parts[i]));
        }
        return outR;
    }

    // 解析 `[...]` 的内容并记入本选择器；不建模的属性返回 false
    // （调用方因此丢弃整条规则，与旧行为一致）。
    bool AddAttr(string inner) {
        if (inner == null) { return false; }
        int k = 0;
        int m = inner.Length;
        int nameStart = k;
        // 属性名不能吃到运算符字符（`^`/`$`/`|` 也是合法名字符，
        // 但在 `[...]` 里它们是 `^=`/`$=`/`|=` 的开头）。
        while (k < m) {
            int c0 = inner[k] & 255;
            if (Css.IsSpaceByte(c0) || c0 == 61 || c0 == 126 || c0 == 124
                || c0 == 94 || c0 == 36 || c0 == 42) {
                break;
            }
            k = k + 1;
        }
        string name = inner.Substring(nameStart, k - nameStart).ToLower();
        if (name == "") { return false; }
        while (k < m && Css.IsSpaceByte(inner[k] & 255)) { k = k + 1; }
        string op = "";
        string val = "";
        bool nocase = false;
        if (k < m) {
            int c = inner[k] & 255;
            if (c == 61) { op = "="; k = k + 1; }
            else if ((c == 126 || c == 124 || c == 94 || c == 36 || c == 42)
                     && k + 1 < m && (inner[k + 1] & 255) == 61) {
                op = inner.Substring(k, 2);
                k = k + 2;
            } else {
                return false;
            }
            while (k < m && Css.IsSpaceByte(inner[k] & 255)) { k = k + 1; }
            if (k < m && ((inner[k] & 255) == 34 || (inner[k] & 255) == 39)) {
                int qChar = inner[k] & 255;
                string q = qChar == 34 ? "\"" : "'";
                int e = Css.IndexFrom(inner, q, k + 1);
                if (e < 0) { return false; }
                val = inner.Substring(k + 1, e - k - 1);
                k = e + 1;
            } else {
                int valStart = k;
                while (k < m && !Css.IsSpaceByte(inner[k] & 255)) {
                    k = k + 1;
                }
                val = inner.Substring(valStart, k - valStart);
            }
            while (k < m && Css.IsSpaceByte(inner[k] & 255)) { k = k + 1; }
            if (k < m) {
                int f = inner[k] & 255;
                if (f == 105 || f == 73) { nocase = true; k = k + 1; }
                else if (f == 115 || f == 83) { k = k + 1; }
                else { return false; }
                while (k < m && Css.IsSpaceByte(inner[k] & 255)) { k = k + 1; }
                if (k < m) { return false; }
            }
            if (val == "") { return false; }
        }
        if (name == "class") {
            AttrCond a = new AttrCond();
            a.name = name;
            a.op = op;
            a.val = val;
            a.nocase = nocase;
            attrs.Add(a);
            if (op == "*=" && !nocase && clsContains == "") { clsContains = val; }
            return true;
        }
        // 布尔属性映射到已有状态位：`[disabled]` 就是 `:disabled`，
        // `[checked]` / `[selected]` 同理。这让网页 CSS 里最常见的
        // 属性选择器直接生效，而不是整条规则被丢弃。
        int bit = Selector.AttrState(name);
        if (bit == 0) {
            // 其余属性查节点属性表（Control.CssAttr）：带属性表的
            // 节点（HTML 层 Element）上 `[type="text"]`/`[data-x]`/
            // `[href]` 都能判；无属性表的控件与 immediate 路径一律
            // 取 ""（不命中），与组合器链"没有树上下文就不命中"
            // 同一约定，Lint 汇总点名。
            AttrCond a = new AttrCond();
            a.name = name;
            a.op = op;
            a.val = val;
            a.nocase = nocase;
            attrs.Add(a);
            return true;
        }
        bool truthy = true;
        if (op != "") {
            string lo = Css.Lower(val);
            if (lo == "false" || lo == "0" || lo == "off" || lo == "no"
                || lo == "none") {
                truthy = false;
            }
        }
        if (truthy) { reqMask = reqMask | bit; }
        else { forbidMask = forbidMask | bit; }
        return true;
    }

    // 布尔属性名对应的状态位（无对应返回 0）。
    static int AttrState(string name) {
        if (name == "disabled") { return Style.SDisabled(); }
        if (name == "checked") { return Style.SChecked(); }
        if (name == "selected") { return Style.SSelected(); }
        return 0;
    }

    // 是否为 CSS 标准伪元素名（单冒号旧拼写也要认成部件）。
    static bool IsPseudoElement(string name) {
        if (name == "before" || name == "after") { return true; }
        if (name == "first-line" || name == "first-letter") { return true; }
        if (name == "placeholder" || name == "selection" || name == "marker") {
            return true;
        }
        if (name == "backdrop" || name == "file-selector-button") { return true; }
        if (name == "caret" || name == "scrollbar" || name == "track"
            || name == "thumb") {
            return true;
        }
        return false;
    }

    // 行级伪元素：行盒模型没有对应绘制原语，语法接受但永不匹配。
    // `::before`/`::after` 已支持——content 文本按宿主流内容合成
    // （Element 伪文本），不再落 here。
    static bool IsGenerated(string name) {
        return name == "first-line" || name == "first-letter";
    }

    // 规则 `i` 是否选中给定的节点（无树上下文版本：组合器链与
    // 结构性伪类整体不命中——immediate 路径没有节点可看）。
    bool MatchNode(string nodeType, List<string> classes, string cls, string nodeId,
                   string nodePart, int stateBits) {
        return this.MatchNodeCtx(nodeType, classes, cls, nodeId, nodePart,
                                 stateBits, null);
    }

    // 带树上下文的匹配：`node` 是主体控件（retained 树的节点），
    // 组合器沿 parent/children 求值，结构性伪类按兄弟信息求值。
    bool MatchNodeCtx(string nodeType, List<string> classes, string cls,
                      string nodeId, string nodePart, int stateBits,
                      Control node) {
        if (never) { return false; }
        if (part != nodePart) { return false; }
        if (type != "" && type != nodeType) { return false; }
        if (id != "" && (nodeId == "" || id != nodeId)) { return false; }
        if ((stateBits & reqMask) != reqMask) { return false; }
        if ((stateBits & forbidMask) != 0) { return false; }
        if (clsContains != "" && (cls == "" || Css.IndexFrom(cls, clsContains, 0) < 0)) {
            return false;
        }
        if (classList.Count > 0) {
            if (classes == null || classes.Count == 0) {
                if (cls == "") { return false; }
                for (int k = 0; k < classList.Count; k = k + 1) {
                    if (!Style.Has(cls, classList[k])) { return false; }
                }
            } else {
                int cCount = classes.Count;
                if (classList.Count > cCount) { return false; }
                if (cCount == 1) {
                    string c0 = classes[0];
                    for (int k = 0; k < classList.Count; k = k + 1) {
                        if (classList[k] != c0) { return false; }
                    }
                } else if (cCount == 2) {
                    string c0 = classes[0];
                    string c1 = classes[1];
                    for (int k = 0; k < classList.Count; k = k + 1) {
                        string target = classList[k];
                        if (target != c0 && target != c1) { return false; }
                    }
                } else {
                    for (int k = 0; k < classList.Count; k = k + 1) {
                        string target = classList[k];
                        bool found = false;
                        for (int m = 0; m < cCount; m = m + 1) {
                            if (classes[m] == target) {
                                found = true;
                                break;
                            }
                        }
                        if (!found) { return false; }
                    }
                }
            }
        }
        for (int a = 0; a < attrs.Count; a = a + 1) {
            if (!Selector.MatchAttr(attrs[a], classes, cls, node)) {
                return false;
            }
        }
        for (int t = 0; t < nots.Count; t = t + 1) {
            if (nots[t].MatchNodeCtx(nodeType, classes, cls, nodeId, nodePart,
                                     stateBits, node)) {
                return false;
            }
        }
        if (ises.Count + wheres.Count > 0) {
            bool any = false;
            for (int q = 0; q < ises.Count; q = q + 1) {
                if (ises[q].MatchNodeCtx(nodeType, classes, cls, nodeId,
                                         nodePart, stateBits, node)) {
                    any = true;
                }
            }
            for (int w = 0; w < wheres.Count; w = w + 1) {
                if (wheres[w].MatchNodeCtx(nodeType, classes, cls, nodeId,
                                           nodePart, stateBits, node)) {
                    any = true;
                }
            }
            if (!any) { return false; }
        }
        for (int h = 0; h < hasList.Count; h = h + 1) {
            if (!Selector.HasMatch(node, hasList[h])) { return false; }
        }
        if (structCode != 0) {
            if (node == null || !this.MatchStruct(node)) { return false; }
        }
        if (up != null) {
            if (node == null || !this.MatchChain(up, node)) { return false; }
        }
        return true;
    }

    // 组合器连接：`up` 复合块要能在 `node` 的对应近邻上命中。
    // 链上的状态位按近邻控件最近一次解析的状态求值（未解析过
    // 视为常态）——不是完全实时，但比一律按常态强。
    bool MatchChain(Selector up, Control node) {
        Control par = node.parent;
        if (combo == 1) {
            if (par == null) { return false; }
            return up.MatchNodeCtx(par.StyleType(), Style.Classes(par.Class),
                                   par.Class, par.name, "",
                                   Style.NodeState(par), par);
        }
        if (combo == 2) {
            Control prev = Selector.SiblingAt(par, node, 1);
            if (prev == null) { return false; }
            return up.MatchNodeCtx(prev.StyleType(), Style.Classes(prev.Class),
                                   prev.Class, prev.name, "",
                                   Style.NodeState(prev), prev);
        }
        if (combo == 3) {
            int back = 1;
            while (true) {
                Control sib = Selector.SiblingAt(par, node, back);
                if (sib == null) { return false; }
                if (up.MatchNodeCtx(sib.StyleType(), Style.Classes(sib.Class),
                                    sib.Class, sib.name, "",
                                    Style.NodeState(sib), sib)) {
                    return true;
                }
                back = back + 1;
            }
        }
        // 后代：任一祖先命中即可。
        Control anc = par;
        while (anc != null) {
            if (up.MatchNodeCtx(anc.StyleType(), Style.Classes(anc.Class),
                                anc.Class, anc.name, "",
                                Style.NodeState(anc), anc)) {
                return true;
            }
            anc = anc.parent;
        }
        return false;
    }

    // `node` 往前数第 `back` 个兄弟（1 = 紧邻的前一个），越界为 null。
    // 负值往后数（-1 = 紧邻的后一个）。兄弟关系只看 children
    // （与 CSS 的元素兄弟一致，不区分可见性）。
    static Control SiblingAt(Control par, Control node, int back) {
        if (par == null) { return null; }
        int idx = par.IndexOf(node);
        int at = idx - back;
        if (idx < 0 || at < 0 || at >= par.ChildCount()) { return null; }
        return par.children[at];
    }

    // :has() 求值：候选 = 宿主按 lead 组合器取的相对范围
    // （0 严格后代、1 直接子、2 紧邻后兄弟、3 全部后兄弟），任一
    // 候选命中内层选择器即成立。内层自身的组合器链从候选向上正常
    // 求值，链的最左块可能落在宿主子树之外（`:scope div img` 的
    // 严格辖域）——`div img` 这类嵌套链是已知近似，常见形如
    // `:has(> img)`/`:has(img)`/`:has(+ p)` 均精确。
    static bool HasMatch(Control host, HasCond hc) {
        if (host == null || hc == null || hc.inner == null) { return false; }
        if (hc.lead == 2) {
            Control nxt = Selector.SiblingAt(host.parent, host, 0 - 1);
            if (nxt == null) { return false; }
            return Selector.SelHit(hc.inner, nxt);
        }
        if (hc.lead == 3) {
            int fwd = 1;
            while (true) {
                Control sib = Selector.SiblingAt(host.parent, host, 0 - fwd);
                if (sib == null) { return false; }
                if (Selector.SelHit(hc.inner, sib)) { return true; }
                fwd = fwd + 1;
            }
        }
        return Selector.ScanSubtree(hc.inner, host, hc.lead == 1 ? 1 : 0);
    }

    // 子树扫描：depth 0 = 全部严格后代，1 = 仅直接子。
    static bool ScanSubtree(Selector inner, Control host, int depth) {
        List<Control> kids = host.children;
        if (kids == null) { return false; }
        for (int i = 0; i < kids.Count; i = i + 1) {
            Control k = kids[i];
            if (Selector.SelHit(inner, k)) { return true; }
            if (depth == 0 && Selector.ScanSubtree(inner, k, 0)) { return true; }
        }
        return false;
    }

    // 候选节点是否命中（部件位恒空：:has 内层不允许伪元素部件）。
    static bool SelHit(Selector s, Control c) {
        return s.MatchNodeCtx(c.StyleType(), Style.Classes(c.Class),
                              c.Class, c.name, "", Style.NodeState(c), c);
    }

    // 结构性伪类在真实节点上的求值。没有父节点的根视为
    // 首子 + 末子 + 唯一子（CSS 里根元素同样如此）。
    bool MatchStruct(Control node) {
        Control par = node.parent;
        int idx = par == null ? 0 : par.IndexOf(node);
        int count = par == null ? 1 : par.ChildCount();
        if (structCode == 1) { return idx == 0; }
        if (structCode == 2) { return idx == count - 1; }
        if (structCode == 3) { return count == 1; }
        if (structCode == 4) { return this.MatchAnB(idx + 1); }
        if (structCode == 5) { return this.MatchAnB(count - idx); }
        if (structCode == 11) { return node.ChildCount() == 0; }
        if (structCode == 12) { return par == null; }
        if (structCode >= 6 && structCode <= 10) {
            string ty = node.StyleType();
            int before = 0;
            int after = 0;
            for (int i = 0; i < count; i = i + 1) {
                Control sib = par.children[i];
                if (sib == node || sib.StyleType() != ty) { continue; }
                if (i < idx) { before = before + 1; }
                else { after = after + 1; }
            }
            if (structCode == 6) { return before == 0; }
            if (structCode == 7) { return after == 0; }
            if (structCode == 8) { return before == 0 && after == 0; }
            if (structCode == 9) { return this.MatchAnB(before + 1); }
            return this.MatchAnB(after + 1);
        }
        return false;
    }

    // 此选择器是否依赖树上下文（组合器链、结构性伪类、:has()，或
    // 需要查节点属性表的非 class 属性条件）：immediate 路径不会
    // 命中，且表里有它时样式缓存键要并节点位置签名（同型不同属性
    // 的兄弟节点不得共用缓存），Lint 按它汇总"只在 retained 树生效"。
    bool Relational() {
        if (up != null || structCode != 0) { return true; }
        if (hasList != null && hasList.Count > 0) { return true; }
        for (int a = 0; a < attrs.Count; a = a + 1) {
            if (attrs[a].name != "class") { return true; }
        }
        return false;
    }

    // 一个属性条件是否成立。`class` 条件对 class 原文/词表求值
    // （immediate 路径也可判）；其余条件查 `node` 的属性表
    // （Control.CssAttr），node 为 null（immediate 路径）或无表时
    // 保守不命中。存在性条件走 CssHasAttr——布尔属性值为空串
    // （`<div hidden>`）也算存在，与"在不在表里"分开。
    static bool MatchAttr(AttrCond a, List<string> classes, string cls,
                          Control node) {
        if (a.name != "class") {
            if (a.op == "") {
                return node != null && node.CssHasAttr(a.name);
            }
            string v = node == null ? "" : node.CssAttr(a.name);
            string hay = v;
            string val = a.val;
            if (a.nocase) { hay = Css.Lower(hay); val = Css.Lower(val); }
            if (val == "") { return false; }
            if (a.op == "~=") {
                return Style.Has(hay, val);
            }
            return Selector.HayOp(a.op, hay, val);
        }
        if (a.op == "") { return cls != ""; }
        string chay = cls;
        string cval = a.val;
        if (a.nocase) { chay = Css.Lower(chay); cval = Css.Lower(cval); }
        if (cval == "") { return false; }
        if (a.op == "~=") {
            if (a.nocase) { return Style.Has(chay, cval); }
            return Style.Has(cls, cval);
        }
        return Selector.HayOp(a.op, chay, cval);
    }

    // `=`/`^=`/`$=`/`|=`/`*=` 对原文串求值（nocase 已在两参上生效）。
    static bool HayOp(string op, string hay, string val) {
        if (op == "=") { return hay == val; }
        int hl = hay.Length;
        int vl = val.Length;
        if (op == "^=") { return hl >= vl && hay.StartsWith(val); }
        if (op == "$=") { return hl >= vl && hay.EndsWith(val); }
        if (op == "|=") {
            return hay == val
                || (hl > vl && hay.StartsWith(val)
                    && hay.Substring(vl, 1) == "-");
        }
        return Css.IndexFrom(hay, val, 0) >= 0;
    }

    // 大小写不敏感的类 token 命中（类名已在调用前转小写）。
    static bool HoldsCI(List<string> classes, string name) {
        for (int i = 0; i < classes.Count; i = i + 1) {
            if (Css.Lower(classes[i]) == name) { return true; }
        }
        return false;
    }

    // `:not()`/`:is()`/`:has()` 取内层最大权重；组合器链按 CSS
    // 逐块累加。
    int Specificity() {
        int spec = 0;
        if (type != "") { spec = spec + 1; }
        spec = spec + classList.Count * 100;
        spec = spec + attrs.Count * 100;
        if (id != "") { spec = spec + 10000; }
        spec = spec + Style.Classes(state).Count * 1000000;
        if (reqMask != 0 || forbidMask != 0) { spec = spec + 1000000; }
        int inner = 0;
        for (int t = 0; t < nots.Count; t = t + 1) {
            int s = nots[t].Specificity();
            if (s > inner) { inner = s; }
        }
        for (int q = 0; q < ises.Count; q = q + 1) {
            int s = ises[q].Specificity();
            if (s > inner) { inner = s; }
        }
        for (int h = 0; h < hasList.Count; h = h + 1) {
            int s = hasList[h].inner.Specificity();
            if (s > inner) { inner = s; }
        }
        spec = spec + inner;
        if (up != null) { spec = spec + up.Specificity(); }
        return spec;
    }

    // 可作为类型/类/id/部件名称字符时为 true（字节判定避免字符串分配）。
    static bool NameCharByte(int b) {
        if (b == 46 || b == 35 || b == 58 || b == 42) { return false; }
        if (b == 44 || b == 62 || b == 43 || b == 126 || b == 91) {
            return false;
        }
        if (b == 40 || b == 41 || b == 93 || b == 61) { return false; }
        if (b == 34 || b == 39) { return false; }
        return !Css.IsSpaceByte(b);
    }

    // 可作为类型/类/id/部件名称字符时为 true。
    static bool NameChar(string ch) {
        if (ch == null || ch.Length == 0) { return false; }
        return Selector.NameCharByte(ch[0] & 255);
    }
}
