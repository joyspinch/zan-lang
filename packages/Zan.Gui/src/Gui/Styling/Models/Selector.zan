using System;
using System.Collections.Generic;
using Gui;
namespace Gui;
public class Selector {
    public string type;
    public bool universal;
    public string classes;   // 以空格分隔，无类时为 ""
    public List<string> classList;
    public string id;
    public string part;
    public string state;
    public string clsContains;
    public List<AttrCond> attrs;
    public int reqMask;
    public int forbidMask;
    public List<Selector> nots;
    public List<Selector> ises;
    public List<Selector> wheres;
    public List<HasCond> hasList;
    public Selector up;
    public int combo;
    public int structCode;
    public int anbA;
    public int anbB;
    public bool never;
    public string why;
    static List<string> emptyClasses = new List<string>();
    static List<AttrCond> emptyAttrs = new List<AttrCond>();
    static List<Selector> emptySelectors = new List<Selector>();
    static List<HasCond> emptyHasList = new List<HasCond>();
    static Selector Parse(string sel) {
        return Selector.ParseDepth(sel, 0);
    }
    static Selector ParseDepth(string sel, int depth) {
        if (sel == null || depth > 16) { return null; }
        string s = Css.Trim(sel);
        if (s == "" || s == ":root") { return null; }
        List<string> items = Css.SelectorTokens(s);
        List<SelectorTokenChunk> chunks = new List<SelectorTokenChunk>();
        int conn = 0 - 1;
        for (int i = 0; i < items.Count; i = i + 1) {
            string it = items[i];
            if (it == ">") { conn = 1; }
            else if (it == "+") { conn = 2; }
            else if (it == "~") { conn = 3; }
            else if (it == " ") { if (conn < 0) { conn = 0; } }
            else {
                chunks.Add(new SelectorTokenChunk(it, conn < 0 ? 0 : conn));
                conn = 0 - 1;
            }
        }
        if (chunks.Count == 0) { return null; }
        Selector subject = Selector.ParseCompoundDepth(chunks[chunks.Count - 1].chunk, depth);
        if (subject == null) { return null; }
        Selector cur = subject;
        int k = chunks.Count - 1;
        while (k >= 1) {
            Selector link = Selector.ParseCompoundDepth(chunks[k - 1].chunk, depth);
            if (link == null) { return null; }
            cur.up = link;
            cur.combo = chunks[k].combinator;
            cur = link;
            k = k - 1;
        }
        return subject;
    }
    static Selector ParseCompound(string sel) {
        return Selector.ParseCompoundDepth(sel, 0);
    }
    static Selector ParseCompoundDepth(string sel, int depth) {
        if (sel == null || depth > 16) { return null; }
        string s = Css.Trim(sel);
        if (s == "" || s == ":root") { return null; }
        Selector p = new Selector();
        p.type = "";
        p.universal = false;
        p.classes = "";
        p.classList = Selector.emptyClasses;
        p.id = "";
        p.part = "";
        p.state = "";
        p.clsContains = "";
        p.attrs = Selector.emptyAttrs;
        p.reqMask = 0;
        p.forbidMask = 0;
        p.nots = Selector.emptySelectors;
        p.ises = Selector.emptySelectors;
        p.wheres = Selector.emptySelectors;
        p.hasList = Selector.emptyHasList;
        p.up = null;
        p.combo = 0;
        p.structCode = 0;
        p.anbA = 0;
        p.anbB = 0;
        p.never = false;
        p.why = "";
        int i = 0;
        int n = s.Length;
        if (n > 0 && (s[0] & 255) == 42) { p.universal = true; i = 1; }
        else {
            int tStart = i;
            while (i < n && Selector.NameCharByte(s[i] & 255)) { i = i + 1; }
            if (i > tStart) { p.type = s.Substring(tStart, i - tStart); }
            p.type = p.type.ToLower();
        }
        while (i < n) {
            int ch = s[i] & 255;
            if (ch == 91) { // '['
                int close = Css.IndexFrom(s, "]", i);
                if (close < 0) { return null; }
                if (!p.AddAttr(Css.Trim(s.Substring(i + 1, close - i - 1)))) { return null; }
                i = close + 1;
                continue;
            }
            if (ch == 58) { // ':'
                int ni = p.PseudoDepth(s, i, depth);
                if (ni < 0) { return null; }
                i = ni;
                continue;
            }
            if (ch == 46 || ch == 35) { // '.' or '#'
                int j = i + 1;
                int nameStart = j;
                while (j < n && Selector.NameCharByte(s[j] & 255)) {
                    j = j + 1;
                }
                if (j == nameStart) { return null; }
                string name = s.Substring(nameStart, j - nameStart);
                if (ch == 46) {
                    if (p.classes == "") { p.classes = name; }
                    else { p.classes = p.classes + " " + name; }
                    if (p.classList == Selector.emptyClasses) { p.classList = new List<string>(); }
                    p.classList.Add(name);
                } else {
                    p.id = name;
                }
                i = j;
                continue;
            }
            return null;
        }
        return p;
    }
    int Pseudo(string s, int at) {
        return this.PseudoDepth(s, at, 0);
    }
    int PseudoDepth(string s, int at, int depth) {
        int n = s.Length;
        int start = at + 1;
        bool isPart = false;
        if (start < n && (s[start] & 255) == 58) { isPart = true; start = start + 1; }
        int j = start;
        int nameStart = j;
        while (j < n && Selector.NameCharByte(s[j] & 255)) {
            j = j + 1;
        }
        if (j == nameStart) { return -1; }
        string name = s.Substring(nameStart, j - nameStart);
        if (isPart) {
            if (Selector.IsGenerated(name)) {
                never = true;
                why = "pseudo-element '" + name + "' is not supported";
                return j;
            }
            part = name;
            return j;
        }
        bool func = (j < n && (s[j] & 255) == 40);
        if (func) {
            int close = Css.MatchParen(s, j);
            if (close < 0) { return -1; }
            string inner = s.Substring(j + 1, close - j - 1);
            string lo = Css.Lower(name);
            if (lo == "not") {
                if (depth >= 16) {
                    never = true;
                    why = "':not()' nesting too deep";
                    return close + 1;
                }
                List<Selector> sub = Selector.ParseListDepth(inner, depth + 1);
                bool determinate = sub.Count > 0;
                for (int q = 0; q < sub.Count; q = q + 1) {
                    if (sub[q] == null || sub[q].never) { determinate = false; }
                }
                if (!determinate) {
                    never = true;
                    why = "':not()' argument cannot be evaluated";
                }
                for (int q = 0; q < sub.Count; q = q + 1) {
                    if (sub[q] != null) {
                        if (nots == Selector.emptySelectors) { nots = new List<Selector>(); }
                        nots.Add(sub[q]);
                    }
                }
            } else if (lo == "is" || lo == "where") {
                if (depth >= 16) {
                    never = true;
                    why = "':" + lo + "()' nesting too deep";
                    return close + 1;
                }
                List<Selector> sub = Selector.ParseListDepth(inner, depth + 1);
                bool any = false;
                for (int q = 0; q < sub.Count; q = q + 1) {
                    if (sub[q] != null && !sub[q].never) {
                        any = true;
                        if (lo == "is") {
                            if (ises == Selector.emptySelectors) { ises = new List<Selector>(); }
                            ises.Add(sub[q]);
                        } else {
                            if (wheres == Selector.emptySelectors) { wheres = new List<Selector>(); }
                            wheres.Add(sub[q]);
                        }
                    }
                }
                if (!any) {
                    never = true;
                    why = "':" + lo + "()' has no matchable alternative";
                }
            } else if (lo == "has") {
                if (depth >= 16) {
                    never = true;
                    why = "':has()' nesting too deep";
                    return close + 1;
                }
                List<string> alts = Css.SplitTopTrim(inner, ",");
                bool ok = alts.Count > 0;
                for (int h = 0; h < alts.Count && ok; h = h + 1) {
                    string alt = Css.Trim(alts[h]);
                    int lead = 0;
                    if (alt != "") {
                        int fb = alt[0] & 255;
                        if (fb == 62 || fb == 43 || fb == 126) {
                            lead = fb == 62 ? 1 : (fb == 43 ? 2 : 3);
                            alt = Css.Trim(alt.Substring(1));
                        }
                    }
                    Selector isel = alt == "" ? null : Selector.ParseDepth(alt, depth + 1);
                    if (isel == null || isel.never || isel.part != ""
                        || isel.hasList.Count > 0) {
                        ok = false;
                        break;
                    }
                    HasCond hc = new HasCond();
                    hc.inner = isel;
                    hc.lead = lead;
                    if (hasList == Selector.emptyHasList) { hasList = new List<HasCond>(); }
                    hasList.Add(hc);
                }
                if (!ok) {
                    never = true;
                    why = "':has()' argument cannot be evaluated";
                }
            } else {
                int sc = Selector.StructCode(name);
                if (sc == 0) {
                    never = true;
                    why = "functional pseudo-class ':" + name
                        + "()' cannot be evaluated";
                    return close + 1;
                }
                if (sc == 4 || sc == 5 || sc == 9 || sc == 10) {
                    if (!SetAnB(inner)) {
                        never = true;
                        why = "':" + lo + "(" + inner + ")' is not an an+b argument";
                        return close + 1;
                    }
                }
                structCode = sc;
            }
            return close + 1;
        }
        if (Selector.IsPseudoElement(name)) {
            if (Selector.IsGenerated(name)) {
                never = true;
                why = "pseudo-element '" + name + "' is not supported";
                return j;
            }
            part = name;
            return j;
        }
        int bit = Style.StateBit(name);
        if (bit != 0) {
            if (state == "") { state = name; }
            else { state = state + " " + name; }
            reqMask = reqMask | bit;
            return j;
        }
        if (name == "enabled") {
            forbidMask = forbidMask | Style.SDisabled();
            if (state == "") { state = name; } else { state = state + " " + name; }
            return j;
        }
        int sc2 = Selector.StructCode(name);
        if (sc2 != 0) {
            structCode = sc2;
            return j;
        }
        never = true;
        why = "pseudo-class ':" + name + "' cannot be evaluated";
        return j;
    }
    static int StructCode(string name) {
        if (name == "first-child") { return 1; }
        if (name == "last-child") { return 2; }
        if (name == "only-child") { return 3; }
        if (name == "nth-child") { return 4; }
        if (name == "nth-last-child") { return 5; }
        if (name == "first-of-type") { return 6; }
        if (name == "last-of-type") { return 7; }
        if (name == "only-of-type") { return 8; }
        if (name == "nth-of-type") { return 9; }
        if (name == "nth-last-of-type") { return 10; }
        if (name == "empty") { return 11; }
        if (name == "root") { return 12; }
        return 0;
    }
    bool SetAnB(string arg) {
        string s = Css.Lower(Css.Trim(arg));
        string t = s;
        if (s.IndexOf(" ") >= 0) {
            StringBuilder sb = new StringBuilder();
            for (int i = 0; i < s.Length; i = i + 1) {
                int b = s[i] & 255;
                if (b != 32) { sb.Append((char)b); }
            }
            t = sb.ToString();
        }
        if (t == "odd") { anbA = 2; anbB = 1; return true; }
        if (t == "even") { anbA = 2; anbB = 0; return true; }
        int nAt = Css.IndexFrom(t, "n", 0);
        if (nAt < 0) {
            int v = 0;
            if (!Selector.SignedInt(t, out v)) { return false; }
            anbA = 0;
            anbB = v;
            return true;
        }
        string aPart = t.Substring(0, nAt);
        string bPart = t.Substring(nAt + 1, t.Length - nAt - 1);
        int a = 1;
        if (aPart == "-") { a = 0 - 1; }
        else if (aPart != "" && aPart != "+") {
            if (!Selector.SignedInt(aPart, out a)) { return false; }
        }
        int b = 0;
        if (bPart != "") {
            if (!Selector.SignedInt(bPart, out b)) { return false; }
        }
        anbA = a;
        anbB = b;
        return true;
    }
    static bool SignedInt(string s, out int v) {
        v = 0;
        if (s == null) { return false; }
        int n = s.Length;
        if (n == 0) { return false; }
        int start = 0;
        int sign = 1;
        int first = s[0] & 255;
        if (first == 43) { start = 1; }
        else if (first == 45) { sign = 0 - 1; start = 1; }
        if (start >= n) { return false; }
        long acc = 0;
        for (int i = start; i < n; i = i + 1) {
            int b = s[i] & 255;
            if (b < 48 || b > 57) { return false; }
            acc = acc * 10L + (long)(b - 48);
            if (acc > 2147483647L) { return false; }
        }
        v = sign < 0 ? (0 - (int)acc) : (int)acc;
        return true;
    }
    bool MatchAnB(int idx) {
        if (anbA == 0) { return idx == anbB; }
        long d = (long)idx - (long)anbB;
        long a = (long)anbA;
        if (a > 0) { return d >= 0 && d % a == 0; }
        return d <= 0 && d % a == 0;
    }
    static List<Selector> ParseList(string text) {
        return Selector.ParseListDepth(text, 0);
    }
    static List<Selector> ParseListDepth(string text, int depth) {
        List<Selector> outR = new List<Selector>();
        if (text == null || depth > 16) { return outR; }
        List<string> parts = Css.SplitTopTrim(text, ",");
        for (int i = 0; i < parts.Count; i = i + 1) {
            outR.Add(Selector.ParseDepth(parts[i], depth));
        }
        return outR;
    }
    bool AddAttr(string inner) {
        if (inner == null) { return false; }
        int k = 0;
        int m = inner.Length;
        int nameStart = k;
        while (k < m) {
            int c0 = inner[k] & 255;
            if (Css.IsSpaceByte(c0) || c0 == 61 || c0 == 126 || c0 == 124
                || c0 == 94 || c0 == 36 || c0 == 42) {
                break;
            }
            k = k + 1;
        }
        string name = inner.Substring(nameStart, k - nameStart).ToLower();
        if (name == "") { return false; }
        while (k < m && Css.IsSpaceByte(inner[k] & 255)) { k = k + 1; }
        string op = "";
        string val = "";
        bool nocase = false;
        if (k < m) {
            int c = inner[k] & 255;
            if (c == 61) { op = "="; k = k + 1; }
            else if ((c == 126 || c == 124 || c == 94 || c == 36 || c == 42)
                     && k + 1 < m && (inner[k + 1] & 255) == 61) {
                op = inner.Substring(k, 2);
                k = k + 2;
            } else {
                return false;
            }
            while (k < m && Css.IsSpaceByte(inner[k] & 255)) { k = k + 1; }
            if (k < m && ((inner[k] & 255) == 34 || (inner[k] & 255) == 39)) {
                int qChar = inner[k] & 255;
                string q = qChar == 34 ? "\"" : "'";
                int e = Css.IndexFrom(inner, q, k + 1);
                if (e < 0) { return false; }
                val = inner.Substring(k + 1, e - k - 1);
                k = e + 1;
            } else {
                int valStart = k;
                while (k < m && !Css.IsSpaceByte(inner[k] & 255)) {
                    k = k + 1;
                }
                val = inner.Substring(valStart, k - valStart);
            }
            while (k < m && Css.IsSpaceByte(inner[k] & 255)) { k = k + 1; }
            if (k < m) {
                int f = inner[k] & 255;
                if (f == 105 || f == 73) { nocase = true; k = k + 1; }
                else if (f == 115 || f == 83) { k = k + 1; }
                else { return false; }
                while (k < m && Css.IsSpaceByte(inner[k] & 255)) { k = k + 1; }
                if (k < m) { return false; }
            }
            if (val == "") { return false; }
        }
        int bit = name == "class" ? 0 : Selector.AttrState(name);
        if (bit == 0) {
            AttrCond a = new AttrCond();
            a.name = name;
            a.op = op;
            a.val = val;
            a.nocase = nocase;
            if (attrs == Selector.emptyAttrs) { attrs = new List<AttrCond>(); }
            attrs.Add(a);
            if (name == "class" && op == "*=" && !nocase && clsContains == "") {
                clsContains = val;
            }
            return true;
        }
        bool truthy = true;
        if (op != "") {
            string lo = Css.Lower(val);
            if (lo == "false" || lo == "0" || lo == "off" || lo == "no"
                || lo == "none") {
                truthy = false;
            }
        }
        if (truthy) { reqMask = reqMask | bit; }
        else { forbidMask = forbidMask | bit; }
        return true;
    }
    static int AttrState(string name) {
        if (name == "disabled") { return Style.SDisabled(); }
        if (name == "checked") { return Style.SChecked(); }
        if (name == "selected") { return Style.SSelected(); }
        return 0;
    }
    static bool IsPseudoElement(string name) {
        if (name == "before" || name == "after") { return true; }
        if (name == "first-line" || name == "first-letter") { return true; }
        if (name == "placeholder" || name == "selection" || name == "marker") { return true; }
        if (name == "backdrop" || name == "file-selector-button") { return true; }
        if (name == "caret" || name == "scrollbar" || name == "track"
            || name == "thumb") {
            return true;
        }
        return false;
    }
    static bool IsGenerated(string name) { return name == "first-line" || name == "first-letter"; }
    bool MatchNode(string nodeType, List<string> classes, string cls, string nodeId,
                   string nodePart, int stateBits) {
        return this.MatchNodeCtx(nodeType, classes, cls, nodeId, nodePart,
                                 stateBits, null);
    }
    bool MatchNodeCtx(string nodeType, List<string> classes, string cls,
                      string nodeId, string nodePart, int stateBits,
                      StyleNode node) {
        if (never) { return false; }
        if (nodeType == null) { nodeType = ""; }
        if (cls == null) { cls = ""; }
        if (nodeId == null) { nodeId = ""; }
        if (nodePart == null) { nodePart = ""; }
        if (part != nodePart) { return false; }
        if (type != "" && type != nodeType) { return false; }
        if (id != "" && (nodeId == "" || id != nodeId)) { return false; }
        if ((stateBits & reqMask) != reqMask) { return false; }
        if ((stateBits & forbidMask) != 0) { return false; }
        if (clsContains != "" && (cls == "" || Css.IndexFrom(cls, clsContains, 0) < 0)) { return false; }
        if (classList.Count > 0) {
            if (classes == null || classes.Count == 0) {
                if (cls == "") { return false; }
                for (int k = 0; k < classList.Count; k = k + 1) {
                    if (!Style.Has(cls, classList[k])) { return false; }
                }
            } else {
                int cCount = classes.Count;
                if (classList.Count > cCount) { return false; }
                if (cCount == 1) {
                    string c0 = classes[0];
                    for (int k = 0; k < classList.Count; k = k + 1) {
                        if (classList[k] != c0) { return false; }
                    }
                } else if (cCount == 2) {
                    string c0 = classes[0];
                    string c1 = classes[1];
                    for (int k = 0; k < classList.Count; k = k + 1) {
                        string target = classList[k];
                        if (target != c0 && target != c1) { return false; }
                    }
                } else {
                    for (int k = 0; k < classList.Count; k = k + 1) {
                        string target = classList[k];
                        bool found = false;
                        for (int m = 0; m < cCount; m = m + 1) {
                            if (classes[m] == target) {
                                found = true;
                                break;
                            }
                        }
                        if (!found) { return false; }
                    }
                }
            }
        }
        for (int a = 0; a < attrs.Count; a = a + 1) {
            if (!Selector.MatchAttr(attrs[a], classes, cls, node)) { return false; }
        }
        for (int t = 0; t < nots.Count; t = t + 1) {
            if (nots[t] != null && nots[t].MatchNodeCtx(nodeType, classes, cls, nodeId, nodePart,
                                     stateBits, node)) {
                return false;
            }
        }
        if (ises.Count + wheres.Count > 0) {
            bool any = false;
            for (int q = 0; q < ises.Count; q = q + 1) {
                if (ises[q] != null && ises[q].MatchNodeCtx(nodeType, classes, cls, nodeId,
                                         nodePart, stateBits, node)) {
                    any = true;
                    break;
                }
            }
            if (!any) {
                for (int w = 0; w < wheres.Count; w = w + 1) {
                    if (wheres[w] != null && wheres[w].MatchNodeCtx(nodeType, classes, cls, nodeId,
                                               nodePart, stateBits, node)) {
                        any = true;
                        break;
                    }
                }
            }
            if (!any) { return false; }
        }
        for (int h = 0; h < hasList.Count; h = h + 1) {
            if (!Selector.HasMatch(node, hasList[h])) { return false; }
        }
        if (structCode != 0) {
            if (node == null || !this.MatchStruct(node)) { return false; }
        }
        if (up != null) {
            if (node == null || !this.MatchChain(up, node)) { return false; }
        }
        return true;
    }
    bool MatchChain(Selector up, StyleNode node) {
        if (up == null || node == null) { return false; }
        StyleNode par = node.StyleParentNode();
        if (combo == 1) {
            if (par == null) { return false; }
            return Selector.SelHit(up, par);
        }
        if (combo == 2) {
            StyleNode prev = Selector.SiblingAt(par, node, 1);
            if (prev == null) { return false; }
            return Selector.SelHit(up, prev);
        }
        if (combo == 3) {
            int back = 1;
            while (back <= 4096) {
                StyleNode sib = Selector.SiblingAt(par, node, back);
                if (sib == null) { return false; }
                if (Selector.SelHit(up, sib)) { return true; }
                back = back + 1;
            }
            return false;
        }
        StyleNode anc = par;
        int steps = 0;
        while (anc != null && steps < 256) {
            if (Selector.SelHit(up, anc)) { return true; }
            anc = anc.StyleParentNode();
            steps = steps + 1;
        }
        return false;
    }
    static StyleNode SiblingAt(StyleNode par, StyleNode node, int back) {
        if (par == null) { return null; }
        int idx = par.StyleIndexOfNode(node);
        int at = idx - back;
        if (idx < 0 || at < 0 || at >= par.StyleChildCount()) { return null; }
        return par.StyleChildNodeAt(at);
    }
    static bool HasMatch(StyleNode host, HasCond hc) {
        if (host == null || hc == null || hc.inner == null) { return false; }
        if (hc.lead == 2) {
            StyleNode nxt = Selector.SiblingAt(host.StyleParentNode(), host, 0 - 1);
            if (nxt == null) { return false; }
            return Selector.SelHit(hc.inner, nxt);
        }
        if (hc.lead == 3) {
            int fwd = 1;
            while (fwd <= 4096) {
                StyleNode sib = Selector.SiblingAt(host.StyleParentNode(), host, 0 - fwd);
                if (sib == null) { return false; }
                if (Selector.SelHit(hc.inner, sib)) { return true; }
                fwd = fwd + 1;
            }
            return false;
        }
        return Selector.ScanSubtree(hc.inner, host, hc.lead == 1 ? 1 : 0);
    }
    static bool ScanSubtree(Selector inner, StyleNode host, int depth) {
        return Selector.ScanSubtreeDepth(inner, host, depth != 0, 0);
    }
    static bool ScanSubtreeDepth(Selector inner, StyleNode host, bool directOnly, int depth) {
        if (inner == null || host == null || depth >= 64) { return false; }
        int cnt = host.StyleChildCount();
        for (int i = 0; i < cnt; i = i + 1) {
            StyleNode k = host.StyleChildNodeAt(i);
            if (k == null) { continue; }
            if (Selector.SelHit(inner, k)) { return true; }
            if (!directOnly && Selector.ScanSubtreeDepth(inner, k, false, depth + 1)) { return true; }
        }
        return false;
    }
    static bool SelHit(Selector s, StyleNode c) {
        if (s == null || c == null) { return false; }
        string cls = c.EffectiveClass();
        if (cls == null) { cls = ""; }
        return s.MatchNodeCtx(c.StyleType(), Style.Classes(cls),
                              cls, c.StyleNodeName(), "", Style.NodeState(c), c);
    }
    bool MatchStruct(StyleNode node) {
        if (node == null) { return false; }
        StyleNode par = node.StyleParentNode();
        int idx = par == null ? 0 : par.StyleIndexOfNode(node);
        int count = par == null ? 1 : par.StyleChildCount();
        if (structCode == 1) { return idx == 0; }
        if (structCode == 2) { return idx == count - 1; }
        if (structCode == 3) { return count == 1; }
        if (structCode == 4) { return this.MatchAnB(idx + 1); }
        if (structCode == 5) { return this.MatchAnB(count - idx); }
        if (structCode == 11) { return node.StyleChildCount() == 0; }
        if (structCode == 12) { return par == null; }
        if (structCode >= 6 && structCode <= 10) {
            string ty = node.StyleType();
            int before = 0;
            int after = 0;
            if (par != null) {
                for (int i = 0; i < count; i = i + 1) {
                    StyleNode sib = par.StyleChildNodeAt(i);
                    if (sib == null || sib == node || sib.StyleType() != ty) { continue; }
                    if (i < idx) { before = before + 1; }
                    else { after = after + 1; }
                }
            }
            if (structCode == 6) { return before == 0; }
            if (structCode == 7) { return after == 0; }
            if (structCode == 8) { return before == 0 && after == 0; }
            if (structCode == 9) { return this.MatchAnB(before + 1); }
            return this.MatchAnB(after + 1);
        }
        return false;
    }
    bool Relational() {
        if (up != null || structCode != 0) { return true; }
        if (hasList != null && hasList.Count > 0) { return true; }
        for (int a = 0; a < attrs.Count; a = a + 1) {
            if (attrs[a].name != "class") { return true; }
        }
        for (int n = 0; n < nots.Count; n = n + 1) {
            if (nots[n].Relational()) { return true; }
        }
        for (int i = 0; i < ises.Count; i = i + 1) {
            if (ises[i].Relational()) { return true; }
        }
        for (int w = 0; w < wheres.Count; w = w + 1) {
            if (wheres[w].Relational()) { return true; }
        }
        return false;
    }
    bool NeedsLiveContext() {
        if (structCode != 0 || combo == 2 || combo == 3) { return true; }
        if (hasList != null && hasList.Count > 0) { return true; }
        for (int a = 0; a < attrs.Count; a = a + 1) {
            if (attrs[a].name != "class") { return true; }
        }
        if (up != null && up.NeedsLiveContext()) { return true; }
        for (int n = 0; n < nots.Count; n = n + 1) {
            if (nots[n].NeedsLiveContext()) { return true; }
        }
        for (int i = 0; i < ises.Count; i = i + 1) {
            if (ises[i].NeedsLiveContext()) { return true; }
        }
        for (int w = 0; w < wheres.Count; w = w + 1) {
            if (wheres[w].NeedsLiveContext()) { return true; }
        }
        return false;
    }
    static bool MatchAttr(AttrCond a, List<string> classes, string cls,
                          StyleNode node) {
        if (a == null) { return false; }
        if (cls == null) { cls = ""; }
        if (a.name != "class") {
            if (a.op == "") { return node != null && node.CssHasAttr(a.name); }
            string v = node == null ? "" : node.CssAttr(a.name);
            if (v == null) { v = ""; }
            string hay = v;
            string val = a.val == null ? "" : a.val;
            if (a.nocase) { hay = Css.Lower(hay); val = Css.Lower(val); }
            if (val == "") { return false; }
            if (a.op == "~=") { return Style.Has(hay, val); }
            return Selector.HayOp(a.op, hay, val);
        }
        if (a.op == "") { return cls != ""; }
        string chay = cls;
        string cval = a.val == null ? "" : a.val;
        if (a.nocase) { chay = Css.Lower(chay); cval = Css.Lower(cval); }
        if (cval == "") { return false; }
        if (a.op == "~=") {
            if (a.nocase) { return Style.Has(chay, cval); }
            return Style.Has(cls, cval);
        }
        return Selector.HayOp(a.op, chay, cval);
    }
    static bool HayOp(string op, string hay, string val) {
        if (op == null || hay == null || val == null) { return false; }
        if (op == "=") { return hay == val; }
        int hl = hay.Length;
        int vl = val.Length;
        if (op == "^=") { return hl >= vl && hay.StartsWith(val); }
        if (op == "$=") { return hl >= vl && hay.EndsWith(val); }
        if (op == "|=") {
            return hay == val
                || (hl > vl && hay.StartsWith(val)
                    && hay.Substring(vl, 1) == "-");
        }
        return Css.IndexFrom(hay, val, 0) >= 0;
    }
    static bool HoldsCI(List<string> classes, string name) {
        if (classes == null || name == null) { return false; }
        for (int i = 0; i < classes.Count; i = i + 1) {
            if (Css.Lower(classes[i]) == name) { return true; }
        }
        return false;
    }
    int Specificity() {
        int spec = 0;
        if (type != "") { spec = spec + 1; }
        spec = spec + classList.Count * 100;
        spec = spec + attrs.Count * 100;
        if (id != "") { spec = spec + 10000; }
        spec = spec + Style.Classes(state).Count * 1000000;
        if (reqMask != 0 || forbidMask != 0) { spec = spec + 1000000; }
        int inner = 0;
        for (int t = 0; t < nots.Count; t = t + 1) {
            if (nots[t] == null) { continue; }
            int s = nots[t].Specificity();
            if (s > inner) { inner = s; }
        }
        for (int q = 0; q < ises.Count; q = q + 1) {
            if (ises[q] == null) { continue; }
            int s = ises[q].Specificity();
            if (s > inner) { inner = s; }
        }
        for (int h = 0; h < hasList.Count; h = h + 1) {
            if (hasList[h] == null || hasList[h].inner == null) { continue; }
            int s = hasList[h].inner.Specificity();
            if (s > inner) { inner = s; }
        }
        spec = spec + inner;
        if (up != null) { spec = spec + up.Specificity(); }
        return spec;
    }
    static bool NameCharByte(int b) {
        if (b == 46 || b == 35 || b == 58 || b == 42) { return false; }
        if (b == 44 || b == 62 || b == 43 || b == 126 || b == 91) { return false; }
        if (b == 40 || b == 41 || b == 93 || b == 61) { return false; }
        if (b == 34 || b == 39) { return false; }
        return !Css.IsSpaceByte(b);
    }
    static bool NameChar(string ch) {
        if (ch == null || ch.Length == 0) { return false; }
        return Selector.NameCharByte(ch[0] & 255);
    }
}
