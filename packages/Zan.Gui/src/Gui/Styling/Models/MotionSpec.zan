using System;
using System.Collections.Generic;

namespace Gui;

// 按需挂载在 StyleBox 上的扩展动效配置（仅当 CSS 使用了高级 transition / animation 属性时分配）。
public class MotionSpec {
    public static int PropAll() { return 0; }
    public static int PropNone() { return 1; }
    public static int PropBg() { return 2; }
    public static int PropFg() { return 4; }
    public static int PropBorder() { return 8; }
    public static int PropRadius() { return 16; }
    public static int PropOpacity() { return 32; }
    public static int PropTransform() { return 64; }
    public static int PropShadow() { return 128; }
    public static int PropFilter() { return 256; }

    public int transitionDelayMs;
    public int transitionPropMask;
    public float bezX1;
    public float bezY1;
    public float bezX2;
    public float bezY2;
    public int stepsCount;
    public bool stepsJumpEnd;
    public float springStiffness;
    public float springDamping;
    public float springMass;

    public string animName;
    public int animDelayMs;
    public int animIterations; // -1 = infinite, 0 = none, >= 1 = finite
    public int animDirection;  // 0 normal, 1 reverse, 2 alternate, 3 alternate-reverse
    public int animFillMode;   // 0 none, 1 forwards, 2 backwards, 3 both
    public bool animPaused;
    public int animEasing;     // -1 = inherit StyleBox.easing, 0..7
    public float animBezX1;
    public float animBezY1;
    public float animBezX2;
    public float animBezY2;
    public int animStepsCount;
    public bool animStepsJumpEnd;
    public float animSpringStiffness;
    public float animSpringDamping;
    public float animSpringMass;

    public MotionSpec() {
        this.transitionDelayMs = 0;
        this.transitionPropMask = 0;
        this.bezX1 = 0.25f;
        this.bezY1 = 0.1f;
        this.bezX2 = 0.25f;
        this.bezY2 = 1.0f;
        this.stepsCount = 1;
        this.stepsJumpEnd = true;
        this.springStiffness = 260.0f;
        this.springDamping = 22.0f;
        this.springMass = 1.0f;

        this.animName = "";
        this.animDelayMs = 0;
        this.animIterations = 1;
        this.animDirection = 0;
        this.animFillMode = 0;
        this.animPaused = false;
        this.animEasing = 0 - 1;
        this.animBezX1 = 0.25f;
        this.animBezY1 = 0.1f;
        this.animBezX2 = 0.25f;
        this.animBezY2 = 1.0f;
        this.animStepsCount = 1;
        this.animStepsJumpEnd = true;
        this.animSpringStiffness = 260.0f;
        this.animSpringDamping = 22.0f;
        this.animSpringMass = 1.0f;
    }

    public MotionSpec Clone() {
        MotionSpec c = new MotionSpec();
        c.transitionDelayMs = this.transitionDelayMs;
        c.transitionPropMask = this.transitionPropMask;
        c.bezX1 = this.bezX1;
        c.bezY1 = this.bezY1;
        c.bezX2 = this.bezX2;
        c.bezY2 = this.bezY2;
        c.stepsCount = this.stepsCount;
        c.stepsJumpEnd = this.stepsJumpEnd;
        c.springStiffness = this.springStiffness;
        c.springDamping = this.springDamping;
        c.springMass = this.springMass;

        c.animName = this.animName;
        c.animDelayMs = this.animDelayMs;
        c.animIterations = this.animIterations;
        c.animDirection = this.animDirection;
        c.animFillMode = this.animFillMode;
        c.animPaused = this.animPaused;
        c.animEasing = this.animEasing;
        c.animBezX1 = this.animBezX1;
        c.animBezY1 = this.animBezY1;
        c.animBezX2 = this.animBezX2;
        c.animBezY2 = this.animBezY2;
        c.animStepsCount = this.animStepsCount;
        c.animStepsJumpEnd = this.animStepsJumpEnd;
        c.animSpringStiffness = this.animSpringStiffness;
        c.animSpringDamping = this.animSpringDamping;
        c.animSpringMass = this.animSpringMass;
        return c;
    }

    public static float CubicBezier(float x1, float y1, float x2, float y2, float x) {
        if (x <= 0.0f) { return 0.0f; }
        if (x >= 1.0f) { return 1.0f; }
        if (x1 == y1 && x2 == y2) { return x; }
        double cx = 3.0 * (double)x1;
        double bx = 3.0 * ((double)x2 - (double)x1) - cx;
        double ax = 1.0 - cx - bx;
        double cy = 3.0 * (double)y1;
        double by = 3.0 * ((double)y2 - (double)y1) - cy;
        double ay = 1.0 - cy - by;
        double target = (double)x;
        double u = target;
        bool converged = false;
        for (int i = 0; i < 6; i = i + 1) {
            double xu = ((ax * u + bx) * u + cx) * u - target;
            double absErr = xu < 0.0 ? -xu : xu;
            if (absErr < 0.000001) { converged = true; break; }
            double dx = (3.0 * ax * u + 2.0 * bx) * u + cx;
            if (dx < 0.000001 && dx > -0.000001) { break; }
            u = u - xu / dx;
            if (u < 0.0 || u > 1.0) { break; }
        }
        if (!converged || u < 0.0 || u > 1.0) {
            double lo = 0.0;
            double hi = 1.0;
            u = target;
            for (int j = 0; j < 18; j = j + 1) {
                double mid = (lo + hi) * 0.5;
                double xm = ((ax * mid + bx) * mid + cx) * mid;
                if (xm < target) { lo = mid; } else { hi = mid; }
                u = mid;
            }
        }
        return (float)(((ay * u + by) * u + cy) * u);
    }

    public static float Steps(int count, bool jumpEnd, float t) {
        if (count <= 1) { return t >= 1.0f ? 1.0f : (jumpEnd ? 0.0f : 1.0f); }
        if (t <= 0.0f) { return 0.0f; }
        if (t >= 1.0f) { return 1.0f; }
        float scaled = t * (float)count;
        int step = (int)scaled;
        if (!jumpEnd) { step = step + 1; }
        if (step < 0) { step = 0; }
        if (step > count) { step = count; }
        return (float)step / (float)count;
    }

    public static void SpringFromBounce(float durationSec, float bounce, out float k, out float c) {
        float dur = durationSec > 0.05f ? durationSec : 0.05f;
        float b = bounce;
        if (b < -0.95f) { b = -0.95f; }
        if (b > 0.95f) { b = 0.95f; }
        double omega = (2.0 * 3.1415926535) / (double)dur;
        k = (float)(omega * omega);
        double zeta = b >= 0.0f ? (1.0 - (double)b) : (1.0 / (1.0 + (double)b));
        c = (float)(2.0 * zeta * omega);
    }

    // 解析阻尼谐振子阶跃响应，支持欠阻尼（物理回弹 > 1.0）、临界阻尼与过阻尼。
    public static float SpringCurve(float stiffness, float damping, float mass, float t) {
        if (t <= 0.0f) { return 0.0f; }
        if (t >= 1.0f) { return 1.0f; }
        double k = stiffness > 1.0f ? (double)stiffness : 1.0;
        double m = mass > 0.01f ? (double)mass : 1.0;
        double c = damping >= 0.0f ? (double)damping : 0.0;
        double w0 = Math.Sqrt(k / m);
        double zeta = c / (2.0 * Math.Sqrt(k * m));
        double decayRate = zeta * w0;
        double settleT = decayRate > 0.25 ? (4.8 / decayRate) : 2.0;
        if (settleT < 0.25) { settleT = 0.25; }
        if (settleT > 2.5) { settleT = 2.5; }
        double tau = (double)t * settleT;
        double y = 1.0;
        if (zeta < 0.999) {
            double root = Math.Sqrt(1.0 - zeta * zeta);
            double wd = w0 * root;
            double env = Math.Exp(-decayRate * tau);
            y = 1.0 - env * (Math.Cos(wd * tau) + (zeta / root) * Math.Sin(wd * tau));
        } else if (zeta <= 1.001) {
            double env = Math.Exp(-w0 * tau);
            y = 1.0 - env * (1.0 + w0 * tau);
        } else {
            double root = Math.Sqrt(zeta * zeta - 1.0);
            double r1 = -w0 * (zeta - root);
            double r2 = -w0 * (zeta + root);
            double e1 = Math.Exp(r1 * tau);
            double e2 = Math.Exp(r2 * tau);
            y = 1.0 - ((r2 * e1 - r1 * e2) / (r2 - r1));
        }
        return (float)y;
    }

    public int EvalTransitionCurve(int baseEasing, int p) {
        if (p <= 0) { return 0; }
        if (p >= 1000) { return 1000; }
        if (baseEasing == 5) {
            float y = MotionSpec.CubicBezier(this.bezX1, this.bezY1, this.bezX2, this.bezY2, (float)p / 1000.0f);
            return (int)(y * 1000.0f + (y >= 0.0f ? 0.5f : -0.5f));
        }
        if (baseEasing == 6) {
            float y = MotionSpec.Steps(this.stepsCount, this.stepsJumpEnd, (float)p / 1000.0f);
            return (int)(y * 1000.0f + 0.5f);
        }
        if (baseEasing == 7) {
            float y = MotionSpec.SpringCurve(this.springStiffness, this.springDamping, this.springMass, (float)p / 1000.0f);
            return (int)(y * 1000.0f + (y >= 0.0f ? 0.5f : -0.5f));
        }
        return Style.Curve(baseEasing, p);
    }

    public int EvalAnimCurve(int baseEasing, int p) {
        if (p <= 0) { return 0; }
        if (p >= 1000) { return 1000; }
        int e = this.animEasing >= 0 ? this.animEasing : baseEasing;
        if (e == 5) {
            float y = MotionSpec.CubicBezier(this.animBezX1, this.animBezY1, this.animBezX2, this.animBezY2, (float)p / 1000.0f);
            return (int)(y * 1000.0f + (y >= 0.0f ? 0.5f : -0.5f));
        }
        if (e == 6) {
            float y = MotionSpec.Steps(this.animStepsCount, this.animStepsJumpEnd, (float)p / 1000.0f);
            return (int)(y * 1000.0f + 0.5f);
        }
        if (e == 7) {
            float y = MotionSpec.SpringCurve(this.animSpringStiffness, this.animSpringDamping, this.animSpringMass, (float)p / 1000.0f);
            return (int)(y * 1000.0f + (y >= 0.0f ? 0.5f : -0.5f));
        }
        return Style.Curve(e, p);
    }

    public static int PropBit(string name) {
        string s = StyleSheet.Lower(StyleSheet.Trim(name));
        if (s == "" || s == "all") { return MotionSpec.PropAll(); }
        if (s == "none") { return MotionSpec.PropNone(); }
        if (s == "background" || s == "background-color" || s == "bg") { return MotionSpec.PropBg(); }
        if (s == "color") { return MotionSpec.PropFg(); }
        if (s == "border" || s == "border-color" || s == "border-width"
            || StyleSheet.StartsWith(s, "border-top")
            || StyleSheet.StartsWith(s, "border-right")
            || StyleSheet.StartsWith(s, "border-bottom")
            || StyleSheet.StartsWith(s, "border-left")) { return MotionSpec.PropBorder(); }
        if (s == "border-radius" || StyleSheet.StartsWith(s, "border-") && StyleSheet.EndsWith(s, "radius")) {
            return MotionSpec.PropRadius();
        }
        if (s == "opacity") { return MotionSpec.PropOpacity(); }
        if (s == "transform" || s == "translate" || s == "scale" || s == "rotate") {
            return MotionSpec.PropTransform();
        }
        if (s == "box-shadow" || s == "shadow") { return MotionSpec.PropShadow(); }
        if (s == "backdrop-filter" || s == "filter") { return MotionSpec.PropFilter(); }
        return 0 - 1;
    }

    public static int ParsePropMask(string val) {
        List<string> parts = Css.SplitTopTrim(val, ",");
        int mask = 0;
        for (int i = 0; i < parts.Count; i = i + 1) {
            int bit = MotionSpec.PropBit(parts[i]);
            if (bit == MotionSpec.PropAll()) { return MotionSpec.PropAll(); }
            if (bit == MotionSpec.PropNone()) {
                if (parts.Count == 1) { return MotionSpec.PropNone(); }
                continue;
            }
            if (bit > 0) { mask = mask | bit; }
        }
        return mask;
    }
}
