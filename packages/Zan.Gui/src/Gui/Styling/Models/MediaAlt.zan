using System;
using System.Collections.Generic;
using Gui;

namespace Gui;

// 一个备选：`not` 前缀 + and 连接的特征。
public class MediaAlt {
    public bool neg;
    public List<MediaFeat> feats;

    bool AltTrue(StyleBox b) {
        if (feats == null || feats.Count == 0) { return false; }
        bool ok = true;
        for (int i = 0; i < feats.Count; i = i + 1) {
            if (!feats[i].True(b)) { ok = false; break; }
        }
        return neg ? !ok : ok;
    }

    // 两个备选的 and（特征并集；neg 简化取或——两边同时取反的
    // 嵌套 @media 极罕见，语义差可忽略）。
    static MediaAlt And(MediaAlt x, MediaAlt y) {
        MediaAlt outA = new MediaAlt();
        outA.neg = x.neg || y.neg;
        outA.feats = new List<MediaFeat>();
        for (int i = 0; i < x.feats.Count; i = i + 1) { outA.feats.Add(x.feats[i]); }
        for (int j = 0; j < y.feats.Count; j = j + 1) { outA.feats.Add(y.feats[j]); }
        return outA;
    }
}
