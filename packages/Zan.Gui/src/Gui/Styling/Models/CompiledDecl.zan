using System;

namespace Gui;

public enum CompiledPropId {
    Generic = 0,
    Color = 1,
    BgColor = 2,
    AccentColor = 3,
    BorderColor = 4,
    BorderTopColor = 5,
    BorderRightColor = 6,
    BorderBottomColor = 7,
    BorderLeftColor = 8,
    Opacity = 9,
    Display = 10,
    FlexDir = 11,
    Justify = 12,
    AlignItems = 13,
    FontWeight = 14,
    TextAlign = 15,
    Cursor = 16,
    Visibility = 17,
    Position = 18,
    Overflow = 19,
    OverflowX = 20,
    OverflowY = 21,
    ZIndex = 22,
    BoxSizing = 23,
    FlexWrap = 24,
    FlexGrow = 25,
    FlexShrink = 26
}

// 预编译单条 CSS 声明：在 StyleSheet 索引期完成 key 规范化、__zan_lengths 覆盖、
// prescaled 标志、currentColor 检测及高频属性（纯色/枚举/opacity）的整型预求值。
public struct CompiledDecl {
    public string key;
    public string val;
    public CompiledPropId propId;
    public int intVal;
    public int auxVal;
    public bool prescaled;
    public int ccBits;
    public bool isPureCurrentColor;
}
