using System;
using System.Collections.Generic;
using Gui;

namespace Gui;

// 样式规则索引条目实体（消除 selText/selObjs/selBlock/selImportant 平行列表反模式）。
public class StyleRuleEntry {
    public string text;
    public Selector selector;
    public JsonValue block;
    public JsonValue important;

    public StyleRuleEntry(string text, Selector selector, JsonValue block, JsonValue important) {
        this.text = text;
        this.selector = selector;
        this.block = block;
        this.important = important;
    }
}

// 媒体规则条目实体（消除 mediaSels/mediaBlocks/mediaImportants/mediaConds 平行列表反模式）。
