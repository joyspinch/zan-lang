using System;
using System.Collections.Generic;
namespace Gui;
public interface StyleHost : RenderHost {
    int HostDpiScale();
    int HostMetricsScale();
    int HostBgThemeGen();
    void HostBumpBgThemeGen();
    Theme HostTheme();
    StyleSheet HostSheet();
    void HostSetSheet(StyleSheet sheet);
    bool HostIsolateAppSheet();
    StyleSheet HostChartSheet();
    Dict<string, StyleBox> HostStyleCache();
    int HostStyleCacheGen();
    void HostSetStyleCache(Dict<string, StyleBox> cache, int gen);
    Dict<int, StyleSheet> HostBaseSheets();
    int HostBaseSheetGen();
    void HostSetBaseSheets(Dict<int, StyleSheet> sheets, int gen);
    StyleNode HostStyleCtx();
    bool HostIsDark();
    bool HostReducedMotion();
    int CssViewportWidth();
    int CssViewportHeight();
    void HostSetSkinName(string name);
    void ApplyTheme(Theme theme, bool dark);
    bool HostSkinArtWallpaper();
    bool HostHasUserWallpaper();
    void HostSetSkinArt(string art, int opacity);
    void HostSetWallpaper(string path, int opacity);
    void HostClearWallpaper();
    void HostNoteGlassRect(int x, int y, int w, int h);
    int HostBlurKeyId(int id);
    int HostBlurKey(int kind, int x, int y, int w, int h);
    int HostBlurSlotFor(int key);
    bool HostBackdropDirtyIn(int slot, int x, int y, int w, int h);
}
