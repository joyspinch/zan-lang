namespace Gui;
public partial class StyleBox {
    bool StaticGlassEligible() {
        return blur > 0 && sheen > 0 && shadow == 0 && emboss == 0
        && specular == 0 && anim == 0 && bgTo == 0 && borderStyle == 0
        && this.BorderWOr(0) == 0 && borderTopW <= 0 && borderRightW <= 0
        && borderBottomW <= 0 && borderLeftW <= 0;
    }
    bool PaintStaticGlass(StyleHost app, int slot, bool dirty, int x, int y, int w, int h, int r) {
        if (!this.StaticGlassEligible()) { return false; }
        Canvas c = app.HostCanvas();
        int blurPx = this.PaintLength(app, blur, StyleBox.SourceBlur());
        int corners = this.Corners();
        int fill = c.ApplyOpacity(this.Fade(bg));
        int strength = sheen;
        if (!treeComposite && opacity < 1000) { strength = strength * opacity / 1000; }
        if (c.opacityPm < 1000) { strength = strength * c.opacityPm / 1000; }
        int color = sheenColor;
        if (color == 0) { color = (int)4294967295; }
        int cap = app.HostScale(120);
        Canvas.PaintHashOp(47, x, y, w, h);
        Canvas.PaintHashOp(0, blurPx, r, corners, fill);
        Canvas.PaintHashOp(0, strength, color, cap, 0);
        bool hashOn = Canvas.PaintHashSuspend();
        try {
            if (c.BeginStaticGlass(slot, x, y, w, h, blurPx, r, corners,
            fill, strength, color, cap, dirty)) { return true; }
            if (r > 0) {
                c.BlurRoundCached(x, y, w, h, blurPx, slot, dirty, r, corners);
            } else {
                c.BlurRectCached(x, y, w, h, blurPx, slot, dirty);
            }
            if (fill != 0) {
                if (r > 0) { c.FillRoundRectIn(x, y, w, h, r, corners, fill); }
                else { c.FillRect(x, y, w, h, fill); }
            }
            this.PaintSheen(app, x, y, w, h, r);
            c.EndStaticGlass(slot);
        } finally { Canvas.PaintHashResume(hashOn); }
        return true;
    }
}
