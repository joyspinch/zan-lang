using System;
namespace Gui;
public partial class StyleBox {
    long prescaled;
    int envDpiScale;
    bool envRemPhysical;
    Theme envTheme;
    StyleSheet envSheet;
    bool lengthDevice;
    bool lengthMath;
    bool lengthPhysical;
    bool declPrescaled;
    int bg;          // 背景色（0 = 无）
    int bgTo;        // 渐变终点色（0 = 纯色）
    int bgVia;       // 可选的中间渐变断点（0 = 无）
    int bgDir;       // 0 向下，1 向右，2 右下，3 向上，4 左下
    int opacity;     // 0..1000 千分比，乘到每个绘制的 alpha 上
    int blur;        // backdrop-filter 模糊半径（px，0 = 关闭）
    int fg;          // 文字/图标颜色
    bool foregroundDeclared;
    int accent;      // 指示符的强调色（下划线、光标、标记）
    int fontPx;
    int fontWeight;  // 0 未设置，400 常规，700 加粗（模拟双重绘制）
    int lineHeight;
    int letterSpacing;
    int align;       // -1 未设置，0 左，1 居中，2 右
    int valign;      // -1 未设置，0 顶，1 居中，2 底
    int textCase;    // 0 无，1 大写，2 小写
    int ellipsis;    // 1 = text-overflow: ellipsis
    int nowrap;      // 1 = white-space: nowrap
    int tsColor;
    int tsDx;
    int tsDy;
    string contentRaw;
    int tsOutline;
    int borderColor;
    int borderW;
    int borderTopW;    int borderTopColor;
    int borderRightW;  int borderRightColor;
    int borderBottomW; int borderBottomColor;
    int borderLeftW;   int borderLeftColor;
    int radius;
    int radiusTL; int radiusTR; int radiusBR; int radiusBL;
    int shadow;      // 颜色（0 = 无）
    int shadowDx;
    int shadowDy;
    int shadowBlur;
    int shadowInset; // 1 = 内阴影
    int borderStyle; // 0 实线，1 虚线
    int emboss;      // 0 无，1 凸起，2 凹陷（新拟态）
    int specular;    // 1 = 边框上跟随光标的高光
    int fxId;        // 高光跟踪悬停所用的控件 id（0 = 无）
    int sheen;
    int sheenColor;  // 光泽颜色（0 = 白）
    int padL; int padT; int padR; int padB;
    int marL; int marT; int marR; int marB;
    int width; int height;
    int minW; int minH; int maxW; int maxH;
    int widthPm; int heightPm;
    int minWPm; int minHPm; int maxWPm; int maxHPm;
    int gap;
    int rowGap;
    int colGap;
    int columns;
    string gridCols;     // grid-template-columns
    string gridRows;     // grid-template-rows
    string gridAutoCols; // grid-auto-columns（缺省按 auto）
    string gridAutoRows; // grid-auto-rows
    int gColStart; int gColEnd; int gColSpan;
    int gRowStart; int gRowEnd; int gRowSpan;
    int justifyItems;
    int display;     // 0 legacy（无 CSS 缺省：dock/手摆），1 flex，2 none，
    int flexDir;     // 0 row，1 column
    int justify;     // 0 start，1 center，2 end，3 space-between，4 space-around
    int alignItems;  // 0 stretch，1 start，2 center，3 end
    int wrap;        // 1 = flex-wrap: wrap
    int alignContent;
    int alignSelf;
    int grow;
    int shrink;
    int basis;
    int basisPm;
    int aspect;
    int order;
    int position;    // 0 static，1 relative，2 absolute
    int posT; int posR; int posB; int posL;
    int overflow;    // 1 = hidden（裁剪子项）
    int overflowCss;
    int overflowX;
    int overflowY;
    int zIndex;
    int cursor;      // Cursor.* 代码，0 = 默认
    int ccMask;
    int visible;     // 0 = visibility: hidden
    int inlineLevel;
    int floatSide;
    int clearSide;
    int boxSizing;
    int whiteSpace;
    int lineHeightKind;
    int bfc;
    int vaInline;
    int transitionMs;
    int easing;      // 0 ease，1 linear，2 ease-in，3 ease-out，4 ease-in-out
    int anim;        // Style.Anim* 种类（0 无）
    int animMs;
    int tx; int ty;  // transform: translate()
    int scale;       // transform: scale()，千分比（1000 = 1x）
    int rotate;      // transform: rotate()，角度
    int envRemPx;
    int envRootFontPx;
    int envVw;
    int envVh;
    bool mediaDark;
    bool mediaReduced;
    internal bool treeComposite;
    static int Unset() { return 0 - 1; }
    static long SourceFont() { return 1; }
    static long SourceWidth() { return 2; }
    static long SourceHeight() { return 4; }
    static long SourceGap() { return 8; }
    static long SourceRadius() { return 16; }
    static long SourcePadL() { return 32; }
    static long SourceIcon() { return 64; }
    static long SourceMinW() { return 128; }
    static long SourceMinH() { return 256; }
    static long SourceMaxW() { return 512; }
    static long SourceMaxH() { return 1024; }
    static long SourceBasis() { return 2048; }
    static long SourceRowGap() { return 4096; }
    static long SourceColGap() { return 8192; }
    static long SourceRadiusTL() { return 16384; }
    static long SourceRadiusTR() { return 32768; }
    static long SourceRadiusBR() { return 65536; }
    static long SourceRadiusBL() { return 131072; }
    static long SourcePadT() { return 262144; }
    static long SourcePadR() { return 524288; }
    static long SourcePadB() { return 1048576; }
    static long SourceMarL() { return 2097152; }
    static long SourceMarT() { return 4194304; }
    static long SourceMarR() { return 8388608; }
    static long SourceMarB() { return 16777216; }
    static long SourceLineHeight() { return 33554432; }
    static long SourceLetterSpacing() { return 67108864; }
    static long SourceBorder() { return 134217728; }
    static long SourceBorderTop() { return 268435456; }
    static long SourceBorderRight() { return 536870912; }
    static long SourceBorderBottom() { return 1073741824; }
    static long SourceBorderLeft() { return (long)1 << 31; }
    static long SourcePosT() { return (long)1 << 32; }
    static long SourcePosR() { return (long)1 << 33; }
    static long SourcePosB() { return (long)1 << 34; }
    static long SourcePosL() { return (long)1 << 35; }
    static long SourceTx() { return (long)1 << 36; }
    static long SourceTy() { return (long)1 << 37; }
    static long SourceShadowDx() { return (long)1 << 38; }
    static long SourceShadowDy() { return (long)1 << 39; }
    static long SourceShadowBlur() { return (long)1 << 40; }
    static long SourceBlur() { return (long)1 << 41; }
    static long SourcePadding() {
        return StyleBox.SourcePadL() | StyleBox.SourcePadT()
            | StyleBox.SourcePadR() | StyleBox.SourcePadB()
            | StyleBox.SourceMarL() | StyleBox.SourceMarT()
            | StyleBox.SourceMarR() | StyleBox.SourceMarB();
    }
    bool IsPrescaled(long source) { return source != 0 && (prescaled & source) == source; }
    void SetPrescaled(long source, bool value) {
        if (value) { prescaled = prescaled | source; }
        else { prescaled = prescaled & (0 - 1 - source); }
    }
    void MarkThemeLengths() { prescaled = prescaled | (((long)1 << 38) - 1); }
    int ScaleLogical(int value) { return value * envDpiScale / 100; }
    int ResolveLength(int value, long source) {
        if (!this.IsPrescaled(source)) { value = this.ScaleLogical(value); }
        this.SetPrescaled(source, true);
        return value;
    }
    int PaintLength(StyleHost app, int value, long source) {
        return this.IsPrescaled(source) ? value : app.HostScale(value);
    }
    StyleBox() {
        this.prescaled = 0;
        this.envDpiScale = 100; this.envRemPhysical = false;
        this.lengthDevice = false; this.lengthMath = false;
        this.lengthPhysical = false; this.declPrescaled = false;
        this.bg = 0; this.bgTo = 0; this.bgVia = 0; this.bgDir = 0;
        this.opacity = 1000; this.blur = 0;
        this.fg = 0; this.accent = 0;
        this.fontPx = 0; this.fontWeight = 0; this.lineHeight = 0; this.letterSpacing = 0;
        this.align = 0 - 1; this.valign = 0 - 1; this.textCase = 0;
        this.ellipsis = 0; this.nowrap = 0;
        this.tsColor = 0; this.tsDx = 0; this.tsDy = 0; this.tsOutline = 0;
        this.borderColor = 0; this.borderW = 0 - 1;
        this.borderTopW = 0 - 1;    this.borderTopColor = 0;
        this.borderRightW = 0 - 1;  this.borderRightColor = 0;
        this.borderBottomW = 0 - 1; this.borderBottomColor = 0;
        this.borderLeftW = 0 - 1;   this.borderLeftColor = 0;
        this.radius = 0 - 1;
        this.radiusTL = 0 - 1; this.radiusTR = 0 - 1; this.radiusBR = 0 - 1; this.radiusBL = 0 - 1;
        this.shadow = 0; this.shadowDx = 0; this.shadowDy = 0; this.shadowBlur = 0; this.shadowInset = 0;
        this.borderStyle = 0; this.emboss = 0; this.specular = 0; this.fxId = 0;
        this.sheen = 0; this.sheenColor = 0;
        this.padL = 0 - 1; this.padT = 0 - 1; this.padR = 0 - 1; this.padB = 0 - 1;
        this.marL = 0; this.marT = 0; this.marR = 0; this.marB = 0;
        this.width = 0 - 1; this.height = 0 - 1;
        this.minW = 0 - 1; this.minH = 0 - 1; this.maxW = 0 - 1; this.maxH = 0 - 1;
        this.widthPm = 0 - 1; this.heightPm = 0 - 1;
        this.minWPm = 0 - 1; this.minHPm = 0 - 1; this.maxWPm = 0 - 1; this.maxHPm = 0 - 1;
        this.gap = 0 - 1;
        this.rowGap = 0 - 1; this.colGap = 0 - 1; this.columns = 0 - 1;
        this.gridCols = ""; this.gridRows = "";
        this.gridAutoCols = ""; this.gridAutoRows = "";
        this.gColStart = 0; this.gColEnd = 0; this.gColSpan = 0;
        this.gRowStart = 0; this.gRowEnd = 0; this.gRowSpan = 0;
        this.justifyItems = 0;
        this.display = 0; this.flexDir = 0; this.justify = 0; this.alignItems = 0;
        this.wrap = 0; this.alignContent = 0; this.alignSelf = 0 - 1;
        this.grow = 0; this.shrink = 0 - 1;
        this.basis = 0 - 1; this.basisPm = 0 - 1; this.aspect = 0;
        this.order = 0;
        this.position = 0;
        this.posT = StyleBox.Unset(); this.posR = StyleBox.Unset();
        this.posB = StyleBox.Unset(); this.posL = StyleBox.Unset();
        this.overflow = 1; this.zIndex = 0; this.cursor = 0; this.visible = 1;
        this.overflowCss = 0 - 1;
        this.overflowX = 0; this.overflowY = 0;
        this.inlineLevel = 0; this.floatSide = 0; this.clearSide = 0;
        this.boxSizing = 0; this.whiteSpace = 0; this.lineHeightKind = 0;
        this.bfc = 0; this.vaInline = 0;
        this.transitionMs = 0 - 1; this.easing = 0;
        this.anim = 0; this.animMs = 0;
        this.tx = 0; this.ty = 0; this.scale = 1000; this.rotate = 0;
        this.envRemPx = 16; this.envRootFontPx = 0;
        this.envVw = 1280; this.envVh = 720;
        this.mediaDark = false; this.mediaReduced = false;
    }
    StyleBox Clone() {
        StyleBox d = new StyleBox();
        d.prescaled = prescaled;
        d.envDpiScale = envDpiScale; d.envRemPhysical = envRemPhysical;
        d.envTheme = envTheme; d.envSheet = envSheet;
        d.envRemPx = envRemPx; d.envRootFontPx = envRootFontPx;
        d.envVw = envVw; d.envVh = envVh;
        d.mediaDark = mediaDark; d.mediaReduced = mediaReduced;
        d.bg = bg; d.bgTo = bgTo; d.bgVia = bgVia; d.bgDir = bgDir;
        d.opacity = opacity; d.blur = blur;
        d.fg = fg; d.foregroundDeclared = foregroundDeclared; d.accent = accent;
        d.fontPx = fontPx; d.fontWeight = fontWeight;
        d.lineHeight = lineHeight; d.letterSpacing = letterSpacing;
        d.align = align; d.valign = valign; d.textCase = textCase;
        d.ellipsis = ellipsis; d.nowrap = nowrap;
        d.tsColor = tsColor; d.tsDx = tsDx; d.tsDy = tsDy;
        d.tsOutline = tsOutline;
        d.borderColor = borderColor; d.borderW = borderW;
        d.borderTopW = borderTopW;       d.borderTopColor = borderTopColor;
        d.borderRightW = borderRightW;   d.borderRightColor = borderRightColor;
        d.borderBottomW = borderBottomW; d.borderBottomColor = borderBottomColor;
        d.borderLeftW = borderLeftW;     d.borderLeftColor = borderLeftColor;
        d.radius = radius;
        d.radiusTL = radiusTL; d.radiusTR = radiusTR;
        d.radiusBR = radiusBR; d.radiusBL = radiusBL;
        d.shadow = shadow; d.shadowDx = shadowDx; d.shadowDy = shadowDy;
        d.shadowBlur = shadowBlur; d.shadowInset = shadowInset;
        d.borderStyle = borderStyle; d.emboss = emboss;
        d.specular = specular; d.fxId = fxId;
        d.sheen = sheen; d.sheenColor = sheenColor;
        d.padL = padL; d.padT = padT; d.padR = padR; d.padB = padB;
        d.marL = marL; d.marT = marT; d.marR = marR; d.marB = marB;
        d.width = width; d.height = height;
        d.minW = minW; d.minH = minH; d.maxW = maxW; d.maxH = maxH;
        d.widthPm = widthPm; d.heightPm = heightPm;
        d.minWPm = minWPm; d.minHPm = minHPm; d.maxWPm = maxWPm; d.maxHPm = maxHPm;
        d.gap = gap;
        d.rowGap = rowGap; d.colGap = colGap; d.columns = columns;
        d.display = display; d.flexDir = flexDir; d.justify = justify;
        d.alignItems = alignItems; d.wrap = wrap; d.alignContent = alignContent;
        d.alignSelf = alignSelf;
        d.gridCols = gridCols; d.gridRows = gridRows;
        d.gridAutoCols = gridAutoCols; d.gridAutoRows = gridAutoRows;
        d.gColStart = gColStart; d.gColEnd = gColEnd; d.gColSpan = gColSpan;
        d.gRowStart = gRowStart; d.gRowEnd = gRowEnd; d.gRowSpan = gRowSpan;
        d.justifyItems = justifyItems;
        d.grow = grow; d.shrink = shrink;
        d.basis = basis; d.basisPm = basisPm; d.aspect = aspect;
        d.order = order;
        d.position = position;
        d.posT = posT; d.posR = posR; d.posB = posB; d.posL = posL;
        d.overflow = overflow; d.zIndex = zIndex; d.cursor = cursor;
        d.overflowCss = overflowCss;
        d.overflowX = overflowX; d.overflowY = overflowY;
        d.ccMask = ccMask;
        d.visible = visible;
        d.inlineLevel = inlineLevel; d.floatSide = floatSide;
        d.clearSide = clearSide; d.boxSizing = boxSizing;
        d.whiteSpace = whiteSpace; d.lineHeightKind = lineHeightKind;
        d.bfc = bfc; d.vaInline = vaInline;
        d.transitionMs = transitionMs; d.easing = easing;
        d.anim = anim; d.animMs = animMs;
        d.tx = tx; d.ty = ty; d.scale = scale; d.rotate = rotate;
        d.contentRaw = contentRaw;
        return d;
    }
    int BorderTopPx() { return borderTopW >= 0 ? borderTopW : this.BorderWOr(0); }
    int BorderRightPx() { return borderRightW >= 0 ? borderRightW : this.BorderWOr(0); }
    int BorderBottomPx() { return borderBottomW >= 0 ? borderBottomW : this.BorderWOr(0); }
    int BorderLeftPx() { return borderLeftW >= 0 ? borderLeftW : this.BorderWOr(0); }
    int BgOr(int fb)      { if (bg != 0) { return bg; } return fb; }
    int FgOr(int fb)      { if (fg != 0) { return fg; } return fb; }
    int AccentOr(int fb)  { if (accent != 0) { return accent; } return fb; }
    int FontOr(int fb)    { if (fontPx > 0) { return fontPx; } return fb; }
    int RadiusOr(int fb)  { if (radius >= 0) { return radius; } return fb; }
    int BorderWOr(int fb) { if (borderW >= 0) { return borderW; } return fb; }
    int BorderOr(int fb)  { if (borderColor != 0) { return borderColor; } return fb; }
    int GapOr(int fb)     { if (gap >= 0) { return gap; } return fb; }
    int RowGapOr(int fb)  { if (rowGap >= 0) { return rowGap; } return this.GapOr(fb); }
    int ColGapOr(int fb)  { if (colGap >= 0) { return colGap; } return this.GapOr(fb); }
    int ColumnsOr(int fb) { if (columns >= 0) { return columns; } return fb; }
    int HeightOr(int fb)  { if (height >= 0) { return height; } return fb; }
    int WidthOr(int fb)   { if (width >= 0) { return width; } return fb; }
    int Corners() {
        if (radiusTL < 0 && radiusTR < 0 && radiusBR < 0 && radiusBL < 0) { return Corner.All(); }
        int m = 0;
        if (radiusTL != 0) { m = m | 1; }
        if (radiusTR != 0) { m = m | 2; }
        if (radiusBR != 0) { m = m | 4; }
        if (radiusBL != 0) { m = m | 8; }
        return m;
    }
    void SetCorners(int m) {
        int r = radius;
        if (r < 0) { r = 0; }
        radiusTL = (m & 1) != 0 ? r : 0;
        radiusTR = (m & 2) != 0 ? r : 0;
        radiusBR = (m & 4) != 0 ? r : 0;
        radiusBL = (m & 8) != 0 ? r : 0;
    }
    static int MetricIn(int pm, int abs, int avail, int fb) {
        if (pm >= 0 && avail > 0) { return avail * pm / 1000; }
        if (abs >= 0) { return abs; }
        return fb;
    }
    int WidthIn(int avail, int fb) { return StyleBox.MetricIn(widthPm, width, avail, fb); }
    int HeightIn(int avail, int fb) { return StyleBox.MetricIn(heightPm, height, avail, fb); }
    int BasisIn(int avail) { return StyleBox.MetricIn(basisPm, basis, avail, 0 - 1); }
    int ClampWIn(int avail, int v) {
        int r = v;
        int lo = StyleBox.MetricIn(minWPm, minW, avail, 0 - 1);
        int hi = StyleBox.MetricIn(maxWPm, maxW, avail, 0 - 1);
        if (lo >= 0 && r < lo) { r = lo; }
        if (hi >= 0 && r > hi) { r = hi; }
        return r;
    }
    int ClampHIn(int avail, int v) {
        int r = v;
        int lo = StyleBox.MetricIn(minHPm, minH, avail, 0 - 1);
        int hi = StyleBox.MetricIn(maxHPm, maxH, avail, 0 - 1);
        if (lo >= 0 && r < lo) { r = lo; }
        if (hi >= 0 && r > hi) { r = hi; }
        return r;
    }
    int TransitionOr(int fb) { if (transitionMs >= 0) { return transitionMs; } return fb; }
    int PadLOr(int fb) { if (padL >= 0) { return padL; } return fb; }
    int PadTOr(int fb) { if (padT >= 0) { return padT; } return fb; }
    int PadROr(int fb) { if (padR >= 0) { return padR; } return fb; }
    int PadBOr(int fb) { if (padB >= 0) { return padB; } return fb; }
    int ClampW(int w) {
        int v = w;
        if (minW >= 0 && v < minW) { v = minW; }
        if (maxW >= 0 && v > maxW) { v = maxW; }
        return v;
    }
    int ClampH(int h) {
        int v = h;
        if (minH >= 0 && v < minH) { v = minH; }
        if (maxH >= 0 && v > maxH) { v = maxH; }
        return v;
    }
    void SetPad(int v) { padL = v; padT = v; padR = v; padB = v; }
    void SetMargin(int v) { marL = v; marT = v; marR = v; marB = v; }
    void SetRadius(int v) {
        radius = v;
        radiusTL = v; radiusTR = v; radiusBR = v; radiusBL = v;
    }
    void SetBorder(int w, int color) {
        borderW = w;
        borderColor = color;
    }
    static StyleBox Blend(StyleBox a, StyleBox b, int p) {
        if (p <= 0) { return a; }
        if (p >= 1000) { return b; }
        StyleBox d = b.Clone();
        StyleBox.BlendSurfaceInto(d, a, b, p);
        d.ccMask = a.ccMask | b.ccMask;
        d.accent = StyleBox.MixColor(a.accent, b.accent, p);
        d.tsColor = StyleBox.MixColor(a.tsColor, b.tsColor, p);
        d.tsDx = StyleBox.LerpVal(a.tsDx, b.tsDx, p);
        d.tsDy = StyleBox.LerpVal(a.tsDy, b.tsDy, p);
        d.fontPx = StyleBox.MixMetric(a.fontPx, b.fontPx, p);
        d.lineHeight = StyleBox.MixMetric(a.lineHeight, b.lineHeight, p);
        d.letterSpacing = StyleBox.LerpVal(a.letterSpacing, b.letterSpacing, p);
        d.padL = StyleBox.MixMetric(a.padL, b.padL, p);
        d.padT = StyleBox.MixMetric(a.padT, b.padT, p);
        d.padR = StyleBox.MixMetric(a.padR, b.padR, p);
        d.padB = StyleBox.MixMetric(a.padB, b.padB, p);
        d.marL = StyleBox.LerpVal(a.marL, b.marL, p);
        d.marT = StyleBox.LerpVal(a.marT, b.marT, p);
        d.marR = StyleBox.LerpVal(a.marR, b.marR, p);
        d.marB = StyleBox.LerpVal(a.marB, b.marB, p);
        d.height = StyleBox.MixMetric(a.height, b.height, p);
        d.width = StyleBox.MixMetric(a.width, b.width, p);
        d.minW = StyleBox.MixMetric(a.minW, b.minW, p);
        d.minH = StyleBox.MixMetric(a.minH, b.minH, p);
        d.maxW = StyleBox.MixMetric(a.maxW, b.maxW, p);
        d.maxH = StyleBox.MixMetric(a.maxH, b.maxH, p);
        d.gap = StyleBox.MixMetric(a.gap, b.gap, p);
        d.rowGap = StyleBox.MixMetric(a.rowGap, b.rowGap, p);
        d.colGap = StyleBox.MixMetric(a.colGap, b.colGap, p);
        d.columns = StyleBox.MixMetric(a.columns, b.columns, p);
        return d;
    }
    internal static void BlendSurfaceInto(StyleBox d, StyleBox a, StyleBox b, int p) {
        d.bg = StyleBox.MixColor(a.bg, b.bg, p);
        d.bgTo = StyleBox.MixColor(a.bgTo, b.bgTo, p);
        d.bgVia = StyleBox.MixColor(a.bgVia, b.bgVia, p);
        d.fg = StyleBox.MixColor(a.fg, b.fg, p);
        d.borderColor = StyleBox.MixColor(a.borderColor, b.borderColor, p);
        d.borderTopColor = StyleBox.MixColor(a.borderTopColor, b.borderTopColor, p);
        d.borderRightColor = StyleBox.MixColor(a.borderRightColor, b.borderRightColor, p);
        d.borderBottomColor = StyleBox.MixColor(a.borderBottomColor, b.borderBottomColor, p);
        d.borderLeftColor = StyleBox.MixColor(a.borderLeftColor, b.borderLeftColor, p);
        d.shadow = StyleBox.MixColor(a.shadow, b.shadow, p);
        d.opacity = StyleBox.LerpVal(a.opacity, b.opacity, p);
        d.blur = StyleBox.LerpVal(a.blur, b.blur, p);
        d.sheen = StyleBox.LerpVal(a.sheen, b.sheen, p);
        d.sheenColor = StyleBox.MixColor(a.sheenColor, b.sheenColor, p);
        d.borderW = StyleBox.MixMetric(a.borderW, b.borderW, p);
        d.borderTopW = StyleBox.MixMetric(a.borderTopW, b.borderTopW, p);
        d.borderRightW = StyleBox.MixMetric(a.borderRightW, b.borderRightW, p);
        d.borderBottomW = StyleBox.MixMetric(a.borderBottomW, b.borderBottomW, p);
        d.borderLeftW = StyleBox.MixMetric(a.borderLeftW, b.borderLeftW, p);
        d.radius = StyleBox.MixMetric(a.radius, b.radius, p);
        d.radiusTL = StyleBox.MixMetric(a.radiusTL, b.radiusTL, p);
        d.radiusTR = StyleBox.MixMetric(a.radiusTR, b.radiusTR, p);
        d.radiusBR = StyleBox.MixMetric(a.radiusBR, b.radiusBR, p);
        d.radiusBL = StyleBox.MixMetric(a.radiusBL, b.radiusBL, p);
        d.shadowDx = StyleBox.LerpVal(a.shadowDx, b.shadowDx, p);
        d.shadowDy = StyleBox.LerpVal(a.shadowDy, b.shadowDy, p);
        d.shadowBlur = StyleBox.LerpVal(a.shadowBlur, b.shadowBlur, p);
        d.tx = StyleBox.LerpVal(a.tx, b.tx, p);
        d.ty = StyleBox.LerpVal(a.ty, b.ty, p);
        d.scale = StyleBox.LerpVal(a.scale, b.scale, p);
        d.rotate = StyleBox.LerpVal(a.rotate, b.rotate, p);
    }
    static int LerpVal(int v0, int v1, int p) { return v0 + (v1 - v0) * p / 1000; }
    static int MixColor(int c0, int c1, int p) {
        if (c0 == c1) { return c0; }
        if (c0 == 0) { return Fx.ScaleAlpha(c1, p); }
        if (c1 == 0) { return Fx.ScaleAlpha(c0, 1000 - p); }
        int rgb = Fx.LerpColor(c0, c1, p);
        int a0 = StyleBox.AlphaOf(c0);
        int a1 = StyleBox.AlphaOf(c1);
        int a = a0 + (a1 - a0) * p / 1000;
        return Fx.ScaleAlpha(rgb, a * 1000 / 255);
    }
    static int MixMetric(int v0, int v1, int p) {
        if (v0 < 0) { return v1; }
        if (v1 < 0) { return v0; }
        return v0 + (v1 - v0) * p / 1000;
    }
    static int AlphaOf(int color) { return (color >> 24) & 255; }
    int Fade(int color) {
        if (color == 0) { return 0; }
        if (treeComposite || opacity >= 1000) { return color; }
        return Fx.ScaleAlpha(color, opacity);
    }
    internal bool SameSurface(StyleBox b) {
        return bg == b.bg && bgTo == b.bgTo && bgVia == b.bgVia && bgDir == b.bgDir
            && fg == b.fg && opacity == b.opacity && blur == b.blur
            && borderColor == b.borderColor && borderW == b.borderW && borderStyle == b.borderStyle
            && borderTopW == b.borderTopW && borderTopColor == b.borderTopColor
            && borderRightW == b.borderRightW && borderRightColor == b.borderRightColor
            && borderBottomW == b.borderBottomW && borderBottomColor == b.borderBottomColor
            && borderLeftW == b.borderLeftW && borderLeftColor == b.borderLeftColor
            && radius == b.radius && radiusTL == b.radiusTL && radiusTR == b.radiusTR
            && radiusBL == b.radiusBL && radiusBR == b.radiusBR
            && shadow == b.shadow && shadowDx == b.shadowDx && shadowDy == b.shadowDy
            && shadowBlur == b.shadowBlur && shadowInset == b.shadowInset
            && sheen == b.sheen && sheenColor == b.sheenColor && emboss == b.emboss
            && specular == b.specular && tx == b.tx && ty == b.ty && scale == b.scale && rotate == b.rotate
            && display == b.display && visible == b.visible && anim == b.anim && animMs == b.animMs;
    }
}
