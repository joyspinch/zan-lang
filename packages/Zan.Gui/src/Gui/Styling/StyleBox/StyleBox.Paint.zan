using System;
namespace Gui;
public partial class StyleBox {
    void Paint(StyleHost app, int x, int y, int w, int h) {
        if (display == 2 || visible == 0) { return; }
        if (w <= 0 || h <= 0) { return; }
        Canvas c = app.HostCanvas();
        int rx = treeComposite ? x : x + tx;
        int ry = treeComposite ? y : y + ty + this.FloatOffset(app, x, y, w, h);
        int rw = w;
        int rh = h;
        if (!layerTransformOwned && scale != 1000 && scale > 0) {
            int nw = w * scale / 1000;
            int nh = h * scale / 1000;
            rx = rx + (w - nw) / 2;
            ry = ry + (h - nh) / 2;
            rw = nw;
            rh = nh;
        }
        int fill = this.Fade(bg);
        if (StyleBox.AlphaOf(fill) > 0 || (bgTo != 0 && StyleBox.AlphaOf(this.Fade(bgTo)) > 0) || blur > 0) {
            app.HostOccludeNative(rx, ry, rw, rh);
        }
        int r = this.RadiusOr(0);
        int rmax = rh / 2;
        if (rw < rh) { rmax = rw / 2; }
        if (r > rmax) { r = rmax; }
        if (blur > 0) {
            app.HostNoteGlassRect(rx, ry, rw, rh);
            int key = app.HostBlurKeyId(fxId);
            if (key == 0) { key = app.HostBlurKey(2, rx, ry, rw, rh); }
            int slot = app.HostBlurSlotFor(key);
            bool bd = app.HostBackdropDirtyIn(slot, rx, ry, rw, rh);
            if (this.PaintStaticGlass(app, slot, bd, rx, ry, rw, rh, r)) { return; }
            if (r > 0) {
                c.BlurRoundCached(rx, ry, rw, rh, this.PaintLength(app, blur, StyleBox.SourceBlur()),
                                  slot, bd, r, this.Corners());
            } else {
                c.BlurRectCached(rx, ry, rw, rh, this.PaintLength(app, blur, StyleBox.SourceBlur()),
                                 slot, bd);
            }
        }
        if (shadow != 0 && shadowInset == 0) { this.PaintShadow(app, rx, ry, rw, rh, r); }
        if (emboss != 0) {
            Theme ht = app.HostTheme();
            Fx.Emboss(app, rx, ry, rw, rh, r, emboss == 2,
                      ht != null ? ht.bgPrimary : 0);
        }
        int corners = this.Corners();
        bool combined = bgTo == 0 && borderStyle != 1 && sheen <= 0
            && !(shadow != 0 && shadowInset == 1)
            && borderTopW <= 0 && borderRightW <= 0
            && borderBottomW <= 0 && borderLeftW <= 0;
        if (combined) {
            c.SurfaceRoundRectIn(rx, ry, rw, rh, r, corners, fill,
                                  this.Fade(borderColor), this.BorderWOr(0));
        } else if (bgTo != 0) {
            this.PaintGradient(app, rx, ry, rw, rh, r);
        } else if (fill != 0) {
            if (r > 0) { c.FillRoundRectIn(rx, ry, rw, rh, r, corners, fill); }
            else { c.FillRect(rx, ry, rw, rh, fill); }
        }
        if (shadow != 0 && shadowInset == 1) {
            int ia = 1;
            while (ia <= 3) {
                c.DrawRoundRect(rx + ia - 1, ry + ia - 1, rw - (ia - 1) * 2,
                                rh - (ia - 1) * 2, r,
                                ColorMath.ScaleAlpha(this.Fade(shadow), 1000 - ia * 250), 1);
                ia = ia + 1;
            }
        }
        if (sheen > 0) { this.PaintSheen(app, rx, ry, rw, rh, r); }
        if (!combined) { this.PaintBorders(app, rx, ry, rw, rh, r); }
        if (specular == 1 && fxId != 0) { Fx.Specular(app, fxId, rx, ry, rw, rh, r, (int)4294967295); }
        this.PaintAnim(app, rx, ry, rw, rh, r);
    }
    void PaintShadow(StyleHost app, int x, int y, int w, int h, int r) {
        int col = this.Fade(shadow);
        int dx = x + this.PaintLength(app, shadowDx, StyleBox.SourceShadowDx());
        int dy = y + this.PaintLength(app, shadowDy, StyleBox.SourceShadowDy());
        int blur = this.PaintLength(app, shadowBlur, StyleBox.SourceShadowBlur());
        if (r < 0) { r = 0; }
        app.HostCanvas().ShadowRoundRect(dx, dy, w, h, r, blur, col);
    }
    void PaintSheen(StyleHost app, int x, int y, int w, int h, int r) {
        Canvas c = app.HostCanvas();
        int str = sheen;
        if (!treeComposite && opacity < 1000) { str = str * opacity / 1000; }
        if (str <= 0) { return; }
        int col = sheenColor;
        if (col == 0) { col = (int)4294967295; }
        int corners = this.Corners();
        int bandH = h / 2;
        int cap = app.HostScale(120);
        if (bandH > cap) { bandH = cap; }
        int peak = ColorMath.ScaleAlpha(col, str * 55 / 100);
        if (bandH > 0) {
            int clear = ColorMath.ScaleAlpha(peak, 0);
            c.FillGradMask(x, y, w, bandH * 2, r, corners & Corner.Top(), 0,
                           peak, clear, clear);
        }
        int inset = this.BorderWOr(0);
        if (borderTopW > inset) { inset = borderTopW; }
        if (inset < 0) { inset = 0; }
        if (inset > 0 && w > inset * 2 + 2 && h > inset * 2 + 2) {
            int ir = r - inset;
            if (ir < 0) { ir = 0; }
            c.DrawRoundRectIn(x + inset, y + inset, w - inset * 2, h - inset * 2, ir, corners,
                              ColorMath.ScaleAlpha(col, str * 42 / 100), 1);
            int lipPad = r > inset ? r : inset;
            int lipW = w - lipPad * 2;
            if (lipW > 0) {
                c.FillRect(x + lipPad, y + inset, lipW, 1, ColorMath.ScaleAlpha(col, str * 88 / 100));
            }
        } else {
            c.DrawRoundRectIn(x, y, w, h, r, corners,
                              ColorMath.ScaleAlpha(col, str * 45 / 100), 1);
            int lipX = x + r;
            int lipW = w - r * 2;
            if (lipW > 0) { c.FillRect(lipX, y, lipW, 1, ColorMath.ScaleAlpha(col, str * 85 / 100)); }
        }
    }
    void PaintGradient(StyleHost app, int x, int y, int w, int h, int r) {
        Canvas c = app.HostCanvas();
        int from = this.Fade(bg);
        int to = this.Fade(bgTo);
        if (bgDir == 3) {
            int sw = from; from = to; to = sw;
        }
        bool opaque = c.opacityPm >= 1000 && StyleBox.AlphaOf(from) == 255 && StyleBox.AlphaOf(to) == 255;
        if (r <= 0 && (bgDir == 0 || bgDir == 3) && opaque) {
            c.FillVGrad(x, y, w, h, from, to);
            return;
        }
        int dirCode = 0;
        if (bgDir == 1) { dirCode = 1; }
        else if (bgDir == 2) { dirCode = 2; }   // 右下对角
        else if (bgDir == 4) { dirCode = 3; }   // 左下对角
        int via = 0;
        if (bgVia != 0) { via = this.Fade(bgVia); }
        c.FillGradMask(x, y, w, h, r, this.Corners(), dirCode, from, via, to);
    }
    void PaintBorders(StyleHost app, int x, int y, int w, int h, int r) {
        Canvas c = app.HostCanvas();
        bool anySide = borderTopW > 0 || borderRightW > 0
            || borderBottomW > 0 || borderLeftW > 0;
        if (!anySide) {
            int bw = this.BorderWOr(0);
            int bc = this.Fade(borderColor);
            if (bw > 0 && bc != 0) {
                if (borderStyle == 1) { Fx.DashedBorder(app, x, y, w, h, bc); }
                else if (r > 0) { c.DrawRoundRectIn(x, y, w, h, r, this.Corners(), bc, bw); }
                else { c.DrawRect(x, y, w, h, bc, bw); }
            }
            return;
        }
        int cn = this.Corners();
        int rTL = 0; int rTR = 0; int rBL = 0; int rBR = 0;
        if (r > 0) {
            if ((cn & 1) != 0) { rTL = r; }
            if ((cn & 2) != 0) { rTR = r; }
            if ((cn & 8) != 0) { rBL = r; }
            if ((cn & 4) != 0) { rBR = r; }
        }
        if (borderTopW > 0) {
            c.FillRect(x + rTL, y, w - rTL - rTR, borderTopW,
                       this.SideColor(borderTopColor));
        }
        if (borderBottomW > 0) {
            c.FillRect(x + rBL, y + h - borderBottomW, w - rBL - rBR,
                       borderBottomW, this.SideColor(borderBottomColor));
        }
        if (borderLeftW > 0) {
            c.FillRect(x, y + rTL, borderLeftW, h - rTL - rBL,
                       this.SideColor(borderLeftColor));
        }
        if (borderRightW > 0) {
            c.FillRect(x + w - borderRightW, y + rTR, borderRightW,
                       h - rTR - rBR, this.SideColor(borderRightColor));
        }
        if (r > 0) {
            this.PaintSideArc(app, x, y, w, h, r, rTL, x, y,
                              borderTopW, borderLeftW,
                              borderTopColor, borderLeftColor);
            this.PaintSideArc(app, x, y, w, h, r, rTR, x + w - r, y,
                              borderTopW, borderRightW,
                              borderTopColor, borderRightColor);
            this.PaintSideArc(app, x, y, w, h, r, rBL, x, y + h - r,
                              borderBottomW, borderLeftW,
                              borderBottomColor, borderLeftColor);
            this.PaintSideArc(app, x, y, w, h, r, rBR, x + w - r, y + h - r,
                              borderBottomW, borderRightW,
                              borderBottomColor, borderRightColor);
        }
    }
    void PaintSideArc(StyleHost app, int x, int y, int w, int h, int r, int on,
                      int cx, int cy, int hw, int vw, int hcol, int vcol) {
        if (on <= 0) { return; }
        int bw = hw;
        if (vw > bw) { bw = vw; }
        if (bw <= 0) { return; }
        int col = hcol;
        if (hw <= 0 || col == 0) { col = vcol; }
        if (col == 0) { col = borderColor; }
        col = this.Fade(col);
        if (col == 0) { return; }
        Canvas c = app.HostCanvas();
        c.PushClip(cx, cy, r, r);
        c.DrawRoundRectIn(x, y, w, h, r, this.Corners(), col, bw);
        c.PopClip();
    }
    int SideColor(int col) {
        if (col != 0) { return this.Fade(col); }
        return this.Fade(borderColor);
    }
    void PaintAnim(StyleHost app, int x, int y, int w, int h, int r) {
        if (anim == 0) { return; }
        int ms = animMs;
        if (ms <= 0) { ms = 2400; }
        int tint = this.AccentOr(this.FgOr(0));
        if (anim == Style.AnimShimmer()) {
            Fx.CardSheen(app, x, y, w, h, tint, ms);
        } else if (anim == Style.AnimGlow()) {
            Fx.BorderGlow(app, x, y, w, h, r, tint, ms, 220);
        } else if (anim == Style.AnimBreath()) {
            Fx.CardBreath(app, x, y, w, h, tint, ms);
        } else if (anim == Style.AnimAurora()) {
            Fx.CardAurora(app, x, y, w, h, tint);
        } else if (anim == Style.AnimMotes()) {
            Fx.CardMotes(app, x, y, w, h, tint);
        } else if (anim == Style.AnimPulse()) {
            int a = Fx.Pulse(app, ms) * 140 / 1000;
            Canvas c = app.HostCanvas();
            c.FillRoundRect(x, y, w, h, r, ColorMath.ScaleAlpha(tint, a * 1000 / 255));
            app.RequestAnimationFrameIn(x, y, w, h);
        }
    }
    int FloatOffset(StyleHost app, int x, int y, int w, int h) {
        if (anim != Style.AnimFloat()) { return 0; }
        int ms = animMs;
        if (ms <= 0) { ms = 2600; }
        int amp = app.HostScale(4);
        app.RequestAnimationFrameIn(x, y - amp, w, h + amp * 2);
        int p = Fx.Pulse(app, ms);
        return amp * (p - 500) / 500;
    }
    int SpinDeg(StyleHost app, int x, int y, int w, int h) {
        if (anim != Style.AnimSpin()) { return rotate; }
        int ms = animMs;
        if (ms <= 0) { ms = 900; }
        app.RequestAnimationFrameIn(x, y, w, h);
        return rotate + Fx.Saw(app, ms) * 360 / 1000;
    }
    int LineHeightPx(int fs) {
        if (lineHeightKind == 2) {
            int f = fs > 0 ? fs : 16;
            return lineHeight * f / 1000;
        }
        return lineHeight;
    }
    int DrawLabel(StyleHost app, int x, int y, int w, int h, string label) {
        if (label == "" || visible == 0 || display == 2) { return 0; }
        Canvas c = app.HostCanvas();
        Theme hostTheme = app.HostTheme();
        int fs = this.FontOr(hostTheme.fontSizeMedium);
        int col = this.Fade(this.FgOr(hostTheme.textPrimary));
        string s = label;
        if (textCase == 1) { s = s.ToUpper(); }
        else if (textCase == 2) { s = s.ToLower(); }
        int avail = w - this.PadLOr(0) - this.PadROr(0)
            - this.BorderLeftPx() - this.BorderRightPx();
        int tw = StyleBox.MeasureSpaced(s, fs, letterSpacing);
        if (ellipsis == 1 && avail > 0 && tw > avail) {
            s = StyleBox.Truncate(s, fs, letterSpacing, avail);
            tw = StyleBox.MeasureSpaced(s, fs, letterSpacing);
        }
        int tx0 = x + this.PadLOr(0) + this.BorderLeftPx();
        if (align == 1) { tx0 = x + (w - tw) / 2; }
        else if (align == 2) { tx0 = x + w - this.PadROr(0) - this.BorderRightPx() - tw; }
        int fh = Canvas.FontHeight(fs);
        int ty0 = y + this.PadTOr(0) + this.BorderTopPx();
        if (align >= 0 && valign < 0) { ty0 = y + (h - fh) / 2; }
        if (valign == 1) { ty0 = y + (h - fh) / 2; }
        else if (valign == 2) { ty0 = y + h - this.PadBOr(0) - this.BorderBottomPx() - fh; }
        int lhPx = this.LineHeightPx(fs);
        if (lhPx > 0) { ty0 = y + (lhPx - fh) / 2; }
        this.DrawRun(c, tx0, ty0, s, col, fs);
        return tw;
    }
    void DrawText(Canvas c, int x, int y, string text, int fallbackColor, int fallbackFont) {
        if (c == null) { return; }
        c.DrawText(x, y, text, this.FgOr(fallbackColor), this.FontOr(fallbackFont));
    }
    void DrawRun(Canvas c, int x, int y, string s, int color, int fs) {
        if (tsColor != 0) { this.DrawTextShadow(c, x, y, s, fs); }
        if (letterSpacing == 0) {
            c.DrawText(x, y, s, color, fs);
            if (fontWeight >= 600) { c.DrawText(x + 1, y, s, color, fs); }
            return;
        }
        int cx = x;
        int i = 0;
        int len = s.Length;
        while (i < len) {
            int b = s[i] & 255;
            int runeLen = 1;
            if (b >= 240) { runeLen = 4; }
            else if (b >= 224) { runeLen = 3; }
            else if (b >= 192) { runeLen = 2; }
            if (i + runeLen > len) { runeLen = len - i; }
            string ch;
            int w;
            if (runeLen == 1 && b >= 32 && b <= 126) {
                ch = Text.CharStr(b);
                w = Canvas.MeasureChar(b, fs);
            } else {
                ch = s.Substring(i, runeLen);
                w = Canvas.MeasureText(ch, fs);
            }
            c.DrawText(cx, y, ch, color, fs);
            if (fontWeight >= 600) { c.DrawText(cx + 1, y, ch, color, fs); }
            cx = cx + w + letterSpacing;
            i = i + runeLen;
        }
    }
    void DrawTextShadow(Canvas c, int x, int y, string s, int fs) {
        int col = this.Fade(tsColor);
        int dx = tsDx;
        int dy = tsDy;
        if (col == 0) { return; }
        if (tsOutline == 1) {
            int r = dx;
            if (dy > r) { r = dy; }
            if (r < 0) { r = 0 - r; }
            if (r < 1) { r = 1; }
            c.DrawText(x - r, y, s, col, fs);
            c.DrawText(x + r, y, s, col, fs);
            c.DrawText(x, y - r, s, col, fs);
            c.DrawText(x, y + r, s, col, fs);
            return;
        }
        c.DrawText(x + dx, y + dy, s, col, fs);
    }
    static int MeasureSpaced(string s, int fs, int spacing) {
        int w = Canvas.MeasureText(s, fs);
        if (spacing != 0) { w = w + spacing * s.Length; }
        return w;
    }
    static string Truncate(string s, int fs, int spacing, int avail) {
        int ell = StyleBox.MeasureSpaced("...", fs, spacing);
        if (avail <= ell) { return "..."; }
        int targetW = avail - ell;
        int low = 0;
        int high = s.Length;
        int best = 0;
        while (low <= high) {
            int mid = (low + high) / 2;
            int cur = mid;
            while (cur > 0 && cur < s.Length && (s[cur] & 192) == 128) {
                cur = cur - 1;
            }
            string head = s.Substring(0, cur);
            int w = StyleBox.MeasureSpaced(head, fs, spacing);
            if (w <= targetW) {
                best = cur;
                low = mid + 1;
            } else {
                high = cur - 1;
            }
        }
        if (best <= 0) { return "..."; }
        return s.Substring(0, best) + "...";
    }
}
