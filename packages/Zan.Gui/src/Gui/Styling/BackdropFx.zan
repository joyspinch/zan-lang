using System;
namespace Gui;
public class BackdropFx {
    static List<int> damage;
    static int clipX;
    static int clipY;
    static int clipR;
    static int clipB;
    static int[] s_sinQuarter = new int[] {
        0, 174, 342, 500, 643,
        766, 866, 940, 985, 1000 };
    static List<int> TakeDamage() {
        List<int> d = BackdropFx.damage;
        /* 首帧先于任何 Mark 到来时 damage 还是 null（wasm 的首帧
         * FxPresent 早于第一笔带记录的绘制），调用方直接 .Count 会
         * 空引用——"取走并清空"的契约是空列表，不是 null。 */
        if (d == null) { d = new List<int>(); }
        BackdropFx.damage = new List<int>();
        return d;
    }
    static void Mark(int x, int y, int w, int h) {
        if (BackdropFx.damage == null) { BackdropFx.damage = new List<int>(); }
        int x0 = x;
        int y0 = y;
        int x1 = x + w;
        int y1 = y + h;
        if (x0 < BackdropFx.clipX) { x0 = BackdropFx.clipX; }
        if (y0 < BackdropFx.clipY) { y0 = BackdropFx.clipY; }
        if (x1 > BackdropFx.clipR) { x1 = BackdropFx.clipR; }
        if (y1 > BackdropFx.clipB) { y1 = BackdropFx.clipB; }
        if (x1 <= x0 || y1 <= y0) { return; }
        BackdropFx.damage.Add(x0);
        BackdropFx.damage.Add(y0);
        BackdropFx.damage.Add(x1 - x0);
        BackdropFx.damage.Add(y1 - y0);
    }
    static bool IsDarkTheme(Theme t) {
        if (t == null) { return false; }
        int bg = t.bgPrimary;
        int r = (bg >> 16) & 255;
        int g = (bg >> 8) & 255;
        int b = bg & 255;
        return r * 3 + g * 6 + b < 1280;
    }
    static int Argb(int color, int alpha) {
        if (alpha <= 0) { return 0; }
        if (alpha > 255) { alpha = 255; }
        return (alpha << 24) | (color & 0xFFFFFF);
    }
    static void FR(Canvas c, int x, int y, int w, int h, int color) {
        if (w <= 0 || h <= 0) { return; }
        BackdropFx.Mark(x, y, w, h);
        c.FillRect(x, y, w, h, color);
    }
    static void VG(Canvas c, int x, int y, int w, int h, int topCol, int botCol) {
        if (w <= 0 || h <= 0) { return; }
        BackdropFx.Mark(x, y, w, h);
        c.FillVGrad(x, y, w, h, topCol, botCol);
    }
    static void FC(Canvas c, int cx, int cy, int r, int color) {
        if (r <= 0) { return; }
        BackdropFx.Mark(cx - r - 2, cy - r - 2, r * 2 + 4, r * 2 + 4);
        c.FillCircle(cx, cy, r, color);
    }
    static void RAD(Canvas c, int cx, int cy, int r, int rgb, int innerAlpha) {
        if (r <= 0 || innerAlpha <= 0) { return; }
        if (innerAlpha > 255) { innerAlpha = 255; }
        BackdropFx.Mark(cx - r - 2, cy - r - 2, r * 2 + 4, r * 2 + 4);
        c.FillRadial(cx, cy, r, rgb & 0xFFFFFF, innerAlpha);
    }
    static void RING(Canvas c, int cx, int cy, int r, int color, int thick) {
        if (r <= 0 || thick <= 0) { return; }
        int pad = r + thick + 2;
        BackdropFx.Mark(cx - pad, cy - pad, pad * 2, pad * 2);
        c.DrawCircle(cx, cy, r, color, thick);
    }
    static void ARC(Canvas c, int cx, int cy, int rIn, int rOut,
                    int a0, int a1, int color, int thick) {
        if (rOut <= 0 || thick <= 0) { return; }
        int pad = rOut + thick + 2;
        BackdropFx.Mark(cx - pad, cy - pad, pad * 2, pad * 2);
        c.DrawArc(cx, cy, rIn, rOut, a0, a1, color, thick);
    }
    static void FL(Canvas c, int x0, int y0, int x1, int y1, int color, int thick) {
        if (thick <= 0 || (x0 == x1 && y0 == y1)) { return; }
        int pad = thick + 4;
        int lx = x0 < x1 ? x0 : x1;
        int ly = y0 < y1 ? y0 : y1;
        int rx = x0 > x1 ? x0 : x1;
        int ry = y0 > y1 ? y0 : y1;
        BackdropFx.Mark(lx - pad, ly - pad, rx - lx + pad * 2, ry - ly + pad * 2);
        c.DrawLine(x0, y0, x1, y1, color, thick);
    }
    static void DT(Canvas c, int x, int y, string s, int color, int fs) {
        BackdropFx.Mark(x - 1, y - 1, fs + 4, fs * 3 / 2 + 4);
        c.DrawText(x, y, s, color, fs);
    }
    static int KindStars()     { return 1; }
    static int KindAurora()    { return 2; }
    static int KindLightfall() { return 3; }
    static int KindInk()       { return 4; }
    static int KindPetals()    { return 5; }
    static int KindRain()      { return 6; }
    static int KindBokeh()     { return 7; }
    static int KindMesh()      { return 8; }
    static int KindFortune()   { return 9; }
    static int KindDarkGold()  { return 10; }
    static int KindDreamy()    { return 11; }
    static int IntervalMs(int kind) {
        if (kind == BackdropFx.KindLightfall()) { return 33; }
        if (kind == BackdropFx.KindMesh())      { return 36; }
        if (kind == BackdropFx.KindBokeh())     { return 40; }
        if (kind == BackdropFx.KindAurora())    { return 40; }
        if (kind == BackdropFx.KindDarkGold())  { return 40; }
        if (kind == BackdropFx.KindDreamy())    { return 40; }
        if (kind == BackdropFx.KindRain())      { return 50; }
        if (kind == BackdropFx.KindPetals())    { return 45; }
        if (kind == BackdropFx.KindFortune())   { return 50; }
        if (kind == BackdropFx.KindInk())       { return 70; }
        return 50;
    }
    static int Hash(int i, int salt) {
        int h = i * 374761393 + salt * 668265263;
        h = (h / 8192 + h) % 2147483647;
        if (h < 0) { h = -h; }
        return h;
    }
    static int Sin1000(int deg) {
        int d = deg % 360;
        if (d < 0) { d = d + 360; }
        int sign = 1;
        if (d >= 180) { d = d - 180; sign = -1; }
        if (d > 90) { d = 180 - d; }
        int idx = d / 10;
        int frac = d - idx * 10;
        int a = s_sinQuarter[idx];
        int b = 1000;
        if (idx < 9) { b = s_sinQuarter[idx + 1]; }
        return sign * (a + (b - a) * frac / 10);
    }
    static void PaintFx(StyleHost app, Canvas c, int kind, int x, int y, int w, int h,
                        int now, Theme t, int dpi) {
        if (c == null || w <= 0 || h <= 0) { return; }
        if (dpi <= 0) { dpi = 100; }
        if (BackdropFx.damage == null) {
            BackdropFx.damage = new List<int>();
        } else {
            BackdropFx.damage.Clear();
        }
        BackdropFx.clipX = x;
        BackdropFx.clipY = y;
        BackdropFx.clipR = x + w;
        BackdropFx.clipB = y + h;
        c.PushClip(x, y, w, h);
        if (kind == BackdropFx.KindStars()) {
            int star = Style.Part(app, "effects", "star", "", "", "",
                                  Style.SNormal()).FgOr(0);
            BackdropFx.Stars(c, x, y, w, h, now, star, dpi);
        }
        if (kind == BackdropFx.KindAurora())    { BackdropFx.Aurora(c, x, y, w, h, now, dpi); }
        if (kind == BackdropFx.KindLightfall()) {
            int particleA = Style.Part(app, "effects", "particle", "", "a", "",
                                       Style.SNormal()).FgOr(0);
            int particleB = Style.Part(app, "effects", "particle", "", "b", "",
                                       Style.SNormal()).FgOr(0);
            int particleC = Style.Part(app, "effects", "particle", "", "c", "",
                                       Style.SNormal()).FgOr(0);
            BackdropFx.Lightfall(c, x, y, w, h, now, particleA, particleB,
                                 particleC, dpi);
        }
        if (kind == BackdropFx.KindInk())       { BackdropFx.Ink(c, x, y, w, h, now, dpi); }
        if (kind == BackdropFx.KindPetals())    { BackdropFx.Petals(c, x, y, w, h, now, t, dpi); }
        if (kind == BackdropFx.KindFortune())   { BackdropFx.Fortune(c, x, y, w, h, now, dpi); }
        if (kind == BackdropFx.KindDarkGold())  { BackdropFx.DarkGold(c, x, y, w, h, now, dpi); }
        if (kind == BackdropFx.KindDreamy())    { BackdropFx.Dreamy(c, x, y, w, h, now, dpi); }
        if (kind == BackdropFx.KindRain())      { BackdropFx.Rain(c, x, y, w, h, now, t, dpi); }
        if (kind == BackdropFx.KindBokeh()) {
            int bokehA = Style.Part(app, "effects", "bokeh", "", "a", "",
                                    Style.SNormal()).FgOr(0);
            int bokehB = Style.Part(app, "effects", "bokeh", "", "b", "",
                                    Style.SNormal()).FgOr(0);
            int bokehC = Style.Part(app, "effects", "bokeh", "", "c", "",
                                    Style.SNormal()).FgOr(0);
            bool dark = BackdropFx.IsDarkTheme(t);
            BackdropFx.Bokeh(c, x, y, w, h, now, bokehA, bokehB, bokehC, dark, dpi);
        }
        if (kind == BackdropFx.KindMesh()) {
            int meshA = Style.Part(app, "effects", "mesh", "", "a", "",
                                   Style.SNormal()).FgOr(0);
            int meshB = Style.Part(app, "effects", "mesh", "", "b", "",
                                   Style.SNormal()).FgOr(0);
            bool dark = BackdropFx.IsDarkTheme(t);
            BackdropFx.Mesh(c, x, y, w, h, now, meshA, meshB, dark, dpi);
        }
        c.PopClip();
    }
    static int StepMod(int baseVal, int now, int spd, int span) {
        if (span <= 0) { return 0; }
        long v = (long)baseVal + ((long)now * (long)spd) / 1000L;
        long m = v % (long)span;
        if (m < 0L) { m = m + (long)span; }
        return (int)m;
    }
    static int Px(int v, int dpi) {
        if (dpi <= 0) { dpi = 100; }
        int r = v * dpi / 100;
        if (r < 1) { r = 1; }
        return r;
    }
    static void Stars(Canvas c, int x, int y, int w, int h, int now,
                      int color, int dpi) {
        int hi = (color != 0 ? color : 0xDCEAFF) & 0xFFFFFF;
        int n = 76;
        for (int i = 0; i < n; i = i + 1) {
            int hx = BackdropFx.Hash(i, 11);
            int hy = BackdropFx.Hash(i, 23);
            int spd = 5 + hx % 9;
            int px = x + BackdropFx.StepMod(hx, now, 3, w);
            int py = y + BackdropFx.StepMod(hy, now, spd, h);
            int tw = BackdropFx.Sin1000(now / 9 + hx % 360);
            int alpha = 110 + tw * 105 / 1000;
            int size = 1 + hy % 2;
            if (dpi > 140) { size = size + 1; }
            BackdropFx.FR(c, px, py, size, size, BackdropFx.Argb(hi, alpha));
            if (i % 7 == 0) {
                int r = BackdropFx.Px(6, dpi) + (tw > 0 ? tw * BackdropFx.Px(4, dpi) / 1000 : 0);
                BackdropFx.RAD(c, px, py, r, hi, 48 + tw * 24 / 1000);
            }
        }
        // Periodic deep-space meteor streak
        int cycle = 4200;
        int mPhase = now % cycle;
        if (mPhase < 0) { mPhase = mPhase + cycle; }
        if (mPhase < 950) {
            int idx = (now / cycle) & 7;
            int sx = x + w * (18 + (idx * 23) % 62) / 100;
            int sy = y + h * (8 + (idx * 17) % 28) / 100;
            int dist = BackdropFx.Px(220, dpi) * mPhase / 950;
            int ex = sx + dist;
            int ey = sy + dist * 45 / 100;
            int tail = BackdropFx.Px(78, dpi);
            int tx = ex - tail;
            int ty = ey - tail * 45 / 100;
            int fade = mPhase < 200 ? mPhase * 255 / 200 : (950 - mPhase) * 255 / 750;
            BackdropFx.FL(c, tx, ty, ex, ey, BackdropFx.Argb(hi, fade * 35 / 100), BackdropFx.Px(4, dpi));
            BackdropFx.FL(c, (tx + ex) / 2, (ty + ey) / 2, ex, ey, BackdropFx.Argb(0xFFFFFF, fade * 75 / 100), BackdropFx.Px(2, dpi));
            BackdropFx.RAD(c, ex, ey, BackdropFx.Px(9, dpi), 0xFFFFFF, fade * 55 / 100);
        }
    }
    static void Aurora(Canvas c, int x, int y, int w, int h, int now, int dpi) {
        // Three sweeping multi-wave northern-lights silk curtains spanning full viewport width
        int segs = 24;
        int rBase = BackdropFx.Px(96, dpi);
        int amp1 = h * 11 / 100;
        int amp2 = h * 6 / 100;
        if (amp1 < BackdropFx.Px(28, dpi)) { amp1 = BackdropFx.Px(28, dpi); }
        for (int band = 0; band < 3; band = band + 1) {
            int rgb = band == 0 ? Theme.Rgb(0, 245, 165)
                : (band == 1 ? Theme.Rgb(24, 214, 255) : Theme.Rgb(168, 92, 255));
            int baseY = y + h * (22 + band * 16) / 100;
            int spd = band == 0 ? 14 : (band == 1 ? 19 : 24);
            int prevX = 0;
            int prevY = 0;
            for (int s = 0; s <= segs; s = s + 1) {
                int px = x + s * w / segs;
                int w1 = BackdropFx.Sin1000(s * 17 + now / spd + band * 115);
                int w2 = BackdropFx.Sin1000(s * 31 - now / (spd + 7) + band * 70);
                int py = baseY + w1 * amp1 / 1000 + w2 * amp2 / 1000;
                if (s % 2 == 0) {
                    int breath = 54 + (w1 + 1000) * 28 / 2000;
                    if (band == 2) { breath = breath * 82 / 100; }
                    int rad = rBase + (w2 + 1000) * BackdropFx.Px(24, dpi) / 2000;
                    BackdropFx.RAD(c, px, py, rad, rgb, breath);
                    // Soft feathered radial aurora curtain plumes rising above wave crests
                    if (w1 > 120 && s > 0 && s < segs) {
                        int plumeA = 18 + (w1 - 120) * 26 / 880;
                        int pr1 = BackdropFx.Px(46, dpi);
                        int pr2 = BackdropFx.Px(34, dpi);
                        BackdropFx.RAD(c, px, py - BackdropFx.Px(36, dpi), pr1, rgb, plumeA);
                        BackdropFx.RAD(c, px, py - BackdropFx.Px(74, dpi), pr2, rgb, plumeA * 65 / 100);
                    }
                }
                if (s > 0) {
                    BackdropFx.FL(c, prevX, prevY, px, py,
                        BackdropFx.Argb(rgb, 56), BackdropFx.Px(4, dpi));
                    BackdropFx.FL(c, prevX, prevY, px, py,
                        BackdropFx.Argb(0xFFFFFF, 34), BackdropFx.Px(1, dpi));
                }
                prevX = px;
                prevY = py;
            }
        }
    }
    static void Lightfall(Canvas c, int x, int y, int w, int h, int now,
                          int colorA, int colorB, int colorC, int dpi) {
        // Diagonal prismatic laser rays with layered glow + white-hot core + starburst head
        int cA = colorA != 0 ? colorA : 0x00F0FF;
        int cB = colorB != 0 ? colorB : 0xFF2E97;
        int cC = colorC != 0 ? colorC : 0xA78BFA;
        int n = 12;
        int slantX = w * 32 / 100;
        for (int i = 0; i < n; i = i + 1) {
            int hx = BackdropFx.Hash(i, 41);
            int hy = BackdropFx.Hash(i, 57);
            int len = BackdropFx.Px(130 + hy % 170, dpi);
            int spd = 190 + hx % 180;
            int span = h + len + BackdropFx.Px(80, dpi);
            int progress = BackdropFx.StepMod(hy, now, spd, span);
            int headY = y + progress - BackdropFx.Px(40, dpi);
            int startX = x - slantX / 2 + hx % (w + slantX);
            int headX = startX + progress * 48 / 100;
            int tailY = headY - len;
            int tailX = headX - len * 48 / 100;
            int col = i % 3 == 0 ? cA : (i % 3 == 1 ? cB : cC);
            int outerW = BackdropFx.Px(8, dpi);
            int midW = BackdropFx.Px(3, dpi);
            int coreW = BackdropFx.Px(1, dpi);
            // Outer bloom + bright beam + hot specular core
            BackdropFx.FL(c, tailX, tailY, headX, headY, BackdropFx.Argb(col, 34), outerW);
            BackdropFx.FL(c, (tailX + headX) / 2, (tailY + headY) / 2, headX, headY,
                BackdropFx.Argb(col, 118), midW);
            BackdropFx.FL(c, (tailX + headX * 2) / 3, (tailY + headY * 2) / 3, headX, headY,
                BackdropFx.Argb(0xFFFFFF, 195), coreW);
            // Starburst head flare
            BackdropFx.RAD(c, headX, headY, BackdropFx.Px(16, dpi), col, 95);
            BackdropFx.FC(c, headX, headY, BackdropFx.Px(2, dpi), BackdropFx.Argb(0xFFFFFF, 220));
        }
    }
    static void Ink(Canvas c, int x, int y, int w, int h, int now, int dpi) {
        int r = BackdropFx.Px(120, dpi);
        int n = 4;
        for (int i = 0; i < n; i = i + 1) {
            int hx = BackdropFx.Hash(i, 71);
            int span = w + r * 2;
            int cx = x + BackdropFx.StepMod(hx, now, 6 + i * 3, span) - r;
            int cy = y + h * (18 + i * 22) / 100
                   + BackdropFx.Sin1000(now / 40 + i * 90) * BackdropFx.Px(12, dpi) / 1000;
            BackdropFx.Mark(cx - r - 1, cy - r - 1, r * 2 + 2, r * 2 + 2);
            c.FillRadial(cx, cy, r, Theme.Rgb(70, 62, 52), 34);
        }
    }
    static void Petals(Canvas c, int x, int y, int w, int h, int now,
                       Theme t, int dpi) {
        int n = 26;
        for (int i = 0; i < n; i = i + 1) {
            int hx = BackdropFx.Hash(i, 83);
            int hy = BackdropFx.Hash(i, 97);
            int spd = 28 + hx % 34;  // 下落速度 px/s
            int margin = BackdropFx.Px(24, dpi);
            int span = h + margin * 2;
            int py = y + BackdropFx.StepMod(hy, now, spd, span) - margin;
            int sway = BackdropFx.Sin1000(now / 9 + hx % 360)
                     * BackdropFx.Px(16, dpi) / 1000;
            int px = x + hx % w + sway;
            int r = BackdropFx.Px(3, dpi) + hy % 4;
            int spin = BackdropFx.Sin1000(now / 6 + hy % 360) * r / 1000;
            BackdropFx.FC(c, px, py, r, Theme.Rgba(238, 140, 170, 170));
            BackdropFx.FC(c, px + spin + 1, py + 1, r - 1, Theme.Rgba(252, 190, 208, 190));
        }
    }
    static void BokehOrb(Canvas c, int cx, int cy, int r, int color, bool dark, int dpi) {
        int rgb = color & 0xFFFFFF;
        int bloomAlpha = dark ? 62 : 48;
        int discAlpha = dark ? 18 : 22;
        int rimAlpha = dark ? 30 : 38;
        int rimW = BackdropFx.Px(1, dpi);
        // Dreamy optical lens bokeh: wide soft aura + translucent lens disc + delicate rim
        BackdropFx.RAD(c, cx, cy, r * 125 / 100, rgb, bloomAlpha);
        BackdropFx.FC(c, cx, cy, r * 72 / 100, BackdropFx.Argb(rgb, discAlpha));
        BackdropFx.RING(c, cx, cy, r * 74 / 100, BackdropFx.Argb(0xFFFFFF, rimAlpha), rimW);
    }
    static void Bokeh(Canvas c, int x, int y, int w, int h, int now,
                      int colorA, int colorB, int colorC, bool dark, int dpi) {
        int cA = colorA != 0 ? colorA : (dark ? 0x38B6FF : 0x38BDF8);
        int cB = colorB != 0 ? colorB : (dark ? 0xC06CFF : 0xA78BFA);
        int cC = colorC != 0 ? colorC : (dark ? 0xFF7EB6 : 0xFFFFFF);
        // 1. Living diagonal glass specular sheen sweep gliding smoothly across the viewport
        int sweepSpan = w + h + BackdropFx.Px(260, dpi);
        int sx = x - h * 45 / 100 + BackdropFx.StepMod(w / 2, now, 170, sweepSpan) - BackdropFx.Px(130, dpi);
        int slant = h * 58 / 100;
        int sheenRgb = dark ? 0xB8E2FF : 0xFFFFFF;
        BackdropFx.FL(c, sx, y + h, sx + slant, y,
            BackdropFx.Argb(sheenRgb, dark ? 18 : 30), BackdropFx.Px(66, dpi));
        BackdropFx.FL(c, sx + BackdropFx.Px(12, dpi), y + h,
            sx + slant + BackdropFx.Px(12, dpi), y,
            BackdropFx.Argb(sheenRgb, dark ? 30 : 48), BackdropFx.Px(22, dpi));
        BackdropFx.FL(c, sx + BackdropFx.Px(18, dpi), y + h,
            sx + slant + BackdropFx.Px(18, dpi), y,
            BackdropFx.Argb(0xFFFFFF, dark ? 56 : 86), BackdropFx.Px(4, dpi));
        // Secondary subtle counter-prism sheen band
        int sx2 = x - h * 45 / 100 + BackdropFx.StepMod(w + BackdropFx.Px(120, dpi), now, 115, sweepSpan) - BackdropFx.Px(130, dpi);
        BackdropFx.FL(c, sx2, y + h, sx2 + slant, y,
            BackdropFx.Argb(cB, dark ? 16 : 18), BackdropFx.Px(42, dpi));
        // 2. Soft floating optical bokeh light pools
        int n = 13;
        for (int i = 0; i < n; i = i + 1) {
            int hx = BackdropFx.Hash(i, 151);
            int hy = BackdropFx.Hash(i, 167);
            int r = BackdropFx.Px(18, dpi) + hy % BackdropFx.Px(38, dpi);
            int spd = 16 + hx % 24;
            int span = h + r * 2;
            int py = y + h + r - BackdropFx.StepMod(hy, now, spd, span);
            int sway = BackdropFx.Sin1000(now / 15 + hx % 360)
                     * BackdropFx.Px(28, dpi) / 1000;
            int px = x + hx % w + sway;
            int col = i % 3 == 0 ? cA : (i % 3 == 1 ? cB : cC);
            BackdropFx.BokehOrb(c, px, py, r, col, dark, dpi);
        }
    }
    static void Mesh(Canvas c, int x, int y, int w, int h, int now,
                     int colorA, int colorB, bool dark, int dpi) {
        int cell = BackdropFx.Px(64, dpi);
        int lw = BackdropFx.Px(1, dpi);
        int offx = BackdropFx.StepMod(0, now, 18, cell);
        int offy = BackdropFx.StepMod(0, now, 12, cell);
        int rgbP = (colorA != 0 ? colorA : 0x00F5FF) & 0xFFFFFF;
        int rgbI = (colorB != 0 ? colorB : 0xFF2A85) & 0xFFFFFF;
        int gridA = dark ? 34 : 26;
        int cols = w / cell + 2;
        int rows = h / cell + 2;
        // 1. Glowing tactical cyber neon grid
        for (int ci = 0; ci < cols; ci = ci + 1) {
            int gx = x + ci * cell - cell + offx;
            if (gx >= x && gx < x + w) {
                BackdropFx.FR(c, gx, y, lw, h, BackdropFx.Argb(rgbP, gridA));
            }
        }
        for (int ri = 0; ri < rows; ri = ri + 1) {
            int gy = y + ri * cell - cell + offy;
            if (gy >= y && gy < y + h) {
                BackdropFx.FR(c, x, gy, w, lw, BackdropFx.Argb(rgbP, gridA));
            }
        }
        // 2. Sweeping full-width neon laser scanline beam with luminous trailing gradient
        int scanH = BackdropFx.Px(46, dpi);
        int scanSpan = h + scanH * 2;
        int scanY = y - scanH + BackdropFx.StepMod(0, now, 125, scanSpan);
        BackdropFx.VG(c, x, scanY - scanH, w, scanH,
            BackdropFx.Argb(rgbP, 0), BackdropFx.Argb(rgbP, dark ? 52 : 36));
        BackdropFx.FR(c, x, scanY, w, BackdropFx.Px(2, dpi),
            BackdropFx.Argb(rgbP, dark ? 168 : 130));
        BackdropFx.FR(c, x, scanY, w, BackdropFx.Px(1, dpi),
            BackdropFx.Argb(0xFFFFFF, dark ? 140 : 100));
        // 3. High-speed horizontal neon energy pulses racing along grid tracks
        for (int p = 0; p < 5; p = p + 1) {
            int hp = BackdropFx.Hash(p, 199);
            int trackRow = (hp % rows);
            int py = y + trackRow * cell - cell + offy;
            if (py >= y && py < y + h) {
                int pLen = BackdropFx.Px(68 + (hp % 56), dpi);
                int pSpd = 210 + (hp % 150);
                int px = x - pLen + BackdropFx.StepMod(hp, now, pSpd, w + pLen * 2);
                int col = p % 2 == 0 ? rgbP : rgbI;
                BackdropFx.FL(c, px, py, px + pLen, py, BackdropFx.Argb(col, 65), BackdropFx.Px(3, dpi));
                BackdropFx.FL(c, px + pLen / 2, py, px + pLen, py, BackdropFx.Argb(0xFFFFFF, 165), BackdropFx.Px(1, dpi));
                BackdropFx.RAD(c, px + pLen, py, BackdropFx.Px(10, dpi), col, 115);
            }
        }
        // 4. Pulsing neon intersection crosshairs + energy nodes
        int arm = BackdropFx.Px(5, dpi);
        for (int i = 0; i < 18; i = i + 1) {
            int hc = BackdropFx.Hash(i, 181);
            int nx = x + (hc % cols) * cell - cell + offx;
            int ny = y + ((hc / 7) % rows) * cell - cell + offy;
            if (nx >= x && nx < x + w && ny >= y && ny < y + h) {
                int pulse = BackdropFx.Sin1000(now / 6 + hc % 360);
                int alpha = 85 + pulse * 65 / 1000;
                if (alpha < 25) { alpha = 25; }
                int rgb = (i % 2 == 1) ? rgbI : rgbP;
                BackdropFx.RAD(c, nx, ny, BackdropFx.Px(11, dpi), rgb, alpha * 65 / 100);
                BackdropFx.FR(c, nx - arm, ny, arm * 2 + 1, lw, BackdropFx.Argb(rgb, alpha));
                BackdropFx.FR(c, nx, ny - arm, lw, arm * 2 + 1, BackdropFx.Argb(rgb, alpha));
                BackdropFx.FC(c, nx, ny, BackdropFx.Px(2, dpi), BackdropFx.Argb(0xFFFFFF, alpha));
            }
        }
    }
    static void Rain(Canvas c, int x, int y, int w, int h, int now,
                     Theme t, int dpi) {
        List<string> glyphs = new List<string>{
            "0", "1", "7", "2",
            "X", "Z", "$", "#",
            "K", "R", "+", "=",
            "<", ">", "|", "*" };
        int colw = BackdropFx.Px(18, dpi);
        int rowh = BackdropFx.Px(16, dpi);
        int cols = w / colw;
        if (cols < 1) { cols = 1; }
        int rows = h / rowh + 1;
        int trail = 8;
        int fs = BackdropFx.Px(12, dpi);
        for (int col = 0; col < cols; col = col + 1) {
            int hc = BackdropFx.Hash(col, 113);
            if (hc % 3 != 0) {
                int spd = 5 + hc % 8;  // 行/秒
                int cycle = rows + trail;
                int head = BackdropFx.StepMod(hc, now, spd, cycle);
                for (int k = 0; k < trail; k = k + 1) {
                    int row = head - k;
                    if (row >= 0 && row < rows) {
                        int gi = BackdropFx.Hash(col * 131 + row, 127) % glyphs.Count;
                        int alpha = 150;
                        if (k > 0) { alpha = 80 - k * 9; }
                        BackdropFx.DT(c, x + col * colw, y + row * rowh,
                                      glyphs[gi], Theme.Rgba(57, 255, 90, alpha), fs);
                    }
                }
            }
        }
    }
    static void Fortune(Canvas c, int x, int y, int w, int h, int now, int dpi) {
        int n = 7;
        for (int i = 0; i < n; i = i + 1) {
            int hx = BackdropFx.Hash(i, 211);
            int hy = BackdropFx.Hash(i, 233);
            int r = BackdropFx.Px(16, dpi) + hy % BackdropFx.Px(14, dpi);
            int span = w + r * 8;
            int spd = 8 + hx % 10;
            int px = x - r * 4 + BackdropFx.StepMod(hx, now, spd, span);
            int ySpan = h * 2 / 3;
            if (ySpan <= 0) { ySpan = 1; }
            int py = y + BackdropFx.Px(30, dpi) + hy % ySpan;
            int tint = Theme.Rgba(255, 226, 168, 34);
            BackdropFx.FC(c, px, py, r, tint);
            BackdropFx.FC(c, px + r, py + r / 3, r * 3 / 4, tint);
            BackdropFx.FC(c, px - r, py + r / 3, r * 2 / 3, tint);
        }
        int m = 14;
        for (int j = 0; j < m; j = j + 1) {
            int hx = BackdropFx.Hash(j, 307);
            int hy = BackdropFx.Hash(j, 331);
            int r = BackdropFx.Px(4, dpi) + hy % 4;
            int spd = 34 + hx % 40;
            int margin = BackdropFx.Px(20, dpi);
            int span = h + margin * 2;
            int py = y + BackdropFx.StepMod(hy, now, spd, span) - margin;
            int px = x + hx % w
                   + BackdropFx.Sin1000(now / 10 + hx % 360) * BackdropFx.Px(10, dpi) / 1000;
            int squash = BackdropFx.Sin1000(now / 4 + hy % 360);
            int rr = r * (400 + squash * 6 / 10) / 1000;
            if (rr < 1) { rr = 1; }
            BackdropFx.FC(c, px, py, r, Theme.Rgba(224, 164, 32, 120));
            BackdropFx.FC(c, px, py, rr, Theme.Rgba(255, 226, 130, 170));
        }
    }
    static void DarkGold(Canvas c, int x, int y, int w, int h, int now, int dpi) {
        // 1. Luxury horology brushed champagne-gold diagonal metallic sweep
        int sweepSpan = w + h + BackdropFx.Px(300, dpi);
        int sx = x - h * 45 / 100 + BackdropFx.StepMod(w / 2, now, 125, sweepSpan) - BackdropFx.Px(150, dpi);
        int slant = h * 55 / 100;
        BackdropFx.FL(c, sx, y + h, sx + slant, y,
            Theme.Rgba(212, 162, 68, 24), BackdropFx.Px(74, dpi));
        BackdropFx.FL(c, sx + BackdropFx.Px(16, dpi), y + h,
            sx + slant + BackdropFx.Px(16, dpi), y,
            Theme.Rgba(248, 214, 128, 40), BackdropFx.Px(22, dpi));
        BackdropFx.FL(c, sx + BackdropFx.Px(22, dpi), y + h,
            sx + slant + BackdropFx.Px(22, dpi), y,
            Theme.Rgba(255, 244, 206, 68), BackdropFx.Px(3, dpi));
        // 2. Warm breathing molten-gold horizon glow
        int glowH = BackdropFx.Px(110, dpi);
        int breath = 38 + BackdropFx.Sin1000(now / 20) * 14 / 1000;
        BackdropFx.VG(c, x, y + h - glowH, w, glowH,
            Theme.Rgba(210, 148, 42, 0), Theme.Rgba(210, 148, 42, breath));
        // 3. Rising champagne-gold dust embers & 4-point diamond glints
        int n = 36;
        for (int i = 0; i < n; i = i + 1) {
            int hx = BackdropFx.Hash(i, 419);
            int hy = BackdropFx.Hash(i, 431);
            int spd = 30 + hx % 52;
            int margin = BackdropFx.Px(18, dpi);
            int span = h + margin * 2;
            int py = y + h + margin - BackdropFx.StepMod(hy, now, spd, span);
            int drift = BackdropFx.Sin1000(now / 11 + hx % 360)
                      * BackdropFx.Px(18, dpi) / 1000;
            int px = x + hx % w + drift;
            int r = BackdropFx.Px(2, dpi) + hy % 3;
            int life = (py - y) * 100 / h;
            if (life < 0) { life = 0; }
            if (life > 100) { life = 100; }
            int tw = BackdropFx.Sin1000(now / 7 + hx % 360);
            int alpha = 65 + life * 145 / 100 + tw * 35 / 1000;
            if (alpha < 20) { alpha = 20; }
            if (alpha > 240) { alpha = 240; }
            BackdropFx.RAD(c, px, py, r * 4, Theme.Rgb(235, 168, 52), alpha * 48 / 100);
            BackdropFx.FC(c, px, py, r, Theme.Rgba(255, 224, 138, alpha));
            if (i % 6 == 0 && tw > 250) {
                int arm = r * 4;
                BackdropFx.FR(c, px - arm, py, arm * 2 + 1, 1, Theme.Rgba(255, 245, 210, alpha * 75 / 100));
                BackdropFx.FR(c, px, py - arm, 1, arm * 2 + 1, Theme.Rgba(255, 245, 210, alpha * 75 / 100));
            }
        }
    }
    static void Dreamy(Canvas c, int x, int y, int w, int h, int now, int dpi) {
        // 1. Drifting ethereal pastel nebula clouds (lavender / periwinkle / rose-pearl)
        int nebR = BackdropFx.Px(170, dpi);
        for (int k = 0; k < 4; k = k + 1) {
            int cx = x + w * (18 + k * 22) / 100
                   + BackdropFx.Sin1000(now / (18 + k * 5) + k * 95) * (w / 10) / 1000;
            int cy = y + h * (26 + (k * 31) % 48) / 100
                   + BackdropFx.Sin1000(now / (22 + k * 4) + 70 + k * 65) * (h / 10) / 1000;
            int rgb = k == 0 ? Theme.Rgb(196, 152, 255)
                : (k == 1 ? Theme.Rgb(128, 198, 255)
                : (k == 2 ? Theme.Rgb(246, 162, 216) : Theme.Rgb(166, 180, 255)));
            int na = 38 + (BackdropFx.Sin1000(now / 15 + k * 80) + 1000) * 16 / 2000;
            BackdropFx.RAD(c, cx, cy, nebR, rgb, na);
        }
        // 2. Crisp twinkling 4-point diamond starlight flares
        int n = 44;
        for (int i = 0; i < n; i = i + 1) {
            int hx = BackdropFx.Hash(i, 521);
            int hy = BackdropFx.Hash(i, 541);
            int px = x + hx % w;
            int py = y + hy % h;
            int ph = BackdropFx.Sin1000(now / 5 + (hx + hy) % 360);
            if (ph < 0) { ph = 0; }
            int r = BackdropFx.Px(1, dpi) + ph * BackdropFx.Px(3, dpi) / 1000;
            int alpha = 60 + ph * 185 / 1000;
            BackdropFx.FC(c, px, py, r, Theme.Rgba(255, 252, 255, alpha));
            if (i % 4 == 0 && ph > 180) {
                int arm = r * 4 + BackdropFx.Px(3, dpi);
                BackdropFx.RAD(c, px, py, arm, Theme.Rgb(216, 196, 255), alpha * 38 / 100);
                BackdropFx.FR(c, px - arm, py, arm * 2 + 1, 1, Theme.Rgba(242, 232, 255, alpha * 80 / 100));
                BackdropFx.FR(c, px, py - arm, 1, arm * 2 + 1, Theme.Rgba(242, 232, 255, alpha * 80 / 100));
            }
        }
        // 3. Graceful shooting starlight meteors gliding diagonally across the nebula
        for (int m = 0; m < 2; m = m + 1) {
            int period = 3200 + m * 1100;
            int mp = (now + m * 1500) % period;
            if (mp < 0) { mp = mp + period; }
            if (mp < 1100) {
                int sx = x + w * (12 + m * 36) / 100;
                int sy = y + h * (10 + m * 18) / 100;
                int dist = BackdropFx.Px(260, dpi) * mp / 1100;
                int ex = sx + dist;
                int ey = sy + dist * 42 / 100;
                int tail = BackdropFx.Px(92, dpi);
                int tx = ex - tail;
                int ty = ey - tail * 42 / 100;
                int fade = mp < 220 ? mp * 255 / 220 : (1100 - mp) * 255 / 880;
                int mCol = m == 0 ? 0xD8B4FE : 0x93C5FD;
                BackdropFx.FL(c, tx, ty, ex, ey, BackdropFx.Argb(mCol, fade * 42 / 100), BackdropFx.Px(4, dpi));
                BackdropFx.FL(c, (tx + ex) / 2, (ty + ey) / 2, ex, ey, BackdropFx.Argb(0xFFFFFF, fade * 82 / 100), BackdropFx.Px(2, dpi));
                BackdropFx.RAD(c, ex, ey, BackdropFx.Px(12, dpi), mCol, fade * 62 / 100);
                BackdropFx.FC(c, ex, ey, BackdropFx.Px(2, dpi), BackdropFx.Argb(0xFFFFFF, fade));
            }
        }
    }
}
