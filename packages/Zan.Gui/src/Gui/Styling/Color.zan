using System;
namespace Gui;
struct Color {
    uint argb;
    static Color FromArgb(uint packed) {
        Color c = new Color();
        c.argb = packed;
        return c;
    }
    static Color Parse(string css) { return Color.FromArgb((uint)StyleSheet.ParseColor(css)); }
    static int ClampByte(int v) {
        if (v < 0) { return 0; }
        if (v > 255) { return 255; }
        return v;
    }
    static Color FromRGBA(int r, int g, int b, int a) {
        return Color.FromArgb(((uint)Color.ClampByte(a) << 24) | ((uint)Color.ClampByte(r) << 16) |
                              ((uint)Color.ClampByte(g) << 8) | (uint)Color.ClampByte(b));
    }
    static Color FromRGB(int r, int g, int b) {
        return Color.FromArgb((255u << 24) | ((uint)Color.ClampByte(r) << 16) |
                              ((uint)Color.ClampByte(g) << 8) | (uint)Color.ClampByte(b));
    }
    static Color FromHex(int hex) { return Color.FromArgb((uint)((hex & 16777215) | (255 << 24))); }
    static Color None() { return Color.FromArgb(0); }
    bool IsNone() { return argb == 0; }
    int A() { return (int)((argb >> 24) & 255); }
    int R() { return (int)((argb >> 16) & 255); }
    int G() { return (int)((argb >> 8) & 255); }
    int B() { return (int)(argb & 255); }
    Color WithAlpha(int a) { return Color.FromArgb((argb & 16777215u) | ((uint)Color.ClampByte(a) << 24)); }
    uint ToArgb() { return argb; }
    int ToARGB() { return (int)argb; }
    string ToCss() {
        string body = Color.Hex2(R()) + Color.Hex2(G()) + Color.Hex2(B());
        if (A() == 255) { return "#" + body; }
        return "#" + Color.Hex2(A()) + body;
    }
    static string[] hex2Table;
    static string Hex2(int v) {
        if (hex2Table == null) {
            string digits = "0123456789abcdef";
            hex2Table = new string[256];
            for (int i = 0; i < 256; i = i + 1) {
                hex2Table[i] = digits.Substring((i >> 4) & 15, 1) + digits.Substring(i & 15, 1);
            }
        }
        return hex2Table[v & 255];
    }
    static Color White() { return Color.FromRGB(255, 255, 255); }
    static Color Black() { return Color.FromRGB(0, 0, 0); }
    static Color Red() { return Color.FromRGB(208, 48, 80); }
    static Color Green() { return Color.FromRGB(24, 160, 88); }
    static Color Blue() { return Color.FromRGB(32, 128, 240); }
    static Color Yellow() { return Color.FromRGB(240, 160, 32); }
    static Color Gray() { return Color.FromRGB(128, 128, 128); }
}
