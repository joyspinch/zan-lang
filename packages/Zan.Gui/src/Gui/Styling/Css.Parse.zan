using System;
using System.Collections.Generic;
using Gui;
namespace Gui;
public partial class Css {
    static Dict<string, int> BuildVarIndex(List<CssVarDecl> vars) {
        if (vars == null || vars.Count == 0) { return null; }
        Dict<string, int> idx = new Dict<string, int>();
        for (int i = 0; i < vars.Count; i = i + 1) {
            string nm = vars[i].name;
            if (idx.ContainsKey(nm)) { idx[nm] = i; }
            else { idx.Add(nm, i); }
        }
        return idx;
    }
    static JsonValue ParseBlock(string body, List<CssVarDecl> vars) {
        return Css.ParseBlockWithSources(body, vars, 0);
    }
    static JsonValue ParseBlockWithSources(string body, List<CssVarDecl> vars,
                                           int externalCount) {
        return Css.ParseBlockIndexed(body, vars, Css.BuildVarIndex(vars), externalCount);
    }
    static JsonValue ParseBlockIndexed(string body, List<CssVarDecl> vars,
                                       Dict<string, int> varIdx, int externalCount) {
        JsonValue block = JsonValue.NewObject();
        JsonValue source = JsonValue.NewObject();
        JsonValue lengths = JsonValue.NewObject();
        JsonValue important = JsonValue.NewObject();
        JsonValue importantSource = JsonValue.NewObject();
        JsonValue importantLengths = JsonValue.NewObject();
        List<string> decls = Css.SplitTrim(body, ";");
        int i = 0;
        while (i < decls.Count) {
            string d = decls[i];
            i = i + 1;
            if (d.Length == 0) { continue; }
            int colon = Css.IndexFrom(d, ":", 0);
            if (colon <= 0) { continue; }
            string key = Css.Trim(d.Substring(0, colon));
            string val = Css.Trim(d.Substring(colon + 1, d.Length - colon - 1));
            if (key.Length == 0 || val.Length == 0) { continue; }
            if (key.Length > 2 && (key[0] & 255) == 45 && (key[1] & 255) == 45) { continue; }
            string lowerKey = Css.Lower(key);
            bool imp = Css.HasImportant(val);
            string plain;
            string resolved;
            if (val.IndexOf("var(") < 0) {
                plain = imp ? Css.StripImportant(val) : val;
                resolved = plain;
            } else {
                plain = Css.StripImportant(Css.ExpandVarsIndexed(val, vars, varIdx));
                if (externalCount <= 0 && plain.IndexOf("dpx") < 0) {
                    resolved = plain;
                } else {
                    resolved = Css.StripImportant(
                        Css.ExpandVarsWithSourcesIndexed(val, vars, varIdx, externalCount));
                }
            }
            bool physical = Css.IsPrescaledResolved(resolved);
            if (imp) {
                important.Set(lowerKey, JsonValue.NewStr(plain));
                importantSource.Set(lowerKey, JsonValue.NewBool(physical));
                importantLengths.Set(lowerKey, JsonValue.NewStr(resolved));
            } else if (important.Get(lowerKey) == null) {
                block.Set(lowerKey, JsonValue.NewStr(plain));
                source.Set(lowerKey, JsonValue.NewBool(physical));
                lengths.Set(lowerKey, JsonValue.NewStr(resolved));
            }
        }
        if (source.Count() > 0) {
            block.Set("__zan_prescaled", source);
            block.Set("__zan_lengths", lengths);
        }
        if (important.Count() > 0) {
            block.Set("__zan_important", important);
            block.Set("__zan_important_prescaled", importantSource);
            block.Set("__zan_important_lengths", importantLengths);
        }
        return block;
    }
    static bool IsPhysicalThemeMetric(string name) {
        return Css.StartsWithStr(name, "--font-size-")
            || Css.StartsWithStr(name, "--height-")
            || Css.StartsWithStr(name, "--padding-")
            || Css.StartsWithStr(name, "--button-pad-")
            || Css.StartsWithStr(name, "--input-pad-")
            || Css.StartsWithStr(name, "--theme-skin-")
            || Css.StartsWithStr(name, "--space-")
            || Css.StartsWithStr(name, "--gap-")
            || Css.StartsWithStr(name, "--radius-")
            || Css.StartsWithStr(name, "--icon-size-");
    }
    static string PhysicalMetric(string val) {
        string s = Css.Trim(val);
        if (s.EndsWith("px")) { s = s.Substring(0, s.Length - 2); }
        if (!StyleSheet.IsNumeric(s)) { return val; }
        for (int i = 0; i < s.Length; i = i + 1) {
            string ch = s.Substring(i, 1);
            if (!StyleSheet.Digit(ch) && ch != "." && ch != "-" && ch != "+") { return val; }
        }
        return s + "dpx";
    }
    static int LookupVarIndex(List<CssVarDecl> vars, Dict<string, int> varIdx, string name) {
        if (vars == null || vars.Count == 0) { return 0 - 1; }
        if (varIdx != null) {
            int found = 0 - 1;
            if (varIdx.TryGetValue(name, out found)) { return found; }
            return 0 - 1;
        }
        int last = 0 - 1;
        for (int i = 0; i < vars.Count; i = i + 1) {
            if (vars[i].name == name) { last = i; }
        }
        return last;
    }
    static string ExpandVarsWithSources(string val, List<CssVarDecl> vars,
                                         int externalCount) {
        return Css.ExpandVarsWithSourcesIndexed(val, vars, null, externalCount);
    }
    static string ExpandVarsWithSourcesIndexed(string val, List<CssVarDecl> vars,
                                                Dict<string, int> varIdx, int externalCount) {
        if (val == null) { return ""; }
        string s = val;
        for (int guard = 0; guard < 8; guard = guard + 1) {
            if (s.Length > 4096) { return s; }
            int at = Css.IndexFrom(s, "var(", 0);
            if (at < 0) { return s; }
            int close = Css.MatchParen(s, at + 3);
            if (close < 0) { return s; }
            string inner = Css.Trim(s.Substring(at + 4, close - at - 4));
            int comma = Css.TopComma(inner);
            string name = comma < 0 ? inner : Css.Trim(inner.Substring(0, comma));
            string fallback = comma < 0 ? "" : Css.Trim(
                inner.Substring(comma + 1, inner.Length - comma - 1));
            int found = Css.LookupVarIndex(vars, varIdx, name);
            string rep = found < 0 ? "" : vars[found].val;
            if (rep == null) { rep = ""; }
            if (name != "" && rep.IndexOf("var(" + name) >= 0) { rep = ""; }
            if (rep == "") { rep = fallback; }
            else if (found < externalCount && Css.IsPhysicalThemeMetric(name)) {
                rep = Css.PhysicalMetric(rep);
            }
            int tail = close + 1;
            if (rep.EndsWith("dpx") && tail + 2 <= s.Length
                    && s.Substring(tail, 2) == "px") { tail = tail + 2; }
            if (s.Length - (tail - at) + rep.Length > 4096) { return s; }
            s = s.Substring(0, at) + rep + s.Substring(tail, s.Length - tail);
        }
        return s;
    }
    static bool IsPrescaledResolved(string value) {
        if (value == null || !value.EndsWith("dpx")) { return false; }
        List<string> parts = StyleSheet.Tokens(value);
        return parts.Count == 1 && StyleSheet.IsNumeric(value);
    }
    static bool IsPrescaledValue(string val, List<CssVarDecl> vars, int externalCount) {
        return Css.IsPrescaledResolved(
            Css.StripImportant(Css.ExpandVarsWithSources(val, vars, externalCount)));
    }
    static int IndexOfImportant(string val) {
        if (val == null || val.IndexOf("!") < 0) { return 0 - 1; }
        return Css.IndexFrom(Css.Lower(val), "!important", 0);
    }
    static string StripImportant(string val) {
        if (val == null) { return ""; }
        int at = Css.IndexOfImportant(val);
        if (at < 0) { return val; }
        return Css.Trim(val.Substring(0, at));
    }
    static bool HasImportant(string val) { return Css.IndexOfImportant(val) >= 0; }
    static string Lower(string s) {
        if (s == null) { return ""; }
        return s.ToLower();
    }
    static string ImportantOf(JsonValue block, string k) {
        if (block == null) { return ""; }
        JsonValue imp = block.Get("__zan_important");
        if (imp == null || !imp.IsObject()) { return ""; }
        JsonValue v = imp.Get(k);
        if (v == null) { return ""; }
        return StyleSheet.ValStr(v);
    }
    static void MergeInto(StyleSheet sheet, string sel, JsonValue block) {
        JsonValue existing = sheet.rules.Get(sel);
        if (existing == null || !existing.IsObject()) {
            sheet.rules.Set(sel, block.Clone());
            return;
        }
        for (int j = 0; j < block.Count(); j = j + 1) {
            string key = block.KeyAt(j);
            if (Css.StartsWithStr(key, "__zan_")) {
                JsonValue oldObj = existing.Get(key);
                if (oldObj == null || !oldObj.IsObject()) {
                    oldObj = JsonValue.NewObject();
                    existing.Set(key, oldObj);
                }
                JsonValue newObj = block.ValAt(j);
                for (int k = 0; k < newObj.Count(); k = k + 1) {
                    oldObj.Set(newObj.KeyAt(k), newObj.ValAt(k));
                }
            } else {
                existing.Set(key, block.ValAt(j));
            }
        }
    }
    static List<CssVarDecl> CollectVarDecls(string s) {
        List<CssVarDecl> declsOut = new List<CssVarDecl>();
        if (s == null) { return declsOut; }
        int i = 0;
        while (i < s.Length) {
            int open = Css.IndexFrom(s, "{", i);
            if (open < 0) { return declsOut; }
            int close = Css.MatchBrace(s, open);
            if (close < 0) { return declsOut; }
            string sel = Css.Trim(s.Substring(i, open - i));
            string body = s.Substring(open + 1, close - open - 1);
            i = close + 1;
            if (sel != ":root") { continue; }
            List<string> decls = Css.SplitTrim(body, ";");
            int k = 0;
            while (k < decls.Count) {
                string d = decls[k];
                k = k + 1;
                int colon = Css.IndexFrom(d, ":", 0);
                if (colon <= 0) { continue; }
                string key = Css.Trim(d.Substring(0, colon));
                if (key.Length <= 2 || key.Substring(0, 2) != "--") { continue; }
                string val = Css.Trim(d.Substring(colon + 1, d.Length - colon - 1));
                declsOut.Add(new CssVarDecl(key, val));
            }
        }
        return declsOut;
    }
    static string ExpandVars(string val, List<CssVarDecl> vars) {
        return Css.ExpandVarsIndexed(val, vars, null);
    }
    static string ExpandVarsIndexed(string val, List<CssVarDecl> vars, Dict<string, int> varIdx) {
        if (val == null) { return ""; }
        string s = val;
        for (int guard = 0; guard < 8; guard = guard + 1) {
            if (s.Length > 4096) { return s; }
            int at = Css.IndexFrom(s, "var(", 0);
            if (at < 0) { return s; }
            int close = Css.MatchParen(s, at + 3);
            if (close < 0) { return s; }
            string inner = Css.Trim(s.Substring(at + 4, close - at - 4));
            int comma = Css.TopComma(inner);
            string name = inner;
            string fb = "";
            bool hasFb = false;
            if (comma >= 0) {
                name = Css.Trim(inner.Substring(0, comma));
                fb = Css.Trim(inner.Substring(
                    comma + 1, inner.Length - comma - 1));
                hasFb = true;
            }
            int foundIdx = Css.LookupVarIndex(vars, varIdx, name);
            bool found = foundIdx >= 0;
            string rep = found ? vars[foundIdx].val : "";
            if (rep == null) { rep = ""; }
            if (name != "" && rep.IndexOf("var(" + name) >= 0) { found = false; rep = ""; }
            if (!found || rep == "") {
                if (hasFb) { rep = fb; }
                else if (!found) {
                    s = s.Substring(0, at)
                        + s.Substring(close + 1, s.Length - close - 1);
                    continue;
                }
            }
            if (s.Length - (close + 1 - at) + rep.Length > 4096) { return s; }
            s = s.Substring(0, at) + rep + s.Substring(close + 1, s.Length - close - 1);
        }
        return s;
    }
    static int MatchParen(string s, int open) {
        if (s == null || open < 0 || open >= s.Length) { return -1; }
        int depth = 0;
        int i = open;
        int len = s.Length;
        while (i < len) {
            int ch = s[i] & 255;
            if (ch == 40) { depth = depth + 1; } // '('
            else if (ch == 41) { // ')'
                depth = depth - 1;
                if (depth == 0) { return i; }
            }
            i = i + 1;
        }
        return -1;
    }
    static int TopComma(string s) {
        if (s == null) { return -1; }
        int depth = 0;
        int len = s.Length;
        for (int i = 0; i < len; i = i + 1) {
            int ch = s[i] & 255;
            if (ch == 40) { depth = depth + 1; }
            else if (ch == 41) { if (depth > 0) { depth = depth - 1; } }
            else if (ch == 44 && depth == 0) { return i; } // ','
        }
        return -1;
    }
    static string StripComments(string src) {
        if (src == null) { return ""; }
        int open = Css.IndexFrom(src, "/*", 0);
        if (open < 0) { return src; }
        StringBuilder sb = new StringBuilder();
        int i = 0;
        int n = src.Length;
        while (open >= 0) {
            if (open > i) { sb.Append(src.Substring(i, open - i)); }
            int end = Css.IndexFrom(src, "*/", open + 2);
            if (end < 0) { return sb.ToString(); }
            i = end + 2;
            open = Css.IndexFrom(src, "/*", i);
        }
        if (i < n) { sb.Append(src.Substring(i, n - i)); }
        return sb.ToString();
    }
    static List<string> SplitTrim(string s, string sep) {
        List<string> outp = new List<string>();
        if (s == null || s.Length == 0) { return outp; }
        if (sep == null || sep.Length == 0) { outp.Add(Css.Trim(s)); return outp; }
        List<string> parts = s.Split(sep);
        for (int i = 0; i < parts.Count; i = i + 1) {
            outp.Add(Css.Trim(parts[i]));
        }
        return outp;
    }
    static List<string> SplitTopTrim(string s, string sep) {
        List<string> outp = new List<string>();
        if (s == null || s.Length == 0) { return outp; }
        if (sep == null || sep.Length == 0) { outp.Add(Css.Trim(s)); return outp; }
        int sepByte = sep[0] & 255;
        int depth = 0;
        int quote = 0;
        int start = 0;
        int len = s.Length;
        for (int i = 0; i < len; i = i + 1) {
            int ch = s[i] & 255;
            if (quote != 0) {
                if (ch == 92) { i = i + 1; continue; } // '\\'
                if (ch == quote) { quote = 0; }
                continue;
            }
            if (ch == 34 || ch == 39) { quote = ch; continue; } // '"' 或 '\''
            if (ch == 40) { depth = depth + 1; } // '('
            else if (ch == 41) { if (depth > 0) { depth = depth - 1; } } // ')'
            else if (ch == sepByte && depth == 0) {
                outp.Add(Css.Trim(s.Substring(start, i - start)));
                start = i + 1;
            }
        }
        outp.Add(Css.Trim(s.Substring(start, len - start)));
        return outp;
    }
    static List<string> SelectorTokens(string s) {
        List<string> items = new List<string>();
        if (s == null) { return items; }
        int tokStart = 0 - 1;
        int tokEnd = 0;
        StringBuilder curBuf = null;
        int depth = 0;
        int quote = 0;
        bool ws = false;
        int i = 0;
        int n = s.Length;
        while (i < n) {
            int at = i;
            int ch = s[i] & 255;
            i = i + 1;
            if (quote != 0) {
                int stepEnd = i;
                if (ch == 92 && i < n) { i = i + 1; stepEnd = i; }
                else if (ch == quote) { quote = 0; }
                if (curBuf != null) { curBuf.Append(s.Substring(at, stepEnd - at)); }
                else {
                    if (tokStart < 0) { tokStart = at; }
                    tokEnd = stepEnd;
                }
                continue;
            }
            if (ch == 34 || ch == 39 || ch == 91 || ch == 40) {
                if (ch == 34 || ch == 39) { quote = ch; }
                else { depth = depth + 1; }
                if (curBuf != null) { curBuf.Append(s.Substring(at, 1)); }
                else if (tokStart < 0) { tokStart = at; tokEnd = i; }
                else if (tokEnd == at) { tokEnd = i; }
                else {
                    curBuf = new StringBuilder();
                    curBuf.Append(s.Substring(tokStart, tokEnd - tokStart));
                    curBuf.Append(s.Substring(at, 1));
                    tokStart = 0 - 1;
                }
                ws = false;
                continue;
            }
            if (ch == 93 || ch == 41) {
                if (depth > 0) { depth = depth - 1; }
                if (curBuf != null) { curBuf.Append(s.Substring(at, 1)); }
                else if (tokStart < 0) { tokStart = at; tokEnd = i; }
                else if (tokEnd == at) { tokEnd = i; }
                else {
                    curBuf = new StringBuilder();
                    curBuf.Append(s.Substring(tokStart, tokEnd - tokStart));
                    curBuf.Append(s.Substring(at, 1));
                    tokStart = 0 - 1;
                }
                continue;
            }
            if (depth > 0) {
                if (curBuf != null) { curBuf.Append(s.Substring(at, 1)); }
                else if (tokStart < 0) { tokStart = at; tokEnd = i; }
                else { tokEnd = i; }
                continue;
            }
            if (Css.IsSpaceByte(ch)) {
                if (curBuf != null || tokStart >= 0) { ws = true; }
                continue;
            }
            if (ch == 62 || ch == 43 || ch == 126) {
                if (curBuf != null) {
                    items.Add(curBuf.ToString());
                    curBuf = null;
                } else if (tokStart >= 0) {
                    items.Add(s.Substring(tokStart, tokEnd - tokStart));
                    tokStart = 0 - 1;
                }
                items.Add(ch == 62 ? ">" : (ch == 43 ? "+" : "~"));
                ws = false;
                continue;
            }
            if (ws) {
                if (curBuf != null) {
                    items.Add(curBuf.ToString());
                    curBuf = null;
                } else if (tokStart >= 0) {
                    items.Add(s.Substring(tokStart, tokEnd - tokStart));
                    tokStart = 0 - 1;
                }
                items.Add(" ");
                ws = false;
            }
            if (curBuf != null) { curBuf.Append(s.Substring(at, 1)); }
            else if (tokStart < 0) { tokStart = at; tokEnd = i; }
            else { tokEnd = i; }
        }
        if (curBuf != null) { items.Add(curBuf.ToString()); }
        else if (tokStart >= 0) { items.Add(s.Substring(tokStart, tokEnd - tokStart)); }
        return items;
    }
    static int IndexFrom(string s, string needle, int start) {
        if (s == null || needle == null) { return -1; }
        int from = start;
        if (from < 0) { from = 0; }
        if (from > s.Length) { return -1; }
        return s.IndexOf(needle, from);
    }
    static bool IsSpaceByte(int c) { return c == 32 || c == 9 || c == 13 || c == 10; }
    static bool Space(string ch) {
        if (ch == null || ch.Length == 0) { return false; }
        return Css.IsSpaceByte(ch[0] & 255);
    }
    static string Trim(string s) {
        if (s == null) { return ""; }
        return s.Trim();
    }
    static string PseudoContent(string raw, StyleNode host) {
        if (raw == null || raw == "") { return ""; }
        string lo = Css.Lower(raw);
        if (lo == "none" || lo == "normal") { return ""; }
        string outR = "";
        int i = 0;
        int n = raw.Length;
        while (i < n) {
            int b = raw[i] & 255;
            if (b == 32 || b == 9) { i = i + 1; continue; }
            if (b == 34 || b == 39) {
                string piece = "";
                int e = i + 1;
                while (e < n) {
                    int eb = raw[e] & 255;
                    if (eb == b) { break; }
                    if (eb == 92 && e + 1 < n) {
                        int cp = 0;
                        int digits = 0;
                        int k = e + 1;
                        while (k < n && digits < 6 && Css.IsHexByte(raw[k] & 255)) {
                            cp = cp * 16 + Css.HexValByte(raw[k] & 255);
                            digits = digits + 1;
                            k = k + 1;
                        }
                        if (digits > 0) {
                            if (cp <= 0 || cp > 1114111 || (cp >= 55296 && cp <= 57343)) { cp = 65533; }
                            piece = piece + Text.CharStr(cp);
                            e = k;
                            if (e < n) {
                                int nb = raw[e] & 255;
                                if (nb == 32 || nb == 9) { e = e + 1; }
                            }
                            continue;
                        }
                        int escEnd = Text.NextCharEnd(raw, e + 1);
                        piece = piece + raw.Substring(e + 1, escEnd - (e + 1));
                        e = escEnd;
                        continue;
                    }
                    int nextE = Text.NextCharEnd(raw, e);
                    if (nextE <= e) { nextE = e + 1; }
                    piece = piece + raw.Substring(e, nextE - e);
                    e = nextE;
                }
                outR = outR + piece;
                i = e + 1;
                continue;
            }
            if (n - i >= 5 && Css.Lower(raw.Substring(i, 5)) == "attr(") {
                int close = Css.IndexFrom(raw, ")", i);
                if (close > i) {
                    string nm = Css.Lower(
                        Css.Trim(raw.Substring(i + 5, close - i - 5)));
                    if (host != null) { outR = outR + host.CssAttr(nm); }
                    i = close + 1;
                    continue;
                }
            }
            int sp = i;
            while (sp < n) {
                int sb = raw[sp] & 255;
                if (sb == 32 || sb == 9) { break; }
                sp = sp + 1;
            }
            i = sp > i ? sp : i + 1;
        }
        return outR;
    }
    static int HexValByte(int b) {
        if (b >= 48 && b <= 57) { return b - 48; }
        if (b >= 97 && b <= 102) { return b - 87; }
        return b - 55;
    }
    static bool IsHexByte(int b) {
        return (b >= 48 && b <= 57) || (b >= 97 && b <= 102)
            || (b >= 65 && b <= 70);
    }
}
