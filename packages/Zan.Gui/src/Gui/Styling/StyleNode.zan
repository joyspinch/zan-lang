using System;
namespace Gui;
public class StyleNode {
    public virtual StyleNode StyleParentNode() { return null; }
    public virtual int StyleChildCount() { return 0; }
    public virtual StyleNode StyleChildNodeAt(int index) { return null; }
    public virtual int StyleIndexOfNode(StyleNode child) { return -1; }
    public virtual string StyleType() { return ""; }
    public virtual string EffectiveClass() { return ""; }
    public virtual string StyleNodeName() { return ""; }
    public virtual int StyleSurfaceState() { return 0; }
    public virtual bool CssHasAttr(string key) { return false; }
    public virtual string CssAttr(string key) { return ""; }
    public virtual string InlineStyleCss() { return ""; }
    public virtual void SetInlineStyleCss(string css) {}
    public virtual void SetStylePad(int pad) {}
    public virtual void SetStyleGap(int gap) {}
    public virtual void SetStyleX(int x) {}
    public virtual void SetStyleY(int y) {}
    public virtual void SetStylePrefW(int w) {}
    public virtual void SetStylePrefH(int h) {}
    public virtual void SetProp(string key, string val) {}
    public virtual void ApplyVisualStyleBox(StyleBox box) {}
    public virtual void ApplyInlineOverridesTo(StyleBox box) {}
    public virtual void ApplyMotionOverridesTo(StyleBox box) {}
    public virtual void SetInlineBg(int bg, int bgTo) {}
    public virtual void SetInlineBorder(int width, int color) {}
}
