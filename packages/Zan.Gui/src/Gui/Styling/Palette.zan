using System;

namespace Gui;

// 常用高质感现代语义色板（ARGB: 0xAARRGGBB）。
// 经典 Slate/Zinc 质感，远离高饱和度刺眼配色。
public class Palette {
    // 现代暗黑工作台 (Modern Dark Slate)
    const int BgDark         = unchecked((int)0xFF0F172A);  // Slate-900 (深邃底色)
    const int SurfaceDark    = unchecked((int)0xFF1E293B);  // Slate-800 (工作区卡片表面)
    const int SurfaceHover   = unchecked((int)0xFF334155);  // Slate-700 (鼠标悬浮高亮)
    const int BorderDark     = unchecked((int)0xFF334155);  // Slate-700 (低对比细描边)
    const int TextHigh       = unchecked((int)0xFFF8FAFC);  // Slate-50 (高对比正文)
    const int TextMed        = unchecked((int)0xFF94A3B8);  // Slate-400 (次级中灰文字)
    const int TextLow        = unchecked((int)0xFF64748B);  // Slate-500 (低优先级弱文字)

    // 经典品牌与功能色
    const int PrimaryBrand   = unchecked((int)0xFF3B82F6);  // 科技蓝 Blue-500
    const int PrimaryHover   = unchecked((int)0xFF2563EB);  // Blue-600
    const int Success        = unchecked((int)0xFF10B981);  // 翠绿 Emerald-500
    const int Warning        = unchecked((int)0xFFF59E0B);  // 琥珀 Amber-500
    const int Danger         = unchecked((int)0xFFEF4444);  // 珊瑚红 Rose-500
}
