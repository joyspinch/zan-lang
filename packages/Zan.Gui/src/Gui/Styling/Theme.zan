    void ScaleByDpi(int dpiPercent) {
        if (dpiPercent <= 100) { return; }
        fontSizeTiny   = fontSizeTiny * dpiPercent / 100;
        fontSizeSmall  = fontSizeSmall * dpiPercent / 100;
        fontSizeMedium = fontSizeMedium * dpiPercent / 100;
        fontSizeLarge  = fontSizeLarge * dpiPercent / 100;
        fontSizeHuge   = fontSizeHuge * dpiPercent / 100;
        heightTiny  = heightTiny * dpiPercent / 100;
        heightSmall = heightSmall * dpiPercent / 100;
        heightMedium = heightMedium * dpiPercent / 100;
        heightLarge = heightLarge * dpiPercent / 100;
        paddingTiny  = paddingTiny * dpiPercent / 100;
        paddingSmall = paddingSmall * dpiPercent / 100;
        paddingMedium = paddingMedium * dpiPercent / 100;
        paddingLarge = paddingLarge * dpiPercent / 100;
        gapSmall  = gapSmall * dpiPercent / 100;
        gapMedium = gapMedium * dpiPercent / 100;
        gapLarge  = gapLarge * dpiPercent / 100;
        iconSizeSmall  = iconSizeSmall * dpiPercent / 100;
        iconSizeMedium = iconSizeMedium * dpiPercent / 100;
        iconSizeLarge  = iconSizeLarge * dpiPercent / 100;
        iconSizeCaption = iconSizeCaption * dpiPercent / 100;
        borderRadiusSmall  = borderRadiusSmall * dpiPercent / 100;
        borderRadiusMedium = borderRadiusMedium * dpiPercent / 100;
        borderRadiusLarge  = borderRadiusLarge * dpiPercent / 100;
        borderWidth        = borderWidth * dpiPercent / 100;
        if (borderWidth < 1) { borderWidth = 1; }
    }
    ThemeMetricsSnapshot Snapshot() {
        ThemeMetricsSnapshot s = new ThemeMetricsSnapshot();
        s.fontSizeTiny = fontSizeTiny;
        s.fontSizeSmall = fontSizeSmall;
        s.fontSizeMedium = fontSizeMedium;
        s.fontSizeLarge = fontSizeLarge;
        s.fontSizeHuge = fontSizeHuge;
        s.heightTiny = heightTiny;
        s.heightSmall = heightSmall;
        s.heightMedium = heightMedium;
        s.heightLarge = heightLarge;
        s.paddingTiny = paddingTiny;
        s.paddingSmall = paddingSmall;
        s.paddingMedium = paddingMedium;
        s.paddingLarge = paddingLarge;
        s.gapSmall = gapSmall;
        s.gapMedium = gapMedium;
        s.gapLarge = gapLarge;
        s.iconSizeSmall = iconSizeSmall;
        s.iconSizeMedium = iconSizeMedium;
        s.iconSizeLarge = iconSizeLarge;
        s.iconSizeCaption = iconSizeCaption;
        s.borderRadiusSmall = borderRadiusSmall;
        s.borderRadiusMedium = borderRadiusMedium;
        s.borderRadiusLarge = borderRadiusLarge;
        s.borderWidth = borderWidth;
        return s;
    }
    List<int> SnapshotMetrics() {
        return new List<int>{
            fontSizeTiny, fontSizeSmall, fontSizeMedium, fontSizeLarge, fontSizeHuge,
            heightTiny, heightSmall, heightMedium, heightLarge,
            paddingTiny, paddingSmall, paddingMedium, paddingLarge,
            gapSmall, gapMedium, gapLarge,
            iconSizeSmall, iconSizeMedium, iconSizeLarge, iconSizeCaption,
            borderRadiusSmall, borderRadiusMedium, borderRadiusLarge, borderWidth };
    }
    void ApplySnapshotScaled(ThemeMetricsSnapshot bm, int num, int den) {
        if (bm == null || den <= 0) { return; }
        fontSizeTiny   = bm.fontSizeTiny * num / den;
        fontSizeSmall  = bm.fontSizeSmall * num / den;
        fontSizeMedium = bm.fontSizeMedium * num / den;
        fontSizeLarge  = bm.fontSizeLarge * num / den;
        fontSizeHuge   = bm.fontSizeHuge * num / den;
        if (fontSizeTiny < 6) { fontSizeTiny = 6; }
        if (fontSizeSmall < 6) { fontSizeSmall = 6; }
        if (fontSizeMedium < 7) { fontSizeMedium = 7; }
        if (fontSizeLarge < 8) { fontSizeLarge = 8; }
        if (fontSizeHuge < 9) { fontSizeHuge = 9; }
        heightTiny  = bm.heightTiny * num / den;
        heightSmall = bm.heightSmall * num / den;
        heightMedium = bm.heightMedium * num / den;
        heightLarge = bm.heightLarge * num / den;
        paddingTiny  = bm.paddingTiny * num / den;
        paddingSmall = bm.paddingSmall * num / den;
        paddingMedium = bm.paddingMedium * num / den;
        paddingLarge = bm.paddingLarge * num / den;
        gapSmall  = bm.gapSmall * num / den;
        gapMedium = bm.gapMedium * num / den;
        gapLarge  = bm.gapLarge * num / den;
        iconSizeSmall  = bm.iconSizeSmall * num / den;
        iconSizeMedium = bm.iconSizeMedium * num / den;
        iconSizeLarge  = bm.iconSizeLarge * num / den;
        iconSizeCaption = bm.iconSizeCaption * num / den;
        borderRadiusSmall  = bm.borderRadiusSmall * num / den;
        borderRadiusMedium = bm.borderRadiusMedium * num / den;
        borderRadiusLarge  = bm.borderRadiusLarge * num / den;
        borderWidth        = bm.borderWidth * num / den;
        if (borderWidth < 1) { borderWidth = 1; }
    }
    void ApplyMetricsScaled(List<int> bm, int num, int den) {
        if (bm == null || bm.Count < 24 || den <= 0) { return; }
        fontSizeTiny   = bm[0] * num / den;
        fontSizeSmall  = bm[1] * num / den;
        fontSizeMedium = bm[2] * num / den;
        fontSizeLarge  = bm[3] * num / den;
        fontSizeHuge   = bm[4] * num / den;
        if (fontSizeTiny < 6) { fontSizeTiny = 6; }
        if (fontSizeSmall < 6) { fontSizeSmall = 6; }
        if (fontSizeMedium < 7) { fontSizeMedium = 7; }
        if (fontSizeLarge < 8) { fontSizeLarge = 8; }
        if (fontSizeHuge < 9) { fontSizeHuge = 9; }
        heightTiny  = bm[5] * num / den;
        heightSmall = bm[6] * num / den;
        heightMedium = bm[7] * num / den;
        heightLarge = bm[8] * num / den;
        paddingTiny  = bm[9] * num / den;
        paddingSmall = bm[10] * num / den;
        paddingMedium = bm[11] * num / den;
        paddingLarge = bm[12] * num / den;
        gapSmall  = bm[13] * num / den;
        gapMedium = bm[14] * num / den;
        gapLarge  = bm[15] * num / den;
        iconSizeSmall  = bm[16] * num / den;
        iconSizeMedium = bm[17] * num / den;
        iconSizeLarge  = bm[18] * num / den;
        iconSizeCaption = bm[19] * num / den;
        borderRadiusSmall  = bm[20] * num / den;
        borderRadiusMedium = bm[21] * num / den;
        borderRadiusLarge  = bm[22] * num / den;
        borderWidth        = bm[23] * num / den;
        if (borderWidth < 1) { borderWidth = 1; }
    }
    static int DensityPermille(int density) {
        if (density <= 0) { return 880; }
        if (density >= 2) { return 1150; }
        return 1000;
    }
    static string DensityName(int density) {
        if (density <= 0) { return "Small"; }
        if (density >= 2) { return "Large"; }
        return "Medium";
    }
    static int DensityOf(string name) {
        string s = name;
        if (s == null) { return 1; }
        s = s.ToLower();
        if (s == "small" || s == "compact" || s == "tight") { return 0; }
        if (s == "large" || s == "comfortable" || s == "loose") { return 2; }
        return 1;
    }
    void ApplyDensitySnapshot(ThemeMetricsSnapshot bm, int density) {
        this.ApplySnapshotScaled(bm, Theme.DensityPermille(density), 1000);
    }
    void ApplyDensityScaled(List<int> bm, int density) {
        this.ApplyMetricsScaled(bm, Theme.DensityPermille(density), 1000);
    }
}
