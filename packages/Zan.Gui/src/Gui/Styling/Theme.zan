    public Theme() { this.InitLight(); }
    public Theme(bool dark) {
        if (dark) {
            this.InitDark();
        } else {
            this.InitLight();
        }
    }
    static Theme Light() { return new Theme(false); }
    private void InitSharedDefaults() {
        Theme t = this;
        t.overlay           = 1291845632;
        t.glass             = 0;
        t.glassBlur         = 36;
        t.glassTint         = 260;
        t.glassChromeTint   = 520;
        t.glassSheen        = 220;
        t.glassRadius       = Radius.L;
        t.glassShadowDy     = 8;
        t.glassShadowBlur   = 24;
        t.surfaceShadowDy   = 0 - 1;
        t.surfaceShadowBlur = 0 - 1;
        t.surfaceSheen      = 0 - 1;
        t.surfaceSheenColor = 0;
        t.gradient          = 0;
        t.bgGradTop         = 0;
        t.bgGradBottom      = 0;
        t.neu               = 0;
        t.brutal            = 0;
        t.fx                = 0;
        t.tooltipBg         = (int)0xFF1F2430;
        t.tooltipBorder     = (int)0xFF3A4150;
        t.tooltipText       = (int)0xFFF2F5FA;
        t.tooltipTextMuted  = (int)0xFFBFC7D5;
        t.scrim             = (int)0xE6000000;
        t.scrimChip         = 0x40FFFFFF;
        t.scrimChipHover    = 0x66FFFFFF;
        t.onScrim           = (int)0xFFFFFFFF;
        t.statusDebugBg     = (int)0xFFCC6633;
        t.chart1 = 0; t.chart2 = 0; t.chart3 = 0; t.chart4 = 0;
        t.chart5 = 0; t.chart6 = 0; t.chart7 = 0; t.chart8 = 0;
        t.borderRadiusSmall  = Radius.S;
        t.borderRadiusMedium = Radius.M;
        t.borderRadiusLarge  = Radius.L;
        t.borderWidth        = 1;
        t.fontSizeTiny       = 12;
        t.fontSizeSmall      = 13;
        t.fontSizeMedium     = 14;
        t.fontSizeLarge      = 16;
        t.fontSizeHuge       = 20;
        t.heightTiny         = WidgetSize.Mini;
        t.heightSmall        = WidgetSize.Small;
        t.heightMedium       = WidgetSize.Medium;
        t.heightLarge        = WidgetSize.Large;
        t.paddingTiny        = Space.XXS;
        t.paddingSmall       = Space.XS;
        t.paddingMedium      = Space.SM;
        t.paddingLarge       = Space.M;
        t.gapSmall           = Space.XS;
        t.gapMedium          = Space.SM;
        t.gapLarge           = Space.M;
        t.iconSizeSmall      = 16;
        t.iconSizeMedium     = 20;
        t.iconSizeLarge      = 24;
        t.iconSizeCaption    = 11;
        t.animFastMs         = Motion.Fast;
        t.animMediumMs       = Motion.Medium;
        t.animSlowMs         = Motion.Slow;
        t.metricScalePermille = 1000;
    }
