    static int ScaleDim(int baseVal, long n, long d, int minVal, bool monotonic) {
        if (baseVal <= 0 || n <= 0 || d <= 0) { return minVal > 0 ? minVal : 0; }
        long raw = ((long)baseVal * n + d / 2L) / d;
        int r = (int)raw;
        if (monotonic) {
            if (n > d && r <= baseVal) { r = baseVal + 1; }
            else if (n < d && r >= baseVal && baseVal > minVal) { r = baseVal - 1; }
        }
        if (r < minVal) { r = minVal; }
        return r;
    }
    public int ScaleMetric(int basePx) {
        if (basePx <= 0) { return 0; }
        int perm = metricScalePermille > 0 ? metricScalePermille : 1000;
        return Theme.ScaleDim(basePx, (long)perm, 1000L, 1, basePx <= 12);
    }
    void ScaleByDpi(int dpiPercent) {
        if (dpiPercent <= 100) { return; }
        int prevPerm = metricScalePermille > 0 ? metricScalePermille : 1000;
        this.ApplySnapshotScaled(this.Snapshot(), dpiPercent, 100);
        metricScalePermille = Theme.ScaleDim(prevPerm, (long)dpiPercent, 100L, 100, false);
    }
    ThemeMetricsSnapshot Snapshot() {
        ThemeMetricsSnapshot s = new ThemeMetricsSnapshot();
        s.fontSizeTiny = fontSizeTiny;
        s.fontSizeSmall = fontSizeSmall;
        s.fontSizeMedium = fontSizeMedium;
        s.fontSizeLarge = fontSizeLarge;
        s.fontSizeHuge = fontSizeHuge;
        s.heightTiny = heightTiny;
        s.heightSmall = heightSmall;
        s.heightMedium = heightMedium;
        s.heightLarge = heightLarge;
        s.paddingTiny = paddingTiny;
        s.paddingSmall = paddingSmall;
        s.paddingMedium = paddingMedium;
        s.paddingLarge = paddingLarge;
        s.gapSmall = gapSmall;
        s.gapMedium = gapMedium;
        s.gapLarge = gapLarge;
        s.iconSizeSmall = iconSizeSmall;
        s.iconSizeMedium = iconSizeMedium;
        s.iconSizeLarge = iconSizeLarge;
        s.iconSizeCaption = iconSizeCaption;
        s.borderRadiusSmall = borderRadiusSmall;
        s.borderRadiusMedium = borderRadiusMedium;
        s.borderRadiusLarge = borderRadiusLarge;
        s.borderWidth = borderWidth;
        return s;
    }
    List<int> SnapshotMetrics() {
        return new List<int>{
            fontSizeTiny, fontSizeSmall, fontSizeMedium, fontSizeLarge, fontSizeHuge,
            heightTiny, heightSmall, heightMedium, heightLarge,
            paddingTiny, paddingSmall, paddingMedium, paddingLarge,
            gapSmall, gapMedium, gapLarge,
            iconSizeSmall, iconSizeMedium, iconSizeLarge, iconSizeCaption,
            borderRadiusSmall, borderRadiusMedium, borderRadiusLarge, borderWidth };
    }
    void ApplySnapshotScaled(ThemeMetricsSnapshot bm, int num, int den) {
        if (bm == null || num <= 0 || den <= 0) { return; }
        long n = (long)num;
        long d = (long)den;
        metricScalePermille = Theme.ScaleDim(1000, n, d, 100, false);
        fontSizeTiny   = Theme.ScaleDim(bm.fontSizeTiny, n, d, 6, false);
        fontSizeSmall  = Theme.ScaleDim(bm.fontSizeSmall, n, d, 6, false);
        fontSizeMedium = Theme.ScaleDim(bm.fontSizeMedium, n, d, 7, false);
        fontSizeLarge  = Theme.ScaleDim(bm.fontSizeLarge, n, d, 8, false);
        fontSizeHuge   = Theme.ScaleDim(bm.fontSizeHuge, n, d, 9, false);
        heightTiny     = Theme.ScaleDim(bm.heightTiny, n, d, 12, true);
        heightSmall    = Theme.ScaleDim(bm.heightSmall, n, d, 14, true);
        heightMedium   = Theme.ScaleDim(bm.heightMedium, n, d, 16, true);
        heightLarge    = Theme.ScaleDim(bm.heightLarge, n, d, 18, true);
        paddingTiny    = Theme.ScaleDim(bm.paddingTiny, n, d, 1, true);
        paddingSmall   = Theme.ScaleDim(bm.paddingSmall, n, d, 2, true);
        paddingMedium  = Theme.ScaleDim(bm.paddingMedium, n, d, 4, true);
        paddingLarge   = Theme.ScaleDim(bm.paddingLarge, n, d, 6, true);
        gapSmall       = Theme.ScaleDim(bm.gapSmall, n, d, 2, true);
        gapMedium      = Theme.ScaleDim(bm.gapMedium, n, d, 4, true);
        gapLarge       = Theme.ScaleDim(bm.gapLarge, n, d, 6, true);
        iconSizeSmall  = Theme.ScaleDim(bm.iconSizeSmall, n, d, 10, true);
        iconSizeMedium = Theme.ScaleDim(bm.iconSizeMedium, n, d, 12, true);
        iconSizeLarge  = Theme.ScaleDim(bm.iconSizeLarge, n, d, 14, true);
        iconSizeCaption = Theme.ScaleDim(bm.iconSizeCaption, n, d, 8, true);
        borderRadiusSmall  = bm.borderRadiusSmall <= 0 ? 0 : Theme.ScaleDim(bm.borderRadiusSmall, n, d, 1, true);
        borderRadiusMedium = bm.borderRadiusMedium <= 0 ? 0 : Theme.ScaleDim(bm.borderRadiusMedium, n, d, 2, true);
        borderRadiusLarge  = bm.borderRadiusLarge <= 0 ? 0 : Theme.ScaleDim(bm.borderRadiusLarge, n, d, 3, true);
        borderWidth        = Theme.ScaleDim(bm.borderWidth, n, d, 1, false);
    }
    void ApplyMetricsScaled(List<int> bm, int num, int den) {
        if (bm == null || bm.Count < 24 || den <= 0) { return; }
        ThemeMetricsSnapshot snap = new ThemeMetricsSnapshot();
        snap.fontSizeTiny = bm[0]; snap.fontSizeSmall = bm[1];
        snap.fontSizeMedium = bm[2]; snap.fontSizeLarge = bm[3]; snap.fontSizeHuge = bm[4];
        snap.heightTiny = bm[5]; snap.heightSmall = bm[6];
        snap.heightMedium = bm[7]; snap.heightLarge = bm[8];
        snap.paddingTiny = bm[9]; snap.paddingSmall = bm[10];
        snap.paddingMedium = bm[11]; snap.paddingLarge = bm[12];
        snap.gapSmall = bm[13]; snap.gapMedium = bm[14]; snap.gapLarge = bm[15];
        snap.iconSizeSmall = bm[16]; snap.iconSizeMedium = bm[17];
        snap.iconSizeLarge = bm[18]; snap.iconSizeCaption = bm[19];
        snap.borderRadiusSmall = bm[20]; snap.borderRadiusMedium = bm[21];
        snap.borderRadiusLarge = bm[22]; snap.borderWidth = bm[23];
        this.ApplySnapshotScaled(snap, num, den);
    }
    static int DensityPermille(int density) {
        if (density <= 0) { return 880; }
        if (density >= 2) { return 1150; }
        return 1000;
    }
    static string DensityName(int density) {
        if (density <= 0) { return "Small"; }
        if (density >= 2) { return "Large"; }
        return "Medium";
    }
    static int DensityOf(string name) {
        string s = name;
        if (s == null) { return 1; }
        s = s.ToLower();
        if (s == "small" || s == "compact" || s == "tight") { return 0; }
        if (s == "large" || s == "comfortable" || s == "loose") { return 2; }
        return 1;
    }
    void ApplyDensitySnapshot(ThemeMetricsSnapshot bm, int density) {
        this.ApplySnapshotScaled(bm, Theme.DensityPermille(density), 1000);
    }
    void ApplyDensityScaled(List<int> bm, int density) {
        this.ApplyMetricsScaled(bm, Theme.DensityPermille(density), 1000);
    }
}
