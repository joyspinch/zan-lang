    static int ClampByte(int v) {
        if (v < 0) { return 0; }
        if (v > 255) { return 255; }
        return v;
    }
    static int Rgb(int r, int g, int b) {
        return (int)((255u << 24) | ((uint)Theme.ClampByte(r) << 16)
            | ((uint)Theme.ClampByte(g) << 8) | (uint)Theme.ClampByte(b));
    }
    static int Rgba(int r, int g, int b, int a) {
        return (int)(((uint)Theme.ClampByte(a) << 24) | ((uint)Theme.ClampByte(r) << 16)
            | ((uint)Theme.ClampByte(g) << 8) | (uint)Theme.ClampByte(b));
    }
    int GlassTint() {
        int rgb = bgPrimary % 16777216;
        if (rgb < 0) { rgb = rgb + 16777216; }
        return ColorMath.WithAlpha(rgb, 150);
    }
    bool IsLightBg() {
        int rgb = bgPrimary % 16777216;
        if (rgb < 0) { rgb = rgb + 16777216; }
        int r = rgb / 65536;
        int g = (rgb / 256) % 256;
        int b = rgb % 256;
        return r + g + b > 384;
    }
    void ApplyAccent(int color) {
        primary = color;
        borderFocus = color;
        borderHover = color;
    }
    void MakeSurfacesOpaque() {
        bgPrimary = ColorMath.WithAlpha(bgPrimary, 255);
        bgSecondary = ColorMath.WithAlpha(bgSecondary, 255);
        bgTertiary = ColorMath.WithAlpha(bgTertiary, 255);
    }
    void ApplyTranslucency(int surface, int chrome, int rail) {
        bgPrimary = ColorMath.WithAlpha(bgPrimary, surface);
        bgSecondary = ColorMath.WithAlpha(bgSecondary, chrome);
        bgTertiary = ColorMath.WithAlpha(bgTertiary, rail);
    }
    static int TokenColor(JsonValue v) {
        if (v == null) { return 0; }
        if (v.IsNumber()) { return v.AsInt(0); }
        return StyleSheet.ParseColor(v.AsString(""));
    }
    static Dict<string, int> EnsureTokenIds() {
        if (Theme.tokenIds != null) { return Theme.tokenIds; }
        Dict<string, int> m = new Dict<string, int>();
        string table = "primary,primaryHover,primaryPressed,info,infoHover,infoPressed,"
            + "success,successHover,successPressed,warning,warningHover,warningPressed,"
            + "error,errorHover,errorPressed,textPrimary,textSecondary,textTertiary,"
            + "textDisabled,textInverse,bgPrimary,bgSecondary,bgTertiary,bgHover,bgActive,"
            + "bgDisabled,borderPrimary,borderSecondary,borderHover,borderFocus,divider,"
            + "overlay,bgGradTop,bgGradBottom,scrollbar,scrollbarHover,tooltipBg,"
            + "tooltipBorder,tooltipText,tooltipTextMuted,scrim,scrimChip,scrimChipHover,"
            + "onScrim,statusDebugBg,shadowColor,chart1,chart2,chart3,chart4,chart5,"
            + "chart6,chart7,chart8,glass,glassBlur,glassTint,glassChromeTint,glassSheen,"
            + "glassRadius,glassShadowDy,glassShadowBlur,gradient,neu,brutal,fx,"
            + "borderRadiusSmall,borderRadiusMedium,borderRadiusLarge,borderWidth,"
            + "fontSizeTiny,fontSizeSmall,fontSizeMedium,fontSizeLarge,fontSizeHuge,"
            + "heightTiny,heightSmall,heightMedium,heightLarge,paddingTiny,paddingSmall,"
            + "paddingMedium,paddingLarge,gapSmall,gapMedium,gapLarge,iconSizeSmall,"
            + "iconSizeMedium,iconSizeLarge,iconSizeCaption,animFastMs,animMediumMs,animSlowMs,"
            + "surfaceShadowDy,surfaceShadowBlur,surfaceSheen,surfaceSheenColor";
        int start = 0;
        int id = 1;
        int n = table.Length;
        for (int i = 0; i <= n; i = i + 1) {
            if (i == n || (table[i] & 255) == 44) {
                if (i > start) {
                    m.Add(table.Substring(start, i - start), id);
                    id = id + 1;
                }
                start = i + 1;
            }
        }
        Theme.tokenIds = m;
        return m;
    }
    void SetToken(string key, JsonValue v) {
        if (key == null || v == null) { return; }
        Theme t = this;
        string k = key;
        if (k.Length >= 2 && k.Substring(0, 2) == "--") { k = k.Substring(2, k.Length - 2); }
        int id = 0;
        if (!Theme.EnsureTokenIds().TryGetValue(k, out id)) { return; }
        int val = (id <= 54 || id == 97) ? Theme.TokenColor(v) : v.AsInt(0);
        switch (id) {
            case 1: t.primary = val; break;
            case 2: t.primaryHover = val; break;
            case 3: t.primaryPressed = val; break;
            case 4: t.info = val; break;
            case 5: t.infoHover = val; break;
            case 6: t.infoPressed = val; break;
            case 7: t.success = val; break;
            case 8: t.successHover = val; break;
            case 9: t.successPressed = val; break;
            case 10: t.warning = val; break;
            case 11: t.warningHover = val; break;
            case 12: t.warningPressed = val; break;
            case 13: t.error = val; break;
            case 14: t.errorHover = val; break;
            case 15: t.errorPressed = val; break;
            case 16: t.textPrimary = val; break;
            case 17: t.textSecondary = val; break;
            case 18: t.textTertiary = val; break;
            case 19: t.textDisabled = val; break;
            case 20: t.textInverse = val; break;
            case 21: t.bgPrimary = val; break;
            case 22: t.bgSecondary = val; break;
            case 23: t.bgTertiary = val; break;
            case 24: t.bgHover = val; break;
            case 25: t.bgActive = val; break;
            case 26: t.bgDisabled = val; break;
            case 27: t.borderPrimary = val; break;
            case 28: t.borderSecondary = val; break;
            case 29: t.borderHover = val; break;
            case 30: t.borderFocus = val; break;
