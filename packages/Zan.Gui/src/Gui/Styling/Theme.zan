    static int Rgb(int r, int g, int b) { return (int)4278190080 + r * 65536 + g * 256 + b; }
    static int Rgba(int r, int g, int b, int a) { return a * 16777216 + r * 65536 + g * 256 + b; }
    int GlassTint() {
        int rgb = bgPrimary % 16777216;
        if (rgb < 0) { rgb = rgb + 16777216; }
        return Fx.WithAlpha(rgb, 150);
    }
    bool IsLightBg() {
        int rgb = bgPrimary % 16777216;
        if (rgb < 0) { rgb = rgb + 16777216; }
        int r = rgb / 65536;
        int g = (rgb / 256) % 256;
        int b = rgb % 256;
        return r + g + b > 384;
    }
    void ApplyAccent(int color) {
        primary = color;
        borderFocus = color;
        borderHover = color;
    }
    void MakeSurfacesOpaque() {
        bgPrimary = Fx.WithAlpha(bgPrimary, 255);
        bgSecondary = Fx.WithAlpha(bgSecondary, 255);
        bgTertiary = Fx.WithAlpha(bgTertiary, 255);
    }
    void ApplyTranslucency(int surface, int chrome, int rail) {
        bgPrimary = Fx.WithAlpha(bgPrimary, surface);
        bgSecondary = Fx.WithAlpha(bgSecondary, chrome);
        bgTertiary = Fx.WithAlpha(bgTertiary, rail);
    }
    static int TokenColor(JsonValue v) {
        if (v == null) { return 0; }
        if (v.IsNumber()) { return v.AsInt(0); }
        return StyleSheet.ParseColor(v.AsString(""));
    }
    void SetToken(string key, JsonValue v) {
        Theme t = this;
        string k = key;
        if (k.Length >= 2 && k.Substring(0, 2) == "--") { k = k.Substring(2, k.Length - 2); }
        if (k == "primary") { t.primary = Theme.TokenColor(v); }
        else if (k == "primaryHover") { t.primaryHover = Theme.TokenColor(v); }
        else if (k == "primaryPressed") { t.primaryPressed = Theme.TokenColor(v); }
        else if (k == "info") { t.info = Theme.TokenColor(v); }
