    // 单个十六进制字节的数值（0-15），非十六进制时 -1（ASCII 区间快速计算，消除 16 次字符串比对）。
    static int HexDigitByte(int b) {
        if (b >= 48 && b <= 57) { return b - 48; }
        if (b >= 97 && b <= 102) { return b - 87; }
        if (b >= 65 && b <= 70) { return b - 55; }
        return -1;
    }

    // 将十六进制字符串（最多 8 位）转换为打包 int。最高位为 1
    // （alpha >= 0x80）自然产生负数，与 Theme token 一致。
    static int HexToInt(string h) {
        if (h == null) { return 0; }
        int acc = 0;
        int len = h.Length;
        for (int i = 0; i < len; i = i + 1) {
            int d = StyleSheet.HexDigitByte(h[i] & 255);
            if (d < 0) { return 0; }
            acc = (acc << 4) | d;
        }
        return acc;
    }

    // 单个十六进制字符的值（0-15），非十六进制时 -1。
    static int HexDigit(string ch) {
        if (ch == null || ch.Length == 0) { return -1; }
        return StyleSheet.HexDigitByte(ch[0] & 255);
    }

    // 字符是否为十进制数字。
    static bool Digit(string ch) {
        if (ch == null || ch.Length == 0) { return false; }
        int b = ch[0] & 255;
        return b >= 48 && b <= 57;
    }

}
