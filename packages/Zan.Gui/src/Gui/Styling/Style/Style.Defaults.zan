using System;
using System.Collections.Generic;
using System.Json;
namespace Gui;
public partial class Style {
    public static int RoleColor(Theme t, string cls, int state) {
        bool hover = (state & Style.SHover()) != 0;
        bool active = (state & Style.SActive()) != 0;
        if (Style.Has(cls, "primary")) {
            if (active) { return t.primaryPressed; }
            if (hover) { return t.primaryHover; }
            return t.primary;
        }
        if (Style.Has(cls, "info")) {
            if (active) { return t.infoPressed; }
            if (hover) { return t.infoHover; }
            return t.info;
        }
        if (Style.Has(cls, "success")) {
            if (active) { return t.successPressed; }
            if (hover) { return t.successHover; }
            return t.success;
        }
        if (Style.Has(cls, "warning")) {
            if (active) { return t.warningPressed; }
            if (hover) { return t.warningHover; }
            return t.warning;
        }
        if (Style.Has(cls, "error")) {
            if (active) { return t.errorPressed; }
            if (hover) { return t.errorHover; }
            return t.error;
        }
        return 0;
    }
    public static int RoleBase(Theme t, string cls) { return Style.RoleColor(t, cls, 0); }
    public static void Defaults(StyleHost app, StyleBox b, string type, string cls, int state) {
        Theme t = app != null ? app.HostTheme() : Theme.Light();
        bool active = (state & Style.SActive()) != 0;
        bool disabled = (state & Style.SDisabled()) != 0;
        b.fg = t.textPrimary;
        if (app != null) { Style.UnitEnvironment(app, b); }
        if (disabled) { b.fg = t.textDisabled; }
        b.accent = t.primary;
        if (type == "button" || type == "floatbutton") {
            Style.ButtonDefaults(app, b, cls, active, disabled);
        } else if (type == "tab") {
            Style.TabDefaults(app, b, cls);
        } else if (type == "tooltip") {
            b.bg = t.tooltipBg;
            b.borderColor = t.tooltipBorder;
            b.borderW = t.borderWidth;
            b.fg = t.tooltipText;
            b.radius = t.borderRadiusSmall;
        } else {
        }
        b.MarkThemeLengths();
    }
    public static void UnitEnvironment(StyleHost app, StyleBox b) {
        b.envDpiScale = app.HostDpiScale();
        Theme hostTheme = app.HostTheme();
        b.envTheme = hostTheme;
        b.envSheet = app.HostIsolateAppSheet() ? null : app.HostSheet();
        b.envRemPx = app.HostScale(16);
        int remBase = hostTheme.fontSizeMedium;
        if (remBase > 0) { b.envRootFontPx = remBase; b.envRemPhysical = true; }
        int viewportW = app.CssViewportWidth();
        int viewportH = app.CssViewportHeight();
        if (viewportW > 0) { b.envVw = viewportW; }
        if (viewportH > 0) { b.envVh = viewportH; }
        b.mediaDark = app.HostIsDark();
        b.mediaReduced = app.HostReducedMotion();
    }
    public static void Shell(StyleHost app, StyleBox b, string type, string cls, int state) {
        Theme t = app.HostTheme();
        bool active = (state & Style.SActive()) != 0;
        int surfA = StyleBox.AlphaOf(t.bgPrimary);
        bool isPopupSurface = Style.Has(cls, "drawer-surface") || Style.Has(cls, "modal-surface")
            || Style.Has(cls, "popover-card") || Style.Has(cls, "select-popup")
            || Style.Has(cls, "datepicker-popup") || Style.Has(cls, "colorpicker-popup")
            || Style.Has(cls, "contextmenu");
        if (surfA < 255 && (type == "card" || type == "panel") && !isPopupSurface) {
            if (b.bg != 0 && StyleBox.AlphaOf(b.bg) >= 255) {
                b.bg = ColorMath.WithAlpha(b.bg, surfA);
            }
            if (b.bgTo != 0 && StyleBox.AlphaOf(b.bgTo) >= 255) {
                b.bgTo = ColorMath.WithAlpha(b.bgTo, surfA);
            }
        }
        bool internalParts = type == "checkbox" || type == "radio" || type == "switch"
            || type == "slider" || type == "progress";
        bool brutalCompact = Style.Has(cls, "theme-choice") || Style.Has(cls, "menu-item")
            || Style.Has(cls, "contextmenu-item") || Style.Has(cls, "drawer-close")
            || Style.Has(cls, "tab-item-close") || Style.Has(cls, "tab-add-btn")
            || Style.Has(cls, "caption") || Style.Has(cls, "slider-track")
            || Style.Has(cls, "slider-fill") || Style.Has(cls, "progress-track")
            || Style.Has(cls, "progress-fill");
        bool disabled = (state & Style.SDisabled()) != 0;
        bool focused = (state & Style.SFocus()) != 0;
        bool hasToneBorder = Style.Has(cls, "success") || Style.Has(cls, "warning")
            || Style.Has(cls, "error");
        bool hasFill = b.bg != 0 || b.bgTo != 0;
        if (t.brutal == 1 && hasFill && !disabled && !Style.FlatType(type)
        && !internalParts && !brutalCompact) {
            b.shadow = t.shadowColor;
            b.shadowDx = 4;
            b.shadowDy = 4;
            b.shadowBlur = 0;
            b.shadow2 = 0;
            b.sheen = 0;
            b.bgTo = 0;
            if (!focused && !hasToneBorder) { b.borderColor = t.borderPrimary; }
            b.borderW = Math.Max(t.borderWidth, 2);
            b.SetPrescaled(StyleBox.SourceBorder(), true);
            b.SetPrescaled(StyleBox.SourceShadowDx() | StyleBox.SourceShadowDy()
                | StyleBox.SourceShadowBlur(), false);
            if (active) {
                b.shadow = 0; b.tx = 4; b.ty = 4;
                b.SetPrescaled(StyleBox.SourceTx() | StyleBox.SourceTy(), false);
            }
        }
    }
    static Dict<int, StyleSheet> lastBaseSheets;
    static int lastBaseScale;
    static StyleSheet lastBaseSheet;
    static StyleSheet BaseSheet(StyleHost app) {
        int gen = app.HostBgThemeGen();
        Dict<int, StyleSheet> baseSheets = app.HostBaseSheets();
        if (baseSheets == null || app.HostBaseSheetGen() != gen) {
            baseSheets = new Dict<int, StyleSheet>();
            app.HostSetBaseSheets(baseSheets, gen);
        }
        int scale = app.HostMetricsScale();
        if (Style.lastBaseSheets == baseSheets && Style.lastBaseScale == scale
            && Style.lastBaseSheet != null) {
            return Style.lastBaseSheet;
        }
        StyleSheet hit;
        if (baseSheets.TryGetValue(scale, out hit)) {
            Style.lastBaseSheets = baseSheets;
            Style.lastBaseScale = scale;
            Style.lastBaseSheet = hit;
            return hit;
        }
        StyleSheet made;
        string css = Skin.BaseCss();
        if (css == "") {
            made = new StyleSheet();
        } else {
            made = Css.ParseWith(css, Style.VarsFromTheme(app.HostTheme()));
        }
        baseSheets.Add(scale, made);
        Style.lastBaseSheets = baseSheets;
        Style.lastBaseScale = scale;
        Style.lastBaseSheet = made;
        return made;
    }
    static void AddVar(List<CssVarDecl> dst, string name, int color) {
        dst.Add(new CssVarDecl("--" + name, "#" + Style.Hex8(color)));
    }
    static void AddVarN(List<CssVarDecl> dst, string name, int v) {
        dst.Add(new CssVarDecl("--" + name, Convert.ToString(v)));
    }
    static void AddVarMs(List<CssVarDecl> dst, string name, int v) {
        dst.Add(new CssVarDecl("--" + name, Convert.ToString(v) + "ms"));
    }
    static void AddVariantVars(List<CssVarDecl> dst, string name, int tint, int surface) {
        Style.AddVar(dst, name + "-ghost-hover-bg", ColorMath.ScaleAlpha(tint, 120));
        Style.AddVar(dst, name + "-ghost-active-bg", ColorMath.ScaleAlpha(tint, 215));
        Style.AddVar(dst, name + "-soft-bg", ColorMath.LerpColor(surface, tint, 90));
        Style.AddVar(dst, name + "-soft-hover-bg", ColorMath.LerpColor(surface, tint, 150));
        Style.AddVar(dst, name + "-soft-active-bg", ColorMath.LerpColor(surface, tint, 200));
    }
    public static List<CssVarDecl> VarsFromTheme(Theme t) {
        List<CssVarDecl> dst = new List<CssVarDecl>();
        if (t == null) { return dst; }
        Style.AddVarN(dst, "font-size-tiny", t.fontSizeTiny);
        Style.AddVarN(dst, "font-size-small", t.fontSizeSmall);
        Style.AddVarN(dst, "font-size-medium", t.fontSizeMedium);
        Style.AddVarN(dst, "font-size-large", t.fontSizeLarge);
        Style.AddVarN(dst, "font-size-huge", t.fontSizeHuge);
        Style.AddVarN(dst, "height-tiny", t.heightTiny);
        Style.AddVarN(dst, "height-small", t.heightSmall);
        Style.AddVarN(dst, "height-medium", t.heightMedium);
        Style.AddVarN(dst, "height-large", t.heightLarge);
        Style.AddVarN(dst, "height-micro-tiny", t.iconSizeSmall);
        Style.AddVarN(dst, "height-micro-small", t.iconSizeMedium);
        Style.AddVarN(dst, "radius-small", t.borderRadiusSmall);
        Style.AddVarN(dst, "radius-medium", t.borderRadiusMedium);
        Style.AddVarN(dst, "radius-large", t.borderRadiusLarge);
        Style.AddVarN(dst, "padding-tiny", t.paddingTiny);
        Style.AddVarN(dst, "padding-small", t.paddingSmall);
        Style.AddVarN(dst, "padding-medium", t.paddingMedium);
        Style.AddVarN(dst, "padding-large", t.paddingLarge);
        Style.AddVarN(dst, "button-pad-tiny", t.ScaleMetric(8));
        Style.AddVarN(dst, "button-pad-small", t.ScaleMetric(10));
        Style.AddVarN(dst, "button-pad-medium", t.ScaleMetric(14));
        Style.AddVarN(dst, "button-pad-large", t.ScaleMetric(18));
        Style.AddVarN(dst, "input-pad-tiny", t.ScaleMetric(6));
        Style.AddVarN(dst, "input-pad-small", t.ScaleMetric(8));
        Style.AddVarN(dst, "input-pad-medium", t.ScaleMetric(10));
        Style.AddVarN(dst, "input-pad-large", t.ScaleMetric(12));
        Style.AddVarN(dst, "theme-skin-card-height", t.ScaleMetric(72));
        Style.AddVarN(dst, "theme-skin-preview-height", t.ScaleMetric(24));
        Style.AddVarN(dst, "gap-small", t.gapSmall);
        Style.AddVarN(dst, "gap-medium", t.gapMedium);
        Style.AddVarN(dst, "gap-large", t.gapLarge);
        Style.AddVarN(dst, "space-xs", t.ScaleMetric(Space.XS));
        Style.AddVarN(dst, "space-s", t.ScaleMetric(Space.S));
        Style.AddVarN(dst, "space-sm", t.ScaleMetric(Space.SM));
        Style.AddVarN(dst, "space-m", t.ScaleMetric(Space.M));
        Style.AddVarN(dst, "space-l", t.ScaleMetric(Space.L));
        Style.AddVarN(dst, "space-xl", t.ScaleMetric(Space.XL));
        Style.AddVarN(dst, "radius-full", Radius.Full);
        Style.AddVarN(dst, "icon-size-small", t.iconSizeSmall);
        Style.AddVarN(dst, "icon-size-medium", t.iconSizeMedium);
        Style.AddVarN(dst, "icon-size-large", t.iconSizeLarge);
        Style.AddVarMs(dst, "anim-fast", Motion.Fast);
        Style.AddVarMs(dst, "anim-medium", Motion.Medium);
        Style.AddVarMs(dst, "anim-slow", Motion.Slow);
        Style.AddVar(dst, "primary", t.primary);
        Style.AddVar(dst, "info", t.info);
        Style.AddVar(dst, "success", t.success);
        Style.AddVar(dst, "warning", t.warning);
        Style.AddVar(dst, "error", t.error);
        Style.AddVar(dst, "text-primary", t.textPrimary);
        Style.AddVar(dst, "text-secondary", t.textSecondary);
        Style.AddVar(dst, "text-tertiary", t.textTertiary);
        Style.AddVar(dst, "text-disabled", t.textDisabled);
        Style.AddVar(dst, "text-inverse", t.textInverse);
        Style.AddVar(dst, "bg-primary", t.bgPrimary);
        Style.AddVar(dst, "bg-secondary", t.bgSecondary);
        Style.AddVar(dst, "bg-tertiary", t.bgTertiary);
        Style.AddVar(dst, "bg-hover", t.bgHover);
        Style.AddVar(dst, "bg-active", t.bgActive);
        Style.AddVar(dst, "bg-disabled", t.bgDisabled);
        Style.AddVar(dst, "window-bg", ColorMath.WithAlpha(t.bgPrimary, 255));
        Style.AddVar(dst, "border-primary", t.borderPrimary);
        Style.AddVar(dst, "border-secondary", t.borderSecondary);
        Style.AddVar(dst, "border-hover", t.borderHover);
        Style.AddVar(dst, "border-focus", t.borderFocus);
        Style.AddVar(dst, "divider", t.divider);
        Style.AddVar(dst, "shadow-color", t.shadowColor);
        Style.AddVar(dst, "drawer-bg", ColorMath.WithAlpha(t.bgPrimary, 255));
        Style.AddVar(dst, "drawer-edge-shadow", ColorMath.WithAlpha(t.shadowColor, 26));
        Style.AddVar(dst, "titlebar-glass-bg", ColorMath.WithAlpha(t.bgSecondary, 200));
        Style.AddVar(dst, "titlebar-glass-sheen", ColorMath.WithAlpha(t.textPrimary, 26));
        Style.AddVar(dst, "window-glass-clear", ColorMath.WithAlpha(t.bgPrimary, 198));
        Style.AddVar(dst, "window-glass-sheen", ColorMath.WithAlpha(t.textPrimary, 255));
        Style.AddVar(dst, "window-glass-edge", ColorMath.WithAlpha(t.textPrimary, 130));
        Style.AddVar(dst, "window-glass-highlight", ColorMath.WithAlpha(t.textPrimary, 70));
        Style.AddVar(dst, "styledtext-selection", ColorMath.ScaleAlpha(t.primary, 90));
        Style.AddVar(dst, "styledtext-code-bg", ColorMath.ScaleAlpha(t.bgTertiary, 160));
        Style.AddVar(dst, "styledtext-rail-success", t.success);
        Style.AddVar(dst, "styledtext-tint-success", ColorMath.ScaleAlpha(t.success, 16));
        Style.AddVar(dst, "styledtext-rail-primary", t.primary);
        Style.AddVar(dst, "styledtext-tint-primary", ColorMath.ScaleAlpha(t.primary, 34));
        Style.AddVar(dst, "styledtext-rail-tool", t.textTertiary);
        Style.AddVar(dst, "styledtext-tint-tool", ColorMath.ScaleAlpha(t.bgTertiary, 90));
        Style.AddVar(dst, "styledtext-rail-error", t.error);
        Style.AddVar(dst, "styledtext-tint-error", ColorMath.ScaleAlpha(t.error, 30));
        Style.AddVar(dst, "caption-close-bg", ColorMath.WithAlpha(Theme.Rgb(232, 17, 35), 255));
        Style.AddVar(dst, "tooltip-bg", t.tooltipBg);
        Style.AddVar(dst, "tooltip-border", t.tooltipBorder);
        Style.AddVar(dst, "tooltip-text", t.tooltipText);
        Style.AddVar(dst, "watermark-color", ColorMath.WithAlpha(t.textPrimary, 37));
        bool glass = t.glass != 0;
        int surfBg = glass ? ColorMath.ScaleAlpha(t.bgPrimary, t.glassTint) : t.bgPrimary;
        Style.AddVar(dst, "surface-bg", surfBg);
        int fieldBg = glass ? ColorMath.ScaleAlpha(t.bgPrimary, 700) : t.bgPrimary;
        Style.AddVar(dst, "field-bg", fieldBg);
        int popupBg = glass ? ColorMath.ScaleAlpha(t.bgPrimary, 820) : t.bgSecondary;
        Style.AddVar(dst, "popup-bg", popupBg);
        Style.AddVar(dst, "selection-bg", ColorMath.LerpColor(t.bgPrimary, t.primary, 96));
        Style.AddVar(dst, "scrollbar", t.scrollbar);
        Style.AddVar(dst, "scrollbar-hover", t.scrollbarHover);
        Style.AddVar(dst, "overlay", t.overlay);
        Style.AddVar(dst, "scrim", t.scrim);
        Style.AddVar(dst, "scrim-chip", t.scrimChip);
        Style.AddVar(dst, "scrim-chip-hover", t.scrimChipHover);
        Style.AddVar(dst, "on-scrim", t.onScrim);
        Style.AddVar(dst, "tooltip-text-muted", t.tooltipTextMuted);
        int dockBg = glass ? ColorMath.ScaleAlpha(t.bgTertiary, t.glassChromeTint) : t.bgTertiary;
        Style.AddVar(dst, "dock-bg", dockBg);
        Style.AddVar(dst, "drop-tint", Style.Fade(t.primary, 260));
        Style.AddVarN(dst, "surface-blur", glass ? t.glassBlur : 0);
        int surfSheen = t.surfaceSheen >= 0 ? t.surfaceSheen : (glass ? t.glassSheen : 0);
        if (surfSheen > 0 && t.surfaceSheenColor != 0) {
            dst.Add(new CssVarDecl("--surface-sheen",
                Convert.ToString(surfSheen) + " #" + Style.Hex8(t.surfaceSheenColor)));
        } else {
            Style.AddVarN(dst, "surface-sheen", surfSheen);
        }
        Style.AddVarN(dst, "surface-radius", glass ? t.glassRadius : t.borderRadiusMedium);
        Style.AddVarN(dst, "surface-border-w", 1);
        int surfShadowDy = t.surfaceShadowDy >= 0 ? t.surfaceShadowDy : (glass ? t.glassShadowDy : 2);
        int surfShadowBlur = t.surfaceShadowBlur >= 0 ? t.surfaceShadowBlur : (glass ? t.glassShadowBlur : 10);
        Style.AddVarN(dst, "surface-shadow-dy", surfShadowDy);
        Style.AddVarN(dst, "surface-shadow-blur", surfShadowBlur);
        bool isLight = t.IsLightBg();
        int focusBase = t.borderFocus != 0 ? t.borderFocus : t.primary;
        Style.AddVar(dst, "focus-ring", ColorMath.ScaleAlpha(focusBase, isLight ? 300 : 420));
        Style.AddVar(dst, "primary-glow", ColorMath.ScaleAlpha(t.primary, isLight ? 280 : 420));
        Style.AddVar(dst, "primary-grad-end", ColorMath.LerpOklab(t.primary, t.primaryPressed, 620));
        Style.AddVar(dst, "primary-hover-grad-end", ColorMath.LerpOklab(t.primaryHover, t.primary, 540));
        Style.AddVar(dst, "surface-grad-end", glass ? surfBg : ColorMath.LerpOklab(t.bgPrimary, t.bgSecondary, isLight ? 380 : 280));
        Style.AddVar(dst, "titlebar-grad-end", ColorMath.LerpOklab(t.bgSecondary, t.bgTertiary, isLight ? 340 : 420));
        Style.AddVar(dst, "btn-bg-end", ColorMath.LerpOklab(t.bgSecondary, t.bgTertiary, isLight ? 480 : 380));
        Style.AddVar(dst, "btn-hover-bg-end", ColorMath.LerpOklab(t.bgHover, t.bgTertiary, isLight ? 320 : 280));
        Style.AddVar(dst, "btn-border-top", isLight
            ? ColorMath.LerpColor(t.borderPrimary, (int)0xFFFFFFFF, 340)
            : ColorMath.LerpColor(t.borderPrimary, t.textPrimary, 140));
        Style.AddVar(dst, "btn-border-bottom", isLight
            ? ColorMath.LerpColor(t.borderPrimary, t.textPrimary, 160)
            : ColorMath.LerpColor(t.borderSecondary, (int)0xFF000000, 320));
        Style.AddVar(dst, "input-border-top", isLight
            ? ColorMath.LerpColor(t.borderPrimary, t.textPrimary, 160)
            : ColorMath.LerpColor(t.borderSecondary, (int)0xFF000000, 260));
        Style.AddVar(dst, "shadow-soft", ColorMath.ScaleAlpha(t.shadowColor, t.brutal != 0 ? 1000 : 720));
        Style.AddVar(dst, "primary-hover", t.primaryHover);
        Style.AddVar(dst, "primary-pressed", t.primaryPressed);
        Style.AddVar(dst, "info-hover", t.infoHover);
        Style.AddVar(dst, "info-pressed", t.infoPressed);
        Style.AddVar(dst, "success-hover", t.successHover);
        Style.AddVar(dst, "success-pressed", t.successPressed);
        Style.AddVar(dst, "warning-hover", t.warningHover);
        Style.AddVar(dst, "warning-pressed", t.warningPressed);
        Style.AddVar(dst, "error-hover", t.errorHover);
        Style.AddVar(dst, "error-pressed", t.errorPressed);
        Style.AddVariantVars(dst, "primary", t.primary, t.bgPrimary);
        Style.AddVariantVars(dst, "info", t.info, t.bgPrimary);
        Style.AddVariantVars(dst, "success", t.success, t.bgPrimary);
        Style.AddVariantVars(dst, "warning", t.warning, t.bgPrimary);
        Style.AddVariantVars(dst, "error", t.error, t.bgPrimary);
        Style.AddVariantVars(dst, "neutral", t.textPrimary, t.bgPrimary);
        if (isLight && t.brutal == 0) {
            Style.AddVar(dst, "disabled-bg", t.bgDisabled);
            Style.AddVar(dst, "disabled-fg", ColorMath.LerpColor(t.borderPrimary, t.textPrimary, 520));
            Style.AddVar(dst, "disabled-border", t.borderSecondary);
        } else {
            Style.AddVar(dst, "disabled-bg", t.bgDisabled);
            Style.AddVar(dst, "disabled-fg", t.textDisabled);
            Style.AddVar(dst, "disabled-border", t.borderSecondary);
        }
        Style.AddVar(dst, "code-keyword", isLight ? Theme.Rgb(126, 34, 206) : Theme.Rgb(199, 146, 234));
        Style.AddVar(dst, "code-type", isLight ? Theme.Rgb(15, 118, 110) : Theme.Rgb(86, 212, 192));
        Style.AddVar(dst, "code-string", isLight ? Theme.Rgb(21, 128, 61) : Theme.Rgb(152, 195, 121));
        Style.AddVar(dst, "code-comment", t.textTertiary);
        Style.AddVar(dst, "code-number", isLight ? Theme.Rgb(180, 83, 9) : Theme.Rgb(240, 178, 102));
        return dst;
    }
    public static string RootFromTheme(Theme t) {
        List<CssVarDecl> vars = Style.VarsFromTheme(t);
        StringBuilder sb = new StringBuilder();
        sb.Append(":root {\n");
        for (int i = 0; i < vars.Count; i = i + 1) {
            CssVarDecl vd = vars[i];
            sb.Append("  ");
            sb.Append(vd.name);
            sb.Append(": ");
            sb.Append(vd.val);
            sb.Append(";\n");
        }
        sb.Append("}\n");
        return sb.ToString();
    }
    public static string VariantTokens(string name, int tint, int surface) {
        StringBuilder sb = new StringBuilder();
        sb.Append(Style.Tok(name + "-ghost-hover-bg", ColorMath.ScaleAlpha(tint, 120)));
        sb.Append(Style.Tok(name + "-ghost-active-bg", ColorMath.ScaleAlpha(tint, 215)));
        sb.Append(Style.Tok(name + "-soft-bg", ColorMath.LerpColor(surface, tint, 90)));
        sb.Append(Style.Tok(name + "-soft-hover-bg",
                          ColorMath.LerpColor(surface, tint, 150)));
        sb.Append(Style.Tok(name + "-soft-active-bg",
                          ColorMath.LerpColor(surface, tint, 200)));
        return sb.ToString();
    }
    public static string Tok(string name, int v) {
        return "  --" + name + ": #" + Style.Hex8(v) + ";\n";
    }
    public static string TokN(string name, int v) {
        return "  --" + name + ": " + Convert.ToString(v) + ";\n";
    }
    public static string TokMs(string name, int v) {
        return "  --" + name + ": " + Convert.ToString(v) + "ms;\n";
    }
    public static string UaCss() {
        return "div, p, section, article, header, footer, nav, aside, main,"
            + " ul, ol, li, dl, dt, dd, h1, h2, h3, h4, h5, h6, blockquote,"
            + " figure, figcaption, pre, address, body, panel, card, dialog, popup { display: block; }\n"
            + "span, a, strong, em, b, i, u, s, code, small, sub, sup, abbr,"
            + " cite, q, time, mark { display: inline; }\n"
            + "p, blockquote, ul, ol, dl, figure, address, pre"
            + " { margin: 1em 0; }\n"
            + "h1 { font-size: 2em; margin: 0.67em 0; }\n"
            + "h2 { font-size: 1.5em; margin: 0.75em 0; }\n"
            + "h3 { font-size: 1.17em; margin: 0.83em 0; }\n"
            + "h4 { font-size: 1em; margin: 1em 0; }\n"
            + "h5 { font-size: 0.83em; margin: 1.5em 0; }\n"
            + "h6 { font-size: 0.67em; margin: 1.67em 0; }\n"
            + "ul, ol, dd { padding-left: 40px; }\n"
            + "pre { white-space: pre; }\n"
            + "window, .user-component { display: flex; flex-direction: column; }\n"
            + "body { margin: 0; padding: 0; }\n"
            + "a { color: var(--primary); }\n"
            + "template { display: none; }\n";
    }
    public static int FontFallback(StyleHost app, string size) {
        Theme t = app.HostTheme();
        if (size == "tiny") { return t.fontSizeTiny; }
        if (size == "small") { return t.fontSizeSmall; }
        if (size == "large") { return t.fontSizeLarge; }
        if (size == "huge") { return t.fontSizeHuge; }
        return t.fontSizeMedium;
    }
    public static string Hex8(int v) {
        int x = v;
        string outp = "";
        for (int i = 0; i < 8; i = i + 1) {
            int nib = x % 16;
            if (nib < 0) { nib = nib + 16; }
            outp = Style.HexDigit(nib) + outp;
            x = (x - nib) / 16;
        }
        return outp;
    }
    public static string HexDigit(int n) {
        if (n == 10) { return "A"; }
        if (n == 11) { return "B"; }
        if (n == 12) { return "C"; }
        if (n == 13) { return "D"; }
        if (n == 14) { return "E"; }
        if (n == 15) { return "F"; }
        return Convert.ToString(n);
    }
    public static bool FlatType(string type) {
        return type == "ribbon" || type == "label" || type == "text"
            || type == "empty" || type == "window"
            || type == "result" || type == "spin" || type == "timeline"
            || type == "steps" || type == "breadcrumb" || type == "pageheader";
    }
    public static void SizeDefaults(StyleHost app, StyleBox b, string cls) {
        Theme t = app != null ? app.HostTheme() : Theme.Light();
        if (Style.Has(cls, "tiny")) {
            b.height = t.heightTiny; b.fontPx = t.fontSizeTiny;
            b.padL = t.ScaleMetric(8); b.padR = t.ScaleMetric(8);
        } else if (Style.Has(cls, "small")) {
            b.height = t.heightSmall; b.fontPx = t.fontSizeSmall;
            b.padL = t.ScaleMetric(10); b.padR = t.ScaleMetric(10);
        } else if (Style.Has(cls, "large")) {
            b.height = t.heightLarge; b.fontPx = t.fontSizeLarge;
            b.padL = t.ScaleMetric(18); b.padR = t.ScaleMetric(18);
        } else if (Style.Has(cls, "medium")) {
            b.height = t.heightMedium; b.fontPx = t.fontSizeMedium;
            b.padL = t.ScaleMetric(14); b.padR = t.ScaleMetric(14);
        }
    }
    public static string TypeClass(int type) {
        switch (type) {
            case 1: return "primary";
            case 2: return "info";
            case 3: return "success";
            case 4: return "warning";
            case 5: return "error";
            default: return "";
        }
    }
    public static string RoleClass(string cls) {
        int i = 1;
        while (i <= 5) {
            string role = Style.TypeClass(i);
            if (Style.Has(cls, role)) { return role; }
            i = i + 1;
        }
        return "";
    }
    public static string FillClass(int fill) {
        switch (fill) {
            case 1: return "outline";
            case 2: return "text";
            case 3: return "dashed";
            default: return "";
        }
    }
    public static string SizeClass(int size) {
        switch (size) {
            case 0: return "tiny";
            case 1: return "small";
            case 3: return "large";
            default: return "medium";
        }
    }
    public static string StateClass(int index, int current, int errorIndex) {
        if (index == errorIndex) { return "error"; }
        if (index < current) { return "done"; }
        if (index == current) { return "active"; }
        return "pending";
    }
    public static int Fade(int color, int a) {
        if (a >= 1000) { return color; }
        if (a < 0) { a = 0; }
        int rgb = color % 16777216;
        if (rgb < 0) { rgb = rgb + 16777216; }
        return (255 * a / 1000) * 16777216 + rgb;
    }
    public static int TypeColor(Theme t, int type) {
        if (type == 1) { return t.primary; }
        if (type == 2) { return t.info; }
        if (type == 3) { return t.success; }
        if (type == 4) { return t.warning; }
        if (type == 5) { return t.error; }
        return t.textPrimary;
    }
    public static int TypeFill(Theme t, int type, int style, bool hovered, bool pressed) {
        int tc = Style.TypeColor(t, type);
        if (style == 1) {
            if (pressed) { return ColorMath.LerpColor(t.bgPrimary, tc, 55); }
            if (hovered) { return ColorMath.LerpColor(t.bgPrimary, tc, 28); }
            return t.bgPrimary;
        }
        if (type == 0) {
            if (pressed) { return t.bgActive; }
            if (hovered) { return t.bgHover; }
            return t.bgPrimary;
        }
        if (pressed) { return ColorMath.LerpColor(tc, (int)4278190080, 150); }
        if (hovered) { return ColorMath.LerpColor(tc, (int)4294967295, 150); }
        return tc;
    }
    public static int TypeFg(Theme t, int type, int style) {
        if (style == 1 || type == 0) {
            if (type == 0) { return t.textPrimary; }
            return Style.TypeColor(t, type);
        }
        return t.textInverse;
    }
    public static void ButtonDefaults(StyleHost app, StyleBox b, string cls, bool active,
                               bool disabled) {
        Theme t = app != null ? app.HostTheme() : Theme.Light();
        b.SetRadius(t.borderRadiusMedium);
        b.gap = t.gapSmall;
        b.align = 1;
        Style.SizeDefaults(app, b, cls);
        if (Style.Has(cls, "stacked")) {
            b.height = -1;
            b.padL = t.paddingTiny;
            b.padR = t.paddingTiny;
            b.padT = t.paddingTiny;
            b.padB = t.paddingTiny;
            b.gap = t.paddingTiny;
        }
        if (Style.Has(cls, "align-left")) { b.align = 0; }
        if (Style.Has(cls, "round") || Style.Has(cls, "circle")) { b.SetRadius(9999); }
        if (Style.Has(cls, "dashed")) { b.borderStyle = 1; }
        if (Style.Has(cls, "specular")) { b.specular = b.specular | 1; }
        if (Style.Has(cls, "spotlight")) { b.specular = b.specular | 2; }
        if (t.neu == 1 && !disabled && !Style.Has(cls, "caption")) {
            b.emboss = 1;
            if (active) { b.emboss = 2; }
        }
    }
    public static void SurfaceDefaults(StyleHost app, StyleBox b, string cls) {
        Theme t = app != null ? app.HostTheme() : Theme.Light();
        b.bg = t.bgPrimary;
        b.fg = t.textPrimary;
        b.SetRadius(t.borderRadiusMedium);
        b.borderColor = t.borderSecondary;
        b.borderW = 1;
        b.shadow = t.shadowColor;
        b.shadowDx = 1;
        b.shadowDy = 2;
        b.padL = t.paddingLarge;
        b.padT = t.paddingLarge;
        b.padR = t.paddingLarge;
        b.padB = t.paddingLarge;
        if (t.glass != 0) {
            b.blur = 36;
            b.bg = ColorMath.ScaleAlpha(t.bgPrimary, 260);
            // 不加浅色描边：每张卡片、面板和弹层外围的
            // 近白细线会显得像画上去的轮廓（并且与
            // 旁边的分隔线叠加变粗）。磨砂和色调已足够把玻璃表面
            // 与背景区分开。
            b.borderW = 0;
        }
    }
    public static void TabDefaults(StyleHost app, StyleBox b, string cls) {
        Theme t = app != null ? app.HostTheme() : Theme.Light();
        b.align = 1;
        b.gap = t.gapSmall;
        Style.SizeDefaults(app, b, cls);
        b.SetRadius(0);
        if (Style.Has(cls, "card")) {
            b.SetRadius(t.borderRadiusMedium);
        } else if (Style.Has(cls, "segment")) {
            b.SetRadius(t.borderRadiusSmall);
        }
    }
    public static void Inline(StyleBox b, StyleNode c) {
        if (c == null) { return; }
        int resolvedFont = b.fontPx;
        bool fontPhysical = b.IsPrescaled(StyleBox.SourceFont());
        c.ApplyInlineOverridesTo(b);
        StyleSheet.ReplayInline(b, c, resolvedFont, fontPhysical);
        c.ApplyMotionOverridesTo(b);
    }
}
