using System;
using System.Json;
namespace Gui;
public partial class Style {
    public static int RoleColor(Theme t, string cls, int state) {
        bool hover = (state & Style.SHover()) != 0;
        bool active = (state & Style.SActive()) != 0;
        if (Style.Has(cls, "primary")) {
            if (active) { return t.primaryPressed; }
            if (hover) { return t.primaryHover; }
            return t.primary;
        }
        if (Style.Has(cls, "info")) {
            if (active) { return t.infoPressed; }
            if (hover) { return t.infoHover; }
            return t.info;
        }
        if (Style.Has(cls, "success")) {
            if (active) { return t.successPressed; }
            if (hover) { return t.successHover; }
            return t.success;
        }
        if (Style.Has(cls, "warning")) {
            if (active) { return t.warningPressed; }
            if (hover) { return t.warningHover; }
            return t.warning;
        }
        if (Style.Has(cls, "error")) {
            if (active) { return t.errorPressed; }
            if (hover) { return t.errorHover; }
            return t.error;
        }
        return 0;
    }
    public static int RoleBase(Theme t, string cls) { return Style.RoleColor(t, cls, 0); }
    public static void Defaults(StyleHost app, StyleBox b, string type, string cls, int state) {
        Theme t = app != null ? app.HostTheme() : Theme.Light();
        bool active = (state & Style.SActive()) != 0;
        bool disabled = (state & Style.SDisabled()) != 0;
        b.fg = t.textPrimary;
        if (app != null) { Style.UnitEnvironment(app, b); }
        if (disabled) { b.fg = t.textDisabled; }
        b.accent = t.primary;
        if (type == "button" || type == "floatbutton") {
            Style.ButtonDefaults(app, b, cls, active, disabled);
        } else if (type == "tab") {
            Style.TabDefaults(app, b, cls);
        } else if (type == "tooltip") {
            b.bg = t.tooltipBg;
            b.borderColor = t.tooltipBorder;
            b.borderW = t.borderWidth;
            b.fg = t.tooltipText;
            b.radius = t.borderRadiusSmall;
        } else {
        }
        b.MarkThemeLengths();
    }
    public static void UnitEnvironment(StyleHost app, StyleBox b) {
        b.envDpiScale = app.HostDpiScale();
        Theme hostTheme = app.HostTheme();
        b.envTheme = hostTheme;
        b.envSheet = app.HostIsolateAppSheet() ? null : app.HostSheet();
        b.envRemPx = app.HostScale(16);
        int remBase = hostTheme.fontSizeMedium;
        if (remBase > 0) { b.envRootFontPx = remBase; b.envRemPhysical = true; }
        int viewportW = app.CssViewportWidth();
        int viewportH = app.CssViewportHeight();
        if (viewportW > 0) { b.envVw = viewportW; }
        if (viewportH > 0) { b.envVh = viewportH; }
        b.mediaDark = app.HostIsDark();
        b.mediaReduced = app.HostReducedMotion();
    }
    public static void Shell(StyleHost app, StyleBox b, string type, string cls, int state) {
        Theme t = app.HostTheme();
        bool active = (state & Style.SActive()) != 0;
        int surfA = StyleBox.AlphaOf(t.bgPrimary);
        if (surfA < 255 && (type == "card" || type == "panel")
        && !Style.Has(cls, "drawer-surface")) {
            if (b.bg != 0 && StyleBox.AlphaOf(b.bg) >= 255) {
                b.bg = ColorMath.WithAlpha(b.bg, surfA);
            }
            if (b.bgTo != 0 && StyleBox.AlphaOf(b.bgTo) >= 255) {
                b.bgTo = ColorMath.WithAlpha(b.bgTo, surfA);
            }
        }
        bool internalParts = type == "checkbox" || type == "radio" || type == "switch"
            || type == "slider" || type == "progress";
        bool hasFill = b.bg != 0 || b.bgTo != 0;
        if (t.brutal == 1 && hasFill && !Style.FlatType(type) && !internalParts) {
            b.shadow = t.shadowColor;
            b.shadowDx = 4;
            b.shadowDy = 4;
            b.shadowBlur = 0;
            b.borderColor = t.borderPrimary;
            b.borderW = Math.Max(t.borderWidth, 2);
            b.SetPrescaled(StyleBox.SourceBorder(), true);
            b.SetPrescaled(StyleBox.SourceShadowDx() | StyleBox.SourceShadowDy()
                | StyleBox.SourceShadowBlur(), false);
            if (active) {
                b.shadow = 0; b.tx = 4; b.ty = 4;
                b.SetPrescaled(StyleBox.SourceTx() | StyleBox.SourceTy(), false);
            }
        }
    }
    static StyleSheet BaseSheet(StyleHost app) {
        int gen = app.HostBgThemeGen();
        Dict<int, StyleSheet> baseSheets = app.HostBaseSheets();
        if (baseSheets == null || app.HostBaseSheetGen() != gen) {
            baseSheets = new Dict<int, StyleSheet>();
            app.HostSetBaseSheets(baseSheets, gen);
        }
        int scale = app.HostMetricsScale();
        StyleSheet hit;
        if (baseSheets.TryGetValue(scale, out hit)) { return hit; }
        StyleSheet made;
        string css = Skin.BaseCss();
        if (css == "") {
            made = new StyleSheet();
        } else {
            List<CssVarDecl> decls = Css.CollectVarDecls(Style.RootFromTheme(app.HostTheme()));
            made = Css.ParseWith(css, decls);
        }
        baseSheets.Add(scale, made);
        return made;
    }
    public static string RootFromTheme(Theme t) {
        StringBuilder sb = new StringBuilder();
        sb.Append(":root {\n");
        sb.Append(Style.TokN("font-size-tiny", t.fontSizeTiny));
        sb.Append(Style.TokN("font-size-small", t.fontSizeSmall));
        sb.Append(Style.TokN("font-size-medium", t.fontSizeMedium));
        sb.Append(Style.TokN("font-size-large", t.fontSizeLarge));
        sb.Append(Style.TokN("font-size-huge", t.fontSizeHuge));
        sb.Append(Style.TokN("height-tiny", t.heightTiny));
        sb.Append(Style.TokN("height-small", t.heightSmall));
        sb.Append(Style.TokN("height-medium", t.heightMedium));
        sb.Append(Style.TokN("height-large", t.heightLarge));
        sb.Append(Style.TokN("height-micro-tiny", t.iconSizeSmall));
        sb.Append(Style.TokN("height-micro-small", t.iconSizeMedium));
        sb.Append(Style.TokN("radius-small", t.borderRadiusSmall));
        sb.Append(Style.TokN("radius-medium", t.borderRadiusMedium));
        sb.Append(Style.TokN("radius-large", t.borderRadiusLarge));
        sb.Append(Style.TokN("padding-tiny", t.paddingTiny));
        sb.Append(Style.TokN("padding-small", t.paddingSmall));
        sb.Append(Style.TokN("padding-medium", t.paddingMedium));
        sb.Append(Style.TokN("padding-large", t.paddingLarge));
        sb.Append(Style.TokN("gap-small", t.gapSmall));
        sb.Append(Style.TokN("gap-medium", t.gapMedium));
        sb.Append(Style.TokN("gap-large", t.gapLarge));
        sb.Append(Style.TokN("space-xs", Space.XS));
        sb.Append(Style.TokN("space-s", Space.S));
        sb.Append(Style.TokN("space-sm", Space.SM));
        sb.Append(Style.TokN("space-m", Space.M));
        sb.Append(Style.TokN("space-l", Space.L));
        sb.Append(Style.TokN("space-xl", Space.XL));
        sb.Append(Style.TokN("radius-full", Radius.Full));
        sb.Append(Style.TokN("icon-size-small", t.iconSizeSmall));
        sb.Append(Style.TokN("icon-size-medium", t.iconSizeMedium));
        sb.Append(Style.TokN("icon-size-large", t.iconSizeLarge));
        sb.Append(Style.TokMs("anim-fast", Motion.Fast));
        sb.Append(Style.TokMs("anim-medium", Motion.Medium));
        sb.Append(Style.TokMs("anim-slow", Motion.Slow));
        sb.Append(Style.Tok("primary", t.primary));
        sb.Append(Style.Tok("info", t.info));
        sb.Append(Style.Tok("success", t.success));
        sb.Append(Style.Tok("warning", t.warning));
        sb.Append(Style.Tok("error", t.error));
        sb.Append(Style.Tok("text-primary", t.textPrimary));
        sb.Append(Style.Tok("text-secondary", t.textSecondary));
        sb.Append(Style.Tok("text-tertiary", t.textTertiary));
        sb.Append(Style.Tok("text-disabled", t.textDisabled));
        sb.Append(Style.Tok("text-inverse", t.textInverse));
        sb.Append(Style.Tok("bg-primary", t.bgPrimary));
        sb.Append(Style.Tok("bg-secondary", t.bgSecondary));
        sb.Append(Style.Tok("bg-tertiary", t.bgTertiary));
        sb.Append(Style.Tok("bg-hover", t.bgHover));
        sb.Append(Style.Tok("bg-active", t.bgActive));
        sb.Append(Style.Tok("bg-disabled", t.bgDisabled));
        // 表面透明度用于应用内合成，窗口基底仍须盖住桌面。
        sb.Append(Style.Tok("window-bg", ColorMath.WithAlpha(t.bgPrimary, 255)));
        sb.Append(Style.Tok("border-primary", t.borderPrimary));
        sb.Append(Style.Tok("border-secondary", t.borderSecondary));
        sb.Append(Style.Tok("border-hover", t.borderHover));
        sb.Append(Style.Tok("border-focus", t.borderFocus));
        sb.Append(Style.Tok("divider", t.divider));
        sb.Append(Style.Tok("shadow-color", t.shadowColor));
        sb.Append(Style.Tok("drawer-bg", ColorMath.WithAlpha(t.bgPrimary, 255)));
        sb.Append(Style.Tok("drawer-edge-shadow",
                          ColorMath.WithAlpha(t.shadowColor, 26)));
        sb.Append(Style.Tok("titlebar-glass-bg",
                          ColorMath.WithAlpha(t.bgSecondary, 200)));
        sb.Append(Style.Tok("titlebar-glass-sheen",
                          ColorMath.WithAlpha(t.textPrimary, 26)));
        sb.Append(Style.Tok("window-glass-clear",
                          ColorMath.WithAlpha(t.bgPrimary, 198)));
        sb.Append(Style.Tok("window-glass-sheen",
                          ColorMath.WithAlpha(t.textPrimary, 255)));
        sb.Append(Style.Tok("window-glass-edge",
                          ColorMath.WithAlpha(t.textPrimary, 130)));
        sb.Append(Style.Tok("window-glass-highlight",
                          ColorMath.WithAlpha(t.textPrimary, 70)));
        sb.Append(Style.Tok("styledtext-selection",
                          ColorMath.ScaleAlpha(t.primary, 90)));
        sb.Append(Style.Tok("styledtext-code-bg",
                          ColorMath.ScaleAlpha(t.bgTertiary, 160)));
        sb.Append(Style.Tok("styledtext-rail-success", t.success));
        sb.Append(Style.Tok("styledtext-tint-success",
                          ColorMath.ScaleAlpha(t.success, 16)));
        sb.Append(Style.Tok("styledtext-rail-primary", t.primary));
        sb.Append(Style.Tok("styledtext-tint-primary",
                          ColorMath.ScaleAlpha(t.primary, 34)));
        sb.Append(Style.Tok("styledtext-rail-tool", t.textTertiary));
        sb.Append(Style.Tok("styledtext-tint-tool",
                          ColorMath.ScaleAlpha(t.bgTertiary, 90)));
        sb.Append(Style.Tok("styledtext-rail-error", t.error));
        sb.Append(Style.Tok("styledtext-tint-error",
                          ColorMath.ScaleAlpha(t.error, 30)));
        // 代码编辑器语法色：默认调色板由 CodeEditor 自带（部件规则
        // 未声明时回退 EditorPalette.For），Style 不再把调色板烘进
        // token——Style 编译图因此不背 Component.CodeEditor 目录
        // （auto-stdlib 按需拉取，皮肤 core 不拉编辑器）。皮肤改写
        // codeeditor:: 部件规则即可定制配色。
        sb.Append(Style.Tok("caption-close-bg",
                          ColorMath.WithAlpha(Theme.Rgb(232, 17, 35), 255)));
        sb.Append(Style.Tok("tooltip-bg", t.tooltipBg));
        sb.Append(Style.Tok("tooltip-border", t.tooltipBorder));
        sb.Append(Style.Tok("tooltip-text", t.tooltipText));
        sb.Append(Style.Tok("watermark-color", ColorMath.WithAlpha(t.textPrimary, 37)));
        bool glass = t.glass != 0;
        int surfBg = t.bgPrimary;
        if (glass) { surfBg = ColorMath.ScaleAlpha(t.bgPrimary, t.glassTint); }
        sb.Append(Style.Tok("surface-bg", surfBg));
        int fieldBg = t.bgPrimary;
        if (glass) { fieldBg = ColorMath.ScaleAlpha(t.bgPrimary, 700); }
        sb.Append(Style.Tok("field-bg", fieldBg));
        int popupBg = t.bgSecondary;
        if (glass) { popupBg = ColorMath.ScaleAlpha(t.bgPrimary, 820); }
        sb.Append(Style.Tok("popup-bg", popupBg));
        sb.Append(Style.Tok("selection-bg",
                          ColorMath.LerpColor(t.bgPrimary, t.primary, 96)));
        sb.Append(Style.Tok("scrollbar", t.scrollbar));
        sb.Append(Style.Tok("scrollbar-hover", t.scrollbarHover));
        sb.Append(Style.Tok("overlay", t.overlay));
        sb.Append(Style.Tok("scrim", t.scrim));
        sb.Append(Style.Tok("scrim-chip", t.scrimChip));
        sb.Append(Style.Tok("scrim-chip-hover", t.scrimChipHover));
        sb.Append(Style.Tok("on-scrim", t.onScrim));
        sb.Append(Style.Tok("tooltip-text-muted", t.tooltipTextMuted));
        int dockBg = t.bgTertiary;
        if (glass) { dockBg = ColorMath.ScaleAlpha(t.bgTertiary, t.glassChromeTint); }
        sb.Append(Style.Tok("dock-bg", dockBg));
        sb.Append(Style.Tok("drop-tint", Style.Fade(t.primary, 260)));
        int surfBlur = 0;
        int surfSheen = 0;
        int surfRadius = t.borderRadiusMedium;
        int surfBorderW = 1;
        int surfShadowDy = 2;
        int surfShadowBlur = 0;
        if (glass) {
            surfBlur = t.glassBlur;
            surfSheen = t.glassSheen;
            surfRadius = t.glassRadius;
            surfBorderW = 1;
            surfShadowDy = t.glassShadowDy;
            surfShadowBlur = t.glassShadowBlur;
        }
        sb.Append(Style.TokN("surface-blur", surfBlur));
        sb.Append(Style.TokN("surface-sheen", surfSheen));
        sb.Append(Style.TokN("surface-radius", surfRadius));
        sb.Append(Style.TokN("surface-border-w", surfBorderW));
        sb.Append(Style.TokN("surface-shadow-dy", surfShadowDy));
        sb.Append(Style.TokN("surface-shadow-blur", surfShadowBlur));
        sb.Append(Style.Tok("primary-hover", t.primaryHover));
        sb.Append(Style.Tok("primary-pressed", t.primaryPressed));
        sb.Append(Style.Tok("info-hover", t.infoHover));
        sb.Append(Style.Tok("info-pressed", t.infoPressed));
        sb.Append(Style.Tok("success-hover", t.successHover));
        sb.Append(Style.Tok("success-pressed", t.successPressed));
        sb.Append(Style.Tok("warning-hover", t.warningHover));
        sb.Append(Style.Tok("warning-pressed", t.warningPressed));
        sb.Append(Style.Tok("error-hover", t.errorHover));
        sb.Append(Style.Tok("error-pressed", t.errorPressed));
        sb.Append(Style.VariantTokens("primary", t.primary, t.bgPrimary));
        sb.Append(Style.VariantTokens("info", t.info, t.bgPrimary));
        sb.Append(Style.VariantTokens("success", t.success, t.bgPrimary));
        sb.Append(Style.VariantTokens("warning", t.warning, t.bgPrimary));
        sb.Append(Style.VariantTokens("error", t.error, t.bgPrimary));
        sb.Append(Style.VariantTokens("neutral", t.textPrimary, t.bgPrimary));
        if (t.IsLightBg()) {
            sb.Append(Style.Tok("disabled-bg", t.borderPrimary));
            sb.Append(Style.Tok("disabled-fg",
                              ColorMath.LerpColor(t.borderPrimary, t.textPrimary, 110)));
            sb.Append(Style.Tok("disabled-border",
                              ColorMath.LerpColor(t.borderPrimary, t.textPrimary, 45)));
        } else {
            sb.Append(Style.Tok("disabled-bg", t.bgDisabled));
            sb.Append(Style.Tok("disabled-fg", t.textDisabled));
            sb.Append(Style.Tok("disabled-border", t.borderSecondary));
        }
        sb.Append("}\n");
        return sb.ToString();
    }
    public static string VariantTokens(string name, int tint, int surface) {
        StringBuilder sb = new StringBuilder();
        sb.Append(Style.Tok(name + "-ghost-hover-bg", ColorMath.ScaleAlpha(tint, 120)));
        sb.Append(Style.Tok(name + "-ghost-active-bg", ColorMath.ScaleAlpha(tint, 215)));
        sb.Append(Style.Tok(name + "-soft-bg", ColorMath.LerpColor(surface, tint, 90)));
        sb.Append(Style.Tok(name + "-soft-hover-bg",
                          ColorMath.LerpColor(surface, tint, 150)));
        sb.Append(Style.Tok(name + "-soft-active-bg",
                          ColorMath.LerpColor(surface, tint, 200)));
        return sb.ToString();
    }
    public static string Tok(string name, int v) {
        return "  --" + name + ": #" + Style.Hex8(v) + ";\n";
    }
    public static string TokN(string name, int v) {
        return "  --" + name + ": " + Convert.ToString(v) + ";\n";
    }
    public static string TokMs(string name, int v) {
        return "  --" + name + ": " + Convert.ToString(v) + "ms;\n";
    }
    public static string UaCss() {
        return "div, p, section, article, header, footer, nav, aside, main,"
            + " ul, ol, li, dl, dt, dd, h1, h2, h3, h4, h5, h6, blockquote,"
            + " figure, figcaption, pre, address, body, panel, card, dialog, popup { display: block; }\n"
            + "span, a, strong, em, b, i, u, s, code, small, sub, sup, abbr,"
            + " cite, q, time, mark { display: inline; }\n"
            + "p, blockquote, ul, ol, dl, figure, address, pre"
            + " { margin: 1em 0; }\n"
            + "h1 { font-size: 2em; margin: 0.67em 0; }\n"
            + "h2 { font-size: 1.5em; margin: 0.75em 0; }\n"
            + "h3 { font-size: 1.17em; margin: 0.83em 0; }\n"
            + "h4 { font-size: 1em; margin: 1em 0; }\n"
            + "h5 { font-size: 0.83em; margin: 1.5em 0; }\n"
            + "h6 { font-size: 0.67em; margin: 1.67em 0; }\n"
            + "ul, ol, dd { padding-left: 40px; }\n"
            + "pre { white-space: pre; }\n"
            + "window, .user-component { display: flex; flex-direction: column; }\n"
            + "body { margin: 0; padding: 0; }\n"
            + "a { color: var(--primary); }\n"
            + "template { display: none; }\n";
    }
    public static int FontFallback(StyleHost app, string size) {
        Theme t = app.HostTheme();
        if (size == "tiny") { return t.fontSizeTiny; }
        if (size == "small") { return t.fontSizeSmall; }
        if (size == "large") { return t.fontSizeLarge; }
        if (size == "huge") { return t.fontSizeHuge; }
        return t.fontSizeMedium;
    }
    public static string Hex8(int v) {
        int x = v;
        string outp = "";
        for (int i = 0; i < 8; i = i + 1) {
            int nib = x % 16;
            if (nib < 0) { nib = nib + 16; }
            outp = Style.HexDigit(nib) + outp;
            x = (x - nib) / 16;
        }
        return outp;
    }
    public static string HexDigit(int n) {
        if (n == 10) { return "A"; }
        if (n == 11) { return "B"; }
        if (n == 12) { return "C"; }
        if (n == 13) { return "D"; }
        if (n == 14) { return "E"; }
        if (n == 15) { return "F"; }
        return Convert.ToString(n);
    }
    public static bool FlatType(string type) {
        return type == "ribbon" || type == "label" || type == "text"
            || type == "empty" || type == "window"
            || type == "result" || type == "spin" || type == "timeline"
            || type == "steps" || type == "breadcrumb" || type == "pageheader";
    }
    public static void SizeDefaults(StyleHost app, StyleBox b, string cls) {
        Theme t = app != null ? app.HostTheme() : Theme.Light();
        if (Style.Has(cls, "tiny")) {
            b.height = t.heightTiny; b.fontPx = t.fontSizeTiny;
            b.padL = t.paddingSmall; b.padR = t.paddingSmall;
        } else if (Style.Has(cls, "small")) {
            b.height = t.heightSmall; b.fontPx = t.fontSizeSmall;
            b.padL = t.paddingMedium; b.padR = t.paddingMedium;
        } else if (Style.Has(cls, "large")) {
            b.height = t.heightLarge; b.fontPx = t.fontSizeLarge;
            b.padL = t.paddingLarge + t.gapSmall;
            b.padR = t.paddingLarge + t.gapSmall;
        } else if (Style.Has(cls, "medium")) {
            b.height = t.heightMedium; b.fontPx = t.fontSizeMedium;
            b.padL = t.paddingLarge; b.padR = t.paddingLarge;
        }
    }
    public static string TypeClass(int type) {
        switch (type) {
            case 1: return "primary";
            case 2: return "info";
            case 3: return "success";
            case 4: return "warning";
            case 5: return "error";
            default: return "";
        }
    }
    public static string RoleClass(string cls) {
        int i = 1;
        while (i <= 5) {
            string role = Style.TypeClass(i);
            if (Style.Has(cls, role)) { return role; }
            i = i + 1;
        }
        return "";
    }
    public static string FillClass(int fill) {
        switch (fill) {
            case 1: return "outline";
            case 2: return "text";
            case 3: return "dashed";
            default: return "";
        }
    }
    public static string SizeClass(int size) {
        switch (size) {
            case 0: return "tiny";
            case 1: return "small";
            case 3: return "large";
            default: return "medium";
        }
    }
    public static string StateClass(int index, int current, int errorIndex) {
        if (index == errorIndex) { return "error"; }
        if (index < current) { return "done"; }
        if (index == current) { return "active"; }
        return "pending";
    }
    public static int Fade(int color, int a) {
        if (a >= 1000) { return color; }
        if (a < 0) { a = 0; }
        int rgb = color % 16777216;
        if (rgb < 0) { rgb = rgb + 16777216; }
        return (255 * a / 1000) * 16777216 + rgb;
    }
    public static int TypeColor(Theme t, int type) {
        if (type == 1) { return t.primary; }
        if (type == 2) { return t.info; }
        if (type == 3) { return t.success; }
        if (type == 4) { return t.warning; }
        if (type == 5) { return t.error; }
        return t.textPrimary;
    }
    public static int TypeFill(Theme t, int type, int style, bool hovered, bool pressed) {
        int tc = Style.TypeColor(t, type);
        if (style == 1) {
            if (pressed) { return ColorMath.LerpColor(t.bgPrimary, tc, 55); }
            if (hovered) { return ColorMath.LerpColor(t.bgPrimary, tc, 28); }
            return t.bgPrimary;
        }
        if (type == 0) {
            if (pressed) { return t.bgActive; }
            if (hovered) { return t.bgHover; }
            return t.bgPrimary;
        }
        if (pressed) { return ColorMath.LerpColor(tc, (int)4278190080, 150); }
        if (hovered) { return ColorMath.LerpColor(tc, (int)4294967295, 150); }
        return tc;
    }
    public static int TypeFg(Theme t, int type, int style) {
        if (style == 1 || type == 0) {
            if (type == 0) { return t.textPrimary; }
            return Style.TypeColor(t, type);
        }
        return t.textInverse;
    }
    public static void ButtonDefaults(StyleHost app, StyleBox b, string cls, bool active,
                               bool disabled) {
        Theme t = app != null ? app.HostTheme() : Theme.Light();
        b.SetRadius(t.borderRadiusMedium);
        b.gap = t.gapSmall;
        b.align = 1;
        Style.SizeDefaults(app, b, cls);
        if (Style.Has(cls, "stacked")) {
            b.height = -1;
            b.padL = t.paddingTiny;
            b.padR = t.paddingTiny;
            b.padT = t.paddingTiny;
            b.padB = t.paddingTiny;
            b.gap = t.paddingTiny;
        }
        if (Style.Has(cls, "align-left")) { b.align = 0; }
        if (Style.Has(cls, "round") || Style.Has(cls, "circle")) { b.SetRadius(9999); }
        if (Style.Has(cls, "dashed")) { b.borderStyle = 1; }
        if (Style.Has(cls, "specular")) { b.specular = 1; }
        if (t.neu == 1 && !disabled) {
            b.emboss = 1;
            if (active) { b.emboss = 2; }
        }
    }
    public static void SurfaceDefaults(StyleHost app, StyleBox b, string cls) {
        Theme t = app != null ? app.HostTheme() : Theme.Light();
        b.bg = t.bgPrimary;
        b.fg = t.textPrimary;
        b.SetRadius(t.borderRadiusMedium);
        b.borderColor = t.borderSecondary;
        b.borderW = 1;
        b.shadow = t.shadowColor;
        b.shadowDx = 1;
        b.shadowDy = 2;
        b.padL = t.paddingLarge;
        b.padT = t.paddingLarge;
        b.padR = t.paddingLarge;
        b.padB = t.paddingLarge;
        if (t.glass != 0) {
            b.blur = 36;
            b.bg = ColorMath.ScaleAlpha(t.bgPrimary, 260);
            // 不加浅色描边：每张卡片、面板和弹层外围的
            // 近白细线会显得像画上去的轮廓（并且与
            // 旁边的分隔线叠加变粗）。磨砂和色调已足够把玻璃表面
            // 与背景区分开。
            b.borderW = 0;
        }
    }
    public static void TabDefaults(StyleHost app, StyleBox b, string cls) {
        Theme t = app != null ? app.HostTheme() : Theme.Light();
        b.align = 1;
        b.gap = t.gapSmall;
        Style.SizeDefaults(app, b, cls);
        b.SetRadius(0);
        if (Style.Has(cls, "card")) {
            b.SetRadius(t.borderRadiusMedium);
        } else if (Style.Has(cls, "segment")) {
            b.SetRadius(t.borderRadiusSmall);
        }
    }
    public static void Inline(StyleBox b, StyleNode c) {
        if (c == null) { return; }
        int resolvedFont = b.fontPx;
        bool fontPhysical = b.IsPrescaled(StyleBox.SourceFont());
        c.ApplyInlineOverridesTo(b);
        StyleSheet.ReplayInline(b, c, resolvedFont, fontPhysical);
    }
}
