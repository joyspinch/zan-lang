namespace Gui;

// 统一动效时长档位。
//
// **全库唯一的动效真源**：Theme 的动效默认值从这里取，CSS 侧的
// `--anim-fast/--anim-medium/--anim-slow` 令牌由 Style.RootFromTheme
// 按同一组数导出。皮肤与 IDE 壳层只引用令牌，不写裸时长。
//
// 三档的分工：
//   Fast   —— 即时反馈（悬停、按下、聚焦）100ms
//   Medium —— 状态过渡（展开收起、淡入淡出）200ms
//   Slow   —— 强调性入场、大范围变化 300ms
//
// 时长是时间不是长度：**不随 DPI/密度缩放**（与 --space-* 的逻辑像素
// 阶梯不同），因此这些令牌不在 Css.IsPhysicalThemeMetric 的名单里，
// 也不该带 px 尾巴。
//
// 氛围/装饰性循环（背景呼吸、光晕、轮播间隔）不属于响应反馈，不受这
// 三档约束——它们的节奏由内容决定，不该挤进同一把尺子。
public class Motion {
    // 即时反馈（悬停、按下、聚焦）：100ms
    const int Fast = 100;

    // 状态过渡（展开收起、淡入淡出）：200ms
    const int Medium = 200;

    // 强调性入场、大范围变化：300ms
    const int Slow = 300;
}
