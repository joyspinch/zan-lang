using System;

namespace Gui;

// 打包 ARGB 整数颜色的纯函数运算（插值、OKLCH 感知插值/明度偏移、调暗/调亮、alpha 缩放/替换）。
// 位于 Gui 根层：渲染、样式、控件各层都可直接用，不再经 App（B-ID174 从 App 拆出）。
public static class ColorMath {
    // 按千分值 p (0..1000) 混合两个打包的 ARGB 颜色，alpha 与 RGB
    // 一同插值（两端不透明时结果仍不透明）。对以负符号整数
    // 存储的颜色同样稳健。
    public static int LerpColor(int c0, int c1, int p) {
        if (c0 == c1) { return c0; }
        if (p <= 0) { return c0; }
        if (p >= 1000) { return c1; }
        int a0 = (c0 >> 24) & 255;
        int r0 = (c0 >> 16) & 255;
        int g0 = (c0 >> 8) & 255;
        int b0 = c0 & 255;
        int a1 = (c1 >> 24) & 255;
        int r1 = (c1 >> 16) & 255;
        int g1 = (c1 >> 8) & 255;
        int b1 = c1 & 255;
        int a = a0 + (a1 - a0) * p / 1000;
        int r = r0 + (r1 - r0) * p / 1000;
        int g = g0 + (g1 - g0) * p / 1000;
        int b = b0 + (b1 - b0) * p / 1000;
        return (a << 24) | (r << 16) | (g << 8) | b;
    }

    static double SrgbToLinear(int channel) {
        double c = (double)channel / 255.0;
        if (c <= 0.04045) { return c / 12.92; }
        return Math.Pow((c + 0.055) / 1.055, 2.4);
    }

    static int LinearToSrgb(double lin) {
        double v = lin;
        if (v <= 0.0) { return 0; }
        if (v >= 1.0) { return 255; }
        double s = v <= 0.0031308 ? (12.92 * v) : (1.055 * Math.Pow(v, 1.0 / 2.4) - 0.055);
        int iv = (int)(s * 255.0 + 0.5);
        if (iv < 0) { return 0; }
        if (iv > 255) { return 255; }
        return iv;
    }

    static double Cbrt(double x) {
        if (x == 0.0) { return 0.0; }
        if (x < 0.0) { return 0.0 - Math.Pow(0.0 - x, 1.0 / 3.0); }
        return Math.Pow(x, 1.0 / 3.0);
    }

    // 在 Björn Ottosson OKLab 感知均匀色彩空间中插值两个 ARGB 颜色（p = 0..1000），
    // 相比 sRGB 线性插值避免中间色发灰/掉饱和度，适合渐变终点与状态色推导。
    public static int LerpOklab(int c0, int c1, int p) {
        if (c0 == c1) { return c0; }
        if (p <= 0) { return c0; }
        if (p >= 1000) { return c1; }
        double t = (double)p / 1000.0;
        int a0 = (c0 >> 24) & 255;
        int a1 = (c1 >> 24) & 255;
        int a = a0 + (a1 - a0) * p / 1000;

        double r0 = ColorMath.SrgbToLinear((c0 >> 16) & 255);
        double g0 = ColorMath.SrgbToLinear((c0 >> 8) & 255);
        double b0 = ColorMath.SrgbToLinear(c0 & 255);
        double l0 = ColorMath.Cbrt(0.4122214708 * r0 + 0.5363325363 * g0 + 0.0514459929 * b0);
        double m0 = ColorMath.Cbrt(0.2119034982 * r0 + 0.6806995451 * g0 + 0.1073969566 * b0);
        double s0 = ColorMath.Cbrt(0.0883024619 * r0 + 0.2817188376 * g0 + 0.6299787005 * b0);
        double L0 = 0.2104542553 * l0 + 0.7936177850 * m0 - 0.0040720468 * s0;
        double A0 = 1.9779984951 * l0 - 2.4285922050 * m0 + 0.4505937099 * s0;
        double B0 = 0.0259040371 * l0 + 0.7827717662 * m0 - 0.8086757660 * s0;

        double r1 = ColorMath.SrgbToLinear((c1 >> 16) & 255);
        double g1 = ColorMath.SrgbToLinear((c1 >> 8) & 255);
        double b1 = ColorMath.SrgbToLinear(c1 & 255);
        double l1 = ColorMath.Cbrt(0.4122214708 * r1 + 0.5363325363 * g1 + 0.0514459929 * b1);
        double m1 = ColorMath.Cbrt(0.2119034982 * r1 + 0.6806995451 * g1 + 0.1073969566 * b1);
        double s1 = ColorMath.Cbrt(0.0883024619 * r1 + 0.2817188376 * g1 + 0.6299787005 * b1);
        double L1 = 0.2104542553 * l1 + 0.7936177850 * m1 - 0.0040720468 * s1;
        double A1 = 1.9779984951 * l1 - 2.4285922050 * m1 + 0.4505937099 * s1;
        double B1 = 0.0259040371 * l1 + 0.7827717662 * m1 - 0.8086757660 * s1;

        double L = L0 + (L1 - L0) * t;
        double A = A0 + (A1 - A0) * t;
        double B = B0 + (B1 - B0) * t;

        double lp = L + 0.3963377774 * A + 0.2158037573 * B;
        double mp = L - 0.1055613458 * A - 0.0638541728 * B;
        double sp = L - 0.0894841775 * A - 1.2914855480 * B;
        double ll = lp * lp * lp;
        double mm = mp * mp * mp;
        double ss = sp * sp * sp;
        int rr = ColorMath.LinearToSrgb(+4.0767416621 * ll - 3.3077115913 * mm + 0.2309699292 * ss);
        int gg = ColorMath.LinearToSrgb(-1.2684380046 * ll + 2.6097574011 * mm - 0.3413193965 * ss);
        int bb = ColorMath.LinearToSrgb(-0.0041960863 * ll - 0.7034186147 * mm + 1.7076147010 * ss);
        return (a << 24) | (rr << 16) | (gg << 8) | bb;
    }

    // 保持 OKLab 色相与色度纯正，仅沿感知明度 L 偏移 deltaPm（-1000..+1000，例如 -60 表示微微压暗 6%）。
    public static int ShiftLightness(int color, int deltaPm) {
        if (deltaPm == 0) { return color; }
        int a = (color >> 24) & 255;
        double r0 = ColorMath.SrgbToLinear((color >> 16) & 255);
        double g0 = ColorMath.SrgbToLinear((color >> 8) & 255);
        double b0 = ColorMath.SrgbToLinear(color & 255);
        double l0 = ColorMath.Cbrt(0.4122214708 * r0 + 0.5363325363 * g0 + 0.0514459929 * b0);
        double m0 = ColorMath.Cbrt(0.2119034982 * r0 + 0.6806995451 * g0 + 0.1073969566 * b0);
        double s0 = ColorMath.Cbrt(0.0883024619 * r0 + 0.2817188376 * g0 + 0.6299787005 * b0);
        double L = 0.2104542553 * l0 + 0.7936177850 * m0 - 0.0040720468 * s0 + (double)deltaPm / 1000.0;
        double A = 1.9779984951 * l0 - 2.4285922050 * m0 + 0.4505937099 * s0;
        double B = 0.0259040371 * l0 + 0.7827717662 * m0 - 0.8086757660 * s0;
        if (L < 0.0) { L = 0.0; }
        if (L > 1.0) { L = 1.0; }
        double lp = L + 0.3963377774 * A + 0.2158037573 * B;
        double mp = L - 0.1055613458 * A - 0.0638541728 * B;
        double sp = L - 0.0894841775 * A - 1.2914855480 * B;
        double ll = lp * lp * lp;
        double mm = mp * mp * mp;
        double ss = sp * sp * sp;
        int rr = ColorMath.LinearToSrgb(+4.0767416621 * ll - 3.3077115913 * mm + 0.2309699292 * ss);
        int gg = ColorMath.LinearToSrgb(-1.2684380046 * ll + 2.6097574011 * mm - 0.3413193965 * ss);
        int bb = ColorMath.LinearToSrgb(-0.0041960863 * ll - 0.7034186147 * mm + 1.7076147010 * ss);
        return (a << 24) | (rr << 16) | (gg << 8) | bb;
    }

    // 按千分值 p (0..1000) 将打包颜色向不透明黑色调暗：
    // 一个命名的阴影锚点，控件无需内联写出黑色常量。
    public static int Darken(int color, int p) { return ColorMath.LerpColor(color, (int)4278190080, p); }

    // 按千分值 p (0..1000) 将打包颜色向不透明白色调亮。
    public static int Lighten(int color, int p) { return ColorMath.LerpColor(color, (int)4294967295, p); }

    // 按千分值 p (0..1000) 缩放打包颜色已有的 alpha 通道，
    // 保留其 RGB。p=1000 返回原色，p=0 使其完全
    // 透明。对不透明颜色和已带 alpha 的颜色（如玻璃色板）都有效，
    // 因此填充/遮罩可以淡入淡出。
    // 对符号整数颜色打包稳健（见 LerpColor）。
    public static int ScaleAlpha(int color, int p) {
        if (p >= 1000) { return color; }
        if (p <= 0) { return color & 16777215; }
        int a = (((color >> 24) & 255) * p) / 1000;
        return (color & 16777215) | (a << 24);
    }

    // 把打包颜色的 alpha 通道替换为 alpha（0..255，越界钳制），保留 RGB。
    public static int WithAlpha(int color, int alpha) {
        int a = alpha;
        if (a < 0) { a = 0; }
        if (a > 255) { a = 255; }
        return (color & 16777215) | (a << 24);
    }
}
