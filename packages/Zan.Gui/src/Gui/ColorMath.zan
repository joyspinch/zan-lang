namespace Gui;

// 打包 ARGB 整数颜色的纯函数运算（插值、调暗/调亮、alpha 缩放/替换）。
// 位于 Gui 根层：渲染、样式、控件各层都可直接用，不再经 App（B-ID174 从 App 拆出）。
public static class ColorMath {
    // 按千分值 p (0..1000) 混合两个打包的 ARGB 颜色，alpha 与 RGB
    // 一同插值（两端不透明时结果仍不透明）。对以负符号整数
    // 存储的颜色同样稳健。
    public static int LerpColor(int c0, int c1, int p) {
        if (c0 == c1) { return c0; }
        if (p <= 0) { return c0; }
        if (p >= 1000) { return c1; }
        int a0 = (c0 >> 24) & 255;
        int r0 = (c0 >> 16) & 255;
        int g0 = (c0 >> 8) & 255;
        int b0 = c0 & 255;
        int a1 = (c1 >> 24) & 255;
        int r1 = (c1 >> 16) & 255;
        int g1 = (c1 >> 8) & 255;
        int b1 = c1 & 255;
        int a = a0 + (a1 - a0) * p / 1000;
        int r = r0 + (r1 - r0) * p / 1000;
        int g = g0 + (g1 - g0) * p / 1000;
        int b = b0 + (b1 - b0) * p / 1000;
        return (a << 24) | (r << 16) | (g << 8) | b;
    }

    // 按千分值 p (0..1000) 将打包颜色向不透明黑色调暗：
    // 一个命名的阴影锚点，控件无需内联写出黑色常量。
    public static int Darken(int color, int p) { return ColorMath.LerpColor(color, (int)4278190080, p); }

    // 按千分值 p (0..1000) 将打包颜色向不透明白色调亮。
    public static int Lighten(int color, int p) { return ColorMath.LerpColor(color, (int)4294967295, p); }

    // 按千分值 p (0..1000) 缩放打包颜色已有的 alpha 通道，
    // 保留其 RGB。p=1000 返回原色，p=0 使其完全
    // 透明。对不透明颜色和已带 alpha 的颜色（如玻璃色板）都有效，
    // 因此填充/遮罩可以淡入淡出。
    // 对符号整数颜色打包稳健（见 LerpColor）。
    public static int ScaleAlpha(int color, int p) {
        if (p >= 1000) { return color; }
        if (p <= 0) { return color & 16777215; }
        int a = (((color >> 24) & 255) * p) / 1000;
        return (color & 16777215) | (a << 24);
    }

    // 把打包颜色的 alpha 通道替换为 alpha（0..255，越界钳制），保留 RGB。
    public static int WithAlpha(int color, int alpha) {
        int a = alpha;
        if (a < 0) { a = 0; }
        if (a > 255) { a = 255; }
        return (color & 16777215) | (a << 24);
    }
}
