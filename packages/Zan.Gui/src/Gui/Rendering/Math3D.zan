using System;
using System.Runtime.Intrinsics;

namespace Gui;

// 3D 数学：行主序 4x4 矩阵（float[16]，下标 row*4+col）、
// 右手坐标系（+y 上、+z 朝向观察者、-z 为视线方向）、列向量约定
// （v' = M * v）。组合顺序与约定一致：Mvp = P * V * M。
// 这个层是纯 Zan：矩阵只在 CPU 上组合一次再交给运行时的 3D 管线
// （Canvas.DrawMesh3D），不参与逐顶点运算——后者是后端（GPU 或
// 未来的 CPU 软光栅）的事。
class Mat4 {
    public float[] m;  // row-major, m[row*4+col]

    public Mat4() { this.m = new float[16]; }

    // 单位矩阵。
    public static Mat4 Identity() {
        Mat4 r = new Mat4();
        r.m[0] = 1; r.m[5] = 1; r.m[10] = 1; r.m[15] = 1;
        return r;
    }

    public static Mat4 Translate(float x, float y, float z) {
        Mat4 r = Mat4.Identity();
        r.m[3] = x; r.m[7] = y; r.m[11] = z;
        return r;
    }

    public static Mat4 Scale(float x, float y, float z) {
        Mat4 r = new Mat4();
        r.m[0] = x; r.m[5] = y; r.m[10] = z; r.m[15] = 1;
        return r;
    }

    // 绕任意单位轴的旋转（Rodrigues 公式展开），角度弧度。
    public static Mat4 RotateAxis(float ax, float ay, float az, float rad) {
        float len = (float)Math.Sqrt(ax * ax + ay * ay + az * az);
        if (len < 1e-8f) { return Mat4.Identity(); }
        ax = ax / len; ay = ay / len; az = az / len;
        float c = (float)Math.Cos(rad);
        float s = (float)Math.Sin(rad);
        float t = 1.0f - c;
        Mat4 r = new Mat4();
        r.m[0] = t * ax * ax + c;
        r.m[1] = t * ax * ay - s * az;
        r.m[2] = t * ax * az + s * ay;
        r.m[4] = t * ax * ay + s * az;
        r.m[5] = t * ay * ay + c;
        r.m[6] = t * ay * az - s * ax;
        r.m[8] = t * ax * az - s * ay;
        r.m[9] = t * ay * az + s * ax;
        r.m[10] = t * az * az + c;
        r.m[15] = 1;
        return r;
    }

    // 矩阵乘 this * b（先施 b 再施 this，与 v' = M*v 一致）。
    // 采用 Vector128 FMA 融和乘加向量化流水线加速计算。
    public static Mat4 Mul(Mat4 a, Mat4 b) {
        Mat4 r = new Mat4();
        Vector128 b0 = Vector128.Load(b.m, 0);
        Vector128 b1 = Vector128.Load(b.m, 4);
        Vector128 b2 = Vector128.Load(b.m, 8);
        Vector128 b3 = Vector128.Load(b.m, 12);

        for (int i = 0; i < 4; i = i + 1) {
            int off = i * 4;
            Vector128 a0 = Vector128.Create(a.m[off + 0]);
            Vector128 a1 = Vector128.Create(a.m[off + 1]);
            Vector128 a2 = Vector128.Create(a.m[off + 2]);
            Vector128 a3 = Vector128.Create(a.m[off + 3]);
            Vector128 row = Vector128.Multiply(a0, b0);
            row = Vector128.MultiplyAdd(a1, b1, row);
            row = Vector128.MultiplyAdd(a2, b2, row);
            row = Vector128.MultiplyAdd(a3, b3, row);
            Vector128.Store(r.m, off, row);
        }
        return r;
    }

    public Mat4 Mul(Mat4 b) { return Mat4.Mul(this, b); }

    // 使用当前矩阵对批量 3D 顶点 (x, y, z) 进行批量坐标变换（FMA 融和乘加向量化流水线）。
    // inXyz: 输入顶点数组，每顶点占 3 个 float。
    // outXyz: 输出顶点数组，每顶点占 3 个 float。
    // count: 顶点数量。
    public void TransformPoints(float[] inXyz, int inOffset, float[] outXyz, int outOffset, int count) {
        if (inXyz == null || outXyz == null || count <= 0) return;

        Vector128 c0 = Vector128.Create(this.m[0], this.m[4], this.m[8], this.m[12]);
        Vector128 c1 = Vector128.Create(this.m[1], this.m[5], this.m[9], this.m[13]);
        Vector128 c2 = Vector128.Create(this.m[2], this.m[6], this.m[10], this.m[14]);
        Vector128 c3 = Vector128.Create(this.m[3], this.m[7], this.m[11], this.m[15]);

        float[] tmp = new float[4];

        for (int i = 0; i < count; i = i + 1) {
            int srcIdx = inOffset + i * 3;
            int dstIdx = outOffset + i * 3;

            Vector128 vx = Vector128.Create(inXyz[srcIdx + 0]);
            Vector128 vy = Vector128.Create(inXyz[srcIdx + 1]);
            Vector128 vz = Vector128.Create(inXyz[srcIdx + 2]);

            // P' = c3 + vx*c0 + vy*c1 + vz*c2
            Vector128 r = Vector128.MultiplyAdd(vx, c0, c3);
            r = Vector128.MultiplyAdd(vy, c1, r);
            r = Vector128.MultiplyAdd(vz, c2, r);

            Vector128.Store(tmp, 0, r);
            outXyz[dstIdx + 0] = tmp[0];
            outXyz[dstIdx + 1] = tmp[1];
            outXyz[dstIdx + 2] = tmp[2];
        }
    }

    // 使用当前矩阵对批量 4D 齐次坐标 (x, y, z, w) 进行批量变换，单周期 16 字节对齐写出。
    public void TransformPoints4(float[] inXyzw, int inOffset, float[] outXyzw, int outOffset, int count) {
        if (inXyzw == null || outXyzw == null || count <= 0) return;

        Vector128 c0 = Vector128.Create(this.m[0], this.m[4], this.m[8], this.m[12]);
        Vector128 c1 = Vector128.Create(this.m[1], this.m[5], this.m[9], this.m[13]);
        Vector128 c2 = Vector128.Create(this.m[2], this.m[6], this.m[10], this.m[14]);
        Vector128 c3 = Vector128.Create(this.m[3], this.m[7], this.m[11], this.m[15]);

        for (int i = 0; i < count; i = i + 1) {
            int srcIdx = inOffset + i * 4;
            int dstIdx = outOffset + i * 4;

            Vector128 vx = Vector128.Create(inXyzw[srcIdx + 0]);
            Vector128 vy = Vector128.Create(inXyzw[srcIdx + 1]);
            Vector128 vz = Vector128.Create(inXyzw[srcIdx + 2]);
            Vector128 vw = Vector128.Create(inXyzw[srcIdx + 3]);

            Vector128 r = Vector128.Multiply(vx, c0);
            r = Vector128.MultiplyAdd(vy, c1, r);
            r = Vector128.MultiplyAdd(vz, c2, r);
            r = Vector128.MultiplyAdd(vw, c3, r);

            Vector128.Store(outXyzw, dstIdx, r);
        }
    }

    // 透视投影（D3D 风格深度 0..1），fovY 弧度，近远必须为正。
    public static Mat4 Perspective(float fovYRad, float aspect, float nearZ, float farZ) {
        Mat4 r = new Mat4();
        float f = 1.0f / (float)Math.Tan(fovYRad / 2.0f);
        r.m[0] = f / aspect;
        r.m[5] = f;
        r.m[10] = farZ / (nearZ - farZ);
        r.m[11] = (nearZ * farZ) / (nearZ - farZ);
        r.m[14] = -1;
        return r;
    }

    // 正交投影（D3D 风格深度 0..1），窗口 3D 视图与 HUD 场景用。
    public static Mat4 Ortho(float left, float right, float bottom, float top,
                             float nearZ, float farZ) {
        Mat4 r = Mat4.Identity();
        r.m[0] = 2.0f / (right - left);
        r.m[5] = 2.0f / (top - bottom);
        r.m[10] = 1.0f / (nearZ - farZ);
        r.m[11] = nearZ / (nearZ - farZ);
        r.m[3] = (left + right) / (left - right);
        r.m[7] = (top + bottom) / (bottom - top);
        return r;
    }

    // lookAt 视图矩阵（右手系，eye 望向 target，up 任意非零）。
    public static Mat4 LookAt(float ex, float ey, float ez,
                              float tx, float ty, float tz,
                              float ux, float uy, float uz) {
        // forward = normalize(eye - target)（右手系：相机看向 -z）
        float fx = ex - tx, fy = ey - ty, fz = ez - tz;
        float fl = (float)Math.Sqrt(fx * fx + fy * fy + fz * fz);
        if (fl < 1e-8f) { fx = 0; fy = 0; fz = -1; } else { fx /= fl; fy /= fl; fz /= fl; }
        // right = normalize(up × forward)
        float rx = uy * fz - uz * fy;
        float ry = uz * fx - ux * fz;
        float rz = ux * fy - uy * fx;
        float rl = (float)Math.Sqrt(rx * rx + ry * ry + rz * rz);
        if (rl < 1e-8f) { rx = 1; ry = 0; rz = 0; } else { rx /= rl; ry /= rl; rz /= rl; }
        // up' = forward × right
        float nx = fy * rz - fz * ry;
        float ny = fz * rx - fx * rz;
        float nz = fx * ry - fy * rx;
        Mat4 r = new Mat4();
        r.m[0] = rx; r.m[1] = ry; r.m[2] = rz;
        r.m[4] = nx; r.m[5] = ny; r.m[6] = nz;
        r.m[8] = fx; r.m[9] = fy; r.m[10] = fz;
        r.m[3] = -(rx * ex + ry * ey + rz * ez);
        r.m[7] = -(nx * ex + ny * ey + nz * ez);
        r.m[11] = -(fx * ex + fy * ey + fz * ez);
        r.m[15] = 1;
        return r;
    }

    // 转列主序 float[16]（GPU 侧 uniformMatrix4fv 的约定）。
    public float[] ToColumnMajor() {
        float[] outM = new float[16];
        for (int row = 0; row < 4; row = row + 1) {
            for (int col = 0; col < 4; col = col + 1) {
                outM[col * 4 + row] = this.m[row * 4 + col];
            }
        }
        return outM;
    }
}

// 网格构建器：交错顶点（px,py,pz, nx,ny,nz, u,v，每顶点 8 个 float）
// + ushort 索引，与运行时 3D 管线的顶点布局逐字节对应。Build 之后可复用
// Upload 到不同表面。
class Mesh3D {
    List<float> v;
    List<ushort> idx;

    public Mesh3D() {
        this.v = new List<float>();
        this.idx = new List<ushort>();
    }

    // 追加一个顶点，返回其索引。
    public int Vertex(float px, float py, float pz,
                      float nx, float ny, float nz,
                      float u, float vv) {
        this.v.Add(px); this.v.Add(py); this.v.Add(pz);
        this.v.Add(nx); this.v.Add(ny); this.v.Add(nz);
        this.v.Add(u); this.v.Add(vv);
        return this.v.Count / 8 - 1;
    }

    // 按逆时针（从观察方向看）追加一个三角形，保证正面朝外。
    public void Triangle(int a, int b, int c) {
        this.idx.Add((ushort)a);
        this.idx.Add((ushort)b);
        this.idx.Add((ushort)c);
    }

    // 两个三角形组成一个四边形（a,b,c,d 逆时针）。
    public void Quad(int a, int b, int c, int d) {
        this.Triangle(a, b, c);
        this.Triangle(a, c, d);
    }

    public int VertexCount() { return this.v.Count / 8; }
    public int IndexCount() { return this.idx.Count; }

    // 交错顶点缓冲（Canvas.MeshUpload 封送用）。
    public float[] VertexArray() {
        int n = this.v.Count;
        float[] outv = new float[n];
        for (int i = 0; i < n; i = i + 1) { outv[i] = this.v[i]; }
        return outv;
    }

    // 三角索引缓冲（Canvas.MeshUpload 封送用）。
    public ushort[] IndexArray() {
        int n = this.idx.Count;
        ushort[] outi = new ushort[n];
        for (int i = 0; i < n; i = i + 1) { outi[i] = this.idx[i]; }
        return outi;
    }

    // 以单位立方体（边长 2，中心原点）填充此网格，六面 UV 全贴。
    public void AddCube() {
        // +z front
        int a = this.Vertex(-1, -1, 1, 0, 0, 1, 0, 1);
        int b = this.Vertex(1, -1, 1, 0, 0, 1, 1, 1);
        int c = this.Vertex(1, 1, 1, 0, 0, 1, 1, 0);
        int d = this.Vertex(-1, 1, 1, 0, 0, 1, 0, 0);
        this.Quad(a, b, c, d);
        // -z back
        a = this.Vertex(1, -1, -1, 0, 0, -1, 0, 1);
        b = this.Vertex(-1, -1, -1, 0, 0, -1, 1, 1);
        c = this.Vertex(-1, 1, -1, 0, 0, -1, 1, 0);
        d = this.Vertex(1, 1, -1, 0, 0, -1, 0, 0);
        this.Quad(a, b, c, d);
        // +x right
        a = this.Vertex(1, -1, 1, 1, 0, 0, 0, 1);
        b = this.Vertex(1, -1, -1, 1, 0, 0, 1, 1);
        c = this.Vertex(1, 1, -1, 1, 0, 0, 1, 0);
        d = this.Vertex(1, 1, 1, 1, 0, 0, 0, 0);
        this.Quad(a, b, c, d);
        // -x left
        a = this.Vertex(-1, -1, -1, -1, 0, 0, 0, 1);
        b = this.Vertex(-1, -1, 1, -1, 0, 0, 1, 1);
        c = this.Vertex(-1, 1, 1, -1, 0, 0, 1, 0);
        d = this.Vertex(-1, 1, -1, -1, 0, 0, 0, 0);
        this.Quad(a, b, c, d);
        // +y top
        a = this.Vertex(-1, 1, 1, 0, 1, 0, 0, 1);
        b = this.Vertex(1, 1, 1, 0, 1, 0, 1, 1);
        c = this.Vertex(1, 1, -1, 0, 1, 0, 1, 0);
        d = this.Vertex(-1, 1, -1, 0, 1, 0, 0, 0);
        this.Quad(a, b, c, d);
        // -y bottom
        a = this.Vertex(-1, -1, -1, 0, -1, 0, 0, 1);
        b = this.Vertex(1, -1, -1, 0, -1, 0, 1, 1);
        c = this.Vertex(1, -1, 1, 0, -1, 0, 1, 0);
        d = this.Vertex(-1, -1, 1, 0, -1, 0, 0, 0);
        this.Quad(a, b, c, d);
    }

    // 以 XZ 平面圆盘（n 边形，法线 +y）填充，UV 极坐标展开。
    public void AddGroundDisc(int n, float radius) {
        int center = this.Vertex(0, 0, 0, 0, 1, 0, 0.5f, 0.5f);
        int first = this.Vertex(radius, 0, 0, 0, 1, 0, 1, 0.5f);
        int prev = first;
        for (int i = 1; i <= n; i = i + 1) {
            float ang = (float)(2.0 * Math.PI * i / n);
            float x = (float)Math.Cos(ang) * radius;
            float z = (float)Math.Sin(ang) * radius;
            int cur = this.Vertex(x, 0, z, 0, 1, 0,
                                  0.5f + 0.5f * (float)Math.Cos(ang),
                                  0.5f + 0.5f * (float)Math.Sin(ang));
            if (i < n) { this.Triangle(center, prev, cur); }
            prev = cur;
        }
        this.Triangle(center, prev, first);
    }
}
