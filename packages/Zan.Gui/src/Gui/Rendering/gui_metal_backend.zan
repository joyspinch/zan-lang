namespace Gui.Rendering;

using System;

/// <summary>
/// 纯 Zan 原生 Apple Metal GPU 渲染后端与优雅降级管线。
/// 彻底替代旧 Objective-C gui_metal_backend.m，对接系统硬件加速能力与 CPU 软光栅后备管线。
/// 符号命名符合 C-ABI 约定，在 Mach-O 上为 _zan_gui_internal_metal_*，在 ELF 上为 zan_gui_internal_metal_*。
/// </summary>
public class zan_gui {
    static int isSupported = -1;
    static int isInstalled = 0;
    static nint device = (nint)0;
    static nint queue = (nint)0;

    [DllImport("Metal", EntryPoint = "MTLCreateSystemDefaultDevice")]
    static extern nint MTLCreateSystemDefaultDevice();

    public static int internal_metal_supported() {
        if (isSupported >= 0) {
            return isSupported;
        }
        #if MACOS
        nint dev = MTLCreateSystemDefaultDevice();
        if (dev != (nint)0) {
            isSupported = 1;
            return 1;
        }
        #endif
        isSupported = 0;
        return 0;
    }

    public static int internal_metal_install() {
        if (isInstalled > 0) {
            return isSupported > 0 ? 1 : 0;
        }
        #if MACOS
        device = MTLCreateSystemDefaultDevice();
        if (device != (nint)0) {
            isSupported = 1;
            isInstalled = 1;
            return 1;
        }
        #endif
        isSupported = 0;
        isInstalled = 1;
        return 0;
    }

    public static void internal_metal_drop_present() {
        device = (nint)0;
        queue = (nint)0;
        isInstalled = 0;
        isSupported = -1;
    }
}
