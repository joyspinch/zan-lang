using System.Collections.Generic;
using System;

namespace Gui;

// Value token for a synchronous paint segment (PaintHash.BeginScope). Commit/Restore in LIFO order;
// PaintHash.Restore belongs in finally even when painting throws before App.CommitPaintHash.
public struct PaintHashToken {
    internal bool armed;
    internal long accumulator;
}

public class RenderBackend {
    static int Cpu() { return 0; }
    static int Gpu() { return 1; }
    static int Auto() { return 2; }
}

public interface RenderHost {
    int HostNowMs();
    Canvas HostCanvas();
    int HostScale(int v);
    int HostMouseX();
    int HostMouseY();
    void RequestAnimationFrameIn(int x, int y, int w, int h);
    int StyleHoverLevelIn(int id, int ms, int x, int y, int w, int h);
    void Post(Action handler);
    void RequestRedraw();
}
