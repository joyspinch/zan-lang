using System;
using Gui;
namespace Gui;
public class Fx {
    static int Ease(int p) {
        if (p <= 0) { return 0; }
        if (p >= 1000) { return 1000; }
        int t2 = p * p / 1000;
        int t3 = t2 * p / 1000;
        return 3 * t2 - 2 * t3;
    }
    static int WithAlpha(int color, int alpha) {
        int a = alpha;
        if (a < 0) { a = 0; }
        if (a > 255) { a = 255; }
        return (color & 16777215) | (a << 24);
    }
    static int ScaleAlpha(int color, int p) {
        if (p >= 1000) { return color; }
        if (p <= 0) { return color & 16777215; }
        int a = (((color >> 24) & 255) * p) / 1000;
        return (color & 16777215) | (a << 24);
    }
    static int LerpColor(int c0, int c1, int p) {
        if (c0 == c1) { return c0; }
        if (p <= 0) { return c0; }
        if (p >= 1000) { return c1; }
        int a0 = (c0 >> 24) & 255;
        int r0 = (c0 >> 16) & 255;
        int g0 = (c0 >> 8) & 255;
        int b0 = c0 & 255;
        int a1 = (c1 >> 24) & 255;
        int r1 = (c1 >> 16) & 255;
        int g1 = (c1 >> 8) & 255;
        int b1 = c1 & 255;
        int a = a0 + (a1 - a0) * p / 1000;
        int r = r0 + (r1 - r0) * p / 1000;
        int g = g0 + (g1 - g0) * p / 1000;
        int b = b0 + (b1 - b0) * p / 1000;
        return (a << 24) | (r << 16) | (g << 8) | b;
    }
    static int Saw(RenderHost app, int periodMs) {
        if (periodMs <= 0) { return 0; }
        int m = app.HostNowMs() % periodMs;
        if (m < 0) { m = m + periodMs; }
        return m * 1000 / periodMs;
    }
    static int Pulse(RenderHost app, int periodMs) {
        int s = Fx.Saw(app, periodMs);
        int tri = s * 2;
        if (tri > 1000) { tri = 2000 - tri; }
        return Fx.Ease(tri);
    }
    static int Isqrt(int n) {
        if (n <= 0) { return 0; }
        int x = n;
        int y = (x + 1) / 2;
        while (y < x) {
            x = y;
            y = (x + n / x) / 2;
        }
        return x;
    }
    static void PointGlow(Canvas c, int cx, int cy, int r, int color, int maxAlpha) {
        if (r <= 0 || maxAlpha <= 0) { return; }
        c.FillRadial(cx, cy, r, color, maxAlpha);
    }
    static void BorderGlow(RenderHost app, int x, int y, int w, int h,
                           int radius, int color, int periodMs, int intensity) {
        Canvas c = app.HostCanvas();
        int per = 2 * (w + h);
        if (per <= 0) { return; }
        int head = Fx.Saw(app, periodMs) * per / 1000;
        int gr = app.HostScale(3);  // 细：约为边框线宽
        int half = per / 2;
        int reach = per * 30 / 100;  // 明亮扫描带的半长
        if (reach < 1) { reach = 1; }
        int rim = intensity * 12 / 100;  // 微弱常驻边缘光
        int steps = per / app.HostScale(4);
        if (steps < 48) { steps = 48; }
        if (steps > 200) { steps = 200; }
        for (int i = 0; i < steps; i = i + 1) {
            int d = i * per / steps;
            int dd = d - head;
            if (dd < 0) { dd = dd + per; }
            if (dd > half) { dd = per - dd; }
            int a = rim;
            if (dd < reach) {
                int p = Fx.Ease((reach - dd) * 1000 / reach);
                a = rim + (intensity - rim) * p / 1000;
            }
            if (a > 0) {
                int px = x; int py = y;
                if (d < w) {
                    px = x + d; py = y;
                } else if (d < w + h) {
                    px = x + w; py = y + (d - w);
                } else if (d < w + h + w) {
                    px = x + w - (d - w - h); py = y + h;
                } else {
                    px = x; py = y + h - (d - w - h - w);
                }
                c.FillRadial(px, py, gr, color, a);
            }
        }
        app.RequestAnimationFrameIn(x, y, w, h);
    }
    static void Emboss(RenderHost app, int x, int y, int w, int h, int radius,
                       bool pressed, int bgPrimary) {
        Canvas c = app.HostCanvas();
        int off = app.HostScale(4);
        int lite = ColorMath.LerpColor(bgPrimary, (int)4294967295, 70);
        int dark = ColorMath.LerpColor(bgPrimary, (int)4278190080, 45);
        int up = lite;
        int down = dark;
        if (pressed) { up = dark; down = lite; }
        c.FillRoundRect(x - off, y - off, w, h, radius, up);
        c.FillRoundRect(x + off, y + off, w, h, radius, down);
    }
    static void DashedBorder(RenderHost app, int x, int y, int w, int h, int color) {
        Canvas c = app.HostCanvas();
        int dl = app.HostScale(6);
        int step = dl + app.HostScale(4);
        if (step < 1) { step = 1; }
        int hx = x;
        while (hx < x + w) {
            int seg = dl;
            if (hx + seg > x + w) { seg = x + w - hx; }
            c.FillRect(hx, y, seg, 1, color);
            c.FillRect(hx, y + h - 1, seg, 1, color);
            hx = hx + step;
        }
        int vy = y;
        while (vy < y + h) {
            int seg = dl;
            if (vy + seg > y + h) { seg = y + h - vy; }
            c.FillRect(x, vy, 1, seg, color);
            c.FillRect(x + w - 1, vy, 1, seg, color);
            vy = vy + step;
        }
    }
    static void Specular(RenderHost app, int id, int x, int y, int w, int h,
                         int radius, int color) {
        int hv = app.StyleHoverLevelIn(id, 0, x, y, w, h);
        Fx.SpecularBorderHv(app, x, y, w, h, radius, color, hv);
    }
    static void SpecularRun(RenderHost app, int x, int y, int w, int h,
                            int radius, int color, int periodMs) {
        Canvas c = app.HostCanvas();
        int per = 2 * (w + h);
        if (per <= 0) { return; }
        int head = Fx.Saw(app, periodMs) * per / 1000;
        int half = per / 2;
        int reach = per * 11 / 100;  // 短促紧凑的亮点
        if (reach < 1) { reach = 1; }
        int rim = 20;  // 微弱常驻边缘光
        int gr = app.HostScale(7);
        int steps = per / app.HostScale(5);
        if (steps < 40) { steps = 40; }
        if (steps > 260) { steps = 260; }
        c.PushClip(x, y, w, h);
        for (int i = 0; i < steps; i = i + 1) {
            int d = i * per / steps;
            int dd = d - head;
            if (dd < 0) { dd = dd + per; }
            if (dd > half) { dd = per - dd; }
            int a = rim;
            if (dd < reach) {
                int p = Fx.Ease((reach - dd) * 1000 / reach);
                a = rim + (215 - rim) * p / 1000;
            }
            if (a > 0) {
                int px = x; int py = y;
                if (d < w) {
                    px = x + d; py = y;
                } else if (d < w + h) {
                    px = x + w; py = y + (d - w);
                } else if (d < w + h + w) {
                    px = x + w - (d - w - h); py = y + h;
                } else {
                    px = x; py = y + h - (d - w - h - w);
                }
                c.FillRadial(px, py, gr, color, a);
            }
        }
        int hx = x; int hy = y;
        if (head < w) { hx = x + head; hy = y; }
        else if (head < w + h) { hx = x + w; hy = y + (head - w); }
        else if (head < w + h + w) { hx = x + w - (head - w - h); hy = y + h; }
        else { hx = x; hy = y + h - (head - w - h - w); }
        c.FillRadial(hx, hy, gr * 6 / 10, ColorMath.LerpColor(color, (int)4294967295, 700), 235);
        c.PopClip();
        app.RequestAnimationFrameIn(x, y, w, h);
    }
    static void SpecularBorderHv(RenderHost app, int x, int y, int w, int h,
                                 int radius, int color, int hv) {
        if (hv <= 0) { return; }
        Canvas c = app.HostCanvas();
        int mx = app.HostMouseX(); int my = app.HostMouseY();
        int per = 2 * (w + h);
        if (per <= 0) { return; }
        int half = per / 2;
        int reach = per * 15 / 100;  // 弧段半长
        if (reach < 1) { reach = 1; }
        int gr = app.HostScale(5);  // 小而紧凑的点
        int steps = per / app.HostScale(5);
        if (steps < 48) { steps = 48; }
        if (steps > 260) { steps = 260; }
        int md = 0; int best = per * per;
        for (int j = 0; j < steps; j = j + 1) {
            int d = j * per / steps;
            int px = x; int py = y;
            if (d < w) { px = x + d; py = y; }
            else if (d < w + h) { px = x + w; py = y + (d - w); }
            else if (d < w + h + w) { px = x + w - (d - w - h); py = y + h; }
            else { px = x; py = y + h - (d - w - h - w); }
            int dx = px - mx;
            int dx2 = dx * dx;
            if (dx2 < best) {
                int dy = py - my;
                int dd = dx2 + dy * dy;
                if (dd < best) { best = dd; md = d; }
            }
        }
        int opp = (md + half) % per;
        c.PushClip(x, y, w, h);
        for (int i = 0; i < steps; i = i + 1) {
            int d = i * per / steps;
            int a = 0;
            int e1 = d - md;
            if (e1 < 0) { e1 = e1 + per; }
            if (e1 > half) { e1 = per - e1; }
            int e2 = d - opp;
            if (e2 < 0) { e2 = e2 + per; }
            if (e2 > half) { e2 = per - e2; }
            int near = e1; if (e2 < near) { near = e2; }
            if (near < reach) {
                int p = Fx.Ease((reach - near) * 1000 / reach);
                a = 210 * p / 1000 * hv / 1000;
            }
            if (a > 0) {
                int px = x; int py = y;
                if (d < w) { px = x + d; py = y; }
                else if (d < w + h) { px = x + w; py = y + (d - w); }
                else if (d < w + h + w) { px = x + w - (d - w - h); py = y + h; }
                else { px = x; py = y + h - (d - w - h - w); }
                c.FillRadial(px, py, gr, color, a);
            }
        }
        c.PopClip();
    }
    static void SpotlightHv(RenderHost app, int x, int y, int w, int h,
                            int color, int reach, int maxAlpha, int hv) {
        if (hv <= 0) { return; }
        Canvas c = app.HostCanvas();
        int mx = app.HostMouseX(); int my = app.HostMouseY();
        if (mx < x) { mx = x; } if (mx > x + w) { mx = x + w; }
        if (my < y) { my = y; } if (my > y + h) { my = y + h; }
        int a = maxAlpha * hv / 1000;
        int r = reach * (600 + 400 * hv / 1000) / 1000;
        c.PushClip(x, y, w, h);
        Fx.PointGlow(c, mx, my, r, color, a);
        c.PopClip();
        app.RequestAnimationFrameIn(x, y, w, h);
    }
    static void CardSheen(RenderHost app, int x, int y, int w, int h, int color, int periodMs) {
        Canvas c = app.HostCanvas();
        c.PushClip(x, y, w, h);
        int span = w + h + h;  // 行程包含屏幕外的两端
        int pos = Fx.Saw(app, periodMs) * span / 1000 - h;  // 45 度扫描
        int gr = app.HostScale(22);
        int col = ColorMath.LerpColor(color, (int)4294967295, 600);
        int steps = h / app.HostScale(18);
        if (steps < 5) { steps = 5; }
        for (int i = 0; i <= steps; i = i + 1) {
            int yy = y + h * i / steps;
            int xx = x + pos + (yy - y);  // 45 度光带
            Fx.PointGlow(c, xx, yy, gr, col, 28);
        }
        c.PopClip();
        app.RequestAnimationFrameIn(x, y, w, h);
    }
    static void CardAurora(RenderHost app, int x, int y, int w, int h, int color) {
        Canvas c = app.HostCanvas();
        c.PushClip(x, y, w, h);
        int r = (w + h) / 6;
        int n = 3;
        for (int i = 0; i < n; i = i + 1) {
            int px = x + w * ((Fx.Saw(app, 11000 + i * 2600) + i * 300) % 1000) / 1000;
            int py = y + h * Fx.Pulse(app, 7000 + i * 1900) / 1000;
            int col = ColorMath.LerpColor(color, (int)4294967295, i * 250);
            int a = 24 + 22 * Fx.Pulse(app, 5200 + i * 800) / 1000;
            Fx.PointGlow(c, px, py, r, col, a);
        }
        c.PopClip();
        app.RequestAnimationFrameIn(x, y, w, h);
    }
    static void CardBreath(RenderHost app, int x, int y, int w, int h, int color, int periodMs) {
        Canvas c = app.HostCanvas();
        int per = 2 * (w + h);
        if (per <= 0) { return; }
        int gr = app.HostScale(4);
        int a = 26 + 96 * Fx.Pulse(app, periodMs) / 1000;
        int steps = per / app.HostScale(5);
        if (steps < 48) { steps = 48; }
        if (steps > 200) { steps = 200; }
        c.PushClip(x, y, w, h);
        for (int i = 0; i < steps; i = i + 1) {
            int d = i * per / steps;
            int px = x; int py = y;
            if (d < w) { px = x + d; py = y; }
            else if (d < w + h) { px = x + w; py = y + (d - w); }
            else if (d < w + h + w) { px = x + w - (d - w - h); py = y + h; }
            else { px = x; py = y + h - (d - w - h - w); }
            c.FillRadial(px, py, gr, color, a);
        }
        c.PopClip();
        app.RequestAnimationFrameIn(x, y, w, h);
    }
    static void CardMotes(RenderHost app, int x, int y, int w, int h, int color) {
        Canvas c = app.HostCanvas();
        c.PushClip(x, y, w, h);
        int n = 7;
        int gr = app.HostScale(4);
        for (int i = 0; i < n; i = i + 1) {
            int cx = x + w * (i * 1000 / n + 500 / n) / 1000;
            int rise = (Fx.Saw(app, 6000 + i * 1300) + i * 140) % 1000;
            int cy = y + h - h * rise / 1000;
            int a = 38 + 60 * Fx.Pulse(app, 3000 + i * 700) / 1000;
            Fx.PointGlow(c, cx, cy, gr, color, a);
        }
        c.PopClip();
        app.RequestAnimationFrameIn(x, y, w, h);
    }
    static void Apply(RenderHost app, int x, int y, int w, int h, int radius,
                      FxOptions o, int defaultColor) {
        if (o == null) { return; }
        int col = o.glowColor;
        if (col == 0) { col = defaultColor; }
        if (o.aurora) { Fx.CardAurora(app, x, y, w, h, col); }
        if (o.sheen) { Fx.CardSheen(app, x, y, w, h, col, o.glowPeriodMs * 2); }
        if (o.motes) { Fx.CardMotes(app, x, y, w, h, col); }
        if (o.breath) { Fx.CardBreath(app, x, y, w, h, col, o.glowPeriodMs); }
        if (o.borderGlow) { Fx.BorderGlow(app, x, y, w, h, radius, col, o.glowPeriodMs, 220); }
        if (o.spotlight) {
            int mx = app.HostMouseX(); int my = app.HostMouseY();
            if (mx >= x && mx < x + w && my >= y && my < y + h) {
                Fx.SpotlightHv(app, x, y, w, h, col, (w + h) / 4, 46, 1000);
            }
        }
    }
    static void BgLightPillar(RenderHost app, int x, int y, int w, int h, int color) {
        Canvas c = app.HostCanvas();
        c.PushClip(x, y, w, h);
        int n = 5;
        for (int i = 0; i < n; i = i + 1) {
            int ph = Fx.Saw(app, 9000 + i * 1700);
            int cx = x + w * ((ph + i * 1000 / n) % 1000) / 1000;
            int pw = w / 7;
            int breathe = Fx.Pulse(app, 4200 + i * 900);
            int a = 22 + 42 * breathe / 1000;
            int col = ColorMath.WithAlpha(color, a);
            c.FillVGrad(cx - pw / 2, y, pw, h, ColorMath.WithAlpha(color, 0), col);
        }
        c.PopClip();
        app.RequestAnimationFrameIn(x, y, w, h);
    }
    static void BgFloatingLines(RenderHost app, int x, int y, int w, int h, int color) {
        Canvas c = app.HostCanvas();
        c.PushClip(x, y, w, h);
        int gap = app.HostScale(46);
        if (gap < 12) { gap = 12; }
        int span = h + w;
        int drift = Fx.Saw(app, 7000) * gap / 1000;
        int d = -w;
        while (d < span) {
            int off = d + drift;
            int breathe = Fx.Pulse(app, 5200);
            int a = 14 + 26 * breathe / 1000;
            int x0 = x + off; int y0 = y;
            int x1 = x + off - h; int y1 = y + h;
            c.DrawLine(x0, y0, x1, y1, ColorMath.WithAlpha(color, a), 1);
            d = d + gap;
        }
        c.PopClip();
        app.RequestAnimationFrameIn(x, y, w, h);
    }
}
