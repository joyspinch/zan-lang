using System;
using Gui;
namespace Gui;
public class Fx {
    static int Ease(int p) {
        if (p <= 0) { return 0; }
        if (p >= 1000) { return 1000; }
        int t2 = p * p / 1000;
        int t3 = t2 * p / 1000;
        return 3 * t2 - 2 * t3;
    }
    static int WithAlpha(int color, int alpha) { return ColorMath.WithAlpha(color, alpha); }
    static int ScaleAlpha(int color, int p) { return ColorMath.ScaleAlpha(color, p); }
    static int LerpColor(int c0, int c1, int p) { return ColorMath.LerpColor(c0, c1, p); }
    static int RingDist(int d, int anchor, int per, int half) {
        int dd = d - anchor;
        if (dd < 0) { dd = dd + per; }
        if (dd > half) { dd = per - dd; }
        return dd;
    }
    static int NearestPerimeterD(int x, int y, int w, int h, int radius,
                                 int per, int steps, int mx, int my, out int bestDistSq) {
        if (steps <= 0 || per <= 0) {
            bestDistSq = 2147483647;
            return 0;
        }
        int md = 0;
        long best = 9223372036854775807;
        for (int j = 0; j < steps; j = j + 1) {
            int d = (int)((long)j * per / steps);
            int px = x; int py = y;
            Fx.PerimeterPoint(x, y, w, h, radius, d, out px, out py);
            long dx = (long)px - (long)mx;
            long dx2 = dx * dx;
            if (dx2 < best) {
                long dy = (long)py - (long)my;
                long dd = dx2 + dy * dy;
                if (dd < best) { best = dd; md = d; }
            }
        }
        bestDistSq = best < 2147483647 ? (int)best : 2147483647;
        return md;
    }
    static int Saw(RenderHost app, int periodMs) {
        if (app == null || periodMs <= 0) { return 0; }
        int m = app.HostNowMs() % periodMs;
        if (m < 0) { m = m + periodMs; }
        return (int)((long)m * 1000 / periodMs);
    }
    static int Pulse(RenderHost app, int periodMs) {
        int s = Fx.Saw(app, periodMs);
        int tri = s * 2;
        if (tri > 1000) { tri = 2000 - tri; }
        return Fx.Ease(tri);
    }
    static int Isqrt(int n) {
        if (n <= 0) { return 0; }
        int x = n;
        int y = (x + 1) / 2;
        while (y < x) {
            x = y;
            y = (x + n / x) / 2;
        }
        return x;
    }
    static void PointGlow(Canvas c, int cx, int cy, int r, int color, int maxAlpha) {
        if (c == null || r <= 0 || maxAlpha <= 0) { return; }
        c.FillRadial(cx, cy, r, color, maxAlpha);
    }
    static int ClampRadius(int w, int h, int radius) {
        int r = radius;
        if (r < 0) { r = 0; }
        int maxR = (w < h ? w : h) / 2;
        if (maxR < 0) { maxR = 0; }
        if (r > maxR) { r = maxR; }
        return r;
    }
    // 圆角矩形周长（直线段 + 4 段四分之一圆弧）。
    static int PerimeterLength(int w, int h, int radius) {
        if (w <= 0 || h <= 0) { return 0; }
        int r = Fx.ClampRadius(w, h, radius);
        if (r <= 0) { return 2 * (w + h); }
        double arc = 1.5707963268 * (double)r;
        return (int)(2.0 * (double)(w - 2 * r) + 2.0 * (double)(h - 2 * r) + 4.0 * arc + 0.5);
    }
    // 沿圆角矩形周长按弧长 d 采样真实边界坐标（含四角圆弧）。
    static void PerimeterPoint(int x, int y, int w, int h, int radius, int d,
                               out int px, out int py) {
        if (w <= 0 || h <= 0) { px = x; py = y; return; }
        int r = Fx.ClampRadius(w, h, radius);
        if (r <= 0) {
            int per = 2 * (w + h);
            int dd = per > 0 ? (d % per) : 0;
            if (dd < 0) { dd = dd + per; }
            if (dd < w) { px = x + dd; py = y; return; }
            if (dd < w + h) { px = x + w; py = y + (dd - w); return; }
            if (dd < w + h + w) { px = x + w - (dd - w - h); py = y + h; return; }
            px = x; py = y + h - (dd - w - h - w);
            return;
        }
        double sw = (double)(w - 2 * r);
        double sh = (double)(h - 2 * r);
        double arc = 1.5707963268 * (double)r;
        double total = 2.0 * (sw + sh) + 4.0 * arc;
        double s = (double)d;
        if (total > 0.0) {
            s = s - Math.Floor(s / total) * total;
            if (s < 0.0) { s = s + total; }
            if (s >= total) { s = 0.0; }
        }
        if (s < sw) { px = x + r + (int)(s + 0.5); py = y; return; }
        s = s - sw;
        if (s < arc) {
            double ang = -1.5707963268 + s / (double)r;
            px = x + w - r + (int)((double)r * Math.Cos(ang) + 0.5);
            py = y + r + (int)((double)r * Math.Sin(ang) + 0.5);
            return;
        }
        s = s - arc;
        if (s < sh) { px = x + w; py = y + r + (int)(s + 0.5); return; }
        s = s - sh;
        if (s < arc) {
            double ang = s / (double)r;
            px = x + w - r + (int)((double)r * Math.Cos(ang) + 0.5);
            py = y + h - r + (int)((double)r * Math.Sin(ang) + 0.5);
            return;
        }
        s = s - arc;
        if (s < sw) { px = x + w - r - (int)(s + 0.5); py = y + h; return; }
        s = s - sw;
        if (s < arc) {
            double ang = 1.5707963268 + s / (double)r;
            px = x + r + (int)((double)r * Math.Cos(ang) + 0.5);
            py = y + h - r + (int)((double)r * Math.Sin(ang) + 0.5);
            return;
        }
        s = s - arc;
        if (s < sh) { px = x; py = y + h - r - (int)(s + 0.5); return; }
        s = s - sh;
        double angTL = 3.1415926536 + s / (double)r;
        px = x + r + (int)((double)r * Math.Cos(angTL) + 0.5);
        py = y + r + (int)((double)r * Math.Sin(angTL) + 0.5);
    }
    static void BorderGlow(RenderHost app, int x, int y, int w, int h,
                           int radius, int color, int periodMs, int intensity) {
        if (app == null) { return; }
        Canvas c = app.HostCanvas();
        if (c == null) { return; }
        int per = Fx.PerimeterLength(w, h, radius);
        if (per <= 0) { return; }
        int head = Fx.Saw(app, periodMs) * per / 1000;
        int gr = app.HostScale(3);  // 细：约为边框线宽
        int half = per / 2;
        int reach = per * 30 / 100;  // 明亮扫描带的半长
        if (reach < 1) { reach = 1; }
        int rim = intensity * 12 / 100;  // 微弱常驻边缘光
        int stepPx = app.HostScale(4);
        if (stepPx < 1) { stepPx = 1; }
        int steps = per / stepPx;
        if (steps < 48) { steps = 48; }
        if (steps > 200) { steps = 200; }
        for (int i = 0; i < steps; i = i + 1) {
            int d = i * per / steps;
            int dd = Fx.RingDist(d, head, per, half);
            int a = rim;
            if (dd < reach) {
                int p = Fx.Ease((reach - dd) * 1000 / reach);
                a = rim + (intensity - rim) * p / 1000;
            }
            if (a > 0) {
                int px = x; int py = y;
                Fx.PerimeterPoint(x, y, w, h, radius, d, out px, out py);
                c.FillRadial(px, py, gr, color, a);
            }
        }
        app.RequestAnimationFrameIn(x, y, w, h);
    }
    // 边缘流光（Border Beam）：带白热彗星头与渐隐长尾的单向沿边流光。
    static void BorderBeam(RenderHost app, int x, int y, int w, int h,
                           int radius, int color, int periodMs, int intensity) {
        if (app == null || w <= 2 || h <= 2) { return; }
        Canvas c = app.HostCanvas();
        if (c == null) { return; }
        int per = Fx.PerimeterLength(w, h, radius);
        if (per <= 0) { return; }
        if (periodMs <= 0) { periodMs = 3000; }
        int head = Fx.Saw(app, periodMs) * per / 1000;
        int tailLen = per * 26 / 100;
        if (tailLen < 12) { tailLen = 12; }
        int leadLen = per * 3 / 100;
        if (leadLen < 2) { leadLen = 2; }
        int baseR = app.HostScale(3);
        if (baseR < 2) { baseR = 2; }
        int stepPx = app.HostScale(3);
        if (stepPx < 2) { stepPx = 2; }
        int steps = per / stepPx;
        if (steps < 64) { steps = 64; }
        if (steps > 240) { steps = 240; }
        int hotCol = ColorMath.LerpColor(color, (int)4294967295, 620);
        int rimA = intensity * 10 / 100;
        c.PushClip(x, y, w, h);
        try {
            if (rimA > 0) {
                c.DrawRoundRect(x, y, w, h, radius, Fx.WithAlpha(color, rimA), 1);
            }
            for (int i = 0; i < steps; i = i + 1) {
                int d = i * per / steps;
                int behind = head - d;
                if (behind < 0) { behind = behind + per; }
                int ahead = d - head;
                if (ahead < 0) { ahead = ahead + per; }
                int p = 0;
                if (behind <= tailLen) {
                    int t = (tailLen - behind) * 1000 / tailLen;
                    // 平方衰减拉出锐利彗尾
                    p = t * t / 1000;
                } else if (ahead <= leadLen) {
                    int t = (leadLen - ahead) * 1000 / leadLen;
                    p = Fx.Ease(t);
                }
                if (p <= 15) { continue; }
                int a = intensity * p / 1000;
                int gr = baseR + (baseR * p / 1500);
                int col = p > 720 ? ColorMath.LerpColor(color, hotCol, (p - 720) * 1000 / 280) : color;
                int px = x; int py = y;
                Fx.PerimeterPoint(x, y, w, h, radius, d, out px, out py);
                c.FillRadial(px, py, gr, col, a);
            }
            int hx = x; int hy = y;
            Fx.PerimeterPoint(x, y, w, h, radius, head, out hx, out hy);
            c.FillRadial(hx, hy, baseR + 1, (int)4294967295, intensity * 92 / 100);
        } finally {
            c.PopClip();
        }
        app.RequestAnimationFrameIn(x, y, w, h);
    }
    static void Emboss(RenderHost app, int x, int y, int w, int h, int radius,
                       bool pressed, int bgPrimary) {
        if (app == null || w <= 0 || h <= 0) { return; }
        Canvas c = app.HostCanvas();
        if (c == null) { return; }
        int off = app.HostScale(4);
        int lite = ColorMath.LerpColor(bgPrimary, (int)4294967295, 70);
        int dark = ColorMath.LerpColor(bgPrimary, (int)4278190080, 45);
        int up = lite;
        int down = dark;
        if (pressed) { up = dark; down = lite; }
        c.FillRoundRect(x - off, y - off, w, h, radius, up);
        c.FillRoundRect(x + off, y + off, w, h, radius, down);
    }
    static void DashedBorder(RenderHost app, int x, int y, int w, int h, int color) {
        if (app == null || w <= 0 || h <= 0) { return; }
        Canvas c = app.HostCanvas();
        if (c == null) { return; }
        int dl = app.HostScale(6);
        if (dl < 1) { dl = 1; }
        int step = dl + app.HostScale(4);
        if (step < 1) { step = 1; }
        int hx = x;
        while (hx < x + w) {
            int seg = dl;
            if (hx + seg > x + w) { seg = x + w - hx; }
            c.FillRect(hx, y, seg, 1, color);
            c.FillRect(hx, y + h - 1, seg, 1, color);
            hx = hx + step;
        }
        int vy = y;
        while (vy < y + h) {
            int seg = dl;
            if (vy + seg > y + h) { seg = y + h - vy; }
            c.FillRect(x, vy, 1, seg, color);
            c.FillRect(x + w - 1, vy, 1, seg, color);
            vy = vy + step;
        }
    }
    static void Specular(RenderHost app, int id, int x, int y, int w, int h,
                         int radius, int color) {
        if (app == null) { return; }
        int hv = app.StyleHoverLevelIn(id, 0, x, y, w, h);
        Fx.SpecularBorderHv(app, x, y, w, h, radius, color, hv);
    }
    static void SpecularRun(RenderHost app, int x, int y, int w, int h,
                            int radius, int color, int periodMs) {
        if (app == null) { return; }
        Canvas c = app.HostCanvas();
        if (c == null) { return; }
        int per = Fx.PerimeterLength(w, h, radius);
        if (per <= 0) { return; }
        int head = Fx.Saw(app, periodMs) * per / 1000;
        int half = per / 2;
        int reach = per * 11 / 100;  // 短促紧凑的亮点
        if (reach < 1) { reach = 1; }
        int rim = 20;  // 微弱常驻边缘光
        int gr = app.HostScale(7);
        int stepPx = app.HostScale(5);
        if (stepPx < 1) { stepPx = 1; }
        int steps = per / stepPx;
        if (steps < 40) { steps = 40; }
        if (steps > 260) { steps = 260; }
        c.PushClip(x, y, w, h);
        try {
            for (int i = 0; i < steps; i = i + 1) {
                int d = i * per / steps;
                int dd = Fx.RingDist(d, head, per, half);
                int a = rim;
                if (dd < reach) {
                    int p = Fx.Ease((reach - dd) * 1000 / reach);
                    a = rim + (215 - rim) * p / 1000;
                }
                if (a > 0) {
                    int px = x; int py = y;
                    Fx.PerimeterPoint(x, y, w, h, radius, d, out px, out py);
                    c.FillRadial(px, py, gr, color, a);
                }
            }
            int hx = x; int hy = y;
            Fx.PerimeterPoint(x, y, w, h, radius, head, out hx, out hy);
            c.FillRadial(hx, hy, gr * 6 / 10, ColorMath.LerpColor(color, (int)4294967295, 700), 235);
        } finally {
            c.PopClip();
        }
        app.RequestAnimationFrameIn(x, y, w, h);
    }
    static void SpecularBorderHv(RenderHost app, int x, int y, int w, int h,
                                 int radius, int color, int hv) {
        if (app == null || hv <= 0) { return; }
        Canvas c = app.HostCanvas();
        if (c == null) { return; }
        int mx = app.HostMouseX(); int my = app.HostMouseY();
        int per = Fx.PerimeterLength(w, h, radius);
        if (per <= 0) { return; }
        int half = per / 2;
        int reach = per * 15 / 100;  // 弧段半长
        if (reach < 1) { reach = 1; }
        int gr = app.HostScale(5);  // 小而紧凑的点
        int stepPx = app.HostScale(5);
        if (stepPx < 1) { stepPx = 1; }
        int steps = per / stepPx;
        if (steps < 48) { steps = 48; }
        if (steps > 260) { steps = 260; }
        int bestUnused = 0;
        int md = Fx.NearestPerimeterD(x, y, w, h, radius, per, steps, mx, my, out bestUnused);
        int opp = (md + half) % per;
        c.PushClip(x, y, w, h);
        try {
            for (int i = 0; i < steps; i = i + 1) {
                int d = i * per / steps;
                int a = 0;
                int e1 = Fx.RingDist(d, md, per, half);
                int e2 = Fx.RingDist(d, opp, per, half);
                int near = e1 < e2 ? e1 : e2;
                if (near < reach) {
                    int p = Fx.Ease((reach - near) * 1000 / reach);
                    a = 210 * p / 1000 * hv / 1000;
                }
                if (a > 0) {
                    int px = x; int py = y;
                    Fx.PerimeterPoint(x, y, w, h, radius, d, out px, out py);
                    c.FillRadial(px, py, gr, color, a);
                }
            }
        } finally {
            c.PopClip();
        }
    }
    static void SpotlightHv(RenderHost app, int x, int y, int w, int h,
                            int color, int reach, int maxAlpha, int hv) {
        if (app == null || hv <= 0 || w <= 0 || h <= 0) { return; }
        Canvas c = app.HostCanvas();
        if (c == null) { return; }
        int mx = app.HostMouseX(); int my = app.HostMouseY();
        if (mx < x) { mx = x; } if (mx > x + w) { mx = x + w; }
        if (my < y) { my = y; } if (my > y + h) { my = y + h; }
        int a = maxAlpha * hv / 1000;
        int r = reach * (600 + 400 * hv / 1000) / 1000;
        c.PushClip(x, y, w, h);
        try {
            Fx.PointGlow(c, mx, my, r, color, a);
        } finally {
            c.PopClip();
        }
        app.RequestAnimationFrameIn(x, y, w, h);
    }
    // 单侧近光标边框提亮（不在对侧画假镜像点）：靠近光标处的边框平滑亮起。
    static void SpecularBorderPointHv(RenderHost app, int x, int y, int w, int h,
                                      int radius, int color, int mx, int my,
                                      int hv, int strength) {
        if (app == null || hv <= 0 || w <= 2 || h <= 2) { return; }
        Canvas c = app.HostCanvas();
        if (c == null) { return; }
        int per = Fx.PerimeterLength(w, h, radius);
        if (per <= 0) { return; }
        int half = per / 2;
        int reach = per * 18 / 100;
        if (reach < 12) { reach = 12; }
        int gr = app.HostScale(4);
        if (gr < 2) { gr = 2; }
        int stepPx = app.HostScale(4);
        if (stepPx < 3) { stepPx = 3; }
        int steps = per / stepPx;
        if (steps < 48) { steps = 48; }
        if (steps > 220) { steps = 220; }
        int best = 0;
        int md = Fx.NearestPerimeterD(x, y, w, h, radius, per, steps, mx, my, out best);
        // 光标越贴近边框，局部边框越亮；在卡片中央时保持柔和提示
        int maxDist = (w < h ? w : h) * 65 / 100;
        if (maxDist < 40) { maxDist = 40; }
        int dist = (int)Math.Sqrt((double)best);
        int prox = dist >= maxDist ? 360 : (1000 - (dist * 640 / maxDist));
        int peakA = 225 * strength / 1000 * hv / 1000 * prox / 1000;
        if (peakA <= 1) { return; }
        int rimCol = ColorMath.LerpColor(color, (int)4294967295, 580);
        c.PushClip(x, y, w, h);
        try {
            for (int i = 0; i < steps; i = i + 1) {
                int d = i * per / steps;
                int e1 = Fx.RingDist(d, md, per, half);
                if (e1 >= reach) { continue; }
                int p = Fx.Ease((reach - e1) * 1000 / reach);
                int a = peakA * p / 1000;
                if (a <= 1) { continue; }
                int px = x; int py = y;
                Fx.PerimeterPoint(x, y, w, h, radius, d, out px, out py);
                c.FillRadial(px, py, gr, rimCol, a);
            }
        } finally {
            c.PopClip();
        }
    }
    static int[] spotKeys;
    static int[] spotHv;
    static int[] spotMx;
    static int[] spotMy;
    static int[] spotTick;
    static void EnsureSpotlightSlots() {
        if (Fx.spotKeys != null) { return; }
        Fx.spotKeys = new int[64];
        Fx.spotHv = new int[64];
        Fx.spotMx = new int[64];
        Fx.spotMy = new int[64];
        Fx.spotTick = new int[64];
    }
    public static void ResetSpotlightCache() {
        if (Fx.spotKeys == null) { return; }
        for (int i = 0; i < 64; i = i + 1) {
            Fx.spotKeys[i] = 0;
            Fx.spotHv[i] = 0;
            Fx.spotTick[i] = 0;
        }
    }
    static int SpotlightSlot(int key, int nowMs) {
        Fx.EnsureSpotlightSlots();
        int freeIdx = 0 - 1;
        int oldestIdx = 0;
        int oldestTick = Fx.spotTick[0];
        for (int i = 0; i < 64; i = i + 1) {
            if (Fx.spotKeys[i] == key) { return i; }
            if (Fx.spotKeys[i] == 0 && freeIdx < 0) { freeIdx = i; }
            if (Fx.spotTick[i] < oldestTick) {
                oldestTick = Fx.spotTick[i];
                oldestIdx = i;
            }
        }
        int idx = freeIdx >= 0 ? freeIdx : oldestIdx;
        Fx.spotKeys[idx] = key;
        Fx.spotHv[idx] = 0;
        Fx.spotMx[idx] = 0;
        Fx.spotMy[idx] = 0;
        Fx.spotTick[idx] = nowMs;
        return idx;
    }
    // 聚光卡片效果：悬停时内部跟随光标柔和径向光斑 + 靠近光标的单侧边框局部提亮，
    // 移出后在离场点平滑淡出复原，移到卡片内部子控件上不中断。
    static void Spotlight(RenderHost app, int key, int x, int y, int w, int h,
                          int radius, int color, int strength) {
        if (app == null || w <= 2 || h <= 2 || strength <= 0) { return; }
        if (key == 0) { key = ((x * 31) ^ (y * 131)) ^ ((w * 977) ^ (h * 4099)); }
        if (key == 0) { key = 1; }
        int mx = app.HostMouseX();
        int my = app.HostMouseY();
        bool inside = mx >= x && mx < x + w && my >= y && my < y + h;
        int nowMs = app.HostNowMs();
        int slot = Fx.SpotlightSlot(key, nowMs);
        int hv = Fx.spotHv[slot];
        int dt = nowMs - Fx.spotTick[slot];
        if (dt < 0 || dt > 120) { dt = 16; }
        Fx.spotTick[slot] = nowMs;
        if (inside) {
            Fx.spotMx[slot] = mx;
            Fx.spotMy[slot] = my;
            int step = dt > 0 ? (dt * 1000 / 140) : 240;
            if (step < 1) { step = 1; }
            if (hv == 0 && step < 220) { step = 220; }
            hv = hv + step;
            if (hv > 1000) { hv = 1000; }
        } else if (hv > 0) {
            int step = dt > 0 ? (dt * 1000 / 240) : 0;
            hv = hv - step;
            if (hv < 0) { hv = 0; }
        }
        Fx.spotHv[slot] = hv;
        if (hv <= 0) { return; }
        int px = Fx.spotMx[slot];
        int py = Fx.spotMy[slot];
        if (px < x) { px = x; } if (px > x + w) { px = x + w; }
        if (py < y) { py = y; } if (py > y + h) { py = y + h; }
        int eased = Fx.Ease(hv);
        Canvas c = app.HostCanvas();
        if (c == null) { return; }
        int reach = (w < h ? w : h) * 65 / 100;
        int minReach = app.HostScale(108);
        if (reach < minReach) { reach = minReach; }
        int maxReach = app.HostScale(240);
        if (reach > maxReach) { reach = maxReach; }
        int r = reach * (760 + 240 * eased / 1000) / 1000;
        int innerA = 78 * strength / 1000 * eased / 1000;
        int coreA = 44 * strength / 1000 * eased / 1000;
        c.PushClip(x, y, w, h);
        try {
            if (innerA > 0) {
                c.FillRadial(px, py, r, color, innerA);
            }
            if (coreA > 0) {
                c.FillRadial(px, py, r * 45 / 100, ColorMath.LerpColor(color, (int)4294967295, 500), coreA);
            }
        } finally {
            c.PopClip();
        }
        Fx.SpecularBorderPointHv(app, x, y, w, h, radius, color, px, py, eased, strength);
        if (inside || hv > 0) {
            app.RequestAnimationFrameIn(x, y, w, h);
        }
    }
    static void CardSheen(RenderHost app, int x, int y, int w, int h, int color, int periodMs) {
        if (app == null || w <= 0 || h <= 0) { return; }
        Canvas c = app.HostCanvas();
        if (c == null) { return; }
        int bandW = w * 45 / 100;
        int minBand = app.HostScale(56);
        if (bandW < minBand) { bandW = minBand; }
        int span = w + bandW * 2;
        int bx = x - bandW + Fx.Saw(app, periodMs) * span / 1000;
        int tint = ColorMath.LerpColor(color, (int)4294967295, 650);
        int edge = Fx.WithAlpha(tint, 0);
        int peak = Fx.WithAlpha(tint, 44);
        c.PushClip(x, y, w, h);
        try {
            c.FillGradMask(bx, y, bandW, h, 0, Corner.All(), 2, edge, peak, edge);
        } finally {
            c.PopClip();
        }
        app.RequestAnimationFrameIn(x, y, w, h);
    }
    static void CardAurora(RenderHost app, int x, int y, int w, int h, int color) {
        if (app == null || w <= 0 || h <= 0) { return; }
        Canvas c = app.HostCanvas();
        if (c == null) { return; }
        c.PushClip(x, y, w, h);
        try {
            int r = (w + h) / 6;
            int n = 3;
            for (int i = 0; i < n; i = i + 1) {
                int px = x + w * ((Fx.Saw(app, 11000 + i * 2600) + i * 300) % 1000) / 1000;
                int py = y + h * Fx.Pulse(app, 7000 + i * 1900) / 1000;
                int col = ColorMath.LerpColor(color, (int)4294967295, i * 250);
                int a = 24 + 22 * Fx.Pulse(app, 5200 + i * 800) / 1000;
                Fx.PointGlow(c, px, py, r, col, a);
            }
        } finally {
            c.PopClip();
        }
        app.RequestAnimationFrameIn(x, y, w, h);
    }
    static void CardBreath(RenderHost app, int x, int y, int w, int h, int color, int periodMs) {
        Fx.CardBreath(app, x, y, w, h, 0, color, periodMs);
    }
    static void CardBreath(RenderHost app, int x, int y, int w, int h,
                           int radius, int color, int periodMs) {
        if (app == null || w <= 0 || h <= 0) { return; }
        Canvas c = app.HostCanvas();
        if (c == null) { return; }
        int pulse = Fx.Pulse(app, periodMs);
        int outerA = 18 + 54 * pulse / 1000;
        int innerA = 42 + 128 * pulse / 1000;
        int haloW = app.HostScale(3);
        int rimW = app.HostScale(1);
        if (haloW < 2) { haloW = 2; }
        if (rimW < 1) { rimW = 1; }
        c.DrawRoundRect(x, y, w, h, radius, Fx.WithAlpha(color, outerA), haloW);
        c.DrawRoundRect(x, y, w, h, radius, Fx.WithAlpha(color, innerA), rimW);
        app.RequestAnimationFrameIn(x, y, w, h);
    }
    // 现代点击水波纹：从点击点 (cx, cy) 缓出扩散并平滑淡出，裁切在控件边界内。
    public static void Ripple(RenderHost app, int x, int y, int w, int h, int radius,
                              int cx, int cy, int progressPm, int color) {
        if (app == null || w <= 0 || h <= 0 || progressPm <= 0 || progressPm >= 1000) { return; }
        Canvas c = app.HostCanvas();
        if (c == null) { return; }
        int p = Fx.Ease(progressPm);
        int dx0 = cx - x; int dx1 = (x + w) - cx;
        int dy0 = cy - y; int dy1 = (y + h) - cy;
        int mx = dx0 > dx1 ? dx0 : dx1;
        int my = dy0 > dy1 ? dy0 : dy1;
        long distSq = (long)mx * (long)mx + (long)my * (long)my;
        int maxR = (distSq <= 2147483647 ? Fx.Isqrt((int)distSq) : (int)Math.Sqrt((double)distSq)) + app.HostScale(8);
        int r = (int)((long)maxR * p / 1000);
        if (r < 2) { r = 2; }
        int baseAlpha = (color >> 24) & 255;
        if (baseAlpha == 0) { baseAlpha = 88; }
        int alpha = baseAlpha * (1000 - progressPm) / 1000;
        if (alpha <= 0) { return; }
        c.PushClip(x, y, w, h);
        try {
            c.FillRadial(cx, cy, r, color, alpha);
        } finally {
            c.PopClip();
        }
    }
    // 骨架屏扫光占位符：圆角底面 + 平滑斜向高光波，替代生硬闪烁。
    public static void ShimmerSkeleton(RenderHost app, int x, int y, int w, int h, int radius,
                                       int baseColor, int highlightColor, int periodMs) {
        if (app == null || w <= 0 || h <= 0) { return; }
        Canvas c = app.HostCanvas();
        if (c == null) { return; }
        if (baseColor != 0) {
            if (radius > 0) { c.FillRoundRect(x, y, w, h, radius, baseColor); }
            else { c.FillRect(x, y, w, h, baseColor); }
        }
        int bandW = w * 55 / 100;
        int minBand = app.HostScale(64);
        if (bandW < minBand) { bandW = minBand; }
        int span = w + bandW * 2;
        int bx = x - bandW + Fx.Saw(app, periodMs > 0 ? periodMs : 1600) * span / 1000;
        int hi = highlightColor != 0 ? highlightColor : (int)0x40FFFFFFu;
        int clear = Fx.WithAlpha(hi, 0);
        c.PushClip(x, y, w, h);
        try {
            c.FillGradMask(bx, y, bandW, h, 0, Corner.All(), 1, clear, hi, clear);
        } finally {
            c.PopClip();
        }
        app.RequestAnimationFrameIn(x, y, w, h);
    }
    // 双色旋转轨道光边框（Apple Intelligence / Linear / Raycast 风格），贴合真实圆角周长。
    public static void GradientBorder(RenderHost app, int x, int y, int w, int h, int radius,
                                      int colorA, int colorB, int periodMs) {
        if (app == null || w <= 0 || h <= 0) { return; }
        Canvas c = app.HostCanvas();
        if (c == null) { return; }
        int per = Fx.PerimeterLength(w, h, radius);
        if (per <= 0) { return; }
        int ms = periodMs > 0 ? periodMs : 2800;
        int headA = Fx.Saw(app, ms) * per / 1000;
        int half = per / 2;
        int headB = (headA + half) % per;
        int reach = per * 36 / 100;
        if (reach < 1) { reach = 1; }
        int gr = app.HostScale(3);
        if (gr < 2) { gr = 2; }
        int stepPx = app.HostScale(5);
        if (stepPx < 1) { stepPx = 1; }
        int steps = per / stepPx;
        if (steps < 48) { steps = 48; }
        if (steps > 180) { steps = 180; }
        for (int i = 0; i < steps; i = i + 1) {
            int d = i * per / steps;
            int dA = Fx.RingDist(d, headA, per, half);
            int dB = Fx.RingDist(d, headB, per, half);
            int col = colorA;
            int dist = dA;
            if (dB < dA) { col = colorB; dist = dB; }
            int a = 24;
            if (dist < reach) {
                int p = Fx.Ease((reach - dist) * 1000 / reach);
                a = 24 + 216 * p / 1000;
            }
            int px = x; int py = y;
            Fx.PerimeterPoint(x, y, w, h, radius, d, out px, out py);
            c.FillRadial(px, py, gr, col, a);
        }
        app.RequestAnimationFrameIn(x, y, w, h);
    }
    static void CardMotes(RenderHost app, int x, int y, int w, int h, int color) {
        if (app == null || w <= 0 || h <= 0) { return; }
        Canvas c = app.HostCanvas();
        if (c == null) { return; }
        c.PushClip(x, y, w, h);
        try {
            int n = 7;
            int gr = app.HostScale(4);
            for (int i = 0; i < n; i = i + 1) {
                int cx = x + w * (i * 1000 / n + 500 / n) / 1000;
                int rise = (Fx.Saw(app, 6000 + i * 1300) + i * 140) % 1000;
                int cy = y + h - h * rise / 1000;
                int a = 38 + 60 * Fx.Pulse(app, 3000 + i * 700) / 1000;
                Fx.PointGlow(c, cx, cy, gr, color, a);
            }
        } finally {
            c.PopClip();
        }
        app.RequestAnimationFrameIn(x, y, w, h);
    }
    static void Apply(RenderHost app, int x, int y, int w, int h, int radius,
                      FxOptions o, int defaultColor) {
        if (app == null || o == null) { return; }
        int col = o.glowColor;
        if (col == 0) { col = defaultColor; }
        if (o.aurora) { Fx.CardAurora(app, x, y, w, h, col); }
        if (o.sheen) { Fx.CardSheen(app, x, y, w, h, col, o.glowPeriodMs * 2); }
        if (o.motes) { Fx.CardMotes(app, x, y, w, h, col); }
        if (o.breath) { Fx.CardBreath(app, x, y, w, h, radius, col, o.glowPeriodMs); }
        if (o.borderGlow) { Fx.BorderBeam(app, x, y, w, h, radius, col, o.glowPeriodMs, 225); }
        if (o.spotlight) {
            int skey = ((x * 31) ^ (y * 131)) ^ ((w * 977) ^ (h * 4099));
            Fx.Spotlight(app, skey, x, y, w, h, radius, col, 620);
        }
    }
    static void BgLightPillar(RenderHost app, int x, int y, int w, int h, int color) {
        if (app == null || w <= 0 || h <= 0) { return; }
        Canvas c = app.HostCanvas();
        if (c == null) { return; }
        c.PushClip(x, y, w, h);
        try {
            int n = 5;
            for (int i = 0; i < n; i = i + 1) {
                int ph = Fx.Saw(app, 9000 + i * 1700);
                int cx = x + w * ((ph + i * 1000 / n) % 1000) / 1000;
                int pw = w / 7;
                int breathe = Fx.Pulse(app, 4200 + i * 900);
                int a = 22 + 42 * breathe / 1000;
                int col = ColorMath.WithAlpha(color, a);
                c.FillVGrad(cx - pw / 2, y, pw, h, ColorMath.WithAlpha(color, 0), col);
            }
        } finally {
            c.PopClip();
        }
        app.RequestAnimationFrameIn(x, y, w, h);
    }
    static void BgFloatingLines(RenderHost app, int x, int y, int w, int h, int color) {
        if (app == null || w <= 0 || h <= 0) { return; }
        Canvas c = app.HostCanvas();
        if (c == null) { return; }
        c.PushClip(x, y, w, h);
        try {
            int gap = app.HostScale(46);
            if (gap < 12) { gap = 12; }
            int span = h + w;
            int drift = Fx.Saw(app, 7000) * gap / 1000;
            int d = -w;
            while (d < span) {
                int off = d + drift;
                int breathe = Fx.Pulse(app, 5200);
                int a = 14 + 26 * breathe / 1000;
                int x0 = x + off; int y0 = y;
                int x1 = x + off - h; int y1 = y + h;
                c.DrawLine(x0, y0, x1, y1, ColorMath.WithAlpha(color, a), 1);
                d = d + gap;
            }
        } finally {
            c.PopClip();
        }
        app.RequestAnimationFrameIn(x, y, w, h);
    }
}
