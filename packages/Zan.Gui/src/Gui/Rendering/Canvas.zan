    int surfaceId;
    internal int opacityPm;
    public int SurfaceId() { surfaceIdExposed = true; return surfaceId; }
    private bool surfaceIdExposed;
    internal bool SurfaceIdExposed() { return surfaceIdExposed; }
    Canvas(int width, int height) {
        this.surfaceId = zan_gui_create_surface(width, height);
        this.opacityPm = 1000;
    }
    internal int ApplyOpacity(int color) {
        if (opacityPm >= 1000 || color == 0) { return color; }
        if (opacityPm <= 0) { return 0; }
        int a = (((color >> 24) & 255) * opacityPm) / 1000;
        if (a <= 0) { return 0; }
        return (a << 24) | (color & 0x00FFFFFF);
    }
    void Destroy() {
        this.DisposeLayers();
        zan_gui_destroy_surface(surfaceId);
    }
    public int Width() { return zan_gui_surface_width(surfaceId); }
    public int Height() { return zan_gui_surface_height(surfaceId); }
    int WritePixels(string path, int x, int y, int w, int h) {
        return zan_gui_write_pixels(surfaceId, path, x, y, w, h);
    }
    int DumpRaw(string path, int x, int y, int w, int h) { return zan_gui_surface_dump(surfaceId, path); }
    void Clear(int color) { zan_gui_clear(surfaceId, color); }
    void ClearRect(int x, int y, int w, int h, int color) {
        PaintHash.Op(25, x, y, w, h);
        PaintHash.Op(0, color, 0, 0, 0);
        zan_gui_clear_rect(surfaceId, x, y, w, h, color);
    }
    static int RasterStat(int idx, int kind) { return zan_gui_stat_read(idx, kind); }
    static void TextStatEnable(bool enabled) {
        if (enabled) { zan_gui_text_stat_enable(1); }
        else { zan_gui_text_stat_enable(0); }
    }
    static int TextStat(int idx) { return zan_gui_text_stat_read(idx); }
    static int RasterTopBlend(int rank, int field) { return zan_gui_stat_top(rank, field); }
    static int RasterTopFill(int rank, int field) { return zan_gui_stat_top_fill(rank, field); }
    #if ANDROID || OHOS
    [DllImport("zan_gui")]
    static extern string zan_gui_mem_report();
    #endif
    static string MemReport() {
        #if ANDROID || OHOS
        return zan_gui_mem_report() + " " + ImageCodec.MemReport();
        #else
        return "";
        #endif
    }
    void FillRect(int x, int y, int w, int h, int color) {
        if (opacityPm < 1000) { color = this.ApplyOpacity(color); }
        if (w <= 0 || h <= 0 || color == 0 || (color & 0xFF000000) == 0) { return; }
        if (PaintHash.On) {
            PaintHash.Op(1, x, y, w, h);
            PaintHash.Op(0, color, 0, 0, 0);
        }
        zan_gui_fill_rect(surfaceId, x, y, w, h, color);
    }
    void PushClip(int x, int y, int w, int h) { zan_gui_push_clip(surfaceId, x, y, w, h); }
    void PopClip() { zan_gui_pop_clip(surfaceId); }
    void ResetClip() { zan_gui_reset_clip(surfaceId); }
    void DrawRect(int x, int y, int w, int h, int color, int thickness) {
        if (opacityPm < 1000) { color = this.ApplyOpacity(color); }
        if (w <= 0 || h <= 0 || thickness <= 0 || color == 0 || (color & 0xFF000000) == 0) { return; }
        if (PaintHash.On) {
            PaintHash.Op(2, x, y, w, h);
            PaintHash.Op(0, color, thickness, 0, 0);
        }
        zan_gui_draw_rect(surfaceId, x, y, w, h, color, thickness);
    }
    void FillRoundRect(int x, int y, int w, int h, int radius, int color) {
        if (opacityPm < 1000) { color = this.ApplyOpacity(color); }
        if (w <= 0 || h <= 0 || color == 0 || (color & 0xFF000000) == 0) { return; }
        if (PaintHash.On) {
            PaintHash.Op(3, x, y, w, h);
            PaintHash.Op(0, radius, color, 0, 0);
        }
        zan_gui_fill_rounded_rect(surfaceId, x, y, w, h, radius, color);
    }
    internal void FillInitialShape(int x, int y, int w, int h, int radius, int color) {
        if (opacityPm < 1000) { color = this.ApplyOpacity(color); }
        if (w <= 0 || h <= 0 || color == 0 || (color & 0xFF000000) == 0) { return; }
        if (PaintHash.On) {
            if (radius > 0) {
                PaintHash.Op(3, x, y, w, h);
                PaintHash.Op(0, radius, color, 0, 0);
            } else {
                PaintHash.Op(1, x, y, w, h);
                PaintHash.Op(0, color, 0, 0, 0);
            }
        }
        zan_gui_fill_initial_shape(surfaceId, x, y, w, h, radius, color);
    }
    void DrawRoundRect(int x, int y, int w, int h, int radius, int color, int thickness) {
        if (opacityPm < 1000) { color = this.ApplyOpacity(color); }
        if (w <= 0 || h <= 0 || thickness <= 0 || color == 0 || (color & 0xFF000000) == 0) { return; }
        if (PaintHash.On) {
            PaintHash.Op(4, x, y, w, h);
            PaintHash.Op(0, radius, color, thickness, 0);
        }
        zan_gui_draw_rounded_rect(surfaceId, x, y, w, h, radius, color, thickness);
    }
    void FillRoundRectIn(int x, int y, int w, int h, int radius, int corners, int color) {
        if (opacityPm < 1000) { color = this.ApplyOpacity(color); }
        if (w <= 0 || h <= 0 || color == 0 || (color & 0xFF000000) == 0) { return; }
        if (PaintHash.On) {
            PaintHash.Op(5, x, y, w, h);
            PaintHash.Op(0, radius, corners, color, 0);
        }
        zan_gui_fill_rounded_rect_mask(surfaceId, x, y, w, h, radius, corners, color);
    }
    void DrawRoundRectIn(int x, int y, int w, int h, int radius, int corners,
    int color, int thickness) {
        if (opacityPm < 1000) { color = this.ApplyOpacity(color); }
        if (w <= 0 || h <= 0 || thickness <= 0 || color == 0 || (color & 0xFF000000) == 0) { return; }
        if (PaintHash.On) {
            PaintHash.Op(6, x, y, w, h);
            PaintHash.Op(0, radius, corners, color, thickness);
        }
        zan_gui_draw_rounded_rect_mask(surfaceId, x, y, w, h, radius, corners, color, thickness);
    }
    void SurfaceRoundRect(int x, int y, int w, int h, int radius,
    int fill, int border, int borderThickness) {
        if (w <= 0 || h <= 0) { return; }
        if (opacityPm < 1000) {
            fill = this.ApplyOpacity(fill);
            border = this.ApplyOpacity(border);
        }
        if (fill == 0 && (border == 0 || borderThickness <= 0)) { return; }
        if (PaintHash.On) {
            PaintHash.Op(26, x, y, w, h);
            PaintHash.Op(0, radius, fill, border, borderThickness);
        }
        zan_gui_surface_rounded_rect(surfaceId, x, y, w, h, radius, fill, border, borderThickness);
    }
    void SurfaceRoundRectIn(int x, int y, int w, int h, int radius, int corners,
    int fill, int border, int borderThickness) {
        if (w <= 0 || h <= 0) { return; }
        if (opacityPm < 1000) {
            fill = this.ApplyOpacity(fill);
            border = this.ApplyOpacity(border);
        }
        if (fill == 0 && (border == 0 || borderThickness <= 0)) { return; }
        if (PaintHash.On) {
            PaintHash.Op(27, x, y, w, h);
            PaintHash.Op(0, radius, corners, 0, 0);
            PaintHash.Op(0, fill, border, borderThickness, 0);
        }
        zan_gui_surface_rounded_rect_mask(surfaceId, x, y, w, h, radius, corners,
        fill, border, borderThickness);
    }
    void ShadowRoundRect(int x, int y, int w, int h, int radius, int blur, int color) {
        if (opacityPm < 1000) { color = this.ApplyOpacity(color); }
        if (w <= 0 || h <= 0 || color == 0 || (color & 0xFF000000) == 0) { return; }
        if (PaintHash.On) {
            PaintHash.Op(28, x, y, w, h);
            PaintHash.Op(0, radius, blur, color, 0);
        }
        zan_gui_shadow_rounded_rect(surfaceId, x, y, w, h, radius, blur, color);
    }
    void BlurRect(int x, int y, int w, int h, int radius) {
        PaintHash.Op(34, x, y, w, h);
        PaintHash.Op(0, radius, 0, 0, 0);
        zan_gui_blur_rect(surfaceId, x, y, w, h, radius);
    }
    void BlurRectCached(int x, int y, int w, int h, int radius,
    int slot, bool dirty) {
        int d = 0;
        if (dirty) { d = 1; }
        PaintHash.Op(35, x, y, w, h);
        PaintHash.Op(0, radius, slot, d, 0);
        zan_gui_blur_rect_cached(surfaceId, x, y, w, h, radius, slot, d);
    }
    void BlurRoundCached(int x, int y, int w, int h, int radius,
    int slot, bool dirty, int cornerRadius, int cornerMask) {
        int d = 0;
        if (dirty) { d = 1; }
        PaintHash.Op(36, x, y, w, h);
        PaintHash.Op(0, radius, slot, d, 0);
        PaintHash.Op(0, cornerRadius, cornerMask, 0, 0);
        zan_gui_blur_round_cached(surfaceId, x, y, w, h, radius, slot, d,
        cornerRadius, cornerMask);
    }
    bool BeginStaticGlass(int slot, int x, int y, int w, int h, int blur,
    int radius, int corners, int fill, int sheen, int sheenColor, int sheenCap, bool dirty) {
        int d = 0;
        if (dirty) { d = 1; }
        return zan_gui_glass_begin(surfaceId, slot, x, y, w, h, blur, radius,
        corners, fill, sheen, sheenColor, sheenCap, d) != 0;
    }
    void EndStaticGlass(int slot) { zan_gui_glass_end(surfaceId, slot); }
    static int TakeBlurPartialMiss() { return zan_gui_blur_partial_miss_take(); }
    void SnapshotRect(int x, int y, int w, int h, int slot) {
        PaintHash.Op(37, x, y, w, h);
        PaintHash.Op(0, slot, 0, 0, 0);
        zan_gui_snapshot_rect(surfaceId, x, y, w, h, slot);
    }
    void SnapshotPatchRect(int x, int y, int w, int h, int slot) {
        PaintHash.Op(38, x, y, w, h);
        PaintHash.Op(0, slot, 0, 0, 0);
        zan_gui_snapshot_patch_rect(surfaceId, x, y, w, h, slot);
    }
    bool RestoreRect(int x, int y, int w, int h, int slot) {
        PaintHash.Op(39, x, y, w, h);
        PaintHash.Op(0, slot, 0, 0, 0);
        return zan_gui_restore_rect(surfaceId, x, y, w, h, slot) != 0;
    }
    bool RestoreSubRect(int x, int y, int w, int h, int slot) {
        PaintHash.Op(40, x, y, w, h);
        PaintHash.Op(0, slot, 0, 0, 0);
        return zan_gui_restore_sub_rect(surfaceId, x, y, w, h, slot) != 0;
    }
    bool Dump(string path) { return zan_gui_surface_dump(surfaceId, path) != 0; }
    void ReleaseSlot(int slot) { zan_gui_surface_release(surfaceId, slot); }
    void FillVGrad(int x, int y, int w, int h, int colorTop, int colorBottom) {
        colorTop = this.ApplyOpacity(colorTop);
        colorBottom = this.ApplyOpacity(colorBottom);
        if (w <= 0 || h <= 0) { return; }
        if ((colorTop & 0xFF000000) == 0 && (colorBottom & 0xFF000000) == 0) { return; }
        PaintHash.Op(7, x, y, w, h);
        PaintHash.Op(0, colorTop, colorBottom, 0, 0);
        if (((colorTop >> 24) & 255) < 255 || ((colorBottom >> 24) & 255) < 255) {
            zan_gui_fill_grad_mask(surfaceId, x, y, w, h, 0, 0, 0, colorTop, 0, colorBottom);
            return;
        }
        zan_gui_fill_vgrad(surfaceId, x, y, w, h, colorTop, colorBottom);
    }
    void FillVGradMask(int x, int y, int w, int h, int radius, int mask,
    int colorTop, int colorBottom) {
        colorTop = this.ApplyOpacity(colorTop);
        colorBottom = this.ApplyOpacity(colorBottom);
        PaintHash.Op(8, x, y, w, h);
        PaintHash.Op(0, radius, mask, 0, 0);
        PaintHash.Op(0, colorTop, colorBottom, 0, 0);
        zan_gui_fill_vgrad_mask(surfaceId, x, y, w, h, radius, mask,
        colorTop, colorBottom);
    }
    void FillGradMask(int x, int y, int w, int h, int radius, int mask, int dir,
    int colorFrom, int colorVia, int colorTo) {
        colorFrom = this.ApplyOpacity(colorFrom);
        colorVia = this.ApplyOpacity(colorVia);
        colorTo = this.ApplyOpacity(colorTo);
        PaintHash.Op(9, x, y, w, h);
        PaintHash.Op(0, radius, mask, dir, 0);
        PaintHash.Op(0, colorFrom, colorVia, colorTo, 0);
        zan_gui_fill_grad_mask(surfaceId, x, y, w, h, radius, mask, dir,
        colorFrom, colorVia, colorTo);
    }
    void FillCircle(int cx, int cy, int radius, int color) {
        color = this.ApplyOpacity(color);
        if (radius <= 0 || color == 0 || (color & 0xFF000000) == 0) { return; }
        PaintHash.Op(10, cx, cy, radius, color);
        zan_gui_fill_circle(surfaceId, cx, cy, radius, color);
    }
    void DrawCircle(int cx, int cy, int radius, int color, int thickness) {
        color = this.ApplyOpacity(color);
        if (radius <= 0 || thickness <= 0 || color == 0 || (color & 0xFF000000) == 0) { return; }
        PaintHash.Op(11, cx, cy, radius, color);
        PaintHash.Op(0, thickness, 0, 0, 0);
        zan_gui_draw_circle(surfaceId, cx, cy, radius, color, thickness);
    }
    void FillRadial(int cx, int cy, int radius, int color, int innerAlpha) {
        if (opacityPm < 1000) { innerAlpha = innerAlpha * opacityPm / 1000; }
        if (radius <= 0 || innerAlpha <= 0 || color == 0) { return; }
        PaintHash.Op(12, cx, cy, radius, color);
        PaintHash.Op(0, innerAlpha, 0, 0, 0);
        zan_gui_fill_radial(surfaceId, cx, cy, radius, color, innerAlpha);
    }
    void DrawLine(int x0, int y0, int x1, int y1, int color, int thickness) {
        color = this.ApplyOpacity(color);
        if (thickness <= 0 || color == 0 || (color & 0xFF000000) == 0 || (x0 == x1 && y0 == y1)) { return; }
        PaintHash.Op(13, x0, y0, x1, y1);
        PaintHash.Op(0, color, thickness, 0, 0);
        zan_gui_draw_line(surfaceId, x0, y0, x1, y1, color, thickness);
    }
    void DrawLineFx(int x0, int y0, int x1, int y1, int color, int thickness) {
        color = this.ApplyOpacity(color);
        if (thickness <= 0 || (color & 0xFF000000) == 0 || (x0 == x1 && y0 == y1)) { return; }
        PaintHash.Op(15, x0, y0, x1, y1);
        PaintHash.Op(0, color, thickness, 0, 0);
        nint buf = Canvas.EnsurePolyScratch(16);
        Span<int> points = new Span<int>(buf, 4);
        points[0] = x0;
        points[1] = y0;
        points[2] = x1;
        points[3] = y1;
        zan_gui_draw_polyline_fx(surfaceId, buf, 2, color, thickness);
    }
    static nint scratchPolyBuf;
    static int scratchPolyCap;
    static nint scratchCountBuf;
    static int scratchCountCap;
    static nint EnsurePolyScratch(int bytes) {
        if (Canvas.scratchPolyCap < bytes) {
            if (Canvas.scratchPolyBuf != 0) { NativeMemory.Free(Canvas.scratchPolyBuf); }
            int newCap = bytes < 4096 ? 4096 : bytes * 2;
            Canvas.scratchPolyBuf = NativeMemory.Alloc(newCap);
            Canvas.scratchPolyCap = newCap;
        }
        return Canvas.scratchPolyBuf;
    }
    static nint EnsureCountScratch(int bytes) {
        if (Canvas.scratchCountCap < bytes) {
            if (Canvas.scratchCountBuf != 0) { NativeMemory.Free(Canvas.scratchCountBuf); }
            int newCap = bytes < 1024 ? 1024 : bytes * 2;
            Canvas.scratchCountBuf = NativeMemory.Alloc(newCap);
            Canvas.scratchCountCap = newCap;
        }
        return Canvas.scratchCountBuf;
    }
    void DrawPolyline(List<int> xs, List<int> ys, int color, int thickness) {
        color = this.ApplyOpacity(color);
        if (thickness <= 0 || color == 0 || (color & 0xFF000000) == 0 || xs == null || ys == null) { return; }
        int n = xs.Count < ys.Count ? xs.Count : ys.Count;
        if (n < 2) { return; }
        PaintHash.Op(14, n, n, color, thickness);
        PaintHash.List(xs);
        PaintHash.List(ys);
        nint buf = Canvas.EnsurePolyScratch(n * 8);
        Span<int> sp = new Span<int>(buf, n * 2);
        for (int i = 0; i < n; i = i + 1) {
            sp[i * 2] = xs[i];
            sp[i * 2 + 1] = ys[i];
        }
        zan_gui_draw_polyline(surfaceId, buf, n, color, thickness);
    }
    void DrawPolylineFx(List<int> xs, List<int> ys, int color, int thickness) {
        color = this.ApplyOpacity(color);
        if (thickness <= 0 || color == 0 || (color & 0xFF000000) == 0 || xs == null || ys == null) { return; }
        int n = xs.Count < ys.Count ? xs.Count : ys.Count;
        if (n < 2) { return; }
        PaintHash.Op(15, n, n, color, thickness);
        PaintHash.List(xs);
        PaintHash.List(ys);
        nint buf = Canvas.EnsurePolyScratch(n * 8);
        Span<int> sp = new Span<int>(buf, n * 2);
        for (int i = 0; i < n; i = i + 1) {
            sp[i * 2] = xs[i];
            sp[i * 2 + 1] = ys[i];
        }
        zan_gui_draw_polyline_fx(surfaceId, buf, n, color, thickness);
    }
    void DrawPolyBatch(List<int> xs, List<int> counts, int color, int thickness) {
        this.DrawPolyBatchImpl(xs, counts, color, thickness, false);
    }
    void DrawPolyBatchFx(List<int> xs, List<int> counts, int color, int thickness) {
        this.DrawPolyBatchImpl(xs, counts, color, thickness, true);
    }
    private void DrawPolyBatchImpl(List<int> xs, List<int> counts, int color, int thickness, bool fx) {
        color = this.ApplyOpacity(color);
        if (thickness <= 0 || color == 0 || (color & 0xFF000000) == 0
            || xs == null || counts == null || counts.Count < 1) { return; }
        int total = 0;
        for (int i = 0; i < counts.Count; i = i + 1) {
            if (counts[i] < 0) { return; }
            total = total + counts[i];
        }
        if (total < 2 || xs.Count < total * 2) { return; }
        PaintHash.Op(fx ? 19 : 16, total, counts.Count, color, thickness);
        PaintHash.List(xs);
        PaintHash.List(counts);
        nint buf = Canvas.EnsurePolyScratch(total * 8);
        nint cbuf = Canvas.EnsureCountScratch(counts.Count * 4);
        Span<int> sp = new Span<int>(buf, total * 2);
        for (int i = 0; i < total * 2; i = i + 1) { sp[i] = xs[i]; }
        Span<int> cp = new Span<int>(cbuf, counts.Count);
        for (int i = 0; i < counts.Count; i = i + 1) { cp[i] = counts[i]; }
        if (fx) {
            zan_gui_draw_polybatch_fx(surfaceId, buf, cbuf, counts.Count, color, thickness);
        } else {
            zan_gui_draw_polybatch(surfaceId, buf, cbuf, counts.Count, color, thickness);
        }
    }
    void FillSector(int cx, int cy, int rInner, int rOuter, int a0Deg, int a1Deg, int color) {
        color = this.ApplyOpacity(color);
        if (rOuter <= 0 || rOuter <= rInner || a0Deg == a1Deg || color == 0 || (color & 0xFF000000) == 0) { return; }
        PaintHash.Op(17, cx, cy, rInner, rOuter);
        PaintHash.Op(0, a0Deg, a1Deg, color, 0);
        zan_gui_fill_sector(surfaceId, cx, cy, rInner, rOuter, a0Deg, a1Deg, color);
    }
    void DrawArc(int cx, int cy, int rInner, int rOuter, int a0Deg, int a1Deg, int color, int thickness) {
        color = this.ApplyOpacity(color);
        if (thickness <= 0 || rOuter <= 0 || a0Deg == a1Deg || color == 0 || (color & 0xFF000000) == 0) { return; }
        PaintHash.Op(18, cx, cy, rInner, rOuter);
        PaintHash.Op(0, a0Deg, a1Deg, color, thickness);
        int r0 = rInner;
        int r1 = rOuter;
        if (r1 < r0) { int tmp = r0; r0 = r1; r1 = tmp; }
        int s0 = r1 - thickness;
        if (s0 < r0) { s0 = r0; }
        zan_gui_fill_sector(surfaceId, cx, cy, s0, r1, a0Deg, a1Deg, color);
    }
}
