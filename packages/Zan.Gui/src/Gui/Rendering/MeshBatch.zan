using System;
using System.Runtime.Intrinsics;

namespace Gui;

// 打包 3D 实例批：把一帧的全部网格实例（同网格 = 一组，一次
// DrawElementsInstanced）装进一块预分配的 NativeMemory 缓冲，跨帧复用
// ——热路径零分配。Draw 时按 (mesh, texture) 连段分组提交：Begin 一次
// （批内只清一次深度）→ 每组一次 <see cref="Canvas.DrawMesh3DBatch"/>
// → End 一次（整批恰好一次 Finish）。批内实例与跨组之间都做深度解析。
// 建议按组连续 Add（RTS 场景天然如此：按单位类型装填）；乱序 Add 也
// 正确，只是多出几次提交。
// 每实例 20 个 float：mvp 16（列主序，Mat4.ToColumnMajor() 组出）+
// tint rgba 4（线性 0..1，由 0xAARRGGBB 打包色展开）。单次提交上限
// 1024 实例（运行时实例缓冲容量），超出自动分段。
public class MeshBatch {
    nint buf;
    int capInstances;
    int count;
    int[] meshIds;
    int[] texIds;
    List<string> texKeys;
    Dict<string, int> texLookup;
    int lastTexKey;

    MeshBatch() {
        this.buf = 0;
        this.capInstances = 0;
        this.count = 0;
        this.texKeys = new List<string>();
        this.texLookup = new Dict<string, int>();
        this.lastTexKey = -1;
    }

    // 分配可容纳 capInstances 个实例的批缓冲。
    public static MeshBatch Create(int capInstances) {
        if (capInstances <= 0) { return null; }
        MeshBatch mb = new MeshBatch();
        mb.buf = NativeMemory.Alloc(capInstances * 80);
        mb.capInstances = capInstances;
        mb.count = 0;
        mb.meshIds = new int[capInstances];
        mb.texIds = new int[capInstances];
        return mb;
    }

    // 清空批（不释放缓冲），开始装新一帧。
    public void Begin() {
        this.count = 0;
        this.texKeys.Clear();
        this.texLookup.Clear();
        this.lastTexKey = -1;
    }

    // 本批已装填的实例数。
    public int Count() {
        return this.count;
    }

    int GetOrAddTexture(string texture) {
        if (texture == null) { texture = ""; }
        int texId = this.lastTexKey;
        if (texId >= 0 && texId < this.texKeys.Count && this.texKeys[texId] == texture) {
            return texId;
        }
        if (this.texLookup.TryGetValue(texture, out texId)) {
            this.lastTexKey = texId;
            return texId;
        }
        texId = this.texKeys.Count;
        this.texKeys.Add(texture);
        this.texLookup.Add(texture, texId);
        this.lastTexKey = texId;
        return texId;
    }

    // 装一个实例。缓冲满时静默丢弃（容量在 Create 时定）。
    // mvpColumnMajor 为 16 个 float（列主序）；tintArgb 为 0xAARRGGBB。
    // 采用 128 位 SIMD 流水线直接写入 NativeMemory 缓冲，彻底规避逐元素标量拷贝与 Span 开销。
    public void Add(int mesh, string texture, float[] mvpColumnMajor,
                    int tintArgb) {
        if (this.count >= this.capInstances) { return; }
        if (mvpColumnMajor == null || mvpColumnMajor.Length < 16) { return; }
        nint p = this.buf + (nint)(this.count * 80);
        Vector128.Store(p, Vector128.Load(mvpColumnMajor, 0));
        Vector128.Store(p + (nint)16, Vector128.Load(mvpColumnMajor, 4));
        Vector128.Store(p + (nint)32, Vector128.Load(mvpColumnMajor, 8));
        Vector128.Store(p + (nint)48, Vector128.Load(mvpColumnMajor, 12));
        if (tintArgb == -1) {
            Vector128.Store(p + (nint)64, Vector128.Create(1.0f));
        } else {
            Vector128.Store(p + (nint)64, Vector128.Create(
                (float)((tintArgb >> 16) & 255) * 0.0039215686f,
                (float)((tintArgb >> 8) & 255) * 0.0039215686f,
                (float)(tintArgb & 255) * 0.0039215686f,
                (float)((tintArgb >> 24) & 255) * 0.0039215686f
            ));
        }
        int texId = GetOrAddTexture(texture);
        this.meshIds[this.count] = mesh;
        this.texIds[this.count] = texId;
        this.count = this.count + 1;
    }

    // 装一个实例（Mat4 直通重载，原位转置写入原生缓冲，彻底消除逐实例 float[16] 临时数组分配）。
    public void Add(int mesh, string texture, Mat4 mvp, int tintArgb) {
        if (this.count >= this.capInstances || mvp == null || mvp.m == null || mvp.m.Length < 16) { return; }
        nint p = this.buf + (nint)(this.count * 80);
        float[] m = mvp.m;
        Vector128.Store(p, Vector128.Create(m[0], m[4], m[8], m[12]));
        Vector128.Store(p + (nint)16, Vector128.Create(m[1], m[5], m[9], m[13]));
        Vector128.Store(p + (nint)32, Vector128.Create(m[2], m[6], m[10], m[14]));
        Vector128.Store(p + (nint)48, Vector128.Create(m[3], m[7], m[11], m[15]));
        if (tintArgb == -1) {
            Vector128.Store(p + (nint)64, Vector128.Create(1.0f));
        } else {
            Vector128.Store(p + (nint)64, Vector128.Create(
                (float)((tintArgb >> 16) & 255) * 0.0039215686f,
                (float)((tintArgb >> 8) & 255) * 0.0039215686f,
                (float)(tintArgb & 255) * 0.0039215686f,
                (float)((tintArgb >> 24) & 255) * 0.0039215686f
            ));
        }
        int texId = GetOrAddTexture(texture);
        this.meshIds[this.count] = mesh;
        this.texIds[this.count] = texId;
        this.count = this.count + 1;
    }

    // 整批提交到画布：Begin → 按 (mesh, texture) 连段分组提交 → End。
    // 批内共享同一份深度缓冲：跨组网格之间做真实遮挡（一组转到另一组
    // 背后时被正确挡住）。返回 1 = GPU 批次已提交；0 = 未提交（空批，
    // 或 CPU 兜底档不支持 3D——调用方据此换 2D 回退）。
    public int Draw(Canvas c) {
        if (this.count <= 0) { return 0; }
        if (c.DrawMesh3DBatchBegin() != 1) { return 0; }
        int i = 0;
        while (i < this.count) {
            int mesh = this.meshIds[i];
            int texId = this.texIds[i];
            int j = i;
            while (j < this.count && this.meshIds[j] == mesh &&
                   this.texIds[j] == texId) {
                j = j + 1;
            }
            int run = j - i;
            int offset = 0;
            while (run > 0) {
                int chunk = run > 1024 ? 1024 : run;
                c.DrawMesh3DBatch(mesh, this.texKeys[texId],
                                  this.buf + (i + offset) * 80, chunk);
                offset = offset + chunk;
                run = run - chunk;
            }
            i = j;
        }
        c.DrawMesh3DBatchEnd();
        return 1;
    }

    // 释放底层缓冲。此后本对象不可再用。
    public void Dispose() {
        if (this.buf != 0) {
            NativeMemory.Free(this.buf);
            this.buf = 0;
        }
        this.capInstances = 0;
        this.count = 0;
        this.meshIds = null;
        this.texIds = null;
    }
}
