using System;
using Gui;

namespace Gui;

public class FxOptions {
    public bool ripple;  // 点击涟漪
    public bool specular;  // 悬停时跟随光标的高光
    public bool borderGlow;  // 流动的边框光
    public bool sheen;  // 沿表面滑过的对角光带
    public bool aurora;  // 内容后方飘动的大片柔和色块
    public bool breath;  // 整个边框亮度轻微脉动
    public bool motes;  // 内部向上飘动的小柔光点
    public bool spotlight;  // 指针位于控件内时跟随光标的光晕
    public int  glowColor;  // 0 = 使用主题主色
    public int  glowPeriodMs;  // 边框光晕行进周期

    FxOptions() {
        this.ripple = true;
        this.specular = false;
        this.borderGlow = false;
        this.sheen = false;
        this.aurora = false;
        this.breath = false;
        this.motes = false;
        this.spotlight = false;
        this.glowColor = 0;
        this.glowPeriodMs = 2600;
    }
}

