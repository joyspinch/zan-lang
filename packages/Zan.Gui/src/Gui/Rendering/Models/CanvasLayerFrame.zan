using System;

namespace Gui;

// Canvas 图层栈帧：保存父表面上下文与当前离屏合成参数（分组透明度 + 2D 缩放/旋转）。
internal class CanvasLayerFrame {
    internal int parentSurfaceId;
    internal int layerSurfaceId;
    internal int x;
    internal int y;
    internal int w;
    internal int h;
    internal int opacityPm;
    internal int scalePm;
    internal int angleDeg;
    internal int prevOpacityPm;

    internal CanvasLayerFrame(int parentSurfaceId, int layerSurfaceId,
                              int x, int y, int w, int h,
                              int opacityPm, int scalePm, int angleDeg,
                              int prevOpacityPm) {
        this.parentSurfaceId = parentSurfaceId;
        this.layerSurfaceId = layerSurfaceId;
        this.x = x;
        this.y = y;
        this.w = w;
        this.h = h;
        this.opacityPm = opacityPm;
        this.scalePm = scalePm;
        this.angleDeg = angleDeg;
        this.prevOpacityPm = prevOpacityPm;
    }
}
