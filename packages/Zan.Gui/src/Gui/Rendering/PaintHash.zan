using System;
using System.Collections.Generic;

namespace Gui;

// 绘制指纹：局部帧模式下按绘制命令累积哈希，用来判断控件这一帧画的内容是否变了
// （没变就不登记脏区）。全局累加器——同一时刻只有一个控件段在绘制；按控件的
// 比较表与脏区登记在 App.CommitPaintHash。
public static class PaintHash {
    // 本帧是否在累积（局部帧开启时由渲染循环置位）。
    public static bool On;
    public static long Acc;

    public static void Restore(PaintHashToken token) {
        On = token.armed;
        Acc = token.accumulator;
    }
    public static bool Suspend() {
        bool armed = On;
        On = false;
        return armed;
    }
    public static void Resume(bool armed) {
        On = armed;
    }
    public static void Op(int op, int a, int b, int c, int d) {
        if (!On) { return; }
        long h = Acc;
        h = (h * 1099511628211) ^ op;
        h = (h * 1099511628211) ^ a;
        h = (h * 1099511628211) ^ b;
        h = (h * 1099511628211) ^ c;
        h = (h * 1099511628211) ^ d;
        Acc = h;
    }
    public static void Text(int op, int a, int b, int c, int d, string text) {
        if (!On) { return; }
        long h = Acc;
        h = (h * 1099511628211) ^ op;
        h = (h * 1099511628211) ^ a;
        h = (h * 1099511628211) ^ b;
        h = (h * 1099511628211) ^ c;
        h = (h * 1099511628211) ^ d;
        int n = text.Length;
        h = (h * 1099511628211) ^ n;
        for (int i = 0; i < n; i = i + 1) {
            h = (h * 1099511628211) ^ text[i];
        }
        Acc = h;
    }
    public static void List(List<int> xs) {
        if (!On) { return; }
        long h = Acc;
        int n = xs.Count;
        h = (h * 1099511628211) ^ n;
        for (int i = 0; i < n; i = i + 1) {
            h = (h * 1099511628211) ^ xs[i];
        }
        Acc = h;
    }
    public static bool Armed() {
        return On;
    }
    // A segment owns only its direct commands. Nested retained or non-tree
    // painters restore the parent's prefix instead of feeding it child commands.
    public static PaintHashToken BeginScope() {
        PaintHashToken token;
        token.armed = On;
        token.accumulator = Acc;
        if (token.armed) { Acc = 5381; }
        return token;
    }
}
