using System;
using System.Collections.Generic;
using System.Runtime.Intrinsics;

namespace Gui;

// 网格构建器：交错顶点 + ushort 索引，与运行时 3D 管线的顶点布局逐字节
// 对应。默认每顶点 8 个 float（px,py,pz, nx,ny,nz, u,v）；一旦调用过
// <see cref="VertexC"/> 即切换为顶点色布局（12 float，尾随 r,g,b,a），
// <see cref="Canvas.MeshUpload"/> 会按布局封送。两种布局不得混用——
// 同一网格只走一种 Vertex*。Build 之后可复用 Upload 到不同表面。
public class Mesh3D {
    List<float> v;
    List<ushort> idx;
    bool colored;
    int vertexCount;

    public Mesh3D() {
        this.v = new List<float>();
        this.idx = new List<ushort>();
        this.colored = false;
        this.vertexCount = 0;
    }

    // 本网格是否为顶点色布局（12 float/顶点）。
    public bool Colored() { return this.colored; }

    // 每顶点 float 数（8 = 无顶点色，12 = 顶点色）。
    public int StrideFloats() { return this.colored ? 12 : 8; }

    // 追加一个顶点，返回其索引。
    public int Vertex(float px, float py, float pz,
                      float nx, float ny, float nz,
                      float u, float vv) {
        this.v.Add(px); this.v.Add(py); this.v.Add(pz);
        this.v.Add(nx); this.v.Add(ny); this.v.Add(nz);
        this.v.Add(u); this.v.Add(vv);
        int idx = this.vertexCount;
        this.vertexCount = idx + 1;
        return idx;
    }

    // 追加一个带颜色的顶点（r,g,b,a 线性 0..1），网格切换为顶点色布局，
    // 返回其索引。颜色与绘制时的 uColor/tint、纹理相乘。
    public int VertexC(float px, float py, float pz,
                       float nx, float ny, float nz,
                       float u, float vv,
                       float r, float g, float b, float a) {
        this.colored = true;
        this.v.Add(px); this.v.Add(py); this.v.Add(pz);
        this.v.Add(nx); this.v.Add(ny); this.v.Add(nz);
        this.v.Add(u); this.v.Add(vv);
        this.v.Add(r); this.v.Add(g); this.v.Add(b); this.v.Add(a);
        int idx = this.vertexCount;
        this.vertexCount = idx + 1;
        return idx;
    }

    // 按逆时针（从观察方向看）追加一个三角形，保证正面朝外。
    public void Triangle(int a, int b, int c) {
        this.idx.Add((ushort)a);
        this.idx.Add((ushort)b);
        this.idx.Add((ushort)c);
    }

    // 两个三角形组成一个四边形（a,b,c,d 逆时针）。
    public void Quad(int a, int b, int c, int d) {
        this.Triangle(a, b, c);
        this.Triangle(a, c, d);
    }

    public int VertexCount() { return this.vertexCount; }
    public int IndexCount() { return this.idx.Count; }

    // 直接复制顶点到原生内存，采用 128 位 SIMD 流水线写出，避免中途分配 float[] 堆数组。
    public void CopyVerticesTo(nint dest) {
        int n = this.v.Count;
        int i = 0;
        int simdEnd = n - 3;
        while (i < simdEnd) {
            Vector128.Store(dest + (nint)(i * 4), Vector128.Create(this.v[i], this.v[i + 1], this.v[i + 2], this.v[i + 3]));
            i = i + 4;
        }
        Span<float> s = new Span<float>(dest, n);
        while (i < n) {
            s[i] = this.v[i];
            i = i + 1;
        }
    }

    // 直接复制索引到原生内存，避免中途分配 ushort[] 堆数组。
    public void CopyIndicesTo(nint dest) {
        int n = this.idx.Count;
        Span<ushort> s = new Span<ushort>(dest, n);
        for (int i = 0; i < n; i = i + 1) { s[i] = this.idx[i]; }
    }

    // 交错顶点缓冲（Canvas.MeshUpload 封送用），128 位 SIMD 快速拷贝。
    public float[] VertexArray() {
        int n = this.v.Count;
        float[] outv = new float[n];
        int i = 0;
        int simdEnd = n - 3;
        while (i < simdEnd) {
            Vector128.Store(outv, i, Vector128.Create(this.v[i], this.v[i + 1], this.v[i + 2], this.v[i + 3]));
            i = i + 4;
        }
        while (i < n) {
            outv[i] = this.v[i];
            i = i + 1;
        }
        return outv;
    }

    // 三角索引缓冲（Canvas.MeshUpload 封送用）。
    public ushort[] IndexArray() {
        int n = this.idx.Count;
        ushort[] outi = new ushort[n];
        for (int i = 0; i < n; i = i + 1) { outi[i] = this.idx[i]; }
        return outi;
    }

    // 以单位立方体（边长 2，中心原点）填充此网格并给全部顶点同一颜色
    // （r,g,b,a 线性 0..1），六面 UV 全贴。网格进入顶点色布局。
    public void AddCubeColored(float r, float g, float b, float a) {
        // +z front
        int a0 = this.VertexC(-1, -1, 1, 0, 0, 1, 0, 1, r, g, b, a);
        int b0 = this.VertexC(1, -1, 1, 0, 0, 1, 1, 1, r, g, b, a);
        int c0 = this.VertexC(1, 1, 1, 0, 0, 1, 1, 0, r, g, b, a);
        int d0 = this.VertexC(-1, 1, 1, 0, 0, 1, 0, 0, r, g, b, a);
        this.Quad(a0, b0, c0, d0);
        // -z back
        a0 = this.VertexC(1, -1, -1, 0, 0, -1, 0, 1, r, g, b, a);
        b0 = this.VertexC(-1, -1, -1, 0, 0, -1, 1, 1, r, g, b, a);
        c0 = this.VertexC(-1, 1, -1, 0, 0, -1, 1, 0, r, g, b, a);
        d0 = this.VertexC(1, 1, -1, 0, 0, -1, 0, 0, r, g, b, a);
        this.Quad(a0, b0, c0, d0);
        // +x right
        a0 = this.VertexC(1, -1, 1, 1, 0, 0, 0, 1, r, g, b, a);
        b0 = this.VertexC(1, -1, -1, 1, 0, 0, 1, 1, r, g, b, a);
        c0 = this.VertexC(1, 1, -1, 1, 0, 0, 1, 0, r, g, b, a);
        d0 = this.VertexC(1, 1, 1, 1, 0, 0, 0, 0, r, g, b, a);
        this.Quad(a0, b0, c0, d0);
        // -x left
        a0 = this.VertexC(-1, -1, -1, -1, 0, 0, 0, 1, r, g, b, a);
        b0 = this.VertexC(-1, -1, 1, -1, 0, 0, 1, 1, r, g, b, a);
        c0 = this.VertexC(-1, 1, 1, -1, 0, 0, 1, 0, r, g, b, a);
        d0 = this.VertexC(-1, 1, -1, -1, 0, 0, 0, 0, r, g, b, a);
        this.Quad(a0, b0, c0, d0);
        // +y top
        a0 = this.VertexC(-1, 1, 1, 0, 1, 0, 0, 1, r, g, b, a);
        b0 = this.VertexC(1, 1, 1, 0, 1, 0, 1, 0, r, g, b, a);
        c0 = this.VertexC(1, 1, -1, 0, 1, 0, 1, 0, r, g, b, a);
        d0 = this.VertexC(-1, 1, -1, 0, 1, 0, 0, 0, r, g, b, a);
        this.Quad(a0, b0, c0, d0);
        // -y bottom
        a0 = this.VertexC(-1, -1, -1, 0, -1, 0, 0, 1, r, g, b, a);
        b0 = this.VertexC(1, -1, -1, 0, -1, 0, 1, 1, r, g, b, a);
        c0 = this.VertexC(1, -1, 1, 0, -1, 0, 1, 0, r, g, b, a);
        d0 = this.VertexC(-1, -1, 1, 0, -1, 0, 0, 0, r, g, b, a);
        this.Quad(a0, b0, c0, d0);
    }

    // 以单位立方体（边长 2，中心原点）填充此网格，六面 UV 全贴。
    public void AddCube() {
        // +z front
        int a = this.Vertex(-1, -1, 1, 0, 0, 1, 0, 1);
        int b = this.Vertex(1, -1, 1, 0, 0, 1, 1, 1);
        int c = this.Vertex(1, 1, 1, 0, 0, 1, 1, 0);
        int d = this.Vertex(-1, 1, 1, 0, 0, 1, 0, 0);
        this.Quad(a, b, c, d);
        // -z back
        a = this.Vertex(1, -1, -1, 0, 0, -1, 0, 1);
        b = this.Vertex(-1, -1, -1, 0, 0, -1, 1, 1);
        c = this.Vertex(-1, 1, -1, 0, 0, -1, 1, 0);
        d = this.Vertex(1, 1, -1, 0, 0, -1, 0, 0);
        this.Quad(a, b, c, d);
        // +x right
        a = this.Vertex(1, -1, 1, 1, 0, 0, 0, 1);
        b = this.Vertex(1, -1, -1, 1, 0, 0, 1, 1);
        c = this.Vertex(1, 1, -1, 1, 0, 0, 1, 0);
        d = this.Vertex(1, 1, 1, 1, 0, 0, 0, 0);
        this.Quad(a, b, c, d);
        // -x left
        a = this.Vertex(-1, -1, -1, -1, 0, 0, 0, 1);
        b = this.Vertex(-1, -1, 1, -1, 0, 0, 1, 1);
        c = this.Vertex(-1, 1, 1, -1, 0, 0, 1, 0);
        d = this.Vertex(-1, 1, -1, -1, 0, 0, 0, 0);
        this.Quad(a, b, c, d);
        // +y top
        a = this.Vertex(-1, 1, 1, 0, 1, 0, 0, 1);
        b = this.Vertex(1, 1, 1, 0, 1, 0, 1, 0);
        c = this.Vertex(1, 1, -1, 0, 1, 0, 1, 0);
        d = this.Vertex(-1, 1, -1, 0, 1, 0, 0, 0);
        this.Quad(a, b, c, d);
        // -y bottom
        a = this.Vertex(-1, -1, -1, 0, -1, 0, 0, 1);
        b = this.Vertex(1, -1, -1, 0, -1, 0, 1, 1);
        c = this.Vertex(1, -1, 1, 0, -1, 0, 1, 0);
        d = this.Vertex(-1, -1, 1, 0, -1, 0, 0, 0);
        this.Quad(a, b, c, d);
    }

    // 以 XZ 平面圆盘（n 边形，法线 +y）填充，UV 极坐标展开。
    public void AddGroundDisc(int n, float radius) {
        int center = this.Vertex(0, 0, 0, 0, 1, 0, 0.5f, 0.5f);
        int first = this.Vertex(radius, 0, 0, 0, 1, 0, 1, 0.5f);
        int prev = first;
        double step = (2.0 * Math.PI) / (double)n;
        for (int i = 1; i <= n; i = i + 1) {
            float ang = (float)(i * step);
            float cosA = (float)Math.Cos(ang);
            float sinA = (float)Math.Sin(ang);
            float x = cosA * radius;
            float z = sinA * radius;
            int cur = this.Vertex(x, 0, z, 0, 1, 0,
                                  0.5f + 0.5f * cosA,
                                  0.5f + 0.5f * sinA);
            if (i < n) { this.Triangle(center, prev, cur); }
            prev = cur;
        }
        this.Triangle(center, prev, first);
    }
}
