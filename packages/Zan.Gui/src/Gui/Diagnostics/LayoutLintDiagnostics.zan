using System;
using System.Collections.Generic;
using System.IO;
using Gui.Backend;
namespace Gui.Diagnostics;
public class LayoutLintDiagnostics {
    static bool overlapEnvRead;
    static bool overlapEnvOn;
    static bool debugOverlap;
    static int overlapHits;
    static Dict<string, bool> overlapSeen;
    static bool lintEnvRead;
    static bool lintEnvOn;
    static bool debugLayoutLint;
    static int lintHits;
    static Dict<string, bool> lintSeen;

    public static bool DebugOverlap() { return debugOverlap; }
    public static void SetDebugOverlap(bool enabled) { debugOverlap = enabled; }
    public static bool DebugLayoutLint() { return debugLayoutLint; }
    public static void SetDebugLayoutLint(bool enabled) { debugLayoutLint = enabled; }

    public static bool AnyActive() {
        if (!overlapEnvRead) {
            overlapEnvRead = true;
            overlapEnvOn = Interop.EnvVar("ZAN_GUI_OVERLAP") == "1";
        }
        if (!lintEnvRead) {
            lintEnvRead = true;
            lintEnvOn = Interop.EnvVar("ZAN_GUI_LAYOUTLINT") == "1";
        }
        return debugOverlap || overlapEnvOn || debugLayoutLint || lintEnvOn;
    }

    public static bool OverlapActive() {
        if (!overlapEnvRead) {
            overlapEnvRead = true;
            overlapEnvOn = Interop.EnvVar("ZAN_GUI_OVERLAP") == "1";
        }
        return debugOverlap || overlapEnvOn;
    }

    public static int OverlapHits() { return overlapHits; }
    public static void ResetOverlapHits() {
        overlapHits = 0;
        overlapSeen = null;
    }

    public static void RecordOverlap(string sig, string parentKind, string aKind, int ax, int ay, int aw, int ah,
                                     string bKind, int bx, int by, int bw, int bh, int ix, int iy) {
        if (overlapSeen == null) { overlapSeen = new Dict<string, bool>(); }
        if (overlapSeen.ContainsKey(sig)) { return; }
        if (overlapSeen.Count < 400) { overlapSeen.Add(sig, true); }
        overlapHits = overlapHits + 1;
        string line = "gui-overlap #" + Convert.ToString(overlapHits)
            + " in " + parentKind
            + ": " + aKind + "[" + Convert.ToString(ax) + ","
            + Convert.ToString(ay) + " " + Convert.ToString(aw)
            + "x" + Convert.ToString(ah) + "] overlaps "
            + bKind + "[" + Convert.ToString(bx) + ","
            + Convert.ToString(by) + " " + Convert.ToString(bw)
            + "x" + Convert.ToString(bh) + "] by "
            + Convert.ToString(ix) + "x" + Convert.ToString(iy) + "px";
        string log = Interop.EnvVar("ZAN_GUI_OVERLAP_LOG");
        if (log.Length > 0) {
            File.AppendAllText(log, line + "\n");
        } else {
            Console.WriteLine(line);
        }
    }

    public static bool LintActive() {
        if (!lintEnvRead) {
            lintEnvRead = true;
            lintEnvOn = Interop.EnvVar("ZAN_GUI_LAYOUTLINT") == "1";
        }
        return debugLayoutLint || lintEnvOn;
    }

    public static int LintHits() { return lintHits; }
    public static void ResetLintHits() {
        lintHits = 0;
        lintSeen = null;
    }

    public static void RecordLint(string sig, string parentKind, string childKind, int cx, int cy, int cw, int ch,
                                  string rule, string detail) {
        if (lintSeen == null) { lintSeen = new Dict<string, bool>(); }
        if (lintSeen.ContainsKey(sig)) { return; }
        if (lintSeen.Count < 400) { lintSeen.Add(sig, true); }
        lintHits = lintHits + 1;
        string line = "gui-lint #" + Convert.ToString(lintHits)
            + " in " + parentKind + ": " + childKind
            + "[" + Convert.ToString(cx) + ","
            + Convert.ToString(cy) + " " + Convert.ToString(cw)
            + "x" + Convert.ToString(ch) + "] " + rule + ": " + detail;
        string log = Interop.EnvVar("ZAN_GUI_OVERLAP_LOG");
        if (log.Length > 0) {
            File.AppendAllText(log, line + "\n");
        } else {
            Console.WriteLine(line);
        }
    }
}
