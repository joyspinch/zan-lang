using System;
using Gui.Backend;
namespace Gui;

public class GuiFrameProfiler : AppFrameDiagnostics {
    public static void EnableFromEnvironment(App app) {
        if (Interop.EnvVar("ZAN_FRAME_PROF") == "1") { GuiFrameProfiler.Enable(app); }
    }

    public static void Enable(App app) {
        if (app != null && app.FrameDiagnostics() == null) { app.SetFrameDiagnostics(new GuiFrameProfiler()); }
    }

    public void FlushLoop(App app, int now) {
        if (app.perfLoopAt == 0) { app.perfLoopAt = now; }
        int span = now - app.perfLoopAt;
        if (span < 2000) { return; }
        File.AppendAllText("zan_frame_perf.log",
        "loops=" + Convert.ToString(app.perfLoops)
        + " over_ms=" + Convert.ToString(span)
        + " frames=" + Convert.ToString(app.perfFrames)
        + " wait_ms=" + Convert.ToString(app.perfLoopMs)
        + " path_poll=" + Convert.ToString(app.perfPollPath)
        + " path_anim=" + Convert.ToString(app.perfAnimPath)
        + " path_block=" + Convert.ToString(app.perfWaitPath)
        + " ev_none=" + Convert.ToString(app.perfEvNone)
        + " ev_move=" + Convert.ToString(app.perfEvMove)
        + " ev_other=" + Convert.ToString(app.perfEvOther)
        + " fx_ticks=" + Convert.ToString(app.perfFxTicks)
        + " fx_only=" + Convert.ToString(app.perfFxOnlyTicks)
        + " fx_tick_ms=" + Convert.ToString(app.perfFxTickMs)
        + " fx_tick_us=" + Convert.ToString(app.perfFxTickUs)
        + " fx_restore_us=" + Convert.ToString(app.perfFxRestoreUs)
        + " fx_render_us=" + Convert.ToString(app.perfFxRenderUs)
        + " fx_present_us=" + Convert.ToString(app.perfFxPresentUs)
        + " fx_kind=" + Convert.ToString(app.EffectiveFx())
        + " anim_armed=" + Convert.ToString(app.animNextMs)
        + " fx_armed=" + Convert.ToString(app.fxNextMs) + "\n");
        app.perfLoopAt = now;
        app.perfLoops = 0;
        app.perfLoopMs = 0;
        app.perfPollPath = 0;
        app.perfAnimPath = 0;
        app.perfWaitPath = 0;
        app.perfEvNone = 0;
        app.perfEvMove = 0;
        app.perfEvOther = 0;
        app.perfFxTicks = 0;
        app.perfFxOnlyTicks = 0;
        app.perfFxTickMs = 0;
        app.perfFxTickUs = 0;
        app.perfFxRestoreUs = 0;
        app.perfFxRenderUs = 0;
        app.perfFxPresentUs = 0;
    }

    public void RecordFrame(App app, int perfBeginMs, int perfPreMs, int endMs, bool partialFrame) {
        int wholeMs = endMs - perfBeginMs;
        if (wholeMs > app.perfWorstMs) { app.perfWorstMs = wholeMs; }
        if (wholeMs > 16) { app.perfSlowFrames = app.perfSlowFrames + 1; }
        int styleNow = Style.StatPeek(0);
        int styleMissNow = styleNow - Style.StatPeek(1);
        int spikePart = 0;
        if (partialFrame) { spikePart = 1; }
        int pxFill = Canvas.RasterStat(0, 2);
        int pxBlend = Canvas.RasterStat(1, 2);
        int pxBlur = Canvas.RasterStat(5, 2);
        int pxGlyph = Canvas.RasterStat(10, 2);
        int pxSnap = Canvas.RasterStat(8, 2);
        if (app.frameCount == 0) {
            int pxRound = Canvas.RasterStat(3, 2);
            int pxGrad = Canvas.RasterStat(2, 2);
            int pxRestore = Canvas.RasterStat(9, 2);
            File.AppendAllText("zan_frame_perf.log",
            "firstframe whole_ms=" + Convert.ToString(wholeMs)
            + " render_ms=" + Convert.ToString(perfPreMs - perfBeginMs)
            + " present_ms=" + Convert.ToString(endMs - perfPreMs)
            + " bg_ms=" + App.UsAvg(app.phaseBgUs, 1)
            + " measure_ms=" + App.UsAvg(app.phaseMeasUs, 1)
            + " arrange_ms=" + App.UsAvg(app.phaseArrUs, 1)
            + " tree_ms=" + App.UsAvg(app.phaseTreeUs, 1)
            + " fill=" + Convert.ToString(pxFill) + "kpx"
            + " blend=" + Convert.ToString(pxBlend) + "kpx"
            + " round=" + Convert.ToString(pxRound) + "kpx"
            + " grad=" + Convert.ToString(pxGrad) + "kpx"
            + " restore=" + Convert.ToString(pxRestore) + "kpx"
            + " blur=" + Convert.ToString(pxBlur) + "kpx"
            + " glyph=" + Convert.ToString(pxGlyph) + "kpx"
            + " snap=" + Convert.ToString(pxSnap) + "kpx"
            + " style=" + Convert.ToString(styleNow)
            + "/" + Convert.ToString(styleMissNow) + "miss"
            + " surface=" + Convert.ToString(app.canvas.Width())
            + "x" + Convert.ToString(app.canvas.Height())
            + " clock=raw-ms"
            + " text_draw_n=" + Convert.ToString(Canvas.TextStat(0))
            + " text_measure_n=" + Convert.ToString(Canvas.TextStat(1))
            + " text_height_n=" + Convert.ToString(Canvas.TextStat(2))
            + " text_font_create_n=" + Convert.ToString(Canvas.TextStat(3))
            + " text_font_hit_n=" + Convert.ToString(Canvas.TextStat(4))
            + " text_draw_hit_n=" + Convert.ToString(Canvas.TextStat(5))
            + " text_draw_miss_n=" + Convert.ToString(Canvas.TextStat(6))
            + " text_measure_hit_n=" + Convert.ToString(Canvas.TextStat(7))
            + " text_measure_miss_n=" + Convert.ToString(Canvas.TextStat(8))
            + " text_draw_us=" + Convert.ToString(Canvas.TextStat(9))
            + " text_measure_us=" + Convert.ToString(Canvas.TextStat(10))
            + " text_height_us=" + Convert.ToString(Canvas.TextStat(11))
            + "\n");
        }
        if (wholeMs > 16) {
            File.AppendAllText("zan_frame_perf.log",
            "spike whole_ms=" + Convert.ToString(wholeMs)
            + " render_ms=" + Convert.ToString(perfPreMs - perfBeginMs)
            + " present_ms=" + Convert.ToString(endMs - perfPreMs)
            + " partial=" + Convert.ToString(spikePart)
            + " style=" + Convert.ToString(styleNow - app.perfStyleAt)
            + "/" + Convert.ToString(styleMissNow - app.perfStyleMissAt)
            + "miss fill=" + Convert.ToString(pxFill - app.perfPxFillAt)
            + "kpx blend=" + Convert.ToString(pxBlend - app.perfPxBlendAt)
            + "kpx blur=" + Convert.ToString(pxBlur - app.perfPxBlurAt)
            + "kpx glyph=" + Convert.ToString(pxGlyph - app.perfPxGlyphAt)
            + " snap=" + Convert.ToString(pxSnap - app.perfPxSnapAt)
            + "kpx bg=" + App.UsAvg(app.phaseBgUs, 1)
            + " measure=" + App.UsAvg(app.phaseMeasUs, 1)
            + " arrange=" + App.UsAvg(app.phaseArrUs, 1)
            + " tree=" + App.UsAvg(app.phaseTreeUs, 1)
            + " top=" + app.phaseTopNode
            + " top_ms=" + App.UsAvg(app.phaseTopUs, 1)
            + " scope=" + app.phaseSecTop
            + " scope_ms=" + App.UsAvg(app.phaseSecTopUs, 1)
            + " mark=" + app.phaseMarkTop
            + " mark_ms=" + App.UsAvg(app.phaseMarkTopUs, 1)
            + " redraw=" + Convert.ToString(app.frameWhyN)
            + "/" + app.frameWhy
            + " frame=" + Convert.ToString(app.frameCount) + "\n");
        }
        app.phaseTopNode = "";
        app.phaseTopUs = 0;
        app.phaseSecTop = "";
        app.phaseSecTopUs = 0;
        app.scopeEndUs = 0;
        app.phaseMarkTop = "";
        app.phaseMarkTopUs = 0;
        app.markAtUs = 0;
        app.markNow = "";
        app.perfBgUs = app.perfBgUs + app.phaseBgUs;
        app.perfMeasUs = app.perfMeasUs + app.phaseMeasUs;
        app.perfArrUs = app.perfArrUs + app.phaseArrUs;
        app.perfTreeUs = app.perfTreeUs + app.phaseTreeUs;
        app.phaseBgUs = 0;
        app.phaseMeasUs = 0;
        app.phaseArrUs = 0;
        app.phaseTreeUs = 0;
        app.perfPxFillAt = pxFill;
        app.perfPxBlendAt = pxBlend;
        app.perfPxBlurAt = pxBlur;
        app.perfPxGlyphAt = pxGlyph;
        app.perfPxSnapAt = pxSnap;
        app.perfStyleAt = styleNow;
        app.perfStyleMissAt = styleMissNow;
        if (partialFrame) {
            app.perfPartFrames = app.perfPartFrames + 1;
            app.perfPartRenderMs = app.perfPartRenderMs + (perfPreMs - perfBeginMs);
            app.perfPartPresentMs = app.perfPartPresentMs + (endMs - perfPreMs);
        } else {
            app.perfRenderMs = app.perfRenderMs + (perfPreMs - perfBeginMs);
            app.perfPresentMs = app.perfPresentMs + (endMs - perfPreMs);
            app.NoteFullFrameWhy();
        }
        app.frameWhy = "";
        app.perfFrames = app.perfFrames + 1;
        if (app.perfFrames >= 30) {
            int fullN = app.perfFrames - app.perfPartFrames;
            if (fullN <= 0) { fullN = 1; }
            int partN = app.perfPartFrames;
            if (partN <= 0) { partN = 1; }
            File.AppendAllText("zan_frame_perf.log",
            "frames=" + Convert.ToString(app.perfFrames)
            + " full=" + Convert.ToString(app.perfFrames - app.perfPartFrames)
            + " render_ms=" + App.MsAvg(app.perfRenderMs, fullN)
            + " present_ms=" + App.MsAvg(app.perfPresentMs, fullN)
            + " partial=" + Convert.ToString(app.perfPartFrames)
            + " part_render_ms=" + App.MsAvg(app.perfPartRenderMs, partN)
            + " part_present_ms=" + App.MsAvg(app.perfPartPresentMs, partN)
            + " bg_ms=" + App.UsAvg(app.perfBgUs, app.perfFrames)
            + " meas_ms=" + App.UsAvg(app.perfMeasUs, app.perfFrames)
            + " arr_ms=" + App.UsAvg(app.perfArrUs, app.perfFrames)
            + " tree_ms=" + App.UsAvg(app.perfTreeUs, app.perfFrames)
            + " slow=" + Convert.ToString(app.perfSlowFrames)
            + " worst_ms=" + Convert.ToString(app.perfWorstMs)
            + " surface=" + Convert.ToString(app.canvas.Width())
            + "x" + Convert.ToString(app.canvas.Height())
            + " clock=raw-ms"
            + " " + App.RasterLine(app.perfFrames)
            + "whytop=" + app.FullFrameWhyTop(3)
            + "\n");
            app.perfFrames = 0;
            app.perfRenderMs = 0;
            app.perfPresentMs = 0;
            app.perfPartFrames = 0;
            app.perfPartRenderMs = 0;
            app.perfPartPresentMs = 0;
            app.perfSlowFrames = 0;
            app.perfWorstMs = 0;
            app.perfBgUs = 0;
            app.perfMeasUs = 0;
            app.perfArrUs = 0;
            app.perfTreeUs = 0;
        }
    }

    public void Snapshot() { File.AppendAllText("zan_frame_perf.log", "fframe snap=1\n"); }
    public void Partial(int x, int y, int w, int h, int blurMiss) {
        File.AppendAllText("zan_frame_perf.log", "pframe present=" + Convert.ToString(x) + ","
        + Convert.ToString(y) + "+" + Convert.ToString(w) + "x" + Convert.ToString(h)
        + " miss=" + Convert.ToString(blurMiss) + "\n");
    }
    public void Damage(bool scroll, int x, int y, int w, int h) {
        File.AppendAllText("zan_frame_perf.log", (scroll ? "scroll_damage=" : "damage_decl=")
        + Convert.ToString(x) + "," + Convert.ToString(y) + "+"
        + Convert.ToString(w) + "x" + Convert.ToString(h) + "\n");
    }
    public void FxRepair(bool full, int count) {
        File.AppendAllText("zan_frame_perf.log", "fxp full=" + (full ? 1 : 0) + " n=" + count + "\n");
    }
}
