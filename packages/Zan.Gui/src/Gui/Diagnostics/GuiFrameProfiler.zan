using System;
using Gui.Backend;
namespace Gui;

public class GuiFrameProfiler : AppFrameDiagnostics {
    public static void EnableFromEnvironment(App app) {
        if (Interop.EnvVar("ZAN_FRAME_PROF") == "1") { GuiFrameProfiler.Enable(app); }
    }

    public static void Enable(App app) {
        if (app != null && app.FrameDiagnostics() == null) { app.SetFrameDiagnostics(new GuiFrameProfiler()); }
    }

    public void FlushLoop(App app, int now) {
        if (app.Stats.LoopAt == 0) { app.Stats.LoopAt = now; }
        int span = now - app.Stats.LoopAt;
        if (span < 2000) { return; }
        File.AppendAllText("zan_frame_perf.log",
        "loops=" + Convert.ToString(app.Stats.Loops)
        + " over_ms=" + Convert.ToString(span)
        + " frames=" + Convert.ToString(app.Stats.Frames)
        + " wait_ms=" + Convert.ToString(app.Stats.LoopMs)
        + " path_poll=" + Convert.ToString(app.Stats.PollPath)
        + " path_anim=" + Convert.ToString(app.Stats.AnimPath)
        + " path_block=" + Convert.ToString(app.Stats.WaitPath)
        + " ev_none=" + Convert.ToString(app.Stats.EvNone)
        + " ev_move=" + Convert.ToString(app.Stats.EvMove)
        + " ev_other=" + Convert.ToString(app.Stats.EvOther)
        + " fx_ticks=" + Convert.ToString(app.Stats.FxTicks)
        + " fx_only=" + Convert.ToString(app.Stats.FxOnlyTicks)
        + " fx_tick_ms=" + Convert.ToString(app.Stats.FxTickMs)
        + " fx_tick_us=" + Convert.ToString(app.Stats.FxTickUs)
        + " fx_restore_us=" + Convert.ToString(app.Stats.FxRestoreUs)
        + " fx_render_us=" + Convert.ToString(app.Stats.FxRenderUs)
        + " fx_present_us=" + Convert.ToString(app.Stats.FxPresentUs)
        + " fx_kind=" + Convert.ToString(app.EffectiveFx())
        + " anim_armed=" + Convert.ToString(app.animNextMs)
        + " fx_armed=" + Convert.ToString(app.fxNextMs) + "\n");
        app.Stats.LoopAt = now;
        app.Stats.Loops = 0;
        app.Stats.LoopMs = 0;
        app.Stats.PollPath = 0;
        app.Stats.AnimPath = 0;
        app.Stats.WaitPath = 0;
        app.Stats.EvNone = 0;
        app.Stats.EvMove = 0;
        app.Stats.EvOther = 0;
        app.Stats.FxTicks = 0;
        app.Stats.FxOnlyTicks = 0;
        app.Stats.FxTickMs = 0;
        app.Stats.FxTickUs = 0;
        app.Stats.FxRestoreUs = 0;
        app.Stats.FxRenderUs = 0;
        app.Stats.FxPresentUs = 0;
    }

    public void RecordFrame(App app, int perfBeginMs, int perfPreMs, int endMs, bool partialFrame) {
        int wholeMs = endMs - perfBeginMs;
        if (wholeMs > app.Stats.WorstMs) { app.Stats.WorstMs = wholeMs; }
        if (wholeMs > 16) { app.Stats.SlowFrames = app.Stats.SlowFrames + 1; }
        int styleNow = Style.StatPeek(0);
        int styleMissNow = styleNow - Style.StatPeek(1);
        int spikePart = 0;
        if (partialFrame) { spikePart = 1; }
        int pxFill = Canvas.RasterStat(0, 2);
        int pxBlend = Canvas.RasterStat(1, 2);
        int pxBlur = Canvas.RasterStat(5, 2);
        int pxGlyph = Canvas.RasterStat(10, 2);
        int pxSnap = Canvas.RasterStat(8, 2);
        if (app.frameCount == 0) {
            int pxRound = Canvas.RasterStat(3, 2);
            int pxGrad = Canvas.RasterStat(2, 2);
            int pxRestore = Canvas.RasterStat(9, 2);
            File.AppendAllText("zan_frame_perf.log",
            "firstframe whole_ms=" + Convert.ToString(wholeMs)
            + " render_ms=" + Convert.ToString(perfPreMs - perfBeginMs)
            + " present_ms=" + Convert.ToString(endMs - perfPreMs)
            + " bg_ms=" + FrameStats.UsAvg(app.Stats.PhaseBgUs, 1)
            + " measure_ms=" + FrameStats.UsAvg(app.Stats.PhaseMeasUs, 1)
            + " arrange_ms=" + FrameStats.UsAvg(app.Stats.PhaseArrUs, 1)
            + " tree_ms=" + FrameStats.UsAvg(app.Stats.PhaseTreeUs, 1)
            + " fill=" + Convert.ToString(pxFill) + "kpx"
            + " blend=" + Convert.ToString(pxBlend) + "kpx"
            + " round=" + Convert.ToString(pxRound) + "kpx"
            + " grad=" + Convert.ToString(pxGrad) + "kpx"
            + " restore=" + Convert.ToString(pxRestore) + "kpx"
            + " blur=" + Convert.ToString(pxBlur) + "kpx"
            + " glyph=" + Convert.ToString(pxGlyph) + "kpx"
            + " snap=" + Convert.ToString(pxSnap) + "kpx"
            + " style=" + Convert.ToString(styleNow)
            + "/" + Convert.ToString(styleMissNow) + "miss"
            + " surface=" + Convert.ToString(app.canvas.Width())
            + "x" + Convert.ToString(app.canvas.Height())
            + " clock=raw-ms"
            + " text_draw_n=" + Convert.ToString(Canvas.TextStat(0))
            + " text_measure_n=" + Convert.ToString(Canvas.TextStat(1))
            + " text_height_n=" + Convert.ToString(Canvas.TextStat(2))
            + " text_font_create_n=" + Convert.ToString(Canvas.TextStat(3))
            + " text_font_hit_n=" + Convert.ToString(Canvas.TextStat(4))
            + " text_draw_hit_n=" + Convert.ToString(Canvas.TextStat(5))
            + " text_draw_miss_n=" + Convert.ToString(Canvas.TextStat(6))
            + " text_measure_hit_n=" + Convert.ToString(Canvas.TextStat(7))
            + " text_measure_miss_n=" + Convert.ToString(Canvas.TextStat(8))
            + " text_draw_us=" + Convert.ToString(Canvas.TextStat(9))
            + " text_measure_us=" + Convert.ToString(Canvas.TextStat(10))
            + " text_height_us=" + Convert.ToString(Canvas.TextStat(11))
            + "\n");
        }
        if (wholeMs > 16) {
            File.AppendAllText("zan_frame_perf.log",
            "spike whole_ms=" + Convert.ToString(wholeMs)
            + " render_ms=" + Convert.ToString(perfPreMs - perfBeginMs)
            + " present_ms=" + Convert.ToString(endMs - perfPreMs)
            + " partial=" + Convert.ToString(spikePart)
            + " style=" + Convert.ToString(styleNow - app.Stats.StyleAt)
            + "/" + Convert.ToString(styleMissNow - app.Stats.StyleMissAt)
            + "miss fill=" + Convert.ToString(pxFill - app.Stats.PxFillAt)
            + "kpx blend=" + Convert.ToString(pxBlend - app.Stats.PxBlendAt)
            + "kpx blur=" + Convert.ToString(pxBlur - app.Stats.PxBlurAt)
            + "kpx glyph=" + Convert.ToString(pxGlyph - app.Stats.PxGlyphAt)
            + " snap=" + Convert.ToString(pxSnap - app.Stats.PxSnapAt)
            + "kpx bg=" + FrameStats.UsAvg(app.Stats.PhaseBgUs, 1)
            + " measure=" + FrameStats.UsAvg(app.Stats.PhaseMeasUs, 1)
            + " arrange=" + FrameStats.UsAvg(app.Stats.PhaseArrUs, 1)
            + " tree=" + FrameStats.UsAvg(app.Stats.PhaseTreeUs, 1)
            + " top=" + app.Stats.PhaseTopNode
            + " top_ms=" + FrameStats.UsAvg(app.Stats.PhaseTopUs, 1)
            + " scope=" + app.Stats.PhaseSecTop
            + " scope_ms=" + FrameStats.UsAvg(app.Stats.PhaseSecTopUs, 1)
            + " mark=" + app.Stats.PhaseMarkTop
            + " mark_ms=" + FrameStats.UsAvg(app.Stats.PhaseMarkTopUs, 1)
            + " redraw=" + Convert.ToString(app.Stats.FrameWhyN)
            + "/" + app.Stats.FrameWhy
            + " frame=" + Convert.ToString(app.frameCount) + "\n");
        }
        app.Stats.PhaseTopNode = "";
        app.Stats.PhaseTopUs = 0;
        app.Stats.PhaseSecTop = "";
        app.Stats.PhaseSecTopUs = 0;
        app.Stats.ScopeEndUs = 0;
        app.Stats.PhaseMarkTop = "";
        app.Stats.PhaseMarkTopUs = 0;
        app.Stats.MarkAtUs = 0;
        app.Stats.MarkNow = "";
        app.Stats.BgUs = app.Stats.BgUs + app.Stats.PhaseBgUs;
        app.Stats.MeasUs = app.Stats.MeasUs + app.Stats.PhaseMeasUs;
        app.Stats.ArrUs = app.Stats.ArrUs + app.Stats.PhaseArrUs;
        app.Stats.TreeUs = app.Stats.TreeUs + app.Stats.PhaseTreeUs;
        app.Stats.PhaseBgUs = 0;
        app.Stats.PhaseMeasUs = 0;
        app.Stats.PhaseArrUs = 0;
        app.Stats.PhaseTreeUs = 0;
        app.Stats.PxFillAt = pxFill;
        app.Stats.PxBlendAt = pxBlend;
        app.Stats.PxBlurAt = pxBlur;
        app.Stats.PxGlyphAt = pxGlyph;
        app.Stats.PxSnapAt = pxSnap;
        app.Stats.StyleAt = styleNow;
        app.Stats.StyleMissAt = styleMissNow;
        if (partialFrame) {
            app.Stats.PartFrames = app.Stats.PartFrames + 1;
            app.Stats.PartRenderMs = app.Stats.PartRenderMs + (perfPreMs - perfBeginMs);
            app.Stats.PartPresentMs = app.Stats.PartPresentMs + (endMs - perfPreMs);
        } else {
            app.Stats.RenderMs = app.Stats.RenderMs + (perfPreMs - perfBeginMs);
            app.Stats.PresentMs = app.Stats.PresentMs + (endMs - perfPreMs);
            app.Stats.NoteFullFrameWhy();
        }
        app.Stats.FrameWhy = "";
        app.Stats.Frames = app.Stats.Frames + 1;
        if (app.Stats.Frames >= 30) {
            int fullN = app.Stats.Frames - app.Stats.PartFrames;
            if (fullN <= 0) { fullN = 1; }
            int partN = app.Stats.PartFrames;
            if (partN <= 0) { partN = 1; }
            File.AppendAllText("zan_frame_perf.log",
            "frames=" + Convert.ToString(app.Stats.Frames)
            + " full=" + Convert.ToString(app.Stats.Frames - app.Stats.PartFrames)
            + " render_ms=" + FrameStats.MsAvg(app.Stats.RenderMs, fullN)
            + " present_ms=" + FrameStats.MsAvg(app.Stats.PresentMs, fullN)
            + " partial=" + Convert.ToString(app.Stats.PartFrames)
            + " part_render_ms=" + FrameStats.MsAvg(app.Stats.PartRenderMs, partN)
            + " part_present_ms=" + FrameStats.MsAvg(app.Stats.PartPresentMs, partN)
            + " bg_ms=" + FrameStats.UsAvg(app.Stats.BgUs, app.Stats.Frames)
            + " meas_ms=" + FrameStats.UsAvg(app.Stats.MeasUs, app.Stats.Frames)
            + " arr_ms=" + FrameStats.UsAvg(app.Stats.ArrUs, app.Stats.Frames)
            + " tree_ms=" + FrameStats.UsAvg(app.Stats.TreeUs, app.Stats.Frames)
            + " slow=" + Convert.ToString(app.Stats.SlowFrames)
            + " worst_ms=" + Convert.ToString(app.Stats.WorstMs)
            + " surface=" + Convert.ToString(app.canvas.Width())
            + "x" + Convert.ToString(app.canvas.Height())
            + " clock=raw-ms"
            + " " + App.RasterLine(app.Stats.Frames)
            + "whytop=" + app.Stats.FullFrameWhyTop(3)
            + "\n");
            app.Stats.Frames = 0;
            app.Stats.RenderMs = 0;
            app.Stats.PresentMs = 0;
            app.Stats.PartFrames = 0;
            app.Stats.PartRenderMs = 0;
            app.Stats.PartPresentMs = 0;
            app.Stats.SlowFrames = 0;
            app.Stats.WorstMs = 0;
            app.Stats.BgUs = 0;
            app.Stats.MeasUs = 0;
            app.Stats.ArrUs = 0;
            app.Stats.TreeUs = 0;
        }
    }

    public void Snapshot() { File.AppendAllText("zan_frame_perf.log", "fframe snap=1\n"); }
    public void Partial(int x, int y, int w, int h, int blurMiss) {
        File.AppendAllText("zan_frame_perf.log", "pframe present=" + Convert.ToString(x) + ","
        + Convert.ToString(y) + "+" + Convert.ToString(w) + "x" + Convert.ToString(h)
        + " miss=" + Convert.ToString(blurMiss) + "\n");
    }
    public void Damage(bool scroll, int x, int y, int w, int h) {
        File.AppendAllText("zan_frame_perf.log", (scroll ? "scroll_damage=" : "damage_decl=")
        + Convert.ToString(x) + "," + Convert.ToString(y) + "+"
        + Convert.ToString(w) + "x" + Convert.ToString(h) + "\n");
    }
    public void FxRepair(bool full, int count) {
        File.AppendAllText("zan_frame_perf.log", "fxp full=" + (full ? 1 : 0) + " n=" + count + "\n");
    }
}
