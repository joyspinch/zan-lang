name = "Zan.Test"
version = "1.0.0"
description = "Lightweight test framework for Zan: non-aborting assertions (Equal/Nearly/Contains/Null/Throws over int/long/double/bool/string), an explicit-registration runner with setup/teardown, groups, skip, per-case timing and result recording, a deterministic ok/FAIL/skip + summary output contract, and Report/Finish for CI exit codes - no reflection, no codegen, pure Zan, no native dependencies"
author = "Zan Team"
license = "MIT"
