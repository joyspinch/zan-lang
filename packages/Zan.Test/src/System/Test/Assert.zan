using System;

namespace System.Test;

// 测试体：无参、无返回。用 lambda 传：Test.Run("name", () => { ... });
public delegate void TestBody();

// 断言库。**不抛异常**——失败的断言立刻打一行 `FAIL <what>: <细节>` 并累加
// 计数，用例体继续跑完，一次运行能看到全部失败点（CI 里比"首个失败即中断"
// 省轮次）。判过没过由 Test.Run 比对 Assert.Failures() 前后差值得出。
//
// 输出格式固定、可 grep：
//   FAIL <what>            —— 布尔断言失败
//   FAIL <what>: expected <e>, got <a>   —— 等值/包含失败
public class Assert {
    // 全局失败计数（Test.Run 用它判定用例是否通过）。
    public static int failures = 0;

    public static int Failures() { return Assert.failures; }
    public static void Reset() { Assert.failures = 0; }

    // 失败即打一行并计数；调用方（各断言）只负责组织 message。
    public static void Fail(string what, string detail) {
        Assert.failures = Assert.failures + 1;
        if (detail == "") { Console.WriteLine("FAIL " + what); }
        else { Console.WriteLine("FAIL " + what + ": " + detail); }
    }

    // 可空字符串的可读呈现。
    public static string Show(string s) {
        if (s == null) { return "<null>"; }
        return s;
    }

    public static void True(bool cond, string what) {
        if (!cond) { Assert.Fail(what, "expected true"); }
    }

    public static void False(bool cond, string what) {
        if (cond) { Assert.Fail(what, "expected false"); }
    }

    public static void Equal(int expected, int actual, string what) {
        if (expected != actual) {
            Assert.Fail(what, "expected " + Convert.ToString(expected)
                + ", got " + Convert.ToString(actual));
        }
    }

    public static void Equal(long expected, long actual, string what) {
        if (expected != actual) {
            Assert.Fail(what, "expected " + Convert.ToString(expected)
                + ", got " + Convert.ToString(actual));
        }
    }

    public static void Equal(double expected, double actual, string what) {
        if (expected != actual) {
            Assert.Fail(what, "expected " + Convert.ToString(expected)
                + ", got " + Convert.ToString(actual));
        }
    }

    public static void Equal(bool expected, bool actual, string what) {
        if (expected != actual) {
            if (expected) { Assert.Fail(what, "expected true, got false"); }
            else { Assert.Fail(what, "expected false, got true"); }
        }
    }

    // 期望为 null 字符串、实际非 null 的简写（字符串比较等值形态另有 Equal）。
    public static void Equal(string expected, string actual, string what) {
        if (expected == null || actual == null) {
            if (expected == null && actual == null) { return; }
            Assert.Fail(what, "expected " + Assert.Show(expected)
                + ", got " + Assert.Show(actual));
            return;
        }
        if (expected != actual) {
            Assert.Fail(what, "expected " + expected + ", got " + actual);
        }
    }

    // 浮点近似比较：|expected - actual| <= eps。
    public static void Nearly(double expected, double actual, double eps, string what) {
        double d = expected - actual;
        if (d < 0) { d = -d; }
        if (!(d <= eps)) {
            Assert.Fail(what, "expected ~" + Convert.ToString(expected)
                + " (+-" + Convert.ToString(eps) + "), got " + Convert.ToString(actual));
        }
    }

    public static void NotNull(object v, string what) {
        if (v == null) { Assert.Fail(what, "expected non-null"); }
    }

    public static void Null(object v, string what) {
        if (v != null) { Assert.Fail(what, "expected null"); }
    }

    public static void Contains(string hay, string needle, string what) {
        if (hay == null || needle == null) {
            Assert.Fail(what, "expected " + Assert.Show(hay)
                + " to contain " + Assert.Show(needle));
            return;
        }
        if (hay.IndexOf(needle, 0) < 0) {
            Assert.Fail(what, "expected " + hay + " to contain " + needle);
        }
    }

    // 期待用例体抛异常（Exception 对象或字符串 throw 都算）。
    public static void Throws(TestBody body, string what) {
        bool threw = false;
        try {
            body();
        } catch (Exception e) {
            threw = true;
        } catch {
            threw = true;
        }
        if (!threw) { Assert.Fail(what, "expected a throw, none happened"); }
    }

    // 期待用例体不抛异常。
    public static void NotThrows(TestBody body, string what) {
        try {
            body();
        } catch (Exception e) {
            Assert.Fail(what, "unexpected throw: " + e.Message);
        } catch {
            Assert.Fail(what, "unexpected non-exception throw");
        }
    }
}
