using System;

namespace System.Test;

// 一条带标签的用例：label 进测试 id 的方括号里（pytest 的 ids 语义）。
// 用来装"没法用单一类型参数表达"的用例——多参数、异构、或者干脆一整段
// 准备好的场景。
public class TestCase {
    public string label;
    public TestBody body;

    public TestCase(string label, TestBody body) {
        this.label = label;
        this.body = body;
    }
}

// 参数化委托。Zan 的 object 不装箱值类型，参数集合装不进 List<object>，
// 所以参数化必须按类型特化——这也是为什么有四个 ParamXxx 而不是
// 一个泛型的 Param<T>。
public delegate void ParamInt(int value);
public delegate void ParamString(string value);
public delegate void ParamDouble(double value);
public delegate void ParamBool(bool value);

// 两个 int 参数（笛卡尔积）。
public delegate void ParamIntPair(int first, int second);
