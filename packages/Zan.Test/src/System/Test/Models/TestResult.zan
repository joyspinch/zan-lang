namespace System.Test;

// 用例结果。ok == false 时 message 记首个失败原因（断言摘要或异常消息）。
public class TestResult {
    public string name;
    public bool ok;
    public bool skipped;
    public string message;
    // 用例体耗时（微秒），含 setup/teardown。
    public long micros;

    public TestResult(string name, bool ok, string message, long micros) {
        this.name = name;
        this.ok = ok;
        this.skipped = false;
        this.message = message;
        this.micros = micros;
    }
}
