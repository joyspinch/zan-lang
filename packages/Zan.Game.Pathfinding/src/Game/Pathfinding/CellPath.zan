using System;
using System.Collections.Generic;

namespace Game.Pathfinding;

// 格子路径：从起点到终点的一串格子。
//
// 路径**含两端**（起点与终点）。空路径表示不可达——用 IsEmpty() 判，
// 不要用 Count() == 1 之类的形状假设。
public class CellPath {
    public List<GridPoint> points;
    // 本次搜索展开的节点数（统计用；A* / JPS 都会填）。
    public int expandedNodes;

    public CellPath() {
        this.points = new List<GridPoint>();
        this.expandedNodes = 0;
    }

    public int Count() { return this.points.Count; }
    public bool IsEmpty() { return this.points.Count == 0; }

    public GridPoint Get(int index) { return this.points[index]; }
    public void Add(GridPoint point) { this.points.Add(point); }

    // 路径总代价（欧氏模型：对角一步算 √2 倍，进入格子的代价按格计）。
    public double TotalCost(GridMap map) {
        double total = 0.0;
        for (int i = 1; i < this.points.Count; i = i + 1) {
            GridPoint a = this.points[i - 1];
            GridPoint b = this.points[i];
            total = total + CellPath.StepCost(map, a, b);
        }
        return total;
    }

    // 折线的实际长度（按格子中心的欧氏距离累加）。
    public double GeometricLength(GridMap map) {
        double total = 0.0;
        for (int i = 1; i < this.points.Count; i = i + 1) {
            Point2 a = map.CellCenter(this.points[i - 1].x, this.points[i - 1].y);
            Point2 b = map.CellCenter(this.points[i].x, this.points[i].y);
            total = total + a.DistanceTo(b);
        }
        return total;
    }

    // 换成世界坐标（格子中心）。
    public List<Point2> ToWorldPoints(GridMap map) {
        List<Point2> result = new List<Point2>();
        for (int i = 0; i < this.points.Count; i = i + 1) {
            GridPoint p = this.points[i];
            result.Add(map.CellCenter(p.x, p.y));
        }
        return result;
    }

    // 两格之间的步进代价（对角 = √2 倍格距，进入格子的代价取两端均值）。
    public static double StepCost(GridMap map, GridPoint a, GridPoint b) {
        return CellPath.StepCost(map, a, b, false);
    }

    // uniform = true 时对角一步也算 1.0（均匀代价模型，JPS 用这个）。
    public static double StepCost(GridMap map, GridPoint a, GridPoint b, bool uniform) {
        int dx = b.x - a.x;
        int dy = b.y - a.y;
        bool diagonal = dx != 0 && dy != 0;
        double distance = diagonal ? 1.4142135623730951 : 1.0;
        if (uniform) { distance = 1.0; }
        double ca = map.Cost(a.x, a.y);
        double cb = map.Cost(b.x, b.y);
        if (ca < 0.0) { ca = 1.0; }
        if (cb < 0.0) { cb = 1.0; }
        return distance * (ca + cb) * 0.5;
    }

    public override string ToString() {
        return "CellPath(" + this.points.Count.ToString() + " points)";
    }
}
