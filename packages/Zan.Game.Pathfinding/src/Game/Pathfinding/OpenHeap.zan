namespace Game.Pathfinding;

// 开放表用的最小堆：整数元素 + 双精度优先级 + 次级平局键。
//
// 次级键（通常是 h）让 f 相同的节点按"离目标更近"排前面——展开顺序因此
// 确定，同一张图同一对起终点必然给出同一条路径（回放 / 锁步的前提）。
public class OpenHeap {
    private int[] items;
    private double[] keys;
    private double[] ties;
    private int count;

    public OpenHeap(int capacity) {
        if (capacity < 16) { capacity = 16; }
        this.items = new int[capacity];
        this.keys = new double[capacity];
        this.ties = new double[capacity];
        this.count = 0;
    }

    public bool IsEmpty() { return this.count == 0; }
    public int Count() { return this.count; }

    public void Push(int item, double key, double tie) {
        if (this.count == this.items.Length) { this.Grow(); }
        this.items[this.count] = item;
        this.keys[this.count] = key;
        this.ties[this.count] = tie;
        this.count = this.count + 1;
        this.SiftUp(this.count - 1);
    }

    public int Pop() {
        int result = this.items[0];
        this.count = this.count - 1;
        if (this.count > 0) {
            this.items[0] = this.items[this.count];
            this.keys[0] = this.keys[this.count];
            this.ties[0] = this.ties[this.count];
            this.SiftDown(0);
        }
        return result;
    }

    private void Grow() {
        int n = this.items.Length * 2;
        int[] nextItems = new int[n];
        double[] nextKeys = new double[n];
        double[] nextTies = new double[n];
        for (int i = 0; i < this.count; i = i + 1) {
            nextItems[i] = this.items[i];
            nextKeys[i] = this.keys[i];
            nextTies[i] = this.ties[i];
        }
        this.items = nextItems;
        this.keys = nextKeys;
        this.ties = nextTies;
    }

    // a 是否排在 b 前面：先比优先级，再比平局键。
    private bool Less(int a, int b) {
        if (this.keys[a] != this.keys[b]) { return this.keys[a] < this.keys[b]; }
        return this.ties[a] < this.ties[b];
    }

    private void SiftUp(int i) {
        while (i > 0) {
            int parent = (i - 1) / 2;
            if (this.Less(i, parent)) {
                this.Swap(i, parent);
                i = parent;
            } else {
                break;
            }
        }
    }

    private void SiftDown(int i) {
        int n = this.count;
        while (2 * i + 1 < n) {
            int left = 2 * i + 1;
            int right = 2 * i + 2;
            int smallest = left;
            if (right < n && this.Less(right, left)) { smallest = right; }
            if (this.Less(smallest, i)) {
                this.Swap(smallest, i);
                i = smallest;
            } else {
                break;
            }
        }
    }

    private void Swap(int a, int b) {
        int e = this.items[a];
        this.items[a] = this.items[b];
        this.items[b] = e;
        double k = this.keys[a];
        this.keys[a] = this.keys[b];
        this.keys[b] = k;
        double t = this.ties[a];
        this.ties[a] = this.ties[b];
        this.ties[b] = t;
    }
}
