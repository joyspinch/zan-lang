using System;
using System.IO;

namespace Zan.Browser.Firefox;

/// <summary>
/// 火狐嵌入式内核启动器与运行时路径定位器
/// </summary>
public class FirefoxBootstrap {
    static bool inited = false;

    public static bool Init(nint hostHwnd) {
        if (inited) return true;
        if (!GeckoNative.EnsureLoaded()) return false;
        inited = true;

        if (GeckoNative.PfnInit != 0) {
            GeckoInitFn fn = (GeckoInitFn)GeckoNative.PfnInit;
            return fn(hostHwnd);
        }
        return true;
    }

    public static bool Init() {
        return Init(0);
    }

    public static void ShrinkMemory() {
        if (GeckoNative.PfnShrinkMemory != 0) {
            GeckoVoidFn fn = (GeckoVoidFn)GeckoNative.PfnShrinkMemory;
            fn();
        }
    }
}
