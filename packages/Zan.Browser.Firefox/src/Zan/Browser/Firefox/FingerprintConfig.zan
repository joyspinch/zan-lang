using System;
using System.IO;

namespace Zan.Browser.Firefox;

/// <summary>
/// 硬件指纹防关联档案 (FingerprintProfile)
/// 提供开箱即用、链式按需装配的防关联环境：
/// 1. 屏幕分辨率与设备像素比 (Screen & DPR)
/// 2. 硬件并发数与设备内存 (Hardware Concurrency & Device Memory)
/// 3. Canvas 2D / WebAudio 离散微噪 (Zero-Drift Micro-Noise)
/// 4. WebGL 厂商与渲染器 (Vendor & Renderer)
/// 5. 国家地区时区与多语言环境 (Timezone & Language Hierarchy)
/// 6. User-Agent 与操作系统平台伪装
/// </summary>
public class FingerprintProfile {
    public bool enabled;
    public int seed;
    public bool canvasNoise;
    public bool audioNoise;
    public int hardwareConcurrency;
    public int deviceMemory;
    public int screenWidth;
    public int screenHeight;
    public int screenAvailWidth;
    public int screenAvailHeight;
    public double devicePixelRatio;
    public int colorDepth;
    public int pixelDepth;
    public string language;
    public List<string> languages;
    public string timezone;
    public int timezoneOffset;
    public string webglVendor;
    public string webglRenderer;
    public string userAgent;
    public string platform;

    public FingerprintProfile() {
        this.enabled = true;
        this.seed = 100007;
        this.canvasNoise = true;
        this.audioNoise = true;
        this.hardwareConcurrency = 8;
        this.deviceMemory = 8;
        this.screenWidth = 1920;
        this.screenHeight = 1080;
        this.screenAvailWidth = 1920;
        this.screenAvailHeight = 1040;
        this.devicePixelRatio = 1.0;
        this.colorDepth = 24;
        this.pixelDepth = 24;
        this.language = "en-US";
        this.languages = new List<string>();
        this.languages.Add("en-US");
        this.languages.Add("en");
        this.timezone = "America/New_York";
        this.timezoneOffset = 240; // UTC-4 (EDT: 4*60=240 mins)
        this.webglVendor = "Google Inc. (NVIDIA)";
        this.webglRenderer = "ANGLE (NVIDIA, NVIDIA GeForce RTX 3070 Direct3D11 vs_5_0 ps_5_0, D3D11-30.0.14.7141)";
        this.userAgent = "";
        this.platform = "Win32";
    }

    public FingerprintProfile WithSeed(int s) {
        this.seed = s;
        return this;
    }

    public FingerprintProfile WithHardware(int cores, int memGb) {
        this.hardwareConcurrency = cores;
        this.deviceMemory = memGb;
        return this;
    }

    public FingerprintProfile WithScreen(int w, int h, double dpr) {
        this.screenWidth = w;
        this.screenHeight = h;
        this.screenAvailWidth = w;
        this.screenAvailHeight = (h > 40) ? (h - 40) : h;
        this.devicePixelRatio = dpr;
        return this;
    }

    public FingerprintProfile WithLocale(string lang, List<string> langs) {
        this.language = lang;
        if (langs != null && langs.Count > 0) {
            this.languages = langs;
        } else {
            this.languages = new List<string>();
            this.languages.Add(lang);
        }
        return this;
    }

    public FingerprintProfile WithTimezone(string tz, int offsetMinutes) {
        this.timezone = tz;
        this.timezoneOffset = offsetMinutes;
        return this;
    }

    public FingerprintProfile WithWebGL(string vendor, string renderer) {
        this.webglVendor = vendor;
        this.webglRenderer = renderer;
        return this;
    }

    public FingerprintProfile WithUserAgent(string ua, string plat) {
        this.userAgent = ua;
        if (plat != null && plat != "") {
            this.platform = plat;
        }
        return this;
    }

    public FingerprintProfile WithNoise(bool canvas, bool audio) {
        this.canvasNoise = canvas;
        this.audioNoise = audio;
        return this;
    }

    /// <summary>
    /// 开箱即用预设：纯净默认指纹 (零噪点伪装，直接通达底层真实环境)
    /// </summary>
    public static FingerprintProfile CleanDefault() {
        FingerprintProfile p = new FingerprintProfile();
        p.enabled = false;
        p.canvasNoise = false;
        p.audioNoise = false;
        p.seed = 0;
        return p;
    }

    /// <summary>
    /// 开箱即用预设：根据店铺 ID 和目标国家自动装配确定性隔离的专业指纹 (零漂移，多端一致)
    /// </summary>
    public static FingerprintProfile PresetStore(int storeId, string countryCode) {
        FingerprintProfile p = new FingerprintProfile();
        p.enabled = true;
        p.seed = storeId * 1000003 + 7;
        p.canvasNoise = true;
        p.audioNoise = true;

        // 硬件组合按 storeId 伪随机但确定性分配
        int hwMod = storeId % 3;
        if (hwMod == 0) {
            p.hardwareConcurrency = 16;
            p.deviceMemory = 16;
            p.webglVendor = "Google Inc. (NVIDIA)";
            p.webglRenderer = "ANGLE (NVIDIA, NVIDIA GeForce RTX 4070 Direct3D11 vs_5_0 ps_5_0, D3D11-31.0.15.3623)";
        } else if (hwMod == 1) {
            p.hardwareConcurrency = 8;
            p.deviceMemory = 8;
            p.webglVendor = "Google Inc. (NVIDIA)";
            p.webglRenderer = "ANGLE (NVIDIA, NVIDIA GeForce RTX 3060 Direct3D11 vs_5_0 ps_5_0, D3D11-30.0.14.7141)";
        } else {
            p.hardwareConcurrency = 12;
            p.deviceMemory = 16;
            p.webglVendor = "Google Inc. (AMD)";
            p.webglRenderer = "ANGLE (AMD, AMD Radeon RX 6700 XT Direct3D11 vs_5_0 ps_5_0, D3D11-27.20.14501.18003)";
        }

        // 分辨率组合
        int resMod = storeId % 4;
        if (resMod == 0) {
            p.WithScreen(1920, 1080, 1.0);
        } else if (resMod == 1) {
            p.WithScreen(2560, 1440, 1.25);
        } else if (resMod == 2) {
            p.WithScreen(1920, 1200, 1.0);
        } else {
            p.WithScreen(1680, 1050, 1.0);
        }

        // 国家、语言与时区
        string c = (countryCode != null) ? countryCode.ToUpper() : "US";
        if (c == "US") {
            List<string> langs = new List<string>();
            langs.Add("en-US");
            langs.Add("en");
            p.WithLocale("en-US", langs);
            p.WithTimezone("America/New_York", 240);
        } else if (c == "UK" || c == "GB") {
            List<string> langs = new List<string>();
            langs.Add("en-GB");
            langs.Add("en");
            p.WithLocale("en-GB", langs);
            p.WithTimezone("Europe/London", 0);
        } else if (c == "JP") {
            List<string> langs = new List<string>();
            langs.Add("ja-JP");
            langs.Add("ja");
            langs.Add("en-US");
            p.WithLocale("ja-JP", langs);
            p.WithTimezone("Asia/Tokyo", -540); // UTC+9: -540 mins
        } else if (c == "DE") {
            List<string> langs = new List<string>();
            langs.Add("de-DE");
            langs.Add("de");
            langs.Add("en");
            p.WithLocale("de-DE", langs);
            p.WithTimezone("Europe/Berlin", -60);
        } else {
            List<string> langs = new List<string>();
            langs.Add("zh-CN");
            langs.Add("zh");
            langs.Add("en-US");
            p.WithLocale("zh-CN", langs);
            p.WithTimezone("Asia/Shanghai", -480);
        }
        return p;
    }

    /// <summary>
    /// 开箱即用预设：生成随机伪造的高拟真硬件指纹
    /// </summary>
    public static FingerprintProfile Random() {
        int rSeed = (int)(DateTime.GetCurrentUnixMilliseconds() & 0x7FFFFFFF);
        return FingerprintProfile.PresetStore(rSeed % 1000 + 1, "US");
    }

    /// <summary>
    /// 将配置对象序列化为标准 JSON 字符串以透传至底层 Gecko AntiDetectCore
    /// </summary>
    public string ToJson() {
        string json = "{";
        json = json + "\"enabled\":" + (this.enabled ? "true" : "false");
        json = json + ",\"seed\":" + this.seed.ToString();
        json = json + ",\"canvasNoise\":" + (this.canvasNoise ? "true" : "false");
        json = json + ",\"audioNoise\":" + (this.audioNoise ? "true" : "false");
        json = json + ",\"hardwareConcurrency\":" + this.hardwareConcurrency.ToString();
        json = json + ",\"deviceMemory\":" + this.deviceMemory.ToString();
        json = json + ",\"screenWidth\":" + this.screenWidth.ToString();
        json = json + ",\"screenHeight\":" + this.screenHeight.ToString();
        json = json + ",\"screenAvailWidth\":" + this.screenAvailWidth.ToString();
        json = json + ",\"screenAvailHeight\":" + this.screenAvailHeight.ToString();
        json = json + ",\"devicePixelRatio\":" + this.devicePixelRatio.ToString();
        json = json + ",\"colorDepth\":" + this.colorDepth.ToString();
        json = json + ",\"pixelDepth\":" + this.pixelDepth.ToString();
        json = json + ",\"language\":\"" + this.language + "\"";

        if (this.languages != null && this.languages.Count > 0) {
            json = json + ",\"languages\":[";
            for (int i = 0; i < this.languages.Count; i = i + 1) {
                if (i > 0) { json = json + ","; }
                json = json + "\"" + this.languages[i] + "\"";
            }
            json = json + "]";
        }

        if (this.timezone != null && this.timezone.Length > 0) {
            json = json + ",\"timezone\":\"" + this.timezone + "\"";
            json = json + ",\"timezoneOffset\":" + this.timezoneOffset.ToString();
        }

        if (this.webglVendor != null && this.webglVendor.Length > 0) {
            json = json + ",\"webglVendor\":\"" + this.webglVendor + "\"";
        }
        if (this.webglRenderer != null && this.webglRenderer.Length > 0) {
            json = json + ",\"webglRenderer\":\"" + this.webglRenderer + "\"";
        }
        if (this.userAgent != null && this.userAgent.Length > 0) {
            json = json + ",\"userAgent\":\"" + this.userAgent + "\"";
        }
        if (this.platform != null && this.platform.Length > 0) {
            json = json + ",\"platform\":\"" + this.platform + "\"";
        }

        json = json + "}";
        return json;
    }
}

/// <summary>
/// Zan 浏览器实例综合装配配置 (BrowserConfig)
/// 1 行代码装配一个完全隔离的多店铺浏览器视口：
/// BrowserConfig.ForStore(storeId, "US", "https://amazon.com")
/// </summary>
public class BrowserConfig {
    public int userContextId;
    public string startUrl;
    public FingerprintProfile fingerprint;
    public bool persistentStorage;
    public bool autoClaim;

    public BrowserConfig() {
        this.userContextId = 0;
        this.startUrl = "";
        this.fingerprint = FingerprintProfile.CleanDefault();
        this.persistentStorage = true;
        this.autoClaim = true;
    }

    public BrowserConfig WithUserContextId(int uci) {
        this.userContextId = uci;
        return this;
    }

    public BrowserConfig WithStartUrl(string url) {
        this.startUrl = url;
        return this;
    }

    public BrowserConfig WithFingerprint(FingerprintProfile fp) {
        this.fingerprint = fp;
        return this;
    }

    public BrowserConfig WithPersistent(bool persist) {
        this.persistentStorage = persist;
        return this;
    }

    /// <summary>
    /// 创建主会话 (默认全局沙箱，共享 Cookie 与登录态)
    /// </summary>
    public static BrowserConfig ForDefault(string url) {
        BrowserConfig c = new BrowserConfig();
        c.userContextId = 0;
        c.startUrl = url;
        c.fingerprint = FingerprintProfile.CleanDefault();
        c.persistentStorage = true;
        return c;
    }

    /// <summary>
    /// 创建独立隔离店铺 (1 行代码装配：独立 Cookie 沙箱 + 独立硬件指纹)
    /// </summary>
    public static BrowserConfig ForStore(int storeId, string countryCode, string url) {
        BrowserConfig c = new BrowserConfig();
        c.userContextId = storeId;
        c.startUrl = url;
        c.fingerprint = FingerprintProfile.PresetStore(storeId, countryCode);
        c.persistentStorage = true;
        return c;
    }
}
