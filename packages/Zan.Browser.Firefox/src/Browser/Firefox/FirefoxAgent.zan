namespace Browser.Firefox;

public delegate bool GeckoInitFn(nint hostHwnd);
public delegate nint GeckoCreateWithContextFn(
    nint parentHwnd, int x, int y, int w, int h,
    string initialUrl, int userContextId,
    string webglVendor, string webglRenderer,
    string timezone, string userAgent);
public delegate void GeckoBoundsFn(nint viewHandle, int x, int y, int w, int h);
public delegate void GeckoVisibleFn(nint viewHandle, bool visible);
public delegate void GeckoNavigateFn(nint viewHandle, string url);
public delegate void GeckoActionFn(nint viewHandle);
public delegate void GeckoVoidFn();
public delegate void GeckoExecuteScriptFn(nint viewHandle, string script, int evalId);
public delegate void GeckoClickElementFn(nint viewHandle, string selector, int evalId);
public delegate void GeckoTypeTextFn(nint viewHandle, string selector, string text, int evalId);
public delegate string GeckoGetStringFn(nint viewHandle);
public delegate bool GeckoGetBoolFn(nint viewHandle);
public delegate int GeckoGetIntFn(nint viewHandle);
public delegate void GeckoSetFingerprintFn(nint viewHandle, string configJson);
public delegate void GeckoClipByIdFn(int viewId, string spec);
public delegate void GeckoClearDataFn(int userContextId);
public delegate nint GeckoCreateViewExFn(
    nint parentHwnd, int x, int y, int w, int h,
    string profileDir, ref GeckoViewConfig config);
public delegate void GeckoDefaultViewConfigFn(ref GeckoViewConfig outConfig);

/// <summary>
/// 语义交互元素 (面向 AI Agent 的压缩结构)
/// </summary>
public class PageElement {
    public string Ref;       // 紧凑索引，如 "e1", "e2"
    public string Tag;       // HTML 标签，如 "button", "input"
    public string Type;      // input 类型，如 "text", "password"
    public string Text;      // 元素文本或 placeholder
    public string Selector;  // CSS 选择器
    public int X;
    public int Y;
    public int W;
    public int H;

    public PageElement() {
        this.Ref = "";
        this.Tag = "";
        this.Type = "";
        this.Text = "";
        this.Selector = "";
        this.X = 0;
        this.Y = 0;
        this.W = 0;
        this.H = 0;
    }
}

/// <summary>
/// 页面视口语义快照 (Token 优化型 DOM 投影)
/// </summary>
public class PageSnapshot {
    public string Title;
    public string Url;
    public List<PageElement> Elements;

    public PageSnapshot() {
        this.Title = "";
        this.Url = "";
        this.Elements = new List<PageElement>();
    }

    public static PageSnapshot FromJson(string json) {
        PageSnapshot snap = new PageSnapshot();
        if (json == null || json.Length == 0) return snap;

        JsonDoc doc = null;
        try {
            doc = JsonDoc.Parse(json);
        } catch (Exception _ex) {
            return snap;
        }
        if (doc == null || doc.root < 0 || doc.KindAt(doc.root) != 5) { return snap; }

        snap.Title = doc.StrAt(doc.Get(doc.root, "title"), "");
        snap.Url = doc.StrAt(doc.Get(doc.root, "url"), "");

        int elems = doc.Get(doc.root, "elements");
        if (elems >= 0 && doc.KindAt(elems) == 4) {
            int count = doc.Count(elems);
            int cur = doc.FirstChild(elems);
            for (int i = 0; i < count && cur >= 0; i = i + 1) {
                if (doc.KindAt(cur) == 5) {
                    PageElement el = new PageElement();
                    el.Ref = doc.StrAt(doc.Get(cur, "ref"), "");
                    el.Tag = doc.StrAt(doc.Get(cur, "tag"), "");
                    el.Type = doc.StrAt(doc.Get(cur, "type"), "");
                    el.Text = doc.StrAt(doc.Get(cur, "text"), "");
                    el.Selector = doc.StrAt(doc.Get(cur, "selector"), "");
                    el.X = doc.IntAt(doc.Get(cur, "x"), 0);
                    el.Y = doc.IntAt(doc.Get(cur, "y"), 0);
                    el.W = doc.IntAt(doc.Get(cur, "w"), 0);
                    el.H = doc.IntAt(doc.Get(cur, "h"), 0);
                    snap.Elements.Add(el);
                }
                cur = doc.NextSibling(cur);
            }
        }
        return snap;
    }
}

/// <summary>
/// 火狐内核动态链接库底层导出直通
/// </summary>
public class GeckoNative {
    #if WINDOWS
    [DllImport("kernel32", EntryPoint = "SetDllDirectoryA")]
    public static extern bool SetDllDirectoryA(string path);
    #endif

    public static nint XulMod = 0;
    public static nint EmbedMod = 0;
    static bool loaded = false;
    private static string loadLock = "Browser.Firefox.GeckoNative.loadLock";

    static bool IsAbsoluteDir(string p) {
        if (p == null || p.Length == 0) { return false; }
        if (p[0] == '/' || p[0] == '\\') { return true; }
        return p.Length >= 2 && p[1] == ':';
    }

    public static nint PfnInit = 0;
    public static nint PfnCreateWithContext = 0;
    public static nint PfnSetBounds = 0;
    public static nint PfnSetVisible = 0;
    public static nint PfnNavigate = 0;
    public static nint PfnDestroy = 0;
    public static nint PfnExecuteScript = 0;
    public static nint PfnClickElement = 0;
    public static nint PfnTypeText = 0;
    public static nint PfnGetTitle = 0;
    public static nint PfnGetUrl = 0;
    public static nint PfnCanGoBack = 0;
    public static nint PfnCanGoForward = 0;
    public static nint PfnGetLastEvalResult = 0;
    public static nint PfnGetLastEvalId = 0;
    public static nint PfnGetLastEvalSuccess = 0;
    public static nint PfnSetFingerprint = 0;
    public static nint PfnShrinkMemory = 0;
    public static nint PfnShutdown = 0;
    public static nint PfnSetClipById = 0;
    public static nint PfnGetViewId = 0;
    public static nint PfnClearOriginData = 0;
    public static nint PfnCreateViewEx = 0;
    public static nint PfnDefaultViewConfig = 0;

    public static bool EnsureLoaded() {
        lock (GeckoNative.loadLock) {
            if (loaded && (XulMod != 0 || EmbedMod != 0)) return true;

            // 仅从显式环境变量或受控系统绝对安装路径查找，拒绝硬编码开发路径与相对路径劫持
            List<string> searchPaths = new List<string>();
            string envDir = Interop.EnvVar("ZAN_GECKO_DIR");
            if (envDir != null && envDir.Length > 0 && IsAbsoluteDir(envDir)) {
                searchPaths.Add(envDir);
            }
            searchPaths.Add("/Applications/Firefox.app/Contents/MacOS");
            searchPaths.Add("/usr/lib/firefox");
            searchPaths.Add("/usr/local/lib");

            string[] embedNames = new string[] {
                "gecko_embed.dll",
                "libgecko_embed.dylib",
                "libgecko_embed.so",
                "gecko_embed"
            };

            string[] xulNames = new string[] {
                "xul.dll",
                "XUL",
                "libxul.dylib",
                "libxul.so",
                "xul"
            };

            // 优先尝试装载高可配置化的跨平台 gecko_embed 动态库 (.dll / .dylib / .so)
            for (int i = 0; i < searchPaths.Count; i = i + 1) {
                string p = searchPaths[i];
                for (int j = 0; j < embedNames.Length; j = j + 1) {
                    string embedPath = Path.Combine(p, embedNames[j]);
                    if (File.Exists(embedPath)) {
                        #if WINDOWS
                        if (IsAbsoluteDir(p)) {
                            SetDllDirectoryA(p);
                            try {
                                EmbedMod = Interop.Load(embedPath);
                            } finally {
                                SetDllDirectoryA(null);
                            }
                        } else {
                            EmbedMod = Interop.Load(embedPath);
                        }
                        #else
                        EmbedMod = Interop.Load(embedPath);
                        #endif
                        if (EmbedMod != 0) {
                            PfnCreateViewEx = Interop.Symbol(EmbedMod, "gecko_create_view_ex");
                            PfnDefaultViewConfig = Interop.Symbol(EmbedMod, "gecko_default_view_config");
                            break;
                        }
                    }
                }
                if (EmbedMod != 0) break;
            }

            // 装载 C-ABI 核心 xul 动态库
            for (int i = 0; i < searchPaths.Count; i = i + 1) {
                string p = searchPaths[i];
                for (int j = 0; j < xulNames.Length; j = j + 1) {
                    string xulPath = Path.Combine(p, xulNames[j]);
                    if (File.Exists(xulPath)) {
                        #if WINDOWS
                        if (IsAbsoluteDir(p)) {
                            SetDllDirectoryA(p);
                            try {
                                XulMod = Interop.Load(xulPath);
                            } finally {
                                SetDllDirectoryA(null);
                            }
                        } else {
                            XulMod = Interop.Load(xulPath);
                        }
                        #else
                        XulMod = Interop.Load(xulPath);
                        #endif
                        if (XulMod != 0) {
                            ResolveSymbols();
                            loaded = true;
                            return true;
                        }
                    }
                }
            }

            for (int j = 0; j < xulNames.Length; j = j + 1) {
                XulMod = Interop.Load(xulNames[j]);
                if (XulMod != 0) {
                    ResolveSymbols();
                    loaded = true;
                    return true;
                }
            }

            loaded = (EmbedMod != 0);
            return loaded;
        }
    }

    static void ResolveSymbols() {
        PfnInit = Interop.Symbol(XulMod, "Gecko_Init");
        PfnCreateWithContext = Interop.Symbol(XulMod, "Gecko_CreateWebViewWithContext");
        PfnSetBounds = Interop.Symbol(XulMod, "Gecko_SetBounds");
        PfnSetVisible = Interop.Symbol(XulMod, "Gecko_SetVisible");
        PfnNavigate = Interop.Symbol(XulMod, "Gecko_Navigate");
        PfnDestroy = Interop.Symbol(XulMod, "Gecko_DestroyWebView");
        PfnExecuteScript = Interop.Symbol(XulMod, "Gecko_ExecuteScript");
        PfnClickElement = Interop.Symbol(XulMod, "Gecko_ClickElement");
        PfnTypeText = Interop.Symbol(XulMod, "Gecko_TypeText");
        PfnGetTitle = Interop.Symbol(XulMod, "Gecko_GetTitle");
        PfnGetUrl = Interop.Symbol(XulMod, "Gecko_GetUrl");
        PfnCanGoBack = Interop.Symbol(XulMod, "Gecko_CanGoBack");
        PfnCanGoForward = Interop.Symbol(XulMod, "Gecko_CanGoForward");
        PfnGetLastEvalResult = Interop.Symbol(XulMod, "Gecko_GetLastEvalResult");
        PfnGetLastEvalId = Interop.Symbol(XulMod, "Gecko_GetLastEvalId");
        PfnGetLastEvalSuccess = Interop.Symbol(XulMod, "Gecko_GetLastEvalSuccess");
        PfnSetFingerprint = Interop.Symbol(XulMod, "Gecko_SetFingerprint");
        PfnShrinkMemory = Interop.Symbol(XulMod, "Gecko_ShrinkMemory");
        PfnShutdown = Interop.Symbol(XulMod, "Gecko_Shutdown");
        PfnSetClipById = Interop.Symbol(XulMod, "Gecko_SetClipById");
        PfnGetViewId = Interop.Symbol(XulMod, "Gecko_GetViewId");
        PfnClearOriginData = Interop.Symbol(XulMod, "Gecko_ClearOriginData");
    }
}

/// <summary>
/// 浏览器智能体标签页句柄：承载现代非阻塞协程异步 API (await Task.Delay) 与完整自动化生态
/// </summary>
public class FirefoxAgentTab : IDisposable {
    nint viewHandle;
    int contextId;
    int nextEvalId;
    bool evalBusy;
    bool disposed;
    int activeNativeCalls;
    Queue<AsyncGate> evalWaiters;

    public FirefoxAgentTab(nint handle, int userContextId) {
        this.viewHandle = handle;
        this.contextId = userContextId;
        this.nextEvalId = 1000;
        this.evalBusy = false;
        this.disposed = false;
        this.activeNativeCalls = 0;
        this.evalWaiters = new Queue<AsyncGate>();
    }

    private nint AcquireNativeHandle() {
        lock (this) {
            if (this.disposed || this.viewHandle == 0) { return 0; }
            this.activeNativeCalls = this.activeNativeCalls + 1;
            return this.viewHandle;
        }
    }

    private void ReleaseNativeHandle() {
        nint toDestroy = 0;
        lock (this) {
            this.activeNativeCalls = this.activeNativeCalls - 1;
            if (this.disposed && this.activeNativeCalls == 0 && this.viewHandle != 0) {
                toDestroy = this.viewHandle;
                this.viewHandle = 0;
            }
        }
        if (toDestroy != 0 && GeckoNative.PfnDestroy != 0) {
            GeckoActionFn fn = (GeckoActionFn)GeckoNative.PfnDestroy;
            fn(toDestroy);
        }
    }

    public void Dispose() {
        nint h = 0;
        List<AsyncGate> pending = null;
        lock (this) {
            this.disposed = true;
            if (this.activeNativeCalls == 0 && this.viewHandle != 0) {
                h = this.viewHandle;
                this.viewHandle = 0;
            }
            this.evalBusy = false;
            if (this.evalWaiters.Count() > 0) {
                pending = new List<AsyncGate>();
                while (this.evalWaiters.Count() > 0) {
                    pending.Add(this.evalWaiters.Dequeue());
                }
            }
        }
        if (pending != null) {
            for (int i = 0; i < pending.Count; i = i + 1) {
                pending[i].Signal();
            }
        }
        if (h != 0 && GeckoNative.PfnDestroy != 0) {
            GeckoActionFn fn = (GeckoActionFn)GeckoNative.PfnDestroy;
            fn(h);
        }
    }

    private async bool AcquireEvalLock() {
        while (true) {
            AsyncGate gate = null;
            lock (this) {
                if (this.disposed || this.viewHandle == 0) { return false; }
                if (!this.evalBusy) {
                    this.evalBusy = true;
                    return true;
                }
                gate = new AsyncGate();
                this.evalWaiters.Enqueue(gate);
            }
            try {
                await gate.Wait();
            } finally {
                gate.Close();
            }
        }
    }

    private void ReleaseEvalLock() {
        AsyncGate next = null;
        lock (this) {
            this.evalBusy = false;
            if (this.evalWaiters.Count() > 0) {
                next = this.evalWaiters.Dequeue();
            }
        }
        if (next != null) { next.Signal(); }
    }

    public nint GetHandle() {
        lock (this) { return this.disposed ? 0 : this.viewHandle; }
    }
    public int GetContextId() { return this.contextId; }

    public int GetViewId() {
        if (GeckoNative.PfnGetViewId == 0) return 0;
        nint h = this.AcquireNativeHandle();
        if (h == 0) return 0;
        try {
            GeckoGetIntFn fn = (GeckoGetIntFn)GeckoNative.PfnGetViewId;
            return fn(h);
        } finally {
            this.ReleaseNativeHandle();
        }
    }

    public void Navigate(string url) {
        if (GeckoNative.PfnNavigate == 0) return;
        nint h = this.AcquireNativeHandle();
        if (h == 0) return;
        try {
            GeckoNavigateFn fn = (GeckoNavigateFn)GeckoNative.PfnNavigate;
            fn(h, url == null ? "" : url);
        } finally {
            this.ReleaseNativeHandle();
        }
    }

    public string Title() {
        if (GeckoNative.PfnGetTitle == 0) return "";
        nint h = this.AcquireNativeHandle();
        if (h == 0) return "";
        try {
            GeckoGetStringFn fn = (GeckoGetStringFn)GeckoNative.PfnGetTitle;
            return fn(h);
        } finally {
            this.ReleaseNativeHandle();
        }
    }

    public string Url() {
        if (GeckoNative.PfnGetUrl == 0) return "";
        nint h = this.AcquireNativeHandle();
        if (h == 0) return "";
        try {
            GeckoGetStringFn fn = (GeckoGetStringFn)GeckoNative.PfnGetUrl;
            return fn(h);
        } finally {
            this.ReleaseNativeHandle();
        }
    }

    public int ExecuteScriptAsync(string script) {
        if (GeckoNative.PfnExecuteScript == 0) return -1;
        nint h = this.AcquireNativeHandle();
        if (h == 0) return -1;
        try {
            int id = 0;
            lock (this) {
                this.nextEvalId = this.nextEvalId + 1;
                id = this.nextEvalId;
            }
            GeckoExecuteScriptFn fn = (GeckoExecuteScriptFn)GeckoNative.PfnExecuteScript;
            fn(h, script == null ? "" : script, id);
            return id;
        } finally {
            this.ReleaseNativeHandle();
        }
    }

    public bool IsDone(int evalId) {
        if (GeckoNative.PfnGetLastEvalId == 0) return false;
        nint h = this.AcquireNativeHandle();
        if (h == 0) return false;
        try {
            GeckoGetIntFn fn = (GeckoGetIntFn)GeckoNative.PfnGetLastEvalId;
            return fn(h) == evalId;
        } finally {
            this.ReleaseNativeHandle();
        }
    }

    public string GetResult() {
        if (GeckoNative.PfnGetLastEvalResult == 0) return "";
        nint h = this.AcquireNativeHandle();
        if (h == 0) return "";
        try {
            GeckoGetStringFn fn = (GeckoGetStringFn)GeckoNative.PfnGetLastEvalResult;
            return fn(h);
        } finally {
            this.ReleaseNativeHandle();
        }
    }

    public bool GetSuccess() {
        if (GeckoNative.PfnGetLastEvalSuccess == 0) return false;
        nint h = this.AcquireNativeHandle();
        if (h == 0) return false;
        try {
            GeckoGetBoolFn fn = (GeckoGetBoolFn)GeckoNative.PfnGetLastEvalSuccess;
            return fn(h);
        } finally {
            this.ReleaseNativeHandle();
        }
    }

    // =========================================================================
    // 现代 Zan 协程异步 API (纯正 await Task.Delay 挂起，绝不阻塞 UI 线程与调度器)
    // =========================================================================

    /// <summary>
    /// 核心异步非阻塞求值 (基于 await Task.Delay 协程挂起，零线程开销，让出事件循环；按标签页串行化防止单槽 lastEvalId 竞态)
    /// </summary>
    public async string EvalAsync(string script, int timeoutMs = 8000) {
        if (!await this.AcquireEvalLock()) { return ""; }
        try {
            int id = this.ExecuteScriptAsync(script);
            if (id < 0) return "";
            long elapsed = 0L;
            long limit = timeoutMs < 0 ? 0L : (long)timeoutMs;
            while (elapsed < limit) {
                if (this.IsDone(id)) {
                    return this.GetResult();
                }
                await Task.Delay(16);
                elapsed = elapsed + 16L;
            }
            return "";
        } finally {
            this.ReleaseEvalLock();
        }
    }

    /// <summary>
    /// 异步获取页面交互快照 (面向 AI Agent 的压缩语义树，Token 节省 90%)
    /// </summary>
    public async PageSnapshot SnapshotAsync(int timeoutMs = 8000) {
        string res = await this.EvalAsync("ZanAgent.snapshot();", timeoutMs);
        return PageSnapshot.FromJson(res);
    }

    /// <summary>
    /// 将任意字符串安全编码为合法的 JS 双引号字符串字面量（防引号/反斜杠/换行/行分隔符注入）
    /// </summary>
    private static string JsQuote(string s) {
        if (s == null) { return "\"\""; }
        StringBuilder sb = new StringBuilder(s.Length + 8);
        sb.Append("\"");
        int n = s.Length;
        int seg = 0;
        for (int i = 0; i < n; i = i + 1) {
            int c = s[i] & 255;
            string esc = null;
            if (c == 34) { esc = "\\\""; }
            else if (c == 92) { esc = "\\\\"; }
            else if (c == 10) { esc = "\\n"; }
            else if (c == 13) { esc = "\\r"; }
            else if (c == 9) { esc = "\\t"; }
            else if (c == 8) { esc = "\\b"; }
            else if (c == 12) { esc = "\\f"; }
            else if (c < 32) {
                string hx = "0123456789abcdef";
                esc = "\\u00" + hx.Substring((c >> 4) & 15, 1) + hx.Substring(c & 15, 1);
            } else if (c == 226 && i + 2 < n && (s[i + 1] & 255) == 128) {
                int b2 = s[i + 2] & 255;
                if (b2 == 168 || b2 == 169) {
                    if (i > seg) { sb.Append(s.Substring(seg, i - seg)); }
                    sb.Append(b2 == 168 ? "\\u2028" : "\\u2029");
                    i = i + 2;
                    seg = i + 1;
                    continue;
                }
            }
            if (esc != null) {
                if (i > seg) { sb.Append(s.Substring(seg, i - seg)); }
                sb.Append(esc);
                seg = i + 1;
            }
        }
        if (n > seg) { sb.Append(s.Substring(seg, n - seg)); }
        sb.Append("\"");
        return sb.ToString();
    }

    /// <summary>
    /// 异步智能拟人点击 (三次贝塞尔轨迹 + 菲茨定律加减速 + 悬停 + 物理按压时长 + 遮挡探测)
    /// </summary>
    public async bool ClickAsync(string refOrSel, int timeoutMs = 8000) {
        string script = "ZanAgent.click(" + JsQuote(refOrSel) + ");";
        string res = await this.EvalAsync(script, timeoutMs);
        return res == "true" || res == "ok";
    }

    /// <summary>
    /// 异步智能表单直填 (穿透 React/Vue 双向绑定 Setter 并派发完整 InputEvent)
    /// </summary>
    public async bool FillAsync(string refOrSel, string text, int timeoutMs = 8000) {
        string script = "ZanAgent.fill(" + JsQuote(refOrSel) + ", " + JsQuote(text) + ");";
        string res = await this.EvalAsync(script, timeoutMs);
        return res == "true" || res == "ok";
    }

    /// <summary>
    /// 异步拟人逐字敲击 (模拟人类击键时序与高斯分布节奏抖动，突破前端击键生物识别)
    /// </summary>
    public async bool TypeAsync(string refOrSel, string text, int timeoutMs = 12000) {
        string script = "ZanAgent.type(" + JsQuote(refOrSel) + ", " + JsQuote(text) + ");";
        string res = await this.EvalAsync(script, timeoutMs);
        return res == "true" || res == "ok";
    }

    /// <summary>
    /// 异步平滑鼠标移动 (三次贝塞尔曲线 + 菲茨加减速 + 生理微震颤)
    /// </summary>
    public async bool MouseMoveAsync(string target, int timeoutMs = 8000) {
        string script = "ZanAgent.mouseMove(" + JsQuote(target) + ");";
        string res = await this.EvalAsync(script, timeoutMs);
        return res == "true" || res == "ok";
    }

    /// <summary>
    /// 异步滑块验证码拖拽 (非匀速物理加速+减速+微波浪 Y 轴微动)
    /// </summary>
    public async bool DragAsync(string target, int offsetX, int offsetY = 0, int timeoutMs = 8000) {
        string script = "ZanAgent.drag(" + JsQuote(target) + ", " + offsetX.ToString() + ", " + offsetY.ToString() + ");";
        string res = await this.EvalAsync(script, timeoutMs);
        return res == "true" || res == "ok";
    }

    /// <summary>
    /// 异步抗网页改版选项匹配 (Picker-Rank 7级平滑阶梯，支持原生与现代化框架自定义 Select)
    /// </summary>
    public async string SelectOptionAsync(string target, string wanted, int timeoutMs = 8000) {
        string script = "ZanAgent.selectOption(" + JsQuote(target) + ", " + JsQuote(wanted) + ");";
        return await this.EvalAsync(script, timeoutMs);
    }

    /// <summary>
    /// 异步真实可见文本提取 (过滤 -9999px / clip 等防爬虫蜜罐文本陷阱)
    /// </summary>
    public async string VisibleTextAsync(string target, int timeoutMs = 8000) {
        string script = "ZanAgent.visibleText(" + JsQuote(target) + ");";
        return await this.EvalAsync(script, timeoutMs);
    }

    /// <summary>
    /// 异步多行结构化批量采集 (一次性抽取多行数据为 JSON，0 次多余 IPC 开销)
    /// </summary>
    public async string ReadRowsAsync(string rowSelector, string fieldMapJson, int limit = 100, int timeoutMs = 10000) {
        string safeMap = (fieldMapJson != null && fieldMapJson.Length > 0) ? fieldMapJson : "{}";
        string script = "ZanAgent.readRows(" + JsQuote(rowSelector) + ", JSON.parse(" + JsQuote(safeMap) + "), { limit: " + limit.ToString() + " });";
        return await this.EvalAsync(script, timeoutMs);
    }

    /// <summary>
    /// 异步结果驱动全分支竞速等待状态机 (成功/报错/消失/跳转全分支竞速，抛弃低效 Sleep)
    /// </summary>
    public async string WaitForOutcomeAsync(string success = "", string error = "", string gone = "", string url = "", int timeoutMs = 10000) {
        int safeTimeout = timeoutMs < 0 ? 0 : timeoutMs;
        StringBuilder sb = new StringBuilder();
        sb.Append("ZanAgent.waitForOutcome({");
        bool hasField = false;
        if (success != null && success != "") { sb.Append(" success: "); sb.Append(JsQuote(success)); hasField = true; }
        if (error != null && error != "") { if (hasField) { sb.Append(","); } sb.Append(" error: "); sb.Append(JsQuote(error)); hasField = true; }
        if (gone != null && gone != "") { if (hasField) { sb.Append(","); } sb.Append(" gone: "); sb.Append(JsQuote(gone)); hasField = true; }
        if (url != null && url != "") { if (hasField) { sb.Append(","); } sb.Append(" url: "); sb.Append(JsQuote(url)); hasField = true; }
        if (hasField) { sb.Append(","); }
        sb.Append(" timeoutMs: ");
        sb.Append(safeTimeout.ToString());
        sb.Append(" });");
        long evalTimeout = (long)safeTimeout + 1000L;
        int clamped = evalTimeout > 2147483647L ? 2147483647 : (int)evalTimeout;
        return await this.EvalAsync(sb.ToString(), clamped);
    }

    /// <summary>
    /// 异步平滑页面滚动
    /// </summary>
    public async bool ScrollAsync(int dy, int timeoutMs = 5000) {
        string script = "ZanAgent.scroll(" + dy.ToString() + ");";
        string res = await this.EvalAsync(script, timeoutMs);
        return res == "true" || res == "ok";
    }

    /// <summary>
    /// 异步注入内存级网络 Mock 响应 (借鉴 ruyiJS put_resource: 离线注入响应、解密脱壳或替换验证码图片)
    /// </summary>
    public async bool MockResourceAsync(string urlPattern, string responseBody, string contentType = "application/json", int timeoutMs = 5000) {
        string script = "ZanAgent.mockResource(" + JsQuote(urlPattern) + ", " + JsQuote(responseBody) + ", " + JsQuote(contentType) + ");";
        string res = await this.EvalAsync(script, timeoutMs);
        return res == "true" || res == "ok";
    }

    /// <summary>
    /// 异步清除所有内存级网络 Mock 拦截
    /// </summary>
    public async bool ClearMocksAsync(int timeoutMs = 5000) {
        string res = await this.EvalAsync("ZanAgent.clearMocks();", timeoutMs);
        return res == "true" || res == "ok";
    }

    /// <summary>
    /// 异步网络空闲等待状态机 (基于 Necko / Fetch / XHR inFlight 活跃计数器)
    /// </summary>
    public async bool WaitForNetworkIdleAsync(int requiredIdleMs = 500, int timeoutMs = 15000) {
        if (timeoutMs <= 0) { return false; }
        long deadline = DateTime.GetCurrentUnixMilliseconds() + (long)timeoutMs;
        while (true) {
            long rem = deadline - DateTime.GetCurrentUnixMilliseconds();
            if (rem <= 0L) { break; }
            int stepTimeout = rem > 1000L ? 1000 : (int)rem;
            string script = "window.__zan_getNetworkIdleState ? window.__zan_getNetworkIdleState(" + requiredIdleMs.ToString() + ") : '{\"isIdle\":true}';";
            string res = await this.EvalAsync(script, stepTimeout);
            if (res.Contains("\"isIdle\":true") || res.Contains("\"isIdle\": true")) {
                return true;
            }
            long rem2 = deadline - DateTime.GetCurrentUnixMilliseconds();
            if (rem2 <= 0L) { break; }
            await Task.Delay(rem2 > 100L ? 100 : (int)rem2);
        }
        return false;
    }

    /// <summary>
    /// 异步虚拟文件注入 (DataTransfer API 突破操作系统文件对话框阻塞)
    /// </summary>
    public async bool SetInputFilesAsync(string selector, string fileNamesOrJson, int timeoutMs = 5000) {
        string script = "window.__zan_setInputFiles ? window.__zan_setInputFiles(" + JsQuote(selector) + ", [{ name: " + JsQuote(fileNamesOrJson) + ", content: 'SIMULATED_FILE_PAYLOAD' }]) : false;";
        string res = await this.EvalAsync(script, timeoutMs);
        return res == "true" || res == "ok";
    }

    /// <summary>
    /// 异步配置模态弹窗策略 (Alert / Confirm / Prompt 绝不阻塞主线程)
    /// </summary>
    public async bool ConfigureDialogPolicyAsync(bool autoAccept, string promptDefault = "", int timeoutMs = 2000) {
        string script = "window.__zan_dialogConfig = { autoAccept: " + (autoAccept ? "true" : "false") + ", promptDefault: " + JsQuote(promptDefault) + " }; true;";
        string res = await this.EvalAsync(script, timeoutMs);
        return res == "true" || res == "ok";
    }

    /// <summary>
    /// 核心异步内核请求代行 (Path A 原生代行模式：免 CORS/免证书校验/继承原生 Session 与 CookieJar)
    /// </summary>
    public async string KernelFetchAsync(string url, string method = "GET", string headersJson = "{}", string bodyJson = "null", int timeoutMs = 15000) {
        string safeMethod = (method != null && method != "") ? method.ToUpper() : "GET";
        string safeHeaders = (headersJson != null && headersJson != "") ? headersJson : "{}";
        string safeBody = (bodyJson != null && bodyJson != "" && safeMethod != "GET" && safeMethod != "HEAD")
            ? bodyJson
            : "null";

        string script = "(function() { " +
            "return ZanKernel.fetch(" + JsQuote(url) + ", { " +
            "method: " + JsQuote(safeMethod) + ", " +
            "headers: JSON.parse(" + JsQuote(safeHeaders) + "), " +
            "body: JSON.parse(" + JsQuote(safeBody) + ") " +
            "}); })()";

        return await this.EvalAsync(script, timeoutMs);
    }

    public void ClearData() {
        if (this.contextId > 0 && GeckoNative.PfnClearOriginData != 0) {
            GeckoClearDataFn fn = (GeckoClearDataFn)GeckoNative.PfnClearOriginData;
            fn(this.contextId);
        }
    }
}

/// <summary>
/// 浏览器智能体会话工厂
/// </summary>
public class FirefoxAgentSession {
    public static bool Initialize(nint hostHwnd) {
        return FirefoxBootstrap.Init(hostHwnd);
    }

    public static void Shutdown() {
        if (GeckoNative.PfnShutdown != 0) {
            GeckoVoidFn fn = (GeckoVoidFn)GeckoNative.PfnShutdown;
            fn();
        }
    }

    public static FirefoxAgentTab CreateTab(nint parentHwnd, int x, int y, int w, int h, string initialUrl, int contextId, FingerprintProfile profile) {
        if (!GeckoNative.EnsureLoaded()) return null;
        if (GeckoNative.PfnCreateWithContext == 0) return null;

        FingerprintProfile fp = (profile != null) ? profile : FingerprintProfile.CleanDefault();

        GeckoCreateWithContextFn fn = (GeckoCreateWithContextFn)GeckoNative.PfnCreateWithContext;
        nint handle = fn(
            parentHwnd, x, y, w, h, initialUrl, contextId,
            fp.webglVendor, fp.webglRenderer, fp.timezone, fp.userAgent
        );

        if (handle == 0) return null;

        if (GeckoNative.PfnSetFingerprint != 0) {
            GeckoSetFingerprintFn fpFn = (GeckoSetFingerprintFn)GeckoNative.PfnSetFingerprint;
            fpFn(handle, fp.ToJson());
        }

        return new FirefoxAgentTab(handle, contextId);
    }

    /// <summary>
    /// 基于高级全维度配置创建智能体标签页 (支持动态无头、图片屏蔽、WebRTC隔离、性能限帧与内存限额)
    /// </summary>
    public static FirefoxAgentTab CreateTabEx(nint parentHwnd, int x, int y, int w, int h, string profileDir, GeckoViewConfig config) {
        if (!GeckoNative.EnsureLoaded()) return null;

        if (GeckoNative.PfnCreateViewEx != 0) {
            GeckoCreateViewExFn fn = (GeckoCreateViewExFn)GeckoNative.PfnCreateViewEx;
            nint handle = fn(parentHwnd, x, y, w, h, profileDir, ref config);
            if (handle == 0) return null;
            return new FirefoxAgentTab(handle, 0);
        }

        return null;
    }
}
