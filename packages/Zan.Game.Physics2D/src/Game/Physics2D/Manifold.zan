using System;
using System.Collections.Generic;

namespace Game.Physics2D;

// 接触点：窄相算出的一个碰撞点 + 求解器在它上面累积的状态。
//
// 求解状态放在**类**里而不是结构体里：List<T> 取元素是副本，改副本的
// 字段不会写回列表（结构体按值语义），累积冲量必须能原地改。
public class ContactPoint {
    // 接触点世界坐标。
    public Vec2 position;
    // 分离量：负值表示已侵入，正值表示还差这么多才碰上。
    public double separation;
    // 相对 A / B 质心的力臂。
    public Vec2 r1;
    public Vec2 r2;
    // 沿法线 / 切线方向的有效质量倒数。
    public double normalMass;
    public double tangentMass;
    // 本步累积的法线 / 切线冲量（热启动复用）。
    public double normalImpulse;
    public double tangentImpulse;
    // 分离冲量阶段累积的伪冲量。
    public double positionImpulse;
    // 目标法线速度（弹性反弹或推测接触的接近上限）。
    public double velocityBias;

    public ContactPoint() {
        this.position = new Vec2(0.0, 0.0);
        this.separation = 0.0;
        this.r1 = new Vec2(0.0, 0.0);
        this.r2 = new Vec2(0.0, 0.0);
        this.normalMass = 0.0;
        this.tangentMass = 0.0;
        this.normalImpulse = 0.0;
        this.tangentImpulse = 0.0;
        this.positionImpulse = 0.0;
        this.velocityBias = 0.0;
    }
}

// 接触流形：一次窄相检测的结果。
//
// normal 永远从 A 指向 B；separation 是"还要靠近多少才接触"，负值表示
// 已经侵入。pointCount 最多 2（面-面接触），点-面接触只有 1 个。
public class Manifold {
    // 单位法线（A → B）。
    public Vec2 normal;
    // 接触点个数。
    public int pointCount;
    // 接触点列表（长度 = pointCount）。
    public List<ContactPoint> points;

    public Manifold() {
        this.normal = new Vec2(0.0, 0.0);
        this.pointCount = 0;
        this.points = new List<ContactPoint>();
    }

    // 清空成"无接触"状态。
    public void Clear() {
        this.normal = new Vec2(0.0, 0.0);
        this.pointCount = 0;
        this.points.Clear();
    }

    // 追加一个接触点并返回它（求解器要往里写状态）。
    public ContactPoint AddPoint(Vec2 position, double separation) {
        ContactPoint point = new ContactPoint();
        point.position = position;
        point.separation = separation;
        this.points.Add(point);
        this.pointCount = this.points.Count;
        return point;
    }
}
