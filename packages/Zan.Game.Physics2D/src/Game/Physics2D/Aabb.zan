using System;

namespace Game.Physics2D;

// 轴对齐包围盒（值语义）：粗筛用的最小矩形。
//
// 旋转体（多边形）的 AABB 随角度变化，每帧重算——粗筛只是过滤，
// 真正的相交判定由窄相（SAT）负责。
public struct Aabb {
    public double minX;
    public double minY;
    public double maxX;
    public double maxY;

    public Aabb(double minX, double minY, double maxX, double maxY) {
        this.minX = minX;
        this.minY = minY;
        this.maxX = maxX;
        this.maxY = maxY;
    }

    // 以 center 为心、radius 为半径的正方包围盒。
    public static Aabb FromCenter(Vec2 center, double radius) {
        return new Aabb(
            center.x - radius,
            center.y - radius,
            center.x + radius,
            center.y + radius
        );
    }

    // 是否与另一个盒子相交（含边界接触）。
    public bool Overlaps(Aabb other) {
        if (other.minX > this.maxX) { return false; }
        if (other.maxX < this.minX) { return false; }
        if (other.minY > this.maxY) { return false; }
        if (other.maxY < this.minY) { return false; }
        return true;
    }

    // 是否包含一点（含边界）。
    public bool Contains(Vec2 point) {
        return point.x >= this.minX && point.x <= this.maxX
            && point.y >= this.minY && point.y <= this.maxY;
    }

    // 盒子中心。
    public Vec2 Center() {
        return new Vec2((this.minX + this.maxX) * 0.5, (this.minY + this.maxY) * 0.5);
    }

    // 周长（扫掠剪枝排序时用来比较"谁的区间先结束"）。
    public double Perimeter() {
        return 2.0 * ((this.maxX - this.minX) + (this.maxY - this.minY));
    }

    // 就地向外扩张 margin。
    public void Expand(double margin) {
        this.minX = this.minX - margin;
        this.minY = this.minY - margin;
        this.maxX = this.maxX + margin;
        this.maxY = this.maxY + margin;
    }
}
