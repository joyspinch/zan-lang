using System;

namespace Game.Cards;

// 牌型规则集：哪些点数算牌、顺子/连对怎么连、炸弹几张、王炸是哪两个。
//
// 默认值是中式斗地主（54 张牌，3~A 可连顺，2 与王不进顺子，4 张同点
// 是炸弹，大小王是王炸）。别的玩法（跑得快、十三水变体……）按需改
// 规则集即可，不必改包里的识别逻辑。
public class ComboRuleSet {
    // 点数空间大小：点数取值为 0..RankCount()-1。
    public int rankCount;
    // 顺子最短张数。
    public int straightMin;
    // 顺子最长张数。
    public int straightMax;
    // 顺子允许的最小点数。
    public int straightLow;
    // 顺子允许的最大点数（比它大的点数——2、王——不能进顺子）。
    public int straightHigh;
    // 连对最少对数。
    public int pairStraightMin;
    // 炸弹同点张数。
    public int bombSize;
    // 王炸里较小的那个王（点数）。
    public int rocketLow;
    // 王炸里较大的那个王（点数）。
    public int rocketHigh;

    // 构造默认规则集（中式斗地主）。
    public ComboRuleSet() {
        this.rankCount = 18;
        this.straightMin = 5;
        this.straightMax = 12;
        this.straightLow = 3;
        this.straightHigh = 14;
        this.pairStraightMin = 3;
        this.bombSize = 4;
        this.rocketLow = 16;
        this.rocketHigh = 17;
    }

    // 默认规则集（斗地主口径）。
    public static ComboRuleSet Default() {
        return new ComboRuleSet();
    }

    // 点数空间大小。
    public int RankCount() { return this.rankCount; }
    // 顺子最短张数。
    public int StraightMin() { return this.straightMin; }
    // 顺子最长张数。
    public int StraightMax() { return this.straightMax; }
    // 顺子允许的最小点数。
    public int StraightLow() { return this.straightLow; }
    // 顺子允许的最大点数。
    public int StraightHigh() { return this.straightHigh; }
    // 连对最少对数。
    public int PairStraightMin() { return this.pairStraightMin; }
    // 炸弹同点张数。
    public int BombSize() { return this.bombSize; }
    // 王炸里较小的王。
    public int RocketLow() { return this.rocketLow; }
    // 王炸里较大的王。
    public int RocketHigh() { return this.rocketHigh; }

    // 设置点数空间大小并返回自身（链式）。
    public ComboRuleSet WithRankCount(int value) {
        this.rankCount = value;
        return this;
    }
    // 设置顺子长度范围并返回自身（链式）。
    public ComboRuleSet WithStraight(int min, int max) {
        this.straightMin = min;
        this.straightMax = max;
        return this;
    }
    // 设置顺子点数范围并返回自身（链式）。
    public ComboRuleSet WithStraightRanks(int low, int high) {
        this.straightLow = low;
        this.straightHigh = high;
        return this;
    }
    // 设置连对最少对数并返回自身（链式）。
    public ComboRuleSet WithPairStraightMin(int value) {
        this.pairStraightMin = value;
        return this;
    }
    // 设置炸弹张数并返回自身（链式）。
    public ComboRuleSet WithBombSize(int value) {
        this.bombSize = value;
        return this;
    }
    // 设置王炸的两个王并返回自身（链式）。
    public ComboRuleSet WithRocket(int low, int high) {
        this.rocketLow = low;
        this.rocketHigh = high;
        return this;
    }
}
