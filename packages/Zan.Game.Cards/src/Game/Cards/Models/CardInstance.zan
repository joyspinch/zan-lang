using System;
using Game.Foundation;

namespace Game.Cards;

// 卡牌实例：一次具体掉落/获得的卡，引用共享的 CardDefinition
// 并携带独立状态（实例 id、升级等级、保留标记）。instanceId
// 全局递增且不复用。
public class CardInstance {
    public int instanceId;
    public CardDefinition definition;
    public int upgrade;
    public bool retained;

    // 构造实例：instanceId 由牌堆分配（从 1 递增），definition 为共享模板；升级等级 0、保留标记 false。
    public CardInstance(int instanceId, CardDefinition definition) {
        this.instanceId = instanceId;
        this.definition = definition;
        this.upgrade = 0;
        this.retained = false;
    }

    // 实例唯一 id（牌堆内递增分配，不复用）。
    public int InstanceId() { return this.instanceId; }
    // 共享的卡牌定义模板。
    public CardDefinition Definition() { return this.definition; }
    // 升级等级，0 表示未升级。
    public int Upgrade() { return this.upgrade; }
    // 保留标记：为 true 时回合结束弃牌阶段不弃此牌。
    public bool Retained() { return this.retained; }
    // 设置升级等级（无钳制）。
    public void SetUpgrade(int upgrade) { this.upgrade = upgrade; }
    // 设置保留标记。
    public void SetRetained(bool retained) { this.retained = retained; }
}
