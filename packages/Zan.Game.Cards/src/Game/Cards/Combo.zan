using System;
using System.Collections.Generic;

namespace Game.Cards;

// 一手牌的牌型实例：识别结果 + 可比较的主键。
//
// 设计口径：Combo 只描述"这手牌是什么"，不含具体花色与实例 id。
// 牌的具体归属（哪张牌、什么花色）由游戏自己按 ranks 反查——
// 包只保证牌型语义正确，不接管牌库。
public class Combo {
    // 牌型（ComboType.*）。
    public int type;
    // 主键点数：同牌型比大小时用它（顺子/连对取最大的那个点数）。
    public int key;
    // 长度：顺子/连对的长度（张数 / 对数），其余牌型为 0。
    public int length;
    // 参与的点数（升序，长度 = 牌张数）。
    public List<int> ranks;

    // 构造牌型实例。ranks 为空时按空表处理。
    public Combo(int type, int key, int length, List<int> ranks) {
        this.type = type;
        this.key = key;
        this.length = length;
        this.ranks = new List<int>();
        if (ranks != null) {
            for (int i = 0; i < ranks.Count; i = i + 1) { this.ranks.Add(ranks[i]); }
        }
    }

    // 构造指定牌型的空实例（None 牌型）。
    public static Combo None() {
        return new Combo(ComboType.None(), 0, 0, new List<int>());
    }

    // 构造牌型实例（工厂方法，语义比多参构造清楚）。
    public static Combo Of(int type, int key, int length, List<int> ranks) {
        return new Combo(type, key, length, ranks);
    }

    // 是否为无效牌型。
    public bool IsNone() { return this.type == ComboType.None(); }

    // 牌型标识。
    public int Type() { return this.type; }
    // 主键点数。
    public int Key() { return this.key; }
    // 顺子/连对长度，其余为 0。
    public int Length() { return this.length; }
    // 参与的点数（升序）。
    public List<int> Ranks() { return this.ranks; }
    // 牌张数。
    public int Count() { return this.ranks.Count; }

    // 可读描述（UI 与日志用）：如 "顺子 3-7"、"三带一 K"。
    public string Describe() {
        if (this.IsNone()) { return "无"; }
        if (this.type == ComboType.Straight() || this.type == ComboType.PairStraight()) {
            int lo = this.ranks[0];
            int hi = this.ranks[this.ranks.Count - 1];
            return ComboType.Name(this.type) + " " + Convert.ToString(lo) + "-" + Convert.ToString(hi);
        }
        if (this.type == ComboType.Rocket()) { return ComboType.Name(this.type); }
        return ComboType.Name(this.type) + " " + Convert.ToString(this.key);
    }
}
