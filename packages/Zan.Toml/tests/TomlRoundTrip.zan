using System;
using System.Test;
using System.Toml;

// Zan.Toml 包的无头测试：解析类型还原、表/数组/嵌套、ToToml 往返。
class TomlRoundTripTests {
    static JsonValue Need(JsonValue v, string key) {
        JsonValue x = v.Get(key);
        if (x == null) { throw new Exception("missing key: " + key); }
        return x;
    }

    static JsonValue NeedAt(JsonValue v, int i) {
        JsonValue x = v.At(i);
        if (x == null) { throw new Exception("missing index: " + Convert.ToString(i)); }
        return x;
    }

    static void Main() {
        const string src = "title = \"demo\"\n"
            + "count = 42\n"
            + "ratio = 1.5\n"
            + "ok = true\n"
            + "off = false\n"
            + "memo = \"\"\n"
            + "tags = [\"a\", \"b\"]\n"
            + "\n"
            + "[owner]\n"
            + "name = \"张三\"\n";

        Test.Group("parse");
        Test.Run("scalars", () => {
            JsonValue v = Toml.Parse(src);
            Assert.True(v.IsObject(), "root-object");
            Assert.Equal("demo", Need(v, "title").strVal, "title");
            Assert.True(Need(v, "count").IsInt(), "count-is-int");
            Assert.Equal(42L, Need(v, "count").numI, "count");
            Assert.Nearly(1.5, Need(v, "ratio").numD, 0.000001, "ratio");
            Assert.Equal(true, Need(v, "ok").boolVal, "ok");
            Assert.Equal(false, Need(v, "off").boolVal, "off");
            Assert.Equal("", Need(v, "memo").strVal, "memo-empty");
        });

        Test.Run("array-and-table", () => {
            JsonValue v = Toml.Parse(src);
            JsonValue tags = Need(v, "tags");
            Assert.True(tags.IsArray(), "tags-array");
            Assert.Equal(2, tags.Count(), "tags-len");
            Assert.Equal("a", NeedAt(tags, 0).strVal, "tag0");
            Assert.Equal("b", NeedAt(tags, 1).strVal, "tag1");
            JsonValue owner = Need(v, "owner");
            Assert.True(owner.IsObject(), "owner-object");
            Assert.Equal("张三", Need(owner, "name").strVal, "owner-name");
        });

        Test.Run("missing-key", () => {
            JsonValue v = Toml.Parse(src);
            Assert.False(v.Has("nope"), "has-missing");
        });

        Test.Group("totoml");
        Test.Run("string-roundtrip", () => {
            JsonValue v = Toml.Parse(src);
            string text = Toml.ToToml(v);
            JsonValue back = Toml.Parse(text);
            Assert.Equal("demo", Need(back, "title").strVal, "title-back");
            Assert.Equal(42L, Need(back, "count").numI, "count-back");
            Assert.Nearly(1.5, Need(back, "ratio").numD, 0.000001, "ratio-back");
            Assert.Equal(true, Need(back, "ok").boolVal, "ok-back");
            Assert.Equal("张三", Need(Need(back, "owner"), "name").strVal, "owner-back");
        });

        Test.Run("value-shapes-preserved", () => {
            JsonValue v = Toml.Parse(src);
            JsonValue back = Toml.Parse(Toml.ToToml(v));
            Assert.True(Need(back, "count").IsInt(), "count-stays-int");
            Assert.True(Need(back, "tags").IsArray(), "tags-stays-array");
            Assert.True(Need(back, "owner").IsObject(), "owner-stays-object");
        });

        Test.Finish();
    }
}
