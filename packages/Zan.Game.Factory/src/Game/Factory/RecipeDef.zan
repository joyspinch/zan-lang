using System;

namespace Game.Factory;

public class RecipeDef {
    string name;
    BlockKind machine;
    int tech;
    Stock input;
    int output;
    int quantity;
    int ticks;
    int water;
    int oil;
    RecipeDef(string title, BlockKind block, int unlock, int a, int an, int b, int bn, int result, int n, int duration, int waterCost, int oilCost) {
        name = title; machine = block; tech = unlock; input = new Stock();
        input.Add(a, an); input.Add(b, bn); output = result; quantity = n;
        ticks = duration; water = waterCost; oil = oilCost;
    }
}
