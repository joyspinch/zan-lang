using System;

namespace Game.Factory;

public class RecipeDef {
    public string name;
    public BlockKind machine;
    public int tech;
    public Stock input;
    public int output;
    public int quantity;
    public int ticks;
    public int water;
    public int oil;
    public RecipeDef(string title, BlockKind block, int unlock, int a, int an, int b, int bn, int result, int n, int duration, int waterCost, int oilCost) {
        name = title; machine = block; tech = unlock; input = new Stock();
        input.Add(a, an); input.Add(b, bn); output = result; quantity = n;
        ticks = duration; water = waterCost; oil = oilCost;
    }
}
