using System;

namespace Game.Factory;

public class ForgeBuilding {
    public BlockKind kind;
    public int direction;
    public int hp;
    public int progress;
    public int recipe;
    public int cooldown;
    public int energy;
    public int water;
    public int oil;
    public int efficiency;
    public int network;
    public int roundRobin;
    public int targetMode;
    public int fuelTicks;
    public int mergeCursor;
    public int feedCursor;
    public int lastRecipe;
    // 力场护盾的当前屏障值（仅 Shield 建筑；上限为盾墙耐久的 3 倍，见 ForgeCombat）。
    public int shield;
    public Stock stock;
    public int[] cargo;
    public int[] travel;
    public int[] received;
    public ForgeBuilding() {
        stock = new Stock(); cargo = new int[4]; travel = new int[4]; received = new int[4]; Reset();
    }
    public void Reset() {
        kind = BlockKind.Empty; direction = 0; hp = 0; progress = 0; recipe = 0;
        cooldown = 0; energy = 0; water = 0; oil = 0; efficiency = 0; network = -1;
        roundRobin = 0; targetMode = 0; fuelTicks = 0; mergeCursor = 0; feedCursor = 0;
        lastRecipe = 0; shield = 0; stock.Clear();
        for (int i = 0; i < 4; i = i + 1) { cargo[i] = 0; travel[i] = 0; received[i] = -1; }
    }
}
