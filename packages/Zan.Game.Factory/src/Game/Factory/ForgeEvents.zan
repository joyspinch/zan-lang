using System;

namespace Game.Factory;

public class ForgeEvents {
    public ForgeEvent[] entries;
    public int sequence;
    public ForgeEvents() {
        entries = new ForgeEvent[64]; sequence = 0;
        for (int i = 0; i < 64; i = i + 1) { entries[i] = new ForgeEvent(); }
    }
    public void Emit(ForgeEventKind kind, int cell, int value, int tick) {
        int idx = sequence & 63;
        ForgeEvent e = entries[idx];
        e.kind = kind; e.cell = cell; e.value = value; e.tick = tick;
        sequence = sequence >= 999999936 ? 0 : sequence + 1;
    }
}
