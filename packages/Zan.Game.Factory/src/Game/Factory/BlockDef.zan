using System;

namespace Game.Factory;

public class BlockDef {
    public BlockKind kind;
    public string name;
    public string help;
    public int hp;
    public int tech;
    public int powerUse;
    public int powerRadius;
    public int capacity;
    public Stock cost;
    public BlockDef(BlockKind k, string title, string description, int health, int unlock, int draw, int radius, int copper, int lead, int steel, int titanium) {
        kind = k; name = title; help = description; hp = health; tech = unlock;
        powerUse = draw; powerRadius = radius; capacity = 24;
        cost = new Stock(); cost.Add(0, copper); cost.Add(1, lead); cost.Add(4, steel); cost.Add(5, titanium);
    }
}
