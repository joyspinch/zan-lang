using System;

namespace Game.Factory;

public class EnemyDef {
    public string name;
    public int hp;
    public int speed;
    public int damage;
    public int cooldown;
    public int reward;
    public EnemyDef(string title, int health, int movement, int attack, int interval, int bounty) {
        name = title; hp = health; speed = movement; damage = attack; cooldown = interval; reward = bounty;
    }
}
