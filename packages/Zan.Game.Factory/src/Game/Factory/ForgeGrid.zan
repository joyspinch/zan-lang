using System;

namespace Game.Factory;

public class ForgeGrid {
    static int TileSize() { return 32; }
    static int Unit() { return 1000; }
    static int Dx(int direction) { if (direction == 0) { return 1; } if (direction == 2) { return -1; } return 0; }
    static int Dy(int direction) { if (direction == 1) { return 1; } if (direction == 3) { return -1; } return 0; }
    static int WorldToCell(int world) { return world < 0 ? -1 : world / 1000; }
    static int Center(int cell) { return cell * 1000 + 500; }
    static int Max(int a, int b) { return a > b ? a : b; }
    static int Min(int a, int b) { return a < b ? a : b; }
    static int Abs(int v) { return v < 0 ? -v : v; }
    static int Clamp(int v, int lo, int hi) { if (v < lo) { return lo; } if (v > hi) { return hi; } return v; }
    static int DroneLimit() { return 24; }
}
