using System;

namespace Game.Factory;

public class ForgeCatalog {
    BlockDef[] blocks;
    RecipeDef[] recipes;
    TechDef[] techs;
    EnemyDef[] enemies;
    WaveDef[] waves;
    string[] items;
    ForgeCatalog() {
        items = new string[6];
        items[0] = "铜"; items[1] = "铅"; items[2] = "石墨";
        items[3] = "硅"; items[4] = "钢"; items[5] = "钛";
        blocks = new BlockDef[23];
        blocks[0] = new BlockDef(BlockKind.Empty, "选择", "点击建筑查看运行状态。", 0, 0, 0, 0, 0, 0, 0, 0);
        blocks[1] = new BlockDef(BlockKind.Core, "炉心", "储存输送来的物品；保护它并研究扩张。", 2400, 0, 0, 4, 0, 0, 0, 0);
        blocks[2] = new BlockDef(BlockKind.Drill, "矿脉钻头", "建在矿脉上，沿箭头输出矿石；无电也能低速运转。", 180, 0, 4, 3, 12, 0, 0, 0);
        blocks[3] = new BlockDef(BlockKind.Belt, "传送带", "每格四个物品位；朝向决定输出，相邻支路可合流。", 80, 0, 0, 0, 1, 0, 0, 0);
        blocks[4] = new BlockDef(BlockKind.Router, "分流器", "在可接收的三个出口间轮流分配，堵塞时自动换路。", 130, 0, 0, 0, 5, 2, 0, 0);
        blocks[5] = new BlockDef(BlockKind.Furnace, "电弧熔炉", "消耗电力：铜铅合成钢，石墨和铜合成硅。", 220, 1, 12, 3, 22, 12, 0, 0);
        blocks[6] = new BlockDef(BlockKind.Assembler, "晶格装配机", "水冷钢硅结晶制钛；石油裂解制石墨。", 240, 2, 20, 3, 30, 20, 12, 0);
        blocks[7] = new BlockDef(BlockKind.Generator, "热差发电机", "基础产能 32；每次耗 1 石墨与水可提高到 64。", 240, 0, 0, 4, 18, 8, 0, 0);
        blocks[8] = new BlockDef(BlockKind.Battery, "蓄电池", "存储电网余能，在供不应求时自动补充。", 200, 1, 0, 4, 12, 22, 0, 0);
        blocks[9] = new BlockDef(BlockKind.Turret, "脉冲炮塔", "传送带供铜或铅弹药；通电提高射速，水冷进一步提速。", 300, 0, 6, 3, 22, 12, 0, 0);
        blocks[10] = new BlockDef(BlockKind.Wall, "合金墙", "阻挡敌人并吸收攻击；敌人被封路后会拆墙。", 650, 0, 0, 0, 5, 5, 0, 0);
        blocks[11] = new BlockDef(BlockKind.Pump, "取水泵", "建在水面上，向四周管道与工厂输水。", 160, 1, 4, 3, 14, 8, 0, 0);
        blocks[12] = new BlockDef(BlockKind.Pipe, "双通道管道", "相邻连通，各自运输水和石油，容量 100。", 90, 1, 0, 0, 2, 1, 0, 0);
        blocks[13] = new BlockDef(BlockKind.Relay, "电力中继", "连接半径五格内的电力建筑，延伸电网。", 120, 0, 0, 5, 5, 8, 0, 0);
        blocks[14] = new BlockDef(BlockKind.OilPump, "油井", "建在油层上，为装配机供给石油。", 190, 2, 8, 3, 20, 16, 8, 0);
        blocks[15] = new BlockDef(BlockKind.Scatter, "苍穹散射", "双管齐射速刷低甲蜂群；耗电高，惧怕重甲。", 260, 6, 12, 3, 26, 14, 0, 0);
        blocks[16] = new BlockDef(BlockKind.Sniper, "穿云狙炮", "远距离点名高价值目标；耗铅，射速极慢。", 240, 7, 10, 3, 30, 22, 8, 0);
        blocks[17] = new BlockDef(BlockKind.Mortar, "崩地臼炮", "曲射轰击地面集群，落点溅射；无法对空。", 300, 8, 14, 3, 34, 0, 10, 4);
        blocks[18] = new BlockDef(BlockKind.DroneFab, "铁蜂机巢", "消耗铜铅硅组装铁蜂无人机，自动补充战损；满编时停工。", 320, 10, 24, 3, 60, 40, 20, 0);
        blocks[19] = new BlockDef(BlockKind.Prism, "棱镜聚焦塔", "持续光束灼蚀单一目标，对空对地；耗电极大。", 280, 11, 30, 3, 40, 10, 25, 18);
        blocks[20] = new BlockDef(BlockKind.Repair, "修复投影", "投影范围内的建筑持续修复；耗电，范围可叠加强效。", 240, 12, 18, 4, 30, 25, 0, 8);
        blocks[21] = new BlockDef(BlockKind.Overdrive, "过护投影", "范围内钻头与工厂运转大幅提速；耗电巨大。", 240, 13, 26, 4, 40, 20, 15, 6);
        blocks[22] = new BlockDef(BlockKind.Shield, "力场护盾", "张开局力场吸收来袭火力与啃咬，断电后缓慢重张。", 300, 14, 30, 3, 45, 30, 20, 10);
        recipes = new RecipeDef[4];
        recipes[0] = new RecipeDef("合金钢", BlockKind.Furnace, 1, 0, 2, 1, 1, 4, 2, 100, 0, 0);
        recipes[1] = new RecipeDef("精炼硅", BlockKind.Furnace, 1, 2, 2, 0, 1, 3, 2, 140, 0, 0);
        recipes[2] = new RecipeDef("水冷钛晶", BlockKind.Assembler, 2, 4, 2, 3, 2, 5, 1, 180, 12, 0);
        recipes[3] = new RecipeDef("石油裂解", BlockKind.Assembler, 2, 0, 0, 0, 0, 2, 3, 100, 0, 12);
        techs = new TechDef[15];
        techs[0] = new TechDef("基础工程", "钻采、运输、发电和防御已就绪。", 0, 0, 0, 0, 0, 0, 0);
        techs[1] = new TechDef("热工学", "解锁熔炉、钢/硅配方、取水、管道与蓄电池。", 0, 35, 25, 8, 0, 0, 0);
        techs[2] = new TechDef("晶格工程", "解锁装配机、油井、钛晶与石油裂解配方。", 1, 40, 30, 0, 12, 15, 0);
        techs[3] = new TechDef("弹道校准", "炮塔伤害增加 50%，射程增加 1 格。", 1, 30, 30, 0, 12, 20, 0);
        techs[4] = new TechDef("物流增压", "传送带与矿机效率增加 50%。", 2, 40, 20, 10, 20, 20, 5);
        techs[5] = new TechDef("炉心扩张", "建造半径从 15 增至全地图，核心耐久增加 1200。", 2, 80, 60, 0, 25, 40, 12);
        techs[6] = new TechDef("双管齐射", "解锁苍穹散射：双管速射压制低甲蜂群。", 3, 45, 30, 12, 0, 18, 0);
        techs[7] = new TechDef("远程压制", "解锁穿云狙炮：远距离点名重甲目标。", 6, 50, 35, 0, 16, 25, 0);
        techs[8] = new TechDef("攻城火力", "解锁崩地臼炮：曲射溅射清扫地面集群。", 6, 55, 0, 0, 20, 30, 8);
        techs[9] = new TechDef("纳米修复", "全部建筑随时间缓慢自修，防线愈战愈坚。", 2, 60, 40, 0, 30, 40, 15);
        techs[10] = new TechDef("铁蜂编队", "解锁铁蜂机巢：组装无人机，可转进攻拔除敌巢断其出兵。", 2, 50, 40, 0, 30, 25, 0);
        techs[11] = new TechDef("棱镜聚焦", "解锁棱镜聚焦塔：持续光束，终结高威胁目标。", 8, 60, 20, 0, 50, 40, 25);
        techs[12] = new TechDef("纳米投影", "解锁修复投影：投射修复力场，防线无需人工照看。", 9, 45, 30, 0, 20, 25, 10);
        techs[13] = new TechDef("过护力场", "解锁过护投影：范围内钻头与工厂效率翻倍不止。", 12, 50, 35, 10, 25, 30, 12);
        techs[14] = new TechDef("局能力场", "解锁力场护盾：吸收来袭火力，为防线争取喘息。", 12, 55, 40, 0, 30, 45, 18);
        enemies = new EnemyDef[5];
        enemies[0] = new EnemyDef("裂壳游兽", 65, 28, 12, 35, 3);
        enemies[1] = new EnemyDef("穿岩重兽", 200, 18, 28, 45, 8);
        enemies[2] = new EnemyDef("玄岩巨像", 1800, 12, 70, 40, 50);
        enemies[3] = new EnemyDef("掠翼飞虫", 80, 34, 10, 35, 5);
        enemies[4] = new EnemyDef("灰烬奔兽", 55, 52, 55, 90, 6);
        waves = new WaveDef[20];
        for (int i = 0; i < 20; i = i + 1) {
            int boss = (i + 1) % 5 == 0 ? 2 : -1;
            waves[i] = new WaveDef(4 + i * 2, ForgeGrid.Max(12, 45 - i), 100 + i * 12, boss);
        }
    }
}
