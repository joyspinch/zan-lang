using System;

namespace Game.Factory;

public class ForgeSimulation {
    ForgeWorld world;
    ForgeFactory factory;
    ForgeCombat combat;

    ForgeSimulation(int seed) {
        world = new ForgeWorld(48, 36, seed);
        ForgeMap map = new ForgeMap(world);
        map.Generate();
        factory = new ForgeFactory(world);
        combat = new ForgeCombat(world);
    }

    ForgeSimulation(ForgeWorld loaded) {
        world = loaded;
        world.topologyDirty = true; world.pathsDirty = true;
        factory = new ForgeFactory(world);
        combat = new ForgeCombat(world);
    }

    void TickEffects() {
        for (int i = 0; i < world.effects.Length; i = i + 1) {
            ForgeEffect e = world.effects[i];
            if (!e.active) { continue; }
            e.life = e.life - 1;
            if (e.life <= 0) { e.active = false; continue; }
            if (e.vx != 0 || e.vy != 0) {
                e.x = e.x + e.vx; e.y = e.y + e.vy;
                if (e.kind == 3) { e.vy = e.vy + 6; }  // 烟尘上飘减速
                if (e.kind == 1) { e.vx = e.vx * 4 / 5; e.vy = e.vy * 4 / 5; }  // 火花衰减
            }
        }
        if (world.shake > 0 && world.tick % 2 == 0) { world.shake = world.shake - 1; }
    }

    void Step() {
        if (world.defeated || world.victory) { TickEffects(); return; }
        world.tick = world.tick + 1;
        factory.Step();
        combat.Step();
        TickEffects();
    }
}
