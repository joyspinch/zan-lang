using System;

namespace Game.Server.Network;

// 游戏标准二进制数据包定义。
// 报文结构头（定长 16 字节）：
// [0..3]   totalLength: int (包括头部与有效负载的总长度)
// [4..7]   opCode:      int (操作码，标识业务指令类型)
// [8..11]  seq:         int (客户端调用序号，用于响应时原样送回)
// [12..19] routeId:     long (目标实体 ID，如 PlayerId / ActorId)
// [20..]   payload:     byte[] (业务负载数据)
public class Packet {
    public const int HEADER_SIZE = 20;

    public int opCode;
    public int seq;
    public long routeId;
    public byte[] payload;
    public int payloadLength;

    public Packet() {
        this.opCode = 0;
        this.seq = 0;
        this.routeId = 0L;
        this.payload = null;
        this.payloadLength = 0;
    }

    public Packet(int opCode, int seq, long routeId, byte[] payload, int length) {
        this.opCode = opCode;
        this.seq = seq;
        this.routeId = routeId;
        this.payload = payload;
        this.payloadLength = length;
    }

    public static Packet Create(int opCode, int seq, long routeId, byte[] payload) {
        int len = payload != null ? payload.Length : 0;
        return new Packet(opCode, seq, routeId, payload, len);
    }

    public static Packet CreateEmpty(int opCode, int seq, long routeId) {
        return new Packet(opCode, seq, routeId, null, 0);
    }

    public int TotalSize() {
        return HEADER_SIZE + this.payloadLength;
    }
}
