using System;

namespace Game.Server.Cluster;

// Actor 集群节点归属记录。
public class LocationRecord {
    public long actorId;
    public int nodeId;
    public int version;
    public long updateTime;

    public LocationRecord(long actorId, int nodeId, int version, long updateTime) {
        this.actorId = actorId;
        this.nodeId = nodeId;
        this.version = version;
        this.updateTime = updateTime;
    }
}
