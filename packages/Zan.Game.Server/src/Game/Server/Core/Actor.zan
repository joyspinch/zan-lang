using System;

namespace Game.Server.Core;

// Actor 并发实体基类。
// 单个 Actor 实例的消息处理在 ActorSystem 调度下是严格单线程串行的，
// 内部状态修改无需加锁。
public class Actor {
    public long id;
    public int actorType;
    public Mailbox mailbox;
    public ActorSystem system;
    public bool isAlive;

    public Actor(long id, int actorType) {
        this.id = id;
        this.actorType = actorType;
        this.mailbox = new Mailbox(64);
        this.system = null;
        this.isAlive = true;
    }

    public virtual void OnInit() {
    }

    public virtual void OnReceive(ActorMessage msg) {
    }

    public virtual void OnTick(long deltaMs) {
    }

    public virtual void OnDestroy() {
    }

    // 投递消息给其它 Actor
    public bool Send(long targetId, int msgType, byte[] data) {
        if (this.system == null) {
            return false;
        }
        ActorMessage msg = ActorMessage.Create(msgType, this.id, targetId, data);
        return this.system.Send(msg);
    }

    // 销毁自身
    public void KillSelf() {
        if (this.system != null) {
            this.system.Kill(this.id);
        }
    }
}
