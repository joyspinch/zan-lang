using System;

namespace Game.Server.Room;

// 房间生命周期与调度管理器。
public class RoomManager {
    private Room[] rooms;
    private int capacity;
    private int count;

    public RoomManager(int initialCapacity) {
        int cap = initialCapacity > 16 ? initialCapacity : 64;
        this.capacity = cap;
        this.rooms = new Room[cap];
        this.count = 0;
    }

    public RoomManager() : this(128) {
    }

    public int Count() {
        return this.count;
    }

    public Room CreateRoom(long roomId, int maxMembers) {
        if (roomId <= 0L || this.GetRoom(roomId) != null) {
            return null;
        }
        this.EnsureCapacity();
        Room r = new Room(roomId, maxMembers);
        this.rooms[this.count] = r;
        this.count = this.count + 1;
        return r;
    }

    public Room GetRoom(long roomId) {
        for (int i = 0; i < this.count; i = i + 1) {
            Room r = this.rooms[i];
            if (r != null && r.roomId == roomId) {
                return r;
            }
        }
        return null;
    }

    // 寻找可直接加入的等待中房间（快速匹配）
    public Room FindMatchableRoom() {
        for (int i = 0; i < this.count; i = i + 1) {
            Room r = this.rooms[i];
            if (r != null && r.state == Room.STATE_WAITING && !r.IsFull()) {
                return r;
            }
        }
        return null;
    }

    public bool RemoveRoom(long roomId) {
        for (int i = 0; i < this.count; i = i + 1) {
            Room r = this.rooms[i];
            if (r != null && r.roomId == roomId) {
                r.Close();
                this.rooms[i] = this.rooms[this.count - 1];
                this.rooms[this.count - 1] = null;
                this.count = this.count - 1;
                return true;
            }
        }
        return false;
    }

    // 全量推进所有进行中的对局房间
    public int TickRooms(long deltaMs) {
        int ticked = 0;
        for (int i = 0; i < this.count; i = i + 1) {
            Room r = this.rooms[i];
            if (r != null && r.state == Room.STATE_PLAYING) {
                r.Tick(deltaMs);
                ticked = ticked + 1;
            }
        }
        return ticked;
    }

    private void EnsureCapacity() {
        if (this.count < this.capacity) {
            return;
        }
        int newCap = this.capacity * 2;
        Room[] newArr = new Room[newCap];
        for (int i = 0; i < this.count; i = i + 1) {
            newArr[i] = this.rooms[i];
        }
        this.rooms = newArr;
        this.capacity = newCap;
    }
}
