using System;
using System.Diagnostics;

namespace System.Data;

// 完成执行的 SQL 语句度量记录（含执行耗时微秒数）。
delegate void SqlTraceSink(string sql, long us);

// SQL 执行耗时上报槽点，由需要追踪性能的应用在启动时配置。
class DbTrace {
    static SqlTraceSink sink = null;

    // 配置耗时 SQL 语句接收回调；传入 null 停止追踪。
    static void Sink(SqlTraceSink fn) { DbTrace.sink = fn; }

    // 核心契约与语义定义。
    static bool Enabled() { return DbTrace.sink != null; }

    // 核心契约与语义定义。
    static long NowUs() {
        long freq = Stopwatch.Frequency();
        long perUs = freq / 1000000;
        if (perUs < 1) { perUs = 1; }
        return Stopwatch.NowTicks() / perUs;
    }

    // 核心契约与语义定义。
    static void Report(string sql, long startUs) {
        SqlTraceSink fn = DbTrace.sink;
        if (fn == null) { return; }
        long us = DbTrace.NowUs() - startUs;
        if (us < 0) { us = 0; }
        fn(sql, us);
    }
}
