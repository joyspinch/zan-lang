using System;
using System.Diagnostics;

namespace System.Data;

/// <summary>完成执行的 SQL 语句度量记录（含执行耗时微秒数）。</summary>
delegate void SqlTraceSink(string sql, long us);

/// <summary>SQL 执行耗时上报槽点，由需要追踪性能的应用在启动时配置。</summary>
class DbTrace {
    static SqlTraceSink sink = null;

    /// <summary>配置耗时 SQL 语句接收回调；传入 null 停止追踪。</summary>
    static void Sink(SqlTraceSink fn) { DbTrace.sink = fn; }

    /// <summary>Whether anything is listening. Call sites use it to skip the
    /// wrapper and the clock entirely.</summary>
    static bool Enabled() { return DbTrace.sink != null; }

    /// <summary>Monotonic microseconds: the reading a duration is measured from.
    /// Monotonic, because a statement timed across an NTP correction would
    /// otherwise be reported as hours long (or negative).</summary>
    static long NowUs() {
        long freq = Stopwatch.Frequency();
        long perUs = freq / 1000000;
        if (perUs < 1) { perUs = 1; }
        return Stopwatch.NowTicks() / perUs;
    }

    /// <summary>Reports the statement that started at `startUs` (a
    /// <see cref="NowUs"/> reading) as having just finished.</summary>
    static void Report(string sql, long startUs) {
        SqlTraceSink fn = DbTrace.sink;
        if (fn == null) { return; }
        long us = DbTrace.NowUs() - startUs;
        if (us < 0) { us = 0; }
        fn(sql, us);
    }
}
