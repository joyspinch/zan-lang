using System;
using System.Diagnostics;

namespace System.Data;

// 完成执行的 SQL 语句度量记录（含执行耗时微秒数）。
public delegate void SqlTraceSink(string sql, long us);

// SQL 执行耗时与链路追踪上报槽点，打通 OpenTelemetry 数据库遥测规范与慢查询治理。
public class DbTrace {
    private static string stateLock = "System.Data.DbTrace.stateLock";
    public static SqlTraceSink sink = null;
    public static SqlTraceSink slowSink = null;
    public static long slowThresholdUs = 500000; // 默认 500ms
    public static bool activityTracing = true;
    public static string dbSystemName = "sql";

    // 配置耗时 SQL 语句接收回调；传入 null 停止追踪。
    public static void Sink(SqlTraceSink fn) {
        lock (DbTrace.stateLock) { DbTrace.sink = fn; }
    }

    // 配置慢查询告警接收回调。
    public static void OnSlowQuery(SqlTraceSink fn) {
        lock (DbTrace.stateLock) { DbTrace.slowSink = fn; }
    }

    // 设置慢查询阈值（毫秒）。
    public static void SetSlowQueryThresholdMs(int ms) {
        lock (DbTrace.stateLock) {
            DbTrace.slowThresholdUs = ms > 0 ? (long)ms * 1000L : 500000L;
        }
    }

    // 设置数据库类型名称（例如 "mysql", "postgres", "sqlite", "sqlserver"）。
    public static void SetDbSystem(string system) {
        lock (DbTrace.stateLock) {
            DbTrace.dbSystemName = system != null ? system : "sql";
        }
    }

    // 是否开启自动 Activity 分布式链路追踪。
    public static void EnableActivityTracing(bool on) {
        lock (DbTrace.stateLock) { DbTrace.activityTracing = on; }
    }

    public static bool Enabled() {
        lock (DbTrace.stateLock) {
            return DbTrace.sink != null || DbTrace.slowSink != null || DbTrace.activityTracing;
        }
    }

    public static long NowUs() {
        long freq = Stopwatch.Frequency();
        long perUs = freq / 1000000;
        if (perUs < 1) { perUs = 1; }
        return Stopwatch.NowTicks() / perUs;
    }

    // 开启一次 SQL 操作，若当前存在链路且开启追踪则返回对应 Activity。
    public static Activity BeginSpan(string sql) {
        bool traceOn = false;
        string sysName = "sql";
        lock (DbTrace.stateLock) {
            traceOn = DbTrace.activityTracing;
            sysName = DbTrace.dbSystemName;
        }
        if (!traceOn) { return null; }
        if (Activity.Current == null) { return null; }
        Activity span = Activity.Start("db.query");
        span.SetTag("db.system", sysName);
        if (sql != null) {
            span.SetTag("db.statement", sql);
        }
        return span;
    }

    // 完成 SQL 上报与链路 Span 归档。
    public static void Report(string sql, long startUs, Activity span) {
        long us = DbTrace.NowUs() - startUs;
        if (us < 0) { us = 0; }

        SqlTraceSink curSink = null;
        SqlTraceSink curSlow = null;
        long thresh = 500000L;
        lock (DbTrace.stateLock) {
            curSink = DbTrace.sink;
            curSlow = DbTrace.slowSink;
            thresh = DbTrace.slowThresholdUs;
        }

        if (span != null) {
            span.SetTag("db.duration_us", Convert.ToString(us));
            if (us >= thresh) {
                span.SetTag("db.slow", "true");
            }
            span.Stop();
        }

        if (curSink != null) {
            curSink(sql, us);
        }

        if (us >= thresh && curSlow != null) {
            curSlow(sql, us);
        }
    }

    // 两参数便捷重载（缺省参数透传为 null）
    public static void Report(string sql, long startUs) {
        DbTrace.Report(sql, startUs, null);
    }
}
