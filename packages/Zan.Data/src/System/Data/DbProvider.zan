using System;

namespace System.Data;

// ZanSql ORM 支持的数据库 provider 枚举常量表。
// 默认 DbConnection 通过 ODBC 驱动连接各类引擎；另有原生驱动：System.Data.MySql、
// System.Data.Sqlite、System.Data.Postgres（兼容 openGauss/Kingbase/Vastbase/GaussDB/QuestDB）、
// System.Data.TDengine（taosAdapter REST API）。
// 独立成文件避免按文件拉入依赖时把 ODBC FFI 拖入只用原生/SQLite 的程序。
public class DbProvider {
    public static int Unknown    = 0 - 1;  // 未到达服务器的失败
    public static int ODBC       = 0;  // 通用 ODBC DSN / 连接字符串
    public static int SQLite     = 1;
    public static int MySQL      = 2;  // + MariaDB / TiDB / OceanBase / PolarDB-X
    public static int PostgreSQL = 3;
    public static int SqlServer  = 4;
    public static int Oracle     = 5;
    public static int ClickHouse = 7;
    public static int QuestDB     = 8;
    public static int Firebird   = 9;
    public static int DuckDB     = 10;
    public static int TDengine    = 11;
    public static int MariaDB    = 12;
    public static int Kingbase   = 13;  // 人大金仓 (PG-wire compatible)
    public static int OpenGauss  = 14;  // openGauss / GaussDB（兼容 PG 线协议）
    public static int DM          = 15;  // 达梦
}
