using System;
using System.Data;
using System.Data.Orm;
namespace System.Data;

public class DbValues {
    public List<DbValue> items;

    public DbValues() {
        this.items = new List<DbValue>();
    }

    // 设置文本列（覆盖之前的值）。
    public DbValues Set(string name, string val) {
        return this.push(name, DbParams.KindText, val, 0, 0.0);
    }

    // 设置整数列。
    public DbValues Set(string name, int val) {
        return this.push(name, DbParams.KindInt, "", (long)val, 0.0);
    }

    // 设置 64 位整数列。
    public DbValues Set(string name, long val) {
        return this.push(name, DbParams.KindInt, "", val, 0.0);
    }

    // 设置浮点列。
    public DbValues Set(string name, double val) {
        return this.push(name, DbParams.KindDouble, "", 0, val);
    }

    // 设置布尔列（以 0/1 存储）。
    public DbValues Set(string name, bool val) {
        int v = 0;
        if (val) { v = 1; }
        return this.push(name, DbParams.KindInt, "", v, 0.0);
    }

    // 将列设置为 SQL NULL。
    public DbValues SetNull(string name) {
        return this.push(name, DbParams.KindNull, "", 0, 0.0);
    }

    // 追加一列；同名列已存在时原位覆盖（保持首次出现的顺序）。
    public DbValues push(string name, int kind, string t, long i, double d) {
        int at = this.IndexOf(name);
        if (at >= 0) {
            this.items[at] = new DbValue(name, kind, t, i, d);
            return this;
        }
        this.items.Add(new DbValue(name, kind, t, i, d));
        return this;
    }

    // 现有列数。
    public int Count() { return this.items.Count; }

    // 索引 i 处的列名。
    public string NameAt(int i) { return this.items[i].name; }

    // 索引 i 处值的类型（参见 DbParams.Kind*）。
    public int KindAt(int i) { return this.items[i].kind; }

    // 列的索引，不存在时为 -1。
    public int IndexOf(string name) {
        for (int i = 0; i < this.items.Count; i = i + 1) {
            if (this.items[i].name == name) { return i; }
        }
        return 0 - 1;
    }

    // 列是否存在。
    public bool Has(string name) { return this.IndexOf(name) >= 0; }

    // 移除某列，使写入时不再处理它。
    public DbValues Remove(string name) {
        int at = this.IndexOf(name);
        if (at >= 0) { this.items.RemoveAt(at); }
        return this;
    }

    // 按原样把索引 i 处的值追加到参数列表。
    public void BindTo(DbParams ps, int i) {
        DbValue v = this.items[i];
        if (v.kind == DbParams.KindInt) { ps.AddLong(v.ival); }
        else if (v.kind == DbParams.KindDouble) { ps.AddDouble(v.dval); }
        else if (v.kind == DbParams.KindText) { ps.Add(v.text); }
        else { ps.AddNull(); }
    }

    // 把索引 i 处的值转换为列声明的
    // 类型（DbParams.Kind* 代码），使所有字段以文本形式携带的表单
    // 其 INTEGER 列仍能按数字绑定。无法转换的值
    // 会抛出指明列名的 Exception，而不是
    // 到达数据库时以类型错误的形式暴露。
    public void BindAs(DbParams ps, int i, int want) {
        DbValue v = this.items[i];
        if (v.kind == DbParams.KindNull || want == DbParams.KindNull ||
            want == v.kind) {
            this.BindTo(ps, i);
            return;
        }
        if (want == DbParams.KindInt) {
            if (v.kind == DbParams.KindDouble) {
                double d = v.dval;
                long r = (long)d;
                if ((double)r != d) { this.reject(v, "int"); }
                ps.AddLong(r);
                return;
            }
            ps.AddLong(this.parseInt(v));
            return;
        }
        if (want == DbParams.KindDouble) {
            if (v.kind == DbParams.KindInt) { ps.AddDouble((double)v.ival); return; }
            ps.AddDouble(this.parseDouble(v));
            return;
        }
        if (v.kind == DbParams.KindInt) { ps.Add(Convert.ToString(v.ival)); return; }
        ps.Add(Convert.ToString(v.dval));
    }

    // 严格解析文本为 64 位整数：接受可选正负号与纯数字，
    // "true"/"false" 分别为 1/0；任何其他形状抛出 reject。
    private long parseInt(DbValue v) {
        string t = v.text.Trim();
        if (t == "true") { return 1; }
        if (t == "false") { return 0; }
        int n = t.Length;
        if (n == 0) { this.reject(v, "int"); }
        int i = 0;
        int sign = 1;
        if (t[0] == 45) { sign = 0 - 1; i = 1; }
        else if (t[0] == 43) { i = 1; }
        if (i >= n) { this.reject(v, "int"); }
        long acc = 0;
        while (i < n) {
            int c = t[i] & 255;
            if (c < 48 || c > 57) { this.reject(v, "int"); }
            acc = acc * 10 + (long)(c - 48);
            i = i + 1;
        }
        return acc * (long)sign;
    }

    // 严格解析文本为双精度数：可选正负号、数字与至多一个小数点，
    // 其余字符（包括空格之外的内容）抛出 reject。
    private double parseDouble(DbValue v) {
        string t = v.text.Trim();
        if (t.Length == 0) { this.reject(v, "double"); }
        int i = 0;
        int n = t.Length;
        if (t[0] == 45 || t[0] == 43) { i = 1; }
        bool digit = false;
        bool dot = false;
        while (i < n) {
            int c = t[i] & 255;
            if (c >= 48 && c <= 57) { digit = true; }
            else if (c == 46 && !dot) { dot = true; }
            else { this.reject(v, "double"); }
            i = i + 1;
        }
        if (!digit) { this.reject(v, "double"); }
        return Convert.ToDouble(t);
    }

    // 抛出指明列名、原值与目标类型的转换失败异常。
    private void reject(DbValue v, string want) {
        throw new Exception("column " + v.name + ": cannot use \"" + v.text
            + "\" as " + want);
    }
}
