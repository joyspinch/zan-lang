using System;
using System.Data;
using System.Data.Orm;
namespace System.Data;

public class DbValues {
    public List<DbValue> items;

    public DbValues() {
        this.items = new List<DbValue>();
        this.items.Reserve(8);
    }

    // 设置文本列（覆盖之前的值）。
    public DbValues Set(string name, string val) {
        return this.push(name, DbParams.KindText, val, 0, 0.0);
    }

    // 设置整数列。
    public DbValues Set(string name, int val) {
        return this.push(name, DbParams.KindInt, "", (long)val, 0.0);
    }

    // 设置 64 位整数列。
    public DbValues Set(string name, long val) {
        return this.push(name, DbParams.KindInt, "", val, 0.0);
    }

    // 设置浮点列。
    public DbValues Set(string name, double val) {
        return this.push(name, DbParams.KindDouble, "", 0, val);
    }

    // 设置布尔列（以 0/1 存储）。
    public DbValues Set(string name, bool val) {
        int v = 0;
        if (val) { v = 1; }
        return this.push(name, DbParams.KindInt, "", v, 0.0);
    }

    // 将列设置为 SQL NULL。
    public DbValues SetNull(string name) {
        return this.push(name, DbParams.KindNull, "", 0, 0.0);
    }

    // 追加一列；同名列已存在时原位覆盖（保持首次出现的顺序，免新对象分配）。
    public DbValues push(string name, int kind, string t, long i, double d) {
        string safeName = name != null ? name : "";
        int at = this.IndexOf(safeName);
        if (at >= 0) {
            this.items[at].kind = kind;
            this.items[at].text = t;
            this.items[at].ival = i;
            this.items[at].dval = d;
            return this;
        }
        this.items.Add(new DbValue(safeName, kind, t, i, d));
        return this;
    }

    // 现有列数。
    public int Count() { return this.items.Count; }

    // 索引 i 处的列名。
    public string NameAt(int i) {
        if (i < 0 || i >= this.items.Count) { return ""; }
        return this.items[i].name;
    }

    // 索引 i 处值的类型（参见 DbParams.Kind*）。
    public int KindAt(int i) {
        if (i < 0 || i >= this.items.Count) { return DbParams.KindNull; }
        return this.items[i].kind;
    }

    // 列的索引，不存在时为 -1。
    public int IndexOf(string name) {
        if (name == null) { return -1; }
        int n = this.items.Count;
        for (int i = 0; i < n; i = i + 1) {
            if (this.items[i].name == name) { return i; }
        }
        return 0 - 1;
    }

    // 列是否存在。
    public bool Has(string name) { return this.IndexOf(name) >= 0; }

    // 移除某列，使写入时不再处理它。
    public DbValues Remove(string name) {
        int at = this.IndexOf(name);
        if (at >= 0) { this.items.RemoveAt(at); }
        return this;
    }

    // 按原样把索引 i 处的值追加到参数列表。
    public void BindTo(DbParams ps, int i) {
        if (ps == null || i < 0 || i >= this.items.Count) { return; }
        int k = this.items[i].kind;
        if (k == DbParams.KindInt) { ps.AddLong(this.items[i].ival); }
        else if (k == DbParams.KindDouble) { ps.AddDouble(this.items[i].dval); }
        else if (k == DbParams.KindText) { ps.Add(this.items[i].text); }
        else { ps.AddNull(); }
    }

    // 把索引 i 处的值转换为列声明的
    // 类型（DbParams.Kind* 代码），使所有字段以文本形式携带的表单
    // 其 INTEGER 列仍能按数字绑定。无法转换的值
    // 会抛出指明列名的 Exception，而不是
    // 到达数据库时以类型错误的形式暴露。
    public void BindAs(DbParams ps, int i, int want) {
        if (ps == null || i < 0 || i >= this.items.Count) { return; }
        int k = this.items[i].kind;
        if (k == DbParams.KindNull || want == DbParams.KindNull || want == k) {
            if (k == DbParams.KindInt) { ps.AddLong(this.items[i].ival); }
            else if (k == DbParams.KindDouble) { ps.AddDouble(this.items[i].dval); }
            else if (k == DbParams.KindText) { ps.Add(this.items[i].text); }
            else { ps.AddNull(); }
            return;
        }
        if (want == DbParams.KindInt) {
            if (k == DbParams.KindDouble) {
                double d = this.items[i].dval;
                if (d - d != 0.0 || d < -9223372036854775808.0 || d >= 9223372036854775808.0) {
                    this.reject(this.items[i], "int");
                }
                long r = (long)d;
                if ((double)r != d) { this.reject(this.items[i], "int"); }
                ps.AddLong(r);
                return;
            }
            ps.AddLong(this.parseInt(this.items[i]));
            return;
        }
        if (want == DbParams.KindDouble) {
            if (k == DbParams.KindInt) { ps.AddDouble((double)this.items[i].ival); return; }
            ps.AddDouble(this.parseDouble(this.items[i]));
            return;
        }
        if (k == DbParams.KindInt) { ps.Add(Convert.ToString(this.items[i].ival)); return; }
        ps.Add(Convert.ToString(this.items[i].dval));
    }

    // 严格解析文本为 64 位整数：接受可选正负号与纯数字，
    // "true"/"false" 分别为 1/0；任何其他形状或 int64 溢出抛出 reject（Span 零 Trim 分配）。
    private long parseInt(DbValue v) {
        if (v.text == null) { this.reject(v, "int"); }
        int slen = v.text.Length;
        Span<byte> sp = new Span<byte>((nint)v.text, slen);
        int a = 0;
        int b = slen;
        while (a < b) {
            int c = (int)sp[a];
            if (c != 32 && (c < 9 || c > 13)) { break; }
            a = a + 1;
        }
        while (b > a) {
            int c = (int)sp[b - 1];
            if (c != 32 && (c < 9 || c > 13)) { break; }
            b = b - 1;
        }
        int len = b - a;
        if (len == 0) { this.reject(v, "int"); }
        if (len == 4 && sp[a] == 116 && sp[a + 1] == 114 && sp[a + 2] == 117 && sp[a + 3] == 101) {
            return 1;
        }
        if (len == 5 && sp[a] == 102 && sp[a + 1] == 97 && sp[a + 2] == 108 && sp[a + 3] == 115 && sp[a + 4] == 101) {
            return 0;
        }
        int i = a;
        bool neg = false;
        int c0 = (int)sp[i];
        if (c0 == 45) { neg = true; i = i + 1; }
        else if (c0 == 43) { i = i + 1; }
        if (i >= b) { this.reject(v, "int"); }
        // 在负数空间累加：兼容 INT64_MIN (-9223372036854775808) 并精确拦截所有上/下溢出。
        long limit = neg ? (-9223372036854775807L - 1L) : -9223372036854775807L;
        long multMin = limit / 10L;
        long acc = 0L;
        while (i < b) {
            int c = (int)sp[i];
            if (c < 48 || c > 57) { this.reject(v, "int"); }
            int d = c - 48;
            if (acc < multMin) { this.reject(v, "int"); }
            acc = acc * 10L;
            if (acc < limit + (long)d) { this.reject(v, "int"); }
            acc = acc - (long)d;
            i = i + 1;
        }
        return neg ? acc : -acc;
    }

    // 严格解析文本为双精度数：可选正负号、数字与至多一个小数点，
    // 其余字符或溢出为 NaN/Inf 抛出 reject（Span 零 Trim 分配 + 精确小数快路径）。
    private double parseDouble(DbValue v) {
        if (v.text == null) { this.reject(v, "double"); }
        int slen = v.text.Length;
        Span<byte> sp = new Span<byte>((nint)v.text, slen);
        int a = 0;
        int b = slen;
        while (a < b) {
            int c = (int)sp[a];
            if (c != 32 && (c < 9 || c > 13)) { break; }
            a = a + 1;
        }
        while (b > a) {
            int c = (int)sp[b - 1];
            if (c != 32 && (c < 9 || c > 13)) { break; }
            b = b - 1;
        }
        if (a >= b) { this.reject(v, "double"); }
        int i = a;
        bool neg = false;
        int c0 = (int)sp[i];
        if (c0 == 45) { neg = true; i = i + 1; }
        else if (c0 == 43) { i = i + 1; }
        bool digit = false;
        bool dot = false;
        int sigDigits = 0;
        int fracDigits = 0;
        long mant = 0L;
        while (i < b) {
            int c = (int)sp[i];
            if (c >= 48 && c <= 57) {
                digit = true;
                int d = c - 48;
                if (sigDigits < 15) {
                    if (mant != 0L || d != 0) { sigDigits = sigDigits + 1; }
                    mant = mant * 10L + (long)d;
                } else {
                    sigDigits = sigDigits + 1;
                }
                if (dot) { fracDigits = fracDigits + 1; }
            } else if (c == 46 && !dot) {
                dot = true;
            } else {
                this.reject(v, "double");
            }
            i = i + 1;
        }
        if (!digit) { this.reject(v, "double"); }
        if (sigDigits <= 15 && fracDigits <= 6) {
            double res = (double)mant;
            if (fracDigits == 1) { res = res / 10.0; }
            else if (fracDigits == 2) { res = res / 100.0; }
            else if (fracDigits == 3) { res = res / 1000.0; }
            else if (fracDigits == 4) { res = res / 10000.0; }
            else if (fracDigits == 5) { res = res / 100000.0; }
            else if (fracDigits == 6) { res = res / 1000000.0; }
            return neg ? -res : res;
        }
        double parsed = (a == 0 && b == slen)
            ? Convert.ToDouble(v.text)
            : Convert.ToDouble(NativeMemory.GetString((nint)v.text, a, b - a));
        if (parsed - parsed != 0.0) { this.reject(v, "double"); }
        return parsed;
    }

    // 抛出指明列名、原值与目标类型的转换失败异常。
    private void reject(DbValue v, string want) {
        string raw = v.text != null ? v.text : "<null>";
        throw new Exception("column " + v.name + ": cannot use \"" + raw
            + "\" as " + want);
    }
}
