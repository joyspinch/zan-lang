using System;

namespace System.Data;

// 一个带类型的 SQL 参数：类型加上 text/int/double 载荷
// （仅与类型匹配的字段有意义）。用一个实体代替四个
// 索引对齐的平行列表。整数载荷是 64 位的：KindInt 在各驱动上
// 都按 64 位整数绑定（sqlite3_bind_int64、MYSQL_TYPE_LONGLONG…），
// 窄一点的载荷会把毫秒/微秒累计这类值截断。
class DbParam {
    int kind;
    string text;
    long ival;
    double dval;

    DbParam(int kind, string text, long ival, double dval) {
        this.kind = kind;
        this.text = text;
        this.ival = ival;
        this.dval = dval;
    }
}

// 有序、带类型的 SQL 参数列表，所有数据库驱动共用。
// 值携带自身类型（int / double / text / null），驱动可
// 原生绑定它们（sqlite3_bind_*、COM_STMT_EXECUTE、PQexecParams、
// SQLBindParameter），而不是把转义字符串内联进 SQL。
// 用法：
// 核心契约与语义定义。
class DbParams {
    // NULL 参数的类型码。
    static int KindNull   = 0;
    // 整数参数的类型码（各驱动按 64 位绑定）。
    static int KindInt    = 1;
    // 双精度浮点参数的类型码。
    static int KindDouble = 2;
    // 文本参数的类型码。
    static int KindText   = 3;

    List<DbParam> items;

    DbParams() {
        this.items = new List<DbParam>();
    }

    // 按类型码追加一个参数（Add*/AddInt 等的公共入口）。
    void push(int kind, string t, long i, double d) {
        this.items.Add(new DbParam(kind, t, i, d));
    }

    // 追加一个文本参数。null 字符串绑定为 SQL NULL——
    // 未设置的实体字段必须以 NULL 写入数据库，绝不能是
    // 解引用后的空字符串。
    DbParams Add(string val) {
        if (val == null) {
            push(DbParams.KindNull, "", 0, 0.0);
            return this;
        }
        push(DbParams.KindText, val, 0, 0.0);
        return this;
    }

    // 追加一个整数参数。
    DbParams AddInt(int val) {
        push(DbParams.KindInt, "", (long)val, 0.0);
        return this;
    }

    // 追加一个 64 位整数参数。
    DbParams AddLong(long val) {
        push(DbParams.KindInt, "", val, 0.0);
        return this;
    }

    // 追加一个浮点参数。
    DbParams AddDouble(double val) {
        push(DbParams.KindDouble, "", 0, val);
        return this;
    }

    // 追加一个 NULL 参数。
    DbParams AddNull() {
        push(DbParams.KindNull, "", 0, 0.0);
        return this;
    }

    // 参数数量。
    int Count() { return this.items.Count; }

    // 索引 i 处参数的类型（参见 Kind* 常量）。
    int KindAt(int i) { return this.items[i].kind; }

    // 索引 i 处的文本值（KindAt(i) == KindText 时有效）。
    string TextAt(int i) { return this.items[i].text; }

    // 索引 i 处的整数值（KindAt(i) == KindInt 时有效）。
    long IntAt(int i) { return this.items[i].ival; }

    // 索引 i 处的双精度值（KindAt(i) == KindDouble 时有效）。
    double DoubleAt(int i) { return this.items[i].dval; }

    // 将索引 i 处的参数转为文本（供把所有值都绑定为文本的驱动使用，
    // 如 PQexecParams）。
    string AsText(int i) {
        DbParam p = this.items[i];
        if (p.kind == DbParams.KindInt) { return Convert.ToString(p.ival); }
        if (p.kind == DbParams.KindDouble) { return Convert.ToString(p.dval); }
        if (p.kind == DbParams.KindText) {
            if (p.text == null) { return ""; }
            return p.text;
        }
        return "";
    }

    // 索引 i 处的参数是否为 NULL。
    bool IsNull(int i) { return this.items[i].kind == DbParams.KindNull; }
}
