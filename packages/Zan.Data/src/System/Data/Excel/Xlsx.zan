using System;
using System.IO;
using System.Text;
using System.IO.Compression;
namespace System.Data.Excel;

public class Xlsx {
    // XML 文本转义：&amp; &lt; &gt;，并剥掉 XML 1.0 不允许的
    // 控制字符（保留制表符、换行、回车）。
    public static string Esc(string s) {
        if (s == null || s.Length == 0) { return ""; }
        int n = s.Length;
        int i = 0;
        while (i < n) {
            int c = (int)s[i];
            if (c == 38 || c == 60 || c == 62 || (c < 32 && c != 9 && c != 10 && c != 13)) {
                break;
            }
            i = i + 1;
        }
        if (i == n) { return s; }

        StringBuilder sb = new StringBuilder();
        if (i > 0) {
            sb.Append(s.Substring(0, i));
        }
        int start = i;
        while (i < n) {
            int c = (int)s[i];
            if (c == 38 || c == 60 || c == 62 || (c < 32 && c != 9 && c != 10 && c != 13)) {
                if (i > start) {
                    sb.Append(s.Substring(start, i - start));
                }
                if (c == 38) { sb.Append("&amp;"); }
                else if (c == 60) { sb.Append("&lt;"); }
                else if (c == 62) { sb.Append("&gt;"); }
                // XML 1.0 非法控制字符：丢弃
                start = i + 1;
            }
            i = i + 1;
        }
        if (start < n) {
            sb.Append(s.Substring(start, n - start));
        }
        return sb.ToString();
    }

    // 属性值转义：在 <see cref="Esc"/> 基础上再转义双引号（单趟流式切片）。
    public static string EscAttr(string s) {
        if (s == null || s.Length == 0) { return ""; }
        int n = s.Length;
        int i = 0;
        while (i < n) {
            int c = (int)s[i];
            if (c == 34 || c == 38 || c == 60 || c == 62 || (c < 32 && c != 9 && c != 10 && c != 13)) {
                break;
            }
            i = i + 1;
        }
        if (i == n) { return s; }

        StringBuilder sb = new StringBuilder();
        if (i > 0) {
            sb.Append(s.Substring(0, i));
        }
        int start = i;
        while (i < n) {
            int c = (int)s[i];
            if (c == 34 || c == 38 || c == 60 || c == 62 || (c < 32 && c != 9 && c != 10 && c != 13)) {
                if (i > start) {
                    sb.Append(s.Substring(start, i - start));
                }
                if (c == 34) { sb.Append("&quot;"); }
                else if (c == 38) { sb.Append("&amp;"); }
                else if (c == 60) { sb.Append("&lt;"); }
                else if (c == 62) { sb.Append("&gt;"); }
                // XML 1.0 非法控制字符：丢弃
                start = i + 1;
            }
            i = i + 1;
        }
        if (start < n) {
            sb.Append(s.Substring(start, n - start));
        }
        return sb.ToString();
    }

    // 0 → A、25 → Z、26 → AA……（Excel 列引用）。
    public static string ColRef(int c) {
        string s = "";
        int n = c + 1;
        while (n > 0) {
            int m = (n - 1) - ((n - 1) / 26) * 26;
            s = Encoding.Utf8FromCodePoint(65 + m) + s;
            n = (n - 1) / 26;
        }
        return s;
    }

    // double → 十进制文本：从 0 位小数起逐位尝试，取首个能按
    // 相对容差往返的表示；|v| ≥ 1e15 或非零 |v| < 1e-9 时写科学
    // 计数法。绝不用 Convert.ToString(double)——它只有约 6 位
    // 有效数字，123.45 会被写成 123.45（碰巧）但 123.4567 变 123.457。
    public static string RealToText(double v) {
        if (v == 0.0) { return "0"; }
        bool neg = v < 0.0;
        double a = v;
        if (neg) { a = 0.0 - a; }
        if (a >= Xlsx.Pow10(15) || a < 1.0 / Xlsx.Pow10(9)) {
            int exp = 0;
            while (a >= 10.0) { a = a / 10.0; exp = exp + 1; }
            while (a < 1.0) { a = a * 10.0; exp = exp - 1; }
            string mant = Xlsx.Shortest(a, 15);
            string sign = "E+";
            if (exp < 0) { sign = "E-"; exp = 0 - exp; }
            string s = mant + sign + Convert.ToString(exp);
            if (neg) { s = "-" + s; }
            return s;
        }
        // 整数位数决定小数位上限，保证 a*10^d 不超出 long。
        int digits = 1;
        double t = a;
        while (t >= 10.0) { t = t / 10.0; digits = digits + 1; }
        string f = Xlsx.Shortest(a, 18 - digits);
        if (neg) { return "-" + f; }
        return f;
    }

    // 0..maxDec 位小数逐个尝试，返回首个按相对容差 1e-15
    // 往返的定点表示；都不行则返回最长表示兜底。
    private static string Shortest(double a, int maxDec) {
        string last = Xlsx.FixedReal(a, maxDec);
        for (int d = 0; d <= maxDec; d = d + 1) {
            string s = Xlsx.FixedReal(a, d);
            double p = Xlsx.ParseFixed(s);
            double diff = p - a;
            if (diff < 0.0) { diff = 0.0 - diff; }
            if (diff <= a / Xlsx.Pow10(15)) { return s; }
        }
        return last;
    }

    // a >= 0：渲染为恰好 `decimals` 位小数（四舍五入）。
    private static string FixedReal(double a, int decimals) {
        double scale = Xlsx.Pow10(decimals);
        long total = (long)(a * scale + 0.5);
        long ip = total;
        string frac = "";
        if (decimals > 0) {
            long p = (long)scale;
            ip = total / p;
            long fp = total - ip * p;
            frac = ".";
            string fs = Convert.ToString(fp);
            while (fs.Length < decimals) { fs = "0" + fs; }
            frac = frac + fs;
        }
        return Convert.ToString(ip) + frac;
    }

    // 严格十进制解析（我自己生成的文本，格式可控）。
    private static double ParseFixed(string s) {
        double v = 0.0;
        int i = 0;
        bool neg = false;
        if (i < s.Length && (int)s[i] == 45) { neg = true; i = i + 1; }
        while (i < s.Length) {
            int c = (int)s[i];
            if (c == 46) { i = i + 1; break; }
            if (c < 48 || c > 57) { return 0.0; }
            v = v * 10.0 + (double)(c - 48);
            i = i + 1;
        }
        double scale = 1.0;
        while (i < s.Length) {
            int c = (int)s[i];
            if (c < 48 || c > 57) { return 0.0; }
            scale = scale / 10.0;
            v = v + (double)(c - 48) * scale;
            i = i + 1;
        }
        if (neg) { return 0.0 - v; }
        return v;
    }

    // 以 double 表示的 10^n。
    private static double Pow10(int n) {
        double p = 1.0;
        for (int i = 0; i < n; i = i + 1) { p = p * 10.0; }
        return p;
    }

    // 显示宽度估算：CJK/全角按 2，其他按 1（代理对按 2）。
    // Excel 的列宽单位约等于一个 ASCII 字符，这只求观感不较真。
    public static int WideLen(string s) {
        int w = 0;
        for (int i = 0; i < s.Length; i = i + 1) {
            int c = (int)s[i];
            if (c >= 0xD800 && c <= 0xDFFF) { w = w + 2; }
            else if (c >= 0x2E80 || (c >= 0x1100 && c <= 0x115F)) { w = w + 2; }
            else { w = w + 1; }
        }
        return w;
    }
}
