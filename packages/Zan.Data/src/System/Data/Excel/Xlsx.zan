using System;
using System.IO;
using System.Text;
using System.IO.Compression;
namespace System.Data.Excel;

public class Xlsx {
    // XML 文本转义：&amp; &lt; &gt;，并按 XML 1.0 剥掉不允许的
    // 控制字符（保留制表符、换行、回车）。委托 stdlib 共享内核。
    public static string Esc(string s) {
        return Encoding.XmlEscape(s, false, true);
    }

    // 属性值转义：在 <see cref="Esc"/> 基础上再转义双引号。
    public static string EscAttr(string s) {
        return Encoding.XmlEscape(s, true, true);
    }

    // 10^0..10^18 无状态常量查找：零堆分配、无静态初始化竞态。
    private static long Pow10Long(int n) {
        if (n <= 0) { return 1L; }
        if (n == 1) { return 10L; }
        if (n == 2) { return 100L; }
        if (n == 3) { return 1000L; }
        if (n == 4) { return 10000L; }
        if (n == 5) { return 100000L; }
        if (n == 6) { return 1000000L; }
        if (n == 7) { return 10000000L; }
        if (n == 8) { return 100000000L; }
        if (n == 9) { return 1000000000L; }
        if (n == 10) { return 10000000000L; }
        if (n == 11) { return 100000000000L; }
        if (n == 12) { return 1000000000000L; }
        if (n == 13) { return 10000000000000L; }
        if (n == 14) { return 100000000000000L; }
        if (n == 15) { return 1000000000000000L; }
        if (n == 16) { return 10000000000000000L; }
        if (n == 17) { return 100000000000000000L; }
        return 1000000000000000000L;
    }

    private static double Pow10Double(int n) {
        if (n > 308) { return 1.0 / 0.0; }
        if (n < 0) { return 1.0; }
        if (n <= 18) { return (double)Xlsx.Pow10Long(n); }
        double p = 1.0;
        for (int i = 0; i < n; i = i + 1) { p = p * 10.0; }
        return p;
    }

    // 0 → A、25 → Z、26 → AA……（Excel 列引用）。
    public static string ColRef(int c) {
        if (c < 0) { return ""; }
        byte[] buf = new byte[12];
        int pos = 12;
        long n = (long)c + 1L;
        while (n > 0L && pos > 0) {
            long nm1 = n - 1L;
            long q = nm1 / 26L;
            int m = (int)(nm1 - q * 26L);
            pos = pos - 1;
            buf[pos] = (byte)(65 + m);
            n = q;
        }
        return NativeMemory.GetString((nint)buf + pos, 0, 12 - pos);
    }

    // double → 十进制文本：从 0 位小数起逐位尝试，取首个能按
    // 相对容差往返的表示；|v| ≥ 1e15 或非零 |v| < 1e-9 时写科学
    // 计数法。非有限值（NaN/±Infinity）回退 "0"，避免死循环或非法 XML。
    public static string RealToText(double v) {
        if (v != v || (v - v) != 0.0) { return "0"; }
        if (v == 0.0) { return "0"; }
        bool neg = v < 0.0;
        double a = neg ? (0.0 - v) : v;
        if (a >= 1000000000000000.0 || a < 0.000000001) {
            int exp = 0;
            while (a >= 10.0 && exp < 400) { a = a / 10.0; exp = exp + 1; }
            while (a < 1.0 && exp > -400) { a = a * 10.0; exp = exp - 1; }
            string mant = Xlsx.Shortest(a, 15);
            string sign = "E+";
            if (exp < 0) { sign = "E-"; exp = 0 - exp; }
            string s = mant + sign + Convert.ToString(exp);
            if (neg) { s = "-" + s; }
            return s;
        }
        // 整数位数决定小数位上限，保证 a*10^d 不超出 long。
        int digits = 1;
        double t = a;
        while (t >= 10.0 && digits < 18) { t = t / 10.0; digits = digits + 1; }
        return Xlsx.ShortestSigned(a, 18 - digits, neg);
    }

    // 0..maxDec 位小数纯数值检索，只对最终命中位数做一次无中间串格式化。
    private static string Shortest(double a, int maxDec) {
        return Xlsx.ShortestSigned(a, maxDec, false);
    }

    private static string ShortestSigned(double a, int maxDec, bool neg) {
        double tol = a / 1000000000000000.0;
        if (maxDec < 0) { maxDec = 0; }
        if (maxDec > 18) { maxDec = 18; }
        int winD = maxDec;
        long winTotal = (long)(a * Xlsx.Pow10Double(maxDec) + 0.5);
        for (int d = 0; d <= maxDec; d = d + 1) {
            double scale = Xlsx.Pow10Double(d);
            long total = (long)(a * scale + 0.5);
            double p = d == 0 ? (double)total : ((double)total / scale);
            double diff = p - a;
            if (diff < 0.0) { diff = 0.0 - diff; }
            if (diff <= tol) {
                winD = d;
                winTotal = total;
                break;
            }
        }
        return Xlsx.FormatTotal(winTotal, winD, neg);
    }

    private static string FormatTotal(long total, int decimals, bool neg) {
        if (total < 0L) { total = 0L; }
        if (decimals < 0) { decimals = 0; }
        if (decimals > 18) { decimals = 18; }
        byte[] buf = new byte[32];
        int pos = 32;
        long ip = total;
        if (decimals > 0) {
            long p = Xlsx.Pow10Long(decimals);
            ip = total / p;
            long fp = total - ip * p;
            for (int i = 0; i < decimals; i = i + 1) {
                long q = fp / 10L;
                pos = pos - 1;
                buf[pos] = (byte)(48 + (int)(fp - q * 10L));
                fp = q;
            }
            pos = pos - 1;
            buf[pos] = 46; // '.'
        }
        if (ip == 0L) {
            pos = pos - 1;
            buf[pos] = 48;
        } else {
            while (ip > 0L) {
                long q = ip / 10L;
                pos = pos - 1;
                buf[pos] = (byte)(48 + (int)(ip - q * 10L));
                ip = q;
            }
        }
        if (neg) {
            pos = pos - 1;
            buf[pos] = 45; // '-'
        }
        return NativeMemory.GetString((nint)buf + pos, 0, 32 - pos);
    }

    // 以 double 表示的 10^n。
    private static double Pow10(int n) {
        return Xlsx.Pow10Double(n);
    }

    // 显示宽度估算：CJK/全角按 2，其他按 1（代理对按 2）。
    // Excel 的列宽单位约等于一个 ASCII 字符，这只求观感不较真。
    public static int WideLen(string s) {
        if (s == null) { return 0; }
        int w = 0;
        for (int i = 0; i < s.Length; i = i + 1) {
            int c = (int)s[i];
            if (c >= 0xD800 && c <= 0xDFFF) { w = w + 2; }
            else if (c >= 0x2E80 || (c >= 0x1100 && c <= 0x115F)) { w = w + 2; }
            else { w = w + 1; }
        }
        return w;
    }
}
