using System;
using System.IO;
using System.Text;
using System.IO.Compression;
namespace System.Data.Excel;

public class XlsxRowSource {
    // 数据总行数（含表头行）。
    public virtual int RowCount() { return 0; }

    // 填第 `index` 行。返回 false 中止导出（文件被删除）。
    public virtual bool FillRow(int index, List<XlsxCell> row) { return true; }

    // 已写完 `done`/`total` 行（写线程回调，约每 512 行一次）。
    public virtual void OnProgress(int done, int total) { }

    // 返回 true 中止导出：半成品被删除，SaveStreaming 返回 false。
    public virtual bool Cancelled() { return false; }
}
