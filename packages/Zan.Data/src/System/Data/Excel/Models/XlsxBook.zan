using System;
using System.IO;
using System.Text;
using System.IO.Compression;
namespace System.Data.Excel;

public class XlsxBook {
    public List<XlsxSheet> sheets;

    // 静态 OPC 部件字节及预压缩缓存（只读共享，免每次保存重复构造、CRC 与 Deflate）。
    private static string staticPartsLock = "XlsxBook.staticPartsLock";
    private static bool staticPartsReady = false;
    private static byte[] cachedRootRels;
    private static byte[] cachedRootRelsZ6;
    private static int cachedRootRelsCrc;
    private static byte[] cachedCoreProps;
    private static byte[] cachedCorePropsZ6;
    private static int cachedCorePropsCrc;
    private static byte[] cachedAppProps;
    private static byte[] cachedAppPropsZ6;
    private static int cachedAppPropsCrc;
    private static byte[] cachedStylesXml;
    private static byte[] cachedStylesXmlZ6;
    private static int cachedStylesXmlCrc;
    private static byte[] cachedCt1;
    private static byte[] cachedCt1Z6;
    private static int cachedCt1Crc;
    private static byte[] cachedWbRels1;
    private static byte[] cachedWbRels1Z6;
    private static int cachedWbRels1Crc;

    private static byte[] GrowBuf(byte[] buf, int pos, long needExtra, long pad) {
        if (pos < 0 || needExtra < 0L || pad < 0L) {
            throw new IOException("XlsxBook: invalid buffer growth request");
        }
        long need = (long)pos + needExtra;
        if (need > 2147483591L) {
            throw new IOException("XlsxBook: worksheet XML exceeds maximum buffer size");
        }
        if (buf != null && need <= (long)buf.Length) { return buf; }
        long cap = buf != null && buf.Length > 0 ? (long)buf.Length * 2L : 4096L;
        long withPad = need + pad;
        if (withPad > 2147483591L) { withPad = 2147483591L; }
        if (cap < withPad) { cap = withPad; }
        if (cap > 2147483591L) { cap = 2147483591L; }
        byte[] nb = new byte[(int)cap];
        if (buf != null && pos > 0) {
            NativeMemory.Copy((nint)nb, (nint)buf, pos);
        }
        return nb;
    }

    // 数值单元格 XML 文本校验：合法数字直接返回（零分配），含 XML 元字符或非法控制符时转义防注入。
    private static string SafeNumXml(string s) {
        if (s == null || s.Length == 0) { return ""; }
        int n = s.Length;
        for (int i = 0; i < n; i = i + 1) {
            int c = s[i] & 255;
            if (c < 32 || c == 38 || c == 60 || c == 62) {
                return Xlsx.Esc(s);
            }
        }
        return s;
    }

    // 按 UTF-8 码点边界截断至最多 maxChars 个字符，避免截断多字节序列产生非法 UTF-8。
    private static string TruncateUtf8Chars(string s, int maxChars) {
        if (s == null || s.Length == 0 || maxChars <= 0) { return ""; }
        int n = s.Length;
        int chars = 0;
        int i = 0;
        while (i < n && chars < maxChars) {
            int b = s[i] & 255;
            int step = 1;
            if ((b & 128) == 0) { step = 1; }
            else if ((b & 224) == 192) { step = 2; }
            else if ((b & 240) == 224) { step = 3; }
            else if ((b & 248) == 240) { step = 4; }
            if (i + step > n) { break; }
            i = i + step;
            chars = chars + 1;
        }
        if (i == n) { return s; }
        return s.Substring(0, i);
    }

    // 构造；统一经 <see cref="New"/>/<see cref="FromText"/> 创建。
    public XlsxBook() {
        this.sheets = new List<XlsxSheet>();
    }

    // 新建空工作簿。
    public static XlsxBook New() { return new XlsxBook(); }

    // 添加工作表并返回它。名字会清洗 Excel 的非法字符
    // （: \ / ? * [ ] 与首尾撇号）、按 UTF-8 码点边界截到 31 字符，并与已有表名去重。
    public XlsxSheet AddSheet(string name) {
        if (name == null) { name = ""; }
        int n = name.Length;
        StringBuilder sb = new StringBuilder();
        int chars = 0;
        int i = 0;
        while (i < n && chars < 31) {
            int c = name[i] & 255;
            if (c < 128) {
                if (c == 58 || c == 92 || c == 47 || c == 63 || c == 42
                    || c == 91 || c == 93) {
                    sb.Append("_");
                    chars = chars + 1;
                } else if (c == 39 && (i == 0 || i == n - 1)) {
                    // Excel 禁止表名以撇号开头或结尾。
                } else if (c >= 32) {
                    sb.Append(name.Substring(i, 1));
                    chars = chars + 1;
                }
                i = i + 1;
            } else {
                int step = 1;
                if ((c & 224) == 192) { step = 2; }
                else if ((c & 240) == 224) { step = 3; }
                else if ((c & 248) == 240) { step = 4; }
                if (i + step > n) { break; }
                sb.Append(name.Substring(i, step));
                i = i + step;
                chars = chars + 1;
            }
        }
        string clean = sb.Length == 0 ? "Sheet" : sb.ToString();
        string unique = clean;
        int dupSuffix = 2;
        while (XlsxBook.IndexOfSheet(sheets, unique) >= 0) {
            string suf = Convert.ToString(dupSuffix);
            int maxBase = 31 - suf.Length;
            unique = XlsxBook.TruncateUtf8Chars(clean, maxBase > 0 ? maxBase : 1) + suf;
            dupSuffix = dupSuffix + 1;
        }
        XlsxSheet s = new XlsxSheet(unique);
        sheets.Add(s);
        return s;
    }

    // 便捷构建：全文本表格。`firstRowIsHeader` 为 false 时关闭
    // 表头加粗与冻结；需要数字/日期/布尔请用 AddSheet + XlsxCell。
    public static XlsxBook FromText(List<List<string>> rows, bool firstRowIsHeader) {
        XlsxBook b = new XlsxBook();
        XlsxSheet sh = b.AddSheet("Sheet1");
        if (rows != null) {
            for (int r = 0; r < rows.Count; r = r + 1) {
                List<XlsxCell> row = new List<XlsxCell>();
                List<string> src = rows[r];
                if (src != null) {
                    for (int c = 0; c < src.Count; c = c + 1) {
                        row.Add(XlsxCell.Str(src[c]));
                    }
                }
                sh.AddRow(row);
            }
        }
        if (!firstRowIsHeader) {
            sh.headerBold = false;
            sh.freezeHeader = false;
        }
        return b;
    }

    private static void EnsureStaticParts() {
        if (XlsxBook.staticPartsReady) { return; }
        lock (XlsxBook.staticPartsLock) {
            if (XlsxBook.staticPartsReady) { return; }
            byte[] rr = XlsxBook.RootRels().ToBytes();
            XlsxBook.cachedRootRelsCrc = Crc32.Compute(rr, 0, rr.Length, 0);
            XlsxBook.cachedRootRelsZ6 = Deflate.Deflate(rr, 6);
            XlsxBook.cachedRootRels = rr;

            byte[] cp = XlsxBook.CoreProps().ToBytes();
            XlsxBook.cachedCorePropsCrc = Crc32.Compute(cp, 0, cp.Length, 0);
            XlsxBook.cachedCorePropsZ6 = Deflate.Deflate(cp, 6);
            XlsxBook.cachedCoreProps = cp;

            byte[] ap = XlsxBook.AppProps().ToBytes();
            XlsxBook.cachedAppPropsCrc = Crc32.Compute(ap, 0, ap.Length, 0);
            XlsxBook.cachedAppPropsZ6 = Deflate.Deflate(ap, 6);
            XlsxBook.cachedAppProps = ap;

            byte[] st = XlsxBook.StylesXml().ToBytes();
            XlsxBook.cachedStylesXmlCrc = Crc32.Compute(st, 0, st.Length, 0);
            XlsxBook.cachedStylesXmlZ6 = Deflate.Deflate(st, 6);
            XlsxBook.cachedStylesXml = st;

            byte[] ct1 = XlsxBook.ContentTypes(1).ToBytes();
            XlsxBook.cachedCt1Crc = Crc32.Compute(ct1, 0, ct1.Length, 0);
            XlsxBook.cachedCt1Z6 = Deflate.Deflate(ct1, 6);
            XlsxBook.cachedCt1 = ct1;

            byte[] wr1 = XlsxBook.WorkbookRels(1).ToBytes();
            XlsxBook.cachedWbRels1Crc = Crc32.Compute(wr1, 0, wr1.Length, 0);
            XlsxBook.cachedWbRels1Z6 = Deflate.Deflate(wr1, 6);
            XlsxBook.cachedWbRels1 = wr1;

            XlsxBook.staticPartsReady = true;
        }
    }

    private static ZipEntry PartCachedZ6(string name, byte[] raw, byte[] z6, int crc) {
        return ZipEntry.Precompressed(name, raw, z6, crc, 6);
    }

    // 生成完整 xlsx 字节（zip 包）。输出只由数据决定，可复现。
    public byte[] SaveToBytes() {
        XlsxBook.EnsureStaticParts();
        int sc = sheets.Count;
        List<ZipEntry> entries = new List<ZipEntry>();
        if (sc == 1) {
            entries.Add(XlsxBook.PartCachedZ6("[Content_Types].xml",
                XlsxBook.cachedCt1, XlsxBook.cachedCt1Z6, XlsxBook.cachedCt1Crc));
        } else {
            entries.Add(XlsxBook.Part("[Content_Types].xml",
                XlsxBook.ContentTypes(sc)));
        }
        entries.Add(XlsxBook.PartCachedZ6("_rels/.rels",
            XlsxBook.cachedRootRels, XlsxBook.cachedRootRelsZ6, XlsxBook.cachedRootRelsCrc));
        entries.Add(XlsxBook.PartCachedZ6("docProps/core.xml",
            XlsxBook.cachedCoreProps, XlsxBook.cachedCorePropsZ6, XlsxBook.cachedCorePropsCrc));
        entries.Add(XlsxBook.PartCachedZ6("docProps/app.xml",
            XlsxBook.cachedAppProps, XlsxBook.cachedAppPropsZ6, XlsxBook.cachedAppPropsCrc));
        entries.Add(XlsxBook.Part("xl/workbook.xml",
            XlsxBook.WorkbookXml(sheets)));
        if (sc == 1) {
            entries.Add(XlsxBook.PartCachedZ6("xl/_rels/workbook.xml.rels",
                XlsxBook.cachedWbRels1, XlsxBook.cachedWbRels1Z6, XlsxBook.cachedWbRels1Crc));
        } else {
            entries.Add(XlsxBook.Part("xl/_rels/workbook.xml.rels",
                XlsxBook.WorkbookRels(sc)));
        }
        entries.Add(XlsxBook.PartCachedZ6("xl/styles.xml",
            XlsxBook.cachedStylesXml, XlsxBook.cachedStylesXmlZ6, XlsxBook.cachedStylesXmlCrc));
        for (int i = 0; i < sc; i = i + 1) {
            string part = "xl/worksheets/sheet" + Convert.ToString(i + 1) + ".xml";
            entries.Add(XlsxBook.PartBytes(part, XlsxBook.SheetXmlBytes(sheets[i])));
        }
        return Zip.Create(entries, 6);
    }

    // 写入 .xlsx 文件。路径打不开时抛 <see cref="IOException"/>。
    public void Save(string path) {
        File.WriteAllBytes(path, SaveToBytes());
    }

    // 单张工作表的最大行数（xlsx 格式上限 1048576）。流式写
    // 出超出时自动续接分表；测试/演示可调小以驱动分表路径。
    public static int maxRowsPerSheet = 1048576;

    // 流式写出：工作表内容经 <paramref name="sources"/>（与 sheets
    // 一一对应，缺位的用空源）逐行供给，边生成边压缩落盘，内存
    // 占用与总行数无关。单表超过 <see cref="maxRowsPerSheet"/> 时
    // 自动续接分表（原表名后缀 2、3……去重；表头/冻结窗格留在
    // 第一分表）。数据源的 Cancelled() 返回 true 时中止写盘、
    // 删除半成品并返回 false；路径打不开时抛 IOException。
    // 输出同样不含时间戳，可复现。
    public bool SaveStreaming(string path, List<XlsxRowSource> sources) {
        XlsxBook.EnsureStaticParts();
        int maxRows = XlsxBook.maxRowsPerSheet > 0 ? XlsxBook.maxRowsPerSheet : 1048576;
        ZipWriter zw = ZipWriter.Open(path);
        try {
            // 先写工作表部件（zip 内条目顺序无所谓），收集实际写出
            // 的分表清单，最后按它生成 workbook/rels/content-types。
            List<XlsxSheet> parts = new List<XlsxSheet>();
            int partNo = 0;
            bool cancelled = false;
            for (int i = 0; i < sheets.Count && !cancelled; i = i + 1) {
                XlsxRowSource src = (sources != null && i < sources.Count && sources[i] != null)
                    ? sources[i] : new XlsxRowSource();
                int total = src.RowCount();
                if (total < 0) { total = 0; }
                int done = 0;
                int round = 0;
                while ((done < total || round == 0) && !cancelled) {
                    int n = total - done;
                    if (n > maxRows) { n = maxRows; }
                    XlsxSheet part = sheets[i];
                    if (round > 0) {
                        part = new XlsxSheet(XlsxBook.PartName(sheets, parts, sheets[i].name));
                        part.headerBold = false;
                        part.freezeHeader = false;
                    }
                    parts.Add(part);
                    partNo = partNo + 1;
                    if (!XlsxBook.StreamSheetPart(part, src, done, n, zw, partNo, total)) {
                        cancelled = true;
                    }
                    done = done + n;
                    round = round + 1;
                }
            }
            if (cancelled) {
                zw.Abort();
                return false;
            }
            zw.AddEntry("[Content_Types].xml",
                XlsxBook.ContentTypes(parts.Count).ToBytes(), 6);
            zw.AddEntry("_rels/.rels", XlsxBook.cachedRootRels, 6);
            zw.AddEntry("docProps/core.xml", XlsxBook.cachedCoreProps, 6);
            zw.AddEntry("docProps/app.xml", XlsxBook.cachedAppProps, 6);
            zw.AddEntry("xl/workbook.xml", XlsxBook.WorkbookXml(parts).ToBytes(), 6);
            zw.AddEntry("xl/_rels/workbook.xml.rels",
                XlsxBook.WorkbookRels(parts.Count).ToBytes(), 6);
            zw.AddEntry("xl/styles.xml", XlsxBook.cachedStylesXml, 6);
            zw.Close();
            return true;
        } catch (Exception ex) {
            zw.Abort();
            throw ex;
        }
    }

    // 分表命名：`baseName` 撞上现有表或已写分表时后缀 2、3……（严守 Excel 31 字符上限与 UTF-8 码点边界）。
    static string PartName(List<XlsxSheet> sheets, List<XlsxSheet> parts,
                           string baseName) {
        string clean = baseName != null && baseName.Length > 0 ? baseName : "Sheet";
        string unique = XlsxBook.TruncateUtf8Chars(clean, 31);
        int n = 2;
        while (XlsxBook.IndexOfSheet(sheets, unique) >= 0
               || XlsxBook.IndexOfSheet(parts, unique) >= 0) {
            string suf = Convert.ToString(n);
            int maxBase = 31 - suf.Length;
            unique = XlsxBook.TruncateUtf8Chars(clean, maxBase > 0 ? maxBase : 1) + suf;
            n = n + 1;
        }
        return unique;
    }

    // 将正整数写入 rbuf 末尾，返回写入长度（起始偏移 = 12 - len）。
    private static int FormatPosInt(int v, byte[] rbuf) {
        int p = 12;
        int n = v;
        if (n <= 0) {
            rbuf[11] = 48;
            return 1;
        }
        while (n > 0) {
            int q = n / 10;
            p = p - 1;
            rbuf[p] = (byte)(48 + (n - q * 10));
            n = q;
        }
        return 12 - p;
    }

    // 将任意 64 位整数写入 lbuf 末尾，返回写入长度（起始偏移 = 24 - len）。
    private static int FormatLong(long v, byte[] lbuf) {
        int p = 24;
        if (v == 0L) {
            lbuf[23] = 48;
            return 1;
        }
        bool neg = v < 0L;
        long n = neg ? (0L - v) : v;
        while (n > 0L) {
            long q = n / 10L;
            p = p - 1;
            lbuf[p] = (byte)(48 + (int)(n - q * 10L));
            n = q;
        }
        if (neg) {
            p = p - 1;
            lbuf[p] = 45;
        }
        return 24 - p;
    }

    // 写出一个分表的 worksheet 部件：表头加粗/冻结窗格只在分表
    // 覆盖绝对第 0 行时生效；列宽对区间前 200 行做预扫（FillRow
    // 必须可重入）；行体攒到 32KB 冲一次压缩流。返回 false =
    // 数据源取消/失败。
    static bool StreamSheetPart(XlsxSheet s, XlsxRowSource src, int rowStart,
                                int rows, ZipWriter zw, int partNo, int total) {
        // 工作表占整个工作簿 95% 以上的字节：用 level 1 而不是 6 ——
        // worksheet XML 高度冗余，两档压缩率差 <1%，速度快约 4 倍。
        zw.BeginEntry("xl/worksheets/sheet" + Convert.ToString(partNo) + ".xml", 1);
        StringBuilder sb = new StringBuilder();
        sb.Append("<?xml version=\"1.0\" encoding=\"UTF-8\" standalone=\"yes\"?>");
        sb.Append("<worksheet xmlns=\"http://schemas.openxmlformats.org/spreadsheetml/2006/main\">");
        sb.Append("<sheetViews><sheetView workbookViewId=\"0\">");
        int ySplit = s.freezeHeader ? (s.freezeRows > 0 ? s.freezeRows : 1) : s.freezeRows;
        int xSplit = s.freezeCols;
        if ((xSplit > 0 || ySplit > 0) && rowStart == 0 && rows > 0) {
            string topL = Xlsx.ColRef(xSplit) + Convert.ToString(ySplit + 1);
            string activeP = "bottomLeft";
            if (xSplit > 0 && ySplit > 0) { activeP = "bottomRight"; }
            else if (xSplit > 0) { activeP = "topRight"; }
            sb.Append("<pane");
            if (xSplit > 0) { sb.Append(" xSplit=\""); sb.Append(Convert.ToString(xSplit)); sb.Append("\""); }
            if (ySplit > 0) { sb.Append(" ySplit=\""); sb.Append(Convert.ToString(ySplit)); sb.Append("\""); }
            sb.Append(" topLeftCell=\""); sb.Append(topL);
            sb.Append("\" activePane=\""); sb.Append(activeP); sb.Append("\" state=\"frozen\"/>");
            sb.Append("<selection pane=\""); sb.Append(activeP);
            sb.Append("\" activeCell=\""); sb.Append(topL);
            sb.Append("\" sqref=\""); sb.Append(topL); sb.Append("\"/>");
        }
        sb.Append("</sheetView></sheetViews>");
        int ncols = 0;
        List<int> widths = new List<int>();
        if (s.autoWidth && rows > 0) {
            int preview = rows < 200 ? rows : 200;
            List<XlsxCell> probe = new List<XlsxCell>();
            for (int i = 0; i < preview; i = i + 1) {
                if (src.Cancelled()) { return false; }
                probe.Clear();
                if (!src.FillRow(rowStart + i, probe)) { return false; }
                if (probe.Count > ncols) { ncols = probe.Count; }
                for (int c = 0; c < probe.Count; c = c + 1) {
                    int len = XlsxBook.CellWidth(probe[c]);
                    if (c >= widths.Count) { widths.Add(len); }
                    else if (len > widths[c]) { widths[c] = len; }
                }
            }
            if (ncols > 0) {
                sb.Append("<cols>");
                for (int c = 0; c < ncols; c = c + 1) {
                    int w = c < widths.Count ? widths[c] : 8;
                    w = w + 2;
                    if (w < 10) { w = 10; }
                    if (w > 60) { w = 60; }
                    sb.Append("<col min=\""); sb.Append(Convert.ToString(c + 1));
                    sb.Append("\" max=\""); sb.Append(Convert.ToString(c + 1));
                    sb.Append("\" width=\""); sb.Append(Convert.ToString(w));
                    sb.Append("\" customWidth=\"1\"/>");
                }
                sb.Append("</cols>");
            }
        }
        sb.Append("<sheetData>");
        byte[] pre = sb.ToString().ToBytes();
        zw.WriteData(pre, pre.Length);

        int cap = 40960;
        byte[] buf = new byte[cap];
        nint bp = (nint)buf;
        int pos = 0;
        byte[] rbuf = new byte[12];
        nint rbp = (nint)rbuf;
        byte[] lbuf = new byte[24];
        nint lbp = (nint)lbuf;
        byte[] cbuf = new byte[8];
        List<XlsxCell> row = new List<XlsxCell>();
        int hBoldRows = s.freezeRows > 0 ? s.freezeRows : 1;

        for (int i = 0; i < rows; i = i + 1) {
            if (src.Cancelled()) { return false; }
            row.Clear();
            if (!src.FillRow(rowStart + i, row)) { return false; }
            int abs = rowStart + i;
            int row1 = abs + 1;
            int rLen = XlsxBook.FormatPosInt(row1, rbuf);
            int rOff = 12 - rLen;
            if ((long)pos + 24L > (long)cap) {
                buf = XlsxBook.GrowBuf(buf, pos, 24L, 4096L);
                bp = (nint)buf;
                cap = buf.Length;
            }
            NativeMemory.Copy(bp + (nint)pos, (nint)"<row r=\"", 8);
            pos = pos + 8;
            NativeMemory.Copy(bp + (nint)pos, rbp + (nint)rOff, rLen);
            pos = pos + rLen;
            buf[pos] = 34; buf[pos + 1] = 62; // "\">"
            pos = pos + 2;

            bool bold = s.headerBold && abs < hBoldRows;
            int rCount = row.Count;
            for (int c = 0; c < rCount; c = c + 1) {
                XlsxCell cell = row[c];
                if (cell == null || cell.kind == 0) { continue; }
                int kind = cell.kind;
                if (kind == 1 && (cell.text == null || cell.text.Length == 0)) { continue; }
                string numTxt = null;
                long need = 96L;
                if (kind == 1) { need = 96L + (long)cell.text.Length * 5L; }
                else if (kind == 2 && cell.text != null) {
                    numTxt = XlsxBook.SafeNumXml(cell.text);
                    need = 64L + (long)numTxt.Length;
                }
                if ((long)pos + need > (long)cap) {
                    buf = XlsxBook.GrowBuf(buf, pos, need, 4096L);
                    bp = (nint)buf;
                    cap = buf.Length;
                }
                NativeMemory.Copy(bp + (nint)pos, (nint)"<c r=\"", 6);
                pos = pos + 6;
                if (c < 26) {
                    buf[pos] = (byte)(65 + c);
                    pos = pos + 1;
                } else if (c < 702) {
                    int c2 = c - 26;
                    int q = c2 / 26;
                    buf[pos] = (byte)(65 + q);
                    buf[pos + 1] = (byte)(65 + (c2 - q * 26));
                    pos = pos + 2;
                } else {
                    int cp = 8;
                    int cn = c + 1;
                    while (cn > 0 && cp > 0) {
                        int nm1 = cn - 1;
                        int q = nm1 / 26;
                        cp = cp - 1;
                        cbuf[cp] = (byte)(65 + (nm1 - q * 26));
                        cn = q;
                    }
                    int clen = 8 - cp;
                    NativeMemory.Copy(bp + (nint)pos, (nint)cbuf + (nint)cp, clen);
                    pos = pos + clen;
                }
                NativeMemory.Copy(bp + (nint)pos, rbp + (nint)rOff, rLen);
                pos = pos + rLen;
                buf[pos] = 34; pos = pos + 1;

                int style = (kind == 4 ? 1 : 0) + (bold ? 2 : 0);
                if (style > 0) {
                    NativeMemory.Copy(bp + (nint)pos, (nint)" s=\"", 4);
                    pos = pos + 4;
                    buf[pos] = (byte)(48 + style);
                    buf[pos + 1] = 34;
                    pos = pos + 2;
                }
                if (kind == 1) {
                    string txt = cell.text;
                    int tLen = txt.Length;
                    NativeMemory.Copy(bp + (nint)pos, (nint)" t=\"inlineStr\"><is><t", 21);
                    pos = pos + 21;
                    if ((txt[0] & 255) == 32 || (txt[tLen - 1] & 255) == 32) {
                        NativeMemory.Copy(bp + (nint)pos, (nint)" xml:space=\"preserve\"", 21);
                        pos = pos + 21;
                    }
                    buf[pos] = 62; pos = pos + 1;
                    nint tp = (nint)txt;
                    int seg = 0;
                    for (int k = 0; k < tLen; k = k + 1) {
                        int ch = txt[k] & 255;
                        if (ch == 38 || ch == 60 || ch == 62
                            || (ch < 32 && ch != 9 && ch != 10 && ch != 13)) {
                            if (k > seg) {
                                NativeMemory.Copy(bp + (nint)pos, tp + (nint)seg, k - seg);
                                pos = pos + (k - seg);
                            }
                            if (ch == 38) {
                                NativeMemory.Copy(bp + (nint)pos, (nint)"&amp;", 5);
                                pos = pos + 5;
                            } else if (ch == 60) {
                                NativeMemory.Copy(bp + (nint)pos, (nint)"&lt;", 4);
                                pos = pos + 4;
                            } else if (ch == 62) {
                                NativeMemory.Copy(bp + (nint)pos, (nint)"&gt;", 4);
                                pos = pos + 4;
                            }
                            seg = k + 1;
                        }
                    }
                    if (seg < tLen) {
                        NativeMemory.Copy(bp + (nint)pos, tp + (nint)seg, tLen - seg);
                        pos = pos + (tLen - seg);
                    }
                    NativeMemory.Copy(bp + (nint)pos, (nint)"</t></is></c>", 13);
                    pos = pos + 13;
                } else if (kind == 2) {
                    NativeMemory.Copy(bp + (nint)pos, (nint)"><v>", 4);
                    pos = pos + 4;
                    if (numTxt != null && numTxt.Length > 0) {
                        NativeMemory.Copy(bp + (nint)pos, (nint)numTxt, numTxt.Length);
                        pos = pos + numTxt.Length;
                    }
                    NativeMemory.Copy(bp + (nint)pos, (nint)"</v></c>", 8);
                    pos = pos + 8;
                } else if (kind == 3) {
                    if (cell.flag) {
                        NativeMemory.Copy(bp + (nint)pos, (nint)" t=\"b\"><v>1</v></c>", 19);
                    } else {
                        NativeMemory.Copy(bp + (nint)pos, (nint)" t=\"b\"><v>0</v></c>", 19);
                    }
                    pos = pos + 19;
                } else if (kind == 4) {
                    NativeMemory.Copy(bp + (nint)pos, (nint)"><v>", 4);
                    pos = pos + 4;
                    int dLen = XlsxBook.FormatLong((long)cell.days + 25569L, lbuf);
                    NativeMemory.Copy(bp + (nint)pos, lbp + (nint)(24 - dLen), dLen);
                    pos = pos + dLen;
                    NativeMemory.Copy(bp + (nint)pos, (nint)"</v></c>", 8);
                    pos = pos + 8;
                }
            }

            if ((long)pos + 8L > (long)cap) {
                buf = XlsxBook.GrowBuf(buf, pos, 8L, 1024L);
                bp = (nint)buf;
                cap = buf.Length;
            }
            NativeMemory.Copy(bp + (nint)pos, (nint)"</row>", 6);
            pos = pos + 6;

            if (pos >= 32768) {
                zw.WriteData(buf, pos);
                pos = 0;
            }
            if ((abs & 511) == 511) {
                src.OnProgress(abs + 1, total);
            }
        }
        if (pos > 0) {
            zw.WriteData(buf, pos);
        }
        if (rows > 0) {
            src.OnProgress(rowStart + rows, total);
        }
        StringBuilder tailSb = new StringBuilder();
        tailSb.Append("</sheetData>");
        if (s.mergeCells != null && s.mergeCells.Count > 0) {
            tailSb.Append("<mergeCells count=\"");
            tailSb.Append(Convert.ToString(s.mergeCells.Count));
            tailSb.Append("\">");
            for (int mi = 0; mi < s.mergeCells.Count; mi = mi + 1) {
                string mr = s.mergeCells[mi];
                tailSb.Append("<mergeCell ref=\"");
                tailSb.Append(Xlsx.EscAttr(mr != null ? mr : ""));
                tailSb.Append("\"/>");
            }
            tailSb.Append("</mergeCells>");
        }
        tailSb.Append("</worksheet>");
        byte[] tail = tailSb.ToString().ToBytes();
        zw.WriteData(tail, tail.Length);
        zw.EndEntry();
        return true;
    }

    // 以 (部件名, XML 文本) 组装一个 zip 条目。
    private static ZipEntry Part(string name, string xml) {
        ZipEntry e = new ZipEntry(name);
        e.data = xml.ToBytes();
        return e;
    }

    // 以 (部件名, 字节数组) 组装一个 zip 条目，免多余字符串转换。
    private static ZipEntry PartBytes(string name, byte[] data) {
        ZipEntry e = new ZipEntry(name);
        e.data = data;
        return e;
    }

    // 表名在清单中的下标，不存在时为 -1。
    private static int IndexOfSheet(List<XlsxSheet> sheets, string name) {
        for (int i = 0; i < sheets.Count; i = i + 1) {
            if (sheets[i].name == name) { return i; }
        }
        return 0 - 1;
    }

    // ---------- OPC 部件 ----------

    // [Content_Types].xml：声明各部件的内容类型。
    private static string ContentTypes(int sheetCount) {
        StringBuilder sb = new StringBuilder();
        sb.Append("<?xml version=\"1.0\" encoding=\"UTF-8\" standalone=\"yes\"?>");
        sb.Append("<Types xmlns=\"http://schemas.openxmlformats.org/package/2006/content-types\">");
        sb.Append("<Default Extension=\"rels\" ContentType=\"application/vnd.openxmlformats-package.relationships+xml\"/>");
        sb.Append("<Default Extension=\"xml\" ContentType=\"application/xml\"/>");
        sb.Append("<Override PartName=\"/xl/workbook.xml\" ContentType=\"application/vnd.openxmlformats-officedocument.spreadsheetml.sheet.main+xml\"/>");
        for (int i = 1; i <= sheetCount; i = i + 1) {
            sb.Append("<Override PartName=\"/xl/worksheets/sheet");
            sb.Append(Convert.ToString(i));
            sb.Append(".xml\" ContentType=\"application/vnd.openxmlformats-officedocument.spreadsheetml.worksheet+xml\"/>");
        }
        sb.Append("<Override PartName=\"/xl/styles.xml\" ContentType=\"application/vnd.openxmlformats-officedocument.spreadsheetml.styles+xml\"/>");
        sb.Append("<Override PartName=\"/docProps/core.xml\" ContentType=\"application/vnd.openxmlformats-package.core-properties+xml\"/>");
        sb.Append("<Override PartName=\"/docProps/app.xml\" ContentType=\"application/vnd.openxmlformats-officedocument.extended-properties+xml\"/>");
        sb.Append("</Types>");
        return sb.ToString();
    }

    // 包级关系：workbook 与两个 docProps 部件。
    private static string RootRels() {
        return "<?xml version=\"1.0\" encoding=\"UTF-8\" standalone=\"yes\"?>"
            + "<Relationships xmlns=\"http://schemas.openxmlformats.org/package/2006/relationships\">"
            + "<Relationship Id=\"rId1\" Type=\"http://schemas.openxmlformats.org/officeDocument/2006/relationships/officeDocument\" Target=\"xl/workbook.xml\"/>"
            + "<Relationship Id=\"rId2\" Type=\"http://schemas.openxmlformats.org/package/2006/relationships/metadata/core-properties\" Target=\"docProps/core.xml\"/>"
            + "<Relationship Id=\"rId3\" Type=\"http://schemas.openxmlformats.org/officeDocument/2006/relationships/extended-properties\" Target=\"docProps/app.xml\"/>"
            + "</Relationships>";
    }

    // 核心属性（创建者）；不写时间戳以保持输出可复现。
    private static string CoreProps() {
        return "<?xml version=\"1.0\" encoding=\"UTF-8\" standalone=\"yes\"?>"
            + "<cp:coreProperties xmlns:cp=\"http://schemas.openxmlformats.org/package/2006/metadata/core-properties\" xmlns:dc=\"http://purl.org/dc/elements/1.1/\">"
            + "<dc:creator>Zan</dc:creator>"
            + "</cp:coreProperties>";
    }

    // 应用属性（生成程序名）。
    private static string AppProps() {
        return "<?xml version=\"1.0\" encoding=\"UTF-8\" standalone=\"yes\"?>"
            + "<Properties xmlns=\"http://schemas.openxmlformats.org/officeDocument/2006/extended-properties\">"
            + "<Application>Zan</Application>"
            + "</Properties>";
    }

    // workbook.xml：表名与 sheetId/rId 清单。
    private static string WorkbookXml(List<XlsxSheet> sheets) {
        StringBuilder sb = new StringBuilder();
        sb.Append("<?xml version=\"1.0\" encoding=\"UTF-8\" standalone=\"yes\"?>");
        sb.Append("<workbook xmlns=\"http://schemas.openxmlformats.org/spreadsheetml/2006/main\" xmlns:r=\"http://schemas.openxmlformats.org/officeDocument/2006/relationships\"><sheets>");
        for (int i = 0; i < sheets.Count; i = i + 1) {
            sb.Append("<sheet name=\""); sb.Append(Xlsx.EscAttr(sheets[i].name));
            sb.Append("\" sheetId=\""); sb.Append(Convert.ToString(i + 1));
            sb.Append("\" r:id=\"rId"); sb.Append(Convert.ToString(i + 1));
            sb.Append("\"/>");
        }
        sb.Append("</sheets></workbook>");
        return sb.ToString();
    }

    // workbook 的关系：每张表一个 rId，最后一个是 styles。
    private static string WorkbookRels(int sheetCount) {
        StringBuilder sb = new StringBuilder();
        sb.Append("<?xml version=\"1.0\" encoding=\"UTF-8\" standalone=\"yes\"?>");
        sb.Append("<Relationships xmlns=\"http://schemas.openxmlformats.org/package/2006/relationships\">");
        for (int i = 1; i <= sheetCount; i = i + 1) {
            sb.Append("<Relationship Id=\"rId"); sb.Append(Convert.ToString(i));
            sb.Append("\" Type=\"http://schemas.openxmlformats.org/officeDocument/2006/relationships/worksheet\" Target=\"worksheets/sheet");
            sb.Append(Convert.ToString(i));
            sb.Append(".xml\"/>");
        }
        sb.Append("<Relationship Id=\"rId"); sb.Append(Convert.ToString(sheetCount + 1));
        sb.Append("\" Type=\"http://schemas.openxmlformats.org/officeDocument/2006/relationships/styles\" Target=\"styles.xml\"/>");
        sb.Append("</Relationships>");
        return sb.ToString();
    }

    // 样式表：s=0 默认，s=1 日期（numFmt 164 = yyyy-mm-dd），
    // s=2 表头加粗，s=3 日期 + 加粗。numFmts 必须在 fonts 之前
    // （schema 顺序），Excel 才认。
    private static string StylesXml() {
        return "<?xml version=\"1.0\" encoding=\"UTF-8\" standalone=\"yes\"?>"
            + "<styleSheet xmlns=\"http://schemas.openxmlformats.org/spreadsheetml/2006/main\">"
            + "<numFmts count=\"1\"><numFmt numFmtId=\"164\" formatCode=\"yyyy\\-mm\\-dd\"/></numFmts>"
            + "<fonts count=\"2\"><font><sz val=\"11\"/><name val=\"Calibri\"/></font><font><b/><sz val=\"11\"/><name val=\"Calibri\"/></font></fonts>"
            + "<fills count=\"2\"><fill><patternFill patternType=\"none\"/></fill><fill><patternFill patternType=\"gray125\"/></fill></fills>"
            + "<borders count=\"1\"><border><left/><right/><top/><bottom/><diagonal/></border></borders>"
            + "<cellStyleXfs count=\"1\"><xf numFmtId=\"0\" fontId=\"0\" fillId=\"0\" borderId=\"0\"/></cellStyleXfs>"
            + "<cellXfs count=\"4\">"
            + "<xf numFmtId=\"0\" fontId=\"0\" fillId=\"0\" borderId=\"0\" xfId=\"0\"/>"
            + "<xf numFmtId=\"164\" fontId=\"0\" fillId=\"0\" borderId=\"0\" xfId=\"0\" applyNumberFormat=\"1\"/>"
            + "<xf numFmtId=\"0\" fontId=\"1\" fillId=\"0\" borderId=\"0\" xfId=\"0\" applyFont=\"1\"/>"
            + "<xf numFmtId=\"164\" fontId=\"1\" fillId=\"0\" borderId=\"0\" xfId=\"0\" applyNumberFormat=\"1\" applyFont=\"1\"/>"
            + "</cellXfs>"
            + "<cellStyles count=\"1\"><cellStyle name=\"Normal\" xfId=\"0\" builtinId=\"0\"/></cellStyles>"
            + "</styleSheet>";
    }

    // 单张工作表的完整 worksheet UTF-8 字节（单遍融合列宽采集与 XML 直写，消除二次单元格遍历）。
    private static byte[] SheetXmlBytes(XlsxSheet s) {
        int rowCount = (s != null && s.rows != null) ? s.rows.Count : 0;
        int colEst = (s != null && s.maxCols > 0) ? s.maxCols : 4;
        long capL = 1024L + (long)rowCount * ((long)colEst * 44L + 28L);
        if (capL < 2048L) { capL = 2048L; }
        if (capL > 16777216L) { capL = 16777216L; }
        int cap = (int)capL;
        byte[] buf = new byte[cap];
        nint bp = (nint)buf;
        int pos = 0;

        byte[] rbuf = new byte[12];
        byte[] lbuf = new byte[24];
        byte[] cbuf = new byte[8];

        bool trackWidths = s != null && s.autoWidth && s.maxCols > 0;
        int mc = trackWidths ? s.maxCols : 0;
        int[] widths = trackWidths ? new int[mc] : null;
        if (trackWidths) {
            for (int c = 0; c < mc; c = c + 1) { widths[c] = 8; }
        }
        int widthLimit = rowCount > 200 ? 200 : rowCount;

        // 先单遍写入 <sheetData>...</sheetData> 并同步收集前 200 行列宽，最后拼装头部。
        NativeMemory.Copy(bp, (nint)"<sheetData>", 11);
        pos = 11;

        string sInlineHead = " t=\"inlineStr\"><is><t";
        nint pInlineHead = (nint)sInlineHead;
        string sPreserve = " xml:space=\"preserve\"";
        nint pPreserve = (nint)sPreserve;
        string sInlineTail = "</t></is></c>";
        nint pInlineTail = (nint)sInlineTail;
        string sBool1 = " t=\"b\"><v>1</v></c>";
        nint pBool1 = (nint)sBool1;
        string sBool0 = " t=\"b\"><v>0</v></c>";
        nint pBool0 = (nint)sBool0;

        int hBoldRows2 = (s != null && s.freezeRows > 0) ? s.freezeRows : 1;
        for (int r = 0; r < rowCount; r = r + 1) {
            List<XlsxCell> row = s.rows[r];
            bool doW = trackWidths && r < widthLimit;
            int rLen = 0;
            int rOff = 12;
            int rn = r + 1;
            while (rn > 0) {
                int rq = rn / 10;
                rOff = rOff - 1;
                rbuf[rOff] = (byte)(48 + (rn - rq * 10));
                rn = rq;
                rLen = rLen + 1;
            }
            if ((long)pos + 24L > (long)cap) {
                buf = XlsxBook.GrowBuf(buf, pos, 24L, 4096L);
                bp = (nint)buf;
                cap = buf.Length;
            }
            buf[pos] = 60; buf[pos + 1] = 114; buf[pos + 2] = 111; buf[pos + 3] = 119;
            buf[pos + 4] = 32; buf[pos + 5] = 114; buf[pos + 6] = 61; buf[pos + 7] = 34;
            pos = pos + 8;
            for (int di = 0; di < rLen; di = di + 1) { buf[pos + di] = rbuf[rOff + di]; }
            pos = pos + rLen;
            buf[pos] = 34; buf[pos + 1] = 62;
            pos = pos + 2;

            bool bold = s.headerBold && r < hBoldRows2;
            int rCount = row != null ? row.Count : 0;
            for (int c = 0; c < rCount; c = c + 1) {
                XlsxCell cell = row[c];
                if (cell == null) { continue; }
                int kind = cell.kind;
                if (kind == 0) { continue; }
                if (doW && c < mc) {
                    int wlen = 8;
                    if (kind == 1) {
                        if (cell.text != null) { wlen = Xlsx.WideLen(cell.text); }
                    } else if (kind == 2) {
                        wlen = cell.text != null ? (cell.text.Length + 1) : 1;
                    } else if (kind == 4) {
                        wlen = 10;
                    }
                    if (wlen > widths[c]) { widths[c] = wlen; }
                }
                if (kind == 1 && (cell.text == null || cell.text.Length == 0)) { continue; }
                string numTxt = null;
                long need = 96L;
                if (kind == 1) { need = 96L + (long)cell.text.Length * 5L; }
                else if (kind == 2 && cell.text != null) {
                    numTxt = XlsxBook.SafeNumXml(cell.text);
                    need = 64L + (long)numTxt.Length;
                }
                if ((long)pos + need > (long)cap) {
                    buf = XlsxBook.GrowBuf(buf, pos, need, 4096L);
                    bp = (nint)buf;
                    cap = buf.Length;
                }
                buf[pos] = 60; buf[pos + 1] = 99; buf[pos + 2] = 32;
                buf[pos + 3] = 114; buf[pos + 4] = 61; buf[pos + 5] = 34;
                pos = pos + 6;
                if (c < 26) {
                    buf[pos] = (byte)(65 + c);
                    pos = pos + 1;
                } else if (c < 702) {
                    int c2 = c - 26;
                    int q = c2 / 26;
                    buf[pos] = (byte)(65 + q);
                    buf[pos + 1] = (byte)(65 + (c2 - q * 26));
                    pos = pos + 2;
                } else {
                    int cp = 8;
                    int cn = c + 1;
                    while (cn > 0 && cp > 0) {
                        int nm1 = cn - 1;
                        int q = nm1 / 26;
                        cp = cp - 1;
                        cbuf[cp] = (byte)(65 + (nm1 - q * 26));
                        cn = q;
                    }
                    int clen = 8 - cp;
                    for (int di = 0; di < clen; di = di + 1) { buf[pos + di] = cbuf[cp + di]; }
                    pos = pos + clen;
                }
                for (int di = 0; di < rLen; di = di + 1) { buf[pos + di] = rbuf[rOff + di]; }
                pos = pos + rLen;
                buf[pos] = 34; pos = pos + 1;

                int style = (kind == 4 ? 1 : 0) + (bold ? 2 : 0);
                if (style > 0) {
                    buf[pos] = 32; buf[pos + 1] = 115; buf[pos + 2] = 61;
                    buf[pos + 3] = 34; buf[pos + 4] = (byte)(48 + style); buf[pos + 5] = 34;
                    pos = pos + 6;
                }
                if (kind == 1) {
                    string txt = cell.text;
                    int tLen = txt.Length;
                    NativeMemory.Copy(bp + (nint)pos, pInlineHead, 21);
                    pos = pos + 21;
                    if ((txt[0] & 255) == 32 || (txt[tLen - 1] & 255) == 32) {
                        NativeMemory.Copy(bp + (nint)pos, pPreserve, 21);
                        pos = pos + 21;
                    }
                    buf[pos] = 62; pos = pos + 1;
                    for (int k = 0; k < tLen; k = k + 1) {
                        int ch = txt[k] & 255;
                        if (ch > 62) {
                            buf[pos] = (byte)ch;
                            pos = pos + 1;
                        } else if (ch >= 32 && ch != 38 && ch != 60 && ch != 62) {
                            buf[pos] = (byte)ch;
                            pos = pos + 1;
                        } else if (ch == 38) {
                            buf[pos] = 38; buf[pos + 1] = 97; buf[pos + 2] = 109; buf[pos + 3] = 112; buf[pos + 4] = 59;
                            pos = pos + 5;
                        } else if (ch == 60) {
                            buf[pos] = 38; buf[pos + 1] = 108; buf[pos + 2] = 116; buf[pos + 3] = 59;
                            pos = pos + 4;
                        } else if (ch == 62) {
                            buf[pos] = 38; buf[pos + 1] = 103; buf[pos + 2] = 116; buf[pos + 3] = 59;
                            pos = pos + 4;
                        } else if (ch == 9 || ch == 10 || ch == 13) {
                            buf[pos] = (byte)ch;
                            pos = pos + 1;
                        }
                    }
                    NativeMemory.Copy(bp + (nint)pos, pInlineTail, 13);
                    pos = pos + 13;
                } else if (kind == 2) {
                    buf[pos] = 62; buf[pos + 1] = 60; buf[pos + 2] = 118; buf[pos + 3] = 62;
                    pos = pos + 4;
                    if (numTxt != null && numTxt.Length > 0) {
                        int tLen = numTxt.Length;
                        NativeMemory.Copy(bp + (nint)pos, (nint)numTxt, tLen);
                        pos = pos + tLen;
                    }
                    buf[pos] = 60; buf[pos + 1] = 47; buf[pos + 2] = 118; buf[pos + 3] = 62;
                    buf[pos + 4] = 60; buf[pos + 5] = 47; buf[pos + 6] = 99; buf[pos + 7] = 62;
                    pos = pos + 8;
                } else if (kind == 3) {
                    NativeMemory.Copy(bp + (nint)pos, cell.flag ? pBool1 : pBool0, 19);
                    pos = pos + 19;
                } else if (kind == 4) {
                    buf[pos] = 62; buf[pos + 1] = 60; buf[pos + 2] = 118; buf[pos + 3] = 62;
                    pos = pos + 4;
                    long dv = (long)cell.days + 25569L;
                    int dp = 24;
                    if (dv == 0L) {
                        buf[pos] = 48; pos = pos + 1;
                    } else {
                        bool neg = dv < 0L;
                        long vn = neg ? (0L - dv) : dv;
                        while (vn > 0L) {
                            long q = vn / 10L;
                            dp = dp - 1;
                            lbuf[dp] = (byte)(48 + (int)(vn - q * 10L));
                            vn = q;
                        }
                        if (neg) {
                            dp = dp - 1;
                            lbuf[dp] = 45;
                        }
                        int dLen = 24 - dp;
                        for (int di = 0; di < dLen; di = di + 1) { buf[pos + di] = lbuf[dp + di]; }
                        pos = pos + dLen;
                    }
                    buf[pos] = 60; buf[pos + 1] = 47; buf[pos + 2] = 118; buf[pos + 3] = 62;
                    buf[pos + 4] = 60; buf[pos + 5] = 47; buf[pos + 6] = 99; buf[pos + 7] = 62;
                    pos = pos + 8;
                }
            }

            if ((long)pos + 8L > (long)cap) {
                buf = XlsxBook.GrowBuf(buf, pos, 8L, 1024L);
                bp = (nint)buf;
                cap = buf.Length;
            }
            buf[pos] = 60; buf[pos + 1] = 47; buf[pos + 2] = 114;
            buf[pos + 3] = 111; buf[pos + 4] = 119; buf[pos + 5] = 62;
            pos = pos + 6;
        }

        long tailNeed = 64L;
        if (s != null && s.mergeCells != null && s.mergeCells.Count > 0) {
            tailNeed = tailNeed + 64L + (long)s.mergeCells.Count * 40L;
        }
        if ((long)pos + tailNeed > (long)cap) {
            buf = XlsxBook.GrowBuf(buf, pos, tailNeed, 256L);
            bp = (nint)buf;
            cap = buf.Length;
        }
        NativeMemory.Copy(bp + (nint)pos, (nint)"</sheetData>", 12);
        pos = pos + 12;
        if (s != null && s.mergeCells != null && s.mergeCells.Count > 0) {
            NativeMemory.Copy(bp + (nint)pos, (nint)"<mergeCells count=\"", 19);
            pos = pos + 19;
            int mLen = XlsxBook.FormatPosInt(s.mergeCells.Count, rbuf);
            int mOff = 12 - mLen;
            for (int di = 0; di < mLen; di = di + 1) { buf[pos + di] = rbuf[mOff + di]; }
            pos = pos + mLen;
            buf[pos] = 34; buf[pos + 1] = 62;
            pos = pos + 2;
            for (int mi = 0; mi < s.mergeCells.Count; mi = mi + 1) {
                string rawMr = s.mergeCells[mi];
                string mr = Xlsx.EscAttr(rawMr != null ? rawMr : "");
                if ((long)pos + 24L + (long)mr.Length > (long)cap) {
                    buf = XlsxBook.GrowBuf(buf, pos, 24L + (long)mr.Length, 256L);
                    bp = (nint)buf;
                    cap = buf.Length;
                }
                NativeMemory.Copy(bp + (nint)pos, (nint)"<mergeCell ref=\"", 16);
                pos = pos + 16;
                if (mr.Length > 0) {
                    NativeMemory.Copy(bp + (nint)pos, (nint)mr, mr.Length);
                    pos = pos + mr.Length;
                }
                buf[pos] = 34; buf[pos + 1] = 47; buf[pos + 2] = 62;
                pos = pos + 3;
            }
            if ((long)pos + 32L > (long)cap) {
                buf = XlsxBook.GrowBuf(buf, pos, 32L, 64L);
                bp = (nint)buf;
                cap = buf.Length;
            }
            NativeMemory.Copy(bp + (nint)pos, (nint)"</mergeCells>", 13);
            pos = pos + 13;
        }
        NativeMemory.Copy(bp + (nint)pos, (nint)"</worksheet>", 12);
        pos = pos + 12;

        // 拼装头部（<?xml ...><sheetViews>...<cols>...</cols>）并与 body 一次合成最终字节数组。
        long headCapL = 512L + (long)mc * 80L;
        if (headCapL > 2147483591L) {
            throw new IOException("XlsxBook: worksheet header exceeds maximum buffer size");
        }
        int headCap = (int)headCapL;
        byte[] hbuf = new byte[headCap];
        nint hbp = (nint)hbuf;
        int hpos = 0;
        string head = "<?xml version=\"1.0\" encoding=\"UTF-8\" standalone=\"yes\"?><worksheet xmlns=\"http://schemas.openxmlformats.org/spreadsheetml/2006/main\"><sheetViews><sheetView workbookViewId=\"0\">";
        NativeMemory.Copy(hbp, (nint)head, head.Length);
        hpos = head.Length;

        int ySplit2 = s != null ? (s.freezeHeader ? (s.freezeRows > 0 ? s.freezeRows : 1) : s.freezeRows) : 0;
        int xSplit2 = s != null ? s.freezeCols : 0;
        if ((xSplit2 > 0 || ySplit2 > 0) && rowCount > 0) {
            string topL2 = Xlsx.ColRef(xSplit2) + Convert.ToString(ySplit2 + 1);
            string activeP2 = "bottomLeft";
            if (xSplit2 > 0 && ySplit2 > 0) { activeP2 = "bottomRight"; }
            else if (xSplit2 > 0) { activeP2 = "topRight"; }
            string pane = "<pane";
            if (xSplit2 > 0) { pane = pane + " xSplit=\"" + Convert.ToString(xSplit2) + "\""; }
            if (ySplit2 > 0) { pane = pane + " ySplit=\"" + Convert.ToString(ySplit2) + "\""; }
            pane = pane + " topLeftCell=\"" + topL2 + "\" activePane=\"" + activeP2
                + "\" state=\"frozen\"/><selection pane=\"" + activeP2
                + "\" activeCell=\"" + topL2 + "\" sqref=\"" + topL2 + "\"/>";
            if ((long)hpos + (long)pane.Length + 64L > (long)headCap) {
                hbuf = XlsxBook.GrowBuf(hbuf, hpos, (long)pane.Length + 64L, 256L);
                hbp = (nint)hbuf;
                headCap = hbuf.Length;
            }
            NativeMemory.Copy(hbp + (nint)hpos, (nint)pane, pane.Length);
            hpos = hpos + pane.Length;
        }
        NativeMemory.Copy(hbp + (nint)hpos, (nint)"</sheetView></sheetViews>", 25);
        hpos = hpos + 25;

        if (trackWidths) {
            if ((long)hpos + (long)mc * 80L + 32L > (long)headCap) {
                hbuf = XlsxBook.GrowBuf(hbuf, hpos, (long)mc * 80L + 32L, 256L);
                hbp = (nint)hbuf;
                headCap = hbuf.Length;
            }
            hbuf[hpos] = 60; hbuf[hpos + 1] = 99; hbuf[hpos + 2] = 111; hbuf[hpos + 3] = 108; hbuf[hpos + 4] = 115; hbuf[hpos + 5] = 62;
            hpos = hpos + 6;
            for (int c = 0; c < mc; c = c + 1) {
                int w = widths[c] + 2;
                if (w < 10) { w = 10; }
                if (w > 60) { w = 60; }
                int cLen = XlsxBook.FormatPosInt(c + 1, rbuf);
                int cOff = 12 - cLen;
                NativeMemory.Copy(hbp + (nint)hpos, (nint)"<col min=\"", 10);
                hpos = hpos + 10;
                for (int di = 0; di < cLen; di = di + 1) { hbuf[hpos + di] = rbuf[cOff + di]; }
                hpos = hpos + cLen;
                NativeMemory.Copy(hbp + (nint)hpos, (nint)"\" max=\"", 7);
                hpos = hpos + 7;
                for (int di = 0; di < cLen; di = di + 1) { hbuf[hpos + di] = rbuf[cOff + di]; }
                hpos = hpos + cLen;
                NativeMemory.Copy(hbp + (nint)hpos, (nint)"\" width=\"", 9);
                hpos = hpos + 9;
                int wLen = XlsxBook.FormatPosInt(w, rbuf);
                int wOff = 12 - wLen;
                for (int di = 0; di < wLen; di = di + 1) { hbuf[hpos + di] = rbuf[wOff + di]; }
                hpos = hpos + wLen;
                NativeMemory.Copy(hbp + (nint)hpos, (nint)"\" customWidth=\"1\"/>", 19);
                hpos = hpos + 19;
            }
            hbuf[hpos] = 60; hbuf[hpos + 1] = 47; hbuf[hpos + 2] = 99; hbuf[hpos + 3] = 111; hbuf[hpos + 4] = 108; hbuf[hpos + 5] = 115; hbuf[hpos + 6] = 62;
            hpos = hpos + 7;
        }

        long finalLen = (long)hpos + (long)pos;
        if (finalLen > 2147483591L) {
            throw new IOException("XlsxBook: worksheet XML exceeds maximum buffer size");
        }
        byte[] result = new byte[(int)finalLen];
        nint resPtr = (nint)result;
        NativeMemory.Copy(resPtr, hbp, hpos);
        NativeMemory.Copy(resPtr + (nint)hpos, bp, pos);
        return result;
    }

    // 兼容辅助：供外部或单格场景按 StringBuilder 追加单元格。
    static void AppendCellXml(StringBuilder sb, XlsxCell cell, int row1,
                              int col, bool bold) {
        if (sb == null || cell == null || cell.kind == 0) { return; }
        if (cell.kind == 1 && (cell.text == null || cell.text.Length == 0)) { return; }
        sb.Append("<c r=\"");
        sb.Append(Xlsx.ColRef(col));
        sb.Append(Convert.ToString(row1));
        sb.Append("\"");
        int style = 0;
        if (cell.kind == 4) { style = 1; }
        if (bold) { style = style + 2; }
        if (style > 0) {
            sb.Append(" s=\"");
            sb.Append(Convert.ToString(style));
            sb.Append("\"");
        }
        if (cell.kind == 1) {
            sb.Append(" t=\"inlineStr\"><is><t");
            if ((int)(cell.text[0] & 255) == 32
                || (int)(cell.text[cell.text.Length - 1] & 255) == 32) {
                sb.Append(" xml:space=\"preserve\"");
            }
            sb.Append(">");
            sb.Append(Xlsx.Esc(cell.text));
            sb.Append("</t></is></c>");
        } else if (cell.kind == 2) {
            sb.Append("><v>");
            sb.Append(XlsxBook.SafeNumXml(cell.text));
            sb.Append("</v></c>");
        } else if (cell.kind == 3) {
            sb.Append(" t=\"b\"><v>");
            if (cell.flag) { sb.Append("1"); } else { sb.Append("0"); }
            sb.Append("</v></c>");
        } else if (cell.kind == 4) {
            // Excel 1900 日期制：1970-01-01 = 序列 25569。
            sb.Append("><v>");
            sb.Append(Convert.ToString((long)cell.days + 25569));
            sb.Append("</v></c>");
        }
    }

    // 单格的列宽贡献值（8 兜底；文本按显示宽、数字 +1、日期 10）。
    static int CellWidth(XlsxCell cell) {
        if (cell == null || cell.kind == 0) { return 8; }
        if (cell.kind == 1) { return cell.text != null ? Xlsx.WideLen(cell.text) : 8; }
        if (cell.kind == 2) { return cell.text != null ? (cell.text.Length + 1) : 1; }
        if (cell.kind == 4) { return 10; }
        return 8;
    }

    // 列宽估算：内容显示宽度 + 2 的余量，夹在 [10, 60]。
    // 只扫前 200 行——宽度是观感问题，不值得为十万行扫描。
    static int ColWidth(XlsxSheet s, int col) {
        if (s == null || s.rows == null) { return 10; }
        int w = 8;
        int limit = s.rows.Count;
        if (limit > 200) { limit = 200; }
        for (int r = 0; r < limit; r = r + 1) {
            List<XlsxCell> row = s.rows[r];
            if (row == null || col >= row.Count) { continue; }
            int len = XlsxBook.CellWidth(row[col]);
            if (len > w) { w = len; }
        }
        w = w + 2;
        if (w < 10) { w = 10; }
        if (w > 60) { w = 60; }
        return w;
    }
}
