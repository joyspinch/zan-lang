using System;
using System.IO;
using System.Text;
using System.IO.Compression;
namespace System.Data.Excel;

public class XlsxSheet {
    public string name;
    // 首行按表头处理：加粗。默认 true。
    public bool headerBold;
    // 冻结首行（Excel 的冻结窗格）。默认 true。
    public bool freezeHeader;
    // 冻结左侧列数（0 表示不冻结列）。默认 0。
    public int freezeCols;
    // 冻结首部行数。默认 1。
    public int freezeRows;
    // 按内容估算列宽（前 200 行）。默认 true。
    public bool autoWidth;
    // 单元格合并区域列表，例如 "A1:C1", "B2:B5"
    public List<string> mergeCells;
    public List<List<XlsxCell>> rows;
    public int maxCols;

    // 构造；经 <see cref="XlsxBook.AddSheet"/> 创建。
    public XlsxSheet(string name) {
        this.name = name;
        this.headerBold = true;
        this.freezeHeader = true;
        this.freezeCols = 0;
        this.freezeRows = 1;
        this.autoWidth = true;
        this.mergeCells = new List<string>();
        this.rows = new List<List<XlsxCell>>();
        this.maxCols = 0;
    }

    // 添加合并区域（OpenXML 规范，例如 "A1:B1", "C2:C5"）
    public void AddMerge(string rangeRef) {
        if (rangeRef != null && rangeRef.Length > 0) {
            this.mergeCells.Add(rangeRef);
        }
    }

    // 追加一行。行内单元格数可以少于其他行。
    public void AddRow(List<XlsxCell> cells) {
        rows.Add(cells);
        if (cells.Count > maxCols) { maxCols = cells.Count; }
    }

    // 写入指定单元格，行/列自动扩展；中间缺位补空单元格。
    public void SetCell(int row, int col, XlsxCell v) {
        while (rows.Count <= row) { rows.Add(new List<XlsxCell>()); }
        List<XlsxCell> r = rows[row];
        while (r.Count <= col) { r.Add(new XlsxCell()); }
        r[col] = v;
        if (col + 1 > maxCols) { maxCols = col + 1; }
    }

    // 行数。
    public int RowCount() { return rows.Count; }
}

// 流式写出的行供给源：<see cref="XlsxBook.SaveStreaming"/> 按需调
// <see cref="FillRow"/> 取行。行号从 0 起，第 0 行约定为表头（若
// 有）。FillRow 把第 `index` 行填进 `row`（先 Clear，行内单元格数
// 可参差）并返回 true；返回 false 视为数据失败、中止导出。数据源
// 必须可重入——列宽估算会对每个分表的前 200 行重新预扫一遍。
// 所有回调都在写出线程上发生；GUI 程序请用 App.Post 把进度切回
// UI 线程再改控件。
