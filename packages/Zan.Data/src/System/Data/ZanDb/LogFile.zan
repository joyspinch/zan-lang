using System;
using System.IO;

namespace System.Data.ZanDb;

/// <summary>重放回调：完整载荷校验且应用成功才返回 true；false 拒绝
/// 打开并保留日志原样。缓冲归 LogFile 所有，访客不得 Free。</summary>
delegate bool LogFrameVisitor(ByteBuffer payload);

/// <summary>
/// 追加日志：小端 u32 payloadLen + u32 crc32(payload) + payload。
/// 每个事务占一个 CRC 帧。内存缓冲由 Flush 定位追加，Sync 强制落盘。
/// Replay 只修复撕裂尾部；读取错误或 CRC 有效但载荷非法均失败关闭。
/// </summary>
class LogFile {
    static int HEADER_LEN = 8;
    static long MAX_FRAME = 67108864;

    PageFile file;
    string path;
    ByteBuffer pending;
    long logicalEnd;
    string lastError;

    LogFile() {
        this.path = "";
        this.logicalEnd = 0;
        this.lastError = "";
        this.pending = ByteBuffer.Alloc(256);
    }

    /// 打开日志；Store 必须先持有稳定的旁路锁，再调用此方法。
    static LogFile Open(string filePath) {
        LogFile lf = new LogFile();
        lf.path = filePath;
        lf.file = PageFile.Open(filePath);
        if (!lf.file.IsOpen()) {
            lf.lastError = lf.file.GetError();
            lf.Close(false);
            return lf;
        }
        long size = lf.file.Size();
        if (size < 0) {
            lf.lastError = lf.file.GetError();
            lf.Close(false);
            return lf;
        }
        lf.logicalEnd = size;
        return lf;
    }

    bool IsOpen() {
        return this.lastError == "" && this.file != null && this.file.IsOpen()
            && this.pending != null;
    }

    string GetError() { return this.lastError; }
    string FilePath() { return this.path; }

    /// 逻辑大小；关闭或失败时为 -1，不能把错误当成空日志。
    long Size() { return this.IsOpen() ? this.logicalEnd + this.pending.Length() : -1; }
    int PendingBytes() { return this.pending != null ? this.pending.Length() : 0; }

    bool Ready() {
        if (this.IsOpen()) { return true; }
        if (this.lastError == "") { this.lastError = "log is closed"; }
        return false;
    }

    /// 追加完整 CRC 帧到缓冲；载荷上限在任何缓冲修改之前检查。
    bool AppendFrame(ByteBuffer payload) {
        if (!this.Ready()) { return false; }
        int plen = payload.Length();
        if (plen <= 0 || plen > LogFile.MAX_FRAME
                || (long)this.pending.Length() + LogFile.HEADER_LEN + plen > 2147483647) {
            this.lastError = "log frame exceeds bounds";
            return false;
        }
        this.pending.EnsureRoom(LogFile.HEADER_LEN + plen);
        this.pending.WriteU32(plen);
        this.pending.WriteU32(payload.Crc32(plen));
        this.pending.WriteBytes(payload.Raw(), plen);
        return true;
    }

    /// 短写/写错后缓冲保留供诊断；失败 Store 必须 Close(false)，不得重刷。
    bool Flush() {
        if (!this.Ready()) { return false; }
        int bytes = this.pending.Length();
        if (bytes == 0) { return true; }
        int n = this.file.WriteAt(this.logicalEnd, this.pending.Raw(), bytes);
        if (n != bytes) {
            this.lastError = "log write failed: " + this.file.GetError();
            return false;
        }
        this.logicalEnd = this.logicalEnd + n;
        this.pending.Clear();
        return true;
    }

    bool Sync() {
        if (!this.Flush()) { return false; }
        if (!this.file.Sync()) {
            this.lastError = "log sync failed: " + this.file.GetError();
            return false;
        }
        return true;
    }

    int Mark() { return this.PendingBytes(); }
    void RollbackTo(int mark) {
        if (this.pending != null && mark >= 0 && mark < this.pending.Length()) {
            this.pending.SetLength(mark);
        }
    }

    /// 返回新逻辑末尾；错误为 -1，不截断读取失败或非法载荷的日志。
    long Replay(LogFrameVisitor visit) {
        if (!this.Ready()) { return -1; }
        if (this.pending.Length() != 0) {
            this.lastError = "cannot replay a log with pending writes";
            return -1;
        }
        long size = this.file.Size();
        if (size < 0) {
            this.lastError = "log size failed: " + this.file.GetError();
            return -1;
        }
        long off = 0;
        ByteBuffer h = ByteBuffer.Alloc(LogFile.HEADER_LEN);
        ByteBuffer body = ByteBuffer.Alloc(256);
        try {
            while (size - off >= LogFile.HEADER_LEN) {
                int got = this.file.ReadAt(off, h, LogFile.HEADER_LEN);
                if (got != LogFile.HEADER_LEN) {
                    this.lastError = "log header read failed: " + this.file.GetError();
                    return -1;
                }
                h.SeekRead(0);
                long plen = h.ReadU32();
                long crc = h.ReadU32();
                if (plen > LogFile.MAX_FRAME || plen > size - off - LogFile.HEADER_LEN) { break; }
                got = this.file.ReadAt(off + LogFile.HEADER_LEN, body, (int)plen);
                if (got != (int)plen) {
                    this.lastError = "log payload read failed: " + this.file.GetError();
                    return -1;
                }
                if (body.Crc32(got) != crc) {
                    // 一个定长完整帧后还有数据时，CRC 错不是单纯的撕裂尾。
                    if (off + LogFile.HEADER_LEN + plen < size) {
                        this.lastError = "log frame CRC corrupt before tail";
                        return -1;
                    }
                    break;
                }
                body.SeekRead(0);
                if (!visit(body)) {
                    this.lastError = "invalid log frame payload";
                    return -1;
                }
                off = off + LogFile.HEADER_LEN + plen;
            }
            if (off < size) {
                if (!this.file.Truncate(off) || !this.file.Sync()) {
                    this.lastError = "log tail repair failed: " + this.file.GetError();
                    return -1;
                }
            }
            this.logicalEnd = off;
            return off;
        } finally {
            h.Free();
            body.Free();
        }
    }

    /// 两个清单槽均覆盖日志后才调用。截断失败时不丢弃缓冲/逻辑水位。
    bool Reset() {
        if (!this.Ready()) { return false; }
        if (!this.file.Truncate(0) || !this.file.Sync()) {
            this.lastError = "log reset failed: " + this.file.GetError();
            return false;
        }
        this.pending.Clear();
        this.logicalEnd = 0;
        return true;
    }

    /// 兼容旧版写入者的 WAL 锁；新版还必须先拿 .lock 的稳定锁。
    bool TryLockExclusive() {
        return this.Ready() && this.file.TryLockExclusive();
    }

    void Close() { this.Close(true); }

    /// 失败路径传 false：关闭不把失败的待写帧再次落盘。
    void Close(bool flushPending) {
        if (flushPending && this.IsOpen()) { this.Sync(); }
        if (this.file != null) {
            this.file.Close();
            if (this.lastError == "" && this.file.GetError() != "") {
                this.lastError = this.file.GetError();
            }
        }
        if (this.pending != null) {
            this.pending.Free();
            this.pending = null;
        }
    }
}
