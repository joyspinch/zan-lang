using System;
using System.Collections.Generic;
using System.Interop;
using System.IO;
using System.Json;
using System.Threading;
namespace System.Data.ZanDb;

public delegate bool VectorFilter(int id);

// 二进制快照批次交付回调：payload 是一批槽位记录的编码字节串
// （可含 NUL，经存储层透明转义），按序交付拼接即完整快照。
public delegate void VectorBatchSink(string payload);

// 量化模式的批次导出向量供给：活性槽位按 id 从正文流式解析原向量
// （驻留只有量化码），返回 null 视为文档缺失，明确报错。
public delegate float[] VectorSource(int id);

public class VectorIndex {
    public VectorIndexOptions options;
    public List<VectorChunk> chunks;
    // 量化码平行存储（options.quantize 时独占，float 块不驻留）。
    public List<VectorCodeChunk> codeChunks;
    public List<VectorNode> nodes;
    public Dict<int, int> idSlots;
    public int chunkRows;
    public int entry;
    public int maxLevel;
    public long randomState;
    public AtomicInt lastDistanceCount;
    public float[] scratch;
    // 导入期间复用的向量暂存（量化路径逐槽解码用，避免批量堆垃圾）。
    private float[] importScratch;
    // 二进制快照导入期间的待挂边暂存：pendingEdges 按
    // 「数量, 槽位…」逐层打包，pendingEdgeBase 记每个槽位的起始
    // 下标。边可指向任意槽位（含后位），故全部记录就位后由
    // ImportFinish 统一接线。
    private List<int> pendingEdges;
    private List<int> pendingEdgeBase;

    public VectorIndex(VectorIndexOptions options) {
        if (options == null) { throw new ArgumentException("Missing vector options"); }
        options.Validate();
        this.options = options.Clone();
        this.chunks = new List<VectorChunk>();
        this.codeChunks = new List<VectorCodeChunk>();
        this.nodes = new List<VectorNode>();
        this.idSlots = new Dict<int, int>();
        this.chunkRows = 65536 / options.dimensions;
        if (this.chunkRows > 256) { this.chunkRows = 256; }
        this.entry = -1;
        this.maxLevel = -1;
        long seedValue = (long)options.seed % 2147483646;
        if (seedValue < 0) { seedValue = seedValue + 2147483646; }
        this.randomState = seedValue + 1;
        this.lastDistanceCount = new AtomicInt(0);
        this.scratch = new float[4];
    }

    public VectorIndexOptions Options() { return this.options.Clone(); }
    public int Count() { return this.idSlots.Count; }
    public long LastDistanceCount() { return this.lastDistanceCount.Load(); }

    public int NextLevel() {
        int level = 0;
        while (level < 32) {
            this.randomState = (this.randomState * 48271) % 2147483647;
            if (this.randomState % this.options.m != 0) { break; }
            level = level + 1;
        }
        return level;
    }

    public void ValidateDimensions(float[] vector) {
        if (vector == null) { throw new ArgumentException("Missing vector"); }
        if (vector.Length != this.options.dimensions) { throw new ArgumentException("Vector dimension mismatch"); }
    }

    public double ValidateCoordinates(float[] vector, int offset) {
        double norm = 0;
        for (int i = 0; i < this.options.dimensions; i = i + 1) {
            double value = (double)vector[offset + i];
            if (value != value || value - value != 0) { throw new ArgumentException("Vector coordinates must be finite"); }
            norm = norm + value * value;
        }
        if (this.options.metric == 0) {
            if (norm <= 0) { throw new ArgumentException("Cosine vector norm must be positive"); }
            return 1.0 / Math.Sqrt(norm);
        }
        return 0;
    }

    public double ValidateVector(float[] vector) {
        this.ValidateDimensions(vector);
        return this.ValidateCoordinates(vector, 0);
    }

    public void CopyIntoSlot(int slot, float[] vector) {
        int chunk = slot / this.chunkRows;
        if (chunk == this.chunks.Count) {
            this.chunks.Add(new VectorChunk(this.chunkRows * this.options.dimensions));
        }
        VectorChunk owner = this.chunks[chunk];
        int offset = (slot % this.chunkRows) * this.options.dimensions;
        for (int i = 0; i < this.options.dimensions; i = i + 1) {
            owner.values[offset + i] = vector[i];
        }
    }

    // 槽位量化码存储就位：与 CopyIntoSlot 相同的块增长规则。
    public void EnsureCodeStorage(int slot) {
        int chunk = slot / this.chunkRows;
        if (chunk == this.codeChunks.Count) {
            this.codeChunks.Add(new VectorCodeChunk(this.chunkRows * this.options.dimensions));
        }
    }

    // SQ8 量化写入：每向量 min-max 归一到 [0,255]。返回 inverseNorm
    //（与 ValidateCoordinates 同口径），scale/offset 经 out 交付。
    // 非退化向量（max==min）按 1e-12 量程处理，码全落 0。
    public double QuantizeIntoSlot(int slot, float[] vector, out double scale, out double offset) {
        double min = vector[0];
        double max = vector[0];
        for (int i = 1; i < this.options.dimensions; i = i + 1) {
            double v = vector[i];
            if (v < min) { min = v; }
            if (v > max) { max = v; }
        }
        double range = max - min;
        if (range <= 0) { range = 1e-12; }
        scale = range / 255;
        offset = min;
        this.EnsureCodeStorage(slot);
        VectorCodeChunk owner = this.codeChunks[slot / this.chunkRows];
        int at = (slot % this.chunkRows) * this.options.dimensions;
        for (int i = 0; i < this.options.dimensions; i = i + 1) {
            double q = (vector[i] - min) / scale;
            if (q < 0) { q = 0; }
            if (q > 255) { q = 255; }
            owner.values[at + i] = (byte)q;
        }
        return this.ValidateCoordinates(vector, 0);
    }

    // 槽位是否持有量化码（量化模式）。
    public bool IsQuantized() { return this.options.quantize; }

    // 量化码反量化距离：查询向量 work.query 对槽位码的近似距离。
    // cosine: 1 - invNq·invNs·(s·Σq·code + o·Σq)，Σq 预存 work.sumQuery；
    // L2: Σ (q - (code·s + o))² 逐维。
    public double DistanceToCode(VectorWorkspace work, int slot) {
        VectorCodeChunk owner = this.codeChunks[slot / this.chunkRows];
        int offset = (slot % this.chunkRows) * this.options.dimensions;
        VectorNode node = this.nodes[slot];
        double scale = node.quantScale;
        double shift = node.quantOffset;
        double sum = 0;
        if (this.options.metric == 1) {
            for (int i = 0; i < this.options.dimensions; i = i + 1) {
                double delta = (double)work.query[work.offset + i]
                - ((double)owner.values[offset + i] * scale + shift);
                sum = sum + delta * delta;
            }
            return sum;
        }
        for (int i = 0; i < this.options.dimensions; i = i + 1) {
            sum = sum + (double)work.query[work.offset + i] * (double)owner.values[offset + i];
        }
        double approx = sum * scale + shift * work.sumQuery;
        double distance = 1.0 - approx * work.inverseNorm * node.inverseNorm;
        if (distance < 0) { return 0; }
        if (distance > 2) { return 2; }
        return distance;
    }

    public float[] CopyVector(int slot) {
        if (this.options.quantize) {
            throw new IOException("quantized index has no resident vector to copy");
        }
        VectorChunk owner = this.chunks[slot / this.chunkRows];
        int offset = (slot % this.chunkRows) * this.options.dimensions;
        float[] vector = new float[this.options.dimensions];
        NativeMemory.Copy((nint)vector, (nint)owner.values + offset * 4, vector.Length * 4);
        return vector;
    }

    public double DistanceTo(VectorWorkspace work, int slot) {
        work.distanceCount = work.distanceCount + 1;
        if (this.options.quantize) { return this.DistanceToCode(work, slot); }
        VectorChunk owner = this.chunks[slot / this.chunkRows];
        int offset = (slot % this.chunkRows) * this.options.dimensions;
        double sum = 0;
        int dims = this.options.dimensions;
        int simdLimit = dims - (dims % 4);
        if (this.options.metric == 1) {
            Vector128 acc = Vector128.Zero;
            for (int i = 0; i < simdLimit; i = i + 4) {
                Vector128 q = Vector128.Load(work.query, work.offset + i);
                Vector128 v = Vector128.Load(owner.values, offset + i);
                Vector128 diff = Vector128.SubtractFloat(q, v);
                acc = Vector128.MultiplyAdd(diff, diff, acc);
            }
            Vector128.Store(work.scratch, 0, acc);
            sum = (double)work.scratch[0] + (double)work.scratch[1] + (double)work.scratch[2] + (double)work.scratch[3];
            for (int i = simdLimit; i < dims; i = i + 1) {
                double delta = (double)work.query[work.offset + i] - (double)owner.values[offset + i];
                sum = sum + delta * delta;
            }
            return sum;
        }
        Vector128 dotAcc = Vector128.Zero;
        for (int i = 0; i < simdLimit; i = i + 4) {
            Vector128 q = Vector128.Load(work.query, work.offset + i);
            Vector128 v = Vector128.Load(owner.values, offset + i);
            dotAcc = Vector128.MultiplyAdd(q, v, dotAcc);
        }
        Vector128.Store(work.scratch, 0, dotAcc);
        sum = (double)work.scratch[0] + (double)work.scratch[1] + (double)work.scratch[2] + (double)work.scratch[3];
        for (int i = simdLimit; i < dims; i = i + 1) {
            sum = sum + (double)work.query[work.offset + i] * (double)owner.values[offset + i];
        }
        double distance = 1.0 - sum * work.inverseNorm * this.nodes[slot].inverseNorm;
        if (distance < 0) { return 0; }
        if (distance > 2) { return 2; }
        return distance;
    }

    public double DistanceBetween(int a, int b) {
        if (this.options.quantize) { return this.DistanceBetweenCode(a, b); }
        VectorChunk ca = this.chunks[a / this.chunkRows];
        VectorChunk cb = this.chunks[b / this.chunkRows];
        int oa = (a % this.chunkRows) * this.options.dimensions;
        int ob = (b % this.chunkRows) * this.options.dimensions;
        double sum = 0;
        int dims = this.options.dimensions;
        int simdLimit = dims - (dims % 4);
        if (this.options.metric == 1) {
            Vector128 acc = Vector128.Zero;
            for (int i = 0; i < simdLimit; i = i + 4) {
                Vector128 va = Vector128.Load(ca.values, oa + i);
                Vector128 vb = Vector128.Load(cb.values, ob + i);
                Vector128 diff = Vector128.SubtractFloat(va, vb);
                acc = Vector128.MultiplyAdd(diff, diff, acc);
            }
            Vector128.Store(this.scratch, 0, acc);
            sum = (double)this.scratch[0] + (double)this.scratch[1] + (double)this.scratch[2] + (double)this.scratch[3];
            for (int i = simdLimit; i < dims; i = i + 1) {
                double delta = (double)ca.values[oa + i] - (double)cb.values[ob + i];
                sum = sum + delta * delta;
            }
            return sum;
        }
        Vector128 dotAcc = Vector128.Zero;
        for (int i = 0; i < simdLimit; i = i + 4) {
            Vector128 va = Vector128.Load(ca.values, oa + i);
            Vector128 vb = Vector128.Load(cb.values, ob + i);
            dotAcc = Vector128.MultiplyAdd(va, vb, dotAcc);
        }
        Vector128.Store(this.scratch, 0, dotAcc);
        sum = (double)this.scratch[0] + (double)this.scratch[1] + (double)this.scratch[2] + (double)this.scratch[3];
        for (int i = simdLimit; i < dims; i = i + 1) {
            sum = sum + (double)ca.values[oa + i] * (double)cb.values[ob + i];
        }
        double distance = 1.0 - sum * this.nodes[a].inverseNorm * this.nodes[b].inverseNorm;
        if (distance < 0) { return 0; }
        if (distance > 2) { return 2; }
        return distance;
    }

    // 码间反量化距离（图构建互距）。展开 (ca·sA+oA) 与 (cb·sB+oB)
    // 的组合项，逐维只扫一遍码。
    public double DistanceBetweenCode(int a, int b) {
        VectorCodeChunk ca = this.codeChunks[a / this.chunkRows];
        VectorCodeChunk cb = this.codeChunks[b / this.chunkRows];
        int oa = (a % this.chunkRows) * this.options.dimensions;
        int ob = (b % this.chunkRows) * this.options.dimensions;
        VectorNode na = this.nodes[a];
        VectorNode nb = this.nodes[b];
        double sumAB = 0;
        double sumA = 0;
        double sumB = 0;
        if (this.options.metric == 1) {
            double sum = 0;
            for (int i = 0; i < this.options.dimensions; i = i + 1) {
                double va = (double)ca.values[oa + i] * na.quantScale + na.quantOffset;
                double vb = (double)cb.values[ob + i] * nb.quantScale + nb.quantOffset;
                double delta = va - vb;
                sum = sum + delta * delta;
            }
            return sum;
        }
        for (int i = 0; i < this.options.dimensions; i = i + 1) {
            double va = (double)ca.values[oa + i];
            double vb = (double)cb.values[ob + i];
            sumAB = sumAB + va * vb;
            sumA = sumA + va;
            sumB = sumB + vb;
        }
        double approx = na.quantScale * nb.quantScale * sumAB
        + na.quantScale * nb.quantOffset * sumB
        + na.quantOffset * nb.quantScale * sumA
        + na.quantOffset * nb.quantOffset * this.options.dimensions;
        double distance = 1.0 - approx * na.inverseNorm * nb.inverseNorm;
        if (distance < 0) { return 0; }
        if (distance > 2) { return 2; }
        return distance;
    }

    public bool Current(int slot) {
        VectorNode node = this.nodes[slot];
        if (node.active == 0) { return false; }
        if (!this.idSlots.ContainsKey(node.id)) { return false; }
        return this.idSlots[node.id] == slot;
    }

    public bool Admit(int slot, bool activeOnly, VectorFilter filter) {
        if (!activeOnly) { return true; }
        if (!this.Current(slot)) { return false; }
        if (filter == null) { return true; }
        return filter(this.nodes[slot].id);
    }

    public int Greedy(VectorWorkspace work, int start, int layer) {
        int best = start;
        double bestDistance = this.DistanceTo(work, best);
        bool changed = true;
        while (changed) {
            changed = false;
            VectorNeighbors neighbors = this.nodes[best].layers[layer];
            for (int i = 0; i < neighbors.count; i = i + 1) {
                int candidate = neighbors.slots[i];
                double distance = this.DistanceTo(work, candidate);
                if (VectorHeap.Before(distance, this.nodes[candidate].id, candidate,
                bestDistance, this.nodes[best].id, best)) {
                    best = candidate;
                    bestDistance = distance;
                    changed = true;
                }
            }
        }
        return best;
    }

    public VectorHeap SearchLayer(VectorWorkspace work, int start, int layer, int ef,
    bool activeOnly, VectorFilter filter) {
        VectorHeap candidates = new VectorHeap(ef + 1, false);
        VectorHeap nearest = new VectorHeap(ef + 1, true);
        work.epoch = work.epoch + 1;
        work.visited[start] = work.epoch;
        double firstDistance = this.DistanceTo(work, start);
        candidates.Push(start, this.nodes[start].id, firstDistance);
        if (this.Admit(start, activeOnly, filter)) { nearest.Push(start, this.nodes[start].id, firstDistance); }
        while (candidates.count > 0) {
            int current = candidates.slots[0];
            double currentDistance = candidates.distances[0];
            if (nearest.count >= ef && currentDistance > nearest.distances[0]) { break; }
            candidates.Pop();
            VectorNeighbors neighbors = this.nodes[current].layers[layer];
            for (int i = 0; i < neighbors.count; i = i + 1) {
                int neighbor = neighbors.slots[i];
                if (work.visited[neighbor] == work.epoch) { continue; }
                work.visited[neighbor] = work.epoch;
                double distance = this.DistanceTo(work, neighbor);
                int id = this.nodes[neighbor].id;
                if (nearest.count < ef || distance <= nearest.distances[0]) {
                    candidates.Push(neighbor, id, distance);
                    if (this.Admit(neighbor, activeOnly, filter)) {
                        nearest.Push(neighbor, id, distance);
                        if (nearest.count > ef) { nearest.Pop(); }
                    }
                }
            }
        }
        return nearest;
    }

    public VectorNeighbors SelectNeighbors(int center, VectorHeap candidates, int limit) {
        VectorHeap ordered = new VectorHeap(candidates.count + 1, false);
        for (int i = 0; i < candidates.count; i = i + 1) {
            ordered.Push(candidates.slots[i], candidates.ids[i], candidates.distances[i]);
        }
        VectorNeighbors selected = new VectorNeighbors(limit);
        List<int> rejected = new List<int>();
        while (ordered.count > 0 && selected.count < limit) {
            int candidate = ordered.slots[0];
            double distance = ordered.distances[0];
            ordered.Pop();
            if (candidate == center || selected.Contains(candidate)) { continue; }
            bool diverse = true;
            for (int i = 0; i < selected.count; i = i + 1) {
                if (this.DistanceBetween(candidate, selected.slots[i]) < distance) { diverse = false; break; }
            }
            if (diverse) {
                selected.slots[selected.count] = candidate;
                selected.count = selected.count + 1;
            } else { rejected.Add(candidate); }
        }
        for (int i = 0; i < rejected.Count && selected.count < limit; i = i + 1) {
            int candidate = rejected[i];
            if (!selected.Contains(candidate)) {
                selected.slots[selected.count] = candidate;
                selected.count = selected.count + 1;
            }
        }
        return selected;
    }

    public void Link(int from, int to, int layer) {
        VectorNeighbors neighbors = this.nodes[from].layers[layer];
        if (neighbors.Contains(to)) { return; }
        if (neighbors.count < neighbors.slots.Length) {
            neighbors.slots[neighbors.count] = to;
            neighbors.count = neighbors.count + 1;
            return;
        }
        VectorHeap candidates = new VectorHeap(neighbors.count + 1, false);
        for (int i = 0; i < neighbors.count; i = i + 1) {
            int slot = neighbors.slots[i];
            candidates.Push(slot, this.nodes[slot].id, this.DistanceBetween(from, slot));
        }
        candidates.Push(to, this.nodes[to].id, this.DistanceBetween(from, to));
        this.nodes[from].layers[layer] = this.SelectNeighbors(from, candidates, neighbors.slots.Length);
    }

    // 将传入向量一次性复制至紧凑连续存储；更新时保留旧槽位可达性。
    public void Add(int id, float[] vector) {
        double inverseNorm = this.ValidateVector(vector);
        int slot = this.nodes.Count;
        if (slot >= 2147483646) { throw new InvalidOperationException("Vector slot capacity exhausted"); }
        double quantScale = 0;
        double quantOffset = 0;
        if (this.options.quantize) {
            // 量化模式不驻留 float 块：码 + scale/offset 即全部驻留。
            this.QuantizeIntoSlot(slot, vector, out quantScale, out quantOffset);
        } else {
            this.CopyIntoSlot(slot, vector);
        }
        int level = this.NextLevel();
        VectorNode node = new VectorNode(id, level, this.options.m, inverseNorm);
        if (this.options.quantize) { node.quantScale = quantScale; node.quantOffset = quantOffset; }
        this.nodes.Add(node);
        if (this.idSlots.ContainsKey(id)) { this.nodes[this.idSlots[id]].active = 0; }
        this.idSlots[id] = slot;
        this.idSlots.ContainsKey(id);
        if (this.entry < 0) { this.entry = slot; this.maxLevel = level; return; }
        VectorWorkspace work;
        if (this.options.quantize) {
            work = new VectorWorkspace(vector, 0, inverseNorm, this.nodes.Count);
            double sumQuery = 0;
            for (int i = 0; i < this.options.dimensions; i = i + 1) { sumQuery = sumQuery + vector[i]; }
            work.sumQuery = sumQuery;
        } else {
            VectorChunk owner = this.chunks[slot / this.chunkRows];
            int offset = (slot % this.chunkRows) * this.options.dimensions;
            work = new VectorWorkspace(owner.values, offset, inverseNorm, this.nodes.Count);
        }
        int current = this.entry;
        for (int layer = this.maxLevel; layer > level; layer = layer - 1) {
            current = this.Greedy(work, current, layer);
        }
        int top = level;
        if (top > this.maxLevel) { top = this.maxLevel; }
        int constructionEf = this.options.efConstruction;
        if (constructionEf > slot) { constructionEf = slot; }
        for (int layer = top; layer >= 0; layer = layer - 1) {
            VectorHeap candidates = this.SearchLayer(work, current, layer, constructionEf, false, null);
            int next = candidates.NearestSlot();
            VectorNeighbors selected = this.SelectNeighbors(slot, candidates, this.options.m);
            for (int i = 0; i < selected.count; i = i + 1) {
                int neighbor = selected.slots[i];
                this.Link(slot, neighbor, layer);
                this.Link(neighbor, slot, layer);
            }
            current = next;
        }
        if (level > this.maxLevel) { this.entry = slot; this.maxLevel = level; }
    }

    public bool Remove(int id) {
        if (!this.idSlots.ContainsKey(id)) { return false; }
        this.nodes[this.idSlots[id]].active = 0;
        this.idSlots.Remove(id);
        this.idSlots.ContainsKey(id);
        return true;
    }

    public VectorWorkspace QueryWorkspace(float[] query) {
        this.ValidateDimensions(query);
        float[] owned = new float[this.options.dimensions];
        NativeMemory.Copy((nint)owned, (nint)query, owned.Length * 4);
        double inverseNorm = this.ValidateCoordinates(owned, 0);
        VectorWorkspace work = new VectorWorkspace(owned, 0, inverseNorm, this.nodes.Count);
        if (this.options.quantize) {
            double sumQuery = 0;
            for (int i = 0; i < this.options.dimensions; i = i + 1) { sumQuery = sumQuery + owned[i]; }
            work.sumQuery = sumQuery;
        }
        return work;
    }

    public int QueryLimit(int k) {
        if (k < 0 || k > 1000000) { throw new ArgumentException("Vector k must be in [0,1000000]"); }
        if (k > this.Count()) { return this.Count(); }
        return k;
    }

    public List<VectorHit> Hits(VectorHeap nearest, int k) {
        while (nearest.count > k) { nearest.Pop(); }
        List<VectorHit> hits = new List<VectorHit>();
        while (nearest.count > 0) {
            hits.Add(new VectorHit(nearest.ids[0], nearest.distances[0]));
            nearest.Pop();
        }
        hits.Reverse();
        return hits;
    }

    public List<VectorHit> Search(float[] query, int k, int efSearch) {
        return this.SearchFiltered(query, k, efSearch, null);
    }

    public List<VectorHit> SearchFiltered(float[] query, int k, int efSearch, VectorFilter filter) {
        int limit = this.QueryLimit(k);
        if (efSearch < 0 || efSearch > 1000000) { throw new ArgumentException("Vector efSearch must be in [0,1000000]"); }
        if (efSearch == 0) { efSearch = this.options.efSearch; }
        if (efSearch < limit) { efSearch = limit; }
        if (efSearch > this.nodes.Count) { efSearch = this.nodes.Count; }
        VectorWorkspace work = this.QueryWorkspace(query);
        if (limit == 0) { this.lastDistanceCount.Store(0); return new List<VectorHit>(); }
        int current = this.entry;
        for (int layer = this.maxLevel; layer > 0; layer = layer - 1) {
            current = this.Greedy(work, current, layer);
        }
        VectorHeap nearest = this.SearchLayer(work, current, 0, efSearch, true, filter);
        List<VectorHit> hits = this.Hits(nearest, limit);
        this.lastDistanceCount.Store(work.distanceCount);
        return hits;
    }

    // 原向量精确距离（重打分内核）：查询 workspace + 原向量，
    // 与 <see cref="SearchExactFiltered"/> 同式——余弦
    // 1 - dot·invNq·(1/√nv)，L2 逐维差平方和。
    public double RescoreDistance(VectorWorkspace work, float[] vector) {
        double dot = 0;
        double nv = 0;
        int dims = this.options.dimensions;
        int simdLimit = dims - (dims % 4);
        if (this.options.metric == 1) {
            Vector128 acc = Vector128.Zero;
            for (int i = 0; i < simdLimit; i = i + 4) {
                Vector128 q = Vector128.Load(work.query, work.offset + i);
                Vector128 v = Vector128.Load(vector, i);
                Vector128 diff = Vector128.SubtractFloat(q, v);
                acc = Vector128.MultiplyAdd(diff, diff, acc);
            }
            Vector128.Store(work.scratch, 0, acc);
            dot = (double)work.scratch[0] + (double)work.scratch[1] + (double)work.scratch[2] + (double)work.scratch[3];
            for (int i = simdLimit; i < dims; i = i + 1) {
                double delta = (double)work.query[work.offset + i] - (double)vector[i];
                dot = dot + delta * delta;
            }
            return dot;
        }
        Vector128 accDot = Vector128.Zero;
        Vector128 accNv = Vector128.Zero;
        for (int i = 0; i < simdLimit; i = i + 4) {
            Vector128 q = Vector128.Load(work.query, work.offset + i);
            Vector128 v = Vector128.Load(vector, i);
            accDot = Vector128.MultiplyAdd(q, v, accDot);
            accNv = Vector128.MultiplyAdd(v, v, accNv);
        }
        Vector128.Store(work.scratch, 0, accDot);
        dot = (double)work.scratch[0] + (double)work.scratch[1] + (double)work.scratch[2] + (double)work.scratch[3];
        Vector128.Store(work.scratch, 0, accNv);
        nv = (double)work.scratch[0] + (double)work.scratch[1] + (double)work.scratch[2] + (double)work.scratch[3];
        for (int i = simdLimit; i < dims; i = i + 1) {
            dot = dot + (double)work.query[work.offset + i] * (double)vector[i];
            nv = nv + (double)vector[i] * (double)vector[i];
        }
        double distance = 1.0 - dot * work.inverseNorm / Math.Sqrt(nv);
        if (distance < 0) { return 0; }
        if (distance > 2) { return 2; }
        return distance;
    }

    // 两段式重打分（刀3b）：量化索引的召回补全——近召回段用
    // ADC 距离取 k×4 候选（图遍历照常），精排段对每个候选 id 经
    // source 从文档行取回原向量重算精确距离，按精确距离排序取
    // top-k。候选数放大是召回上限，非量化索引直接走普通近似
    // 搜索（其距离本就精确，重打分无意义）。source 缺失或返回
    // 维度不符抛 IOException——精排段拿不到原向量就是错误配置。
    public List<VectorHit> SearchRescoreFiltered(float[] query, int k, int efSearch, VectorFilter filter, VectorSource source) {
        if (!this.options.quantize) { return this.SearchFiltered(query, k, efSearch, filter); }
        if (source == null) { throw new IOException("rescore requires a vector source"); }
        int limit = this.QueryLimit(k);
        if (limit == 0) { return new List<VectorHit>(); }
        int candidates = limit * 4;
        int active = this.Count();
        if (candidates > active) { candidates = active; }
        List<VectorHit> recalled = this.SearchFiltered(query, candidates, efSearch, filter);
        VectorWorkspace work = this.QueryWorkspace(query);
        VectorHeap best = new VectorHeap(limit + 1, true);
        for (int i = 0; i < recalled.Count; i = i + 1) {
            int id = recalled[i].id;
            float[] vector = source(id);
            if (vector == null || vector.Length != this.options.dimensions) {
                throw new IOException("rescore vector source returned invalid vector");
            }
            double distance = this.RescoreDistance(work, vector);
            best.Push(id, id, distance);
            if (best.count > limit) { best.Pop(); }
        }
        return this.Hits(best, limit);
    }

    public List<VectorHit> SearchExact(float[] query, int k) {
        return this.SearchExactFiltered(query, k, null);
    }

    public List<VectorHit> SearchExactFiltered(float[] query, int k, VectorFilter filter) {
        int limit = this.QueryLimit(k);
        VectorWorkspace work = this.QueryWorkspace(query);
        VectorHeap nearest = new VectorHeap(limit + 1, true);
        if (limit > 0) {
            for (int slot = 0; slot < this.nodes.Count; slot = slot + 1) {
                if (!this.Admit(slot, true, filter)) { continue; }
                double distance = this.DistanceTo(work, slot);
                nearest.Push(slot, this.nodes[slot].id, distance);
                if (nearest.count > limit) { nearest.Pop(); }
            }
        }
        List<VectorHit> hits = this.Hits(nearest, limit);
        this.lastDistanceCount.Store(work.distanceCount);
        return hits;
    }

    public void Rebuild() {
        VectorHeap active = new VectorHeap(this.Count() + 1, false);
        for (int slot = 0; slot < this.nodes.Count; slot = slot + 1) {
            if (this.Current(slot)) { active.Push(slot, this.nodes[slot].id, 0); }
        }
        VectorIndex rebuilt = new VectorIndex(this.options);
        while (active.count > 0) {
            int slot = active.slots[0];
            rebuilt.Add(this.nodes[slot].id, this.CopyVector(slot));
            active.Pop();
        }
        this.chunks = rebuilt.chunks;
        this.nodes = rebuilt.nodes;
        this.idSlots = rebuilt.idSlots;
        this.entry = rebuilt.entry;
        this.maxLevel = rebuilt.maxLevel;
        this.randomState = rebuilt.randomState;
        this.lastDistanceCount.Store(0);
    }

    public JsonValue ExportState() {
        JsonValue state = JsonValue.NewObject();
        state.Put("format", JsonValue.NewInt(1));
        state.Put("options", this.options.ToJson());
        state.Put("entry", JsonValue.NewInt(this.entry));
        state.Put("maxLevel", JsonValue.NewInt(this.maxLevel));
        state.Put("rng", JsonValue.NewInt(this.randomState));
        JsonValue records = JsonValue.NewArray();
        for (int slot = 0; slot < this.nodes.Count; slot = slot + 1) {
            VectorNode node = this.nodes[slot];
            JsonValue record = JsonValue.NewObject();
            record.Put("id", JsonValue.NewInt(node.id));
            record.Put("active", JsonValue.NewInt(node.active));
            record.Put("level", JsonValue.NewInt(node.level));
            JsonValue vector = JsonValue.NewArray();
            VectorChunk owner = this.chunks[slot / this.chunkRows];
            int offset = (slot % this.chunkRows) * this.options.dimensions;
            for (int i = 0; i < this.options.dimensions; i = i + 1) {
                vector.Append(JsonValue.NewDouble((double)owner.values[offset + i]));
            }
            record.Put("vector", vector);
            JsonValue layers = JsonValue.NewArray();
            for (int layer = 0; layer <= node.level; layer = layer + 1) {
                JsonValue edges = JsonValue.NewArray();
                VectorNeighbors neighbors = node.layers[layer];
                for (int i = 0; i < neighbors.count; i = i + 1) { edges.Append(JsonValue.NewInt(neighbors.slots[i])); }
                layers.Append(edges);
            }
            record.Put("layers", layers);
            records.Append(record);
        }
        state.Put("nodes", records);
        return state;
    }

    public static VectorIndex ImportState(JsonValue state) {
        VectorStateJson.RequireObject(state);
        if (VectorStateJson.IntField(state, "format") != 1) { throw new ArgumentException("Unsupported vector state format"); }
        VectorIndexOptions options = VectorIndexOptions.FromJson(VectorStateJson.Field(state, "options"));
        VectorIndex result = new VectorIndex(options);
        JsonValue records = VectorStateJson.ArrayField(state, "nodes");
        int count = records.Count();
        if (count >= 2147483646) { throw new ArgumentException("Vector state has too many nodes"); }
        int highest = -1;
        for (int slot = 0; slot < count; slot = slot + 1) {
            JsonValue record = records.At(slot);
            VectorStateJson.RequireObject(record);
            int id = VectorStateJson.IntField(record, "id");
            int active = VectorStateJson.IntField(record, "active");
            int level = VectorStateJson.IntField(record, "level");
            if (active != 0 && active != 1) { throw new ArgumentException("Invalid vector active flag"); }
            if (level < 0 || level > 32) { throw new ArgumentException("Invalid vector node level"); }
            JsonValue coordinates = VectorStateJson.ArrayField(record, "vector");
            if (coordinates.Count() != options.dimensions) { throw new ArgumentException("Invalid checkpoint vector dimensions"); }
            float[] vector = new float[options.dimensions];
            for (int i = 0; i < vector.Length; i = i + 1) {
                JsonValue coordinate = coordinates.At(i);
                if (coordinate == null) { throw new ArgumentException("Missing checkpoint coordinate"); }
                if (!coordinate.IsNumber()) { throw new ArgumentException("Invalid checkpoint coordinate"); }
                double value = coordinate.AsDouble(0);
                if (value != value || value - value != 0) {
                    throw new ArgumentException("Checkpoint coordinate must be finite float32");
                }
                vector[i] = (float)value;
            }
            double inverseNorm = result.ValidateVector(vector);
            VectorNode node = new VectorNode(id, level, options.m, inverseNorm);
            node.active = active;
            result.CopyIntoSlot(slot, vector);
            result.nodes.Add(node);
            if (active == 1) {
                if (result.idSlots.ContainsKey(id)) { throw new ArgumentException("Duplicate active checkpoint id"); }
                result.idSlots.Add(id, slot);
            }
            if (level > highest) { highest = level; }
        }
        for (int slot = 0; slot < count; slot = slot + 1) {
            JsonValue record = records.At(slot);
            JsonValue layers = VectorStateJson.ArrayField(record, "layers");
            VectorNode node = result.nodes[slot];
            if (layers.Count() != node.level + 1) { throw new ArgumentException("Invalid checkpoint layer count"); }
            for (int layer = 0; layer <= node.level; layer = layer + 1) {
                JsonValue edges = layers.At(layer);
                if (edges == null) { throw new ArgumentException("Missing checkpoint edges"); }
                if (!edges.IsArray()) { throw new ArgumentException("Invalid checkpoint edges"); }
                VectorNeighbors neighbors = node.layers[layer];
                if (edges.Count() > neighbors.slots.Length) { throw new ArgumentException("Checkpoint neighbor bound exceeded"); }
                for (int i = 0; i < edges.Count(); i = i + 1) {
                    int target = VectorStateJson.IntValue(edges.At(i));
                    if (target < 0 || target >= count || target == slot) { throw new ArgumentException("Invalid checkpoint edge target"); }
                    if (result.nodes[target].level < layer || neighbors.Contains(target)) {
                        throw new ArgumentException("Invalid checkpoint layer edge");
                    }
                    neighbors.slots[neighbors.count] = target;
                    neighbors.count = neighbors.count + 1;
                }
            }
        }
        result.entry = VectorStateJson.IntField(state, "entry");
        result.maxLevel = VectorStateJson.IntField(state, "maxLevel");
        int rng = VectorStateJson.IntField(state, "rng");
        if (rng < 1 || rng >= 2147483647) { throw new ArgumentException("Invalid checkpoint RNG state"); }
        result.randomState = rng;
        if (count == 0) {
            if (result.entry != -1 || result.maxLevel != -1) { throw new ArgumentException("Invalid empty checkpoint entry"); }
        } else {
            if (result.entry < 0 || result.entry >= count || result.maxLevel != highest) {
                throw new ArgumentException("Invalid checkpoint entry or maximum level");
            }
            if (result.nodes[result.entry].level != result.maxLevel) { throw new ArgumentException("Checkpoint entry level mismatch"); }
            result.idSlots.ContainsKey(result.nodes[result.entry].id);
        }
        return result;
    }

    // ===== 二进制快照（格式 v2）：流式导出/导入，全程不物化 JSON 树 =====
    // 记录布局（依槽位序）：
    //   U8 active          0/1
    //   U8 level           0..32
    //   VarInt id          文档 id（≥0）
    //   dims×4 字节        float32 向量（原生小端，与存储层一致）
    //   level+1 组边       VarInt 数量 + 数量×VarInt 槽位
    // 批次是纯字节流的任意切段，按序拼接后必须落在记录边界上。
    // 头部信息（options/entry/maxLevel/rng/槽数/批数）由快照头部
    // JSON 携带，不在本编码内。

    // 就位槽位向量存储：与 CopyIntoSlot 相同的块增长规则。
    private void EnsureSlotStorage(int slot) {
        int chunk = slot / this.chunkRows;
        if (chunk == this.chunks.Count) {
            this.chunks.Add(new VectorChunk(this.chunkRows * this.options.dimensions));
        }
    }

    // 记录的层边段编码（两种导出通道共用）。
    private void WriteNodeEdges(ByteBuffer b, VectorNode node) {
        for (int layer = 0; layer <= node.level; layer = layer + 1) {
            VectorNeighbors neighbors = node.layers[layer];
            b.WriteVarInt(neighbors.count);
            for (int i = 0; i < neighbors.count; i = i + 1) {
                b.WriteVarInt(neighbors.slots[i]);
            }
        }
    }

    // 把全部槽位记录流式编码为若干批次载荷（每批约 batchBytes
    // 字节），经 sink 交付。内存峰值 = 一个批次的编码缓冲；向量
    // 直接从紧凑块存储上 memcpy，不逐维装箱。
    public void ExportBatches(VectorBatchSink sink, int batchBytes) {
        if (sink == null) { throw new ArgumentException("Missing vector batch sink"); }
        if (batchBytes < 4096) { batchBytes = 4096; }
        ByteBuffer b = ByteBuffer.Alloc(batchBytes + 4096);
        for (int slot = 0; slot < this.nodes.Count; slot = slot + 1) {
            VectorNode node = this.nodes[slot];
            b.WriteU8(node.active);
            b.WriteU8(node.level);
            b.WriteVarInt(node.id);
            VectorChunk owner = this.chunks[slot / this.chunkRows];
            int offset = (slot % this.chunkRows) * this.options.dimensions;
            b.WriteBytes((nint)owner.values + offset * 4, this.options.dimensions * 4);
            this.WriteNodeEdges(b, node);
            if (b.Length() >= batchBytes) {
                sink(b.ToStr());
                b.Clear();
            }
        }
        if (b.Length() > 0) { sink(b.ToStr()); }
        b.Free();
    }

    // 量化模式导出：float 块不驻留，原向量经 source 从文档流式
    // 取回（只对 active 槽调用）；墓碑槽写全零向量，导入侧按码
    // 重建。载荷格式与非量化完全一致（canonical float32），两种
    // 模式的检查点可以互换。
    public void ExportBatches(VectorBatchSink sink, int batchBytes, VectorSource source) {
        if (sink == null) { throw new ArgumentException("Missing vector batch sink"); }
        if (!this.options.quantize) { this.ExportBatches(sink, batchBytes); return; }
        if (source == null) { throw new ArgumentException("quantized checkpoint export requires a vector source"); }
        if (batchBytes < 4096) { batchBytes = 4096; }
        int bytes = this.options.dimensions * 4;
        float[] zero = new float[this.options.dimensions];
        ByteBuffer b = ByteBuffer.Alloc(batchBytes + 4096);
        for (int slot = 0; slot < this.nodes.Count; slot = slot + 1) {
            VectorNode node = this.nodes[slot];
            b.WriteU8(node.active);
            b.WriteU8(node.level);
            b.WriteVarInt(node.id);
            float[] vector = zero;
            if (node.active == 1) {
                vector = source(node.id);
                if (vector == null || vector.Length != this.options.dimensions) {
                    b.Free();
                    throw new IOException("checkpoint vector source returned invalid vector");
                }
            }
            b.WriteBytes((nint)vector, bytes);
            this.WriteNodeEdges(b, node);
            if (b.Length() >= batchBytes) {
                sink(b.ToStr());
                b.Clear();
            }
        }
        if (b.Length() > 0) { sink(b.ToStr()); }
        b.Free();
    }

    // 解码一个批次载荷，追加到待接线状态。可分任意多次调用，
    // 但每次交付都必须落在记录边界上。
    public void ImportBatch(string payload) {
        if (payload == null || payload.Length == 0) { throw new ArgumentException("Empty vector checkpoint batch"); }
        if (this.pendingEdges == null) {
            this.pendingEdges = new List<int>();
            this.pendingEdgeBase = new List<int>();
        }
        ByteBuffer b = ByteBuffer.FromStr(payload);
        while (b.Remaining() > 0) {
            int active = b.ReadU8();
            int level = b.ReadU8();
            if (active > 1 || level < 0 || level > 32) {
                b.Free();
                throw new ArgumentException("Invalid checkpoint record header");
            }
            long id = b.ReadVarInt();
            if (id < 0 || id > 2147483646) {
                b.Free();
                throw new ArgumentException("Invalid checkpoint record id");
            }
            int bytes = this.options.dimensions * 4;
            if (!b.CanRead(bytes)) {
                b.Free();
                throw new ArgumentException("Truncated checkpoint vector");
            }
            int slot = this.nodes.Count;
            if (slot >= 2147483646) {
                b.Free();
                throw new InvalidOperationException("Vector slot capacity exhausted");
            }
            VectorNode node;
            if (this.options.quantize) {
                // 量化模式：float 块不驻留，码由暂存向量现建。墓碑槽
                // 码全零、scale/offset 失效——零向量过不了余弦范数
                // 校验，必须跳过校验（搜索不会把它当结果返回）。
                if (this.importScratch == null) { this.importScratch = new float[this.options.dimensions]; }
                NativeMemory.Copy((nint)this.importScratch, b.Raw() + b.ReadPos(), bytes);
                b.SeekRead(b.ReadPos() + bytes);
                double scale = 0;
                double shift = 0;
                double inverseNorm = 0;
                if (active == 1) {
                    inverseNorm = this.QuantizeIntoSlot(slot, this.importScratch, out scale, out shift);
                } else {
                    this.EnsureCodeStorage(slot);
                }
                node = new VectorNode((int)id, level, this.options.m, inverseNorm);
                node.quantScale = scale;
                node.quantOffset = shift;
            } else {
                this.EnsureSlotStorage(slot);
                VectorChunk owner = this.chunks[slot / this.chunkRows];
                int offset = (slot % this.chunkRows) * this.options.dimensions;
                NativeMemory.Copy((nint)owner.values + offset * 4, b.Raw() + b.ReadPos(), bytes);
                b.SeekRead(b.ReadPos() + bytes);
                double inverseNorm = this.ValidateCoordinates(owner.values, offset);
                node = new VectorNode((int)id, level, this.options.m, inverseNorm);
            }
            if (active == 0) { node.active = 0; }
            this.nodes.Add(node);
            if (active == 1) {
                if (this.idSlots.ContainsKey(node.id)) {
                    b.Free();
                    throw new ArgumentException("Duplicate active checkpoint id");
                }
                this.idSlots.Add(node.id, slot);
            }
            this.pendingEdgeBase.Add(this.pendingEdges.Count);
            for (int layer = 0; layer <= level; layer = layer + 1) {
                long count = b.ReadVarInt();
                // 层容量上界 = m×2 ≤ 256（options.Validate 保证），
                // 越界即格式损坏，直接拒绝。
                if (count < 0 || count > 256) {
                    b.Free();
                    throw new ArgumentException("Invalid checkpoint edge count");
                }
                this.pendingEdges.Add((int)count);
                for (int i = 0; i < (int)count; i = i + 1) {
                    this.pendingEdges.Add((int)b.ReadVarInt());
                }
            }
        }
        b.Free();
    }

    // 全部批次就位后接线并固化头部校验（与 v1 ImportState 同一口
    // 径：槽数一致、边指向合法层位、入口层 = 最高层、RNG 在界）。
    public void ImportFinish(int entry, int maxLevel, int rng, long expectedCount) {
        if (this.pendingEdges == null) {
            this.pendingEdges = new List<int>();
            this.pendingEdgeBase = new List<int>();
        }
        if ((long)this.nodes.Count != expectedCount) {
            throw new ArgumentException("Vector checkpoint slot count mismatch");
        }
        int highest = -1;
        for (int slot = 0; slot < this.nodes.Count; slot = slot + 1) {
            if (this.nodes[slot].level > highest) { highest = this.nodes[slot].level; }
        }
        for (int slot = 0; slot < this.nodes.Count; slot = slot + 1) {
            VectorNode node = this.nodes[slot];
            int cursor = this.pendingEdgeBase[slot];
            for (int layer = 0; layer <= node.level; layer = layer + 1) {
                int count = this.pendingEdges[cursor];
                cursor = cursor + 1;
                VectorNeighbors neighbors = node.layers[layer];
                if (count > neighbors.slots.Length) {
                    throw new ArgumentException("Checkpoint neighbor bound exceeded");
                }
                for (int i = 0; i < count; i = i + 1) {
                    int target = this.pendingEdges[cursor];
                    cursor = cursor + 1;
                    if (target < 0 || target >= this.nodes.Count || target == slot) {
                        throw new ArgumentException("Invalid checkpoint edge target");
                    }
                    if (this.nodes[target].level < layer || neighbors.Contains(target)) {
                        throw new ArgumentException("Invalid checkpoint layer edge");
                    }
                    neighbors.slots[i] = target;
                }
                neighbors.count = count;
            }
        }
        this.pendingEdges = null;
        this.pendingEdgeBase = null;
        if (rng < 1 || rng >= 2147483647) {
            throw new ArgumentException("Invalid checkpoint RNG state");
        }
        this.randomState = rng;
        if (this.nodes.Count == 0) {
            if (entry != -1 || maxLevel != -1) {
                throw new ArgumentException("Invalid empty checkpoint entry");
            }
            this.entry = -1;
            this.maxLevel = -1;
            return;
        }
        if (entry < 0 || entry >= this.nodes.Count || maxLevel != highest) {
            throw new ArgumentException("Invalid checkpoint entry or maximum level");
        }
        if (this.nodes[entry].level != maxLevel) {
            throw new ArgumentException("Checkpoint entry level mismatch");
        }
        this.entry = entry;
        this.maxLevel = maxLevel;
        this.idSlots.ContainsKey(this.nodes[entry].id);
    }
}
