using System;

namespace System.Data.ZanDb;

// 事务暂存操作记录
public class RecordTxOp {
    public int opType; // 1=Add, 2=Update, 3=Delete
    public int id;
    public RecordRow row;

    public RecordTxOp(int opType, int id, RecordRow row) {
        this.opType = opType;
        this.id = id;
        this.row = row;
    }
}
