using System;
using System.Collections.Generic;
using System.IO;
using System.Linq;
using System.Text;
using System.Threading;
namespace System.Data.ZanDb;

public delegate bool RecordRowVisitor(int id, RecordRow row);

// 列数据类型编码
public class RecordDataType {
    public static const int Int32 = 1;
    public static const int Int64 = 2;
    public static const int Float32 = 3;
    public static const int Float64 = 4;
    public static const int FixedStr = 5;
    public static const int Bool = 6;
    public static const int VarStr = 7; // 变长字符串（行内存 8B 指针: offset 4B + len 4B，数据存 .zblob）
    public static const int Blob = 8;   // 原始字节块（行内存 8B 指针: offset 4B + len 4B，数据存 .zblob）
}

// 结构化表列定义
public class RecordColumn {
    public string name;
    public int dataType;
    public int fixedLen; // 字节长度
    public int offset;   // 行内字节偏移（行首 4 字节为标志区：1B flags + 3B padding）

    public RecordColumn(string name, int dataType, int fixedLen, int offset) {
        this.name = name != null ? name : "";
        this.dataType = dataType;
        this.fixedLen = fixedLen;
        this.offset = offset;
    }
}

// 表结构元数据
public class RecordSchema {
    public List<RecordColumn> columns;
    public int rowBytes; // 定长行宽（4 字节对齐）

    public RecordSchema() {
        this.columns = new List<RecordColumn>();
        this.rowBytes = 4; // 保留前 4 字节：flags(1B, 1=有效/0=墓碑) + 3B 保留对齐
    }

    public void AddInt32(string name) {
        int off = this.rowBytes;
        int dt = RecordDataType.Int32 > 0 ? RecordDataType.Int32 : 1;
        this.columns.Add(new RecordColumn(name, dt, 4, off));
        this.rowBytes = this.rowBytes + 4;
    }

    public void AddInt64(string name) {
        int rem = this.rowBytes % 8;
        if (rem != 0) { this.rowBytes = this.rowBytes + (8 - rem); }
        int off = this.rowBytes;
        int dt = RecordDataType.Int64 > 0 ? RecordDataType.Int64 : 2;
        this.columns.Add(new RecordColumn(name, dt, 8, off));
        this.rowBytes = this.rowBytes + 8;
    }

    public void AddFloat32(string name) {
        int off = this.rowBytes;
        int dt = RecordDataType.Float32 > 0 ? RecordDataType.Float32 : 3;
        this.columns.Add(new RecordColumn(name, dt, 4, off));
        this.rowBytes = this.rowBytes + 4;
    }

    public void AddFloat64(string name) {
        int rem = this.rowBytes % 8;
        if (rem != 0) { this.rowBytes = this.rowBytes + (8 - rem); }
        int off = this.rowBytes;
        int dt = RecordDataType.Float64 > 0 ? RecordDataType.Float64 : 4;
        this.columns.Add(new RecordColumn(name, dt, 8, off));
        this.rowBytes = this.rowBytes + 8;
    }

    public void AddFixedStr(string name, int maxBytes) {
        int rem = maxBytes % 4;
        int aligned = rem == 0 ? maxBytes : maxBytes + (4 - rem);
        int off = this.rowBytes;
        int dt = RecordDataType.FixedStr > 0 ? RecordDataType.FixedStr : 5;
        this.columns.Add(new RecordColumn(name, dt, aligned, off));
        this.rowBytes = this.rowBytes + aligned;
    }

    public void AddBool(string name) {
        int off = this.rowBytes;
        int dt = RecordDataType.Bool > 0 ? RecordDataType.Bool : 6;
        this.columns.Add(new RecordColumn(name, dt, 4, off));
        this.rowBytes = this.rowBytes + 4;
    }

    // 变长字符串：行内存 8 字节指针 (4B blobOffset + 4B blobLen)
    public void AddVarStr(string name) {
        int off = this.rowBytes;
        int dt = RecordDataType.VarStr > 0 ? RecordDataType.VarStr : 7;
        this.columns.Add(new RecordColumn(name, dt, 8, off));
        this.rowBytes = this.rowBytes + 8;
    }

    // 原始大二进制字节块：行内存 8 字节指针 (4B blobOffset + 4B blobLen)
    public void AddBlob(string name) {
        int off = this.rowBytes;
        int dt = RecordDataType.Blob > 0 ? RecordDataType.Blob : 8;
        this.columns.Add(new RecordColumn(name, dt, 8, off));
        this.rowBytes = this.rowBytes + 8;
    }

    public RecordColumn FindColumn(string name) {
        if (name == null) { return null; }
        for (int i = 0; i < this.columns.Count; i = i + 1) {
            if (this.columns[i].name == name) { return this.columns[i]; }
        }
        string lower = name.ToLower();
        for (int i = 0; i < this.columns.Count; i = i + 1) {
            if (this.columns[i].name.ToLower() == lower) { return this.columns[i]; }
        }
        return null;
    }

    public int ColumnIndex(string name) {
        if (name == null) { return 0 - 1; }
        for (int i = 0; i < this.columns.Count; i = i + 1) {
            if (this.columns[i].name == name) { return i; }
        }
        string lower = name.ToLower();
        for (int i = 0; i < this.columns.Count; i = i + 1) {
            if (this.columns[i].name.ToLower() == lower) { return i; }
        }
        return 0 - 1;
    }

    // 序列化 Schema 为二进制格式
    public ByteBuffer Serialize() {
        ByteBuffer b = ByteBuffer.Alloc(128);
        b.WriteU16(this.rowBytes);
        b.WriteU16(this.columns.Count);
        for (int i = 0; i < this.columns.Count; i = i + 1) {
            RecordColumn c = this.columns[i];
            b.WriteU8(c.dataType);
            b.WriteU16(c.fixedLen);
            b.WriteU16(c.offset);
            byte[] nb = Encoding.GetBytes(c.name);
            int nlen = nb != null ? nb.Length : 0;
            if (nlen > 255) { nlen = 255; }
            b.WriteU8(nlen);
            for (int j = 0; j < nlen; j = j + 1) {
                b.WriteU8((int)nb[j]);
            }
        }
        return b;
    }

    // 从二进制格式反序列化 Schema
    public static RecordSchema Deserialize(ByteBuffer b) {
        RecordSchema s = new RecordSchema();
        s.columns.Clear();
        s.rowBytes = b.ReadU16();
        int count = b.ReadU16();
        for (int i = 0; i < count; i = i + 1) {
            int dt = b.ReadU8();
            int flen = b.ReadU16();
            int off = b.ReadU16();
            int nlen = b.ReadU8();
            byte[] nb = new byte[nlen];
            for (int j = 0; j < nlen; j = j + 1) {
                nb[j] = (byte)b.ReadU8();
            }
            string name = Encoding.GetString(nb, 0, nlen);
            s.columns.Add(new RecordColumn(name, dt, flen, off));
        }
        return s;
    }
}

// 零装箱物理数据行
public class RecordRow {
    public RecordSchema schema;
    public byte[] data;
    public int id;
    public bool isActive;
    public RecordTable table;

    // 变长字段写时缓冲（落盘前暂存，落盘后生成 8 字节 offset/len 指针）
    public Dictionary<string, string> varStrs;
    public Dictionary<string, byte[]> blobs;

    public RecordRow(RecordSchema schema) {
        this.schema = schema;
        this.data = new byte[schema.rowBytes];
        this.data[0] = 1; // 默认标志位：活跃有效
        this.id = 0;
        this.isActive = true;
        this.table = null;
        this.varStrs = new Dictionary<string, string>();
        this.blobs = new Dictionary<string, byte[]>();
    }

    public RecordRow(RecordSchema schema, byte[] raw, int id, bool isActive, RecordTable table = null) {
        this.schema = schema;
        this.data = raw;
        this.id = id;
        this.isActive = isActive;
        this.table = table;
        this.varStrs = new Dictionary<string, string>();
        this.blobs = new Dictionary<string, byte[]>();
    }

    public void SetInt32(string colName, int val) {
        RecordColumn col = this.schema.FindColumn(colName);
        if (col == null || col.dataType != RecordDataType.Int32) {
            throw new ArgumentException("invalid column or type mismatch for: " + colName);
        }
        int off = col.offset;
        this.data[off] = (byte)(val & 255);
        this.data[off + 1] = (byte)((val >> 8) & 255);
        this.data[off + 2] = (byte)((val >> 16) & 255);
        this.data[off + 3] = (byte)((val >> 24) & 255);
    }

    public int GetInt32(string colName) {
        RecordColumn col = this.schema.FindColumn(colName);
        if (col == null || col.dataType != RecordDataType.Int32) {
            throw new ArgumentException("invalid column or type mismatch for: " + colName);
        }
        int off = col.offset;
        int b0 = (int)this.data[off] & 255;
        int b1 = ((int)this.data[off + 1] & 255) << 8;
        int b2 = ((int)this.data[off + 2] & 255) << 16;
        int b3 = ((int)this.data[off + 3] & 255) << 24;
        return b0 | b1 | b2 | b3;
    }

    public void SetInt64(string colName, long val) {
        RecordColumn col = this.schema.FindColumn(colName);
        if (col == null || col.dataType != RecordDataType.Int64) {
            throw new ArgumentException("invalid column or type mismatch for: " + colName);
        }
        int off = col.offset;
        for (int i = 0; i < 8; i = i + 1) {
            this.data[off + i] = (byte)((val >> (i * 8)) & 255L);
        }
    }

    public long GetInt64(string colName) {
        RecordColumn col = this.schema.FindColumn(colName);
        if (col == null || col.dataType != RecordDataType.Int64) {
            throw new ArgumentException("invalid column or type mismatch for: " + colName);
        }
        int off = col.offset;
        long res = 0L;
        for (int i = 0; i < 8; i = i + 1) {
            res = res | (((long)this.data[off + i] & 255L) << (i * 8));
        }
        return res;
    }

    public void SetFloat32(string colName, float val) {
        RecordColumn col = this.schema.FindColumn(colName);
        if (col == null || col.dataType != RecordDataType.Float32) {
            throw new ArgumentException("invalid column or type mismatch for: " + colName);
        }
        int u = BitConverter.SingleToInt32Bits(val);
        int off = col.offset;
        this.data[off] = (byte)(u & 255);
        this.data[off + 1] = (byte)((u >> 8) & 255);
        this.data[off + 2] = (byte)((u >> 16) & 255);
        this.data[off + 3] = (byte)((u >> 24) & 255);
    }

    public float GetFloat32(string colName) {
        RecordColumn col = this.schema.FindColumn(colName);
        if (col == null || col.dataType != RecordDataType.Float32) {
            throw new ArgumentException("invalid column or type mismatch for: " + colName);
        }
        int off = col.offset;
        int u = ((int)this.data[off] & 255) | (((int)this.data[off + 1] & 255) << 8) |
                (((int)this.data[off + 2] & 255) << 16) | (((int)this.data[off + 3] & 255) << 24);
        return BitConverter.Int32BitsToSingle(u);
    }

    public void SetFloat64(string colName, double val) {
        RecordColumn col = this.schema.FindColumn(colName);
        if (col == null || col.dataType != RecordDataType.Float64) {
            throw new ArgumentException("invalid column or type mismatch for: " + colName);
        }
        long u = BitConverter.DoubleToInt64Bits(val);
        int off = col.offset;
        for (int i = 0; i < 8; i = i + 1) {
            this.data[off + i] = (byte)((u >> (i * 8)) & 255L);
        }
    }

    public double GetFloat64(string colName) {
        RecordColumn col = this.schema.FindColumn(colName);
        if (col == null || col.dataType != RecordDataType.Float64) {
            throw new ArgumentException("invalid column or type mismatch for: " + colName);
        }
        int off = col.offset;
        long u = 0L;
        for (int i = 0; i < 8; i = i + 1) {
            u = u | (((long)this.data[off + i] & 255L) << (i * 8));
        }
        return BitConverter.Int64BitsToDouble(u);
    }

    public void SetStr(string colName, string val) {
        RecordColumn col = this.schema.FindColumn(colName);
        if (col == null) {
            throw new ArgumentException("invalid column: " + colName);
        }
        if (col.dataType == RecordDataType.VarStr) {
            this.SetVarStr(colName, val);
            return;
        }
        if (col.dataType != RecordDataType.FixedStr) {
            throw new ArgumentException("column is not string type: " + colName);
        }
        int off = col.offset;
        int max = col.fixedLen;
        byte[] bytes = val != null ? Encoding.GetBytes(val) : new byte[0];
        int len = bytes != null ? bytes.Length : 0;
        if (len > max) { len = max; }
        for (int i = 0; i < len; i = i + 1) {
            this.data[off + i] = bytes[i];
        }
        for (int i = len; i < max; i = i + 1) {
            this.data[off + i] = 0;
        }
    }

    public string GetStr(string colName) {
        RecordColumn col = this.schema.FindColumn(colName);
        if (col == null) {
            throw new ArgumentException("invalid column: " + colName);
        }
        if (col.dataType == RecordDataType.VarStr) {
            return this.GetVarStr(colName);
        }
        if (col.dataType != RecordDataType.FixedStr) {
            throw new ArgumentException("column is not string type: " + colName);
        }
        int off = col.offset;
        int max = col.fixedLen;
        int len = 0;
        while (len < max && this.data[off + len] != 0) {
            len = len + 1;
        }
        if (len == 0) { return ""; }
        return Encoding.GetString(this.data, off, len);
    }

    public void SetBool(string colName, bool val) {
        RecordColumn col = this.schema.FindColumn(colName);
        if (col == null || col.dataType != RecordDataType.Bool) {
            throw new ArgumentException("invalid column or type mismatch for: " + colName);
        }
        int off = col.offset;
        this.data[off] = (byte)(val ? 1 : 0);
        this.data[off + 1] = 0;
        this.data[off + 2] = 0;
        this.data[off + 3] = 0;
    }

    public bool GetBool(string colName) {
        RecordColumn col = this.schema.FindColumn(colName);
        if (col == null || col.dataType != RecordDataType.Bool) {
            throw new ArgumentException("invalid column or type mismatch for: " + colName);
        }
        return this.data[col.offset] != 0;
    }

    // ---- 预解析高速存取器（结合 RecordBinding 消除每行列名哈希与线性探针）----
    public void SetInt32Fast(RecordColumn col, int val) {
        if (col == null) { return; }
        int off = col.offset;
        this.data[off] = (byte)(val & 255);
        this.data[off + 1] = (byte)((val >> 8) & 255);
        this.data[off + 2] = (byte)((val >> 16) & 255);
        this.data[off + 3] = (byte)((val >> 24) & 255);
    }

    public int GetInt32Fast(RecordColumn col) {
        if (col == null) { return 0; }
        int off = col.offset;
        int b0 = (int)this.data[off] & 255;
        int b1 = ((int)this.data[off + 1] & 255) << 8;
        int b2 = ((int)this.data[off + 2] & 255) << 16;
        int b3 = ((int)this.data[off + 3] & 255) << 24;
        return b0 | b1 | b2 | b3;
    }

    public void SetInt64Fast(RecordColumn col, long val) {
        if (col == null) { return; }
        int off = col.offset;
        for (int i = 0; i < 8; i = i + 1) {
            this.data[off + i] = (byte)((val >> (i * 8)) & 255L);
        }
    }

    public long GetInt64Fast(RecordColumn col) {
        if (col == null) { return 0L; }
        int off = col.offset;
        long res = 0L;
        for (int i = 0; i < 8; i = i + 1) {
            res = res | (((long)this.data[off + i] & 255L) << (i * 8));
        }
        return res;
    }

    public void SetFloat64Fast(RecordColumn col, double val) {
        if (col == null) { return; }
        long u = BitConverter.DoubleToInt64Bits(val);
        int off = col.offset;
        for (int i = 0; i < 8; i = i + 1) {
            this.data[off + i] = (byte)((u >> (i * 8)) & 255L);
        }
    }

    public double GetFloat64Fast(RecordColumn col) {
        if (col == null) { return 0.0; }
        int off = col.offset;
        long u = 0L;
        for (int i = 0; i < 8; i = i + 1) {
            u = u | (((long)this.data[off + i] & 255L) << (i * 8));
        }
        return BitConverter.Int64BitsToDouble(u);
    }

    public void SetBoolFast(RecordColumn col, bool val) {
        if (col == null) { return; }
        int off = col.offset;
        this.data[off] = (byte)(val ? 1 : 0);
        this.data[off + 1] = 0;
        this.data[off + 2] = 0;
        this.data[off + 3] = 0;
    }

    public bool GetBoolFast(RecordColumn col) {
        if (col == null) { return false; }
        return this.data[col.offset] != 0;
    }

    public void SetStrFast(RecordColumn col, string val) {
        if (col == null) { return; }
        if (col.dataType == RecordDataType.VarStr) {
            this.SetVarStr(col.name, val);
            return;
        }
        int off = col.offset;
        int max = col.fixedLen;
        byte[] bytes = val != null ? Encoding.GetBytes(val) : new byte[0];
        int len = bytes != null ? bytes.Length : 0;
        if (len > max) { len = max; }
        for (int i = 0; i < len; i = i + 1) {
            this.data[off + i] = bytes[i];
        }
        for (int i = len; i < max; i = i + 1) {
            this.data[off + i] = 0;
        }
    }

    public string GetStrFast(RecordColumn col) {
        if (col == null) { return ""; }
        if (col.dataType == RecordDataType.VarStr) {
            return this.GetVarStr(col.name);
        }
        int off = col.offset;
        int max = col.fixedLen;
        int len = 0;
        while (len < max && this.data[off + len] != 0) {
            len = len + 1;
        }
        if (len == 0) { return ""; }
        return Encoding.GetString(this.data, off, len);
    }

    // 变长文本写入：暂存内容，落盘时追加至 .zblob 并回写 (offset, len)
    public void SetVarStr(string colName, string val) {
        RecordColumn col = this.schema.FindColumn(colName);
        if (col == null || col.dataType != RecordDataType.VarStr) {
            throw new ArgumentException("invalid column or type mismatch for: " + colName);
        }
        this.varStrs[colName] = val != null ? val : "";
    }

    // 变长文本读取：若有缓存则直接返回，否则直读 .zblob
    public string GetVarStr(string colName) {
        RecordColumn col = this.schema.FindColumn(colName);
        if (col == null || col.dataType != RecordDataType.VarStr) {
            throw new ArgumentException("invalid column or type mismatch for: " + colName);
        }
        if (this.varStrs.ContainsKey(colName)) {
            return this.varStrs[colName];
        }
        int off = col.offset;
        int bOff = ((int)this.data[off] & 255) | (((int)this.data[off + 1] & 255) << 8) |
                   (((int)this.data[off + 2] & 255) << 16) | (((int)this.data[off + 3] & 255) << 24);
        int bLen = ((int)this.data[off + 4] & 255) | (((int)this.data[off + 5] & 255) << 8) |
                   (((int)this.data[off + 6] & 255) << 16) | (((int)this.data[off + 7] & 255) << 24);
        if (bLen <= 0) { return ""; }
        if (this.table == null || !this.table.IsOpen()) {
            throw new InvalidOperationException("cannot fetch VarStr without open RecordTable connection");
        }
        byte[] raw = this.table.ReadBlobBytesLocked((long)bOff, bLen);
        string res = raw != null ? Encoding.GetString(raw, 0, raw.Length) : "";
        this.varStrs[colName] = res;
        return res;
    }

    // 原始字节块写入
    public void SetBlob(string colName, byte[] val) {
        RecordColumn col = this.schema.FindColumn(colName);
        if (col == null || col.dataType != RecordDataType.Blob) {
            throw new ArgumentException("invalid column or type mismatch for: " + colName);
        }
        this.blobs[colName] = val != null ? val : new byte[0];
    }

    // 原始字节块读取
    public byte[] GetBlob(string colName) {
        RecordColumn col = this.schema.FindColumn(colName);
        if (col == null || col.dataType != RecordDataType.Blob) {
            throw new ArgumentException("invalid column or type mismatch for: " + colName);
        }
        if (this.blobs.ContainsKey(colName)) {
            return this.blobs[colName];
        }
        int off = col.offset;
        int bOff = ((int)this.data[off] & 255) | (((int)this.data[off + 1] & 255) << 8) |
                   (((int)this.data[off + 2] & 255) << 16) | (((int)this.data[off + 3] & 255) << 24);
        int bLen = ((int)this.data[off + 4] & 255) | (((int)this.data[off + 5] & 255) << 8) |
                   (((int)this.data[off + 6] & 255) << 16) | (((int)this.data[off + 7] & 255) << 24);
        if (bLen <= 0) { return new byte[0]; }
        if (this.table == null || !this.table.IsOpen()) {
            throw new InvalidOperationException("cannot fetch Blob without open RecordTable connection");
        }
        byte[] raw = this.table.ReadBlobBytesLocked((long)bOff, bLen);
        this.blobs[colName] = raw;
        return raw;
    }
}

// 工业级纯二进制结构化表格引擎（RecordTable）
// 1. .ztab 扁平二进制文件，O(1) 绝对物理寻址：offset = DataOffset + (id - 1) * RowBytes
// 2. 彻底绝缘 JsonValue，0 堆装箱，0 Tape 转义
// 3. 伴生 .zblob 变长文本与 BLOB 存储池，8 字节行内指针，Vacuum 紧凑回收
// 4. 伴生 .zidx 二级索引文件持久化，O(1) 启动直读与脏退出自愈重建；支持有序索引与范围查询
// 5. 伴生 .zwal 预写日志与事务屏障：CRC32 校验帧、Torn Tail 截断自愈、Commit/Rollback 原子回滚
// 6. 独立表级并发读写锁（RwLock tlock）与 CRT I/O 原子锁（ioMtx），彻底解耦整库大锁
// 7. 墓碑软删除防 ID 漂移 + System.Linq.ExprNode 编译期语法树下推求值器
public class RecordTable {
    public static string MAGIC_TAB = "ZTAB";
    public static string MAGIC_BLOB = "ZBLB";
    public static string MAGIC_IDX = "ZIDX";
    public static string MAGIC_WAL = "ZWAL";
    public static int VERSION = 1;
    public static int HEADER_SIZE = 64;
    public static int BLOB_HEADER_SIZE = 32;
    public static int IDX_HEADER_SIZE = 32;
    public static int WAL_HEADER_SIZE = 32;

    public static int OP_ADD = 1;
    public static int OP_UPDATE = 2;
    public static int OP_DELETE = 3;
    public static int OP_BATCH = 4;
    public static int WAL_MAX_FRAME = 67108864; // 64MB

    public string name;
    public string tableName;
    public string basePath;
    public string tabPath;
    public string blobPath;
    public string idxPath;
    public string walPath;
    public PageFile file;
    public PageFile blobFile;
    public PageFile walFile;
    public RecordSchema schema;
    public int totalRows;
    public int activeRows;
    public long dataOffset;
    public long blobTotalBytes;
    public long walValidSize;
    public long lastTxSeq;
    public bool inTx;
    public List<RecordTxOp> txOps;
    public RwLock tlock;
    public nint ioMtx;
    public string lastError;

    // 内存软删除墓碑集
    public Dictionary<int, bool> tombstones;
    // 内存二级索引映射：colName -> (colVal -> List<id>)
    public Dictionary<string, Dictionary<string, List<int>>> indexes;
    // 内存有序键序列：colName -> List<sortedKey>
    public Dictionary<string, List<string>> indexKeysSorted;

    public RecordTable() {
        this.name = "";
        this.tableName = "";
        this.basePath = "";
        this.tabPath = "";
        this.blobPath = "";
        this.idxPath = "";
        this.walPath = "";
        this.file = null;
        this.blobFile = null;
        this.walFile = null;
        this.schema = null;
        this.totalRows = 0;
        this.activeRows = 0;
        this.dataOffset = 64;
        this.blobTotalBytes = 32L;
        this.walValidSize = 32L;
        this.lastTxSeq = 0L;
        this.inTx = false;
        this.txOps = new List<RecordTxOp>();
        this.tlock = new RwLock();
        this.ioMtx = Mutex.Create();
        this.lastError = "";
        this.tombstones = new Dictionary<int, bool>();
        this.indexes = new Dictionary<string, Dictionary<string, List<int>>>();
        this.indexKeysSorted = new Dictionary<string, List<string>>();
    }

    public bool IsOpen() {
        return this.file != null && this.file.IsOpen() && this.lastError == "";
    }

    public string GetError() { return this.lastError; }
    public int Count() { return this.activeRows; }
    public int TotalRows() { return this.totalRows; }
    public RecordSchema Schema() { return this.schema; }

    public RecordRow NewRow() {
        return new RecordRow(this.schema, new byte[this.schema.rowBytes], 0, true, this);
    }

    public int AddBulk(List<RecordRow> rows) {
        int firstId = 0;
        this.AddBulk(rows, out firstId);
        return firstId;
    }

    public bool Update(RecordRow row) {
        if (row == null) { return false; }
        return this.Update(row.id, row);
    }

    // 校验表名合法性（严格阻断路径穿越，如 `../`, `..\\`, 绝对路径等 CWE-22 漏洞）
    public static bool IsValidTableName(string name) {
        if (name == null || name.Length == 0 || name.Length > 64) {
            return false;
        }
        for (int i = 0; i < name.Length; i = i + 1) {
            char c = name[i];
            bool ok = (c >= 'a' && c <= 'z') ||
                      (c >= 'A' && c <= 'Z') ||
                      (c >= '0' && c <= '9') ||
                      c == '_' || c == '-';
            if (!ok) {
                return false;
            }
        }
        return true;
    }

    // 打开或创建表（schema 为 null 时从已有 .ztab 元数据自动反序列化）
    public static RecordTable Open(string basePath, string name, RecordSchema schema = null) {
        if (basePath == null || basePath.Length == 0) {
            throw new ArgumentException("basePath cannot be null or empty");
        }
        if (!RecordTable.IsValidTableName(name)) {
            throw new ArgumentException("invalid tableName '" + name + "': must be 1-64 characters containing only alphanumeric, '_' or '-'");
        }
        RecordTable rt = new RecordTable();
        rt.name = name;
        rt.tableName = name;
        rt.basePath = basePath;
        rt.tabPath = basePath + "." + name + ".ztab";
        rt.blobPath = basePath + "." + name + ".zblob";
        rt.idxPath = basePath + "." + name + ".zidx";
        rt.walPath = basePath + "." + name + ".zwal";

        bool exists = File.Exists(rt.tabPath);
        if (exists) {
            rt.file = PageFile.OpenExisting(rt.tabPath);
            if (!rt.file.IsOpen()) {
                rt.lastError = "cannot open existing ztab file: " + rt.file.GetError();
                return rt;
            }

            long fsize = rt.file.Size();
            if (fsize < (long)HEADER_SIZE) {
                rt.lastError = "truncated ztab header: file size smaller than header";
                rt.file.Close();
                return rt;
            }

            ByteBuffer h = ByteBuffer.Alloc(HEADER_SIZE);
            if (rt.file.ReadAt(0, h, HEADER_SIZE) != HEADER_SIZE) {
                h.Free();
                rt.lastError = "truncated ztab header";
                rt.file.Close();
                return rt;
            }
            h.SeekRead(0);
            string magic = h.Str(0, 4);
            h.SeekRead(4);
            int ver = (int)h.ReadU32();
            int rowBytes = (int)h.ReadU32();
            int colCount = (int)h.ReadU32();
            long total = h.ReadU64();
            long active = h.ReadU64();
            long schemaOffset = h.ReadU64();
            long schemaBytes = h.ReadU64();
            long dataOffset = h.ReadU64();
            h.Free();

            if (magic != MAGIC_TAB || ver != VERSION) {
                rt.lastError = "invalid ztab magic or version";
                rt.file.Close();
                return rt;
            }

            // 防御性头部边界校验：阻断整型溢出与畸形文件导致的内存耗尽 / 崩溃
            if (rowBytes < 4 || rowBytes > 1048576 || (rowBytes % 4) != 0 ||
                colCount < 0 || colCount > 4096 ||
                schemaOffset < (long)HEADER_SIZE || schemaBytes <= 0L || schemaBytes > 4194304L ||
                dataOffset < schemaOffset + schemaBytes ||
                total < 0L || active < 0L || active > total) {
                rt.lastError = "corrupted ztab header bounds";
                rt.file.Close();
                return rt;
            }

            if (fsize < dataOffset + total * (long)rowBytes) {
                rt.lastError = "truncated ztab data: file size smaller than header records";
                rt.file.Close();
                return rt;
            }

            // 读取 Schema
            ByteBuffer sb = ByteBuffer.Alloc((int)schemaBytes);
            if (rt.file.ReadAt(schemaOffset, sb, (int)schemaBytes) != (int)schemaBytes) {
                sb.Free();
                rt.lastError = "truncated ztab schema";
                rt.file.Close();
                return rt;
            }
            sb.SeekRead(0);
            rt.schema = RecordSchema.Deserialize(sb);
            sb.Free();

            rt.totalRows = (int)total;
            rt.activeRows = (int)active;
            rt.dataOffset = dataOffset;

            // 扫描墓碑状态
            if (rt.totalRows > rt.activeRows) {
                ByteBuffer flagBuf = ByteBuffer.Alloc(1);
                for (int id = 1; id <= rt.totalRows; id = id + 1) {
                    long off = rt.dataOffset + (long)(id - 1) * (long)rt.schema.rowBytes;
                    if (rt.file.ReadAt(off, flagBuf, 1) == 1) {
                        flagBuf.SeekRead(0);
                        int fl = flagBuf.ReadU8();
                        if (fl == 0) { rt.tombstones[id] = true; }
                    }
                }
                flagBuf.Free();
            }

            // 打开伴生 .zblob
            rt.OpenOrCreateBlobFileLocked();

            // 尝试从 .zidx 持久化文件极速恢复二级索引
            rt.LoadIndexesLocked();

            // 打开伴生 .zwal 预写日志并自愈重放
            rt.OpenOrCreateWalFileLocked();
        } else {
            if (schema == null || schema.columns.Count == 0) {
                rt.lastError = "schema must be provided for new RecordTable";
                return rt;
            }
            rt.schema = schema;
            rt.file = PageFile.Open(rt.tabPath);
            if (!rt.file.IsOpen()) {
                rt.lastError = "cannot create ztab file: " + rt.file.GetError();
                return rt;
            }

            // 序列化 Schema
            ByteBuffer sb = schema.Serialize();
            int sbytes = sb.Length();
            long schemaOffset = 64L;
            // 对齐到 64 字节边界
            int rem = sbytes % 64;
            int paddedSbytes = rem == 0 ? sbytes : sbytes + (64 - rem);
            long dataOffset = schemaOffset + (long)paddedSbytes;
            rt.dataOffset = dataOffset;
            rt.totalRows = 0;
            rt.activeRows = 0;

            // 写入 Schema 块
            rt.file.WriteAt(schemaOffset, sb.Raw(), sbytes);
            sb.Free();

            // 写入 64 字节头部
            rt.WriteHeaderLocked();

            // 初始化伴生 .zblob
            rt.OpenOrCreateBlobFileLocked();

            // 初始化伴生 .zwal 预写日志
            rt.OpenOrCreateWalFileLocked();
        }
        return rt;
    }

    public void OpenOrCreateBlobFileLocked() {
        bool blobExists = File.Exists(this.blobPath);
        if (blobExists) {
            this.blobFile = PageFile.OpenExisting(this.blobPath);
            if (this.blobFile != null && this.blobFile.IsOpen()) {
                ByteBuffer bh = ByteBuffer.Alloc(BLOB_HEADER_SIZE);
                if (this.blobFile.ReadAt(0, bh, BLOB_HEADER_SIZE) == BLOB_HEADER_SIZE) {
                    bh.SeekRead(0);
                    string bMagic = bh.Str(0, 4);
                    bh.SeekRead(4);
                    int bVer = (int)bh.ReadU32();
                    long tBytes = bh.ReadU64();
                    if (bMagic == MAGIC_BLOB && bVer == VERSION && tBytes >= (long)BLOB_HEADER_SIZE) {
                        this.blobTotalBytes = tBytes;
                    } else {
                        this.blobTotalBytes = (long)this.blobFile.Size();
                    }
                } else {
                    this.blobTotalBytes = (long)this.blobFile.Size();
                }
                bh.Free();
            }
        } else {
            this.blobFile = PageFile.Open(this.blobPath);
            if (this.blobFile != null && this.blobFile.IsOpen()) {
                this.blobTotalBytes = 32L;
                ByteBuffer bh = ByteBuffer.Alloc(BLOB_HEADER_SIZE);
                bh.WriteRaw(MAGIC_BLOB, 4);
                bh.WriteU32((long)VERSION);
                bh.WriteU64(32L);
                bh.WriteU64(0L); // reserved
                bh.WriteU64(0L);
                this.blobFile.WriteAt(0, bh.Raw(), BLOB_HEADER_SIZE);
                bh.Free();
            }
        }
    }

    public void WriteBlobHeaderLocked() {
        if (this.blobFile == null || !this.blobFile.IsOpen()) { return; }
        ByteBuffer bh = ByteBuffer.Alloc(BLOB_HEADER_SIZE);
        bh.WriteRaw(MAGIC_BLOB, 4);
        bh.WriteU32((long)VERSION);
        bh.WriteU64(this.blobTotalBytes);
        bh.WriteU64(0L);
        bh.WriteU64(0L);
        Mutex.Lock(this.ioMtx);
        try {
            this.blobFile.WriteAt(0, bh.Raw(), BLOB_HEADER_SIZE);
        } finally {
            Mutex.Unlock(this.ioMtx);
            bh.Free();
        }
    }

    public void WriteHeaderLocked() {
        ByteBuffer h = ByteBuffer.Alloc(HEADER_SIZE);
        h.WriteRaw(MAGIC_TAB, 4);
        h.WriteU32((long)VERSION);
        h.WriteU32((long)this.schema.rowBytes);
        h.WriteU32((long)this.schema.columns.Count);
        h.WriteU64((long)this.totalRows);
        h.WriteU64((long)this.activeRows);
        h.WriteU64(64L); // schemaOffset
        h.WriteU64(this.dataOffset - 64L); // schemaBytes (aligned)
        h.WriteU64(this.dataOffset);
        h.WriteU64(0L); // reserved
        Mutex.Lock(this.ioMtx);
        try {
            this.file.WriteAt(0, h.Raw(), HEADER_SIZE);
        } finally {
            Mutex.Unlock(this.ioMtx);
            h.Free();
        }
    }

    // 打开或创建伴生 .zwal 预写日志
    public void OpenOrCreateWalFileLocked() {
        bool walExists = File.Exists(this.walPath);
        if (walExists) {
            this.walFile = PageFile.OpenExisting(this.walPath);
            if (this.walFile != null && this.walFile.IsOpen()) {
                int fsize = this.walFile.Size();
                if (fsize < WAL_HEADER_SIZE) {
                    this.ResetWalLocked();
                } else {
                    ByteBuffer wh = ByteBuffer.Alloc(WAL_HEADER_SIZE);
                    if (this.walFile.ReadAt(0, wh, WAL_HEADER_SIZE) == WAL_HEADER_SIZE) {
                        wh.SeekRead(0);
                        string wMagic = wh.Str(0, 4);
                        wh.SeekRead(4);
                        int wVer = (int)wh.ReadU32();
                        long cpSeq = wh.ReadU64();
                        wh.Free();
                        if (wMagic == MAGIC_WAL && wVer == VERSION) {
                            this.lastTxSeq = cpSeq;
                            this.walValidSize = (long)fsize;
                            // 重放未检查点日志并截断自愈撕裂尾
                            this.ReplayWalLocked();
                        } else {
                            this.ResetWalLocked();
                        }
                    } else {
                        wh.Free();
                        this.ResetWalLocked();
                    }
                }
            }
        } else {
            this.walFile = PageFile.Open(this.walPath);
            if (this.walFile != null && this.walFile.IsOpen()) {
                this.ResetWalLocked();
            }
        }
    }

    // 重放 WAL 日志并物理截断断电留下的撕裂尾
    public void ReplayWalLocked() {
        if (this.walFile == null || !this.walFile.IsOpen()) { return; }
        long fsize = (long)this.walFile.Size();
        if (fsize < (long)WAL_HEADER_SIZE) {
            this.walValidSize = 32L;
            return;
        }
        long off = (long)WAL_HEADER_SIZE;
        ByteBuffer hbuf = ByteBuffer.Alloc(8);
        bool replayedAny = false;

        while (off < fsize) {
            if (fsize - off < 8L) {
                // 尾部半写撕裂帧头，截断修复
                Mutex.Lock(this.ioMtx);
                this.walFile.Truncate(off);
                this.walFile.Sync();
                Mutex.Unlock(this.ioMtx);
                this.walValidSize = off;
                break;
            }

            this.walFile.ReadAt(off, hbuf, 8);
            hbuf.SeekRead(0);
            int plen = (int)hbuf.ReadU32();
            long crc = hbuf.ReadU32();

            if (plen <= 0 || plen > WAL_MAX_FRAME || (long)plen > fsize - off - 8L) {
                // 尾部半写撕裂，截断修复
                Mutex.Lock(this.ioMtx);
                this.walFile.Truncate(off);
                this.walFile.Sync();
                Mutex.Unlock(this.ioMtx);
                this.walValidSize = off;
                break;
            }

            ByteBuffer payload = ByteBuffer.Alloc(plen);
            this.walFile.ReadAt(off + 8L, payload, plen);
            int computedCrc = payload.Crc32(plen);
            if (computedCrc != (int)crc) {
                payload.Free();
                if (off + 8L + (long)plen == fsize) {
                    // 正好在末尾损坏，撕裂尾截断修复
                    Mutex.Lock(this.ioMtx);
                    this.walFile.Truncate(off);
                    this.walFile.Sync();
                    Mutex.Unlock(this.ioMtx);
                    this.walValidSize = off;
                    break;
                } else {
                    // 中段损坏，拒绝隐蔽故障
                    throw new InvalidOperationException("corrupt WAL frame detected before tail in " + this.walPath);
                }
            }

            payload.SeekRead(0);
            long seq = payload.ReadU64();
            int op = payload.ReadU8();

            if (seq > this.lastTxSeq) {
                this.lastTxSeq = seq;
            }

            int rbytes = this.schema.rowBytes;
            if (op == OP_ADD || op == OP_UPDATE) {
                int id = (int)payload.ReadU32();
                byte[] rdata = new byte[rbytes];
                for (int j = 0; j < rbytes; j = j + 1) {
                    rdata[j] = (byte)payload.ReadU8();
                }
                long tabOff = this.dataOffset + (long)(id - 1) * (long)rbytes;
                Mutex.Lock(this.ioMtx);
                this.file.WriteAt(tabOff, (nint)rdata, rbytes);
                Mutex.Unlock(this.ioMtx);
                if (id > this.totalRows) { this.totalRows = id; }
                this.tombstones.Remove(id);
                RecordRow r = new RecordRow(this.schema, rdata, id, true, this);
                this.IndexRowLocked(r);
                replayedAny = true;
            } else if (op == OP_DELETE) {
                int id = (int)payload.ReadU32();
                RecordRow oldRow = this.GetLocked(id);
                if (oldRow != null) {
                    this.UnindexRowLocked(oldRow);
                }
                this.tombstones[id] = true;
                long tabOff = this.dataOffset + (long)(id - 1) * (long)rbytes;
                byte[] zeroFlag = new byte[1];
                zeroFlag[0] = 0;
                Mutex.Lock(this.ioMtx);
                this.file.WriteAt(tabOff, (nint)zeroFlag, 1);
                Mutex.Unlock(this.ioMtx);
                replayedAny = true;
            } else if (op == OP_BATCH) {
                int count = (int)payload.ReadU32();
                for (int k = 0; k < count; k = k + 1) {
                    int subOp = payload.ReadU8();
                    int id = (int)payload.ReadU32();
                    if (subOp == OP_ADD || subOp == OP_UPDATE) {
                        byte[] rdata = new byte[rbytes];
                        for (int j = 0; j < rbytes; j = j + 1) {
                            rdata[j] = (byte)payload.ReadU8();
                        }
                        long tabOff = this.dataOffset + (long)(id - 1) * (long)rbytes;
                        Mutex.Lock(this.ioMtx);
                        this.file.WriteAt(tabOff, (nint)rdata, rbytes);
                        Mutex.Unlock(this.ioMtx);
                        if (id > this.totalRows) { this.totalRows = id; }
                        this.tombstones.Remove(id);
                        RecordRow r = new RecordRow(this.schema, rdata, id, true, this);
                        this.IndexRowLocked(r);
                    } else if (subOp == OP_DELETE) {
                        RecordRow oldRow = this.GetLocked(id);
                        if (oldRow != null) {
                            this.UnindexRowLocked(oldRow);
                        }
                        this.tombstones[id] = true;
                        long tabOff = this.dataOffset + (long)(id - 1) * (long)rbytes;
                        byte[] zeroFlag = new byte[1];
                        zeroFlag[0] = 0;
                        Mutex.Lock(this.ioMtx);
                        this.file.WriteAt(tabOff, (nint)zeroFlag, 1);
                        Mutex.Unlock(this.ioMtx);
                    }
                }
                replayedAny = true;
            }

            payload.Free();
            off = off + 8L + (long)plen;
            this.walValidSize = off;
        }
        hbuf.Free();

        if (replayedAny) {
            this.activeRows = this.totalRows - this.tombstones.Count;
            this.WriteHeaderLocked();
        }
    }

    // 追加带 CRC32 校验帧的 WAL 记录并强制落盘
    public void AppendWalFrameLocked(long seq, int op, ByteBuffer payload) {
        if (this.walFile == null || !this.walFile.IsOpen()) { return; }
        int plen = payload.Length();
        int crc = payload.Crc32(plen);
        ByteBuffer frame = ByteBuffer.Alloc(8 + plen);
        frame.WriteU32((long)plen);
        frame.WriteU32((long)crc);
        frame.WriteRaw(payload.Raw(), plen);
        long off = this.walValidSize;
        Mutex.Lock(this.ioMtx);
        try {
            this.walFile.WriteAt(off, frame.Raw(), 8 + plen);
            this.walValidSize = off + 8L + (long)plen;
            this.walFile.Sync();
        } finally {
            Mutex.Unlock(this.ioMtx);
            frame.Free();
        }
    }

    // 重置 WAL 预写日志（在 Checkpoint / Flush 时安全截断）
    public void ResetWalLocked() {
        if (this.walFile == null || !this.walFile.IsOpen()) { return; }
        ByteBuffer h = ByteBuffer.Alloc(WAL_HEADER_SIZE);
        h.WriteRaw(MAGIC_WAL, 4);
        h.WriteU32((long)VERSION);
        h.WriteU64(this.lastTxSeq);
        h.WriteU64(0L); // reserved
        h.WriteU64(0L);
        Mutex.Lock(this.ioMtx);
        try {
            this.walFile.WriteAt(0, h.Raw(), WAL_HEADER_SIZE);
            this.walFile.Truncate(32L);
            this.walFile.Sync();
            this.walValidSize = 32L;
        } finally {
            Mutex.Unlock(this.ioMtx);
            h.Free();
        }
    }

    // 开启事务
    public void BeginTransaction() {
        this.tlock.EnterWrite();
        try {
            this.inTx = true;
            this.txOps = new List<RecordTxOp>();
        } finally {
            this.tlock.ExitWrite();
        }
    }

    // 提交事务：将事务内所有暂存操作打包为一个原子 WAL 帧落盘并应用
    public void Commit() {
        this.tlock.EnterWrite();
        try {
            if (!this.inTx || this.txOps == null || this.txOps.Count == 0) {
                this.inTx = false;
                return;
            }

            int n = this.txOps.Count;
            int rbytes = this.schema.rowBytes;
            this.lastTxSeq = this.lastTxSeq + 1L;

            // 1. 打包原子 Batch 帧
            ByteBuffer b = ByteBuffer.Alloc(17 + n * (5 + rbytes));
            b.WriteU64(this.lastTxSeq);
            b.WriteU8(OP_BATCH);
            b.WriteU32((long)n);
            for (int i = 0; i < n; i = i + 1) {
                RecordTxOp op = this.txOps[i];
                b.WriteU8(op.opType);
                b.WriteU32((long)op.id);
                if (op.opType == OP_ADD || op.opType == OP_UPDATE) {
                    b.WriteRaw(op.row.data, rbytes);
                }
            }
            this.AppendWalFrameLocked(this.lastTxSeq, OP_BATCH, b);
            b.Free();

            // 2. 批量物理应用至 .ztab 文件
            for (int i = 0; i < n; i = i + 1) {
                RecordTxOp op = this.txOps[i];
                if (op.opType == OP_UPDATE || op.opType == OP_DELETE) {
                    RecordRow oldRow = this.GetLocked(op.id);
                    if (oldRow != null) {
                        this.UnindexRowLocked(oldRow);
                    }
                }
            }

            Mutex.Lock(this.ioMtx);
            try {
                for (int i = 0; i < n; i = i + 1) {
                    RecordTxOp op = this.txOps[i];
                    long off = this.dataOffset + (long)(op.id - 1) * (long)rbytes;
                    if (op.opType == OP_ADD || op.opType == OP_UPDATE) {
                        this.file.WriteAt(off, (nint)op.row.data, rbytes);
                        this.IndexRowLocked(op.row);
                    } else if (op.opType == OP_DELETE) {
                        byte[] zeroFlag = new byte[1];
                        zeroFlag[0] = 0;
                        this.file.WriteAt(off, (nint)zeroFlag, 1);
                    }
                }
            } finally {
                Mutex.Unlock(this.ioMtx);
            }

            this.WriteHeaderLocked();
            this.txOps.Clear();
            this.inTx = false;
        } finally {
            this.tlock.ExitWrite();
        }
    }

    // 回滚事务：丢弃全部暂存，零磁盘脏写
    public void Rollback() {
        this.tlock.EnterWrite();
        try {
            if (!this.inTx) { return; }
            if (this.txOps != null) {
                for (int i = 0; i < this.txOps.Count; i = i + 1) {
                    RecordTxOp op = this.txOps[i];
                    if (op.opType == OP_ADD) {
                        this.totalRows = this.totalRows - 1;
                        this.activeRows = this.activeRows - 1;
                    } else if (op.opType == OP_DELETE) {
                        this.tombstones.Remove(op.id);
                        this.activeRows = this.activeRows + 1;
                    }
                }
                this.txOps.Clear();
            }
            this.inTx = false;
        } finally {
            this.tlock.ExitWrite();
        }
    }

    // 追加 Blob 字节到 .zblob 文件
    public void AppendBlobBytesLocked(byte[] bytes, out int blobOffset, out int blobLen) {
        if (bytes == null || bytes.Length == 0) {
            blobOffset = 0;
            blobLen = 0;
            return;
        }
        if (this.blobFile == null || !this.blobFile.IsOpen()) {
            this.OpenOrCreateBlobFileLocked();
        }
        long off = this.blobTotalBytes;
        int len = bytes.Length;
        this.blobFile.WriteAt(off, (nint)bytes, len);
        this.blobTotalBytes = off + (long)len;
        this.WriteBlobHeaderLocked();
        blobOffset = (int)off;
        blobLen = len;
    }

    // 从 .zblob 读取 Blob 字节（防大内存 OOM 与越界读安全防护）
    public byte[] ReadBlobBytesLocked(long offset, int len) {
        if (len <= 0 || len > 67108864 || offset < (long)BLOB_HEADER_SIZE) { return new byte[0]; }
        if (this.blobFile == null || !this.blobFile.IsOpen()) {
            this.OpenOrCreateBlobFileLocked();
        }
        if (this.blobFile == null || !this.blobFile.IsOpen()) { return new byte[0]; }
        if (offset + (long)len > this.blobTotalBytes && offset + (long)len > (long)this.blobFile.Size()) {
            return new byte[0];
        }
        byte[] buf = new byte[len];
        Mutex.Lock(this.ioMtx);
        try {
            int n = this.blobFile.ReadRaw(offset, (nint)buf, len);
            if (n != len) { return new byte[0]; }
        } finally {
            Mutex.Unlock(this.ioMtx);
        }
        return buf;
    }

    // 辅助：将行的变长字段落盘到 .zblob 并把 (offset, len) 刷进行内存
    public void FlushRowBlobsLocked(RecordRow row) {
        if (row == null || this.schema == null) { return; }
        for (int i = 0; i < this.schema.columns.Count; i = i + 1) {
            RecordColumn col = this.schema.columns[i];
            if (col.dataType == RecordDataType.VarStr) {
                if (row.varStrs != null && row.varStrs.ContainsKey(col.name)) {
                    string s = row.varStrs[col.name];
                    byte[] bytes = s != null && s.Length > 0 ? Encoding.GetBytes(s) : new byte[0];
                    int bOff = 0;
                    int bLen = 0;
                    this.AppendBlobBytesLocked(bytes, out bOff, out bLen);
                    int off = col.offset;
                    row.data[off] = (byte)(bOff & 255);
                    row.data[off + 1] = (byte)((bOff >> 8) & 255);
                    row.data[off + 2] = (byte)((bOff >> 16) & 255);
                    row.data[off + 3] = (byte)((bOff >> 24) & 255);
                    row.data[off + 4] = (byte)(bLen & 255);
                    row.data[off + 5] = (byte)((bLen >> 8) & 255);
                    row.data[off + 6] = (byte)((bLen >> 16) & 255);
                    row.data[off + 7] = (byte)((bLen >> 24) & 255);
                }
            } else if (col.dataType == RecordDataType.Blob) {
                if (row.blobs != null && row.blobs.ContainsKey(col.name)) {
                    byte[] bytes = row.blobs[col.name];
                    int bOff = 0;
                    int bLen = 0;
                    this.AppendBlobBytesLocked(bytes, out bOff, out bLen);
                    int off = col.offset;
                    row.data[off] = (byte)(bOff & 255);
                    row.data[off + 1] = (byte)((bOff >> 8) & 255);
                    row.data[off + 2] = (byte)((bOff >> 16) & 255);
                    row.data[off + 3] = (byte)((bOff >> 24) & 255);
                    row.data[off + 4] = (byte)(bLen & 255);
                    row.data[off + 5] = (byte)((bLen >> 8) & 255);
                    row.data[off + 6] = (byte)((bLen >> 16) & 255);
                    row.data[off + 7] = (byte)((bLen >> 24) & 255);
                }
            }
        }
    }

    // 单行插入：分配自增 ID，纯二进制直写盘，WAL 顺序预写保障防撕裂
    public int Add(RecordRow row) {
        this.tlock.EnterWrite();
        try {
            if (!this.IsOpen()) { throw new InvalidOperationException("RecordTable is not open: " + this.GetError()); }
            if (row == null) { throw new ArgumentException("row cannot be null"); }
            if (this.totalRows >= 2147483647 || this.totalRows < 0) {
                throw new InvalidOperationException("RecordTable reached maximum 32-bit row limit (2,147,483,647)");
            }

            int id = this.totalRows + 1;
            row.id = id;
            row.isActive = true;
            row.table = this;
            row.data[0] = 1; // 活跃标志

            // 刷盘变长大字段
            this.FlushRowBlobsLocked(row);

            if (this.inTx) {
                RecordTxOp op = new RecordTxOp(OP_ADD, id, row);
                this.txOps.Add(op);
                this.totalRows = id;
                this.activeRows = this.activeRows + 1;
                return id;
            }

            // 非事务：先写入带 CRC32 帧的 WAL 预写日志
            this.lastTxSeq = this.lastTxSeq + 1L;
            int rbytes = this.schema.rowBytes;
            ByteBuffer b = ByteBuffer.Alloc(13 + rbytes);
            b.WriteU64(this.lastTxSeq);
            b.WriteU8(OP_ADD);
            b.WriteU32((long)id);
            b.WriteRaw(row.data, rbytes);
            this.AppendWalFrameLocked(this.lastTxSeq, OP_ADD, b);
            b.Free();

            long off = this.dataOffset + (long)(id - 1) * (long)rbytes;
            Mutex.Lock(this.ioMtx);
            try {
                this.file.WriteAt(off, (nint)row.data, rbytes);
            } finally {
                Mutex.Unlock(this.ioMtx);
            }

            this.totalRows = id;
            this.activeRows = this.activeRows + 1;
            this.WriteHeaderLocked();
            this.IndexRowLocked(row);
            return id;
        } finally {
            this.tlock.ExitWrite();
        }
    }

    // 批量直写盘：顺序物理写，WAL 批次帧保障原子性
    public void AddBulk(List<RecordRow> rows, out int firstId) {
        this.tlock.EnterWrite();
        try {
            firstId = 0;
            if (!this.IsOpen()) { throw new InvalidOperationException("RecordTable is not open: " + this.GetError()); }
            if (rows == null || rows.Count == 0) { return; }

            int n = rows.Count;
            if ((long)this.totalRows + (long)n > 2147483647L || this.totalRows < 0) {
                throw new InvalidOperationException("AddBulk exceeds maximum 32-bit row limit (2,147,483,647)");
            }
            int rbytes = this.schema.rowBytes;
            firstId = this.totalRows + 1;

            // 1. 先写大字段 blob 存储（自管理原子锁，避免与后续表文件锁重入）
            for (int i = 0; i < n; i = i + 1) {
                RecordRow r = rows[i];
                int id = firstId + i;
                r.id = id;
                r.isActive = true;
                r.table = this;
                r.data[0] = 1;
                this.FlushRowBlobsLocked(r);
            }

            // 2. 批量 WAL 帧写入
            this.lastTxSeq = this.lastTxSeq + 1L;
            ByteBuffer b = ByteBuffer.Alloc(17 + n * (5 + rbytes));
            b.WriteU64(this.lastTxSeq);
            b.WriteU8(OP_BATCH);
            b.WriteU32((long)n);
            for (int i = 0; i < n; i = i + 1) {
                RecordRow r = rows[i];
                b.WriteU8(OP_ADD);
                b.WriteU32((long)r.id);
                b.WriteRaw(r.data, rbytes);
            }
            this.AppendWalFrameLocked(this.lastTxSeq, OP_BATCH, b);
            b.Free();

            // 3. 批量物理写主表记录槽位
            Mutex.Lock(this.ioMtx);
            try {
                for (int i = 0; i < n; i = i + 1) {
                    RecordRow r = rows[i];
                    long off = this.dataOffset + (long)(r.id - 1) * (long)rbytes;
                    this.file.WriteAt(off, (nint)r.data, rbytes);
                    this.IndexRowLocked(r);
                }
            } finally {
                Mutex.Unlock(this.ioMtx);
            }

            this.totalRows = firstId + n - 1;
            this.activeRows = this.totalRows - this.tombstones.Count;
            this.WriteHeaderLocked();
        } finally {
            this.tlock.ExitWrite();
        }
    }

    // O(1) 绝对寻址点查：单次 ReadAt 物理直读
    public RecordRow Get(int id) {
        this.tlock.EnterRead();
        try {
            return this.GetLocked(id);
        } finally {
            this.tlock.ExitRead();
        }
    }

    public RecordRow GetLocked(int id) {
        if (!this.IsOpen() || id <= 0 || id > this.totalRows || this.tombstones.ContainsKey(id)) {
            return null;
        }
        int rbytes = this.schema.rowBytes;
        byte[] buf = new byte[rbytes];
        long off = this.dataOffset + (long)(id - 1) * (long)rbytes;

        Mutex.Lock(this.ioMtx);
        try {
            int n = this.file.ReadRaw(off, (nint)buf, rbytes);
            if (n != rbytes) { return null; }
        } finally {
            Mutex.Unlock(this.ioMtx);
        }

        if (buf[0] == 0) {
            this.tombstones[id] = true;
            return null;
        }
        return new RecordRow(this.schema, buf, id, true, this);
    }

    // 按主键就地更新：修改物理文件对应槽位
    public bool Update(int id, RecordRow row) {
        this.tlock.EnterWrite();
        try {
            if (!this.IsOpen() || id <= 0 || id > this.totalRows || this.tombstones.ContainsKey(id)) {
                return false;
            }
            RecordRow oldRow = this.GetLocked(id);
            if (oldRow != null) {
                this.UnindexRowLocked(oldRow);
            }
            row.id = id;
            row.isActive = true;
            row.table = this;
            row.data[0] = 1;

            this.FlushRowBlobsLocked(row);

            if (this.inTx) {
                RecordTxOp op = new RecordTxOp(OP_UPDATE, id, row);
                this.txOps.Add(op);
                return true;
            }

            this.lastTxSeq = this.lastTxSeq + 1L;
            int rbytes = this.schema.rowBytes;
            ByteBuffer b = ByteBuffer.Alloc(13 + rbytes);
            b.WriteU64(this.lastTxSeq);
            b.WriteU8(OP_UPDATE);
            b.WriteU32((long)id);
            b.WriteRaw(row.data, rbytes);
            this.AppendWalFrameLocked(this.lastTxSeq, OP_UPDATE, b);
            b.Free();

            long off = this.dataOffset + (long)(id - 1) * (long)rbytes;
            Mutex.Lock(this.ioMtx);
            try {
                this.file.WriteAt(off, (nint)row.data, rbytes);
            } finally {
                Mutex.Unlock(this.ioMtx);
            }
            this.IndexRowLocked(row);
            return true;
        } finally {
            this.tlock.ExitWrite();
        }
    }

    // 软删除（墓碑机制）：置 flags = 0，保持物理槽位稳定，零 ID 漂移
    public bool Delete(int id) {
        this.tlock.EnterWrite();
        try {
            if (!this.IsOpen() || id <= 0 || id > this.totalRows || this.tombstones.ContainsKey(id)) {
                return false;
            }
            RecordRow oldRow = this.GetLocked(id);
            if (oldRow != null) {
                this.UnindexRowLocked(oldRow);
            }
            this.tombstones[id] = true;
            this.activeRows = this.activeRows - 1;

            if (this.inTx) {
                RecordTxOp op = new RecordTxOp(OP_DELETE, id, null);
                this.txOps.Add(op);
                return true;
            }

            this.lastTxSeq = this.lastTxSeq + 1L;
            ByteBuffer b = ByteBuffer.Alloc(13);
            b.WriteU64(this.lastTxSeq);
            b.WriteU8(OP_DELETE);
            b.WriteU32((long)id);
            this.AppendWalFrameLocked(this.lastTxSeq, OP_DELETE, b);
            b.Free();

            long off = this.dataOffset + (long)(id - 1) * (long)this.schema.rowBytes;
            byte[] zeroFlag = new byte[1];
            zeroFlag[0] = 0;

            Mutex.Lock(this.ioMtx);
            try {
                this.file.WriteAt(off, (nint)zeroFlag, 1);
            } finally {
                Mutex.Unlock(this.ioMtx);
            }
            this.WriteHeaderLocked();
            return true;
        } finally {
            this.tlock.ExitWrite();
        }
    }

    // 为列构建二级索引
    public void EnsureIndex(string colName) {
        this.tlock.EnterWrite();
        try {
            RecordColumn col = this.schema.FindColumn(colName);
            if (col != null) { colName = col.name; }
            if (this.indexes.ContainsKey(colName)) { return; }
            Dictionary<string, List<int>> idx = new Dictionary<string, List<int>>();
            this.indexes[colName] = idx;
            List<string> sortedKeys = new List<string>();
            this.indexKeysSorted[colName] = sortedKeys;

            // 扫描当前所有活跃行填充索引
            for (int id = 1; id <= this.totalRows; id = id + 1) {
                if (!this.tombstones.ContainsKey(id)) {
                    RecordRow r = this.GetLocked(id);
                    if (r != null) {
                        string key = this.ExtractColKey(r, colName);
                        if (key != null) {
                            if (!idx.ContainsKey(key)) {
                                idx[key] = new List<int>();
                                RecordTable.InsertSortedKey(sortedKeys, key);
                            }
                            idx[key].Add(id);
                        }
                    }
                }
            }
            this.SaveIndexesLocked();
        } finally {
            this.tlock.ExitWrite();
        }
    }

    public void IndexRowLocked(RecordRow r) {
        if (this.indexes.Count == 0 || r == null) { return; }
        for (int i = 0; i < this.schema.columns.Count; i = i + 1) {
            string colName = this.schema.columns[i].name;
            if (this.indexes.ContainsKey(colName)) {
                Dictionary<string, List<int>> idx = this.indexes[colName];
                string key = this.ExtractColKey(r, colName);
                if (key != null) {
                    if (!idx.ContainsKey(key)) {
                        idx[key] = new List<int>();
                        if (this.indexKeysSorted.ContainsKey(colName)) {
                            RecordTable.InsertSortedKey(this.indexKeysSorted[colName], key);
                        }
                    }
                    bool exists = false;
                    for (int j = 0; j < idx[key].Count; j = j + 1) {
                        if (idx[key][j] == r.id) {
                            exists = true;
                            break;
                        }
                    }
                    if (!exists) {
                        idx[key].Add(r.id);
                    }
                }
            }
        }
    }

    public void UnindexRowLocked(RecordRow r) {
        if (this.indexes.Count == 0 || r == null) { return; }
        for (int i = 0; i < this.schema.columns.Count; i = i + 1) {
            string colName = this.schema.columns[i].name;
            if (this.indexes.ContainsKey(colName)) {
                Dictionary<string, List<int>> idx = this.indexes[colName];
                string key = this.ExtractColKey(r, colName);
                if (key != null && idx.ContainsKey(key)) {
                    List<int> list = idx[key];
                    for (int j = 0; j < list.Count; j = j + 1) {
                        if (list[j] == r.id) {
                            list.RemoveAt(j);
                            break;
                        }
                    }
                    if (list.Count == 0) {
                        idx.Remove(key);
                        if (this.indexKeysSorted != null && this.indexKeysSorted.ContainsKey(colName)) {
                            RecordTable.RemoveSortedKey(this.indexKeysSorted[colName], key);
                        }
                    }
                }
            }
        }
    }

    public static string FormatIntKey(int v) {
        long u = (long)v + 2147483648L;
        return Convert.ToString(u).PadLeft(10, "0");
    }

    public static string FormatInt64Key(long v) {
        int hi = (int)(v >> 32);
        int lo = (int)(v & 4294967295L);
        long uHi = (long)hi + 2147483648L;
        long uLo = (long)lo & 4294967295L;
        return Convert.ToString(uHi).PadLeft(10, "0") + "_" + Convert.ToString(uLo).PadLeft(10, "0");
    }

    public static string FormatFloat64Key(double v) {
        long bits = BitConverter.DoubleToInt64Bits(v);
        if (bits < 0L) {
            long inv = ~bits;
            return "0_" + Convert.ToString(inv).PadLeft(19, "0");
        } else {
            return "1_" + Convert.ToString(bits).PadLeft(19, "0");
        }
    }

    public string NormalizeIndexKey(string colName, string val) {
        if (val == null) { return ""; }
        RecordColumn col = this.schema.FindColumn(colName);
        if (col == null) { return val; }
        if (col.dataType == RecordDataType.Int32) {
            try {
                return RecordTable.FormatIntKey(Convert.ToInt32(val));
            } catch (Exception e) {
                return val;
            }
        } else if (col.dataType == RecordDataType.Int64) {
            try {
                return RecordTable.FormatInt64Key(Convert.ToInt64(val));
            } catch (Exception e) {
                return val;
            }
        } else if (col.dataType == RecordDataType.Float64) {
            try {
                return RecordTable.FormatFloat64Key(Convert.ToDouble(val));
            } catch (Exception e) {
                return val;
            }
        }
        return val;
    }

    public static void RemoveSortedKey(List<string> list, string key) {
        if (list == null || key == null) { return; }
        int lo = 0;
        int hi = list.Count - 1;
        while (lo <= hi) {
            int mid = (lo + hi) / 2;
            int cmp = String.CompareOrdinal(list[mid], key);
            if (cmp == 0) {
                list.RemoveAt(mid);
                return;
            }
            if (cmp < 0) {
                lo = mid + 1;
            } else {
                hi = mid - 1;
            }
        }
    }

    public static void InsertSortedKey(List<string> list, string key) {
        if (list == null || key == null) { return; }
        int lo = 0;
        int hi = list.Count - 1;
        int ins = list.Count;
        while (lo <= hi) {
            int mid = (lo + hi) / 2;
            int cmp = String.CompareOrdinal(list[mid], key);
            if (cmp == 0) { return; }
            if (cmp < 0) {
                lo = mid + 1;
            } else {
                ins = mid;
                hi = mid - 1;
            }
        }
        if (lo > ins) { ins = lo; }
        if (ins >= list.Count) {
            list.Add(key);
        } else {
            list.Insert(ins, key);
        }
    }

    public string ExtractColKey(RecordRow r, string colName) {
        RecordColumn col = this.schema.FindColumn(colName);
        if (col == null) { return null; }
        if (col.dataType == RecordDataType.Int32) {
            return RecordTable.FormatIntKey(r.GetInt32(colName));
        } else if (col.dataType == RecordDataType.FixedStr) {
            return r.GetStr(colName);
        } else if (col.dataType == RecordDataType.VarStr) {
            return r.GetVarStr(colName);
        } else if (col.dataType == RecordDataType.Int64) {
            return RecordTable.FormatInt64Key(r.GetInt64(colName));
        } else if (col.dataType == RecordDataType.Float64) {
            return RecordTable.FormatFloat64Key(r.GetFloat64(colName));
        } else if (col.dataType == RecordDataType.Bool) {
            return r.GetBool(colName) ? "1" : "0";
        }
        return null;
    }

    public bool HasIndex(string colName) {
        if (this.indexes == null || colName == null) { return false; }
        if (this.indexes.ContainsKey(colName)) { return true; }
        RecordColumn col = this.schema.FindColumn(colName);
        if (col != null && this.indexes.ContainsKey(col.name)) {
            return true;
        }
        string lower = colName.ToLower();
        List<string> keys = this.indexes.Keys;
        for (int i = 0; i < keys.Count; i = i + 1) {
            if (keys[i].ToLower() == lower) { return true; }
        }
        return false;
    }

    // 二级索引键匹配 ID 列表
    public List<int> FindIdsByIndex(string colName, string val) {
        this.tlock.EnterRead();
        try {
            List<int> res = new List<int>();
            if (!this.indexes.ContainsKey(colName)) {
                RecordColumn col = this.schema.FindColumn(colName);
                if (col != null && this.indexes.ContainsKey(col.name)) {
                    colName = col.name;
                } else {
                    string lower = colName.ToLower();
                    List<string> keys = this.indexes.Keys;
                    for (int i = 0; i < keys.Count; i = i + 1) {
                        if (keys[i].ToLower() == lower) {
                            colName = keys[i];
                            break;
                        }
                    }
                }
            }
            if (!this.indexes.ContainsKey(colName)) {
                throw new InvalidOperationException("index not found on column: " + colName);
            }
            string searchKey = this.NormalizeIndexKey(colName, val);
            Dictionary<string, List<int>> idx = this.indexes[colName];
            if (!idx.ContainsKey(searchKey)) { return res; }
            List<int> ids = idx[searchKey];
            for (int i = 0; i < ids.Count; i = i + 1) {
                int id = ids[i];
                if (!this.tombstones.ContainsKey(id)) {
                    res.Add(id);
                }
            }
            return res;
        } finally {
            this.tlock.ExitRead();
        }
    }

    // 基于二级索引等值查找
    public List<RecordRow> FindByIndex(string colName, string val) {
        List<int> ids = this.FindIdsByIndex(colName, val);
        List<RecordRow> res = new List<RecordRow>();
        for (int i = 0; i < ids.Count; i = i + 1) {
            RecordRow r = this.Get(ids[i]);
            if (r != null) { res.Add(r); }
        }
        return res;
    }

    // 范围索引匹配 ID 列表（支持 <, <=, >, >=, BETWEEN）
    public List<int> FindIdsByRange(string colName, string lo, string hi) {
        this.tlock.EnterRead();
        try {
            List<int> res = new List<int>();
            if (!this.indexes.ContainsKey(colName)) {
                RecordColumn col = this.schema.FindColumn(colName);
                if (col != null && this.indexes.ContainsKey(col.name)) {
                    colName = col.name;
                } else {
                    string lower = colName.ToLower();
                    List<string> keys = this.indexes.Keys;
                    for (int i = 0; i < keys.Count; i = i + 1) {
                        if (keys[i].ToLower() == lower) {
                            colName = keys[i];
                            break;
                        }
                    }
                }
            }
            if (!this.indexes.ContainsKey(colName)) {
                throw new InvalidOperationException("index not found on column: " + colName);
            }
            string loKey = this.NormalizeIndexKey(colName, lo);
            string hiKey = this.NormalizeIndexKey(colName, hi);

            if (!this.indexKeysSorted.ContainsKey(colName)) {
                return res;
            }
            List<string> keys = this.indexKeysSorted[colName];
            Dictionary<string, List<int>> map = this.indexes[colName];

            int startIdx = 0;
            int endIdx = keys.Count - 1;

            if (lo != null && lo.Length > 0) {
                int loPos = 0;
                int hiPos = keys.Count - 1;
                startIdx = keys.Count;
                while (loPos <= hiPos) {
                    int mid = (loPos + hiPos) / 2;
                    int cmp = String.CompareOrdinal(keys[mid], loKey);
                    if (cmp >= 0) {
                        startIdx = mid;
                        hiPos = mid - 1;
                    } else {
                        loPos = mid + 1;
                    }
                }
            }

            if (hi != null && hi.Length > 0) {
                int loPos = 0;
                int hiPos = keys.Count - 1;
                endIdx = 0 - 1;
                while (loPos <= hiPos) {
                    int mid = (loPos + hiPos) / 2;
                    int cmp = String.CompareOrdinal(keys[mid], hiKey);
                    if (cmp <= 0) {
                        endIdx = mid;
                        loPos = mid + 1;
                    } else {
                        hiPos = mid - 1;
                    }
                }
            }

            for (int k = startIdx; k <= endIdx; k = k + 1) {
                string key = keys[k];
                if (map.ContainsKey(key)) {
                    List<int> ids = map[key];
                    for (int i = 0; i < ids.Count; i = i + 1) {
                        int id = ids[i];
                        if (!this.tombstones.ContainsKey(id)) {
                            res.Add(id);
                        }
                    }
                }
            }
            return res;
        } finally {
            this.tlock.ExitRead();
        }
    }

    // 范围索引检索（支持 <, <=, >, >=）
    public List<RecordRow> FindRange(string colName, string lo, string hi) {
        List<int> ids = this.FindIdsByRange(colName, lo, hi);
        List<RecordRow> rows = new List<RecordRow>();
        for (int i = 0; i < ids.Count; i = i + 1) {
            RecordRow r = this.Get(ids[i]);
            if (r != null) { rows.Add(r); }
        }
        return rows;
    }

    // 二级索引持久化写入 .zidx 文件
    public void SaveIndexesLocked() {
        if (this.indexes == null || this.indexes.Count == 0) {
            if (File.Exists(this.idxPath)) { File.Delete(this.idxPath); }
            return;
        }
        ByteBuffer b = ByteBuffer.Alloc(1024);
        b.WriteRaw(MAGIC_IDX, 4);
        b.WriteU32((long)VERSION);
        b.WriteU32((long)this.indexes.Count);
        b.WriteU64((long)this.totalRows);
        b.WriteU64((long)this.activeRows);
        b.WriteU32(0L); // reserved

        for (int i = 0; i < this.schema.columns.Count; i = i + 1) {
            string colName = this.schema.columns[i].name;
            if (this.indexes.ContainsKey(colName)) {
                Dictionary<string, List<int>> map = this.indexes[colName];
                byte[] nb = Encoding.GetBytes(colName);
                int nlen = nb != null ? nb.Length : 0;
                b.WriteU8(nlen);
                for (int j = 0; j < nlen; j = j + 1) { b.WriteU8((int)nb[j]); }

                List<string> keys = map.Keys;
                b.WriteU32((long)keys.Count);
                for (int k = 0; k < keys.Count; k = k + 1) {
                    string key = keys[k];
                    byte[] kb = Encoding.GetBytes(key);
                    int klen = kb != null ? kb.Length : 0;
                    b.WriteU16(klen);
                    for (int j = 0; j < klen; j = j + 1) { b.WriteU8((int)kb[j]); }
                    List<int> idList = map[key];
                    int idCount = idList != null ? idList.Count : 0;
                    b.WriteU32((long)idCount);
                    for (int j = 0; j < idCount; j = j + 1) {
                        b.WriteU32((long)idList[j]);
                    }
                }
            }
        }

        PageFile pf = PageFile.Open(this.idxPath);
        if (pf != null && pf.IsOpen()) {
            pf.WriteAt(0, b.Raw(), b.Length());
            pf.Sync();
            pf.Close();
        }
        b.Free();
    }

    // 从 .zidx 文件装载二级索引
    public bool LoadIndexesLocked() {
        if (!File.Exists(this.idxPath)) { return false; }
        PageFile pf = PageFile.OpenExisting(this.idxPath);
        if (pf == null || !pf.IsOpen()) { return false; }

        int fsize = pf.Size();
        if (fsize < IDX_HEADER_SIZE) {
            pf.Close();
            return false;
        }

        ByteBuffer b = ByteBuffer.Alloc(fsize);
        if (pf.ReadAt(0, b, fsize) != fsize) {
            b.Free();
            pf.Close();
            return false;
        }
        pf.Close();

        b.SeekRead(0);
        string magic = b.Str(0, 4);
        b.SeekRead(4);
        int ver = (int)b.ReadU32();
        int idxColCount = (int)b.ReadU32();
        long tRows = b.ReadU64();
        long aRows = b.ReadU64();
        b.ReadU32(); // reserved

        if (magic != MAGIC_IDX || ver != VERSION || (int)tRows != this.totalRows || (int)aRows != this.activeRows) {
            b.Free();
            return false;
        }

        this.indexes.Clear();
        this.indexKeysSorted.Clear();
        for (int c = 0; c < idxColCount; c = c + 1) {
            int nlen = b.ReadU8();
            byte[] nb = new byte[nlen];
            for (int j = 0; j < nlen; j = j + 1) { nb[j] = (byte)b.ReadU8(); }
            string colName = Encoding.GetString(nb, 0, nlen);

            Dictionary<string, List<int>> map = new Dictionary<string, List<int>>();
            List<string> sortedKeys = new List<string>();
            int kCount = (int)b.ReadU32();
            for (int k = 0; k < kCount; k = k + 1) {
                int klen = b.ReadU16();
                byte[] kb = new byte[klen];
                for (int j = 0; j < klen; j = j + 1) { kb[j] = (byte)b.ReadU8(); }
                string key = Encoding.GetString(kb, 0, klen);

                int idCount = (int)b.ReadU32();
                List<int> ids = new List<int>();
                for (int j = 0; j < idCount; j = j + 1) {
                    ids.Add((int)b.ReadU32());
                }
                map[key] = ids;
                RecordTable.InsertSortedKey(sortedKeys, key);
            }
            this.indexes[colName] = map;
            this.indexKeysSorted[colName] = sortedKeys;
        }
        b.Free();
        return true;
    }

    // 零拷贝全表顺序扫描
    public void Scan(RecordRowVisitor visitor) {
        this.tlock.EnterRead();
        try {
            if (visitor == null || !this.IsOpen()) { return; }
            for (int id = 1; id <= this.totalRows; id = id + 1) {
                if (!this.tombstones.ContainsKey(id)) {
                    RecordRow r = this.GetLocked(id);
                    if (r != null) {
                        bool cont = visitor(id, r);
                        if (!cont) { break; }
                    }
                }
            }
        } finally {
            this.tlock.ExitRead();
        }
    }

    // 强类型查询构造器入口
    public RecordQuery Query() {
        return new RecordQuery(this);
    }

    public RecordQuery Where(ExprNode expr) {
        return new RecordQuery(this).Where(expr);
    }

    // 物理整理（Vacuum）：回收墓碑空洞与 .zblob 垃圾空间，并重建并持久化二级索引
    public void Vacuum() {
        this.tlock.EnterWrite();
        try {
            if (!this.IsOpen()) { return; }
            List<string> oldIndexCols = this.indexes.Keys;
            string vacBase = this.tabPath + ".vac";
            RecordTable tmp = RecordTable.Open(vacBase, this.name, this.schema);
            for (int id = 1; id <= this.totalRows; id = id + 1) {
                if (!this.tombstones.ContainsKey(id)) {
                    RecordRow r = this.GetLocked(id);
                    if (r != null) {
                        // 预先取出变长内容，确保搬迁至新库新 blob 文件
                        for (int i = 0; i < this.schema.columns.Count; i = i + 1) {
                            RecordColumn col = this.schema.columns[i];
                            if (col.dataType == RecordDataType.VarStr) {
                                r.varStrs[col.name] = r.GetVarStr(col.name);
                            } else if (col.dataType == RecordDataType.Blob) {
                                r.blobs[col.name] = r.GetBlob(col.name);
                            }
                        }
                        tmp.Add(r);
                    }
                }
            }
            // 为新紧凑表重建原有二级索引
            for (int i = 0; i < oldIndexCols.Count; i = i + 1) {
                tmp.EnsureIndex(oldIndexCols[i]);
            }
            tmp.Flush();
            tmp.Close();
            this.file.Close();
            if (this.blobFile != null && this.blobFile.IsOpen()) {
                this.blobFile.Close();
            }
            if (this.walFile != null && this.walFile.IsOpen()) {
                this.walFile.Close();
            }

            string tmpFile = vacBase + "." + this.name + ".ztab";
            string tmpBlob = vacBase + "." + this.name + ".zblob";
            string tmpIdx = vacBase + "." + this.name + ".zidx";
            string tmpWal = vacBase + "." + this.name + ".zwal";

            if (File.Exists(this.tabPath)) { File.Delete(this.tabPath); }
            File.Move(tmpFile, this.tabPath);
            if (File.Exists(tmpBlob)) {
                if (File.Exists(this.blobPath)) { File.Delete(this.blobPath); }
                File.Move(tmpBlob, this.blobPath);
            }
            if (File.Exists(tmpIdx)) {
                if (File.Exists(this.idxPath)) { File.Delete(this.idxPath); }
                File.Move(tmpIdx, this.idxPath);
            } else if (File.Exists(this.idxPath)) {
                File.Delete(this.idxPath);
            }
            if (File.Exists(tmpWal)) { File.Delete(tmpWal); }
            if (File.Exists(this.walPath)) { File.Delete(this.walPath); }

            // 重新挂接文件
            this.file = PageFile.OpenExisting(this.tabPath);
            this.OpenOrCreateBlobFileLocked();
            this.OpenOrCreateWalFileLocked();
            this.totalRows = tmp.TotalRows();
            this.activeRows = tmp.Count();
            this.tombstones.Clear();
            this.LoadIndexesLocked();
        } finally {
            this.tlock.ExitWrite();
        }
    }

    public void Flush() {
        this.tlock.EnterWrite();
        try {
            if (this.IsOpen()) {
                this.WriteHeaderLocked();
                Mutex.Lock(this.ioMtx);
                try {
                    this.file.Sync();
                    if (this.blobFile != null && this.blobFile.IsOpen()) {
                        this.blobFile.Sync();
                    }
                } finally {
                    Mutex.Unlock(this.ioMtx);
                }
                this.SaveIndexesLocked();
                this.ResetWalLocked();
            }
        } finally {
            this.tlock.ExitWrite();
        }
    }

    public void Close() {
        this.tlock.EnterWrite();
        try {
            if (this.file != null && this.file.IsOpen()) {
                this.WriteHeaderLocked();
                this.SaveIndexesLocked();
                this.file.Sync();
                this.file.Close();
            }
            if (this.blobFile != null && this.blobFile.IsOpen()) {
                this.WriteBlobHeaderLocked();
                this.blobFile.Sync();
                this.blobFile.Close();
            }
            if (this.walFile != null && this.walFile.IsOpen()) {
                this.ResetWalLocked();
                this.walFile.Close();
            }
            if (this.ioMtx != 0) {
                Mutex.Destroy(this.ioMtx);
                this.ioMtx = 0;
            }
            this.tlock.Close();
        } finally {
            // 已完全释放
        }
    }
}
