using System;
using System.Collections.Generic;
using System.Linq;
using System.Text;

namespace System.Data.ZanDb;

public delegate void RecordRowUpdater(RecordRow r);
public delegate void RecordIdVisitor(int id, RecordRow r);

// 强类型查询构造器：基于 System.Linq.ExprNode 编译期语法树下推
// 支持两段式延迟分页、自适应多表关联、流式标量聚合与事务级批量更新删除
// 0% JsonValue 装箱，0 运行时 SQL 文本解析，天然防 SQL 注入
public class RecordQuery {
    public RecordTable table;
    public ExprNode expr;
    public int skipN;
    public int takeN;
    public string orderCol;
    public bool orderDesc;

    public RecordQuery(RecordTable table) {
        this.table = table;
        this.expr = null;
        this.skipN = 0;
        this.takeN = 0;
        this.orderCol = null;
        this.orderDesc = false;
    }

    public RecordQuery Where(ExprNode predicate) {
        if (predicate == null) { return this; }
        if (this.expr == null) {
            this.expr = predicate;
        } else {
            this.expr = ExprNode.Binary("&&", this.expr, predicate);
        }
        return this;
    }

    public RecordQuery Skip(int n) {
        this.skipN = n > 0 ? n : 0;
        return this;
    }

    public RecordQuery Take(int n) {
        this.takeN = n > 0 ? n : 0;
        return this;
    }

    public RecordQuery OrderBy(string col) {
        this.orderCol = col;
        this.orderDesc = false;
        return this;
    }

    public RecordQuery OrderByDescending(string col) {
        this.orderCol = col;
        this.orderDesc = true;
        return this;
    }

    // 纯索引覆盖 Count 优化：完全命中索引且无残余内存谓词时 0 磁盘 I/O
    public int Count() {
        if (this.table == null || !this.table.IsOpen()) { return 0; }
        List<int> candidateIds = this.PlanCandidateIds();
        if (candidateIds != null && !this.HasResidual(this.expr)) {
            return candidateIds.Count;
        }
        int cnt = 0;
        this.ExecuteMatchedRows((int id, RecordRow r) => {
            cnt = cnt + 1;
        });
        return cnt;
    }

    public RecordRow FirstOrDefault() {
        this.takeN = 1;
        List<RecordRow> list = this.ToList();
        return list.Count > 0 ? list[0] : null;
    }

    // 执行查询计划并物化结果（两段式延迟关联分页）
    public List<RecordRow> ToList() {
        List<RecordRow> results = new List<RecordRow>();
        if (this.table == null || !this.table.IsOpen()) {
            return results;
        }

        List<int> candidateIds = this.PlanCandidateIds();
        bool hasResidual = this.HasResidual(this.expr);

        // 两段式分页判定：若无需按非主键列自定义重排序（自然自增主键序）
        bool isDefaultOrder = (this.orderCol == null || this.orderCol.Length == 0 || this.orderCol == "id" || this.orderCol == "Id");

        if (isDefaultOrder) {
            // 两段式优化路径（Phase 1: ID 序列切片；Phase 2: 仅物化切片后目标行）
            List<int> matchedIds = new List<int>();
            if (candidateIds != null) {
                if (!hasResidual) {
                    matchedIds = candidateIds;
                } else {
                    for (int i = 0; i < candidateIds.Count; i = i + 1) {
                        int id = candidateIds[i];
                        RecordRow r = this.table.Get(id);
                        if (r != null && (this.expr == null || this.EvalNode(this.expr, r))) {
                            matchedIds.Add(id);
                        }
                    }
                }
            } else {
                this.table.Scan((int id, RecordRow r) => {
                    if (this.expr == null || this.EvalNode(this.expr, r)) {
                        matchedIds.Add(id);
                    }
                    return true;
                });
            }

            if (candidateIds != null && matchedIds.Count > 1) {
                matchedIds = this.SortIdsAsc(matchedIds);
            }

            if (this.orderDesc && matchedIds.Count > 1) {
                matchedIds = this.ReverseIds(matchedIds);
            }

            // Phase 1: 切片 ID 列表
            List<int> targetIds = this.SliceIds(matchedIds, this.skipN, this.takeN);

            // Phase 2: 仅物化 targetIds 对应的行
            for (int i = 0; i < targetIds.Count; i = i + 1) {
                RecordRow r = this.table.Get(targetIds[i]);
                if (r != null) {
                    results.Add(r);
                }
            }
            return results;
        }

        // 指定非主键排序列路径（先物化候选行再执行排序切片）
        if (candidateIds != null) {
            for (int i = 0; i < candidateIds.Count; i = i + 1) {
                int id = candidateIds[i];
                RecordRow r = this.table.Get(id);
                if (r != null) {
                    if (this.expr == null || this.EvalNode(this.expr, r)) {
                        results.Add(r);
                    }
                }
            }
        } else {
            this.table.Scan((int id, RecordRow r) => {
                if (this.expr == null || this.EvalNode(this.expr, r)) {
                    results.Add(r);
                }
                return true;
            });
        }

        if (results.Count > 1) {
            this.SortResults(results);
        }

        if (this.skipN > 0 || (this.takeN > 0 && this.takeN < results.Count)) {
            List<RecordRow> paged = new List<RecordRow>();
            int start = this.skipN > 0 ? this.skipN : 0;
            int end = results.Count;
            if (start > end) { start = end; }
            if (this.takeN > 0) {
                long endL = (long)start + (long)this.takeN;
                if (endL < (long)end) {
                    end = (int)endL;
                }
            }
            for (int i = start; i < end; i = i + 1) {
                paged.Add(results[i]);
            }
            return paged;
        }

        return results;
    }

    public List<int> ReverseIds(List<int> ids) {
        List<int> rev = new List<int>();
        if (ids == null) { return rev; }
        for (int i = ids.Count - 1; i >= 0; i = i - 1) {
            rev.Add(ids[i]);
        }
        return rev;
    }

    public List<int> SliceIds(List<int> ids, int skip, int take) {
        List<int> res = new List<int>();
        if (ids == null) { return res; }
        int start = skip > 0 ? skip : 0;
        int end = ids.Count;
        if (start > end) { start = end; }
        if (take > 0) {
            long endL = (long)start + (long)take;
            if (endL < (long)end) {
                end = (int)endL;
            }
        }
        for (int i = start; i < end; i = i + 1) {
            res.Add(ids[i]);
        }
        return res;
    }

    // ----------------------------------------------------
    // 流式标量聚合引擎（Sum / Avg / Min / Max）
    // ----------------------------------------------------

    public void ExecuteMatchedRows(RecordIdVisitor visitor) {
        if (this.table == null || !this.table.IsOpen() || visitor == null) { return; }
        List<int> candidateIds = this.PlanCandidateIds();
        if (candidateIds != null) {
            for (int i = 0; i < candidateIds.Count; i = i + 1) {
                int id = candidateIds[i];
                RecordRow r = this.table.Get(id);
                if (r != null) {
                    if (this.expr == null || this.EvalNode(this.expr, r)) {
                        visitor(id, r);
                    }
                }
            }
        } else {
            this.table.Scan((int id, RecordRow r) => {
                if (this.expr == null || this.EvalNode(this.expr, r)) {
                    visitor(id, r);
                }
                return true;
            });
        }
    }

    public int SumInt(string colName) {
        if (this.table == null || !this.table.IsOpen() || this.table.Schema() == null) { return 0; }
        int sum = 0;
        RecordColumn col = this.table.Schema().FindColumn(colName);
        if (col == null || col.dataType != RecordDataType.Int32) {
            this.ExecuteMatchedRows((int id, RecordRow r) => {
                sum = sum + r.GetInt32(colName);
            });
            return sum;
        }
        this.ExecuteMatchedRows((int id, RecordRow r) => {
            sum = sum + r.GetInt32Fast(col);
        });
        return sum;
    }

    public long SumLong(string colName) {
        if (this.table == null || !this.table.IsOpen() || this.table.Schema() == null) { return 0L; }
        long sum = 0L;
        RecordColumn col = this.table.Schema().FindColumn(colName);
        if (col == null || col.dataType != RecordDataType.Int64) {
            this.ExecuteMatchedRows((int id, RecordRow r) => {
                sum = sum + r.GetInt64(colName);
            });
            return sum;
        }
        this.ExecuteMatchedRows((int id, RecordRow r) => {
            sum = sum + r.GetInt64Fast(col);
        });
        return sum;
    }

    public double SumDouble(string colName) {
        if (this.table == null || !this.table.IsOpen() || this.table.Schema() == null) { return 0.0; }
        double sum = 0.0;
        RecordColumn col = this.table.Schema().FindColumn(colName);
        if (col == null) { return 0.0; }
        this.ExecuteMatchedRows((int id, RecordRow r) => {
            sum = sum + this.GetNum(r, col);
        });
        return sum;
    }

    public double Avg(string colName) {
        if (this.table == null || !this.table.IsOpen() || this.table.Schema() == null) { return 0.0; }
        double sum = 0.0;
        int cnt = 0;
        RecordColumn col = this.table.Schema().FindColumn(colName);
        if (col == null) { return 0.0; }
        this.ExecuteMatchedRows((int id, RecordRow r) => {
            sum = sum + this.GetNum(r, col);
            cnt = cnt + 1;
        });
        if (cnt == 0) { return 0.0; }
        return sum / (double)cnt;
    }

    public double Min(string colName) {
        if (this.table == null || !this.table.IsOpen() || this.table.Schema() == null) { return 0.0; }
        double minVal = 0.0;
        bool hasVal = false;
        RecordColumn col = this.table.Schema().FindColumn(colName);
        if (col == null) { return 0.0; }
        this.ExecuteMatchedRows((int id, RecordRow r) => {
            double v = this.GetNum(r, col);
            if (!hasVal || v < minVal) {
                minVal = v;
                hasVal = true;
            }
        });
        return minVal;
    }

    public double Max(string colName) {
        if (this.table == null || !this.table.IsOpen() || this.table.Schema() == null) { return 0.0; }
        double maxVal = 0.0;
        bool hasVal = false;
        RecordColumn col = this.table.Schema().FindColumn(colName);
        if (col == null) { return 0.0; }
        this.ExecuteMatchedRows((int id, RecordRow r) => {
            double v = this.GetNum(r, col);
            if (!hasVal || v > maxVal) {
                maxVal = v;
                hasVal = true;
            }
        });
        return maxVal;
    }

    // ----------------------------------------------------
    // 自适应多表关联（Join / LeftJoin）
    // ----------------------------------------------------

    public List<RecordJoinResult> Join(RecordTable rightTable, string leftKeyCol, string rightKeyCol) {
        return this.ExecuteJoin(rightTable, leftKeyCol, rightKeyCol, false);
    }

    public List<RecordJoinResult> LeftJoin(RecordTable rightTable, string leftKeyCol, string rightKeyCol) {
        return this.ExecuteJoin(rightTable, leftKeyCol, rightKeyCol, true);
    }

    public List<RecordJoinResult> ExecuteJoin(RecordTable rightTable, string leftKeyCol, string rightKeyCol, bool isLeftJoin) {
        List<RecordJoinResult> results = new List<RecordJoinResult>();
        if (this.table == null || !this.table.IsOpen() || rightTable == null || !rightTable.IsOpen()
            || leftKeyCol == null || rightKeyCol == null) {
            return results;
        }

        List<RecordRow> leftRows = this.ToList();
        if (leftRows.Count == 0) { return results; }

        bool leftIsId = leftKeyCol == "id" || leftKeyCol == "Id";
        bool rightIsId = rightKeyCol == "id" || rightKeyCol == "Id";
        RecordColumn leftCol = leftIsId ? null : this.table.Schema().FindColumn(leftKeyCol);
        RecordColumn rightCol = rightIsId ? null : rightTable.Schema().FindColumn(rightKeyCol);
        bool rightHasIndex = rightTable.HasIndex(rightKeyCol);

        if (rightIsId) {
            // Index-Nested-Loop Join on Primary Key
            for (int i = 0; i < leftRows.Count; i = i + 1) {
                RecordRow left = leftRows[i];
                string kStr = RecordQuery.GetColStrFor(left, leftCol, leftIsId);
                int rId = Convert.ToInt32(kStr);
                RecordRow right = rightTable.Get(rId);
                if (right != null) {
                    results.Add(new RecordJoinResult(left, right));
                } else if (isLeftJoin) {
                    results.Add(new RecordJoinResult(left, null));
                }
            }
            return results;
        }

        if (rightHasIndex) {
            // Index-Nested-Loop Join on Secondary Index
            for (int i = 0; i < leftRows.Count; i = i + 1) {
                RecordRow left = leftRows[i];
                string kStr = RecordQuery.GetColStrFor(left, leftCol, leftIsId);
                List<RecordRow> rightMatches = rightTable.FindByIndex(rightKeyCol, kStr);
                if (rightMatches != null && rightMatches.Count > 0) {
                    for (int j = 0; j < rightMatches.Count; j = j + 1) {
                        results.Add(new RecordJoinResult(left, rightMatches[j]));
                    }
                } else if (isLeftJoin) {
                    results.Add(new RecordJoinResult(left, null));
                }
            }
            return results;
        }

        // Hash Join fallback: O(M + N)
        Dictionary<string, List<RecordRow>> leftBuckets = new Dictionary<string, List<RecordRow>>();
        HashSet<int> matchedLeftIds = new HashSet<int>();

        for (int i = 0; i < leftRows.Count; i = i + 1) {
            RecordRow left = leftRows[i];
            string k = RecordQuery.GetColStrFor(left, leftCol, leftIsId);
            List<RecordRow> bucket = null;
            if (!leftBuckets.TryGetValue(k, out bucket)) {
                bucket = new List<RecordRow>();
                leftBuckets[k] = bucket;
            }
            bucket.Add(left);
        }

        rightTable.Scan((int rightId, RecordRow rightRow) => {
            string rKey = RecordQuery.GetColStrFor(rightRow, rightCol, rightIsId);
            List<RecordRow> bucket = null;
            if (leftBuckets.TryGetValue(rKey, out bucket)) {
                for (int b = 0; b < bucket.Count; b = b + 1) {
                    results.Add(new RecordJoinResult(bucket[b], rightRow));
                    if (isLeftJoin) {
                        matchedLeftIds.Add(bucket[b].id);
                    }
                }
            }
            return true;
        });

        if (isLeftJoin) {
            for (int i = 0; i < leftRows.Count; i = i + 1) {
                RecordRow left = leftRows[i];
                if (!matchedLeftIds.Contains(left.id)) {
                    results.Add(new RecordJoinResult(left, null));
                }
            }
        }

        return results;
    }

    private static string GetColStrFor(RecordRow r, RecordColumn col, bool isId) {
        if (r == null) { return ""; }
        if (isId) { return Convert.ToString(r.id); }
        if (col == null) { return ""; }
        int dt = col.dataType;
        if (dt == RecordDataType.Int32) { return Convert.ToString(r.GetInt32Fast(col)); }
        if (dt == RecordDataType.Int64) { return Convert.ToString(r.GetInt64Fast(col)); }
        if (dt == RecordDataType.Float32) { return Convert.ToString((double)r.GetFloat32Fast(col)); }
        if (dt == RecordDataType.Float64) { return Convert.ToString(r.GetFloat64Fast(col)); }
        if (dt == RecordDataType.Bool) { return r.GetBoolFast(col) ? "1" : "0"; }
        if (dt == RecordDataType.FixedStr) { return r.GetStrFast(col); }
        if (dt == RecordDataType.VarStr) { return r.GetVarStr(col.name); }
        return "";
    }

    public string GetColStr(RecordRow r, string colName) {
        if (r == null || colName == null) { return ""; }
        if (colName == "id" || colName == "Id") {
            return Convert.ToString(r.id);
        }
        if (r.schema == null) { return ""; }
        RecordColumn col = r.schema.FindColumn(colName);
        return RecordQuery.GetColStrFor(r, col, false);
    }

    // ----------------------------------------------------
    // 条件批量操作（Update / Delete）
    // ----------------------------------------------------

    public int Delete() {
        if (this.table == null || !this.table.IsOpen()) { return 0; }
        List<RecordRow> rows = this.ToList();
        if (rows.Count == 0) { return 0; }

        bool localTx = !this.table.inTx;
        if (localTx) {
            this.table.BeginTransaction();
        }
        int affected = 0;
        try {
            for (int i = 0; i < rows.Count; i = i + 1) {
                bool ok = this.table.Delete(rows[i].id);
                if (ok) { affected = affected + 1; }
            }
            if (localTx) {
                this.table.Commit();
            }
        } catch (Exception ex) {
            if (localTx) {
                this.table.Rollback();
            }
            throw ex;
        }
        return affected;
    }

    public int Update(RecordRowUpdater updater) {
        if (updater == null || this.table == null || !this.table.IsOpen()) { return 0; }
        List<RecordRow> rows = this.ToList();
        if (rows.Count == 0) { return 0; }

        bool localTx = !this.table.inTx;
        if (localTx) {
            this.table.BeginTransaction();
        }
        int affected = 0;
        try {
            for (int i = 0; i < rows.Count; i = i + 1) {
                RecordRow r = rows[i];
                updater(r);
                bool ok = this.table.Update(r.id, r);
                if (ok) { affected = affected + 1; }
            }
            if (localTx) {
                this.table.Commit();
            }
        } catch (Exception ex) {
            if (localTx) {
                this.table.Rollback();
            }
            throw ex;
        }
        return affected;
    }

    // ----------------------------------------------------
    // 索引计划与残余谓词识别
    // ----------------------------------------------------

    public bool HasResidual(ExprNode n) {
        if (n == null) { return false; }
        if (this.table == null) { return true; }
        if (n.Kind == 4) { // Lambda
            return this.HasResidual(n.A);
        }
        if (n.Kind == 2) { // Binary
            if (n.Name == "==") {
                if (n.A != null && n.A.Kind == 0 && n.B != null && n.B.Kind == 1) {
                    return !this.table.HasIndex(n.A.Name);
                }
                if (n.B != null && n.B.Kind == 0 && n.A != null && n.A.Kind == 1) {
                    return !this.table.HasIndex(n.B.Name);
                }
                return true;
            }
            if (n.Name == ">=" || n.Name == "<=") {
                if (n.A != null && n.A.Kind == 0 && n.B != null && n.B.Kind == 1) {
                    return !this.table.HasIndex(n.A.Name);
                }
                return true;
            }
            if (n.Name == ">" || n.Name == "<") {
                return true;
            }
            if (n.Name == "&&") {
                return this.HasResidual(n.A) || this.HasResidual(n.B);
            }
            return true;
        }
        return true;
    }

    public List<int> PlanCandidateIds() {
        if (this.expr == null) { return null; }
        return this.ExtractIndexIds(this.expr);
    }

    public List<int> ExtractIndexIds(ExprNode n) {
        if (n == null || this.table == null) { return null; }
        if (n.Kind == 4) { // Lambda
            return this.ExtractIndexIds(n.A);
        }
        if (n.Kind == 2) { // Binary
            if (n.Name == "==") {
                if (n.A != null && n.A.Kind == 0 && n.B != null && n.B.Kind == 1) {
                    string col = n.A.Name;
                    if (this.table.HasIndex(col)) {
                        string val = this.ConstToString(n.B);
                        return this.table.FindIdsByIndex(col, val);
                    }
                } else if (n.B != null && n.B.Kind == 0 && n.A != null && n.A.Kind == 1) {
                    string col = n.B.Name;
                    if (this.table.HasIndex(col)) {
                        string val = this.ConstToString(n.A);
                        return this.table.FindIdsByIndex(col, val);
                    }
                }
            } else if (n.Name == ">=" || n.Name == ">" || n.Name == "<=" || n.Name == "<") {
                if (n.A != null && n.A.Kind == 0 && n.B != null && n.B.Kind == 1) {
                    string col = n.A.Name;
                    if (this.table.HasIndex(col)) {
                        string lo = "";
                        string hi = "";
                        string val = this.ConstToString(n.B);
                        if (n.Name == ">=" || n.Name == ">") {
                            lo = val;
                        } else {
                            hi = val;
                        }
                        return this.table.FindIdsByRange(col, lo, hi);
                    }
                }
            } else if (n.Name == "&&") {
                List<int> leftIds = this.ExtractIndexIds(n.A);
                List<int> rightIds = this.ExtractIndexIds(n.B);
                if (leftIds != null && rightIds != null) {
                    return this.IntersectIds(leftIds, rightIds);
                }
                if (leftIds != null) { return leftIds; }
                if (rightIds != null) { return rightIds; }
            }
        }
        return null;
    }

    public List<int> IntersectIds(List<int> a, List<int> b) {
        List<int> res = new List<int>();
        if (a == null || b == null) { return res; }
        HashSet<int> idSet = new HashSet<int>();
        for (int i = 0; i < a.Count; i = i + 1) {
            idSet.Add(a[i]);
        }
        for (int i = 0; i < b.Count; i = i + 1) {
            if (idSet.Contains(b[i])) {
                res.Add(b[i]);
            }
        }
        return res;
    }

    public string ConstToString(ExprNode c) {
        if (c == null) { return ""; }
        if (c.TVal == 0) { return Convert.ToString(c.IVal); }
        if (c.TVal == 1) { return Convert.ToString(c.DVal); }
        if (c.TVal == 2) { return c.SVal != null ? c.SVal : ""; }
        if (c.TVal == 3) { return c.BVal ? "1" : "0"; }
        if (c.TVal == 5) { return Convert.ToString(c.LVal); }
        return "";
    }

    // 两槽内联列缓存：常见 1~2 列谓词零哈希查表直接命中
    private string cachedColName0;
    private RecordColumn cachedCol0;
    private string cachedColName1;
    private RecordColumn cachedCol1;

    private RecordColumn ResolveColCached(string colName) {
        if (colName == null || this.table == null || this.table.Schema() == null) { return null; }
        if (colName == this.cachedColName0 && this.cachedCol0 != null) { return this.cachedCol0; }
        if (colName == this.cachedColName1 && this.cachedCol1 != null) { return this.cachedCol1; }
        RecordColumn col = this.table.Schema().FindColumn(colName);
        if (col != null) {
            if (this.cachedCol0 == null) {
                this.cachedColName0 = colName;
                this.cachedCol0 = col;
            } else {
                this.cachedColName1 = colName;
                this.cachedCol1 = col;
            }
        }
        return col;
    }

    // 内存强类型语法树求值器（0 装箱，数值分支免 Convert.ToString 堆分配）
    public bool EvalNode(ExprNode n, RecordRow r) {
        if (n == null) { return true; }
        if (r == null) { return false; }
        int kind = n.Kind;
        if (kind == 4) { // Lambda: p => body
            return this.EvalNode(n.A, r);
        }
        if (kind == 5) { // Unary Not: !expr
            return !this.EvalNode(n.A, r);
        }
        if (kind == 2) { // Binary
            string op = n.Name;
            if (op == "&&") {
                return this.EvalNode(n.A, r) && this.EvalNode(n.B, r);
            }
            if (op == "||") {
                return this.EvalNode(n.A, r) || this.EvalNode(n.B, r);
            }

            // 比较运算：数值路径不构造中间字符串；双整数精确按 64 位 long 比较，避免 Int64 > 2^53 转 double 失真
            double numA = 0.0;
            double numB = 0.0;
            long intA = 0L;
            long intB = 0L;
            bool isNumA = false;
            bool isNumB = false;
            bool isIntA = false;
            bool isIntB = false;
            string strA = null;
            string strB = null;

            this.EvalValTyped(n.A, r, out numA, out intA, out isNumA, out isIntA, out strA);
            this.EvalValTyped(n.B, r, out numB, out intB, out isNumB, out isIntB, out strB);

            if (isIntA && isIntB) {
                if (op == "==") { return intA == intB; }
                if (op == "!=") { return intA != intB; }
                if (op == "<") { return intA < intB; }
                if (op == "<=") { return intA <= intB; }
                if (op == ">") { return intA > intB; }
                if (op == ">=") { return intA >= intB; }
            } else if (isNumA && isNumB) {
                if (op == "==") { return Math.Abs(numA - numB) < 1e-9; }
                if (op == "!=") { return Math.Abs(numA - numB) >= 1e-9; }
                if (op == "<") { return numA < numB; }
                if (op == "<=") { return numA <= numB; }
                if (op == ">") { return numA > numB; }
                if (op == ">=") { return numA >= numB; }
            } else {
                if (isNumA) {
                    double ign = 0.0;
                    bool ignN = false;
                    this.EvalVal(n.A, r, out ign, out ignN, out strA);
                }
                if (isNumB) {
                    double ign = 0.0;
                    bool ignN = false;
                    this.EvalVal(n.B, r, out ign, out ignN, out strB);
                }
                if (strA == null) { strA = ""; }
                if (strB == null) { strB = ""; }
                int cmp = String.CompareOrdinal(strA, strB);
                if (op == "==") { return cmp == 0; }
                if (op == "!=") { return cmp != 0; }
                if (op == "<") { return cmp < 0; }
                if (op == "<=") { return cmp <= 0; }
                if (op == ">") { return cmp > 0; }
                if (op == ">=") { return cmp >= 0; }
            }
            return false;
        }
        if (kind == 3) { // Method call: StartsWith / EndsWith / Contains
            double ignored = 0.0;
            bool isNum = false;
            string target = "";
            this.EvalVal(n.A, r, out ignored, out isNum, out target);
            string arg = "";
            this.EvalVal(n.B, r, out ignored, out isNum, out arg);

            if (n.Name == "StartsWith") {
                return target.StartsWith(arg);
            }
            if (n.Name == "EndsWith") {
                return target.EndsWith(arg);
            }
            if (n.Name == "Contains") {
                return target.Contains(arg);
            }
        }
        return true;
    }

    private List<int> SortIdsAsc(List<int> ids) {
        int n = ids.Count;
        bool sorted = true;
        for (int i = 1; i < n; i = i + 1) {
            if (ids[i - 1] > ids[i]) { sorted = false; break; }
        }
        if (sorted) { return ids; }
        int[] arr = new int[n];
        for (int i = 0; i < n; i = i + 1) { arr[i] = ids[i]; }
        // 自底向上归并排序，O(n log n) 且无递归栈溢出
        int[] tmp = new int[n];
        int width = 1;
        while (width < n) {
            int left = 0;
            while (left < n) {
                int mid = left + width;
                if (mid > n) { mid = n; }
                int right = mid + width;
                if (right > n) { right = n; }
                int i = left;
                int j = mid;
                int k = left;
                while (i < mid && j < right) {
                    if (arr[i] <= arr[j]) { tmp[k] = arr[i]; i = i + 1; }
                    else { tmp[k] = arr[j]; j = j + 1; }
                    k = k + 1;
                }
                while (i < mid) { tmp[k] = arr[i]; i = i + 1; k = k + 1; }
                while (j < right) { tmp[k] = arr[j]; j = j + 1; k = k + 1; }
                for (int p = left; p < right; p = p + 1) { arr[p] = tmp[p]; }
                left = right;
            }
            width = width * 2;
        }
        List<int> res = new List<int>();
        res.Reserve(n);
        for (int i = 0; i < n; i = i + 1) { res.Add(arr[i]); }
        return res;
    }

    private void EvalValTyped(ExprNode n, RecordRow r, out double numVal, out long intVal, out bool isNum, out bool isInt, out string strVal) {
        numVal = 0.0;
        intVal = 0L;
        isNum = false;
        isInt = false;
        strVal = "";
        if (n == null || r == null) { return; }

        int kind = n.Kind;
        if (kind == 0) { // Member access
            string colName = n.Name;
            if (colName == "id" || colName == "Id") {
                intVal = (long)r.id;
                numVal = (double)r.id;
                isNum = true;
                isInt = true;
                return;
            }
            RecordColumn col = this.ResolveColCached(colName);
            if (col == null) { return; }

            int dt = col.dataType;
            if (dt == RecordDataType.Int32) {
                int v = r.GetInt32Fast(col);
                intVal = (long)v;
                numVal = (double)v;
                isNum = true;
                isInt = true;
            } else if (dt == RecordDataType.Int64) {
                long v = r.GetInt64Fast(col);
                intVal = v;
                numVal = (double)v;
                isNum = true;
                isInt = true;
            } else if (dt == RecordDataType.Float32) {
                numVal = (double)r.GetFloat32Fast(col);
                isNum = true;
            } else if (dt == RecordDataType.Float64) {
                numVal = r.GetFloat64Fast(col);
                isNum = true;
            } else if (dt == RecordDataType.Bool) {
                long bv = r.GetBoolFast(col) ? 1L : 0L;
                intVal = bv;
                numVal = (double)bv;
                isNum = true;
                isInt = true;
            } else if (dt == RecordDataType.FixedStr) {
                strVal = r.GetStrFast(col);
                isNum = false;
            } else if (dt == RecordDataType.VarStr) {
                strVal = r.GetVarStr(col.name);
                isNum = false;
            }
        } else if (kind == 1) { // Constant
            int tv = n.TVal;
            if (tv == 0) {
                intVal = (long)n.IVal;
                numVal = (double)n.IVal;
                isNum = true;
                isInt = true;
            } else if (tv == 1) {
                numVal = n.DVal;
                isNum = true;
            } else if (tv == 2) {
                strVal = n.SVal != null ? n.SVal : "";
                isNum = false;
            } else if (tv == 3) {
                long bv = n.BVal ? 1L : 0L;
                intVal = bv;
                numVal = (double)bv;
                isNum = true;
                isInt = true;
            } else if (tv == 5) {
                intVal = n.LVal;
                numVal = (double)n.LVal;
                isNum = true;
                isInt = true;
            }
        }
    }

    private void EvalValFast(ExprNode n, RecordRow r, out double numVal, out bool isNum, out string strVal) {
        numVal = 0.0;
        isNum = false;
        strVal = "";
        if (n == null || r == null) { return; }

        int kind = n.Kind;
        if (kind == 0) { // Member access
            string colName = n.Name;
            if (colName == "id" || colName == "Id") {
                numVal = (double)r.id;
                isNum = true;
                return;
            }
            RecordColumn col = this.ResolveColCached(colName);
            if (col == null) { return; }

            int dt = col.dataType;
            if (dt == RecordDataType.Int32) {
                numVal = (double)r.GetInt32Fast(col);
                isNum = true;
            } else if (dt == RecordDataType.Int64) {
                numVal = (double)r.GetInt64Fast(col);
                isNum = true;
            } else if (dt == RecordDataType.Float32) {
                numVal = (double)r.GetFloat32Fast(col);
                isNum = true;
            } else if (dt == RecordDataType.Float64) {
                numVal = r.GetFloat64Fast(col);
                isNum = true;
            } else if (dt == RecordDataType.Bool) {
                numVal = r.GetBoolFast(col) ? 1.0 : 0.0;
                isNum = true;
            } else if (dt == RecordDataType.FixedStr) {
                strVal = r.GetStrFast(col);
                isNum = false;
            } else if (dt == RecordDataType.VarStr) {
                strVal = r.GetVarStr(col.name);
                isNum = false;
            }
        } else if (kind == 1) { // Constant
            int tv = n.TVal;
            if (tv == 0) {
                numVal = (double)n.IVal;
                isNum = true;
            } else if (tv == 1) {
                numVal = n.DVal;
                isNum = true;
            } else if (tv == 2) {
                strVal = n.SVal != null ? n.SVal : "";
                isNum = false;
            } else if (tv == 3) {
                numVal = n.BVal ? 1.0 : 0.0;
                isNum = true;
            } else if (tv == 5) {
                numVal = (double)n.LVal;
                isNum = true;
            }
        }
    }

    public void EvalVal(ExprNode n, RecordRow r, out double numVal, out bool isNum, out string strVal) {
        numVal = 0.0;
        isNum = false;
        strVal = "";
        if (n == null || r == null) { return; }

        if (n.Kind == 0) { // Member access
            string colName = n.Name;
            if (colName == "id" || colName == "Id") {
                numVal = (double)r.id;
                isNum = true;
                strVal = Convert.ToString(r.id);
                return;
            }
            RecordColumn col = this.ResolveColCached(colName);
            if (col == null) { return; }

            if (col.dataType == RecordDataType.Int32) {
                int v = r.GetInt32Fast(col);
                numVal = (double)v;
                isNum = true;
                strVal = Convert.ToString(v);
            } else if (col.dataType == RecordDataType.Int64) {
                long v = r.GetInt64Fast(col);
                numVal = (double)v;
                isNum = true;
                strVal = Convert.ToString(v);
            } else if (col.dataType == RecordDataType.Float32) {
                numVal = (double)r.GetFloat32Fast(col);
                isNum = true;
                strVal = Convert.ToString(numVal);
            } else if (col.dataType == RecordDataType.Float64) {
                numVal = r.GetFloat64Fast(col);
                isNum = true;
                strVal = Convert.ToString(numVal);
            } else if (col.dataType == RecordDataType.Bool) {
                bool b = r.GetBoolFast(col);
                numVal = b ? 1.0 : 0.0;
                isNum = true;
                strVal = b ? "1" : "0";
            } else if (col.dataType == RecordDataType.FixedStr) {
                strVal = r.GetStrFast(col);
                isNum = false;
            } else if (col.dataType == RecordDataType.VarStr) {
                strVal = r.GetVarStr(col.name);
                isNum = false;
            }
        } else if (n.Kind == 1) { // Constant
            if (n.TVal == 0) {
                numVal = (double)n.IVal;
                isNum = true;
                strVal = Convert.ToString(n.IVal);
            } else if (n.TVal == 1) {
                numVal = n.DVal;
                isNum = true;
                strVal = Convert.ToString(n.DVal);
            } else if (n.TVal == 2) {
                strVal = n.SVal != null ? n.SVal : "";
                isNum = false;
            } else if (n.TVal == 3) {
                numVal = n.BVal ? 1.0 : 0.0;
                isNum = true;
                strVal = n.BVal ? "1" : "0";
            } else if (n.TVal == 5) {
                numVal = (double)n.LVal;
                isNum = true;
                strVal = Convert.ToString(n.LVal);
            }
        }
    }

    // Schwartzian Transform 预提取排序键 + O(N log N) 自底向上稳定归并排序（保持与原插入排序完全一致的稳定次序）。
    public void SortResults(List<RecordRow> list) {
        if (list == null || list.Count <= 1 || this.table == null || this.table.Schema() == null) { return; }
        int n = list.Count;
        RecordColumn col = this.table.Schema().FindColumn(this.orderCol);
        if (col == null) { return; }

        bool isNum = col.dataType == RecordDataType.Int32 || col.dataType == RecordDataType.Int64 ||
                     col.dataType == RecordDataType.Float32 || col.dataType == RecordDataType.Float64 ||
                     col.dataType == RecordDataType.Bool;
        bool desc = this.orderDesc;

        int[] idx = new int[n];
        int[] tmp = new int[n];
        for (int i = 0; i < n; i = i + 1) { idx[i] = i; }

        if (isNum) {
            double[] keys = new double[n];
            int dt = col.dataType;
            if (dt == RecordDataType.Int32) {
                for (int i = 0; i < n; i = i + 1) { keys[i] = (double)list[i].GetInt32Fast(col); }
            } else if (dt == RecordDataType.Int64) {
                for (int i = 0; i < n; i = i + 1) { keys[i] = (double)list[i].GetInt64Fast(col); }
            } else if (dt == RecordDataType.Float64) {
                for (int i = 0; i < n; i = i + 1) { keys[i] = list[i].GetFloat64Fast(col); }
            } else if (dt == RecordDataType.Float32) {
                for (int i = 0; i < n; i = i + 1) { keys[i] = (double)list[i].GetFloat32Fast(col); }
            } else {
                for (int i = 0; i < n; i = i + 1) { keys[i] = list[i].GetBoolFast(col) ? 1.0 : 0.0; }
            }

            // 小区间 (16) 稳定插入排序打底，提升缓存命中率
            for (int lo = 0; lo < n; lo = lo + 16) {
                int hi = lo + 16;
                if (hi > n) { hi = n; }
                for (int i = lo + 1; i < hi; i = i + 1) {
                    int ki = idx[i];
                    double kv = keys[ki];
                    int j = i - 1;
                    if (desc) {
                        while (j >= lo && keys[idx[j]] < kv) {
                            idx[j + 1] = idx[j];
                            j = j - 1;
                        }
                    } else {
                        while (j >= lo && keys[idx[j]] > kv) {
                            idx[j + 1] = idx[j];
                            j = j - 1;
                        }
                    }
                    idx[j + 1] = ki;
                }
            }

            int[] src = idx;
            int[] dst = tmp;
            for (int width = 16; width < n; width = width << 1) {
                for (int lo = 0; lo < n; lo = lo + (width << 1)) {
                    int mid = lo + width;
                    if (mid >= n) {
                        for (int k = lo; k < n; k = k + 1) { dst[k] = src[k]; }
                        break;
                    }
                    int hi = mid + width;
                    if (hi > n) { hi = n; }
                    int l = lo;
                    int r = mid;
                    int o = lo;
                    if (desc) {
                        while (l < mid && r < hi) {
                            if (keys[src[l]] >= keys[src[r]]) { dst[o] = src[l]; l = l + 1; }
                            else { dst[o] = src[r]; r = r + 1; }
                            o = o + 1;
                        }
                    } else {
                        while (l < mid && r < hi) {
                            if (keys[src[l]] <= keys[src[r]]) { dst[o] = src[l]; l = l + 1; }
                            else { dst[o] = src[r]; r = r + 1; }
                            o = o + 1;
                        }
                    }
                    while (l < mid) { dst[o] = src[l]; l = l + 1; o = o + 1; }
                    while (r < hi) { dst[o] = src[r]; r = r + 1; o = o + 1; }
                }
                int[] sw = src; src = dst; dst = sw;
            }
            idx = src;
        } else {
            string[] keys = new string[n];
            for (int i = 0; i < n; i = i + 1) {
                keys[i] = this.GetStr(list[i], col);
            }

            for (int lo = 0; lo < n; lo = lo + 16) {
                int hi = lo + 16;
                if (hi > n) { hi = n; }
                for (int i = lo + 1; i < hi; i = i + 1) {
                    int ki = idx[i];
                    string kv = keys[ki];
                    int j = i - 1;
                    while (j >= lo) {
                        int cmp = String.CompareOrdinal(keys[idx[j]], kv);
                        if (desc) { cmp = 0 - cmp; }
                        if (cmp > 0) {
                            idx[j + 1] = idx[j];
                            j = j - 1;
                        } else {
                            break;
                        }
                    }
                    idx[j + 1] = ki;
                }
            }

            int[] src = idx;
            int[] dst = tmp;
            for (int width = 16; width < n; width = width << 1) {
                for (int lo = 0; lo < n; lo = lo + (width << 1)) {
                    int mid = lo + width;
                    if (mid >= n) {
                        for (int k = lo; k < n; k = k + 1) { dst[k] = src[k]; }
                        break;
                    }
                    int hi = mid + width;
                    if (hi > n) { hi = n; }
                    int l = lo;
                    int r = mid;
                    int o = lo;
                    while (l < mid && r < hi) {
                        int cmp = String.CompareOrdinal(keys[src[l]], keys[src[r]]);
                        if (desc) { cmp = 0 - cmp; }
                        if (cmp <= 0) { dst[o] = src[l]; l = l + 1; }
                        else { dst[o] = src[r]; r = r + 1; }
                        o = o + 1;
                    }
                    while (l < mid) { dst[o] = src[l]; l = l + 1; o = o + 1; }
                    while (r < hi) { dst[o] = src[r]; r = r + 1; o = o + 1; }
                }
                int[] sw = src; src = dst; dst = sw;
            }
            idx = src;
        }

        RecordRow[] snap = new RecordRow[n];
        for (int i = 0; i < n; i = i + 1) { snap[i] = list[i]; }
        for (int i = 0; i < n; i = i + 1) { list[i] = snap[idx[i]]; }
    }

    public double GetNum(RecordRow r, RecordColumn col) {
        if (r == null || col == null) { return 0.0; }
        int dt = col.dataType;
        if (dt == RecordDataType.Int32) { return (double)r.GetInt32Fast(col); }
        if (dt == RecordDataType.Int64) { return (double)r.GetInt64Fast(col); }
        if (dt == RecordDataType.Float32) { return (double)r.GetFloat32Fast(col); }
        if (dt == RecordDataType.Float64) { return r.GetFloat64Fast(col); }
        if (dt == RecordDataType.Bool) { return r.GetBoolFast(col) ? 1.0 : 0.0; }
        return 0.0;
    }

    public string GetStr(RecordRow r, RecordColumn col) {
        if (r == null || col == null) { return ""; }
        if (col.dataType == RecordDataType.FixedStr) { return r.GetStrFast(col); }
        if (col.dataType == RecordDataType.VarStr) { return r.GetVarStr(col.name); }
        return "";
    }
}
