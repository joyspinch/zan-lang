using System;
using System.Collections.Generic;
using System.Linq;
using System.Text;

namespace System.Data.ZanDb;

public delegate void RecordRowUpdater(RecordRow r);
public delegate void RecordIdVisitor(int id, RecordRow r);

// 强类型查询构造器：基于 System.Linq.ExprNode 编译期语法树下推
// 支持两段式延迟分页、自适应多表关联、流式标量聚合与事务级批量更新删除
// 0% JsonValue 装箱，0 运行时 SQL 文本解析，天然防 SQL 注入
public class RecordQuery {
    public RecordTable table;
    public ExprNode expr;
    public int skipN;
    public int takeN;
    public string orderCol;
    public bool orderDesc;

    public RecordQuery(RecordTable table) {
        this.table = table;
        this.expr = null;
        this.skipN = 0;
        this.takeN = 0;
        this.orderCol = null;
        this.orderDesc = false;
    }

    public RecordQuery Where(ExprNode predicate) {
        if (predicate == null) { return this; }
        if (this.expr == null) {
            this.expr = predicate;
        } else {
            this.expr = ExprNode.Binary("&&", this.expr, predicate);
        }
        return this;
    }

    public RecordQuery Skip(int n) {
        this.skipN = n > 0 ? n : 0;
        return this;
    }

    public RecordQuery Take(int n) {
        this.takeN = n > 0 ? n : 0;
        return this;
    }

    public RecordQuery OrderBy(string col) {
        this.orderCol = col;
        this.orderDesc = false;
        return this;
    }

    public RecordQuery OrderByDescending(string col) {
        this.orderCol = col;
        this.orderDesc = true;
        return this;
    }

    // 纯索引覆盖 Count 优化：完全命中索引且无残余内存谓词时 0 磁盘 I/O
    public int Count() {
        if (this.table == null || !this.table.IsOpen()) { return 0; }
        List<int> candidateIds = this.PlanCandidateIds();
        if (candidateIds != null && !this.HasResidual(this.expr)) {
            return candidateIds.Count;
        }
        int cnt = 0;
        this.ExecuteMatchedRows((int id, RecordRow r) => {
            cnt = cnt + 1;
        });
        return cnt;
    }

    public RecordRow FirstOrDefault() {
        this.takeN = 1;
        List<RecordRow> list = this.ToList();
        return list.Count > 0 ? list[0] : null;
    }

    // 执行查询计划并物化结果（两段式延迟关联分页）
    public List<RecordRow> ToList() {
        List<RecordRow> results = new List<RecordRow>();
        if (this.table == null || !this.table.IsOpen()) {
            return results;
        }

        List<int> candidateIds = this.PlanCandidateIds();
        bool hasResidual = this.HasResidual(this.expr);

        // 两段式分页判定：若无需按非主键列自定义重排序（自然自增主键序）
        bool isDefaultOrder = (this.orderCol == null || this.orderCol.Length == 0 || this.orderCol == "id" || this.orderCol == "Id");

        if (isDefaultOrder) {
            // 两段式优化路径（Phase 1: ID 序列切片；Phase 2: 仅物化切片后目标行）
            List<int> matchedIds = new List<int>();
            if (candidateIds != null) {
                if (!hasResidual) {
                    matchedIds = candidateIds;
                } else {
                    for (int i = 0; i < candidateIds.Count; i = i + 1) {
                        int id = candidateIds[i];
                        RecordRow r = this.table.Get(id);
                        if (r != null && (this.expr == null || this.EvalNode(this.expr, r))) {
                            matchedIds.Add(id);
                        }
                    }
                }
            } else {
                this.table.Scan((int id, RecordRow r) => {
                    if (this.expr == null || this.EvalNode(this.expr, r)) {
                        matchedIds.Add(id);
                    }
                    return true;
                });
            }

            if (this.orderDesc && matchedIds.Count > 1) {
                matchedIds = this.ReverseIds(matchedIds);
            }

            // Phase 1: 切片 ID 列表
            List<int> targetIds = this.SliceIds(matchedIds, this.skipN, this.takeN);

            // Phase 2: 仅物化 targetIds 对应的行
            for (int i = 0; i < targetIds.Count; i = i + 1) {
                RecordRow r = this.table.Get(targetIds[i]);
                if (r != null) {
                    results.Add(r);
                }
            }
            return results;
        }

        // 指定非主键排序列路径（先物化候选行再执行排序切片）
        if (candidateIds != null) {
            for (int i = 0; i < candidateIds.Count; i = i + 1) {
                int id = candidateIds[i];
                RecordRow r = this.table.Get(id);
                if (r != null) {
                    if (this.expr == null || this.EvalNode(this.expr, r)) {
                        results.Add(r);
                    }
                }
            }
        } else {
            this.table.Scan((int id, RecordRow r) => {
                if (this.expr == null || this.EvalNode(this.expr, r)) {
                    results.Add(r);
                }
                return true;
            });
        }

        if (results.Count > 1) {
            this.SortResults(results);
        }

        if (this.skipN > 0 || (this.takeN > 0 && this.takeN < results.Count)) {
            List<RecordRow> paged = new List<RecordRow>();
            int start = this.skipN;
            int end = results.Count;
            if (this.takeN > 0 && start + this.takeN < end) {
                end = start + this.takeN;
            }
            for (int i = start; i < end; i = i + 1) {
                paged.Add(results[i]);
            }
            return paged;
        }

        return results;
    }

    public List<int> ReverseIds(List<int> ids) {
        List<int> rev = new List<int>();
        for (int i = ids.Count - 1; i >= 0; i = i - 1) {
            rev.Add(ids[i]);
        }
        return rev;
    }

    public List<int> SliceIds(List<int> ids, int skip, int take) {
        List<int> res = new List<int>();
        int start = skip > 0 ? skip : 0;
        int end = ids.Count;
        if (take > 0 && start + take < end) {
            end = start + take;
        }
        for (int i = start; i < end; i = i + 1) {
            res.Add(ids[i]);
        }
        return res;
    }

    // ----------------------------------------------------
    // 流式标量聚合引擎（Sum / Avg / Min / Max）
    // ----------------------------------------------------

    public void ExecuteMatchedRows(RecordIdVisitor visitor) {
        if (this.table == null || !this.table.IsOpen() || visitor == null) { return; }
        List<int> candidateIds = this.PlanCandidateIds();
        if (candidateIds != null) {
            for (int i = 0; i < candidateIds.Count; i = i + 1) {
                int id = candidateIds[i];
                RecordRow r = this.table.Get(id);
                if (r != null) {
                    if (this.expr == null || this.EvalNode(this.expr, r)) {
                        visitor(id, r);
                    }
                }
            }
        } else {
            this.table.Scan((int id, RecordRow r) => {
                if (this.expr == null || this.EvalNode(this.expr, r)) {
                    visitor(id, r);
                }
                return true;
            });
        }
    }

    public int SumInt(string colName) {
        int sum = 0;
        this.ExecuteMatchedRows((int id, RecordRow r) => {
            sum = sum + r.GetInt32(colName);
        });
        return sum;
    }

    public long SumLong(string colName) {
        long sum = 0L;
        this.ExecuteMatchedRows((int id, RecordRow r) => {
            sum = sum + r.GetInt64(colName);
        });
        return sum;
    }

    public double SumDouble(string colName) {
        double sum = 0.0;
        RecordColumn col = this.table.Schema().FindColumn(colName);
        if (col == null) { return 0.0; }
        this.ExecuteMatchedRows((int id, RecordRow r) => {
            sum = sum + this.GetNum(r, col);
        });
        return sum;
    }

    public double Avg(string colName) {
        double sum = 0.0;
        int cnt = 0;
        RecordColumn col = this.table.Schema().FindColumn(colName);
        if (col == null) { return 0.0; }
        this.ExecuteMatchedRows((int id, RecordRow r) => {
            sum = sum + this.GetNum(r, col);
            cnt = cnt + 1;
        });
        if (cnt == 0) { return 0.0; }
        return sum / (double)cnt;
    }

    public double Min(string colName) {
        double minVal = 0.0;
        bool hasVal = false;
        RecordColumn col = this.table.Schema().FindColumn(colName);
        if (col == null) { return 0.0; }
        this.ExecuteMatchedRows((int id, RecordRow r) => {
            double v = this.GetNum(r, col);
            if (!hasVal || v < minVal) {
                minVal = v;
                hasVal = true;
            }
        });
        return minVal;
    }

    public double Max(string colName) {
        double maxVal = 0.0;
        bool hasVal = false;
        RecordColumn col = this.table.Schema().FindColumn(colName);
        if (col == null) { return 0.0; }
        this.ExecuteMatchedRows((int id, RecordRow r) => {
            double v = this.GetNum(r, col);
            if (!hasVal || v > maxVal) {
                maxVal = v;
                hasVal = true;
            }
        });
        return maxVal;
    }

    // ----------------------------------------------------
    // 自适应多表关联（Join / LeftJoin）
    // ----------------------------------------------------

    public List<RecordJoinResult> Join(RecordTable rightTable, string leftKeyCol, string rightKeyCol) {
        return this.ExecuteJoin(rightTable, leftKeyCol, rightKeyCol, false);
    }

    public List<RecordJoinResult> LeftJoin(RecordTable rightTable, string leftKeyCol, string rightKeyCol) {
        return this.ExecuteJoin(rightTable, leftKeyCol, rightKeyCol, true);
    }

    public List<RecordJoinResult> ExecuteJoin(RecordTable rightTable, string leftKeyCol, string rightKeyCol, bool isLeftJoin) {
        List<RecordJoinResult> results = new List<RecordJoinResult>();
        if (this.table == null || !this.table.IsOpen() || rightTable == null || !rightTable.IsOpen()) {
            return results;
        }

        List<RecordRow> leftRows = this.ToList();
        if (leftRows.Count == 0) { return results; }

        bool rightIsId = rightKeyCol == "id" || rightKeyCol == "Id";
        bool rightHasIndex = rightTable.HasIndex(rightKeyCol);

        if (rightIsId) {
            // Index-Nested-Loop Join on Primary Key
            for (int i = 0; i < leftRows.Count; i = i + 1) {
                RecordRow left = leftRows[i];
                string kStr = this.GetColStr(left, leftKeyCol);
                int rId = Convert.ToInt32(kStr);
                RecordRow right = rightTable.Get(rId);
                if (right != null) {
                    results.Add(new RecordJoinResult(left, right));
                } else if (isLeftJoin) {
                    results.Add(new RecordJoinResult(left, null));
                }
            }
            return results;
        }

        if (rightHasIndex) {
            // Index-Nested-Loop Join on Secondary Index
            for (int i = 0; i < leftRows.Count; i = i + 1) {
                RecordRow left = leftRows[i];
                string kStr = this.GetColStr(left, leftKeyCol);
                List<RecordRow> rightMatches = rightTable.FindByIndex(rightKeyCol, kStr);
                if (rightMatches != null && rightMatches.Count > 0) {
                    for (int j = 0; j < rightMatches.Count; j = j + 1) {
                        results.Add(new RecordJoinResult(left, rightMatches[j]));
                    }
                } else if (isLeftJoin) {
                    results.Add(new RecordJoinResult(left, null));
                }
            }
            return results;
        }

        // Hash Join fallback: O(M + N)
        Dictionary<string, List<RecordRow>> leftBuckets = new Dictionary<string, List<RecordRow>>();
        Dictionary<int, bool> matchedLeftIds = new Dictionary<int, bool>();

        for (int i = 0; i < leftRows.Count; i = i + 1) {
            RecordRow left = leftRows[i];
            string k = this.GetColStr(left, leftKeyCol);
            if (!leftBuckets.ContainsKey(k)) {
                leftBuckets[k] = new List<RecordRow>();
            }
            leftBuckets[k].Add(left);
        }

        rightTable.Scan((int rightId, RecordRow rightRow) => {
            string rKey = this.GetColStr(rightRow, rightKeyCol);
            if (leftBuckets.ContainsKey(rKey)) {
                List<RecordRow> bucket = leftBuckets[rKey];
                for (int b = 0; b < bucket.Count; b = b + 1) {
                    results.Add(new RecordJoinResult(bucket[b], rightRow));
                    if (isLeftJoin) {
                        matchedLeftIds[bucket[b].id] = true;
                    }
                }
            }
            return true;
        });

        if (isLeftJoin) {
            for (int i = 0; i < leftRows.Count; i = i + 1) {
                RecordRow left = leftRows[i];
                if (!matchedLeftIds.ContainsKey(left.id)) {
                    results.Add(new RecordJoinResult(left, null));
                }
            }
        }

        return results;
    }

    public string GetColStr(RecordRow r, string colName) {
        if (r == null || colName == null) { return ""; }
        if (colName == "id" || colName == "Id") {
            return Convert.ToString(r.id);
        }
        RecordColumn col = r.schema.FindColumn(colName);
        if (col == null) { return ""; }
        if (col.dataType == RecordDataType.Int32) { return Convert.ToString(r.GetInt32(colName)); }
        if (col.dataType == RecordDataType.Int64) { return Convert.ToString(r.GetInt64(colName)); }
        if (col.dataType == RecordDataType.Float32) { return Convert.ToString((double)r.GetFloat32(colName)); }
        if (col.dataType == RecordDataType.Float64) { return Convert.ToString(r.GetFloat64(colName)); }
        if (col.dataType == RecordDataType.Bool) { return r.GetBool(colName) ? "1" : "0"; }
        if (col.dataType == RecordDataType.FixedStr) { return r.GetStr(colName); }
        if (col.dataType == RecordDataType.VarStr) { return r.GetVarStr(colName); }
        return "";
    }

    // ----------------------------------------------------
    // 条件批量操作（Update / Delete）
    // ----------------------------------------------------

    public int Delete() {
        List<RecordRow> rows = this.ToList();
        if (rows.Count == 0) { return 0; }

        bool localTx = !this.table.inTx;
        if (localTx) {
            this.table.BeginTransaction();
        }
        int affected = 0;
        try {
            for (int i = 0; i < rows.Count; i = i + 1) {
                bool ok = this.table.Delete(rows[i].id);
                if (ok) { affected = affected + 1; }
            }
            if (localTx) {
                this.table.Commit();
            }
        } catch (Exception ex) {
            if (localTx) {
                this.table.Rollback();
            }
            throw ex;
        }
        return affected;
    }

    public int Update(RecordRowUpdater updater) {
        if (updater == null) { return 0; }
        List<RecordRow> rows = this.ToList();
        if (rows.Count == 0) { return 0; }

        bool localTx = !this.table.inTx;
        if (localTx) {
            this.table.BeginTransaction();
        }
        int affected = 0;
        try {
            for (int i = 0; i < rows.Count; i = i + 1) {
                RecordRow r = rows[i];
                updater(r);
                bool ok = this.table.Update(r.id, r);
                if (ok) { affected = affected + 1; }
            }
            if (localTx) {
                this.table.Commit();
            }
        } catch (Exception ex) {
            if (localTx) {
                this.table.Rollback();
            }
            throw ex;
        }
        return affected;
    }

    // ----------------------------------------------------
    // 索引计划与残余谓词识别
    // ----------------------------------------------------

    public bool HasResidual(ExprNode n) {
        if (n == null) { return false; }
        if (n.Kind == 4) { // Lambda
            return this.HasResidual(n.A);
        }
        if (n.Kind == 2) { // Binary
            if (n.Name == "==") {
                if (n.A != null && n.A.Kind == 0 && n.B != null && n.B.Kind == 1) {
                    return !this.table.HasIndex(n.A.Name);
                }
                if (n.B != null && n.B.Kind == 0 && n.A != null && n.A.Kind == 1) {
                    return !this.table.HasIndex(n.B.Name);
                }
                return true;
            }
            if (n.Name == ">=" || n.Name == ">" || n.Name == "<=" || n.Name == "<") {
                if (n.A != null && n.A.Kind == 0 && n.B != null && n.B.Kind == 1) {
                    return !this.table.HasIndex(n.A.Name);
                }
                return true;
            }
            if (n.Name == "&&") {
                return this.HasResidual(n.A) || this.HasResidual(n.B);
            }
            return true;
        }
        return true;
    }

    public List<int> PlanCandidateIds() {
        if (this.expr == null) { return null; }
        return this.ExtractIndexIds(this.expr);
    }

    public List<int> ExtractIndexIds(ExprNode n) {
        if (n == null) { return null; }
        if (n.Kind == 4) { // Lambda
            return this.ExtractIndexIds(n.A);
        }
        if (n.Kind == 2) { // Binary
            if (n.Name == "==") {
                if (n.A != null && n.A.Kind == 0 && n.B != null && n.B.Kind == 1) {
                    string col = n.A.Name;
                    if (this.table.HasIndex(col)) {
                        string val = this.ConstToString(n.B);
                        return this.table.FindIdsByIndex(col, val);
                    }
                } else if (n.B != null && n.B.Kind == 0 && n.A != null && n.A.Kind == 1) {
                    string col = n.B.Name;
                    if (this.table.HasIndex(col)) {
                        string val = this.ConstToString(n.A);
                        return this.table.FindIdsByIndex(col, val);
                    }
                }
            } else if (n.Name == ">=" || n.Name == ">" || n.Name == "<=" || n.Name == "<") {
                if (n.A != null && n.A.Kind == 0 && n.B != null && n.B.Kind == 1) {
                    string col = n.A.Name;
                    if (this.table.HasIndex(col)) {
                        string lo = "";
                        string hi = "";
                        string val = this.ConstToString(n.B);
                        if (n.Name == ">=" || n.Name == ">") {
                            lo = val;
                        } else {
                            hi = val;
                        }
                        return this.table.FindIdsByRange(col, lo, hi);
                    }
                }
            } else if (n.Name == "&&") {
                List<int> leftIds = this.ExtractIndexIds(n.A);
                List<int> rightIds = this.ExtractIndexIds(n.B);
                if (leftIds != null && rightIds != null) {
                    return this.IntersectIds(leftIds, rightIds);
                }
                if (leftIds != null) { return leftIds; }
                if (rightIds != null) { return rightIds; }
            }
        }
        return null;
    }

    public List<int> IntersectIds(List<int> a, List<int> b) {
        List<int> res = new List<int>();
        if (a == null || b == null) { return res; }
        Dictionary<int, bool> idSet = new Dictionary<int, bool>();
        for (int i = 0; i < a.Count; i = i + 1) {
            idSet[a[i]] = true;
        }
        for (int i = 0; i < b.Count; i = i + 1) {
            if (idSet.ContainsKey(b[i])) {
                res.Add(b[i]);
            }
        }
        return res;
    }

    public string ConstToString(ExprNode c) {
        if (c == null) { return ""; }
        if (c.TVal == 0) { return Convert.ToString(c.IVal); }
        if (c.TVal == 1) { return Convert.ToString(c.DVal); }
        if (c.TVal == 2) { return c.SVal != null ? c.SVal : ""; }
        if (c.TVal == 3) { return c.BVal ? "1" : "0"; }
        if (c.TVal == 5) { return Convert.ToString(c.LVal); }
        return "";
    }

    // 内存强类型语法树求值器（0 装箱，直接走读 RecordRow 二进制数据）
    public bool EvalNode(ExprNode n, RecordRow r) {
        if (n == null) { return true; }
        if (n.Kind == 4) { // Lambda: p => body
            return this.EvalNode(n.A, r);
        }
        if (n.Kind == 5) { // Unary Not: !expr
            return !this.EvalNode(n.A, r);
        }
        if (n.Kind == 2) { // Binary
            if (n.Name == "&&") {
                return this.EvalNode(n.A, r) && this.EvalNode(n.B, r);
            }
            if (n.Name == "||") {
                return this.EvalNode(n.A, r) || this.EvalNode(n.B, r);
            }

            // 比较运算
            double numA = 0.0;
            double numB = 0.0;
            bool isNumA = false;
            bool isNumB = false;
            string strA = "";
            string strB = "";

            this.EvalVal(n.A, r, out numA, out isNumA, out strA);
            this.EvalVal(n.B, r, out numB, out isNumB, out strB);

            if (isNumA && isNumB) {
                if (n.Name == "==") { return Math.Abs(numA - numB) < 1e-9; }
                if (n.Name == "!=") { return Math.Abs(numA - numB) >= 1e-9; }
                if (n.Name == "<") { return numA < numB; }
                if (n.Name == "<=") { return numA <= numB; }
                if (n.Name == ">") { return numA > numB; }
                if (n.Name == ">=") { return numA >= numB; }
            } else {
                int cmp = String.CompareOrdinal(strA, strB);
                if (n.Name == "==") { return cmp == 0; }
                if (n.Name == "!=") { return cmp != 0; }
                if (n.Name == "<") { return cmp < 0; }
                if (n.Name == "<=") { return cmp <= 0; }
                if (n.Name == ">") { return cmp > 0; }
                if (n.Name == ">=") { return cmp >= 0; }
            }
            return false;
        }
        if (n.Kind == 3) { // Method call: StartsWith / EndsWith / Contains
            double ignored = 0.0;
            bool isNum = false;
            string target = "";
            this.EvalVal(n.A, r, out ignored, out isNum, out target);
            string arg = "";
            this.EvalVal(n.B, r, out ignored, out isNum, out arg);

            if (n.Name == "StartsWith") {
                return target.StartsWith(arg);
            }
            if (n.Name == "EndsWith") {
                return target.EndsWith(arg);
            }
            if (n.Name == "Contains") {
                return target.Contains(arg);
            }
        }
        return true;
    }

    public void EvalVal(ExprNode n, RecordRow r, out double numVal, out bool isNum, out string strVal) {
        numVal = 0.0;
        isNum = false;
        strVal = "";
        if (n == null) { return; }

        if (n.Kind == 0) { // Member access
            string colName = n.Name;
            if (colName == "id" || colName == "Id") {
                numVal = (double)r.id;
                isNum = true;
                strVal = Convert.ToString(r.id);
                return;
            }
            RecordColumn col = this.table.Schema().FindColumn(colName);
            if (col == null) { return; }

            if (col.dataType == RecordDataType.Int32) {
                numVal = (double)r.GetInt32(colName);
                isNum = true;
                strVal = Convert.ToString(r.GetInt32(colName));
            } else if (col.dataType == RecordDataType.Int64) {
                numVal = (double)r.GetInt64(colName);
                isNum = true;
                strVal = Convert.ToString(r.GetInt64(colName));
            } else if (col.dataType == RecordDataType.Float32) {
                numVal = (double)r.GetFloat32(colName);
                isNum = true;
                strVal = Convert.ToString(numVal);
            } else if (col.dataType == RecordDataType.Float64) {
                numVal = r.GetFloat64(colName);
                isNum = true;
                strVal = Convert.ToString(numVal);
            } else if (col.dataType == RecordDataType.Bool) {
                bool b = r.GetBool(colName);
                numVal = b ? 1.0 : 0.0;
                isNum = true;
                strVal = b ? "1" : "0";
            } else if (col.dataType == RecordDataType.FixedStr) {
                strVal = r.GetStr(colName);
                isNum = false;
            } else if (col.dataType == RecordDataType.VarStr) {
                strVal = r.GetVarStr(colName);
                isNum = false;
            }
        } else if (n.Kind == 1) { // Constant
            if (n.TVal == 0) {
                numVal = (double)n.IVal;
                isNum = true;
                strVal = Convert.ToString(n.IVal);
            } else if (n.TVal == 1) {
                numVal = n.DVal;
                isNum = true;
                strVal = Convert.ToString(n.DVal);
            } else if (n.TVal == 2) {
                strVal = n.SVal != null ? n.SVal : "";
                isNum = false;
            } else if (n.TVal == 3) {
                numVal = n.BVal ? 1.0 : 0.0;
                isNum = true;
                strVal = n.BVal ? "1" : "0";
            } else if (n.TVal == 5) {
                numVal = (double)n.LVal;
                isNum = true;
                strVal = Convert.ToString(n.LVal);
            }
        }
    }

    public void SortResults(List<RecordRow> list) {
        RecordColumn col = this.table.Schema().FindColumn(this.orderCol);
        if (col == null) { return; }

        bool isNum = col.dataType == RecordDataType.Int32 || col.dataType == RecordDataType.Int64 ||
                     col.dataType == RecordDataType.Float32 || col.dataType == RecordDataType.Float64 ||
                     col.dataType == RecordDataType.Bool;

        // 插入排序
        int n = list.Count;
        for (int i = 1; i < n; i = i + 1) {
            RecordRow keyRow = list[i];
            int j = i - 1;
            while (j >= 0) {
                RecordRow curRow = list[j];
                int cmp = 0;
                if (isNum) {
                    double vA = this.GetNum(curRow, col);
                    double vB = this.GetNum(keyRow, col);
                    if (vA < vB) { cmp = 0 - 1; }
                    else if (vA > vB) { cmp = 1; }
                    else { cmp = 0; }
                } else {
                    string sA = this.GetStr(curRow, col);
                    string sB = this.GetStr(keyRow, col);
                    cmp = String.CompareOrdinal(sA, sB);
                }

                if (this.orderDesc) { cmp = 0 - cmp; }

                if (cmp > 0) {
                    list[j + 1] = list[j];
                    j = j - 1;
                } else {
                    break;
                }
            }
            list[j + 1] = keyRow;
        }
    }

    public double GetNum(RecordRow r, RecordColumn col) {
        if (col.dataType == RecordDataType.Int32) { return (double)r.GetInt32(col.name); }
        if (col.dataType == RecordDataType.Int64) { return (double)r.GetInt64(col.name); }
        if (col.dataType == RecordDataType.Float32) { return (double)r.GetFloat32(col.name); }
        if (col.dataType == RecordDataType.Float64) { return r.GetFloat64(col.name); }
        if (col.dataType == RecordDataType.Bool) { return r.GetBool(col.name) ? 1.0 : 0.0; }
        return 0.0;
    }

    public string GetStr(RecordRow r, RecordColumn col) {
        if (col.dataType == RecordDataType.FixedStr) { return r.GetStr(col.name); }
        if (col.dataType == RecordDataType.VarStr) { return r.GetVarStr(col.name); }
        return "";
    }
}
