using System;
using System.IO;
using System.Json;
using System.Text;
using System.Threading;

namespace System.Data.ZanDb;

public partial class Collection {
    // 直接从存储的记录中取出一个字段：其他字段
    // 被跳过而非解码，因此对大集合做过滤
    // 不会为每篇文档构建 JsonValue 树。记录中
    // 没有该字段时返回 null。
    public JsonValue FieldOf(string body, int kid) {
        if (kid == 0) { return null; }
        int p = 1;  // 'B'
        long n = Collection.RecVarInt(body, p, out p);
        int i = 0;
        while (i < (int)n) {
            long k = Collection.RecVarInt(body, p, out p);
            if ((int)k == kid) {
                return ReadValS(body, p, out p);
            }
            Collection.SkipValS(body, p, out p);
            i = i + 1;
        }
        return null;
    }

    // 行视图 float32 数组直读（刀10）：tag 11 载荷直接还原
    // float[dims]，免逐元素 JsonValue 装箱/解箱。1 = 向量就绪
    // （有限、维度相符、非全零）；0 = 字段缺失/非 tag 11、-1 =
    // 格式/维度/NaN 异常——两者一律由调用方回退 FieldOf+ReadVector
    // 权威通道，null/ArgumentException 语义与既有路径一致。
    public int FieldF32(string body, int kid, int dims, out float[] vec) {
        vec = null;
        if (kid == 0 || dims <= 0) { return 0; }
        int p = 1;  // 'B'
        long n = Collection.RecVarInt(body, p, out p);
        if (n < 0 || n > 4096) { return -1; }
        int i = 0;
        while (i < (int)n) {
            long k = Collection.RecVarInt(body, p, out p);
            if (k < 0) { return -1; }
            if ((int)k == kid) {
                int tag = body[p] & 255;
                if (tag != 11) { return 0; }
                p = p + 1;
                long c = Collection.RecVarInt(body, p, out p);
                if (c != dims) { return -1; }
                if (p + dims * 4 > body.Length) { return -1; }
                float[] v = new float[dims];
                bool any = false;
                for (int j = 0; j < dims; j = j + 1) {
                    int bits = (body[p] & 255)
                    + ((body[p + 1] & 255) << 8)
                    + ((body[p + 2] & 255) << 16)
                    + ((body[p + 3] & 255) << 24);
                    float f = NativeMemory.AsF32(bits);
                    if (f != f || f - f != 0) { return -1; }
                    if (f != 0.0f) { any = true; }
                    v[j] = f;
                    p = p + 4;
                }
                if (!any) { return -1; }
                vec = v;
                return 1;
            }
            Collection.SkipValS(body, p, out p);
            i = i + 1;
        }
        return 0;
    }

    // 字段等值判定（<see cref="FindIdsByField"/> 与
    // <see cref="CountByField"/> 的过滤内核）：字符串值
    // （记录 tag 5）按长度 + 逐字节比较，零分配；
    // 其他类型才解码出值按 <see cref="JsonValue.AsString"/>
    // 比较（与投影读语义一致）。与 FieldOf 相同的记录行走，
    // 但命中字段后不构建 JsonValue。
    public bool FieldEquals(string body, int kid, string val) {
        if (kid == 0) { return false; }
        int p = 1;  // 'B'
        long n = Collection.RecVarInt(body, p, out p);
        int i = 0;
        while (i < (int)n) {
            long k = Collection.RecVarInt(body, p, out p);
            if ((int)k == kid) {
                int tag = body[p] & 255;
                if (tag == 5) {
                    p = p + 1;
                    long len = Collection.RecVarInt(body, p, out p);
                    if (len != val.Length) { return false; }
                    for (int j = 0; j < (int)len; j = j + 1) {
                        if (body[p + j] != val[j]) { return false; }
                    }
                    return true;
                }
                JsonValue f = ReadValS(body, p, out p);
                return f.AsString("") == val;
            }
            Collection.SkipValS(body, p, out p);
            i = i + 1;
        }
        return false;
    }

    // 等值过滤的快速否证前提：needle 至少 2 字符、
    // 含「非数值渲染字符」的字符（排除数值 AsString 归一化渲染
    // 的等值可能——整数/浮点渲染只含 0-9 与 + - . e E）、
    // 不含 0x00/0xFF（排除转义编码的字节位移）、不是 "true"/
    // "false"（排除布尔 AsString 等值）。满足时 needle 的原
    // 字节若不在记录值区出现，字段就绝不等于该值——整行免
    // 物化免走读直接否决。
    public bool EqFastReject(string val) {
        if (val.Length < 2) { return false; }
        if (val == "true" || val == "false") { return false; }
        if (StrMemChr(val, 0, val.Length) != 0
        || StrMemChr(val, 255, val.Length) != 0) { return false; }
        for (int i = 0; i < val.Length; i = i + 1) {
            int c = val[i] & 255;
            if (c < 48 || c > 57) {
                if (c != 43 && c != 45 && c != 46 && c != 69 && c != 101) { return true; }
            }
        }
        return false;
    }

    // needle 原字节是否不在行值区出现：memchr 找首字符
    // 出现点、memcmp 全针验证，命中点逐个推进。找不到即整行
    // 否决（<see cref="EqFastReject"/> 前提下声音）。约 5ns 级
    // 原语成本，替代数百纳秒的记录走读。
    public bool NeedleAbsent(ScanRow row, string val) {
        nint p = row.ValPtr();
        long n = row.ValLen();
        if (n < val.Length) { return true; }
        int c = val[0] & 255;
        long len = val.Length;
        nint hit = MemChr(p, c, n);
        while (hit != 0) {
            long off = (long)(hit - p);
            if (off + len <= n && MemCmpRaw(hit, val, len) == 0) { return false; }
            hit = MemChr(hit + 1, c, n - off - 1);
        }
        return true;
    }

    // <see cref="FieldEquals"/> 的行视图版：满足
    // <see cref="EqFastReject"/> 的 needle 先做针线否证（零物化）；
    // 零拷贝段游标行走 <see cref="FieldEqualsPtr"/> 指针快答
    // （字符串零分配比较、整数直比），转义/非直比形态回退权威
    // 走读；不满足或退化模式直接走权威走读。
    public bool FieldEqualsRow(ScanRow row, int kid, string val, bool fastReject) {
        if (kid == 0) { return false; }
        if (fastReject && row.Block() != null && NeedleAbsent(row, val)) { return false; }
        if (row.Block() != null) {
            int verdict = Collection.FieldEqualsPtr(row.ValPtr(), 0, row.ValLen(), kid, val);
            if (verdict == 1) { return true; }
            if (verdict == 0) { return false; }
        }
        return FieldEquals(row.Val(), kid, val);
    }

    // <see cref="FieldNum"/> 的行视图版：零拷贝段游标行走
    // <see cref="FieldNumPtr"/> 指针直还原，转义/异常回退权威走读；
    // 退化模式直接走字符串路径。
    public bool FieldNumRow(ScanRow row, int kid, out long v) {
        v = 0;
        if (kid == 0) { return false; }
        if (row.Block() != null) {
            int verdict = Collection.FieldNumPtr(row.ValPtr(), row.ValLen(), kid, out v);
            if (verdict == 1) { return true; }
            if (verdict == 0) { return false; }
            v = 0;
        }
        return FieldNum(row.Val(), kid, out v);
    }

    // <see cref="FieldText"/> 的行视图版：零拷贝段游标行走
    // <see cref="FieldTextPtr"/> 指针直取，转义/异常回退权威走读；
    // 退化模式直接走字符串路径。
    public string FieldTextRow(ScanRow row, int kid) {
        if (kid == 0) { return null; }
        if (row.Block() != null) {
            string s;
            int verdict = Collection.FieldTextPtr(row.ValPtr(), row.ValLen(), kid, out s);
            if (verdict == 1) { return s; }
            if (verdict == 0) { return null; }
        }
        return FieldText(row.Val(), kid);
    }

    // <see cref="FieldOf"/> 的行视图版：零拷贝段游标行直接在
    // 块缓冲上指针走读（免整行字符串物化），转义/格式异常回退
    // 权威走读；退化模式（无块缓冲）直接走字符串路径。
    public JsonValue FieldOfRow(ScanRow row, int kid) {
        if (kid == 0) { return null; }
        if (row.Block() == null) { return FieldOf(row.Val(), kid); }
        JsonValue value;
        int verdict = this.FieldValuePtr(row.ValPtr(), row.ValLen(), kid, out value);
        if (verdict == 1) { return value; }
        if (verdict == 0) { return null; }
        return FieldOf(row.Val(), kid);
    }

    // 字段的数值形态（类型化免树）：varint(3/8/9) 直接
    // 还原、文本数值(4)解析；字符串/布尔/容器/缺字段返回 false
    // ——聚合只认数值型字段，不做隐式强制。
    public bool FieldNum(string body, int kid, out long v) {
        v = 0;
        if (kid == 0) { return false; }
        int p = 1;  // 'B'
        long n = Collection.RecVarInt(body, p, out p);
        for (int i = 0; i < (int)n; i = i + 1) {
            long k = Collection.RecVarInt(body, p, out p);
            int tag = body[p] & 255;
            if ((int)k == kid) {
                if (tag == 3) { v = Collection.RecVarInt(body, p + 1, out p); return true; }
                if (tag == 8) { v = 0 - Collection.RecVarInt(body, p + 1, out p); return true; }
                if (tag == 9) { return true; }
                if (tag == 4) {
                    long len = Collection.RecVarInt(body, p + 1, out p);
                    v = body.Substring(p, (int)len).ToInt64();
                    return true;
                }
                return false;
            }
            Collection.SkipValS(body, p, out p);
        }
        return false;
    }

    // 字段的文本形态（免 JsonValue）：字符串(5/10)直接
    // 取载荷、数值(3/8/9/4)转十进制文本、布尔(1/2)转
    // "true"/"false"——与 <see cref="JsonValue.AsString"/> 的
    // 归一化形态一致；null/容器/缺字段返回 null（调用方跳过）。
    public string FieldText(string body, int kid) {
        if (kid == 0) { return null; }
        int p = 1;  // 'B'
        long n = Collection.RecVarInt(body, p, out p);
        for (int i = 0; i < (int)n; i = i + 1) {
            long k = Collection.RecVarInt(body, p, out p);
            int tag = body[p] & 255;
            if ((int)k == kid) {
                if (tag == 5 || tag == 4) {
                    long len = Collection.RecVarInt(body, p + 1, out p);
                    return body.Substring(p, (int)len);
                }
                if (tag == 10) { return ""; }
                if (tag == 3) { return Convert.ToString(Collection.RecVarInt(body, p + 1, out p)); }
                if (tag == 8) { return Convert.ToString(0 - Collection.RecVarInt(body, p + 1, out p)); }
                if (tag == 9) { return "0"; }
                if (tag == 1) { return "false"; }
                if (tag == 2) { return "true"; }
                return null;
            }
            Collection.SkipValS(body, p, out p);
        }
        return null;
    }

    // ===== 行视图指针解码：段游标零拷贝行直接在块缓冲上走读，=====
    // 免整行字符串物化。刀13：全二进制安全原生 Tape，不再因 0xFF
    // 熔断回退，指针扫描对包含浮点向量与二进制载荷的行全速运行。
    // 仅在格式破损时回退权威走读；容器字段（tag 6/7）跳读不支持
    // 同样回退（<see cref="SkipValRaw"/> 口径）。退化模式
    // （BindMem，无块缓冲）直接走字符串路径。basePtr 一律为
    // 值起点，p/end 为相对偏移——与 ReadVarIntRaw/SkipValRaw 的
    // 现有契约对齐。

    // 行视图字段定位：1 = 命中（p 指向 tag 字节，未消费）、
    // 0 = 字段缺失、-1 = 格式异常（调用方回退权威走读）。
    public static int FieldLocatePtr(nint basePtr, int valLen, int kid, out int p) {
        p = 0;
        if (valLen < 1 || Collection.PeekB(basePtr) != 66) { return -1; }
        int end = valLen;
        p = 1;
        long n = Collection.ReadVarIntRaw(basePtr, ref p, end);
        if (n < 0 || n > 4096) { return -1; }
        for (int i = 0; i < (int)n; i = i + 1) {
            long k = Collection.ReadVarIntRaw(basePtr, ref p, end);
            if (k < 0) { return -1; }
            if ((int)k == kid) {
                if (p >= end) { return -1; }
                return 1;
            }
            if (!Collection.SkipValRaw(basePtr, ref p, end)) { return -1; }
        }
        return 0;
    }

    // 指针版值物化（<see cref="ReadValS"/> 的裸指针对偶）：
    // 字符串载荷零转写取出（GetString 直读块缓冲），嵌套容器
    // 递归。格式异常返回 null（调用方回退权威走读）。
    public JsonValue ReadValPtr(nint basePtr, int p, int end, out int np) {
        np = p;
        if (p >= end) { return null; }
        int tag = Collection.PeekB(basePtr + p);
        p = p + 1;
        if (tag == 0) { np = p; return JsonValue.NewNull(); }
        if (tag == 1) { np = p; return JsonValue.NewBool(false); }
        if (tag == 2) { np = p; return JsonValue.NewBool(true); }
        if (tag == 3) {
            long v = Collection.ReadVarIntRaw(basePtr, ref p, end);
            if (v < 0) { return null; }
            np = p;
            return JsonValue.NewNum(Convert.ToString(v));
        }
        if (tag == 8) {
            long v = Collection.ReadVarIntRaw(basePtr, ref p, end);
            if (v < 0) { return null; }
            np = p;
            return JsonValue.NewNum(Convert.ToString(0 - v));
        }
        if (tag == 9) { np = p; return JsonValue.NewNum("0"); }
        if (tag == 4 || tag == 5) {
            long len = Collection.ReadVarIntRaw(basePtr, ref p, end);
            if (len < 0 || p + (int)len > end) { return null; }
            string t = NativeMemory.GetString(basePtr, p, (int)len);
            p = p + (int)len;
            np = p;
            if (tag == 4) { return JsonValue.NewNum(t); }
            return JsonValue.NewStr(t);
        }
        if (tag == 10) { np = p; return JsonValue.NewStr(""); }
        if (tag == 11) {
            // 刀7 float32 数组直编码（指针版）：dims + dims×4 字节小端。
            // 刀11：直还数值形态，免逐元素装箱。
            long c = Collection.ReadVarIntRaw(basePtr, ref p, end);
            if (c < 0 || p + (int)c * 4 > end) { return null; }
            double[] arr = new double[(int)c];
            for (int i = 0; i < (int)c; i = i + 1) {
                int bits = Collection.PeekB(basePtr + p)
                + (Collection.PeekB(basePtr + p + 1) << 8)
                + (Collection.PeekB(basePtr + p + 2) << 16)
                + (Collection.PeekB(basePtr + p + 3) << 24);
                arr[i] = (double)NativeMemory.AsF32(bits);
                p = p + 4;
            }
            np = p;
            return JsonValue.NewDoubleArray(arr);
        }
        if (tag == 6) {
            long c = Collection.ReadVarIntRaw(basePtr, ref p, end);
            if (c < 0) { return null; }
            JsonValue a = JsonValue.NewArray();
            for (int i = 0; i < (int)c; i = i + 1) {
                JsonValue v = this.ReadValPtr(basePtr, p, end, out p);
                if (v == null) { return null; }
                a.Append(v);
            }
            np = p;
            return a;
        }
        if (tag == 7) {
            long c = Collection.ReadVarIntRaw(basePtr, ref p, end);
            if (c < 0) { return null; }
            JsonValue obj = JsonValue.NewObject();
            for (int i = 0; i < (int)c; i = i + 1) {
                long k = Collection.ReadVarIntRaw(basePtr, ref p, end);
                if (k < 0) { return null; }
                JsonValue v = this.ReadValPtr(basePtr, p, end, out p);
                if (v == null) { return null; }
                obj.Set(this.KeyName((int)k), v);
            }
            np = p;
            return obj;
        }
        return null;
    }

    // 行视图单字段物化（<see cref="FieldOf"/> 的裸指针对偶）：
    // 1 = value 就绪、0 = 字段缺失（null）、-1 = 回退权威。
    public int FieldValuePtr(nint basePtr, int valLen, int kid, out JsonValue value) {
        value = null;
        int verdict = Collection.FieldLocatePtr(basePtr, valLen, kid, out int p);
        if (verdict != 1) { return verdict; }
        value = this.ReadValPtr(basePtr, p, valLen, out p);
        return value != null ? 1 : -1;
    }

    // 行视图数值形态（<see cref="FieldNum"/> 的裸指针对偶）：
    // 1 = 数值就绪、0 = 非数值或缺字段、-1 = 回退权威。
    public static int FieldNumPtr(nint basePtr, int valLen, int kid, out long v) {
        v = 0;
        int verdict = Collection.FieldLocatePtr(basePtr, valLen, kid, out int p);
        if (verdict != 1) { return verdict; }
        int end = valLen;
        int tag = Collection.PeekB(basePtr + p);
        p = p + 1;
        if (tag == 3) {
            long x = Collection.ReadVarIntRaw(basePtr, ref p, end);
            if (x < 0) { return -1; }
            v = x;
            return 1;
        }
        if (tag == 8) {
            long x = Collection.ReadVarIntRaw(basePtr, ref p, end);
            if (x < 0) { return -1; }
            v = 0 - x;
            return 1;
        }
        if (tag == 9) { v = 0; return 1; }
        if (tag == 4) {
            long len = Collection.ReadVarIntRaw(basePtr, ref p, end);
            if (len < 0 || p + (int)len > end) { return -1; }
            v = NativeMemory.GetString(basePtr, p, (int)len).ToInt64();
            return 1;
        }
        return 0;
    }

    // 行视图文本形态（<see cref="FieldText"/> 的裸指针对偶）：
    // 1 = 文本就绪、0 = 无文本形态或缺字段、-1 = 回退权威。
    public static int FieldTextPtr(nint basePtr, int valLen, int kid, out string s) {
        s = null;
        int verdict = Collection.FieldLocatePtr(basePtr, valLen, kid, out int p);
        if (verdict != 1) { return verdict; }
        int end = valLen;
        int tag = Collection.PeekB(basePtr + p);
        p = p + 1;
        if (tag == 5 || tag == 4) {
            long len = Collection.ReadVarIntRaw(basePtr, ref p, end);
            if (len < 0 || p + (int)len > end) { return -1; }
            s = NativeMemory.GetString(basePtr, p, (int)len);
            return 1;
        }
        if (tag == 10) { s = ""; return 1; }
        if (tag == 3) {
            long x = Collection.ReadVarIntRaw(basePtr, ref p, end);
            if (x < 0) { return -1; }
            s = Convert.ToString(x);
            return 1;
        }
        if (tag == 8) {
            long x = Collection.ReadVarIntRaw(basePtr, ref p, end);
            if (x < 0) { return -1; }
            s = Convert.ToString(0 - x);
            return 1;
        }
        if (tag == 9) { s = "0"; return 1; }
        if (tag == 1) { s = "false"; return 1; }
        if (tag == 2) { s = "true"; return 1; }
        return 0;
    }


    // 裸记录走读（静态、免 this）：从记录起始位置解析
    // 'B' + VarInt(字段数) + (VarInt(kid) + 值)*，对每个 kid==want
    // 的数值字段（tag 3/8/9/4）累加进 agg。tag 语义与
    // <see cref="FieldNum"/> 一致；basePtr 指向键起点（值在
    // basePtr+valOff）。返回 false = 记录含转义（0xFF）或格式
    // 异常，调用方须回退权威走读。
    public static bool RecAccNum(nint basePtr, int valOff, int valLen, int want, NumAcc acc) {
        nint v = basePtr + valOff;
        // 记录首字节必须是 'B'(66)。
        int b0 = Collection.PeekB(v);
        if (b0 != 66) { return false; }
        int p = valOff + 1;
        long n = Collection.ReadVarIntRaw(basePtr, ref p, valOff + valLen);
        if (n < 0 || n > 4096) { return false; }
        int end = valOff + valLen;
        for (int i = 0; i < (int)n; i = i + 1) {
            long kid = Collection.ReadVarIntRaw(basePtr, ref p, end);
            if (kid < 0) { return false; }
            // tag 只消费一次：want 命中分支自己读；跳过分支由
            // SkipValRaw 读（p 仍指向 tag——与 FieldNum 调
            // SkipValS 的契约一致）。预读再跳会导致 SkipValRaw
            // 把长度/载荷字节当 tag， kid/tag 全线错位。
            if ((int)kid == want) {
                if (p >= end) { return false; }
                int tag = Collection.PeekB(basePtr + p);
                p = p + 1;
                if (tag == 3) {
                    long x = Collection.ReadVarIntRaw(basePtr, ref p, end);
                    if (x < 0) { return false; }
                    acc.Add(x);
                    return true;
                }
                if (tag == 8) {
                    long x = Collection.ReadVarIntRaw(basePtr, ref p, end);
                    if (x < 0) { return false; }
                    acc.Add(0 - x);
                    return true;
                }
                if (tag == 9) { acc.Add(0); return true; }
                return false;  // 文本数值/非数值：交给权威走读兜底
            }
            // 跳过该值：按标签长度规则推进（含容器递归长度，用
            // 栈式计数实现，免递归调用）。
            if (!Collection.SkipValRaw(basePtr, ref p, end)) { return false; }
        }
        return true;
    }

    // <see cref="FieldEquals"/> 的裸指针版（内核回调用，
    // 免整串物化）：格式异常返回 -1（调用方回退权威路径）；
    // tag 5 字符串值按长度 + memcmp 零分配比较，
    // 数值/布尔等非字符串类型返回 -2（走权威 AsString 语义），
    // 字段缺失返回 0。1 = 字段值等于 val。
    public static int FieldEqualsPtr(nint basePtr, int valOff, int valLen, int kid, string val) {
        nint v = basePtr + valOff;
        int b0 = Collection.PeekB(v);
        if (b0 != 66) { return -1; }
        int p = valOff + 1;
        int end = valOff + valLen;
        long n = Collection.ReadVarIntRaw(basePtr, ref p, end);
        if (n < 0 || n > 4096) { return -1; }
        for (int i = 0; i < (int)n; i = i + 1) {
            long k = Collection.ReadVarIntRaw(basePtr, ref p, end);
            if (k < 0) { return -1; }
            if (p >= end) { return -1; }
            int tag = Collection.PeekB(basePtr + p);
            p = p + 1;
            if ((int)k == kid) {
                if (tag == 5) {
                    long len = Collection.ReadVarIntRaw(basePtr, ref p, end);
                    if (len < 0 || p + (int)len > end) { return -1; }
                    if (len != val.Length) { return 0; }
                    if (NativeMemory.Compare(basePtr + p, val, (int)len) != 0) { return 0; }
                    return 1;
                }
                // 整数（3/8/9）：val 是 AsString 归一化形态（十进制
                // 文本），解析后直接比 varint——数值字段等值不走
                // 权威回退（等值过滤最常见形态之一）。
                if (tag == 3 || tag == 8 || tag == 9) {
                    if (!Collection.IsIntStr(val)) { return -2; }
                    long want = Collection.ParseI64(val);
                    if (tag == 9) { return want == 0 ? 1 : 0; }
                    long x = Collection.ReadVarIntRaw(basePtr, ref p, end);
                    if (x < 0) { return -1; }
                    if (tag == 8) { x = 0 - x; }
                    return x == want ? 1 : 0;
                }
                // 布尔："true"/"false" 字面等值。
                if (tag == 1 || tag == 2) {
                    if (val == "true" && tag == 2) { return 1; }
                    if (val == "false" && tag == 1) { return 1; }
                    return 0;
                }
                return -2;  // 文本数值/空串/容器：As 归一化语义交权威
            }
            if (!Collection.SkipValRaw(basePtr, ref p, end)) { return -1; }
        }
        return 0;
    }

    // 读取裸指针处一个字节；offset 为相对位移。
    public static int PeekB(nint p) {
        Span<byte> sp = new Span<byte>(p, 1);
        return sp[0] & 255;
    }

    // 裸指针 LEB128 varint 读取：自 base+p 起解析，
    // 结束位置写回 p（引用传参），limit 为缓冲绝对终点。越界
    // 返回 -1。与 ByteBuffer.ReadVarIntAt 同格式。
    public static long ReadVarIntRaw(nint basePtr, ref int p, int limit) {
        long result = 0;
        int shift = 0;
        while (true) {
            if (p >= limit) { return -1; }
            int b = Collection.PeekB(basePtr + p);
            p = p + 1;
            result = result + ((long)(b & 127) << shift);
            if ((b & 128) == 0) { break; }
            shift = shift + 7;
            if (shift > 63) { return -1; }
        }
        return result;
    }

    // 裸指针跳过一个编码值（标签已读、p 指向标签后）：
    // 与 <see cref="SkipValS"/> 同规则，数组/对象载荷含嵌套时
    // 返回 false 回退权威走读（数值聚合场景容器字段罕见）。
    // 推进失败返回 false。
    public static bool SkipValRaw(nint basePtr, ref int p, int end) {
        if (p >= end) { return false; }
        int tag = Collection.PeekB(basePtr + p);
        p = p + 1;
        if (tag == 3 || tag == 8) {
            return Collection.ReadVarIntRaw(basePtr, ref p, end) >= 0;
        }
        if (tag == 11) {
            long n = Collection.ReadVarIntRaw(basePtr, ref p, end);
            if (n < 0 || p + (int)n * 4 > end) { return false; }
            p = p + (int)n * 4;
            return true;
        }
        if (tag == 4 || tag == 5) {
            long n = Collection.ReadVarIntRaw(basePtr, ref p, end);
            if (n < 0 || p + (int)n > end) { return false; }
            p = p + (int)n;
            return true;
        }
        // 标签 0/1/2/9/10 无载荷；6 数组/7 对象含嵌套结构，
        // 裸走读不展开——回退权威路径。
        return tag == 0 || tag == 1 || tag == 2 || tag == 9 || tag == 10;
    }

}
