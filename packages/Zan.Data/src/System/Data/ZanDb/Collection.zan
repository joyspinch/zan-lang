using System;
using System.IO;
using System.Json;
using System.Text;
using System.Threading;
namespace System.Data.ZanDb;

public delegate bool FieldVisit(int id, JsonValue v);
public delegate bool NumVisit(int id, long v);
public delegate bool StrVisit(int id, string v);
public delegate JsonValue DocUpdater(JsonValue current);

public partial class Collection {
    public ZanStore kv;
    public AsyncRwLock rw;
    public string name;
    public List<string> indexedFields;
    public List<string> keyDict;
    public bool keyDictDirty;
    public long metaVersion;
    // 已缓存的下一个待分配 id；0 = 尚未从 seq 键加载。
    // 单写者模型下安全：序列键仍随每次分配落盘（事务覆盖层
    // 会在提交时去重成一帧），崩溃后经重开恢复，缓存作废重读。
    public int nextIdCache;
    // 进程内热点文档 LRU 缓存池与访问序列，避免重复 I/O 与反序列化。
    public Dict<int, JsonValue> docCache;
    public List<int> docCacheOrder;
    public int docCacheCapacity;
    public CollectionSearch search;
    // 刀12 线程级并发：整库共享的线程阻塞读写锁（ZanDatabase 持有并下发），
    // 公开门面读走 EnterRead、写走 EnterWrite；协程 Async 包装在 rw 之上同序套用。
    // cacheMtx 只护文档缓存与惰性元数据装载的短临界区。
    public RwLock tlock;
    public nint cacheMtx;

    // 批量索引构建中每个事务索引的文档数。
    public static int INDEX_BATCH = 500;

    // 记录会转义以剔除 0x00（参见 EncodeDoc）；转义
    // 字节为 0xFF，几乎从不出现，因此读取路径用 memchr——
    // C 中的一次向量化扫描——判断是否确实需要反转义，而不是
    // 将每条记录逐字节复制到第二个缓冲区。
    [DllImport("crt", EntryPoint = "memchr")]
    public static extern nint MemChr(nint p, int c, long n);

    // 仅初始化空字段；真正的构造走 <see cref="Attach"/>。
    public Collection() {
        this.name = "";
        this.indexedFields = new List<string>();
        this.keyDict = new List<string>();
        this.keyDictDirty = false;
        this.metaVersion = 0 - 1;
        this.nextIdCache = 0;
        this.docCache = new Dict<int, JsonValue>();
        this.docCacheOrder = new List<int>();
        this.docCacheCapacity = 256;
        this.tlock = new RwLock();
        this.cacheMtx = Mutex.Create();
    }

    // 绑定到底层 ZanStore 的一个命名空间，并加载索引列表与字段名字典。
    public static Collection Attach(ZanStore kv, AsyncRwLock rw, RwLock tlock, string name) {
        Collection c = new Collection();
        c.kv = kv;
        c.rw = rw;
        c.name = name;
        c.docCache = new Dict<int, JsonValue>();
        c.docCacheOrder = new List<int>();
        c.docCacheCapacity = 256;
        c.tlock.Close();
        c.tlock = tlock;
        c.LoadIndexMeta();
        c.LoadKeyDict();
        c.metaVersion = kv.CacheVersion();
        c.search = new CollectionSearch(kv, name);
        return c;
    }

    // 提交或回滚后刷新派生缓存。回滚不推进提交版本，
    // 但必须丢弃事务中分配的字段 id、序列和文档缓存。
    public void SyncMeta() {
        long v = this.kv.CacheVersion();
        if (v == this.metaVersion) { return; }
        this.metaVersion = v;
        this.nextIdCache = 0;
        ClearCache();
        LoadIndexMeta();
        LoadKeyDict();
    }

    public void CommitWrite() {
        if (!this.kv.Commit()) {
            this.kv.Rollback();
            SyncMeta();
            throw new IOException(this.kv.GetError());
        }
        this.metaVersion = this.kv.CacheVersion();
    }

    // 批量直写段提交（刀5）：事务覆盖层排序直接固化成新段，
    // 免 WAL 数据帧与 memtable 常驻。崩溃窗口全有或全无（回导
    // 前状态），与事务回滚原子性一致——批量导入调用方本就
    // 可以整批重跑。
    public void CommitWriteBulk() {
        if (!this.kv.CommitBulk()) {
            this.kv.Rollback();
            SyncMeta();
            throw new IOException(this.kv.GetError());
        }
        this.metaVersion = this.kv.CacheVersion();
    }

    // 集合名。
    public string Name() { return this.name; }

    // id 出现在每个文档键和每个索引条目中，其文本形式
    // 占据文件的一大部分。它们写成六个 base-64 数字，
    // 取自可打印字符集 '?'..'~' (0x3F..0x7E)：字节序仍
    // 等于数值顺序，因此 B+Tree 顺序保持为插入顺序；
    // 该字符集既不含 0x00，也不含分隔键的 ':' 和制表符；
    // 6 位数字仍可覆盖 64^6 = 680 亿个 id——宽度只有
    // 之前 12 位十进制数字的一半。
    public static int ID_DIGITS = 6;

    // 把 id 编码为定宽 6 位 base-64 数字（'?'..'~'）：字节序即数值序，
    // 且不含 0x00、':' 与 '\t'，不破坏 B+Tree 顺序与键分隔。
    public static string PadId(int id) {
        ByteBuffer b = ByteBuffer.Alloc(Collection.ID_DIGITS);
        int shift = (Collection.ID_DIGITS - 1) * 6;
        while (shift >= 0) {
            b.WriteU8(63 + ((id >> shift) & 63));
            shift = shift - 6;
        }
        string s = b.ToStr();
        b.Free();
        return s;
    }

    // PadId 的逆操作。
    public static int UnpadId(string s) {
        int v = 0;
        for (int i = 0; i < s.Length; i = i + 1) {
            v = (v << 6) | ((s[i] & 255) - 63);
        }
        return v;
    }

    // <see cref="UnpadId"/> 的裸指针形式（定宽 ID_DIGITS 字节）。
    public static int UnpadIdPtr(nint p) {
        int v = 0;
        for (int i = 0; i < Collection.ID_DIGITS; i = i + 1) {
            v = (v << 6) | (Collection.PeekB(p + i) - 63);
        }
        return v;
    }

    // 文档正文键 c:{name}:{id(定宽)}。
    public string DocKey(int id) {
        return "c:" + this.name + ":" + Collection.PadId(id);
    }

    // 自增 id 序列键。
    public string SeqKey() {
        return "m:" + this.name + ":seq";
    }

    // 索引字段列表元数据键（逗号分隔）。
    public string IdxMetaKey() {
        return "m:" + this.name + ":idx";
    }

    // 字段名字典元数据键（JSON 数组）。
    public string KeysMetaKey() {
        return "m:" + this.name + ":keys";
    }

    // 批量索引构建游标键；键不存在即表示该索引已构建完成。
    public string IdxPosKey(string field) {
        return "m:" + this.name + ":idxpos:" + field;
    }

    // 同一索引字段所有条目共享的前缀。字段用
    // 其字典 id 表示而非拼出全名，因此长字段名
    // 对每个条目零开销。
    public string IdxPrefix(string field, string val) {
        return "i:" + this.name + ":" + Collection.PadId(KeyIdOf(field)) + ":"
        + val + "\t";
    }

    // 完整二级索引条目键：<see cref="IdxPrefix"/> 加定宽 id。
    public string IdxKey(string field, string val, int id) {
        return IdxPrefix(field, val) + Collection.PadId(id);
    }

    // 从元数据键加载索引字段列表（逗号分隔；空则无索引）。
    public void LoadIndexMeta() {
        this.indexedFields = new List<string>();
        string meta = this.kv.Get(IdxMetaKey());
        if (meta.Length == 0) { return; }
        int start = 0;
        for (int i = 0; i <= meta.Length; i = i + 1) {
            if (i == meta.Length || (meta[i] & 255) == 44) {
                if (i > start) { this.indexedFields.Add(meta.Substring(start, i - start)); }
                start = i + 1;
            }
        }
    }

    // ===== 字段名字典 =====
    // 对象键在每篇文档中重复出现，原样存储会浪费
    // 与集合规模成正比的空间。每个集合维护一个
    // 持久的字段名字典；磁盘上的对象键是 1 起始的
    // 字典 id，文档正文是紧凑的二进制记录，其中是
    // 带类型的 varint 编码值（非 JSON 文本）——参见 EncodeDoc/DecodeDoc。

    // 从元数据键的 JSON 数组加载字段名字典。
    public void LoadKeyDict() {
        this.keyDict = new List<string>();
        this.keyDictDirty = false;
        string meta = this.kv.Get(KeysMetaKey());
        if (meta.Length == 0) { return; }
        JsonValue arr = JsonValue.ParseLenient(meta);
        for (int i = 0; i < arr.Count(); i = i + 1) {
            this.keyDict.Add(arr.At(i).AsString(""));
        }
    }

    // 字段名的 1 起始字典 id；首次出现时追加进字典并标记待持久化（须在 kv 事务内）。
    public int KeyId(string k) {
        for (int i = 0; i < this.keyDict.Count; i = i + 1) {
            if (this.keyDict[i] == k) { return i + 1; }
        }
        this.keyDict.Add(k);
        this.keyDictDirty = true;
        return this.keyDict.Count;
    }

    // 字段名的字典 id；若该集合从未
    // 存储过该字段则返回 0。与 KeyId 不同，此方法不会扩充字典，
    // 因此可在读取路径安全使用。
    public int KeyIdOf(string k) {
        for (int i = 0; i < this.keyDict.Count; i = i + 1) {
            if (this.keyDict[i] == k) { return i + 1; }
        }
        return 0;
    }

    // 字典 id 反查字段名；越界时返回 "?" 加 id（不抛错）。
    public string KeyName(int id) {
        if (id >= 1 && id <= this.keyDict.Count) { return this.keyDict[id - 1]; }
        return "?" + Convert.ToString(id);
    }

    // 字典有变更时把整个字典写回元数据键（须在 kv 事务内）。
    public void PersistKeyDict() {
        if (!this.keyDictDirty) { return; }
        JsonValue arr = JsonValue.NewArray();
        for (int i = 0; i < this.keyDict.Count; i = i + 1) {
            arr.Append(JsonValue.NewStr(this.keyDict[i]));
        }
        this.kv.Put(KeysMetaKey(), arr.ToJson());
        this.keyDictDirty = false;
    }

    // 读取并推进自增 id 序列，返回新分配的 id（须在 kv 事务内）。
    // seq 值缓存在内存（0 = 未加载）：单写者下没有并发分配者，
    // 序列键本身仍随本次分配 Put 落盘，崩溃后重开时缓存作废重读。
    // 省掉每次分配一次 Get——实测它随段数增长，占插入路径大头。
    public int NextId() {
        this.tlock.EnterWrite();
        try {
        return NextIdLocked();
        } finally { this.tlock.ExitWrite(); }
    }

    // 刀12：NextId 的持锁实现（公开壳持有整库线程读写锁；内部互调走本变体）。
    public int NextIdLocked() {
        if (this.nextIdCache < 1) {
            string cur = this.kv.Get(SeqKey());
            this.nextIdCache = 1;
            if (cur.Length > 0) { this.nextIdCache = Convert.ToInt(cur) + 1; }
        } else {
            this.nextIdCache = this.nextIdCache + 1;
        }
        this.kv.Put(SeqKey(), Convert.ToString(this.nextIdCache));
        return this.nextIdCache;
    }

    // ===== 缓存池与 CRUD =====

    // 设置集合的文档缓存池容量（0 为关闭缓存，默认 256）。
    public void SetCacheCapacity(int capacity) {
        Mutex.Lock(this.cacheMtx);
        try {
        if (capacity < 0) { capacity = 0; }
        this.docCacheCapacity = capacity;
        if (capacity == 0) {
            this.docCache.Clear();
            this.docCacheOrder.Clear();
        } else {
            int pruneMax = this.docCacheOrder.Count;
            for (int i = 0; i < pruneMax; i = i + 1) {
                if (this.docCacheOrder.Count <= this.docCacheCapacity) { break; }
                int evictId = this.docCacheOrder[0];
                this.docCacheOrder.RemoveAt(0);
                this.docCache.Remove(evictId);
            }
        }
        } finally { Mutex.Unlock(this.cacheMtx); }
    }

    // 获取当前集合文档缓存池的缓存容量。
    public int GetCacheCapacity() {
        Mutex.Lock(this.cacheMtx);
        try { return this.docCacheCapacity; }
        finally { Mutex.Unlock(this.cacheMtx); }
    }

    // 获取当前集合文档缓存池中已缓存的文档数。
    public int CachedDocCount() {
        Mutex.Lock(this.cacheMtx);
        try { return this.docCache.Count; }
        finally { Mutex.Unlock(this.cacheMtx); }
    }

    // 清空文档缓存池。
    public void ClearCache() {
        Mutex.Lock(this.cacheMtx);
        try {
        this.docCache.Clear();
        this.docCacheOrder.Clear();
        } finally { Mutex.Unlock(this.cacheMtx); }
    }

    // 从文档缓存中获取文档，若存在则更新 LRU 访问热度并返回其只读副本。
    public JsonValue CacheGet(int id) {
        Mutex.Lock(this.cacheMtx);
        try {
        if (this.kv.InTransaction() || this.docCacheCapacity <= 0 || !this.docCache.ContainsKey(id)) {
            JsonValue miss = null;
            return miss;
        }
        int lastIdx = this.docCacheOrder.Count - 1;
        if (lastIdx >= 0 && this.docCacheOrder[lastIdx] != id) {
            for (int i = 0; i < this.docCacheOrder.Count; i = i + 1) {
                if (this.docCacheOrder[i] == id) {
                    this.docCacheOrder.RemoveAt(i);
                    this.docCacheOrder.Add(id);
                    break;
                }
            }
        }
        return this.docCache[id];
        } finally { Mutex.Unlock(this.cacheMtx); }
    }

    // 将文档放入 LRU 缓存池；超过容量时淘汰最久未访问的条目。
    public void CachePut(int id, JsonValue doc) {
        Mutex.Lock(this.cacheMtx);
        try {
        if (this.kv.InTransaction() || this.docCacheCapacity <= 0 || doc == null) { return; }
        if (this.docCache.ContainsKey(id)) {
            this.docCache[id] = doc.Clone();
            int lastIdx = this.docCacheOrder.Count - 1;
            if (lastIdx >= 0 && this.docCacheOrder[lastIdx] != id) {
                for (int i = 0; i < this.docCacheOrder.Count; i = i + 1) {
                    if (this.docCacheOrder[i] == id) {
                        this.docCacheOrder.RemoveAt(i);
                        this.docCacheOrder.Add(id);
                        break;
                    }
                }
            }
            return;
        }
        if (this.docCacheOrder.Count >= this.docCacheCapacity && this.docCacheOrder.Count > 0) {
            int evictId = this.docCacheOrder[0];
            this.docCacheOrder.RemoveAt(0);
            this.docCache.Remove(evictId);
        }
        this.docCache[id] = doc.Clone();
        this.docCacheOrder.Add(id);
        } finally { Mutex.Unlock(this.cacheMtx); }
    }

    // 从缓存池中显式失效指定文档。
    public void CacheEvict(int id) {
        Mutex.Lock(this.cacheMtx);
        try {
        if (this.docCacheCapacity <= 0) { return; }
        if (this.docCache.ContainsKey(id)) {
            this.docCache.Remove(id);
            for (int i = 0; i < this.docCacheOrder.Count; i = i + 1) {
                if (this.docCacheOrder[i] == id) {
                    this.docCacheOrder.RemoveAt(i);
                    break;
                }
            }
        }
        } finally { Mutex.Unlock(this.cacheMtx); }
    }

}
